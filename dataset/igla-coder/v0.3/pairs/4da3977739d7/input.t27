// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/debug_print_plan.t27 -- how t27b lowers `std.debug.print(fmt, .{ args })` (t27b coverage epic
; #6063; written in t27 under the port epic #6198). Everything t27b decides about such a call is in this file
; and reaches cli/t27b through `t27c gen-rust` (gen/rust/tri/t27b/debug_print_plan.rs): whether the call is
; lowered at all, whether its format string fits its arguments, and why not. The Rust glue in
; cli/t27b/src/lower.rs only reads the call's shape and the class of each argument, asks `plan` and `check`, and
; builds the answer: nothing, or the arguments evaluated left to right and dropped.
; --
; What the reference does (zig 0.16.0, the default x86_64 Debug backend `t27c test-report` builds with; measured
; on the t27c lab with probe specs, one print per probe, through `t27c test-report`):
;   - A fn nothing analyzed reaches is never analyzed, so its prints are never checked: a format string that does
;     not fit the tuple compiles. specs/t27f/reel_particles_mux.t27's `main` (six prints) is such a fn.
;   - In a fn Zig does analyze, the format string is checked against the tuple at compile time. The spec does not
;     compile (`t27c test-report` says BLOCKED) when the placeholder count is not the tuple's length, when a `{`
;     or `}` is not part of `{{`, `}}` or a placeholder, and when a specifier does not fit its argument's type:
;     `{d}` of a bool or of a slice, `{}` of a slice, `{s}` of an integer, `{s}` of a u8.
;   - Fitting prints compile and run. They write to stderr, which `zig test` reports on but which no verdict
;     reads: a test passes or fails the same with or without them. The arguments are evaluated, left to right,
;     with their effects and their traps (an overflowing `a + b` among them traps).
;   - Measured to fit: `{}` of an integer, a bool or a float; `{d}` of an integer or a float; `{s}` of a string
;     literal, a `[]const u8` and an array of u8; `{{` and `}}`; and the options `:fill align width` (`{d:0>2}`,
;     `{d:>5}`, `{d: >5}`, `{d:^6}`, `{d:5}`, `{s:5}`) and `:.precision` (`{d:.2}` of a float, `{s:.2}` of a slice).
; --
; What t27b does. SKIP: in a fn nothing analyzed reaches (`unanalyzed_fn`, where every bench body counts too) the
; statement lowers to nothing and its arguments are not lowered, as the reference never looks at them. In an
; analyzed fn, EVAL: when the call is `print("literal", .{ .. })` and `check` finds the format string fits the
; arguments, the arguments are evaluated in order and dropped: t27b has no stderr, and no verdict reads it.
; Everything else is a refusal that names why (REFUSE_SHAPE, REFUSE_FORMAT, REFUSE_COUNT, REFUSE_TYPE): where
; the reference is BLOCKED the refusal is the match, and a specifier or argument class outside the measured
; list above is refused conservatively (`{x}`, `{c}`, `{any}`, `{e}`, an enum, a struct, an optional, a pointer,
; `{d:8.3}`, an empty option). Nothing here models the bytes printed.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bDebugPrintPlan;

// The answers. `plan` gives SKIP, CHECK or REFUSE_SHAPE; `check` gives EVAL or a REFUSE_*.
pub const SKIP : u8 = 0;
pub const CHECK : u8 = 1;
pub const EVAL : u8 = 2;
pub const REFUSE_SHAPE : u8 = 3;
pub const REFUSE_FORMAT : u8 = 4;
pub const REFUSE_COUNT : u8 = 5;
pub const REFUSE_TYPE : u8 = 6;

// The class of one argument, as the glue reads its value: one byte, the letter that follows, so `check` takes the
// classes of a tuple as a string (`"si"`: bytes, then an integer). BYTES is a string literal or a `[]const u8`.
pub const K_INT : u8 = 105;
pub const K_FLOAT : u8 = 102;
pub const K_BOOL : u8 = 98;
pub const K_BYTES : u8 = 115;
pub const K_OTHER : u8 = 111;

// The shape of what follows the `:` of a placeholder.
const O_NONE : u8 = 0;
const O_WIDTH : u8 = 1;
const O_PREC : u8 = 2;
const O_BAD : u8 = 3;

const B_LBRACE : u8 = 123;
const B_RBRACE : u8 = 125;
const B_COLON : u8 = 58;
const B_DOT : u8 = 46;
const B_LT : u8 = 60;
const B_GT : u8 = 62;
const B_CARET : u8 = 94;
const B_0 : u8 = 48;
const B_9 : u8 = 57;
const B_D : u8 = 100;
const B_S : u8 = 115;

/// The first decision for one `std.debug.print` statement. analyzed: the fn is one Zig analyzes. nargs: the
/// call's argument count. lit: the first argument is a string literal. tuple: the second is a tuple literal.
pub fn plan(analyzed: bool, nargs: usize, lit: bool, tuple: bool) -> u8 {
    if (!analyzed) { return SKIP; }
    if (nargs != 2 or !lit or !tuple) { return REFUSE_SHAPE; }
    return CHECK;
}

/// The construct a refused print names.
pub fn what(act: u8) -> str {
    if (act == REFUSE_SHAPE) { return "ExprCall(std.debug.print with a non-literal format or tuple)"; }
    if (act == REFUSE_FORMAT) { return "ExprCall(std.debug.print format)"; }
    if (act == REFUSE_COUNT) { return "ExprCall(std.debug.print argument count)"; }
    return "ExprCall(std.debug.print argument type)";
}

/// Why, in the refusal's detail.
pub fn why(act: u8) -> str {
    if (act == REFUSE_SHAPE) { return "t27b lowers print(\"literal\", .{ .. }) only"; }
    if (act == REFUSE_FORMAT) { return "the format string has a brace or a specifier t27b has not measured against the reference"; }
    if (act == REFUSE_COUNT) { return "the placeholders and the tuple differ in length, which the reference's Zig does not compile"; }
    return "an argument's type does not fit its placeholder, or is not one t27b has measured: the reference's Zig does not compile it, or the print is outside what t27b models";
}

/// The kind of a scalar argument by its type: a bool, a float, an integer, or none of them.
pub fn scalar(is_bool: bool, is_float: bool, is_int: bool) -> u8 {
    if (is_bool) { return K_BOOL; }
    if (is_float) { return K_FLOAT; }
    if (is_int) { return K_INT; }
    return K_OTHER;
}

fn is_digit(b: u8) -> bool {
    return b >= B_0 and b <= B_9;
}

fn is_align(b: u8) -> bool {
    return b == B_LT or b == B_GT or b == B_CARET;
}

/// The shape of the text after a placeholder's `:`: `fill align width`, `align width` or `width` (O_WIDTH), or
/// `.precision` (O_PREC). A width needs a digit and a precision needs one; both together are O_BAD, as is
/// anything else.
fn opts(o: []const u8) -> u8 {
    var k : usize = 0;
    if (o.len >= 2 and is_align(o[1])) { k = 2; }
    if (k == 0 and o.len >= 1 and is_align(o[0])) { k = 1; }
    var d : usize = k;
    while (d < o.len and is_digit(o[d])) { d = d + 1; }
    if (d == o.len and d > k) { return O_WIDTH; }
    if (o.len >= 2 and o[0] == B_DOT) {
        var p : usize = 1;
        while (p < o.len and is_digit(o[p])) { p = p + 1; }
        if (p == o.len) { return O_PREC; }
    }
    return O_BAD;
}

/// Does one placeholder fit its argument? spec: the text between `{` and `}`. kind: the argument's class.
fn holder(spec: []const u8, kind: u8) -> u8 {
    var c : usize = 0;
    while (c < spec.len and spec[c] != B_COLON) { c = c + 1; }
    var o : u8 = O_NONE;
    if (c < spec.len) { o = opts(spec[c + 1 .. spec.len]); }
    if (o == O_BAD) { return REFUSE_FORMAT; }
    if (c == 0) {
        // `{}`: no options (`{:5}` is not measured).
        if (o != O_NONE) { return REFUSE_FORMAT; }
        if (kind == K_INT or kind == K_FLOAT or kind == K_BOOL) { return EVAL; }
        return REFUSE_TYPE;
    }
    if (c == 1 and spec[0] == B_D) {
        if (kind == K_INT and o != O_PREC) { return EVAL; }
        if (kind == K_FLOAT and o != O_WIDTH) { return EVAL; }
        return REFUSE_TYPE;
    }
    if (c == 1 and spec[0] == B_S) {
        if (kind == K_BYTES) { return EVAL; }
        return REFUSE_TYPE;
    }
    return REFUSE_FORMAT;
}

/// Does the format string fit the argument classes? EVAL, or the first reason it does not.
pub fn check(fmt: []const u8, kinds: []const u8) -> u8 {
    var k : usize = 0;
    var n : usize = 0;
    while (k < fmt.len) {
        var step : usize = 1;
        if (fmt[k] == B_LBRACE and k + 1 < fmt.len and fmt[k + 1] == B_LBRACE) {
            step = 2;
        } else if (fmt[k] == B_LBRACE) {
            var e : usize = k + 1;
            while (e < fmt.len and fmt[e] != B_RBRACE) { e = e + 1; }
            if (e == fmt.len) { return REFUSE_FORMAT; }
            if (n >= kinds.len) { return REFUSE_COUNT; }
            const r : u8 = holder(fmt[k + 1 .. e], kinds[n]);
            if (r != EVAL) { return r; }
            n = n + 1;
            step = e + 1 - k;
        } else if (fmt[k] == B_RBRACE) {
            if (k + 1 == fmt.len or fmt[k + 1] != B_RBRACE) { return REFUSE_FORMAT; }
            step = 2;
        }
        k = k + step;
    }
    if (n != kinds.len) { return REFUSE_COUNT; }
    return EVAL;
}

// ----------------------------------------------------------------------------------------------------------
// Tests: the shapes the corpus has, then every row of the measured matrix, then the refusals.
// ----------------------------------------------------------------------------------------------------------

test a_print_in_a_fn_nothing_analyzed_reaches_is_skipped_whatever_it_says {
    // reel_particles_mux.t27's `main`: six prints, none checked by the reference.
    assert(plan(false, 2, true, true) == SKIP);
    assert(plan(false, 1, true, false) == SKIP);
    assert(plan(false, 3, false, false) == SKIP);
    assert(plan(false, 0, false, false) == SKIP);
}

test an_analyzed_print_of_a_literal_and_a_tuple_is_checked {
    assert(plan(true, 2, true, true) == CHECK);
}

test an_analyzed_print_of_any_other_shape_is_refused {
    assert(plan(true, 1, true, false) == REFUSE_SHAPE);
    assert(plan(true, 3, true, true) == REFUSE_SHAPE);
    assert(plan(true, 2, false, true) == REFUSE_SHAPE);
    assert(plan(true, 2, true, false) == REFUSE_SHAPE);
    assert(plan(true, 0, false, false) == REFUSE_SHAPE);
}

test the_refusals_are_named {
    assert(what(REFUSE_SHAPE).len > 0);
    assert(what(REFUSE_FORMAT).len > 0);
    assert(what(REFUSE_COUNT).len > 0);
    assert(what(REFUSE_TYPE).len > 0);
    assert(why(REFUSE_SHAPE).len > 0);
    assert(why(REFUSE_FORMAT).len > 0);
    assert(why(REFUSE_COUNT).len > 0);
    assert(why(REFUSE_TYPE).len > 0);
}

test a_format_with_no_placeholder_fits_an_empty_tuple {
    assert(check("hello\n", "") == EVAL);
    assert(check("", "") == EVAL);
}

test reel_particles_mux_prints_fit_their_tuples {
    // `",drawtext=fontfile={s}:textfile={s}/w{d:0>2}.txt:..."`: two strings, then a zero-filled integer.
    assert(check(",drawtext=fontfile={s}:textfile={s}/w{d:0>2}.txt", "ssi") == EVAL);
    assert(check("{s}", "s") == EVAL);
}

test zig_open_slice_print_fits {
    // zig_open_slice.t27's `std.debug.print("{s}", .{row[from..]});`.
    assert(check("{s}", "s") == EVAL);
}

test an_empty_placeholder_takes_an_integer_a_bool_or_a_float {
    assert(check("{}", "i") == EVAL);
    assert(check("{}", "f") == EVAL);
    assert(check("{}", "b") == EVAL);
}

test an_empty_placeholder_refuses_bytes_and_anything_else {
    assert(check("{}", "s") == REFUSE_TYPE);
    assert(check("{}", "o") == REFUSE_TYPE);
}

test d_takes_an_integer_or_a_float {
    assert(check("{d}", "i") == EVAL);
    assert(check("{d}", "f") == EVAL);
}

test d_refuses_a_bool_a_slice_and_anything_else {
    assert(check("{d}", "b") == REFUSE_TYPE);
    assert(check("{d}", "s") == REFUSE_TYPE);
    assert(check("{d}", "o") == REFUSE_TYPE);
}

test s_takes_bytes_only {
    assert(check("{s}", "s") == EVAL);
    assert(check("{s}", "i") == REFUSE_TYPE);
    assert(check("{s}", "f") == REFUSE_TYPE);
    assert(check("{s}", "b") == REFUSE_TYPE);
    assert(check("{s}", "o") == REFUSE_TYPE);
}

test width_options_fit_an_integer_and_a_string {
    assert(check("{d:5}", "i") == EVAL);
    assert(check("{d:>5}", "i") == EVAL);
    assert(check("{d:^6}", "i") == EVAL);
    assert(check("{d:<6}", "i") == EVAL);
    assert(check("{d: >5}", "i") == EVAL);
    assert(check("{d:0>2}", "i") == EVAL);
    assert(check("{s:5}", "s") == EVAL);
}

test a_precision_fits_a_float_and_a_string {
    assert(check("{d:.2}", "f") == EVAL);
    assert(check("{s:.2}", "s") == EVAL);
}

test a_precision_on_an_integer_and_a_width_on_a_float_are_refused_unmeasured {
    assert(check("{d:.2}", "i") == REFUSE_TYPE);
    assert(check("{d:5}", "f") == REFUSE_TYPE);
}

test an_option_t27b_does_not_read_is_refused {
    assert(check("{d:8.3}", "f") == REFUSE_FORMAT);
    assert(check("{d:}", "i") == REFUSE_FORMAT);
    assert(check("{d:>}", "i") == REFUSE_FORMAT);
    assert(check("{d:.}", "f") == REFUSE_FORMAT);
    assert(check("{d:x}", "i") == REFUSE_FORMAT);
    assert(check("{:5}", "i") == REFUSE_FORMAT);
}

test a_specifier_t27b_does_not_know_is_refused {
    assert(check("{x}", "i") == REFUSE_FORMAT);
    assert(check("{c}", "i") == REFUSE_FORMAT);
    assert(check("{any}", "i") == REFUSE_FORMAT);
    assert(check("{e}", "f") == REFUSE_FORMAT);
    assert(check("{dd}", "i") == REFUSE_FORMAT);
}

test doubled_braces_are_not_placeholders {
    assert(check("{{}}", "") == EVAL);
    assert(check("{{{d}}}", "i") == EVAL);
    assert(check("{{", "") == EVAL);
    assert(check("}}", "") == EVAL);
}

test a_lone_brace_is_refused {
    assert(check("{", "") == REFUSE_FORMAT);
    assert(check("}", "") == REFUSE_FORMAT);
    assert(check("a } b", "") == REFUSE_FORMAT);
    assert(check("{d", "i") == REFUSE_FORMAT);
    assert(check("{{}", "") == REFUSE_FORMAT);
}

test the_placeholder_count_must_be_the_tuples_length {
    assert(check("{d}", "") == REFUSE_COUNT);
    assert(check("{d}{d}", "i") == REFUSE_COUNT);
    assert(check("hello", "i") == REFUSE_COUNT);
    assert(check("{d}", "ii") == REFUSE_COUNT);
    assert(check("{d} {s}", "is") == EVAL);
}

test each_placeholder_is_checked_against_its_own_argument {
    assert(check("{d} {s}", "si") == REFUSE_TYPE);
    assert(check("{s} {d} {}", "sfb") == EVAL);
    assert(check("{s} {d} {}", "sfs") == REFUSE_TYPE);
}

test a_scalar_argument_is_a_bool_a_float_an_integer_or_other {
    assert(scalar(true, false, false) == K_BOOL);
    assert(scalar(false, true, false) == K_FLOAT);
    assert(scalar(false, false, true) == K_INT);
    assert(scalar(false, false, false) == K_OTHER);
}
