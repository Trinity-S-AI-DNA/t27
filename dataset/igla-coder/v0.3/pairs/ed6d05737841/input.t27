// SPDX-License-Identifier: Apache-2.0
; specs/policy/issue_shape.t27 -- the shape a new gHashTag/t27 issue must have before it may stay open.
; Owner rule 2026-10-07 (#7498): no issue is created without a Boundary section and the other sections the
; Queen asks for. Measured that morning on /queen/status: 287 of 982 skips in one round were
; missingBoundary and 98 incompleteSpec; all 286 BACKLOG cards lacked `## Boundary`, 261 lacked all four.
; Issue templates cannot hold the line: `gh issue create` and the REST API never see them.
; --
; This file is the single source of truth for the rule. `t27c gen-c` lowers it to
; gen/c/policy/issue_shape.c (never hand-edited, L2); .github/workflows/issue-shape.yml feeds the issue
; body into check_issue() on `issues: opened, edited` and closes the issue as not planned, with the
; failure lines as a comment, while any check fails. An edit that passes reopens it.
; --
; The four checks are a pinned twin of QueenSpecQuality.judge in gHashTag/BrowserOS
; (trios/agent-server/queen-core/Sources/QueenCore/QueenSpecQuality.swift) and of boundaryPathsOf in
; queen-tick.ts. A gate looser than the Queen lets in work she skips every round, which is the failure
; this exists to end; a gate stricter than her refuses work she would take. Decisions:
; - English headings only. L3 keeps this file ASCII, and since 2026-10-05 every issue is English, so the
;   Russian spellings the Queen still reads for old issues are not accepted here. That is the one place
;   the gate is stricter than the Queen, on purpose.
; - Boundary: the section opens at a line that, trimmed, starts `## Boundary`, and ends at the next line
;   starting `## `. A line inside counts when one of its tokens, stripped of `"'( in front and `"'.,;:!?)
;   behind, holds a '/' or ends in a dot and 1 to 10 word characters. A heading with no path is missing.
; - Scenarios: `## user scenarios` or `## scenarios` anywhere (case-folded), or a given/then pair.
; - Requirements: `## requirements` and an obligation: ` must ` (case-folded) or FR- and three digits.
; - Success criteria: a criteria heading and a measurable outcome anywhere in the body, as the Queen's
;   four regular expressions define one: a number with a unit, a backticked file with a source
;   extension, `exit 0` / `exits non-zero`, or a backticked make/swift/bun/cargo/git command.
; - Issues labelled epic or roadmap are containers, not tasks; the workflow skips them, as the Queen does.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PolicyIssueShape;

/// '$' ends a list, ',' separates its entries (numbers: a char literal is not a const initializer in
/// every backend).
pub const LIST_END : u8 = 36;
pub const LIST_SEP : u8 = 44;

/// Bits of the verdict, one per check; check_issue() returns how many are missing.
pub const C_BOUNDARY : u8 = 1;
pub const C_SCENARIOS : u8 = 2;
pub const C_REQUIREMENTS : u8 = 4;
pub const C_CRITERIA : u8 = 8;
pub const C_ALL : u8 = 15;

pub const SCENARIO_HEADS : str = "## user scenarios,## scenarios,$";
pub const GIVEN_WORDS : str = "**given**,given ,$";
pub const THEN_WORDS : str = "**then**,then ,$";
pub const REQUIREMENT_HEADS : str = "## requirements,$";
pub const OBLIGATION_WORDS : str = " must ,$";
pub const CRITERIA_HEADS : str = "## success criteria,## acceptance criteria,## acceptance,## done when,$";
/// Units of the Queen's first outcome pattern, every alternative the regex can take.
pub const UNITS : str = "ms,s,mb,gb,%,files,file,lines,line,tests,test,attempts,attempt,$";
/// Extensions of her second pattern and tools of her fourth.
pub const SOURCE_EXTS : str = "swift,ts,rs,md,json,zig,v,$";
pub const TOOLS : str = "make ,swift ,bun ,cargo ,git ,$";
pub const BOUNDARY_HEAD : str = "## Boundary$";

pub const MSG_BOUNDARY : str = "missing: ## Boundary -- list every file this task may touch, one per line (`- specs/x.t27`); without it the Queen reserves nothing and no bee can take the issue$";
pub const MSG_SCENARIOS : str = "missing: ## User Scenarios -- at least one Given/When/Then scenario$";
pub const MSG_REQUIREMENTS : str = "missing: ## Requirements -- numbered obligations, `FR-001: ... MUST ...`$";
pub const MSG_CRITERIA : str = "missing: ## Success Criteria -- an outcome a machine can settle: a number with a unit, a backticked file, `exit 0`, or a backticked command$";

/// ASCII lowercase of one byte.
pub fn lower(c: u8) -> u8 {
    if (c >= 'A' and c <= 'Z') { return c + 32; }
    return c;
}

pub fn is_digit(c: u8) -> bool {
    return c >= '0' and c <= '9';
}

/// A regex word character: letter, digit or '_'.
pub fn is_word(c: u8) -> bool {
    if (is_digit(c) or c == '_') { return true; }
    const l : u8 = lower(c);
    return l >= 'a' and l <= 'z';
}

/// Is buf[i] a word character? Outside buf[0..n] it is not, as a regex sees the ends.
pub fn word_at(buf: []const u8, n: usize, i: usize) -> bool {
    if (i >= n) { return false; }
    return is_word(buf[i]);
}

pub fn is_space(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r';
}

/// Length of the list entry that starts at list[li].
pub fn entry_len(list: []const u8, li: usize) -> usize {
    var k : usize = li;
    while (list[k] != LIST_SEP and list[k] != LIST_END) { k += 1; }
    return k - li;
}

/// Does the entry at list[li..li+len] match buf at i, case-folded, without running past n?
pub fn entry_at(list: []const u8, li: usize, len: usize, buf: []const u8, n: usize, i: usize) -> bool {
    if (i + len > n) { return false; }
    var k : usize = 0;
    while (k < len) {
        if (lower(buf[i + k]) != lower(list[li + k])) { return false; }
        k += 1;
    }
    return true;
}

/// Length of the first entry of `list` that matches buf at i, or 0 when none does.
pub fn match_any_at(list: []const u8, buf: []const u8, n: usize, i: usize) -> usize {
    var li : usize = 0;
    while (list[li] != LIST_END) {
        const len : usize = entry_len(list, li);
        if (entry_at(list, li, len, buf, n, i)) { return len; }
        li += len;
        if (list[li] == LIST_SEP) { li += 1; }
    }
    return 0;
}

/// Does any entry of `list` occur anywhere in buf[0..n], case-folded? The Queen's hasSection.
pub fn contains_any(list: []const u8, buf: []const u8, n: usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        if (match_any_at(list, buf, n, i) > 0) { return true; }
        i += 1;
    }
    return false;
}

/// `\bFR-\d{3}\b`, case-sensitive as her pattern is.
pub fn has_fr(buf: []const u8, n: usize) -> bool {
    var i : usize = 0;
    while (i + 6 <= n) {
        var ok : bool = buf[i] == 'F' and buf[i + 1] == 'R' and buf[i + 2] == '-';
        if (ok) { ok = is_digit(buf[i + 3]) and is_digit(buf[i + 4]) and is_digit(buf[i + 5]); }
        if (ok and i > 0) { ok = is_word(buf[i - 1]) == false; }
        if (ok) { ok = word_at(buf, n, i + 6) == false; }
        if (ok) { return true; }
        i += 1;
    }
    return false;
}

/// Is the token buf[f..t] a path? A '/' anywhere, or a dot followed by 1 to 10 word characters at its end.
pub fn path_token(buf: []const u8, f: usize, t: usize) -> bool {
    var dot : usize = t;
    var i : usize = f;
    while (i < t) {
        if (buf[i] == '/') { return true; }
        if (buf[i] == '.') { dot = i; }
        i += 1;
    }
    if (dot >= t) { return false; }
    const tail : usize = t - dot - 1;
    if (tail < 1 or tail > 10) { return false; }
    var k : usize = dot + 1;
    while (k < t) {
        if (is_word(buf[k]) == false) { return false; }
        k += 1;
    }
    return true;
}

pub fn lead_strip(c: u8) -> bool {
    return c == '`' or c == '"' or c == '\'' or c == '(';
}

pub fn tail_strip(c: u8) -> bool {
    if (c == '`' or c == '"' or c == '\'' or c == ')') { return true; }
    return c == '.' or c == ',' or c == ';' or c == ':' or c == '!' or c == '?';
}

/// Does the trimmed line buf[s..e] hold a path token?
pub fn line_has_path(buf: []const u8, s: usize, e: usize) -> bool {
    var i : usize = s;
    while (i < e) {
        while (i < e and is_space(buf[i])) { i += 1; }
        var j : usize = i;
        while (j < e and is_space(buf[j]) == false) { j += 1; }
        var f : usize = i;
        var t : usize = j;
        while (f < t and lead_strip(buf[f])) { f += 1; }
        while (t > f and tail_strip(buf[t - 1])) { t -= 1; }
        if (t > f and path_token(buf, f, t)) { return true; }
        i = j;
    }
    return false;
}

/// Does the trimmed line buf[f..t] start `## Boundary`? Case-sensitive, as her startsWith is.
pub fn heading_is_boundary(buf: []const u8, f: usize, t: usize) -> bool {
    if (f + 11 > t) { return false; }
    var k : usize = 0;
    while (k < 11) {
        if (buf[f + k] != BOUNDARY_HEAD[k]) { return false; }
        k += 1;
    }
    return true;
}

/// Does buf hold a `## Boundary` section with at least one path in it? The twin of boundaryPathsOf.
pub fn has_boundary(buf: []const u8, n: usize) -> bool {
    var inside : bool = false;
    var s : usize = 0;
    while (s < n) {
        var e : usize = s;
        while (e < n and buf[e] != '\n') { e += 1; }
        var f : usize = s;
        var t : usize = e;
        while (f < t and is_space(buf[f])) { f += 1; }
        while (t > f and is_space(buf[t - 1])) { t -= 1; }
        if (t >= f + 3 and buf[f] == '#' and buf[f + 1] == '#' and buf[f + 2] == ' ') {
            if (inside) { return false; }
            inside = heading_is_boundary(buf, f, t);
        } else {
            if (inside and t > f and line_has_path(buf, f, t)) { return true; }
        }
        s = e + 1;
    }
    return false;
}

/// Her first outcome pattern at a digit run starting at i: `\b\d+\s*(unit)\b`.
pub fn number_with_unit_at(buf: []const u8, n: usize, i: usize) -> bool {
    if (is_digit(buf[i]) == false) { return false; }
    if (i > 0 and is_word(buf[i - 1])) { return false; }
    var k : usize = i;
    while (k < n and is_digit(buf[k])) { k += 1; }
    while (k < n and is_space(buf[k])) { k += 1; }
    var li : usize = 0;
    while (UNITS[li] != LIST_END) {
        const len : usize = entry_len(UNITS, li);
        if (entry_at(UNITS, li, len, buf, n, k)) {
            if (is_word(buf[k + len - 1]) != word_at(buf, n, k + len)) { return true; }
        }
        li += len;
        if (UNITS[li] == LIST_SEP) { li += 1; }
    }
    return false;
}

/// `\bexit(s)? (0|non-zero)\b` at i, case-folded.
pub fn exit_code_at(buf: []const u8, n: usize, i: usize) -> bool {
    if (entry_at("exit$", 0, 4, buf, n, i) == false) { return false; }
    if (i > 0 and is_word(buf[i - 1])) { return false; }
    var k : usize = i + 4;
    if (k < n and lower(buf[k]) == 's') { k += 1; }
    if (k >= n or buf[k] != ' ') { return false; }
    k += 1;
    if (k < n and buf[k] == '0') { return word_at(buf, n, k + 1) == false; }
    if (entry_at("non-zero$", 0, 8, buf, n, k)) { return word_at(buf, n, k + 8) == false; }
    return false;
}

/// Her second and fourth patterns on the backtick span buf[i+1..j], j the next backtick after i.
pub fn backtick_outcome(buf: []const u8, n: usize, i: usize, j: usize) -> bool {
    if (match_any_at(TOOLS, buf, j, i + 1) > 0) {
        if (j > i + 1 + match_any_at(TOOLS, buf, j, i + 1)) { return true; }
    }
    var dot : usize = j;
    var k : usize = i + 1;
    while (k < j) {
        if (buf[k] == '.') { dot = k; }
        k += 1;
    }
    if (dot >= j or dot <= i + 1) { return false; }
    var li : usize = 0;
    while (SOURCE_EXTS[li] != LIST_END) {
        const len : usize = entry_len(SOURCE_EXTS, li);
        if (j == dot + 1 + len and entry_at(SOURCE_EXTS, li, len, buf, j, dot + 1)) { return true; }
        li += len;
        if (SOURCE_EXTS[li] == LIST_SEP) { li += 1; }
    }
    return false;
}

/// hasMeasurableOutcome: any of her four patterns anywhere in buf[0..n].
pub fn has_outcome(buf: []const u8, n: usize) -> bool {
    var i : usize = 0;
    var open : usize = n;
    while (i < n) {
        if (number_with_unit_at(buf, n, i) or exit_code_at(buf, n, i)) { return true; }
        if (buf[i] == '`') {
            if (open < i and backtick_outcome(buf, n, open, i)) { return true; }
            open = i;
        }
        i += 1;
    }
    return false;
}

/// The Queen's four checks as bits: a set bit is a check that passes.
pub fn judge(buf: []const u8, n: usize) -> u8 {
    var met : u8 = 0;
    if (has_boundary(buf, n)) { met += C_BOUNDARY; }
    var scen : bool = contains_any(SCENARIO_HEADS, buf, n);
    if (scen == false) { scen = contains_any(GIVEN_WORDS, buf, n) and contains_any(THEN_WORDS, buf, n); }
    if (scen) { met += C_SCENARIOS; }
    if (contains_any(REQUIREMENT_HEADS, buf, n)) {
        if (has_fr(buf, n) or contains_any(OBLIGATION_WORDS, buf, n)) { met += C_REQUIREMENTS; }
    }
    if (contains_any(CRITERIA_HEADS, buf, n) and has_outcome(buf, n)) { met += C_CRITERIA; }
    return met;
}

/// Write one byte at w if it fits; the returned position keeps counting past the end.
pub fn put(out: []u8, w: usize, cap: usize, c: u8) -> usize {
    if (w < cap) { out[w] = c; }
    return w + 1;
}

/// Write a '$'-terminated message and a newline.
pub fn put_line(out: []u8, w: usize, cap: usize, msg: []const u8) -> usize {
    var p : usize = w;
    var i : usize = 0;
    while (msg[i] != LIST_END) {
        p = put(out, p, cap, msg[i]);
        i += 1;
    }
    return put(out, p, cap, '\n');
}

/// Read an issue body buf[0..n], write one `missing:` line per failed check into out[0..cap], and return
/// how many checks failed. The caller closes the issue when this is not 0.
pub fn check_issue(buf: []const u8, n: usize, out: []u8, cap: usize) -> u32 {
    const met : u8 = judge(buf, n);
    var w : usize = 0;
    var missing : u32 = 0;
    if ((met & C_BOUNDARY) == 0) {
        w = put_line(out, w, cap, MSG_BOUNDARY);
        missing += 1;
    }
    if ((met & C_SCENARIOS) == 0) {
        w = put_line(out, w, cap, MSG_SCENARIOS);
        missing += 1;
    }
    if ((met & C_REQUIREMENTS) == 0) {
        w = put_line(out, w, cap, MSG_REQUIREMENTS);
        missing += 1;
    }
    if ((met & C_CRITERIA) == 0) {
        w = put_line(out, w, cap, MSG_CRITERIA);
        missing += 1;
    }
    return missing;
}

; --- Regions: a Boundary line may name one item of its file (t27#9021 item e, 2026-10-11) -----------
; Measured 2026-10-11 10:57Z on the live round: 125 of 232 file-blocked candidates were shut out by one
; holder of bootstrap/src/compiler.rs, a file of 46753 lines and 1886 `fn` items. queen/actors.t27
; section 10 already admits two edits of one file whose regions do not meet (edits_meet), but an issue
; had no way to name a region, so every edit was EDIT_WHOLE.
; The format: after the path, ` :: `, then the name of one item, optionally after `fn`:
;     - bootstrap/src/compiler.rs :: fn gen_verilog_let_destructuring
; One region per line; a second item is a second line with the same path. The Queen's path parser, and
; every older reader, takes the first path token of the line and ignores the rest, so an old reader
; holds the whole file: a region only ever narrows what a newer reader holds.
; Identification: the item is the ONE `fn NAME` definition outside comments and string literals in the
; file at the base commit the round reads. It runs from its `fn` line through the line of the brace that
; closes its body ([first, end) for edits_meet's EDIT_LINES). Both sides of a comparison resolve against
; that one base, so their lines agree. A name defined twice or not at all, or a body that does not
; close, resolves to nothing, and the line is the whole file.
; The two sides of an edit: admission compares the DECLARED regions; at merge every hunk of the bee's
; diff (its lines on the base side) must lie inside a declared region of its file (edit_inside). One
; hunk outside makes that file's edit EDIT_WHOLE again, so nothing is less safe than a whole-file line.

/// Two 32-bit halves in one u64: a span [f, t) travels as f * PACK + t.
pub const PACK : u64 = 4294967296;

/// The k-th line (from 0) of buf's Boundary section that holds a path, as its trimmed span f * PACK + t;
/// 0 when there is no such line. The same walk as has_boundary.
pub fn boundary_line(buf: []const u8, n: usize, k: u32) -> u64 {
    var inside : bool = false;
    var seen : u32 = 0;
    var s : usize = 0;
    while (s < n) {
        var e : usize = s;
        while (e < n and buf[e] != '\n') { e += 1; }
        var f : usize = s;
        var t : usize = e;
        while (f < t and is_space(buf[f])) { f += 1; }
        while (t > f and is_space(buf[t - 1])) { t -= 1; }
        if (t >= f + 3 and buf[f] == '#' and buf[f + 1] == '#' and buf[f + 2] == ' ') {
            if (inside) { return 0; }
            inside = heading_is_boundary(buf, f, t);
        } else {
            if (inside and t > f and line_has_path(buf, f, t)) {
                if (seen == k) { return (f as u64) * PACK + (t as u64); }
                seen += 1;
            }
        }
        s = e + 1;
    }
    return 0;
}

/// Where, in the line buf[f..t], the whitespace token holding the first path ends; t + 1 when none does.
pub fn path_token_end(buf: []const u8, f: usize, t: usize) -> usize {
    var i : usize = f;
    while (i < t) {
        while (i < t and is_space(buf[i])) { i += 1; }
        var j : usize = i;
        while (j < t and is_space(buf[j]) == false) { j += 1; }
        var a : usize = i;
        var b : usize = j;
        while (a < b and lead_strip(buf[a])) { a += 1; }
        while (b > a and tail_strip(buf[b - 1])) { b -= 1; }
        if (b > a and path_token(buf, a, b)) { return j; }
        i = j;
    }
    return t + 1;
}

/// The first path of the line buf[f..t], stripped as the Queen strips it, as a * PACK + b; 0 when none.
pub fn line_path(buf: []const u8, f: usize, t: usize) -> u64 {
    const j : usize = path_token_end(buf, f, t);
    if (j > t) { return 0; }
    var a : usize = j;
    while (a > f and is_space(buf[a - 1]) == false) { a -= 1; }
    var b : usize = j;
    while (a < b and lead_strip(buf[a])) { a += 1; }
    while (b > a and tail_strip(buf[b - 1])) { b -= 1; }
    return (a as u64) * PACK + (b as u64);
}

/// The item the line buf[f..t] names after its path (` :: NAME` or ` :: fn NAME`, either in backticks),
/// as the span of NAME; 0 when the line names the whole file. NAME is word characters, not starting with
/// a digit, followed by nothing but a space, `(`, `)` or a backtick.
pub fn line_region(buf: []const u8, f: usize, t: usize) -> u64 {
    var p : usize = path_token_end(buf, f, t);
    if (p > t) { return 0; }
    while (p < t and is_space(buf[p])) { p += 1; }
    if (p + 2 > t) { return 0; }
    if (buf[p] != ':' or buf[p + 1] != ':') { return 0; }
    p += 2;
    if (p >= t or is_space(buf[p]) == false) { return 0; }
    while (p < t and is_space(buf[p])) { p += 1; }
    if (p < t and buf[p] == '`') { p += 1; }
    if (p + 3 <= t and buf[p] == 'f' and buf[p + 1] == 'n' and is_space(buf[p + 2])) {
        p += 3;
        while (p < t and is_space(buf[p])) { p += 1; }
    }
    var q : usize = p;
    while (q < t and is_word(buf[q])) { q += 1; }
    if (q == p) { return 0; }
    if (is_digit(buf[p])) { return 0; }
    if (q < t and is_space(buf[q]) == false and buf[q] != '(' and buf[q] != ')' and buf[q] != '`') { return 0; }
    return (p as u64) * PACK + (q as u64);
}

/// If a comment, a string, a raw string or a char literal starts at text[i], where it ends; else i.
/// Rust's and Zig's spellings, which the hot files are written in: `//` to the end of the line,
/// `/* */`, "..." with backslash escapes, r"..." / r#"..."# (also after b), and 'x' / '\n'. A lifetime
/// ('a) is not a literal and is left as code.
pub fn skip_at(text: []const u8, n: usize, i: usize) -> usize {
    const c : u8 = text[i];
    if (c == '/' and i + 1 < n and text[i + 1] == '/') {
        var j : usize = i + 2;
        while (j < n and text[j] != '\n') { j += 1; }
        return j;
    }
    if (c == '/' and i + 1 < n and text[i + 1] == '*') {
        var j : usize = i + 2;
        while (j + 1 < n and (text[j] != '*' or text[j + 1] != '/')) { j += 1; }
        if (j + 1 >= n) { return n; }
        return j + 2;
    }
    if (c == 'r') {
        var lone : bool = i == 0;
        if (i > 0) { lone = is_word(text[i - 1]) == false; }
        if (i > 0 and text[i - 1] == 'b') {
            lone = i == 1;
            if (i > 1) { lone = is_word(text[i - 2]) == false; }
        }
        var h : usize = i + 1;
        var hashes : usize = 0;
        while (h < n and text[h] == '#') { h += 1; hashes += 1; }
        if (lone and h < n and text[h] == '"') {
            var j : usize = h + 1;
            while (j < n) {
                if (text[j] == '"') {
                    var m : usize = 0;
                    while (m < hashes and j + 1 + m < n and text[j + 1 + m] == '#') { m += 1; }
                    if (m == hashes) { return j + 1 + hashes; }
                }
                j += 1;
            }
            return n;
        }
    }
    if (c == '"') {
        var j : usize = i + 1;
        while (j < n and text[j] != '"') {
            if (text[j] == '\\') { j += 1; }
            j += 1;
        }
        if (j >= n) { return n; }
        return j + 1;
    }
    if (c == '\'') {
        if (i + 2 < n and text[i + 1] != '\\' and text[i + 2] == '\'') { return i + 3; }
        if (i + 1 < n and text[i + 1] == '\\') {
            var j : usize = i + 2;
            while (j < n and j < i + 12 and text[j] != '\'') { j += 1; }
            if (j < n and text[j] == '\'') { return j + 1; }
        }
    }
    return i;
}

/// Does a definition `fn NAME` start at text[i]: `fn` not inside a word, spaces, the name, and no word
/// character after it?
pub fn defines_at(text: []const u8, n: usize, i: usize, name: []const u8, nlen: usize) -> bool {
    if (i + 3 + nlen > n) { return false; }
    if (text[i] != 'f' or text[i + 1] != 'n') { return false; }
    if (i > 0 and is_word(text[i - 1])) { return false; }
    var p : usize = i + 2;
    if (text[p] != ' ' and text[p] != '\t') { return false; }
    while (p < n and (text[p] == ' ' or text[p] == '\t')) { p += 1; }
    if (p + nlen > n) { return false; }
    var k : usize = 0;
    while (k < nlen) {
        if (text[p + k] != name[k]) { return false; }
        k += 1;
    }
    return word_at(text, n, p + nlen) == false;
}

/// The lines of the one `fn NAME` item of text: first * PACK + end, 1-based, end exclusive; 0 when the
/// name is defined twice or not at all, or its body does not close.
pub fn item_span(text: []const u8, n: usize, name: []const u8, nlen: usize) -> u64 {
    if (nlen == 0) { return 0; }
    var count : u32 = 0;
    var found : usize = 0;
    var i : usize = 0;
    while (i < n) {
        const j : usize = skip_at(text, n, i);
        if (j != i) {
            i = j;
        } else {
            if (defines_at(text, n, i, name, nlen)) {
                count += 1;
                found = i;
            }
            i += 1;
        }
    }
    if (count != 1) { return 0; }
    var depth : u32 = 0;
    var opened : bool = false;
    var close : usize = n;
    var p : usize = found;
    while (p < n and close == n) {
        const q : usize = skip_at(text, n, p);
        if (q != p) {
            p = q;
        } else {
            const c : u8 = text[p];
            if (c == '{') {
                depth += 1;
                opened = true;
            }
            if (c == '}') {
                if (depth == 0) { return 0; }
                depth -= 1;
                if (opened and depth == 0) { close = p; }
            }
            if (c == ';' and opened == false) { close = p; }
            p += 1;
        }
    }
    if (close == n) { return 0; }
    var line : u64 = 1;
    var first : u64 = 1;
    var k : usize = 0;
    while (k < close) {
        if (k == found) { first = line; }
        if (text[k] == '\n') { line += 1; }
        k += 1;
    }
    return first * PACK + (line + 1);
}

/// Does a hunk of the bee's diff, lines [lo, hi) of the base side, lie inside a declared region
/// [s, e)? A pure insertion (lo == hi) lands before line lo, so it must fall strictly between the
/// region's first and last line.
pub fn edit_inside(lo: u32, hi: u32, s: u32, e: u32) -> bool {
    if (s >= e) { return false; }
    if (lo == hi) { return s < lo and lo < e; }
    return s <= lo and hi <= e;
}

test a_boundary_needs_a_path_under_its_heading {
    assert has_boundary("## Boundary\n- specs/a.t27\n", 26) == true;
    assert has_boundary("## Boundary\n- `a.rs`.\n", 22) == true;
    assert has_boundary("  ## Boundary  \r\n- x/y\r\n", 24) == true;
    assert has_boundary("## Boundary\nnothing here\n", 25) == false;
    assert has_boundary("## Boundary\n\n## Scope\n- a/b.t27\n", 32) == false;
    assert has_boundary("### Boundary\n- a.py\n", 20) == false;
    assert has_boundary("## Boundaries\n- a.py\n", 21) == false;
    assert has_boundary("## Boundary (files)\n- a.py\n", 27) == true;
    assert has_boundary("## Scope\n- a/b.t27\n", 19) == false;
    assert has_boundary("## boundary\n- a/b\n", 18) == false;
}

test a_path_token_is_a_slash_or_a_short_extension {
    assert path_token("a/b", 0, 3) == true;
    assert path_token("x.t27", 0, 5) == true;
    assert path_token("x.abcdefghij", 0, 12) == true;
    assert path_token("x.abcdefghijk", 0, 13) == false;
    assert path_token("x.", 0, 2) == false;
    assert path_token("x.a-b", 0, 5) == false;
    assert path_token("word", 0, 4) == false;
    assert line_has_path("- (see a.md),", 0, 13) == true;
    assert line_has_path("- see the docs", 0, 14) == false;
}

test requirements_need_an_obligation {
    assert has_fr("FR-001: x", 9) == true;
    assert has_fr("FR-0012", 7) == false;
    assert has_fr("XFR-001", 7) == false;
    assert has_fr("fr-001", 6) == false;
    assert has_fr("FR-01", 5) == false;
    assert judge("## Requirements\n- it MUST work\n", 31) == C_REQUIREMENTS;
    assert judge("## Requirements\n- it should work\n", 33) == 0;
    assert judge("## Requirements\n- FR-002 ok\n", 28) == C_REQUIREMENTS;
}

test scenarios_are_a_heading_or_a_given_then_pair {
    assert judge("## User Scenarios\n", 18) == C_SCENARIOS;
    assert judge("## Scenarios\n", 13) == C_SCENARIOS;
    assert judge("Given a, then b\n", 16) == C_SCENARIOS;
    assert judge("**Given** a **Then** b", 22) == C_SCENARIOS;
    assert judge("Given a and b\n", 14) == 0;
    assert judge("then b\n", 7) == 0;
}

test an_outcome_is_one_of_four_patterns {
    assert has_outcome("in 5 ms", 7) == true;
    assert has_outcome("12 files", 8) == true;
    assert has_outcome("1 test", 6) == true;
    assert has_outcome("3 attempts", 10) == true;
    assert has_outcome("5 seconds", 9) == false;
    assert has_outcome("v2 tests", 8) == false;
    assert has_outcome("50% of", 6) == false;
    assert has_outcome("50%x", 4) == true;
    assert has_outcome("it exits 0.", 11) == true;
    assert has_outcome("exit non-zero", 13) == true;
    assert has_outcome("exit 01", 7) == false;
    assert has_outcome("exit  0", 7) == false;
    assert has_outcome("reexit 0", 8) == false;
    assert has_outcome("see `a/b.rs` here", 17) == true;
    assert has_outcome("see `b.t27` here", 16) == false;
    assert has_outcome("see `.rs` here", 14) == false;
    assert has_outcome("run `cargo test -p x`", 21) == true;
    assert has_outcome("run `git ` x", 12) == false;
    assert has_outcome("run `tri test`", 14) == false;
    assert has_outcome("faster and cleaner", 18) == false;
}

test check_issue_names_every_missing_section {
    var out : [1024]u8 = undefined;
    const full : []const u8 = "## Boundary\n- specs/a.t27\n## User Scenarios\n- Given x, then y\n## Requirements\n- FR-001: it MUST\n## Success Criteria\n- `cargo test` exits 0\n";
    assert check_issue(full, 139, &out, 1024) == 0;
    assert check_issue("fix the thing please", 20, &out, 1024) == 4;
    assert out[0] == 'm';
    const no_boundary : []const u8 = "## User Scenarios\n## Requirements\n- it MUST pass\n## Success Criteria\n- 3 tests pass\n";
    assert check_issue(no_boundary, 84, &out, 1024) == 1;
    assert out[12] == 'B';
}

test check_issue_never_writes_past_cap {
    var out : [4]u8 = undefined;
    assert check_issue("x", 1, &out, 4) == 4;
}

test a_boundary_line_is_found_by_its_place {
    const body : []const u8 = "intro\n## Boundary\n\n- specs/a.t27\nprose only\n- bootstrap/src/compiler.rs :: fn emit\n## Next\n- specs/b.t27\n";
    // the first path line: `- specs/a.t27` at bytes 19..32
    assert boundary_line(body, 105, 0) == 19 * PACK + 32;
    // prose without a path is not counted
    assert boundary_line(body, 105, 1) == 44 * PACK + 82;
    // the section ends at the next heading
    assert boundary_line(body, 105, 2) == 0;
    assert boundary_line("## Scope\n- specs/a.t27\n", 23, 0) == 0;
}

test a_line_names_its_path_and_maybe_one_item {
    const whole : []const u8 = "- `bootstrap/src/compiler.rs`";
    assert line_path(whole, 0, 29) == 3 * PACK + 28;
    assert line_region(whole, 0, 29) == 0;
    const item : []const u8 = "- bootstrap/src/compiler.rs :: fn gen_verilog_let_destructuring";
    assert line_path(item, 0, 63) == 2 * PACK + 27;
    assert line_region(item, 0, 63) == 34 * PACK + 63;
    const bare : []const u8 = "- bootstrap/src/compiler.rs :: emit_instance";
    assert line_region(bare, 0, 44) == 31 * PACK + 44;
    const ticked : []const u8 = "- bootstrap/src/compiler.rs :: `fn on_clock`";
    assert line_region(ticked, 0, 44) == 35 * PACK + 43;
    const called : []const u8 = "- bootstrap/src/compiler.rs :: fn on_clock()";
    assert line_region(called, 0, 44) == 34 * PACK + 42;
}

test anything_else_after_a_path_is_the_whole_file {
    // one colon, glued colons, a digit first, a path, prose: all whole
    assert line_region("- a/b.rs : fn x", 0, 15) == 0;
    assert line_region("- a/b.rs ::fn x", 0, 15) == 0;
    assert line_region("- a/b.rs :: 9x", 0, 14) == 0;
    assert line_region("- a/b.rs :: c/d.rs", 0, 18) == 0;
    assert line_region("- a/b.rs :: x, y", 0, 16) == 0;
    assert line_region("- a/b.rs and more prose", 0, 23) == 0;
    assert line_region("- a/b.rs ::", 0, 11) == 0;
    assert line_region("no path here :: fn x", 0, 20) == 0;
    // two characters that are not `::` are not the mark
    assert line_region("- a/b.rs or fn x", 0, 16) == 0;
}

test an_item_runs_from_its_fn_to_the_brace_that_closes_it {
    const src : []const u8 = "fn a() {\n    x();\n}\n\nfn b(s: &str) {\n    if s == \"}\" { y(); }\n}\n";
    assert item_span(src, 64, "a", 1) == 1 * PACK + 4;
    assert item_span(src, 64, "b", 1) == 5 * PACK + 8;
    // a name used but never defined, and an empty name
    assert item_span(src, 64, "y", 1) == 0;
    assert item_span(src, 64, "", 0) == 0;
}

test a_raw_string_ends_only_at_its_own_hashes {
    // r#"x"}"# holds a quote and a brace; read as a plain string it would end at the quote
    const src : []const u8 = "fn m() {\n    let t = r#\"x\"}\"#;\n}\n";
    assert item_span(src, 33, "m", 1) == 1 * PACK + 4;
}

test braces_in_comments_and_literals_do_not_count {
    const src : []const u8 = "pub fn c() {\n    // }\n    let s = r#\"}\"#;\n    let k = '}';\n    /* } */\n}\nfn d() {}\n";
    assert item_span(src, 83, "c", 1) == 1 * PACK + 7;
    assert item_span(src, 83, "d", 1) == 7 * PACK + 8;
}

test an_ambiguous_or_unclosed_item_resolves_to_nothing {
    const twice : []const u8 = "fn e() {}\nfn e() {}\n";
    assert item_span(twice, 20, "e", 1) == 0;
    const open_body : []const u8 = "fn f() {\n";
    assert item_span(open_body, 9, "f", 1) == 0;
    // a definition inside a string literal is not one
    const quoted : []const u8 = "let s = \"fn g() {\";\nfn h() {}\n";
    assert item_span(quoted, 30, "g", 1) == 0;
    // a longer name is not this name, and neither is a word ending in fn
    const longer : []const u8 = "fn gg() {}\nfn_x g() {}\n";
    assert item_span(longer, 23, "g", 1) == 0;
    // a declaration with no body ends at its semicolon
    const decl : []const u8 = "fn k(a: u8) -> u8;\n";
    assert item_span(decl, 19, "k", 1) == 1 * PACK + 2;
}

test a_hunk_must_stay_inside_its_region {
    assert edit_inside(10, 12, 5, 20) == true;
    assert edit_inside(5, 20, 5, 20) == true;
    assert edit_inside(4, 6, 5, 20) == false;
    assert edit_inside(19, 21, 5, 20) == false;
    // an insertion strictly inside, and one at either edge
    assert edit_inside(12, 12, 5, 20) == true;
    assert edit_inside(5, 5, 5, 20) == false;
    assert edit_inside(20, 20, 5, 20) == false;
    // an empty region holds no edit
    assert edit_inside(5, 6, 5, 5) == false;
}

invariant the_checks_are_four_distinct_bits {
    assert C_BOUNDARY + C_SCENARIOS + C_REQUIREMENTS + C_CRITERIA == C_ALL;
    assert (C_BOUNDARY & C_SCENARIOS) == 0;
    assert (C_REQUIREMENTS & C_CRITERIA) == 0;
    assert (C_SCENARIOS & C_REQUIREMENTS) == 0;
}
