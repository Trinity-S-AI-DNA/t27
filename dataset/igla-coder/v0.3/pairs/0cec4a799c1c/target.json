        if (field_eq(nodes, text, i, F_OP, "~") && ts_int(own)) {
            q = put_text(out, q, "(~");
            let r4: i64 = ex(out, q, nodes, text, meta, ptext, item, (i + 1), own);
            if (r4 < 0) {
                return r4;
            }
            q = (r4 as _);
            if (own == 32) {
                q = put_text(out, q, " >>> 0)");
            } else {
                if ts_unsigned(own) {
                    q = put_text(out, q, " & ");
                    q = put_i64(out, q, ts_max(own));
                    q = put_text(out, q, ")");
                } else {
                    q = put_text(out, q, ")");
                }
            }
            let rt2: i64 = (q as _);
            return rt2;
        }
        if (field_eq(nodes, text, i, F_OP, "-") && ts_signed(own)) {
            q = put_text(out, q, "t27_chk(-(");
            let r5: i64 = ex(out, q, nodes, text, meta, ptext, item, (i + 1), own);
            if (r5 < 0) {
                return r5;
            }
            q = (r5 as _);
            q = put_text(out, q, "), ");
            q = put_i64(out, q, ts_min(own));
            q = put_text(out, q, ", ");
            q = put_i64(out, q, ts_max(own));
            q = put_text(out, q, ")");
            let rm: i64 = (q as _);
            return rm;
        }
        return fail(out, nodes, meta, text, i, "operator", lo(nodes, i, F_OP), hi(nodes, i, F_OP));
    }
    if (k == K_EXPR_CAST) {
        return ex_cast(out, q, nodes, text, meta, ptext, item, i, own);
    }
    if (k == K_EXPR_CALL) {
        return ex_call(out, q, nodes, text, meta, ptext, item, i);
    }
    if (k == K_EXPR_IF) {
        if (children(nodes, i) != 3) {
            return fail(out, nodes, meta, text, i, "if expression", 0, 0);
        }
        let c0: usize = (i + 1);
        let a1: usize = end(nodes, c0);
        let a2: usize = end(nodes, a1);
        q = put_text(out, q, "(");
        let r6: i64 = ex(out, q, nodes, text, meta, ptext, item, c0, TS_BOOL);
        if (r6 < 0) {
            return r6;
        }
        q = (r6 as _);
        q = put_text(out, q, " ? ");
        let r7: i64 = ex(out, q, nodes, text, meta, ptext, item, a1, own);
        if (r7 < 0) {
            return r7;
        }
        q = (r7 as _);
        q = put_text(out, q, " : ");
        let r8: i64 = ex(out, q, nodes, text, meta, ptext, item, a2, own);
        if (r8 < 0) {
            return r8;
        }
        q = (r8 as _);
        q = put_text(out, q, ")");
        let rif: i64 = (q as _);
        return rif;
    }
    return fail(out, nodes, meta, text, i, kind_label(k), lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
}

pub fn ex_op(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, l: usize, r: usize, oa: usize, ob: usize, own: i64) -> i64 {
    let form: u8 = ts_arith(&text[(oa) as usize..(ob) as usize]);
    if (form == AR_BAD) {
        return fail(out, nodes, meta, text, l, "operator", oa, ob);
    }
    let mut q: usize = at;
    if (form == AR_SHIFTS) {
        if !(ts_int(own)) {
            return fail(out, nodes, meta, text, l, "shift of a value that is no integer", oa, ob);
        }
        let mut rw: i64 = ty_of(nodes, text, meta, ptext, item, r, 0);
        if (rw == TS_COMPTIME) {
            rw = 32;
        }
        if (rw == TS_BAD) {
            return ex(out, at, nodes, text, meta, ptext, item, r, TS_BAD);
        }
        if !(ts_unsigned(rw)) {
            return fail(out, nodes, meta, text, l, "shift by an amount that is no unsigned integer", oa, ob);
        }
        q = put_text(out, q, ts_arith_op(&text[(oa) as usize..(ob) as usize]));
        q = put_text(out, q, "(");
        let s1: i64 = ex(out, q, nodes, text, meta, ptext, item, l, own);
        if (s1 < 0) {
            return s1;
        }
        q = (s1 as _);
        q = put_text(out, q, ", ");
        let s2: i64 = ex(out, q, nodes, text, meta, ptext, item, r, rw);
        if (s2 < 0) {
            return s2;
        }
        q = (s2 as _);
        q = put_text(out, q, ", ");
        q = put_i64(out, q, ts_width(own));
        q = put_sign(out, q, own);
        let rs: i64 = (q as _);
        return rs;
    }
    if (!(ts_scalar(own)) || ((own == TS_BOOL) && (form != AR_BITS))) {
        return fail(out, nodes, meta, text, l, "operator", oa, ob);
    }
    if ((form == AR_DIVIDES) && !(ts_unsigned(own))) {
        return fail(out, nodes, meta, text, l, "division of a value that is no unsigned integer (t27c asks for @divTrunc or @rem)", oa, ob);
    }
    let imul: bool = same(&text[(oa) as usize..(ob) as usize], "*%");
    if (form == AR_CHECKED) {
        q = put_text(out, q, "t27_chk((");
    }
    if (form == AR_WRAPS) {
        q = put_text(out, q, "t27_wrap(");
        if imul {
            q = put_text(out, q, "Math.imul(");
        } else {
            q = put_text(out, q, "(");
        }
    }
    if (form == AR_DIVIDES) {
        q = put_text(out, q, ts_arith_op(&text[(oa) as usize..(ob) as usize]));
        q = put_text(out, q, "(");
    }
    if (form == AR_BITS) {
        if ((own == 32) || (own == TS_BOOL)) {
            q = put_text(out, q, "((");
        } else {
            q = put_text(out, q, "(");
        }
    }
    let e1: i64 = ex(out, q, nodes, text, meta, ptext, item, l, own);
    if (e1 < 0) {
        return e1;
    }
    q = (e1 as _);
    if ((form == AR_DIVIDES) || imul) {
        q = put_text(out, q, ", ");
    } else {
        q = put_text(out, q, " ");
        q = put_text(out, q, ts_arith_op(&text[(oa) as usize..(ob) as usize]));
        q = put_text(out, q, " ");
    }
    let e2: i64 = ex(out, q, nodes, text, meta, ptext, item, r, own);
    if (e2 < 0) {
        return e2;
    }
    q = (e2 as _);
    if (form == AR_CHECKED) {
        q = put_text(out, q, "), ");
        q = put_i64(out, q, ts_min(own));
        q = put_text(out, q, ", ");
        q = put_i64(out, q, ts_max(own));
        q = put_text(out, q, ")");
    }
    if (form == AR_WRAPS) {
        q = put_text(out, q, "), ");
        q = put_i64(out, q, ts_width(own));
        q = put_sign(out, q, own);
    }
    if (form == AR_DIVIDES) {
        q = put_text(out, q, ")");
    }
    if (form == AR_BITS) {
        if (own == 32) {
            q = put_text(out, q, ") >>> 0)");
        } else {
            if (own == TS_BOOL) {
                q = put_text(out, q, ") !== 0)");
            } else {
                q = put_text(out, q, ")");
            }
        }
    }
    let ro: i64 = (q as _);
    return ro;
}

pub fn ex_cast(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, i: usize, own: i64) -> i64 {
    let src: i64 = ty_of(nodes, text, meta, ptext, item, (i + 1), 0);
    if (src == TS_COMPTIME) {
        return ex(out, at, nodes, text, meta, ptext, item, (i + 1), own);
    }
    if (src == TS_BAD) {
        return ex(out, at, nodes, text, meta, ptext, item, (i + 1), TS_BAD);
    }
    if !(ts_scalar(src)) {
        return fail(out, nodes, meta, text, i, "cast of a value that is no integer or bool", lo(nodes, i, F_TYPE), hi(nodes, i, F_TYPE));
    }
    if ((src == TS_BOOL) || (own == TS_BOOL)) {
        if (src != own) {
            return fail(out, nodes, meta, text, i, "cast between bool and an integer", lo(nodes, i, F_TYPE), hi(nodes, i, F_TYPE));
        }
        return ex(out, at, nodes, text, meta, ptext, item, (i + 1), src);
    }
    if ts_coerces(src, own) {
        return ex(out, at, nodes, text, meta, ptext, item, (i + 1), src);
    }
    let narrows: bool = (ts_width(own) < ts_width(src));
    let mut q: usize = at;
    if narrows {
        q = put_text(out, q, "t27_wrap(");
    } else {
        q = put_text(out, q, "t27_chk(");
    }
    let r1: i64 = ex(out, q, nodes, text, meta, ptext, item, (i + 1), src);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, ", ");
    if narrows {
        q = put_i64(out, q, ts_width(own));
        q = put_sign(out, q, own);
    } else {
        q = put_i64(out, q, ts_min(own));
        q = put_text(out, q, ", ");
        q = put_i64(out, q, ts_max(own));
        q = put_text(out, q, ")");
    }
    let rc: i64 = (q as _);
    return rc;
}

pub fn ex_call(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, i: usize) -> i64 {
    let f: i64 = find_fn(nodes, text, lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    if (f == NO_NODE) {
        return fail(out, nodes, meta, text, i, "call of an undeclared fn", lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    }
    let fi: usize = (f as _);
    if is_extern(nodes, fi) {
        return fail(out, nodes, meta, text, i, "call of an extern fn", lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    }
    let np: usize = param_count(ptext, params_lo(meta, fi), params_hi(meta, fi));
    if (children(nodes, i) != np) {
        return fail(out, nodes, meta, text, i, "call with the wrong number of arguments", lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    }
    let mut q: usize = put_bytes(out, at, text, lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    q = put_text(out, q, "(");
    let mut a: usize = (i + 1);
    let mut kx: usize = 0;
    while (a < end(nodes, i)) {
        if (kx > 0) {
            q = put_text(out, q, ", ");
        }
        let pt: i64 = param_type(meta, ptext, fi, kx);
        if !(ts_scalar(pt)) {
            return fail(out, nodes, meta, text, i, "call of a fn with a parameter that is no integer or bool", lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
        }
        let r: i64 = ex(out, q, nodes, text, meta, ptext, item, a, pt);
        if (r < 0) {
            return r;
        }
        q = (r as _);
        a = end(nodes, a);
        kx = (kx + 1);
    }
    q = put_text(out, q, ")");
    let rr: i64 = (q as _);
    return rr;
}

pub fn stmts(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, b: usize, c: usize, n: usize, lp: usize) -> i64 {
    let mut q: usize = at;
    let mut s: usize = c;
    while (s < end(nodes, b)) {
        let r: i64 = stmt(out, q, nodes, text, meta, ptext, item, s, n, lp);
        if (r < 0) {
            return r;
        }
        q = (r as _);
        s = end(nodes, s);
    }
    let re: i64 = (q as _);
    return re;
}

pub fn stmt(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, s: usize, n: usize, lp: usize) -> i64 {
    let k: u8 = kind(nodes, s);
    let mut q: usize = at;
    if (k == K_STMT_LOCAL) {
        if ((s + 1) >= end(nodes, s)) {
            return fail(out, nodes, meta, text, s, "local with no value", lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
        }
        if ident_is(nodes, text, (s + 1), b"undefined") {
            return fail(out, nodes, meta, text, s, "local left undefined", lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
        }
        let t: i64 = sym_type(nodes, text, meta, ptext, item, sym_of(SYM_LOCAL, s), 0);
        if (t == TS_COMPTIME) {
            let rc: i64 = (q as _);
            return rc;
        }
        if !(ts_scalar(t)) {
            return fail(out, nodes, meta, text, s, "local that is no integer or bool", lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
        }
        if bad_name(text, lo(nodes, s, F_NAME), hi(nodes, s, F_NAME)) {
            return fail(out, nodes, meta, text, s, "name TypeScript reserves or the prelude uses", lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
        }
        q = put_ind(out, q, n);
        if is_mut(meta, s) {
            q = put_text(out, q, "let ");
        } else {
            q = put_text(out, q, "const ");
        }
        q = put_bytes(out, q, text, lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
        q = put_text(out, q, ": ");
        q = put_text(out, q, ts_annot(t));
        q = put_text(out, q, " = ");
        let r1: i64 = ex(out, q, nodes, text, meta, ptext, item, (s + 1), t);
        if (r1 < 0) {
            return r1;
        }
        q = (r1 as _);
        q = put_text(out, q, ";\n");
        let rl: i64 = (q as _);
        return rl;
    }
    if (k == K_STMT_ASSIGN) {
        return assign(out, q, nodes, text, meta, ptext, item, s, n);
    }
    if (k == K_STMT_IF) {
        return stmt_if(out, q, nodes, text, meta, ptext, item, s, n, lp);
    }
    if (k == K_STMT_WHILE) {
        return stmt_while(out, q, nodes, text, meta, ptext, item, s, n);
    }
    if (k == K_EXPR_RETURN) {
        if (kind(nodes, item) != K_FN_DECL) {
            return fail(out, nodes, meta, text, s, "return in a test", 0, 0);
        }
        if ((s + 1) >= end(nodes, s)) {
            return fail(out, nodes, meta, text, s, "return with no value from a fn", 0, 0);
        }
        q = put_ind(out, q, n);
        q = put_text(out, q, "return ");
        let r2: i64 = ex(out, q, nodes, text, meta, ptext, item, (s + 1), fn_type(nodes, text, item));
        if (r2 < 0) {
            return r2;
        }
        q = (r2 as _);
        q = put_text(out, q, ";\n");
        let rr: i64 = (q as _);
        return rr;
    }
    if ((k == K_STMT_BREAK) || (k == K_STMT_CONTINUE)) {
        if (lp == 0) {
            return fail(out, nodes, meta, text, s, kind_label(k), 0, 0);
        }
        q = put_ind(out, q, n);
        if (k == K_STMT_BREAK) {
            q = put_text(out, q, "break;\n");
        } else {
            q = put_text(out, q, "continue;\n");
        }
        let rb: i64 = (q as _);
        return rb;
    }
    if (k == K_STMT_EXPR) {
        if (((s + 1) < end(nodes, s)) && (kind(nodes, (s + 1)) == K_EXPR_CALL)) {
            return call_stmt(out, q, nodes, text, meta, ptext, item, (s + 1), n);
        }
        return fail(out, nodes, meta, text, s, "expression statement", 0, 0);
    }
    return fail(out, nodes, meta, text, s, kind_label(k), lo(nodes, s, F_NAME), hi(nodes, s, F_NAME));
}

pub fn assign(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, s: usize, n: usize) -> i64 {
    if (children(nodes, s) != 2) {
        return fail(out, nodes, meta, text, s, "assignment", 0, 0);
    }
    let t: usize = (s + 1);
    let e: usize = end(nodes, t);
    let mut q: usize = at;
    if ident_is(nodes, text, t, b"_") {
        let et: i64 = ty_of(nodes, text, meta, ptext, item, e, 0);
        if (et == TS_COMPTIME) {
            let rd: i64 = (q as _);
            return rd;
        }
        q = put_ind(out, q, n);
        q = put_text(out, q, "void (");
        let r0: i64 = ex(out, q, nodes, text, meta, ptext, item, e, et);
        if (r0 < 0) {
            return r0;
        }
        q = (r0 as _);
        q = put_text(out, q, ");\n");
        let rv: i64 = (q as _);
        return rv;
    }
    if (kind(nodes, t) != K_EXPR_IDENTIFIER) {
        return fail(out, nodes, meta, text, s, "assignment to", lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    }
    let sy: i64 = resolve(nodes, text, meta, ptext, item, t, lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    if (sy == NO_SYM) {
        return fail(out, nodes, meta, text, s, "assignment that declares a name", lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    }
    if ((sym_tag(sy) != SYM_LOCAL) || !(is_mut(meta, sym_at(sy)))) {
        return fail(out, nodes, meta, text, s, "assignment to a name that is no var local", lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    }
    let tt: i64 = sym_type(nodes, text, meta, ptext, item, sy, 0);
    if !(ts_scalar(tt)) {
        return fail(out, nodes, meta, text, s, "assignment to a name that is no integer or bool", lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    }
    q = put_ind(out, q, n);
    q = put_bytes(out, q, text, lo(nodes, t, F_NAME), hi(nodes, t, F_NAME));
    q = put_text(out, q, " = ");
    let oa: usize = lo(nodes, s, F_OP);
    let ob: usize = hi(nodes, s, F_OP);
    if ((ob > oa) && !(field_eq(nodes, text, s, F_OP, "="))) {
        let oc: u8 = op_class(&text[(oa) as usize..((ob - 1)) as usize]);
        if ((oc != OP_ARITH) && (oc != OP_SHIFT)) {
            return fail(out, nodes, meta, text, s, "compound assignment", oa, ob);
        }
        let r1: i64 = ex_op(out, q, nodes, text, meta, ptext, item, t, e, oa, (ob - 1), tt);
        if (r1 < 0) {
            return r1;
        }
        q = (r1 as _);
    } else {
        let r2: i64 = ex(out, q, nodes, text, meta, ptext, item, e, tt);
        if (r2 < 0) {
            return r2;
        }
        q = (r2 as _);
    }
    q = put_text(out, q, ";\n");
    let ra: i64 = (q as _);
    return ra;
}

pub fn stmt_if(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, s: usize, n: usize, lp: usize) -> i64 {
    let c0: usize = (s + 1);
    let th: usize = end(nodes, c0);
    if ((th >= end(nodes, s)) || (kind(nodes, th) != K_MODULE)) {
        return fail(out, nodes, meta, text, s, "if", 0, 0);
    }
    if (ty_of(nodes, text, meta, ptext, item, c0, 0) != TS_BOOL) {
        return ex(out, at, nodes, text, meta, ptext, item, c0, TS_BOOL);
    }
    let mut q: usize = put_ind(out, at, n);
    q = put_text(out, q, "if (");
    let r1: i64 = ex(out, q, nodes, text, meta, ptext, item, c0, TS_BOOL);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, ") {\n");
    let r2: i64 = stmts(out, q, nodes, text, meta, ptext, item, th, (th + 1), (n + 2), lp);
    if (r2 < 0) {
        return r2;
    }
    q = (r2 as _);
    q = put_ind(out, q, n);
    q = put_text(out, q, "}");
    let el: usize = end(nodes, th);
    if (el < end(nodes, s)) {
        q = put_text(out, q, " else {\n");
        let r3: i64 = stmts(out, q, nodes, text, meta, ptext, item, el, (el + 1), (n + 2), lp);
        if (r3 < 0) {
            return r3;
        }
        q = (r3 as _);
        q = put_ind(out, q, n);
        q = put_text(out, q, "}");
    }
    q = put_text(out, q, "\n");
    let ri: i64 = (q as _);
    return ri;
}

pub fn stmt_while(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, w: usize, n: usize) -> i64 {
    let body: i64 = loop_block(nodes, text, w, "body");
    if (body == NO_NODE) {
        return fail(out, nodes, meta, text, w, "while with no body", 0, 0);
    }
    let bi: usize = (body as _);
    let ce: i64 = loop_block(nodes, text, w, "continue_expr");
    if ((ce != NO_NODE) && own_continue(nodes, (bi + 1), end(nodes, bi))) {
        return fail(out, nodes, meta, text, w, "continue in a while with a continue expression", 0, 0);
    }
    let cnd: usize = (w + 1);
    if (ty_of(nodes, text, meta, ptext, item, cnd, 0) != TS_BOOL) {
        return ex(out, at, nodes, text, meta, ptext, item, cnd, TS_BOOL);
    }
    let mut q: usize = put_ind(out, at, n);
    q = put_text(out, q, "while (");
    let r1: i64 = ex(out, q, nodes, text, meta, ptext, item, cnd, TS_BOOL);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, ") {\n");
    let r2: i64 = stmts(out, q, nodes, text, meta, ptext, item, bi, (bi + 1), (n + 2), w);
    if (r2 < 0) {
        return r2;
    }
    q = (r2 as _);
    if (ce != NO_NODE) {
        let cei: usize = (ce as _);
        let r3: i64 = stmts(out, q, nodes, text, meta, ptext, item, cei, (cei + 1), (n + 2), w);
        if (r3 < 0) {
            return r3;
        }
        q = (r3 as _);
    }
    q = put_ind(out, q, n);
    q = put_text(out, q, "}\n");
    let rw: i64 = (q as _);
    return rw;
}

pub fn call_stmt(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, i: usize, n: usize) -> i64 {
    let mut q: usize = at;
    if (!(field_eq(nodes, text, i, F_NAME, "assert")) && !(field_eq(nodes, text, i, F_NAME, "assert_eq"))) {
        return fail(out, nodes, meta, text, i, "call statement", lo(nodes, i, F_NAME), hi(nodes, i, F_NAME));
    }
    let eq: bool = field_eq(nodes, text, i, F_NAME, "assert_eq");
    if ((eq && (children(nodes, i) != 2)) || (!(eq) && (children(nodes, i) != 1))) {
        return fail(out, nodes, meta, text, i, "assert with a message", 0, 0);
    }
    let a: usize = (i + 1);
    let mut pt: i64 = TS_BOOL;
    if eq {
        let at1: i64 = ty_of(nodes, text, meta, ptext, item, a, 0);
        let at2: i64 = ty_of(nodes, text, meta, ptext, item, end(nodes, a), 0);
        if (at1 == TS_BAD) {
            return ex(out, q, nodes, text, meta, ptext, item, a, TS_BAD);
        }
        if (at2 == TS_BAD) {
            return ex(out, q, nodes, text, meta, ptext, item, end(nodes, a), TS_BAD);
        }
        pt = ts_peer(at1, at2);
        if !(ts_scalar(pt)) {
            return fail(out, nodes, meta, text, i, "assert_eq of values whose types do not meet", 0, 0);
        }
    }
    let mut folds: bool = fold_ok(nodes, text, meta, ptext, item, a, 0);
    if eq {
        folds = (folds && fold_ok(nodes, text, meta, ptext, item, end(nodes, a), 0));
    }
    q = put_ind(out, q, n);
    if folds {
        q = put_text(out, q, "t27_check(");
    } else {
        q = put_text(out, q, "t27_assert(");
    }
    if eq {
        q = put_text(out, q, "(");
    }
    let r1: i64 = ex(out, q, nodes, text, meta, ptext, item, a, pt);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    if eq {
        q = put_text(out, q, " === ");
        let r2: i64 = ex(out, q, nodes, text, meta, ptext, item, end(nodes, a), pt);
        if (r2 < 0) {
            return r2;
        }
        q = (r2 as _);
        q = put_text(out, q, ")");
    }
    q = put_text(out, q, ", '");
    q = put_bytes(out, q, text, lo(nodes, item, F_NAME), hi(nodes, item, F_NAME));
    q = put_text(out, q, "', ");
    q = put_dec(out, q, (line_near(nodes, meta, i) as u64));
    q = put_text(out, q, ");\n");
    let ra: i64 = (q as _);
    return ra;
}

pub fn const_text(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], d: usize) -> i64 {
    let na: usize = lo(nodes, d, F_NAME);
    let nb: usize = hi(nodes, d, F_NAME);
    if is_mut(meta, d) {
        return fail(out, nodes, meta, text, d, "module-level var", na, nb);
    }
    if ((hi(nodes, d, F_TYPE) > lo(nodes, d, F_TYPE)) && !(ts_scalar(ts_type(text, lo(nodes, d, F_TYPE), hi(nodes, d, F_TYPE))))) {
        return fail(out, nodes, meta, text, d, "const that is no integer or bool", na, nb);
    }
    if ((d + 1) >= end(nodes, d)) {
        return fail(out, nodes, meta, text, d, "const with no value", na, nb);
    }
    if ident_is(nodes, text, (d + 1), b"undefined") {
        return fail(out, nodes, meta, text, d, "const left undefined", na, nb);
    }
    if bad_name(text, na, nb) {
        return fail(out, nodes, meta, text, d, "name TypeScript reserves or the prelude uses", na, nb);
    }
    let mut t: i64 = sym_type(nodes, text, meta, ptext, 0, sym_of(SYM_TOP, d), 0);
    if (t == TS_COMPTIME) {
        if !(fold_ok(nodes, text, meta, ptext, 0, (d + 1), 0)) {
            return fail(out, nodes, meta, text, d, "untyped const that does not fold", na, nb);
        }
        t = (TS_SIGNED + TS_MAX_WIDTH);
        if !(ts_fits(fold_val(nodes, text, meta, ptext, 0, (d + 1), 0), t)) {
            t = TS_MAX_WIDTH;
        }
    }
    if !(ts_scalar(t)) {
        return fail(out, nodes, meta, text, d, "const that is no integer or bool", na, nb);
    }
    let mut q: usize = at;
    if is_pub(meta, d) {
        q = put_text(out, q, "export ");
    }
    q = put_text(out, q, "const ");
    q = put_bytes(out, q, text, na, nb);
    q = put_text(out, q, ": ");
    q = put_text(out, q, ts_annot(t));
    q = put_text(out, q, " = ");
    let r1: i64 = ex(out, q, nodes, text, meta, ptext, 0, (d + 1), t);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, ";\n");
    let rc: i64 = (q as _);
    return rc;
}

pub fn fn_text(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], f: usize) -> i64 {
    let na: usize = lo(nodes, f, F_NAME);
    let nb: usize = hi(nodes, f, F_NAME);
    if is_extern(nodes, f) {
        return fail(out, nodes, meta, text, f, "extern fn", na, nb);
    }
    let rt: i64 = fn_type(nodes, text, f);
    if (rt == TS_VOID) {
        return fail(out, nodes, meta, text, f, "fn with no result", na, nb);
    }
    if !(ts_scalar(rt)) {
        return fail(out, nodes, meta, text, f, "fn whose result is no integer or bool", na, nb);
    }
    if bad_name(text, na, nb) {
        return fail(out, nodes, meta, text, f, "name TypeScript reserves or the prelude uses", na, nb);
    }
    let mut q: usize = put_text(out, at, "\n");
    if is_pub(meta, f) {
        q = put_text(out, q, "export ");
    }
    q = put_text(out, q, "function ");
    q = put_bytes(out, q, text, na, nb);
    q = put_text(out, q, "(");
    let np: usize = param_count(ptext, params_lo(meta, f), params_hi(meta, f));
    let mut kx: usize = 0;
    while (kx < np) {
        let pa: usize = param_name_lo(meta, ptext, f, kx);
        let pb: usize = param_name_hi(meta, ptext, f, kx);
        if bad_name(ptext, pa, pb) {
            return fail(out, nodes, meta, text, f, "parameter whose name TypeScript reserves or the prelude uses, of fn", na, nb);
        }
        let pt: i64 = param_type(meta, ptext, f, kx);
        if !(ts_scalar(pt)) {
            return fail(out, nodes, meta, text, f, "parameter that is no integer or bool, of fn", na, nb);
        }
        if (kx > 0) {
            q = put_text(out, q, ", ");
        }
        q = put_bytes(out, q, ptext, pa, pb);
        q = put_text(out, q, ": ");
        q = put_text(out, q, ts_annot(pt));
        kx = (kx + 1);
    }
    q = put_text(out, q, "): ");
    q = put_text(out, q, ts_annot(rt));
    q = put_text(out, q, " {\n");
    let r1: i64 = stmts(out, q, nodes, text, meta, ptext, f, f, (f + 1), 2, 0);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, "}\n");
    let rf: i64 = (q as _);
    return rf;
}

pub fn check_text(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], c: usize, prefix: &'static str) -> i64 {
    let na: usize = lo(nodes, c, F_NAME);
    let nb: usize = hi(nodes, c, F_NAME);
    if !(is_ident(text, na, nb)) {
        return fail(out, nodes, meta, text, c, "test whose name is no identifier", na, nb);
    }
    let mut q: usize = put_text(out, at, "\nexport function ");
    q = put_text(out, q, prefix);
    q = put_bytes(out, q, text, na, nb);
    q = put_text(out, q, "(): number {\n  t27_n = 0;\n");
    let r1: i64 = stmts(out, q, nodes, text, meta, ptext, c, c, (c + 1), 2, 0);
    if (r1 < 0) {
        return r1;
    }
    q = (r1 as _);
    q = put_text(out, q, "  return t27_n;\n}\n");
    let rt: i64 = (q as _);
    return rt;
}

pub fn items(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8]) -> i64 {
    let mut q: usize = at;
    let mut c: usize = 1;
    while (c < end(nodes, 0)) {
        let k: u8 = kind(nodes, c);
        let mut r: i64 = 0;
        if (k == K_CONST_DECL) {
            r = const_text(out, q, nodes, text, meta, ptext, c);
        } else {
            if (k == K_FN_DECL) {
                r = fn_text(out, q, nodes, text, meta, ptext, c);
            } else {
                if (k == K_TEST_BLOCK) {
                    r = check_text(out, q, nodes, text, meta, ptext, c, "t27_test_");
                } else {
                    if (k == K_INVARIANT_BLOCK) {
                        r = check_text(out, q, nodes, text, meta, ptext, c, "t27_invariant_");
                    } else {
                        return fail(out, nodes, meta, text, c, kind_label(k), lo(nodes, c, F_NAME), hi(nodes, c, F_NAME));
                    }
                }
            }
        }
        if (r < 0) {
            return r;
        }
        q = (r as _);
        c = end(nodes, c);
    }
    let ri: i64 = (q as _);
    return ri;
}

pub fn table(out: &mut [u8], at: usize, nodes: &[u8], text: &[u8], kw: u8, name: &'static str, prefix: &'static str) -> usize {
    let mut q: usize = put_text(out, at, "\nexport const ");
    q = put_text(out, q, name);
    q = put_text(out, q, ": t27_case[] = [\n");
    let mut c: usize = 1;
    while (c < end(nodes, 0)) {
        if (kind(nodes, c) == kw) {
            q = put_text(out, q, "  ['");
            q = put_bytes(out, q, text, lo(nodes, c, F_NAME), hi(nodes, c, F_NAME));
            q = put_text(out, q, "', ");
            q = put_text(out, q, prefix);
            q = put_bytes(out, q, text, lo(nodes, c, F_NAME), hi(nodes, c, F_NAME));
            q = put_text(out, q, "],\n");
        }
        c = end(nodes, c);
    }
    return put_text(out, q, "];\n");
}

pub fn emit(nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], work: impl AsRef<[u8]>, out: &mut [u8]) -> i64 {
    let work: &[u8] = work.as_ref();
    if ((count(nodes) == 0) || (kind(nodes, 0) != K_MODULE)) {
        return fail_front(out, "file with no module node");
    }
    let mut q: usize = put_text(out, 0, "// Generated by t27b ts from module ");
    q = put_bytes(out, q, text, lo(nodes, 0, F_NAME), hi(nodes, 0, F_NAME));
    q = put_text(out, q, " -- DO NOT EDIT; the decisions are specs/tri/t27b/ts_plan.t27\n");
    q = put_text(out, q, "// phi^2 + 1/phi^2 = 3 | TRINITY\n\n");
    let mut j: usize = 0;
    while (j < TS_PRELUDE_LINES) {
        q = put_text(out, q, TS_PRELUDE[(j) as usize]);
        q = put_text(out, q, "\n");
        j = (j + 1);
    }
    let r1: i64 = items(out, q, nodes, text, meta, ptext);
    if (r1 < 0) {
        let ml: usize = ((0 - r1) as _);
        return to_front(out, ml);
    }
    q = (r1 as _);
    q = table(out, q, nodes, text, K_TEST_BLOCK, "t27_tests", "t27_test_");
    q = table(out, q, nodes, text, K_INVARIANT_BLOCK, "t27_invariants", "t27_invariant_");
    j = 0;
    while (j < TS_CODA_LINES) {
        q = put_text(out, q, TS_CODA[(j) as usize]);
        q = put_text(out, q, "\n");
        j = (j + 1);
    }
    if ((q + MSG_ROOM) > out.len()) {
        return fail_front(out, "output larger than the buffer");
    }
    let rq: i64 = (q as _);
    return rq;
}

pub fn ttree(nb: &mut [u8], mb: &mut [u8], ca: usize, cb: usize) -> () {
    tnode(nb, 0, K_MODULE, 13, 0, 1);
    tnode(nb, 1, K_FN_DECL, 6, 1, 2);
    vset(nb, 1, F_RET, 3, 5);
    tnode(nb, 2, K_EXPR_RETURN, 6, 0, 0);
    tnode(nb, 3, K_EXPR_BINARY, 6, 0, 0);
    vset(nb, 3, F_OP, 5, 6);
    tnode(nb, 4, K_EXPR_IDENTIFIER, 5, 2, 3);
    tnode(nb, 5, K_EXPR_LITERAL, 6, 0, 0);
    vset(nb, 5, F_VALUE, 6, 7);
    tnode(nb, 6, K_TEST_BLOCK, 13, 8, 9);
    tnode(nb, 7, K_STMT_EXPR, 13, 0, 0);
    tnode(nb, 8, K_EXPR_CALL, 13, 9, 15);
    tnode(nb, 9, K_EXPR_BINARY, 13, 0, 0);
    vset(nb, 9, F_OP, 15, 17);
    tnode(nb, 10, K_EXPR_CALL, 12, ca, cb);
    tnode(nb, 11, K_EXPR_LITERAL, 12, 0, 0);
    vset(nb, 11, F_VALUE, 6, 7);
    tnode(nb, 12, K_EXPR_LITERAL, 13, 0, 0);
    vset(nb, 12, F_VALUE, 7, 8);
    let mut i: usize = 0;
    while (i < 13) {
        tmeta(mb, i, 0, 0);
        i = (i + 1);
    }
    tmeta(mb, 1, FLAG_PUB, 1);
    vput32(mb, ((1 * META) + 12), 5);
    tmeta(mb, 6, 0, 2);
    tmeta(mb, 8, 0, 3);
}

pub const B_DOT: u8 = 46;

pub const FIELDS: usize = 8;

pub const F_KIND: usize = 5;

pub const F_NAME: usize = 0;

pub const F_OP: usize = 6;

pub const F_RET: usize = 7;

pub const F_TYPE: usize = 2;

pub const F_VALUE: usize = 1;

pub const K_CONST_DECL: u8 = 2;

pub const K_EXPR_BINARY: u8 = 16;

pub const K_EXPR_CALL: u8 = 13;

pub const K_EXPR_CAST: u8 = 24;

pub const K_EXPR_IDENTIFIER: u8 = 11;

pub const K_EXPR_IF: u8 = 20;

pub const K_EXPR_LITERAL: u8 = 10;

pub const K_EXPR_RETURN: u8 = 18;

pub const K_EXPR_UNARY: u8 = 17;

pub const K_FN_DECL: u8 = 6;

pub const K_INVARIANT_BLOCK: u8 = 7;

pub const K_MODULE: u8 = 0;

pub const K_STMT_ASSIGN: u8 = 27;

pub const K_STMT_BREAK: u8 = 32;

pub const K_STMT_CONTINUE: u8 = 33;

pub const K_STMT_EXPR: u8 = 34;

pub const K_STMT_FOR: u8 = 30;

pub const K_STMT_FOR_RANGE: u8 = 31;

pub const K_STMT_IF: u8 = 28;

pub const K_STMT_LOCAL: u8 = 26;

pub const K_STMT_WHILE: u8 = 29;

pub const K_STRUCT_DECL: u8 = 5;

pub const K_TEST_BLOCK: u8 = 8;

pub const NO_NODE: i64 = -1;

pub const REC: usize = 72;

pub fn children(nodes: &[u8], i: usize) -> usize {
    let mut n: usize = 0;
    let mut c: usize = (i + 1);
    while (c < end(nodes, i)) {
        n = (n + 1);
        c = end(nodes, c);
    }
    return n;
}

pub fn count(nodes: &[u8]) -> usize {
    return (nodes.len() / REC);
}

pub fn end(nodes: &[u8], i: usize) -> usize {
    return u32_at(nodes, ((i * REC) + 4));
}

pub fn field_eq(nodes: &[u8], text: &[u8], i: usize, f: usize, w: &'static str) -> bool {
    return same(&text[(lo(nodes, i, f)) as usize..(hi(nodes, i, f)) as usize], w);
}

pub fn field_is(nodes: &[u8], text: &[u8], i: usize, f: usize, w: &[u8]) -> bool {
    let a: usize = lo(nodes, i, f);
    let b: usize = hi(nodes, i, f);
    return (((b - a) == w.len()) && has_at(text, a, b, w));
}

pub fn has_at(s: &[u8], lo: usize, hi: usize, w: &[u8]) -> bool {
    if ((hi - lo) < w.len()) {
        return false;
    }
    let mut k: usize = 0;
    while (k < w.len()) {
        if (s[((lo + k)) as usize] != w[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn hi(nodes: &[u8], i: usize, f: usize) -> usize {
    return u32_at(nodes, (((i * REC) + 12) + (f * 8)));
}

pub fn ident_is(nodes: &[u8], text: &[u8], i: usize, name: &[u8]) -> bool {
    return ((kind(nodes, i) == K_EXPR_IDENTIFIER) && field_is(nodes, text, i, F_NAME, name));
}

pub fn kind(nodes: &[u8], i: usize) -> u8 {
    return nodes[((i * REC)) as usize];
}

pub fn lo(nodes: &[u8], i: usize, f: usize) -> usize {
    return u32_at(nodes, (((i * REC) + 8) + (f * 8)));
}

pub fn names(nodes: &[u8], text: &[u8], i: usize, name: &[u8]) -> bool {
    let a: usize = lo(nodes, i, F_NAME);
    let b: usize = hi(nodes, i, F_NAME);
    if !(has_at(text, a, b, name)) {
        return false;
    }
    return (((b - a) == name.len()) || (text[((a + name.len())) as usize] == B_DOT));
}

pub fn node(nodes: &mut [u8], i: usize, k: u8, e: usize, a: usize, b: usize) -> () {
    nodes[((i * REC)) as usize] = k;
    put32(nodes, ((i * REC) + 4), e);
    let mut f: usize = 0;
    while (f < FIELDS) {
        put32(nodes, (((i * REC) + 8) + (f * 8)), a);
        put32(nodes, (((i * REC) + 12) + (f * 8)), a);
        f = (f + 1);
    }
    put32(nodes, ((i * REC) + 12), b);
}

pub fn put32(nodes: &mut [u8], at: usize, v: usize) -> () {
    nodes[(at) as usize] = ((v % 256) as _);
    nodes[((at + 1)) as usize] = (((v / 256) % 256) as _);
    nodes[((at + 2)) as usize] = (((v / 65536) % 256) as _);
    nodes[((at + 3)) as usize] = ((v / 16777216) as _);
}

pub fn u32_at(nodes: &[u8], at: usize) -> usize {
    let b0: usize = (nodes[(at) as usize] as usize);
    let b1: usize = (nodes[((at + 1)) as usize] as usize);
    let b2: usize = (nodes[((at + 2)) as usize] as usize);
    let b3: usize = (nodes[((at + 3)) as usize] as usize);
    return (((b0 + (b1 * 256)) + (b2 * 65536)) + (b3 * 16777216));
}

pub const MSG_ROOM: usize = 400;

pub const NAME_CAP: usize = 120;

pub const NO_SYM: i64 = -1;

pub const SYM_FN: i64 = 4;

pub const SYM_LOCAL: i64 = 1;

pub const SYM_PARAM: i64 = 2;

pub const SYM_TOP: i64 = 3;

pub const SYM_UNIT: i64 = 1099511627776;

pub fn child_holding(nodes: &[u8], c: usize, d: usize) -> usize {
    let mut x: usize = (c + 1);
    while (x < end(nodes, c)) {
        if (d < end(nodes, x)) {
            return x;
        }
        x = end(nodes, x);
    }
    return c;
}

pub fn dec_len(v: u64) -> usize {
    let mut n: usize = 1;
    let mut x: u64 = v;
    while (x >= 10) {
        x = (x / 10);
        n = (n + 1);
    }
    return n;
}

pub fn holds(out: &[u8], n: usize, w: &'static str) -> bool {
    let mut i: usize = 0;
    while ((i + w.len()) <= n) {
        let mut k: usize = 0;
        while ((k < w.len()) && (out[((i + k)) as usize] == w.as_bytes()[(k) as usize])) {
            k = (k + 1);
        }
        if (k == w.len()) {
            return true;
        }
        i = (i + 1);
    }
    return false;
}

pub fn in_scope(nodes: &[u8], item: usize, d: usize, u: usize) -> bool {
    if ((d >= u) || (u < end(nodes, d))) {
        return false;
    }
    let pb: usize = parent_of(nodes, item, d);
    return (u < end(nodes, pb));
}

pub fn line_near(nodes: &[u8], meta: &[u8], i: usize) -> usize {
    let mut j: usize = i;
    while (j < end(nodes, i)) {
        if (line_of(meta, j) != 0) {
            return line_of(meta, j);
        }
        j = (j + 1);
    }
    let mut k: usize = i;
    while (k > 0) {
        k = (k - 1);
        if (line_of(meta, k) != 0) {
            return line_of(meta, k);
        }
    }
    return 0;
}

pub fn param_index(text: &[u8], meta: &[u8], ptext: &[u8], item: usize, a: usize, b: usize) -> i64 {
    let pa: usize = params_lo(meta, item);
    let pb: usize = params_hi(meta, item);
    let mut k: usize = 0;
    let mut s: usize = pa;
    while (s < pb) {
        let e: usize = line_stop(ptext, s, pb);
        let c: usize = colon_at(ptext, s, e);
        if (((c - s) == (b - a)) && has_at(ptext, s, c, &text[(a) as usize..(b) as usize])) {
            let ki: i64 = (k as _);
            return ki;
        }
        k = (k + 1);
        s = (e + 1);
    }
    return -(1);
}

pub fn param_name_hi(meta: &[u8], ptext: &[u8], item: usize, k: usize) -> usize {
    let s: usize = param_name_lo(meta, ptext, item, k);
    return colon_at(ptext, s, line_stop(ptext, s, params_hi(meta, item)));
}

pub fn param_name_lo(meta: &[u8], ptext: &[u8], item: usize, k: usize) -> usize {
    return param_at(ptext, params_lo(meta, item), params_hi(meta, item), k);
}

pub fn parent_of(nodes: &[u8], root: usize, d: usize) -> usize {
    let mut cur: usize = root;
    while true {
        let nx: usize = child_holding(nodes, cur, d);
        if ((nx == d) || (nx == cur)) {
            return cur;
        }
        cur = nx;
    }
    return cur;
}

pub fn put_bytes(out: &mut [u8], at: usize, s: &[u8], a: usize, b: usize) -> usize {
    let mut k: usize = a;
    let mut q: usize = at;
    while (k < b) {
        out[(q) as usize] = s[(k) as usize];
        q = (q + 1);
        k = (k + 1);
    }
    return q;
}

pub fn put_dec(out: &mut [u8], at: usize, v: u64) -> usize {
    let n: usize = dec_len(v);
    let mut x: u64 = v;
    let mut k: usize = n;
    while (k > 0) {
        let db: u8 = (((x % 10) + 48) as _);
        out[(((at + k) - 1)) as usize] = db;
        x = (x / 10);
        k = (k - 1);
    }
    return (at + n);
}

pub fn put_ind(out: &mut [u8], at: usize, n: usize) -> usize {
    let mut k: usize = 0;
    while (k < n) {
        out[((at + k)) as usize] = 32;
        k = (k + 1);
    }
    return (at + n);
}

pub fn resolve(nodes: &[u8], text: &[u8], meta: &[u8], ptext: &[u8], item: usize, u: usize, a: usize, b: usize) -> i64 {
    if (item > 0) {
        let mut j: usize = u;
        while (j > (item + 1)) {
            j = (j - 1);
            if ((kind(nodes, j) == K_STMT_LOCAL) && field_is(nodes, text, j, F_NAME, &text[(a) as usize..(b) as usize])) {
                if in_scope(nodes, item, j, u) {
                    let ji: i64 = (j as _);
                    return ((SYM_LOCAL * SYM_UNIT) + ji);
                }
            }
        }
        if (kind(nodes, item) == K_FN_DECL) {
            let pk: i64 = param_index(text, meta, ptext, item, a, b);
            if (pk >= 0) {
                return ((SYM_PARAM * SYM_UNIT) + pk);
            }
        }
    }
    let d: i64 = find_decl(nodes, text, a, b);
    if (d != NO_NODE) {
        return ((SYM_TOP * SYM_UNIT) + d);
    }
    let f: i64 = find_fn(nodes, text, a, b);
    if (f != NO_NODE) {
        return ((SYM_FN * SYM_UNIT) + f);
    }
    return NO_SYM;
}

pub fn sym_at(s: i64) -> usize {
    let r: i64 = (s % SYM_UNIT);
    let ru: usize = (r as _);
    return ru;
}

pub fn sym_of(tag: i64, at: usize) -> i64 {
    let ai: i64 = (at as _);
    return ((tag * SYM_UNIT) + ai);
}

pub fn tmeta(m: &mut [u8], i: usize, flags: usize, line: usize) -> () {
    vput32(m, (i * META), flags);
    vput32(m, ((i * META) + 4), line);
    vput32(m, ((i * META) + 8), 0);
    vput32(m, ((i * META) + 12), 0);
}

pub fn tnode(buf: &mut [u8], i: usize, k: u8, e: usize, a: usize, b: usize) -> () {
    buf[((i * REC)) as usize] = k;
    vput32(buf, ((i * REC) + 4), e);
    let mut f: usize = 0;
    while (f < FIELDS) {
        vput32(buf, (((i * REC) + 8) + (f * 8)), 0);
        vput32(buf, (((i * REC) + 12) + (f * 8)), 0);
        f = (f + 1);
    }
    vput32(buf, ((i * REC) + 8), a);
    vput32(buf, ((i * REC) + 12), b);
}

pub fn to_front(out: &mut [u8], n: usize) -> i64 {
    let base: usize = (out.len() - MSG_ROOM);
    let mut k: usize = 0;
    while (k < n) {
        out[(k) as usize] = out[((base + k)) as usize];
        k = (k + 1);
    }
    let ni: i64 = (n as _);
    return (0 - ni);
}

pub fn put_text(out: &mut [u8], at: usize, w: &'static str) -> usize {
    let mut k: usize = 0;
    while (k < w.len()) {
        out[((at + k)) as usize] = w.as_bytes()[(k) as usize];
        k = (k + 1);
    }
    return (at + w.len());
}

