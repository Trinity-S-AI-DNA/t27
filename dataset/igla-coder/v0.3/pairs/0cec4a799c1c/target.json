pub fn ts_abs(v: i64) -> i64 {
    if (v < 0) {
        return (0 - v);
    }
    return v;
}

pub fn ts_annot(t: i64) -> &'static str {
    if (t == TS_BOOL) {
        return "boolean";
    }
    return "number";
}

pub fn ts_arith(s: &[u8]) -> u8 {
    if ((same(s, "+") || same(s, "-")) || same(s, "*")) {
        return AR_CHECKED;
    }
    if ((same(s, "+%") || same(s, "-%")) || same(s, "*%")) {
        return AR_WRAPS;
    }
    if (same(s, "/") || same(s, "%")) {
        return AR_DIVIDES;
    }
    if op_bitwise(s) {
        return AR_BITS;
    }
    if (same(s, "<<") || same(s, ">>")) {
        return AR_SHIFTS;
    }
    return AR_BAD;
}

pub fn ts_arith_op(s: &[u8]) -> &'static str {
    if (same(s, "+") || same(s, "+%")) {
        return "+";
    }
    if (same(s, "-") || same(s, "-%")) {
        return "-";
    }
    if same(s, "*") {
        return "*";
    }
    if same(s, "*%") {
        return "Math.imul";
    }
    if same(s, "/") {
        return "t27_div";
    }
    if same(s, "%") {
        return "t27_rem";
    }
    if same(s, "&") {
        return "&";
    }
    if same(s, "|") {
        return "|";
    }
    if same(s, "^") {
        return "^";
    }
    if same(s, "<<") {
        return "t27_shl";
    }
    if same(s, ">>") {
        return "t27_shr";
    }
    return "?";
}

pub fn ts_cmp(s: &[u8]) -> &'static str {
    if same(s, "==") {
        return "===";
    }
    if same(s, "!=") {
        return "!==";
    }
    if same(s, "<") {
        return "<";
    }
    if same(s, "<=") {
        return "<=";
    }
    if same(s, ">") {
        return ">";
    }
    if same(s, ">=") {
        return ">=";
    }
    if (same(s, "and") || same(s, "&&")) {
        return "&&";
    }
    if (same(s, "or") || same(s, "||")) {
        return "||";
    }
    return "?";
}

pub fn ts_coerces(own: i64, want: i64) -> bool {
    if (own == want) {
        return ts_scalar(own);
    }
    if (!(ts_int(own)) || !(ts_int(want))) {
        return false;
    }
    return ((ts_min(want) <= ts_min(own)) && (ts_max(own) <= ts_max(want)));
}

pub fn ts_fits(v: i64, t: i64) -> bool {
    if !(ts_scalar(t)) {
        return false;
    }
    return ((v >= ts_min(t)) && (v <= ts_max(t)));
}

pub fn ts_fold_ok(s: &[u8], a: i64, b: i64) -> bool {
    if (!(ts_in_fold(a)) || !(ts_in_fold(b))) {
        return false;
    }
    if (((same(s, "+") || same(s, "+%")) || same(s, "-")) || same(s, "-%")) {
        return ts_in_fold(ts_fold_val(s, a, b));
    }
    if (same(s, "*") || same(s, "*%")) {
        if ((a == 0) || (b == 0)) {
            return true;
        }
        let mq: i64 = (TS_FOLD_MAX / ts_abs(b));
        return (ts_abs(a) <= mq);
    }
    if (same(s, "/") || same(s, "%")) {
        return ((a >= 0) && (b > 0));
    }
    if same(s, "<<") {
        if (((a < 0) || (b < 0)) || (b >= 53)) {
            return false;
        }
        let sq: i64 = (TS_FOLD_MAX / ts_pow2(b));
        return (a <= sq);
    }
    if same(s, ">>") {
        return ((a >= 0) && (b >= 0));
    }
    if op_bitwise(s) {
        return ((a >= 0) && (b >= 0));
    }
    if ((op_class(s) == OP_CMP) || (op_class(s) == OP_LOGIC)) {
        return true;
    }
    return false;
}

pub fn ts_fold_val(s: &[u8], a: i64, b: i64) -> i64 {
    if (same(s, "+") || same(s, "+%")) {
        return (a + b);
    }
    if (same(s, "-") || same(s, "-%")) {
        return (a - b);
    }
    if (same(s, "*") || same(s, "*%")) {
        return (a * b);
    }
    if same(s, "/") {
        let dq: i64 = (a / b);
        return dq;
    }
    if same(s, "%") {
        let dr: i64 = (a % b);
        return dr;
    }
    if same(s, "<<") {
        return (a * ts_pow2(b));
    }
    if same(s, ">>") {
        if (b >= 53) {
            return 0;
        }
        let ds: i64 = (a / ts_pow2(b));
        return ds;
    }
    if same(s, "&") {
        return (a & b);
    }
    if same(s, "|") {
        return (a | b);
    }
    if same(s, "^") {
        return (a ^ b);
    }
    let mut t: bool = false;
    if same(s, "==") {
        t = (a == b);
    }
    if same(s, "!=") {
        t = (a != b);
    }
    if same(s, "<") {
        t = (a < b);
    }
    if same(s, "<=") {
        t = (a <= b);
    }
    if same(s, ">") {
        t = (a > b);
    }
    if same(s, ">=") {
        t = (a >= b);
    }
    if (same(s, "and") || same(s, "&&")) {
        t = ((a == 1) && (b == 1));
    }
    if (same(s, "or") || same(s, "||")) {
        t = ((a == 1) || (b == 1));
    }
    if t {
        return 1;
    }
    return 0;
}

pub fn ts_in_fold(v: i64) -> bool {
    return ((v >= (0 - TS_FOLD_MAX)) && (v <= TS_FOLD_MAX));
}

pub fn ts_int(t: i64) -> bool {
    return (ts_unsigned(t) || ts_signed(t));
}

pub fn ts_max(t: i64) -> i64 {
    if ts_signed(t) {
        return (ts_pow2((ts_width(t) - 1)) - 1);
    }
    if (ts_unsigned(t) || (t == TS_BOOL)) {
        return (ts_pow2(ts_width(t)) - 1);
    }
    return 0;
}

pub fn ts_min(t: i64) -> i64 {
    if ts_signed(t) {
        return (0 - ts_pow2((ts_width(t) - 1)));
    }
    return 0;
}

pub fn ts_peer(a: i64, b: i64) -> i64 {
    if (a == TS_COMPTIME) {
        if ((b == TS_COMPTIME) || ts_scalar(b)) {
            return b;
        }
        return TS_BAD;
    }
    if (b == TS_COMPTIME) {
        if ts_scalar(a) {
            return a;
        }
        return TS_BAD;
    }
    if ((a == TS_BOOL) && (b == TS_BOOL)) {
        return TS_BOOL;
    }
    if ts_coerces(a, b) {
        return b;
    }
    if ts_coerces(b, a) {
        return a;
    }
    return TS_BAD;
}

pub fn ts_pow2(w: i64) -> i64 {
    let mut m: i64 = 1;
    let mut j: i64 = 0;
    while ((j < w) && (j < 62)) {
        m = (m * 2);
        j = (j + 1);
    }
    return m;
}

pub fn ts_reserved(s: &[u8]) -> bool {
    if ((s.len() >= 4) && same(&s[(0) as usize..(4) as usize], "t27_")) {
        return true;
    }
    let mut j: usize = 0;
    while (j < 59) {
        if same(s, TS_KEYWORDS[(j) as usize]) {
            return true;
        }
        j = (j + 1);
    }
    return false;
}

pub fn ts_scalar(t: i64) -> bool {
    return (ts_int(t) || (t == TS_BOOL));
}

pub fn ts_signed(t: i64) -> bool {
    return ((t > TS_SIGNED) && (t <= (TS_SIGNED + TS_MAX_WIDTH)));
}

pub fn ts_type(s: &[u8], a: usize, b: usize) -> i64 {
    let p: usize = trim_lo(s, a, b);
    let q: usize = trim_hi(s, p, b);
    if ((q == p) || same(&s[(p) as usize..(q) as usize], "void")) {
        return TS_VOID;
    }
    if same(&s[(p) as usize..(q) as usize], "bool") {
        return TS_BOOL;
    }
    if same(&s[(p) as usize..(q) as usize], "comptime_int") {
        return TS_COMPTIME;
    }
    if ((((s[(p) as usize] != 117) && (s[(p) as usize] != 105)) || ((q - p) < 2)) || ((q - p) > 3)) {
        return TS_BAD;
    }
    let p1: usize = (p + 1);
    let mut w: i64 = 0;
    let mut j: usize = p1;
    while (j < q) {
        if !(digit(s[(j) as usize])) {
            return TS_BAD;
        }
        let dv: i64 = ((s[(j) as usize] - 48) as _);
        w = ((w * 10) + dv);
        j = (j + 1);
    }
    if (((s[(p1) as usize] == 48) || (w < 1)) || (w > TS_MAX_WIDTH)) {
        return TS_BAD;
    }
    if (s[(p) as usize] == 105) {
        return (TS_SIGNED + w);
    }
    return w;
}

pub fn ts_unsigned(t: i64) -> bool {
    return ((t >= 1) && (t <= TS_MAX_WIDTH));
}

pub fn ts_width(t: i64) -> i64 {
    if ts_unsigned(t) {
        return t;
    }
    if ts_signed(t) {
        return (t - TS_SIGNED);
    }
    if (t == TS_BOOL) {
        return 1;
    }
    return 0;
}

pub const B_CR: u8 = 13;

pub const B_LT: u8 = 60;

pub const B_SPACE: u8 = 32;

pub const B_TAB: u8 = 9;

pub const B_UNDERSCORE: u8 = 95;

pub const MAPPED_NAMES: [&'static str; 8] = ["str", "string", "float", "double", "int", "uint", "GF16", "gf16"];

pub const ZIG_NAMES: [&'static str; 21] = ["bool", "void", "type", "anyerror", "anyframe", "anyopaque", "noreturn", "usize", "isize", "comptime_int", "comptime_float", "c_char", "c_short", "c_ushort", "c_int", "c_uint", "c_long", "c_ulong", "c_longlong", "c_ulonglong", "c_longdouble"];

pub fn alpha(c: u8) -> bool {
    return (((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)));
}

pub fn digit(c: u8) -> bool {
    return ((c >= 48) && (c <= 57));
}

pub fn ident(s: &[u8]) -> bool {
    if (s.len() == 0) {
        return false;
    }
    if (!(alpha(s[0])) && (s[0] != B_UNDERSCORE)) {
        return false;
    }
    let mut i: usize = 1;
    while (i < s.len()) {
        if !(word(s[(i) as usize])) {
            return false;
        }
        i = (i + 1);
    }
    return true;
}

pub fn same(s: &[u8], w: &'static str) -> bool {
    if (s.len() != w.len()) {
        return false;
    }
    let mut k: usize = 0;
    while (k < w.len()) {
        if (s[(k) as usize] != w.as_bytes()[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn trim_hi(s: &[u8], lo: usize, hi: usize) -> usize {
    let mut j: usize = hi;
    while (j > lo) {
        let n: usize = ws_before(s, lo, j);
        if (n == 0) {
            return j;
        }
        j = (j - n);
    }
    return j;
}

pub fn trim_lo(s: &[u8], lo: usize, hi: usize) -> usize {
    let mut i: usize = lo;
    while (i < hi) {
        let n: usize = ws_at(s, i, hi);
        if (n == 0) {
            return i;
        }
        i = (i + n);
    }
    return i;
}

pub fn undeclared(base: &[u8], declared: bool) -> bool {
    let mut i: usize = 0;
    while (i < base.len()) {
        if (base[(i) as usize] == B_LT) {
            return true;
        }
        i = (i + 1);
    }
    if (declared || !(ident(base))) {
        return false;
    }
    let mut k: usize = 0;
    while (k < 8) {
        if same(base, MAPPED_NAMES[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return !(zig_type_name(base));
}

pub fn word(c: u8) -> bool {
    return ((alpha(c) || digit(c)) || (c == B_UNDERSCORE));
}

pub fn ws_at(s: &[u8], i: usize, hi: usize) -> usize {
    let c: u8 = s[(i) as usize];
    if (((c >= B_TAB) && (c <= B_CR)) || (c == B_SPACE)) {
        return 1;
    }
    if (c == 194) {
        if (((i + 1) < hi) && ((s[((i + 1)) as usize] == 133) || (s[((i + 1)) as usize] == 160))) {
            return 2;
        }
        return 0;
    }
    if ((i + 2) >= hi) {
        return 0;
    }
    let b1: u8 = s[((i + 1)) as usize];
    let b2: u8 = s[((i + 2)) as usize];
    if (((c == 225) && (b1 == 154)) && (b2 == 128)) {
        return 3;
    }
    if (((c == 226) && (b1 == 128)) && (((((b2 >= 128) && (b2 <= 138)) || (b2 == 168)) || (b2 == 169)) || (b2 == 175))) {
        return 3;
    }
    if (((c == 226) && (b1 == 129)) && (b2 == 159)) {
        return 3;
    }
    if (((c == 227) && (b1 == 128)) && (b2 == 128)) {
        return 3;
    }
    return 0;
}

pub fn ws_before(s: &[u8], lo: usize, end: usize) -> usize {
    let c: u8 = s[((end - 1)) as usize];
    if (((c >= B_TAB) && (c <= B_CR)) || (c == B_SPACE)) {
        return 1;
    }
    if (((end - lo) >= 2) && (ws_at(s, (end - 2), end) == 2)) {
        return 2;
    }
    if (((end - lo) >= 3) && (ws_at(s, (end - 3), end) == 3)) {
        return 3;
    }
    return 0;
}

pub fn zig_type_name(s: &[u8]) -> bool {
    let mut k: usize = 0;
    while (k < 21) {
        if same(s, ZIG_NAMES[(k) as usize]) {
            return true;
        }
        k = (k + 1);
    }
    if (s.len() < 2) {
        return false;
    }
    if (((s[0] != 117) && (s[0] != 105)) && (s[0] != 102)) {
        return false;
    }
    let mut i: usize = 1;
    while (i < s.len()) {
        if !(digit(s[(i) as usize])) {
            return false;
        }
        i = (i + 1);
    }
    return true;
}

pub const B_COLON_V: u8 = 58;

pub const B_NL: u8 = 10;

pub const FLAG_MUT: usize = 1;

pub const FLAG_PUB: usize = 2;

pub const KIND_NAMES: [&'static str; 35] = ["Module", "UseDecl", "ConstDecl", "EnumDecl", "EnumVariant", "StructDecl", "FnDecl", "InvariantBlock", "TestBlock", "BenchBlock", "ExprLiteral", "ExprIdentifier", "ExprEnumValue", "ExprCall", "ExprFieldAccess", "ExprSwitch", "ExprBinary", "ExprUnary", "ExprReturn", "ExprIndex", "ExprIf", "ExprStructLit", "ExprArrayLiteral", "ExprTuple", "ExprCast", "ExprRange", "StmtLocal", "StmtAssign", "StmtIf", "StmtWhile", "StmtFor", "StmtForRange", "StmtBreak", "StmtContinue", "StmtExpr"];

pub const META: usize = 16;

pub const OP_ARITH: u8 = 1;

pub const OP_BAD: u8 = 0;

pub const OP_CMP: u8 = 3;

pub const OP_LOGIC: u8 = 4;

pub const OP_SHIFT: u8 = 2;

pub const U64_MAX: u64 = 18446744073709551615;

pub fn colon_at(ptext: &[u8], s: usize, e: usize) -> usize {
    let mut j: usize = s;
    while ((j < e) && (ptext[(j) as usize] != B_COLON_V)) {
        j = (j + 1);
    }
    return j;
}

pub fn digit_of(c: u8) -> u64 {
    if ((c >= 48) && (c <= 57)) {
        return ((c - 48) as u64);
    }
    if ((c >= 97) && (c <= 102)) {
        return ((c - 87) as u64);
    }
    if ((c >= 65) && (c <= 70)) {
        return ((c - 55) as u64);
    }
    return 99;
}

pub fn find_decl(nodes: &[u8], text: &[u8], a: usize, b: usize) -> i64 {
    let mut c: usize = 1;
    while (c < end(nodes, 0)) {
        let k: u8 = kind(nodes, c);
        if (((k == K_CONST_DECL) || (k == K_STRUCT_DECL)) && field_is(nodes, text, c, F_NAME, &text[(a) as usize..(b) as usize])) {
            let ci: i64 = (c as _);
            return ci;
        }
        c = end(nodes, c);
    }
    return NO_NODE;
}

pub fn find_fn(nodes: &[u8], text: &[u8], a: usize, b: usize) -> i64 {
    let mut c: usize = 1;
    while (c < end(nodes, 0)) {
        if ((kind(nodes, c) == K_FN_DECL) && field_is(nodes, text, c, F_NAME, &text[(a) as usize..(b) as usize])) {
            let ci: i64 = (c as _);
            return ci;
        }
        c = end(nodes, c);
    }
    return NO_NODE;
}

pub fn is_extern(nodes: &[u8], i: usize) -> bool {
    return ((kind(nodes, i) == K_FN_DECL) && (end(nodes, i) == (i + 1)));
}

pub fn is_mut(meta: &[u8], i: usize) -> bool {
    return ((meta_word(meta, i, 0) & FLAG_MUT) == FLAG_MUT);
}

pub fn is_pub(meta: &[u8], i: usize) -> bool {
    return ((meta_word(meta, i, 0) & FLAG_PUB) == FLAG_PUB);
}

pub fn kind_label(k: u8) -> &'static str {
    let ki: usize = (k as usize);
    if (ki < 35) {
        return KIND_NAMES[(ki) as usize];
    }
    return "node";
}

pub fn line_of(meta: &[u8], i: usize) -> usize {
    return meta_word(meta, i, 1);
}

pub fn line_stop(ptext: &[u8], s: usize, b: usize) -> usize {
    let mut j: usize = s;
    while ((j < b) && (ptext[(j) as usize] != B_NL)) {
        j = (j + 1);
    }
    return j;
}

pub fn lit_ok(s: &[u8], a: usize, b: usize) -> bool {
    return (lit_scan(s, a, b, true) == 1);
}

pub fn lit_radix(s: &[u8], a: usize, b: usize) -> u64 {
    if (((b - a) < 3) || (s[(a) as usize] != 48)) {
        return 10;
    }
    let c1: u8 = s[((a + 1)) as usize];
    if ((c1 == 120) || (c1 == 88)) {
        return 16;
    }
    if (c1 == 111) {
        return 8;
    }
    if (c1 == 98) {
        return 2;
    }
    return 10;
}

pub fn lit_scan(s: &[u8], a: usize, b: usize, check: bool) -> u64 {
    if (b <= a) {
        return 0;
    }
    let base: u64 = lit_radix(s, a, b);
    let mut j: usize = a;
    if (base != 10) {
        j = (a + 2);
    }
    let mut v: u64 = 0;
    let mut digits: usize = 0;
    while (j < b) {
        let c: u8 = s[(j) as usize];
        if (c != 95) {
            let d: u64 = digit_of(c);
            if (d >= base) {
                return 0;
            }
            if (v > ((U64_MAX - d) / base)) {
                return 0;
            }
            v = ((v * base) + d);
            digits = (digits + 1);
        }
        j = (j + 1);
    }
    if (digits == 0) {
        return 0;
    }
    if check {
        return 1;
    }
    return v;
}

pub fn lit_val(s: &[u8], a: usize, b: usize) -> u64 {
    return lit_scan(s, a, b, false);
}

pub fn loop_block(nodes: &[u8], text: &[u8], w: usize, name: &'static str) -> i64 {
    let mut c: usize = (w + 1);
    while (c < end(nodes, w)) {
        if ((kind(nodes, c) == K_MODULE) && field_eq(nodes, text, c, F_NAME, name)) {
            let ci: i64 = (c as _);
            return ci;
        }
        c = end(nodes, c);
    }
    return NO_NODE;
}

pub fn meta_word(meta: &[u8], i: usize, w: usize) -> usize {
    return u32_at(meta, ((i * META) + (w * 4)));
}

pub fn op_bitwise(s: &[u8]) -> bool {
    return ((same(s, "&") || same(s, "|")) || same(s, "^"));
}

pub fn op_class(s: &[u8]) -> u8 {
    if ((((same(s, "+") || same(s, "-")) || same(s, "*")) || same(s, "/")) || same(s, "%")) {
        return OP_ARITH;
    }
    if ((same(s, "+%") || same(s, "-%")) || same(s, "*%")) {
        return OP_ARITH;
    }
    if ((same(s, "&") || same(s, "|")) || same(s, "^")) {
        return OP_ARITH;
    }
    if (same(s, "<<") || same(s, ">>")) {
        return OP_SHIFT;
    }
    if (((((same(s, "==") || same(s, "!=")) || same(s, "<")) || same(s, "<=")) || same(s, ">")) || same(s, ">=")) {
        return OP_CMP;
    }
    if (((same(s, "and") || same(s, "or")) || same(s, "&&")) || same(s, "||")) {
        return OP_LOGIC;
    }
    return OP_BAD;
}

pub fn own_continue(nodes: &[u8], a: usize, b: usize) -> bool {
    let mut j: usize = a;
    while (j < b) {
        let k: u8 = kind(nodes, j);
        if (((k == K_STMT_WHILE) || (k == K_STMT_FOR)) || (k == K_STMT_FOR_RANGE)) {
            j = end(nodes, j);
        } else {
            if (k == K_STMT_CONTINUE) {
                return true;
            }
            j = (j + 1);
        }
    }
    return false;
}

pub fn param_at(ptext: &[u8], a: usize, b: usize, k: usize) -> usize {
    let mut seen: usize = 0;
    let mut j: usize = a;
    while ((j < b) && (seen < k)) {
        if (ptext[(j) as usize] == B_NL) {
            seen = (seen + 1);
        }
        j = (j + 1);
    }
    return j;
}

pub fn param_count(ptext: &[u8], a: usize, b: usize) -> usize {
    let mut n: usize = 0;
    let mut j: usize = a;
    while (j < b) {
        if (ptext[(j) as usize] == B_NL) {
            n = (n + 1);
        }
        j = (j + 1);
    }
    return n;
}

pub fn params_hi(meta: &[u8], i: usize) -> usize {
    return meta_word(meta, i, 3);
}

pub fn params_lo(meta: &[u8], i: usize) -> usize {
    return meta_word(meta, i, 2);
}

pub fn vput32(buf: &mut [u8], at: usize, v: usize) -> () {
    buf[(at) as usize] = ((v % 256) as _);
    buf[((at + 1)) as usize] = (((v / 256) % 256) as _);
    buf[((at + 2)) as usize] = (((v / 65536) % 256) as _);
    buf[((at + 3)) as usize] = ((v / 16777216) as _);
}

pub fn vset(buf: &mut [u8], i: usize, f: usize, a: usize, b: usize) -> () {
    vput32(buf, (((i * REC) + 8) + (f * 8)), a);
    vput32(buf, (((i * REC) + 12) + (f * 8)), b);
}

