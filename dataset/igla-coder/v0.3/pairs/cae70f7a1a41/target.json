pub fn why(a: u8) -> &'static str {
    if (a == A_START) {
        return "wanted, and the ledger has no row for the lane: start it";
    }
    if (a == A_RECHECK) {
        return "the ledger row has said running for the stale limit or longer: look at the lane, then update its row";
    }
    if (a == A_UPDATE_BRANCH) {
        return "the pull request conflicts with its base or is behind it: merge the base into the branch, history is not rewritten";
    }
    if (a == A_FIX) {
        return "a check of the pull request failed: read the failure and fix it on its branch";
    }
    if (a == A_FIND_PR) {
        return "a subagent reported done and no pull request or merge names its branch: look for the branch on the remote, open its pull request or run the lane again";
    }
    if (a == A_DELETE_DUPLICATE) {
        return "an earlier cron has the same prompt: delete this one";
    }
    if (a == A_CHASE) {
        return "the request is past due and was never chased: chase it once and mark it chased";
    }
    if (a == A_TAKE_DEFAULT) {
        return "the request is past due and was chased: take the default and write it in the ledger";
    }
    if (a == A_BAD) {
        return "the record cannot be read: an unread fact is reported, never skipped";
    }
    if (a == A_NOOP) {
        return "nothing changed since the last tick: the same state and the same plan were handed out";
    }
    return "nothing to do";
}

