pub fn key_value(text: &'static str, at: usize, end: usize, ind: usize, key: &'static str) -> usize {
    let v: usize = (((at + ind) + key.len()) + 4);
    if (v > end) {
        return (end + 1);
    }
    let mut k: usize = 0;
    while (k < ind) {
        if (text.as_bytes()[((at + k)) as usize] != 32) {
            return (end + 1);
        }
        k = (k + 1);
    }
    if (text.as_bytes()[((at + ind)) as usize] != 34) {
        return (end + 1);
    }
    if (span_is(text, ((at + ind) + 1), (((at + ind) + 1) + key.len()), key) == false) {
        return (end + 1);
    }
    if (((text.as_bytes()[((v - 3)) as usize] != 34) || (text.as_bytes()[((v - 2)) as usize] != 58)) || (text.as_bytes()[((v - 1)) as usize] != 32)) {
        return (end + 1);
    }
    return v;
}

pub fn line_end(text: &'static str, at: usize) -> usize {
    let mut k: usize = at;
    while ((k < text.len()) && (text.as_bytes()[(k) as usize] != 10)) {
        k = (k + 1);
    }
    return k;
}

pub fn span_is(text: &'static str, from: usize, to: usize, lit: &'static str) -> bool {
    if ((to < from) || ((to - from) != lit.len())) {
        return false;
    }
    let mut k: usize = 0;
    while (k < lit.len()) {
        if (text.as_bytes()[((from + k)) as usize] != lit.as_bytes()[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn value_from(text: &'static str, v: usize) -> usize {
    if (v >= text.len()) {
        return text.len();
    }
    if (text.as_bytes()[(v) as usize] == 34) {
        return (v + 1);
    }
    return v;
}

pub fn value_to(text: &'static str, v: usize) -> usize {
    if (v >= text.len()) {
        return text.len();
    }
    let mut e: usize = line_end(text, v);
    if ((e > v) && (text.as_bytes()[((e - 1)) as usize] == 44)) {
        e = (e - 1);
    }
    if (((text.as_bytes()[(v) as usize] == 34) && (e > (v + 1))) && (text.as_bytes()[((e - 1)) as usize] == 34)) {
        e = (e - 1);
    }
    if (e < value_from(text, v)) {
        return value_from(text, v);
    }
    return e;
}

pub const AGE_UNKNOWN: u64 = 4294967295;

pub const CI_GREEN: u8 = 0;

pub const CI_PENDING: u8 = 1;

pub const CI_RED: u8 = 2;

pub const STALE_MINUTES: u64 = 45;

pub const UNKNOWN: &'static str = "?";

pub fn age_known(age: u64) -> bool {
    return (age != AGE_UNKNOWN);
}

pub fn age_minutes(now: u64, then: u64) -> u64 {
    if ((then == 0) || (then > now)) {
        return AGE_UNKNOWN;
    }
    return ((now - then) / 60);
}

pub fn branch_from(w: &'static str, at: usize) -> usize {
    let stop: usize = record_end(w, at);
    let mut k: usize = at;
    while (k < stop) {
        if starts(w, k, "branch refs/heads/") {
            return (k + 18);
        }
        k = (line_end(w, k) + 1);
    }
    return w.len();
}

pub fn branch_to(w: &'static str, at: usize) -> usize {
    let b: usize = branch_from(w, at);
    if (b >= w.len()) {
        return w.len();
    }
    return line_end(w, b);
}

pub fn ci(text: &'static str, o: usize, e: usize) -> u8 {
    let mut pending: bool = false;
    let mut at: usize = o;
    while ((at < e) && (at < text.len())) {
        let end: usize = line_end(text, at);
        let c: usize = key_value(text, at, end, 8, "conclusion");
        let s: usize = key_value(text, at, end, 8, "state");
        let st: usize = key_value(text, at, end, 8, "status");
        if ((c <= end) && failed_word(text, value_from(text, c), value_to(text, c))) {
            return CI_RED;
        }
        if (s <= end) {
            if failed_word(text, value_from(text, s), value_to(text, s)) {
                return CI_RED;
            }
            if (span_is(text, value_from(text, s), value_to(text, s), "PENDING") || span_is(text, value_from(text, s), value_to(text, s), "EXPECTED")) {
                pending = true;
            }
        }
        if ((st <= end) && (span_is(text, value_from(text, st), value_to(text, st), "COMPLETED") == false)) {
            pending = true;
        }
        at = (end + 1);
    }
    if pending {
        return CI_PENDING;
    }
    return CI_GREEN;
}

pub fn days_from_civil(y: u64, m: u64, d: u64) -> u64 {
    let mut yy: u64 = y;
    if (m <= 2) {
        yy = (yy - 1);
    }
    let era: u64 = (yy / 400);
    let yoe: u64 = (yy - (era * 400));
    let mut mp: u64 = (m + 9);
    if (m > 2) {
        mp = (m - 3);
    }
    let doy: u64 = (((((153 * mp) + 2) / 5) + d) - 1);
    let doe: u64 = ((((yoe * 365) + (yoe / 4)) - (yoe / 100)) + doy);
    return (((era * 146097) + doe) - 719468);
}

pub fn digits(text: &'static str, from: usize, to: usize) -> u64 {
    if ((to <= from) || ((to - from) > 18)) {
        return 0;
    }
    let mut n: u64 = 0;
    let mut i: usize = from;
    while (i < to) {
        if ((text.as_bytes()[(i) as usize] < 48) || (text.as_bytes()[(i) as usize] > 57)) {
            return 0;
        }
        n = ((n * 10) + ((text.as_bytes()[(i) as usize] as u64) - 48));
        i = (i + 1);
    }
    return n;
}

pub fn failed_word(text: &'static str, from: usize, to: usize) -> bool {
    return ((((((span_is(text, from, to, "FAILURE") || span_is(text, from, to, "ERROR")) || span_is(text, from, to, "TIMED_OUT")) || span_is(text, from, to, "CANCELLED")) || span_is(text, from, to, "ACTION_REQUIRED")) || span_is(text, from, to, "STARTUP_FAILURE")) || span_is(text, from, to, "STALE"));
}

pub fn iso_seconds(text: &'static str, from: usize, to: usize) -> u64 {
    if ((((((((to - from) != 20) || (text.as_bytes()[((from + 4)) as usize] != 45)) || (text.as_bytes()[((from + 7)) as usize] != 45)) || (text.as_bytes()[((from + 10)) as usize] != 84)) || (text.as_bytes()[((from + 13)) as usize] != 58)) || (text.as_bytes()[((from + 16)) as usize] != 58)) || (text.as_bytes()[((from + 19)) as usize] != 90)) {
        return 0;
    }
    let y: u64 = digits(text, from, (from + 4));
    let mo: u64 = digits(text, (from + 5), (from + 7));
    let d: u64 = digits(text, (from + 8), (from + 10));
    if (((((y < 1970) || (mo < 1)) || (mo > 12)) || (d < 1)) || (d > 31)) {
        return 0;
    }
    return ((((days_from_civil(y, mo, d) * 86400) + (digits(text, (from + 11), (from + 13)) * 3600)) + (digits(text, (from + 14), (from + 16)) * 60)) + digits(text, (from + 17), (from + 19)));
}

pub fn later(a: u64, b: u64) -> u64 {
    if (a > b) {
        return a;
    }
    return b;
}

pub fn merged(m: &'static str, w: &'static str, at: usize) -> bool {
    let b: usize = branch_from(w, at);
    let be: usize = branch_to(w, at);
    if (b >= w.len()) {
        return false;
    }
    let mut k: usize = 0;
    while ((((k + 15) + (be - b)) + 1) <= m.len()) {
        if (span_is(m, k, (k + 15), "\"headRefName\":\"") && (m.as_bytes()[(((k + 15) + (be - b))) as usize] == 34)) {
            let mut same: bool = true;
            let mut i: usize = 0;
            while (i < (be - b)) {
                if (m.as_bytes()[(((k + 15) + i)) as usize] != w.as_bytes()[((b + i)) as usize]) {
                    same = false;
                }
                i = (i + 1);
            }
            if same {
                return true;
            }
        }
        k = (k + 1);
    }
    return false;
}

pub fn record_end(w: &'static str, at: usize) -> usize {
    let mut k: usize = at;
    while (k < w.len()) {
        let end: usize = line_end(w, k);
        if (end == k) {
            return k;
        }
        k = (end + 1);
    }
    return w.len();
}

pub fn starts(w: &'static str, at: usize, lit: &'static str) -> bool {
    if ((at + lit.len()) > w.len()) {
        return false;
    }
    return span_is(w, at, (at + lit.len()), lit);
}

