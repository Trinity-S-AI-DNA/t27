#[derive(Debug, Clone, Copy)]
#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
pub struct SHA512 {
    pub state: [u64; 8],
    pub buffer: [u8; 128],
    pub count: u64,
}

pub fn big_sigma0(x: u64) -> u64 {
    return ((rotr(x, 28) ^ rotr(x, 34)) ^ rotr(x, 39));
}

pub fn big_sigma1(x: u64) -> u64 {
    return ((rotr(x, 14) ^ rotr(x, 18)) ^ rotr(x, 41));
}

pub fn ch(x: u64, y: u64, z: u64) -> u64 {
    return ((x & y) ^ ((x ^ ALL) & z));
}

pub fn compress(sha: &mut SHA512) -> () {
    let mut w: [u64; 80] = [0; 80];
    let mut t: usize = 0;
    while (t < 16) {
        let mut word: u64 = 0;
        let mut b: usize = 0;
        while (b < 8) {
            word = ((word << 8) | (sha.buffer[(((t * 8) + b)) as usize] as u64));
            b = (b + 1);
        }
        w[(t) as usize] = word;
        t = (t + 1);
    }
    while (t < 80) {
        w[(t) as usize] = (((small_sigma1(w[((t - 2)) as usize])).wrapping_add(w[((t - 7)) as usize])).wrapping_add(small_sigma0(w[((t - 15)) as usize]))).wrapping_add(w[((t - 16)) as usize]);
        t = (t + 1);
    }
    let mut v: [u64; 8] = [0; 8];
    let mut k: usize = 0;
    while (k < 8) {
        v[(k) as usize] = sha.state[(k) as usize];
        k = (k + 1);
    }
    t = 0;
    while (t < 80) {
        let t1 = ((((v[7]).wrapping_add(big_sigma1(v[4]))).wrapping_add(ch(v[4], v[5], v[6]))).wrapping_add(K[(t) as usize])).wrapping_add(w[(t) as usize]);
        let t2 = (big_sigma0(v[0])).wrapping_add(maj(v[0], v[1], v[2]));
        v[7] = v[6];
        v[6] = v[5];
        v[5] = v[4];
        v[4] = (v[3]).wrapping_add(t1);
        v[3] = v[2];
        v[2] = v[1];
        v[1] = v[0];
        v[0] = (t1).wrapping_add(t2);
        t = (t + 1);
    }
    k = 0;
    while (k < 8) {
        sha.state[(k) as usize] = (sha.state[(k) as usize]).wrapping_add(v[(k) as usize]);
