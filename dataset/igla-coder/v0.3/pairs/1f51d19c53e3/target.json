    let mut p: usize = at;
    while (p < to) {
        if (((p > 0) && ((t.as_bytes()[((p - 1)) as usize] == 10) || (((p >= 2) && (t.as_bytes()[((p - 2)) as usize] == 92)) && (t.as_bytes()[((p - 1)) as usize] == 110)))) && trailer_at(t, p, to)) {
            return p;
        }
        p = (p + 1);
    }
    return to;
}

pub fn co_end(t: &'static str, p: usize, to: usize) -> usize {
    let mut q: usize = p;
    while (q < to) {
        if ((t.as_bytes()[(q) as usize] == 10) || (t.as_bytes()[(q) as usize] == 13)) {
            return q;
        }
        if (((t.as_bytes()[(q) as usize] == 92) && ((q + 1) < to)) && ((t.as_bytes()[((q + 1)) as usize] == 110) || (t.as_bytes()[((q + 1)) as usize] == 114))) {
            return q;
        }
        q = (q + 1);
    }
    return to;
}

pub fn co_mail_from(t: &'static str, p: usize, q: usize) -> usize {
    let mut k: usize = p;
    while ((k < q) && (t.as_bytes()[(k) as usize] != 60)) {
        k = (k + 1);
    }
    if (k >= q) {
        return q;
    }
    return (k + 1);
}

pub fn co_mail_to(t: &'static str, p: usize, q: usize) -> usize {
    let mut k: usize = co_mail_from(t, p, q);
    while ((k < q) && (t.as_bytes()[(k) as usize] != 62)) {
        k = (k + 1);
    }
    if (k >= q) {
        return q;
    }
    return k;
}

pub fn noreply_id(t: &'static str, f: usize, e: usize) -> u64 {
    if ((e < ((f + NOREPLY_DOMAIN.len()) + 3)) || (span_is(t, (e - NOREPLY_DOMAIN.len()), e, NOREPLY_DOMAIN) == false)) {
        return NO_AUTHOR;
    }
    let mut k: usize = f;
    while ((k < e) && (t.as_bytes()[(k) as usize] != 43)) {
        k = (k + 1);
    }
    let n: u64 = dec(t, f, k);
    if ((k >= e) || (account_known(n) == false)) {
        return NO_AUTHOR;
    }
    return n;
}

pub fn co_lookup(t: &'static str, p: usize, q: usize) -> bool {
    let f: usize = co_mail_from(t, p, q);
    let e: usize = co_mail_to(t, p, q);
    return (((trailer_agent(t, p, q) == false) && (e > f)) && (noreply_id(t, f, e) == NO_AUTHOR));
}

pub fn co_agent(t: &'static str, p: usize, q: usize, a: &'static str) -> bool {
    return (trailer_agent(t, p, q) || account_agent(gh_author(a)));
}

pub fn co_author(t: &'static str, p: usize, q: usize, a: &'static str) -> u64 {
    if co_agent(t, p, q, a) {
        return POOL_ID;
    }
    let f: usize = co_mail_from(t, p, q);
    let e: usize = co_mail_to(t, p, q);
    let n: u64 = noreply_id(t, f, e);
    if (n != NO_AUTHOR) {
        return n;
    }
    let g: u64 = gh_author(a);
    if (g != NO_AUTHOR) {
        return g;
    }
    return email_account(identity_table(), t, f, e);
}

pub fn co_flags(t: &'static str, p: usize, q: usize, a: &'static str, green: bool) -> u8 {
    let mut f: u8 = 0;
    if co_agent(t, p, q, a) {
        f = (f | F_AGENT);
    }
    if green {
        f = (f | F_SEAL_GREEN);
    }
    return f;
}

pub fn login_fallback(id: u64) -> &'static str {
    if (id == POOL_ID) {
        return POOL_LABEL;
    }
    let tab: IdentityTable = identity_table();
    let p: u32 = account_part(tab, id);
    if (p < ID_ROWS) {
        return tab.name[(p) as usize];
    }
    return UNCLAIMED_LABEL;
}

pub fn label_id(id: u64) -> u64 {
    if is_held(id) {
        return held_author(id);
    }
    return id;
}

pub fn table_slot(specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], author: u64, f: u8, l: u64, n: u64) -> u32 {
    let c: u64 = credited_to(author, f);
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if (specs[(i) as usize] == NO_SPEC) {
            if ((l > LINES_MAX) || (n > TESTS_MAX)) {
                return ATTR_ROWS;
            }
            return i;
        }
        if ((credited_to(authors[(i) as usize], flags[(i) as usize]) == c) && (attr_flag(flags[(i) as usize], F_SEAL_GREEN) == attr_flag(f, F_SEAL_GREEN))) {
            if (((lines[(i) as usize] + l) > LINES_MAX) || ((tests[(i) as usize] + n) > TESTS_MAX)) {
                return ATTR_ROWS;
            }
            return i;
        }
        i = (i + 1);
    }
    return ATTR_ROWS;
}

pub fn claim_add(acc: u64, usage: u64, weight: u64) -> u64 {
    return (acc + (royalty_usage(usage) * weight));
}

pub fn total_add(acc: u64, usage: u64) -> u64 {
    return (acc + (royalty_usage(usage) * BP_TOTAL));
}

pub fn mul_div_small(x: u64, y: u64, c: u64) -> u64 {
    let mut q: u64 = 0;
    let mut r: u64 = 0;
    let mut k: u32 = 64;
    while (k > 0) {
        k = (k - 1);
        q = (q * 2);
        r = (r * 2);
        if (r >= c) {
            r = (r - c);
            q = (q + 1);
        }
        if (((y >> (k as u64)) & 1) == 1) {
            r = (r + x);
            if (r >= c) {
                r = (r - c);
                q = (q + 1);
            }
        }
    }
    return q;
}

pub fn share_floor(pool: u64, claim: u64, total: u64) -> u64 {
    if (((total == 0) || (total > SPLIT_MAX)) || (claim > total)) {
        return 0;
    }
    let q: u64 = (pool / total);
    let r: u64 = (pool - (q * total));
    return ((q * claim) + mul_div_small(r, claim, total));
}

pub fn share_of(pool: u64, claim: u64, total: u64, id: u64) -> u64 {
    if (payable(id) == false) {
        return 0;
    }
    return share_floor(pool, claim, total);
}

pub fn held_of(pool: u64, claim: u64, total: u64, id: u64) -> u64 {
    if (is_held(id) == false) {
        return 0;
    }
    return share_floor(pool, claim, total);
}

pub fn pay_exit(commits: u64, counting: u64, unread: u64, full: u64, total: u64) -> u8 {
    if (((((commits == 0) || (counting == 0)) || (unread > 0)) || (full > 0)) || (total > SPLIT_MAX)) {
        return PAY_UNREAD;
    }
    return PAY_OK;
}

pub fn pay_why(x: u8) -> &'static str {
    if (x == PAY_OK) {
        return "exit 0: the epoch's AUTHOR_ROYALTY split; the inputs digest names the facts it ran on";
    }
    return "exit 2: no verdict -- the epoch has no commit or no counting receipt, a GitHub answer was not read, or a spec's table is full";
}

