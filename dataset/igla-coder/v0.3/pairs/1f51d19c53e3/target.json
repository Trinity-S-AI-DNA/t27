#[derive(Debug, Clone, Copy)]
#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
pub struct IdMessage {
    pub bytes: [u8; 512],
    pub used: usize,
}

#[derive(Debug, Clone, Copy)]
#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
pub struct IdentityTable {
    pub parts: u32,
    pub account: [u64; 16],
    pub role: [u8; 16],
    pub name: [&'static str; 16],
    pub bindings: u32,
    pub b_part: [u32; 16],
    pub b_kind: [u8; 16],
    pub b_value: [&'static str; 16],
    pub b_ev: [u8; 16],
    pub b_pr: [u64; 16],
    pub b_pr_author: [u64; 16],
    pub b_commit: [&'static str; 16],
    pub b_signer: [u32; 16],
    pub b_sig: [&'static str; 16],
}

pub const K_EMAIL: u8 = 1;

pub const K_SIGNING_KEY: u8 = 3;

pub const M_EXACT: u8 = 1;

pub const M_PREFIX: u8 = 2;

pub const M_SUFFIX: u8 = 3;

pub const ROLE_LAB: u8 = 3;

pub const SHA_HEX: usize = 40;

pub const SIGNING_KEY_HEX: usize = 64;

pub const SIG_HEX: usize = 128;

pub const SRC_ACCOUNT: u8 = 2;

pub fn account_agent(id: u64) -> bool {
    if (id_account_known(id) == false) {
        return false;
    }
    let mut k: u32 = 0;
    while (k < AGENT_ROWS) {
        if ((AGENT_SOURCE[(k) as usize] == SRC_ACCOUNT) && (AGENT_ACCOUNT[(k) as usize] == id)) {
            return true;
        }
        k = (k + 1);
    }
    return false;
}

pub fn account_part(tab: IdentityTable, id: u64) -> u32 {
    let mut p: u32 = 0;
    while ((p < tab.parts) && (p < ID_ROWS)) {
        if (((tab.account[(p) as usize] == id) && id_account_known(id)) && (tab.role[(p) as usize] != ROLE_LAB)) {
            return p;
        }
        p = (p + 1);
    }
    return ID_ROWS;
}

pub fn agent_name(r: &'static str, from: usize, to: usize) -> bool {
    let mut k: u32 = 0;
    while (k < AGENT_ROWS) {
        if agent_row_matches(r, from, to, k) {
            return true;
        }
        k = (k + 1);
    }
    return false;
}

pub fn agent_row_matches(r: &'static str, from: usize, to: usize, k: u32) -> bool {
    if (((k >= AGENT_ROWS) || (to < from)) || (to > r.len())) {
        return false;
    }
    let lit: &'static str = AGENT_NAME[(k) as usize];
    if ((lit.len() == 0) || ((to - from) < lit.len())) {
        return false;
    }
    if (AGENT_MATCH[(k) as usize] == M_EXACT) {
        return id_span_eq(r, from, to, lit);
    }
    if (AGENT_MATCH[(k) as usize] == M_PREFIX) {
        return id_span_eq(r, from, (from + lit.len()), lit);
    }
    if (AGENT_MATCH[(k) as usize] == M_SUFFIX) {
        return id_span_eq(r, (to - lit.len()), to, lit);
    }
    return false;
}

pub fn binding_account(tab: IdentityTable, i: u32) -> u64 {
    if ((i >= tab.bindings) || (i >= ID_ROWS)) {
        return ID_NO_ACCOUNT;
    }
    return part_account(tab, tab.b_part[(i) as usize]);
}

pub fn binding_message(tab: IdentityTable, i: u32) -> IdMessage {
    let mut m: IdMessage = IdMessage { bytes: [0; 512], used: 0 };
    if ((i >= tab.bindings) || (i >= ID_ROWS)) {
        return m;
    }
    m = idm_text(m, BINDING_HEAD, true);
    m = idm_text(m, "account ", false);
    m = idm_dec(m, binding_account(tab, i));
    m = idm_text(m, "kind ", false);
    m = idm_dec(m, (tab.b_kind[(i) as usize] as u64));
    m = idm_text(m, "value ", false);
    m = idm_text(m, tab.b_value[(i) as usize], true);
    return m;
}

pub fn binding_sig_ok(tab: IdentityTable, k: u32, j: u32) -> bool {
    let kv: &'static str = tab.b_value[(j) as usize];
    let sv: &'static str = tab.b_sig[(k) as usize];
    if (((signing_key_ok(kv) == false) || (sv.len() != SIG_HEX)) || (id_is_hex(sv, 0, SIG_HEX) == false)) {
        return false;
    }
    let m: IdMessage = binding_message(tab, k);
    return verify(id_hex32(kv, 0), &m.bytes[(0) as usize..(m.used) as usize], id_hex64(sv, 0));
}

pub fn binding_valid(tab: IdentityTable, i: u32) -> bool {
    let acct: u64 = binding_account(tab, i);
    if (id_account_known(acct) == false) {
        return false;
    }
    let mut k: u32 = i;
    let mut steps: u32 = 0;
    while (steps < ID_ROWS) {
        if (binding_account(tab, k) != acct) {
            return false;
        }
        if (tab.b_ev[(k) as usize] == EV_PR) {
            let c: &'static str = tab.b_commit[(k) as usize];
            return ((((tab.b_pr[(k) as usize] > 0) && (tab.b_pr_author[(k) as usize] == acct)) && (c.len() == SHA_HEX)) && id_is_hex(c, 0, SHA_HEX));
        }
        if (tab.b_ev[(k) as usize] != EV_SIGNED) {
            return false;
        }
        let j: u32 = tab.b_signer[(k) as usize];
        if (((j >= k) || (tab.b_kind[(j) as usize] != K_SIGNING_KEY)) || (binding_account(tab, j) != acct)) {
            return false;
        }
        if (binding_sig_ok(tab, k, j) == false) {
            return false;
        }
        k = j;
        steps = (steps + 1);
    }
    return false;
}

pub fn bound_account(tab: IdentityTable, kind: u8, t: &'static str, f: usize, e: usize) -> u64 {
    let mut found: u64 = ID_NO_ACCOUNT;
    let mut i: u32 = 0;
    while ((i < tab.bindings) && (i < ID_ROWS)) {
        if (tab.b_kind[(i) as usize] == kind) {
            let v: &'static str = tab.b_value[(i) as usize];
            let mut same: bool = id_same(t, f, e, v, 0, v.len());
            if (kind == K_EMAIL) {
                same = ((e >= f) && id_span_ieq(t, f, e, v));
            }
            if ((same && (v.len() > 0)) && binding_valid(tab, i)) {
                let a: u64 = binding_account(tab, i);
                if ((found != ID_NO_ACCOUNT) && (found != a)) {
                    return ID_NO_ACCOUNT;
                }
                found = a;
            }
        }
        i = (i + 1);
    }
    return found;
}

pub fn claim_account(c: &'static str, at: usize) -> u64 {
    if (claim_at(c, at) == false) {
        return ID_NO_ACCOUNT;
    }
    let a: usize = (id_line_end(c, at) + 1);
    let e: usize = id_line_end(c, a);
    if ((a >= c.len()) || (id_span_eq(c, a, (a + 8), "account ") == false)) {
        return ID_NO_ACCOUNT;
    }
    return id_dec(c, (a + 8), e);
}

pub fn claim_at(c: &'static str, at: usize) -> bool {
    return (((at == 0) || (c.as_bytes()[((at - 1)) as usize] == 10)) && id_span_eq(c, at, id_line_end(c, at), CLAIM_HEAD));
}

pub fn claim_commit_line(c: &'static str, a: usize, e: usize) -> bool {
    return (((e == ((a + 7) + SHA_HEX)) && id_span_eq(c, a, (a + 7), "commit ")) && id_is_hex(c, (a + 7), e));
}

pub fn claim_confirms(tab: IdentityTable, claims: &'static str, t: &'static str, f: usize, e: usize, owner: u64, agent: bool) -> bool {
    if ((agent || (id_account_known(owner) == false)) || (e != (f + SHA_HEX))) {
        return false;
    }
    let mut at: usize = 0;
    while (at < claims.len()) {
        if (((claim_account(claims, at) == owner) && claim_lists(claims, at, t, f, e)) && claim_verifies(tab, claims, at)) {
            return true;
        }
        at = (id_line_end(claims, at) + 1);
    }
    return false;
}

pub fn claim_lists(c: &'static str, at: usize, t: &'static str, f: usize, e: usize) -> bool {
    let s: usize = claim_sig_at(c, at);
    if ((s > c.len()) || (e != (f + SHA_HEX))) {
        return false;
    }
    let mut a: usize = (id_line_end(c, (id_line_end(c, at) + 1)) + 1);
    while (a < s) {
        let le: usize = id_line_end(c, a);
        if id_same(c, (a + 7), le, t, f, e) {
            return true;
        }
        a = (le + 1);
    }
    return false;
}

pub fn claim_sig_at(c: &'static str, at: usize) -> usize {
    if (id_account_known(claim_account(c, at)) == false) {
        return (c.len() + 1);
    }
    let mut a: usize = (id_line_end(c, (id_line_end(c, at) + 1)) + 1);
    let mut n: u32 = 0;
    while ((a < c.len()) && claim_commit_line(c, a, id_line_end(c, a))) {
        a = (id_line_end(c, a) + 1);
        n = (n + 1);
    }
    if ((n == 0) || (a >= c.len())) {
        return (c.len() + 1);
    }
    let e: usize = id_line_end(c, a);
    if (((e != ((a + 10) + SIG_HEX)) || (id_span_eq(c, a, (a + 10), "signature ") == false)) || (id_is_hex(c, (a + 10), e) == false)) {
        return (c.len() + 1);
    }
    return a;
}

pub fn claim_verifies(tab: IdentityTable, c: &'static str, at: usize) -> bool {
    let acct: u64 = claim_account(c, at);
    let s: usize = claim_sig_at(c, at);
    if ((s > c.len()) || ((s - at) > CLAIM_MAX)) {
        return false;
    }
    let mut buf: [u8; 16384] = [0; 16384];
    let mut n: usize = 0;
    while ((at + n) < s) {
        buf[(n) as usize] = c.as_bytes()[((at + n)) as usize];
        n = (n + 1);
    }
    let sig: [u8; 64] = id_hex64(c, (s + 10));
    let mut j: u32 = 0;
    while ((j < tab.bindings) && (j < ID_ROWS)) {
        if ((((tab.b_kind[(j) as usize] == K_SIGNING_KEY) && (binding_account(tab, j) == acct)) && signing_key_ok(tab.b_value[(j) as usize])) && binding_valid(tab, j)) {
            if verify(id_hex32(tab.b_value[(j) as usize], 0), &buf[(0) as usize..(n) as usize], sig) {
                return true;
            }
        }
        j = (j + 1);
    }
    return false;
}

pub fn email_account(tab: IdentityTable, t: &'static str, f: usize, e: usize) -> u64 {
    return bound_account(tab, K_EMAIL, t, f, e);
}

