pub fn finish(sha: &mut SHA512) -> [u8; 64] {
    let len_hi = (sha.count >> 61);
    let len_lo = (sha.count).wrapping_mul(8);
    let used = ((sha.count % 128) as usize);
    let mut zeros: usize = (239 - used);
    if (used < 112) {
        zeros = (111 - used);
    }
    let mut pad: [u8; 144] = [0; 144];
    pad[0] = 128;
    let mut k: usize = 0;
    while (k < 8) {
        pad[(((1 + zeros) + k)) as usize] = (((len_hi >> (56 - (8 * (k as u64)))) & 255) as u8);
        pad[(((9 + zeros) + k)) as usize] = (((len_lo >> (56 - (8 * (k as u64)))) & 255) as u8);
        k = (k + 1);
    }
    update(sha, &pad[(0) as usize..((zeros + 17)) as usize]);
    let mut out: [u8; 64] = [0; 64];
    let mut i: usize = 0;
    while (i < 64) {
        out[(i) as usize] = (((sha.state[((i / 8)) as usize] >> (56 - (8 * ((i % 8) as u64)))) & 255) as u8);
        i = (i + 1);
    }
    return out;
}

pub fn hash(data: &[u8]) -> [u8; 64] {
    let mut sha = init();
    update(&mut (sha), data);
    return finish(&mut (sha));
}

pub fn init() -> SHA512 {
    return SHA512 { state: H0, buffer: [0; 128], count: 0 };
}

pub fn maj(x: u64, y: u64, z: u64) -> u64 {
    return (((x & y) ^ (x & z)) ^ (y & z));
}

pub fn rotr(x: u64, n: u64) -> u64 {
    return ((x >> n) | (x << (64 - n)));
}

pub fn same(a: [u8; 64], b: [u8; 64]) -> bool {
    let mut i: usize = 0;
    while (i < 64) {
        if (a[(i) as usize] != b[(i) as usize]) {
            return false;
        }
        i = (i + 1);
    }
    return true;
}

pub fn small_sigma0(x: u64) -> u64 {
    return ((rotr(x, 1) ^ rotr(x, 8)) ^ (x >> 7));
}

pub fn small_sigma1(x: u64) -> u64 {
    return ((rotr(x, 19) ^ rotr(x, 61)) ^ (x >> 6));
}

pub fn update(sha: &mut SHA512, data: &[u8]) -> () {
    let mut i: usize = 0;
    while (i < data.len()) {
        sha.buffer[(((sha.count % 128) as usize)) as usize] = data[(i) as usize];
        sha.count = (sha.count + 1);
        if ((sha.count % 128) == 0) {
            compress(sha);
        }
        i = (i + 1);
    }
}

pub const LAB_URL: &'static str = "https://t27b-lab-production.up.railway.app/";

pub const RECEIPT_EXT: &'static str = ".receipt.json";

pub const RUNS: &'static str = "runs/";

pub const V_BEHIND: u8 = 2;

pub const V_BLOCKED: u8 = 3;

pub const V_NOT_RUN: u8 = 4;

pub const V_RED: u8 = 5;

pub const V_VACUOUS: u8 = 1;

pub const V_VERIFIED: u8 = 0;

pub fn key_at(text: &'static str, from: usize, stop: usize, ind: usize, key: &'static str) -> usize {
    let mut at: usize = from;
    while ((at < stop) && (at < text.len())) {
        let end: usize = line_end(text, at);
        let v: usize = key_value(text, at, end, ind, key);
        if (v <= end) {
            return v;
        }
        at = (end + 1);
    }
    return (text.len() + 1);
}

pub fn key_value(text: &'static str, at: usize, end: usize, ind: usize, key: &'static str) -> usize {
    let v: usize = (((at + ind) + key.len()) + 4);
    if (v > end) {
        return (end + 1);
    }
    let mut k: usize = 0;
    while (k < ind) {
        if (text.as_bytes()[((at + k)) as usize] != 32) {
            return (end + 1);
        }
        k = (k + 1);
    }
    if (text.as_bytes()[((at + ind)) as usize] != 34) {
        return (end + 1);
    }
    if (span_is(text, ((at + ind) + 1), (((at + ind) + 1) + key.len()), key) == false) {
        return (end + 1);
    }
    if (((text.as_bytes()[((v - 3)) as usize] != 34) || (text.as_bytes()[((v - 2)) as usize] != 58)) || (text.as_bytes()[((v - 1)) as usize] != 32)) {
        return (end + 1);
    }
    return v;
}

pub fn line_end(text: &'static str, at: usize) -> usize {
    let mut k: usize = at;
    while ((k < text.len()) && (text.as_bytes()[(k) as usize] != 10)) {
        k = (k + 1);
    }
    return k;
}

pub fn line_is(text: &'static str, at: usize, end: usize, ind: usize, lit: &'static str) -> bool {
    let mut e: usize = end;
    if ((e > at) && (text.as_bytes()[((e - 1)) as usize] == 44)) {
        e = (e - 1);
    }
    if (e < (at + ind)) {
        return false;
    }
    let mut k: usize = 0;
    while (k < ind) {
        if (text.as_bytes()[((at + k)) as usize] != 32) {
            return false;
        }
        k = (k + 1);
    }
    return span_is(text, (at + ind), e, lit);
}

pub fn name(v: u8) -> &'static str {
    if (v == V_VERIFIED) {
        return "verified";
    }
    if (v == V_VACUOUS) {
        return "vacuous";
    }
    if (v == V_BEHIND) {
        return "behind";
    }
    if (v == V_BLOCKED) {
        return "blocked";
    }
    if (v == V_NOT_RUN) {
        return "not-run";
    }
    if (v == V_RED) {
        return "RED";
    }
    return "UNREAD";
}

pub fn span_is(text: &'static str, from: usize, to: usize, lit: &'static str) -> bool {
    if ((to < from) || ((to - from) != lit.len())) {
        return false;
    }
    let mut k: usize = 0;
    while (k < lit.len()) {
        if (text.as_bytes()[((from + k)) as usize] != lit.as_bytes()[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn value_from(text: &'static str, v: usize) -> usize {
    if (v >= text.len()) {
        return text.len();
    }
    if (text.as_bytes()[(v) as usize] == 34) {
        return (v + 1);
    }
    return v;
}

pub fn value_to(text: &'static str, v: usize) -> usize {
    if (v >= text.len()) {
        return text.len();
    }
    let mut e: usize = line_end(text, v);
    if ((e > v) && (text.as_bytes()[((e - 1)) as usize] == 44)) {
        e = (e - 1);
    }
    if (((text.as_bytes()[(v) as usize] == 34) && (e > (v + 1))) && (text.as_bytes()[((e - 1)) as usize] == 34)) {
        e = (e - 1);
    }
    if (e < value_from(text, v)) {
        return value_from(text, v);
    }
    return e;
}

pub const LANE_EQUIVALENT: u8 = 0;

pub const AUTH_BAD_SIGNATURE: u8 = 3;

pub const AUTH_KEY_NOT_REGISTERED: u8 = 2;

pub const AUTH_MISSING_NONE: u8 = 0;

pub const AUTH_NONCE_NOT_CHALLENGE: u8 = 5;

pub const AUTH_NO_NONCE: u8 = 4;

pub const AUTH_UNSIGNED: u8 = 1;

pub const HEX_NOT_A_DIGIT: u32 = 16;

pub const LEVEL_AUTHOR: u8 = 1;

pub const LEVEL_FRESH: u8 = 2;

pub const LEVEL_NONE: u8 = 0;

pub const NONCE_MIN_BYTES: u8 = 16;

pub fn auth_first_missing(signed: bool, key_registered: bool, signature_valid: bool, challenge_given: bool, nonce_bytes: u8, nonce_is_challenge: bool) -> u8 {
    if (signed == false) {
        return AUTH_UNSIGNED;
    }
    if (key_registered == false) {
        return AUTH_KEY_NOT_REGISTERED;
    }
    if (signature_valid == false) {
        return AUTH_BAD_SIGNATURE;
    }
    if challenge_given {
        if (nonce_long_enough(nonce_bytes) == false) {
            return AUTH_NO_NONCE;
        }
        if (nonce_is_challenge == false) {
            return AUTH_NONCE_NOT_CHALLENGE;
        }
    }
    return AUTH_MISSING_NONE;
}

pub fn hex_digit_value(c: u32) -> u32 {
    if (c >= 48) {
        if (c <= 57) {
            return (c - 48);
        }
    }
    if (c >= 97) {
        if (c <= 102) {
            return (c - 87);
        }
    }
    if (c >= 65) {
        if (c <= 70) {
            return (c - 55);
        }
    }
    return HEX_NOT_A_DIGIT;
}

pub fn nonce_long_enough(nonce_bytes: u8) -> bool {
    return (nonce_bytes >= NONCE_MIN_BYTES);
}

pub fn receipt_level(signed: bool, key_registered: bool, signature_valid: bool, challenge_given: bool, nonce_bytes: u8, nonce_is_challenge: bool) -> u8 {
    let mut code: u8 = auth_first_missing(signed, key_registered, signature_valid, challenge_given, nonce_bytes, nonce_is_challenge);
    if (code == AUTH_UNSIGNED) {
        return LEVEL_NONE;
    }
    if (code == AUTH_KEY_NOT_REGISTERED) {
        return LEVEL_NONE;
    }
    if (code == AUTH_BAD_SIGNATURE) {
        return LEVEL_NONE;
    }
    if (challenge_given == false) {
        return LEVEL_AUTHOR;
    }
    if (code == AUTH_MISSING_NONE) {
        return LEVEL_FRESH;
    }
    return LEVEL_AUTHOR;
}

