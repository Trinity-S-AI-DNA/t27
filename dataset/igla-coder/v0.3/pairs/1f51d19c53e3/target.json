pub fn idm_dec(m: IdMessage, n: u64) -> IdMessage {
    let mut o: IdMessage = m;
    let mut d: [u8; 20] = [0; 20];
    let mut nd: usize = 0;
    let mut x: u64 = n;
    if (x == 0) {
        d[0] = 48;
        nd = 1;
    }
    while ((x > 0) && (nd < 20)) {
        d[(nd) as usize] = (((x % 10) as u8) + 48);
        x = (x / 10);
        nd = (nd + 1);
    }
    while ((nd > 0) && (o.used < BINDING_MAX)) {
        nd = (nd - 1);
        o.bytes[(o.used) as usize] = d[(nd) as usize];
        o.used = (o.used + 1);
    }
    if (o.used < BINDING_MAX) {
        o.bytes[(o.used) as usize] = 10;
        o.used = (o.used + 1);
    }
    return o;
}

pub fn idm_text(m: IdMessage, t: &'static str, nl: bool) -> IdMessage {
    let mut o: IdMessage = m;
    let mut k: usize = 0;
    while ((k < t.len()) && (o.used < BINDING_MAX)) {
        o.bytes[(o.used) as usize] = t.as_bytes()[(k) as usize];
        o.used = (o.used + 1);
        k = (k + 1);
    }
    if (nl && (o.used < BINDING_MAX)) {
        o.bytes[(o.used) as usize] = 10;
        o.used = (o.used + 1);
    }
    return o;
}

pub fn part_account(tab: IdentityTable, p: u32) -> u64 {
    if ((p >= tab.parts) || (p >= ID_ROWS)) {
        return ID_NO_ACCOUNT;
    }
    return tab.account[(p) as usize];
}

