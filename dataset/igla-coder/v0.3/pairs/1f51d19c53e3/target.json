pub fn bytes32_eq(a: [u8; 32], b: [u8; 32]) -> bool {
    let mut i: usize = 0;
    while (i < 32) {
        if (a[(i) as usize] != b[(i) as usize]) {
            return false;
        }
        i = (i + 1);
    }
    return true;
