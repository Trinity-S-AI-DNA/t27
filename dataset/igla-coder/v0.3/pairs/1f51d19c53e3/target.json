pub fn ed_scalar(dh: [u8; 64]) -> [u8; 32] {
    let mut a: [u8; 32] = [0; 32];
    let mut i: usize = 0;
    while (i < 32) {
        a[(i) as usize] = dh[(i) as usize];
        i = (i + 1);
    }
    a[0] = (a[0] & 248);
    a[31] = (a[31] & 127);
    a[31] = (a[31] | 64);
    return a;
}

pub fn fe_add(a: [i64; 16], b: [i64; 16]) -> [i64; 16] {
    let mut o: [i64; 16] = FE0;
    let mut i: usize = 0;
    while (i < 16) {
        o[(i) as usize] = (a[(i) as usize] + b[(i) as usize]);
        i = (i + 1);
    }
    return o;
}

pub fn fe_carry(a: [i64; 16]) -> [i64; 16] {
    let mut o: [i64; 16] = a;
    let mut i: usize = 0;
    while (i < 16) {
        let c = (o[(i) as usize] >> 16);
        o[(i) as usize] = (o[(i) as usize] & 65535);
        if (i < 15) {
            o[((i + 1)) as usize] = (o[((i + 1)) as usize] + c);
        } else {
            o[0] = (o[0] + (38 * c));
        }
        i = (i + 1);
    }
    return o;
}

pub fn fe_inv(a: [i64; 16]) -> [i64; 16] {
    let mut c: [i64; 16] = a;
    let mut n: usize = 0;
    while (n < 254) {
        let k = (253 - n);
        c = fe_sq(c);
        if ((k != 2) && (k != 4)) {
            c = fe_mul(c, a);
        }
        n = (n + 1);
    }
    return c;
}

pub fn fe_mul(a: [i64; 16], b: [i64; 16]) -> [i64; 16] {
    let mut t: [i64; 31] = [0; 31];
    let mut i: usize = 0;
    while (i < 16) {
        let mut j: usize = 0;
        while (j < 16) {
            t[((i + j)) as usize] = (t[((i + j)) as usize] + (a[(i) as usize] * b[(j) as usize]));
            j = (j + 1);
        }
        i = (i + 1);
    }
    i = 0;
    while (i < 15) {
        t[(i) as usize] = (t[(i) as usize] + (38 * t[((i + 16)) as usize]));
        i = (i + 1);
    }
    let mut o: [i64; 16] = FE0;
    i = 0;
    while (i < 16) {
        o[(i) as usize] = t[(i) as usize];
        i = (i + 1);
    }
    return fe_carry(fe_carry(o));
}

pub fn fe_neq(a: [i64; 16], b: [i64; 16]) -> bool {
    return (bytes32_eq(fe_pack(a), fe_pack(b)) == false);
}

pub fn fe_pack(n: [i64; 16]) -> [u8; 32] {
    let mut t: [i64; 16] = fe_carry(fe_carry(fe_carry(n)));
    let mut m: [i64; 16] = FE0;
    let mut j: usize = 0;
    while (j < 2) {
        m[0] = (t[0] - 0xffed);
        let mut i: usize = 1;
        while (i < 15) {
            m[(i) as usize] = ((t[(i) as usize] - 0xffff) - ((m[((i - 1)) as usize] >> 16) & 1));
            m[((i - 1)) as usize] = (m[((i - 1)) as usize] & 65535);
            i = (i + 1);
        }
        m[15] = ((t[15] - 0x7fff) - ((m[14] >> 16) & 1));
        let borrow = ((m[15] >> 16) & 1);
        m[14] = (m[14] & 65535);
        t = fe_pick(t, m, (1 - borrow));
        j = (j + 1);
    }
    let mut o: [u8; 32] = [0; 32];
    let mut k: usize = 0;
    while (k < 16) {
        o[((2 * k)) as usize] = ((t[(k) as usize] & 255) as u8);
        o[(((2 * k) + 1)) as usize] = (((t[(k) as usize] >> 8) & 255) as u8);
        k = (k + 1);
    }
    return o;
}

pub fn fe_parity(a: [i64; 16]) -> i64 {
    let s = fe_pack(a);
    return ((s[0] & 1) as i64);
}

pub fn fe_pick(p: [i64; 16], q: [i64; 16], b: i64) -> [i64; 16] {
    let c = (0 - b);
    let mut o: [i64; 16] = FE0;
    let mut i: usize = 0;
    while (i < 16) {
        o[(i) as usize] = (p[(i) as usize] ^ (c & (p[(i) as usize] ^ q[(i) as usize])));
        i = (i + 1);
    }
    return o;
}

pub fn fe_pow2523(a: [i64; 16]) -> [i64; 16] {
    let mut c: [i64; 16] = a;
    let mut n: usize = 0;
    while (n < 251) {
        let k = (250 - n);
        c = fe_sq(c);
        if (k != 1) {
            c = fe_mul(c, a);
        }
        n = (n + 1);
    }
    return c;
}

pub fn fe_sq(a: [i64; 16]) -> [i64; 16] {
    return fe_mul(a, a);
}

pub fn fe_sub(a: [i64; 16], b: [i64; 16]) -> [i64; 16] {
    let mut o: [i64; 16] = FE0;
    let mut i: usize = 0;
    while (i < 16) {
        o[(i) as usize] = (a[(i) as usize] - b[(i) as usize]);
        i = (i + 1);
    }
    return o;
}

pub fn fe_unpack(s: [u8; 32]) -> [i64; 16] {
    let mut o: [i64; 16] = FE0;
    let mut i: usize = 0;
    while (i < 16) {
        o[(i) as usize] = ((s[((2 * i)) as usize] as i64) + (256 * (s[(((2 * i) + 1)) as usize] as i64)));
        i = (i + 1);
    }
    o[15] = (o[15] & 0x7fff);
    return o;
}

pub fn mod_l(xin: [i64; 64]) -> [u8; 32] {
    let mut x: [i64; 64] = xin;
    let mut i: usize = 63;
    while (i >= 32) {
        let mut carry: i64 = 0;
        let mut j: usize = (i - 32);
        while (j < (i - 12)) {
            x[(j) as usize] = ((x[(j) as usize] + carry) - ((16 * x[(i) as usize]) * ED_L[((j - (i - 32))) as usize]));
            carry = ((x[(j) as usize] + 128) >> 8);
            x[(j) as usize] = (x[(j) as usize] - (carry * 256));
            j = (j + 1);
        }
        x[(j) as usize] = (x[(j) as usize] + carry);
        x[(i) as usize] = 0;
        i = (i - 1);
    }
    let mut top: i64 = 0;
    let mut k: usize = 0;
    while (k < 32) {
        x[(k) as usize] = ((x[(k) as usize] + top) - ((x[31] >> 4) * ED_L[(k) as usize]));
        top = (x[(k) as usize] >> 8);
        x[(k) as usize] = (x[(k) as usize] & 255);
        k = (k + 1);
    }
    k = 0;
    while (k < 32) {
        x[(k) as usize] = (x[(k) as usize] - (top * ED_L[(k) as usize]));
        k = (k + 1);
    }
    let mut r: [u8; 32] = [0; 32];
    k = 0;
    while (k < 32) {
        x[((k + 1)) as usize] = (x[((k + 1)) as usize] + (x[(k) as usize] >> 8));
        r[(k) as usize] = ((x[(k) as usize] & 255) as u8);
        k = (k + 1);
    }
    return r;
}

pub fn pt_add(p: EdPoint, q: EdPoint) -> EdPoint {
    let a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x));
    let b = fe_mul(fe_add(p.x, p.y), fe_add(q.x, q.y));
    let c = fe_mul(fe_mul(p.t, q.t), ED_D2);
    let dd = fe_mul(p.z, q.z);
    let d2 = fe_add(dd, dd);
    let e = fe_sub(b, a);
    let f = fe_sub(d2, c);
    let g = fe_add(d2, c);
    let h = fe_add(b, a);
    return EdPoint { x: fe_mul(e, f), y: fe_mul(h, g), z: fe_mul(g, f), t: fe_mul(e, h) };
}

pub fn pt_base() -> EdPoint {
    return EdPoint { x: ED_BX, y: ED_BY, z: FE1, t: fe_mul(ED_BX, ED_BY) };
}

pub fn pt_decode_neg(s: [u8; 32]) -> EdDecoded {
    let y = fe_unpack(s);
    let mut top: [u8; 32] = s;
    top[31] = (top[31] & 127);
    let canonical = bytes32_eq(fe_pack(y), top);
    let y2 = fe_sq(y);
    let num = fe_sub(y2, FE1);
    let den = fe_add(fe_mul(y2, ED_D), FE1);
    let den2 = fe_sq(den);
    let den4 = fe_sq(den2);
    let den6 = fe_mul(den4, den2);
    let mut x: [i64; 16] = fe_pow2523(fe_mul(fe_mul(den6, num), den));
    x = fe_mul(fe_mul(fe_mul(fe_mul(x, num), den), den), den);
    if fe_neq(fe_mul(fe_sq(x), den), num) {
        x = fe_mul(x, SQRTM1);
    }
    let on_curve = (fe_neq(fe_mul(fe_sq(x), den), num) == false);
    let sign = ((s[31] >> 7) as i64);
    let bad_zero = ((fe_neq(x, FE0) == false) && (sign == 1));
    if (fe_parity(x) == sign) {
        x = fe_sub(FE0, x);
    }
    let neg = EdPoint { x: x, y: y, z: FE1, t: fe_mul(x, y) };
    return EdDecoded { ok: ((canonical && on_curve) && (bad_zero == false)), neg: neg };
}

pub fn pt_identity() -> EdPoint {
    return EdPoint { x: FE0, y: FE1, z: FE1, t: FE0 };
}

pub fn pt_pack(p: EdPoint) -> [u8; 32] {
    let zi = fe_inv(p.z);
    let tx = fe_mul(p.x, zi);
    let ty = fe_mul(p.y, zi);
    let mut r: [u8; 32] = fe_pack(ty);
    r[31] = (r[31] ^ ((fe_parity(tx) * 128) as u8));
    return r;
}

pub fn pt_pick(p: EdPoint, q: EdPoint, b: i64) -> EdPoint {
    return EdPoint { x: fe_pick(p.x, q.x, b), y: fe_pick(p.y, q.y, b), z: fe_pick(p.z, q.z, b), t: fe_pick(p.t, q.t, b) };
}

pub fn pt_scalarbase(s: [u8; 32]) -> EdPoint {
    return pt_scalarmult(pt_base(), s);
}

pub fn pt_scalarmult(q: EdPoint, s: [u8; 32]) -> EdPoint {
    let mut r0: EdPoint = pt_identity();
    let mut r1: EdPoint = q;
    let mut n: usize = 0;
    while (n < 256) {
        let k = (255 - n);
        let b = ((((s[((k / 8)) as usize] as usize) >> (k % 8)) & 1) as i64);
        let a0 = pt_pick(r0, r1, b);
        let a1 = pt_pick(r1, r0, b);
        let sum = pt_add(a1, a0);
        let dbl = pt_add(a0, a0);
        r0 = pt_pick(dbl, sum, b);
        r1 = pt_pick(sum, dbl, b);
        n = (n + 1);
    }
    return r0;
}

pub fn pt_small_order(p: EdPoint) -> bool {
    let p2 = pt_add(p, p);
    let p4 = pt_add(p2, p2);
    return bytes32_eq(pt_pack(pt_add(p4, p4)), pt_pack(pt_identity()));
}

pub fn sc_below_l(s: [u8; 32]) -> bool {
    let mut n: usize = 0;
    while (n < 32) {
        let i = (31 - n);
        let v = (s[(i) as usize] as i64);
        if (v < ED_L[(i) as usize]) {
            return true;
        }
        if (v > ED_L[(i) as usize]) {
            return false;
        }
        n = (n + 1);
    }
    return false;
}

pub fn sc_reduce(h: [u8; 64]) -> [u8; 32] {
    let mut x: [i64; 64] = [0; 64];
    let mut i: usize = 0;
    while (i < 64) {
        x[(i) as usize] = (h[(i) as usize] as i64);
        i = (i + 1);
    }
    return mod_l(x);
}

pub fn sign(seed: [u8; 32], msg: &[u8]) -> [u8; 64] {
    let dh = hash(&seed[(0) as usize..(32) as usize]);
    let a = ed_scalar(dh);
    let pk = pt_pack(pt_scalarbase(a));
    let mut hr = init();
    update(&mut (hr), &dh[(32) as usize..(64) as usize]);
    update(&mut (hr), msg);
    let r = sc_reduce(finish(&mut (hr)));
    let rb = pt_pack(pt_scalarbase(r));
    let mut hk = init();
    update(&mut (hk), &rb[(0) as usize..(32) as usize]);
    update(&mut (hk), &pk[(0) as usize..(32) as usize]);
    update(&mut (hk), msg);
    let k = sc_reduce(finish(&mut (hk)));
    let mut x: [i64; 64] = [0; 64];
    let mut i: usize = 0;
    while (i < 32) {
        x[(i) as usize] = (r[(i) as usize] as i64);
        i = (i + 1);
    }
    i = 0;
    while (i < 32) {
        let mut j: usize = 0;
        while (j < 32) {
            x[((i + j)) as usize] = (x[((i + j)) as usize] + ((k[(i) as usize] as i64) * (a[(j) as usize] as i64)));
            j = (j + 1);
        }
        i = (i + 1);
    }
    let s = mod_l(x);
    let mut sig: [u8; 64] = [0; 64];
    i = 0;
    while (i < 32) {
        sig[(i) as usize] = rb[(i) as usize];
        sig[((32 + i)) as usize] = s[(i) as usize];
        i = (i + 1);
    }
    return sig;
}

pub fn verify(pk: [u8; 32], msg: &[u8], sig: [u8; 64]) -> bool {
    let mut rb: [u8; 32] = [0; 32];
    let mut sb: [u8; 32] = [0; 32];
    let mut i: usize = 0;
    while (i < 32) {
        rb[(i) as usize] = sig[(i) as usize];
        sb[(i) as usize] = sig[((32 + i)) as usize];
        i = (i + 1);
    }
    if (sc_below_l(sb) == false) {
        return false;
    }
    let a = pt_decode_neg(pk);
    if (a.ok == false) {
        return false;
    }
    if pt_small_order(a.neg) {
        return false;
    }
    let mut hk = init();
    update(&mut (hk), &rb[(0) as usize..(32) as usize]);
    update(&mut (hk), &pk[(0) as usize..(32) as usize]);
    update(&mut (hk), msg);
    let k = sc_reduce(finish(&mut (hk)));
    let check = pt_add(pt_scalarmult(a.neg, k), pt_scalarbase(sb));
    if pt_small_order(check) {
        return false;
    }
    return bytes32_eq(pt_pack(check), rb);
}

