pub fn royalty_claim(usage: [u64; 8], specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], id: u64) -> u64 {
    let mut c: u64 = 0;
    let mut s: u32 = 0;
    while (s < USAGE_SPECS) {
        c = (c + (royalty_usage(usage[(s) as usize]) * weight_of(specs, authors, lines, tests, flags, s, id)));
        s = (s + 1);
    }
    return c;
}

pub fn royalty_first_id(specs: [u32; 16], authors: [u64; 16], flags: [u8; 16], i: u32) -> bool {
    if (specs[(i) as usize] == NO_SPEC) {
        return false;
    }
    let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
    let mut j: u32 = 0;
    while (j < i) {
        if ((specs[(j) as usize] != NO_SPEC) && (credited_to(authors[(j) as usize], flags[(j) as usize]) == c)) {
            return false;
        }
        j = (j + 1);
    }
    return true;
}

pub fn royalty_floor(pool: u64, claim: u64, total: u64) -> u64 {
    if (total == 0) {
        return 0;
    }
    let q: u64 = (pool / total);
    let r: u64 = (pool - (q * total));
    return ((q * claim) + ((r * claim) / total));
}

pub fn royalty_held_total(pool: u64, usage: [u64; 8], specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16]) -> u64 {
    let mut h: u64 = 0;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
        if (royalty_first_id(specs, authors, flags, i) && is_held(c)) {
            h = (h + royalty_floor(pool, royalty_claim(usage, specs, authors, lines, tests, flags, c), royalty_total(usage)));
        }
        i = (i + 1);
    }
    return h;
}

pub fn royalty_share(pool: u64, usage: [u64; 8], specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], id: u64) -> u64 {
    if (payable(id) == false) {
        return 0;
    }
    return royalty_floor(pool, royalty_claim(usage, specs, authors, lines, tests, flags, id), royalty_total(usage));
}

pub fn royalty_total(usage: [u64; 8]) -> u64 {
    let mut t: u64 = 0;
    let mut s: u32 = 0;
    while (s < USAGE_SPECS) {
        t = (t + (royalty_usage(usage[(s) as usize]) * BP_TOTAL));
        s = (s + 1);
    }
    return t;
}

pub fn royalty_usage(u: u64) -> u64 {
    if (u > USAGE_MAX) {
        return USAGE_MAX;
    }
    return u;
}

pub fn usage_bit(auth: u8, b: u8) -> bool {
    return ((auth & b) != 0);
}

pub fn usage_commit_epoch(commits: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], commit: u64) -> u64 {
    let mut e: u64 = NO_EPOCH;
    let mut i: u32 = 0;
    while (i < USAGE_ROWS) {
        if (((commits[(i) as usize] == commit) && usage_counts(commits[(i) as usize], auths[(i) as usize], nonces[(i) as usize])) && (epochs[(i) as usize] < e)) {
            e = epochs[(i) as usize];
        }
        i = (i + 1);
    }
    return e;
}

pub fn usage_counts(commit: u64, auth: u8, nonce: u8) -> bool {
    if (commit == NO_COMMIT) {
        return false;
    }
    if (usage_bit(auth, U_KEY_REGISTERED) == false) {
        return false;
    }
    return (usage_level(auth, nonce) >= LEVEL_AUTHOR);
}

pub fn usage_key_first(commits: [u64; 8], keys: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], reads: [u64; 8], i: u32, spec: u32) -> bool {
    if (usage_row_reads(commits, epochs, auths, nonces, reads, i, spec) == false) {
        return false;
    }
    let mut j: u32 = 0;
    while (j < i) {
        if (((commits[(j) as usize] == commits[(i) as usize]) && (keys[(j) as usize] == keys[(i) as usize])) && usage_row_reads(commits, epochs, auths, nonces, reads, j, spec)) {
            return false;
        }
        j = (j + 1);
    }
    return true;
}

pub fn usage_keys_reading(commits: [u64; 8], keys: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], reads: [u64; 8], commit: u64, spec: u32) -> u64 {
    let mut n: u64 = 0;
    let mut i: u32 = 0;
    while (i < USAGE_ROWS) {
        if ((commits[(i) as usize] == commit) && usage_key_first(commits, keys, epochs, auths, nonces, reads, i, spec)) {
            n = (n + 1);
        }
        i = (i + 1);
    }
    return n;
}

pub fn usage_level(auth: u8, nonce: u8) -> u8 {
    return receipt_level(usage_bit(auth, U_SIGNED), usage_bit(auth, U_KEY_REGISTERED), usage_bit(auth, U_SIGNATURE_VALID), usage_bit(auth, U_CHALLENGE_GIVEN), nonce, usage_bit(auth, U_NONCE_IS_CHALLENGE));
}

pub fn usage_of(commits: [u64; 8], keys: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], reads: [u64; 8], spec: u32, epoch: u64) -> u64 {
    let mut u: u64 = 0;
    let mut i: u32 = 0;
    while (i < USAGE_ROWS) {
        if ((epochs[(i) as usize] == epoch) && usage_use_first(commits, keys, epochs, auths, nonces, reads, i, spec)) {
            u = (u + usage_weight(usage_keys_reading(commits, keys, epochs, auths, nonces, reads, commits[(i) as usize], spec)));
        }
        i = (i + 1);
    }
    return u;
}

pub fn usage_reads(mask: u64, spec: u32) -> bool {
    if (spec >= 64) {
        return false;
    }
    return (((mask >> (spec as u64)) & 1) == 1);
}

pub fn usage_row_reads(commits: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], reads: [u64; 8], i: u32, spec: u32) -> bool {
    if (usage_counts(commits[(i) as usize], auths[(i) as usize], nonces[(i) as usize]) == false) {
        return false;
    }
    if (usage_reads(reads[(i) as usize], spec) == false) {
        return false;
    }
    return (epochs[(i) as usize] == usage_commit_epoch(commits, epochs, auths, nonces, commits[(i) as usize]));
}

pub fn usage_use_first(commits: [u64; 8], keys: [u64; 8], epochs: [u64; 8], auths: [u8; 8], nonces: [u8; 8], reads: [u64; 8], i: u32, spec: u32) -> bool {
    if (usage_key_first(commits, keys, epochs, auths, nonces, reads, i, spec) == false) {
        return false;
    }
    let mut j: u32 = 0;
    while (j < i) {
        if ((commits[(j) as usize] == commits[(i) as usize]) && usage_key_first(commits, keys, epochs, auths, nonces, reads, j, spec)) {
            return false;
        }
        j = (j + 1);
    }
    return true;
}

pub fn usage_weight(keys_reading: u64) -> u64 {
    if (keys_reading > QUORUM_CAP) {
        return QUORUM_CAP;
    }
    return keys_reading;
}

