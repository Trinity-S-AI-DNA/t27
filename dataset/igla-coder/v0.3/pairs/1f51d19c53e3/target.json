pub fn id_account_known(id: u64) -> bool {
    return ((id != ID_NO_ACCOUNT) && (id <= ID_ACCOUNT_MAX));
}

pub fn id_dec(t: &'static str, f: usize, e: usize) -> u64 {
    if (((e <= f) || ((e - f) > 19)) || (e > t.len())) {
        return ID_NO_ACCOUNT;
    }
    let mut n: u64 = 0;
    let mut k: usize = f;
    while (k < e) {
        if ((t.as_bytes()[(k) as usize] < 48) || (t.as_bytes()[(k) as usize] > 57)) {
            return ID_NO_ACCOUNT;
        }
        n = ((n * 10) + ((t.as_bytes()[(k) as usize] as u64) - 48));
        k = (k + 1);
    }
    return n;
}

pub fn id_hex32(t: &'static str, at: usize) -> [u8; 32] {
    let mut o: [u8; 32] = [0; 32];
    if (id_is_hex(t, at, (at + 64)) == false) {
        return o;
    }
    let mut i: usize = 0;
    while (i < 32) {
        o[(i) as usize] = ((id_hex_digit(t.as_bytes()[((at + (2 * i))) as usize]) * 16) + id_hex_digit(t.as_bytes()[(((at + (2 * i)) + 1)) as usize]));
        i = (i + 1);
    }
    return o;
}

pub fn id_hex64(t: &'static str, at: usize) -> [u8; 64] {
    let mut o: [u8; 64] = [0; 64];
    if (id_is_hex(t, at, (at + 128)) == false) {
        return o;
    }
    let mut i: usize = 0;
    while (i < 64) {
        o[(i) as usize] = ((id_hex_digit(t.as_bytes()[((at + (2 * i))) as usize]) * 16) + id_hex_digit(t.as_bytes()[(((at + (2 * i)) + 1)) as usize]));
        i = (i + 1);
    }
    return o;
}

pub fn id_hex_digit(c: u8) -> u8 {
    if ((c >= 48) && (c <= 57)) {
        return (c - 48);
    }
    if ((c >= 97) && (c <= 102)) {
        return (c - 87);
    }
    return 16;
}

pub fn id_is_hex(t: &'static str, from: usize, to: usize) -> bool {
    if ((to <= from) || (to > t.len())) {
        return false;
    }
    let mut k: usize = from;
    while (k < to) {
        if (id_hex_digit(t.as_bytes()[(k) as usize]) > 15) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn id_line_end(t: &'static str, at: usize) -> usize {
    let mut k: usize = at;
    while ((k < t.len()) && (t.as_bytes()[(k) as usize] != 10)) {
        k = (k + 1);
    }
    return k;
}

pub fn id_lower(c: u8) -> u8 {
    if ((c >= 65) && (c <= 90)) {
        return (c + 32);
    }
    return c;
}

pub fn id_same(t: &'static str, f: usize, e: usize, u: &'static str, g: usize, h: usize) -> bool {
    if (((((e < f) || (h < g)) || (e > t.len())) || (h > u.len())) || ((e - f) != (h - g))) {
        return false;
    }
    let mut k: usize = 0;
    while (k < (e - f)) {
        if (t.as_bytes()[((f + k)) as usize] != u.as_bytes()[((g + k)) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn id_span_eq(t: &'static str, from: usize, to: usize, lit: &'static str) -> bool {
    if (((to < from) || (to > t.len())) || ((to - from) != lit.len())) {
        return false;
    }
    let mut k: usize = 0;
    while (k < lit.len()) {
        if (t.as_bytes()[((from + k)) as usize] != lit.as_bytes()[(k) as usize]) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

pub fn id_span_ieq(t: &'static str, from: usize, to: usize, lit: &'static str) -> bool {
    if (((to < from) || (to > t.len())) || ((to - from) != lit.len())) {
        return false;
    }
    let mut k: usize = 0;
    while (k < lit.len()) {
        if (id_lower(t.as_bytes()[((from + k)) as usize]) != id_lower(lit.as_bytes()[(k) as usize])) {
            return false;
        }
        k = (k + 1);
    }
    return true;
}

