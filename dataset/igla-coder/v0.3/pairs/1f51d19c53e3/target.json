pub const F_AUTHOR_SIGNED: u8 = 8;

pub const F_CLAIMED: u8 = 16;

pub const F_SEAL_GREEN: u8 = 4;

pub const F_VERIFIED: u8 = 1;

pub const HELD_BIT: u64 = 9223372036854775808;

pub const LINES_MAX: u64 = 16777216;

pub const NO_AUTHOR: u64 = 0;

pub const NO_SPEC: u32 = 65535;

pub const POOL_ID: u64 = 18446744073709551615;

pub const ST_AGENT: u8 = 3;

pub const ST_CONFIRMED: u8 = 1;

pub const ST_DISPUTED: u8 = 2;

pub const TESTS_MAX: u64 = 1048576;

pub const W_LINE: u64 = 1;

pub const W_TEST: u64 = 20;

pub fn account_known(author: u64) -> bool {
    return ((author != NO_AUTHOR) && (author <= ACCOUNT_MAX));
}

pub fn attr_clamp(v: u64, top: u64) -> u64 {
    if (v > top) {
        return top;
    }
    return v;
}

pub fn attr_flag(flags: u8, f: u8) -> bool {
    return ((flags & f) != 0);
}

pub fn author_part(n: u64, k: u64, i: u64) -> u64 {
    if ((k == 0) || (i >= k)) {
        return 0;
    }
    let mut p: u64 = (n / k);
    if (i < (n % k)) {
        p = (p + 1);
    }
    return p;
}

pub fn credited_to(author: u64, flags: u8) -> u64 {
    let st: u8 = row_status(author, flags);
    if (st == ST_AGENT) {
        return POOL_ID;
    }
    if (st == ST_CONFIRMED) {
        return author;
    }
    return held_id(author);
}

pub fn first_of_id(specs: [u32; 16], authors: [u64; 16], flags: [u8; 16], i: u32) -> bool {
    let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
    let mut j: u32 = 0;
    while (j < i) {
        if ((specs[(j) as usize] == specs[(i) as usize]) && (credited_to(authors[(j) as usize], flags[(j) as usize]) == c)) {
            return false;
        }
        j = (j + 1);
    }
    return true;
}

pub fn held_author(id: u64) -> u64 {
    if (is_held(id) == false) {
        return NO_AUTHOR;
    }
    return (id - HELD_BIT);
}

pub fn held_id(author: u64) -> u64 {
    if (account_known(author) == false) {
        return HELD_BIT;
    }
    return (HELD_BIT | author);
}

pub fn id_score(specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], spec: u32, id: u64) -> u64 {
    let mut s: u64 = 0;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if ((specs[(i) as usize] == spec) && (credited_to(authors[(i) as usize], flags[(i) as usize]) == id)) {
            s = (s + row_score(lines[(i) as usize], tests[(i) as usize], flags[(i) as usize]));
        }
        i = (i + 1);
    }
    return s;
}

pub fn is_held(id: u64) -> bool {
    return ((id != POOL_ID) && (id >= HELD_BIT));
}

pub fn own_confirmed(flags: u8) -> bool {
    return (attr_flag(flags, F_CLAIMED) || (attr_flag(flags, F_VERIFIED) && attr_flag(flags, F_AUTHOR_SIGNED)));
}

pub fn payable(id: u64) -> bool {
    return account_known(id);
}

pub fn row_score(lines: u64, tests: u64, flags: u8) -> u64 {
    let l: u64 = (attr_clamp(lines, LINES_MAX) * W_LINE);
    if (attr_flag(flags, F_SEAL_GREEN) == false) {
        return l;
    }
    return (l + (attr_clamp(tests, TESTS_MAX) * W_TEST));
}

pub fn row_status(author: u64, flags: u8) -> u8 {
    if attr_flag(flags, F_AGENT) {
        return ST_AGENT;
    }
    if (account_known(author) && own_confirmed(flags)) {
        return ST_CONFIRMED;
    }
    return ST_DISPUTED;
}

pub fn spec_leftover(specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], spec: u32) -> u64 {
    let total: u64 = spec_score(specs, lines, tests, flags, spec);
    if (total == 0) {
        return 0;
    }
    let mut floors: u64 = 0;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if ((specs[(i) as usize] == spec) && first_of_id(specs, authors, flags, i)) {
            let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
            floors = (floors + ((id_score(specs, authors, lines, tests, flags, spec, c) * BP_TOTAL) / total));
        }
        i = (i + 1);
    }
    return (BP_TOTAL - floors);
}

pub fn spec_score(specs: [u32; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], spec: u32) -> u64 {
    let mut s: u64 = 0;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if (specs[(i) as usize] == spec) {
            s = (s + row_score(lines[(i) as usize], tests[(i) as usize], flags[(i) as usize]));
        }
        i = (i + 1);
    }
    return s;
}

pub fn weight_of(specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], spec: u32, id: u64) -> u64 {
    if (spec == NO_SPEC) {
        return 0;
    }
    let total: u64 = spec_score(specs, lines, tests, flags, spec);
    if (total == 0) {
        if (id == POOL_ID) {
            return BP_TOTAL;
        }
        return 0;
    }
    let own: u64 = id_score(specs, authors, lines, tests, flags, spec, id);
    if (own == 0) {
        return 0;
    }
    let base: u64 = ((own * BP_TOTAL) / total);
    let rem: u64 = ((own * BP_TOTAL) - (base * total));
    let mut beaten: u64 = 0;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if ((specs[(i) as usize] == spec) && first_of_id(specs, authors, flags, i)) {
            let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
            if (c != id) {
                let sc: u64 = (id_score(specs, authors, lines, tests, flags, spec, c) * BP_TOTAL);
                let rc: u64 = (sc - ((sc / total) * total));
                if ((rc > rem) || ((rc == rem) && (c < id))) {
                    beaten = (beaten + 1);
                }
            }
        }
        i = (i + 1);
    }
    if (beaten < spec_leftover(specs, authors, lines, tests, flags, spec)) {
        return (base + 1);
    }
    return base;
}

pub fn weights_sum(specs: [u32; 16], authors: [u64; 16], lines: [u64; 16], tests: [u64; 16], flags: [u8; 16], spec: u32) -> u64 {
    let mut sum: u64 = 0;
    let mut pool_seen: bool = false;
    let mut i: u32 = 0;
    while (i < ATTR_ROWS) {
        if ((specs[(i) as usize] == spec) && first_of_id(specs, authors, flags, i)) {
            let c: u64 = credited_to(authors[(i) as usize], flags[(i) as usize]);
            if (c == POOL_ID) {
                pool_seen = true;
            }
            sum = (sum + weight_of(specs, authors, lines, tests, flags, spec, c));
        }
        i = (i + 1);
    }
    if (pool_seen == false) {
        sum = (sum + weight_of(specs, authors, lines, tests, flags, spec, POOL_ID));
    }
    return sum;
}

