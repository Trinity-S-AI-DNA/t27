// SPDX-License-Identifier: Apache-2.0
; specs/ci/heavy_skip.t27 -- may the heavy CI jobs be skipped for this change? CI speed request of 2026-10-20,
; epic gHashTag/t27#8095 (rebuild only what is not yet verified).
; --
; What already exists and is NOT restated here:
; - specs/ci/affected.t27 picks WHICH specs a change touches and reads the same buffer this file reads:
;   `git diff --name-status <base>...<head>` lines ("X\tpath" or "R100\told\tnew"). path_class() there is the
;   one classification of a path (seed, prose, seal, everything else); this file adds only the question the
;   heavy jobs ask. The `--graph` and `--corpus` markers are not needed here, and a buffer that carries them
;   is read up to the first marker.
; - The heavy jobs: Corpus ratchet (.github/workflows/corpus-ratchet.yml), t27b-native-ratchet
;   (t27b-native.yml) and fpga-bitstream (fpga-build.yml). They already carry `paths:` filters on some
;   triggers; a filter is a list of globs written by hand in each workflow. This is one rule, tested.
; --
; The rule (decision, fail closed):
; - SKIP only when EVERY changed path is prose: a Markdown file anywhere, or a .md/.txt file under specs/.
;   A prose file moves no verdict (affected.t27, measured #7527).
; - RUN when any changed path is
;     a compiler source (bootstrap/, cli/, Cargo.toml, Cargo.lock, build.rs)      R_COMPILER
;     a .t27 or .tri spec                                                         R_SPEC
;     a seal (.trinity/seals/)                                                    R_SEAL
;     anything else: workflows, tools, scripts, fpga/, gen/, ledgers, data       R_OTHER
;     a line that cannot be read, a status letter other than A C D M R T, a
;     quoted path, or an empty change                                             R_UNREADABLE
;   A skip needs a positive proof that nothing a heavy job reads has moved; absence of a reason to run is
;   not a reason to skip. The reason printed is the worst one (the highest code), so the same change always
;   names the same reason.
; - "All seals unchanged" is the R_SEAL line: a seal in the diff always runs the heavy jobs. A seal that only
;   moved because of a compiler bump (seal_kinds.t27 ACT_REGENERATE) is a seal in the diff.
; --
; Glue (thin): one workflow step builds the diff buffer, includes gen/c/ci/heavy_skip.c, prints the reason to
; the step summary and sets `skip=true|false` as a step output; each heavy job's steps carry `if:` on it. A
; skipped REQUIRED job must still report success, so the job is skipped by its STEPS, never by `if:` on the
; job (a skipped job's status context is not reported and the pull request goes BLOCKED with every visible
; check green, #2191). Gate and workflow files are owner-labelled: the patch ships beside this file and is not
; applied by the author.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CiHeavySkip;

use ci::affected;
use policy::own_language;

/// heavy_decision() answers.
pub const HEAVY_RUN : u8 = 0;
pub const HEAVY_SKIP : u8 = 1;

/// Why. A higher code is a worse reason; R_PROSE is the only one that skips.
pub const R_PROSE : u8 = 0;
pub const R_SEAL : u8 = 1;
pub const R_SPEC : u8 = 2;
pub const R_COMPILER : u8 = 3;
pub const R_OTHER : u8 = 4;
pub const R_UNREADABLE : u8 = 5;

/// Compiler source roots and files. A list is comma separated and ends with '$' (ci/affected.t27).
pub const COMPILER_ROOTS : str = "bootstrap/,cli/,Cargo.toml,Cargo.lock,build.rs,$";

/// Why the path s[from..to] asks for the heavy jobs, or R_PROSE when it does not.
pub fn path_reason(s: []const u8, from: usize, to: usize) -> u8 {
    const c : u8 = path_class(s, from, to);
    if (c == C_ALL_UNREADABLE) { return R_UNREADABLE; }
    if (own_language::has_prefix(COMPILER_ROOTS, s, from, to)) { return R_COMPILER; }
    if (c == C_SEED) { return R_SPEC; }
    if (own_language::has_prefix(SEALS_ROOT, s, from, to)) { return R_SEAL; }
    if (c == C_NOTHING) { return R_PROSE; }
    return R_OTHER;
}

/// The worse reason of one diff line buf[s..t] (a rename or copy has two paths).
pub fn line_reason(buf: []const u8, s: usize, t: usize) -> u8 {
    // diff_class() is C_ALL_UNREADABLE for a status letter outside ACDMRT, a line without a tab and a quoted
    // path: the one reading of a diff line, not a second copy of its tables.
    if (diff_class(buf, s, t) == C_ALL_UNREADABLE) { return R_UNREADABLE; }
    const p1 : usize = first_tab(buf, s, t);
    const p2 : usize = last_tab(buf, s, t);
    var r : u8 = path_reason(buf, p2 + 1, t);
    if (p2 > p1) {
        const old : u8 = path_reason(buf, p1 + 1, p2);
        if (old > r) { r = old; }
    }
    return r;
}

/// The worst reason over buf[0..n], read up to the first `--` marker line. An empty change is R_UNREADABLE.
pub fn heavy_reason(buf: []const u8, n: usize) -> u8 {
    const g : usize = marker_at(buf, n, 0, MARK_GRAPH);
    var worst : u8 = R_PROSE;
    var lines : u32 = 0;
    var s : usize = 0;
    while (s < g) {
        const e : usize = line_end(buf, s, g);
        const t : usize = text_end(buf, s, e);
        if (t > s) {
            lines += 1;
            const r : u8 = line_reason(buf, s, t);
            if (r > worst) { worst = r; }
        }
        s = e + 1;
    }
    if (lines == 0) { return R_UNREADABLE; }
    return worst;
}

/// SKIP only for a change that is entirely prose.
pub fn heavy_decision(buf: []const u8, n: usize) -> u8 {
    if (heavy_reason(buf, n) == R_PROSE) { return HEAVY_SKIP; }
    return HEAVY_RUN;
}

test a_documentation_change_skips_the_heavy_jobs {
    assert heavy_decision("M\tREADME.md\nA\tdocs/blog/post.md\nM\tspecs/ci/NOTES.txt\n", 53) == HEAVY_SKIP;
    assert heavy_reason("M\tREADME.md\n", 12) == R_PROSE;
}

test negative_control_a_spec_a_compiler_file_or_a_seal_runs_them {
    assert heavy_decision("M\tspecs/ci/affected.t27\n", 24) == HEAVY_RUN;
    assert heavy_reason("M\tspecs/ci/affected.t27\n", 24) == R_SPEC;
    assert heavy_reason("M\tbootstrap/src/main.rs\n", 24) == R_COMPILER;
    assert heavy_reason("M\tcli/t27b/src/lower.rs\n", 24) == R_COMPILER;
    assert heavy_reason("M\tCargo.lock\n", 13) == R_COMPILER;
    assert heavy_reason("M\t.trinity/seals/a_B.json\n", 26) == R_SEAL;
    assert heavy_decision("M\t.trinity/seals/a_B.json\n", 26) == HEAVY_RUN;
}

test one_non_prose_file_among_prose_runs_them {
    assert heavy_decision("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == HEAVY_RUN;
    assert heavy_reason("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == R_OTHER;
    assert heavy_reason("M\t.github/workflows/ci.yml\n", 27) == R_OTHER;
    assert heavy_reason("M\tfpga/top.v\n", 13) == R_OTHER;
}

test the_worst_reason_is_the_one_named {
    assert heavy_reason("M\tspecs/a.t27\nM\tbootstrap/src/x.rs\nM\tdocs/a.md\n", 47) == R_COMPILER;
    assert heavy_reason("M\t.trinity/seals/a_B.json\nM\tspecs/a.t27\n", 40) == R_SPEC;
}

test a_rename_is_judged_by_both_paths {
    // a doc renamed into a spec runs; a spec renamed to a doc also ran (the old path was a spec)
    assert heavy_decision("R100\tdocs/a.md\tspecs/a.t27\n", 27) == HEAVY_RUN;
    assert heavy_decision("R100\tspecs/a.t27\tdocs/a.md\n", 27) == HEAVY_RUN;
    assert heavy_decision("R100\tdocs/a.md\tdocs/b.md\n", 25) == HEAVY_SKIP;
}

test negative_control_unreadable_input_runs_them {
    assert heavy_decision("", 0) == HEAVY_RUN;
    assert heavy_reason("", 0) == R_UNREADABLE;
    assert heavy_decision("Q\tdocs/a.md\n", 12) == HEAVY_RUN;
    assert heavy_decision("M docs/a.md\n", 12) == HEAVY_RUN;
    assert heavy_decision("M\t\"docs/a b.md\"\n", 16) == HEAVY_RUN;
}

test the_markers_end_the_change_list {
    assert heavy_decision("M\tdocs/a.md\n--graph\nx\ty\n--corpus\nspecs/a.t27\n", 45) == HEAVY_SKIP;
}
