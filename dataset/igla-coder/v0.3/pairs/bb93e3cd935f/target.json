void test_a_documentation_change_skips_the_heavy_jobs(void) {
    assert((heavy_decision("M\tREADME.md\nA\tdocs/blog/post.md\nM\tspecs/ci/NOTES.txt\n", 53) == HEAVY_SKIP));
    assert((heavy_reason("M\tREADME.md\n", 12) == R_PROSE));
}

void test_negative_control_a_spec_a_compiler_file_or_a_seal_runs_them(void) {
    assert((heavy_decision("M\tspecs/ci/affected.t27\n", 24) == HEAVY_RUN));
    assert((heavy_reason("M\tspecs/ci/affected.t27\n", 24) == R_SPEC));
    assert((heavy_reason("M\tbootstrap/src/main.rs\n", 24) == R_COMPILER));
    assert((heavy_reason("M\tcli/t27b/src/lower.rs\n", 24) == R_COMPILER));
    assert((heavy_reason("M\tCargo.lock\n", 13) == R_COMPILER));
    assert((heavy_reason("M\t.trinity/seals/a_B.json\n", 26) == R_SEAL));
    assert((heavy_decision("M\t.trinity/seals/a_B.json\n", 26) == HEAVY_RUN));
}

void test_one_non_prose_file_among_prose_runs_them(void) {
    assert((heavy_decision("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == HEAVY_RUN));
    assert((heavy_reason("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == R_OTHER));
    assert((heavy_reason("M\t.github/workflows/ci.yml\n", 27) == R_OTHER));
    assert((heavy_reason("M\tfpga/top.v\n", 13) == R_OTHER));
}

void test_the_worst_reason_is_the_one_named(void) {
    assert((heavy_reason("M\tspecs/a.t27\nM\tbootstrap/src/x.rs\nM\tdocs/a.md\n", 47) == R_COMPILER));
    assert((heavy_reason("M\t.trinity/seals/a_B.json\nM\tspecs/a.t27\n", 40) == R_SPEC));
}

void test_a_rename_is_judged_by_both_paths(void) {
    assert((heavy_decision("R100\tdocs/a.md\tspecs/a.t27\n", 27) == HEAVY_RUN));
    assert((heavy_decision("R100\tspecs/a.t27\tdocs/a.md\n", 27) == HEAVY_RUN));
    assert((heavy_decision("R100\tdocs/a.md\tdocs/b.md\n", 25) == HEAVY_SKIP));
}

void test_negative_control_unreadable_input_runs_them(void) {
    assert((heavy_decision("", 0) == HEAVY_RUN));
    assert((heavy_reason("", 0) == R_UNREADABLE));
    assert((heavy_decision("Q\tdocs/a.md\n", 12) == HEAVY_RUN));
    assert((heavy_decision("M docs/a.md\n", 12) == HEAVY_RUN));
    assert((heavy_decision("M\t\"docs/a b.md\"\n", 16) == HEAVY_RUN));
}

void test_the_markers_end_the_change_list(void) {
    assert((heavy_decision("M\tdocs/a.md\n--graph\nx\ty\n--corpus\nspecs/a.t27\n", 45) == HEAVY_SKIP));
}


