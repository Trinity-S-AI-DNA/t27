// SPDX-License-Identifier: Apache-2.0
; specs/tri/mutate/answer.t27 -- how `tri mutate spec` reads a failed zig compile, and which answers it asks again (#12539)
; `tri mutate spec` (cli/tri/src/mutate.rs) lowers each mutant and compiles it. A compile that fails gives
; the mutant its fate from the first `error:` line of zig's stderr. Until now every error that was neither
; a branch-quota stop nor a comptime-called invariant was filed as UNVIABLE, and an unviable mutant is
; counted nowhere in the verdict.
; Logged 2026-10-26, gate run of #12512 (868 mutants of specs/analog/sar_comparator.t27, --jobs 2
; --timeout 45): 35 unviable, two more than the 33 of the first run, and the first run had counted those
; two as killed. Both extra mutants (line 699, swap-arith) answered with a zig driver error that names
; no source line: `zig: error: failed to open <zig cache>/o/<hash>/libcompiler_rt.a: FileNotFound` and
; `zig: error: failed to parse TBD file: NotLibStub`. A cache cleaner had removed the whole zig global
; cache in the middle of that run; the link is inferred from the time and the message, not proven. A
; damaged cache silently dropped two mutants from the verdict, and a survivor that met it would have hidden.
; The rule here is the whole of the reading, as a pure function of zig's stderr text. Five answers:
;   ANSWER_HANG       -- `error: evaluation exceeded`: comptime ran out of branch quota while an invariant
;                        was evaluated, the mutant's own endless loop. A hang, as before.
;   ANSWER_INVARIANT  -- `note: called at comptime here`: an invariant the mutant breaks fails the compile.
;                        A check noticed it: killed, as before. Both tests are on the whole text, so they
;                        come first, as in the Rust that this file replaces.
;   ANSWER_REFUSAL    -- the first `error:` line is `not yet implemented`: the emitter's refusal of a
;                        ret-default mutant (a zig @compileError). Zig prints it with a source location, so
;                        it is tested BEFORE the located case.
;   ANSWER_LOCATED    -- the first `error:` line carries `path:line:column: ` in front of it: zig found a
;                        fault in the lowered source, a mutant that does not type. Deterministic.
;   ANSWER_OTHER      -- everything else, including a text with no `error:` line at all: a driver or cache
;                        error that says nothing about the mutant. Only this answer is asked again.
; The first `error:` line decides, found as the first "error: " in the text, as the driver's old
; first_error did. The retry, the printed first answer and the counts are the driver's; this file is
; the decision: which answers are retried (retry_answer), how the unviable count splits into settled
; ones (refusals and located errors, plus mutants `t27c gen` refused) and the other answers that came
; twice (settled_unviable), and the tag the driver puts on such a mutant (REPEATED).
; The classes are u8 so that a caller matches on constants; a class is the answer to ONE stderr text.
; Not measured here: how often a cache error happens. The two recorded answers are the only evidence.
; Every test text below is zig's wording cut from a logged run or from the driver's own unit test
; (zig 0.16.0), with paths made neutral. ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriMutateAnswer;

use lab::text::lab_has_lit;
use lab::text::lab_lit_at;

pub const ANSWER_HANG : u8 = 1;
pub const ANSWER_INVARIANT : u8 = 2;
pub const ANSWER_REFUSAL : u8 = 3;
pub const ANSWER_LOCATED : u8 = 4;
pub const ANSWER_OTHER : u8 = 5;

// The tag the driver appends to the reason of a mutant whose retry gave an answer to retry again: it stays
// unviable, and this tag is how the report lists it under its own heading.
pub const REPEATED : str = " (the same kind of answer after a retry)";

/// The offset of the first "error: " in the text, or t.len when there is none.
pub fn error_at(t: string) -> usize {
    var k : usize = 0;
    while (k < t.len) {
        if (lab_lit_at(t, k, t.len, "error: ")) { return k; }
        k = k + 1;
    }
    return t.len;
}

/// Where the run of ASCII digits that ends just before `end` starts; `end` itself when none ends there.
pub fn digits_start(t: string, end: usize) -> usize {
    var k : usize = end;
    while (k > 0 and t[k - 1] >= 48 and t[k - 1] <= 57) {
        k = k - 1;
    }
    return k;
}

/// Does the "error: " at offset e have `path:line:column: ` in front of it, with a path, a line and a
/// column? Zig prints that for a fault in a source file; its driver errors have no such prefix.
pub fn is_located(t: string, e: usize) -> bool {
    if (e < 7 or e > t.len) { return false; }
    if (t[e - 1] != 32 or t[e - 2] != 58) { return false; }
    const col_from : usize = digits_start(t, e - 2);
    if (col_from == e - 2 or col_from == 0) { return false; }
    if (t[col_from - 1] != 58) { return false; }
    const line_from : usize = digits_start(t, col_from - 1);
    return line_from < col_from - 1 and line_from > 0;
}

/// The answer in the stderr text of one failed compile: one of the five ANSWER_ classes.
pub fn answer_of(t: string) -> u8 {
    if (lab_has_lit(t, 0, t.len, "error: evaluation exceeded")) { return ANSWER_HANG; }
    if (lab_has_lit(t, 0, t.len, "note: called at comptime here")) { return ANSWER_INVARIANT; }
    const e : usize = error_at(t);
    if (e >= t.len) { return ANSWER_OTHER; }
    if (lab_lit_at(t, e, t.len, "error: not yet implemented")) { return ANSWER_REFUSAL; }
    if (is_located(t, e)) { return ANSWER_LOCATED; }
    return ANSWER_OTHER;
}

/// Is this answer asked once more before it is given a fate? Only ANSWER_OTHER: it says nothing about the mutant.
pub fn retry_answer(class: u8) -> bool {
    return class == ANSWER_OTHER;
}

/// The unviable mutants that are settled -- a refusal, a located error, or a spec `t27c gen` refused --
/// given all unviable ones and those whose retry repeated an other answer. Never negative.
pub fn settled_unviable(unviable: u32, repeated: u32) -> u32 {
    if (repeated >= unviable) { return 0; }
    return unviable - repeated;
}

invariant the_five_answers_are_1_to_5_and_only_other_is_retried {
    assert ANSWER_HANG == 1 and ANSWER_INVARIANT == 2 and ANSWER_REFUSAL == 3 and ANSWER_LOCATED == 4 and ANSWER_OTHER == 5;
    assert retry_answer(ANSWER_OTHER) == true and retry_answer(ANSWER_REFUSAL) == false and retry_answer(ANSWER_LOCATED) == false;
    assert retry_answer(ANSWER_HANG) == false and retry_answer(ANSWER_INVARIANT) == false;
}

// Scenario: the first recorded cache answer, as the Unviable reason printed it (with zig's own "zig: "
// in front) and as zig prints it. No source location, not a refusal: asked again.
test a_missing_cache_file_is_asked_again {
    var t : string = "zig: error: failed to open /zig-cache/o/0f3a9c/libcompiler_rt.a: FileNotFound\n";
    assert answer_of(t) == ANSWER_OTHER;
    assert retry_answer(answer_of(t)) == true;
    t = "error: failed to open /zig-cache/o/0f3a9c/libcompiler_rt.a: FileNotFound\n";
    assert answer_of(t) == ANSWER_OTHER;
}

// Scenario: the second recorded cache answer.
test an_unreadable_tbd_file_is_asked_again {
    var t : string = "zig: error: failed to parse TBD file: NotLibStub\n";
    assert answer_of(t) == ANSWER_OTHER;
    assert retry_answer(answer_of(t)) == true;
}

// Scenario: a compile that failed with no `error:` line at all says nothing about the mutant either.
test a_failed_compile_with_no_error_line_is_asked_again {
    assert answer_of("") == ANSWER_OTHER;
    assert answer_of("warning: something\n") == ANSWER_OTHER;
}

// Scenario: the emitter's refusal of a ret-default mutant, with the source location zig prints, and bare.
// Settled: not asked again.
test not_yet_implemented_is_a_refusal_and_is_not_asked_again {
    var t : string = "/work/m3.zig:38:5: error: not yet implemented\n    @compileError(msg);\n    ^~~~~\n";
    assert answer_of(t) == ANSWER_REFUSAL;
    assert retry_answer(answer_of(t)) == false;
    t = "error: not yet implemented\n";
    assert answer_of(t) == ANSWER_REFUSAL;
}

// Scenario: zig 0.16.0 on a mutant that does not type (the driver's own unit test text, 2026-10-06).
// Located: the mutant's own fault, settled.
test a_located_type_error_is_not_asked_again {
    var t : string = "/tmp/m/ty.zig:24:12: error: expected type 'usize', found 'bool'\n/tmp/m/ty.zig:18:27: note: function return type declared here\n";
    assert answer_of(t) == ANSWER_LOCATED;
    assert retry_answer(answer_of(t)) == false;
}

// Scenario: the first `error:` line decides. A located error first, a cache error after it: located.
// A cache error first, a located one after it: other, asked again.
test the_first_error_line_decides {
    var t : string = "/m.zig:1:1: error: boom\nerror: failed to open x: FileNotFound\n";
    assert answer_of(t) == ANSWER_LOCATED;
    t = "error: failed to open x: FileNotFound\n/m.zig:1:1: error: boom\n";
    assert answer_of(t) == ANSWER_OTHER;
}

// Scenario: an invariant the mutant breaks fails the compile, and so does a safety check inside one:
// both carry the comptime note (zig 0.16.0, 2026-10-06). A check noticed; not asked again.
test an_invariant_the_mutant_breaks_is_a_check_and_is_not_asked_again {
    var t : string = "/tmp/m/inv.zig:8:9: error: assertion failed\n/tmp/m/inv.zig:34:47: note: called at comptime here\n";
    assert answer_of(t) == ANSWER_INVARIANT;
    assert retry_answer(answer_of(t)) == false;
    t = "/tmp/m/ovf.zig:21:11: error: overflow of integer type 'usize' with value '-1'\n/tmp/m/ovf.zig:35:19: note: called at comptime here\n";
    assert answer_of(t) == ANSWER_INVARIANT;
}

// Scenario: an endless loop inside an invariant runs out of branch quota; the comptime note is there
// too, and the quota wins: a hang.
test the_branch_quota_is_a_hang_though_the_comptime_note_is_there {
    var t : string = "/tmp/m/loop.zig:21:5: error: evaluation exceeded 1000 backwards branches\n/tmp/m/loop.zig:21:5: note: use @setEvalBranchQuota() to raise the branch limit from 1000\n/tmp/m/loop.zig:33:19: note: called at comptime here\n";
    assert answer_of(t) == ANSWER_HANG;
    assert retry_answer(answer_of(t)) == false;
}

// Scenario: what a location in front of "error: " is. Path, line and column are all needed; zig's driver
// errors have none; a number alone is not a path.
test a_location_has_a_path_a_line_and_a_column {
    var t : string = "a:1:1: error: x";
    assert is_located(t, error_at(t)) == true;
    t = "error: x";
    assert is_located(t, error_at(t)) == false;
    t = "zig: error: x";
    assert is_located(t, error_at(t)) == false;
    t = "f.zig:3: error: x";
    assert is_located(t, error_at(t)) == false;
    t = "123456: error: x";
    assert is_located(t, error_at(t)) == false;
}

// Scenario: the digit scan stops at a non-digit and at the start of the text.
test digits_start_finds_the_start_of_a_digit_run {
    assert digits_start("ab12", 4) == 2;
    assert digits_start("ab12", 2) == 2;
    assert digits_start("1234", 4) == 0;
    assert digits_start("", 0) == 0;
}

// Scenario: the split of the unviable count in the summary. The logged run: 35 unviable, the two cache
// answers repeated, 33 settled. More repeats than unviable cannot happen; it reads 0, not a wrap.
test the_unviable_count_splits_into_settled_and_repeated {
    assert settled_unviable(35, 2) == 33;
    assert settled_unviable(35, 0) == 35;
    assert settled_unviable(2, 2) == 0;
    assert settled_unviable(2, 5) == 0;
    assert settled_unviable(0, 0) == 0;
}
