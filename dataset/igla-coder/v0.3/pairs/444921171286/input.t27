// SPDX-License-Identifier: Apache-2.0
; specs/tri/trigit/verbs.t27 -- `trigit <verb>`: the one command per act of our own git (#11601, epic #11385 items 24-26)
; Owner, 2026-10-22: trigit is the standard (AGENTS.md), and the standard needs verbs. This file has NO rule of its own
; about what a claim, a beat or a verdict IS: every act is already ruled elsewhere, and this file adds only the words of
; the verb, the argument vector the act runs as (no shell, same as golden_land), and the words a refused verb prints.
; - THE HOST (cli/tri/src/main.rs, cmd_trigit) is glue: it asks host_action for the class, runs one argv vector with no
;   shell (A_ARGV), runs commit then push (A_BEAT), prints the screen (A_STATUS), shows a note (A_VERDICT), delegates
;   land to cmd_golden (A_GOLDEN), reads or appends the ledger (A_HANDOFF), or prints a refusal (A_REFUSE / A_USAGE).
;   Same shape as cmd_golden over golden_land.
; - THE VERBS (item 24): claim | hold | release | beat | send | recv | join | board | verdict | status | land |
;   handoff.
; - HANDOFF (#12286), the twelfth verb: what a record MEANS and the law of its states are
;   specs/tri/handoff/handoff.t27, the row in the T27OS's own words is specs/t27os/handoff_view.t27, and the
;   ledger is docs/coordination/HANDOFF.md. This file owns only the verb's words -- where the ledger is, what
;   the screen says, the two refusals -- and the host appends exactly what the spec built, judged against the
;   ledger it just read: may_write of that task's last state, never the host's opinion.
; - DRY (recorded before writing, 2026-10-22): `t27c dupes --name` for put_u32 found 3 hosts (ml/file_io_contract,
;   verified/verdict_notes, tri/t27b/macho) and put_dec 6 -- none mounted in Rust today, so the digit write here is
;   t27os::lanes_view::lv_put_num, which devices.t27 itself uses as its append (line `w = lv_put_num(out, w, since)`).
;   The G|key|value reader is devices' own dv_g; the feed path joins devices' DV_DIR and DV_FILE; `git grep trigit`
;   over specs/ found consumers only (specs/t27os/*, verdict_notes) and no verb host. Statusbar's trigit_text is NOT
;   used: its module closure does not compile under the gen-Rust backend (filed as a defect, see limits), and its line
;   is a statusbar slot; this CLI line is built from dv_g keys instead, and no wording is copied from it.
; - HONEST LIMITS. (1) Six verbs wait: hold, release, send, recv, join wait on region holds, mailboxes and the event
;   log becoming refs (#11602), board waits on board refs (epic #11385 item 12); they print that reason and touch
;   nothing. (2) Claims and beats still push to `origin` until the own remote lands (#11603). (3) The MCP twins
;   (item 25) are specs/t27mcp/tool_schema.t27, tracked by #11601, not here. (4) `verdict` SHOWS the note for a key
;   and does not judge it: the judge is specs/verified/verdict_notes.t27, whose gen-Rust output does not compile
;   today (defect filed with a minimal repro); judgement lands when that host does. (5) Finding the key of a spec is
;   verdict_notes' own business; this verb takes the key it is given.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriTrigitVerbs;

use t27os::devices::dv_payload_ok;
use t27os::devices::dv_count;
use t27os::devices::dv_g;
use t27os::devices::dv_num;
use t27os::devices::dv_line_end;
use t27os::devices::dv_nth;
use t27os::devices::DV_DIR;
use t27os::devices::DV_FILE;
use t27os::devices::DV_NM;
use t27os::devices::DV_SAMPLE;
use t27os::lanes_view::lv_put_num;
use tri::handoff::handoff::LEDGER;
use tri::handoff::handoff::create_record;
use tri::handoff::handoff::find_last_state;
use tri::handoff::handoff::may_write;
use tri::handoff::handoff::state_code;
use tri::handoff::handoff::state_name;
use tri::handoff::handoff::record_is_well_formed;
use tri::handoff::handoff::state_field_code;
use tri::handoff::handoff::put_span;
use tri::handoff::handoff::put_lit;
use t27os::handoff_view::hov_row;

; --- 1. The verbs: one name, one code, one host action ---------------------------------------------------

pub const TV_UNKNOWN : u8 = 0;
pub const TV_CLAIM : u8 = 1;
pub const TV_HOLD : u8 = 2;
pub const TV_RELEASE : u8 = 3;
pub const TV_BEAT : u8 = 4;
pub const TV_SEND : u8 = 5;
pub const TV_RECV : u8 = 6;
pub const TV_JOIN : u8 = 7;
pub const TV_BOARD : u8 = 8;
pub const TV_VERDICT : u8 = 9;
pub const TV_STATUS : u8 = 10;
pub const TV_LAND : u8 = 11;
pub const TV_HANDOFF : u8 = 12;
pub const TV_KINDS : u8 = 13;
pub const TV_NAMES : [13]str = ["unknown", "claim", "hold", "release", "beat", "send", "recv", "join", "board", "verdict", "status", "land", "handoff"];

/// Host action classes. A_REFUSE and A_USAGE print words and run nothing; every other class runs what the spec builds.
pub const A_USAGE : u8 = 0;
pub const A_ARGV : u8 = 1;
pub const A_BEAT : u8 = 2;
pub const A_STATUS : u8 = 3;
pub const A_VERDICT : u8 = 4;
pub const A_GOLDEN : u8 = 5;
pub const A_REFUSE : u8 = 6;
pub const A_HANDOFF : u8 = 7;

/// The verb of a name, or TV_UNKNOWN. Empty names and junk are unknown; the verb list is closed (item 24).
pub fn verb_of(a: string) -> u8 {
    var i : u8 = 1;
    while (i < TV_KINDS) {
        if (TV_NAMES[i] == a) { return i; }
        i = i + 1;
    }
    return TV_UNKNOWN;
}

/// The name of a code; the code of any other value is unknown's name.
pub fn verb_name(v: u8) -> str {
    if (v >= TV_KINDS) { return TV_NAMES[0]; }
    return TV_NAMES[v];
}

/// What the host does for a verb: never nothing. Unknown and the six waiters run no command.
pub fn host_action(v: u8) -> u8 {
    if (v == TV_CLAIM) { return A_ARGV; }
    if (v == TV_BEAT) { return A_BEAT; }
    if (v == TV_STATUS) { return A_STATUS; }
    if (v == TV_VERDICT) { return A_VERDICT; }
    if (v == TV_LAND) { return A_GOLDEN; }
    if (v == TV_HANDOFF) { return A_HANDOFF; }
    if (v == TV_UNKNOWN) { return A_USAGE; }
    return A_REFUSE;
}

; --- 2. The six that wait, and the reason each prints ------------------------------------------------------

; hold, release, send, recv, join wait on #11602 (holds, mailboxes, event log as refs); board waits on board refs
; (epic #11385 item 12), which no ref family carries yet.
pub const WAIT_REFS : str = "#11602";
pub const WAIT_BOARD : str = "epic #11385 item 12 (board refs)";

/// True for the six verbs that touch nothing until their refs exist.
pub fn waits(v: u8) -> bool {
    if (v == TV_HOLD) { return true; }
    if (v == TV_RELEASE) { return true; }
    if (v == TV_SEND) { return true; }
    if (v == TV_RECV) { return true; }
    if (v == TV_JOIN) { return true; }
    if (v == TV_BOARD) { return true; }
    return false;
}

/// The reason a waiting verb prints, naming its dependency; the other verbs wait on nothing.
pub fn wait_note(v: u8) -> str {
    if (v == TV_BOARD) { return WAIT_BOARD; }
    return WAIT_REFS;
}

; --- 3. claim: exactly one winner on refs/swarm/claims/<n> ---------------------------------------------------
; Epic item 6: the ref is created with old=000, so of two racers git accepts exactly one. The claimer's head sha is
; the new value; the zero old value is the race. Push target is origin until #11603 moves the fabric to the own remote.

pub const CLAIM_PREF : str = "refs/swarm/claims/";
pub const ZERO40 : str = "0000000000000000000000000000000000000000";

pub fn is_hex(t: []const u8) -> bool {
    if (t.len < 7) { return false; }
    var i : usize = 0;
    while (i < t.len) {
        let c : u8 = t[i];
        let h : bool = ((c >= '0') and (c <= '9')) or ((c >= 'a') and (c <= 'f'));
        if (h == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The bytes of s laid into out, up to cap. The loop is handoff.t27's put_lit, the one copy (#12419): this file
; already reads that spec, so the writer lives there and not twice.
pub fn put_s(out: []u8, w: usize, cap: usize, s: []const u8) -> usize {
    return put_lit(out, w, cap, s);
}

/// argv for `trigit claim <n> --at <sha>`: git update-ref refs/swarm/claims/<n> <sha> 000..0, one word per line
; (the host splits lines into the argument vector, as cmd_golden does). Returns 0 when the sha is not a hex object id
; or the issue is 0: a refused claim runs nothing and prints claim_refusal.
pub fn claim_argv(out: []u8, cap: usize, issue: u64, sha: []const u8) -> usize {
    if ((issue == 0) or (is_hex(sha) == false)) { return 0; }
    var w : usize = 0;
    w = put_s(out, w, cap, "git\n");
    w = put_s(out, w, cap, "update-ref\n");
    w = put_s(out, w, cap, CLAIM_PREF);
    w = lv_put_num(out, w, issue as u32);
    w = put_s(out, w, cap, "\n");
    w = put_s(out, w, cap, sha);
    w = put_s(out, w, cap, "\n");
    w = put_s(out, w, cap, ZERO40);
    w = put_s(out, w, cap, "\n");
    return w;
}

/// Why a refused claim ran nothing: issue 0 is no issue, and a claim needs the claimer's own head object id.
pub fn claim_refusal(issue: u64, sha: []const u8) -> str {
    if (issue == 0) { return "claim refused: issue 0 is no issue"; }
    return "claim refused: sha must be a hex object id of the claimer's head";
}

; --- 4. beat: the same heartbeat devices.t27 publishes, as an argument vector ---------------------------------
; devices.t27 DV_PUB_C writes an empty-tree commit with the fixed identity t27os and force-pushes it to
; refs/swarm/alive/<host>. The empty tree has one well-known object id, so no mktree step is needed: commit-tree then
; push. The identity (GIT_AUTHOR_NAME=t27os, GIT_COMMITTER_EMAIL=t27os@localhost) is set by the host around the commit
; step; the message MUST satisfy devices' own payload rule, which the test below proves by calling dv_payload_ok.

pub const EMPTY_TREE : str = "4b825dc642cb6eb9a060e54bf8d69288fbee4904";
pub const ALIVE_PREF : str = "refs/swarm/alive/";

/// The hb1 payload of a beat, ending in lanes=- (this verb knows no lanes; the feed job fills them).
pub fn beat_msg(out: []u8, cap: usize, host: []const u8, build: u32, ver: []const u8, tc: []const u8) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "hb1 host=");
    w = put_s(out, w, cap, host);
    w = put_s(out, w, cap, " build=");
    w = lv_put_num(out, w, build);
    w = put_s(out, w, cap, " ver=");
    w = put_s(out, w, cap, ver);
    w = put_s(out, w, cap, " tc=");
    w = put_s(out, w, cap, tc);
    w = put_s(out, w, cap, " cpu=- ram=- disk=- lanes=-");
    return w;
}

/// argv step 1 of a beat: git commit-tree <empty tree> -m <msg> (identity from the host environment).
pub fn beat_commit_argv(out: []u8, cap: usize, msg: []const u8) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "git\n");
    w = put_s(out, w, cap, "commit-tree\n");
    w = put_s(out, w, cap, EMPTY_TREE);
    w = put_s(out, w, cap, "\n-m\n");
    w = put_s(out, w, cap, msg);
    w = put_s(out, w, cap, "\n");
    return w;
}

/// argv step 2 of a beat: git push -q origin <commit>:refs/swarm/alive/<host> (the leading + is git's per-ref force).
pub fn beat_push_argv(out: []u8, cap: usize, commit: []const u8, host: []const u8) -> usize {
    if (is_hex(commit) == false) { return 0; }
    var w : usize = 0;
    w = put_s(out, w, cap, "git\n");
    w = put_s(out, w, cap, "push\n");
    w = put_s(out, w, cap, "-q\n");
    w = put_s(out, w, cap, "origin\n+");
    w = put_s(out, w, cap, commit);
    w = put_s(out, w, cap, ":");
    w = put_s(out, w, cap, ALIVE_PREF);
    w = put_s(out, w, cap, host);
    w = put_s(out, w, cap, "\n");
    return w;
}

; --- 5. status: one screen from the feed, numbers from devices ------------------------------------------------
; The feed kinds are devices': A hosts, C claims, B lanes, G golden numbers, M master commits. Every number here is
; read by devices' own dv_g / dv_count; this file only lays the four keys and the claim count on one line. The
; statusbar's trigit_text line is a different slot (a statusbar cell) and is not copied (see DRY above).

pub fn put_s_at(out: []u8, w: usize, cap: usize, s: []const u8) -> usize {
    return put_s(out, w, cap, s);
}

/// One `key v` pair; a missing G line (DV_NM) prints `-`, never a fake 0.
pub fn put_g(out: []u8, w: usize, cap: usize, f: []const u8, key: string) -> usize {
    let v : u32 = dv_g(f, key);
    w = put_s_at(out, w, cap, key);
    w = put_s_at(out, w, cap, " ");
    if (v == DV_NM) { return put_s_at(out, w, cap, "-"); }
    return lv_put_num(out, w, v);
}

/// The trigit status line from the feed: `trigit status: queue N unpushed U since M claims C`.
pub fn status_text(f: []const u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "trigit status: ");
    w = put_g(out, w, cap, f, "queue");
    w = put_s(out, w, cap, " ");
    w = put_g(out, w, cap, f, "unpushed");
    w = put_s(out, w, cap, " ");
    w = put_g(out, w, cap, f, "since");
    w = put_s(out, w, cap, " claims ");
    w = lv_put_num(out, w, dv_count(f, 67));
    return w;
}

; --- 6. verdict: show the note; judging waits on verdict_notes' Rust host ---------------------------------------
; The note lives in refs/notes/verdicts under its key (the host supplies the key it already has); git notes shows it.
; verdict_result of specs/verified/verdict_notes.t27 judges it -- but that module's gen-Rust output does not compile
; today (defect with minimal repro), so v1 prints the note and names where the judge lives (limit 4 in the header).

pub fn verdict_argv(out: []u8, cap: usize, key: []const u8) -> usize {
    if (key.len == 0) { return 0; }
    var w : usize = 0;
    w = put_s(out, w, cap, "git\n");
    w = put_s(out, w, cap, "notes\n");
    w = put_s(out, w, cap, "--ref=verdicts\n");
    w = put_s(out, w, cap, "show\n");
    w = put_s(out, w, cap, key);
    w = put_s(out, w, cap, "\n");
    return w;
}

/// The word printed after the note: where its judge lives (v1) -- verdict_notes judges when its host compiles.
pub fn verdict_where() -> str {
    return "judged by specs/verified/verdict_notes.t27";
}

; --- 7. The words every run prints -----------------------------------------------------------------------------

/// The usage line for an unknown verb: the closed list, one line.
pub fn usage_text(out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "trigit: unknown verb; one of");
    var i : u8 = 1;
    while (i < TV_KINDS) {
        w = put_s(out, w, cap, " ");
        w = put_s(out, w, cap, verb_name(i));
        i = i + 1;
    }
    return w;
}

/// What a waiting verb prints: its name, the word refused, and the dependency that is not built yet.
pub fn refusal_text(v: u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "trigit ");
    w = put_s(out, w, cap, verb_name(v));
    w = put_s(out, w, cap, ": refused, its refs do not exist yet (see ");
    w = put_s(out, w, cap, wait_note(v));
    w = put_s(out, w, cap, ")");
    return w;
}

/// What claim and beat print after their argument vector ran: the verb, the ref, and the value.
pub fn did_text(v: u8, ref_path: []const u8, val: []const u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, "trigit ");
    w = put_s(out, w, cap, verb_name(v));
    w = put_s(out, w, cap, ": ");
    w = put_s(out, w, cap, ref_path);
    w = put_s(out, w, cap, " -> ");
    w = put_s(out, w, cap, val);
    return w;
}

/// The feed file under a home directory: devices owns the two parts, this only joins them (DRY),
; so `trigit status` reads exactly the file the T27 OS feed job writes.
pub fn feed_path(home: []const u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    w = put_s(out, w, cap, home);
    w = put_s(out, w, cap, DV_DIR);
    w = put_s(out, w, cap, DV_FILE);
    return w;
}

; --- 8. handoff: the ledger one session leaves for the next (#12286) -----------------------------------------
; The record's meaning and the law of its states are specs/tri/handoff/handoff.t27; the row over them in the
; T27OS's own words is specs/t27os/handoff_view.t27; the ledger itself is docs/coordination/HANDOFF.md. This
; file owns only the verb: where the ledger is, what the screen says, and the two refusals. The HOST reads the
; file and appends a line the spec built -- it never decides whether the line may be there: may_write did that,
; against the last record of that same task.

/// Where the ledger lives: handoff.t27 owns the path, the verb answers with it.
pub fn handoff_where() -> str {
    return LEDGER;
}

/// What a record the contract refused says: the five fields, the four state
/// words, the shape of an issue, and that a field never holds one '|'.
pub fn handoff_refusal() -> str {
    return "trigit handoff: refused; a record is agent task state issue note, state one of taken|doing|blocked|done, issue starts #, a field never holds '|'";
}

/// What a move the law refused says: the state machine, named. The host has no
/// words of its own -- this line is the whole explanation of a refusal.
pub fn move_refusal() -> str {
    return "trigit handoff: refused; that task may not move to that state (done is terminal, taken is not done, a repeat is not a move)";
}

/// What `trigit handoff` prints: how many records the ledger holds, the state of
/// the last one, the last up to five records each on its own line, and the T27OS
/// session row of the last record. A ledger with no record says so and stops --
/// an empty screen here would read as a channel that works, which it is not.
pub fn handoff_text(f: []const u8, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    var n : u32 = 0;
    var la : usize = 0;
    var lb : usize = 0;
    var at : usize = 0;
    while (at < f.len) {
        const le : usize = dv_line_end(f, at);
        if (record_is_well_formed(f, at, le)) {
            n = n + 1;
            la = at;
            lb = le;
        }
        at = le + 1;
    }
    w = put_s(out, w, cap, "trigit handoff: records ");
    w = lv_put_num(out, w, n);
    if (n == 0) { return put_s(out, w, cap, " none yet\n"); }
    w = put_s(out, w, cap, " last ");
    w = put_s(out, w, cap, state_name(state_field_code(f, la, lb)));
    w = put_s(out, w, cap, "\n");
    var skip : u32 = 0;
    if (n > 5) { skip = n - 5; }
    var idx : u32 = 0;
    at = 0;
    while (at < f.len) {
        const le : usize = dv_line_end(f, at);
        if (record_is_well_formed(f, at, le)) {
            if (idx >= skip) {
                w = put_span(out, w, cap, f, at, le);
                w = put_s(out, w, cap, "\n");
            }
            idx = idx + 1;
        }
        at = le + 1;
    }
    w = hov_row(f, la, lb, out, w, cap);
    return w;
}

; --- Tests -----------------------------------------------------------------------------------------------------

test every_verb_of_12_is_recognised_and_junk_is_not {
    assert verb_of("claim") == TV_CLAIM;
    assert verb_of("hold") == TV_HOLD;
    assert verb_of("release") == TV_RELEASE;
    assert verb_of("beat") == TV_BEAT;
    assert verb_of("send") == TV_SEND;
    assert verb_of("recv") == TV_RECV;
    assert verb_of("join") == TV_JOIN;
    assert verb_of("board") == TV_BOARD;
    assert verb_of("verdict") == TV_VERDICT;
    assert verb_of("status") == TV_STATUS;
    assert verb_of("land") == TV_LAND;
    assert verb_of("handoff") == TV_HANDOFF;
    assert verb_of("vbn") == TV_UNKNOWN;
    assert verb_of("") == TV_UNKNOWN;
    assert verb_of("Claim") == TV_UNKNOWN;
}

test every_verb_has_exactly_one_host_action_and_the_waiters_run_nothing {
    assert host_action(TV_CLAIM) == A_ARGV;
    assert host_action(TV_BEAT) == A_BEAT;
    assert host_action(TV_STATUS) == A_STATUS;
    assert host_action(TV_VERDICT) == A_VERDICT;
    assert host_action(TV_LAND) == A_GOLDEN;
    assert host_action(TV_HANDOFF) == A_HANDOFF;
    assert host_action(TV_UNKNOWN) == A_USAGE;
    assert host_action(TV_HOLD) == A_REFUSE;
    assert host_action(TV_RELEASE) == A_REFUSE;
    assert host_action(TV_SEND) == A_REFUSE;
    assert host_action(TV_RECV) == A_REFUSE;
    assert host_action(TV_JOIN) == A_REFUSE;
    assert host_action(TV_BOARD) == A_REFUSE;
}

test exactly_the_six_unbuilt_verbs_wait_and_each_names_where {
    var n : u32 = 0;
    var v : u8 = 1;
    while (v < TV_KINDS) {
        if (waits(v)) { n = n + 1; }
        v = v + 1;
    }
    assert n == 6;
    assert waits(TV_CLAIM) == false;
    assert waits(TV_BEAT) == false;
    assert waits(TV_STATUS) == false;
    assert waits(TV_VERDICT) == false;
    assert waits(TV_LAND) == false;
    assert wait_note(TV_BOARD) == WAIT_BOARD;
    assert wait_note(TV_HOLD) == WAIT_REFS;
}

test claim_argv_is_git_update_ref_with_zero_old_and_the_claimer_sha {
    let mut buf : [512]u8 = [0; 512];
    let sha : str = "aeb772f46b1234567890abcdef1234567890abcd";
    let n : usize = claim_argv(buf[0..512], 512, 11601, sha);
    assert n > 0;
    // the same bytes, built from literals independently of claim_argv
    let mut want : [512]u8 = [0; 512];
    let mut k : usize = 0;
    k = put_s(want[0..512], k, 512, "git\nupdate-ref\nrefs/swarm/claims/11601\n");
    k = put_s(want[0..512], k, 512, "aeb772f46b1234567890abcdef1234567890abcd\n");
    k = put_s(want[0..512], k, 512, "0000000000000000000000000000000000000000\n");
    assert n == k;
    var i : usize = 0;
    while (i < n) {
        assert buf[i] == want[i];
        i = i + 1;
    }
}

test a_claim_of_issue_zero_or_a_non_hex_sha_runs_nothing {
    let mut buf : [256]u8 = [0; 256];
    assert claim_argv(buf[0..256], 256, 0, "aeb772f") == 0;
    assert claim_argv(buf[0..256], 256, 11601, "nothex!") == 0;
    assert claim_argv(buf[0..256], 256, 11601, "") == 0;
    assert claim_argv(buf[0..256], 256, 11601, "abc") == 0;
    assert claim_refusal(0, "") == "claim refused: issue 0 is no issue";
}

test beat_msg_is_a_payload_devices_accepts {
    let mut msg : [256]u8 = [0; 256];
    let n : usize = beat_msg(msg[0..256], 256, "mac-a", 4421, "0.1.0", "0.5.2");
    assert n > 0;
    assert dv_payload_ok(msg[0..n]) == true;
}

test beat_runs_as_commit_tree_then_push_on_the_alive_ref {
    let mut a : [512]u8 = [0; 512];
    let mut msg : [256]u8 = [0; 256];
    let m : usize = beat_msg(msg[0..256], 256, "mac-a", 4421, "0.1.0", "0.5.2");
    let n : usize = beat_commit_argv(a[0..512], 512, msg[0..m]);
    assert n > 0;
    assert a[0] == 'g';
    let mut b : [512]u8 = [0; 512];
    let commit : str = "4b825dc642cb6eb9a060e54bf8d69288fbee4904";
    let k : usize = beat_push_argv(b[0..512], 512, commit, "mac-a");
    assert k > 0;
    assert b[0] == 'g';
    let mut bad : [128]u8 = [0; 128];
    assert beat_push_argv(bad[0..128], 128, "nothex", "mac-a") == 0;
}

test status_is_the_sample_feed_read_by_devices_readers {
    let mut out : [256]u8 = [0; 256];
    let n : usize = status_text(DV_SAMPLE, out[0..256], 256);
    assert n > 0;
    // the same numbers, by devices' own readers: queue 6, unpushed 3, since 45, two C lines
    assert dv_g(DV_SAMPLE, "queue") == 6;
    assert dv_g(DV_SAMPLE, "unpushed") == 3;
    assert dv_g(DV_SAMPLE, "since") == 45;
    assert dv_g(DV_SAMPLE, "absent") == DV_NM;
    assert dv_count(DV_SAMPLE, 67) == 2;
    // the whole line, byte for byte: one label per number, no label twice
    let want : []const u8 = "trigit status: queue 6 unpushed 3 since 45 claims 2";
    assert n == want.len;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test a_missing_G_line_prints_a_dash_never_a_fake_zero {
    let mut out : [256]u8 = [0; 256];
    let w : usize = put_g(out[0..256], 0, 256, DV_SAMPLE, "absent");
    assert w == 8;
    assert out[7] == '-';
    let mut out2 : [256]u8 = [0; 256];
    let w2 : usize = put_g(out2[0..256], 0, 256, DV_SAMPLE, "queue");
    assert w2 == 7;
    assert out2[6] == '6';
}

test verdict_argv_names_the_verdicts_notes_ref_or_runs_nothing {
    let mut buf : [256]u8 = [0; 256];
    assert verdict_argv(buf[0..256], 256, "") == 0;
    let n : usize = verdict_argv(buf[0..256], 256, "aeb772f46b");
    assert n > 0;
    assert buf[0] == 'g';
    assert verdict_where() == "judged by specs/verified/verdict_notes.t27";
}

test feed_path_joins_devices_parts_into_the_file_the_feed_job_writes {
    let mut out : [256]u8 = [0; 256];
    let n : usize = feed_path("/Users/x", out[0..256], 256);
    assert n > 0;
    let mut want : [256]u8 = [0; 256];
    let k : usize = put_s(want[0..256], 0, 256, "/Users/x/.t27os/hive/feed.txt");
    assert n == k;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test usage_and_refusal_say_the_verb_and_the_dependency {
    let mut out : [512]u8 = [0; 512];
    let n : usize = usage_text(out[0..512], 512);
    assert n > 0;
    assert out[0] == 't';
    let mut r : [256]u8 = [0; 256];
    let k : usize = refusal_text(TV_SEND, r[0..256], 256);
    assert k > 0;
    assert r[0] == 't';
    let mut d : [256]u8 = [0; 256];
    let w : usize = did_text(TV_CLAIM, CLAIM_PREF, "aeb772f46b", d[0..256], 256);
    assert w > 0;
    assert d[0] == 't';
}

test handoff_is_the_twelfth_verb_and_its_class_reads_and_appends_the_ledger {
    assert verb_of("handoff") == TV_HANDOFF;
    assert verb_of("Handoff") == TV_UNKNOWN;
    assert host_action(TV_HANDOFF) == A_HANDOFF;
    assert waits(TV_HANDOFF) == false;
    assert handoff_where() == LEDGER;
    assert handoff_where() == "docs/coordination/HANDOFF.md";
}

test handoff_text_counts_the_records_names_the_last_state_and_speaks_t27os {
    const f : str = "Buffy|viz-distill-graph|doing|#12218|page lives in the spec\nCodex|gen-python|done|#12249|the verb lands\n";
    let mut out : [512]u8 = [0; 512];
    let n : usize = handoff_text(f, out[0..512], 512);
    let mut want : [512]u8 = [0; 512];
    let mut k : usize = 0;
    k = put_s(want[0..512], k, 512, "trigit handoff: records 2 last done\n");
    k = put_s(want[0..512], k, 512, "Buffy|viz-distill-graph|doing|#12218|page lives in the spec\n");
    k = put_s(want[0..512], k, 512, "Codex|gen-python|done|#12249|the verb lands\n");
    k = put_s(want[0..512], k, 512, "Codex gen-python -> session done\n");
    assert n == k;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test an_empty_ledger_says_so_and_builds_no_session_row {
    let mut out : [128]u8 = [0; 128];
    let n : usize = handoff_text("", out[0..128], 128);
    let mut want : [128]u8 = [0; 128];
    let k : usize = put_s(want[0..128], 0, 128, "trigit handoff: records 0 none yet\n");
    assert n == k;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test the_screen_keeps_only_the_last_five_of_a_longer_ledger {
    const f : str = "a|t|done|#1|x\nb|t|done|#2|x\nc|t|done|#3|x\nd|t|done|#4|x\ne|t|done|#5|x\nf|t|done|#6|x\n";
    let mut out : [512]u8 = [0; 512];
    let n : usize = handoff_text(f, out[0..512], 512);
    let mut want : [512]u8 = [0; 512];
    let mut k : usize = 0;
    k = put_s(want[0..512], k, 512, "trigit handoff: records 6 last done\n");
    k = put_s(want[0..512], k, 512, "b|t|done|#2|x\nc|t|done|#3|x\nd|t|done|#4|x\ne|t|done|#5|x\nf|t|done|#6|x\n");
    k = put_s(want[0..512], k, 512, "f t -> session done\n");
    assert n == k;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test the_two_refusals_name_the_shape_and_the_law_with_no_words_of_the_host {
    assert handoff_refusal() == "trigit handoff: refused; a record is agent task state issue note, state one of taken|doing|blocked|done, issue starts #, a field never holds '|'";
    assert move_refusal() == "trigit handoff: refused; that task may not move to that state (done is terminal, taken is not done, a repeat is not a move)";
}
