// SPDX-License-Identifier: Apache-2.0
; specs/tri/t27b/stdmem_plan.t27 -- when t27b lowers `std.mem.trim`,
; `std.mem.indexOf`, `std.mem.indexOfScalar` or `std.math.approxEqAbs` to a call
; of its routine in specs/tri/t27b/stdmem.t27, and what it refuses instead
; (issue #8965, the last lane of the t27b coverage epic #6063; written in t27
; under the port epic #6198).
; gen-zig prints these calls as written, so the reference runs Zig 0.16's own std for them. t27b
; splices stdmem.t27's fns into a program that names a builtin of BUILTINS, renamed from PORT to
; HELPER (t27b's reserved prefix, so a file that declares a `t27b_stdmem_*` fn of its own keeps
; it), and lowers each call the plan here allows to a call of the routine. Everything t27b
; decides about these calls is in this file and reaches cli/t27b through `t27c gen-rust`
; (gen/rust/tri/t27b/stdmem_plan.rs). The Rust glue in cli/t27b/src/lower/stdmem.rs only
; reads the element or type operand and asks this plan.
; --
; What the plan weighs is what the call's own shape fixes: the operand count and the element or
; type operand. The value operands need no rows here -- the routine's own parameters coerce them
; exactly as Zig coerces them at the call (a `str` for trim's cutset, a `u8` for indexOfScalar's
; byte, an f64 for approxEqAbs's values, a literal taking the parameter's type), and a value that
; does not coerce stays refused as the coercion's own refusal. `std.mem.indexOf` returns the
; routine's `?usize`, compared with `null` and unwrapped with `.?` as any optional is
; (optional_compare_plan.t27). An f32 form of approxEqAbs is refused by name, as `std.math.log1p`'s
; `log1p_32` is; a negative tolerance is the routine's `@panic`, Zig's own Debug assert, so a
; spec with one fails on both compilers, no row needed.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27bStdmemPlan;

// Which calls this plan owns. The glue splices stdmem.t27 in when a program names one.
pub const BUILTINS : str = "std.mem.trim std.mem.indexOfScalar std.math.approxEqAbs std.mem.indexOf";

pub const TRIM : u8 = 0;
pub const INDEX_OF : u8 = 1;
pub const APPROX_EQ_ABS : u8 = 2;
pub const INDEX : u8 = 3;

pub const PORT : str = "t27b_stdmem_";
pub const HELPER : str = "__t27b_stdmem_";

// The element or type operand, as the glue read it.
pub const K_U8 : u8 = 1;       // the element type operand names `u8`
pub const K_TYPE_F64 : u8 = 3; // the type operand names `f64`
pub const K_TYPE_F32 : u8 = 4; // the type operand names `f32`
pub const K_OTHER : u8 = 5;

// The decision.
pub const CALL : u8 = 0;
pub const REFUSE_ARITY : u8 = 1;
pub const REFUSE_ELEM : u8 = 2;
pub const REFUSE_TYPE : u8 = 4;

/// How many operands builtin b takes, counting the element or type operand.
pub fn arity(b: u8) -> usize {
    if (b == APPROX_EQ_ABS) { return 4; }
    return 3;
}

/// Which operand is the element or type operand.
pub fn type_operand(b: u8) -> usize {
    return 0;
}

/// The decision for b given `operands` lowered operands and the kind `t` of the element or
/// type operand. The value operands the routine's own parameters coerce.
pub fn plan(b: u8, operands: usize, t: u8) -> u8 {
    if (operands != arity(b)) { return REFUSE_ARITY; }
    if (b != APPROX_EQ_ABS and t != K_U8) { return REFUSE_ELEM; }
    if (b == APPROX_EQ_ABS and t != K_TYPE_F64) { return REFUSE_TYPE; }
    return CALL;
}

/// The fn a call of builtin b runs, under its name in a program; empty for a refusal.
pub fn routine(b: u8) -> str {
    if (b == TRIM) { return "__t27b_stdmem_trim"; }
    if (b == INDEX_OF) { return "__t27b_stdmem_find"; }
    if (b == APPROX_EQ_ABS) { return "__t27b_stdmem_approx_eq_abs"; }
    if (b == INDEX) { return "__t27b_stdmem_index_of"; }
    return "";
}

/// The construct a refusal of builtin b names.
pub fn what(b: u8) -> str {
    return "ExprCall(std.*)";
}

/// The detail a refusal reports.
pub fn detail(b: u8, act: u8) -> str {
    if (act == REFUSE_ARITY) { return "wrong number of operands"; }
    if (act == REFUSE_ELEM) { return "element type is not u8"; }
    if (act == REFUSE_TYPE) { return "only the f64 form is ported"; }
    return "";
}

test the_tables {
    assert std.mem.eql(u8, BUILTINS, "std.mem.trim std.mem.indexOfScalar std.math.approxEqAbs std.mem.indexOf");
    assert std.mem.eql(u8, PORT, "t27b_stdmem_");
    assert std.mem.eql(u8, HELPER, "__t27b_stdmem_");
    assert std.mem.indexOf(u8, HELPER, PORT) != null;
    assert HELPER.len == PORT.len + 2;
}

test arity_and_type_operand {
    assert arity(TRIM) == 3;
    assert arity(INDEX_OF) == 3;
    assert arity(INDEX) == 3;
    assert arity(APPROX_EQ_ABS) == 4;
    assert type_operand(TRIM) == 0;
    assert type_operand(APPROX_EQ_ABS) == 0;
}

test plan_rows {
    assert plan(TRIM, 3, K_U8) == CALL;
    assert plan(TRIM, 2, K_U8) == REFUSE_ARITY;
    assert plan(TRIM, 3, K_OTHER) == REFUSE_ELEM;
    assert plan(INDEX_OF, 3, K_U8) == CALL;
    assert plan(INDEX, 3, K_U8) == CALL;
    assert plan(INDEX, 4, K_U8) == REFUSE_ARITY;
    assert plan(APPROX_EQ_ABS, 4, K_TYPE_F64) == CALL;
    assert plan(APPROX_EQ_ABS, 4, K_TYPE_F32) == REFUSE_TYPE;
    assert plan(APPROX_EQ_ABS, 4, K_U8) == REFUSE_TYPE;
    assert plan(APPROX_EQ_ABS, 3, K_TYPE_F64) == REFUSE_ARITY;
}

test routine_and_refusal_names {
    assert std.mem.eql(u8, routine(TRIM), "__t27b_stdmem_trim");
    assert std.mem.eql(u8, routine(INDEX_OF), "__t27b_stdmem_find");
    assert std.mem.eql(u8, routine(INDEX), "__t27b_stdmem_index_of");
    assert std.mem.eql(u8, routine(APPROX_EQ_ABS), "__t27b_stdmem_approx_eq_abs");
    assert std.mem.eql(u8, what(TRIM), "ExprCall(std.*)");
    assert std.mem.eql(u8, detail(APPROX_EQ_ABS, REFUSE_TYPE), "only the f64 form is ported");
    assert std.mem.eql(u8, detail(TRIM, REFUSE_ELEM), "element type is not u8");
}
