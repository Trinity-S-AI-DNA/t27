// SPDX-License-Identifier: Apache-2.0
; specs/tri/seals/drift.t27 -- what `tri seals drift` says about a seal that no longer describes its spec.
; Issue gHashTag/t27#11045 (lab epic #11040): the seal and t27b speed work.
; --
; Why. A generator change leaves the specs it moved holding seals for output that no longer exists. The
; real case: after the gen-verilog fix of #8844 one seal of fifteen analog seals differed, in gen_hash_verilog
; alone, and the person found it by reading the MISMATCH lines of fifteen `t27c seal --verify` runs. The
; command that already finds the drifted seals (`tri seals drift`) listed the spec and said nothing about
; WHAT moved, so its report now names the claims.
; --
; The rules:
; - A seal makes five claims, in the order `t27c seal` prints them and `tri seals` compares them:
;   spec_hash, gen_hash_zig, gen_hash_c, gen_hash_rust, gen_hash_verilog. A seal DRIFTED when any one of
;   them differs from what the compiler produces from the spec right now. The report names every claim
;   that differs, in that order: spec_hash first is the spec edited, a gen_hash alone is the generator.
; - Only a seal that drifted is written again, and only one whose claims are all real hashes. A claim of
;   `none` says the spec generated nothing (#2210): writing it would record output that does not exist, so
;   that seal is REFUSED and left as it is. A seal that holds is never written, which is how a generator
;   change that moved four specs writes four seals and no other.
; - The verdict says what is done; it changes nothing about what a seal means. The hashes, the tests and
;   the producer a seal records are written by `t27c seal --save`, which `tri seals drift --fix` calls.
; The command (cli/tri/src/seals.rs, through `t27c gen-rust` in gen/rust/tri/seals/drift.rs) is glue: it
; asks t27c for the five claims of every spec, counts the claims that moved and the ones that read `none`,
; and prints the row this file names.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module TriSealsDrift;

/// The placeholders of a row: the spec's path and the names of the claims that moved.
pub const SPEC : str = "$SPEC";
pub const FIELDS : str = "$FIELDS";

/// The verdicts: nothing moved, some claim moved and the seal may be written again, or it may not.
pub const V_HOLDS : u8 = 0;
pub const V_RESEAL : u8 = 1;
pub const V_REFUSE : u8 = 2;

/// What is done about a spec's seals: `moved` of the five claims differ from the compiler's, `nones` of the
/// compiler's claims read `none`.
pub fn verdict(moved: u8, nones: u8) -> u8 {
    if (moved == 0) { return V_HOLDS; }
    if (nones > 0) { return V_REFUSE; }
    return V_RESEAL;
}

/// The row listing a drifted spec; V_HOLDS has no row.
pub fn row(v: u8) -> string {
    if (v == V_RESEAL) { return "      $SPEC  moved: $FIELDS"; }
    if (v == V_REFUSE) { return "      $SPEC  moved: $FIELDS  (refused: a claim is none)"; }
    return "";
}

/// The row printed once a spec's seal was written again.
pub const DONE : str = "      resealed  $SPEC  ($FIELDS)";

// Scenario: a seal whose every claim equals the compiler's holds, and is not listed or written.
test a_seal_that_holds_is_not_written {
    assert verdict(0, 0) == V_HOLDS;
    assert row(V_HOLDS) == "";
    // nothing moved, so a `none` the compiler printed is the seal's own claim and not a drift
    assert verdict(0, 4) == V_HOLDS;
}

// Scenario: one claim is enough. The generator moved gen_hash_verilog of one spec and nothing else.
test one_moved_claim_is_a_drift {
    assert verdict(1, 0) == V_RESEAL;
    assert verdict(2, 0) == V_RESEAL;
    assert verdict(5, 0) == V_RESEAL;
}

// Scenario: a spec the compiler no longer generates is never written, whatever moved (#2210).
test a_claim_of_none_is_refused_not_written {
    assert verdict(1, 1) == V_REFUSE;
    assert verdict(5, 4) == V_REFUSE;
    assert verdict(1, 1) != V_RESEAL;
}

test a_row_names_the_spec_and_the_claims {
    assert row(V_RESEAL) == "      $SPEC  moved: $FIELDS";
    assert row(V_REFUSE) == "      $SPEC  moved: $FIELDS  (refused: a claim is none)";
    assert DONE == "      resealed  $SPEC  ($FIELDS)";
    assert SPEC == "$SPEC" and FIELDS == "$FIELDS";
}

invariant the_verdicts_are_numbered {
    assert V_HOLDS == 0 and V_RESEAL == 1 and V_REFUSE == 2;
}
