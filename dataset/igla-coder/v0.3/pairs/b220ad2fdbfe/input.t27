test master_is_the_newest_decisive_run_and_looks_past_the_ones_that_say_nothing {
    var raw : [4096]u8 = undefined;
    // the lookup reads B lines only: the red PR's own K row of that name is not master's word
    const n : usize = t_red_pr(&raw, 4096, 0, 4);
    assert mj_master(&raw, n, T_NAMES[4], 0, 55) == M_UNSEEN;
    var b : [2048]u8 = undefined;
    var w : usize = t_row(&b, 2048, 0, 'B', 4, 100, 0);
    w = t_row(&b, 2048, w, 'B', 4, 200, 1);
    w = t_row(&b, 2048, w, 'B', 4, 300, 5);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_RED;
    w = t_row(&b, 2048, w, 'B', 4, 400, 0);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    w = t_row(&b, 2048, w, 'B', 4, 900, 4);
    w = t_row(&b, 2048, w, 'B', 4, 950, 2);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    w = t_row(&b, 2048, w, 'B', 4, 500, 1);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_RED;
}

test the_order_of_master_rows_does_not_matter_and_a_tie_reads_green {
    var b : [2048]u8 = undefined;
    var w : usize = t_row(&b, 2048, 0, 'B', 4, 999, 1);
    w = t_row(&b, 2048, w, 'B', 4, 1000, 0);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    w = t_row(&b, 2048, 0, 'B', 4, 1000, 0);
    w = t_row(&b, 2048, w, 'B', 4, 999, 1);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    // one run, both a failure and a success (a job re-run inside the run): the safe side is green
    w = t_row(&b, 2048, 0, 'B', 4, 1000, 1);
    w = t_row(&b, 2048, w, 'B', 4, 1000, 0);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    w = t_row(&b, 2048, 0, 'B', 4, 1000, 0);
    w = t_row(&b, 2048, w, 'B', 4, 1000, 1);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_GREEN;
    // ids are numbers, not strings
    w = t_row(&b, 2048, 0, 'B', 4, 99, 0);
    w = t_row(&b, 2048, w, 'B', 4, 1000, 1);
    assert mj_master(&b, w, T_NAMES[4], 0, 55) == M_RED;
}

test two_reds_are_judged_one_by_one_and_an_own_red_outranks_a_wanted_log {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    // Corpus ratchet: master red, log empty -> inherited. coverage: no master run -> unknown.
    var n : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 7, 2);
    n = t_good_rows(&raw, 4096, n, 100);
    n = t_row(&raw, 4096, n, 'K', 4, 300, 1);
    n = t_row(&raw, 4096, n, 'K', 8, 301, 1);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 1);
    n = t_file(&raw, 4096, n, 5, 0);
    n = t_file(&raw, 4096, n, 5, 1);
    n = t_named(&raw, 4096, n, 5, 4, 9);
    assert t_one(&raw, n) == J_RED;
    // the same PR with coverage inherited too
    n = t_row(&raw, 4096, n, 'B', 8, 251, 1);
    n = t_named(&raw, 4096, n, 5, 8, 9);
    assert t_one(&raw, n) == J_MERGE;
    // two reds whose logs are wanted: one L line each, and no G
    n = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 7, 2);
    n = t_good_rows(&raw, 4096, n, 100);
    n = t_row(&raw, 4096, n, 'K', 4, 300, 1);
    n = t_row(&raw, 4096, n, 'K', 8, 301, 1);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 1);
    n = t_row(&raw, 4096, n, 'B', 8, 251, 1);
    assert t_one(&raw, n) == J_LOG;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has_log(&out, m, 5, 4, 300);
    assert t_has_log(&out, m, 5, 8, 301);
    assert t_lines(&out, m, 'L') == 2;
    // one own and one wanted log: the own red decides, nothing is fetched for it
    n = t_row(&raw, 4096, n, 'B', 4, 260, 0);
    assert t_one(&raw, n) == J_RED;
    const k : usize = merge_plan(&raw, n, &out, 4096);
    assert t_lines(&out, k, 'L') == 0;
    assert t_has_red(&out, k, 5, 4, R_OWN_MERGE);
}

