    n = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 30, 6, 2);
    n = t_good_rows(&raw, 4096, n, 100);
    n = t_row(&raw, 4096, n, 'K', 4, 300, 1);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 1);
    assert t_one(&raw, n) == J_LOG;
}

test master_rows_may_stand_before_the_pull_request_or_inside_another_block {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var n : usize = t_row(&raw, 8192, 0, 'B', 4, 250, 1);
    n = t_red_pr(&raw, 8192, n, 4);
    n = t_file(&raw, 8192, n, 5, 0);
    n = t_file(&raw, 8192, n, 5, 1);
    n = t_named(&raw, 8192, n, 5, 4, 9);
    var m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_g(&out, m, 5);
    assert t_summary(&out, m, 1, 0, 0, 0, 0, 0, 1);
    // master's row inside PR 4's block serves PR 5's red too
    n = t_green(&raw, 8192, 0, 4);
    n = t_row(&raw, 8192, n, 'B', 4, 250, 1);
    n = t_red_pr(&raw, 8192, n, 4);
    n = t_file(&raw, 8192, n, 5, 0);
    n = t_file(&raw, 8192, n, 5, 1);
    n = t_named(&raw, 8192, n, 5, 4, 9);
    m = merge_plan(&raw, n, &out, 8192);
    assert t_g(&out, m, 4);
    assert t_g(&out, m, 5);
    assert t_summary(&out, m, 2, 0, 0, 0, 0, 0, 2);
}

// ---- tests: the cap, the order, the output ----

/// The numbers of the G lines of out[0..n), in output order, into nums; returns how many.
fn t_gnums(out : []const u8, n : usize, nums : []u32) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i + 2 < n) {
        if (out[i] == 'G' and out[i + 1] == '\t' and (i == 0 or out[i - 1] == '\n')) {
            var v : u32 = 0;
            var j : usize = i + 2;
            while (out[j] != '\t') {
                v = v * 10 + ((out[j] - '0') as u32);
                j += 1;
            }
            nums[c as usize] = v;
            c += 1;
        }
        i += 1;
    }
    return c;
}

test at_most_five_are_merged_per_run_lowest_number_first {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var nums : [8]u32 = undefined;
    var n : usize = t_green(&raw, 8192, 0, 30);
    n = t_green(&raw, 8192, n, 12);
    n = t_green(&raw, 8192, n, 45);
    n = t_green(&raw, 8192, n, 3);
    n = t_green(&raw, 8192, n, 9);
    n = t_green(&raw, 8192, n, 21);
    n = t_green(&raw, 8192, n, 18);
    const m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_gnums(&out, m, &nums) == 5;
    assert nums[0] == 3;
    assert nums[1] == 9;
    assert nums[2] == 12;
    assert nums[3] == 18;
    assert nums[4] == 21;
    assert t_has(&out, m, 'W', 30, J_CAPPED);
    assert t_has(&out, m, 'W', 45, J_CAPPED);
    assert t_summary(&out, m, 5, 2, 0, 0, 0, 0, 7);
    assert MERGE_CAP == 5;
}

test a_pull_request_that_waits_or_is_held_does_not_use_up_the_cap {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var nums : [8]u32 = undefined;
    var n : usize = t_p(&raw, 8192, 0, 1, false, 1, 0, 0, 0, 0, 1, 1, 3600, 5, 2);
    n = t_good_rows(&raw, 8192, n, 100);
    n = t_p(&raw, 8192, n, 2, true, 0, 0, 0, 0, 0, 1, 2, 3600, 5, 2);
    n = t_good_rows(&raw, 8192, n, 100);
    n = t_green(&raw, 8192, n, 13);
    n = t_green(&raw, 8192, n, 14);
    n = t_green(&raw, 8192, n, 15);
    n = t_green(&raw, 8192, n, 16);
    n = t_green(&raw, 8192, n, 17);
    n = t_green(&raw, 8192, n, 18);
    const m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_gnums(&out, m, &nums) == 5;
    assert nums[0] == 13;
    assert nums[4] == 17;
    assert t_has(&out, m, 'W', 18, J_CAPPED);
    assert t_has(&out, m, 'H', 1, J_HELD);
    assert t_has(&out, m, 'H', 2, J_DRAFT);
    assert t_summary(&out, m, 5, 1, 0, 2, 0, 0, 8);
}

test the_summary_counts_every_class {
    var raw : [16384]u8 = undefined;
    var out : [16384]u8 = undefined;
    var n : usize = t_green(&raw, 16384, 0, 20);
    n = t_p(&raw, 16384, n, 5, false, 1, 0, 0, 0, 0, 1, 5, 3600, 5, 2);
    n = t_good_rows(&raw, 16384, n, 100);
    n = t_p(&raw, 16384, n, 21, false, 0, 1, 0, 0, 0, 1, 1, 3600, 5, 2);
    n = t_good_rows(&raw, 16384, n, 100);
    n = t_p(&raw, 16384, n, 22, false, 0, 0, 0, 1, 1, 1, 2, 3600, 5, 2);
    n = t_good_rows(&raw, 16384, n, 100);
    n = t_p(&raw, 16384, n, 23, false, 0, 0, 0, 0, 0, 1, 3, 3600, 0, 2);
    n = t_green(&raw, 16384, n, 24);
    n = put_str(&raw, 16384, n, "P\t99\n", 5);
    const m : usize = merge_plan(&raw, n, &out, 16384);
    assert t_has(&out, m, 'H', 5, J_HELD);
    assert t_has(&out, m, 'N', 21, J_BEE);
    assert t_has(&out, m, 'W', 22, J_CONFLICT);
    assert t_has(&out, m, 'W', 23, J_PENDING);
    assert t_has(&out, m, 'W', 99, J_BAD);
    assert t_g(&out, m, 20);
    assert t_g(&out, m, 24);
    assert t_summary(&out, m, 2, 0, 2, 1, 1, 1, 7);
}

test the_output_lists_merges_first_then_the_rest_in_input_order {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var n : usize = t_p(&raw, 8192, 0, 8, true, 0, 0, 0, 0, 0, 1, 8, 3600, 5, 2);
    n = t_good_rows(&raw, 8192, n, 100);
    n = t_green(&raw, 8192, n, 4);
    n = t_p(&raw, 8192, n, 2, false, 1, 0, 0, 0, 0, 1, 2, 3600, 5, 2);
    n = t_good_rows(&raw, 8192, n, 100);
    const m : usize = merge_plan(&raw, n, &out, 8192);
    assert out[0] == 'G';
    assert out[1] == '\t';
    assert out[2] == '4';
    // after the G line: the draft (8), then the held one (2), then the summary
    var i : usize = 0;
    while (out[i] != '\n') { i += 1; }
    assert out[i + 1] == 'H';
    assert out[i + 3] == '8';
    var j : usize = i + 1;
    while (out[j] != '\n') { j += 1; }
    assert out[j + 1] == 'H';
    assert out[j + 3] == '2';
    assert out[m - 1] == '\n';
}

test the_lane_plan_is_the_merge_plan_or_the_refresh_plan_and_nothing_else {
    var raw : [4096]u8 = undefined;
    var a : [4096]u8 = undefined;
    var b : [4096]u8 = undefined;
    var c : [64]u8 = undefined;
    const n : usize = t_green(&raw, 4096, 0, 7);
    const m : usize = merge_plan(&raw, n, &a, 4096);
    assert lane_plan(0, &raw, n, &b, 4096, 0) == m;
    assert t_g(&b, m, 7);
    // kind 1 answers refresh.t27's summary for an empty listing; an unread queue skips
    const r : usize = refresh_plan("", 0, &a, 4096, 0);
    assert lane_plan(1, "", 0, &b, 4096, 0) == r;
    assert buf_has(&b, r, "M\tclaw-refresh: 0 to update", 27);
    assert lane_plan(1, "", 0, &b, 4096, -1) == refresh_plan("", 0, &a, 4096, -1);
    assert buf_has(&b, 66, "the Actions queue size could not be read", 40);
    // any other kind answers nothing and writes nothing
    c[0] = 'z';
    assert lane_plan(2, &raw, n, &c, 64, 0) == 0;
    assert c[0] == 'z';
}

test refresh_records_in_the_same_stream_are_skipped_not_counted {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    const r : usize = put_str(&raw, 8192, 0, "R\t5\t5aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", 45);
    var n : usize = t_green(&raw, 8192, r, 5);
    n = put_str(&raw, 8192, n, "R\t6\tx\n", 6);
    n = t_green(&raw, 8192, n, 6);
    var m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_summary(&out, m, 2, 0, 0, 0, 0, 0, 2);
    assert t_g(&out, m, 5);
    assert t_g(&out, m, 6);
    // an R line inside a block does not spoil it
    n = t_green(&raw, 8192, 0, 5);
    n = put_str(&raw, 8192, n, "R\t5\tx\n", 6);
    assert t_one(&raw, n) == J_MERGE;
}

// ---- tests: fail closed ----

/// The offset of the k-th TAB of the first line of raw[0..n), the first TAB being number 0.
fn t_tab(raw : []const u8, n : usize, k : u32) -> usize {
    var seen : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (raw[i] == '\t') {
            if (seen == k) { return i; }
            seen += 1;
        }
        i += 1;
    }
    return n;
}

test an_unreadable_p_line_is_never_merged_and_is_counted {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_green(&raw, 4096, 0, 7);
    assert t_one(&raw, n) == J_MERGE;
    // a sha with an upper-case digit
    raw[t_tab(&raw, n, 1) + 1] = 'A';
    assert t_one(&raw, n) == J_BAD;
    // a draft flag that is neither true nor false
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 2) + 1] = 'x';
    assert t_one(&raw, n) == J_BAD;
    // thirteen fields instead of fourteen
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 12)] = ' ';
    assert t_one(&raw, n) == J_BAD;
    // a closing count that is not a number, a rollup count that is not a number, a files count that is not
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 8) + 1] = 'x';
    assert t_one(&raw, n) == J_BAD;
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 11) + 1] = 'x';
    assert t_one(&raw, n) == J_BAD;
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 12) + 1] = 'x';
    assert t_one(&raw, n) == J_BAD;
    // the rollup sha is not a sha
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 9) + 1] = 'G';
    assert t_one(&raw, n) == J_BAD;
    // a pull request number that is not a positive integer
    n = t_green(&raw, 4096, 0, 7);
    raw[2] = '0';
    assert t_one(&raw, n) == J_BAD;
    raw[2] = 'x';
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_lines(&out, m, 'G') == 0;
    assert t_summary(&out, m, 0, 0, 0, 0, 0, 1, 1);
    // an empty head branch and an empty base branch
    n = t_green(&raw, 4096, 0, 7);
    raw[t_tab(&raw, n, 4) + 1] = '\t';
    assert t_one(&raw, n) == J_BAD;
}

test a_pull_request_number_seen_twice_is_merged_at_most_once {
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var n : usize = t_green(&raw, 8192, 0, 7);
    n = t_green(&raw, 8192, n, 7);
    n = t_green(&raw, 8192, n, 8);
    const m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_summary(&out, m, 2, 0, 0, 0, 0, 1, 3);
    assert t_lines(&out, m, 'G') == 2;
    assert t_has(&out, m, 'W', 7, J_BAD);
    assert t_g(&out, m, 8);
}

test a_block_with_a_line_of_another_tag_is_never_merged {
    var raw : [4096]u8 = undefined;
    var n : usize = t_green(&raw, 4096, 0, 7);
    n = put_str(&raw, 4096, n, "X\tsurprise\n", 10);
    assert t_one(&raw, n) == J_BAD;
    n = t_green(&raw, 4096, 0, 7);
    n = put_str(&raw, 4096, n, "no tab here\n", 12);
    assert t_one(&raw, n) == J_BAD;
    // F, O and B lines are part of a block
    n = t_green(&raw, 4096, 0, 7);
    n = t_file(&raw, 4096, n, 7, 0);
    n = t_named(&raw, 4096, n, 7, 4, 9);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 1);
    assert t_one(&raw, n) == J_MERGE;
}

test lines_before_the_first_pull_request_are_unreadable_unless_they_are_master_rows {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = put_str(&raw, 4096, 0, "K\tstray\t1\tCOMPLETED\tSUCCESS\n", 28);
    n = t_green(&raw, 4096, n, 7);
    var m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_summary(&out, m, 1, 0, 0, 0, 0, 1, 2);
    n = t_row(&raw, 4096, 0, 'B', 4, 250, 1);
    n = t_green(&raw, 4096, n, 7);
    m = merge_plan(&raw, n, &out, 4096);
    assert t_summary(&out, m, 1, 0, 0, 0, 0, 0, 1);
}

test more_pull_requests_than_the_lane_reads_are_counted_unreadable_not_dropped {
    var raw : [8192]u8 = undefined;
    var out : [40000]u8 = undefined;
    var n : usize = 0;
    var k : u32 = 0;
    while (k < 513) {
        n = put_str(&raw, 8192, n, "P\t", 2);
        n = put_count(&raw, 8192, n, k + 1);
        n = put_byte(&raw, 8192, n, '\n');
        k += 1;
    }
    const m : usize = merge_plan(&raw, n, &out, 40000);
    assert t_summary(&out, m, 0, 0, 0, 0, 0, 513, 513);
    assert t_lines(&out, m, 'G') == 0;
    assert MJ_MAX_PRS == 512;
}

test an_empty_stream_is_an_empty_plan {
    var out : [256]u8 = undefined;
    const m : usize = merge_plan("", 0, &out, 256);
    assert t_summary(&out, m, 0, 0, 0, 0, 0, 0, 0);
    assert t_lines(&out, m, 'G') == 0;
}

test a_clipped_answer_reports_what_it_needs_and_writes_nothing_past_the_cap {
    var raw : [4096]u8 = undefined;
    var big : [4096]u8 = undefined;
    var small : [32]u8 = undefined;
    const n : usize = t_green(&raw, 4096, 0, 7);
    const need : usize = merge_plan(&raw, n, &big, 4096);
    var i : usize = 0;
    while (i < 32) {
        small[i] = 'z';
        i += 1;
    }
    assert merge_plan(&raw, n, &small, 10) == need;
    assert small[0] == 'G';
    assert small[9] == big[9];
    assert small[10] == 'z';
    assert small[31] == 'z';
    assert need > 10;
}

// ---- tests: the texts ----

test every_reason_is_one_line_and_its_length_is_the_text_length {
    var d : usize = 0;
    while (d < J_COUNT) {
        var k : usize = 0;
        while (k < J_LENS[d]) {
            assert J_TEXTS[d][k] != '\t';
            if (k + 1 < J_LENS[d]) { assert J_TEXTS[d][k] != '\n'; }
            k += 1;
        }
        if (d == J_REQ_RED as usize or d == J_LOG as usize) {
            assert J_TEXTS[d][J_LENS[d] - 1] == ' ';
            assert J_TEXTS[d][J_LENS[d] - 2] == ':';
        } else if (d == J_RED as usize) {
            assert J_TEXTS[d][J_LENS[d] - 1] == ' ';
            assert J_TEXTS[d][J_LENS[d] - 2] == 'k';
        } else {
            assert J_TEXTS[d][J_LENS[d] - 1] == '\n';
            assert J_TEXTS[d][J_LENS[d] - 2] != '.';
        }
        d += 1;
    }
    assert J_COUNT == 17;
}

/// The class the table must hold for decision d, written once more as a rule.
fn t_class(d : u32) -> u8 {
    if (d == 0) { return 'G'; }
    if (d == 5) { return 'N'; }
    if (d == 2 or d == 3 or d == 4 or d == 14) { return 'H'; }
    return 'W';
}

test the_class_of_each_decision_is_g_w_h_or_n {
    var d : u32 = 0;
    while (d < 17) {
        assert J_CLASS[d as usize] == t_class(d);
        d += 1;
    }
    assert J_CLASS[J_HELD as usize] == 'H';
    assert J_CLASS[J_BEE as usize] == 'N';
    assert J_CLASS[J_CAPPED as usize] == 'W';
    assert J_CLASS[J_RED as usize] == 'H';
    assert J_CLASS[J_BAD as usize] == 'W';
}

test the_summary_pieces_have_the_lengths_they_claim {
    var k : usize = 0;
    while (k < 6) {
        assert MJ_SUM_TEXTS[k][0] == ' ';
        assert MJ_SUM_TEXTS[k][MJ_SUM_LENS[k] - 1] == ' ';
        assert MJ_SUM_TEXTS[k][MJ_SUM_LENS[k] - 2] != ' ';
        k += 1;
    }
    assert MJ_SUM_HEAD[MJ_SUM_HEAD_LEN - 1] == ' ';
    assert MJ_SUM_HEAD[MJ_SUM_HEAD_LEN - 2] == ':';
    assert MJ_SUM_TAIL[MJ_SUM_TAIL_LEN - 1] == '\n';
    assert MJ_SUM_TAIL[MJ_SUM_TAIL_LEN - 2] == 'n';
    var j : usize = 0;
    while (j < 9) {
        assert T_NAMES[j][T_NLENS[j] - 1] != '\t';
        j += 1;
    }
    assert T_NAMES[4][54] == ')';
    assert T_PATHS[2][27] == '7';
}

// ---- tests: the readers ----

test the_tag_of_a_line_is_its_first_byte_when_a_tab_follows {
    assert mj_tag("P\tx", 0, 3) == 'P';
    assert mj_tag("P\t", 0, 2) == 'P';
    assert mj_tag("P", 0, 1) == 0;
    assert mj_tag("Px\t", 0, 3) == 0;
    assert mj_tag("", 0, 0) == 0;
    assert mj_tag("aK\tx", 1, 4) == 'K';
    assert mj_tag("aK\tx", 0, 4) == 0;
}

test a_prefix_must_be_whole_and_at_the_start {
    assert mj_starts("queen-77", 0, 8, "queen-", 6);
    assert mj_starts("queen-", 0, 6, "queen-", 6);
    assert mj_starts("queen", 0, 5, "queen-", 6) == false;
    assert mj_starts("queenX77", 0, 8, "queen-", 6) == false;
    assert mj_starts("xqueen-77", 0, 9, "queen-", 6) == false;
    assert mj_starts("xqueen-77", 1, 9, "queen-", 6);
    assert mj_starts("ab", 0, 2, "", 0);
    assert mj_starts("queen-77", 0, 5, "queen-", 6) == false;
}

test two_ranges_are_the_same_only_when_every_byte_is {
    assert mj_same("abc", 0, 3, "abc", 0, 3);
    assert mj_same("xabc", 1, 4, "abcy", 0, 3);
    assert mj_same("abc", 0, 3, "abd", 0, 3) == false;
    assert mj_same("abc", 0, 3, "xbc", 0, 3) == false;
    assert mj_same("abc", 0, 3, "ab", 0, 2) == false;
    assert mj_same("abc", 0, 2, "abc", 0, 3) == false;
    assert mj_same("abc", 1, 1, "xyz", 2, 2);
}

test a_check_name_ends_at_the_next_tab_or_the_end_of_the_line {
    assert mj_name_end("K\tname\trest", 0) == 6;
    assert mj_name_end("K\tname\n", 0) == 6;
    assert mj_name_end("xK\tab\tc", 1) == 5;
    assert mj_name_end("K\t\tc", 0) == 2;
}

test an_empty_head_or_base_branch_is_unreadable {
    var raw : [4096]u8 = undefined;
    var n : usize = t_p(&raw, 4096, 0, 5, false, 0, 9, 0, 0, 0, 1, 5, 3600, 0, 0);
    assert t_one(&raw, n) == J_BAD;
    n = t_p(&raw, 4096, 0, 5, false, 0, 0, 9, 0, 0, 1, 5, 3600, 0, 0);
    assert t_one(&raw, n) == J_BAD;
    n = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 0, 0);
    assert t_one(&raw, n) == J_PENDING;
}

test the_changed_files_are_the_f_lines_of_that_pull_request_and_a_bad_line_is_not_counted {
    var raw : [4096]u8 = undefined;
    var buf : [256]u8 = undefined;
    var len : [1]usize = undefined;
    var n : usize = t_file(&raw, 4096, 0, 5, 0);
    n = t_file(&raw, 4096, n, 5, 1);
    n = t_file(&raw, 4096, n, 6, 3);
    assert mj_files(&raw, n, 5, &buf, 256, &len) == 2;
    assert len[0] == 47;
    assert buf[0] == 's';
    assert buf[26] == '\n';
    assert buf[27] == 'd';
    assert buf[46] == '\n';
    assert mj_files(&raw, n, 6, &buf, 256, &len) == 1;
    assert len[0] == 19;
    assert mj_files(&raw, n, 56, &buf, 256, &len) == 0;
    assert mj_files(&raw, n, 7, &buf, 256, &len) == 0;
    // an empty path, a line of four fields, a line of another tag and a number that is not 5 are not counted
    n = put_str(&raw, 4096, n, "F\t5\t\n", 5);
    n = put_str(&raw, 4096, n, "F\t5\ta\tb\n", 8);
    n = put_str(&raw, 4096, n, "K\t5\tx\n", 6);
    n = put_str(&raw, 4096, n, "F\tx\ta\n", 6);
    assert mj_files(&raw, n, 5, &buf, 256, &len) == 2;
    assert len[0] == 47;
    // a list that does not fit says so by its length
    assert mj_files(&raw, n, 5, &buf, 30, &len) == 2;
    assert len[0] == 47;
    assert mj_files(&raw, 0, 5, &buf, 256, &len) == 0;
    assert len[0] == 0;
}

test the_named_paths_are_the_o_lines_of_that_pull_request_and_check {
    var raw : [4096]u8 = undefined;
    var buf : [256]u8 = undefined;
    var len : [1]usize = undefined;
    var n : usize = t_named(&raw, 4096, 0, 5, 4, 0);
    n = t_named(&raw, 4096, n, 5, 4, 9);
    n = t_named(&raw, 4096, n, 5, 6, 2);
    n = t_named(&raw, 4096, n, 6, 4, 3);
    assert mj_named(&raw, n, 5, T_NAMES[4], 0, 55, &buf, 256, &len) == 2;
    assert len[0] == 27;
    assert buf[0] == 's';
    assert buf[26] == '\n';
    assert mj_named(&raw, n, 5, T_NAMES[6], 0, 31, &buf, 256, &len) == 1;
    assert len[0] == 29;
    assert mj_named(&raw, n, 5, T_NAMES[7], 0, 23, &buf, 256, &len) == 0;
    assert len[0] == 0;
    assert mj_named(&raw, n, 6, T_NAMES[4], 0, 55, &buf, 256, &len) == 1;
    assert len[0] == 19;
    assert mj_named(&raw, n, 7, T_NAMES[4], 0, 55, &buf, 256, &len) == 0;
    // a name that is only a prefix of the check's name is another check
    assert mj_named(&raw, n, 5, T_NAMES[4], 0, 54, &buf, 256, &len) == 0;
    n = put_str(&raw, 4096, n, "O\t5\tx\n", 6);
    assert mj_named(&raw, n, 5, T_NAMES[7], 0, 23, &buf, 256, &len) == 0;
}

test f_and_o_lines_find_their_pull_request_wherever_they_stand {
    // The glue appends the logs it read after the whole listing: the lines still reach PR 5.
    var raw : [8192]u8 = undefined;
    var out : [8192]u8 = undefined;
    var n : usize = t_red_pr(&raw, 8192, 0, 4);
    n = t_row(&raw, 8192, n, 'B', 4, 250, 1);
    n = t_green(&raw, 8192, n, 6);
    var m : usize = merge_plan(&raw, n, &out, 8192);
    assert t_has_named(&out, m, 'W', 5, J_LOG, 4);
    assert t_has_log(&out, m, 5, 4, 300);
    assert t_g(&out, m, 6);
    n = t_file(&raw, 8192, n, 5, 0);
    n = t_file(&raw, 8192, n, 5, 1);
    n = t_named(&raw, 8192, n, 5, 4, 9);
    m = merge_plan(&raw, n, &out, 8192);
    assert t_g(&out, m, 5);
    assert t_g(&out, m, 6);
    assert t_lines(&out, m, 'L') == 0;
    assert t_summary(&out, m, 2, 0, 0, 0, 0, 0, 2);
    // the same lines under another number are no answer for PR 5
    n = t_red_pr(&raw, 8192, 0, 4);
    n = t_row(&raw, 8192, n, 'B', 4, 250, 1);
    n = t_file(&raw, 8192, n, 6, 0);
    n = t_file(&raw, 8192, n, 6, 1);
    n = t_named(&raw, 8192, n, 6, 4, 9);
    assert t_one(&raw, n) == J_LOG;
    m = merge_plan(&raw, n, &out, 8192);
    assert t_has_log(&out, m, 5, 4, 300);
}

test the_kind_of_a_red_row_is_read_from_its_job_name {
    var raw : [4096]u8 = undefined;
    var rs : [4096]u8 = undefined;
    var pos : [128]usize = undefined;
    var len : [1]usize = undefined;
    var n : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 9, 2);
    n = t_row(&raw, 4096, n, 'K', 7, 100, 0);
    n = t_row(&raw, 4096, n, 'K', 5, 101, 1);
    n = t_row(&raw, 4096, n, 'K', 4, 102, 1);
    n = t_row(&raw, 4096, n, 'K', 0, 103, 1);
    n = put_str(&raw, 4096, n, "K\tOther/claw-sarif\t500\tCOMPLETED\tFAILURE\n", 41);
    n = put_str(&raw, 4096, n, "K\tGate Topology/claw-sarif-2\t501\tCOMPLETED\tFAILURE\n", 51);
    n = put_str(&raw, 4096, n, "K\tclaw-sarif\t502\tCOMPLETED\tFAILURE\n", 35);
    n = put_str(&raw, 4096, n, "K\tx/validate\t503\tCOMPLETED\tFAILURE\n", 35);
    n = put_str(&raw, 4096, n, "K\tx/validate2\t504\tCOMPLETED\tFAILURE\n", 36);
    assert mj_rows(&raw, 0, n, &rs, 4096, &pos, &len) == 9;
    assert mj_first_kind(&rs, len[0], KIND_NONE) == 0;
    assert mj_first_kind(&rs, len[0], KIND_SARIF) == 1;
    assert mj_first_kind(&rs, len[0], KIND_OTHER) == 2;
    assert mj_first_kind(&rs, len[0], KIND_REQ) == 3;
    // the job part of the name decides, whatever the workflow part says
    assert mj_first_kind(&rs, 0, KIND_SARIF) == -1;
    // the table is the K lines without their tags, one per line, and pos names the K lines in raw
    assert rs[0] == 'S';
    assert pos[1] == pos[0] + 48;
    assert raw[pos[2]] == 'K';
    assert mj_name_end(&raw, pos[2]) - pos[2] - 2 == 55;
}

test a_superseded_or_unreadable_or_passed_row_is_no_red {
    var rs : [512]u8 = undefined;
    var n : usize = put_str(&rs, 512, 0, "a/job\t5\tCOMPLETED\tFAILURE\n", 26);
    n = put_str(&rs, 512, n, "a/job\t9\tCOMPLETED\tSUCCESS\n", 26);
    assert mj_first_kind(&rs, n, KIND_OTHER) == -1;
    n = put_str(&rs, 512, 0, "a/job\t5\tCOMPLETED\tFAILURE\n", 26);
    assert mj_first_kind(&rs, n, KIND_OTHER) == 0;
    n = put_str(&rs, 512, 0, "a/job\tx\tCOMPLETED\tFAILURE\n", 26);
    assert mj_first_kind(&rs, n, KIND_OTHER) == -1;
    n = put_str(&rs, 512, 0, "a/job\t5\tQUEUED\t-\n", 17);
    assert mj_first_kind(&rs, n, KIND_OTHER) == -1;
    n = put_str(&rs, 512, 0, "ctx\t-\tCONTEXT\tFAILURE\n", 22);
    assert mj_first_kind(&rs, n, KIND_OTHER) == 0;
}

/// The kind of the first row of the table rs[0..n).
fn t_kind(rs : []const u8, n : usize) -> u8 {
    if (mj_first_kind(rs, n, KIND_REQ) == 0) { return KIND_REQ; }
    if (mj_first_kind(rs, n, KIND_SARIF) == 0) { return KIND_SARIF; }
    if (mj_first_kind(rs, n, KIND_OTHER) == 0) { return KIND_OTHER; }
    return KIND_NONE;
}

test only_the_job_named_claw_sarif_is_the_known_infra_red_and_only_four_jobs_are_required {
    var rs : [256]u8 = undefined;
    var n : usize = put_str(&rs, 256, 0, "Other/claw-sarif\t500\tCOMPLETED\tFAILURE\n", 39);
    assert t_kind(&rs, n) == KIND_SARIF;
    n = put_str(&rs, 256, 0, "claw-sarif\t502\tCOMPLETED\tFAILURE\n", 33);
    assert t_kind(&rs, n) == KIND_SARIF;
    n = put_str(&rs, 256, 0, "Gate Topology/claw-sarif-2\t501\tCOMPLETED\tFAILURE\n", 49);
    assert t_kind(&rs, n) == KIND_OTHER;
    n = put_str(&rs, 256, 0, "Gate Topology/xclaw-sarif\t501\tCOMPLETED\tFAILURE\n", 48);
    assert t_kind(&rs, n) == KIND_OTHER;
    n = put_str(&rs, 256, 0, "x/validate\t503\tCOMPLETED\tFAILURE\n", 33);
    assert t_kind(&rs, n) == KIND_REQ;
    n = put_str(&rs, 256, 0, "validate\t503\tCOMPLETED\tFAILURE\n", 31);
    assert t_kind(&rs, n) == KIND_REQ;
    n = put_str(&rs, 256, 0, "x/validate2\t504\tCOMPLETED\tFAILURE\n", 34);
    assert t_kind(&rs, n) == KIND_OTHER;
    n = put_str(&rs, 256, 0, "x/own-language\t504\tCOMPLETED\tFAILURE\n", 37);
    assert t_kind(&rs, n) == KIND_REQ;
    n = put_str(&rs, 256, 0, "x/parse-ratchet\t504\tCOMPLETED\tFAILURE\n", 38);
    assert t_kind(&rs, n) == KIND_REQ;
    n = put_str(&rs, 256, 0, "x/check-linked-issue\t504\tCOMPLETED\tFAILURE\n", 43);
    assert t_kind(&rs, n) == KIND_REQ;
    n = put_str(&rs, 256, 0, "x/validate\t503\tCOMPLETED\tSUCCESS\n", 33);
    assert t_kind(&rs, n) == KIND_NONE;
}
