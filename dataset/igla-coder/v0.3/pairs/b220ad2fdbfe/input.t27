    assert t_one(&raw, n) == J_LOG;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has_named(&out, m, 'W', 5, J_LOG, 4);
    assert t_has_log(&out, m, 5, 4, 300);
    assert t_lines(&out, m, 'L') == 1;
    assert t_lines(&out, m, 'G') == 0;
    assert t_summary(&out, m, 0, 0, 1, 0, 0, 0, 1);
}

test a_red_master_has_too_and_a_log_that_names_nothing_the_pr_changes_is_inherited {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
