    n = t_file(&raw, 4096, n, 5, 0);
    n = t_file(&raw, 4096, n, 5, 1);
    n = t_named(&raw, 4096, n, 5, 4, 9);
    assert t_one(&raw, n) == J_MERGE;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_g(&out, m, 5);
    assert t_lines(&out, m, 'L') == 0;
    // the log names a file, but not one this PR changes
    n = t_red_pr(&raw, 4096, 0, 4);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 1);
    n = t_file(&raw, 4096, n, 5, 0);
    n = t_file(&raw, 4096, n, 5, 1);
    n = t_named(&raw, 4096, n, 5, 4, 3);
    assert t_one(&raw, n) == J_MERGE;
}

test negative_control_the_t27b_ratchet_red_on_a_spec_the_pr_adds_is_the_prs_own_though_master_is_red {
