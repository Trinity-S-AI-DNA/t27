test the_reasons_rank_required_before_other_reds_and_reds_before_the_quiet_time {
    var raw : [4096]u8 = undefined;
    // validate red and Corpus ratchet red on a green master: the required one is named
    var n : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 7, 2);
    n = t_good_rows(&raw, 4096, n, 100);
    n = t_row(&raw, 4096, n, 'K', 0, 900, 1);
    n = t_row(&raw, 4096, n, 'K', 4, 901, 1);
