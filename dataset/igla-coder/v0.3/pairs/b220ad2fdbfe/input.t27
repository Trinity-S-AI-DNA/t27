// SPDX-License-Identifier: Apache-2.0
; specs/claw/merge_judge.t27 -- which open pull requests TRI CLAW merges, and why it leaves the rest alone.
; Owner, 2026-10-19 (translated): set up TRI CLAW to do this autonomously, morning to night, 24/7. "This"
; is what the sweep session did by hand all night: merge every pull request that passes the rules,
; refresh the ones that fall behind, leave the rest alone and say why. Strictness: required + inherited.
; --
; This module decides; it moves nothing. The claw-merge job in .github/workflows/gate-topology.yml lists the
; open pull requests, feeds this module the facts, and applies the `G` lines with one pinned merge call. The
; job holds no decision. Every skip below is decided here, in a unit test, from facts only.
; --
; The rules, for one open pull request, first match wins. The letter is the output tag of the line (H hold:
; a person decides; W wait: look again next run; N not mine: another lane merges it):
;     1  held         the label no-auto-merge is on it                      H  a person or a gate has claimed it
;     2  draft        isDraft                                               H  drafts are the hold convention
;     3  base         the base branch is not master                         H  the lane merges into master only
;     4  bee          the head branch starts `queen-`                       N  only auto-merge-ready-prs.yml
;                     merges a bee pull request, after the reviewer bee (owner rule 2026-10-02)
;     5  conflict     CONFLICTING or DIRTY                                  W  refresh.t27 lists it; the lane
;                     never resolves a conflict. A mergeability GitHub has not computed is W too: next run
;     6  no_close     GitHub's closingIssuesReferences is empty             W  L1 TRACEABILITY
;     7  unread       the rollup is not the head commit's, is cut short, or has a row that cannot be read   W
;     8  pending      a check is still waiting, or none has posted          W  check_state / check_latest
;     9  req_red      a REQUIRED check is red (validate, check-linked-issue, parse-ratchet, own-language)   W
;     10 req_missing  a required check has not posted                       W
;     11 red          every other red check must be INHERITED (red_origin.t27). A red that is the PR's own, or
;                     unknown, is H with red_origin's reason line. claw-sarif is inherited by definition: the
;                     TRI CLAW App lacks security_events:write (#10501), so it fails before it reads any code.
;                     A red whose master run is red needs the failing log: the module asks for it (L line) and
;                     the pull request waits (W, log) until it has the answer
;     12 quiet        the head commit is younger than QUIET_MIN minutes     W  the author may still be pushing
;     13 merge        otherwise: squash, pinned to the head sha that was judged                              G
; Only G merges. At most MERGE_CAP of the mergeable ones are kept, lowest number first (the oldest); the rest
; are W (capped) and go on the next run.
; --
; The input, one stream on stdin, one line per fact, TAB fields, the first field a one-letter tag. A pull
; request is its P line and the K lines after it up to the next P line:
;     P  number, head sha, isDraft, labels joined by commas, head branch, base branch, mergeable,
;        mergeStateStatus, closing references (count), sha of the commit whose rollup follows, seconds since
;        the head commit was made (`-` when unread), rollup items (count), changed files (count)
;     K  name, run, status, conclusion   one rollup item, check_latest.t27's row. name is workflow/job; run is
;        the check run's id (any id that grows with time; for an Actions job it is also the id of its log);
;        a commit status carries `-`, CONTEXT, state
;     F  number, path                    a file that pull request changes
;     O  number, check name, path        a path the failing log of that pull request's check names (`-` when
;                                        it names none)
;     B  name, run, status, conclusion   one rollup item of a recent master commit, same shape as K
; B, F and O lines may stand anywhere, F and O naming their pull request by number. R lines are refresh.t27's
; records in the same listing: this module skips them. A fact the glue could not read is left out, never
; invented: that is what makes an unread fact a W and never a G.
; The output, one line per fact:
;     G TAB number TAB head sha          merge this one (at most MERGE_CAP, lowest number first)
;     W TAB number TAB reason            wait   H TAB number TAB reason   hold   N TAB number TAB reason  not mine
;     L TAB number TAB check TAB id      the failing log of this check (id: the K line's run) decides a red
;     M TAB text                         one line for the step summary
; --
; The glue, so the workflow file carries no prose. The claw-merge job lists open pull requests in pages of 15 (a page of
; 100 with 50 labels each came back as HTML) and tries a failed page three times, keeping nothing of a failed try;
; GitHub computes mergeability lazily after a push, so it lists once, waits 30 s and lists again. B lines come from the
; rollups of master's last twenty commits (a failed read leaves none, and then no red is inherited; a check of a workflow
; master did not run in those commits, a path-filtered one, has no word, and its red is unknown). L lines are answered
; by one files call per pull request (F lines) and one job-log call per wanted check (O lines: the F paths the log
; contains; a log that cannot be read leaves no O line, so the red keeps waiting). Refresh (refresh.t27) runs only after
; a push and with the App token: every update-branch starts about 26 workflows, the queue limit is its, and behind_by is
; the one fact the listing lacks (the ruleset is not strict, so no pull request is ever reported BEHIND); a pull request
; merged in this run is not refreshed. The merge is TRI CLAW's token (contents + pull_requests write, so master's push
; workflows start and its checks stay fresh for the B lines), else github.token, whose merges start no workflow. A push
; run cancels the older push run (the workflow's own group): the lane then re-plans, one merge per run at worst.
; --
; Whose red is it: red_origin.t27's red_reason runs on the lists this module builds from F and O lines: the
; PR's files, the paths the log names, no moved list. master is the newest DECISIVE row of the same check
; among the B lines (COMPLETED with SUCCESS or FAILURE; a cancelled, skipped or timed-out run is looked past,
; the way specs/queen/merger_gate.t27 look_back does), the largest run id first; the same run with both a
; SUCCESS and a FAILURE reads green, the safe side. A named path the PR changes makes the red the PR's even
; when master is red too; master green makes any red the PR's; master with no decisive row is unknown, and an
; unknown red holds. The paths are what the glue read: F is checked against the changed-files count of the
; P line, and a count that does not match is an unread list.
; --
; Fail closed: a P line that is not fourteen fields, a number that is not a positive integer or is seen twice,
; a sha that is not 40 lowercase hex digits, a flag that is not `true` or `false`, a count that is not a
; number, a block that holds a line with another tag, more than MJ_MAX_ROWS rollup items, or a record past
; MJ_MAX_PRS is never merged; it is counted as unreadable.
; The honest limits. The module does not read the failure set of a red job, only whether its log names a file
; the PR changes: a PR that adds a new failure in a job master also fails, in a file it does not change, reads
; inherited. Reviews are not read (the label is the hold convention). A bot pull request without a closing
; reference waits for one. The age is the head commit's own date: a commit made long ago and pushed now looks
; old, which is why the merge is pinned to the judged sha and checks that have not finished wait. Two pull
; requests merged in one run were each green alone; the repository ruleset is not strict, as for every merger.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ClawMergeJudge;

use claw::sarif;
use claw::text;
use claw::refresh;
use claw::queue_cost;
use claw::check_state;
use claw::check_latest;
use claw::required_red;
use claw::red_origin;

/// Pull requests one run reads; more are counted as unreadable, never silently dropped.
pub const MJ_MAX_PRS : usize = 512;
/// The most pull requests one run merges, lowest number first.
pub const MERGE_CAP : u32 = 5;
/// The head commit must be at least this many minutes old (QUIET_SECS seconds).
pub const QUIET_MIN : i32 = 10;
pub const QUIET_SECS : i32 = 600;
/// Rollup items one pull request may carry, and the bytes of their table.
pub const MJ_MAX_ROWS : u32 = 128;
pub const MJ_TABLE_CAP : usize = 16384;
/// Bytes of the file list and of the named list a red check is judged with.
pub const MJ_LIST_CAP : usize = 16384;
/// Fields of a P line, the tag included.
pub const MJ_PF : usize = 14;

/// Decisions. J_MERGE is "every rule passed"; the cap turns the extra ones into J_CAPPED.
pub const J_MERGE : u8 = 0;
pub const J_CAPPED : u8 = 1;
pub const J_HELD : u8 = 2;
pub const J_DRAFT : u8 = 3;
pub const J_BASE : u8 = 4;
pub const J_BEE : u8 = 5;
pub const J_CONFLICT : u8 = 6;
pub const J_UNKNOWN : u8 = 7;
pub const J_NO_CLOSE : u8 = 8;
pub const J_UNREAD : u8 = 9;
pub const J_PENDING : u8 = 10;
pub const J_REQ_RED : u8 = 11;
pub const J_REQ_MISSING : u8 = 12;
pub const J_LOG : u8 = 13;
pub const J_RED : u8 = 14;
pub const J_QUIET : u8 = 15;
pub const J_BAD : u8 = 16;
pub const J_COUNT : usize = 17;

/// The output tag of each decision, in decision order: G merge, W wait, H hold, N not mine.
pub const J_CLASS : str = "GWHHHNWWWWWWWWHWW";

/// The reason of each decision, with its byte length (a test pins every length). A text that ends in
/// `: ` takes the check name and a newline after it; the others end in a newline.
pub const J_TEXTS : [17]str = [
    "every rule passed\n",
    "mergeable, but the per-run cap on merges is reached and the oldest go first: it goes next run\n",
    "the label no-auto-merge is on it: a person or a gate has claimed it\n",
    "draft: drafts are never touched\n",
    "its base branch is not master: the lane merges into master only\n",
    "bee pull request (queen- branch): only auto-merge-ready-prs.yml merges it, after the reviewer bee\n",
    "conflicts with its base branch: refresh.t27 lists it, the lane never resolves conflicts\n",
    "GitHub has not computed its mergeability yet: next run\n",
    "no closing reference (L1 TRACEABILITY): add Closes #N to the body\n",
    "the check rollup is not the head commit's, was cut short, or has a row that cannot be read\n",
    "checks are still waiting, or none has posted yet\n",
    "a required check is red: ",
    "a required check has not posted yet\n",
    "the failing log is not read yet, so whose red it is is not known: ",
    "red check ",
    "the head commit is younger than 10 minutes, or its age is unread: the author may still be pushing\n",
    "the record cannot be read: fail closed\n"
];
pub const J_LENS : [17]usize = [
    18, 94, 68, 32, 64, 98, 88, 55, 66, 91, 49, 25, 36, 66, 10, 98, 39
];

/// Summary pieces, each with its byte length (the tests pin the lengths).
pub const MJ_SUM_HEAD : str = "M\tclaw-merge: ";
pub const MJ_SUM_HEAD_LEN : usize = 14;
pub const MJ_SUM_TEXTS : [6]str = [" to merge, ", " over the cap, ", " waiting, ", " held, ", " not mine, ", " unreadable of "];
pub const MJ_SUM_LENS : [6]usize = [11, 15, 10, 7, 11, 15];
pub const MJ_SUM_TAIL : str = " open\n";
pub const MJ_SUM_TAIL_LEN : usize = 6;

/// What a red check's row is, for the rules that read reds.
pub const KIND_NONE : u8 = 0;
pub const KIND_REQ : u8 = 1;
pub const KIND_SARIF : u8 = 2;
pub const KIND_OTHER : u8 = 3;

// ---- the small readers ----

/// The tag of the line raw[ls..le): its first byte when the second is a TAB, else 0.
pub fn mj_tag(raw : []const u8, ls : usize, le : usize) -> u8 {
    if (le < ls + 2) { return 0; }
    if (raw[ls + 1] != '\t') { return 0; }
    return raw[ls];
}

/// raw[s..e) begins with the p_len bytes of p.
pub fn mj_starts(raw : []const u8, s : usize, e : usize, p : str, p_len : usize) -> bool {
    if (e < s + p_len) { return false; }
    var i : usize = 0;
    while (i < p_len) {
        if (raw[s + i] != p[i]) { return false; }
        i += 1;
    }
    return true;
}

/// a[a0..a1) and b[b0..b1) hold the same bytes.
pub fn mj_same(a : []const u8, a0 : usize, a1 : usize, b : []const u8, b0 : usize, b1 : usize) -> bool {
    if (a1 - a0 != b1 - b0) { return false; }
    var i : usize = 0;
    while (a0 + i < a1) {
        if (a[a0 + i] != b[b0 + i]) { return false; }
        i += 1;
    }
    return true;
}

/// The end of the name that starts at raw[p + 2], the byte after a K line's tag and TAB.
pub fn mj_name_end(raw : []const u8, p : usize) -> usize {
    var e : usize = p + 2;
    while (raw[e] != '\t' and raw[e] != '\n') { e += 1; }
    return e;
}

/// Whether the 14 fields of a P line (f holds their bounds) are all readable.
pub fn mj_p_ok(raw : []const u8, f : []const usize) -> bool {
    if (parse_num(raw, f[2], f[3]) < 1) { return false; }
    if (rf_sha_ok(raw, f[4], f[5]) == false) { return false; }
    if (rf_flag(raw, f[6], f[7]) == T_BAD) { return false; }
    if (f[11] == f[10] or f[13] == f[12]) { return false; }
    if (parse_num(raw, f[18], f[19]) < 0) { return false; }
    if (rf_sha_ok(raw, f[20], f[21]) == false) { return false; }
    if (parse_num(raw, f[24], f[25]) < 0) { return false; }
    if (parse_num(raw, f[26], f[27]) < 0) { return false; }
    return true;
}

/// Every line of the block raw[bs..be) after its P line is a K, F, O, B or R line (R: a refresh.t27 record, not ours).
pub fn mj_block_clean(raw : []const u8, bs : usize, be : usize) -> bool {
    var ls : usize = qc_line_end(raw, be, bs) + 1;
    while (ls < be) {
        const le : usize = qc_line_end(raw, be, ls);
        if (le > ls) {
            const t : u8 = mj_tag(raw, ls, le);
            if (t != 'K' and t != 'F' and t != 'O' and t != 'B' and t != 'R') { return false; }
        }
        ls = le + 1;
    }
    return true;
}

// ---- the rollup of one pull request ----

/// The K lines of the block raw[bs..be) as check_latest rows (the tag cut off) in rs, one per line; pos[k]
/// holds the start in raw of the k-th K line. Returns the number of K lines, which may exceed MJ_MAX_ROWS.
/// len[0] is the bytes the table needs; the table is clipped at cap when that is larger.
pub fn mj_rows(raw : []const u8, bs : usize, be : usize, rs : []u8, cap : usize, pos : []usize, len : []usize) -> u32 {
    var w : usize = 0;
    var rows : u32 = 0;
    var ls : usize = bs;
    while (ls < be) {
        const le : usize = qc_line_end(raw, be, ls);
        if (le > ls) {
            if (mj_tag(raw, ls, le) == 'K') {
                if (rows < MJ_MAX_ROWS) { pos[rows as usize] = ls; }
                w = qc_put_range(rs, cap, w, raw, ls + 2, le);
                w = put_str(rs, cap, w, "\n", 1);
                rows += 1;
            }
        }
        ls = le + 1;
    }
    len[0] = w;
    return rows;
}

/// The kind of the row rs[ls..le): KIND_REQ for a live red required check, KIND_SARIF for a live red
/// claw-sarif, KIND_OTHER for any other live red, KIND_NONE for every other row.
pub fn mj_row_kind(rs : []const u8, rn : usize, ls : usize, le : usize) -> u8 {
    var f : [8]usize = undefined;
    var c : [4]usize = undefined;
    if (qc_split(rs, ls, le, &f, 4) == false) { return KIND_NONE; }
    if (row_ok(rs, &f) == false) { return KIND_NONE; }
    if (is_superseded(rs, rn, ls, &f)) { return KIND_NONE; }
    c[0] = f[4];
    c[1] = f[5];
    c[2] = f[6];
    c[3] = f[7];
    if (check_class(rs, &c) != K_FAIL) { return KIND_NONE; }
    if (required_index(rs, f[0], f[1]) < RR_REQUIRED) { return KIND_REQ; }
    if (qc_range_is(rs, job_start(rs, f[0], f[1]), f[1], "claw-sarif", 10)) { return KIND_SARIF; }
    return KIND_OTHER;
}

/// The row ordinal (0-based) of the first row of kind `want`, or -1.
pub fn mj_first_kind(rs : []const u8, rn : usize, want : u8) -> i32 {
    var row : i32 = 0;
    var ls : usize = 0;
    while (ls < rn) {
        const le : usize = qc_line_end(rs, rn, ls);
        if (le > ls) {
            if (mj_row_kind(rs, rn, ls, le) == want) { return row; }
            row += 1;
        }
        ls = le + 1;
    }
    return -1;
}

// ---- whose red is it ----

/// Master's word on the check named by nm[ns..ne): the newest decisive B line of that name, by run id.
pub fn mj_master(raw : []const u8, n : usize, nm : []const u8, ns : usize, ne : usize) -> u8 {
    var best : u8 = M_UNSEEN;
    var b0 : usize = 0;
    var b1 : usize = 0;
    var f : [10]usize = undefined;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = qc_line_end(raw, n, ls);
        if (le > ls) {
            if (mj_tag(raw, ls, le) == 'B' and qc_split(raw, ls, le, &f, 5)) {
                if (mj_same(raw, f[2], f[3], nm, ns, ne) and run_ok(raw, f[4], f[5]) and qc_range_is(raw, f[6], f[7], "COMPLETED", 9)) {
                    var v : u8 = M_UNSEEN;
                    if (qc_range_is(raw, f[8], f[9], "SUCCESS", 7)) { v = M_GREEN; }
                    if (qc_range_is(raw, f[8], f[9], "FAILURE", 7)) { v = M_RED; }
                    if (v != M_UNSEEN) {
                        if (best == M_UNSEEN or run_gt(raw, f[4], f[5], b0, b1)) {
                            best = v;
                            b0 = f[4];
                            b1 = f[5];
                        } else if (v == M_GREEN and qc_range_eq(raw, f[4], f[5], b0, b1)) {
                            best = M_GREEN;
                        }
                    }
                }
            }
        }
        ls = le + 1;
    }
    return best;
}

/// The F lines of pull request num as a newline-separated path list in buf. Returns how many F lines it has;
/// len[0] is the bytes the list needs (clipped at cap when larger).
pub fn mj_files(raw : []const u8, n : usize, num : u32, buf : []u8, cap : usize, len : []usize) -> u32 {
    var f : [6]usize = undefined;
    var w : usize = 0;
    var cnt : u32 = 0;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = qc_line_end(raw, n, ls);
        if (le > ls) {
            if (mj_tag(raw, ls, le) == 'F' and qc_split(raw, ls, le, &f, 3)) {
                if (parse_num(raw, f[2], f[3]) == (num as i32) and f[5] > f[4]) {
                    w = qc_put_range(buf, cap, w, raw, f[4], f[5]);
                    w = put_str(buf, cap, w, "\n", 1);
                    cnt += 1;
                }
            }
        }
        ls = le + 1;
    }
    len[0] = w;
    return cnt;
}

/// The O lines of pull request num that name the check nm[ns..ne), their paths as a newline-separated list in
/// buf (a `-` path adds nothing). Returns how many O lines name the check; len[0] is the bytes needed.
pub fn mj_named(raw : []const u8, n : usize, num : u32, nm : []const u8, ns : usize, ne : usize, buf : []u8, cap : usize, len : []usize) -> u32 {
    var f : [8]usize = undefined;
    var w : usize = 0;
    var cnt : u32 = 0;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = qc_line_end(raw, n, ls);
        if (le > ls) {
            if (mj_tag(raw, ls, le) == 'O' and qc_split(raw, ls, le, &f, 4)) {
                if (parse_num(raw, f[2], f[3]) == (num as i32) and mj_same(raw, f[4], f[5], nm, ns, ne)) {
                    cnt += 1;
                    if (qc_range_is(raw, f[6], f[7], "-", 1) == false and f[7] > f[6]) {
                        w = qc_put_range(buf, cap, w, raw, f[6], f[7]);
                        w = put_str(buf, cap, w, "\n", 1);
                    }
                }
            }
        }
        ls = le + 1;
    }
    len[0] = w;
    return cnt;
}

/// RS_* : what one non-required red check comes to.
pub const RS_INHERITED : u8 = 0;
pub const RS_OWN : u8 = 1;
pub const RS_LOG : u8 = 2;

/// The state of one live red check, named nm[ns..ne), of pull request num, which changes files_total files.
/// r[0] gets red_origin's reason code when the state is RS_INHERITED or RS_OWN.
pub fn mj_red_state(raw : []const u8, n : usize, num : u32, nm : []const u8, ns : usize, ne : usize, files_total : i32, r : []u8) -> u8 {
    const master : u8 = mj_master(raw, n, nm, ns, ne);
    if (master != M_RED) {
        r[0] = red_reason("", 0, "", 0, "", 0, master);
        if (verdict_of(r[0]) == V_INHERITED) { return RS_INHERITED; }
        return RS_OWN;
    }
    var fl : [16384]u8 = undefined;
    var nl : [16384]u8 = undefined;
    var flen : [1]usize = undefined;
    var nlen : [1]usize = undefined;
    const fc : u32 = mj_files(raw, n, num, &fl, MJ_LIST_CAP, &flen);
    const nc : u32 = mj_named(raw, n, num, nm, ns, ne, &nl, MJ_LIST_CAP, &nlen);
    if (nc == 0 or (fc as i32) != files_total or flen[0] > MJ_LIST_CAP or nlen[0] > MJ_LIST_CAP) { return RS_LOG; }
    r[0] = red_reason(&fl, flen[0], &nl, nlen[0], "", 0, master);
    if (verdict_of(r[0]) == V_INHERITED) { return RS_INHERITED; }
    return RS_OWN;
}

/// Rule 11 over the table rs[0..rn) of pull request num. res[0] is J_MERGE when every live red is
/// inherited, J_RED when one is the PR's own or unknown (res[1] = start in raw of its K line, res[2] = the
/// reason code), else J_LOG (res[1] = its K line). With emit, writes into out at w one L line for every red
/// whose log is wanted; returns the cursor.
pub fn mj_reds(raw : []const u8, n : usize, rs : []const u8, rn : usize, pos : []const usize, num : u32, files_total : i32, emit : bool, out : []u8, cap : usize, w0 : usize, res : []usize) -> usize {
    var f : [8]usize = undefined;
    var r : [1]u8 = undefined;
    var w : usize = w0;
    res[0] = J_MERGE as usize;
    res[1] = 0;
    res[2] = 0;
    var own : bool = false;
    var logged : bool = false;
    var row : usize = 0;
    var ls : usize = 0;
    while (ls < rn) {
        const le : usize = qc_line_end(rs, rn, ls);
        if (le > ls) {
            if (mj_row_kind(rs, rn, ls, le) == KIND_OTHER and qc_split(rs, ls, le, &f, 4)) {
                const st : u8 = mj_red_state(raw, n, num, rs, f[0], f[1], files_total, &r);
                if (st == RS_OWN and own == false) {
                    own = true;
                    res[0] = J_RED as usize;
                    res[1] = pos[row];
                    res[2] = r[0] as usize;
                }
                if (st == RS_LOG) {
                    if (own == false and logged == false) {
                        logged = true;
                        res[0] = J_LOG as usize;
                        res[1] = pos[row];
                    }
                    if (emit) {
                        w = put_str(out, cap, w, "L\t", 2);
                        w = put_count(out, cap, w, num);
                        w = put_byte(out, cap, w, '\t');
                        w = qc_put_range(out, cap, w, rs, f[0], f[1]);
                        w = put_byte(out, cap, w, '\t');
                        w = qc_put_range(out, cap, w, rs, f[2], f[3]);
                        w = put_byte(out, cap, w, '\n');
                    }
                }
            }
            row += 1;
        }
        ls = le + 1;
    }
    return w;
}

// ---- the decision for one pull request ----

/// The decision for the block raw[bs..be) whose P line has the 14 split fields f. det[0] is the start in raw
/// of the K line a reason names (J_REQ_RED, J_LOG, J_RED), det[1] red_origin's reason for J_RED.
pub fn mj_judge(raw : []const u8, n : usize, bs : usize, be : usize, f : []const usize, det : []usize) -> u8 {
    det[0] = 0;
    det[1] = 0;
    if (mj_p_ok(raw, f) == false) { return J_BAD; }
    if (mj_block_clean(raw, bs, be) == false) { return J_BAD; }
    if (rf_label_held(raw, f[8], f[9])) { return J_HELD; }
    if (rf_flag(raw, f[6], f[7]) == T_TRUE) { return J_DRAFT; }
    if (qc_range_is(raw, f[12], f[13], "master", 6) == false) { return J_BASE; }
    if (mj_starts(raw, f[10], f[11], "queen-", 6)) { return J_BEE; }
    const mc : u8 = rf_merge_class(raw, f[14], f[15], f[16], f[17]);
    if (mc == M_CONFLICT) { return J_CONFLICT; }
    if (mc == M_UNKNOWN) { return J_UNKNOWN; }
    if (parse_num(raw, f[18], f[19]) == 0) { return J_NO_CLOSE; }
    var rs : [16384]u8 = undefined;
    var pos : [128]usize = undefined;
    var ln : [1]usize = undefined;
    const rows : u32 = mj_rows(raw, bs, be, &rs, MJ_TABLE_CAP, &pos, &ln);
    if (rows > MJ_MAX_ROWS or ln[0] > MJ_TABLE_CAP) { return J_UNREAD; }
    if ((rows as i32) != parse_num(raw, f[24], f[25])) { return J_UNREAD; }
    if (qc_range_eq(raw, f[4], f[5], f[20], f[21]) == false) { return J_UNREAD; }
    var st : [5]u32 = undefined;
    latest_counts(&rs, ln[0], &st);
    if (st[K_BAD] > 0) { return J_UNREAD; }
    if (st[K_WAIT] > 0 or st[K_PASS] + st[K_FAIL] == 0) { return J_PENDING; }
    var rq : [5]u32 = undefined;
    required_counts(&rs, ln[0], &rq);
    if (rq[K_FAIL] > 0) {
        const k : i32 = mj_first_kind(&rs, ln[0], KIND_REQ);
        if (k >= 0) { det[0] = pos[k as usize]; }
        return J_REQ_RED;
    }
    if (rq[RR_MISSING] > 0) { return J_REQ_MISSING; }
    var res : [3]usize = undefined;
    var sink : [1]u8 = undefined;
    mj_reds(raw, n, &rs, ln[0], &pos, parse_num(raw, f[2], f[3]) as u32, parse_num(raw, f[26], f[27]), false, &sink, 0, 0, &res);
    if (res[0] != (J_MERGE as usize)) {
        det[0] = res[1];
        det[1] = res[2];
        return res[0] as u8;
    }
    const age : i32 = parse_num(raw, f[22], f[23]);
    if (age < QUIET_SECS) { return J_QUIET; }
    return J_MERGE;
}

// ---- the plan ----

fn mj_put_name(out : []u8, cap : usize, w : usize, raw : []const u8, p : usize) -> usize {
    return qc_put_range(out, cap, w, raw, p + 2, mj_name_end(raw, p));
}

/// The reason text of decision d into out at w, with the check name and red_origin's line where the
/// decision names a check.
fn mj_put_reason(out : []u8, cap : usize, w : usize, d : u8, raw : []const u8, p : usize, why : u8) -> usize {
    var x : usize = put_str(out, cap, w, J_TEXTS[d as usize], J_LENS[d as usize]);
    if (d == J_REQ_RED or d == J_LOG) {
        x = mj_put_name(out, cap, x, raw, p);
        x = put_byte(out, cap, x, '\n');
    }
    if (d == J_RED) {
        x = mj_put_name(out, cap, x, raw, p);
        x = put_str(out, cap, x, ": ", 2);
        if (verdict_of(why) == V_OWN) { x = put_str(out, cap, x, "own: ", 5); } else { x = put_str(out, cap, x, "unknown: ", 9); }
        x = put_str(out, cap, x, WHY_TEXTS[why as usize], WHY_LENS[why as usize]);
    }
    return x;
}

/// The answer for the facts in raw[0..n), into out. Returns the bytes it needs; when that exceeds cap the
/// buffer holds a clipped answer that must not be acted on.
pub fn merge_plan(raw : []const u8, n : usize, out : []u8, cap : usize) -> usize {
    var bs : [512]usize = undefined;
    var be : [512]usize = undefined;
    var dec : [512]u8 = undefined;
    var num : [512]u32 = undefined;
    var rk : [512]u32 = undefined;
    var dp : [512]usize = undefined;
    var dy : [512]u8 = undefined;
    var sp : [512]usize = undefined;
    var ft : [512]i32 = undefined;
    var f : [28]usize = undefined;
    var det : [2]usize = undefined;
    var cnt : usize = 0;
    var extra : u32 = 0;
    var ls : usize = 0;
    while (ls < n) {
        const le : usize = qc_line_end(raw, n, ls);
        if (le > ls) {
            const t : u8 = mj_tag(raw, ls, le);
            if (t == 'P') {
                if (cnt < MJ_MAX_PRS) {
                    bs[cnt] = ls;
                    cnt += 1;
                } else {
                    extra += 1;
                }
            } else if (t != 'B' and t != 'R' and t != 'F' and t != 'O' and cnt == 0) {
                extra += 1;
            }
        }
        ls = le + 1;
    }
    var i : usize = 0;
    while (i < cnt) {
        if (i + 1 < cnt) { be[i] = bs[i + 1]; } else { be[i] = n; }
        dec[i] = J_BAD;
        num[i] = 0;
        dp[i] = 0;
        dy[i] = 0;
        sp[i] = 0;
        ft[i] = -1;
        const le : usize = qc_line_end(raw, n, bs[i]);
        var fe : usize = bs[i] + 2;
        while (fe < le and raw[fe] != '\t') { fe += 1; }
        const pn : i32 = parse_num(raw, bs[i] + 2, fe);
        if (pn > 0) { num[i] = pn as u32; }
        if (pn > 0 and qc_split(raw, bs[i], le, &f, MJ_PF)) {
            sp[i] = f[4];
            ft[i] = parse_num(raw, f[26], f[27]);
            dec[i] = mj_judge(raw, n, bs[i], be[i], &f, &det);
            dp[i] = det[0];
            dy[i] = det[1] as u8;
        }
        var j : usize = 0;
        while (j < i) {
            if (num[i] != 0 and num[j] == num[i]) { dec[i] = J_BAD; }
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < cnt) {
        rk[i] = 0;
        if (dec[i] == J_MERGE) {
            var j : usize = 0;
            while (j < cnt) {
                if (dec[j] == J_MERGE and num[j] < num[i]) { rk[i] += 1; }
                j += 1;
            }
        }
        i += 1;
    }
    i = 0;
    while (i < cnt) {
        if (dec[i] == J_MERGE and rk[i] >= MERGE_CAP) { dec[i] = J_CAPPED; }
        i += 1;
    }
    var w : usize = 0;
    var r : u32 = 0;
    while (r < MERGE_CAP) {
        i = 0;
        while (i < cnt) {
            if (dec[i] == J_MERGE and rk[i] == r) {
                w = put_str(out, cap, w, "G\t", 2);
                w = put_count(out, cap, w, num[i]);
                w = put_byte(out, cap, w, '\t');
                w = qc_put_range(out, cap, w, raw, sp[i], sp[i] + 40);
                w = put_byte(out, cap, w, '\n');
            }
            i += 1;
        }
        r += 1;
    }
    var st : [17]u32 = undefined;
    var c : usize = 0;
    while (c < J_COUNT) {
        st[c] = 0;
        c += 1;
    }
    i = 0;
    while (i < cnt) {
        st[dec[i] as usize] += 1;
        if (dec[i] != J_MERGE) {
            w = put_byte(out, cap, w, J_CLASS[dec[i] as usize]);
            w = put_byte(out, cap, w, '\t');
            if (num[i] == 0) { w = put_byte(out, cap, w, '-'); } else { w = put_count(out, cap, w, num[i]); }
            w = put_byte(out, cap, w, '\t');
            w = mj_put_reason(out, cap, w, dec[i], raw, dp[i], dy[i]);
        }
        i += 1;
    }
    i = 0;
    while (i < cnt) {
        if (dec[i] == J_LOG) {
            var rs : [16384]u8 = undefined;
            var pos : [128]usize = undefined;
            var ln : [1]usize = undefined;
            var res : [3]usize = undefined;
            mj_rows(raw, bs[i], be[i], &rs, MJ_TABLE_CAP, &pos, &ln);
            w = mj_reds(raw, n, &rs, ln[0], &pos, num[i], ft[i], true, out, cap, w, &res);
        }
        i += 1;
    }
    const bad : u32 = st[J_BAD as usize] + extra;
    const waiting : u32 = st[J_UNKNOWN as usize] + st[J_CONFLICT as usize] + st[J_NO_CLOSE as usize] + st[J_UNREAD as usize] + st[J_PENDING as usize] + st[J_REQ_RED as usize] + st[J_REQ_MISSING as usize] + st[J_LOG as usize] + st[J_QUIET as usize];
    w = put_str(out, cap, w, MJ_SUM_HEAD, MJ_SUM_HEAD_LEN);
    w = put_count(out, cap, w, st[J_MERGE as usize]);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[0], MJ_SUM_LENS[0]);
    w = put_count(out, cap, w, st[J_CAPPED as usize]);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[1], MJ_SUM_LENS[1]);
    w = put_count(out, cap, w, waiting);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[2], MJ_SUM_LENS[2]);
    w = put_count(out, cap, w, st[J_HELD as usize] + st[J_DRAFT as usize] + st[J_BASE as usize] + st[J_RED as usize]);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[3], MJ_SUM_LENS[3]);
    w = put_count(out, cap, w, st[J_BEE as usize]);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[4], MJ_SUM_LENS[4]);
    w = put_count(out, cap, w, bad);
    w = put_str(out, cap, w, MJ_SUM_TEXTS[5], MJ_SUM_LENS[5]);
    w = put_count(out, cap, w, (cnt as u32) + extra);
    return put_str(out, cap, w, MJ_SUM_TAIL, MJ_SUM_TAIL_LEN);
}

/// The lane's two plans behind one entry, so the job lowers one file: kind 0 is merge_plan, kind 1 is
/// refresh_plan with `queued` workflow runs queued (negative: unread). Any other kind answers nothing.
pub fn lane_plan(kind : u32, raw : []const u8, n : usize, out : []u8, cap : usize, queued : i32) -> usize {
    if (kind == 0) { return merge_plan(raw, n, out, cap); }
    if (kind == 1) { return refresh_plan(raw, n, out, cap, queued); }
    return 0;
}

// ---- test helpers: build the stream from small codes, so a test states the case and not the bytes ----

pub const T_NAMES : [9]str = [
    "Schema Validation/validate", "Issue Gate/check-linked-issue", "Spec Parse Ratchet/parse-ratchet",
    "Own Language/own-language", "Corpus Ratchet/Corpus ratchet (expected-failure ledger)",
    "Gate Topology/claw-sarif", "t27b native/t27b-native-ratchet", "Spec Guards/spec-guards", "Seal Coverage/coverage"
];
pub const T_NLENS : [9]usize = [26, 29, 32, 25, 55, 24, 31, 23, 22];
pub const T_PATHS : [4]str = ["specs/claw/merge_judge.t27", "docs/claw/README.md", "specs/analog/new_circuit.t27", "tools/unrelated.py"];
pub const T_PLENS : [4]usize = [26, 19, 28, 18];

/// A 40-digit sha: the digit d, then 39 `a`.
fn t_sha(dst : []u8, cap : usize, w : usize, d : u32) -> usize {
    var x : usize = put_byte(dst, cap, w, digit_byte(d % 10));
    var k : usize = 1;
    while (k < 40) {
        x = put_byte(dst, cap, x, 'a');
        k += 1;
    }
    return x;
}

/// One P line. labels: 0 none, 1 no-auto-merge, 2 bug,no-auto-merge,x, 3 no-auto-merge-2, 4 x-no-auto-merge,
/// 5 bug,x. head: 0 feature-x, 1 queen-77, 2 queenly-x, 3 xqueen-77, 9 empty. base: 0 master, 1 stack-base,
/// 2 master2, 9 empty.
/// mg: 0 MERGEABLE, 1 CONFLICTING, 2 UNKNOWN. sc: 0 CLEAN, 1 DIRTY, 2 BLOCKED. rd: the digit of the
/// rollup sha (the sha of PR num starts with num % 10). age: seconds, 9999999 for `-`.
fn t_p(dst : []u8, cap : usize, w : usize, num : u32, draft : bool, labels : u32, head : u32, base : u32, mg : u32, sc : u32, closing : u32, rd : u32, age : u32, total : u32, files : u32) -> usize {
    var x : usize = put_str(dst, cap, w, "P\t", 2);
    x = put_count(dst, cap, x, num);
    x = put_byte(dst, cap, x, '\t');
    x = t_sha(dst, cap, x, num);
    x = put_byte(dst, cap, x, '\t');
    if (draft) { x = put_str(dst, cap, x, "true", 4); } else { x = put_str(dst, cap, x, "false", 5); }
    x = put_byte(dst, cap, x, '\t');
    if (labels == 1) { x = put_str(dst, cap, x, "no-auto-merge", 13); }
    if (labels == 2) { x = put_str(dst, cap, x, "bug,no-auto-merge,x", 19); }
    if (labels == 3) { x = put_str(dst, cap, x, "no-auto-merge-2", 15); }
    if (labels == 4) { x = put_str(dst, cap, x, "x-no-auto-merge", 15); }
    if (labels == 5) { x = put_str(dst, cap, x, "bug,x", 5); }
    x = put_byte(dst, cap, x, '\t');
    if (head == 0) { x = put_str(dst, cap, x, "feature-x", 9); }
    if (head == 1) { x = put_str(dst, cap, x, "queen-77", 8); }
    if (head == 2) { x = put_str(dst, cap, x, "queenly-x", 9); }
    if (head == 3) { x = put_str(dst, cap, x, "xqueen-77", 9); }
    x = put_byte(dst, cap, x, '\t');
    if (base == 0) { x = put_str(dst, cap, x, "master", 6); }
    if (base == 1) { x = put_str(dst, cap, x, "stack-base", 10); }
    if (base == 2) { x = put_str(dst, cap, x, "master2", 7); }
    x = put_byte(dst, cap, x, '\t');
    if (mg == 0) { x = put_str(dst, cap, x, "MERGEABLE", 9); }
    if (mg == 1) { x = put_str(dst, cap, x, "CONFLICTING", 11); }
    if (mg == 2) { x = put_str(dst, cap, x, "UNKNOWN", 7); }
    x = put_byte(dst, cap, x, '\t');
    if (sc == 0) { x = put_str(dst, cap, x, "CLEAN", 5); }
    if (sc == 1) { x = put_str(dst, cap, x, "DIRTY", 5); }
    if (sc == 2) { x = put_str(dst, cap, x, "BLOCKED", 7); }
    x = put_byte(dst, cap, x, '\t');
    x = put_count(dst, cap, x, closing);
    x = put_byte(dst, cap, x, '\t');
    x = t_sha(dst, cap, x, rd);
    x = put_byte(dst, cap, x, '\t');
    if (age == 9999999) { x = put_byte(dst, cap, x, '-'); } else { x = put_count(dst, cap, x, age); }
    x = put_byte(dst, cap, x, '\t');
    x = put_count(dst, cap, x, total);
    x = put_byte(dst, cap, x, '\t');
    x = put_count(dst, cap, x, files);
    return put_byte(dst, cap, x, '\n');
}

/// status and conclusion. sc: 0 COMPLETED SUCCESS, 1 COMPLETED FAILURE, 2 QUEUED, 3 IN_PROGRESS,
/// 4 COMPLETED SKIPPED, 5 COMPLETED CANCELLED.
fn t_status(dst : []u8, cap : usize, w : usize, sc : u32) -> usize {
    if (sc == 0) { return put_str(dst, cap, w, "COMPLETED\tSUCCESS", 17); }
    if (sc == 1) { return put_str(dst, cap, w, "COMPLETED\tFAILURE", 17); }
    if (sc == 2) { return put_str(dst, cap, w, "QUEUED\t-", 8); }
    if (sc == 3) { return put_str(dst, cap, w, "IN_PROGRESS\t-", 13); }
    if (sc == 4) { return put_str(dst, cap, w, "COMPLETED\tSKIPPED", 17); }
    return put_str(dst, cap, w, "COMPLETED\tCANCELLED", 19);
}

/// One K or B line: tag, check name by code, run id, status by code.
fn t_row(dst : []u8, cap : usize, w : usize, tag : u8, name : u32, run : u32, sc : u32) -> usize {
    var x : usize = put_byte(dst, cap, w, tag);
    x = put_byte(dst, cap, x, '\t');
    x = put_str(dst, cap, x, T_NAMES[name as usize], T_NLENS[name as usize]);
    x = put_byte(dst, cap, x, '\t');
    x = put_count(dst, cap, x, run);
    x = put_byte(dst, cap, x, '\t');
    x = t_status(dst, cap, x, sc);
    return put_byte(dst, cap, x, '\n');
}

/// The four required checks and spec-guards, all passed: run ids run0 .. run0 + 4.
fn t_good_rows(dst : []u8, cap : usize, w : usize, run0 : u32) -> usize {
    var x : usize = t_row(dst, cap, w, 'K', 0, run0, 0);
    x = t_row(dst, cap, x, 'K', 1, run0 + 1, 0);
    x = t_row(dst, cap, x, 'K', 2, run0 + 2, 0);
    x = t_row(dst, cap, x, 'K', 3, run0 + 3, 0);
    return t_row(dst, cap, x, 'K', 7, run0 + 4, 0);
}

/// An F line (pull request, path by code) or an O line (pull request, check by name code, path by code; 9 is `-`).
fn t_file(dst : []u8, cap : usize, w : usize, num : u32, pidx : u32) -> usize {
    var x : usize = put_str(dst, cap, w, "F\t", 2);
    x = put_count(dst, cap, x, num);
    x = put_byte(dst, cap, x, '\t');
    x = put_str(dst, cap, x, T_PATHS[pidx as usize], T_PLENS[pidx as usize]);
    return put_byte(dst, cap, x, '\n');
}

fn t_named(dst : []u8, cap : usize, w : usize, num : u32, name : u32, pidx : u32) -> usize {
    var x : usize = put_str(dst, cap, w, "O\t", 2);
    x = put_count(dst, cap, x, num);
    x = put_byte(dst, cap, x, '\t');
    x = put_str(dst, cap, x, T_NAMES[name as usize], T_NLENS[name as usize]);
    x = put_byte(dst, cap, x, '\t');
    if (pidx == 9) { x = put_byte(dst, cap, x, '-'); } else { x = put_str(dst, cap, x, T_PATHS[pidx as usize], T_PLENS[pidx as usize]); }
    return put_byte(dst, cap, x, '\n');
}

/// PR num with nothing wrong: not a draft, no label, a feature branch into master, mergeable, one closing
/// reference, an hour old, five passed checks, two changed files.
fn t_green(dst : []u8, cap : usize, w : usize, num : u32) -> usize {
    const x : usize = t_p(dst, cap, w, num, false, 0, 0, 0, 0, 0, 1, num, 3600, 5, 2);
    return t_good_rows(dst, cap, x, 100);
}

/// PR 5 with the given facts and five passed checks.
fn t_v(dst : []u8, cap : usize, draft : bool, labels : u32, head : u32, base : u32, mg : u32, sc : u32, closing : u32, age : u32) -> usize {
    const x : usize = t_p(dst, cap, 0, 5, draft, labels, head, base, mg, sc, closing, 5, age, 5, 2);
    return t_good_rows(dst, cap, x, 100);
}

/// The decision for the first P line of raw[0..n) as one block.
fn t_one(raw : []const u8, n : usize) -> u8 {
    var f : [28]usize = undefined;
    var det : [2]usize = undefined;
    var ls : usize = 0;
    while (ls < n and mj_tag(raw, ls, qc_line_end(raw, n, ls)) != 'P') { ls = qc_line_end(raw, n, ls) + 1; }
    if (qc_split(raw, ls, qc_line_end(raw, n, ls), &f, MJ_PF) == false) { return J_BAD; }
    return mj_judge(raw, n, ls, n, &f, &det);
}

/// Whether out holds the line `G TAB num TAB sha` (the sha of PR num).
fn t_g(out : []const u8, n : usize, num : u32) -> bool {
    var e : [64]u8 = undefined;
    var w : usize = put_str(&e, 64, 0, "G\t", 2);
    w = put_count(&e, 64, w, num);
    w = put_byte(&e, 64, w, '\t');
    w = t_sha(&e, 64, w, num);
    w = put_byte(&e, 64, w, '\n');
    return buf_has(out, n, &e, w);
}

/// Whether out holds a line that starts `<c> TAB num TAB` and the reason text of decision d.
fn t_has(out : []const u8, n : usize, c : u8, num : u32, d : u8) -> bool {
    var e : [160]u8 = undefined;
    var w : usize = put_byte(&e, 160, 0, c);
    w = put_byte(&e, 160, w, '\t');
    w = put_count(&e, 160, w, num);
    w = put_byte(&e, 160, w, '\t');
    w = put_str(&e, 160, w, J_TEXTS[d as usize], J_LENS[d as usize]);
    return buf_has(out, n, &e, w);
}

/// Whether out holds the line that starts `<c> TAB num TAB`, the text of decision d and the check by code.
fn t_has_named(out : []const u8, n : usize, c : u8, num : u32, d : u8, name : u32) -> bool {
    var e : [240]u8 = undefined;
    var w : usize = put_byte(&e, 240, 0, c);
    w = put_byte(&e, 240, w, '\t');
    w = put_count(&e, 240, w, num);
    w = put_byte(&e, 240, w, '\t');
    w = put_str(&e, 240, w, J_TEXTS[d as usize], J_LENS[d as usize]);
    w = put_str(&e, 240, w, T_NAMES[name as usize], T_NLENS[name as usize]);
    return buf_has(out, n, &e, w);
}

/// Whether out holds the summary line with these counts.
fn t_summary(out : []const u8, n : usize, g : u32, c : u32, wt : u32, h : u32, nm : u32, bad : u32, total : u32) -> bool {
    var e : [200]u8 = undefined;
    var w : usize = put_str(&e, 200, 0, "M\tclaw-merge: ", 14);
    w = put_count(&e, 200, w, g);
    w = put_str(&e, 200, w, " to merge, ", 11);
    w = put_count(&e, 200, w, c);
    w = put_str(&e, 200, w, " over the cap, ", 15);
    w = put_count(&e, 200, w, wt);
    w = put_str(&e, 200, w, " waiting, ", 10);
    w = put_count(&e, 200, w, h);
    w = put_str(&e, 200, w, " held, ", 7);
    w = put_count(&e, 200, w, nm);
    w = put_str(&e, 200, w, " not mine, ", 11);
    w = put_count(&e, 200, w, bad);
    w = put_str(&e, 200, w, " unreadable of ", 15);
    w = put_count(&e, 200, w, total);
    w = put_str(&e, 200, w, " open\n", 6);
    return buf_has(out, n, &e, w);
}

// ---- tests: one per rule, first match wins ----

test a_pull_request_that_passes_every_rule_is_merged_pinned_to_its_head_sha {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    const n : usize = t_green(&raw, 4096, 0, 7);
    assert t_one(&raw, n) == J_MERGE;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_g(&out, m, 7);
    assert t_lines(&out, m, 'G') == 1;
    assert t_lines(&out, m, 'W') + t_lines(&out, m, 'H') + t_lines(&out, m, 'N') + t_lines(&out, m, 'L') == 0;
    assert t_summary(&out, m, 1, 0, 0, 0, 0, 0, 1);
}

test rule_1_the_held_label_holds_whatever_else_is_true {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 1, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_HELD;
    n = t_v(&raw, 4096, false, 2, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_HELD;
    n = t_v(&raw, 4096, true, 1, 1, 1, 1, 1, 0, 0);
    assert t_one(&raw, n) == J_HELD;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'H', 5, J_HELD);
    assert t_lines(&out, m, 'G') == 0;
}

test rule_1_only_the_whole_label_holds {
    var raw : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 3, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 4, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 5, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
}

test rule_2_a_draft_is_never_touched {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    const n : usize = t_v(&raw, 4096, true, 0, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_DRAFT;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'H', 5, J_DRAFT);
    assert t_summary(&out, m, 0, 0, 0, 1, 0, 0, 1);
}

test rule_3_only_master_is_merged_into {
    var raw : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 0, 0, 1, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_BASE;
    n = t_v(&raw, 4096, false, 0, 0, 2, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_BASE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
}

test rule_4_a_bee_branch_is_not_mine {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 0, 1, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_BEE;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'N', 5, J_BEE);
    assert t_summary(&out, m, 0, 0, 0, 0, 1, 0, 1);
    n = t_v(&raw, 4096, false, 0, 2, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 0, 3, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
}

test rule_5_a_conflict_waits_and_the_lane_never_resolves_it {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 0, 0, 0, 1, 2, 1, 3600);
    assert t_one(&raw, n) == J_CONFLICT;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 1, 1, 3600);
    assert t_one(&raw, n) == J_CONFLICT;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_CONFLICT);
    assert t_summary(&out, m, 0, 0, 1, 0, 0, 0, 1);
}

test rule_5_a_mergeability_github_has_not_computed_waits {
    var raw : [4096]u8 = undefined;
    const n : usize = t_v(&raw, 4096, false, 0, 0, 0, 2, 2, 1, 3600);
    assert t_one(&raw, n) == J_UNKNOWN;
}

test rule_6_no_closing_reference_waits {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 0, 3600);
    assert t_one(&raw, n) == J_NO_CLOSE;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_NO_CLOSE);
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 3, 3600);
    assert t_one(&raw, n) == J_MERGE;
}

test the_first_matching_rule_names_the_reason {
    // Break every rule at once, then repair them in order: each repair exposes the next rule.
    var raw : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, true, 1, 1, 1, 1, 1, 0, 10);
    assert t_one(&raw, n) == J_HELD;
    n = t_v(&raw, 4096, true, 0, 1, 1, 1, 1, 0, 10);
    assert t_one(&raw, n) == J_DRAFT;
    n = t_v(&raw, 4096, false, 0, 1, 1, 1, 1, 0, 10);
    assert t_one(&raw, n) == J_BASE;
    n = t_v(&raw, 4096, false, 0, 1, 0, 1, 1, 0, 10);
    assert t_one(&raw, n) == J_BEE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 1, 1, 0, 10);
    assert t_one(&raw, n) == J_CONFLICT;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 0, 10);
    assert t_one(&raw, n) == J_NO_CLOSE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 10);
    assert t_one(&raw, n) == J_QUIET;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 3600);
    assert t_one(&raw, n) == J_MERGE;
}

// ---- tests: the rollup (rules 7 to 10) ----

test rule_7_a_rollup_that_is_not_the_head_commits_is_not_read {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 6, 3600, 5, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    assert t_one(&raw, w) == J_UNREAD;
    const m : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_UNREAD);
    assert t_lines(&out, m, 'G') == 0;
}

test rule_7_a_rollup_cut_short_is_not_read {
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    assert t_one(&raw, w) == J_UNREAD;
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 4, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    assert t_one(&raw, w) == J_UNREAD;
}

test rule_7_a_row_that_cannot_be_read_is_not_read {
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = put_str(&raw, 4096, w, "K\tonly two fields\tCOMPLETED\n", 28);
    assert t_one(&raw, w) == J_UNREAD;
    // a K line with a run id that is not a number
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = put_str(&raw, 4096, w, "K\tIssue Gate/check-linked-issue\tx\tCOMPLETED\tSUCCESS\n", 52);
    assert t_one(&raw, w) == J_UNREAD;
}

test rule_7_more_rows_than_the_lane_reads_are_not_read {
    var raw : [16384]u8 = undefined;
    var w : usize = t_p(&raw, 16384, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 129, 2);
    var k : u32 = 0;
    while (k < 129) {
        w = t_row(&raw, 16384, w, 'K', 7, 1000 + k, 0);
        k += 1;
    }
    assert t_one(&raw, w) == J_UNREAD;
    w = t_p(&raw, 16384, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 128, 2);
    k = 0;
    while (k < 124) {
        w = t_row(&raw, 16384, w, 'K', 7, 1000 + k, 0);
        k += 1;
    }
    w = t_row(&raw, 16384, w, 'K', 0, 5000, 0);
    w = t_row(&raw, 16384, w, 'K', 1, 5001, 0);
    w = t_row(&raw, 16384, w, 'K', 2, 5002, 0);
    w = t_row(&raw, 16384, w, 'K', 3, 5003, 0);
    assert t_one(&raw, w) == J_MERGE;
}

test rule_8_a_check_still_running_waits {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 8, 200, 2);
    assert t_one(&raw, w) == J_PENDING;
    const m : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_PENDING);
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 8, 200, 3);
    assert t_one(&raw, w) == J_PENDING;
}

test rule_8_no_check_posted_is_not_green {
    var raw : [4096]u8 = undefined;
    const w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 0, 2);
    assert t_one(&raw, w) == J_PENDING;
}

test rule_8_skipped_is_a_pass_but_the_required_checks_must_still_post {
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 1, 2);
    w = t_row(&raw, 4096, w, 'K', 8, 200, 4);
    assert t_one(&raw, w) == J_REQ_MISSING;
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 8, 200, 4);
    assert t_one(&raw, w) == J_MERGE;
}

test rule_8_a_rerun_in_the_queue_supersedes_the_failure_it_replaces {
    // #10563 on 2026-10-19: check-linked-issue FAILURE (before its body was fixed), then the QUEUED re-run.
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 1, 50, 1);
    assert t_one(&raw, w) == J_MERGE;
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 1, 500, 1);
    assert t_one(&raw, w) == J_REQ_RED;
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 1, 500, 2);
    assert t_one(&raw, w) == J_PENDING;
}

test rule_9_a_required_check_that_is_red_blocks_and_is_named {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 5, 2);
    w = t_row(&raw, 4096, w, 'K', 0, 100, 0);
    w = t_row(&raw, 4096, w, 'K', 1, 101, 1);
    w = t_row(&raw, 4096, w, 'K', 2, 102, 0);
    w = t_row(&raw, 4096, w, 'K', 3, 103, 0);
    w = t_row(&raw, 4096, w, 'K', 7, 104, 0);
    assert t_one(&raw, w) == J_REQ_RED;
    const m : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has_named(&out, m, 'W', 5, J_REQ_RED, 1);
    assert t_lines(&out, m, 'G') == 0;
}

test rule_9_names_the_first_red_required_check_even_when_it_is_the_first_row {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 5, 2);
    w = t_row(&raw, 4096, w, 'K', 0, 100, 1);
    w = t_row(&raw, 4096, w, 'K', 1, 101, 0);
    w = t_row(&raw, 4096, w, 'K', 2, 102, 0);
    w = t_row(&raw, 4096, w, 'K', 3, 103, 0);
    w = t_row(&raw, 4096, w, 'K', 7, 104, 0);
    assert t_one(&raw, w) == J_REQ_RED;
    const m : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has_named(&out, m, 'W', 5, J_REQ_RED, 0);
    // two red required checks: the first in the table is named
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 5, 2);
    w = t_row(&raw, 4096, w, 'K', 0, 100, 0);
    w = t_row(&raw, 4096, w, 'K', 1, 101, 1);
    w = t_row(&raw, 4096, w, 'K', 2, 102, 0);
    w = t_row(&raw, 4096, w, 'K', 3, 103, 1);
    w = t_row(&raw, 4096, w, 'K', 7, 104, 0);
    const k : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has_named(&out, k, 'W', 5, J_REQ_RED, 1);
}

test rule_9_each_of_the_four_required_checks_blocks {
    var raw : [4096]u8 = undefined;
    var name : u32 = 0;
    while (name < 4) {
        var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 5, 2);
        var k : u32 = 0;
        while (k < 4) {
            if (k == name) { w = t_row(&raw, 4096, w, 'K', k, 100 + k, 1); } else { w = t_row(&raw, 4096, w, 'K', k, 100 + k, 0); }
            k += 1;
        }
        w = t_row(&raw, 4096, w, 'K', 7, 104, 0);
        assert t_one(&raw, w) == J_REQ_RED;
        name += 1;
    }
}

test rule_10_a_required_check_that_has_not_posted_is_missing {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 4, 2);
    w = t_row(&raw, 4096, w, 'K', 0, 100, 0);
    w = t_row(&raw, 4096, w, 'K', 1, 101, 0);
    w = t_row(&raw, 4096, w, 'K', 2, 102, 0);
    w = t_row(&raw, 4096, w, 'K', 7, 104, 0);
    assert t_one(&raw, w) == J_REQ_MISSING;
    const m : usize = merge_plan(&raw, w, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_REQ_MISSING);
}

test pending_outranks_a_required_red {
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 7, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = t_row(&raw, 4096, w, 'K', 0, 900, 1);
    w = t_row(&raw, 4096, w, 'K', 8, 901, 2);
    assert t_one(&raw, w) == J_PENDING;
}

test a_commit_status_is_read_by_its_state {
    var raw : [4096]u8 = undefined;
    var w : usize = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = put_str(&raw, 4096, w, "K\tcodecov/patch\t-\tCONTEXT\tSUCCESS\n", 34);
    assert t_one(&raw, w) == J_MERGE;
    w = t_p(&raw, 4096, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    w = t_good_rows(&raw, 4096, w, 100);
    w = put_str(&raw, 4096, w, "K\tcodecov/patch\t-\tCONTEXT\tPENDING\n", 34);
    assert t_one(&raw, w) == J_PENDING;
}

test rule_12_a_head_commit_younger_than_ten_minutes_waits {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 180);
    assert t_one(&raw, n) == J_QUIET;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has(&out, m, 'W', 5, J_QUIET);
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 599);
    assert t_one(&raw, n) == J_QUIET;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 600);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 601);
    assert t_one(&raw, n) == J_MERGE;
    n = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 0);
    assert t_one(&raw, n) == J_QUIET;
    assert QUIET_SECS == QUIET_MIN * 60;
}

test rule_12_an_age_nobody_could_read_waits {
    var raw : [4096]u8 = undefined;
    const n : usize = t_v(&raw, 4096, false, 0, 0, 0, 0, 0, 1, 9999999);
    assert t_one(&raw, n) == J_QUIET;
}

// ---- tests: rule 11, whose red is it ----

/// PR 5 with five passed checks and the check `name` red (run 300), two changed files declared.
fn t_red_pr(dst : []u8, cap : usize, w : usize, name : u32) -> usize {
    var x : usize = t_p(dst, cap, w, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, 6, 2);
    x = t_good_rows(dst, cap, x, 100);
    return t_row(dst, cap, x, 'K', name, 300, 1);
}

/// Whether out holds the H line of PR num for a red check, with red_origin's reason r.
fn t_has_red(out : []const u8, n : usize, num : u32, name : u32, r : u8) -> bool {
    var e : [400]u8 = undefined;
    var w : usize = put_str(&e, 400, 0, "H\t", 2);
    w = put_count(&e, 400, w, num);
    w = put_byte(&e, 400, w, '\t');
    w = put_str(&e, 400, w, "red check ", 10);
    w = put_str(&e, 400, w, T_NAMES[name as usize], T_NLENS[name as usize]);
    w = put_str(&e, 400, w, ": ", 2);
    if (verdict_of(r) == V_OWN) { w = put_str(&e, 400, w, "own: ", 5); } else { w = put_str(&e, 400, w, "unknown: ", 9); }
    w = put_str(&e, 400, w, WHY_TEXTS[r as usize], WHY_LENS[r as usize]);
    return buf_has(out, n, &e, w);
}

/// Whether out holds the line `L TAB num TAB check TAB id`.
fn t_has_log(out : []const u8, n : usize, num : u32, name : u32, id : u32) -> bool {
    var e : [160]u8 = undefined;
    var w : usize = put_str(&e, 160, 0, "L\t", 2);
    w = put_count(&e, 160, w, num);
    w = put_byte(&e, 160, w, '\t');
    w = put_str(&e, 160, w, T_NAMES[name as usize], T_NLENS[name as usize]);
    w = put_byte(&e, 160, w, '\t');
    w = put_count(&e, 160, w, id);
    w = put_byte(&e, 160, w, '\n');
    return buf_has(out, n, &e, w);
}

test claw_sarif_red_alone_is_inherited_by_definition_and_merges {
    // The TRI CLAW App lacks security_events:write (#10501): claw-sarif fails before it reads any code.
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    const n : usize = t_red_pr(&raw, 4096, 0, 5);
    assert t_one(&raw, n) == J_MERGE;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_g(&out, m, 5);
    assert t_summary(&out, m, 1, 0, 0, 0, 0, 0, 1);
}

test negative_control_a_corpus_ratchet_red_on_a_green_master_is_the_prs_own {
    // 2026-10-19: Corpus ratchet red while master's last finished run of it is green: the PR's merge with
    // master fails it, and only a rebase in the PR fixes it.
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_red_pr(&raw, 4096, 0, 4);
    n = t_row(&raw, 4096, n, 'B', 4, 250, 0);
    assert t_one(&raw, n) == J_RED;
    const m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has_red(&out, m, 5, 4, R_OWN_MERGE);
    assert t_lines(&out, m, 'G') == 0;
    assert t_summary(&out, m, 0, 0, 0, 1, 0, 0, 1);
}

test a_red_that_master_has_no_finished_run_of_is_unknown_and_holds {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
    var n : usize = t_red_pr(&raw, 4096, 0, 4);
    assert t_one(&raw, n) == J_RED;
    var m : usize = merge_plan(&raw, n, &out, 4096);
    assert t_has_red(&out, m, 5, 4, R_UNSEEN);
    // master's runs of other checks, and master runs that did not finish, say nothing about this one
    n = t_row(&raw, 4096, n, 'B', 3, 250, 1);
    n = t_row(&raw, 4096, n, 'B', 4, 251, 2);
    n = t_row(&raw, 4096, n, 'B', 4, 252, 5);
    n = t_row(&raw, 4096, n, 'B', 4, 253, 4);
    assert t_one(&raw, n) == J_RED;
}

test a_red_on_a_red_master_asks_for_the_failing_log_before_anything_else {
    var raw : [4096]u8 = undefined;
    var out : [4096]u8 = undefined;
