// Sibling blocks reuse a name: that is scope, not a redeclaration. The same
// names are used as locals in two functions and in two tests, and a test shares
// the name of a function (separate namespaces).
module SiblingBlocks;

pub const LIMIT : u32 = 25;

pub fn first() -> u32 {
    const limit : u32 = 1;
    var acc : u32 = 0;
    acc = acc + limit;
    return acc;
}

pub fn second() -> u32 {
    const limit : u32 = 2;
    var acc : u32 = 0;
    acc = acc + limit;
    return acc;
}

test "first" {
    const limit : u32 = 1;
    assert first() == limit;
}

test "second" {
    const limit : u32 = 2;
    assert second() == limit;
}
