module DupProbe;

pub const LIMIT : u32 = 25;
pub const LIMIT : u32 = 100;

pub fn pick() -> u32 {
    return 1;
}

pub fn pick() -> u32 {
    return 2;
}

test "the first LIMIT" {
    assert LIMIT == 25;
}

test "the last LIMIT" {
    assert LIMIT == 100;
}

test "the first pick" {
    assert pick() == 1;
}

test "the last pick" {
    assert pick() == 2;
}
