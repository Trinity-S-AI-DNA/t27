// #11182 control: a `[]T` field nothing in the module fills from borrowed storage; not refused.
module KeepDeclaredOnly;

pub const Pile = struct {
    items : []i64,
    size : usize,
};

fn size_of(p: Pile) -> usize {
    return p.size;
}

fn room(p: *Pile) -> bool {
    return p.size < p.items.len;
}

endmodule
