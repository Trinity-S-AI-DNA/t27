// #11182: the constructor stores the caller's slice in a `[]T` field. gen-rust would write `Vec<i64>` and move it.
module RefuseCtorParam;

pub const Pile = struct {
    items : []i64,
    size : usize,
};

fn empty(storage: []i64) -> Pile {
    return Pile{ .items = storage, .size = 0 };
}

endmodule
