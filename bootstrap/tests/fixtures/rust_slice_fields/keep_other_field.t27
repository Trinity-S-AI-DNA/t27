// #11182 control: `items` is a slice in one struct and a number in another; only the struct literal's own type counts.
module KeepOtherField;

pub const Pile = struct {
    items : []i64,
    size : usize,
};

pub const Count = struct {
    items : usize,
    size : usize,
};

fn count(storage: []i64) -> Count {
    return Count{ .items = storage.len, .size = 0 };
}

endmodule
