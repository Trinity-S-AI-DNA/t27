// #11181: a repeat of a list of ZEROS is still `{0}`, exactly; only a list with a non-zero element is refused.
module list_repeat_zero;
var zeros: [6]i32 = [_]i32{0, 0} ** 3;
fn zero_at(i: usize) -> i32 {
    return zeros[i];
}
test zeros_stay_zero {
    assert(zero_at(0) == 0);
    assert(zero_at(5) == 0);
}
