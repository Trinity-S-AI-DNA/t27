// #11183: an array literal local with no annotation has no type in C to follow, and `__auto_type a = { .. }`
// is not C ("cannot use '__auto_type' with initializer list"). The element type is the first element's, so a
// list of enum members, names, casts, bools, chars, fields, expressions or strings declares a real array. A module
// constant list was an `int` holding a brace list.
module untyped_list;
pub const Mode = enum(u8) { Idle, Run, Halt };
pub const Cells = struct { lo: u16, hi: u16 };
const SEED: u32 = 9;
const DATA = [3, 1, 4, 1, 5, 9];
const WORDS = ["alpha", "beta"];
const LIMITS = [SEED, SEED + 1];
fn two() -> i32 { return 2; }
fn mode_second() -> bool { const modes = [Mode.Idle, Mode.Halt, Mode.Run]; return modes[1] == Mode.Halt; }
fn mode_third() -> bool { const modes = [Mode.Idle, Mode.Halt, Mode.Run]; return modes[2] == Mode.Halt; }
fn mode_inferred() -> bool { const modes = [.Idle, .Halt]; return modes[1] == Mode.Halt; }
fn param_list(a: u32, b: u32) -> u32 { var xs = [a, b, a + b]; return xs[2]; }
fn cast_list() -> i32 { var xs = [@as(i8, 1), @as(i8, -2)]; return @as(i32, xs[1]); }
fn bool_last() -> bool { var fl = [true, false, true]; return fl[2]; }
fn bool_middle() -> bool { var fl = [true, false, true]; return fl[1]; }
fn const_list() -> u32 { var xs = [SEED, SEED + 1]; return xs[1]; }
fn field_list(p: Cells) -> u16 { var xs = [p.lo, p.hi]; return xs[1]; }
fn char_list() -> bool { var cs = ['a', 'b']; return cs[1] == 'b'; }
fn string_list() -> bool { var names = ["alpha", "beta"]; return names[1][0] == 'b'; }
fn expr_list() -> i32 { var xs = [1 + 2, 3 * 4]; return xs[1]; }
fn call_list() -> i32 { var xs = [two(), two() + 1]; return xs[1]; }
fn mutated() -> u32 { var xs = [SEED, SEED]; xs[0] = 5; return xs[0] + xs[1]; }
fn data_at(i: usize) -> u32 { return DATA[i]; }
fn word_first_char(i: usize) -> u8 { return WORDS[i][0]; }
fn limit_second() -> u32 { return LIMITS[1]; }
test untyped_lists_declare_arrays {
    assert(mode_second());
    assert(!mode_third());
    assert(mode_inferred());
    assert(param_list(3, 4) == 7);
    assert(cast_list() == -2);
    assert(bool_last());
    assert(!bool_middle());
    assert(const_list() == 10);
    assert(field_list(Cells{ .lo = 1, .hi = 4 }) == 4);
    assert(char_list());
    assert(string_list());
    assert(expr_list() == 12);
    assert(call_list() == 3);
    assert(mutated() == 14);
    assert(data_at(5) == 9);
    assert(word_first_char(1) == 'b');
    assert(limit_second() == 10);
}
