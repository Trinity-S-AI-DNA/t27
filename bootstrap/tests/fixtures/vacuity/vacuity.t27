module vacuity_fixture;
; #6509 fixture for `t27c test-report`: one runtime assert counted per
; execution, callees included; an assert whose operands are all constants
; folds and verifies at COMPILE time (#5980 probe, #12751 law).
; Expected per test: empty_test 0 (VACUOUS), folded_only 0 (CT-VERIFIED),
; checked 2, loop_checked 4 -- vacuous 1 of 4, 1 comptime-verified.

fn inc(x: u32) -> u32 {
    return x + 1;
}

test empty_test {
}

test folded_only {
    assert(1 + 1 == 2);
}

test checked {
    assert(inc(1) == 2);
    assert_eq(inc(2), 3);
}

test loop_checked {
    var i: u32 = 0;
    while (i < 4) {
        assert(inc(i) == i + 1);
        i = i + 1;
    }
}
