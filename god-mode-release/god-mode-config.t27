module GodModeConfig;

/// GOD MODE behavior configuration
pub const GOD_MODE_AUTO_ACTIVATE : bool = true;
pub const GOD_MODE_WAIT_SECONDS : u64 = 3;
pub const GOD_MODE_ANIMATION_STEPS : u32 = 5;
pub const GOD_MODE_GLOW_INTENSITY : f64 = 1.0;

/// Visual effects configuration
pub const GLOW_COLORS : struct {
    core_r: f64 = 0.56,
    core_g: f64 = 0.86,
    core_b: f64 = 1.0,
    mid_r: f64 = 0.16,
    mid_g: f64 = 0.42,
    mid_b: f64 = 1.0,
    base_r: f64 = 0.22,
    base_g: f64 = 0.10,
    base_b: f64 = 0.80
};

/// Animation timing
pub const ANIMATION_TIMING : struct {
    frames_per_step: u32 = 30,
    total_steps: u32 = 5,
    inter_frame_delay_ms: u64 = 16,
    glow_w: f64 = 44.0,
    glow_bands: u32 = 30,
    glow_peak: f64 = 0.62,
    glow_core_w: f64 = 1.5,
    glow_blur: f64 = 22.0,
    glow_core_a: f64 = 0.85,
    breath_frames: u32 = 90,
    breath_amp: f64 = 0.16,
    lick_frames: u32 = 19,
    lick_shift: u32 = 3,
    lick_amp: f64 = 0.30,
    glow_step: f64 = 0.1
};

/// Swarm computing configuration
pub const SWARM_CONFIG : struct {
    auto_connect: bool = true,
    sync_interval_ms: u64 = 1000,
    consensus_timeout_ms: u64 = 5000,
    max_nodes: u32 = 27,
    replication_factor: u32 = 3
};

/// UI configuration
pub const UI_CONFIG : struct {
    panel_width: f64 = 300.0,
    panel_padding: f64 = 16.0,
    panel_god_y: f64 = 40.0,
    panel_god_h: f64 = 44.0,
    panel_ctx_y: f64 = 104.0,
    panel_sug_y: f64 = 176.0,
    panel_btn_y: f64 = 208.0,
    panel_btn_w: f64 = 96.0,
    panel_btn_h: f64 = 26.0,
    panel_btn_gap: f64 = 8.0,
    panel_recent_y: f64 = 262.0,
    panel_line: f64 = 20.0,
    panel_close: f64 = 16.0
};

// Configuration validation
pub fn validate_config() -> bool {
    // Validate GOD MODE settings
    if (GOD_MODE_WAIT_SECONDS == 0) {
        return false;
    }

    if (GOD_MODE_ANIMATION_STEPS == 0) {
        return false;
    }

    if (GOD_MODE_GLOW_INTENSITY < 0.0 or GOD_MODE_GLOW_INTENSITY > 1.0) {
        return false;
    }

    // Validate animation timing
    if (ANIMATION_TIMING.frames_per_step == 0) {
        return false;
    }

    if (ANIMATION_TIMING.inter_frame_delay_ms == 0) {
        return false;
    }

    // Validate Swarm config
    if (SWARM_CONFIG.max_nodes == 0) {
        return false;
    }

    if (SWARM_CONFIG.replication_factor == 0) {
        return false;
    }

    return true;
}

// Configuration constants for easy access
pub const CONFIG : struct {
    version: str = "1.0.0",
    build_date: str = "2026-10-21",
    author: str = "Claude Code",
    description: str = "GOD MODE Configuration for T27 OS Swarm Computing"
};

// Test configuration
test configuration_validation {
    assert validate_config() == true;

    // Test basic settings
    assert GOD_MODE_AUTO_ACTIVATE == true;
    assert GOD_MODE_WAIT_SECONDS == 3;
    assert GOD_MODE_ANIMATION_STEPS == 5;
    assert GOD_MODE_GLOW_INTENSITY == 1.0;

    // Test UI dimensions
    assert UI_CONFIG.panel_width == 300.0;
    assert UI_CONFIG.panel_god_y == 40.0;
    assert UI_CONFIG.panel_god_h == 44.0;

    // Test Swarm settings
    assert SWARM_CONFIG.auto_connect == true;
    assert SWARM_CONFIG.sync_interval_ms == 1000;
    assert SWARM_CONFIG.max_nodes == 27;

    print("✅ Configuration validation passed");
}