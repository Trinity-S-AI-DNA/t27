// Add weakness to list
fn add_weakness(weakness: str) -> void {
    if (improvement_state.weakness_count < 20) {
        improvement_state.weaknesses_identified[improvement_state.weakness_count] = weakness;
        improvement_state.weakness_count += 1;
        log_message(@concat("🔍 Weakness identified: ", weakness));
    }
}

