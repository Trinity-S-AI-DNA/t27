// Update learning rate
fn update_learning_rate() -> void {
    log_message("📈 Updating learning rate");

    // Calculate success rate
    const success_rate : f64 = @as(f64, @floatFromInt(improvement_state.completed_tasks)) /
                              @as(f64, @floatFromInt(improvement_state.task_count));

    // Adjust learning rate based on success
    if (success_rate > 0.8) {
        improvement_state.learning_rate *= 1.1;  // Increase if successful
    } else if (success_rate < 0.6) {
        improvement_state.learning_rate *= 0.9;  // Decrease if struggling
    }

    // Cap learning rate
    improvement_state.learning_rate = min(0.01, improvement_state.learning_rate);
}

