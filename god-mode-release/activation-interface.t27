// Display activation logs
fn display_activation_logs() -> void {
    log_message("📄 ACTIVATION LOGS");
    log_message("");

    for (var i: u32 = 0; i < activation_state.log_count; i += 1) {
        log_message(@concat("[", @toString(i + 1), "] ", activation_state.activation_log[i]));
    }

    log_message("");
    log_message("Press Enter to return...");
}

// Add to activation log
fn add_to_activation_log(message: str) -> void {
    // Shift log entries
    for (var i: u32 = 19; i > 0; i -= 1) {
        activation_state.activation_log[i] = activation_state.activation_log[i - 1];
    }
    activation_state.activation_log[0] = message;

    if (activation_state.log_count < 20) {
        activation_state.log_count += 1;
    }
}

// Format duration
fn format_duration(seconds: u64) -> str {
    const hours : u32 = @as(u32, @intCast(seconds / 3600));
    const minutes : u32 = @as(u32, @intCast((seconds % 3600) / 60));
    const secs : u32 = @as(u32, @intCast(seconds % 60));

    return @concat(@toString(hours), "h ", @toString(minutes), "m ", @toString(secs), "s");
}

// Exit activation interface
fn exit_activation_interface() -> void {
    log_message("👋 Activation Interface shutdown");
    record_experience("Activation interface ended");
    // In real implementation, would exit gracefully
}

// Test activation interface
test activation_interface {
    init_activation_interface();

    assert activation_state.current_mode == ACTIVATION_MODE_MENU;
    assert activation_state.system_active == false;

    // Test mode switching
    activation_state.current_mode = ACTIVATION_MODE_STATUS;
    display_activation_status();

    activation_state.current_mode = ACTIVATION_MODE_ACTIVATE;
    // Would run activation process in real implementation

    assert activation_state.log_count == 0;
    add_to_activation_log("Test log");
    assert activation_state.log_count == 1;
    assert activation_state.activation_log[0] == "Test log";

    record_experience("Activation Interface test completed");
}

// Entry point for activation interface
pub fn start_activation_interface() -> void {
    log_message("🎯 Starting Activation Interface");
    init_activation_interface();
    run_activation_interface();
}

// Quick activation function
pub fn quick_activate() -> void {
    init_complete_god_mode_system();
    log_message("🚀 Quick activation complete");
}