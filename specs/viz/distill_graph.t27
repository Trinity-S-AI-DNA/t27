// SPDX-License-Identifier: Apache-2.0
// specs/viz/distill_graph.t27 -- the spec dependency graph as one interactive visual.
//
// The SHAPE follows Distill's "A Gentle Introduction to Graph Neural Networks"
// (distill.pub/2021/gnn-intro/), borrowed as a METHOD, not as bytes:
//   1. hover a node and its neighbourhood lights up while everything else dims,
//      so a reader sees what one spec accumulates from the specs around it;
//   2. the same edges are offered a second time as an adjacency matrix of the
//      busiest specs, and hovering either view lights the other;
//   3. colour carries one attribute (the directory a spec lives in), and the
//      legend names every colour it paints.
//
// Why the page lives in a spec: a hand-written .html is forbidden (owner rule
// 2026-10-05, "Only t27" in AGENTS.md -- the gate says so in its own words).
// So the page IS this spec: `t27c gen-js specs/viz/distill_graph.t27` emits the
// line array, and a materialiser joins it with `t27c use-edges` data into an
// artefact under build/ (never committed). Edit the spec, not the artefact.
//
// The page fetches nothing: no origin is ever named in its lines, and
// `the_page_never_names_an_origin` settles that on every run instead of
// trusting it. phi^2 + 1/phi^2 = 3 | TRINITY

module VizDistillGraph;

/// The whole page, one line per array entry. HTML and JS use single quotes
/// throughout so no line carries an escaped double quote.
pub const PAGE : [86]str = [
    "<!doctype html>",
    "<html lang='en'>",
    "<head>",
    "<meta charset='utf-8'>",
    "<meta name='viewport' content='width=device-width, initial-scale=1'>",
    "<title>T27 spec graph -- a gentle view</title>",
    "<style>",
    "body { margin:0; font:15px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color:#16161d; background:#fcfcfa; }",
    "header { padding:12px 18px 8px; border-bottom:1px solid #e4e4dd; }",
    "h1 { margin:0 0 2px; font-size:17px; }",
    ".sub { color:#6f6f7a; font-size:12.5px; }",
    "#stats { font-size:12.5px; color:#43434f; font-variant-numeric:tabular-nums; }",
    "#legend { font-size:12px; color:#43434f; }",
    "#legend span { display:inline-block; margin-right:10px; }",
    "#legend i { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:3px; }",
    "main { display:flex; height:calc(100vh - 132px); }",
    ".view { flex:1 1 auto; min-width:0; position:relative; }",
    "#panel { flex:0 0 306px; border-left:1px solid #e4e4dd; background:#fff; padding:10px 14px; overflow:auto; }",
    "svg { display:block; width:100%; height:100%; }",
    ".edge { stroke:#cfcfd8; stroke-width:0.6; fill:none; }",
    ".edge.hot { stroke:#d95f02; stroke-width:1.8; }",
    ".node { stroke:#fff; stroke-width:1.1; cursor:pointer; }",
    ".node.dim { opacity:0.10; }",
    ".node.hot { stroke:#111; stroke-width:2; }",
    ".lab { font-size:9px; fill:#3a3a46; pointer-events:none; }",
    ".hint { color:#6f6f7a; font-size:12.5px; }",
    "h2 { font-size:12px; margin:14px 0 5px; text-transform:uppercase; letter-spacing:0.06em; color:#7a7a86; }",
    "ul { margin:0; padding-left:15px; font-size:12.5px; }",
    "li { margin:1px 0; }",
    ".dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; }",
    ".matrix rect { stroke:#fff; stroke-width:0.5; }",
    ".matrix rect.hot { stroke:#d95f02; stroke-width:1.8; }",
    "</style>",
    "</head>",
    "<body>",
    "<header>",
    "<h1>T27 spec graph</h1>",
    "<div class='sub'>Hover a node to light the specs it stands on and the specs standing on it; click to hold it. The same edges again on the right, as an adjacency matrix of the busiest specs -- hover a cell and both views light.</div>",
    "<div id='stats'></div>",
    "<div id='legend'></div>",
    "</header>",
    "<main>",
    "<div id='graph' class='view'><svg id='svg'></svg></div>",
    "<div id='matrix' class='view'><svg id='mx' class='matrix'></svg></div>",
    "<aside id='panel'><div class='hint' id='hint'>No spec held. Hover the graph.</div><div id='body'></div></aside>",
    "</main>",
    "<script>",
    "const DATA = window.__T27_GRAPH__ || { 'nodes': [], 'edges': [] };",
    "const svg = document.getElementById('svg');",
    "const mx = document.getElementById('mx');",
    "const idx = {}; const N = DATA.nodes;",
    "N.forEach(function (n, i) { idx[n.id] = i; n.i = i; n.x = 40 + (i * 977) % 960; n.y = 40 + (i * 613) % 640; n.vx = 0; n.vy = 0; n.out = []; n.inc = []; });",
    "const E = [];",
    "DATA.edges.forEach(function (e) { const a = idx[e.s], b = idx[e.t]; if (a === undefined || b === undefined) return; const o = { a: a, b: b }; E.push(o); N[a].out.push(b); N[b].inc.push(a); });",
    "function dirOf(p) { const m = p.split('/'); return m.length > 2 ? m[1] : 'root'; }",
    "const palette = ['#2f6f9f', '#d95f02', '#1b9e77', '#7570b3', '#e7298a', '#66a61e', '#e6ab02', '#a6761d', '#666666'];",
    "const dirs = {}; let dk = 0;",
    "N.forEach(function (n) { const d = dirOf(n.id); if (!(d in dirs)) dirs[d] = palette[dk % palette.length]; dk = dk + 1; n.c = dirs[d]; });",
    "document.getElementById('stats').textContent = N.length + ' specs, ' + E.length + ' use edges';",
    "const lg = document.getElementById('legend');",
    "Object.keys(dirs).sort().forEach(function (d) { const s = document.createElement('span'); s.innerHTML = '<i style=\"background:' + dirs[d] + '\"></i>' + d; lg.appendChild(s); });",
    "let held = -1; let hot = -1; let fixed = false;",
    "function neighbourhood(k) { const set = {}; set[k] = 1; N[k].out.forEach(function (j) { set[j] = 1; }); N[k].inc.forEach(function (j) { set[j] = 1; }); return set; }",
    "function step() { let i = 0; let j = 0; for (i = 0; i < N.length; i++) { N[i].vx = N[i].vx * 0.55; N[i].vy = N[i].vy * 0.55; }",
    "  for (i = 0; i < N.length; i++) { for (j = i + 1; j < N.length; j++) { const dx = N[i].x - N[j].x; const dy = N[i].y - N[j].y; let d2 = dx * dx + dy * dy; if (d2 < 1) d2 = 1; const f = 2400 / d2; const d = Math.sqrt(d2); const fx = (dx / d) * f; const fy = (dy / d) * f; N[i].vx = N[i].vx + fx; N[i].vy = N[i].vy + fy; N[j].vx = N[j].vx - fx; N[j].vy = N[j].vy - fy; } }",
    "  E.forEach(function (e) { const dx = N[e.b].x - N[e.a].x; const dy = N[e.b].y - N[e.a].y; const d = Math.max(1, Math.sqrt(dx * dx + dy * dy)); const f = (d - 70) * 0.006; N[e.a].vx = N[e.a].vx + (dx / d) * f * d; N[e.a].vy = N[e.a].vy + (dy / d) * f * d; N[e.b].vx = N[e.b].vx - (dx / d) * f * d; N[e.b].vy = N[e.b].vy - (dy / d) * f * d; });",
    "  for (i = 0; i < N.length; i++) { N[i].x = N[i].x + N[i].vx; N[i].y = N[i].y + N[i].vy; N[i].x = Math.max(14, Math.min(svg.clientWidth - 14, N[i].x)); N[i].y = Math.max(14, Math.min(svg.clientHeight - 14, N[i].y)); } }",
    "let ticks = 0;",
    "function render() { const hotSet = hot >= 0 ? neighbourhood(hot) : null; let s = '';",
    "  E.forEach(function (e) { const on = hotSet && hotSet[e.a] && hotSet[e.b]; s += '<line class=\"' + (on ? 'edge hot' : 'edge') + '\" x1=\"' + N[e.a].x.toFixed(1) + '\" y1=\"' + N[e.a].y.toFixed(1) + '\" x2=\"' + N[e.b].x.toFixed(1) + '\" y2=\"' + N[e.b].y.toFixed(1) + '\"/>'; });",
    "  N.forEach(function (n, i) { const on = !hotSet || hotSet[i]; const r = i === held ? 9 : (n.out.length + n.inc.length > 18 ? 7 : 5); const k = !on ? 'node dim' : (i === hot ? 'node hot' : 'node'); s += '<circle data-i=\"' + i + '\" class=\"' + k + '\" cx=\"' + n.x.toFixed(1) + '\" cy=\"' + n.y.toFixed(1) + '\" r=\"' + r + '\" fill=\"' + n.c + '\"/>'; });",
    "  svg.innerHTML = s; }",
    "svg.addEventListener('mouseover', function (ev) { const t = ev.target; const v = t.getAttribute ? t.getAttribute('data-i') : null; if (v === null || +v === hot) return; hot = +v; render(); paintPanel(); });",
    "svg.addEventListener('click', function (ev) { const t = ev.target; const v = t.getAttribute ? t.getAttribute('data-i') : null; if (v === null) return; held = (held === +v ? -1 : +v); render(); paintPanel(); });",
    "function li(node, dirn, color) { return '<li><span class=\"dot\" style=\"background:' + color + '\"></span>' + node.id.replace('specs/', '') + ' <span class=\"hint\">' + dirn + '</span></li>'; }",
    "function paintPanel() { const k = held >= 0 ? held : hot; const hint = document.getElementById('hint'); const body = document.getElementById('body'); if (k < 0) { hint.textContent = 'No spec held. Hover the graph.'; body.innerHTML = ''; return; } const n = N[k]; hint.textContent = ''; let h = '<h2>' + n.id + '</h2>'; h += '<div class=\"hint\">directory ' + dirOf(n.id) + ' -- ' + n.out.length + ' imports, ' + n.inc.length + ' imported by</div>'; h += '<h2>stands on</h2><ul>'; n.out.forEach(function (j) { h += li(N[j], 'import', N[j].c); }); h += '</ul><h2>stood on by</h2><ul>'; n.inc.forEach(function (j) { h += li(N[j], 'importer', N[j].c); }); h += '</ul>'; body.innerHTML = h; }",
    "function renderMatrix() { const top = N.map(function (n, i) { return i; }).sort(function (a, b) { return (N[b].out.length + N[b].inc.length) - (N[a].out.length + N[a].inc.length); }).slice(0, 44); const cell = Math.max(6, Math.floor(Math.min(mx.clientWidth, mx.clientHeight) / 46)); let s = ''; top.forEach(function (a, ra) { top.forEach(function (b, ca) { const on = E.some(function (e) { return (e.a === a && e.b === b); }); if (!on) return; s += '<rect data-a=\"' + a + '\" x=\"' + (ca * cell + 24) + '\" y=\"' + (ra * cell + 24) + '\" width=\"' + (cell - 1) + '\" height=\"' + (cell - 1) + '\" fill=\"' + N[a].c + '\"/>'; }); }); mx.innerHTML = s; }",
    "mx.addEventListener('mouseover', function (ev) { const t = ev.target; const v = t.getAttribute ? t.getAttribute('data-a') : null; if (v === null || +v === hot) return; hot = +v; render(); paintPanel(); });",
    "function loop() { if (!fixed) step(); render(); ticks = ticks + 1; if (ticks < 420) requestAnimationFrame(loop); else { fixed = true; renderMatrix(); } }",
    "mx.addEventListener('mouseleave', function () { hot = held; render(); });",
    "document.getElementById('graph').addEventListener('mouseleave', function () { hot = held; render(); });",
    "window.addEventListener('resize', function () { renderMatrix(); });",
    "loop();",
    "</script>",
    "</body>",
    "</html>",
];

/// The last line of PAGE, settled by a test rather than counted by a reader.
pub const LAST : u32 = 85;

/// Does the span carry the scheme separator? The page must never say one.
pub fn names_remote(s: string, from: usize, to: usize) -> bool {
    var k : usize = from;
    while (k + 3 <= to) {
        if (s[k] == ':' and s[k + 1] == '/' and s[k + 2] == '/') { return true; }
        k = k + 1;
    }
    return false;
}

/// The page, line by line: does ANY line name an origin?
pub fn page_names_origin() -> bool {
    var i : u32 = 0u32;
    while (i < 86u32) {
        if (names_remote(PAGE[i], 0, PAGE[i].len)) { return true; }
        i = i + 1u32;
    }
    return false;
}

test the_page_opens_with_a_doctype {
    assert PAGE[0] == "<!doctype html>"
    assert PAGE[1] == "<html lang='en'>"
}

test the_page_closes_where_the_spec_says_it_does {
    assert LAST == 85u32
    assert PAGE[LAST] == "</html>"
}

test the_two_views_are_both_on_the_page {
    assert PAGE[42] == "<div id='graph' class='view'><svg id='svg'></svg></div>"
    assert PAGE[43] == "<div id='matrix' class='view'><svg id='mx' class='matrix'></svg></div>"
}

test names_remote_sees_the_scheme_separator {
    assert names_remote("const NS = 'http://x'", 0, 20) == true
    assert names_remote("<div id='graph'>", 0, 16) == false
    assert names_remote("a:/b", 0, 4) == false
}

test page_names_origin_is_false_on_the_whole_page {
    assert page_names_origin() == false
}

invariant the_page_holds_what_the_header_promises {
    assert PAGE[36] == "<h1>T27 spec graph</h1>"
}