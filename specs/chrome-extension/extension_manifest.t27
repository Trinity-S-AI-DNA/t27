// specs/chrome-extension/extension_manifest.t27
// Lagger Chrome Extension Manifest Specification
// Trinity S³AI T27 Architecture - PHI LOOP Methodology
// φ² + 1/φ² = 3 | TRINITY

module ExtensionManifest {

    // ============================================================================
    // MANIFEST CONSTANTS AND IDENTIFICATION
    // ============================================================================
    
    const MANIFEST_VERSION : u8 = 3;
    const EXTENSION_NAME : str = "Lagger Extension";
    const EXTENSION_VERSION : str = "1.0.0";
    const EXTENSION_DESCRIPTION : str = "T27-integrated performance monitoring Chrome extension";
    const EXTENSION_AUTHOR : str = "Trinity S³AI";
    const EXTENSION_HOME_PAGE : str = "https://t27.ai";
    
    // ============================================================================
    // PERMISSION CONSTANTS - PHI STRUCTURED
    // ============================================================================
    
    /// Essential permissions for basic functionality
    const ESSENTIAL_PERMISSIONS : [str] = [
        "storage",
        "tabs"
    ];
    
    /// Performance monitoring permissions
    const MONITORING_PERMISSIONS : [str] = [
        "activeTab",
        "declarativeNetRequest",
        "scripting"
    ];
    
    /// Notification permissions
    const NOTIFICATION_PERMISSIONS : [str] = [
        "notifications"
    ];
    
    /// Background permissions
    const BACKGROUND_PERMISSIONS : [str] = [
        "background"
    ];
    
    /// Content script permissions
    const CONTENT_SCRIPT_PERMISSIONS : [str] = [
        "hostPermissions"
    ];
    
    /// Φ-structured permission grouping
    const PHI_GROUPS : u8 = 5;  // Number of permission groups
    const PHI_PERMISSIONS_PER_GROUP : u8 = 3;  // φ ≈ 3 in integer terms
    
    // ============================================================================
    // MANIFEST STRUCTURES
    // ============================================================================
    
    /// Extension manifest structure
    struct Manifest {
        manifest_version: u8,
        name: str,
        version: str,
        description: str,
        author: str,
        homepage_url: str,
        permissions: [str],
        host_permissions: [str],
        background: BackgroundConfig,
        content_scripts: [ContentScript],
        options_page: str,
        action: ActionConfig,
        storage: StorageConfig,
        icons: [IconConfig],
        minimum_chrome_version: str
    }
    
    /// Background configuration
    struct BackgroundConfig {
        service_worker: str,
        persistent: bool,
        type: str
    }
    
    /// Content script configuration
    struct ContentScript {
        matches: [str],
        run_at: str,
        all_frames: bool,
        js: [str],
        css: [str]
    }
    
    /// Browser action configuration
    struct ActionConfig {
        default_icon: IconConfig,
        default_title: str,
        default_popup: str
    }
    
    /// Storage configuration
    struct StorageConfig {
        managed_schema: str,
        managed_areas: [str]
    }
    
    /// Icon configuration
    struct IconConfig {
        size: u32,
        path: str
    }
    
    // ============================================================================
    // MANIFEST VALIDATION FUNCTIONS
    // ============================================================================
    
    /// Create complete extension manifest
    fn create_manifest() -> Manifest {
        var manifest: Manifest;
        manifest.manifest_version = MANIFEST_VERSION;
        manifest.name = EXTENSION_NAME;
        manifest.version = EXTENSION_VERSION;
        manifest.description = EXTENSION_DESCRIPTION;
        manifest.author = EXTENSION_AUTHOR;
        manifest.homepage_url = EXTENSION_HOME_PAGE;
        manifest.permissions = ESSENTIAL_PERMISSIONS + MONITORING_PERMISSIONS + NOTIFICATION_PERMISSIONS;
        manifest.host_permissions = ["<all_urls>"];
        manifest.background = create_background_config();
        manifest.content_scripts = create_content_scripts();
        manifest.options_page = "options.html";
        manifest.action = create_action_config();
        manifest.storage = create_storage_config();
        manifest.icons = create_icon_configs();
        manifest.minimum_chrome_version = "88.0.0.0";
        
        return manifest;
    }
    
    /// Create background configuration
    fn create_background_config() -> BackgroundConfig {
        return BackgroundConfig{
            .service_worker = "background.js",
            .persistent = true,
            .type = "module"
        };
    }
    
    /// Create content scripts configuration
    fn create_content_scripts() -> [ContentScript] {
        return [
            ContentScript{
                .matches = ["<all_urls>"],
                .run_at = "document_start",
                .all_frames = false,
                .js = ["content.js"],
                .css = ["styles.css"]
            }
        ];
    }
    
    /// Create browser action configuration
    fn create_action_config() -> ActionConfig {
        return ActionConfig{
            .default_icon = IconConfig{.size = 16, .path = "icons/icon16.png"},
            .default_title = "Lagger Performance Monitor",
            .default_popup = "popup.html"
        };
    }
    
    /// Create storage configuration
    fn create_storage_config() -> StorageConfig {
        return StorageConfig{
            .managed_schema = "managed_schema.json",
            .managed_areas = ["settings"]
        };
    }
    
    /// Create icon configurations
    fn create_icon_configs() -> [IconConfig] {
        return [
            IconConfig{.size = 16, .path = "icons/icon16.png"},
            IconConfig{.size = 32, .path = "icons/icon32.png"},
            IconConfig{.size = 48, .path = "icons/icon48.png"},
            IconConfig{.size = 128, .path = "icons/icon128.png"}
        ];
    }
    
    /// Validate manifest completeness
    fn validate_manifest(manifest: *Manifest) -> ValidationResult {
        var errors: [str] = [];
        
        // Check required fields
        if (manifest.name.len == 0) {
            errors.append("Extension name is required");
        }
        
        if (manifest.version.len == 0) {
            errors.append("Extension version is required");
        }
        
        if (manifest.permissions.len == 0) {
            errors.append("At least one permission is required");
        }
        
        // Check permission groups
        var has_essential = false;
        var has_monitoring = false;
        var has_notification = false;
        
        for (permission in manifest.permissions) {
            if (array_contains(ESSENTIAL_PERMISSIONS, permission)) {
                has_essential = true;
            }
            if (array_contains(MONITORING_PERMISSIONS, permission)) {
                has_monitoring = true;
            }
            if (array_contains(NOTIFICATION_PERMISSIONS, permission)) {
                has_notification = true;
            }
        }
        
        if (!has_essential) {
            errors.append("Essential permissions are missing");
        }
        
        if (!has_monitoring) {
            errors.append("Monitoring permissions are missing");
        }
        
        if (!has_notification) {
            errors.append("Notification permissions are missing");
        }
        
        // Check content scripts
        if (manifest.content_scripts.len == 0) {
            errors.append("Content scripts are required for performance monitoring");
        }
        
        // Check icons
        if (manifest.icons.len == 0) {
            errors.append("At least one icon is required");
        }
        
        return ValidationResult{
            .valid = errors.len == 0,
            .errors = errors
        };
    }
    
    /// Check if URL matches host permissions
    fn url_matches_permissions(url: str, permissions: [str]) -> bool {
        for (permission in permissions) {
            if (permission == "<all_urls>") {
                return true;
            }
            if (url_starts_with(url, permission)) {
                return true;
            }
        }
        return false;
    }
    
    /// Check if URL starts with permission pattern
    fn url_starts_with(url: str, pattern: str) -> bool {
        return url.find(pattern) == 0;
    }
    
    /// Check if array contains value
    fn array_contains(arr: [str], value: str) -> bool {
        for (item in arr) {
            if (item == value) {
                return true;
            }
        }
        return false;
    }
    
    // ============================================================================
    // RESULT STRUCTURES
    // ============================================================================
    
    /// Validation result structure
    struct ValidationResult {
        valid: bool,
        errors: [str]
    }
    
    // ============================================================================
    // TESTS - L4 COMPLIANCE
    // ============================================================================
    
    test "manifest_creation" {
        var manifest = create_manifest();
        assert(manifest.manifest_version == MANIFEST_VERSION);
        assert(manifest.name == EXTENSION_NAME);
        assert(manifest.version == EXTENSION_VERSION);
        assert(manifest.description == EXTENSION_DESCRIPTION);
        assert(manifest.author == EXTENSION_AUTHOR);
        assert(manifest.homepage_url == EXTENSION_HOME_PAGE);
        assert(manifest.permissions.len == ESSENTIAL_PERMISSIONS.len + MONITORING_PERMISSIONS.len + NOTIFICATION_PERMISSIONS.len);
        assert(manifest.host_permissions[0] == "<all_urls>");
        assert(manifest.background.persistent == true);
        assert(manifest.content_scripts.len == 1);
        assert(manifest.options_page == "options.html");
        assert(manifest.minimum_chrome_version == "88.0.0.0");
    }
    
    test "permission_grouping" {
        assert(ESSENTIAL_PERMISSIONS.len == 2);
        assert(MONITORING_PERMISSIONS.len == 3);
        assert(NOTIFICATION_PERMISSIONS.len == 1);
        assert(BACKGROUND_PERMISSIONS.len == 1);
        assert(CONTENT_SCRIPT_PERMISSIONS.len == 1);
        assert(PHI_GROUPS == 5);
        assert(PHI_PERMISSIONS_PER_GROUP == 3);
    }
    
    test "background_configuration" {
        var background = create_background_config();
        assert(background.service_worker == "background.js");
        assert(background.persistent == true);
        assert(background.type == "module");
    }
    
    test "content_scripts_configuration" {
        var scripts = create_content_scripts();
        assert(scripts.len == 1);
        assert(scripts[0].matches[0] == "<all_urls>");
        assert(scripts[0].run_at == "document_start");
        assert(scripts[0].all_frames == false);
        assert(array_contains(scripts[0].js, "content.js"));
        assert(array_contains(scripts[0].css, "styles.css"));
    }
    
    test "action_configuration" {
        var action = create_action_config();
        assert(action.default_title == "Lagger Performance Monitor");
        assert(action.default_popup == "popup.html");
        assert(action.default_icon.size == 16);
        assert(action.default_icon.path == "icons/icon16.png");
    }
    
    test "storage_configuration" {
        var storage = create_storage_config();
        assert(storage.managed_schema == "managed_schema.json");
        assert(storage.managed_areas[0] == "settings");
    }
    
    test "icon_configuration" {
        var icons = create_icon_configs();
        assert(icons.len == 4);
        assert(icons[0].size == 16);
        assert(icons[0].path == "icons/icon16.png");
        assert(icons[1].size == 32);
        assert(icons[2].size == 48);
        assert(icons[3].size == 128);
    }
    
    test "manifest_validation_valid" {
        var manifest = create_manifest();
        var result = validate_manifest(&manifest);
        assert(result.valid == true);
        assert(result.errors.len == 0);
    }
    
    test "manifest_validation_missing_permissions" {
        var manifest: Manifest;
        manifest.manifest_version = MANIFEST_VERSION;
        manifest.name = "Test Extension";
        manifest.version = "1.0.0";
        manifest.description = "Test";
        manifest.author = "Test";
        manifest.homepage_url = "https://test.com";
        manifest.permissions = [];
        manifest.host_permissions = ["<all_urls>"];
        manifest.background = create_background_config();
        manifest.content_scripts = create_content_scripts();
        manifest.options_page = "options.html";
        manifest.action = create_action_config();
        manifest.storage = create_storage_config();
        manifest.icons = create_icon_configs();
        manifest.minimum_chrome_version = "88.0.0.0";
        
        var result = validate_manifest(&manifest);
        assert(result.valid == false);
        assert(result.errors.len > 0);
    }
    
    test "url_matching_permissions" {
        var permissions = ["https://*.example.com/*", "https://test.com/*"];
        assert(url_matches_permissions("https://example.com/page", permissions));
        assert(url_matches_permissions("https://test.com/page", permissions));
        assert(url_matches_permissions("https://other.com/page", permissions) == false);
        assert(url_matches_permissions("https://example.com/page", ["<all_urls>"]));
    }
    
    test "url_starts_with_function" {
        assert(url_starts_with("https://example.com/page", "https://example.com/"));
        assert(url_starts_with("https://example.com/page", "https://example.com") == false);
        assert(url_starts_with("https://example.com/page", "https://other.com/") == false);
    }
    
    test "array_contains_function" {
        var arr: [str] = ["a", "b", "c"];
        assert(array_contains(arr, "a"));
        assert(array_contains(arr, "b"));
        assert(array_contains(arr, "c"));
        assert(array_contains(arr, "d") == false);
    }
    
    test "manifest_version_compatibility" {
        assert(MANIFEST_VERSION == 3); // Chrome requires manifest v3
        assert(create_manifest().manifest_version == 3);
    }
    
    test "icon_sizes_phi_structure" {
        var icons = create_icon_configs();
        // Icon sizes should follow φ progression: 16, 32, 48, 128
        // 16, 32 (16*2), 48 (16*3), 128 (16*8) - power of 2 progression
        assert(icons[0].size == 16);
        assert(icons[1].size == 32);
        assert(icons[2].size == 48);
        assert(icons[3].size == 128);
    }
    
    // ============================================================================
    // INVARIANTS - L5 COMPLIANCE (PHI IDENTITY)
    // ============================================================================
    
    invariant "manifest_version_compatibility" {
        assert(MANIFEST_VERSION == 3); // Chrome requires manifest v3
        assert(create_manifest().manifest_version == 3);
    }
    
    invariant "permission_groups_phi_structure" {
        assert(PHI_GROUPS == 5);
        assert(PHI_PERMISSIONS_PER_GROUP == 3);
        assert(ESSENTIAL_PERMISSIONS.len + MONITORING_PERMISSIONS.len + NOTIFICATION_PERMISSIONS.len + BACKGROUND_PERMISSIONS.len + CONTENT_SCRIPT_PERMISSIONS.len == PHI_GROUPS * PHI_PERMISSIONS_PER_GROUP);
    }
    
    invariant "icon_sizes_progression" {
        var icons = create_icon_configs();
        assert(icons[0].size == 16);
        assert(icons[1].size == 32); // 16 * 2
        assert(icons[2].size == 48); // 16 * 3
        assert(icons[3].size == 128); // 16 * 8 (power of 2)
        assert(icons[0].size * 2 == icons[1].size);
        assert(icons[0].size * 3 == icons[2].size);
        assert(icons[0].size * 8 == icons[3].size);
    }
    
    invariant "required_fields_present" {
        var manifest = create_manifest();
        assert(manifest.name.len > 0);
        assert(manifest.version.len > 0);
        assert(manifest.description.len > 0);
        assert(manifest.permissions.len > 0);
        assert(manifest.background.service_worker.len > 0);
        assert(manifest.content_scripts.len > 0);
        assert(manifest.icons.len > 0);
    }
    
    invariant "url_matching_consistency" {
        var permissions = ["https://*.example.com/*", "https://test.com/*"];
        assert(url_matches_permissions("https://example.com/page", permissions));
        assert(url_matches_permissions("https://example.com/", permissions));
        assert(url_matches_permissions("https://example.com", permissions) == false);
    }
    
    invariant "manifest_validation_integrity" {
        var manifest = create_manifest();
        var result = validate_manifest(&manifest);
        assert(result.valid == true);
        assert(result.errors.len == 0);
    }
    
    // ============================================================================
    // BENCHMARKS - L4 COMPLIANCE
    // ============================================================================
    
    bench "manifest_creation_overhead" {
        var start_time = get_timestamp_ns();
        
        // Create manifest 100 times
        for (var i = 0; i < 100; i++) {
            var manifest = create_manifest();
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        var avg_time = total_time / 100;
        
        // Target: < 1ms per creation
        assert(avg_time < 1000000); // 1ms in nanoseconds
        
        return avg_time;
    }
    
    bench "manifest_validation_speed" {
        var manifest = create_manifest();
        var start_time = get_timestamp_ns();
        
        // Validate manifest 100 times
        for (var i = 0; i < 100; i++) {
            var result = validate_manifest(&manifest);
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        var avg_time = total_time / 100;
        
        // Target: < 0.5ms per validation
        assert(avg_time < 500000); // 0.5ms in nanoseconds
        
        return avg_time;
    }
    
    bench "url_matching_efficiency" {
        var permissions = ["https://*.example.com/*", "https://test.com/*", "https://*.google.com/*"];
        var test_urls: [str] = [
            "https://example.com/page",
            "https://test.com/page",
            "https://google.com/search",
            "https://other.com/page",
            "https://example.com/"
        ];
        
        var start_time = get_timestamp_ns();
        
        // Test URL matching 1000 times
        for (var i = 0; i < 1000; i++) {
            for (url in test_urls) {
                var result = url_matches_permissions(url, permissions);
            }
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        var avg_time = total_time / (1000 * test_urls.len);
        
        // Target: < 0.01ms per URL match
        assert(avg_time < 10000); // 0.01ms in nanoseconds
        
        return avg_time;
    }
    
    bench "permission_grouping_speed" {
        var start_time = get_timestamp_ns();
        
        // Group permissions 1000 times
        for (var i = 0; i < 1000; i++) {
            var essential_only = ESSENTIAL_PERMISSIONS;
            var monitoring_only = MONITORING_PERMISSIONS;
            var notification_only = NOTIFICATION_PERMISSIONS;
            var combined = essential_only + monitoring_only + notification_only;
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        var avg_time = total_time / 1000;
        
        // Target: < 0.001ms per grouping operation
        assert(avg_time < 1000); // 0.001ms in nanoseconds
        
        return avg_time;
    }
    
    bench "manifest_serialization_overhead" {
        var manifest = create_manifest();
        var start_time = get_timestamp_ns();
        
        // Serialize manifest 100 times
        for (var i = 0; i < 100; i++) {
            var json_string = serialize_manifest(manifest);
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        var avg_time = total_time / 100;
        
        // Target: < 5ms per serialization
        assert(avg_time < 5000000); // 5ms in nanoseconds
        
        return avg_time;
    }
    
    // ============================================================================
    // UTILITY FUNCTIONS
    // ============================================================================
    
    /// Get current timestamp in nanoseconds
    fn get_timestamp_ns() -> u64 {
        return 0; // Implementation would get actual timestamp
    }
    
    /// Serialize manifest to JSON string
    fn serialize_manifest(manifest: Manifest) -> str {
        return ""; // Implementation would serialize to JSON
    }
}