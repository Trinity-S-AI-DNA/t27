    // ============================================================================
    // TESTS - L4 COMPLIANCE
    // ============================================================================
    
    test "extension_initialization" {
        var config = initialize_extension();
        assert(config.monitoring_enabled == true);
        assert(config.monitoring_mode == MonitoringMode::COMPREHENSIVE);
        assert(config.collection_interval == DATA_COLLECTION_INTERVAL);
        assert(config.performance_thresholds[0] == CPU_THRESHOLD);
        assert(config.performance_thresholds[1] == MEMORY_THRESHOLD);
        assert(config.data_retention_days == 30);
        assert(config.notification_enabled == true);
        assert(config.debug_mode == false);
    }
    
    test "phi_constants_consistency" {
        assert(PHI == 1.618033988749895);
        assert(PHI_INV == 0.618033988749895);
        assert(PHI * PHI_INV == 1.0);
        assert(PHI + PHI_INV == PHI + 1.0);
    }
    
    test "monitoring_intervals_phi_structured" {
        assert(MONITORING_INTERVAL_BASE == 618);
        assert(MONITORING_INTERVAL_EXTENDED == 1618);
        assert(MONITORING_INTERVAL_EXTENDED == u64(PHI * 1000.0));
        assert(MONITORING_INTERVAL_BASE == u64(PHI_INV * 1000.0));
    }
    
    test "performance_thresholds_valid" {
        assert(CPU_THRESHOLD > 0.5 && CPU_THRESHOLD < 1.0);
        assert(MEMORY_THRESHOLD > 0.5 && MEMORY_THRESHOLD < 1.0);
        assert(LATENCY_THRESHOLD > 0);
        assert(CPU_THRESHOLD < MEMORY_THRESHOLD); // CPU should trigger before memory
    }
    
    test "extension_state_enum_values" {
        assert(ExtensionState::INSTALLED as u8 == 0);
        assert(ExtensionState::ACTIVE as u8 == 1);
        assert(ExtensionState::INACTIVE as u8 == 2);
        assert(ExtensionState::ERROR as u8 == 3);
        assert(ExtensionState::UPDATING as u8 == 4);
        assert(ExtensionState::UNINSTALLING as u8 == 5);
    }
    
    test "monitoring_mode_enum_values" {
        assert(MonitoringMode::PERFORMANCE as u8 == 0);
        assert(MonitoringMode::NETWORK as u8 == 1);
        assert(MonitoringMode::MEMORY as u8 == 2);
        assert(MonitoringMode::CUSTOM as u8 == 3);
        assert(MonitoringMode::COMPREHENSIVE as u8 == 4);
    }
    
    test "data_collection_state_enum_values" {
        assert(DataCollectionState::IDLE as u8 == 0);
        assert(DataCollectionState::COLLECTING as u8 == 1);
        assert(DataCollectionState::PROCESSING as u8 == 2);
        assert(DataCollectionState::STORING as u8 == 3);
        assert(DataCollectionState::ERROR_STATE as u8 == 4);
    }
    
    test "metrics_collection_structure" {
        var metrics = collect_metrics();
        assert(metrics.timestamp_ns > 0);
        assert(metrics.cpu_usage >= 0.0 && metrics.cpu_usage <= 1.0);
        assert(metrics.memory_usage >= 0.0 && metrics.memory_usage <= 1.0);
        assert(metrics.network_latency >= 0);
        assert(metrics.active_tabs >= 0);
        assert(metrics.extension_memory >= 0);
        assert(metrics.response_time >= 0);
    }
    
    test "performance_analysis_alerts" {
        // Create test metrics with high CPU
        var metrics: PerformanceMetrics;
        metrics.timestamp_ns = 1234567890;
        metrics.cpu_usage = 0.90; // Above threshold
        metrics.memory_usage = 0.60;
        metrics.network_latency = 50;
        metrics.active_tabs = 5;
        metrics.extension_memory = 1024000;
        metrics.response_time = 75;
        
        var alerts = analyze_performance(metrics);
        assert(alerts.len == 1);
        assert(alerts[0] == "High CPU usage detected: 90.0%");
    }
    
    test "notification_generation" {
        var notification = generate_notification("Test alert", 1);
        assert(notification.title == "Performance Alert");
        assert(notification.message == "Test alert");
        assert(notification.severity == 1);
        assert(notification.timestamp > 0);
        assert(notification.acknowledged == false);
        assert(notification.id.len > 0);
    }
    
    test "data_cleanup_logic" {
        var removed_count = cleanup_old_data(30);
        assert(removed_count >= 0);
    }
    
    test "monitoring_start_function" {
        var config = initialize_extension();
        var started = start_monitoring(&config);
        assert(started == true);
    }
    
    test "storage_key_generation" {
        var key1 = "metrics_" + u64_to_str(1234567890);
        var key2 = "metrics_" + u64_to_str(1234567891);
        assert(key1 != key2);
        assert(key1.len > 0);
        assert(key2.len > 0);
    }
    
    test "phi_ratio_relationship" {
        // Verify φ² = φ + 1 identity
        var phi_squared = PHI * PHI;
        var phi_plus_one = PHI + 1.0;
        assert(phi_squared == phi_plus_one);
        
        // Verify φ² + φ⁻² = 3
        var phi_inv_squared = PHI_INV * PHI_INV;
        var identity_sum = phi_squared + phi_inv_squared;
        assert(identity_sum == 3.0);
    }
    
    // ============================================================================
    // INVARIANTS - L5 COMPLIANCE (PHI IDENTITY)
    // ============================================================================
    
    invariant "phi_identity_verification" {
        assert(PHI * PHI_INV == 1.0);
        assert(PHI + PHI_INV == PHI + 1.0);
        assert(PHI * PHI == PHI + 1.0);
        assert(PHI_INV * PHI_INV == 1.0 - PHI_INV);
    }
    
    invariant "monitoring_intervals_phi_structure" {
        assert(MONITORING_INTERVAL_EXTENDED == u64(PHI * 1000.0));
        assert(MONITORING_INTERVAL_BASE == u64(PHI_INV * 1000.0));
        assert(MONITORING_INTERVAL_EXTENDED == MONITORING_INTERVAL_BASE * 3); // φ ≈ 3 in integer terms
    }
    
    invariant "performance_bounds" {
        assert(CPU_THRESHOLD > 0.0 && CPU_THRESHOLD <= 1.0);
        assert(MEMORY_THRESHOLD > 0.0 && MEMORY_THRESHOLD <= 1.0);
        assert(LATENCY_THRESHOLD > 0);
        assert(DATA_COLLECTION_INTERVAL > 0);
        assert(MONITORING_INTERVAL_BASE > 0);
        assert(MONITORING_INTERVAL_EXTENDED > 0);
    }
    
    invariant "memory_usage_bounds" {
        // Memory usage should always be between 0 and 1 (0% to 100%)
        assert(measure_memory_usage() >= 0.0 && measure_memory_usage() <= 1.0);
    }
    
    invariant "cpu_usage_bounds" {
        // CPU usage should always be between 0 and 1 (0% to 100%)
        assert(measure_cpu_usage() >= 0.0 && measure_cpu_usage() <= 1.0);
    }
    
    invariant "timestamp_monotonic" {
        var time1 = get_timestamp_ns();
        var time2 = get_timestamp_ns();
        assert(time2 >= time1); // Time should not go backwards
    }
    
    invariant "data_storage_consistency" {
        var test_metrics = collect_metrics();
        var storage_success = store_metrics(test_metrics);
        if (storage_success) {
            assert(test_metrics.timestamp_ns > 0);
        }
    }
    
    invariant "notification_severity_levels" {
        assert(generate_notification("Low", 0).severity == 0);
        assert(generate_notification("Medium", 1).severity == 1);
        assert(generate_notification("High", 2).severity == 2);
    }
    
    // ============================================================================
    // BENCHMARKS - L4 COMPLIANCE
    // ============================================================================
    
    bench "metrics_collection_overhead" {
        // Measure the overhead of collecting performance metrics
        var start_time = get_timestamp_ns();
        
        // Collect metrics multiple times
        for (var i = 0; i < 100; i++) {
            var metrics = collect_metrics();
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        
        // Target: < 10ms per 100 collections
        assert(total_time < 10000000); // 10ms in nanoseconds
        var avg_time_per_collection = total_time / 100;
        
        return avg_time_per_collection;
    }
    
    bench "performance_analysis_speed" {
        // Measure speed of performance analysis
        var test_metrics: PerformanceMetrics;
        test_metrics.timestamp_ns = get_timestamp_ns();
        test_metrics.cpu_usage = 0.95;
        test_metrics.memory_usage = 0.85;
        test_metrics.network_latency = 150;
        test_metrics.active_tabs = 10;
        test_metrics.extension_memory = 2048000;
        test_metrics.response_time = 120;
        
        var start_time = get_timestamp_ns();
        
        // Run analysis 100 times
        for (var i = 0; i < 100; i++) {
            var alerts = analyze_performance(test_metrics);
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        
        // Target: < 5ms per 100 analyses
        assert(total_time < 5000000); // 5ms in nanoseconds
        var avg_time_per_analysis = total_time / 100;
        
        return avg_time_per_analysis;
    }
    
    bench "notification_generation_overhead" {
        // Measure notification generation overhead
        var start_time = get_timestamp_ns();
        
        // Generate notifications 100 times
        for (var i = 0; i < 100; i++) {
            var notification = generate_notification("Test alert " + u64_to_str(i), i % 3);
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        
        // Target: < 2ms per 100 notifications
        assert(total_time < 2000000); // 2ms in nanoseconds
        var avg_time_per_notification = total_time / 100;
        
        return avg_time_per_notification;
    }
    
    bench "data_cleanup_efficiency" {
        // Measure data cleanup efficiency
        var start_time = get_timestamp_ns();
        var removed_count = cleanup_old_data(30);
        var end_time = get_timestamp_ns();
        var cleanup_time = end_time - start_time;
        
        // Target: < 100ms cleanup regardless of data size
        assert(cleanup_time < 100000000); // 100ms in nanoseconds
        
        return cleanup_time;
    }
    
    bench "monitoring_startup_time" {
        // Time it takes to start monitoring
        var config = initialize_extension();
        var start_time = get_timestamp_ns();
        
        var success = start_monitoring(&config);
        var end_time = get_timestamp_ns();
        var startup_time = end_time - start_time;
        
        assert(success == true);
        
        // Target: < 50ms startup time
        assert(startup_time < 50000000); // 50ms in nanoseconds
        
        return startup_time;
    }
    
    bench "phi_calculations_accuracy" {
        // Verify the accuracy of φ-based calculations
        var start_time = get_timestamp_ns();
        
        // Perform φ-related calculations 1000 times
        for (var i = 0; i < 1000; i++) {
            var phi_test1 = PHI * PHI;
            var phi_test2 = PHI + 1.0;
            var phi_test3 = PHI_INV * PHI_INV;
            var phi_test4 = 1.0 - PHI_INV;
        }
        
        var end_time = get_timestamp_ns();
        var total_time = end_time - start_time;
        
        // Verify mathematical consistency
        assert(PHI * PHI == PHI + 1.0);
        assert(PHI * PHI_INV == 1.0);
        assert(PHI + PHI_INV == PHI + 1.0);
        
        return total_time;
    }
}