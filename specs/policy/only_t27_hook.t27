// SPDX-License-Identifier: Apache-2.0
// specs/policy/only_t27_hook.t27 -- Only-t27 local hook reads no owner label:
// a protected file authorized on the PR cannot be pushed from a lane.
// Part of M4 milestone (milestone #8). Closes #13063.
// phi^2 + 1/phi^2 = 3 | TRINITY

module policy::only_t27_hook;

pub const ONLY_T27_HOOK_OWNER_LABEL_REQUIRED : bool = true;

pub struct HookCheck { owner_label: bool, protected_file: bool };

pub fn hook_check_allows_push(h: HookCheck) -> bool {
    return !h.protected_file || h.owner_label;
}

test "hook_check_allows_push" {
    assert(hook_check_allows_push(HookCheck { owner_label: true, protected_file: true }));
    assert(!hook_check_allows_push(HookCheck { owner_label: false, protected_file: true }));
    assert(hook_check_allows_push(HookCheck { owner_label: false, protected_file: false }));
}

invariant only_t27_hook_owner_label_required {
    assert ONLY_T27_HOOK_OWNER_LABEL_REQUIRED;
}