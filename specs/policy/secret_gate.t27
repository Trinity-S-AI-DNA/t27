// SPDX-License-Identifier: Apache-2.0
; specs/policy/secret_gate.t27 -- the gitleaks rules of the secret gate (#6432), as data in t27.
; The gate has three layers (SECURITY.md): lefthook pre-commit scans staged changes, lefthook
; pre-push scans commits not yet on a remote, and CI (secret-scan.yml, job `scan`) scans the
; commits a pull request or push adds. All three read one config: the bytes gitleaks_toml()
; writes. gen/c/policy/secret_gate.c is its t27c gen-c output (L2); the hooks and the workflow
; build a one-line C main around it (the gen/c/policy idiom of own_language.c), write the TOML
; to a temp file and pass it to gitleaks --config. A hand-written .gitleaks.toml would be a
; second home for these rules, and the Only-t27 budget (owner rule 2026-10-09) refuses it.
; --
; What the rules say: gitleaks' default rules stay on (useDefault), one rule adds plain
; passwords and Wi-Fi passphrases the defaults miss, placeholders are not secrets, and three
; verified lines plus one generated inventory are allowlisted by name, not by pattern.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module PolicySecretGate;

use claw::text;
pub const T_HEAD : str = "# gen: specs/policy/secret_gate.t27 (t27c gen-c, driver in lefthook.yml and secret-scan.yml). Do not edit.\n";
pub const T_HEAD_LEN : usize = 107;
pub const T_EXTEND : str = "[extend]\nuseDefault = true\n\n";
pub const T_EXTEND_LEN : usize = 28;
pub const T_RULE : str = "[[rules]]\nid = \"hardcoded-password-literal\"\ndescription = \"Hardcoded password/passphrase string literal (e.g. Wi-Fi credentials in firmware)\"\n";
pub const T_RULE_LEN : usize = 142;
pub const T_RULE_REGEX : str = "regex = '''(?i)\\b[a-z_]*(passphrase|password|passwd|wifi_?pass|psk)[a-z_]*\\b[\"']?\\s*[:=]\\s*[\"']([^\"'<>${}\\s]{6,})[\"']'''\n";
pub const T_RULE_REGEX_LEN : usize = 121;
pub const T_RULE_TAIL : str = "secretGroup = 2\nkeywords = [\"passphrase\", \"password\", \"passwd\", \"wifi\", \"psk\"]\n";
pub const T_RULE_TAIL_LEN : usize = 79;
pub const T_PLACEHOLDERS : str = "[[rules.allowlists]]\nregexTarget = \"match\"\nregexes = ['''(?i)(your|example|changeme|placeholder|dummy|test|xxx|\\*\\*\\*)''']\n\n";
pub const T_PLACEHOLDERS_LEN : usize = 124;
pub const T_INVENTORY : str = "[[allowlists]]\ndescription = \"Verified non-secrets in t27: generated symbol inventory\"\npaths = ['''conformance/trinity/inventory\\.json''']\n\n";
pub const T_INVENTORY_LEN : usize = 140;
pub const T_LINES : str = "[[allowlists]]\ndescription = \"Verified non-secret lines: GF16 hex constant, prose, compiler flags\"\nregexTarget = \"line\"\nregexes = [\n  '''hex_key = .*# fallback for GF16''',\n  '''pub const NOTE : str = \"S07:''',\n  '''\"-O\", mode, \"--dep\"''',\n]\n";
pub const T_LINES_LEN : usize = 242;

/// Every byte of the TOML, so a change to the rules moves this number in the same commit.
pub const TOML_LEN : usize = 983;

/// Write the gitleaks config into out[0..cap] and return its length (a clipped write still
/// returns the full length, so the caller compares it with cap).
pub fn gitleaks_toml(out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    w = put_str(out, cap, w, T_HEAD, T_HEAD_LEN);
    w = put_str(out, cap, w, T_EXTEND, T_EXTEND_LEN);
    w = put_str(out, cap, w, T_RULE, T_RULE_LEN);
    w = put_str(out, cap, w, T_RULE_REGEX, T_RULE_REGEX_LEN);
    w = put_str(out, cap, w, T_RULE_TAIL, T_RULE_TAIL_LEN);
    w = put_str(out, cap, w, T_PLACEHOLDERS, T_PLACEHOLDERS_LEN);
    w = put_str(out, cap, w, T_INVENTORY, T_INVENTORY_LEN);
    w = put_str(out, cap, w, T_LINES, T_LINES_LEN);
    return w;
}

/// Each piece ends with its newline exactly where its _LEN says (a runtime index, so the check
/// runs under the zig runner and under gen-c alike; gen-c has no .len for str).
test every_piece_ends_where_its_length_says {
    var i : usize = 0;
    i = T_HEAD_LEN - 1;
    assert T_HEAD[i] == '\n';
    i = T_EXTEND_LEN - 1;
    assert T_EXTEND[i] == '\n';
    i = T_RULE_LEN - 1;
    assert T_RULE[i] == '\n';
    i = T_RULE_REGEX_LEN - 1;
    assert T_RULE_REGEX[i] == '\n';
    i = T_RULE_TAIL_LEN - 1;
    assert T_RULE_TAIL[i] == '\n';
    i = T_PLACEHOLDERS_LEN - 1;
    assert T_PLACEHOLDERS[i] == '\n';
    i = T_INVENTORY_LEN - 1;
    assert T_INVENTORY[i] == '\n';
    i = T_LINES_LEN - 1;
    assert T_LINES[i] == '\n';
}

test the_config_is_whole_and_pinned {
    var out : [4096]u8 = undefined;
    const n : usize = gitleaks_toml(&out, 4096);
    assert n == TOML_LEN;
    assert buf_has(&out, n, "[extend]\nuseDefault = true\n", 26) == true;
}

test the_password_rule_names_every_keyword {
    var out : [4096]u8 = undefined;
    const n : usize = gitleaks_toml(&out, 4096);
    assert buf_has(&out, n, "id = \"hardcoded-password-literal\"", 33) == true;
    assert buf_has(&out, n, "keywords = [\"passphrase\", \"password\", \"passwd\", \"wifi\", \"psk\"]", 61) == true;
    assert buf_has(&out, n, "secretGroup = 2", 15) == true;
}

test placeholders_and_verified_lines_are_allowlisted {
    var out : [4096]u8 = undefined;
    const n : usize = gitleaks_toml(&out, 4096);
    assert buf_has(&out, n, "changeme|placeholder", 20) == true;
    assert buf_has(&out, n, "conformance/trinity/inventory\\.json", 35) == true;
    assert buf_has(&out, n, "# fallback for GF16", 19) == true;
}

test a_short_buffer_is_clipped_but_counted {
    var out : [8]u8 = undefined;
    const n : usize = gitleaks_toml(&out, 8);
    assert n == TOML_LEN;
    assert buf_has(&out, 8, "# gen: s", 8) == true;
}
