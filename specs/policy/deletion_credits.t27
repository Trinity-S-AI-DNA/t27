// SPDX-License-Identifier: Apache-2.0
; specs/policy/deletion_credits.t27 -- the deletion-credits queue: pre-measured
; migration candidates a lane may draw to balance the foreign budget (owner
; rule 2026-10-09: hand-written foreign lines added may never exceed deleted;
# the lefthook foreign-budget gate refuses the commit otherwise). Each entry
; names a file, the spec whose landing deletes there, and the measured line
; delta of that migration. A lane draws entries for its pull request; the
; drawing pull request removes the entries it consumed and lands the
; migration, so the queue only ever holds work nobody has landed yet.
; The ledger is tools/deletion_credits.txt (same shape as red_baseline).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module PolicyDeletionCredits;

; A credit entry, as the ledger holds it: how many hand-written foreign lines
; the migration deletes and how many it adds. A candidate with more additions
; than deletions is not a credit, it is a debt, and the queue refuses it.
pub const MAX_DELTA_LINES : u32 = 200;
pub const QUEUE_MAX : u32 = 32;

pub fn entry_ok(deletes: u32, adds: u32) -> bool {
    if (deletes < adds) {
        return false;
    }
    if (deletes > MAX_DELTA_LINES) {
        return false;
    }
    return deletes > 0;
}

; A lane may draw a set of credits for a pull request whose planned foreign
; additions are `planned_adds`: the drawn deletions must cover them.
pub fn draw_covers(drawn_deletes: u32, planned_adds: u32) -> bool {
    return drawn_deletes >= planned_adds;
}

; Consuming must remove exactly what was drawn: the queue shrinks by the
; consumed entries' deletions, never more, never less (a silent double-draw
; is how two lanes land one migration twice).
pub fn consume_ok(before: u32, after: u32, consumed: u32) -> bool {
    return before == after + consumed;
}

; The queue stays under its cap and only holds real credits.
pub fn queue_ok(size: u32) -> bool {
    return size <= QUEUE_MAX;
}

test a_credit_deletes_at_least_as_much_as_it_adds {
    assert entry_ok(28, 28);
    assert entry_ok(28, 17);
    assert entry_ok(12, 0);
    assert entry_ok(17, 28) == false;
    assert entry_ok(0, 0) == false;
    assert entry_ok(201, 0) == false;
    assert entry_ok(MAX_DELTA_LINES, 0);
}
test a_draw_covers_the_planned_additions_or_the_lane_waits {
    assert draw_covers(28, 28);
    assert draw_covers(40, 28);
    assert draw_covers(27, 28) == false;
    assert draw_covers(0, 0);
}
test consuming_shrinks_the_queue_by_exactly_the_draw {
    assert consume_ok(40, 12, 28);
    assert consume_ok(40, 40, 0);
    assert consume_ok(40, 11, 28) == false;
    assert consume_ok(40, 12, 29) == false;
}
test the_queue_holds_bounded_real_work {
    assert queue_ok(0);
    assert queue_ok(QUEUE_MAX);
    assert queue_ok(QUEUE_MAX + 1) == false;
}
