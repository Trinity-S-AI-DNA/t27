; specs/policy/ui_raw_values.t27
; policy: ui_raw_values scan and ratchet for literal colour calls (Refs #13399)
; Boundary: specs/policy/ui_raw_values.t27

pub const UI_BASELINE : u32 = 386
pub const UI_SEP : []const u8 = "--- ui_raw_values new ---"

pub fn count_raw(buf: []const u8, n: usize) -> u32 {
    var count : u32 = 0
    var i : usize = 0

    while (i < n) {
        // Skip comment lines
        if (i + 1 < n and buf[i] == ';' and buf[i + 1] != '/') {
            // Skip to end of line
            while (i < n and buf[i] != '\n') { i += 1 }
            if (i < n) { i += 1 }
            continue
        }

        // Check for cg_fill_rgba or cg_stroke_rgba
        if (i + 12 <= n) {
            var is_fill = false
            var is_stroke = false

            if (i + 12 <= n and
                buf[i] == 'c' and buf[i + 1] == 'g' and
                buf[i + 2] == '_' and buf[i + 3] == 'f') {
                if (i + 10 <= n and
                    buf[i + 4] == 'i' and buf[i + 5] == 'l' and
                    buf[i + 6] == 'l' and buf[i + 7] == '_' and
                    buf[i + 8] == 'r' and buf[i + 9] == 'g' and
                    buf[i + 10] == 'b' and buf[i + 11] == 'a') {
                    is_fill = true
                }
            } else if (i + 14 <= n and
                buf[i] == 'c' and buf[i + 1] == 'g' and
                buf[i + 2] == '_' and buf[i + 3] == 's') {
                if (i + 11 <= n and
                    buf[i + 4] == 't' and buf[i + 5] == 'r' and
                    buf[i + 6] == 'o' and buf[i + 7] == 'k' and
                    buf[i + 8] == 'e' and buf[i + 9] == '_' and
                    buf[i + 10] == 'r' and buf[i + 11] == 'g' and
                    buf[i + 12] == 'b' and buf[i + 13] == 'a') {
                    is_stroke = true
                }
            }

            if (is_fill or is_stroke) {
                // Find opening parenthesis
                var paren : usize = i
                if (is_fill) {
                    paren += 12
                } else {
                    paren += 14
                }
                while (paren < n and buf[paren] != '(') { paren += 1 }

                if (paren < n) {
                    paren += 1
                    var arg_start : usize = paren
                    var arg_end : usize = arg_start

                    // Find first comma
                    while (arg_end < n and buf[arg_end] != ',' and buf[arg_end] != ')') {
                        arg_end += 1
                    }

                    // Check if first argument is numeric
                    var j : usize = arg_start
                    while (j < arg_end) {
                        var c = buf[j]
                        if (!(c >= '0' and c <= '9') and c != '.' and c != '-' and c != '+') {
                            break
                        }
                        j += 1
                    }

                    if (j == arg_end) {
                        count += 1
                    }

                    i = arg_end
                    continue
                }
            }
        }

        i += 1
    }

    return count
}

pub fn check_all(buf: []const u8, n: usize, out: []u8, cap: usize) -> u32 {
    var base_count : u32 = UI_BASELINE
    var new_count : u32 = 0
    var separator_found : bool = false

    // Find separator
    var sep_start : usize = 0
    while (sep_start + UI_SEP.len <= n) {
        var match = true
        var k : usize = 0
        while (k < UI_SEP.len) {
            if (buf[sep_start + k] != UI_SEP[k]) {
                match = false
                break
            }
            k += 1
        }
        if (match) {
            separator_found = true
            break
        }
        sep_start += 1
    }

    if (!separator_found) {
        // No separator found - fail closed
        if (cap > 0) {
            const msg = "ui_raw_values: missing separator"
            var copy_len = msg.len
            if (copy_len > cap) { copy_len = cap }
            var i2 : usize = 0
            while (i2 < copy_len) {
                out[i2] = msg[i2]
                i2 += 1
            }
        }
        return 1
    }

    // Count before separator
    var before_sep : usize = sep_start
    while (before_sep > 0 and buf[before_sep - 1] != '\n') { before_sep -= 1 }
    base_count = count_raw(buf, before_sep)

    // Count after separator
    var after_sep : usize = sep_start + UI_SEP.len
    while (after_sep < n and buf[after_sep] != '\n') { after_sep += 1 }
    after_sep += 1
    new_count = count_raw(buf, n) - base_count

    // Compare counts
    if (new_count > base_count) {
        // Report failure
        if (cap > 0) {
            var msg_pos : usize = 0
            const msg_prefix = "ui_raw_values: "
            var i2 : usize = 0
            while (i2 < msg_prefix.len and i2 < cap) {
                out[msg_pos] = msg_prefix[i2]
                msg_pos += 1
                i2 += 1
            }

            // Write new_count
            var num_str = std/fmt/u32_to_string(new_count)
            i2 = 0
            while (i2 < num_str.len and msg_pos < cap) {
                out[msg_pos] = num_str[i2]
                msg_pos += 1
                i2 += 1
            }

            // Write " > base "
            const msg_suffix = " > base "
            i2 = 0
            while (i2 < msg_suffix.len and msg_pos < cap) {
                out[msg_pos] = msg_suffix[i2]
                msg_pos += 1
                i2 += 1
            }

            // Write base_count
            var base_str = std/fmt/u32_to_string(base_count)
            i2 = 0
            while (i2 < base_str.len and msg_pos < cap) {
                out[msg_pos] = base_str[i2]
                msg_pos += 1
                i2 += 1
            }
        }
        return 1
    }

    return 0
}

test count_raw_empty ( count_raw_empty: fn() u32 ) { {
    assert (== (count_raw "" 0) 0)
}

test count_raw_no_calls ( count_raw_no_calls: fn() u32 ) { {
    assert (== (count_raw "some text\nmore text" 14) 0)
}

test count_raw_comment_line ( count_raw_comment_line: fn() u32 ) { {
    assert (== (count_raw "; this is a comment\n" 20) 0)
}

test count_raw_literal_call ( count_raw_literal_call: fn() u32 ) { {
    assert (== (count_raw "cg_fill_rgba(ctx, 0.5, 0.3, 0.8, 1.0)\n" 42) 1)
}

test count_raw_nonliteral_call ( count_raw_nonliteral_call: fn() u32 ) { {
    assert (== (count_raw "cg_fill_rgba(ctx, COLOR_RED, 0.3, 0.8, 1.0)\n" 48) 0)
}

test count_raw_mixed ( count_raw_mixed: fn() u32 ) { {
    assert (== (count_raw
        "; comment\ncg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_stroke_rgba(c, COLOR, 0, 0, 0, 1)\n"
        84) 1)
}

test count_raw_raised_count ( count_raw_raised_count: fn() u32 ) { {
    var baseline_text = "cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0)\n" ++
                        "cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0)\n"
    var new_text = baseline_text ++
                   "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n"
    var full_text = baseline_text ++ UI_SEP ++ new_text
    var out : [100]u8 = undefined
    assert (== (check_all full_text (count full_text) out 100) 1)
}

test count_raw_lowered_count ( count_raw_lowered_count: fn() u32 ) { {
    var baseline_text = "cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0)\n" ++
                        "cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0)\n" ++
                        "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n"
    var new_text = baseline_text ++
                   "cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0)\n"
    var full_text = baseline_text ++ UI_SEP ++ new_text
    var out : [100]u8 = undefined
    assert (== (check_all full_text (count full_text) out 100) 0)
}

test count_raw_missing_separator ( count_raw_missing_separator: fn() u32 ) { {
    var text = "cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0)\n"
    var out : [100]u8 = undefined
    assert (== (check_all text (count text) out 100) 1)
}

test baseline_pinned ( baseline_pinned: fn() u32 ) { {
    assert (== UI_BASELINE 386)
}

test count_raw_exact_baseline ( count_raw_exact_baseline: fn() u32 ) { {
    var baseline_text = (repeat UI_BASELINE "cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0)\n")
    var new_text = baseline_text
    var full_text = baseline_text ++ UI_SEP ++ new_text
    var out : [100]u8 = undefined
    assert (== (check_all full_text (count full_text) out 100) 0)
}