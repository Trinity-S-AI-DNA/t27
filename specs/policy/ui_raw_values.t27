// SPDX-License-Identifier: Apache-2.0
; specs/policy/ui_raw_values.t27
; Ratchet for literal colour calls in .t27 sources.
; Refs #13399. The previous text used Python colons, so t27c stopped at
; "Expected LBrace, got Colon" and emit-bitexact failed every spec pull request.
; The counts are unchanged: a literal first argument to cg_fill_rgba or
; cg_stroke_rgba is a raw call, a name is not, and a ';' comment is skipped.

module ui_raw_values;

pub const UI_BASELINE : u32 = 386;
pub const UI_SEP : str = "--- ui_raw_values new ---";

fn is_digit_char(c: u8) -> bool {
    return c >= 48 and c <= 57;
}

fn is_numeric_start(c: u8) -> bool {
    return is_digit_char(c) or c == 45 or c == 43;
}

fn is_numeric_char(c: u8) -> bool {
    return is_digit_char(c) or c == 46;
}

fn at_lit(s: str, i: usize, n: usize, lit: str) -> bool {
    var ln : usize = lit.len;
    if (i + ln > n) { return false; }
    var k : usize = 0;
    while (k < ln) {
        if (s[i + k] != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

fn count_span(src: str, lo: usize, hi: usize) -> u32 {
    var count : u32 = 0;
    var i : usize = lo;
    while (i < hi) {
        if (src[i] == 59) {
            while (i < hi and src[i] != 10) {
                i = i + 1;
            }
            continue;
        }
        var found_call : bool = false;
        if (i + 12 <= hi and at_lit(src, i, hi, "cg_fill_rgba")) {
            found_call = true;
        } else if (i + 14 <= hi and at_lit(src, i, hi, "cg_stroke_rgba")) {
            found_call = true;
        }
        if (found_call) {
            var j : usize = i;
            while (j < hi and src[j] != 40) {
                j = j + 1;
            }
            if (j < hi) {
                j = j + 1;
                while (j < hi and (src[j] == 32 or src[j] == 9)) {
                    j = j + 1;
                }
                // The drawing context is the first argument (`c`). A raw call is one
                // whose next argument is a numeric literal, not a named colour.
                var arg_start : usize = j;
                if (arg_start < hi and is_numeric_start(src[arg_start]) == false) {
                    while (j < hi and src[j] != 44 and src[j] != 41 and src[j] != 10) {
                        j = j + 1;
                    }
                    if (j < hi and src[j] == 44) {
                        j = j + 1;
                        while (j < hi and (src[j] == 32 or src[j] == 9)) {
                            j = j + 1;
                        }
                        arg_start = j;
                    }
                }
                if (arg_start < hi and is_numeric_start(src[arg_start])) {
                    var k : usize = arg_start + 1;
                    while (k < hi and is_numeric_char(src[k])) {
                        k = k + 1;
                    }
                    if (k < hi and (src[k] == 44 or src[k] == 41)) {
                        count = count + 1;
                    }
                }
                i = j;
                continue;
            }
        }
        i = i + 1;
    }
    return count;
}

fn count_raw(src: str) -> u32 {
    return count_span(src, 0, src.len);
}

fn check_all(src: str) -> u32 {
    var sep_len : usize = UI_SEP.len;
    var n : usize = src.len;
    var sep_pos : usize = 0;
    var found : bool = false;
    while (sep_pos + sep_len <= n) {
        if (at_lit(src, sep_pos, n, UI_SEP)) {
            found = true;
            break;
        }
        sep_pos = sep_pos + 1;
    }
    if (found == false) { return 1; }
    var before_count : u32 = count_span(src, 0, sep_pos);
    var after_count : u32 = count_span(src, sep_pos + sep_len, n);
    if (after_count > before_count) { return 1; }
    return 0;
}

test "empty source has zero raw calls" {
    assert count_raw("") == 0;
}

test "source with no rgba calls has zero count" {
    assert count_raw("fn foo():\n    return 1\n") == 0;
}

test "comment line is not counted" {
    assert count_raw("; cg_fill_rgba(c, 0.5, 0.0, 0.0, 1.0)\n") == 0;
}

test "literal fill call is counted" {
    assert count_raw("cg_fill_rgba(c, 0.5, 0.3, 0.8, 1.0)\n") == 1;
}

test "named-constant fill call is not counted" {
    assert count_raw("cg_fill_rgba(c, COLOR_RED, 0.3, 0.8, 1.0)\n") == 0;
}

test "literal stroke call is counted" {
    assert count_raw("cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0)\n") == 1;
}

test "one literal one named gives count 1" {
    assert count_raw("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_fill_rgba(c, COLOR, 0.0, 0.0, 1.0)\n") == 1;
}

test "baseline constant is 386" {
    assert UI_BASELINE == 386;
}

test "check_all passes when new count equals old count" {
    assert check_all("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n--- ui_raw_values new ---cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n") == 0;
}

test "check_all fails when missing separator" {
    assert check_all("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n") == 1;
}

test "check_all fails when new count exceeds old count" {
    assert check_all("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n--- ui_raw_values new ---cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_fill_rgba(c, 0.5, 0.5, 0.5, 1.0)\n") == 1;
}

test "check_all passes when new count is less than old count" {
    assert check_all("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_fill_rgba(c, 0.0, 0.0, 1.0, 1.0)\n--- ui_raw_values new ---cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n") == 0;
}
