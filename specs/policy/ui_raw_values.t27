; specs/policy/ui_raw_values.t27
; Ratchet for literal colour calls in .t27 sources
; Refs #13399
; Bodies use braces: t27c check reports Expected LBrace, got Colon
; on the colon form that landed in #13437.

module ui_raw_values;

pub const UI_BASELINE: u32 = 386;
pub const UI_SEP: str = "--- ui_raw_values new ---";

fn is_digit_char(c: u8) -> bool {
    return c >= '0' and c <= '9';
}

fn is_numeric_start(c: u8) -> bool {
    return is_digit_char(c) or c == '-' or c == '+';
}

fn is_numeric_char(c: u8) -> bool {
    return is_digit_char(c) or c == '.';
}

fn count_raw(src: str) -> u32 {
    var count: u32 = 0;
    var i: usize = 0;
    var n: usize = src.len;
    while (i < n) {
        if (src[i] == ';') {
            while (i < n and src[i] != '\n') {
                i = i + 1;
            }
            continue;
        }
        var found_call: bool = false;
        if (i + 12 <= n) {
            if (src[i..i+12] == "cg_fill_rgba") {
                found_call = true;
            } else if (i + 14 <= n and src[i..i+14] == "cg_stroke_rgba") {
                found_call = true;
            }
        }
        if (found_call) {
            var j: usize = i;
            while (j < n and src[j] != '(') {
                j = j + 1;
            }
            if (j < n) {
                j = j + 1;
                while (j < n and (src[j] == ' ' or src[j] == '\t')) {
                    j = j + 1;
                }
                var arg_start: usize = j;
                if (arg_start < n and is_numeric_start(src[arg_start])) {
                    var k: usize = arg_start + 1;
                    while (k < n and is_numeric_char(src[k])) {
                        k = k + 1;
                    }
                    if (k < n and (src[k] == ',' or src[k] == ')')) {
                        count = count + 1;
                    }
                }
                i = j;
                continue;
            }
        }
        i = i + 1;
    }
    return count;
}

fn check_all(src: str) -> u32 {
    var sep_pos: usize = 0;
    var sep_len: usize = UI_SEP.len;
    var n: usize = src.len;
    var found: bool = false;
    while (sep_pos + sep_len <= n) {
        if (src[sep_pos..sep_pos+sep_len] == UI_SEP) {
            found = true;
            break;
        }
        sep_pos = sep_pos + 1;
    }
    if (found == false) {
        return 1;
    }
    var before: str = src[0..sep_pos];
    var after: str = src[sep_pos+sep_len..n];
    var before_count: u32 = count_raw(before);
    var after_count: u32 = count_raw(after);
    if (after_count > before_count) {
        return 1;
    }
    return 0;
}

test "empty source has zero raw calls" {
    assert count_raw("") == 0;
}

test "source with no rgba calls has zero count" {
    assert count_raw("fn foo():\n    return 1\n") == 0;
}

test "comment line is not counted" {
    assert count_raw("; cg_fill_rgba(c, 0.5, 0.0, 0.0, 1.0)\n") == 0;
}

test "literal fill call is counted" {
    assert count_raw("cg_fill_rgba(c, 0.5, 0.3, 0.8, 1.0)\n") == 1;
}

test "named-constant fill call is not counted" {
    assert count_raw("cg_fill_rgba(c, COLOR_RED, 0.3, 0.8, 1.0)\n") == 0;
}

test "literal stroke call is counted" {
    assert count_raw("cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0)\n") == 1;
}

test "one literal one named gives count 1" {
    assert count_raw("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_fill_rgba(c, COLOR, 0.0, 0.0, 1.0)\n") == 1;
}

test "baseline constant is 386" {
    assert UI_BASELINE == 386;
}

test "check_all passes when new count equals old count" {
    var src: str = "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n";
    var full: str = src + UI_SEP + src;
    assert check_all(full) == 0;
}

test "check_all fails when missing separator" {
    assert check_all("cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n") == 1;
}

test "check_all fails when new count exceeds old count" {
    var before: str = "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n";
    var after: str = before + "cg_fill_rgba(c, 0.5, 0.5, 0.5, 1.0)\n";
    var full: str = before + UI_SEP + after;
    assert check_all(full) == 1;
}

test "check_all passes when new count is less than old count" {
    var before: str = "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\ncg_fill_rgba(c, 0.0, 0.0, 1.0, 1.0)\n";
    var after: str = "cg_fill_rgba(c, 1.0, 0.0, 0.0, 1.0)\n";
    var full: str = before + UI_SEP + after;
    assert check_all(full) == 0;
}
