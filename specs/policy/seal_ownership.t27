// SPDX-License-Identifier: Apache-2.0
; specs/policy/seal_ownership.t27 -- whose stale seal is it? (Trinity-S-AI-DNA/t27#12479,
; Pareto variant 2). The spec-guards gate today reports stale seals as one long red run, and a
; PR whose lane never touched the spec cannot fix them -- measured on 2026-10-26: ten stale
; seals red on every PR while nine belonged to other merged lanes and one (wasm) was a refused
; regression. This is the law of ATTRIBUTION the gate output should speak:
; - a stale seal whose spec is in THIS PR's diff is the PR's own: reseal it before the merge;
; - a stale seal whose spec the PR never touched is FOREIGN: the gate names the owning lane
;   instead of asking this PR for the impossible.
; The seal command's own rule stands above this file: a regression is not a reseal (measured the
; same day on specs/tri/t27b/wasm.t27, refused for WOP_AND) -- attribution never upgrades a
; refused seal into an owned one; it stays stale until the fix lands.
; ASCII only (L3), English. Tests use fake paths.
; phi^2 + 1/phi^2 = 3 | TRINITY

module PolicySealOwnership;

// --- The actions -------------------------------------------------------------------------------

pub const A_NONE : u8 = 0;
pub const A_RESEAL_NOW : u8 = 1;
pub const A_NAME_OWNER : u8 = 2;
pub const ACTION_NAMES : str = "none,reseal-now,name-owner";

// --- The attribution ---------------------------------------------------------------------------

/// Whether THIS PR's diff touches the spec a seal seals. `diff_csv` is the PR's changed spec
; paths as a comma-separated list, exact matches only: a prefix ("specs/t27os/lab") does not
; own ("specs/t27os/lab_legs.t27"), and an empty diff owns nothing.
pub fn owns(diff_csv : []const u8, spec_path : []const u8) -> bool {
    if (spec_path.len == 0 or diff_csv.len == 0) { return false; }
    var pos : usize = 0;
    while (pos < diff_csv.len) {
        var end : usize = pos;
        while (end < diff_csv.len and diff_csv[end] != 44) { end = end + 1; }
        if (field_eq(diff_csv, pos, end, spec_path)) { return true; }
        pos = end + 1;
    }
    return false;
}

fn field_eq(list : []const u8, start : usize, end : usize, name : []const u8) -> bool {
    if (end - start != name.len) { return false; }
    if (name.len == 0) { return false; }
    var i : usize = 0;
    while (i < name.len) {
        if (list[start + i] != name[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// What the gate asks of a seal: A_NONE when it is fresh, A_RESEAL_NOW when THIS PR owns the
; stale spec (it reseals before the merge, `t27c seal <spec> --save`, never --force),
; A_NAME_OWNER when the PR is foreign -- the gate names the owning lane instead of failing
; this PR for what it cannot fix.
pub fn action_for(owned : bool, stale : bool) -> u8 {
    if (stale == false) { return A_NONE; }
    if (owned) { return A_RESEAL_NOW; }
    return A_NAME_OWNER;
}

// --- Tests --------------------------------------------------------------------------------------

test the_diff_owns_its_own_specs_and_not_prefixes {
    let diff : []const u8 = "specs/t27os/lab_legs.t27,specs/queen/api_fleet.t27";
    assert owns(diff, "specs/t27os/lab_legs.t27");
    assert owns(diff, "specs/queen/api_fleet.t27");
    // a prefix of a real path owns nothing
    assert owns(diff, "specs/t27os/lab.t27") == false;
    assert owns(diff, "specs/t27os/lab_legs.t28") == false;
    assert owns(diff, "") == false;
    let empty : []const u8 = "";
    assert owns(empty, "specs/t27os/lab_legs.t27") == false;
}

test the_actions_follow_ownership {
    // fresh seal: nothing is asked of anyone
    assert action_for(true, false) == A_NONE;
    assert action_for(false, false) == A_NONE;
    // the own stale spec of this PR: reseal before the merge
    assert action_for(true, true) == A_RESEAL_NOW;
    // a foreign stale spec: name the owner, never failing this PR
    assert action_for(false, true) == A_NAME_OWNER;
}

// --- Invariants ---------------------------------------------------------------------------------

invariant the_action_vocabulary_is_three_words {
    assert A_NONE == 0 and A_RESEAL_NOW == 1 and A_NAME_OWNER == 2;
}
