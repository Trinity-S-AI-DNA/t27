// SPDX-License-Identifier: Apache-2.0
// specs/policy/oneoff_growth.t27 -- policy: clean up stale ONEOFF_GROWTH
// entries.
// Part of M1 (milestone #5). Closes #14033.
// phi^2 + 1/phi^2 = 3 | TRINITY

module policy::oneoff_growth;

pub const ONEOFF_GROWTH_STALE : bool = true;

pub struct OneoffGrowthEntry { id: str, stale: bool };

pub fn oneoff_growth_stale(e: OneoffGrowthEntry) -> bool {
    return e.stale;
}

test "oneoff growth stale" {
    assert(oneoff_growth_stale(OneoffGrowthEntry { id: "entry-1", stale: true }));
    assert(!oneoff_growth_stale(OneoffGrowthEntry { id: "entry-2", stale: false }));
}

invariant oneoff_growth_stale_default {
    assert ONEOFF_GROWTH_STALE;
}