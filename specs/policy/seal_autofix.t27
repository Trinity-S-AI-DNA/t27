; specs/policy/seal_autofix.t27 -- the seal rides with its spec (Refs #12706).
; The night of 2026-10-26 four PRs sat DIRTY for hours on stale seals while
; the queue kept merging, and the wasm floor-13 law landed with its seal
; stale in the same hour (#12708 class A). The rule this spec states closes
; both doors: a push that changes a sealed spec carries that spec's re-seal
; in the SAME push, and when an author forgets, the fix is an event-driven
; autofix on the pull request -- never a scheduled sweep, never a merge.

module policy_seal_autofix;

pub const KIND : str = "policy";
pub const ID : str = "policy/seal-autofix";
pub const NAME : str = "the seal rides with its spec";
pub const SUMMARY_EN : str = "A push that changes a sealed spec re-seals it in the same push; a PR that forgets gets an event-driven autofix that re-seals the changed already-sealed specs onto the PR branch; the autofix never merges and never runs on a schedule.";

/// The host decision for the autofix: pull_request events only, scoped to
/// specs/**/*.t27. A schedule would re-seal master behind nobody's push --
/// verdicts must belong to the push that caused them.
pub const AUTOFIX_HOST : str = "github-actions/pull_request";
pub const AUTOFIX_PATHS : str = "specs/**/*.t27";
pub const AUTOFIX_MERGES : bool = false;
pub const AUTOFIX_SCHEDULED : bool = false;

/// Which changed specs the autofix re-seals: exactly the ones that already
/// carry a seal. A new spec has nothing to refresh; its first seal belongs
/// to the author, with its first test-report.
pub fn autofix_reseals(changed : bool, already_sealed : bool) -> bool {
    return changed and already_sealed;
}

/// The push-side rule the autofix backs up: a changed sealed spec and a
/// seal that does not move with it is a defect the pre-push gate names.
/// (The foreign-budget hook measures the foreign side; this is the seal
/// side of the same shape: what moved together lands together.)
pub fn seal_rides_with_spec(spec_changed : bool, seal_changed : bool, was_sealed : bool) -> bool {
    if (was_sealed == false) { return true; }
    if (spec_changed == false) { return true; }
    return seal_changed;
}

test the_autofix_touches_exactly_the_sealed_changed_specs {
    assert autofix_reseals(true, true);
    assert autofix_reseals(true, false) == false;
    assert autofix_reseals(false, true) == false;
    assert autofix_reseals(false, false) == false;
}

test the_ride_rule_spares_everything_but_a_drifted_seal {
    assert seal_rides_with_spec(true, true, true);
    assert seal_rides_with_spec(true, false, true) == false;
    assert seal_rides_with_spec(false, false, true);
    assert seal_rides_with_spec(true, false, false);
}

test the_autofix_stays_in_its_lane {
    assert AUTOFIX_MERGES == false;
    assert AUTOFIX_SCHEDULED == false;
    assert AUTOFIX_HOST == "github-actions/pull_request";
    assert AUTOFIX_PATHS == "specs/**/*.t27";
}
