// SPDX-License-Identifier: Apache-2.0
; specs/policy/vf_write_gate.t27 -- vf_guard write gate for agent lanes (Refs gHashTag/t27#13251, epic #13426).
; Lowered by `t27c gen-c` to gen/c/policy/vf_write_gate.c (L2). lefthook.yml and vf-write-gate.yml build a
; one-line C main around check_vf_writes(), fed an optional role line ("agent", "engine", "owner"), a "--"
; separator, then `git diff --name-status`. Default role is agent. Only added or modified .t27 paths are
; judged; deletions are ignored. phi^2 + 1/phi^2 = 3 | TRINITY

module PolicyVfWriteGate;

use policy::own_language::sep_at;
use policy::own_language::put;
use policy::own_language::put_range;
use claw::text::put_str;
use t27f::vf_guard::gd_may_write_bytes;
use t27f::vf_guard::gd_layer_of_bytes;
use t27f::vf_guard::GL_LAYOUT;
use t27f::vf_guard::gd_layer_name;
use t27f::vf_guard::GR_AGENT;
use t27f::vf_guard::GR_ENGINE;
use t27f::vf_guard::GR_OWNER;

pub const ROLE_AGENT : str = "agent";
pub const ROLE_ENGINE : str = "engine";
pub const ROLE_OWNER : str = "owner";

/// True when path bytes end with `.t27`.
fn ends_t27(buf: []const u8, from: usize, to: usize) -> bool {
    if (to < from + 4) { return false; }
    if (buf[to - 4] != '.') { return false; }
    if (buf[to - 3] != 't') { return false; }
    if (buf[to - 2] != '2') { return false; }
    if (buf[to - 1] != '7') { return false; }
    return true;
}

/// True when line buf[from..to] equals the role name exactly.
fn line_is_role(buf: []const u8, from: usize, to: usize, name: str, nlen: usize) -> bool {
    if (to - from != nlen) { return false; }
    var i : usize = 0;
    while (i < nlen) {
        if (buf[from + i] != name[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// Role from header lines before the separator; default agent when none match.
pub fn parse_role(buf: []const u8, n: usize, sp: usize) -> u32 {
    var s : usize = 0;
    var role : u32 = GR_AGENT;
    while (s < sp) {
        var e : usize = s;
        while (e < n and buf[e] != '\n') { e = e + 1; }
        var t : usize = e;
        if (t > s and buf[t - 1] == '\r') { t = t - 1; }
        if (t > s) {
            if (line_is_role(buf, s, t, ROLE_AGENT, 5)) { role = GR_AGENT; }
            if (line_is_role(buf, s, t, ROLE_ENGINE, 6)) { role = GR_ENGINE; }
            if (line_is_role(buf, s, t, ROLE_OWNER, 5)) { role = GR_OWNER; }
        }
        s = e + 1;
    }
    return role;
}

/// True for diff kinds M (modified) and A (added).
fn kind_checked(c: u8) -> bool {
    if (c == 'M') { return true; }
    if (c == 'A') { return true; }
    return false;
}

/// Judge git diff lines after the separator for role `role`; write one denial line per refused .t27 path
/// into out and return the count (caller exits non-zero when not zero).
pub fn check_vf_writes(buf: []const u8, n: usize, out: []u8, cap: usize) -> u32 {
    var denied : u32 = 0;
    var w : usize = 0;
    const sp : usize = sep_at(buf, n);
    const role : u32 = parse_role(buf, n, sp);
    var s : usize = sp;
    while (s < n and buf[s] != '\n') { s = s + 1; }
    if (s < n) { s = s + 1; }
    while (s < n) {
        var e : usize = s;
        while (e < n and buf[e] != '\n') { e = e + 1; }
        var t : usize = e;
        if (t > s and buf[t - 1] == '\r') { t = t - 1; }
        if (t > s) {
            const k : u8 = buf[s];
            if (kind_checked(k)) {
                var p : usize = s;
                var i : usize = s;
                while (i < t) {
                    if (buf[i] == '\t') { p = i + 1; }
                    i = i + 1;
                }
                if (p > s and ends_t27(buf, p, t)) {
                    var f : usize = p;
                    var path_to : usize = t;
                    if (buf[f] == '"') { f = f + 1; }
                    if (path_to > f and buf[path_to - 1] == '"') { path_to = path_to - 1; }
                    if (gd_may_write_bytes(buf, f, path_to, role) == false) {
                        denied = denied + 1;
                        const layer : u32 = gd_layer_of_bytes(buf, f, path_to);
                        w = put_range(out, w, cap, buf, f, path_to);
                        w = put(out, w, cap, ':');
                        w = put(out, w, cap, ' ');
                        let lname : str = gd_layer_name(layer);
                        let llen : usize = 5;
                        if (layer == 0) { llen = 5; }
                        if (layer == 1) { llen = 7; }
                        if (layer == 2) { llen = 6; }
                        if (layer == 3) { llen = 5; }
                        if (layer == 4) { llen = 6; }
                        if (layer == 5) { llen = 5; }
                        if (layer == 6) { llen = 8; }
                        if (layer == 7) { llen = 5; }
                        w = put_str(out, cap, w, lname, llen);
                        w = put(out, w, cap, '\n');
                    }
                }
            }
        }
        s = e + 1;
    }
    return denied;
}

test agent_denied_layout {
    var out : [256]u8 = undefined;
    let inp : str = "agent\n--\nM\tspecs/t27f/vf_layout.t27\n";
    assert check_vf_writes(inp, 36, &out, 256) == 1;
}

test agent_allowed_ui_kit {
    var out : [256]u8 = undefined;
    let inp : str = "--\nM\tspecs/t27f/ui_kit.t27\n";
    assert check_vf_writes(inp, 27, &out, 256) == 0;
}

test agent_allowed_uikit_button {
    var out : [256]u8 = undefined;
    let inp : str = "--\nM\tspecs/uikit/button.t27\n";
    assert check_vf_writes(inp, 28, &out, 256) == 0;
}

test engine_allowed_layout {
    var out : [256]u8 = undefined;
    let inp : str = "engine\n--\nM\tspecs/t27f/vf_layout.t27\n";
    assert check_vf_writes(inp, 37, &out, 256) == 0;
}

test owner_allowed_theme {
    var out : [256]u8 = undefined;
    let inp : str = "owner\n--\nM\tspecs/t27f/vf_theme.t27\n";
    assert check_vf_writes(inp, 35, &out, 256) == 0;
}

test default_role_is_agent {
    var out : [256]u8 = undefined;
    let inp : str = "--\nM\tspecs/t27f/vf_theme.t27\n";
    assert check_vf_writes(inp, 29, &out, 256) == 1;
}

test ignores_deletions {
    var out : [256]u8 = undefined;
    let inp : str = "--\nD\tspecs/t27f/vf_render.t27\n";
    assert check_vf_writes(inp, 30, &out, 256) == 0;
}

test unlisted_path_denied_for_agent {
    var out : [256]u8 = undefined;
    let inp : str = "--\nA\tspecs/t27f/unknown_agent_file.t27\n";
    assert check_vf_writes(inp, 39, &out, 256) == 1;
}