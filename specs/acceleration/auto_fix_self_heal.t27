// SPDX-License-Identifier: Apache-2.0
// specs/acceleration/auto_fix_self_heal.t27 -- auto-fix applies a deterministic fix to a failing check;
// self-heal reverts this tick's own change if any check stays red past the rollback window.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AccelAutoFixSelfHeal;

pub const KIND : str = "accel";
pub const ID : str = "t27/accel/auto-fix-self-heal";
pub const NAME : str = "Auto-fix and self-heal";
pub const SUMMARY_EN : str = "Applies deterministic fixes to failing checks; reverts a tick's change when it red-checks past the window.";
pub const ENABLED : bool = true;

// ---- auto-fix: which check gets which deterministic fix ----
pub const AF_VACUOUS_TEST : u8 = 0;
pub const AF_STALE_SEAL : u8 = 1;
pub const AF_MISSING_L1 : u8 = 2;
pub const AF_COPY_BODY : u8 = 3;
pub const AF_SLOW_CACHE : u8 = 4;
pub const AF_FOREIGN_BUDGET : u8 = 5;
pub const AF_KINDS : u8 = 6;

/// The deterministic fix for a failing check kind; empty string means no auto-fix exists.
pub fn fix_for(kind: u8) -> str {
    if (kind == AF_VACUOUS_TEST) { return "add an assertion that fails on the old code"; }
    if (kind == AF_STALE_SEAL) { return "t27c seal <spec> --save"; }
    if (kind == AF_MISSING_L1) { return "append Closes #N to the commit body"; }
    if (kind == AF_COPY_BODY) { return "replace the copy with a use of the existing function"; }
    if (kind == AF_SLOW_CACHE) { return "bump the cache key to include the new input"; }
    if (kind == AF_FOREIGN_BUDGET) { return "delete more foreign lines than added"; }
    return "";
}

test fix_exists_for_every_known_kind {
    var k : u8 = 0;
    while (k < AF_KINDS) {
        assert fix_for(k).len > 0;
        k = k + 1;
    }
    assert fix_for(99).len == 0;
}

/// Can auto-fix run on this check: a fix exists and the branch is ours?
pub fn autofix_may_run(kind: u8, branch_ours: bool) -> bool {
    return fix_for(kind).len > 0 and branch_ours;
}

test autofix_requires_ours_and_a_fix {
    assert autofix_may_run(AF_STALE_SEAL, true);
    assert autofix_may_run(AF_STALE_SEAL, false) == false;
    assert autofix_may_run(99, true) == false;
}

// ---- self-heal: rollback ----
// A tick's change is rolled back when it red-checks past ROLLBACK_WINDOW ticks.
// The tick number the change landed on, and how many ticks have passed since.
pub fn should_rollback(ticks_since_landed: u64, red_checks_now: u32, window: u64) -> bool {
    if (red_checks_now == 0) { return false; }
    return ticks_since_landed >= window;
}

test rollback_when_red_past_window {
    assert should_rollback(0, 1, 3) == false;
    assert should_rollback(2, 1, 3) == false;
    assert should_rollback(3, 1, 3);
    assert should_rollback(3, 0, 3) == false;
}

/// The self-heal verdict: keep, roll back, or still watching.
pub const SH_KEEP : u8 = 0;
pub const SH_ROLLBACK : u8 = 1;
pub const SH_WATCHING : u8 = 2;

pub fn self_heal_verdict(ticks_since_landed: u64, red_checks_now: u32, window: u64) -> u8 {
    if (should_rollback(ticks_since_landed, red_checks_now, window)) { return SH_ROLLBACK; }
    if (red_checks_now > 0) { return SH_WATCHING; }
    return SH_KEEP;
}

test verdicts_distinguish_keep_watch_rollback {
    assert self_heal_verdict(0, 0, 3) == SH_KEEP;
    assert self_heal_verdict(1, 2, 3) == SH_WATCHING;
    assert self_heal_verdict(3, 2, 3) == SH_ROLLBACK;
    assert self_heal_verdict(10, 0, 3) == SH_KEEP;
}

invariant auto_fix_kinds_numbered {
    assert AF_KINDS == 6;
    assert SH_KEEP == 0 and SH_ROLLBACK == 1 and SH_WATCHING == 2;
}
