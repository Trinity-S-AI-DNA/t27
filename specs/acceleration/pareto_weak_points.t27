// SPDX-License-Identifier: Apache-2.0
// specs/acceleration/pareto_weak_points.t27 -- Pareto-ranked weak points of the t27 improvement loop.
// A weak point is any anomaly the audit step finds: a red PR, a stale lane, a drifted seal, a
// vacuous test, a copied body, a missing `Closes #N`, a cache miss that is slow, a foreign edit
// that grows the budget. Ranked by impact x frequency; the top one is fixed this tick.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AccelParetoWeakPoints;

pub const KIND : str = "accel";
pub const ID : str = "t27/accel/pareto-weak-points";
pub const NAME : str = "Pareto weak-point ranking";
pub const SUMMARY_EN : str = "Ranks every anomaly the audit step finds by impact x frequency; the top one is this tick's fix target.";
pub const ENABLED : bool = true;

// ---- anomaly kinds ----
pub const AK_RED_PR : u8 = 0;
pub const AK_STALE_LANE : u8 = 1;
pub const AK_DRIFTED_SEAL : u8 = 2;
pub const AK_VACUOUS_TEST : u8 = 3;
pub const AK_COPIED_BODY : u8 = 4;
pub const AK_MISSING_L1 : u8 = 5;
pub const AK_SLOW_CACHE : u8 = 6;
pub const AK_FOREIGN_EDIT : u8 = 7;
pub const AK_COVERAGE_GAP : u8 = 8;
pub const ANOMALY_KINDS : u8 = 9;

// ---- severity of each kind (impact 0..100) ----
pub fn kind_impact(k: u8) -> u32 {
    if (k == AK_RED_PR) { return 95; }
    if (k == AK_STALE_LANE) { return 70; }
    if (k == AK_DRIFTED_SEAL) { return 85; }
    if (k == AK_VACUOUS_TEST) { return 60; }
    if (k == AK_COPIED_BODY) { return 50; }
    if (k == AK_MISSING_L1) { return 75; }
    if (k == AK_SLOW_CACHE) { return 40; }
    if (k == AK_FOREIGN_EDIT) { return 80; }
    if (k == AK_COVERAGE_GAP) { return 90; }
    return 0;
}

test impacts_are_in_range {
    var k : u8 = 0;
    while (k < ANOMALY_KINDS) {
        assert kind_impact(k) <= 100;
        k = k + 1;
    }
    assert kind_impact(AK_RED_PR) == 95;
    assert kind_impact(AK_COVERAGE_GAP) == 90;
}

// ---- one ranked anomaly ----
pub struct Anomaly {
    kind: u8,
    impact: u32,
    frequency: u32,
    spec: str,
    first_seen: u64,
}

/// The Pareto score: impact x frequency, capped at 10000.
pub fn score(a: Anomaly) -> u32 {
    const s : u32 = a.impact * a.frequency;
    if (s > 10000) { return 10000; }
    return s;
}

test score_is_capped {
    assert score(Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 1, .spec = "", .first_seen = 0}) == 95;
    assert score(Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 200, .spec = "", .first_seen = 0}) == 10000;
    assert score(Anomaly{.kind = AK_SLOW_CACHE, .impact = 40, .frequency = 1, .spec = "", .first_seen = 0}) == 40;
}

/// Does anomaly a outrank anomaly b? Higher score wins; ties broken by impact, then kind.
pub fn outranks(a: Anomaly, b: Anomaly) -> bool {
    const sa : u32 = score(a);
    const sb : u32 = score(b);
    if (sa != sb) { return sa > sb; }
    if (a.impact != b.impact) { return a.impact > b.impact; }
    return a.kind < b.kind;
}

test outranking_prefers_higher_score_then_impact {
    assert outranks(Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 1, .spec = "", .first_seen = 0},
                    Anomaly{.kind = AK_SLOW_CACHE, .impact = 40, .frequency = 1, .spec = "", .first_seen = 0});
    assert outranks(Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 2, .spec = "", .first_seen = 0},
                    Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 1, .spec = "", .first_seen = 0});
    // tie score: higher impact wins
    assert outranks(Anomaly{.kind = AK_RED_PR, .impact = 90, .frequency = 2, .spec = "", .first_seen = 0},
                    Anomaly{.kind = AK_SLOW_CACHE, .impact = 40, .frequency = 4, .spec = "", .first_seen = 0});
}

/// Is this anomaly Pareto-eligible: impact at least the floor or frequency at least the floor?
pub fn pareto_eligible(a: Anomaly, impact_floor: u32, freq_floor: u32) -> bool {
    return a.impact >= impact_floor or a.frequency >= freq_floor;
}

test eligibility_uses_both_floors {
    const a : Anomaly = Anomaly{.kind = AK_STALE_LANE, .impact = 70, .frequency = 1, .spec = "", .first_seen = 0};
    assert pareto_eligible(a, 70, 2);
    assert pareto_eligible(a, 80, 1);
    assert pareto_eligible(a, 80, 2) == false;
}

/// The top anomaly from a list: the highest-scoring eligible one, or none when the list is empty.
pub fn top_anomaly(list: []Anomaly, impact_floor: u32, freq_floor: u32) -> u32 {
    var best : u32 = list.len;
    var best_score : u32 = 0;
    var i : u32 = 0;
    while (i < list.len) {
        if (pareto_eligible(list[i], impact_floor, freq_floor)) {
            const s : u32 = score(list[i]);
            if (best == list.len or s > best_score) {
                best = i;
                best_score = s;
            }
        }
        i = i + 1;
    }
    return best;
}

test top_picks_highest_eligible_score {
    const l : [3]Anomaly = [
        Anomaly{.kind = AK_SLOW_CACHE, .impact = 40, .frequency = 1, .spec = "a", .first_seen = 0},
        Anomaly{.kind = AK_RED_PR, .impact = 95, .frequency = 1, .spec = "b", .first_seen = 0},
        Anomaly{.kind = AK_COPIED_BODY, .impact = 50, .frequency = 1, .spec = "c", .first_seen = 0},
    ];
    assert top_anomaly(l[0 .. 3], 80, 2) == 1;
    // nothing eligible
    const l2 : [1]Anomaly = [ Anomaly{.kind = AK_SLOW_CACHE, .impact = 10, .frequency = 1, .spec = "a", .first_seen = 0} ];
    assert top_anomaly(l2[0 .. 1], 80, 2) == 1;
}

invariant kinds_and_impacts_match {
    assert ANOMALY_KINDS == 9;
    assert kind_impact(AK_RED_PR) == 95;
}
