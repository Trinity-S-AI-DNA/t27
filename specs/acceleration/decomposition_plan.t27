// SPDX-License-Identifier: Apache-2.0
// specs/acceleration/decomposition_plan.t27 -- decomposes the top weak point into atomic, closable
// units with `Closes #N` traceability. Each unit is one .t27 spec change with test/invariant/bench.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AccelDecompositionPlan;

pub const KIND : str = "accel";
pub const ID : str = "t27/accel/decomposition-plan";
pub const NAME : str = "Decomposition plan";
pub const SUMMARY_EN : str = "Splits the top Pareto weak point into atomic units, each a .t27 change with test coverage and an L1 reference.";
pub const ENABLED : bool = true;

// ---- one unit of work ----
pub struct Unit {
    id: u32,
    title: str,
    spec_path: str,
    closes_issue: u32,   // 0 when not yet filed
    test_lines: u32,
    invariant_lines: u32,
    bench_lines: u32,
    done: bool,
}

/// Is this unit complete: has a spec path, at least one test line, and is marked done?
pub fn unit_complete(u: Unit) -> bool {
    return u.spec_path.len > 0 and u.test_lines > 0 and u.done;
}

test unit_complete_needs_spec_test_done {
    assert unit_complete(Unit{.id = 1, .title = "x", .spec_path = "specs/a.t27", .closes_issue = 5, .test_lines = 3, .invariant_lines = 0, .bench_lines = 0, .done = true});
    assert unit_complete(Unit{.id = 2, .title = "x", .spec_path = "", .closes_issue = 5, .test_lines = 3, .invariant_lines = 0, .bench_lines = 0, .done = true}) == false;
    assert unit_complete(Unit{.id = 3, .title = "x", .spec_path = "specs/a.t27", .closes_issue = 5, .test_lines = 0, .invariant_lines = 0, .bench_lines = 0, .done = true}) == false;
    assert unit_complete(Unit{.id = 4, .title = "x", .spec_path = "specs/a.t27", .closes_issue = 5, .test_lines = 3, .invariant_lines = 0, .bench_lines = 0, .done = false}) == false;
}

/// The coverage of a plan: fraction of units complete, in per-mille.
pub fn plan_coverage(units: []Unit) -> u32 {
    if (units.len == 0) { return 1000; }
    var done : u32 = 0;
    var i : u32 = 0;
    while (i < units.len) {
        if (unit_complete(units[i])) { done = done + 1; }
        i = i + 1;
    }
    return (done * 1000) / units.len;
}

test coverage_is_per_mille {
    const u : [3]Unit = [
        { id: 1, title: "a", spec_path: "s.t27", closes_issue: 1, test_lines: 1, invariant_lines: 0, bench_lines: 0, done: true },
        { id: 2, title: "b", spec_path: "s.t27", closes_issue: 2, test_lines: 1, invariant_lines: 0, bench_lines: 0, done: false },
        { id: 3, title: "c", spec_path: "s.t27", closes_issue: 3, test_lines: 0, invariant_lines: 0, bench_lines: 0, done: false },
    ];
    assert plan_coverage(u[0 .. 3]) == 333;
    assert plan_coverage(u[0 .. 0]) == 1000;
}

/// The next unfinished unit to take: the lowest id that is not done.
pub fn next_unit(units: []Unit) -> u32 {
    var i : u32 = 0;
    while (i < units.len) {
        if (units[i].done == false) { return i; }
        i = i + 1;
    }
    return units.len;
}

test next_unit_skips_done {
    const u : [3]Unit = [
        Unit{.id = 1, .title = "a", .spec_path = "s.t27", .closes_issue = 1, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
        Unit{.id = 2, .title = "b", .spec_path = "s.t27", .closes_issue = 2, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = false},
        Unit{.id = 3, .title = "c", .spec_path = "s.t27", .closes_issue = 3, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
    ];
    assert next_unit(u[0 .. 3]) == 1;
    const all : [2]Unit = [
        Unit{.id = 1, .title = "a", .spec_path = "s.t27", .closes_issue = 1, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
        Unit{.id = 2, .title = "b", .spec_path = "s.t27", .closes_issue = 2, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
    ];
    assert next_unit(all[0 .. 2]) == 2;
}

/// Does a plan reach 100% coverage: every unit complete?
pub fn plan_at_hundred(units: []Unit) -> bool {
    var i : u32 = 0;
    while (i < units.len) {
        if (unit_complete(units[i]) == false) { return false; }
        i = i + 1;
    }
    return units.len > 0;
}

test hundred_means_every_unit_complete {
    const u : [2]Unit = [
        Unit{.id = 1, .title = "a", .spec_path = "s.t27", .closes_issue = 1, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
        Unit{.id = 2, .title = "b", .spec_path = "s.t27", .closes_issue = 2, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
    ];
    assert plan_at_hundred(u[0 .. 2]);
    const u2 : [2]Unit = [
        Unit{.id = 1, .title = "a", .spec_path = "s.t27", .closes_issue = 1, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
        Unit{.id = 2, .title = "b", .spec_path = "", .closes_issue = 2, .test_lines = 1, .invariant_lines = 0, .bench_lines = 0, .done = true},
    ];
    assert plan_at_hundred(u2[0 .. 2]) == false;
    assert plan_at_hundred([ ][0 .. 0]) == false;
}

invariant plan_has_units_and_lines {
    assert plan_coverage([ ][0 .. 0]) == 1000;
}
