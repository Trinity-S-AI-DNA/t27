// SPDX-License-Identifier: Apache-2.0
// specs/acceleration/coverage_hundred.t27 -- what "coverage to 100%" means and how the loop
// measures it: every spec has test/invariant/bench, every change has L1 traceability, every
// weak point has a unit. More effective than raw line coverage because a vacuous test reads as 0.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AccelCoverageHundred;

pub const KIND : str = "accel";
pub const ID : str = "t27/accel/coverage-hundred";
pub const NAME : str = "Coverage to 100%";
pub const SUMMARY_EN : str = "Defines 100% effective coverage: every spec tested, every change traced, no vacuous tests.";
pub const ENABLED : bool = true;

// ---- coverage kinds ----
pub const CV_SPEC_TESTED : u8 = 0;
pub const CV_SPEC_INVARIANT : u8 = 1;
pub const CV_SPEC_BENCH : u8 = 2;
pub const CV_CHANGE_L1 : u8 = 3;
pub const CV_NO_VACUOUS : u8 = 4;
pub const CV_WEAK_POINT_UNIT : u8 = 5;
pub const CV_KINDS : u8 = 6;

// ---- one spec's coverage record ----
pub struct SpecCover {
    path: str,
    has_test: bool,
    has_invariant: bool,
    has_bench: bool,
    vacuous: bool,
}

// ---- is this spec fully covered: test + invariant/bench + not vacuous ----
pub fn spec_fully_covered(s: SpecCover) -> bool {
    return s.has_test and (s.has_invariant or s.has_bench) and s.vacuous == false;
}

test fully_covered_needs_test_and_not_vacuous {
    assert spec_fully_covered(SpecCover{.path = "a.t27", .has_test = true, .has_invariant = true, .has_bench = false, .vacuous = false});
    assert spec_fully_covered(SpecCover{.path = "a.t27", .has_test = true, .has_invariant = false, .has_bench = true, .vacuous = false});
    assert spec_fully_covered(SpecCover{.path = "a.t27", .has_test = true, .has_invariant = false, .has_bench = false, .vacuous = false}) == false;
    assert spec_fully_covered(SpecCover{.path = "a.t27", .has_test = true, .has_invariant = true, .has_bench = true, .vacuous = true}) == false;
    assert spec_fully_covered(SpecCover{.path = "a.t27", .has_test = false, .has_invariant = true, .has_bench = true, .vacuous = false}) == false;
}

/// The corpus coverage: fraction of specs fully covered, per-mille.
pub fn corpus_coverage(specs: []SpecCover) -> u32 {
    if (specs.len == 0) { return 0; }
    var full : u32 = 0;
    var i : u32 = 0;
    while (i < specs.len) {
        if (spec_fully_covered(specs[i])) { full = full + 1; }
        i = i + 1;
    }
    return (full * 1000) / specs.len;
}

test corpus_coverage_per_mille {
    const s : [3]SpecCover = [
        SpecCover{.path = "a.t27", .has_test = true, .has_invariant = true, .has_bench = false, .vacuous = false},
        SpecCover{.path = "b.t27", .has_test = true, .has_invariant = false, .has_bench = true, .vacuous = false},
        SpecCover{.path = "c.t27", .has_test = true, .has_invariant = false, .has_bench = false, .vacuous = false},
    ];
    assert corpus_coverage(s[0 .. 3]) == 666;
}

/// Is a change traceable: its body carries an L1 reference to a local issue?
pub fn change_traceable(body: str) -> bool {
    return body.len > 0 and has_l1_ref(body);
}

/// Does text carry an L1 verb followed by #<digits> (local, not cross-repo)?
pub fn has_l1_ref(text: str) -> bool {
    var i : u32 = 0;
    while (i + 1 < text.len) {
        if (text[i] == 35) { // '#'
            var j : u32 = i;
            while (j > 0 and (text[j-1] == 32 or text[j-1] == 9 or text[j-1] == 10)) { j = j - 1; }
            if (verb_before(text, j)) {
                var k : u32 = i + 1;
                while (k < text.len and text[k] >= 48 and text[k] <= 57) { k = k + 1; }
                if (k > i + 1) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn verb_before(text: str, at: u32) -> bool {
    const verbs : [5]str = ["Closes", "Fixes", "Resolves", "Refs", "Updates"];
    var v : u32 = 0;
    while (v < 5) {
        const lit : str = verbs[v];
        if (at >= lit.len) {
            var m : u32 = 0;
            var ok : bool = true;
            while (m < lit.len) {
                if (text[at - lit.len + m] != lit[m]) { ok = false; }
                m = m + 1;
            }
            if (ok) { return true; }
        }
        v = v + 1;
    }
    return false;
}

test l1_ref_reads_local_verbs {
    assert has_l1_ref("spec(x): fix it (Closes #5)");
    assert has_l1_ref("Refs #12835");
    assert has_l1_ref("Fixes #5\n");
    assert has_l1_ref("see #5") == false;      // no verb
    assert has_l1_ref("Refs gHashTag/t27#5") == false; // cross-repo, not local
    assert has_l1_ref("") == false;
}

/// Is the whole corpus at 100% effective coverage?
pub fn at_hundred_percent(specs: []SpecCover, changes: []str) -> bool {
    if (specs.len == 0) { return false; }
    var i : u32 = 0;
    while (i < specs.len) {
        if (spec_fully_covered(specs[i]) == false) { return false; }
        i = i + 1;
    }
    i = 0;
    while (i < changes.len) {
        if (change_traceable(changes[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

test hundred_percent_needs_everything {
    const s : [1]SpecCover = [ SpecCover{.path = "a.t27", .has_test = true, .has_invariant = true, .has_bench = true, .vacuous = false} ];
    assert at_hundred_percent(s[0 .. 1], [ "Closes #5" ]);
    assert at_hundred_percent(s[0 .. 1], [ "no ref" ]) == false;
    const s2 : [1]SpecCover = [ SpecCover{.path = "a.t27", .has_test = true, .has_invariant = true, .has_bench = true, .vacuous = true} ];
    assert at_hundred_percent(s2[0 .. 1], [ "Closes #5" ]) == false;
}

invariant coverage_kinds_numbered {
    assert CV_KINDS == 6;
}
