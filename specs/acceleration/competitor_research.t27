// SPDX-License-Identifier: Apache-2.0
// specs/acceleration/competitor_research.t27 -- competitor research for the Pareto improvement loop.
// Each tick researches competitors on the topic of the top weak point: who ships what, their
// numbers, their gaps, and where t27 is ahead or behind. Results feed the plan step.
// phi^2 + 1/phi^2 = 3 | TRINITY

module AccelCompetitorResearch;

pub const KIND : str = "accel";
pub const ID : str = "t27/accel/competitor-research";
pub const NAME : str = "Competitor research";
pub const SUMMARY_EN : str = "Researches competitors on the topic of the top weak point: their numbers, gaps, and where t27 leads.";
pub const ENABLED : bool = true;

// ---- competitor record ----
pub struct Competitor {
    name: str,
    topic: str,
    pass_at_k: u32,      // Pass@K on the shared benchmark domain, 0..1000 (per-mille)
    latency_ms: u32,     // p50 latency in ms
    cost_usd: u32,       // cost per 1000 runs in cents
    open: bool,          // open source / open weights
    t27_ahead: bool,     // t27 beats them on this topic
}

// ---- is t27 ahead on this topic: better pass@k, or equal pass@k and lower cost ----
pub fn t27_leads(them: Competitor, our_pass: u32, our_cost: u32) -> bool {
    if (our_pass > them.pass_at_k) { return true; }
    if (our_pass == them.pass_at_k and our_cost < them.cost_usd) { return true; }
    return false;
}

test t27_leads_on_better_pass_or_lower_cost {
    assert t27_leads(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 600, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false},
                     700, 120);
    assert t27_leads(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 600, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false},
                     600, 90);
    assert t27_leads(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 600, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false},
                     600, 100) == false;
    assert t27_leads(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 600, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false},
                     590, 10) == false;
}

/// The research verdict for a topic: LEAD, PARITY, or BEHIND.
pub const V_LEAD : u8 = 0;
pub const V_PARITY : u8 = 1;
pub const V_BEHIND : u8 = 2;

pub fn research_verdict(them: []Competitor, our_pass: u32, our_cost: u32) -> u8 {
    var ahead : u32 = 0;
    var behind : u32 = 0;
    var i : u32 = 0;
    while (i < them.len) {
        const c : Competitor = them[i];
        if (t27_leads(c, our_pass, our_cost)) { ahead = ahead + 1; }
        else if (c.pass_at_k == our_pass and c.cost_usd == our_cost) { /* parity, neither */ }
        else { behind = behind + 1; }
        i = i + 1;
    }
    if (behind > ahead) { return V_BEHIND; }
    if (ahead > 0 and behind == 0) { return V_LEAD; }
    return V_PARITY;
}

test verdict_counts_leads_and_behinds {
    const c : [2]Competitor = [
        Competitor{.name = "a", .topic = "rtl", .pass_at_k = 500, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false},
        Competitor{.name = "b", .topic = "rtl", .pass_at_k = 700, .latency_ms = 40, .cost_usd = 90, .open = true, .t27_ahead = false},
    ];
    assert research_verdict(c[0 .. 2], 600, 95) == V_PARITY;
    assert research_verdict(c[0 .. 2], 800, 95) == V_LEAD;
    assert research_verdict(c[0 .. 2], 400, 200) == V_BEHIND;
}

/// Does this competitor matter for the topic: pass@k within 30% of t27's?
pub fn competitor_matters(c: Competitor, our_pass: u32) -> bool {
    if (our_pass == 0) { return c.pass_at_k > 0; }
    const floor : u32 = (our_pass * 70) / 100;
    return c.pass_at_k >= floor;
}

test matters_uses_30_percent_floor {
    assert competitor_matters(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 700, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false}, 1000);
    assert competitor_matters(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 699, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false}, 1000) == false;
    assert competitor_matters(Competitor{.name = "x", .topic = "rtl", .pass_at_k = 5, .latency_ms = 50, .cost_usd = 100, .open = true, .t27_ahead = false}, 0);
}

invariant verdicts_are_numbered {
    assert V_LEAD == 0 and V_PARITY == 1 and V_BEHIND == 2;
}
