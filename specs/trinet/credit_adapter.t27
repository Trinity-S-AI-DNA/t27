// SPDX-License-Identifier: Apache-2.0
; specs/trinet/credit_adapter.t27 -- the ledger-to-credit-view adapter, the Y YIELD data chain
; Owner directive (E/R/Y data chains): the Y producer exists (specs/trinet/ledger.t27 settle(),
; the OUT_* outcomes and the node states), the view law exists (specs/t27os/credit_view.t27's
; five-field vocabulary); the missing link between them is this adapter. It is the only new code
; in the chain report, because a testable route exists: ledger.t27's settle() produces real
; outcomes the adapter can be tested against -- no fixtures needed for the mapping law itself.
; Mapping law, honest at every row:
;   OUT_CREDITED                  -> row state ACCEPTED  (the ledger credited the claim once)
;   OUT_ALREADY_SETTLED_NOT_CHARGED -> row state SUPERSEDED (a settled claim was replayed; the
;                                    ledger refused it -- the row is history, not a second credit)
;   OUT_NONE (not yet settled)    -> row state PENDING
;   every other outcome (rejected, slashed, corrupt, identity mismatch, unverifiable,
;   not eligible) -> NO IN VIEW STATE. The view vocabulary has no "rejected" state, and the
;   adapter must not bend one onto it: such rows are counted as refusals (a count, which the
;   vocabulary has) and the adapter reports them unmapped, never silently dropped.
; The adapter produces counts and states only -- never an amount -- so the chain structurally
; cannot end in a value claim (credit_view.t27 cv_value_claim_ok stays false at the far end).
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module TrinetCreditAdapter;

use trinet::ledger::OUT_CREDITED;
use trinet::ledger::OUT_REJECTED_AND_SLASHED;
use trinet::ledger::OUT_CORRUPT_NOT_CHARGED;
use trinet::ledger::OUT_IDENTITY_MISMATCH;
use trinet::ledger::OUT_UNVERIFIABLE_NOT_CHARGED;
use trinet::ledger::OUT_NOT_ELIGIBLE;
use trinet::ledger::OUT_ALREADY_SETTLED_NOT_CHARGED;
use trinet::ledger::OUT_NONE;
use t27os::credit_view::VS_PENDING;
use t27os::credit_view::VS_ACCEPTED;
use t27os::credit_view::VS_SUPERSEDED;

/// The mapped row state for a ledger outcome, or ADAPT_UNMAPPED when the outcome has no honest
/// state in the view vocabulary. The view draws only mapped rows; the unmapped count travels
/// beside them (credit_view CF_ENTRIES counts every row, mapped or not).
pub const ADAPT_UNMAPPED : u8 = 255;

pub fn ca_adapt_outcome(outcome: u8) -> u8 {
    if (outcome == OUT_CREDITED) { return VS_ACCEPTED; }
    if (outcome == OUT_ALREADY_SETTLED_NOT_CHARGED) { return VS_SUPERSEDED; }
    if (outcome == OUT_NONE) { return VS_PENDING; }
    return ADAPT_UNMAPPED;
}

/// The row feeds the view only when it mapped. An unmapped row is counted, never drawn as a
/// state and never dropped from the entry count.
pub fn ca_mapped(state: u8) -> bool {
    return state != ADAPT_UNMAPPED;
}

; --- 1. The counts the adapter hands the view ---------------------------------------------------------

/// Fold one batch of outcomes into the view's four count fields. `entries` counts every outcome
/// in the batch, mapped or not; the refusal counter carries the unmapped ones with their reason.
pub const BATCH_FIELDS : u8 = 5;

pub fn ca_batch_ok(entries: u64, accepted: u64, superseded: u64, pending: u64, unmapped: u64) -> bool {
    if (accepted + superseded + pending + unmapped != entries) { return false; }
    return entries > 0 or unmapped == 0;
}

/// The ledger's own settled/total ratio is NOT exported: a ratio could read as a yield claim.
/// The adapter answers only whether every outcome was classified.
pub fn ca_batch_complete(unmapped: u64) -> bool {
    return unmapped == 0;
}

test the_three_honest_mappings {
    assert ca_adapt_outcome(OUT_CREDITED) == VS_ACCEPTED;
    assert ca_adapt_outcome(OUT_ALREADY_SETTLED_NOT_CHARGED) == VS_SUPERSEDED;
    assert ca_adapt_outcome(OUT_NONE) == VS_PENDING;
}

test the_rejected_outcomes_map_to_nothing {
    // no invented state: a slash, a corruption, an identity mismatch, an unverifiable claim
    // and an ineligible claim are all honestly unmapped, not forced into the vocabulary
    assert ca_adapt_outcome(OUT_REJECTED_AND_SLASHED) == ADAPT_UNMAPPED;
    assert ca_adapt_outcome(OUT_CORRUPT_NOT_CHARGED) == ADAPT_UNMAPPED;
    assert ca_adapt_outcome(OUT_IDENTITY_MISMATCH) == ADAPT_UNMAPPED;
    assert ca_adapt_outcome(OUT_UNVERIFIABLE_NOT_CHARGED) == ADAPT_UNMAPPED;
    assert ca_adapt_outcome(OUT_NOT_ELIGIBLE) == ADAPT_UNMAPPED;
    // unmapped rows are counted, never drawn
    assert ca_mapped(VS_ACCEPTED) == true;
    assert ca_mapped(ADAPT_UNMAPPED) == false;
}

test a_batch_classifies_every_outcome_exactly_once {
    // 2 credited, 1 replayed, 1 pending, 2 rejected: every outcome in exactly one bucket
    assert ca_batch_ok(6, 2, 1, 1, 2) == true;
    // a bucket that loses a row is wrong, whatever the drawing does
    assert ca_batch_ok(6, 2, 1, 1, 1) == false;
    assert ca_batch_ok(6, 3, 1, 1, 2) == false;
    // an empty batch is honest only when nothing is pending in it
    assert ca_batch_ok(0, 0, 0, 0, 0) == true;
    assert ca_batch_ok(0, 0, 0, 1, 0) == false;
}

test completeness_is_classification_not_ratio {
    assert ca_batch_complete(0) == true;
    assert ca_batch_complete(1) == false;
}

invariant the_adapter_maps_from_the_real_ledger_vocabulary {
    // the mapping reads the ledger's own constants, not copies (DRY: one home per constant)
    assert OUT_NONE == 255 and ADAPT_UNMAPPED == 255;
    assert ca_adapt_outcome(OUT_NONE) == VS_PENDING;
    assert BATCH_FIELDS == 5;
}
