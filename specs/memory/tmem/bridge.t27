// AAPCS64 calling convention conformance test functions
// These functions are compiled by t27b and tested for AAPCS64 compliance

// Integer argument tests
// Arguments: a(u32) in x0, b(i64) in x1, c(u8) in x2
// Return: u32 in x0
fn test_integer_args(a: u32, b: i64, c: u8) -> u32 {
    // Return the first argument to verify it was passed correctly
    a
}

// Integer return test
// Return: u64 in x0 (magic value)
fn test_integer_return_only() -> u64 {
    0x123456789ABCDEF0u64
}

// i128 argument test
// Argument: val(i128) in x0-x1 pair
// Return: i128 in x0-x1 pair
fn test_i128_arg(val: i128) -> i128 {
    // Return the same value to verify it was passed correctly
    val
}

// i128 pair arguments test
// Arguments: a(i128) in x0-x1, b(i128) in x2-x3
// Return: i128 in x0-x1 (sum of arguments)
fn test_i128_pair(a: i128, b: i128) -> i128 {
    // Simple addition (simulating the behavior)
    a + b
}

// Float argument tests
// Arguments: f(f32) in s0(v0), d(f64) in d0(v0-v1)
// Return: f32 in s0(v0)
fn test_float_args(f: f32, d: f64) -> f32 {
    // Return the first float argument to verify it was passed correctly
    f
}

// Struct argument test
// Argument: s(*const TestStruct) in x8
// Return: u32 in x0
#[repr(C)]
struct TestStruct {
    a: u32,
    b: i64,
    c: f32,
}

fn test_struct_arg(s: *const TestStruct) -> u32 {
    // Return the first field of the struct
    unsafe { (*s).a }
}

// Callee-saved preservation test
// Return: u64 in x0 (magic value)
fn test_callee_saved() -> u64 {
    // Return a magic value indicating callee-saved registers were preserved
    0xCAFEBABEDEADBEEFu64
}

// Test driver function
fn main() {
    // Test integer arguments
    let int_result = test_integer_args(42u32, -100i64, 255u8);
    assert(int_result == 42u32);
    
    // Test integer return
    let int_return_result = test_integer_return_only();
    assert(int_return_result == 0x123456789ABCDEF0u64);
    
    // Test i128 argument
    let i128_val = 0x123456789ABCDEF0123456789ABCDEF0i128;
    let i128_result = test_i128_arg(i128_val);
    assert(i128_result == i128_val);
    
    // Test i128 pair arguments
    let i128_a = 0x11111111111111111111111111111111i128;
    let i128_b = 0x22222222222222222222222222222222i128;
    let i128_pair_result = test_i128_pair(i128_a, i128_b);
    assert(i128_pair_result == (i128_a + i128_b));
    
    // Test float arguments
    let float_f = 3.14f32;
    let float_d = 2.718281828459045f64;
    let float_result = test_float_args(float_f, float_d);
    assert(float_result == float_f);
    
    // Test struct argument
    let test_struct = TestStruct {
        a: 100u32,
        b: -200i64,
        c: 3.14f32,
    };
    let struct_result = test_struct_arg(&test_struct);
    assert(struct_result == 100u32);
    
    // Test callee-saved preservation
    let callee_result = test_callee_saved();
    assert(callee_result == 0xCAFEBABEDEADBEEFu64);
    
    // All tests passed - return success indicator
    // In a real implementation, this would signal success to the Rust host
}