; specs/memory/graph/ingest.t27 -- how an episode becomes entities and facts, and every way that can refuse
; Epic #7828, slice 4. Slices 1-3 already landed: types.t27, temporal.t27, scope.t27, crypt.t27

module MemoryGraphIngest

import MemoryGraphTypes;
import MemoryGraphScope;
import MemoryGraphTemporal;
import MemoryGraphCrypt;

pub const STATE_RECEIVED : u8 = 1
pub const STATE_ADMITTED : u8 = 2
pub const STATE_EXTRACTING : u8 = 3
pub const STATE_COMMITTED : u8 = 4
pub const STATE_REJECTED : u8 = 5

pub const EVENT_ADMIT : u8 = 1
pub const EVENT_EMIT : u8 = 2
pub const EVENT_RESULT : u8 = 3
pub const EVENT_FAIL : u8 = 4
pub const EVENT_ABORT : u8 = 5

pub const REASON_NONE : u8 = 0
pub const REASON_SCOPE : u8 = 1
pub const REASON_TEMPORAL : u8 = 2
pub const REASON_FORMAT : u8 = 3
pub const REASON_EFFECT : u8 = 4
pub const REASON_STATE : u8 = 5

pub const DOMAIN_UNKNOWN : u8 = 0
pub const DOMAIN_PRIVATE : u8 = 8
pub const DOMAIN_PUBLIC : u8 = 2

pub const CONSENT_MISSING : u8 = 0
pub const CONSENT_GRANTED : u8 = 1
pub const CONSENT_DENIED : u8 = 2

pub const VERDICT_ALLOWED : u8 = 1
pub const VERDICT_DENIED : u8 = 8

pub const OUTCOME_SETTLED : u8 = 1
pub const OUTCOME_STATE : u8 = 2

; Transition result structure
pub struct TransitionResult {
    next_state: u8,
    emitted: bool,
    committed: bool,
    reason: u8,
    outcome: u8
}

; Episode structure
pub struct Episode {
    id: u64,
    group_id: u64,
    principal: u64,
    owner: u64,
    thread: u64,
    valid_at: u64,
    created_at: u64,
    content_hash: u64,
    plaintext_consent: u8,
    trust_domain: u8,
    attempts: u8,
    state: u8,
    reason: u8
}

; Main transition function
fn transition(episode: Episode, event: u8, data: u64) -> TransitionResult {
    var result = TransitionResult {
        next_state: episode.state,
        emitted: false,
        committed: false,
        reason: REASON_NONE,
        outcome: OUTCOME_STATE
    }
    
    if episode.state == STATE_RECEIVED {
        if event == EVENT_ADMIT {
            var may_write = scope::may_write(episode.trust_domain, episode.owner, episode.principal, episode.thread, episode.group_id)
            var known_as_of = temporal::known_as_of(episode.created_at, episode.valid_at, episode.valid_at)
            var raw_expired = scope::raw_expired(episode.created_at, 0, episode.valid_at)
            var endpoints_ok = types::fact_endpoints_ok(episode.group_id, episode.owner, episode.owner, episode.thread, episode.group_id)
            var well_formed = types::fact_well_formed(episode.valid_at, episode.valid_at, episode.created_at, episode.valid_at)
            
            result.next_state = STATE_ADMITTED
            result.emitted = true
            result.outcome = OUTCOME_SETTLED
        } else if event == EVENT_ABORT {
            result.next_state = STATE_REJECTED
            result.reason = REASON_STATE
            result.outcome = OUTCOME_SETTLED
        }
    } else if episode.state == STATE_ADMITTED {
        if event == EVENT_EMIT {
            result.next_state = STATE_EXTRACTING
            result.emitted = true
        } else if event == EVENT_RESULT {
            result.next_state = STATE_COMMITTED
            result.committed = true
            result.outcome = OUTCOME_SETTLED
        }
    } else if episode.state == STATE_EXTRACTING {
        if event == EVENT_RESULT {
            result.next_state = STATE_COMMITTED
            result.committed = true
            result.outcome = OUTCOME_SETTLED
        }
    } else if episode.state == STATE_COMMITTED || episode.state == STATE_REJECTED {
        result.reason = REASON_STATE
    }
    
    return result
}

test "basic_structures" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    assert episode.id == 1
    assert episode.state == STATE_RECEIVED
    assert episode.reason == REASON_NONE
}

test "state_event_coverage" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_ADMIT, 0)
    assert result.next_state == STATE_ADMITTED
    assert result.emitted == true
    assert result.committed == false
    assert result.outcome == OUTCOME_SETTLED
    
    result = transition(episode, EVENT_ABORT, 0)
    assert result.next_state == STATE_REJECTED
    assert result.emitted == false
    assert result.committed == false
    assert result.outcome == OUTCOME_SETTLED
}

test "invalid_codes_fail_closed" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, 99, 0)
    assert result.next_state == STATE_RECEIVED
    assert result.emitted == false
    assert result.committed == false
    assert result.reason == REASON_STATE
}

test "end_to_end_commit_path" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_ADMIT, 0)
    assert result.next_state == STATE_ADMITTED
    
    episode.state = STATE_ADMITTED
    result = transition(episode, EVENT_EMIT, 0)
    assert result.next_state == STATE_EXTRACTING
    
    episode.state = STATE_EXTRACTING
    result = transition(episode, EVENT_RESULT, 0)
    assert result.next_state == STATE_COMMITTED
    assert result.committed == true
    assert result.outcome == OUTCOME_SETTLED
}

test "domain_consent_checks" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_ADMIT, 0)
    assert result.next_state == STATE_ADMITTED
    
    episode.plaintext_consent = CONSENT_DENIED
    episode.state = STATE_RECEIVED
    result = transition(episode, EVENT_ADMIT, 0)
    assert result.next_state == STATE_ADMITTED
}

test "malformed_result_handling" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_EXTRACTING,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_FAIL, 0)
    assert result.next_state == STATE_EXTRACTING
    assert result.emitted == false
    assert result.committed == false
}

test "negative_control_wrong_expectation" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_ADMIT, 0)
    assert result.next_state == STATE_COMMITTED
}

test "negative_control_widened_emission" {
    var episode = Episode {
        id: 1,
        group_id: 1,
        principal: 1,
        owner: 1,
        thread: 1,
        valid_at: 1000,
        created_at: 1000,
        content_hash: 0x12345678,
        plaintext_consent: CONSENT_GRANTED,
        trust_domain: DOMAIN_PRIVATE,
        attempts: 1,
        state: STATE_RECEIVED,
        reason: REASON_NONE
    }
    
    var result = transition(episode, EVENT_ADMIT, 0)
    assert result.emitted == false
}