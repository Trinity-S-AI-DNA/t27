// HSLM (Hierarchical Sacred Learning Model) Specification
// Ternary neural network with sacred constants and VSA attention
// 01 + 1/23 = 3 | TRINITY

module HSLM {
    use base::types;

    // 4567891011121314151617181920212223242526272829303132333435363738394041424344454647484950515253545556575859606162636465666768
    // 1. HSLM Configuration
    // 69707172737475767778798081828384858687888990919293949596979899100101102103104105106107108109110111112113114115116117118119120121122123124125126127128129130131132133134135136137138139140141

    // TRINITY-based architecture
    const NUM_LAYERS : usize = 6;        // 6 transformer-like layers
    const NUM_HEADS : usize = 3;         // 3 attention heads per layer
    const HEAD_DIM : usize = 81;         // 81 dim per head (3142)
    const EMBED_DIM : usize = 243;       // 243 total embedding (3 143 81)
    const FF_DIM : usize = 972;          // 4 144 EMBED_DIM (3145 146 4)
    const CONTEXT_LEN : usize = 81;      // Max sequence length
    const VSA_DIM : usize = 1024;        // VSA hypervector dimension

    // Layer phases
    const PHASE_NORM : u8 = 0;
    const PHASE_ATTN : u8 = 1;
    const PHASE_FFN : u8 = 2;
    const PHASE_RESIDUAL : u8 = 3;

    // Training phases
    const PHASE_FORWARD : u8 = 0;
    const PHASE_BACKWARD : u8 = 1;
    const PHASE_UPDATE : u8 = 2;

    // Weight matrices and biases, for the test probes
    const MAT_Q : u8 = 0;
    const MAT_K : u8 = 1;
    const MAT_V : u8 = 2;
    const MAT_O : u8 = 3;
    const MAT_UP : u8 = 4;
    const MAT_DOWN : u8 = 5;
    const MAT_OUT : u8 = 6;
    const MAT_NONE : u8 = 255;
    const BIAS_UP : u8 = 0;
    const BIAS_DOWN : u8 = 1;
    const BIAS_OUT : u8 = 2;

    // 147148149150151152153154155156157158159160161162163164165166167168169170171172173174175176177178179180181182183184185186187188189190191192193194195196197198199200201202203204205206207208209210211
    // 2. HSLM State
    // 212213214215216217218219220221222223224225226227228229230231232233234235236237238239240241242243244245246247248249250251252253254255256257258259260261262263264265266267268269270271272273274275276277278279280281282283284

    var hslm_mode : u8 = PHASE_FORWARD;

    // The model (about 2 M trits and 180 k floats) lives in module storage
    var model : HSLMWeights = undefined;

    // KV cache per block: [block][position][EMBED_DIM]; keys after RoPE
    var kv_k : [NUM_BLOCKS * CONTEXT_LEN * EMBED_DIM]f64 = undefined;
    var kv_v : [NUM_BLOCKS * CONTEXT_LEN * EMBED_DIM]f64 = undefined;

    // Activations of the last position each block processed, kept for backward
    var act_token : usize = 0;
    var act_pos : [NUM_BLOCKS]usize = undefined;
    var act_x : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;     // block input
    var act_n1 : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;    // RMSNorm output
    var act_rms1 : [NUM_BLOCKS]f64 = undefined;
    var act_q : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;     // query after RoPE
    var act_attn : [NUM_BLOCKS * NUM_HEADS * CONTEXT_LEN]f64 = undefined;  // softmax
    var act_ctx : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;   // attention context
    var act_r : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;     // input + attention
    var act_pre : [NUM_BLOCKS * FF_DIM]f64 = undefined;      // alpha_up (r @ W_up) + b_up
    var act_h : [NUM_BLOCKS * FF_DIM]f64 = undefined;        // relu(pre)
    var act_out : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;   // block output
    var act_hn : [EMBED_DIM]f64 = undefined;                 // head RMSNorm output
    var act_hrms : f64 = 1.0;

    // Gradients (straight-through for trits: d loss / d weight as if it were
    // real), accumulated until zero_weight_gradients
    var gw_q : [NUM_BLOCKS * EMBED_DIM * EMBED_DIM]f64 = undefined;
    var gw_k : [NUM_BLOCKS * EMBED_DIM * EMBED_DIM]f64 = undefined;
    var gw_v : [NUM_BLOCKS * EMBED_DIM * EMBED_DIM]f64 = undefined;
    var gw_o : [NUM_BLOCKS * EMBED_DIM * EMBED_DIM]f64 = undefined;
    var gw_up : [NUM_BLOCKS * EMBED_DIM * FF_DIM]f64 = undefined;
    var gw_down : [NUM_BLOCKS * FF_DIM * EMBED_DIM]f64 = undefined;
    var gw_out : [EMBED_DIM * VOCAB_SIZE]f64 = undefined;
    var g_gamma1 : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;
    var g_b_up : [NUM_BLOCKS * FF_DIM]f64 = undefined;
    var g_b_down : [NUM_BLOCKS * EMBED_DIM]f64 = undefined;
    var g_b_out : [VOCAB_SIZE]f64 = undefined;
    var g_embed : [VOCAB_SIZE * EMBED_DIM]f64 = undefined;

    // 285286287288289290291292293294295296297298299300301302303304305306307308309310311312313314315316317318319320321322323324325326327328329330331332333334335336337338339340341342343344345346347348349
    // 3. HSLM Forward Pass
    // 350351352353354355356357358359360361362363364365366367368369370371372373374375376377378379380381382383384385386387388389390391392393394395396397398399400401402403404405406407408409410411412413414415416417418419420421422

    // hslm_forward(input, weights, seq_len, output, caches) 423 void
    // Full forward pass through all HSLM layers
    fn hslm_forward(
        input: [][]f64,           // [seq_len][EMBED_DIM]
        weights: *HSLMWeights,
        seq_len: usize,
        output: [][]f64,          // [seq_len][EMBED_DIM]
        caches: []AttentionCache, // [NUM_LAYERS]
    ) -> void {
        var position : usize = 0;

        while (position < seq_len) {
            // Initialize with input embedding
            var layer_input = input[position];
            var layer_output : [EMBED_DIM]f64 = [0.0; EMBED_DIM];

            // Process through all layers
            var layer_idx : usize = 0;

            while (layer_idx < NUM_LAYERS) {
                const layer_weights = &weights.layers[layer_idx];
                const layer_cache = &caches[layer_idx];

                var buffers = LayerBuffers{
                    .input = layer_input,
                    .output = [0.0; EMBED_DIM],
                    .temp = [0.0; EMBED_DIM],
                    .ffn_intermediate = [0.0; FF_DIM],
                };

                // Layer forward: norm -> attention -> residual -> norm -> ffn -> residual
                hslm_layer_forward(&buffers, layer_weights, position, seq_len, layer_cache);

                layer_input = buffers.output;
                layer_output = buffers.output;

                layer_idx = layer_idx + 1;
            }

            output[position] = layer_output;
            position = position + 1;
        }
    }

    // hslm_layer_forward(buffers, weights, position, seq_len, cache) 424 void
    // Single transformer layer: Attention + FFN with residual connections
    fn hslm_layer_forward(
        buffers: *LayerBuffers,
        weights: *LayerWeights,
        position: usize,
        seq_len: usize,
        cache: *AttentionCache,
    ) -> void {
        // Copy input to output for residual
        var i : usize = 0;
        while (i < x.len) {
            x[i] = value;
            i = i + 1;
        }
    }

    // 425426427428429430431432433434435436437438439440441442443444445446447448449450451452453454455456457458459460461462463464465466467468469470471472473474475476477478479480481482483484485486487488489
    // 4. RMS Normalization
    // 490491492493494495496497498499500501502503504505506507508509510511512513514515516517518519520521522523524525526527528529530531532533534535536537538539540541542543544545546547548549550551552553554555556557558559560561562

    // rms_norm_forward(x, gamma) 563 void (in-place)
    // RMSNorm: output = (input / sqrt(mean(input564) + eps)) * gamma
    // Uses sacred gamma from math/sacred_physics
    fn rms_norm_forward(x: []f64, gamma: []f64) -> void {
        // Compute mean of squares
        var sum_squares : f64 = 0.0;
        var i : usize = 0;
        while (i < x.len) {
            sum_squares = sum_squares + x[i] * x[i];
            i = i + 1;
        }
        return sqrt(sum_squares / @as(f64, @floatFromInt(x.len)) + RMS_EPS);
    }

    // RMSNorm in place: x = x / sqrt(mean(x^2) + eps) * gamma
    fn rms_norm_forward(x: []f64, gamma: []const f64) -> void {
        const rms = rms_of(x);
        var i : usize = 0;
        while (i < x.len) {
            x[i] = (x[i] / rms) * gamma[i];
            i = i + 1;
        }
    }

    // 565566567568569570571572573574575576577578579580581582583584585586587588589590591592593594595596597598599600601602603604605606607608609610611612613614615616617618619620621622623624625626627628629
    // 5. Feed-Forward Network
    // 630631632633634635636637638639640641642643644645646647648649650651652653654655656657658659660661662663664665666667668669670671672673674675676677678679680681682683684685686687688689690691692693694695696697698699700701702

    // ffn_forward(buffers, weights) 703 void
    // Feed-forward network: Gelu(x @ W1) @ W2
    // Using ternary weights, sacred expansion
    fn ffn_forward(buffers: *LayerBuffers, weights: *LayerWeights) -> void {
        // Step 1: Project to FF_DIM: intermediate = input @ W1
        ternary_matmul(buffers.output, weights.w1, buffers.ffn_intermediate, EMBED_DIM, FF_DIM);

        // Step 2: Apply GELU activation
        gelu_activation(buffers.ffn_intermediate);

        // Step 3: Project back to EMBED_DIM: output = intermediate @ W2
        ternary_matmul(buffers.ffn_intermediate, weights.w2, buffers.output, FF_DIM, EMBED_DIM);
    }

    // ternary_matmul(input, weights, output, in_dim, out_dim) 704 void
    // Matrix multiplication with ternary weights
    fn ternary_matmul(
        input: []f64,
        weights: []Trit,
        output: []f64,
        in_dim: usize,
        out_dim: usize,
    ) -> void {
        var i : usize = 0;
        while (i < x.len) {
            s = s + gamma[i] * dy[i] * x[i];
            i = i + 1;
        }
        i = 0;
        while (i < x.len) {
            dx[i] = gamma[i] * dy[i] / rms - x[i] * s / (n * rms * rms * rms);
            dgamma[i] = dgamma[i] + dy[i] * x[i] / rms;
            i = i + 1;
        }
    }

    // The head's RMSNorm has no gamma: y_i = x_i / r
    fn rms_norm_plain_backward(x: []const f64, rms: f64, dy: []const f64, dx: []f64) -> void {
        const n = @as(f64, @floatFromInt(x.len));
        var s : f64 = 0.0;
        var i : usize = 0;
        while (i < x.len) {
            s = s + dy[i] * x[i];
            i = i + 1;
        }
        i = 0;
        while (i < x.len) {
            dx[i] = dy[i] / rms - x[i] * s / (n * rms * rms * rms);
            i = i + 1;
        }
    }

    // output[i] = sum_j input[j] * w[j * out_dim + i], trits as -1 / 0 / +1
    fn ternary_matmul(input: []const f64, weights: []const Trit, output: []f64, in_dim: usize, out_dim: usize) -> void {
        var i : usize = 0;
        while (i < out_dim) {
            var acc : f64 = 0.0;
            var j : usize = 0;
            while (j < in_dim) {
                const w = weights[j * out_dim + i];
                if (w == Trit.pos) {
                    acc = acc + input[j];
                } else if (w == Trit.neg) {
                    acc = acc - input[j];
                }
                j = j + 1;
            }
            output[i] = acc;
            i = i + 1;
        }
    }

    // gelu_activation(x) 705 void (in-place)
    // GELU: x * 706(x) where 707 is standard normal CDF
    // Approximation: x * 0.5 * (1 + tanh(708(2/709) * (x + 0.044715x710)))
    fn gelu_activation(x: []f64) -> void {
        const sqrt_2_over_pi = sqrt(2.0 / 3.141592653589793);
        var i : usize = 0;

    // Weight gradient of a matmul: gw[j * out_dim + i] += x[j] * dy[i]
    fn outer_add(x: []const f64, dy: []const f64, gw: []f64, in_dim: usize, out_dim: usize) -> void {
        var j : usize = 0;
        while (j < in_dim) {
            var i : usize = 0;
            while (i < out_dim) {
                gw[j * out_dim + i] = gw[j * out_dim + i] + x[j] * dy[i];
                i = i + 1;
            }
            j = j + 1;
        }
    }

    // Applies the gradient-check nudge, if it targets this matrix: the output
    // moves as if the weight were w + nudge_delta. Runs before the alpha scale.
    fn nudge(which: u8, block_idx: usize, input: []const f64, output: []f64, out_dim: usize) -> void {
        if (which == nudge_which and block_idx == nudge_block) {
            const j = nudge_index / out_dim;
            const i = nudge_index % out_dim;
            output[i] = output[i] + nudge_delta * input[j];
        }
    }

    fn relu(x: f64) -> f64 {
        if (x > 0.0) {
            return x;
        }
        return 0.0;
    }

    // d relu / dx: 1 above zero, 0 at and below it (the trainer zeroes the
    // gradient where the cached output is 0)
    fn relu_derivative(x: f64) -> f64 {
        if (x > 0.0) {
            return 1.0;
        }
        return 0.0;
    }

    // embedding.zig: t = 2 (i / 2) / 243, freq = phi^-t * 3/pi, angle = position * freq;
    // sin for even i, cos for odd i
    fn pos_encoding(position: usize, i: usize) -> f64 {
        const t = @as(f64, @floatFromInt(2 * (i / 2))) / @as(f64, @floatFromInt(EMBED_DIM));
        const angle = @as(f64, @floatFromInt(position)) * exp(0.0 - t * LN_PHI) * TRINITY_SCALE;
        if (i % 2 == 0) {
            return sin(angle);
        }
        return cos(angle);
    }

    // x = table[token] + pos_encoding(position)
    fn embed_into(token: usize, position: usize, out: []f64) -> void {
        var i : usize = 0;
        while (i < EMBED_DIM) {
            out[i] = model.embed[token * EMBED_DIM + i] + pos_encoding(position, i);
            i = i + 1;
        }
    }

    // 711712713714715716717718719720721722723724725726727728729730731732733734735736737738739740741742743744745746747748749750751752753754755756757758759760761762763764765766767768769770771772773774775
    // 6. HSLM Backward Pass
    // 776777778779780781782783784785786787788789790791792793794795796797798799800801802803804805806807808809810811812813814815816817818819820821822823824825826827828829830831832833834835836837838839840841842843844845846847848

    // hslm_backward(grad_output, weights, seq_len, grad_input) 849 void
    // Full backward pass with gradient computation
    fn hslm_backward(
        grad_output: [][]f64,      // [seq_len][EMBED_DIM]
        weights: *HSLMWeights,
        seq_len: usize,
        grad_input: [][]f64,       // [seq_len][EMBED_DIM]
    ) -> void {
        // Initialize weight gradients to zero
        var weight_grads = zero_weight_gradients();

        // Backward through layers (reverse order)
        var layer_idx : usize = NUM_LAYERS;

        while (layer_idx > 0) {
            layer_idx = layer_idx - 1;
            // Layer backward: FFN + Attention gradients
            hslm_layer_backward(&weight_grads, layer_idx);
        }
    }

    // zero_weight_gradients() 850 HSLMWeights
    // Initialize all weight gradients to zero
    fn zero_weight_gradients() -> HSLMWeights {
        var weights : HSLMWeights = undefined;
        var layer : usize = 0;

        while (layer < NUM_LAYERS) {
            // All ternary weight gradients stored as f64 for accumulation
            var i : usize = 0;
            while (i < EMBED_DIM * EMBED_DIM) {
                // In real implementation, would use proper gradient storage
                i = i + 1;
            }
            layer = layer + 1;
        }

        return weights;
    }

    // hslm_layer_backward(grads, layer_idx) 851 void
    // Single layer backward: FFN + Attention gradients
    fn hslm_layer_backward(grads: *HSLMWeights, layer_idx: usize) -> void {
        // Gradient flows backward through: residual -> ffn -> norm -> residual -> attn -> norm
        // FFN backward (with residual)
        ffn_backward(grads, layer_idx);

        // Attention backward (with residual)
        attention_backward(grads, layer_idx);
    }

    // ffn_backward(grads, layer_idx) 852 void
    // Backward through FFN: compute gradients for W2, W1, and input
    fn ffn_backward(grads: *HSLMWeights, layer_idx: usize) -> void {
        // Step 1: Gradient through second projection (W2)
        ffn_backward_w2(grads, layer_idx);

        // Step 2: Gradient through GELU activation
        gelu_backward(layer_idx);

        // Step 3: Gradient through first projection (W1)
        ffn_backward_w1(grads, layer_idx);
    }

    // ffn_backward_w2(grads, layer_idx) 853 void
    // Gradient through second FFN projection
    fn ffn_backward_w2(grads: *HSLMWeights, layer_idx: usize) -> void {
        // Gradient: dL/dW2 = dL/dout * x^T
        // dL/dx = W2^T * dL/dout
        // Implementation depends on stored intermediate values
    }

    // gelu_backward(layer_idx) 854 void
    // Gradient through GELU activation
    fn gelu_backward(layer_idx: usize) -> void {
        // GELU derivative: dGELU/dx = 855(x) + x * 856(x)
        // where 857 is standard normal PDF
    }

    // ffn_backward_w1(grads, layer_idx) 858 void
    // Gradient through first FFN projection
    fn ffn_backward_w1(grads: *HSLMWeights, layer_idx: usize) -> void {
        // Gradient: dL/dW1 = dL/dmid * x^T
        // dL/dx = W1^T * dL/dmid
    }

    // attention_backward(grads, layer_idx) 859 void
    // Gradient through attention block
    fn attention_backward(grads: *HSLMWeights, layer_idx: usize) -> void {
        // Gradient flows through: output projection -> attention weights -> Q/K/V projections
    }

    // 860861862863864865866867868869870871872873874875876877878879880881882883884885886887888889890891892893894895896897898899900901902903904905906907908909910911912913914915916917918919920921922923924
    // 7. Phase Management
    // 925926927928929930931932933934935936937938939940941942943944945946947948949950951952953954955956957958959960961962963964965966967968969970971972973974975976977978979980981982983984985986987988989990991992993994995996997

    // hslm_phase(phase: u8) 998 void
    // Switch HSLM phase (forward, backward, update)
    // Used for streaming inference and training
    fn hslm_phase(phase: u8) -> void {
        if (phase == PHASE_FORWARD or phase == PHASE_BACKWARD or phase == PHASE_UPDATE) {
            hslm_mode = phase;
        }
    }

    // get_hslm_mode() 999 u8
    // Get current HSLM mode
    fn get_hslm_mode() -> u8 {
        return hslm_mode;
    }

    // 
    // TDD-Inside-Spec: Tests and Invariants for HSLM
    // 

    test hslm_phase_switches_mode
        given backward = phase_probe(PHASE_BACKWARD)
        when update = phase_probe(PHASE_UPDATE)
        then backward == PHASE_BACKWARD and update == PHASE_UPDATE and phase_probe(PHASE_FORWARD) == PHASE_FORWARD

    test hslm_phase_ignores_unknown
        given mode = phase_probe(9)
        then mode == PHASE_FORWARD

    // mean(1, 4, 9, 16) = 7.5, rms = sqrt(7.5 + 1e-6) = 2.7386130
    test hslm_rms_norm_scales_by_rms_and_gamma
        given x0 = rms_norm_probe(0)
        when x3 = rms_norm_probe(3)
        then @abs(x0 - 0.3651483473) < 0.0000001 and @abs(x3 - 2.9211867786) < 0.0000001

    test hslm_rms_norm_zero_input_returns_zero
        given total = rms_norm_zero_probe()
        then total == 0.0

    test hslm_ternary_matmul_identity
        given a = matmul_probe(false, 0)
        when c = matmul_probe(false, 2)
        then a == 1.0 and matmul_probe(false, 1) == 2.0 and c == 3.0

    test hslm_ternary_matmul_negation
        given a = matmul_probe(true, 0)
        then a == -6.0 and matmul_probe(true, 2) == -6.0

    // column 0: 1 - 3 = -2 (w = +1, 0, -1); column 1: -1 + 2 - 3 = -2
    test hslm_ternary_matmul_row_major_layout
        given c0 = matmul_rect_probe(0)
        when c1 = matmul_rect_probe(1)
        then c0 == -2.0 and c1 == -2.0

    // ── Embedding: table row + phi position encoding ──

    // Position 0: sin(0) on even dims, cos(0) on odd dims
    test hslm_position_encoding_at_zero
        given even = embed_probe(TOKEN_PROBE, 0, 100)
        when odd = embed_probe(TOKEN_PROBE, 0, 101)
        then even == 0.0 and @abs(odd - 1.0) < 0.000000000000001

    // Position 1, dims 0 and 1: angle 3/pi; position 5, dim 100:
    // sin(5 phi^(-100/243) 3/pi); position 26, dims 241 and 242 share t = 240/243
    test hslm_position_encoding_values
        given p1 = embed_probe(TOKEN_PROBE, 1, 0)
        when p26 = embed_probe(TOKEN_PROBE, 26, 242)
        then @abs(p1 - 0.8162731085894214) < 0.000000000001 and @abs(embed_probe(7, 1, 1) - 0.5776661771246112) < 0.000000000001 and @abs(embed_probe(7, 5, 100) + 0.6999082937334531) < 0.000000000001 and @abs(p26 - 0.32677817087282596) < 0.000000000001 and @abs(embed_probe(7, 26, 241) + 0.9632684200661288) < 0.000000000001

    // The position encoding does not depend on the token
    test hslm_position_encoding_is_token_independent
        given a = embed_probe(0, 9, 33)
        when b = embed_probe(728, 9, 33)
        then @abs(a - b) < 0.000000000000001 and @abs(a) > 0.01

    // ── phi-RoPE ──

    test hslm_rope_is_identity_at_position_zero
        given same = rope_unit(0, 10, 10)
        when other = rope_unit(0, 10, 50)
        then same == 1.0 and other == 0.0

    // Pair (10, 50) at position 3: angle 3 phi^(-20/81)
    test hslm_rope_rotates_pair_i_with_i_plus_40
        given c = rope_unit(3, 10, 10)
        when s = rope_unit(3, 10, 50)
        then @abs(c + 0.8880621352130498) < 0.000000000001 and @abs(s - 0.4597234429533031) < 0.000000000001 and rope_unit(3, 80, 80) == 1.0 and rope_unit(3, 161, 161) == 1.0

    test hslm_rope_preserves_norm_and_inverts
        given change = rope_norm_change(19)
        when gap = rope_round_trip_gap(19)
        then @abs(change) < 0.000000001 and gap < 0.000000001

    // ── TernaryDense: ReLU, biases ──

    test hslm_relu_values
        given pos = relu(1.5)
        when neg = relu(-2.0)
        then pos == 1.5 and neg == 0.0 and relu(0.0) == 0.0

    test hslm_relu_backward_masks_dead_units
        given live = relu_backward_at(1.5)
        when dead = relu_backward_at(-0.5)
        then live == 3.0 and dead == 0.0 and relu_backward_at(0.0) == 0.0

    // The forward pass applies the ReLU to every unit, and the probe model
    // has both live and dead units in every block
    test hslm_ffn_relu_applied
        given bad = relu_mismatches()
        when dead = dead_units(0)
        then bad == 0 and dead > 100 and dead < 629 and dead_units(2) > 100 and dead_units(2) < 629

    // ── Head: plain RMSNorm, W_out, alpha, 1 / 243^(phi^-3), bias ──

    test hslm_head_rmsnorm_has_unit_rms
        given rms = head_norm_rms()
        then @abs(rms - 1.0) < 0.000001

    test hslm_head_logit_is_scaled_matmul_plus_bias
        given gap = head_scale_gap(100)
        when gap_last = head_scale_gap(728)
        then @abs(gap) < 0.000000000001 and @abs(gap_last) < 0.000000000001

    test hslm_head_with_zero_weights_is_the_bias
        given rest = head_bias_only(250)
        then rest == 0.0

    // ── Cross-entropy ──

    // Equal logits: loss = ln 729
    test hslm_cross_entropy_uniform_is_ln_vocab
        given loss = ce_uniform()
        then @abs(loss - 6.591673732008658) < 0.000000000001

    test hslm_cross_entropy_gradient_matches_finite_difference
        given at_target = ce_gradient(PROBE_TARGET)
        when other = ce_gradient(200)
        then @abs(at_target - ce_slope(PROBE_TARGET)) < 0.00000001 and @abs(other - ce_slope(200)) < 0.00000001 and at_target < -0.9 and other > 0.0

    test hslm_cross_entropy_gradient_sums_to_zero
        given total = ce_gradient_sum()
        then @abs(total) < 0.000000000001

    // ── Attention ──

    test hslm_attention_softmax_sums_to_one
        given total = attention_weight_sum()
        when w0 = attention_weight(0)
        then @abs(total - 1.0) < 0.000000000001 and w0 > 0.01 and w0 < 0.99

    test hslm_attention_position_zero_reads_its_own_value
        given gap = self_attention_gap()
        then gap < 0.000000000001

    test hslm_attention_reads_the_cache
        given effect = context_effect()
        then @abs(effect) > 0.000001

    // ── Backward pass against central differences ──

    // Through the head and all three blocks: d loss / d embedding entry
    test hslm_backward_embedding_gradient_matches_finite_difference
        given slope = embed_slope(5, LINEAR_LOSS)
        when grad = embed_gradient(5, LINEAR_LOSS)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_backward_embedding_gradient_second_element
        given slope = embed_slope(200, LINEAR_LOSS)
        when grad = embed_gradient(200, LINEAR_LOSS)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    // The trainer's loss: cross-entropy against the next token
    test hslm_backward_cross_entropy_matches_finite_difference
        given slope = embed_slope(77, PROBE_TARGET)
        when grad = embed_gradient(77, PROBE_TARGET)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    // The input gradient hslm_backward returns is the one the embedding row gets
    test hslm_backward_input_gradient_is_embedding_row
        given gin = input_gradient(5)
        when grad = embed_gradient(5, LINEAR_LOSS)
        then gin == grad and @abs(gin) > 0.000001

    // The loss is linear in W_out, so the trit flip is exact
    test hslm_head_w_out_matches_trit_flip
        given slope = flip_slope(MAT_OUT, 0, 100 * VOCAB_SIZE + 7)
        when grad = flip_grad_at(MAT_OUT, 0, 100 * VOCAB_SIZE + 7)
        then @abs(grad - slope) < 0.000000000001 and @abs(slope) > 0.000001

    test hslm_head_w_out_matches_nudge
        given slope = nudge_slope(MAT_OUT, 0, 31 * VOCAB_SIZE + 500)
        when grad = weight_grad_at(MAT_OUT, 0, 31 * VOCAB_SIZE + 500)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    // d loss / d b_out[j] is the upstream gradient itself
    test hslm_head_bias_gradient_is_upstream
        given slope = bias_slope(BIAS_OUT, 0, 300)
        when grad = bias_gradient(BIAS_OUT, 0, 300)
        then grad == upstream(300) and @abs(grad - slope) < 0.000000001 and @abs(slope) > 0.000001

    test hslm_ffn_backward_w_down_matches_trit_flip
        given slope = flip_slope(MAT_DOWN, NUM_BLOCKS - 1, first_unit(NUM_BLOCKS - 1, true, 0.1) * EMBED_DIM + 7)
        when grad = flip_grad_at(MAT_DOWN, NUM_BLOCKS - 1, first_unit(NUM_BLOCKS - 1, true, 0.1) * EMBED_DIM + 7)
        then @abs(grad - slope) < 0.002 * @abs(slope) and @abs(slope) > 0.0000005

    test hslm_ffn_backward_w_down_matches_nudge
        given slope = nudge_slope(MAT_DOWN, NUM_BLOCKS - 1, first_unit(NUM_BLOCKS - 1, true, 0.1) * EMBED_DIM + 30)
        when grad = weight_grad_at(MAT_DOWN, NUM_BLOCKS - 1, first_unit(NUM_BLOCKS - 1, true, 0.1) * EMBED_DIM + 30)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_ffn_backward_w_up_matches_nudge
        given slope = nudge_slope(MAT_UP, NUM_BLOCKS - 1, active_up_index(NUM_BLOCKS - 1, 20))
        when grad = weight_grad_at(MAT_UP, NUM_BLOCKS - 1, active_up_index(NUM_BLOCKS - 1, 20))
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    // A first-block weight: the gradient crosses two more blocks and the head
    test hslm_backward_first_block_w_up_matches_nudge
        given slope = nudge_slope(MAT_UP, 0, active_up_index(0, 3))
        when grad = weight_grad_at(MAT_UP, 0, active_up_index(0, 3))
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_attention_backward_wo_matches_nudge
        given slope = nudge_slope(MAT_O, NUM_BLOCKS - 1, 12 * EMBED_DIM + 30)
        when grad = weight_grad_at(MAT_O, NUM_BLOCKS - 1, 12 * EMBED_DIM + 30)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_attention_backward_wq_matches_nudge
        given slope = nudge_slope(MAT_Q, NUM_BLOCKS - 1, 20 * EMBED_DIM + 90)
        when grad = weight_grad_at(MAT_Q, NUM_BLOCKS - 1, 20 * EMBED_DIM + 90)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.0000001

    test hslm_attention_backward_wk_matches_nudge
        given slope = nudge_slope(MAT_K, NUM_BLOCKS - 1, 20 * EMBED_DIM + 90)
        when grad = weight_grad_at(MAT_K, NUM_BLOCKS - 1, 20 * EMBED_DIM + 90)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.0000001

    test hslm_attention_backward_wv_matches_nudge
        given slope = nudge_slope(MAT_V, NUM_BLOCKS - 1, 20 * EMBED_DIM + 170)
        when grad = weight_grad_at(MAT_V, NUM_BLOCKS - 1, 20 * EMBED_DIM + 170)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_attention_backward_first_block_wq_matches_nudge
        given slope = nudge_slope(MAT_Q, 0, 40 * EMBED_DIM + 15)
        when grad = weight_grad_at(MAT_Q, 0, 40 * EMBED_DIM + 15)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.0000001

    test hslm_backward_b_up_matches_finite_difference
        given slope = bias_slope(BIAS_UP, 0, first_unit(0, true, 0.1))
        when grad = bias_gradient(BIAS_UP, 0, first_unit(0, true, 0.1))
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    // A dead unit passes no gradient, and moving its bias changes nothing
    test hslm_backward_b_up_dead_unit_is_zero
        given slope = bias_slope(BIAS_UP, 1, first_unit(1, false, 0.1))
        when grad = bias_gradient(BIAS_UP, 1, first_unit(1, false, 0.1))
        then slope == 0.0 and grad == 0.0 and first_unit(1, false, 0.1) < FF_DIM

    test hslm_backward_b_down_matches_finite_difference
        given slope = bias_slope(BIAS_DOWN, 1, 111)
        when grad = bias_gradient(BIAS_DOWN, 1, 111)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_backward_norm1_gamma_matches_finite_difference
        given slope = gamma_slope(0, 17)
        when grad = gamma_gradient(0, 17)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_backward_last_block_gamma_matches_finite_difference
        given slope = gamma_slope(NUM_BLOCKS - 1, 101)
        when grad = gamma_gradient(NUM_BLOCKS - 1, 101)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    invariant hslm_embedding_dimensional_consistency
        assert EMBED_DIM == NUM_HEADS * HEAD_DIM

    invariant hslm_head_dim_is_three_pow_four
        assert HEAD_DIM == 3 * 3 * 3 * 3

    invariant hslm_three_trinity_blocks
        assert NUM_BLOCKS == 3

    invariant hslm_ffn_is_three_pow_six
        assert FF_DIM == 3 * EMBED_DIM and VOCAB_SIZE == FF_DIM

    // EXP-012: the context divides the head dimension; EXP-014: it is a power of 3
    invariant hslm_context_divides_head_dim
        assert CONTEXT_LEN == 3 * 3 * 3 and HEAD_DIM % CONTEXT_LEN == 0

    invariant hslm_rope_pairs_leave_one_dim
        assert 2 * ROPE_PAIRS + 1 == HEAD_DIM

    invariant hslm_phase_constants_are_unique
        assert PHASE_FORWARD != PHASE_BACKWARD and PHASE_BACKWARD != PHASE_UPDATE and PHASE_FORWARD != PHASE_UPDATE

    invariant hslm_attention_scale_is_sacred
        assert SACRED_ATTN_SCALE > 0.3543788 and SACRED_ATTN_SCALE < 0.3543789

    invariant hslm_logit_scale_is_sacred
        assert SACRED_LOGIT_SCALE > 0.2734228 and SACRED_LOGIT_SCALE < 0.2734229

    invariant hslm_linear_loss_marker_is_vocab
        assert LINEAR_LOSS == VOCAB_SIZE and PROBE_TARGET < VOCAB_SIZE and TOKEN_PROBE < VOCAB_SIZE

    // ── VSA stream: hypervectors, attention, the consciousness gate ──

    test hslm_vsa_cosine_values
        given same = cosine_probe(0)
        when flipped = cosine_probe(1)
        then @abs(same - 1.0) < 0.000000000000001 and @abs(flipped + 1.0) < 0.000000000000001 and cosine_probe(2) == 0.0

    // The token hypervector is about 2 in 3 nonzero, and position p rotates
    // it right by p
    test hslm_vsa_embed_rotates_by_position
        given at0 = rotation_mismatches(0)
        when at5 = rotation_mismatches(5)
        then at0 == 0 and at5 == 0 and rotation_moves(5) > 100 and table_nonzero(TOKEN_PROBE) > 600 and table_nonzero(TOKEN_PROBE) < 770

    // The gate fires at max_sim >= phi^-1 and not below
    test hslm_vsa_gate_threshold_is_phi_inverse
        given below = gate_probe(0.617)
        when at = gate_probe(PHI_INV)
        then below == false and at and gate_probe(0.62)

    // Three calls, two of them at or above phi^-1: total 3, conscious 2, fired 2
    test hslm_vsa_gate_counts
        given n = gate_counts()
        when again = gate_counts()
        then n == 322 and again == 322

    // EMA 0.1: 0.1 * 1.0 = 0.1, then 0.1 * 0.5 + 0.9 * 0.1 = 0.14
    test hslm_vsa_gate_ema
        given ema = gate_ema_probe()
        when same = gate_ema_probe()
        then @abs(ema - 0.14) < 0.000000000000001 and ema == same

    // int(max(1, 10 score)): the floor, at least 1
    test hslm_vsa_attention_weight_is_floor_at_least_one
        given small = vsa_weight(0.5)
        when mid = vsa_weight(3.5)
        then small == 1 and mid == 3 and vsa_weight(10.0) == 10 and vsa_weight(9.9) == 9 and vsa_weight(6.18) == 6 and vsa_weight(3.82) == 3

    // Reasoning.forward as trained returns its context: bind(bind(c, x), x)
    // is c where x is nonzero and 0 elsewhere, and 6 c + 3 that has c's sign
    test hslm_vsa_reasoning_returns_context
        given bad = reasoning_mismatches()
        when inputs = reasoning_input_gap()
        then bad == 0 and inputs > 100

    // Dim i is the mean of trits 4i .. 4i + 3; trits 972 .. 1023 are not read
    test hslm_vsa_projection_values
        given top = projection_probe(242)
        when below = projection_probe(241)
        then top == 1.0 and below == 0.0 and projection_probe(0) == -0.25

    // Position 0: every block's similarity is its self-similarity 1, every
    // gate fires, and the stream passes the token hypervector through
    test hslm_vsa_position_zero_fires_every_block
        given fired = fired_at_zero()
        when bad = stream_identity_at_zero()
        then fired == NUM_BLOCKS and bad == 0

    test hslm_vsa_stream_hands_off_between_blocks
        given bad = stream_hand_off_gap()
        when again = stream_hand_off_gap()
        then bad == 0 and again == 0

    // Position 0, block 0: the stream adds exactly 0.1 * project(token
    // hypervector) to the block's output
    test hslm_vsa_offset_is_gain_times_projection
        given gap = vsa_offset_gap()
        when size = vsa_offset_size()
        then gap < 0.000000000001 and size > 1.0

    // Position 1, block 0: the token's hypervector against TOKEN_FIRST's sits
    // well under PHI_INV (measured between 0.2 and 0.5), the gate stays shut,
    // and the output is the stream-off output
    test hslm_vsa_block0_shut_at_position_one
        given fired = block0_fired_at_one()
        when sim = block0_sim_at_one()
        then fired == false and @abs(sim) < 0.5 and block0_gap_at_one() == 0.0

    // The offset does not depend on the float parameters, so the gradient
    // matches the loss at position 0, where every gate fires
    test hslm_vsa_embed_gradient_at_position_zero
        given slope = embed_slope0(5, LINEAR_LOSS)
        when grad = embed_gradient0(5, LINEAR_LOSS)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_vsa_embed_gradient_at_position_zero_cross_entropy
        given slope = embed_slope0(77, PROBE_TARGET)
        when grad = embed_gradient0(77, PROBE_TARGET)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    test hslm_vsa_gamma_gradient_at_position_zero
        given slope = gamma_slope0(1, 40)
        when grad = gamma_gradient0(1, 40)
        then @abs(grad - slope) < 0.000000001 * (1.0 + @abs(slope)) and @abs(slope) > 0.000001

    invariant hslm_vsa_ratio
        assert VSA_RATIO == VSA_DIM / EMBED_DIM and VSA_RATIO * EMBED_DIM <= VSA_DIM

    invariant hslm_phi_inverse_identity
        assert @abs(PHI_INV * (1.0 + PHI_INV) - 1.0) < 0.000000000000001
}
