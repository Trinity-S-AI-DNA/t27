// t27/specs/nn/attention.t27
// Sacred Attention Specification
// Multi-head attention with 0-RoPE and sacred scaling (d_k^(-12))
// 34 + 1/56 = 3 | TRINITY

module SacredAttention {
    use base::types;

    // 7891011121314151617181920212223242526272829303132333435363738394041424344454647484950515253545556575859606162636465666768697071
    // 1. Constants
    // 72737475767778798081828384858687888990919293949596979899100101102103104105106107108109110111112113114115116117118119120121122123124125126127128129130131132133134135136137138139140141142143144

    // TRINITY-based configuration
    const NUM_HEADS : usize = 3;           // 3 heads (TRINITY)
    const HEAD_DIM : usize = 81;            // 81 dim per head (3145)
    const EMBED_DIM : usize = 243;          // Total embedding (3 146 81)
    const CONTEXT_LEN : usize = 81;         // Max sequence length
    const ROPE_PAIRS : usize = 40;          // 81/2 = 40 pairs (1 unrotated)

    // Sacred scaling: 147148149 and d_k^(-150151)
    const SACRED_GAMMA : f64 = constants::PHI_CUBED_INV;  // 152153154 155 0.236
    const SACRED_SCALE : f64 = pow(81.0, -SACRED_GAMMA); // 81^(-156157158) 159 0.354

    // Sacred scaling: gamma = phi^-3 and the score scale 81^(-gamma) = 0.3543788557
    const SACRED_GAMMA : f64 = PHI_CUBED_INV;
    const SACRED_SCALE : f64 = 0.3543788557382518;

    // A masked score: exp(MASK_SCORE - anything finite) underflows to exactly 0.0
    const MASK_SCORE : f64 = 0.0 - 1.0e30;

    // 160161162163164165166167168169170171172173174175176177178179180181182183184185186187188189190191192193194195196197198199200201202203204205206207208209210211212213214215216217218219220221222223224
    // 2. RoPE Tables
    // 225226227228229230231232233234235236237238239240241242243244245246247248249250251252253254255256257258259260261262263264265266267268269270271272273274275276277278279280281282283284285286287288289290291292293294295296297

    // 298-RoPE tables: [CONTEXT_LEN 299 ROPE_PAIRS]
    // Each entry is precomputed cos(p * 300_i) and sin(p * 301_i)
    // where 302_i = 303^(-2i/HEAD_DIM) for i=0..ROPE_PAIRS-1
    struct RoPETables {
        cos : [CONTEXT_LEN * ROPE_PAIRS]f64,
        sin : [CONTEXT_LEN * ROPE_PAIRS]f64,
    }

    // =====================================================================
    // 2. Storage
    // =====================================================================

    // 304305306307308309310311312313314315316317318319320321322323324325326327328329330331332333334335336337338339340341342343344345346347348349350351352353354355356357358359360361362363364365366367368
    // 3. Attention State
    // 369370371372373374375376377378379380381382383384385386387388389390391392393394395396397398399400401402403404405406407408409410411412413414415416417418419420421422423424425426427428429430431432433434435436437438439440441

    // The QK gain: Q and K are scaled by it, so scores by its square
    var qk_gain : f64 = 1.0;

    // 442443444445446447448449450451452453454455456457458459460461462463464465466467468469470471472473474475476477478479480481482483484485486487488489490491492493494495496497498499500501502503504505506
    // 4. Initialization
    // 507508509510511512513514515516517518519520521522523524525526527528529530531532533534535536537538539540541542543544545546547548549550551552553554555556557558559560561562563564565566567568569570571572573574575576577578579

    // sacred_attention_init() 580 void
    // Initialize 581-RoPE tables
    // 582_i = 583^(-2i/HEAD_DIM) for i=0..ROPE_PAIRS-1
    // For each position p: cos(p*584_i), sin(p*585_i)
    fn sacred_attention_init() -> void {
        var p : usize = 0;

        while (p < CONTEXT_LEN) {
            var i : usize = 0;

            while (i < ROPE_PAIRS) {
                // Compute freq = 586^(-2i/HEAD_DIM)
                const freq_exponent = -2.0 * (i as f64) / (HEAD_DIM as f64);
                const freq = pow(constants::PHI, freq_exponent);

                // angle = position * freq
                const angle = (p as f64) * freq;

                // cos and sin
                const cos_val = cos(angle);
                const sin_val = sin(angle);

                // Store in tables
                const table_offset = p * ROPE_PAIRS + i;
                rope_tables.cos[table_offset] = cos_val;
                rope_tables.sin[table_offset] = sin_val;

                i = i + 1;
            }

            p = p + 1;
        }
    }

    // 587588589590591592593594595596597598599600601602603604605606607608609610611612613614615616617618619620621622623624625626627628629630631632633634635636637638639640641642643644645646647648649650651
    // 5. Main Attention Kernel
    // 652653654655656657658659660661662663664665666667668669670671672673674675676677678679680681682683684685686687688689690691692693694695696697698699700701702703704705706707708709710711712713714715716717718719720721722723724

    // sacred_attention_kernel(
    //   input: []f32,              // [EMBED_DIM] input embeddings
    //   w_q: []Trit, w_k: []Trit, w_v: []Trit, w_o: []Trit, // Ternary weights
    //   position: usize,
    //   seq_len: usize,
    //   output: []f32,             // [EMBED_DIM] output
    //   cache_k: []f32, cache_v: []f32,  // [CONTEXT_LEN][EMBED_DIM]
    // ) 725 void
    // Single position forward pass with sacred scaling
    fn sacred_attention_kernel(
        input: []f64,
        w_q: []Trit, w_k: []Trit, w_v: []Trit, w_o: []Trit,
        position: usize,
        seq_len: usize,
        output: []f64,
        cache_k: []f64, cache_v: []f64,
    ) -> void {
        var buffers = AttentionBuffers{
            .q_buffer = [0.0; EMBED_DIM],
            .k_buffer = [0.0; EMBED_DIM],
            .v_buffer = [0.0; EMBED_DIM],
            .scores = [0.0; NUM_HEADS * CONTEXT_LEN],
            .concat = [0.0; EMBED_DIM],
        };

        // Step 1: Project Q, K, V via ternary matmul
        project_qkv(&buffers, input, w_q, w_k, w_v);

        // Step 2: Apply 726-RoPE to Q and K
        apply_rope_qk(&buffers, position);

        // Step 3: Cache K and V
        cache_kv(&buffers, position, cache_k, cache_v);

        // Step 4: Compute attention scores (Q @ K^T * SACRED_SCALE)
        compute_scores(&buffers, position, seq_len, cache_k);

        // Step 5: Apply softmax to scores
        apply_softmax(&buffers, seq_len);

        // Step 6: Weighted sum of values
        weighted_values(&buffers, seq_len, cache_v);

        // Step 7: Output projection via W_o
        project_output(&buffers, w_o, output);

        // Step 8: Add residual connection
        add_residual(output, input);
    }

    // 727728729730731732733734735736737738739740741742743744745746747748749750751752753754755756757758759760761762763764765766767768769770771772773774775776777778779780781782783784785786787788789790791
    // 6. Q/K/V Projection
    // 792793794795796797798799800801802803804805806807808809810811812813814815816817818819820821822823824825826827828829830831832833834835836837838839840841842843844845846847848849850851852853854855856857858859860861862863864

    // project_qkv(buffers, input, w_q, w_k, w_v) 865 void
    // Compute Q, K, V projections using ternary matrix multiplication
    // Q[i] = 866_j input[j] * W_q[j][i]
    // Using ternary weights: W_q[j][i] 867 {-1, 0, +1}
    fn project_qkv(
        buffers: *AttentionBuffers,
        input: []f64,
        w_q: []Trit, w_k: []Trit, w_v: []Trit,
    ) -> void {
        // Compute Q
        ternary_matmul(input, w_q, &buffers.q_buffer, EMBED_DIM, EMBED_DIM);

        // Compute K
        ternary_matmul(input, w_k, &buffers.k_buffer, EMBED_DIM, EMBED_DIM);

        // Compute V
        ternary_matmul(input, w_v, &buffers.v_buffer, EMBED_DIM, EMBED_DIM);
    }

    // ternary_matmul(input, weights, output, in_dim, out_dim) 868 void
    // Matrix multiplication with ternary weights
    fn ternary_matmul(
        input: []f64,
        weights: []Trit,
        output: []f64,
        in_dim: usize,
        out_dim: usize,
    ) -> void {
        var i : usize = 0;
        while (i < out_dim) {
            var acc : f64 = 0.0;
            var j : usize = 0;
            while (j < in_dim) {
                const w = weights[j * out_dim + i];
                if (w == Trit.pos) {
                    acc = acc + input[j];
                } else if (w == Trit.neg) {
                    acc = acc - input[j];
                }
                j = j + 1;
            }
            output[i] = acc;
            i = i + 1;
        }
    }

    // 869870871872873874875876877878879880881882883884885886887888889890891892893894895896897898899900901902903904905906907908909910911912913914915916917918919920921922923924925926927928929930931932933
    // 7. 934-RoPE Application
    // 93593693793893994094194294394494594694794894995095195295395495595695795895996096196296396496596696796896997097197297397497597697797897998098198298398498598698798898999099199299399499599699799899910001001100210031004100510061007

    // apply_rope_qk(buffers, position) 1008 void
    // Apply 1009-RoPE rotation to Q and K
    // Rotates pairs of dimensions using precomputed tables
    fn apply_rope_qk(buffers: *AttentionBuffers, position: usize) -> void {
        var h : usize = 0;

        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var pair_idx : usize = 0;

            while (pair_idx < ROPE_PAIRS) {
                const idx0 = head_offset + pair_idx;
                const idx1 = head_offset + pair_idx + ROPE_PAIRS;

                const table_offset = position * ROPE_PAIRS + pair_idx;
                const cos_val = rope_tables.cos[table_offset];
                const sin_val = rope_tables.sin[table_offset];

                // Rotate Q
                const q0 = buffers.q_buffer[idx0];
                const q1 = buffers.q_buffer[idx1];
                buffers.q_buffer[idx0] = q0 * cos_val - q1 * sin_val;
                buffers.q_buffer[idx1] = q0 * sin_val + q1 * cos_val;

                // Rotate K
                const k0 = buffers.k_buffer[idx0];
                const k1 = buffers.k_buffer[idx1];
                buffers.k_buffer[idx0] = k0 * cos_val - k1 * sin_val;
                buffers.k_buffer[idx1] = k0 * sin_val + k1 * cos_val;

                pair_idx = pair_idx + 1;
            }
            p = p + 1;
        }
        qk_gain = 1.0;
    }

    fn set_qk_gain(gain: f64) -> void {
        qk_gain = gain;
    }

    // The gain of an ablation variant; an unknown id gets the standard gain
    fn get_qk_gain(variant: u8) -> f64 {
        if (variant == QK_PHI_SQUARED) {
            return GAIN_PHI_SQ;
        }
        if (variant == QK_SQRT_PHI) {
            return GAIN_SQRT_PHI;
        }
        if (variant == QK_LEARNED) {
            return GAIN_LEARNED_INIT;
        }
        return GAIN_STANDARD;
    }

    // Score scale of the ablation against plain attention: gain^2 / sqrt(head_dim).
    // Q and K both carry the gain, so the dot product picks up gain^2.
    fn effective_score_scale(gain: f64, head_dim: f64) -> f64 {
        return gain * gain / sqrt(head_dim);
    }

    // Rotates pairs (i, i + 40) of every head of x (EMBED_DIM long) by the
    // position's angles; inverse rotates the other way (the transpose).
    // A position past the tables is left alone: the table is
    // [CONTEXT_LEN * ROPE_PAIRS] and nothing else bounds `position`.
    fn rope(x: []f64, position: usize, inverse: bool) -> void {
        if (position >= CONTEXT_LEN) {
            return;
        }
        var h : usize = 0;
        while (h < NUM_HEADS) {
            var i : usize = 0;
            while (i < ROPE_PAIRS) {
                const c = rope_cos[position * ROPE_PAIRS + i];
                var s = rope_sin[position * ROPE_PAIRS + i];
                if (inverse) {
                    s = 0.0 - s;
                }
                const i0 = h * HEAD_DIM + i;
                const i1 = i0 + ROPE_PAIRS;
                const x0 = x[i0];
                const x1 = x[i1];
                x[i0] = x0 * c - x1 * s;
                x[i1] = x0 * s + x1 * c;
                i = i + 1;
            }
            h = h + 1;
        }
    }

    // 10101011101210131014101510161017101810191020102110221023102410251026102710281029103010311032103310341035103610371038103910401041104210431044104510461047104810491050105110521053105410551056105710581059106010611062106310641065106610671068106910701071107210731074
    // 8. KV Caching
    // 1075107610771078107910801081108210831084108510861087108810891090109110921093109410951096109710981099110011011102110311041105110611071108110911101111111211131114111511161117111811191120112111221123112411251126112711281129113011311132113311341135113611371138113911401141114211431144114511461147

    // cache_kv(buffers, position, cache_k, cache_v) 1148 void
    // Cache K and V at the current position
    fn cache_kv(
        buffers: *AttentionBuffers,
        position: usize,
        cache_k: []f64, cache_v: []f64,
    ) -> void {
        const offset = position * EMBED_DIM;
        var i : usize = 0;
        while (i < EMBED_DIM) {
            cache_k[offset + i] = k[i];
            cache_v[offset + i] = v[i];
            i = i + 1;
        }
    }

    // 11491150115111521153115411551156115711581159116011611162116311641165116611671168116911701171117211731174117511761177117811791180118111821183118411851186118711881189119011911192119311941195119611971198119912001201120212031204120512061207120812091210121112121213
    // 9. Score Computation
    // 1214121512161217121812191220122112221223122412251226122712281229123012311232123312341235123612371238123912401241124212431244124512461247124812491250125112521253125412551256125712581259126012611262126312641265126612671268126912701271127212731274127512761277127812791280128112821283128412851286

    // compute_scores(buffers, position, seq_len, cache_k) 1287 void
    // Compute attention scores: Q @ K^T * SACRED_SCALE
    // For causal attention: only positions <= current position
    fn compute_scores(
        buffers: *AttentionBuffers,
        position: usize,
        seq_len: usize,
        cache_k: []f64,
    ) -> void {
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var j : usize = 0;
            while (j < bounded_len) {
                if (j > position) {
                    scores[h * CONTEXT_LEN + j] = MASK_SCORE;
                } else {
                    var dot : f64 = 0.0;
                    var d : usize = 0;
                    while (d < HEAD_DIM) {
                        dot = dot + q[head_offset + d] * cache_k[j * EMBED_DIM + head_offset + d];
                        d = d + 1;
                    }
                    scores[h * CONTEXT_LEN + j] = dot * SACRED_SCALE * qk_gain * qk_gain;
                }

                // Compute dot product: Q_head 1288 K_head[j]
                var score : f64 = 0.0;
                var d : usize = 0;

                while (d < HEAD_DIM) {
                    const q_val = buffers.q_buffer[head_offset + d];
                    const k_val = cache_k[j * EMBED_DIM + head_offset + d];
                    score = score + q_val * k_val;
                    d = d + 1;
                }

                // Apply sacred scale
                buffers.scores[h * CONTEXT_LEN + j] = score * SACRED_SCALE;
                j = j + 1;
            }
            h = h + 1;
        }
    }

    // 12891290129112921293129412951296129712981299130013011302130313041305130613071308130913101311131213131314131513161317131813191320132113221323132413251326132713281329133013311332133313341335133613371338133913401341134213431344134513461347134813491350135113521353
    // 10. Softmax
    // 1354135513561357135813591360136113621363136413651366136713681369137013711372137313741375137613771378137913801381138213831384138513861387138813891390139113921393139413951396139713981399140014011402140314041405140614071408140914101411141214131414141514161417141814191420142114221423142414251426

    // apply_softmax(buffers, seq_len) 1427 void
    // Apply softmax to attention scores for each head
    // softmax(x) = exp(x - max) / 1428 exp(x - max)
    fn apply_softmax(buffers: *AttentionBuffers, seq_len: usize) -> void {
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const row = h * CONTEXT_LEN;
            var max_score : f64 = scores[row];
            var j : usize = 1;
            while (j < bounded_len) {
                if (scores[row + j] > max_score) {
                    max_score = scores[row + j];
                }
                j = j + 1;
            }
            var sum_exp : f64 = 0.0;
            j = 0;
            while (j < bounded_len) {
                scores[row + j] = exp(scores[row + j] - max_score);
                sum_exp = sum_exp + scores[row + j];
                j = j + 1;
            }
            j = 0;
            while (j < bounded_len) {
                scores[row + j] = scores[row + j] / sum_exp;
                j = j + 1;
            }
            h = h + 1;
        }
    }

    // 14291430143114321433143414351436143714381439144014411442144314441445144614471448144914501451145214531454145514561457145814591460146114621463146414651466146714681469147014711472147314741475147614771478147914801481148214831484148514861487148814891490149114921493
    // 11. Weighted Value Sum
    // 1494149514961497149814991500150115021503150415051506150715081509151015111512151315141515151615171518151915201521152215231524152515261527152815291530153115321533153415351536153715381539154015411542154315441545154615471548154915501551155215531554155515561557155815591560156115621563156415651566

    // weighted_values(buffers, seq_len, cache_v) 1567 void
    // Compute weighted sum of values: output = 1568 attention[j] * V[j]
    fn weighted_values(
        buffers: *AttentionBuffers,
        seq_len: usize,
        cache_v: []f64,
    ) -> void {
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var d : usize = 0;
            while (d < HEAD_DIM) {
                var weighted_sum : f64 = 0.0;
                var j : usize = 0;
                while (j < bounded_len) {
                    weighted_sum = weighted_sum + scores[h * CONTEXT_LEN + j] * cache_v[j * EMBED_DIM + head_offset + d];
                    j = j + 1;
                }
                concat[head_offset + d] = weighted_sum;
                d = d + 1;
            }
            h = h + 1;
        }
    }

    // 15691570157115721573157415751576157715781579158015811582158315841585158615871588158915901591159215931594159515961597159815991600160116021603160416051606160716081609161016111612161316141615161616171618161916201621162216231624162516261627162816291630163116321633
    // 12. Output Projection
    // 1634163516361637163816391640164116421643164416451646164716481649165016511652165316541655165616571658165916601661166216631664166516661667166816691670167116721673167416751676167716781679168016811682168316841685168616871688168916901691169216931694169516961697169816991700170117021703170417051706

    // project_output(buffers, w_o, output) 1707 void
    // Apply output projection: output = concat @ W_o
    // Using ternary weights
    fn project_output(
        buffers: *AttentionBuffers,
        w_o: []Trit,
        output: []f64,
    ) -> void {
        ternary_matmul(buffers.concat, w_o, output, EMBED_DIM, EMBED_DIM);
    }

    // 17081709171017111712171317141715171617171718171917201721172217231724172517261727172817291730173117321733173417351736173717381739174017411742174317441745174617471748174917501751175217531754175517561757175817591760176117621763176417651766176717681769177017711772
    // 13. Residual Connection
    // 1773177417751776177717781779178017811782178317841785178617871788178917901791179217931794179517961797179817991800180118021803180418051806180718081809181018111812181318141815181618171818181918201821182218231824182518261827182818291830183118321833183418351836183718381839184018411842184318441845

    // add_residual(output, input) 1846 void
    // Add residual connection: output = output + input
    fn add_residual(output: []f64, input: []f64) -> void {
        var i : usize = 0;
        while (i < output.len) {
            output[i] = output[i] + input[i];
            i = i + 1;
        }
    }

    // 
    // TDD-Inside-Spec: Tests and Invariants for SacredAttention
    // 

    // -- Constants --

    test attn_phi_squared_is_phi_plus_one
        given lhs = phi_squared()
        when rhs = phi_plus_one()
        then @abs(lhs - rhs) < 0.000000000001

    test attn_phi_squared_plus_inverse_is_three
        given total = phi_identity_total()
        then @abs(total - 3.0) < 0.000000000001

    test attn_gamma_is_phi_cubed_inverse
        given product = gamma_times_phi_cubed()
        when closed_form = sqrt_five_minus_two()
        then @abs(product - 1.0) < 0.000000000001 and @abs(gamma_value() - closed_form) < 0.000000000001

    test attn_sacred_scale_is_81_to_minus_gamma
        given expected = scale_from_gamma()
        when actual = scale_value()
        then @abs(actual - expected) < 0.000000000001

    // -- Ternary matmul --

    test attn_ternary_matmul_identity
        given a = matmul_probe(false, 0)
        when c = matmul_probe(false, 2)
        then a == 1.0 and matmul_probe(false, 1) == 2.0 and c == 3.0

    test attn_ternary_matmul_negation
        given a = matmul_probe(true, 0)
        then a == -6.0 and matmul_probe(true, 2) == -6.0

    // column 0: 1 - 3 = -2 (w = +1, 0, -1); column 1: -1 + 2 - 3 = -2
    test attn_ternary_matmul_row_major_layout
        given c0 = matmul_rect_probe(0)
        when c1 = matmul_rect_probe(1)
        then c0 == -2.0 and c1 == -2.0

    test attn_add_residual_adds_elementwise
        given a = residual_probe(0)
        when d = residual_probe(3)
        then a == 7.0 and residual_probe(1) == 14.0 and residual_probe(2) == 21.0 and d == 28.0

    // -- phi-RoPE --

    test attn_rope_is_identity_at_position_zero
        given same = rope_unit(0, 10, 10)
        when other = rope_unit(0, 10, 50)
        then same == 1.0 and other == 0.0

    // Pair (10, 50) at position 3: angle 3 phi^(-20/81); dims 80, 161 are unrotated
    test attn_rope_rotates_pair_i_with_i_plus_40
        given c = rope_unit(3, 10, 10)
        when s = rope_unit(3, 10, 50)
        then @abs(c + 0.8880621352130498) < 0.000000000001 and @abs(s - 0.4597234429533031) < 0.000000000001 and rope_unit(3, 80, 80) == 1.0 and rope_unit(3, 161, 161) == 1.0

    // Head 1 rotates the same pair indices inside its own 81 dims
    test attn_rope_rotates_every_head
        given head0 = rope_unit(3, 10, 50)
        when head1 = rope_unit(3, 81 + 10, 81 + 50)
        then @abs(head0 - head1) < 0.000000000001 and rope_unit(3, 81 + 10, 50) == 0.0

    test attn_rope_preserves_norm_and_inverts
        given change = rope_norm_change(19)
        when gap = rope_round_trip_gap(19)
        then @abs(change) < 0.000000001 and gap < 0.000000001

    test attn_rope_table_entries_are_unit_circle
        given worst = table_unit_gap()
        then worst < 0.000000000001

    // theta_0 = 1: the first pair turns 1 rad per position; pair 39 turns slowest
    test attn_rope_table_frequencies
        given c1 = table_cos_at(1, 0)
        when s2 = table_sin_at(2, 0)
        then @abs(c1 - cos(1.0)) < 0.000000000001 and @abs(s2 - sin(2.0)) < 0.000000000001 and table_cos_at(0, 39) == 1.0

    test attn_rope_past_the_tables_changes_nothing
        given gap = rope_out_of_range_gap()
        then gap == 0.0

    // -- Cache --

    test attn_cache_kv_stores_at_the_position_row
        given k = cache_probe(0, 2, 5)
        when v = cache_probe(1, 2, 5)
        then k == 6.0 and v == 105.0 and cache_probe(0, 1, 5) == 0.0 and cache_probe(1, 3, 5) == 0.0

    test attn_cache_kv_past_the_end_writes_nothing
        given total = cache_out_of_range_sum()
        then total == 0.0

    // -- Scores, mask, softmax --

    // Head 0: (2 e_0 . 3 e_0) S = 6 S; head 2 reads its own slice: 1 * 4 * S
    test attn_scores_are_scaled_dot_products_per_head
        given s0 = score_probe(0, 1.0)
        when s2 = score_probe(2, 1.0)
        then @abs(s0 - 6.0 * SACRED_SCALE) < 0.000000000001 and @abs(s2 - 4.0 * SACRED_SCALE) < 0.000000000001 and score_probe(1, 1.0) == 0.0

    // Q and K both carry the gain: the score picks up gain^2
    test attn_qk_gain_scales_scores_by_gain_squared
        given base = score_probe(0, 1.0)
        when scaled = score_probe(0, GAIN_PHI_SQ)
        then @abs(scaled / base - GAIN_PHI_SQ * GAIN_PHI_SQ) < 0.000000000001

    test attn_softmax_row_sums_to_one
        given h0 = softmax_row_sum(0.0, 0)
        when h2 = softmax_row_sum(0.0, 2)
        then @abs(h0 - 1.0) < 0.000000000001 and @abs(h2 - 1.0) < 0.000000000001

    // softmax(1, 2, 3, 4)[3] = 1 / (1 + e^-1 + e^-2 + e^-3); e^-1 apart in order
    test attn_softmax_values
        given top = softmax_probe(0.0, 0, 3)
        when ratio = softmax_probe(0.0, 0, 0) / softmax_probe(0.0, 0, 1)
        then @abs(top - 1.0 / (1.0 + exp(-1.0) + exp(-2.0) + exp(-3.0))) < 0.000000000001 and @abs(ratio - exp(-1.0)) < 0.000000000001

    test attn_softmax_of_equal_scores_is_uniform
        given w = softmax_probe(0.0, 1, 2)
        then @abs(w - 0.25) < 0.000000000001

    // exp(1004) overflows; subtracting the max keeps it finite and the same
    test attn_softmax_is_shift_invariant_and_stable
        given plain = softmax_probe(0.0, 0, 3)
        when shifted = softmax_probe(1000.0, 0, 3)
        then @abs(plain - shifted) < 0.000000000001 and shifted > 0.6 and shifted < 0.7

    // Position 1 sees keys 0 and 1 (scores S and 2 S); positions 2 and 3 are masked
    test attn_causal_mask_gives_future_zero_weight
        given w2 = causal_probe(2)
        when w3 = causal_probe(3)
        then w2 == 0.0 and w3 == 0.0

    test attn_causal_mask_leaves_a_distribution_on_the_past
        given w0 = causal_probe(0)
        when w1 = causal_probe(1)
        then @abs(w0 + w1 - 1.0) < 0.000000000001 and @abs(w1 / w0 - exp(SACRED_SCALE)) < 0.000000000001

    // -- Weighted values --

    test attn_weighted_values_mix_values_by_weight
        given mixed = weighted_probe(HEAD_DIM + 3)
        when other_head = weighted_probe(3)
        then @abs(mixed - 7.0) < 0.000000000001 and other_head == 0.0 and weighted_probe(HEAD_DIM + 4) == 0.0

    // -- Kernel --

    // Identity weights, one token: context = v_0 = x, output = x + x
    test attn_kernel_identity_one_position
        given gap = kernel_one_position_gap()
        then gap < 0.000000000001

    // Wo = -identity: output = x - context = 0, so Wo is applied
    test attn_kernel_applies_output_projection
        given total = kernel_negated_output_total()
        then total < 0.000000000001

    // Two tokens by hand: weights from scores 3 cos(1) S and 2.25 S, values unrotated
    test attn_kernel_two_positions_match_closed_form
        given out = kernel_two_position(0)
        when expected = two_position_expected()
        then @abs(out - expected) < 0.000000001 and @abs(kernel_two_position(40)) < 0.000000000001

    // V is not rotated and x has only dim 0, so every other head stays zero
    test attn_kernel_leaves_other_heads_alone
        given total = kernel_other_heads_total()
        then total < 0.000000000001

    // seq_len 3 at position 0 with a poisoned future must equal seq_len 1
    test attn_kernel_does_not_read_the_future
        given gap = kernel_future_gap()
        then gap < 0.000000000001

    test attn_kernel_past_the_cache_does_nothing
        given gap = kernel_out_of_range_gap()
        then gap == 0.0

    // -- QK-gain ablation (Phase B2) --

    test attn_gain_variants
        given phi_sq = get_qk_gain(QK_PHI_SQUARED)
        when standard = get_qk_gain(QK_STANDARD)
        then @abs(phi_sq - (PHI + 1.0)) < 0.000000000001 and standard == 1.0 and get_qk_gain(QK_LEARNED) == 1.0 and @abs(get_qk_gain(QK_SQRT_PHI) - sqrt(PHI)) < 0.000000000001 and get_qk_gain(99) == 1.0

    // 1 / sqrt(96), and phi^4 / sqrt(96) = 0.6995
    test attn_effective_score_scale
        given standard = effective_score_scale(GAIN_STANDARD, 96.0)
        when phi_sq = effective_score_scale(GAIN_PHI_SQ, 96.0)
        then @abs(standard - 1.0 / sqrt(96.0)) < 0.000000000001 and @abs(phi_sq * sqrt(96.0) - PHI * PHI * PHI * PHI) < 0.000000001 and phi_sq > 0.69 and phi_sq < 0.71

    test attn_phi_squared_gain_scales_more_than_standard
        given a = effective_score_scale(GAIN_PHI_SQ, 96.0)
        when b = effective_score_scale(GAIN_STANDARD, 96.0)
        then a > b and a / b > 6.8 and a / b < 6.9

    // -- Invariants --

    invariant attn_embed_dim_is_heads_times_head_dim
        assert EMBED_DIM == NUM_HEADS * HEAD_DIM

    invariant attn_head_dim_is_three_pow_four
        assert HEAD_DIM == 3 * 3 * 3 * 3

    invariant attn_rope_pairs_leave_one_dim
        assert 2 * ROPE_PAIRS + 1 == HEAD_DIM

    invariant attn_context_equals_head_dim
        assert CONTEXT_LEN == HEAD_DIM

    invariant attn_sacred_gamma_range
        assert SACRED_GAMMA > 0.2360679 and SACRED_GAMMA < 0.2360680

    invariant attn_sacred_scale_range
        assert SACRED_SCALE > 0.3543788 and SACRED_SCALE < 0.3543789

    invariant attn_mask_is_below_any_score
        assert MASK_SCORE < 0.0 - 1.0e20

    invariant attn_gain_variants_are_distinct
        assert GAIN_PHI_SQ != GAIN_STANDARD and GAIN_PHI_SQ != GAIN_SQRT_PHI and GAIN_STANDARD != GAIN_SQRT_PHI

    invariant attn_gain_variant_ids_are_unique
        assert QK_PHI_SQUARED != QK_STANDARD and QK_STANDARD != QK_LEARNED and QK_LEARNED != QK_SQRT_PHI and QK_PHI_SQUARED != QK_LEARNED and QK_PHI_SQUARED != QK_SQRT_PHI and QK_STANDARD != QK_SQRT_PHI
}
