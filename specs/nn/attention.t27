// SPDX-License-Identifier: Apache-2.0
// t27/specs/nn/attention.t27
// Sacred Attention Specification
// Multi-head causal attention with phi-RoPE and sacred scaling (d_k^(-phi^3))
// phi^2 + 1/phi^2 = 3 | TRINITY
//
// This spec never compiled: it read constants::PHI_CUBED_INV and
// constants::PHI, which math::constants does not define for t27c ("use of
// undeclared identifier 'constants'"); it computed its scale with a pow()
// that has a negative non-integer exponent; its tests built buffers with
// `AttentionBuffers{...}` and called functions that take a pointer to them;
// and the second module appended below it (AttentionQKGainAblation) had two
// functions with empty bodies, called run_attention_with_gain and
// attention_forward, which exist nowhere, and asserted gain constants against
// themselves.
//
// It is written out now with only `use base::types`:
//   - phi, phi^-3 and the sacred scale 81^(-phi^-3) are local constants; the
//     tests check them against independent identities (phi^2 = phi + 1,
//     phi^2 + phi^-2 = 3, phi^-3 = sqrt(5) - 2, exp(-phi^-3 ln 81)).
//   - the buffers are slices the caller owns, so every step can be tested on
//     its own; the phi-RoPE tables live in module storage.
//   - the causal mask is a very negative score, not 0.0: with 0.0 a masked
//     position still received softmax weight exp(0 - max) > 0, so any call
//     with seq_len > position + 1 read the future.
//   - the QK-gain ablation is one scalar, qk_gain, applied to Q and K before
//     the dot product (so it multiplies the score by gain^2), with the
//     variants phi^2, 1.0, learned-at-1.0 and sqrt(phi) as constants.
// Dropped, because nothing here implements or measures them: the bidirectional
// and sparse attention types and the six phase constants (no code reads them);
// the ablation's training run (run_attention_with_gain, a BPB measurement);
// the `bench` blocks (their targets named buffers and calls that do not exist,
// and a bench measures nothing the compiler can check); the gf16 type for the
// gains (f64 here).
//
// The kernel is checked on an identity-weight case computed by hand, against a
// two-position case with a closed form, and against a future-poisoned cache.
// The caller runs sacred_attention_init() once before the kernel (tables).

module SacredAttention {
    use base::types;

    // =====================================================================
    // 1. Constants
    // =====================================================================

    // TRINITY-based configuration
    const NUM_HEADS : usize = 3;           // 3 heads
    const HEAD_DIM : usize = 81;           // 81 per head (3^4)
    const EMBED_DIM : usize = 243;         // total embedding (3 x 81)
    const CONTEXT_LEN : usize = 81;        // max sequence length
    const ROPE_PAIRS : usize = 40;         // pairs (i, i + 40) per head; dim 80 unrotated

    // The golden ratio, and phi^-3 = 1 / phi^3 = sqrt(5) - 2
    const PHI : f64 = 1.618033988749895;
    const PHI_CUBED_INV : f64 = 1.0 / (PHI * PHI * PHI);

    // Sacred scaling: gamma = phi^-3 and the score scale 81^(-gamma) = 0.3543788557
    const SACRED_GAMMA : f64 = PHI_CUBED_INV;
    const SACRED_SCALE : f64 = 0.3543788557382518;

    // A masked score: exp(MASK_SCORE - anything finite) underflows to exactly 0.0
    const MASK_SCORE : f64 = 0.0 - 1.0e30;

    // QK-gain ablation variants (Phase B2): the gain applied to Q and K
    const GAIN_PHI_SQ : f64 = 2.618033988749895;       // phi^2 = phi + 1 [open conjecture]
    const GAIN_STANDARD : f64 = 1.0;                   // baseline
    const GAIN_SQRT_PHI : f64 = 1.272019649514069;     // sqrt(phi) [open conjecture]
    const GAIN_LEARNED_INIT : f64 = 1.0;               // a learned gain starts at 1.0

    // Variant ids for get_qk_gain
    const QK_PHI_SQUARED : u8 = 0;
    const QK_STANDARD : u8 = 1;
    const QK_LEARNED : u8 = 2;
    const QK_SQRT_PHI : u8 = 3;

    // =====================================================================
    // 2. Storage
    // =====================================================================

    // phi-RoPE tables [position][pair]: cos(p * theta_i), sin(p * theta_i),
    // theta_i = phi^(-2i / HEAD_DIM)
    var rope_cos : [CONTEXT_LEN * ROPE_PAIRS]f64 = undefined;
    var rope_sin : [CONTEXT_LEN * ROPE_PAIRS]f64 = undefined;

    // The QK gain: Q and K are scaled by it, so scores by its square
    var qk_gain : f64 = 1.0;

    // =====================================================================
    // 3. Kernels
    // =====================================================================

    fn fill(x: []f64, value: f64) -> void {
        var i : usize = 0;
        while (i < x.len) {
            x[i] = value;
            i = i + 1;
        }
    }

    // output[i] = sum_j input[j] * w[j * out_dim + i], trits as -1 / 0 / +1
    fn ternary_matmul(input: []const f64, weights: []const Trit, output: []f64, in_dim: usize, out_dim: usize) -> void {
        var i : usize = 0;
        while (i < out_dim) {
            var acc : f64 = 0.0;
            var j : usize = 0;
            while (j < in_dim) {
                const w = weights[j * out_dim + i];
                if (w == Trit.pos) {
                    acc = acc + input[j];
                } else if (w == Trit.neg) {
                    acc = acc - input[j];
                }
                j = j + 1;
            }
            output[i] = acc;
            i = i + 1;
        }
    }

    // Fills the phi-RoPE tables and resets the QK gain to 1.0
    fn sacred_attention_init() -> void {
        const ln_phi = log(PHI);
        var p : usize = 0;
        while (p < CONTEXT_LEN) {
            var i : usize = 0;
            while (i < ROPE_PAIRS) {
                const t = 2.0 * @as(f64, @floatFromInt(i)) / @as(f64, @floatFromInt(HEAD_DIM));
                const angle = @as(f64, @floatFromInt(p)) * exp(0.0 - t * ln_phi);
                rope_cos[p * ROPE_PAIRS + i] = cos(angle);
                rope_sin[p * ROPE_PAIRS + i] = sin(angle);
                i = i + 1;
            }
            p = p + 1;
        }
        qk_gain = 1.0;
    }

    fn set_qk_gain(gain: f64) -> void {
        qk_gain = gain;
    }

    // The gain of an ablation variant; an unknown id gets the standard gain
    fn get_qk_gain(variant: u8) -> f64 {
        if (variant == QK_PHI_SQUARED) {
            return GAIN_PHI_SQ;
        }
        if (variant == QK_SQRT_PHI) {
            return GAIN_SQRT_PHI;
        }
        if (variant == QK_LEARNED) {
            return GAIN_LEARNED_INIT;
        }
        return GAIN_STANDARD;
    }

    // Score scale of the ablation against plain attention: gain^2 / sqrt(head_dim).
    // Q and K both carry the gain, so the dot product picks up gain^2.
    fn effective_score_scale(gain: f64, head_dim: f64) -> f64 {
        return gain * gain / sqrt(head_dim);
    }

    // Rotates pairs (i, i + 40) of every head of x (EMBED_DIM long) by the
    // position's angles; inverse rotates the other way (the transpose).
    // A position past the tables is left alone: the table is
    // [CONTEXT_LEN * ROPE_PAIRS] and nothing else bounds `position`.
    fn rope(x: []f64, position: usize, inverse: bool) -> void {
        if (position >= CONTEXT_LEN) {
            return;
        }
        var h : usize = 0;
        while (h < NUM_HEADS) {
            var i : usize = 0;
            while (i < ROPE_PAIRS) {
                const c = rope_cos[position * ROPE_PAIRS + i];
                var s = rope_sin[position * ROPE_PAIRS + i];
                if (inverse) {
                    s = 0.0 - s;
                }
                const i0 = h * HEAD_DIM + i;
                const i1 = i0 + ROPE_PAIRS;
                const x0 = x[i0];
                const x1 = x[i1];
                x[i0] = x0 * c - x1 * s;
                x[i1] = x0 * s + x1 * c;
                i = i + 1;
            }
            h = h + 1;
        }
    }

    // Stores k and v at `position` in the caches ([CONTEXT_LEN][EMBED_DIM]).
    // A position past the end writes nothing.
    fn cache_kv(k: []const f64, v: []const f64, position: usize, cache_k: []f64, cache_v: []f64) -> void {
        if (position >= CONTEXT_LEN) {
            return;
        }
        const offset = position * EMBED_DIM;
        var i : usize = 0;
        while (i < EMBED_DIM) {
            cache_k[offset + i] = k[i];
            cache_v[offset + i] = v[i];
            i = i + 1;
        }
    }

    // scores[h * CONTEXT_LEN + j] = (q_h . k_j) * SACRED_SCALE * gain^2 for
    // j <= position, MASK_SCORE for j > position (causal), j < seq_len
    fn compute_scores(q: []const f64, position: usize, seq_len: usize, cache_k: []const f64, scores: []f64) -> void {
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var j : usize = 0;
            while (j < bounded_len) {
                if (j > position) {
                    scores[h * CONTEXT_LEN + j] = MASK_SCORE;
                } else {
                    var dot : f64 = 0.0;
                    var d : usize = 0;
                    while (d < HEAD_DIM) {
                        dot = dot + q[head_offset + d] * cache_k[j * EMBED_DIM + head_offset + d];
                        d = d + 1;
                    }
                    scores[h * CONTEXT_LEN + j] = dot * SACRED_SCALE * qk_gain * qk_gain;
                }
                j = j + 1;
            }
            h = h + 1;
        }
    }

    // Softmax of each head's first seq_len scores, in place:
    // exp(s - max) / sum exp(s - max)
    fn apply_softmax(scores: []f64, seq_len: usize) -> void {
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const row = h * CONTEXT_LEN;
            var max_score : f64 = scores[row];
            var j : usize = 1;
            while (j < bounded_len) {
                if (scores[row + j] > max_score) {
                    max_score = scores[row + j];
                }
                j = j + 1;
            }
            var sum_exp : f64 = 0.0;
            j = 0;
            while (j < bounded_len) {
                scores[row + j] = exp(scores[row + j] - max_score);
                sum_exp = sum_exp + scores[row + j];
                j = j + 1;
            }
            j = 0;
            while (j < bounded_len) {
                scores[row + j] = scores[row + j] / sum_exp;
                j = j + 1;
            }
            h = h + 1;
        }
    }

    // concat[h * HEAD_DIM + d] = sum_j weight[h][j] * v_j[h * HEAD_DIM + d]
    fn weighted_values(scores: []const f64, seq_len: usize, cache_v: []const f64, concat: []f64) -> void {
        var bounded_len : usize = seq_len;
        if (bounded_len > CONTEXT_LEN) {
            bounded_len = CONTEXT_LEN;
        }
        var h : usize = 0;
        while (h < NUM_HEADS) {
            const head_offset = h * HEAD_DIM;
            var d : usize = 0;
            while (d < HEAD_DIM) {
                var weighted_sum : f64 = 0.0;
                var j : usize = 0;
                while (j < bounded_len) {
                    weighted_sum = weighted_sum + scores[h * CONTEXT_LEN + j] * cache_v[j * EMBED_DIM + head_offset + d];
                    j = j + 1;
                }
                concat[head_offset + d] = weighted_sum;
                d = d + 1;
            }
            h = h + 1;
        }
    }

    // output = output + input
    fn add_residual(output: []f64, input: []const f64) -> void {
        var i : usize = 0;
        while (i < output.len) {
            output[i] = output[i] + input[i];
            i = i + 1;
        }
    }

    // One position, causal, with a KV cache. q, k, v = input @ Wq, Wk, Wv;
    // phi-RoPE on q and k; k and v go into the cache at `position`; per head,
    // softmax(q . k_j * scale) over j <= position weights the v_j;
    // output = (context @ Wo) + input. A position past the cache leaves the
    // output and the caches untouched.
    fn sacred_attention_kernel(input: []const f64, w_q: []const Trit, w_k: []const Trit, w_v: []const Trit, w_o: []const Trit, position: usize, seq_len: usize, output: []f64, cache_k: []f64, cache_v: []f64) -> void {
        if (position >= CONTEXT_LEN) {
            return;
        }
        var q : [EMBED_DIM]f64 = undefined;
        var k : [EMBED_DIM]f64 = undefined;
        var v : [EMBED_DIM]f64 = undefined;
        var scores : [NUM_HEADS * CONTEXT_LEN]f64 = undefined;
        var concat : [EMBED_DIM]f64 = undefined;
        fill(&scores, 0.0);

        ternary_matmul(input, w_q, &q, EMBED_DIM, EMBED_DIM);
        ternary_matmul(input, w_k, &k, EMBED_DIM, EMBED_DIM);
        ternary_matmul(input, w_v, &v, EMBED_DIM, EMBED_DIM);
        rope(&q, position, false);
        rope(&k, position, false);
        cache_kv(&k, &v, position, cache_k, cache_v);
        compute_scores(&q, position, seq_len, cache_k, &scores);
        apply_softmax(&scores, seq_len);
        weighted_values(&scores, seq_len, cache_v, &concat);
        ternary_matmul(&concat, w_o, output, EMBED_DIM, EMBED_DIM);
        add_residual(output, input);
    }

    // =====================================================================
    // 4. Probes (the tests call these; each sets up what it reads)
    // =====================================================================

    const SENTINEL : f64 = 7.0;

    var p_wq : [EMBED_DIM * EMBED_DIM]Trit = undefined;
    var p_wk : [EMBED_DIM * EMBED_DIM]Trit = undefined;
    var p_wv : [EMBED_DIM * EMBED_DIM]Trit = undefined;
    var p_wo : [EMBED_DIM * EMBED_DIM]Trit = undefined;
    var p_ck : [CONTEXT_LEN * EMBED_DIM]f64 = undefined;
    var p_cv : [CONTEXT_LEN * EMBED_DIM]f64 = undefined;
    var p_in : [EMBED_DIM]f64 = undefined;
    var p_out : [EMBED_DIM]f64 = undefined;
    var p_vec : [EMBED_DIM]f64 = undefined;
    var p_scores : [NUM_HEADS * CONTEXT_LEN]f64 = undefined;
    var p_concat : [EMBED_DIM]f64 = undefined;

    // The constants, read through functions so the tests execute at runtime
    fn phi_squared() -> f64 {
        return PHI * PHI;
    }

    fn phi_plus_one() -> f64 {
        return PHI + 1.0;
    }

    fn phi_identity_total() -> f64 {
        const phi_sq = PHI * PHI;
        return phi_sq + 1.0 / phi_sq;
    }

    fn gamma_times_phi_cubed() -> f64 {
        return PHI_CUBED_INV * PHI * PHI * PHI;
    }

    fn gamma_value() -> f64 {
        return SACRED_GAMMA;
    }

    fn sqrt_five_minus_two() -> f64 {
        return sqrt(5.0) - 2.0;
    }

    fn scale_from_gamma() -> f64 {
        return exp(0.0 - SACRED_GAMMA * log(81.0));
    }

    fn scale_value() -> f64 {
        return SACRED_SCALE;
    }

    // A deterministic, non-trivial vector element
    fn small(i: usize) -> f64 {
        return 0.1 * @as(f64, @floatFromInt((i * 7) % 11)) - 0.5;
    }

    // w[j * EMBED_DIM + i] = +1 on the diagonal (sign = +1) or -1 (sign = -1), else 0
    fn set_diagonal(w: []Trit, negate: bool) -> void {
        var n : usize = 0;
        while (n < EMBED_DIM * EMBED_DIM) {
            w[n] = Trit.zero;
            n = n + 1;
        }
        var i : usize = 0;
        while (i < EMBED_DIM) {
            if (negate) {
                w[i * EMBED_DIM + i] = Trit.neg;
            } else {
                w[i * EMBED_DIM + i] = Trit.pos;
            }
            i = i + 1;
        }
    }

    // Identity Wq, Wk, Wv, Wo (or a negated Wo), empty caches, fresh tables
    fn identity_setup(negate_o: bool) -> void {
        sacred_attention_init();
        set_diagonal(&p_wq, false);
        set_diagonal(&p_wk, false);
        set_diagonal(&p_wv, false);
        set_diagonal(&p_wo, negate_o);
        fill(&p_ck, 0.0);
        fill(&p_cv, 0.0);
        fill(&p_out, SENTINEL);
    }

    fn matmul_probe(negate: bool, index: usize) -> f64 {
        const input : [3]f64 = [1.0, 2.0, 3.0];
        var weights : [9]Trit = [Trit.pos, Trit.zero, Trit.zero, Trit.zero, Trit.pos, Trit.zero, Trit.zero, Trit.zero, Trit.pos];
        if (negate) {
            var i : usize = 0;
            while (i < 9) {
                weights[i] = Trit.neg;
                i = i + 1;
            }
        }
        var output : [3]f64 = [9.0, 9.0, 9.0];
        ternary_matmul(&input, &weights, &output, 3, 3);
        return output[index];
    }

    // A 3 x 2 matrix: output[i] = sum_j input[j] w[j * 2 + i]
    fn matmul_rect_probe(index: usize) -> f64 {
        const input : [3]f64 = [1.0, 2.0, 3.0];
        const weights : [6]Trit = [Trit.pos, Trit.neg, Trit.zero, Trit.pos, Trit.neg, Trit.neg];
        var output : [2]f64 = [0.0, 0.0];
        ternary_matmul(&input, &weights, &output, 3, 2);
        return output[index];
    }

    fn residual_probe(index: usize) -> f64 {
        var output : [4]f64 = [5.0, 10.0, 15.0, 20.0];
        const input : [4]f64 = [2.0, 4.0, 6.0, 8.0];
        add_residual(&output, &input);
        return output[index];
    }

    // Element i of rope(e_k) for a unit vector e_k, with fresh tables
    fn rope_unit(position: usize, k: usize, i: usize) -> f64 {
        sacred_attention_init();
        fill(&p_vec, 0.0);
        p_vec[k] = 1.0;
        rope(&p_vec, position, false);
        return p_vec[i];
    }

    // |rope(x)|^2 - |x|^2 for a fixed x
    fn rope_norm_change(position: usize) -> f64 {
        sacred_attention_init();
        var before : f64 = 0.0;
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_vec[i] = small(i);
            before = before + p_vec[i] * p_vec[i];
            i = i + 1;
        }
        rope(&p_vec, position, false);
        var after : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            after = after + p_vec[i] * p_vec[i];
            i = i + 1;
        }
        return after - before;
    }

    // rope then its inverse: the largest deviation from the original
    fn rope_round_trip_gap(position: usize) -> f64 {
        sacred_attention_init();
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_vec[i] = small(i);
            i = i + 1;
        }
        rope(&p_vec, position, false);
        rope(&p_vec, position, true);
        var gap : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            gap = gap + @abs(p_vec[i] - small(i));
            i = i + 1;
        }
        return gap;
    }

    // How far x moved under rope at a position past the tables
    fn rope_out_of_range_gap() -> f64 {
        sacred_attention_init();
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_vec[i] = small(i);
            i = i + 1;
        }
        rope(&p_vec, CONTEXT_LEN, false);
        var gap : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            gap = gap + @abs(p_vec[i] - small(i));
            i = i + 1;
        }
        return gap;
    }

    // The largest |cos^2 + sin^2 - 1| over the whole table, and the entry at (0, 0)
    fn table_unit_gap() -> f64 {
        sacred_attention_init();
        var worst : f64 = 0.0;
        var n : usize = 0;
        while (n < CONTEXT_LEN * ROPE_PAIRS) {
            const e = @abs(rope_cos[n] * rope_cos[n] + rope_sin[n] * rope_sin[n] - 1.0);
            if (e > worst) {
                worst = e;
            }
            n = n + 1;
        }
        return worst;
    }

    fn table_cos_at(position: usize, pair: usize) -> f64 {
        sacred_attention_init();
        return rope_cos[position * ROPE_PAIRS + pair];
    }

    fn table_sin_at(position: usize, pair: usize) -> f64 {
        sacred_attention_init();
        return rope_sin[position * ROPE_PAIRS + pair];
    }

    // softmax of (1, 2, 3, 4) + offset in head 0's first four slots; all other
    // slots stay 0.0, so heads 1 and 2 are softmaxed over four zeros
    fn softmax_probe(offset: f64, head: usize, index: usize) -> f64 {
        fill(&p_scores, 0.0);
        p_scores[0] = 1.0 + offset;
        p_scores[1] = 2.0 + offset;
        p_scores[2] = 3.0 + offset;
        p_scores[3] = 4.0 + offset;
        apply_softmax(&p_scores, 4);
        return p_scores[head * CONTEXT_LEN + index];
    }

    fn softmax_row_sum(offset: f64, head: usize) -> f64 {
        const unused = softmax_probe(offset, head, 0);
        return p_scores[head * CONTEXT_LEN] + p_scores[head * CONTEXT_LEN + 1] + p_scores[head * CONTEXT_LEN + 2] + p_scores[head * CONTEXT_LEN + 3] + 0.0 * unused;
    }

    // Head 0: q = e_0, k_j = (j + 1) e_0 for j = 0..3. Position 1 sees j = 0, 1.
    // Scores, then softmax, over seq_len 4.
    fn causal_probe(index: usize) -> f64 {
        sacred_attention_init();
        fill(&p_vec, 0.0);
        p_vec[0] = 1.0;
        fill(&p_ck, 0.0);
        var j : usize = 0;
        while (j < 4) {
            p_ck[j * EMBED_DIM] = @as(f64, @floatFromInt(j + 1));
            j = j + 1;
        }
        fill(&p_scores, 0.0);
        compute_scores(&p_vec, 1, 4, &p_ck, &p_scores);
        apply_softmax(&p_scores, 4);
        return p_scores[index];
    }

    // Raw scores (before softmax): head 0 has q[0] = 2, k_0[0] = 3; head 2 has
    // q[2 * 81 + 5] = 1, k_0[2 * 81 + 5] = 4
    fn score_probe(head: usize, gain: f64) -> f64 {
        sacred_attention_init();
        set_qk_gain(gain);
        fill(&p_vec, 0.0);
        p_vec[0] = 2.0;
        p_vec[2 * HEAD_DIM + 5] = 1.0;
        fill(&p_ck, 0.0);
        p_ck[0] = 3.0;
        p_ck[2 * HEAD_DIM + 5] = 4.0;
        fill(&p_scores, 0.0);
        compute_scores(&p_vec, 0, 1, &p_ck, &p_scores);
        set_qk_gain(1.0);
        return p_scores[head * CONTEXT_LEN];
    }

    // Weights (0.25, 0.75) on two positions of head 1; v_0 = 4, v_1 = 8 at the
    // head's dim 3 -> 0.25 * 4 + 0.75 * 8 = 7
    fn weighted_probe(index: usize) -> f64 {
        fill(&p_scores, 0.0);
        p_scores[1 * CONTEXT_LEN] = 0.25;
        p_scores[1 * CONTEXT_LEN + 1] = 0.75;
        fill(&p_cv, 0.0);
        p_cv[HEAD_DIM + 3] = 4.0;
        p_cv[EMBED_DIM + HEAD_DIM + 3] = 8.0;
        fill(&p_concat, SENTINEL);
        weighted_values(&p_scores, 2, &p_cv, &p_concat);
        return p_concat[index];
    }

    // cache_kv at a position stores k and v at that row only
    fn cache_probe(which: u8, position: usize, index: usize) -> f64 {
        fill(&p_ck, 0.0);
        fill(&p_cv, 0.0);
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_vec[i] = @as(f64, @floatFromInt(i + 1));
            p_in[i] = 100.0 + @as(f64, @floatFromInt(i));
            i = i + 1;
        }
        cache_kv(&p_vec, &p_in, 2, &p_ck, &p_cv);
        if (which == 0) {
            return p_ck[position * EMBED_DIM + index];
        }
        return p_cv[position * EMBED_DIM + index];
    }

    // A position past the cache writes nothing and does not run off the end
    fn cache_out_of_range_sum() -> f64 {
        fill(&p_ck, 0.0);
        fill(&p_cv, 0.0);
        fill(&p_vec, 1.0);
        cache_kv(&p_vec, &p_vec, CONTEXT_LEN, &p_ck, &p_cv);
        var total : f64 = 0.0;
        var n : usize = 0;
        while (n < CONTEXT_LEN * EMBED_DIM) {
            total = total + p_ck[n] + p_cv[n];
            n = n + 1;
        }
        return total;
    }

    // Identity weights, position 0, one token: softmax over one position is 1,
    // context = v_0 = x, output = x + x. Returns sum |out - 2x|.
    fn kernel_one_position_gap() -> f64 {
        identity_setup(false);
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_in[i] = small(i);
            i = i + 1;
        }
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 0, 1, &p_out, &p_ck, &p_cv);
        var gap : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            gap = gap + @abs(p_out[i] - 2.0 * small(i));
            i = i + 1;
        }
        return gap;
    }

    // The same with Wo = -identity: output = x - context = 0
    fn kernel_negated_output_total() -> f64 {
        identity_setup(true);
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_in[i] = small(i);
            i = i + 1;
        }
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 0, 1, &p_out, &p_ck, &p_cv);
        var total : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            total = total + @abs(p_out[i]);
            i = i + 1;
        }
        return total;
    }

    // Two tokens, identity weights. x0 = 2 e_0 at position 0, x1 = 1.5 e_0 at
    // position 1 (rope angle 1 rad on the pair (0, 40)). Returns output[index]
    // of position 1.
    fn kernel_two_position(index: usize) -> f64 {
        identity_setup(false);
        fill(&p_in, 0.0);
        p_in[0] = 2.0;
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 0, 1, &p_out, &p_ck, &p_cv);
        fill(&p_in, 0.0);
        p_in[0] = 1.5;
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 1, 2, &p_out, &p_ck, &p_cv);
        return p_out[index];
    }

    // Closed form of kernel_two_position(0): s0 = 1.5 cos(1) 2 S, s1 = 2.25 S,
    // w1 = 1 / (1 + exp(s0 - s1)), out = (1 - w1) 2 + w1 1.5 + 1.5
    fn two_position_expected() -> f64 {
        const s0 = 1.5 * cos(1.0) * 2.0 * SACRED_SCALE;
        const s1 = 2.25 * SACRED_SCALE;
        const w1 = 1.0 / (1.0 + exp(s0 - s1));
        return (1.0 - w1) * 2.0 + w1 * 1.5 + 1.5;
    }

    // Position 0 with garbage in the cache rows 1 and 2: asking for seq_len 3
    // must give what seq_len 1 gives. Returns sum |difference|.
    fn kernel_future_gap() -> f64 {
        identity_setup(false);
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_in[i] = small(i);
            i = i + 1;
        }
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 0, 1, &p_out, &p_ck, &p_cv);
        fill(&p_vec, 0.0);
        i = 0;
        while (i < EMBED_DIM) {
            p_vec[i] = p_out[i];
            i = i + 1;
        }
        identity_setup(false);
        i = EMBED_DIM;
        while (i < 3 * EMBED_DIM) {
            p_ck[i] = 1000.0 + @as(f64, @floatFromInt(i));
            p_cv[i] = 0.0 - 500.0 - @as(f64, @floatFromInt(i));
            i = i + 1;
        }
        i = 0;
        while (i < EMBED_DIM) {
            p_in[i] = small(i);
            i = i + 1;
        }
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, 0, 3, &p_out, &p_ck, &p_cv);
        var gap : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            gap = gap + @abs(p_out[i] - p_vec[i]);
            i = i + 1;
        }
        return gap;
    }

    // A position past the cache: the output keeps its sentinel
    fn kernel_out_of_range_gap() -> f64 {
        identity_setup(false);
        var i : usize = 0;
        while (i < EMBED_DIM) {
            p_in[i] = small(i);
            i = i + 1;
        }
        sacred_attention_kernel(&p_in, &p_wq, &p_wk, &p_wv, &p_wo, CONTEXT_LEN, 1, &p_out, &p_ck, &p_cv);
        var gap : f64 = 0.0;
        i = 0;
        while (i < EMBED_DIM) {
            gap = gap + @abs(p_out[i] - SENTINEL);
            i = i + 1;
        }
        return gap;
    }

    // Head 1 and head 2 of a 2-position kernel run stay at their residual:
    // x has only dim 0 (head 0), so v is zero outside head 0
    fn kernel_other_heads_total() -> f64 {
        const unused = kernel_two_position(0);
        var total : f64 = 0.0;
        var i : usize = HEAD_DIM;
        while (i < EMBED_DIM) {
            total = total + @abs(p_out[i]);
            i = i + 1;
        }
        return total + 0.0 * unused;
    }

    // =================================================================
    // TDD-Inside-Spec: Tests and Invariants for SacredAttention
    // =================================================================

    // -- Constants --

    test attn_phi_squared_is_phi_plus_one
        given lhs = phi_squared()
        when rhs = phi_plus_one()
        then @abs(lhs - rhs) < 0.000000000001

    test attn_phi_squared_plus_inverse_is_three
        given total = phi_identity_total()
        then @abs(total - 3.0) < 0.000000000001

    test attn_gamma_is_phi_cubed_inverse
        given product = gamma_times_phi_cubed()
        when closed_form = sqrt_five_minus_two()
        then @abs(product - 1.0) < 0.000000000001 and @abs(gamma_value() - closed_form) < 0.000000000001

    test attn_sacred_scale_is_81_to_minus_gamma
        given expected = scale_from_gamma()
        when actual = scale_value()
        then @abs(actual - expected) < 0.000000000001

    // -- Ternary matmul --

    test attn_ternary_matmul_identity
        given a = matmul_probe(false, 0)
        when c = matmul_probe(false, 2)
        then a == 1.0 and matmul_probe(false, 1) == 2.0 and c == 3.0

    test attn_ternary_matmul_negation
        given a = matmul_probe(true, 0)
        then a == -6.0 and matmul_probe(true, 2) == -6.0

    // column 0: 1 - 3 = -2 (w = +1, 0, -1); column 1: -1 + 2 - 3 = -2
    test attn_ternary_matmul_row_major_layout
        given c0 = matmul_rect_probe(0)
        when c1 = matmul_rect_probe(1)
        then c0 == -2.0 and c1 == -2.0

    test attn_add_residual_adds_elementwise
        given a = residual_probe(0)
        when d = residual_probe(3)
        then a == 7.0 and residual_probe(1) == 14.0 and residual_probe(2) == 21.0 and d == 28.0

    // -- phi-RoPE --

    test attn_rope_is_identity_at_position_zero
        given same = rope_unit(0, 10, 10)
        when other = rope_unit(0, 10, 50)
        then same == 1.0 and other == 0.0

    // Pair (10, 50) at position 3: angle 3 phi^(-20/81); dims 80, 161 are unrotated
    test attn_rope_rotates_pair_i_with_i_plus_40
        given c = rope_unit(3, 10, 10)
        when s = rope_unit(3, 10, 50)
        then @abs(c + 0.8880621352130498) < 0.000000000001 and @abs(s - 0.4597234429533031) < 0.000000000001 and rope_unit(3, 80, 80) == 1.0 and rope_unit(3, 161, 161) == 1.0

    // Head 1 rotates the same pair indices inside its own 81 dims
    test attn_rope_rotates_every_head
        given head0 = rope_unit(3, 10, 50)
        when head1 = rope_unit(3, 81 + 10, 81 + 50)
        then @abs(head0 - head1) < 0.000000000001 and rope_unit(3, 81 + 10, 50) == 0.0

    test attn_rope_preserves_norm_and_inverts
        given change = rope_norm_change(19)
        when gap = rope_round_trip_gap(19)
        then @abs(change) < 0.000000001 and gap < 0.000000001

    test attn_rope_table_entries_are_unit_circle
        given worst = table_unit_gap()
        then worst < 0.000000000001

    // theta_0 = 1: the first pair turns 1 rad per position; pair 39 turns slowest
    test attn_rope_table_frequencies
        given c1 = table_cos_at(1, 0)
        when s2 = table_sin_at(2, 0)
        then @abs(c1 - cos(1.0)) < 0.000000000001 and @abs(s2 - sin(2.0)) < 0.000000000001 and table_cos_at(0, 39) == 1.0

    test attn_rope_past_the_tables_changes_nothing
        given gap = rope_out_of_range_gap()
        then gap == 0.0

    // -- Cache --

    test attn_cache_kv_stores_at_the_position_row
        given k = cache_probe(0, 2, 5)
        when v = cache_probe(1, 2, 5)
        then k == 6.0 and v == 105.0 and cache_probe(0, 1, 5) == 0.0 and cache_probe(1, 3, 5) == 0.0

    test attn_cache_kv_past_the_end_writes_nothing
        given total = cache_out_of_range_sum()
        then total == 0.0

    // -- Scores, mask, softmax --

    // Head 0: (2 e_0 . 3 e_0) S = 6 S; head 2 reads its own slice: 1 * 4 * S
    test attn_scores_are_scaled_dot_products_per_head
        given s0 = score_probe(0, 1.0)
        when s2 = score_probe(2, 1.0)
        then @abs(s0 - 6.0 * SACRED_SCALE) < 0.000000000001 and @abs(s2 - 4.0 * SACRED_SCALE) < 0.000000000001 and score_probe(1, 1.0) == 0.0

    // Q and K both carry the gain: the score picks up gain^2
    test attn_qk_gain_scales_scores_by_gain_squared
        given base = score_probe(0, 1.0)
        when scaled = score_probe(0, GAIN_PHI_SQ)
        then @abs(scaled / base - GAIN_PHI_SQ * GAIN_PHI_SQ) < 0.000000000001

    test attn_softmax_row_sums_to_one
        given h0 = softmax_row_sum(0.0, 0)
        when h2 = softmax_row_sum(0.0, 2)
        then @abs(h0 - 1.0) < 0.000000000001 and @abs(h2 - 1.0) < 0.000000000001

    // softmax(1, 2, 3, 4)[3] = 1 / (1 + e^-1 + e^-2 + e^-3); e^-1 apart in order
    test attn_softmax_values
        given top = softmax_probe(0.0, 0, 3)
        when ratio = softmax_probe(0.0, 0, 0) / softmax_probe(0.0, 0, 1)
        then @abs(top - 1.0 / (1.0 + exp(-1.0) + exp(-2.0) + exp(-3.0))) < 0.000000000001 and @abs(ratio - exp(-1.0)) < 0.000000000001

    test attn_softmax_of_equal_scores_is_uniform
        given w = softmax_probe(0.0, 1, 2)
        then @abs(w - 0.25) < 0.000000000001

    // exp(1004) overflows; subtracting the max keeps it finite and the same
    test attn_softmax_is_shift_invariant_and_stable
        given plain = softmax_probe(0.0, 0, 3)
        when shifted = softmax_probe(1000.0, 0, 3)
        then @abs(plain - shifted) < 0.000000000001 and shifted > 0.6 and shifted < 0.7

    // Position 1 sees keys 0 and 1 (scores S and 2 S); positions 2 and 3 are masked
    test attn_causal_mask_gives_future_zero_weight
        given w2 = causal_probe(2)
        when w3 = causal_probe(3)
        then w2 == 0.0 and w3 == 0.0

    test attn_causal_mask_leaves_a_distribution_on_the_past
        given w0 = causal_probe(0)
        when w1 = causal_probe(1)
        then @abs(w0 + w1 - 1.0) < 0.000000000001 and @abs(w1 / w0 - exp(SACRED_SCALE)) < 0.000000000001

    // -- Weighted values --

    test attn_weighted_values_mix_values_by_weight
        given mixed = weighted_probe(HEAD_DIM + 3)
        when other_head = weighted_probe(3)
        then @abs(mixed - 7.0) < 0.000000000001 and other_head == 0.0 and weighted_probe(HEAD_DIM + 4) == 0.0

    // -- Kernel --

    // Identity weights, one token: context = v_0 = x, output = x + x
    test attn_kernel_identity_one_position
        given gap = kernel_one_position_gap()
        then gap < 0.000000000001

    // Wo = -identity: output = x - context = 0, so Wo is applied
    test attn_kernel_applies_output_projection
        given total = kernel_negated_output_total()
        then total < 0.000000000001

    // Two tokens by hand: weights from scores 3 cos(1) S and 2.25 S, values unrotated
    test attn_kernel_two_positions_match_closed_form
        given out = kernel_two_position(0)
        when expected = two_position_expected()
        then @abs(out - expected) < 0.000000001 and @abs(kernel_two_position(40)) < 0.000000000001

    // V is not rotated and x has only dim 0, so every other head stays zero
    test attn_kernel_leaves_other_heads_alone
        given total = kernel_other_heads_total()
        then total < 0.000000000001

    // seq_len 3 at position 0 with a poisoned future must equal seq_len 1
    test attn_kernel_does_not_read_the_future
        given gap = kernel_future_gap()
        then gap < 0.000000000001

    test attn_kernel_past_the_cache_does_nothing
        given gap = kernel_out_of_range_gap()
        then gap == 0.0

    // -- QK-gain ablation (Phase B2) --

    test attn_gain_variants
        given phi_sq = get_qk_gain(QK_PHI_SQUARED)
        when standard = get_qk_gain(QK_STANDARD)
        then @abs(phi_sq - (PHI + 1.0)) < 0.000000000001 and standard == 1.0 and get_qk_gain(QK_LEARNED) == 1.0 and @abs(get_qk_gain(QK_SQRT_PHI) - sqrt(PHI)) < 0.000000000001 and get_qk_gain(99) == 1.0

    // 1 / sqrt(96), and phi^4 / sqrt(96) = 0.6995
    test attn_effective_score_scale
        given standard = effective_score_scale(GAIN_STANDARD, 96.0)
        when phi_sq = effective_score_scale(GAIN_PHI_SQ, 96.0)
        then @abs(standard - 1.0 / sqrt(96.0)) < 0.000000000001 and @abs(phi_sq * sqrt(96.0) - PHI * PHI * PHI * PHI) < 0.000000001 and phi_sq > 0.69 and phi_sq < 0.71

    test attn_phi_squared_gain_scales_more_than_standard
        given a = effective_score_scale(GAIN_PHI_SQ, 96.0)
        when b = effective_score_scale(GAIN_STANDARD, 96.0)
        then a > b and a / b > 6.8 and a / b < 6.9

    // -- Invariants --

    invariant attn_embed_dim_is_heads_times_head_dim
        assert EMBED_DIM == NUM_HEADS * HEAD_DIM

    invariant attn_head_dim_is_three_pow_four
        assert HEAD_DIM == 3 * 3 * 3 * 3

    invariant attn_rope_pairs_leave_one_dim
        assert 2 * ROPE_PAIRS + 1 == HEAD_DIM

    invariant attn_context_equals_head_dim
        assert CONTEXT_LEN == HEAD_DIM

    invariant attn_sacred_gamma_range
        assert SACRED_GAMMA > 0.2360679 and SACRED_GAMMA < 0.2360680

    invariant attn_sacred_scale_range
        assert SACRED_SCALE > 0.3543788 and SACRED_SCALE < 0.3543789

    invariant attn_mask_is_below_any_score
        assert MASK_SCORE < 0.0 - 1.0e20

    invariant attn_gain_variants_are_distinct
        assert GAIN_PHI_SQ != GAIN_STANDARD and GAIN_PHI_SQ != GAIN_SQRT_PHI and GAIN_STANDARD != GAIN_SQRT_PHI

    invariant attn_gain_variant_ids_are_unique
        assert QK_PHI_SQUARED != QK_STANDARD and QK_STANDARD != QK_LEARNED and QK_LEARNED != QK_SQRT_PHI and QK_PHI_SQUARED != QK_LEARNED and QK_PHI_SQUARED != QK_SQRT_PHI and QK_STANDARD != QK_SQRT_PHI
}
