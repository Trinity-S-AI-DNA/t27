// SPDX-License-Identifier: Apache-2.0
; specs/nn/hslm_tokenizer.t27 -- the HSLM byte-level BPE tokenizer: 729 tokens, 469 merges, in t27.
; Part of gHashTag/t27#10024 (our own model), cell 25 "t27c --backend ml"; issue #10372.

; SOURCE OF TRUTH: gHashTag/trinity-training @ 3e9648c1817a97c5f9b8c727b0f8e2291928eead
;   src/hslm/tokenizer.zig    Tokenizer.encode, Tokenizer.decode, the layout constants
;   src/hslm/bpe_merges.zig   merge_rules, merge_byte_lengths, merge_byte_data (469 rules, 1934 bytes)
; The four data tables below (MERGE_LEFT, MERGE_RIGHT, MERGE_LEN, MERGE_BYTES) were converted from
; bpe_merges.zig mechanically with sed and awk, nothing was retyped. MERGE_START is the running sum
; of MERGE_LEN, which tokenizer.zig computes at init (byte_offsets); here it is data too, and a test
; checks that it is that sum.

; THE VOCABULARY (729 = 3^6):
;     0..3      specials: PAD 0, BOS 1, EOS 2, UNK 3
;     4..259    the 256 byte values, token = byte + 4
;     260..728  469 merges, token = 260 + rule index; a rule joins two earlier tokens
; The rule list is the priority list: encode applies rule 0 to the whole sequence, then rule 1,
; and so on (tokenizer.zig: "lower merge index = higher priority"). That is a scan per rule, not a
; pair-frequency search, and it is what is ported.

; THE PORT IS EXACT, INCLUDING THE EDGES. encode(text, output) puts BOS first and EOS last and
; truncates the way the Zig does: the text is cut to max(len(output) - 2, 0) bytes and to the
; 8192-token merge window; the merged tokens are cut to leave room for the EOS. decode skips PAD,
; BOS and EOS, writes '?' for UNK, expands a merge token to its bytes, ignores a token >= 729, and
; stops writing when the output is full. The tests pin the ids that the Zig tokenizer returns for
; the same strings; those ids were produced by running tokenizer.zig itself (zig 0.16.0 on the
; Railway lab, a four-line main that calls Tokenizer.encode) and are copied here, not computed by
; this file.

; WHAT IS DIFFERENT FROM THE ZIG, so nobody reads this as more:
;   - The Zig builds a hash map merge_lookup at init and never reads it again; encode and decode
;     do not use it. It is not ported.
;   - Tokenizer.tokenToTrits and tritsToToken (the 6-trit view of an id) are not ported.
;   - encode_window is the Zig's steps 1 and 2 on their own (text bytes -> merged tokens, no BOS or
;     EOS), taking a caller-owned workspace; hslm_corpus uses it so that a story is not wrapped in
;     BOS and EOS. encode itself is the Zig function.
;   - No heap, no module state: every buffer is the caller's or a local.
; phi^2 + 1/phi^2 = 3 | TRINITY

module hslm_tokenizer;

pub const VOCAB_SIZE : u16 = 729;
pub const PAD_TOKEN : u16 = 0;
pub const BOS_TOKEN : u16 = 1;
pub const EOS_TOKEN : u16 = 2;
pub const UNK_TOKEN : u16 = 3;
pub const SPECIAL_COUNT : u16 = 4;
pub const BYTE_OFFSET : u16 = 4;
pub const BYTE_COUNT : u16 = 256;
pub const MERGE_OFFSET : u16 = 260;
pub const MERGE_COUNT : usize = 469;
pub const WORK_CAP : usize = 8192;

// MERGE_LEFT[i], MERGE_RIGHT[i]: the two tokens that merge i joins. MERGE_LEN[i]: how many bytes
// the new token stands for. MERGE_START[i]: where those bytes begin in MERGE_BYTES.

