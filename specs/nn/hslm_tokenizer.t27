/// Steps 1 and 2 of Tokenizer.encode: the first n bytes of text become byte tokens in work, then
/// each of the 469 rules is applied to the whole sequence in priority order, in place. Returns the
/// merged length. The caller guarantees n <= work.len and n <= text.len.
pub fn encode_window(text: []const u8, n: usize, work: []u16) -> usize {
    var i : usize = 0;
    while (i < n) {
        const b : u16 = @intCast(text[i]);
        work[i] = BYTE_OFFSET + b;
        i = i + 1;
    }
    var seq_len : usize = n;
    var rule : usize = 0;
    while (rule < MERGE_COUNT) {
        if (seq_len < 2) {
            return seq_len;
        }
        const left : u16 = MERGE_LEFT[rule];
        const right : u16 = MERGE_RIGHT[rule];
        const r16 : u16 = @intCast(rule);
        const new_token : u16 = MERGE_OFFSET + r16;
        var read_pos : usize = 0;
        var write_pos : usize = 0;
        while (read_pos < seq_len) {
            if (read_pos + 1 < seq_len and work[read_pos] == left and work[read_pos + 1] == right) {
                work[write_pos] = new_token;
                write_pos = write_pos + 1;
                read_pos = read_pos + 2;
            } else {
                work[write_pos] = work[read_pos];
                write_pos = write_pos + 1;
                read_pos = read_pos + 1;
            }
        }
        seq_len = write_pos;
        rule = rule + 1;
    }
    return seq_len;
}

/// Tokenizer.encode: BOS, the merged tokens of text, EOS, into output. Returns the count written.
/// A short output truncates exactly as the Zig does (see the header).
pub fn encode(text: []const u8, output: []u16) -> usize {
    var work : [8192]u16 = undefined;
    const max_out : usize = output.len;
    var out_idx : usize = 0;
    if (out_idx < max_out) {
        output[out_idx] = BOS_TOKEN;
        out_idx = out_idx + 1;
    }
    if (text.len == 0) {
        if (out_idx < max_out) {
            output[out_idx] = EOS_TOKEN;
            out_idx = out_idx + 1;
        }
        return out_idx;
    }
    var room : usize = 0;
    if (max_out > 2) {
        room = max_out - 2;
    }
    var work_len : usize = text.len;
    if (room < work_len) {
        work_len = room;
    }
    if (WORK_CAP < work_len) {
        work_len = WORK_CAP;
    }
    const seq_len : usize = encode_window(text, work_len, &work);
    var avail : usize = 0;
    if (max_out > out_idx + 1) {
        avail = max_out - out_idx - 1;
    }
    var copy_len : usize = seq_len;
    if (avail < copy_len) {
        copy_len = avail;
    }
    var c : usize = 0;
    while (c < copy_len) {
        output[out_idx + c] = work[c];
        c = c + 1;
    }
    out_idx = out_idx + copy_len;
    if (out_idx < max_out) {
        output[out_idx] = EOS_TOKEN;
        out_idx = out_idx + 1;
    }
    return out_idx;
}

/// Tokenizer.decode: token ids back to bytes in output. Returns the count written.
pub fn decode(tokens: []const u16, output: []u8) -> usize {
    var out_idx : usize = 0;
    var t : usize = 0;
    while (t < tokens.len) {
        const token : u16 = tokens[t];
        t = t + 1;
        // PAD, BOS and EOS (0, 1, 2) match no branch below and write nothing, as in the Zig.
        if (token == UNK_TOKEN) {
            if (out_idx < output.len) {
                output[out_idx] = 63;
                out_idx = out_idx + 1;
            }
        } else if (token >= MERGE_OFFSET and token < VOCAB_SIZE) {
            const idx : usize = @intCast(token - MERGE_OFFSET);
            const start : usize = @intCast(MERGE_START[idx]);
            const len : usize = @intCast(MERGE_LEN[idx]);
            const room : usize = output.len - out_idx;
            var copy_len : usize = len;
            if (room < copy_len) {
                copy_len = room;
            }
            var k : usize = 0;
            while (k < copy_len) {
                output[out_idx + k] = MERGE_BYTES[start + k];
                k = k + 1;
            }
            out_idx = out_idx + copy_len;
        } else if (token >= BYTE_OFFSET and token < MERGE_OFFSET) {
            if (out_idx < output.len) {
                output[out_idx] = @intCast(token - BYTE_OFFSET);
                out_idx = out_idx + 1;
            }
        }
    }
    return out_idx;
}

// ---- helpers for the tests -------------------------------------------------------------------

fn token_len(tok: usize) -> usize {
    if (tok < 260) {
        return 1;
    }
    return @intCast(MERGE_LEN[tok - 260]);
}

fn token_byte(tok: usize, j: usize) -> u8 {
    if (tok < 260) {
        return @intCast(tok - 4);
    }
    return MERGE_BYTES[@as(usize, @intCast(MERGE_START[tok - 260])) + j];
}

/// encode(text[0..n]) must be exactly want[0..k], and decode of it must give text[0..n] back.
fn encodes_to(text: []const u8, n: usize, want: []const u16, k: usize) -> bool {
    var out : [512]u16 = undefined;
    const got : usize = encode(text[0 .. n], &out);
    if (got != k) {
        return false;
    }
    var i : usize = 0;
    while (i < k) {
        if (out[i] != want[i]) {
            return false;
        }
        i = i + 1;
    }
    var back : [512]u8 = undefined;
    const m : usize = decode(out[0 .. got], &back);
    if (m != n) {
        return false;
    }
    var j : usize = 0;
    while (j < n) {
        if (back[j] != text[j]) {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// ---- tests: the ids the Zig tokenizer returns (BOS ... EOS) ----------------------------------

test zig_empty_text {
    const t : [1]u8 = [0];
    const want : [2]u16 = [1, 2];
    assert encodes_to(&t, 0, &want, 2);
}

test zig_one_byte {
    const t : [1]u8 = [97];
    const want : [3]u16 = [1, 101, 2];
    assert encodes_to(&t, 1, &want, 3);
}

test zig_once_upon_a_time {
    const t : [16]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101];
    const want : [4]u16 = [1, 463, 105, 2];
    assert encodes_to(&t, 16, &want, 4);
}

test zig_text_with_a_newline {
    const t : [43]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101, 44, 10, 116, 104, 101, 114, 101, 32, 119, 97, 115, 32, 97, 32, 108, 105, 116, 116, 108, 101, 32, 103, 105, 114, 108, 46, 10];
    const want : [11]u16 = [1, 463, 105, 48, 14, 464, 410, 504, 112, 292, 2];
    assert encodes_to(&t, 43, &want, 11);
}

test zig_non_ascii_utf8 {
    const t : [23]u8 = [99, 97, 102, 195, 169, 32, 226, 128, 156, 113, 117, 111, 116, 101, 100, 226, 128, 157, 32, 240, 159, 152, 128];
    const want : [22]u16 = [1, 472, 106, 199, 173, 36, 230, 132, 160, 683, 115, 120, 366, 230, 132, 161, 36, 244, 163, 156, 132, 2];
    assert encodes_to(&t, 23, &want, 22);
}

test zig_quick_brown_fox {
    const t : [19]u8 = [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110, 32, 102, 111, 120];
    const want : [12]u16 = [1, 427, 683, 109, 490, 102, 397, 507, 36, 660, 124, 2];
    assert encodes_to(&t, 19, &want, 12);
}

test zig_hello_world {
    const t : [13]u8 = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33];
    const want : [10]u16 = [1, 76, 653, 617, 91, 296, 112, 104, 37, 2];
    assert encodes_to(&t, 13, &want, 10);
}

test zig_repeated_word {
    const t : [11]u8 = [116, 104, 101, 32, 116, 104, 101, 32, 116, 104, 101];
    const want : [5]u16 = [1, 272, 272, 309, 2];
    assert encodes_to(&t, 11, &want, 5);
}

test zig_digits {
    const t : [10]u8 = [49, 50, 51, 52, 53, 54, 55, 56, 57, 48];
    const want : [12]u16 = [1, 53, 54, 55, 56, 57, 58, 59, 60, 61, 52, 2];
    assert encodes_to(&t, 10, &want, 12);
}

test zig_endoftext_marker {
    const t : [13]u8 = [60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62];
    const want : [3]u16 = [1, 390, 2];
    assert encodes_to(&t, 13, &want, 3);
}

test zig_lily_sentence {
    const t : [85]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101, 32, 116, 104, 101, 114, 101, 32, 119, 97, 115, 32, 97, 32, 108, 105, 116, 116, 108, 101, 32, 103, 105, 114, 108, 32, 110, 97, 109, 101, 100, 32, 76, 105, 108, 121, 46, 32, 83, 104, 101, 32, 108, 111, 118, 101, 100, 32, 116, 111, 32, 112, 108, 97, 121, 32, 105, 110, 32, 116, 104, 101, 32, 103, 97, 114, 100, 101, 110, 46];
    const want : [17]u16 = [1, 463, 260, 464, 644, 422, 713, 341, 618, 440, 418, 107, 286, 104, 276, 50, 2];
    assert encodes_to(&t, 85, &want, 17);
}

test zig_control_and_high_bytes {
    const t : [4]u8 = [0, 1, 255, 254];
    const want : [6]u16 = [1, 4, 5, 259, 258, 2];
    assert encodes_to(&t, 4, &want, 6);
}

test zig_overlapping_pairs {
    const t : [10]u8 = [97, 97, 97, 97, 32, 97, 97, 97, 97, 97];
    const want : [11]u16 = [1, 101, 101, 101, 101, 263, 101, 101, 101, 101, 2];
    assert encodes_to(&t, 10, &want, 11);
}

test zig_story_without_final_newline {
    const t : [42]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101, 44, 10, 116, 104, 101, 114, 101, 32, 119, 97, 115, 32, 97, 32, 108, 105, 116, 116, 108, 101, 32, 103, 105, 114, 108, 46];
    const want : [11]u16 = [1, 463, 105, 48, 14, 464, 410, 504, 112, 50, 2];
    assert encodes_to(&t, 42, &want, 11);
}

test zig_two_bytes {
    const t : [2]u8 = [104, 105];
    const want : [4]u16 = [1, 108, 109, 2];
    assert encodes_to(&t, 2, &want, 4);
}

test zig_three_bytes {
    const t : [3]u8 = [97, 98, 99];
    const want : [5]u16 = [1, 101, 102, 103, 2];
    assert encodes_to(&t, 3, &want, 5);
}

test zig_marker_inside_a_line {
    const t : [18]u8 = [120, 60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62, 10, 97, 98, 99];
    const want : [7]u16 = [1, 124, 391, 101, 102, 103, 2];
    assert encodes_to(&t, 18, &want, 7);
}

// ---- tests: edges of encode and decode, also from running the Zig ----------------------------

test a_short_output_truncates_like_the_zig {
    // Zig: encode("Once upon a time", out[6]) wrote 4 ids: only 4 bytes fit (6 - 2), "Once"
    const t : [16]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101];
    var small : [6]u16 = undefined;
    const n : usize = encode(&t, &small);
    assert n == 4;
    assert small[0] == 1 and small[1] == 328 and small[2] == 707 and small[3] == 2;
    // Zig: encode(..., out[2]) wrote BOS and EOS and no content
    var tiny : [2]u16 = undefined;
    const n2 : usize = encode(&t, &tiny);
    assert n2 == 2;
    assert tiny[0] == 1 and tiny[1] == 2;
}

test decode_edges_match_the_zig {
    // Zig: decode([0,1,2,3,4,5,259,260,728,729,1000,100]) wrote 9 bytes: 63 0 1 255 101 32 100 105 96
    // (UNK -> '?', byte tokens, two merge tokens, ids >= 729 ignored, specials silent)
    const toks : [12]u16 = [0, 1, 2, 3, 4, 5, 259, 260, 728, 729, 1000, 100];
    var out : [32]u8 = undefined;
    const m : usize = decode(&toks, &out);
    assert m == 9;
    assert out[0] == 63 and out[1] == 0 and out[2] == 1 and out[3] == 255;
    assert out[4] == 101 and out[5] == 32 and out[6] == 100 and out[7] == 105 and out[8] == 96;
}

test decode_into_a_short_buffer_stops_like_the_zig {
    // Zig: decode([463, 105]) into 3 bytes wrote 79 110 99 ("Onc"); into 5 bytes, 79 110 99 101 32
    const toks : [2]u16 = [463, 105];
    var three : [3]u8 = undefined;
    const a : usize = decode(&toks, &three);
    assert a == 3;
    assert three[0] == 79 and three[1] == 110 and three[2] == 99;
    var five : [5]u8 = undefined;
    const b : usize = decode(&toks, &five);
    assert b == 5;
    assert five[3] == 101 and five[4] == 32;
}

test encode_window_is_encode_without_bos_and_eos {
    const t : [16]u8 = [79, 110, 99, 101, 32, 117, 112, 111, 110, 32, 97, 32, 116, 105, 109, 101];
    var work : [64]u16 = undefined;
    const m : usize = encode_window(&t, 16, &work);
    assert m == 2;
    assert work[0] == 463 and work[1] == 105;
    // a prefix: the window is the first n bytes only
    const m2 : usize = encode_window(&t, 4, &work);
    assert m2 == 2;
    assert work[0] == 328 and work[1] == 707;
    const m0 : usize = encode_window(&t, 0, &work);
    assert m0 == 0;
}

test the_marker_text_is_one_token {
    // the merge table was trained on TinyStories, so "<|endoftext|>" is a single id (390)
    const t : [13]u8 = [60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62];
    var work : [16]u16 = undefined;
    const m : usize = encode_window(&t, 13, &work);
    assert m == 1;
    assert work[0] == 390;
}

// ---- tests: the vocabulary and the merge table itself ----------------------------------------

test the_layout_adds_up_to_729 {
    assert SPECIAL_COUNT == BYTE_OFFSET;
    assert BYTE_OFFSET + BYTE_COUNT == MERGE_OFFSET;
    assert @as(usize, @intCast(MERGE_OFFSET)) + MERGE_COUNT == @as(usize, @intCast(VOCAB_SIZE));
    assert VOCAB_SIZE == 729;
    assert MERGE_COUNT == 469;
}

test merge_start_is_the_running_sum_of_merge_len {
    assert MERGE_START[0] == 0;
    var i : usize = 0;
    var bad : i32 = 0;
    while (i < 468) {
        const s : u16 = MERGE_START[i];
        const l : u16 = @intCast(MERGE_LEN[i]);
        if (MERGE_START[i + 1] != s + l) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert bad == 0;
    // 1934 bytes in all (bpe_merges.zig: merge_byte_data: [1934]u8)
    assert @as(usize, @intCast(MERGE_START[468])) + @as(usize, @intCast(MERGE_LEN[468])) == 1934;
}

test every_rule_joins_two_earlier_tokens {
    // an operand that is a special, or a merge made later, could never fire
    var i : usize = 0;
    var bad : i32 = 0;
    while (i < 469) {
        const l : usize = @intCast(MERGE_LEFT[i]);
        const r : usize = @intCast(MERGE_RIGHT[i]);
        if (l < 4 or r < 4 or l >= 260 + i or r >= 260 + i) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    assert bad == 0;
}

test every_rule_spells_the_bytes_of_its_two_halves {
    var i : usize = 0;
    var bad : i32 = 0;
    while (i < 469) {
        const l : usize = @intCast(MERGE_LEFT[i]);
        const r : usize = @intCast(MERGE_RIGHT[i]);
        const ll : usize = token_len(l);
        const rl : usize = token_len(r);
        if (ll + rl != token_len(260 + i)) {
            bad = bad + 1;
        } else {
            var j : usize = 0;
            while (j < ll) {
                if (token_byte(260 + i, j) != token_byte(l, j)) {
                    bad = bad + 1;
                }
                j = j + 1;
            }
            var k : usize = 0;
            while (k < rl) {
                if (token_byte(260 + i, ll + k) != token_byte(r, k)) {
                    bad = bad + 1;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    assert bad == 0;
}

test every_token_decodes_to_its_bytes {
    var tok : usize = 4;
    var bad : i32 = 0;
    while (tok < 729) {
        var one : [1]u16 = undefined;
        one[0] = @intCast(tok);
        var out : [64]u8 = undefined;
        const m : usize = decode(&one, &out);
        if (m != token_len(tok)) {
            bad = bad + 1;
        } else {
            var j : usize = 0;
            while (j < m) {
                if (out[j] != token_byte(tok, j)) {
                    bad = bad + 1;
                }
                j = j + 1;
            }
        }
        tok = tok + 1;
    }
    assert bad == 0;
}

test every_byte_value_survives_a_round_trip {
    var text : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        text[i] = @intCast(i);
        i = i + 1;
    }
    var out : [300]u16 = undefined;
    const n : usize = encode(&text, &out);
    var back : [300]u8 = undefined;
    const m : usize = decode(out[0 .. n], &back);
    assert m == 256;
    var j : usize = 0;
    var bad : i32 = 0;
    while (j < 256) {
        if (back[j] != text[j]) {
            bad = bad + 1;
        }
        j = j + 1;
    }
    assert bad == 0;
}

test the_comparison_can_fail {
    // encodes_to must say no to a wrong id, a wrong length and a wrong byte count
    const t : [3]u8 = [97, 98, 99];
    const right : [5]u16 = [1, 101, 102, 103, 2];
    assert encodes_to(&t, 3, &right, 5);
    const wrong : [5]u16 = [1, 101, 102, 104, 2];
    assert !encodes_to(&t, 3, &wrong, 5);
    assert !encodes_to(&t, 3, &right, 4);
    assert !encodes_to(&t, 2, &right, 5);
}
