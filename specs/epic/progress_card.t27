// SPDX-License-Identifier: Apache-2.0
// specs/epic/progress_card.t27 -- Epic progress card: one .t27 format, one
// post per epic with percent, breakthroughs and blockers.
// Part of M5 milestone (milestone #9). Closes #12631.
// phi^2 + 1/phi^2 = 3 | TRINITY

module epic::progress_card;

pub const PROGRESS_CARD_MAX_BLOCKERS : u32 = 10;

pub struct ProgressCard { epic_id: str, percent: u32, breakthroughs: str, blockers: str };

pub fn progress_card_percent(c: ProgressCard) -> u32 {
    return c.percent;
}

pub fn progress_card_complete(c: ProgressCard) -> bool {
    return c.percent == 100;
}

test "progress_card_percent" {
    var c = ProgressCard { epic_id: "epic-1", percent: 42, breakthroughs: "none", blockers: "none" };
    assert(progress_card_percent(c) == 42);
}

test "progress_card_complete" {
    var complete = ProgressCard { epic_id: "epic-1", percent: 100, breakthroughs: "done", blockers: "none" };
    assert(progress_card_complete(complete));
    var incomplete = ProgressCard { epic_id: "epic-2", percent: 50, breakthroughs: "some", blockers: "one" };
    assert(!progress_card_complete(incomplete));
}

invariant progress_card_max_blockers_positive {
    assert PROGRESS_CARD_MAX_BLOCKERS > 0;
}