; t27-ci-generator-v1 - CI Workflow Generator from .t27 Specs
; Version: 1.0.0
; phi^2 + 1/phi^2 = 3 | TRINITY
; INPUT:  specs/ci/*.t27  (all CI workflow contract specifications)
; OUTPUT: .github/workflows/*.yml  (generated GitHub Actions workflows)
; PURPOSE: Deterministic conversion of contracts-first .t27 CI specs to GitHub Actions YAML
; SEALS / GATES: generator must pass seal validation and gate checks
; LAW: L7 - UNITY: No new *.sh on critical path; use tri/t27c
; LAW: L3 - PURITY: Source files must be ASCII-only with English identifiers
; LAW: L2 - GENERATION: Files under gen/ are generated; edit specs instead

module t27_ci_generator_v1;

; ========== GENERATOR METADATA ==========
pub const GENERATOR_NAME : str = "t27-ci-generator-v1";
pub const GENERATOR_VERSION : str = "1.0.0";
pub const GENERATOR_KIND : str = "ci-generator";
pub const DESCRIPTION : str = "Deterministic generator of .github/workflows/*.yml from specs/ci/*.t27 contracts";

; ========== INPUT / OUTPUT PATHS ==========
pub const INPUT_SPEC_DIR : str = "specs/ci";
pub const OUTPUT_WORKFLOW_DIR : str = ".github/workflows";
pub const SCHEMA_SPEC : str = "specs/ci/schema.t27";

; ========== GENERATION CONTRACTS ==========
pub const GENERATE_DETERMINISTIC : bool = true;
pub const GENERATE_VERSIONED : bool = true;
pub const SEAL_GATE_VALIDATED : bool = true;
pub const NO_MANUAL_YML_EDITS : bool = true;

; ========== GENERATION RULES ==========
; Each .t27 spec in specs/ci/ maps to one .yml in .github/workflows/
; Mapping: WORKFLOW_ID -> workflow filename
; Mapping: JOB_* constants -> job definitions
; Mapping: TRIGGER_* constants -> on: section
; Mapping: PATH constants -> on.paths configuration

; ========== SEAL / GATE DEFINITIONS ==========
pub const SEALS_REQUIRED : bool = true;
pub const GATE_REQUIRED : bool = true;
pub const GENERATOR_SEAL : str = "t27-ci-generator-v1-seal";
pub const GATE_GREEN : str = "green";
; all conditions met, generation approved
pub const GATE_RED : str = "red";
; generation blocked - seal/gate failure
pub const GATE_YELLOW : str = "yellow";
; caution - warnings in generation

; ========== ERROR CONDITIONS ==========
pub const ERROR_SPEC_PARSE : str = "SPEC_PARSE_ERROR";
pub const ERROR_PATH_COLLISION : str = "PATH_COLLISION";
pub const ERROR_SEAL_FAILED : str = "SEAL_FAILED";
pub const ERROR_GATE_FAILED : str = "GATE_FAILED";
pub const ERROR_UNEXPECTED : str = "UNEXPECTED_ERROR";

; ========== LIFECYCLE ==========
pub const LIFECYCLE_PHASES : [4]str = [
    "init"
; parse .t27 specs
    "generate"
; produce .yml artifacts
    "validate"
; seal/gate validation
    "complete"
; output ready

pub const CURRENT_PHASE : str = "init";
; set by DSH at runtime

; ========== CONTRACT REFERENCES ==========
pub const CONTRACT_SCHEMA : str = "specs/ci/schema.t27";
pub const CONTRACT_T27B : str = "t27b";
; host adapter for generation
pub const CONTRACT_T27C : str = "t27c";
; compiler/verifier for generated output

; ========== PHASE TRANSITIONS ==========
; Phase: init -> generate  when all .t27 specs are parsed successfully
; Phase: generate -> validate  when all .yml files are produced
; Phase: validate -> complete  when seals and gates pass
; Phase: complete -> init  when regeneration is needed (version bump)

; ========== SUBAGENT REFERENCES ==========
pub const SUBAGENT_PARSER : str = "ci-spec-parser";
pub const SUBAGENT_GENERATOR : str = "ci-workflow-generator";
pub const SUBAGENT_VALIDATOR : str = "ci-gate-validator";

; ========== VERSION TRACKING ==========
pub const GENERATION_COUNT : i64 = 0;
; incremented each successful generation run
pub const LAST_GENERATION : str = "never";
; timestamp of last generation; validation test comment
