// SPDX-License-Identifier: Apache-2.0
// specs/ci/pr_ready.t27 -- REQUIRED_CHECKS_V1: one aggregate check that always terminates.
// The host workflow is .github/workflows/pr-ready.yml; this spec is the law it implements.
// phi^2 + 1/phi^2 = 3 | TRINITY

module CiPrReady;

pub const KIND : str = "ci";
pub const ID : str = "t27/ci/pr-ready";
pub const NAME : str = "PR ready aggregate gate";
pub const SUMMARY_EN : str = "One check name pr-ready always finishes success, failure, or skipped; required master checks must be concluded, never pending or absent.";
pub const ENABLED : bool = true;

pub const WORKFLOW_PATH : str = ".github/workflows/gate-topology.yml";
pub const WORKFLOW_JOB : str = "pr-ready";
pub const REQUIRED_CHECK_NAME : str = "pr-ready";

// Master ruleset contexts today (2026-11-09); migration may collapse to pr-ready only.
pub const REQ_VALIDATE : str = "validate";
pub const REQ_ISSUE : str = "check-linked-issue";
pub const REQ_PARSE : str = "parse-ratchet";
pub const REQ_OWN : str = "own-language";
pub const REQ_COUNT : u8 = 4;

// Terminal conclusions GitHub may post on the latest SHA.
pub const C_SUCCESS : u8 = 0;
pub const C_SKIPPED : u8 = 1;
pub const C_NEUTRAL : u8 = 2;
pub const C_FAILURE : u8 = 3;
pub const C_PENDING : u8 = 4;
pub const C_MISSING : u8 = 5;

pub fn conclusion_ok(c: u8) -> bool {
    return c == C_SUCCESS or c == C_SKIPPED or c == C_NEUTRAL;
}

pub fn conclusion_blocks_merge(c: u8) -> bool {
  return c == C_FAILURE or c == C_PENDING or c == C_MISSING;
}

test terminal_ok_vs_block {
    assert conclusion_ok(C_SUCCESS);
    assert conclusion_ok(C_SKIPPED);
    assert conclusion_ok(C_NEUTRAL);
    assert conclusion_ok(C_FAILURE) == false;
    assert conclusion_blocks_merge(C_PENDING);
    assert conclusion_blocks_merge(C_MISSING);
}

/// Aggregate verdict for the four required contexts on one head.
pub const V_PASS : u8 = 0;
pub const V_BLOCKED : u8 = 1;
pub const V_FAIL : u8 = 2;
pub const V_SKIP : u8 = 3;

pub fn aggregate_verdict(pending: u32, missing: u32, bad: u32, not_pr: bool) -> u8 {
    if (not_pr) { return V_SKIP; }
    if (pending > 0 or missing > 0) { return V_BLOCKED; }
    if (bad > 0) { return V_FAIL; }
    return V_PASS;
}

test aggregate_blocks_on_pending_or_missing {
    assert aggregate_verdict(1, 0, 0, false) == V_BLOCKED;
    assert aggregate_verdict(0, 1, 0, false) == V_BLOCKED;
    assert aggregate_verdict(0, 0, 2, false) == V_FAIL;
    assert aggregate_verdict(0, 0, 0, false) == V_PASS;
    assert aggregate_verdict(0, 0, 0, true) == V_SKIP;
}

/// Path filters on a required job are forbidden: they create permanent pending.
pub fn path_filter_forbidden(on_required: bool, has_path_filter: bool) -> bool {
    return on_required and has_path_filter;
}

test required_job_must_not_filter_paths {
    assert path_filter_forbidden(true, true);
    assert path_filter_forbidden(true, false) == false;
    assert path_filter_forbidden(false, true) == false;
}

test counts_match_ruleset {
    assert REQ_COUNT == 4;
}
