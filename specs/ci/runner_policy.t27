// SPDX-License-Identifier: Apache-2.0
; specs/ci/runner_policy.t27 -- CI runner policy: where a job runs, what it may read, how a red is named.
; Measured 2026-11-08 10:05Z with read-only gh queries. Org Trinity-S-AI-DNA: t27 and 22 other repos are
; PUBLIC, so standard GitHub-hosted runners are free there and t27 runs start and finish (nothing queued).
; The billing block hits only PRIVATE repos (tri-claw-concierge: 4 open PRs, jobs with 0 steps;
; igla-coder-gpu since 2026-10-04). Job annotation text:
;   "The job was not started because recent account payments have failed or your spending limit needs to be increased."
; A different red in t27 (Queen Export Push) reads
;   "could not read Username for 'https://github.com': terminal prompts disabled"
; which is an expired push token, NOT billing. The two must never be confused (cr_classify).
; t27 workflows use 83x ubuntu-latest, 14x ubuntu-24.04, 1x ubuntu-24.04-arm, 1x ubuntu-22.04, 2x matrix.os;
; zero self-hosted today.
; -
; The swap gate for a self-hosted run is the T27D gate (LJ_MAX_SWAP_MB, imported, never copied).
; The CR_EV_* codes (section 9) are T27L actions 108..122 on surface "ci" (specs/t27os/t27l.t27); test
; event_codes_are_t27l_actions pins the offset, so a rename on either side turns red.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CiRunnerPolicy;

use queen::lab_job_msg::LJ_MAX_SWAP_MB;
use t27os::t27l::tl_action_id;
use std::mem::bytes_eq;

; --- 1. Repo class and trigger trust ---

/// Repo class. Hosted runners are free on PUBLIC repos and billed on PRIVATE ones.
pub const CR_REPO_PUBLIC : u8 = 1;
pub const CR_REPO_PRIVATE : u8 = 2;

pub fn cr_repo_class(is_public: bool) -> u8 {
    if (is_public) { return CR_REPO_PUBLIC; }
    return CR_REPO_PRIVATE;
}

/// Trigger kinds. TRUSTED: push to own branch, same-repo PR, workflow_dispatch, schedule by a member.
/// UNTRUSTED: fork PR, unknown author.
pub const CR_TRG_PUSH_OWN : u8 = 1;
pub const CR_TRG_PR_SAME_REPO : u8 = 2;
pub const CR_TRG_DISPATCH : u8 = 3;
pub const CR_TRG_SCHEDULE_MEMBER : u8 = 4;
pub const CR_TRG_PR_FORK : u8 = 5;
pub const CR_TRG_UNKNOWN : u8 = 6;

/// Fail closed: any unknown kind code is untrusted.
pub fn cr_trigger_trusted(kind: u8) -> bool {
    return kind >= CR_TRG_PUSH_OWN and kind <= CR_TRG_SCHEDULE_MEMBER;
}

; --- 2. Routing ---

pub const CR_ROUTE_SELF : u8 = 1;
pub const CR_ROUTE_HOSTED : u8 = 2;
pub const CR_ROUTE_LOCAL_ONLY : u8 = 3;
pub const CR_ROUTE_REFUSE : u8 = 4;

/// Where a job runs. Untrusted never goes self-hosted. A public repo with hosted runners usable goes hosted
/// (free). Otherwise a trusted job may use an online self-hosted runner while swap is below the T27D gate;
/// at or above the gate self-hosted is refused (hosted if usable, else REFUSE). No runner and no hosted: LOCAL_ONLY.
pub fn cr_route(repo_public: bool, trusted: bool, runner_online: bool, hosted_ok: bool, swap_mb: u64) -> u8 {
    if (!trusted) {
        if (hosted_ok) { return CR_ROUTE_HOSTED; }
        return CR_ROUTE_LOCAL_ONLY;
    }
    if (repo_public and hosted_ok) { return CR_ROUTE_HOSTED; }
    if (runner_online and swap_mb < LJ_MAX_SWAP_MB) { return CR_ROUTE_SELF; }
    if (hosted_ok) { return CR_ROUTE_HOSTED; }
    if (runner_online) { return CR_ROUTE_REFUSE; }
    return CR_ROUTE_LOCAL_ONLY;
}

; --- 3. Runner labels ---

/// True when the byte range of hay at `at` equals needle.
pub fn cr_match_at(hay: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i < needle.len) {
        if (hay[at + i] != needle[i]) { return false; }
        i += 1;
    }
    return true;
}

/// True when label is one whole comma-separated item of csv.
pub fn cr_has_label(csv: []const u8, label: []const u8) -> bool {
    if (label.len == 0) { return false; }
    var i : usize = 0;
    while (i + label.len <= csv.len) {
        if (cr_match_at(csv, i, label)) {
            const end : usize = i + label.len;
            const left_ok : bool = i == 0 or csv[i - 1] == 44;
            const right_ok : bool = end == csv.len or csv[end] == 44;
            if (left_ok and right_ok) { return true; }
        }
        i += 1;
    }
    return false;
}

/// A self-hosted job needs all three labels: self-hosted, t27-mac and trusted.
pub fn cr_labels_ok(csv: []const u8) -> bool {
    return cr_has_label(csv, "self-hosted") and cr_has_label(csv, "t27-mac") and cr_has_label(csv, "trusted");
}

; --- 4. Secrets ---

/// ASCII lower case of one byte.
pub fn cr_lc(b: u8) -> u8 {
    if (b >= 65 and b <= 90) { return b + 32; }
    return b;
}

/// Case-insensitive substring test; needle must already be lower case.
pub fn cr_contains_fold(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var j : usize = 0;
        var same : bool = true;
        while (j < needle.len) {
            if (cr_lc(hay[i + j]) != needle[j]) { same = false; }
            j += 1;
        }
        if (same) { return true; }
        i += 1;
    }
    return false;
}

/// A self-hosted job never sees a secret whose name holds one of these words.
pub fn cr_secret_name_dangerous(name: []const u8) -> bool {
    if (cr_contains_fold(name, "prod")) { return true; }
    if (cr_contains_fold(name, "live")) { return true; }
    if (cr_contains_fold(name, "deploy")) { return true; }
    if (cr_contains_fold(name, "railway")) { return true; }
    if (cr_contains_fold(name, "npm")) { return true; }
    if (cr_contains_fold(name, "pypi")) { return true; }
    if (cr_contains_fold(name, "cargo_registry")) { return true; }
    return false;
}

/// Untrusted jobs get zero secrets; a self-hosted job gets none of the dangerous names.
pub fn cr_secret_allowed(trusted: bool, self_hosted: bool, name: []const u8) -> bool {
    if (!trusted) { return false; }
    if (self_hosted and cr_secret_name_dangerous(name)) { return false; }
    return true;
}

; --- 5. Failure classes ---

pub const CR_FAIL_CODE : u8 = 1;
pub const CR_FAIL_BILLING : u8 = 2;
pub const CR_FAIL_AUTH : u8 = 3;

/// Name a red. Billing needs zero steps AND the annotation text; auth is its own class and is checked on the
/// text alone, so an expired token is never read as billing.
pub fn cr_classify(steps: u32, annotation: []const u8) -> u8 {
    if (cr_contains_fold(annotation, "could not read username")) { return CR_FAIL_AUTH; }
    if (cr_contains_fold(annotation, "terminal prompts disabled")) { return CR_FAIL_AUTH; }
    if (steps == 0) {
        if (cr_contains_fold(annotation, "payments have failed")) { return CR_FAIL_BILLING; }
        if (cr_contains_fold(annotation, "spending limit")) { return CR_FAIL_BILLING; }
    }
    return CR_FAIL_CODE;
}

; --- 6. Required checks and retry ---

/// A required check that did not run is NOT green. No silent skip.
pub fn cr_required_green(ran: bool, passed: bool) -> bool {
    return ran and passed;
}

pub const CR_RETRY_MAX : u32 = 3;

/// attempt counts from 1 for the first run; a retry is allowed while the attempt number is below the cap.
pub fn cr_may_retry(attempt: u32) -> bool {
    return attempt < CR_RETRY_MAX;
}

; --- 7. act is never final ---

pub const CR_SOURCE_HOSTED : u8 = 1;
pub const CR_SOURCE_SELF : u8 = 2;
pub const CR_SOURCE_ACT : u8 = 3;

/// act is a local rehearsal. Only a hosted or self-hosted run can be the final verdict.
pub fn cr_final_ok(source: u8, passed: bool) -> bool {
    if (source == CR_SOURCE_ACT) { return false; }
    if (source != CR_SOURCE_HOSTED and source != CR_SOURCE_SELF) { return false; }
    return passed;
}

; --- 8. Content-addressed cache key ---

/// Lower-case hex digit of a value below 16.
pub fn cr_digit(n: u64) -> u8 {
    if (n < 10) { return @intCast(48 + n); }
    return @intCast(87 + n);
}

/// Write 16 hex digits of v at `at`, last digit first; returns the position after them.
pub fn cr_hex16(out: []u8, at: usize, v: u64) -> usize {
    var x : u64 = v;
    var k : usize = 16;
    while (k > 0) {
        out[at + k - 1] = cr_digit(x % 16);
        x = x / 16;
        k -= 1;
    }
    return at + 16;
}

/// Write t27-<os>-<16 hex toolchain>-<16 hex lockfile> into out; returns its length, 0 when out is too small.
pub fn cr_cache_key(out: []u8, os_tag: []const u8, toolchain_hash: u64, lockfile_hash: u64) -> usize {
    const total : usize = 4 + os_tag.len + 1 + 16 + 1 + 16;
    if (out.len < total) { return 0; }
    out[0] = 116;
    out[1] = 50;
    out[2] = 55;
    out[3] = 45;
    var at : usize = 4;
    var i : usize = 0;
    while (i < os_tag.len) {
        out[at] = os_tag[i];
        at += 1;
        i += 1;
    }
    out[at] = 45;
    at = cr_hex16(out, at + 1, toolchain_hash);
    out[at] = 45;
    at = cr_hex16(out, at + 1, lockfile_hash);
    return at;
}

; --- 9. Billing fallback ---

/// Billing never blocks local development, whatever the account state.
pub fn cr_local_dev_blocked(billing_blocked: bool) -> bool {
    if (billing_blocked) { return false; }
    return false;
}

pub const CR_PR_WAITING : u8 = 1;
pub const CR_PR_FAILED : u8 = 2;

/// A PR whose CI was blocked by billing is WAITING, not FAILED; every other failure class is FAILED.
pub fn cr_pr_state(fail_class: u8) -> u8 {
    if (fail_class == CR_FAIL_BILLING) { return CR_PR_WAITING; }
    return CR_PR_FAILED;
}

; --- 10. CI event names (the T27L surface for these is added by the orchestrator) ---

pub const CR_EV_BILLING_STATUS_CHECKED : u8 = 1;
pub const CR_EV_RUNNER_REGISTERED : u8 = 2;
pub const CR_EV_RUNNER_STARTED : u8 = 3;
pub const CR_EV_RUNNER_STOPPED : u8 = 4;
pub const CR_EV_RUNNER_OFFLINE : u8 = 5;
pub const CR_EV_WORKFLOW_DISPATCHED : u8 = 6;
pub const CR_EV_WORKFLOW_COMPLETED : u8 = 7;
pub const CR_EV_WORKFLOW_FAILED : u8 = 8;
pub const CR_EV_CACHE_HIT : u8 = 9;
pub const CR_EV_CACHE_MISS : u8 = 10;
pub const CR_EV_CACHE_INVALIDATED : u8 = 11;
pub const CR_EV_ACT_RUN_STARTED : u8 = 12;
pub const CR_EV_ACT_RUN_COMPLETED : u8 = 13;
pub const CR_EV_SECRET_ACCESS_DENIED : u8 = 14;
pub const CR_EV_UNTRUSTED_PR_BLOCKED : u8 = 15;

pub fn cr_ev_name(code: u8) -> []const u8 {
    if (code == CR_EV_BILLING_STATUS_CHECKED) { return "billing_status_checked"; }
    if (code == CR_EV_RUNNER_REGISTERED) { return "runner_registered"; }
    if (code == CR_EV_RUNNER_STARTED) { return "runner_started"; }
    if (code == CR_EV_RUNNER_STOPPED) { return "runner_stopped"; }
    if (code == CR_EV_RUNNER_OFFLINE) { return "runner_offline"; }
    if (code == CR_EV_WORKFLOW_DISPATCHED) { return "workflow_dispatched"; }
    if (code == CR_EV_WORKFLOW_COMPLETED) { return "workflow_completed"; }
    if (code == CR_EV_WORKFLOW_FAILED) { return "workflow_failed"; }
    if (code == CR_EV_CACHE_HIT) { return "cache_hit"; }
    if (code == CR_EV_CACHE_MISS) { return "cache_miss"; }
    if (code == CR_EV_CACHE_INVALIDATED) { return "cache_invalidated"; }
    if (code == CR_EV_ACT_RUN_STARTED) { return "act_run_started"; }
    if (code == CR_EV_ACT_RUN_COMPLETED) { return "act_run_completed"; }
    if (code == CR_EV_SECRET_ACCESS_DENIED) { return "secret_access_denied"; }
    if (code == CR_EV_UNTRUSTED_PR_BLOCKED) { return "untrusted_pr_blocked"; }
    return "unknown";
}

; --- Tests ---

test repo_and_trust {
    assert cr_repo_class(true) == CR_REPO_PUBLIC;
    assert cr_repo_class(false) == CR_REPO_PRIVATE;
    assert cr_trigger_trusted(CR_TRG_PUSH_OWN);
    assert cr_trigger_trusted(CR_TRG_PR_SAME_REPO);
    assert cr_trigger_trusted(CR_TRG_DISPATCH);
    assert cr_trigger_trusted(CR_TRG_SCHEDULE_MEMBER);
    assert !cr_trigger_trusted(CR_TRG_PR_FORK);
    assert !cr_trigger_trusted(CR_TRG_UNKNOWN);
    assert !cr_trigger_trusted(0);
    assert !cr_trigger_trusted(99);
}

test route_untrusted {
    assert cr_route(false, false, true, true, 0) == CR_ROUTE_HOSTED;
    assert cr_route(false, false, true, false, 0) == CR_ROUTE_LOCAL_ONLY;
    assert cr_route(true, false, true, false, 0) == CR_ROUTE_LOCAL_ONLY;
    assert cr_route(true, false, true, true, 0) != CR_ROUTE_SELF;
}

test route_public_free {
    assert cr_route(true, true, true, true, 0) == CR_ROUTE_HOSTED;
    assert cr_route(true, true, false, true, 0) == CR_ROUTE_HOSTED;
}

test route_private_self {
    assert cr_route(false, true, true, false, 0) == CR_ROUTE_SELF;
    assert cr_route(false, true, true, true, 100) == CR_ROUTE_SELF;
    assert cr_route(false, true, false, false, 0) == CR_ROUTE_LOCAL_ONLY;
    assert cr_route(false, true, false, true, 0) == CR_ROUTE_HOSTED;
}

test route_swap_gate {
    assert cr_route(false, true, true, false, LJ_MAX_SWAP_MB - 1) == CR_ROUTE_SELF;
    assert cr_route(false, true, true, false, LJ_MAX_SWAP_MB) == CR_ROUTE_REFUSE;
    assert cr_route(false, true, true, true, LJ_MAX_SWAP_MB) == CR_ROUTE_HOSTED;
    assert cr_route(true, true, true, false, LJ_MAX_SWAP_MB + 5000) == CR_ROUTE_REFUSE;
}

test labels {
    assert cr_labels_ok("self-hosted,t27-mac,trusted");
    assert cr_labels_ok("trusted,macOS,t27-mac,self-hosted");
    assert !cr_labels_ok("self-hosted");
    assert !cr_labels_ok("self-hosted,macOS,ARM64");
    assert !cr_labels_ok("self-hosted,t27-mac");
    assert !cr_labels_ok("self-hosted,t27-mac,untrusted");
    assert !cr_labels_ok("t27-mac,trusted");
    assert !cr_labels_ok("");
}

test secrets {
    assert !cr_secret_allowed(false, false, "CI_TOKEN");
    assert !cr_secret_allowed(false, true, "CI_TOKEN");
    assert cr_secret_allowed(true, false, "CI_TOKEN");
    assert cr_secret_allowed(true, true, "CI_TOKEN");
    assert cr_secret_allowed(true, false, "RAILWAY_TOKEN");
    assert !cr_secret_allowed(true, true, "RAILWAY_TOKEN");
    assert !cr_secret_allowed(true, true, "PROD_DB");
    assert !cr_secret_allowed(true, true, "live_key");
    assert !cr_secret_allowed(true, true, "Deploy_Key");
    assert !cr_secret_allowed(true, true, "NPM_TOKEN");
    assert !cr_secret_allowed(true, true, "pypi_upload");
    assert !cr_secret_allowed(true, true, "CARGO_REGISTRY_TOKEN");
}

test classify {
    assert cr_classify(0, "The job was not started because recent account payments have failed or your spending limit needs to be increased.") == CR_FAIL_BILLING;
    assert cr_classify(0, "spending limit") == CR_FAIL_BILLING;
    assert cr_classify(5, "The job was not started because recent account payments have failed or your spending limit needs to be increased.") == CR_FAIL_CODE;
    assert cr_classify(0, "could not read Username for 'https://github.com': terminal prompts disabled") == CR_FAIL_AUTH;
    assert cr_classify(3, "terminal prompts disabled") == CR_FAIL_AUTH;
    assert cr_classify(4, "assertion failed") == CR_FAIL_CODE;
    assert cr_classify(0, "") == CR_FAIL_CODE;
}

test required_and_retry {
    assert cr_required_green(true, true);
    assert !cr_required_green(true, false);
    assert !cr_required_green(false, true);
    assert !cr_required_green(false, false);
    assert CR_RETRY_MAX == 3;
    assert cr_may_retry(1);
    assert cr_may_retry(2);
    assert !cr_may_retry(3);
    assert !cr_may_retry(4);
}

test act_never_final {
    assert !cr_final_ok(CR_SOURCE_ACT, true);
    assert cr_final_ok(CR_SOURCE_HOSTED, true);
    assert cr_final_ok(CR_SOURCE_SELF, true);
    assert !cr_final_ok(CR_SOURCE_HOSTED, false);
    assert !cr_final_ok(CR_SOURCE_SELF, false);
    assert !cr_final_ok(0, true);
}

test cache_key {
    var a : [64]u8 = undefined;
    var b : [64]u8 = undefined;
    var c : [64]u8 = undefined;
    var d : [64]u8 = undefined;
    const na : usize = cr_cache_key(a[0..64], "mac", 255, 4096);
    assert na == 4 + 3 + 1 + 16 + 1 + 16;
    assert bytes_eq(a[0..na], "t27-mac-00000000000000ff-0000000000001000");
    const nb : usize = cr_cache_key(b[0..64], "mac", 255, 4096);
    assert bytes_eq(a[0..na], b[0..nb]);
    const nc : usize = cr_cache_key(c[0..64], "mac", 256, 4096);
    assert !bytes_eq(a[0..na], c[0..nc]);
    const nd : usize = cr_cache_key(d[0..64], "mac", 255, 4097);
    assert !bytes_eq(a[0..na], d[0..nd]);
    assert cr_cache_key(d[0..8], "mac", 1, 1) == 0;
}

test billing_fallback {
    assert !cr_local_dev_blocked(true);
    assert !cr_local_dev_blocked(false);
    assert cr_pr_state(CR_FAIL_BILLING) == CR_PR_WAITING;
    assert cr_pr_state(CR_FAIL_CODE) == CR_PR_FAILED;
    assert cr_pr_state(CR_FAIL_AUTH) == CR_PR_FAILED;
}

test event_names {
    assert bytes_eq(cr_ev_name(CR_EV_BILLING_STATUS_CHECKED), "billing_status_checked");
    assert bytes_eq(cr_ev_name(CR_EV_RUNNER_REGISTERED), "runner_registered");
    assert bytes_eq(cr_ev_name(CR_EV_RUNNER_STARTED), "runner_started");
    assert bytes_eq(cr_ev_name(CR_EV_RUNNER_STOPPED), "runner_stopped");
    assert bytes_eq(cr_ev_name(CR_EV_RUNNER_OFFLINE), "runner_offline");
    assert bytes_eq(cr_ev_name(CR_EV_WORKFLOW_DISPATCHED), "workflow_dispatched");
    assert bytes_eq(cr_ev_name(CR_EV_WORKFLOW_COMPLETED), "workflow_completed");
    assert bytes_eq(cr_ev_name(CR_EV_WORKFLOW_FAILED), "workflow_failed");
    assert bytes_eq(cr_ev_name(CR_EV_CACHE_HIT), "cache_hit");
    assert bytes_eq(cr_ev_name(CR_EV_CACHE_MISS), "cache_miss");
    assert bytes_eq(cr_ev_name(CR_EV_CACHE_INVALIDATED), "cache_invalidated");
    assert bytes_eq(cr_ev_name(CR_EV_ACT_RUN_STARTED), "act_run_started");
    assert bytes_eq(cr_ev_name(CR_EV_ACT_RUN_COMPLETED), "act_run_completed");
    assert bytes_eq(cr_ev_name(CR_EV_SECRET_ACCESS_DENIED), "secret_access_denied");
    assert bytes_eq(cr_ev_name(CR_EV_UNTRUSTED_PR_BLOCKED), "untrusted_pr_blocked");
    assert bytes_eq(cr_ev_name(0), "unknown");
    assert bytes_eq(cr_ev_name(16), "unknown");
}

test event_codes_are_t27l_actions {
    var k : u8 = CR_EV_BILLING_STATUS_CHECKED;
    while (k <= CR_EV_UNTRUSTED_PR_BLOCKED) {
        assert tl_action_id(cr_ev_name(k)) == 107 + k;
        k = k + 1;
    }
    assert tl_action_id(cr_ev_name(0)) == 0;
}

test secrets_untrusted_zero {
    assert !cr_secret_allowed(false, false, "ANY_NAME");
    assert !cr_secret_allowed(false, true, "ANY_NAME");
}

test secrets_self_hosted_denylist {
    assert cr_secret_name_dangerous("MY_PROD_KEY");
    assert cr_secret_name_dangerous("cargo_registry_token");
    assert !cr_secret_name_dangerous("DOCS_TOKEN");
}

test labels_boundary {
    assert !cr_has_label("self-hosted-old,t27-mac,trusted", "self-hosted");
    assert cr_has_label("a,trusted", "trusted");
    assert !cr_has_label("a,trusted", "");
}
