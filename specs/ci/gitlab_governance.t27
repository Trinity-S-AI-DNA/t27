// SPDX-License-Identifier: Apache-2.0
; specs/ci/gitlab_governance.t27 -- the T27G governance page as one pure model: identity, seven sections, the UI Kit
; primitive kind that draws each section, the page actions and the row field guard. Piece 4 of embedding GitLab under
; T27 OS (see #13907; plan, see #13862); Closes #13923. It draws nothing, registers no runner, holds no network or host code.
; STANDS ALONE: gitlab_lane.t27 and gitlab_adapter.t27 are not on master yet, so this file imports neither and does
; NOT redefine adapter operations, the dispatch verdict or event ids; those stay in the adapter, lane and runner
; policy specs. The page is built from UI Kit primitives and is not drawn by hand in the window host spec.
; ASCII only (L3), English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module CiGitlabGovernance;

use std::mem::bytes_eq;

; --- 1. Page identity ---

pub const GV_TITLE : str = "T27G";
pub const GV_SLUG : str = "governance";
pub const GV_CANON_ID : str = "0xG@governance.t27";

/// Purpose words the title must never be.
pub const GV_PURPOSE_WORDS : [4]str = ["GOVERNANCE", "GATEWAY", "CI", "GITLAB"];

pub fn gv_is_purpose_word(title: []const u8) -> bool {
    var i : usize = 0;
    while (i < 4) {
        if (bytes_eq(GV_PURPOSE_WORDS[i], title)) { return true; }
        i = i + 1;
    }
    return false;
}

; --- 2. Sections, in order ---

pub const GV_SEC_RUNNERS : u8 = 1;
pub const GV_SEC_PIPELINES : u8 = 2;
pub const GV_SEC_JOBS : u8 = 3;
pub const GV_SEC_ARTIFACTS : u8 = 4;
pub const GV_SEC_SEALS : u8 = 5;
pub const GV_SEC_LANES : u8 = 6;
pub const GV_SEC_AGENTS : u8 = 7;
pub const GV_SECTION_COUNT : u8 = 7;

pub const GV_SECTION_NAMES : [7]str = ["Runners", "Pipelines", "Jobs", "Artifacts", "Seals", "Lanes", "Agents"];

/// True for a section id 1..7.
pub fn gv_section_known(id: u8) -> bool {
    return id >= 1 and id <= 7;
}

/// Name of a section id; "" for an unknown id.
pub fn gv_section_name(id: u8) -> []const u8 {
    if (!gv_section_known(id)) { return ""; }
    return GV_SECTION_NAMES[id - 1];
}

; --- 3. UI Kit primitive kinds ---

pub const GV_PK_NONE : u8 = 0;
pub const GV_PK_PLATE : u8 = 1;
pub const GV_PK_HERO_CARD : u8 = 2;
pub const GV_PK_STAT_CELL : u8 = 3;
pub const GV_PK_SEGMENT_BAR : u8 = 4;
pub const GV_PK_SIDE_NAV : u8 = 5;
pub const GV_PK_SECTION_PANEL : u8 = 6;
pub const GV_PK_AREA_CELL : u8 = 7;
pub const GV_PK_TILE : u8 = 8;
pub const GV_PK_LAMP : u8 = 9;
pub const GV_PK_BUTTON : u8 = 10;
pub const GV_PK_TEXT : u8 = 11;
pub const GV_PRIMITIVE_COUNT : u8 = 11;

/// The one primitive kind that draws a section; GV_PK_NONE for an unknown section (refused).
pub fn gv_section_primitive(id: u8) -> u8 {
    if (id == GV_SEC_RUNNERS) { return GV_PK_LAMP; }
    if (id == GV_SEC_PIPELINES) { return GV_PK_SEGMENT_BAR; }
    if (id == GV_SEC_JOBS) { return GV_PK_SECTION_PANEL; }
    if (id == GV_SEC_ARTIFACTS) { return GV_PK_TILE; }
    if (id == GV_SEC_SEALS) { return GV_PK_STAT_CELL; }
    if (id == GV_SEC_LANES) { return GV_PK_AREA_CELL; }
    if (id == GV_SEC_AGENTS) { return GV_PK_HERO_CARD; }
    return GV_PK_NONE;
}

/// A section is drawable only when it is known and maps to a real primitive kind.
pub fn gv_section_drawable(id: u8) -> bool {
    const k : u8 = gv_section_primitive(id);
    return k >= 1 and k <= GV_PRIMITIVE_COUNT;
}

; --- 4. Page actions ---

pub const GV_ACT_READ : u8 = 1;
pub const GV_ACT_DISPATCH : u8 = 2;
pub const GV_ACT_CANCEL : u8 = 3;
pub const GV_ACT_MERGE : u8 = 4;
pub const GV_ACT_APPROVE_REVIEW : u8 = 5;
pub const GV_ACT_EDIT_SEAL : u8 = 6;
pub const GV_ACT_REGISTER_RUNNER : u8 = 7;

/// Fail closed: only read, dispatch and cancel are offered; every other or unknown code is refused.
pub fn gv_action_allowed(action: u8) -> bool {
    return action >= GV_ACT_READ and action <= GV_ACT_CANCEL;
}

; --- 5. Row field guard ---

/// A field name equal to token, secret, password or key is refused.
pub fn gv_field_ok(name: []const u8) -> bool {
    if (bytes_eq(name, "token")) { return false; }
    if (bytes_eq(name, "secret")) { return false; }
    if (bytes_eq(name, "password")) { return false; }
    if (bytes_eq(name, "key")) { return false; }
    return true;
}

/// A row of up to four named fields; unused slots are "".
pub fn gv_row_ok(f0: []const u8, f1: []const u8, f2: []const u8, f3: []const u8) -> bool {
    return gv_field_ok(f0) and gv_field_ok(f1) and gv_field_ok(f2) and gv_field_ok(f3);
}

/// True for one hex digit byte (0-9, a-f).
pub fn gv_is_hex(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 97 and b <= 102);
}

/// True for a 40-character lower-case hex commit.
pub fn gv_commit_ok(commit: []const u8) -> bool {
    if (commit.len != 40) { return false; }
    var i : usize = 0;
    while (i < 40) {
        if (!gv_is_hex(commit[i])) { return false; }
        i = i + 1;
    }
    return true;
}

/// A Seals row is valid only with a run id > 0, a 40-hex commit and source = CI artifact.
pub fn gv_seal_row_ok(run_id: u64, commit: []const u8, source: []const u8) -> bool {
    if (run_id == 0) { return false; }
    if (!gv_commit_ok(commit)) { return false; }
    return bytes_eq(source, "CI artifact");
}

; --- Tests ---

test identity_is_t27g {
    assert bytes_eq(GV_TITLE, "T27G");
    assert bytes_eq(GV_SLUG, "governance");
    assert bytes_eq(GV_CANON_ID, "0xG@governance.t27");
}

test title_is_not_a_purpose_word {
    assert !gv_is_purpose_word(GV_TITLE);
}

test purpose_word_negative_control {
    assert gv_is_purpose_word("GOVERNANCE");
    assert gv_is_purpose_word("GATEWAY");
    assert gv_is_purpose_word("CI");
    assert gv_is_purpose_word("GITLAB");
}

test seven_sections_in_order {
    assert GV_SECTION_COUNT == 7;
    assert GV_SECTION_NAMES.len == 7;
    assert bytes_eq(GV_SECTION_NAMES[0], "Runners");
    assert bytes_eq(GV_SECTION_NAMES[1], "Pipelines");
    assert bytes_eq(GV_SECTION_NAMES[2], "Jobs");
    assert bytes_eq(GV_SECTION_NAMES[3], "Artifacts");
    assert bytes_eq(GV_SECTION_NAMES[4], "Seals");
    assert bytes_eq(GV_SECTION_NAMES[5], "Lanes");
    assert bytes_eq(GV_SECTION_NAMES[6], "Agents");
    assert bytes_eq(gv_section_name(GV_SEC_SEALS), "Seals");
}

test unknown_section_refused {
    assert gv_section_known(1);
    assert gv_section_known(7);
    assert !gv_section_known(0);
    assert !gv_section_known(8);
    assert bytes_eq(gv_section_name(0), "");
    assert bytes_eq(gv_section_name(8), "");
}

test every_section_has_one_primitive {
    assert GV_PRIMITIVE_COUNT == 11;
    assert gv_section_primitive(GV_SEC_RUNNERS) == GV_PK_LAMP;
    assert gv_section_primitive(GV_SEC_PIPELINES) == GV_PK_SEGMENT_BAR;
    assert gv_section_primitive(GV_SEC_JOBS) == GV_PK_SECTION_PANEL;
    assert gv_section_primitive(GV_SEC_ARTIFACTS) == GV_PK_TILE;
    assert gv_section_primitive(GV_SEC_SEALS) == GV_PK_STAT_CELL;
    assert gv_section_primitive(GV_SEC_LANES) == GV_PK_AREA_CELL;
    assert gv_section_primitive(GV_SEC_AGENTS) == GV_PK_HERO_CARD;
    var s : u8 = 1;
    while (s <= 7) {
        assert gv_section_drawable(s);
        s = s + 1;
    }
}

test section_without_primitive_refused {
    assert gv_section_primitive(0) == GV_PK_NONE;
    assert gv_section_primitive(9) == GV_PK_NONE;
    assert !gv_section_drawable(0);
    assert !gv_section_drawable(8);
}

test read_dispatch_cancel_allowed {
    assert gv_action_allowed(GV_ACT_READ);
    assert gv_action_allowed(GV_ACT_DISPATCH);
    assert gv_action_allowed(GV_ACT_CANCEL);
}

test merge_approve_edit_register_refused {
    assert !gv_action_allowed(GV_ACT_MERGE);
    assert !gv_action_allowed(GV_ACT_APPROVE_REVIEW);
    assert !gv_action_allowed(GV_ACT_EDIT_SEAL);
    assert !gv_action_allowed(GV_ACT_REGISTER_RUNNER);
}

test unknown_action_refused {
    assert !gv_action_allowed(0);
    assert !gv_action_allowed(8);
    assert !gv_action_allowed(255);
}

test secret_field_names_refused {
    assert !gv_field_ok("token");
    assert !gv_field_ok("secret");
    assert !gv_field_ok("password");
    assert !gv_field_ok("key");
    assert !gv_row_ok("name", "state", "token", "");
    assert !gv_row_ok("key", "", "", "");
}

test plain_row_accepted {
    assert gv_field_ok("run_id");
    assert gv_field_ok("keyword");
    assert gv_row_ok("name", "state", "", "");
}

test seals_row_needs_run_commit_and_source {
    const c : []const u8 = "0123456789abcdef0123456789abcdef01234567";
    assert gv_seal_row_ok(7, c, "CI artifact");
    assert !gv_seal_row_ok(0, c, "CI artifact");
    assert !gv_seal_row_ok(7, "0123456789abcdef", "CI artifact");
    assert !gv_seal_row_ok(7, "0123456789abcdef0123456789abcdef0123456z", "CI artifact");
    assert !gv_seal_row_ok(7, c, "local");
    assert !gv_seal_row_ok(7, c, "");
}
