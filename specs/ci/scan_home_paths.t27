// specs/ci/scan_home_paths.t27 -- CI: scan red - home paths in
// runs/ref_complete.txt and runs/ref_full.txt.
// Part of M1 (milestone #5). Closes #14079 and #14030.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::scan_home_paths;

pub const HOME_PATH_FORBIDDEN : bool = true;

pub struct ScanResult { home_path_present: bool };

pub fn scan_no_home_path(s: ScanResult) -> bool {
    return !s.home_path_present;
}

test "scan no home path" {
    assert(scan_no_home_path(ScanResult { home_path_present: false }));
    assert(!scan_no_home_path(ScanResult { home_path_present: true }));
}

invariant home_path_forbidden_default {
    assert HOME_PATH_FORBIDDEN;
}