// specs/ci/pull_request_target.t27 -- CI: pull_request_target workflow
// startup_failure fix.
// Part of M1 (milestone #5). Closes #14080.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::pull_request_target;

pub const PR_TARGET_STARTUP_OK : bool = true;

pub struct PrTargetWorkflow { startup_ok: bool };

pub fn pr_target_startup_ok(w: PrTargetWorkflow) -> bool {
    return w.startup_ok;
}

test "pr target startup ok" {
    assert(pr_target_startup_ok(PrTargetWorkflow { startup_ok: true }));
    assert(!pr_target_startup_ok(PrTargetWorkflow { startup_ok: false }));
}

invariant pr_target_startup_ok_default {
    assert PR_TARGET_STARTUP_OK;
}