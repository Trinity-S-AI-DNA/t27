// SPDX-License-Identifier: Apache-2.0
// specs/ci/gitlab_parallel_lane.t27 -- ci: GitLab parallel lane contract
// (GitHub stays merge authority).
// Part of M4 milestone (milestone #8). Closes #13907.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::gitlab_parallel_lane;

pub const GITLAB_PARALLEL_LANE_MAX : u32 = 4;

pub struct ParallelLane { lane_id: str, github_merge_authority: bool };

pub fn parallel_lane_github_merge_authority(l: ParallelLane) -> bool {
    return l.github_merge_authority;
}

test "parallel_lane_github_merge_authority" {
    assert(parallel_lane_github_merge_authority(ParallelLane { lane_id: "lane-1", github_merge_authority: true }));
    assert(!parallel_lane_github_merge_authority(ParallelLane { lane_id: "lane-2", github_merge_authority: false }));
}

invariant gitlab_parallel_lane_max_positive {
    assert GITLAB_PARALLEL_LANE_MAX > 0;
}