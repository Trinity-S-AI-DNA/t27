// SPDX-License-Identifier: Apache-2.0
; specs/ci/gitlab_adapter.t27 -- GitLab adapter contract: the ten operations, what is refused, what a record needs.
; KIND gitlab_adapter, ID 0xG@gitlab_adapter.t27, domain code T27G, slug governance,
; domain id 0xG@governance.t27, runtime t27b. Piece 1 of embedding GitLab under T27 OS (M0).
; Contract only: no runner registration, no network code, no host code.
; The dispatch verdict, dedupe, shards, capabilities and the event ids live in specs/ci/gitlab_lane.t27
; and specs/ci/runner_policy.t27; this spec does not import or redefine them. Result slots below are
; adapter-local numbers that gitlab_lane maps to its event ids.
; Refs: epic #13907, governance plan #13862, issue #13916.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module CiGitlabAdapter;

use std::mem::bytes_eq;

; --- 1. Identity ---

pub const GA_KIND : []const u8 = "gitlab_adapter";
pub const GA_ID : []const u8 = "0xG@gitlab_adapter.t27";
pub const GA_DOMAIN_CODE : []const u8 = "T27G";
pub const GA_DOMAIN_SLUG : []const u8 = "governance";
pub const GA_DOMAIN_ID : []const u8 = "0xG@governance.t27";
pub const GA_RUNTIME : []const u8 = "t27b";

; --- 2. The ten operations ---

pub const GA_OP_REGISTER_RUNNER : u8 = 1;
pub const GA_OP_DISPATCH_PIPELINE : u8 = 2;
pub const GA_OP_CANCEL_PIPELINE : u8 = 3;
pub const GA_OP_READ_PIPELINE : u8 = 4;
pub const GA_OP_READ_JOB : u8 = 5;
pub const GA_OP_READ_ARTIFACT : u8 = 6;
pub const GA_OP_PUBLISH_EVENT : u8 = 7;
pub const GA_OP_INTAKE_SEAL : u8 = 8;
pub const GA_OP_UPDATE_LANE : u8 = 9;
pub const GA_OP_UPDATE_AGENT_STATE : u8 = 10;
pub const GA_OP_COUNT : u8 = 10;

/// Forbidden operations. They are never members of the ten, so op_known refuses them too.
pub const GA_FORBID_MERGE : u8 = 101;
pub const GA_FORBID_APPROVE_REVIEW : u8 = 102;
pub const GA_FORBID_LOCAL_SEAL_MUTATION : u8 = 103;
pub const GA_FORBID_BROWSER_API : u8 = 104;
pub const GA_FORBID_SECRET_IN_UI : u8 = 105;

pub fn ga_op_name(op: u8) -> []const u8 {
    if (op == GA_OP_REGISTER_RUNNER) { return "register_runner"; }
    if (op == GA_OP_DISPATCH_PIPELINE) { return "dispatch_pipeline"; }
    if (op == GA_OP_CANCEL_PIPELINE) { return "cancel_pipeline"; }
    if (op == GA_OP_READ_PIPELINE) { return "read_pipeline"; }
    if (op == GA_OP_READ_JOB) { return "read_job"; }
    if (op == GA_OP_READ_ARTIFACT) { return "read_artifact"; }
    if (op == GA_OP_PUBLISH_EVENT) { return "publish_event"; }
    if (op == GA_OP_INTAKE_SEAL) { return "intake_seal"; }
    if (op == GA_OP_UPDATE_LANE) { return "update_lane"; }
    if (op == GA_OP_UPDATE_AGENT_STATE) { return "update_agent_state"; }
    return "";
}

pub fn ga_op_known(op: u8) -> bool {
    return op >= GA_OP_REGISTER_RUNNER and op <= GA_OP_COUNT;
}

pub fn ga_op_forbidden(op: u8) -> bool {
    return op >= GA_FORBID_MERGE and op <= GA_FORBID_SECRET_IN_UI;
}

/// Fail closed: only a known, non-forbidden operation is allowed.
pub fn ga_op_allowed(op: u8) -> bool {
    if (ga_op_forbidden(op)) { return false; }
    return ga_op_known(op);
}

; --- 3. Dispatch record ---

fn ga_is_hex(c: u8) -> bool {
    if (c >= 48 and c <= 57) { return true; }
    return c >= 97 and c <= 102;
}

/// 40 lower-case hex digits.
pub fn ga_commit_ok(commit: []const u8) -> bool {
    if (commit.len != 40) { return false; }
    var i : usize = 0;
    while (i < 40) {
        if (!ga_is_hex(commit[i])) { return false; }
        i += 1;
    }
    return true;
}

/// A dispatch record needs COMMIT (40 hex), JOB_KIND, LANE and RUNNER, all non-empty.
pub fn ga_dispatch_valid(commit: []const u8, job_kind: []const u8, lane: []const u8, runner: []const u8) -> bool {
    if (!ga_commit_ok(commit)) { return false; }
    if (job_kind.len == 0) { return false; }
    if (lane.len == 0) { return false; }
    return runner.len > 0;
}

; --- 4. register_runner is owner-only; a token is a flag, never a value ---

/// Allowed only when the registration token holder is the owner.
pub fn ga_register_allowed(holder_is_owner: bool) -> bool {
    return holder_is_owner;
}

/// The adapter record holds the flag only. Valid when no token value is stored.
pub fn ga_token_record_ok(token_present_flag: bool, stored_token_bytes: usize) -> bool {
    return stored_token_bytes == 0;
}

; --- 5. Results map to exactly one event; artifacts are referenced ---

pub const GA_RES_PASSED : u8 = 1;
pub const GA_RES_FAILED : u8 = 2;
pub const GA_RES_CANCELLED : u8 = 3;
pub const GA_RES_TIMED_OUT : u8 = 4;

/// Adapter-local event slot for a job result; 0 means no such result. One result, one slot.
pub fn ga_event_for_result(res: u8) -> u8 {
    if (res >= GA_RES_PASSED and res <= GA_RES_TIMED_OUT) { return res; }
    return 0;
}

/// An artifact record carries a reference (path or id) and zero payload bytes.
pub fn ga_artifact_ok(ref_len: usize, payload_bytes: usize) -> bool {
    return ref_len > 0 and payload_bytes == 0;
}

; --- 6. Seal intake: CI artifacts only ---

pub const GA_SEAL_SOURCE_CI : []const u8 = "CI_ARTIFACT";

/// Intake records RUN_ID, COMMIT and SEAL_SOURCE = CI_ARTIFACT, with NO_LOCAL_SEAL_EDIT = YES.
pub fn ga_intake_ok(run_id: u64, commit: []const u8, source: []const u8, no_local_edit: bool) -> bool {
    if (run_id == 0) { return false; }
    if (!ga_commit_ok(commit)) { return false; }
    if (!bytes_eq(source, GA_SEAL_SOURCE_CI)) { return false; }
    return no_local_edit;
}

; --- Tests ---

test identity {
    assert bytes_eq(GA_KIND, "gitlab_adapter");
    assert bytes_eq(GA_ID, "0xG@gitlab_adapter.t27");
    assert bytes_eq(GA_DOMAIN_CODE, "T27G");
    assert bytes_eq(GA_DOMAIN_ID, "0xG@governance.t27");
    assert !bytes_eq(GA_DOMAIN_CODE, "T27C");
}

test ten_ops_known {
    assert ga_op_known(GA_OP_REGISTER_RUNNER);
    assert ga_op_known(GA_OP_UPDATE_AGENT_STATE);
    assert ga_op_known(GA_OP_INTAKE_SEAL);
    assert GA_OP_COUNT == 10;
    assert !ga_op_known(0);
    assert !ga_op_known(11);
}

test names_table {
    assert bytes_eq(ga_op_name(GA_OP_REGISTER_RUNNER), "register_runner");
    assert bytes_eq(ga_op_name(GA_OP_DISPATCH_PIPELINE), "dispatch_pipeline");
    assert bytes_eq(ga_op_name(GA_OP_UPDATE_AGENT_STATE), "update_agent_state");
    assert bytes_eq(ga_op_name(GA_OP_READ_ARTIFACT), "read_artifact");
    assert ga_op_name(0).len == 0;
    assert ga_op_name(200).len == 0;
}

test forbidden_refused {
    assert !ga_op_allowed(GA_FORBID_MERGE);
    assert !ga_op_allowed(GA_FORBID_APPROVE_REVIEW);
    assert !ga_op_allowed(GA_FORBID_LOCAL_SEAL_MUTATION);
    assert !ga_op_allowed(GA_FORBID_BROWSER_API);
    assert !ga_op_allowed(GA_FORBID_SECRET_IN_UI);
    assert ga_op_forbidden(GA_FORBID_MERGE);
}

test allowed_control {
    assert ga_op_allowed(GA_OP_READ_PIPELINE);
    assert ga_op_allowed(GA_OP_PUBLISH_EVENT);
    assert !ga_op_forbidden(GA_OP_READ_PIPELINE);
    assert !ga_op_allowed(0);
    assert !ga_op_allowed(255);
}

test commit_shape {
    assert ga_commit_ok("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    assert !ga_commit_ok("2e1b0dade9");
    assert !ga_commit_ok("");
    assert !ga_commit_ok("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaz");
    assert !ga_commit_ok("2E1B0DADE9AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
}

test dispatch_valid_control {
    assert ga_dispatch_valid("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "seal", "lane-1", "runner-a");
}

test dispatch_refused {
    assert !ga_dispatch_valid("abc", "seal", "lane-1", "runner-a");
    assert !ga_dispatch_valid("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "", "lane-1", "runner-a");
    assert !ga_dispatch_valid("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "seal", "", "runner-a");
    assert !ga_dispatch_valid("2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "seal", "lane-1", "");
}

test register_owner_only {
    assert ga_register_allowed(true);
    assert !ga_register_allowed(false);
}

test token_never_stored {
    assert ga_token_record_ok(true, 0);
    assert ga_token_record_ok(false, 0);
    assert !ga_token_record_ok(true, 20);
    assert !ga_token_record_ok(false, 1);
}

test result_to_one_event {
    assert ga_event_for_result(GA_RES_PASSED) == 1;
    assert ga_event_for_result(GA_RES_FAILED) == 2;
    assert ga_event_for_result(GA_RES_CANCELLED) == 3;
    assert ga_event_for_result(GA_RES_TIMED_OUT) == 4;
    assert ga_event_for_result(GA_RES_PASSED) != ga_event_for_result(GA_RES_FAILED);
    assert ga_event_for_result(0) == 0;
    assert ga_event_for_result(9) == 0;
}

test artifact_by_reference {
    assert ga_artifact_ok(12, 0);
    assert !ga_artifact_ok(0, 0);
    assert !ga_artifact_ok(12, 1);
    assert !ga_artifact_ok(12, 4096);
}

test seal_intake_ci_only {
    assert ga_intake_ok(77, "2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "CI_ARTIFACT", true);
    assert !ga_intake_ok(77, "2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "LOCAL", true);
    assert !ga_intake_ok(0, "2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "CI_ARTIFACT", true);
    assert !ga_intake_ok(77, "short", "CI_ARTIFACT", true);
    assert !ga_intake_ok(77, "2e1b0dade9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "CI_ARTIFACT", false);
}
