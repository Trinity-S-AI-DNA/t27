// SPDX-License-Identifier: Apache-2.0
// specs/ci/coq_proofs.t27 -- ci: Coq Proofs Validation has never passed;
// opam update fails on the archive repository.
// Part of M4 milestone (milestone #8). Closes #13302.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::coq_proofs;

pub const COQ_PROOFS_VALIDATION_PASSED : bool = false;

pub struct CoqProofResult { opam_update_ok: bool, validation_passed: bool };

pub fn coq_proofs_validation_passed(r: CoqProofResult) -> bool {
    return r.validation_passed;
}

test "coq_proofs_validation_passed" {
    assert(!coq_proofs_validation_passed(CoqProofResult { opam_update_ok: false, validation_passed: false }));
    assert(coq_proofs_validation_passed(CoqProofResult { opam_update_ok: true, validation_passed: true }));
}

invariant coq_proofs_validation_passed_default {
    assert !COQ_PROOFS_VALIDATION_PASSED;
}