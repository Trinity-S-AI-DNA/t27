// SPDX-License-Identifier: Apache-2.0
; specs/ci/pr_ready_aggregate.t27 -- REQUIRED_CHECKS_V1: one aggregate required GitHub check
; that always terminates on the latest commit SHA. Per-path and per-branch filters may keep
; informational jobs optional; they must not leave a required name pending or absent.
; Complements specs/tri/t27b/steward.t27 pr_ready, specs/queen/merger_gate.t27 (unconcluded
; blocks), and specs/ci/heavy_skip.t27 (a skipped required job must still post a context).
; Host workflow is plumbing: .github/workflows/pr-ready.yml is filed after this spec seals.
; Refs #13534, owner gate-repair brief 2026-11-10.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CiPrReadyAggregate;

use ci::schema::TRIGGER_PULL_REQUEST;
use ci::schema::TRIGGER_PUSH;

/// Stable required check name for branch rulesets and the merger.
pub const TRIGGER_WORKFLOW_DISPATCH : str = "workflow_dispatch";
pub const AGGREGATE_CHECK_NAME : str = "pr-ready";

/// GitHub terminal conclusions for a required check on the latest SHA.
pub const T_SUCCESS : u8 = 0;
pub const T_FAILURE : u8 = 1;
pub const T_SKIPPED : u8 = 2;
pub const T_NEUTRAL : u8 = 3;
pub const T_PENDING : u8 = 4;

/// A required check must end in one of the terminal states, never stay pending.
pub fn required_check_terminal(state: u8) -> bool {
    if (state == T_PENDING) { return false; }
    if (state == T_SUCCESS) { return true; }
    if (state == T_FAILURE) { return true; }
    if (state == T_SKIPPED) { return true; }
    if (state == T_NEUTRAL) { return true; }
    return false;
}

test terminal_states_are_not_pending {
    assert required_check_terminal(T_SUCCESS);
    assert required_check_terminal(T_FAILURE);
    assert required_check_terminal(T_SKIPPED);
    assert required_check_terminal(T_NEUTRAL);
    assert required_check_terminal(T_PENDING) == false;
}

/// The aggregate pr-ready check passes only when posted, concluded, and green.
pub fn aggregate_passes(posted: bool, state: u8) -> bool {
    if (posted == false) { return false; }
    if (required_check_terminal(state) == false) { return false; }
    if (state == T_SUCCESS) { return true; }
    return false;
}

test aggregate_requires_success_on_latest_sha {
    assert aggregate_passes(true, T_SUCCESS);
    assert aggregate_passes(true, T_PENDING) == false;
    assert aggregate_passes(false, T_SUCCESS) == false;
    assert aggregate_passes(true, T_FAILURE) == false;
}

/// A required job skipped at workflow level leaves no context and blocks merge (#2191).
/// Required jobs skip only at step level and still post a terminal context.
pub fn silent_skip_blocks_merge(job_level_skip: bool, required: bool) -> bool {
    if (required == false) { return false; }
    return job_level_skip;
}

/// GitHub counts a check toward branch rules only for these triggers, not workflow_dispatch alone.
pub fn trigger_satisfies_branch_ruleset(trigger: str) -> bool {
    if (trigger == TRIGGER_WORKFLOW_DISPATCH) { return false; }
    if (trigger == TRIGGER_PULL_REQUEST) { return true; }
    if (trigger == TRIGGER_PUSH) { return true; }
    return false;
}

test dispatch_does_not_satisfy_ruleset {
    assert trigger_satisfies_branch_ruleset(TRIGGER_WORKFLOW_DISPATCH) == false;
    assert trigger_satisfies_branch_ruleset(TRIGGER_PULL_REQUEST);
    assert trigger_satisfies_branch_ruleset(TRIGGER_PUSH);
}

test required_job_level_skip_blocks {
    assert silent_skip_blocks_merge(true, true);
    assert silent_skip_blocks_merge(true, false) == false;
    assert silent_skip_blocks_merge(false, true) == false;
}

/// Merge policy: pr-ready success and no unresolved P0 in the eligibility report.
pub fn merge_allowed(aggregate_ok: bool, p0_open: bool) -> bool {
    if (p0_open) { return false; }
    return aggregate_ok;
}

test merge_waits_on_p0 {
    assert merge_allowed(true, false);
    assert merge_allowed(true, true) == false;
    assert merge_allowed(false, false) == false;
}
