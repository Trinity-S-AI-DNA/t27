    assert gl_retry_allowed(FC_TRANSIENT, 0);
    assert gl_retry_allowed(FC_TRANSIENT, GL_RETRY_CAP - 1);
    // negative controls: at the cap, unclassified, deterministic, none
    assert !gl_retry_allowed(FC_TRANSIENT, GL_RETRY_CAP);
    assert !gl_retry_allowed(FC_UNCLASSIFIED, 0);
    assert !gl_retry_allowed(FC_DETERMINISTIC, 0);
    assert !gl_retry_allowed(FC_NONE, 0);
    assert gl_retry_escalate(FC_TRANSIENT, GL_RETRY_CAP);
    assert gl_retry_escalate(FC_UNCLASSIFIED, 0);
    assert !gl_retry_escalate(FC_TRANSIENT, 0);
}

; --- 9b. Drift tests for the generated pipeline file (FR-006) ---
; The committed-file equality itself is `git diff --exit-code -- .gitlab-ci.yml` after
; `t27c gen-text specs/ci/gitlab_lane.t27 --fn gl_pipeline_yaml -o .gitlab-ci.yml`.

fn gl_match(buf: []u8, at: usize, n: usize, needle: []const u8) -> bool {
    if (needle.len == 0 or at + needle.len > n) { return false; }
    var i : usize = 0;
    while (i < needle.len) {
        if (buf[at + i] != needle[i]) { return false; }
        i += 1;
    }
    return true;
}

/// Index of the first match of needle at or after from, or GL_OVER.
fn gl_find(buf: []u8, n: usize, needle: []const u8, from: usize) -> u32 {
    var i : usize = from;
    while (i < n) {
        if (gl_match(buf, i, n, needle)) { return i as u32; }
        i += 1;
    }
    return GL_OVER;
}

fn gl_count(buf: []u8, n: usize, needle: []const u8) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (gl_match(buf, i, n, needle)) { c += 1; }
        i += 1;
    }
    return c;
}

fn gl_same(a: []u8, b: []u8, n: usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

/// Fingerprint of buf[0..n]: h = (h * 31 + byte) mod 1000003, so a u32 never overflows.
fn gl_fp(buf: []u8, n: usize) -> u32 {
    var h : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        h = (h * 31 + (buf[i] as u32)) % 1000003;
        i += 1;
    }
    return h;
}

test pipeline_render_is_deterministic {
    var a : [16384]u8 = undefined;
    var ai : u32 = 0;
    while (ai < 16384) : (ai += 1) { a[ai] = 0; }
    var b : [16384]u8 = undefined;
    var bi : u32 = 0;
    while (bi < 16384) : (bi += 1) { b[bi] = 0; }
    const n : u32 = gl_pipeline_yaml(&a);
    const m : u32 = gl_pipeline_yaml(&b);
    assert(n != GL_OVER);
    assert(n == m);
    assert(gl_same(&a, &b, n as usize));
    // negative control: one changed byte is seen
    b[10] = b[10] + 1;
    assert(!gl_same(&a, &b, n as usize));
    // negative control: a buffer that is too small gives GL_OVER, not a short text
    var small : [64]u8 = undefined;
    var si : u32 = 0;
    while (si < 64) : (si += 1) { small[si] = 0; }
    assert(gl_pipeline_yaml(&small) == GL_OVER);
}

test pipeline_starts_with_generated_header {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : u32 = gl_pipeline_yaml(&o);
    assert(gl_find(&o, n as usize, GL_HEADER, 0) == 0);
    assert(gl_count(&o, n as usize, "do not edit") == 1);
    // negative control: the stages list starts right after the header, not at byte 0
    assert(gl_find(&o, n as usize, "stages:", 0) == (GL_HEADER.len as u32));
}

test pipeline_has_six_stages_in_contract_order {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    assert(GS_NAMES.len == (GS_COUNT as usize));
    assert(GS_COUNT == 6);
    assert(bytes_eq(GS_NAMES[GS_PREFETCH as usize], "prefetch"));
    assert(bytes_eq(GS_NAMES[GS_REPORT as usize], "report"));
    var pos : u32 = gl_find(&o, n, "stages:", 0);
    assert(pos != GL_OVER);
    var s : usize = 0;
    while (s < (GS_COUNT as usize)) {
        const hit : u32 = gl_find(&o, n, GS_NAMES[s], pos as usize);
        assert(hit != GL_OVER);
        // each stage name comes after the previous one
        assert(hit >= pos);
        pos = hit + 1;
        s += 1;
    }
    // negative control: a stage that is not in the contract is absent from the stages list
    assert(gl_count(&o, n, "  - deploy\n") == 0);
}

test pipeline_has_one_job_per_kind {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    assert(GL_KINDS.len == GL_KIND_COUNT);
    assert(GL_KIND_NAMES.len == GL_KIND_COUNT);
    assert(GL_KIND_COUNT == 12);
    assert(gl_count(&o, n, "\n  stage: ") == GL_KIND_COUNT);
    // every kind in the table is known and has a stage in the stage table
    var j : usize = 0;
    while (j < GL_KIND_COUNT) {
        assert(gl_kind_known(GL_KINDS[j]));
        assert((gl_stage_of_kind(GL_KINDS[j]) as usize) < (GS_COUNT as usize));
        j += 1;
    }
    // the three kinds that exist in lab/job_kind.t27 keep their code
    assert(GL_KINDS[1] == GK_BUILD);
    assert(GL_KINDS[2] == GK_SUITE);
    assert(GL_KINDS[5] == GK_SEAL);
    // negative control: no job for an unknown kind
    assert(gl_count(&o, n, "\nunknown:\n") == 0);
}

test pipeline_every_job_has_the_runner_tag_and_refuses_fork_mr {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    assert(bytes_eq(GL_RUNNER_TAG, "vps-docker-1g"));
    assert(gl_count(&o, n, "  tags:\n    - vps-docker-1g\n") == GL_KIND_COUNT);
    assert(gl_count(&o, n, "$CI_MERGE_REQUEST_SOURCE_PROJECT_PATH != $CI_PROJECT_PATH'\n      when: never\n") == GL_KIND_COUNT);
    assert(gl_count(&o, n, "  script:\n") == GL_KIND_COUNT);
    // negative control: no job is left untagged, so the tags count equals the job count
    assert(gl_count(&o, n, "  tags:\n") == gl_count(&o, n, "\n  stage: "));
}

test pipeline_disk_check_only_on_heavy_kinds {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    assert(GL_FREE_GIB_MIN * GL_KIB_PER_GIB == 8388608);
    var heavy : usize = 0;
    var j : usize = 0;
    while (j < GL_KIND_COUNT) {
        if (gl_kind_heavy(GL_KINDS[j])) { heavy += 1; }
        j += 1;
    }
    assert(heavy == 5);
    assert(gl_count(&o, n, "  before_script:\n") == heavy);
    assert(gl_count(&o, n, "-ge 8388608\n") == heavy);
    // negative control: a light kind has no check, so the count is below the job count
    assert(heavy < GL_KIND_COUNT);
    assert(!gl_kind_heavy(GK_GUARD));
}

test pipeline_names_no_forbidden_capability {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    // FR-004 and FR-007: no merge, approve, push, force, token, password or secret word in the text
    assert(gl_count(&o, n, "merge") == 0);
    assert(gl_count(&o, n, "approve") == 0);
    assert(gl_count(&o, n, "push") == 0);
    assert(gl_count(&o, n, "force") == 0);
    assert(gl_count(&o, n, "token") == 0);
    assert(gl_count(&o, n, "password") == 0);
    assert(gl_count(&o, n, "secret") == 0);
    assert(gl_count(&o, n, "TOKEN") == 0);
    // the seal jobs name the CI artifact as their only input
    assert(gl_count(&o, n, "seal input is the CI seal-coverage artifact only") == 2);
    // negative control: the search helper does find a word that is present
    assert(gl_count(&o, n, "script") > 0);
}

test pipeline_prefetch_and_guard_have_real_commands {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : usize = gl_pipeline_yaml(&o) as usize;
    // every job keeps its print line
    assert(gl_count(&o, n, "    - echo job=") == GL_KIND_COUNT);
    // prefetch: exactly one commit check, and it sits inside the prefetch job (before the build job)
    assert(gl_count(&o, n, GL_PREFETCH_CMD) == 1);
    assert(gl_count(&o, n, "test \"$(cat .git/HEAD)\" = \"$CI_COMMIT_SHA\"") == 1);
    const at_pre : u32 = gl_find(&o, n, GL_PREFETCH_CMD, 0);
    const at_build : u32 = gl_find(&o, n, "\nbuild:\n", 0);
    assert(at_pre != GL_OVER);
    assert(at_pre < at_build);
    // guard: exactly one scan, naming the file and failing at the end
    assert(gl_count(&o, n, GL_GUARD_CMD) == 1);
    assert(gl_count(&o, n, "echo \"non-ascii: $f\"") == 1);
    assert(gl_count(&o, n, "test \"$bad\" = 0\n") == 1);
    assert(gl_count(&o, n, "tr -d '\\000-\\177'") == 1);
    const at_guard : u32 = gl_find(&o, n, GL_GUARD_CMD, 0);
    const at_seal : u32 = gl_find(&o, n, "\nseal:\n", 0);
    assert(at_guard > gl_find(&o, n, "\nguard:\n", 0));
    assert(at_guard < at_seal);
    // negative control: busybox has no grep --include and no grep -P, and the job image has no git
    assert(gl_count(&o, n, "--include") == 0);
    assert(gl_count(&o, n, "grep -P") == 0);
    assert(gl_count(&o, n, "git ") == 0);
    // negative control: a render without the prefetch line would fail the count assert above
    var cut : [16384]u8 = undefined;
    var ci : u32 = 0;
    while (ci < 16384) : (ci += 1) { cut[ci] = 0; }
    const m : u32 = gl_put(&cut, 0, "    - echo job=prefetch commit=$CI_COMMIT_SHA\n");
    assert(gl_count(&cut, m as usize, GL_PREFETCH_CMD) == 0);
    assert(gl_count(&cut, m as usize, GL_GUARD_CMD) == 0);
}

test fingerprint_helper_is_exact {
    var t : [2]u8 = [97, 98];
    // h = 97, then 97 * 31 + 98 = 3105
    assert(gl_fp(&t, 1) == 97);
    assert(gl_fp(&t, 2) == 3105);
    t[1] = 99;
    assert(gl_fp(&t, 2) == 3106);
}

// Pinned render: a change to the renderer changes the length or the fingerprint and fails here until
// both numbers are updated on purpose, together with a regenerated .gitlab-ci.yml.
test pipeline_render_is_pinned {
    var o : [16384]u8 = undefined;
    var oi : u32 = 0;
    while (oi < 16384) : (oi += 1) { o[oi] = 0; }
    const n : u32 = gl_pipeline_yaml(&o);
    assert(n == 4354);
    assert(gl_fp(&o, n as usize) == 900205);
    // negative control: one changed byte changes the fingerprint
    const before : u32 = gl_fp(&o, n as usize);
    o[100] = o[100] + 1;
    assert(gl_fp(&o, n as usize) != before);
}
