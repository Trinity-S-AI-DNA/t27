// SPDX-License-Identifier: Apache-2.0
; specs/ci/gitlab_lane.t27 -- GitLab as a parallel execution lane; GitHub stays the merge authority.
; Owner's order 2026-11-15 (GITLAB_PARALLEL_LANE_TRIGIT_INTEGRATION_PLANNED), piece 1 (Refs #13907).
; Pure functions only: no I/O, no network, no pipeline file. A pipeline file, if one is ever written,
; is generated from this spec; nothing here is a hand-written non-t27 file.
; Reused, never copied: trigger trust (ci::runner_policy), the sha check (tri::lab::dispatch), the gate
; codes (lab::job_kind), the domain code of letter G (queen::agent_registry section 9f).
; Domain label: the registry id of letter G is T27G, slug governance. The owner's word "gateway" is not
; the registry id; the registry id is kept (no agent name is invented here).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module GitlabLane;

use ci::runner_policy::cr_trigger_trusted;
use ci::runner_policy::cr_match_at;
use ci::runner_policy::CR_TRG_PUSH_OWN;
use ci::runner_policy::CR_TRG_PR_FORK;
use ci::runner_policy::CR_TRG_UNKNOWN;
use tri::lab::dispatch::sha_ok;
use lab::job_kind::LJK_GATE_BUILD;
use lab::job_kind::LJK_GATE_SUITE;
use lab::job_kind::LJK_GATE_SEAL_CURRENCY;
use queen::agent_registry::AN_CODES;
use queen::agent_registry::AN_SLUGS;
use std::mem::bytes_eq;

; --- 1. Domain label ---

/// Letter G in the registry: code T27G, slug governance (AN_CODES[6], AN_SLUGS[6]).
pub const GL_DOMAIN_CODE : str = "T27G";
pub const GL_DOMAIN_SLUG : str = "governance";

; --- 2. The merge rule: GitLab never decides ---

/// GitHub required checks green and the owner accepted. gitlab_green is accepted and ignored on purpose.
pub fn merge_allowed(github_required_green: bool, owner_accepted: bool, gitlab_green: bool) -> bool {
    return github_required_green and owner_accepted;
}

; --- 3. Job record ---

pub const GL_COMMIT_LEN : usize = 40;
pub const GL_TOKEN_MAX : usize = 64;

/// A full 40-hex commit (the dispatch.t27 check, plus the exact length).
pub fn gl_commit_ok(commit: []const u8) -> bool {
    return commit.len == GL_COMMIT_LEN and sha_ok(commit);
}

/// An id token: 1..64 bytes of printable ASCII without space.
pub fn gl_token_ok(s: []const u8) -> bool {
    if (s.len == 0 or s.len > GL_TOKEN_MAX) { return false; }
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] <= 32 or s[i] >= 127) { return false; }
        i += 1;
    }
    return true;
}

/// A record is accepted only when COMMIT, PIPELINE_ID, JOB_ID and RUNNER_ID are all present.
pub fn gl_record_ok(commit: []const u8, pipeline_id: []const u8, job_id: []const u8, runner_id: []const u8) -> bool {
    return gl_commit_ok(commit) and gl_token_ok(pipeline_id) and gl_token_ok(job_id) and gl_token_ok(runner_id);
}

; --- 4. Stages and job kinds ---

pub const GS_PREFETCH : u8 = 0;
pub const GS_TEST : u8 = 1;
pub const GS_GUARD : u8 = 2;
pub const GS_SEAL : u8 = 3;
pub const GS_VISUAL : u8 = 4;
pub const GS_REPORT : u8 = 5;
pub const GS_COUNT : u8 = 6;
pub const GS_NONE : u8 = 255;

/// Kinds that exist in lab/job_kind.t27 keep their code; the rest are lane-only.
pub const GK_BUILD : u32 = LJK_GATE_BUILD;
pub const GK_SUITE : u32 = LJK_GATE_SUITE;
pub const GK_SEAL : u32 = LJK_GATE_SEAL_CURRENCY;
pub const GK_PREFETCH : u32 = 100;
pub const GK_GUARD : u32 = 101;
pub const GK_VISUAL : u32 = 102;
pub const GK_REPORT : u32 = 103;

/// Stage of a job kind; an unknown kind has no stage.
pub fn gl_stage_of_kind(kind: u32) -> u8 {
    if (kind == GK_PREFETCH) { return GS_PREFETCH; }
    if (kind == GK_SUITE or kind == GK_BUILD) { return GS_TEST; }
    if (kind == GK_GUARD) { return GS_GUARD; }
    if (kind == GK_SEAL) { return GS_SEAL; }
    if (kind == GK_VISUAL) { return GS_VISUAL; }
    if (kind == GK_REPORT) { return GS_REPORT; }
    return GS_NONE;
}

pub fn gl_kind_known(kind: u32) -> bool {
    return gl_stage_of_kind(kind) != GS_NONE;
}

/// Stages run in order and never go back: next may repeat the stage or move forward.
pub fn gl_stage_order_ok(prev: u8, next: u8) -> bool {
    if (prev >= GS_COUNT or next >= GS_COUNT) { return false; }
    return next >= prev;
}

/// Heavy kinds: the window build and the visual stage (it needs the built window).
pub fn gl_kind_heavy(kind: u32) -> bool {
    return kind == GK_BUILD or kind == GK_VISUAL;
}

; --- 5. Dispatch ---

pub const GL_FREE_GIB_MIN : u32 = 8;

pub const GV_OK : u8 = 0;
pub const GV_DUPLICATE : u8 = 1;
pub const GV_SEAL_NOT_NEEDED : u8 = 2;
pub const GV_LOW_DISK : u8 = 3;
pub const GV_NO_DRAFT : u8 = 4;
pub const GV_BAD_COMMIT : u8 = 5;
pub const GV_UNKNOWN_KIND : u8 = 6;

/// True when (commit, kind) is already in the ledger: seen_blob holds seen_n commits of 40 bytes each,
/// seen_kinds the kind of each. A ledger shorter than it claims fails closed (counts as seen).
pub fn gl_pair_seen(commit: []const u8, kind: u32, seen_blob: []const u8, seen_kinds: []const u32, seen_n: usize) -> bool {
    if (seen_blob.len < seen_n * GL_COMMIT_LEN or seen_kinds.len < seen_n) { return true; }
    var i : usize = 0;
    while (i < seen_n) {
        if (seen_kinds[i] == kind and cr_match_at(seen_blob, i * GL_COMMIT_LEN, commit)) { return true; }
        i += 1;
    }
    return false;
}

/// A seal job runs only for a spec whose seal changed or is stale.
pub fn gl_seal_needed(changed: bool, stale: bool) -> bool {
    return changed or stale;
}

/// One verdict per dispatch request; GV_OK is the only verdict that starts a pipeline.
pub fn gl_dispatch_verdict(commit: []const u8, kind: u32, free_gib: u32, seal_changed: bool, seal_stale: bool, draft_accepted: bool, seen_blob: []const u8, seen_kinds: []const u32, seen_n: usize) -> u8 {
    if (!gl_commit_ok(commit)) { return GV_BAD_COMMIT; }
    if (!gl_kind_known(kind)) { return GV_UNKNOWN_KIND; }
    if (gl_pair_seen(commit, kind, seen_blob, seen_kinds, seen_n)) { return GV_DUPLICATE; }
    if (kind == GK_SEAL and !gl_seal_needed(seal_changed, seal_stale)) { return GV_SEAL_NOT_NEEDED; }
    if (gl_kind_heavy(kind) and free_gib < GL_FREE_GIB_MIN) { return GV_LOW_DISK; }
    if (kind == GK_VISUAL and !draft_accepted) { return GV_NO_DRAFT; }
    return GV_OK;
}

; --- 6. Shards ---

pub const GSH_T27OS : u8 = 0;
pub const GSH_UIKIT : u8 = 1;
pub const GSH_T27F : u8 = 2;
pub const GSH_DOMAINS : u8 = 3;
pub const GSH_AFFECTED : u8 = 4;
pub const GSH_COUNT : u8 = 5;
pub const GSH_NONE : u8 = 255;

/// Shard of a spec path. Anything else under specs/ is an affected dependency; a path outside specs/ has none.
pub fn gl_shard_of(path: []const u8) -> u8 {
    if (cr_match_at(path, 0, "specs/t27os/")) { return GSH_T27OS; }
    if (cr_match_at(path, 0, "specs/uikit/")) { return GSH_UIKIT; }
    if (cr_match_at(path, 0, "specs/t27f/")) { return GSH_T27F; }
    if (cr_match_at(path, 0, "specs/domains/")) { return GSH_DOMAINS; }
    if (cr_match_at(path, 0, "specs/")) { return GSH_AFFECTED; }
    return GSH_NONE;
}

; --- 7. Outcomes, events, the fix queue ---

pub const EV_RUNNER_ONLINE : u8 = 1;
pub const EV_RUNNER_OFFLINE : u8 = 2;
pub const EV_PIPELINE_DISPATCHED : u8 = 3;
pub const EV_JOB_STARTED : u8 = 4;
pub const EV_JOB_PASSED : u8 = 5;
pub const EV_JOB_FAILED : u8 = 6;
pub const EV_ARTIFACT_READY : u8 = 7;
pub const EV_SEAL_COVERAGE_COMPLETE : u8 = 8;
pub const EV_LANE_BLOCKED : u8 = 9;
pub const EV_LANE_RECOVERED : u8 = 10;
pub const EV_COUNT : u8 = 10;
pub const EV_NONE : u8 = 0;

/// Event names (names only, as constants), indexed by code - 1.
pub const EV_NAMES : [10]str = ["runner_online", "runner_offline", "pipeline_dispatched", "job_started", "job_passed", "job_failed", "artifact_ready", "seal_coverage_complete", "lane_blocked", "lane_recovered"];

pub const OC_RUNNER_UP : u8 = 1;
pub const OC_RUNNER_DOWN : u8 = 2;
pub const OC_DISPATCHED : u8 = 3;
pub const OC_STARTED : u8 = 4;
pub const OC_PASSED : u8 = 5;
pub const OC_FAILED : u8 = 6;
pub const OC_ARTIFACT : u8 = 7;
pub const OC_SEALS_DONE : u8 = 8;
pub const OC_BLOCKED : u8 = 9;
pub const OC_RECOVERED : u8 = 10;

/// Each outcome maps to exactly one event; an unknown outcome maps to none.
pub fn gl_event_of(outcome: u8) -> u8 {
    if (outcome == OC_RUNNER_UP) { return EV_RUNNER_ONLINE; }
    if (outcome == OC_RUNNER_DOWN) { return EV_RUNNER_OFFLINE; }
    if (outcome == OC_DISPATCHED) { return EV_PIPELINE_DISPATCHED; }
    if (outcome == OC_STARTED) { return EV_JOB_STARTED; }
    if (outcome == OC_PASSED) { return EV_JOB_PASSED; }
    if (outcome == OC_FAILED) { return EV_JOB_FAILED; }
    if (outcome == OC_ARTIFACT) { return EV_ARTIFACT_READY; }
    if (outcome == OC_SEALS_DONE) { return EV_SEAL_COVERAGE_COMPLETE; }
    if (outcome == OC_BLOCKED) { return EV_LANE_BLOCKED; }
    if (outcome == OC_RECOVERED) { return EV_LANE_RECOVERED; }
    return EV_NONE;
}

pub const QI_NONE : u8 = 0;
pub const QI_FIX_REQUIRED : u8 = 1;

/// A failed job yields a FIX_REQUIRED queue item; every other outcome yields none.
pub fn gl_queue_item(outcome: u8) -> u8 {
    if (outcome == OC_FAILED) { return QI_FIX_REQUIRED; }
    return QI_NONE;
}

; --- 8. Forbidden capabilities ---

pub const CAP_MERGE : u8 = 1;
pub const CAP_APPROVE : u8 = 2;
pub const CAP_FORCE_PUSH : u8 = 3;
pub const CAP_RELEASE_TAG : u8 = 4;
pub const CAP_FORK_WITH_SECRETS : u8 = 5;
pub const CAP_NON_CI_SEAL : u8 = 6;
pub const CAP_RUN_JOB : u8 = 20;
pub const CAP_REPORT : u8 = 21;
pub const CAP_UPLOAD_ARTIFACT : u8 = 22;

/// Fail closed: only the three listed lane actions are allowed; the six forbidden ones and any
/// unknown code are refused.
pub fn gl_capability_allowed(cap: u8) -> bool {
    return cap == CAP_RUN_JOB or cap == CAP_REPORT or cap == CAP_UPLOAD_ARTIFACT;
}

/// Secrets reach a job only from a trusted trigger (runner_policy.t27); fork code never gets them.
pub fn gl_secrets_ok(trigger: u8) -> bool {
    return cr_trigger_trusted(trigger);
}

/// A seal is accepted only when CI produced it.
pub fn gl_seal_accepted(produced_by_ci: bool) -> bool {
    return produced_by_ci;
}

; --- Tests ---

test merge_ignores_gitlab {
    assert merge_allowed(true, true, false);
    assert merge_allowed(true, true, true);
    assert !merge_allowed(true, false, true);
    assert !merge_allowed(false, true, true);
    assert !merge_allowed(false, false, true);
    // independence: flipping gitlab_green never changes the answer, over all four other inputs
    assert merge_allowed(true, true, true) == merge_allowed(true, true, false);
    assert merge_allowed(true, false, true) == merge_allowed(true, false, false);
    assert merge_allowed(false, true, true) == merge_allowed(false, true, false);
    assert merge_allowed(false, false, true) == merge_allowed(false, false, false);
}

test domain_label_is_registry_g {
    assert bytes_eq(GL_DOMAIN_CODE, AN_CODES[6]);
    assert bytes_eq(GL_DOMAIN_SLUG, AN_SLUGS[6]);
    // negative control: letter F is another domain
    assert !bytes_eq(GL_DOMAIN_CODE, AN_CODES[5]);
}

test record_needs_all_four {
    const c : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    assert gl_record_ok(c, "p1", "j1", "r1");
    assert !gl_record_ok("", "p1", "j1", "r1");
    assert !gl_record_ok(c, "", "j1", "r1");
    assert !gl_record_ok(c, "p1", "", "r1");
    assert !gl_record_ok(c, "p1", "j1", "");
}

test record_commit_shape {
    assert gl_commit_ok("0123456789abcdef0123456789abcdef01234567");
    // negative controls: abbreviated, uppercase, too long
    assert !gl_commit_ok("0123456");
    assert !gl_commit_ok("0123456789ABCDEF0123456789abcdef01234567");
    assert !gl_commit_ok("0123456789abcdef0123456789abcdef012345678");
    // token with a space or control byte is refused
    assert !gl_token_ok("a b");
    assert gl_token_ok("runner-7");
}

test stages_in_order {
    assert gl_stage_order_ok(GS_PREFETCH, GS_TEST);
    assert gl_stage_order_ok(GS_TEST, GS_GUARD);
    assert gl_stage_order_ok(GS_GUARD, GS_SEAL);
    assert gl_stage_order_ok(GS_SEAL, GS_VISUAL);
    assert gl_stage_order_ok(GS_VISUAL, GS_REPORT);
    assert gl_stage_order_ok(GS_TEST, GS_TEST);
    assert !gl_stage_order_ok(GS_REPORT, GS_PREFETCH);
    assert !gl_stage_order_ok(GS_SEAL, GS_TEST);
    assert !gl_stage_order_ok(GS_REPORT, 6);
}

test kinds_reuse_job_kind {
    assert GK_BUILD == LJK_GATE_BUILD;
    assert GK_SUITE == LJK_GATE_SUITE;
    assert GK_SEAL == LJK_GATE_SEAL_CURRENCY;
    assert gl_stage_of_kind(GK_PREFETCH) == GS_PREFETCH;
    assert gl_stage_of_kind(GK_SUITE) == GS_TEST;
    assert gl_stage_of_kind(GK_BUILD) == GS_TEST;
    assert gl_stage_of_kind(GK_GUARD) == GS_GUARD;
    assert gl_stage_of_kind(GK_SEAL) == GS_SEAL;
    assert gl_stage_of_kind(GK_VISUAL) == GS_VISUAL;
    assert gl_stage_of_kind(GK_REPORT) == GS_REPORT;
    assert !gl_kind_known(9999);
}

test dispatch_duplicate_refused {
    const a : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    const b : str = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    const blob : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    const ks : [2]u32 = [GK_SUITE, GK_GUARD];
    assert gl_dispatch_verdict(a, GK_SUITE, 20, false, false, false, blob, ks[0..2], 2) == GV_DUPLICATE;
    assert gl_dispatch_verdict(b, GK_GUARD, 20, false, false, false, blob, ks[0..2], 2) == GV_DUPLICATE;
    // negative controls: same commit with another kind, other commit with the same kind
    assert gl_dispatch_verdict(a, GK_GUARD, 20, false, false, false, blob, ks[0..2], 2) == GV_OK;
    assert gl_dispatch_verdict(b, GK_SUITE, 20, false, false, false, blob, ks[0..2], 2) == GV_OK;
    // an empty ledger admits
    assert gl_dispatch_verdict(a, GK_SUITE, 20, false, false, false, blob, ks[0..2], 0) == GV_OK;
    // a ledger shorter than it claims fails closed
    assert gl_dispatch_verdict(a, GK_REPORT, 20, false, false, false, blob, ks[0..2], 5) == GV_DUPLICATE;
}

test dispatch_seal_only_when_needed {
    const a : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    const blob : str = "";
    const ks : [1]u32 = [0];
    assert gl_dispatch_verdict(a, GK_SEAL, 20, false, false, false, blob, ks[0..1], 0) == GV_SEAL_NOT_NEEDED;
    assert gl_dispatch_verdict(a, GK_SEAL, 20, true, false, false, blob, ks[0..1], 0) == GV_OK;
    assert gl_dispatch_verdict(a, GK_SEAL, 20, false, true, false, blob, ks[0..1], 0) == GV_OK;
    assert gl_seal_needed(true, true);
    assert !gl_seal_needed(false, false);
}

test dispatch_heavy_needs_disk {
    const a : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    const blob : str = "";
    const ks : [1]u32 = [0];
    assert gl_dispatch_verdict(a, GK_BUILD, 7, false, false, true, blob, ks[0..1], 0) == GV_LOW_DISK;
    assert gl_dispatch_verdict(a, GK_BUILD, 8, false, false, true, blob, ks[0..1], 0) == GV_OK;
    assert gl_dispatch_verdict(a, GK_VISUAL, 0, false, false, true, blob, ks[0..1], 0) == GV_LOW_DISK;
    // a light job runs on a small disk
    assert gl_dispatch_verdict(a, GK_GUARD, 1, false, false, false, blob, ks[0..1], 0) == GV_OK;
}

test dispatch_screens_after_draft {
    const a : str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    const blob : str = "";
    const ks : [1]u32 = [0];
    assert gl_dispatch_verdict(a, GK_VISUAL, 20, false, false, false, blob, ks[0..1], 0) == GV_NO_DRAFT;
    assert gl_dispatch_verdict(a, GK_VISUAL, 20, false, false, true, blob, ks[0..1], 0) == GV_OK;
}

test dispatch_bad_input {
    const blob : str = "";
    const ks : [1]u32 = [0];
    assert gl_dispatch_verdict("abc", GK_SUITE, 20, false, false, false, blob, ks[0..1], 0) == GV_BAD_COMMIT;
    assert gl_dispatch_verdict("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 9999, 20, false, false, false, blob, ks[0..1], 0) == GV_UNKNOWN_KIND;
}

test five_shards {
    assert gl_shard_of("specs/t27os/kernel.t27") == GSH_T27OS;
    assert gl_shard_of("specs/uikit/button.t27") == GSH_UIKIT;
    assert gl_shard_of("specs/t27f/frontend.t27") == GSH_T27F;
    assert gl_shard_of("specs/domains/g.t27") == GSH_DOMAINS;
    assert gl_shard_of("specs/queen/priority.t27") == GSH_AFFECTED;
    assert GSH_COUNT == 5;
    // negative controls: not under specs/, and a prefix that is only a name start
    assert gl_shard_of("docs/readme.md") == GSH_NONE;
    assert gl_shard_of("specs/t27osx/a.t27") == GSH_AFFECTED;
}

test fix_queue_only_on_failure {
    assert gl_queue_item(OC_FAILED) == QI_FIX_REQUIRED;
    assert gl_queue_item(OC_PASSED) == QI_NONE;
    assert gl_queue_item(OC_STARTED) == QI_NONE;
    assert gl_queue_item(OC_BLOCKED) == QI_NONE;
    assert gl_queue_item(0) == QI_NONE;
}

test every_outcome_one_event {
    assert gl_event_of(OC_RUNNER_UP) == EV_RUNNER_ONLINE;
    assert gl_event_of(OC_RUNNER_DOWN) == EV_RUNNER_OFFLINE;
    assert gl_event_of(OC_DISPATCHED) == EV_PIPELINE_DISPATCHED;
    assert gl_event_of(OC_STARTED) == EV_JOB_STARTED;
    assert gl_event_of(OC_PASSED) == EV_JOB_PASSED;
    assert gl_event_of(OC_FAILED) == EV_JOB_FAILED;
    assert gl_event_of(OC_ARTIFACT) == EV_ARTIFACT_READY;
    assert gl_event_of(OC_SEALS_DONE) == EV_SEAL_COVERAGE_COMPLETE;
    assert gl_event_of(OC_BLOCKED) == EV_LANE_BLOCKED;
    assert gl_event_of(OC_RECOVERED) == EV_LANE_RECOVERED;
    // passed and failed never share an event; unknown maps to none
    assert gl_event_of(OC_PASSED) != gl_event_of(OC_FAILED);
    assert gl_event_of(0) == EV_NONE;
    assert gl_event_of(11) == EV_NONE;
    assert EV_NAMES.len == 10;
    assert bytes_eq(EV_NAMES[EV_JOB_FAILED - 1], "job_failed");
    assert bytes_eq(EV_NAMES[EV_LANE_RECOVERED - 1], "lane_recovered");
}

test forbidden_capabilities {
    assert !gl_capability_allowed(CAP_MERGE);
    assert !gl_capability_allowed(CAP_APPROVE);
    assert !gl_capability_allowed(CAP_FORCE_PUSH);
    assert !gl_capability_allowed(CAP_RELEASE_TAG);
    assert !gl_capability_allowed(CAP_FORK_WITH_SECRETS);
    assert !gl_capability_allowed(CAP_NON_CI_SEAL);
    // negative controls: the three lane actions pass; an unknown code fails closed
    assert gl_capability_allowed(CAP_RUN_JOB);
    assert gl_capability_allowed(CAP_REPORT);
    assert gl_capability_allowed(CAP_UPLOAD_ARTIFACT);
    assert !gl_capability_allowed(0);
    assert !gl_capability_allowed(99);
}

test fork_code_never_gets_secrets {
    assert !gl_secrets_ok(CR_TRG_PR_FORK);
    assert !gl_secrets_ok(CR_TRG_UNKNOWN);
    assert gl_secrets_ok(CR_TRG_PUSH_OWN);
}

test seal_must_come_from_ci {
    assert gl_seal_accepted(true);
    assert !gl_seal_accepted(false);
}
