// SPDX-License-Identifier: Apache-2.0
; specs/ci/heavy_skip.t27 -- may the heavy CI jobs be skipped for this change? CI speed request of 2026-10-20,
; epic gHashTag/t27#8095 (rebuild only what is not yet verified).
; --
; What already exists and is NOT restated here:
; - specs/ci/affected.t27 picks WHICH specs a change touches and reads the same buffer this file reads:
;   `git diff --name-status <base>...<head>` lines ("X\tpath" or "R100\told\tnew"). path_class() there is the
;   one classification of a path (seed, prose, seal, everything else); this file adds only the question the
;   heavy jobs ask. The `--graph` and `--corpus` markers are not needed here, and a buffer that carries them
;   is read up to the first marker.
; - The heavy jobs: Corpus ratchet (.github/workflows/corpus-ratchet.yml), t27b-native-ratchet
;   (t27b-native.yml) and fpga-bitstream (fpga-build.yml). They already carry `paths:` filters on some
;   triggers; a filter is a list of globs written by hand in each workflow. This is one rule, tested.
; --
; The rule (decision, fail closed):
; - SKIP only when EVERY changed path is prose: a Markdown file anywhere, or a .md/.txt file under specs/.
;   A prose file moves no verdict (affected.t27, measured #7527).
; - RUN when any changed path is
;     a compiler source (bootstrap/, cli/, Cargo.toml, Cargo.lock, build.rs)      R_COMPILER
;     a .t27 or .tri spec                                                         R_SPEC
;     a seal (.trinity/seals/)                                                    R_SEAL
;     anything else: workflows, tools, scripts, fpga/, gen/, ledgers, data       R_OTHER
;     a line that cannot be read, a status letter other than A C D M R T, a
;     quoted path, or an empty change                                             R_UNREADABLE
;   A skip needs a positive proof that nothing a heavy job reads has moved; absence of a reason to run is
;   not a reason to skip. The reason printed is the worst one (the highest code), so the same change always
;   names the same reason.
; - "All seals unchanged" is the R_SEAL line: a seal in the diff always runs the heavy jobs. A seal that only
;   moved because of a compiler bump (seal_kinds.t27 ACT_REGENERATE) is a seal in the diff.
; --
; Glue (thin): one workflow step builds the diff buffer, includes gen/c/ci/heavy_skip.c, prints the reason to
; the step summary and sets `skip=true|false` as a step output; each heavy job's steps carry `if:` on it. A
; skipped REQUIRED job must still report success, so the job is skipped by its STEPS, never by `if:` on the
; job (a skipped job's status context is not reported and the pull request goes BLOCKED with every visible
; check green, #2191). Gate and workflow files are owner-labelled: the patch ships beside this file and is not
; applied by the author.
; phi^2 + 1/phi^2 = 3 | TRINITY

module CiHeavySkip;

use ci::affected;
use policy::own_language;

/// heavy_decision() answers.
pub const HEAVY_RUN : u8 = 0;
pub const HEAVY_SKIP : u8 = 1;

/// Why. A higher code is a worse reason; R_PROSE is the only one that skips.
pub const R_PROSE : u8 = 0;
pub const R_SEAL : u8 = 1;
pub const R_SPEC : u8 = 2;
pub const R_COMPILER : u8 = 3;
pub const R_OTHER : u8 = 4;
pub const R_UNREADABLE : u8 = 5;

/// Compiler source roots and files. A list is comma separated and ends with '$' (ci/affected.t27).
pub const COMPILER_ROOTS : str = "bootstrap/,cli/,Cargo.toml,Cargo.lock,build.rs,$";

/// Why the path s[from..to] asks for the heavy jobs, or R_PROSE when it does not.
pub fn path_reason(s: []const u8, from: usize, to: usize) -> u8 {
    const c : u8 = path_class(s, from, to);
    if (c == C_ALL_UNREADABLE) { return R_UNREADABLE; }
    if (own_language::has_prefix(COMPILER_ROOTS, s, from, to)) { return R_COMPILER; }
    if (c == C_SEED) { return R_SPEC; }
    if (own_language::has_prefix(SEALS_ROOT, s, from, to)) { return R_SEAL; }
    if (c == C_NOTHING) { return R_PROSE; }
    return R_OTHER;
}

/// The worse reason of one diff line buf[s..t] (a rename or copy has two paths).
pub fn line_reason(buf: []const u8, s: usize, t: usize) -> u8 {
    // diff_class() is C_ALL_UNREADABLE for a status letter outside ACDMRT, a line without a tab and a quoted
    // path: the one reading of a diff line, not a second copy of its tables.
    if (diff_class(buf, s, t) == C_ALL_UNREADABLE) { return R_UNREADABLE; }
    const p1 : usize = first_tab(buf, s, t);
    const p2 : usize = last_tab(buf, s, t);
    var r : u8 = path_reason(buf, p2 + 1, t);
    if (p2 > p1) {
        const old : u8 = path_reason(buf, p1 + 1, p2);
        if (old > r) { r = old; }
    }
    return r;
}

/// The worst reason over buf[0..n], read up to the first `--` marker line. An empty change is R_UNREADABLE.
pub fn heavy_reason(buf: []const u8, n: usize) -> u8 {
    const g : usize = marker_at(buf, n, 0, MARK_GRAPH);
    var worst : u8 = R_PROSE;
    var lines : u32 = 0;
    var s : usize = 0;
    while (s < g) {
        const e : usize = line_end(buf, s, g);
        const t : usize = text_end(buf, s, e);
        if (t > s) {
            lines += 1;
            const r : u8 = line_reason(buf, s, t);
            if (r > worst) { worst = r; }
        }
        s = e + 1;
    }
    if (lines == 0) { return R_UNREADABLE; }
    return worst;
}

/// SKIP only for a change that is entirely prose.
pub fn heavy_decision(buf: []const u8, n: usize) -> u8 {
    if (heavy_reason(buf, n) == R_PROSE) { return HEAVY_SKIP; }
    return HEAVY_RUN;
}

test a_documentation_change_skips_the_heavy_jobs {
    assert heavy_decision("M\tREADME.md\nA\tdocs/blog/post.md\nM\tspecs/ci/NOTES.txt\n", 53) == HEAVY_SKIP;
    assert heavy_reason("M\tREADME.md\n", 12) == R_PROSE;
}

test negative_control_a_spec_a_compiler_file_or_a_seal_runs_them {
    assert heavy_decision("M\tspecs/ci/affected.t27\n", 24) == HEAVY_RUN;
    assert heavy_reason("M\tspecs/ci/affected.t27\n", 24) == R_SPEC;
    assert heavy_reason("M\tbootstrap/src/main.rs\n", 24) == R_COMPILER;
    assert heavy_reason("M\tcli/t27b/src/lower.rs\n", 24) == R_COMPILER;
    assert heavy_reason("M\tCargo.lock\n", 13) == R_COMPILER;
    assert heavy_reason("M\t.trinity/seals/a_B.json\n", 26) == R_SEAL;
    assert heavy_decision("M\t.trinity/seals/a_B.json\n", 26) == HEAVY_RUN;
}

test one_non_prose_file_among_prose_runs_them {
    assert heavy_decision("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == HEAVY_RUN;
    assert heavy_reason("M\tREADME.md\nM\ttools/dupe_scan.py\n", 33) == R_OTHER;
    assert heavy_reason("M\t.github/workflows/ci.yml\n", 27) == R_OTHER;
    assert heavy_reason("M\tfpga/top.v\n", 13) == R_OTHER;
}

test the_worst_reason_is_the_one_named {
    assert heavy_reason("M\tspecs/a.t27\nM\tbootstrap/src/x.rs\nM\tdocs/a.md\n", 47) == R_COMPILER;
    assert heavy_reason("M\t.trinity/seals/a_B.json\nM\tspecs/a.t27\n", 40) == R_SPEC;
}

test a_rename_is_judged_by_both_paths {
    // a doc renamed into a spec runs; a spec renamed to a doc also ran (the old path was a spec)
    assert heavy_decision("R100\tdocs/a.md\tspecs/a.t27\n", 27) == HEAVY_RUN;
    assert heavy_decision("R100\tspecs/a.t27\tdocs/a.md\n", 27) == HEAVY_RUN;
    assert heavy_decision("R100\tdocs/a.md\tdocs/b.md\n", 25) == HEAVY_SKIP;
}

test negative_control_unreadable_input_runs_them {
    assert heavy_decision("", 0) == HEAVY_RUN;
    assert heavy_reason("", 0) == R_UNREADABLE;
    assert heavy_decision("Q\tdocs/a.md\n", 12) == HEAVY_RUN;
    assert heavy_decision("M docs/a.md\n", 12) == HEAVY_RUN;
    assert heavy_decision("M\t\"docs/a b.md\"\n", 16) == HEAVY_RUN;
}

test the_markers_end_the_change_list {
    assert heavy_decision("M\tdocs/a.md\n--graph\nx\ty\n--corpus\nspecs/a.t27\n", 45) == HEAVY_SKIP;
}

// ---------------------------------------------------------------------------------------------------------
// NARROW (issue #13942). A third answer beside heavy_decision(), which keeps its two answers and its callers:
// heavy_narrow() is asked instead when the workflow wants the narrow run. NARROW means: every changed path is
// a spec, the seal of a changed spec, or prose; the heavy jobs then run narrow_list() (golden set first, then
// the affected specs) and not the whole corpus. Compiler, workflow, tool, ledger, unreadable: RUN.
// A seal is tied to its spec by its name: ".trinity/seals/<dir>_<Module>.json" belongs to a spec under
// specs/<dir>/<base>.t27. The seal is accepted only when a changed spec sits in that directory AND the Module
// part of the seal name (after the first '_', before ".json") ends with the spec base name, compared without
// case and ignoring every '_' on both sides (ci_CiHeavySkip.json matches specs/ci/heavy_skip.t27, not
// specs/ci/affected.t27). A module that does not follow this convention gives RUN (fail closed).
// A renamed or copied seal is RUN.
// ---------------------------------------------------------------------------------------------------------

pub const HEAVY_NARROW : u8 = 2;

/// The t27b golden set: specs with a measured reference, run first on a NARROW change. A list is comma
/// separated and ends with '$'. Every path must exist in the tree: golden_in_corpus() checks each entry against
/// the `--corpus` section of the input at run time, and narrow_list() answers RUN_ALL when one is missing.
pub const GOLDEN_SET : str = "specs/tri/t27b/golden_spec.t27,$";

/// Start of the parent directory name of s[from..to] (the text between the last two '/'), or `to` when the
/// path has no parent directory.
pub fn dir_start(s: []const u8, from: usize, to: usize) -> usize {
    const b : usize = own_language::base_start(s, from, to);
    if (b <= from) { return to; }
    var d : usize = from;
    var i : usize = from;
    while (i + 1 < b) {
        if (s[i] == '/') { d = i + 1; }
        i += 1;
    }
    return d;
}

/// Is p[pf..pt] a spec path whose parent directory is named like the part of the seal file name s[sf..st]
/// before its first '_'?
pub fn seal_matches_spec(s: []const u8, sf: usize, st: usize, p: []const u8, pf: usize, pt: usize) -> bool {
    if (path_class(p, pf, pt) != C_SEED) { return false; }
    const sb : usize = own_language::base_start(s, sf, st);
    var u : usize = sb;
    while (u < st and s[u] != '_') { u += 1; }
    if (u >= st) { return false; }
    const d : usize = dir_start(p, pf, pt);
    if (d >= pt) { return false; }
    const b : usize = own_language::base_start(p, pf, pt);
    if (same(s, sb, u, p, d, b - 1) == false) { return false; }
    const x : usize = own_language::ext_dot(s, sf, st);
    if (x >= st) { return false; }
    const pe : usize = own_language::ext_dot(p, pf, pt);
    return ends_with_name(s, u + 1, x, p, b, pe);
}

/// Does the module part s[mf..mt] end with the spec base name p[bf..bt], ignoring case and every '_' on both
/// sides? An empty base name never matches.
pub fn ends_with_name(s: []const u8, mf: usize, mt: usize, p: []const u8, bf: usize, bt: usize) -> bool {
    if (bt <= bf) { return false; }
    var i : usize = mt;
    var j : usize = bt;
    while (true) {
        while (i > mf and s[i - 1] == '_') { i -= 1; }
        while (j > bf and p[j - 1] == '_') { j -= 1; }
        if (j == bf) { return true; }
        if (i == mf) { return false; }
        if (own_language::lower(s[i - 1]) != own_language::lower(p[j - 1])) { return false; }
        i -= 1;
        j -= 1;
    }
    return false;
}

/// Is there a changed spec line in buf[0..g] that the seal s[sf..st] belongs to?
pub fn seal_has_spec(buf: []const u8, g: usize, s: []const u8, sf: usize, st: usize) -> bool {
    var i : usize = 0;
    while (i < g) {
        const e : usize = line_end(buf, i, g);
        const t : usize = text_end(buf, i, e);
        if (t > i) {
            const p2 : usize = last_tab(buf, i, t);
            if (seal_matches_spec(s, sf, st, buf, p2 + 1, t)) { return true; }
        }
        i = e + 1;
    }
    return false;
}

/// Is every seal line of buf[0..g] the seal of a changed spec (and not a rename or copy)?
pub fn seals_are_owned(buf: []const u8, g: usize) -> bool {
    var i : usize = 0;
    while (i < g) {
        const e : usize = line_end(buf, i, g);
        const t : usize = text_end(buf, i, e);
        if (t > i) {
            const p1 : usize = first_tab(buf, i, t);
            const p2 : usize = last_tab(buf, i, t);
            if (own_language::has_prefix(SEALS_ROOT, buf, p2 + 1, t)) {
                if (p2 > p1) { return false; }
                if (seal_has_spec(buf, g, buf, p2 + 1, t) == false) { return false; }
            } else if (p2 > p1 and own_language::has_prefix(SEALS_ROOT, buf, p1 + 1, p2)) {
                return false;
            }
        }
        i = e + 1;
    }
    return true;
}

/// SKIP, NARROW or RUN. SKIP is heavy_decision()'s SKIP (all prose). NARROW needs the worst reason to be a spec
/// or a seal (never compiler, other or unreadable) and every seal to belong to a changed spec.
pub fn heavy_narrow(buf: []const u8, n: usize) -> u8 {
    const r : u8 = heavy_reason(buf, n);
    if (r == R_PROSE) { return HEAVY_SKIP; }
    if (r > R_SPEC) { return HEAVY_RUN; }
    const g : usize = marker_at(buf, n, 0, MARK_GRAPH);
    if (seals_are_owned(buf, g) == false) { return HEAVY_RUN; }
    // the worst reason is R_SEAL only when no spec moved, and then no seal is owned: kept closed
    if (r == R_SEAL) { return HEAVY_RUN; }
    return HEAVY_NARROW;
}

/// Is s[f..t] one of the golden entries?
pub fn golden_has(s: []const u8, f: usize, t: usize) -> bool {
    var i : usize = 0;
    while (GOLDEN_SET[i] != LIST_END) {
        var j : usize = i;
        while (GOLDEN_SET[j] != LIST_SEP and GOLDEN_SET[j] != LIST_END) { j += 1; }
        if (same(GOLDEN_SET, i, j, s, f, t)) { return true; }
        if (GOLDEN_SET[j] == LIST_END) { return false; }
        i = j + 1;
    }
    return false;
}

/// Is s[f..t] a whole line of the `--corpus` section of buf[0..n] (exact match)?
pub fn corpus_has(buf: []const u8, n: usize, c: usize, s: []const u8, f: usize, t: usize) -> bool {
    var i : usize = line_end(buf, c, n) + 1;
    while (i < n) {
        const e : usize = line_end(buf, i, n);
        const x : usize = text_end(buf, i, e);
        if (x > i and same(buf, i, x, s, f, t)) { return true; }
        i = e + 1;
    }
    return false;
}

/// True only when EVERY GOLDEN_SET entry is a whole line of the `--corpus` section of buf[0..n]. A missing
/// or out-of-order marker is false.
pub fn golden_in_corpus(buf: []const u8, n: usize) -> bool {
    const g : usize = marker_at(buf, n, 0, MARK_GRAPH);
    if (g >= n) { return false; }
    const c : usize = marker_at(buf, n, g, MARK_CORPUS);
    if (c >= n) { return false; }
    var i : usize = 0;
    while (GOLDEN_SET[i] != LIST_END) {
        var j : usize = i;
        while (GOLDEN_SET[j] != LIST_SEP and GOLDEN_SET[j] != LIST_END) { j += 1; }
        if (corpus_has(buf, n, c, GOLDEN_SET, i, j) == false) { return false; }
        if (GOLDEN_SET[j] == LIST_END) { return true; }
        i = j + 1;
    }
    return true;
}

/// The NARROW run list into out[0..cap], one path per line: the golden set first, then the affected specs
/// (select_affected(), same input buffer) that are not golden. Returns the count, or RUN_ALL when the input
/// asks for everything or the list does not fit. set and tmp are working space.
pub fn narrow_list(buf: []const u8, n: usize, set: []u8, scap: usize, tmp: []u8, tcap: usize, out: []u8, cap: usize) -> u32 {
    if (golden_in_corpus(buf, n) == false) { return RUN_ALL; }
    const k : u32 = select_affected(buf, n, set, scap, tmp, tcap);
    if (k == RUN_ALL) { return RUN_ALL; }
    var w : usize = 0;
    var count : u32 = 0;
    var i : usize = 0;
    while (GOLDEN_SET[i] != LIST_END) {
        var j : usize = i;
        while (GOLDEN_SET[j] != LIST_SEP and GOLDEN_SET[j] != LIST_END) { j += 1; }
        var q : usize = i;
        while (q < j) {
            w = put(out, w, cap, GOLDEN_SET[q]);
            q += 1;
        }
        w = put(out, w, cap, '\n');
        count += 1;
        if (GOLDEN_SET[j] == LIST_END) { break; }
        i = j + 1;
    }
    var s : usize = 0;
    while (s < tcap) {
        const e : usize = line_end(tmp, s, tcap);
        const t : usize = text_end(tmp, s, e);
        if (t <= s) { break; }
        if (golden_has(tmp, s, t) == false) {
            var m : usize = s;
            while (m < t) {
                w = put(out, w, cap, tmp[m]);
                m += 1;
            }
            w = put(out, w, cap, '\n');
            count += 1;
        }
        s = e + 1;
    }
    if (w > cap) { return RUN_ALL; }
    return count;
}

test narrow_a_single_spec_is_narrow {
    assert heavy_narrow("M\tspecs/a/b.t27\n", 16) == HEAVY_NARROW;
    assert heavy_narrow("A\tspecs/a/b.t27\nM\tdocs/x.md\n", 28) == HEAVY_NARROW;
    assert heavy_narrow("M\tspecs/a/b.t27\nM\tspecs/c/d.t27\n", 32) == HEAVY_NARROW;
}

test narrow_a_spec_with_its_seal_is_narrow {
    assert heavy_narrow("M\tspecs/ci/heavy_skip.t27\nM\t.trinity/seals/ci_CiHeavySkip.json\n", 63) == HEAVY_NARROW;
}

test narrow_a_seal_without_its_spec_runs {
    assert heavy_narrow("M\t.trinity/seals/ci_CiHeavySkip.json\n", 37) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/tri/x.t27\nM\t.trinity/seals/ci_CiHeavySkip.json\n", 55) == HEAVY_RUN;
}

test narrow_a_siblings_seal_does_not_pass_and_the_name_rule_is_case_and_underscore_blind {
    assert heavy_narrow("M\tspecs/ci/affected.t27\nM\t.trinity/seals/ci_CiHeavySkip.json\n", 61) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/ci/gitlab_lane.t27\nM\t.trinity/seals/ci_GitlabLane.json\n", 63) == HEAVY_NARROW;
}

test narrow_a_renamed_seal_runs {
    assert heavy_narrow("M\tspecs/ci/a.t27\nR100\t.trinity/seals/ci_A.json\t.trinity/seals/ci_B.json\n", 72) == HEAVY_RUN;
}

test narrow_prose_still_skips {
    assert heavy_narrow("M\tREADME.md\nA\tdocs/blog/post.md\n", 32) == HEAVY_SKIP;
    assert heavy_narrow("M\tdocs/a.md\n--graph\nx\ty\n--corpus\nspecs/a.t27\n", 45) == HEAVY_SKIP;
}

test narrow_negative_control_compiler_workflow_tool_ledger_run {
    assert heavy_narrow("M\tspecs/a/b.t27\nM\tbootstrap/src/main.rs\n", 40) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/a/b.t27\nM\t.github/workflows/ci.yml\n", 43) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/a/b.t27\nM\ttools/dupe_scan.py\n", 37) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/a/b.t27\nM\tCargo.lock\n", 29) == HEAVY_RUN;
    assert heavy_narrow("M\tspecs/a/b.t27\nM\tspecs/RUST_DIALECT.json\n", 42) == HEAVY_RUN;
}

test narrow_negative_control_unreadable_runs {
    assert heavy_narrow("", 0) == HEAVY_RUN;
    assert heavy_narrow("Q\tspecs/a/b.t27\n", 16) == HEAVY_RUN;
    assert heavy_narrow("M specs/a/b.t27\n", 16) == HEAVY_RUN;
    assert heavy_narrow("M\t\"specs/a b.t27\"\n", 18) == HEAVY_RUN;
}

test narrow_the_old_answers_are_unchanged {
    assert heavy_decision("M\tspecs/a/b.t27\n", 16) == HEAVY_RUN;
    assert heavy_decision("M\tREADME.md\n", 12) == HEAVY_SKIP;
    assert HEAVY_NARROW != HEAVY_RUN;
    assert HEAVY_NARROW != HEAVY_SKIP;
}

test narrow_the_golden_set_is_well_formed_and_starts_with_the_t27b_spec {
    assert golden_has("specs/tri/t27b/golden_spec.t27", 0, 30) == true;
    assert golden_has("specs/a/b.t27", 0, 13) == false;
    assert own_language::in_list(GOLDEN_SET, "specs/tri/t27b/golden_spec.t27", 0, 30, false) == true;
    assert GOLDEN_SET[0] == 's';
}

test narrow_list_puts_the_golden_set_first_without_duplicates {
    var set : [256]u8 = undefined;
    var tmp : [256]u8 = undefined;
    var out : [256]u8 = undefined;
    const inp : []const u8 = "M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/a/b.t27\nspecs/tri/t27b/golden_spec.t27\n";
    assert narrow_list(inp, 78, &set, 256, &tmp, 256, &out, 256) == 2;
    assert out[0] == 's';
    assert out[30] == '\n';
    assert out[31] == 's';
    assert out[44] == '\n';
}

test narrow_list_golden_spec_in_the_diff_is_listed_once {
    var set : [256]u8 = undefined;
    var tmp : [256]u8 = undefined;
    var out : [256]u8 = undefined;
    const inp : []const u8 = "M\tspecs/tri/t27b/golden_spec.t27\n--graph\n--corpus\nspecs/tri/t27b/golden_spec.t27\n";
    assert narrow_list(inp, 81, &set, 256, &tmp, 256, &out, 256) == 1;
}

test narrow_golden_in_corpus_is_an_exact_whole_line_match {
    assert golden_in_corpus("M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/a/b.t27\nspecs/tri/t27b/golden_spec.t27\n", 78) == true;
    assert golden_in_corpus("M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/a/b.t27\n", 47) == false;
    assert golden_in_corpus("M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/tri/t27b/golden_spec.t27x\n", 65) == false;
    assert golden_in_corpus("M\tspecs/a/b.t27\n--graph\n--corpus\nxspecs/tri/t27b/golden_spec.t27\n", 65) == false;
    assert golden_in_corpus("M\tspecs/a/b.t27\n--graph\n", 24) == false;
}

test narrow_list_runs_all_when_the_golden_path_is_not_in_the_corpus {
    var set : [256]u8 = undefined;
    var tmp : [256]u8 = undefined;
    var out : [256]u8 = undefined;
    assert narrow_list("M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/a/b.t27\n", 47, &set, 256, &tmp, 256, &out, 256) == RUN_ALL;
    assert narrow_list("M\tspecs/a/b.t27\n--graph\n--corpus\nspecs/tri/t27b/golden_spec.t27x\n", 65, &set, 256, &tmp, 256, &out, 256) == RUN_ALL;
    assert narrow_list("M\tspecs/a/b.t27\n--graph\n--corpus\nxspecs/tri/t27b/golden_spec.t27\n", 65, &set, 256, &tmp, 256, &out, 256) == RUN_ALL;
    assert narrow_list("M\tspecs/a/b.t27\n--graph\n", 24, &set, 256, &tmp, 256, &out, 256) == RUN_ALL;
}

test narrow_list_asks_for_everything_when_the_input_does {
    var set : [64]u8 = undefined;
    var tmp : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    assert narrow_list("M\tbootstrap/src/x.rs\n--graph\n--corpus\nspecs/a.t27\n", 50, &set, 64, &tmp, 64, &out, 64) == RUN_ALL;
}
