// SPDX-License-Identifier: Apache-2.0
// specs/ci/pr_dashboard.t27 -- ci: pr-dashboard ends red on a transient GitHub
// API answer - retry, then report unavailable.
// Part of M6 milestone (milestone #10). Closes #13903.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::pr_dashboard;

pub const PR_DASHBOARD_MAX_RETRIES : u32 = 3;

pub struct PrDashboardResult { retries: u32, available: bool, red: bool };

pub fn pr_dashboard_available(r: PrDashboardResult) -> bool {
    return r.available;
}

pub fn pr_dashboard_red(r: PrDashboardResult) -> bool {
    return r.red && r.available;
}

test "pr_dashboard_available" {
    assert(pr_dashboard_available(PrDashboardResult { retries: 1, available: true, red: false }));
    assert(!pr_dashboard_available(PrDashboardResult { retries: 1, available: false, red: true }));
}

test "pr_dashboard_red" {
    assert(pr_dashboard_red(PrDashboardResult { retries: 1, available: true, red: true }));
    assert(!pr_dashboard_red(PrDashboardResult { retries: 1, available: true, red: false }));
}

invariant pr_dashboard_max_retries_positive {
    assert PR_DASHBOARD_MAX_RETRIES > 0;
}