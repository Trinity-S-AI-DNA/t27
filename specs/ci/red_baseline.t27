// SPDX-License-Identifier: Apache-2.0
; specs/ci/red_baseline.t27 -- the red-baseline law: which CI failures are
; pre-existing and must not fail a fresh gate, and how a run is judged against
; that ledger. The ledger is tools/red_baseline.txt: one test name per line; a
; line beginning `#` is a comment naming the date and the proof that the
; failure pre-existed (measured on master, the change stashed). The ledger
; only grows while its failures persist; shrinking it is landing a fix and
; happens in the fix's own pull request, never by editing the gate.
; The glue (the workflow step, via t27c gen-c -> gen/c/ci/red_baseline.c)
; extracts three counts with `grep`/`sort`/`comm` plumbing and asks this spec
; for the verdict. Counts, not names, cross the boundary: names are plumbing.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module CiRedBaseline;

pub const VERDICT_GREEN : u32 = 0;
pub const VERDICT_RED : u32 = 1;
; The ledger holds at most this many names; a larger ledger is a second truth
; and is refused by review, not by arithmetic.
pub const LEDGER_MAX : u32 = 64;

; Every name the run produced is either in the ledger (a baseline hit) or new.
pub fn failed_total(baseline_hits: u32, new_failures: u32) -> u32 {
    return baseline_hits + new_failures;
}

; The gate's verdict over one run.
;   new_failures: names the run produced that the ledger does not hold.
;   improved: ledger names the run did NOT produce (a fix landed).
;   total_failed: names the run produced, baseline hits and new together.
; GREEN while nothing new breaks: a run whose only failures are baseline hits
; passes, and a run with improvements passes and notes the ledger may shrink
; (improved counts ledger names the run no longer produces, so it can exceed
; total_failed: a fully green run with a stale ledger is GREEN, improved 2).
; RED the moment the run produces any name the ledger does not hold, or the
; counts are absurd (malformed plumbing is refused, never guessed).
pub fn red_baseline_verdict(new_failures: u32, improved: u32, total_failed: u32) -> u32 {
    if (new_failures > 0) {
        return VERDICT_RED;
    }
    if (improved > LEDGER_MAX) {
        return VERDICT_RED;
    }
    return VERDICT_GREEN;
}

; A ledger entry is well shaped: a non-empty name on one line, and the proof
; comment (date + measurement) is present on the `#` line above it.
pub fn entry_ok(name_len: u32, proof_len: u32) -> bool {
    if (name_len == 0) {
        return false;
    }
    if (name_len > 160) {
        return false;
    }
    return proof_len > 0;
}

; The ledger may only grow by entries whose failures were measured to
; pre-exist: adding `n` entries needs `n` proofs. Shrinking needs no proof
; here; it is the fix PR's business and `improved` reports it.
pub fn grow_ok(added: u32, proofs: u32, current_size: u32) -> bool {
    if (added > proofs) {
        return false;
    }
    return current_size + added <= LEDGER_MAX;
}

test a_run_with_only_baseline_hits_is_green {
    assert red_baseline_verdict(0, 0, 2) == VERDICT_GREEN;
    assert red_baseline_verdict(0, 0, 1) == VERDICT_GREEN;
    assert red_baseline_verdict(0, 2, 2) == VERDICT_GREEN;
    assert red_baseline_verdict(0, 1, 2) == VERDICT_GREEN;
}
test any_new_failure_is_red_whatever_improved {
    assert red_baseline_verdict(1, 0, 3) == VERDICT_RED;
    assert red_baseline_verdict(1, 2, 3) == VERDICT_RED;
    assert red_baseline_verdict(3, 0, 3) == VERDICT_RED;
}
test a_fully_green_run_is_green_and_may_shrink {
    assert red_baseline_verdict(0, 0, 0) == VERDICT_GREEN;
    assert red_baseline_verdict(0, 2, 0) == VERDICT_GREEN;
}
test counts_partition_every_failed_name {
    assert failed_total(2, 0) == 2;
    assert failed_total(2, 1) == 3;
    assert failed_total(0, 0) == 0;
    assert red_baseline_verdict(1, 0, failed_total(2, 1)) == VERDICT_RED;
}
test ledger_entries_need_a_name_and_a_proof {
    assert entry_ok(41, 60);
    assert entry_ok(1, 1);
    assert entry_ok(0, 60) == false;
    assert entry_ok(161, 60) == false;
    assert entry_ok(20, 0) == false;
}
test the_ledger_grows_only_with_proofs_and_under_the_cap {
    assert grow_ok(1, 1, 2);
    assert grow_ok(2, 2, 62);
    assert grow_ok(1, 0, 2) == false;
    assert grow_ok(3, 2, 2) == false;
    assert grow_ok(1, 1, LEDGER_MAX) == false;
    assert grow_ok(0, 0, LEDGER_MAX - 1);
}
