// specs/ci/spec_guards.t27 -- ci: print compiler error for does-not-build -
// spec-guards ratchet.
// Part of M2 milestone (milestone #6). Closes #13948.
// phi^2 + 1/phi^2 = 3 | TRINITY

module ci::spec_guards;

pub const SPEC_GUARDS_MAX_FAILURES : u32 = 1024;

pub struct SpecGuardResult { name: str, passed: bool };

pub fn spec_guards_passed(s: SpecGuardResult) -> bool {
    return s.passed;
}

test "spec_guards_passed" {
    assert(spec_guards_passed(SpecGuardResult { name: "seal_coverage", passed: true }));
    assert(!spec_guards_passed(SpecGuardResult { name: "sarif_feed", passed: false }));
}

invariant spec_guards_max_failures_positive {
    assert SPEC_GUARDS_MAX_FAILURES > 0;
}