/// trailer "lab"; a1525b09 (#4779) trailer "Agent"; 26a97535 (#7623) committed by github-actions[bot];
/// 45fdacd1 (in #1051) by "Perplexity Computer" under AgentMedia1942; d4a71646 trailer "ZCode".
pub const AGENT_COMMIT : [16]str = [
    "ddb84c5f58994da8afe3d59185f3ef121ae7065f",
    "59e47ce820b256813ce77bc150fdd59bf3048050",
    "9c2c617c45dc282529607e28a7a96614aee97d43",
    "a1525b09ad0b9a3f0b34fc6afea788388f5e2919",
    "26a975354c8ff05843fe6f374fe0ee4a8dad9945",
    "45fdacd1fb7ba611a669e6ea9612141274a1e443",
    "d4a71646faec03b9e5267a14fcb4c524cbc10d1e",
    "", "", "", "", "", "", "", "", ""
];

pub fn id_lower(c: u8) -> u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
}

/// Is t[from..to] exactly lit?
pub fn id_span_eq(t: string, from: usize, to: usize, lit: string) -> bool {
    if (to < from or to > t.len or to - from != lit.len) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (t[from + k] != lit[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Is t[from..to] lit in any case (ASCII)?
pub fn id_span_ieq(t: string, from: usize, to: usize, lit: string) -> bool {
    if (to < from or to > t.len or to - from != lit.len) { return false; }
    var k : usize = 0;
    while (k < lit.len) {
        if (id_lower(t[from + k]) != id_lower(lit[k])) { return false; }
        k = k + 1;
    }
    return true;
}

/// Are t[f..e] and u[g..h] the same bytes?
pub fn id_same(t: string, f: usize, e: usize, u: string, g: usize, h: usize) -> bool {
    if (e < f or h < g or e > t.len or h > u.len or e - f != h - g) { return false; }
    var k : usize = 0;
    while (k < e - f) {
        if (t[f + k] != u[g + k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// Does the name r[from..to] match agent row k?
pub fn agent_row_matches(r: string, from: usize, to: usize, k: u32) -> bool {
    if (k >= AGENT_ROWS or to < from or to > r.len) { return false; }
    const lit : string = AGENT_NAME[k];
    if (lit.len == 0 or to - from < lit.len) { return false; }
    if (AGENT_MATCH[k] == M_EXACT) { return id_span_eq(r, from, to, lit); }
    if (AGENT_MATCH[k] == M_PREFIX) { return id_span_eq(r, from, from + lit.len, lit); }
    if (AGENT_MATCH[k] == M_SUFFIX) { return id_span_eq(r, to - lit.len, to, lit); }
    return false;
}

/// Is r[from..to] an agent's name: does some agent row match it?
pub fn agent_name(r: string, from: usize, to: usize) -> bool {
    var k : u32 = 0;
    while (k < AGENT_ROWS) {
        if (agent_row_matches(r, from, to, k)) { return true; }
        k = k + 1;
    }
    return false;
}

/// Is `id` an account an agent row cites (SRC_ACCOUNT)?
pub fn account_agent(id: u64) -> bool {
    if (id_account_known(id) == false) { return false; }
    var k : u32 = 0;
    while (k < AGENT_ROWS) {
        if (AGENT_SOURCE[k] == SRC_ACCOUNT and AGENT_ACCOUNT[k] == id) { return true; }
        k = k + 1;
    }
    return false;
}

// --- The table -----------------------------------------------------------------------------------

/// A participants table (parts rows) and the facts bound to them (bindings rows). b_part names a
/// participant row; b_pr, b_pr_author and b_commit are EV_PR's; b_signer (a binding row) and b_sig
/// (hex) are EV_SIGNED's.
pub struct IdentityTable {
    parts: u32,
    account: [16]u64,
    role: [16]u8,
    name: [16]str,
    bindings: u32,
    b_part: [16]u32,
    b_kind: [16]u8,
    b_value: [16]str,
    b_ev: [16]u8,
    b_pr: [16]u64,
    b_pr_author: [16]u64,
    b_commit: [16]str,
    b_signer: [16]u32,
    b_sig: [16]str,
}

