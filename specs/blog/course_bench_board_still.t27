// SPDX-License-Identifier: Apache-2.0
// specs/blog/course_bench_board_still.t27 -- the still for the course bench-board post.
// Issue gHashTag/t27#13248. 214 x 70 logical cells, scale 3, so the P6 is 642 x 210.
//
// Four lines and a rule, from specs/boards/ax7203.t27. The lines are the 5x7 font in
// frame_render, drawn 1:1 on the logical grid, then each logical pixel is copied to a
// 3x3 block. The text view reads those blocks. A uniform block is not a screenshot, and
// this file does not claim a browser has shown the PNG.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module course_bench_board_still;

use boards::ax7203::BOARD_NAME;
use boards::ax7203::FPGA_PART;
use boards::ax7203::PACKAGE;
use boards::ax7203::PACKAGE_BALLS;
use boards::ax7203::WUKONG_PACKAGE_BALLS;
use t27f::frame_render::clear_rgb;
use t27f::frame_render::draw_text;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::FONT;
use t27f::frame_render::FONT_W;
use t27f::frame_render::FONT_H;
use t27f::frame_render::FONT_ADVANCE;
use t27f::frame_render::glyph_index;
use t27f::frame_render::TEXT_TRANSPARENT;
use t27f::frame_render::FRAME_OK;
use t27f::scene::Q8;
use t27f::still_text_main::p6_open;
use t27f::still_text_main::cell_char;
use t27f::still_text_main::cell_kind;
use t27f::still_text_main::mixed_cells;
use t27f::still_text_main::P6_OK;
use t27f::still_text_main::P6_TRUNC;
use t27f::still_text_main::CELL_LIGHT;
use t27f::still_text_main::CELL_DARK;

pub const CELL_W : u32 = 214;
pub const CELL_H : u32 = 70;
pub const SCALE : u32 = 3;
pub const OUT_W : u32 = 642;
pub const OUT_H : u32 = 210;
pub const INK : i32 = 0xFFFFFF;
pub const LINE_X : u32 = 8;
pub const LINE_Y0 : u32 = 8;
pub const LINE_Y1 : u32 = 20;
pub const LINE_Y2 : u32 = 32;
pub const RULE_Y : u32 = 44;
pub const LINE_Y3 : u32 = 52;
pub const RULE_X0 : u32 = 8;
pub const RULE_X1 : u32 = 206;

pub const LINE_BOARD : str = "ALINX AX7203";
pub const LINE_PART : str = "xc7a200tfbg484-2";
pub const LINE_BALLS : str = "484 balls";
pub const LINE_PINMAP : str = "676 pin-map balls";

pub const CELL_BYTES : usize = 44940;
pub const RGB_BYTES : usize = 404460;
pub const PPM_BYTES : usize = 404475;

pub var STILL_CELL : [44940]u8 = [0] ** 44940;
pub var STILL_RGB : [404460]u8 = [0] ** 404460;
pub var STILL_PPM : [404475]u8 = [0] ** 404475;

pub fn still_out_w() -> u32 {
    return OUT_W;
}

pub fn still_out_h() -> u32 {
    return OUT_H;
}

pub fn still_scale() -> u32 {
    return SCALE;
}

fn font_on(ch: u8, col: u32, row: u32) -> bool {
    const g = glyph_index(ch) as usize;
    const bits = FONT[g][row as usize];
    return (((bits as u32) >> (FONT_W - 1 - col)) & 1) == 1;
}

fn line_matches(ppm: []const u8, y: u32, s: str) -> bool {
    const info = p6_open(ppm);
    if (info.code != P6_OK) {
        return false;
    }
    var i : usize = 0;
    while (i < s.len) {
        var r : u32 = 0;
        while (r < FONT_H) {
            var c : u32 = 0;
            while (c < FONT_W) {
                const lx = LINE_X + (i as u32) * FONT_ADVANCE + c;
                const ly = y + r;
                const ch = cell_char(ppm, info, SCALE, lx, ly);
                const on = font_on(s[i], c, r);
                if (on && ch != CELL_LIGHT) {
                    return false;
                }
                if (!on && ch != CELL_DARK) {
                    return false;
                }
                c = c + 1;
            }
            r = r + 1;
        }
        i = i + 1;
    }
    return true;
}

fn paint_line(cell: []u8, y: u32, s: str) -> u8 {
    var buf : [40]u8 = [0] ** 40;
    var i : usize = 0;
    var n : usize = s.len;
    if (n > 40) {
        n = 40;
    }
    while (i < n) {
        buf[i] = s[i];
        i = i + 1;
    }
    return draw_text(cell, CELL_W, CELL_H, LINE_X as i32, y as i32, buf[0..n], INK, TEXT_TRANSPARENT, Q8);
}

fn paint_rule(cell: []u8) -> void {
    var x : u32 = RULE_X0;
    while (x < RULE_X1) {
        const p = ((RULE_Y * CELL_W + x) * 3) as usize;
        cell[p] = 255;
        cell[p + 1] = 255;
        cell[p + 2] = 255;
        x = x + 1;
    }
}

fn scale_copy(cell: []const u8, rgb: []u8) -> void {
    var y : u32 = 0;
    while (y < CELL_H) {
        var x : u32 = 0;
        while (x < CELL_W) {
            const s = ((y * CELL_W + x) * 3) as usize;
            var dy : u32 = 0;
            while (dy < SCALE) {
                var dx : u32 = 0;
                while (dx < SCALE) {
                    const ox = x * SCALE + dx;
                    const oy = y * SCALE + dy;
                    const d = ((oy * OUT_W + ox) * 3) as usize;
                    rgb[d] = cell[s];
                    rgb[d + 1] = cell[s + 1];
                    rgb[d + 2] = cell[s + 2];
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

// Paint the logical grid, scale it, and write the P6 into `ppm`. 0 when every step accepts.
pub fn paint_into(cell: []u8, rgb: []u8, ppm: []u8) -> u8 {
    var bad : u8 = clear_rgb(cell, CELL_W, CELL_H);
    bad = bad + paint_line(cell, LINE_Y0, LINE_BOARD);
    bad = bad + paint_line(cell, LINE_Y1, LINE_PART);
    bad = bad + paint_line(cell, LINE_Y2, LINE_BALLS);
    bad = bad + paint_line(cell, LINE_Y3, LINE_PINMAP);
    paint_rule(cell);
    scale_copy(cell, rgb);
    bad = bad + ppm_write_into(ppm, rgb, OUT_W, OUT_H);
    return bad;
}

pub fn paint() -> u8 {
    return paint_into(&STILL_CELL, &STILL_RGB, &STILL_PPM);
}

test "the output is the logical grid times three, and the file is 404475 bytes" {
    assert(OUT_W == CELL_W * SCALE);
    assert(OUT_H == CELL_H * SCALE);
    assert(still_out_w() == 642);
    assert(still_out_h() == 210);
    assert(still_scale() == 3);
    assert(ppm_len(OUT_W, OUT_H) == 404475);
    assert(PPM_BYTES == 404475);
    assert(RGB_BYTES == 404460);
    assert(CELL_BYTES == 44940);
}

test "the four lines are the board spec's own name, part and ball counts" {
    assert(BOARD_NAME == LINE_BOARD);
    assert(FPGA_PART == LINE_PART);
    assert(PACKAGE == "fbg484");
    assert(PACKAGE_BALLS == 484);
    assert(WUKONG_PACKAGE_BALLS == 676);
    assert(PACKAGE_BALLS != WUKONG_PACKAGE_BALLS);
}

test "paint writes a P6 whose blocks are uniform and whose lines match the font" {
    assert(paint() == FRAME_OK);
    const want : str = "P6\n642 210\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert(STILL_PPM[i] == want[i]);
        i = i + 1;
    }
    const info = p6_open(STILL_PPM[0..PPM_BYTES]);
    assert(info.code == P6_OK);
    assert(info.w == OUT_W);
    assert(info.h == OUT_H);
    assert(mixed_cells(STILL_PPM[0..PPM_BYTES], info, SCALE) == 0);
    assert(line_matches(STILL_PPM[0..PPM_BYTES], LINE_Y0, LINE_BOARD));
    assert(line_matches(STILL_PPM[0..PPM_BYTES], LINE_Y1, LINE_PART));
    assert(line_matches(STILL_PPM[0..PPM_BYTES], LINE_Y2, LINE_BALLS));
    assert(line_matches(STILL_PPM[0..PPM_BYTES], LINE_Y3, LINE_PINMAP));
}

test "the rule is a light row and the row above it is dark" {
    assert(paint() == FRAME_OK);
    const info = p6_open(STILL_PPM[0..PPM_BYTES]);
    assert(info.code == P6_OK);
    var x : u32 = RULE_X0;
    while (x < RULE_X1) {
        assert(cell_kind(STILL_PPM[0..PPM_BYTES], info, SCALE, x, RULE_Y) == 1);
        assert(cell_kind(STILL_PPM[0..PPM_BYTES], info, SCALE, x, RULE_Y - 1) == 0);
        x = x + 1;
    }
}

test "a truncated header of this file is not a still" {
    assert(paint() == FRAME_OK);
    const info = p6_open(STILL_PPM[0..8]);
    assert(info.code == P6_TRUNC);
    assert(cell_char(STILL_PPM[0..8], info, SCALE, 0, 0) == 0);
}
