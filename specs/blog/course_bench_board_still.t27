// SPDX-License-Identifier: Apache-2.0
// specs/blog/course_bench_board_still.t27 -- the figure of the Trinity-S-AI-DNA/trinity#1806 post,
// drawn by T27F as a still.
//
// WHY. The post (specs/blog/course_bench_board.t27) carries one widget. Its picture is a T27F still
// (specs/t27f/frontend.t27, SF_STILL, made on the lab), drawn from the board spec's own constants
// instead of an SVG string typed by hand. The T27F rasterizer specs/t27f/frame_render.t27 paints
// the text with its 5x7 font (draw_text); this module lays out four lines and one rule at 1:1,
// scales the raster by an integer factor (nearest neighbour, so one font pixel becomes a
// SCALE x SCALE block), and frame_render's ppm_write_into lays the P6 file down. The program that
// writes the file to standard output is specs/blog/course_bench_board_still_main.t27, built
// natively by t27b (libSystem only, like specs/t27os/plist_main.t27).
//
// WHAT IS DRAWN. Line 1: "bench board   " + BOARD_NAME. Line 2: "package       " + PACKAGE in
// capitals + ", " + PACKAGE_BALLS + " balls". A rule. Line 3: "pin map draws FGG676, " +
// WUKONG_PACKAGE_BALLS + " balls". Line 4: "(the package of the Wukong board)". The board name, the
// package and both ball counts come from specs/boards/ax7203.t27; "FGG676" and the labels are the
// only words of this file.
//
// HOW IT REACHES THE POST. The trinity blog has no block kind for a still (its figure block reads
// an SVG string), so the post's figure is an SVG whose one element is an <image> of the still,
// re-encoded as PNG and served from trinity apps/website/public (owner's choice, 2026-11-07).
//
// NOT CLAIMED. That the still reads well: the tests check pixels by coordinate, not legibility.
// specs/t27f/still_text_main.t27 prints the file as text for the eye; a browser view is not run.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module blog_course_bench_board_still;

use std::mem::bytes_eq;
use t27f::frame_render::clear_rgb;
use t27f::frame_render::draw_text;
use t27f::frame_render::ppm_len;
use t27f::frame_render::glyph_index;
use t27f::frame_render::FONT;
use t27f::frame_render::FONT_W;
use t27f::frame_render::FONT_H;
use t27f::frame_render::FONT_ADVANCE;
use t27f::frame_render::FRAME_OK;
use t27f::frame_render::E_RANGE;
use t27f::frame_render::R_BG;
use t27f::still_text_main::px_at;
use t27f::scene::Q8;
use tri::t27b::macho::put_bytes;
use tri::t27b::macho::put_dec;
use boards::ax7203::BOARD_NAME;
use boards::ax7203::PACKAGE;
use boards::ax7203::PACKAGE_BALLS;
use boards::ax7203::WUKONG_PACKAGE_BALLS;

// The raster at 1:1 and the scaled still.
pub const BASE_W : u32 = 214;
pub const BASE_H : u32 = 70;
pub const SCALE : u32 = 3;
pub const OUT_W : u32 = 642;
pub const OUT_H : u32 = 210;
pub const BASE_BYTES : u32 = 44940;     // 3 * BASE_W * BASE_H
pub const OUT_BYTES : u32 = 404460;     // 3 * OUT_W * OUT_H
pub const PPM_BYTES : u32 = 404475;     // "P6\n642 210\n255\n" (15 bytes) + OUT_BYTES

// The layout at 1:1: four text lines and one rule between lines 2 and 3.
pub const MARGIN : u32 = 8;
pub const LINES : u32 = 4;
pub const LINE_Y : [4]u32 = [8, 20, 42, 54];
pub const RULE_Y : u32 = 34;
pub const LINE_MAX : usize = 48;
pub const INK : i32 = 0xF2F2F2;
pub const RULE_INK : i32 = 0x8A8F96;
pub const NO_BG : i32 = -1;

/// Copy s into out at `at` with a..z in capitals; the index after the last byte.
pub fn put_upper(out: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        var c : u8 = s[i];
        if (c >= 97 and c <= 122) {
            c = c - 32;
        }
        out[at + i] = c;
        i = i + 1;
    }
    return at + s.len;
}

/// Line k of the still into out; its length. A k past the last line writes nothing.
pub fn line_into(k: u32, out: []u8) -> usize {
    var n : usize = 0;
    if (k == 0) {
        n = put_bytes(out, 0, "bench board   ");
        n = put_bytes(out, n, BOARD_NAME);
    } else if (k == 1) {
        n = put_bytes(out, 0, "package       ");
        n = put_upper(out, n, PACKAGE);
        n = put_bytes(out, n, ", ");
        n = put_dec(out, n, PACKAGE_BALLS as usize);
        n = put_bytes(out, n, " balls");
    } else if (k == 2) {
        n = put_bytes(out, 0, "pin map draws FGG676, ");
        n = put_dec(out, n, WUKONG_PACKAGE_BALLS as usize);
        n = put_bytes(out, n, " balls");
    } else if (k == 3) {
        n = put_bytes(out, 0, "(the package of the Wukong board)");
    }
    return n;
}

/// Paint row y from x0 up to x1 (exclusive) with an opaque colour.
fn hline(rgb: []u8, w: u32, x0: u32, x1: u32, y: u32, color: i32) -> void {
    var x : u32 = x0;
    while (x < x1) {
        const p : usize = ((y * w + x) * 3) as usize;
        rgb[p] = ((color >> 16) & 255) as u8;
        rgb[p + 1] = ((color >> 8) & 255) as u8;
        rgb[p + 2] = (color & 255) as u8;
        x = x + 1;
    }
}

/// How many pixels of rows y0..y1 (exclusive) carry exactly `color`.
pub fn count_color(rgb: []const u8, w: u32, y0: u32, y1: u32, color: i32) -> u32 {
    var n : u32 = 0;
    var y : u32 = y0;
    while (y < y1) {
        var x : u32 = 0;
        while (x < w) {
            if (px_at(rgb, w, x, y) == color) {
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

/// The still at 1:1: clear to frame_render's background, four lines in INK, the rule.
pub fn render_base(base: []u8) -> u8 {
    if (base.len < (BASE_BYTES as usize)) { return E_RANGE; }
    const c = clear_rgb(base, BASE_W, BASE_H);
    if (c != FRAME_OK) { return c; }
    var line : [48]u8 = undefined;
    var k : u32 = 0;
    while (k < LINES) {
        const n = line_into(k, line[0..48]);
        const r = draw_text(base, BASE_W, BASE_H, MARGIN as i32, LINE_Y[k] as i32, line[0..n], INK, NO_BG, Q8);
        if (r != FRAME_OK) { return r; }
        k = k + 1;
    }
    hline(base, BASE_W, MARGIN, BASE_W - MARGIN, RULE_Y, RULE_INK);
    return FRAME_OK;
}

/// Nearest-neighbour scale by k: dst pixel (x, y) is src pixel (x div k, y div k).
pub fn upscale_into(dst: []u8, src: []const u8, sw: u32, sh: u32, k: u32) -> u8 {
    if (k == 0) { return E_RANGE; }
    const dw = sw * k;
    const dh = sh * k;
    if (src.len < ((3 * sw * sh) as usize)) { return E_RANGE; }
    if (dst.len < ((3 * dw * dh) as usize)) { return E_RANGE; }
    var y : u32 = 0;
    while (y < dh) {
        var x : u32 = 0;
        while (x < dw) {
            const s : usize = (((y / k) * sw + (x / k)) * 3) as usize;
            const d : usize = ((y * dw + x) * 3) as usize;
            dst[d] = src[s];
            dst[d + 1] = src[s + 1];
            dst[d + 2] = src[s + 2];
            x = x + 1;
        }
        y = y + 1;
    }
    return FRAME_OK;
}

/// The still at OUT_W x OUT_H into out (OUT_BYTES of RGB).
pub fn render_into(out: []u8) -> u8 {
    if (out.len < (OUT_BYTES as usize)) { return E_RANGE; }
    var base : [44940]u8 = undefined;
    const r = render_base(base[0..44940]);
    if (r != FRAME_OK) { return r; }
    return upscale_into(out, base[0..44940], BASE_W, BASE_H, SCALE);
}

test the_sizes_are_the_constants {
    assert(OUT_W == BASE_W * SCALE);
    assert(OUT_H == BASE_H * SCALE);
    assert(BASE_BYTES == 3 * BASE_W * BASE_H);
    assert(OUT_BYTES == 3 * OUT_W * OUT_H);
    assert(ppm_len(OUT_W, OUT_H) == PPM_BYTES);
}

test the_lines_carry_the_board_spec {
    var b : [48]u8 = undefined;
    var n : usize = line_into(0, b[0..48]);
    assert(bytes_eq(b[0..n], "bench board   ALINX AX7203"));
    n = line_into(1, b[0..48]);
    assert(bytes_eq(b[0..n], "package       FBG484, 484 balls"));
    // Negative control: the bench package does not have the pin map's ball count.
    assert(!bytes_eq(b[0..n], "package       FBG484, 676 balls"));
    n = line_into(2, b[0..48]);
    assert(bytes_eq(b[0..n], "pin map draws FGG676, 676 balls"));
    n = line_into(3, b[0..48]);
    assert(bytes_eq(b[0..n], "(the package of the Wukong board)"));
    assert(line_into(LINES, b[0..48]) == 0);
}

test every_line_fits_and_no_band_touches_the_rule {
    var b : [48]u8 = undefined;
    var k : u32 = 0;
    while (k < LINES) {
        const n : usize = line_into(k, b[0..48]);
        assert(n <= LINE_MAX);
        // The last glyph's blank column is not ink, hence the - 1.
        assert(MARGIN + (n as u32) * FONT_ADVANCE - 1 <= BASE_W - MARGIN);
        assert(LINE_Y[k] + FONT_H <= BASE_H);
        assert(LINE_Y[k] + FONT_H < RULE_Y or LINE_Y[k] > RULE_Y);
        k = k + 1;
    }
}

test the_base_paints_ink_rule_and_background {
    var base : [44940]u8 = undefined;
    assert(render_base(base[0..44940]) == FRAME_OK);
    assert(px_at(base[0..44940], BASE_W, 0, 0) == R_BG);
    assert(px_at(base[0..44940], BASE_W, BASE_W - 1, BASE_H - 1) == R_BG);
    // The rule: inside the margins only.
    assert(count_color(base[0..44940], BASE_W, RULE_Y, RULE_Y + 1, RULE_INK) == BASE_W - 2 * MARGIN);
    assert(px_at(base[0..44940], BASE_W, MARGIN - 1, RULE_Y) == R_BG);
    // Every text band has ink; the gaps above line 1 and between lines 1 and 2 have none.
    var k : u32 = 0;
    while (k < LINES) {
        assert(count_color(base[0..44940], BASE_W, LINE_Y[k], LINE_Y[k] + FONT_H, INK) > 0);
        k = k + 1;
    }
    assert(count_color(base[0..44940], BASE_W, 0, LINE_Y[0], INK) == 0);
    assert(count_color(base[0..44940], BASE_W, LINE_Y[0] + FONT_H, LINE_Y[1], INK) == 0);
    // The top-left pixel of the first glyph is ink exactly when frame_render's FONT says so.
    const g = glyph_index(98);
    const on = ((FONT[g as usize][0] as u32) >> (FONT_W - 1)) & 1;
    const p = px_at(base[0..44940], BASE_W, MARGIN, LINE_Y[0]);
    assert((on == 1 and p == INK) or (on == 0 and p == R_BG));
}

test the_scale_is_exact_and_a_short_buffer_is_refused {
    // A 2 x 1 raster, red then blue, scaled by 3: each pixel becomes a 3 x 3 block.
    var src : [6]u8 = [255, 0, 0, 0, 0, 255];
    var dst : [54]u8 = undefined;
    assert(upscale_into(dst[0..54], src[0..6], 2, 1, 3) == FRAME_OK);
    assert(px_at(dst[0..54], 6, 0, 0) == 0xFF0000);
    assert(px_at(dst[0..54], 6, 2, 2) == 0xFF0000);
    assert(px_at(dst[0..54], 6, 3, 0) == 0x0000FF);
    assert(px_at(dst[0..54], 6, 5, 2) == 0x0000FF);
    // Negative controls: a short destination and a zero factor are refused, nothing scaled.
    assert(upscale_into(dst[0..53], src[0..6], 2, 1, 3) == E_RANGE);
    assert(upscale_into(dst[0..54], src[0..6], 2, 1, 0) == E_RANGE);
    var small : [16]u8 = undefined;
    assert(render_into(small[0..16]) == E_RANGE);
}
