; The epic progress post, one dated entry per iteration that moved an epic's
; percent, in the owner's one format (rule of 2026-10-26, t27#12629). First
; entry: the merge-train and repo hygiene epic, #12660, the night of
; 2026-10-26. The pattern, the PostBlock shape and the headline tests follow
; specs/blog/t27b_progress.t27; every number comes from a gh command named in
; the epic's ## Dashboard section (issue #12660), never from memory.

; Columns, one index per entry:
;   DATE        UTC day of the iteration, yyyymmdd
;   EPIC        the epic issue number
;   OPEN_START  open PRs when the iteration began
;   OPEN_END    open PRs when it ended
;   MERGED      PRs merged that UTC day
;   BR_START    remote branches when the iteration began
;   BR_END      remote branches when it ended
;   QUEUE_PEAK  the Actions queue's peak queued-run count measured that day

; Entry 0 is the 2026-10-26 night: the queue swept with armed squash
; auto-merge, two #5980 label landings proven, the branch sweep run with
; records (issue #1453). Sources: gh pr list, gh api actions/runs,
; git ls-remote, issue #1453.

module BlogEpicProgress;

pub struct PostBlock {
    kind: str,
    text: str,
}

; Two entries, so the columns are [2]u32 arrays -- two elements emit cleanly
; (the #5980 single-element defect only bites [1]T, which is why entry 0
; shipped as scalars). Entry indexes: 0 = the first shift of 2026-10-26,
; 1 = the second shift, the night's continuation.
pub const DATE: [2]u32 = [20261026, 20261027];
pub const EPIC: [2]u32 = [12660, 12660];
pub const OPEN_START: [2]u32 = [55, 14];
pub const OPEN_END: [2]u32 = [25, 16];
pub const MERGED: [2]u32 = [54, 7];
pub const BR_START: [2]u32 = [6391, 678];
pub const BR_END: [2]u32 = [678, 696];
pub const QUEUE_PEAK: [2]u32 = [502, 139];

; SHOWN names entry 1, the newest. The percent is i32 and can be negative:
; the second shift GREW the open count 14 -> 16 (the storm's aftermath
; refilled the train with newly armed work) -- a format that cannot print a
; true negative must not be handed a false positive.
pub const SHOWN_DATE: u32 = 20261027;
pub const SHOWN_OPEN_START: i32 = 14;
pub const SHOWN_OPEN_END: i32 = 16;
pub const SHOWN_MERGED: u32 = 7;
pub const SHOWN_BR_START: u32 = 678;
pub const SHOWN_BR_END: u32 = 696;
; Tenths of a percent, rounded to nearest: (14 - 16) / 14 = -14.3% -> -143.
pub const SHOWN_CLEARED_PCT_TENTHS: i32 = -143;

pub const ID: str = "blog/merge-train-and-repo-hygiene";
pub const SLUG: str = "merge-train-and-repo-hygiene";
pub const TITLE: str = "The second shift: two queue storms tamed, the red-x sweep scored, floor 13 completed";
pub const SUMMARY: str = "[measured] The second shift merged 7 more pull requests behind two queue storms -- 502 peaked, 139 refilled, 0 by midnight -- scored the 16 red workflows into classes with owners, completed wasm floor 13 to 12 of 12 Node-verified tests, and recorded the one number that went the wrong way: open pull requests 14 to 16.";
pub const DATE_ISO: str = "2026-10-26";
pub const TAGS: [3]str = ["t27", "Automation", "Measurement"];

pub const body: [8]PostBlock = [
    PostBlock { kind: "p", text: "[measured] The second shift of the same UTC night began with the Actions queue refilled to 139 queued runs and ended with it at 0. Between the storms the shift merged 7 pull requests, scored 16 red workflows into classes with owners, and completed the wasm law's floor 13 -- while the open pull-request count went 14 to 16, recorded here as -14.3% because a format that cannot print a true negative must not be handed a false positive." },
    PostBlock { kind: "h", text: "The two storms" },
    PostBlock { kind: "p", text: "[measured] The first storm peaked at 502 queued runs, drained to 22, and refilled to 139. The valve that tamed the second half is #12709: cancel-in-progress narrowed to pull_request events only, so superseded runs die but the scheduled batches that produce master's verdicts survive -- the 16:07Z build failures had never once been re-run because every new batch ate the rerun. The first uncancelled batch gave class C its verdict: Verilog Widths and Spec Parse Ratchet green, the failures confirmed transient." },
    PostBlock { kind: "h", text: "The red-x sweep, scored" },
    PostBlock { kind: "p", text: "[measured] Sixteen red workflows classified into classes A-G (issue #12708). C healed. A's remainder moved to infrastructure: the seal-autofix law landed as specs/policy/seal_autofix.t27 (#12714) and the bees' workflow is in flight (#12707). B and the wasm seal ride #12711. D and E got their fixes armed (#12717): the queue-health yml that could not parse now loads, the branch-filter ceiling dropped 24 to 23 with three files classified, and the dead canary's fixture swapped the graduated tri git for a verified-dead name." },
    PostBlock { kind: "h", text: "Floor 13, completed" },
    PostBlock { kind: "p", text: "[measured] #12172 landed the wasm law's floor-13 shape without its definitions -- no WOP constants, no bitwise_opcode, no shift_opcode, and a generated file still spelling the old refusal. The completion (#12711, armed) defines the six M-D opcodes, regenerates the generated file, re-seals, and passes wasm32 at 12 of 12 with Node proving the runtime truths; the wrapping family is corrected to its real meaning and lowered on the same bytes." },
    PostBlock { kind: "p", text: "Newest last, one entry per iteration; the source is specs/blog/epic_progress.t27. Every number names its gh command in epic #12660's Dashboard." },
];

; The test runtime silently skips array-index expressions inside assert
; (filed on #5980: a pass with the assert never executed), so the reads go
; through functions -- a call lowers, a bare index does not.
pub fn open_start_at(i: u32) -> u32 {
    if (i == 0) { return OPEN_START[0]; }
    return OPEN_START[1];
}
pub fn open_end_at(i: u32) -> u32 {
    if (i == 0) { return OPEN_END[0]; }
    return OPEN_END[1];
}
pub fn br_start_at(i: u32) -> u32 {
    if (i == 0) { return BR_START[0]; }
    return BR_START[1];
}
pub fn br_end_at(i: u32) -> u32 {
    if (i == 0) { return BR_END[0]; }
    return BR_END[1];
}

test the_whole_arc_shrinks_even_when_a_shift_grows {
    assert(open_end_at(1) < open_start_at(0));
    assert(br_end_at(1) < br_start_at(0));
}

test the_post_shows_the_newest_entry {
    assert_eq(SHOWN_DATE, DATE[1]);
    assert_eq(SHOWN_OPEN_START, open_start_at(1));
    assert_eq(SHOWN_OPEN_END, open_end_at(1));
    assert_eq(SHOWN_MERGED, MERGED[1]);
    assert_eq(SHOWN_BR_START, br_start_at(1));
    assert_eq(SHOWN_BR_END, br_end_at(1));
}

pub fn shown_pct() -> i32 {
    return ((SHOWN_OPEN_START - SHOWN_OPEN_END) * 1000 - SHOWN_OPEN_START / 2) / SHOWN_OPEN_START;
}

test the_shown_percentage_is_the_shown_counts {
    assert_eq(SHOWN_CLEARED_PCT_TENTHS, shown_pct());
}

; --- the next-entry skeleton, computed (owner, 2026-10-27) --------------------
; The form of entry N+1, computed from the current arrays: every column is
; re-emitted with its stored values verbatim and a MEASURE mark in the new
; slot, to be filled from the three measuring commands of
; EPIC_ENTRY_HOWTO.md. A placeholder that reaches master is a lie, so the
; tests pin the shape: one MEASURE per column, the stored values intact.

pub const SKELETON_MEASURE : str = "MEASURE";

fn put_str(out: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len) { out[at + i] = s[i]; i += 1; }
    return at + s.len;
}

fn put_num(out: []u8, at: usize, v: u32) -> usize {
    if (v == 0) { out[at] = '0'; return at + 1; }
    var digits : [10]u8 = undefined;
    var n : usize = 0;
    var x : u32 = v;
    while (x > 0) { digits[n] = '0' + (x % 10) as u8; n += 1; x = x / 10; }
    var j : usize = 0;
    var at2 : usize = at;
    while (j < n) { out[at2] = digits[n - 1 - j]; at2 += 1; j += 1; }
    return at2;
}

fn put_col(out: []u8, at: usize, name: []const u8, values: []const u32) -> usize {
    var at2 : usize = put_str(out, at, "pub const ");
    at2 = put_str(out, at2, name);
    at2 = put_str(out, at2, ": [");
    at2 = put_num(out, at2, (values.len + 1) as u32);
    at2 = put_str(out, at2, "]u32 = [");
    var i : usize = 0;
    while (i < values.len) {
        at2 = put_num(out, at2, values[i]);
        at2 = put_str(out, at2, ", ");
        i += 1;
    }
    return put_str(out, at2, "MEASURE];\n");
}

pub fn next_skeleton(out: []u8, cap: usize) -> usize {
    var at : usize = 0;
    at = put_col(out, at, "DATE", &DATE);
    at = put_col(out, at, "OPEN_START", &OPEN_START);
    at = put_col(out, at, "OPEN_END", &OPEN_END);
    at = put_col(out, at, "MERGED", &MERGED);
    at = put_col(out, at, "BR_START", &BR_START);
    at = put_col(out, at, "BR_END", &BR_END);
    at = put_col(out, at, "QUEUE_PEAK", &QUEUE_PEAK);
    return at;
}

; how many times the needle occurs in the buffer: the skeleton test counts
; MEASURE marks this way, one per column.
fn count_needle(buf: []const u8, needle: []const u8) -> u32 {
    var found : u32 = 0;
    var i : usize = 0;
    while (i + needle.len <= buf.len) {
        var ok : bool = true;
        var j : usize = 0;
        while (j < needle.len) {
            if (buf[i + j] != needle[j]) { ok = false; }
            j += 1;
        }
        if (ok) { found += 1; }
        i += 1;
    }
    return found;
}

; seven columns, one MEASURE mark each, every stored value carried verbatim,
; every column re-declared one element longer than it is today -- pinned as a
; FORM (counts of shapes), never as values, so the test survives every entry
; that lands after it.
test the_skeleton_names_every_column_and_carries_the_stored_values {
    var out : [2048]u8 = undefined;
    var n : usize = next_skeleton(out[0..2048], 2048);
    assert n > 0 and n < 2048;
    assert count_needle(out[0..n], SKELETON_MEASURE) == 7;
    assert count_needle(out[0..n], "]u32 = [") == 7;
    assert count_needle(out[0..n], ", MEASURE];") == 7;
    assert count_needle(out[0..n], "pub const ") == 7;
    assert count_needle(out[0..n], "20261026") == 1;
}
