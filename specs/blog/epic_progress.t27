; The epic progress post, one dated entry per iteration that moved an epic's
; percent, in the owner's one format (rule of 2026-10-26, t27#12629). First
; entry: the merge-train and repo hygiene epic, #12660, the night of
; 2026-10-26. The pattern, the PostBlock shape and the headline tests follow
; specs/blog/t27b_progress.t27; every number comes from a gh command named in
; the epic's ## Dashboard section (issue #12660), never from memory.

; Columns, one index per entry:
;   DATE        UTC day of the iteration, yyyymmdd
;   EPIC        the epic issue number
;   OPEN_START  open PRs when the iteration began
;   OPEN_END    open PRs when it ended
;   MERGED      PRs merged that UTC day
;   BR_START    remote branches when the iteration began
;   BR_END      remote branches when it ended
;   QUEUE_PEAK  the Actions queue's peak queued-run count measured that day

; Entry 0 is the 2026-10-26 night: the queue swept with armed squash
; auto-merge, two #5980 label landings proven, the branch sweep run with
; records (issue #1453). Sources: gh pr list, gh api actions/runs,
; git ls-remote, issue #1453.

module BlogEpicProgress;

pub struct PostBlock {
    kind: str,
    text: str,
}

; Scalars while ENTRIES is 1: the emitter's single-element array const emits
; invalid zig ([x] parsed as an array type -- filed on #5980, 2026-10-26).
; Entry 2 grows these back into [2]u32 arrays once that branch is fixed.
pub const DATE: u32 = 20261026;
pub const EPIC: u32 = 12660;
pub const OPEN_START: u32 = 55;
pub const OPEN_END: u32 = 25;
pub const MERGED: u32 = 54;
pub const BR_START: u32 = 6391;
pub const BR_END: u32 = 678;
pub const QUEUE_PEAK: u32 = 502;

pub const SHOWN_DATE: u32 = 20261026;
pub const SHOWN_OPEN_START: u32 = 55;
pub const SHOWN_OPEN_END: u32 = 25;
pub const SHOWN_MERGED: u32 = 54;
pub const SHOWN_BR_START: u32 = 6391;
pub const SHOWN_BR_END: u32 = 678;
; Tenths of a percent, rounded to nearest: 30 / 55 = 54.5% -> 545.
pub const SHOWN_CLEARED_PCT_TENTHS: u32 = 545;

pub const ID: str = "blog/merge-train-and-repo-hygiene";
pub const SLUG: str = "merge-train-and-repo-hygiene";
pub const TITLE: str = "The merge train: 55 open pull requests down to 25 in one night";
pub const SUMMARY: str = "[measured] 54 pull requests merged in one UTC day; the open queue went 55 to 25 with every merge recorded; 5713 dead branches deleted with their orphans listed by SHA first; the Actions queue held 502 runs behind a 20-job ceiling -- measured, with the levers priced.";
pub const DATE_ISO: str = "2026-10-26";
pub const TAGS: [3]str = ["t27", "Automation", "Measurement"];

pub const body: [8]PostBlock = [
    PostBlock { kind: "p", text: "[measured] On 2026-10-26 the repository held 55 open pull requests. By the end of the night 25 remained, 54 pull requests were merged that UTC day, and every merge that traveled went through armed squash auto-merge with the four required checks deciding -- the owner's rule of 2026-10-11, exercised at a rate of about ten merges an hour." },
    PostBlock { kind: "h", text: "What moved" },
    PostBlock { kind: "p", text: "[measured] The wasm spec gained floor 18, the LOCALS MOUNT, beside the landed pointer-carrier floor 17: 108 of 108 tests pass, the seal verifies against all five backend hashes, and t27c was built from master to regenerate the generated file (#12610). Two host-glue series from the #5980 procedure landed as label-approved pull requests (#12614, #12616). A third turned out superseded: its E0381 behavior was already on master via #12042, proven with git log -S and closed with the evidence." },
    PostBlock { kind: "h", text: "The branches" },
    PostBlock { kind: "p", text: "[measured] 6391 remote branches held 5950 that were not open pull-request heads. Classified: 1453 contained (tip an ancestor of master -- deleted, nothing orphaned), 4466 orphans (recorded in issue #1453 with branch, tip SHA and differing-file count, then deleted -- the SHA is the recovery pointer), 31 younger than a day (protected: in-flight agent work). The remainder is 678." },
    PostBlock { kind: "h", text: "The ceiling that remains" },
    PostBlock { kind: "p", text: "[measured] The Actions queue held 502 queued runs behind 16 in flight -- the free tier's job ceiling, not waste: a sample of 100 queued runs was 100% live branch tips. cancel-in-progress already guards 8 of 9 heavy workflows. The priced levers are in issue #12606: the billing tier, a self-hosted runner restricted to trusted events, and consolidating 18 single-job gates into one workflow." },
    PostBlock { kind: "h", text: "The laws the night used" },
    PostBlock { kind: "p", text: "Armed squash auto-merge with the required checks deciding (2026-10-11). A close never orphans content silently -- the SELF-CRITICAL amendment records branch and leftovers with every close. The #5980 landing procedure: owner label plus server-side commit for hand-written glue, the spec law riding the normal train. Every number on this page has its command named in epic #12660's Dashboard." },
    PostBlock { kind: "p", text: "Newest last, one entry per iteration; the source is specs/blog/epic_progress.t27." },
];

test the_queue_only_shrinks {
    assert(OPEN_END < OPEN_START);
    assert(BR_END < BR_START);
}

test the_post_shows_the_newest_entry {
    assert_eq(SHOWN_DATE, DATE);
    assert_eq(SHOWN_OPEN_START, OPEN_START);
    assert_eq(SHOWN_OPEN_END, OPEN_END);
    assert_eq(SHOWN_MERGED, MERGED);
    assert_eq(SHOWN_BR_START, BR_START);
    assert_eq(SHOWN_BR_END, BR_END);
}

test the_shown_percentage_is_the_shown_counts {
    assert_eq(SHOWN_CLEARED_PCT_TENTHS, ((SHOWN_OPEN_START - SHOWN_OPEN_END) * 1000 + SHOWN_OPEN_START / 2) / SHOWN_OPEN_START);
}
