; The epic progress post, one dated entry per iteration that moved an epic's
; percent, in the owner's one format (rule of 2026-10-26, t27#12629). First
; entry: the merge-train and repo hygiene epic, #12660, the night of
; 2026-10-26. The pattern, the PostBlock shape and the headline tests follow
; specs/blog/t27b_progress.t27; every number comes from a gh command named in
; the epic's ## Dashboard section (issue #12660), never from memory.

; Columns, one index per entry:
;   DATE        UTC day of the iteration, yyyymmdd
;   EPIC        the epic issue number
;   OPEN_START  open PRs when the iteration began
;   OPEN_END    open PRs when it ended
;   MERGED      PRs merged that UTC day
;   BR_START    remote branches when the iteration began
;   BR_END      remote branches when it ended
;   QUEUE_PEAK  the Actions queue's peak queued-run count measured that day

; Entry 0 is the 2026-10-26 night: the queue swept with armed squash
; auto-merge, two #5980 label landings proven, the branch sweep run with
; records (issue #1453). Sources: gh pr list, gh api actions/runs,
; git ls-remote, issue #1453.

module BlogEpicProgress;

pub struct PostBlock {
    kind: str,
    text: str,
}

; Three entries, so the columns are [3]u32 arrays -- three elements emit
; cleanly (the #5980 single-element defect only bites [1]T, which is why
; entry 0 shipped as scalars). Entry indexes: 0 = the first shift of
; 2026-10-26, 1 = the second shift, the night's continuation, 2 = the third
; shift, the UTC day of 2026-10-27.
pub const DATE: [3]u32 = [20261026, 20261027, 20261027];
pub const EPIC: [3]u32 = [12660, 12660, 12660];
pub const OPEN_START: [3]u32 = [55, 14, 16];
pub const OPEN_END: [3]u32 = [25, 16, 13];
pub const MERGED: [3]u32 = [54, 7, 18];
pub const BR_START: [3]u32 = [6391, 678, 696];
pub const BR_END: [3]u32 = [678, 696, 736];
pub const QUEUE_PEAK: [3]u32 = [502, 139, 139];

; SHOWN names entry 2, the newest. The percent is i32 and can be negative;
; the third shift is the first to SHRINK the open count, 16 -> 13: the
; positive sign is real and carries the storm's repayment in it.
pub const SHOWN_DATE: u32 = 20261027;
pub const SHOWN_OPEN_START: i32 = 16;
pub const SHOWN_OPEN_END: i32 = 13;
pub const SHOWN_MERGED: u32 = 18;
pub const SHOWN_BR_START: u32 = 696;
pub const SHOWN_BR_END: u32 = 736;
; Tenths of a percent, rounded to nearest: (16 - 13) / 16 = +18.7% -> +187.
pub const SHOWN_CLEARED_PCT_TENTHS: i32 = 187;

pub const ID: str = "blog/merge-train-and-repo-hygiene";
pub const SLUG: str = "merge-train-and-repo-hygiene";
pub const TITLE: str = "The third shift: 18 merged in a day, the open count shrinks at last, the verdict vocabulary grows";
pub const SUMMARY: str = "[measured] The third shift merged 18 pull requests since UTC midnight and shrank the open count 16 to 13 -- +18.7% cleared, the first positive sign of the epic -- while the queue held at 95, under the new WATCH threshold. The test report learned to tell pass_ct from pass_vacuous, and the epic card itself stopped needing accessor workarounds to say so.";
pub const DATE_ISO: str = "2026-10-27";
pub const TAGS: [3]str = ["t27", "Automation", "Measurement"];

pub const body: [6]PostBlock = [
    PostBlock { kind: "p", text: "[measured] The third shift merged 18 pull requests since UTC midnight and shrank the open pull-request count 16 to 13 -- +18.7% cleared, the first positive sign of the epic. The Actions queue held at 95, under the 100 WATCH threshold the train-watch law pinned, so no storm finding fired; remote branches went 696 to 736 as armed lanes stacked faster than they drained." },
    PostBlock { kind: "h", text: "The verdict vocabulary grew" },
    PostBlock { kind: "p", text: "[measured] The test report learned to tell a compile-time check from a run-time one: pass_ct labels a pass whose checks all folded (the law is specs/compiler/theory/toolchain.t27 report_state, landed via #12777), the reference interpreter counts it (#12784), the verdicts carry it (#12788), the lab aggregates read it (#12789), and the host vocabulary appended the word with zero index shift (#12792, armed). The epic card itself retired its accessor workaround and now reads its arrays directly (#12785)." },
    PostBlock { kind: "h", text: "The budget became teachable" },
    PostBlock { kind: "p", text: "[measured] The own-language gate enforces two independent limits -- at most 40 hand-written foreign lines added per file (80 per PR) and added at most deleted overall -- and a diff can pass either and fail the other; this session paid both refusals once each. specs/policy/budget_discipline.t27 now replays the session's refusals against the real gate as regression vectors, and the prose card (#12793, armed) carries the compress-your-own-additions technique. Reading one spec replaces hours of refused commits." },
    PostBlock { kind: "p", text: "Newest last, one entry per iteration; the source is specs/blog/epic_progress.t27. Every number names its gh command in epic #12660's Dashboard." },
];

; The reads are bare indexes: #12777 landed the CT-VERIFIED report state, so
; a const-index assert is credited as a compile-time check instead of being
; skirted through accessor functions (the #5980 workaround is retired here).
test the_whole_arc_shrinks_even_when_a_shift_grows {
    assert(OPEN_END[2] < OPEN_START[0]);
    assert(BR_END[2] < BR_START[0]);
}

test the_post_shows_the_newest_entry {
    assert_eq(SHOWN_DATE, DATE[2]);
    assert_eq(SHOWN_OPEN_START, OPEN_START[2]);
    assert_eq(SHOWN_OPEN_END, OPEN_END[2]);
    assert_eq(SHOWN_MERGED, MERGED[2]);
    assert_eq(SHOWN_BR_START, BR_START[2]);
    assert_eq(SHOWN_BR_END, BR_END[2]);
}

pub fn shown_pct() -> i32 {
    return ((SHOWN_OPEN_START - SHOWN_OPEN_END) * 1000 - SHOWN_OPEN_START / 2) / SHOWN_OPEN_START;
}

test the_shown_percentage_is_the_shown_counts {
    assert_eq(SHOWN_CLEARED_PCT_TENTHS, shown_pct());
}
