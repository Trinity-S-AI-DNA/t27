// SPDX-License-Identifier: Apache-2.0
// specs/blog/course_bench_board.t27 -- the blog post for Trinity-S-AI-DNA/trinity#1806.
//
// WHY. A trinity PR that changes a course carries its post in the same PR
// (trinity apps/website/specs/policy/course_post.t27, rule post-per-pr), and every post
// carries a widget in its body (post_widget.t27, widget-per-post). trinity#1806 names the
// bench board in lessons 1 and 3 and adds the X handles to the course lead; this module is
// its post. `t27c gen-ts` over this file writes trinity
// apps/website/src/data/blog/bodies/<SLUG>.ts; nothing in that file is typed by hand.
//
// SOURCES. Board facts: specs/boards/ax7203.t27 (imported below, checked by the tests) and
// fpga/HARDWARE_SSOT.md, section 2026-10-08 (#7788). Lesson wording: trinity
// apps/website/specs/course/course.t27 on the #1806 head.
//
// SHAPE. One struct carries the three block kinds this post uses. "p" and "h" read `text`;
// "figure" reads `svg` and `caption` (trinity apps/website/src/data/blog/types.ts, Block).
// A field a kind does not read is the empty string. It is CoursePostBlock, not PostBlock:
// epic_progress.t27 and t27b_progress.t27 define a two-field PostBlock, and a type name with
// a second shape is what `tri types ratchet` refuses.
//
// NOT HERE. The Russian body. Specs are English-only (LANG-EN, L3 ASCII); the Russian lives
// in the bundle that specs/i18n/blog-ru.t27 names, and no generator turns that bundle into
// the body file's ruBody yet.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module blog_course_bench_board;

use std::mem::bytes_eq;
use boards::ax7203::BOARD_NAME;
use boards::ax7203::PACKAGE;
use boards::ax7203::PACKAGE_BALLS;
use boards::ax7203::LUT6_TOTAL;
use boards::ax7203::LOGIC_CELLS;
use std::mem::bytes_contains;
use blog::course_bench_board_still::OUT_W;
use blog::course_bench_board_still::OUT_H;

pub struct CoursePostBlock {
    kind: str,
    text: str,
    svg: str,
    caption: str,
}

pub const ID: str = "blog/the-course-names-its-bench-board";
pub const SLUG: str = "the-course-names-its-bench-board";
pub const TITLE: str = "The FPGA course names its bench board";
pub const SUMMARY: str = "Two lessons of the FPGA course now name the board on our bench, an ALINX AX7203 with the XC7A200T in the 484-ball FBG484 package, and the course lead lists the two X accounts.";
pub const DATE_ISO: str = "2026-11-07";
pub const PR: str = "Trinity-S-AI-DNA/trinity#1806";

// What the post shows, each checked against the board spec by a test.
pub const SHOWN_BOARD: str = "ALINX AX7203";
pub const SHOWN_PACKAGE: str = "fbg484";
pub const SHOWN_BALLS: u32 = 484;
// The package the pin map widget draws: the Wukong board's, not the bench's.
pub const WUKONG_BALLS: u32 = 676;

// The figure is the T27F still of specs/blog/course_bench_board_still.t27 (t27b writes it, a PNG
// converter re-encodes it), served by the trinity site from apps/website/public under this path.
pub const STILL_HREF: str = "/t27f/stills/the-course-names-its-bench-board.png";

pub const BLOCK_COUNT: u32 = 9;
pub const KINDS: [3]str = ["p", "h", "figure"];

pub const body: [9]CoursePostBlock = [
    CoursePostBlock { kind: "p", text: "Two lessons of the FPGA course described a board that is not on our bench. The board on the bench is an ALINX AX7203, with the AMD Artix-7 XC7A200T in the 484-ball FBG484 package; a camera read ALINX off the board and its bitstream answered over the UART (t27 fpga/HARDWARE_SSOT.md, 2026-10-08). The 676 balls the course gave our board belong to the FGG676 package of the Wukong board.", svg: "", caption: "" },
    CoursePostBlock { kind: "h", text: "What changed", svg: "", caption: "" },
    CoursePostBlock { kind: "p", text: "Lesson 1, FPGA is a grid, now says: our bench chip is an AMD Artix-7 XC7A200T on an ALINX AX7203 board, in the 484-ball FBG484 package.", svg: "", caption: "" },
    CoursePostBlock { kind: "p", text: "Lesson 3, pins and package, now says that on our AX7203 board the XC7A200T is in the 484-ball FBG484, and that its pin map draws the same die in the 676-ball FGG676 package of the Wukong board. The widget did not change; the text now says which package it draws.", svg: "", caption: "" },
    CoursePostBlock { kind: "p", text: "The course lead lists the two X accounts: x.com/t27_dev and x.com/t27_lang.", svg: "", caption: "" },
    CoursePostBlock { kind: "figure", text: "", svg: "<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='0 0 642 210' role='img' aria-label='Bench board ALINX AX7203, package FBG484, 484 balls; the pin map draws FGG676, 676 balls, the package of the Wukong board'><image href='/t27f/stills/the-course-names-its-bench-board.png' xlink:href='/t27f/stills/the-course-names-its-bench-board.png' width='642' height='210'/></svg>", caption: "The bench board and the package the pin map draws: a T27F still that t27b draws natively from t27 specs/blog/course_bench_board_still.t27, with the numbers of specs/boards/ax7203.t27." },
    CoursePostBlock { kind: "h", text: "Where the numbers come from", svg: "", caption: "" },
    CoursePostBlock { kind: "p", text: "The board name, the package and the ball count are constants of t27 specs/boards/ax7203.t27, and this post's spec imports them and fails its tests if they differ. The same board spec keeps two counts apart that the course once mixed: 134,600 LUT6 and 215,360 logic cells, AMD's figure of 1.6 per LUT6.", svg: "", caption: "" },
    CoursePostBlock { kind: "p", text: "Not claimed: that the course is now free of other drift. The drift rules in t27 specs/tri/course/audit.t27 check the triggers they list and nothing else. The change is in Trinity-S-AI-DNA/trinity#1806.", svg: "", caption: "" },
];

pub fn kind_ok(kind: str) -> bool {
    var ok: bool = false;
    var i: u32 = 0;
    while (i < 3) {
        if (bytes_eq(KINDS[i], kind)) {
            ok = true;
        }
        i = i + 1;
    }
    return ok;
}

pub fn figure_count() -> u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < BLOCK_COUNT) {
        if (bytes_eq(body[i].kind, "figure")) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

test the_post_shows_the_board_spec {
    assert(bytes_eq(SHOWN_BOARD, BOARD_NAME));
    assert(bytes_eq(SHOWN_PACKAGE, PACKAGE));
    assert_eq(SHOWN_BALLS, PACKAGE_BALLS);
}

test the_two_counts_stay_apart {
    assert(LUT6_TOTAL == 134600);
    assert(LOGIC_CELLS == 215360);
    assert(LOGIC_CELLS * 10 == LUT6_TOTAL * 16);
    // Negative control: the logic cell count is not a LUT count.
    assert(LOGIC_CELLS != LUT6_TOTAL);
}

test the_wukong_package_is_not_the_bench_package {
    // Negative control: the old lesson figure.
    assert(WUKONG_BALLS != PACKAGE_BALLS);
}

test every_block_has_a_known_kind {
    var i: u32 = 0;
    while (i < BLOCK_COUNT) {
        assert(kind_ok(body[i].kind));
        i = i + 1;
    }
    // Negative control: a table is not a kind this post may use.
    assert(!kind_ok("table"));
}

test the_body_carries_one_widget {
    assert_eq(figure_count(), 1);
    assert(bytes_eq(body[5].kind, "figure"));
    // The last element is indexed, since declared lengths are not checked (t27#7395).
    assert(bytes_eq(body[BLOCK_COUNT - 1].kind, "p"));
}

test the_figure_is_the_still_at_its_own_size {
    const svg: str = body[5].svg;
    assert(bytes_contains(svg, "<image href='/t27f/stills/the-course-names-its-bench-board.png'"));
    assert(bytes_contains(svg, STILL_HREF));
    assert(OUT_W == 642);
    assert(OUT_H == 210);
    assert(bytes_contains(svg, "viewBox='0 0 642 210'"));
    assert(bytes_contains(svg, "width='642' height='210'"));
    // Negative control: the hand-drawn text figure this replaced is gone.
    assert(!bytes_contains(svg, "<text"));
}

test a_figure_reads_svg_and_text_blocks_do_not {
    var i: u32 = 0;
    while (i < BLOCK_COUNT) {
        if (bytes_eq(body[i].kind, "figure")) {
            assert(!bytes_eq(body[i].svg, ""));
            assert(!bytes_eq(body[i].caption, ""));
            assert(bytes_eq(body[i].text, ""));
        } else {
            assert(!bytes_eq(body[i].text, ""));
            assert(bytes_eq(body[i].svg, ""));
        }
        i = i + 1;
    }
}
