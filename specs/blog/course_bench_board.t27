// specs/blog/course_bench_board.t27 -- the post for trinity#1806: the course names its bench board.
// Issue gHashTag/t27#13248. The figure is one image element pointing at the T27F still.
// The still's size is still_out_w by still_out_h. The trinity site files are not in this repository.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module course_bench_board;

use boards::ax7203::BOARD_NAME;
use boards::ax7203::FPGA_PART;
use boards::ax7203::PACKAGE;
use boards::ax7203::PACKAGE_BALLS;
use boards::ax7203::WUKONG_PACKAGE_BALLS;
use boards::ax7203::LUT6_TOTAL;
use boards::ax7203::LOGIC_CELLS;
use blog::course_bench_board_still::still_out_w;
use blog::course_bench_board_still::still_out_h;

pub struct PostBlock {
    kind: str,
    text: str,
}

pub const ID : str = "blog/the-course-names-its-bench-board";
pub const SLUG : str = "the-course-names-its-bench-board";
pub const TITLE : str = "The course names its bench board";
pub const SUMMARY : str = "The course now names the bench board: an ALINX AX7203 in the 484-ball FBG484. The pin map still draws the same die in the 676-ball FGG676. The figure is a T27F still, not a hand-drawn picture.";
pub const DATE_ISO : str = "2026-11-10";
pub const STILL_HREF : str = "/t27f/stills/the-course-names-its-bench-board.png";

pub const FIGURE : str = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 642 210' width='642' height='210'><image href='/t27f/stills/the-course-names-its-bench-board.png' width='642' height='210'/></svg>";

pub const body : [9]PostBlock = [
    PostBlock { kind: "p", text: "The FPGA course said the bench chip was an AMD Artix-7 XC7A200T and left the board unnamed. The bench record of 2026-10-08 is an ALINX AX7203, part xc7a200tfbg484-2. The numbers in this entry come from specs/boards/ax7203.t27." },
    PostBlock { kind: "p", text: "Lesson 1 now names the board and the package: ALINX AX7203, 484-ball FBG484. The lesson task still opens the Wukong board file, because that file is the one the course frame points at." },
    PostBlock { kind: "p", text: "LUT_TOTAL in the Wukong file is AMD's logic-cell count, 215360. A logic cell is 1.6 per LUT6, not a LUT. The LUT6 count of this die is 134600." },
    PostBlock { kind: "h", text: "Two packages, one die" },
    PostBlock { kind: "p", text: "Lesson 3 said the XC7A200T on our board has 676 solder balls. The AX7203 package is FBG484, 484 balls. The pin map draws the same die in the Wukong FGG676, 676 balls. Those are not the same package." },
    PostBlock { kind: "figure", text: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 642 210' width='642' height='210'><image href='/t27f/stills/the-course-names-its-bench-board.png' width='642' height='210'/></svg>" },
    PostBlock { kind: "p", text: "The figure is a T27F still, 642 by 210, drawn by the still program from the board spec. A text view of the P6 checks the lines without an image channel. This entry does not claim how a browser paints the PNG." },
    PostBlock { kind: "p", text: "The course lead names two X accounts, x.com/t27_dev and x.com/t27_lang, as recorded for trinity#1806. This file does not post to them." },
    PostBlock { kind: "p", text: "Not in this file: the trinity site body, the Russian bundle, the PNG under the website, and any upload. Those belong to trinity#1806." },
];

pub fn hay_has(hay: str, needle: str) -> bool {
    if (needle.len == 0 || needle.len > hay.len) {
        return false;
    }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var k : usize = 0;
        var same = true;
        while (k < needle.len) {
            if (hay[i + k] != needle[k]) {
                same = false;
            }
            k = k + 1;
        }
        if (same) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

test "the post imports the board name, the part, the package and both ball counts" {
    assert(BOARD_NAME == "ALINX AX7203");
    assert(FPGA_PART == "xc7a200tfbg484-2");
    assert(PACKAGE == "fbg484");
    assert(PACKAGE_BALLS == 484);
    assert(WUKONG_PACKAGE_BALLS == 676);
    assert(TITLE == "The course names its bench board");
    assert(SUMMARY.len > 0);
    assert(ID == "blog/the-course-names-its-bench-board");
    assert(DATE_ISO == "2026-11-10");
}

test "a logic cell is not a LUT, and the two packages are not the same ball count" {
    assert(LUT6_TOTAL == 134600);
    assert(LOGIC_CELLS == 215360);
    assert(LOGIC_CELLS != LUT6_TOTAL);
    assert(PACKAGE_BALLS != WUKONG_PACKAGE_BALLS);
    assert(hay_has(body[2].text, "134600"));
    assert(hay_has(body[2].text, "215360"));
    assert(hay_has(body[4].text, "484"));
    assert(hay_has(body[4].text, "676"));
}

test "the body is nine blocks and exactly one of them is the figure" {
    assert(body.len == 9);
    var figures : usize = 0;
    var i : usize = 0;
    while (i < body.len) {
        if (body[i].kind == "figure") {
            figures = figures + 1;
        }
        i = i + 1;
    }
    assert(figures == 1);
    assert(body[5].kind == "figure");
    assert(body[3].kind == "h");
    assert(body[0].kind == "p");
}

test "the figure viewBox and size are the still's output" {
    assert(still_out_w() == 642);
    assert(still_out_h() == 210);
    assert(hay_has(FIGURE, "viewBox='0 0 642 210'"));
    assert(hay_has(FIGURE, "width='642'"));
    assert(hay_has(FIGURE, "height='210'"));
    assert(body[5].text == FIGURE);
}

test "the figure is one image and the hand-drawn text figure is gone" {
    assert(hay_has(FIGURE, STILL_HREF));
    assert(hay_has(FIGURE, "<image "));
    assert(!hay_has(FIGURE, "<text"));
    assert(!hay_has(FIGURE, "<tspan"));
    assert(!hay_has(FIGURE, "<rect"));
    var i : usize = 0;
    while (i < body.len) {
        if (body[i].kind != "figure") {
            assert(!hay_has(body[i].text, "<text"));
            assert(!hay_has(body[i].text, "<svg"));
        }
        i = i + 1;
    }
}

test "the image href is the still path and the post does not claim a browser view" {
    assert(STILL_HREF == "/t27f/stills/the-course-names-its-bench-board.png");
    assert(hay_has(body[6].text, "does not claim"));
    assert(hay_has(body[8].text, "any upload"));
    assert(SLUG == "the-course-names-its-bench-board");
}

test "the board name in the opening block is the imported name" {
    assert(hay_has(body[0].text, BOARD_NAME));
    assert(hay_has(body[0].text, FPGA_PART));
    assert(hay_has(body[1].text, "484"));
}
