// SPDX-License-Identifier: Apache-2.0
; specs/blog/course_bench_board_still_main.t27 -- the program that writes the trinity#1806 post's
; T27F still (specs/blog/course_bench_board_still.t27) to standard output as one P6 file.
; It is glue and nothing else, built by t27b like specs/t27os/plist_main.t27 (libSystem only,
; @extern imports through specs/t27os/pty_sys.t27): render the base, write the header, then write
; the image as BASE_H bands of SCALE rows, each band the upscale of one base row. No buffer holds
; the whole image, so every one stays under the 2^20-bit width tools/check_verilog_widths.py calls
; absurd. A render or a byte total that is wrong exits 2, a short write exits 3, and in both cases
; the output is not a still. The still's own tests are in course_bench_board_still.t27.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module blog_course_bench_board_still_main;

use blog::course_bench_board_still::render_base;
use blog::course_bench_board_still::upscale_into;
use blog::course_bench_board_still::count_color;
use blog::course_bench_board_still::BASE_W;
use blog::course_bench_board_still::BASE_H;
use blog::course_bench_board_still::BASE_BYTES;
use blog::course_bench_board_still::SCALE;
use blog::course_bench_board_still::OUT_W;
use blog::course_bench_board_still::OUT_H;
use blog::course_bench_board_still::OUT_BYTES;
use blog::course_bench_board_still::PPM_BYTES;
use blog::course_bench_board_still::INK;
use t27f::frame_render::ppm_header_into;
use t27f::frame_render::ppm_header_len;
use t27f::frame_render::ppm_len;
use t27f::frame_render::FRAME_OK;
use t27f::still_text_main::write_full;
use t27os::pty_sys::sys_exit;

pub const BASE_ROW : u32 = 642;         // 3 * BASE_W: one base row of RGB
pub const BAND_BYTES : u32 = 5778;      // 3 * OUT_W * SCALE: SCALE output rows of RGB

/// Band r of the output (output rows SCALE*r .. SCALE*r + SCALE - 1) into band, from base row r.
pub fn band_into(band: []u8, base: []const u8, r: u32) -> u8 {
    const s : usize = (r * BASE_ROW) as usize;
    return upscale_into(band, base[s..s + 642], BASE_W, 1, SCALE);
}

pub fn main() -> void {
    var base : [44940]u8 = undefined;
    var head : [32]u8 = undefined;
    var band : [5778]u8 = undefined;
    if (render_base(base[0..44940]) != FRAME_OK) { sys_exit(2); }
    if (ppm_header_into(head[0..32], OUT_W, OUT_H) != FRAME_OK) { sys_exit(2); }
    const hl : usize = ppm_header_len(OUT_W, OUT_H) as usize;
    if (!write_full(1, head[0..hl], hl)) { sys_exit(3); }
    var sent : usize = hl;
    var r : u32 = 0;
    while (r < BASE_H) {
        if (band_into(band[0..5778], base[0..44940], r) != FRAME_OK) { sys_exit(2); }
        if (!write_full(1, band[0..5778], 5778)) { sys_exit(3); }
        sent = sent + 5778;
        r = r + 1;
    }
    if (sent != (PPM_BYTES as usize)) { sys_exit(2); }
    sys_exit(0);
}

test the_header_and_the_bands_add_up_to_the_file {
    assert(BASE_ROW == 3 * BASE_W);
    assert(BAND_BYTES == 3 * OUT_W * SCALE);
    assert(BASE_BYTES == BASE_H * BASE_ROW);
    assert(OUT_BYTES == BASE_H * BAND_BYTES);
    assert(ppm_header_len(OUT_W, OUT_H) + BASE_H * BAND_BYTES == PPM_BYTES);
    assert(ppm_len(OUT_W, OUT_H) == PPM_BYTES);
    // The largest buffer is the base, under the 2^20 bits the Verilog gate refuses.
    assert(BASE_BYTES * 8 < 1048576);
    assert(BAND_BYTES * 8 < 1048576);
}

test the_bands_carry_every_ink_pixel_scaled {
    var base : [44940]u8 = undefined;
    var band : [5778]u8 = undefined;
    assert(render_base(base[0..44940]) == FRAME_OK);
    const ink_base : u32 = count_color(base[0..44940], BASE_W, 0, BASE_H, INK);
    var ink_out : u32 = 0;
    var r : u32 = 0;
    while (r < BASE_H) {
        assert(band_into(band[0..5778], base[0..44940], r) == FRAME_OK);
        ink_out = ink_out + count_color(band[0..5778], OUT_W, 0, SCALE, INK);
        r = r + 1;
    }
    assert(ink_base > 0);
    assert(ink_out == SCALE * SCALE * ink_base);
    // Negative control: a band buffer one byte short is refused.
    assert(band_into(band[0..5777], base[0..44940], 0) != FRAME_OK);
}
