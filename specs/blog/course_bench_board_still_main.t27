// SPDX-License-Identifier: Apache-2.0
// specs/blog/course_bench_board_still_main.t27 -- write the bench-board still as one P6
// on standard output. Issue gHashTag/t27#13248.
//
// The bytes are the still spec's paint. A refusal, or a short write, exits 1 and writes
// nothing that this test would count. stdout is /dev/stdout. This program does not post
// the file and does not make a PNG.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module course_bench_board_still_main;

use blog::course_bench_board_still::paint_into;
use blog::course_bench_board_still::still_out_w;
use blog::course_bench_board_still::still_out_h;
use t27f::frame_render::ppm_len;

pub var MAIN_CELL : [44940]u8 = [0] ** 44940;
pub var MAIN_RGB : [404460]u8 = [0] ** 404460;
pub var MAIN_PPM : [404475]u8 = [0] ** 404475;

pub fn still_bytes() -> u32 {
    const code = paint_into(&MAIN_CELL, &MAIN_RGB, &MAIN_PPM);
    if (code != 0) {
        return 0;
    }
    return ppm_len(still_out_w(), still_out_h());
}

pub fn main() void {
    const n = still_bytes();
    if (n == 0) {
        std.c.exit(1);
    }
    const fp = std.c.fopen("/dev/stdout", "wb");
    if (fp == null) {
        std.c.exit(1);
    }
    const w : usize = std.c.fwrite(@ptrCast(&MAIN_PPM), 1, n as usize, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != (n as usize)) {
        std.c.exit(1);
    }
}

test "the program writes exactly ppm_len bytes or nothing" {
    const n = still_bytes();
    assert(n == ppm_len(642, 210));
    assert(n == 404475);
    assert(n == ppm_len(still_out_w(), still_out_h()));
}
