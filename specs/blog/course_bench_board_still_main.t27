// SPDX-License-Identifier: Apache-2.0
; specs/blog/course_bench_board_still_main.t27 -- the program that writes the trinity#1806 post's
; T27F still (specs/blog/course_bench_board_still.t27) to standard output as one P6 file.
; It is glue and nothing else, built by t27b like specs/t27os/plist_main.t27 (libSystem only,
; @extern imports through specs/t27os/pty_sys.t27): render, lay the PPM down, write it. A render or
; a PPM that fails exits 2, a short write exits 3, and in both cases the output is not a still.
; The still's own tests are in course_bench_board_still.t27.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module blog_course_bench_board_still_main;

use blog::course_bench_board_still::render_into;
use blog::course_bench_board_still::OUT_W;
use blog::course_bench_board_still::OUT_H;
use blog::course_bench_board_still::OUT_BYTES;
use blog::course_bench_board_still::PPM_BYTES;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::ppm_len;
use t27f::frame_render::FRAME_OK;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;

pub fn main() -> void {
    var rgb : [404460]u8 = undefined;
    var ppm : [404475]u8 = undefined;
    if (render_into(rgb[0..404460]) != FRAME_OK) { sys_exit(2); }
    if (ppm_write_into(ppm[0..404475], rgb[0..404460], OUT_W, OUT_H) != FRAME_OK) { sys_exit(2); }
    const w : i64 = sys_write(1, ppm[0..404475], 404475);
    if (w != 404475) { sys_exit(3); }
    sys_exit(0);
}

test the_buffers_this_program_holds_are_the_still_s_sizes {
    assert(OUT_BYTES == 404460);
    assert(PPM_BYTES == 404475);
    assert(ppm_len(OUT_W, OUT_H) == PPM_BYTES);
}
