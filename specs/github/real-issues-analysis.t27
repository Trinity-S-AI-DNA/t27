module GitHubIssuesAnalysis;

// Version tracking
pub const VERSION: str = "7.0.0";
pub const ANALYSIS_DATE: str = "2026-10-22";

// Issue categories
pub enum IssueCategory {
    BugFix,           // Critical bugs blocking progress
    FeatureRequest,   // New feature development
    Improvement,      // System optimization
    Documentation,    // Documentation updates
    Testing,          // Test coverage improvements
    Performance,      // Performance enhancements
    Security,         // Security fixes
    Integration,      // Third-party integration
    Maintenance,      // System maintenance
    Research         // Research and exploration
}

// Priority levels
pub enum Priority {
    Critical,  // Blocker - must fix immediately
    High,      // Important - fix soon
    Medium,    // Normal - fix in regular queue
    Low,       // Nice to have - fix when time permits
    Future     // Research item - consider for future
}

// Issue analysis result
pub struct IssueAnalysis {
    id: u32,
    title: str,
    description: str,
    category: IssueCategory,
    priority: Priority,
    difficulty: u32, // 1-10 scale
    estimated_hours: u32,
    complexity_score: f64,
    impact_score: f64,
    risk_score: f64,
    dependencies: str[],
    implementation_path: str,
    required_skills: str[],
    test_plan_needed: bool,
    law_compliance_check: str[]
}

