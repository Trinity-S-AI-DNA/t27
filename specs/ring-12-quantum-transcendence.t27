fn calculate_complexity_score(objectives: []TranscendentalObjective) -> u32 {
    var total_score: u32 = 0;
    var i: u32 = 0;
    while (i < objectives.len) {
        total_score = total_score + objectives[i].complexity;
        i = i + 1;
    }
    return total_score;
}

