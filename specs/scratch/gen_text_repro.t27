; specs/scratch/gen_text_repro.t27 -- the repro of t27#13011: t27c gen-text writes HELLO to gen/text/scratch/gen_text_repro/HELLO.
; HELLO is 6 bytes: hello and a newline, no more. ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module GenTextRepro;

pub const HELLO : str = "hello\n";
pub const HELLO_LEN : usize = 6;

test hello_is_six_bytes { assert HELLO_LEN == 6; }
