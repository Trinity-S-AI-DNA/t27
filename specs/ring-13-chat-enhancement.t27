// Send user message with Enter-to-send support
pub fn send_user_message(text: str) -> void {
    if (text.len > 0) {
        log_message(@concat("💬 User sending: ", text));

        // Process message through Queen orchestrator
        process_queen_message(text);

        // Get and display Queen response
        const response: str = get_queen_response(text);
        display_queen_response(response);

        log_message(@concat("👑 Queen response sent: ", response));
    }
}

// Process message through Queen orchestrator
fn process_queen_message(text: str) -> void {
    log_message(@concat("📤 Queen processing: ", text));

    // Extract intent and generate appropriate response
    const intent: str = extract_intent(text);
    const response: str = generate_intent_response(intent, text);

    log_message(@concat("🎯 Intent identified: ", intent));
}

// Extract intent from user message
fn extract_intent(text: str) -> str {
    if (text.contains("hello") || text.contains("hi")) {
        return "greeting";
    }
    if (text.contains("help") || text.contains("assist")) {
        return "help_request";
    }
    if (text.contains("task") || text.contains("create") || text.contains("make")) {
        return "task_creation";
    }
    if (text.contains("status") || text.contains("progress")) {
        return "status_check";
    }
    if (text.contains("idea") || text.contains("suggest")) {
        return "suggestion_request";
    }
    return "general";
}

// Generate response based on intent
fn generate_intent_response(intent: str, text: str) -> str {
    if (intent == "greeting") {
        return "👋 Hello! I'm Queen, your AI orchestrator. How can I help you today?";
    } else if (intent == "help_request") {
        return "🎯 I'm here to help! You can create tasks, check status, get suggestions, or just chat about anything.";
    } else if (intent == "task_creation") {
        return "📝 Great! I'll create a task for you. What specifically would you like me to work on?";
    } else if (intent == "status_check") {
        return "📊 Current system status: All systems operational. Ready to assist you.";
    } else if (intent == "suggestion_request") {
        return "💡 Here's my suggestion: Let's optimize your workflow with automated task management.";
    } else {
        return "🤔 I understand you're interested in something specific. Could you tell me more about what you need?";
    }
}

// Get Queen response
fn get_queen_response(user_message: str) -> str {
    const responses: []str = [
        "👋 Queen: Hello! I'm here to help with any task you need.",
        "🎯 Queen: I understand exactly what you're looking for.",
        "🚀 Queen: Great question! Let me assist you with that.",
        "💡 Queen: Excellent idea! I'll help you implement this.",
        "🌟 Queen: Queen at your service! What would you like to work on?",
        "📊 Queen: I've analyzed your request and here's my approach:",
        "🔧 Queen: Let me help you optimize this process.",
        "✨ Queen: That's a brilliant suggestion! I'm on it."
    ];

    // Select response based on message content
    let index: u32 = 0;
    if (user_message.contains("hello")) {
        index = 0;
    } else if (user_message.contains("help")) {
        index = 1;
    } else if (user_message.contains("task")) {
        index = 2;
    } else if (user_message.contains("idea")) {
        index = 3;
    } else if (user_message.contains("suggestion")) {
        index = 4;
    } else if (user_message.contains("status")) {
        index = 5;
    } else if (user_message.contains("optimize")) {
        index = 6;
    } else if (user_message.contains("brilliant") || user_message.contains("great")) {
        index = 7;
    } else {
        index = @as(u32, @intCast(@random() % responses.len));
    }

    return responses[index];
}

// Display Queen response in dialogue feed
fn display_queen_response(response: str) -> void {
    log_message(@concat("📤 Displaying Queen response: ", response));

    // Add to conversation history
    add_to_conversation_history(response);

    // Update UI with streaming effect if enabled
    if (streaming_enabled) {
        show_streaming_response(response);
    }
}

// Add to conversation history
fn add_to_conversation_history(message: str) -> void {
    log_message(@concat("📝 Adding to history: ", message));

    // Store message for persistence
    store_message_for_persistence(message);
}

// Store message for persistence
fn store_message_for_persistence(message: str) -> void {
    log_message("💾 Storing message for persistence");
    // Implementation would save to persistent storage
}

// Show streaming response effect
fn show_streaming_response(response: str) -> void {
    log_message("🌊 Showing streaming response effect");
    log_message(@concat("📤 Stream complete: ", response));
}

// Get current timestamp
fn get_timestamp() -> u64 {
    return @as(u64, @intCast(@time()));
}

// Format duration for display
fn format_duration(ms: u64) -> str {
    const seconds: u32 = @as(u32, @intCast(ms / 1000));
    return @toString(seconds) + "s";
}

// Calculate response time
fn calculate_response_time(start_time: u64) -> u64 {
    return @as(u64, @intCast(@time())) - start_time;
}

// Test enhanced chat initialization
test enhanced_chat_init {
    init_enhanced_chat();

    log_message("✅ Enhanced Chat Interface initialization test passed");
    record_experience("Enhanced Chat Interface initialization test completed");
}

// Test messaging functionality
test messaging_functionality {
    // Send greeting
    send_user_message("Hello Queen! How are you?");

    // Test task creation
    send_user_message("Create a task to compile the T27 system");

    // Test help request
    send_user_message("I need help with optimization");

    log_message("✅ Messaging functionality test passed");
}

// Test intent extraction
test intent_extraction {
    const test_cases: []str = [
        "Hello there!",
        "I need some help",
        "Create a new task",
        "What's the status?",
        "Give me suggestions",
        "This is a general question"
    ];

    const expected_intents: []str = [
        "greeting",
        "help_request",
        "task_creation",
        "status_check",
        "suggestion_request",
        "general"
    ];

    for (i: u32 = 0; i < test_cases.len; i += 1) {
        const intent: str = extract_intent(test_cases[i]);
        const expected: str = expected_intents[i];

        log_message(@concat("🧪 Testing: '", test_cases[i], "' -> '", intent, "' (expected: '", expected, "')"));

        assert intent == expected;
    }

    log_message("✅ Intent extraction test passed");
}

// Test response generation
test response_generation {
    const test_inputs: []str = [
        "Hello",
        "Help me",
        "Create a task",
        "Status check",
        "Ideas please"
    ];

    for (i: u32 = 0; i < test_inputs.len; i += 1) {
        const intent: str = extract_intent(test_inputs[i]);
        const response: str = generate_intent_response(intent, test_inputs[i]);

        assert response.len > 0;
        log_message(@concat("📝 Response for '", test_inputs[i, "': ", response));
    }

    log_message("✅ Response generation test passed");
}

// Test Queen response selection
test queen_response_selection {
    const test_messages: []str = [
        "Hello Queen",
        "I need assistance",
        "Build something",
        "Check progress",
        "Good idea"
    ];

    for (i: u32 = 0; i < test_messages.len; i += 1) {
        const response: str = get_queen_response(test_messages[i]);

        assert response.len > 0;
        assert response.contains("Queen");
        log_message(@concat("👑 Response: ", response));
    }

    log_message("✅ Queen response selection test passed");
}

// Test conversation history
test conversation_history {
