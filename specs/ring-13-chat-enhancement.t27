// Performance benchmarks
bench chat_performance {
    const iterations: u32 = 1000;
    const start_time: u64 = get_timestamp();

    // Benchmark message processing
    for (var i: u32 = 0; i < iterations; i += 1) {
        send_user_message(@concat("Performance test message ", @toString(i)));
    }

    const duration: u64 = calculate_response_time(start_time);
    const avg_time: u64 = duration / iterations;

    log_message(@concat("📊 Performance: ", @toString(iterations), " messages in ", @toString(duration), "ms"));
    log_message(@concat("📊 Average: ", @toString(avg_time), "ms per message"));

    // Assert performance under 1ms per message
    assert avg_time < 1000;

    record_experience("Chat performance benchmark completed");
}

// Load test: Handle high message volume
bench chat_load_test {
    const message_count: u32 = 5000;
    const start_time: u64 = get_timestamp();

    // Send many messages rapidly
    for (var i: u32 = 0; i < message_count; i += 1) {
        send_user_message(@concat("Load test message ", @toString(i)));

        // Log progress periodically
        if (i % 1000 == 0) {
            const elapsed: u64 = calculate_response_time(start_time);
            log_message(@concat("📊 Progress: ", @toString(i), "/", @toString(message_count), " in ", @toString(elapsed), "ms"));
        }
    }

    const duration: u64 = calculate_response_time(start_time);
    const avg_time: u64 = duration / message_count;

    log_message(@concat("📊 Load test complete: ", @toString(message_count), " messages in ", @toString(duration), "ms"));
    log_message(@concat("📊 Average time per message: ", @toString(avg_time), "ms"));

    // Assert reasonable performance under 100ms per message
    assert avg_time < 100;

    record_experience("Chat load test completed");
}

// Stress test: Edge cases
bench chat_stress_test {
    // Test empty message handling
    send_user_message("");

    // Test very long message
    const long_message: str = @repeat_string("This is a very long message that exceeds normal limits. ", 100);
    send_user_message(long_message);

    // Test special characters
    send_user_message("Hello! How are you? 😊");

    // Test rapid fire messages
    for (var i: u32 = 0; i < 100; i += 1) {
        send_user_message(@concat("Quick message ", @toString(i)));
    }

    log_message("✅ Stress test completed");
    record_experience("Chat stress test completed");
}

// Helper function to repeat string
fn repeat_string(text: str, count: u32) -> str {
    let result: str = "";
    for (var i: u32 = 0; i < count; i += 1) {
        result = @concat(result, text);
    }
    return result;
}

// Global state variables
var streaming_enabled: bool = true;
var conversation_history: []str;