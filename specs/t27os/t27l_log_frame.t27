// SPDX-License-Identifier: Apache-2.0
; specs/t27os/t27l_log_frame.t27 -- the LOGS frame core: the last N lines of logs/t27l.jsonl as UI Kit log rows (Refs #13971, #13969).
; Each source line goes through tl_normalize and then tl_validate_line (t27os::t27l). An accepted line becomes one row, a refused line is
; only counted: the frame footer shows that count. Each row is a kit_log_row graph (time, agent chip, level badge, text), so this file holds
; no rectangle: vf_layout places the nodes. The scan is pure and takes one line at a time (lf_push), so a host reads the file and feeds it.
; The row keeps the last LF_MAX_ROWS accepted lines; a larger N is clamped. The agent chip is the surface word of the Menu L row.
; NOT here yet: the host main that reads logs/t27l.jsonl, copies each row's text into its graph and writes the PPM into
; target/course/hud/png (served by launch.json course-hud-png). kit_log_row nodes still carry the placeholder texts Text and Badge.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osT27lLogFrame;

use t27os::t27l::tl_normalize;
use t27os::t27l::tl_validate_line;
use t27os::t27l::tl_menu_row;
use t27os::t27l::TL_OK;
use t27f::ui_kit::UiKit;
use t27f::ui_kit::kit_log_row;
use t27f::ui_kit::kit_node_count;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;

pub const LF_MAX_ROWS : u32 = 8;
// design width of a frame row, the same viewport as the course HUD
pub const LF_W : u32 = 375;

pub struct LfScan {
    rows: u32,
    refused: u32,
    level: [8]u32,
    agent: [8]u32,
}

pub fn lf_new() -> LfScan {
    return LfScan { rows: 0, refused: 0, level: [0; 8], agent: [0; 8] };
}

// kit log level of a Menu L row: byte 9 is the first letter of the upper-case level word (9 follows "HH:MM:SS ")
pub fn lf_level_of(menu: []const u8) -> u32 {
    if (menu.len < 10) { return 0; }
    const c : u8 = menu[9];
    if (c == 87) { return 2; }
    if (c == 69 or c == 70) { return 3; }
    return 0;
}

// FNV-1a of the surface word of a Menu L row (the third word); 0 when the row has fewer words
pub fn lf_agent_of(menu: []const u8) -> u32 {
    var i : usize = 0;
    var words : u32 = 0;
    while (i < menu.len and words < 2) {
        if (menu[i] == 32) { words = words + 1; }
        i = i + 1;
    }
    if (words < 2) { return 0; }
    var h : u32 = 2166136261;
    while (i < menu.len and menu[i] != 32) {
        h = (h ^ (menu[i] as u32)) * 16777619;
        i = i + 1;
    }
    return h;
}

// true when the line normalizes and the normalized line passes the validator
pub fn lf_accepts(line: []const u8) -> bool {
    var buf : [4096]u8 = undefined;
    const n : usize = tl_normalize(line, buf[0..4096]);
    if (n == 0) { return false; }
    return tl_validate_line(buf[0..n]) == TL_OK;
}

// feed one source line: a refused line only bumps the refused count, an accepted one becomes the newest row (the oldest drops when full)
pub fn lf_push(s: LfScan, line: []const u8) -> LfScan {
    var q : LfScan = s;
    var buf : [4096]u8 = undefined;
    const n : usize = tl_normalize(line, buf[0..4096]);
    if (n == 0 or tl_validate_line(buf[0..n]) != TL_OK) {
        q.refused = q.refused + 1;
        return q;
    }
    var menu : [256]u8 = undefined;
    const m : usize = tl_menu_row(buf[0..n], menu[0..256]);
    if (m == 0) {
        q.refused = q.refused + 1;
        return q;
    }
    const lv : u32 = lf_level_of(menu[0..m]);
    const ag : u32 = lf_agent_of(menu[0..m]);
    if (q.rows < LF_MAX_ROWS) {
        q.level[q.rows as usize] = lv;
        q.agent[q.rows as usize] = ag;
        q.rows = q.rows + 1;
        return q;
    }
    var i : usize = 1;
    while (i < 8) {
        q.level[i - 1] = q.level[i];
        q.agent[i - 1] = q.agent[i];
        i = i + 1;
    }
    q.level[7] = lv;
    q.agent[7] = ag;
    return q;
}

// the kit row of row i in a theme (0 light, 1 dark); an index past the rows gets an info row
pub fn lf_row_kit(s: LfScan, i: u32, theme: u32) -> UiKit {
    if (i >= s.rows) { return kit_log_row(0, theme); }
    return kit_log_row(s.level[i as usize], theme);
}

// height of one resolved row: vf_layout decides, nothing is hand placed
pub fn lf_row_h() -> u32 {
    const k : UiKit = kit_log_row(0, 0);
    var g : VfGraph = k.graph;
    g.viewport_w = LF_W;
    const l : VfLayout = vf_layout(g);
    return l.h[0];
}

// frame height: one resolved row per kept line
pub fn lf_frame_h(s: LfScan) -> u32 {
    return s.rows * lf_row_h();
}

const LF_T1 : str = "{\"schema\":\"t27l/v1\",\"event_id\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c01\",\"ts\":\"2026-11-15T10:00:01Z\",\"device_id\":\"mac-1\",\"session_id\":\"sess-1\",\"actor\":\"agent\",\"surface\":\"pane\",\"action\":\"agent_step\",\"level\":\"info\",\"payload\":\"step one\"}";
const LF_T2 : str = "{\"schema\":\"t27l/v1\",\"event_id\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c02\",\"ts\":\"2026-11-15T10:00:02Z\",\"device_id\":\"mac-1\",\"session_id\":\"sess-2\",\"actor\":\"agent\",\"surface\":\"dev_view\",\"action\":\"agent_step\",\"level\":\"warn\",\"payload\":\"step two\"}";
const LF_T3 : str = "{\"schema\":\"t27l/v1\",\"event_id\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c03\",\"ts\":\"2026-11-15T10:00:03Z\",\"device_id\":\"mac-1\",\"session_id\":\"sess-3\",\"actor\":\"agent\",\"surface\":\"viewer\",\"action\":\"agent_step\",\"level\":\"error\",\"payload\":\"step three\"}";

test fixtures_are_accepted {
    assert lf_accepts(LF_T1);
    assert lf_accepts(LF_T2);
    assert lf_accepts(LF_T3);
}

test one_push_makes_one_row {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    assert s.refused == 0;
    assert s.rows == 1;
}

test menu_row_exists_for_t1 {
    var buf : [4096]u8 = undefined;
    const n : usize = tl_normalize(LF_T1, buf[0..4096]);
    assert n > 0;
    var menu : [256]u8 = undefined;
    const m : usize = tl_menu_row(buf[0..n], menu[0..256]);
    assert m > 10;
}

test three_agents_make_three_rows_and_refused_lines_are_counted {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    s = lf_push(s, "not json at all");
    s = lf_push(s, LF_T2);
    s = lf_push(s, LF_T3);
    s = lf_push(s, "{\"schema\":\"t27l/v1\"}");
    assert s.rows == 3;
    assert s.refused == 2;
}

test levels_per_row {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    s = lf_push(s, LF_T2);
    s = lf_push(s, LF_T3);
    assert s.level[0] == 0;
    assert s.level[1] == 2;
    assert s.level[2] == 3;
}

test agents_differ_per_row {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    s = lf_push(s, LF_T2);
    s = lf_push(s, LF_T3);
    assert s.agent[0] != 0;
    assert s.agent[0] != s.agent[1];
    assert s.agent[1] != s.agent[2];
    assert s.agent[0] != s.agent[2];
}

test row_height_is_resolved_by_the_layout {
    assert lf_row_h() > 0;
}

test every_row_is_a_five_node_kit_log_row_in_both_themes {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    s = lf_push(s, LF_T3);
    assert kit_node_count(lf_row_kit(s, 0, 0)) == 5;
    assert kit_node_count(lf_row_kit(s, 1, 1)) == 5;
    const gl : VfGraph = lf_row_kit(s, 0, 0).graph;
    const gd : VfGraph = lf_row_kit(s, 0, 1).graph;
    assert gl.theme != gd.theme;
}

test frame_height_is_rows_times_row_height {
    var s : LfScan = lf_new();
    s = lf_push(s, LF_T1);
    s = lf_push(s, LF_T3);
    assert lf_frame_h(s) == 2 * lf_row_h();
}

test the_window_keeps_the_last_eight_accepted_lines {
    var s : LfScan = lf_new();
    var i : u32 = 0;
    while (i < 10) {
        s = lf_push(s, LF_T2);
        i = i + 1;
    }
    s = lf_push(s, LF_T3);
    assert s.rows == 8;
    assert s.refused == 0;
    assert s.level[7] == 3;
    assert s.level[6] == 2;
}

test negative_a_refused_line_adds_no_row {
    var s : LfScan = lf_new();
    s = lf_push(s, "{}");
    assert s.rows == 0;
    assert s.refused == 1;
    assert lf_accepts(LF_T1);
    assert lf_accepts("{}") == false;
}
