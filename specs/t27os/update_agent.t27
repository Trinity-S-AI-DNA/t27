fn ug_getpid() -> i32 { return @extern("getpid"); }
fn ug_getppid() -> i32 { return @extern("getppid"); }

// ---------------------------------------------------------------- the paths block the window keeps (main's local)

pub const UG_P_TARGET : usize = 0;
pub const UG_P_SELF : usize = 512;
pub const UG_P_EXE : usize = 1024;
pub const UG_P_FST : usize = 1536;
pub const UG_P_SST : usize = 1792;
pub const UG_P_ZIP : usize = 2048;
pub const UG_P_LEN : usize = 2304;
/// How often the window reads the helpers' records (ms).
pub const UG_POLL_MS : u64 = 250;

/// An environment variable, NUL-terminated, into out; its length (cut at out.len - 1), 0 when unset.
fn ug_env(name: []const u8, out: []u8) -> usize {
    const a : u64 = sys_getenv(name);
    out[0] = 0;
    if (a == 0) { return 0; }
    var n : u64 = sys_strlen(a);
    if (n >= @as(u64, out.len)) { n = @as(u64, out.len - 1); }
    if (n > 0) { sys_peek(out[0..@as(usize, n)], a, n); }
    out[@as(usize, n)] = 0;
    return @as(usize, n);
}

fn ug_env_num(name: []const u8) -> u64 {
    var b : [24]u8 = undefined;
    const n : usize = ug_env(name, b[0..24]);
    var v : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (b[i] < 48 or b[i] > 57) { return 0; }
        v = v * 10 + @as(u64, b[i] - 48);
        i = i + 1;
    }
    return v;
}

fn ug_setenv_num(name: []const u8, v: u64) -> void {
    var d : [24]u8 = undefined;
    const n : usize = put_dec(d[0..24], 0, v);
    d[n] = 0;
    sys_setenv(name, d[0..24], 1);
}

/// The length of the NUL-terminated text at p[at..at + cap].
fn ug_len(p: []const u8, at: usize, cap: usize) -> usize {
    var n : usize = 0;
    while (n < cap and p[at + n] != 0) { n = n + 1; }
    return n;
}

/// b[0..n] NUL-terminated into p at `at` (cap bytes); its length, 0 when it does not fit.
fn ug_put_path(p: []u8, at: usize, cap: usize, b: []const u8, n: usize) -> usize {
    if (n + 1 > cap or n > b.len) {
        p[at] = 0;
        return 0;
    }
    var i : usize = 0;
    while (i < n) {
        p[at + i] = b[i];
        i = i + 1;
    }
    p[at + n] = 0;
    return n;
}

fn ug_say(s: []const u8, n: usize) -> void { sys_write(2, s[0..n], @as(u64, n)); }

// ---------------------------------------------------------------- HELPER: serve and fetch

/// The serving helper: zip the bundle, sign its manifest with this device's identity, answer requests on the socket
/// the window made until the window is gone. False when the bundle, the identity or the manifest is missing.
fn ug_serve() -> bool {
    var rec : [96]u8 = undefined;
    var st : [256]u8 = undefined;
    var app : [512]u8 = undefined;
    var zip : [256]u8 = undefined;
    ug_env("T27OS_UG_ST", st[0..256]);
    const an : usize = ug_env("T27OS_UG_APP", app[0..512]);
    ug_env("T27OS_UG_ZIP", zip[0..256]);
    const lfd : i32 = @as(i32, @intCast(ug_env_num("T27OS_UG_FD") & 65535));
    const ppid : u64 = ug_env_num("T27OS_UG_PPID");
    const ver : u64 = ug_env_num("T27OS_UG_VER");
    uw_init(rec[0..96], UW_R_SERVE, @as(u32, @intCast(ug_getpid())));
    rec[UW_PHASE] = @as(u8, @intCast(UW_P_SERVE_FAIL));
    var nick : [8]u8 = undefined;
    put_bytes(nick[0..8], 0, "t27os");
    var id : [208]u8 = undefined;
    var fp : [16]u8 = undefined;
    const r : u32 = ih_identity_open(nick[0..8], 5, id[0..208], fp[0..16]) & 255;
    var pl : [384]u8 = undefined;
    var ln : [3]u64 = undefined;
    var m : [216]u8 = undefined;
    var ok : bool = (r == IH_CREATED or r == IH_LOADED) and an > 0 and uh_plist(app[0..512], an, pl[0..384], ln[0..3]);
    var build : u32 = 0;
    if (ok) { build = ui_build_text(pl[128..256], @as(usize, @intCast(ln[1]))); }
    ok = ok and build > 0 and ver != NO_VERSION and uh_zip_app(app[0..512], zip[0..256]);
    var sha : [32]u8 = undefined;
    var size : i64 = -1;
    if (ok) { size = uh_file_sha(zip[0..256], sha[0..32]); }
    ok = ok and size > 0;
    if (ok) {
        ok = uh_make_manifest(id[0..ID_LEN], um_ver_part(ver, 2), um_ver_part(ver, 1), um_ver_part(ver, 0), build, @as(u64, @intCast(size)), sha[0..32], m[0..216]) == 216;
    }
    var line : [256]u8 = undefined;
    var n : usize = 0;
    if (ok == false) {
        uh_status_write(st[0..256], rec[0..96]);
        n = put_bytes(line[0..256], 0, "UPDATESERVE failed: bundle, identity or manifest\n");
        ug_say(line[0..256], n);
        return false;
    }
    rec[UW_PHASE] = @as(u8, @intCast(UW_P_SERVING));
    uw_put32(rec[0..96], UW_BUILD, build);
    uw_put32(rec[0..96], UW_PORT, uh_bound_port(lfd));
    uw_put64(rec[0..96], UW_TOTAL, @as(u64, @intCast(size)));
    uh_status_write(st[0..256], rec[0..96]);
    n = put_bytes(line[0..256], 0, "UPDATESERVE build ");
    n = put_dec(line[0..256], n, @as(u64, build));
    n = put_bytes(line[0..256], n, " zip ");
    n = put_dec(line[0..256], n, @as(u64, @intCast(size)));
    n = put_bytes(line[0..256], n, " bytes port ");
    n = put_dec(line[0..256], n, @as(u64, uh_bound_port(lfd)));
    n = put_bytes(line[0..256], n, "\n");
    ug_say(line[0..256], n);
    var stats : [2]u64 = undefined;
    var served : u32 = 0;
    while (@as(u64, @intCast(ug_getppid())) == ppid) {
        stats[0] = 0;
        stats[1] = 0;
        const code : u32 = uh_serve_one(lfd, m[0..216], zip[0..256], 0, 18446744073709551615, 1000, stats[0..2]);
        if (code != US_IDLE) {
            if (code == US_BUNDLE) { served = served + 1; }
            uw_put32(rec[0..96], UW_SERVED, served);
            uh_status_write(st[0..256], rec[0..96]);
            n = put_bytes(line[0..256], 0, "UPDATESERVE answer ");
            n = put_dec(line[0..256], n, @as(u64, code));
            n = put_bytes(line[0..256], n, " (1 manifest, 2 bundle, 3 refused, 5 io) from offset ");
            n = put_dec(line[0..256], n, stats[1]);
            n = put_bytes(line[0..256], n, " sent ");
            n = put_dec(line[0..256], n, stats[0]);
            n = put_bytes(line[0..256], n, "\n");
            ug_say(line[0..256], n);
        }
    }
    return true;
}

/// The taking helper: one uh_update against the friend the window named, phases into the status file.
fn ug_fetch() -> bool {
    var st : [256]u8 = undefined;
    var app : [512]u8 = undefined;
    ug_env("T27OS_UG_ST", st[0..256]);
    const an : usize = ug_env("T27OS_UG_APP", app[0..512]);
    var cfg : [7]u64 = undefined;
    cfg[0] = ug_env_num("T27OS_UG_IP");
    cfg[1] = ug_env_num("T27OS_UG_PORT");
    cfg[2] = ug_env_num("T27OS_UG_VER");
    cfg[3] = ug_env_num("T27OS_UG_BUILD");
    cfg[4] = 1;
    cfg[5] = @as(u64, UH_HEALTH_CODESIGN);
    cfg[6] = 0;
    var nick : [8]u8 = undefined;
    put_bytes(nick[0..8], 0, "t27os");
    var id : [208]u8 = undefined;
    var fp : [16]u8 = undefined;
    const r : u32 = ih_identity_open(nick[0..8], 5, id[0..208], fp[0..16]) & 255;
    var ft : [1109]u8 = undefined;
    var i : usize = 0;
    while (i < 1109) {
        ft[i] = 0;
        i = i + 1;
    }
    ih_friends_open(ft[0..FT_LEN + 1]);
    var res : [8]u32 = undefined;
    var stats : [8]u64 = undefined;
    i = 0;
    while (i < 8) {
        res[i] = 0;
        stats[i] = 0;
        i = i + 1;
    }
    if ((r != IH_CREATED and r != IH_LOADED) or an == 0) { return false; }
    return uh_update(cfg[0..UC_LEN], ft[0..FT_LEN], fp[0..10], app[0..an], res[0..8], stats[0..8], st[0..256]);
}

/// Run first in the window's main: when T27OS_UG_ROLE names a helper role, be that helper and exit (never returns);
/// false otherwise (the window goes on).
pub fn ug_main() -> bool {
    var rb : [16]u8 = undefined;
    const rn : usize = ug_env("T27OS_UG_ROLE", rb[0..16]);
    if (rn == 0) { return false; }
    sys_signal(13, 1);
    var ok : bool = false;
    if (rn == 5 and rb[0] == 115) { ok = ug_serve(); }
    if (rn == 5 and rb[0] == 102) { ok = ug_fetch(); }
    if (ok) { sys_exit(0); }
    sys_exit(1);
    return true;
}

// ---------------------------------------------------------------- WINDOW

/// One line to stderr with what the part shows (tests read it; the window shows the same numbers).
pub fn ug_stat(cl: []const u8, label: []const u8) -> void {
    var line : [320]u8 = undefined;
    var n : usize = put_bytes(line[0..320], 0, "UPDATESTAT ");
    n = put_bytes(line[0..320], n, label);
    n = put_bytes(line[0..320], n, " state=");
    n = put_dec(line[0..320], n, @as(u64, cl[UPV_ST]));
    n = put_bytes(line[0..320], n, " offer_build=");
    n = put_dec(line[0..320], n, upv_get32(cl, UPV_OBUILD));
    n = put_bytes(line[0..320], n, " from=");
    var i : usize = 0;
    while (i < @as(usize, cl[UPV_NICKLEN]) and i < 24) {
        line[n + i] = cl[UPV_NICK + i];
        i = i + 1;
    }
    n = n + i;
    n = put_bytes(line[0..320], n, " at=");
    const ip : u64 = upv_get32(cl, UPV_OIP);
    n = put_dec(line[0..320], n, ip >> 24);
    n = put_bytes(line[0..320], n, ".");
    n = put_dec(line[0..320], n, (ip >> 16) & 255);
    n = put_bytes(line[0..320], n, ".");
    n = put_dec(line[0..320], n, (ip >> 8) & 255);
    n = put_bytes(line[0..320], n, ".");
    n = put_dec(line[0..320], n, ip & 255);
    n = put_bytes(line[0..320], n, ":");
    n = put_dec(line[0..320], n, upv_get32(cl, UPV_OPORT));
    n = put_bytes(line[0..320], n, " have=");
    n = put_dec(line[0..320], n, upv_get64(cl, UPV_HAVE));
    n = put_bytes(line[0..320], n, " total=");
    n = put_dec(line[0..320], n, upv_get64(cl, UPV_TOTAL));
    n = put_bytes(line[0..320], n, " pct=");
    n = put_dec(line[0..320], n, @as(u64, uw_percent(upv_get64(cl, UPV_HAVE), upv_get64(cl, UPV_TOTAL))));
    n = put_bytes(line[0..320], n, " why=");
    n = put_dec(line[0..320], n, @as(u64, cl[UPV_WHY]));
    n = put_bytes(line[0..320], n, " offer=");
    n = put_dec(line[0..320], n, @as(u64, cl[UPV_OFFER]));
    n = put_bytes(line[0..320], n, " fetch=");
    n = put_dec(line[0..320], n, @as(u64, cl[UPV_FETCH]));
    n = put_bytes(line[0..320], n, " installed=");
    n = put_dec(line[0..320], n, upv_get32(cl, UPV_NEWBUILD));
    n = put_bytes(line[0..320], n, " srv=");
    n = put_dec(line[0..320], n, @as(u64, cl[UPV_SRV]));
    n = put_bytes(line[0..320], n, " sport=");
    n = put_dec(line[0..320], n, upv_get32(cl, UPV_SPORT));
    n = put_bytes(line[0..320], n, " served=");
    n = put_dec(line[0..320], n, upv_get32(cl, UPV_SERVED));
    n = put_bytes(line[0..320], n, "\n");
    ug_say(line[0..320], n);
}

/// Launch, before the call engine: the paths (helper executable, this bundle, the install target, the status files and
/// the zip under $HOME/.t27os/update), this bundle's version and build, the test aids, and the lock next to the target
/// judged (a stale one is removed, the log says which way).
pub fn ug_boot(cl: []u8, p: []u8, exe: []const u8, bundle: []const u8, ver: []const u8, build: u64) -> void {
    ug_put_path(p, UG_P_EXE, 512, exe, exe.len);
    ug_put_path(p, UG_P_SELF, 512, bundle, bundle.len);
    var t : [512]u8 = undefined;
    const tn : usize = ug_env("T27OS_UPDATE_TARGET", t[0..512]);
    if (tn > 0 and ui_app_path_ok(t[0..512], tn)) {
        ug_put_path(p, UG_P_TARGET, 512, t[0..512], tn);
    } else {
        ug_put_path(p, UG_P_TARGET, 512, bundle, bundle.len);
    }
    var h : [256]u8 = undefined;
    var hn : usize = ug_env("HOME", h[0..256]);
    if (hn > 200) { hn = 0; }
    var d : [256]u8 = undefined;
    var dn : usize = put_bytes(d[0..256], 0, h[0..hn]);
    dn = put_bytes(d[0..256], dn, "/.t27os");
    d[dn] = 0;
    // the owner's alone (audit P2): 0700
    sys_mkdir(d[0..256], 448);
    dn = put_bytes(d[0..256], dn, "/update");
    d[dn] = 0;
    sys_mkdir(d[0..256], 493);
    var f : [256]u8 = undefined;
    var fn2 : usize = put_bytes(f[0..256], put_bytes(f[0..256], 0, d[0..dn]), "/fetch.st");
    ug_put_path(p, UG_P_FST, 256, f[0..256], fn2);
    fn2 = put_bytes(f[0..256], put_bytes(f[0..256], 0, d[0..dn]), "/serve.st");
    ug_put_path(p, UG_P_SST, 256, f[0..256], fn2);
    fn2 = put_bytes(f[0..256], put_bytes(f[0..256], 0, d[0..dn]), "/serve.zip");
    ug_put_path(p, UG_P_ZIP, 256, f[0..256], fn2);
    sys_unlink(p[UG_P_SST..UG_P_SST + 256]);
    const v : u64 = um_parse_ver(ver, ver.len);
    if (v != NO_VERSION) {
        cl[UPV_MYMAJ] = @as(u8, @intCast(um_ver_part(v, 2) & 255));
        cl[UPV_MYMIN] = @as(u8, @intCast(um_ver_part(v, 1) & 255));
        cl[UPV_MYPAT] = @as(u8, @intCast(um_ver_part(v, 0) & 255));
        cl[UPV_MYVEROK] = 1;
    }
    upv_put32(cl, UPV_MYBUILD, build);
    var ab : [8]u8 = undefined;
    if (ug_env("T27OS_UPDATE_AUTO", ab[0..8]) == 1 and ab[0] == 49) { cl[UPV_AUTO] = 1; }
    // the lock next to the target: an update that died leaves it; a stale one goes now, with a line in the log. A copy
    // that is not inside a .app has no target: nothing is judged, served or installed.
    const an : usize = ug_len(p, UG_P_TARGET, 512);
    if (an == 0 or ui_app_path_ok(p[UG_P_TARGET..UG_P_TARGET + 512], an) == false) {
        p[UG_P_TARGET] = 0;
        p[UG_P_SELF] = 0;
        upv_put32(cl, UPV_MYBUILD, 0);
        ug_say("UPDATEBOOT not a bundle: updates are off\n", 41);
        return;
    }
    var info : [5]u64 = undefined;
    const verdict : u32 = uh_lock_sweep(p[UG_P_TARGET..UG_P_TARGET + 512], an, uh_now_s(), info[0..5]);
    var line : [768]u8 = undefined;
    var n : usize = put_bytes(line[0..768], 0, "UPDATELOCK ");
    n = put_bytes(line[0..768], n, p[UG_P_TARGET..UG_P_TARGET + an]);
    n = put_bytes(line[0..768], n, ".lock: ");
    n = n + uk_text(verdict, line[n..768]);
    if (info[LK_EXISTS] != 0) {
        n = put_bytes(line[0..768], n, " (age ");
        n = put_dec(line[0..768], n, info[LK_AGE]);
        n = put_bytes(line[0..768], n, " s, owner pid ");
        n = put_dec(line[0..768], n, info[LK_OWNER]);
        if (info[LK_ALIVE] != 0) { n = put_bytes(line[0..768], n, " running"); } else { n = put_bytes(line[0..768], n, " not running"); }
        if (info[LK_REMOVED] != 0) { n = put_bytes(line[0..768], n, ", removed"); }
        n = put_bytes(line[0..768], n, ")");
    }
    n = put_bytes(line[0..768], n, "\nUPDATEBOOT target=");
    n = put_bytes(line[0..768], n, p[UG_P_TARGET..UG_P_TARGET + an]);
    n = put_bytes(line[0..768], n, " build=");
    n = put_dec(line[0..768], n, build);
    n = put_bytes(line[0..768], n, " auto=");
    n = put_dec(line[0..768], n, @as(u64, cl[UPV_AUTO]));
    n = put_bytes(line[0..768], n, "\n");
    ug_say(line[0..768], n);
}

/// In the call engine's boot, before the announcement: the update server's listening socket on the call's own address,
/// any free port (the port goes into the TXT record as "up="). Nothing for a copy that is not a built bundle.
pub fn ug_listen(cl: []u8, bind: u64) -> void {
    if (upv_get32(cl, UPV_MYBUILD) == 0 or cl[UPV_MYVEROK] == 0) { return; }
    const fd : i32 = uh_listen(bind, 0);
    if (fd < 0) { return; }
    upv_put32(cl, UPV_LFD, @as(u64, @intCast(fd)) + 1);
    upv_put32(cl, UPV_SPORT, @as(u64, uh_bound_port(fd)));
}

/// After the call engine: start the serving helper on that socket (it zips this bundle and signs its manifest). up =
/// the identity opened and the announcement made.
pub fn ug_serve_start(cl: []u8, p: []u8, up: bool) -> void {
    const lfd : u64 = upv_get32(cl, UPV_LFD);
    if (up == false or lfd == 0 or ug_len(p, UG_P_SELF, 512) == 0) { return; }
    sys_setenv("T27OS_UG_ROLE", "serve", 1);
    ug_setenv_num("T27OS_UG_FD", lfd - 1);
    sys_setenv("T27OS_UG_APP", p[UG_P_SELF..UG_P_SELF + 512], 1);
    sys_setenv("T27OS_UG_ST", p[UG_P_SST..UG_P_SST + 256], 1);
    sys_setenv("T27OS_UG_ZIP", p[UG_P_ZIP..UG_P_ZIP + 256], 1);
    ug_setenv_num("T27OS_UG_VER", um_pack(@as(u32, cl[UPV_MYMAJ]), @as(u32, cl[UPV_MYMIN]), @as(u32, cl[UPV_MYPAT])));
    ug_setenv_num("T27OS_UG_PPID", @as(u64, @intCast(ug_getpid())));
    const pid : u32 = uh_spawn(p[UG_P_EXE..UG_P_EXE + 512]);
    ug_unset();
    upv_put32(cl, UPV_SPID, @as(u64, pid));
    if (pid == 0) { cl[UPV_SRV] = @as(u8, @intCast(UPV_SRV_FAIL)); }
}

fn ug_unset() -> void {
    sys_unsetenv("T27OS_UG_ROLE");
    sys_unsetenv("T27OS_UG_FD");
    sys_unsetenv("T27OS_UG_APP");
    sys_unsetenv("T27OS_UG_ST");
    sys_unsetenv("T27OS_UG_ZIP");
    sys_unsetenv("T27OS_UG_VER");
    sys_unsetenv("T27OS_UG_PPID");
    sys_unsetenv("T27OS_UG_IP");
    sys_unsetenv("T27OS_UG_PORT");
    sys_unsetenv("T27OS_UG_BUILD");
}

/// UPDATE: take the offer the part shows (a helper downloads, checks and installs into the target).
pub fn ug_start(cl: []u8, p: []u8) -> bool {
    if (upv_get32(cl, UPV_FPID) != 0 or upv_has_offer(cl) == false or ug_len(p, UG_P_TARGET, 512) == 0) { return false; }
    sys_unlink(p[UG_P_FST..UG_P_FST + 256]);
    sys_setenv("T27OS_UG_ROLE", "fetch", 1);
    ug_setenv_num("T27OS_UG_IP", upv_get32(cl, UPV_OIP));
    ug_setenv_num("T27OS_UG_PORT", upv_get32(cl, UPV_OPORT));
    sys_setenv("T27OS_UG_APP", p[UG_P_TARGET..UG_P_TARGET + 512], 1);
    sys_setenv("T27OS_UG_ST", p[UG_P_FST..UG_P_FST + 256], 1);
    ug_setenv_num("T27OS_UG_VER", um_pack(@as(u32, cl[UPV_MYMAJ]), @as(u32, cl[UPV_MYMIN]), @as(u32, cl[UPV_MYPAT])));
    ug_setenv_num("T27OS_UG_BUILD", upv_get32(cl, UPV_MYBUILD));
    const pid : u32 = uh_spawn(p[UG_P_EXE..UG_P_EXE + 512]);
    ug_unset();
    cl[UPV_WHY] = 0;
    cl[UPV_OFFER] = 0;
    cl[UPV_FETCH] = 0;
    upv_put64(cl, UPV_HAVE, 0);
    upv_put64(cl, UPV_TOTAL, 0);
    upv_put32(cl, UPV_LOGPCT, 255);
    if (pid == 0) {
        cl[UPV_ST] = @as(u8, @intCast(UPV_S_FAILED));
        ug_stat(cl, "start-failed");
        return false;
    }
    upv_put32(cl, UPV_FPID, @as(u64, pid));
    cl[UPV_ST] = @as(u8, @intCast(UPV_S_FETCH));
    ug_stat(cl, "start");
    return true;
}

/// CANCEL: the helper is ended; the part file stays for a resume; the lock it took goes with it.
pub fn ug_cancel(cl: []u8, p: []u8) -> void {
    const pid : u32 = @as(u32, @intCast(upv_get32(cl, UPV_FPID)));
    if (pid == 0) { return; }
    uh_stop(pid);
    uh_lock_release_of(p[UG_P_TARGET..UG_P_TARGET + 512], ug_len(p, UG_P_TARGET, 512), pid);
    upv_put32(cl, UPV_FPID, 0);
    cl[UPV_ST] = @as(u8, @intCast(UPV_S_CANCELLED));
    ug_stat(cl, "cancel");
}

/// The part's button as one action. True when the window must quit (RESTART started the installed copy).
pub fn ug_click(cl: []u8, p: []u8) -> bool {
    const b : u32 = upv_button(@as(u32, cl[UPV_ST]), upv_has_offer(cl));
    if (b == UPV_B_UPDATE) {
        ug_start(cl, p);
    } else if (b == UPV_B_CANCEL) {
        ug_cancel(cl, p);
    } else if (b == UPV_B_RESTART) {
        ug_stat(cl, "restart");
        return uh_relaunch(p[UG_P_TARGET..UG_P_TARGET + 512], ug_len(p, UG_P_TARGET, 512));
    }
    return false;
}

/// The bytes on disk of the part file the helper writes (found by the bundle's hash), -1 when none.
fn ug_part_have(cl: []const u8, p: []const u8) -> i64 {
    const an : usize = ug_len(p, UG_P_TARGET, 512);
    var dn : usize = ui_base_at(p[UG_P_TARGET..UG_P_TARGET + 512], an);
    if (dn > 0) { dn = dn - 1; }
    var part : [512]u8 = undefined;
    if (ui_part_path(p[UG_P_TARGET..UG_P_TARGET + 512], dn, cl[UPV_SHA..UPV_SHA + 32], part[0..512]) == 0) { return -1; }
    return uh_file_size(part[0..512]);
}

/// Every pass of the main loop (it works at most every UG_POLL_MS): the serving helper's record, the taking helper's
/// record and the part's size while it runs, its end, and the offer of a friend while nothing runs. A change of state
/// logs an UPDATESTAT line; so does every 10 % of a download.
pub fn ug_tick(cl: []u8, p: []u8, now: u64) -> void {
    const last : u64 = upv_get64(cl, UPV_POLL);
    if (now >= last and now - last < UG_POLL_MS) { return; }
    upv_put64(cl, UPV_POLL, now);
    var rec : [96]u8 = undefined;
    // the server
    const spid : u32 = @as(u32, @intCast(upv_get32(cl, UPV_SPID)));
    if (spid != 0) {
        if (uh_status_read(p[UG_P_SST..UG_P_SST + 256], rec[0..96])) {
            if (@as(u32, rec[UW_PHASE]) == UW_P_SERVING) {
                if (cl[UPV_SRV] != @as(u8, @intCast(UPV_SRV_ON))) {
                    cl[UPV_SRV] = @as(u8, @intCast(UPV_SRV_ON));
                    upv_put32(cl, UPV_SBUILD, @as(u64, uw_get32(rec[0..96], UW_BUILD)));
                    upv_put32(cl, UPV_SERVED, @as(u64, uw_get32(rec[0..96], UW_SERVED)));
                    ug_stat(cl, "serving");
                }
                upv_put32(cl, UPV_SERVED, @as(u64, uw_get32(rec[0..96], UW_SERVED)));
            } else {
                cl[UPV_SRV] = @as(u8, @intCast(UPV_SRV_FAIL));
            }
        }
        if (uh_reap(spid) != 0) {
            upv_put32(cl, UPV_SPID, 0);
            cl[UPV_SRV] = @as(u8, @intCast(UPV_SRV_FAIL));
            ug_stat(cl, "server-ended");
        }
    }
    // the update being taken
    const fpid : u32 = @as(u32, @intCast(upv_get32(cl, UPV_FPID)));
    if (fpid != 0) {
        const have_rec : bool = uh_status_read(p[UG_P_FST..UG_P_FST + 256], rec[0..96]);
        const ended : u32 = uh_reap(fpid);
        if (have_rec) {
            const ph : u32 = @as(u32, rec[UW_PHASE]);
            const before : u8 = cl[UPV_ST];
            cl[UPV_ST] = @as(u8, @intCast(upv_of_phase(ph)));
            upv_put64(cl, UPV_TOTAL, uw_get64(rec[0..96], UW_TOTAL));
            var k : usize = 0;
            while (k < 32) {
                cl[UPV_SHA + k] = rec[UW_SHA + k];
                k = k + 1;
            }
            if (ph == UW_P_FETCH) {
                const h : i64 = ug_part_have(cl, p);
                if (h >= 0) { upv_put64(cl, UPV_HAVE, @as(u64, @intCast(h))); }
            } else {
                upv_put64(cl, UPV_HAVE, uw_get64(rec[0..96], UW_HAVE));
            }
            const pct : u64 = @as(u64, uw_percent(upv_get64(cl, UPV_HAVE), upv_get64(cl, UPV_TOTAL)));
            if (before != cl[UPV_ST] or pct / 10 != upv_get32(cl, UPV_LOGPCT) / 10 or upv_get32(cl, UPV_LOGPCT) == 255) {
                upv_put32(cl, UPV_LOGPCT, pct);
                ug_stat(cl, "progress");
            }
        }
        if (ended != 0) {
            upv_put32(cl, UPV_FPID, 0);
            // the helper's last record was written before it exited: read it again now that it has
            const have_end : bool = uh_status_read(p[UG_P_FST..UG_P_FST + 256], rec[0..96]);
            var ph2 : u32 = 0;
            if (have_end) { ph2 = @as(u32, rec[UW_PHASE]); }
            cl[UPV_ST] = @as(u8, @intCast(upv_of_end(have_end, ph2)));
            if (have_end) {
                cl[UPV_WHY] = rec[UW_WHY];
                cl[UPV_OFFER] = rec[UW_OFFER];
                cl[UPV_FETCH] = rec[UW_FETCH];
                upv_put64(cl, UPV_HAVE, uw_get64(rec[0..96], UW_HAVE));
                upv_put32(cl, UPV_NEWBUILD, @as(u64, uw_get32(rec[0..96], UW_BUILD)));
            }
            if (cl[UPV_ST] != @as(u8, @intCast(UPV_S_DONE))) { upv_put32(cl, UPV_NEWBUILD, 0); }
            ug_stat(cl, "end");
        }
        return;
    }
    // nothing runs: what a friend offers
    const st : u32 = @as(u32, cl[UPV_ST]);
    if (upv_takes_offer(st)) {
        const had : u64 = upv_get32(cl, UPV_OBUILD);
        const ver : u64 = um_pack(@as(u32, cl[UPV_MYMAJ]), @as(u32, cl[UPV_MYMIN]), @as(u32, cl[UPV_MYPAT]));
        var got : bool = false;
        if (cl[UPV_MYVEROK] != 0 and upv_get32(cl, UPV_MYBUILD) != 0) { got = fe_offer(cl, ver, @as(u32, @intCast(upv_get32(cl, UPV_MYBUILD)))); }
        if (got and st == UPV_S_NONE) { cl[UPV_ST] = @as(u8, @intCast(UPV_S_OFFER)); }
        if (got == false and st == UPV_S_OFFER) { cl[UPV_ST] = @as(u8, @intCast(UPV_S_NONE)); }
        if (upv_get32(cl, UPV_OBUILD) != had) { ug_stat(cl, "offer"); }
        if (cl[UPV_AUTO] == 1 and got and cl[UPV_ST] == @as(u8, @intCast(UPV_S_OFFER))) {
            cl[UPV_AUTO] = 2;
            ug_stat(cl, "auto");
            ug_start(cl, p);
        }
    }
}

test ug_the_paths_block_holds_each_path_whole_or_not_at_all {
    var p : [2304]u8 = undefined;
    var i : usize = 0;
    while (i < 2304) {
        p[i] = 120;
        i = i + 1;
    }
    // "/tmp/updcopy/T27OS.app"
    const t : [22]u8 = [47, 116, 109, 112, 47, 117, 112, 100, 99, 111, 112, 121, 47, 84, 50, 55, 79, 83, 46, 97, 112, 112];
    assert ug_put_path(p[0..2304], UG_P_TARGET, 512, t[0..22], 22) == 22;
    assert ug_len(p[0..2304], UG_P_TARGET, 512) == 22 and p[UG_P_TARGET + 22] == 0;
    // a path that does not fit its slot is not cut: the slot is left empty
    assert ug_put_path(p[0..2304], UG_P_FST, 10, t[0..22], 22) == 0;
    assert ug_len(p[0..2304], UG_P_FST, 256) == 0;
    // the slots follow one another and end inside the block
    assert UG_P_TARGET + 512 <= UG_P_SELF and UG_P_SELF + 512 <= UG_P_EXE and UG_P_EXE + 512 <= UG_P_FST;
    assert UG_P_FST + 256 <= UG_P_SST and UG_P_SST + 256 <= UG_P_ZIP and UG_P_ZIP + 256 <= UG_P_LEN;
}
