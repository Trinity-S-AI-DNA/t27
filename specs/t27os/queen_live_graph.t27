// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_live_graph.t27 -- the LIVE MYCELIUM band of the QUEEN CONTROL DASHBOARD
; (first child of epic #12779, issue #12780: the owner watches the swarm think -- local actors
; create the network automatically, useful work grows visible edges on the black background).
; --
; WHAT IS DECIDED HERE (every rule has a test below): the node and edge palette (the T27F live
; lifecycle colours, one law, no per-surface copies), the mapping of a lane's state to a colour,
; the layout of the band (the QUEEN node above, the agents fanned below, edges between) as pure
; functions of the content rectangle, the growth caps (the band refuses past what it can draw and
; says how much it did not draw -- never a silent truncate), and the honest texts (the stats line,
; the empty state, the data source). The data is the lanes table the sidebar already reads
; (specs/t27os/lanes_view.t27): pane, queen and kernel rows, never a fixture.
; WHAT IS NOT HERE: the draw calls and the table reads (glass_window.t27). FR-004 of the T27F live
; page applies: the window holds no layout, colour or growth logic of its own.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osQueenLiveGraph;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::lanes_view::LVS_RUNNING;
use t27os::lanes_view::LVS_DONE;
use t27os::lanes_view::LVS_BLOCKED;
use t27os::lanes_view::LVS_STALLED;
use t27os::lanes_view::LVS_IDLE;
use t27os::lanes_view::LVS_READY;
use t27os::lanes_view::LVS_UNKNOWN;
use t27os::lanes_view::LV_NOTE;

// ---------------------------------------------------------------- the palette

/// The five colours of the T27F live lifecycle, one law for every surface that draws the swarm:
/// new green, active blue, down red, restart amber, exit grey (t27.ai/t27f/live legend).
pub const QLG_C_NEW : u32 = 0;
pub const QLG_C_ACTIVE : u32 = 1;
pub const QLG_C_DOWN : u32 = 2;
pub const QLG_C_RESTART : u32 = 3;
pub const QLG_C_EXIT : u32 = 4;
pub const QLG_C_COUNT : u32 = 5;

/// Red of colour i, 0..1. Values are #3fb950, #58a6ff, #f85149, #d29922, #8b949e.
pub fn qlg_cr(i : u32) -> f64 {
    if (i == QLG_C_NEW) { return 0.247; }
    if (i == QLG_C_ACTIVE) { return 0.345; }
    if (i == QLG_C_DOWN) { return 0.973; }
    if (i == QLG_C_RESTART) { return 0.824; }
    return 0.545;
}
pub fn qlg_cg(i : u32) -> f64 {
    if (i == QLG_C_NEW) { return 0.725; }
    if (i == QLG_C_ACTIVE) { return 0.651; }
    if (i == QLG_C_DOWN) { return 0.318; }
    if (i == QLG_C_RESTART) { return 0.600; }
    return 0.573;
}
pub fn qlg_cb(i : u32) -> f64 {
    if (i == QLG_C_NEW) { return 0.314; }
    if (i == QLG_C_ACTIVE) { return 1.000; }
    if (i == QLG_C_DOWN) { return 0.286; }
    if (i == QLG_C_RESTART) { return 0.133; }
    return 0.620;
}

/// A PTY pane state (specs/t27os/pty_proto.t27: 0 stopped, 1 working, 2 blocked, 3 idle, 4 done)
/// mapped onto the palette. Five states, five distinct colours.
pub fn qlg_colour_pane(s : u32) -> u32 {
    if (s == 1) { return QLG_C_ACTIVE; }
    if (s == 2) { return QLG_C_DOWN; }
    if (s == 3) { return QLG_C_RESTART; }
    if (s == 4) { return QLG_C_NEW; }
    return QLG_C_EXIT;
}

/// A lanes-table state (specs/t27os/lanes_view.t27) mapped onto the palette: running is active,
/// done is new growth, blocked is down, stalled and ready are restart warm, idle and unknown rest.
pub fn qlg_colour_lvs(s : u32) -> u32 {
    if (s == LVS_RUNNING) { return QLG_C_ACTIVE; }
    if (s == LVS_DONE) { return QLG_C_NEW; }
    if (s == LVS_BLOCKED) { return QLG_C_DOWN; }
    if (s == LVS_STALLED) { return QLG_C_RESTART; }
    if (s == LVS_READY) { return QLG_C_RESTART; }
    if (s == LVS_IDLE) { return QLG_C_EXIT; }
    return QLG_C_EXIT;
}

// ---------------------------------------------------------------- growth caps

/// The band draws at most 16 nodes (the PTY server's own pane cap): past that it refuses to draw
/// more and says the number (the "+N more" line). The lanes table itself caps at LV_MAX; a table
/// past even that is refused whole, never truncated.
pub const QLG_MAX_SHOWN : u32 = 16;

pub fn qlg_refused(n : u32, cap : u32) -> bool {
    return n > cap;
}
pub fn qlg_shown(n : u32) -> u32 {
    if (n > QLG_MAX_SHOWN) { return QLG_MAX_SHOWN; }
    return n;
}
pub fn qlg_hidden(n : u32) -> u32 {
    return n - qlg_shown(n);
}
/// Nodes on the band: the shown agents plus the QUEEN node; zero agents means an empty frame with
/// the honest empty-state line and no nodes at all.
pub fn qlg_node_total(n : u32) -> u32 {
    if (n == 0) { return 0; }
    return qlg_shown(n) + 1;
}

// ---------------------------------------------------------------- the layout

pub const QLG_PAD : f64 = 14.0;
pub const QLG_TOP_PAD : f64 = 34.0;
pub const QLG_BOTTOM_PAD : f64 = 30.0;
pub const QLG_R : f64 = 6.0;
pub const QLG_RQ : f64 = 9.0;

/// The QUEEN node: centred, under the title row.
pub fn qlg_qx(x : f64, w : f64) -> f64 { return x + w / 2.0; }
pub fn qlg_qy(y : f64) -> f64 { return y + QLG_TOP_PAD + QLG_RQ; }

/// Agent k of `n` (0-based) on the fan: even across the width, on one line above the bottom pad.
pub fn qlg_ax(k : u32, n : u32, x : f64, w : f64) -> f64 {
    const shown : f64 = qlg_shown(n) as f64;
    const step : f64 = (w - 2.0 * QLG_PAD) / shown;
    return x + QLG_PAD + ((k as f64) + 0.5) * step;
}
pub fn qlg_ay(y : f64, h : f64) -> f64 { return y + h - QLG_BOTTOM_PAD; }

/// Spacing between neighbouring agents at this width for n agents: the test holds it above two
/// radii of clear air, so nodes never touch.
pub fn qlg_step(w : f64, n : u32) -> f64 {
    return (w - 2.0 * QLG_PAD) / (qlg_shown(n) as f64);
}

// ---------------------------------------------------------------- the texts

pub const QLG_TITLE : str = "LIVE MYCELIUM";
pub const QLG_SRC_LINE : str = "live: the lanes table - pane, queen, kernel";

pub fn qlg_stat_line(out : []u8, n : u32, live : u32) -> usize {
    var w : usize = put_dec(out, 0, n as u64);
    w = put_bytes(out, w, " agents  ");
    w = put_dec(out, w, live as u64);
    return put_bytes(out, w, " live");
}
pub fn qlg_more_line(out : []u8, hidden : u32) -> usize {
    var w : usize = put_bytes(out, 0, "+");
    w = put_dec(out, w, hidden as u64);
    return put_bytes(out, w, " more past the 16 the band draws");
}
pub fn qlg_empty_line(out : []u8, server_ok : bool, n : u32) -> usize {
    if (server_ok == false) { return put_bytes(out, 0, "pty server offline - the mycelium waits"); }
    return put_bytes(out, 0, "no lanes yet - spawn work and watch it grow");
}

// ---------------------------------------------------------------- tests

fn qlg_eq(a : []const u8, n : usize, s : []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = n;
    while (i > 0) {
        i = i - 1;
        if (a[i] != s[i]) { return false; }
    }
    return true;
}

test the_pane_states_map_to_five_distinct_colours {
    assert(qlg_colour_pane(0) == QLG_C_EXIT);
    assert(qlg_colour_pane(1) == QLG_C_ACTIVE);
    assert(qlg_colour_pane(2) == QLG_C_DOWN);
    assert(qlg_colour_pane(3) == QLG_C_RESTART);
    assert(qlg_colour_pane(4) == QLG_C_NEW);
    // pairwise distinct, held for every pair the palette has
    var a : u32 = 0;
    while (a < 5) {
        var b : u32 = a + 1;
        while (b < 5) {
            assert(qlg_colour_pane(a) != qlg_colour_pane(b));
            b = b + 1;
        }
        a = a + 1;
    }
}

test the_lanes_states_map_onto_the_one_palette {
    assert(qlg_colour_lvs(LVS_RUNNING) == QLG_C_ACTIVE);
    assert(qlg_colour_lvs(LVS_DONE) == QLG_C_NEW);
    assert(qlg_colour_lvs(LVS_BLOCKED) == QLG_C_DOWN);
    assert(qlg_colour_lvs(LVS_STALLED) == QLG_C_RESTART);
    assert(qlg_colour_lvs(LVS_READY) == QLG_C_RESTART);
    assert(qlg_colour_lvs(LVS_IDLE) == QLG_C_EXIT);
    assert(qlg_colour_lvs(LVS_UNKNOWN) == QLG_C_EXIT);
}

test the_band_layout_keeps_every_node_inside_and_apart {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        var n : u32 = 1;
        while (n <= 16) {
            // every agent sits inside the band with a margin, on one row under the queen
            var k : u32 = 0;
            while (k < n) {
                const ax : f64 = qlg_ax(k, n, 0.0, w);
                assert(ax >= QLG_PAD and ax <= w - QLG_PAD + 0.001);
                k = k + 1;
            }
            // neighbours never touch: a step holds two radii of clear air
            assert(qlg_step(w, n) >= 2.0 * QLG_R + 2.0);
            // the queen is centred and above the agent row
            assert(qlg_qx(0.0, w) == w / 2.0);
            assert(qlg_qy(0.0) < qlg_ay(0.0, 150.0));
            n = n + 2;
        }
        w = w + 60.0;
    }
}

test growth_past_the_caps_refuses_and_never_truncates_silently {
    // the lanes table's own cap is the refusal wall
    assert(qlg_refused(65, 64));
    assert(qlg_refused(64, 64) == false);
    // past the draw cap the band shows 16 and SAYS the rest, on the nose
    assert(qlg_shown(20) == 16);
    assert(qlg_hidden(20) == 4);
    assert(qlg_shown(20) + qlg_hidden(20) == 20);
    assert(qlg_shown(3) == 3 and qlg_hidden(3) == 0);
    var b : [48]u8 = undefined;
    assert(qlg_eq(b[0..48], qlg_more_line(b[0..48], 4), "+4 more past the 16 the band draws"));
}

test an_empty_table_draws_zero_nodes_and_names_the_state {
    assert(qlg_node_total(0) == 0);
    assert(qlg_node_total(3) == 4);
    assert(qlg_node_total(20) == 17);
    var b : [48]u8 = undefined;
    assert(qlg_eq(b[0..48], qlg_empty_line(b[0..48], false, 0), "pty server offline - the mycelium waits"));
    assert(qlg_eq(b[0..48], qlg_empty_line(b[0..48], true, 0), "no lanes yet - spawn work and watch it grow"));
}

test the_stat_line_carries_its_counts {
    var b : [48]u8 = undefined;
    assert(qlg_eq(b[0..48], qlg_stat_line(b[0..48], 3, 2), "3 agents  2 live"));
    assert(qlg_eq(b[0..48], qlg_stat_line(b[0..48], 0, 0), "0 agents  0 live"));
    assert(qlg_eq(b[0..48], qlg_stat_line(b[0..48], 16, 16), "16 agents  16 live"));
}

invariant the_palette_holds_exactly_five_colours {
    assert(QLG_C_NEW == 0 and QLG_C_ACTIVE == 1 and QLG_C_DOWN == 2 and QLG_C_RESTART == 3 and QLG_C_EXIT == 4);
    assert(QLG_C_COUNT == 5);
}

invariant the_view_never_draws_past_its_cap {
    assert(QLG_MAX_SHOWN == 16);
    assert(QLG_MAX_SHOWN <= 16);
}
