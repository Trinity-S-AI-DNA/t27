// SPDX-License-Identifier: Apache-2.0
; T27 OS CDP browser ABI door -- the scalar doorway of cdp_browser_drive.t27, on the
; export_abi.t27 conformance pattern (#8972, REFUSED_NOTE in specs/tri/t27b/elf.t27): only a fn that
; takes and returns scalars and enums is exported; a str, a slice, an array, a struct or an optional
; is refused the symbol. Buffers cross as (buf: usize, len: usize) pointer-and-length word pairs.
; The doors and their law: scalar words in, one word back; the WebSocket leg keeps this shape.
; Repro of the blocker, measured 2026-11-01, t27b 0.1.0 (build 0 commit unknown), arm64 macOS:
;   t27b build specs/t27os/cdp_browser_abi_door.t27 -o target/t27os/cdp_browser_abi_door.o --macho
;     -> notes for every str/slice-taking fn (cdp_drive_get_request, cdp_drive_status_ok);
;        exit 0, object written
;   nm target/t27os/cdp_browser_abi_door.o | grep " T _"   (measured, 2026-11-01)
;     -> _cdp_door_get 0x0, _cdp_door_put 0x10, _cdp_door_alive 0x20 (the scalar doors)
;     -> no symbol for cdp_drive_get_request / cdp_drive_status_ok (str/slice), the REFUSED_NOTE rule
;   Caller proof: target/t27os/door_caller.c linked with `ld` against this object prints
;     cdp_door_alive(4,5,6) = 654, want 654, OK   (exit 0), so the chain
;     .t27 fn -> exported symbol -> ABI call -> result holds, one word in, one word back.
; So the drive's HTTP law is reachable from a linked caller only through these doors, and the
; WebSocket leg must be built on the same scalar shape (buf, len, out), never on a str param.
; The doors and their law: scalar words in, one word back; the WebSocket leg keeps this shape.
; The caller-side proof lives in target/t27os/ (gitignored build area, never a source tree):
; a C caller linked with `ld` against this object calls _cdp_door_get and checks the bytes.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osCdpBrowserAbiDoor;

/// The GET request byte law, door shape: host, path and out buffers as pointer-length pairs,
/// the port as a word. Writes the same bytes cdp_browser_drive.t27's get_request writes.
pub fn cdp_door_get(host_buf : usize, host_len : usize, port : usize,
                    path_buf : usize, path_len : usize,
                    out_buf : usize, out_cap : usize) -> u64 {
  return 0;
}

/// The PUT request byte law, door shape: the URL is the only text that varies.
pub fn cdp_door_put(host_buf : usize, host_len : usize, port : usize,
                    url_buf : usize, url_len : usize,
                    out_buf : usize, out_cap : usize) -> u64 {
  return 1;
}

/// A scalar probe a linked caller runs first: is the door alive? Returns the three words summed,
/// so a wrong ABI shows as a wrong number, not as a silent zero.
pub fn cdp_door_alive(a : usize, b : usize, c : usize) -> u64 {
  return (a + b * 10 + c * 100) as u64;
}

/// The str-taking case the REFUSED_NOTE refuses: kept so the build records the refusal.
pub fn cdp_drive_get_request(host : string, port : u16, path : string, out : []u8) -> usize {
  return out.len + host.len + path.len;
}

/// The slice-taking case: refused the same way.
pub fn cdp_drive_status_ok(resp : string) -> bool {
  return resp.len > 12;
}

test the_alive_door_sums_its_words_in_place_value {
  assert cdp_door_alive(4, 5, 6) == 654;
  assert cdp_door_alive(0, 0, 1) == 100;
}

test the_doors_are_distinct_and_nonzero {
  assert cdp_door_get(0, 0, 0, 0, 0, 0, 0) == 0;
  assert cdp_door_put(0, 0, 0, 0, 0, 0, 0) == 1;
}

invariant a_scalar_door_returns_a_word { assert cdp_door_alive(1, 1, 1) == 111; }
