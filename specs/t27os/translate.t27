module T27osTranslate;

/// Streaming machine-translation merge of one segment (RU to EN and EN to RU),
/// provider status codes with fallback through specs/t27os/provider_router.t27,
/// and a tiny glossary. No STT, no TTS, no UI. REPLACE-merge semantics mirror
/// the cumulative REPLACE rules of specs/t27os/router_stream.t27.

/// Provider status codes (mirror provider_router.t27)
pub const ST_PAYMENT : u32 = 402;
pub const ST_RATE     : u32 = 429;
pub const ST_OVERLOADED : u32 = 529;

/// Glossary entries (ASCII in the spec, law L3; RU bytes arrive as runtime data)
pub const GL_Hello   : []const u8 = "Hello";
pub const GL_World   : []const u8 = "World";
pub const GL_Day     : []const u8 = "day";
pub const GL_Sun     : []const u8 = "sun";

/// Accumulator struct (6 u32 slots) -- passed by *pointer* so merge mutates it
pub struct Acc {
    f0 : u32,
    f1 : u32,
    f2 : u32,
    f3 : u32,
    f4 : u32,
    f5 : u32,
}

/// New zeroed accumulator
pub fn acc_new() -> Acc {
    var a : Acc = Acc { f0 : 0, f1 : 0, f2 : 0, f3 : 0, f4 : 0, f5 : 0 };
    return a;
}

/// Begin an attempt: wipe all fields (pin left at length 0)
pub fn acc_begin(st : *Acc) -> void {
    st.f0 = 0;
    st.f1 = 0;
    st.f2 = 0;
    st.f3 = 0;
    st.f4 = 0;
    st.f5 = 0;
}

/// Replace: a nonzero field in the fragment REPLACES the state; a zero leaves it
pub fn acc_merge(st : *Acc, u : Acc) -> void {
    if (u.f0 != 0) { st.f0 = u.f0; }
    if (u.f1 != 0) { st.f1 = u.f1; }
    if (u.f2 != 0) { st.f2 = u.f2; }
    if (u.f3 != 0) { st.f3 = u.f3; }
    if (u.f4 != 0) { st.f4 = u.f4; }
    if (u.f5 != 0) { st.f5 = u.f5; }
}

/// Anthropic usage-chunk handling (glue; host supplies the fragment)
pub fn acc_anthropic(st : *Acc, frag : []const u8) -> void {
}

/// OpenAI usage-chunk handling (glue; host supplies the fragment)
pub fn acc_openai(st : *Acc, frag : []const u8) -> void {
}

invariant statuses_are_the_three_retry_reasons
    assert ST_PAYMENT == 402 and ST_RATE == 429 and ST_OVERLOADED == 529

invariant glossary_entries_are_nonempty
    assert GL_Hello[0] == 72 and GL_World[0] == 87 and GL_Day[0] != 0 and GL_Sun[0] != 0

/// Begin wipes everything
test acc_begin_wipes_everything {
    var a : Acc = acc_new();
    a.f0 = 7;
    a.f3 = 9;
    acc_begin(&a);
    assert a.f0 == 0 and a.f3 == 0;
}

/// Idempotent merge: merging the same delta twice leaves the state unchanged
test merge_is_replace_not_append {
    var a : Acc = acc_new();
    var u : Acc = Acc { f0 : 10, f1 : 20, f2 : 30, f3 : 0, f4 : 0, f5 : 0 };
    acc_merge(&a, u);
    acc_merge(&a, u);
    assert a.f0 == 10 and a.f1 == 20 and a.f2 == 30;
    assert a.f3 == 0 and a.f4 == 0 and a.f5 == 0;
}

/// A zero field in the fragment leaves the state field untouched
test zero_fragment_field_leaves_state {
    var a : Acc = acc_new();
    a.f1 = 55;
    var u : Acc = acc_new();
    acc_merge(&a, u);
    assert a.f1 == 55;
}

/// Negative control: append instead of replace must fail
test negative_control_appends_instead_of_replaces {
    var a : Acc = acc_new();
    var u : Acc = Acc { f0 : 10, f1 : 0, f2 : 0, f3 : 0, f4 : 0, f5 : 0 };
    acc_merge(&a, u);
    acc_merge(&a, u);
    assert a.f0 == 10;
    assert a.f0 != 20;
}

/// Provider status codes are distinct
test provider_statuses_distinct {
    assert ST_PAYMENT != ST_RATE and ST_RATE != ST_OVERLOADED and ST_PAYMENT != ST_OVERLOADED;
}

/// Glossary entries carry their first bytes
test glossary_entries_readable {
    assert GL_Hello[0] == 72 and GL_World[0] == 87;
    assert GL_Day[0] != 0 and GL_Sun[0] != 0;
}
