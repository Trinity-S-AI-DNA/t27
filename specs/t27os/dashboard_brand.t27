// specs/t27os/dashboard_brand.t27 -- t27os: add dashboard, orchestrator, and video brand cards.
// Part of M6 milestone (milestone #10). Closes #13537.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dashboard_brand;

pub const DASHBOARD_CARDS_MAX : u32 = 16;

pub struct DashboardCard { id: str, kind: str, visible: bool };

pub fn dashboard_card_visible(c: DashboardCard) -> bool {
    return c.visible;
}

test "dashboard_card_visible" {
    assert(dashboard_card_visible(DashboardCard { id: "card-1", kind: "orchestrator", visible: true }));
    assert(!dashboard_card_visible(DashboardCard { id: "card-2", kind: "video", visible: false }));
}

invariant dashboard_cards_max_positive {
    assert DASHBOARD_CARDS_MAX > 0;
}