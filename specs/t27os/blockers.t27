// SPDX-License-Identifier: Apache-2.0
; specs/t27os/blockers.t27 -- internal blockers belong to the lane.
; External blockers belong to a host the lane cannot change: a master-level
; job, or a runner that has no permission. A lane does not pretend an
; external blocker is fixed by editing its own branch.

module T27osBlockers;

use t27os::orchestrator::oc_needs_owner;
use t27os::orchestrator::OC_ACT_MERGE;
use t27os::orchestrator::OC_ACT_WINDOW;
use t27os::orchestrator::OC_ACT_COMMIT;

pub const BL_INTERNAL : u32 = 0;
pub const BL_EXTERNAL : u32 = 1;
pub const BL_NONE : u32 = 2;

pub const BK_NONE : u32 = 0;
pub const BK_MISSING_REPORT : u32 = 1;
pub const BK_BAD_PATH : u32 = 2;
pub const BK_HOST_FILE : u32 = 3;
pub const BK_STARTUP_FAILURE : u32 = 4;
pub const BK_NO_LAB : u32 = 5;

pub fn bl_class(kind: u32) -> u32 {
    if (kind == BK_NONE) { return BL_NONE; }
    if (kind == BK_STARTUP_FAILURE) { return BL_EXTERNAL; }
    if (kind == BK_NO_LAB) { return BL_EXTERNAL; }
    if (kind == BK_MISSING_REPORT) { return BL_INTERNAL; }
    if (kind == BK_BAD_PATH) { return BL_INTERNAL; }
    if (kind == BK_HOST_FILE) { return BL_INTERNAL; }
    return BL_NONE;
}

/// Trying a permission-gated action is the lane's own blocker. It can stop.
pub fn bl_of_act(act: u32) -> u32 {
    if (oc_needs_owner(act)) { return BL_INTERNAL; }
    return BL_NONE;
}

test a_missing_report_a_bad_path_and_a_host_file_are_internal {
    assert bl_class(BK_MISSING_REPORT) == BL_INTERNAL;
    assert bl_class(BK_BAD_PATH) == BL_INTERNAL;
    assert bl_class(BK_HOST_FILE) == BL_INTERNAL;
}

test a_master_startup_failure_and_a_missing_lab_are_external {
    assert bl_class(BK_STARTUP_FAILURE) == BL_EXTERNAL;
    assert bl_class(BK_NO_LAB) == BL_EXTERNAL;
}

test an_unknown_kind_is_not_a_blocker {
    assert bl_class(BK_NONE) == BL_NONE;
    assert bl_class(9) == BL_NONE;
}

test a_gated_action_is_an_internal_blocker_and_a_commit_is_not {
    assert bl_of_act(OC_ACT_MERGE) == BL_INTERNAL;
    assert bl_of_act(OC_ACT_WINDOW) == BL_INTERNAL;
    assert bl_of_act(OC_ACT_COMMIT) == BL_NONE;
}
