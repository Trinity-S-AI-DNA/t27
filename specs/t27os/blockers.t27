// SPDX-License-Identifier: Apache-2.0
// specs/t27os/blockers.t27 -- a blocker is internal, external, or unread.
// An unread failure is not called internal. A startup failure of a base
// workflow is external: the branch does not define that job.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::blockers {

    pub const BK_NONE : u8 = 0;
    pub const BK_INTERNAL : u8 = 1;
    pub const BK_EXTERNAL : u8 = 2;
    pub const BK_UNKNOWN : u8 = 3;

    pub fn blocker_class(failed: bool, cause_read: bool, base_job: bool) -> u8 {
        if (!failed) { return BK_NONE; }
        if (!cause_read) { return BK_UNKNOWN; }
        if (base_job) { return BK_EXTERNAL; }
        return BK_INTERNAL;
    }

    pub fn blocks_merge(k: u8) -> bool {
        return k != BK_NONE;
    }

    test "a base-job startup failure is external and unread failures stay unknown" {
        assert(blocker_class(false, false, false) == BK_NONE);
        assert(blocker_class(true, false, true) == BK_UNKNOWN);
        assert(blocker_class(true, true, true) == BK_EXTERNAL);
        assert(blocker_class(true, true, false) == BK_INTERNAL);
        assert(blocks_merge(BK_EXTERNAL));
        assert(blocks_merge(BK_UNKNOWN));
        assert(!blocks_merge(BK_NONE));
    }

    invariant an_external_blocker_stops_merge {
        assert blocks_merge(BK_EXTERNAL) == true;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
