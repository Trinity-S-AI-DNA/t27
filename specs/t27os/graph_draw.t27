// SPDX-License-Identifier: Apache-2.0
; specs/t27os/graph_draw.t27 -- the ONE draw-geometry contract between the
; actor graph law and the host drawer: coordinate transforms (zoom-to-cursor,
; pan), edge curves with arrowheads that END at the node border, counter-edge
; separation, and hit-testing that matches the visible geometry. Pure math
; only (FR-004): the drawer consumes; nobody re-declares these locally.
; Honest-data rule travels with the contract: an edge is drawn only when both
; ends exist (ag_edge_complete); a counter increment is intensity, never an
; invented message animation. ASCII only (L3).

module T27osGraphDraw;

// ---------------------------------------------------------------- transforms

/// Scale in permille of graph-unit-to-pixel (1000 = 1:1), clamped to a law
/// range so nothing can zoom into nothing or out past the content.
pub const GD_SCALE_MIN : u32 = 400;
pub const GD_SCALE_MAX : u32 = 3000;

pub fn gd_scale_clamp(s : u32) -> u32 {
    if (s < GD_SCALE_MIN) { return GD_SCALE_MIN; }
    if (s > GD_SCALE_MAX) { return GD_SCALE_MAX; }
    return s;
}

/// Screen point of a graph point: screen = pan + graph * scale / 1000.
pub fn gd_to_screen(gx : f64, gy : f64, pan_x : f64, pan_y : f64, scale : u32) -> f64 {
    const k : f64 = scale as f64 / 1000.0;
    return pan_x + gx * k; // x; the caller repeats with pan_y/gy for y (pure, same law)
}

/// Inverse: graph point under a cursor (hit-testing and zoom-to-cursor both
/// need it; one law so a click can never disagree with what is drawn).
pub fn gd_to_graph(sx : f64, pan_x : f64, scale : u32) -> f64 {
    const k : f64 = scale as f64 / 1000.0;
    return (sx - pan_x) / k;
}

/// Zoom-to-cursor: the graph point under the cursor stays under the cursor.
/// Returns the new pan (x); the caller repeats for y with the same law.
pub fn gd_zoom_pan(old_pan : f64, cursor : f64, old_scale : u32, new_scale : u32) -> f64 {
    const g : f64 = gd_to_graph(cursor, old_pan, old_scale);
    return cursor - g * (new_scale as f64 / 1000.0);
}

// ---------------------------------------------------------------- edges

/// Curvature: the control point of a quadratic bezier between the node
/// centers, offset perpendicular by a fixed fraction of the chord. Counter
/// edges (a->b and b->a) take OPPOSITE signs so they never overlap.
pub const GD_CURVE_NUM : u32 = 12;   // chord * 12 / 100 perpendicular offset
pub fn gd_curve_ctrl_x(ax : f64, ay : f64, bx : f64, by : f64, sign : i32) -> f64 {
    const dx : f64 = bx - ax;
    const dy : f64 = by - ay;
    const len : f64 = sqrt(dx * dx + dy * dy);
    if (len < 0.001) { return (ax + bx) / 2.0; }   // degenerate: no invented curve
    const off : f64 = len * (GD_CURVE_NUM as f64 / 100.0) * (sign as f64);
    return (ax + bx) / 2.0 - dy / len * off;
}
pub fn gd_curve_ctrl_y(ax : f64, ay : f64, bx : f64, by : f64, sign : i32) -> f64 {
    const dx : f64 = bx - ax;
    const dy : f64 = by - ay;
    const len : f64 = sqrt(dx * dx + dy * dy);
    if (len < 0.001) { return (ay + by) / 2.0; }
    const off : f64 = len * (GD_CURVE_NUM as f64 / 100.0) * (sign as f64);
    return (ay + by) / 2.0 + dx / len * off;
}

/// The edge ends at the node BORDER, never at the center: the point on the
/// segment center->node at distance r from the node center.
pub fn gd_edge_end_x(nx : f64, ny : f64, cx : f64, cy : f64, r : f64) -> f64 {
    const dx : f64 = nx - cx;
    const dy : f64 = ny - cy;
    const len : f64 = sqrt(dx * dx + dy * dy);
    if (len < 0.001) { return nx; }
    return nx - dx / len * r;
}
pub fn gd_edge_end_y(nx : f64, ny : f64, cx : f64, cy : f64, r : f64) -> f64 {
    const dx : f64 = nx - cx;
    const dy : f64 = ny - cy;
    const len : f64 = sqrt(dx * dx + dy * dy);
    if (len < 0.001) { return ny; }
    return ny - dy / len * r;
}

/// Arrowhead: three points of a small triangle at the tip, pointing along the
/// arrival direction (tip -> back along it).
pub const GD_ARROW_L : f64 = 7.0;
pub const GD_ARROW_W : f64 = 5.0;
/// Six values into out[0..6]: tip, base1, base2.
pub fn gd_arrow_pts(out : []f64, tipx : f64, tipy : f64, fromx : f64, fromy : f64) -> usize {
    const dx : f64 = tipx - fromx;
    const dy : f64 = tipy - fromy;
    const len : f64 = sqrt(dx * dx + dy * dy);
    if (len < 0.001 or out.len < 6) { return 0; }
    const ux : f64 = dx / len;
    const uy : f64 = dy / len;
    out[0] = tipx;
    out[1] = tipy;
    out[2] = tipx - ux * GD_ARROW_L - uy * GD_ARROW_W;
    out[3] = tipy - uy * GD_ARROW_L + ux * GD_ARROW_W;
    out[4] = tipx - ux * GD_ARROW_L + uy * GD_ARROW_W;
    out[5] = tipy - uy * GD_ARROW_L - ux * GD_ARROW_W;
    return 6;
}

/// Traffic width, bounded by law and monotone: width = 1 + 2 * min(count, 10) / 10.
/// The cap is the legend: 1px quiet, 3px at ten or more. A wide edge can never
/// hide the others past 3px.
pub fn gd_edge_width(count : u32) -> f64 {
    var c : u32 = count;
    if (c > 10) { c = 10; }
    return 1.0 + 2.0 * (c as f64) / 10.0;
}

// ---------------------------------------------------------------- hit-testing

/// A node is hit within its radius plus the label pad, so a click matches what
/// the eye sees (the label is part of the node).
pub const GD_HIT_PAD : f64 = 6.0;
pub fn gd_hit(px : f64, py : f64, nx : f64, ny : f64, r : f64) -> bool {
    const dx : f64 = px - nx;
    const dy : f64 = py - ny;
    return dx * dx + dy * dy <= (r + GD_HIT_PAD) * (r + GD_HIT_PAD);
}

// ---------------------------------------------------------------- tests

test scale_clamps_and_transforms_round_trip {
    assert(gd_scale_clamp(100) == GD_SCALE_MIN);
    assert(gd_scale_clamp(9999) == GD_SCALE_MAX);
    assert(gd_scale_clamp(1000) == 1000);
    // round trip: graph -> screen -> graph at an odd scale
    const s : u32 = 1370;
    const g : f64 = 42.5;
    const screen : f64 = gd_to_screen(g, 0.0, 7.0, 0.0, s);
    const back : f64 = gd_to_graph(screen, 7.0, s);
    const d : f64 = if (back > g) { back - g } else { g - back };
    assert(d < 0.0001);
}

test zoom_to_cursor_holds_the_point_under_the_cursor {
    const old_scale : u32 = 1000;
    const new_scale : u32 = 2000;
    const pan : f64 = 10.0;
    const cursor : f64 = 300.0;
    const new_pan : f64 = gd_zoom_pan(pan, cursor, old_scale, new_scale);
    // the graph point under the cursor is the same before and after
    const g0 : f64 = gd_to_graph(cursor, pan, old_scale);
    const g1 : f64 = gd_to_graph(cursor, new_pan, new_scale);
    const d : f64 = if (g1 > g0) { g1 - g0 } else { g0 - g1 };
    assert(d < 0.0001);
}

test curve_offsets_opposite_sides_for_counter_edges {
    const c1x : f64 = gd_curve_ctrl_x(0.0, 0.0, 100.0, 0.0, 1);
    const c1y : f64 = gd_curve_ctrl_y(0.0, 0.0, 100.0, 0.0, 1);
    const c2x : f64 = gd_curve_ctrl_x(0.0, 0.0, 100.0, 0.0, -1);
    const c2y : f64 = gd_curve_ctrl_y(0.0, 0.0, 100.0, 0.0, -1);
    // mirrored about the chord, on opposite sides, same magnitude
    assert(c1x == c2x);
    assert(c1y == -c2y);
    assert(c1y > 0.0);
    // degenerate chord: midpoint, no invented curve
    assert(gd_curve_ctrl_x(5.0, 5.0, 5.0, 5.0, 1) == 5.0);
    assert(gd_curve_ctrl_y(5.0, 5.0, 5.0, 5.0, 1) == 5.0);
}

test edge_ends_at_the_border_and_arrow_points_along_travel {
    assert(gd_edge_end_x(100.0, 0.0, 0.0, 0.0, 14.0) == 86.0);
    assert(gd_edge_end_y(100.0, 0.0, 0.0, 0.0, 14.0) == 0.0);   // r short of the center
    var a : [6]f64 = undefined;
    const an : usize = gd_arrow_pts(a[0..6], 86.0, 0.0, 0.0, 0.0);
    assert(an == 6);
    assert(a[0] == 86.0 and a[1] == 0.0);   // tip is the arrival point
    assert(a[2] < 86.0 and a[4] < 86.0);    // base behind the tip
}

test edge_width_is_bounded_and_monotone {
    assert(gd_edge_width(0) == 1.0);
    assert(gd_edge_width(5) > gd_edge_width(4));
    assert(gd_edge_width(10) == 3.0);
    assert(gd_edge_width(5000) == 3.0);   // the cap is the legend
}

test hit_matches_visible_geometry {
    assert(gd_hit(20.0, 0.0, 14.0, 0.0, 14.0));       // inside radius
    assert(gd_hit(34.5, 0.0, 14.0, 0.0, 14.0) == false); // past radius+pad
    assert(gd_hit(34.0, 0.0, 14.0, 0.0, 14.0));          // exactly at the boundary: hit
    assert(gd_hit(33.5, 3.0, 14.0, 0.0, 14.0));       // within the pad, near a label
}

invariant the_scale_window_and_the_hit_pad_are_law {
    assert(GD_SCALE_MIN < 1000 and GD_SCALE_MAX > 1000);
    assert(GD_HIT_PAD > 0.0);
    assert(GD_ARROW_L > GD_ARROW_W);
}
