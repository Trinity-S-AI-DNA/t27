// SPDX-License-Identifier: Apache-2.0
// specs/t27os/help_view.t27 -- HELP in the cabinet: how to give the key, add a friend, call, check the first call and
// what the two common messages mean, said inside the app so nobody needs a text from outside. Pure decisions only: no
// @extern, no clock. The window (glass_window.t27, draw_hv_part) draws what this file lays out.
//
// What a person sees (owner, 2026-10-23): a round "?" right of the title ACCOUNT. A click on it puts HELP in place of
// the friends list: five short blocks, a title and at most HV_LINES_MAX lines each, cut to the panel's text width:
//   Your key       the key you give to others so they can write to you and call you
//   Add a friend   paste the friend's key in the field and press ADD, or press SCAN and point the camera at the code
//   CALL           CALL in the head of the cabinet or CALL in a friend's row
//   First call     read the 6 digits aloud the first time; after that no code is asked
//   Problems       "calls are off" (the port is taken, the app takes the next) and "no code found" (hold it closer)
// and "Esc - back" on the last line. A second click on "?" or Esc gives the list back; the wheel scrolls the blocks
// when they do not fit. During a call "?" is drawn off and does nothing, and a call that starts closes HELP: it never
// stands between the person and the call or the chat.
//
// The state is two bytes of the CALL region of the text store (below 256, between AC_QR_BIG and AC_COPIES).
// Flat namespace (the window build splices imported modules): every name here starts with hv_ / HV_.
module T27osHelpView;

use t27os::queen::QP_PAD;
use t27os::chat_view::chv_wrap;
use t27os::chat_view::chv_text_w;
use t27os::account_view::AC_QR_BIG;
use t27os::account_view::AC_COPIES;
use t27os::account_view::AC_FR_LABEL_Y;
use t27os::account_view::AC_ROWS_END_FROM_BOTTOM;
use t27os::account_view::AC_INV_HEAD_DX;
use t27os::account_view::AC_HCALL_Y;
use t27os::account_view::AC_HCALL_H;
use t27os::account_view::ac_hcall_x;

// ---------------------------------------------------------------- 1. the state (two bytes of the CALL region)

/// Bit HV_F_ON: HELP stands in place of the friends; bit HV_F_BUSY: a call is up, "?" is off.
pub const HV_FLAGS : usize = 214;
/// How far the blocks are scrolled, in steps of HV_STEP.
pub const HV_SCROLL : usize = 215;
pub const HV_F_ON : u8 = 1;
pub const HV_F_BUSY : u8 = 2;

pub fn hv_on(cl: []const u8) -> bool { return (cl[HV_FLAGS] & HV_F_ON) != 0; }
pub fn hv_busy(cl: []const u8) -> bool { return (cl[HV_FLAGS] & HV_F_BUSY) != 0; }

/// Open HELP from the top; refused (false) during a call.
pub fn hv_open(cl: []u8) -> bool {
    if (hv_busy(cl)) { return false; }
    cl[HV_FLAGS] = cl[HV_FLAGS] | HV_F_ON;
    cl[HV_SCROLL] = 0;
    return true;
}

pub fn hv_close(cl: []u8) -> void {
    cl[HV_FLAGS] = cl[HV_FLAGS] & HV_F_BUSY;
    cl[HV_SCROLL] = 0;
}

/// A click on "?": open when closed, close when open; nothing during a call. Returns whether HELP is open after it.
pub fn hv_toggle(cl: []u8) -> bool {
    if (hv_busy(cl)) { return hv_on(cl); }
    if (hv_on(cl)) {
        hv_close(cl);
        return false;
    }
    return hv_open(cl);
}

/// Escape: closes HELP and takes the key (true) when HELP is open; else the key goes on to its other owners.
pub fn hv_esc(cl: []u8) -> bool {
    if (hv_on(cl) == false) { return false; }
    hv_close(cl);
    return true;
}

/// Every tick: whether a call is up (its view or its session). A call turns "?" off and closes HELP.
pub fn hv_sync(cl: []u8, in_call: bool) -> void {
    if (in_call) {
        hv_close(cl);
        cl[HV_FLAGS] = HV_F_BUSY;
    } else {
        cl[HV_FLAGS] = cl[HV_FLAGS] & HV_F_ON;
    }
}

// ---------------------------------------------------------------- 2. the words

pub const HV_N : usize = 5;

pub fn hv_title(k: usize) -> str {
    if (k == 0) { return "Your key"; }
    if (k == 1) { return "Add a friend"; }
    if (k == 2) { return "CALL"; }
    if (k == 3) { return "First call"; }
    if (k == 4) { return "Problems"; }
    return "";
}

pub fn hv_body(k: usize) -> str {
    if (k == 0) { return "The T27 key above is what you give to other people, so they can write to you and call you. COPY puts it on the clipboard; send it any way you like."; }
    if (k == 1) { return "Paste a friend's key into the field at the bottom and press ADD. Or press SCAN and point the camera at the friend's code."; }
    if (k == 2) { return "To call: CALL in the head of this panel (the first friend online), or CALL in a friend's row. MESSAGE in the row opens the chat."; }
    if (k == 3) { return "The first time, read the 6 digits to each other by voice and press CODES MATCH. After that the call starts without a code."; }
    if (k == 4) { return "\"calls are off\": the port is taken; the app takes the next free one. \"no code found\": hold the code closer to the camera."; }
    return "";
}

pub fn hv_foot() -> str { return "Esc - back"; }
pub fn hv_more() -> str { return "scroll for more"; }

// ---------------------------------------------------------------- 3. the layout (in the friends' place)

pub const HV_TITLE_SIZE : f64 = 10.5;
pub const HV_BODY_SIZE : f64 = 9.5;
pub const HV_TITLE_H : f64 = 15.0;
pub const HV_LINE_H : f64 = 12.5;
pub const HV_BLOCK_GAP : f64 = 9.0;
pub const HV_LINES_MAX : usize = 4;
/// The footer line under the blocks (not scrolled).
pub const HV_FOOT_H : f64 = 16.0;
/// One wheel notch.
pub const HV_STEP : f64 = 12.5;
/// The top of the area above the friends' label baseline (the label's ascent).
pub const HV_TOP_UP : f64 = 12.0;

/// "?" is a circle right of the title ACCOUNT; the invitation and group counts move right by HV_HEAD_SHIFT.
pub const HV_BTN_DX : f64 = 62.0;
pub const HV_BTN_D : f64 = 18.0;
pub const HV_HEAD_SHIFT : f64 = 24.0;

/// The width the text may take in a panel of width w.
pub fn hv_text_w(w: f64) -> f64 { return w - 2.0 * QP_PAD; }

/// Cut body k to maxw at HV_BODY_SIZE: the first byte and length of each line, at most HV_LINES_MAX lines.
pub fn hv_lines(k: usize, maxw: f64, st: []u32, ln: []u32) -> usize {
    const b : []const u8 = hv_body(k);
    return chv_wrap(b, b.len, maxw, HV_BODY_SIZE, st, ln, HV_LINES_MAX);
}

/// The lines body k takes at maxw (not capped: a body that would need more than HV_LINES_MAX is a defect of the words).
pub fn hv_lines_full(k: usize, maxw: f64) -> usize {
    var st : [16]u32 = undefined;
    var ln : [16]u32 = undefined;
    const b : []const u8 = hv_body(k);
    return chv_wrap(b, b.len, maxw, HV_BODY_SIZE, st[0..16], ln[0..16], 16);
}

pub fn hv_block_h(lines: usize) -> f64 { return HV_TITLE_H + HV_LINE_H * @as(f64, @floatFromInt(lines)) + HV_BLOCK_GAP; }

/// The height of all five blocks at maxw.
pub fn hv_content_h(maxw: f64) -> f64 {
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    var s : f64 = 0.0;
    var k : usize = 0;
    while (k < HV_N) {
        s = s + hv_block_h(hv_lines(k, maxw, st[0..8], ln[0..8]));
        k = k + 1;
    }
    return s;
}

/// The area HELP takes: from the friends' label line (moved down by dy for the invitations) to the add part, the
/// footer line included; the blocks scroll in [top, foot).
pub fn hv_top(t: f64, dy: f64) -> f64 { return t + dy + AC_FR_LABEL_Y - HV_TOP_UP; }
pub fn hv_bottom(t: f64, h: f64) -> f64 { return t + h - AC_ROWS_END_FROM_BOTTOM; }
pub fn hv_foot_y(t: f64, h: f64) -> f64 { return hv_bottom(t, h) - HV_FOOT_H; }
pub fn hv_view_h(t: f64, h: f64, dy: f64) -> f64 {
    const v : f64 = hv_foot_y(t, h) - hv_top(t, dy);
    if (v < 0.0) { return 0.0; }
    return v;
}

/// The most steps the blocks scroll: 0 while they fit.
pub fn hv_max_scroll(content: f64, view: f64) -> usize {
    if (content <= view) { return 0; }
    const over : f64 = content - view;
    var n : usize = @as(usize, @intFromFloat(over / HV_STEP));
    if (@as(f64, @floatFromInt(n)) * HV_STEP < over) { n = n + 1; }
    if (n > 255) { return 255; }
    return n;
}

/// One notch: up moves towards the first block.
pub fn hv_scroll_by(sc: usize, up: bool, max: usize) -> usize {
    if (up) {
        if (sc == 0) { return 0; }
        return sc - 1;
    }
    if (sc >= max) { return max; }
    return sc + 1;
}

/// A notch of the wheel over the area, the result kept in the state.
pub fn hv_wheel(cl: []u8, up: bool, w: f64, t: f64, h: f64, dy: f64) -> void {
    const max : usize = hv_max_scroll(hv_content_h(hv_text_w(w)), hv_view_h(t, h, dy));
    var sc : usize = @as(usize, cl[HV_SCROLL]);
    if (sc > max) { sc = max; }
    cl[HV_SCROLL] = @as(u8, @intCast(hv_scroll_by(sc, up, max)));
}

/// The top of block k with the blocks scrolled sc steps (it may stand above the area: the window skips what is out).
pub fn hv_block_y(k: usize, maxw: f64, t: f64, dy: f64, sc: usize) -> f64 {
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    var y : f64 = hv_top(t, dy) - HV_STEP * @as(f64, @floatFromInt(sc));
    var i : usize = 0;
    while (i < k and i < HV_N) {
        y = y + hv_block_h(hv_lines(i, maxw, st[0..8], ln[0..8]));
        i = i + 1;
    }
    return y;
}

/// A line whose baseline is y is drawn only when all of it is inside [top, foot).
pub fn hv_line_in(y: f64, size: f64, top: f64, foot: f64) -> bool { return y - size >= top and y <= foot; }

// ---------------------------------------------------------------- 4. what a point means

pub const HV_H_BTN : u32 = 240;
pub const HV_H_AREA : u32 = 241;

pub fn hv_btn_x(l: f64) -> f64 { return l + QP_PAD + HV_BTN_DX; }
pub fn hv_btn_y(t: f64) -> f64 { return t + AC_HCALL_Y + (AC_HCALL_H - HV_BTN_D) / 2.0; }

fn hv_in(x: f64, y: f64, bx: f64, by: f64, bw: f64, bh: f64) -> bool { return x >= bx and x < bx + bw and y >= by and y < by + bh; }

/// "?" (off during a call: the point means what it meant before), then the HELP area while it is open, else `raw`
/// (what the cabinet's own boxes said).
pub fn hv_hit(x: f64, y: f64, l: f64, w: f64, t: f64, h: f64, dy: f64, cl: []const u8, raw: u32) -> u32 {
    if (hv_busy(cl) == false and hv_in(x, y, hv_btn_x(l), hv_btn_y(t), HV_BTN_D, HV_BTN_D)) { return HV_H_BTN; }
    if (hv_on(cl) and hv_in(x, y, l, hv_top(t, dy), w, hv_bottom(t, h) - hv_top(t, dy))) { return HV_H_AREA; }
    return raw;
}

pub fn hv_is_hit(hit: u32) -> bool { return hit == HV_H_BTN or hit == HV_H_AREA; }

/// The wheel belongs to HELP over its area while it is open.
pub fn hv_wheel_here(x: f64, y: f64, l: f64, w: f64, t: f64, h: f64, dy: f64, cl: []const u8) -> bool {
    return hv_on(cl) and hv_in(x, y, l, hv_top(t, dy), w, hv_bottom(t, h) - hv_top(t, dy));
}

/// A click on a HELP hit: "?" toggles; a click on the open area does nothing (it never reaches a friend's row below).
/// Returns whether HELP is open after it.
pub fn hv_click(cl: []u8, hit: u32) -> bool {
    if (hit == HV_H_BTN) { return hv_toggle(cl); }
    return hv_on(cl);
}

// ---------------------------------------------------------------- 5. tests

fn hv_has(a: []const u8, b: []const u8) -> bool {
    var i : usize = 0;
    while (i + b.len <= a.len) {
        if (hv_eq(a[i .. i + b.len], b)) { return true; }
        i = i + 1;
    }
    return false;
}

fn hv_eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_state_bytes_sit_in_the_free_gap_of_the_call_region {
    assert AC_QR_BIG < HV_FLAGS and HV_FLAGS < HV_SCROLL and HV_SCROLL < AC_COPIES and AC_COPIES < 256;
    // the two bytes are HELP's alone: opening and scrolling touch them and leave the copies counter beside them
    var cl : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) { cl[i] = 0; i = i + 1; }
    cl[AC_COPIES] = 9;
    cl[HV_SCROLL] = 3;
    assert hv_open(cl[0..256]) and hv_on(cl[0..256]) and cl[HV_SCROLL] == 0 and cl[AC_COPIES] == 9;
    assert hv_esc(cl[0..256]) and hv_on(cl[0..256]) == false and cl[AC_QR_BIG] == 0;
}

test five_blocks_each_a_title_and_two_to_four_lines_at_the_300_pt_panel {
    const maxw : f64 = hv_text_w(300.0);
    assert maxw == 268.0;
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    var k : usize = 0;
    while (k < HV_N) {
        assert hv_title(k).len > 0 and hv_body(k).len > 0;
        const full : usize = hv_lines_full(k, maxw);
        assert full >= 2 and full <= HV_LINES_MAX;
        const n : usize = hv_lines(k, maxw, st[0..8], ln[0..8]);
        assert n == full;
        // every line fits the width, and the lines together give the whole body back (no word lost)
        const b : []const u8 = hv_body(k);
        var i : usize = 0;
        var kept : usize = 0;
        while (i < n) {
            assert chv_text_w(b[st[i] .. st[i] + ln[i]], @as(usize, ln[i]), HV_BODY_SIZE) <= maxw;
            kept = kept + @as(usize, ln[i]);
            i = i + 1;
        }
        assert kept + n - 1 == b.len and @as(usize, st[0]) == 0 and @as(usize, st[n - 1] + ln[n - 1]) == b.len;
        k = k + 1;
    }
    assert hv_title(HV_N).len == 0 and hv_eq(hv_title(2), "CALL") and hv_eq(hv_foot(), "Esc - back");
}

test a_body_wider_than_the_panel_is_cut_into_lines {
    // the body of block 0 is longer than one line at 268 pt: unwrapped it would run past the right edge
    const b : []const u8 = hv_body(0);
    assert chv_text_w(b, b.len, HV_BODY_SIZE) > hv_text_w(300.0);
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    assert hv_lines(0, hv_text_w(300.0), st[0..8], ln[0..8]) > 1;
    assert @as(usize, ln[0]) < b.len;
}

test the_words_name_what_the_window_says {
    assert hv_has(hv_body(0), "give") and hv_has(hv_body(0), "call you");
    assert hv_has(hv_body(1), "ADD") and hv_has(hv_body(1), "SCAN") and hv_has(hv_body(1), "camera");
    assert hv_has(hv_body(2), "CALL in the head") and hv_has(hv_body(2), "friend's row");
    assert hv_has(hv_body(3), "6 digits") and hv_has(hv_body(3), "without a code");
    assert hv_has(hv_body(4), "calls are off") and hv_has(hv_body(4), "no code found") and hv_has(hv_body(4), "closer");
}

test the_question_mark_toggles_and_escape_closes {
    var cl : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        cl[i] = 0;
        i = i + 1;
    }
    const l : f64 = 900.0;
    const t : f64 = 38.0;
    const h : f64 = 700.0;
    const bx : f64 = hv_btn_x(l) + HV_BTN_D / 2.0;
    const by : f64 = hv_btn_y(t) + HV_BTN_D / 2.0;
    // "?" is between the title and CALL in the head, and answers there
    assert hv_btn_x(0.0) >= QP_PAD + 56.0 and hv_btn_x(0.0) + HV_BTN_D + 6.0 <= QP_PAD + AC_INV_HEAD_DX + HV_HEAD_SHIFT;
    assert hv_btn_x(0.0) + HV_BTN_D < ac_hcall_x(0.0, 300.0);
    assert hv_hit(bx, by, l, 300.0, t, h, 0.0, cl[0..256], 7) == HV_H_BTN;
    assert hv_hit(bx + HV_BTN_D, by, l, 300.0, t, h, 0.0, cl[0..256], 7) == 7;
    // closed: the friends' place is the cabinet's own
    const ay : f64 = hv_top(t, 0.0) + 30.0;
    assert hv_hit(l + 40.0, ay, l, 300.0, t, h, 0.0, cl[0..256], 16) == 16;
    assert hv_click(cl[0..256], HV_H_BTN);
    assert hv_on(cl[0..256]);
    // open: a click on the area is HELP's (never a friend's row under it); the add part below stays the cabinet's
    assert hv_hit(l + 40.0, ay, l, 300.0, t, h, 0.0, cl[0..256], 16) == HV_H_AREA;
    assert hv_hit(l + 40.0, hv_bottom(t, h) + 4.0, l, 300.0, t, h, 0.0, cl[0..256], 8) == 8;
    assert hv_click(cl[0..256], HV_H_AREA);
    assert hv_click(cl[0..256], HV_H_BTN) == false and hv_on(cl[0..256]) == false;
    // Escape: closes an open HELP and takes the key; with HELP closed it leaves the key to the panel
    assert hv_open(cl[0..256]);
    assert hv_esc(cl[0..256]);
    assert hv_on(cl[0..256]) == false;
    assert hv_esc(cl[0..256]) == false;
}

test the_blocks_scroll_when_they_do_not_fit_and_stop_at_both_ends {
    var cl : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        cl[i] = 0;
        i = i + 1;
    }
    const maxw : f64 = hv_text_w(300.0);
    const content : f64 = hv_content_h(maxw);
    assert content > 200.0;
    // a tall window: everything fits, nothing scrolls
    assert hv_max_scroll(content, hv_view_h(38.0, 900.0, 0.0)) == 0;
    // a short window (and two invitations above): the blocks scroll, a notch a step, never past either end
    const h : f64 = 560.0;
    const dy : f64 = 80.0;
    const view : f64 = hv_view_h(38.0, h, dy);
    assert view > 0.0 and view < content;
    const max : usize = hv_max_scroll(content, view);
    assert max > 0 and HV_STEP * @as(f64, @floatFromInt(max)) >= content - view and HV_STEP * @as(f64, @floatFromInt(max - 1)) < content - view;
    assert hv_open(cl[0..256]);
    hv_wheel(cl[0..256], true, 300.0, 38.0, h, dy);
    assert cl[HV_SCROLL] == 0;
    var s : usize = 0;
    while (s < max + 3) {
        hv_wheel(cl[0..256], false, 300.0, 38.0, h, dy);
        s = s + 1;
    }
    assert @as(usize, cl[HV_SCROLL]) == max;
    // the last block's last line then stands inside the area
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    const n4 : usize = hv_lines(4, maxw, st[0..8], ln[0..8]);
    const last : f64 = hv_block_y(4, maxw, 38.0, dy, max) + HV_TITLE_H + HV_LINE_H * @as(f64, @floatFromInt(n4));
    assert hv_line_in(last, HV_BODY_SIZE, hv_top(38.0, dy), hv_foot_y(38.0, h));
    hv_wheel(cl[0..256], true, 300.0, 38.0, h, dy);
    assert @as(usize, cl[HV_SCROLL]) == max - 1;
    // the wheel is HELP's over its area only while it is open
    assert hv_wheel_here(910.0, hv_top(38.0, dy) + 5.0, 900.0, 300.0, 38.0, h, dy, cl[0..256]);
    hv_close(cl[0..256]);
    assert cl[HV_SCROLL] == 0 and hv_wheel_here(910.0, hv_top(38.0, dy) + 5.0, 900.0, 300.0, 38.0, h, dy, cl[0..256]) == false;
    // a reopened HELP starts at the first block
    assert hv_open(cl[0..256]) and cl[HV_SCROLL] == 0 and hv_block_y(0, maxw, 38.0, dy, 0) == hv_top(38.0, dy);
}

test during_a_call_help_is_off_and_a_call_closes_it {
    var cl : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        cl[i] = 0;
        i = i + 1;
    }
    const l : f64 = 0.0;
    const t : f64 = 38.0;
    const bx : f64 = hv_btn_x(l) + 4.0;
    const by : f64 = hv_btn_y(t) + 4.0;
    assert hv_open(cl[0..256]);
    // a call comes: HELP closes, "?" answers nothing and a click or Escape does not bring it back
    hv_sync(cl[0..256], true);
    assert hv_on(cl[0..256]) == false and hv_busy(cl[0..256]);
    assert hv_hit(bx, by, l, 300.0, t, 700.0, 0.0, cl[0..256], 0) == 0;
    assert hv_toggle(cl[0..256]) == false and hv_open(cl[0..256]) == false;
    assert hv_esc(cl[0..256]) == false;
    // the call ends: "?" works again; an open HELP stays open while no call comes
    hv_sync(cl[0..256], false);
    assert hv_busy(cl[0..256]) == false and hv_hit(bx, by, l, 300.0, t, 700.0, 0.0, cl[0..256], 0) == HV_H_BTN;
    assert hv_toggle(cl[0..256]);
    hv_sync(cl[0..256], false);
    assert hv_on(cl[0..256]);
}

test a_notch_is_one_step_a_block_its_lines_and_the_hits_are_named {
    // the wheel: up stops at the first block, down at the last step
    assert hv_scroll_by(0, true, 5) == 0 and hv_scroll_by(3, true, 5) == 2;
    assert hv_scroll_by(4, false, 5) == 5 and hv_scroll_by(5, false, 5) == 5 and hv_scroll_by(9, false, 5) == 5;
    // a block is its title, its lines and the gap
    assert hv_block_h(0) == HV_TITLE_H + HV_BLOCK_GAP and hv_block_h(4) == HV_TITLE_H + 4.0 * HV_LINE_H + HV_BLOCK_GAP;
    // the two HELP hits, apart from the cabinet's own (AC_H_* below 144, QC_H_* 230..232)
    assert hv_is_hit(HV_H_BTN) and hv_is_hit(HV_H_AREA) and hv_is_hit(0) == false and hv_is_hit(232) == false;
    assert hv_eq(hv_more(), "scroll for more");
}

invariant help_never_stands_over_a_call {
    var cl : [256]u8 = undefined;
    cl[HV_FLAGS] = HV_F_ON;
    cl[HV_SCROLL] = 3;
    hv_sync(cl[0..256], true);
    assert hv_on(cl[0..256]) == false and cl[HV_SCROLL] == 0;
}
