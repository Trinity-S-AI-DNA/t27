// specs/t27os/logs_panel.t27 -- t27os: black full-screen browser Logs panel;
// UI Kit Control Center on D DESIGN.
// Part of M7 milestone (milestone #11). Closes #14076.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::logs_panel;

pub const LOGS_PANEL_MAX_LINES : u32 = 1000;

pub struct LogsPanel { lines: u32, full_screen: bool };

pub fn logs_panel_full_screen(p: LogsPanel) -> bool {
    return p.full_screen;
}

test "logs_panel_full_screen" {
    assert(logs_panel_full_screen(LogsPanel { lines: 100, full_screen: true }));
    assert(!logs_panel_full_screen(LogsPanel { lines: 100, full_screen: false }));
}

invariant logs_panel_max_lines_positive {
    assert LOGS_PANEL_MAX_LINES > 0;
}