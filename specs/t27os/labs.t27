// SPDX-License-Identifier: Apache-2.0
// specs/t27os/labs.t27 -- the t27b lab as a T27 OS actor (issue #11783).
// One actor drives the lab sequence the Railway lab ran: fetch, build,
// corpus, reference path, ratchet, fuzz -- publishes the same JSON shape
// to the devices feed so `tri t27b doctor` and receipt comparison keep
// working -- and settles the run through the settle bridge (issue #11858):
// the run's receipt + the run challenge go to settle_bridge.t27's
// bridge_pay/bridge_settle, imported, the laws compose. The lab's
// orchestration lives here as t27 law; the commands it runs go through the
// OS's own PTY (pty_server.t27), not a separate daemon.
//
// WHAT IS NOT HERE: the build recipes (install.t27 owns the toolchain), the
// feed format (devices.t27), the receipt signing (t27c corpus-receipt -- the
// lab calls it, it does not reimplement it), the Railway lab itself
// (contrib/railway/t27b-lab -- stays as a remote fallback per FR-005), the
// settle amounts (ledger.t27's REWARD_PER_JOB_MTRI and payout.t27's shares
// own them; this wiring decides no rate, no amount, no split and registers
// no node -- the registry act is the owner's), and the receipt schema: the
// published receipt JSON is t27c corpus-receipt's shape, outside this tree,
// so the settle outcome (the OUT_* verdict and the payout gate's answer)
// travels in the bridge's own BridgeAnswer here and gains no field in any
// receipt schema from this spec.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module labs;

// the laws the settle step composes (settle_bridge.t27 and its own imports)
use t27os::settle_bridge::{bridge_pay, LabReceipt, Verification, SettlementRecord, BridgeAnswer, SB_OK, SB_REFUSE_NONCE};
use network::identity::{IdentityTable, identity_table};
use trinet::ledger::{Ledger, ledger_init, default_policy, register_node, V_OK};
use verified::payout::{OUT_CREDITED, OUT_NOT_ELIGIBLE, PAY_NORMAL, PAY_NONE};

// --- lab run steps -------------------------------------------------------

pub const STEP_FETCH : u8 = 0;
pub const STEP_BUILD_T27C : u8 = 1;
pub const STEP_BUILD_T27B : u8 = 2;
pub const STEP_CORPUS : u8 = 3;
pub const STEP_REFERENCE : u8 = 4;
pub const STEP_CARGO_TESTS : u8 = 5;
pub const STEP_RATCHET : u8 = 6;
pub const STEP_FUZZ : u8 = 7;
pub const STEP_PUBLISH : u8 = 8;
pub const STEP_SETTLE : u8 = 9;
pub const STEP_COUNT : u8 = 10;

// step names, one per STEP_* constant, in run order
pub const STEP_NAMES : str = "fetch,build-t27c,build-t27b,corpus,reference,cargo-tests,ratchet,fuzz,publish,settle";

// --- run states ----------------------------------------------------------

pub const RUN_PENDING : u8 = 0;
pub const RUN_RUNNING : u8 = 1;
pub const RUN_OK : u8 = 2;
pub const RUN_FAILED : u8 = 3;

// --- pure functions ------------------------------------------------------

// step_name(s): the name of step s, or "?" for an out-of-range step.
pub fn step_name(s: u8) -> str {
    if (s >= STEP_COUNT) {
        return "?";
    }
    return STEP_NAMES;
}

// is_final_step(s): true when s is the last step in the sequence.
pub fn is_final_step(s: u8) -> bool {
    return s == STEP_COUNT - 1;
}

// run_ok(ok, forced): a run verdict. The Railway lab's rule carries over: a
// forced test run or a failed test is never a clean pass.
pub fn run_verdict(ok: bool, forced: bool, failed: u32) -> u8 {
    if (forced) {
        return RUN_FAILED;
    }
    if (failed > 0) {
        return RUN_FAILED;
    }
    if (ok) {
        return RUN_OK;
    }
    return RUN_FAILED;
}

// --- the master repair cycle (proven 3x: #11735, #11786 pass 1 and 2) ------

// The ten local gates the repair cycle runs, in order. Every one exits 0 on
// a green tree, and every one runs on this machine -- no external service.
pub const GATE_WIDTHS : u8 = 0;
pub const GATE_TYPES_RATCHET : u8 = 1;
pub const GATE_TYPES_CLASSIFIED : u8 = 2;
pub const GATE_SEAL_COVERAGE : u8 = 3;
pub const GATE_SEAL_CURRENCY : u8 = 4;
pub const GATE_RING_DRIFT : u8 = 5;
pub const GATE_ASSERTIONLESS : u8 = 6;
pub const GATE_DOCUMENTED_CMDS : u8 = 7;
pub const GATE_EMIT_BITEXACT : u8 = 8;
pub const GATE_COUNT : u8 = 9;

// repair_needed(type_red, classified_red, coverage_red, currency_red,
//               widths_red, assertionless_red, documented_red, emit_red):
// the trigger rule. ANY red local gate means the repair cycle runs before
// any new work lands -- the port-train wave breaks master, the cycle
// clears it in ~3 minutes locally, and the repair PR opens itself.
pub fn repair_needed(type_red: bool, classified_red: bool, coverage_red: bool,
                     currency_red: bool, widths_red: bool, assertionless_red: bool,
                     documented_red: bool, emit_red: bool) -> bool {
    return type_red || classified_red || coverage_red || currency_red
        || widths_red || assertionless_red || documented_red || emit_red;
}

// gates_green(green_count): all GATE_COUNT gates must pass; 8 of 8.
pub fn gates_green(green_count: u8) -> bool {
    return green_count == GATE_COUNT;
}

// --- the settle step (the wiring; the law is settle_bridge.t27's) ----------

// After publish, the actor settles the run: the run's receipt + the run
// challenge go through the settle bridge. The wiring's own rule is the
// nonce: it IS the run challenge, never the actor's invention -- a challenge
// past the ledger's u32 nonce reaches the bridge's refusal (SB_REFUSE_NONCE),
// it does not truncate. Whether the call settles is the bridge's answer: the
// identity table, the two verifications and the coordinator's verdict pass
// through unchanged, and the amounts stay in the laws (ledger.t27 and
// payout.t27) -- no rate, no amount, no split, no registry here.
pub fn settle_step(l: Ledger, tab: IdentityTable, rec: LabReceipt,
                   v1: Verification, v2: Verification, node: u32, verdict: u8,
                   record: SettlementRecord) -> BridgeAnswer {
    const challenge : u64 = rec.challenge;
    return bridge_pay(l, tab, rec, v1, v2, node, (challenge as u32), verdict, record);
}

// --- tests ---------------------------------------------------------------

test step_names_are_ten {
    assert STEP_COUNT == 10;
    assert STEP_NAMES != "";
}

test step_name_out_of_range {
    const unknown = step_name(99);
    assert unknown == "?";
}

test final_step_is_settle {
    assert is_final_step(STEP_SETTLE) == true;
    assert is_final_step(STEP_PUBLISH) == false;
    assert is_final_step(STEP_FETCH) == false;
}

test run_verdict_fails_on_forced {
    const ok_run = run_verdict(true, false, 0);
    assert ok_run == RUN_OK;
    const forced_run = run_verdict(true, true, 0);
    assert forced_run == RUN_FAILED;
    const failed_run = run_verdict(true, false, 1);
    assert failed_run == RUN_FAILED;
}

test repair_needed_fires_on_any_red {
    // any single red gate fires the repair cycle
    assert repair_needed(true, false, false, false, false, false, false, false) == true;
    assert repair_needed(false, true, false, false, false, false, false, false) == true;
    assert repair_needed(false, false, false, false, true, false, false, false) == true;
    assert repair_needed(false, false, false, false, false, false, false, true) == true;
    // all green -> no repair
    assert repair_needed(false, false, false, false, false, false, false, false) == false;
}

test gates_green_requires_all_nine {
    assert gates_green(GATE_COUNT) == true;
    assert gates_green(GATE_COUNT - 1) == false;
    assert gates_green(0) == false;
}

// The wired settle: the actor's nonce IS the run challenge, and with the real
// table binding the lab's receipt key (PR #11850 -- the landed truth
// settle_bridge.t27's tripwire pins; both flip together if the row ever
// moves) the wired call proceeds to the green settle, the ledger law's own
// reward and nothing else.
test settle_step_wires_the_nonce_to_the_challenge {
    const rec : LabReceipt = LabReceipt { challenge: 11789, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 11789, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    const a = settle_step(l, identity_table(), rec, v1, v2, 1505, V_OK, record);
    assert a.attempt and a.refuse == SB_OK;
    assert a.nonce == 11789;
    assert a.outcome == OUT_CREDITED and a.pay == PAY_NORMAL;
}

// The wiring does not truncate: a receipt whose challenge is past the
// ledger's u32 nonce reaches the bridge's nonce refusal through the same
// wired call -- no settle attempt, the OUT_NOT_ELIGIBLE shape, nothing paid.
test settle_step_refuses_a_challenge_past_the_u32_nonce {
    const big : LabReceipt = LabReceipt { challenge: 39970371982, receipt_key: "25d5b8373b6d9986", tests_failed: 0, tests_vacuous: 0, stamp: true };
    const v1 : Verification = Verification { present: true, verifier_key: "5b5b5b5b5b5b5b5b", reproduced: true };
    const v2 : Verification = Verification { present: true, verifier_key: "6c6c6c6c6c6c6c6c", reproduced: true };
    const record : SettlementRecord = SettlementRecord { names_challenge: 39970371982, verdict_named: true };
    const l : Ledger = register_node(ledger_init(default_policy()), 1505, 6774813, true, 5000);
    const big_challenge : u64 = big.challenge;
    const truncated : u64 = (big_challenge as u32) as u64;
    const a = settle_step(l, identity_table(), big, v1, v2, 1505, V_OK, record);
    assert a.attempt == false and a.refuse == SB_REFUSE_NONCE;
    assert truncated != big_challenge;
    assert a.outcome == OUT_NOT_ELIGIBLE and a.pay == PAY_NONE;
}
