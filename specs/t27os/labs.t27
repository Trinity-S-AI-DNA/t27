// SPDX-License-Identifier: Apache-2.0
// specs/t27os/labs.t27 -- the t27b lab as a T27 OS actor (issue #11783).
// One actor drives the lab sequence the Railway lab ran: fetch, build,
// corpus, reference path, ratchet, fuzz -- and publishes the same JSON shape
// to the devices feed so `tri t27b doctor` and receipt comparison keep
// working. The lab's orchestration lives here as t27 law; the commands it
// runs go through the OS's own PTY (pty_server.t27), not a separate daemon.
//
// WHAT IS NOT HERE: the build recipes (install.t27 owns the toolchain), the
// feed format (devices.t27), the receipt signing (t27c corpus-receipt -- the
// lab calls it, it does not reimplement it), and the Railway lab itself
// (contrib/railway/t27b-lab -- stays as a read-only fallback per FR-005): T27OS
// is the primary host (owner decision 2026-10-23, t27#11800), the Railway lab
// keeps historical receipts until T27OS serves its own, and the settle
// amounts (ledger.t27's REWARD_PER_JOB_MTRI and payout.t27's shares
// own them; this wiring decides no rate, no amount, no split and registers
// no node -- the registry act is the owner's), and the receipt schema: the
// published receipt JSON is t27c corpus-receipt's shape, outside this tree,
// so the settle outcome (the OUT_* verdict and the payout gate's answer)
// travels in the bridge's own BridgeAnswer here and gains no field in any
// receipt schema from this spec.
//
// The SETTLE step's verdict reaches the actor's run state through
// settle_run_state: RUN_OK only on payout()'s PAY_NORMAL for a verified
// receipt; RUN_FAILED on every refusal, every slash and every credited job
// the tests did not verify. The mapping reads the BridgeAnswer only, and
// no mTRI moves on any of it.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module labs;

// --- lab run steps -------------------------------------------------------

pub const STEP_FETCH : u8 = 0;
pub const STEP_BUILD_T27C : u8 = 1;
pub const STEP_BUILD_T27B : u8 = 2;
pub const STEP_CORPUS : u8 = 3;
pub const STEP_REFERENCE : u8 = 4;
pub const STEP_CARGO_TESTS : u8 = 5;
pub const STEP_RATCHET : u8 = 6;
pub const STEP_FUZZ : u8 = 7;
pub const STEP_PUBLISH : u8 = 8;
pub const STEP_COUNT : u8 = 9;

// step names, one per STEP_* constant, in run order
pub const STEP_NAMES : str = "fetch,build-t27c,build-t27b,corpus,reference,cargo-tests,ratchet,fuzz,publish";

// --- run states ----------------------------------------------------------

pub const RUN_PENDING : u8 = 0;
pub const RUN_RUNNING : u8 = 1;
pub const RUN_OK : u8 = 2;
pub const RUN_FAILED : u8 = 3;

// --- pure functions ------------------------------------------------------

// step_name(s): the name of step s, or "?" for an out-of-range step.
pub fn step_name(s: u8) -> str {
    if (s >= STEP_COUNT) {
        return "?";
    }
    return STEP_NAMES;
}

// is_final_step(s): true when s is the last step in the sequence.
pub fn is_final_step(s: u8) -> bool {
    return s == STEP_COUNT - 1;
}

// run_ok(ok, forced): a run verdict. The Railway lab's rule carries over: a
// forced test run or a failed test is never a clean pass.
pub fn run_verdict(ok: bool, forced: bool, failed: u32) -> u8 {
    if (forced) {
        return RUN_FAILED;
    }
    if (failed > 0) {
        return RUN_FAILED;
    }
    if (ok) {
        return RUN_OK;
    }
    return RUN_FAILED;
}

// receipt_verdict(requested, reported, failed, blocked, vacuous): the verdict
// of one lab receipt against the spec list it was asked to verify
// (t27os#9). A receipt that drops a requested spec, carries a BLOCKED spec,
// a failed test or a vacuous test is never a clean pass: the executor gates
// on RUN_FAILED instead of swallowing the test-report exit code.
pub fn receipt_verdict(requested: u32, reported: u32, failed: u32,
                       blocked: u32, vacuous: u32) -> u8 {
    if (requested == 0) {
        return RUN_FAILED;
    }
    if (reported != requested) {
        return RUN_FAILED;
    }
    if (blocked > 0) {
        return RUN_FAILED;
    }
    if (vacuous > 0) {
        return RUN_FAILED;
    }
    return run_verdict(true, false, failed);
}

// --- the master repair cycle (proven 3x: #11735, #11786 pass 1 and 2) ------

// The ten local gates the repair cycle runs, in order. Every one exits 0 on
// a green tree, and every one runs on this machine -- no external service.
pub const GATE_WIDTHS : u8 = 0;
pub const GATE_TYPES_RATCHET : u8 = 1;
pub const GATE_TYPES_CLASSIFIED : u8 = 2;
pub const GATE_SEAL_COVERAGE : u8 = 3;
pub const GATE_SEAL_CURRENCY : u8 = 4;
pub const GATE_RING_DRIFT : u8 = 5;
pub const GATE_ASSERTIONLESS : u8 = 6;
pub const GATE_DOCUMENTED_CMDS : u8 = 7;
pub const GATE_EMIT_BITEXACT : u8 = 8;
pub const GATE_COUNT : u8 = 9;

// repair_needed(type_red, classified_red, coverage_red, currency_red,
//               widths_red, assertionless_red, documented_red, emit_red):
// the trigger rule. ANY red local gate means the repair cycle runs before
// any new work lands -- the port-train wave breaks master, the cycle
// clears it in ~3 minutes locally, and the repair PR opens itself.
pub fn repair_needed(type_red: bool, classified_red: bool, coverage_red: bool,
                     currency_red: bool, widths_red: bool, assertionless_red: bool,
                     documented_red: bool, emit_red: bool) -> bool {
    return type_red || classified_red || coverage_red || currency_red
        || widths_red || assertionless_red || documented_red || emit_red;
}

// gates_green(green_count): all GATE_COUNT gates must pass; 8 of 8.
pub fn gates_green(green_count: u8) -> bool {
    return green_count == GATE_COUNT;
}

// --- gate commands: the repair cycle as executable data -------------------
//
// One shell command per GATE_* constant, in gate order. Each exits 0 on a
// green tree and runs on this machine. The invocations are the ones CI runs
// (corpus-ratchet.yml, documented-commands.yml, emit-bitexact-gate.yml,
// seal-coverage.yml, spec-guards.yml); the cycle proven 6x in practice
// (#11735, #11786 x2, #11825, #11838) runs all nine locally in ~3 minutes.

pub const GATE_COMMANDS : [9]str = [
    "python3 tools/check_verilog_widths.py --require",
    "tri types ratchet",
    "tri types classified",
    "python3 tools/check_seal_coverage.py",
    "python3 tools/check_seal_currency.py",
    "python3 tools/check_ring_spec_drift.py",
    "python3 tools/check_assertionless_spec_tests.py",
    "python3 tools/check_documented_commands_exist.py",
    "python3 tools/verify_emit_bitexact.py --require",
];

// gate_command(i): the shell command that runs gate i, or "" for an
// out-of-range gate.
pub fn gate_command(i: u8) -> str {
    if (i >= GATE_COUNT) {
        return "";
    }
    return GATE_COMMANDS[i];
}

// all_gates_pass(results): true only when every gate verdict is true. The
// caller passes one verdict per gate, in gate order.
pub fn all_gates_pass(results: [9]bool) -> bool {
    var i : usize = 0;
    while (i < GATE_COUNT as usize) {
        if (results[i] == false) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// --- the executor's surface steps (t27os#10: receipts lost) ----------------

// The executor (t27os .github/workflows/lab.yml, proposed by TRI CLAW from
// this law) measures the named specs, then runs optional surfaces, then
// writes the receipt. Three measured ways a run lost its receipt: the
// encoder fetch ran on every dispatch and died on a third-party CDN (~40%);
// a surface failure skipped the receipt step after the measurement had
// already run (run 39987596010); a full sha went through an unauthenticated
// API lookup that answered null (run 39993710023).
pub const SURF_ENCODER_FETCH : u8 = 0;
pub const SURF_M6 : u8 = 1;
pub const SURF_WASM : u8 = 2;
pub const SURF_COUNT : u8 = 3;
pub const SHA_HEX_LEN : u32 = 40;

// surface_runs(s, m6, wasm): the encoder fetch belongs to M6 -- a dispatch
// with m6 off never touches the encoder CDN. Out-of-range surfaces never run.
pub fn surface_runs(s: u8, m6: bool, wasm: bool) -> bool {
    if (s == SURF_ENCODER_FETCH or s == SURF_M6) {
        return m6;
    }
    if (s == SURF_WASM) {
        return wasm;
    }
    return false;
}

// receipt_written(measured, surface_failed): once the measurement step ran,
// the receipt is written whatever a later surface did -- the failure goes
// INTO the receipt, it does not erase it. No measurement, no receipt.
pub fn receipt_written(measured: bool, surface_failed: bool) -> bool {
    if (surface_failed and measured) {
        return true;
    }
    return measured;
}

// sha_needs_lookup(len, lower_hex): a ref that is already 40 lowercase hex is
// the sha; only a short sha, a branch or an empty ref goes to the API.
pub fn sha_needs_lookup(len: u32, lower_hex: bool) -> bool {
    if (len == SHA_HEX_LEN and lower_hex) {
        return false;
    }
    return true;
}

// sha_resolved_ok(len, lower_hex): the lookup's answer is accepted only when
// it is 40 hex; anything else (null, a rate-limit body) fails the step with
// the body printed, never checks out a branch named "null".
pub fn sha_resolved_ok(len: u32, lower_hex: bool) -> bool {
    return len == SHA_HEX_LEN and lower_hex;
}

// --- tests ---------------------------------------------------------------

test step_names_are_nine {
    assert STEP_COUNT == 9;
    assert STEP_NAMES != "";
}

test step_name_out_of_range {
    const unknown = step_name(99);
    assert unknown == "?";
}

test final_step_is_publish {
    assert is_final_step(STEP_PUBLISH) == true;
    assert is_final_step(STEP_FETCH) == false;
}

test run_verdict_fails_on_forced {
    const ok_run = run_verdict(true, false, 0);
    assert ok_run == RUN_OK;
    const forced_run = run_verdict(true, true, 0);
    assert forced_run == RUN_FAILED;
    const failed_run = run_verdict(true, false, 1);
    assert failed_run == RUN_FAILED;
}

test repair_needed_fires_on_any_red {
    // any single red gate fires the repair cycle
    assert repair_needed(true, false, false, false, false, false, false, false) == true;
    assert repair_needed(false, true, false, false, false, false, false, false) == true;
    assert repair_needed(false, false, false, false, true, false, false, false) == true;
    assert repair_needed(false, false, false, false, false, false, false, true) == true;
    // all green -> no repair
    assert repair_needed(false, false, false, false, false, false, false, false) == false;
}

test gates_green_requires_all_nine {
    assert gates_green(GATE_COUNT) == true;
    assert gates_green(GATE_COUNT - 1) == false;
    assert gates_green(0) == false;
}

test gate_commands_cover_every_gate_and_name_real_checkers {
    assert GATE_COMMANDS.len() == GATE_COUNT;
    // the first and last gates pin the exact commands the cycle shells out to
    assert gate_command(GATE_WIDTHS) == "python3 tools/check_verilog_widths.py --require";
    assert gate_command(GATE_EMIT_BITEXACT) == "python3 tools/verify_emit_bitexact.py --require";
    // every in-range gate carries a command; out-of-range is empty
    var i : u8 = 0;
    while (i < GATE_COUNT) {
        assert gate_command(i) != "";
        i = i + 1;
    }
    assert gate_command(GATE_COUNT) == "";
    assert gate_command(99) == "";
}

test all_gates_pass_requires_every_gate_green {
    var all_green : [9]bool = [true, true, true, true, true, true, true, true, true];
    assert all_gates_pass(all_green) == true;
    // one red anywhere holds the verdict down
    var one_red : [9]bool = [true, true, true, true, false, true, true, true, true];
    assert all_gates_pass(one_red) == false;
    var first_red : [9]bool = [false, true, true, true, true, true, true, true, true];
    assert all_gates_pass(first_red) == false;
    var last_red : [9]bool = [true, true, true, true, true, true, true, true, false];
    assert all_gates_pass(last_red) == false;
    var none_green : [9]bool = [false, false, false, false, false, false, false, false, false];
    assert all_gates_pass(none_green) == false;
}

test receipt_verdict_red_on_omitted_blocked_failed_vacuous {
    // the 15:53Z specimen: 4 specs asked, identity.t27 missing from the receipt
    assert receipt_verdict(4, 3, 0, 0, 0) == RUN_FAILED;
    // the 15:34Z specimen: identity.t27 reported blocked=1
    assert receipt_verdict(4, 4, 0, 1, 0) == RUN_FAILED;
    assert receipt_verdict(4, 4, 2, 0, 0) == RUN_FAILED;
    assert receipt_verdict(4, 4, 0, 0, 1) == RUN_FAILED;
    // an empty request verifies nothing
    assert receipt_verdict(0, 0, 0, 0, 0) == RUN_FAILED;
    // every asked spec reported, none blocked, failed or vacuous
    assert receipt_verdict(4, 4, 0, 0, 0) == RUN_OK;
}

// t27os#10: an m6=false dispatch never runs the encoder fetch (the CDN that
// killed ~40% of runs); with m6 on it does; wasm follows its own flag.
test encoder_fetch_runs_only_with_m6 {
    assert surface_runs(SURF_ENCODER_FETCH, false, false) == false;
    assert surface_runs(SURF_ENCODER_FETCH, false, true) == false;
    assert surface_runs(SURF_ENCODER_FETCH, true, false) == true;
    assert surface_runs(SURF_M6, false, true) == false;
    assert surface_runs(SURF_WASM, false, true) == true;
    assert surface_runs(SURF_WASM, true, false) == false;
    assert surface_runs(SURF_COUNT, true, true) == false;
}

// run 39987596010: step 7 measured kernel 10/10 and lanes_view 42/42, M6
// failed, and no receipt was written. The law: that run writes its receipt.
test a_surface_failure_keeps_the_receipt {
    assert receipt_written(true, true) == true;
    assert receipt_written(true, false) == true;
    assert receipt_written(false, true) == false;
    assert receipt_written(false, false) == false;
}

// run 39993710023: a full 40-hex sha went to the API and came back null.
test a_full_sha_is_used_as_is {
    assert sha_needs_lookup(40, true) == false;
    assert sha_needs_lookup(9, true) == true;
    assert sha_needs_lookup(40, false) == true;
    assert sha_needs_lookup(0, false) == true;
    // "null" is 4 bytes, not 40 hex: the step fails instead of checking it out
    assert sha_resolved_ok(4, false) == false;
    assert sha_resolved_ok(40, true) == true;
    assert sha_resolved_ok(40, false) == false;
}
