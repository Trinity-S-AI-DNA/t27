// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_pilot.t27 -- the PILOT fleet manifest (owner brief 2026-10-27):
// the owner's own machines enrolled into the consenting node market BEFORE any
// external node. A manifest is DATA with invariants: every declared node must
// pass node_market.t27's enrollment law, an enrolled node with keys must carry a
// positive cap, a compute-only node declares zero keys and zero cap, and an
// unreachable machine is honestly NOT enrolled until it is reachable again.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodePilot;

use t27os::node_market::enroll_ok;
use t27os::node_market::EN_OK;

// -- the pilot's three machines (owner's devices, 2026-10-27) --
// mac-t27os: this Mac; contributes the z.ai key pool's spend under one cap.
pub const MAC_ENROLLED : bool = true;
pub const MAC_KEYS : usize = 1;
pub const MAC_CAP_MUSD : u32 = 200;
// givel-vps: TLS edge + compute only; contributes NO keys.
pub const GIVEL_ENROLLED : bool = true;
pub const GIVEL_KEYS : usize = 0;
pub const GIVEL_CAP_MUSD : u32 = 0;
// bot-farm: unreachable from every owned network on 2026-10-27 (port 22
// filtered); it joins the day it is reachable, not before. Honest refusal.
pub const BOTFARM_ENROLLED : bool = false;
pub const BOTFARM_KEYS : usize = 0;
pub const BOTFARM_CAP_MUSD : u32 = 0;

pub const PILOT_ENROLLED_COUNT : usize = 2;

/// One node's declaration is consistent when its enrollment, key count and cap
/// agree: no keys without enrollment, no cap without keys, no enrollment of an
/// unreachable machine.
pub fn node_declaration_ok(enrolled : bool, keys : usize, cap_musd : u32) -> bool {
    if (enrolled == false) {
        return keys == 0 and cap_musd == 0;
    }
    if (keys == 0) { return cap_musd == 0; }
    return cap_musd > 0;
}

/// The market's own admission law must accept every enrolled pilot node.
pub fn mac_admitted() -> u8 {
    return enroll_ok(MAC_KEYS, MAC_CAP_MUSD > 0);
}

pub fn givel_admitted() -> u8 {
    return enroll_ok(GIVEL_KEYS, GIVEL_CAP_MUSD > 0);
}

test pilot_manifest_holds {
    var mac_e : bool = MAC_ENROLLED;
    var giv_e : bool = GIVEL_ENROLLED;
    var bf_e : bool = BOTFARM_ENROLLED;
    assert mac_e == true;
    assert giv_e == true;
    assert bf_e == false;
}

test every_declaration_is_consistent {
    assert node_declaration_ok(true, 1, 200) == true;
    assert node_declaration_ok(true, 0, 0) == true;
    assert node_declaration_ok(false, 0, 0) == true;
    assert node_declaration_ok(false, 1, 200) == false;
    assert node_declaration_ok(true, 1, 0) == false;
    assert node_declaration_ok(true, 0, 500) == false;
}

test the_market_admits_exactly_the_enrolled_two {
    assert mac_admitted() == EN_OK;
    assert givel_admitted() == EN_OK;
    var enrolled : usize = PILOT_ENROLLED_COUNT;
    var want : usize = 2;
    assert enrolled == want;
}
