; specs/t27os/window_keep.t27 -- the T27 OS window keeps what it shows across launches.
; Owner bug, 2026-10-19 (epic #10782): after a reboot the open screen, spaces, task and panes were gone.
; The window saved them only on a hot reload, under a key the next process cleared, so an ordinary
; launch always started at home. Now the loop folds the kept state into one key every frame and writes
; it to the user defaults once the key has held still for WK_SETTLE frames (a debounce: a drag or a
; typed name is not written thirty times a second). Every launch reads it back. A clean start is an
; explicit act: hold Option while the window opens, and it starts at home and forgets the kept state.
; The window frame is not here: AppKit keeps it under the autosave name "T27OS".

module T27osWindowKeep;

use t27os::frame_gate::fg_mix;

/// Frames the kept state must hold still before it is written (0.5 s at 30 fps).
pub const WK_SETTLE : u32 = 15;
/// NSEventModifierFlagOption, 1 << 19.
pub const WK_OPTION : u64 = 524288;

/// The flags word: collapsed sidebar 1, dashboard 2, quick panel 4, god view 8, doctor panel 16,
/// auto-open off 32 (the default, on, is 0 so an empty defaults store reads as the defaults).
pub fn wk_flags(collapsed: bool, dash: bool, qp: bool, god: bool, dp: bool, auto_open: bool) -> u64 {
    var fl : u64 = 0;
    if (collapsed) { fl = fl + 1; }
    if (dash) { fl = fl + 2; }
    if (qp) { fl = fl + 4; }
    if (god) { fl = fl + 8; }
    if (dp) { fl = fl + 16; }
    if (!auto_open) { fl = fl + 32; }
    return fl;
}

/// One bit of the flags word: bit 0..5 as 1, 2, 4, 8, 16, 32.
pub fn wk_bit(fl: u64, bit: u64) -> bool {
    return fl / bit % 2 == 1;
}

/// The key of the kept state: it changes when any kept value changes.
pub fn wk_key(state: u32, shown: u32, task: u32, space: u32, ss: u64, sp: u32, cur: u32, fl: u64, evn: u32) -> u64 {
    var h : u64 = fg_mix(0, @as(u64, state));
    h = fg_mix(h, @as(u64, shown));
    h = fg_mix(h, @as(u64, task));
    h = fg_mix(h, @as(u64, space));
    h = fg_mix(h, ss);
    h = fg_mix(h, @as(u64, sp));
    h = fg_mix(h, @as(u64, cur));
    h = fg_mix(h, fl);
    return fg_mix(h, @as(u64, evn));
}

/// Frames the key has held still, after this frame.
pub fn wk_still(still: u32, key: u64, last: u64) -> u32 {
    if (key != last) { return 0; }
    if (still >= 9999) { return still; }
    return still + 1;
}

/// Write now? The key differs from the one written and has held still for WK_SETTLE frames.
pub fn wk_due(key: u64, saved: u64, still: u32) -> bool {
    return key != saved and still >= WK_SETTLE;
}

/// Restore at launch? When something was kept and Option is not held.
pub fn wk_restore(kept: u64, mods: u64) -> bool {
    if (wk_bit(mods, WK_OPTION)) { return false; }
    return kept == 1;
}

test the_flags_word_round_trips {
    const fl : u64 = wk_flags(true, false, true, false, true, false);
    assert fl == 1 + 4 + 16 + 32;
    assert wk_bit(fl, 1);
    assert wk_bit(fl, 2) == false;
    assert wk_bit(fl, 4);
    assert wk_bit(fl, 8) == false;
    assert wk_bit(fl, 16);
    assert wk_bit(fl, 32);
    // the defaults are all zero, so a launch with nothing kept reads as the defaults
    assert wk_flags(false, false, false, false, false, true) == 0;
}

test any_kept_value_changes_the_key {
    const k : u64 = wk_key(1, 2, 3, 0, 77, 5, 1, 0, 4);
    assert k == wk_key(1, 2, 3, 0, 77, 5, 1, 0, 4);
    assert k != wk_key(2, 2, 3, 0, 77, 5, 1, 0, 4);
    assert k != wk_key(1, 2, 3, 1, 77, 5, 1, 0, 4);
    assert k != wk_key(1, 2, 3, 0, 78, 5, 1, 0, 4);
    assert k != wk_key(1, 2, 3, 0, 77, 5, 2, 0, 4);
    assert k != wk_key(1, 2, 3, 0, 77, 5, 1, 1, 4);
    assert k != wk_key(1, 2, 3, 0, 77, 5, 1, 0, 5);
}

test a_change_is_written_once_it_settles {
    // a new key: the count restarts, nothing is written yet
    assert wk_still(40, 9, 8) == 0;
    assert wk_due(9, 8, 0) == false;
    assert wk_due(9, 8, WK_SETTLE - 1) == false;
    assert wk_due(9, 8, WK_SETTLE);
    // once written, a still key is not written again
    assert wk_due(9, 9, 500) == false;
    assert wk_still(3, 9, 9) == 4;
    assert wk_still(9999, 9, 9) == 9999;
}

test option_at_launch_is_a_clean_start {
    assert wk_restore(1, 0);
    assert wk_restore(0, 0) == false;
    assert wk_restore(1, WK_OPTION) == false;
    // shift (1 << 17) and command (1 << 20) do not count
    assert wk_restore(1, 131072 + 1048576);
}
