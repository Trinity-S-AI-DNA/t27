// SPDX-License-Identifier: Apache-2.0
// specs/t27os/chat_graph.t27 -- T27 OS chat_graph.t27: fold chat and
// delegation events into the work graph (Wave B2).
// Part of M7 milestone (milestone #11). Closes #13073.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::chat_graph;

pub const CHAT_GRAPH_MAX_EVENTS : u32 = 64;

pub struct ChatEvent { id: str, folded: bool };

pub fn chat_event_folded(e: ChatEvent) -> bool {
    return e.folded;
}

test "chat_event_folded" {
    assert(chat_event_folded(ChatEvent { id: "event-1", folded: true }));
    assert(!chat_event_folded(ChatEvent { id: "event-2", folded: false }));
}

invariant chat_graph_max_events_positive {
    assert CHAT_GRAPH_MAX_EVENTS > 0;
}