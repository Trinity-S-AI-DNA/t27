// SPDX-License-Identifier: Apache-2.0
; Closes #11275
; specs/t27os/router_glue.t27 -- the host glue of the stage-2 router's cache law: how the host feeds the
; cache law (router_cache.t27, router_stream.t27) without weakening it.
;   (a) the PIN KEY is composed from TRUSTED host fields only: owner, profile and the host session id,
;       joined by dots, each through the opaque ledger alphabet. Two owners (or two profiles) never share
;       a pin even for the same sid: isolation is in the key, not in a hope. A field holding any other
;       byte refuses the whole key (0) -- the caller then walks the unpinned chain; it never falls back
;       to the client's metadata.user_id (that fallback stays router_cache's own documented law, never
;       the glue's).
;   (b) the REMEMBERED ROUTE is a preference over the CURRENT chain, never a bypass: it is honoured only
;       while pr_in_chain holds it; a chain reconfiguration, a rested provider or an invalid pin clears
;       the preference and the walk goes by the standing route policy unchanged.
;   (c) the LEDGER record of ONE ATTEMPT: attempt id, pin key, route, the stream accumulator's counters,
;       its completion status and the reason the record is UNKNOWN. Every string field passes the opaque
;       alphabet first -- an unsafe field is written EMPTY, never escaped by hand and never raw. No
;       prompt text, no key value, no personal data.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osRouterGlue;

use t27os::editors::same_bytes;
use t27os::provider_router::pr_in_chain;
use t27os::router_cache::rc_key_ok;
use t27os::router_cache::rc_ledger_line;
use t27os::router_cache::rc_cache_class;
use t27os::router_cache::rc_hit_permille;
use t27os::router_stream::RS_INCOMPLETE;
use t27os::router_stream::RS_CLOSED;
use t27os::router_stream::RS_FIELDS;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

/// Why a closed attempt's record is UNKNOWN, or RG_KNOWN when it is not:
///   0 the cache-read field was reported and the class is HIT or MISS;
///   1 the provider never reported a cache-read field;
///   2 the attempt aborted before the usage arrived (incomplete stream).
pub const RG_KNOWN : u32 = 0;
pub const RG_NO_FIELD : u32 = 1;
pub const RG_ABORTED : u32 = 2;

/// The trusted pin key of a session: "owner.profile.sid", each field through the opaque alphabet. Any
/// bad or empty field refuses the whole key (0 written): the walk then runs unpinned for this attempt.
/// Returns the length written.
pub fn rg_pin_key(out: []u8, owner: []const u8, profile: []const u8, sid: []const u8) -> usize {
    if (rc_key_ok(owner) == false) { return 0; }
    if (rc_key_ok(profile) == false) { return 0; }
    if (rc_key_ok(sid) == false) { return 0; }
    var p : usize = put_bytes(out, 0, owner);
    out[p] = 46; p = p + 1;
    p = put_bytes(out, p, profile);
    out[p] = 46; p = p + 1;
    return put_bytes(out, p, sid);
}

/// Is the remembered route still a valid preference for the CURRENT chain? The host clears its stored
/// pin when this says false -- the next attempt goes by the standing route policy, and the stored pin is
/// not kept for a chain that no longer holds it.
pub fn rg_pin_valid(order: []const u8, remembered: []const u8) -> bool {
    if (remembered.len == 0) { return false; }
    return pr_in_chain(order, remembered);
}

/// Why the attempt's record is UNKNOWN (the constants above), from the stream accumulator's state.
pub fn rg_unknown_reason(st: []const u64) -> u32 {
    if ((st[5] & RS_INCOMPLETE) != 0) { return RG_ABORTED; }
    if ((st[3] & 2) == 0) { return RG_NO_FIELD; } // the READ validity bit, router_cache RC_V_READ
    return RG_KNOWN;
}

/// The ledger line of ONE ATTEMPT: attempt,key,route,schema,mask,total,read,write,class,flags,reason.
/// The attempt id and the pin key are written only when they pass the opaque alphabet; an unsafe value
/// becomes an EMPTY field -- the counters and the class are still recorded. Returns the length written.
pub fn rg_attempt_line(out: []u8, attempt: []const u8, key: []const u8, route: []const u8, st: []const u64) -> usize {
    var p : usize = 0;
    if (rc_key_ok(attempt)) { p = put_bytes(out, p, attempt); }
    out[p] = 44; p = p + 1;
    if (rc_key_ok(key)) { p = put_bytes(out, p, key); }
    out[p] = 44; p = p + 1;
    if (rc_key_ok(route)) { p = put_bytes(out, p, route); }
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[4]);
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[3]);
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[0]);
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[1]);
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[2]);
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, rc_cache_class((st[3] & 2) != 0, st[1]));
    out[p] = 44; p = p + 1;
    p = put_dec(out, p, st[5]);
    out[p] = 44; p = p + 1;
    return put_dec(out, p, rg_unknown_reason(st[0..]));
}

test "the_pin_key_is_owner_profile_sid_and_two_owners_never_share_it" {
    var a : [96]u8 = undefined;
    var b : [96]u8 = undefined;
    const na : usize = rg_pin_key(a[0..], "owner-1", "zai", "sid-9");
    assert same_bytes(a[0..na], "owner-1.zai.sid-9");
    const nb : usize = rg_pin_key(b[0..], "owner-2", "zai", "sid-9");
    assert same_bytes(a[0..na], b[0..nb]) == false;
    const np : usize = rg_pin_key(b[0..], "owner-1", "openrouter", "sid-9");
    assert same_bytes(a[0..na], b[0..np]) == false;
}

test "an_unsafe_or_empty_field_refuses_the_whole_pin_key" {
    var out : [96]u8 = undefined;
    assert rg_pin_key(out[0..], "ow,ner", "zai", "sid-9") == 0;
    assert rg_pin_key(out[0..], "owner", "", "sid-9") == 0;
    assert rg_pin_key(out[0..], "owner", "zai", "si\"d") == 0;
}

test "a_remembered_route_is_valid_only_while_the_current_chain_holds_it" {
    assert rg_pin_valid("zai,kie,nemotron", "kie");
    assert rg_pin_valid("zai,kie,nemotron", "ghost") == false;
    assert rg_pin_valid("zai,kie,nemotron", "") == false;
    assert rg_pin_valid("zai,nemotron", "kie") == false;
}

test "the_attempt_line_carries_status_and_reason_and_counters" {
    var st : [RS_FIELDS]u64 = undefined;
    var i : usize = 0;
    while (i < RS_FIELDS) { st[i] = 0; i = i + 1; }
    st[0] = 141000; st[1] = 60000; st[2] = 0;
    st[3] = 3; st[4] = 0; st[5] = RS_CLOSED;
    var line : [160]u8 = undefined;
    const n : usize = rg_attempt_line(line[0..], "att-1", "owner-1.zai.s9", "zai", st[0..]);
    assert same_bytes(line[0..n], "att-1,owner-1.zai.s9,zai,0,3,141000,60000,0,1,2,0");
}

test "an_incomplete_attempt_records_unknown_with_the_abort_reason" {
    var st : [RS_FIELDS]u64 = undefined;
    var i : usize = 0;
    while (i < RS_FIELDS) { st[i] = 0; i = i + 1; }
    st[0] = 100; st[5] = RS_CLOSED + RS_INCOMPLETE;
    var line : [160]u8 = undefined;
    const n : usize = rg_attempt_line(line[0..], "att-2", "owner-1.zai.s9", "zai", st[0..]);
    assert same_bytes(line[0..n], "att-2,owner-1.zai.s9,zai,0,0,100,0,0,2,3,2");
}

test "an_unsafe_attempt_or_key_becomes_an_empty_field_the_counters_survive" {
    var st : [RS_FIELDS]u64 = undefined;
    var i : usize = 0;
    while (i < RS_FIELDS) { st[i] = 0; i = i + 1; }
    st[0] = 100; st[1] = 80; st[3] = 3; st[5] = RS_CLOSED;
    var line : [160]u8 = undefined;
    const n : usize = rg_attempt_line(line[0..], "at,t", "bad key", "zai", st[0..]);
    assert same_bytes(line[0..n], ",,zai,0,3,100,80,0,1,2,0");
}

test "the_reason_says_no_field_when_the_provider_never_reported_one" {
    var st : [RS_FIELDS]u64 = undefined;
    var i : usize = 0;
    while (i < RS_FIELDS) { st[i] = 0; i = i + 1; }
    st[5] = RS_CLOSED;
    assert rg_unknown_reason(st[0..]) == RG_NO_FIELD;
    st[3] = 2;
    assert rg_unknown_reason(st[0..]) == RG_KNOWN;
    st[5] = RS_CLOSED + RS_INCOMPLETE;
    assert rg_unknown_reason(st[0..]) == RG_ABORTED;
}
