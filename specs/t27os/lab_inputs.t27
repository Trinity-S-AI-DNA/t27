// SPDX-License-Identifier: Apache-2.0
// specs/t27os/lab_inputs.t27 -- dispatch inputs reach the lab shell through env, never by
// expansion (issue #11950; board Trinity-S-AI-DNA/t27os#3).
//
// Measured 2026-10-24 at Trinity-S-AI-DNA/t27os 65b9e8c, .github/workflows/lab.yml: the sha
// step runs `REF=${{ inputs.sha }}` and the test-report step runs
// `for spec in ${{ inputs.specs }}; do`. GitHub expands ${{ }} into the script text BEFORE
// bash parses it, so a specs value such as `a.t27; <command>` is shell, and it runs with the
// job's `contents: write` token. Only accounts with write access can dispatch, which keeps the
// exposure small; but the lab's claim is that a receipt reports only what the named specs did,
// and a dispatch that can run any command cannot back that claim.
// The same text was in our own law: specs/t27os/lab_legs.t27 :: T27B_JOB_YAML held
// `for spec in ${{ inputs.specs }}`, so the generator would have copied the defect into the
// t27b job. It is read here through `use`, not copied; fixed at its home by #11952, and
// job_inputs_ok below keeps it fixed (the job is one text, so its check reads the whole job).
//
// The law:
//   - the text of a `run:` body never holds an input expansion (${{ inputs. or
//     ${{ github.event.inputs.);
//   - an input reaches the shell as an environment variable named in the step's `env:` block
//     (SPECS: ${{ inputs.specs }}), and the body reads "$SPECS";
//   - a list input is split with globbing off (set -f), so a `*` in a spec list names a file
//     literally and cannot widen the list.
// A step is held as two texts, ENV then RUN, and the generator writes them in that order;
// the law reads the RUN text alone, so a legitimate expansion in env: is never mistaken for
// one in the body. Expressions in `if:` are evaluated by GitHub, not by bash, and are out of
// scope. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLabInputs;

use t27os::keysync::contains;
use t27os::lab_legs::T27B_JOB_YAML;

// --- what may not appear in a run body ----------------------------------

pub const INPUT_EXPANSION : str = "${{ inputs.";
pub const EVENT_INPUT_EXPANSION : str = "${{ github.event.inputs.";

// --- how an input reaches the shell instead ------------------------------

pub const SPECS_ENV : str = "SPECS: ${{ inputs.specs }}";
pub const SHA_ENV : str = "REQ_SHA: ${{ inputs.sha }}";
pub const SPECS_LOOP : str = "for spec in $SPECS; do";
pub const NO_GLOB : str = "set -f";
pub const SHA_READ : str = "REF=\"$REQ_SHA\"";

// --- the live steps, measured (t27os 65b9e8c), as negative controls -----

pub const LIVE_SHA_RUN : str = "          REF=${{ inputs.sha }}\n          [ -z \"$REF\" ] && REF=master\n";
pub const PRE_11952_T27B_LOOP : str = "          for spec in ${{ inputs.specs }}; do\n            ./target/release/t27b test \"$spec\" --check > /tmp/b.txt 2>&1 || true\n";
pub const LIVE_TEST_RUN : str ="          cd t27\n          mkdir -p /tmp/out\n          i=0\n          for spec in ${{ inputs.specs }}; do\n            i=$((i+1))\n";

// --- the corrected steps, as text for the lab.yml generator -------------

pub const SHA_STEP_ENV : str = "      - name: resolve the sha (accepts short; empty = master)\n        id: sha\n        env:\n          REQ_SHA: ${{ inputs.sha }}\n";
pub const SHA_STEP_RUN : str = "        run: |\n          REF=\"$REQ_SHA\"\n          [ -z \"$REF\" ] && REF=master\n          case \"$REF\" in *[!0-9A-Za-z._/-]*) echo \"refused ref\"; exit 1;; esac\n          FULL=$(curl -s \"https://api.github.com/repos/Trinity-S-AI-DNA/t27/commits/$REF\" | jq -r .sha)\n          echo \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"\n";

pub const TEST_STEP_ENV : str = "      - name: test-report every named spec\n        shell: bash\n        env:\n          SPECS: ${{ inputs.specs }}\n";
pub const TEST_STEP_RUN : str = "        run: |\n          set -f\n          cd t27\n          mkdir -p /tmp/out\n          i=0\n          for spec in $SPECS; do\n            i=$((i+1))\n            if ./target/release/t27c test-report \"$spec\" > /tmp/out/report_$i.txt 2>&1; then :; fi\n";

// run_body_safe(body): the run text holds no input expansion.
pub fn run_body_safe(body: []const u8) -> bool {
    return !contains(body, INPUT_EXPANSION) and !contains(body, EVENT_INPUT_EXPANSION);
}

// specs_step_ok(env, body): the step hands the spec list to bash as $SPECS, splits it with
// globbing off, and its body expands no input.
pub fn specs_step_ok(env: []const u8, body: []const u8) -> bool {
    return run_body_safe(body) and contains(env, SPECS_ENV)
        and contains(body, NO_GLOB) and contains(body, SPECS_LOOP);
}

// sha_step_ok(env, body): the requested sha reaches bash as $REQ_SHA, never by expansion.
pub fn sha_step_ok(env: []const u8, body: []const u8) -> bool {
    return run_body_safe(body) and contains(env, SHA_ENV) and contains(body, SHA_READ);
}

// --- a whole job held as one text (lab_legs.t27 :: T27B_JOB_YAML) -------
//
// Its env: block legitimately holds ${{ inputs.specs }}, so run_body_safe cannot read it.
// What may never appear anywhere in the job is an input expanded where bash parses it: as a
// loop list or on the right of an assignment.
pub const LOOP_EXPANSION : str = "in ${{ inputs.";
pub const ASSIGN_EXPANSION : str = "=${{ inputs.";

// job_inputs_ok(job): the job hands the spec list to bash through env, splits it with globbing
// off, and expands no input as a loop list or an assignment.
pub fn job_inputs_ok(job: []const u8) -> bool {
    return contains(job, SPECS_ENV) and contains(job, NO_GLOB) and contains(job, SPECS_LOOP)
        and !contains(job, LOOP_EXPANSION) and !contains(job, ASSIGN_EXPANSION);
}

test corrected_steps_are_the_law {
    assert specs_step_ok(TEST_STEP_ENV, TEST_STEP_RUN);
    assert sha_step_ok(SHA_STEP_ENV, SHA_STEP_RUN);
    // the env block legitimately holds the expansion; the law never reads it as a body
    assert contains(TEST_STEP_ENV, INPUT_EXPANSION);
    assert contains(SHA_STEP_ENV, INPUT_EXPANSION);
}

test live_lab_steps_are_refused {
    // negative controls: the two steps measured in lab.yml at t27os 65b9e8c
    assert run_body_safe(LIVE_TEST_RUN) == false;
    assert run_body_safe(LIVE_SHA_RUN) == false;
    assert specs_step_ok(TEST_STEP_ENV, LIVE_TEST_RUN) == false;
    assert sha_step_ok(SHA_STEP_ENV, LIVE_SHA_RUN) == false;
}

test t27b_job_reads_specs_through_env {
    // our own law's t27b job, fixed at its home (#11952)
    assert job_inputs_ok(T27B_JOB_YAML);
    // and still one text whose env: block holds the expansion, so the body-only check cannot read it
    assert run_body_safe(T27B_JOB_YAML) == false;
}

test pre_11952_t27b_job_is_refused {
    // negative control: the loop the job held before #11952, with env and set -f present
    assert job_inputs_ok(PRE_11952_T27B_LOOP) == false;
    assert job_inputs_ok("        env:\n          SPECS: ${{ inputs.specs }}\n        run: |\n          set -f\n          for spec in ${{ inputs.specs }}; do\n") == false;
    assert run_body_safe(PRE_11952_T27B_LOOP) == false;
    // a good loop beside an input read by assignment is refused too
    assert job_inputs_ok("        env:\n          SPECS: ${{ inputs.specs }}\n        run: |\n          set -f\n          REF=${{ inputs.sha }}\n          for spec in $SPECS; do\n") == false;
    // env set, loop over $SPECS, but globbing left on
    assert job_inputs_ok("        env:\n          SPECS: ${{ inputs.specs }}\n        run: |\n          for spec in $SPECS; do\n") == false;
    // the same job with globbing off passes: the controls above differ from it by one line each
    assert job_inputs_ok("        env:\n          SPECS: ${{ inputs.specs }}\n        run: |\n          set -f\n          for spec in $SPECS; do\n") == true;
}

test event_inputs_form_is_refused_too {
    assert run_body_safe("        run: |\n          for spec in ${{ github.event.inputs.specs }}; do\n") == false;
    // an unrelated expansion (a step output) is not an input and is not this law's subject
    assert run_body_safe("        run: |\n          echo ${{ steps.sha.outputs.resolved }}\n") == true;
}

test half_fixes_are_refused {
    // env is set but the body still expands the input
    assert specs_step_ok(TEST_STEP_ENV, LIVE_TEST_RUN) == false;
    // the body reads $SPECS but the env block never sets it
    assert specs_step_ok("        env:\n          OTHER: x\n", TEST_STEP_RUN) == false;
    // globbing left on: a `*` in the list would widen it
    assert specs_step_ok(TEST_STEP_ENV, "        run: |\n          for spec in $SPECS; do\n") == false;
    // the sha env set, the body reading something else
    assert sha_step_ok(SHA_STEP_ENV, "        run: |\n          REF=master\n") == false;
}

invariant a_body_with_an_input_expansion_is_never_safe {
    assert run_body_safe(INPUT_EXPANSION) == false;
    assert run_body_safe(EVENT_INPUT_EXPANSION) == false;
}
