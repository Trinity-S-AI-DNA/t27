// SPDX-License-Identifier: Apache-2.0
; specs/t27os/credit_view.t27 -- the Y YIELD petal's credit/ledger VIEW law
; Owner directive (petal unblock wave): Y was blocked-by-law because nothing said what a credit
; view may show. This card is that law, built so the view STRUCTURALLY cannot read as a value
; claim:
; - the view shows counts and states only. Its field vocabulary has no minted-value field, no
;   token amount, no lamport amount, no fiat mapping, no price. A field outside the vocabulary is
;   refused by cv_field_ok before it is drawn.
; - history context: specs/depin/prove.t27 (POST /prove, #40, L-TRI-1) carried reward_lamports
;   and tokens_count fields and is superseded by specs/trinet/mint_on_acceptance.t27 ("Do not
;   deploy"). The view law refuses exactly those superseded fields by name, so a yield panel
;   cannot inherit them; minting authority stays where mint_on_acceptance and the tri-net mint
;   specs put it, and the view never restates it.
; - every number the view shows is either a COUNT of ledger rows or a STATE of one row -- both
;   facts about the ledger, never amounts. Totals, sums and aggregates of value are outside this
;   card: a view that wants them needs a different law.
; - truth law: a FIXTURE view is computed over a pinned ledger snapshot (a commit's history) and
;   proves the rendering laws; a LIVE view is computed over the ledger as it stands. A view may
;   claim: real row counts and row states from its named source. It may not claim: value, earnings,
;   worth, or any conversion of counts into amounts.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osCreditView;

use queen::actor_semantics::TRUTH_FIXTURE;
use queen::actor_semantics::TRUTH_LIVE;

; --- 1. The field vocabulary: counts and states only --------------------------------------------------

pub const CF_ENTRIES : u8 = 0;
pub const CF_ACCEPTED : u8 = 1;
pub const CF_SUPERSEDED : u8 = 2;
pub const CF_PENDING : u8 = 3;
pub const CF_ROW_STATE : u8 = 4;
pub const FIELD_KINDS : u8 = 5;
pub const FIELD_NAMES : [5]str = ["entries", "accepted", "superseded", "pending", "row_state"];

/// The one gate a field passes before the view draws it. Counts and states pass; anything else --
/// an amount, a price, a conversion -- has no vocabulary id and cannot reach the screen.
pub fn cv_field_ok(field: u8) -> bool {
    return field < FIELD_KINDS;
}

/// The superseded depin fields, refused BY ID (no vocabulary id exists for them; the ids below
/// are the refusal reasons the view records when a source offers one).
pub const RV_AMOUNT_FIELD : u8 = 0;
pub const RV_FIAT_MAP : u8 = 1;
pub const RV_UNKNOWN_FIELD : u8 = 2;

/// The names the superseded spec carried and this view refuses by name.
pub const REFUSED_FIELD_NAMES : [2]str = ["reward_lamports", "tokens_count"];
pub const SUPERSEDED_BY : str = "specs/trinet/mint_on_acceptance.t27";

pub fn cv_field_refusal(name_len: usize, is_lamports: bool, is_tokens: bool) -> u8 {
    if (is_lamports or is_tokens) { return RV_AMOUNT_FIELD; }
    if (name_len == 0) { return RV_UNKNOWN_FIELD; }
    return RV_FIAT_MAP;
}

; --- 2. Counts and states ------------------------------------------------------------------------------

/// A count field is a number of rows: bounded by the ledger's own row count, never negative.
pub fn cv_count_ok(count: u64, ledger_rows: u64) -> bool {
    return count <= ledger_rows;
}

/// A row state: pending, accepted, superseded. The view colours by this word, not by an amount.
pub const VS_PENDING : u8 = 0;
pub const VS_ACCEPTED : u8 = 1;
pub const VS_SUPERSEDED : u8 = 2;
pub const ROW_STATES : u8 = 3;
pub const ROW_STATE_NAMES : [3]str = ["pending", "accepted", "superseded"];

pub fn cv_row_state_ok(state: u8) -> bool {
    return state < ROW_STATES;
}

/// The count fields must tell the whole ledger without overlap: entries is the total, and
/// accepted + superseded + pending == entries. A view whose counts disagree with its own total
/// is wrong, whatever it draws.
pub fn cv_counts_sum(accepted: u64, superseded: u64, pending: u64, entries: u64) -> bool {
    return accepted + superseded + pending == entries;
}

; --- 3. Truth -----------------------------------------------------------------------------------------

pub fn cv_publishable(truth: u8) -> bool {
    return truth == TRUTH_LIVE;
}

/// A value claim is structurally impossible here: the view has no field that could carry an
/// amount, so the answer is always no, whatever amount is offered.
pub fn cv_value_claim_ok(amount: u64) -> bool {
    return false;
}

test the_vocabulary_is_counts_and_states_only {
    assert FIELD_KINDS == 5;
    assert cv_field_ok(CF_ENTRIES) == true;
    assert cv_field_ok(CF_ROW_STATE) == true;
    assert cv_field_ok(FIELD_KINDS) == false;
    assert cv_field_ok(255) == false;
    assert FIELD_NAMES[0] == "entries" and FIELD_NAMES[3] == "pending";
}

test the_superseded_amount_fields_are_refused_by_name {
    // the two fields the superseded spec carried (prove.t27, "Do not deploy")
    assert REFUSED_FIELD_NAMES[0] == "reward_lamports";
    assert REFUSED_FIELD_NAMES[1] == "tokens_count";
    assert SUPERSEDED_BY == "specs/trinet/mint_on_acceptance.t27";
    // the view records why it refused: an amount field, not a fiat mapping
    assert cv_field_refusal(15, true, false) == RV_AMOUNT_FIELD;
    assert cv_field_refusal(12, false, true) == RV_AMOUNT_FIELD;
    assert cv_field_refusal(9, false, false) == RV_FIAT_MAP;
    assert cv_field_refusal(0, false, false) == RV_UNKNOWN_FIELD;
}

test a_count_is_rows_and_never_exceeds_the_ledger {
    assert cv_count_ok(0, 10) == true;
    assert cv_count_ok(10, 10) == true;
    assert cv_count_ok(11, 10) == false;
}

test the_row_states_are_three_and_named {
    assert ROW_STATES == 3;
    assert cv_row_state_ok(VS_PENDING) == true;
    assert cv_row_state_ok(VS_SUPERSEDED) == true;
    assert cv_row_state_ok(ROW_STATES) == false;
    assert ROW_STATE_NAMES[0] == "pending" and ROW_STATE_NAMES[2] == "superseded";
}

test the_counts_sum_to_the_total {
    assert cv_counts_sum(4, 2, 3, 9) == true;
    assert cv_counts_sum(4, 2, 3, 10) == false;
    assert cv_counts_sum(0, 0, 0, 0) == true;
}

test a_fixture_view_is_never_published {
    assert cv_publishable(TRUTH_FIXTURE) == false;
    assert cv_publishable(TRUTH_LIVE) == true;
}

test no_amount_can_become_a_claim_here {
    // the structural refusal: any amount, of any size, is not claimable by this view
    assert cv_value_claim_ok(0) == false;
    assert cv_value_claim_ok(1) == false;
    assert cv_value_claim_ok(18446744073709551615) == false;
}

invariant the_view_law_has_one_home {
    assert FIELD_KINDS == 5 and ROW_STATES == 3;
    assert REFUSED_FIELD_NAMES.len == 2;
    assert cv_value_claim_ok(27) == false;
}
