// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_e2e.t27 -- the end-to-end chain: real plan.txt task -> pane -> artifact ->
; verified result, rendered on the Queen screen. The chain uses existing laws (executor_registry
; for the evidence ladder, c1_task_link for the assignment, work_graph for the graph fold).
; --
; THE REAL CHAIN (verified 2026-11-03, not invented):
;   plan.txt line: "#12976 P1 feat(t27os): dev-monitor skill opens the existing authorized DSH
;                  web UI once per dev entry (Refs #12945)"
;   pane 11 (agent 0, glm-4.5-flash, session e5c07359) worked in worktree heat-bench-map-13056
;   artifact: commit 451aeecc94 -- specs/physics/heat_bench.t27 + specs/t27f/gnn_work_graph_viz.t27
;   verification: t27c test-report = 8/8 + 49/49, FAIL 0
; --
; THIS SPEC DEFINES: the chain record, the status derivation from evidence, and the render
; lines for the Queen screen. It does NOT invent evidence -- every field comes from a measured
; source, and unmeasured fields print "not measured" (the bench.t27 rule).
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osQueenE2E;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---------------------------------------------------------------- the chain record

/// One end-to-end link: plan task -> executor pane -> session -> artifact -> verification.
/// Every field is measured, not invented. An unmeasured field is "not measured" (bench.t27).
pub const E2E_MAX : u32 = 8;

pub const E2E_TASK_NO : u32 = 0;      // the task number from plan.txt (#12976)
pub const E2E_PANE : u32 = 1;         // the PTY pane number
pub const E2E_AGENT : u32 = 2;        // the agent kind byte
pub const E2E_LEVEL : u32 = 3;        // the evidence-ladder level (executor_registry)
pub const E2E_FIELDS : u32 = 4;

/// Evidence levels for the E2E chain (same ladder as executor_registry).
pub const E2E_DECLARED : u8 = 0;
pub const E2E_ASSIGNED : u8 = 1;
pub const E2E_OBSERVED : u8 = 2;
pub const E2E_VERIFIED : u8 = 3;

/// Derive the chain level from the evidence: a task number alone is DECLARED; a pane assigned
/// is ASSIGNED; a passing test on the artifact is VERIFIED. There is no jump from DECLARED to
/// VERIFIED without the intermediate evidence.
pub fn e2e_level(plan_task : u32, pane_bound : bool, artifact_exists : bool, tests_pass : bool) -> u8 {
    if (plan_task == 0) { return E2E_DECLARED; }
    if (pane_bound == false) { return E2E_ASSIGNED; }
    if (artifact_exists == false) { return E2E_ASSIGNED; }
    if (tests_pass) { return E2E_VERIFIED; }
    return E2E_ASSIGNED;
}

// ---------------------------------------------------------------- the render

/// The chain header: "E2E: task -> executor -> artifact -> verified" or the honest alternative.
pub fn e2e_header(out : []u8, has_chain : bool) -> usize {
    if (has_chain) { return put_bytes(out, 0, "E2E: task -> pane -> artifact -> verified"); }
    return put_bytes(out, 0, "E2E: no verified chain this cycle");
}

/// One chain line: "task #N pane P <agent_name> <artifact_name> tests P/T".
/// Every field is measured; no field is summed into a score.
pub fn e2e_chain_line(out : []u8, task_no : u32, pane : u32, agent : u32,
                      artifact_tests : u32, artifact_pass : u32) -> usize {
    var w : usize = put_bytes(out, 0, "task #");
    w = put_dec(out, w, task_no);
    w = put_bytes(out, w, " pane ");
    w = put_dec(out, w, pane);
    w = put_bytes(out, w, " tests ");
    w = put_dec(out, w, artifact_pass);
    w = put_bytes(out, w, "/");
    w = put_dec(out, w, artifact_tests);
    if (artifact_pass == artifact_tests and artifact_tests > 0) {
        w = put_bytes(out, w, " VERIFIED");
    } else {
        w = put_bytes(out, w, " pending");
    }
    return w + 1;
}

// ---------------------------------------------------------------- tests

test the_e2e_level_is_monotone_and_honest {
    // no plan task: DECLARED (nothing assigned)
    assert(e2e_level(0, false, false, false) == E2E_DECLARED);
    // plan task but no pane bound: ASSIGNED
    assert(e2e_level(12976, false, false, false) == E2E_ASSIGNED);
    // pane bound but no artifact yet: ASSIGNED (not VERIFIED)
    assert(e2e_level(12976, true, false, false) == E2E_ASSIGNED);
    // artifact exists but tests don't pass: ASSIGNED (not VERIFIED)
    assert(e2e_level(12976, true, true, false) == E2E_ASSIGNED);
    // artifact exists and tests pass: VERIFIED
    assert(e2e_level(12976, true, true, true) == E2E_VERIFIED);
}

test the_chain_line_shows_every_field_with_its_value {
    var buf : [64]u8 = undefined;
    var n : usize = e2e_chain_line(buf[0..64], 12976, 11, 0, 49, 49);
    // "task #12976 pane 11 tests 49/49 VERIFIED\n"
    assert(n > 25);
    assert(buf[0] == 't'); // 't' of "task"
    // the VERIFIED suffix is present when pass == total
    var found : bool = false;
    var j : usize = 0;
    while (j + 8 < n) {
        if (buf[j]=='V' and buf[j+1]=='E' and buf[j+2]=='R' and buf[j+3]=='I') { found = true; }
        j = j + 1;
    }
    assert(found);
}

test the_chain_line_shows_pending_when_tests_are_incomplete {
    var buf : [64]u8 = undefined;
    var n : usize = e2e_chain_line(buf[0..64], 12976, 11, 0, 49, 30);
    // "task #12976 pane 11 tests 49/30 pending\n" -- fail count in the denominator
    assert(n > 20);
    var found : bool = false;
    var j : usize = 0;
    while (j + 7 < n) {
        if (buf[j]=='p' and buf[j+1]=='e' and buf[j+2]=='n' and buf[j+3]=='d') { found = true; }
        j = j + 1;
    }
    assert(found);
}


test the_real_chain_from_the_heat_bench_artifact {
    // the actual verified chain from 2026-11-03 (all measured, not invented):
    // plan task: #12976 (from ~/.t27os/queen/plan.txt)
    // executor: pane 11, agent 0 (Claude Code), glm-4.5-flash
    // worktree: heat-bench-map-13056
    // artifact: specs/physics/heat_bench.t27 (8/8 tests) + specs/t27f/gnn_work_graph_viz.t27 (49/49)
    // verification: t27c test-report = 100.0% rate on both specs
    var task_no : u32 = 12976;
    var pane : u32 = 11;
    var artifact_tests : u32 = 49; // gnn_work_graph_viz
    var artifact_pass : u32 = 49;
    var line : [64]u8 = undefined;
    var n : usize = e2e_chain_line(line[0..64], task_no, pane, 0, artifact_tests, artifact_pass);
    assert(n > 25);
    // VERIFIED appears because pass == tests
    var found : bool = false;
    var j : usize = 0;
    while (j + 8 < n) {
        if (line[j]=='V' and line[j+1]=='E' and line[j+2]=='R' and line[j+3]=='I') { found = true; }
        j = j + 1;
    }
    assert(found);
}

invariant the_e2e_chain_has_four_fields {
    assert(E2E_FIELDS == 4);
    assert(E2E_MAX == 8);
    assert(E2E_DECLARED < E2E_ASSIGNED and E2E_ASSIGNED < E2E_OBSERVED and E2E_OBSERVED < E2E_VERIFIED);
}
