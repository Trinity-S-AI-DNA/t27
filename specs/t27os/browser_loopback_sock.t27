// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_loopback_sock.t27 -- AF_INET bind bytes for the 0.3.2 native bridge listener.
; The accept loop is host plumbing (pty_server pattern); every rule it must obey lives in
; browser_native_bridge.t27 (loopback literal, port 47131, no publish). Reuses the sockaddr
; law from router_sock.t27; does not open a second port law.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserLoopbackSock;

use t27os::browser_native_bridge::BRIDGE_HOST;
use t27os::browser_native_bridge::BRIDGE_PORT;
use t27os::browser_native_bridge::bind_refusal;
use t27os::browser_native_bridge::R_OK;
use t27os::router_sock::sockaddr_in_fill;
use t27os::router_sock::SOCKADDR_IN_LEN;

/// The bridge listener binds loopback only, never published off-machine.
pub fn bridge_bind_refusal(publish : bool) -> u32 {
    return bind_refusal(BRIDGE_HOST, publish);
}

/// Sixteen-byte sockaddr_in for sys_bind: 127.0.0.1:BRIDGE_PORT. Zero on refusal.
pub fn bridge_bind_bytes(out : []u8) -> usize {
    if (bridge_bind_refusal(false) != R_OK) { return 0; }
    return sockaddr_in_fill(@intCast(BRIDGE_PORT), BRIDGE_HOST, out);
}

test bind_refusal_matches_bridge_law {
    assert bridge_bind_refusal(false) == R_OK;
    assert bridge_bind_refusal(true) != R_OK;
}

test sockaddr_fills_loopback_and_port_47131 {
    var sa : [16]u8 = undefined;
    const n : usize = bridge_bind_bytes(sa[0..16]);
    assert n == SOCKADDR_IN_LEN;
    assert sa[0] == 16;
    assert sa[4] == 127 and sa[5] == 0 and sa[6] == 0 and sa[7] == 1;
    assert sa[2] == 184 and sa[3] == 27;
}

invariant bridge_sock_stays_on_loopback {
    assert bridge_bind_refusal(false) == R_OK;
    assert BRIDGE_PORT == 47131;
}