// SPDX-License-Identifier: Apache-2.0
; specs/t27os/translator_model.t27 -- the segment lifecycle law of the Live Translator (issue
; #14251, epic #14250). One direction, one law: a speech segment walks OPEN -> PARTIAL ->
; FINAL -> TRANSLATED -> SPOKEN, exactly one event per step, and every event carries a
; sequence number that only grows.
; --
; THE LAW. A segment is born OPEN. A PARTIAL event may replace an earlier PARTIAL while the
; segment is unsealed (a hypothesis sharpens); every other event must advance exactly one
; stage. PARTIAL -> FINAL seals the source text; FINAL -> TRANSLATED stores the translation;
; TRANSLATED -> SPOKEN marks the voice delivered. A skip (OPEN -> FINAL), a repeat
; (TRANSLATED -> TRANSLATED), a backward step and a stale sequence number are each refused
; with their own code, and a refused event changes nothing: the model states why, downstream
; never guesses. After FINAL the source text is sealed -- no later event rewrites it, so a
; stale PARTIAL arriving after FINAL is refused (TLM_SEALED), not folded.
; --
; THE REPLAY SIDE. A recorded session folds through seg_fold: kinds and seqs in parallel
; vectors, the live_tap.t27 replay shape one vector wider; the text of each event rides with
; seg_apply, which the fold calls for every step. The fold stops at the first refused event
; and returns its code, so a replay of a wrong order is refused here, in the model, not
; somewhere downstream. The same log folds to the same segment every time: no clock, no
; transport, no provider -- the caller owns capture, speech, translation and voice; this
; spec is the state machine they must obey.
; --
; Purity: every function here is a pure function of its arguments. No @extern, no transport,
; no UI, no provider calls (issue #14251 scope). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osTranslatorModel;

/// The five lifecycle stages, in the one legal walking order.
pub const SEG_OPEN : u8 = 0;
pub const SEG_PARTIAL : u8 = 1;
pub const SEG_FINAL : u8 = 2;
pub const SEG_TRANSLATED : u8 = 3;
pub const SEG_SPOKEN : u8 = 4;

/// Accept, or refuse with the reason named. Refused means changed nothing.
pub const TLM_OK : u8 = 0;
pub const TLM_BACKWARD : u8 = 1;
pub const TLM_STALE_SEQ : u8 = 2;
pub const TLM_SEALED : u8 = 3;
pub const TLM_BAD_STAGE : u8 = 4;
pub const TLM_RAGGED : u8 = 5;

/// One segment of speech: heard, finalised, translated, spoken.
pub struct Segment {
    id : u64,
    stage : u8,
    seq : u32,
    sealed : bool,
    text : []const u8,
    tr : []const u8,
}

/// A fresh segment sits OPEN with no text and no sequence: nothing has happened yet.
pub fn new_segment(id : u64) -> Segment {
    return Segment { id: id, stage: SEG_OPEN, seq: 0, sealed: false, text: "", tr: "" };
}

/// Whether two texts are byte-equal (slices carry no ==; the model compares honestly).
pub fn tlm_eq(a : []const u8, b : []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// Applies one lifecycle event: TLM_OK and the segment moved, or the refusal code and the
/// segment exactly as it was.
pub fn seg_apply(s : *Segment, stage : u8, seq : u32, text : []const u8) -> u8 {
    if (stage > SEG_SPOKEN) { return TLM_BAD_STAGE; }
    if (s.sealed and stage <= SEG_FINAL) { return TLM_SEALED; }
    if (seq <= s.seq) { return TLM_STALE_SEQ; }
    if (stage == SEG_PARTIAL) {
        s.text = text;
        s.stage = SEG_PARTIAL;
        s.seq = seq;
        return TLM_OK;
    }
    if (stage != s.stage + 1) { return TLM_BACKWARD; }
    if (stage == SEG_FINAL) { s.text = text; s.sealed = true; }
    if (stage == SEG_TRANSLATED) { s.tr = text; }
    s.stage = stage;
    s.seq = seq;
    return TLM_OK;
}

/// Folds a recorded session into the segment: kinds and seqs in parallel vectors, the
/// live_tap.t27 replay shape one vector wider. The first refusal stops the fold and is
/// returned; a ragged log (vectors of different lengths) is refused before any event lands.
pub fn seg_fold(s : *Segment, kinds : []const u8, seqs : []const u32) -> u8 {
    if (kinds.len != seqs.len) { return TLM_RAGGED; }
    var i : usize = 0;
    while (i < kinds.len) {
        const r : u8 = seg_apply(s, kinds[i], seqs[i], "");
        if (r != TLM_OK) { return r; }
        i = i + 1;
    }
    return TLM_OK;
}

invariant the_stages_walk_one_direction
    assert SEG_OPEN < SEG_PARTIAL and SEG_PARTIAL < SEG_FINAL and SEG_FINAL < SEG_TRANSLATED and SEG_TRANSLATED < SEG_SPOKEN

invariant every_refusal_is_named_and_nonzero
    assert TLM_OK == 0 and TLM_BACKWARD > 0 and TLM_STALE_SEQ > 0 and TLM_SEALED > 0 and TLM_BAD_STAGE > 0 and TLM_RAGGED > 0

// ---- tests ----

test the_five_stages_and_their_codes_hold {
    assert_eq(SEG_OPEN, 0);
    assert_eq(SEG_PARTIAL, 1);
    assert_eq(SEG_FINAL, 2);
    assert_eq(SEG_TRANSLATED, 3);
    assert_eq(SEG_SPOKEN, 4);
    assert_eq(TLM_OK, 0);
    assert_eq(TLM_BACKWARD, 1);
    assert_eq(TLM_STALE_SEQ, 2);
    assert_eq(TLM_SEALED, 3);
    assert_eq(TLM_BAD_STAGE, 4);
    assert_eq(TLM_RAGGED, 5);
}

test a_new_segment_sits_open_with_nothing_in_it {
    var s : Segment = new_segment(7);
    assert_eq(s.id, 7);
    assert_eq(s.stage, SEG_OPEN);
    assert_eq(s.seq, 0);
    assert_eq(s.sealed, false);
    assert_eq(tlm_eq(s.text, ""), true);
    assert_eq(tlm_eq(s.tr, ""), true);
}

test one_event_per_step_walks_the_whole_lifecycle {
    var s : Segment = new_segment(1);
    assert_eq(seg_apply(&s, SEG_PARTIAL, 1, "hello"), TLM_OK);
    assert_eq(s.stage, SEG_PARTIAL);
    assert_eq(s.seq, 1);
    assert_eq(s.sealed, false);
    assert_eq(tlm_eq(s.text, "hello"), true);
    assert_eq(seg_apply(&s, SEG_FINAL, 2, "hello there"), TLM_OK);
    assert_eq(s.stage, SEG_FINAL);
    assert_eq(s.sealed, true);
    assert_eq(tlm_eq(s.text, "hello there"), true);
    assert_eq(seg_apply(&s, SEG_TRANSLATED, 3, "privet tam"), TLM_OK);
    assert_eq(s.stage, SEG_TRANSLATED);
    assert_eq(tlm_eq(s.tr, "privet tam"), true);
    assert_eq(seg_apply(&s, SEG_SPOKEN, 4, ""), TLM_OK);
    assert_eq(s.stage, SEG_SPOKEN);
    assert_eq(s.seq, 4);
    // the spoken end is the end: a second spoken is a backward step
    assert_eq(seg_apply(&s, SEG_SPOKEN, 5, ""), TLM_BACKWARD);
    assert_eq(s.stage, SEG_SPOKEN);
    assert_eq(s.seq, 4);
}

test a_partial_sharpens_into_a_partial_while_unsealed {
    var s : Segment = new_segment(2);
    assert_eq(seg_apply(&s, SEG_PARTIAL, 1, "one"), TLM_OK);
    assert_eq(seg_apply(&s, SEG_PARTIAL, 2, "one two"), TLM_OK);
    assert_eq(s.stage, SEG_PARTIAL);
    assert_eq(s.seq, 2);
    assert_eq(tlm_eq(s.text, "one two"), true);
}

test the_sequence_only_grows {
    var s : Segment = new_segment(3);
    assert_eq(seg_apply(&s, SEG_PARTIAL, 5, "five"), TLM_OK);
    // the same or a lower sequence is stale, even for an otherwise legal step
    assert_eq(seg_apply(&s, SEG_PARTIAL, 5, "five"), TLM_STALE_SEQ);
    assert_eq(seg_apply(&s, SEG_FINAL, 4, "four"), TLM_STALE_SEQ);
    assert_eq(s.stage, SEG_PARTIAL);
    assert_eq(s.seq, 5);
    assert_eq(tlm_eq(s.text, "five"), true);
}

test final_seals_the_text_and_refuses_stale_partials {
    var s : Segment = new_segment(4);
    assert_eq(seg_apply(&s, SEG_PARTIAL, 1, "draft"), TLM_OK);
    assert_eq(seg_apply(&s, SEG_FINAL, 2, "final."), TLM_OK);
    // a stale partial after final is refused, and the sealed text is untouched
    assert_eq(seg_apply(&s, SEG_PARTIAL, 9, "late"), TLM_SEALED);
    assert_eq(s.stage, SEG_FINAL);
    assert_eq(s.sealed, true);
    assert_eq(tlm_eq(s.text, "final."), true);
    // a second final is sealed too; the translation still walks forward
    assert_eq(seg_apply(&s, SEG_FINAL, 10, "again"), TLM_SEALED);
    assert_eq(seg_apply(&s, SEG_TRANSLATED, 11, "translation"), TLM_OK);
    assert_eq(tlm_eq(s.text, "final."), true);
    assert_eq(tlm_eq(s.tr, "translation"), true);
}

test a_skip_is_refused_the_walk_is_exactly_one_stage {
    var a : Segment = new_segment(5);
    assert_eq(seg_apply(&a, SEG_FINAL, 1, "quick"), TLM_BACKWARD);
    var b : Segment = new_segment(6);
    assert_eq(seg_apply(&b, SEG_PARTIAL, 1, "p"), TLM_OK);
    assert_eq(seg_apply(&b, SEG_TRANSLATED, 2, "t"), TLM_BACKWARD);
    var c : Segment = new_segment(7);
    assert_eq(seg_apply(&c, SEG_PARTIAL, 1, "p"), TLM_OK);
    assert_eq(seg_apply(&c, SEG_FINAL, 2, "f"), TLM_OK);
    assert_eq(seg_apply(&c, SEG_SPOKEN, 3, ""), TLM_BACKWARD);
    assert_eq(c.stage, SEG_FINAL);
}

test an_unnamed_stage_is_refused {
    var s : Segment = new_segment(8);
    assert_eq(seg_apply(&s, 5, 1, "x"), TLM_BAD_STAGE);
    assert_eq(s.stage, SEG_OPEN);
}

test the_recorded_log_folds_clean_and_deterministic {
    var ks : [5]u8 = [SEG_PARTIAL, SEG_PARTIAL, SEG_FINAL, SEG_TRANSLATED, SEG_SPOKEN];
    var qs : [5]u32 = [1, 2, 3, 4, 5];
    var s : Segment = new_segment(9);
    assert_eq(seg_fold(&s, ks[0..5], qs[0..5]), TLM_OK);
    assert_eq(s.stage, SEG_SPOKEN);
    assert_eq(s.seq, 5);
    assert_eq(s.sealed, true);
    // the same log twice, the same segment state
    var t : Segment = new_segment(9);
    assert_eq(seg_fold(&t, ks[0..5], qs[0..5]), TLM_OK);
    assert_eq(t.stage, s.stage);
    assert_eq(t.seq, s.seq);
    assert_eq(t.sealed, s.sealed);
    assert_eq(tlm_eq(t.text, s.text), true);
    assert_eq(tlm_eq(t.tr, s.tr), true);
    // a ragged log is refused before any event lands
    var r : Segment = new_segment(10);
    var ks2 : [2]u8 = [SEG_PARTIAL, SEG_FINAL];
    var qs2 : [3]u32 = [1, 2, 3];
    assert_eq(seg_fold(&r, ks2[0..2], qs2[0..3]), TLM_RAGGED);
    assert_eq(r.stage, SEG_OPEN);
    assert_eq(r.seq, 0);
}

test negative_control_the_wrong_order_is_refused_and_changes_nothing {
    // the happy log, for the contrast the control needs
    var gks : [4]u8 = [SEG_PARTIAL, SEG_FINAL, SEG_TRANSLATED, SEG_SPOKEN];
    var gqs : [4]u32 = [1, 2, 3, 4];
    var g : Segment = new_segment(11);
    assert_eq(seg_fold(&g, gks[0..4], gqs[0..4]), TLM_OK);
    assert_eq(g.stage, SEG_SPOKEN);
    // control 1: the same events with TRANSLATED before FINAL -- a skip; the fold stops there
    var wks : [4]u8 = [SEG_PARTIAL, SEG_TRANSLATED, SEG_FINAL, SEG_SPOKEN];
    var w : Segment = new_segment(11);
    assert_eq(seg_fold(&w, wks[0..4], gqs[0..4]), TLM_BACKWARD);
    assert_eq(w.stage, SEG_PARTIAL);
    assert_eq(w.seq, 1);
    assert_eq(w.sealed, false);
    // control 2: a stale PARTIAL after FINAL -- refused by the seal, stage untouched
    var sks : [3]u8 = [SEG_PARTIAL, SEG_FINAL, SEG_PARTIAL];
    var sqs : [3]u32 = [1, 2, 9];
    var u : Segment = new_segment(12);
    assert_eq(seg_fold(&u, sks[0..3], sqs[0..3]), TLM_SEALED);
    assert_eq(u.stage, SEG_FINAL);
    assert_eq(u.sealed, true);
    // the refusals mean something: neither wrong log reaches the state the right one does
    assert_eq(w.stage != g.stage, true);
    assert_eq(u.tr.len, 0);
}
