pub fn letter_of_widget(i: u32) -> u8 {
    if (i >= WIDGET_COUNT) {
        return 0;
    }
    return LETTER_OF_WIDGET[i];
}

pub fn widgets_of_letter(letter: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (LETTER_OF_WIDGET[i] == letter) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

; The gallery index of the k-th (0-based) widget of a letter; WIDGET_COUNT when there is none.
pub fn nth_widget_of_letter(letter: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (LETTER_OF_WIDGET[i] == letter) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return WIDGET_COUNT;
}

pub fn label_of_letter(letter: u32) -> []const u8 {
    if (letter < 1 or letter > LETTER_COUNT) {
        return "";
    }
    return INSTRUMENT_LABEL[letter - 1];
}

pub fn letters_without_widgets() -> u32 {
    var n : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (widgets_of_letter(l) == 0) { n = n + 1; }
        l = l + 1;
    }
    return n;
}

; Spot checks: gallery id at an index and the letter that must serve it (10 of the 195).
pub const ANCHOR_IDX : [10]u32 = [0, 10, 12, 19, 65, 94, 101, 117, 126, 153];
pub const ANCHOR_ID : [10]str = ["x7-board", "build-receipt", "gf16-calc", "test-waves", "tri-fpga-claim", "jtag-verdict", "t27c-stages", "t27c-gft-smul", "basics-what-a-spec-is", "golden-split"];
pub const ANCHOR_LETTER : [10]u8 = [11, 2, 14, 6, 10, 22, 3, 14, 26, 14];

test the_per_letter_counts_add_up_to_the_whole_gallery {
    var total : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        total = total + widgets_of_letter(l);
        l = l + 1;
    }
    assert total == 195;
    assert WIDGET_COUNT == 195;
}

test no_widget_is_unassigned_and_every_letter_is_in_range {
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        assert letter_of_widget(i) >= 1;
        assert letter_of_widget(i) <= 27;
        i = i + 1;
    }
}

test every_letter_has_a_label_and_a_no_widgets_row {
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        assert label_of_letter(l) != "";
        l = l + 1;
    }
    assert INSTRUMENT_LABEL[10] == "KERNEL FPGA MAC";
    assert INSTRUMENT_LABEL[26] == "SECURITY RESERVE";
}

test letters_with_zero_widgets_are_exactly_those_with_a_suggestion {
    var l : u32 = 1;
    var empty : u32 = 0;
    while (l <= LETTER_COUNT) {
        if (widgets_of_letter(l) == 0) {
            assert NO_WIDGETS[l - 1] != "";
            empty = empty + 1;
        } else {
            assert NO_WIDGETS[l - 1] == "";
        }
        l = l + 1;
    }
    assert empty == letters_without_widgets();
    assert empty == 13;
}

test nth_widget_round_trips_for_every_letter {
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        var k : u32 = 0;
        while (k < widgets_of_letter(l)) {
            var w : u32 = nth_widget_of_letter(l, k);
            assert w < WIDGET_COUNT;
            assert letter_of_widget(w) == l;
            if (k > 0) { assert w > nth_widget_of_letter(l, k - 1); }
            k = k + 1;
        }
        assert nth_widget_of_letter(l, k) == WIDGET_COUNT;
        l = l + 1;
    }
}

test ten_spot_checks_by_gallery_index {
    var a : u32 = 0;
    while (a < 10) {
        assert letter_of_widget(ANCHOR_IDX[a]) == ANCHOR_LETTER[a];
        a = a + 1;
    }
    assert letter_of_widget(0) == 11;
    assert letter_of_widget(194) == 20;
    assert widgets_of_letter(11) == 64;
    assert widgets_of_letter(14) == 43;
}

test negative_control_out_of_range_has_no_letter_and_no_widget {
    assert letter_of_widget(195) == 0;
    assert letter_of_widget(4000000) == 0;
    assert letter_of_widget(194) != 0;
    assert widgets_of_letter(0) == 0;
    assert widgets_of_letter(28) == 0;
    assert nth_widget_of_letter(1, 0) == WIDGET_COUNT;
    assert nth_widget_of_letter(11, 64) == WIDGET_COUNT;
    assert label_of_letter(0) == "";
    assert label_of_letter(28) == "";
    assert letter_of_widget(10) != 11;
}

