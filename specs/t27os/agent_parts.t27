pub const LETTER_OF_SURFACE : [65]u8 = [
    20, 19, 10, 21, 2, 5, 23, 17, 15, 12, 24, 1, 24, 22, 24, 4,
    25, 7, 25, 25, 26, 26, 26, 2, 2, 2, 2, 2, 2, 27, 24, 26,
    13, 1, 26, 14, 11, 26, 11, 22, 14, 27, 6, 1, 26, 26, 26, 25,
    11, 20, 22, 21, 18, 16, 3, 26, 19, 23, 17, 15, 12, 24, 25, 1,
    24,
];

pub fn letter_of_surface(i: u32) -> u8 {
    if (i >= SURFACE_COUNT) {
        return 0;
    }
    return LETTER_OF_SURFACE[i];
}

pub fn surfaces_of_letter(letter: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SURFACE_COUNT) {
        if (LETTER_OF_SURFACE[i] == letter) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn nth_surface_of_letter(letter: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < SURFACE_COUNT) {
        if (LETTER_OF_SURFACE[i] == letter) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return SURFACE_COUNT;
}

; The parts of a letter: surfaces + widgets. A letter with 0 parts is an honest empty console.
pub fn parts_of_letter(letter: u32) -> u32 {
    return surfaces_of_letter(letter) + widgets_of_letter(letter);
}

; The home (homes.t27 HOME_IDS index) a letter's console lives in.
pub fn home_of_letter(letter: u32) -> u32 {
    return home_of_agent(letter);
}

pub fn letters_without_parts() -> u32 {
    var n : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (parts_of_letter(l) == 0) { n = n + 1; }
        l = l + 1;
    }
    return n;
}

test every_surface_is_assigned_and_the_letter_counts_add_up {
    var total : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        total = total + surfaces_of_letter(l);
        l = l + 1;
    }
    assert total == SURFACE_COUNT;
    var i : u32 = 0;
    while (i < SURFACE_COUNT) {
        assert letter_of_surface(i) >= 1;
        assert letter_of_surface(i) <= 27;
        i = i + 1;
    }
}

test the_21_hud_views_and_10_tri_screens_are_all_present {
    var v : u32 = 0;
    var t : u32 = 0;
    var i : u32 = 0;
    while (i < SURFACE_COUNT) {
        if (SURFACE_KINDS[i] == "hud_view") { v = v + 1; }
        if (SURFACE_KINDS[i] == "hud_tab") { t = t + 1; }
        i = i + 1;
    }
    assert v == 21;
    assert t == 10;
    assert SURFACE_IDS[0] == "comb";
    assert SURFACE_IDS[20] == "widgets";
}

test every_letter_lists_its_parts_and_a_home {
    var l : u32 = 1;
    var seen_widgets : u32 = 0;
    while (l <= LETTER_COUNT) {
        assert label_of_letter(l) != "";
        assert home_of_letter(l) <= 8;
        var k : u32 = 0;
        while (k < surfaces_of_letter(l)) {
            assert letter_of_surface(nth_surface_of_letter(l, k)) == l;
            k = k + 1;
        }
        assert nth_surface_of_letter(l, k) == SURFACE_COUNT;
        seen_widgets = seen_widgets + widgets_of_letter(l);
        l = l + 1;
    }
    assert seen_widgets == 195;
    assert HOME_IDS[0] == "t27a";
}

test surface_spot_checks_and_negative_control {
    assert letter_of_surface(0) == 20;
    assert letter_of_surface(1) == 19;
    assert letter_of_surface(7) == 17;
    assert letter_of_surface(7) != 19;
    assert letter_of_surface(SURFACE_COUNT) == 0;
    assert surfaces_of_letter(0) == 0;
    assert surfaces_of_letter(28) == 0;
    assert nth_surface_of_letter(8, 0) == SURFACE_COUNT;
}

; --- PINNED AGENTS: every widget and surface carries its owner plus up to 3 FEEDERS, the letters whose tool, spec or data produces what it shows ---
; Owner rule 2026-10-20: the work of the system is transparent to a human. Packed: feeder 1 in byte 0, feeder 2 in byte 1, feeder 3 in byte 2, 0 = none.
; Reasons, one line per group of widgets in array order (index range, then why):
; 0..9: K Kernel/FPGA owns pins and JTAG; C emits the bitstream via t27c silicon, V holds the verdict of the run
; 10..10: B Build/Pipeline owns the receipt; C is the build, V checks it
; 11..11: M Metrics owns the curve; K supplies the resource numbers, C the build that measured them
; 12..12: N GoldenFloat owns the calculator; S holds the format spec, C compiles it
; 13..18: K reads the board; C builds the design, V gives the verdict
; 19..19: F owns the test waves; C runs the compile, V the verdict
; 20..24: K owns synthesis readouts; C builds, V verdicts
; 25..25: M owns the figure card; V supplies the figure, S the spec it is read from
; 26..28: K owns LUT and FSM mapping; C maps, L holds the syntax of the FSM
; 29..29: W owns the tri cell; L syntax and S specs are what a cell holds
; 30..30: N owns the format comparison; S has the format spec, V the verdict
; 31..31: K owns the UART; C builds it, V verdicts
; 32..36: K owns the FPGA wire; C emits it, J routes the bench job
; 37..37: K owns pinned bench files; J holds the lock, V verdicts
; 38..38: Ti owns wire keys; K is the wire, X is the binding
; 39..39: F owns the self-test; K is the board under test, V the verdict
; 40..57: K owns FPGA clocking; C emits the constraints, V verdicts
; 58..58: V audits a comparison table; S holds the standard, N the numbers compared
; 59..59: C owns the parser; L syntax and S specs are what it discards
; 60..64: K owns the Ethernet bench; C builds, V verdicts
; 65..67: J owns the bench lock; K is the board, Q the queue
; 68..69: K owns memory and SPI; C builds, F conforms
; 70..75: F owns peripheral checks; C compiles, S the spec, K the peripheral
; 76..81: K owns Verilog for the FPGA; C emits it, F tests it
; 82..88: F owns testbenches; C emits them, K the hardware, S the spec
; 89..91: C owns the HIR; L syntax and S specs are its input
; 92..93: K owns Ethernet on the FPGA; C builds, V verdicts
; 94..94: V owns the verdict; K is the board, C the build
; 95..98: C compiles and runs a spec; L syntax, Z the lesson
; 99..99: F owns the misread; C compiles, L parses
; 100..100: F owns the test touch; W runs it, C compiles
; 101..101: C owns the stages; L is the syntax stage, S the specs
; 102..111: N owns formats; S holds the specs, C compiles
; 112..116: H owns NN; N the number formats, F the tests
; 117..119: N owns GoldenFloat arithmetic; C compiles, F tests
; 120..120: H owns the activation; N the number format
; 121..121: N owns exp2; C compiles, F tests
; 122..125: H owns loss and update; N numbers, F tests
; 126..134: Z lessons: the spec (S) and its syntax (L) are what they open
; 135..136: F owns test blocks; Z lessons, L syntax
; 137..144: Z lessons on functions and modules; L syntax, C compiles
; 145..145: F owns invariants; L syntax, Z lesson
; 146..148: C owns backends and stages; Z lesson, L syntax
; 149..149: W owns tri commands; Z lesson, C the compiler
; 150..152: Z lessons on errors and programs; L syntax, C compiler
; 153..179: N owns golden-*; Z lesson, S format spec
; 180..180: F owns vectors; S specs, L syntax
; 181..181: M owns the census; S specs counted, V verdicts
; 182..183: S owns seals and prose; L syntax, V verdict
; 184..184: F owns proofs; L syntax, S specs
; 185..186: W owns tri commands and gates; F tests, C compiler
; 187..188: T owns the arena and tick; W workflow, Q queue
; 189..189: Ti owns the vault; T the loop skills, V verdict
; 190..192: T owns the agent game; V verdict, G agent configurations compared
; 193..193: Z owns the posts; E experience written up, S specs quoted
; 194..194: T owns the game self-test; F tests, W workflow
pub const FEEDERS_OF_WIDGET : [195]u32 = [
    5635, 5635, 5635, 5635, 5635, 5635, 5635, 5635,
    5635, 5635, 5635, 779, 787, 5635, 5635, 5635,
    5635, 5635, 5635, 5635, 5635, 5635, 5635, 5635,
    5635, 4886, 3075, 3075, 3075, 4876, 5651, 5635,
    2563, 2563, 2563, 2563, 2563, 5642, 6155, 5643,
    5635, 5635, 5635, 5635, 5635, 5635, 5635, 5635,
    5635, 5635, 5635, 5635, 5635, 5635, 5635, 5635,
    5635, 5635, 3603, 4876, 5635, 5635, 5635, 5635,
    5635, 4363, 4363, 4363, 1539, 1539, 725763, 725763,
    725763, 725763, 725763, 725763, 1539, 1539, 1539, 1539,
    1539, 1539, 1248003, 1248003, 1248003, 1248003, 1248003, 1248003,
    1248003, 4876, 4876, 4876, 5635, 5635, 779, 6668,
    6668, 6668, 6668, 3075, 791, 4876, 787, 787,
    787, 787, 787, 787, 787, 787, 787, 787,
    1550, 1550, 1550, 1550, 1550, 1539, 1539, 1539,
    14, 1539, 1550, 1550, 1550, 1550, 3091, 3091,
    3091, 3091, 3091, 3091, 3091, 3091, 3091, 3098,
    3098, 780, 780, 780, 780, 780, 780, 780,
    780, 6668, 3098, 3098, 3098, 794, 780, 780,
    780, 4890, 4890, 4890, 4890, 4890, 4890, 4890,
    4890, 4890, 4890, 4890, 4890, 4890, 4890, 4890,
    4890, 4890, 4890, 4890, 4890, 4890, 4890, 4890,
    4890, 4890, 4890, 4890, 3091, 5651, 5644, 5644,
    4876, 774, 774, 4375, 4375, 5652, 1814, 1814,
    1814, 4869, 5894,
];

; Surfaces by SURFACE_IDS index: a view takes the feeders of the data it draws; the AI pipeline tabs (stages) are fed by X bindings and Z docs, a page by the spec or verdict it shows.
pub const FEEDERS_OF_SURFACE : [65]u32 = [
    1446154, 780, 4372, 3347, 1708803, 3350, 5139, 2580,
    5139, 787, 5891, 1299, 791, 2819, 6932, 4867,
    1814, 5652, 3355, 4376, 1245954, 3352, 5144, 6668,
    6680, 6680, 6680, 6680, 1704716, 5656, 3348, 4884,
    1311254, 5395, 791, 5651, 790, 4876, 6659, 3595,
    787, 275, 3094, 5139, 5, 4869, 6163, 5652,
    6659, 5909, 6915, 5138, 5379, 5390, 4876, 6164,
    3075, 5139, 2580, 5139, 787, 5891, 5656, 4890,
    5145,
];

pub fn agents_of_widget(i: u32, k: u32) -> u8 {
    if (i >= WIDGET_COUNT) {
        return 0;
    }
    if (k == 0) {
        return LETTER_OF_WIDGET[i];
    }
    if (k > 3) {
        return 0;
    }
    return ((FEEDERS_OF_WIDGET[i] >> ((k - 1) * 8)) & 255) as u8;
}

pub fn agents_of_surface(i: u32, k: u32) -> u8 {
    if (i >= SURFACE_COUNT) {
        return 0;
    }
    if (k == 0) {
        return LETTER_OF_SURFACE[i];
    }
    if (k > 3) {
        return 0;
    }
    return ((FEEDERS_OF_SURFACE[i] >> ((k - 1) * 8)) & 255) as u8;
}

; How many widgets (surfaces) letter is pinned to as owner (k == 0) or as a feeder (k 1..3).
pub fn pinned_widgets(letter: u32, feeder: bool) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        var k : u32 = 0;
        if (feeder) { k = 1; }
        while (k < 4) {
            if (agents_of_widget(i, k) == letter) { n = n + 1; }
            if (feeder == false) { k = 4; } else { k = k + 1; }
        }
        i = i + 1;
    }
    return n;
}

pub fn pinned_surfaces(letter: u32, feeder: bool) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SURFACE_COUNT) {
        var k : u32 = 0;
        if (feeder) { k = 1; }
        while (k < 4) {
            if (agents_of_surface(i, k) == letter) { n = n + 1; }
            if (feeder == false) { k = 4; } else { k = k + 1; }
        }
        i = i + 1;
    }
    return n;
}

; A letter that is pinned to nothing at all.
pub fn letters_never_pinned() -> u32 {
    var n : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (pinned_widgets(l, false) + pinned_widgets(l, true) + pinned_surfaces(l, false) + pinned_surfaces(l, true) == 0) { n = n + 1; }
        l = l + 1;
    }
    return n;
}

test every_widget_and_surface_has_an_owner_pinned {
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        assert agents_of_widget(i, 0) != 0;
        assert agents_of_widget(i, 0) == letter_of_widget(i);
        i = i + 1;
    }
    var s : u32 = 0;
    while (s < SURFACE_COUNT) {
        assert agents_of_surface(s, 0) != 0;
        s = s + 1;
    }
}

test no_feeder_equals_the_owner_or_repeats_and_zeros_are_trailing {
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        var a : u8 = agents_of_widget(i, 1);
        var b : u8 = agents_of_widget(i, 2);
        var c : u8 = agents_of_widget(i, 3);
        assert a != 0;
        assert a != agents_of_widget(i, 0);
        if (b != 0) { assert b != a; assert b != agents_of_widget(i, 0); }
        if (c != 0) { assert b != 0; assert c != a; assert c != b; assert c != agents_of_widget(i, 0); }
        assert a <= 27;
        assert b <= 27;
        assert c <= 27;
        i = i + 1;
    }
    var s : u32 = 0;
    while (s < SURFACE_COUNT) {
        var a : u8 = agents_of_surface(s, 1);
        var b : u8 = agents_of_surface(s, 2);
        var c : u8 = agents_of_surface(s, 3);
        assert a != 0;
        assert a != agents_of_surface(s, 0);
        if (b != 0) { assert b != a; assert b != agents_of_surface(s, 0); }
        if (c != 0) { assert b != 0; assert c != a; assert c != b; assert c != agents_of_surface(s, 0); }
        assert a <= 27;
        assert b <= 27;
        assert c <= 27;
        s = s + 1;
    }
}

test negative_control_past_the_end_is_nobody {
    assert agents_of_widget(195, 0) == 0;
    assert agents_of_widget(0, 4) == 0;
    assert agents_of_widget(0, 0) == 11;
    assert agents_of_widget(0, 1) == 3;
    assert agents_of_widget(0, 2) == 22;
    assert agents_of_widget(0, 3) == 0;
    assert agents_of_surface(65, 0) == 0;
    assert agents_of_surface(0, 0) == 20;
    assert agents_of_surface(0, 3) == 22;
    assert agents_of_surface(0, 4) == 0;
}

