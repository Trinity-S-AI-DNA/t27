module T27osTranslatorPetal;

; Closes #14257.

use t27os::translator_model::SEG_PARTIAL;
use t27os::translator_model::SEG_FINAL;
use t27os::translator_model::SEG_TRANSLATED;
use t27os::translator_model::SEG_SPOKEN;
use t27os::hot_reload::LIVE_OK;
use t27os::hot_reload::live_should_apply;

/// Draw decisions for the live-translator subtitle screen under an existing
/// petal (the count stays 27, #13299). Pure decisions only: which ink a stage
/// gets, whether a revision-feed update is accepted, and the trace every
/// shown character carries. No window, no AppKit, no layout (that side is
/// specs/t27os/glass_window.t27; content reaches it only through the
/// specs/t27os/live_data.t27 revision contract).

/// Ink decisions: partial is dim, final and translated are full, spoken adds
/// its mark. 0 means "draw nothing" (an unknown stage).
pub const INK_NONE    : u8 = 0;
pub const INK_DIM     : u8 = 1;
pub const INK_FULL    : u8 = 2;
pub const INK_MARKED  : u8 = 3;

/// Revision-feed refusal codes
pub const PF_OK         : u8 = 0;
pub const PF_STALE      : u8 = 1;
pub const PF_TRUNCATED  : u8 = 2;

/// The petal count is fixed by specs/t27os/petal_menu.t27 (petal_count_is_27);
/// this spec only refuses a slot outside it.
pub const PETAL_MAX : u32 = 27;

/// The trace every shown character carries: segment id plus revision.
pub struct Shown {
    seg_id : u64,
    rev : u32,
}

/// Ink decision for one segment stage: dim while partial, full once final or
/// translated, marked once spoken, nothing for anything else.
pub fn ink_for_stage(stage : u8) -> u8 {
    if (stage == SEG_PARTIAL) { return INK_DIM; }
    if (stage == SEG_FINAL) { return INK_FULL; }
    if (stage == SEG_TRANSLATED) { return INK_FULL; }
    if (stage == SEG_SPOKEN) { return INK_MARKED; }
    return INK_NONE;
}

/// Revision-feed gate, aligned with specs/t27os/hot_reload.t27: a truncated
/// payload is refused whole (a cut-short download loses the end marker); the
/// apply decision itself is the home rule live_should_apply -- rev >= applied,
/// so an equal revision is applied again and a strictly older one is refused.
pub fn feed_accept(prev_rev : u32, new_rev : u32, got : u32, declared : u32) -> u8 {
    if (got != declared) { return PF_TRUNCATED; }
    if (!live_should_apply(LIVE_OK, new_rev as u64, prev_rev as u64)) { return PF_STALE; }
    return PF_OK;
}

/// Geometry gate: a petal slot outside the fixed menu is refused.
pub fn petal_slot_ok(i : u32) -> bool {
    return i < PETAL_MAX;
}

/// The trace a shown character carries.
pub fn shown_new(seg_id : u64, rev : u32) -> Shown {
    var s : Shown = Shown { seg_id : seg_id, rev : rev };
    return s;
}

invariant ink_decisions_are_distinct_and_ordered
    assert INK_NONE < INK_DIM and INK_DIM < INK_FULL and INK_FULL < INK_MARKED

invariant refusals_are_named_and_nonzero
    assert PF_OK == 0 and PF_STALE > 0 and PF_TRUNCATED > 0

test partial_is_dim_and_final_is_full {
    assert ink_for_stage(SEG_PARTIAL) == INK_DIM;
    assert ink_for_stage(SEG_FINAL) == INK_FULL;
}

test translated_is_full_and_spoken_is_marked {
    assert ink_for_stage(SEG_TRANSLATED) == INK_FULL;
    assert ink_for_stage(SEG_SPOKEN) == INK_MARKED;
}

test an_unknown_stage_draws_nothing {
    assert ink_for_stage(200) == INK_NONE;
}

test an_equal_revision_is_applied_again_and_an_older_one_is_refused {
    // hot_reload live_should_apply: rev >= applied -- an equal revision is
    // applied again (the result is the same), a strictly older one is refused.
    assert feed_accept(5, 5, 10, 10) == PF_OK;
    assert feed_accept(6, 5, 10, 10) == PF_STALE;
}

test a_truncated_feed_is_refused_whole {
    assert feed_accept(5, 6, 9, 10) == PF_TRUNCATED;
}

test a_fresh_complete_feed_is_accepted {
    assert feed_accept(5, 6, 10, 10) == PF_OK;
}

test a_slot_beyond_the_menu_is_refused {
    assert petal_slot_ok(0) == true;
    assert petal_slot_ok(26) == true;
    assert petal_slot_ok(27) == false;
}

test every_shown_character_carries_seg_id_and_rev {
    var s : Shown = shown_new(42, 7);
    assert s.seg_id == 42 and s.rev == 7;
}

test negative_control_refuses_a_machine_that_renders_partial_as_full {
    assert ink_for_stage(SEG_PARTIAL) != ink_for_stage(SEG_FINAL);
    assert ink_for_stage(SEG_PARTIAL) == INK_DIM;
}
