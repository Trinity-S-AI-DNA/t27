// SPDX-License-Identifier: Apache-2.0
// specs/t27os/idle_panel.t27 -- T27 OS: the idle panel burns CPU redrawing
// continuously (measured 34-78%).
// Part of M1 (milestone #5). Closes #12410.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::idle_panel;

pub const IDLE_CPU_MAX_PCT : u32 = 5;

pub struct IdlePanel { redraws_per_sec: u32, cpu_pct: u32 };

pub fn idle_panel_cpu_ok(p: IdlePanel) -> bool {
    return p.cpu_pct <= IDLE_CPU_MAX_PCT;
}

test "idle panel cpu ok" {
    assert(idle_panel_cpu_ok(IdlePanel { redraws_per_sec: 1, cpu_pct: 3 }));
    assert(!idle_panel_cpu_ok(IdlePanel { redraws_per_sec: 60, cpu_pct: 50 }));
}

invariant idle_cpu_max_percent {
    assert IDLE_CPU_MAX_PCT == 5;
}