// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_scope_gate.t27 -- DSH scope gate: a pure decision spec for
// where a DSH thread may write and what it must declare.
// Part of M8 milestone (milestone #12). Closes #13018.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_scope_gate;

pub const DSH_SCOPE_GATE_MAX_WRITE_PATHS : u32 = 4;

pub struct ScopeGateDecision { write_path: str, declared: bool };

pub fn scope_gate_decision_allows(d: ScopeGateDecision) -> bool {
    return d.declared;
}

test "scope_gate_decision_allows" {
    assert(scope_gate_decision_allows(ScopeGateDecision { write_path: "specs/t27os/", declared: true }));
    assert(!scope_gate_decision_allows(ScopeGateDecision { write_path: "specs/t27os/", declared: false }));
}

invariant dsh_scope_gate_max_write_paths_positive {
    assert DSH_SCOPE_GATE_MAX_WRITE_PATHS > 0;
}