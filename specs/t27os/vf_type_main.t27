// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_type_main.t27 -- host program: a specimen frame of the Outfit text renderer (Refs gHashTag/t27#13214,
; T27F-007). It paints a 640 x 400 black raster with Outfit 800 and 400 at several sizes in the t27.ai colours (white 0xFFFFFF,
; accent 0x00FF88, muted 0x888888) through vf_type, and writes it as a binary PPM P6 (15 header bytes, then 640 * 400 * 3 RGB
; bytes) to FRAME_OUT.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. The tests below pin bytes of the PPM (a header, a blank corner, ink where text was
; asked for); they do not say the type looks right. "The type is not pixelated" starts only when somebody has opened the frame.
; --
; BUILD AND RUN (a heavy build: on the lab or in a T27 OS pane, not on the Mac without the owner's word):
;   t27c gen specs/t27os/vf_type_main.t27 > vf_type.zig
;   zig build-exe vf_type.zig -lc
;   FRAME_OUT=target/vf_type.ppm ./vf_type
;   ffmpeg -y -i target/vf_type.ppm target/vf_type.png
; FRAME_OUT defaults to target/vf_type.ppm, a path under the working directory (target/ is gitignored), never /tmp. An
; unopenable FRAME_OUT or a short write exits 2; a text refusal exits 1.
; --
; Module-level vars are never spliced by `use`, so the two byte buffers live here and are passed to vf_type as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfTypeMain;

use t27f::vf_type::vt_draw_text;
use t27f::vf_type::VT_OK;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;

pub const VTM_W : u32 = 640;
pub const VTM_H : u32 = 400;

pub var VTM_RGB : [768000]u8 = [0] ** 768000;
pub var VTM_PPM : [768015]u8 = [0] ** 768015;

/// Paint the specimen into VTM_RGB: the sum of the refusal codes of the draw calls (0 is all ok).
pub fn vtm_paint() -> u32 {
    var bad : u32 = 0;
    var at : usize = 0;
    while at < VTM_RGB.len {
        VTM_RGB[at] = 0;
        at = at + 1;
    }
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 72, "Outfit 800", 64, 800, 65416);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 112, "Spec first. Ternary. Verified.", 32, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 152, "Spec first. Ternary. Verified.", 32, 800, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 184, "The quick brown fox jumps over the lazy dog 0123456789", 20, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 210, "The quick brown fox jumps over the lazy dog 0123456789", 20, 800, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 240, "phi^2 + 1/phi^2 = 3  |  GoldenFloat  |  TRINITY", 16, 400, 8947848);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 266, "14 px: Spec first. Ternary. Verified.", 14, 400, 8947848);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 290, "6 px: Spec first. Ternary. Verified.", 6, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 308, "8 px: Spec first. Ternary. Verified.", 8, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 326, "10 px: Spec first. Ternary. Verified.", 10, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 346, "12 px: Spec first. Ternary. Verified.", 12, 400, 16777215);
    bad = bad + vt_draw_text(&VTM_RGB, VTM_W, VTM_H, 24 * 256, 380, "18 px bold: Spec first. Ternary. Verified.", 18, 800, 65416);
    return bad;
}

pub fn main() void {
    const bad : u32 = vtm_paint();
    if (bad != 0) {
        std.debug.print("vf_type: text refused, code sum {d}\n", .{bad});
        std.c.exit(1);
    }
    const put : u8 = ppm_write_into(&VTM_PPM, &VTM_RGB, VTM_W, VTM_H);
    const nbytes : usize = ppm_len(VTM_W, VTM_H) as usize;
    var path : [*:0]const u8 = "target/vf_type.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("vf_type: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&VTM_PPM), 1, nbytes, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != nbytes or put != 0) {
        std.debug.print("vf_type: short write to {s}: {d} of {d} bytes\n", .{ path, w, nbytes });
        std.c.exit(2);
    }
    std.debug.print("vf_type: wrote {d} bytes to {s} ({d}x{d}, P6)\n", .{ nbytes, path, VTM_W, VTM_H });
    std.debug.print("vf_type: a byte-level frame; open it and look before saying the type is smooth\n", .{});
}

test the_specimen_paints_without_a_refusal {
    assert vtm_paint() == VT_OK;
}

test the_frame_is_15_header_bytes_plus_768000_rgb_bytes {
    assert vtm_paint() == VT_OK;
    assert ppm_write_into(&VTM_PPM, &VTM_RGB, VTM_W, VTM_H) == 0;
    const want : []const u8 = "P6\n640 400\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert VTM_PPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(640, 400) == 768015;
}

test the_corner_is_blank_and_the_title_has_accent_green {
    assert vtm_paint() == VT_OK;
    // pixel (639, 399), the bottom-right corner, is black
    assert VTM_RGB[767997] == 0;
    assert VTM_RGB[767998] == 0;
    assert VTM_RGB[767999] == 0;
    // somewhere in the 64 px title (rows 20..72) the green channel reaches 255 and the red channel stays 0
    var best_g : u32 = 0;
    var worst_r : u32 = 0;
    var y : u32 = 20;
    while y < 73 {
        var x : u32 = 24;
        while x < 400 {
            const at : usize = ((y * VTM_W + x) * 3) as usize;
            if (VTM_RGB[at + 1] as u32) > best_g { best_g = VTM_RGB[at + 1] as u32; }
            if (VTM_RGB[at] as u32) > worst_r { worst_r = VTM_RGB[at] as u32; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert best_g == 255;
    assert worst_r == 0;
}
