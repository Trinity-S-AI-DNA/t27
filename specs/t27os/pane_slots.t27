; specs/t27os/pane_slots.t27 -- why each pane slot is held, and which one may be OFFERED to the owner as free
; (owner, 2026-11-04: "16 of 16 panes ... do not restart the shared server and do not close the user's panels
; automatically ... show the owner one concrete candidate pane to free").
; --
; The registry row is what the pane server's LIST already says (pane, agent, state byte) read against what the
; host sees (a process under the server or not). The state byte is the state in bits 0 to 5 and the traffic
; light in bits 6 and 7 (pty_logic.t27 shown_with_light): 131 = idle with light 2, 128 = stopped with light 2.
; The reasons a slot is held, in the registry's words:
;   PROCESS_GONE  state 0: the pane's process has exited and the slot is only a row. Nothing runs there.
;   LIVE_SESSION  an agent session (a Claude Code, OpenCode, ...) is attached, idle, working or blocked.
;   WORKING       state 1 or 2: the pane is doing something or waits on someone. Never offered.
;   IDLE_CELL     a shell or editor cell that is idle: it runs a login shell and no task.
;   DONE          state 4: the pane finished.
; Only PROCESS_GONE, DONE and IDLE_CELL may be offered as a candidate, in that order of regret. A live agent
; session is somebody's conversation and is never offered. NOTHING here closes a pane: ps_may_close is the
; owner's word and nothing else, so a loop that finds the table full asks and never frees by itself.
; WHAT IS NOT HERE: the process table and the session ids (the host reads them), and the close itself (the
; pane server's kill verb, run by the owner).
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osPaneSlots;

use t27os::agents::AGENT_COUNT;
use t27os::session_store::put_bytes;

pub const PS_STOPPED : u32 = 0;
pub const PS_WORKING : u32 = 1;
pub const PS_BLOCKED : u32 = 2;
pub const PS_IDLE : u32 = 3;
pub const PS_DONE : u32 = 4;

pub const WHY_PROCESS_GONE : u32 = 1;
pub const WHY_LIVE_SESSION : u32 = 2;
pub const WHY_WORKING : u32 = 3;
pub const WHY_IDLE_CELL : u32 = 4;
pub const WHY_DONE : u32 = 5;

/// The number returned when no pane may be offered.
pub const PS_NO_PANE : usize = 255;

/// The state in bits 0 to 5 of a LIST state byte.
pub fn ps_state(shown : u32) -> u32 {
    return shown % 64;
}

/// The traffic light in bits 6 and 7 of a LIST state byte.
pub fn ps_light(shown : u32) -> u32 {
    return shown / 64;
}

/// A shell or editor cell: its agent number is past the agent table.
pub fn ps_is_cell(agent : u32) -> bool {
    return agent >= AGENT_COUNT;
}

/// Why this slot is held.
pub fn ps_why(agent : u32, shown : u32) -> u32 {
    const s : u32 = ps_state(shown);
    if (s == PS_STOPPED) { return WHY_PROCESS_GONE; }
    if (s == PS_DONE) { return WHY_DONE; }
    if (s == PS_WORKING or s == PS_BLOCKED) { return WHY_WORKING; }
    if (ps_is_cell(agent)) { return WHY_IDLE_CELL; }
    return WHY_LIVE_SESSION;
}

/// The reason in words, for the registry row.
pub fn ps_why_text(out : []u8, why : u32) -> usize {
    if (why == WHY_PROCESS_GONE) { return put_bytes(out, 0, "process gone, the slot is only a row"); }
    if (why == WHY_LIVE_SESSION) { return put_bytes(out, 0, "an agent session is attached"); }
    if (why == WHY_WORKING) { return put_bytes(out, 0, "working or waiting"); }
    if (why == WHY_IDLE_CELL) { return put_bytes(out, 0, "idle shell cell, no task"); }
    if (why == WHY_DONE) { return put_bytes(out, 0, "finished"); }
    return put_bytes(out, 0, "unknown");
}

/// May this slot be shown to the owner as a candidate to free? A live session and a working pane never.
pub fn ps_may_offer(why : u32) -> bool {
    return why == WHY_PROCESS_GONE or why == WHY_DONE or why == WHY_IDLE_CELL;
}

/// The regret of freeing a slot: 0 nothing lost, 1 a finished pane's screen, 2 an idle cell's shell. Others: 9.
pub fn ps_regret(why : u32) -> u32 {
    if (why == WHY_PROCESS_GONE) { return 0; }
    if (why == WHY_DONE) { return 1; }
    if (why == WHY_IDLE_CELL) { return 2; }
    return 9;
}

/// The one pane to offer the owner among the n panes (shown[i], agent[i]): the lowest regret, the highest
/// pane number on a tie (the newest). PS_NO_PANE when every slot is a live session or working.
pub fn ps_pick(shown : []const u8, agent : []const u8, n : usize) -> usize {
    var best : usize = PS_NO_PANE;
    var at : u32 = 9;
    var i : usize = 0;
    while (i < n) {
        const why : u32 = ps_why(@as(u32, agent[i]), @as(u32, shown[i]));
        const rg : u32 = ps_regret(why);
        if (ps_may_offer(why) and rg <= at) {
            best = i;
            at = rg;
        }
        i = i + 1;
    }
    return best;
}

/// How many slots hold nothing (process gone).
pub fn ps_stale_count(shown : []const u8, n : usize) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i < n) {
        if (ps_state(@as(u32, shown[i])) == PS_STOPPED) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// Closing a pane is the owner's word and nothing else: no loop, bee or session frees a slot by itself.
pub fn ps_may_close(owner_said : bool) -> bool {
    return owner_said;
}

// ---------------------------------------------------------------- tests

test the_state_and_the_light_share_one_byte {
    assert ps_state(131) == PS_IDLE and ps_light(131) == 2;
    assert ps_state(67) == PS_IDLE and ps_light(67) == 1;
    assert ps_state(128) == PS_STOPPED and ps_light(128) == 2;
    assert ps_state(3) == PS_IDLE and ps_light(3) == 0;
}

test a_slot_says_why_it_is_held {
    assert ps_why(0, 128) == WHY_PROCESS_GONE;
    assert ps_why(0, 131) == WHY_LIVE_SESSION;
    assert ps_why(3, 131) == WHY_LIVE_SESSION;
    assert ps_why(9, 3) == WHY_IDLE_CELL;
    assert ps_why(0, 1) == WHY_WORKING and ps_why(9, 2) == WHY_WORKING;
    assert ps_why(0, 4) == WHY_DONE;
}

test only_nothing_lost_slots_are_offered {
    assert ps_may_offer(WHY_PROCESS_GONE) and ps_may_offer(WHY_DONE) and ps_may_offer(WHY_IDLE_CELL);
    assert ps_may_offer(WHY_LIVE_SESSION) == false;
    assert ps_may_offer(WHY_WORKING) == false;
    assert ps_regret(WHY_PROCESS_GONE) < ps_regret(WHY_DONE) and ps_regret(WHY_DONE) < ps_regret(WHY_IDLE_CELL);
}

test the_bench_table_of_2026_11_04_offers_pane_9 {
    // `T27OS_CTL=list` at 02:05 local: 10 Claude Code panes (0 1 2 3 5 7 9 11 13 14), OpenCode at 6,
    // idle shell cells at 4 8 10 12 15. Pane 9 has no process under the server (9 claude children for 10 panes).
    var shown : [16]u8 = undefined;
    var agent : [16]u8 = undefined;
    shown[0] = 131; shown[1] = 67; shown[2] = 67; shown[3] = 131; shown[4] = 3; shown[5] = 131; shown[6] = 131; shown[7] = 131;
    shown[8] = 3; shown[9] = 128; shown[10] = 3; shown[11] = 131; shown[12] = 3; shown[13] = 131; shown[14] = 131; shown[15] = 3;
    agent[0] = 0; agent[1] = 0; agent[2] = 0; agent[3] = 0; agent[4] = 9; agent[5] = 0; agent[6] = 3; agent[7] = 0;
    agent[8] = 9; agent[9] = 0; agent[10] = 9; agent[11] = 0; agent[12] = 9; agent[13] = 0; agent[14] = 0; agent[15] = 9;
    assert ps_pick(shown[0..16], agent[0..16], 16) == 9;
    assert ps_stale_count(shown[0..16], 16) == 1;
}

test with_no_stale_slot_the_newest_idle_cell_is_offered_and_never_a_session {
    var shown : [6]u8 = undefined;
    var agent : [6]u8 = undefined;
    shown[0] = 131; shown[1] = 3; shown[2] = 131; shown[3] = 3; shown[4] = 1; shown[5] = 131;
    agent[0] = 0; agent[1] = 9; agent[2] = 0; agent[3] = 9; agent[4] = 9; agent[5] = 3;
    assert ps_pick(shown[0..6], agent[0..6], 6) == 3;
    shown[1] = 131; shown[3] = 131; agent[1] = 0; agent[3] = 0;
    assert ps_pick(shown[0..6], agent[0..6], 6) == PS_NO_PANE;
    assert ps_stale_count(shown[0..6], 6) == 0;
}

test a_finished_pane_is_offered_before_an_idle_cell {
    var shown : [3]u8 = undefined;
    var agent : [3]u8 = undefined;
    shown[0] = 3; shown[1] = 4; shown[2] = 131;
    agent[0] = 9; agent[1] = 0; agent[2] = 0;
    assert ps_pick(shown[0..3], agent[0..3], 3) == 1;
}

test closing_is_the_owners_word_alone {
    assert ps_may_close(false) == false;
    assert ps_may_close(true);
}

test the_reason_texts_have_their_length {
    var b : [48]u8 = undefined;
    assert ps_why_text(b[0..48], WHY_PROCESS_GONE) == 36;
    assert ps_why_text(b[0..48], WHY_LIVE_SESSION) == 28;
    assert ps_why_text(b[0..48], WHY_WORKING) == 18;
    assert ps_why_text(b[0..48], WHY_IDLE_CELL) == 24;
    assert ps_why_text(b[0..48], WHY_DONE) == 8;
    assert ps_why_text(b[0..48], 0) == 7;
}
