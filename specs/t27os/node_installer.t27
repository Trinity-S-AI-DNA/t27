// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_installer.t27 -- the installer's CONSENT gate (owner brief
// 2026-10-27): the anti-scanner law of the node market's installer. The installer
// MAY NOT complete unless the owner declared the machine's inventory, every
// contributed key carries an owner-set cap, and an uninstall/revoke path exists.
// A build that skips any of the three consents is not the market's installer.
// This file decides nothing about HOW the UI asks; it decides WHAT must be true
// before the install is lawful. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeInstaller;

pub const I_OK : u8 = 0;
pub const I_REFUSE_NO_INVENTORY : u8 = 1;
pub const I_REFUSE_UNCAPPED_KEY : u8 = 2;
pub const I_REFUSE_NO_REVOKE : u8 = 3;

/// The one consent gate. Inventory declaration is FIRST in decision order: an
/// undeclared machine cannot be enrolled, whatever else is true. Zero keys is a
/// valid compute-only install (all_capped is vacuous then). The revoke path is
/// LAST: a node the owner cannot leave is a node that must not join.
pub fn install_consent_ok(inventory_declared : bool, keys : usize, all_capped : bool, revoke_path : bool) -> u8 {
    if (inventory_declared == false) { return I_REFUSE_NO_INVENTORY; }
    if (keys > 0 and all_capped == false) { return I_REFUSE_UNCAPPED_KEY; }
    if (revoke_path == false) { return I_REFUSE_NO_REVOKE; }
    return I_OK;
}

test installer_consts_hold {
    var a : u8 = I_OK;
    var b : u8 = I_REFUSE_NO_INVENTORY;
    var c : u8 = I_REFUSE_UNCAPPED_KEY;
    var d : u8 = I_REFUSE_NO_REVOKE;
    assert a == 0;
    assert b == 1;
    assert c == 2;
    assert d == 3;
}

test a_lawful_install_passes_all_three_consents {
    assert install_consent_ok(true, 2, true, true) == I_OK;
    assert install_consent_ok(true, 0, false, true) == I_OK;
    assert install_consent_ok(true, 0, true, true) == I_OK;
}

test every_missing_consent_refuses_in_order {
    assert install_consent_ok(false, 0, true, true) == I_REFUSE_NO_INVENTORY;
    assert install_consent_ok(false, 5, false, false) == I_REFUSE_NO_INVENTORY;
    assert install_consent_ok(true, 2, false, true) == I_REFUSE_UNCAPPED_KEY;
    assert install_consent_ok(true, 1, false, false) == I_REFUSE_UNCAPPED_KEY;
    assert install_consent_ok(true, 0, true, false) == I_REFUSE_NO_REVOKE;
    assert install_consent_ok(true, 3, true, false) == I_REFUSE_NO_REVOKE;
}

test zero_keys_is_a_compute_only_install {
    assert install_consent_ok(true, 0, true, true) == I_OK;
    assert install_consent_ok(true, 0, true, false) == I_REFUSE_NO_REVOKE;
}
