// SPDX-License-Identifier: Apache-2.0
// specs/t27os/ladder_speed.t27 -- three acceleration variants for the ladder
// serve path, ranked by the Pareto rule (owner brief 2026-10-27: 80/20 -- land
// the smallest effort with the biggest win first). Each variant is a pure
// decision function plus its impact/effort row; no variant weakens the
// fail-closed or loopback laws of ladder.t27. ASCII only (L3). TRINITY

module T27OsLadderSpeed;

use t27os::ladder::{RUNG_COUNT, refusal};

const RC : u32 = RUNG_COUNT;

// -- V1: the 5.3 head -------------------------------------------------------
// Effort: one constant (the head model id the glue asks for). Impact: the
// measured breakthrough itself -- glm-5.3-flash thinking-off answered in
// 11.7 s with real content where the thinking-on head drained 45 s into an
// empty answer (2026-10-27): about 4x on every head-rung turn, no new
// machinery, ladder.t27 law 6 already demands thinking off.
pub const V1_HEAD_MODEL : str = "glm-5.3-flash";
pub const V1_OLD_HEAD_S : u32 = 45;
pub const V1_NEW_HEAD_S : u32 = 12;

/// V1 holds only if the measured head is at least three times faster.
pub fn v1_holds() -> bool {
    return V1_OLD_HEAD_S >= V1_NEW_HEAD_S * 3;
}

// -- V2: sticky last-good rung ----------------------------------------------
// Effort: one u32 of state (the last rung that answered 200) plus this start
// pick. Impact: after a noise episode every request re-pays the refusals of
// the resting rungs before it reaches a live one; starting the walk at the
// last good rung removes that walk for the common all-good case. Law 1 is
// amended, not broken: the walk still visits every rung at most once, only
// the START is sticky.
pub fn sticky_start(last_good : u32, tried : u32) -> u32 {
    if (last_good < RC and (tried >> last_good) % 2 == 0) { return last_good; }
    var r : u32 = 0;
    while (r < RC) {
        if ((tried >> r) % 2 == 0) { return r; }
        r = r + 1;
    }
    return RC;
}

// -- V3: hedged first hop ---------------------------------------------------
// Effort: the node glue fires two upstream calls at once and takes the first
// 200 (the biggest change: concurrency on the node). Impact: the tail of a
// noise turn becomes min(t0, t1) instead of t0 + t1 -- bounded by the second
// rung, not the sum.
pub fn hedged_tail(t0 : u32, t1 : u32) -> u32 {
    if (t0 < t1) { return t0; }
    return t1;
}

pub fn serial_tail(t0 : u32, t1 : u32) -> u32 {
    return t0 + t1;
}

// -- The Pareto ranking -----------------------------------------------------
// Impact and effort, 1..10 each (owner-scored 2026-10-27): V1 head upgrade
// 9/1, V2 sticky start 6/3, V3 hedged hop 5/7. The score is impact/effort on
// an x10 integer scale: 90, 20, 7 -- V1 lands first, the order is stable
// under any re-score that keeps the rows ranked.
pub const V_COUNT : u32 = 3;
pub const V_IMPACT : [3]u32 = [9, 6, 5];
pub const V_EFFORT : [3]u32 = [1, 3, 7];

pub fn pareto_pick() -> u32 {
    var best : u32 = 0;
    var best_score : u32 = 0;
    var v : u32 = 0;
    while (v < V_COUNT) {
        const score : u32 = (V_IMPACT[v] * 10) / V_EFFORT[v];
        if (score > best_score) {
            best = v;
            best_score = score;
        }
        v = v + 1;
    }
    return best;
}

test v1_the_head_upgrade_is_the_measured_win {
    assert v1_holds();
    assert V1_NEW_HEAD_S * 4 >= V1_OLD_HEAD_S;
}

test v2_the_walk_still_visits_each_rung_at_most_once {
    assert sticky_start(0, 0) == 0;
    assert sticky_start(2, 0) == 2;
    assert sticky_start(0, 1) == 1;
    assert sticky_start(2, 5) == 1;
    assert sticky_start(0, 15) == RC;
}

test v3_the_hedge_bounds_the_tail_by_the_second_rung {
    assert hedged_tail(12, 45) == 12;
    assert serial_tail(12, 45) == 57;
    assert hedged_tail(12, 45) < serial_tail(12, 45);
}

test the_pareto_rule_lands_v1_first {
    assert pareto_pick() == 0;
}

invariant the_fail_closed_law_survives_every_variant
    assert refusal(200) == false
    assert refusal(503) == true
    assert sticky_start(0, 15) == RC

bench "pareto_pick_ranking" {
    // Measure: the ranking stays O(V_COUNT), branch-stable, allocation-free
    // Target: 1000 picks, one division each, the pick never changes
    var pick : u32 = 0;
    var i : u32 = 0;
    while (i < 1000) {
        pick = pareto_pick();
        i = i + 1;
    }
    _ = pick;
}
