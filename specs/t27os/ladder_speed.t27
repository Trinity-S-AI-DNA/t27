// SPDX-License-Identifier: Apache-2.0
; Closes #11275
// specs/t27os/ladder_speed.t27 -- two active acceleration variants for the ladder
// serve path, ranked by the Pareto rule (owner brief 2026-10-27: 80/20 -- land
// the smallest effort with the biggest win first). Each variant is a pure
// decision function plus its impact/effort row; no variant weakens the
// fail-closed, sequential-provider or loopback laws of ladder.t27. The former
// V3 concurrent hedge is retired and has no executable path. ASCII only (L3). TRINITY

module T27OsLadderSpeed;

use t27os::ladder::{RUNG_COUNT, RUNG_OLLAMA, refusal};

const RC : u32 = RUNG_COUNT;
const LOCAL : u32 = RUNG_OLLAMA;

// -- V1: the 5.3 head -------------------------------------------------------
// Effort: one constant (the head model id the glue asks for). Impact: the
// measured breakthrough itself -- glm-5.3-flash thinking-off answered in
// 11.7 s with real content where the thinking-on head drained 45 s into an
// empty answer (2026-10-27): about 4x on every head-rung turn, no new
// machinery, ladder.t27 law 6 already demands thinking off.
pub const V1_HEAD_MODEL : str = "glm-5.3-flash";
pub const V1_OLD_HEAD_S : u32 = 45;
pub const V1_NEW_HEAD_S : u32 = 12;

/// V1 holds only if the measured head is at least three times faster.
pub fn v1_holds() -> bool {
    return V1_OLD_HEAD_S >= V1_NEW_HEAD_S * 3;
}

// -- V2: sticky last-good rung ----------------------------------------------
// Effort: one u32 of state (the last rung that answered 200) plus this start
// pick. Impact: after a noise episode every request re-pays the refusals of
// the resting rungs before it reaches a live one; starting the walk at the
// last good remote rung removes that walk for the common all-good case. The
// node-local ollama rung is sticky only after every remote rung was tried, so
// it can never hide an untried remote rung. Law 1 is amended, not broken: the
// walk still visits every rung at most once, only the START is sticky.
fn all_remote_tried(tried : u32) -> bool {
    var r : u32 = 0;
    while (r < LOCAL) {
        if ((tried >> r) % 2 == 0) { return false; }
        r = r + 1;
    }
    return true;
}

pub fn sticky_start(last_good : u32, tried : u32) -> u32 {
    if (last_good < RC and (tried >> last_good) % 2 == 0) {
        if (last_good < LOCAL) { return last_good; }
        if (all_remote_tried(tried)) { return last_good; }
    }
    var r : u32 = 0;
    while (r < RC) {
        if ((tried >> r) % 2 == 0) { return r; }
        r = r + 1;
    }
    return RC;
}

// -- V3: RETIRED concurrent hedge -------------------------------------------
// The former V3 fired two upstream provider calls at once. It is retired: the
// native ladder may have at most one provider call in flight, so the walk pays
// the full serial tail instead of hiding a second provider behind the first.
pub fn serial_tail(t0 : u32, t1 : u32) -> u32 {
    return t0 + t1;
}

// -- The Pareto ranking -----------------------------------------------------
// Impact and effort, 1..10 each (owner-scored 2026-10-27): V1 head upgrade
// 9/1, V2 sticky start 6/3. The retired V3 hedge is not ranked because it has
// no executable path. The score is impact/effort on an x10 integer scale:
// 90, 20 -- V1 lands first, the order is stable under any re-score that keeps
// the rows ranked.
pub const V_COUNT : u32 = 2;
pub const V_IMPACT : [2]u32 = [9, 6];
pub const V_EFFORT : [2]u32 = [1, 3];

pub fn pareto_pick() -> u32 {
    var best : u32 = 0;
    var best_score : u32 = 0;
    var v : u32 = 0;
    while (v < V_COUNT) {
        const score : u32 = (V_IMPACT[v] * 10) / V_EFFORT[v];
        if (score > best_score) {
            best = v;
            best_score = score;
        }
        v = v + 1;
    }
    return best;
}

test v1_the_head_upgrade_is_the_measured_win {
    assert v1_holds();
    assert V1_NEW_HEAD_S * 4 >= V1_OLD_HEAD_S;
}

test v2_the_walk_still_visits_each_rung_at_most_once {
    assert sticky_start(0, 0) == 0;
    assert sticky_start(1, 0) == 1;
    assert sticky_start(2, 0) == 2;
    assert sticky_start(0, 1) == 1;
    assert sticky_start(0, 3) == 2;
    assert sticky_start(0, 7) == 3;
    assert sticky_start(2, 5) == 1;
    assert sticky_start(0, 15) == RC;
}

test v2_local_last_good_waits_for_every_remote_rung {
    var tried : u32 = 0;
    while (tried < 16) {
        if (tried != 7) { assert sticky_start(3, tried) != 3; }
        tried = tried + 1;
    }
    assert sticky_start(3, 7) == 3;
    assert sticky_start(3, 15) == RC;
}

test v3_the_concurrent_hedge_is_retired_and_only_the_serial_tail_remains {
    assert serial_tail(12, 45) == 57;
    assert V_COUNT == 2;
}

test the_pareto_rule_lands_v1_first {
    assert pareto_pick() == 0;
}

invariant the_fail_closed_law_survives_every_variant
    assert refusal(200) == false
    assert refusal(503) == true
    assert sticky_start(0, 15) == RC

bench "pareto_pick_ranking" {
    // Measure: the ranking stays O(V_COUNT), branch-stable, allocation-free
    // Target: 1000 picks, one division each, the pick never changes
    var pick : u32 = 0;
    var i : u32 = 0;
    while (i < 1000) {
        pick = pareto_pick();
        i = i + 1;
    }
    _ = pick;
}

test negative_control_refutes_wrong_v1_old_head_s {
    assert(V1_OLD_HEAD_S != 50);
}
