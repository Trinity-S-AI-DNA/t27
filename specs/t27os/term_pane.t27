// SPDX-License-Identifier: Apache-2.0
; specs/t27os/term_pane.t27 -- the window side of a terminal pane: where the cell grid sits, how big a cell
; is, which agent rows open one, and which bytes a key press sends to the PTY.
; Owner, 2026-10-19: Claude Code runs inside the T27 OS window. Clicking the Claude Code entry under AGENTS
; opens a terminal pane in the current space's directory; the pane draws a grid of codepoints, monospace,
; black and white, with a cursor, and every key typed in it goes to the agent as bytes.
; The grid itself is specs/t27os/vt.t27 (bytes in, cells out). The PTY lives in the T27 OS terminal server
; and is reached through specs/t27os/pty_client.t27 (connect, list, spawn, keys, read). When no server
; answers on ~/.t27os/pty.sock the pane is OFFLINE: it says so on its first lines and echoes what it would
; send, and the window tries to connect again every TP_RETRY frames.
; The window stores no pane ids. Its k-th chat of an agent is the server's k-th pane of that agent
; (tp_pick_pane over a LIST reply), so a window that quits and reopens finds the same panes; a chat with no
; pane yet spawns one. When the grid that fits changes, the window sends RESIZE; the server sets the pty
; size (__ioctl TIOCSWINSZ) and signals SIGWINCH, so the program redraws at the pane's full width.
; The window keeps one grid. The server keeps every pane's output, so selecting another chat re-initialises
; the grid and re-attaches; nothing here is the store of a session's history.

module T27osTermPane;

use t27os::pty_proto::HEADER;
use t27os::pty_proto::RE_OK;
use t27os::pty_proto::RE_DATA;
use t27os::pty_proto::RE_LISTING;
use t27os::windows::session_agent;
use t27os::agents::S_STOPPED;
use t27os::agents::S_DONE;

/// The agent whose rows open a terminal pane: AGENT 0, Claude Code (agents.t27 AGENT_NAMES order).
pub const TERM_AGENT : u32 = 0;
/// The program a pane starts for TERM_AGENT, in the space's directory (agents.t27 AGENT_BINS).
pub const TERM_BIN : str = "claude";

/// Grid bounds. The host owns one [TP_CELLS]u32 buffer; a pane never asks for more.
pub const TP_COLS_MAX : u32 = 400;
pub const TP_ROWS_MAX : u32 = 120;
pub const TP_CELLS : u32 = 48000;
pub const TP_COLS_MIN : u32 = 20;
pub const TP_ROWS_MIN : u32 = 4;
/// One row of UTF-8 for drawing: four bytes a cell at most.
pub const TP_ROW_BYTES : u32 = 1600;

/// Cell metrics, in points: Menlo 12 advances 7.22 pt; a line is 15 pt. The grid sits TP_PAD inside the
/// content area below the header.
pub const TP_FONT : f64 = 12.0;
pub const TP_CELL_W : f64 = 7.22;
pub const TP_LINE_H : f64 = 15.0;
pub const TP_PAD : f64 = 14.0;
/// The baseline sits this far below a row's top.
pub const TP_BASE : f64 = 11.5;
/// The cursor is a block one cell wide; it blinks with a period of TP_BLINK frames (30 fps), and stays
/// solid for TP_BLINK frames after any key so typing never hides it.
pub const TP_BLINK : u32 = 30;

/// Pane link state.
pub const PANE_OFFLINE : u32 = 0;
pub const PANE_LIVE : u32 = 1;
pub const PANE_EXITED : u32 = 2;
/// No pane open.
pub const PANE_NONE : u32 = 999;
/// Frames between connect attempts while the pane is OFFLINE (30 fps: three seconds).
pub const TP_RETRY : u32 = 90;
/// READ round trips a frame makes at most. Each brings up to 4096 bytes, so a fresh grid replays the
/// server's whole 64 KiB ring in one frame and a busy pane never stalls the window for longer.
pub const TP_READS_MAX : u32 = 16;
/// Where the output bytes start in a RE_DATA reply: after the header and the 8-byte cursor.
pub const TP_DATA_AT : usize = 12;

/// The lines an OFFLINE pane prints first; the host writes the directory after TP_LINE_CWD, and the echo
/// starts after TP_PROMPT.
pub const TP_LINE_TITLE : str = "T27 OS terminal -- Claude Code";
pub const TP_LINE_CWD : str = "cwd ";
pub const TP_LINE_OFFLINE : str = "offline: no t27os pty server on ~/.t27os/pty.sock; keys echo here";
pub const TP_PROMPT : str = "> ";
/// The directory buffer the host fills for TP_LINE_CWD.
pub const TP_PATH_MAX : u32 = 512;

/// macOS virtual key codes the pane maps itself; every other key sends its characters.
pub const VK_RETURN : u32 = 36;
pub const VK_TAB : u32 = 48;
pub const VK_DELETE : u32 = 51;
pub const VK_ESCAPE : u32 = 53;
pub const VK_ENTER_PAD : u32 = 76;
pub const VK_HOME : u32 = 115;
pub const VK_PAGE_UP : u32 = 116;
pub const VK_FWD_DELETE : u32 = 117;
pub const VK_END : u32 = 119;
pub const VK_PAGE_DOWN : u32 = 121;
pub const VK_LEFT : u32 = 123;
pub const VK_RIGHT : u32 = 124;
pub const VK_DOWN : u32 = 125;
pub const VK_UP : u32 = 126;
/// The longest sequence one key sends.
pub const TP_KEY_MAX : u32 = 8;

/// Does a selected chat of this agent show a terminal pane?
pub fn opens_pane(agent: u32) -> bool {
    return agent == TERM_AGENT;
}

/// The grid that fits w x h points of content area (header excluded), clamped to the buffer.
pub fn tp_cols(w: f64) -> u32 {
    const avail : f64 = w - 2.0 * TP_PAD;
    if (avail < TP_CELL_W * @as(f64, TP_COLS_MIN)) { return TP_COLS_MIN; }
    const n : u32 = @as(u32, @intFromFloat(avail / TP_CELL_W));
    if (n > TP_COLS_MAX) { return TP_COLS_MAX; }
    return n;
}

pub fn tp_rows(h: f64) -> u32 {
    const avail : f64 = h - 2.0 * TP_PAD;
    if (avail < TP_LINE_H * @as(f64, TP_ROWS_MIN)) { return TP_ROWS_MIN; }
    const n : u32 = @as(u32, @intFromFloat(avail / TP_LINE_H));
    if (n > TP_ROWS_MAX) { return TP_ROWS_MAX; }
    return n;
}

/// A resize is due when the grid that fits differs from the one the pane has.
pub fn tp_resize_due(cols: u32, rows: u32, w: f64, h: f64) -> bool {
    return cols != tp_cols(w) or rows != tp_rows(h);
}

/// Frames the window's size must hold before the pane takes it (audit 2026-10-19: a drag re-ran the grid
/// and the ring replay on every frame). About 0.2 s at 30 fps; hot_reload.t27 waits the same way.
pub const TP_SETTLE : u32 = 6;

/// Frames the wanted grid has held, after this frame: a different grid starts the count over.
pub fn tp_settle(stable: u32, same: bool) -> u32 {
    if (same == false) { return 0; }
    if (stable >= TP_SETTLE) { return TP_SETTLE; }
    return stable + 1;
}

/// The pane takes a new size once the grid that fits differs from its own and has held TP_SETTLE frames.
pub fn tp_size_due(cols: u32, rows: u32, w: f64, h: f64, stable: u32) -> bool {
    return stable >= TP_SETTLE and tp_resize_due(cols, rows, w, h);
}

/// Where cell (x, y) starts, from the content area's top-left (ox, oy).
pub fn tp_cell_x(ox: f64, x: u32) -> f64 { return ox + TP_PAD + @as(f64, x) * TP_CELL_W; }
pub fn tp_cell_y(oy: f64, y: u32) -> f64 { return oy + TP_PAD + @as(f64, y) * TP_LINE_H; }

/// The cursor column shown: a cursor parked past the last column (deferred wrap) draws on the last one.
pub fn tp_cursor_col(x: u32, cols: u32) -> u32 {
    if (cols == 0) { return 0; }
    if (x >= cols) { return cols - 1; }
    return x;
}

/// Is the cursor drawn this frame? `since` is frames since the last key.
pub fn tp_cursor_on(frame: u32, since: u32) -> bool {
    if (since < TP_BLINK) { return true; }
    return frame / TP_BLINK % 2 == 0;
}

/// Opening a pane for chat `cur` resets the grid unless that chat's pane is already the one shown.
pub fn tp_reset_due(open_si: u32, cur: u32) -> bool {
    return open_si != cur;
}

fn tp_put(out: []u8, at: u32, b: u8) -> u32 {
    if (at < TP_KEY_MAX) { out[at] = b; }
    return at + 1;
}

fn tp_csi(out: []u8, fin: u8) -> u32 {
    var n : u32 = tp_put(out, 0, 27);
    n = tp_put(out, n, 91);
    return tp_put(out, n, fin);
}

fn tp_csi_tilde(out: []u8, d: u8) -> u32 {
    var n : u32 = tp_put(out, 0, 27);
    n = tp_put(out, n, 91);
    n = tp_put(out, n, d);
    return tp_put(out, n, 126);
}

/// UTF-8 of one codepoint into out at `at`; returns the new end. A surrogate or out-of-range codepoint
/// writes U+FFFD.
pub fn tp_utf8(out: []u8, at: u32, cp0: u32) -> u32 {
    var cp : u32 = cp0;
    if (cp > 1114111 or (cp >= 55296 and cp <= 57343)) { cp = 65533; }
    if (cp < 128) {
        out[at] = @as(u8, @intCast(cp));
        return at + 1;
    }
    if (cp < 2048) {
        out[at] = @as(u8, @intCast(192 + cp / 64));
        out[at + 1] = @as(u8, @intCast(128 + cp % 64));
        return at + 2;
    }
    if (cp < 65536) {
        out[at] = @as(u8, @intCast(224 + cp / 4096));
        out[at + 1] = @as(u8, @intCast(128 + cp / 64 % 64));
        out[at + 2] = @as(u8, @intCast(128 + cp % 64));
        return at + 3;
    }
    out[at] = @as(u8, @intCast(240 + cp / 262144));
    out[at + 1] = @as(u8, @intCast(128 + cp / 4096 % 64));
    out[at + 2] = @as(u8, @intCast(128 + cp / 64 % 64));
    out[at + 3] = @as(u8, @intCast(128 + cp % 64));
    return at + 4;
}

/// The bytes one key press sends to the PTY: `key` is the virtual key code, `cp` the first character the
/// key types without modifiers (0 when it types none), `ctrl` whether Control is held. Command is the
/// window's (the host never forwards a Command key). Returns how many bytes went into out (TP_KEY_MAX long).
pub fn tp_key_bytes(key: u32, cp: u32, ctrl: bool, out: []u8) -> u32 {
    if (key == VK_RETURN or key == VK_ENTER_PAD) { return tp_put(out, 0, 13); }
    if (key == VK_TAB) { return tp_put(out, 0, 9); }
    if (key == VK_DELETE) { return tp_put(out, 0, 127); }
    if (key == VK_ESCAPE) { return tp_put(out, 0, 27); }
    if (key == VK_UP) { return tp_csi(out, 65); }
    if (key == VK_DOWN) { return tp_csi(out, 66); }
    if (key == VK_RIGHT) { return tp_csi(out, 67); }
    if (key == VK_LEFT) { return tp_csi(out, 68); }
    if (key == VK_HOME) { return tp_csi(out, 72); }
    if (key == VK_END) { return tp_csi(out, 70); }
    if (key == VK_FWD_DELETE) { return tp_csi_tilde(out, 51); }
    if (key == VK_PAGE_UP) { return tp_csi_tilde(out, 53); }
    if (key == VK_PAGE_DOWN) { return tp_csi_tilde(out, 54); }
    if (cp == 0) { return 0; }
    if (ctrl) {
        // Control folds a letter or one of @[\]^_ to its C0 code; Control+space is NUL
        if (cp >= 97 and cp <= 122) { return tp_put(out, 0, @as(u8, @intCast(cp - 96))); }
        if (cp >= 64 and cp <= 95) { return tp_put(out, 0, @as(u8, @intCast(cp - 64))); }
        if (cp == 32) { return tp_put(out, 0, 0); }
    }
    return tp_utf8(out, 0, cp);
}

/// OFFLINE echo: what the grid is fed for the bytes a key would send, so the echo reads like a shell line.
/// Return echoes CR LF, Delete echoes BS space BS; everything else echoes as sent. Returns the length.
pub fn tp_echo(sent: []const u8, n: u32, out: []u8) -> u32 {
    if (n == 1 and sent[0] == 13) {
        out[0] = 13;
        out[1] = 10;
        return 2;
    }
    if (n == 1 and sent[0] == 127) {
        out[0] = 8;
        out[1] = 32;
        out[2] = 8;
        return 3;
    }
    var i : u32 = 0;
    while (i < n) {
        out[i] = sent[i];
        i = i + 1;
    }
    return n;
}

/// The k-th pane running `agent` in a LIST reply (`len` bytes of frame: the header, then pane, agent,
/// state and flags per entry); PANE_NONE when the server has fewer, or the frame is not a listing.
pub fn tp_pick_pane(frame: []const u8, len: usize, agent: u32, k: u32) -> u32 {
    if (len < HEADER or frame[0] != RE_LISTING) { return PANE_NONE; }
    var seen : u32 = 0;
    var found : u32 = PANE_NONE;
    var at : usize = HEADER;
    while (at + 4 <= len and found == PANE_NONE) {
        if (@as(u32, frame[at + 1]) == agent) {
            if (seen == k) { found = @as(u32, frame[at]); }
            seen = seen + 1;
        }
        at = at + 4;
    }
    return found;
}

/// True when a LIST reply (`len` bytes of frame) holds pane `pane` with its live flag (bit 0) set: the
/// editor pane the window opened earlier is still running.
pub fn tp_pane_live(frame: []const u8, len: usize, pane: u32) -> bool {
    if (len < HEADER or frame[0] != RE_LISTING) { return false; }
    var at : usize = HEADER;
    while (at + 4 <= len) {
        if (@as(u32, frame[at]) == pane) { return frame[at + 3] % 2 == 1; }
        at = at + 4;
    }
    return false;
}

/// The state the server lists for the k-th pane of `agent` (entry byte 2, S_* of agents.t27), so a row shows
/// what the pane really is: S_STOPPED when the server lists no such pane or its live flag (bit 0) is clear.
pub fn tp_state_of(frame: []const u8, len: usize, agent: u32, k: u32) -> u32 {
    if (len < HEADER or frame[0] != RE_LISTING) { return S_STOPPED; }
    var seen : u32 = 0;
    var at : usize = HEADER;
    while (at + 4 <= len) {
        if (@as(u32, frame[at + 1]) == agent) {
            if (seen == k) {
                if (frame[at + 3] % 2 == 0) { return S_STOPPED; }
                const st : u32 = @as(u32, frame[at + 2]);
                if (st > S_DONE) { return S_STOPPED; }
                return st;
            }
            seen = seen + 1;
        }
        at = at + 4;
    }
    return S_STOPPED;
}

/// Which of the window's chats of its own agent chat `cur` is: 0 for the first, 1 for the second, ...
pub fn tp_ordinal(ss: u64, cur: u32) -> u32 {
    const a : u32 = session_agent(ss, cur);
    var k : u32 = 0;
    var i : u32 = 0;
    while (i < cur) {
        if (session_agent(ss, i) == a) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

/// The pane a SPAWN reply names, PANE_NONE when the server refused.
pub fn tp_spawned(frame: []const u8, len: usize) -> u32 {
    if (len < HEADER or frame[0] != RE_OK) { return PANE_NONE; }
    return @as(u32, frame[1]);
}

/// How many output bytes a READ reply carries (from TP_DATA_AT); 0 for anything but RE_DATA.
pub fn tp_data_len(frame: []const u8, len: usize) -> usize {
    if (len < TP_DATA_AT or frame[0] != RE_DATA) { return 0; }
    return len - TP_DATA_AT;
}

/// Another READ this frame? Only while the last one came back full and the budget lasts.
pub fn tp_read_more(got: usize, reads: u32) -> bool {
    return got == 4096 and reads < TP_READS_MAX;
}

/// Try to connect this frame? At once on a fresh pane, then every TP_RETRY frames while offline.
pub fn tp_retry_due(since_try: u32) -> bool {
    return since_try >= TP_RETRY;
}

test claude_code_rows_open_a_pane {
    assert opens_pane(0);
    assert opens_pane(1) == false;
    assert opens_pane(4) == false;
}

test the_grid_fits_the_content_area {
    // 760 x 452 pt of content: (760 - 28) / 7.22 = 101 columns, (452 - 28) / 15 = 28 rows
    assert tp_cols(760.0) == 101;
    assert tp_rows(452.0) == 28;
    assert tp_cols(10.0) == TP_COLS_MIN;
    assert tp_rows(10.0) == TP_ROWS_MIN;
    assert tp_cols(5000.0) == TP_COLS_MAX;
    assert tp_rows(5000.0) == TP_ROWS_MAX;
    assert TP_COLS_MAX * TP_ROWS_MAX <= TP_CELLS;
    assert TP_COLS_MAX * 4 <= TP_ROW_BYTES;
    assert tp_resize_due(101, 28, 760.0, 452.0) == false;
    assert tp_resize_due(80, 24, 760.0, 452.0);
}

test cells_and_cursor_sit_on_the_grid {
    assert tp_cell_x(200.0, 0) == 214.0;
    assert tp_cell_y(44.0, 2) == 88.0;
    assert tp_cursor_col(5, 80) == 5;
    assert tp_cursor_col(80, 80) == 79;
    assert tp_cursor_on(45, 0);
    assert tp_cursor_on(0, 99);
    assert tp_cursor_on(45, 99) == false;
    assert tp_reset_due(PANE_NONE, 0);
    assert tp_reset_due(2, 2) == false;
}

test keys_become_terminal_bytes {
    var o : [8]u8 = undefined;
    assert tp_key_bytes(VK_RETURN, 13, false, o[0..8]) == 1 and o[0] == 13;
    assert tp_key_bytes(VK_DELETE, 127, false, o[0..8]) == 1 and o[0] == 127;
    assert tp_key_bytes(VK_TAB, 9, false, o[0..8]) == 1 and o[0] == 9;
    assert tp_key_bytes(VK_ESCAPE, 27, false, o[0..8]) == 1 and o[0] == 27;
    assert tp_key_bytes(VK_UP, 0, false, o[0..8]) == 3 and o[0] == 27 and o[1] == 91 and o[2] == 65;
    assert tp_key_bytes(VK_LEFT, 0, false, o[0..8]) == 3 and o[2] == 68;
    assert tp_key_bytes(VK_FWD_DELETE, 0, false, o[0..8]) == 4 and o[2] == 51 and o[3] == 126;
    // a letter sends itself; Control+c sends ETX; Control+[ sends ESC
    assert tp_key_bytes(0, 97, false, o[0..8]) == 1 and o[0] == 97;
    assert tp_key_bytes(8, 99, true, o[0..8]) == 1 and o[0] == 3;
    assert tp_key_bytes(33, 91, true, o[0..8]) == 1 and o[0] == 27;
    assert tp_key_bytes(49, 32, true, o[0..8]) == 1 and o[0] == 0;
    // a modifier alone types nothing and sends nothing
    assert tp_key_bytes(56, 0, false, o[0..8]) == 0;
}

test codepoints_encode_as_utf8 {
    var o : [8]u8 = undefined;
    assert tp_utf8(o[0..8], 0, 65) == 1 and o[0] == 65;
    // U+00E9 is C3 A9
    assert tp_utf8(o[0..8], 0, 233) == 2 and o[0] == 195 and o[1] == 169;
    // U+2500 (box drawing) is E2 94 80
    assert tp_utf8(o[0..8], 0, 9472) == 3 and o[0] == 226 and o[1] == 148 and o[2] == 128;
    // U+1F600 is F0 9F 98 80
    assert tp_utf8(o[0..8], 0, 128512) == 4 and o[0] == 240 and o[1] == 159 and o[2] == 152 and o[3] == 128;
    // a lone surrogate becomes U+FFFD, EF BF BD
    assert tp_utf8(o[0..8], 0, 55296) == 3 and o[0] == 239 and o[1] == 191 and o[2] == 189;
}

test offline_echo_reads_like_a_line {
    var s : [8]u8 = undefined;
    var o : [8]u8 = undefined;
    s[0] = 13;
    assert tp_echo(s[0..8], 1, o[0..8]) == 2 and o[0] == 13 and o[1] == 10;
    s[0] = 127;
    assert tp_echo(s[0..8], 1, o[0..8]) == 3 and o[0] == 8 and o[1] == 32 and o[2] == 8;
    s[0] = 104;
    assert tp_echo(s[0..8], 1, o[0..8]) == 1 and o[0] == 104;
}

test a_reopened_window_finds_its_panes {
    // LIST reply: header, then panes 3 (claude), 5 (codex), 7 (claude)
    var f : [16]u8 = undefined;
    f[0] = RE_LISTING; f[1] = 0; f[2] = 12; f[3] = 0;
    f[4] = 3; f[5] = 0; f[6] = 1; f[7] = 1;
    f[8] = 5; f[9] = 1; f[10] = 1; f[11] = 1;
    f[12] = 7; f[13] = 0; f[14] = 1; f[15] = 1;
    assert tp_pick_pane(f[0..16], 16, 0, 0) == 3;
    assert tp_pick_pane(f[0..16], 16, 0, 1) == 7;
    assert tp_pick_pane(f[0..16], 16, 0, 2) == PANE_NONE;
    assert tp_pick_pane(f[0..16], 16, 1, 0) == 5;
    assert tp_pick_pane(f[0..16], 4, 0, 0) == PANE_NONE;
    f[0] = RE_OK;
    assert tp_pick_pane(f[0..16], 16, 0, 0) == PANE_NONE;
    // chats: claude in space 0, codex in space 0, claude in space 1 (slot byte = agent * 8 + space + 1)
    const ss : u64 = 1 + 9 * 256 + 2 * 65536;
    assert tp_ordinal(ss, 0) == 0;
    assert tp_ordinal(ss, 1) == 0;
    assert tp_ordinal(ss, 2) == 1;
}

test replies_read_as_pane_and_bytes {
    var f : [20]u8 = undefined;
    f[0] = RE_OK; f[1] = 6; f[2] = 0; f[3] = 0;
    assert tp_spawned(f[0..20], 4) == 6;
    assert tp_spawned(f[0..20], 3) == PANE_NONE;
    f[0] = RE_DATA;
    assert tp_spawned(f[0..20], 4) == PANE_NONE;
    assert TP_DATA_AT == HEADER + 8;
    assert tp_data_len(f[0..20], 20) == 8;
    assert tp_data_len(f[0..20], 12) == 0;
    assert tp_data_len(f[0..20], 11) == 0;
    f[0] = RE_OK;
    assert tp_data_len(f[0..20], 20) == 0;
    assert tp_read_more(4096, 1);
    assert tp_read_more(4096, TP_READS_MAX) == false;
    assert tp_read_more(100, 1) == false;
    assert tp_retry_due(0) == false;
    assert tp_retry_due(TP_RETRY);
    // the whole ring replays in one frame's budget
    assert @as(u64, TP_READS_MAX) * 4096 >= 65536;
}

invariant grid_buffer_holds_the_largest_pane {
    assert TP_COLS_MAX * TP_ROWS_MAX <= TP_CELLS;
}

test a_resize_waits_until_the_size_holds {
    assert tp_settle(0, false) == 0;
    assert tp_settle(3, false) == 0;
    assert tp_settle(3, true) == 4;
    assert tp_settle(TP_SETTLE, true) == TP_SETTLE;
    assert tp_size_due(80, 24, 760.0, 452.0, TP_SETTLE - 1) == false;
    assert tp_size_due(80, 24, 760.0, 452.0, TP_SETTLE);
    assert tp_size_due(101, 28, 760.0, 452.0, TP_SETTLE) == false;
}

test an_editor_pane_is_reused_only_while_the_server_lists_it_live {
    // LIST reply: header, then pane 3 (live), pane 5 (stopped), pane 7 (live, needs you)
    var f : [16]u8 = undefined;
    f[0] = RE_LISTING; f[1] = 0; f[2] = 12; f[3] = 0;
    f[4] = 3; f[5] = 9; f[6] = 1; f[7] = 1;
    f[8] = 5; f[9] = 9; f[10] = 0; f[11] = 0;
    f[12] = 7; f[13] = 9; f[14] = 2; f[15] = 3;
    assert tp_pane_live(f[0..16], 16, 3);
    assert tp_pane_live(f[0..16], 16, 5) == false;
    assert tp_pane_live(f[0..16], 16, 7);
    assert tp_pane_live(f[0..16], 16, 4) == false;
    assert tp_pane_live(f[0..16], 16, PANE_NONE) == false;
    assert tp_pane_live(f[0..16], 8, 7) == false;
    assert tp_pane_live(f[0..16], 3, 3) == false;
    f[0] = RE_OK;
    assert tp_pane_live(f[0..16], 16, 3) == false;
}

test a_row_shows_the_state_the_server_lists_not_the_seed {
    // the live finding: "pane 0 agent 0 state 3 flags 1" is idle and live, not stopped
    var f : [16]u8 = undefined;
    f[0] = RE_LISTING; f[1] = 0; f[2] = 12; f[3] = 0;
    f[4] = 0; f[5] = 0; f[6] = 3; f[7] = 1;
    f[8] = 5; f[9] = 1; f[10] = 1; f[11] = 1;
    f[12] = 7; f[13] = 0; f[14] = 2; f[15] = 0;
    assert tp_state_of(f[0..16], 16, 0, 0) == 3;
    assert tp_state_of(f[0..16], 16, 1, 0) == 1;
    // the second claude pane is listed but its live flag is clear: stopped
    assert tp_state_of(f[0..16], 16, 0, 1) == S_STOPPED;
    // no such pane, a truncated frame, a frame that is not a listing, a state past S_DONE
    assert tp_state_of(f[0..16], 16, 4, 0) == S_STOPPED;
    assert tp_state_of(f[0..16], 4, 0, 0) == S_STOPPED;
    f[4 + 2] = 9;
    assert tp_state_of(f[0..16], 16, 0, 0) == S_STOPPED;
    f[0] = RE_OK;
    assert tp_state_of(f[0..16], 16, 1, 0) == S_STOPPED;
}
