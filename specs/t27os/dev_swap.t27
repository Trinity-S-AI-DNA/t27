module DevSwap;
// Slice 3 (executable path), contract only: a dev build may replace its own
// binary through the EXISTING update machine (update_tick -> swap_ready ->
// swap_cmd -> re-exec), but only for an explicitly staged local candidate, and
// only after this gate passes. No download, no automatic replacement, no
// production behavior change. The re-exec changes the PID: state preservation
// is the documented restore set below (what main() re-reads at startup), not a
// same-process guarantee. This module holds the RULES and the restore-set
// contract; glass_window keeps the wiring until a live swap is separately
// authorized.

use t27os::install::CHANNEL_DEV_ID;

/// Swap decisions.
pub const SWAP_OK : u8 = 0;
pub const SWAP_NOT_DEV : u8 = 1;
pub const SWAP_FOREIGN_BUNDLE : u8 = 2;
pub const SWAP_NOT_STAGED : u8 = 3;
pub const SWAP_INCOMPATIBLE : u8 = 4;

/// Is this build on the development channel? The runtime evidence is the
/// bundle id suffix written by install.t27 plist_text_channel.
pub fn is_dev_bundle_id(id : []const u8, n : usize) -> bool {
    if (n != 13) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (id[i] != "ai.t27.os.dev"[i]) { return false; }
        i += 1;
    }
    return true;
}

/// The restore set: NSUserDefaults keys main() re-reads at startup, so a
/// swap-and-reexec lands on the same page, space and window frame. Keys are
/// byte-listed here so a rename in main breaks this test instead of silently
/// dropping restored state.
pub fn restore_key_at(i : u32) -> str {
    if (i == 0) { return "t27os.state"; }
    if (i == 1) { return "t27os.shown"; }
    if (i == 2) { return "t27os.kept"; }
    if (i == 3) { return "t27os.task"; }
    if (i == 4) { return "t27os.cur"; }
    if (i == 5) { return "t27os.space"; }
    if (i == 6) { return "t27os.ss"; }
    if (i == 7) { return "t27os.sp"; }
    return "";
}

pub const RESTORE_KEY_COUNT : u32 = 8;

/// The swap gate. dev: this build's bundle id is the dev channel id;
/// cand_id: the staged candidate's declared bundle id (must be the SAME dev
/// id -- a candidate for another channel is refused); staged: the candidate
/// bundle exists beside the running one (the update machine's staging area);
/// schema: candidate interface version (RC_SCHEMA-class), must equal 1.
pub fn swap_allowed(dev : bool, cand_id : []const u8, cid_len : usize, staged : bool, schema : u64) -> u8 {
    if (!dev) { return SWAP_NOT_DEV; }
    if (!is_dev_bundle_id(cand_id, cid_len)) { return SWAP_FOREIGN_BUNDLE; }
    if (!staged) { return SWAP_NOT_STAGED; }
    if (schema != 1) { return SWAP_INCOMPATIBLE; }
    return SWAP_OK;
}

test dev_id_recognized {
    assert(is_dev_bundle_id("ai.t27.os.dev", 13) == true);
    assert(is_dev_bundle_id("ai.t27.os", 9) == false);
    assert(is_dev_bundle_id("", 0) == false);
}

test swap_gate_decisions {
    const cid : str = "ai.t27.os.dev";
    // a dev build may swap a staged, compatible, same-channel candidate
    assert(swap_allowed(true, cid, 13, true, 1) == SWAP_OK);
    // production builds never take this path (unchanged behavior)
    assert(swap_allowed(false, cid, 13, true, 1) == SWAP_NOT_DEV);
    // a candidate for another channel is foreign
    assert(swap_allowed(true, "ai.t27.os", 9, true, 1) == SWAP_FOREIGN_BUNDLE);
    // nothing staged, nothing swapped
    assert(swap_allowed(true, cid, 13, false, 1) == SWAP_NOT_STAGED);
    // interface version must match
    assert(swap_allowed(true, cid, 13, true, 2) == SWAP_INCOMPATIBLE);
}

test the_restore_set_covers_the_launch_keys {
    var i : u32 = 0;
    while (i < RESTORE_KEY_COUNT) {
        assert(restore_key_at(i).len > 0);
        i += 1;
    }
    assert(restore_key_at(RESTORE_KEY_COUNT).len == 0);
    assert(restore_key_at(0) == "t27os.state");
    assert(restore_key_at(7) == "t27os.sp");
}

endmodule
