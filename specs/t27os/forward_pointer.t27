// specs/t27os/forward_pointer.t27 -- t27os: forward pointer and keyboard - browser pane.
// Part of M6 milestone (milestone #10). Closes #14039.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::forward_pointer;

pub const FORWARD_POINTER_MAX_EVENTS : u32 = 1024;

pub struct PointerEvent { x: u32, y: u32, pressed: bool };

pub fn pointer_event_processed(p: PointerEvent) -> bool {
    return p.pressed;
}

test "pointer_event_processed" {
    assert(pointer_event_processed(PointerEvent { x: 100, y: 200, pressed: true }));
    assert(!pointer_event_processed(PointerEvent { x: 100, y: 200, pressed: false }));
}

invariant forward_pointer_max_events_positive {
    assert FORWARD_POINTER_MAX_EVENTS > 0;
}