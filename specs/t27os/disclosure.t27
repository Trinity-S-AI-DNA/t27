// SPDX-License-Identifier: Apache-2.0
; specs/t27os/disclosure.t27 -- no number leaves without its five fields (board Trinity-S-AI-DNA/t27os#20,
; adopt-line 3 of 3 from the competitor pass on t27os#7, the AgentOS section). Every number T27 OS publishes
; about itself -- a receipt summary, a README benchmark line, an issue comment quoting a count -- ships with a
; five-line footer:
;   reader: what produced the measurement (t27c version + build stamp, the spec list measured);
;   judge:  what decided pass/fail (t27c test-report) and its known failure modes (vacuous, blocked, t27os#13);
;   n:      how many independent runs back the number -- a count in words, or a 95% CI only when n >= 2;
;   cost:   wall-clock and runner-minutes per verification;
;   repro:  the one command that re-runs it (the workflow_dispatch with sha + challenge).
; A field that is empty or a placeholder ("TBD", "?", ...) is a missing field: the number is refused, not
; published with a gap. A footer with no run behind it (n = 0) is refused too. The checker over runs/ and the
; README (t27os#20 criterion 3) counts number lines and footed lines; "all covered" is said only when the two
; counts are equal and not zero.
; Reading the files and splitting a footer into its five values is the boundary's work; everything decided
; about the values is here. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osDisclosure;

use claw::recipes::str_eq;

/// The five fields, in footer order.
pub const FIELD_READER : u8 = 0;
pub const FIELD_JUDGE : u8 = 1;
pub const FIELD_N : u8 = 2;
pub const FIELD_COST : u8 = 3;
pub const FIELD_REPRO : u8 = 4;
pub const FIELD_COUNT : u8 = 5;
/// No field is at fault.
pub const FIELD_NONE : u8 = 255;

/// The footer line prefixes the checker splits on, one per FIELD_* constant, in order.
pub const FIELD_PREFIXES : str = "reader:,judge:,n:,cost:,repro:";

/// How the n field states its backing: a plain count of runs, or a 95% confidence interval.
pub const N_KIND_COUNT : u8 = 0;
pub const N_KIND_CI : u8 = 1;
/// A confidence interval needs at least two independent runs; one run is stated as a count.
pub const CI_MIN_RUNS : u32 = 2;

/// The verdict on one footer.
pub const DISC_OK : u8 = 0;
pub const DISC_MISSING : u8 = 1;
pub const DISC_PLACEHOLDER : u8 = 2;
pub const DISC_NO_RUN : u8 = 3;
pub const DISC_CI_FROM_ONE : u8 = 4;

/// The checker's verdict over a set of published files.
pub const COV_ALL : u8 = 0;
pub const COV_GAP : u8 = 1;
pub const COV_EMPTY : u8 = 2;
pub const COV_OVER : u8 = 3;

/// A value the writer did not fill in.
pub fn is_placeholder(v: str) -> bool {
    if (str_eq(v, "TBD")) { return true; }
    if (str_eq(v, "tbd")) { return true; }
    if (str_eq(v, "TODO")) { return true; }
    if (str_eq(v, "?")) { return true; }
    if (str_eq(v, "-")) { return true; }
    if (str_eq(v, "n/a")) { return true; }
    if (str_eq(v, "...")) { return true; }
    return false;
}

/// 0 when the value is usable, else the DISC_* reason it is not.
pub fn field_fault(v: str) -> u8 {
    if (str_eq(v, "")) { return DISC_MISSING; }
    if (is_placeholder(v)) { return DISC_PLACEHOLDER; }
    return DISC_OK;
}

/// The first field at fault, in footer order, or FIELD_NONE.
pub fn first_bad_field(reader: str, judge: str, n_text: str, cost: str, repro: str) -> u8 {
    if (field_fault(reader) != DISC_OK) { return FIELD_READER; }
    if (field_fault(judge) != DISC_OK) { return FIELD_JUDGE; }
    if (field_fault(n_text) != DISC_OK) { return FIELD_N; }
    if (field_fault(cost) != DISC_OK) { return FIELD_COST; }
    if (field_fault(repro) != DISC_OK) { return FIELD_REPRO; }
    return FIELD_NONE;
}

/// The verdict on one footer: every field filled, at least one run behind the number, and a CI only
/// where two or more runs can carry one.
pub fn footer_verdict(reader: str, judge: str, n_text: str, cost: str, repro: str, runs: u32, n_kind: u8) -> u8 {
    var f : u8 = field_fault(reader);
    if (f != DISC_OK) { return f; }
    f = field_fault(judge);
    if (f != DISC_OK) { return f; }
    f = field_fault(n_text);
    if (f != DISC_OK) { return f; }
    f = field_fault(cost);
    if (f != DISC_OK) { return f; }
    f = field_fault(repro);
    if (f != DISC_OK) { return f; }
    if (runs == 0) { return DISC_NO_RUN; }
    if (n_kind == N_KIND_CI and runs < CI_MIN_RUNS) { return DISC_CI_FROM_ONE; }
    return DISC_OK;
}

/// The checker's verdict: number_lines published numbers, footed of them carrying a DISC_OK footer.
/// More footers than numbers is a counting fault, never "all covered".
pub fn coverage_verdict(number_lines: u32, footed: u32) -> u8 {
    if (number_lines == 0) { return COV_EMPTY; }
    if (footed > number_lines) { return COV_OVER; }
    if (footed < number_lines) { return COV_GAP; }
    return COV_ALL;
}

test a_full_footer_with_one_run_stated_as_a_count_is_published {
    assert footer_verdict("t27c 0.5.2 build 8f28c2d8", "t27c test-report", "n=1 run", "4 min wall", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_OK;
    assert first_bad_field("t27c 0.5.2 build 8f28c2d8", "t27c test-report", "n=1 run", "4 min wall", "gh workflow run lab.yml") == FIELD_NONE;
}

test negative_control_a_missing_field_refuses_the_number {
    assert footer_verdict("", "t27c test-report", "n=1 run", "4 min", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_MISSING;
    assert footer_verdict("t27c 0.5.2", "", "n=1 run", "4 min", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_MISSING;
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "", "4 min", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_MISSING;
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "n=1 run", "", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_MISSING;
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "n=1 run", "4 min", "", 1, N_KIND_COUNT) == DISC_MISSING;
    assert first_bad_field("t27c 0.5.2", "t27c test-report", "n=1 run", "", "") == FIELD_COST;
}

test negative_control_a_placeholder_is_a_missing_field {
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "n=1 run", "TBD", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_PLACEHOLDER;
    assert footer_verdict("t27c 0.5.2", "?", "n=1 run", "4 min", "gh workflow run lab.yml", 1, N_KIND_COUNT) == DISC_PLACEHOLDER;
    assert is_placeholder("n/a") == true;
    assert is_placeholder("TBD 4 min") == false;
    assert first_bad_field("t27c 0.5.2", "t27c test-report", "TODO", "4 min", "gh workflow run lab.yml") == FIELD_N;
}

test negative_control_no_run_and_a_ci_from_one_run_are_refused {
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "n=0", "0 min", "gh workflow run lab.yml", 0, N_KIND_COUNT) == DISC_NO_RUN;
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "95% CI 9..9", "4 min", "gh workflow run lab.yml", 1, N_KIND_CI) == DISC_CI_FROM_ONE;
    assert footer_verdict("t27c 0.5.2", "t27c test-report", "95% CI 9..9", "4 min", "gh workflow run lab.yml", 2, N_KIND_CI) == DISC_OK;
}

test the_first_receipt_048f7f45_as_it_stands_is_refused_until_its_cost_is_recorded {
    // runs/8f28c2d849.048f7f45.json (2026-10-23): work_graph 9/9, actors 37/37, export_video 6/6, one run plus
    // one requester reproduction. The receipt records no wall-clock or runner-minutes, so its cost is honestly
    // unknown -- and an unknown field refuses the number.
    assert footer_verdict("t27c 0.5.2 build 8f28c2d8; specs work_graph, actors, export_video",
                          "t27c test-report; vacuous and blocked are counted, never passed (t27os#13)",
                          "n=1 run + 1 requester reproduction",
                          "TBD",
                          "gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=8f28c2d849 -f challenge=<hex whose sha256 starts 048f7f45>",
                          2, N_KIND_COUNT) == DISC_PLACEHOLDER;
}

test coverage_is_all_only_when_every_number_carries_its_footer {
    assert coverage_verdict(3, 3) == COV_ALL;
    assert coverage_verdict(3, 2) == COV_GAP;
    assert coverage_verdict(0, 0) == COV_EMPTY;
    assert coverage_verdict(2, 3) == COV_OVER;
}
