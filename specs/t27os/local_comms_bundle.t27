// SPDX-License-Identifier: Apache-2.0
// Native build metadata generator. Emits data only; no private signing material.
fn mb_write(fd:i32,bytes:[]const u8,n:u64)->i64 {
    return @extern("write");
}
pub fn mb_version()->[]const u8 {
    return "0.3.0";
}
pub fn mb_build()->[]const u8 {
    return "19";
}
pub fn mb_numeric_build(text:[]const u8)->bool {
    if(text.len==0 or text.len>9) {
        return false;
    }
    var i:usize=0;
    while(i<text.len) {
        if(text[i]<48 or text[i]>57) {
            return false;
        }
        i=i+1;
    }
    return true;
}
fn mb_emit(text:[]const u8)->bool {
    var at:usize=0;
    while(at<text.len) {
        const n:i64=mb_write(1,text[at..text.len],@as(u64,text.len-at));
        if(n<=0) {
            return false;
        }
        at=at+@as(usize,@intCast(n));
    }
    return true;
}
pub fn main()->i32 {
    if(!mb_numeric_build(mb_build())) {
        return 1;
    }
    if(!mb_emit("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict>\n<key>CFBundleName</key><string>T27OSCommunications</string>\n<key>CFBundleDisplayName</key><string>T27 OS Communications Preview</string>\n<key>CFBundleExecutable</key><string>T27OS</string>\n<key>CFBundleIdentifier</key><string>ai.t27.os.serverless.dev</string>\n<key>CFBundlePackageType</key><string>APPL</string>\n<key>CFBundleShortVersionString</key><string>")) {
        return 2;
    }
    if(!mb_emit(mb_version()) or !mb_emit("</string>\n<key>CFBundleVersion</key><string>") or !mb_emit(mb_build())) {
        return 2;
    }
    if(!mb_emit("</string>\n<key>T27BuildLabel</key><string>Native communications preview</string>\n<key>T27LocalOnlyDefault</key><true/>\n<key>LSMinimumSystemVersion</key><string>11.0</string>\n<key>NSPrincipalClass</key><string>NSApplication</string>\n<key>NSHighResolutionCapable</key><true/>\n<key>NSMicrophoneUsageDescription</key><string>Send microphone audio only in a call whose codes you confirmed. Listening-only mode keeps the microphone off.</string>\n<key>NSCameraUsageDescription</key><string>Send live video only after you explicitly start the camera in a verified call.</string>\n<key>NSLocalNetworkUsageDescription</key><string>Reach the nominated T27 contact directly on your local network.</string>\n</dict></plist>\n")) {
        return 2;
    }
    return 0;
}
test owner_version_and_numeric_build_are_preserved {
    const v:[]const u8=mb_version();
    assert v.len==5 and v[0]==48 and v[1]==46 and v[2]==51 and v[3]==46 and v[4]==48;
    assert mb_numeric_build(mb_build()) and !mb_numeric_build("serverless-local-030-1") and !mb_numeric_build("");
}
