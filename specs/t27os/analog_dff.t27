// SPDX-License-Identifier: Apache-2.0
// specs/t27os/analog_dff.t27 -- analog: dff levels row still NOT MODELLED --
// two Q levels 12.7 and 16.3 uV off nominal.
// Part of M1 (milestone #5). Closes #13077.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::analog_dff;

pub const DFF_Q_LEVEL_NOMINAL_UV : u32 = 15;

pub struct DffLevel { q_level_uv: u32, modelled: bool };

pub fn dff_level_modelled(d: DffLevel) -> bool {
    return d.modelled;
}

pub fn dff_level_nominal(d: DffLevel) -> bool {
    return d.q_level_uv == DFF_Q_LEVEL_NOMINAL_UV;
}

test "dff level modelled" {
    assert(dff_level_modelled(DffLevel { q_level_uv: 15, modelled: true }));
    assert(!dff_level_modelled(DffLevel { q_level_uv: 13, modelled: false }));
}

test "dff level nominal" {
    assert(dff_level_nominal(DffLevel { q_level_uv: 15, modelled: true }));
    assert(!dff_level_nominal(DffLevel { q_level_uv: 13, modelled: true }));
}

invariant dff_nominal_is_15 {
    assert DFF_Q_LEVEL_NOMINAL_UV == 15;
}