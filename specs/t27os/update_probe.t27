fn up_peek32(at: u64) -> u32 {
    var c : [4]u8 = undefined;
    sys_peek(c[0..4], at, 4);
    return @as(u32, c[0]) | (@as(u32, c[1]) << 8) | (@as(u32, c[2]) << 16) | (@as(u32, c[3]) << 24);
}

fn up_peek8(at: u64) -> u32 {
    var c : [1]u8 = undefined;
    sys_peek(c[0..1], at, 1);
    return @as(u32, c[0]);
}

fn up_say(s: []const u8) -> void { sys_write(1, s, @as(u64, s.len)); }

fn up_dec(v: u64) -> void {
    var d : [24]u8 = undefined;
    const n : usize = put_dec(d[0..24], 0, v);
    sys_write(1, d[0..n], @as(u64, n));
}

fn up_hex(b: []const u8, n: usize) -> void {
    var h : [512]u8 = undefined;
    var i : usize = 0;
    while (i < n) {
        const hi : u32 = @as(u32, b[i]) >> 4;
        const lo : u32 = @as(u32, b[i]) & 15;
        var c1 : u32 = 87 + hi;
        if (hi < 10) { c1 = 48 + hi; }
        var c2 : u32 = 87 + lo;
        if (lo < 10) { c2 = 48 + lo; }
        h[2 * i] = @as(u8, @intCast(c1));
        h[2 * i + 1] = @as(u8, @intCast(c2));
        i = i + 1;
    }
    sys_write(1, h[0..2 * n], @as(u64, 2 * n));
}

fn up_ok(label: []const u8, ok: bool) -> bool {
    if (ok) { up_say("PASS "); } else { up_say("FAIL "); }
    up_say(label);
    up_say("\n");
    return ok;
}

/// One table row: label, the code expected, the code got.
fn up_row(label: []const u8, want: u32, got: u32) -> bool {
    if (want == got) { up_say("PASS "); } else { up_say("FAIL "); }
    up_say(label);
    up_say(" | expect ");
    up_dec(@as(u64, want));
    up_say(" | got ");
    up_dec(@as(u64, got));
    up_say("\n");
    return want == got;
}

fn up_env(name: []const u8, out: []u8) -> usize {
    const p : u64 = sys_getenv(name);
    if (p == 0) { return 0; }
    var n : u64 = sys_strlen(p);
    if (n >= @as(u64, out.len)) { n = @as(u64, out.len - 1); }
    if (n > 0) { sys_peek(out[0..@as(usize, n)], p, n); }
    out[@as(usize, n)] = 0;
    return @as(usize, n);
}

fn up_env_num(name: []const u8, dflt: u64) -> u64 {
    var b : [24]u8 = undefined;
    const n : usize = up_env(name, b[0..24]);
    if (n == 0) { return dflt; }
    var v : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (b[i] < 48 or b[i] > 57) { return dflt; }
        v = v * 10 + @as(u64, b[i] - 48);
        i = i + 1;
    }
    return v;
}

/// UP_VERSION "a.b.c" into a packed version; fallback 0.1.3.
fn up_env_version() -> u64 {
    var b : [24]u8 = undefined;
    const n : usize = up_env("UP_VERSION", b[0..24]);
    var part : [3]u32 = undefined;
    part[0] = 0;
    part[1] = 1;
    part[2] = 3;
    if (n == 0) { return um_pack(0, 1, 3); }
    var k : usize = 0;
    var v : u32 = 0;
    var any : bool = false;
    var i : usize = 0;
    while (i <= n) {
        if (i == n or b[i] == 46) {
            if (any == false or k > 2) { return um_pack(0, 1, 3); }
            part[k] = v;
            k = k + 1;
            v = 0;
            any = false;
        } else if (b[i] >= 48 and b[i] <= 57) {
            v = v * 10 + @as(u32, b[i]) - 48;
            any = true;
        } else {
            return um_pack(0, 1, 3);
        }
        i = i + 1;
    }
    if (k != 3) { return um_pack(0, 1, 3); }
    return um_pack(part[0], part[1], part[2]);
}

fn up_now_ms() -> u64 {
    var tv : [16]u8 = undefined;
    sys_gettimeofday(tv[0..16], 0);
    return get_u64(tv[0..16], 0) * 1000 + (get_u64(tv[0..16], 8) & 4294967295) / 1000;
}

// ---------------------------------------------------------------- table

/// A throw-away identity in memory: the 207-byte identity buffer and its fingerprint.
fn up_identity(id: []u8, fp: []u8) -> bool {
    var priv : [97]u8 = undefined;
    var pubk : [65]u8 = undefined;
    if (ks_gen_pair(priv[0..97], pubk[0..65]) == false) { return false; }
    const nick : [1]u8 = [120];
    if (id_build(pubk[0..65], priv[0..97], nick[0..1], 1, id) != ID_LEN) { return false; }
    return ih_fingerprint(pubk[0..65], fp);
}

fn up_write_file(path: []const u8, bytes: usize, flip_at: usize) -> bool {
    const fd : i32 = sys_creat(path, 384);
    if (fd < 0) { return false; }
    var buf : [16384]u8 = undefined;
    var done : usize = 0;
    while (done < bytes) {
        var i : usize = 0;
        while (i < 16384) {
            buf[i] = @as(u8, @intCast(((done + i) * 7 + 13) & 255));
            i = i + 1;
        }
        var want : usize = bytes - done;
        if (want > 16384) { want = 16384; }
        if (flip_at >= done and flip_at < done + want) { buf[flip_at - done] = buf[flip_at - done] ^ 1; }
        const w : i64 = sys_write(fd, buf[0..want], @as(u64, want));
        if (w <= 0) {
            sys_close(fd);
            return false;
        }
        done = done + @as(usize, @intCast(w));
    }
    sys_close(fd);
    return true;
}

fn up_path(out: []u8) -> usize {
    var dir : [96]u8 = undefined;
    var dn : usize = up_env("UP_DIR", dir[0..96]);
    var n : usize = 0;
    if (dn == 0) {
        n = put_bytes(out, 0, "/tmp");
    } else {
        n = put_bytes(out, 0, dir[0..dn]);
    }
    n = put_bytes(out, n, "/t27os-update-probe.bin");
    out[n] = 0;
    return n;
}

fn up_table() -> bool {
    var all : bool = true;
    up_say("codes: 0 accepted | 1 manifest does not parse | 2 fingerprint is not the key's | 3 stranger | 4 rollback (build not newer)\n");
    up_say("       5 version below the running one | 6 size out of 1..200 MiB | 10 signature not true | 11 file does not match\n");
    var ida : [208]u8 = undefined;
    var fpa : [10]u8 = undefined;
    var idb : [208]u8 = undefined;
    var fpb : [10]u8 = undefined;
    var idc : [208]u8 = undefined;
    var fpc : [10]u8 = undefined;
    all = up_ok("three throw-away identities (A author, B friend's device, C stranger)", up_identity(ida[0..208], fpa[0..10]) and up_identity(idb[0..208], fpb[0..10]) and up_identity(idc[0..208], fpc[0..10])) and all;
    // B's friends table holds A; C is nobody's friend
    var ftb : [1108]u8 = undefined;
    var inv : [25]u8 = undefined;
    ft_init(ftb[0..1108]);
    invite_make(fpa[0..10], inv[0..25]);
    all = up_ok("B befriends A (invite string)", ft_add(ftb[0..1108], inv[0..25], fpb[0..10]) == FA_OK) and all;

    // the bundle: 2 MiB test file, its hash and size
    var path : [128]u8 = undefined;
    up_path(path[0..128]);
    const size : usize = 2097152;
    all = up_ok("2 MiB test file written", up_write_file(path[0..128], size, 99999999)) and all;
    var sha : [32]u8 = undefined;
    const got : i64 = uh_file_sha(path[0..128], sha[0..32]);
    all = up_ok("file SHA-256 read in chunks, size 2097152", got == 2097152) and all;
    up_say("file sha256 ");
    up_hex(sha[0..32], 32);
    up_say("\n");


    var ftc : [1108]u8 = undefined;
    ft_init(ftc[0..1108]);
    const cur_ver : u64 = um_pack(0, 1, 3);
    const cur_build : u32 = 4311;
    var m : [216]u8 = undefined;
    const mn : usize = uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 2097152, sha[0..32], m[0..216]);
    all = up_ok("A makes and signs a manifest (216 bytes)", mn == 216) and all;
    up_say("manifest ");
    up_hex(m[0..216], 216);
    up_say("\n");
    up_say("CASE | EXPECT | GOT\n");
    all = up_row("B checks A's manifest (friend, newer build, signature true)", 0, uh_check_manifest(m[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("A checks its own manifest (this device counts as known)", 0, uh_check_manifest(m[0..216], ftc[0..1108], fpa[0..10], cur_ver, cur_build)) and all;
    all = up_row("C with no friends checks A's manifest (stranger)", 3, uh_check_manifest(m[0..216], ftc[0..1108], fpc[0..10], cur_ver, cur_build)) and all;

    // one byte flipped in every region of the manifest
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 3, 1, "flip magic") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 8, 1, "flip format") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 12, 10, "flip major (0->1)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 16, 5, "flip minor (1->0, below running)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 20, 5, "flip patch (3->2, below running)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 24, 10, "flip build (4321->4320)") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 28, 10, "flip size") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 36, 10, "flip bundle hash") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 68, 2, "flip author fingerprint") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 78, 1, "flip public key prefix") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 100, 2, "flip a public key byte") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 143, 1, "flip signature length") and all;
    all = up_flip(m[0..216], ftb[0..1108], fpb[0..10], 150, 10, "flip a signature byte") and all;

    // a truncated manifest
    all = up_row("truncated manifest, 215 bytes", 1, uh_check_manifest(m[0..215], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("truncated manifest, 100 bytes", 1, uh_check_manifest(m[0..100], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("empty manifest", 1, uh_check_manifest(m[0..0], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // a stranger's own, perfectly signed manifest
    var mc : [216]u8 = undefined;
    all = up_ok("C makes and signs a manifest", uh_make_manifest(idc[0..208], 0, 1, 3, 4321, 2097152, sha[0..32], mc[0..216]) == 216) and all;
    all = up_row("B checks C's manifest (valid signature, author not a friend)", 3, uh_check_manifest(mc[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // C forges: A's key and fingerprint in the body, C's signature
    var fb : [143]u8 = undefined;
    var fi : [159]u8 = undefined;
    var fs : [128]u8 = undefined;
    var forged : [216]u8 = undefined;
    um_body(0, 1, 3, 4321, 2097152, sha[0..32], fpa[0..10], ida[ID_OFF_PUB..ID_OFF_PUB + 65], fb[0..143]);
    um_sign_input(fb[0..143], fi[0..159]);
    const fsn : usize = ks_sign(idc[ID_OFF_PRIV..ID_OFF_PRIV + 97], fi[0..159], fs[0..128]);
    all = up_ok("C signs A's body with C's key", fsn > 0 and um_seal(fb[0..143], fs[0..fsn], forged[0..216]) == 216) and all;
    all = up_row("B checks the forged manifest (A's name, C's signature)", 10, uh_check_manifest(forged[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // rollback: build-1 and the same build, both honestly signed by a friend
    var mr : [216]u8 = undefined;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build - 1, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with build-1 (4310 against 4311)", 4, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with the same build (4311 against 4311)", 4, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, cur_build + 1, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's manifest with build+1 (4312 against 4311)", 0, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 2, 9000, 2097152, sha[0..32], mr[0..216]);
    all = up_row("A's version 0.1.2 with build 9000 (version below 0.1.3)", 5, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;

    // size out of range, honestly signed
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 210763776, sha[0..32], mr[0..216]);
    all = up_row("size 201 MiB", 6, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 1048575, sha[0..32], mr[0..216]);
    all = up_row("size 1 MiB minus 1 byte", 6, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    uh_make_manifest(ida[0..208], 0, 1, 3, 4321, 209715200, sha[0..32], mr[0..216]);
    all = up_row("size exactly 200 MiB (the limit is allowed)", 0, uh_check_manifest(mr[0..216], ftb[0..1108], fpb[0..10], cur_ver, cur_build)) and all;
    all = up_row("manifest with build 0 is not even made (0 bytes)", 0, @as(u32, @intCast(uh_make_manifest(ida[0..208], 0, 1, 3, 0, 2097152, sha[0..32], mr[0..216])))) and all;

    // the file against the manifest (0 = the file is what the manifest says, 11 = it is not)
    all = up_row("bundle file matches the manifest (size and SHA-256)", 0, up_fcode(m[0..216], path[0..128])) and all;
    up_write_file(path[0..128], size, 1000000);
    all = up_row("one byte of the bundle changed after the manifest", 11, up_fcode(m[0..216], path[0..128])) and all;
    up_write_file(path[0..128], size - 1, 99999999);
    all = up_row("bundle one byte short", 11, up_fcode(m[0..216], path[0..128])) and all;
    sys_unlink(path[0..128]);
    all = up_row("bundle file missing", 11, up_fcode(m[0..216], path[0..128])) and all;

    // one update at a time
    var st : u32 = st_next(ST_IDLE, EV_START);
    all = up_row("start while idle -> fetching", ST_FETCHING, st) and all;
    all = up_row("second start while fetching is refused", ST_REJECT, st_next(st, EV_START)) and all;
    return all;
}

fn up_fcode(m: []const u8, path: []const u8) -> u32 {
    if (uh_file_matches(m, path)) { return 0; }
    return 11;
}

/// Flip one byte of the good manifest and say what the check makes of it.
fn up_flip(m: []const u8, ft: []const u8, own: []const u8, at: usize, want: u32, label: []const u8) -> bool {
    var t : [216]u8 = undefined;
    var i : usize = 0;
    while (i < 216) {
        t[i] = m[i];
        i = i + 1;
    }
    t[at] = t[at] ^ 1;
    return up_row(label, want, uh_check_manifest(t[0..216], ft, own, um_pack(0, 1, 3), 4311));
}

// ---------------------------------------------------------------- roles: announce / browse

fn up_print_name(e: u64) -> void {
    var nb : [64]u8 = undefined;
    var i : usize = 0;
    var n : usize = 0;
    while (i < 64) {
        nb[i] = @as(u8, @intCast(up_peek8(e + BE_NAME + i)));
        if (nb[i] == 0) { break; }
        n = n + 1;
        i = i + 1;
    }
    sys_write(1, nb[0..n], @as(u64, n));
}

fn up_poke(dst: u64, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }

fn up_poke_state(e: u64, v: u32) -> void {
    var c : [4]u8 = undefined;
    c[0] = @as(u8, @intCast(v & 255));
    c[1] = 0;
    c[2] = 0;
    c[3] = 0;
    up_poke(e + BE_STATE, c[0..4], 4);
}

fn up_run(announce: bool, browse: bool) -> bool {
    var all : bool = true;
    var nickb : [32]u8 = undefined;
    var nn : usize = up_env("UP_NICK", nickb[0..32]);
    if (nn == 0) {
        nickb[0] = 116;
        nickb[1] = 50;
        nickb[2] = 55;
        nickb[3] = 111;
        nickb[4] = 115;
        nn = 5;
    }
    if (nn > NICK_MAX) { nn = NICK_MAX; }
    const secs : u64 = up_env_num("UP_SECONDS", 8);
    const port : u32 = @as(u32, @intCast(up_env_num("UP_PORT", 47741)));
    const my_ver : u64 = up_env_version();
    const my_build : u32 = @as(u32, @intCast(up_env_num("UP_BUILD", 4321)));
    var rref : [8]u8 = undefined;
    var bref : [8]u8 = undefined;
    put_u64(rref[0..8], 0, 0);
    put_u64(bref[0..8], 0, 0);
    var res : [72]u8 = undefined;
    var block : [4112]u8 = undefined;
    var clo : [160]u8 = undefined;
    var refs : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 72) {
        res[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 4112) {
        block[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 160) {
        clo[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 256) {
        refs[i] = 0;
        i = i + 1;
    }
    const block_at : u64 = ih_addr(block[0..4112]);
    var fp : [10]u8 = undefined;
    var inv : [25]u8 = undefined;
    var txt0 : [96]u8 = undefined;
    var txt : [96]u8 = undefined;
    var txn : usize = 0;
    var name : [64]u8 = undefined;
    var code : u64 = 0;
    if (announce) {
        var id : [208]u8 = undefined;
        const r : u32 = ih_identity_open(nickb[0..32], nn, id[0..208], fp[0..10]);
        all = up_ok("identity opened (created or loaded)", r == IH_CREATED or r == IH_LOADED) and all;
        if (r != IH_CREATED and r != IH_LOADED) { return false; }
        invite_make(fp[0..10], inv[0..25]);
        up_say("MY INVITE ");
        sys_write(1, inv[0..25], 25);
        up_say("\n");
        const n0 : usize = txt_build(inv[0..25], port, nickb[0..32], nn, txt0[0..96]);
        txn = upd_txt_add(txt0[0..96], n0, up_part(my_ver, 2), up_part(my_ver, 1), up_part(my_ver, 0), my_build, txt[0..96]);
        all = up_ok("TXT record built with ver and build", n0 > 0 and txn > n0) and all;
        up_say("TXT announced (");
        up_dec(@as(u64, txn));
        up_say(" bytes): ver=");
        up_dec(@as(u64, up_part(my_ver, 2)));
        up_say(".");
        up_dec(@as(u64, up_part(my_ver, 1)));
        up_say(".");
        up_dec(@as(u64, up_part(my_ver, 0)));
        up_say(" build=");
        up_dec(@as(u64, my_build));
        up_say("\n");
        var nl : usize = up_env("UP_NAME", name[0..64]);
        if (nl == 0) {
            i = 0;
            while (i < nn) {
                name[i] = nickb[i];
                i = i + 1;
            }
            name[nn] = 0;
        }
        const rc : i32 = ih_register(rref[0..8], name[0..64], port, txt[0..96], txn, res[0..72]);
        all = up_ok("DNSServiceRegister taken", rc == 0) and all;
    }
    if (browse) {
        code = ih_resolve_closure(clo[0..160]);
        all = up_ok("libffi closure for the resolve callback", code != 0) and all;
        const bc : i32 = ih_browse(bref[0..8], block_at);
        all = up_ok("DNSServiceBrowse taken", bc == 0) and all;
    }
    const start : u64 = up_now_ms();
    const end : u64 = start + secs * 1000;
    var acked : bool = false;
    while (up_now_ms() < end) {
        if (announce) {
            ih_pump(get_u64(rref[0..8], 0), 0);
            if (up_peek32(ih_addr(res[0..72])) == 1) { acked = true; }
        }
        if (browse) {
            ih_pump(get_u64(bref[0..8], 0), 0);
            var k : usize = 0;
            while (k < BR_COUNT) {
                const e : u64 = ih_entry(block_at, k);
                const st : u32 = up_peek32(e + BE_STATE);
                const rs : u64 = get_u64(refs[0..256], k * 16);
                if (st == BS_NEW and rs == 0) {
                    var rb : [8]u8 = undefined;
                    if (ih_resolve(rb[0..8], e, code) == 0) {
                        put_u64(refs[0..256], k * 16, get_u64(rb[0..8], 0));
                        up_poke_state(e, BS_RESOLVING);
                    }
                }
                if (st == BS_RESOLVING and rs != 0) { ih_pump(rs, 0); }
                k = k + 1;
            }
        }
        ih_sleep_ms(40);
    }
    if (announce) {
        all = up_ok("announcement acknowledged by the daemon with error 0", acked and up_peek32(ih_addr(res[0..72]) + 4) == 0) and all;
    }
    var seen_ver : u32 = 0;
    if (browse) {
        var k2 : usize = 0;
        while (k2 < BR_COUNT) {
            const e : u64 = ih_entry(block_at, k2);
            const st : u32 = up_peek32(e + BE_STATE);
            if (st >= BS_RESOLVED) {
                up_say("SERVICE name=");
                up_print_name(e);
                up_say(" host=");
                var hb : [44]u8 = undefined;
                var h : usize = 0;
                var hl : usize = 0;
                while (h < 44) {
                    hb[h] = @as(u8, @intCast(up_peek8(e + BE_HOST + h)));
                    if (hb[h] == 0) { break; }
                    hl = hl + 1;
                    h = h + 1;
                }
                sys_write(1, hb[0..hl], @as(u64, hl));
                up_say(" port=");
                up_dec(@as(u64, up_peek32(e + BE_PORT)));
                var tb : [128]u8 = undefined;
                var z : usize = 0;
                while (z < 128) {
                    tb[z] = @as(u8, @intCast(up_peek8(e + BE_TXT + z)));
                    z = z + 1;
                }
                const tl : usize = @as(usize, up_peek32(e + BE_TXTLEN));
                const nv : u64 = upd_txt_version(tb[0..128], tl);
                const nb2 : u32 = upd_txt_build(tb[0..128], tl);
                up_say(" txt_len=");
                up_dec(@as(u64, tl));
                if (nv == NO_VERSION) {
                    up_say(" ver=NONE");
                } else {
                    up_say(" ver=");
                    up_dec(@as(u64, up_part(nv, 2)));
                    up_say(".");
                    up_dec(@as(u64, up_part(nv, 1)));
                    up_say(".");
                    up_dec(@as(u64, up_part(nv, 0)));
                    seen_ver = seen_ver + 1;
                }
                up_say(" build=");
                if (nb2 == 0) { up_say("NONE"); } else { up_dec(@as(u64, nb2)); }
                if (upd_neighbour_newer(tb[0..128], tl, my_ver, my_build)) { up_say(" NEWER_THAN_ME"); }
                up_say("\n");
            }
            k2 = k2 + 1;
        }
        up_say("services resolved with ver and build: ");
        up_dec(@as(u64, seen_ver));
        up_say("\n");
        all = up_ok("at least one service shows ver and build in its TXT", seen_ver > 0) and all;
    }
    var q2 : usize = 0;
    while (q2 < BR_COUNT) {
        ih_free(get_u64(refs[0..256], q2 * 16));
        q2 = q2 + 1;
    }
    ih_free(get_u64(bref[0..8], 0));
    ih_free(get_u64(rref[0..8], 0));
    return all;
}

/// part 2 = major, 1 = minor, 0 = patch of a packed version
fn up_part(v: u64, which: u32) -> u32 {
    if (which == 2) { return @as(u32, @intCast((v >> 40) & 1048575)); }
    if (which == 1) { return @as(u32, @intCast((v >> 20) & 1048575)); }
    return @as(u32, @intCast(v & 1048575));
}

// ---------------------------------------------------------------- part 2: xfer (driver) and serve (second process)

const UP_XPORT : u64 = 47790;
const UP_NO_FLIP : u64 = 18446744073709551615;

/// base[0..bn] + suffix, NUL-terminated, into out; the length.
fn up_at(base: []const u8, bn: usize, suffix: []const u8, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, base[0..bn]);
    n = put_bytes(out, n, suffix);
    out[n] = 0;
    return n;
}


fn up_rm(path: []const u8) -> bool {
    var a : [600]u8 = undefined;
    var p : usize = uh_arg(a[0..600], 0, "/bin/rm");
    p = uh_arg(a[0..600], p, "-rf");
    p = uh_arg(a[0..600], p, path);
    return uh_run(a[0..p], 3) == 0;
}

fn up_ditto(from: []const u8, to: []const u8) -> bool {
    var a : [600]u8 = undefined;
    var p : usize = uh_arg(a[0..600], 0, "/usr/bin/ditto");
    p = uh_arg(a[0..600], p, from);
    p = uh_arg(a[0..600], p, to);
    return uh_run(a[0..p], 3) == 0;
}

fn up_zip(app: []const u8, zip: []const u8) -> bool {
    var a : [600]u8 = undefined;
    var p : usize = uh_arg(a[0..600], 0, "/usr/bin/ditto");
    p = uh_arg(a[0..600], p, "-c");
    p = uh_arg(a[0..600], p, "-k");
    p = uh_arg(a[0..600], p, "--keepParent");
    p = uh_arg(a[0..600], p, app);
    p = uh_arg(a[0..600], p, zip);
    return uh_run(a[0..p], 6) == 0;
}

fn up_exists(path: []const u8) -> bool {
    const fd : i32 = sys_open_ro(path, 0);
    if (fd < 0) { return false; }
    sys_close(fd);
    return true;
}

fn up_put_file(path: []const u8, b: []const u8, n: usize, mode: u32) -> bool {
    const fd : i32 = sys_creat(path, mode);
    if (fd < 0) { return false; }
    var put : usize = 0;
    while (put < n) {
        const w : i64 = sys_write(fd, b[put..n], @as(u64, n - put));
        if (w <= 0) {
            sys_close(fd);
            return false;
        }
        put = put + @as(usize, @intCast(w));
    }
    sys_close(fd);
    return true;
}

/// A fake app under dir: dir/T27OS.app with Contents/Info.plist (id, CFBundleVersion = build, CFBundleExecutable
/// T27OS), Contents/MacOS/T27OS (a shell script that exits with code) and 1.5 MiB of random bytes in
/// Contents/Resources/blob.bin, then dir/b.zip made by ditto -c -k --keepParent. true when all of it was written.
fn up_fake_app(dir: []const u8, dn: usize, id: []const u8, build: u32, code: u32) -> bool {
    var p : [256]u8 = undefined;
    var ok : bool = true;
    up_at(dir, dn, "", p[0..256]);
    ok = sys_mkdir(p[0..256], 493) == 0 and ok;
    up_at(dir, dn, "/T27OS.app", p[0..256]);
    ok = sys_mkdir(p[0..256], 493) == 0 and ok;
    up_at(dir, dn, "/T27OS.app/Contents", p[0..256]);
    ok = sys_mkdir(p[0..256], 493) == 0 and ok;
    up_at(dir, dn, "/T27OS.app/Contents/MacOS", p[0..256]);
    ok = sys_mkdir(p[0..256], 493) == 0 and ok;
    up_at(dir, dn, "/T27OS.app/Contents/Resources", p[0..256]);
    ok = sys_mkdir(p[0..256], 493) == 0 and ok;
    var t : [1024]u8 = undefined;
    var n : usize = put_bytes(t[0..1024], 0, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict>\n<key>CFBundleExecutable</key><string>T27OS</string>\n<key>CFBundleIdentifier</key><string>");
    n = put_bytes(t[0..1024], n, id);
    n = put_bytes(t[0..1024], n, "</string>\n<key>CFBundleVersion</key><string>");
    n = put_dec(t[0..1024], n, @as(u64, build));
    n = put_bytes(t[0..1024], n, "</string>\n<key>CFBundlePackageType</key><string>APPL</string>\n</dict></plist>\n");
    up_at(dir, dn, "/T27OS.app/Contents/Info.plist", p[0..256]);
    ok = up_put_file(p[0..256], t[0..1024], n, 420) and ok;
    n = put_bytes(t[0..1024], 0, "#!/bin/sh\nexit ");
    n = put_dec(t[0..1024], n, @as(u64, code));
    t[n] = 10;
    n = n + 1;
    up_at(dir, dn, "/T27OS.app/Contents/MacOS/T27OS", p[0..256]);
    ok = up_put_file(p[0..256], t[0..1024], n, 493) and ok;
    up_at(dir, dn, "/T27OS.app/Contents/Resources/blob.bin", p[0..256]);
    const fd : i32 = sys_creat(p[0..256], 420);
    if (fd < 0) { return false; }
    var buf : [16384]u8 = undefined;
    var k : usize = 0;
    while (k < 96) {
        sys_random(buf[0..16384], 16384);
        if (sys_write(fd, buf[0..16384], 16384) != 16384) { ok = false; }
        k = k + 1;
    }
    sys_close(fd);
    var z : [256]u8 = undefined;
    up_at(dir, dn, "/T27OS.app", p[0..256]);
    up_at(dir, dn, "/b.zip", z[0..256]);
    return up_zip(p[0..256], z[0..256]) and ok;
}

/// The manifest of dir/b.zip signed by id, written to dir/m.bin and kept in m.
fn up_fake_manifest(dir: []const u8, dn: usize, id: []const u8, build: u32, m: []u8) -> bool {
    var z : [256]u8 = undefined;
    up_at(dir, dn, "/b.zip", z[0..256]);
    var sha : [32]u8 = undefined;
    const size : i64 = uh_file_sha(z[0..256], sha[0..32]);
    if (size <= 0) { return false; }
    if (uh_make_manifest(id, 0, 1, 3, build, @as(u64, @intCast(size)), sha[0..32], m) != 216) { return false; }
    var p : [256]u8 = undefined;
    up_at(dir, dn, "/m.bin", p[0..256]);
    return up_put_file(p[0..256], m, 216, 420);
}

fn up_word(p: u64) -> u64 {
    var b : [8]u8 = undefined;
    sys_peek(b[0..8], p, 8);
    return get_u64(b[0..8], 0);
}

fn up_setenv_num(name: []const u8, v: u64) -> void {
    var d : [24]u8 = undefined;
    const n : usize = put_dec(d[0..24], 0, v);
    d[n] = 0;
    sys_setenv(name, d[0..24], 1);
}

/// Start this program again as UP_ROLE=serve for the bundle in dir; wait until it listens. Its pid, 0 on failure.
fn up_spawn_server(dir: []const u8, dn: usize, cut: u64, flip: u64) -> u32 {
    var mp : [256]u8 = undefined;
    var zp : [256]u8 = undefined;
    var rp : [256]u8 = undefined;
    up_at(dir, dn, "/m.bin", mp[0..256]);
    up_at(dir, dn, "/b.zip", zp[0..256]);
    up_at(dir, dn, "/ready", rp[0..256]);
    sys_unlink(rp[0..256]);
    sys_setenv("UP_ROLE", "serve", 1);
    sys_setenv("UP_SRV_M", mp[0..256], 1);
    sys_setenv("UP_SRV_ZIP", zp[0..256], 1);
    sys_setenv("UP_SRV_READY", rp[0..256], 1);
    up_setenv_num("UP_CUT_AT", cut);
    up_setenv_num("UP_FLIP_AT", flip);
    up_setenv_num("UP_SECONDS", 60);
    var eb : [1024]u8 = undefined;
    var sz : [2]u32 = undefined;
    sz[0] = 1024;
    sz[1] = 0;
    if (sys_exe_path(eb[0..1024], sz) != 0) { return 0; }
    var argv : [8]u64 = undefined;
    var i : usize = 0;
    while (i < 8) {
        argv[i] = 0;
        i = i + 1;
    }
    argv[0] = sys_addr(eb[0..1024], eb[0..1], 0);
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    pid[1] = 0;
    const rc : i32 = sys_spawn(pid, eb[0..1024], 0, 0, argv, up_word(sys_environ()));
    sys_setenv("UP_ROLE", "xfer", 1);
    if (rc != 0 or pid[0] == 0) { return 0; }
    var w : u32 = 0;
    while (w < 100) {
        if (up_exists(rp[0..256])) { return pid[0]; }
        ih_sleep_ms(50);
        w = w + 1;
    }
    up_stop(pid[0]);
    return 0;
}

fn up_stop(pid: u32) -> void {
    if (pid == 0) { return; }
    sys_kill(@as(i32, @intCast(pid)), 15);
    var st : [2]u32 = undefined;
    st[0] = 0;
    sys_waitpid(@as(i32, @intCast(pid)), st, 0);
}

/// The server process: serve the manifest file and the bundle on 127.0.0.1:UP_PORT for UP_SECONDS.
fn up_serve() -> bool {
    sys_signal(13, 1);
    var mp : [256]u8 = undefined;
    var zp : [256]u8 = undefined;
    var rp : [256]u8 = undefined;
    up_env("UP_SRV_M", mp[0..256]);
    up_env("UP_SRV_ZIP", zp[0..256]);
    up_env("UP_SRV_READY", rp[0..256]);
    var m : [216]u8 = undefined;
    const fd : i32 = sys_open_ro(mp[0..256], 0);
    if (fd < 0 or sys_read(fd, m[0..216], 216) != 216) {
        up_say("  server: no manifest\n");
        return false;
    }
    sys_close(fd);
    var cut : u64 = up_env_num("UP_CUT_AT", 0);
    var flip : u64 = up_env_num("UP_FLIP_AT", 0);
    if (flip == 0) { flip = UP_NO_FLIP; }
    const port : u64 = up_env_num("UP_PORT", UP_XPORT);
    const secs : u64 = up_env_num("UP_SECONDS", 60);
    const lfd : i32 = uh_listen(UH_LOOPBACK, port);
    if (lfd < 0) {
        up_say("  server: cannot listen\n");
        return false;
    }
    var rb : [1]u8 = undefined;
    up_put_file(rp[0..256], rb[0..1], 0, 420);
    const end : u64 = up_now_ms() + secs * 1000;
    var st : [2]u64 = undefined;
    while (up_now_ms() < end) {
        st[0] = 0;
        st[1] = 0;
        const code : u32 = uh_serve_one(lfd, m[0..216], zp[0..256], cut, flip, 500, st[0..2]);
        if (code != US_IDLE) {
            up_say("    server: answer ");
            up_dec(@as(u64, code));
            up_say(" (1 manifest, 2 bundle, 3 refused, 4 cut, 5 io) from offset ");
            up_dec(st[1]);
            up_say(", bundle bytes sent ");
            up_dec(st[0]);
            up_say("\n");
        }
        if (code == US_CUT) { cut = 0; }
    }
    sys_close(lfd);
    return true;
}

/// Put the baseline app (build 100) back as the live copy: X/inst emptied, X/s100/T27OS.app copied to X/inst/T27OS.app.
fn up_reset_inst(x: []const u8, xn: usize) -> bool {
    var p : [256]u8 = undefined;
    var q : [256]u8 = undefined;
    up_at(x, xn, "/inst", p[0..256]);
    up_rm(p[0..256]);
    if (sys_mkdir(p[0..256], 493) != 0) { return false; }
    up_at(x, xn, "/s100/T27OS.app", q[0..256]);
    up_at(x, xn, "/inst/T27OS.app", p[0..256]);
    return up_ditto(q[0..256], p[0..256]);
}

fn up_build_at(x: []const u8, xn: usize, suffix: []const u8) -> u32 {
    var p : [256]u8 = undefined;
    const n : usize = up_at(x, xn, suffix, p[0..256]);
    var pl : [384]u8 = undefined;
    var ln : [3]u64 = undefined;
    if (uh_plist(p[0..256], n, pl[0..384], ln[0..3]) == false) { return 0; }
    return ui_build_text(pl[128..256], @as(usize, @intCast(ln[1])));
}

// what is on disk after a case
const LV_BUILD : usize = 0;
const LV_HEALTH : usize = 1;
const LV_PREV : usize = 2;
const LV_NEW : usize = 3;
const LV_LOCK : usize = 4;

fn up_live(x: []const u8, xn: usize, lv: []u32) -> void {
    var p : [256]u8 = undefined;
    lv[LV_BUILD] = up_build_at(x, xn, "/inst/T27OS.app");
    const n : usize = up_at(x, xn, "/inst/T27OS.app", p[0..256]);
    lv[LV_HEALTH] = 0;
    if (uh_health(p[0..256], n, UH_HEALTH_RUN)) { lv[LV_HEALTH] = 1; }
    lv[LV_PREV] = up_build_at(x, xn, "/inst/T27OS.app.prev");
    lv[LV_NEW] = 0;
    up_at(x, xn, "/inst/T27OS.app.new", p[0..256]);
    if (up_exists(p[0..256])) { lv[LV_NEW] = 1; }
    lv[LV_LOCK] = 0;
    up_at(x, xn, "/inst/T27OS.app.lock", p[0..256]);
    if (up_exists(p[0..256])) { lv[LV_LOCK] = 1; }
}

fn up_got(res: []const u32, st: []const u64, lv: []const u32) -> void {
    up_say("      got: state ");
    up_dec(@as(u64, res[UR_STATE]));
    up_say(" why ");
    up_dec(@as(u64, res[UR_WHY]));
    up_say(" offer ");
    up_dec(@as(u64, res[UR_OFFER]));
    up_say(" fetch ");
    up_dec(@as(u64, res[UR_FETCH]));
    up_say(" step ");
    up_dec(@as(u64, res[UR_STEP]));
    up_say(" undo ");
    up_dec(@as(u64, res[UR_UNDO]));
    up_say(" bundle ");
    up_dec(@as(u64, res[UR_BUNDLE]));
    up_say(" | bytes ");
    up_dec(st[FS_BYTES]);
    up_say(" chunks ");
    up_dec(st[FS_CHUNKS]);
    up_say(" conns ");
    up_dec(st[FS_CONNS]);
    up_say(" last-from ");
    up_dec(st[FS_FROM]);
    up_say(" resumed-from ");
    up_dec(st[FS_RESUMED]);
    up_say("\n      live: build ");
    up_dec(@as(u64, lv[LV_BUILD]));
    if (lv[LV_HEALTH] == 1) { up_say(" runs (exit 0)"); } else { up_say(" DOES NOT RUN"); }
    up_say(" | .prev build ");
    up_dec(@as(u64, lv[LV_PREV]));
    up_say(" | .new left ");
    up_dec(@as(u64, lv[LV_NEW]));
    up_say(" | lock left ");
    up_dec(@as(u64, lv[LV_LOCK]));
    var t : [64]u8 = undefined;
    const tn : usize = fr_text(res[UR_WHY], t[0..64]);
    up_say(" | says \"");
    sys_write(1, t[0..tn], @as(u64, tn));
    up_say("\"\n");
}

fn up_case_row(label: []const u8, expect: []const u8, ok: bool) -> bool {
    if (ok) { up_say("PASS "); } else { up_say("FAIL "); }
    up_say(label);
    up_say(" | expect ");
    up_say(expect);
    up_say("\n");
    return ok;
}

fn up_zero(st: []u64, res: []u32) -> void {
    var i : usize = 0;
    while (i < st.len) {
        st[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < res.len) {
        res[i] = 0;
        i = i + 1;
    }
}

/// The settings slice of uh_update for one case: the running build, retry (1/0), the step to fail (0 none).
fn up_cfg(cfg: []u64, build: u64, retry: u64, fail_at: u64) -> void {
    cfg[UC_BUILD] = build;
    cfg[UC_RETRY] = retry;
    cfg[UC_FAIL_AT] = fail_at;
}

fn up_xfer() -> bool {
    var all : bool = true;
    var x : [128]u8 = undefined;
    var xn : usize = up_env("UP_XDIR", x[0..128]);
    if (xn == 0) { xn = put_bytes(x[0..128], 0, "/tmp/updtest"); }
    x[xn] = 0;
    if (xn < 6 or x[0] != 47 or x[1] != 116 or x[2] != 109 or x[3] != 112 or x[4] != 47) {
        up_say("UP_XDIR must be under /tmp/\n");
        return false;
    }
    up_rm(x[0..128]);
    all = up_ok("test directory made", sys_mkdir(x[0..128], 493) == 0) and all;
    var ida : [208]u8 = undefined;
    var fpa : [10]u8 = undefined;
    var idb : [208]u8 = undefined;
    var fpb : [10]u8 = undefined;
    all = up_ok("two throw-away identities (A author, B this device)", up_identity(ida[0..208], fpa[0..10]) and up_identity(idb[0..208], fpb[0..10])) and all;
    var ftb : [1108]u8 = undefined;
    var fte : [1108]u8 = undefined;
    var inv : [25]u8 = undefined;
    ft_init(ftb[0..1108]);
    ft_init(fte[0..1108]);
    invite_make(fpa[0..10], inv[0..25]);
    all = up_ok("B befriends A", ft_add(ftb[0..1108], inv[0..25], fpb[0..10]) == FA_OK) and all;
    // the bundles
    var d : [192]u8 = undefined;
    var dn : usize = up_at(x[0..128], xn, "/s100", d[0..192]);
    all = up_ok("baseline app build 100 (ai.t27.os) made", up_fake_app(d[0..192], dn, "ai.t27.os", 100, 0)) and all;
    var m200 : [216]u8 = undefined;
    var m201 : [216]u8 = undefined;
    var m202 : [216]u8 = undefined;
    var d200 : [192]u8 = undefined;
    var d201 : [192]u8 = undefined;
    var d202 : [192]u8 = undefined;
    const n200 : usize = up_at(x[0..128], xn, "/s200", d200[0..192]);
    const n201 : usize = up_at(x[0..128], xn, "/s201", d201[0..192]);
    const n202 : usize = up_at(x[0..128], xn, "/s202", d202[0..192]);
    all = up_ok("bundle build 200 (good) zipped and signed by A", up_fake_app(d200[0..192], n200, "ai.t27.os", 200, 0) and up_fake_manifest(d200[0..192], n200, ida[0..208], 200, m200[0..216])) and all;
    all = up_ok("bundle build 201 (its executable exits 3) zipped and signed by A", up_fake_app(d201[0..192], n201, "ai.t27.os", 201, 3) and up_fake_manifest(d201[0..192], n201, ida[0..208], 201, m201[0..216])) and all;
    all = up_ok("bundle build 202 (another app, com.example.other) zipped and signed by A", up_fake_app(d202[0..192], n202, "com.example.other", 202, 0) and up_fake_manifest(d202[0..192], n202, ida[0..208], 202, m202[0..216])) and all;
    const size : u64 = get_u64(m200[0..216], 28);
    up_say("bundle 200: ");
    up_dec(size);
    up_say(" bytes, sha256 ");
    up_hex(m200[UM_OFF_SHA..UM_OFF_SHA + 32], 32);
    up_say("\n");
    var app : [192]u8 = undefined;
    const an : usize = up_at(x[0..128], xn, "/inst/T27OS.app", app[0..192]);
    var inst : [192]u8 = undefined;
    const inn : usize = up_at(x[0..128], xn, "/inst", inst[0..192]);
    const cv : u64 = um_pack(0, 1, 3);
    const port : u64 = up_env_num("UP_PORT", UP_XPORT);
    sys_setenv("UP_PORT", "47790", 0);
    var res : [8]u32 = undefined;
    var st : [8]u64 = undefined;
    var cfg : [7]u64 = undefined;
    cfg[0] = UH_LOOPBACK;
    cfg[1] = port;
    cfg[2] = cv;
    cfg[5] = UH_HEALTH_RUN;
    var lv : [5]u32 = undefined;
    var pid : u32 = 0;
    var ok : bool = false;
    const cut : u64 = 900000;
    const whole : u64 = (cut / 65536) * 65536;
    up_say("CASE | EXPECT | GOT\n");

    // 1 success
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("1 success: friend's build 200 over build 100", "done, live 200 runs, .prev 100, all bytes in 64 KiB chunks", ok and res[UR_STATE] == ST_DONE and lv[LV_BUILD] == 200 and lv[LV_HEALTH] == 1 and lv[LV_PREV] == 100 and lv[LV_NEW] == 0 and lv[LV_LOCK] == 0 and st[FS_BYTES] == size and st[FS_CHUNKS] == (size + 65535) / 65536) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 2 one flipped byte on the wire
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, 0, 700000);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    var part : [256]u8 = undefined;
    ui_part_path(inst[0..192], inn, m200[UM_OFF_SHA..UM_OFF_SHA + 32], part[0..256]);
    all = up_case_row("2 one byte flipped in transit (offset 700000)", "failed: hash (3), nothing installed, live 100 runs, part removed", ok == false and res[UR_STATE] == ST_FAILED and res[UR_WHY] == 3 and res[UR_FETCH] == 2 and lv[LV_BUILD] == 100 and lv[LV_HEALTH] == 1 and lv[LV_PREV] == 0 and up_exists(part[0..256]) == false) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 3 connection cut in the middle, resumed in the same run
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, cut, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("3 server cuts the connection after 900000 bytes, client resumes", "done, 2 connections, resumed from the last whole chunk, live 200", ok and res[UR_STATE] == ST_DONE and st[FS_CONNS] == 2 and st[FS_RESUMED] == whole and st[FS_BYTES] == size and lv[LV_BUILD] == 200 and lv[LV_HEALTH] == 1) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 4 cut, the client gives up (no retry), a later run resumes from the part on disk
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, cut, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 0, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    var sha : [32]u8 = undefined;
    const kept : i64 = uh_file_sha(part[0..256], sha[0..32]);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("4a cut, no retry: the run stops", "failed: net (2), part kept with the whole chunks, live 100 runs", ok == false and res[UR_STATE] == ST_FAILED and res[UR_WHY] == 2 and kept == @as(i64, @intCast(whole)) and lv[LV_BUILD] == 100 and lv[LV_HEALTH] == 1) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);
    up_say("      part on disk: ");
    if (kept >= 0) { up_dec(@as(u64, @intCast(kept))); } else { up_say("none"); }
    up_say(" bytes\n");
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("4b a new run resumes from the part", "done, one connection from the part's size, only the rest fetched, live 200", ok and res[UR_STATE] == ST_DONE and st[FS_CONNS] == 1 and st[FS_FROM] == whole and st[FS_BYTES] == size - whole and lv[LV_BUILD] == 200 and lv[LV_HEALTH] == 1 and up_exists(part[0..256]) == false) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 5 a stranger's bundle: B does not know A
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], fte[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("5 bundle from an author who is not a friend", "refused before download: offer 3, no bundle connection, live 100", ok == false and res[UR_STATE] == ST_FAILED and res[UR_WHY] == 1 and res[UR_OFFER] == 3 and st[FS_CONNS] == 0 and st[FS_BYTES] == 0 and lv[LV_BUILD] == 100) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 6 a lower build than the running one
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 300, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("6 build 200 offered to a device on build 300", "refused before download: offer 4 (rollback), no bundle connection", ok == false and res[UR_OFFER] == 4 and st[FS_CONNS] == 0 and st[FS_BYTES] == 0 and lv[LV_BUILD] == 100) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 7 another app's bundle, honestly signed, hash true
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d202[0..192], n202, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("7 bundle of another app (com.example.other)", "failed at check: bundle 2 (id), undo clean, live 100 untouched, no .prev", ok == false and res[UR_WHY] == 5 and res[UR_STEP] == 2 and res[UR_BUNDLE] == 2 and res[UR_UNDO] == 1 and lv[LV_BUILD] == 100 and lv[LV_HEALTH] == 1 and lv[LV_PREV] == 0 and lv[LV_NEW] == 0) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 8 the new build fails its health check after the swap: rollback
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d201[0..192], n201, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("8 build 201 is installed and fails its health check", "failed: health (7), undo swap back (3), live 100 runs again", ok == false and res[UR_STATE] == ST_FAILED and res[UR_WHY] == 7 and res[UR_STEP] == 5 and res[UR_UNDO] == 3 and lv[LV_BUILD] == 100 and lv[LV_HEALTH] == 1 and lv[LV_NEW] == 0) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 9 the rename of the new copy fails (test aid): the old copy is put back
    up_reset_inst(x[0..128], xn);
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 4);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("9 moving the new copy in fails after the old one moved out", "failed: move (6), undo restore (2), live 100 runs", ok == false and res[UR_WHY] == 6 and res[UR_STEP] == 4 and res[UR_UNDO] == 2 and lv[LV_BUILD] == 100 and lv[LV_HEALTH] == 1 and lv[LV_NEW] == 0) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);

    // 10 a second update while one holds the lock
    up_reset_inst(x[0..128], xn);
    var lk : [256]u8 = undefined;
    up_at(x[0..128], xn, "/inst/T27OS.app.lock", lk[0..256]);
    sys_mkdir(lk[0..256], 448);
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    up_zero(st[0..8], res[0..8]);
    up_cfg(cfg[0..7], 100, 1, 0);
    ok = uh_update(cfg[0..7], ftb[0..1108], fpb[0..10], app[0..an], res[0..8], st[0..8], app[0..0]);
    up_stop(pid);
    up_live(x[0..128], xn, lv[0..5]);
    all = up_case_row("10 another update holds the lock", "busy (8), nothing fetched, live 100; in-process: a second start is refused", ok == false and res[UR_WHY] == 8 and st[FS_CONNS] == 0 and lv[LV_BUILD] == 100 and st_next(ST_FETCHING, EV_START) == ST_REJECT) and all;
    up_got(res[0..8], st[0..8], lv[0..5]);
    up_rm(lk[0..256]);

    // 11 a request for a bundle the server does not have (another hash)
    pid = up_spawn_server(d200[0..192], n200, 0, 0);
    var mx : [216]u8 = undefined;
    var i : usize = 0;
    while (i < 216) {
        mx[i] = m200[i];
        i = i + 1;
    }
    mx[UM_OFF_SHA + 5] = mx[UM_OFF_SHA + 5] ^ 1;
    var p2 : [256]u8 = undefined;
    up_at(x[0..128], xn, "/inst/x.part", p2[0..256]);
    up_zero(st[0..8], res[0..8]);
    const fc : u32 = uh_fetch_once(UH_LOOPBACK, port, mx[0..216], p2[0..256], st[0..8]);
    up_stop(pid);
    all = up_case_row("11 bundle request with a hash the server does not serve", "refused by the server: status 2 (not here), 0 bytes", fc == UF_REFUSED and st[FS_STATUS] == 2 and st[FS_BYTES] == 0) and all;
    up_say("      got: fetch ");
    up_dec(@as(u64, fc));
    up_say(" status ");
    up_dec(st[FS_STATUS]);
    up_say(" bytes ");
    up_dec(st[FS_BYTES]);
    up_say("\n");
    return all;
}

fn up_getpid() -> i32 { return @extern("getpid"); }

fn up_utimes(path: []const u8, tv: []const u8) -> i32 { return @extern("utimes"); }

/// Set the modification time of path to `ago` seconds before now (a test aid).
fn up_age(path: []const u8, ago: u64) -> bool {
    const t : u64 = uh_now_s() - ago;
    var tv : [32]u8 = undefined;
    var i : usize = 0;
    while (i < 32) {
        tv[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 8) {
        tv[i] = @as(u8, @intCast((t >> @as(u6, @intCast(8 * i))) & 255));
        tv[16 + i] = tv[i];
        i = i + 1;
    }
    return up_utimes(path, tv[0..32]) == 0;
}

fn up_put(path: []const u8, b: []const u8, n: usize) -> bool {
    const fd : i32 = sys_creat(path, 420);
    if (fd < 0) { return false; }
    const ok : bool = uh_write_full(fd, b, n);
    sys_close(fd);
    return ok;
}

/// UP_ROLE=lock: a lock left by a dead update goes after ten minutes and not before (needs the OS: stat, utimes, kill).
fn up_lock_case() -> bool {
    var all : bool = true;
    // "/tmp/t27uh-lock-test.app" (24 bytes)
    const app : [24]u8 = [47, 116, 109, 112, 47, 116, 50, 55, 117, 104, 45, 108, 111, 99, 107, 45, 116, 101, 115, 116, 46, 97, 112, 112];
    var lk : [64]u8 = undefined;
    var pf : [64]u8 = undefined;
    ui_join(app[0..24], 24, ".lock", lk[0..64]);
    ui_join(app[0..24], 24, ".lock/pid", pf[0..64]);
    uh_unlock(app[0..24], 24);
    var info : [5]u64 = undefined;
    all = up_ok("uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_NONE and info[LK_EXISTS] == 0", uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_NONE and info[LK_EXISTS] == 0) and all;
    // taken by this process: its pid is in the file and it runs, so the lock stays whatever its age
    all = up_ok("uh_lock(app[0..24], 24)", uh_lock(app[0..24], 24)) and all;
    all = up_ok("uh_lock(app[0..24], 24) == false", uh_lock(app[0..24], 24) == false) and all;
    all = up_ok("up_age(lk[0..64], 3600)", up_age(lk[0..64], 3600)) and all;
    all = up_ok("uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_KEEP_ALIVE", uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_KEEP_ALIVE) and all;
    all = up_ok("info[LK_OWNER] == @as(u64, @intCast(up_getpid())) and info[LK_ALIVE] == 1 and info[LK_AGE]", info[LK_OWNER] == @as(u64, @intCast(up_getpid())) and info[LK_ALIVE] == 1 and info[LK_AGE] >= 3599) and all;
    // the owner is a pid that does not run: kept while young, removed once older than 10 minutes
    const dead : [6]u8 = [57, 57, 57, 57, 57, 10];
    all = up_ok("uh_pid_alive(99999) == false", uh_pid_alive(99999) == false) and all;
    all = up_ok("up_put(pf[0..64], dead[0..6], 6)", up_put(pf[0..64], dead[0..6], 6)) and all;
    all = up_ok("up_age(lk[0..64], 120)", up_age(lk[0..64], 120)) and all;
    all = up_ok("uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_KEEP_FRESH and info[LK_REMOVED", uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_KEEP_FRESH and info[LK_REMOVED] == 0) and all;
    all = up_ok("uh_mtime(lk[0..64]) > 0", uh_mtime(lk[0..64]) > 0) and all;
    all = up_ok("up_age(lk[0..64], 660)", up_age(lk[0..64], 660)) and all;
    all = up_ok("uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_REMOVE", uh_lock_sweep(app[0..24], 24, uh_now_s(), info[0..5]) == UK_REMOVE) and all;
    all = up_ok("info[LK_REMOVED] == 1 and info[LK_OWNER] == 99999 and info[LK_AGE] >= 659", info[LK_REMOVED] == 1 and info[LK_OWNER] == 99999 and info[LK_AGE] >= 659) and all;
    all = up_ok("uh_mtime(lk[0..64]) < 0", uh_mtime(lk[0..64]) < 0) and all;
    // a new update takes it again at once
    all = up_ok("uh_lock(app[0..24], 24)", uh_lock(app[0..24], 24)) and all;
    // the window's own helper ended: its lock is released only by its own pid
    all = up_ok("uh_lock_release_of(app[0..24], 24, 99999) == false", uh_lock_release_of(app[0..24], 24, 99999) == false) and all;
    all = up_ok("uh_lock_release_of(app[0..24], 24, @as(u32, @intCast(up_getpid())))", uh_lock_release_of(app[0..24], 24, @as(u32, @intCast(up_getpid())))) and all;
    all = up_ok("uh_mtime(lk[0..64]) < 0", uh_mtime(lk[0..64]) < 0) and all;
    return all;
}

/// UP_ROLE=offer: a neighbour that runs a newer build, as the app sees one. The bundle at UP_APP (an absolute .app path;
/// its Info.plist names the build) is zipped by uh_zip_app into $UP_DIR/t27os-offer.zip and its manifest signed with the
/// identity under $HOME/.t27os (run it with the HOME of the app under test: the author is then "this device"); the
/// probe listens on 127.0.0.1 at a free port and registers _t27call._udp as UP_NAME (default upd-probe) with TXT
/// fp/port/nick + ver/build + up=<that port>, then answers requests for UP_SECONDS (default 120). Prints each answer.
/// Passes when everything was set up and, with UP_EXPECT=1, at least one whole bundle was sent.
fn up_offer() -> bool {
    var all : bool = true;
    var app : [512]u8 = undefined;
    const an : usize = up_env("UP_APP", app[0..512]);
    var dir : [96]u8 = undefined;
    var dn : usize = up_env("UP_DIR", dir[0..96]);
    if (dn == 0) { dn = put_bytes(dir[0..96], 0, "/tmp"); }
    var zip : [256]u8 = undefined;
    up_at(dir[0..96], dn, "/t27os-offer.zip", zip[0..256]);
    var nickb : [32]u8 = undefined;
    var nn : usize = up_env("UP_NICK", nickb[0..32]);
    if (nn == 0) { nn = put_bytes(nickb[0..32], 0, "t27os"); }
    if (nn > NICK_MAX) { nn = NICK_MAX; }
    var id : [208]u8 = undefined;
    var fp : [10]u8 = undefined;
    const r : u32 = ih_identity_open(nickb[0..32], nn, id[0..208], fp[0..10]);
    all = up_ok("identity opened under $HOME/.t27os", r == IH_CREATED or r == IH_LOADED) and all;
    var pl : [384]u8 = undefined;
    var ln : [3]u64 = undefined;
    var build : u32 = 0;
    if (an > 0 and uh_plist(app[0..512], an, pl[0..384], ln[0..3])) { build = ui_build_text(pl[128..256], @as(usize, @intCast(ln[1]))); }
    up_say("offer bundle build ");
    up_dec(@as(u64, build));
    up_say("\n");
    all = up_ok("the bundle's Info.plist names a build", build > 0) and all;
    all = up_ok("bundle zipped (ditto, stored)", an > 0 and uh_zip_app(app[0..512], zip[0..256])) and all;
    var sha : [32]u8 = undefined;
    const size : i64 = uh_file_sha(zip[0..256], sha[0..32]);
    up_say("zip bytes ");
    if (size > 0) { up_dec(@as(u64, @intCast(size))); }
    up_say("\n");
    const ver : u64 = up_env_version();
    var m : [216]u8 = undefined;
    var mok : bool = false;
    if (size > 0 and all) { mok = uh_make_manifest(id[0..208], up_part(ver, 2), up_part(ver, 1), up_part(ver, 0), build, @as(u64, @intCast(size)), sha[0..32], m[0..216]) == 216; }
    all = up_ok("manifest signed by this identity", mok) and all;
    const lfd : i32 = uh_listen(UH_LOOPBACK, 0);
    const port : u32 = uh_bound_port(lfd);
    all = up_ok("listening on 127.0.0.1 at a free port", lfd >= 0 and port > 0) and all;
    if (all == false) { return false; }
    up_say("update port ");
    up_dec(@as(u64, port));
    up_say("\n");
    var inv : [25]u8 = undefined;
    invite_make(fp[0..10], inv[0..25]);
    var t0 : [96]u8 = undefined;
    var t1 : [96]u8 = undefined;
    var t2 : [96]u8 = undefined;
    const n0 : usize = txt_build(inv[0..25], @as(u32, @intCast(up_env_num("UP_PORT", 47799))), nickb[0..32], nn, t0[0..96]);
    const n1 : usize = upd_txt_add(t0[0..96], n0, up_part(ver, 2), up_part(ver, 1), up_part(ver, 0), build, t1[0..96]);
    const n2 : usize = upd_txt_add_port(t1[0..96], n1, port, t2[0..96]);
    all = up_ok("TXT with ver, build and up", n0 > 0 and n1 > n0 and n2 > n1) and all;
    var name : [64]u8 = undefined;
    const nl : usize = up_env("UP_NAME", name[0..64]);
    if (nl == 0) {
        const k : usize = put_bytes(name[0..64], 0, "upd-probe");
        name[k] = 0;
    }
    var rref : [8]u8 = undefined;
    put_u64(rref[0..8], 0, 0);
    var res : [72]u8 = undefined;
    var i : usize = 0;
    while (i < 72) {
        res[i] = 0;
        i = i + 1;
    }
    const rc : i32 = ih_register(rref[0..8], name[0..64], @as(u32, @intCast(up_env_num("UP_PORT", 47799))), t2[0..96], n2, res[0..72]);
    all = up_ok("DNSServiceRegister taken", rc == 0) and all;
    const end : u64 = up_now_ms() + up_env_num("UP_SECONDS", 120) * 1000;
    var bundles : u64 = 0;
    var st : [2]u64 = undefined;
    var acked : bool = false;
    while (up_now_ms() < end) {
        ih_pump(get_u64(rref[0..8], 0), 0);
        if (up_peek32(ih_addr(res[0..72])) == 1) { acked = true; }
        st[0] = 0;
        st[1] = 0;
        const code : u32 = uh_serve_one(lfd, m[0..216], zip[0..256], 0, UP_NO_FLIP, 100, st[0..2]);
        if (code != US_IDLE) {
            up_say("  answer ");
            up_dec(@as(u64, code));
            up_say(" (1 manifest, 2 bundle, 3 refused, 5 io) from offset ");
            up_dec(st[1]);
            up_say(", bundle bytes sent ");
            up_dec(st[0]);
            up_say("\n");
            if (code == 2) { bundles = bundles + 1; }
        }
    }
    ih_free(get_u64(rref[0..8], 0));
    all = up_ok("announcement acknowledged by the daemon", acked) and all;
    if (up_env_num("UP_EXPECT", 0) == 1) { all = up_ok("a whole bundle was sent", bundles > 0) and all; }
    return all;
}

pub fn main() -> void {
    var rb : [16]u8 = undefined;
    const rn : usize = up_env("UP_ROLE", rb[0..16]);
    var ok : bool = false;
    if (rn == 8 and rb[0] == 97) {
        up_say("update probe: announce\n");
        ok = up_run(true, false);
    } else if (rn == 6 and rb[0] == 98) {
        up_say("update probe: browse\n");
        ok = up_run(false, true);
    } else if (rn == 4 and rb[0] == 120) {
        up_say("update probe: xfer\n");
        ok = up_xfer();
    } else if (rn == 5 and rb[0] == 115) {
        ok = up_serve();
    } else if (rn == 5 and rb[0] == 111) {
        up_say("update probe: offer\n");
        ok = up_offer();
    } else if (rn == 4 and rb[0] == 108) {
        up_say("update probe: lock\n");
        ok = up_lock_case();
    } else if (rn == 4 and rb[0] == 98) {
        up_say("update probe: both\n");
        ok = up_run(true, true);
    } else {
        up_say("update probe: table\n");
        ok = up_table();
    }
    if (ok) {
        up_say("ALL CHECKS PASSED\n");
        sys_exit(0);
    }
    up_say("SOME CHECKS FAILED\n");
    sys_exit(1);
}
