// specs/t27os/queue.t27 -- which waiting item may take a free slot.
// A blocked item stays waiting. This module starts no lane.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::queue {

    use t27os::blockers::BK_NONE;
    use t27os::blockers::blocks_merge;

    pub const SLOT_FREE : u8 = 0;
    pub const SLOT_BUSY : u8 = 1;
    pub const SLOT_WAIT : u8 = 2;

    pub fn admits(state: u8, blocker: u8) -> bool {
        if (state != SLOT_WAIT) { return false; }
        if (blocks_merge(blocker)) { return false; }
        return blocker == BK_NONE;
    }

    /// The first waiting unblocked slot, or 0 when both are busy or blocked.
    pub fn next_slot(a_state: u8, a_blocker: u8, b_state: u8, b_blocker: u8) -> u8 {
        if (admits(a_state, a_blocker)) { return 1; }
        if (admits(b_state, b_blocker)) { return 2; }
        return 0;
    }

    test "a blocked waiter does not take the free slot" {
        assert(admits(SLOT_WAIT, BK_NONE));
        assert(!admits(SLOT_BUSY, BK_NONE));
        assert(!admits(SLOT_WAIT, 2));
        assert(next_slot(SLOT_WAIT, 2, SLOT_WAIT, BK_NONE) == 2);
        assert(next_slot(SLOT_WAIT, 2, SLOT_BUSY, BK_NONE) == 0);
    }

    invariant a_busy_slot_is_not_next {
        assert next_slot(SLOT_BUSY, BK_NONE, SLOT_BUSY, BK_NONE) == 0;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
