; specs/t27os/queue.t27 -- when the next lane waits for a free slot.
; The cap is an argument. This spec does not pick a machine size and does
; not start a lane.

module T27osQueue;

use t27os::orchestrator::oc_branch_ok;

/// The assigned lane is the work unit. Master is not a lane.
pub fn q_on_assigned_lane(is_master: bool, force: bool, rebase_shared: bool) -> bool {
    return oc_branch_ok(is_master, force, rebase_shared);
}

pub fn q_next_waits(running: u32, cap: u32) -> bool {
    if (cap == 0) { return true; }
    return running >= cap;
}

pub fn q_free_slots(running: u32, cap: u32) -> u32 {
    if (running >= cap) { return 0; }
    return cap - running;
}

test a_full_cap_makes_the_next_lane_wait {
    assert q_next_waits(3, 3);
    assert q_free_slots(3, 3) == 0;
}

test a_free_slot_lets_the_next_lane_start {
    assert q_next_waits(2, 3) == false;
    assert q_free_slots(2, 3) == 1;
}

test a_zero_cap_never_starts_a_lane {
    assert q_next_waits(0, 0);
    assert q_free_slots(0, 0) == 0;
}

test work_stays_on_the_assigned_lane {
    assert q_on_assigned_lane(false, false, false);
    assert q_on_assigned_lane(true, false, false) == false;
    assert q_on_assigned_lane(false, true, false) == false;
    assert q_on_assigned_lane(false, false, true) == false;
}
