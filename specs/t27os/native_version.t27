// SPDX-License-Identifier: Apache-2.0
// specs/t27os/native_version.t27 -- the version of the T27 OS native foundation line and its
// machine-readable report (Refs #13212, FR-001; Matryoshka tracking #13020).
//
// WHAT THIS IS: the native line is a separate artifact next to the published T27 OS release
// (specs/t27os/release.t27, 0.2.0). It names the native chat / agent / swarm foundation only. No
// tag, no publish, no release card edit. It is numbered 0.3.0, the next minor above the published
// 0.2.0 (owner, 2026-11-07: never a version below the released line); this spec keeps the line
// apart (a distinct "line=native" report row) and never feeds release.t27.
//
// WHAT THIS IS NOT: a second copy of semver packing. release.t27 owns pack_version for the
// published line; the native line writes text only.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osNativeVersion;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---- the version -------------------------------------------------------------------------------------------

pub const NATIVE_MAJOR : u32 = 0;
pub const NATIVE_MINOR : u32 = 3;
pub const NATIVE_PATCH : u32 = 0;
pub const NATIVE_LINE : str = "native";

/// Component indexes, in report order.
pub const COMP_CORE : u32 = 0;
pub const COMP_CONTRACTS : u32 = 1;
pub const COMP_SKILLS : u32 = 2;
pub const COMP_UI : u32 = 3;
pub const COMP_COUNT : u32 = 4;

/// The component name of index i; empty for an index out of range.
pub fn component_name(i: u32) -> []const u8 {
    if (i == COMP_CORE) { return "core"; }
    if (i == COMP_CONTRACTS) { return "contracts"; }
    if (i == COMP_SKILLS) { return "skills"; }
    if (i == COMP_UI) { return "ui"; }
    return "";
}

/// What each component holds today, in plain words, so a reader cannot take a scaffold for a product.
pub fn component_state(i: u32) -> []const u8 {
    if (i == COMP_CORE) { return "scaffold"; }
    if (i == COMP_CONTRACTS) { return "scaffold"; }
    if (i == COMP_SKILLS) { return "empty"; }
    if (i == COMP_UI) { return "text-only"; }
    return "";
}

/// Writes the dotted version at `at`: "0.3.0". Returns the cursor.
pub fn put_version(out: []u8, at: usize) -> usize {
    var n : usize = put_dec(out, at, @as(u64, NATIVE_MAJOR));
    n = put_bytes(out, n, ".");
    n = put_dec(out, n, @as(u64, NATIVE_MINOR));
    n = put_bytes(out, n, ".");
    n = put_dec(out, n, @as(u64, NATIVE_PATCH));
    return n;
}

/// The whole version as text from position 0; returns its length.
pub fn version_text(out: []u8) -> usize {
    return put_version(out, 0);
}

/// The machine-readable report, one key=value row per line, newline-terminated:
///   t27os_version=0.3.0
///   line=native
///   component.core=0.3.0
///   component.core.state=scaffold
///   ... (contracts, skills, ui)
/// Every component carries the line's version: the line moves as one until a component ships alone.
/// Returns the length; 0 when `out` is shorter than 512 bytes (a refusal, never a clipped report).
pub fn version_report(out: []u8) -> usize {
    if (out.len < 512) { return 0; }
    var n : usize = put_bytes(out, 0, "t27os_version=");
    n = put_version(out, n);
    n = put_bytes(out, n, "\nline=");
    n = put_bytes(out, n, NATIVE_LINE);
    n = put_bytes(out, n, "\n");
    var i : u32 = 0;
    while (i < COMP_COUNT) {
        n = put_bytes(out, n, "component.");
        n = put_bytes(out, n, component_name(i));
        n = put_bytes(out, n, "=");
        n = put_version(out, n);
        n = put_bytes(out, n, "\ncomponent.");
        n = put_bytes(out, n, component_name(i));
        n = put_bytes(out, n, ".state=");
        n = put_bytes(out, n, component_state(i));
        n = put_bytes(out, n, "\n");
        i = i + 1;
    }
    return n;
}

/// True when `hay` holds `needle` as a whole row start: at 0 or right after a newline.
pub fn has_row(hay: []const u8, hlen: usize, needle: []const u8) -> bool {
    var i : usize = 0;
    while (i + needle.len <= hlen) {
        if (i == 0 or hay[i - 1] == 10) {
            var k : usize = 0;
            var same : bool = true;
            while (k < needle.len) {
                if (hay[i + k] != needle[k]) { same = false; }
                k = k + 1;
            }
            if (same) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// ---- the tests ---------------------------------------------------------------------------------------------

test "the_version_text_is_0_3_0" {
    var out : [64]u8 = undefined;
    const n : usize = version_text(out[0..64]);
    const want : []const u8 = "0.3.0";
    assert n == want.len;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
}

test "the_report_names_the_line_and_all_four_components" {
    var out : [768]u8 = undefined;
    const n : usize = version_report(out[0..768]);
    assert n > 0;
    assert has_row(out[0..768], n, "t27os_version=0.3.0\n");
    assert has_row(out[0..768], n, "line=native\n");
    assert has_row(out[0..768], n, "component.core=0.3.0\n");
    assert has_row(out[0..768], n, "component.contracts=0.3.0\n");
    assert has_row(out[0..768], n, "component.skills=0.3.0\n");
    assert has_row(out[0..768], n, "component.ui=0.3.0\n");
}

test "the_report_states_what_each_component_holds" {
    var out : [768]u8 = undefined;
    const n : usize = version_report(out[0..768]);
    assert has_row(out[0..768], n, "component.core.state=scaffold\n");
    assert has_row(out[0..768], n, "component.skills.state=empty\n");
    assert has_row(out[0..768], n, "component.ui.state=text-only\n");
}

test "a_short_buffer_gets_no_report_not_a_clipped_one" {
    var out : [128]u8 = undefined;
    assert version_report(out[0..128]) == 0;
}

test "the_row_finder_refuses_a_row_found_mid_line" {
    // negative control: "line=native" inside "xline=native" is not a row start
    const text : []const u8 = "xline=native\n";
    assert has_row(text, text.len, "line=native\n") == false;
    assert has_row("line=native\n", 12, "line=native\n") == true;
}

test "an_unknown_component_index_has_no_name" {
    assert component_name(COMP_COUNT).len == 0;
    assert component_name(COMP_UI).len == 2;
}
