/// The text of message k of side `who` (65 = A, 66 = B) into out; its length.
pub fn chp_text(who: u8, k: u32, out: []u8) -> usize {
    var n : usize = 0;
    if (who == 65 and k == 7) {
        // "A", 249 times the 6 bytes of "Da! " in Cyrillic, 5 dots: 1500 bytes, cut at 700 and 1400 inside a letter
        out[0] = who;
        n = 1;
        while (n < 1495) {
            out[n] = 208; out[n + 1] = 148; out[n + 2] = 208; out[n + 3] = 176; out[n + 4] = 33; out[n + 5] = 32;
            n = n + 6;
        }
        while (n < 1500) {
            out[n] = 46;
            n = n + 1;
        }
        return n;
    }
    if (who == 65 and k == 3) {
        // "A " U+202E "gpj.exe 3"
        const r : [14]u8 = [65, 32, 226, 128, 174, 103, 112, 106, 46, 101, 120, 101, 32, 51];
        var j : usize = 0;
        while (j < 14) {
            out[j] = r[j];
            j = j + 1;
        }
        return 14;
    }
    out[0] = who;
    n = 1;
    if (who == 65 and k == 12) {
        // " emoji <grinning face>"
        const e : [11]u8 = [32, 101, 109, 111, 106, 105, 32, 240, 159, 152, 128];
        var i : usize = 0;
        while (i < 11) {
            out[n] = e[i];
            n = n + 1;
            i = i + 1;
        }
    }
    out[n] = 32;
    n = n + 1;
    if (k >= 10) {
        out[n] = 48 + @as(u8, @intCast(k / 10));
        n = n + 1;
    }
    out[n] = 48 + @as(u8, @intCast(k % 10));
    return n + 1;
}

fn chp_all_out(log: []const u8, st: u32) -> bool {
    const n : usize = @as(usize, cl_count(log));
    var i : usize = 0;
    while (i < n) {
        if (cl_dir(log, i) == CH_DIR_OUT and cl_state(log, i) < st) { return false; }
        i = i + 1;
    }
    return true;
}

/// Every line once, in the order it was sent: incoming 1..nin with their texts, outgoing 1..nout with theirs.
fn chp_order_ok(log: []const u8, me: u8, peer: u8, nin: u32, nout: u32) -> bool {
    const n : usize = @as(usize, cl_count(log));
    if (n != @as(usize, nin + nout)) { return false; }
    var want_in : u32 = 1;
    var want_out : u32 = 1;
    var i : usize = 0;
    var t : [2000]u8 = undefined;
    var c : [2000]u8 = undefined;
    var o : [2000]u8 = undefined;
    while (i < n) {
        if (cl_dir(log, i) == CH_DIR_IN) {
            // an incoming line is exactly the sent text cleaned (whatever the sender kept)
            if (cl_msg(log, i) != want_in) { return false; }
            const tn : usize = chp_text(peer, want_in, t[0..2000]);
            const cn : usize = ch_clean(t[0..tn], c[0..2000]);
            if (!ck_same(cl_text(log, i), c[0..cn])) { return false; }
            want_in = want_in + 1;
        } else {
            // an own line: cleaned on send (with CHP_RAW the run put the raw bytes back, so compare it cleaned)
            if (cl_msg(log, i) != want_out) { return false; }
            const tn : usize = chp_text(me, want_out, t[0..2000]);
            const cn : usize = ch_clean(t[0..tn], c[0..2000]);
            const on : usize = ch_clean(cl_text(log, i), o[0..2000]);
            if (!ck_same(o[0..on], c[0..cn])) { return false; }
            want_out = want_out + 1;
        }
        i = i + 1;
    }
    return want_in == nin + 1 and want_out == nout + 1;
}

/// Lines of direction dir whose text holds U+202E (E2 80 AE).
fn chp_rlo_lines(log: []const u8, dir: u32) -> u32 {
    const n : usize = @as(usize, cl_count(log));
    var c : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        const t : []const u8 = cl_text(log, i);
        var k : usize = 0;
        var hit : bool = false;
        while (k + 2 < t.len) {
            if (t[k] == 226 and t[k + 1] == 128 and t[k + 2] == 174) { hit = true; }
            k = k + 1;
        }
        if (hit and cl_dir(log, i) == dir) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn chp_stat(label: []const u8, v: u64) -> void {
    ckh_line(label);
    ckh_num("=", v);
}

fn chp_role_id() -> bool {
    var id : [208]u8 = undefined;
    var fp : [10]u8 = undefined;
    const r : u32 = ih_identity_open("probe", 5, id[0..ID_LEN + 1], fp[0..10]);
    if (r != IH_CREATED and r != IH_LOADED) { return ckh_check("identity opened", false); }
    var t : [1109]u8 = undefined;
    const fr : u32 = ih_friends_open(t[0..FT_LEN + 1]);
    if (fr != IH_CREATED and fr != IH_LOADED) { return ckh_check("friends opened", false); }
    var inv : [32]u8 = undefined;
    const fn_ : usize = ckh_env("CHP_FRIEND", inv[0..32]);
    if (fn_ == 25) {
        const a : u32 = ft_add(t[0..FT_LEN], inv[0..25], fp[0..10]);
        if (a != FA_OK and a != FA_DUPLICATE) { return ckh_check("friend added", false); }
        if (!ih_friends_save(t[0..FT_LEN])) { return ckh_check("friends saved", false); }
    }
    var mine : [25]u8 = undefined;
    invite_make(fp[0..10], mine[0..25]);
    ckh_line("INVITE ");
    ckh_line(mine[0..25]);
    ckh_line("\n");
    return true;
}

fn chp_side(is_a: bool) -> bool {
    var me : u8 = 66;
    var peer : u8 = 65;
    if (is_a) { me = 65; peer = 66; }
    const nmsg : u32 = @as(u32, @intCast(ckh_env_num("CHP_N", 20)));
    const nrep : u32 = @as(u32, @intCast(ckh_env_num("CHP_R", 5)));
    var nout : u32 = nrep;
    var nin : u32 = nmsg;
    if (is_a) { nout = nmsg; nin = nrep; }
    var ok : bool = true;
    var id : [208]u8 = undefined;
    var fp : [10]u8 = undefined;
    const ir : u32 = ih_identity_open("probe", 5, id[0..ID_LEN + 1], fp[0..10]);
    ok = ckh_check("identity of this HOME", ir == IH_LOADED) and ok;
    var friends : [1109]u8 = undefined;
    ih_friends_open(friends[0..FT_LEN + 1]);
    var ffp : [10]u8 = undefined;
    ok = ckh_check("the peer is in the friends table", ft_count(friends[0..FT_LEN]) >= 1 and ft_fp_at(friends[0..FT_LEN], 0, ffp[0..10])) and ok;
    if (!ok) { return false; }
    var log : [1016040]u8 = undefined;
    var buf : [1008048]u8 = undefined;
    var asm : [8064]u8 = undefined;
    var i : usize = 0;
    while (i < CA_LEN) {
        asm[i] = 0;
        i = i + 1;
    }
    const lr : u32 = chh_load(ffp[0..10], log[0..cl_bytes(CL_KEEP)], CL_KEEP, buf[0..CF_MAX + 1]);
    ok = ckh_check("a fresh log (no chat file yet)", lr == CHH_NEW and cl_count(log[0..cl_bytes(CL_KEEP)]) == 0) and ok;
    const L : usize = cl_bytes(CL_KEEP);
    var s : [299648]u8 = undefined;
    const port : u64 = ckh_env_num("CHP_PORT", 47801);
    if (!cs_open(s[0..299648], fp[0..10], 2130706433, port, CS_AUDIO_NONE)) { return ckh_check("message session opened", false); }
    // the session proves this device's identity: since the friends file v2 a message session opens only between
    // proven friends (the first proof of a friend with no stored key is stored)
    ok = ckh_check("identity handed to the session", cs_identity(s[0..299648], id[ID_OFF_PUB..ID_OFF_PUB + 65], id[ID_OFF_PRIV..ID_OFF_PRIV + 97])) and ok;
    cs_set(s[0..299648], CS_K_CALLING_MS, CH_CALLING_MS);
    cs_set(s[0..299648], CS_K_SILENT_MS, CH_SILENT_MS);
    var m : [384]u8 = undefined;
    chm_init(m[0..CHM_LEN], ffp[0..10], ckh_env_num("CHP_PEER", 2130706433), ckh_env_num("CHP_PEER_PORT", 47802));
    chm_set(m[0..CHM_LEN], CHM_K_DROP, ckh_env_num("CHP_DROP", 0));
    var t : [2000]u8 = undefined;
    const t0 : u64 = ckh_ms();
    const raw : bool = ckh_env_num("CHP_RAW", 0) == 1;
    if (is_a) {
        var k : u32 = 1;
        while (k <= nmsg) {
            var tn : usize = chp_text(me, k, t[0..2000]);
            // CHP_RAW: three placeholder bytes where the override stands, then the raw override into the line itself
            if (raw and k == 3) {
                t[2] = 35;
                t[3] = 35;
                t[4] = 35;
            }
            chm_send(m[0..CHM_LEN], log[0..L], t[0..tn], ckh_ms());
            if (raw and k == 3) {
                const r3 : usize = cl_find(log[0..L], CH_DIR_OUT, 3);
                if (r3 != CL_NONE and cl_len(log[0..L], r3) == 14) {
                    log[cl_line_at(r3) + CL_TEXT + 2] = 226;
                    log[cl_line_at(r3) + CL_TEXT + 3] = 128;
                    log[cl_line_at(r3) + CL_TEXT + 4] = 174;
                }
            }
            k = k + 1;
        }
    }
    if (is_a) { chp_stat("own_lines_with_u202e_before_send", @as(u64, chp_rlo_lines(log[0..L], CH_DIR_OUT))); }
    const limit : u64 = ckh_env_num("CHP_SECS", 120) * 1000;
    var opened : bool = false;
    var unread_seen : u32 = 0;
    var t_all : u64 = 0;
    var last_save : u64 = 0;
    var dirty : bool = false;
    var done : bool = false;
    while (!done) {
        const now : u64 = ckh_ms();
        if (now - t0 > limit) { break; }
        const ev : u32 = chm_tick(m[0..CHM_LEN], s[0..299648], log[0..L], asm[0..CA_LEN], friends[0..FT_LEN], fp[0..10], now);
        if ((ev & CHM_E_DIRTY) != 0) { dirty = true; }
        // lines that came in are ACKed once saved: they are written at once
        if (dirty and (now - last_save >= 1000 or chm_held(m[0..CHM_LEN]) > 0)) {
            const saved : bool = chh_save(log[0..L], buf[0..CF_MAX]);
            chm_saved(m[0..CHM_LEN], s[0..299648], saved);
            last_save = now;
            dirty = saved == false;
        }
        const got_in : u32 = cl_count_dir(log[0..L], CH_DIR_IN);
        if (!opened and got_in == nin) {
            unread_seen = cl_unread(log[0..L]);
            chm_open(m[0..CHM_LEN], log[0..L]);
            opened = true;
            if (!is_a) {
                var k : u32 = 1;
                while (k <= nrep) {
                    const tn : usize = chp_text(me, k, t[0..2000]);
                    chm_send(m[0..CHM_LEN], log[0..L], t[0..tn], now);
                    k = k + 1;
                }
            }
        }
        if (t_all == 0 and opened and cl_count_dir(log[0..L], CH_DIR_OUT) == nout and chp_all_out(log[0..L], CH_S_READ)) { t_all = now - t0; }
        // finished: everything here and read both ways, and the session closed (idle) or ended by the peer
        if (t_all != 0 and chm_stat(m[0..CHM_LEN], CHM_SESSIONS) > 0 and cs_state(s[0..299648]) == CK_IDLE) { done = true; }
        ckh_usleep(2000);
    }
    const total : u64 = ckh_ms() - t0;
    chh_save(log[0..L], buf[0..CF_MAX]);
    // the message socket is closed in any process the window starts (FD_CLOEXEC), and a message session sends no video
    // at all: no H.264 HELLO or part (call_session cs_vtick)
    ok = ckh_check("the message socket has FD_CLOEXEC", cs_net(s[0..299648], CS_NET_CLOEXEC) == 1) and ok;
    ok = ckh_check("the message session sent no video control or part", cs_vh_stat(s[0..299648], CS_H_HELLO_TX) == 0 and cs_vh_stat(s[0..299648], CS_H_PARTS_TX) == 0) and ok;
    cs_close(s[0..299648]);
    ok = ckh_check("finished before the time limit", done) and ok;
    ok = ckh_check("every outgoing message delivered and read", chp_all_out(log[0..L], CH_S_READ) and cl_count_dir(log[0..L], CH_DIR_OUT) == nout) and ok;
    ok = ckh_check("unread counted before the chat was opened", unread_seen == nin) and ok;
    ok = ckh_check("no unread after opening", cl_unread(log[0..L]) == 0) and ok;
    ok = ckh_check("every line once and in order, texts intact", chp_order_ok(log[0..L], me, peer, nin, nout)) and ok;
    if (!is_a) {
        // the long and the emoji message, byte for byte
        const i7 : usize = cl_find(log[0..L], CH_DIR_IN, 7);
        const i12 : usize = cl_find(log[0..L], CH_DIR_IN, 12);
        ok = ckh_check("message 7 is 1500 bytes in 3 parts", i7 != CL_NONE and cl_text(log[0..L], i7).len == 1500) and ok;
        const i3 : usize = cl_find(log[0..L], CH_DIR_IN, 3);
        ok = ckh_check("message 3 came in without U+202E (14 bytes sent, 11 kept)", i3 != CL_NONE and cl_text(log[0..L], i3).len == 11) and ok;
        ok = ckh_check("message 12 holds the emoji bytes", i12 != CL_NONE and cl_text(log[0..L], i12).len == 15 and cl_text(log[0..L], i12)[8] == 240 and cl_text(log[0..L], i12)[9] == 159) and ok;
    }
    // read back from disk into a second log
    var log2 : [1016040]u8 = undefined;
    const lr2 : u32 = chh_load(ffp[0..10], log2[0..L], CL_KEEP, buf[0..CF_MAX + 1]);
    ok = ckh_check("the log reads back from ~/.t27os/chat", lr2 == CHH_LOADED and cl_count(log2[0..L]) == nin + nout) and ok;
    ok = ckh_check("the read-back log is the same lines in the same order", chp_order_ok(log2[0..L], me, peer, nin, nout) and chp_all_out(log2[0..L], CH_S_READ) and cl_unread(log2[0..L]) == 0) and ok;
    ok = ckh_check("no incoming line holds U+202E, in memory or read back from disk", chp_rlo_lines(log[0..L], CH_DIR_IN) == 0 and chp_rlo_lines(log2[0..L], CH_DIR_IN) == 0) and ok;
    chp_stat("incoming_lines_with_u202e", @as(u64, chp_rlo_lines(log[0..L], CH_DIR_IN)));
    chp_stat("own_lines_with_u202e_after_read_back", @as(u64, chp_rlo_lines(log2[0..L], CH_DIR_OUT)));
    ok = ckh_check("no line failed", chm_stat(m[0..CHM_LEN], CHM_FAILED) == 0 and chm_stat(m[0..CHM_LEN], CHM_SEND_ERR) == 0) and ok;
    chp_stat("lines", @as(u64, cl_count(log[0..L])));
    chp_stat("out", @as(u64, nout));
    chp_stat("in", @as(u64, nin));
    chp_stat("unread_before_open", @as(u64, unread_seen));
    chp_stat("text_frames_sent", chm_stat(m[0..CHM_LEN], CHM_TX_FRAMES));
    chp_stat("frames_dropped_test", chm_stat(m[0..CHM_LEN], CHM_DROPPED));
    chp_stat("resend_rounds", chm_stat(m[0..CHM_LEN], CHM_TX_RESENDS));
    chp_stat("acks_sent", chm_stat(m[0..CHM_LEN], CHM_ACK_TX));
    chp_stat("acks_received", chm_stat(m[0..CHM_LEN], CHM_ACK_RX));
    chp_stat("new_lines_received", chm_stat(m[0..CHM_LEN], CHM_RX_NEW));
    chp_stat("duplicates_received", chm_stat(m[0..CHM_LEN], CHM_RX_DUP));
    chp_stat("reads_sent", chm_stat(m[0..CHM_LEN], CHM_READ_TX));
    chp_stat("reads_received", chm_stat(m[0..CHM_LEN], CHM_READ_RX));
    chp_stat("sessions", chm_stat(m[0..CHM_LEN], CHM_SESSIONS));
    chp_stat("dials", chm_stat(m[0..CHM_LEN], CHM_DIALS));
    chp_stat("idle_closed_here", chm_stat(m[0..CHM_LEN], CHM_IDLE_CLOSED));
    chp_stat("sealed_text_tx", cs_stat(s[0..299648], CS_ST_TEXT_TX));
    chp_stat("sealed_text_rx", cs_stat(s[0..299648], CS_ST_TEXT_RX));
    chp_stat("replays_refused", cs_stat(s[0..299648], CS_ST_REJ_REPLAY));
    chp_stat("ms_to_all_read", t_all);
    chp_stat("ms_total", total);
    return ok;
}

pub fn main() -> void {
    // Never true: keeps the audio callbacks emitted (call_session looks them up by name for an audio call).
    var z : [8]u8 = undefined;
    put_u64(z[0..8], 0, 0);
    if (get_u64(z[0..8], 0) == 99) {
        cbp_fin(0, 0, 0, 0, 0, 0);
        cbp_fout(0, 0, 0);
    }
    var rb : [32]u8 = undefined;
    const rn : usize = ckh_env("CHP_ROLE", rb[0..32]);
    var ok : bool = false;
    if (rn == 2 and ck_same(rb[0..2], "id")) {
        ok = chp_role_id();
    } else if (rn == 1 and rb[0] == 97) {
        ok = chp_side(true);
    } else if (rn == 1 and rb[0] == 98) {
        ok = chp_side(false);
    } else {
        ckh_line("CHP_ROLE=id|a|b\n");
    }
    if (ok) {
        ckh_line("CHAT PROBE PASS\n");
        sys_exit(0);
    }
    ckh_line("CHAT PROBE FAIL\n");
    sys_exit(1);
}

test the_probe_texts_are_the_shapes_the_run_checks {
    var t : [2000]u8 = undefined;
    assert chp_text(65, 7, t[0..2000]) == 1500;
    assert t[699] == 208 and t[700] == 176 and t[1399] == 208 and t[1400] == 148 and t[1499] == 46;
    assert chp_text(65, 12, t[0..2000]) == 15;
    assert t[8] == 240 and t[11] == 128 and t[13] == 49 and t[14] == 50;
    assert chp_text(66, 3, t[0..2000]) == 3;
    assert t[0] == 66 and t[2] == 51;
    var c : [2000]u8 = undefined;
    assert chp_text(65, 3, t[0..2000]) == 14 and t[2] == 226 and t[4] == 174;
    assert ch_clean(t[0..14], c[0..2000]) == 11 and c[2] == 103;
}
