// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_visibility_gap_b.t27 -- DSH visibility gap B: T27 OS MCP
// server half, a t27os tool home in the one MCP service that the DSH to ACP
// bridge maps onto a pane.
// Part of M8 milestone (milestone #12). Closes #13047.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_visibility_gap_b;

pub const DSH_VISIBILITY_GAP_B_MCP_SERVICE : str = "dsh_to_acp_bridge";

pub struct DshVisibilityGapB { mcp_service: str, pane_mapped: bool };

pub fn dsh_visibility_gap_b_pane_mapped(g: DshVisibilityGapB) -> bool {
    return g.pane_mapped && g.mcp_service == DSH_VISIBILITY_GAP_B_MCP_SERVICE;
}

test "dsh_visibility_gap_b_pane_mapped" {
    assert(dsh_visibility_gap_b_pane_mapped(DshVisibilityGapB { mcp_service: DSH_VISIBILITY_GAP_B_MCP_SERVICE, pane_mapped: true }));
    assert(!dsh_visibility_gap_b_pane_mapped(DshVisibilityGapB { mcp_service: "other", pane_mapped: true }));
}

invariant dsh_visibility_gap_b_mcp_service_defined {
    assert DSH_VISIBILITY_GAP_B_MCP_SERVICE == "dsh_to_acp_bridge";
}