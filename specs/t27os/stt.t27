// SPDX-License-Identifier: Apache-2.0
; specs/t27os/stt.t27 -- the recognition-state law of the Live Translator (issue #14254,
; epic #14250). One attempt, one law: a recognition attempt begins empty, hypothesis
; events replace the state, a seal at or above the confidence floor is a fact, a seal
; under the floor is tentative, and an aborted attempt stays incomplete forever.
; --
; THE LAW. stt_begin clears everything: a fallback attempt never inherits the previous
; attempt's text, sequence, confidence or language -- the same law router_stream.t27
; holds for usage counters (rs_begin, Closes #11275). A hypothesis event carries a
; sequence number that only grows; a stale event is refused (STT_STALE_SEQ) and changes
; nothing. An event's text, confidence and language REPLACE the state (cumulative
; REPLACE, the rs_merge scheme): no append, no invention. fin=true seals the attempt:
; at or above the confidence floor the state becomes SS_FINAL -- a fact; below it
; SS_TENTATIVE -- visible, flagged, never asserted as a fact. After a seal the attempt
; is closed: a later event is refused (STT_SEALED). An aborted attempt (the router says
; move on: pr_should_next, provider_router.t27) keeps what it knows and marks
; SS_ABORTED: an incomplete result is never folded into a fact, and its events are done
; (STT_CLOSED). Unknown stays unknown.
; --
; Purity: every function here is a pure function of its arguments; the provider
; decision rides provider_router.t27, the keys ride keys.t27 -- no transport, no UI,
; no audio here (issue #14254 scope: fixture hypothesis streams and router decisions
; in, recognition states out). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osStt;

use t27os::provider_router::pr_should_next;

/// The states a recognition attempt can sit in.
pub const SS_EMPTY : u8 = 0;
pub const SS_PARTIAL : u8 = 1;
pub const SS_FINAL : u8 = 2;
pub const SS_TENTATIVE : u8 = 3;
pub const SS_ABORTED : u8 = 4;

/// Accept, or refuse with the reason named. Refused means changed nothing.
pub const STT_OK : u8 = 0;
pub const STT_STALE_SEQ : u8 = 1;
pub const STT_SEALED : u8 = 2;
pub const STT_RAGGED : u8 = 3;
pub const STT_CLOSED : u8 = 4;

/// The confidence floor: at or above it a sealed result is a fact; below it the
/// result is tentative -- shown, flagged, never asserted as a fact.
pub const STT_CONF_FLOOR : u32 = 60;

/// One recognition attempt: the hypothesis as the provider currently states it.
pub struct SttState {
    st : u8,
    seq : u32,
    conf : u32,
    text : []const u8,
    lang : []const u8,
}

invariant the_states_are_distinct
    assert SS_EMPTY != SS_PARTIAL and SS_PARTIAL != SS_FINAL and SS_FINAL != SS_TENTATIVE and SS_TENTATIVE != SS_ABORTED and SS_ABORTED != SS_EMPTY

invariant every_refusal_is_named_and_nonzero
    assert STT_OK == 0 and STT_STALE_SEQ > 0 and STT_SEALED > 0 and STT_RAGGED > 0 and STT_CLOSED > 0 and STT_CONF_FLOOR >= 1 and STT_CONF_FLOOR <= 100

/// A fresh attempt sits EMPTY with no text, no sequence and no confidence.
pub fn new_stt() -> SttState {
    return SttState { st: SS_EMPTY, seq: 0, conf: 0, text: "", lang: "" };
}

/// The start of an attempt: everything cleared -- a fallback attempt never inherits
/// the previous attempt's hypothesis (the rs_begin law of router_stream.t27).
pub fn stt_begin(s : *SttState) -> void {
    var fresh : SttState = new_stt();
    s.st = fresh.st;
    s.seq = fresh.seq;
    s.conf = fresh.conf;
    s.text = fresh.text;
    s.lang = fresh.lang;
}

/// One hypothesis event: its sequence only grows; its text, confidence and language
/// REPLACE the state (cumulative REPLACE, the rs_merge scheme). fin=true seals: at or
/// above the confidence floor SS_FINAL -- a fact; below it SS_TENTATIVE -- never a
/// fact. A sealed attempt refuses further events (STT_SEALED); an aborted attempt
/// refuses them too (STT_CLOSED): its walk is over. A refused event changes nothing.
pub fn stt_apply(s : *SttState, seq : u32, fin : bool, conf : u32, lang : []const u8, text : []const u8) -> u8 {
    if (s.st == SS_FINAL or s.st == SS_TENTATIVE) { return STT_SEALED; }
    if (s.st == SS_ABORTED) { return STT_CLOSED; }
    if (seq <= s.seq) { return STT_STALE_SEQ; }
    s.st = SS_PARTIAL;
    s.seq = seq;
    s.conf = conf;
    s.text = text;
    s.lang = lang;
    if (fin) {
        if (conf >= STT_CONF_FLOOR) {
            s.st = SS_FINAL;
        } else {
            s.st = SS_TENTATIVE;
        }
    }
    return STT_OK;
}

/// The router said move on (pr_should_next): the attempt aborts. What it knows stays
/// (text, confidence, language untouched); the state becomes SS_ABORTED -- incomplete,
/// never a fact. A sealed fact does not demote: facts survive their attempt's death.
pub fn stt_abort(s : *SttState) -> void {
    if (s.st == SS_FINAL) { return; }
    s.st = SS_ABORTED;
}

/// A fact is a sealed result at or above the floor -- and only that. Tentative and
/// aborted results are never facts.
pub fn stt_is_fact(s : *SttState) -> bool {
    return s.st == SS_FINAL;
}

/// Whether an attempt is live (growing): the UI may show it as a moving hypothesis.
pub fn stt_is_live(s : *SttState) -> bool {
    return s.st == SS_PARTIAL;
}

/// Whether an attempt ended incomplete: shown flagged, never folded into a fact
/// (the INCOMPLETE law of router_stream.t27).
pub fn stt_is_incomplete(s : *SttState) -> bool {
    return s.st == SS_ABORTED;
}

/// The provider decision, answered by provider_router.t27: the one home for retry
/// statuses and the subscription refusal. This spec adds no decision rule of its own.
pub fn stt_router_says_stop(status : u32, body : []const u8) -> bool {
    return pr_should_next(status, body);
}

/// A recorded stream folds through stt_fold, the seg_fold shape one shape flatter: a
/// recorded session log IS a flat byte blob plus per-frame lengths, so the fold walks
/// seqs, fin flags, confidences, the language lengths and the text lengths as parallel
/// vectors and reads both strings of each event out of the one blob. Ragged vectors are
/// refused (STT_RAGGED); the fold stops at the first refused event and returns its
/// code, so a replay of a wrong order is refused here.
pub fn stt_fold(s : *SttState, seqs : []const u32, fins : []const u8, confs : []const u32, lang_lens : []const u32, text_lens : []const u32, blob : []const u8) -> u8 {
    if (seqs.len != fins.len or seqs.len != confs.len or seqs.len != lang_lens.len or seqs.len != text_lens.len) {
        return STT_RAGGED;
    }
    var o : usize = 0;
    var i : usize = 0;
    while (i < seqs.len) {
        var lo : usize = o + lang_lens[i];
        var to : usize = lo + text_lens[i];
        if (to > blob.len) { return STT_RAGGED; }
        var r : u8 = stt_apply(s, seqs[i], fins[i] != 0, confs[i], blob[o..lo], blob[lo..to]);
        if (r != STT_OK) { return r; }
        o = to;
        i = i + 1;
    }
    return STT_OK;
}

// ---- tests ----

test a_hypothesis_replaces_and_a_seal_at_the_floor_is_a_fact {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, false, 80, "ru", "hel");
    assert r == STT_OK;
    assert s.st == SS_PARTIAL;
    assert s.text[0] == 104;
    var r2 : u8 = stt_apply(&s, 2, true, 87, "ru", "hello");
    assert r2 == STT_OK;
    assert s.st == SS_FINAL;
    assert s.conf == 87;
    assert stt_is_fact(&s);
}

test a_stale_event_is_refused_and_changes_nothing {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, false, 50, "ru", "a");
    assert r == STT_OK;
    var r2 : u8 = stt_apply(&s, 1, false, 50, "ru", "a");
    assert r2 == STT_STALE_SEQ;
    var r3 : u8 = stt_apply(&s, 0, false, 90, "en", "b");
    assert r3 == STT_STALE_SEQ;
    assert s.st == SS_PARTIAL;
    assert s.text[0] == 97;
    assert s.conf == 50;
    assert s.lang[0] == 114;
}

test an_event_after_a_seal_is_refused {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, true, 70, "ru", "done");
    assert r == STT_OK;
    assert s.st == SS_FINAL;
    var r2 : u8 = stt_apply(&s, 2, false, 70, "ru", "more");
    assert r2 == STT_SEALED;
    assert s.text[0] == 100;
    assert s.seq == 1;
}

test an_underfloor_seal_is_tentative_never_a_fact {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, true, 59, "ru", "privet");
    assert r == STT_OK;
    assert s.st == SS_TENTATIVE;
    assert s.st != SS_FINAL;
    assert stt_is_fact(&s) == false;
    assert s.conf == 59;
    assert s.text[0] == 112;
}

test an_aborted_attempt_keeps_what_it_knows_and_is_never_a_fact {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, false, 40, "ru", "hel");
    assert r == STT_OK;
    stt_abort(&s);
    assert s.st == SS_ABORTED;
    assert stt_is_fact(&s) == false;
    assert stt_is_incomplete(&s);
    assert s.text[0] == 104;
    assert s.conf == 40;
    var r2 : u8 = stt_apply(&s, 2, true, 95, "ru", "hello");
    assert r2 == STT_CLOSED;
    assert s.st == SS_ABORTED;
    assert s.text[0] == 104;
}

test a_fact_survives_an_abort_and_begin_clears_everything {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, true, 70, "ru", "done");
    assert r == STT_OK;
    stt_abort(&s);
    assert s.st == SS_FINAL;
    assert stt_is_fact(&s);
    stt_begin(&s);
    assert s.st == SS_EMPTY;
    assert s.seq == 0;
    assert s.conf == 0;
    var r2 : u8 = stt_apply(&s, 1, false, 60, "en", "hi");
    assert r2 == STT_OK;
    assert s.st == SS_PARTIAL;
}

test the_router_decision_moves_the_stream_on {
    var s : SttState = new_stt();
    var stop : bool = stt_router_says_stop(429, "");
    assert stop;
    var cont : bool = stt_router_says_stop(200, "");
    assert cont == false;
    var s2 : SttState = new_stt();
    var r : u8 = stt_apply(&s2, 1, false, 40, "ru", "hel");
    assert r == STT_OK;
    var stop2 : bool = stt_router_says_stop(200, "disabled Claude subscription access");
    assert stop2;
    stt_abort(&s2);
    assert s2.st == SS_ABORTED;
    stt_begin(&s2);
    assert s2.st == SS_EMPTY;
    assert s2.text.len == 0;
}

test the_language_and_confidence_replace_on_every_event {
    var s : SttState = new_stt();
    var r : u8 = stt_apply(&s, 1, false, 70, "ru", "privet");
    assert r == STT_OK;
    assert s.lang[0] == 114;
    var r2 : u8 = stt_apply(&s, 2, false, 75, "en", "hello");
    assert r2 == STT_OK;
    assert s.lang[0] == 101;
    assert s.text[0] == 104;
    assert s.conf == 75;
}

test a_replay_folds_the_same_stream_to_the_same_state {
    var seqs : [3]u32 = [1, 2, 3];
    var fins : [3]u8 = [0, 0, 1];
    var confs : [3]u32 = [50, 70, 88];
    var llens : [3]u32 = [2, 2, 2];
    var tlens : [3]u32 = [3, 5, 11];
    var blob : []const u8 = "ruhelruhelloruhello world";
    var a : SttState = new_stt();
    var ra : u8 = stt_fold(&a, seqs[0..], fins[0..], confs[0..], llens[0..], tlens[0..], blob);
    assert ra == STT_OK;
    assert a.st == SS_FINAL;
    assert a.conf == 88;
    assert a.text[6] == 119;
    var b : SttState = new_stt();
    var rb : u8 = stt_fold(&b, seqs[0..], fins[0..], confs[0..], llens[0..], tlens[0..], blob);
    assert rb == STT_OK;
    assert b.st == a.st;
    assert b.conf == a.conf;
    assert b.seq == a.seq;
}

test a_ragged_replay_is_refused_and_changes_nothing {
    var seqs : [2]u32 = [1, 2];
    var fins : [3]u8 = [0, 0, 1];
    var confs : [3]u32 = [50, 70, 88];
    var llens : [3]u32 = [2, 2, 2];
    var tlens : [3]u32 = [3, 5, 11];
    var blob : []const u8 = "ruhelruhelloruhello world";
    var s : SttState = new_stt();
    var r : u8 = stt_fold(&s, seqs[0..], fins[0..], confs[0..], llens[0..], tlens[0..], blob);
    assert r == STT_RAGGED;
    assert s.st == SS_EMPTY;
    assert s.seq == 0;
}

test negative_control_refutes_a_machine_that_folds_every_state_into_a_fact {
    assert SS_FINAL != SS_TENTATIVE and SS_TENTATIVE != SS_ABORTED and SS_ABORTED != SS_PARTIAL and SS_PARTIAL != SS_EMPTY;
    assert STT_SEALED != STT_OK and STT_STALE_SEQ != STT_OK and STT_CLOSED != STT_STALE_SEQ and STT_RAGGED != STT_SEALED;
    var t : SttState = new_stt();
    var rt : u8 = stt_apply(&t, 1, true, 59, "ru", "maybe");
    assert rt == STT_OK;
    assert stt_is_fact(&t) == false;
    var ab : SttState = new_stt();
    var rab : u8 = stt_apply(&ab, 1, false, 40, "ru", "hel");
    assert rab == STT_OK;
    stt_abort(&ab);
    assert stt_is_fact(&ab) == false;
    var f : SttState = new_stt();
    var rf : u8 = stt_apply(&f, 1, true, 60, "ru", "yes");
    assert rf == STT_OK;
    assert stt_is_fact(&f);
    assert stt_is_fact(&t) != stt_is_fact(&f);
}
