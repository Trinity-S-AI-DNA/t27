// SPDX-License-Identifier: Apache-2.0
// specs/t27os/lab_publish.t27 -- where a lab receipt is published: on master, whatever ref was
// dispatched (board Trinity-S-AI-DNA/t27os#3; t27b leg #11889; night loop Refs #11873).
//
// The lab (Trinity-S-AI-DNA/t27os .github/workflows/lab.yml) is dispatched with --ref <branch>
// when a night PR changes the surface's own specs (../specs/os/*.t27), so the run tests the
// branch. Its two publish steps then treated the branch as the receipt home:
//   - job "run": git rebase origin/master replays the BRANCH's commits onto master. Measured
//     2026-10-24, run 40092668897 (ref night/84-sync-owned): add/add conflict in
//     specs/os/sync_gate.t27, then "fatal: Cannot do a soft reset in the middle of a merge";
//     the job failed after its own gate had passed 8/8, no receipt landed, and the t27b job
//     (needs: run) was skipped. Run 40092136103 (ref night/1-map-refresh) failed the same way.
//     Tick 7 had already noted "the receipt push fails on a non-master ref".
//   - job "t27b": git pull --rebase origin master, then git push origin HEAD:master -- when the
//     branch does not conflict, that pushes the branch's unreviewed commits onto master.
//
// The law, here: a receipt commit carries only runs/ files, and it is made on a fresh
// origin/master and pushed to master -- never a rebase or pull of the dispatched ref, never
// a bare push to it. The step texts below are what TRI CLAW places into lab.yml in place of
// the two publish steps. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLabPublish;

use t27os::keysync::contains;

// --- the moves a publish step must make ---------------------------------

pub const FRESH_MASTER : str = "git fetch origin master";
pub const ON_MASTER : str = "git checkout -q -f -B receipt origin/master";
pub const TO_MASTER : str = "git push origin HEAD:master";
pub const RUNS_ONLY : str = "-- runs/";

// --- the moves that carry the dispatched ref into the receipt home ------

pub const BAD_REBASE : str = "rebase";
pub const BAD_PULL : str = "git pull";
pub const BAD_SOFT_RESET : str = "reset --soft";
pub const BAD_BARE_PUSH : str = "git push &&";
pub const BAD_BARE_PUSH_EOL : str = "git push\n";

// --- the two step texts, for lab.yml -------------------------------------
//
// Job "run": the receipt files are committed where they were written, then that commit's
// runs/ files (added or modified) are checked out onto a fresh origin/master and committed
// there. Three attempts, because the surface master moves while a run builds.

pub const RUN_PUBLISH_YAML : str = "      - name: publish the receipt\n        shell: bash\n        run: |\n          # the receipt home is master, whatever ref was dispatched (t27 specs/t27os/lab_publish.t27)\n          git config user.name \"t27os-lab\"\n          git config user.email \"admin@t27.ai\"\n          git add runs/\n          git commit -q -m \"lab receipt (staging)\"\n          rcpt=$(git rev-parse HEAD)\n          for attempt in 1 2 3; do\n            git fetch origin master\n            git checkout -q -f -B receipt origin/master\n            git diff --name-only --diff-filter=AM \"$rcpt~1\" \"$rcpt\" -- runs/ | xargs git checkout \"$rcpt\" --\n            git commit -q -m \"lab receipt: t27@${{ steps.sha.outputs.resolved }} challenge-sha256-published\"\n            git push origin HEAD:master && exit 0\n            sleep 5\n          done\n          exit 1\n";

pub const T27B_PUBLISH_YAML : str = "      - name: publish the t27b leg beside the receipt\n        shell: bash\n        run: |\n          # the receipt home is master, whatever ref was dispatched (t27 specs/t27os/lab_publish.t27)\n          git config user.name \"t27os lab\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add runs/*.t27b.txt\n          git commit -q -m \"lab t27b leg (staging)\"\n          rcpt=$(git rev-parse HEAD)\n          for i in 1 2 3; do\n            git fetch origin master\n            git checkout -q -f -B receipt origin/master\n            git checkout \"$rcpt\" -- runs/${{ needs.run.outputs.resolved }}.t27b.txt\n            git commit -q -m \"lab: t27b leg for ${{ needs.run.outputs.resolved }}\"\n            git push origin HEAD:master && exit 0\n            sleep 5\n          done\n          exit 1\n";

// --- the specimens this law replaces (lab.yml before, 2026-10-24) -------

pub const OLD_RUN_PUBLISH : str = "          git add runs/\n          git commit -m \"lab receipt\"\n          for attempt in 1 2 3; do\n            git fetch origin\n            if git rebase origin/master; then\n              git push && break\n            fi\n            git rebase --abort 2>/dev/null || true\n            git reset --soft origin/master\n            git commit -m \"lab receipt\"\n          done\n          git push\n";

pub const OLD_T27B_PUBLISH : str = "          git add runs/*.t27b.txt\n          git commit -m \"lab: t27b leg\"\n          for i in 1 2 3; do git pull --rebase origin master && git push origin HEAD:master && break; sleep 5; done\n";

// publish_ok(y): a publish step makes its commit on a fresh origin/master, carries only runs/
// files into it, pushes to master, and never rebases, pulls or bare-pushes the dispatched ref.
pub fn publish_ok(y: []const u8) -> bool {
    return contains(y, FRESH_MASTER) and contains(y, ON_MASTER) and contains(y, TO_MASTER)
        and contains(y, RUNS_ONLY)
        and !contains(y, BAD_REBASE) and !contains(y, BAD_PULL) and !contains(y, BAD_SOFT_RESET)
        and !contains(y, BAD_BARE_PUSH) and !contains(y, BAD_BARE_PUSH_EOL);
}

// --- tests ---------------------------------------------------------------

test the_two_step_texts_are_the_law {
    assert publish_ok(RUN_PUBLISH_YAML);
    assert publish_ok(T27B_PUBLISH_YAML);
    // each keeps the commit subject the receipt history is searched by
    assert contains(RUN_PUBLISH_YAML, "lab receipt: t27@${{ steps.sha.outputs.resolved }}");
    assert contains(T27B_PUBLISH_YAML, "lab: t27b leg for ${{ needs.run.outputs.resolved }}");
    // the t27b step carries exactly its own file, not the dispatched tree
    assert contains(T27B_PUBLISH_YAML, "-- runs/${{ needs.run.outputs.resolved }}.t27b.txt");
    // a failed third attempt fails the step instead of passing silently
    assert contains(RUN_PUBLISH_YAML, "exit 1\n");
    assert contains(T27B_PUBLISH_YAML, "exit 1\n");
}

test the_run_40092668897_step_is_refused {
    // negative control: the run job's step that rebased night/84-sync-owned onto master
    assert publish_ok(OLD_RUN_PUBLISH) == false;
    assert contains(OLD_RUN_PUBLISH, BAD_REBASE);
    assert contains(OLD_RUN_PUBLISH, BAD_SOFT_RESET);
}

test the_t27b_step_that_could_push_a_branch_to_master_is_refused {
    // negative control: pull --rebase of the dispatched ref, then push HEAD:master
    assert publish_ok(OLD_T27B_PUBLISH) == false;
    assert contains(OLD_T27B_PUBLISH, TO_MASTER);
    assert contains(OLD_T27B_PUBLISH, BAD_PULL);
}

test each_move_is_load_bearing {
    // dropping any one required move refuses the step
    assert publish_ok("git checkout -q -f -B receipt origin/master\ngit checkout x -- runs/a\ngit push origin HEAD:master\n") == false;
    assert publish_ok("git fetch origin master\ngit checkout x -- runs/a\ngit push origin HEAD:master\n") == false;
    assert publish_ok("git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit checkout x -- runs/a\n") == false;
    assert publish_ok("git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit add -A\ngit push origin HEAD:master\n") == false;
    // the minimal lawful step passes
    assert publish_ok("git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit checkout x -- runs/a\ngit push origin HEAD:master\n");
    // adding a bare push to the dispatched ref refuses it again
    assert publish_ok("git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit checkout x -- runs/a\ngit push origin HEAD:master\ngit push\n") == false;
}

test no_receipt_step_rebases_the_dispatched_ref {
    // a test, not an invariant: t27c lowers an invariant to a Zig comptime block, and a scan
    // of a 900-byte step text there exceeds the comptime branch quota (lab run 40093374520)
    assert contains(RUN_PUBLISH_YAML, BAD_REBASE) == false;
    assert contains(T27B_PUBLISH_YAML, BAD_REBASE) == false;
    assert contains(RUN_PUBLISH_YAML, BAD_PULL) == false;
    assert contains(T27B_PUBLISH_YAML, BAD_PULL) == false;
}
