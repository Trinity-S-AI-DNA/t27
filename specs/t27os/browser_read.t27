// SPDX-License-Identifier: Apache-2.0
// T27 OS browser read -- the ONE contract every adapter (tri CLI, t27 MCP) shares when it reads a
// bounded page text through the CDP reader of cdp_browser_ws.t27. The adapters must not restate
// this law: they call the same reader binary and map this result to their own output format.
//
// The request shape (defaults, fixed by the owner 2026-11-01):
//   exact page URL + limits  ->  find the existing target  ->  connect  ->  bounded read
//   ->  decoded text or a structured refusal.
// Defaults, with no escape hatch in this contract:
//   - only an EXISTING page target: no PUT /json/new, no tab is ever opened;
//   - no tab is closed; the page is never navigated;
//   - no caller-supplied expression: the reader evaluates its own fixed, capped innerText read;
//   - no browser settings are touched.
//
// The structured result carries, on success: the chosen target id, the actual URL, the request id,
// the decoded text, the decoded byte count, the applied limits, and whether the page's own
// substring cut truncated the text. On failure it carries exactly one refusal code from the
// enumeration below -- an unsupported scenario is never reported as partial text.

module T27osBrowserRead;

/// The target-selection law over the exact-URL match count of the CDP target list.
pub const PICK_OK : u8 = 0;
pub const PICK_NOT_FOUND : u8 = 1;
pub const PICK_MULTIPLE : u8 = 2;

/// One exact URL: zero matches is "page not found", one is the target, and two or more is an
/// explicit refusal -- the reader never silently picks among identical tabs.
pub fn pick_target(matches : usize) -> u8 {
  if (matches == 0) { return PICK_NOT_FOUND; }
  if (matches == 1) { return PICK_OK; }
  return PICK_MULTIPLE;
}

/// The refusal codes of the whole route, in contract order. The zero code is success.
pub const OK : u8 = 0;
pub const R_PAGE_NOT_FOUND : u8 = 1;
pub const R_MULTIPLE_MATCHES : u8 = 2;
pub const R_DISCONNECTED : u8 = 3; // the connection dropped before the message completed
pub const R_NO_RESPONSE : u8 = 4; // no answer arrived within the guard budget
pub const R_UNSUPPORTED_FRAME : u8 = 5; // fragmentation, 64-bit length, masked server frame
pub const R_DECODE_ERROR : u8 = 6; // a bad, truncated or lone escape in the response value
pub const R_OVER_LIMIT : u8 = 7; // a limit was exceeded by the exchange itself
pub const R_USAGE : u8 = 8; // the call itself is malformed: a required parameter is missing or out of range

/// The route-level refusal law: the frame-layer refusals (ws_frame.t27 R_*) and the decode-layer
/// refusals (ws_text.t27 E_*) both map onto this enumeration, and the zero code means the text
/// is complete and exact. No other value is ever returned to an adapter.
pub fn route_refusal(frame_refusal : u8, decode_err : u8, disconnected : bool, timed_out : bool) -> u8 {
  if (disconnected) { return R_DISCONNECTED; }
  if (timed_out) { return R_NO_RESPONSE; }
  if (frame_refusal != 0) { return R_UNSUPPORTED_FRAME; }
  if (decode_err != 0) { return R_DECODE_ERROR; }
  return OK;
}

/// The truncation law over ONE snapshot of the source text: the fixed page expression returns
/// the source string length (in page-side characters, i.e. JS string units) TOGETHER WITH the
/// capped text, and truncation is `source length > cap` -- decided on the known source length,
/// never on the length of the already-capped result (a result of exactly cap characters cannot
/// distinguish a source of exactly cap from a longer one).
/// Units: the page length and the cap are page-side string characters; the decoded answer is
/// UTF-8 bytes, a different measure that never feeds this comparison.
pub fn page_truncated(source_len_chars : usize, cap : usize) -> bool {
  return source_len_chars > cap;
}

/// The limits an adapter must echo back to its caller, packed: the page character cap, the input
/// byte cap of the decoder, and the decoded output cap. Three words, fixed by this contract.
pub const LIMIT_PAGE_CHARS : usize = 4000;
pub const LIMIT_IN_BYTES : usize = 16384;
pub const LIMIT_OUT_BYTES : usize = 16384; // the decoded UTF-8 ceiling: every JSON escape expands
// to at least its UTF-8 bytes (ASCII 1:1, \n 2>1, \uXXXX 6>3, a pair 12>4), so the decoded run is
// never longer than the escaped input; 4200 was one observed Cyrillic-free sample, not a bound.

/// The defaults are named so an adapter cannot quietly widen them: one word, all bits set means
/// "existing page only, no open, no close, no navigate, no caller expression".
pub const DEFAULTS : u8 = 31;

test one_exact_match_is_the_target_and_zero_or_many_are_refusals {
  assert pick_target(0) == PICK_NOT_FOUND;
  assert pick_target(1) == PICK_OK;
  assert pick_target(2) == PICK_MULTIPLE;
  assert pick_target(5) == PICK_MULTIPLE;
}

test disconnect_and_timeout_outrank_the_layer_refusals {
  assert route_refusal(1, 1, true, true) == R_DISCONNECTED;
  assert route_refusal(1, 1, false, true) == R_NO_RESPONSE;
}

test the_layer_refusals_map_onto_the_contract_codes {
  assert route_refusal(1, 0, false, false) == R_UNSUPPORTED_FRAME;
  assert route_refusal(0, 1, false, false) == R_DECODE_ERROR;
  assert route_refusal(0, 0, false, false) == OK;
}

test truncation_is_decided_on_the_source_length_never_the_result {
  assert page_truncated(4000, 4000) == false; // a source of exactly cap: not truncated
  assert page_truncated(4001, 4000) == true;
  assert page_truncated(0, 4000) == false;
}

test the_limit_triplet_is_the_contract_triplet {
  assert LIMIT_PAGE_CHARS == 4000;
  assert LIMIT_IN_BYTES == 16384;
  assert LIMIT_OUT_BYTES == 16384; // the decoded UTF-8 ceiling (see the inequality note above)
}

test usage_is_its_own_code_not_a_page_refusal {
  assert R_USAGE == 8;
  assert R_USAGE != R_PAGE_NOT_FOUND;
  assert R_USAGE != R_OVER_LIMIT;
}

test the_defaults_word_names_all_five_exclusions {
  assert DEFAULTS == 31;
}

invariant a_pick_is_never_a_route_refusal {
  assert pick_target(0) == PICK_NOT_FOUND;
  assert R_PAGE_NOT_FOUND == PICK_NOT_FOUND;
}
