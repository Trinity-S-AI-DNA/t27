// The time layer (T27T) events (owner, 2026-11-08): ids 85..99 and 105..107 straddle the forbidden 100..104, which stay
// refused; a skipped schedule at warn or above, a critical bypass at error or above.
test time_events {
    assert tl_surface_id("time") == 15;
    assert tl_surface_name(15).len == 4;
    assert tl_surface_name(TL_SURFACE_LAST + 1).len == 0;
    assert tl_action_id("clock_read") == 85;
    assert tl_action_id("decay_applied") == 99;
    assert tl_action_id("golden_interval_computed") == 105;
    assert tl_action_id("critical_bypass") == 107;
    assert tl_action_id("keystroke") == 100;
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "system", "time", "schedule_fired", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "time", "golden_schedule_created", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "time", "schedule_skipped", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "time", "schedule_skipped", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "time", "critical_bypass", "warn");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "time", "critical_bypass", "error");
    assert tl_validate_line(b[0..n]) == TL_OK;
    // negative control: a forbidden id inside the widened range is still refused, on the new surface too
    n = tl_t_b(b[0..2048], "agent", "time", "keystroke", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
}

test trace_rules {
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_c(b[0..2048], "00000000000000000000000000000000", TL_T_SP, "", "x", "");
    assert tl_validate_line(b[0..n]) == E_TRACE;
    n = tl_t_c(b[0..2048], "0af7651916cd43dd8448eb211c80319", TL_T_SP, "", "x", "");
    assert tl_validate_line(b[0..n]) == E_TRACE;
    n = tl_t_c(b[0..2048], "", TL_T_SP, "", "x", "");
    assert tl_validate_line(b[0..n]) == E_SPAN;
    n = tl_t_c(b[0..2048], TL_T_TR, TL_T_SP, TL_T_SP, "x", "");
    assert tl_validate_line(b[0..n]) == E_PARENT;
    n = tl_t_c(b[0..2048], TL_T_TR, "", TL_T_SP, "x", "");
    assert tl_validate_line(b[0..n]) == E_PARENT;
    n = tl_t_c(b[0..2048], TL_T_TR, TL_T_SP, "", "x", "");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_c(b[0..2048], TL_T_TR, TL_T_SP2, TL_T_SP, "x", "");
    assert tl_validate_line(b[0..n]) == TL_OK;
}

test key_in_payload_is_redacted {
    var pay : [128]u8 = undefined;
    var s : usize = put_bytes(pay[0..128], 0, "use ");
    s = put_bytes(pay[0..128], s, "sk-");
    s = tl_t_fill(pay[0..128], s, 97, 24);
    var raw : [2048]u8 = undefined;
    const rn : usize = tl_t_c(raw[0..2048], TL_T_TR, TL_T_SP, "", pay[0..s], "");
    assert tl_validate_line(raw[0..rn]) == E_SECRET;
    var out : [2048]u8 = undefined;
    const n : usize = tl_normalize(raw[0..rn], out[0..2048]);
    assert n > 0;
    assert tl_validate_line(out[0..n]) == TL_OK;
    assert tl_has(out[0..n], "\"redacted\":true", false);
    assert tl_has(out[0..n], "\"payload\":\"use [REDACTED]\"", false);
    assert !tl_has(out[0..n], "sk-", true);
    var out2 : [2048]u8 = undefined;
    const m : usize = tl_event_line(out2[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", pay[0..s], "");
    assert m > 0;
    assert !tl_has(out2[0..m], "sk-", true);
    assert tl_has(out2[0..m], "[REDACTED]", false);
}

test secret_words_are_refused {
    var b : [2048]u8 = undefined;
    var pay : [64]u8 = undefined;
    var s : usize = put_bytes(pay[0..64], 0, "my pass");
    s = put_bytes(pay[0..64], s, "word is x");
    var n : usize = tl_t_c(b[0..2048], "", "", "", pay[0..s], "");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    n = tl_t_c(b[0..2048], "", "", "", "Cookie: a=b", "");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    n = tl_t_c(b[0..2048], "", "", "", "a Private Key b", "");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    n = tl_t_c(b[0..2048], "", "", "", "Bearer abc", "");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    assert tl_check("t27l/v1", TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", "-----BEGIN x", "") == E_SECRET;
    assert tl_event_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", "Cookie: a=b", "") == 0;
}

test url_query_is_cut {
    var raw : [2048]u8 = undefined;
    const rn : usize = tl_t_c(raw[0..2048], "", "", "", "see http://h/p?token=zz ok", "");
    assert tl_validate_line(raw[0..rn]) == E_SECRET;
    var out : [2048]u8 = undefined;
    const n : usize = tl_normalize(raw[0..rn], out[0..2048]);
    assert n > 0;
    assert tl_has(out[0..n], "\"payload\":\"see http://h/p?[q] ok\"", false);
    assert tl_has(out[0..n], "\"redacted\":true", false);
    assert !tl_has(out[0..n], "zz", false);
    assert tl_validate_line(out[0..n]) == TL_OK;
}

test secrets_in_envelope_fields {
    var key : [64]u8 = undefined;
    var s : usize = put_bytes(key[0..64], 0, "sk-");
    s = tl_t_fill(key[0..64], s, 97, 24);
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_a(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", key[0..s], "sess-1");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    n = tl_t_a(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "bob@example.com");
    assert tl_validate_line(b[0..n]) == E_SECRET;
    assert tl_normalize(b[0..n], key[0..64]) == 0;
}

test duplicate_ingest {
    var a : [2048]u8 = undefined;
    var c : [2048]u8 = undefined;
    const na : usize = tl_event_line(a[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", "one", "");
    const nc : usize = tl_event_line(c[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", "two", "");
    assert na > 0 and nc > 0;
    const ha : u64 = tl_hash(a[0..na]);
    const hc : u64 = tl_hash(c[0..nc]);
    assert ha != hc;
    var ids : [36]u8 = undefined;
    var hs : [1]u64 = undefined;
    const e : usize = put_bytes(ids[0..36], 0, TL_T_EV1);
    assert e == 36;
    hs[0] = ha;
    assert tl_ingest(TL_T_EV1, ha, ids[0..0], hs[0..0], 0) == TL_NEW;
    assert tl_ingest(TL_T_EV1, ha, ids[0..36], hs[0..1], 1) == TL_DUP;
    assert tl_ingest(TL_T_EV1, hc, ids[0..36], hs[0..1], 1) == E_ID_CONFLICT;
    assert tl_ingest(TL_T_EV2, ha, ids[0..36], hs[0..1], 1) == TL_NEW;
    assert tl_ingest(TL_T_EV1, ha, ids[0..36], hs[0..1], 2) == E_MALFORMED;
}

test malformed_lines {
    assert tl_validate_line("") == E_MALFORMED;
    assert tl_validate_line("{") == E_MALFORMED;
    assert tl_validate_line("{\"schema\":\"t27l/v1") == E_MALFORMED;
    assert tl_validate_line("{\"schema:\"x\"}") == E_MALFORMED;
    assert tl_validate_line("{\"unknown\":\"x\"}") == E_MALFORMED;
    assert tl_validate_line("not json") == E_MALFORMED;
    assert tl_validate_line("{\"schema\":\"t27l/v1\",\"schema\":\"t27l/v1\"}") == E_MALFORMED;
    assert tl_validate_line("{\"schema\":t27l}") == E_MALFORMED;
    assert tl_validate_line("{\"schema\":\"t27l/v1\",}") == E_MALFORMED;
    assert tl_validate_line("{\"redacted\":\"yes\"}") == E_MALFORMED;
    var out : [64]u8 = undefined;
    assert tl_normalize("not json", out[0..64]) == 0;
}

test forbidden_actions {
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "user", "pane", "keystroke", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
    n = tl_t_b(b[0..2048], "user", "pane", "key_press", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
    n = tl_t_b(b[0..2048], "user", "pane", "clipboard_read", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
    n = tl_t_b(b[0..2048], "user", "pane", "clipboard_write", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
    n = tl_t_b(b[0..2048], "user", "browser", "screen_raw", "info");
    assert tl_validate_line(b[0..n]) == E_FORBIDDEN_ACTION;
    assert tl_event_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 1, 3, 100, 2, "", "", "", "x", "") == 0;
}

test level_rules {
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "system", "pane", "crash", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "pane", "crash", "error");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "pane", "crash", "fatal");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "pane", "error", "warn");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "pane", "error", "error");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "browser", "console_error", "warn");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "browser", "uncaught_exception", "fatal");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "browser", "network_error", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "browser", "network_error", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "agent", "pane", "log", "debug");
    assert tl_validate_line(b[0..n]) == TL_OK;
}

test traceparent_round_trip {
    var tp : [64]u8 = undefined;
    const n : usize = tl_traceparent(tp[0..64], TL_T_TR, TL_T_SP);
    assert n == 55;
    assert bytes_eq(tp[0..n], "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
    assert tl_traceparent_ok(tp[0..n]);
    assert !tl_traceparent_ok("01-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
    assert !tl_traceparent_ok("00-00000000000000000000000000000000-b7ad6b7169203331-01");
    assert !tl_traceparent_ok("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331");
    assert tl_traceparent(tp[0..64], "0af76519", TL_T_SP) == 0;
}

test child_of_follows_parent_span {
    var p : [2048]u8 = undefined;
    var c : [2048]u8 = undefined;
    var d : [2048]u8 = undefined;
    const np : usize = tl_t_c(p[0..2048], TL_T_TR, TL_T_SP, "", "root", "");
    const nc : usize = tl_t_c(c[0..2048], TL_T_TR, TL_T_SP2, TL_T_SP, "child", "");
    assert tl_child_of(c[0..nc], p[0..np]);
    assert !tl_child_of(p[0..np], c[0..nc]);
    const nd : usize = tl_t_c(d[0..2048], TL_T_TR, TL_T_SP2, "aaaaaaaaaaaaaaaa", "other", "");
    assert !tl_child_of(d[0..nd], p[0..np]);
    const ne : usize = tl_t_c(d[0..2048], "11111111111111111111111111111111", TL_T_SP2, TL_T_SP, "elsewhere", "");
    assert !tl_child_of(d[0..ne], p[0..np]);
}

test menu_row_is_exact {
    var out : [256]u8 = undefined;
    const n : usize = tl_menu_row(TL_T_LINE, out[0..256]);
    assert bytes_eq(out[0..n], "12:34:56 INFO pane agent_step 0af76519 step one");
    var b : [2048]u8 = undefined;
    var long : [128]u8 = undefined;
    const ln : usize = tl_t_fill(long[0..128], 0, 121, 70);
    const nb : usize = tl_t_c(b[0..2048], "", "", "", long[0..ln], "");
    const m : usize = tl_menu_row(b[0..nb], out[0..256]);
    assert m == 92;
    assert bytes_eq(out[0..32], "12:34:56 INFO pane agent_step - ");
    var key : [128]u8 = undefined;
    var s : usize = put_bytes(key[0..128], 0, "ghp_");
    s = tl_t_fill(key[0..128], s, 98, 36);
    const nr : usize = tl_t_c(b[0..2048], "", "", "", key[0..s], "");
    assert tl_menu_row(b[0..nr], out[0..256]) == 0;
    assert tl_menu_row("not json", out[0..256]) == 0;
    assert tl_menu_row(TL_T_LINE, out[0..64]) == 0;
}

test filter_by_level_and_surface {
    assert tl_filter(TL_T_LINE, 1, 4);
    assert tl_filter(TL_T_LINE, 2, 4);
    assert !tl_filter(TL_T_LINE, 3, 4);
    assert !tl_filter(TL_T_LINE, 1, 1);
    assert tl_filter(TL_T_LINE, 1, 511);
    assert !tl_filter(TL_T_LINE, 1, 0);
    assert !tl_filter("not json", 1, 511);
}

test export_adds_one_newline {
    var out : [2048]u8 = undefined;
    const n : usize = tl_export(TL_T_LINE, out[0..2048]);
    assert n == TL_T_LINE.len + 1;
    assert out[n - 1] == 10;
    assert bytes_eq(out[0..(n - 1)], TL_T_LINE);
    var key : [128]u8 = undefined;
    var s : usize = put_bytes(key[0..128], 0, "ghp_");
    s = tl_t_fill(key[0..128], s, 98, 36);
    var raw : [2048]u8 = undefined;
    const rn : usize = tl_t_c(raw[0..2048], "", "", "", key[0..s], "");
    assert tl_export(raw[0..rn], out[0..2048]) == 0;
}

test cli_args_take_no_secrets {
    assert tl_arg_ok("validate");
    assert tl_arg_ok("--session");
    assert tl_arg_ok("sess-1");
    assert tl_arg_ok(TL_T_TR);
    var key : [128]u8 = undefined;
    var s : usize = put_bytes(key[0..128], 0, "ghp_");
    s = tl_t_fill(key[0..128], s, 98, 36);
    assert !tl_arg_ok(key[0..s]);
    assert !tl_arg_ok("bob@example.com");
    assert !tl_arg_ok("API_KEY=abc123");
    assert !tl_arg_ok("Cookie: a=b");
}

test free_text_names_topics_not_secrets {
    const nist : str = "verifiers should not require periodic password changes";
    assert tl_text_safe(nist);
    assert !tl_arg_ok(nist);
    assert tl_text_safe("");
    assert !tl_text_safe("bob@example.com");
    assert !tl_text_safe("API_KEY=abc123");
    assert !tl_text_safe("Authorization: x");
    assert !tl_text_safe("-----BEGIN RSA PRIVATE KEY-----");
    var key : [128]u8 = undefined;
    var s : usize = put_bytes(key[0..128], 0, "ghp_");
    s = tl_t_fill(key[0..128], s, 98, 36);
    assert !tl_text_safe(key[0..s]);
}

test evidence_rules {
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_c(b[0..2048], "", "", "", "x", "\"ev-0123456789abcdef\"");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_c(b[0..2048], "", "", "", "x", "\"ev-0123456789abcdef\",\"ev-fedcba9876543210\"");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_c(b[0..2048], "", "", "", "x", "\"ev-ZZZ\"");
    assert tl_validate_line(b[0..n]) == E_EVIDENCE;
    n = tl_t_c(b[0..2048], "", "", "", "x", "\"EV-0123456789abcdef\"");
    assert tl_validate_line(b[0..n]) == E_EVIDENCE;
    n = tl_t_c(b[0..2048], "", "", "", "x", "ev-0123456789abcdef");
    assert tl_validate_line(b[0..n]) == E_EVIDENCE;
    assert tl_evidence_ok("ev-0123456789abcdef,ev-fedcba9876543210");
    assert !tl_evidence_ok("ev-0123456789abcdef,");
    assert !tl_evidence_ok("ev-0123456789abcde");
    assert tl_event_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", "x", "ev-bad") == 0;
}

test payload_over_limit {
    var long : [1200]u8 = undefined;
    const ln : usize = tl_t_fill(long[0..1200], 0, 120, 1100);
    var b : [2048]u8 = undefined;
    const n : usize = tl_t_c(b[0..2048], "", "", "", long[0..ln], "");
    assert tl_validate_line(b[0..n]) == E_TOO_LONG;
    const ok : usize = tl_t_fill(long[0..1200], 0, 120, 1024);
    const m : usize = tl_t_c(b[0..2048], "", "", "", long[0..ok], "");
    assert tl_validate_line(b[0..m]) == TL_OK;
    assert tl_event_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, "", "", "", long[0..ln], "") == 0;
}

test normalize_is_idempotent_with_escapes {
    var pay : [32]u8 = undefined;
    var s : usize = put_bytes(pay[0..32], 0, "a \"q\" \\ b");
    pay[s] = 10;
    s = s + 1;
    var a : [2048]u8 = undefined;
    const na : usize = tl_event_line(a[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, TL_T_TR, TL_T_SP, "", pay[0..s], "ev-0123456789abcdef");
    assert na > 0;
    assert tl_validate_line(a[0..na]) == TL_OK;
    var b : [2048]u8 = undefined;
    const nb : usize = tl_normalize(a[0..na], b[0..2048]);
    assert nb == na;
    assert bytes_eq(a[0..na], b[0..nb]);
    var out : [256]u8 = undefined;
    const m : usize = tl_menu_row(a[0..na], out[0..256]);
    assert bytes_eq(out[0..m], "12:34:56 INFO pane agent_step 0af76519 a \"q\" \\ b ");
}

// ---- the `tri t27l validate` contract: golden and property tests (owner order MIGRATE_TRI_RUST_TO_T27) ----

/// The json and text outputs of a run on this target and format: both pass tl_text_safe and neither holds the target.
fn tl_vt_no_echo(target: []const u8, format: []const u8) -> bool {
    const r : u8 = tl_vcmd_check(target, format, true, true);
    var out : [256]u8 = undefined;
    const n : usize = tl_vcmd_out(out[0..256], TL_FMT_JSON, r, 2, 1, 2);
    if (n == 0 or !tl_text_safe(out[0..n])) { return false; }
    if (tl_has(out[0..n], target, false)) { return false; }
    const m : usize = tl_vcmd_out(out[0..256], TL_FMT_TEXT, r, 2, 1, 2);
    if (m == 0 or !tl_text_safe(out[0..m])) { return false; }
    return !tl_has(out[0..m], target, false);
}

test valid_target_passes {
    assert tl_vcmd_check("logs/t27l.jsonl", "", true, true) == TL_VR_NONE;
    assert tl_vcmd_check("logs/t27l.jsonl", "json", true, true) == TL_VR_NONE;
    var a : [2048]u8 = undefined;
    const na : usize = tl_event_line(a[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", 2, 3, 5, 2, TL_T_TR, TL_T_SP, "", "step one", "");
    assert na > 0;
    assert tl_vcmd_line(a[0..na]) == 0;
    assert tl_vcmd_line("") == 3;
    const r : u8 = tl_vcmd_result(false, 0, 0, true);
    assert r == TL_VR_NONE;
    assert tl_vcmd_exit(tl_vreason_status(r)) == TL_EXIT_OK;
    var out : [256]u8 = undefined;
    const n : usize = tl_vcmd_out(out[0..256], TL_FMT_JSON, r, 1, 0, 0);
    assert bytes_eq(out[0..n], "{\"status\":\"ok\",\"reason\":\"none\",\"lines\":1,\"bad\":0,\"first_bad\":0}");
    const m : usize = tl_vcmd_out(out[0..256], TL_FMT_TEXT, r, 1, 0, 0);
    assert bytes_eq(out[0..m], "ok none lines 1 bad 0 first_bad 0");
}

test missing_target_fails {
    assert tl_vcmd_check("", "", false, false) == TL_VR_TARGET_MISSING;
    assert tl_vcmd_check("logs/none.jsonl", "", false, false) == TL_VR_NOT_FOUND;
    assert tl_vcmd_check("logs/locked.jsonl", "text", true, false) == TL_VR_UNREADABLE;
    assert tl_vcmd_check("logs/t27l.jsonl", "yaml", true, true) == TL_VR_FORMAT;
    // the format is checked before the file: an unknown format on a missing target says unknown_format
    assert tl_vcmd_check("logs/none.jsonl", "yaml", false, false) == TL_VR_FORMAT;
    assert tl_vcmd_check("API_KEY=abc123", "", true, true) == TL_VR_SECRET_ARG;
    assert tl_vcmd_check("my-password.jsonl", "", true, true) == TL_VR_SECRET_ARG;
    var long : [1100]u8 = undefined;
    const ln : usize = tl_t_fill(long[0..1100], 0, 97, 1025);
    assert tl_vcmd_check(long[0..ln], "", true, true) == TL_VR_TOO_LONG;
    assert tl_vcmd_exit(tl_vreason_status(TL_VR_TARGET_MISSING)) == TL_EXIT_INVALID;
    assert tl_vcmd_exit(tl_vreason_status(TL_VR_NOT_FOUND)) == TL_EXIT_INVALID;
    assert tl_vcmd_exit(tl_vreason_status(TL_VR_IO)) == TL_EXIT_FAILED;
}

test json_output_schema {
    assert tl_vcmd_line("{\"schema\":\"t27l/v1\"}") == 1;
    assert tl_vcmd_result(false, 1, 0, false) == TL_VR_BAD_LINES;
    assert tl_vcmd_result(false, 0, 2, false) == TL_VR_NONE;
    assert tl_vcmd_result(false, 0, 2, true) == TL_VR_NON_CANONICAL;
    assert tl_vcmd_result(true, 0, 0, false) == TL_VR_IO;
    var out : [256]u8 = undefined;
    var n : usize = tl_vcmd_json(out[0..256], TL_VR_BAD_LINES, 3, 1, 2);
    assert bytes_eq(out[0..n], "{\"status\":\"failed\",\"reason\":\"bad_lines\",\"lines\":3,\"bad\":1,\"first_bad\":2}");
    n = tl_vcmd_json(out[0..256], TL_VR_FORMAT, 0, 0, 0);
    assert bytes_eq(out[0..n], "{\"status\":\"invalid_input\",\"reason\":\"unknown_format\",\"lines\":0,\"bad\":0,\"first_bad\":0}");
    n = tl_vcmd_text(out[0..256], TL_VR_BAD_LINES, 3, 1, 2);
    assert bytes_eq(out[0..n], "failed bad_lines lines 3 bad 1 first_bad 2");
    assert tl_vcmd_json(out[0..159], TL_VR_NONE, 1, 0, 0) == 0;
    assert tl_format_id("json") == TL_FMT_JSON;
    assert tl_format_id("JSON") == 0;
}

// property: for every reason (and two past the last), the exit code matches the status, and an unknown one fails closed
test exit_code_matches_status {
    var r : u8 = 0;
    while (r <= TL_VR_LAST + 2) {
        const st : u8 = tl_vreason_status(r);
        const ex : u8 = tl_vcmd_exit(st);
        assert tl_status_name(st).len > 0;
        assert (st == TL_ST_OK) == (ex == TL_EXIT_OK);
        assert (st == TL_ST_INVALID) == (ex == TL_EXIT_INVALID);
        assert (st == TL_ST_FAILED) == (ex == TL_EXIT_FAILED);
        assert (r == TL_VR_NONE) == (ex == TL_EXIT_OK);
        r = r + 1;
    }
    assert tl_vcmd_exit(0) == TL_EXIT_FAILED;
    assert tl_vcmd_exit(9) == TL_EXIT_FAILED;
    assert tl_vreason_name(TL_VR_LAST + 1).len == 0;
}

// property: no secret in the output regardless of the input; the output never echoes the target
test no_secret_in_output {
    assert tl_vt_no_echo("logs/t27l.jsonl", "json");
    assert tl_vt_no_echo("API_KEY=abc123", "json");
    assert tl_vt_no_echo("-----BEGIN RSA PRIVATE KEY-----", "text");
    assert tl_vt_no_echo("bob@example.com", "");
    assert tl_vt_no_echo("Authorization: x", "yaml");
    assert tl_vt_no_echo("Cookie: a=b", "json");
}

test undeclared_effects_are_denied {
    assert tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_READ_FS);
    assert tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_TELEMETRY);
    assert tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_VALIDATE_EFFECTS);
    assert tl_effect_allowed(TL_VALIDATE_EFFECTS, 0);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_WRITE_FS);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_NETWORK);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_SECRETS);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_PROCESS);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, TL_EFF_READ_FS + TL_EFF_NETWORK);
    assert !tl_effect_allowed(TL_VALIDATE_EFFECTS, 64);
    assert !tl_effect_allowed(255, TL_EFF_READ_FS);
    var b : [2048]u8 = undefined;
    const n : usize = tl_effect_denied_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", TL_T_TR, TL_T_SP, "validate", TL_VALIDATE_EFFECTS, TL_EFF_NETWORK);
    assert n > 0;
    assert tl_validate_line(b[0..n]) == TL_OK;
    assert tl_filter(b[0..n], 3, 65536);
    assert !tl_filter(b[0..n], 4, 65536);
    assert tl_effect_denied_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", TL_T_TR, TL_T_SP, "validate", TL_VALIDATE_EFFECTS, TL_EFF_READ_FS) == 0;
    assert tl_effect_denied_line(b[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "mac-1", "sess-1", TL_T_TR, TL_T_SP, "API_KEY=abc123", TL_VALIDATE_EFFECTS, TL_EFF_NETWORK) == 0;
}

test ci_and_migration_events {
    assert tl_surface_id("ci") == 16;
    assert tl_surface_id("migration") == 17;
    assert tl_action_id("billing_status_checked") == 108;
    assert tl_action_id("untrusted_pr_blocked") == 122;
    assert tl_action_id("migration_dry_run") == 123;
    assert tl_action_id("contract_promoted") == 128;
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "system", "ci", "runner_offline", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "ci", "runner_offline", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "agent", "ci", "cache_hit", "debug");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "ci", "untrusted_pr_blocked", "debug");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "migration", "migration_rolled_back", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "migration", "effect_denied", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "agent", "migraton", "migration_dry_run", "info");
    assert tl_validate_line(b[0..n]) == E_SURFACE;
}

test migration_runner_is_reversible {
    assert tl_mig_mode(true, false, false) == TL_MM_DRY_RUN;
    assert tl_mig_mode(false, true, false) == TL_MM_CHECKPOINT;
    assert tl_mig_mode(false, false, true) == TL_MM_ROLLBACK;
    assert tl_mig_mode(false, false, false) == 0;
    assert tl_mig_mode(true, true, false) == 0;
    assert tl_mig_mode(true, true, true) == 0;
    assert tl_mig_next(TL_MIG_LEGACY, TL_MM_DRY_RUN, true) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_LEGACY, TL_MM_CONTRACT, true) == TL_MIG_CONTRACT;
    assert tl_mig_next(TL_MIG_LEGACY, TL_MM_CONTRACT, false) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_CONTRACT, TL_MM_DRY_RUN, false) == TL_MIG_CONTRACT;
    assert tl_mig_next(TL_MIG_CONTRACT, TL_MM_DRY_RUN, true) == TL_MIG_DRY_OK;
    assert tl_mig_next(TL_MIG_CONTRACT, TL_MM_CHECKPOINT, true) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_DRY_OK, TL_MM_CHECKPOINT, true) == TL_MIG_CHECKPOINT;
    assert tl_mig_next(TL_MIG_DRY_OK, TL_MM_APPLY, true) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_CHECKPOINT, TL_MM_APPLY, false) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_CHECKPOINT, TL_MM_APPLY, true) == TL_MIG_APPLIED;
    assert tl_mig_next(TL_MIG_DRY_OK, TL_MM_ROLLBACK, true) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_APPLIED, TL_MM_ROLLBACK, false) == TL_MIG_ROLLED_BACK;
    assert tl_mig_next(TL_MIG_APPLIED, TL_MM_DRY_RUN, true) == TL_MIG_REFUSED;
    assert tl_mig_next(TL_MIG_ROLLED_BACK, TL_MM_DRY_RUN, true) == TL_MIG_DRY_OK;
    assert tl_mig_next(TL_MIG_CONTRACT, 0, true) == TL_MIG_REFUSED;
    assert bytes_eq(tl_action_name(tl_mig_action(TL_MM_ROLLBACK)), "migration_rolled_back");
    assert bytes_eq(tl_action_name(tl_mig_action(TL_MM_CONTRACT)), "contract_promoted");
    assert tl_mig_action(0) == 0;
    // property: applied is reached only from a checkpoint with green tests; a rollback only from a checkpoint or applied
    var s : u8 = 0;
    while (s <= TL_MIG_ROLLED_BACK) {
        var mo : u8 = 1;
        while (mo <= TL_MM_CONTRACT) {
            const red : u8 = tl_mig_next(s, mo, false);
            const grn : u8 = tl_mig_next(s, mo, true);
            assert red != TL_MIG_APPLIED;
            assert (grn != TL_MIG_APPLIED) or (s == TL_MIG_CHECKPOINT);
            assert (grn != TL_MIG_ROLLED_BACK) or (s == TL_MIG_CHECKPOINT or s == TL_MIG_APPLIED);
            assert (red != TL_MIG_ROLLED_BACK) or (s == TL_MIG_CHECKPOINT or s == TL_MIG_APPLIED);
            mo = mo + 1;
        }
        s = s + 1;
    }
}

test hex_helpers_shared_with_importers {
    assert tl_hexval(48) == 0;
    assert tl_hexval(57) == 9;
    assert tl_hexval(97) == 10;
    assert tl_hexval(102) == 15;
    assert tl_hexval(65) == 10;
    assert tl_hexval(70) == 15;
    assert tl_hexval(71) >= 16;
    assert tl_hexval(103) >= 16;
    assert tl_hexval(16) >= 16;
    var out : [20]u8 = undefined;
    const n : usize = tl_put_hex16(out[0..20], 2, 3054198966);
    assert n == 18;
    assert bytes_eq(out[2..18], "00000000b60b60b6");
    const z : usize = tl_put_hex16(out[0..20], 0, 0);
    assert bytes_eq(out[0..z], "0000000000000000");
}

// Bounded recovery events (owner order 2026-11-08): eight new ids; the order's other five names are existing
// actions and get no second id, so one event keeps one name.
test bounded_recovery_events {
    assert tl_action_id("swap_gate_state_changed") == 129;
    assert tl_action_id("mailbox_backpressure_triggered") == 130;
    assert tl_action_id("source_provenance_recorded") == 131;
    assert tl_action_id("test_run_started") == 132;
    assert tl_action_id("test_run_completed") == 133;
    assert tl_action_id("commit_prepared") == 134;
    assert tl_action_id("commit_approved") == 135;
    assert tl_action_id("push_approved") == 136;
    assert tl_action_id("resource_snapshot_recorded") == 0;
    assert tl_action_id("owner_action_suggested") == 0;
    assert tl_action_id("owner_action_confirmed") == 0;
    assert tl_action_id("deadletter_created") == 0;
    assert tl_action_id("recovery_suggested") == 40;
    assert tl_action_id("recovery_approved") == 41;
    assert tl_action_id("recovery_verified") == 43;
    assert tl_action_id("message_deadlettered") == 72;
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "system", "system", "swap_gate_state_changed", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "system", "system", "mailbox_backpressure_triggered", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "system", "system", "mailbox_backpressure_triggered", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "user", "system", "push_approved", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
}

