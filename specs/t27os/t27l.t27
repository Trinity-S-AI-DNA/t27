// Roadmap dashboard sync and issue hygiene (owner order T27V_ROADMAP_DASHBOARD_SYNC V3, 2026-11-08): eighteen new
// ids. The order's deadletter_created is message_deadlettered 72, so one event keeps one name. The order's actor
// 0xPlanner@product.t27 is an agent; the actor field is one of user/agent/system, so the name lives in the payload.
test roadmap_events {
    assert tl_surface_id("roadmap") == 19;
    assert tl_surface_id("roadmap") == TL_SURFACE_LAST;
    assert tl_action_id("roadmap_membership_changed") == 157;
    assert tl_action_id("priority_changed") == 158;
    assert tl_action_id("board_column_changed") == 159;
    assert tl_action_id("label_added") == 160;
    assert tl_action_id("label_removed") == 161;
    assert tl_action_id("label_sync_failed") == 162;
    assert tl_action_id("roadmap_synced") == 163;
    assert tl_action_id("sync_overflow") == 164;
    assert tl_action_id("owner_approval_required") == 165;
    assert tl_action_id("dashboard_view_changed") == 166;
    assert tl_action_id("issue_duplicate_detected") == 167;
    assert tl_action_id("issue_stale_detected") == 168;
    assert tl_action_id("issue_resolved_elsewhere_detected") == 169;
    assert tl_action_id("issue_close_recommended") == 170;
    assert tl_action_id("issue_closed_with_evidence") == 171;
    assert tl_action_id("issue_archive_recommended") == 172;
    assert tl_action_id("hygiene_cron_run") == 173;
    assert tl_action_id("hygiene_overflow") == 174;
    assert tl_action_id("hygiene_overflow") == TL_ACTION_LAST;
    assert tl_action_id("deadletter_created") == 0;
    assert tl_action_id("message_deadlettered") == 72;
    // one dashboard with filters: a filter change is dashboard_view_changed, there is no view switch
    assert tl_action_id("view_switched") == 0;
    // there is no delete verb for an issue: only close or archive
    assert tl_action_id("issue_deleted") == 0;
    var b : [2048]u8 = undefined;
    var n : usize = tl_t_b(b[0..2048], "agent", "roadmap", "sync_overflow", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "agent", "roadmap", "sync_overflow", "warn");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "agent", "roadmap", "label_sync_failed", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "agent", "roadmap", "hygiene_overflow", "info");
    assert tl_validate_line(b[0..n]) == E_LEVEL_MISMATCH;
    n = tl_t_b(b[0..2048], "agent", "roadmap", "roadmap_synced", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
    n = tl_t_b(b[0..2048], "agent", "roadmap", "issue_close_recommended", "info");
    assert tl_validate_line(b[0..n]) == TL_OK;
}
