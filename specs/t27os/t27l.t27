// SPDX-License-Identifier: Apache-2.0
; specs/t27os/t27l.t27 -- T27L core: the unified telemetry of T27 OS (letter L, tool t27l, page LOGS in agent_parts.t27).
; Schema "t27l/v1": every source (course HUD, dev view, panes, viewer, neko, Menu L, browser adapter) emits one JSON line.
; This spec is PURE (no host I/O). It checks a line, redacts it, normalizes it to ONE canonical line, decides duplicates,
; correlates traces, renders a Menu L row, exports a line and checks CLI arguments. Persisting and showing are the host's job.
; Boundaries:
;   1. No source writes to Menu L directly: only a stored, normalized line renders (tl_menu_row refuses anything else).
;   2. No source bypasses validation: a line with a bad field, a forbidden action or an unredacted secret is refused.
;   3. Redaction runs before persistence, export, render and evidence binding (tl_normalize first, tl_validate_line as gate).
;   4. Never captured: keystrokes, clipboard, raw screen contents, private files. Those actions have their own reject code.
;   5. Duplicates: the same event_id with the same line hash is ignored (idempotent), the same id with another hash is a conflict.
; v1 simplifications, stated plainly: payload is ONE JSON string (not an object); ts must be UTC and end in Z; unknown keys
; are rejected; evidence is a JSON array of ev-<16 hex> ids, at most 8; the line hash is a 32-bit FNV-1a (chat_log text_hash).
; Canonical line (one key order, no spaces):
;   {"schema","event_id","ts","device_id","session_id","actor","surface","action","level","trace_id","span_id",
;    "parent_span_id","redacted","payload","evidence"}
; CLI: the proposed commands `tri t27l tail`, `tri t27l validate`, `tri t27l export` are NOT BUILT. They would accept no
; secret values as arguments; tl_arg_ok is that check.
; Not here: the T27 OS window view, the browser adapter, evidence records and the screenshot gate (t27l_evidence.t27).
; phi^2 + 1/phi^2 = 3 | TRINITY
module T27osT27l;

use t27os::session_store::put_dec;
use t27os::session_store::put_bytes;
use t27os::share::redact;
use t27os::share::redacted_total;
use t27os::chat_log::text_hash;
use std::mem::bytes_eq;
use t27os::keysync::hex_val;

// ---- result codes: stable, never renumbered ----

pub const TL_OK : u8 = 0;
pub const E_SCHEMA : u8 = 1;
pub const E_MISSING : u8 = 2;
pub const E_EVENT_ID : u8 = 3;
pub const E_TS : u8 = 4;
pub const E_ACTOR : u8 = 5;
pub const E_SURFACE : u8 = 6;
pub const E_ACTION : u8 = 7;
pub const E_LEVEL : u8 = 8;
pub const E_TRACE : u8 = 9;
pub const E_SPAN : u8 = 10;
pub const E_PARENT : u8 = 11;
pub const E_SECRET : u8 = 12;
pub const E_FORBIDDEN_ACTION : u8 = 13;
pub const E_TOO_LONG : u8 = 14;
pub const E_MALFORMED : u8 = 15;
pub const E_LEVEL_MISMATCH : u8 = 16;
pub const E_EVIDENCE : u8 = 17;
pub const E_ID_CONFLICT : u8 = 18;
/// Ingest results: a first sight of the id, and a repeat that is ignored.
pub const TL_NEW : u8 = 30;
pub const TL_DUP : u8 = 31;

pub const TL_PAYLOAD_MAX : usize = 1024;
pub const TL_RAW_MAX : usize = 2048;
pub const TL_ROW_PAYLOAD : usize = 60;
/// Parsed spans: three u32 per field (start, end, kind), 15 fields.
pub const TL_SPANS : usize = 45;
/// The last surface and action ids; the id lookups and tl_check read these, never a literal.
pub const TL_SURFACE_LAST : u8 = 19;
pub const TL_ACTION_LAST : u8 = 174;

// ---- enums: 0 is "unknown"; actions 100..104 are the forbidden ones ----

/// actor: 1 user, 2 agent, 3 system.
pub fn tl_actor_name(a: u8) -> []const u8 {
    if (a == 1) { return "user"; }
    if (a == 2) { return "agent"; }
    if (a == 3) { return "system"; }
    return "";
}

/// surface: 1 course_hud, 2 dev_view, 3 pane, 4 viewer, 5 neko, 6 menu_l, 7 browser, 8 other, 9 cost (claw/cost_policy.t27),
/// 10 system (resource guards, queen/lab_job_msg.t27, and the resource doctor, t27os/doctor_mem.t27), 11 agent (the agent
/// registry, queen/agent_registry.t27), 12 security (the secret custodian T27S, vault/custodian.t27), 13 research (the
/// research knowledge base T27R, t27os/t27r.t27), 14 memory (the memory-actor layer T27M, t27os/t27m.t27), 15 time (the
/// time layer T27T, t27os/t27t.t27), 16 ci (the CI runner policy, ci/runner_policy.t27), 17 migration (the command
/// migration contracts of this file, section "tri t27l validate contract"), 18 visual (the Lukomorye graph terminal
/// T27V, t27f/lukomorye_graph_terminal.t27), 19 roadmap (the roadmap dashboard sync and the issue hygiene engine,
/// tri/trigit/roadmap_dashboard_sync.t27 and tri/trigit/issue_hygiene_engine.t27).
pub fn tl_surface_name(s: u8) -> []const u8 {
    if (s == 1) { return "course_hud"; }
    if (s == 2) { return "dev_view"; }
    if (s == 3) { return "pane"; }
    if (s == 4) { return "viewer"; }
    if (s == 5) { return "neko"; }
    if (s == 6) { return "menu_l"; }
    if (s == 7) { return "browser"; }
    if (s == 8) { return "other"; }
    if (s == 9) { return "cost"; }
    if (s == 10) { return "system"; }
    if (s == 11) { return "agent"; }
    if (s == 12) { return "security"; }
    if (s == 13) { return "research"; }
    if (s == 14) { return "memory"; }
    if (s == 15) { return "time"; }
    if (s == 16) { return "ci"; }
    if (s == 17) { return "migration"; }
    if (s == 18) { return "visual"; }
    if (s == 19) { return "roadmap"; }
    return "";
}

/// level: 1 debug, 2 info, 3 warn, 4 error, 5 fatal.
pub fn tl_level_name(l: u8) -> []const u8 {
    if (l == 1) { return "debug"; }
    if (l == 2) { return "info"; }
    if (l == 3) { return "warn"; }
    if (l == 4) { return "error"; }
    if (l == 5) { return "fatal"; }
    return "";
}

/// action 1..TL_ACTION_LAST (25 llm_call and 26 route_decision are the cost events, claw/cost_policy.t27;
/// 27 resource_guard_triggered is the swap/load/disk gate, queen/lab_job_msg.t27; 28 evidence_approved is the owner's
/// append-only approval record; 29..37 are the agent registry events, queen/agent_registry.t27; 38..46 are the resource
/// doctor's MAPE-K events, t27os/doctor_mem.t27; 47..57 are the secret custodian's events, vault/custodian.t27, whose
/// payloads carry an alias and codes, never a value; 58..67 are the research knowledge base's events, t27os/t27r.t27, one per
/// item, never one per batch; 68..84 are the memory-actor layer's events, t27os/t27m.t27; 85..99 and 105..107 are the time
/// layer's events, t27os/t27t.t27; 108..122 are the CI runner events, ci/runner_policy.t27, action = 107 + its CR_EV code;
/// 123..128 are the command migration events of this file; 129..136 are the bounded recovery events; 137..156 are the
/// Lukomorye graph terminal's events, t27f/lukomorye_graph_terminal.t27, and there is no view_switched; 157..174 are the
/// roadmap dashboard sync and issue hygiene events, tri/trigit/, whose deadletter_created is message_deadlettered 72,
