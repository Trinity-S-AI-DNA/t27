// SPDX-License-Identifier: Apache-2.0
; specs/t27os/live_data.t27 -- the data T27 OS re-reads while it runs (owner, 2026-10-21: update in real time).
; This file IS the asset t27os-live.t27 of the release t27os-latest: `tri t27os publish --yes` uploads it with the
; build, and the running window polls it every minute (release.t27 check_cmd, a conditional GET), parses it with
; hot_reload.t27 live_check / live_apply / live_petals and applies it on the next frame. No rebuild, no restart,
; no bundle swap. Edit a value, raise LIVE_REV, upload the asset (cp this file to t27os-live.t27 and
; `gh release upload t27os-latest t27os-live.t27 --clobber`): every running window follows within a minute.
; Rules (hot_reload.t27): the module line, LIVE_REV and LIVE_END must be present; a lower LIVE_REV than the one
; applied is ignored; a TH_ value is permille (0..1000), anything else keeps the built-in; PETALS must hold as many
; names as the built-in list. A test in glass_window.t27 holds these defaults equal to the built-in constants, so
; publishing this file unedited changes nothing.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLive;

// 2 (2026-10-25): petal 7 ARENA -> AGENTS (the swarm page, t27os#3) and petal 12 LAB -> LOGS, repairing the
// miss of #12002 -- this list had kept LAB while the built-in WORLD_NAMES said LOGS, so the two had drifted.
pub const LIVE_REV : u32 = 2;

; the glass and the surface levels (permille)
pub const TH_TINT_BLACK : u32 = 550;
pub const TH_STRICT_SIDE : u32 = 450;
pub const TH_ELEVATED_BLACK : u32 = 580;
pub const TH_STRICT_CONTENT : u32 = 350;
pub const TH_PANEL_BLACK : u32 = 580;

; the white levels of text, lines and marks (permille)
pub const TH_TEXT_WHITE : u32 = 880;
pub const TH_LABEL_WHITE : u32 = 500;
pub const TH_MUTED_WHITE : u32 = 620;
pub const TH_BORDER_WHITE : u32 = 140;
pub const TH_LINE_WHITE : u32 = 120;
pub const TH_HIGHLIGHT_WHITE : u32 = 80;
pub const TH_TIP_WHITE : u32 = 940;
pub const TH_CROWN_WHITE : u32 = 700;

; the terminal tint and the agents line (permille)
pub const TH_TERMINAL_TINT : u32 = 150;
pub const TH_AGENTS_LINE_ALPHA : u32 = 600;

; the petal names, in order (the window shows them; the count must not change)
pub const PETALS : str = "ISA,BENCH,CHAT,HEALTH,EXPERIENCE,FRONTEND,AGENTS,HIVE,ISSUES,JOBS,KANBAN,LOGS,MAP,PULSE,OUROBOROS,PULLS,QUEEN,ROADMAP,SPECS,TRAINER,UNIVERSITY,VERDICTS,WIDGETS,EXTERNAL,YIELD,DOCS,SECURITY";

pub const LIVE_END : u32 = 1;

/// The hot_reload.t27 rule on a TH_ value: it is applied only when it is a permille (0..1000);
/// anything else keeps the built-in default.
pub fn th_ok(v : u32) -> bool {
    return v <= 1000;
}

/// The end sentinel the live parser stops at (LIVE_END must be present, hot_reload.t27). No newline
/// sentinel is declared: this value is the file's end.
pub fn is_live_end(v : u32) -> bool {
    return v == 1;
}

/// A level on the white side of the glass: more than half of the permille scale, so it brightens.
pub fn th_white_side(v : u32) -> bool {
    return v > 500;
}

/// A level on the black side of the glass: less than half of the permille scale, so it darkens.
pub fn th_black_side(v : u32) -> bool {
    return v < 500;
}

/// The number of names in a comma-separated list (PETALS must hold as many names as the built-in
/// list; the count must not change).
pub fn petal_count(list : str) -> u32 {
    var n : u32 = 1;
    var i : usize = 0;
    while (i < list.len) {
        if (@as(u8, list[i]) == 44) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test every_theme_value_is_a_permille_and_the_file_ends {
    assert(TH_TINT_BLACK <= 1000);
    assert(TH_STRICT_SIDE <= 1000);
    assert(TH_ELEVATED_BLACK <= 1000);
    assert(TH_STRICT_CONTENT <= 1000);
    assert(TH_PANEL_BLACK <= 1000);
    assert(TH_TEXT_WHITE <= 1000);
    assert(TH_LABEL_WHITE <= 1000);
    assert(TH_MUTED_WHITE <= 1000);
    assert(TH_BORDER_WHITE <= 1000);
    assert(TH_LINE_WHITE <= 1000);
    assert(TH_HIGHLIGHT_WHITE <= 1000);
    assert(TH_TIP_WHITE <= 1000);
    assert(TH_CROWN_WHITE <= 1000);
    assert(TH_TERMINAL_TINT <= 1000);
    assert(TH_AGENTS_LINE_ALPHA <= 1000);
    assert(LIVE_REV >= 1);
    // the same permille rule, executed: every theme value the window can apply passes th_ok
    var th : [15]u32 = [TH_TINT_BLACK, TH_STRICT_SIDE, TH_ELEVATED_BLACK, TH_STRICT_CONTENT, TH_PANEL_BLACK, TH_TEXT_WHITE, TH_LABEL_WHITE, TH_MUTED_WHITE, TH_BORDER_WHITE, TH_LINE_WHITE, TH_HIGHLIGHT_WHITE, TH_TIP_WHITE, TH_CROWN_WHITE, TH_TERMINAL_TINT, TH_AGENTS_LINE_ALPHA];
    var i : usize = 0;
    while (i < 15) {
        assert(th_ok(th[i]));
        i = i + 1;
    }
    // the file ends with the sentinel the spec declares: LIVE_END (hot_reload.t27 must find it)
    assert(is_live_end(LIVE_END));
    // documented meanings hold: the text levels sit on the white side, the terminal tint and the
    // dimmest marks on the black side of the glass
    assert(th_white_side(TH_TEXT_WHITE) and th_white_side(TH_TIP_WHITE));
    assert(th_black_side(TH_TERMINAL_TINT) and th_black_side(TH_HIGHLIGHT_WHITE));
    // the petal list still holds the built-in count: 27 names, the count must not change
    assert(petal_count(PETALS) == 27);
}
