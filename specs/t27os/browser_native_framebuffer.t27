// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_native_framebuffer.t27 -- where glass_window exports the CGBitmap it
; already draws, before the 0.3.2 loopback listener may serve PIXEL_NATIVE. This spec owns the
; file name, PNG wire magic, and the export-ready flag. glass_window.t27 writes the bytes;
; browser_native_bridge.t27 reads NATIVE_EXPORT and pixel_kind; the listener host streams the
; file when both agree. Until glass_window enables export, NATIVE_EXPORT stays 0 and E2E stays open.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserNativeFramebuffer;

use t27os::browser_native_bridge::NATIVE_EXPORT;
use t27os::browser_native_bridge::PIXEL_NATIVE;
use t27os::browser_native_bridge::PIXEL_NONE;
use t27os::browser_native_bridge::pixel_kind;
use t27os::session_store::put_bytes;

/// Relative to ~/.t27os/browser/ (same tree as frame.jpg and in.txt).
pub const EXPORT_DIR_SUFFIX : []const u8 = "/.t27os/browser/";
pub const EXPORT_BASENAME : string = "native.png";

/// Build "<home>/.t27os/browser/native.png" into pb; byte count (same layout as glass_window br_path).
pub fn export_path(hb : []const u8, pb : []u8) -> usize {
    var n : usize = put_bytes(pb, 0, hb);
    n = put_bytes(pb, n, EXPORT_DIR_SUFFIX);
    n = put_bytes(pb, n, EXPORT_BASENAME);
    return n;
}

/// True only after an atomic rename left a PNG on disk; host raises NATIVE_EXPORT then.
pub fn raise_export_after_write(wrote : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> bool {
    if (!wrote) { return false; }
    return png_magic_ok(b0, b1, b2, b3);
}

/// PNG signature bytes (RFC 2083).
pub const PNG_B0 : u8 = 137;
pub const PNG_B1 : u8 = 80;
pub const PNG_B2 : u8 = 78;
pub const PNG_B3 : u8 = 71;

/// glass_window sets NATIVE_EXPORT to 1 only after it atomically writes native.png.
pub fn export_enabled() -> bool {
    return NATIVE_EXPORT == 1;
}

pub fn png_magic_ok(b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> bool {
    if (b0 != PNG_B0) { return false; }
    if (b1 != PNG_B1) { return false; }
    if (b2 != PNG_B2) { return false; }
    if (b3 != PNG_B3) { return false; }
    return true;
}

/// A file on disk is not served until the bridge flag is raised (no lying with stale files).
pub fn serve_kind(export_on : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    if (!export_on) { return PIXEL_NONE; }
    if (!png_magic_ok(b0, b1, b2, b3)) { return PIXEL_NONE; }
    return PIXEL_NATIVE;
}

/// Kind the bridge pixel_kind would return once export is enabled (pump ignored for native).
pub fn bridge_pixel_kind(export_on : bool, pump_alive : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    if (!export_on) {
        return pixel_kind(pump_alive, b0, b1, b2, b3);
    }
    if (png_magic_ok(b0, b1, b2, b3)) { return PIXEL_NATIVE; }
    return PIXEL_NONE;
}

test export_stays_off_until_glass_window_raises_the_flag {
    assert !export_enabled();
    assert serve_kind(false, PNG_B0, PNG_B1, PNG_B2, PNG_B3) == PIXEL_NONE;
    assert serve_kind(true, PNG_B0, PNG_B1, PNG_B2, PNG_B3) == PIXEL_NATIVE;
    assert !png_magic_ok(255, 216, 0, 0);
    assert EXPORT_DIR_SUFFIX == "/.t27os/browser/";
    assert EXPORT_BASENAME == "native.png";
    assert !raise_export_after_write(false, PNG_B0, PNG_B1, PNG_B2, PNG_B3);
    assert raise_export_after_write(true, PNG_B0, PNG_B1, PNG_B2, PNG_B3);
    assert !raise_export_after_write(true, 255, 216, 0, 0);
}

test export_path_matches_home_browser_tree {
    var p : [48]u8 = undefined;
    const n : usize = export_path("/Users/me", p[0..48]);
    assert n == 35;
    assert p[0] == 47 and p[1] == 85 and p[7] == 109 and p[8] == 101;
    assert p[9] == 47 and p[10] == 46 and p[16] == 47 and p[25] == 110;
    assert p[31] == 46 and p[32] == 112 and p[33] == 110 and p[34] == 103;
}

test bridge_kind_prefers_native_when_export_is_on {
    assert bridge_pixel_kind(false, true, 255, 216, 0, 0) == pixel_kind(true, 255, 216, 0, 0);
    assert bridge_pixel_kind(true, true, PNG_B0, PNG_B1, PNG_B2, PNG_B3) == PIXEL_NATIVE;
    assert bridge_pixel_kind(true, false, PNG_B0, PNG_B1, PNG_B2, PNG_B3) == PIXEL_NATIVE;
}

invariant framebuffer_does_not_self_enable {
    assert NATIVE_EXPORT == 0;
    assert !export_enabled();
}