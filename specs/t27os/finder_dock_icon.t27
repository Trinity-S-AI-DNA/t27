// SPDX-License-Identifier: Apache-2.0
// specs/t27os/finder_dock_icon.t27 -- T27OS.app: Finder and Dock icon, white
// logo on black with the text T27OS.
// Part of M1 (milestone #5). Closes #13167.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::finder_dock_icon;

pub const ICON_TEXT : str = "T27OS";
pub const ICON_BG_COLOR : str = "#000000";
pub const ICON_FG_COLOR : str = "#ffffff";

pub fn icon_text_is_t27os() -> bool {
    return ICON_TEXT == "T27OS";
}

test "icon text is T27OS" {
    assert(icon_text_is_t27os());
}

invariant icon_bg_is_black {
    assert ICON_BG_COLOR == "#000000";
}

invariant icon_fg_is_white {
    assert ICON_FG_COLOR == "#ffffff";
}