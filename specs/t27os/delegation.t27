// SPDX-License-Identifier: Apache-2.0
// specs/t27os/delegation.t27 -- T27 OS delegation.t27: subtask, child result,
// parent accept or rework (Wave B1).
// Part of M1 (milestone #5). Closes #13072.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::delegation;

pub const DELEGATION_MAX_DEPTH : u32 = 8;

pub struct Delegation { subtask: str, parent_accepted: bool, depth: u32 };

pub fn delegation_accepted(d: Delegation) -> bool {
    return d.parent_accepted;
}

pub fn delegation_within_depth(d: Delegation) -> bool {
    return d.depth <= DELEGATION_MAX_DEPTH;
}

test "delegation accepted" {
    assert(delegation_accepted(Delegation { subtask: "s1", parent_accepted: true, depth: 1 }));
    assert(!delegation_accepted(Delegation { subtask: "s2", parent_accepted: false, depth: 1 }));
}

test "delegation within depth" {
    assert(delegation_within_depth(Delegation { subtask: "s", parent_accepted: true, depth: 5 }));
    assert(!delegation_within_depth(Delegation { subtask: "s", parent_accepted: true, depth: 10 }));
}

invariant delegation_max_depth_positive {
    assert DELEGATION_MAX_DEPTH > 0;
}