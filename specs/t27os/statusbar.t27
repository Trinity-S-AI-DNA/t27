// SPDX-License-Identifier: Apache-2.0
; specs/t27os/statusbar.t27 -- the header text and the IDE-style status bar of the T27 OS window
; (owner, 2026-10-20; gHashTag/t27#11417, part of the T27 OS epic #11037).
; --
; WHAT IS DECIDED HERE (every rule has a test below):
; - HEADER: the window title area always says "T27 OS <version> - b<build>"; the version is written from the same
;   constants as the bundle plist (release.t27 current_version through put_semver) and the build is the number the
;   plist's CFBundleVersion holds (install.t27 plist_text). When an update is downloaded and waiting the header
;   says "T27 OS <ver> b<build> -> <newver> ready" and carries the UPDATE NOW control. Nothing is typed.
; - FOOTER: one bar across the window bottom, SB_H (24 pt), matte glass, small caps (the texts are sb_upper-cased
;   here). Items left to right: host, version, update, pane server, key light, lanes, Queen, trigit, load, clock.
;   An item whose feed does not exist yet is not present and takes no room. OPEN SOURCE T27, KEYS and DOCTOR stay
;   at the right end.
; - NARROW WINDOW: when the present items do not fit, the lowest-priority ones fold into "..." (rank below),
;   the fold's tooltip lists the folded items' texts. The update item is the last to fold.
; WHAT IS NOT HERE: the draw calls and the host reads (glass_window.t27); they take these answers.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osStatusbar;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::release::current_version;
use t27os::release::put_semver;
use t27os::release::U_IDLE;
use t27os::release::U_CHECKING;
use t27os::release::U_DOWNLOADING;
use t27os::release::U_VERIFYING;
use t27os::release::U_STAGED;
use t27os::release::U_SWAPPED;
use t27os::release::WHY_OFFLINE;
use t27os::release::WHY_NONE;
use t27os::release::WHY_MANIFEST;
use t27os::release::WHY_DOWNLOAD;
use t27os::release::WHY_SHA;
use t27os::release::WHY_STAGE;
use t27os::release::WHY_COMMIT;
use t27os::release::WHY_NO_COMMIT;
use t27os::release::WHY_BUNDLE;
use t27os::release::WHY_SWAP;
use t27os::release::WHY_BROKEN;
use t27os::install::plist_text;
use t27os::evolve::kind_phrase;
use t27os::evolve::letter_char;
use t27os::evolve::dec_kind;
use t27os::evolve::dec_letter;
use t27os::evolve::TITLE_MID;
use t27os::evolve::EV_MAX_AGENTS;
use t27os::doctor::DOC_LINK_W;
use t27os::keys::KY_LINK_W;

// ---------------------------------------------------------------- geometry

pub const SB_H : f64 = 24.0;
pub const SB_SIZE : f64 = 8.5;
pub const SB_PAD : f64 = 12.0;
pub const SB_GAP : f64 = 14.0;
pub const SB_FOLD_W : f64 = 20.0;
pub const SB_REPO_W : f64 = 100.0;
pub const SB_RIGHT_GAP : f64 = 8.0;
pub const SB_NONE : u32 = 255;
pub const SB_SLOT : usize = 64;

pub const IT_HOST : u32 = 0;
pub const IT_VER : u32 = 1;
pub const IT_UPD : u32 = 2;
pub const IT_SRV : u32 = 3;
pub const IT_LIGHT : u32 = 4;
pub const IT_LANES : u32 = 5;
pub const IT_QUEEN : u32 = 6;
pub const IT_TRIGIT : u32 = 7;
pub const IT_LOAD : u32 = 8;
pub const IT_CLOCK : u32 = 9;
pub const IT_GOD : u32 = 10;
pub const IT_COUNT : u32 = 11;
/// The "..." item that holds the folded ones.
pub const IT_FOLD : u32 = 11;

/// 0 is kept longest. The update state outranks everything: a failed or ready update must stay visible.
pub fn item_rank(id : u32) -> u32 {
    if (id == IT_UPD) { return 0; }
    if (id == IT_VER) { return 1; }
    if (id == IT_GOD) { return 2; }
    if (id == IT_SRV) { return 3; }
    if (id == IT_LIGHT) { return 4; }
    if (id == IT_LANES) { return 5; }
    if (id == IT_HOST) { return 6; }
    if (id == IT_CLOCK) { return 7; }
    if (id == IT_QUEEN) { return 8; }
    if (id == IT_TRIGIT) { return 9; }
    if (id == IT_LOAD) { return 10; }
    return 99;
}

pub const PG_NONE : u32 = 0;
pub const PG_DOCTOR : u32 = 1;
pub const PG_UPDATE : u32 = 2;
pub const PG_KEYS : u32 = 3;
pub const PG_QUEEN : u32 = 4;
pub const PG_LANES : u32 = 5;
pub const PG_PANE : u32 = 6;
pub const PG_GOD : u32 = 7;

/// The page a click on an item goes to.
pub fn item_page(id : u32) -> u32 {
    if (id == IT_HOST or id == IT_VER or id == IT_LOAD) { return PG_DOCTOR; }
    if (id == IT_UPD) { return PG_UPDATE; }
    if (id == IT_GOD) { return PG_GOD; }
    if (id == IT_SRV) { return PG_PANE; }
    if (id == IT_LIGHT) { return PG_KEYS; }
    if (id == IT_LANES) { return PG_LANES; }
    if (id == IT_QUEEN or id == IT_TRIGIT) { return PG_QUEEN; }
    return PG_NONE;
}

fn sb_bit(m : u32, i : u32) -> bool { return (m >> i) % 2 == 1; }

/// Room the right end takes: OPEN SOURCE T27, KEYS, DOCTOR with their gaps and the padding.
pub fn right_w() -> f64 {
    return SB_PAD + DOC_LINK_W + SB_RIGHT_GAP + KY_LINK_W + SB_RIGHT_GAP + SB_REPO_W;
}

pub fn doc_left(sw : f64) -> f64 { return sw - SB_PAD - DOC_LINK_W; }
pub fn keys_left(sw : f64) -> f64 { return doc_left(sw) - SB_RIGHT_GAP - KY_LINK_W; }
pub fn repo_left(sw : f64) -> f64 { return keys_left(sw) - SB_RIGHT_GAP - SB_REPO_W; }

/// Room for the items: from the left padding to the OPEN SOURCE link, with a gap before it.
pub fn avail_w(sw : f64) -> f64 {
    return repo_left(sw) - SB_GAP - SB_PAD;
}

pub fn in_bar(y : f64, sh : f64) -> bool { return y >= sh - SB_H and y <= sh; }

pub fn on_repo(x : f64, y : f64, sw : f64, sh : f64) -> bool {
    return in_bar(y, sh) and x >= repo_left(sw) and x < repo_left(sw) + SB_REPO_W;
}
pub fn on_keys(x : f64, y : f64, sw : f64, sh : f64) -> bool {
    return in_bar(y, sh) and x >= keys_left(sw) and x < keys_left(sw) + KY_LINK_W;
}
pub fn on_doc(x : f64, y : f64, sw : f64, sh : f64) -> bool {
    return in_bar(y, sh) and x >= doc_left(sw) and x <= sw - SB_PAD + 6.0;
}

// ---------------------------------------------------------------- layout and folding

/// Width of the visible items `vis` of the present `present`, with the gaps and, when something is folded,
/// the "..." item.
pub fn used_w(vis : u32, present : u32, widths : []const f64) -> f64 {
    var w : f64 = 0.0;
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < IT_COUNT) {
        if (sb_bit(vis, i)) {
            w = w + widths[i as usize];
            n = n + 1;
        }
        i = i + 1;
    }
    if (vis != present) { w = w + SB_FOLD_W; n = n + 1; }
    if (n > 1) { w = w + SB_GAP * ((n - 1) as f64); }
    return w;
}

/// The visible item with the lowest priority (highest rank), SB_NONE when none.
fn weakest(vis : u32) -> u32 {
    var best : u32 = SB_NONE;
    var br : u32 = 0;
    var i : u32 = 0;
    while (i < IT_COUNT) {
        if (sb_bit(vis, i) and (best == SB_NONE or item_rank(i) > br)) {
            best = i;
            br = item_rank(i);
        }
        i = i + 1;
    }
    return best;
}

/// Which of the present items are drawn in `avail`: the lowest-priority ones are folded first until the rest
/// and the "..." fit. A bit is cleared with a subtraction (the item is known to be set).
pub fn visible_mask(present : u32, widths : []const f64, avail : f64) -> u32 {
    var vis : u32 = present;
    var guard : u32 = 0;
    while (used_w(vis, present, widths) > avail and vis != 0 and guard < 16) {
        const w : u32 = weakest(vis);
        if (w == SB_NONE) { return 0; }
        vis = vis - (1 << w);
        guard = guard + 1;
    }
    return vis;
}

/// Left edge of item `id` (IT_FOLD for the "..."), SB_PAD-based; -1.0 when it is not drawn.
pub fn sb_item_x(id : u32, vis : u32, present : u32, widths : []const f64) -> f64 {
    var x : f64 = SB_PAD;
    var i : u32 = 0;
    while (i < IT_COUNT) {
        if (sb_bit(vis, i)) {
            if (i == id) { return x; }
            x = x + widths[i as usize] + SB_GAP;
        }
        i = i + 1;
    }
    if (id == IT_FOLD and vis != present) { return x; }
    return -1.0;
}

/// The item under x (IT_FOLD for the "..."), SB_NONE for none; the click area is the item's width plus half a gap.
pub fn sb_item_at(x : f64, y : f64, sh : f64, vis : u32, present : u32, widths : []const f64) -> u32 {
    if (in_bar(y, sh) == false) { return SB_NONE; }
    var i : u32 = 0;
    while (i < IT_COUNT) {
        if (sb_bit(vis, i)) {
            const l : f64 = sb_item_x(i, vis, present, widths);
            if (x >= l - 0.5 * SB_GAP and x < l + widths[i as usize] + 0.5 * SB_GAP) { return i; }
        }
        i = i + 1;
    }
    if (vis != present) {
        const fx : f64 = sb_item_x(IT_FOLD, vis, present, widths);
        if (x >= fx - 0.5 * SB_GAP and x < fx + SB_FOLD_W + 0.5 * SB_GAP) { return IT_FOLD; }
    }
    return SB_NONE;
}

/// The tooltip of the "...": the texts of the folded items (slots of SB_SLOT bytes, lens[i] long) joined by " | ".
pub fn fold_tip(slots : []const u8, lens : []const u32, folded : u32, out : []u8) -> usize {
    var w : usize = 0;
    var i : u32 = 0;
    while (i < IT_COUNT) {
        if (sb_bit(folded, i)) {
            if (w > 0) { w = put_bytes(out, w, " | "); }
            var k : usize = 0;
            const base : usize = (i as usize) * SB_SLOT;
            while (k < (lens[i as usize] as usize)) {
                out[w + k] = slots[base + k];
                k = k + 1;
            }
            w = w + k;
        }
        i = i + 1;
    }
    return w;
}

// ---------------------------------------------------------------- the texts

/// Upper-cases ASCII letters in place (small caps: the draw uses a smaller size).
pub fn sb_upper(s : []u8, n : usize) -> void {
    var i : usize = 0;
    while (i < n) {
        if (s[i] >= 97 and s[i] <= 122) { s[i] = s[i] - 32; }
        i = i + 1;
    }
}

fn put_str_n(out : []u8, w : usize, s : []const u8, n : usize) -> usize {
    var k : usize = 0;
    while (k < n) {
        out[w + k] = s[k];
        k = k + 1;
    }
    return w + n;
}

/// "<version> b<build>" with the version written from release.t27's constants.
pub fn put_ver_build(out : []u8, w : usize, build : u32) -> usize {
    var k : usize = put_semver(out, 64, w, current_version());
    k = put_bytes(out, k, " b");
    return put_dec(out, k, build as u64);
}

/// The header: "T27 OS 0.2.0 - b17"; with an update waiting "T27 OS 0.2.0 b17 -> 0.2.0 ready" (the new build is
/// named too when the semver is the same).
pub fn header_text(out : []u8, build : u32, ready : bool, cand_v : u64, cand_b : u32) -> usize {
    var w : usize = put_bytes(out, 0, "T27 OS ");
    if (ready == false) {
        w = put_semver(out, 64, w, current_version());
        w = put_bytes(out, w, " - b");
        return put_dec(out, w, build as u64);
    }
    w = put_ver_build(out, w, build);
    w = put_bytes(out, w, " -> ");
    w = put_semver(out, 64, w, cand_v);
    if (cand_v == current_version()) {
        w = put_bytes(out, w, " b");
        w = put_dec(out, w, cand_b as u64);
    }
    return put_bytes(out, w, " ready");
}

/// The header's right cluster, laid out from `right` (the left edge of the title bar's refresh control) to the
/// left: [header text] [UPDATE NOW when ready] [GOD MODE switch]. The switch is drawn on every screen, in a window
/// and in full screen, whether or not an update waits.
pub const GOD_W : f64 = 74.0;
pub const GOD_H : f64 = 18.0;
pub const HDR_GAP : f64 = 8.0;
pub const HDR_BTN_W : f64 = 84.0;
pub const HDR_BTN_H : f64 = 18.0;
pub fn god_x(right : f64) -> f64 { return right - GOD_W; }
/// The right edge of the UPDATE NOW control.
pub fn upd_right(right : f64) -> f64 { return god_x(right) - HDR_GAP; }
pub fn hdr_btn_x(right : f64) -> f64 { return upd_right(right) - HDR_BTN_W; }
/// The right edge of the header text: left of UPDATE NOW when it shows, else left of the switch.
pub fn hdr_text_right(right : f64, ready : bool) -> f64 {
    if (ready) { return hdr_btn_x(right) - HDR_GAP; }
    return god_x(right) - HDR_GAP;
}
pub fn on_hdr_btn(x : f64, y : f64, right : f64, title_h : f64, shown : bool) -> bool {
    return shown and x >= hdr_btn_x(right) and x <= upd_right(right) and y >= 0.5 * (title_h - HDR_BTN_H) and y <= 0.5 * (title_h + HDR_BTN_H);
}
/// The GOD MODE switch in the header (always present).
pub fn on_god_switch(x : f64, y : f64, right : f64, title_h : f64) -> bool {
    return x >= god_x(right) and x <= right and y >= 0.5 * (title_h - GOD_H) and y <= 0.5 * (title_h + GOD_H);
}
pub fn god_switch_drawn(sw_mode_screen : bool) -> bool { return sw_mode_screen; }

/// The strip above the footer: shown while GOD MODE is on.
pub const STRIP_H : f64 = 16.0;
pub fn strip_shown(god : bool) -> bool { return god; }
pub fn strip_top(sh : f64) -> f64 { return sh - SB_H - STRIP_H; }

/// "GOD MODE ON  next: <what>  lanes 1/3  last: tick 5m ok". `next` is evolve.t27's decision word (0 none),
/// `last_ago` seconds since the last Queen tick (NO_TICK none), `rc` its exit code.
pub const NO_TICK : u64 = 18446744073709551615;
pub fn god_strip_text(out : []u8, next : u32, running : u32, cap : u32, last_ago : u64, rc : u32) -> usize {
    var w : usize = put_bytes(out, 0, "GOD MODE ON  next: ");
    if (next == 0) {
        w = put_bytes(out, w, "nothing to do");
    } else {
        w = put_bytes(out, w, kind_phrase(dec_kind(next)));
        w = put_bytes(out, w, TITLE_MID);
        w = put_bytes(out, w, letter_char(dec_letter(next)));
    }
    w = put_bytes(out, w, "  lanes ");
    w = put_dec(out, w, running as u64);
    w = put_bytes(out, w, "/");
    w = put_dec(out, w, cap as u64);
    w = put_bytes(out, w, "  last: ");
    if (last_ago == NO_TICK) { return put_bytes(out, w, "no tick yet"); }
    w = put_bytes(out, w, "tick ");
    w = age_text(out, w, last_ago);
    if (rc == 0) { return put_bytes(out, w, " ok"); }
    return put_bytes(out, w, " failed");
}

pub fn god_text(out : []u8, god : bool, running : u32, cap : u32) -> usize {
    if (god == false) { return put_bytes(out, 0, "god mode off"); }
    var w : usize = put_bytes(out, 0, "god mode on ");
    w = put_dec(out, w, running as u64);
    w = put_bytes(out, w, "/");
    return put_dec(out, w, cap as u64);
}

// ---------------------------------------------------------------- the Queen tick (GOD MODE ON)

/// The local Queen is asked for lanes every GOD_TICK_S seconds while GOD MODE is on, never more than the free slots.
pub const GOD_TICK_S : u64 = 300;
pub fn lanes_free(running : u32, cap : u32) -> u32 {
    if (running >= cap) { return 0; }
    return cap - running;
}
pub fn god_tick_due(god : bool, now : u64, last : u64, running : u32, cap : u32) -> bool {
    if (god == false or lanes_free(running, cap) == 0) { return false; }
    return last == 0 or now >= last + GOD_TICK_S;
}
/// The shell text that runs it: the pinned binary when it is there, else the one on PATH; the log goes under the home.
pub const TICK_A : str = "p=/tmp/claude-501/bin/tri-queen; [ -x \"$p\" ] || p=$(command -v tri-queen); [ -n \"$p\" ] || exit 127; \"$p\" queen --lanes ";
pub const TICK_B : str = " tick >> $HOME/.t27os/queen-tick.log 2>&1";
pub fn tick_cmd(out : []u8, lanes : u32) -> usize {
    var w : usize = put_bytes(out, 0, TICK_A);
    w = put_dec(out, w, lanes as u64);
    return put_bytes(out, w, TICK_B);
}

pub fn host_text(out : []u8, name : []const u8, n : usize, online : bool) -> usize {
    var w : usize = put_str_n(out, 0, name, n);
    if (online) { return put_bytes(out, w, " online"); }
    return put_bytes(out, w, " offline");
}

/// "0.2.0 b17" and, when the build knows its commit, " abc1234" (at most 8 characters of it).
pub fn ver_text(out : []u8, build : u32, commit : []const u8, cn : usize) -> usize {
    var w : usize = put_ver_build(out, 0, build);
    if (cn > 0) {
        w = put_bytes(out, w, " ");
        var m : usize = cn;
        if (m > 8) { m = 8; }
        w = put_str_n(out, w, commit, m);
    }
    return w;
}

fn why_word(why : u8) -> str {
    if (why == WHY_OFFLINE) { return "offline"; }
    if (why == WHY_MANIFEST) { return "bad manifest"; }
    if (why == WHY_DOWNLOAD) { return "download"; }
    if (why == WHY_SHA) { return "sha256"; }
    if (why == WHY_STAGE) { return "unzip or signature"; }
    if (why == WHY_COMMIT) { return "toolchain commit"; }
    if (why == WHY_NO_COMMIT) { return "toolchain commit"; }
    if (why == WHY_BUNDLE) { return "not installed app"; }
    if (why == WHY_SWAP) { return "swap"; }
    if (why == WHY_BROKEN) { return "rolled back"; }
    return "error";
}

pub const PCT_UNKNOWN : u32 = 255;

/// Up to date / downloading N% / ready -> UPDATE NOW / failed: reason. `pct` is PCT_UNKNOWN when the download size is not known.
pub fn upd_text(out : []u8, state : u8, why : u8, pct : u32) -> usize {
    if (state == U_STAGED) { return put_bytes(out, 0, "ready -> UPDATE NOW"); }
    if (state == U_DOWNLOADING) {
        var w : usize = put_bytes(out, 0, "downloading");
        if (pct <= 100) {
            w = put_bytes(out, w, " ");
            w = put_dec(out, w, pct as u64);
            w = put_bytes(out, w, "%");
        }
        return w;
    }
    if (state == U_VERIFYING) { return put_bytes(out, 0, "verifying"); }
    if (state == U_SWAPPED) { return put_bytes(out, 0, "restarting"); }
    if (state == U_CHECKING) { return put_bytes(out, 0, "checking"); }
    if (state == U_IDLE and why >= WHY_MANIFEST) {
        const w : usize = put_bytes(out, 0, "failed: ");
        return put_bytes(out, w, why_word(why));
    }
    return put_bytes(out, 0, "up to date");
}

pub const SRV_RUNNING : u32 = 0;
pub const SRV_STARTING_ : u32 = 1;

/// "server running 3 panes" / "server starting" / "server down"; srv uses term_pane SRV_UP 0, SRV_STARTING 1, SRV_FAILED 2.
pub fn srv_text(out : []u8, srv : u32, panes : u32) -> usize {
    if (srv == 1) { return put_bytes(out, 0, "server starting"); }
    if (srv != 0) { return put_bytes(out, 0, "server down"); }
    var w : usize = put_bytes(out, 0, "server running ");
    w = put_dec(out, w, panes as u64);
    if (panes == 1) { return put_bytes(out, w, " pane"); }
    return put_bytes(out, w, " panes");
}

/// keys.t27: 0 none, 1 green, 2 yellow, 3 red.
pub fn light_word(l : u32) -> str {
    if (l == 1) { return "green"; }
    if (l == 2) { return "yellow"; }
    if (l == 3) { return "red"; }
    return "no key";
}

pub fn light_text(out : []u8, light : u32, model : []const u8, mn : usize) -> usize {
    var w : usize = put_bytes(out, 0, "key ");
    w = put_bytes(out, w, light_word(light));
    if (mn > 0) {
        w = put_bytes(out, w, " ");
        w = put_str_n(out, w, model, mn);
    }
    return w;
}

pub fn lanes_text(out : []u8, running : u32, waiting : u32) -> usize {
    var w : usize = put_bytes(out, 0, "lanes ");
    w = put_dec(out, w, running as u64);
    w = put_bytes(out, w, " running ");
    w = put_dec(out, w, waiting as u64);
    return put_bytes(out, w, " waiting");
}

pub fn queen_text(out : []u8, run : u32, idle : u32, blocked : u32, review : u32) -> usize {
    var w : usize = put_bytes(out, 0, "queen ");
    w = put_dec(out, w, run as u64);
    w = put_bytes(out, w, " run ");
    w = put_dec(out, w, idle as u64);
    w = put_bytes(out, w, " idle ");
    w = put_dec(out, w, blocked as u64);
    w = put_bytes(out, w, " blocked ");
    w = put_dec(out, w, review as u64);
    return put_bytes(out, w, " review");
}

/// The age of the last push as "5m", "2h", "3d", "now" under a minute.
pub fn age_text(out : []u8, w0 : usize, s : u64) -> usize {
    if (s < 60) { return put_bytes(out, w0, "now"); }
    if (s < 3600) {
        const w : usize = put_dec(out, w0, s / 60);
        return put_bytes(out, w, "m");
    }
    if (s < 86400) {
        const w : usize = put_dec(out, w0, s / 3600);
        return put_bytes(out, w, "h");
    }
    const w : usize = put_dec(out, w0, s / 86400);
    return put_bytes(out, w, "d");
}

pub fn trigit_text(out : []u8, queue : u32, unpushed : u32, push_age_s : u64) -> usize {
    var w : usize = put_bytes(out, 0, "trigit queue ");
    w = put_dec(out, w, queue as u64);
    w = put_bytes(out, w, " unpushed ");
    w = put_dec(out, w, unpushed as u64);
    w = put_bytes(out, w, " push ");
    return age_text(out, w, push_age_s);
}

/// Free memory or disk below this many GB is red.
pub const LOW_GB : u32 = 8;

/// A reading the host could not take.
pub const NOT_READ : u32 = 4294967295;

/// RAM free is in tenths of a GB, disk free in GB; a part that is NOT_READ is left out.
pub fn load_text(out : []u8, cpu : u32, ram_tenths : u32, disk_gb : u32) -> usize {
    var w : usize = 0;
    if (cpu != NOT_READ) {
        w = put_bytes(out, w, "cpu ");
        w = put_dec(out, w, cpu as u64);
        w = put_bytes(out, w, "%");
    }
    if (ram_tenths != NOT_READ) {
        if (w > 0) { w = put_bytes(out, w, " "); }
        w = put_bytes(out, w, "ram ");
        w = put_dec(out, w, (ram_tenths / 10) as u64);
        w = put_bytes(out, w, ".");
        w = put_dec(out, w, (ram_tenths % 10) as u64);
        w = put_bytes(out, w, "G");
    }
    if (disk_gb != NOT_READ) {
        if (w > 0) { w = put_bytes(out, w, " "); }
        w = put_bytes(out, w, "disk ");
        w = put_dec(out, w, disk_gb as u64);
        w = put_bytes(out, w, "G");
    }
    return w;
}

/// The load item is red (drawn brighter, with a dot) when the disk or the memory is under LOW_GB.
pub fn load_red(ram_tenths : u32, disk_gb : u32) -> bool {
    return (ram_tenths != NOT_READ and ram_tenths < LOW_GB * 10) or (disk_gb != NOT_READ and disk_gb < LOW_GB);
}

/// Up to 8 bytes per word, byte i in bits 8*i: how a short text (the host name, the commit) is kept in the window's u64 state.
pub fn pack8(words : []u64, at : usize, s : []const u8, n : usize) -> void {
    var i : usize = 0;
    while (i < n) {
        const k : usize = at + i / 8;
        const sh : u64 = ((i % 8) * 8) as u64;
        if (i % 8 == 0) { words[k] = 0; }
        words[k] = words[k] | ((s[i] as u64) << sh);
        i = i + 1;
    }
}
pub fn unpack8(words : []const u64, at : usize, n : usize, out : []u8) -> void {
    var i : usize = 0;
    while (i < n) {
        const sh : u64 = ((i % 8) * 8) as u64;
        out[i] = ((words[at + i / 8] >> sh) % 256) as u8;
        i = i + 1;
    }
}

/// "14:05" from the epoch seconds and the zone offset in seconds.
pub fn clock_text(out : []u8, epoch : u64, tz : i64) -> usize {
    var local : i64 = (epoch as i64) + tz;
    if (local < 0) { local = 0; }
    const day : u64 = (local as u64) % 86400;
    const h : u64 = day / 3600;
    const m : u64 = (day / 60) % 60;
    var w : usize = 0;
    if (h < 10) { w = put_bytes(out, w, "0"); }
    w = put_dec(out, w, h);
    w = put_bytes(out, w, ":");
    if (m < 10) { w = put_bytes(out, w, "0"); }
    return put_dec(out, w, m);
}

// ---------------------------------------------------------------- tests

fn sb_eq(a : []const u8, n : usize, s : []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn sb_has(t : []const u8, n : usize, s : []const u8) -> bool {
    if (s.len > n) { return false; }
    var i : usize = 0;
    while (i + s.len <= n) {
        var k : usize = 0;
        while (k < s.len and t[i + k] == s[k]) { k = k + 1; }
        if (k == s.len) { return true; }
        i = i + 1;
    }
    return false;
}

test the_header_text_and_the_bundle_plist_come_from_the_same_constants {
    var h : [64]u8 = undefined;
    var v : [64]u8 = undefined;
    var p : [1024]u8 = undefined;
    const hn : usize = header_text(h[0..64], 17, false, 0, 0);
    assert(sb_eq(h[0..64], hn, "T27 OS 0.2.0 - b17"));
    // the plist is written with the version put_semver writes from current_version and the same build text
    const vn : usize = put_semver(v[0..64], 64, 0, current_version());
    const pn : usize = plist_text(p[0..1024], 1024, v[0..64], vn, "17", 2);
    assert(sb_has(p[0..1024], pn, "<key>CFBundleShortVersionString</key><string>0.2.0</string>"));
    assert(sb_has(p[0..1024], pn, "<key>CFBundleVersion</key><string>17</string>"));
    // the header holds exactly the plist's short version and build
    assert(sb_has(h[0..64], hn, "0.2.0"));
    assert(sb_has(h[0..64], hn, "b17"));
    var w : [64]u8 = undefined;
    const wn : usize = put_ver_build(w[0..64], 0, 17);
    assert(sb_eq(w[0..64], wn, "0.2.0 b17"));
}

test a_waiting_update_shows_the_new_version_and_the_update_now_control {
    var h : [64]u8 = undefined;
    const n : usize = header_text(h[0..64], 17, true, 1099511627776 * 0 + 1048576 * 3 + 0, 18);
    // cand 0.3.0 against 0.2.0
    assert(sb_eq(h[0..64], n, "T27 OS 0.2.0 b17 -> 0.3.0 ready"));
    const same : usize = header_text(h[0..64], 17, true, current_version(), 18);
    assert(sb_eq(h[0..64], same, "T27 OS 0.2.0 b17 -> 0.2.0 b18 ready"));
    const r : f64 = 560.0;
    assert(on_hdr_btn(hdr_btn_x(r) + 5.0, 17.0, r, 34.0, true));
    assert(on_hdr_btn(hdr_btn_x(r) + 5.0, 17.0, r, 34.0, false) == false);
    assert(on_hdr_btn(hdr_btn_x(r) - 20.0, 17.0, r, 34.0, true) == false);
}

test the_item_texts_are_built_from_their_one_source {
    var t : [96]u8 = undefined;
    var n : usize = host_text(t[0..96], "mac", 3, true);
    assert(sb_eq(t[0..96], n, "mac online"));
    n = host_text(t[0..96], "mac", 3, false);
    assert(sb_eq(t[0..96], n, "mac offline"));
    n = ver_text(t[0..96], 17, "abcdef0123", 10);
    assert(sb_eq(t[0..96], n, "0.2.0 b17 abcdef01"));
    n = ver_text(t[0..96], 17, "", 0);
    assert(sb_eq(t[0..96], n, "0.2.0 b17"));
    n = upd_text(t[0..96], U_IDLE, WHY_NONE, PCT_UNKNOWN);
    assert(sb_eq(t[0..96], n, "up to date"));
    n = upd_text(t[0..96], U_DOWNLOADING, WHY_NONE, 42);
    assert(sb_eq(t[0..96], n, "downloading 42%"));
    n = upd_text(t[0..96], U_DOWNLOADING, WHY_NONE, PCT_UNKNOWN);
    assert(sb_eq(t[0..96], n, "downloading"));
    n = upd_text(t[0..96], U_STAGED, WHY_NONE, PCT_UNKNOWN);
    assert(sb_eq(t[0..96], n, "ready -> UPDATE NOW"));
    n = upd_text(t[0..96], U_IDLE, WHY_SHA, PCT_UNKNOWN);
    assert(sb_eq(t[0..96], n, "failed: sha256"));
    n = srv_text(t[0..96], 0, 3);
    assert(sb_eq(t[0..96], n, "server running 3 panes"));
    n = srv_text(t[0..96], 0, 1);
    assert(sb_eq(t[0..96], n, "server running 1 pane"));
    n = srv_text(t[0..96], 1, 0);
    assert(sb_eq(t[0..96], n, "server starting"));
    n = srv_text(t[0..96], 2, 0);
    assert(sb_eq(t[0..96], n, "server down"));
    n = light_text(t[0..96], 3, "glm", 3);
    assert(sb_eq(t[0..96], n, "key red glm"));
    n = light_text(t[0..96], 0, "", 0);
    assert(sb_eq(t[0..96], n, "key no key"));
    n = lanes_text(t[0..96], 3, 1);
    assert(sb_eq(t[0..96], n, "lanes 3 running 1 waiting"));
    n = queen_text(t[0..96], 4, 2, 1, 0);
    assert(sb_eq(t[0..96], n, "queen 4 run 2 idle 1 blocked 0 review"));
    n = trigit_text(t[0..96], 2, 0, 300);
    assert(sb_eq(t[0..96], n, "trigit queue 2 unpushed 0 push 5m"));
    n = trigit_text(t[0..96], 0, 1, 20);
    assert(sb_eq(t[0..96], n, "trigit queue 0 unpushed 1 push now"));
    n = load_text(t[0..96], 12, 34, 82);
    assert(sb_eq(t[0..96], n, "cpu 12% ram 3.4G disk 82G"));
    n = clock_text(t[0..96], 50700, 0);
    assert(sb_eq(t[0..96], n, "14:05"));
    n = clock_text(t[0..96], 50700, 3600);
    assert(sb_eq(t[0..96], n, "15:05"));
    n = clock_text(t[0..96], 0, 0);
    assert(sb_eq(t[0..96], n, "00:00"));
    var s : [8]u8 = undefined;
    s[0] = 'a'; s[1] = 'Z'; s[2] = '5';
    sb_upper(s[0..8], 3);
    assert(s[0] == 'A' and s[1] == 'Z' and s[2] == '5');
}

test the_load_item_is_red_below_eight_gigabytes {
    assert(load_red(34, 82));
    assert(load_red(120, 7));
    assert(load_red(120, 8) == false);
    assert(load_red(79, 100));
    assert(load_red(80, 100) == false);
}

test every_item_has_a_page_and_a_distinct_rank {
    var i : u32 = 0;
    while (i < IT_COUNT) {
        var j : u32 = i + 1;
        while (j < IT_COUNT) {
            assert(item_rank(i) != item_rank(j));
            j = j + 1;
        }
        i = i + 1;
    }
    assert(item_rank(IT_UPD) == 0);
    assert(item_page(IT_UPD) == PG_UPDATE);
    assert(item_page(IT_LIGHT) == PG_KEYS);
    assert(item_page(IT_QUEEN) == PG_QUEEN);
    assert(item_page(IT_SRV) == PG_PANE);
    assert(item_page(IT_CLOCK) == PG_NONE);
}

test a_wide_bar_shows_every_present_item_in_order_and_a_narrow_one_folds_the_low_priority_first {
    var w : [11]f64 = undefined;
    var i : usize = 0;
    while (i < 11) { w[i] = 80.0; i = i + 1; }
    const all : u32 = 2047;
    // wide: 10 x 80 + 9 x 14 = 926 fits in a 1400 pt window
    const wide : f64 = avail_w(1400.0);
    assert(visible_mask(all, w[0..11], wide) == all);
    assert(sb_item_x(IT_HOST, all, all, w[0..11]) == SB_PAD);
    assert(sb_item_x(IT_VER, all, all, w[0..11]) == SB_PAD + 94.0);
    assert(sb_item_x(IT_FOLD, all, all, w[0..11]) < 0.0);
    // narrow: a 600 pt window folds LOAD, TRIGIT, QUEEN, CLOCK ... in that order, never UPDATE
    const nar : f64 = avail_w(600.0);
    const vis : u32 = visible_mask(all, w[0..11], nar);
    assert(vis != all);
    assert(used_w(vis, all, w[0..11]) <= nar);
    assert((vis >> IT_LOAD) % 2 == 0);
    assert((vis >> IT_UPD) % 2 == 1);
    assert((vis >> IT_VER) % 2 == 1);
    assert(sb_item_x(IT_FOLD, vis, all, w[0..11]) > 0.0);
    // the folded set is exactly the lowest ranks: whatever is kept outranks whatever is folded
    var a : u32 = 0;
    while (a < IT_COUNT) {
        var b : u32 = 0;
        while (b < IT_COUNT) {
            if ((vis >> a) % 2 == 1 and (vis >> b) % 2 == 0) { assert(item_rank(a) < item_rank(b)); }
            b = b + 1;
        }
        a = a + 1;
    }
    // very narrow: only UPDATE is left of the items, or nothing, never a wider selection
    const tiny : f64 = 90.0;
    const v2 : u32 = visible_mask(all, w[0..11], tiny);
    assert(used_w(v2, all, w[0..11]) <= tiny or v2 == 0);
    // an item without a feed takes no room
    const some : u32 = 2047 - 128 - 256;
    assert(visible_mask(some, w[0..11], wide) == some);
    assert(used_w(some, some, w[0..11]) == 80.0 * 9.0 + 14.0 * 8.0);
}

test a_click_finds_the_item_under_it_or_the_fold {
    var w : [11]f64 = undefined;
    var i : usize = 0;
    while (i < 11) { w[i] = 80.0; i = i + 1; }
    const all : u32 = 2047;
    const vis : u32 = visible_mask(all, w[0..11], avail_w(600.0));
    const sh : f64 = 540.0;
    const y : f64 = sh - 10.0;
    assert(sb_item_at(SB_PAD + 5.0, y, sh, vis, all, w[0..11]) == IT_VER);
    assert(sb_item_at(SB_PAD + 5.0, 100.0, sh, vis, all, w[0..11]) == SB_NONE);
    const fx : f64 = sb_item_x(IT_FOLD, vis, all, w[0..11]);
    assert(sb_item_at(fx + 3.0, y, sh, vis, all, w[0..11]) == IT_FOLD);
    // the tooltip lists the folded items' texts
    var slots : [704]u8 = undefined;
    var lens : [11]u32 = undefined;
    var k : usize = 0;
    while (k < 11) { lens[k] = 0; k = k + 1; }
    lens[IT_LOAD as usize] = (put_bytes(slots[0..704], (IT_LOAD as usize) * SB_SLOT, "cpu 1%") - (IT_LOAD as usize) * SB_SLOT) as u32;
    lens[IT_TRIGIT as usize] = (put_bytes(slots[0..704], (IT_TRIGIT as usize) * SB_SLOT, "trigit") - (IT_TRIGIT as usize) * SB_SLOT) as u32;
    var tip : [128]u8 = undefined;
    const tn : usize = fold_tip(slots[0..704], lens[0..11], all - vis, tip[0..128]);
    assert(sb_has(tip[0..128], tn, "cpu 1%"));
    assert(sb_has(tip[0..128], tn, " | "));
}

test the_right_end_keeps_open_source_keys_and_doctor_in_that_order {
    const sw : f64 = 960.0;
    assert(repo_left(sw) < keys_left(sw));
    assert(keys_left(sw) < doc_left(sw));
    assert(doc_left(sw) + DOC_LINK_W <= sw);
    const y : f64 = 530.0;
    assert(on_repo(repo_left(sw) + 4.0, y, sw, 540.0));
    assert(on_keys(keys_left(sw) + 4.0, y, sw, 540.0));
    assert(on_doc(doc_left(sw) + 4.0, y, sw, 540.0));
    assert(on_repo(keys_left(sw) + 4.0, y, sw, 540.0) == false);
    assert(on_doc(doc_left(sw) + 4.0, 100.0, sw, 540.0) == false);
    // the items never run into the right end
    assert(avail_w(sw) + SB_PAD + SB_GAP <= repo_left(sw));
    assert(SB_H >= 22.0 and SB_H <= 24.0);
}

test the_god_mode_switch_is_in_the_header_beside_the_version_and_never_covers_update_now {
    const r : f64 = 700.0;
    const th : f64 = 34.0;
    // the switch is hit where it is drawn, inside the title bar, left of the refresh control at `r`
    assert(on_god_switch(god_x(r) + 4.0, 17.0, r, th));
    assert(on_god_switch(r - 2.0, 17.0, r, th));
    assert(on_god_switch(god_x(r) - 3.0, 17.0, r, th) == false);
    assert(on_god_switch(god_x(r) + 4.0, 40.0, r, th) == false);
    assert(god_x(r) > hdr_btn_x(r) + HDR_BTN_W);
    // with an update waiting the button sits left of the switch and neither hit area contains the other's point
    assert(on_hdr_btn(god_x(r) + 4.0, 17.0, r, th, true) == false);
    assert(on_god_switch(hdr_btn_x(r) + 4.0, 17.0, r, th) == false);
    // the header text ends left of both
    assert(hdr_text_right(r, true) < hdr_btn_x(r));
    assert(hdr_text_right(r, false) < god_x(r));
    assert(god_switch_drawn(true));
}

test the_god_strip_is_shown_exactly_while_god_mode_is_on_and_says_what_it_does {
    assert(strip_shown(true));
    assert(strip_shown(false) == false);
    assert(strip_top(540.0) + STRIP_H == 540.0 - SB_H);
    var t : [128]u8 = undefined;
    var n : usize = god_strip_text(t[0..128], 0, 1, 3, NO_TICK, 0);
    assert(sb_has(t[0..128], n, "GOD MODE ON"));
    assert(sb_has(t[0..128], n, "nothing to do"));
    assert(sb_has(t[0..128], n, "lanes 1/3"));
    assert(sb_has(t[0..128], n, "no tick yet"));
    n = god_strip_text(t[0..128], 0, 2, 3, 300, 0);
    assert(sb_has(t[0..128], n, "tick 5m ok"));
    n = god_strip_text(t[0..128], 0, 2, 3, 30, 1);
    assert(sb_has(t[0..128], n, "tick now failed"));
    n = god_text(t[0..128], false, 0, 3);
    assert(sb_eq(t[0..128], n, "god mode off"));
    n = god_text(t[0..128], true, 1, 3);
    assert(sb_eq(t[0..128], n, "god mode on 1/3"));
    assert(item_page(IT_GOD) == PG_GOD);
    assert(EV_MAX_AGENTS == 3);
}

test the_queen_tick_runs_only_while_god_mode_is_on_and_a_slot_is_free {
    assert(god_tick_due(false, 1000, 0, 0, 3) == false);
    assert(god_tick_due(true, 1000, 0, 0, 3));
    assert(god_tick_due(true, 1000, 900, 0, 3) == false);
    assert(god_tick_due(true, 1200, 900, 0, 3));
    assert(god_tick_due(true, 5000, 0, 3, 3) == false);
    assert(lanes_free(1, 3) == 2);
    assert(lanes_free(5, 3) == 0);
    var t : [256]u8 = undefined;
    const n : usize = tick_cmd(t[0..256], 2);
    assert(sb_has(t[0..256], n, "tri-queen"));
    assert(sb_has(t[0..256], n, "queen --lanes 2 tick"));
}

test short_texts_pack_into_words_and_come_back_and_a_missing_reading_is_left_out {
    var wd : [3]u64 = undefined;
    var o : [24]u8 = undefined;
    pack8(wd[0..3], 0, "Playoms-MacBook-Pro", 19);
    unpack8(wd[0..3], 0, 19, o[0..24]);
    assert(sb_eq(o[0..24], 19, "Playoms-MacBook-Pro"));
    var t : [64]u8 = undefined;
    const n : usize = load_text(t[0..64], NOT_READ, NOT_READ, 82);
    assert(sb_eq(t[0..64], n, "disk 82G"));
    assert(load_red(NOT_READ, 7));
    assert(load_red(NOT_READ, 82) == false);
}
