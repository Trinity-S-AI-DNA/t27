// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen.t27 -- the Queen panel of T27 OS: what the user looked at and pressed, what the Queen
; suggests from it, and GOD MODE.
; Owner, 2026-10-19: the Queen must open a side panel anywhere; she is the orchestrator over the agents
; and sees the context -- where in the interface the user is looking and which buttons they pressed --
; to help the user steer the agents; fully under human control. Then: she should move tasks forward
; proactively, and in GOD MODE do it on her own.
; The model, all of it plain integers so the hot reload keeps it:
;   EVENTS     a ring of the last RING user actions, one u64 each: the view, the control, its argument
;              (an agent or a space) and the time in seconds. The panel shows it as RECENT.
;   CONTEXT    the view, the space and the selected chat, plus the ring -- what the panel shows under
;              LOOKING AT, and what the Queen reads.
;   SUGGESTION one action the Queen proposes from the context. By default nothing runs until the user
;              presses Confirm; Dismiss hides it until the user does something else.
;   GOD MODE   a visible switch in the panel. While it is on, the Queen runs her suggestion herself once
;              the user has been still for GOD_WAIT seconds, and logs it in RECENT as her own action.
;              Cmd+J or Escape stops it, as does the switch itself or closing the panel: she only acts
;              while the panel, and so the log, is on screen.
; Black and white only (FR-006): GOD MODE is a box, empty when off and filled when on, with the words
; "GOD MODE OFF" / "GOD MODE ON" beside it -- shape and text, never a colour.
; The one exception to FR-006, and only as the GOD MODE signal (owner, 2026-10-19: the edge glow
; lights up in god mode; later the same day: the colour of a blue gas flame on a kitchen stove):
; while GOD MODE is on a blue flame (FLAME_*, defined here and nowhere else) lies along the window
; edges: a bright cyan cone at the edge, a vivid blue body, a deep violet-blue base, softly blurred,
; breathing and flickering on the frame count, fading in and out over 1 / GLOW_STEP frames.
; In the normal human-confirm mode the edges have no glow. The window is clear matte black glass as in
; trios (owner, 2026-10-20; glass_window.t27 backdrop_alpha), and full screen, which cannot be
; transparent, is opaque black #000000, so no wallpaper washes through there.
; Not here yet (no server behind them): a real Queen model reading the context, tasks on a board, and
; prompts sent into agent processes. The only actions are the ones the app can do today: open a chat,
; select a chat, open the space's folder in a terminal editor.
; Opening a path (owner, 2026-10-20: "T27OS opens inside!!"): open_target says where it goes -- a pane of
; the PTY server running a terminal editor, shown inside the window (editors.t27 editor_command,
; pty_logic.t27 launch_command), never a window of another app that she starts on her own. When she has
; nothing else to suggest and a terminal editor is there, suggest_for offers A_EDIT for the space (path =
; the space's folder); GOD MODE runs it once per space (edit_todo / edit_mark), then it is done.

module T27osQueen;

use t27os::agents::AGENT_COUNT;
use t27os::windows::SESSION_NONE;
use t27os::windows::NEW_CHAT_DEFAULT;
use t27os::windows::session_count;
use t27os::windows::session_agent;
use t27os::windows::add_session;
use t27os::windows::session_at_row;
use t27os::windows::sessions_in;
use t27os::session_store::csv_field;

/// The ring holds the last RING events.
pub const RING : u32 = 8;
pub const RING_NONE : u32 = 4294967295;

/// Views: a world index (0 .. 14) when a screen is open, VIEW_HOME on the petal menu.
pub const VIEW_HOME : u32 = 15;

/// Controls, in CONTROL_NAMES order.
pub const C_CELL : u32 = 0;
pub const C_NEW_CHAT : u32 = 1;
pub const C_CLOSE_CHAT : u32 = 2;
pub const C_QUEEN_ROW : u32 = 3;
pub const C_SPACE_ROW : u32 = 4;
pub const C_AGENT_ROW : u32 = 5;
pub const C_SIDEBAR : u32 = 6;
pub const C_DASHBOARD : u32 = 7;
pub const C_QUEEN_KEY : u32 = 8;
pub const C_CONFIRM : u32 = 9;
pub const C_DISMISS : u32 = 10;
pub const C_GOD_ON : u32 = 11;
pub const C_GOD_OFF : u32 = 12;
pub const C_QUEEN_OPENED : u32 = 13;
pub const C_QUEEN_PICKED : u32 = 14;
pub const C_HOME : u32 = 15;
pub const C_WORLD : u32 = 16;
pub const C_NEW_SPACE : u32 = 17;
pub const C_CLOSE_SPACE : u32 = 18;
pub const C_REPO_LINK : u32 = 19;
pub const C_QUEEN_EDITED : u32 = 20;
pub const C_QUEEN_STARTED : u32 = 21;
pub const C_QUEEN_ASKED : u32 = 22;
pub const C_QUEEN_CHAT : u32 = 23;
pub const C_QUEEN_SENT : u32 = 24;
pub const C_COUNT : u32 = 25;
pub const C_NONE : u32 = 4294967295;
pub const CONTROL_NAMES : str = "tapped a cell,+ new chat,closed a chat,Queen row,picked a space,picked a chat,sidebar,dashboard,Queen panel,confirmed,dismissed,GOD MODE on,GOD MODE off,she opened,she picked,went home,opened a screen,+ new space,closed a space,opened the repo,she opened the editor,she started a lane,she asked the owner,the Queen chat dock,sent the Queen a line";

/// What an event's argument names.
pub const ARG_NONE : u32 = 0;
pub const ARG_AGENT : u32 = 1;
pub const ARG_SPACE : u32 = 2;

/// Suggestions, in SUGGEST_WORDS order.
pub const A_NONE : u32 = 0;
pub const A_OPEN : u32 = 1;
pub const A_SELECT : u32 = 2;
pub const A_EDIT : u32 = 3;
pub const SUGGEST_WORDS : str = "Nothing to do here,Open a Claude Code chat in this space,Open the first chat of this space,Open this space in a terminal editor";

/// The age of an event, in AGE_WORDS order.
pub const AGE_WORDS : str = "just now,seconds ago,a minute ago,minutes ago,earlier";

/// Seconds of stillness before GOD MODE acts, and between two of her actions.
pub const GOD_WAIT : u64 = 3;

/// Panel geometry: a column QP_W wide on the right, from the top of the workspace (points).
pub const QP_W : f64 = 300.0;
pub const QP_PAD : f64 = 16.0;
pub const QP_GOD_Y : f64 = 40.0;
pub const QP_GOD_H : f64 = 44.0;
pub const QP_CTX_Y : f64 = 104.0;
pub const QP_SUG_Y : f64 = 176.0;
pub const QP_BTN_Y : f64 = 208.0;
pub const QP_BTN_W : f64 = 96.0;
pub const QP_BTN_H : f64 = 26.0;
pub const QP_BTN_GAP : f64 = 8.0;
pub const QP_RECENT_Y : f64 = 262.0;
pub const QP_LINE : f64 = 20.0;
pub const QP_CLOSE : f64 = 16.0;

// ---- GOD MODE edge glow (the FR-006 exception) ----

/// A blue gas flame on a kitchen stove (owner, 2026-10-19), the only colour on the screen, and only
/// while GOD MODE is on. Three stops from the window edge inward: the bright cyan inner cone at the
/// edge, a vivid blue body, and a deep violet-blue base where the flame fades into the black.
pub const FLAME_CORE_R : f64 = 0.56;
pub const FLAME_CORE_G : f64 = 0.86;
pub const FLAME_CORE_B : f64 = 1.0;
pub const FLAME_MID_R : f64 = 0.16;
pub const FLAME_MID_G : f64 = 0.42;
pub const FLAME_MID_B : f64 = 1.0;
pub const FLAME_BASE_R : f64 = 0.22;
pub const FLAME_BASE_G : f64 = 0.10;
pub const FLAME_BASE_B : f64 = 0.80;
/// The cone ends and the body begins this far (0..1) across the glow.
pub const FLAME_CONE : f64 = 0.22;
/// The glow is GLOW_BANDS strips across GLOW_W pt from each edge, brightest at the edge: many thin
/// strips with a smooth falloff read as a blur rather than a line.
pub const GLOW_W : f64 = 44.0;
pub const GLOW_BANDS : u32 = 30;
pub const GLOW_PEAK : f64 = 0.62;
/// The bright hairline of the cone at the very edge, GLOW_CORE_W pt wide, blurred GLOW_BLUR pt.
pub const GLOW_CORE_W : f64 = 1.5;
pub const GLOW_BLUR : f64 = 22.0;
pub const GLOW_CORE_A : f64 = 0.85;
/// Breathing: the whole flame dims by up to BREATH_AMP over BREATH_FRAMES (3 s at 30 fps).
pub const BREATH_FRAMES : u32 = 90;
pub const BREATH_AMP : f64 = 0.16;
/// Flicker: tongues travel along the bands, a strip LICK_SHIFT frames behind the one outside it,
/// LICK_FRAMES per cycle; the outer bands (the tips) flicker by up to LICK_AMP, the cone hardly at all.
pub const LICK_FRAMES : u32 = 19;
pub const LICK_SHIFT : u32 = 3;
pub const LICK_AMP : f64 = 0.30;
/// The level moves this far toward on or off each frame: about a third of a second at 30 fps.
pub const GLOW_STEP : f64 = 0.1;

/// The glow is on exactly while GOD MODE is on; the human-confirm mode has black edges.
pub fn glow_on(god: bool) -> bool {
    return god;
}

/// The glow level after one frame: up toward 1 while it is on, down toward 0 while it is off.
pub fn glow_level(g: f64, on: bool) -> f64 {
    if (on) {
        if (g + GLOW_STEP >= 1.0) { return 1.0; }
        return g + GLOW_STEP;
    }
    if (g - GLOW_STEP <= 0.0) { return 0.0; }
    return g - GLOW_STEP;
}

/// The glow level after k logical ticks (fractions kept, so a 60 fps redraw takes half a step).
pub fn glow_level_k(g: f64, on: bool, k: f64) -> f64 {
    if (on) {
        if (g + GLOW_STEP * k >= 1.0) { return 1.0; }
        return g + GLOW_STEP * k;
    }
    if (g - GLOW_STEP * k <= 0.0) { return 0.0; }
    return g - GLOW_STEP * k;
}

/// How far strip `band` lies across the glow: 0 at the edge, approaching 1 at the inner side.
pub fn band_t(band: u32) -> f64 {
    return @as(f64, @floatFromInt(band)) / @as(f64, @floatFromInt(GLOW_BANDS));
}

/// A smooth wave in 0..1 with period `p` frames: a triangle eased with smoothstep, 0 at n = 0.
pub fn flame_wave(n: u32, p: u32) -> f64 {
    const m : f64 = @as(f64, @floatFromInt(n % p));
    var x : f64 = 2.0 * m / @as(f64, @floatFromInt(p));
    if (x > 1.0) { x = 2.0 - x; }
    return x * x * (3.0 - 2.0 * x);
}

/// The flame's brightness (1 at rest) for strip `band` on frame `frame`: slow breathing on the
/// whole flame, and tongues that flicker more toward the outer tips.
pub fn flicker(frame: u32, band: u32) -> f64 {
    const breath : f64 = flame_wave(frame, BREATH_FRAMES);
    const lick : f64 = flame_wave(frame + band * LICK_SHIFT, LICK_FRAMES);
    return 1.0 - BREATH_AMP * breath - LICK_AMP * band_t(band) * lick;
}

/// Channel `k` (0 red, 1 green, 2 blue) of strip `band`: cone to body over 0..FLAME_CONE, body to
/// base over FLAME_CONE..1.
pub fn flame_rgb(band: u32, k: u32) -> f64 {
    const t : f64 = band_t(band);
    var a : f64 = FLAME_CORE_R;
    var b : f64 = FLAME_MID_R;
    var u : f64 = t / FLAME_CONE;
    if (t >= FLAME_CONE) {
        a = FLAME_MID_R;
        b = FLAME_BASE_R;
        u = (t - FLAME_CONE) / (1.0 - FLAME_CONE);
        if (k == 1) { a = FLAME_MID_G; b = FLAME_BASE_G; }
        if (k == 2) { a = FLAME_MID_B; b = FLAME_BASE_B; }
    } else {
        if (k == 1) { a = FLAME_CORE_G; b = FLAME_MID_G; }
        if (k == 2) { a = FLAME_CORE_B; b = FLAME_MID_B; }
    }
    return a + (b - a) * u;
}

/// The alpha of strip `band` (0 at the edge) at level `g` on frame `frame`: a smooth cubic falloff
/// times the flicker; nothing at level 0 or past the last strip.
pub fn glow_alpha(g: f64, band: u32, frame: u32) -> f64 {
    if (band >= GLOW_BANDS) { return 0.0; }
    const f : f64 = 1.0 - band_t(band);
    return GLOW_PEAK * g * f * f * f * flicker(frame, band);
}

/// The alpha of the blurred cone hairline at level `g` on frame `frame`: it breathes, it does not lick.
pub fn core_alpha(g: f64, frame: u32) -> f64 {
    return GLOW_CORE_A * g * flicker(frame, 0);
}

// ---- events ----

fn pow2(k: u32) -> u64 {
    var p : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        p = p * 2;
        i = i + 1;
    }
    return p;
}

/// One event: 1 + view + 16 control + 1024 argument + 2^18 seconds; 0 is an empty slot.
pub fn ev_pack(view: u32, control: u32, arg: u32, sec: u64) -> u64 {
    return 1 + @as(u64, view % 16) + 16 * @as(u64, control % 64) + 1024 * @as(u64, arg % 256) + pow2(18) * sec;
}

pub fn ev_view(e: u64) -> u32 {
    if (e == 0) { return VIEW_HOME; }
    return @as(u32, @intCast((e - 1) % 16));
}

pub fn ev_control(e: u64) -> u32 {
    if (e == 0) { return C_NONE; }
    return @as(u32, @intCast((e - 1) / 16 % 64));
}

pub fn ev_arg(e: u64) -> u32 {
    if (e == 0) { return 0; }
    return @as(u32, @intCast((e - 1) / 1024 % 256));
}

pub fn ev_sec(e: u64) -> u64 {
    if (e == 0) { return 0; }
    return (e - 1) / pow2(18);
}

/// What the argument of a control names: the agent for chat controls, the space for a space row.
pub fn arg_kind(control: u32) -> u32 {
    if (control == C_CELL or control == C_NEW_CHAT or control == C_CLOSE_CHAT or control == C_AGENT_ROW) { return ARG_AGENT; }
    if (control == C_QUEEN_OPENED or control == C_QUEEN_PICKED) { return ARG_AGENT; }
    if (control == C_SPACE_ROW or control == C_NEW_SPACE or control == C_CLOSE_SPACE or control == C_QUEEN_EDITED) { return ARG_SPACE; }
    return ARG_NONE;
}

/// The Queen's own actions, so the log can tell them from the user's.
pub fn by_queen(control: u32) -> bool {
    return control == C_QUEEN_OPENED or control == C_QUEEN_PICKED or control == C_QUEEN_EDITED or control == C_QUEEN_STARTED or control == C_QUEEN_ASKED;
}

/// The view a frame is on: the open world, or home.
pub fn view_of(open: bool, shown: u32) -> u32 {
    if (open and shown < VIEW_HOME) { return shown; }
    return VIEW_HOME;
}

/// Events held after `n` pushes.
pub fn ring_len(n: u32) -> u32 {
    if (n < RING) { return n; }
    return RING;
}

/// The slot to write the next event into after `n` pushes.
pub fn ring_next(n: u32) -> u32 {
    return n % RING;
}

/// The slot of the `back`-th most recent event (0 = the newest), or RING_NONE past the oldest.
pub fn ring_at(n: u32, back: u32) -> u32 {
    if (back >= ring_len(n)) { return RING_NONE; }
    return (n - 1 - back) % RING;
}

/// How old an event is, as an AGE_WORDS index.
pub fn age_word(now: u64, then: u64) -> u32 {
    if (then >= now) { return 0; }
    const d : u64 = now - then;
    if (d < 5) { return 0; }
    if (d < 60) { return 1; }
    if (d < 120) { return 2; }
    if (d < 3600) { return 3; }
    return 4;
}

// ---- suggestion and GOD MODE ----

/// The Queen's one suggestion from the context: open a chat in an empty space, or select one when
/// the space has chats and none is selected.
pub fn suggest(rows: u32, selected: bool) -> u32 {
    if (rows == 0) { return A_OPEN; }
    if (selected == false) { return A_SELECT; }
    return A_NONE;
}

/// A dismissed suggestion stays hidden until the user does something else.
pub fn shown_suggestion(s: u32, dismissed: u32) -> u32 {
    if (s == dismissed) { return A_NONE; }
    return s;
}

/// The control that logs a Queen action.
pub fn queen_control(s: u32) -> u32 {
    if (s == A_OPEN) { return C_QUEEN_OPENED; }
    if (s == A_SELECT) { return C_QUEEN_PICKED; }
    if (s == A_EDIT) { return C_QUEEN_EDITED; }
    return C_NONE;
}

/// One bit per space (spaces 0 .. 63) records that the editor was opened for it, by the user's chip, a
/// confirmed suggestion or GOD MODE, so she suggests it once per space and never again -- GOD MODE does not
/// reopen it every GOD_WAIT seconds. A space past 63 is never offered it.
pub fn edit_todo(done: u64, space: u32) -> bool {
    if (space >= 64) { return false; }
    return done / pow2(space) % 2 == 0;
}

pub fn edit_mark(done: u64, space: u32) -> u64 {
    if (edit_todo(done, space) == false) { return done; }
    return done + pow2(space);
}

/// The suggestion with the editor offered last: when the rules above have nothing to do, a terminal editor
/// is there (`can_open`) and the space has not had it yet, she suggests opening the space in it -- inside
/// the window (open_target). The path is the space's folder, which the window knows.
pub fn suggest_for(rows: u32, selected: bool, can_open: bool, done: u64, space: u32) -> u32 {
    const s : u32 = suggest(rows, selected);
    if (s == A_NONE and can_open and edit_todo(done, space)) { return A_EDIT; }
    return s;
}

/// Who asked the window to open the editor (a request the main loop serves in one place): the user -- the
/// strip's chip or Confirm -- or GOD MODE, which open_target keeps inside.
pub const IE_NONE : u32 = 0;
pub const IE_USER : u32 = 1;
pub const IE_GOD : u32 = 2;

/// Where "open this path" goes. OT_INSIDE: a pane of the PTY server running a terminal editor, shown in
/// the window. OT_OUTSIDE: another app's window (a GUI editor from editors.t27). OT_NONE: nothing to open it with.
pub const OT_NONE : u32 = 0;
pub const OT_INSIDE : u32 = 1;
pub const OT_OUTSIDE : u32 = 2;

/// T27 OS opens inside (owner, 2026-10-20): with a terminal editor to hand the path opens in a pane, for
/// the user's Confirm and for GOD MODE alike. Without one, GOD MODE does nothing -- she never starts
/// another app's window on her own while nobody is watching -- and a suggestion the user confirmed falls
/// back to an installed GUI editor.
pub fn open_target(is_god: bool, term_found: bool, ext_found: bool) -> u32 {
    if (term_found) { return OT_INSIDE; }
    if (is_god) { return OT_NONE; }
    if (ext_found) { return OT_OUTSIDE; }
    return OT_NONE;
}

/// True when GOD MODE should act now: on, the panel open, something to do, and the user and the
/// Queen herself both still for GOD_WAIT seconds.
pub fn god_due(god: bool, open: bool, s: u32, now: u64, last_user: u64, last_act: u64) -> bool {
    if (god == false or open == false or s == A_NONE) { return false; }
    return now >= last_user + GOD_WAIT and now >= last_act + GOD_WAIT;
}

/// Cmd+J: stops GOD MODE first; with GOD MODE off it opens or closes the panel. Returns the panel
/// and GOD MODE after the key as 1 * open + 2 * god.
pub fn on_queen_key(open: bool, god: bool) -> u32 {
    if (god) { return 1; }
    if (open) { return 0; }
    return 1;
}

/// The sessions after the Queen runs `s` in `space`.
pub fn act_sessions(ss: u64, s: u32, space: u32) -> u64 {
    if (s == A_OPEN) { return add_session(ss, NEW_CHAT_DEFAULT, space); }
    return ss;
}

/// The selected chat after the Queen runs `s`: the chat she opened, or the first of the space.
pub fn act_cur(ss: u64, s: u32, space: u32, cur: u32) -> u32 {
    if (s == A_OPEN) {
        if (session_count(add_session(ss, NEW_CHAT_DEFAULT, space)) > session_count(ss)) { return session_count(ss); }
        return cur;
    }
    if (s == A_SELECT and sessions_in(ss, space) > 0) { return session_at_row(ss, space, 0); }
    return cur;
}

// ---- panel geometry ----

pub fn qp_left(sw: f64) -> f64 {
    return sw - QP_W;
}

fn in_rect(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x < l + w and y >= t and y < t + h;
}

/// True when (x, y) is on the panel; `top` is the top of the workspace.
pub fn on_panel(x: f64, y: f64, sw: f64, top: f64) -> bool {
    return x >= qp_left(sw) and x <= sw and y >= top;
}

pub fn on_panel_close(x: f64, y: f64, sw: f64, top: f64) -> bool {
    return in_rect(x, y, sw - QP_PAD - QP_CLOSE, top + 12.0, QP_CLOSE, QP_CLOSE);
}

pub fn on_god(x: f64, y: f64, sw: f64, top: f64) -> bool {
    return in_rect(x, y, qp_left(sw) + QP_PAD, top + QP_GOD_Y, QP_W - 2.0 * QP_PAD, QP_GOD_H);
}

pub fn on_confirm(x: f64, y: f64, sw: f64, top: f64) -> bool {
    return in_rect(x, y, qp_left(sw) + QP_PAD, top + QP_BTN_Y, QP_BTN_W, QP_BTN_H);
}

pub fn on_dismiss(x: f64, y: f64, sw: f64, top: f64) -> bool {
    return in_rect(x, y, qp_left(sw) + QP_PAD + QP_BTN_W + QP_BTN_GAP, top + QP_BTN_Y, QP_BTN_W, QP_BTN_H);
}

/// The RECENT lines that fit between QP_RECENT_Y and the bottom, at most RING.
pub fn recent_rows(sh: f64, top: f64) -> u32 {
    const room : f64 = sh - top - QP_RECENT_Y - 24.0;
    if (room <= 0.0) { return 0; }
    const n : u32 = @as(u32, @intFromFloat(room / QP_LINE));
    if (n > RING) { return RING; }
    return n;
}

// ---- tests ----

test an_event_keeps_its_view_control_argument_and_time {
    const e : u64 = ev_pack(3, C_NEW_CHAT, 7, 1792387306);
    assert e != 0;
    assert ev_view(e) == 3;
    assert ev_control(e) == C_NEW_CHAT;
    assert ev_arg(e) == 7;
    assert ev_sec(e) == 1792387306;
    // the largest of each field round-trips
    const m : u64 = ev_pack(VIEW_HOME, C_COUNT - 1, 255, 4000000000);
    assert ev_view(m) == VIEW_HOME;
    assert ev_control(m) == C_COUNT - 1;
    assert ev_arg(m) == 255;
    assert ev_sec(m) == 4000000000;
    // an empty slot reads as no control
    assert ev_control(0) == C_NONE;
    // every control fits the 6-bit field
    assert C_COUNT <= 64;
    assert view_of(false, 4) == VIEW_HOME;
    assert view_of(true, 4) == 4;
}

test the_ring_keeps_the_last_eight_newest_first {
    assert ring_len(0) == 0;
    assert ring_at(0, 0) == RING_NONE;
    // three pushes: slots 0, 1, 2; the newest is slot 2
    assert ring_len(3) == 3;
    assert ring_at(3, 0) == 2;
    assert ring_at(3, 2) == 0;
    assert ring_at(3, 3) == RING_NONE;
    // eleven pushes wrap: the newest went to slot 2, the oldest kept is slot 3
    assert ring_next(10) == 2;
    assert ring_len(11) == RING;
    assert ring_at(11, 0) == 2;
    assert ring_at(11, RING - 1) == 3;
    assert ring_at(11, RING) == RING_NONE;
}

test ages_read_as_words {
    assert age_word(100, 100) == 0;
    assert age_word(100, 97) == 0;
    assert age_word(100, 50) == 1;
    assert age_word(200, 100) == 2;
    assert age_word(1000, 100) == 3;
    assert age_word(10000, 100) == 4;
    // a clock that moved back is "just now", not a huge age
    assert age_word(100, 200) == 0;
}

test the_queen_suggests_and_waits_for_a_human {
    assert suggest(0, false) == A_OPEN;
    assert suggest(2, false) == A_SELECT;
    assert suggest(2, true) == A_NONE;
    // dismissed stays hidden; another suggestion shows
    assert shown_suggestion(A_OPEN, A_OPEN) == A_NONE;
    assert shown_suggestion(A_SELECT, A_OPEN) == A_SELECT;
    assert queen_control(A_OPEN) == C_QUEEN_OPENED;
    assert by_queen(queen_control(A_SELECT));
    assert by_queen(C_NEW_CHAT) == false;
    assert arg_kind(C_SPACE_ROW) == ARG_SPACE;
    assert arg_kind(C_NEW_SPACE) == ARG_SPACE;
    assert arg_kind(C_CLOSE_SPACE) == ARG_SPACE;
    assert arg_kind(C_REPO_LINK) == ARG_NONE;
    assert arg_kind(C_QUEEN_OPENED) == ARG_AGENT;
    assert arg_kind(C_GOD_ON) == ARG_NONE;
}

test god_mode_acts_only_when_on_open_and_still {
    // off: never, however long the wait
    assert god_due(false, true, A_OPEN, 1000, 0, 0) == false;
    // the panel closed: never, the log would be off screen
    assert god_due(true, false, A_OPEN, 1000, 0, 0) == false;
    // nothing to do: never
    assert god_due(true, true, A_NONE, 1000, 0, 0) == false;
    // the user moved a second ago: wait
    assert god_due(true, true, A_OPEN, 1000, 999, 0) == false;
    // she acted a second ago: wait
    assert god_due(true, true, A_OPEN, 1000, 0, 999) == false;
    assert god_due(true, true, A_OPEN, 1000, 1000 - GOD_WAIT, 1000 - GOD_WAIT);
    // Cmd+J stops GOD MODE and keeps the panel; otherwise it toggles the panel
    assert on_queen_key(true, true) == 1;
    assert on_queen_key(true, false) == 0;
    assert on_queen_key(false, false) == 1;
}

test the_panel_buttons_answer_only_on_their_boxes {
    const sw : f64 = 1200.0;
    const top : f64 = 35.0;
    const l : f64 = qp_left(sw);
    assert on_panel(l + 1.0, top + 1.0, sw, top);
    assert on_panel(l - 1.0, top + 1.0, sw, top) == false;
    assert on_panel(l + 1.0, top - 1.0, sw, top) == false;
    assert on_god(l + 40.0, top + QP_GOD_Y + 10.0, sw, top);
    assert on_confirm(l + QP_PAD + 1.0, top + QP_BTN_Y + 1.0, sw, top);
    assert on_confirm(l + QP_PAD + QP_BTN_W + 4.0, top + QP_BTN_Y + 1.0, sw, top) == false;
    assert on_dismiss(l + QP_PAD + QP_BTN_W + QP_BTN_GAP + 1.0, top + QP_BTN_Y + 1.0, sw, top);
    assert on_panel_close(sw - QP_PAD - 8.0, top + 20.0, sw, top);
    // the boxes do not overlap, top to bottom
    assert QP_GOD_Y + QP_GOD_H < QP_CTX_Y;
    assert QP_CTX_Y + 56.0 < QP_SUG_Y;
    assert QP_BTN_Y + QP_BTN_H < QP_RECENT_Y;
    assert 2.0 * QP_PAD + 2.0 * QP_BTN_W + QP_BTN_GAP < QP_W;
    // RECENT fits what room there is
    assert recent_rows(540.0, top) == RING;
    assert recent_rows(300.0, top) == 0;
}

test a_confirmed_suggestion_opens_or_selects_a_chat {
    // an empty space: she opens Claude Code there and selects it
    const s0 : u64 = 0;
    assert suggest(sessions_in(s0, 1), false) == A_OPEN;
    const s1 : u64 = act_sessions(s0, A_OPEN, 1);
    const c1 : u32 = act_cur(s0, A_OPEN, 1, SESSION_NONE);
    assert session_count(s1) == 1;
    assert c1 == 0;
    assert session_agent(s1, c1) == NEW_CHAT_DEFAULT;
    // now there is a chat and it is selected: nothing more to do, so GOD MODE stops by itself
    assert suggest(sessions_in(s1, 1), c1 != SESSION_NONE) == A_NONE;
    // chats but none selected: she selects the first, the sessions unchanged
    assert act_sessions(s1, A_SELECT, 1) == s1;
    assert act_cur(s1, A_SELECT, 1, SESSION_NONE) == 0;
    // nothing to do changes nothing
    assert act_cur(s1, A_NONE, 1, SESSION_NONE) == SESSION_NONE;
    assert NEW_CHAT_DEFAULT < AGENT_COUNT;
}

test the_edge_glow_is_a_blue_gas_flame_and_only_in_god_mode {
    // on exactly in GOD MODE, black edges in the human-confirm mode
    assert glow_on(true);
    assert glow_on(false) == false;
    // a gas flame: blue leads at every stop; the cone is cyan (green over red), the base violet (red over green)
    assert FLAME_CORE_B >= FLAME_CORE_G and FLAME_CORE_G > FLAME_CORE_R;
    assert FLAME_MID_B > FLAME_MID_G and FLAME_MID_G > FLAME_MID_R;
    assert FLAME_BASE_B > FLAME_BASE_R and FLAME_BASE_R > FLAME_BASE_G;
    // the edge strip is the cone, the colour darkens inward, and stays blue all the way
    assert flame_rgb(0, 0) == FLAME_CORE_R;
    assert flame_rgb(0, 2) == FLAME_CORE_B;
    assert flame_rgb(GLOW_BANDS - 1, 1) < flame_rgb(0, 1);
    assert flame_rgb(GLOW_BANDS - 1, 2) > flame_rgb(GLOW_BANDS - 1, 0);
    // the wave is smooth and bounded: 0 at the start of a period, 1 at its middle
    assert flame_wave(0, BREATH_FRAMES) == 0.0;
    assert flame_wave(BREATH_FRAMES / 2, BREATH_FRAMES) == 1.0;
    assert flame_wave(BREATH_FRAMES, BREATH_FRAMES) == 0.0;
    // breathing dims the flame by BREATH_AMP at most; it never goes out
    assert flicker(0, 0) == 1.0;
    assert flicker(BREATH_FRAMES / 2, 0) == 1.0 - BREATH_AMP;
    assert flicker(7, GLOW_BANDS - 1) > 1.0 - BREATH_AMP - LICK_AMP;
    // the tongues move: an outer strip is not the same on two nearby frames
    assert flicker(0, GLOW_BANDS - 1) != flicker(5, GLOW_BANDS - 1);
    assert core_alpha(1.0, 0) == GLOW_CORE_A;
    assert core_alpha(0.0, 0) == 0.0;
    // fades in and out, and stays inside 0..1
    assert glow_level(0.0, true) == GLOW_STEP;
    assert glow_level(0.95, true) == 1.0;
    assert glow_level(1.0, false) == 1.0 - GLOW_STEP;
    assert glow_level(0.05, false) == 0.0;
    assert glow_level(0.0, false) == 0.0;
    // brightest at the edge, nothing at level 0 or past the last strip
    assert glow_alpha(1.0, 0, 0) == GLOW_PEAK;
    assert glow_alpha(1.0, 1, 0) < glow_alpha(1.0, 0, 0);
    assert glow_alpha(0.0, 0, 0) == 0.0;
    assert glow_alpha(1.0, GLOW_BANDS, 0) == 0.0;
}

test t27_os_opens_inside_and_god_mode_never_starts_another_apps_window {
    // a terminal editor is there: inside, whoever asked (the Mac always has vim)
    assert open_target(false, true, true) == OT_INSIDE;
    assert open_target(true, true, true) == OT_INSIDE;
    assert open_target(false, true, false) == OT_INSIDE;
    assert open_target(true, true, false) == OT_INSIDE;
    // none: a confirmed suggestion falls back to a GUI editor, GOD MODE does not act alone
    assert open_target(false, false, true) == OT_OUTSIDE;
    assert open_target(true, false, true) == OT_NONE;
    // nothing at all
    assert open_target(false, false, false) == OT_NONE;
    assert open_target(true, false, false) == OT_NONE;
    // the three answers are distinct
    assert OT_NONE != OT_INSIDE;
    assert OT_INSIDE != OT_OUTSIDE;
    assert OT_NONE != OT_OUTSIDE;
}

test the_editor_is_offered_last_and_once_per_space {
    // the old rules come first: an empty space is offered a chat, a chat that is not selected is selected
    assert suggest_for(0, false, true, 0, 1) == A_OPEN;
    assert suggest_for(2, false, true, 0, 1) == A_SELECT;
    // nothing else to do, a terminal editor there, the space not done: the editor
    assert suggest_for(2, true, true, 0, 1) == A_EDIT;
    // no terminal editor to open it in: nothing, as before
    assert suggest_for(2, true, false, 0, 1) == A_NONE;
    // done for space 1 is not done for space 2
    const d1 : u64 = edit_mark(0, 1);
    assert suggest_for(2, true, true, d1, 1) == A_NONE;
    assert suggest_for(2, true, true, d1, 2) == A_EDIT;
    assert edit_mark(d1, 1) == d1;
    assert edit_mark(d1, 2) == d1 + 4;
    assert edit_todo(d1, 0);
    assert edit_todo(d1, 1) == false;
    // spaces 0 .. 63 only; the top bit works, past it never
    assert edit_todo(0, 63);
    assert edit_todo(edit_mark(0, 63), 63) == false;
    assert edit_todo(0, 64) == false;
    assert edit_mark(0, 64) == 0;
    // the suggestion is dismissible like any other and reads as the Queen's own action
    assert shown_suggestion(A_EDIT, A_EDIT) == A_NONE;
    assert shown_suggestion(A_EDIT, A_OPEN) == A_EDIT;
    assert queen_control(A_EDIT) == C_QUEEN_EDITED;
    assert by_queen(C_QUEEN_EDITED);
    assert arg_kind(C_QUEEN_EDITED) == ARG_SPACE;
}

test god_mode_opens_the_editor_once_not_every_three_seconds {
    // 200 ticks one second apart in space 3: GOD MODE is on, the panel open, the user still. The first tick that
    // is due acts and marks the space; she never acts again, however long she is left alone.
    var done : u64 = 0;
    var last_act : u64 = 0;
    var acts : u32 = 0;
    var now : u64 = 1000;
    while (now < 1200) {
        const sug : u32 = suggest_for(2, true, true, done, 3);
        if (god_due(true, true, sug, now, 0, last_act)) {
            acts = acts + 1;
            last_act = now;
            if (sug == A_EDIT) { done = edit_mark(done, 3); }
        }
        now = now + 1;
    }
    assert acts == 1;
    assert edit_todo(done, 3) == false;
    // another space gets its own one
    assert suggest_for(2, true, true, done, 4) == A_EDIT;
}

test the_event_names_and_suggestion_words_cover_the_new_entries {
    var b : [64]u8 = undefined;
    assert csv_field(CONTROL_NAMES, C_QUEEN_EDITED, b[0..64]) > 0;
    assert csv_field(CONTROL_NAMES, C_COUNT - 1, b[0..64]) > 0;
    assert csv_field(CONTROL_NAMES, C_COUNT, b[0..64]) == 0;
    assert csv_field(SUGGEST_WORDS, A_EDIT, b[0..64]) > 0;
    assert csv_field(SUGGEST_WORDS, A_EDIT + 1, b[0..64]) == 0;
    // who asked: the three requests are distinct
    assert IE_NONE != IE_USER;
    assert IE_USER != IE_GOD;
    assert IE_NONE != IE_GOD;
    // inside whoever asked, once a terminal editor is there
    assert open_target(true, true, false) == OT_INSIDE;
    assert open_target(false, true, false) == OT_INSIDE;
}

test the_glow_steps_by_k_and_clamps_at_both_ends {
    assert glow_level_k(0.95, true, 1.0) == 1.0;
    assert glow_level_k(1.0, true, 5.0) == 1.0;
    assert glow_level_k(0.0, false, 3.0) == 0.0;
    assert glow_level_k(0.05, false, 1.0) == 0.0;
    assert glow_level_k(0.5, true, 0.0) == 0.5;
    assert glow_level_k(0.5, false, 0.0) == 0.5;
    assert glow_level_k(0.5, true, 2.0) > 0.69 and glow_level_k(0.5, true, 2.0) < 0.71;
    assert glow_level_k(0.5, false, 2.0) > 0.29 and glow_level_k(0.5, false, 2.0) < 0.31;
    assert glow_level_k(0.0, true, 1.0) > 0.09 and glow_level_k(0.0, true, 1.0) < 0.11;
}

test band_t_runs_from_zero_at_the_edge_to_one_at_the_last_strip {
    assert band_t(0) == 0.0;
    assert band_t(GLOW_BANDS) == 1.0;
    assert band_t(15) == 0.5;
    assert band_t(3) > 0.09 and band_t(3) < 0.11;
    assert band_t(GLOW_BANDS - 1) < 1.0 and band_t(GLOW_BANDS - 1) > 0.96;
}
