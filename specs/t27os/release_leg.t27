// SPDX-License-Identifier: Apache-2.0
// specs/t27os/release_leg.t27 -- the lab leg that builds and publishes a T27 OS release (issue #12479,
// epic #11037). The card is specs/crons/t27-t27os-release.t27; this file is its law and its text.
//
// Why a leg and not the Mac: `tri t27os publish --yes` (release.t27 :: publish_text) runs
// `cargo build --release -p t27c -p tri -p t27b` and `make t27os`, and the Mac refuses heavy builds
// (mac-no-heavy.py, owner 2026-10-09). The macOS runner the t27os.yml gate already builds the app on
// (macos-14, arm64) is the lab host that is not the Mac, so the release is cut there.
//
// The law, here:
//   - the leg starts only from workflow_dispatch; it has no schedule, push or pull_request trigger;
//   - it publishes only when the dispatcher typed `yes` in the owner_yes input (default `no`), which
//     is the workflow's reading of the owner's --yes: publish_allowed(plan_only = false, owner_yes);
//   - it runs on master only: the job's if reads github.ref, so the commit it builds is the master tip;
//   - it checks out the whole history, because the build number is `git rev-list --count HEAD` and a
//     shallow clone would publish build 1 under a fresh tag;
//   - no input reaches bash: owner_yes is read only in the job's if expression, never expanded in a run
//     body, a loop list or an assignment (lab_inputs.t27, #11950);
//   - one release at a time (concurrency), and only the job's own token (github.token, contents: write):
//     releases live in this repository (github.com/gHashTag/t27 redirects here), so no secret is named;
//   - the plan step is written before the publish step, and the publish step is the only one holding
//     --yes (the law checks that both are there; the order is the text's).
// The workflow below is the text written byte for byte to .github/workflows/t27os-release.yml. It is 18
// lines on purpose: that file is a foreign file, so every line pays the own-language budget. Its PR
// carries the owner's `owner-approved-foreign` label (granted 2026-10-25), deletes scripts/gen_w868.py
// (ported to specs/port/scripts/gen_w868.t27) to stay net zero, and gate-topology classifies the new
// workflow. Nothing here runs a build or publishes. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osReleaseLeg;

use t27os::keysync::contains;
use t27os::release::publish_allowed;

// --- the pieces the law reads ---------------------------------------------

pub const OWNER_GATE_IF : str = "    if: inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n";
pub const OWNER_DEFAULT_NO : str = "default: 'no'}";
pub const FULL_HISTORY : str = "        with: {fetch-depth: 0}\n";
pub const MAC_RUNNER : str = "    runs-on: macos-14\n";
pub const ONE_AT_A_TIME : str = "concurrency: t27os-release\n";
pub const OWN_TOKEN : str = "        env: {GH_TOKEN: '${{ github.token }}'}\n";
pub const PLAN_CMD : str = "./target/release/tri t27os release --plan";
pub const PUBLISH_CMD : str = "./target/release/tri t27os publish --yes";
pub const INPUT_EXPANSION : str = "${{ inputs.";

// --- the workflow, as text for the generator --------------------------------

pub const RELEASE_WORKFLOW_YAML : str = "name: t27os-release\non:\n  workflow_dispatch:\n    inputs: {owner_yes: {description: 'type yes to publish; anything else stops before a build', default: 'no'}}\npermissions: {contents: write}\nconcurrency: t27os-release\njobs:\n  release:\n    if: inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n    runs-on: macos-14\n    timeout-minutes: 90\n    environment: t27os-release\n    steps:\n      - uses: actions/checkout@v4\n        with: {fetch-depth: 0}\n      - run: cargo build --release -p tri && ./target/release/tri t27os release --plan\n      - run: ./target/release/tri t27os publish --yes\n        env: {GH_TOKEN: '${{ github.token }}'}\n";

// --- the decision ---------------------------------------------------------

/// May the leg publish. dispatch: the run began from workflow_dispatch. owner_yes: the dispatcher typed
/// yes. on_master: the ref is master. A plan never publishes (release.publish_allowed).
pub fn leg_may_run(dispatch: bool, owner_yes: bool, on_master: bool) -> bool {
    if (dispatch == false or on_master == false) { return false; }
    return publish_allowed(false, owner_yes);
}

/// Only the owner's dispatch starts it: no schedule, push or pull_request trigger anywhere in the text.
pub fn trigger_only_dispatch(y: []const u8) -> bool {
    return contains(y, "workflow_dispatch:") and !contains(y, "schedule:") and !contains(y, "push:")
        and !contains(y, "pull_request");
}

/// The job is gated on the owner's yes and on master, and the input defaults to no.
pub fn owner_gate_ok(y: []const u8) -> bool {
    return contains(y, OWNER_GATE_IF) and contains(y, OWNER_DEFAULT_NO);
}

/// The whole history is fetched: the build number counts commits.
pub fn history_ok(y: []const u8) -> bool {
    return contains(y, FULL_HISTORY);
}

/// No input is expanded into a step: owner_yes is read in the job's if expression, which has no ${{ }}.
pub fn inputs_ok(y: []const u8) -> bool {
    return !contains(y, INPUT_EXPANSION);
}

/// Only the job's own token is used; no repository secret is named.
pub fn token_ok(y: []const u8) -> bool {
    return contains(y, OWN_TOKEN) and !contains(y, "secrets.");
}

/// One release at a time: a second dispatch waits for the first instead of racing it for the tag.
pub fn serial_ok(y: []const u8) -> bool {
    return contains(y, ONE_AT_A_TIME);
}

/// The plan is printed, the publish step holds --yes, both run on the macOS runner.
pub fn steps_ok(y: []const u8) -> bool {
    return contains(y, PLAN_CMD) and contains(y, PUBLISH_CMD) and contains(y, MAC_RUNNER);
}

/// The law, whole.
pub fn workflow_ok(y: []const u8) -> bool {
    return trigger_only_dispatch(y) and owner_gate_ok(y) and history_ok(y) and inputs_ok(y) and token_ok(y)
        and serial_ok(y) and steps_ok(y);
}

// --- tests ----------------------------------------------------------------

test the_workflow_text_is_the_law {
    assert workflow_ok(RELEASE_WORKFLOW_YAML);
    assert trigger_only_dispatch(RELEASE_WORKFLOW_YAML);
    assert owner_gate_ok(RELEASE_WORKFLOW_YAML);
    assert history_ok(RELEASE_WORKFLOW_YAML);
    assert inputs_ok(RELEASE_WORKFLOW_YAML);
    assert token_ok(RELEASE_WORKFLOW_YAML);
    assert serial_ok(RELEASE_WORKFLOW_YAML);
    assert steps_ok(RELEASE_WORKFLOW_YAML);
}

test only_the_owners_dispatch_on_master_publishes {
    assert leg_may_run(true, true, true) == true;
    // negative controls: each differs from the passing call by one argument
    assert leg_may_run(true, false, true) == false;
    assert leg_may_run(false, true, true) == false;
    assert leg_may_run(true, true, false) == false;
    // a plan never publishes, whatever was typed
    assert publish_allowed(true, true) == false;
}

test a_schedule_or_push_trigger_is_refused {
    assert trigger_only_dispatch("on:\n  workflow_dispatch:\n") == true;
    assert trigger_only_dispatch("on:\n  schedule:\n    - cron: '0 * * * *'\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  push:\n    branches: [master]\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  pull_request:\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  push:\n    branches: [master]\n") == false;
}

test the_owner_gate_cannot_be_dropped_or_defaulted_to_yes {
    assert owner_gate_ok("    if: github.event_name == 'workflow_dispatch'\n    inputs: {owner_yes: {default: 'no'}}\n") == false;
    assert owner_gate_ok(OWNER_GATE_IF) == false;
    assert owner_gate_ok(OWNER_DEFAULT_NO) == false;
    // the if is there but the master check is not
    assert owner_gate_ok("    if: inputs.owner_yes == 'yes'\n    inputs: {owner_yes: {default: 'no'}}\n") == false;
    assert owner_gate_ok("    if: inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n    inputs: {owner_yes: {default: 'yes'}}\n") == false;
    assert owner_gate_ok("    if: inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n    inputs: {owner_yes: {default: 'no'}}\n") == true;
}

test a_shallow_checkout_is_refused_because_the_build_number_would_be_one {
    assert history_ok("      - uses: actions/checkout@v4\n") == false;
    assert history_ok("        with: {fetch-depth: 1}\n") == false;
    assert history_ok("        with: {fetch-depth: 10}\n") == false;
    assert history_ok("        with: {fetch-depth: 0}\n") == true;
}

test no_input_is_expanded_into_a_step {
    assert inputs_ok("    if: inputs.owner_yes == 'yes'\n      - run: ./target/release/tri t27os publish --yes\n") == true;
    // negative controls: each expands the input into the shell
    assert inputs_ok("      - run: echo ${{ inputs.owner_yes }}\n") == false;
    assert inputs_ok("        run: |\n          REF=${{ inputs.owner_yes }}\n") == false;
    assert inputs_ok("        run: |\n          for r in ${{ inputs.owner_yes }}; do\n") == false;
    assert inputs_ok("        run: ${{ inputs.owner_yes }}\n") == false;
}

test only_the_jobs_own_token_is_used {
    assert token_ok("        env: {GH_TOKEN: '${{ github.token }}'}\n") == true;
    assert token_ok("        env: {GH_TOKEN: '${{ secrets.RELEASE_PAT }}'}\n") == false;
    assert token_ok("        env: {GH_TOKEN: '${{ github.token }}'}\n        env: {X: '${{ secrets.OTHER }}'}\n") == false;
}

test a_second_dispatch_waits_for_the_first {
    assert serial_ok("concurrency: t27os-release\njobs:\n") == true;
    assert serial_ok("jobs:\n  release:\n") == false;
}

test the_plan_is_printed_and_the_publish_step_runs_on_the_mac_runner {
    assert steps_ok(RELEASE_WORKFLOW_YAML) == true;
    // negative controls: no plan; a runner that is not the Mac's; no publish step
    assert steps_ok("    runs-on: macos-14\n./target/release/tri t27os publish --yes\n") == false;
    assert steps_ok("    runs-on: ubuntu-latest\n./target/release/tri t27os release --plan\n./target/release/tri t27os publish --yes\n") == false;
    assert steps_ok("    runs-on: macos-14\n./target/release/tri t27os release --plan\n") == false;
}
