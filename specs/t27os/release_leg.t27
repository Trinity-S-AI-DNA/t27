// SPDX-License-Identifier: Apache-2.0
// specs/t27os/release_leg.t27 -- the lab leg that builds and publishes a T27 OS release (issue #12479,
// epic #11037). The card is specs/crons/t27-t27os-release.t27; this file is its law and its text.
//
// Why a leg and not the Mac: `tri t27os publish --yes` (release.t27 :: publish_text) runs
// `cargo build --release -p t27c -p tri -p t27b` and `make t27os`, and the Mac refuses heavy builds
// (mac-no-heavy.py, owner 2026-10-09). The macOS runner the t27os.yml gate already builds the app on
// (macos-14, arm64) is the lab host that is not the Mac, so the release is cut there.
//
// The law, here:
//   - the leg starts only from workflow_dispatch; it has no schedule, push or pull_request trigger;
//   - it publishes only when the dispatcher typed `yes` in the owner_yes input (default `no`), which
//     is the workflow's reading of the owner's --yes: publish_allowed(plan_only = false, owner_yes);
//   - it runs on master only, and the commit it builds is an ancestor of origin/master;
//   - it checks out the whole history, because the build number is `git rev-list --count HEAD` and a
//     shallow clone would publish build 1 under a fresh tag;
//   - the sha input reaches bash as REQ_SHA through env, never by expansion (lab_inputs.t27, #11950);
//   - it uses the job's own token (github.token, contents: write) and names no secret: releases live in
//     this repository (github.com/gHashTag/t27 redirects here), so no cross-repository token is needed;
//   - the plan is printed before the publish step, and the publish step is the only one holding --yes.
// The workflow below is the text the generator writes to .github/workflows/t27os-release.yml byte for
// byte. That file is a foreign file: it needs the owner's `owner-approved-foreign` label on its PR, and
// gate-topology counts it as a new unclassified workflow. Until it lands the card is ENABLED = false.
// Nothing here runs a build or publishes. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osReleaseLeg;

use t27os::keysync::contains;
use t27os::release::publish_allowed;
use t27os::lab_inputs::SHA_ENV;
use t27os::lab_inputs::LOOP_EXPANSION;
use t27os::lab_inputs::ASSIGN_EXPANSION;

// --- the pieces the law reads ---------------------------------------------

pub const OWNER_GATE_IF : str = "    if: github.event_name == 'workflow_dispatch' && inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n";
pub const OWNER_DEFAULT_NO : str = "        default: 'no'\n";
pub const FULL_HISTORY : str = "          fetch-depth: 0\n";
pub const MAC_RUNNER : str = "    runs-on: macos-14\n";
pub const OWN_TOKEN : str = "          GH_TOKEN: ${{ github.token }}\n";
pub const PLAN_CMD : str = "./target/release/tri t27os release --plan";
pub const PUBLISH_CMD : str = "./target/release/tri t27os publish --yes";
pub const ANCESTOR_CHECK : str = "git merge-base --is-ancestor HEAD origin/master";

// --- the workflow, as text for the generator --------------------------------

pub const RELEASE_WORKFLOW_YAML : str = "name: t27os-release\non:\n  workflow_dispatch:\n    inputs:\n      sha:\n        description: 'master sha to release; empty = the current master'\n        required: false\n        default: ''\n      owner_yes:\n        description: 'the owner types yes to publish; anything else stops before any build'\n        required: false\n        default: 'no'\npermissions:\n  contents: write\nconcurrency:\n  group: t27os-release\n  cancel-in-progress: false\njobs:\n  release:\n    if: github.event_name == 'workflow_dispatch' && inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n    runs-on: macos-14\n    timeout-minutes: 90\n    environment: t27os-release\n    steps:\n      - name: check out the whole history (the build number counts commits)\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - name: pin the commit and refuse anything that is not on master\n        shell: bash\n        env:\n          REQ_SHA: ${{ inputs.sha }}\n        run: |\n          REF=\"$REQ_SHA\"\n          [ -z \"$REF\" ] && REF=origin/master\n          case \"$REF\" in *[!0-9A-Za-z._/-]*) echo \"refused ref\"; exit 1;; esac\n          git checkout --detach \"$REF\"\n          git merge-base --is-ancestor HEAD origin/master || { echo \"not on master\"; exit 1; }\n      - name: build tri and print the plan (runs nothing)\n        shell: bash\n        run: |\n          cargo build --release -p tri\n          ./target/release/tri t27os release --plan\n      - name: publish (tri t27os publish builds, zips, checks, signs and releases)\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: ./target/release/tri t27os publish --yes\n";

// --- the decision ---------------------------------------------------------

/// May the leg publish. dispatch: the run began from workflow_dispatch. owner_yes: the dispatcher typed
/// yes. on_master: the ref is master. A plan never publishes (release.publish_allowed).
pub fn leg_may_run(dispatch: bool, owner_yes: bool, on_master: bool) -> bool {
    if (dispatch == false or on_master == false) { return false; }
    return publish_allowed(false, owner_yes);
}

/// Only the owner's dispatch starts it: no schedule, push or pull_request trigger anywhere in the text.
pub fn trigger_only_dispatch(y: []const u8) -> bool {
    return contains(y, "workflow_dispatch:") and !contains(y, "schedule:") and !contains(y, "push:")
        and !contains(y, "pull_request");
}

/// The job is gated on the owner's yes and on master, and the input defaults to no.
pub fn owner_gate_ok(y: []const u8) -> bool {
    return contains(y, OWNER_GATE_IF) and contains(y, OWNER_DEFAULT_NO);
}

/// The whole history is fetched: the build number counts commits.
pub fn history_ok(y: []const u8) -> bool {
    return contains(y, FULL_HISTORY);
}

/// The sha input reaches bash through env; no input is expanded as a loop list, an assignment or a run body.
pub fn inputs_ok(y: []const u8) -> bool {
    return contains(y, SHA_ENV) and !contains(y, LOOP_EXPANSION) and !contains(y, ASSIGN_EXPANSION)
        and !contains(y, "run: ${{ inputs.");
}

/// Only the job's own token is used; no repository secret is named.
pub fn token_ok(y: []const u8) -> bool {
    return contains(y, OWN_TOKEN) and !contains(y, "secrets.");
}

/// The plan is printed, the publish step holds --yes, the commit is checked against master.
pub fn steps_ok(y: []const u8) -> bool {
    return contains(y, PLAN_CMD) and contains(y, PUBLISH_CMD) and contains(y, ANCESTOR_CHECK) and contains(y, MAC_RUNNER);
}

/// The law, whole.
pub fn workflow_ok(y: []const u8) -> bool {
    return trigger_only_dispatch(y) and owner_gate_ok(y) and history_ok(y) and inputs_ok(y) and token_ok(y)
        and steps_ok(y);
}

// --- tests ----------------------------------------------------------------

test the_workflow_text_is_the_law {
    assert workflow_ok(RELEASE_WORKFLOW_YAML);
    assert trigger_only_dispatch(RELEASE_WORKFLOW_YAML);
    assert owner_gate_ok(RELEASE_WORKFLOW_YAML);
    assert history_ok(RELEASE_WORKFLOW_YAML);
    assert inputs_ok(RELEASE_WORKFLOW_YAML);
    assert token_ok(RELEASE_WORKFLOW_YAML);
    assert steps_ok(RELEASE_WORKFLOW_YAML);
}

test only_the_owners_dispatch_on_master_publishes {
    assert leg_may_run(true, true, true) == true;
    // negative controls: each differs from the passing call by one argument
    assert leg_may_run(true, false, true) == false;
    assert leg_may_run(false, true, true) == false;
    assert leg_may_run(true, true, false) == false;
    // a plan never publishes, whatever was typed
    assert publish_allowed(true, true) == false;
}

test a_schedule_or_push_trigger_is_refused {
    assert trigger_only_dispatch("on:\n  workflow_dispatch:\n") == true;
    assert trigger_only_dispatch("on:\n  schedule:\n    - cron: '0 * * * *'\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  push:\n    branches: [master]\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  pull_request:\n  workflow_dispatch:\n") == false;
    assert trigger_only_dispatch("on:\n  push:\n    branches: [master]\n") == false;
}

test the_owner_gate_cannot_be_dropped_or_defaulted_to_yes {
    assert owner_gate_ok("    if: github.event_name == 'workflow_dispatch'\n        default: 'no'\n") == false;
    assert owner_gate_ok(OWNER_GATE_IF) == false;
    assert owner_gate_ok(OWNER_DEFAULT_NO) == false;
    assert owner_gate_ok("    if: github.event_name == 'workflow_dispatch' && inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n        default: 'yes'\n") == false;
    assert owner_gate_ok("    if: github.event_name == 'workflow_dispatch' && inputs.owner_yes == 'yes' && github.ref == 'refs/heads/master'\n        default: 'no'\n") == true;
}

test a_shallow_checkout_is_refused_because_the_build_number_would_be_one {
    assert history_ok("      - uses: actions/checkout@v4\n") == false;
    assert history_ok("        with:\n          fetch-depth: 1\n") == false;
    assert history_ok("        with:\n          fetch-depth: 0\n") == true;
}

test the_sha_input_reaches_bash_through_env_only {
    assert inputs_ok("        env:\n          REQ_SHA: ${{ inputs.sha }}\n        run: |\n          REF=\"$REQ_SHA\"\n") == true;
    // negative controls: the env is set but the body still expands the input
    assert inputs_ok("        env:\n          REQ_SHA: ${{ inputs.sha }}\n        run: |\n          REF=${{ inputs.sha }}\n") == false;
    assert inputs_ok("        env:\n          REQ_SHA: ${{ inputs.sha }}\n        run: |\n          for r in ${{ inputs.sha }}; do\n") == false;
    assert inputs_ok("        run: ${{ inputs.sha }}\n") == false;
    // the body reads a variable the env never sets
    assert inputs_ok("        env:\n          OTHER: x\n        run: |\n          REF=\"$REQ_SHA\"\n") == false;
}

test only_the_jobs_own_token_is_used {
    assert token_ok("        env:\n          GH_TOKEN: ${{ github.token }}\n") == true;
    assert token_ok("        env:\n          GH_TOKEN: ${{ secrets.RELEASE_PAT }}\n") == false;
    assert token_ok("          GH_TOKEN: ${{ github.token }}\n          X: ${{ secrets.OTHER }}\n") == false;
}

test the_publish_step_is_after_a_printed_plan_and_a_master_check {
    assert steps_ok(RELEASE_WORKFLOW_YAML) == true;
    assert steps_ok("    runs-on: macos-14\n./target/release/tri t27os publish --yes\n") == false;
    assert steps_ok("    runs-on: ubuntu-latest\n./target/release/tri t27os release --plan\n./target/release/tri t27os publish --yes\ngit merge-base --is-ancestor HEAD origin/master\n") == false;
}
