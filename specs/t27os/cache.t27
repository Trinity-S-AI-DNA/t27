// specs/t27os/cache.t27 -- reuse a stored result while its key matches.
// A zero key is unknown, not a hit. This module stores nothing.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::cache {

    pub fn cache_hit(stored: u32, now: u32) -> bool {
        if (stored == 0) { return false; }
        return stored == now;
    }

    test "the same key hits and a zero key does not" {
        assert(cache_hit(7, 7));
        assert(!cache_hit(7, 8));
        assert(!cache_hit(0, 0));
    }

    invariant a_changed_key_misses {
        assert cache_hit(1, 2) == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
