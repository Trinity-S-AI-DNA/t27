// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_rc8_credentials.t27 -- DSH rc.8 credentials: reader/rotator
// contract.
// Part of M8 milestone (milestone #12). Closes #13079.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_rc8_credentials;

pub const DSH_RC8_CREDENTIALS_MAX_ROTATIONS : u32 = 10;

pub struct Rc8Credentials { reader: bool, rotator: bool };

pub fn rc8_credentials_reader(c: Rc8Credentials) -> bool {
    return c.reader;
}

pub fn rc8_credentials_rotator(c: Rc8Credentials) -> bool {
    return c.rotator;
}

test "rc8_credentials_reader" {
    assert(rc8_credentials_reader(Rc8Credentials { reader: true, rotator: false }));
    assert(!rc8_credentials_reader(Rc8Credentials { reader: false, rotator: true }));
}

test "rc8_credentials_rotator" {
    assert(rc8_credentials_rotator(Rc8Credentials { reader: false, rotator: true }));
    assert(!rc8_credentials_rotator(Rc8Credentials { reader: true, rotator: false }));
}

invariant dsh_rc8_credentials_max_rotations_positive {
    assert DSH_RC8_CREDENTIALS_MAX_ROTATIONS > 0;
}