// SPDX-License-Identifier: Apache-2.0
// specs/t27os/still_frames.t27 -- t27os window: T27OS_STILL frames are not
// still - live pane content reaches the frame.
// Part of M7 milestone (milestone #11). Closes #14008.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::still_frames;

pub const STILL_FRAMES_MAX_PANES : u32 = 16;

pub struct StillFrame { pane_id: str, still: bool };

pub fn still_frame_still(f: StillFrame) -> bool {
    return f.still;
}

test "still_frame_still" {
    assert(still_frame_still(StillFrame { pane_id: "pane-0", still: true }));
    assert(!still_frame_still(StillFrame { pane_id: "pane-1", still: false }));
}

invariant still_frames_max_panes_positive {
    assert STILL_FRAMES_MAX_PANES > 0;
}