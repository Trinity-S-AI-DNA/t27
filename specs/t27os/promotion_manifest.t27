// SPDX-License-Identifier: Apache-2.0
; specs/t27os/promotion_manifest.t27 -- the promotion manifest (#14220)
; Release t27os-ladder-512k-caps pinned the commit and the binary sha256 in
; SHA256SUMS, but the caps, the build environment and the build command
; survived only as prose in the release body (FR-001 gap: no manifest asset
; exists on that release). FR-002 of #14220: the manifest is generated from
; this spec, never hand-written twice -- the key list below is the schema,
; the generated module (gen/rust/t27os/promotion_manifest.rs) carries it, and
; the thin glue (`tri promo manifest`) renders JSON from that list alone.
; A rebuild verifier reads the manifest and compares binary_sha256 against a
; local rebuild at the pinned commit (FR-003).

module T27osPromotionManifest;

pub const FILE_NAME : str = "promotion-manifest.json";
pub const SCHEMA_VERSION : str = "1";
pub const KEY_COUNT : usize = 8;
; The keys, in output order. A key named here is a key in the file; the glue
; adds none and renames none.
pub const KEYS : [8]str = ["schema_version", "commit", "binary", "binary_sha256", "caps", "environment", "toolchain", "build_command"];
; The caps section names the ladder constants it pins, by their SSOT names:
; ld_pb_cap and ld_pipe_chunk are specs/t27os/ladder_serve.t27 constants (the
; 512 of the release tag), rung_count and probe_tokens are specs/t27os/ladder.t27
; constants. Values are read from those specs at generation time, never
; restated here.
pub const CAPS_KEYS : [4]str = ["ld_pb_cap", "ld_pipe_chunk", "rung_count", "probe_tokens"];

; Exact string equality, the only comparison the schema checks need.
pub fn same_key(a : str, b : str) -> bool {
    if (a.len != b.len) { return false; }
    var j : usize = 0;
    while (j < a.len) {
        if (a[j] != b[j]) { return false; }
        j = j + 1;
    }
    return true;
}

; One hex digit of a sha256: 1 when c is 0-9 or a-f, 0 otherwise.
pub fn hex_digit_ok(c : u8) -> u32 {
    if (c >= '0') {
        if (c <= '9') { return 1; }
    }
    if (c >= 'a') {
        if (c <= 'f') { return 1; }
    }
    return 0;
}

; How many of the 64 characters of s are hex digits; 0 unless s holds 64
; characters. A published binary_sha256 ranks 64.
pub fn sha256_hex_rank(s : str) -> u32 {
    var good : u32 = 0;
    if (s.len == 64) {
        var i : usize = 0;
        while (i < s.len) {
            let one : u32 = hex_digit_ok(s[i]);
            good = good + one;
            i = i + 1;
        }
    }
    return good;
}

test schema_version_is_one {
    assert SCHEMA_VERSION.len == 1;
    assert same_key(SCHEMA_VERSION, "1");
}

test file_name_is_fixed {
    assert same_key(FILE_NAME, "promotion-manifest.json");
    assert FILE_NAME.len == 23;
    assert FILE_NAME[18] == '.';
    assert FILE_NAME[19] == 'j';
}

test keys_are_named_in_output_order {
    assert KEYS.len == KEY_COUNT;
    assert KEY_COUNT == 8;
    assert same_key(KEYS[0], "schema_version");
    assert same_key(KEYS[1], "commit");
    assert same_key(KEYS[2], "binary");
    assert same_key(KEYS[3], "binary_sha256");
    assert same_key(KEYS[4], "caps");
    assert same_key(KEYS[5], "environment");
    assert same_key(KEYS[6], "toolchain");
    assert same_key(KEYS[7], "build_command");
}

test keys_are_unique {
    var dups : u32 = 0;
    var i : usize = 0;
    while (i < KEY_COUNT) {
        var j : usize = i + 1;
        while (j < KEY_COUNT) {
            let dup : bool = same_key(KEYS[i], KEYS[j]);
            if (dup) { dups = dups + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert dups == 0;
}

test caps_name_the_ladder_ssot_constants {
    assert CAPS_KEYS.len == 4;
    var found : u32 = 0;
    var k : usize = 0;
    while (k < CAPS_KEYS.len) {
        let a : bool = same_key(CAPS_KEYS[k], "ld_pb_cap");
        let b : bool = same_key(CAPS_KEYS[k], "ld_pipe_chunk");
        let c : bool = same_key(CAPS_KEYS[k], "rung_count");
        let d : bool = same_key(CAPS_KEYS[k], "probe_tokens");
        if (a) { found = found + 1; }
        if (b) { found = found + 1; }
        if (c) { found = found + 1; }
        if (d) { found = found + 1; }
        k = k + 1;
    }
    assert found == 4;
}

test sha256_field_ranks_sixtyfour_hex_digits {
    let full : str = "905266dbb73b111122223333444455556666777788889999aaaabbbbccccdddd";
    assert full.len == 64;
    assert sha256_hex_rank(full) == 64;
    let truncated : str = "905266dbb73b";
    assert sha256_hex_rank(truncated) == 0;
    let non_hex : str = "905266dbb73b111122223333444455556666777788889999aaaabbbbccccdddZ";
    assert non_hex.len == 64;
    assert sha256_hex_rank(non_hex) == 63;
}

test same_key_rejects_case_and_prefix_games {
    assert same_key("caps", "caps");
    assert same_key("caps", "CAPS") == false;
    assert same_key("caps", "ca") == false;
    assert same_key("", "");
}
