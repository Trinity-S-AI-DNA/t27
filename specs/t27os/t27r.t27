/// Room for the seed corpus, and for lines tests add to it.
pub const TR_BUF : usize = 12288;

/// Append a line and byte 10 at `at`; returns the position after them.
pub fn tr_add(out: []u8, at: usize, line: []const u8) -> usize {
    const o : usize = put_bytes(out, at, line);
    out[o] = 10;
    return o + 1;
}

/// Write the 32 seed lines into out (at least TR_BUF bytes); returns the length, 0 when out is too small.
pub fn tr_seed(out: []u8) -> usize {
    if (out.len < TR_BUF) { return 0; }
    var o : usize = tr_add(out, 0, TR_L01);
    o = tr_add(out, o, TR_L02);
    o = tr_add(out, o, TR_L03);
    o = tr_add(out, o, TR_L04);
    o = tr_add(out, o, TR_L05);
    o = tr_add(out, o, TR_L06);
    o = tr_add(out, o, TR_L07);
    o = tr_add(out, o, TR_L08);
    o = tr_add(out, o, TR_L09);
    o = tr_add(out, o, TR_L10);
    o = tr_add(out, o, TR_L11);
    o = tr_add(out, o, TR_L12);
    o = tr_add(out, o, TR_L13);
    o = tr_add(out, o, TR_L14);
    o = tr_add(out, o, TR_L15);
    o = tr_add(out, o, TR_L16);
    o = tr_add(out, o, TR_L17);
    o = tr_add(out, o, TR_L18);
    o = tr_add(out, o, TR_L19);
    o = tr_add(out, o, TR_L20);
    o = tr_add(out, o, TR_L21);
    o = tr_add(out, o, TR_L22);
    o = tr_add(out, o, TR_L23);
    o = tr_add(out, o, TR_L24);
    o = tr_add(out, o, TR_L25);
    o = tr_add(out, o, TR_L26);
    o = tr_add(out, o, TR_L27);
    o = tr_add(out, o, TR_L28);
    o = tr_add(out, o, TR_L29);
    o = tr_add(out, o, TR_L30);
    o = tr_add(out, o, TR_L31);
    o = tr_add(out, o, TR_L32);
    return o;
}

; --- 15. Tests ---

pub const TR_T_URL : str = "https://www.designtokens.org/tr/drafts/format/";
pub const TR_T_URL_TAIL : str = "|web|metadata|-|Design Tokens Format Module 2025.10|Louis Chenais, Kathleen McMahon|W3C Community Group|https://www.designtokens.org/tr/drafts/format/|tokens";
pub const TR_T_N_OK : str = "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|A claim";

test research_seed_passes_and_counts {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert sn > 0;
    assert tr_check_corpus(sd[0..sn]) == TR_E_OK;
    assert tr_first_bad(sd[0..sn]) == 32;
    assert tr_count_lines(sd[0..sn]) == 32;
    assert tr_count_kind(sd[0..sn], TR_K_T) == 3;
    assert tr_count_kind(sd[0..sn], TR_K_S) == 10;
    assert tr_count_kind(sd[0..sn], TR_K_G) == 1;
    assert tr_count_kind(sd[0..sn], TR_K_N) == 13;
    assert tr_count_kind(sd[0..sn], TR_K_Y) == 3;
    assert tr_count_kind(sd[0..sn], TR_K_D) == 2;
    assert tr_count_latest(sd[0..sn], TR_K_N) == 12;
    assert tr_count_latest(sd[0..sn], TR_K_Y) == 2;
    assert tr_count_latest(sd[0..sn], TR_K_S) == 10;
    assert tr_y_next(sd[0..sn], "y1") == 3;
    assert tr_y_next(sd[0..sn], "y2") == 2;
    assert tr_y_next(sd[0..sn], "y9") == 1;
    assert tr_next_ver(sd[0..sn], TR_K_N, "n3") == 3;
}

test research_fields_and_lines {
    assert tr_nfields("a|b|c") == 3;
    assert tr_nfields("abc") == 1;
    assert bytes_eq(tr_field("N|n1|v1", 1), "n1");
    assert bytes_eq(tr_field("N|n1|v1", 2), "v1");
    assert tr_field("N|n1|v1", 5).len == 0;
    assert tr_csv_count("n1,n2,n4") == 3;
    assert tr_csv_count("") == 0;
    assert bytes_eq(tr_csv_item("n1,n2,n4", 2), "n4");
    assert tr_csv_has("n1,n2", "n2");
    assert !tr_csv_has("n1,n22", "n2");
    assert tr_words("one two  three") == 3;
    assert tr_date_ok("2026-11-08");
    assert !tr_date_ok("2026-13-01");
    assert !tr_date_ok("2026/11/08");
    assert tr_year_ok("-");
    assert tr_year_ok("2019");
    assert !tr_year_ok("3019");
    assert !tr_year_ok("20x6");
    assert tr_has_fold("The GitLab wiki", "GITLAB");
    assert !tr_has_fold("short", "much longer needle");
}

test research_hex_and_url_ids {
    var hx : [16]u8 = undefined;
    const w : usize = tr_put_hex(hx[0..16], 0, 255);
    assert w == 16;
    assert bytes_eq(hx[0..16], "00000000000000ff");
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    var ln : [500]u8 = undefined;
    var o : usize = put_bytes(ln[0..500], 0, "S|url:");
    o = tr_put_hex(ln[0..500], o, ar_fingerprint(TR_T_URL));
    o = put_bytes(ln[0..500], o, TR_T_URL_TAIL);
    assert tr_check_line(sd[0..sn], sn, ln[0..o]) == TR_E_OK;
    var bad : [500]u8 = undefined;
    var q : usize = put_bytes(bad[0..500], 0, "S|url:0000000000000000");
    q = put_bytes(bad[0..500], q, TR_T_URL_TAIL);
    assert tr_check_line(sd[0..sn], sn, bad[0..q]) == TR_E_ID;
}

test research_source_negative_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, TR_L04) == TR_E_IMMUTABLE;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|blog|verified|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_TYPE;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|maybe|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_STATUS;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|20x0|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_YEAR;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020|A title|An author|A venue|http://doi.org/10.5555/12345678|x") == TR_E_TEXT;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020|A title|An author|A venue|https://doi.org/10.5555/other|x") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "S|ftp:1234567|paper|verified|2020|A title|An author|A venue|https://doi.org/10.5555/other|x") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020||An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_TEXT;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|API_KEY=abc123") == TR_E_SECRET;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|verified|2020|A title|An author") == TR_E_FIELDS;
    assert tr_check_line(sd[0..sn], sn, "S|rfc:8693|standard|verified|2020|OAuth 2.0 Token Exchange|Jones et al.|RFC 8693|https://www.rfc-editor.org/rfc/rfc8693.html|oauth") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "Q|a|b") == TR_E_KIND;
    assert tr_check_line(sd[0..sn], sn, "x") == TR_E_KIND;
}

test research_topic_and_tag_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, "T|t-new-topic|A question|A scope") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "T|t-research-kb|A question|A scope") == TR_E_DUP;
    assert tr_check_line(sd[0..sn], sn, "T|T-Bad|A question|A scope") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "T|t-|A question|A scope") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "T|t-new-topic|A question") == TR_E_FIELDS;
    assert tr_check_line(sd[0..sn], sn, "T|t-new-topic||A scope") == TR_E_TEXT;
    assert tr_check_line(sd[0..sn], sn, "G|rfc:9106|kdf-default") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "G|rfc:0000|kdf-default") == TR_E_NO_SOURCE;
    assert tr_check_line(sd[0..sn], sn, "G|rfc:9106|Bad Tag") == TR_E_ID;
}

test research_note_negative_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, TR_T_N_OK) == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|pmc:PMC13732382|t-research-kb|high|sec 3.1|A claim") == TR_E_UNVERIFIED;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.0000/none|t-research-kb|high|sec 3.1|A claim") == TR_E_NO_SOURCE;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-nope|high|sec 3.1|A claim") == TR_E_TOPIC;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|certain|sec 3.1|A claim") == TR_E_CONFIDENCE;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|p.3, p.4|A claim") == TR_E_LOCATOR;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|page 3|A claim") == TR_E_LOCATOR;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1; sec 3.2|A claim") == TR_E_LOCATOR;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|p.3|A claim") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|q:one two three|A claim") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|API_KEY=abc123") == TR_E_SECRET;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|All papers agree on this") == TR_E_BULK;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|Process all of them") == TR_E_BULK;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|") == TR_E_TEXT;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-13-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|A claim") == TR_E_DATE;
    assert tr_check_line(sd[0..sn], sn, "N|n20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1") == TR_E_FIELDS;
    assert tr_check_line(sd[0..sn], sn, "N|x20|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|A claim") == TR_E_ID;
}

test research_provenance_line_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|90|literature") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|arxiv:2501.06706|2026-11-08|human:dmitrii|verified|q:holistic framework|100|aiops") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|pmc:PMC13732382|2026-11-08|agent:t27r|unverified||0|c5-dm") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|rfc:9106|2026-11-08|agent:t27r|disputed|sec 3|40|kdf") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|hash:0123abcd|2026-11-08|agent:t27r|disputed||40|") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|https://example.org/paper|2026-11-08|agent:t27r|unverified||10|x") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified||90|literature") == TR_E_LOCATOR;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|page 3|90|literature") == TR_E_LOCATOR;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-13-08|agent:t27r|verified|sec 2.1|90|literature") == TR_E_DATE;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-8|agent:t27r|verified|sec 2.1|90|literature") == TR_E_DATE;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|t27r|verified|sec 2.1|90|literature") == TR_E_VERIFIER;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:|verified|sec 2.1|90|literature") == TR_E_VERIFIER;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|bot:t27r|verified|sec 2.1|90|literature") == TR_E_VERIFIER;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|101|literature") == TR_E_CONFIDENCE;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|-1|literature") == TR_E_CONFIDENCE;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|high|literature") == TR_E_CONFIDENCE;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|0|literature") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|maybe|sec 2.1|90|literature") == TR_E_STATUS;
    assert tr_check_line(sd[0..sn], sn, "P|ftp:12345|2026-11-08|agent:t27r|verified|sec 2.1|90|literature") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "P||2026-11-08|agent:t27r|verified|sec 2.1|90|literature") == TR_E_ID;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|90") == TR_E_FIELDS;
    assert tr_check_line(sd[0..sn], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|90|API_KEY=abc123") == TR_E_SECRET;
}

test research_provenance_fact_rule {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    const s1 : usize = tr_add(sd[0..12288], sn, "S|doi:10.5555/12345678|paper|disputed|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x");
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|disputed|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "S|doi:10.5555/12345678|paper|doubtful|2020|A title|An author|A venue|https://doi.org/10.5555/12345678|x") == TR_E_STATUS;
    assert tr_check_corpus(sd[0..s1]) == TR_E_OK;
    assert tr_coverage_pm(sd[0..s1]) == 1000;
    const s2 : usize = tr_add(sd[0..12288], s1, "N|n90|v1|2026-11-08|doi:10.5555/12345678|t-research-kb|low|sec 1|A disputed claim");
    assert tr_coverage_pm(sd[0..s2]) == 923;
    assert tr_check_line(sd[0..s1], s1, "N|n91|v1|2026-11-08|doi:10.5555/12345678|t-research-kb|low|sec 1|A claim") == TR_E_DISPUTED;
    assert tr_source_state(sd[0..s1], "doi:10.5555/12345678") == TR_E_DISPUTED;
    assert tr_fact_state(sd[0..s1], "doi:10.5555/12345678") == TR_E_DISPUTED;
    assert tr_cite_state(sd[0..s1], "doi:10.5555/12345678", true) == TR_E_DISPUTED;
    assert tr_cite_state(sd[0..s1], "doi:10.5555/12345678", false) == TR_E_OK;
    assert tr_fact_state(sd[0..sn], "doi:10.1145/3786149.3788301") == TR_E_UNVERIFIED;
    const p1 : usize = tr_add(sd[0..12288], sn, "P|doi:10.1145/3786149.3788301|2026-11-08|agent:t27r|verified|sec 2.1|90|literature");
    assert tr_fact_state(sd[0..p1], "doi:10.1145/3786149.3788301") == TR_E_OK;
    assert tr_cite_state(sd[0..p1], "doi:10.1145/3786149.3788301", true) == TR_E_OK;
    const p2 : usize = tr_add(sd[0..12288], p1, "P|doi:10.1145/3786149.3788301|2026-11-09|human:dmitrii|disputed|sec 2.1|30|literature");
    assert tr_fact_state(sd[0..p2], "doi:10.1145/3786149.3788301") == TR_E_DISPUTED;
    const p3 : usize = tr_add(sd[0..12288], sn, "P|arxiv:2501.06706|2026-11-08|agent:t27r|unverified||20|aiops");
    assert tr_fact_state(sd[0..p3], "arxiv:2501.06706") == TR_E_UNVERIFIED;
    assert tr_cite_state(sd[0..p3], "arxiv:2501.06706", false) == TR_E_OK;
    const p4 : usize = tr_add(sd[0..12288], sn, "P|pmc:PMC13732382|2026-11-08|agent:t27r|verified|sec 1|95|c5-dm");
    assert tr_fact_state(sd[0..p4], "pmc:PMC13732382") == TR_E_UNVERIFIED;
    assert tr_fact_state(sd[0..sn], "pmc:PMC13732382") == TR_E_UNVERIFIED;
    assert tr_cite_state(sd[0..sn], "pmc:PMC13732382", false) == TR_E_OK;
    assert tr_fact_state(sd[0..sn], "doi:10.0000/none") == TR_E_NO_SOURCE;
    assert tr_cite_state(sd[0..sn], "doi:10.0000/none", false) == TR_E_NO_SOURCE;
    assert tr_fact_state(sd[0..sn], "doi:10.1007/s00607-010-0107-y") == TR_E_UNVERIFIED;
}

test research_note_versions {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, "N|n3|v3|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 2.4.1|A third version") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "N|n3|v5|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 2.4.1|A skipped version") == TR_E_VERSION;
    assert tr_check_line(sd[0..sn], sn, "N|n1|v1|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|A repeated first version") == TR_E_VERSION;
    assert tr_check_line(sd[0..sn], sn, "N|n21|v2|2026-11-08|doi:10.1145/3786149.3788301|t-research-kb|high|sec 3.1|A revision of nothing") == TR_E_VERSION;
    assert tr_check_line(sd[0..sn], sn, "N|n3|v3|2026-11-08|gh:EurFelux/paper-manager|t-research-kb|high|sec 2.4.1|A revision with another source") == TR_E_IMMUTABLE;
}

test research_synthesis_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "Y|y1|v3|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, "Y|y1|v4|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_VERSION;
    assert tr_check_line(sd[0..sn], sn, "Y|y1|v3|2026-11-08|t-breach-check|review|n10,n11|Agree|Disagree|Gaps|Limits") == TR_E_IMMUTABLE;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1|Agree|Disagree|Gaps|Limits") == TR_E_NOTE;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n99|Agree|Disagree|Gaps|Limits") == TR_E_NOTE;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-resource-doctor|review|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_NOTE;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|-|Limits") == TR_E_SECTIONS;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n2|Agree||Gaps|Limits") == TR_E_SECTIONS;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|essay|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_TYPE;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-nope|review|n1,n2|Agree|Disagree|Gaps|Limits") == TR_E_TOPIC;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|Gaps|API_KEY=abc123") == TR_E_SECRET;
    assert tr_check_line(sd[0..sn], sn, "Y|y3|v1|2026-11-08|t-research-kb|review|n1,n2|Agree|Disagree|Gaps") == TR_E_FIELDS;
}

test research_decision_controls {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|-|Prefix leakage is real|Remove the breach check") == TR_E_OK;
    assert tr_check_line(sd[0..sn], sn, TR_L31) == TR_E_DUP;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|pmc:PMC13732382|-|Prefix leakage is real|Remove the breach check") == TR_E_UNVERIFIED;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|doi:10.0000/none|-|Prefix leakage is real|Remove the breach check") == TR_E_NO_SOURCE;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only||-|Prefix leakage is real|Remove the breach check") == TR_E_NO_SOURCE;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|y9|Prefix leakage is real|Remove the breach check") == TR_E_SYNTH;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|y2|Prefix leakage is real|Remove the breach check") == TR_E_SYNTH;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|-||Remove the breach check") == TR_E_RATIONALE;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|-|Prefix leakage is real|-") == TR_E_ROLLBACK;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|-|Prefix leakage is real|") == TR_E_ROLLBACK;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-31x|t-breach-check|Use padded range queries only|arxiv:1905.13737|-|Prefix leakage is real|Remove the breach check") == TR_E_DATE;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-nope|Use padded range queries only|arxiv:1905.13737|-|Prefix leakage is real|Remove the breach check") == TR_E_TOPIC;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Process all papers at once|arxiv:1905.13737|-|Prefix leakage is real|Remove the breach check") == TR_E_BULK;
    assert tr_check_line(sd[0..sn], sn, "D|d3|2026-11-08|t-breach-check|Use padded range queries only|arxiv:1905.13737|-|API_KEY=abc123|Remove the breach check") == TR_E_SECRET;
}

test research_first_bad_line {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    const sn2 : usize = tr_add(sd[0..12288], sn, "N|n20|v1|2026-11-08|pmc:PMC13732382|t-research-kb|high|sec 3.1|A claim");
    assert tr_first_bad(sd[0..sn2]) == 32;
    assert tr_check_corpus(sd[0..sn2]) == TR_E_UNVERIFIED;
    const sn3 : usize = tr_add(sd[0..12288], sn, TR_T_N_OK);
    assert tr_check_corpus(sd[0..sn3]) == TR_E_OK;
    assert tr_first_bad(sd[0..sn3]) == 33;
}

test research_search_facets_coverage {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    assert tr_search(sd[0..sn], "gitlab") == 3;
    assert tr_search(sd[0..sn], "GITLAB") == 3;
    assert tr_search(sd[0..sn], "faiss") == 1;
    assert tr_search(sd[0..sn], "vector") == 3;
    assert tr_search(sd[0..sn], "zzzzzz") == 0;
    assert tr_search(sd[0..sn], "a") == 0;
    assert tr_search(sd[0..sn], "all papers") == 0;
    assert tr_search(sd[0..sn], "API_KEY=abc123") == 0;
    assert tr_facet(sd[0..sn], TR_F_TOPIC, "t-research-kb") == 5;
    assert tr_facet(sd[0..sn], TR_F_TOPIC, "t-resource-doctor") == 4;
    assert tr_facet(sd[0..sn], TR_F_TOPIC, "t-breach-check") == 3;
    assert tr_facet(sd[0..sn], TR_F_TAG, "agents") == 3;
    assert tr_facet(sd[0..sn], TR_F_TAG, "local-first") == 1;
    assert tr_facet(sd[0..sn], TR_F_TAG, "cli") == 1;
    assert tr_facet(sd[0..sn], TR_F_AUTHOR, "chen") == 2;
    assert tr_facet(sd[0..sn], TR_F_AUTHOR, "CHEN") == 2;
    assert tr_facet(sd[0..sn], TR_F_YEAR, "2026") == 2;
    assert tr_facet(sd[0..sn], TR_F_YEAR, "-") == 1;
    assert tr_facet(sd[0..sn], TR_F_DATE, "2026-11-08") == 11;
    assert tr_facet(sd[0..sn], TR_F_DATE, "2026-11-07") == 1;
    assert tr_facet(sd[0..sn], 9, "x") == 0;
    assert tr_facet(sd[0..sn], TR_F_YEAR, "") == 0;
    assert tr_coverage_pm(sd[0..sn]) == 1000;
    const sn2 : usize = tr_add(sd[0..12288], sn, "N|n99|v1|2026-11-08|pmc:PMC13732382|t-research-kb|low|sec 1|A claim");
    assert tr_coverage_pm(sd[0..sn2]) == 923;
    assert tr_coverage_pm(sd[0..0]) == 0;
}

test research_latest_decision_and_gets {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    const lp : usize = tr_latest_decision(sd[0..sn], "t-resource-doctor");
    assert bytes_eq(tr_field(tr_line_from(sd[0..sn], lp), 1), "d2");
    const lk : usize = tr_latest_decision(sd[0..sn], "t-research-kb");
    assert bytes_eq(tr_field(tr_line_from(sd[0..sn], lk), 1), "d1");
    assert tr_latest_decision(sd[0..sn], "t-breach-check") == 0;
    assert bytes_eq(tr_field(tr_get(sd[0..sn], TR_K_N, "n3"), 2), "v2");
    assert bytes_eq(tr_field(tr_get(sd[0..sn], TR_K_Y, "y1"), 2), "v2");
    assert tr_get(sd[0..sn], TR_K_N, "n77").len == 0;
    assert tr_max_ver(sd[0..sn], TR_K_N, "n3") == 2;
    assert bytes_eq(tr_stage_name(1), "conceptualize");
    assert bytes_eq(tr_stage_name(5), "consume");
    assert tr_stage_name(6).len == 0;
}

test research_t27l {
    var sd : [12288]u8 = undefined;
    const sn : usize = tr_seed(sd[0..12288]);
    var ev : [2048]u8 = undefined;
    var i : usize = 0;
    var failed : usize = 0;
    while (i < 32) {
        const s : usize = tr_line_start(sd[0..sn], i);
        const ln : []const u8 = sd[s..tr_eol(sd[0..sn], s)];
        const m : usize = tr_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", ln, false, 2, 2);
        if (m == 0 or tl_validate_line(ev[0..m]) != TL_OK) { failed += 1; }
        i += 1;
    }
    assert failed == 0;
    const s27 : usize = tr_line_start(sd[0..sn], 31);
    const dl : []const u8 = sd[s27..tr_eol(sd[0..sn], s27)];
    assert tr_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", dl, true, 2, 2) == 0;
    assert tr_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", dl, true, 2, 3) > 0;
    assert tr_refusal_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", dl, 2, 2) == 0;
    assert tr_refusal_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", dl, 2, 3) > 0;
    assert tr_refusal_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", TR_L13, 2, 2) == 0;
    assert tr_refusal_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", TR_L13, 2, 3) > 0;
    assert tr_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", "Q|a|b", false, 2, 2) == 0;
    assert tr_event(ev[0..2048], TL_T_EV1, "2026-11-08T12:34:56Z", TR_L01, false, 0, 2) == 0;
}

test research_actions_and_payload {
    assert tr_action_of(TR_L01, false) == 58;
    assert tr_action_of(TR_L04, false) == 59;
    assert tr_action_of(TR_L14, false) == 59;
    assert tr_action_of(TR_L15, false) == 61;
    assert tr_action_of(TR_L15, true) == 62;
    assert tr_action_of(TR_L28, false) == 63;
    assert tr_action_of(TR_L28, true) == 64;
    assert tr_action_of(TR_L31, false) == 65;
    assert tr_action_of(TR_L31, true) == 66;
    assert tr_action_of("Q|a", false) == 0;
    assert tr_refusal_action(TR_L04) == 60;
    assert tr_refusal_action(TR_L15) == 67;
    assert tr_refusal_action("Q|a") == 0;
    var pl : [160]u8 = undefined;
    const pn : usize = tr_payload(pl[0..160], TR_L15);
    assert bytes_eq(pl[0..pn], "note n1");
    const pt : usize = tr_payload(pl[0..160], TR_L01);
    assert bytes_eq(pl[0..pt], "topic t-research-kb");
    assert tr_payload(pl[0..160], "Q|a") == 0;
    assert tr_payload(pl[0..20], TR_L01) == 0;
}

test research_cli_contract {
    assert tr_cmd_id("topic add") == 1;
    assert tr_cmd_id("note revise") == 7;
    assert tr_cmd_id("decision revisit") == 13;
    assert tr_cmd_id("evidence check") == 15;
    assert tr_cmd_id("export") == TR_CMD_COUNT;
    assert tr_cmd_id("source delete") == 0;
    assert tr_cmd_id("") == 0;
    assert tr_cmd_writes(1);
    assert tr_cmd_writes(13);
    assert !tr_cmd_writes(2);
    assert !tr_cmd_writes(16);
    assert !tr_cmd_writes(0);
    assert tr_arg_ok("topic list");
    assert !tr_arg_ok("API_KEY=abc123");
}
