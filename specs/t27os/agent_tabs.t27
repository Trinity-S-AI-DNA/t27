// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agent_tabs.t27 -- subagent tab model: one tab per registered role of a letter.
; The registry is specs/queen/agent_registry.t27 (section 9f): AN_ROLE_IDS, AN_ROLE_DOM, AN_ROLE_COUNT.
; Extracted from agent_parts.t27 (Closes #13893, see #13862) to keep agent_parts dep-chain clean.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osAgentTabs;

use t27os::agent_parts::LETTER_COUNT;
use t27os::session_store::put_bytes;
use queen::agent_registry::AN_ROLE_COUNT;
use queen::agent_registry::AN_ROLE_IDS;
use queen::agent_registry::AN_ROLE_DOM;
use std::mem::bytes_eq;

/// Number of subagent tabs of letter l: the role ids whose AN_ROLE_DOM is l. 0 outside 1..27.
pub fn subagent_tab_count(l: u32) -> u32 {
    if (l < 1 or l > LETTER_COUNT) { return 0; }
    const d : u8 = @intCast(l);
    var n : u32 = 0;
    var i : usize = 0;
    while (i < AN_ROLE_COUNT) {
        if (AN_ROLE_DOM[i] == d) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Index into AN_ROLE_IDS of tab k (0-based, registry order) of letter l; AN_ROLE_COUNT when none.
pub fn subagent_tab_index(l: u32, k: u32) -> usize {
    if (l < 1 or l > LETTER_COUNT) { return AN_ROLE_COUNT; }
    const d : u8 = @intCast(l);
    var seen : u32 = 0;
    var i : usize = 0;
    while (i < AN_ROLE_COUNT) {
        if (AN_ROLE_DOM[i] == d) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return AN_ROLE_COUNT;
}

/// Role id (0xRole@slug.t27) of tab k of letter l; "" when out of range.
pub fn subagent_tab_id(l: u32, k: u32) -> []const u8 {
    const i : usize = subagent_tab_index(l, k);
    if (i >= AN_ROLE_COUNT) { return ""; }
    return AN_ROLE_IDS[i];
}

/// Write the title of tab k of letter l (the role part of its id, between 0x and @) into out.
/// Returns its length; 0 when out of range.
pub fn subagent_tab_title(out: []u8, l: u32, k: u32) -> usize {
    const id : []const u8 = subagent_tab_id(l, k);
    if (id.len < 3) { return 0; }
    var j : usize = 2;
    while (j < id.len and id[j] != 64) { j = j + 1; }
    return put_bytes(out, 0, id[2..j]);
}

test tab_counts_of_the_27_letters_add_up_to_the_role_count {
    var total : u32 = 0;
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        total = total + subagent_tab_count(l);
        l = l + 1;
    }
    assert total == 106;
    assert total == AN_ROLE_COUNT;
}

test tabs_of_a_letter_are_its_roles_in_registry_order {
    // letter 1 (A): the first four ids of AN_ROLE_IDS; letter 27: the last four
    assert subagent_tab_count(1) == 4;
    assert bytes_eq(subagent_tab_id(1, 0), AN_ROLE_IDS[0]);
    assert bytes_eq(subagent_tab_id(1, 3), AN_ROLE_IDS[3]);
    assert subagent_tab_count(27) == 4;
    assert bytes_eq(subagent_tab_id(27, 3), AN_ROLE_IDS[105]);
    var out : [64]u8 = undefined;
    const n : usize = subagent_tab_title(out[0..], 1, 0);
    assert bytes_eq(out[0..n], "Identity");
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        var k : u32 = 0;
        while (k < subagent_tab_count(l)) {
            assert AN_ROLE_DOM[subagent_tab_index(l, k)] == l;
            if (k > 0) { assert subagent_tab_index(l, k) > subagent_tab_index(l, k - 1); }
            k = k + 1;
        }
        l = l + 1;
    }
}

test negative_control_out_of_range_letter_or_tab_has_no_tab {
    var out : [64]u8 = undefined;
    assert subagent_tab_count(0) == 0;
    assert subagent_tab_count(28) == 0;
    assert subagent_tab_id(1, 4) == "";
    assert subagent_tab_id(1, 400) == "";
    assert subagent_tab_title(out[0..], 28, 0) == 0;
    assert subagent_tab_index(0, 0) == AN_ROLE_COUNT;
}
