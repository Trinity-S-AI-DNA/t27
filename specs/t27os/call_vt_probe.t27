// SPDX-License-Identifier: Apache-2.0
// specs/t27os/call_vt_probe.t27 -- the H.264 path of a call without a window, a camera or a network (owner,
// 2026-10-23): call_vt.t27's encoder and decoder with call_h264.t27's parts, assembly, gate and key frame requests in
// between, one process. Not the app and not the proof of the app: it shows that VideoToolbox runs from .t27 (the
// 10-argument create through libffi, both callbacks, the ring and the mailbox) and what it costs.
// Synthetic BGRA frames (a grey level that changes with the frame and a white bar that moves) are made at VTP_SRC_W x
// VTP_SRC_H, VTP_FRAMES of them at 30 a second; each coded frame is cut into parts and put together again; part 0 of
// frame VTP_DROP is not delivered (a lost datagram), so the gate must hold the frames after it back and a key frame
// request must bring a key frame; with VTP_SWITCH=n the picture steps down one rung after frame n (a new session, new
// parameter sets: the decoder must remake its session).
//   VTP_FRAMES=150 VTP_RUNG=0 VTP_KBPS=1200 VTP_SRC_W=1280 VTP_SRC_H=720 VTP_DROP=60 VTP_SWITCH=0
// Build (Apple silicon):
//   t27b build specs/t27os/call_vt_probe.t27 -o vtp.o --macho
//   ld -arch arm64 -platform_version macos 11.0 $(xcrun --show-sdk-version) -syslibroot $(xcrun --show-sdk-path) \
//      -e _main -lSystem -lffi -framework CoreFoundation -framework CoreMedia -framework CoreVideo \
//      -framework VideoToolbox -framework IOSurface -o vtp vtp.o
// Prints one line per check; exit 0 only when every check passed. Refs gHashTag/t27#11560.
module T27osCallVtProbe;

use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;
use t27os::pty_proto::put_u64;
use t27os::pty_proto::get_u64;
