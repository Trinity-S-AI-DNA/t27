use t27os::call_h264::vh_take;
use t27os::call_h264::vh_is_key;
use t27os::call_h264::va_get;
use t27os::call_h264::va_reset;
use t27os::call_h264::vd_gate;
use t27os::call_h264::vd_error;
use t27os::call_h264::vk_due;
use t27os::call_h264::vk_sent;
use t27os::call_h264::vk_on_request;
use t27os::call_h264::vs_number;
use t27os::call_h264::vs_get;
use t27os::call_h264::vl_w;
use t27os::call_h264::vl_h;
use t27os::call_vt::VT_BGRA;
use t27os::call_vt::VE_OUT;
use t27os::call_vt::VE_KEYS;
use t27os::call_vt::VE_BYTES;
use t27os::call_vt::VE_DROP;
use t27os::call_vt::VE_ERR;
use t27os::call_vt::VE_OVER;
use t27os::call_vt::VE_CFAIL;
use t27os::call_vt::VE_CSTAT;
use t27os::call_vt::VE_LAT_MAX;
use t27os::call_vt::VE_LAT_SUM;
use t27os::call_vt::VE_LAT_N;
use t27os::call_vt::VE_LOWLAT;
use t27os::call_vt::VE_CREATES;
use t27os::call_vt::VE_PROPFAIL;
use t27os::call_vt::VE_NAL4;
use t27os::call_vt::VE_BIG;
use t27os::call_vt::VE_CALL_MAX;
use t27os::call_vt::VE_W;
use t27os::call_vt::VE_H;
use t27os::call_vt::VDK_W;
use t27os::call_vt::VDK_H;
use t27os::call_vt::VDK_FED;
use t27os::call_vt::VDK_OUT;
use t27os::call_vt::VDK_BAD;
use t27os::call_vt::VDK_CREATES;
use t27os::call_vt::VDK_CFAIL;
use t27os::call_vt::VDK_REPL;
use t27os::call_vt::VDK_DERR;
use t27os::call_vt::VDK_LAT_MAX;
use t27os::call_vt::VDK_LAT_SUM;
use t27os::call_vt::VDK_LAT_N;
use t27os::call_vt::VDK_CALL_MAX;
use t27os::call_vt::VDK_DROPPED;
use t27os::call_vt::vte_new;
use t27os::call_vt::vte_want;
use t27os::call_vt::vte_force;
use t27os::call_vt::vte_encode;
use t27os::call_vt::vte_ready;
use t27os::call_vt::vte_len;
use t27os::call_vt::vte_meta;
use t27os::call_vt::vte_read;
use t27os::call_vt::vte_pop;
use t27os::call_vt::vte_close;
use t27os::call_vt::vte_stat;
use t27os::call_vt::vtd_new;
use t27os::call_vt::vtd_post;
use t27os::call_vt::vtd_depth;
use t27os::call_vt::vtd_errors;
use t27os::call_vt::VDK_POST_MAX;
use t27os::call_vt::VDK_BUSY;
use t27os::call_vt::vtd_take;
use t27os::call_vt::vtd_close;
use t27os::call_vt::vtd_stat;
use t27os::call_vt::vt_pb_w;
use t27os::call_vt::vt_pb_h;
use t27os::call_vt::vt_pb_release;
use t27os::call_vt::vt_konst;

fn vp_dlsym(h: u64, name: []const u8) -> u64 { return @extern("dlsym"); }
fn vp_calloc(n: u64, size: u64) -> u64 { return @extern("calloc"); }
fn vp_now() -> f64 { return @extern("CFAbsoluteTimeGetCurrent"); }
fn vp_cf_dict(alloc: u64, keys: u64, vals: u64, n: u64, kcb: u64, vcb: u64) -> u64 { return @extern("CFDictionaryCreate"); }
fn vp_pb_create(alloc: u64, w: u64, h: u64, fmt: u32, attrs: u64, out: u64) -> i32 { return @extern("CVPixelBufferCreate"); }
fn vp_pb_lock(pb: u64, flags: u64) -> i32 { return @extern("CVPixelBufferLockBaseAddress"); }
fn vp_pb_unlock(pb: u64, flags: u64) -> i32 { return @extern("CVPixelBufferUnlockBaseAddress"); }
fn vp_pb_base(pb: u64) -> u64 { return @extern("CVPixelBufferGetBaseAddress"); }
fn vp_pb_row(pb: u64) -> u64 { return @extern("CVPixelBufferGetBytesPerRow"); }
fn vp_memset(p: u64, c: i32, n: u64) -> u64 { return @extern("memset"); }
fn vp_peek(dst: []u8, src: u64, n: u64) -> u64 { return @extern("memmove"); }

const VP_RTLD : u64 = 18446744073709551614;
const VP_POOL : u64 = 8;

fn vp_us() -> u64 { return @as(u64, @intFromFloat(vp_now() * 1000000.0)); }

/// The grey level of frame i.
fn vp_grey(i: u64) -> u64 { return 40 + (i * 3) % 180; }

/// Frame i into pb: every byte the grey level, a white bar 64 pixels wide that moves 8 pixels a frame.
fn vp_paint(pb: u64, i: u64, w: u64, h: u64) -> void {
    vp_pb_lock(pb, 0);
    const base : u64 = vp_pb_base(pb);
    const row : u64 = vp_pb_row(pb);
    vp_memset(base, @as(i32, @intCast(vp_grey(i))), row * h);
    const bx : u64 = (i * 8) % (w - 64);
    var y : u64 = 0;
    while (y < h) {
        vp_memset(base + y * row + bx * 4, 255, 256);
        y = y + 1;
    }
    vp_pb_unlock(pb, 0);
}

/// The grey of the decoded picture at its centre row, left quarter (away from the bar): the mean of B, G, R.
fn vp_sample(pb: u64) -> u64 {
    vp_pb_lock(pb, 1);
    const base : u64 = vp_pb_base(pb);
    const row : u64 = vp_pb_row(pb);
    const w : u64 = vt_pb_w(pb);
    const h : u64 = vt_pb_h(pb);
    var px : [4]u8 = undefined;
    var s : u64 = 0;
    var n : u64 = 0;
    var x : u64 = 4;
    // the bar sits in [bx, bx + 64); look where it is not: compare a few points and keep the darkest
    var best : u64 = 255;
    while (x < w - 4) {
        vp_peek(px[0..4], base + (h / 2) * row + x * 4, 4);
        const v : u64 = (@as(u64, px[0]) + @as(u64, px[1]) + @as(u64, px[2])) / 3;
        if (v < best) { best = v; }
        s = s + v;
        n = n + 1;
        x = x + w / 16;
    }
    vp_pb_unlock(pb, 1);
    return best;
}

fn vp_abs(a: u64, b: u64) -> u64 {
    if (a > b) { return a - b; }
    return b - a;
}

pub fn main() -> void {
    const frames : u64 = ckh_env_num("VTP_FRAMES", 150);
    const rung : u64 = ckh_env_num("VTP_RUNG", 0);
    const kbps : u64 = ckh_env_num("VTP_KBPS", 1200);
    const sw : u64 = ckh_env_num("VTP_SRC_W", 1280);
    const sh : u64 = ckh_env_num("VTP_SRC_H", 720);
    const drop : u64 = ckh_env_num("VTP_DROP", 60);
    const sw_at : u64 = ckh_env_num("VTP_SWITCH", 0);
    var ok : bool = true;
    ckh_line("VTP start\n");
    const e : u64 = vte_new();
    const d : u64 = vtd_new();
    ok = ckh_check("encoder and decoder blocks", e != 0 and d != 0) and ok;
    if (!ok) { sys_exit(1); }
    vte_want(e, @as(u32, @intCast(rung)), kbps);
    // a pool of source buffers on IOSurfaces
    const mem : u64 = vp_calloc(1, 256);
    const empty : u64 = vp_cf_dict(0, 0, 0, 0, vp_dlsym(VP_RTLD, "kCFTypeDictionaryKeyCallBacks"), vp_dlsym(VP_RTLD, "kCFTypeDictionaryValueCallBacks"));
    cbp_put(mem, vt_konst("kCVPixelBufferIOSurfacePropertiesKey"));
    cbp_put(mem + 8, empty);
    const attrs : u64 = vp_cf_dict(0, mem, mem + 8, 1, vp_dlsym(VP_RTLD, "kCFTypeDictionaryKeyCallBacks"), vp_dlsym(VP_RTLD, "kCFTypeDictionaryValueCallBacks"));
    var k : u64 = 0;
    var made : u64 = 0;
    while (k < VP_POOL) {
        cbp_put(mem + 64 + k * 8, 0);
        if (vp_pb_create(0, sw, sh, VT_BGRA, attrs, mem + 64 + k * 8) == 0 and cbp_get(mem + 64 + k * 8) != 0) { made = made + 1; }
        k = k + 1;
    }
    ok = ckh_check("8 source buffers on IOSurfaces", made == VP_POOL) and ok;
    if (!ok) { sys_exit(1); }
    var st : [256]u8 = undefined;
    va_reset(st[0..256]);
    var ss : [512]u8 = undefined;
    var z : usize = 0;
    while (z < 512) { ss[z] = 0; z = z + 1; }
    var buf : [131072]u8 = undefined;
    var cut : [1160]u8 = undefined;
    var pt : [1176]u8 = undefined;
    var sent : u64 = 0;
    var parts : u64 = 0;
    var keys_tx : u64 = 0;
    var held_any : bool = false;
    var key_after_drop : u64 = 0;
    var dec_refused : u64 = 0;
    var shown : u64 = 0;
    var last_pb : u64 = 0;
    var wmax : u64 = 0;
    var bytes_tx : u64 = 0;
    var dropped_frame : u64 = 0;
    const t_start : u64 = vp_us();
    var i : u64 = 0;
    while (i < frames + 30) {
        if (i < frames) {
            if (sw_at != 0 and i == sw_at) { vte_want(e, @as(u32, @intCast(rung + 1)), kbps); }
            const pb : u64 = cbp_get(mem + 64 + (i % VP_POOL) * 8);
            vp_paint(pb, i, sw, sh);
            vte_encode(e, pb, t_start + i * 33333);
        }
        // the polling side: every coded frame out of the ring, cut, carried, put together, gated, decoded
        while (vte_ready(e)) {
            const len : u64 = vte_len(e);
            const key : bool = (vte_meta(e) & 1) != 0;
            const f : u64 = vs_number(ss[0..512], key);
            if (key) { keys_tx = keys_tx + 1; }
            if (key and dropped_frame != 0 and f > dropped_frame and key_after_drop == 0) { key_after_drop = f; }
            const n : usize = vh_parts(@as(usize, len));
            var p : usize = 0;
            while (p < n) {
                const c : usize = vh_cut(@as(usize, len), p);
                vte_read(e, @as(u64, p * VH_PART), cut[0..c]);
                const pl : usize = vh_part(pt[0..1176], f, @as(usize, len), p, key, 0, cut[0..c]);
                parts = parts + 1;
                bytes_tx = bytes_tx + @as(u64, pl);
                if (!(f == drop and p == 0)) {
                    const v : u32 = vh_take(st[0..256], buf[0..131072], pt[0..pl], i);
                    if (v == VH_COMPLETE) {
                        const size : usize = @as(usize, va_get(st[0..256], VA_SIZE));
                        const isk : bool = vh_is_key(buf[0..size]);
                        if (vd_gate(st[0..256], f, isk)) {
                            if (vtd_post(d, buf[0..size]) != 0) { vd_error(st[0..256]); dec_refused = dec_refused + 1; }
                        } else {
                            held_any = true;
                        }
                    }
                } else {
                    dropped_frame = f;
                }
                p = p + 1;
            }
            vte_pop(e);
            sent = sent + 1;
            // the receiver asks for a key frame; the sender follows the request
            if (vk_due(st[0..256], i * 33)) {
                vk_sent(st[0..256], i * 33);
                if (vk_on_request(ss[0..512], va_get(st[0..256], VA_SEEN), i * 33)) { vte_force(e); }
            }
        }
        const got : u64 = vtd_take(d);
        if (got != 0) {
            shown = shown + 1;
            if (vt_pb_w(got) > wmax) { wmax = vt_pb_w(got); }
            if (last_pb != 0) { vt_pb_release(last_pb); }
            last_pb = got;
        }
        ckh_usleep(33333);
        i = i + 1;
    }
    const took : u64 = vp_us() - t_start;
    ckh_num("VTP frames made: ", frames);
    ckh_num("VTP frames out of the encoder: ", vte_stat(e, VE_OUT));
    ckh_num("VTP key frames out of the encoder: ", vte_stat(e, VE_KEYS));
    ckh_num("VTP encoder drops / errors / ring full / too big: ", vte_stat(e, VE_DROP) * 1000000 + vte_stat(e, VE_ERR) * 10000 + vte_stat(e, VE_OVER) * 100 + vte_stat(e, VE_BIG));
    ckh_num("VTP encoder create status: ", vte_stat(e, VE_CSTAT));
    ckh_num("VTP encoder sessions made: ", vte_stat(e, VE_CREATES));
    ckh_num("VTP encoder create failures: ", vte_stat(e, VE_CFAIL));
    ckh_num("VTP low latency rate control: ", vte_stat(e, VE_LOWLAT));
    ckh_num("VTP properties refused: ", vte_stat(e, VE_PROPFAIL));
    ckh_num("VTP encoder picture width: ", vte_stat(e, VE_W));
    ckh_num("VTP encoder picture height: ", vte_stat(e, VE_H));
    ckh_num("VTP encode latency max us: ", vte_stat(e, VE_LAT_MAX));
    if (vte_stat(e, VE_LAT_N) > 0) { ckh_num("VTP encode latency mean us: ", vte_stat(e, VE_LAT_SUM) / vte_stat(e, VE_LAT_N)); }
    ckh_num("VTP encode call max us: ", vte_stat(e, VE_CALL_MAX));
    ckh_num("VTP coded bytes: ", vte_stat(e, VE_BYTES));
    if (vte_stat(e, VE_OUT) > 0) { ckh_num("VTP mean coded frame bytes: ", vte_stat(e, VE_BYTES) / vte_stat(e, VE_OUT)); }
    ckh_num("VTP kbit/s over the run: ", vte_stat(e, VE_BYTES) * 8 * 1000 / (frames * 33333));
    ckh_num("VTP parts sent: ", parts);
    ckh_num("VTP frames completed: ", va_get(st[0..256], VA_DONE));
    ckh_num("VTP key frames completed: ", va_get(st[0..256], VA_KEYS));
    ckh_num("VTP frames lost: ", va_get(st[0..256], VA_LOST));
    ckh_num("VTP frames dropped half built: ", va_get(st[0..256], VA_DROPPED));
    ckh_num("VTP frames held back by the gate: ", va_get(st[0..256], VD_HELD));
    ckh_num("VTP frames given to the decoder: ", va_get(st[0..256], VD_FED));
    ckh_num("VTP key frames forced by a request: ", vs_get(ss[0..512], VS_FORCES));
    ckh_num("VTP first key frame after the lost part: ", key_after_drop);
    ckh_num("VTP decoder sessions made: ", vtd_stat(d, VDK_CREATES));
    ckh_num("VTP decoder create failures: ", vtd_stat(d, VDK_CFAIL));
    ckh_num("VTP decoder pictures out: ", vtd_stat(d, VDK_OUT));
    ckh_num("VTP decoder refusals: ", vtd_stat(d, VDK_BAD));
    ckh_num("VTP decode call errors: ", vtd_stat(d, VDK_DERR));
    ckh_num("VTP decoder frames dropped: ", vtd_stat(d, VDK_DROPPED));
    ckh_num("VTP decode latency max us: ", vtd_stat(d, VDK_LAT_MAX));
    if (vtd_stat(d, VDK_LAT_N) > 0) { ckh_num("VTP decode latency mean us: ", vtd_stat(d, VDK_LAT_SUM) / vtd_stat(d, VDK_LAT_N)); }
    ckh_num("VTP decode job max us (on its queue): ", vtd_stat(d, VDK_CALL_MAX));
    ckh_num("VTP post max us (the polling thread): ", vtd_stat(d, VDK_POST_MAX));
    ckh_num("VTP posts refused, queue behind: ", vtd_stat(d, VDK_BUSY));
    ckh_num("VTP decoder picture width: ", vtd_stat(d, VDK_W));
    ckh_num("VTP decoder picture height: ", vtd_stat(d, VDK_H));
    ckh_num("VTP pictures taken by the window side: ", shown);
    ckh_num("VTP mailbox pictures replaced untaken: ", vtd_stat(d, VDK_REPL));
    ckh_num("VTP run ms: ", took / 1000);
    var grey : u64 = 0;
    if (last_pb != 0) {
        grey = vp_sample(last_pb);
        ckh_num("VTP last picture width: ", vt_pb_w(last_pb));
        ckh_num("VTP last picture height: ", vt_pb_h(last_pb));
        ckh_num("VTP last picture grey at the centre row: ", grey);
        ckh_num("VTP grey of the last frame made: ", vp_grey(frames - 1));
    }
    var er : u64 = rung;
    if (sw_at != 0) { er = rung + 1; }
    ok = ckh_check("the encoder made a session and a frame for nearly every frame given (>= 95 %)", vte_stat(e, VE_OUT) * 100 >= frames * 95) and ok;
    ok = ckh_check("no encoder errors, drops, full ring or too big frame", vte_stat(e, VE_ERR) + vte_stat(e, VE_DROP) + vte_stat(e, VE_OVER) + vte_stat(e, VE_BIG) + vte_stat(e, VE_NAL4) == 0) and ok;
    ok = ckh_check("the picture has the size of the rung", vtd_stat(d, VDK_W) == vl_w(@as(u32, @intCast(er))) and vtd_stat(d, VDK_H) == vl_h(@as(u32, @intCast(er)))) and ok;
    ok = ckh_check("the decoder gave a picture for nearly every frame it was given (>= 95 %)", vtd_stat(d, VDK_OUT) * 100 >= va_get(st[0..256], VD_FED) * 95 and vtd_stat(d, VDK_OUT) > 0) and ok;
    ok = ckh_check("no decoder refusals", vtd_errors(d) + dec_refused == 0) and ok;
    ok = ckh_check("queueing a frame costs the polling thread under 2 ms", vtd_stat(d, VDK_POST_MAX) < 2000) and ok;
    if (drop != 0 and drop <= frames) {
        ok = ckh_check("the lost part dropped its frame and the gate held the next ones back", va_get(st[0..256], VA_DROPPED) + va_get(st[0..256], VA_LOST) >= 1 and held_any) and ok;
        ok = ckh_check("a request brought a key frame within 10 frames of the loss", key_after_drop != 0 and key_after_drop <= dropped_frame + 10 and vs_get(ss[0..512], VS_FORCES) >= 1) and ok;
    }
    if (sw_at != 0) {
        ok = ckh_check("the step down made a second encoder and decoder session", vte_stat(e, VE_CREATES) == 2 and vtd_stat(d, VDK_CREATES) == 2) and ok;
    }
    ok = ckh_check("the last picture shows the last frame's grey (within 12)", last_pb != 0 and vp_abs(grey, vp_grey(frames - 1)) <= 12) and ok;
    vte_close(e);
    vtd_close(d);
    if (last_pb != 0) { vt_pb_release(last_pb); }
    if (ok) {
        ckh_line("ALL CHECKS PASSED\n");
        sys_exit(0);
    }
    ckh_line("SOME CHECKS FAILED\n");
    sys_exit(1);
}
