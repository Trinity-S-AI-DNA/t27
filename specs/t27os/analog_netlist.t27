// specs/t27os/analog_netlist.t27 -- analog: netlist block class and picture
// plan (Wave B of #13650).
// Part of M1 (milestone #5). Closes #13665.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::analog_netlist;

pub const NETLIST_BLOCK_MAX : u32 = 256;

pub struct NetlistBlock { id: str, picture_planned: bool };

pub fn netlist_block_picture_planned(b: NetlistBlock) -> bool {
    return b.picture_planned;
}

test "netlist block picture planned" {
    assert(netlist_block_picture_planned(NetlistBlock { id: "block-1", picture_planned: true }));
    assert(!netlist_block_picture_planned(NetlistBlock { id: "block-2", picture_planned: false }));
}

invariant netlist_block_max_positive {
    assert NETLIST_BLOCK_MAX > 0;
}