// SPDX-License-Identifier: Apache-2.0
; specs/t27os/doctor.t27 -- the repositories T27 OS finds on this machine, the SPACES it makes of them, and
; the DOCTOR that says which copies are left over and what they cost on disk.
; Owner, 2026-10-19: by default T27 OS finds every git repository on the machine and makes a SPACE per
; repository, the user can hide one; the scan keeps running, so new clones and worktrees appear and deleted
; ones vanish; a DOCTOR panel flags duplicate clones of one remote, leftover agent worktrees, folders agents
; made several times, and the disk each repository takes; it suggests what to remove, and nothing is removed
; until the human confirms each item -- a repository with unpushed commits or uncommitted changes is never
; offered for removal at all.
; This spec is the decisions. The host (glass_window.t27) does only the plumbing: it lists directories, runs
; the git and du command lines below one at a time, reads their output, and moves a confirmed item to the
; Trash (reversible, never an unlink).
; The scan is a walk, not an FS-event stream: the host cannot hand a C callback to FSEvents yet, so it walks
; SCAN_BUDGET directories a frame, walks once at launch and again only while the DOCTOR is open (rescan_due), and re-checks one
; known repository's .git every frame. A clone appears within one pass; a deleted one vanishes as soon as its
; turn in the re-check comes round (VANISH_FRAMES at most for a list of LIST_MAX).
; Not measured here: memory per repository. Disk is measured; RAM belongs to processes, not folders, and is
; left to the terminal owner (agents.t27) that will know which agent runs in which repository.

module T27osDoctor;

/// Where the walk starts, in order, and how deep it goes below each root. HOME is the user's home directory.
pub const ROOT_HOME : u32 = 0;
pub const ROOT_TMP : u32 = 1;
pub const ROOT_COUNT : u32 = 2;
pub const ROOT_TMP_PATH : str = "/private/tmp";
pub const DEPTH_HOME : u32 = 5;
pub const DEPTH_TMP : u32 = 3;
/// Directory names the walk never enters: caches, build output, package stores, media and app bundles.
/// Desktop, Documents, Dropbox and OrbStack are cloud- or VM-backed (a stat there blocked the walk for minutes); Downloads holds archives.
pub const SCAN_SKIP : str = "node_modules,target,Library,Applications,Movies,Music,Pictures,Desktop,Documents,Downloads,Dropbox,OrbStack,build,dist,DerivedData,Pods,zig-cache,zig-out,vendor,__pycache__";
/// A name starting with "." is skipped, except these: agent worktrees live under .claude/worktrees.
pub const HIDDEN_PREFIX : str = ".";
pub const HIDDEN_ALLOWED : str = ".claude,.codex,.gemini";
/// Walk pacing (frames at 30 fps).
pub const SCAN_BUDGET : u32 = 24;
pub const RESCAN_FRAMES : u32 = 900;
/// The checks pace themselves the same way: a pass over the list, then RESCAN_FRAMES of rest.
pub const LIST_MAX : u32 = 600;
pub const VANISH_FRAMES : u32 = 600;

/// Paths that only agents make: a repository below one of these is an agent copy.
pub const AGENT_ROOTS : str = "/private/tmp/,/tmp/,/t27-lanes/,/.claude/worktrees/,/.codex/,/.gemini/";

/// A folder name with these endings stripped is its stem; REPEAT_MIN folders with one stem under one parent
/// are "made several times" (t27-2, t27-3, t27-copy, t27-old ...). A regular expression, applied by the host.
pub const STEM_PATTERN : str = "([-_. ](copy|old|bak|tmp|wip|new|[0-9]+))+$";
pub const REPEAT_MIN : u32 = 3;

/// The checks run on every repository, in order. {p} is the repository path; arguments are split on "|".
pub const JOB_STATUS : u32 = 0;
pub const JOB_UNPUSHED : u32 = 1;
pub const JOB_REMOTE : u32 = 2;
pub const JOB_SIZE : u32 = 3;
pub const JOB_BUILD : u32 = 4;
pub const JOB_COUNT : u32 = 5;
pub const JOB_LINES : str = "/usr/bin/git|-C|{p}|status|--porcelain=v2|--branch|--show-stash;/usr/bin/git|-C|{p}|log|HEAD|--branches|--not|--remotes|-1|--format=%h;/usr/bin/git|-C|{p}|remote|get-url|origin;/usr/bin/du|-sk|{p};/usr/bin/du|-sk|{p}/target|{p}/node_modules|{p}/.zig-cache|{p}/zig-out|{p}/build|{p}/dist";
pub const JOB_SEP : str = ";";
pub const ARG_SEP : str = "|";
pub const PATH_MARK : str = "{p}";
/// How many checks run at once, and how many passes over the list pass between two size checks (du is slow).
pub const JOB_SLOTS : u32 = 4;
pub const SIZE_EVERY : u32 = 4;

/// Reading `git status --porcelain=v2 --branch --show-stash`: header lines start with "# ", every other
/// non-empty line is a changed or untracked path.
pub const ST_HEADER : str = "# ";
pub const ST_HEAD : str = "# branch.head ";
pub const ST_UPSTREAM : str = "# branch.upstream ";
pub const ST_STASH : str = "# stash ";

/// What the DOCTOR knows about a repository, one bit each.
pub const F_CHECKED : u32 = 1;
pub const F_WORKTREE : u32 = 2;
pub const DOC_F_AGENT : u32 = 4;
pub const F_DUP : u32 = 8;
pub const F_REPEATED : u32 = 16;
pub const F_HEAVY : u32 = 32;
pub const F_BUILD : u32 = 64;
pub const F_DIRTY : u32 = 128;
pub const F_UNPUSHED : u32 = 256;
pub const F_STASH : u32 = 512;
pub const F_HAS_WORKTREES : u32 = 1024;
pub const F_NESTS : u32 = 2048;
pub const F_NO_REMOTE : u32 = 4096;
pub const F_PUSH_CHECKED : u32 = 8192;
pub const F_BOUND : u32 = 16384;
pub const F_HIDDEN : u32 = 32768;
pub const FLAG_BITS : u32 = 16;
/// The words a DOCTOR row shows, in bit order; an empty word is a bit the row does not print.
pub const FLAG_WORDS : str = ",worktree,agent copy,duplicate,made again,heavy,build dirs,uncommitted,unpushed,stash,has worktrees,holds repos,no remote,,,hidden";

/// A repository is heavy at HEAVY_MB, and its build directories are worth naming at BUILD_MB.
pub const HEAVY_MB : u64 = 1024;
pub const BUILD_MB : u64 = 200;

/// Why a leftover is kept, in the order a row names the first that applies.
pub const KEEP_NONE : u32 = 0;
pub const KEEP_UNCHECKED : u32 = 1;
pub const KEEP_DIRTY : u32 = 2;
pub const KEEP_UNPUSHED : u32 = 3;
pub const KEEP_STASH : u32 = 4;
pub const KEEP_WORKTREES : u32 = 5;
pub const KEEP_NESTS : u32 = 6;
pub const KEEP_NO_REMOTE : u32 = 7;
pub const KEEP_WORDS : str = ",checking,keep: uncommitted changes,keep: unpushed commits,keep: has a stash,keep: other worktrees use it,keep: holds other repos,keep: no remote copy";

/// DOCTOR row groups, shown in this order.
pub const ROW_REMOVABLE : u32 = 0;
pub const ROW_KEEP : u32 = 1;
pub const ROW_INFO : u32 = 2;
pub const ROW_CLEAN : u32 = 3;
pub const ROW_GROUPS : u32 = 3;

/// The two clicks a removal takes: the first arms the row (it reads CONFIRM), the second moves it to the
/// Trash. Any other click disarms.
pub const ARMED_NONE : u32 = 4294967295;
pub const CLICK_ARM : u32 = 0;
pub const CLICK_REMOVE : u32 = 1;
pub const CLICK_DISARM : u32 = 2;

/// Space binding: which repositories fill the six sidebar slots on their own, and which only "+" offers.
pub const RANK_AUTO : u32 = 0;
pub const RANK_PLUS : u32 = 1;
pub const RANK_NEVER : u32 = 2;
/// Spaces the sidebar fills on its own at first start (the rest stay closed for "+"), seeded with these paths
/// below HOME when they exist.
pub const SPACES_AUTO : u32 = 3;
pub const SEED_PATHS : str = "t27,trinity,t27-t27os";

/// DOCTOR panel layout, in the Queen panel's column (queen.t27 QP_W).
pub const DOC_HEAD_Y : f64 = 25.0;
pub const DOC_SUM_Y : f64 = 52.0;
pub const DOC_ROWS_Y : f64 = 96.0;
pub const DOC_ROW_H : f64 = 48.0;
pub const DOC_BTN_W : f64 = 64.0;
pub const DOC_BTN_H : f64 = 20.0;
/// The button sits on the second line of a row; the foot link "DOCTOR n" takes the right end of the sidebar foot.
pub const DOC_BTN_Y : f64 = 17.0;
pub const DOC_LINK_W : f64 = 84.0;
pub const DOC_WORDS : str = "DOCTOR,repositories,checked,can go,kept,scanning,watching,remove,confirm,nothing to remove,MB,GB,DOCTOR ";
pub const DL_TITLE : u32 = 0;
pub const DL_REPOS : u32 = 1;
pub const DL_CHECKED : u32 = 2;
pub const DL_CAN_GO : u32 = 3;
pub const DL_KEPT : u32 = 4;
pub const DL_SCANNING : u32 = 5;
pub const DL_WATCHING : u32 = 6;
pub const DL_REMOVE : u32 = 7;
pub const DL_CONFIRM : u32 = 8;
pub const DL_NOTHING : u32 = 9;
pub const DL_MB : u32 = 10;
pub const DL_GB : u32 = 11;
pub const DL_FOOT : u32 = 12;

fn flag_bit(k: u32) -> u32 {
    var p : u32 = 1;
    var i : u32 = 0;
    while (i < k) {
        p = p * 2;
        i = i + 1;
    }
    return p;
}

/// Whether bit f is set in flags.
pub fn has(flags: u32, f: u32) -> bool {
    return flags / f % 2 == 1;
}

/// flags with bit f set (or cleared when on is false).
pub fn with_flag(flags: u32, f: u32, on: bool) -> u32 {
    if (has(flags, f) == on) { return flags; }
    if (on) { return flags + f; }
    return flags - f;
}

/// Whether flag word k is printed for these flags.
pub fn shows_word(flags: u32, k: u32) -> bool {
    if (k >= FLAG_BITS) { return false; }
    const f : u32 = flag_bit(k);
    if (f == F_CHECKED or f == F_PUSH_CHECKED or f == F_BOUND) { return false; }
    return has(flags, f);
}

/// How deep the walk goes below root r.
pub fn root_depth(r: u32) -> u32 {
    if (r == ROOT_TMP) { return DEPTH_TMP; }
    return DEPTH_HOME;
}

/// Whether the walk enters a directory at depth d (the root is depth 0) below root r, given whether its name
/// is on SCAN_SKIP, hidden, or one of HIDDEN_ALLOWED.
pub fn enters(r: u32, d: u32, skipped: bool, hidden: bool, allowed: bool) -> bool {
    if (d > root_depth(r)) { return false; }
    if (skipped) { return false; }
    if (hidden and allowed == false) { return false; }
    return true;
}

/// Whether a walk pass that has `queued` directories left is over.
pub fn pass_done(queued: u32) -> bool {
    return queued == 0;
}

/// Whether a new pass starts, `idle` frames after the last one ended.
pub fn pass_due(idle: u32) -> bool {
    return idle >= RESCAN_FRAMES;
}

/// Load audit, owner 2026-10-22: "folder walks and git scans only on an explicit action, not on a timer". RESCAN_FRAMES
/// counted frames, and the formula orbit drew 60 a second, so the walk and the git / du checks over every repository came
/// back every 15 s for as long as the app was open. Now the walk runs once at launch (pass 0) and again only while the
/// DOCTOR panel is open (asked); a new clone shows when the DOCTOR is opened. The idle count stops at RESCAN_FRAMES.
pub fn rescan_due(idle: u32, pass: u64, asked: bool) -> bool {
    if (pass_due(idle) == false) { return false; }
    return pass == 0 or asked;
}

/// The idle count after one more frame, held at RESCAN_FRAMES so it never wraps.
pub fn idle_next(idle: u32) -> u32 {
    if (idle >= RESCAN_FRAMES) { return RESCAN_FRAMES; }
    return idle + 1;
}

/// Whether the checks may go on. A pass already under way always finishes (at_start false). A new pass starts while
/// the walk runs, once after a walk ended since the last check pass ended (walks_done != seen), or while asked.
pub fn checks_due(at_start: bool, walking: bool, walks_done: u64, seen: u64, asked: bool) -> bool {
    if (at_start == false) { return true; }
    return walking or asked or walks_done != seen;
}

/// Whether job j runs on this pass over the list (passes counted from 0): the size jobs only every SIZE_EVERY.
pub fn job_due(j: u32, pass: u32) -> bool {
    if (j >= JOB_COUNT) { return false; }
    if (j == JOB_SIZE or j == JOB_BUILD) { return pass % SIZE_EVERY == 0; }
    return true;
}

/// Whether folders sharing a stem under one parent are "made several times".
pub fn repeated(count: u32) -> bool {
    return count >= REPEAT_MIN;
}

/// Whether one folder of such a group is a copy: its name carries a suffix (t27-2), so it is not the original
/// (t27), which keeps its plain name and is never called made again.
pub fn made_again(count: u32, suffixed: bool) -> bool {
    return suffixed and repeated(count);
}

/// Whether a repository of kb kilobytes is heavy, and whether its build directories are worth naming.
pub fn heavy(kb: u64) -> bool {
    return kb >= HEAVY_MB * 1024;
}

pub fn build_heavy(kb: u64) -> bool {
    return kb >= BUILD_MB * 1024;
}

/// A size in the row: GB with one decimal from 1024 MB up, else whole MB.
pub fn size_in_gb(kb: u64) -> bool {
    return kb >= 1024 * 1024;
}

pub fn size_whole(kb: u64) -> u64 {
    if (size_in_gb(kb)) { return kb / (1024 * 1024); }
    return kb / 1024;
}

pub fn size_tenth(kb: u64) -> u64 {
    if (size_in_gb(kb)) { return kb % (1024 * 1024) * 10 / (1024 * 1024); }
    return 0;
}

/// Why a repository is kept, KEEP_NONE when nothing holds it. Each check must have run and answered: a
/// repository whose status or unpushed check has not come back yet is kept as "checking".
pub fn keep_reason(flags: u32) -> u32 {
    if (has(flags, F_CHECKED) == false or has(flags, F_PUSH_CHECKED) == false) { return KEEP_UNCHECKED; }
    if (has(flags, F_DIRTY)) { return KEEP_DIRTY; }
    if (has(flags, F_UNPUSHED)) { return KEEP_UNPUSHED; }
    if (has(flags, F_STASH)) { return KEEP_STASH; }
    if (has(flags, F_HAS_WORKTREES)) { return KEEP_WORKTREES; }
    if (has(flags, F_NESTS)) { return KEEP_NESTS; }
    if (has(flags, F_NO_REMOTE)) { return KEEP_NO_REMOTE; }
    return KEEP_NONE;
}

/// Whether the DOCTOR calls this repository a leftover: a duplicate clone that is not the keeper, an agent
/// copy, or one of a folder made several times. A space bound in the sidebar is in use, not a leftover.
pub fn leftover(flags: u32) -> bool {
    if (has(flags, F_BOUND)) { return false; }
    return has(flags, F_DUP) or has(flags, DOC_F_AGENT) or has(flags, F_REPEATED);
}

/// Whether a row offers the remove button: a leftover that nothing keeps.
pub fn removable(flags: u32) -> bool {
    return leftover(flags) and keep_reason(flags) == KEEP_NONE;
}

/// The group a repository's row is shown in.
pub fn row_group(flags: u32) -> u32 {
    if (removable(flags)) { return ROW_REMOVABLE; }
    if (leftover(flags)) { return ROW_KEEP; }
    if (has(flags, F_HEAVY) or has(flags, F_BUILD)) { return ROW_INFO; }
    return ROW_CLEAN;
}

/// Duplicates: of the clones of one remote, the keeper is the first that is neither an agent copy nor a
/// worktree, else the first; every other clone is a duplicate. `keeper_rank` orders the candidates (lower wins,
/// ties go to the first discovered).
pub fn keeper_rank(flags: u32) -> u32 {
    if (has(flags, DOC_F_AGENT) == false and has(flags, F_WORKTREE) == false) { return 0; }
    if (has(flags, DOC_F_AGENT) == false) { return 1; }
    return 2;
}

/// Whether a worktree takes part in duplicate finding: a worktree shares its repository's objects, so it is
/// not a second clone; it is a leftover only when it is an agent copy.
pub fn dup_candidate(flags: u32) -> bool {
    return has(flags, F_WORKTREE) == false and has(flags, F_NO_REMOTE) == false;
}

/// Which slots fill themselves: main clones on their own, worktrees and agent copies only through "+",
/// hidden ones never.
pub fn bind_rank(flags: u32) -> u32 {
    if (has(flags, F_HIDDEN)) { return RANK_NEVER; }
    if (has(flags, DOC_F_AGENT) or has(flags, F_WORKTREE)) { return RANK_PLUS; }
    return RANK_AUTO;
}

/// What a click on row i's button does while row `armed` is armed.
pub fn click_on_row(armed: u32, i: u32, flags: u32) -> u32 {
    if (removable(flags) == false) { return CLICK_DISARM; }
    if (armed == i) { return CLICK_REMOVE; }
    return CLICK_ARM;
}

/// The armed row after a click outcome.
pub fn after_click(outcome: u32, i: u32) -> u32 {
    if (outcome == CLICK_ARM) { return i; }
    return ARMED_NONE;
}

/// How many DOCTOR rows fit under the summary in a panel of height sh below the title bar top t.
pub fn doc_rows(sh: f64, t: f64) -> u32 {
    const room : f64 = sh - t - DOC_ROWS_Y - 8.0;
    if (room < DOC_ROW_H) { return 0; }
    return @as(u32, @intFromFloat(room / DOC_ROW_H));
}

/// Top of DOCTOR row r.
pub fn doc_row_top(t: f64, r: u32) -> f64 {
    return t + DOC_ROWS_Y + @as(f64, @floatFromInt(r)) * DOC_ROW_H;
}

/// Left edge of a row button in a panel whose column starts at l, w wide, with side padding pad.
pub fn doc_btn_x(l: f64, w: f64, pad: f64) -> f64 {
    return l + w - pad - DOC_BTN_W;
}

/// Whether (x, y) is on the button of shown row r.
pub fn on_doc_btn(x: f64, y: f64, l: f64, w: f64, pad: f64, t: f64, r: u32) -> bool {
    const bx : f64 = doc_btn_x(l, w, pad);
    const by : f64 = doc_row_top(t, r) + DOC_BTN_Y;
    return x >= bx and x <= bx + DOC_BTN_W and y >= by and y <= by + DOC_BTN_H;
}

/// Whether (x, y) is on "DOCTOR n" at the right end of the sidebar foot (side_w wide, foot_h tall, window sh).
pub fn on_doc_link(x: f64, y: f64, side_w: f64, sh: f64, foot_h: f64) -> bool {
    return x >= side_w - 14.0 - DOC_LINK_W and x <= side_w - 8.0 and y >= sh - foot_h and y <= sh - 6.0;
}

/// The first row shown after scrolling `off` rows into `total`, kept so the last page stays full.
pub fn doc_scroll(off: i64, total: u32, rows: u32) -> u32 {
    if (off <= 0 or total <= rows) { return 0; }
    const most : u32 = total - rows;
    if (off >= @as(i64, most)) { return most; }
    return @as(u32, @intCast(off));
}

test a_leftover_with_work_in_it_is_never_offered {
    const clean_agent : u32 = F_CHECKED + F_PUSH_CHECKED + DOC_F_AGENT;
    assert removable(clean_agent);
    assert removable(clean_agent + F_DIRTY) == false;
    assert keep_reason(clean_agent + F_DIRTY) == KEEP_DIRTY;
    assert removable(clean_agent + F_UNPUSHED) == false;
    assert keep_reason(clean_agent + F_UNPUSHED) == KEEP_UNPUSHED;
    assert removable(clean_agent + F_STASH) == false;
    assert removable(clean_agent + F_HAS_WORKTREES) == false;
    assert removable(clean_agent + F_NESTS) == false;
    assert removable(clean_agent + F_NO_REMOTE) == false;
    // not checked yet, or only half checked: kept
    assert keep_reason(DOC_F_AGENT) == KEEP_UNCHECKED;
    assert removable(F_CHECKED + DOC_F_AGENT) == false;
    // a clean main clone with nothing left over is not a suggestion
    assert removable(F_CHECKED + F_PUSH_CHECKED) == false;
    // a space in use is not a leftover
    assert removable(clean_agent + F_BOUND) == false;
}

test rows_are_grouped_removable_first {
    const ok : u32 = F_CHECKED + F_PUSH_CHECKED;
    assert row_group(ok + F_DUP) == ROW_REMOVABLE;
    assert row_group(ok + F_DUP + F_DIRTY) == ROW_KEEP;
    assert row_group(ok + F_HEAVY) == ROW_INFO;
    assert row_group(ok) == ROW_CLEAN;
}

test the_keeper_is_a_main_clone {
    assert keeper_rank(0) < keeper_rank(F_WORKTREE);
    assert keeper_rank(F_WORKTREE) < keeper_rank(DOC_F_AGENT);
    assert dup_candidate(F_WORKTREE) == false;
    assert dup_candidate(F_NO_REMOTE) == false;
    assert dup_candidate(DOC_F_AGENT);
}

test two_clicks_remove_one_row {
    const ok : u32 = F_CHECKED + F_PUSH_CHECKED + F_REPEATED;
    assert click_on_row(ARMED_NONE, 3, ok) == CLICK_ARM;
    assert after_click(CLICK_ARM, 3) == 3;
    assert click_on_row(3, 3, ok) == CLICK_REMOVE;
    assert after_click(CLICK_REMOVE, 3) == ARMED_NONE;
    // arming another row moves the arm, it does not remove
    assert click_on_row(3, 5, ok) == CLICK_ARM;
    assert click_on_row(3, 3, ok + F_DIRTY) == CLICK_DISARM;
}

test the_walk_skips_caches_and_stays_shallow {
    assert enters(ROOT_HOME, 1, false, false, false);
    assert enters(ROOT_HOME, 1, true, false, false) == false;
    assert enters(ROOT_HOME, 2, false, true, false) == false;
    assert enters(ROOT_HOME, 2, false, true, true);
    assert enters(ROOT_HOME, DEPTH_HOME + 1, false, false, false) == false;
    assert enters(ROOT_TMP, DEPTH_TMP + 1, false, false, false) == false;
    assert job_due(JOB_STATUS, 3);
    assert job_due(JOB_SIZE, 3) == false;
    assert job_due(JOB_SIZE, 4);
    assert pass_due(RESCAN_FRAMES);
    assert pass_due(RESCAN_FRAMES - 1) == false;
    // no timer: after the launch pass a new walk needs the DOCTOR open
    assert rescan_due(RESCAN_FRAMES, 0, false);
    assert rescan_due(RESCAN_FRAMES, 1, false) == false;
    assert rescan_due(RESCAN_FRAMES, 7, true);
    assert rescan_due(RESCAN_FRAMES - 1, 7, true) == false;
    assert idle_next(RESCAN_FRAMES) == RESCAN_FRAMES;
    assert idle_next(3) == 4;
    // the checks finish a pass under way, run beside a walk, once after a walk ends, and when asked
    assert checks_due(false, false, 1, 1, false);
    assert checks_due(true, true, 1, 1, false);
    assert checks_due(true, false, 2, 1, false);
    assert checks_due(true, false, 2, 2, false) == false;
    assert checks_due(true, false, 2, 2, true);
    // a deleted repository vanishes within VANISH_FRAMES: one .git re-check a frame over LIST_MAX
    assert LIST_MAX <= VANISH_FRAMES;
}

test sizes_read_in_mb_then_gb {
    assert size_in_gb(1023 * 1024) == false;
    assert size_whole(1023 * 1024) == 1023;
    assert size_in_gb(1024 * 1024);
    assert size_whole(1536 * 1024) == 1;
    assert size_tenth(1536 * 1024) == 5;
    assert heavy(HEAVY_MB * 1024);
    assert heavy(HEAVY_MB * 1024 - 1) == false;
    assert build_heavy(BUILD_MB * 1024);
}

test flags_and_words_line_up {
    assert with_flag(0, F_DUP, true) == F_DUP;
    assert with_flag(F_DUP, F_DUP, true) == F_DUP;
    assert with_flag(F_DUP, F_DUP, false) == 0;
    assert shows_word(F_DUP, 3);
    assert shows_word(F_CHECKED, 0) == false;
    assert shows_word(F_BOUND, 14) == false;
    assert shows_word(F_HIDDEN, 15);
    assert repeated(REPEAT_MIN);
    assert repeated(REPEAT_MIN - 1) == false;
    assert bind_rank(0) == RANK_AUTO;
    assert bind_rank(F_WORKTREE) == RANK_PLUS;
    assert bind_rank(F_HIDDEN) == RANK_NEVER;
}

test doctor_rows_fit_the_window {
    // a 540 pt window under the 35 pt workspace top holds eight rows of three lines
    assert doc_rows(540.0, 35.0) == 8;
    assert doc_row_top(35.0, 0) == 35.0 + DOC_ROWS_Y;
    assert doc_scroll(0 - 3, 40, 10) == 0;
    assert doc_scroll(5, 40, 10) == 5;
    assert doc_scroll(99, 40, 10) == 30;
    assert doc_scroll(5, 8, 10) == 0;
}

test the_buttons_are_where_they_are_drawn {
    // the Queen column of a 960 pt window: left 660, 300 wide, padding 16
    assert doc_btn_x(660.0, 300.0, 16.0) == 960.0 - 16.0 - DOC_BTN_W;
    assert on_doc_btn(900.0, doc_row_top(35.0, 2) + DOC_BTN_Y + 5.0, 660.0, 300.0, 16.0, 35.0, 2);
    assert on_doc_btn(900.0, doc_row_top(35.0, 2) + 2.0, 660.0, 300.0, 16.0, 35.0, 2) == false;
    assert on_doc_btn(700.0, doc_row_top(35.0, 2) + DOC_BTN_Y + 5.0, 660.0, 300.0, 16.0, 35.0, 2) == false;
    // the foot link and OPEN SOURCE T27 (14 .. under 134) do not overlap
    assert on_doc_link(240.0, 520.0, 272.0, 540.0, 34.0);
    assert on_doc_link(140.0, 520.0, 272.0, 540.0, 34.0) == false;
    assert made_again(REPEAT_MIN, true);
    assert made_again(REPEAT_MIN, false) == false;
}

test a_flag_is_read_by_its_own_bit_only {
    assert has(0, F_CHECKED) == false;
    assert has(F_CHECKED, F_CHECKED);
    assert has(F_CHECKED, F_WORKTREE) == false;
    assert has(F_CHECKED + F_DUP, F_DUP);
    assert has(F_CHECKED + F_DUP, DOC_F_AGENT) == false;
    assert has(F_HIDDEN, F_HIDDEN);
    assert has(F_HIDDEN - 1, F_HIDDEN) == false;
    assert has(F_HIDDEN + F_CHECKED, F_BOUND) == false;
    assert has(65535, F_BOUND);
}

test the_walk_goes_five_deep_in_home_and_three_in_tmp_and_ends_with_an_empty_queue {
    assert root_depth(ROOT_HOME) == 5;
    assert root_depth(ROOT_TMP) == 3;
    assert root_depth(ROOT_COUNT) == DEPTH_HOME;
    assert root_depth(99) == DEPTH_HOME;
    assert pass_done(0);
    assert pass_done(1) == false;
    assert pass_done(4294967295) == false;
}

test a_leftover_is_a_duplicate_an_agent_copy_or_a_repeat_and_never_a_bound_space {
    assert leftover(0) == false;
    assert leftover(F_CHECKED + F_PUSH_CHECKED) == false;
    assert leftover(F_DUP);
    assert leftover(DOC_F_AGENT);
    assert leftover(F_REPEATED);
    assert leftover(F_DUP + DOC_F_AGENT + F_REPEATED);
    assert leftover(F_WORKTREE + F_HEAVY + F_BUILD + F_DIRTY) == false;
    assert leftover(F_DUP + F_BOUND) == false;
    assert leftover(DOC_F_AGENT + F_BOUND) == false;
    assert leftover(F_REPEATED + F_BOUND) == false;
    assert leftover(F_BOUND) == false;
}
