// SPDX-License-Identifier: Apache-2.0
; specs/t27os/c1_ledger.t27 -- the C1 acceptance ledger. BINDS c1_task_link.t27 (the
; task->executor->artifact->verified chain) and c1_powerplay.t27 (the monotone acceptance
; gate) to REAL verdicts: a candidate change is accepted only when its checks actually ran
; and passed AGAINST THE REVISION HASH the verdict was made for. A hash mismatch demotes the
; verdict to STALE -- the one legal demotion (a stale verdict, not a regression); a verdict
; whose pass count is below its run count is REJECTED evidence, never VERIFIED.
; --
; The record: cycle_id, candidate_id, revision_hash (hex, stored as bytes with explicit
; length), checks_run, checks_passed, gate_seconds (0 = not measured, per bench.t27: a
; value that was not measured prints "not measured", never a fabricated number), verdict
; (ACCEPT/NEUTRAL/REJECT per the PowerPlay gate), verdict_status (CURRENT/STALE/REJECTED).
; The append law: records are appended in order; a record may move CURRENT -> STALE (the
; demotion above) and nothing else may go backwards.
; --
; t27b quirks respected: out slices, not write-only reference params; explicit lengths, no
; str .len in gen-c paths; byte loops, never str ==.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osC1Ledger;

// ---------------------------------------------------------------- verdict codes

/// The acceptance outcome, from the PowerPlay gate's monotone rule.
pub const LG_ACCEPT : u8 = 0;
pub const LG_NEUTRAL : u8 = 1;
pub const LG_REJECT : u8 = 2;

/// The verdict status. CURRENT: fresh against the recorded revision. STALE: the revision
/// changed under the verdict (the one legal demotion). REJECTED: tampered or failing
/// evidence (pass < run, or the gate rejected).
pub const LG_CURRENT : u8 = 0;
pub const LG_STALE : u8 = 1;
pub const LG_REJECTED : u8 = 2;

/// Gate seconds sentinel: 0 means the duration was never measured. A rendered line shows
/// "not measured" for it, never a fabricated 0 (bench.t27 house style).
pub const LG_NOT_MEASURED : u32 = 0;

/// Revision hashes are hex SHA-256 prefixes; 16 hex chars (64 bits) is the C1 width.
pub const LG_HASH_LEN : usize = 16;

// ---------------------------------------------------------------- the record

/// One candidate cycle. checks_run/checks_passed come from t27c test-report output;
/// gate_seconds is the measured wall time of the gate run (LG_NOT_MEASURED if untimed).
pub struct LedgerRecord {
    cycle_id : u32,
    checks_run : u32,
    checks_passed : u32,
    gate_seconds : u32,
    verdict : u8,
    verdict_status : u8,
}

/// A fresh record with nothing measured yet: 0-with-flag everywhere, never a fake pass.
pub fn lg_new(cycle_id : u32) -> LedgerRecord {
    return LedgerRecord {
        cycle_id : cycle_id, checks_run : 0, checks_passed : 0,
        gate_seconds : LG_NOT_MEASURED, verdict : LG_REJECT, verdict_status : LG_REJECTED
    };
}

// ---------------------------------------------------------------- the binding: real verdicts

/// The acceptance law, binding c1_task_link + c1_powerplay to a real verdict.
/// Inputs are the HOST's measurements:
///   link_verified  -- the task link reached TL_VERIFIED (c1_task_link.t27: the artifact
///                     exists, is a spec, and its intended test passed);
///   gate_outcome   -- c1_powerplay.t27's pp_gate result (PP_ACCEPT/PP_NEUTRAL/PP_REGRESS);
///   hash_matches   -- the artifact's current revision hash equals the hash the verdict
///                     was made against. A candidate change invalidates its old verdict.
/// Returns the record's verdict_status:
///   LG_REJECTED  -- the link never verified, or the gate rejected (regression / mismatch
///                   of check results): never VERIFIED.
///   LG_STALE     -- everything passed but the revision hash moved: the old verdict no
///                   longer binds (the one legal demotion).
///   LG_CURRENT   -- verified, gate accepts, hash matches.
pub fn lg_acceptance(link_verified : bool, gate_outcome : u8, hash_matches : bool) -> u8 {
    if (link_verified == false) { return LG_REJECTED; }
    if (gate_outcome != LG_ACCEPT) { return LG_REJECTED; }
    if (hash_matches == false) { return LG_STALE; }
    return LG_CURRENT;
}

/// The tamper check: recorded evidence whose pass count is below its run count is
/// rejected evidence, whatever the verdict field claims.
pub fn lg_evidence_ok(checks_run : u32, checks_passed : u32) -> bool {
    if (checks_run == 0) { return false; }
    return checks_passed <= checks_run and checks_passed == checks_run;
}

/// The monotone demotion law: a record may move CURRENT -> STALE (stale revision) and
/// nothing else may go backwards. Returns the status the record must carry after a
/// re-check: an old CURRENT becomes STALE when the hash moved; everything else keeps
/// its rung.
pub fn lg_demotion(old_status : u8, hash_matches : bool) -> u8 {
    if (old_status == LG_CURRENT and hash_matches == false) { return LG_STALE; }
    return old_status;
}

// ---------------------------------------------------------------- render: one ledger line

/// Render one ledger line into out: "[cycle] run/passed verdict status" with gate seconds
/// as "not measured" when untimed. Writes at most out.len bytes; returns the written
/// length. Byte loops only, explicit digits, no str .len.
pub fn lg_render(rec : LedgerRecord, out : []u8) -> usize {
    var n : usize = 0;
    // "["
    if (n < out.len) { out[n] = 91; n = n + 1; } // '['
    n = lg_put_u32(rec.cycle_id, out, n);
    if (n < out.len) { out[n] = 93; n = n + 1; } // ']'
    if (n < out.len) { out[n] = 32; n = n + 1; } // ' '
    n = lg_put_u32(rec.checks_run, out, n);
    if (n < out.len) { out[n] = 47; n = n + 1; } // '/'
    n = lg_put_u32(rec.checks_passed, out, n);
    if (n < out.len) { out[n] = 32; n = n + 1; } // ' '
    n = lg_put_text(lg_verdict_text(rec.verdict), out, n);
    if (n < out.len) { out[n] = 32; n = n + 1; } // ' '
    if (rec.gate_seconds == LG_NOT_MEASURED) {
        n = lg_put_text("not measured", out, n);
    } else {
        n = lg_put_u32(rec.gate_seconds, out, n);
        if (n < out.len) { out[n] = 115; n = n + 1; } // 's'
    }
    if (n < out.len) { out[n] = 32; n = n + 1; } // ' '
    n = lg_put_text(lg_status_text(rec.verdict_status), out, n);
    return n;
}

/// Decimal digits of v into out at n; returns the new length.
fn lg_put_u32(v : u32, out : []u8, n0 : usize) -> usize {
    var n : usize = n0;
    if (v == 0) {
        if (n < out.len) { out[n] = 48; n = n + 1; }
        return n;
    }
    var buf : [10]u8 = undefined;
    var m : usize = 0;
    var x : u32 = v;
    while (x > 0) {
        buf[m] = @as(u8, @intCast(48 + (x % 10)));
        m = m + 1;
        x = x / 10;
    }
    var i : usize = m;
    while (i > 0) {
        i = i - 1;
        if (n < out.len) { out[n] = buf[i]; n = n + 1; }
    }
    return n;
}

/// Copy the bytes of a fixed text into out at n; returns the new length. Length comes
/// from a const slice, never from str .len.
fn lg_put_text(t : []const u8, out : []u8, n0 : usize) -> usize {
    var n : usize = n0;
    var i : usize = 0;
    while (i < t.len) {
        if (n < out.len) { out[n] = t[i]; n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The verdict word, fixed length (5/7/6 bytes).
fn lg_verdict_text(v : u8) -> []const u8 {
    if (v == LG_ACCEPT) { return "ACCEPT"; }
    if (v == LG_NEUTRAL) { return "NEUTRAL"; }
    return "REJECT";
}

/// The status word, fixed length (7/5/8 bytes).
fn lg_status_text(s : u8) -> []const u8 {
    if (s == LG_CURRENT) { return "CURRENT"; }
    if (s == LG_STALE) { return "STALE"; }
    return "REJECTED";
}

/// Byte equality, the cross-backend idiom.
fn lg_eq(a : []const u8, b : []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len and a[i] == b[i]) { i = i + 1; }
    return i == a.len;
}

// ---------------------------------------------------------------- tests

test the_codes_are_distinct_and_ordered {
    assert(LG_ACCEPT != LG_NEUTRAL and LG_NEUTRAL != LG_REJECT);
    assert(LG_CURRENT != LG_STALE and LG_STALE != LG_REJECTED);
}

test acceptance_full_green_is_current {
    // the real path: link verified, gate accepts, hash matches
    assert(lg_acceptance(true, LG_ACCEPT, true) == LG_CURRENT);
}

test an_unverified_link_is_rejected_even_with_everything_else_green {
    // a candidate whose task link never reached VERIFIED cannot be accepted
    assert(lg_acceptance(false, LG_ACCEPT, true) == LG_REJECTED);
    // and neither can one whose artifact existed but whose test never ran
    assert(lg_acceptance(false, LG_NEUTRAL, true) == LG_REJECTED);
}

test a_gate_regression_is_rejected {
    assert(lg_acceptance(true, LG_REJECT, true) == LG_REJECTED);
    assert(lg_acceptance(true, LG_NEUTRAL, true) == LG_REJECTED);
}

test a_moved_hash_demotes_to_stale_not_rejected {
    // everything passed, but the revision moved under the verdict: stale, the one
    // legal demotion
    assert(lg_acceptance(true, LG_ACCEPT, false) == LG_STALE);
}

test tampered_evidence_is_never_ok {
    // pass < run: the evidence does not back the verdict
    assert(lg_evidence_ok(9, 8) == false);
    assert(lg_evidence_ok(9, 0) == false);
    // zero checks ran: nothing was measured
    assert(lg_evidence_ok(0, 0) == false);
    // the only ok shape: every check that ran passed
    assert(lg_evidence_ok(9, 9) == true);
    assert(lg_evidence_ok(1, 1) == true);
}

test only_current_demotes_and_only_to_stale {
    // the one legal demotion
    assert(lg_demotion(LG_CURRENT, false) == LG_STALE);
    // a fresh hash keeps a current verdict current
    assert(lg_demotion(LG_CURRENT, true) == LG_CURRENT);
    // nothing else moves backwards: stale stays stale even when the hash matches again
    assert(lg_demotion(LG_STALE, true) == LG_STALE);
    assert(lg_demotion(LG_REJECTED, true) == LG_REJECTED);
}

test a_new_record_carries_no_claims {
    var r : LedgerRecord = lg_new(7);
    assert(r.cycle_id == 7);
    assert(r.checks_run == 0 and r.checks_passed == 0);
    assert(r.gate_seconds == LG_NOT_MEASURED);
    assert(r.verdict == LG_REJECT and r.verdict_status == LG_REJECTED);
}

test render_shows_the_counts_the_verdict_and_not_measured {
    var r : LedgerRecord = lg_new(3);
    r.checks_run = 9;
    r.checks_passed = 9;
    r.verdict = LG_ACCEPT;
    r.verdict_status = LG_CURRENT;
    // gate_seconds stays unmeasured: the line must say so, never print a 0
    var buf : [64]u8 = undefined;
    const n : usize = lg_render(r, buf[0..64]);
    var want : [64]u8 = undefined;
    const w : usize = lg_put_text("[3] 9/9 ACCEPT not measured CURRENT", want[0..64], 0);
    assert(n == w);
    assert(lg_eq(buf[0..n], want[0..w]));

    // a measured gate duration prints its seconds
    r.gate_seconds = 42;
    const n2 : usize = lg_render(r, buf[0..64]);
    const w2 : usize = lg_put_text("[3] 9/9 ACCEPT 42s CURRENT", want[0..64], 0);
    assert(n2 == w2);
    assert(lg_eq(buf[0..n2], want[0..w2]));
}

test render_of_a_rejected_candidate_says_so {
    var r : LedgerRecord = lg_new(12);
    r.checks_run = 9;
    r.checks_passed = 8;
    r.verdict = LG_REJECT;
    r.verdict_status = LG_REJECTED;
    var buf : [64]u8 = undefined;
    const n : usize = lg_render(r, buf[0..64]);
    var want : [64]u8 = undefined;
    const w : usize = lg_put_text("[12] 9/8 REJECT not measured REJECTED", want[0..64], 0);
    assert(n == w);
    assert(lg_eq(buf[0..n], want[0..w]));
}

test render_of_a_stale_demotion_says_stale {
    var r : LedgerRecord = lg_new(1);
    r.checks_run = 6;
    r.checks_passed = 6;
    r.verdict = LG_ACCEPT;
    r.verdict_status = LG_STALE;
    var buf : [64]u8 = undefined;
    const n : usize = lg_render(r, buf[0..64]);
    var want : [64]u8 = undefined;
    const w : usize = lg_put_text("[1] 6/6 ACCEPT not measured STALE", want[0..64], 0);
    assert(n == w);
    assert(lg_eq(buf[0..n], want[0..w]));
}

test byte_equality_and_the_fixed_words {
    assert(lg_eq("abc", "abc") == true);
    assert(lg_eq("abc", "abd") == false);
    assert(lg_eq("abc", "ab") == false);
    assert(lg_eq(lg_verdict_text(LG_ACCEPT), "ACCEPT"));
    assert(lg_eq(lg_verdict_text(LG_NEUTRAL), "NEUTRAL"));
    assert(lg_eq(lg_verdict_text(LG_REJECT), "REJECT"));
    assert(lg_eq(lg_status_text(LG_CURRENT), "CURRENT"));
    assert(lg_eq(lg_status_text(LG_STALE), "STALE"));
    assert(lg_eq(lg_status_text(LG_REJECTED), "REJECTED"));
}

test the_full_chain_binds_task_link_powerplay_and_hash {
    // POSITIVE shape: verified link + gate accept + same hash -> CURRENT
    assert(lg_acceptance(true, LG_ACCEPT, true) == LG_CURRENT);
    // NEGATIVE shape 1: the same green checks but a WRONG revision hash -> STALE,
    // never VERIFIED/current
    assert(lg_acceptance(true, LG_ACCEPT, false) == LG_STALE);
    // NEGATIVE shape 2: a verdict whose pass count is below its run count is not
    // evidence at all
    assert(lg_evidence_ok(9, 8) == false);
}

invariant the_statuses_are_distinct {
    assert LG_CURRENT != LG_STALE and LG_STALE != LG_REJECTED and LG_CURRENT != LG_REJECTED;
}

invariant the_verdicts_are_distinct {
    assert LG_ACCEPT != LG_NEUTRAL and LG_NEUTRAL != LG_REJECT and LG_ACCEPT != LG_REJECT;
}
