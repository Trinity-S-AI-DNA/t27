// Public interface candidates only. No STUN, DNS, account or outgoing datagrams.
// Darwin layouts follow the prior cn6_own donor and the installed SDK.
use t27os::call_core::ck_wipe;
use t27os::call_core::ck_same;
use t27os::call_core::get_u64;
use t27os::call_ip6::ip6_own_rank;
use t27os::call_ip6::ip6_mapped;
use t27os::call_ip6::ip6_from_ok;
const DC_MAX:usize=8;
const DC_EP:usize=18;
pub const DC_BYTES:usize=145;
pub fn dc_getifaddrs(out:[]u8)->i32 {
    return @extern("getifaddrs");
}
pub fn dc_freeifaddrs(p:u64)->void {
    @extern("freeifaddrs");
}
pub fn dc_peek(out:[]u8,p:u64,n:u64)->u64 {
    return @extern("memmove");
}
pub fn dc_socket(a:i32,b:i32,c:i32)->i32 {
    return @extern("socket");
}
pub fn dc_close(fd:i32)->i32 {
    return @extern("close");
}
pub fn dc_ioctl(fd:i32,request:u64,arg:[]u8)->i32 {
    return @extern("__ioctl");
}
pub fn dc_endpoint_allowed(ep:[]const u8,qa_loopback:bool)->bool {
    if(ep.len!=DC_EP or (ep[16]==0 and ep[17]==0) or !ip6_from_ok(ep,qa_loopback)) {
        return false;
    }
    if(ip6_mapped(ep)) {
        // Reject unspecified, link-local/metadata, multicast and broadcast.
        if(ep[12]==0 or ep[12]==169 or ep[12]>=224) {
            return false;
        }
        if(ep[12]==127 and !qa_loopback) {
            return false;
        }
    }
    return true;
}
pub fn dc_valid(body:[]const u8,qa_loopback:bool)->bool {
    if(body.len<1 or body[0]>DC_MAX or body.len!=1+@as(usize,body[0])*DC_EP) {
        return false;
    }
    var i:usize=0;
    while(i<@as(usize,body[0])) {
        const at:usize=1+i*DC_EP;
        if(!dc_endpoint_allowed(body[at..at+DC_EP],qa_loopback)) {
            return false;
        }
        var j:usize=0;
        while(j<i) {
            const before:usize=1+j*DC_EP;
            if(ck_same(body[at..at+DC_EP],body[before..before+DC_EP])) {
                return false;
            }
            j=j+1;
        }
        i=i+1;
    }
    return true;
}
pub fn dc_add(out:[]u8,ep:[]const u8)->bool {
    if(out.len<DC_BYTES or !dc_endpoint_allowed(ep,false) or out[0]>=DC_MAX) {
        return false;
    }
    var i:usize=0;
    while(i<@as(usize,out[0])) {
        const at:usize=1+i*DC_EP;
        if(ck_same(out[at..at+DC_EP],ep)) {
            return false;
        }
        i=i+1;
    }
    const at:usize=1+@as(usize,out[0])*DC_EP;
    i=0;
    while(i<DC_EP) {
        out[at+i]=ep[i];
        i=i+1;
    }
    out[0]=out[0]+1;
    return true;
}
/// Returns an explicit-length signed-advertisement body (count then endpoints).
pub fn dc_gather(port:u64,out:[]u8)->usize {
    if(out.len<DC_BYTES or port==0 or port>65535) {
        return 0;
    }
    ck_wipe(out[0..DC_BYTES]);
    var head:[8]u8=undefined;
    ck_wipe(head[0..8]);
    if(dc_getifaddrs(head[0..8])!=0) {
        return 1;
    }
    const first:u64=get_u64(head[0..8],0);
    var p:u64=first;
    var count:u32=0;
    const fd:i32=dc_socket(30,2,0);
    while(p!=0 and count<256) {
        var row:[32]u8=undefined;
        dc_peek(row[0..32],p,32);
        const address:u64=get_u64(row[0..32],24);
        const flags:u64=get_u64(row[0..32],16)&4294967295;
        const name:u64=get_u64(row[0..32],8);
        var label:[16]u8=undefined;
        ck_wipe(label[0..16]);
        var k:usize=0;
        while(name!=0 and k<15) {
            dc_peek(label[k..k+1],name+@as(u64,k),1);
            if(label[k]==0) {
                break;
            }
            k=k+1;
        }
        // Physical Ethernet/Wi-Fi interfaces; never utun, bridge or P2P services.
        const physical:bool=label[0]==101 and label[1]==110 and label[2]>=48 and label[2]<=57;
        if(address!=0 and physical and (flags&65)==65 and (flags&24)==0) {
            var sa:[28]u8=undefined;
            ck_wipe(sa[0..28]);
            dc_peek(sa[0..2],address,2);
            var ep:[18]u8=undefined;
            ck_wipe(ep[0..18]);
            ep[16]=@as(u8,@intCast(port/256));
            ep[17]=@as(u8,@intCast(port%256));
            if(sa[1]==2 and sa[0]>=16) {
                dc_peek(sa[0..16],address,16);
                ep[10]=255;
                ep[11]=255;
                k=0;
                while(k<4) {
                    ep[12+k]=sa[4+k];
                    k=k+1;
                }
                dc_add(out,ep[0..18]);
            }
            if(sa[1]==30 and sa[0]>=28 and fd>=0) {
                dc_peek(sa[0..28],address,28);
                var request:[288]u8=undefined;
                ck_wipe(request[0..288]);
                k=0;
                while(k<16) {
                    request[k]=label[k];
                    k=k+1;
                }
                k=0;
                while(k<28) {
                    request[16+k]=sa[k];
                    k=k+1;
                }
                if(dc_ioctl(fd,3240126793,request[0..288])==0 and ip6_own_rank(sa[8..24],get_u64(request[0..288],16)&4294967295,flags)>0) {
                    k=0;
                    while(k<16) {
                        ep[k]=sa[8+k];
                        k=k+1;
                    }
                    dc_add(out,ep[0..18]);
                }
            }
        }
        p=get_u64(row[0..32],0);
        count=count+1;
    }
    if(fd>=0) {
        dc_close(fd);
    }
    dc_freeifaddrs(first);
    return 1+@as(usize,out[0])*DC_EP;
}
test candidate_lists_reject_metadata_zero_ports_and_duplicate_endpoints {
    var body:[37]u8=undefined;
    ck_wipe(body[0..37]);
    body[0]=1;
    body[11]=255;
    body[12]=255;
    body[13]=192;
    body[14]=168;
    body[15]=1;
    body[16]=25;
    body[17]=194;
    body[18]=237;
    assert dc_valid(body[0..19],false);
    body[13]=169;
    body[14]=254;
    assert !dc_valid(body[0..19],false);
    body[13]=127;
    body[14]=0;
    body[15]=0;
    body[16]=1;
    assert !dc_valid(body[0..19],false) and dc_valid(body[0..19],true);
    body[13]=192;
    body[14]=168;
    body[15]=1;
    body[16]=25;
    body[0]=2;
    var i:usize=0;
    while(i<18) {
        body[19+i]=body[1+i];
        i=i+1;
    }
    assert !dc_valid(body[0..37],false);
    body[0]=1;
    body[17]=0;
    body[18]=0;
    assert !dc_valid(body[0..19],false);
}
