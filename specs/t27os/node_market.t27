// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_market.t27 -- the CONSENTING node market (owner brief 2026-10-27,
// issue t27#NNNNN): how a machine joins the $TRI economy, what it may contribute,
// and what it is paid for.
// --
// THE CONSENT LAWS, IN ORDER OF AUTHORITY. They are the point of this file; every
// function below is one of them made checkable.
//   1. A node joins ONLY by its owner's enrollment: the owner runs the installer,
//      the owner declares the node's inventory. The market never reads a machine
//      it was not installed on, and never discovers hardware, files or keys by
//      scanning. Inventory is DECLARED, never SCANNED.
//   2. An API key is contributed ONLY by the owner typing it into the node's own
//      config, with a daily spend cap in milli-USD the owner sets. The market
//      stores a 32-hex fingerprint (sha256 prefix), never the secret; a key
//      whose cap is spent refuses mid-job (fail closed, never overdraws).
//   3. Work dispatches only with a 32-hex challenge and at least one spec --
//      specs/tri/lab/dispatch.t27's rule, imported here, never restated.
//   4. A node is paid in mTRI ONLY for work a verified receipt proves
//      (specs/tri/lab/receipt.t27's verdict; specs/t27os/settle_bridge.t27
//      settles past its four refusals). No receipt pays ZERO; a disputed
//      receipt pays ZERO; there is no partial credit.
//   5. The market's own daily budget caps the total mTRI minted per day.
// --
// NOT CLAIMED: no rate is invented here -- RATE_MTRI_PER_VERIFIED_JOB mirrors
// specs/trinet/ledger.t27's REWARD_PER_JOB_MTRI and the settle path is
// settle_bridge.t27's, imported by reference. This file decides enrollment,
// contribution caps and the fail-closed payout shape; nothing moves money.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeMarket;

use tri::lab::dispatch::challenge_ok;

// -- enrollment and contribution limits (consent law 1 and 2) --
pub const MAX_CONTRIBUTED_KEYS : usize = 8;
pub const DEFAULT_KEY_CAP_MUSD : u32 = 500;
pub const MAX_KEY_CAP_MUSD : u32 = 100000;

// -- the money shape (consent laws 4 and 5) --
pub const RATE_MTRI_PER_VERIFIED_JOB : u32 = 1;
pub const DAILY_MARKET_BUDGET_MTRI : u32 = 1000;
pub const CHALLENGE_HEX : usize = 32;

// -- enrollment verdicts, in decision order --
pub const EN_OK : u8 = 0;
pub const EN_REFUSE_TOO_MANY_KEYS : u8 = 1;
pub const EN_REFUSE_ZERO_CAP : u8 = 2;

/// A key's owner-set daily cap must be positive and inside the market ceiling.
pub fn key_cap_ok(cap_musd : u32) -> bool {
    return cap_musd > 0 and cap_musd <= MAX_KEY_CAP_MUSD;
}

/// Enrollment verdict. Zero contributed keys is a VALID node (compute only);
/// one key too many refuses; one key without a positive cap refuses.
pub fn enroll_ok(key_count : usize, all_caps_valid : bool) -> u8 {
    if (key_count > MAX_CONTRIBUTED_KEYS) { return EN_REFUSE_TOO_MANY_KEYS; }
    if (key_count > 0 and all_caps_valid == false) { return EN_REFUSE_ZERO_CAP; }
    return EN_OK;
}

/// A key may start work only under its cap; the cap refuses mid-job too
/// (fail closed: an overdraw is never amortized over the job).
pub fn key_spend_ok(spent_musd : u32, cap_musd : u32) -> bool {
    return spent_musd < cap_musd;
}

/// A job dispatches only with a 32-hex challenge (dispatch.t27's rule,
/// imported) and at least one spec -- a dispatch without specs verifies nothing.
pub fn job_dispatch_ok(challenge : []const u8, spec_count : usize) -> bool {
    if (challenge_ok(challenge) == false) { return false; }
    return spec_count > 0;
}

/// Payout fails closed: no verified receipt, no mTRI. Verified work pays
/// units x RATE. There is no partial credit and no advance.
pub fn payout_mtri(receipt_verified : bool, units : u32) -> u32 {
    if (receipt_verified == false) { return 0; }
    return units * RATE_MTRI_PER_VERIFIED_JOB;
}

/// The day is closed for new jobs once the budget is spent.
pub fn budget_ok(minted_today_mtri : u32) -> bool {
    return minted_today_mtri < DAILY_MARKET_BUDGET_MTRI;
}

test consent_consts_hold {
    var maxk : usize = MAX_CONTRIBUTED_KEYS;
    var defcap : u32 = DEFAULT_KEY_CAP_MUSD;
    var maxcap : u32 = MAX_KEY_CAP_MUSD;
    var rate : u32 = RATE_MTRI_PER_VERIFIED_JOB;
    var budget : u32 = DAILY_MARKET_BUDGET_MTRI;
    var chex : usize = CHALLENGE_HEX;
    var want_maxk : usize = 8;
    var want_defcap : u32 = 500;
    var want_maxcap : u32 = 100000;
    var want_rate : u32 = 1;
    var want_budget : u32 = 1000;
    var want_chex : usize = 32;
    assert maxk == want_maxk;
    assert defcap == want_defcap;
    assert maxcap == want_maxcap;
    assert rate == want_rate;
    assert budget == want_budget;
    assert chex == want_chex;
}

test payout_fails_closed_without_a_verified_receipt {
    assert payout_mtri(false, 10) == 0;
    assert payout_mtri(false, 0) == 0;
    assert payout_mtri(true, 10) == 10;
    assert payout_mtri(true, 0) == 0;
    assert payout_mtri(true, 7) == 7;
}

test enrollment_refuses_in_decision_order {
    assert enroll_ok(0, true) == EN_OK;
    assert enroll_ok(0, false) == EN_OK;
    assert enroll_ok(1, true) == EN_OK;
    assert enroll_ok(8, true) == EN_OK;
    assert enroll_ok(9, true) == EN_REFUSE_TOO_MANY_KEYS;
    assert enroll_ok(2, false) == EN_REFUSE_ZERO_CAP;
}

test key_caps_fail_closed {
    assert key_cap_ok(0) == false;
    assert key_cap_ok(1) == true;
    assert key_cap_ok(500) == true;
    assert key_cap_ok(100001) == false;
    assert key_spend_ok(0, 500) == true;
    assert key_spend_ok(499, 500) == true;
    assert key_spend_ok(500, 500) == false;
    assert key_spend_ok(501, 500) == false;
}

test dispatch_fails_closed {
    assert job_dispatch_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 1) == true;
    assert job_dispatch_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 0) == false;
    assert job_dispatch_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d", 1) == false;
    assert job_dispatch_ok("A1B2C3D4A1B2C3D4A1B2C3D4A1B2C3D4", 1) == false;
    assert job_dispatch_ok("", 1) == false;
}

test the_daily_budget_closes_the_day {
    assert budget_ok(0) == true;
    assert budget_ok(999) == true;
    assert budget_ok(1000) == false;
    assert budget_ok(1001) == false;
}
