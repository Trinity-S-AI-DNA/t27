// SPDX-License-Identifier: Apache-2.0
; specs/t27os/frame_gate.t27 -- when the T27 OS window draws a frame, and how long it sleeps between frames.
; Audit, 2026-10-19 (epic #10782): the window drew the whole screen and handed a new image to its layer 30
; times a second even when nothing on it moved. The loop now folds what the frame shows into one key and
; skips the draw when the key is the one already on screen; it still draws while something animates, and
; once every FG_FORCE frames so a change the key does not see (a reloaded store, a doctor scan) shows up
; within half a second. When nothing has moved for FG_QUIET frames and no terminal pane is live, it waits
; FG_IDLE_S for the next event instead of FRAME_S. A live pane keeps the short wait: its bytes come from a
; socket, not from an event, so a long wait would hold its output back.

module T27osFrameGate;

/// Frames between forced draws while the key stands still (0.5 s at 30 fps).
pub const FG_FORCE : u32 = 15;
/// Frames without a draw after which the loop counts as idle (1 s at 30 fps).
pub const FG_QUIET : u32 = 30;
/// The event wait while idle, in seconds.
pub const FG_IDLE_S : f64 = 0.5;

/// Fold one value into the key: rotate left by 7 (constant shifts only), then xor.
pub fn fg_mix(h: u64, v: u64) -> u64 {
    return ((h << 7) | (h >> 57)) ^ v;
}

/// A flag as a key part.
pub fn fg_flag(b: bool) -> u64 {
    if (b) { return 1; }
    return 0;
}

/// A fraction in [0, 1] (an animation level) as an integer the key can hold, to 1/4096.
pub fn fg_level(x: f64) -> u64 {
    if (x <= 0.0) { return 0; }
    if (x >= 1.0) { return 4096; }
    return @as(u64, @intFromFloat(x * 4096.0));
}

/// A point coordinate as the cell it falls in: hover only changes what is drawn at cell granularity.
pub fn fg_cell(p: f64) -> u64 {
    if (p <= 0.0) { return 0; }
    return @as(u64, @intFromFloat(p / 4.0));
}

/// The mouse as a key part: its cell inside the scene, one fixed value outside it, so a pointer moving
/// over other apps does not count as a change to this window.
pub const FG_AWAY : u64 = 99999;
pub fn fg_mouse(p: f64, size: f64) -> u64 {
    if (p < 0.0 or p > size) { return FG_AWAY; }
    return fg_cell(p);
}

/// Draw this frame? When the key changed, while something animates, or when FG_FORCE frames went undrawn.
pub fn fg_draw_due(key: u64, shown: u64, animating: bool, since: u32) -> bool {
    return key != shown or animating or since >= FG_FORCE;
}

/// Frames since the last draw, after this frame.
pub fn fg_since(since: u32, drew: bool) -> u32 {
    if (drew) { return 0; }
    if (since >= 9999) { return since; }
    return since + 1;
}

/// Frames without a changed key, after this frame: a forced draw of an unchanged key is still quiet.
pub fn fg_quiet(quiet: u32, changed: bool) -> u32 {
    if (changed) { return 0; }
    if (quiet >= 9999) { return quiet; }
    return quiet + 1;
}

/// How long the loop waits for an event: `frame_s` while busy or a pane is live, FG_IDLE_S once quiet.
pub fn fg_wait(quiet: u32, live: bool, frame_s: f64) -> f64 {
    if (live) { return frame_s; }
    if (quiet >= FG_QUIET) { return FG_IDLE_S; }
    return frame_s;
}

// Animation rate (owner, 2026-10-20: "animation is sluggish"). While anything animates (the fly-in, the 0.25 s
// cross-fade, the GOD MODE glow) the loop waits FG_ANIM_S (60 fps) for the next event instead of FRAME_S, and the
// animation clocks advance by the time that really passed, in units of the 30 fps logical tick, so a faster or a
// slower redraw never changes how long an animation lasts. Back to on-demand once settled (fg_wait).
pub const FG_ANIM_S : f64 = 0.0166666666666667;
/// One logical animation tick, seconds (the 30 fps the constants of glass_window and queen are written in).
pub const FG_TICK_S : f64 = 0.0333333333333333;
/// The longest stall counted, in ticks: a long pause must not make the next frame jump the whole animation.
pub const FG_TICKS_MAX : f64 = 8.0;

/// The event wait: 60 fps while animating, else fg_wait.
pub fn fg_wait_anim(quiet: u32, live: bool, animating: bool, frame_s: f64) -> f64 {
    if (animating) { return FG_ANIM_S; }
    return fg_wait(quiet, live, frame_s);
}

/// Logical ticks that elapsed in dt seconds, in 0..FG_TICKS_MAX (fractions kept).
pub fn fg_ticks(dt: f64) -> f64 {
    if (dt <= 0.0) { return 0.0; }
    const k : f64 = dt / FG_TICK_S;
    if (k > FG_TICKS_MAX) { return FG_TICKS_MAX; }
    return k;
}

/// Whole ticks in an accumulated tick count.
pub fn fg_whole(acc: f64) -> u32 {
    if (acc <= 0.0) { return 0; }
    return @as(u32, @intFromFloat(acc));
}

/// Draws a second while nothing moves and no pane is live: one forced draw per FG_FORCE idle waits.
/// Before the gate (2026-10-19) the loop drew 30 times a second; this is the idle figure the window can reach.
pub fn fg_idle_draws_per_s() -> f64 {
    return 1.0 / (@as(f64, @floatFromInt(FG_FORCE)) * FG_IDLE_S);
}

/// A draw is also owed when a background job finished (a card fetched, a thumbnail decoded): its counter is
/// in the key, so the key changes and fg_draw_due fires with no wait for the forced draw.
pub fn fg_job_done(before: u64, after: u64) -> bool { return before != after; }

test the_key_changes_when_any_part_changes {
    const a : u64 = fg_mix(fg_mix(fg_mix(0, 1), 2), 3);
    const b : u64 = fg_mix(fg_mix(fg_mix(0, 1), 2), 4);
    const c : u64 = fg_mix(fg_mix(fg_mix(0, 2), 1), 3);
    assert a != b;
    assert a != c;
    assert a == fg_mix(fg_mix(fg_mix(0, 1), 2), 3);
    // the rotation keeps the high bit: nothing falls off the top
    assert fg_mix(9223372036854775808, 0) == 64;
}

test levels_and_cells_quantise {
    assert fg_flag(true) == 1;
    assert fg_flag(false) == 0;
    assert fg_level(0.0) == 0;
    assert fg_level(-1.0) == 0;
    assert fg_level(1.0) == 4096;
    assert fg_level(0.5) == 2048;
    assert fg_cell(-3.0) == 0;
    assert fg_cell(3.9) == 0;
    assert fg_cell(8.0) == 2;
    assert fg_mouse(8.0, 100.0) == 2;
    assert fg_mouse(-5.0, 100.0) == FG_AWAY;
    assert fg_mouse(-500.0, 100.0) == FG_AWAY;
    assert fg_mouse(101.0, 100.0) == FG_AWAY;
}

test a_still_frame_is_skipped_until_forced {
    assert fg_draw_due(5, 5, false, 0) == false;
    assert fg_draw_due(5, 5, false, FG_FORCE - 1) == false;
    assert fg_draw_due(5, 5, false, FG_FORCE);
    assert fg_draw_due(6, 5, false, 0);
    assert fg_draw_due(5, 5, true, 0);
    assert fg_since(3, true) == 0;
    assert fg_since(3, false) == 4;
    assert fg_since(9999, false) == 9999;
}

test the_wait_grows_only_when_quiet_and_no_pane_is_live {
    assert fg_quiet(10, true) == 0;
    assert fg_quiet(10, false) == 11;
    assert fg_wait(0, false, 0.0333) == 0.0333;
    assert fg_wait(FG_QUIET, false, 0.0333) == FG_IDLE_S;
    assert fg_wait(FG_QUIET, true, 0.0333) == 0.0333;
}

test idle_is_a_fraction_of_a_draw_a_second {
    assert fg_idle_draws_per_s() < 0.2;
    assert fg_idle_draws_per_s() > 0.1;
    assert fg_job_done(3, 4);
    assert fg_job_done(4, 4) == false;
    assert fg_draw_due(fg_mix(0, 4), fg_mix(0, 3), false, 0);
}

test an_animation_in_flight_wakes_every_sixtieth_and_draws_every_tick {
    // animating: due every tick whatever the key and the idle count say
    assert fg_draw_due(7, 7, true, 0);
    assert fg_draw_due(7, 7, true, 1);
    assert fg_wait_anim(0, false, true, 0.0333) == FG_ANIM_S;
    assert fg_wait_anim(FG_QUIET, false, true, 0.0333) == FG_ANIM_S;
    assert FG_ANIM_S < 0.017;
    assert FG_ANIM_S * 2.0 > FG_TICK_S - 0.001;
    // settled: back to on demand
    assert fg_wait_anim(FG_QUIET, false, false, 0.0333) == FG_IDLE_S;
    assert fg_wait_anim(0, false, false, 0.0333) == 0.0333;
    // a settled quiet loop stays under 0.2 draws a second
    assert fg_idle_draws_per_s() < 0.2;
}

test time_not_the_frame_count_sets_how_long_an_animation_lasts {
    assert fg_ticks(0.0) == 0.0;
    assert fg_ticks(-1.0) == 0.0;
    assert @abs(fg_ticks(FG_TICK_S) - 1.0) < 0.0001;
    // a 60 fps redraw is half a tick: two redraws make one tick, the same 0.25 s as at 30 fps
    assert @abs(fg_ticks(FG_ANIM_S) * 2.0 - 1.0) < 0.001;
    assert fg_ticks(5.0) == FG_TICKS_MAX;
    assert fg_whole(0.0) == 0;
    assert fg_whole(0.99) == 0;
    assert fg_whole(2.5) == 2;
}

// Load audit (owner, 2026-10-22: 8 % CPU idle, 30 % peaks, 125 MB). The formula orbit counted as an animation, so the
// home screen drew at 60 fps for as long as it was shown, and each draw copied the 3840x2400 bitmap the layer holds.
// The orbit turns OV_OMEGA_MDEG_PER_S = 1.5 degrees a second: at FG_ORBIT_FPS a step is 0.15 degree, under one point
// at the orbit radius, so the orbit now steps FG_ORBIT_FPS times a second through the key (fg_orbit_step) and no
// longer wakes the loop at 60. A window that is not on screen (minimized, on another space, covered) draws nothing,
// animates nothing and waits FG_IDLE_S; the first frame back is drawn because its key was never shown.
pub const FG_ORBIT_FPS : f64 = 10.0;
pub const FG_ORBIT_S : f64 = 0.1;

/// The orbit's clock as a key part: one step per 1/FG_ORBIT_FPS second, 0 while the orbit does not move.
pub fn fg_orbit_step(t: f64, moving: bool) -> u64 {
    if (moving == false or t <= 0.0) { return 0; }
    return @as(u64, @intFromFloat(t * FG_ORBIT_FPS));
}

/// Draw this frame? Never while the window is off screen; else fg_draw_due.
pub fn fg_draw_vis(key: u64, shown: u64, animating: bool, since: u32, visible: bool) -> bool {
    if (visible == false) { return false; }
    return fg_draw_due(key, shown, animating, since);
}

/// The key now on the layer after this frame: the new key when it was drawn, else the old one, so a change made
/// while the window was off screen is still a change when it comes back.
pub fn fg_shown_after(shown: u64, key: u64, drew: bool) -> u64 {
    if (drew) { return key; }
    return shown;
}

/// The event wait with the window's visibility and the orbit: an animation on screen 60 fps; a live pane its frame
/// rate (its bytes come from a socket); off screen FG_IDLE_S; the orbit alone at most FG_ORBIT_S; else fg_wait.
pub fn fg_wait_vis(quiet: u32, live: bool, animating: bool, orbit: bool, visible: bool, frame_s: f64) -> f64 {
    if (animating and visible) { return FG_ANIM_S; }
    if (live) { return frame_s; }
    if (visible == false) { return FG_IDLE_S; }
    const w : f64 = fg_wait(quiet, false, frame_s);
    if (orbit and w > FG_ORBIT_S) { return FG_ORBIT_S; }
    return w;
}

// T27OS_PERF=1 (a measuring aid, off by default): one line to stderr every FG_PERF_S seconds with the loop ticks, the
// draws, the child processes started and the process's own CPU and memory over that window. A child is counted when a
// job slot (a pid the loop keeps) holds a pid it did not hold on the frame before.
pub const FG_PERF_S : u64 = 5;

/// Children started this frame: slots whose pid is non-zero and differs from the frame before.
pub fn fg_new_pids(prev: []const u64, cur: []const u64, n: usize) -> u32 {
    var k : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (cur[i] != 0 and cur[i] != prev[i]) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

/// CPU per mille of one core from nanoseconds used over a wall window of `wall_ns`.
pub fn fg_cpu_permille(used_ns: u64, wall_ns: u64) -> u64 {
    if (wall_ns == 0) { return 0; }
    return used_ns * 1000 / wall_ns;
}

test the_orbit_steps_ten_times_a_second_not_sixty {
    assert fg_orbit_step(1.0, true) == 10;
    assert fg_orbit_step(1.05, true) == 10;
    assert fg_orbit_step(1.1, true) == 11;
    assert fg_orbit_step(5.0, false) == 0;
    assert fg_orbit_step(-1.0, true) == 0;
    // 60 redraws a second over one second give 11 distinct steps at most, not 60
    var last : u64 = 0;
    var changes : u32 = 0;
    var i : u32 = 0;
    while (i < 60) {
        const s : u64 = fg_orbit_step(100.0 + @as(f64, @floatFromInt(i)) * FG_ANIM_S, true);
        if (s != last) { changes = changes + 1; }
        last = s;
        i = i + 1;
    }
    assert changes <= 11;
    assert changes >= 9;
    // the orbit alone waits a tenth of a second, never the 60 fps step
    assert fg_wait_vis(0, false, false, true, true, 0.0333) == 0.0333;
    assert fg_wait_vis(FG_QUIET, false, false, true, true, 0.0333) == FG_ORBIT_S;
    assert fg_wait_vis(FG_QUIET, false, false, false, true, 0.0333) == FG_IDLE_S;
    assert FG_ORBIT_S > FG_ANIM_S * 5.0;
}

test a_window_off_screen_draws_nothing_and_waits_idle {
    assert fg_draw_vis(6, 5, true, 99, false) == false;
    assert fg_draw_vis(6, 5, false, 0, true);
    assert fg_draw_vis(5, 5, false, 0, true) == false;
    assert fg_wait_vis(0, false, true, true, false, 0.0333) == FG_IDLE_S;
    assert fg_wait_vis(FG_QUIET, false, false, true, false, 0.0333) == FG_IDLE_S;
    // a live pane keeps its frame rate even off screen (its bytes are read by the loop)
    assert fg_wait_vis(FG_QUIET, true, false, false, false, 0.0333) == 0.0333;
    // on screen an animation still runs at 60
    assert fg_wait_vis(FG_QUIET, false, true, true, true, 0.0333) == FG_ANIM_S;
    // a change made off screen is drawn when the window comes back
    const shown : u64 = fg_shown_after(5, 6, false);
    assert shown == 5;
    assert fg_draw_vis(6, shown, false, 0, true);
    assert fg_shown_after(5, 6, true) == 6;
}

test perf_counts_new_children_and_cpu {
    var a : [4]u64 = undefined;
    var b : [4]u64 = undefined;
    a[0] = 0; a[1] = 100; a[2] = 200; a[3] = 0;
    b[0] = 0; b[1] = 100; b[2] = 201; b[3] = 300;
    assert fg_new_pids(a[0..4], b[0..4], 4) == 2;
    assert fg_new_pids(b[0..4], b[0..4], 4) == 0;
    assert fg_cpu_permille(400000000, 5000000000) == 80;
    assert fg_cpu_permille(5, 0) == 0;
    assert FG_PERF_S == 5;
}
