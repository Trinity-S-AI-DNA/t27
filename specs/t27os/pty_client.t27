// SPDX-License-Identifier: Apache-2.0
// T27 OS pty_client: what a window calls to talk to the PTY server (pty_server.t27) over its Unix socket:
// connect, then one request frame out and one reply frame back. The wire format is pty_proto.t27.
//
// The calls are blocking and stateless. A window that wants a live pane polls OP_READ with the cursor it
// was last given; the server never pushes. Closing the socket (or the whole process dying) detaches
// nothing and kills nothing: the panes belong to the server.
//
// Refs gHashTag/t27#10782.
module T27osPtyClient;

use t27os::editors::editor_spawn_payload;
use t27os::pty_proto::OP_LIST;
use t27os::pty_proto::OP_SPAWN;
use t27os::pty_proto::OP_ATTACH;
use t27os::pty_proto::OP_DETACH;
use t27os::pty_proto::OP_KEYS;
use t27os::pty_proto::OP_READ;
use t27os::pty_proto::OP_KILL;
use t27os::pty_proto::OP_SETKEY;
use t27os::pty_proto::OP_RESIZE;
use t27os::pty_proto::put_u16;
use t27os::pty_proto::HEADER;
use t27os::pty_proto::MAX_FRAME;
use t27os::pty_proto::put_u64;
use t27os::pty_proto::get_u64;
use t27os::pty_proto::get_u16;
use t27os::pty_logic::spawn_cwd_len;
use t27os::pty_proto::put_frame;
use t27os::pty_proto::frame_need;
use t27os::pty_proto::socket_path;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_read;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_socket;
use t27os::pty_sys::sys_connect;

pub const AF_UNIX : i32 = 1;
pub const SOCK_STREAM : i32 = 1;
pub const SOCKADDR_LEN : u32 = 106;

/// The sockaddr_un of a socket path: sun_len, AF_UNIX, then the NUL-terminated path in 104 bytes.
pub fn sockaddr_un(out: []u8, path: []const u8) -> usize {
    var i : usize = 0;
    while (i < 106) {
        out[i] = 0;
        i = i + 1;
    }
    out[0] = 106;
    out[1] = 1;
    var j : usize = 0;
    while (j < path.len and j < 103) {
        out[2 + j] = path[j];
        j = j + 1;
    }
    return 106;
}

/// Connect to the server whose socket lives under `home`; the fd, or -1 when nothing listens.
pub fn client_connect(home: []const u8) -> i32 {
    var path : [128]u8 = undefined;
    const pn : usize = socket_path(path[0..128], home);
    if (pn == 0) { return -1; }
    var addr : [106]u8 = undefined;
    sockaddr_un(addr[0..106], path[0..pn]);
    const fd : i32 = sys_socket(AF_UNIX, SOCK_STREAM, 0);
    if (fd < 0) { return -1; }
    if (sys_connect(fd, addr[0..106], SOCKADDR_LEN) < 0) {
        sys_close(fd);
        return -1;
    }
    return fd;
}

/// Read until one whole frame sits at the front of out; its length, 0 on a closed or bad connection.
pub fn client_recv(fd: i32, out: []u8) -> usize {
    var have : usize = 0;
    var need : usize = 0;
    while (need == 0 or have < need) {
        if (have >= MAX_FRAME) { return 0; }
        const n : i64 = sys_read(fd, out[have .. MAX_FRAME], @as(u64, MAX_FRAME - have));
        if (n <= 0) { return 0; }
        have = have + @as(usize, @intCast(n));
        need = frame_need(out[0 .. have]);
        if (need == 1) { return 0; }
    }
    return need;
}

/// One round trip: send the request frame, return the length of the reply frame now at the front of out.
pub fn client_call(fd: i32, op: u8, pane: u8, payload: []const u8, out: []u8) -> usize {
    var req : [4200]u8 = undefined;
    const n : usize = put_frame(req[0..4200], op, pane, payload);
    if (n == 0) { return 0; }
    const w : i64 = sys_write(fd, req[0..n], @as(u64, n));
    if (w <= 0) { return 0; }
    if (@as(usize, @intCast(w)) != n) { return 0; }
    return client_recv(fd, out);
}

/// LIST: the reply frame (RE_LISTING, 4 bytes per pane).
pub fn client_list(fd: i32, out: []u8) -> usize {
    return client_call(fd, OP_LIST, 0, "", out);
}

/// The SPAWN payload client_spawn sends, into p (at least 293 bytes): agent, space, slot, then the first 290
/// bytes of `cwd`; its length.
pub fn client_spawn_payload(agent: u32, space: u32, slot: u32, cwd: []const u8, p: []u8) -> usize {
    p[0] = @as(u8, @intCast(agent));
    p[1] = @as(u8, @intCast(space));
    p[2] = @as(u8, @intCast(slot));
    var i : usize = 0;
    while (i < cwd.len and i < 290) {
        p[3 + i] = cwd[i];
        i = i + 1;
    }
    return 3 + i;
}

/// SPAWN agent in `cwd` for a space/slot; the reply's pane byte is the new pane id.
pub fn client_spawn(fd: i32, agent: u32, space: u32, slot: u32, cwd: []const u8, out: []u8) -> usize {
    var p : [300]u8 = undefined;
    const n : usize = client_spawn_payload(agent, space, slot, cwd, p[0..300]);
    return client_call(fd, OP_SPAWN, 0, p[0 .. n], out);
}

/// SPAWN terminal editor `pick` (editors.t27 TERM_NAMES) on `path`, a folder or a file, for a space/slot: an
/// editor pane (T27 OS opens inside). Same reply as client_spawn; 0 bytes when pick or path is not fit.
pub fn client_spawn_editor(fd: i32, space: u32, slot: u32, pick: u32, path: []const u8, out: []u8) -> usize {
    var p : [300]u8 = undefined;
    const n : usize = editor_spawn_payload(space, slot, pick, path, p[0..300]);
    if (n == 0) { return 0; }
    return client_call(fd, OP_SPAWN, 0, p[0 .. n], out);
}

/// ATTACH marks the pane seen; the reply's payload is the running byte count (the cursor to read from).
pub fn client_attach(fd: i32, pane: u32, out: []u8) -> usize {
    return client_call(fd, OP_ATTACH, @as(u8, @intCast(pane)), "", out);
}

pub fn client_detach(fd: i32, pane: u32, out: []u8) -> usize {
    return client_call(fd, OP_DETACH, @as(u8, @intCast(pane)), "", out);
}

/// KEYS: the bytes a user typed, written to the pane's terminal.
pub fn client_keys(fd: i32, pane: u32, keys: []const u8, out: []u8) -> usize {
    return client_call(fd, OP_KEYS, @as(u8, @intCast(pane)), keys, out);
}

/// SETKEY: hand the server provider p's key (empty = forget it); it lives in the server's memory only.
pub fn client_set_key(fd: i32, provider: u32, key: []const u8, out: []u8) -> usize {
    return client_call(fd, OP_SETKEY, @as(u8, @intCast(provider)), key, out);
}

/// READ from `cursor`: the reply payload is the new cursor (8 bytes) then the output bytes.
pub fn client_read(fd: i32, pane: u32, cursor: u64, out: []u8) -> usize {
    var c : [8]u8 = undefined;
    put_u64(c[0..8], 0, cursor);
    return client_call(fd, OP_READ, @as(u8, @intCast(pane)), c[0..8], out);
}

pub fn client_kill(fd: i32, pane: u32, out: []u8) -> usize {
    return client_call(fd, OP_KILL, @as(u8, @intCast(pane)), "", out);
}

/// The RESIZE payload client_resize sends, into p[0..4]: cols then rows, u16 each; its length.
pub fn client_resize_payload(cols: u32, rows: u32, p: []u8) -> usize {
    put_u16(p, 0, cols);
    put_u16(p, 2, rows);
    return 4;
}

/// RESIZE: the grid the window can show, applied to the pane's terminal and signalled with SIGWINCH.
pub fn client_resize(fd: i32, pane: u32, cols: u32, rows: u32, out: []u8) -> usize {
    var p : [4]u8 = undefined;
    client_resize_payload(cols, rows, p[0..4]);
    return client_call(fd, OP_RESIZE, @as(u8, @intCast(pane)), p[0..4], out);
}

/// The cursor a RE_DATA or RE_OK reply carries.
pub fn reply_cursor(frame: []const u8) -> u64 {
    return get_u64(frame, HEADER);
}

test the_sockaddr_holds_family_and_path {
    var a : [106]u8 = undefined;
    const n : usize = sockaddr_un(a[0..106], "/tmp/x.sock");
    assert n == 106;
    assert a[0] == 106;
    assert a[1] == 1;
    assert a[2] == 47;
    assert a[12] == 107;
    assert a[13] == 0;
    assert a[105] == 0;
}

test a_long_path_is_cut_at_103 {
    var a : [106]u8 = undefined;
    var p : [200]u8 = undefined;
    var i : usize = 0;
    while (i < 200) {
        p[i] = 97;
        i = i + 1;
    }
    sockaddr_un(a[0..106], p[0..200]);
    assert a[104] == 97;
    assert a[105] == 0;
}

test reply_cursor_reads_the_eight_bytes_after_the_header_little_endian {
    var f : [32]u8 = undefined;
    var i : usize = 0;
    while (i < 32) { f[i] = 255; i = i + 1; }
    put_u64(f[0..32], HEADER, 0);
    assert reply_cursor(f[0..32]) == 0;
    put_u64(f[0..32], HEADER, 1);
    assert reply_cursor(f[0..32]) == 1;
    put_u64(f[0..32], HEADER, 4096);
    assert reply_cursor(f[0..32]) == 4096;
    put_u64(f[0..32], HEADER, 18446744073709551615);
    assert reply_cursor(f[0..32]) == 18446744073709551615;
    // the bytes before the header and after the cursor are not part of it
    put_u64(f[0..32], HEADER, 258);
    f[0] = 7;
    f[HEADER + 8] = 9;
    assert reply_cursor(f[0..32]) == 258;
    assert f[HEADER] == 2 and f[HEADER + 1] == 1 and f[HEADER + 2] == 0;
}

test the_client_refuses_what_cannot_be_framed_or_addressed_before_it_touches_a_socket {
    var out : [64]u8 = undefined;
    // a home whose socket path would pass 103 bytes: no socket is made, -1
    var home : [120]u8 = undefined;
    var i : usize = 0;
    while (i < 120) { home[i] = 97; i = i + 1; }
    assert client_connect(home[0..88]) == -1;
    assert client_connect(home[0..120]) == -1;
    // a payload past MAX_PAYLOAD (4096) cannot be framed: 0 bytes, nothing is written to the (invalid) fd
    var big : [4097]u8 = undefined;
    i = 0;
    while (i < 4097) { big[i] = 65; i = i + 1; }
    assert client_call(-1, OP_KEYS, 0, big[0..4097], out[0..64]) == 0;
    assert client_keys(-1, 0, big[0..4097], out[0..64]) == 0;
    assert client_set_key(-1, 1, big[0..4097], out[0..64]) == 0;
    // an editor pick that is not in the table gives no request at all
    assert client_spawn_editor(-1, 0, 0, 4294967295, "/tmp", out[0..64]) == 0;
}

test the_spawn_payload_is_agent_space_slot_then_the_cwd_the_server_reads_back {
    var p : [300]u8 = undefined;
    const n : usize = client_spawn_payload(2, 5, 7, "/tmp/work", p[0..300]);
    assert n == 12;
    assert p[0] == 2 and p[1] == 5 and p[2] == 7;
    assert p[3] == 47 and p[11] == 107;
    // the server (pty_logic spawn_cwd_len) finds the whole cwd in it
    assert spawn_cwd_len(p[0..n]) == 9;
    // the largest byte values pass as they are
    assert client_spawn_payload(255, 255, 255, "/", p[0..300]) == 4;
    assert p[0] == 255 and p[1] == 255 and p[2] == 255 and p[3] == 47;
    // an empty cwd is the three bytes alone: the server reads cwd length 0 and refuses it (pty_server OP_SPAWN)
    assert client_spawn_payload(0, 0, 0, "", p[0..300]) == 3;
    assert spawn_cwd_len(p[0..3]) == 0;
    // a cwd past 290 bytes is cut at 290: the payload stays 293 bytes and fits the 300 the client keeps
    var c : [400]u8 = undefined;
    var i : usize = 0;
    while (i < 400) { c[i] = 97; i = i + 1; }
    c[290] = 98;
    assert client_spawn_payload(1, 0, 0, c[0..290], p[0..300]) == 293;
    assert client_spawn_payload(1, 0, 0, c[0..291], p[0..300]) == 293;
    assert client_spawn_payload(1, 0, 0, c[0..400], p[0..300]) == 293;
    assert p[292] == 97 and spawn_cwd_len(p[0..293]) == 290;
    assert client_spawn_payload(1, 0, 0, c[0..289], p[0..300]) == 292;
}

test the_resize_payload_is_cols_then_rows_as_the_server_reads_them {
    var p : [4]u8 = undefined;
    assert client_resize_payload(80, 24, p[0..4]) == 4;
    assert get_u16(p[0..4], 0) == 80 and get_u16(p[0..4], 2) == 24;
    // cols first: swapping them is a different grid
    assert client_resize_payload(24, 80, p[0..4]) == 4;
    assert get_u16(p[0..4], 0) == 24 and get_u16(p[0..4], 2) == 80;
    // the edges of a u16
    assert client_resize_payload(0, 65535, p[0..4]) == 4;
    assert get_u16(p[0..4], 0) == 0 and get_u16(p[0..4], 2) == 65535;
    assert p[2] == 255 and p[3] == 255;
}
