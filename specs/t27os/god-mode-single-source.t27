; specs/t27os/god-mode-single-source.t27 -- Single Source of Truth for GOD MODE State
; Owner, 2026-10-21: Consolidates all GOD MODE state into one authoritative module
; to prevent inconsistencies between different parts of the system.
; φ^2 + 1/φ² = 3 | TRINITY

module T27osGodMode;

/// Single source of truth for GOD MODE state management
///
/// This module consolidates all GOD MODE state to ensure consistency
/// across different UI elements, components, and system behaviors.
/// Before this, multiple places could have different interpretations
/// of GOD MODE state, leading to incorrect visual feedback or behavior.

/// The canonical GOD MODE state enum
pub const GOD_MODE_OFF : u32 = 0;
pub const GOD_MODE_ON : u32 = 1;
pub const GOD_MODE_PENDING : u32 = 2;

/// Convert boolean to GodModeState for backward compatibility
pub fn from_bool(value: bool) -> u32 {
    if (value) { return GOD_MODE_ON; }
    return GOD_MODE_OFF;
}

/// Convert GodModeState to boolean for legacy components
pub fn to_bool(state: u32) -> bool {
    return state == GOD_MODE_ON;
}

/// Convert boolean to GodModeState for backward compatibility
pub fn from_bool(value: bool) -> GodModeState {
    if (value) { return ON; }
    return OFF;
}

/// Convert GodModeState to boolean for legacy components
pub fn to_bool(state: GodModeState) -> bool {
    return state == ON;
}

/// Get the display text for the current state
pub fn display_text(state: u32) -> str {
    if (state == GOD_MODE_OFF) {
        return "GOD MODE OFF";
    } else if (state == GOD_MODE_ON) {
        return "GOD MODE ON";
    } else {
        return "GOD MODE...";
    }
}

/// Edge glow colors based on state
pub const GLOW_OFF_R : f64 = 0.0;
pub const GLOW_OFF_G : f64 = 0.0;
pub const GLOW_OFF_B : f64 = 0.0;
pub const GLOW_ON_R : f64 = 0.22;
pub const GLOW_ON_G : f64 = 0.10;
pub const GLOW_ON_B : f64 = 0.80;
pub const GLOW_PENDING_R : f64 = 0.39;
pub const GLOW_PENDING_G : f64 = 0.26;
pub const GLOW_PENDING_B : f64 = 0.90;

/// Smooth transition parameters
pub const TRANSITION_STEPS : u32 = 5;
pub const TRANSITION_DELAY_MS : u64 = 100;

/// Check if a state transition is allowed
pub fn can_transition(from: GodModeState, to: GodModeState) -> bool {
    // Allow all valid transitions
    switch (from) {
        OFF => {
            switch (to) {
                ON, PENDING => return true;
                OFF => return false; // No-op transition
            }
        }
        ON => {
            switch (to) {
                OFF, PENDING => return true;
                ON => return false; // No-op transition
            }
        }
        PENDING => {
            // Can transition to either final state from pending
            return to == ON or to == OFF;
        }
    }
    return false;
}

/// Get the transition sequence between states
pub fn transition_sequence(from: GodModeState, to: GodModeState) -> [6]GodModeState {
    var sequence : [6]GodModeState = undefined;

    if (from == to) {
        // No transition needed
        sequence[0] = from;
        return sequence;
    }

    if (from == OFF && to == ON) {
        sequence[0] = OFF;
        sequence[1] = PENDING;
        sequence[2] = ON;
        return sequence;
    }

    if (from == ON && to == OFF) {
        sequence[0] = ON;
        sequence[1] = PENDING;
        sequence[2] = OFF;
        return sequence;
    }

    // Default: direct transition
    sequence[0] = from;
    sequence[1] = to;
    return sequence;
}

/// Calculate glow intensity for a given state and transition progress
pub fn glow_intensity(state: GodModeState, progress: f64) -> f64 {
    if (state == OFF) {
        return 0.0 * progress;
    } else if (state == ON) {
        return 1.0 * progress;
    } else { // PENDING
        // Pulsing effect for pending state
        const pulse : f64 = @sin(@as(f64, @floatFromInt(progress * 360)) * 3.14159 / 180);
        return 0.5 + 0.5 * pulse;
    }
}

/// Unified event handling for GOD MODE
pub const GodModeEvent : enum {
    Toggle,    // User toggled the switch
    Activate,  // GOD MODE should activate
    Deactivate,// GOD MODE should deactivate
    ForceOff   // Emergency deactivation
}

/// Process a GOD MODE event and return the new state
pub fn process_event(current: GodModeState, event: GodModeEvent) -> GodModeState {
    switch (event) {
        Toggle => {
            if (current == OFF) return ON;
            if (current == ON) return OFF;
            return current; // PENDING toggles to opposite
        }
        Activate => {
            if (current == OFF) return ON;
            return current;
        }
        Deactivate => {
            if (current == ON) return OFF;
            return current;
        }
        ForceOff => {
            return OFF; // Always force off
        }
    }
}

/// UI state management
pub const UIState : struct {
    current: GodModeState = OFF,
    display: GodModeState = OFF,  // What's currently displayed
    last_update: u64 = 0,         // Timestamp of last state change
    is_animating: bool = false    // Whether transition animation is running
};

/// Update UI state with new GOD MODE state
pub fn update_ui(ui: *UIState, new_state: GodModeState, now: u64) -> void {
    if (ui.current != new_state) {
        ui.current = new_state;
        ui.last_update = now;

        // Start animation for state changes
        if (new_state == OFF or new_state == ON) {
            ui.is_animating = true;
            ui.display = PENDING; // Show intermediate state
        } else {
            ui.display = new_state;
        }
    }
}

/// Complete UI transition
pub fn complete_ui_transition(ui: *UIState) -> void {
    ui.display = ui.current;
    ui.is_animating = false;
}

/// Validation tests
test god_mode_state_conversion {
    // Boolean conversion
    assert from_bool(true) == ON;
    assert from_bool(false) == OFF;
    assert to_bool(ON) == true;
    assert to_bool(OFF) == false;
    assert to_bool(PENDING) == false;

    // Display text
    assert display_text(OFF) == "GOD MODE OFF";
    assert display_text(ON) == "GOD MODE ON";
    assert display_text(PENDING) == "GOD MODE...";
}

test transition_validity {
    // Valid transitions
    assert can_transition(OFF, ON) == true;
    assert can_transition(OFF, PENDING) == true;
    assert can_transition(ON, OFF) == true;
    assert can_transition(ON, PENDING) == true;
    assert can_transition(PENDING, ON) == true;
    assert can_transition(PENDING, OFF) == true;

    // Invalid transitions
    assert can_transition(OFF, OFF) == false;
    assert can_transition(ON, ON) == false;
}

test event_processing {
    // Toggle events
    assert process_event(OFF, Toggle) == ON;
    assert process_event(ON, Toggle) == OFF;
    assert process_event(PENDING, Toggle) == PENDING;

    // Activate/deactivate
    assert process_event(OFF, Activate) == ON;
    assert process_event(ON, Deactivate) == OFF;
    assert process_event(OFF, Deactivate) == OFF;

    // Force off
    assert process_event(ON, ForceOff) == OFF;
    assert process_event(PENDING, ForceOff) == OFF;
}

test glow_intensity_calculation {
    // Off state has no glow
    assert glow_intensity(OFF, 0.5) == 0.0;

    // On state has full glow
    assert glow_intensity(ON, 1.0) == 1.0;

    // Pending state has pulsing glow
    const intensity1 : f64 = glow_intensity(PENDING, 0.0);
    const intensity2 : f64 = glow_intensity(PENDING, 0.25);
    assert intensity1 != intensity2; // Should pulse
}

// Integration with existing queen.t27
// These constants should replace the existing GOD MODE constants in queen.t27

/// Control codes for GOD MODE (should replace existing C_GOD_ON/C_GOD_OFF)
pub const GOD_MODE_CONTROL : struct {
    TOGGLE: u32 = 11,    // Toggle GOD MODE
    FORCE_OFF: u32 = 12  // Emergency force off
};

/// Animation parameters for smooth transitions
pub const ANIMATION : struct {
    FRAMES_PER_STEP: u32 = 30,
    TOTAL_STEPS: u32 = 5,
    INTER_FRAME_DELAY_MS: u64 = 16  // ~60fps
};

// Legacy compatibility layer - converts old constants to new system
pub const LEGACY : struct {
    C_GOD_ON: u32 = 11,    // Maps to TOGGLE
    C_GOD_OFF: u32 = 12   // Maps to FORCE_OFF
};

/// Migration helper for existing code
pub fn migrate_legacy_control(control: u32) -> GodModeEvent {
    if (control == LEGACY.C_GOD_ON) {
        return Toggle;
    } else if (control == LEGACY.C_GOD_OFF) {
        return ForceOff;
    }
    return Toggle; // Default toggle for safety
}