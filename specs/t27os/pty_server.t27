/// T27OS_CTL=<verb>: list | spawn | kill | read | keys | expect against a running server. The verb is the
/// whole word (`write` is the old name of `keys`). T27OS_KEYS takes \e \r \n \t \\ \xHH; a CR is added unless
/// T27OS_RAW is set. `expect` waits up to T27OS_WAIT seconds (default 30) for T27OS_EXPECT in the pane's
/// output and exits 0, or prints `timeout` and exits 1.
fn run_ctl(st: []u64, mem: []u8, wl: usize) -> void {
    const verb : u32 = ctl_verb(mem[O_MISC + 400 .. O_MISC + 400 + wl]);
    if (verb == 0) { say("unknown verb: list | spawn | kill | read | keys | expect\n"); return; }
