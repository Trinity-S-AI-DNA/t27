// SPDX-License-Identifier: Apache-2.0
; specs/t27os/general_conductor_tick.t27 -- the general conductor tick decision spec.
; Owner, 2026-11-01: a pure decision spec that returns STAY_OFF/RUN/SKIP and writes JSON tick rows.
; This spec never calls the host: it reads through crons::general_conductor::tick_decision; ENABLED is false
; and the go file is absent as merged, so the answer today is stay off; everything it proposes is a proposal,
; nothing acts; the owner's separate words still pending (go file, cron load, ENABLED, scope gate BLOCK,
; GC_MAY_SWITCH_MODEL); the numbered host needs below. ASCII only (no unicode dashes, no smart quotes).
; Host inventory (five needs, tick_host_needs() == 5, three GAPs, tick_host_gaps() == 3):
; (1) go file read: wrapper tg_read, fn tg_read(hb: []const u8, dir: []const u8, file: []const u8, dst: []u8) -> usize,
;     glass_window.t27:6233, with home_dir at glass_window.t27:2366; the file is GC_GO_FILE in the card
; (2) clock: wrapper unix_time, fn unix_time(t: u64) -> u64, glass_window.t27:2352 (a duty's seconds are two clock reads)
; (3) one-minute load: GAP, proposed fn load_avg_1m_x100() -> u32
; (4) free disk GiB: GAP, proposed fn free_disk_gb(hb: []const u8) -> u32
; (5) append one line to the tick log: GAP, proposed fn append_line(hb: []const u8, dir: []const u8, file: []const u8, line: []const u8) -> bool
module T27osGeneralConductorTick;

use t27os::session_store::put_dec;
use t27os::session_store::put_bytes;
use crons::general_conductor::tick_decision;
use crons::general_conductor::GC_TICK_STAY_OFF;
use crons::general_conductor::GC_TICK_RUN;
use crons::general_conductor::ENABLED;
use crons::general_conductor::GC_MAX_SECONDS_PER_DUTY;
use crons::general_conductor::GC_MAX_TICKS_PER_HOUR;
use crons::general_conductor::GC_DUTY_CHECK_MATRYOSHKA_HEALTH;
use crons::general_conductor::GC_DUTY_DISPATCH_TASKS;
use crons::general_conductor::GC_DUTY_DISCOVER_MODELS;
use crons::general_conductor::GC_DUTY_FIND_MORE_WORK;
use crons::general_conductor::GC_DUTY_SCALE_THINKING;
use crons::general_conductor::GC_MAY_MERGE;
use crons::general_conductor::GC_MAY_START_CRON;
use crons::general_conductor::GC_MAY_CODE;
use crons::general_conductor::GC_MAY_SWITCH_MODEL;
use crons::mac-dsh-godmode-supervisor::GM_MIN_FREE_GB;
use crons::mac-dsh-godmode-supervisor::GM_MAX_LOAD;

pub const GCT_A_STAY_OFF : u32 = 0;
pub const GCT_A_RUN : u32 = 1;
pub const GCT_A_SKIP : u32 = 2;

pub const GCT_DUTY_OK : u32 = 0;
pub const GCT_DUTY_STALLED : u32 = 1;
pub const GCT_ROW_MAX : usize = 152;

pub fn tick_decide(enabled: bool, go: bool, free_gb: u32, load: u32, ticks_in_hour: u32) -> u32 {
    if (tick_decision(enabled, go) == GC_TICK_STAY_OFF) {
        return GCT_A_STAY_OFF;
    }

    if (free_gb < GM_MIN_FREE_GB or load >= GM_MAX_LOAD) {
        return GCT_A_SKIP;
    }

    if (ticks_in_hour >= GC_MAX_TICKS_PER_HOUR) {
        return GCT_A_SKIP;
    }

    return GCT_A_RUN;
}

pub fn duty_state(seconds: u32) -> u32 {
    if (seconds > GC_MAX_SECONDS_PER_DUTY) {
        return GCT_DUTY_STALLED;
    }
    return GCT_DUTY_OK;
}

pub fn stalled_count(s1: u32, s2: u32, s3: u32, s4: u32, s5: u32) -> u32 {
    var count : u32 = 0;
    if (s1 > GC_MAX_SECONDS_PER_DUTY) { count = count + 1; }
    if (s2 > GC_MAX_SECONDS_PER_DUTY) { count = count + 1; }
    if (s3 > GC_MAX_SECONDS_PER_DUTY) { count = count + 1; }
    if (s4 > GC_MAX_SECONDS_PER_DUTY) { count = count + 1; }
    if (s5 > GC_MAX_SECONDS_PER_DUTY) { count = count + 1; }
    return count;
}

pub fn first_stalled_duty(s1: u32, s2: u32, s3: u32, s4: u32, s5: u32) -> u32 {
    if (s1 > GC_MAX_SECONDS_PER_DUTY) { return 1; }
    if (s2 > GC_MAX_SECONDS_PER_DUTY) { return 2; }
    if (s3 > GC_MAX_SECONDS_PER_DUTY) { return 3; }
    if (s4 > GC_MAX_SECONDS_PER_DUTY) { return 4; }
    if (s5 > GC_MAX_SECONDS_PER_DUTY) { return 5; }
    return 0;
}

pub fn duty_is_proposal_only(duty: u8) -> bool {
    if (duty == GC_DUTY_DISCOVER_MODELS) { return true; }
    if (duty == GC_DUTY_FIND_MORE_WORK) { return true; }
    if (duty == GC_DUTY_SCALE_THINKING) { return true; }
    return false;
}

pub fn switches_all_off() -> bool {
    return (!GC_MAY_MERGE and !GC_MAY_START_CRON and !GC_MAY_CODE and !GC_MAY_SWITCH_MODEL);
}

pub fn tick_host_needs() -> u32 {
    return 5;
}

pub fn tick_host_gaps() -> u32 {
    return 3;
}

fn action_name(a: u32) -> []const u8 {
    if (a == GCT_A_STAY_OFF) { return "STAY_OFF"; }
    if (a == GCT_A_RUN) { return "RUN"; }
    if (a == GCT_A_SKIP) { return "SKIP"; }
    return "unknown";
}

fn outcome_name(action: u32, s1: u32, s2: u32, s3: u32, s4: u32, s5: u32) -> []const u8 {
    if (action == GCT_A_STAY_OFF) { return "off"; }
    if (action == GCT_A_SKIP) { return "skipped"; }
    if (action == GCT_A_RUN) {
        if (stalled_count(s1, s2, s3, s4, s5) > 0) { return "stalled"; }
        return "ran";
    }
    return "unknown";
}


pub fn tick_row(dst: []u8, tick: u32, action: u32, s1: u32, s2: u32, s3: u32, s4: u32, s5: u32) -> usize {
    // dst must hold GCT_ROW_MAX bytes or nothing is written
    if (dst.len < GCT_ROW_MAX) {
        return 0;
    }

    var write_s1 : u32 = s1;
    var write_s2 : u32 = s2;
    var write_s3 : u32 = s3;
    var write_s4 : u32 = s4;
    var write_s5 : u32 = s5;
    var write_stalled : u32 = stalled_count(s1, s2, s3, s4, s5);

    if (action != GCT_A_RUN) {
        write_s1 = 0;
        write_s2 = 0;
        write_s3 = 0;
        write_s4 = 0;
        write_s5 = 0;
        write_stalled = 0;
    }

    var at : usize = 0;
    at = put_bytes(dst, at, "{\"tick\":");
    at = put_dec(dst, at, @as(u64, tick));
    at = put_bytes(dst, at, ",\"action\":\"");
    at = put_bytes(dst, at, action_name(action));
    at = put_bytes(dst, at, "\",\"stalled\":");
    at = put_dec(dst, at, @as(u64, write_stalled));
    at = put_bytes(dst, at, ",\"d1\":");
    at = put_dec(dst, at, @as(u64, write_s1));
    at = put_bytes(dst, at, ",\"d2\":");
    at = put_dec(dst, at, @as(u64, write_s2));
    at = put_bytes(dst, at, ",\"d3\":");
    at = put_dec(dst, at, @as(u64, write_s3));
    at = put_bytes(dst, at, ",\"d4\":");
    at = put_dec(dst, at, @as(u64, write_s4));
    at = put_bytes(dst, at, ",\"d5\":");
    at = put_dec(dst, at, @as(u64, write_s5));
    at = put_bytes(dst, at, ",\"outcome\":\"");
    at = put_bytes(dst, at, outcome_name(action, write_s1, write_s2, write_s3, write_s4, write_s5));
    at = put_bytes(dst, at, "\"}");
    dst[at] = 10;
    at = at + 1;
    return at;
}

test enabled_false_stays_off {
    var action : u32 = tick_decide(ENABLED, true, 7, 30, 0);
    assert(action == GCT_A_STAY_OFF);
}

test go_absent_stays_off {
    var action : u32 = tick_decide(true, false, 7, 30, 0);
    assert(action == GCT_A_STAY_OFF);
}

test both_off_stays_off {
    var action : u32 = tick_decide(false, false, 7, 30, 0);
    assert(action == GCT_A_STAY_OFF);
}

test enabled_and_go_runs {
    var action : u32 = tick_decide(true, true, 7, 30, 0);
    assert(action == GCT_A_RUN);
}

test off_beats_resources {
    var action1 : u32 = tick_decide(false, true, 0, 99, 9);
    assert(action1 == GCT_A_STAY_OFF);
    var action2 : u32 = tick_decide(true, false, 0, 99, 9);
    assert(action2 == GCT_A_STAY_OFF);
}

test low_disk_skips {
    var skip1 : u32 = tick_decide(true, true, GM_MIN_FREE_GB - 1, 30, 0);
    assert(skip1 == GCT_A_SKIP);
    var run1 : u32 = tick_decide(true, true, GM_MIN_FREE_GB, 30, 0);
    assert(run1 == GCT_A_RUN);
}

test high_load_skips {
    var skip2 : u32 = tick_decide(true, true, 7, GM_MAX_LOAD, 0);
    assert(skip2 == GCT_A_SKIP);
    var run2 : u32 = tick_decide(true, true, 7, GM_MAX_LOAD - 1, 0);
    assert(run2 == GCT_A_RUN);
}

test hourly_cap_skips {
    var skip3 : u32 = tick_decide(true, true, 7, 30, GC_MAX_TICKS_PER_HOUR);
    assert(skip3 == GCT_A_SKIP);
    var run3 : u32 = tick_decide(true, true, 7, 30, GC_MAX_TICKS_PER_HOUR - 1);
    assert(run3 == GCT_A_RUN);
}

test duty_limit_is_inclusive {
    assert(duty_state(0) == GCT_DUTY_OK);
    assert(duty_state(GC_MAX_SECONDS_PER_DUTY) == GCT_DUTY_OK);
    assert(duty_state(GC_MAX_SECONDS_PER_DUTY + 1) == GCT_DUTY_STALLED);
}

test stalled_count_and_first {
    var count1 : u32 = stalled_count(10, 301, 0, 450, 5);
    assert(count1 == 2);
    var first1 : u32 = first_stalled_duty(10, 301, 0, 450, 5);
    assert(first1 == 2);
    var count2 : u32 = stalled_count(0, 0, 0, 0, 0);
    assert(count2 == 0);
    var first2 : u32 = first_stalled_duty(0, 0, 0, 0, 0);
    assert(first2 == 0);
    var first3 : u32 = first_stalled_duty(0, 0, 0, 0, 301);
    assert(first3 == 5);
    var first4 : u32 = first_stalled_duty(301, 0, 0, 0, 0);
    assert(first4 == 1);
}

test proposal_only_duties {
    assert(duty_is_proposal_only(GC_DUTY_DISCOVER_MODELS) == true);
    assert(duty_is_proposal_only(GC_DUTY_FIND_MORE_WORK) == true);
    assert(duty_is_proposal_only(GC_DUTY_SCALE_THINKING) == true);
    assert(duty_is_proposal_only(GC_DUTY_CHECK_MATRYOSHKA_HEALTH) == false);
    assert(duty_is_proposal_only(GC_DUTY_DISPATCH_TASKS) == false);
    assert(duty_is_proposal_only(99) == false);
}

test switches_all_off_true {
    assert(switches_all_off() == true);
}

test host_needs {
    assert(tick_host_needs() == 5);
    assert(tick_host_gaps() == 3);
}

test off_row_is_byte_exact {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 1, GCT_A_STAY_OFF, 0, 0, 0, 0, 0);
    assert(written == 94);
    const want : []const u8 = "{\"tick\":1,\"action\":\"STAY_OFF\",\"stalled\":0,\"d1\":0,\"d2\":0,\"d3\":0,\"d4\":0,\"d5\":0,\"outcome\":\"off\"}\n";
    assert(want.len == 94);
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test off_row_zeroes_seconds {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 5, GCT_A_STAY_OFF, 7, 7, 7, 7, 7);
    assert(written == 94);
    const want : []const u8 = "{\"tick\":5,\"action\":\"STAY_OFF\",\"stalled\":0,\"d1\":0,\"d2\":0,\"d3\":0,\"d4\":0,\"d5\":0,\"outcome\":\"off\"}\n";
    assert(want.len == 94);
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test run_row_is_byte_exact {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 2, GCT_A_RUN, 10, 20, 30, 40, 50);
    assert(written == 94);
    const want : []const u8 = "{\"tick\":2,\"action\":\"RUN\",\"stalled\":0,\"d1\":10,\"d2\":20,\"d3\":30,\"d4\":40,\"d5\":50,\"outcome\":\"ran\"}\n";
    assert(want.len == 94);
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test stalled_row_is_byte_exact {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 3, GCT_A_RUN, 10, 301, 0, 450, 5);
    assert(written == 98);
    const want : []const u8 = "{\"tick\":3,\"action\":\"RUN\",\"stalled\":2,\"d1\":10,\"d2\":301,\"d3\":0,\"d4\":450,\"d5\":5,\"outcome\":\"stalled\"}\n";
    assert(want.len == 98);
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test skip_row_zeroes_seconds {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 4, GCT_A_SKIP, 99, 99, 99, 99, 99);
    assert(written == 94);
    const want : []const u8 = "{\"tick\":4,\"action\":\"SKIP\",\"stalled\":0,\"d1\":0,\"d2\":0,\"d3\":0,\"d4\":0,\"d5\":0,\"outcome\":\"skipped\"}\n";
    assert(want.len == 94);
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test small_buffer_writes_nothing {
    var buf : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) {
        buf[i] = 7;
        i = i + 1;
    }
    var written : usize = tick_row(buf[0..8], 1, GCT_A_RUN, 10, 20, 30, 40, 50);
    assert(written == 0);
    var j : usize = 0;
    while (j < 8) {
        assert(buf[j] == 7);
        j = j + 1;
    }
}

test row_len_matches_written {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 123456, GCT_A_RUN, 301, 301, 301, 301, 3600);
    assert(written == 109);
    assert(buf[written - 1] == 10);
}

test row_max_boundary {
    // 151 bytes - too small, writes nothing
    var small_buf : [151]u8 = undefined;
    var i : usize = 0;
    while (i < 151) {
        small_buf[i] = 7;
        i = i + 1;
    }
    var small_written : usize = tick_row(small_buf[0..151], 1, GCT_A_STAY_OFF, 0, 0, 0, 0, 0);
    assert(small_written == 0);
    var j : usize = 0;
    while (j < 151) {
        assert(small_buf[j] == 7);
        j = j + 1;
    }

    // 152 bytes - exact minimum, writes 94 bytes
    var exact_buf : [152]u8 = undefined;
    var k : usize = 0;
    while (k < 152) {
        exact_buf[k] = 7;
        k = k + 1;
    }
    var exact_written : usize = tick_row(exact_buf[0..152], 1, GCT_A_STAY_OFF, 0, 0, 0, 0, 0);
    assert(exact_written == 94);
    assert(exact_buf[0] == '{');
    assert(exact_buf[93] == 10);
}