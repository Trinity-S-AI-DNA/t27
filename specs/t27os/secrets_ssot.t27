// SPDX-License-Identifier: Apache-2.0
; specs/t27os/secrets_ssot.t27 -- the Secrets SSOT pointer law (owner, 2026-11-15).
; The macOS Keychain, service "ai.t27.os", is the single source of truth for every key T27 OS
; manages; the full key law is keys.t27 ("never a plain file and never the repo"). This small
; file records the DSH-owned credential file and the names that hold no consumer here, so the
; rule and its scope sit in one place instead of a chat log.
;   DSH CREDENTIAL FILE: ~/.dsh/.credentials.yaml remains DSH's own credential-store file. The
;   native Ladder does not read it. After ladder.mjs retirement the file has no native Ladder
;   reader; DSH may keep its own credential-store records there, and the rotation cron
;   specs/crons/mac-dsh-zai-rotate.t27 may keep writing DSH_ZAI_KEY there.
;   NO CONSUMER: the names GLM_API_KEY, GLM_API_KEYS, RENDER_API_KEY (a 2026-11-15 migration
;   order drafted elsewhere) have zero references on this machine (machine-wide census,
;   2026-11-15): nothing to migrate, and the SSOT law gains no records for keys nothing reads.

module T27osSecretsSsot;

/// The native Ladder reads this macOS Keychain service, and no DSH credential file.
pub const NATIVE_KEYCHAIN_SERVICE : []const u8 = "ai.t27.os";

/// DSH owns this credential-store file. It is not a native Ladder input.
pub const DSH_CREDENTIAL_FILE : []const u8 = "/Users/LEGACY/.dsh/.credentials.yaml";

/// False after ladder.mjs retirement: the native Ladder has no DSH credential-file reader.
pub const NATIVE_LADDER_READS_DSH_FILE : bool = false;

/// Names a 2026-11-15 migration order expected here; the machine-wide census found none.
pub const NO_CONSUMER_NAMES : [3][]const u8 = ["GLM_API_KEY", "GLM_API_KEYS", "RENDER_API_KEY"];

/// Is this one of the migration-order names the 2026-11-15 census found no consumer for?
/// True means: nothing to migrate for it; the SSOT gains no record.
pub fn no_consumer(name : []const u8) -> bool {
  var k : usize = 0;
  while (k < 3) {
    if (name.len == NO_CONSUMER_NAMES[k].len) {
      var i : usize = 0;
      var same = true;
      while (i < name.len) {
        if (name[i] != NO_CONSUMER_NAMES[k][i]) { same = false; }
        i = i + 1;
      }
      if (same) { return true; }
    }
    k = k + 1;
  }
  return false;
}

test the_native_ladder_reads_the_keychain_and_not_the_dsh_file {
  assert NATIVE_KEYCHAIN_SERVICE.len == 9;
  assert NATIVE_KEYCHAIN_SERVICE[0] == 97;
  assert NATIVE_KEYCHAIN_SERVICE[8] == 115;
  assert NATIVE_LADDER_READS_DSH_FILE == false;
  assert DSH_CREDENTIAL_FILE.len > 0;
}

test the_migration_order_names_hold_no_consumer_here {
  assert no_consumer("GLM_API_KEY");
  assert no_consumer("GLM_API_KEYS");
  assert no_consumer("RENDER_API_KEY");
  // a key the machine does read is NOT in the no-consumer list
  assert no_consumer("DSH_ZAI_POOL") == false;
  assert no_consumer("GLM_API_KEYXX") == false;
}
