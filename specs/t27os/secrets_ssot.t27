// SPDX-License-Identifier: Apache-2.0
; specs/t27os/secrets_ssot.t27 -- the Secrets SSOT pointer law (owner, 2026-11-15).
; The macOS Keychain, service "ai.t27.os", is the single source of truth for every key T27 OS
; manages; the full key law is keys.t27 ("never a plain file and never the repo"). This small
; file records the one living exception and the names that hold no consumer here, so the rule
; and its scope sit in one place instead of a chat log.
;   LEGACY FALLBACK: ~/.dsh/.credentials.yaml (DSH_ZAI_KEY, DSH_ZAI_POOL, OLLAMA_KEY,
;   T27_LADDER_API_KEY, TEAMO_API_KEY). Exactly one reader: ladder.mjs (the 3131 proxy), whose
;   own header documents the fallback; the rotation cron specs/crons/mac-dsh-zai-rotate.t27
;   writes DSH_ZAI_KEY there. The file must not gain new records or new readers. Moving
;   ladder.mjs to the Keychain restarts the working 3131, which happens only in an
;   owner-agreed window (owner rule, 2026-11-02).
;   NO CONSUMER: the names GLM_API_KEY, GLM_API_KEYS, RENDER_API_KEY (a 2026-11-15 migration
;   order drafted elsewhere) have zero references on this machine (machine-wide census,
;   2026-11-15): nothing to migrate, and the SSOT law gains no records for keys nothing reads.

module T27osSecretsSsot;

/// The one documented legacy file-fallback reader of ~/.dsh/.credentials.yaml.
pub const LEGACY_READER : []const u8 = "ladder.mjs";

/// The legacy file path; new consumers must read the Keychain instead.
pub const LEGACY_PATH : []const u8 = "/Users/LEGACY/.dsh/.credentials.yaml";

/// Names a 2026-11-15 migration order expected here; the machine-wide census found none.
pub const NO_CONSUMER_NAMES : [3][]const u8 = ["GLM_API_KEY", "GLM_API_KEYS", "RENDER_API_KEY"];

/// Is this reader the documented legacy fallback (ladder.mjs and nothing else)?
pub fn legacy_reader(name : []const u8) -> bool {
  var i : usize = 0;
  if (name.len != LEGACY_READER.len) { return false; }
  while (i < name.len) {
    if (name[i] != LEGACY_READER[i]) { return false; }
    i = i + 1;
  }
  return true;
}

/// Is this one of the migration-order names the 2026-11-15 census found no consumer for?
/// True means: nothing to migrate for it; the SSOT gains no record.
pub fn no_consumer(name : []const u8) -> bool {
  var k : usize = 0;
  while (k < 3) {
    if (name.len == NO_CONSUMER_NAMES[k].len) {
      var i : usize = 0;
      var same = true;
      while (i < name.len) {
        if (name[i] != NO_CONSUMER_NAMES[k][i]) { same = false; }
        i = i + 1;
      }
      if (same) { return true; }
    }
    k = k + 1;
  }
  return false;
}

test the_legacy_file_fallback_has_exactly_one_named_reader {
  assert legacy_reader("ladder.mjs");
  assert legacy_reader("ladder.mjsx") == false;
  assert legacy_reader("keys.t27") == false;
  assert legacy_reader("") == false;
}

test the_migration_order_names_hold_no_consumer_here {
  assert no_consumer("GLM_API_KEY");
  assert no_consumer("GLM_API_KEYS");
  assert no_consumer("RENDER_API_KEY");
  // a key the machine does read is NOT in the no-consumer list
  assert no_consumer("DSH_ZAI_POOL") == false;
  assert no_consumer("GLM_API_KEYXX") == false;
}
