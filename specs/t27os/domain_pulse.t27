    if (letter == 9) { return I::LETTER; }
    if (letter == 10) { return J::LETTER; }
    if (letter == 11) { return K::LETTER; }
    if (letter == 12) { return L::LETTER; }
    if (letter == 13) { return M::LETTER; }
    if (letter == 14) { return N::LETTER; }
    if (letter == 15) { return O::LETTER; }
    if (letter == 16) { return P::LETTER; }
    if (letter == 17) { return Q::LETTER; }
    if (letter == 18) { return R::LETTER; }
    if (letter == 19) { return S::LETTER; }
    if (letter == 20) { return T::LETTER; }
    if (letter == 21) { return U::LETTER; }
    if (letter == 22) { return V::LETTER; }
    if (letter == 23) { return W::LETTER; }
    if (letter == 24) { return X::LETTER; }
    if (letter == 25) { return Y::LETTER; }
    if (letter == 26) { return Z::LETTER; }
    if (letter == 27) { return ti::LETTER; }
    return "-";
}

// ------------------------------------------------------------ path matching

/// Skip a leading "t27/" of a pattern.
pub fn pat_skip(pat: string) -> u32 {
    if ((pat.len as u32) > 4) {
        if ((pat[0] as u32) == 116) { if ((pat[1] as u32) == 50) { if ((pat[2] as u32) == 55) { if ((pat[3] as u32) == 47) { return 4; } } } }
    }
    return 0;
}

/// Where the '*' is in pat (from p0), or NONE.
pub fn pat_star(pat: string, p0: u32) -> u32 {
    var kk : u32 = p0;
    while (kk < (pat.len as u32)) {
        if ((pat[kk] as u32) == 42) { return kk; }
        kk = kk + 1;
    }
    return NONE;
}

/// Does text[a..b) start with pat[p0..p1) ?
pub fn starts_at(text: string, aa: u32, bb: u32, pat: string, p0: u32, p1: u32) -> bool {
    if (bb - aa < p1 - p0) { return false; }
    var kk : u32 = 0;
    while (kk < p1 - p0) {
        if ((text[aa + kk] as u32) != (pat[p0 + kk] as u32)) { return false; }
        kk = kk + 1;
    }
    return true;
}

/// Does text[a..b) end with pat[p0..p1) ?
pub fn ends_at(text: string, aa: u32, bb: u32, pat: string, p0: u32, p1: u32) -> bool {
    if (bb - aa < p1 - p0) { return false; }
    var kk : u32 = 0;
    while (kk < p1 - p0) {
        if ((text[bb - (p1 - p0) + kk] as u32) != (pat[p0 + kk] as u32)) { return false; }
        kk = kk + 1;
    }
    return true;
}

/// How pat matches the path text[a..b): K_NONE, K_EXACT, K_PREFIX (directory prefix or glob).
pub fn match_kind(text: string, aa: u32, bb: u32, pat: string) -> u32 {
    const p0 : u32 = pat_skip(pat);
    const pn : u32 = pat.len as u32;
    if (pn == p0) { return K_NONE; }
    const star : u32 = pat_star(pat, p0);
    if (star != NONE) {
        if (bb - aa < star - p0 + (pn - star - 1)) { return K_NONE; }
        if (starts_at(text, aa, bb, pat, p0, star)) {
            if (ends_at(text, aa, bb, pat, star + 1, pn)) { return K_PREFIX; }
        }
        return K_NONE;
    }
    if ((pat[pn - 1] as u32) == 47) {
        if (starts_at(text, aa, bb, pat, p0, pn)) { return K_PREFIX; }
        return K_NONE;
    }
    if (bb - aa == pn - p0) {
        if (starts_at(text, aa, bb, pat, p0, pn)) { return K_EXACT; }
    }
    return K_NONE;
}

/// Specificity of a pattern: its length after the "t27/" skip, exact beats prefix on equal length.
pub fn pat_score(pat: string, kind: u32) -> u32 {
    var sc : u32 = ((pat.len as u32) - pat_skip(pat)) * 2;
    if (kind == K_EXACT) { sc = sc + 1; }
    return sc;
}

/// Owner of the path text[a..b) as letter * 4 + kind (0 = unowned).
pub fn owner_range(text: string, aa: u32, bb: u32) -> u32 {
    var best : u32 = 0;
    var best_score : u32 = 0;
    var ii : u32 = 0;
    while (ii < AGENT_COUNT) {
        var jj : u32 = 0;
        const nn : u32 = key_n(ii);
        while (jj < nn) {
            const pat : string = key_at(ii, jj);
            const kd : u32 = match_kind(text, aa, bb, pat);
            if (kd != K_NONE) {
                const sc : u32 = pat_score(pat, kd);
                if (sc > best_score) { best_score = sc; best = (ii + 1) * 4 + kd; }
            }
            jj = jj + 1;
        }
        ii = ii + 1;
    }
    return best;
}

pub fn letter_of_path(path: string) -> u32 {
    return owner_range(path, 0, path.len as u32) / 4;
}

pub fn kind_of_path(path: string) -> u32 {
    return owner_range(path, 0, path.len as u32) % 4;
}

/// CONFIRMED when the owner is an exact KEY_FILES path, GUESS when a prefix or glob (or nobody) decided it.
pub fn path_label(path: string) -> u32 {
    if (kind_of_path(path) == K_EXACT) { return LABEL_CONFIRMED; }
    return LABEL_GUESS;
}

pub fn label_text(ll: u32) -> string {
    if (ll == LABEL_CONFIRMED) { return "CONFIRMED"; }
    return "GUESS";
}

// ------------------------------------------------------------ parsing the log

/// Start of the next record (a 0x1e byte) at or after at, or the text length.
pub fn rec_next(log: string, at: u32) -> u32 {
    var ii : u32 = at;
    while (ii < (log.len as u32)) {
        if ((log[ii] as u32) == RS) { return ii; }
        ii = ii + 1;
    }
    return log.len as u32;
}

/// Start of the byte after the first byte equal to c, from at, bounded by end; NONE if absent.
pub fn after_byte(log: string, at: u32, end: u32, cc: u32) -> u32 {
    var ii : u32 = at;
    while (ii < end) {
        if ((log[ii] as u32) == cc) { return ii + 1; }
        ii = ii + 1;
    }
    return NONE;
}

/// The commit time of the record that starts at rs (the 0x1e byte), 0 if malformed.
pub fn rec_time(log: string, rs: u32, end: u32) -> u64 {
    const hh : u32 = after_byte(log, rs + 1, end, US);
    if (hh == NONE) { return 0; }
    var ii : u32 = hh;
    var vv : u64 = 0;
    while (ii < end) {
        const cc : u32 = log[ii] as u32;
        if (cc < 48) { return vv; }
        if (cc > 57) { return vv; }
        vv = vv * 10 + ((cc - 48) as u64);
        ii = ii + 1;
    }
    return vv;
}

/// Where the subject of the record starts (after the second 0x1f), or NONE.
pub fn subject_start(log: string, rs: u32) -> u32 {
    const end : u32 = rec_next(log, rs + 1);
    const hh : u32 = after_byte(log, rs + 1, end, US);
    if (hh == NONE) { return NONE; }
    return after_byte(log, hh, end, US);
}

/// Length of the subject: up to the first newline.
pub fn subject_len(log: string, rs: u32) -> u32 {
    const ss : u32 = subject_start(log, rs);
    if (ss == NONE) { return 0; }
    const end : u32 = rec_next(log, rs + 1);
    var ii : u32 = ss;
    while (ii < end) {
        if ((log[ii] as u32) == NL) { return ii - ss; }
        ii = ii + 1;
    }
    return end - ss;
}

/// Subject length shown in one line: trailing spaces dropped, then cut to max - 3 if longer than max (the window adds "...").
pub fn trim_len(log: string, rs: u32, max: u32) -> u32 {
    const ss : u32 = subject_start(log, rs);
    var nn : u32 = subject_len(log, rs);
    while (nn > 0) {
        if ((log[ss + nn - 1] as u32) != 32) { break; }
        nn = nn - 1;
    }
    if (nn > max) { return max - 3; }
    return nn;
}

pub fn trim_dots(log: string, rs: u32, max: u32) -> bool {
    const ss : u32 = subject_start(log, rs);
    if (ss == NONE) { return false; }
    return subject_len(log, rs) > max;
}

/// Start of the file list of the record: after the subject line and the blank line.
pub fn files_start(log: string, rs: u32) -> u32 {
    const end : u32 = rec_next(log, rs + 1);
    const ss : u32 = subject_start(log, rs);
    if (ss == NONE) { return end; }
    var ii : u32 = ss + subject_len(log, rs);
    while (ii < end) {
        if ((log[ii] as u32) != NL) { return ii; }
        ii = ii + 1;
    }
    return end;
}

/// One pass over the log for letter L (0 = unowned); what picks the result:
///   W_COMMITS   commits no older than arg seconds that touch L
///   W_FILES     files of L in those commits
///   W_LAST      time of the newest commit touching L (arg unused)
///   W_BUCKET    commits touching L in day bucket arg (0 = last 24 h, 6 = 144..168 h)
///   W_LAST_REC  start offset of the newest commit touching L, or NONE
///   W_OPEN      files of L in the last 7 d whose owner is a GUESS (prefix or glob) or nobody
pub fn scan(log: string, now: u64, letter: u32, what: u32, arg: u64) -> u64 {
    var acc : u64 = 0;
    var best_rec : u64 = NONE as u64;
    var rs : u32 = rec_next(log, 0);
    const total : u32 = log.len as u32;
    while (rs < total) {
        const end : u32 = rec_next(log, rs + 1);
        const tt : u64 = rec_time(log, rs, end);
        var hit : u64 = 0;
        var open : u64 = 0;
        var pp : u32 = files_start(log, rs);
        while (pp < end) {
            var qq : u32 = pp;
            while (qq < end) {
                if ((log[qq] as u32) == NL) { break; }
                qq = qq + 1;
            }
            if (qq > pp) {
                const oo : u32 = owner_range(log, pp, qq);
                if (oo / 4 == letter) {
                    hit = hit + 1;
                    if (oo % 4 != K_EXACT) { open = open + 1; }
                }
            }
            pp = qq + 1;
        }
        if (hit > 0) {
            if (what == W_COMMITS) { if (now - tt < arg) { acc = acc + 1; } }
            if (what == W_FILES) { if (now - tt < arg) { acc = acc + hit; } }
            if (what == W_LAST) { if (tt > acc) { acc = tt; } }
            if (what == W_BUCKET) {
                if (now - tt >= arg * DAY) { if (now - tt < (arg + 1) * DAY) { acc = acc + 1; } }
            }
            if (what == W_LAST_REC) { if (tt > acc) { acc = tt; best_rec = rs as u64; } }
            if (what == W_OPEN) { if (now - tt < WEEK) { acc = acc + open; } }
        }
        rs = end;
    }
    if (what == W_LAST_REC) { return best_rec; }
    return acc;
}

pub fn commits_24h(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_COMMITS, DAY); }
pub fn commits_7d(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_COMMITS, WEEK); }
pub fn files_7d(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_FILES, WEEK); }
pub fn last_active(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_LAST, 0); }
pub fn spark(log: string, now: u64, letter: u32, day: u32) -> u64 { return scan(log, now, letter, W_BUCKET, day as u64); }
pub fn open_count(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_OPEN, 0); }
pub fn last_rec(log: string, now: u64, letter: u32) -> u64 { return scan(log, now, letter, W_LAST_REC, 0); }

/// Day bucket (0 = last 24 h) of an age in seconds; BUCKETS when older than a week.
pub fn bucket_of(age: u64) -> u32 {
    if (age >= WEEK) { return BUCKETS; }
    return (age / DAY) as u32;
}

/// Label of the per-letter attribution: CONFIRMED only when files were touched and none is open.
pub fn letter_label(files: u64, open: u64) -> u32 {
    if (files > 0) { if (open == 0) { return LABEL_CONFIRMED; } }
    return LABEL_GUESS;
}

// ------------------------------------------------------------ lamp

/// Is a path of letter L named in the red list (one path per line)?
pub fn is_blocked(red: string, letter: u32) -> bool {
    var pp : u32 = 0;
    const nn : u32 = red.len as u32;
    while (pp < nn) {
        var qq : u32 = pp;
        while (qq < nn) {
            if ((red[qq] as u32) == NL) { break; }
            qq = qq + 1;
        }
        if (qq > pp) { if (owner_range(red, pp, qq) / 4 == letter) { return true; } }
        pp = qq + 1;
    }
    return false;
}

/// ACTIVE under 24 h, WARM under 7 d, else QUIET; BLOCKED wins. last = 0 means never.
pub fn status_of(now: u64, last: u64, blocked: bool) -> u32 {
    if (blocked) { return ST_BLOCKED; }
    if (last == 0) { return ST_QUIET; }
    if (now - last < DAY) { return ST_ACTIVE; }
    if (now - last < WEEK) { return ST_WARM; }
    return ST_QUIET;
}

pub fn status_text(ss: u32) -> string {
    if (ss == ST_ACTIVE) { return "ACTIVE"; }
    if (ss == ST_WARM) { return "WARM"; }
    if (ss == ST_BLOCKED) { return "BLOCKED"; }
    return "QUIET";
}

/// Default action verb of the lamp; the window appends action_target(letter) after "run tri test on".
pub fn action_verb(ss: u32) -> string {
    if (ss == ST_BLOCKED) { return "fix the red check in"; }
    if (ss == ST_ACTIVE) { return "open last PR"; }
    if (ss == ST_WARM) { return "open last PR"; }
    return "run tri test on";
}

pub fn action_target(letter: u32) -> string {
    if (letter == 0) { return "-"; }
    if (key_n(letter - 1) == 0) { return "-"; }
    return key_at(letter - 1, 0);
}

// ------------------------------------------------------------ open PRs: lines "pr <number> <path>"

/// End of the number token after "pr " on the line that starts at p, or NONE.
pub fn pr_num_end(prs: string, pp: u32, nn: u32) -> u32 {
    if (pp + 3 > nn) { return NONE; }
    if ((prs[pp] as u32) != 112) { return NONE; }
    if ((prs[pp + 1] as u32) != 114) { return NONE; }
    if ((prs[pp + 2] as u32) != 32) { return NONE; }
    var kk : u32 = pp + 3;
    while (kk < nn) {
        if ((prs[kk] as u32) == 32) { return kk; }
        if ((prs[kk] as u32) == NL) { return NONE; }
        kk = kk + 1;
    }
    return NONE;
}

pub fn same_token(tt: string, aa: u32, bb: u32, cc: u32, dd: u32) -> bool {
    if (bb - aa != dd - cc) { return false; }
    var kk : u32 = 0;
    while (kk < bb - aa) {
        if ((tt[aa + kk] as u32) != (tt[cc + kk] as u32)) { return false; }
        kk = kk + 1;
    }
    return true;
}

/// Open PRs touching letter L: each PR number counted once.
pub fn pr_count(prs: string, letter: u32) -> u32 {
    var cnt : u32 = 0;
    var pp : u32 = 0;
    const nn : u32 = prs.len as u32;
    while (pp < nn) {
        var qq : u32 = pp;
        while (qq < nn) {
            if ((prs[qq] as u32) == NL) { break; }
            qq = qq + 1;
        }
        const ne : u32 = pr_num_end(prs, pp, qq);
        if (ne != NONE) {
            if (owner_range(prs, ne + 1, qq) / 4 == letter) {
                var seen : bool = false;
                var rr : u32 = 0;
                while (rr < pp) {
                    var ss : u32 = rr;
                    while (ss < pp) {
                        if ((prs[ss] as u32) == NL) { break; }
                        ss = ss + 1;
                    }
                    const e2 : u32 = pr_num_end(prs, rr, ss);
                    if (e2 != NONE) {
                        if (same_token(prs, pp + 3, ne, rr + 3, e2)) {
                            if (owner_range(prs, e2 + 1, ss) / 4 == letter) { seen = true; }
                        }
                    }
                    rr = ss + 1;
                }
                if (!seen) { cnt = cnt + 1; }
            }
        }
        pp = qq + 1;
    }
    return cnt;
}

// ------------------------------------------------------------ tests

test path_letter_known {
    assert letter_of_path("SOUL.md") == 1;
    assert kind_of_path("SOUL.md") == K_EXACT;
    assert letter_of_path("architecture/ADR-0001.md") == 1;
    assert kind_of_path("architecture/ADR-0001.md") == K_PREFIX;
    assert letter_of_path("architecture/ADR.md") == 0;
    assert letter_of_path(".github/workflows/ci.yml") == 2;
    assert letter_of_path("specs/automation/x.t27") == 10;
    assert letter_of_path("scripts/x.py") == 2;
    assert letter_of_path("bootstrap/src/compiler.rs") == 3;
    assert letter_of_path("bindings/py/x.py") == 24;
    assert letter_of_path("specs/depin/prove.t27") == 25;
    assert letter_of_path("docs/readme.md") == 26;
    assert letter_of_path("specs/isa/registers.t27") == 9;
    assert letter_of_path("specs/t27os/bench.t27") == 26;
    assert kind_of_path("specs/t27os/bench.t27") == K_PREFIX;
    assert letter_of_path("nothing/here.txt") == 0;
    assert letter_of_path("") == 0;
}

/// The 15 directories that changed most in 14 days of git history (git log origin/master --since=14.days
/// --name-only), one path in each: every one is owned by some real letter (the KEY_FILES are not stale).
test top_directories_are_owned {
    assert letter_of_path(".trinity/seals/x.json") == 2;
    assert letter_of_path("docs/now/x.md") == 5;
    assert letter_of_path("specs/port/x.t27") == 4;
    assert letter_of_path("bootstrap/tests/x.rs") == 3;
    assert letter_of_path("specs/tri/x.t27") == 12;
    assert letter_of_path("scripts/x.py") == 2;
    assert letter_of_path("specs/analog/x.t27") == 16;
    assert letter_of_path("specs/tools/x.t27") == 19;
    assert letter_of_path("gen/rust/x.rs") == 3;
    assert letter_of_path("specs/ml/x.t27") == 8;
    assert letter_of_path("specs/t27f/x.t27") == 26;
    assert letter_of_path("specs/fpga/x.t27") == 11;
    assert letter_of_path("gen/c/x.c") == 3;
    assert letter_of_path("specs/queen/x.t27") == 20;
    assert letter_of_path("specs/widgets/x.t27") == 26;
    assert letter_of_path("cli/t27b/x.rs") == 11;
    assert letter_of_path("specs/t27os/x.t27") != 0;
}

test path_labels {
    assert path_label("SOUL.md") == LABEL_CONFIRMED;
    assert path_label("specs/t27os/bench.t27") == LABEL_GUESS;
    assert path_label("nothing/here.txt") == LABEL_GUESS;
    assert label_text(LABEL_CONFIRMED) == "CONFIRMED";
    assert label_text(LABEL_GUESS) == "GUESS";
    assert letter_label(3, 0) == LABEL_CONFIRMED;
    assert letter_label(3, 1) == LABEL_GUESS;
    assert letter_label(0, 0) == LABEL_GUESS;
}

test agents_by_use {
    assert key_n(0) == 7;
    assert key_n(26) == 2;
    assert key_at(0, 0) == "SOUL.md";
    assert domain_of(1) == "Architecture / ADR / SOUL";
    assert domain_of(0) == "UNOWNED";
    assert letter_name(1) == "A";
    assert action_target(2) == ".github/workflows/";
    assert action_target(0) == "-";
    assert action_target(27) == "specs/sandbox/";
    assert action_target(28) == "-";
}

test buckets_and_status {
    assert bucket_of(0) == 0;
    assert bucket_of(86399) == 0;
    assert bucket_of(86400) == 1;
    assert bucket_of(604799) == 6;
    assert bucket_of(604800) == 7;
    assert status_of(1000000, 999000, false) == ST_ACTIVE;
    assert status_of(1000000, 1000000 - 86400, false) == ST_WARM;
    assert status_of(1000000, 1000000 - 604799, false) == ST_WARM;
    assert status_of(1000000, 1000000 - 604800, false) == ST_QUIET;
    assert status_of(1000000, 0, false) == ST_QUIET;
    assert status_of(1000000, 999999, true) == ST_BLOCKED;
    assert status_text(ST_BLOCKED) == "BLOCKED";
    assert status_text(ST_ACTIVE) == "ACTIVE";
    assert action_verb(ST_ACTIVE) == "open last PR";
    assert action_verb(ST_QUIET) == "run tri test on";
    assert action_verb(ST_BLOCKED) == "fix the red check in";
}

test red_and_prs {
    assert is_blocked("scripts/a.py\nREADME-none.txt\n", 2) == true;
    assert is_blocked("scripts/a.py\n", 1) == false;
    assert is_blocked("", 2) == false;
    assert is_blocked("nothing/here.txt\n", 0) == true;
    const prs : string = "pr 7 scripts/a.py\npr 7 scripts/x.py\npr 8 scripts/a.py\npr 8 SOUL.md\npr 9 nothing/z\n";
    assert pr_count(prs, 2) == 2;
    assert pr_count(prs, 1) == 1;
    assert pr_count(prs, 0) == 1;
    assert pr_count(prs, 3) == 0;
    assert pr_count("", 2) == 0;
}

test trim_subject {
    const lg : string = "\x1eabc\x1f100\x1fshort subject   \n\nSOUL.md\n\x1edef\x1f200\x1f0123456789\n\nscripts/a.py\n";
    assert subject_len(lg, 0) == 16;
    assert trim_len(lg, 0, 40) == 13;
    assert trim_dots(lg, 0, 40) == false;
    assert subject_len(lg, 35) == 10;
    assert trim_len(lg, 35, 8) == 5;
    assert trim_dots(lg, 35, 8) == true;
    assert rec_time(lg, 0, rec_next(lg, 1)) == 100;
    assert commits_7d(lg, 350, 1) == 1;
    assert commits_7d(lg, 350, 2) == 1;
    assert last_active(lg, 350, 2) == 200;
    assert last_active(lg, 350, 3) == 0;
}


test real_sample_two_days {
    // git log origin/master --since=2.days, 9 records (the 374-file gen-c record left out), as of now = 1792482900
    const log : string = "\x1e1417e3bee41ce45285895098c9c9e6f7503c4614\x1f1792482823\x1fT27 OS keys: read and write through /usr/bin/security (no Keychain dialogs after rebuilds), several keys per provider in the KEYS tab (#11276)\n\n.trinity/seals/t27os_T27osKeys.json\n.trinity/seals/t27os_T27osPtyLogic.json\ndocs/t27os/keys-orchestration.md\ndocs/t27os/run-local.md\nspecs/t27os/glass_window.t27\nspecs/t27os/keys.t27\nspecs/t27os/keys_host.t27\nspecs/t27os/pty_logic.t27\n\x1ee3bb9ffec885a75ec411d05cf602d07620d1d0cb\x1f1792482450\x1ft27os: bench.t27 -- the boards, provenance of every number and the project summary a BENCH tab draws (Closes #11264) (#11267)\n\n.trinity/seals/t27os_T27osBench.json\nspecs/t27os/bench.t27\n\x1e10eeeb572d83e76b573f3a78d6e7b356ee0d7249\x1f1792482279\x1fT27 OS: matte glass everywhere in a window, black in full screen, panels narrow the terminal, KEYS foot rows, terminal clicks stay in the terminal (#11266)\n\n.trinity/seals/t27os_T27osEditors.json\n.trinity/seals/t27os_T27osTermPane.json\nspecs/t27os/editors.t27\nspecs/t27os/glass_window.t27\n\x1e339a2d31b481b8cb163ec8e07acfc25203dc7987\x1f1792481450\x1ft27os: CHAT is the third petal; homes registry and the home tabs t27a..t27u (Closes #11260) (#11261)\n\n.trinity/seals/lab_LabJobKind.json\n.trinity/seals/t27os_T27osHomes.json\nspecs/lab/job_kind.t27\nspecs/t27f/petal_menu.t27\nspecs/t27os/glass_window.t27\nspecs/t27os/homes.t27\n\x1eae97ff06d79f1ba6918d9ee71a813210e5b02f40\x1f1792480490\x1ft27o: second golden port -- csr_map.rs to specs/host/csr_map.t27 (Closes #11235) (#11255)\n\n.trinity/seals/host_HostCsrMap.json\nbootstrap/gen/rust/host/csr_map.rs\nbootstrap/src/host/csr_map.rs\nbootstrap/src/host/mod.rs\nspecs/host/csr_map.t27\n\x1e156e4c6c2c48a19051f99ebd269b443f6ce6ebd7\x1f1792480444\x1fseals: keys.t27 and pty_logic.t27 resealed with the current compiler (gen_hash_c drift on master) (Closes #11241) (#11257)\n\n.trinity/seals/t27os_T27osKeys.json\n.trinity/seals/t27os_T27osPtyLogic.json\n\x1eef2e7ee45ac24638026cd9f6bc808ab6c7199b0b\x1f1792479843\x1fT27 OS keys: every stored key in rotation, failover on overload, restored panes wait for their keys (#11256)\n\n.trinity/seals/t27os_T27osKeys.json\n.trinity/seals/t27os_T27osPtyLogic.json\nspecs/t27os/glass_window.t27\nspecs/t27os/keys.t27\nspecs/t27os/keys_host.t27\nspecs/t27os/pty_logic.t27\nspecs/t27os/pty_server.t27\n\x1ee10a1bb7cead1b9f8406469848efb26db9bfbbbb\x1f1792478937\x1fT27 OS: key manager and KEYS tab, key orchestration, glass window, 27 editors and the editor inside the window (#11254)\n\ndocs/reports/t27b_expectations.json\ndocs/t27os/keys-orchestration.md\nspecs/t27os/doctor.t27\nspecs/t27os/editors.t27\nspecs/t27os/editors_host.t27\nspecs/t27os/glass_window.t27\nspecs/t27os/keys.t27\nspecs/t27os/keys_host.t27\nspecs/t27os/pty_client.t27\nspecs/t27os/pty_logic.t27\nspecs/t27os/pty_proto.t27\nspecs/t27os/pty_server.t27\nspecs/t27os/pty_sys.t27\nspecs/t27os/queen.t27\nspecs/t27os/router.t27\nspecs/t27os/term_pane.t27\ntools/verilog_width_baseline.txt\n\x1e9a3c8394a6e365b12a26999c56746de506bf2eb5\x1f1792478563\x1fhive-proxy.t27: who may spend a stored provider key over the Anthropic protocol; queen-contributor-keys v3 (#11253)\n\n.trinity/seals/automation_automation::hive_proxy.json\n.trinity/seals/automation_automation::queen_contributor_keys.json\nspecs/automation/hive-proxy.t27\nspecs/automation/queen-contributor-keys.t27\n";
    const now : u64 = 1792482900;
    // unowned is empty now: every one of the 55 files has a letter (before the KEY_FILES refresh: 18 unowned, 33 S, 4 Z)
    assert commits_24h(log, now, 0) == 0;
    assert files_7d(log, now, 0) == 0;
    assert open_count(log, now, 0) == 0;
    assert last_active(log, now, 0) == 0;
    // B (2): seals and tools
    assert commits_24h(log, now, 2) == 9;
    assert commits_7d(log, now, 2) == 9;
    assert files_7d(log, now, 2) == 15;
    assert last_active(log, now, 2) == 1792482823;
    assert spark(log, now, 2, 0) == 9;
    // C (3): bootstrap/src/host, bootstrap/gen/rust/host
    assert commits_7d(log, now, 3) == 1;
    assert files_7d(log, now, 3) == 3;
    assert last_active(log, now, 3) == 1792480490;
    // J (10): specs/automation
    assert commits_7d(log, now, 10) == 1;
    assert files_7d(log, now, 10) == 2;
    // M (13): docs/reports
    assert commits_7d(log, now, 13) == 1;
    assert files_7d(log, now, 13) == 1;
    // S (19): the fallback now holds only specs/lab and specs/host
    assert commits_7d(log, now, 19) == 2;
    assert files_7d(log, now, 19) == 2;
    assert last_active(log, now, 19) == 1792481450;
    // Z (26): specs/t27os, specs/t27f, docs/t27os
    assert commits_24h(log, now, 26) == 6;
    assert commits_7d(log, now, 26) == 6;
    assert files_7d(log, now, 26) == 32;
    assert last_active(log, now, 26) == 1792482823;
    assert spark(log, now, 26, 0) == 6;
    assert open_count(log, now, 26) == 32;
    assert status_of(now, last_active(log, now, 26), false) == ST_ACTIVE;
    assert status_of(now, last_active(log, now, 7), false) == ST_QUIET;
    assert commits_7d(log, now, 7) == 0;
    assert spark(log, now, 26, 1) == 0;
}

test real_sample_what_is_happening {
    const log : string = "\x1e1417e3bee41ce45285895098c9c9e6f7503c4614\x1f1792482823\x1fT27 OS keys: read and write through /usr/bin/security (no Keychain dialogs after rebuilds), several keys per provider in the KEYS tab (#11276)\n\n.trinity/seals/t27os_T27osKeys.json\n.trinity/seals/t27os_T27osPtyLogic.json\ndocs/t27os/keys-orchestration.md\ndocs/t27os/run-local.md\nspecs/t27os/glass_window.t27\nspecs/t27os/keys.t27\nspecs/t27os/keys_host.t27\nspecs/t27os/pty_logic.t27\n\x1ee3bb9ffec885a75ec411d05cf602d07620d1d0cb\x1f1792482450\x1ft27os: bench.t27 -- the boards, provenance of every number and the project summary a BENCH tab draws (Closes #11264) (#11267)\n\n.trinity/seals/t27os_T27osBench.json\nspecs/t27os/bench.t27\n\x1e10eeeb572d83e76b573f3a78d6e7b356ee0d7249\x1f1792482279\x1fT27 OS: matte glass everywhere in a window, black in full screen, panels narrow the terminal, KEYS foot rows, terminal clicks stay in the terminal (#11266)\n\n.trinity/seals/t27os_T27osEditors.json\n.trinity/seals/t27os_T27osTermPane.json\nspecs/t27os/editors.t27\nspecs/t27os/glass_window.t27\n\x1e339a2d31b481b8cb163ec8e07acfc25203dc7987\x1f1792481450\x1ft27os: CHAT is the third petal; homes registry and the home tabs t27a..t27u (Closes #11260) (#11261)\n\n.trinity/seals/lab_LabJobKind.json\n.trinity/seals/t27os_T27osHomes.json\nspecs/lab/job_kind.t27\nspecs/t27f/petal_menu.t27\nspecs/t27os/glass_window.t27\nspecs/t27os/homes.t27\n\x1eae97ff06d79f1ba6918d9ee71a813210e5b02f40\x1f1792480490\x1ft27o: second golden port -- csr_map.rs to specs/host/csr_map.t27 (Closes #11235) (#11255)\n\n.trinity/seals/host_HostCsrMap.json\nbootstrap/gen/rust/host/csr_map.rs\nbootstrap/src/host/csr_map.rs\nbootstrap/src/host/mod.rs\nspecs/host/csr_map.t27\n\x1e156e4c6c2c48a19051f99ebd269b443f6ce6ebd7\x1f1792480444\x1fseals: keys.t27 and pty_logic.t27 resealed with the current compiler (gen_hash_c drift on master) (Closes #11241) (#11257)\n\n.trinity/seals/t27os_T27osKeys.json\n.trinity/seals/t27os_T27osPtyLogic.