    if (letter == 1) { return A::DOMAIN; }
    if (letter == 2) { return B::DOMAIN; }
    if (letter == 3) { return C::DOMAIN; }
    if (letter == 4) { return D::DOMAIN; }
    if (letter == 5) { return E::DOMAIN; }
    if (letter == 6) { return F::DOMAIN; }
    if (letter == 7) { return G::DOMAIN; }
    if (letter == 8) { return H::DOMAIN; }
    if (letter == 9) { return I::DOMAIN; }
    if (letter == 10) { return J::DOMAIN; }
    if (letter == 11) { return K::DOMAIN; }
    if (letter == 12) { return L::DOMAIN; }
    if (letter == 13) { return M::DOMAIN; }
    if (letter == 14) { return N::DOMAIN; }
    if (letter == 15) { return O::DOMAIN; }
    if (letter == 16) { return P::DOMAIN; }
    if (letter == 17) { return Q::DOMAIN; }
    if (letter == 18) { return R::DOMAIN; }
    if (letter == 19) { return S::DOMAIN; }
    if (letter == 20) { return T::DOMAIN; }
    if (letter == 21) { return U::DOMAIN; }
    if (letter == 22) { return V::DOMAIN; }
    if (letter == 23) { return W::DOMAIN; }
    if (letter == 24) { return X::DOMAIN; }
    if (letter == 25) { return Y::DOMAIN; }
    if (letter == 26) { return Z::DOMAIN; }
    if (letter == 27) { return ti::DOMAIN; }
    return "UNOWNED";
}

pub fn letter_name(letter: u32) -> string {
    if (letter == 1) { return A::LETTER; }
    if (letter == 2) { return B::LETTER; }
    if (letter == 3) { return C::LETTER; }
    if (letter == 4) { return D::LETTER; }
    if (letter == 5) { return E::LETTER; }
    if (letter == 6) { return F::LETTER; }
