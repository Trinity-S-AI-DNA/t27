    const now : u64 = 1792482900;
    const rec : u64 = last_rec(log, now, 26);
    assert rec != 4294967295;
    assert subject_len(log, rec as u32) == 142;
    assert (log[subject_start(log, rec as u32)] as u32) == 84;
    assert last_rec(log, now, 7) == 4294967295;
}

// The pin for specs/t27os/kanban.t27: kanban cannot import this module (its module-qualified KEY_FILES reads do
// not splice into an importer), so the host fills the letters field of each card from letter_of_path and this test
// holds the paths of kanban's SAMPLE to the letters written on those lines.
test kanban_sample_paths_are_owned_by_the_letters_of_its_lines {
    assert letter_of_path("specs/t27os/agent_parts.t27") == 26;
    assert letter_of_path("specs/t27os/homes.t27") == 26;
    assert letter_of_path("specs/automation/x.t27") == 10;
    assert letter_of_path("specs/t27os/pty_server.t27") == 26;
    assert letter_of_path("specs/t27os/keys.t27") == 26;
    assert letter_of_path("specs/t27f/widget_factory.t27") == 26;
    assert letter_of_path("bootstrap/src/compiler.rs") == 3;
    assert letter_of_path(".trinity/seals/t27os_T27osHomes.json") == 2;
    assert letter_of_path("docs/now/x.md") == 5;
}
