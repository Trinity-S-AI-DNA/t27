// SPDX-License-Identifier: Apache-2.0
; specs/t27os/domain_pulse.t27 -- end-to-end analytics by agent domain for T27 OS: what is happening in the project.
; Owner, 2026-10-20: T27 OS is a spaceship instrument panel; one glance shows which of the 27 agent domains moves,
; which is quiet, which is blocked. This file is the data model only (pure, tested); the window draws it later.
; --
; HOW PATHS MAP (DRY): by `use`, not by a second table. Every agent module specs/agents/<l>.t27 already owns
; KEY_FILES and DOMAIN; this file reads them (use agents::a; ... a::KEY_FILES). A pattern is an exact file
; ("SOUL.md"), a directory prefix (".github/workflows/") or a glob with one '*' ("architecture/ADR-*.md"). A leading
; "t27/" of a pattern is dropped (the alphabet predates the repo root being t27). The LONGEST matching pattern wins,
; ties go to the lowest letter. Letter code: 1 = A .. 26 = Z, 27 = Ti, 0 = UNOWNED (counted, never dropped).
; --
; LABELS (reverse-engineering discipline: every claim is CONFIRMED or GUESS):
;   CONFIRMED  read from git output (commit time, subject, file list) or matched by an EXACT KEY_FILES path.
;   GUESS      inferred: a path owned only because a directory prefix or glob of KEY_FILES covers it.
;   OPEN       per letter, the files touched whose owner is a GUESS or nobody: the open questions of the domain.
; --
; WHAT THE HOST MUST RUN AND WRITE (this file runs no command):
;   log   git log --since=7.days --name-only --format=%x1e%H%x1f%ct%x1f%s
;         record separator 0x1e, field separator 0x1f; after the subject a newline, a blank line, then one path per line.
;   now   unix seconds of the host clock
;   red   one path per line: the paths of the failing CI checks (empty text = nothing red)
;   prs   one line per (PR, file): "pr <number> <path>\n"; the host writes it from `gh pr list --state open
;         --json number,files` (the JSON is plumbing, this file does not parse it)
; Commits in the log that touch no owned path count under letter 0.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osDomainPulse;

use agents::A;
use agents::B;
use agents::C;
use agents::D;
use agents::E;
use agents::F;
use agents::G;
use agents::H;
use agents::I;
use agents::J;
use agents::K;
use agents::L;
use agents::M;
use agents::N;
use agents::O;
use agents::P;
use agents::Q;
use agents::R;
use agents::S;
use agents::T;
use agents::U;
use agents::V;
use agents::W;
use agents::X;
use agents::Y;
use agents::Z;
use agents::ti;

pub const AGENT_COUNT : u32 = 27;
pub const UNOWNED : u32 = 0;
pub const DAY : u64 = 86400;
pub const WEEK : u64 = 604800;
pub const BUCKETS : u32 = 7;

pub const RS : u32 = 30;
pub const US : u32 = 31;
pub const NL : u32 = 10;
pub const NONE : u32 = 4294967295;

; kind of a path match
pub const K_NONE : u32 = 0;
pub const K_EXACT : u32 = 1;
pub const K_PREFIX : u32 = 2;

; labels
pub const LABEL_CONFIRMED : u32 = 0;
pub const LABEL_GUESS : u32 = 1;

; lamp
pub const ST_QUIET : u32 = 1;
pub const ST_WARM : u32 = 2;
pub const ST_ACTIVE : u32 = 3;
pub const ST_BLOCKED : u32 = 4;

; what scan() computes
pub const W_COMMITS : u32 = 0;
pub const W_FILES : u32 = 1;
pub const W_LAST : u32 = 2;
pub const W_BUCKET : u32 = 3;
pub const W_LAST_REC : u32 = 4;
pub const W_OPEN : u32 = 5;

// ------------------------------------------------------------ the agents, read by use

pub fn key_n(ii: u32) -> u32 {
    if (ii == 0) { return A::KEY_FILES.len as u32; }
    if (ii == 1) { return B::KEY_FILES.len as u32; }
    if (ii == 2) { return C::KEY_FILES.len as u32; }
    if (ii == 3) { return D::KEY_FILES.len as u32; }
    if (ii == 4) { return E::KEY_FILES.len as u32; }
    if (ii == 5) { return F::KEY_FILES.len as u32; }
    if (ii == 6) { return G::KEY_FILES.len as u32; }
    if (ii == 7) { return H::KEY_FILES.len as u32; }
    if (ii == 8) { return I::KEY_FILES.len as u32; }
    if (ii == 9) { return J::KEY_FILES.len as u32; }
    if (ii == 10) { return K::KEY_FILES.len as u32; }
    if (ii == 11) { return L::KEY_FILES.len as u32; }
    if (ii == 12) { return M::KEY_FILES.len as u32; }
    if (ii == 13) { return N::KEY_FILES.len as u32; }
    if (ii == 14) { return O::KEY_FILES.len as u32; }
    if (ii == 15) { return P::KEY_FILES.len as u32; }
    if (ii == 16) { return Q::KEY_FILES.len as u32; }
    if (ii == 17) { return R::KEY_FILES.len as u32; }
    if (ii == 18) { return S::KEY_FILES.len as u32; }
    if (ii == 19) { return T::KEY_FILES.len as u32; }
    if (ii == 20) { return U::KEY_FILES.len as u32; }
    if (ii == 21) { return V::KEY_FILES.len as u32; }
    if (ii == 22) { return W::KEY_FILES.len as u32; }
    if (ii == 23) { return X::KEY_FILES.len as u32; }
    if (ii == 24) { return Y::KEY_FILES.len as u32; }
    if (ii == 25) { return Z::KEY_FILES.len as u32; }
    if (ii == 26) { return ti::KEY_FILES.len as u32; }
    return 0;
}

pub fn key_at(ii: u32, jj: u32) -> string {
    if (ii == 0) { if (jj < A::KEY_FILES.len as u32) { return A::KEY_FILES[jj]; } }
    if (ii == 1) { if (jj < B::KEY_FILES.len as u32) { return B::KEY_FILES[jj]; } }
    if (ii == 2) { if (jj < C::KEY_FILES.len as u32) { return C::KEY_FILES[jj]; } }
    if (ii == 3) { if (jj < D::KEY_FILES.len as u32) { return D::KEY_FILES[jj]; } }
    if (ii == 4) { if (jj < E::KEY_FILES.len as u32) { return E::KEY_FILES[jj]; } }
    if (ii == 5) { if (jj < F::KEY_FILES.len as u32) { return F::KEY_FILES[jj]; } }
    if (ii == 6) { if (jj < G::KEY_FILES.len as u32) { return G::KEY_FILES[jj]; } }
    if (ii == 7) { if (jj < H::KEY_FILES.len as u32) { return H::KEY_FILES[jj]; } }
    if (ii == 8) { if (jj < I::KEY_FILES.len as u32) { return I::KEY_FILES[jj]; } }
    if (ii == 9) { if (jj < J::KEY_FILES.len as u32) { return J::KEY_FILES[jj]; } }
    if (ii == 10) { if (jj < K::KEY_FILES.len as u32) { return K::KEY_FILES[jj]; } }
    if (ii == 11) { if (jj < L::KEY_FILES.len as u32) { return L::KEY_FILES[jj]; } }
    if (ii == 12) { if (jj < M::KEY_FILES.len as u32) { return M::KEY_FILES[jj]; } }
    if (ii == 13) { if (jj < N::KEY_FILES.len as u32) { return N::KEY_FILES[jj]; } }
    if (ii == 14) { if (jj < O::KEY_FILES.len as u32) { return O::KEY_FILES[jj]; } }
    if (ii == 15) { if (jj < P::KEY_FILES.len as u32) { return P::KEY_FILES[jj]; } }
    if (ii == 16) { if (jj < Q::KEY_FILES.len as u32) { return Q::KEY_FILES[jj]; } }
    if (ii == 17) { if (jj < R::KEY_FILES.len as u32) { return R::KEY_FILES[jj]; } }
    if (ii == 18) { if (jj < S::KEY_FILES.len as u32) { return S::KEY_FILES[jj]; } }
    if (ii == 19) { if (jj < T::KEY_FILES.len as u32) { return T::KEY_FILES[jj]; } }
    if (ii == 20) { if (jj < U::KEY_FILES.len as u32) { return U::KEY_FILES[jj]; } }
    if (ii == 21) { if (jj < V::KEY_FILES.len as u32) { return V::KEY_FILES[jj]; } }
    if (ii == 22) { if (jj < W::KEY_FILES.len as u32) { return W::KEY_FILES[jj]; } }
    if (ii == 23) { if (jj < X::KEY_FILES.len as u32) { return X::KEY_FILES[jj]; } }
    if (ii == 24) { if (jj < Y::KEY_FILES.len as u32) { return Y::KEY_FILES[jj]; } }
    if (ii == 25) { if (jj < Z::KEY_FILES.len as u32) { return Z::KEY_FILES[jj]; } }
    if (ii == 26) { if (jj < ti::KEY_FILES.len as u32) { return ti::KEY_FILES[jj]; } }
    return "";
}

