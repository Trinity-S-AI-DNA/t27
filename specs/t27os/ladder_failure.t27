// SPDX-License-Identifier: Apache-2.0
; Failure semantics of the T27 OS provider ladder, pinned as a machine-readable
; table (#14224, M0-P7, see #13473). The implementer is the serve loop
; (specs/t27os/ladder_serve.t27) over the rung law (specs/t27os/ladder.t27);
; this spec is the conformance table an operator reads instead of strace.
; Modes an operator must be able to tell apart, with the observable each one
; answers:
;   oversized_request  413 "request too large"   (#14215, #14212)
;   oversized_reply    502 "reply too large"     (#14216, #14217; never marks a rung unreachable)
;   refusal            503 "all rungs refused"   (law 3: the body names every tried rung with its class)
;   timeout            504 "rung timed out"      (new pin, this spec)
;   config_error       500 "ladder misconfigured" (new pin, this spec)
; An upstream provider failure is not its own top-level status: it surfaces as
; the rung class "noise" (transient 5xx, keeps its place) or "unreachable"
; (no HTTP answer at all) inside the 503 body, so the operator still sees which
; rung failed and why; nothing fails silently (FR-003). Only a quota-class
; refusal (429 quota, 402 unfunded) demotes a rung or marks its key bad; a
; timeout and an upstream failure keep their place (ladder.t27 demotes_rung).
; The caps values themselves stay in ladder.t27 and ladder_serve.t27 and are
; out of scope here.
module T27OsLadderFailure;

pub const MODE_COUNT : usize = 5;
pub const MODE_OVERSIZED_REQUEST : usize = 0;
pub const MODE_OVERSIZED_REPLY : usize = 1;
pub const MODE_REFUSAL : usize = 2;
pub const MODE_TIMEOUT : usize = 3;
pub const MODE_CONFIG_ERROR : usize = 4;
pub const MODE_NAMES : [5]str = ["oversized_request", "oversized_reply", "refusal", "timeout", "config_error"];
pub const MODE_STATUS : [5]u32 = [413, 502, 503, 504, 500];
pub const MODE_REASON : [5]str = ["request too large", "reply too large", "all rungs refused", "rung timed out", "ladder misconfigured"];

; the rung classes the 503 body names a tried rung by (ladder.t27 refusal_class)
pub const CLASS_COUNT : usize = 8;
pub const CLASSES : [8]str = ["ok", "unreachable", "unfunded", "quota", "denied", "noise", "client", "other"];

pub fn same_key(a : str, b : str) -> bool {
    let la : usize = a.len;
    let lb : usize = b.len;
    if la != lb { return false; }
    var i : usize = 0;
    while i < la {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

pub fn status_for(mode : usize) -> u32 {
    let m : usize = mode;
    if m >= MODE_COUNT { return 0; }
    return MODE_STATUS[m];
}

pub fn reason_for(mode : usize) -> str {
    let m : usize = mode;
    if m >= MODE_COUNT { return ""; }
    return MODE_REASON[m];
}

pub fn marks_rung_unreachable(mode : usize) -> bool {
    let m : usize = mode;
    if m >= MODE_COUNT { return true; }
    return false;
}

pub fn class_named(name : str) -> bool {
    var i : usize = 0;
    while i < CLASS_COUNT {
        if same_key(CLASSES[i], name) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn statuses_distinct() -> bool {
    var i : usize = 0;
    while i < MODE_COUNT {
        var j : usize = i + 1;
        while j < MODE_COUNT {
            if MODE_STATUS[i] == MODE_STATUS[j] { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

test every_failure_mode_answers_a_distinct_status {
    assert MODE_COUNT == 5;
    assert status_for(MODE_OVERSIZED_REQUEST) == 413;
    assert status_for(MODE_OVERSIZED_REPLY) == 502;
    assert status_for(MODE_REFUSAL) == 503;
    assert status_for(MODE_TIMEOUT) == 504;
    assert status_for(MODE_CONFIG_ERROR) == 500;
    assert statuses_distinct();
}

test oversized_request_is_413_and_oversized_reply_is_502 {
    assert same_key(reason_for(MODE_OVERSIZED_REQUEST), "request too large");
    assert same_key(reason_for(MODE_OVERSIZED_REPLY), "reply too large");
    assert same_key(MODE_NAMES[MODE_OVERSIZED_REQUEST], "oversized_request");
    assert same_key(MODE_NAMES[MODE_OVERSIZED_REPLY], "oversized_reply");
}

test oversized_reply_502_never_marks_a_rung_unreachable {
    assert marks_rung_unreachable(MODE_OVERSIZED_REPLY) == false;
    assert marks_rung_unreachable(MODE_OVERSIZED_REQUEST) == false;
    assert marks_rung_unreachable(MODE_TIMEOUT) == false;
    assert marks_rung_unreachable(MODE_REFUSAL) == false;
    assert marks_rung_unreachable(MODE_CONFIG_ERROR) == false;
    assert marks_rung_unreachable(9) == true;
}

test the_final_refusal_is_503_and_names_every_rung_class {
    assert status_for(MODE_REFUSAL) == 503;
    assert same_key(reason_for(MODE_REFUSAL), "all rungs refused");
    assert class_named("noise");
    assert class_named("unreachable");
    assert class_named("quota");
    assert class_named("unfunded");
    assert class_named("denied");
    assert class_named("client");
    assert class_named("ok");
    assert class_named("other");
    assert class_named("secret") == false;
}

test upstream_failure_is_visible_as_the_noise_class_not_silent {
    assert same_key(CLASSES[5], "noise");
    assert same_key(CLASSES[1], "unreachable");
    assert class_named("timeout") == false;
}

test a_timed_out_walk_answers_504_and_a_misconfigured_ladder_500 {
    assert status_for(MODE_TIMEOUT) == 504;
    assert same_key(reason_for(MODE_TIMEOUT), "rung timed out");
    assert status_for(MODE_CONFIG_ERROR) == 500;
    assert same_key(reason_for(MODE_CONFIG_ERROR), "ladder misconfigured");
    assert status_for(9) == 0;
    assert same_key(reason_for(9), "");
}
