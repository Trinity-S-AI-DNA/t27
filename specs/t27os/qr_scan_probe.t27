// SPDX-License-Identifier: Apache-2.0
// specs/t27os/qr_scan_probe.t27 -- a program that runs qr_scan.t27 on a grey picture file and times it. Not part of
// the app. Reads QS_FILE (a binary PGM, P5, at most QS_W_MAX x QS_H_MAX), prints one line:
//   <file> <reason> len=<n> text=<the text the code carries, when it reads> best_us=<fastest> mean_us=<mean>
// over QS_REPEAT runs of qs_scan_key (default 20; the clock is CLOCK_UPTIME_RAW). Exit 0 when the file was read.
// The frames it was written for are camera-like pictures of segno 1.6.6 codes (Pillow: turned, noisy, blurred,
// inverted, cut, damaged, a mild perspective), made by a throwaway script in /tmp; only test keys T27-TEST-... are in
// them. Build (Apple silicon):
//   t27b build specs/t27os/qr_scan_probe.t27 -o qsp.o --macho
//   ld -arch arm64 -platform_version macos 11.0 $(xcrun --show-sdk-version) -syslibroot $(xcrun --show-sdk-path) \
//      -e _main -lSystem -o qsp qsp.o
module T27osQrScanProbe;

use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::session_store::put_dec;
use t27os::session_store::put_bytes;
use t27os::peer_identity_host::ih_slurp;
use t27os::qr_scan::QS_W_MAX;
use t27os::qr_scan::QS_H_MAX;
use t27os::qr_scan::QS_TEXT_MAX;
use t27os::qr_scan::QS_OK;
use t27os::qr_scan::qs_pgm;
use t27os::qr_scan::qs_read;
use t27os::qr_scan::qs_reason;
use t27os::qr_scan::qs_len;
use t27os::qr_scan::qs_scan_key;

const QSP_CAP : usize = 1228900;
const QSP_PIX : usize = 1228800;

fn qsp_clock(id: u32) -> u64 { return @extern("clock_gettime_nsec_np"); }

fn qsp_env(name: []const u8, out: []u8) -> usize {
    const p : u64 = sys_getenv(name);
    if (p == 0) { return 0; }
    var n : u64 = sys_strlen(p);
    if (n >= @as(u64, out.len)) { n = @as(u64, out.len - 1); }
    if (n > 0) { sys_peek(out[0..@as(usize, n)], p, n); }
    out[@as(usize, n)] = 0;
    return @as(usize, n);
}

fn qsp_name(r: u32) -> []const u8 {
    if (r == 0) { return "OK"; }
    if (r == 1) { return "ARG"; }
    if (r == 2) { return "NO_CODE"; }
    if (r == 3) { return "GEOMETRY"; }
    if (r == 4) { return "FORMAT"; }
    if (r == 5) { return "LEVEL"; }
    if (r == 6) { return "ECC"; }
    if (r == 7) { return "MODE"; }
    return "NOT_KEY";
}

pub fn main() -> void {
    var path : [512]u8 = undefined;
    const pn : usize = qsp_env("QS_FILE", path[0..512]);
    var line : [400]u8 = undefined;
    if (pn == 0) {
        sys_write(2, "qr_scan_probe: set QS_FILE\n", 27);
        sys_exit(2);
    }
    var rb : [16]u8 = undefined;
    const rn : usize = qsp_env("QS_REPEAT", rb[0..16]);
    var rep : u64 = 20;
    if (rn > 0) {
        rep = 0;
        var i : usize = 0;
        while (i < rn) {
            rep = rep * 10 + @as(u64, rb[i] - 48);
            i = i + 1;
        }
    }
    if (rep == 0) { rep = 1; }
    var file : [QSP_CAP]u8 = undefined;
    const fnb : i64 = ih_slurp(path[0..pn + 1], file[0..QSP_CAP], QSP_CAP);
    var dims : [2]usize = [0, 0];
    var off : usize = 0;
    if (fnb > 0) { off = qs_pgm(file[0..QSP_CAP], @as(usize, @intCast(fnb)), dims[0..2]); }
    if (off == 0 or dims[0] > QS_W_MAX or dims[1] > QS_H_MAX) {
        sys_write(2, "qr_scan_probe: not a P5 PGM of at most 1280 x 960\n", 50);
        sys_exit(2);
    }
    const w : usize = dims[0];
    const h : usize = dims[1];
    var bin : [QSP_PIX]u8 = undefined;
    var text : [QS_TEXT_MAX]u8 = undefined;
    const tr : u32 = qs_read(file[off .. off + w * h], w, h, bin[0..QSP_PIX], text[0..QS_TEXT_MAX]);
    var key : [32]u8 = undefined;
    var verdict : u32 = 0;
    var best : u64 = 18446744073709551615;
    var sum : u64 = 0;
    var k : u64 = 0;
    while (k < rep) {
        const t0 : u64 = qsp_clock(8);
        verdict = qs_scan_key(file[off .. off + w * h], w, h, bin[0..QSP_PIX], key[0..32]);
        const dt : u64 = qsp_clock(8) - t0;
        sum = sum + dt;
        if (dt < best) { best = dt; }
        k = k + 1;
    }
    var n : usize = put_bytes(line[0..400], 0, path[0..pn]);
    n = put_bytes(line[0..400], n, " ");
    n = put_bytes(line[0..400], n, qsp_name(verdict));
    n = put_bytes(line[0..400], n, " ");
    n = put_dec(line[0..400], n, @as(u64, w));
    n = put_bytes(line[0..400], n, "x");
    n = put_dec(line[0..400], n, @as(u64, h));
    n = put_bytes(line[0..400], n, " len=");
    var tl : usize = 0;
    if (qs_reason(tr) == QS_OK) { tl = qs_len(tr); }
    n = put_dec(line[0..400], n, @as(u64, tl));
    n = put_bytes(line[0..400], n, " text=");
    n = put_bytes(line[0..400], n, text[0..tl]);
    n = put_bytes(line[0..400], n, " best_us=");
    n = put_dec(line[0..400], n, best / 1000);
    n = put_bytes(line[0..400], n, " mean_us=");
    n = put_dec(line[0..400], n, sum / rep / 1000);
    n = put_bytes(line[0..400], n, "\n");
    sys_write(1, line[0..n], @as(u64, n));
    sys_exit(0);
}
