// SPDX-License-Identifier: Apache-2.0
// specs/t27os/agent_homes.t27 -- Agent Homes: one home page per 27 agent letter.
// Built from UI Kit components and one shared Agent Home contract.
// Part of [EPIC] Agent Homes -- 27 Petals (#13862). Closes #13862.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::agent_homes {

    pub const MODULE : str = "t27os_agent_homes";
    pub const SURFACE : str = "agent_homes";
    pub const AGENT_COUNT : u8 = 27;
    pub const DEDICATED_PAGES : u8 = 8;
    pub const SHARED_PAGES : u8 = 18;

    // ---- Agent Home contract ---------------------------------------------
    pub struct AgentHome {
        letter : str,      // A .. TI
        name : str,
        domain : str,
        realm : str,
        glyph : str,
        purpose : str,
        live_status : str,   // "idle" | "active" | "blocked" | "not measured"
        widgets : str,
        surfaces : str,
        commands : str,
        skills : str,
        tests : str,       // "unit" | "contract" | "visual regression"
        accessibility : bool,
    };

    // ---- Data law ---------------------------------------------------------
    // Real data only from connected sources. No source: NOT MEASURED.
    pub fn status_is_real(source_connected: bool, value: str) -> bool {
        if (!source_connected) {
            return value == "NOT MEASURED";
        }
        return true;
    }

    // No invented value shown as a live metric.
    pub fn metric_is_honest(measured: bool, shown_as_live: bool) -> bool {
        return !shown_as_live || measured;
    }

    // Every source has an owner, refresh interval, failure state and test.
    pub fn source_complete(owner: bool, refresh: bool, failure: bool, has_test: bool) -> bool {
        return owner && refresh && failure && has_test;
    }

    // ---- Tests ------------------------------------------------------------
    test "27 agents, 8 dedicated petal pages, 18 shared pages" {
        assert(AGENT_COUNT == 27);
        assert(DEDICATED_PAGES == 8);
        assert(SHARED_PAGES == 18);
        assert(DEDICATED_PAGES + SHARED_PAGES + 1 == AGENT_COUNT); // +1 for CHAT (C) = the window itself
    }

    test "no source means NOT MEASURED, never an invented value" {
        assert(status_is_real(false, "NOT MEASURED"));
        assert(status_is_real(false, "NOT MEASURED") == true);
        assert(!status_is_real(false, "active"));
    }

    test "a live metric must be measured" {
        assert(metric_is_honest(true, true));
        assert(!metric_is_honest(false, true));
        assert(metric_is_honest(false, false));
    }

    test "every source has owner, refresh, failure and test" {
        assert(source_complete(true, true, true, true));
        assert(!source_complete(false, true, true, true));
        assert(!source_complete(true, false, true, true));
        assert(!source_complete(true, true, false, true));
        assert(!source_complete(true, true, true, false));
    }

    invariant agent_count_is_twenty_seven {
        assert AGENT_COUNT == 27;
    }

    invariant dedicated_plus_shared_plus_chat_equals_total {
        assert DEDICATED_PAGES + SHARED_PAGES + 1 == AGENT_COUNT; // +1 for CHAT (C) = the window itself
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
