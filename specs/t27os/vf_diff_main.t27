// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_diff_main.t27 -- host program for specs/t27f/vf_diff.t27: the pixel diff of two P6 frames (Refs
; gHashTag/t27#13426 milestone M0, Closes gHashTag/t27#13662). It reads the frame in DIFF_A and the frame in DIFF_B, both binary
; PPM P6 files with maxval 255 and the same width and height, calls vf_diff_count, vf_diff_bbox and vf_diff_frame from vf_diff
; (none of their logic is restated here), writes the difference frame as a P6 file of the same size to DIFF_OUT (default
; target/vf_diff.ppm, a path under the working directory, never /tmp) and prints one text summary line to stderr:
;   vf_diff: <count> pixels differ, bbox <x0>,<y0>-<x1>,<y1> (edges inclusive), frame <w>x<h>, wrote <n> bytes to <path>
; or `0 pixels differ` in place of the count and box when the frames match.
; --
; A changed pixel is red 0xFF0000 and an unchanged pixel a light grey of its own brightness (vf_diff_frame).
; --
; Refusals write nothing: a missing DIFF_A or DIFF_B, a file that cannot be opened, a header that is not `P6 <w> <h> 255`
; (comments in the header are refused), a width or height outside 1..4096, a raster over 2073600 pixels, a body whose length is
; not w * h * 3, or two frames of different sizes. Each exits 1 with ONE line that names the reason. An unopenable DIFF_OUT or a
; short write exits 2.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. A count of 0 says the bytes match, not that either frame looks right; a count above 0
; says how many pixels moved, not whether the move was the intended one.
; --
; BUILD AND RUN (a heavy build: on the lab or in a T27 OS pane, not on the Mac without the owner's word). This spec reads the
; environment and files through std.c, so t27c cannot compile it; build it with t27b.
;   t27b build specs/t27os/vf_diff_main.t27
;   DIFF_A=a.ppm DIFF_B=b.ppm DIFF_OUT=target/vf_diff.ppm ./vf_diff
; Module-level vars are never spliced by `use`, so the byte buffers live here and are passed to vf_diff as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfDiffMain;

use t27f::vf_diff::VfDiffBox;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_diff::vf_diff_bbox;
use t27f::vf_diff::vf_diff_frame;
use t27f::vf_diff::VF_D_OK;
use t27f::frame_render::ppm_header_len;
use t27f::frame_render::ppm_header_into;

; the largest accepted raster is frame_render's cap, 2073600 pixels: 6220800 RGB bytes, plus a header of at most 32 bytes
pub const VDM_MAX_PIXELS : u32 = 2073600;
pub const VDM_MAX_SIDE : u32 = 4096;
pub const VDM_RGB_CAP : usize = 6220800;
pub const VDM_RAW_CAP : usize = 6220832;

pub var VDM_RAW : [6220832]u8 = [0] ** 6220832;
pub var VDM_A : [6220800]u8 = [0] ** 6220800;
pub var VDM_B : [6220800]u8 = [0] ** 6220800;
pub var VDM_D : [6220800]u8 = [0] ** 6220800;
pub var VDM_HDR : [32]u8 = [0] ** 32;

; results of a header parse
pub const VDM_OK : u8 = 0;
pub const VDM_BAD_HDR : u8 = 1;
pub const VDM_BAD_SIDE : u8 = 2;
pub const VDM_BAD_LEN : u8 = 3;

; the parse of a P6 header: code, width, height and the offset of the first RGB byte
pub struct VdmHdr {
    code: u8,
    w: u32,
    h: u32,
    off: usize,
}

/// True for a PPM whitespace byte: space, tab, newline, carriage return.
pub fn vdm_is_ws(c: u8) -> bool {
    if (c == 32 or c == 9 or c == 10 or c == 13) { return true; }
    return false;
}

/// Parse `P6`, width, height and maxval 255 from the first n bytes of buf (never reading past buf.len), then check that the
/// bytes after the header number exactly w * h * 3. VDM_OK, or the first reason the file is refused.
pub fn vdm_parse(buf: []const u8, n: usize) -> VdmHdr {
    var r : VdmHdr = VdmHdr { code: VDM_BAD_HDR, w: 0, h: 0, off: 0 };
    var lim : usize = n;
    if (buf.len < lim) { lim = buf.len; }
    if (lim < 2) { return r; }
    if (buf[0] != 80) { return r; }
    if (buf[1] != 54) { return r; }
    var at : usize = 2;
    var f : u32 = 0;
    var w : u32 = 0;
    var h : u32 = 0;
    var mx : u32 = 0;
    while (f < 3) {
        if (at >= lim) { return r; }
        if (vdm_is_ws(buf[at]) == false) { return r; }
        while (at < lim and vdm_is_ws(buf[at])) { at += 1; }
        var v : u32 = 0;
        var d : u32 = 0;
        while (at < lim and buf[at] >= 48 and buf[at] <= 57 and d < 8) {
            v = v * 10 + ((buf[at] - 48) as u32);
            at += 1;
            d += 1;
        }
        if (d == 0) { return r; }
        if (f == 0) { w = v; }
        if (f == 1) { h = v; }
        if (f == 2) { mx = v; }
        f += 1;
    }
    if (at >= lim) { return r; }
    if (vdm_is_ws(buf[at]) == false) { return r; }
    at += 1;
    if (mx != 255) { return r; }
    r.w = w;
    r.h = h;
    r.off = at;
    if (w == 0 or h == 0 or w > VDM_MAX_SIDE or h > VDM_MAX_SIDE or w * h > VDM_MAX_PIXELS) {
        r.code = VDM_BAD_SIDE;
        return r;
    }
    const need : usize = (w * h * 3) as usize;
    if (n != at + need) {
        r.code = VDM_BAD_LEN;
        return r;
    }
    r.code = VDM_OK;
    return r;
}

/// Why a file was refused, for the error line.
pub fn vdm_why(code: u8) -> str {
    if (code == VDM_BAD_HDR) { return "has no P6 <w> <h> 255 header"; }
    if (code == VDM_BAD_SIDE) { return "has a width or height outside 1..4096 or over 2073600 pixels"; }
    if (code == VDM_BAD_LEN) { return "has a body that is not width * height * 3 bytes"; }
    return "was read";
}

/// True when two frames have one width and one height.
pub fn vdm_same_dims(wa: u32, ha: u32, wb: u32, hb: u32) -> bool {
    if (wa == wb and ha == hb) { return true; }
    return false;
}

/// Copy len bytes of src from offset off into dst from 0 (the RGB body of a frame without its header).
pub fn vdm_copy(dst: []u8, src: []const u8, off: usize, len: usize) -> void {
    var i : usize = 0;
    while (i < len) {
        dst[i] = src[off + i];
        i += 1;
    }
}

pub fn main() void {
    var pa : [*:0]const u8 = "";
    var pb : [*:0]const u8 = "";
    var po : [*:0]const u8 = "target/vf_diff.ppm";
    const qa = std.c.getenv("DIFF_A");
    if (qa == null) {
        std.debug.print("vf_diff: DIFF_A is not set\n", .{});
        std.c.exit(1);
    }
    pa = qa.?;
    const qb = std.c.getenv("DIFF_B");
    if (qb == null) {
        std.debug.print("vf_diff: DIFF_B is not set\n", .{});
        std.c.exit(1);
    }
    pb = qb.?;
    const qo = std.c.getenv("DIFF_OUT");
    if (qo != null) { po = qo.?; }

    var na : usize = 0;
    const fa = std.c.fopen(pa, "rb");
    if (fa == null) {
        std.debug.print("vf_diff: cannot open {s}\n", .{pa});
        std.c.exit(1);
    }
    na = std.c.fread(@ptrCast(&VDM_RAW), 1, VDM_RAW_CAP, fa.?);
    _ = std.c.fclose(fa.?);
    const ha : VdmHdr = vdm_parse(&VDM_RAW, na);
    if (ha.code != VDM_OK) {
        std.debug.print("vf_diff: {s} {s}\n", .{ pa, vdm_why(ha.code) });
        std.c.exit(1);
    }
    vdm_copy(&VDM_A, &VDM_RAW, ha.off, (ha.w * ha.h * 3) as usize);

    var nb : usize = 0;
    const fb = std.c.fopen(pb, "rb");
    if (fb == null) {
        std.debug.print("vf_diff: cannot open {s}\n", .{pb});
        std.c.exit(1);
    }
    nb = std.c.fread(@ptrCast(&VDM_RAW), 1, VDM_RAW_CAP, fb.?);
    _ = std.c.fclose(fb.?);
    const hb : VdmHdr = vdm_parse(&VDM_RAW, nb);
    if (hb.code != VDM_OK) {
        std.debug.print("vf_diff: {s} {s}\n", .{ pb, vdm_why(hb.code) });
        std.c.exit(1);
    }
    vdm_copy(&VDM_B, &VDM_RAW, hb.off, (hb.w * hb.h * 3) as usize);

    if (vdm_same_dims(ha.w, ha.h, hb.w, hb.h) == false) {
        std.debug.print("vf_diff: frame sizes differ: {d}x{d} against {d}x{d}\n", .{ ha.w, ha.h, hb.w, hb.h });
        std.c.exit(1);
    }

    const n : u32 = vf_diff_count(&VDM_A, &VDM_B, ha.w, ha.h);
    const bx : VfDiffBox = vf_diff_bbox(&VDM_A, &VDM_B, ha.w, ha.h);
    const rd : u8 = vf_diff_frame(&VDM_A, &VDM_B, &VDM_D, ha.w, ha.h);
    if (rd != VF_D_OK) {
        std.debug.print("vf_diff: diff refused, code {d}\n", .{rd});
        std.c.exit(1);
    }
    const hl : usize = ppm_header_len(ha.w, ha.h) as usize;
    const rh : u8 = ppm_header_into(&VDM_HDR, ha.w, ha.h);
    if (rh != 0) {
        std.debug.print("vf_diff: header refused, code {d}\n", .{rh});
        std.c.exit(1);
    }
    const body : usize = (ha.w * ha.h * 3) as usize;
    const fp = std.c.fopen(po, "wb");
    if (fp == null) {
        std.debug.print("vf_diff: cannot open {s} for writing\n", .{po});
        std.c.exit(2);
    }
    const wh : usize = std.c.fwrite(@ptrCast(&VDM_HDR), 1, hl, fp.?);
    const wb : usize = std.c.fwrite(@ptrCast(&VDM_D), 1, body, fp.?);
    _ = std.c.fclose(fp.?);
    if (wh + wb != hl + body) {
        std.debug.print("vf_diff: short write to {s}: {d} of {d} bytes\n", .{ po, wh + wb, hl + body });
        std.c.exit(2);
    }
    if (n == 0) {
        std.debug.print("vf_diff: 0 pixels differ, frame {d}x{d}, wrote {d} bytes to {s}\n", .{ ha.w, ha.h, hl + body, po });
    } else {
        std.debug.print("vf_diff: {d} pixels differ, bbox {d},{d}-{d},{d}, frame {d}x{d}, wrote {d} bytes to {s}\n", .{ n, bx.x0, bx.y0, bx.x1, bx.y1, ha.w, ha.h, hl + body, po });
    }
}

test a_375_by_812_header_parses_to_offset_15 {
    const hdr : []const u8 = "P6\n375 812\n255\n";
    const r : VdmHdr = vdm_parse(hdr, 15 + 913500);
    assert r.code == VDM_OK;
    assert r.w == 375;
    assert r.h == 812;
    assert r.off == 15;
}

test a_1000_wide_header_is_14_bytes_and_1000_square_is_17 {
    const hdr : []const u8 = "P6\n1000 2\n255\n";
    const r : VdmHdr = vdm_parse(hdr, 14 + 6000);
    assert r.code == VDM_OK;
    assert r.w == 1000;
    assert r.h == 2;
    assert r.off == 14;
    assert ppm_header_len(1000, 2) == 14;
    assert ppm_header_len(1000, 1000) == 17;
}

test a_wrong_magic_or_maxval_is_refused {
    const p5 : []const u8 = "P5\n2 1\n255\n";
    assert vdm_parse(p5, 17).code == VDM_BAD_HDR;
    const deep : []const u8 = "P6\n2 1\n65535\n";
    assert vdm_parse(deep, 19).code == VDM_BAD_HDR;
    const nows : []const u8 = "P62 1\n255\n";
    assert vdm_parse(nows, 16).code == VDM_BAD_HDR;
    const empty : []const u8 = "";
    assert vdm_parse(empty, 0).code == VDM_BAD_HDR;
}

test a_header_cut_short_is_refused {
    const cut : []const u8 = "P6\n2 1\n25";
    assert vdm_parse(cut, 9).code == VDM_BAD_HDR;
    const nodim : []const u8 = "P6\n2";
    assert vdm_parse(nodim, 4).code == VDM_BAD_HDR;
}

test a_zero_or_huge_side_is_refused {
    const zero : []const u8 = "P6\n0 1\n255\n";
    assert vdm_parse(zero, 11).code == VDM_BAD_SIDE;
    const wide : []const u8 = "P6\n4097 1\n255\n";
    assert vdm_parse(wide, 14 + 12291).code == VDM_BAD_SIDE;
    const big : []const u8 = "P6\n2000 2000\n255\n";
    assert vdm_parse(big, 17 + 12000000).code == VDM_BAD_SIDE;
}

test a_body_of_the_wrong_length_is_refused {
    const hdr : []const u8 = "P6\n2 1\n255\n";
    assert vdm_parse(hdr, 11 + 6).code == VDM_OK;
    assert vdm_parse(hdr, 11 + 5).code == VDM_BAD_LEN;
    assert vdm_parse(hdr, 11 + 7).code == VDM_BAD_LEN;
    assert vdm_parse(hdr, 11).code == VDM_BAD_LEN;
}

test frames_of_different_sizes_are_refused {
    assert vdm_same_dims(375, 812, 375, 812);
    assert vdm_same_dims(375, 812, 375, 811) == false;
    assert vdm_same_dims(375, 812, 376, 812) == false;
    assert vdm_same_dims(2, 3, 3, 2) == false;
}

test the_copy_takes_the_body_and_the_diff_counts_it {
    var raw : [14]u8 = [0; 14];
    raw[11] = 10;
    raw[12] = 20;
    raw[13] = 30;
    var body : [3]u8 = [0; 3];
    vdm_copy(&body, &raw, 11, 3);
    assert body[0] == 10;
    assert body[1] == 20;
    assert body[2] == 30;
    var other : [3]u8 = [0; 3];
    other[0] = 10;
    other[1] = 20;
    other[2] = 30;
    assert vf_diff_count(&body, &other, 1, 1) == 0;
    other[2] = 31;
    assert vf_diff_count(&body, &other, 1, 1) == 1;
}
