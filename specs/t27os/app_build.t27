// specs/t27os/app_build.t27 -- Blocker: runnable post-13016 T27OS.app build
// and launch receipt for the chat version.
// Part of M1 (milestone #5). Closes #13074.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::app_build;

pub struct AppBuild { runnable: bool, launch_receipt: bool };

pub fn app_build_runnable(b: AppBuild) -> bool {
    return b.runnable && b.launch_receipt;
}

test "app build runnable" {
    assert(app_build_runnable(AppBuild { runnable: true, launch_receipt: true }));
    assert(!app_build_runnable(AppBuild { runnable: true, launch_receipt: false }));
}