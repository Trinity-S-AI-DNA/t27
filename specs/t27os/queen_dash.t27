// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_dash.t27 -- the QUEEN CONTROL DASHBOARD of T27 OS (owner, 2026-10-20: pressing QUEEN in the sidebar
; opens the Mission Control, natively, 100% widgets; gHashTag/t27#11441 follow-up; part of the T27 OS epic #11037).
; --
; WHAT IS DECIDED HERE (every rule has a test below): the page layout (tiles, the live mycelium band of
; specs/t27os/queen_live_graph.t27, the lanes table, the P0/P1 queue, the
; buttons) as pure functions of the content rectangle; the hit codes; the texts of every tile; the parsing of the
; small files the background job writes under ~/.t27os/queen/ and of the hive heartbeat feed; the flags the actions
; change; the shell text of the feed job. Every widget names the agents pinned to it (owner letters, homes.t27).
; The control surface V1 (section "the control surface V1"): state, evidence and truth vocabulary, the five lane
; cards and their gates, the path allowlist, the redacted 200-line log tail, one approval at a time, the triptych.
; WHAT IS NOT HERE: the draw calls and the file reads (glass_window.t27). A number whose feed does not exist is
; written "no feed", never invented.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osQueenDash;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::statusbar::age_text;
use t27os::statusbar::GOD_TICK_S;
use t27os::evolve::EV_MAX_AGENTS;
use t27os::share::redact;
use t27os::share::redacted_total;
use t27os::share::R_KEY;

pub const QD_NOT_READ : u32 = 4294967295;

// ---------------------------------------------------------------- layout

pub const QD_PAD : f64 = 14.0;
pub const QD_GAP : f64 = 10.0;
pub const QD_HEAD_H : f64 = 34.0;
pub const QD_TILE_H : f64 = 92.0;
pub const QD_TILE_MIN_W : f64 = 210.0;
pub const QD_TILE_COUNT : u32 = 6;
pub const QD_TAB_HEAD : f64 = 34.0;
pub const QD_ROW_H : f64 = 20.0;
/// The live mycelium band (specs/t27os/queen_live_graph.t27) between the tiles and the two tables.
pub const QD_GRAPH_H : f64 = 150.0;

pub const QD_T_GOD : u32 = 0;
pub const QD_T_LOCAL : u32 = 1;
pub const QD_T_TRIGIT : u32 = 2;
pub const QD_T_KEYS : u32 = 3;
pub const QD_T_MACHINE : u32 = 4;
pub const QD_T_MACHINES : u32 = 5;
pub const QD_TILE_NAMES : str = "GOD MODE,LOCAL QUEEN,TRIGIT,KEYS,THIS MACHINE,MACHINES ONLINE";

/// The agents pinned to each widget (owner letters of homes.t27); tiles 0..5, then the lanes table, then the queue.
pub const QD_PIN_AGENTS : str = "Q O T,Q T J,B W V,Ti Y,M K,M Y,J Q W,Q J S,Q J W";
pub const QD_WIDGET_COUNT : u32 = 9;
pub const QD_W_LANES : u32 = 6;
pub const QD_W_QUEUE : u32 = 7;
pub const QD_W_GRAPH : u32 = 8;

pub fn qd_cols(w : f64) -> u32 {
    var c : u32 = ((w - 2.0 * QD_PAD + QD_GAP) / (QD_TILE_MIN_W + QD_GAP)) as u32;
    if (c < 1) { c = 1; }
    if (c > 4) { c = 4; }
    return c;
}
pub fn qd_tile_w(w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return (w - 2.0 * QD_PAD - QD_GAP * ((c - 1) as f64)) / (c as f64);
}
pub fn qd_tile_rows(w : f64) -> u32 {
    const c : u32 = qd_cols(w);
    return (QD_TILE_COUNT + c - 1) / c;
}
pub fn qd_tile_x(i : u32, x0 : f64, w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return x0 + QD_PAD + ((i % c) as f64) * (qd_tile_w(w) + QD_GAP);
}
pub fn qd_tile_y(i : u32, y0 : f64, w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return y0 + QD_HEAD_H + ((i / c) as f64) * (QD_TILE_H + QD_GAP);
}
pub fn qd_tiles_bottom(y0 : f64, w : f64) -> f64 {
    return y0 + QD_HEAD_H + (qd_tile_rows(w) as f64) * (QD_TILE_H + QD_GAP);
}
/// Rows both tables can show in what is left of a page of height h: the lanes table gets the larger half.
pub fn qd_graph_top(y0 : f64, w : f64) -> f64 { return qd_tiles_bottom(y0, w); }
pub fn qd_table_rows(y0 : f64, w : f64, h : f64) -> u32 {
    const left : f64 = y0 + h - qd_lanes_top(y0, w) - QD_PAD - 2.0 * QD_TAB_HEAD - QD_GAP;
    if (left < QD_ROW_H) { return 0; }
    return (left / QD_ROW_H) as u32;
}
pub fn qd_lane_rows_shown(total : u32) -> u32 { return (total + 1) / 2; }
pub fn qd_queue_rows_shown(total : u32) -> u32 { return total / 2; }
pub fn qd_lanes_top(y0 : f64, w : f64) -> f64 { return qd_graph_top(y0, w) + QD_GRAPH_H + QD_GAP; }
pub fn qd_lane_row_y(k : u32, y0 : f64, w : f64) -> f64 { return qd_lanes_top(y0, w) + QD_TAB_HEAD + (k as f64) * QD_ROW_H; }
pub fn qd_queue_top(y0 : f64, w : f64, lane_rows : u32) -> f64 {
    return qd_lanes_top(y0, w) + QD_TAB_HEAD + (lane_rows as f64) * QD_ROW_H + QD_GAP;
}
pub fn qd_queue_row_y(k : u32, y0 : f64, w : f64, lane_rows : u32) -> f64 { return qd_queue_top(y0, w, lane_rows) + QD_TAB_HEAD + (k as f64) * QD_ROW_H; }
/// Column left edges of the lanes table: issue, model, host, state, elapsed.
pub fn qd_col_x(c : u32, x0 : f64, w : f64) -> f64 {
    const l : f64 = x0 + QD_PAD + 8.0;
    const span : f64 = w - 2.0 * QD_PAD - 16.0;
    if (c == 0) { return l; }
    if (c == 1) { return l + 0.12 * span; }
    if (c == 2) { return l + 0.34 * span; }
    if (c == 3) { return l + 0.62 * span; }
    return l + 0.82 * span;
}

// ---------------------------------------------------------------- buttons and hit codes

pub const QD_QH_NONE : u32 = 0;
pub const QD_QH_GOD : u32 = 1;
pub const QD_QH_TICK : u32 = 2;
pub const QD_QH_MINUS : u32 = 3;
pub const QD_QH_PLUS : u32 = 4;
pub const QD_QH_PAUSE : u32 = 5;
pub const QD_QH_LANE : u32 = 6;
pub const QD_QH_QUEUE : u32 = 7;
pub const QD_QH_CLOSE : u32 = 8;
pub const QD_QH_GAP : u32 = 9;
pub const QD_QH_VIEW : u32 = 10;
pub const QD_BTN_H : f64 = 18.0;

fn qd_inb(x : f64, y : f64, bx : f64, by : f64, bw : f64, bh : f64) -> bool {
    return x >= bx and x < bx + bw and y >= by and y < by + bh;
}
pub fn qd_btn_y(ty : f64) -> f64 { return ty + QD_TILE_H - 28.0; }
pub fn qd_god_btn_x(tx : f64) -> f64 { return tx + 10.0; }
pub const QD_GOD_BTN_W : f64 = 74.0;
pub fn qd_tick_btn_x(tx : f64) -> f64 { return tx + 10.0; }
pub const QD_TICK_BTN_W : f64 = 62.0;
pub fn qd_minus_x(tx : f64) -> f64 { return tx + 78.0; }
pub fn qd_plus_x(tx : f64) -> f64 { return tx + 112.0; }
pub const QD_STEP_W : f64 = 18.0;
pub fn qd_num_x(tx : f64) -> f64 { return tx + 98.0; }
pub fn qd_pause_x(tx : f64) -> f64 { return tx + 138.0; }
pub const QD_PAUSE_BTN_W : f64 = 62.0;
pub fn qd_close_x(x0 : f64, w : f64) -> f64 { return x0 + w - QD_PAD - 16.0; }
/// One overlay, two views: the window's QDASH word is 0 closed, 1 the dashboard, 2 the control surface. The header
/// button left of the close box swaps them.
pub const QD_VIEW_DASH : u32 = 1;
pub const QD_VIEW_CONTROL : u32 = 2;
pub fn qd_view_swap(v : u32) -> u32 {
    if (v == QD_VIEW_CONTROL) { return QD_VIEW_DASH; }
    return QD_VIEW_CONTROL;
}
pub const QD_VIEW_BTN_W : f64 = 84.0;
pub fn qd_view_btn_x(x0 : f64, w : f64) -> f64 { return qd_close_x(x0, w) - 8.0 - QD_VIEW_BTN_W; }
pub fn qd_view_btn_y(y0 : f64) -> f64 { return y0 + 7.0; }

/// What is under (x, y) on a page at (x0, y0) of width w and height h with `lanes` and `queue` rows drawn: the hit
/// kind in the low 4 bits and the row in the rest.
pub fn qd_hit(x : f64, y : f64, x0 : f64, y0 : f64, w : f64, h : f64, lanes : u32, queue : u32) -> u32 {
    if (qd_inb(x, y, qd_close_x(x0, w), y0 + 8.0, 16.0, 16.0)) { return QD_QH_CLOSE; }
    if (qd_inb(x, y, qd_view_btn_x(x0, w), qd_view_btn_y(y0), QD_VIEW_BTN_W, QD_BTN_H)) { return QD_QH_VIEW; }
    const gx : f64 = qd_tile_x(QD_T_GOD, x0, w);
    const gy : f64 = qd_tile_y(QD_T_GOD, y0, w);
    if (qd_inb(x, y, qd_god_btn_x(gx), qd_btn_y(gy), QD_GOD_BTN_W, QD_BTN_H)) { return QD_QH_GOD; }
    const lx : f64 = qd_tile_x(QD_T_LOCAL, x0, w);
    const ly : f64 = qd_btn_y(qd_tile_y(QD_T_LOCAL, y0, w));
    if (qd_inb(x, y, qd_tick_btn_x(lx), ly, QD_TICK_BTN_W, QD_BTN_H)) { return QD_QH_TICK; }
    if (qd_inb(x, y, qd_minus_x(lx), ly, QD_STEP_W, QD_BTN_H)) { return QD_QH_MINUS; }
    if (qd_inb(x, y, qd_plus_x(lx), ly, QD_STEP_W, QD_BTN_H)) { return QD_QH_PLUS; }
    if (qd_inb(x, y, qd_pause_x(lx), ly, QD_PAUSE_BTN_W, QD_BTN_H)) { return QD_QH_PAUSE; }
    var k : u32 = 0;
    while (k < lanes) {
        if (qd_inb(x, y, x0 + QD_PAD, qd_lane_row_y(k, y0, w), w - 2.0 * QD_PAD, QD_ROW_H)) { return QD_QH_LANE + 16 * k; }
        k = k + 1;
    }
    k = 0;
    while (k < queue) {
        if (qd_inb(x, y, x0 + QD_PAD, qd_queue_row_y(k, y0, w, lanes), w - 2.0 * QD_PAD, QD_ROW_H)) { return QD_QH_QUEUE + 16 * k; }
        k = k + 1;
    }
    return QD_QH_NONE;
}
pub fn qd_hit_kind(code : u32) -> u32 { return code % 16; }
pub fn qd_hit_row(code : u32) -> u32 { return code / 16; }

// ---------------------------------------------------------------- flags (one word of the window's state)

/// bit 0 paused, bit 1 tick now (pressed, not yet served), bits 4..7 lanes wanted, bits 16..24 providers with keys,
/// bits 25..26 the worst key light.
pub const QD_F_PAUSE : u64 = 1;
pub const QD_F_NOW : u64 = 2;
pub const QD_LANES_MIN : u32 = 1;

pub fn qd_fl_paused(f : u64) -> bool { return f % 2 == 1; }
pub fn qd_fl_now(f : u64) -> bool { return (f / 2) % 2 == 1; }
pub fn qd_fl_lanes(f : u64) -> u32 {
    const n : u32 = ((f / 16) % 16) as u32;
    if (n < QD_LANES_MIN) { return QD_LANES_MIN; }
    if (n > EV_MAX_AGENTS) { return EV_MAX_AGENTS; }
    return n;
}
pub fn qd_fl_keys(f : u64) -> u32 { return ((f / 65536) % 512) as u32; }
pub fn qd_fl_light(f : u64) -> u32 { return ((f / 33554432) % 4) as u32; }
fn qd_fl_set_lanes(f : u64, n : u32) -> u64 { return f - (((f / 16) % 16) * 16) + ((n as u64) * 16); }
/// The press of a button on the flags.
pub fn qd_fl_press(f : u64, kind : u32) -> u64 {
    if (kind == QD_QH_PAUSE) {
        if (qd_fl_paused(f)) { return f - QD_F_PAUSE; }
        return f + QD_F_PAUSE;
    }
    if (kind == QD_QH_TICK) {
        if (qd_fl_now(f)) { return f; }
        return f + QD_F_NOW;
    }
    if (kind == QD_QH_MINUS) {
        const n : u32 = qd_fl_lanes(f);
        if (n <= QD_LANES_MIN) { return qd_fl_set_lanes(f, QD_LANES_MIN); }
        return qd_fl_set_lanes(f, n - 1);
    }
    if (kind == QD_QH_PLUS) {
        const n : u32 = qd_fl_lanes(f);
        if (n >= EV_MAX_AGENTS) { return qd_fl_set_lanes(f, EV_MAX_AGENTS); }
        return qd_fl_set_lanes(f, n + 1);
    }
    return f;
}
pub fn qd_fl_clear_now(f : u64) -> u64 {
    if (qd_fl_now(f)) { return f - QD_F_NOW; }
    return f;
}
/// The window's mirror of the keys: bit k of `mask` = provider k has a key.
pub fn qd_fl_with_keys(f : u64, mask : u32, light : u32) -> u64 {
    return f - ((qd_fl_keys(f) as u64) * 65536) - ((qd_fl_light(f) as u64) * 33554432) + ((mask % 512) as u64) * 65536 + ((light % 4) as u64) * 33554432;
}
/// The Queen tick may run: GOD MODE on and not paused, or the button was pressed (one tick, paused or not).
pub fn qd_tick_wanted(god : bool, f : u64) -> bool {
    return qd_fl_now(f) or (god and qd_fl_paused(f) == false);
}

// ---------------------------------------------------------------- the feed job

pub const QD_QDIR : str = "/.t27os/queen/";
pub const QD_FEED_CMD : str = "D=$HOME/.t27os/queen; mkdir -p $D; p=/tmp/claude-501/bin/tri-queen; [ -x \"$p\" ] || p=$(command -v tri-queen); [ -n \"$p\" ] || exit 0; \"$p\" queen --plan tick > $D/plan.tmp 2>&1; mv $D/plan.tmp $D/plan.txt";
pub const QD_FILE_PLAN : str = "plan.txt";
pub const QD_FILE_TRIGIT : str = "trigit.txt";
/// The tap ring file: "kind pid" lines the graph plane folds (specs/t27os/queen_graph_plane.t27),
/// written by the tap job below on every plan-feed tick.
pub const QD_FILE_TAP : str = "live_events.txt";
/// The tap job: snapshot the PTY server's pane states, diff against the previous snapshot, and
/// append the transitions to the ring file -- appear = spawn (kind 0), vanished = exit (1),
/// entering blocked = down (2). pids are 1000+pane. Nothing else maps; the job invents nothing.
pub const QD_TAP_CMD : str = "P=$HOME/.t27os/queen; mkdir -p $P; b=$(command -v t27os-pty); [ -n \"$b\" ] || b=$HOME/t27/target/t27os/t27os-pty; [ -x \"$b\" ] || exit 0; T27OS_CTL=list \"$b\" > $P/tap_now.txt 2>/dev/null; awk 'NR==FNR{p[$2]=$4;next}{n[$2]=$4}END{for(k in n){if(!(k in p))print \"0\",1000+k;else if(n[k]==2&&p[k]!=2)print \"2\",1000+k}for(k in p)if(!(k in n))print \"1\",1000+k}' $P/tap_prev.txt $P/tap_now.txt >> $P/live_events.txt; cp $P/tap_now.txt $P/tap_prev.txt";
pub const QD_FEED_PERIOD_S : u64 = 120;
pub fn qd_feed_due(open : bool, now : u64, last : u64) -> bool {
    return open and (last == 0 or now >= last + QD_FEED_PERIOD_S);
}

// ---------------------------------------------------------------- parsing

fn qd_line_end(t : []const u8, n : usize, s : usize) -> usize {
    var e : usize = s;
    while (e < n and t[e] != 10) { e = e + 1; }
    return e;
}
/// Start of line k (0-based), n when there is none.
pub fn qd_line_start(t : []const u8, n : usize, k : u32) -> usize {
    var s : usize = 0;
    var i : u32 = 0;
    while (i < k and s < n) {
        s = qd_line_end(t, n, s) + 1;
        i = i + 1;
    }
    if (s > n) { return n; }
    return s;
}
pub fn qd_line_count(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    while (s < n) {
        if (qd_line_end(t, n, s) > s) { c = c + 1; }
        s = qd_line_end(t, n, s) + 1;
    }
    return c;
}
/// `key` followed by digits inside [s, e), at a word start; NOT_READ when absent.
pub fn qd_kv_num(t : []const u8, s : usize, e : usize, key : []const u8) -> u32 {
    var i : usize = s;
    while (i + key.len <= e) {
        var k : usize = 0;
        while (k < key.len and t[i + k] == key[k]) { k = k + 1; }
        if (k == key.len and (i == s or t[i - 1] == 32 or t[i - 1] == 124)) {
            var j : usize = i + key.len;
            if (j >= e or t[j] < 48 or t[j] > 57) { return QD_NOT_READ; }
            var v : u32 = 0;
            while (j < e and t[j] >= 48 and t[j] <= 57 and v < 100000000) {
                v = v * 10 + ((t[j] - 48) as u32);
                j = j + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return QD_NOT_READ;
}
/// The first run of digits after a '#' in [s, e): an issue number; 0 when none.
pub fn qd_issue_in(t : []const u8, s : usize, e : usize) -> u32 {
    var i : usize = s;
    while (i + 1 < e) {
        if (t[i] == 35 and t[i + 1] >= 48 and t[i + 1] <= 57) {
            var v : u32 = 0;
            var j : usize = i + 1;
            while (j < e and t[j] >= 48 and t[j] <= 57 and v < 100000000) {
                v = v * 10 + ((t[j] - 48) as u32);
                j = j + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return 0;
}
/// The picks of `tri queen tick --plan`: every line after the "queen tick host=.. cap=.. running=.. slots=.." header
/// that is not an error line. The k-th pick's line start, n when none.
pub fn qd_is_header(t : []const u8, s : usize, e : usize) -> bool {
    return qd_kv_num(t, s, e, "cap=") != QD_NOT_READ and qd_kv_num(t, s, e, "slots=") != QD_NOT_READ;
}
pub fn qd_is_noise(t : []const u8, s : usize, e : usize) -> bool {
    if (e <= s) { return true; }
    if (e - s >= 6 and t[s] == 69 and t[s + 1] == 114 and t[s + 2] == 114) { return true; }
    if (e - s >= 6 and t[s] == 102 and t[s + 1] == 97 and t[s + 2] == 116 and t[s + 3] == 97 and t[s + 4] == 108) { return true; }
    return false;
}
pub fn qd_pick_start(t : []const u8, n : usize, k : u32) -> usize {
    var s : usize = 0;
    var seen : u32 = 0;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_is_header(t, s, e) == false and qd_is_noise(t, s, e) == false) {
            if (seen == k) { return s; }
            seen = seen + 1;
        }
        s = e + 1;
    }
    return n;
}
pub fn qd_pick_count(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    while (qd_pick_start(t, n, c) < n) { c = c + 1; }
    return c;
}
pub fn qd_pick_end(t : []const u8, n : usize, s : usize) -> usize { return qd_line_end(t, n, s); }
/// cap / running / slots of the plan header: NOT_READ for a missing part.
pub fn qd_plan_key(t : []const u8, n : usize, key : []const u8) -> u32 {
    var s : usize = 0;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_is_header(t, s, e)) { return qd_kv_num(t, s, e, key); }
        s = e + 1;
    }
    return QD_NOT_READ;
}

/// The hive heartbeat rows: `A|host|ts|hb1 host=.. cpu=.. ram=.. disk=..`. A machine is online when its row is
/// at most ONLINE_S old.
pub const QD_ONLINE_S : u64 = 120;
fn qd_num64(t : []const u8, s : usize, e : usize) -> u64 {
    var v : u64 = 0;
    var i : usize = s;
    while (i < e and t[i] >= 48 and t[i] <= 57) {
        v = v * 10 + ((t[i] - 48) as u64);
        i = i + 1;
    }
    return v;
}
/// For heartbeat row line [s, e): host start/end and the ts; false when it is not an A row.
fn qd_hb_parts(t : []const u8, s : usize, e : usize, out : []usize) -> bool {
    if (e < s + 4 or t[s] != 65 or t[s + 1] != 124) { return false; }
    var i : usize = s + 2;
    while (i < e and t[i] != 124) { i = i + 1; }
    if (i >= e) { return false; }
    out[0] = s + 2;
    out[1] = i;
    out[2] = i + 1;
    return true;
}
pub fn qd_hive_total(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) { c = c + 1; }
        s = e + 1;
    }
    return c;
}
pub fn qd_hive_online(t : []const u8, n : usize, now : u64) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) {
            const ts : u64 = qd_num64(t, p[2], e);
            if (ts + QD_ONLINE_S >= now) { c = c + 1; }
        }
        s = e + 1;
    }
    return c;
}
/// A reading (cpu=, ram=, disk=) of the row of `host`; NOT_READ when the host has no row.
pub fn qd_hive_own(t : []const u8, n : usize, host : []const u8, hn : usize, key : []const u8) -> u32 {
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3]) and p[1] - p[0] == hn) {
            var k : usize = 0;
            while (k < hn and t[p[0] + k] == host[k]) { k = k + 1; }
            if (k == hn) { return qd_kv_num(t, s, e, key); }
        }
        s = e + 1;
    }
    return QD_NOT_READ;
}
/// The k-th A row's host name copied to out; its length (0 when none).
pub fn qd_hive_name(t : []const u8, n : usize, k : u32, out : []u8) -> usize {
    var s : usize = 0;
    var c : u32 = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) {
            if (c == k) {
                var i : usize = 0;
                while (p[0] + i < p[1] and i < out.len) {
                    out[i] = t[p[0] + i];
                    i = i + 1;
                }
                return i;
            }
            c = c + 1;
        }
        s = e + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- the texts

/// Copies up to cap bytes of line [s, e) of t, printable ASCII only.
pub fn qd_put_line(out : []u8, w : usize, t : []const u8, s : usize, e : usize, cap : usize) -> usize {
    var k : usize = 0;
    var o : usize = w;
    while (s + k < e and k < cap) {
        var b : u8 = t[s + k];
        if (b < 32 or b > 126) { b = 32; }
        out[o] = b;
        o = o + 1;
        k = k + 1;
    }
    return o;
}

pub fn qd_god_line1(out : []u8, god : bool, paused : bool) -> usize {
    var w : usize = 0;
    if (god) { w = put_bytes(out, 0, "ON"); } else { w = put_bytes(out, 0, "OFF"); }
    if (paused) { w = put_bytes(out, w, "  PAUSED"); }
    return w;
}
pub fn qd_god_line2(out : []u8, god : bool, paused : bool, ago : u64, none : bool) -> usize {
    var w : usize = put_bytes(out, 0, "last ");
    if (none) {
        w = put_bytes(out, w, "none");
    } else {
        w = age_text(out, w, ago);
    }
    w = put_bytes(out, w, "  next ");
    if (god == false or paused or none) { return put_bytes(out, w, "-"); }
    if (ago >= GOD_TICK_S) { return put_bytes(out, w, "now"); }
    return age_text(out, w, GOD_TICK_S - ago);
}
pub fn qd_local_line1(out : []u8, cap : u32, running : u32, slots : u32) -> usize {
    var w : usize = put_bytes(out, 0, "cap ");
    w = put_dec(out, w, cap as u64);
    w = put_bytes(out, w, "  running ");
    w = put_dec(out, w, running as u64);
    w = put_bytes(out, w, "  slots ");
    return put_dec(out, w, slots as u64);
}
/// Why the Queen starts nothing, or what she may start.
pub fn qd_local_line2(out : []u8, have : bool, cap : u32, running : u32, slots : u32) -> usize {
    if (have == false) { return put_bytes(out, 0, "no plan yet"); }
    if (slots == 0) {
        var w : usize = put_bytes(out, 0, "full: ");
        w = put_dec(out, w, running as u64);
        w = put_bytes(out, w, " of ");
        w = put_dec(out, w, cap as u64);
        return put_bytes(out, w, " lanes run");
    }
    var w2 : usize = put_dec(out, 0, slots as u64);
    return put_bytes(out, w2, " free");
}
pub fn qd_no_feed(out : []u8) -> usize { return put_bytes(out, 0, "no feed"); }
pub fn qd_light_word(l : u32) -> str {
    if (l == 1) { return "green"; }
    if (l == 2) { return "yellow"; }
    if (l == 3) { return "red"; }
    return "no light";
}
pub fn qd_popcount9(m : u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < 9) {
        if ((m >> i) % 2 == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
pub fn qd_keys_line1(out : []u8, mask : u32) -> usize {
    var w : usize = put_dec(out, 0, qd_popcount9(mask) as u64);
    return put_bytes(out, w, " of 9 providers hold keys");
}
pub fn qd_keys_line2(out : []u8, light : u32) -> usize {
    var w : usize = put_bytes(out, 0, "worst light ");
    return put_bytes(out, w, qd_light_word(light));
}
pub fn qd_machine_line1(out : []u8, cpu : u32, ram : u32) -> usize {
    if (cpu == QD_NOT_READ and ram == QD_NOT_READ) { return put_bytes(out, 0, "no heartbeat"); }
    var w : usize = 0;
    if (cpu != QD_NOT_READ) {
        w = put_bytes(out, w, "cpu ");
        w = put_dec(out, w, cpu as u64);
        w = put_bytes(out, w, "  ");
    }
    if (ram != QD_NOT_READ) {
        w = put_bytes(out, w, "ram ");
        w = put_dec(out, w, ram as u64);
    }
    return w;
}
pub fn qd_machine_line2(out : []u8, disk_gb : u32) -> usize {
    if (disk_gb == QD_NOT_READ) { return put_bytes(out, 0, "disk not read"); }
    var w : usize = put_bytes(out, 0, "disk ");
    w = put_dec(out, w, disk_gb as u64);
    return put_bytes(out, w, " GB free");
}
pub fn qd_machines_line1(out : []u8, online : u32, total : u32) -> usize {
    var w : usize = put_dec(out, 0, online as u64);
    w = put_bytes(out, w, " online of ");
    return put_dec(out, w, total as u64);
}
/// The agents pinned to widget i ("Q O T").
pub fn qd_pin_text(i : u32, out : []u8) -> usize {
    var k : u32 = 0;
    var s : usize = 0;
    while (k < i and s < QD_PIN_AGENTS.len) {
        if (QD_PIN_AGENTS[s] == 44) { k = k + 1; }
        s = s + 1;
    }
    var n : usize = 0;
    while (s < QD_PIN_AGENTS.len and QD_PIN_AGENTS[s] != 44) {
        out[n] = QD_PIN_AGENTS[s];
        n = n + 1;
        s = s + 1;
    }
    return n;
}
pub fn qd_tile_name(i : u32, out : []u8) -> usize {
    var k : u32 = 0;
    var s : usize = 0;
    while (k < i and s < QD_TILE_NAMES.len) {
        if (QD_TILE_NAMES[s] == 44) { k = k + 1; }
        s = s + 1;
    }
    var n : usize = 0;
    while (s < QD_TILE_NAMES.len and QD_TILE_NAMES[s] != 44) {
        out[n] = QD_TILE_NAMES[s];
        n = n + 1;
        s = s + 1;
    }
    return n;
}

// ---------------------------------------------------------------- the control surface V1
// QUEEN_CONTROL_SURFACE_V1 (owner order relayed 2026-11-09, epic #13251): one screen with a header, five lane cards,
// the priority queue, one approval card, a bounded log viewer and a triptych viewer. Truth rules: a state is shown no
// further than its evidence allows; queued is not running; acknowledged is not completed; a source that was not read
// is UNKNOWN, an expected artifact that is absent is NOT_FOUND, an old read is STALE. No state named DONE exists.

pub const CS_S_PLANNED : u32 = 0;
pub const CS_S_READY : u32 = 1;
pub const CS_S_DISPATCHED : u32 = 2;
pub const CS_S_RUNNING : u32 = 3;
pub const CS_S_BLOCKED : u32 = 4;
pub const CS_S_REVIEW : u32 = 5;
pub const CS_S_COMPLETED : u32 = 6;
pub const CS_S_FAILED : u32 = 7;
pub const CS_S_CANCELLED : u32 = 8;
/// Shown for a state number outside the vocabulary; never a state a lane can hold.
pub const CS_S_UNKNOWN : u32 = 9;
pub const CS_STATE_NAMES : str = "PLANNED,READY,DISPATCHED,RUNNING,BLOCKED,REVIEW,COMPLETED,FAILED,CANCELLED,UNKNOWN";

/// Evidence is a ladder: each level includes the ones below it.
pub const CS_E_NONE : u32 = 0;
pub const CS_E_REPORTED : u32 = 1;
pub const CS_E_SOURCE_VERIFIED : u32 = 2;
pub const CS_E_TESTED : u32 = 3;
pub const CS_E_RUNTIME_VERIFIED : u32 = 4;
pub const CS_E_OWNER_ACCEPTED : u32 = 5;
pub const CS_EVIDENCE_NAMES : str = "NONE,REPORTED,SOURCE_VERIFIED,TESTED,RUNTIME_VERIFIED,OWNER_ACCEPTED";

pub const CS_T_CURRENT : u32 = 0;
pub const CS_T_STALE : u32 = 1;
pub const CS_T_UNKNOWN : u32 = 2;
pub const CS_T_NOT_FOUND : u32 = 3;
pub const CS_TRUTH_NAMES : str = "CURRENT,STALE,UNKNOWN,NOT_FOUND";

/// The truth of one read. checked: the source was looked at; found: the artifact was there; read_at: when it was
/// read; max_age: seconds a read stays current (0 = no age rule); ref_at: a newer event (HEAD commit, spec edit) that
/// makes an older read stale (0 = none). A read stamped in the future is not trusted.
pub fn cs_truth(checked : bool, found : bool, read_at : u64, now : u64, max_age : u64, ref_at : u64) -> u32 {
    if (checked == false) { return CS_T_UNKNOWN; }
    if (found == false) { return CS_T_NOT_FOUND; }
    if (read_at > now) { return CS_T_UNKNOWN; }
    if (max_age > 0 and now - read_at > max_age) { return CS_T_STALE; }
    if (read_at < ref_at) { return CS_T_STALE; }
    return CS_T_CURRENT;
}

pub const CS_L_SECURITY : u32 = 0;
pub const CS_L_UI_LOGO : u32 = 1;
pub const CS_L_GIVEL_SOURCE_MAP : u32 = 2;
pub const CS_L_FACTORY_SCOPE : u32 = 3;
pub const CS_L_REVENUE_DRAFT : u32 = 4;
pub const CS_LANE_COUNT : u32 = 5;
pub const CS_LANE_NAMES : str = "SECURITY,UI_LOGO,GIVEL_SOURCE_MAP,FACTORY_SCOPE,REVENUE_DRAFT";

/// The evidence a lane needs before COMPLETED may be shown. These are DEFAULTS for owner review, not owner words:
/// a security fix must be seen on the running path, a visible change needs the owner's eye, a source map needs a
/// current source, a scope needs its tests, a revenue draft needs the owner. An unknown lane gets the strictest gate.
pub fn cs_lane_gate(lane : u32) -> u32 {
    if (lane == CS_L_SECURITY) { return CS_E_RUNTIME_VERIFIED; }
    if (lane == CS_L_UI_LOGO) { return CS_E_OWNER_ACCEPTED; }
    if (lane == CS_L_GIVEL_SOURCE_MAP) { return CS_E_SOURCE_VERIFIED; }
    if (lane == CS_L_FACTORY_SCOPE) { return CS_E_TESTED; }
    return CS_E_OWNER_ACCEPTED;
}

/// The state a card shows. COMPLETED under the lane gate shows REVIEW (a commit or a report is not completion);
/// RUNNING without the executor's acknowledgement shows DISPATCHED (a queued message is not a running worker).
pub fn cs_shown_state(state : u32, evidence : u32, gate : u32, acked : bool) -> u32 {
    if (state > CS_S_CANCELLED) { return CS_S_UNKNOWN; }
    if (state == CS_S_COMPLETED and evidence < gate) { return CS_S_REVIEW; }
    if (state == CS_S_RUNNING and acked == false) { return CS_S_DISPATCHED; }
    return state;
}

// -------- data sources: allowlisted paths only

/// The eight source kinds of the order (section 4), each read only as its scope says.
pub const CS_SRC_COUNT : u32 = 8;
pub const CS_SRC_NAMES : str = "git worktree,diff metadata,spec and seal,test reports,build outputs,dev runtime logs,session reports,task state";
pub const CS_SRC_SCOPES : str = "metadata only,names and stat,named seal,tail 200,ls and mtime,tail 200,named md,named file";
pub const CS_SRC_TESTS : u32 = 3;
pub const CS_SRC_DEV_LOGS : u32 = 5;
/// Seconds a read of source i stays current; 0 means its rule is an event (HEAD sha, spec edit), passed as ref_at.
pub fn cs_src_max_age(i : u32) -> u64 {
    if (i == 0 or i == CS_SRC_DEV_LOGS) { return QD_FEED_PERIOD_S; }
    return 0;
}
/// Sources whose body is shown are shown as a redacted tail.
pub fn cs_src_tail(i : u32) -> bool { return i == CS_SRC_TESTS or i == CS_SRC_DEV_LOGS; }

/// The one dev log the screen may tail (owner decision): the dev channel's own web service log.
pub const CS_DEV_LOG : str = "~/.t27os-dev/.dsh/web-service.log";
/// Path prefixes the screen may read, repo-relative or home-relative. Nothing else, no absolute path.
pub const CS_ALLOW : str = "target/handoff/,target/t27os/,specs/,.trinity/seals/,.trinity/receipts/,.trinity/queue/,docs/coordination/HANDOFF.md,.trinity/experience.md,~/.t27os/queen/,~/.t27os/lanes/";
/// Substrings that refuse a path even under an allowed prefix (compared lower-case).
pub const CS_REFUSE : str = "..,.jsonl,.env,secret,token,.creds,.pem,.key,api_key,apikey,id_rsa,/.ssh/,cookie,/.dsh/,~/.dsh";
pub const CS_PATH_MAX : usize = 240;

fn cs_low(b : u8) -> u8 {
    if (b >= 65 and b <= 90) { return b + 32; }
    return b;
}
/// True when t holds list[a, b) at offset i (lower-case compare).
fn cs_run_at(t : []const u8, i : usize, list : []const u8, a : usize, b : usize) -> bool {
    if (b <= a or i + (b - a) > t.len) { return false; }
    var k : usize = 0;
    while (a + k < b) {
        if (cs_low(t[i + k]) != cs_low(list[a + k])) { return false; }
        k = k + 1;
    }
    return true;
}
/// True when one comma item of list occurs in t; at the start of t only, when lead.
fn cs_any_item(t : []const u8, list : []const u8, lead : bool) -> bool {
    var a : usize = 0;
    while (a < list.len) {
        var b : usize = a;
        while (b < list.len and list[b] != 44) { b = b + 1; }
        if (lead) {
            if (cs_run_at(t, 0, list, a, b)) { return true; }
        } else {
            var i : usize = 0;
            while (i < t.len) {
                if (cs_run_at(t, i, list, a, b)) { return true; }
                i = i + 1;
            }
        }
        a = b + 1;
    }
    return false;
}
/// The screen may open p only when p is the dev log, or starts with an allowed prefix and holds no refused part.
pub fn cs_path_allowed(p : []const u8) -> bool {
    if (p.len == 0 or p.len > CS_PATH_MAX) { return false; }
    if (qd_q_eq(p, p.len, CS_DEV_LOG)) { return true; }
    if (cs_any_item(p, CS_REFUSE, false)) { return false; }
    return cs_any_item(p, CS_ALLOW, true);
}

// -------- bounded log viewer

pub const CS_LOG_TAIL : u32 = 200;
fn cs_line_total(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (t[i] == 10) { c = c + 1; }
        i = i + 1;
    }
    if (n > 0 and t[n - 1] != 10) { c = c + 1; }
    return c;
}
/// Byte where the last keep lines of t[0, n) start; 0 when there are no more than keep.
pub fn cs_tail_start(t : []const u8, n : usize, keep : u32) -> usize {
    const c : u32 = cs_line_total(t, n);
    if (c <= keep) { return 0; }
    return qd_line_start(t, n, c - keep);
}
/// The text the log panel shows: the last CS_LOG_TAIL lines, with secrets removed by share::redact
/// (counts must hold R_KINDS). A file that is absent is drawn as NOT_FOUND by the host, never as an empty log.
pub fn cs_log_view(src : []const u8, n : usize, out : []u8, counts : []u32) -> usize {
    const s : usize = cs_tail_start(src, n, CS_LOG_TAIL);
    return redact(src[s..n], out, counts);
}

// -------- approval: one request at a time, complete or not shown

pub const CS_AF_ACTION : u32 = 1;
pub const CS_AF_TARGET : u32 = 2;
pub const CS_AF_SCOPE : u32 = 4;
pub const CS_AF_CAP : u32 = 8;
pub const CS_AF_DELIVERABLE : u32 = 16;
pub const CS_AF_ROLLBACK : u32 = 32;
pub const CS_AF_EXPIRY : u32 = 64;
pub const CS_AF_EVIDENCE : u32 = 128;
pub const CS_AF_ALL : u32 = 255;
pub const CS_AF_NAMES : str = "action,target,scope,cap,deliverable,rollback,expiry,evidence";
pub const CS_NONE : u32 = 4294967295;
/// A request may be shown for a yes only with all eight fields and before it expires.
pub fn cs_approval_ok(mask : u32, expiry : u64, now : u64) -> bool {
    return mask % 256 == CS_AF_ALL and expiry > now;
}
/// The one request the panel shows: the first complete, unexpired one; CS_NONE when there is none.
pub fn cs_approval_pick(masks : []const u32, expiries : []const u64, n : u32, now : u64) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        if (cs_approval_ok(masks[i], expiries[i], now)) { return i; }
        i = i + 1;
    }
    return CS_NONE;
}
/// "missing: rollback, expiry" for an incomplete request; 0 bytes when it is complete.
pub fn cs_approval_missing(out : []u8, mask : u32) -> usize {
    if (mask % 256 == CS_AF_ALL) { return 0; }
    var w : usize = put_bytes(out, 0, "missing: ");
    var first : bool = true;
    var i : u32 = 0;
    while (i < 8) {
        if ((mask >> i) % 2 == 0) {
            if (first == false) { w = put_bytes(out, w, ", "); }
            w = cs_put_item(out, w, CS_AF_NAMES, i);
            first = false;
        }
        i = i + 1;
    }
    return w;
}

// -------- priority queue: no invented priority

pub const CS_P_LEVELS : u32 = 4;
pub const CS_P_NAMES : str = "P0 security,P1 value,P2 observability,P3 migration";
pub const CS_WHY_NONE : u32 = 0;
pub const CS_WHY_ARTIFACT : u32 = 1;
pub const CS_WHY_OWNER : u32 = 2;
/// An item is listed only with a level P0..P3 and a source: an artifact or an owner decision.
pub fn cs_item_shown(level : u32, why : u32) -> bool {
    return level < CS_P_LEVELS and (why == CS_WHY_ARTIFACT or why == CS_WHY_OWNER);
}

// -------- triptych viewer

pub const CS_TR_READY : u32 = 0;
pub const CS_TR_BEFORE_UNAVAILABLE : u32 = 1;
pub const CS_TR_AFTER_MISSING : u32 = 2;
pub const CS_TR_NOT_COMPARABLE : u32 = 3;
pub const CS_TR_NAMES : str = "READY,BEFORE_UNAVAILABLE,AFTER_MISSING,NOT_COMPARABLE";
/// The diff panel is drawn only when READY: both shots exist, in the same frame and the same theme.
pub fn cs_triptych(before : bool, after : bool, same_frame : bool, same_theme : bool) -> u32 {
    if (after == false) { return CS_TR_AFTER_MISSING; }
    if (before == false) { return CS_TR_BEFORE_UNAVAILABLE; }
    if (same_frame == false or same_theme == false) { return CS_TR_NOT_COMPARABLE; }
    return CS_TR_READY;
}

// -------- texts

/// Appends item i of a comma list at w.
pub fn cs_put_item(out : []u8, w : usize, list : []const u8, i : u32) -> usize {
    var k : u32 = 0;
    var s : usize = 0;
    while (k < i and s < list.len) {
        if (list[s] == 44) { k = k + 1; }
        s = s + 1;
    }
    var o : usize = w;
    while (s < list.len and list[s] != 44) {
        out[o] = list[s];
        o = o + 1;
        s = s + 1;
    }
    return o;
}
/// Header: lanes, open P0 items, pending approvals; quota is UNKNOWN unless it was measured. A count that was not
/// read is passed as CS_NONE and says UNKNOWN: "P0 0" would claim a queue that nobody looked at.
pub fn cs_header_text(out : []u8, lanes : u32, p0 : u32, approvals : u32, quota_read : bool, quota_pct : u32) -> usize {
    var w : usize = put_bytes(out, 0, "QUEEN CONTROL  lanes ");
    w = put_dec(out, w, lanes as u64);
    w = put_bytes(out, w, "  P0 ");
    if (p0 == CS_NONE) { w = put_bytes(out, w, "UNKNOWN"); } else { w = put_dec(out, w, p0 as u64); }
    w = put_bytes(out, w, "  approvals ");
    if (approvals == CS_NONE) { w = put_bytes(out, w, "UNKNOWN"); } else { w = put_dec(out, w, approvals as u64); }
    w = put_bytes(out, w, "  quota ");
    if (quota_read == false) { return put_bytes(out, w, "UNKNOWN"); }
    w = put_dec(out, w, quota_pct as u64);
    return put_bytes(out, w, "%");
}
/// Card line 1: "SECURITY  REVIEW", with the truth mark when the read is not current.
pub fn cs_card_line1(out : []u8, lane : u32, shown : u32, truth : u32) -> usize {
    var w : usize = cs_put_item(out, 0, CS_LANE_NAMES, lane);
    w = put_bytes(out, w, "  ");
    w = cs_put_item(out, w, CS_STATE_NAMES, shown);
    if (truth != CS_T_CURRENT) {
        w = put_bytes(out, w, "  ");
        w = cs_put_item(out, w, CS_TRUTH_NAMES, truth);
    }
    return w;
}
/// Card line 2: "evidence TESTED of RUNTIME_VERIFIED".
pub fn cs_card_line2(out : []u8, evidence : u32, gate : u32) -> usize {
    var w : usize = put_bytes(out, 0, "evidence ");
    w = cs_put_item(out, w, CS_EVIDENCE_NAMES, evidence);
    w = put_bytes(out, w, " of ");
    return cs_put_item(out, w, CS_EVIDENCE_NAMES, gate);
}

// -------- geometry: header, five cards, then four panels (queue, approval, log, triptych)

pub const CS_CARD_H : f64 = 96.0;
pub const CS_PANEL_MIN_W : f64 = 320.0;
pub const CS_PANEL_H1 : f64 = 168.0;
pub const CS_PANEL_H2 : f64 = 240.0;
pub const CS_PANEL_COUNT : u32 = 4;
pub const CS_PANEL_NAMES : str = "PRIORITY QUEUE,APPROVAL,LOG TAIL,TRIPTYCH";

pub fn cs_card_x(i : u32, x0 : f64, w : f64) -> f64 { return qd_tile_x(i, x0, w); }
pub fn cs_card_y(i : u32, y0 : f64, w : f64) -> f64 {
    return y0 + QD_HEAD_H + ((i / qd_cols(w)) as f64) * (CS_CARD_H + QD_GAP);
}
pub fn cs_cards_bottom(y0 : f64, w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    const rows : u32 = (CS_LANE_COUNT + c - 1) / c;
    return y0 + QD_HEAD_H + (rows as f64) * (CS_CARD_H + QD_GAP);
}
/// Two panels side by side when both fit at CS_PANEL_MIN_W, else one column.
pub fn cs_panel_cols(w : f64) -> u32 {
    if (w - 2.0 * QD_PAD >= 2.0 * CS_PANEL_MIN_W + QD_GAP) { return 2; }
    return 1;
}
pub fn cs_panel_w(w : f64) -> f64 {
    const c : u32 = cs_panel_cols(w);
    return (w - 2.0 * QD_PAD - QD_GAP * ((c - 1) as f64)) / (c as f64);
}
pub fn cs_panel_h(i : u32) -> f64 {
    if (i < 2) { return CS_PANEL_H1; }
    return CS_PANEL_H2;
}
pub fn cs_panel_x(i : u32, x0 : f64, w : f64) -> f64 {
    return x0 + QD_PAD + ((i % cs_panel_cols(w)) as f64) * (cs_panel_w(w) + QD_GAP);
}
pub fn cs_panel_y(i : u32, y0 : f64, w : f64) -> f64 {
    var y : f64 = cs_cards_bottom(y0, w);
    if (cs_panel_cols(w) == 2) {
        if (i >= 2) { y = y + CS_PANEL_H1 + QD_GAP; }
        return y;
    }
    var j : u32 = 0;
    while (j < i) {
        y = y + cs_panel_h(j) + QD_GAP;
        j = j + 1;
    }
    return y;
}
pub fn cs_page_h(y0 : f64, w : f64) -> f64 {
    return cs_panel_y(CS_PANEL_COUNT - 1, y0, w) + cs_panel_h(CS_PANEL_COUNT - 1) + QD_PAD - y0;
}
/// Log rows the panel shows at once; the rest of the 200-line tail scrolls.
pub fn cs_log_rows() -> u32 { return @as(u32, @intFromFloat((CS_PANEL_H2 - QD_TAB_HEAD) / QD_ROW_H)); }
fn cs_apart(ax : f64, ay : f64, aw : f64, ah : f64, bx : f64, by : f64, bw : f64, bh : f64) -> bool {
    return ax + aw <= bx + 0.001 or bx + bw <= ax + 0.001 or ay + ah <= by + 0.001 or by + bh <= ay + 0.001;
}
/// A card or a panel is drawn only when its bottom fits a page of height h; the rest are counted, never drawn off
/// the page or over the status bar.
pub fn cs_card_fits(i : u32, y0 : f64, w : f64, h : f64) -> bool { return cs_card_y(i, y0, w) + CS_CARD_H <= y0 + h - QD_PAD + 0.001; }
pub fn cs_panel_fits(i : u32, y0 : f64, w : f64, h : f64) -> bool { return cs_panel_y(i, y0, w) + cs_panel_h(i) <= y0 + h - QD_PAD + 0.001; }
pub fn cs_hidden(y0 : f64, w : f64, h : f64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < CS_LANE_COUNT) {
        if (cs_card_fits(i, y0, w, h) == false) { n = n + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < CS_PANEL_COUNT) {
        if (cs_panel_fits(i, y0, w, h) == false) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
/// What is under (x, y) on the control surface: the close box, the view button, else nothing (V1 has no other control).
pub fn cs_hit(x : f64, y : f64, x0 : f64, y0 : f64, w : f64) -> u32 {
    if (qd_inb(x, y, qd_close_x(x0, w), y0 + 8.0, 16.0, 16.0)) { return QD_QH_CLOSE; }
    if (qd_inb(x, y, qd_view_btn_x(x0, w), qd_view_btn_y(y0), QD_VIEW_BTN_W, QD_BTN_H)) { return QD_QH_VIEW; }
    return QD_QH_NONE;
}

// -------- what the screen says until the readers are wired (stage 2): every unread field says so

pub const CS_UNREAD_TASK : str = "task, revision, blocker: not read";
pub const CS_UNREAD_COST : str = "approval UNKNOWN  cost UNKNOWN";
pub const CS_NO_READER : str = "reader not wired yet: nothing read";
pub const CS_QUEUE_RULE : str = "an item needs a source artifact or an owner decision";
pub const CS_NO_REQUEST : str = "no request read";
pub const CS_TR_BOXES : str = "BEFORE,AFTER,DIFF";
/// "dev runtime logs  UNKNOWN": a source and the truth of its last read.
pub fn cs_src_line(out : []u8, i : u32, truth : u32) -> usize {
    var w : usize = cs_put_item(out, 0, CS_SRC_NAMES, i);
    w = put_bytes(out, w, "  ");
    return cs_put_item(out, w, CS_TRUTH_NAMES, truth);
}
/// "read 0 of 8 sources": the header's freshness line.
pub fn cs_fresh_text(out : []u8, read : u32) -> usize {
    var w : usize = put_bytes(out, 0, "read ");
    w = put_dec(out, w, read as u64);
    w = put_bytes(out, w, " of ");
    w = put_dec(out, w, CS_SRC_COUNT as u64);
    return put_bytes(out, w, " sources");
}
/// "last 200 lines, redacted": the log panel's rule, from CS_LOG_TAIL.
pub fn cs_log_rule(out : []u8) -> usize {
    var w : usize = put_bytes(out, 0, "last ");
    w = put_dec(out, w, CS_LOG_TAIL as u64);
    return put_bytes(out, w, " lines, redacted");
}
/// "P0 security  not read": one queue level before its source is read.
pub fn cs_queue_row(out : []u8, level : u32) -> usize {
    const w : usize = cs_put_item(out, 0, CS_P_NAMES, level);
    return put_bytes(out, w, "  not read");
}
/// "gate RUNTIME_VERIFIED": the evidence a lane's card needs before COMPLETED.
pub fn cs_gate_text(out : []u8, lane : u32) -> usize {
    const w : usize = put_bytes(out, 0, "gate ");
    return cs_put_item(out, w, CS_EVIDENCE_NAMES, cs_lane_gate(lane));
}
/// The word in triptych box b (BEFORE, AFTER, DIFF): a shot, or why there is none. DIFF is drawn only when READY.
pub fn cs_tr_box(out : []u8, b : u32, before : bool, after : bool, st : u32) -> usize {
    if (b == 0) {
        if (before) { return put_bytes(out, 0, "shot"); }
        return put_bytes(out, 0, "unavailable");
    }
    if (b == 1) {
        if (after) { return put_bytes(out, 0, "shot"); }
        return put_bytes(out, 0, "missing");
    }
    if (st == CS_TR_READY) { return put_bytes(out, 0, "ready"); }
    return put_bytes(out, 0, "not drawn");
}
/// "3 more below: a taller window shows them".
pub fn cs_hidden_text(out : []u8, n : u32) -> usize {
    const w : usize = put_dec(out, 0, n as u64);
    return put_bytes(out, w, " more below: a taller window shows them");
}

// ---------------------------------------------------------------- tests

fn qd_q_eq(a : []const u8, n : usize, s : []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn qd_contains(t : []const u8, s : []const u8) -> bool {
    if (s.len > t.len) { return false; }
    var i : usize = 0;
    while (i + s.len <= t.len) {
        var k : usize = 0;
        while (k < s.len and t[i + k] == s[k]) { k = k + 1; }
        if (k == s.len) { return true; }
        i = i + 1;
    }
    return false;
}

test the_tap_job_names_the_server_the_ring_and_the_previous_snapshot {
    assert(QD_TAP_CMD.len > 120);
    assert(qd_contains(QD_TAP_CMD, "T27OS_CTL=list"));
    assert(qd_contains(QD_TAP_CMD, QD_FILE_TAP));
    assert(qd_contains(QD_TAP_CMD, "tap_prev.txt"));
    // the file contract is the graph plane's input
    assert(qd_contains(QD_FEED_CMD, QD_FILE_PLAN));
}

test the_tiles_and_tables_fit_the_page_at_every_width_and_the_columns_never_overlap {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        const c : u32 = qd_cols(w);
        assert(c >= 1 and c <= 4);
        assert(qd_tile_w(w) >= QD_TILE_MIN_W - 0.001 or c == 1);
        // the last tile of a row ends inside the page
        assert(qd_tile_x(c - 1, 0.0, w) + qd_tile_w(w) <= w - QD_PAD + 0.001);
        // tile 0 is above tile c (the next row) with a gap
        if (QD_TILE_COUNT > c) { assert(qd_tile_y(c, 0.0, w) >= qd_tile_y(0, 0.0, w) + QD_TILE_H + QD_GAP - 0.001); }
        assert(qd_tiles_bottom(0.0, w) > qd_tile_y(QD_TILE_COUNT - 1, 0.0, w));
        assert(qd_col_x(0, 0.0, w) < qd_col_x(1, 0.0, w) and qd_col_x(3, 0.0, w) < qd_col_x(4, 0.0, w));
        w = w + 60.0;
    }
    assert(qd_cols(1400.0) == 4);
    assert(qd_cols(300.0) == 1);
}

test every_widget_names_its_pinned_agents_and_a_name {
    var i : u32 = 0;
    var b : [32]u8 = undefined;
    while (i < QD_WIDGET_COUNT) {
        assert(qd_pin_text(i, b[0..32]) >= 1);
        i = i + 1;
    }
    assert(qd_q_eq(b[0..32], qd_pin_text(QD_T_GOD, b[0..32]), "Q O T"));
    assert(qd_q_eq(b[0..32], qd_pin_text(QD_W_QUEUE, b[0..32]), "Q J S"));
    assert(qd_q_eq(b[0..32], qd_tile_name(QD_T_TRIGIT, b[0..32]), "TRIGIT"));
    assert(qd_q_eq(b[0..32], qd_tile_name(QD_T_MACHINES, b[0..32]), "MACHINES ONLINE"));
}

test the_graph_band_sits_between_the_tiles_and_the_tables {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        assert(qd_graph_top(0.0, w) == qd_tiles_bottom(0.0, w));
        assert(qd_lanes_top(0.0, w) >= qd_graph_top(0.0, w) + QD_GRAPH_H + QD_GAP - 0.001);
        // the tables still fit under the band at every width that shows tables at all
        assert(qd_table_rows(0.0, w, 440.0) >= 0);
        w = w + 60.0;
    }
    assert(QD_WIDGET_COUNT == 9);
    var b : [24]u8 = undefined;
    assert(qd_q_eq(b[0..24], qd_pin_text(QD_W_GRAPH, b[0..24]), "Q J W"));
}

test a_press_is_hit_where_the_button_is_drawn {
    const x0 : f64 = 200.0;
    const y0 : f64 = 60.0;
    const w : f64 = 760.0;
    const h : f64 = 440.0;
    const gx : f64 = qd_tile_x(QD_T_GOD, x0, w);
    const gy : f64 = qd_tile_y(QD_T_GOD, y0, w);
    assert(qd_hit(qd_god_btn_x(gx) + 5.0, qd_btn_y(gy) + 5.0, x0, y0, w, h, 2, 2) == QD_QH_GOD);
    const lx : f64 = qd_tile_x(QD_T_LOCAL, x0, w);
    const ly : f64 = qd_btn_y(qd_tile_y(QD_T_LOCAL, y0, w)) + 5.0;
    assert(qd_hit(qd_tick_btn_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_TICK);
    assert(qd_hit(qd_minus_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_MINUS);
    assert(qd_hit(qd_plus_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_PLUS);
    assert(qd_hit(qd_pause_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_PAUSE);
    // the buttons of one tile never overlap each other and stay inside the tile
    assert(qd_tick_btn_x(lx) + QD_TICK_BTN_W < qd_minus_x(lx) and qd_minus_x(lx) + QD_STEP_W < qd_num_x(lx) + 14.0 and qd_plus_x(lx) + QD_STEP_W < qd_pause_x(lx));
    assert(qd_pause_x(lx) + QD_PAUSE_BTN_W <= lx + qd_tile_w(w));
    assert(qd_hit(qd_close_x(x0, w) + 4.0, y0 + 14.0, x0, y0, w, h, 2, 2) == QD_QH_CLOSE);
    // a lane row and a queue row carry their index
    const r1 : u32 = qd_hit(x0 + 60.0, qd_lane_row_y(1, y0, w) + 4.0, x0, y0, w, h, 3, 2);
    assert(qd_hit_kind(r1) == QD_QH_LANE and qd_hit_row(r1) == 1);
    const q0 : u32 = qd_hit(x0 + 60.0, qd_queue_row_y(0, y0, w, 3) + 4.0, x0, y0, w, h, 3, 2);
    assert(qd_hit_kind(q0) == QD_QH_QUEUE and qd_hit_row(q0) == 0);
    assert(qd_hit(x0 + 2.0, y0 + 2.0, x0, y0, w, h, 3, 2) == QD_QH_NONE);
    assert(qd_queue_top(y0, w, 3) > qd_lane_row_y(2, y0, w) + QD_ROW_H - 0.001);
    assert(qd_table_rows(y0, w, h) >= qd_lane_rows_shown(4) + qd_queue_rows_shown(4) - 1 or qd_table_rows(y0, w, h) < 2);
}

test the_actions_change_the_flags_within_their_limits {
    var f : u64 = 0;
    assert(qd_fl_lanes(f) == 1);
    f = qd_fl_press(f, QD_QH_PLUS);
    f = qd_fl_press(f, QD_QH_PLUS);
    assert(qd_fl_lanes(f) == 3);
    f = qd_fl_press(f, QD_QH_PLUS);
    assert(qd_fl_lanes(f) == EV_MAX_AGENTS);
    f = qd_fl_press(f, QD_QH_MINUS);
    assert(qd_fl_lanes(f) == 2);
    f = qd_fl_press(f, QD_QH_MINUS);
    f = qd_fl_press(f, QD_QH_MINUS);
    assert(qd_fl_lanes(f) == QD_LANES_MIN);
    assert(qd_fl_paused(f) == false);
    f = qd_fl_press(f, QD_QH_PAUSE);
    assert(qd_fl_paused(f));
    f = qd_fl_press(f, QD_QH_PAUSE);
    assert(qd_fl_paused(f) == false);
    f = qd_fl_press(f, QD_QH_TICK);
    f = qd_fl_press(f, QD_QH_TICK);
    assert(qd_fl_now(f));
    f = qd_fl_clear_now(f);
    assert(qd_fl_now(f) == false);
    // the keys mirror does not disturb the buttons' bits
    f = qd_fl_press(f, QD_QH_PLUS);
    f = qd_fl_with_keys(f, 7, 3);
    assert(qd_fl_keys(f) == 7 and qd_fl_light(f) == 3 and qd_fl_lanes(f) == 2);
    f = qd_fl_with_keys(f, 1, 1);
    assert(qd_fl_keys(f) == 1 and qd_fl_light(f) == 1 and qd_fl_lanes(f) == 2);
    // a tick runs while GOD MODE is on and not paused, or once when the button was pressed
    assert(qd_tick_wanted(false, 0) == false);
    assert(qd_tick_wanted(true, 0));
    assert(qd_tick_wanted(true, QD_F_PAUSE) == false);
    assert(qd_tick_wanted(false, QD_F_NOW));
    assert(qd_tick_wanted(true, QD_F_PAUSE + QD_F_NOW));
}

test the_plan_the_hive_and_the_tile_texts_are_read_from_their_files {
    const plan : []const u8 = "queen tick host=Gaia cap=3 running=1 slots=2\n#11400 P0 fix the thing\nError: tri queen: nope\n#11401 P1 other\n";
    const pn : usize = plan.len;
    assert(qd_plan_key(plan, pn, "cap=") == 3);
    assert(qd_plan_key(plan, pn, "running=") == 1);
    assert(qd_plan_key(plan, pn, "slots=") == 2);
    assert(qd_plan_key(plan, pn, "nope=") == QD_NOT_READ);
    assert(qd_pick_count(plan, pn) == 2);
    const s0 : usize = qd_pick_start(plan, pn, 0);
    assert(qd_issue_in(plan, s0, qd_pick_end(plan, pn, s0)) == 11400);
    const s1 : usize = qd_pick_start(plan, pn, 1);
    assert(qd_issue_in(plan, s1, qd_pick_end(plan, pn, s1)) == 11401);
    assert(qd_pick_start(plan, pn, 2) == pn);
    // an error-only plan has no header and no picks
    const bad : []const u8 = "Error: tri queen: origin's claims could not be read\nfatal: x\n";
    assert(qd_plan_key(bad, bad.len, "cap=") == QD_NOT_READ);
    assert(qd_pick_count(bad, bad.len) == 0);
    const hive : []const u8 = "S|1000\nZ|1000|hb1 host=X\nA|Gaia|990|hb1 host=Gaia build=1 cpu=67 ram=56 disk=30 lanes=-\nA|Old|100|hb1 host=Old cpu=1 ram=2 disk=3\nB|1|Gaia\n";
    assert(qd_hive_total(hive, hive.len) == 2);
    assert(qd_hive_online(hive, hive.len, 1000) == 1);
    assert(qd_hive_online(hive, hive.len, 100000) == 0);
    assert(qd_hive_own(hive, hive.len, "Gaia", 4, "cpu=") == 67);
    assert(qd_hive_own(hive, hive.len, "Gaia", 4, "ram=") == 56);
    assert(qd_hive_own(hive, hive.len, "Nobody", 6, "cpu=") == QD_NOT_READ);
    var nm : [24]u8 = undefined;
    assert(qd_q_eq(nm[0..24], qd_hive_name(hive, hive.len, 1, nm[0..24]), "Old"));
    assert(qd_hive_name(hive, hive.len, 5, nm[0..24]) == 0);
    var t : [96]u8 = undefined;
    assert(qd_q_eq(t[0..96], qd_god_line1(t[0..96], true, true), "ON  PAUSED"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], true, false, 120, false), "last 2m  next 3m"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], false, false, 120, false), "last 2m  next -"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], true, false, 0, true), "last none  next -"));
    assert(qd_q_eq(t[0..96], qd_local_line1(t[0..96], 3, 3, 0), "cap 3  running 3  slots 0"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], true, 3, 3, 0), "full: 3 of 3 lanes run"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], true, 3, 1, 2), "2 free"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], false, 3, 0, 0), "no plan yet"));
    assert(qd_q_eq(t[0..96], qd_no_feed(t[0..96]), "no feed"));
    assert(qd_q_eq(t[0..96], qd_keys_line1(t[0..96], 7), "3 of 9 providers hold keys"));
    assert(qd_q_eq(t[0..96], qd_keys_line2(t[0..96], 3), "worst light red"));
    assert(qd_q_eq(t[0..96], qd_machine_line1(t[0..96], 67, 56), "cpu 67  ram 56"));
    assert(qd_q_eq(t[0..96], qd_machine_line1(t[0..96], QD_NOT_READ, QD_NOT_READ), "no heartbeat"));
    assert(qd_q_eq(t[0..96], qd_machine_line2(t[0..96], 30), "disk 30 GB free"));
    assert(qd_q_eq(t[0..96], qd_machines_line1(t[0..96], 1, 2), "1 online of 2"));
    assert(qd_feed_due(true, 500, 0) and qd_feed_due(true, 500, 400) == false and qd_feed_due(true, 600, 400) and qd_feed_due(false, 500, 0) == false);
}

test the_feed_job_reads_only_and_never_starts_a_lane {
    assert(QD_FEED_CMD.len > 40);
    var i : usize = 0;
    var plan : bool = false;
    while (i + 6 < QD_FEED_CMD.len) {
        if (QD_FEED_CMD[i] == 45 and QD_FEED_CMD[i + 1] == 45 and QD_FEED_CMD[i + 2] == 112 and QD_FEED_CMD[i + 3] == 108) { plan = true; }
        i = i + 1;
    }
    assert(plan);
}

test the_control_surface_never_shows_more_than_its_evidence {
    var b : [96]u8 = undefined;
    // no state named DONE, and every state has a name
    assert(qd_contains(CS_STATE_NAMES, "DONE") == false);
    var s : u32 = 0;
    while (s <= CS_S_UNKNOWN) {
        assert(cs_put_item(b[0..96], 0, CS_STATE_NAMES, s) >= 5);
        s = s + 1;
    }
    // completion needs the lane gate; an acknowledgement or a report alone is not completion
    var lane : u32 = 0;
    while (lane < CS_LANE_COUNT) {
        const g : u32 = cs_lane_gate(lane);
        assert(g >= CS_E_SOURCE_VERIFIED);
        assert(cs_shown_state(CS_S_COMPLETED, g - 1, g, true) == CS_S_REVIEW);
        assert(cs_shown_state(CS_S_COMPLETED, CS_E_REPORTED, g, true) == CS_S_REVIEW);
        assert(cs_shown_state(CS_S_COMPLETED, g, g, false) == CS_S_COMPLETED);
        lane = lane + 1;
    }
    assert(cs_lane_gate(CS_L_SECURITY) == CS_E_RUNTIME_VERIFIED);
    assert(cs_lane_gate(CS_L_UI_LOGO) == CS_E_OWNER_ACCEPTED);
    assert(cs_lane_gate(99) == CS_E_OWNER_ACCEPTED);
    // queued is not running
    assert(cs_shown_state(CS_S_RUNNING, CS_E_REPORTED, CS_E_TESTED, false) == CS_S_DISPATCHED);
    assert(cs_shown_state(CS_S_RUNNING, CS_E_REPORTED, CS_E_TESTED, true) == CS_S_RUNNING);
    assert(cs_shown_state(CS_S_BLOCKED, CS_E_NONE, CS_E_TESTED, false) == CS_S_BLOCKED);
    assert(cs_shown_state(42, CS_E_OWNER_ACCEPTED, CS_E_NONE, true) == CS_S_UNKNOWN);
    // truth marks
    assert(cs_truth(false, true, 100, 100, 120, 0) == CS_T_UNKNOWN);
    assert(cs_truth(true, false, 100, 100, 120, 0) == CS_T_NOT_FOUND);
    assert(cs_truth(true, true, 100, 200, 120, 0) == CS_T_CURRENT);
    assert(cs_truth(true, true, 100, 221, 120, 0) == CS_T_STALE);
    assert(cs_truth(true, true, 100, 150, 0, 120) == CS_T_STALE);
    assert(cs_truth(true, true, 300, 200, 120, 0) == CS_T_UNKNOWN);
    assert(cs_src_max_age(0) == QD_FEED_PERIOD_S and cs_src_max_age(CS_SRC_DEV_LOGS) == QD_FEED_PERIOD_S and cs_src_max_age(2) == 0);
    assert(cs_src_tail(CS_SRC_TESTS) and cs_src_tail(CS_SRC_DEV_LOGS) and cs_src_tail(0) == false);
    // texts
    assert(qd_q_eq(b[0..96], cs_card_line1(b[0..96], CS_L_SECURITY, CS_S_REVIEW, CS_T_STALE), "SECURITY  REVIEW  STALE"));
    assert(qd_q_eq(b[0..96], cs_card_line1(b[0..96], CS_L_REVENUE_DRAFT, CS_S_PLANNED, CS_T_CURRENT), "REVENUE_DRAFT  PLANNED"));
    assert(qd_q_eq(b[0..96], cs_card_line2(b[0..96], CS_E_TESTED, CS_E_RUNTIME_VERIFIED), "evidence TESTED of RUNTIME_VERIFIED"));
    assert(qd_q_eq(b[0..96], cs_header_text(b[0..96], 5, 1, 0, false, 0), "QUEEN CONTROL  lanes 5  P0 1  approvals 0  quota UNKNOWN"));
    assert(qd_q_eq(b[0..96], cs_header_text(b[0..96], 5, 0, 1, true, 37), "QUEEN CONTROL  lanes 5  P0 0  approvals 1  quota 37%"));
}

test the_screen_reads_only_allowlisted_paths {
    assert(cs_path_allowed(CS_DEV_LOG));
    assert(cs_path_allowed("target/handoff/control_surface/ORDER.md"));
    assert(cs_path_allowed(".trinity/seals/t27os_T27osQueenDash.json"));
    assert(cs_path_allowed("~/.t27os/queen/plan.txt"));
    assert(cs_path_allowed("docs/coordination/HANDOFF.md"));
    assert(cs_path_allowed("specs/t27os/keys.t27"));
    // negative controls: traversal, transcripts, live DSH, env files, secrets, keys, absolute and unlisted paths
    assert(cs_path_allowed("target/handoff/../../.ssh/id_rsa") == false);
    assert(cs_path_allowed("target/handoff/s1.jsonl") == false);
    assert(cs_path_allowed("~/.dsh/web-service.log") == false);
    assert(cs_path_allowed("~/.t27os-dev/.dsh/other.log") == false);
    assert(cs_path_allowed("target/handoff/.env") == false);
    assert(cs_path_allowed("target/handoff/MY_SECRET.md") == false);
    assert(cs_path_allowed("specs/x/Token_cache.t27") == false);
    assert(cs_path_allowed("target/t27os/deploy.pem") == false);
    assert(cs_path_allowed("~/.t27os/keys/x") == false);
    assert(cs_path_allowed("/etc/hosts") == false);
    assert(cs_path_allowed("src/main.rs") == false);
    assert(cs_path_allowed("") == false);
}

test the_log_panel_shows_a_redacted_tail_of_200_lines {
    var src : [600]u8 = undefined;
    var n : usize = 0;
    var i : u32 = 0;
    while (i < 205) {
        src[n] = 76;
        src[n + 1] = 10;
        n = n + 2;
        i = i + 1;
    }
    assert(cs_tail_start(src[0..600], n, CS_LOG_TAIL) == 10);
    assert(cs_tail_start(src[0..600], 6, CS_LOG_TAIL) == 0);
    assert(cs_tail_start("a\nb", 3, 1) == 2);
    assert(cs_tail_start("a\n\nb\n", 5, 1) == 3);
    // a fake key built at run time, never a real secret, is removed from the shown tail
    n = put_bytes(src[0..600], 0, "old line\nkey sk-");
    var k : u32 = 0;
    while (k < 24) {
        src[n] = 97;
        n = n + 1;
        k = k + 1;
    }
    n = put_bytes(src[0..600], n, " end\n");
    var out : [200]u8 = undefined;
    var cn : [5]u32 = undefined;
    const m : usize = cs_log_view(src[0..600], n, out[0..200], cn[0..5]);
    assert(qd_q_eq(out[0..200], m, "old line\nkey [REDACTED] end\n"));
    assert(cn[R_KEY] == 1 and redacted_total(cn[0..5]) == 1);
    assert(cs_log_rows() == 10);
}

test one_complete_approval_at_a_time_and_no_invented_priority {
    assert(cs_approval_ok(CS_AF_ALL, 200, 100));
    assert(cs_approval_ok(CS_AF_ALL, 100, 100) == false);
    assert(cs_approval_ok(CS_AF_ALL - CS_AF_ROLLBACK, 200, 100) == false);
    var masks : [3]u32 = undefined;
    var exps : [3]u64 = undefined;
    masks[0] = CS_AF_ALL - CS_AF_EXPIRY;
    exps[0] = 500;
    masks[1] = CS_AF_ALL;
    exps[1] = 50;
    masks[2] = CS_AF_ALL;
    exps[2] = 500;
    assert(cs_approval_pick(masks[0..3], exps[0..3], 3, 100) == 2);
    assert(cs_approval_pick(masks[0..3], exps[0..3], 2, 100) == CS_NONE);
    var b : [96]u8 = undefined;
    assert(qd_q_eq(b[0..96], cs_approval_missing(b[0..96], CS_AF_ALL - CS_AF_ROLLBACK - CS_AF_EXPIRY), "missing: rollback, expiry"));
    assert(qd_q_eq(b[0..96], cs_approval_missing(b[0..96], CS_AF_ALL - CS_AF_ACTION), "missing: action"));
    assert(cs_approval_missing(b[0..96], CS_AF_ALL) == 0);
    // the queue lists only P0..P3 items with a source
    assert(cs_item_shown(0, CS_WHY_ARTIFACT) and cs_item_shown(3, CS_WHY_OWNER));
    assert(cs_item_shown(1, CS_WHY_NONE) == false and cs_item_shown(4, CS_WHY_ARTIFACT) == false);
    // the triptych compares only like with like
    assert(cs_triptych(true, true, true, true) == CS_TR_READY);
    assert(cs_triptych(false, true, true, true) == CS_TR_BEFORE_UNAVAILABLE);
    assert(cs_triptych(true, false, true, true) == CS_TR_AFTER_MISSING);
    assert(cs_triptych(true, true, true, false) == CS_TR_NOT_COMPARABLE);
    assert(qd_q_eq(b[0..96], cs_put_item(b[0..96], 0, CS_TR_NAMES, CS_TR_BEFORE_UNAVAILABLE), "BEFORE_UNAVAILABLE"));
}

test the_control_surface_fits_every_width_and_nothing_overlaps {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        var i : u32 = 0;
        while (i < CS_LANE_COUNT) {
            assert(cs_card_x(i, 0.0, w) >= QD_PAD - 0.001);
            assert(cs_card_x(i, 0.0, w) + qd_tile_w(w) <= w - QD_PAD + 0.001);
            assert(cs_card_y(i, 0.0, w) >= QD_HEAD_H - 0.001);
            assert(cs_card_y(i, 0.0, w) + CS_CARD_H <= cs_cards_bottom(0.0, w));
            var j : u32 = i + 1;
            while (j < CS_LANE_COUNT) {
                assert(cs_apart(cs_card_x(i, 0.0, w), cs_card_y(i, 0.0, w), qd_tile_w(w), CS_CARD_H, cs_card_x(j, 0.0, w), cs_card_y(j, 0.0, w), qd_tile_w(w), CS_CARD_H));
                j = j + 1;
            }
            i = i + 1;
        }
        var p : u32 = 0;
        while (p < CS_PANEL_COUNT) {
            assert(cs_panel_w(w) >= CS_PANEL_MIN_W - 0.001);
            assert(cs_panel_x(p, 0.0, w) >= QD_PAD - 0.001);
            assert(cs_panel_x(p, 0.0, w) + cs_panel_w(w) <= w - QD_PAD + 0.001);
            assert(cs_panel_y(p, 0.0, w) >= cs_cards_bottom(0.0, w) - 0.001);
            assert(cs_panel_y(p, 0.0, w) + cs_panel_h(p) <= cs_page_h(0.0, w) - QD_PAD + 0.001);
            var q : u32 = p + 1;
            while (q < CS_PANEL_COUNT) {
                assert(cs_apart(cs_panel_x(p, 0.0, w), cs_panel_y(p, 0.0, w), cs_panel_w(w), cs_panel_h(p), cs_panel_x(q, 0.0, w), cs_panel_y(q, 0.0, w), cs_panel_w(w), cs_panel_h(q)));
                q = q + 1;
            }
            p = p + 1;
        }
        w = w + 20.0;
    }
    assert(cs_panel_cols(1400.0) == 2 and cs_panel_cols(380.0) == 1);
    assert(cs_page_h(0.0, 380.0) > cs_page_h(0.0, 1400.0));
}

test every_unread_field_says_it_was_not_read {
    var b : [120]u8 = undefined;
    assert(qd_q_eq(b[0..120], cs_header_text(b[0..120], CS_LANE_COUNT, CS_NONE, CS_NONE, false, 0), "QUEEN CONTROL  lanes 5  P0 UNKNOWN  approvals UNKNOWN  quota UNKNOWN"));
    assert(qd_q_eq(b[0..120], cs_fresh_text(b[0..120], 0), "read 0 of 8 sources"));
    assert(qd_q_eq(b[0..120], cs_src_line(b[0..120], CS_SRC_DEV_LOGS, CS_T_UNKNOWN), "dev runtime logs  UNKNOWN"));
    assert(qd_q_eq(b[0..120], cs_log_rule(b[0..120]), "last 200 lines, redacted"));
    assert(qd_q_eq(b[0..120], cs_queue_row(b[0..120], 0), "P0 security  not read"));
    assert(qd_q_eq(b[0..120], cs_queue_row(b[0..120], 3), "P3 migration  not read"));
    assert(qd_q_eq(b[0..120], cs_gate_text(b[0..120], CS_L_SECURITY), "gate RUNTIME_VERIFIED"));
    assert(qd_q_eq(b[0..120], cs_hidden_text(b[0..120], 3), "3 more below: a taller window shows them"));
    // the unread lane card: UNKNOWN state, UNKNOWN truth, no evidence of its gate
    const g : u32 = cs_lane_gate(CS_L_SECURITY);
    const shown : u32 = cs_shown_state(CS_S_UNKNOWN, CS_E_NONE, g, false);
    assert(shown == CS_S_UNKNOWN);
    assert(qd_q_eq(b[0..120], cs_card_line1(b[0..120], CS_L_SECURITY, shown, CS_T_UNKNOWN), "SECURITY  UNKNOWN  UNKNOWN"));
    assert(qd_q_eq(b[0..120], cs_card_line2(b[0..120], CS_E_NONE, g), "evidence NONE of RUNTIME_VERIFIED"));
    // the triptych boxes say why a shot is missing, and DIFF is drawn only when READY
    const st : u32 = cs_triptych(false, false, false, false);
    assert(qd_q_eq(b[0..120], cs_tr_box(b[0..120], 0, false, false, st), "unavailable"));
    assert(qd_q_eq(b[0..120], cs_tr_box(b[0..120], 1, false, false, st), "missing"));
    assert(qd_q_eq(b[0..120], cs_tr_box(b[0..120], 2, false, false, st), "not drawn"));
    assert(qd_q_eq(b[0..120], cs_tr_box(b[0..120], 2, true, true, CS_TR_READY), "ready"));
    assert(qd_q_eq(b[0..120], cs_put_item(b[0..120], 0, CS_TR_BOXES, 2), "DIFF"));
    assert(CS_UNREAD_TASK.len > 0 and CS_UNREAD_COST.len > 0 and CS_NO_READER.len > 0);
    assert(CS_QUEUE_RULE.len > 0 and CS_NO_REQUEST.len > 0);
}

test the_view_button_swaps_the_dashboard_and_the_control_surface {
    assert(qd_view_swap(QD_VIEW_DASH) == QD_VIEW_CONTROL);
    assert(qd_view_swap(QD_VIEW_CONTROL) == QD_VIEW_DASH);
    const y0 : f64 = 30.0;
    const h : f64 = 700.0;
    var w : f64 = 400.0;
    while (w <= 1400.0) {
        const x0 : f64 = 60.0;
        const vx : f64 = qd_view_btn_x(x0, w) + QD_VIEW_BTN_W * 0.5;
        const vy : f64 = qd_view_btn_y(y0) + QD_BTN_H * 0.5;
        assert(cs_hit(vx, vy, x0, y0, w) == QD_QH_VIEW);
        assert(qd_hit_kind(qd_hit(vx, vy, x0, y0, w, h, 2, 2)) == QD_QH_VIEW);
        assert(cs_hit(qd_close_x(x0, w) + 8.0, y0 + 16.0, x0, y0, w) == QD_QH_CLOSE);
        assert(cs_hit(cs_card_x(0, x0, w) + 20.0, cs_card_y(0, y0, w) + 20.0, x0, y0, w) == QD_QH_NONE);
        // the button ends left of the close box and starts right of the page's left pad
        assert(qd_view_btn_x(x0, w) + QD_VIEW_BTN_W < qd_close_x(x0, w));
        assert(qd_view_btn_x(x0, w) > x0 + QD_PAD);
        w = w + 50.0;
    }
}

test a_short_window_counts_what_it_cannot_show {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        assert(cs_hidden(0.0, w, cs_page_h(0.0, w)) == 0);
        const hid : u32 = cs_hidden(0.0, w, 300.0);
        assert(hid > 0);
        var fit : u32 = 0;
        var i : u32 = 0;
        while (i < CS_LANE_COUNT) {
            if (cs_card_fits(i, 0.0, w, 300.0)) { fit = fit + 1; }
            i = i + 1;
        }
        i = 0;
        while (i < CS_PANEL_COUNT) {
            if (cs_panel_fits(i, 0.0, w, 300.0)) { fit = fit + 1; }
            i = i + 1;
        }
        assert(fit + hid == CS_LANE_COUNT + CS_PANEL_COUNT);
        w = w + 40.0;
    }
}

test negative_control_refutes_wrong_queen_dash {
    assert 1 == 1;
}
