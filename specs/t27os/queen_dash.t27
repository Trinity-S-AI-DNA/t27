// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_dash.t27 -- the QUEEN CONTROL DASHBOARD of T27 OS (owner, 2026-10-20: pressing QUEEN in the sidebar
; opens the Mission Control, natively, 100% widgets; gHashTag/t27#11441 follow-up; part of the T27 OS epic #11037).
; --
; WHAT IS DECIDED HERE (every rule has a test below): the page layout (tiles, the live mycelium band of
; specs/t27os/queen_live_graph.t27, the lanes table, the P0/P1 queue, the
; buttons) as pure functions of the content rectangle; the hit codes; the texts of every tile; the parsing of the
; small files the background job writes under ~/.t27os/queen/ and of the hive heartbeat feed; the flags the actions
; change; the shell text of the feed job. Every widget names the agents pinned to it (owner letters, homes.t27).
; WHAT IS NOT HERE: the draw calls and the file reads (glass_window.t27). A number whose feed does not exist is
; written "no feed", never invented.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osQueenDash;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::statusbar::age_text;
use t27os::statusbar::GOD_TICK_S;
use t27os::evolve::EV_MAX_AGENTS;

pub const QD_NOT_READ : u32 = 4294967295;

// ---------------------------------------------------------------- layout

pub const QD_PAD : f64 = 14.0;
pub const QD_GAP : f64 = 10.0;
pub const QD_HEAD_H : f64 = 34.0;
pub const QD_TILE_H : f64 = 92.0;
pub const QD_TILE_MIN_W : f64 = 210.0;
pub const QD_TILE_COUNT : u32 = 6;
pub const QD_TAB_HEAD : f64 = 34.0;
pub const QD_ROW_H : f64 = 20.0;
/// The live mycelium band (specs/t27os/queen_live_graph.t27) between the tiles and the two tables.
pub const QD_GRAPH_H : f64 = 150.0;

pub const QD_T_GOD : u32 = 0;
pub const QD_T_LOCAL : u32 = 1;
pub const QD_T_TRIGIT : u32 = 2;
pub const QD_T_KEYS : u32 = 3;
pub const QD_T_MACHINE : u32 = 4;
pub const QD_T_MACHINES : u32 = 5;
pub const QD_TILE_NAMES : str = "GOD MODE,LOCAL QUEEN,TRIGIT,KEYS,THIS MACHINE,MACHINES ONLINE";

/// The agents pinned to each widget (owner letters of homes.t27); tiles 0..5, then the lanes table, then the queue.
pub const QD_PIN_AGENTS : str = "Q O T,Q T J,B W V,Ti Y,M K,M Y,J Q W,Q J S,Q J W";
pub const QD_WIDGET_COUNT : u32 = 9;
pub const QD_W_LANES : u32 = 6;
pub const QD_W_QUEUE : u32 = 7;
pub const QD_W_GRAPH : u32 = 8;

pub fn qd_cols(w : f64) -> u32 {
    var c : u32 = ((w - 2.0 * QD_PAD + QD_GAP) / (QD_TILE_MIN_W + QD_GAP)) as u32;
    if (c < 1) { c = 1; }
    if (c > 4) { c = 4; }
    return c;
}
pub fn qd_tile_w(w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return (w - 2.0 * QD_PAD - QD_GAP * ((c - 1) as f64)) / (c as f64);
}
pub fn qd_tile_rows(w : f64) -> u32 {
    const c : u32 = qd_cols(w);
    return (QD_TILE_COUNT + c - 1) / c;
}
pub fn qd_tile_x(i : u32, x0 : f64, w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return x0 + QD_PAD + ((i % c) as f64) * (qd_tile_w(w) + QD_GAP);
}
pub fn qd_tile_y(i : u32, y0 : f64, w : f64) -> f64 {
    const c : u32 = qd_cols(w);
    return y0 + QD_HEAD_H + ((i / c) as f64) * (QD_TILE_H + QD_GAP);
}
pub fn qd_tiles_bottom(y0 : f64, w : f64) -> f64 {
    return y0 + QD_HEAD_H + (qd_tile_rows(w) as f64) * (QD_TILE_H + QD_GAP);
}
/// Rows both tables can show in what is left of a page of height h: the lanes table gets the larger half.
pub fn qd_graph_top(y0 : f64, w : f64) -> f64 { return qd_tiles_bottom(y0, w); }
pub fn qd_table_rows(y0 : f64, w : f64, h : f64) -> u32 {
    const left : f64 = y0 + h - qd_lanes_top(y0, w) - QD_PAD - 2.0 * QD_TAB_HEAD - QD_GAP;
    if (left < QD_ROW_H) { return 0; }
    return (left / QD_ROW_H) as u32;
}
pub fn qd_lane_rows_shown(total : u32) -> u32 { return (total + 1) / 2; }
pub fn qd_queue_rows_shown(total : u32) -> u32 { return total / 2; }
pub fn qd_lanes_top(y0 : f64, w : f64) -> f64 { return qd_graph_top(y0, w) + QD_GRAPH_H + QD_GAP; }
pub fn qd_lane_row_y(k : u32, y0 : f64, w : f64) -> f64 { return qd_lanes_top(y0, w) + QD_TAB_HEAD + (k as f64) * QD_ROW_H; }
pub fn qd_queue_top(y0 : f64, w : f64, lane_rows : u32) -> f64 {
    return qd_lanes_top(y0, w) + QD_TAB_HEAD + (lane_rows as f64) * QD_ROW_H + QD_GAP;
}
pub fn qd_queue_row_y(k : u32, y0 : f64, w : f64, lane_rows : u32) -> f64 { return qd_queue_top(y0, w, lane_rows) + QD_TAB_HEAD + (k as f64) * QD_ROW_H; }
/// Column left edges of the lanes table: issue, model, host, state, elapsed.
pub fn qd_col_x(c : u32, x0 : f64, w : f64) -> f64 {
    const l : f64 = x0 + QD_PAD + 8.0;
    const span : f64 = w - 2.0 * QD_PAD - 16.0;
    if (c == 0) { return l; }
    if (c == 1) { return l + 0.12 * span; }
    if (c == 2) { return l + 0.34 * span; }
    if (c == 3) { return l + 0.62 * span; }
    return l + 0.82 * span;
}

// ---------------------------------------------------------------- buttons and hit codes

pub const QD_QH_NONE : u32 = 0;
pub const QD_QH_GOD : u32 = 1;
pub const QD_QH_TICK : u32 = 2;
pub const QD_QH_MINUS : u32 = 3;
pub const QD_QH_PLUS : u32 = 4;
pub const QD_QH_PAUSE : u32 = 5;
pub const QD_QH_LANE : u32 = 6;
pub const QD_QH_QUEUE : u32 = 7;
pub const QD_QH_CLOSE : u32 = 8;
pub const QD_QH_GAP : u32 = 9;
pub const QD_BTN_H : f64 = 18.0;

fn qd_inb(x : f64, y : f64, bx : f64, by : f64, bw : f64, bh : f64) -> bool {
    return x >= bx and x < bx + bw and y >= by and y < by + bh;
}
pub fn qd_btn_y(ty : f64) -> f64 { return ty + QD_TILE_H - 28.0; }
pub fn qd_god_btn_x(tx : f64) -> f64 { return tx + 10.0; }
pub const QD_GOD_BTN_W : f64 = 74.0;
pub fn qd_tick_btn_x(tx : f64) -> f64 { return tx + 10.0; }
pub const QD_TICK_BTN_W : f64 = 62.0;
pub fn qd_minus_x(tx : f64) -> f64 { return tx + 78.0; }
pub fn qd_plus_x(tx : f64) -> f64 { return tx + 112.0; }
pub const QD_STEP_W : f64 = 18.0;
pub fn qd_num_x(tx : f64) -> f64 { return tx + 98.0; }
pub fn qd_pause_x(tx : f64) -> f64 { return tx + 138.0; }
pub const QD_PAUSE_BTN_W : f64 = 62.0;
pub fn qd_close_x(x0 : f64, w : f64) -> f64 { return x0 + w - QD_PAD - 16.0; }

/// What is under (x, y) on a page at (x0, y0) of width w and height h with `lanes` and `queue` rows drawn: the hit
/// kind in the low 4 bits and the row in the rest.
pub fn qd_hit(x : f64, y : f64, x0 : f64, y0 : f64, w : f64, h : f64, lanes : u32, queue : u32) -> u32 {
    if (qd_inb(x, y, qd_close_x(x0, w), y0 + 8.0, 16.0, 16.0)) { return QD_QH_CLOSE; }
    const gx : f64 = qd_tile_x(QD_T_GOD, x0, w);
    const gy : f64 = qd_tile_y(QD_T_GOD, y0, w);
    if (qd_inb(x, y, qd_god_btn_x(gx), qd_btn_y(gy), QD_GOD_BTN_W, QD_BTN_H)) { return QD_QH_GOD; }
    const lx : f64 = qd_tile_x(QD_T_LOCAL, x0, w);
    const ly : f64 = qd_btn_y(qd_tile_y(QD_T_LOCAL, y0, w));
    if (qd_inb(x, y, qd_tick_btn_x(lx), ly, QD_TICK_BTN_W, QD_BTN_H)) { return QD_QH_TICK; }
    if (qd_inb(x, y, qd_minus_x(lx), ly, QD_STEP_W, QD_BTN_H)) { return QD_QH_MINUS; }
    if (qd_inb(x, y, qd_plus_x(lx), ly, QD_STEP_W, QD_BTN_H)) { return QD_QH_PLUS; }
    if (qd_inb(x, y, qd_pause_x(lx), ly, QD_PAUSE_BTN_W, QD_BTN_H)) { return QD_QH_PAUSE; }
    var k : u32 = 0;
    while (k < lanes) {
        if (qd_inb(x, y, x0 + QD_PAD, qd_lane_row_y(k, y0, w), w - 2.0 * QD_PAD, QD_ROW_H)) { return QD_QH_LANE + 16 * k; }
        k = k + 1;
    }
    k = 0;
    while (k < queue) {
        if (qd_inb(x, y, x0 + QD_PAD, qd_queue_row_y(k, y0, w, lanes), w - 2.0 * QD_PAD, QD_ROW_H)) { return QD_QH_QUEUE + 16 * k; }
        k = k + 1;
    }
    return QD_QH_NONE;
}
pub fn qd_hit_kind(code : u32) -> u32 { return code % 16; }
pub fn qd_hit_row(code : u32) -> u32 { return code / 16; }

// ---------------------------------------------------------------- flags (one word of the window's state)

/// bit 0 paused, bit 1 tick now (pressed, not yet served), bits 4..7 lanes wanted, bits 16..24 providers with keys,
/// bits 25..26 the worst key light.
pub const QD_F_PAUSE : u64 = 1;
pub const QD_F_NOW : u64 = 2;
pub const QD_LANES_MIN : u32 = 1;

pub fn qd_fl_paused(f : u64) -> bool { return f % 2 == 1; }
pub fn qd_fl_now(f : u64) -> bool { return (f / 2) % 2 == 1; }
pub fn qd_fl_lanes(f : u64) -> u32 {
    const n : u32 = ((f / 16) % 16) as u32;
    if (n < QD_LANES_MIN) { return QD_LANES_MIN; }
    if (n > EV_MAX_AGENTS) { return EV_MAX_AGENTS; }
    return n;
}
pub fn qd_fl_keys(f : u64) -> u32 { return ((f / 65536) % 512) as u32; }
pub fn qd_fl_light(f : u64) -> u32 { return ((f / 33554432) % 4) as u32; }
fn qd_fl_set_lanes(f : u64, n : u32) -> u64 { return f - (((f / 16) % 16) * 16) + ((n as u64) * 16); }
/// The press of a button on the flags.
pub fn qd_fl_press(f : u64, kind : u32) -> u64 {
    if (kind == QD_QH_PAUSE) {
        if (qd_fl_paused(f)) { return f - QD_F_PAUSE; }
        return f + QD_F_PAUSE;
    }
    if (kind == QD_QH_TICK) {
        if (qd_fl_now(f)) { return f; }
        return f + QD_F_NOW;
    }
    if (kind == QD_QH_MINUS) {
        const n : u32 = qd_fl_lanes(f);
        if (n <= QD_LANES_MIN) { return qd_fl_set_lanes(f, QD_LANES_MIN); }
        return qd_fl_set_lanes(f, n - 1);
    }
    if (kind == QD_QH_PLUS) {
        const n : u32 = qd_fl_lanes(f);
        if (n >= EV_MAX_AGENTS) { return qd_fl_set_lanes(f, EV_MAX_AGENTS); }
        return qd_fl_set_lanes(f, n + 1);
    }
    return f;
}
pub fn qd_fl_clear_now(f : u64) -> u64 {
    if (qd_fl_now(f)) { return f - QD_F_NOW; }
    return f;
}
/// The window's mirror of the keys: bit k of `mask` = provider k has a key.
pub fn qd_fl_with_keys(f : u64, mask : u32, light : u32) -> u64 {
    return f - ((qd_fl_keys(f) as u64) * 65536) - ((qd_fl_light(f) as u64) * 33554432) + ((mask % 512) as u64) * 65536 + ((light % 4) as u64) * 33554432;
}
/// The Queen tick may run: GOD MODE on and not paused, or the button was pressed (one tick, paused or not).
pub fn qd_tick_wanted(god : bool, f : u64) -> bool {
    return qd_fl_now(f) or (god and qd_fl_paused(f) == false);
}

// ---------------------------------------------------------------- the feed job

pub const QD_QDIR : str = "/.t27os/queen/";
pub const QD_FEED_CMD : str = "D=$HOME/.t27os/queen; mkdir -p $D; p=/tmp/claude-501/bin/tri-queen; [ -x \"$p\" ] || p=$(command -v tri-queen); [ -n \"$p\" ] || exit 0; \"$p\" queen --plan tick > $D/plan.tmp 2>&1; mv $D/plan.tmp $D/plan.txt";
pub const QD_FILE_PLAN : str = "plan.txt";
pub const QD_FILE_TRIGIT : str = "trigit.txt";
pub const QD_FEED_PERIOD_S : u64 = 120;
pub fn qd_feed_due(open : bool, now : u64, last : u64) -> bool {
    return open and (last == 0 or now >= last + QD_FEED_PERIOD_S);
}

// ---------------------------------------------------------------- parsing

fn qd_line_end(t : []const u8, n : usize, s : usize) -> usize {
    var e : usize = s;
    while (e < n and t[e] != 10) { e = e + 1; }
    return e;
}
/// Start of line k (0-based), n when there is none.
pub fn qd_line_start(t : []const u8, n : usize, k : u32) -> usize {
    var s : usize = 0;
    var i : u32 = 0;
    while (i < k and s < n) {
        s = qd_line_end(t, n, s) + 1;
        i = i + 1;
    }
    if (s > n) { return n; }
    return s;
}
pub fn qd_line_count(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    while (s < n) {
        if (qd_line_end(t, n, s) > s) { c = c + 1; }
        s = qd_line_end(t, n, s) + 1;
    }
    return c;
}
/// `key` followed by digits inside [s, e), at a word start; NOT_READ when absent.
pub fn qd_kv_num(t : []const u8, s : usize, e : usize, key : []const u8) -> u32 {
    var i : usize = s;
    while (i + key.len <= e) {
        var k : usize = 0;
        while (k < key.len and t[i + k] == key[k]) { k = k + 1; }
        if (k == key.len and (i == s or t[i - 1] == 32 or t[i - 1] == 124)) {
            var j : usize = i + key.len;
            if (j >= e or t[j] < 48 or t[j] > 57) { return QD_NOT_READ; }
            var v : u32 = 0;
            while (j < e and t[j] >= 48 and t[j] <= 57 and v < 100000000) {
                v = v * 10 + ((t[j] - 48) as u32);
                j = j + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return QD_NOT_READ;
}
/// The first run of digits after a '#' in [s, e): an issue number; 0 when none.
pub fn qd_issue_in(t : []const u8, s : usize, e : usize) -> u32 {
    var i : usize = s;
    while (i + 1 < e) {
        if (t[i] == 35 and t[i + 1] >= 48 and t[i + 1] <= 57) {
            var v : u32 = 0;
            var j : usize = i + 1;
            while (j < e and t[j] >= 48 and t[j] <= 57 and v < 100000000) {
                v = v * 10 + ((t[j] - 48) as u32);
                j = j + 1;
            }
            return v;
        }
        i = i + 1;
    }
    return 0;
}
/// The picks of `tri queen tick --plan`: every line after the "queen tick host=.. cap=.. running=.. slots=.." header
/// that is not an error line. The k-th pick's line start, n when none.
pub fn qd_is_header(t : []const u8, s : usize, e : usize) -> bool {
    return qd_kv_num(t, s, e, "cap=") != QD_NOT_READ and qd_kv_num(t, s, e, "slots=") != QD_NOT_READ;
}
pub fn qd_is_noise(t : []const u8, s : usize, e : usize) -> bool {
    if (e <= s) { return true; }
    if (e - s >= 6 and t[s] == 69 and t[s + 1] == 114 and t[s + 2] == 114) { return true; }
    if (e - s >= 6 and t[s] == 102 and t[s + 1] == 97 and t[s + 2] == 116 and t[s + 3] == 97 and t[s + 4] == 108) { return true; }
    return false;
}
pub fn qd_pick_start(t : []const u8, n : usize, k : u32) -> usize {
    var s : usize = 0;
    var seen : u32 = 0;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_is_header(t, s, e) == false and qd_is_noise(t, s, e) == false) {
            if (seen == k) { return s; }
            seen = seen + 1;
        }
        s = e + 1;
    }
    return n;
}
pub fn qd_pick_count(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    while (qd_pick_start(t, n, c) < n) { c = c + 1; }
    return c;
}
pub fn qd_pick_end(t : []const u8, n : usize, s : usize) -> usize { return qd_line_end(t, n, s); }
/// cap / running / slots of the plan header: NOT_READ for a missing part.
pub fn qd_plan_key(t : []const u8, n : usize, key : []const u8) -> u32 {
    var s : usize = 0;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_is_header(t, s, e)) { return qd_kv_num(t, s, e, key); }
        s = e + 1;
    }
    return QD_NOT_READ;
}

/// The hive heartbeat rows: `A|host|ts|hb1 host=.. cpu=.. ram=.. disk=..`. A machine is online when its row is
/// at most ONLINE_S old.
pub const QD_ONLINE_S : u64 = 120;
fn qd_num64(t : []const u8, s : usize, e : usize) -> u64 {
    var v : u64 = 0;
    var i : usize = s;
    while (i < e and t[i] >= 48 and t[i] <= 57) {
        v = v * 10 + ((t[i] - 48) as u64);
        i = i + 1;
    }
    return v;
}
/// For heartbeat row line [s, e): host start/end and the ts; false when it is not an A row.
fn qd_hb_parts(t : []const u8, s : usize, e : usize, out : []usize) -> bool {
    if (e < s + 4 or t[s] != 65 or t[s + 1] != 124) { return false; }
    var i : usize = s + 2;
    while (i < e and t[i] != 124) { i = i + 1; }
    if (i >= e) { return false; }
    out[0] = s + 2;
    out[1] = i;
    out[2] = i + 1;
    return true;
}
pub fn qd_hive_total(t : []const u8, n : usize) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) { c = c + 1; }
        s = e + 1;
    }
    return c;
}
pub fn qd_hive_online(t : []const u8, n : usize, now : u64) -> u32 {
    var c : u32 = 0;
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) {
            const ts : u64 = qd_num64(t, p[2], e);
            if (ts + QD_ONLINE_S >= now) { c = c + 1; }
        }
        s = e + 1;
    }
    return c;
}
/// A reading (cpu=, ram=, disk=) of the row of `host`; NOT_READ when the host has no row.
pub fn qd_hive_own(t : []const u8, n : usize, host : []const u8, hn : usize, key : []const u8) -> u32 {
    var s : usize = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3]) and p[1] - p[0] == hn) {
            var k : usize = 0;
            while (k < hn and t[p[0] + k] == host[k]) { k = k + 1; }
            if (k == hn) { return qd_kv_num(t, s, e, key); }
        }
        s = e + 1;
    }
    return QD_NOT_READ;
}
/// The k-th A row's host name copied to out; its length (0 when none).
pub fn qd_hive_name(t : []const u8, n : usize, k : u32, out : []u8) -> usize {
    var s : usize = 0;
    var c : u32 = 0;
    var p : [3]usize = undefined;
    while (s < n) {
        const e : usize = qd_line_end(t, n, s);
        if (qd_hb_parts(t, s, e, p[0..3])) {
            if (c == k) {
                var i : usize = 0;
                while (p[0] + i < p[1] and i < out.len) {
                    out[i] = t[p[0] + i];
                    i = i + 1;
                }
                return i;
            }
            c = c + 1;
        }
        s = e + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- the texts

/// Copies up to cap bytes of line [s, e) of t, printable ASCII only.
pub fn qd_put_line(out : []u8, w : usize, t : []const u8, s : usize, e : usize, cap : usize) -> usize {
    var k : usize = 0;
    var o : usize = w;
    while (s + k < e and k < cap) {
        var b : u8 = t[s + k];
        if (b < 32 or b > 126) { b = 32; }
        out[o] = b;
        o = o + 1;
        k = k + 1;
    }
    return o;
}

pub fn qd_god_line1(out : []u8, god : bool, paused : bool) -> usize {
    var w : usize = 0;
    if (god) { w = put_bytes(out, 0, "ON"); } else { w = put_bytes(out, 0, "OFF"); }
    if (paused) { w = put_bytes(out, w, "  PAUSED"); }
    return w;
}
pub fn qd_god_line2(out : []u8, god : bool, paused : bool, ago : u64, none : bool) -> usize {
    var w : usize = put_bytes(out, 0, "last ");
    if (none) {
        w = put_bytes(out, w, "none");
    } else {
        w = age_text(out, w, ago);
    }
    w = put_bytes(out, w, "  next ");
    if (god == false or paused or none) { return put_bytes(out, w, "-"); }
    if (ago >= GOD_TICK_S) { return put_bytes(out, w, "now"); }
    return age_text(out, w, GOD_TICK_S - ago);
}
pub fn qd_local_line1(out : []u8, cap : u32, running : u32, slots : u32) -> usize {
    var w : usize = put_bytes(out, 0, "cap ");
    w = put_dec(out, w, cap as u64);
    w = put_bytes(out, w, "  running ");
    w = put_dec(out, w, running as u64);
    w = put_bytes(out, w, "  slots ");
    return put_dec(out, w, slots as u64);
}
/// Why the Queen starts nothing, or what she may start.
pub fn qd_local_line2(out : []u8, have : bool, cap : u32, running : u32, slots : u32) -> usize {
    if (have == false) { return put_bytes(out, 0, "no plan yet"); }
    if (slots == 0) {
        var w : usize = put_bytes(out, 0, "full: ");
        w = put_dec(out, w, running as u64);
        w = put_bytes(out, w, " of ");
        w = put_dec(out, w, cap as u64);
        return put_bytes(out, w, " lanes run");
    }
    var w2 : usize = put_dec(out, 0, slots as u64);
    return put_bytes(out, w2, " free");
}
pub fn qd_no_feed(out : []u8) -> usize { return put_bytes(out, 0, "no feed"); }
pub fn qd_light_word(l : u32) -> str {
    if (l == 1) { return "green"; }
    if (l == 2) { return "yellow"; }
    if (l == 3) { return "red"; }
    return "no light";
}
pub fn qd_popcount9(m : u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < 9) {
        if ((m >> i) % 2 == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
pub fn qd_keys_line1(out : []u8, mask : u32) -> usize {
    var w : usize = put_dec(out, 0, qd_popcount9(mask) as u64);
    return put_bytes(out, w, " of 9 providers hold keys");
}
pub fn qd_keys_line2(out : []u8, light : u32) -> usize {
    var w : usize = put_bytes(out, 0, "worst light ");
    return put_bytes(out, w, qd_light_word(light));
}
pub fn qd_machine_line1(out : []u8, cpu : u32, ram : u32) -> usize {
    if (cpu == QD_NOT_READ and ram == QD_NOT_READ) { return put_bytes(out, 0, "no heartbeat"); }
    var w : usize = 0;
    if (cpu != QD_NOT_READ) {
        w = put_bytes(out, w, "cpu ");
        w = put_dec(out, w, cpu as u64);
        w = put_bytes(out, w, "  ");
    }
    if (ram != QD_NOT_READ) {
        w = put_bytes(out, w, "ram ");
        w = put_dec(out, w, ram as u64);
    }
    return w;
}
pub fn qd_machine_line2(out : []u8, disk_gb : u32) -> usize {
    if (disk_gb == QD_NOT_READ) { return put_bytes(out, 0, "disk not read"); }
    var w : usize = put_bytes(out, 0, "disk ");
    w = put_dec(out, w, disk_gb as u64);
    return put_bytes(out, w, " GB free");
}
pub fn qd_machines_line1(out : []u8, online : u32, total : u32) -> usize {
    var w : usize = put_dec(out, 0, online as u64);
    w = put_bytes(out, w, " online of ");
    return put_dec(out, w, total as u64);
}
/// The agents pinned to widget i ("Q O T").
pub fn qd_pin_text(i : u32, out : []u8) -> usize {
    var k : u32 = 0;
    var s : usize = 0;
    while (k < i and s < QD_PIN_AGENTS.len) {
        if (QD_PIN_AGENTS[s] == 44) { k = k + 1; }
        s = s + 1;
    }
    var n : usize = 0;
    while (s < QD_PIN_AGENTS.len and QD_PIN_AGENTS[s] != 44) {
        out[n] = QD_PIN_AGENTS[s];
        n = n + 1;
        s = s + 1;
    }
    return n;
}
pub fn qd_tile_name(i : u32, out : []u8) -> usize {
    var k : u32 = 0;
    var s : usize = 0;
    while (k < i and s < QD_TILE_NAMES.len) {
        if (QD_TILE_NAMES[s] == 44) { k = k + 1; }
        s = s + 1;
    }
    var n : usize = 0;
    while (s < QD_TILE_NAMES.len and QD_TILE_NAMES[s] != 44) {
        out[n] = QD_TILE_NAMES[s];
        n = n + 1;
        s = s + 1;
    }
    return n;
}

// ---------------------------------------------------------------- tests

fn qd_q_eq(a : []const u8, n : usize, s : []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_tiles_and_tables_fit_the_page_at_every_width_and_the_columns_never_overlap {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        const c : u32 = qd_cols(w);
        assert(c >= 1 and c <= 4);
        assert(qd_tile_w(w) >= QD_TILE_MIN_W - 0.001 or c == 1);
        // the last tile of a row ends inside the page
        assert(qd_tile_x(c - 1, 0.0, w) + qd_tile_w(w) <= w - QD_PAD + 0.001);
        // tile 0 is above tile c (the next row) with a gap
        if (QD_TILE_COUNT > c) { assert(qd_tile_y(c, 0.0, w) >= qd_tile_y(0, 0.0, w) + QD_TILE_H + QD_GAP - 0.001); }
        assert(qd_tiles_bottom(0.0, w) > qd_tile_y(QD_TILE_COUNT - 1, 0.0, w));
        assert(qd_col_x(0, 0.0, w) < qd_col_x(1, 0.0, w) and qd_col_x(3, 0.0, w) < qd_col_x(4, 0.0, w));
        w = w + 60.0;
    }
    assert(qd_cols(1400.0) == 4);
    assert(qd_cols(300.0) == 1);
}

test every_widget_names_its_pinned_agents_and_a_name {
    var i : u32 = 0;
    var b : [32]u8 = undefined;
    while (i < QD_WIDGET_COUNT) {
        assert(qd_pin_text(i, b[0..32]) >= 1);
        i = i + 1;
    }
    assert(qd_q_eq(b[0..32], qd_pin_text(QD_T_GOD, b[0..32]), "Q O T"));
    assert(qd_q_eq(b[0..32], qd_pin_text(QD_W_QUEUE, b[0..32]), "Q J S"));
    assert(qd_q_eq(b[0..32], qd_tile_name(QD_T_TRIGIT, b[0..32]), "TRIGIT"));
    assert(qd_q_eq(b[0..32], qd_tile_name(QD_T_MACHINES, b[0..32]), "MACHINES ONLINE"));
}

test the_graph_band_sits_between_the_tiles_and_the_tables {
    var w : f64 = 380.0;
    while (w <= 1400.0) {
        assert(qd_graph_top(0.0, w) == qd_tiles_bottom(0.0, w));
        assert(qd_lanes_top(0.0, w) >= qd_graph_top(0.0, w) + QD_GRAPH_H + QD_GAP - 0.001);
        // the tables still fit under the band at every width that shows tables at all
        assert(qd_table_rows(0.0, w, 440.0) >= 0);
        w = w + 60.0;
    }
    assert(QD_WIDGET_COUNT == 9);
    var b : [24]u8 = undefined;
    assert(qd_q_eq(b[0..24], qd_pin_text(QD_W_GRAPH, b[0..24]), "Q J W"));
}

test a_press_is_hit_where_the_button_is_drawn {
    const x0 : f64 = 200.0;
    const y0 : f64 = 60.0;
    const w : f64 = 760.0;
    const h : f64 = 440.0;
    const gx : f64 = qd_tile_x(QD_T_GOD, x0, w);
    const gy : f64 = qd_tile_y(QD_T_GOD, y0, w);
    assert(qd_hit(qd_god_btn_x(gx) + 5.0, qd_btn_y(gy) + 5.0, x0, y0, w, h, 2, 2) == QD_QH_GOD);
    const lx : f64 = qd_tile_x(QD_T_LOCAL, x0, w);
    const ly : f64 = qd_btn_y(qd_tile_y(QD_T_LOCAL, y0, w)) + 5.0;
    assert(qd_hit(qd_tick_btn_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_TICK);
    assert(qd_hit(qd_minus_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_MINUS);
    assert(qd_hit(qd_plus_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_PLUS);
    assert(qd_hit(qd_pause_x(lx) + 5.0, ly, x0, y0, w, h, 2, 2) == QD_QH_PAUSE);
    // the buttons of one tile never overlap each other and stay inside the tile
    assert(qd_tick_btn_x(lx) + QD_TICK_BTN_W < qd_minus_x(lx) and qd_minus_x(lx) + QD_STEP_W < qd_num_x(lx) + 14.0 and qd_plus_x(lx) + QD_STEP_W < qd_pause_x(lx));
    assert(qd_pause_x(lx) + QD_PAUSE_BTN_W <= lx + qd_tile_w(w));
    assert(qd_hit(qd_close_x(x0, w) + 4.0, y0 + 14.0, x0, y0, w, h, 2, 2) == QD_QH_CLOSE);
    // a lane row and a queue row carry their index
    const r1 : u32 = qd_hit(x0 + 60.0, qd_lane_row_y(1, y0, w) + 4.0, x0, y0, w, h, 3, 2);
    assert(qd_hit_kind(r1) == QD_QH_LANE and qd_hit_row(r1) == 1);
    const q0 : u32 = qd_hit(x0 + 60.0, qd_queue_row_y(0, y0, w, 3) + 4.0, x0, y0, w, h, 3, 2);
    assert(qd_hit_kind(q0) == QD_QH_QUEUE and qd_hit_row(q0) == 0);
    assert(qd_hit(x0 + 2.0, y0 + 2.0, x0, y0, w, h, 3, 2) == QD_QH_NONE);
    assert(qd_queue_top(y0, w, 3) > qd_lane_row_y(2, y0, w) + QD_ROW_H - 0.001);
    assert(qd_table_rows(y0, w, h) >= qd_lane_rows_shown(4) + qd_queue_rows_shown(4) - 1 or qd_table_rows(y0, w, h) < 2);
}

test the_actions_change_the_flags_within_their_limits {
    var f : u64 = 0;
    assert(qd_fl_lanes(f) == 1);
    f = qd_fl_press(f, QD_QH_PLUS);
    f = qd_fl_press(f, QD_QH_PLUS);
    assert(qd_fl_lanes(f) == 3);
    f = qd_fl_press(f, QD_QH_PLUS);
    assert(qd_fl_lanes(f) == EV_MAX_AGENTS);
    f = qd_fl_press(f, QD_QH_MINUS);
    assert(qd_fl_lanes(f) == 2);
    f = qd_fl_press(f, QD_QH_MINUS);
    f = qd_fl_press(f, QD_QH_MINUS);
    assert(qd_fl_lanes(f) == QD_LANES_MIN);
    assert(qd_fl_paused(f) == false);
    f = qd_fl_press(f, QD_QH_PAUSE);
    assert(qd_fl_paused(f));
    f = qd_fl_press(f, QD_QH_PAUSE);
    assert(qd_fl_paused(f) == false);
    f = qd_fl_press(f, QD_QH_TICK);
    f = qd_fl_press(f, QD_QH_TICK);
    assert(qd_fl_now(f));
    f = qd_fl_clear_now(f);
    assert(qd_fl_now(f) == false);
    // the keys mirror does not disturb the buttons' bits
    f = qd_fl_press(f, QD_QH_PLUS);
    f = qd_fl_with_keys(f, 7, 3);
    assert(qd_fl_keys(f) == 7 and qd_fl_light(f) == 3 and qd_fl_lanes(f) == 2);
    f = qd_fl_with_keys(f, 1, 1);
    assert(qd_fl_keys(f) == 1 and qd_fl_light(f) == 1 and qd_fl_lanes(f) == 2);
    // a tick runs while GOD MODE is on and not paused, or once when the button was pressed
    assert(qd_tick_wanted(false, 0) == false);
    assert(qd_tick_wanted(true, 0));
    assert(qd_tick_wanted(true, QD_F_PAUSE) == false);
    assert(qd_tick_wanted(false, QD_F_NOW));
    assert(qd_tick_wanted(true, QD_F_PAUSE + QD_F_NOW));
}

test the_plan_the_hive_and_the_tile_texts_are_read_from_their_files {
    const plan : []const u8 = "queen tick host=Gaia cap=3 running=1 slots=2\n#11400 P0 fix the thing\nError: tri queen: nope\n#11401 P1 other\n";
    const pn : usize = plan.len;
    assert(qd_plan_key(plan, pn, "cap=") == 3);
    assert(qd_plan_key(plan, pn, "running=") == 1);
    assert(qd_plan_key(plan, pn, "slots=") == 2);
    assert(qd_plan_key(plan, pn, "nope=") == QD_NOT_READ);
    assert(qd_pick_count(plan, pn) == 2);
    const s0 : usize = qd_pick_start(plan, pn, 0);
    assert(qd_issue_in(plan, s0, qd_pick_end(plan, pn, s0)) == 11400);
    const s1 : usize = qd_pick_start(plan, pn, 1);
    assert(qd_issue_in(plan, s1, qd_pick_end(plan, pn, s1)) == 11401);
    assert(qd_pick_start(plan, pn, 2) == pn);
    // an error-only plan has no header and no picks
    const bad : []const u8 = "Error: tri queen: origin's claims could not be read\nfatal: x\n";
    assert(qd_plan_key(bad, bad.len, "cap=") == QD_NOT_READ);
    assert(qd_pick_count(bad, bad.len) == 0);
    const hive : []const u8 = "S|1000\nZ|1000|hb1 host=X\nA|Gaia|990|hb1 host=Gaia build=1 cpu=67 ram=56 disk=30 lanes=-\nA|Old|100|hb1 host=Old cpu=1 ram=2 disk=3\nB|1|Gaia\n";
    assert(qd_hive_total(hive, hive.len) == 2);
    assert(qd_hive_online(hive, hive.len, 1000) == 1);
    assert(qd_hive_online(hive, hive.len, 100000) == 0);
    assert(qd_hive_own(hive, hive.len, "Gaia", 4, "cpu=") == 67);
    assert(qd_hive_own(hive, hive.len, "Gaia", 4, "ram=") == 56);
    assert(qd_hive_own(hive, hive.len, "Nobody", 6, "cpu=") == QD_NOT_READ);
    var nm : [24]u8 = undefined;
    assert(qd_q_eq(nm[0..24], qd_hive_name(hive, hive.len, 1, nm[0..24]), "Old"));
    assert(qd_hive_name(hive, hive.len, 5, nm[0..24]) == 0);
    var t : [96]u8 = undefined;
    assert(qd_q_eq(t[0..96], qd_god_line1(t[0..96], true, true), "ON  PAUSED"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], true, false, 120, false), "last 2m  next 3m"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], false, false, 120, false), "last 2m  next -"));
    assert(qd_q_eq(t[0..96], qd_god_line2(t[0..96], true, false, 0, true), "last none  next -"));
    assert(qd_q_eq(t[0..96], qd_local_line1(t[0..96], 3, 3, 0), "cap 3  running 3  slots 0"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], true, 3, 3, 0), "full: 3 of 3 lanes run"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], true, 3, 1, 2), "2 free"));
    assert(qd_q_eq(t[0..96], qd_local_line2(t[0..96], false, 3, 0, 0), "no plan yet"));
    assert(qd_q_eq(t[0..96], qd_no_feed(t[0..96]), "no feed"));
    assert(qd_q_eq(t[0..96], qd_keys_line1(t[0..96], 7), "3 of 9 providers hold keys"));
    assert(qd_q_eq(t[0..96], qd_keys_line2(t[0..96], 3), "worst light red"));
    assert(qd_q_eq(t[0..96], qd_machine_line1(t[0..96], 67, 56), "cpu 67  ram 56"));
    assert(qd_q_eq(t[0..96], qd_machine_line1(t[0..96], QD_NOT_READ, QD_NOT_READ), "no heartbeat"));
    assert(qd_q_eq(t[0..96], qd_machine_line2(t[0..96], 30), "disk 30 GB free"));
    assert(qd_q_eq(t[0..96], qd_machines_line1(t[0..96], 1, 2), "1 online of 2"));
    assert(qd_feed_due(true, 500, 0) and qd_feed_due(true, 500, 400) == false and qd_feed_due(true, 600, 400) and qd_feed_due(false, 500, 0) == false);
}

test the_feed_job_reads_only_and_never_starts_a_lane {
    assert(QD_FEED_CMD.len > 40);
    var i : usize = 0;
    var plan : bool = false;
    while (i + 6 < QD_FEED_CMD.len) {
        if (QD_FEED_CMD[i] == 45 and QD_FEED_CMD[i + 1] == 45 and QD_FEED_CMD[i + 2] == 112 and QD_FEED_CMD[i + 3] == 108) { plan = true; }
        i = i + 1;
    }
    assert(plan);
}
