// SPDX-License-Identifier: Apache-2.0
; specs/t27os/frame_main.t27 -- the host program that writes the T27 OS video frame to a PPM file after every run
; (Refs gHashTag/t27#12203). Owner, 2026-10-25: the frame of the video core must be visible on screen after every run, not
; only on the board. This program renders the 640x480 raster once, writes /tmp/t27_frame.ppm (or FRAME_OUT) as a binary
; PPM P6 (15 header bytes, then 921600 RGB bytes, top row first, red first) and stops; the operator converts it to PNG
; with ffmpeg and opens it.
; --
; MODES. FRAME_MODE=title (the default) renders the text raster, white 8x8 glyphs of the T27 OS title on black at
; the top left, and runs hg_check from fpga::hdmi_grab on the bytes it wrote: exit 0 on V_PASS, exit 1 on any other
; verdict. FRAME_MODE=pattern calls fb_test_pattern() once and renders the framebuffer (a 16x16 grid of the 256
; palette entries with a gradient strip along its bottom, inside a 640x400 band with 40 black rows above and below);
; the title checker does not apply to it and is not run. Any other FRAME_MODE prints a message and exits 2. An
; unopenable FRAME_OUT or a short write exits 2.
; --
; THE LAYOUT AND THE PALETTE LIVE IN fpga::wasm_fb (specs/fpga/wasm_fb.t27), the home of the 320x200 frame, the
; 2x scale, the letterbox and the pal_default ramp. `use` splices fn, struct, enum, const and type, never a
; module-level var (decl_name in bootstrap/src/use_resolve.rs), so the spliced functions find no FB or PAL: the two
; arrays are declared below under the same names and types as in wasm_fb. Nothing else is copied; the source of every
; pixel is frame_pixel_at, and the title expectation is that of hg_check, which asks the own pixel_at of vga_text_core.
; --
; BUILD (on the lab; the Mac runs only the binary and ffmpeg):
;   t27c gen specs/t27os/frame_main.t27 > frame.zig
;   zig build-exe frame.zig -lc
;   FRAME_MODE=pattern ./frame
;   ffmpeg -y -i /tmp/t27_frame.ppm /tmp/t27_frame.png
; The mode is compared byte by byte against string constants; there is no char literal in this file.
; What a title run says: the PPM writer and the frame layout are right, because frame and checker ask the same
; pixel_at. It does not say the board shows anything; that is the job of hdmi_grab.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osFrameMain;

use fpga::hdmi_grab::hg_check;
use fpga::hdmi_grab::hg_put_header;
use fpga::hdmi_grab::V_PASS;
use fpga::hdmi_grab::V_TITLE;
use fpga::wasm_fb::frame_pixel_at;
use fpga::wasm_fb::fb_test_pattern;

// ---- the arrays the functions of wasm_fb read; same names and types as in specs/fpga/wasm_fb.t27 ----

pub var FB : [64000]u8 = [0] ** 64000;
pub var PAL : [256]u32 = [0] ** 256;

// ---- the PPM bytes of one frame: 15 header bytes plus 640 * 480 * 3 = 921600 ----

pub var FM_OUT : [921615]u8 = [0] ** 921615;

pub const FM_TITLE : usize = 0;
pub const FM_PATTERN : usize = 1;

/// Render the 640x480 frame into FM_OUT as a P6 PPM, the source of each pixel picked by frame_pixel_at; the byte count.
pub fn fm_render(fb_on: bool) -> usize {
    var p : usize = hg_put_header(&FM_OUT, 640, 480);
    var y : u32 = 0;
    while (y < 480) {
        var x : u32 = 0;
        while (x < 640) {
            const c : u32 = frame_pixel_at(x, y, fb_on);
            FM_OUT[p] = @as(u8, @intCast((c >> 16) & 255));
            FM_OUT[p + 1] = @as(u8, @intCast((c >> 8) & 255));
            FM_OUT[p + 2] = @as(u8, @intCast(c & 255));
            p += 3;
            x += 1;
        }
        y += 1;
    }
    return p;
}

/// Is the NUL-terminated string s exactly the fixed text want.
fn fm_is(s: [*:0]const u8, want: []const u8) -> bool {
    var i : usize = 0;
    while (i < want.len) {
        if (s[i] != want[i]) { return false; }
        i += 1;
    }
    return s[i] == 0;
}

pub fn main() void {
    const name_title : []const u8 = "title";
    const name_pattern : []const u8 = "pattern";
    var mode : usize = FM_TITLE;
    const m = std.c.getenv("FRAME_MODE");
    if (m != null) {
        const s = m.?;
        var known : bool = false;
        if (fm_is(s, name_title)) { mode = FM_TITLE; known = true; }
        if (fm_is(s, name_pattern)) { mode = FM_PATTERN; known = true; }
        if (known == false) {
            std.debug.print("frame: FRAME_MODE must be title or pattern, got {s}\n", .{s});
            std.c.exit(2);
        }
    }
    var path : [*:0]const u8 = "/tmp/t27_frame.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    if (mode == FM_PATTERN) { fb_test_pattern(); }
    const n : usize = fm_render(mode == FM_PATTERN);
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("frame: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&FM_OUT), 1, n, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != n) {
        std.debug.print("frame: short write to {s}: {d} of {d} bytes\n", .{ path, w, n });
        std.c.exit(2);
    }
    std.debug.print("frame: wrote {d} bytes to {s}\n", .{ n, path });
    if (mode == FM_TITLE) {
        const v : usize = hg_check(&FM_OUT, n);
        if (v == V_PASS) {
            std.debug.print("frame: title PASS (hg_check verdict {d}, the T27 OS title on black)\n", .{v});
        } else {
            std.debug.print("frame: title FAIL (hg_check verdict {d}: 1 not a PPM, 2 short, 3 title wrong, 4 background lit)\n", .{v});
            std.c.exit(1);
        }
    } else {
        std.debug.print("frame: pattern written; hg_check does not apply to it\n", .{});
    }
}

test the_header_is_p6_640_480_255_in_15_bytes {
    const n : usize = hg_put_header(&FM_OUT, 640, 480);
    assert n == 15;
    const want : []const u8 = "P6\n640 480\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert FM_OUT[i] == want[i];
        i += 1;
    }
}

test a_frame_is_15_header_bytes_plus_921600_rgb_bytes {
    // title: the count, the verdict of the checker, black at pixel (0,0) and white at pixel (1,0) (the bar of T)
    const n : usize = fm_render(false);
    assert n == 921615;
    assert hg_check(&FM_OUT, n) == V_PASS;
    assert FM_OUT[15] == 0;
    assert FM_OUT[18] == 255;
    assert FM_OUT[19] == 255;
    assert FM_OUT[20] == 255;
    // pattern: same count; pixel (0,40) is palette entry 0 = 0x0F0F0F, whose first byte is at 15 + 40 * 640 * 3
    fb_test_pattern();
    const k : usize = fm_render(true);
    assert k == 921615;
    assert FM_OUT[76815] == 15;
    assert FM_OUT[76816] == 15;
    assert FM_OUT[76817] == 15;
    // the title checker refuses the pattern: its top rows are letterbox black, the title is not there
    assert hg_check(&FM_OUT, k) == V_TITLE;
}
