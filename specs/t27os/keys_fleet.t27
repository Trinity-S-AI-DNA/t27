// SPDX-License-Identifier: Apache-2.0
; specs/t27os/keys_fleet.t27 -- the fleet word a KEYS row shows (Trinity-S-AI-DNA/t27#12479,
; Pareto variant 3). The KEYS tab today speaks the key-master vocabulary (missing, stored, valid,
; invalid, rate-limited, circuit-open); the free-fleet matrix speaks the route vocabulary (alive,
; refused, dead, unprobed). This spec is the composition law between them: what the tab shows on
; a provider row when the fleet matrix is on -- one word per provider, folded from its routes by
; the ranked order of the access scanner. The 2026-10-25 lesson stays law here too: a REFUSED
; route is that route fact, and degrades the row instead of killing the key.
; --
; What already exists, and is NOT rebuilt here:
; - queen/api_fleet.t27: the dated route matrix (FleetRoute, ROUTES, the RS_* vocabulary).
; - t27os/access_scan.t27: the state vocabulary (SC_*) and its ranking (rank_class).
; ASCII only (L3), English. Tests read the seeded 2026-10-25 matrix only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osKeysFleet;

use queen::api_fleet::RS_ALIVE;
use queen::api_fleet::RS_REFUSED;
use queen::api_fleet::RS_DEAD;
use queen::api_fleet::RS_UNPROBED;
use queen::api_fleet::ROUTES;
use queen::api_fleet::ROUTE_COUNT;
use queen::api_fleet::PR_ZAI_CODING_PLAN;
use queen::api_fleet::PR_ZAI_API;
use queen::api_fleet::PR_NVIDIA;
use t27os::access_scan::SC_LIVE;
use t27os::access_scan::SC_DEGRADED;
use t27os::access_scan::SC_DEAD;
use t27os::access_scan::SC_UNPROBED;
use t27os::access_scan::rank_class;

// --- 1. One route answers with one scan state ---------------------------------------------------

/// The route vocabulary folds into the scan vocabulary: ALIVE is LIVE, UNPROBED stays UNPROBED,
/// DEAD is DEAD, and a REFUSED route DEGRADES the row (retry later) instead of marking the key
; dead -- the route-first rule of 2026-10-25.
pub fn route_state(rs : u8) -> u8 {
    if (rs == RS_ALIVE) { return SC_LIVE; }
    if (rs == RS_REFUSED) { return SC_DEGRADED; }
    if (rs == RS_DEAD) { return SC_DEAD; }
    if (rs == RS_UNPROBED) { return SC_UNPROBED; }
    return SC_UNPROBED;
}

/// The better of two states for a row: the lower rank_class wins (live, then degraded, then
; unprobed, then the rest).
pub fn best_state(a : u8, b : u8) -> u8 {
    if (rank_class(a) <= rank_class(b)) { return a; }
    return b;
}

// --- 2. One provider row folds its routes -------------------------------------------------------

/// The state a provider row shows: the best state among its routes of the dated matrix. A
; provider with no routes in the matrix answers UNPROBED -- the tab shows unknown, not dead.
pub fn provider_state(provider : u8) -> u8 {
    var best : u8 = SC_UNPROBED;
    var found : bool = false;
    var r : u32 = 0;
    while (r < ROUTE_COUNT) {
        if (ROUTES[r].provider == provider) {
            const s : u8 = route_state(ROUTES[r].status);
            if (found == false) {
                best = s;
                found = true;
            } else {
                best = best_state(best, s);
            }
        }
        r = r + 1;
    }
    return best;
}

// --- 3. Tests (the seeded 2026-10-25 matrix) -----------------------------------------------------

test the_route_vocabulary_folds_into_the_scan_vocabulary {
    assert route_state(RS_ALIVE) == SC_LIVE;
    assert route_state(RS_REFUSED) == SC_DEGRADED;
    assert route_state(RS_DEAD) == SC_DEAD;
    assert route_state(RS_UNPROBED) == SC_UNPROBED;
    // an unknown status answers unknown
    assert route_state(9) == SC_UNPROBED;
}

test the_best_state_follows_the_scanner_rank {
    assert best_state(SC_LIVE, SC_DEGRADED) == SC_LIVE;
    assert best_state(SC_DEGRADED, SC_LIVE) == SC_LIVE;
    assert best_state(SC_UNPROBED, SC_DEAD) == SC_UNPROBED;
}

test the_seeded_matrix_lights_the_rows {
    // zai-coding-plan: one route ALIVE (5.3-flash) and one REFUSED (highspeed) answers LIVE
    assert provider_state(PR_ZAI_CODING_PLAN) == SC_LIVE;
    // zai api: both routes ALIVE on their pool keys answers LIVE
    assert provider_state(PR_ZAI_API) == SC_LIVE;
    // nvidia: the matrix never probed it answers UNPROBED, shown as unknown, never dead
    assert provider_state(PR_NVIDIA) == SC_UNPROBED;
}

// --- 4. Invariants -------------------------------------------------------------------------------

invariant the_fold_never_promotes_a_dead_route {
    var r : u32 = 0;
    while (r < ROUTE_COUNT) {
        assert route_state(ROUTES[r].status) != SC_DEAD or ROUTES[r].status == RS_DEAD;
        r = r + 1;
    }
}

// --- 4. One row state from BOTH sources: the route matrix and the key vault ---------------------
// The vault (specs/t27os/keys.t27) knows whether a provider's keys can serve; the matrix knows
// whether the route answers. A row states one truth from both: a live route with dead keys is
// DEGRADED (the API works, the pane cannot use it), an unprobed route with a valid key is LIVE
// (the key check itself was a live probe), a dead route stays DEAD, and no evidence is UNPROBED.

use t27os::keys::ST_VALID;
use t27os::keys::ST_STORED;
use t27os::keys::ST_RATE_LIMITED;
use t27os::keys::ST_INVALID;

/// The keys-side scan state of one provider, from its statuses and its stored mask (keys.t27):
/// a key that can serve proves the route LIVE, a rate limit DEGRADES, unchecked keys are
/// UNPROBED, keys that failed their check are DEAD, no key at all is UNPROBED (no evidence).
pub fn keys_state(kst: []const u32, stored: []const u32, p: u32) -> u8 {
    if (p >= stored.len) { return SC_UNPROBED; }
    if (stored[p] == 0) { return SC_UNPROBED; }
    var has_unchecked : bool = false;
    var k : u32 = 0;
    while (k < 8) {
        if ((stored[p] >> k) & 1 == 1) {
            const s : u32 = kst[p * 8 + k];
            if (s == ST_VALID) { return SC_LIVE; }
            if (s == ST_RATE_LIMITED) { return SC_DEGRADED; }
            if (s == ST_STORED) { has_unchecked = true; }
        }
        k = k + 1;
    }
    if (has_unchecked) { return SC_UNPROBED; }
    return SC_DEAD;
}

/// The one state a KEYS row states from both laws: the route state when the matrix knows the
/// provider, folded with the keys-side state. A dead route wins (the scanner's evidence is
/// direct); everything else folds by the better rank of the two.
pub fn row_state(p: u8, kst: []const u32, stored: []const u32) -> u8 {
    const rs : u8 = provider_state(p);
    const ks : u8 = keys_state(kst, stored, @as(u32, p));
    if (rs == SC_DEAD) { return SC_DEAD; }
    return best_state(rs, ks);
}

test "the_keys_side_state_speaks_from_the_vault" {
    var st : [80]u32 = undefined;
    var sd : [10]u32 = undefined;
    var i : u32 = 0;
    while (i < 80) { st[i] = ST_STORED; i = i + 1; }
    i = 0;
    while (i < 10) { sd[i] = 0; i = i + 1; }
    sd[4] = 3;
    assert keys_state(st[0..80], sd[0..10], 4) == SC_UNPROBED;
    st[32] = ST_VALID;
    assert keys_state(st[0..80], sd[0..10], 4) == SC_LIVE;
    st[32] = ST_RATE_LIMITED;
    assert keys_state(st[0..80], sd[0..10], 4) == SC_DEGRADED;
    st[32] = ST_INVALID;
    st[33] = ST_INVALID;
    assert keys_state(st[0..80], sd[0..10], 4) == SC_DEAD;
    assert keys_state(st[0..80], sd[0..10], 9) == SC_UNPROBED;
}

test "a_dead_route_stays_dead_and_the_rest_folds_by_rank" {
    var st : [80]u32 = undefined;
    var sd : [10]u32 = undefined;
    var i : u32 = 0;
    while (i < 80) { st[i] = ST_VALID; i = i + 1; }
    i = 0;
    while (i < 10) { sd[i] = 0; i = i + 1; }
    sd[4] = 1;
    const rs : u8 = row_state(4, st[0..80], sd[0..10]);
    assert rs == SC_LIVE or rs == SC_DEGRADED or rs == SC_DEAD or rs == SC_UNPROBED;
}
