// SPDX-License-Identifier: Apache-2.0
; specs/t27os/keysync_rules.t27 -- the rules of the key sync that lean on the TRI CLAW sign-in and the GitHub App's
; token table. Kept apart from keysync.t27 because the window imports that module, and claw::github_surface and
; share.t27 carry tables whose names collide with the window's when flattened (L_NONE). Everything here is a decision;
; nothing holds a secret. Every test uses fake values. ASCII only (L3).
; Refs gHashTag/t27#11444.

module T27osKeysyncRules;

use t27os::share::connected;
use t27os::share::token_home_ok;
use t27os::share::gist_possible_with_app;
use t27os::share::W_KEYCHAIN;
use t27os::share::W_FILE;
use t27os::share::W_ENV;
use t27os::share::W_LINK;
use t27os::share::W_LOG;
use t27os::share::L_OUT;
use t27os::share::L_CONNECTED;
use t27os::share::L_AUTHORIZED;
use t27os::share::L_PLAYING;
use claw::github_surface::row_of;
use claw::github_surface::perm_of;
use claw::github_surface::level_of;
use claw::github_surface::L_READ;
use claw::github_surface::L_WRITE;
use claw::recipes::str_eq;
use t27os::keysync::WRITE_SURFACE;
use t27os::keysync::READ_SURFACE;
use t27os::keysync::sync_status;
use t27os::keysync::SY_SIGNED_OUT;
use t27os::keysync::SY_SYNCED;
use t27os::keysync::DS_TRUSTED;

/// Where a plaintext key or a private key may be: the Keychain only (share.t27 token_home_ok, same rule).
pub fn secret_home_ok(w: u32) -> bool {
    return token_home_ok(w);
}

/// Syncing needs the App token, so it needs a connected TRI CLAW (share.t27 L_CONNECTED or later).
pub fn may_sync(login: u32) -> bool {
    return connected(login);
}

/// The sync status for a sign-in state of share.t27.
pub fn status_for(login: u32, have_key: bool, contested: bool, my_state: u32, waiting: u32, others: u32) -> u32 {
    return sync_status(may_sync(login), have_key, contested, my_state, waiting, others);
}

/// The token rows (claw::github_surface): writing the store is contents write, reading it contents read, both on the
/// one private repository; no gist (an installation token cannot create one).
pub fn store_token_ok() -> bool {
    return str_eq(perm_of(WRITE_SURFACE, false), "contents") and level_of(WRITE_SURFACE, false) == L_WRITE
        and str_eq(perm_of(READ_SURFACE, false), "contents") and level_of(READ_SURFACE, false) == L_READ
        and !gist_possible_with_app();
}

test secrets_live_only_in_the_keychain {
    assert secret_home_ok(W_KEYCHAIN);
    assert secret_home_ok(W_FILE) == false;
    assert secret_home_ok(W_ENV) == false;
    assert secret_home_ok(W_LINK) == false;
    assert secret_home_ok(W_LOG) == false;
}

test the_store_uses_narrow_app_rows_and_no_gist {
    assert row_of(WRITE_SURFACE) >= 0 and row_of(READ_SURFACE) >= 0;
    assert store_token_ok();
    assert gist_possible_with_app() == false;
    // negative controls: the row that would plant a secret in a repository, and a workflow write, mint nothing
    assert level_of("secrets", false) == 0;
    assert level_of("workflows", false) == 0;
    assert level_of("gist-create", false) == 0;
    // the only permission the store asks is contents, so the token cannot touch issues, checks or settings
    assert str_eq(perm_of(WRITE_SURFACE, false), "issues") == false;
}

test syncing_needs_the_connected_app_and_nothing_less {
    assert may_sync(L_OUT) == false;
    assert may_sync(L_AUTHORIZED) == false;
    assert may_sync(L_CONNECTED);
    assert may_sync(L_PLAYING);
    assert status_for(L_OUT, true, false, DS_TRUSTED, 0, 2) == SY_SIGNED_OUT;
    assert status_for(L_CONNECTED, true, false, DS_TRUSTED, 0, 2) == SY_SYNCED;
}
