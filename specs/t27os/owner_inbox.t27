// specs/t27os/owner_inbox.t27 -- Owner inbox: DSH and T27 OS notices in one
// surface (extends FR-002 of #12945).
// Part of M8 milestone (milestone #12). Closes #12973.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::owner_inbox;

pub const OWNER_INBOX_MAX_NOTICES : u32 = 32;

pub struct InboxNotice { source: str, read: bool };

pub fn inbox_notice_read(n: InboxNotice) -> bool {
    return n.read;
}

test "inbox_notice_read" {
    assert(inbox_notice_read(InboxNotice { source: "DSH", read: true }));
    assert(!inbox_notice_read(InboxNotice { source: "T27 OS", read: false }));
}

invariant owner_inbox_max_notices_positive {
    assert OWNER_INBOX_MAX_NOTICES > 0;
}