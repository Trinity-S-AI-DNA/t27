// TEMPORARY probe 2: the name-scan loop alone.
module T27osCdpBrowserWsProbe2;

use t27os::cdp_browser_ws_probe::count_url_matches;

pub fn scan_names(list : []u8, got : usize) -> usize {
  const nm : [6]u8 = [34, 117, 114, 108, 34, 58];
  var i : usize = 0;
  var c : usize = 0;
  while (i + nm.len + 2 < got) {
    var ok : bool = true;
    var k : usize = 0;
    while (k < nm.len) {
      if (list[i + k] != nm[k]) { ok = false; }
      k = k + 1;
    }
    if (ok) { c = c + 1; }
    i = i + 1;
  }
  return c;
}

test t {
  const p : [133]u8 = [91, 123, 34, 100, 101, 115, 99, 114, 105, 112, 116, 105, 111, 110, 34, 58, 34, 102, 105, 120, 116, 117, 114, 101, 34, 44, 34, 116, 121, 112, 101, 34, 58, 34, 112, 97, 103, 101, 34, 44, 34, 117, 114, 108, 34, 58, 34, 104, 116, 116, 112, 115, 58, 47, 47, 116, 50, 55, 46, 97, 105, 47, 35, 47, 34, 44, 34, 119, 101, 98, 83, 111, 99, 107, 101, 116, 68, 101, 98, 117, 103, 103, 101, 114, 85, 114, 108, 34, 58, 32, 34, 119, 115, 58, 47, 47, 49, 50, 55, 46, 48, 46, 48, 46, 49, 58, 57, 56, 57, 50, 47, 100, 101, 118, 116, 111, 111, 108, 115, 47, 112, 97, 103, 101, 47, 84, 69, 83, 84, 49, 34, 125, 93];
  const pp : []u8 = p[0..133];
  assert scan_names(pp) == 1;
}
