// SPDX-License-Identifier: Apache-2.0
; Closes #11392
; specs/t27os/browser_broker.t27 -- LAYER 3: the broker doors of
; /api/browser/*. A MODEL ONLY: the TypeScript broker lives in the trios repo
; and is the witness; this file models its route table, its actor laws and
; every refusal as pure computation for t27b.
; -
; THE DOORS. Each door is METHOD + PATH, held as one const string in
; ROUTES. door_of(method, path) is the single resolver: unknown doors are
; refused before any actor check.
; -
; THE ACTOR LAW. An actor is PERSON or AGENT (an agent key). The TYPE and
; COOKIES doors are PERSON-ONLY: an AGENT key on them is a 403 refusal.
; -
; THE MANAGER GATE. When BROWSER_MANAGER_IDS is empty the broker denies
; everything: every refusal names the caller id and a reason code. An empty
; gate is deny-all, never allow-all.
; -
; THE PLACE GUARD. BANK, MAIL, PAY and CODE open only with a human
; permission younger than PERMISSION_WINDOW_SECS. An address the broker
; cannot read is treated as sensitive. agentMayOpen refuses the browser's
; own privileged schemes (chrome://, chrome-extension://, devtools://).
; -
; THE VIEW LAW. A view URL is a PATH, /live/<id>?t=<token>, never a full
; URL: no scheme, no host, no port. The proxy (layer 4) puts it under the
; app origin.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserBroker;

; --- 1. Route table -----------------------------------------------------------------------

pub const ROUTE_SESSION_POST : u8 = 1;
pub const ROUTE_SESSION_DELETE : u8 = 2;
pub const ROUTE_PROFILE_DELETE : u8 = 3;
pub const ROUTE_TYPE_POST : u8 = 4;
pub const ROUTE_COOKIES_POST : u8 = 5;
pub const ROUTE_PERM_ASK : u8 = 6;
pub const ROUTE_PERM_DECIDE : u8 = 7;
pub const ROUTE_PERM_CHOOSE : u8 = 8;
pub const ROUTE_JOURNAL_GET : u8 = 9;
pub const ROUTE_DESKS_GET : u8 = 10;
pub const ROUTE_TABS_GET : u8 = 11;
pub const ROUTE_LOGINS_GET : u8 = 12;
pub const ROUTE_SITES_GET : u8 = 13;
pub const ROUTE_NONE : u8 = 0;

pub const ROUTES : [13]string = [
    "POST /api/browser/session",
    "DELETE /api/browser/session",
    "DELETE /api/browser/profile",
    "POST /api/browser/type",
    "POST /api/browser/cookies",
    "POST /api/browser/permission/ask",
    "POST /api/browser/permission/decide",
    "POST /api/browser/permission/choose",
    "GET /api/browser/journal",
    "GET /api/browser/desks",
    "GET /api/browser/tabs",
    "GET /api/browser/logins",
    "GET /api/browser/sites",
];

pub const BROWSER_PREFIX : string = "/api/browser/";

; Actors
pub const ACT_PERSON : u8 = 0;
pub const ACT_AGENT : u8 = 1;

; Refusal codes
pub const R_OK : u32 = 0;
pub const R_NO_DOOR : u32 = 404;
pub const R_AGENT_KEY : u32 = 403;
pub const R_MANAGER_DENY : u32 = 401;
pub const R_PLACE_NEEDS_PERMISSION : u32 = 412;
pub const R_PLACE_WINDOW_STALE : u32 = 410;
pub const R_PLACE_UNREADABLE : u32 = 422;
pub const R_SCHEME_REFUSED : u32 = 415;

pub const ENV_BROWSER_MANAGER_IDS : string = "BROWSER_MANAGER_IDS";

; --- 2. String helpers ---------------------------------------------------------------------

pub fn starts_with(s : string, pre : string) -> bool {
    if (s.len < pre.len) { return false; }
    var ii : u32 = 0;
    while (ii < (pre.len as u32)) {
        if ((s[ii] as u32) != (pre[ii] as u32)) { return false; }
        ii = ii + 1;
    }
    return true;
}

/// Byte-wise equality of two strings, used where == is not enough.
pub fn bytes_same(a : string, b : string) -> bool {
    if (a.len != b.len) { return false; }
    var ii : u32 = 0;
    while (ii < (a.len as u32)) {
        if ((a[ii] as u32) != (b[ii] as u32)) { return false; }
        ii = ii + 1;
    }
    return true;
}

; --- 3. door_of: the single resolver ---------------------------------------------------------

pub fn door_of(method : string, path : string) -> u8 {
    var ii : u8 = 1;
    while (ii <= 13) {
        var ro : string = ROUTES[ii - 1];
        var sp : u32 = 0;
        while (sp < (ro.len as u32)) {
            if ((ro[sp] as u32) == 32) { break; }
            sp = sp + 1;
        }
        var pn : u32 = ro.len as u32;
        var meth : bool = (sp == (method.len as u32));
        if (meth) {
            var jj : u32 = 0;
            while (jj < sp) {
                if ((ro[jj] as u32) != (method[jj] as u32)) { meth = false; }
                jj = jj + 1;
            }
        }
        var pth : bool = (pn - sp - 1) == (path.len as u32);
        if (pth) {
            pth = bytes_same(ro[sp + 1..pn], path);
        }
        if (meth and pth) { return ii; }
        ii = ii + 1;
    }
    return ROUTE_NONE;
}

; --- 4. Actor law: person-only doors -----------------------------------------------------------

/// The TYPE and COOKIES doors carry keys and accept no agent key: an AGENT
/// actor there is a 403. Everything else accepts both actors.
pub fn door_refusal(door : u8, actor : u8) -> u32 {
    if (door == ROUTE_NONE) { return R_NO_DOOR; }
    if (actor == ACT_AGENT) {
        if (door == ROUTE_TYPE_POST) { return R_AGENT_KEY; }
        if (door == ROUTE_COOKIES_POST) { return R_AGENT_KEY; }
    }
    return R_OK;
}

; --- 5. Manager gate -----------------------------------------------------------------------------

/// BROWSER_MANAGER_IDS empty means deny-all. A caller is allowed only when
/// the list is non-empty and the caller id appears in it. The refusal is
/// always R_MANAGER_DENY carrying the caller id through the caller.
pub fn manager_gate(manager_ids_set : bool, caller_in_list : bool) -> u32 {
    if (!manager_ids_set) { return R_MANAGER_DENY; }
    if (!caller_in_list) { return R_MANAGER_DENY; }
    return R_OK;
}

/// Deny-all sanity: with the gate empty even the caller itself is refused.
pub fn manager_deny_all(caller_id : string) -> bool {
    if (caller_id.len == 0) { return true; }
    return manager_gate(false, true) == R_MANAGER_DENY;
}

; --- 6. Place guard --------------------------------------------------------------------------------

pub const PLACE_FREE : u8 = 0;
pub const PLACE_BANK : u8 = 1;
pub const PLACE_MAIL : u8 = 2;
pub const PLACE_PAY : u8 = 3;
pub const PLACE_CODE : u8 = 4;

pub const PERMISSION_WINDOW_SECS : u64 = 300;

/// A sensitive place needs a human permission within the window: granted
/// secs ago must be strictly under PERMISSION_WINDOW_SECS. No permission
/// yet (granted_secs = u64 max sentinel 0) is NEEDS-PERMISSION.
pub fn place_refusal(place : u8, human_granted : bool, granted_secs_ago : u64) -> u32 {
    if (place == PLACE_FREE) { return R_OK; }
    if (!human_granted) { return R_PLACE_NEEDS_PERMISSION; }
    if (granted_secs_ago >= PERMISSION_WINDOW_SECS) { return R_PLACE_WINDOW_STALE; }
    return R_OK;
}

/// An address the broker cannot parse is treated as sensitive, never as free.
pub fn address_readable(address_ok : bool) -> u8 {
    if (address_ok) { return PLACE_FREE; }
    return PLACE_BANK;
}

/// agentMayOpen: an agent never opens the browser's own privileged schemes.
pub fn agent_may_open(url : string) -> bool {
    if (starts_with(url, "chrome://")) { return false; }
    if (starts_with(url, "chrome-extension://")) { return false; }
    if (starts_with(url, "devtools://")) { return false; }
    return true;
}

pub fn scheme_refusal(url : string) -> u32 {
    if (!agent_may_open(url)) { return R_SCHEME_REFUSED; }
    return R_OK;
}

; --- 7. The view URL is a path ------------------------------------------------------------------------

/// The view URL of session id + token: /live/<id>?t=<token>. A PATH: the
/// law is that it starts with "/live/", carries no scheme marker "://", and
/// has no host part (nothing between scheme and path, because no scheme).
pub fn view_url_ok(url : string, id : string, token : string) -> bool {
    if (!starts_with(url, "/live/")) { return false; }
    var ii : u32 = 0;
    while (ii < (url.len as u32)) {
        var colon : bool = (url[ii] as u32) == 58;
        if (colon and ii > 0 and (url[ii - 1] as u32) == 58) { return false; }
        ii = ii + 1;
    }
    var want : u32 = (6 + id.len + 3 + token.len) as u32;
    if ((url.len as u32) != want) { return false; }
    if (!bytes_same(url[6..6 + id.len as u32], id)) { return false; }
    var tpos : u32 = 6 + id.len as u32;
    if ((url[tpos] as u32) != 63) { return false; }
    if ((url[tpos + 1] as u32) != 116) { return false; }
    if ((url[tpos + 2] as u32) != 61) { return false; }
    return bytes_same(url[tpos + 3..url.len as u32], token);
}

/// A scheme detector for the view law: true when the string contains "://".
pub fn has_scheme(url : string) -> bool {
    var ii : u32 = 0;
    while (ii + 2 < (url.len as u32)) {
        if ((url[ii] as u32) == 58 and (url[ii + 1] as u32) == 47 and (url[ii + 2] as u32) == 47) { return true; }
        ii = ii + 1;
    }
    return false;
}

invariant every_route_resolves {
    assert door_of("POST", "/api/browser/session") == ROUTE_SESSION_POST;
    assert door_of("DELETE", "/api/browser/session") == ROUTE_SESSION_DELETE;
    assert door_of("DELETE", "/api/browser/profile") == ROUTE_PROFILE_DELETE;
    assert door_of("POST", "/api/browser/type") == ROUTE_TYPE_POST;
    assert door_of("POST", "/api/browser/cookies") == ROUTE_COOKIES_POST;
    assert door_of("POST", "/api/browser/permission/ask") == ROUTE_PERM_ASK;
    assert door_of("GET", "/api/browser/journal") == ROUTE_JOURNAL_GET;
    assert door_of("GET", "/api/browser/tabs") == ROUTE_TABS_GET;
    assert door_of("GET", "/api/browser/sites") == ROUTE_SITES_GET;
    assert door_of("PUT", "/api/browser/session") == ROUTE_NONE;
    assert door_of("POST", "/api/browser/nope") == ROUTE_NONE;
}

invariant type_and_cookies_are_person_only {
    assert door_refusal(ROUTE_TYPE_POST, ACT_AGENT) == R_AGENT_KEY;
    assert door_refusal(ROUTE_COOKIES_POST, ACT_AGENT) == R_AGENT_KEY;
    assert door_refusal(ROUTE_TYPE_POST, ACT_PERSON) == R_OK;
    assert door_refusal(ROUTE_COOKIES_POST, ACT_PERSON) == R_OK;
    assert door_refusal(ROUTE_SESSION_POST, ACT_AGENT) == R_OK;
    assert door_refusal(ROUTE_NONE, ACT_PERSON) == R_NO_DOOR;
}

invariant empty_gate_denies_all {
    assert manager_gate(false, false) == R_MANAGER_DENY;
    assert manager_gate(false, true) == R_MANAGER_DENY;
    assert manager_gate(true, true) == R_OK;
    assert manager_gate(true, false) == R_MANAGER_DENY;
    assert manager_deny_all("tg-agent-7");
}

invariant privileged_schemes_refused {
    assert(!agent_may_open("chrome://settings"));
    assert(!agent_may_open("chrome-extension://abc/popup.html"));
    assert(!agent_may_open("devtools://devtools/bundled/inspector.html"));
    assert(agent_may_open("https://example.com"));
    assert(agent_may_open("/api/browser/tabs"));
}

test unknown_door_and_agent_key_refusals {
    assert(door_of("GET", "/api/browser/desks") == ROUTE_DESKS_GET);
    assert(door_of("GET", "/api/browser/logins") == ROUTE_LOGINS_GET);
    assert(door_of("POST", "/api/browser/permission/decide") == ROUTE_PERM_DECIDE);
    assert(door_of("POST", "/api/browser/permission/choose") == ROUTE_PERM_CHOOSE);
    assert(door_refusal(ROUTE_DESKS_GET, ACT_AGENT) == R_OK);
    assert(door_refusal(ROUTE_LOGINS_GET, ACT_AGENT) == R_OK);
    assert(door_refusal(door_of("PATCH", "/api/browser/type"), ACT_PERSON) == R_NO_DOOR);
}

test place_guard_enforces_the_window {
    assert(place_refusal(PLACE_FREE, false, 0) == R_OK);
    assert(place_refusal(PLACE_BANK, false, 0) == R_PLACE_NEEDS_PERMISSION);
    assert(place_refusal(PLACE_MAIL, true, 10) == R_OK);
    assert(place_refusal(PLACE_PAY, true, PERMISSION_WINDOW_SECS) == R_PLACE_WINDOW_STALE);
    assert(place_refusal(PLACE_CODE, true, PERMISSION_WINDOW_SECS + 1) == R_PLACE_WINDOW_STALE);
    assert(address_readable(true) == PLACE_FREE);
    assert(address_readable(false) == PLACE_BANK);
    assert(place_refusal(address_readable(false), false, 0) == R_PLACE_NEEDS_PERMISSION);
}

test view_url_is_a_path_never_a_full_url {
    assert(view_url_ok("/live/s3?t=abc", "s3", "abc"));
    assert(!view_url_ok("/live/s3?t=xyz", "s3", "abc"));
    assert(!view_url_ok("/live/other?t=abc", "s3", "abc"));
    assert(!has_scheme("/live/s3?t=abc"));
    assert(has_scheme("https://app.t27.ai/live/s3"));
    assert(has_scheme("http://127.0.0.1:9223/live/s3"));
    assert(scheme_refusal("chrome://version") == R_SCHEME_REFUSED);
    assert(scheme_refusal("https://example.com") == R_OK);
}
