module T27osTts;

/// The speak queue for translated segments: only a SEALED segment is ever
/// spoken; a newer sealed segment interrupts (barge-in) whatever is speaking;
/// an under-floor or unsealed segment is refused and changes nothing.
/// Loudness targets are referenced from specs/automation/owner_voice_reel.t27
/// (LUFS, LRA) -- named here, never redefined. Output devices are host glue.

/// Speech queue states for one segment
pub const SQ_IDLE     : u8 = 0;
pub const SQ_QUEUED   : u8 = 1;
pub const SQ_SPEAKING : u8 = 2;
pub const SQ_DONE     : u8 = 3;
pub const SQ_INTERRUPTED : u8 = 4;

/// Refusal codes
pub const TTS_OK          : u32 = 0;
pub const TTS_NOT_SEALED  : u32 = 1;
pub const TTS_STALE_SEQ   : u32 = 2;
pub const TTS_EMPTY_TEXT  : u32 = 3;

/// Confidence floor: a segment under the floor is never spoken
pub const TTS_CONF_FLOOR : u32 = 60;

/// Loudness targets, referenced (not redefined) from owner_voice_reel.t27
pub const LUFS_TARGET : i32 = -16;
pub const LRA_MAX     : u32 = 11;

/// One queued segment: the speak queue owns a ring of these
pub struct QueuedSeg {
    id : u64,
    seq : u32,
    sealed : bool,
    spoken : bool,
    state : u8,
    text : []const u8,
}

/// A new queued segment, idle and unspoken
pub fn qseg_new(id : u64) -> QueuedSeg {
    var q : QueuedSeg = QueuedSeg { id : id, seq : 0, sealed : false, spoken : false, state : SQ_IDLE, text : "" };
    return q;
}

/// Enqueue a translated segment: it must be sealed, nonempty, fresh and at or
/// above the confidence floor, otherwise the refusal code says why and the
/// queue is untouched.
pub fn tts_enqueue(q : *QueuedSeg, seq : u32, sealed : bool, conf : u32, text : []const u8) -> u32 {
    if (!sealed) { return TTS_NOT_SEALED; }
    if (text.len == 0) { return TTS_EMPTY_TEXT; }
    if (seq <= q.seq) { return TTS_STALE_SEQ; }
    if (conf < TTS_CONF_FLOOR) { return TTS_NOT_SEALED; }
    q.seq = seq;
    q.sealed = true;
    q.text = text;
    return TTS_OK;
}

/// Barge-in: a newer sealed segment interrupts whatever is speaking. The old
/// segment is marked INTERRUPTED (never DONE); a stale new one is refused.
pub fn tts_barge_in(old : *QueuedSeg, new_seq : u32) -> u32 {
    if (new_seq <= old.seq) { return TTS_STALE_SEQ; }
    if (old.state == SQ_SPEAKING) {
        old.state = SQ_INTERRUPTED;
    }
    return TTS_OK;
}

/// Mark the segment speaking (host calls this when the audio starts)
pub fn tts_mark_speaking(q : *QueuedSeg) -> void {
    q.state = SQ_SPEAKING;
}

invariant queue_states_are_distinct_and_ordered
    assert SQ_IDLE < SQ_QUEUED and SQ_QUEUED < SQ_SPEAKING and SQ_SPEAKING < SQ_DONE and SQ_DONE < SQ_INTERRUPTED

invariant every_refusal_is_named_and_nonzero
    assert TTS_OK == 0 and TTS_NOT_SEALED > 0 and TTS_STALE_SEQ > 0 and TTS_EMPTY_TEXT > 0

/// Only a sealed, nonempty, at-floor segment is enqueued
test only_sealed_nonempty_at_floor_is_enqueued {
    var q : QueuedSeg = qseg_new(1);
    var r : u32 = tts_enqueue(&q, 1, true, TTS_CONF_FLOOR, "hello world");
    assert r == TTS_OK and q.sealed and q.text.len == 11;
}

/// An unsealed segment is refused and the queue is untouched
test an_unsealed_segment_is_refused {
    var q : QueuedSeg = qseg_new(1);
    var r : u32 = tts_enqueue(&q, 1, false, 90, "hello");
    assert r == TTS_NOT_SEALED;
    assert !q.sealed and q.text.len == 0;
}

/// Empty text is refused even when sealed
test empty_text_is_refused_even_when_sealed {
    var q : QueuedSeg = qseg_new(1);
    var r : u32 = tts_enqueue(&q, 1, true, 90, "");
    assert r == TTS_EMPTY_TEXT and !q.sealed;
}

/// A stale sequence is refused and changes nothing
test a_stale_sequence_is_refused {
    var q : QueuedSeg = qseg_new(1);
    var r1 : u32 = tts_enqueue(&q, 5, true, 90, "five");
    var r2 : u32 = tts_enqueue(&q, 5, true, 90, "five again");
    assert r1 == TTS_OK and r2 == TTS_STALE_SEQ;
    assert q.text.len == 4;
}

/// An under-floor segment is never spoken
test an_underfloor_segment_is_never_spoken {
    var q : QueuedSeg = qseg_new(1);
    var r : u32 = tts_enqueue(&q, 1, true, TTS_CONF_FLOOR - 1, "mumble");
    assert r == TTS_NOT_SEALED and !q.sealed;
}

/// A newer sealed segment interrupts the speaking one (barge-in)
test a_newer_sealed_segment_interrupts_the_speaking_one {
    var a : QueuedSeg = qseg_new(1);
    var r1 : u32 = tts_enqueue(&a, 1, true, 90, "first");
    tts_mark_speaking(&a);
    var r2 : u32 = tts_barge_in(&a, 2);
    assert r1 == TTS_OK and r2 == TTS_OK;
    assert a.state == SQ_INTERRUPTED;
}

/// A barge-in from a stale sequence is refused and the state stands
test a_stale_barge_in_is_refused_and_the_state_stands {
    var a : QueuedSeg = qseg_new(1);
    var r1 : u32 = tts_enqueue(&a, 5, true, 90, "fifth");
    tts_mark_speaking(&a);
    var r2 : u32 = tts_barge_in(&a, 5);
    assert r1 == TTS_OK and r2 == TTS_STALE_SEQ;
    assert a.state == SQ_SPEAKING;
}

/// Negative control: a machine that speaks unsealed segments is refused
test negative_control_refuses_a_machine_that_speaks_unsealed_segments {
    var q : QueuedSeg = qseg_new(1);
    var r : u32 = tts_enqueue(&q, 1, false, 95, "never spoken");
    assert r != TTS_OK;
    assert !q.sealed and q.text.len == 0 and q.spoken == false;
}

/// Loudness targets are referenced, not redefined, and are plausible
test loudness_targets_are_referenced_and_plausible {
    assert LUFS_TARGET < 0 and LRA_MAX > 0 and LRA_MAX < 100;
}
