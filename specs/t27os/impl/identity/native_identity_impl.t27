; T27OS-NATIVE-IDENTITY-IMPL
; Logic implementation for the 0x-convention identity resolver.

module native_identity_impl {
  import identity_system;
  import state_graph;

  // State storage
  var identity_registry = Map<string, Identity>();
  var name_to_id = Map<string, string>();

  task claim_name(id: string, name: string) -> bool {
    // 1. Validation: Law of 0x
    if (!name.starts_with("0x")) {
      return false;
    }

    // 2. Uniqueness Check
    if (name_to_id.contains(name)) {
      return false;
    }

    // 3. Registration
    identity_registry[id] = { 
      actor_id: id, 
      native_name: name, 
      verified: true 
    };
    name_to_id[name] = id;

    return true;
  }

  task resolve_name(name: string) -> string {
    return name_to_id[name];
  }

  task resolve_id(id: string) -> string {
    const identity = identity_registry[id];
    return identity != null ? identity.native_name : "0xUnknown";
  }

  // Integration with state_graph
  function get_actor_display_name(id: string) -> string {
    const native = resolve_id(id);
    if (native != "0xUnknown") {
      return native;
    }
    // Fallback to basic ID or name from identity_table
    return "Actor:" + id;
  }
}
