// SPDX-License-Identifier: Apache-2.0
; Closes #11275
module ResearchCard;

use std::mem::bytes_eq;
// The research-graph card for the T27 OS window (glass_window): the heat bench
// (specs/physics/heat_bench.t27) shown as one home-screen card, the same pattern
// as the FPGA bench cards in specs/t27os/bench.t27.
// Node kinds of the research graph (frontend.t27 SF_RESEARCH_GRAPH comment):
// law, parameters, conditions, observable, reference, verdict -- one line each.
//
// VALUES ARE DATA, RULES ARE CODE (the bench.t27 law). The card carries its
// readings as MEASURED constants, each naming the heat_bench source that
// produced it, and keeps the stability gate and the verdict rule executable
// over them: a data reload moves the values, never the rule (slice 2,
// single-instance program). The card once called heat_bench through `use`
// imports; the zig test backend elides every bare cross-module import ("no
// references in this module" -> "use of undeclared identifier"), so the card
// did not compile at all. That is a compiler defect (self-host #5980); until
// it closes, the readings live here with their provenance.
//
// All readings were measured 2026-11-08 from heat_bench's own constants and
// formulas (k=400 W/m/K copper, rho=8960, cp=385, L=1 m, 10 cells, dt=40 s,
// 2000 FTCS steps) run under t27c test; the probe stand asserted each raw
// reading before it was truncated toward zero into the constant below.
// phi^2 + 1/phi^2 = 3 | TRINITY

pub const CARD_KIND_LAW : u8 = 0;
pub const CARD_KIND_PARAMS : u8 = 1;
pub const CARD_KIND_COND : u8 = 2;
pub const CARD_KIND_OBSERVABLE : u8 = 3;
pub const CARD_KIND_REFERENCE : u8 = 4;
pub const CARD_KIND_VERDICT : u8 = 5;
pub const CARD_KIND_COUNT : u8 = 6;

/// MEASURED 2026-11-08: heat_bench.stability_ratio(DT_S) x1000 = 463.82...,
/// truncated toward zero. FTCS stability ratio r = alpha*dt/dx^2 at dt = 40 s.
pub const STABILITY_X1000 : u32 = 463;

/// MEASURED 2026-11-08 (same stand): heat_bench.stability_ratio(DT_UNSTABLE_S)
/// x1000 = 579.78..., truncated. The unstable control reading (dt = 50 s) that
/// the gate must refuse, so the gate cannot be decorative.
pub const STABILITY_X1000_UNSTABLE : u32 = 579;

/// MEASURED 2026-11-08: heat_bench.t_mid_ftcs_k(N_STEPS) - 300 K in
/// milli-kelvin = 49999.99999..., truncated. The FTCS run reaches the closed
/// form, so the observable sits 1 mK under the reference reading.
pub const OBS_MK : u32 = 49999;

/// DERIVED from heat_bench's closed form: t_mid_reference_k() is the 350 K
/// steady midpoint, so 350 K - 300 K in milli-kelvin.
pub const REF_MK : u32 = 50000;

/// heat_bench.t27's VERDICT_VERIFIED byte, carried with its source named
/// because the zig test backend elides the import (compiler defect, #5980).
pub const VERDICT_VERIFIED : u8 = 0;

/// L3. The card line for one research-graph node kind. Fixed strings stay ASCII.
pub fn card_line(kind: u8) -> string {
    if (kind == CARD_KIND_LAW) { return "law: Fourier 400 W/m/K (Cu)"; }
    if (kind == CARD_KIND_PARAMS) { return "params: 10 cells, dt=40s"; }
    if (kind == CARD_KIND_COND) { return "cond: 400K hot, 300K cold"; }
    if (kind == CARD_KIND_OBSERVABLE) { return "obs: FTCS mid temp"; }
    if (kind == CARD_KIND_REFERENCE) { return "ref: linear steady profile"; }
    return "verdict: VERIFIED";
}

/// The card title, the same role as bench.t27 card_title.
pub fn card_heading() -> string {
    return "heat bench: Fourier rod";
}

/// The stability gate RULE: FTCS is stable for r <= 0.5 (heat_bench L4). The
/// reading is the ratio x1000 truncated toward zero, so the gate holds while
/// the reading is at most 500; a reading inside the truncation band right at
/// the boundary cannot decide (both live readings, 463 and 579, sit far away).
pub fn stable_gate(x1000 : u32) -> bool {
    return x1000 <= 500;
}

/// Does the measured step keep the FTCS run stable at the benchmark dt.
pub fn card_stable() -> bool {
    return stable_gate(STABILITY_X1000);
}

/// Stability reading at the benchmark dt: at most 500 stays stable (heat_bench L4).
pub fn card_stability_x1000() -> u32 {
    return STABILITY_X1000;
}

/// The FTCS observable after the full run, in milli-kelvin above 300K base,
/// so the card carries a number instead of a bare claim.
pub fn card_obs_mK() -> u32 {
    return OBS_MK;
}

/// The reference observable in the same milli-kelvin units.
pub fn card_ref_mK() -> u32 {
    return REF_MK;
}

/// The verdict byte the card shows: VERDICT_VERIFIED when the observable
/// matches the reference and the run is stable, else 255 (mismatch).
pub fn card_verdict() -> u8 {
    if (!card_stable()) { return 255; }
    return verdict_of(card_obs_mK(), card_ref_mK());
}

/// The verdict RULE, separated from the built-in values so the live reload can
/// hand the card new measured numbers while the rule stays executable: data
/// reloads move the values, never the rule (slice 2, single-instance program).
pub fn verdict_of(obs_mk : u32, ref_mk : u32) -> u8 {
    const d : u32 = if (obs_mk > ref_mk) { obs_mk - ref_mk } else { ref_mk - obs_mk };
    if (d > 5) { return 255; }
    return VERDICT_VERIFIED;
}

/// The unstable control proves the stability gate is live, not decorative:
/// the gate must refuse the measured 50 s reading (579) and hold the 40 s one.
test unstable_control_fails {
    assert stable_gate(STABILITY_X1000_UNSTABLE) == false;
    assert stable_gate(STABILITY_X1000) == true;
    assert card_stable() == true;
}

test card_lines_are_six {
    var k : u8 = 0;
    while (k < CARD_KIND_COUNT) {
        assert(card_line(k).len > 0);
        k = k + 1;
    }
}

test card_values_measured {
    assert_eq(card_stable(), true);
    assert(card_stability_x1000() > 0);
    assert(card_stability_x1000() < 500);
    assert(card_obs_mK() > 0);
    assert(card_ref_mK() > 0);
    assert_eq(card_verdict(), VERDICT_VERIFIED);
}

test card_title_fixed {
    assert(bytes_eq(card_heading(), "heat bench: Fourier rod"));
    assert(bytes_eq(card_line(CARD_KIND_LAW), "law: Fourier 400 W/m/K (Cu)"));
}


test the_verdict_rule_moves_with_the_values_not_with_the_build {
    assert_eq(verdict_of(43100, 43100), VERDICT_VERIFIED);
    assert_eq(verdict_of(43100, 43103), VERDICT_VERIFIED);
    assert_eq(verdict_of(43103, 43100), VERDICT_VERIFIED);
    assert_eq(verdict_of(43100, 43106), 255);
    assert_eq(verdict_of(43106, 43100), 255);
}
