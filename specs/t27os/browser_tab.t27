// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_tab.t27 -- TAB B MOUNT: where the AI browser lives in
; the T27 OS shell. The shell (t27os_shell.t27) binds letter 2 to the domain
; tab titled T27B; owner directive 2026-11-16: the AI browser's home is that
; second domain tab. This file is the mount contract: it names the seven
; layer modules of the rewritten stack and holds the tab binding to the
; shell's own law.
; -
; THE SEVEN LAYERS. One module per layer, in vertical order:
;   1 pod       specs/t27os/browser_pod.t27
;   2 driver    specs/t27os/browser_driver.t27
;   3 broker    specs/t27os/browser_broker.t27
;   4 proxy     specs/t27os/browser_proxy.t27
;   5 ui        specs/t27os/browser_ui.t27
;   6 tools     specs/t27os/browser_tools.t27
;   7 observe   specs/t27os/browser_observe.t27
; The mount is complete only when all seven names are present, in order,
; exactly once each.
; -
; THE NATIVE BRIDGE. Development line 0.3.2 (browser_native_bridge.t27) is a
; sibling of this mount, not an eighth layer and not a second desk. The seven
; names below stay the embedded page. The bridge is the loopback door onto
; the native window. Desktop release stays 0.3.1.
; -
; THE BINDING. The browser desk mounts on domain tab letter 2 only. The
; shell's own sh_domain_tab_ok refuses any other letter/spelling for it, so
; this file states the letter and the title and defers the rest to the shell.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserTab;

; --- 1. The tab -------------------------------------------------------------------------

pub const TAB_LETTER : u32 = 2;
pub const TAB_TITLE : string = "T27B";

; --- 2. The seven layers ----------------------------------------------------------------

pub const LAYER_POD : string = "T27OsBrowserPod";
pub const LAYER_DRIVER : string = "T27OsBrowserDriver";
pub const LAYER_BROKER : string = "T27OsBrowserBroker";
pub const LAYER_PROXY : string = "T27OsBrowserProxy";
pub const LAYER_UI : string = "T27OsBrowserUi";
pub const LAYER_TOOLS : string = "T27OsBrowserTools";
pub const LAYER_OBSERVE : string = "T27OsBrowserObserve";

pub const LAYERS : [7]string = [
    LAYER_POD, LAYER_DRIVER, LAYER_BROKER, LAYER_PROXY, LAYER_UI, LAYER_TOOLS, LAYER_OBSERVE,
];

pub const LAYER_COUNT : usize = 7;

/// The mount is complete when every layer name is non-empty and unique.
pub fn mount_ok() -> bool {
    var i : usize = 0;
    while (i < LAYER_COUNT) {
        if (LAYERS[i].len == 0) { return false; }
        var j : usize = i + 1;
        while (j < LAYER_COUNT) {
            if (LAYERS[i] == LAYERS[j]) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

/// The browser mounts on the second domain tab and no other.
pub fn tab_ok(letter : u32, title : string) -> bool {
    if (letter != TAB_LETTER) { return false; }
    if (title != TAB_TITLE) { return false; }
    return mount_ok();
}

/// The vertical order of the stack: pod feeds driver feeds broker feeds
/// proxy feeds ui feeds tools feeds observe; a later layer never serves an
/// earlier one.
pub fn layer_serves(lower : usize, upper : usize) -> bool {
    if (lower >= LAYER_COUNT or upper >= LAYER_COUNT) { return false; }
    return lower < upper;
}

; --- 2b. Native bridge sibling (development line 0.3.2) ---------------------------------

/// Module name of the loopback native bridge. Not one of LAYERS.
pub const BRIDGE_MODULE : string = "T27OsBrowserNativeBridge";

/// True only if a layer row has been renamed to the bridge. The mount forbids that.
pub fn bridge_in_layers() -> bool {
    var i : usize = 0;
    while (i < LAYER_COUNT) {
        if (LAYERS[i] == BRIDGE_MODULE) { return true; }
        i = i + 1;
    }
    return false;
}

; --- 3. Tests ---------------------------------------------------------------------------

test mount_lists_all_seven_layers_exactly_once {
    assert mount_ok();
    assert LAYERS[0] == "T27OsBrowserPod";
    assert LAYERS[6] == "T27OsBrowserObserve";
    var i : usize = 0;
    var seen_pod : u32 = 0;
    while (i < LAYER_COUNT) {
        if (LAYERS[i] == LAYER_POD) { seen_pod = seen_pod + 1; }
        i = i + 1;
    }
    assert seen_pod == 1;
}

test browser_mounts_on_tab_b_and_nowhere_else {
    assert tab_ok(2, "T27B");
    assert !tab_ok(1, "T27A");
    assert !tab_ok(2, "T27A");
    assert !tab_ok(3, "T27C");
    assert !tab_ok(0, "T27B");
}

test vertical_order_runs_pod_to_observe {
    assert layer_serves(0, 6);
    assert layer_serves(2, 3);
    assert !layer_serves(6, 0);
    assert !layer_serves(3, 3);
    assert !layer_serves(7, 0);
}

test native_bridge_is_sibling_not_eighth_layer {
    assert BRIDGE_MODULE == "T27OsBrowserNativeBridge";
    assert !bridge_in_layers();
    assert LAYER_COUNT == 7;
    assert LAYERS[0] == "T27OsBrowserPod";
    assert LAYERS[6] == "T27OsBrowserObserve";
}
