// specs/t27os/pty_home_probe.t27 -- drives pty_home_host.ph_ensure on a real folder, the checks t27b test cannot run
// (it does not run an @extern). Not part of the app. PHP_ROOT names an empty scratch folder (absolute, not under
// /tmp: ph_src_fit refuses a source there); the probe makes a fake bundle R/a/T27OS.app/Contents/MacOS/t27os-pty,
// a server beside it R/a/t27os-pty and a HOME R/h, and checks, one line each (exit 0 only when every check passed):
// a missing ~/.t27os/t27os-pty appears 0700 with the bundle's bytes; a second start keeps it; a 0755 copy is set
// to 0700; an older copy is replaced; a link in its place is refused and its target untouched; a stale .new link
// is not written through; ~/.t27os as a link is refused; a bundle with no server inside takes the one beside it;
// an executable under /tmp copies nothing.
// Build (Apple silicon): t27b build specs/t27os/pty_home_probe.t27 -o <o> --macho; ld -arch arm64 -platform_version
// macos 14.0 <sdk> -syslibroot <sdk> -e _main -lSystem -framework CoreFoundation -o <bin> <o>.
module T27osPtyHomeProbe;

use t27os::pty_sys::sys_exit;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_unlink;
use t27os::pty_sys::sys_mkdir;
use t27os::pty_sys::sys_chmod;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_home::PH_WFLAGS;
use t27os::pty_home::PH_K_NONE;
use t27os::pty_home::PH_K_FILE;
use t27os::pty_home::PH_K_LINK;
use t27os::pty_home::PH_SRC_INSIDE;
use t27os::pty_home::PH_SRC_BESIDE;
use t27os::pty_home::PR_KEPT;
use t27os::pty_home::PR_COPIED;
use t27os::pty_home::PR_CHMOD;
use t27os::pty_home::PR_NO_SOURCE;
use t27os::pty_home::PR_LINK;
use t27os::pty_home::PR_NO_DIR;
use t27os::pty_home::ph_join;
use t27os::pty_home::ph_src_fit;
use t27os::pty_home_host::phh_look;
use t27os::pty_home_host::phh_same;
use t27os::pty_home_host::phh_open;
use t27os::pty_home_host::phh_fchmod;
use t27os::pty_home_host::ph_ensure;
use t27os::pty_home_host::ph_ensure_line;

fn php_symlink(target: []const u8, path: []const u8) -> i32 { return @extern("symlink"); }
fn php_rmdir(path: []const u8) -> i32 { return @extern("rmdir"); }

fn php_out(s: []const u8) -> void { sys_write(1, s, @as(u64, s.len)); }

/// One check line: "PASS name" or "FAIL name".
fn php_check(name: []const u8, ok: bool) -> bool {
    if (ok) { php_out("PASS "); } else { php_out("FAIL "); }
    php_out(name);
    php_out("\n");
    return ok;
}

fn php_put(path: []const u8, b: []const u8, mode: u32) -> void {
    sys_unlink(path);
    const fd : i32 = phh_open(path, PH_WFLAGS, mode);
    if (fd < 0) { return; }
    phh_fchmod(fd, mode);
    sys_write(fd, b, @as(u64, b.len));
    sys_close(fd);
}

/// root + suffix, NUL-terminated, into one of the probe's path buffers.
fn php_p(root: []const u8, rn: usize, suffix: []const u8, out: []u8) -> []u8 {
    const n : usize = ph_join(root, rn, suffix, out);
    return out[0..n + 1];
}

fn php_ensure(exe: []const u8, home: []const u8, info: []u64) -> u32 {
    const r : u32 = ph_ensure(exe, home, info);
    var line : [200]u8 = undefined;
    const n : usize = ph_ensure_line(line[0..200], r, info);
    php_out("  log: ");
    sys_write(1, line[0..n], @as(u64, n));
    php_out("\n");
    return r;
}

fn php_run(root: []const u8, rn: usize) -> bool {
    var b1 : [512]u8 = undefined;
    var b2 : [512]u8 = undefined;
    var b3 : [512]u8 = undefined;
    var b4 : [512]u8 = undefined;
    var b5 : [512]u8 = undefined;
    var b6 : [512]u8 = undefined;
    var b7 : [512]u8 = undefined;
    var b8 : [512]u8 = undefined;
    var b9 : [512]u8 = undefined;
    sys_mkdir(php_p(root, rn, "/a", b1[0..512]), 448);
    sys_mkdir(php_p(root, rn, "/a/T27OS.app", b1[0..512]), 448);
    sys_mkdir(php_p(root, rn, "/a/T27OS.app/Contents", b1[0..512]), 448);
    sys_mkdir(php_p(root, rn, "/a/T27OS.app/Contents/MacOS", b1[0..512]), 448);
    sys_mkdir(php_p(root, rn, "/h", b1[0..512]), 448);
    const inside : []u8 = php_p(root, rn, "/a/T27OS.app/Contents/MacOS/t27os-pty", b2[0..512]);
    const beside : []u8 = php_p(root, rn, "/a/t27os-pty", b3[0..512]);
    const dst : []u8 = php_p(root, rn, "/h/.t27os/t27os-pty", b4[0..512]);
    const victim : []u8 = php_p(root, rn, "/victim", b5[0..512]);
    const tmp : []u8 = php_p(root, rn, "/h/.t27os/t27os-pty.new", b6[0..512]);
    const dir : []u8 = php_p(root, rn, "/h/.t27os", b7[0..512]);
    const n8 : usize = ph_join(root, rn, "/a/T27OS.app/Contents/MacOS/T27OS", b8[0..512]);
    const exe : []u8 = b8[0..n8];
    const n9 : usize = ph_join(root, rn, "/h", b9[0..512]);
    const home : []u8 = b9[0..n9];
    php_put(inside, "SERVER-7123", 493);
    php_put(beside, "SERVER-7119", 493);
    php_put(victim, "VICTIM", 384);
    sys_unlink(dst);
    sys_unlink(tmp);
    var info : [3]u64 = undefined;
    var st : [2]u64 = undefined;
    var ok : bool = true;
    // 1. missing: copied from inside the bundle, 0700, the same bytes
    var r : u32 = php_ensure(exe, home, info[0..3]);
    ok = php_check("missing_server_is_copied_from_inside", r == PR_COPIED and info[0] == PH_SRC_INSIDE and info[1] == 11) and ok;
    const k1 : u32 = phh_look(dst, st[0..2]);
    ok = php_check("the_copy_is_a_plain_file_0700", k1 == PH_K_FILE and (st[1] & 4095) == 448 and st[0] == 11) and ok;
    ok = php_check("the_copy_has_the_bundle_bytes", phh_same(inside, dst)) and ok;
    ok = php_check("home_t27os_is_0700", phh_look(dir, st[0..2]) == 3 and (st[1] & 4095) == 448) and ok;
    ok = php_check("no_new_file_left", phh_look(tmp, st[0..2]) == PH_K_NONE) and ok;
    // 2. a second start: kept
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("second_start_keeps_it", r == PR_KEPT) and ok;
    // 3. a hand copy at 0755: set to 0700
    sys_chmod(dst, 493);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("a_0755_copy_is_set_to_0700", r == PR_CHMOD and phh_look(dst, st[0..2]) == PH_K_FILE and (st[1] & 4095) == 448) and ok;
    // 4. an older server (other bytes, same size and other size): replaced
    php_put(dst, "SERVER-7119", 448);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("an_older_copy_of_the_same_size_is_replaced", r == PR_COPIED and phh_same(inside, dst)) and ok;
    php_put(dst, "OLD", 420);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("an_older_0644_copy_is_replaced_0700", r == PR_COPIED and phh_same(inside, dst) and phh_look(dst, st[0..2]) == PH_K_FILE and (st[1] & 4095) == 448) and ok;
    // 5. a link in its place: refused, the link stays, its target untouched
    sys_unlink(dst);
    php_symlink(victim, dst);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("a_link_in_its_place_is_refused", r == PR_LINK and phh_look(dst, st[0..2]) == PH_K_LINK) and ok;
    ok = php_check("the_link_target_is_untouched", phh_look(victim, st[0..2]) == PH_K_FILE and st[0] == 6 and (st[1] & 4095) == 384) and ok;
    sys_unlink(dst);
    // 6. a stale .new link: not written through, the copy still made
    php_symlink(victim, tmp);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("a_stale_new_link_is_not_written_through", r == PR_COPIED and phh_look(victim, st[0..2]) == PH_K_FILE and st[0] == 6 and phh_same(inside, dst)) and ok;
    // 7. no server inside the bundle: the one beside it
    sys_unlink(inside);
    sys_unlink(dst);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("no_server_inside_takes_the_one_beside", r == PR_COPIED and info[0] == PH_SRC_BESIDE and phh_same(beside, dst)) and ok;
    // 8. neither: nothing copied, nothing made
    sys_unlink(beside);
    sys_unlink(dst);
    r = php_ensure(exe, home, info[0..3]);
    ok = php_check("no_server_at_all_copies_nothing", r == PR_NO_SOURCE and phh_look(dst, st[0..2]) == PH_K_NONE) and ok;
    // 9. ~/.t27os is a link: refused, nothing written through it
    php_put(inside, "SERVER-7123", 493);
    var b10 : [512]u8 = undefined;
    var b11 : [512]u8 = undefined;
    sys_mkdir(php_p(root, rn, "/h2", b10[0..512]), 448);
    sys_mkdir(php_p(root, rn, "/elsewhere", b10[0..512]), 448);
    php_symlink(php_p(root, rn, "/elsewhere", b10[0..512]), php_p(root, rn, "/h2/.t27os", b11[0..512]));
    const n12 : usize = ph_join(root, rn, "/h2", b11[0..512]);
    r = php_ensure(exe, b11[0..n12], info[0..3]);
    ok = php_check("a_linked_t27os_folder_is_refused", r == PR_NO_DIR and phh_look(php_p(root, rn, "/elsewhere/t27os-pty", b10[0..512]), st[0..2]) == PH_K_NONE) and ok;
    // 10. an executable under /tmp: its server is not used
    ok = php_check("a_source_under_tmp_is_not_fit", ph_src_fit("/tmp/relaunch/T27OS.app/Contents/MacOS/t27os-pty", 48) == false) and ok;
    return ok;
}

pub fn main() -> void {
    const p : u64 = sys_getenv("PHP_ROOT");
    if (p == 0) {
        php_out("PHP_ROOT=<empty scratch folder, absolute, not under /tmp>\n");
        sys_exit(2);
    }
    var root : [400]u8 = undefined;
    var rn : usize = @as(usize, @intCast(sys_strlen(p)));
    if (rn > 399) { rn = 399; }
    sys_peek(root[0..400], p, @as(u64, rn));
    if (!ph_src_fit(root[0..400], rn)) {
        php_out("PHP_ROOT is not fit (absolute, ASCII, no .., not under /tmp)\n");
        sys_exit(2);
    }
    if (php_run(root[0..400], rn)) {
        php_out("PTY HOME PROBE PASS\n");
        sys_exit(0);
    }
    php_out("PTY HOME PROBE FAIL\n");
    sys_exit(1);
}

test the_probe_root_must_be_fit {
    assert ph_src_fit("/Users/x/scratch/php", 20);
    assert ph_src_fit("/tmp/php", 8) == false;
    assert PR_KEPT == 0 and PR_COPIED == 1 and PR_CHMOD == 2 and PR_NO_SOURCE == 3 and PR_LINK == 4 and PR_NO_DIR == 6;
    assert PH_K_NONE == 0 and PH_K_FILE == 1 and PH_K_LINK == 2 and PH_SRC_INSIDE == 1 and PH_SRC_BESIDE == 2;
}
