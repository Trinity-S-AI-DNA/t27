// SPDX-License-Identifier: Apache-2.0
; specs/t27os/glass_window_native_export.t27 -- glass_window host contract for browser 0.3.2 native
; pixels. The CGBitmap writer and CGImageDestination calls stay in glass_window.t27 (@extern). This
; file owns the path, the write-then-flag rule, and tests. NATIVE_EXPORT in
; browser_native_bridge.t27 stays 0 until glass_window lands the writer; the host may mirror the flag
; at runtime when raise_export_after_write is true.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsGlassWindowNativeExport;

use t27os::browser_native_bridge::NATIVE_EXPORT;
use t27os::browser_native_framebuffer::EXPORT_BASENAME;
use t27os::browser_native_framebuffer::EXPORT_DIR_SUFFIX;
use t27os::browser_native_framebuffer::export_path;
use t27os::browser_native_framebuffer::export_enabled;
use t27os::browser_native_framebuffer::png_magic_ok;
use t27os::browser_native_framebuffer::PNG_B0;
use t27os::browser_native_framebuffer::PNG_B1;
use t27os::browser_native_framebuffer::PNG_B2;
use t27os::browser_native_framebuffer::PNG_B3;
use t27os::browser_native_framebuffer::raise_export_after_write;

/// The bridge spec value until glass_window enables export in-tree (always 0 today).
pub fn bridge_export_const() -> u32 {
    return NATIVE_EXPORT;
}

/// Same relative tree as glass_window BR_FRAME_DIR + this basename (glass_window not edited here).
pub fn path_basename() -> string {
    return EXPORT_BASENAME;
}

/// True when the host may mirror NATIVE_EXPORT after an atomic native.png write (write-then-rename).
pub fn export_ready(wrote : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> bool {
    if (bridge_export_const() != 0) { return export_enabled(); }
    return raise_export_after_write(wrote, b0, b1, b2, b3);
}

test path_is_native_png_under_dot_t27os_browser {
    var p : [48]u8 = undefined;
    const n : usize = export_path("/Users/x", p[0..48]);
    assert n > 0;
    assert EXPORT_DIR_SUFFIX == "/.t27os/browser/";
    assert path_basename() == "native.png";
}

test flag_in_bridge_spec_stays_zero {
    assert bridge_export_const() == 0;
    assert !export_enabled();
}

test host_may_raise_only_after_png_on_disk {
    assert !raise_export_after_write(true, 255, 216, 0, 0);
    assert raise_export_after_write(true, PNG_B0, PNG_B1, PNG_B2, PNG_B3);
    assert png_magic_ok(PNG_B0, PNG_B1, PNG_B2, PNG_B3);
}

test export_ready_follows_write_then_magic {
    assert !export_ready(false, PNG_B0, PNG_B1, PNG_B2, PNG_B3);
    assert export_ready(true, PNG_B0, PNG_B1, PNG_B2, PNG_B3);
    assert !export_ready(true, 255, 216, 0, 0);
}

invariant glass_window_export_slice_open {
    assert bridge_export_const() == 0;
    assert !export_enabled();
    assert path_basename() == "native.png";
}