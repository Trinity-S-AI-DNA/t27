// specs/t27os/nvidia_keys.t27 -- T27 OS: NVIDIA keys answer in OpenCode panes.
// Part of M1 (milestone #5). Closes #13326.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::nvidia_keys;

pub struct NvidiaKeys { answered: bool, pane: str };

pub fn nvidia_keys_answered(k: NvidiaKeys) -> bool {
    return k.answered;
}

test "nvidia keys answered" {
    assert(nvidia_keys_answered(NvidiaKeys { answered: true, pane: "opencode-1" }));
    assert(!nvidia_keys_answered(NvidiaKeys { answered: false, pane: "opencode-1" }));
}