// SPDX-License-Identifier: Apache-2.0
; specs/t27os/plist_main.t27 -- the program `make t27os` runs to get the bundle's Info.plist (gHashTag/t27#11315, FR-002).
; It is glue and nothing else: install.t27 plist_text writes the plist text, release.t27 says which version,
; and this main reads the build number from T27OS_BUILD, checks it with install.t27 build_ok, and writes the
; text to standard output. A build number that is not a plain commit count, or a plist that does not fit,
; exits with 2 and writes nothing. It is built by t27b like the app (libSystem only) and holds @extern
; imports through pty_sys.t27, so its tests are the ones in install.t27 and release.t27.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osPlistMain;

use t27os::install::plist_text;
use t27os::install::build_ok;
use t27os::release::current_version;
use t27os::release::put_semver;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_exit;

pub fn main() -> void {
    var build : [16]u8 = undefined;
    var ver : [32]u8 = undefined;
    var out : [2048]u8 = undefined;
    const p : u64 = sys_getenv("T27OS_BUILD");
    if (p == 0) { sys_exit(2); }
    var bn : u64 = sys_strlen(p);
    if (bn > 12) { sys_exit(2); }
    sys_peek(build[0..16], p, bn);
    const blen : usize = @as(usize, @intCast(bn));
    if (!build_ok(build[0..16], blen)) { sys_exit(2); }
    const vn : usize = put_semver(ver[0..32], 32, 0, current_version());
    const n : usize = plist_text(out[0..2048], 2048, ver[0..32], vn, build[0..16], blen);
    if (n > 2048) { sys_exit(2); }
    sys_write(1, out[0..2048], @as(u64, @intCast(n)));
    sys_exit(0);
}

test the_plist_this_program_writes_carries_the_source_version_and_a_build {
    var ver : [32]u8 = undefined;
    var out : [2048]u8 = undefined;
    const vn : usize = put_semver(ver[0..32], 32, 0, current_version());
    assert(vn == 5);
    assert(ver[0] == '0' and ver[2] == '1' and ver[4] == '0');
    const n : usize = plist_text(out[0..2048], 2048, ver[0..32], vn, "17", 2);
    assert(n < 2048);
    assert(build_ok("17", 2));
    assert(build_ok("0", 1) == false);
    assert(out[0] == '<');
}
