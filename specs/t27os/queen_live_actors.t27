// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_live_actors.t27 -- the LIVE ACTORS panel of the Queen dashboard
; (Trinity-S-AI-DNA/t27#12479; owner, 2026-10-26: "on the Queen page I want to see the online
; work of the actors like t27.ai/t27f/live/, in this screen").
; --
; The data already exists and is scheduled: the cron t27os-queen-feed exports the Queen's recent
; actor events every 15 minutes as runs/queen-feed.json in format t27f-queen-feed-v1 (the
; 24-event REPLAY seed of specs/queen/actor_events.t27 while the live bus is offline). The
; t27f/live page already consumes that file. This spec is the VIEW MODEL the Queen dashboard
; panel applies to the same feed: from one actor's last event age and pid, to the row word, the
; machine-online word, and the three counts the panel header shows.
; --
; What already exists, and is NOT rebuilt here: the feed and its format (t27os-queen-feed.t27,
; format t27f-queen-feed-v1), the actor runtime vocabulary (queen/actors.t27), the app's poll
; path (release.t27 check_cmd, hot_reload.t27). The panel render itself is the host step of the
; next build; this file is the law it must implement, so every build shows the same words.
; ASCII only (L3), English. Tests use fake ages and fake pids.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osQueenLiveActors;

// --- 1. The row vocabulary ---------------------------------------------------------------------

pub const W_RUNNING : u8 = 0;
pub const W_IDLE : u8 = 1;
pub const W_GONE : u8 = 2;
pub const WORD_NAMES : str = "running,idle,gone";

// The feed period is 15 minutes (the queen-feed schedule). An actor whose last event is older
; than one period is not part of the online work any more.
pub const FRESH_S : u32 = 900;

// --- 2. One actor's row word --------------------------------------------------------------------

/// RUNNING: the actor held a live pid AND its last event is within one feed period. IDLE: it
; spoke within the period but holds no pid (the supervisor has it parked). GONE: silent longer
; than the period -- not part of the online work until it speaks again.
pub fn row_word(last_event_age_s : u32, pid : u64) -> u8 {
    if (last_event_age_s > FRESH_S) { return W_GONE; }
    if (pid == 0) { return W_IDLE; }
    return W_RUNNING;
}

// --- 3. The machine-online word ------------------------------------------------------------------

// A machine is online when its heartbeat is younger than two feed periods (a missed export must
; not flash a machine off).
pub const ONLINE_MAX_S : u32 = 1800;

pub fn machine_online(heartbeat_age_s : u32) -> bool {
    return heartbeat_age_s <= ONLINE_MAX_S;
}

// --- 4. The header counts ------------------------------------------------------------------------

/// The panel header counts: running, idle, gone -- one pass, no allocation. `words` holds one
; row_word per actor, `count` its length (0 when the feed was empty or unreadable).
pub fn header_counts(words : [32]u8, count : u32) -> u32 {
    var running : u32 = 0;
    var idle : u32 = 0;
    var gone : u32 = 0;
    var i : u32 = 0;
    while (i < count and i < 32) {
        if (words[i] == W_RUNNING) { running += 1; }
        if (words[i] == W_IDLE) { idle += 1; }
        if (words[i] == W_GONE) { gone += 1; }
        i += 1;
    }
    // packed running*10000 + idle*100 + gone: three counts in one u32, each fits 0..99
    return running * 10000 + idle * 100 + gone;
}

// --- 5. Tests ------------------------------------------------------------------------------------

test the_row_word_follows_freshness_and_pid {
    // alive and speaking: RUNNING
    assert row_word(0, 4711) == W_RUNNING;
    assert row_word(FRESH_S, 4711) == W_RUNNING;
    // spoke within the period but parked: IDLE
    assert row_word(60, 0) == W_IDLE;
    // silent past the period: GONE whatever the pid says
    assert row_word(FRESH_S + 1, 4711) == W_GONE;
    assert row_word(86400, 0) == W_GONE;
}

test the_machine_word_tolerates_one_missed_export {
    assert machine_online(0);
    assert machine_online(ONLINE_MAX_S);
    assert machine_online(ONLINE_MAX_S + 1) == false;
}

test the_header_counts_pack_three_numbers {
    var words : [32]u8 = [W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE,
        W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE,
        W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE,
        W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE, W_GONE];
    words[0] = W_RUNNING;
    words[1] = W_RUNNING;
    words[2] = W_IDLE;
    // 2 running, 1 idle, 29 gone
    assert header_counts(words, 32) == 20129;
    // an empty feed counts nothing
    assert header_counts(words, 0) == 0;
}

// --- 6. Invariants -------------------------------------------------------------------------------

invariant the_word_vocabulary_is_three_words {
    assert W_RUNNING == 0 and W_IDLE == 1 and W_GONE == 2;
    assert FRESH_S == 900;
    assert ONLINE_MAX_S == 2 * FRESH_S;
}
