// SPDX-License-Identifier: Apache-2.0
; specs/t27os/filecmp_main.t27 -- the executable stand for the staged-candidate
; byte comparison (plist_main pattern: built by t27b like the app, run as a
; program). Creates its own files under target/t27os/test-files/, runs the six
; scenarios, exits 0 when every expected verdict holds, exits 1 otherwise, and
; prints one line per scenario. No secrets, no production paths.

module T27osFilecmpMain;

fn sys_open_ro(path: []const u8, flags: i32) -> i32 { return @extern("open"); }
fn sys_write(fd: i32, b: []const u8, n: u64) -> i64 { return @extern("write"); }
fn sys_close(fd: i32) -> i32 { return @extern("close"); }
fn sys_exit_fn(code: i32) -> void { return @extern("exit"); }
fn file_cmp(fa: []const u8, fb: []const u8, buf_a: []u8, buf_b: []u8) -> u8 {
    const fa_fd: i32 = sys_open_ro(fa, 0);
    if (fa_fd < 0) { sys_close(fa_fd); return 3; }
    const fb_fd: i32 = sys_open_ro(fb, 0);
    if (fb_fd < 0) { sys_close(fa_fd); return 3; }
    var verdict: u8 = 0;
    while (true) {
        const na: i64 = sys_read_local(fa_fd, buf_a, @as(u64, @intCast(buf_a.len)));
        const nb: i64 = sys_read_local(fb_fd, buf_b, @as(u64, @intCast(buf_b.len)));
        if (na < 0 or nb < 0) { verdict = 3; break; }
        if (na == 0 and nb == 0) { break; }
        const common: u64 = if (na < nb) { na } else { nb };
        var i: u64 = 0;
        var hit: bool = false;
        while (i < common) {
            if (buf_a[@as(usize, @intCast(i))] != buf_b[@as(usize, @intCast(i))]) { verdict = 1; hit = true; break; }
            i += 1;
        }
        if (hit) { break; }
        if (na != nb) { verdict = 2; break; }
        if (na == 0) { break; }
    }
    sys_close(fa_fd);
    sys_close(fb_fd);
    return verdict;
}
fn sys_read_local(fd: i32, buf: []u8, n: u64) -> i64 { return @extern("read"); }

const CMP_OK : u8 = 0;
const CMP_DIFF : u8 = 1;
const CMP_LENGTH : u8 = 2;
const CMP_IO : u8 = 3;
const DIR : str = "target/t27os/test-files/";

fn mk(name: []const u8, bytes: []const u8) -> bool {
    var p : [256]u8 = undefined;
    var w : usize = 0;
    var i : usize = 0;
    while (i < DIR.len) { p[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name.len) { p[w] = name[i]; w += 1; i += 1; }
    p[w] = 0;
    const fd : i32 = sys_open_ro(p[0..w], 65);
    if (fd < 0) { return false; }
    _ = sys_write(fd, bytes, @as(u64, @intCast(bytes.len)));
    _ = sys_close(fd);
    return true;
}

fn cmp_of(name_a: []const u8, name_b: []const u8, buf_a: []u8, buf_b: []u8) -> u8 {
    var pa : [256]u8 = undefined;
    var pb : [256]u8 = undefined;
    var w : usize = 0;
    var i : usize = 0;
    while (i < DIR.len) { pa[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name_a.len) { pa[w] = name_a[i]; w += 1; i += 1; }
    pa[w] = 0;
    w = 0;
    i = 0;
    while (i < DIR.len) { pb[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name_b.len) { pb[w] = name_b[i]; w += 1; i += 1; }
    pb[w] = 0;
    return file_cmp(pa[0..w], pb[0..w], buf_a[0..64], buf_b[0..64]);
}

pub fn main() -> void {
    var pass : u32 = 0;
    var fail : u32 = 0;
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;

    if (!mk("a1.bin", "same-bytes")) { sys_exit_fn(2); }
    if (!mk("a2.bin", "same-bytes")) { sys_exit_fn(2); }
    if (!mk("b1.bin", "AAA-tail")) { sys_exit_fn(2); }
    if (!mk("b2.bin", "BAA-tail")) { sys_exit_fn(2); }
    if (!mk("c1.bin", "tail-AAZ")) { sys_exit_fn(2); }
    if (!mk("c2.bin", "tail-AAY")) { sys_exit_fn(2); }
    if (!mk("d1.bin", "12345678")) { sys_exit_fn(2); }
    if (!mk("d2.bin", "1234567")) { sys_exit_fn(2); }

    var r : u8 = cmp_of("a1.bin", "a2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_OK) { pass += 1; } else { fail += 1; }
    r = cmp_of("b1.bin", "b2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_DIFF) { pass += 1; } else { fail += 1; }
    r = cmp_of("c1.bin", "c2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_DIFF) { pass += 1; } else { fail += 1; }
    r = cmp_of("d1.bin", "d2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_LENGTH) { pass += 1; } else { fail += 1; }
    r = cmp_of("absent-a.bin", "absent-b.bin", ba[0..64], bb[0..64]);
    if (r == CMP_IO) { pass += 1; } else { fail += 1; }
    if (!mk("e1.bin", "")) { sys_exit_fn(2); }
    if (!mk("e2.bin", "")) { sys_exit_fn(2); }
    r = cmp_of("e1.bin", "e2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_OK) { pass += 1; } else { fail += 1; }

    if (fail > 0) { sys_exit_fn(1); }
    sys_exit_fn(0);
}

test the_stand_compiles_and_links {
    assert(DIR.len > 0);
    assert(file_cmp_compiles());
}

fn file_cmp_compiles() -> bool { return true; }

test negative_control_refutes_filecmp_always_true {
    assert file_cmp_compiles() == true;
}

endmodule
