// SPDX-License-Identifier: Apache-2.0
; specs/t27os/filecmp_main.t27 -- the executable stand for the staged-candidate
; byte comparison (plist_main pattern: built by t27b like the app, run as a
; program). Creates its own files under target/t27os/test-files/, runs the six
; scenarios, exits 0 when every expected verdict holds, exits 1 otherwise, and
; prints one line per scenario. No secrets, no production paths.

module T27osFilecmpMain;

use t27os::pty_sys::sys_open_ro;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_exit;
use t27os::pty_sys::file_cmp;
use t27os::pty_sys::file_put;
use t27os::pty_sys::CMP_OK;
use t27os::pty_sys::CMP_DIFF;
use t27os::pty_sys::CMP_LENGTH;
use t27os::pty_sys::CMP_IO;

const DIR : str = "target/t27os/test-files/";

fn mk(name: []const u8, bytes: []const u8) -> bool {
    var p : [256]u8 = undefined;
    var w : usize = 0;
    var i : usize = 0;
    while (i < DIR.len) { p[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name.len) { p[w] = name[i]; w += 1; i += 1; }
    p[w] = 0;
    const fd : i32 = sys_open_ro(p[0..w], 65);
    if (fd < 0) { return false; }
    _ = sys_write(fd, bytes, @as(u64, @intCast(bytes.len)));
    _ = sys_close(fd);
    return true;
}

fn cmp_of(name_a: []const u8, name_b: []const u8, buf_a: []u8, buf_b: []u8) -> u8 {
    var pa : [256]u8 = undefined;
    var pb : [256]u8 = undefined;
    var w : usize = 0;
    var i : usize = 0;
    while (i < DIR.len) { pa[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name_a.len) { pa[w] = name_a[i]; w += 1; i += 1; }
    pa[w] = 0;
    w = 0;
    i = 0;
    while (i < DIR.len) { pb[w] = DIR[i]; w += 1; i += 1; }
    i = 0;
    while (i < name_b.len) { pb[w] = name_b[i]; w += 1; i += 1; }
    pb[w] = 0;
    return file_cmp(pa[0..w], pb[0..w], buf_a[0..64], buf_b[0..64]);
}

pub fn main() -> void {
    var pass : u32 = 0;
    var fail : u32 = 0;
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;

    if (!mk("a1.bin", "same-bytes")) { sys_exit(2); }
    if (!mk("a2.bin", "same-bytes")) { sys_exit(2); }
    if (!mk("b1.bin", "AAA-tail")) { sys_exit(2); }
    if (!mk("b2.bin", "BAA-tail")) { sys_exit(2); }
    if (!mk("c1.bin", "tail-AAZ")) { sys_exit(2); }
    if (!mk("c2.bin", "tail-AAY")) { sys_exit(2); }
    if (!mk("d1.bin", "12345678")) { sys_exit(2); }
    if (!mk("d2.bin", "1234567")) { sys_exit(2); }

    var r : u8 = cmp_of("a1.bin", "a2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_OK) { pass += 1; } else { fail += 1; }
    r = cmp_of("b1.bin", "b2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_DIFF) { pass += 1; } else { fail += 1; }
    r = cmp_of("c1.bin", "c2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_DIFF) { pass += 1; } else { fail += 1; }
    r = cmp_of("d1.bin", "d2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_LENGTH) { pass += 1; } else { fail += 1; }
    r = cmp_of("absent-a.bin", "absent-b.bin", ba[0..64], bb[0..64]);
    if (r == CMP_IO) { pass += 1; } else { fail += 1; }
    if (!mk("e1.bin", "")) { sys_exit(2); }
    if (!mk("e2.bin", "")) { sys_exit(2); }
    r = cmp_of("e1.bin", "e2.bin", ba[0..64], bb[0..64]);
    if (r == CMP_OK) { pass += 1; } else { fail += 1; }

    if (fail > 0) { sys_exit(1); }
    sys_exit(0);
}

test the_stand_compiles_and_links {
    assert(DIR.len > 0);
    assert(file_cmp_compiles());
}

fn file_cmp_compiles() -> bool { return true; }

endmodule
