// SPDX-License-Identifier: Apache-2.0
; specs/t27os/disclosure_scan.t27 -- the checker over published files (board Trinity-S-AI-DNA/t27os#20,
; criterion 3). The footer law lives in specs/t27os/disclosure.t27; this module only counts, inside one
; document (a runs/*.summary.txt, the README), the number lines and the number lines a whole footer covers,
; and hands both counts to disclosure::coverage_verdict -- so "all covered" is said by the law, not here.
;   number line: a receipt row (it carries "tests=") or a line with a digit, '/', digit ("9/9");
;   footer:      five consecutive lines "reader:", "judge:", "n:", "cost:", "repro:", each with a value that is
;                not empty and not a placeholder; it covers the number lines above it, back to the last footer.
; A footer line is never counted as a number line ("n: n=1 run" is the backing, not a published number). A
; footer that is broken, out of order or above its numbers covers nothing. One document per call: the
; boundary reads each file, sums number_lines and footed_lines over the files, and asks
; disclosure::coverage_verdict once -- a footer in one file never covers the numbers of another.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osDisclosureScan;

use policy::l2_generation;
use t27os::disclosure::coverage_verdict;
use t27os::disclosure::is_placeholder;
use t27os::disclosure::COV_ALL;
use t27os::disclosure::COV_GAP;
use t27os::disclosure::COV_EMPTY;
use t27os::disclosure::FIELD_COUNT;
use t27os::disclosure::FIELD_NONE;
use t27os::keysync::contains;

/// The footer keys, one per disclosure FIELD_* constant, in footer order ('$'-terminated pieces).
pub const KEY_READER : str = "reader:$";
pub const KEY_JUDGE : str = "judge:$";
pub const KEY_N : str = "n:$";
pub const KEY_COST : str = "cost:$";
pub const KEY_REPRO : str = "repro:$";

/// The placeholder values, as a list; the test below ties every entry to disclosure::is_placeholder.
pub const PLACEHOLDERS : str = "TBD,tbd,TODO,?,-,n/a,...,$";
/// What marks a receipt row as a published number.
pub const ROW_MARK : str = "tests=$";

pub const NL : u8 = 10;
pub const CR : u8 = 13;

/// The key of footer field f, in order.
pub fn key_of(f: u8) -> str {
    if (f == 0) { return KEY_READER; }
    if (f == 1) { return KEY_JUDGE; }
    if (f == 2) { return KEY_N; }
    if (f == 3) { return KEY_COST; }
    return KEY_REPRO;
}

/// The end of the line that starts at s: the first newline at or after s, or n.
pub fn line_end(t: []const u8, n: usize, s: usize) -> usize {
    var e : usize = s;
    while (e < n and t[e] != NL) { e += 1; }
    return e;
}

/// The footer field line t[s..e] opens, or FIELD_NONE.
pub fn field_of(t: []const u8, s: usize, e: usize) -> u8 {
    var f : u8 = 0;
    while (f < FIELD_COUNT) {
        if (l2_generation::starts_with(t, s, e, key_of(f))) { return f; }
        f += 1;
    }
    return FIELD_NONE;
}

/// Is the value in t[s..e] (spaces and a trailing CR trimmed) filled in?
pub fn value_ok(t: []const u8, s: usize, e: usize) -> bool {
    var a : usize = s;
    var b : usize = e;
    while (a < b and t[a] == ' ') { a += 1; }
    while (b > a and (t[b - 1] == ' ' or t[b - 1] == CR)) { b -= 1; }
    if (a == b) { return false; }
    return l2_generation::list_index(PLACEHOLDERS, t, a, b) == l2_generation::NOT_FOUND;
}

/// Is the field line t[s..e] of field f a filled one?
pub fn field_ok(t: []const u8, s: usize, e: usize, f: u8) -> bool {
    return value_ok(t, s + l2_generation::piece_len(key_of(f)), e);
}

/// Does t[s..e] publish a number: a receipt row, or digit '/' digit?
pub fn is_number_line(t: []const u8, s: usize, e: usize) -> bool {
    var i : usize = s;
    while (i < e) {
        if (l2_generation::starts_with(t, i, e, ROW_MARK)) { return true; }
        if (i + 2 < e and t[i + 1] == '/' and t[i] >= '0' and t[i] <= '9' and t[i + 2] >= '0' and t[i + 2] <= '9') { return true; }
        i += 1;
    }
    return false;
}

/// One pass over t[0..n]: the number lines when want_footed is false, else the ones a whole footer covers.
pub fn scan(t: []const u8, n: usize, want_footed: bool) -> u32 {
    var s : usize = 0;
    var want : u8 = 0;
    var pending : u32 = 0;
    var numbers : u32 = 0;
    var footed : u32 = 0;
    while (s < n) {
        const e : usize = line_end(t, n, s);
        const f : u8 = field_of(t, s, e);
        if (f != FIELD_NONE) {
            if (f == want and field_ok(t, s, e, f)) {
                want += 1;
            } else {
                if (f == 0 and field_ok(t, s, e, f)) { want = 1; } else { want = 0; }
            }
            if (want == FIELD_COUNT) {
                footed += pending;
                pending = 0;
                want = 0;
            }
        } else {
            want = 0;
            if (is_number_line(t, s, e)) {
                numbers += 1;
                pending += 1;
            }
        }
        s = e + 1;
    }
    if (want_footed) { return footed; }
    return numbers;
}

pub fn number_lines(t: []const u8, n: usize) -> u32 {
    return scan(t, n, false);
}

pub fn footed_lines(t: []const u8, n: usize) -> u32 {
    return scan(t, n, true);
}

/// The law's verdict on one document.
pub fn doc_verdict(t: []const u8, n: usize) -> u8 {
    return coverage_verdict(number_lines(t, n), footed_lines(t, n));
}

/// The receipt comment tick 57 posted on t27os#20 (runs/32297057ee...7156e823.json): two rows, one footer.
pub const DOC_FOOTED : str = "specs/crons/t27os-night-loop.t27|tests=18|pass=18|FAIL=0|vacuous=0|blocked=0\nspecs/t27os/disclosure.t27|tests=6|pass=6|FAIL=0|vacuous=0|blocked=0\nreader: t27c 0.5.2 build stamp 32297057ee\njudge: t27c test-report; vacuous and blocked are counted, never passed\nn: n=1 run\ncost: 162 s wall-clock (run 40067224788)\nrepro: gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=32297057ee\n";
/// A summary.txt as lab.yml writes it today: one row, no footer.
pub const DOC_BARE : str = "specs/t27os/receipt_name.t27|tests=5|pass=5|FAIL=0|vacuous=0|blocked=0\n";
/// The same two rows, the cost left as TBD.
pub const DOC_TBD : str = "a.t27|tests=1|pass=1\nb.t27|tests=2|pass=2\nreader: t27c 0.5.2\njudge: t27c test-report\nn: n=1 run\ncost: TBD\nrepro: gh workflow run lab.yml\n";
/// A footer with its judge line dropped.
pub const DOC_FOUR : str = "a.t27|tests=1|pass=1\nreader: t27c 0.5.2\nn: n=1 run\ncost: 4 min\nrepro: gh workflow run lab.yml\n";
/// A footer above its number: it covers nothing.
pub const DOC_ABOVE : str = "reader: t27c 0.5.2\njudge: t27c test-report\nn: n=1 run\ncost: 4 min\nrepro: gh workflow run lab.yml\nREADME: work_graph 9/9\n";
/// Two blocks, the second one bare: one of two numbers covered.
pub const DOC_HALF : str = "work_graph 9/9\nreader: t27c 0.5.2\njudge: t27c test-report\nn: n=1 run\ncost: 4 min\nrepro: gh workflow run lab.yml\nactors 37/37\n";
/// Prose with no number in it.
pub const DOC_PROSE : str = "T27 OS publishes its receipts under runs/.\nn: is a footer key, not a number.\n";
/// The README "Published numbers" section of Trinity-S-AI-DNA/t27os#21 (criterion 2), byte for byte.
pub const DOC_README : str = "## Published numbers\n\nEvery number this repository publishes about T27 OS carries the five-line footer that\n`specs/t27os/disclosure.t27` in gHashTag/t27 defines (reader, judge, n, cost, repro; t27os#20).\nA number without its footer is not published here.\n\nThe first lab receipt, `runs/8f28c2d849.048f7f45.json` (2026-10-23):\n\n```\nspecs/t27f/work_graph.t27|tests=9|pass=9|FAIL=0|vacuous=0|blocked=0\nspecs/queen/actors.t27|tests=37|pass=37|FAIL=0|vacuous=0|blocked=0\nspecs/t27f/export_video.t27|tests=6|pass=6|FAIL=0|vacuous=0|blocked=0\nreader: t27c 0.5.2 built from t27 8f28c2d849837d5deb43b7d2b37f6180fc5c8640 (the binary reports \"build 0 commit unknown\"); specs t27f/work_graph, queen/actors, t27f/export_video\njudge: t27c test-report; vacuous and blocked are counted, never passed (t27os#13)\nn: n=1 run + 1 requester reproduction; no confidence interval\ncost: 108 s on one GitHub runner (lab run 39944645613, job 11:14:06Z to 11:15:54Z); five failed dispatches before it, 10:53Z to 11:08Z, cost about 5 runner-minutes more\nrepro: gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=8f28c2d849837d5deb43b7d2b37f6180fc5c8640 -f challenge=<fresh hex> -f specs=\"specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27\"; the original challenge is bound by challenge_sha256 048f7f45151ce7b29b6109ab66bff18d325c49a7d8ae451412891b370892f561\n```\n";
/// The same section with its n: line dropped: four keys are not a footer.
pub const DOC_README_NO_N : str = "The first lab receipt, `runs/8f28c2d849.048f7f45.json` (2026-10-23):\n\n```\nspecs/t27f/work_graph.t27|tests=9|pass=9|FAIL=0|vacuous=0|blocked=0\nspecs/queen/actors.t27|tests=37|pass=37|FAIL=0|vacuous=0|blocked=0\nspecs/t27f/export_video.t27|tests=6|pass=6|FAIL=0|vacuous=0|blocked=0\nreader: t27c 0.5.2 built from t27 8f28c2d849\njudge: t27c test-report; vacuous and blocked are counted, never passed (t27os#13)\ncost: 108 s on one GitHub runner (lab run 39944645613)\nrepro: gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=8f28c2d849\n```\n";

test the_readme_published_numbers_section_is_all_covered {
    // criterion 2 checked by criterion 3: three receipt rows, one footer below them; the prose and the
    // receipt path above the fence carry no digit/digit, so they publish nothing.
    assert number_lines(DOC_README, DOC_README.len) == 3;
    assert footed_lines(DOC_README, DOC_README.len) == 3;
    assert doc_verdict(DOC_README, DOC_README.len) == COV_ALL;
}

test negative_control_the_readme_section_without_its_n_line_is_a_gap {
    assert number_lines(DOC_README_NO_N, DOC_README_NO_N.len) == 3;
    assert footed_lines(DOC_README_NO_N, DOC_README_NO_N.len) == 0;
    assert doc_verdict(DOC_README_NO_N, DOC_README_NO_N.len) == COV_GAP;
}

test the_tick_57_receipt_comment_is_all_covered {
    assert number_lines(DOC_FOOTED, DOC_FOOTED.len) == 2;
    assert footed_lines(DOC_FOOTED, DOC_FOOTED.len) == 2;
    assert doc_verdict(DOC_FOOTED, DOC_FOOTED.len) == COV_ALL;
}

test negative_control_a_bare_summary_is_a_gap {
    assert number_lines(DOC_BARE, DOC_BARE.len) == 1;
    assert footed_lines(DOC_BARE, DOC_BARE.len) == 0;
    assert doc_verdict(DOC_BARE, DOC_BARE.len) == COV_GAP;
}

test negative_control_a_placeholder_or_a_missing_line_breaks_the_footer {
    assert footed_lines(DOC_TBD, DOC_TBD.len) == 0;
    assert doc_verdict(DOC_TBD, DOC_TBD.len) == COV_GAP;
    assert footed_lines(DOC_FOUR, DOC_FOUR.len) == 0;
    assert doc_verdict(DOC_FOUR, DOC_FOUR.len) == COV_GAP;
}

test negative_control_a_footer_covers_only_the_numbers_above_it {
    assert number_lines(DOC_ABOVE, DOC_ABOVE.len) == 1;
    assert footed_lines(DOC_ABOVE, DOC_ABOVE.len) == 0;
    assert number_lines(DOC_HALF, DOC_HALF.len) == 2;
    assert footed_lines(DOC_HALF, DOC_HALF.len) == 1;
    assert doc_verdict(DOC_HALF, DOC_HALF.len) == COV_GAP;
}

test no_number_is_empty_not_all_covered {
    assert number_lines(DOC_PROSE, DOC_PROSE.len) == 0;
    assert doc_verdict(DOC_PROSE, DOC_PROSE.len) == COV_EMPTY;
}

test the_placeholder_list_is_the_law_list {
    // every entry of PLACEHOLDERS is a placeholder by disclosure::is_placeholder; seven entries, seven words.
    assert l2_generation::list_len(PLACEHOLDERS) == 7;
    assert is_placeholder("TBD") and is_placeholder("tbd") and is_placeholder("TODO") and is_placeholder("?");
    assert is_placeholder("-") and is_placeholder("n/a") and is_placeholder("...");
    assert value_ok("cost: TBD", 5, 9) == false;
    assert value_ok("cost: 4 min", 5, 11) == true;
    assert value_ok("cost:   ", 5, 8) == false;
}

// --- the writer: the lab.yml step that foots every published summary (criterion 3, the fix) --------
// Measured 2026-10-25 in Trinity-S-AI-DNA/t27os runs/: 110 of 110 *.summary.txt carry no footer, so the
// checker above, run over them, reports 110 gaps. FOOTER_STEP_YAML is the lab.yml step that ends that: it
// runs after the receipt is written and before it is published, and appends the five lines to the
// published copy runs/<sha>.<c8>.summary.txt only -- /tmp/out/summary.txt, which the typed result step
// and the fail gate read, is left as rows. cost is measured (run_started_at to now), never written by hand;
// a run whose start time cannot be read fails rather than publish "cost: 0 s".
pub const FOOTER_STEP_YAML : str = "      - name: the disclosure footer (t27 specs/t27os/disclosure_scan.t27)\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          # five footer lines under the published summary, so its numbers are covered (t27os#20)\n          sha=${{ steps.sha.outputs.resolved }}\n          sum=$(git ls-files -o --exclude-standard -- \"runs/$sha.*.summary.txt\" | head -1)\n          [ -n \"$sum\" ] || { echo \"::error::no summary to foot\"; exit 1; }\n          t0=$(gh api \"repos/${{ github.repository }}/actions/runs/${{ github.run_id }}\" --jq .run_started_at)\n          [ -n \"$t0\" ] || { echo \"::error::no run start time; cost cannot be measured\"; exit 1; }\n          secs=$(( $(date -u +%s) - $(date -u -d \"$t0\" +%s) ))\n          {\n            echo \"reader: $(head -1 /tmp/t27c_version.txt) built from t27 $sha; specs ${{ inputs.specs }}\"\n            echo \"judge: t27c test-report; vacuous and blocked are counted, never passed (t27os#13)\"\n            echo \"n: n=1 run; no confidence interval\"\n            echo \"cost: $secs s wall-clock on one GitHub runner (lab run ${{ github.run_id }})\"\n            echo \"repro: gh workflow run lab.yml --repo ${{ github.repository }} -f sha=$sha -f challenge=<fresh hex> -f specs=\\\"${{ inputs.specs }}\\\"\"\n          } >> \"$sum\"\n          cat \"$sum\"\n";

/// What the step writes for receipt runs/fd0ee966b3.803d4cf9 (lab run 40136220581, started 21:53:51Z,
/// last update 21:58:29Z = 278 s), rendered by hand from FOOTER_STEP_YAML with that run's values.
pub const DOC_FOOTED_BY_STEP : str = "specs/t27os/receipt_result.t27|tests=10|pass=10|FAIL=0|vacuous=0|blocked=0\nreader: t27c 0.5.2 build 0 commit unknown built from t27 fd0ee966b3d25ea495baaece5c0e5074e74877f3; specs specs/t27os/receipt_result.t27\njudge: t27c test-report; vacuous and blocked are counted, never passed (t27os#13)\nn: n=1 run; no confidence interval\ncost: 278 s wall-clock on one GitHub runner (lab run 40136220581)\nrepro: gh workflow run lab.yml --repo Trinity-S-AI-DNA/t27os -f sha=fd0ee966b3d25ea495baaece5c0e5074e74877f3 -f challenge=<fresh hex> -f specs=\"specs/t27os/receipt_result.t27\"\n";

/// The same receipt as it is published today: the row alone.
pub const DOC_UNFOOTED_TODAY : str = "specs/t27os/receipt_result.t27|tests=10|pass=10|FAIL=0|vacuous=0|blocked=0\n";

test the_step_writes_all_five_keys_in_footer_order {
    assert contains(FOOTER_STEP_YAML, "echo \"reader: ");
    assert contains(FOOTER_STEP_YAML, "echo \"judge: ");
    assert contains(FOOTER_STEP_YAML, "echo \"n: ");
    assert contains(FOOTER_STEP_YAML, "echo \"cost: ");
    assert contains(FOOTER_STEP_YAML, "echo \"repro: ");
    assert contains(FOOTER_STEP_YAML, "\"\n            echo \"judge: ");
    assert contains(FOOTER_STEP_YAML, "\"\n            echo \"n: ");
    assert contains(FOOTER_STEP_YAML, "\"\n            echo \"cost: ");
    assert contains(FOOTER_STEP_YAML, "\"\n            echo \"repro: ");
}

test the_step_foots_the_published_copy_not_the_rows_the_gates_read {
    assert contains(FOOTER_STEP_YAML, "runs/$sha.*.summary.txt");
    assert contains(FOOTER_STEP_YAML, "} >> \"$sum\"");
    assert contains(FOOTER_STEP_YAML, ">> /tmp/out/summary.txt") == false;
    assert contains(FOOTER_STEP_YAML, "> /tmp/out/summary.txt") == false;
}

test the_cost_is_measured_and_a_missing_start_fails {
    assert contains(FOOTER_STEP_YAML, "--jq .run_started_at");
    assert contains(FOOTER_STEP_YAML, "[ -n \"$t0\" ] || { echo \"::error::");
    assert contains(FOOTER_STEP_YAML, "echo \"cost: $secs s ");
    assert contains(FOOTER_STEP_YAML, "TBD") == false;
}

test the_rendered_step_output_is_all_covered {
    assert number_lines(DOC_FOOTED_BY_STEP, DOC_FOOTED_BY_STEP.len) == 1;
    assert footed_lines(DOC_FOOTED_BY_STEP, DOC_FOOTED_BY_STEP.len) == 1;
    assert doc_verdict(DOC_FOOTED_BY_STEP, DOC_FOOTED_BY_STEP.len) == COV_ALL;
}

test negative_control_the_same_receipt_unfooted_is_a_gap {
    assert number_lines(DOC_UNFOOTED_TODAY, DOC_UNFOOTED_TODAY.len) == 1;
    assert footed_lines(DOC_UNFOOTED_TODAY, DOC_UNFOOTED_TODAY.len) == 0;
    assert doc_verdict(DOC_UNFOOTED_TODAY, DOC_UNFOOTED_TODAY.len) == COV_GAP;
}

// --- the census: the one command that reports which published numbers lack the footer (criterion 3) ---
// Measured 2026-10-25 in Trinity-S-AI-DNA/t27os b7876d1: 113 runs/*.summary.txt, 2 footed, 111 bare. The
// scan above judges one document handed to it as a string; CENSUS_STEP_YAML is the lab.yml step that hands
// it every published one. It quotes README.md and each runs/*.summary.txt into a generated spec, one const
// and one test per document, and runs t27c test-report on it: a failing test names a document with a number
// the footer does not cover, and the census says "all covered" only when every test passes. The shell only
// quotes bytes (backslash first, then the double quote, then the line ends); the verdict is doc_verdict's.
// The step never fails the run (a gap is a report, not a broken lab) and writes nothing under runs/, so the
// census itself publishes no number. All of runs/ is ASCII without tabs (measured the same day).
pub const CENSUS_GEN : str = "specs/t27os/disclosure_census_gen.t27";
pub const CENSUS_STEP_YAML : str = "      - name: the disclosure census -- which published numbers lack their footer (t27 specs/t27os/disclosure_scan.t27)\n        continue-on-error: true\n        shell: bash\n        run: |\n          # one test per published document; a failing test names a document with an unfooted number (t27os#20)\n          gen=specs/t27os/disclosure_census_gen.t27\n          q() { sed -e 's/\\\\/\\\\\\\\/g' -e 's/\"/\\\\\"/g' \"$1\" | awk '{printf \"%s\\\\n\", $0}'; }\n          {\n            echo \"module T27osDisclosureCensusGen;\"\n            echo \"use t27os::disclosure_scan::doc_verdict;\"\n            echo \"use t27os::disclosure::COV_ALL;\"\n            i=0\n            for f in README.md runs/*.summary.txt; do\n              i=$((i+1))\n              id=$(basename \"$f\" | tr -c 'A-Za-z0-9\\n' '_')\n              echo \"pub const D$i : str = \\\"$(q \"$f\")\\\";\"\n              echo \"test doc_${i}_$id { assert doc_verdict(D$i, D$i.len) == COV_ALL; }\"\n            done\n          } > \"t27/$gen\"\n          (cd t27 && ./target/release/t27c test-report \"$gen\") > /tmp/census.txt 2>&1 || true\n          cat /tmp/census.txt\n          { echo \"## disclosure census ($i documents)\"; echo; echo '```'; cat /tmp/census.txt; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"\n";

test the_census_judges_every_published_document_with_the_law {
    assert contains(CENSUS_STEP_YAML, CENSUS_GEN);
    assert contains(CENSUS_STEP_YAML, "for f in README.md runs/*.summary.txt; do");
    assert contains(CENSUS_STEP_YAML, "assert doc_verdict(D$i, D$i.len) == COV_ALL;");
    assert contains(CENSUS_STEP_YAML, "use t27os::disclosure_scan::doc_verdict;");
    assert contains(CENSUS_STEP_YAML, "t27c test-report \"$gen\"");
}

test the_census_quotes_the_backslash_before_the_double_quote {
    // sed runs its -e scripts in order on each line: the backslash rule first, or the backslash the quote
    // rule adds would be doubled again and the literal would end early.
    assert contains(CENSUS_STEP_YAML, "sed -e 's/\\\\/\\\\\\\\/g' -e 's/\"/\\\\\"/g'");
    assert contains(CENSUS_STEP_YAML, "sed -e 's/\"/") == false;
    assert contains(CENSUS_STEP_YAML, "printf \"%s\\\\n\", $0");
}

test negative_control_the_census_reports_and_publishes_nothing {
    // a gap never reddens the lab run, and the census writes no file the next census would have to judge
    assert contains(CENSUS_STEP_YAML, "continue-on-error: true");
    assert contains(CENSUS_STEP_YAML, "> runs/") == false;
    assert contains(CENSUS_STEP_YAML, ">> runs/") == false;
    assert contains(CENSUS_STEP_YAML, "GITHUB_STEP_SUMMARY");
    assert contains(CENSUS_STEP_YAML, "TBD") == false;
}
