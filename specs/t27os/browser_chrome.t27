// SPDX-License-Identifier: Apache-2.0
// specs/t27os/browser_chrome.t27 -- t27os: browser page chrome on the home's
// matte glass - one navigation bar, no stacked platforms.
// Part of M1 (milestone #5). Closes #14043.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::browser_chrome;

pub const CHROME_NAV_BARS : u32 = 1;

pub struct Chrome { nav_bar_count: u32, stacked_platforms: bool, matte_glass: bool };

pub fn chrome_single_nav_bar(c: Chrome) -> bool {
    return c.nav_bar_count == CHROME_NAV_BARS && !c.stacked_platforms;
}

test "chrome single nav bar" {
    assert(chrome_single_nav_bar(Chrome { nav_bar_count: 1, stacked_platforms: false, matte_glass: true }));
    assert(!chrome_single_nav_bar(Chrome { nav_bar_count: 2, stacked_platforms: false, matte_glass: true }));
    assert(!chrome_single_nav_bar(Chrome { nav_bar_count: 1, stacked_platforms: true, matte_glass: true }));
}

invariant chrome_has_one_nav_bar {
    assert CHROME_NAV_BARS == 1;
}