    assert b == 3 + 64 * L_YELLOW;
    assert shown_state_of(b) == 3 and shown_light_of(b) == L_YELLOW;
    assert list_shown(st[0..ST_SIZE], 0, SHELL_CELL, 3, 1000000) == 3;
}

test a_panes_path_starts_with_the_toolchain_folder_once {
    var out : [200]u8 = undefined;
    var n : usize = path_first(out[0..200], "/Users/x", "/opt/homebrew/bin:/usr/bin");
    assert pl_count(out[0..n], "/Users/x/.t27os/bin:/opt/homebrew/bin:/usr/bin") == 1;
    assert n == 46;
    n = path_first(out[0..200], "/Users/x", "/Users/x/.t27os/bin:/usr/bin");
    assert n == 28;
    assert pl_count(out[0..n], "/Users/x/.t27os/bin:/usr/bin") == 1;
    n = path_first(out[0..200], "/Users/x", "/Users/x/.t27os/binx:/usr/bin");
    assert pl_count(out[0..n], "/Users/x/.t27os/bin:/Users/x/.t27os/binx:/usr/bin") == 1;
    n = path_first(out[0..200], "/Users/x", "");
    assert pl_count(out[0..n], "/Users/x/.t27os/bin:/usr/bin:/bin") == 1;
}


pub const CTL_NONE : u32 = 0;
pub const CTL_LIST : u32 = 1;
pub const CTL_SPAWN : u32 = 2;
pub const CTL_KILL : u32 = 3;
pub const CTL_READ : u32 = 4;
pub const CTL_KEYS : u32 = 5;
pub const CTL_EXPECT : u32 = 6;

fn word_is(w: []const u8, k: []const u8) -> bool {
    if (w.len != k.len) { return false; }
    var i : usize = 0;
    while (i < w.len) {
        if (w[i] != k[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The verb a T27OS_CTL word names. The whole word counts: the first letter alone made `keys` run `kill`.
/// `write` stays as the old name of `keys`.
pub fn ctl_verb(w: []const u8) -> u32 {
    if (word_is(w, "list")) { return CTL_LIST; }
    if (word_is(w, "spawn")) { return CTL_SPAWN; }
    if (word_is(w, "kill")) { return CTL_KILL; }
    if (word_is(w, "read")) { return CTL_READ; }
    if (word_is(w, "keys") or word_is(w, "write")) { return CTL_KEYS; }
    if (word_is(w, "expect")) { return CTL_EXPECT; }
    return CTL_NONE;
}

fn hex_val(c: u8) -> u32 {
    if (c >= 48 and c <= 57) { return @as(u32, c) - 48; }
    if (c >= 97 and c <= 102) { return @as(u32, c) - 87; }
    if (c >= 65 and c <= 70) { return @as(u32, c) - 55; }
    return 99;
}

/// The byte a backslash escape stands for (e ESC, r CR, n LF, t TAB, backslash), or 256 when `d` is no escape.
fn esc_byte(d: u8) -> u32 {
    if (d == 101) { return 27; }
    if (d == 114) { return 13; }
    if (d == 110) { return 10; }
    if (d == 116) { return 9; }
    if (d == 92) { return 92; }
    return 256;
}

/// Turn the typed text of T27OS_KEYS into bytes: \e is ESC, \r CR, \n LF, \t TAB, \\ a backslash and
/// \xHH any byte. Any other backslash stays as typed. Lets a script send an arrow key (\e[B) or a bare ESC.
pub fn keys_decode(src: []const u8, out: []u8) -> usize {
    var i : usize = 0;
    var n : usize = 0;
    while (i < src.len) {
        const c : u8 = src[i];
        var step : usize = 1;
        var b : u32 = @as(u32, c);
        if (c == 92 and i + 1 < src.len) {
            const e : u32 = esc_byte(src[i + 1]);
            if (e < 256) {
                b = e;
                step = 2;
            } else if (src[i + 1] == 120 and i + 3 < src.len and hex_val(src[i + 2]) < 16 and hex_val(src[i + 3]) < 16) {
                b = hex_val(src[i + 2]) * 16 + hex_val(src[i + 3]);
                step = 4;
            }
        }
        out[n] = @as(u8, @intCast(b));
        n = n + 1;
        i = i + step;
    }
    return n;
}

/// Copy `src` without terminal control sequences (CSI, OSC, charset selects), so what is left reads as text.
pub fn strip_ansi(src: []const u8, out: []u8) -> usize {
    var i : usize = 0;
    var n : usize = 0;
    while (i < src.len) {
        const c : u8 = src[i];
        if (c != 27) {
            if (c >= 32 or c == 10) {
                out[n] = c;
                n = n + 1;
            }
            i = i + 1;
        } else if (i + 1 >= src.len) {
            i = i + 1;
        } else if (src[i + 1] == 91) {
            i = i + 2;
            while (i < src.len and (src[i] < 64 or src[i] > 126)) { i = i + 1; }
            i = i + 1;
        } else if (src[i + 1] == 93) {
            i = i + 2;
            while (i < src.len and src[i] != 7 and src[i] != 27) { i = i + 1; }
            if (i < src.len and src[i] == 7) { i = i + 1; }
            else if (i < src.len) { i = i + 2; }
        } else if (src[i + 1] == 40 or src[i + 1] == 41) {
            i = i + 3;
        } else {
            i = i + 2;
        }
    }
    return n;
}

/// True when `needle` occurs in `hay` (an empty needle never does).
pub fn has_text(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) { return false; }
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var j : usize = 0;
        while (j < needle.len and hay[i + j] == needle[j]) { j = j + 1; }
        if (j == needle.len) { return true; }
        i = i + 1;
    }
    return false;
}

// ---- tests: each runs and asserts on values the decisions compute ----

test ctl_verbs_match_the_whole_word {
    assert ctl_verb("list") == CTL_LIST;
    assert ctl_verb("spawn") == CTL_SPAWN;
    assert ctl_verb("kill") == CTL_KILL;
    assert ctl_verb("read") == CTL_READ;
    assert ctl_verb("keys") == CTL_KEYS;
    assert ctl_verb("write") == CTL_KEYS;
    assert ctl_verb("expect") == CTL_EXPECT;
    // `keys` once started with k and ran kill; a word that only starts like a verb is no verb
    assert ctl_verb("keys") != CTL_KILL;
    assert ctl_verb("kil") == CTL_NONE;
    assert ctl_verb("killall") == CTL_NONE;
    assert ctl_verb("") == CTL_NONE;
}

test keys_decode_turns_escapes_into_bytes {
    var o : [16]u8 = undefined;
    // arrow down: backslash e [ B
    var a : [4]u8 = undefined;
    a[0] = 92; a[1] = 101; a[2] = 91; a[3] = 66;
    assert keys_decode(a[0..4], o[0..16]) == 3;
    assert o[0] == 27;
    assert o[1] == 91;
    assert o[2] == 66;
    // plain text stays as it is
    assert keys_decode("PONG", o[0..16]) == 4;
    assert o[0] == 80;
    // backslash x 0 d is CR; backslash backslash is one backslash; a lone trailing backslash stays
    var b : [4]u8 = undefined;
    b[0] = 92; b[1] = 120; b[2] = 48; b[3] = 100;
    assert keys_decode(b[0..4], o[0..16]) == 1;
    assert o[0] == 13;
    var c : [3]u8 = undefined;
    c[0] = 92; c[1] = 92; c[2] = 92;
    assert keys_decode(c[0..3], o[0..16]) == 2;
    assert o[0] == 92;
    assert o[1] == 92;
    // backslash x z z is no hex: it stays four bytes
    var d : [4]u8 = undefined;
    d[0] = 92; d[1] = 120; d[2] = 122; d[3] = 122;
    assert keys_decode(d[0..4], o[0..16]) == 4;
}

test strip_ansi_leaves_the_text {
    var o : [64]u8 = undefined;
    var s : [24]u8 = undefined;
    // ESC [ 1 m  P O N G  ESC [ 0 m  ESC ( B  !
    s[0] = 27; s[1] = 91; s[2] = 49; s[3] = 109;
    s[4] = 80; s[5] = 79; s[6] = 78; s[7] = 71;
    s[8] = 27; s[9] = 91; s[10] = 48; s[11] = 109;
    s[12] = 27; s[13] = 40; s[14] = 66;
    s[15] = 33;
    const n : usize = strip_ansi(s[0..16], o[0..64]);
    assert n == 5;
    assert has_text(o[0..n], "PONG!");
    assert has_text(o[0..n], "ESC") == false;
    // an OSC title ends at BEL: ESC ] 0 ; x BEL  O K
    var t : [9]u8 = undefined;
    t[0] = 27; t[1] = 93; t[2] = 48; t[3] = 59; t[4] = 120; t[5] = 7; t[6] = 79; t[7] = 75; t[8] = 33;
    const m : usize = strip_ansi(t[0..9], o[0..64]);
    assert m == 3;
}

test has_text_finds_a_substring {
    assert has_text("Reply with PONG now", "PONG");
    assert has_text("PONG", "PONG");
    assert has_text("PON", "PONG") == false;
    assert has_text("abc", "") == false;
    assert has_text("Missing openai API key", "log in") == false;
}

