// ---- the server's memory: one byte arena and one u64 table ----

/// u64 fields per pane in the table st; pane i starts at i * PF.
pub const PF : usize = 14;
pub const PF_USED : usize = 0;
pub const PF_LIVE : usize = 1;
pub const PF_PID : usize = 2;
pub const PF_FD : usize = 3;
pub const PF_AGENT : usize = 4;
pub const PF_SPACE : usize = 5;
pub const PF_SLOT : usize = 6;
pub const PF_STATUS : usize = 7;
pub const PF_TOTAL : usize = 8;
pub const PF_LAST : usize = 9;
pub const PF_SIDLEN : usize = 10;
pub const PF_CWDLEN : usize = 11;
pub const PF_BORN : usize = 12;
pub const PF_PLAN : usize = 13;
pub const RESUME_GRACE_MS : u64 = 8000;
pub const HOOK_STALE_MS : u64 = 30000;

pub const G_LISTEN : usize = 224;
pub const G_HLEN : usize = 225;
pub const G_BINLEN : usize = 226;
pub const G_CFD : usize = 232;
pub const G_CLEN : usize = 240;
/// Each pane's last RESIZE, two panes per word (pty_proto ws_pack); 8 words cover MAX_PANES.
pub const G_WINSZ : usize = 248;
/// The table grew from 256 to 512 words for the key rotation (gHashTag/t27#11241): per key slot of every
/// provider (PROVIDER_COUNT * MAX_KEYS = 72) when it was last used (ms) and until when it rests (s, KEY_NEVER
/// for a slot that holds no key), then PK words per pane: the key numbers the pane holds, its profile, its bad
/// provider mask, its failover count, the key to skip at the next launch, the time until which its screen
/// is not read (after a give-up) and its restore state (W_*). Key slot (p, k) is word p * MAX_KEYS + k.
/// G_START is the millisecond the server started at (a restored pane waits for keys from then on).
pub const G_START : usize = 227;
/// The millisecond the server last read the Keychain itself (pty_server load_keys); 0 = never. Word 228 was
/// free: G_START is 227 and the connection tables begin at G_CFD.
pub const G_KLOAD : usize = 228;
/// The model step of every pane (keys.t27 MODEL_STEPS, tier_model_step), one nibble per pane, pane i at
/// 16^i: 0 = the default model of the pane's profile, 1 = the second model of its tier (gHashTag/t27#11284).
/// Word 229 was free; the connection tables begin at G_CFD.
pub const G_MSTEP : usize = 229;
/// The agent cell + 1 of every pane (0 = unset = Claude Code), one nibble per pane, pane i at 16^i: plan_pane_keys
/// writes it, so a failover (which is given no agent) walks the chain of the right agent (keys.t27 agent_stored).
/// Word 230 was free; the connection tables begin at G_CFD.
pub const G_AGENTS : usize = 230;
pub const G_KLAST : usize = 256;
pub const G_KREST : usize = 336;
pub const G_PANEK : usize = 416;
/// The table grew from 72 to 80 key slots when the nvidia provider made PROVIDER_COUNT 10
/// (10 * MAX_KEYS = 80; the 72-slot table silently dropped the last provider's keys).
pub const KEY_SLOTS : usize = 80;
pub const PK : usize = 7;
pub const PK_KEYS : usize = 0;
pub const PK_PROF : usize = 1;
pub const PK_BAD : usize = 2;
pub const PK_DONE : usize = 3;
pub const PK_SKIP : usize = 4;
pub const PK_STOP : usize = 5;
pub const PK_WAIT : usize = 6;
/// PK_PROF of a pane that has not chosen a profile yet.
pub const PK_UNSET : u64 = 254;
/// PK_WAIT: 0 nothing; 1 + plan a restored pane waiting for a key of its provider (its launch is deferred);
/// W_KEYLESS a restored pane that started with no key (its one respawn is due when a key arrives); W_DONE
/// that respawn was made.
pub const W_NONE : u64 = 0;
pub const W_KEYLESS : u64 = 8;
pub const W_DONE : u64 = 9;
/// How long a restored pane waits for the window's keys before it starts as it always did.
pub const RESTORE_WAIT_MS : u64 = 20000;
/// A spawn that finds no key for its agent reads the Keychain again only when the last read is older than this
/// (a key added from a terminal is picked up at the next spawn after it; a table with no key at all does not
/// run /usr/bin/security at every spawn).
pub const KEYS_RELOAD_MS : u64 = 60000;
/// A pane's screen is not read for this long after it starts: a resumed Claude Code session replays its
/// transcript, which may hold an earlier error row.
pub const SCAN_GRACE_MS : u64 = 10000;
/// After a give-up the pane's screen is read again only after this long, so one error row on screen is not
/// answered with a line in the scrollback at every redraw.
pub const GIVEUP_QUIET_MS : u64 = 60000;
/// The stage-2 router's state sits above the pane table (issue 12797): the listen fd of the
/// 127.0.0.1:47127 accept loop (fd+1 stored, 0 = not open), its faults in a row and backoff
/// left (router_actor.t27 tick_decision), then the mailbox: RT_CONNS connection fds (fd+1,
/// 0 = free) at G_RCFD and their read lengths at G_RCLEN. Word 515 is spare.
pub const G_RTL : usize = 512;
pub const G_RFAULTS : usize = 513;
pub const G_RBACKOFF : usize = 514;
pub const G_RCFD : usize = 516;
pub const G_RCLEN : usize = 524;
/// The table grew from 512 to 544 words for the router state (issue 12797); nothing existing moved.
pub const ST_SIZE : usize = 544;
pub const MAX_CONNS : usize = 8;

pub const SID_CAP : usize = 64;
pub const CWD_CAP : usize = 256;
pub const IN_CAP : usize = 8200;
pub const O_SID : usize = 0;
pub const O_CWD : usize = 1024;
pub const O_IN : usize = 5120;
pub const O_TMP1 : usize = 70720;
pub const O_TMP2 : usize = 78912;
pub const O_OUT : usize = 87104;
pub const O_HOME : usize = 91304;
pub const O_POLL : usize = 91560;
pub const O_MISC : usize = 92072;
pub const O_BIN : usize = 92400;
/// Each pane's model (session_store model_ok): a length byte, then up to MODEL_CAP - 1 bytes.
pub const MODEL_CAP : usize = 64;
pub const O_MODEL : usize = 97280;
pub const O_RING : usize = 98304;
/// The key table: KEY_SLOTS slots of KEY_CAP bytes (a length byte, the key, a NUL), slot (p, k) at
/// O_KEYS + (p * MAX_KEYS + k) * KEY_CAP (key_slot). Then each pane's unfinished screen line (a length byte
/// and up to CARRY_CAP bytes, CARRY_SLOT apart) and the scratch where a chunk's plain text is built.
pub const O_KEYS : usize = 1146880;
pub const KEY_CAP : usize = 256;
/// The carry region moved after the key table grew to PROVIDER_COUNT = 10 rows (the nvidia
/// provider, #12774): 10 * 8 * 256 = 20480 bytes end at 1167360, so the regions below follow.
pub const O_CARRY : usize = 1167360;
pub const CARRY_CAP : usize = 128;
pub const CARRY_SLOT : usize = 132;
pub const O_SCAN : usize = 1169472;
pub const SCAN_CAP : usize = 4232;
/// The router's per-connection read buffers (issue 12797): RT_CONNS buffers of RT_CAP bytes,
/// connection c at O_RTRD + c * RT_CAP. The region sits after O_SCAN; MEM_SIZE grew and
/// nothing existing moved.
pub const O_RTRD : usize = 1173704;
pub const RT_CAP : usize = 2048;
pub const MEM_SIZE : usize = 1190088;
pub const TICK_MS : i32 = 500;
pub const SIGHUP_RING : u64 = 65536;

// ---- pure decisions ----

/// The index of the first pane slot with no record; MAX_PANES when the table is full.
pub fn pane_alloc(st: []const u64) -> u32 {
    var i : u32 = 0;
    while (i < MAX_PANES) {
        if (st[@as(usize, i) * PF + PF_USED] == 0) { return i; }
        i = i + 1;
    }
    return MAX_PANES;
}

/// The milliseconds a gettimeofday result holds: tv_sec (8 bytes) then tv_usec (4 bytes).
pub fn tv_ms(b: []const u8) -> u64 {
    const sec : u64 = get_u64(b, 0);
    const us : u64 = @as(u64, b[8]) + @as(u64, b[9]) * 256 + @as(u64, b[10]) * 65536 + @as(u64, b[11]) * 16777216;
    return sec * 1000 + us / 1000;
}

/// One pollfd entry k: the fd (4 bytes LE), events POLLIN, revents cleared.
pub fn put_pollfd(b: []u8, k: usize, fd: u32) -> void {
    const at : usize = k * 8;
    b[at] = @as(u8, @intCast(fd & 255));
    b[at + 1] = @as(u8, @intCast((fd / 256) & 255));
    b[at + 2] = @as(u8, @intCast((fd / 65536) & 255));
    b[at + 3] = @as(u8, @intCast((fd / 16777216) & 255));
    b[at + 4] = 1;
    b[at + 5] = 0;
    b[at + 6] = 0;
    b[at + 7] = 0;
}

/// The revents of entry k: anything but 0 means read it (data, hangup and error all show up as a read).
pub fn poll_revents(b: []const u8, k: usize) -> u32 {
    return @as(u32, b[k * 8 + 6]) + @as(u32, b[k * 8 + 7]) * 256;
}

/// The exit status word of waitpid: a clean exit(0) is P_EXIT_OK, anything else P_EXIT_FAIL.
pub fn exit_event(status: u32) -> u32 {
    if (status == 0) { return P_EXIT_OK; }
    return P_EXIT_FAIL;
}

/// The status a hook event gives a pane; the status itself when the name is not one we read.
pub fn hooked_status(w: u32, name: []const u8) -> u32 {
    const e : u32 = hook_event(name);
    if (e == P_COUNT) { return w; }
    return pane_step(w, e);
}

/// The flags byte of a LISTING entry: bit 0 live, bit 1 needs you, bit 2 unseen.
pub fn list_flags(live: bool, w: u32) -> u32 {
    var f : u32 = 0;
    if (live) { f = f + 1; }
    if (pane_needs_you(w)) { f = f + 2; }
    if ((w & BIT_UNSEEN) != 0) { f = f + 4; }
    return f;
}

/// The model a hook payload names ({"model":"..."}: Claude Code's SessionStart carries it), as (at, len)
/// in f[0], f[1]; false when there is none or it fails model_ok().
pub fn hook_model(payload: []const u8, f: []u64) -> bool {
    if (!json_field(payload, "model", f)) { return false; }
    const at : usize = @as(usize, @intCast(f[0]));
    return model_ok(payload[at .. at + @as(usize, @intCast(f[1]))]);
}

/// A SPAWN payload is agent, plan, 1 spare byte, then the cwd, optionally followed by a TAB and a model.
/// The length of the cwd part.
pub fn spawn_cwd_len(payload: []const u8) -> usize {
    if (payload.len <= 3) { return 0; }
    var i : usize = 3;
    var end : usize = payload.len;
    while (i < payload.len) {
        if (payload[i] == 9 and end == payload.len) { end = i; }
        i = i + 1;
    }
    return end - 3;
}

/// The command a pane runs: fresh (with a new Claude session id) or resumed, plus the Claude hook
/// settings file for the claude cell, written into out. Returns the length.
pub fn pane_command(agent: u32, plan: u32, sid: []const u8, model: []const u8, home: []const u8, out: []u8) -> usize {
    var n : usize = 0;
    if (plan == R_RELAUNCH) {
        n = fresh_command(agent, sid, model, out);
    } else {
        n = build_command(agent, plan, sid, model, out);
    }
    if (agent == 0) {
        n = put_bytes(out, n, " --settings ");
        n = put_bytes(out, n, home);
        n = put_bytes(out, n, "/.t27os/hooks.json");
    }
    return n;
}

/// An editor pane (owner, 2026-10-20: "T27OS opens inside"): a SPAWN of the shell cell whose model field
/// names a terminal editor (editors.t27 TERM_NAMES). The pane's cwd is the directory or file to open. The
/// wire format is the one above, unchanged: [SHELL_CELL][space][slot][path] TAB [editor].
pub fn wants_editor(agent: u32, model: []const u8) -> bool {
    return agent == SHELL_CELL and term_index(model) != TERM_NONE;
}

/// The server refuses an editor SPAWN whose path would break the quoting around it in `sh -c`; every other
/// SPAWN passes as before.
pub fn editor_spawn_ok(agent: u32, model: []const u8, cwd: []const u8) -> bool {
    if (wants_editor(agent, model) == false) { return true; }
    return term_path_fits(cwd);
}

/// The command a pane starts with: an editor pane runs `<editor> '<cwd>'` (also when it is restored from
/// its record, which keeps the editor in the model field and the path in the cwd), every other pane runs
/// pane_command as before.
pub fn launch_command(agent: u32, plan: u32, sid: []const u8, model: []const u8, home: []const u8, cwd: []const u8, out: []u8) -> usize {
    if (wants_editor(agent, model) and term_path_fits(cwd)) {
        return editor_command(term_index(model), cwd, out);
    }
    return pane_command(agent, plan, sid, model, home, out);
}

/// The argv strings of `/bin/sh -c "exec <cmd>"` in one buffer, NUL separated; offsets go to f:
/// f[0] the -c at, f[1] the command at. Returns the buffer length.
pub fn argv_text(cmd: []const u8, out: []u8, f: []u64) -> usize {
    var n : usize = put_bytes(out, 0, "/bin/sh");
    out[n] = 0;
    f[0] = n + 1;
    n = put_bytes(out, n + 1, "-c");
    out[n] = 0;
    f[1] = n + 1;
    n = put_bytes(out, n + 1, "exec ");
    n = put_bytes(out, n, cmd);
    out[n] = 0;
    return n + 1;
}

/// Text that can stand inside a plist <string> as it is: no markup character, no control byte.
pub fn xml_ok(s: []const u8) -> bool {
    var i : usize = 0;
    while (i < s.len) {
        if (s[i] == 60 or s[i] == 62 or s[i] == 38 or s[i] < 32) { return false; }
        i = i + 1;
    }
    return true;
}

fn plist_env(out: []u8, at: usize, key: []const u8, val: []const u8) -> usize {
    if (val.len == 0 or !xml_ok(val)) { return at; }
    var n : usize = put_bytes(out, at, "<key>");
    n = put_bytes(out, n, key);
    n = put_bytes(out, n, "</key><string>");
    n = put_bytes(out, n, val);
    return put_bytes(out, n, "</string>");
}

/// The PATH of a pane (owner, 2026-10-20): <home>/.t27os/bin first, so every pane runs the t27b, t27c and tri of the
/// release the updater installed there, then the PATH the server was started with (a default when it has none).
/// Not added twice. Clipped at out.len; the length written.
pub fn path_first(out: []u8, home: []const u8, path: []const u8) -> usize {
    var n : usize = put_bytes(out, 0, home);
    n = put_bytes(out, n, "/.t27os/bin");
    if (path.len == 0) { return put_bytes(out, n, ":/usr/bin:/bin:/usr/sbin:/sbin"); }
    var i : usize = 0;
    var same : bool = path.len >= n;
    while (same and i < n) {
        if (path[i] != out[i]) { same = false; }
        i = i + 1;
    }
    if (same and (path.len == n or path[n] == 58)) { n = 0; i = 0; } else { n = put_bytes(out, n, ":"); }
    if (n == 0) { return put_bytes(out, 0, path); }
    return put_bytes(out, n, path);
}

/// The launchd agent plist that starts this binary at login and restarts it when it dies. launchd gives
/// an agent PATH=/usr/bin:/bin:/usr/sbin:/sbin and no TERM, so the plist carries the PATH and LANG of the
/// shell that installed it (claude lives in ~/.local/bin) and TERM=xterm-256color for the panes; the
/// server's output goes to ~/.t27os/server.log. A value that is not xml_ok() is left out.
pub fn plist_text(out: []u8, bin: []const u8, home: []const u8, path: []const u8, lang: []const u8) -> usize {
    var n : usize = put_bytes(out, 0, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    n = put_bytes(out, n, "<plist version=\"1.0\"><dict>\n");
    n = put_bytes(out, n, "<key>Label</key><string>ai.t27.os-server</string>\n");
    n = put_bytes(out, n, "<key>ProgramArguments</key><array><string>");
    n = put_bytes(out, n, bin);
    n = put_bytes(out, n, "</string></array>\n");
    n = put_bytes(out, n, "<key>RunAtLoad</key><true/>\n");
    n = put_bytes(out, n, "<key>KeepAlive</key><true/>\n");
    n = put_bytes(out, n, "<key>EnvironmentVariables</key><dict>");
    n = plist_env(out, n, "PATH", path);
    n = plist_env(out, n, "LANG", lang);
    n = plist_env(out, n, "TERM", "xterm-256color");
    n = put_bytes(out, n, "</dict>\n");
    if (xml_ok(home)) {
        n = put_bytes(out, n, "<key>StandardOutPath</key><string>");
        n = put_bytes(out, n, home);
        n = put_bytes(out, n, "/.t27os/server.log</string>\n");
        n = put_bytes(out, n, "<key>StandardErrorPath</key><string>");
        n = put_bytes(out, n, home);
        n = put_bytes(out, n, "/.t27os/server.log</string>\n");
    }
    n = put_bytes(out, n, "</dict></plist>\n");
    return n;
}

/// A resumed pane that dies at once (no conversation to resume: claude was never prompted, or its
/// transcript is gone) is relaunched fresh in its cwd: the exit came before the grace period ended.
pub fn resume_failed(plan: u32, born: u64, now: u64, status: u32) -> bool {
    if (plan != R_RESUME or status == 0) { return false; }
    return now >= born and now - born < RESUME_GRACE_MS;
}

/// A hooked pane that says "working" and has printed nothing for HOOK_STALE_MS lost its Stop hook (an
/// empty Enter at the prompt starts no turn): treat the turn as finished.
pub fn hook_stale(w: u32, now: u64, last: u64) -> bool {
    if (!ps_hooked(w) or ps_state(w) != S_WORKING) { return false; }
    return now >= last and now - last >= HOOK_STALE_MS;
}

/// Copy a NUL-free path and add the NUL a C call needs; returns the length without it.
pub fn c_path(out: []u8, src: []const u8) -> usize {
    const n : usize = put_bytes(out, 0, src);
    out[n] = 0;
    return n;
}

// ---- key rotation (gHashTag/t27#11241): the server's key table, the keys a pane holds, the failover ----
// The server holds up to MAX_KEYS keys per provider in memory (never on disk) with when each was last used
// and until when it rests. A pane spawn picks its key with rotate_pick_soft (the key used longest ago that is
// not resting; when all rest, the one whose rest ends first). The pane keeps the key NUMBER, never the key.
// When the pane's screen shows a failure the key rests and the pane is respawned by keys.t27 fo_action, on the
// next key of the same provider (rotate_pick_except, the failed key skipped) or on the next profile.

fn pow16(n: u32) -> u64 {
    var m : u64 = 1;
    var j : u32 = 0;
    while (j < n) {
        m = m * 16;
        j = j + 1;
    }
    return m;
}

/// The offset in the arena of key slot (p, k): a length byte, the key, a NUL (OP_SETKEY fills it).
pub fn key_slot(p: u32, k: u32) -> usize {
    return O_KEYS + key_index(p, k) * KEY_CAP;
}

/// The model step of pane i (0 = the default model of its profile).
pub fn pane_mstep_get(st: []const u64, i: usize) -> u32 {
    return @as(u32, @intCast(st[G_MSTEP] / pow16(@as(u32, @intCast(i))) % 16));
}

pub fn pane_mstep_set(st: []u64, i: usize, v: u32) -> void {
    const m : u64 = pow16(@as(u32, @intCast(i)));
    st[G_MSTEP] = st[G_MSTEP] - @as(u64, pane_mstep_get(st, i)) * m + @as(u64, v) * m;
}

/// A pane that has chosen nothing: no keys, no profile, no failures, nothing to skip, nothing waiting, and the
/// default model of its tier (a new pane, and a pane restored from its record, start on it).
pub fn pane_keys_reset(st: []u64, i: usize) -> void {
    pane_mstep_set(st, i, 0);
    const pk : usize = G_PANEK + i * PK;
    st[pk + PK_KEYS] = 0;
    st[pk + PK_PROF] = PK_UNSET;
    st[pk + PK_BAD] = 0;
    st[pk + PK_DONE] = 0;
    st[pk + PK_SKIP] = 0;
    st[pk + PK_STOP] = 0;
    st[pk + PK_WAIT] = W_NONE;
}

/// The empty table: every slot rests until KEY_NEVER (holds no key), every pane is reset.
pub fn keys_init(st: []u64) -> void {
    var s : usize = 0;
    while (s < KEY_SLOTS) {
        st[G_KLAST + s] = 0;
        st[G_KREST + s] = KEY_NEVER;
        s = s + 1;
    }
    var i : usize = 0;
    while (i < 16) {
        pane_keys_reset(st, i);
        i = i + 1;
    }
}

pub fn key_present(st: []const u64, p: u32, k: u32) -> bool {
    return st[G_KREST + key_index(p, k)] < KEY_NEVER;
}

/// How many slots of provider p hold a key.
pub fn key_count(st: []const u64, p: u32) -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (key_present(st, p, k)) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// The providers that hold at least one key, as a bit mask.
pub fn keys_stored(st: []const u64) -> u32 {
    var m : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (key_count(st, p) > 0) { m = m + (1 << p); }
        p = p + 1;
    }
    return m;
}

/// OP_SETKEY filled (present) or emptied slot (p, k). `same`: the bytes are those already held, so the key keeps
/// its last-use and rest times (a window that sends every key again must not end a cooldown).
pub fn key_put(st: []u64, p: u32, k: u32, present: bool, same: bool) -> void {
    const ix : usize = key_index(p, k);
    if (present == false) {
        st[G_KLAST + ix] = 0;
        st[G_KREST + ix] = KEY_NEVER;
        return;
    }
    if (same and st[G_KREST + ix] < KEY_NEVER) { return; }
    st[G_KLAST + ix] = 0;
    st[G_KREST + ix] = 0;
}

/// The key of provider p a new pane takes (MAX_KEYS when it holds none); `skip` is a key not to take.
pub fn key_pick(st: []const u64, p: u32, skip: u32, now_ms: u64) -> u32 {
    const at : usize = key_index(p, 0);
    return rotate_pick_soft(MAX_KEYS, skip, st[G_KLAST + at .. G_KLAST + at + 8], st[G_KREST + at .. G_KREST + at + 8], now_ms / 1000);
}

/// A key of provider p that is usable right now and is not `skip` (MAX_KEYS when none): the test for a swap.
pub fn key_pick_free(st: []const u64, p: u32, skip: u32, now_ms: u64) -> u32 {
    const at : usize = key_index(p, 0);
    return rotate_pick_except(MAX_KEYS, skip, st[G_KLAST + at .. G_KLAST + at + 8], st[G_KREST + at .. G_KREST + at + 8], now_ms / 1000);
}

/// Every key of provider p is free again: a rest was earned on the model a pane ran, and the next model of the
/// tier answers on its own (z.ai: the same key that is overloaded on glm-4.7-flash answers glm-4.5-flash).
/// A slot that holds no key stays empty.
pub fn key_rests_lift(st: []u64, p: u32) -> void {
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (key_present(st, p, k)) { st[G_KREST + key_index(p, k)] = 0; }
        k = k + 1;
    }
}

pub fn key_used(st: []u64, p: u32, k: u32, now_ms: u64) -> void {
    st[G_KLAST + key_index(p, k)] = now_ms;
}

/// Key (p, k) rests until `until_s`; a longer rest it already has stays, and a slot that holds no key stays empty.
pub fn key_rest(st: []u64, p: u32, k: u32, until_s: u64) -> void {
    const ix : usize = G_KREST + key_index(p, k);
    if (st[ix] >= KEY_NEVER) { return; }
    if (until_s > st[ix]) { st[ix] = until_s; }
}

/// The key number + 1 pane i holds for provider p (0 = none): one nibble per provider.
pub fn pane_key_get(st: []const u64, i: usize, p: u32) -> u32 {
    return @as(u32, @intCast(st[G_PANEK + i * PK + PK_KEYS] / pow16(p) % 16));
}

pub fn pane_key_set(st: []u64, i: usize, p: u32, v: u32) -> void {
    const at : usize = G_PANEK + i * PK + PK_KEYS;
    const m : u64 = pow16(p);
    st[at] = st[at] - @as(u64, pane_key_get(st, i, p)) * m + @as(u64, v) * m;
}

/// The agent cell pane i was last planned for (keys.t27 AG_*); Claude Code when none was.
pub fn pane_agent_get(st: []const u64, i: usize) -> u32 {
    const v : u32 = @as(u32, @intCast(st[G_AGENTS] / pow16(@as(u32, @intCast(i))) % 16));
    if (v == 0) { return 0; }
    return v - 1;
}

pub fn pane_agent_set(st: []u64, i: usize, a: u32) -> void {
    const m : u64 = pow16(@as(u32, @intCast(i)));
    const old : u64 = st[G_AGENTS] / m % 16;
    st[G_AGENTS] = st[G_AGENTS] - old * m + @as(u64, a + 1) * m;
}

/// The key number + 1 a LIST shows for pane i (0 = none): for the claude cell the key of its profile's provider,
/// for every other agent the first provider it reads that it holds a key for.
pub fn pane_key_shown(st: []const u64, i: usize, a: u32) -> u32 {
    if (profile_agent(a)) {
        const pr : u64 = st[G_PANEK + i * PK + PK_PROF];
        if (pr >= @as(u64, PROFILE_COUNT)) { return 0; }
        return pane_key_get(st, i, PROFILE_PROVIDER[@as(u32, @intCast(pr))]);
    }
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        const v : u32 = pane_key_get(st, i, p);
        if (v > 0) { return v; }
        p = p + 1;
    }
    return 0;
}

/// How many keys of provider p can serve at `now_ms`: present and free, or resting less than LIGHT_SOON_S more.
pub fn keys_usable(st: []const u64, p: u32, now_ms: u64) -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (key_present(st, p, k) and st[G_KREST + key_index(p, k)] <= now_ms / 1000 + LIGHT_SOON_S) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// The traffic light of pane i (agent a) at `now_ms` (keys.t27 light_of): its profile's tier, whether the chain
/// gave up (the screen is quiet after a give-up, PK_STOP in the future), and the keys of its provider that can
/// still serve. A cell with no profile (an editor, a shell) has none; a profile agent with no profile yet is RED.
pub fn pane_light(st: []const u64, i: usize, a: u32, now_ms: u64) -> u32 {
    if (profile_agent(a) == false) { return L_NONE; }
    const pk : usize = G_PANEK + i * PK;
    const w : u64 = st[pk + PK_PROF];
    if (w >= @as(u64, PROFILE_COUNT)) { return L_RED; }
    const pr : u32 = @as(u32, @intCast(w));
    return light_of(PROFILE_TIER[pr], st[pk + PK_STOP] > now_ms, keys_usable(st, PROFILE_PROVIDER[pr], now_ms));
}

/// The LIST `shown` byte of pane i: the state with the light in bits 6 and 7.
pub fn list_shown(st: []const u64, i: usize, a: u32, shown: u32, now_ms: u64) -> u32 {
    return shown_with_light(shown, pane_light(st, i, a, now_ms));
}

/// The flags byte of a LIST entry with the pane's key number + 1 in its high nibble (0 to 8). Bits 0 to 2 are
/// list_flags as before, so a client that reads only those is not disturbed.
pub fn list_flags_key(live: bool, w: u32, key1: u32) -> u32 {
    return list_flags(live, w) + 16 * key1;
}

/// Choose the keys of pane i about to launch (agent a, `now_ms`): fills the pane's key numbers and profile
/// from the table, marks each picked key used, clears the skip. The claude cell takes the profile the pane
/// asked for (a failover set it) or pick_profile over the providers that hold a key and have not failed for
/// this pane, then the key of that provider by rotation, skipping the key that just failed. Every other agent
/// takes a key of each provider it reads, by rotation. Nothing here holds a key value.
pub fn plan_pane_keys(st: []u64, i: usize, a: u32, now_ms: u64) -> void {
    const pk : usize = G_PANEK + i * PK;
    st[pk + PK_KEYS] = 0;
    st[pk + PK_STOP] = 0;
    if (a < AGENT_COUNT) { pane_agent_set(st, i, a); }
    if (profile_agent(a)) {
        var pr : u32 = PR_NONE;
        if (st[pk + PK_PROF] < @as(u64, PROFILE_COUNT) and agent_profile_ok(a, @as(u32, @intCast(st[pk + PK_PROF])))) {
            pr = @as(u32, @intCast(st[pk + PK_PROF]));
        } else {
            pr = pick_profile(agent_stored(a, keys_stored(st)), @as(u32, @intCast(st[pk + PK_BAD])));
        }
        var skip : u32 = MAX_KEYS;
        if (st[pk + PK_SKIP] > 0) { skip = @as(u32, @intCast(st[pk + PK_SKIP])) - 1; }
        if (pr < PROFILE_COUNT) {
            const prov : u32 = PROFILE_PROVIDER[pr];
            const k : u32 = key_pick(st, prov, skip, now_ms);
            if (k < MAX_KEYS) {
                key_used(st, prov, k, now_ms);
                pane_key_set(st, i, prov, k + 1);
            } else {
                pr = PR_NONE;
            }
        }
        st[pk + PK_PROF] = @as(u64, pr);
        st[pk + PK_SKIP] = 0;
        return;
    }
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (agent_uses(a, p) and key_count(st, p) > 0) {
            const k : u32 = key_pick(st, p, MAX_KEYS, now_ms);
            if (k < MAX_KEYS) {
                key_used(st, p, k, now_ms);
                pane_key_set(st, i, p, k + 1);
            }
        }
        p = p + 1;
    }
}

/// How long a give-up leaves the pane's screen unread: at least GIVEUP_QUIET_MS, and at least as long as the
/// failed key rests (keys.t27 key_rest_after: ten minutes for an empty account, an hour for a rejected key).
/// Until a rest ends there is no key to move to, so reading the same error row again would only write the
/// same why line again: the give-up is said once.
pub fn giveup_quiet_ms(class: u32) -> u64 {
    const rest : u64 = key_rest_after(class) * 1000;
    if (rest > GIVEUP_QUIET_MS) { return rest; }
    return GIVEUP_QUIET_MS;
}

/// The failover for pane i whose screen showed failure `class` at `now_ms`. The key the pane used rests by the
/// kind of failure (keys.t27 key_rest_after), for every pane, not just this one. fo_action decides; on a respawn
/// the pane's profile, bad mask, failover count and key to skip are set for plan_pane_keys, and the why line
/// (keys.t27 fo_why, 128 bytes are enough) goes to `why` with its length in wl[0]. After a give-up the screen
/// is not read again for giveup_quiet_ms (never retrying a key that rests). Returns the action; FA_RESPAWN_*
/// means "stop the process, launch again": FA_RESPAWN_KEY on the next key of the provider (the failed one
/// skipped), FA_RESPAWN_MODEL on the next model of the tier with every key free again (no key was left on this
/// model, fo_next_model), FA_RESPAWN_NEXT on the next profile of the chain (model step 0 again).
pub fn plan_failover(st: []u64, i: usize, class: u32, now_ms: u64, why: []u8, wl: []u64) -> u32 {
    const pk : usize = G_PANEK + i * PK;
    var pr : u32 = PR_NONE;
    if (st[pk + PK_PROF] < @as(u64, PROFILE_COUNT)) { pr = @as(u32, @intCast(st[pk + PK_PROF])); }
    const stored : u32 = agent_stored(pane_agent_get(st, i), keys_stored(st));
    const bad : u32 = @as(u32, @intCast(st[pk + PK_BAD]));
    const done : u32 = @as(u32, @intCast(st[pk + PK_DONE]));
    var cur : u32 = MAX_KEYS;
    var alt : bool = false;
    if (pr < PROFILE_COUNT) {
        const prov : u32 = PROFILE_PROVIDER[pr];
        const held : u32 = pane_key_get(st, i, prov);
        if (held > 0) { cur = held - 1; }
        const rest : u64 = key_rest_after(class);
        if (cur < MAX_KEYS and rest > 0) { key_rest(st, prov, cur, now_ms / 1000 + rest); }
        alt = key_pick_free(st, prov, cur, now_ms) != MAX_KEYS;
    }
    const step : u32 = pane_mstep_get(st, i);
    var act : u32 = fo_action(class, pr, stored, bad, done, alt);
    if (fo_next_model(class, pr, step, done, alt)) { act = FA_RESPAWN_MODEL; }
    var nxt : u32 = PR_NONE;
    if (act == FA_RESPAWN_KEY) {
        nxt = pr;
        st[pk + PK_SKIP] = @as(u64, cur) + 1;
    }
    if (act == FA_RESPAWN_MODEL) {
        nxt = pr;
        pane_mstep_set(st, i, step + 1);
        key_rests_lift(st, PROFILE_PROVIDER[pr]);
    }
    if (act == FA_RESPAWN_NEXT) {
        nxt = fo_target(class, pr, stored, bad, done, alt);
        st[pk + PK_BAD] = @as(u64, fo_bad(class, pr, bad));
        pane_mstep_set(st, i, 0);
    }
    if (act == FA_RESPAWN_KEY or act == FA_RESPAWN_NEXT or act == FA_RESPAWN_MODEL) {
        st[pk + PK_PROF] = @as(u64, nxt);
        st[pk + PK_DONE] = @as(u64, done) + 1;
    }
    if (act == FA_GIVE_UP) { st[pk + PK_STOP] = now_ms + giveup_quiet_ms(class); }
    wl[0] = @as(u64, fo_why(class, pr, act, nxt, done, why));
    return act;
}

/// The model pane i (agent a) starts with, written into out (64 bytes are enough); 0 = pass no model. Call it
/// after plan_pane_keys, which chose the pane's profile. A pane that is restored from its record, started
/// again after a failover, or relaunched after a resume that died gets the model a fresh spawn of its
/// profile computes (keys.t27 model_for_profile at the pane's model step), never the one its record holds: the
/// record may name a model the provider does not serve to these keys (glm-5.2 answers 1113 on all of them),
/// and a model of the profile it just left has no place on the next one. `first` is the first start of a
/// SPAWN, whose payload may name a model on purpose; that one, and the model of every agent but the claude
/// cell (no profile), stay as they are.
pub fn launch_model(st: []const u64, i: usize, a: u32, first: bool, saved: []const u8, out: []u8) -> usize {
    if (profile_agent(a) == false or first) { return put_bytes(out, 0, saved); }
    var pr : u32 = PR_NONE;
    const w : u64 = st[G_PANEK + i * PK + PK_PROF];
    if (w < @as(u64, PROFILE_COUNT)) { pr = @as(u32, @intCast(w)); }
    return model_for_profile(pr, pane_mstep_get(st, i), saved, out);
}

// ---- reading a pane's screen: plain text lines out of terminal bytes ----

fn put_break(out: []u8, n: usize) -> usize {
    if (n == 0) { return 0; }
    if (out[n - 1] == 10) { return n; }
    out[n] = 10;
    return n + 1;
}

/// Plain text of terminal output: printable ASCII kept, tab a space, CR and LF one line break (no empty
/// lines), cursor moves up, down or to a position a line break, a move right a space; every other escape
/// sequence (colours, modes, titles), control byte and non-ASCII byte dropped. out needs src.len + 2 bytes.
/// The result is a rough picture of the screen's rows, enough for keys.t27 to read an error row from.
pub fn screen_text(src: []const u8, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < src.len and n + 1 < out.len) {
        const b : u8 = src[i];
        if (b == 27) {
            var j : usize = i + 1;
            if (j >= src.len) {
                i = src.len;
            } else if (src[j] == 91) {
                j = j + 1;
                while (j < src.len and (src[j] < 64 or src[j] > 126)) { j = j + 1; }
                if (j < src.len) {
                    const f : u8 = src[j];
                    if (f == 65 or f == 66 or f == 69 or f == 70 or f == 72 or f == 100 or f == 102 or f == 74) {
                        n = put_break(out, n);
                    } else if (f == 67 or f == 71) {
                        out[n] = 32;
                        n = n + 1;
                    }
                }
                i = j + 1;
            } else if (src[j] == 93) {
                j = j + 1;
                while (j < src.len and src[j] != 7 and src[j] != 27) { j = j + 1; }
                if (j < src.len and src[j] == 27) { j = j + 2; } else { j = j + 1; }
                i = j;
            } else if (src[j] >= 40 and src[j] <= 43) {
                i = j + 2;
            } else {
                i = j + 1;
            }
        } else if (b == 10 or b == 13) {
            n = put_break(out, n);
            i = i + 1;
        } else if (b == 9) {
            out[n] = 32;
            n = n + 1;
            i = i + 1;
        } else if (b >= 32 and b < 127) {
            out[n] = b;
            n = n + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return n;
}

/// The failure class of one row: keys.t27 classify_line, but only on an error row (error_row).
pub fn row_class(line: []const u8) -> u32 {
    if (error_row(line) == false) { return FC_NONE; }
    return classify_line(line);
}

/// The failure class of the rows of `text` (lines split at LF): the last row that is a failure; FC_NONE when
/// there is none (a row classed FC_OTHER is no failure to act on).
pub fn text_class(text: []const u8) -> u32 {
    var cls : u32 = FC_NONE;
    var a : usize = 0;
    var i : usize = 0;
    while (i <= text.len) {
        if (i == text.len or text[i] == 10) {
            if (i > a) {
                const c : u32 = row_class(text[a .. i]);
                if (c != FC_NONE and c != FC_OTHER) { cls = c; }
            }
            a = i + 1;
        }
        i = i + 1;
    }
    return cls;
}

/// Where the unfinished last row of `text` starts and how long it is, cut at CARRY_CAP: f[0], f[1]. The next
/// chunk is read with this row in front, so an error row split across two reads is still one row.
pub fn carry_cut(text: []const u8, f: []u64) -> void {
    var a : usize = 0;
    var i : usize = 0;
    while (i < text.len) {
        if (text[i] == 10) { a = i + 1; }
        i = i + 1;
    }
    var l : usize = text.len - a;
    if (l > CARRY_CAP) { l = CARRY_CAP; }
    f[0] = @as(u64, a);
    f[1] = @as(u64, l);
}

/// Only the claude cell is read: its error rows are the ones keys.t27 knows, and only it has profiles.
pub fn scan_applies(a: u32) -> bool {
    return profile_agent(a);
}

/// Is pane i's screen read now? Not in the first SCAN_GRACE_MS after it starts (a resumed session replays its
/// transcript) and not while a give-up is quiet.
pub fn scan_ready(st: []const u64, i: usize, born: u64, now: u64) -> bool {
    if (now < born + SCAN_GRACE_MS) { return false; }
    return now >= st[G_PANEK + i * PK + PK_STOP];
}

// ---- a restored pane waits for its keys ----
// After a server restart the panes come back from their records at once, but the window sends the keys only
// when it connects. A restored claude pane would start with the subscription variables stripped and no
// profile ("Not logged in"). So a restored pane whose agent reads a provider key waits for a key of that
// provider, or RESTORE_WAIT_MS since the server started, and then starts as it always did; a restored pane
// that started with no key is respawned once when its first key arrives.

/// Does a pane of agent a read some provider's key (the shell cell and an editor read none)?
pub fn needs_key(a: u32) -> bool {
    return spawn_mask(a, load_all_mask()) != 0;
}

/// Does the table hold a key a pane of agent a can start with? The claude cell reads the key of a profile's
/// provider (z.ai, Anthropic, OpenRouter, Ollama cloud), every other agent a provider of AGENT_PROVIDERS.
pub fn has_key_for(st: []const u64, a: u32) -> bool {
    const stored : u32 = keys_stored(st);
    if (profile_agent(a)) { return pick_profile(agent_stored(a, stored), 0) != PR_NONE; }
    return spawn_mask(a, stored) != 0;
}

/// A pane being restored waits instead of launching.
pub fn restore_waits(st: []const u64, a: u32) -> bool {
    return needs_key(a) and has_key_for(st, a) == false;
}

/// The wait ends: a key of the agent's provider arrived, or the time is up (`start` is G_START).
pub fn restore_release(st: []const u64, a: u32, now: u64, start: u64) -> bool {
    return has_key_for(st, a) or now >= start + RESTORE_WAIT_MS;
}

/// PK_WAIT of a pane that waits with launch plan `plan`, and the plan out of it (R_SKIP when not waiting).
pub fn wait_word(plan: u32) -> u64 {
    return @as(u64, plan) + 1;
}

pub fn waiting(w: u64) -> bool {
    return w >= 1 and w <= 3;
}

pub fn wait_plan(w: u64) -> u32 {
    if (waiting(w) == false) { return R_SKIP; }
    return @as(u32, @intCast(w - 1));
}

/// PK_WAIT after a deferred launch: nothing when a key was there, W_KEYLESS when the wait ran out.
pub fn after_wait(st: []const u64, a: u32) -> u64 {
    if (has_key_for(st, a)) { return W_NONE; }
    return W_KEYLESS;
}

/// A restored pane that started keyless gets its one respawn when its first key arrives.
pub fn keyless_respawn(w: u64, st: []const u64, a: u32) -> bool {
    return w == W_KEYLESS and has_key_for(st, a);
}

/// The plan of that respawn: resume when the session is known, else relaunch fresh.
pub fn keyless_plan(a: u32, sid: []const u8) -> u32 {
    const p : u32 = restore_plan(a, 0, sid);
    if (p == R_SKIP) { return R_RELAUNCH; }
    return p;
}

// ---- the server reads the Keychain itself ----
// The window pushes the keys (OP_SETKEY) only while it is connected. A pane spawned with no window (it is
// minimized, on the home screen, or a script or the Queen spawns it) would start with no key, and so would every
// pane of a server that just restarted. So the server reads the keys itself, through the same /usr/bin/security
// reader the window uses (keys_host kc_get_n): once at its start for every provider, and at a spawn that finds no
// key its agent can start with, for the providers that agent reads, at most once per KEYS_RELOAD_MS. What a read
// finds goes into the table the way an OP_SETKEY would put it. These are the decisions; the reads are in
// pty_server.t27.

/// Every provider, as a bit mask: the read at the server's start (a later spawn may be any agent).
pub fn load_all_mask() -> u32 {
    var m : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        m = m + (1 << p);
        p = p + 1;
    }
    return m;
}

/// The providers a spawn of agent a can start with, as a bit mask: for the claude cell the provider of every
/// profile (z.ai, Anthropic, OpenRouter, Ollama cloud), for every other agent the providers it reads (keys.t27
/// AGENT_PROVIDERS); 0 for the shell and editor cells and an unknown agent, which read none.
pub fn load_mask_agent(a: u32) -> u32 {
    if (a >= AGENT_COUNT) { return 0; }
    if (profile_agent(a) == false) { return spawn_mask(a, load_all_mask()); }
    var m : u32 = 0;
    var r : u32 = 0;
    while (r < PROFILE_COUNT) {
        const prov : u32 = PROFILE_PROVIDER[r];
        if (agent_profile_ok(a, r) and (m >> prov) % 2 == 0) { m = m + (1 << prov); }
        r = r + 1;
    }
    return m;
}

/// Does a read with provider mask `mask` cover provider p?
pub fn load_wants(mask: u32, p: u32) -> bool {
    return p < PROVIDER_COUNT and (mask >> p) % 2 == 1;
}

/// Is a read due for a spawn of agent a at `now` ms, `last` being G_KLOAD (0 = never read)? Only when the agent
/// reads a key, the table holds none it can start with, and no read ran in the last KEYS_RELOAD_MS.
pub fn keys_reload_due(st: []const u64, a: u32, now: u64, last: u64) -> bool {
    if (needs_key(a) == false) { return false; }
    if (has_key_for(st, a)) { return false; }
    if (last == 0) { return true; }
    return now >= last + KEYS_RELOAD_MS;
}


// ---- tests: each runs and asserts on values the decisions compute ----

test pane_alloc_takes_the_first_free_slot {
    var st : [224]u64 = undefined;
    var i : usize = 0;
    while (i < 224) {
        st[i] = 0;
        i = i + 1;
    }
    assert pane_alloc(st[0..224]) == 0;
    st[0 * PF + PF_USED] = 1;
    st[1 * PF + PF_USED] = 1;
    assert pane_alloc(st[0..224]) == 2;
    st[0 * PF + PF_USED] = 0;
    assert pane_alloc(st[0..224]) == 0;
    var k : usize = 0;
    while (k < 16) {
        st[k * PF + PF_USED] = 1;
        k = k + 1;
    }
    assert pane_alloc(st[0..224]) == 16;
}

test tv_ms_adds_seconds_and_micros {
    var b : [16]u8 = undefined;
    var i : usize = 0;
    while (i < 16) {
        b[i] = 0;
        i = i + 1;
    }
    b[0] = 10;
    b[8] = 208;
    b[9] = 7;
    assert tv_ms(b[0..16]) == 10002;
    b[8] = 63;
    b[9] = 66;
    b[10] = 15;
    assert tv_ms(b[0..16]) == 10000 + 999;
}

test pollfd_round_trips_a_big_fd {
    var b : [32]u8 = undefined;
    var i : usize = 0;
    while (i < 32) {
        b[i] = 255;
        i = i + 1;
    }
    put_pollfd(b[0..32], 1, 66051);
    assert b[8] == 3;
    assert b[9] == 2;
    assert b[10] == 1;
    assert b[11] == 0;
    assert b[12] == 1;
    assert b[13] == 0;
    assert poll_revents(b[0..32], 1) == 0;
    b[14] = 16;
    assert poll_revents(b[0..32], 1) == 16;
    assert b[7] == 255;
}

test exit_and_hook_events_pick_the_right_status {
    assert exit_event(0) == P_EXIT_OK;
    assert exit_event(256) == P_EXIT_FAIL;
    const w : u32 = pane_step(0, P_SPAWNED);
    assert ps_state(hooked_status(w, "UserPromptSubmit")) == 1;
    assert ps_state(hooked_status(w, "Notification")) == 2;
    assert hooked_status(w, "SomethingElse") == w;
    assert list_flags(true, hooked_status(w, "Notification")) == 3;
    assert list_flags(false, w) == 0;
}

test the_command_carries_the_resume_flag_and_the_hook_settings {
    var out : [200]u8 = undefined;
    const n : usize = pane_command(0, R_RESUME, "5f1c9a00-aaaa-bbbb-cccc-0123456789ab", "", "/Users/x", out[0..200]);
    var want : [200]u8 = undefined;
    const m : usize = put_bytes(want[0..200], 0, "claude --resume 5f1c9a00-aaaa-bbbb-cccc-0123456789ab --settings /Users/x/.t27os/hooks.json");
    assert n == m;
    var i : usize = 0;
    var same : bool = true;
    while (i < n) {
        if (out[i] != want[i]) { same = false; }
        i = i + 1;
    }
    assert same;
    const b : usize = pane_command(SHELL_CELL, R_RELAUNCH, "-", "opus", "/Users/x", out[0..200]);
    assert b == 9;
    assert out[5] == 98;
}

test the_argv_buffer_holds_three_strings {
    var out : [200]u8 = undefined;
    var f : [2]u64 = undefined;
    const n : usize = argv_text("codex", out[0..200], f[0..2]);
    assert out[7] == 0;
    assert f[0] == 8;
    assert out[9] == 99;
    assert out[10] == 0;
    assert f[1] == 11;
    assert out[11] == 101;
    assert out[15] == 32;
    assert out[16] == 99;
    assert out[20] == 120;
    assert out[21] == 0;
    assert n == 22;
}

/// How many times needle occurs in hay (the plist test reads its output with it).
fn pl_count(hay: []const u8, needle: []const u8) -> usize {
    var c : usize = 0;
    var i : usize = 0;
    while (i + needle.len <= hay.len) {
        var j : usize = 0;
        while (j < needle.len and hay[i + j] == needle[j]) { j = j + 1; }
        if (j == needle.len) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

test the_plist_names_the_binary_and_keeps_it_alive {
    var out : [1200]u8 = undefined;
    const n : usize = plist_text(out[0..1200], "/Users/x/.t27os/t27os-pty", "/Users/x", "/Users/x/.local/bin:/usr/bin:/bin", "en_US.UTF-8");
    assert n > 400;
    assert out[0] == 60;
    assert out[n - 1] == 10;
    assert pl_count(out[0..n], "<string>/Users/x/.t27os/t27os-pty</string>") == 1;
    assert pl_count(out[0..n], "<key>RunAtLoad</key><true/>") == 1;
    assert pl_count(out[0..n], "<key>KeepAlive</key><true/>") == 1;
    // launchd's own PATH has no ~/.local/bin: the installer's PATH goes with the agent
    assert pl_count(out[0..n], "<key>PATH</key><string>/Users/x/.local/bin:/usr/bin:/bin</string>") == 1;
    assert pl_count(out[0..n], "<key>LANG</key><string>en_US.UTF-8</string>") == 1;
    assert pl_count(out[0..n], "<key>TERM</key><string>xterm-256color</string>") == 1;
    assert pl_count(out[0..n], "<string>/Users/x/.t27os/server.log</string>") == 2;
    assert pl_count(out[0..n], "<dict>") == 2;
    assert pl_count(out[0..n], "</dict>") == 2;
    // a value that would break the XML is left out, the rest stays
    const m : usize = plist_text(out[0..1200], "/b", "/h", "/a<b", "");
    assert pl_count(out[0..m], "<key>PATH</key>") == 0;
    assert pl_count(out[0..m], "<key>LANG</key>") == 0;
    assert pl_count(out[0..m], "<key>TERM</key>") == 1;
    assert xml_ok("/usr/bin:/bin");
    assert xml_ok("a&b") == false;
    assert xml_ok("a>b") == false;
}

test the_session_start_hook_gives_the_model {
    var f : [2]u64 = undefined;
    const p : str = "{\"session_id\":\"abc-1\",\"hook_event_name\":\"SessionStart\",\"model\":\"claude-opus-5-5\"}";
    assert hook_model(p, f[0..2]);
    assert f[1] == 15;
    assert p[@as(usize, @intCast(f[0]))] == 99;
    assert hook_model("{\"session_id\":\"abc-1\"}", f[0..2]) == false;
    assert hook_model("{\"model\":\"a b\"}", f[0..2]) == false;
    // an object, not a string: nothing to save
    assert hook_model("{\"model\":{\"id\":\"opus\"}}", f[0..2]) == false;
}

test a_pane_command_keeps_its_model {
    var out : [200]u8 = undefined;
    const n : usize = pane_command(0, R_RESUME, "abc-1", "opus", "/h", out[0..200]);
    // claude --resume abc-1 --model 'opus' --settings /h/.t27os/hooks.json
    assert n == 36 + 12 + 2 + 18;
    assert pl_count(out[0..n], " --model 'opus' --settings ") == 1;
    const r : usize = pane_command(0, R_RELAUNCH, "5f1c2c6e-9a41-4f0b-8c5d-0d3e5a7b9c11", "opus", "/h", out[0..200]);
    assert pl_count(out[0..r], "claude --session-id 5f1c2c6e-9a41-4f0b-8c5d-0d3e5a7b9c11 --model 'opus' --settings ") == 1;
    // no model: the line is the one before v2
    const b : usize = pane_command(0, R_RESUME, "abc-1", "", "/h", out[0..200]);
    assert b == 21 + 12 + 2 + 18;
    assert O_MODEL + 16 * MODEL_CAP <= O_RING;
    assert O_BIN + 256 <= O_MODEL;
}

test a_spawn_payload_splits_cwd_and_model {
    assert spawn_cwd_len("abc/Users/me") == 9;
    assert spawn_cwd_len("abc/Users/me\topus") == 9;
    assert spawn_cwd_len("abc") == 0;
    assert spawn_cwd_len("abc\topus") == 0;
}


test c_path_adds_the_nul {
    var out : [20]u8 = undefined;
    out[3] = 255;
    const n : usize = c_path(out[0..20], "abc");
    assert n == 3;
    assert out[3] == 0;
    assert out[2] == 99;
}

test a_resume_that_dies_at_once_relaunches_fresh {
    assert resume_failed(R_RESUME, 1000, 2500, 256);
    assert !resume_failed(R_RESUME, 1000, 2500, 0);
    assert !resume_failed(R_RESUME, 1000, 20000, 256);
    assert !resume_failed(R_RELAUNCH, 1000, 2500, 256);
    assert !resume_failed(R_RESUME, 5000, 1000, 256);
}

test a_hooked_working_pane_that_went_silent_is_finished {
    var w : u32 = pane_step(pane_step(0, P_SPAWNED), P_HOOK_START);
    w = pane_step(w, P_HOOK_SUBMIT);
    assert !hook_stale(w, 20000, 1000);
    assert hook_stale(w, 31000, 1000);
    assert !hook_stale(pane_step(0, P_SPAWNED), 99999, 0);
    assert !hook_stale(pane_step(w, P_HOOK_STOP), 99999, 0);
}

test a_shell_spawn_that_names_a_terminal_editor_runs_it_on_the_path {
    var out : [400]u8 = undefined;
    var n : usize = launch_command(SHELL_CELL, R_RELAUNCH, "-", "vim", "/Users/x", "/Users/x/work", out[0..400]);
    assert same_bytes(out[0..n], "vim '/Users/x/work'");
    // restoring the pane from its record (R_RELAUNCH too) reopens the same file
    n = launch_command(SHELL_CELL, R_RELAUNCH, "-", "nano", "/Users/x", "/Users/x/my notes/todo.txt", out[0..400]);
    assert same_bytes(out[0..n], "nano '/Users/x/my notes/todo.txt'");
    // the pane is started through sh as `exec <cmd>`: the quoted path stays one word
    var buf : [500]u8 = undefined;
    var f : [2]u64 = undefined;
    const tn : usize = argv_text(out[0..n], buf[0..500], f[0..2]);
    assert tn == 7 + 1 + 2 + 1 + 5 + n + 1;
    assert buf[@as(usize, @intCast(f[1]))] == 101;
}

test every_other_pane_runs_the_command_it_always_did {
    var out : [400]u8 = undefined;
    // a plain shell, with a model that is not an editor name or none at all
    var n : usize = launch_command(SHELL_CELL, R_RELAUNCH, "-", "opus", "/Users/x", "/Users/x/work", out[0..400]);
    assert same_bytes(out[0..n], "/bin/bash");
    n = launch_command(SHELL_CELL, R_RELAUNCH, "-", "", "/Users/x", "/Users/x/work", out[0..400]);
    assert same_bytes(out[0..n], "/bin/bash");
    // an agent cell never becomes an editor, whatever its model field says
    n = launch_command(4, R_RELAUNCH, "-", "vim", "/Users/x", "/Users/x/work", out[0..400]);
    assert same_bytes(out[0..n], "queen");
    n = launch_command(1, R_RELAUNCH, "-", "vim", "/Users/x", "/Users/x/work", out[0..400]);
    assert same_bytes(out[0..n], "codex --model 'vim'");
    // an editor request with a quote in the path falls back to the shell; the server refuses the SPAWN first
    n = launch_command(SHELL_CELL, R_RELAUNCH, "-", "vim", "/Users/x", "/Users/x/it's", out[0..400]);
    assert same_bytes(out[0..n], "/bin/bash");
    assert wants_editor(SHELL_CELL, "vim");
    assert wants_editor(SHELL_CELL, "emacs") == false;
    assert wants_editor(SHELL_CELL, "") == false;
    assert wants_editor(0, "vim") == false;
    assert editor_spawn_ok(SHELL_CELL, "vim", "/Users/x/work");
    assert editor_spawn_ok(SHELL_CELL, "vim", "/Users/x/it's") == false;
    assert editor_spawn_ok(SHELL_CELL, "", "/Users/x/it's");
    assert editor_spawn_ok(0, "vim", "/Users/x/it's");
}

test the_editor_spawn_payload_is_the_old_wire_format {
    var p : [400]u8 = undefined;
    const n : usize = editor_spawn_payload(2, 5, 1, "/Users/x/my work", p[0..400]);
    assert n == 3 + 16 + 1 + 4;
    assert p[0] == 9 and p[1] == 2 and p[2] == 5;
    // the server parses it with the same two functions as every SPAWN
    assert spawn_ok(p[0..n]);
    const cl : usize = spawn_cwd_len(p[0..n]);
    assert cl == 16;
    assert same_bytes(p[3 .. 3 + cl], "/Users/x/my work");
    assert p[3 + cl] == 9;
    assert same_bytes(p[4 + cl .. n], "nvim");
    // and what it carries is an editor request that the server accepts
    assert editor_spawn_ok(p[0], p[4 + cl .. n], p[3 .. 3 + cl]);
    assert wants_editor(p[0], p[4 + cl .. n]);
    // the model field passes the same check as any other model, so the record keeps it
    assert model_ok(p[4 + cl .. n]);
    // refused: no such editor, a quote, a relative path
    assert editor_spawn_payload(0, 0, TERM_COUNT, "/Users/x", p[0..400]) == 0;
    assert editor_spawn_payload(0, 0, TERM_NONE, "/Users/x", p[0..400]) == 0;
    assert editor_spawn_payload(0, 0, 0, "/Users/x/it's", p[0..400]) == 0;
    assert editor_spawn_payload(0, 0, 0, "x", p[0..400]) == 0;
}

test an_editor_pane_survives_a_restart_in_its_record {
    var rec : [400]u8 = undefined;
    const n : usize = put_record(rec[0..400], 1, SHELL_CELL, 3, 0, "", "vim", "/Users/x/my work");
    var f : [10]u64 = undefined;
    assert parse_record(rec[0..n], f[0..10]);
    assert f[F_AGENT] == SHELL_CELL;
    assert f[F_MODEL_LEN] == 3;
    assert f[F_CWD_LEN] == 16;
    const at : usize = @as(usize, @intCast(f[F_MODEL_AT]));
    assert same_bytes(rec[at .. at + 3], "vim");
    // a shell pane is relaunched, not skipped, so the editor comes back on the same path
    assert restore_plan(SHELL_CELL, 0, "") == R_RELAUNCH;
    // the path limit is the pane cwd's
    assert TERM_PATH_MAX == CWD_CAP - 1;
}

// ---- tests of the key rotation. Every key here is a slot number; no test holds a key value, real or fake. ----

fn t_table(st: []u64) -> void {
    var z : usize = 0;
    while (z < ST_SIZE) {
        st[z] = 0;
        z = z + 1;
    }
    keys_init(st);
}

fn t_key(st: []u64, p: u32, k: u32) -> void {
    key_put(st, p, k, true, false);
}

/// The profile pane i has chosen (PR_NONE when it holds no real profile).
fn t_prof(st: []const u64, i: usize) -> u32 {
    return @as(u32, @intCast(st[G_PANEK + i * PK + PK_PROF]));
}

/// The table of the owner's setup, in miniature: three z.ai keys and one Anthropic key.
fn t_zai3(st: []u64) -> void {
    t_table(st);
    t_key(st, P_ZAI, 0);
    t_key(st, P_ZAI, 1);
    t_key(st, P_ZAI, 2);
    t_key(st, P_ANTHROPIC, 0);
}

test the_server_tables_and_the_arena_line_up_for_eight_keys_a_provider {
    assert KEY_SLOTS == @as(usize, PROVIDER_COUNT) * @as(usize, MAX_KEYS);
    assert G_KLAST + KEY_SLOTS <= G_KREST;
    assert G_KREST + KEY_SLOTS <= G_PANEK;
    assert G_PANEK + 16 * PK <= ST_SIZE;
    assert G_START < G_CFD;
    assert G_START > G_BINLEN;
    assert G_KLOAD > G_START;
    assert G_KLOAD < G_CFD;
    assert G_MSTEP > G_KLOAD;
    assert G_MSTEP < G_CFD;
    assert MAX_PANES <= 16;
    assert 16 * PF <= G_LISTEN;
    assert key_slot(0, 0) == O_KEYS;
    assert key_slot(4, 2) == O_KEYS + (4 * 8 + 2) * KEY_CAP;
    assert key_slot(PROVIDER_COUNT - 1, MAX_KEYS - 1) + KEY_CAP <= O_CARRY;
    assert O_CARRY + 16 * CARRY_SLOT <= O_SCAN;
    assert O_SCAN + SCAN_CAP <= MEM_SIZE;
    assert CARRY_SLOT == CARRY_CAP + 4;
    assert SCAN_CAP >= CARRY_CAP + 4096 + 2;
    assert MAX_KEYS <= 8;
}

test an_empty_table_holds_no_key_and_a_put_fills_one_slot {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    assert keys_stored(st[0..ST_SIZE]) == 0;
    assert key_count(st[0..ST_SIZE], P_ZAI) == 0;
    assert key_present(st[0..ST_SIZE], P_ZAI, 3) == false;
    t_key(st[0..ST_SIZE], P_ZAI, 3);
    assert key_present(st[0..ST_SIZE], P_ZAI, 3);
    assert key_count(st[0..ST_SIZE], P_ZAI) == 1;
    assert keys_stored(st[0..ST_SIZE]) == 16;
    t_key(st[0..ST_SIZE], P_OPENAI, 7);
    assert keys_stored(st[0..ST_SIZE]) == 18;
    key_put(st[0..ST_SIZE], P_ZAI, 3, false, false);
    assert keys_stored(st[0..ST_SIZE]) == 2;
    assert st[G_KREST + 4 * 8 + 3] == KEY_NEVER;
}

test sending_the_same_key_again_keeps_its_cooldown_and_a_new_key_starts_fresh {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    key_used(st[0..ST_SIZE], P_ZAI, 0, 777);
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 5000);
    key_put(st[0..ST_SIZE], P_ZAI, 0, true, true);
    assert st[G_KREST + 32] == 5000;
    assert st[G_KLAST + 32] == 777;
    key_put(st[0..ST_SIZE], P_ZAI, 0, true, false);
    assert st[G_KREST + 32] == 0;
    assert st[G_KLAST + 32] == 0;
    // a rest never shortens, and an empty slot never gets one
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 900);
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 400);
    assert st[G_KREST + 32] == 900;
    key_rest(st[0..ST_SIZE], P_ZAI, 1, 900);
    assert st[G_KREST + 33] == KEY_NEVER;
}

test new_claude_panes_take_the_z_ai_keys_in_rotation {
    var st : [ST_SIZE]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    var n : usize = 0;
    var want : [4]u32 = [1, 2, 3, 1];
    while (n < 4) {
        plan_pane_keys(st[0..ST_SIZE], n, 0, 1000000 + @as(u64, n) * 100);
        assert t_prof(st[0..ST_SIZE], n) == PR_ZAI;
        assert pane_key_get(st[0..ST_SIZE], n, P_ZAI) == want[n];
        assert pane_key_get(st[0..ST_SIZE], n, P_ANTHROPIC) == 0;
        assert pane_key_shown(st[0..ST_SIZE], n, 0) == want[n];
        n = n + 1;
    }
    // a key that rests is passed over
    key_rest(st[0..ST_SIZE], P_ZAI, 1, 2000);
    plan_pane_keys(st[0..ST_SIZE], 5, 0, 1000500);
    assert pane_key_get(st[0..ST_SIZE], 5, P_ZAI) == 3;
    // every key resting: the one whose rest ends first
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 3000);
    key_rest(st[0..ST_SIZE], P_ZAI, 2, 2500);
    plan_pane_keys(st[0..ST_SIZE], 6, 0, 1000600);
    assert pane_key_get(st[0..ST_SIZE], 6, P_ZAI) == 2;
}

test every_other_agent_gets_a_key_of_each_provider_it_reads {
    var st : [ST_SIZE]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_OPENAI, 0);
    t_key(st[0..ST_SIZE], P_OPENAI, 1);
    // Aider (cell 7) reads Anthropic, OpenAI, Gemini, OpenRouter: OpenRouter holds none
    plan_pane_keys(st[0..ST_SIZE], 0, 7, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ANTHROPIC) == 1;
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENAI) == 1;
    assert pane_key_get(st[0..ST_SIZE], 0, 3) == 0;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 0;
    // Codex (cell 1) reads OpenAI only, and takes the key used longest ago
    plan_pane_keys(st[0..ST_SIZE], 1, 1, 1000100);
    assert pane_key_get(st[0..ST_SIZE], 1, P_OPENAI) == 2;
    assert pane_key_get(st[0..ST_SIZE], 1, P_ANTHROPIC) == 0;
    assert pane_key_shown(st[0..ST_SIZE], 1, 1) == 2;
    // Crush (cell 5) takes the profile chain now (gHashTag/t27#11275): the z.ai profile with a z.ai key, no OpenAI one
    plan_pane_keys(st[0..ST_SIZE], 2, 5, 1000200);
    assert pane_key_get(st[0..ST_SIZE], 2, P_ZAI) > 0;
    assert pane_key_get(st[0..ST_SIZE], 2, P_OPENAI) == 0;
    assert t_prof(st[0..ST_SIZE], 2) == PR_ZAI;
    // a shell and an editor read none; an agent with no key of its provider gets nothing
    plan_pane_keys(st[0..ST_SIZE], 3, 9, 1000300);
    assert pane_key_shown(st[0..ST_SIZE], 3, 9) == 0;
    assert st[G_PANEK + 3 * PK + PK_KEYS] == 0;
    plan_pane_keys(st[0..ST_SIZE], 4, 2, 1000400);
    assert pane_key_shown(st[0..ST_SIZE], 4, 2) == 0;
    // the key numbers of one pane do not touch another's
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENAI) == 1;
}

test an_overloaded_key_swaps_to_the_next_key_rests_and_is_passed_over_by_other_panes {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    const act : u32 = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1005000, why[0..128], wl[0..2]);
    assert act == FA_RESPAWN_KEY;
    assert st[G_KREST + 32] == 1005 + 60;
    assert st[G_PANEK + PK_SKIP] == 1;
    assert st[G_PANEK + PK_DONE] == 1;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "claude: zai overloaded (529), same profile with the next key");
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1006000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 2;
    assert st[G_PANEK + PK_SKIP] == 0;
    // another pane started meanwhile does not take the resting key
    plan_pane_keys(st[0..ST_SIZE], 1, 0, 1010000);
    assert pane_key_get(st[0..ST_SIZE], 1, P_ZAI) == 3;
    // and a rate limit rests the key for thirty seconds
    const b : u32 = plan_failover(st[0..ST_SIZE], 1, FC_RATE_LIMITED, 1011000, why[0..128], wl[0..2]);
    assert b == FA_RESPAWN_KEY;
    assert st[G_KREST + 34] == 1011 + 30;
}

test when_every_z_ai_key_is_overloaded_the_pane_takes_the_next_model_then_the_next_profile_then_gives_up {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    var a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1001000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1001500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 2;
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1002000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1002500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 3;
    // the third key is overloaded too and the other two still rest: no key is left on the first model, so
    // the pane takes the second model of the tier, and every key is free again for it
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1003000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_MODEL;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    assert st[G_PANEK + PK_BAD] == 0;
    assert st[G_KREST + 32] == 0 and st[G_KREST + 33] == 0 and st[G_KREST + 34] == 0;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "zai overloaded (529), every key tried, same profile on the next model");
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1003500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    // the same walk over the keys on the second model
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1004000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1004500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 2;
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1005000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1005500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 3;
    // every key failed on the last model of the tier: next profile, z.ai marked bad, the model step is 0 again
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1006000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    assert st[G_PANEK + PK_BAD] == 16;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "zai overloaded (529), respawn on anthropic-api");
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1006500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ANTHROPIC) == 1;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 0;
    // the Anthropic key is overloaded: no profile is left, the pane stays and its screen is not read for a minute
    a = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1007000, why[0..128], wl[0..2]);
    assert a == FA_GIVE_UP;
    assert st[G_PANEK + PK_DONE] == 6;
    assert st[G_PANEK + PK_STOP] == 1007000 + GIVEUP_QUIET_MS;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "no profile left in the chain");
    assert scan_ready(st[0..ST_SIZE], 0, 1006500, 1020000) == false;
    assert scan_ready(st[0..ST_SIZE], 0, 1006500, 1067001);
}

test an_empty_balance_swaps_to_the_next_key_and_the_key_rests_ten_minutes {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    const a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1005000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    assert st[G_KREST + 32] == 1005 + 600;
    assert st[G_PANEK + PK_BAD] == 0;
    assert st[G_PANEK + PK_SKIP] == 1;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "zai out of balance, same profile with the next key");
    // the failure cap ends any loop
    st[G_PANEK + PK_DONE] = @as(u64, MAX_FAILOVERS);
    const g : u32 = plan_failover(st[0..ST_SIZE], 0, FC_OVERLOADED, 1006000, why[0..128], wl[0..2]);
    assert g == FA_GIVE_UP;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "failover limit reached");
}

test a_pane_that_started_without_a_key_takes_the_first_stored_profile_on_a_subscription_row {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_NONE;
    assert pane_key_shown(st[0..ST_SIZE], 0, 0) == 0;
    // nothing stored: nothing to move to
    assert plan_failover(st[0..ST_SIZE], 0, FC_SUBSCRIPTION, 1001000, why[0..128], wl[0..2]) == FA_GIVE_UP;
    // the window's keys arrive; the pane asks again after its quiet time
    t_key(st[0..ST_SIZE], P_ZAI, 4);
    st[G_PANEK + PK_STOP] = 0;
    const a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_SUBSCRIPTION, 1002000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "no profile subscription disabled, respawn on zai");
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1003000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 5;
}

test a_new_spawn_starts_with_a_clean_pane_record {
    var st : [ST_SIZE]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 2, 0, 1000000);
    st[G_PANEK + 2 * PK + PK_DONE] = 5;
    st[G_PANEK + 2 * PK + PK_BAD] = 16;
    pane_keys_reset(st[0..ST_SIZE], 2);
    assert st[G_PANEK + 2 * PK + PK_DONE] == 0;
    assert st[G_PANEK + 2 * PK + PK_BAD] == 0;
    assert st[G_PANEK + 2 * PK + PK_PROF] == PK_UNSET;
    assert st[G_PANEK + 2 * PK + PK_KEYS] == 0;
    assert st[G_PANEK + 2 * PK + PK_WAIT] == W_NONE;
    plan_pane_keys(st[0..ST_SIZE], 2, 0, 1000100);
    assert t_prof(st[0..ST_SIZE], 2) == PR_ZAI;
}

test the_model_step_of_a_pane_is_its_own_nibble_and_a_reset_pane_starts_on_the_default_model {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    assert st[G_MSTEP] == 0;
    pane_mstep_set(st[0..ST_SIZE], 0, 1);
    pane_mstep_set(st[0..ST_SIZE], 15, 1);
    pane_mstep_set(st[0..ST_SIZE], 3, 2);
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    assert pane_mstep_get(st[0..ST_SIZE], 15) == 1;
    assert pane_mstep_get(st[0..ST_SIZE], 3) == 2;
    assert pane_mstep_get(st[0..ST_SIZE], 7) == 0;
    pane_mstep_set(st[0..ST_SIZE], 3, 0);
    assert pane_mstep_get(st[0..ST_SIZE], 3) == 0;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    // a new spawn and a restored pane both start from pane_keys_reset: the default model of the tier
    pane_keys_reset(st[0..ST_SIZE], 0);
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    assert pane_mstep_get(st[0..ST_SIZE], 15) == 1;
    keys_init(st[0..ST_SIZE]);
    assert pane_mstep_get(st[0..ST_SIZE], 15) == 0;
    assert st[G_MSTEP] == 0;
}

// ---- a restored pane (gHashTag/t27#11284): its record held key 1 and the model glm-5.2, and every key answers
// 1113 for glm-5.2. It must start as a fresh spawn would (the free flash model, the key rotation's pick) and
// fail over exactly as a spawned pane does. restore_all leaves a pane in the state pane_keys_reset gives it,
// with the sid and cwd of the record and the saved model in its slot; these tests start there.

/// Pane i the way restore_all leaves it just before its launch: nothing chosen yet.
fn t_restored(st: []u64, i: usize) -> void {
    pane_keys_reset(st, i);
}

test a_restored_pane_takes_the_key_a_fresh_spawn_would_take_not_the_one_its_record_held {
    var st : [ST_SIZE]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    // key 1 earned a rest, key 3 was used lately: the key used longest ago and not resting is key 2
    st[G_KREST + 32] = 1000 + 600;
    st[G_KLAST + 32] = 900000;
    st[G_KLAST + 33] = 100;
    st[G_KLAST + 34] = 500000;
    const fresh : u32 = key_pick(st[0..ST_SIZE], P_ZAI, MAX_KEYS, 1000000);
    assert fresh == 1;
    t_restored(st[0..ST_SIZE], 3);
    plan_pane_keys(st[0..ST_SIZE], 3, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 3) == PR_ZAI;
    assert pane_key_get(st[0..ST_SIZE], 3, P_ZAI) == fresh + 1;
    assert pane_key_get(st[0..ST_SIZE], 3, P_ZAI) == 2;
    assert st[G_KLAST + 33] == 1000000;
    // with no key in the table at all a restored pane has none, as a spawned one
    var empty : [ST_SIZE]u64 = undefined;
    t_table(empty[0..ST_SIZE]);
    t_restored(empty[0..ST_SIZE], 0);
    plan_pane_keys(empty[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(empty[0..ST_SIZE], 0) == PR_NONE;
}

test a_restored_pane_resumes_its_session_on_the_free_flash_model_not_the_one_its_record_held {
    var st : [ST_SIZE]u64 = undefined;
    var o : [64]u8 = undefined;
    var cmd : [200]u8 = undefined;
    t_zai3(st[0..ST_SIZE]);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    // the record said glm-5.2; the model the pane starts with is the free flash tier's default
    const n : usize = launch_model(st[0..ST_SIZE], 0, 0, false, "glm-5.2", o[0..64]);
    assert n == 13;
    assert has_bytes(o[0..n], "glm-4.5-flash");
    assert has_bytes(o[0..n], "glm-5.2") == false;
    // the session id of the record still resumes; the command names the free model and never the stale one
    const c : usize = pane_command(0, R_RESUME, "5f1c9a00-aaaa-bbbb-cccc-0123456789ab", o[0..n], "/h", cmd[0..200]);
    assert pl_count(cmd[0..c], "claude --resume 5f1c9a00-aaaa-bbbb-cccc-0123456789ab --model 'glm-4.5-flash' --settings /h/.t27os/hooks.json") == 1;
    assert has_bytes(cmd[0..c], "glm-5.2") == false;
    // a fresh spawn of the same agent computes the same default: the environment's model variable
    t_restored(st[0..ST_SIZE], 1);
    plan_pane_keys(st[0..ST_SIZE], 1, 0, 1000100);
    const f : usize = tier_model_step(PR_ZAI, TI_DEFAULT, pane_mstep_get(st[0..ST_SIZE], 1), o[0..64]);
    assert f == 13;
    assert has_bytes(o[0..f], "glm-4.5-flash");
    const e : usize = profile_var_text_step(PR_ZAI, 2, pane_mstep_get(st[0..ST_SIZE], 1), o[0..64]);
    assert e == 13 and has_bytes(o[0..e], "glm-4.5-flash");
    // its first start passes no model of its own on the command line
    assert launch_model(st[0..ST_SIZE], 1, 0, true, "", o[0..64]) == 0;
    // one a SPAWN names on purpose stays on that first start
    const x : usize = launch_model(st[0..ST_SIZE], 1, 0, true, "glm-4.7-flash", o[0..64]);
    assert x == 13 and has_bytes(o[0..x], "glm-4.7-flash");
    // but a restart of that pane is a restore: the profile's model again
    const r : usize = launch_model(st[0..ST_SIZE], 1, 0, false, "glm-4.7-flash", o[0..64]);
    assert r == 13 and has_bytes(o[0..r], "glm-4.5-flash");
    // another agent has no profile: its saved model stays
    const g : usize = launch_model(st[0..ST_SIZE], 2, 1, false, "gpt-5.1", o[0..64]);
    assert g == 7 and has_bytes(o[0..g], "gpt-5.1");
}

test a_pane_that_fails_over_to_another_profile_does_not_carry_the_model_of_the_one_it_left {
    var st : [ST_SIZE]u64 = undefined;
    var o : [64]u8 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_key(st[0..ST_SIZE], P_ANTHROPIC, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    // the only z.ai key is empty: the second model of the tier first, then the next profile
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1001000, why[0..128], wl[0..2]) == FA_RESPAWN_MODEL;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1001500);
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1002000, why[0..128], wl[0..2]) == FA_RESPAWN_NEXT;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1002500);
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    // the pane's slot still says glm-4.7-flash; the Anthropic API does not serve it, so no model is passed
    assert launch_model(st[0..ST_SIZE], 0, 0, false, "glm-4.7-flash", o[0..64]) == 0;
    // a model of Anthropic's own that a person chose is kept
    const n : usize = launch_model(st[0..ST_SIZE], 0, 0, false, "claude-opus-5-5", o[0..64]);
    assert n == 15 and has_bytes(o[0..n], "claude-opus-5-5");
}

test a_restored_pane_fails_over_on_an_empty_or_rejected_key_like_a_spawned_one {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    // a restored claude pane's screen is read once its grace has passed, like any other pane's
    assert scan_applies(0);
    assert scan_ready(st[0..ST_SIZE], 0, 1000000, 1000000 + SCAN_GRACE_MS - 1) == false;
    assert scan_ready(st[0..ST_SIZE], 0, 1000000, 1000000 + SCAN_GRACE_MS);
    // an empty account: the key rests ten minutes and the pane respawns on the next key, the failed one skipped
    var a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1020000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    assert st[G_KREST + 32] == 1020 + 600;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert st[G_PANEK + PK_DONE] == 1;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "claude: zai out of balance, same profile with the next key");
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1021000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 2;
    // a rejected key rests an hour and the pane moves on to the third key
    a = plan_failover(st[0..ST_SIZE], 0, FC_LOGIN_REJECTED, 1030000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_KEY;
    assert st[G_KREST + 33] == 1030 + 3600;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1031000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 3;
    // neither resting key is picked by the next pane that starts
    t_restored(st[0..ST_SIZE], 1);
    plan_pane_keys(st[0..ST_SIZE], 1, 0, 1032000);
    assert pane_key_get(st[0..ST_SIZE], 1, P_ZAI) == 3;
}

test the_retry_row_of_an_empty_account_is_a_failure_at_once_so_a_stuck_pane_fails_over {
    var t : [300]u8 = undefined;
    // what the owner saw: HTTP 429 with code 1113, Claude Code's retry row, attempt 9 of 10
    var n : usize = put_bytes(t[0..300], 0, "API Error: 429 {\"error\":{\"code\":\"1113\",\"message\":\"Insufficient balance or no resource package. Please recharge.\"}} - Retrying in 4 seconds (attempt 9/10)");
    t[n] = 10;
    assert text_class(t[0 .. n + 1]) == FC_NO_BALANCE;
    // a plain throttle in flight still waits for its final row
    n = put_bytes(t[0..300], 0, "API Error: 429 rate limit reached - Retrying in 4 seconds (attempt 3/10)");
    t[n] = 10;
    assert text_class(t[0 .. n + 1]) == FC_NONE;
    // a diff that shows the row is no failure
    n = put_bytes(t[0..300], 0, "+ API Error: 429 1113 Insufficient balance - Retrying in 4 seconds (attempt 9/10)");
    t[n] = 10;
    assert text_class(t[0 .. n + 1]) == FC_NONE;
}

test with_one_key_an_empty_pane_tries_the_next_model_once_then_gives_up_and_says_so_once {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    var o : [64]u8 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    // the only key is empty on the default model: nothing to swap to, so the second model of the tier
    var a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1020000, why[0..128], wl[0..2]);
    assert a == FA_RESPAWN_MODEL;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1021000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    const n : usize = launch_model(st[0..ST_SIZE], 0, 0, false, "glm-4.5-flash", o[0..64]);
    assert n == 13 and has_bytes(o[0..n], "glm-4.7-flash");
    // empty on the second model too: no key, no model and no profile left, the pane stays
    a = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1040000, why[0..128], wl[0..2]);
    assert a == FA_GIVE_UP;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "claude: zai out of balance, no profile left in the chain, the pane stays");
    assert st[G_PANEK + PK_DONE] == 1;
    // the give-up is said once: the screen is not read again until the key's rest is over
    assert st[G_PANEK + PK_STOP] == 1040000 + 600000;
    assert scan_ready(st[0..ST_SIZE], 0, 1021000, 1100000) == false;
    assert scan_ready(st[0..ST_SIZE], 0, 1021000, 1639999) == false;
    assert scan_ready(st[0..ST_SIZE], 0, 1021000, 1640000);
    assert giveup_quiet_ms(FC_NO_BALANCE) == 600000;
    assert giveup_quiet_ms(FC_LOGIN_REJECTED) == 3600000;
    assert giveup_quiet_ms(FC_RATE_LIMITED) == GIVEUP_QUIET_MS;
    assert giveup_quiet_ms(FC_SUBSCRIPTION) == GIVEUP_QUIET_MS;
}

test every_key_resting_for_an_empty_balance_moves_the_pane_on_and_no_dead_key_is_picked_twice_per_model {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_zai3(st[0..ST_SIZE]);
    t_restored(st[0..ST_SIZE], 0);
    var t : u64 = 1000000;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, t);
    var seen : [2]u32 = [1, 0];
    var respawns : u32 = 0;
    var act : u32 = FA_KEEP;
    var guard : u32 = 0;
    var gave_up : bool = false;
    while (guard < 30 and gave_up == false) {
        t = t + 1000;
        act = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, t, why[0..128], wl[0..2]);
        if (act == FA_GIVE_UP) {
            gave_up = true;
        } else {
            respawns = respawns + 1;
            t = t + 500;
            plan_pane_keys(st[0..ST_SIZE], 0, 0, t);
            if (t_prof(st[0..ST_SIZE], 0) == PR_ZAI) {
                const kn : u32 = pane_key_get(st[0..ST_SIZE], 0, P_ZAI) - 1;
                const sp : usize = @as(usize, pane_mstep_get(st[0..ST_SIZE], 0));
                // each z.ai key is tried once on each model of the tier, never twice on the same one
                assert (seen[sp] >> kn) % 2 == 0;
                seen[sp] = seen[sp] + (1 << kn);
            }
        }
        guard = guard + 1;
    }
    // three keys on glm-4.5-flash, then the same three on glm-4.7-flash, then the Anthropic key, then done
    assert gave_up;
    assert seen[0] == 7;
    assert seen[1] == 7;
    assert respawns == 6;
    assert st[G_PANEK + PK_DONE] == 6;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ANTHROPIC) == 1;
    assert st[G_PANEK + PK_BAD] == 16;
    assert st[G_PANEK + PK_STOP] == t + 600000;
}

// ---- the tier order on a pane: z.ai free, then OpenRouter's free ids, then the paid profiles (gHashTag/t27#11285) ----

/// The table with a key for every tier of the chain: three z.ai keys, one OpenRouter key, one Anthropic key.
fn t_chain(st: []u64) -> void {
    t_zai3(st);
    t_key(st, P_OPENROUTER, 0);
}

/// One failure of class `class` on pane 0 at `t` ms: the failover, then the relaunch's key and profile choice
/// half a second later unless the pane gave up. Returns the action.
fn t_fail(st: []u64, class: u32, t: u64) -> u32 {
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    const a : u32 = plan_failover(st, 0, class, t, why[0..128], wl[0..2]);
    if (a != FA_GIVE_UP) { plan_pane_keys(st, 0, 0, t + 500); }
    return a;
}

test when_every_zai_key_rests_the_pane_moves_to_openrouters_free_ids_and_then_to_the_paid_profile {
    var st : [ST_SIZE]u64 = undefined;
    var o : [64]u8 = undefined;
    t_chain(st[0..ST_SIZE]);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    // tier 1, z.ai: three keys on glm-4.5-flash, then the same three on glm-4.7-flash, every one overloaded
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1001000) == FA_RESPAWN_KEY;
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1002000) == FA_RESPAWN_KEY;
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1003000) == FA_RESPAWN_MODEL;
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1004000) == FA_RESPAWN_KEY;
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1005000) == FA_RESPAWN_KEY;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    // the last z.ai key on the last model: tier 2, OpenRouter, on its first free id with its own key
    assert t_fail(st[0..ST_SIZE], FC_OVERLOADED, 1006000) == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENROUTER) == 1;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 0;
    assert st[G_PANEK + PK_BAD] == 16;
    var n : usize = launch_model(st[0..ST_SIZE], 0, 0, false, "glm-4.7-flash", o[0..64]);
    assert n == 31 and begins_with(o[0..n], "minimax/minimax-m3.1-flash:free");
    // the environment the pane gets: ANTHROPIC_MODEL (variable 2 of the profile) names the same id
    n = profile_var_text_step(PR_OPENROUTER, 2, pane_mstep_get(st[0..ST_SIZE], 0), o[0..64]);
    assert n == 31 and begins_with(o[0..n], "minimax/minimax-m3.1-flash:free");
    // the only OpenRouter key is throttled: its second and third free id, the key free again for each
    assert t_fail(st[0..ST_SIZE], FC_RATE_LIMITED, 1007000) == FA_RESPAWN_MODEL;
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENROUTER) == 1;
    n = launch_model(st[0..ST_SIZE], 0, 0, false, "minimax/minimax-m3.1-flash:free", o[0..64]);
    assert n == 33 and begins_with(o[0..n], "nvidia/nemotron-3.5-super-vl:free");
    // both free tiers rest: only now the paid profile, whose model is not an OpenRouter id
    assert t_fail(st[0..ST_SIZE], FC_RATE_LIMITED, 1009000) == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ANTHROPIC) == 1;
    assert st[G_PANEK + PK_BAD] == 24;
    assert st[G_PANEK + PK_DONE] == 8;
    assert launch_model(st[0..ST_SIZE], 0, 0, false, "nvidia/nemotron-3.5-super-vl:free", o[0..64]) == 0;
    // the paid key fails too: no tier is left and the pane says so once
    assert t_fail(st[0..ST_SIZE], FC_RATE_LIMITED, 1010000) == FA_GIVE_UP;
    assert st[G_PANEK + PK_DONE] == 8;
    assert st[G_PANEK + PK_STOP] == 1010000 + GIVEUP_QUIET_MS;
}

test with_no_openrouter_key_stored_the_pane_skips_that_tier_to_the_paid_profile_or_the_give_up_line {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    // z.ai and Anthropic keys, none of OpenRouter: the tier in the middle costs nothing
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_key(st[0..ST_SIZE], P_ANTHROPIC, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_fail(st[0..ST_SIZE], FC_NO_BALANCE, 1001000) == FA_RESPAWN_MODEL;
    assert t_fail(st[0..ST_SIZE], FC_NO_BALANCE, 1002000) == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENROUTER) == 0;
    assert st[G_PANEK + PK_BAD] == 16;
    assert st[G_PANEK + PK_DONE] == 2;
    // z.ai alone: nothing after it, the give-up line, no loop
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_fail(st[0..ST_SIZE], FC_NO_BALANCE, 1001000) == FA_RESPAWN_MODEL;
    const a : u32 = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1002000, why[0..128], wl[0..2]);
    assert a == FA_GIVE_UP;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "claude: zai out of balance, no profile left in the chain, the pane stays");
    assert st[G_PANEK + PK_DONE] == 1;
    // the same pane once an OpenRouter key arrives (an OP_SETKEY) and its quiet time has passed: the free tier is offered
    t_key(st[0..ST_SIZE], P_OPENROUTER, 0);
    st[G_PANEK + PK_STOP] = 0;
    const b : u32 = plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1003000, why[0..128], wl[0..2]);
    assert b == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert has_bytes(why[0 .. @as(usize, @intCast(wl[0]))], "claude: zai out of balance, respawn on openrouter");
    // an OpenRouter key alone ends in the give-up line after its three ids
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_OPENROUTER, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert t_fail(st[0..ST_SIZE], FC_NO_BALANCE, 1001000) == FA_RESPAWN_MODEL;
    assert t_fail(st[0..ST_SIZE], FC_NO_BALANCE, 1003000) == FA_GIVE_UP;
    assert st[G_PANEK + PK_DONE] == 1;
}

test a_pane_on_openrouter_names_the_free_id_on_its_command_line_and_in_its_environment {
    var st : [ST_SIZE]u64 = undefined;
    var o : [64]u8 = undefined;
    var cmd : [200]u8 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_OPENROUTER, 0);
    t_restored(st[0..ST_SIZE], 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENROUTER) == 1;
    const n : usize = launch_model(st[0..ST_SIZE], 0, 0, false, "glm-5.2", o[0..64]);
    assert n == 31 and begins_with(o[0..n], "minimax/minimax-m3.1-flash:free");
    // the id keeps its slash and its colon on the command line (session_store model_ok), so the flag is not dropped
    const c : usize = pane_command(0, R_RESUME, "5f1c9a00-aaaa-bbbb-cccc-0123456789ab", o[0..n], "/h", cmd[0..200]);
    assert pl_count(cmd[0..c], "claude --resume 5f1c9a00-aaaa-bbbb-cccc-0123456789ab --model 'minimax/minimax-m3.1-flash:free' --settings /h/.t27os/hooks.json") == 1;
    // a SPAWN's first start passes no model of its own
    assert launch_model(st[0..ST_SIZE], 0, 0, true, "", o[0..64]) == 0;
}

test a_list_entry_carries_the_key_number_in_the_high_nibble {
    const w : u32 = pane_step(0, P_SPAWNED);
    assert list_flags_key(true, w, 0) == list_flags(true, w);
    assert list_flags_key(true, w, 3) % 16 == list_flags(true, w);
    assert list_flags_key(true, w, 3) / 16 == 3;
    assert list_flags_key(false, w, MAX_KEYS) / 16 == MAX_KEYS;
    assert list_flags_key(true, hooked_status(w, "Notification"), MAX_KEYS) < 256;
    // a client that reads bit 0, 1 or 2 only sees the old byte
    assert list_flags_key(true, hooked_status(w, "Notification"), 5) % 2 == 1;
}

test terminal_bytes_become_plain_rows {
    var s : [200]u8 = undefined;
    var o : [210]u8 = undefined;
    var n : usize = put_bytes(s[0..200], 0, "ab");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "[31;1mAPI Error: 529");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "[0m");
    s[n] = 13;
    s[n + 1] = 10;
    n = put_bytes(s[0..200], n + 2, "next");
    var t : usize = screen_text(s[0..n], o[0..210]);
    assert same_bytes(o[0..t], "abAPI Error: 529\nnext");
    // a cursor move up or to a position is a line break, one to the right a space
    n = put_bytes(s[0..200], 0, "one");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "[2K");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "[1Atwo");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "[3Cx");
    t = screen_text(s[0..n], o[0..210]);
    assert same_bytes(o[0..t], "one\ntwo x");
    // a title (OSC) up to BEL, a charset switch, a tab, a bare ESC at the end, bytes above 127
    n = put_bytes(s[0..200], 0, "a");
    s[n] = 27;
    n = put_bytes(s[0..200], n + 1, "]0;title");
    s[n] = 7;
    s[n + 1] = 27;
    n = put_bytes(s[0..200], n + 2, "(Bb");
    s[n] = 9;
    s[n + 1] = 200;
    s[n + 2] = 99;
    s[n + 3] = 27;
    t = screen_text(s[0..n + 4], o[0..210]);
    assert same_bytes(o[0..t], "ab c");
    assert screen_text("", o[0..210]) == 0;
    // the output never runs past its room
    assert screen_text("abcdefgh", o[0..5]) == 4;
    // empty lines collapse and a leading break is dropped
    t = screen_text("\n\nx\n\ny", o[0..210]);
    assert same_bytes(o[0..t], "x\ny");
}

test only_an_error_row_on_the_screen_names_a_failure {
    assert text_class("API Error: 529 {\"error\":{\"code\":\"1305\"}}") == FC_OVERLOADED;
    assert text_class("reading\nAPI Error: 429 Insufficient balance\nprompt") == FC_NO_BALANCE;
    assert text_class("API Error: 401 bad key\nAPI Error: 529 busy") == FC_OVERLOADED;
    // a diff or a quotation that shows the phrases is not a failure
    assert text_class("+    assert classify_line(\"API Error: 429 Insufficient balance\") == FC_NO_BALANCE;") == FC_NONE;
    assert text_class("the log said API Error: 529\nok") == FC_NONE;
    // Claude Code's own retry is not final
    assert text_class("API Error (529 overloaded_error) Retrying in 4 seconds") == FC_NONE;
    assert text_class("API Error: 500 upstream failure") == FC_NONE;
    assert text_class("") == FC_NONE;
    assert text_class("\n\n") == FC_NONE;
    assert row_class("  Error: 403 forbidden") == FC_LOGIN_REJECTED;
}

test an_error_row_split_across_two_reads_is_still_one_row {
    var o : [300]u8 = undefined;
    var c : [300]u8 = undefined;
    var f : [2]u64 = undefined;
    // read 1 ends in the middle of the row; its unfinished row is carried
    var t : usize = screen_text("Working...\nAPI Err", o[0..300]);
    assert text_class(o[0..t]) == FC_NONE;
    carry_cut(o[0..t], f[0..2]);
    assert f[0] == 11;
    assert f[1] == 7;
    var cl : usize = put_bytes(c[0..300], 0, o[@as(usize, @intCast(f[0])) .. @as(usize, @intCast(f[0])) + @as(usize, @intCast(f[1]))]);
    // read 2 finishes it
    const t2 : usize = screen_text("or: 529 overloaded\n", o[0..300]);
    cl = put_bytes(c[0..300], cl, o[0..t2]);
    assert text_class(c[0..cl]) == FC_OVERLOADED;
    // a long unfinished row is cut at the carry limit; a finished last row carries nothing
    var big : [200]u8 = undefined;
    var i : usize = 0;
    while (i < 200) {
        big[i] = 97;
        i = i + 1;
    }
    carry_cut(big[0..200], f[0..2]);
    assert f[0] == 0;
    assert f[1] == CARRY_CAP;
    carry_cut("abc\n", f[0..2]);
    assert f[0] == 4;
    assert f[1] == 0;
}

test a_pane_screen_is_not_read_in_its_first_seconds_nor_while_a_give_up_is_quiet {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    assert scan_ready(st[0..ST_SIZE], 1, 1000, 5000) == false;
    assert scan_ready(st[0..ST_SIZE], 1, 1000, 11000);
    st[G_PANEK + PK + PK_STOP] = 70000;
    assert scan_ready(st[0..ST_SIZE], 1, 1000, 60000) == false;
    assert scan_ready(st[0..ST_SIZE], 1, 1000, 70000);
    assert scan_applies(0);
    assert scan_applies(1) == false;
    assert scan_applies(SHELL_CELL) == false;
}

test a_restored_pane_waits_for_a_key_of_its_provider_and_then_starts_with_it {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    // the window has not connected: claude, codex, queen wait; a shell and an editor do not
    assert needs_key(0);
    assert needs_key(1);
    assert needs_key(4);
    assert needs_key(SHELL_CELL) == false;
    assert restore_waits(st[0..ST_SIZE], 0);
    assert restore_waits(st[0..ST_SIZE], 1);
    assert restore_waits(st[0..ST_SIZE], SHELL_CELL) == false;
    assert wait_plan(wait_word(R_RESUME)) == R_RESUME;
    assert wait_plan(wait_word(R_RELAUNCH)) == R_RELAUNCH;
    assert waiting(wait_word(R_RESUME)) and waiting(wait_word(R_RELAUNCH));
    assert waiting(W_NONE) == false;
    assert waiting(W_KEYLESS) == false;
    assert waiting(W_DONE) == false;
    assert wait_plan(W_NONE) == R_SKIP;
    // 2 s after the server started, still nothing
    assert restore_release(st[0..ST_SIZE], 0, 1002000, 1000000) == false;
    // an OpenAI key arrives: claude reads no OpenAI key, codex does
    t_key(st[0..ST_SIZE], P_OPENAI, 0);
    assert restore_release(st[0..ST_SIZE], 0, 1003000, 1000000) == false;
    assert restore_release(st[0..ST_SIZE], 1, 1003000, 1000000);
    // a z.ai key arrives: claude's profile has a provider now, and the pane starts on it
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    assert restore_release(st[0..ST_SIZE], 0, 1003500, 1000000);
    assert after_wait(st[0..ST_SIZE], 0) == W_NONE;
    plan_pane_keys(st[0..ST_SIZE], 3, 0, 1003600);
    assert t_prof(st[0..ST_SIZE], 3) == PR_ZAI;
    assert pane_key_get(st[0..ST_SIZE], 3, P_ZAI) == 1;
}

test a_restored_pane_whose_wait_runs_out_starts_keyless_and_is_respawned_once_when_a_key_arrives {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    assert restore_release(st[0..ST_SIZE], 0, 1019999, 1000000) == false;
    assert restore_release(st[0..ST_SIZE], 0, 1020000, 1000000);
    assert after_wait(st[0..ST_SIZE], 0) == W_KEYLESS;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1020100);
    assert t_prof(st[0..ST_SIZE], 0) == PR_NONE;
    st[G_PANEK + PK_WAIT] = W_KEYLESS;
    // still no key: no respawn
    assert keyless_respawn(st[G_PANEK + PK_WAIT], st[0..ST_SIZE], 0) == false;
    // the first key arrives
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    assert keyless_respawn(st[G_PANEK + PK_WAIT], st[0..ST_SIZE], 0);
    // the respawn: the pane takes the profile and the key, and the one respawn is spent
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1030000);
    st[G_PANEK + PK_WAIT] = W_DONE;
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert pane_key_shown(st[0..ST_SIZE], 0, 0) == 1;
    assert keyless_respawn(st[G_PANEK + PK_WAIT], st[0..ST_SIZE], 0) == false;
    assert keyless_respawn(W_NONE, st[0..ST_SIZE], 0) == false;
    // resume when the session is known, else a fresh start
    assert keyless_plan(0, "5f1c9a00-aaaa-bbbb-cccc-0123456789ab") == R_RESUME;
    assert keyless_plan(0, "-") == R_RELAUNCH;
    assert keyless_plan(0, "") == R_RELAUNCH;
}

test the_server_reads_the_providers_a_spawn_can_start_with {
    // at its start the server reads every provider: bits 0 to 9 (nvidia made it ten, #12774)
    assert load_all_mask() == 1023;
    // the claude cell starts on a profile: z.ai (4), Anthropic (0), OpenRouter (3), Ollama cloud (5)
    assert load_mask_agent(0) == 57;
    assert load_wants(load_mask_agent(0), P_ZAI);
    assert load_wants(load_mask_agent(0), P_ANTHROPIC);
    assert load_wants(load_mask_agent(0), P_OPENAI) == false;
    // every other agent reads the providers keys.t27 AGENT_PROVIDERS names
    assert load_mask_agent(1) == 2;
    assert load_mask_agent(2) == 4;
    assert load_mask_agent(3) == 25;
    assert load_mask_agent(4) == 1;
    assert load_mask_agent(5) == 25;
    assert load_mask_agent(6) == 128;
    assert load_mask_agent(7) == 15;
    assert load_mask_agent(8) == 64;
    // the shell and editor cells read no key; an unknown agent none either
    assert load_mask_agent(SHELL_CELL) == 0;
    assert load_mask_agent(AGENT_COUNT + 3) == 0;
    // a provider past the last one is never wanted
    assert load_wants(1023, PROVIDER_COUNT - 1);
    assert load_wants(1023, PROVIDER_COUNT) == false;
    assert load_wants(0, 0) == false;
}

test a_spawn_that_finds_no_key_reads_the_keychain_again_after_a_minute {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    // nothing was read yet: due at once
    assert keys_reload_due(st[0..ST_SIZE], 0, 5000, 0);
    // read 10 s ago and still no key: not yet; due exactly KEYS_RELOAD_MS after the read
    assert KEYS_RELOAD_MS == 60000;
    assert keys_reload_due(st[0..ST_SIZE], 0, 1010000, 1000000) == false;
    assert keys_reload_due(st[0..ST_SIZE], 0, 1059999, 1000000) == false;
    assert keys_reload_due(st[0..ST_SIZE], 0, 1060000, 1000000);
    // a shell or an editor reads no key: never due
    assert keys_reload_due(st[0..ST_SIZE], SHELL_CELL, 1060000, 1000000) == false;
    assert keys_reload_due(st[0..ST_SIZE], SHELL_CELL, 5000, 0) == false;
    // a z.ai key is a key the claude cell starts with: nothing to look for
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    assert keys_reload_due(st[0..ST_SIZE], 0, 1060000, 1000000) == false;
    assert keys_reload_due(st[0..ST_SIZE], 0, 5000, 0) == false;
    // codex reads OpenAI only: the z.ai key is no use to it, so a read is due for it
    assert keys_reload_due(st[0..ST_SIZE], 1, 1060000, 1000000);
    assert keys_reload_due(st[0..ST_SIZE], 1, 1010000, 1000000) == false;
    t_key(st[0..ST_SIZE], P_OPENAI, 0);
    assert keys_reload_due(st[0..ST_SIZE], 1, 1060000, 1000000) == false;
}

test a_read_of_the_keychain_fills_the_table_like_a_window_push {
    // the server's read goes through key_put exactly as OP_SETKEY does: the claude cell has a profile after it
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    assert has_key_for(st[0..ST_SIZE], 0) == false;
    assert restore_waits(st[0..ST_SIZE], 0);
    key_put(st[0..ST_SIZE], P_ZAI, 0, true, false);
    key_put(st[0..ST_SIZE], P_ZAI, 1, true, false);
    assert has_key_for(st[0..ST_SIZE], 0);
    assert restore_waits(st[0..ST_SIZE], 0) == false;
    plan_pane_keys(st[0..ST_SIZE], 5, 0, 1000000);
    assert t_prof(st[0..ST_SIZE], 5) == PR_ZAI;
    assert pane_key_shown(st[0..ST_SIZE], 5, 0) == 1;
    // the window pushes the same keys a moment later: nothing changes, the key just used keeps its time
    key_put(st[0..ST_SIZE], P_ZAI, 0, true, true);
    assert st[G_KLAST + key_index(P_ZAI, 0)] == 1000000;
    // a key that came from a terminal later is one more slot
    assert key_count(st[0..ST_SIZE], P_ZAI) == 2;
    key_put(st[0..ST_SIZE], P_ZAI, 2, true, false);
    assert key_count(st[0..ST_SIZE], P_ZAI) == 3;
}

test an_opencode_pane_and_a_crush_pane_get_a_profile_and_their_own_variables_by_name {
    var st : [ST_SIZE]u64 = undefined;
    var o : [700]u8 = undefined;
    t_zai3(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_OPENROUTER, 0);
    // OpenCode (cell 3): z.ai first, key 1 by rotation, the key variable and the inline config by name
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_ZAI;
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    assert pane_agent_get(st[0..ST_SIZE], 0) == 3;
    assert agent_var_count(3, t_prof(st[0..ST_SIZE], 0)) == 2;
    var n : usize = agent_var_name(3, PR_ZAI, 0, o[0..40]);
    assert n == 11 and begins_with(o[0..n], "ZAI_API_KEY");
    n = agent_var_name(3, PR_ZAI, 1, o[0..40]);
    assert begins_with(o[0..n], "OPENCODE_CONFIG_CONTENT");
    // Crush (cell 5) on pane 1: the next z.ai key, the config directory named from the pane's model step
    plan_pane_keys(st[0..ST_SIZE], 1, 5, 1000100);
    assert t_prof(st[0..ST_SIZE], 1) == PR_ZAI;
    assert pane_key_get(st[0..ST_SIZE], 1, P_ZAI) == 2;
    assert pane_agent_get(st[0..ST_SIZE], 1) == 5 and pane_agent_get(st[0..ST_SIZE], 0) == 3;
    n = agent_var_name(5, PR_ZAI, 1, o[0..40]);
    assert begins_with(o[0..n], "CRUSH_GLOBAL_CONFIG");
    // the model each starts with: glm-4.5-flash at step 0, glm-4.7-flash at step 1
    assert agent_var_text_step(5, PR_ZAI, 1, pane_mstep_get(st[0..ST_SIZE], 1), "/h", o[0..700]) == 21;
    n = launch_model(st[0..ST_SIZE], 1, 5, false, "x", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.5-flash");
    // a profile agent reads its error rows; a Codex pane (cell 1) still does not
    assert scan_applies(3) and scan_applies(5) and scan_applies(1) == false;
    assert has_key_for(st[0..ST_SIZE], 3) and has_key_for(st[0..ST_SIZE], 5);
    assert load_mask_agent(3) == 25 and load_mask_agent(5) == 25;
    assert needs_key(3) and needs_key(5);
}

test an_opencode_pane_rotates_keys_models_and_profiles_like_claude_code_and_never_to_ollama {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_key(st[0..ST_SIZE], P_ZAI, 1);
    t_key(st[0..ST_SIZE], P_OPENROUTER, 0);
    t_key(st[0..ST_SIZE], P_OLLAMA, 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1000000);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 1;
    // key 1 is throttled: key 2, same profile
    assert plan_failover(st[0..ST_SIZE], 0, FC_RATE_LIMITED, 1001000, why[0..128], wl[0..2]) == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1001500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_ZAI) == 2;
    // key 2 too: no key left on glm-4.5-flash, the next model of the tier
    assert plan_failover(st[0..ST_SIZE], 0, FC_RATE_LIMITED, 1002000, why[0..128], wl[0..2]) == FA_RESPAWN_MODEL;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 1;
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1002500);
    var o : [64]u8 = undefined;
    const n : usize = launch_model(st[0..ST_SIZE], 0, 3, false, "glm-4.5-flash", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.7-flash");
    // both keys fail on it: OpenRouter, step 0, with the OpenAI-compatible base URL
    assert plan_failover(st[0..ST_SIZE], 0, FC_RATE_LIMITED, 1003000, why[0..128], wl[0..2]) == FA_RESPAWN_KEY;
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1003500);
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1004000, why[0..128], wl[0..2]) == FA_RESPAWN_NEXT;
    assert t_prof(st[0..ST_SIZE], 0) == PR_OPENROUTER;
    assert pane_mstep_get(st[0..ST_SIZE], 0) == 0;
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1004500);
    assert pane_key_get(st[0..ST_SIZE], 0, P_OPENROUTER) == 1;
    // OpenRouter's key fails on both ids; the Ollama key is no OpenCode profile, so the chain ends
    assert plan_failover(st[0..ST_SIZE], 0, FC_RATE_LIMITED, 1005000, why[0..128], wl[0..2]) == FA_RESPAWN_MODEL;
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1005500);
    assert plan_failover(st[0..ST_SIZE], 0, FC_RATE_LIMITED, 1006000, why[0..128], wl[0..2]) == FA_GIVE_UP;
    assert st[G_PANEK + PK_STOP] > 1006000;
    // Claude Code in the same table still reaches Ollama cloud after OpenRouter
    plan_pane_keys(st[0..ST_SIZE], 1, 0, 1007000);
    assert pane_agent_get(st[0..ST_SIZE], 1) == 0;
    assert agent_profile_ok(0, PR_OLLAMA_CLOUD);
}

test a_pane_with_only_an_ollama_key_is_keyless_for_opencode_and_crush {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_OLLAMA, 0);
    assert has_key_for(st[0..ST_SIZE], 0);
    assert has_key_for(st[0..ST_SIZE], 3) == false and has_key_for(st[0..ST_SIZE], 5) == false;
    assert restore_waits(st[0..ST_SIZE], 3);
    plan_pane_keys(st[0..ST_SIZE], 0, 3, 1000000);
    assert t_prof(st[0..ST_SIZE], 0) == PR_NONE;
    assert pane_light(st[0..ST_SIZE], 0, 3, 1000000) == L_RED;
}

test the_light_of_a_pane_follows_its_tier_its_keys_and_its_give_up {
    var st : [ST_SIZE]u64 = undefined;
    var why : [128]u8 = undefined;
    var wl : [2]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    t_key(st[0..ST_SIZE], P_ANTHROPIC, 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
    // a free z.ai profile with a usable key: yellow
    assert pane_light(st[0..ST_SIZE], 0, 0, 1000000) == L_YELLOW;
    assert pane_light(st[0..ST_SIZE], 0, 3, 1000000) == L_YELLOW;
    // an editor, a shell and a cell with no profile have none
    assert pane_light(st[0..ST_SIZE], 0, SHELL_CELL, 1000000) == L_NONE;
    assert pane_light(st[0..ST_SIZE], 0, 1, 1000000) == L_NONE;
    // the z.ai key has no balance on both flash models: the pane moves to the paid profile and is green
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1001000, why[0..128], wl[0..2]) == FA_RESPAWN_MODEL;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1001200);
    assert pane_light(st[0..ST_SIZE], 0, 0, 1001200) == L_YELLOW;
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1001300, why[0..128], wl[0..2]) == FA_RESPAWN_NEXT;
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1001500);
    assert t_prof(st[0..ST_SIZE], 0) == PR_ANTHROPIC;
    assert pane_light(st[0..ST_SIZE], 0, 0, 1001500) == L_GREEN;
    // the paid key is out of balance too (rests 600 s): every usable key rests, and the chain gave up: red
    assert plan_failover(st[0..ST_SIZE], 0, FC_NO_BALANCE, 1002000, why[0..128], wl[0..2]) == FA_GIVE_UP;
    assert pane_light(st[0..ST_SIZE], 0, 0, 1002000) == L_RED;
    // a throttled key (30 s) is busy, not empty: its pane stays yellow while the key is soon free
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 2000000);
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 2000 + 30);
    assert keys_usable(st[0..ST_SIZE], P_ZAI, 2000000) == 1;
    assert pane_light(st[0..ST_SIZE], 0, 0, 2000000) == L_YELLOW;
    // an empty account (600 s) leaves no usable key: red; the clock far past the rest frees it again
    key_rest(st[0..ST_SIZE], P_ZAI, 0, 2000 + 600);
    assert keys_usable(st[0..ST_SIZE], P_ZAI, 2000000) == 0;
    assert pane_light(st[0..ST_SIZE], 0, 0, 2000000) == L_RED;
    assert pane_light(st[0..ST_SIZE], 0, 0, 2000000 + 590000) == L_YELLOW;
    // a profile agent with no profile yet is red
    t_table(st[0..ST_SIZE]);
    plan_pane_keys(st[0..ST_SIZE], 2, 5, 1000000);
    assert pane_light(st[0..ST_SIZE], 2, 5, 1000000) == L_RED;
}

test the_listing_state_byte_carries_the_light_and_an_old_reader_can_mask_it {
    var st : [ST_SIZE]u64 = undefined;
    t_table(st[0..ST_SIZE]);
    t_key(st[0..ST_SIZE], P_ZAI, 0);
    plan_pane_keys(st[0..ST_SIZE], 0, 0, 1000000);
