// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_ws.t27 -- THREAD-VISION: the read-only bridge from T27
; into the DSH web GUI at 127.0.0.1:3080 (owner directive 2026-11-02).
; -
; THE ONE TRANSPORT. Every call is an HTTP POST to BASE_URL + API_PREFIX +
; method with the envelope CLIENT_REQUEST and the args object. No second
; envelope exists: the same mechanism serves dsh-read and every later read
; verb (owner, 2026-11-02).
; -
; THE AUTH. The credential travels in a cookie. It comes from the environment
; variable DSH_COOKIE or, when that is absent, from COOKIE_FILE, a file that
; must be mode 0600. The value never enters a log, a report or a test: the
; functions here handle names and lengths, never the credential bytes.
; -
; READ-ONLY LAW. This bridge exposes thread_read, events_since and
; subagents_get and nothing else. A verb that mutates a thread, spawns a
; subagent or writes host state is out of scope by law, not by caution.
; -
; THE STREAM QUESTION. A native ws stream is preferred but adopted only after
; an experiment on a synthetic session proves the message format, the
; reconnect behaviour and the event delivery. Until that verdict exists the
; channel is cursor-polling at POLL_MS, and every delay report says "polled
; at 2 s", never "live".
; -
; Buffers, not strings: the emit_* helpers write bytes into caller arrays so
; the whole module compiles natively under t27b with no imports.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserWs;

use tri::t27b::emit_kit::put_bytes;

pub const BASE_URL : str = "http://127.0.0.1:3080";
pub const API_PREFIX : str = "/api/";
pub const COOKIE_FILE : str = ".dsh/cookie.thread-vision";
pub const POLL_MS : u32 = 2000;
pub const RPC_ID_LEN : usize = 32;
pub const ENV_MAX : usize = 256;

pub const M_THREAD_READ : str = "thread_read";
pub const M_EVENTS_SINCE : str = "events_since";
pub const M_SUBAGENTS_GET : str = "subagents_get";
pub const KIND : str = "client-request";

pub const V_THREAD : u8 = 1;
pub const V_EVENTS : u8 = 2;
pub const V_SUBAGENTS : u8 = 3;
pub const V_BAD : u8 = 9;

pub const CH_STREAM : u8 = 0;
pub const CH_POLL : u8 = 1;
pub const CHANNEL_NOW : u8 = CH_POLL;

pub const AUTH_ENV : u8 = 0;
pub const AUTH_FILE : u8 = 1;
pub const AUTH_ABSENT : u8 = 2;

pub struct WsReq {
    verb : u8,
    thread : []u8,
    thread_len : usize,
    cursor : []u8,
    cursor_len : usize,
    session : []u8,
    session_len : usize,
}

pub fn verb_of(m : str) -> u8 {
    if (m == M_THREAD_READ) { return V_THREAD; }
    if (m == M_EVENTS_SINCE) { return V_EVENTS; }
    if (m == M_SUBAGENTS_GET) { return V_SUBAGENTS; }
    return V_BAD;
}

/// 0 = the call may leave the host. Guards before any byte is written.
pub fn request_refusal(r : WsReq) -> u8 {
    if (r.verb == V_BAD or r.verb == 0) { return 1; }
    if (r.verb != V_SUBAGENTS and r.thread_len == 0) { return 2; }
    if (r.verb == V_EVENTS and r.cursor_len == 0) { return 3; }
    return 0;
}

fn put_str(out : []u8, w : usize, s : str) -> usize {
    var i : usize = 0;
    while (i < s.len) { out[w + i] = s[i] as u8; i = i + 1; }
    return w + s.len;
}

/// The hex rpc id: 32 lowercase digits from a 64-bit seed, LC GPR curve.
pub fn rpc_id_of(seed : u64, out : []u8) -> usize {
    var x : u64 = seed ^ 0x27bd5a9e7c0d5444;
    var i : usize = 0;
    while (i < RPC_ID_LEN) {
        var d : u64 = (x >> ((i % 16) * 4)) & 15;
        out[i] = (48 + d + (d / 10) * 39) as u8;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        i = i + 1;
    }
    return RPC_ID_LEN;
}

/// The wire envelope: {"type":"client-request","rpcId":"..","method":"..",
/// "payload":{"args":<args object>}}. Returns bytes written; ENV_MAX caps it.
pub fn emit_envelope(r : WsReq, seed : u64, out : []u8) -> usize {
    var w : usize = 0;
    var id : [RPC_ID_LEN]u8 = [0] ** RPC_ID_LEN;
    var idn : usize = 0;
    idn = put_bytes(out, w, &id, RPC_ID_LEN);
    w = put_str(out, w, "{\"type\":\"client-request\",\"rpcId\":\"");
    w = put_bytes(out, w, &id, RPC_ID_LEN);
    w = put_str(out, w, "\",\"method\":\"");
    if (r.verb == V_THREAD) { w = put_str(out, w, M_THREAD_READ); }
    if (r.verb == V_EVENTS) { w = put_str(out, w, M_EVENTS_SINCE); }
    if (r.verb == V_SUBAGENTS) { w = put_str(out, w, M_SUBAGENTS_GET); }
    w = put_str(out, w, "\",\"payload\":{\"args\":");
    if (r.verb == V_THREAD) {
        w = put_str(out, w, "{\"thread\":\"");
        w = put_bytes(out, w, r.thread, r.thread_len);
        w = put_str(out, w, "\"}");
    }
    if (r.verb == V_EVENTS) {
        w = put_str(out, w, "{\"cursor\":\"");
        w = put_bytes(out, w, r.cursor, r.cursor_len);
        w = put_str(out, w, "\"}");
    }
    if (r.verb == V_SUBAGENTS) {
        w = put_str(out, w, "{\"session\":\"");
        w = put_bytes(out, w, r.session, r.session_len);
        w = put_str(out, w, "\"}");
    }
    w = put_str(out, w, "}}");
    return w;
}

/// The honest latency of the channel in ms: POLL_MS while polling.
pub fn channel_latency_ms() -> u32 {
    if (CHANNEL_NOW == CH_POLL) { return POLL_MS; }
    return 0;
}

pub fn auth_source(env_present : bool, file_mode_0600 : bool) -> u8 {
    if (env_present) { return AUTH_ENV; }
    if (file_mode_0600) { return AUTH_FILE; }
    return AUTH_ABSENT;
}

invariant the_bridge_is_read_only {
    assert verb_of(M_THREAD_READ) == V_THREAD;
    assert verb_of(M_EVENTS_SINCE) == V_EVENTS;
    assert verb_of(M_SUBAGENTS_GET) == V_SUBAGENTS;
    assert verb_of("thread_write") == V_BAD;
    assert verb_of("subagent_spawn") == V_BAD;
}

invariant polling_is_the_documented_fallback {
    assert CHANNEL_NOW == CH_POLL;
    assert channel_latency_ms() == POLL_MS;
    assert POLL_MS >= 1000;
}

test envelope_carries_the_one_mechanism {
    var t : [8]u8 = [0] ** 8;
    t[0] = 84; t[1] = 50; t[2] = 55; t[3] = 66;
    var r : WsReq;
    r.verb = V_THREAD;
    r.thread = &t;
    r.thread_len = 4;
    r.cursor = &t;
    r.cursor_len = 0;
    r.session = &t;
    r.session_len = 0;
    var out : [ENV_MAX]u8 = [0] ** ENV_MAX;
    var n = emit_envelope(r, 7, &out);
    assert(n > 60);
    assert(out[8] == 34 and out[9] == 99 and out[10] == 108 and out[11] == 105);
    assert(out[n - 1] == 125 and out[n - 2] == 125);
}

test rpc_ids_differ_per_seed {
    var a : [RPC_ID_LEN]u8 = [0] ** RPC_ID_LEN;
    var b : [RPC_ID_LEN]u8 = [0] ** RPC_ID_LEN;
    var na : usize = rpc_id_of(1, &a);
    var nb : usize = rpc_id_of(2, &b);
    assert(na == RPC_ID_LEN and nb == RPC_ID_LEN and
        (a[0] != b[0] or a[1] != b[1] or a[5] != b[5] or
         a[9] != b[9] or a[17] != b[17] or a[31] != b[31]));
    assert(a[0] >= 48 and a[0] <= 102);
}

test refusal_guards_are_complete {
    var t : [4]u8 = [0] ** 4;
    var c : [4]u8 = [0] ** 4;
    c[0] = 99; c[1] = 52; c[2] = 50;
    var r : WsReq;
    r.verb = V_EVENTS;
    r.thread = &t;
    r.thread_len = 0;
    r.cursor = &c;
    r.cursor_len = 0;
    r.session = &t;
    r.session_len = 0;
    assert(request_refusal(r) == 2);
    r.thread_len = 4;
    assert(request_refusal(r) == 3);
    r.cursor_len = 3;
    assert(request_refusal(r) == 0);
    r.verb = verb_of("subagent_spawn");
    assert(request_refusal(r) == 1);
}

test subagents_get_needs_no_thread {
    var s : [11]u8 = [0] ** 11;
    s[0] = 115; s[1] = 121; s[2] = 110;
    var t : [4]u8 = [0] ** 4;
    var r : WsReq;
    r.verb = V_SUBAGENTS;
    r.thread = &t;
    r.thread_len = 0;
    r.cursor = &t;
    r.cursor_len = 0;
    r.session = &s;
    r.session_len = 11;
    assert(request_refusal(r) == 0);
    var out : [ENV_MAX]u8 = [0] ** ENV_MAX;
    var n = emit_envelope(r, 99, &out);
    assert(n > 60);
    assert(out[n - 1] == 125);
}

test auth_source_prefers_env_but_fails_closed {
    assert(auth_source(true, false) == AUTH_ENV);
    assert(auth_source(false, true) == AUTH_FILE);
    assert(auth_source(false, false) == AUTH_ABSENT);
}
