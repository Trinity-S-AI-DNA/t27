// SPDX-License-Identifier: Apache-2.0
; specs/t27os/godmode_tick.t27 -- the GODMODE tick decision spec for the DSH supervisor.
; Owner, 2026-10-31: a pure decision spec that returns SKIP/HOLD/REPORT/RAN and writes JSON tick rows.
; This spec never calls the host: it reads through crons::mac-dsh-godmode-supervisor::gm_action
; and expects the host to handle all file and system operations. Phase 0 is held by PR #13009;
; a real tick must output HOLD for phase 0 with another writer present.
; Host inventory:
; wrapper: tg_read fn tg_read(hb: []const u8, dir: []const u8, file: []const u8, dst: []u8) -> usize glass_window.t27:6209
; wrapper: term_connect fn term_connect(hb: []const u8) -> i32 glass_window.t27:5367
; GAP: @extern "getloadavg" -> void
; GAP: @extern "statfs" -> bool
; wrapper: unix_time fn unix_time(t: u64) -> u64 glass_window.t27:2328
; GAP: @extern "append_one_line" -> bool
module T27osGodmodeTick;

use t27os::session_store::put_dec;
use t27os::session_store::put_bytes;
use crons::mac-dsh-godmode-supervisor::GM_A_HOLD;
use crons::mac-dsh-godmode-supervisor::GM_A_RUN;
use crons::mac-dsh-godmode-supervisor::GM_A_REPORT;
use crons::mac-dsh-godmode-supervisor::gm_action;
use crons::mac-dsh-godmode-supervisor::gm_tick_may_run;

pub const GM_A_SKIPPED : u32 = 3;

pub const GM_OUTCOME_HELD : u32 = 0;
pub const GM_OUTCOME_REPORTED : u32 = 1;
pub const GM_OUTCOME_RAN : u32 = 2;
pub const GM_OUTCOME_STALLED : u32 = 3;

pub fn tick_decide(go: bool, enabled: bool, dsh_alive: bool, free_gb: u32, load: u32, other_writer: bool, phase: u32) -> u32 {
    if (!go) {
        return GM_A_SKIPPED;
    }

    if (!gm_tick_may_run(go, enabled, dsh_alive, free_gb, load)) {
        return GM_A_SKIPPED;
    }

    return gm_action(phase, other_writer, dsh_alive);
}

fn dec_len(v: u64) -> usize {
    var len : u32 = 1;
    var t : u64 = v;
    while (t >= 10) {
        t = t / 10;
        len = len + 1;
    }
    return len;
}

fn row_len(tick: u32, phase: u32, action: u32, tool_calls: u32, tokens: u32, seconds: u32, outcome: u32) -> usize {
    var len : usize = 2; // {
    len += dec_len(@intCast(tick));
    len += 1; // ,
    len += dec_len(@intCast(phase));
    len += 13; // ,"action":"X",
    len += 19; // ,"model":"glm-4.5-flash",
    len += 1; // :
    len += dec_len(@intCast(tool_calls));
    len += 1; // ,
    len += 9; // ,"tokens":
    len += 1; // :
    len += dec_len(@intCast(tokens));
    len += 1; // ,
    len += 10; // ,"seconds":
    len += 1; // :
    len += dec_len(@intCast(seconds));
    len += 1; // ,
    len += 11; // ,"outcome":"X"}
    len += 1; // \n
    return len;
}

pub fn tick_row(dst: []u8, tick: u32, phase: u32, action: u32, tool_calls: u32, tokens: u32, seconds: u32, outcome: u32) -> usize {
    var total_len : usize = row_len(tick, phase, action, tool_calls, tokens, seconds, outcome);
    if (total_len > dst.len) {
        return 0;
    }

    var at : usize = 0;
    at = put_bytes(dst, at, "{");
    at = put_dec(dst, at, @intCast(tick));
    at = put_bytes(dst, at, ",");
    at = put_dec(dst, at, @intCast(phase));
    at = put_bytes(dst, at, ",");
    at = put_bytes(dst, at, "\"action\":\"");
    if (action == GM_A_HOLD) {
        at = put_bytes(dst, at, "HOLD");
    } else if (action == GM_A_RUN) {
        at = put_bytes(dst, at, "RUN");
    } else if (action == GM_A_REPORT) {
        at = put_bytes(dst, at, "REPORT");
    } else if (action == GM_A_SKIPPED) {
        at = put_bytes(dst, at, "SKIP");
    } else {
        at = put_bytes(dst, at, "unknown");
    }
    at = put_bytes(dst, at, "\",");
    at = put_bytes(dst, at, "\"model\":\"glm-4.5-flash\",");
    at = put_bytes(dst, at, "\"tool_calls\":");
    at = put_dec(dst, at, @intCast(tool_calls));
    at = put_bytes(dst, at, ",");
    at = put_bytes(dst, at, "\"tokens\":");
    at = put_dec(dst, at, @intCast(tokens));
    at = put_bytes(dst, at, ",");
    at = put_bytes(dst, at, "\"seconds\":");
    at = put_dec(dst, at, @intCast(seconds));
    at = put_bytes(dst, at, ",");
    at = put_bytes(dst, at, "\"outcome\":\"");
    if (outcome == GM_OUTCOME_HELD) {
        at = put_bytes(dst, at, "held");
    } else if (outcome == GM_OUTCOME_REPORTED) {
        at = put_bytes(dst, at, "reported");
    } else if (outcome == GM_OUTCOME_RAN) {
        at = put_bytes(dst, at, "ran");
    } else if (outcome == GM_OUTCOME_STALLED) {
        at = put_bytes(dst, at, "stalled");
    } else {
        at = put_bytes(dst, at, "unknown");
    }
    at = put_bytes(dst, at, "\"}");
    at = put_bytes(dst, at, "\n");
    return at;
}

pub fn tick_host_needs() -> u32 {
    return 6;
}

test "go absent -> skip" {
    var action : u32 = tick_decide(false, true, true, 7, 30, false, 1);
    assert(action == GM_A_SKIPPED);
}

test "go present, dsh dead -> report" {
    var action : u32 = tick_decide(true, true, false, 7, 30, false, 1);
    assert(action == gm_action(1, false, false));
}

test "phase 0 with another writer -> hold" {
    var action : u32 = tick_decide(true, true, true, 7, 30, true, 0);
    assert(action == GM_A_HOLD);
}

test "phase 1 no other writer -> run" {
    var action : u32 = tick_decide(true, true, true, 7, 30, false, 1);
    assert(action == GM_A_RUN);
}

test "HOLD row format exact" {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 1, 0, GM_A_HOLD, 5, 1000, 10, GM_OUTCOME_HELD);
    assert(written == 120);
    const want : []const u8 = "{\"tick\":1,\"phase\":0,\"action\":\"HOLD\",\"model\":\"glm-4.5-flash\",\"tool_calls\":5,\"tokens\":1000,\"seconds\":10,\"outcome\":\"held\"}\n";
    var i : usize = 0;
    while (i < want.len) {
        assert(buf[i] == want[i]);
        i = i + 1;
    }
}

test "buffer too small" {
    var buf : [8]u8 = undefined;
    var written : usize = tick_row(buf[0..8], 1, 0, GM_A_HOLD, 5, 1000, 10, GM_OUTCOME_HELD);
    assert(written == 0);
}

test "RUN row format exact" {
    var buf : [160]u8 = undefined;
    var written : usize = tick_row(buf[0..160], 2, 1, GM_A_RUN, 3, 500, 5, GM_OUTCOME_RAN);
    assert(written == 118);
    var at : usize = 0;
    assert(buf[at] == '{'); at += 1;
    assert(buf[at+9] == ',');
    assert(buf[at+22] == 'R');
    assert(buf[at+23] == 'U');
    assert(buf[at+24] == 'N');
    assert(buf[at+40] == 'r');
    assert(buf[at+41] == 'a');
    assert(buf[at+42] == 'n');
}

test "host needs" {
    var needs : u32 = tick_host_needs();
    assert(needs == 6);
}