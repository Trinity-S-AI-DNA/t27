// SPDX-License-Identifier: Apache-2.0
; specs/t27os/godmode_tick.t27 -- the GODMODE tick decision spec for the DSH supervisor.
; Owner, 2026-10-31: a pure decision spec that returns SKIP/HOLD/REPORT/RAN and writes JSON tick rows.
; This spec never calls the host: it reads through crons::mac-dsh-godmode-supervisor::gm_action
; and expects the host to handle all file and system operations. Phase 0 is held by PR #13009;
; a real tick must output HOLD for phase 0 with another writer present.
module T27osGodmodeTick;

use crons::mac-dsh-godmode-supervisor::gm_action;

pub const GM_A_HOLD : u32 = 0;
pub const GM_A_RUN : u32 = 1;
pub const GM_A_REPORT : u32 = 2;
pub const GM_A_SKIPPED : u32 = 3;

pub const GM_OUTCOME_HELD : u32 = 0;
pub const GM_OUTCOME_REPORTED : u32 = 1;
pub const GM_OUTCOME_RAN : u32 = 2;
pub const GM_OUTCOME_STALLED : u32 = 3;

pub fn tick_decide(go: bool, enabled: bool, dsh_alive: bool, free_gb: u32, load: u32, other_writer: bool, phase: u32) -> u32 {
    if (!go) {
        return GM_A_SKIPPED;
    }

    if (!crons::mac-dsh-godmode-supervisor::gm_tick_may_run(go, enabled, dsh_alive, free_gb, load)) {
        return GM_A_SKIPPED;
    }

    return gm_action(phase, other_writer, dsh_alive);
}

pub fn tick_row(dst: []u8, tick: u32, phase: u32, action: u32, tool_calls: u32, tokens: u32, seconds: u32, outcome: u32) -> usize {
    var needed : usize = 0;

    needed += std.fmt.formatIntIntoSlice(dst, tick, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, phase, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatTextIntoSlice(dst, "\"", dst.len, &needed);
    dst[needed] = '"';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, action, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatTextIntoSlice(dst, "\"glm-4.5-flash\"", dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, tool_calls, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, tokens, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, seconds, 10, false, 0, dst.len, &needed);
    dst[needed] = ',';
    needed += 1;

    needed += std.fmt.formatTextIntoSlice(dst, "\"", dst.len, &needed);
    dst[needed] = '"';
    needed += 1;

    needed += std.fmt.formatIntIntoSlice(dst, outcome, 10, false, 0, dst.len, &needed);
    dst[needed] = '}';
    needed += 1;

    dst[needed] = '\n';
    needed += 1;

    if (needed > dst.len) {
        return 0;
    }

    return needed;
}

pub fn tick_host_needs() -> u32 {
    return 6;
}

test "go absent -> skip" {
    var action : u32 = tick_decide(false, true, true, 7, 30, false, 1);
    assert(action == GM_A_SKIPPED);
}

test "go present, dsh dead -> report" {
    var action : u32 = tick_decide(true, true, false, 7, 30, false, 1);
    assert(action == GM_A_REPORT);
}

test "phase 0 with another writer -> hold" {
    var action : u32 = tick_decide(true, true, true, 7, 30, true, 0);
    assert(action == GM_A_HOLD);
}

test "phase 1 no other writer -> run" {
    var action : u32 = tick_decide(true, true, true, 7, 30, false, 1);
    assert(action == GM_A_RUN);
}

test "HOLD row format" {
    var buffer : [256]u8 = undefined;
    var written : usize = tick_row(buffer, 1, 0, GM_A_HOLD, 5, 1000, 10, GM_OUTCOME_HELD);
    assert(written == 46);
    assert(buffer[45] == '\n');
}

test "buffer too small" {
    var buffer : [8]u8 = undefined;
    var written : usize = tick_row(buffer, 1, 0, GM_A_HOLD, 5, 1000, 10, GM_OUTCOME_HELD);
    assert(written == 0);
}

test "host needs" {
    var needs : u32 = tick_host_needs();
    assert(needs == 6);
}