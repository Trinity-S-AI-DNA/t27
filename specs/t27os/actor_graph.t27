// ---------------------------------------------------------------- the nodes

/// What an actor does: the four board roles (intake, reconciler, domain, agent) come named from
/// actor_view; the six event-processor kinds (4..9) answer with the honest generic word.
pub fn actor_kind_name(kind : u8) -> string {
    if (kind < 4) { return ACTOR_KIND_NAMES[kind]; }
    return "actor";
}

/// The three actor states: running (doing work), restarting (supervisor's call), dead (exit).
/// The state text is the VS_NAMES word, not colour-only.
pub fn actor_state_name(state : u8) -> string {
    if (state < 3) { return VS_NAMES[state]; }
    return "?";
}

// ---------------------------------------------------------------- the edges

/// The five edge classes, each as a constant and a distinct relationship. No invented arrows: an event
/// without a from_pid marks a node-event (the target is an incomplete view of the actor's work).
pub const AE_SUPERVISOR : u8 = 0;
pub const AE_MESSAGE : u8 = 1;
pub const AE_TASK_REF : u8 = 2;
pub const AE_RESULT : u8 = 3;
pub const AE_OBSERVE : u8 = 4;

pub const AE_NAMES : [5]str = ["supervisor", "message", "task_ref", "result", "observe"];

/// Edge classes of one event. The event stream names the relationship; the graph only spells it:
/// spawn is the supervisor's parent->child arrow, restart/exit/down are the supervisor's lifecycle
/// observation, deliver is a sender->receiver message, a deliver carrying a task ref is the task
/// dependency, a result is the result return. No invented arrows: an event without from_pid is a
/// node-event with an incomplete mark, never an edge.
pub fn ag_edge_of_event(kind : u8, task_ref : u64) -> u8 {
    if (kind == EV_ACTOR_SPAWN) { return AE_SUPERVISOR; }
    if (kind == EV_ACTOR_DELIVER) {
        if (task_ref != 0) { return AE_TASK_REF; }
        return AE_MESSAGE;
    }
    if (kind == AGR_EV_RESULT) { return AE_RESULT; }
    return AE_OBSERVE;
}

/// An edge is complete only when the event named its source; the mark stays honest.
pub fn ag_edge_complete(from_pid : u64) -> bool {
    return from_pid != NO_PID;
}

// The result event kind on spec/integration is queen::events EV_RESULT == 6; this base predates
// it, so the value is pinned here and the import replaces this constant at integration.
pub const AGR_EV_RESULT : u8 = 6;

// ---------------------------------------------------------------- the lifecycle

/// A restart reuses the slot with the next generation: same logical actor, new distinguishable
/// incarnation (the pid changes, the slot does not). Counters are keyed by the full pid, so the
/// new incarnation starts at zero -- no result inheritance.
pub fn ag_restart(old_pid : u64) -> u64 {
    return pid_of(slot_of(old_pid), gen_of(old_pid) + 1);
}

/// Two pids are the same logical actor exactly when they share the slot.
pub fn ag_same_actor(a : u64, b : u64) -> bool {
    return slot_of(a) == slot_of(b);
}

/// Down nodes persist until dismissed (the keep-visible window law): a dead node is kept visible
/// for at least AGR_DOWN_KEEP_MS even after a dismissal, and forever without one -- a burst of
/// exits never flashes away, and the refresh never drops it.
pub const AGR_DOWN_KEEP_MS : u64 = 5000;

pub fn ag_down_visible(dead_at_ms : u64, now_ms : u64, dismissed : bool) -> bool {
    if (dismissed == false) { return true; }
    if (now_ms < dead_at_ms) { return true; }
    return now_ms - dead_at_ms < AGR_DOWN_KEEP_MS;
}

// ------------------------------------------------------------- zoom and shell interplay

/// The semantic zoom reuses the landed QLG_Z pattern: identity is the pid (slot+gen), packed as
/// the shell selection word. Selection survival follows the LOGICAL actor (the slot), so a card
/// stays open across a restart and shows the new incarnation.
pub fn ag_zoom_find(pids : []const u64, n : u32, pid : u64) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        if (pids[i] == pid) { return i; }
        i = i + 1;
    }
    return QLG_Z_NONE;
}

/// Where the selection lives after a refresh: the first live incarnation of the same slot, or
/// the explicit QLG_Z_GONE -- never a silent clear.
pub fn ag_zoom_keep(sel : u64, pids : []const u64, n : u32) -> u64 {
    var best : u64 = QLG_Z_GONE;
    var i : u32 = 0;
    while (i < n) {
        if (ag_same_actor(pids[i], sel)) {
            if (best == QLG_Z_GONE or pids[i] > best) { best = pids[i]; }
        }
        i = i + 1;
    }
    return best;
}

/// BACK: clears the selection only; the shell passes the viewport through untouched.
pub fn ag_zoom_back(sel : u64, vp : u64) -> u64 {
    return ss_back(sel, vp);
}

/// The graph tab defaults; the tab strip is the shell's law, consumed here.
pub const AG_Z_OVERVIEW : u32 = 0;
pub const AG_Z_AGENT : u32 = 1;
pub const AG_Z_COUNT : u32 = 2;

pub fn ag_tab_default() -> u32 {
    return SS_TAB_GRAPH;
}

pub fn ag_tab_ok(t : u32) -> bool {
    return ss_tab_ok(t);
}

// ------------------------------------------------------------- fullscreen layout math

/// Fullscreen layout as pure functions of the content rect: nodes in a grid, at least two radii
/// of clear air between neighbours, everything inside the rect with a margin.
pub const AGR_FS_PAD : f64 = 24.0;
pub const AGR_NODE_R : f64 = 14.0;
pub const AGR_MAX_NODES : u32 = 32;

pub fn agr_refused(n : u32) -> bool {
    return n > AGR_MAX_NODES;
}

pub fn agr_cols(n : u32) -> u32 {
    var c : u32 = 1;
    while (c * c < n) { c = c + 1; }
    return c;
}

pub fn agr_rows(n : u32) -> u32 {
    const cols : u32 = agr_cols(n);
    var r : u32 = 0;
    var placed : u32 = 0;
    while (placed < n) { placed = placed + cols; r = r + 1; }
    return r;
}

pub fn agr_node_x(k : u32, n : u32, x : f64, w : f64) -> f64 {
    const cols : f64 = agr_cols(n) as f64;
    const cw : f64 = (w - 2.0 * AGR_FS_PAD) / cols;
    return x + AGR_FS_PAD + ((k % agr_cols(n)) as f64 + 0.5) * cw;
}

pub fn agr_node_y(k : u32, n : u32, y : f64, h : f64) -> f64 {
    const rows : f64 = agr_rows(n) as f64;
    const ch : f64 = (h - 2.0 * AGR_FS_PAD) / rows;
    return y + AGR_FS_PAD + ((k / agr_cols(n)) as f64 + 0.5) * ch;
}

// ---------------------------------------------------------------- tests

test the_edge_classes_are_five_distinct_relationships {
    assert(AE_SUPERVISOR == 0 and AE_MESSAGE == 1 and AE_TASK_REF == 2);
    assert(AE_RESULT == 3 and AE_OBSERVE == 4);
    // pairwise distinct
    var a : u8 = 0;
    while (a < 5) {
        var b : u8 = a + 1;
        while (b < 5) {
            assert(a != b);
            b = b + 1;
        }
        a = a + 1;
    }
    // each event kind names exactly one relationship
    assert(ag_edge_of_event(EV_ACTOR_SPAWN, 0) == AE_SUPERVISOR);
    assert(ag_edge_of_event(EV_ACTOR_RESTART, 0) == AE_OBSERVE);
    assert(ag_edge_of_event(EV_ACTOR_EXIT, 0) == AE_OBSERVE);
    assert(ag_edge_of_event(EV_ACTOR_DOWN, 0) == AE_OBSERVE);
    assert(ag_edge_of_event(EV_ACTOR_DELIVER, 0) == AE_MESSAGE);
    assert(ag_edge_of_event(EV_ACTOR_DELIVER, 8615) == AE_TASK_REF);
    assert(ag_edge_of_event(AGR_EV_RESULT, 0) == AE_RESULT);
}

test no_arrow_without_a_source {
    // an event without from_pid is a node-event with an incomplete mark, never an edge
    assert(ag_edge_complete(NO_PID) == false);
    assert(ag_edge_complete(pid_of(3, 1)));
    // every lifecycle observation in the fixture names its supervisor: all complete
    var i : u32 = 0;
    while (i < 16) {
        if (TE_KIND[i] == EV_ACTOR_SPAWN or TE_KIND[i] == EV_ACTOR_DELIVER) {
            assert(ag_edge_complete(TE_FROM[i]));
        }
        i = i + 1;
    }
}

test a_restart_is_a_new_incarnation_of_the_same_actor {
    // the fixture's own restart (event 9, index 8): slot 9 generation 0 becomes slot 9 generation 1
    assert(TE_KIND[8] == EV_ACTOR_RESTART);
    assert(TE_TO[5] == pid_of(9, 0) and TE_TO[8] == pid_of(9, 1));
    assert(ag_same_actor(TE_TO[5], TE_TO[8]));
    assert(ag_restart(TE_TO[5]) == TE_TO[8]);
    // the incarnation is distinguishable: same slot, different generation
    assert(TE_TO[5] != TE_TO[8] and gen_of(TE_TO[5]) != gen_of(TE_TO[8]));
    // no result inheritance: the fresh incarnation reads as a new key, not the old one
    assert(ag_restart(pid_of(9, 0)) == pid_of(9, 1));
}

test dead_nodes_persist_until_dismissed {
    // without a dismissal the node stays visible forever, whatever its age
    assert(ag_down_visible(1000, 1000 + AGR_DOWN_KEEP_MS * 10, false));
    // within the keep window a dismissal is not honored yet
    assert(ag_down_visible(1000, 1000 + AGR_DOWN_KEEP_MS - 1, true));
    // after the window a dismissal clears it
    assert(ag_down_visible(1000, 1000 + AGR_DOWN_KEEP_MS, true) == false);
    // a future timestamp cannot be dismissed into the past
    assert(ag_down_visible(2000, 1000, true));
}

test zoom_survival_and_the_shell_contract {
    var pids : [4]u64 = [0, 0, 0, 0];
    pids[0] = pid_of(2, 0);
    pids[1] = pid_of(9, 0);
    pids[2] = pid_of(9, 1);
    pids[3] = pid_of(4, 0);
    // find by exact pid
    assert(ag_zoom_find(pids[0..4], 4, pid_of(9, 1)) == 2);
    assert(ag_zoom_find(pids[0..4], 4, pid_of(7, 0)) == QLG_Z_NONE);
    // keep by logical actor across a restart: the selection moves to the new incarnation
    assert(ag_zoom_keep(pid_of(9, 0), pids[0..4], 4) == pid_of(9, 1));
    // the slot is gone entirely: explicit gone, never a silent clear
    assert(ag_zoom_keep(pid_of(9, 0), pids[0..1], 1) == QLG_Z_GONE);
    assert(QLG_Z_GONE != QLG_Z_NOSEL);
    // shell law: switching ANY tab never clears the selected entity
    var t : u32 = 0;
    while (t < SS_TAB_COUNT) {
        assert(ss_tab_switch_keeps_sel(SS_TAB_GRAPH, t, pid_of(9, 1)) == pid_of(9, 1));
        t = t + 1;
    }
    // back clears the selection only; the viewport word passes through
    assert(ag_zoom_back(pid_of(9, 1), 0xABCD) == 0xABCD);
    // the graph tab defaults and every strip tab is valid
    assert(ag_tab_default() == SS_TAB_GRAPH);
    assert(ss_tab_ok(0) and ss_tab_ok(SS_TAB_COUNT - 1) and ss_tab_ok(SS_TAB_COUNT) == false);
}

test fullscreen_layout_is_pure_math_of_the_rect {
    // nodes inside the rect with a margin, never touching, for every count up to the cap
    var n : u32 = 1;
    while (n <= AGR_MAX_NODES) {
        var k : u32 = 0;
        while (k < n) {
            const ax : f64 = agr_node_x(k, n, 0.0, 800.0);
            const ay : f64 = agr_node_y(k, n, 0.0, 600.0);
            assert(ax >= AGR_FS_PAD and ax <= 800.0 - AGR_FS_PAD + 0.001);
            assert(ay >= AGR_FS_PAD and ay <= 600.0 - AGR_FS_PAD + 0.001);
            k = k + 2;
        }
        // neighbours in one row hold two radii of clear air
        if (n >= 2) {
            assert(agr_node_x(1, n, 0.0, 800.0) - agr_node_x(0, n, 0.0, 800.0) >= 2.0 * AGR_NODE_R + 2.0);
        }
        n = n + 7;
    }
    // the cap refuses honestly
    assert(agr_refused(AGR_MAX_NODES + 1) and agr_refused(AGR_MAX_NODES) == false);
    // the math is pure: same inputs, same outputs
    assert(agr_node_x(3, 8, 10.0, 800.0) == agr_node_x(3, 8, 10.0, 800.0));
}

test the_te_fixture_is_pinned_not_live {
    // the owner-provided replay sequence, pinned as fixture: 16 events, then empty rows
    assert(TE_SEQ[0] == 1 and TE_SEQ[15] == 16 and TE_SEQ[16] == 0);
    assert(TE_KIND[0] == EV_ACTOR_SPAWN and TE_KIND[1] == EV_ACTOR_DELIVERS);
    assert(TE_KIND[6] == EV_ACTOR_EXIT and TE_KIND[7] == EV_ACTOR_DOWN and TE_KIND[8] == EV_ACTOR_RESTART);
    // the fixture's pids decode to the slot.gen the board shows
    assert(slot_of(TE_FROM[0]) == 6 and slot_of(TE_TO[0]) == 7);
}

invariant the_zoom_levels_are_two_compositions {
    assert(AG_Z_OVERVIEW == 0 and AG_Z_AGENT == 1 and AG_Z_OVERVIEW != AG_Z_AGENT);
    assert(AG_Z_COUNT == 2);
}

invariant the_edge_vocabulary_is_exactly_five {
    assert(AE_SUPERVISOR == 0 and AE_MESSAGE == 1 and AE_TASK_REF == 2);
    assert(AE_RESULT == 3 and AE_OBSERVE == 4);
}

invariant the_shell_selection_word_is_the_pid {
    assert(SS_SEL_NONE == QLG_Z_NOSEL);
    assert(QLG_Z_GONE != QLG_Z_NOSEL);
}
