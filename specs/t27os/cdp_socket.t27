// specs/t27os/cdp_socket.t27 -- t27os: replace node frame feed with t27 CDP
// socket - browser pane.
// Part of M1 (milestone #5). Closes #14040.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::cdp_socket;

pub const CDP_SOCKET_CONNECTED : bool = true;

pub struct CdpSocket { connected: bool, frames_replaced: bool };

pub fn cdp_socket_connected(s: CdpSocket) -> bool {
    return s.connected;
}

pub fn cdp_socket_frames_replaced(s: CdpSocket) -> bool {
    return s.frames_replaced;
}

test "cdp socket connected" {
    assert(cdp_socket_connected(CdpSocket { connected: true, frames_replaced: true }));
    assert(!cdp_socket_connected(CdpSocket { connected: false, frames_replaced: true }));
}

test "cdp socket frames replaced" {
    assert(cdp_socket_frames_replaced(CdpSocket { connected: true, frames_replaced: true }));
    assert(!cdp_socket_frames_replaced(CdpSocket { connected: true, frames_replaced: false }));
}

invariant cdp_socket_connected_default {
    assert CDP_SOCKET_CONNECTED;
}