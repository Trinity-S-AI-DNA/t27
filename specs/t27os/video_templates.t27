// SPDX-License-Identifier: Apache-2.0
// specs/t27os/video_templates.t27 -- intro, body, outro, and thumbnail for a
// T27OS blog video. Slots and gates only. Colour, type, the triangle, the kit
// and the window live in specs/t27os/video_brand.t27. This file does not open
// the window and does not add a kit component.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::video_templates {

    use t27os::video_brand::VBRAND_KIT_CARD;
    use t27os::video_brand::VBRAND_KIT_BUTTON;
    use t27os::video_brand::VBRAND_KIT_COUNT;
    use t27os::video_brand::VBRAND_TITLE_CHARS;
    use t27os::video_brand::VBRAND_LINE_CHARS;
    use t27os::video_brand::VBRAND_HANDLE;
    use t27os::video_brand::vbrand_screen_ok;
    use t27os::video_brand::vbrand_line_ok;
    use t27os::video_brand::vbrand_type_ok;
    use t27os::video_brand::vbrand_kit_allowed;
    use t27os::video_brand::vbrand_mark_ok;
    use t27os::video_brand::vbrand_end_ok;
    use t27os::video_brand::vbrand_aspect_ok;
    use t27os::video_brand::vbrand_window;
    use t27os::video_brand::vbrand_window_ask;
    use automation::t27_plan::OUT_BLOCKED;
    use automation::t27_plan::GLASS_OPEN;

    pub const VTMPL_INTRO : u8 = 1;
    pub const VTMPL_BODY : u8 = 2;
    pub const VTMPL_OUTRO : u8 = 3;
    pub const VTMPL_THUMB : u8 = 4;

    pub fn vtmpl_known(kind: u8) -> bool {
        return kind == VTMPL_INTRO || kind == VTMPL_BODY || kind == VTMPL_OUTRO || kind == VTMPL_THUMB;
    }

    /// Intro: one idea, a short title, the triangle, and a kit card. Nothing else.
    pub fn vtmpl_intro_ok(ideas: u32, title_chars: u32, has_mark: bool, kit: u32, title_step: u32, body_step: u32) -> bool {
        if (!vbrand_screen_ok(ideas) || !has_mark || !vbrand_mark_ok()) { return false; }
        if (kit != VBRAND_KIT_CARD || !vbrand_kit_allowed(kit)) { return false; }
        return vbrand_type_ok(title_step, body_step, title_chars, VBRAND_LINE_CHARS);
    }

    /// Body: one idea, one short line, one kit component.
    pub fn vtmpl_body_ok(ideas: u32, line_chars: u32, kit: u32, title_step: u32, body_step: u32) -> bool {
        if (!vbrand_screen_ok(ideas) || !vbrand_kit_allowed(kit)) { return false; }
        if (!vbrand_line_ok(line_chars, false)) { return false; }
        return vbrand_type_ok(title_step, body_step, VBRAND_TITLE_CHARS, line_chars);
    }

    /// Outro: the end card. Triangle, handle, call to action, on a kit card.
    pub fn vtmpl_outro_ok(ideas: u32, has_mark: bool, handle: str, has_cta: bool, kit: u32) -> bool {
        if (!vbrand_screen_ok(ideas) || kit != VBRAND_KIT_CARD) { return false; }
        if (vbrand_window() != OUT_BLOCKED) { return false; }
        return vbrand_end_ok(has_mark, handle, has_cta);
    }

    /// Thumbnail: the same frame law. Tall only when a vertical cut was asked for.
    pub fn vtmpl_thumb_ok(vertical: bool, ideas: u32, title_chars: u32, has_mark: bool) -> bool {
        if (!vbrand_aspect_ok(vertical) || !vbrand_screen_ok(ideas)) { return false; }
        if (!has_mark || !vbrand_mark_ok()) { return false; }
        return vbrand_line_ok(title_chars, true);
    }

    test "intro body outro and thumbnail each keep one idea" {
        assert(vtmpl_known(VTMPL_INTRO));
        assert(vtmpl_known(VTMPL_BODY));
        assert(vtmpl_known(VTMPL_OUTRO));
        assert(vtmpl_known(VTMPL_THUMB));
        assert(!vtmpl_known(0));
        assert(vtmpl_intro_ok(1, VBRAND_TITLE_CHARS, true, VBRAND_KIT_CARD, 1, 0));
        assert(!vtmpl_intro_ok(2, 8, true, VBRAND_KIT_CARD, 1, 0));
        assert(!vtmpl_intro_ok(1, VBRAND_TITLE_CHARS + 1, true, VBRAND_KIT_CARD, 1, 0));
        assert(!vtmpl_intro_ok(1, 8, false, VBRAND_KIT_CARD, 1, 0));
        assert(!vtmpl_intro_ok(1, 8, true, VBRAND_KIT_BUTTON, 1, 0));
        assert(vtmpl_body_ok(1, VBRAND_LINE_CHARS, VBRAND_KIT_BUTTON, 1, 0));
        assert(vtmpl_body_ok(1, 8, VBRAND_KIT_COUNT - 1, 1, 0));
        assert(!vtmpl_body_ok(1, 8, VBRAND_KIT_COUNT, 1, 0));
        assert(!vtmpl_body_ok(0, 8, VBRAND_KIT_CARD, 1, 0));
        assert(!vtmpl_body_ok(1, 0, VBRAND_KIT_CARD, 1, 0));
        assert(vtmpl_outro_ok(1, true, VBRAND_HANDLE, true, VBRAND_KIT_CARD));
        assert(!vtmpl_outro_ok(1, true, VBRAND_HANDLE, false, VBRAND_KIT_CARD));
        assert(!vtmpl_outro_ok(1, true, "@other", true, VBRAND_KIT_CARD));
        assert(!vtmpl_outro_ok(1, true, VBRAND_HANDLE, true, VBRAND_KIT_BUTTON));
        assert(vtmpl_thumb_ok(false, 1, VBRAND_TITLE_CHARS, true));
        assert(vtmpl_thumb_ok(true, 1, 8, true));
        assert(!vtmpl_thumb_ok(false, 2, 8, true));
        assert(!vtmpl_thumb_ok(false, 1, VBRAND_TITLE_CHARS + 1, true));
        assert(!vtmpl_thumb_ok(false, 1, 8, false));
    }

    test "a template does not open the window" {
        assert(vbrand_window() == OUT_BLOCKED);
        assert(vbrand_window_ask(true) == OUT_BLOCKED);
        assert(vbrand_window_ask(false) == OUT_BLOCKED);
        assert(!GLASS_OPEN);
        assert(vtmpl_outro_ok(1, true, "@t27_lang", true, VBRAND_KIT_CARD));
    }

    invariant templates_leave_the_window_shut {
        assert vbrand_window() == OUT_BLOCKED;
        assert vbrand_window_ask(true) == OUT_BLOCKED;
        assert GLASS_OPEN == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
