// SPDX-License-Identifier: Apache-2.0
; specs/t27os/video_templates.t27 -- the three screens of T27OS_VIDEO_BRAND_V1.
; Each screen is one idea and is built only with a public builder from
; specs/t27f/ui_kit.t27. The kit still stores its own placeholder words
; (Title, Body, Action, Text); the meaning of the end card is the three
; slots below. This module does not edit the kit and does not open the shell.
; The default frame is 16:9. A 9:16 frame is returned only when the caller
; asks for a vertical cut.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVideoTemplates;

use t27os::video_brand::T27OS_VIDEO_BRAND_V1;
use t27os::video_brand::GLASS_OPEN;
use t27os::video_brand::window_shell;
use t27os::video_brand::END_MARK;
use t27os::video_brand::HANDLE;
use t27os::video_brand::CTA;
use t27os::video_brand::end_card_ok;
use t27os::video_brand::screen_ok;
use t27os::video_brand::IDEAS_PER_SCREEN;
use t27os::video_brand::cut_w;
use t27os::video_brand::cut_h;
use t27os::video_brand::default_vertical;
use t27os::video_brand::B_TEXT;
use t27os::video_brand::B_CARD;
use t27os::video_brand::BUILDER_COUNT;
use t27os::video_brand::builder_allowed;
use t27f::ui_kit::UiKit;
use t27f::ui_kit::kit_text;
use t27f::ui_kit::kit_card;
use t27f::ui_kit::kit_node_count;
use t27f::ui_kit::kit_variant_at;
use t27f::ui_kit::kit_parents_first;
use t27f::ui_kit::KV_PRIMARY;
use t27f::ui_kit::KV_SECONDARY;
use t27f::ui_kit::KS_DEFAULT;

pub const SCREEN_TITLE : u32 = 0;
pub const SCREEN_IDEA : u32 = 1;
pub const SCREEN_END : u32 = 2;
pub const SCREEN_COUNT : u32 = 3;

pub fn screen_ideas(screen: u32) -> u32 {
    if screen >= SCREEN_COUNT {
        return 0;
    }
    return IDEAS_PER_SCREEN;
}

pub fn screen_builder(screen: u32) -> u32 {
    if screen == SCREEN_END {
        return B_CARD;
    }
    if screen == SCREEN_TITLE or screen == SCREEN_IDEA {
        return B_TEXT;
    }
    return BUILDER_COUNT;
}

pub fn screen_graph(screen: u32) -> UiKit {
    if screen == SCREEN_END {
        return kit_card(KV_PRIMARY, KS_DEFAULT);
    }
    if screen == SCREEN_TITLE {
        return kit_text(KV_PRIMARY);
    }
    return kit_text(KV_SECONDARY);
}

; Meaning of the end-card slots. The kit graph keeps its placeholders.
pub fn end_title_slot() -> str {
    return END_MARK;
}

pub fn end_body_slot() -> str {
    return HANDLE;
}

pub fn end_action_slot() -> str {
    return CTA;
}

pub fn screen_w(vertical: bool) -> u32 {
    return cut_w(vertical);
}

pub fn screen_h(vertical: bool) -> u32 {
    return cut_h(vertical);
}

pub fn templates_shell_blocked() -> bool {
    return window_shell() == "blocked" and GLASS_OPEN == false;
}

invariant templates_keep_the_shell_blocked_and_one_idea {
    assert templates_shell_blocked();
    assert screen_ok(screen_ideas(SCREEN_TITLE));
    assert screen_ok(screen_ideas(SCREEN_IDEA));
    assert screen_ok(screen_ideas(SCREEN_END));
}

test the_contract_version_and_the_blocked_shell {
    assert T27OS_VIDEO_BRAND_V1 == 1;
    assert templates_shell_blocked();
    assert end_card_ok();
    assert default_vertical() == false;
}

test each_screen_is_one_idea_on_an_allowed_builder {
    assert SCREEN_COUNT == 3;
    assert screen_ideas(SCREEN_TITLE) == 1;
    assert screen_ideas(SCREEN_IDEA) == 1;
    assert screen_ideas(SCREEN_END) == 1;
    assert screen_ideas(SCREEN_COUNT) == 0;
    assert screen_ok(screen_ideas(SCREEN_COUNT)) == false;
    assert builder_allowed(screen_builder(SCREEN_TITLE));
    assert builder_allowed(screen_builder(SCREEN_IDEA));
    assert builder_allowed(screen_builder(SCREEN_END));
    assert screen_builder(SCREEN_TITLE) == B_TEXT;
    assert screen_builder(SCREEN_IDEA) == B_TEXT;
    assert screen_builder(SCREEN_END) == B_CARD;
    assert builder_allowed(screen_builder(SCREEN_COUNT)) == false;
}

test the_graphs_use_the_kit_and_the_end_card_names_its_slots {
    let title : UiKit = screen_graph(SCREEN_TITLE);
    let idea : UiKit = screen_graph(SCREEN_IDEA);
    let endc : UiKit = screen_graph(SCREEN_END);
    assert kit_node_count(title) == 1;
    assert kit_node_count(idea) == 1;
    assert kit_node_count(endc) == 5;
    assert kit_parents_first(title);
    assert kit_parents_first(idea);
    assert kit_parents_first(endc);
    assert kit_variant_at(title, 0) == KV_PRIMARY;
    assert kit_variant_at(idea, 0) == KV_SECONDARY;
    assert end_title_slot() == "trinity-triangle";
    assert end_body_slot() == "@t27_lang";
    assert end_action_slot() == "Read the work";
}

test the_default_frame_is_wide_and_tall_is_only_a_request {
    assert screen_w(false) * 9 == screen_h(false) * 16;
    assert screen_w(true) * 16 == screen_h(true) * 9;
    assert screen_w(false) != screen_w(true);
}

test negative_control_refutes_two_ideas_on_one_screen {
    assert screen_ideas(SCREEN_TITLE) != 2;
    assert GLASS_OPEN == false;
}
