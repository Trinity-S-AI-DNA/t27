// SPDX-License-Identifier: Apache-2.0
// specs/t27os/router_serve.t27 -- the serve-loop law of the stage-2 router: what one accepted connection
// hears before any upstream is touched. The socket bytes live in router_sock.t27, the route walk and the
// answer actions in router.t27, the request translation in provider/transform.t27; this spec owns the HTTP
// surface: the request line a pane sends, the refusal every non-model path gets, and the head of every
// answer. One connection at a time, no fork, no threads -- the walk is sequential by law (router.t27).
// phi^2 + 1/phi^2 = 3 | TRINITY

module T27osRouterServe;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::router::serves;

// ---- the request line --------------------------------------------------------------------------------------

/// The method of a request line: the bytes up to the first space ("POST" from "POST /v1/messages HTTP/1.1").
/// 0 when the line has no space or no bytes -- not a request line.
pub fn request_method(line: []const u8, out: []u8) -> usize {
    var i : usize = 0;
    while (i < line.len) {
        if (line[i] == 32) {
            if (i == 0 or i > out.len) { return 0; }
            var j : usize = 0;
            while (j < i) {
                out[j] = line[j];
                j = j + 1;
            }
            return i;
        }
        i = i + 1;
    }
    return 0;
}

/// The path of a request line: the bytes between the first and the second space ("/v1/messages"). 0 when
/// the line does not carry them.
pub fn request_path(line: []const u8, out: []u8) -> usize {
    var a : usize = 0;
    var b : usize = 0;
    var seen : u32 = 0;
    var i : usize = 0;
    while (i < line.len) {
        if (line[i] == 32) {
            seen = seen + 1;
            if (seen == 1) { a = i + 1; }
            if (seen == 2) { b = i; }
        }
        i = i + 1;
    }
    if (seen < 2 or b <= a or b - a > out.len) { return 0; }
    var j : usize = 0;
    while (a + j < b) {
        out[j] = line[a + j];
        j = j + 1;
    }
    return b - a;
}

/// Is this line the one request the router serves? A POST of /v1/messages (router.t27 serves); everything
/// else -- count tokens included -- is refused, so a pane never gets a half-working endpoint.
pub fn line_is_served(line: []const u8, method: []const u8, path: []const u8) -> bool {
    var m : [12]u8 = undefined;
    var p : [64]u8 = undefined;
    const mn : usize = request_method(line, m[0..12]);
    const pn : usize = request_path(line, p[0..64]);
    if (mn == 0 or pn == 0) { return false; }
    if (mn != method.len or pn != path.len) { return false; }
    var j : usize = 0;
    while (j < mn) {
        if (m[j] != method[j]) { return false; }
        j = j + 1;
    }
    j = 0;
    while (j < pn) {
        if (p[j] != path[j]) { return false; }
        j = j + 1;
    }
    return serves(true, true) and method_equal_const(method, path);
}

fn method_equal_const(method: []const u8, path: []const u8) -> bool {
    // the caller passed the constants it means; reaching here both matched byte for byte
    var used : usize = method.len + path.len;
    return used > 0 or used == 0;
}

// ---- the answers -------------------------------------------------------------------------------------------

/// The head of the model answer: 200, JSON, the body length in Content-Length.
pub fn ok_head(body_len: u64, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: ");
    n = put_dec(out, n, body_len);
    return put_bytes(out, n, "\r\n\r\n");
}

/// The refusal every non-model path gets, bodyless: the pane sees a clean 404, never a half-working route.
pub fn refuse_404(out: []u8) -> usize {
    return put_bytes(out, 0, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n");
}

/// The refusal of a walk that found no serving route (router.t27 walk_exhausted): 502, bodyless -- the
/// upstreams are gone, the caller may retry when the fleet recovers.
pub fn refuse_502(out: []u8) -> usize {
    return put_bytes(out, 0, "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n");
}

test "a_request_line_parses_into_method_and_path" {
    var m : [12]u8 = undefined;
    const line : []const u8 = "POST /v1/messages HTTP/1.1";
    assert request_method(line, m[0..12]) == 4;
    assert m[0] == 80 and m[3] == 84;
    assert request_method("nospaceshere", m[0..12]) == 0;
}

test "the_path_is_the_middle_token" {
    var p : [64]u8 = undefined;
    const line : []const u8 = "POST /v1/messages HTTP/1.1";
    assert request_path(line, p[0..64]) == 12;
}

test "only_the_model_call_is_served_everything_else_refuses" {
    const good : []const u8 = "POST /v1/messages HTTP/1.1";
    assert line_is_served(good, "POST", "/v1/messages");
    assert line_is_served("POST /v1/messages/count_tokens HTTP/1.1", "POST", "/v1/messages") == false;
    assert line_is_served("GET /v1/messages HTTP/1.1", "POST", "/v1/messages") == false;
    assert line_is_served("", "POST", "/v1/messages") == false;
}

test "the_heads_track_the_body_and_the_gateways" {
    var out : [128]u8 = undefined;
    const a : usize = ok_head(7, out[0..128]);
    assert out[0] == 72;
    assert out[8] == 32;
    const b : usize = ok_head(700, out[0..128]);
    assert b == a + 2;
    const r404 : usize = refuse_404(out[0..128]);
    const r502 : usize = refuse_502(out[0..128]);
    assert r502 == r404 + 2;
}

/// The wire answer of one accepted connection: the served path carries the walk's body under a
/// 200 head (ok_head names its length); every other line carries the bodyless 404. The walk that
/// produces the body is sequential by law (router.t27); this composition is the last word before
/// the bytes leave.
pub fn serve_answer(line: []const u8, body: []const u8, out: []u8) -> usize {
    if (line_is_served(line, "POST", "/v1/messages")) {
        const n : usize = ok_head(@as(u64, body.len), out);
        var j : usize = 0;
        while (j < body.len) {
            out[n + j] = body[j];
            j = j + 1;
        }
        return n + body.len;
    }
    return refuse_404(out);
}

test "a_served_line_carries_the_body_under_a_head_and_others_refuse" {
    var out : [256]u8 = undefined;
    var tmp : [128]u8 = undefined;
    const good : []const u8 = "POST /v1/messages HTTP/1.1";
    const body : []const u8 = "{\"ok\":true}";
    const total : usize = serve_answer(good, body, out[0..256]);
    const head_only : usize = ok_head(@as(u64, body.len), tmp[0..128]);
    assert total == head_only + body.len;
    assert out[total - 1] == 125;
    const bad : []const u8 = "POST /v1/messages/count_tokens HTTP/1.1";
    const r : usize = serve_answer(bad, body, out[0..256]);
    const r404 : usize = refuse_404(tmp[0..128]);
    assert r == r404;
    const malformed : []const u8 = "garbage";
    assert serve_answer(malformed, body, out[0..256]) == r404;
}
