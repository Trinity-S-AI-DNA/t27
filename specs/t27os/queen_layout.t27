// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_layout.t27 -- the force layout of the LIVE MYCELIUM band, ported from the
; accepted web reference (t27.ai/t27f/live/, public/t27f/live/t27f_live.js): pairwise repulsion
; 2600/d^2, springs toward a 70 px rest length on the queen's edges, centre gravity 0.004,
; velocity damping 0.82, canvas clamping. The parameters are the reference's own; the law here is
; DETERMINISTIC: positions are a pure function of (n, queen position, canvas, settle frames),
; so the same inputs always draw the same map (the literature's frozen-frame rule: the layout
; moves only while it settles after a topology change, never drifts on silence).
; --
; WHAT IS DECIDED HERE (every rule has a test below): the seed (a golden spiral, the band's own
; signature), the fixed queen node, the three forces and the damping exactly as the reference
; runs them, the velocity cap, the canvas clamp with a margin, and the settle curve. WHAT IS NOT
; HERE: the draw calls and where the row count comes from (glass_window.t27).
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osQueenLayout;

// ---------------------------------------------------------------- the parameters

/// The reference's own constants (t27f_live.js force simulation).
pub const QL_REPULSION : f64 = 2600.0;
pub const QL_SPRING_REST : f64 = 70.0;
pub const QL_SPRING_K : f64 = 0.03;
pub const QL_GRAVITY : f64 = 0.004;
pub const QL_DAMPING : f64 = 0.82;
pub const QL_VEL_CAP : f64 = 12.0;
pub const QL_MIN_DIST2 : f64 = 144.0; // d never below 12 px, so repulsion never explodes
pub const QL_PAD : f64 = 16.0;
pub const QL_SETTLE_MAX : u8 = 50;

/// The golden angle the band is seeded with (its own signature spiral, 137.507 deg).
pub const QL_GOLDEN : f64 = 2.39996322973;

/// cos via Taylor (5 terms) after reducing the angle into [-tau, tau].
pub fn ql_cos(x : f64) -> f64 {
    var a : f64 = x;
    const tau : f64 = 6.28318530718;
    while (a > tau) { a = a - tau; }
    while (a < 0.0 - tau) { a = a + tau; }
    var term : f64 = 1.0;
    var sum : f64 = 1.0;
    var i : u32 = 1;
    while (i <= 6) {
        term = 0.0 - term * a * a / @as(f64, @floatFromInt((2 * i - 1) * (2 * i)));
        sum = sum + term;
        i = i + 1;
    }
    return sum;
}

/// sin via the cos shift by pi/2, same reduction.
pub fn ql_sin(x : f64) -> f64 {
    return ql_cos(x - 1.57079632679);
}

/// sqrt via Newton with a decent seed (the band needs no libm).
pub fn ql_sqrt(x : f64) -> f64 {
    if (x <= 0.0) { return 0.0; }
    var g : f64 = x / 2.0 + 0.5;
    var i : u32 = 0;
    while (i < 24) {
        g = (g + x / g) / 2.0;
        i = i + 1;
    }
    return g;
}

/// Seed agent i of m agents around the canvas centre on the golden spiral, at a radius that
/// steps outward every few indices so seeds never coincide.
pub fn ql_seed_x(i : u32, w : f64) -> f64 {
    const angle : f64 = QL_GOLDEN * (@as(f64, @floatFromInt(i)) + 0.5);
    const dist : f64 = 34.0 + 20.0 * @as(f64, @floatFromInt(i % 5));
    return w / 2.0 + dist * ql_cos(angle);
}

pub fn ql_seed_y(i : u32, h : f64) -> f64 {
    const angle : f64 = QL_GOLDEN * (@as(f64, @floatFromInt(i)) + 0.5);
    const dist : f64 = 34.0 + 20.0 * @as(f64, @floatFromInt(i % 5));
    return h / 2.0 + 30.0 + dist * ql_sin(angle);
}

/// ONE physics iteration over nodes 0..n (node 0 is the QUEEN: fixed, never integrated, but her
/// repulsion and springs act). px/py hold positions in and out; vx/vy are scratch (len >= n).
pub fn ql_step(n : u32, qx : f64, qy : f64, w : f64, h : f64, px : []f64, py : []f64, vx : []f64, vy : []f64) -> void {
    const cx : f64 = w / 2.0;
    const cy : f64 = h / 2.0;
    var i : u32 = 0;
    while (i < n) {
        var fx : f64 = 0.0;
        var fy : f64 = 0.0;
        var j : u32 = 0;
        while (j < n) {
            if (j != i) {
                const dx : f64 = px[i] - px[j];
                const dy : f64 = py[i] - py[j];
                var d2 : f64 = dx * dx + dy * dy;
                if (d2 < QL_MIN_DIST2) { d2 = QL_MIN_DIST2; }
                const d : f64 = ql_sqrt(d2);
                const f : f64 = QL_REPULSION / d2;
                if (d > 0.001) {
                    fx = fx + dx / d * f;
                    fy = fy + dy / d * f;
                }
            }
            j = j + 1;
        }
        if (i > 0) {
            const dx : f64 = px[i] - qx;
            const dy : f64 = py[i] - qy;
            const d : f64 = ql_sqrt(dx * dx + dy * dy);
            if (d > 0.001) {
                const f : f64 = (d - QL_SPRING_REST) * QL_SPRING_K;
                fx = fx - dx / d * f;
                fy = fy - dy / d * f;
            }
        }
        fx = fx - (px[i] - cx) * QL_GRAVITY;
        fy = fy - (py[i] - cy) * QL_GRAVITY;
        if (i > 0) {
            var nvx : f64 = (vx[i] + fx) * QL_DAMPING;
            var nvy : f64 = (vy[i] + fy) * QL_DAMPING;
            const v2 : f64 = nvx * nvx + nvy * nvy;
            if (v2 > QL_VEL_CAP * QL_VEL_CAP) {
                const s : f64 = QL_VEL_CAP / ql_sqrt(v2);
                nvx = nvx * s;
                nvy = nvy * s;
            }
            vx[i] = nvx;
            vy[i] = nvy;
            var nx : f64 = px[i] + nvx;
            var ny : f64 = py[i] + nvy;
            if (nx < QL_PAD) { nx = QL_PAD; }
            if (nx > w - QL_PAD) { nx = w - QL_PAD; }
            if (ny < QL_PAD) { ny = QL_PAD; }
            if (ny > h - QL_PAD) { ny = h - QL_PAD; }
            px[i] = nx;
            py[i] = ny;
        }
        i = i + 1;
    }
}

/// The deterministic map: run `settle` iterations from the golden-spiral seed. The queen stays
/// exactly at (qx, qy); agents 1..n-1 settle into the reference's dynamics and then hold still.
pub fn ql_layout(n : u32, qx : f64, qy : f64, w : f64, h : f64, settle : u8, px : []f64, py : []f64) -> void {
    px[0] = qx;
    py[0] = qy;
    var vx : [17]f64 = undefined;
    var vy : [17]f64 = undefined;
    var i : u32 = 1;
    while (i < n and i < 17) {
        px[i] = ql_seed_x(i - 1, w);
        py[i] = ql_seed_y(i - 1, h);
        vx[i] = 0.0;
        vy[i] = 0.0;
        i = i + 1;
    }
    var k : u8 = 0;
    while (k < settle) {
        ql_step(n, qx, qy, w, h, px, py, vx[0..17], vy[0..17]);
        k = k + 1;
    }
}

// ---------------------------------------------------------------- tests

test the_layout_is_deterministic_for_the_same_inputs {
    var ax : [17]f64 = undefined;
    var ay : [17]f64 = undefined;
    var bx : [17]f64 = undefined;
    var by : [17]f64 = undefined;
    ql_layout(6, 300.0, 60.0, 600.0, 360.0, 40, ax[0..17], ay[0..17]);
    ql_layout(6, 300.0, 60.0, 600.0, 360.0, 40, bx[0..17], by[0..17]);
    var i : u32 = 0;
    while (i < 6) {
        assert(ax[i] == bx[i]);
        assert(ay[i] == by[i]);
        i = i + 1;
    }
}

test the_queen_stays_exactly_where_she_is_put {
    var px : [17]f64 = undefined;
    var py : [17]f64 = undefined;
    ql_layout(5, 300.0, 60.0, 600.0, 360.0, 50, px[0..17], py[0..17]);
    assert(px[0] == 300.0 and py[0] == 60.0);
}

test settled_agents_hold_still_inside_the_canvas {
    var px : [17]f64 = undefined;
    var py : [17]f64 = undefined;
    ql_layout(8, 300.0, 60.0, 600.0, 360.0, 50, px[0..17], py[0..17]);
    var i : u32 = 1;
    while (i < 8) {
        assert(px[i] >= QL_PAD - 0.001 and px[i] <= 600.0 - QL_PAD + 0.001);
        assert(py[i] >= QL_PAD - 0.001 and py[i] <= 360.0 - QL_PAD + 0.001);
        i = i + 1;
    }
    // the frozen frame: settling 5 more moves nobody by more than 4 px
    var bx : [17]f64 = undefined;
    var by : [17]f64 = undefined;
    var j : u32 = 0;
    while (j < 8) { bx[j] = px[j]; by[j] = py[j]; j = j + 1; }
    ql_layout(8, 300.0, 60.0, 600.0, 360.0, 55, px[0..17], py[0..17]);
    j = 1;
    while (j < 8) {
        const dx : f64 = px[j] - bx[j];
        const dy : f64 = py[j] - by[j];
        if (dx < 0.0) { assert(0.0 - dx < 4.0); } else { assert(dx < 4.0); }
        if (dy < 0.0) { assert(0.0 - dy < 4.0); } else { assert(dy < 4.0); }
        j = j + 1;
    }
}

test agents_never_overlap_the_queen_or_each_other {
    var px : [17]f64 = undefined;
    var py : [17]f64 = undefined;
    ql_layout(7, 300.0, 60.0, 600.0, 360.0, 50, px[0..17], py[0..17]);
    var i : u32 = 1;
    while (i < 7) {
        const dqx : f64 = px[i] - px[0];
        const dqy : f64 = py[i] - py[0];
        assert(ql_sqrt(dqx * dqx + dqy * dqy) >= 20.0);
        var j : u32 = i + 1;
        while (j < 7) {
            const dx : f64 = px[i] - px[j];
            const dy : f64 = py[i] - py[j];
            assert(ql_sqrt(dx * dx + dy * dy) >= 18.0);
            j = j + 1;
        }
        i = i + 1;
    }
}

test a_single_agent_hangs_on_the_spring_at_the_rest_length {
    var px : [17]f64 = undefined;
    var py : [17]f64 = undefined;
    ql_layout(2, 300.0, 60.0, 600.0, 360.0, 50, px[0..17], py[0..17]);
    const d : f64 = ql_sqrt((px[1] - 300.0) * (px[1] - 300.0) + (py[1] - 60.0) * (py[1] - 60.0));
    // the spring's rest length is the equilibrium: gravity and the wall clamp stay out of the way
    assert(d > 55.0 and d < 95.0);
}

test the_sqrt_and_trig_are_accurate_enough_for_the_forces {
    assert(ql_sqrt(4.0) > 1.999 and ql_sqrt(4.0) < 2.001);
    assert(ql_sqrt(2.0) > 1.414 and ql_sqrt(2.0) < 1.415);
    assert(ql_cos(0.0) > 0.999 and ql_cos(0.0) < 1.001);
    assert(ql_sin(1.57079632679) > 0.999 and ql_sin(1.57079632679) < 1.001);
    // cos of pi is -1 within the 5-term Taylor at this angle
    assert(ql_cos(3.14159265359) > 0.0 - 1.001 and ql_cos(3.14159265359) < 0.0 - 0.999);
}

invariant the_parameters_are_the_reference_s {
    assert(QL_REPULSION == 2600.0);
    assert(QL_SPRING_REST == 70.0);
    assert(QL_DAMPING == 0.82);
    assert(QL_SETTLE_MAX == 50);
}
