// SPDX-License-Identifier: Apache-2.0
; specs/t27os/t27os_shell.t27 -- the T27 OS shell contract: sidebar sections, domain tab, agent tab, managed window,
; dockable panels. A MODEL ONLY: it draws nothing and the shell is not implemented by this file. Piece 1 of the
; T27 OS Shell epic (see #13895); Closes #13899. Owner, 2026-11-15: .t27 contracts run by t27b, no TypeScript port.
; Owner correction, 2026-11-15: two tab kinds. A DOMAIN tab is titled T27<letter> (T27A .. T27Z, T27TI) with the
; purpose as subtitle; an AGENT tab exists only for a registered role of the agent registry and is titled with that
; registered name, never a name made from a domain purpose.
; Imports, redefines nothing: TOOL_PAGES, INSTRUMENT_LABEL (agent_parts), AN_ROLE_COUNT, AN_ROLE_IDS, AN_ROLE_DOM,
; AN_SLUGS, an_id_ok, an_id_domain, an_domain_of_slug (agent_registry 9f). The window host, regions, kept state and
; task tabs stay in windows, win_layout, window_keep and workspace_tasks, which this file does not touch.
; Domain id caveat: a domain tab binds letter k (1..27) to the registry slug of ordinal k; that ordinal pairing is
; this model's reading of "naming V3" and is held by tests only for self-consistency, not against any host.
; ASCII only (L3), English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osShell;

use std::mem::bytes_eq;
use t27os::agent_parts::TOOL_PAGES;
use t27os::agent_parts::INSTRUMENT_LABEL;
use queen::agent_registry::AN_ROLE_COUNT;
use queen::agent_registry::AN_ROLE_IDS;
use queen::agent_registry::AN_ROLE_DOM;
use queen::agent_registry::AN_SLUGS;
use queen::agent_registry::an_id_ok;
use queen::agent_registry::an_id_domain;
use queen::agent_registry::an_domain_of_slug;

; --- 1. Sidebar sections (FR-001) -------------------------------------------------------------------

pub const SH_SEC_AGENTS : u32 = 0;
pub const SH_SEC_SUBAGENTS : u32 = 1;
pub const SH_SEC_DOMAINS : u32 = 2;
pub const SH_SEC_TASKS : u32 = 3;
pub const SH_SEC_WINDOWS : u32 = 4;
pub const SH_SEC_LOGS : u32 = 5;
pub const SH_SEC_SETTINGS : u32 = 6;
pub const SH_SEC_COUNT : u32 = 7;
pub const SH_SECTION_NAMES : [7]str = ["Agents", "Subagents", "Domains", "Tasks", "Windows", "Logs", "Settings"];
pub const SH_AGENT_ROWS : usize = 27;
pub const SH_DOMAIN_ROWS : usize = 27;

pub fn sh_section_ok(s: u32) -> bool {
    return s < SH_SEC_COUNT;
}

/// Fixed row count of a section. Agents and Domains are 27, Subagents is AN_ROLE_COUNT. Tasks, Windows, Logs and
/// Settings rows come from the live stores (workspace_tasks, the window host), so the model fixes none: 0.
pub fn sh_section_rows(s: u32) -> usize {
    if (s == SH_SEC_AGENTS) { return SH_AGENT_ROWS; }
    if (s == SH_SEC_SUBAGENTS) { return AN_ROLE_COUNT; }
    if (s == SH_SEC_DOMAINS) { return SH_DOMAIN_ROWS; }
    return 0;
}

; --- 2. Domain tab and agent tab (FR-002) -----------------------------------------------------------

/// Domain tab titles, index = letter - 1. Held equal (ASCII upper case) to the t27<letter> tail of
/// INSTRUMENT_LABEL by a test below, so the pairing is checked rather than trusted.
pub const SH_DOMAIN_TITLES : [27]str = [
    "T27A", "T27B", "T27C", "T27D", "T27E", "T27F", "T27G", "T27H", "T27I", "T27J", "T27K", "T27L", "T27M", "T27N",
    "T27O", "T27P", "T27Q", "T27R", "T27S", "T27T", "T27U", "T27V", "T27W", "T27X", "T27Y", "T27Z", "T27TI",
];

/// Title of the domain tab of letter 1..27; "" out of range.
pub fn sh_domain_title(letter: u32) -> []const u8 {
    if (letter < 1 or letter > 27) { return ""; }
    return SH_DOMAIN_TITLES[letter - 1];
}

/// Subtitle (the purpose) of letter 1..27, the sidebar's secondary text; "" out of range.
pub fn sh_domain_purpose(letter: u32) -> []const u8 {
    if (letter < 1 or letter > 27) { return ""; }
    return INSTRUMENT_LABEL[letter - 1];
}

/// True when the title is a TOOL_PAGES word (a purpose word such as CONFORMANCE).
pub fn sh_is_page_word(title: []const u8) -> bool {
    var i : usize = 0;
    while (i < 27) {
        if (bytes_eq(TOOL_PAGES[i], title)) { return true; }
        i = i + 1;
    }
    return false;
}

pub struct SDomainTab {
    pub title : []const u8,
    pub subtitle : []const u8,
    pub domain_id : []const u8,
    pub letter : u32,
}

pub fn sh_domain_tab(letter: u32, slug: []const u8) -> SDomainTab {
    return SDomainTab { title: sh_domain_title(letter), subtitle: sh_domain_purpose(letter), domain_id: slug, letter: letter };
}

/// A domain tab is valid when its letter is 1..27, its title is exactly T27<letter>, it is no purpose word, it has
/// a subtitle, and its domain id is the registry slug of that same ordinal.
pub fn sh_domain_tab_ok(t: SDomainTab) -> bool {
    if (t.letter < 1 or t.letter > 27) { return false; }
    if (t.title.len == 0 or t.domain_id.len == 0 or t.subtitle.len == 0) { return false; }
    if (sh_is_page_word(t.title)) { return false; }
    if (!bytes_eq(t.title, SH_DOMAIN_TITLES[t.letter - 1])) { return false; }
    return an_domain_of_slug(t.domain_id) == t.letter;
}

/// Index of a registered role id in AN_ROLE_IDS, AN_ROLE_COUNT when it is not registered.
pub fn sh_role_index(id: []const u8) -> usize {
    var i : usize = 0;
    while (i < AN_ROLE_COUNT) {
        if (bytes_eq(AN_ROLE_IDS[i], id)) { return i; }
        i = i + 1;
    }
    return AN_ROLE_COUNT;
}

/// The registered name of a role id (the CamelCase part between 0x and @); "" when the id has no @.
pub fn sh_role_name(id: []const u8) -> []const u8 {
    var at : usize = 0;
    while (at < id.len) {
        if (id[at] == 64) { return id[2..at]; }
        at = at + 1;
    }
    return "";
}

pub struct SAgentTab {
    pub owner : []const u8,
    pub title : []const u8,
    pub domain : u8,
    pub settings : bool,
    pub capabilities : bool,
    pub write_scope : bool,
    pub events : bool,
    pub tasks : bool,
}

/// An agent tab for a registered role: the title is the registered name, the domain is the role's own.
pub fn sh_agent_tab(owner: []const u8, caps: bool, scope: bool, events: bool) -> SAgentTab {
    return SAgentTab { owner: owner, title: sh_role_name(owner), domain: an_id_domain(owner), settings: true,
        capabilities: caps, write_scope: scope, events: events, tasks: true };
}

/// Valid: owner is a canonical, registered role id; title non-empty, no TOOL_PAGES word, equal to the registered
/// name; the domain is the role's own; a capability grant and an event stream are present.
pub fn sh_agent_tab_ok(t: SAgentTab) -> bool {
    if (t.owner.len == 0 or t.title.len == 0) { return false; }
    if (!an_id_ok(t.owner)) { return false; }
    if (sh_role_index(t.owner) >= AN_ROLE_COUNT) { return false; }
    if (sh_is_page_word(t.title)) { return false; }
    if (!bytes_eq(t.title, sh_role_name(t.owner))) { return false; }
    if (t.domain != an_id_domain(t.owner)) { return false; }
    if (!t.capabilities or !t.events) { return false; }
    return true;
}

; --- 3. Managed window (FR-003) ---------------------------------------------------------------------

pub const SH_K_SPEC : u32 = 0;
pub const SH_K_TEST : u32 = 1;
pub const SH_K_LOG : u32 = 2;
pub const SH_K_TERMINAL : u32 = 3;
pub const SH_K_GRAPH : u32 = 4;
pub const SH_K_BROWSER : u32 = 5;
pub const SH_K_SETTINGS : u32 = 6;
pub const SH_KIND_COUNT : u32 = 7;

pub const SH_S_FOCUSED : u32 = 0;
pub const SH_S_MINIMIZED : u32 = 1;
pub const SH_S_MAXIMIZED : u32 = 2;
pub const SH_S_CLOSED : u32 = 3;
pub const SH_S_NORMAL : u32 = 4;
pub const SH_STATE_COUNT : u32 = 5;

pub const SH_Z_LEFT : u32 = 0;
pub const SH_Z_RIGHT : u32 = 1;
pub const SH_Z_BOTTOM : u32 = 2;
pub const SH_Z_CENTER : u32 = 3;
pub const SH_Z_FLOATING : u32 = 4;
pub const SH_ZONE_COUNT : u32 = 5;

pub const SH_EV_FOCUS : u32 = 0;
pub const SH_EV_MINIMIZE : u32 = 1;
pub const SH_EV_MAXIMIZE : u32 = 2;
pub const SH_EV_RESTORE : u32 = 3;
pub const SH_EV_CLOSE : u32 = 4;

pub struct SWindow {
    pub owner : []const u8,
    pub domain : u8,
    pub kind : u32,
    pub zone : u32,
    pub state : u32,
    pub prev : u32,
}

pub fn sh_window(owner: []const u8, domain: u8, kind: u32, zone: u32) -> SWindow {
    return SWindow { owner: owner, domain: domain, kind: kind, zone: zone, state: SH_S_NORMAL, prev: SH_S_NORMAL };
}

/// Refused: no owner, no domain (1..27), a kind, zone or state out of range.
pub fn sh_window_ok(w: SWindow) -> bool {
    if (w.owner.len == 0) { return false; }
    if (w.domain < 1 or w.domain > 27) { return false; }
    if (w.kind >= SH_KIND_COUNT or w.zone >= SH_ZONE_COUNT) { return false; }
    if (w.state >= SH_STATE_COUNT or w.prev >= SH_STATE_COUNT) { return false; }
    return true;
}

fn sh_with(w: SWindow, state: u32, prev: u32) -> SWindow {
    return SWindow { owner: w.owner, domain: w.domain, kind: w.kind, zone: w.zone, state: state, prev: prev };
}

/// Pure transition. A refused window, a closed window (close is final) and an event that does not apply return the
/// window unchanged. Focus works on normal windows, never on a minimized one (restore it first).
/// Minimize and maximize remember the state they leave; restore (from minimized or maximized) returns to it.
pub fn sh_apply(w: SWindow, ev: u32) -> SWindow {
    if (!sh_window_ok(w)) { return w; }
    if (w.state == SH_S_CLOSED) { return w; }
    if (ev == SH_EV_CLOSE) { return sh_with(w, SH_S_CLOSED, w.state); }
    if (ev == SH_EV_FOCUS) {
        if (w.state == SH_S_MINIMIZED) { return w; }
        if (w.state == SH_S_FOCUSED) { return w; }
        if (w.state == SH_S_MAXIMIZED) { return w; }
        return sh_with(w, SH_S_FOCUSED, w.state);
    }
    if (ev == SH_EV_MINIMIZE) {
        if (w.state == SH_S_MINIMIZED) { return w; }
        return sh_with(w, SH_S_MINIMIZED, w.state);
    }
    if (ev == SH_EV_MAXIMIZE) {
        if (w.state == SH_S_MAXIMIZED) { return w; }
        return sh_with(w, SH_S_MAXIMIZED, w.state);
    }
    if (ev == SH_EV_RESTORE) {
        if (w.state != SH_S_MINIMIZED and w.state != SH_S_MAXIMIZED) { return w; }
        var back : u32 = w.prev;
        if (back == SH_S_MINIMIZED or back == SH_S_MAXIMIZED or back == SH_S_CLOSED) { back = SH_S_NORMAL; }
        return sh_with(w, back, SH_S_NORMAL);
    }
    return w;
}

; --- 4. Dockable panels (FR-004) --------------------------------------------------------------------

pub const SH_P_SIDEBAR : u32 = 0;
pub const SH_P_INSPECTOR : u32 = 1;
pub const SH_P_LOG : u32 = 2;
pub const SH_P_COMMAND : u32 = 3;
pub const SH_PANEL_COUNT : u32 = 4;

/// Zone of a panel: sidebar left, inspector right, log bottom. The command bar spans the top of the content, so it
/// takes the center zone (the five zones of FR-003 have no top). An unknown panel floats.
pub fn sh_panel_zone(p: u32) -> u32 {
    if (p == SH_P_SIDEBAR) { return SH_Z_LEFT; }
    if (p == SH_P_INSPECTOR) { return SH_Z_RIGHT; }
    if (p == SH_P_LOG) { return SH_Z_BOTTOM; }
    if (p == SH_P_COMMAND) { return SH_Z_CENTER; }
    return SH_Z_FLOATING;
}

; --- Tests ------------------------------------------------------------------------------------------

test sidebar_sections_in_the_owners_order {
    assert SH_SECTION_NAMES.len == 7;
    assert SH_SECTION_NAMES[0] == "Agents";
    assert SH_SECTION_NAMES[1] == "Subagents";
    assert SH_SECTION_NAMES[2] == "Domains";
    assert SH_SECTION_NAMES[3] == "Tasks";
    assert SH_SECTION_NAMES[4] == "Windows";
    assert SH_SECTION_NAMES[5] == "Logs";
    assert SH_SECTION_NAMES[6] == "Settings";
    assert SH_SEC_COUNT == 7;
    assert SH_SEC_SETTINGS == 6;
}

test sidebar_row_counts_and_negative_control {
    assert sh_section_rows(SH_SEC_AGENTS) == 27;
    assert sh_section_rows(SH_SEC_DOMAINS) == 27;
    assert sh_section_rows(SH_SEC_SUBAGENTS) == AN_ROLE_COUNT;
    assert sh_section_rows(SH_SEC_TASKS) == 0;
    assert sh_section_ok(6);
    assert !sh_section_ok(7);
    assert sh_section_rows(7) == 0;
    assert sh_section_rows(SH_SEC_SUBAGENTS) != 27;
}

test domain_titles_are_t27_letters_and_match_agent_parts {
    assert sh_domain_title(6) == "T27F";
    assert sh_domain_title(1) == "T27A";
    assert sh_domain_title(26) == "T27Z";
    assert sh_domain_title(27) == "T27TI";
    assert sh_domain_title(0) == "";
    assert sh_domain_title(28) == "";
    assert sh_domain_purpose(6) == "FORMAL CONFORMANCE";
    var i : usize = 0;
    while (i < 27) {
        const lo : []const u8 = INSTRUMENT_LABEL[27 + i];
        const up : []const u8 = SH_DOMAIN_TITLES[i];
        assert lo.len == up.len;
        var k : usize = 0;
        while (k < lo.len) {
            var c : u8 = lo[k];
            if (c >= 97 and c <= 122) { c = c - 32; }
            assert c == up[k];
            k = k + 1;
        }
        i = i + 1;
    }
}

test domain_tab_accepts_its_own_letter_and_refuses_a_page_word {
    const t : SDomainTab = sh_domain_tab(6, AN_SLUGS[5]);
    assert sh_domain_tab_ok(t);
    assert sh_domain_tab_ok(sh_domain_tab(27, AN_SLUGS[26]));
    const bad : SDomainTab = SDomainTab { title: "CONFORMANCE", subtitle: t.subtitle, domain_id: t.domain_id, letter: 6 };
    assert !sh_domain_tab_ok(bad);
    assert sh_is_page_word("CONFORMANCE");
    assert !sh_is_page_word("T27F");
}

test domain_tab_refusals_each_have_a_control {
    const t : SDomainTab = sh_domain_tab(6, AN_SLUGS[5]);
    assert sh_domain_tab_ok(t);
    assert !sh_domain_tab_ok(SDomainTab { title: t.title, subtitle: t.subtitle, domain_id: "", letter: 6 });
    assert !sh_domain_tab_ok(SDomainTab { title: t.title, subtitle: t.subtitle, domain_id: t.domain_id, letter: 0 });
    assert !sh_domain_tab_ok(SDomainTab { title: t.title, subtitle: t.subtitle, domain_id: t.domain_id, letter: 28 });
    assert !sh_domain_tab_ok(SDomainTab { title: "T27G", subtitle: t.subtitle, domain_id: t.domain_id, letter: 6 });
    assert !sh_domain_tab_ok(SDomainTab { title: t.title, subtitle: "", domain_id: t.domain_id, letter: 6 });
    assert !sh_domain_tab_ok(sh_domain_tab(6, AN_SLUGS[6]));
}

test agent_tab_for_a_registered_role_is_valid {
    const id : []const u8 = AN_ROLE_IDS[4];
    const t : SAgentTab = sh_agent_tab(id, true, true, true);
    assert t.title == "Compiler";
    assert t.domain == AN_ROLE_DOM[4];
    assert sh_agent_tab_ok(t);
    assert sh_role_index(id) == 4;
    assert sh_role_name("0xDoctor@operations.t27") == "Doctor";
}

test agent_tab_refusals_each_have_a_control {
    const id : []const u8 = AN_ROLE_IDS[4];
    const ok : SAgentTab = sh_agent_tab(id, true, true, true);
    assert sh_agent_tab_ok(ok);
    assert !sh_agent_tab_ok(sh_agent_tab("", true, true, true));
    assert !sh_agent_tab_ok(SAgentTab { owner: id, title: "", domain: ok.domain, settings: true, capabilities: true, write_scope: true, events: true, tasks: true });
    assert !sh_agent_tab_ok(SAgentTab { owner: id, title: "CONFORMANCE", domain: ok.domain, settings: true, capabilities: true, write_scope: true, events: true, tasks: true });
    assert !sh_agent_tab_ok(SAgentTab { owner: id, title: "Linker", domain: ok.domain, settings: true, capabilities: true, write_scope: true, events: true, tasks: true });
    assert !sh_agent_tab_ok(sh_agent_tab("bogus", true, true, true));
    assert !sh_agent_tab_ok(sh_agent_tab("0xNobody@build.t27", true, true, true));
    assert !sh_agent_tab_ok(sh_agent_tab(id, false, true, true));
    assert !sh_agent_tab_ok(sh_agent_tab(id, true, true, false));
    assert !sh_agent_tab_ok(SAgentTab { owner: id, title: ok.title, domain: 27, settings: true, capabilities: true, write_scope: true, events: true, tasks: true });
}

test window_validity_refuses_no_owner_and_no_domain {
    const w : SWindow = sh_window("0xCompiler@build.t27", 2, SH_K_SPEC, SH_Z_CENTER);
    assert sh_window_ok(w);
    assert w.state == SH_S_NORMAL;
    assert !sh_window_ok(sh_window("", 2, SH_K_SPEC, SH_Z_CENTER));
    assert !sh_window_ok(sh_window("0xCompiler@build.t27", 0, SH_K_SPEC, SH_Z_CENTER));
    assert !sh_window_ok(sh_window("0xCompiler@build.t27", 28, SH_K_SPEC, SH_Z_CENTER));
    assert !sh_window_ok(sh_window("0xCompiler@build.t27", 2, 7, SH_Z_CENTER));
    assert !sh_window_ok(sh_window("0xCompiler@build.t27", 2, SH_K_SPEC, 5));
    assert sh_window_ok(sh_window("0xCompiler@build.t27", 2, SH_K_SETTINGS, SH_Z_FLOATING));
}

test minimize_then_restore_returns_to_the_prior_state {
    const w : SWindow = sh_window("0xCompiler@build.t27", 2, SH_K_TEST, SH_Z_BOTTOM);
    const f : SWindow = sh_apply(w, SH_EV_FOCUS);
    assert f.state == SH_S_FOCUSED;
    const m : SWindow = sh_apply(f, SH_EV_MINIMIZE);
    assert m.state == SH_S_MINIMIZED;
    const r : SWindow = sh_apply(m, SH_EV_RESTORE);
    assert r.state == SH_S_FOCUSED;
    const n : SWindow = sh_apply(sh_apply(w, SH_EV_MINIMIZE), SH_EV_RESTORE);
    assert n.state == SH_S_NORMAL;
    assert sh_apply(w, SH_EV_RESTORE).state == SH_S_NORMAL;
    assert sh_apply(m, SH_EV_FOCUS).state == SH_S_MINIMIZED;
    assert sh_apply(m, SH_EV_MINIMIZE).state == SH_S_MINIMIZED;
}

test maximize_and_restore_and_negative_control {
    const w : SWindow = sh_window("0xCompiler@build.t27", 2, SH_K_GRAPH, SH_Z_CENTER);
    const x : SWindow = sh_apply(w, SH_EV_MAXIMIZE);
    assert x.state == SH_S_MAXIMIZED;
    assert sh_apply(x, SH_EV_MAXIMIZE).state == SH_S_MAXIMIZED;
    assert sh_apply(x, SH_EV_RESTORE).state == SH_S_NORMAL;
    const mm : SWindow = sh_apply(x, SH_EV_MINIMIZE);
    assert mm.state == SH_S_MINIMIZED;
    assert sh_apply(mm, SH_EV_RESTORE).state == SH_S_MAXIMIZED;
    assert sh_apply(w, SH_EV_MAXIMIZE).state != SH_S_NORMAL;
    assert sh_apply(w, 99).state == SH_S_NORMAL;
}

test close_is_final {
    const w : SWindow = sh_window("0xCompiler@build.t27", 2, SH_K_LOG, SH_Z_BOTTOM);
    const c : SWindow = sh_apply(w, SH_EV_CLOSE);
    assert c.state == SH_S_CLOSED;
    assert sh_apply(c, SH_EV_RESTORE).state == SH_S_CLOSED;
    assert sh_apply(c, SH_EV_FOCUS).state == SH_S_CLOSED;
    assert sh_apply(c, SH_EV_MINIMIZE).state == SH_S_CLOSED;
    assert sh_apply(c, SH_EV_MAXIMIZE).state == SH_S_CLOSED;
    assert sh_apply(sh_apply(w, SH_EV_MINIMIZE), SH_EV_CLOSE).state == SH_S_CLOSED;
    assert w.state != SH_S_CLOSED;
}

test refused_window_does_not_transition {
    const bad : SWindow = sh_window("", 2, SH_K_LOG, SH_Z_BOTTOM);
    assert sh_apply(bad, SH_EV_MAXIMIZE).state == SH_S_NORMAL;
    assert sh_apply(bad, SH_EV_CLOSE).state == SH_S_NORMAL;
    assert SH_KIND_COUNT == 7;
    assert SH_STATE_COUNT == 5;
    assert SH_ZONE_COUNT == 5;
}

test panels_occupy_their_zones {
    assert SH_PANEL_COUNT == 4;
    assert sh_panel_zone(SH_P_SIDEBAR) == SH_Z_LEFT;
    assert sh_panel_zone(SH_P_INSPECTOR) == SH_Z_RIGHT;
    assert sh_panel_zone(SH_P_LOG) == SH_Z_BOTTOM;
    assert sh_panel_zone(SH_P_COMMAND) == SH_Z_CENTER;
    assert sh_panel_zone(9) == SH_Z_FLOATING;
    assert sh_panel_zone(SH_P_LOG) != SH_Z_LEFT;
}
