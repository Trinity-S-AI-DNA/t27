test the_live_page_is_transparent_glass_in_a_window_and_black_in_full_screen {
    var b : [320]u8 = undefined;
    var n : usize = live_css(false, b[0..320]);
    assert gal_find(b[0..320], n, 0, "transparent") < n;
    assert gal_find(b[0..320], n, 0, "#000") == n;
    assert gal_find(b[0..320], n, 0, ".t27-widget-page") < n;
    assert gal_find(b[0..320], n, 0, "--w-bg") < n;
    n = live_css(true, b[0..320]);
    assert gal_find(b[0..320], n, 0, "#000") < n;
    assert gal_find(b[0..320], n, 0, "transparent") == n;
    n = live_js(false, true, b[0..320]);
    assert gal_find(b[0..320], n, 0, "createElement") < n;
    assert gal_find(b[0..320], n, 0, "transparent") < n;
    assert b[n] == 0;
    n = live_js(true, false, b[0..320]);
    assert gal_find(b[0..320], n, 0, "getElementById") < n;
    assert gal_find(b[0..320], n, 0, "#000") < n;
}

test letter_c_opens_with_a_two_by_two_agents_block_and_the_tiles_flow_around_it {
    const pw : f64 = 688.0;
    assert tile_cols(pw) == 5;
    assert big_cols(3, pw) == 2 and big_cols(4, pw) == 0;
    assert big_cols(3, 200.0) == 1;
    // tiles skip the block's 2 x 2 cells: first row starts at column 2, row 2 starts at column 2, then full rows
    assert slot_cell(3, 0, pw) == 2 and slot_cell(3, 2, pw) == 4;
    assert slot_cell(3, 3, pw) == 7 and slot_cell(3, 5, pw) == 9;
    assert slot_cell(3, 6, pw) == 10 and slot_cell(3, 7, pw) == 11;
    assert slot_cell(4, 7, pw) == 7;
    var j : u32 = 0;
    while (j < 30) {
        assert slot_cell(3, j, pw) != 0 and slot_cell(3, j, pw) != 1 and slot_cell(3, j, pw) != 5 and slot_cell(3, j, pw) != 6;
        assert slot_cell(3, j, pw) < slot_cell(3, j + 1, pw);
        j = j + 1;
    }
    // the block is larger than any tile: 2 columns x 2 rows
    assert big_w(3, pw) > 2.0 * tile_w(pw) and big_h(pw) > 2.0 * cell_h(pw);
    // the '+' tile follows the last tile; an empty C console still fills the block
    assert con_cells(3, 0, pw) == 10;
    assert con_cells(3, 8, pw) == slot_cell(3, 8, pw) + 1;
    assert con_cells(4, 0, pw) == 1;
    // one column: the block is 1 column wide and 2 rows high, tiles go below
    assert slot_cell(3, 0, 200.0) == 2 * tile_cols(200.0);
    var ncon : [32]u32 = undefined;
    const na : u32 = plan(3, ncon[0..32]);
    const top : f64 = con_top(3, ncon[0..32], na, pw, 0);
    assert dash_hit2(3, ncon[0..32], na, pw, CPAD + 10.0, top + CON_HEAD + 10.0) == hit_pack(HC_CHAT, 0);
    assert dash_hit2(3, ncon[0..32], na, pw, CPAD + big_w(3, pw) - 2.0, top + CON_HEAD + big_h(pw) - 2.0) == hit_pack(HC_CHAT, 0);
    assert hit_class(dash_hit2(4, ncon[0..32], plan(4, ncon[0..32]), pw, CPAD + 10.0, con_top(4, ncon[0..32], 1, pw, 0) + CON_HEAD + 10.0)) != HC_CHAT;
}

test the_plus_tile_ends_every_grid_and_pinned_tiles_get_an_unpin_corner {
    const pw : f64 = 688.0;
    var ncon : [32]u32 = undefined;
    var o : u32 = 1;
    while (o <= LETTER_COUNT) {
        const na : u32 = plan(o, ncon[0..32]);
        ncon[1] = 2;
        const n : u32 = con_n(ncon[0..32], 0);
        assert n == parts_of_letter(o) + 2;
        const top : f64 = con_top(o, ncon[0..32], na, pw, 0);
        const px : f64 = tile_rx(o, n, pw) + 0.5 * tile_w(pw);
        const py : f64 = top + tile_ry(o, n, pw) + 0.5 * tile_h(pw);
        assert dash_hit2(o, ncon[0..32], na, pw, px, py) == hit_pack(HC_PLUS, 0);
        // pinned tile 1: its centre is HC_PIN, its top-right corner HC_UNPIN
        const t1 : u32 = ncon[0] + 1;
        const cx : f64 = tile_rx(o, t1, pw);
        const cy : f64 = top + tile_ry(o, t1, pw);
        assert dash_hit2(o, ncon[0..32], na, pw, cx + 0.5 * tile_w(pw), cy + 0.5 * tile_h(pw)) == hit_pack(HC_PIN, 1);
        assert dash_hit2(o, ncon[0..32], na, pw, cx + tile_w(pw) - 3.0, cy + 3.0) == hit_pack(HC_UNPIN, 1);
        o = o + 1;
    }
}

test every_sidebar_area_is_made_of_widgets_and_is_hit {
    const pw : f64 = 688.0;
    var ncon : [32]u32 = undefined;
    var o : u32 = 1;
    while (o <= LETTER_COUNT) {
        const na : u32 = plan(o, ncon[0..32]);
        var k : u32 = SEC_SPECS;
        var prev : f64 = areas_top(o, ncon[0..32], na, pw);
        while (k < SEC_COUNT) {
            assert area_n(k, o) >= 1;
            assert area_top(k, o, ncon[0..32], na, pw) >= prev;
            prev = area_top(k, o, ncon[0..32], na, pw) + area_h(k, o, pw);
            const top : f64 = area_top(k, o, ncon[0..32], na, pw);
            // the last item of every area is hit where it is laid out
            const li : u32 = area_n(k, o) - 1;
            const h : u32 = dash_hit2(o, ncon[0..32], na, pw, area_ix(li, pw) + 2.0, top + area_iy(li, pw) + 2.0);
            assert h == hit_pack(HC_AREA, k * 256 + li);
            k = k + 1;
        }
        assert page_h(o, ncon[0..32], na, pw) == area_top(SEC_COUNT, o, ncon[0..32], na, pw) + END_PAD;
        o = o + 1;
    }
    // C holds 19 tri commands and 2 skills; PULSE is 4 widgets; HOME lists the other letters of t27c's home
    assert area_n(SEC_COMMANDS, 3) == 19 and area_n(SEC_SKILLS, 3) == 2 and area_n(SEC_PULSE, 3) == 4;
    assert area_n(SEC_HOME, 3) == agents_in(home_of_letter(3)) - 1;
    // a letter with no tools or skills shows one widget that says so
    assert area_n(SEC_COMMANDS, 21) == 1 and area_n(SEC_SKILLS, 21) == 1;
    assert area_n(SEC_SPECS, 7) == 1 + 3;
    assert area_n(SEC_OVERVIEW, 3) == 0;
}

test the_home_area_lists_the_other_letters_of_the_home {
    var o : u32 = 1;
    while (o <= LETTER_COUNT) {
        var i : u32 = 0;
        while (i < agents_in(home_of_letter(o)) - 1) {
            assert home_other(o, i) != 0 and home_other(o, i) != o;
            assert home_of_letter(home_other(o, i)) == home_of_letter(o);
            i = i + 1;
        }
        assert home_other(o, i) == 0;
        o = o + 1;
    }
}

test tile_code_names_what_the_hit_test_returns {
    const pw : f64 = 688.0;
    var ncon : [32]u32 = undefined;
    const na : u32 = plan(3, ncon[0..32]);
    ncon[1] = 1;
    const top : f64 = con_top(3, ncon[0..32], na, pw, 0);
    var t : u32 = 0;
    while (t < ncon[0] + 1) {
        const h : u32 = dash_hit2(3, ncon[0..32], na, pw, tile_rx(3, t, pw) + 0.5 * tile_w(pw), top + tile_ry(3, t, pw) + 0.5 * tile_h(pw));
        assert h == tile_code(3, t);
        t = t + 1;
    }
}
