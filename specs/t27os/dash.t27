fn put_q(out: []u8, at: usize, s: []const u8) -> usize {
    out[at] = 34;
    const n : usize = put_bytes(out, at + 1, s);
    out[n] = 34;
    return n + 1;
}

fn put_decl(out: []u8, at: usize, name: []const u8, a: []const u8, b: []const u8, c: []const u8) -> usize {
    var n : usize = put_bytes(out, at, "pub const ");
    n = put_bytes(out, n, name);
    n = put_bytes(out, n, " : [3]str = [");
    n = put_q(out, n, a);
    n = put_bytes(out, n, ", ");
    n = put_q(out, n, b);
    n = put_bytes(out, n, ", ");
    n = put_q(out, n, c);
    return put_bytes(out, n, "];\n");
}

test the_gallery_text_is_parsed_not_copied {
    var buf : [1024]u8 = undefined;
    var tab : [2560]u32 = undefined;
    var n : usize = put_bytes(buf[0..1024], 0, "; a comment line about WIDGET_IDS\n");
    n = put_decl(buf[0..1024], n, "WIDGET_IDS", "x7-board", "bit-diff", "zz-unknown");
    n = put_decl(buf[0..1024], n, "WIDGET_KINDS", "cast", "tool", "tab");
    n = put_decl(buf[0..1024], n, "WIDGET_PAGES", "term/x7-board/", "widgets/bit-diff/", "wars");
    assert gal_parse(buf[0..1024], n, tab[0..2560]) == 3;
    assert gal_mapped(tab[0..2560]) == 2;
    assert gal_unassigned(tab[0..2560]) == 1;
    assert gal_len(tab[0..2560], GAL_IDS, 9) == 8;
    assert gal_len(tab[0..2560], GAL_IDS, 1) == 0;
    const s : usize = gal_start(tab[0..2560], GAL_IDS, 9);
    assert buf[s] == 98;
    assert buf[s + 7] == 102;
    assert gal_len(tab[0..2560], GAL_KINDS, 9) == 4;
    assert gal_len(tab[0..2560], GAL_PAGES, 0) == 14;
    var u : [256]u8 = undefined;
    const un : usize = put_page_url(buf[0..1024], tab[0..2560], 9, u[0..256]);
    assert un == 15 + 17;
    assert u[un] == 0;
    assert u[8] == 116;
    const cn : usize = put_card_url(buf[0..1024], tab[0..2560], 0, u[0..256]);
    assert cn == 15 + 14 + 8;
    assert u[cn - 1] == 103;
    assert put_card_url(buf[0..1024], tab[0..2560], 1, u[0..256]) == 0;
    const pn : usize = put_card_path("/Users/me", buf[0..1024], tab[0..2560], 9, u[0..256]);
    assert pn == 9 + 14 + 8 + 4;
    assert u[pn] == 0;
    assert gal_parse(buf[0..1024], 10, tab[0..2560]) == 0;
}

test a_306_row_gallery_on_single_long_lines_maps_the_195_panel_widgets_by_id {
    var buf : [16384]u8 = undefined;
    var tab : [2560]u32 = undefined;
    var n : usize = put_bytes(buf[0..16384], 0, "pub const WIDGET_IDS : [306]str = [");
    var r : u32 = 0;
    while (r < 306) {
        if (r > 0) { n = put_bytes(buf[0..16384], n, ", "); }
        if (r < 111) {
            n = put_bytes(buf[0..16384], n, "\"zz-new-");
            n = put_bytes(buf[0..16384], n, "x\"");
        } else {
            n = put_bytes(buf[0..16384], n, "\"");
            n = put_bytes(buf[0..16384], n, WIDGET_ID[r - 111]);
            n = put_bytes(buf[0..16384], n, "\"");
        }
        r = r + 1;
    }
    n = put_bytes(buf[0..16384], n, "];\npub const WIDGET_KINDS : [306]str = [");
    r = 0;
    while (r < 306) {
        if (r > 0) { n = put_bytes(buf[0..16384], n, ", "); }
        n = put_bytes(buf[0..16384], n, "\"tool\"");
        r = r + 1;
    }
    n = put_bytes(buf[0..16384], n, "];\npub const WIDGET_PAGES : [306]str = [");
    r = 0;
    while (r < 306) {
        if (r > 0) { n = put_bytes(buf[0..16384], n, ", "); }
        n = put_bytes(buf[0..16384], n, "\"w/p/\"");
        r = r + 1;
    }
    n = put_bytes(buf[0..16384], n, "];\n");
    assert gal_parse(buf[0..16384], n, tab[0..2560]) == 306;
    assert gal_total(tab[0..2560]) == 306;
    assert gal_mapped(tab[0..2560]) == 195;
    assert gal_unassigned(tab[0..2560]) == 111;
    assert gal_len(tab[0..2560], GAL_IDS, 0) == 8;
    assert gal_len(tab[0..2560], GAL_IDS, 194) == WIDGET_ID[194].len;
    assert gal_len(tab[0..2560], GAL_PAGES, 194) == 4;
}

test a_gallery_with_one_array_missing_parses_to_zero {
    var buf : [512]u8 = undefined;
    var tab : [2560]u32 = undefined;
