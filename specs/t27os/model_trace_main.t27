// SPDX-License-Identifier: Apache-2.0
; specs/t27os/model_trace_main.t27 -- THE RECORDER: reads the deployed ladder's log and writes the
; trace file the MODEL panel draws (epic #13172, owner 2026-11-04).
; --
; Why a separate program: the log is 13 MB and grows; the window must not read it. This program reads
; the tail (16 MB), turns every ladder line into a model_trace record with model_log.t27, keeps the
; last 64, and writes ~/.t27os/model-trace.tsv:
;     trace v1 total=<n> ok=<n> unfunded=<n> other=<n> wasted_ms=<n> rows=<n> start=<i>
;     <23 cells, comma separated>
;     ...
; It prints one line on success so a run is observable without opening the window, and exits 3 when
; the log is absent -- an absent log is "nothing recorded", never "no failures".
; Env: T27_LADDER_LOG (default $HOME/.t27os/ladder.log), T27_MODEL_TRACE (default
; $HOME/.t27os/model-trace.tsv). No secrets: the log holds none and this program reads nothing else.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsModelTraceMain;

use t27os::model_trace::TR_CELLS;
use t27os::model_log::scan_log;
use t27os::model_log::put_cells;
use t27os::model_log::q_log;
use t27os::model_log::ML_T_CELLS;
use t27os::model_log::ML_T_TOTAL;
use t27os::model_log::ML_T_OK;
use t27os::model_log::ML_T_UNFUNDED;
use t27os::model_log::ML_T_OTHER;
use t27os::model_log::ML_T_WASTED_MS;
use t27os::model_log::ML_T_ROWS;
use t27os::model_log::ML_T_START;
use t27os::pty_sys::sys_open_ro;
use t27os::pty_sys::sys_creat;
use t27os::pty_sys::sys_read;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_exit;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

fn sys_lseek(fd : i32, off : i64, whence : i32) -> i64 { return @extern("lseek"); }

pub const CAP : u32 = 64;
pub const BUF_BYTES : usize = 65536;
pub var ML_BUF : [BUF_BYTES]u8 = undefined;

fn env_into(name : []const u8, dst : []u8, max : usize) -> usize {
    const p : u64 = sys_getenv(name);
    if (p == 0) { return 0; }
    const l : u64 = sys_strlen(p);
    if (l == 0 or l > @as(u64, @intCast(max))) { return 0; }
    _ = sys_peek(dst, p, l);
    return @as(usize, @intCast(l));
}

/// NUL-terminated path: home + suffix.
fn home_path(home : []const u8, hn : usize, suffix : []const u8, out : []u8) -> usize {
    var n : usize = put_bytes(out, 0, home[0..hn]);
    n = put_bytes(out, n, suffix);
    out[n] = 0;
    return n;
}

pub fn main() -> void {
    _ = sys_write(2, "A\n", 2);
    var home : [256]u8 = undefined;
    const hn : usize = env_into("HOME", home[0..256], 250);
    if (hn == 0) { sys_exit(2); }
    var lp : [320]u8 = undefined;
    var ln : usize = env_into("T27_LADDER_LOG", lp[0..320], 300);
    if (ln == 0) { ln = home_path(home[0..256], hn, "/.t27os/ladder.log", lp[0..320]); }
    else { lp[ln] = 0; }
    var tp : [320]u8 = undefined;
    var tn : usize = env_into("T27_MODEL_TRACE", tp[0..320], 300);
    if (tn == 0) { tn = home_path(home[0..256], hn, "/.t27os/model-trace.tsv", tp[0..320]); }
    else { tp[tn] = 0; }

    _ = sys_write(2, "B\n", 2);
    const fd : i32 = sys_open_ro(lp[0..320], 0);
    if (fd < 0) { sys_exit(3); }
    // the tail, so a log larger than the buffer still yields its newest requests; the first partial
    // line cannot parse and is skipped by the scanner
    const sz : i64 = sys_lseek(fd, 0, 2);
    if (sz > @as(i64, @intCast(BUF_BYTES))) { _ = sys_lseek(fd, sz - @as(i64, @intCast(BUF_BYTES)), 0); }
    else { _ = sys_lseek(fd, 0, 0); }
    var n : usize = 0;
    while (n < BUF_BYTES) {
        const r : i64 = sys_read(fd, ML_BUF[n..BUF_BYTES], @as(u64, @intCast(BUF_BYTES - n)));
        if (r <= 0) { break; }
        n = n + @as(usize, @intCast(r));
    }
    sys_close(fd);
    if (n == 0) { sys_exit(3); }

    _ = sys_write(2, "C\n", 2);
    var rows : [CAP * TR_CELLS]u64 = undefined;
    var t : [ML_T_CELLS]u64 = undefined;
    scan_log(ML_BUF[0..BUF_BYTES], n, rows[0..CAP * TR_CELLS], CAP, t[0..ML_T_CELLS]);

    // one row is at most 23 cells of 20 digits and a comma; 512 bytes per row is a safe ceiling
    _ = sys_write(2, "D\n", 2);
    var out : [CAP * 512 + 256]u8 = undefined;
    var w : usize = put_bytes(out, 0, "trace v1 total=");
    w = put_dec(out, w, t[ML_T_TOTAL]);
    w = put_bytes(out, w, " ok=");
    w = put_dec(out, w, t[ML_T_OK]);
    w = put_bytes(out, w, " unfunded=");
    w = put_dec(out, w, t[ML_T_UNFUNDED]);
    w = put_bytes(out, w, " other=");
    w = put_dec(out, w, t[ML_T_OTHER]);
    w = put_bytes(out, w, " wasted_ms=");
    w = put_dec(out, w, t[ML_T_WASTED_MS]);
    w = put_bytes(out, w, " rows=");
    w = put_dec(out, w, t[ML_T_ROWS]);
    w = put_bytes(out, w, " start=");
    w = put_dec(out, w, t[ML_T_START]);
    w = put_bytes(out, w, "\n");
    var i : u32 = 0;
    while (i < t[ML_T_ROWS]) {
        const at : usize = (@as(usize, t[ML_T_START]) + @as(usize, i)) % @as(usize, CAP);
        w = put_cells(rows[at * TR_CELLS .. at * TR_CELLS + TR_CELLS], out[w..]);
        w = put_bytes(out, w, "\n");
        i = i + 1;
    }

    _ = sys_write(2, "E\n", 2);
    const ofd : i32 = sys_creat(tp[0..320], 420);
    if (ofd < 0) { sys_exit(4); }
    var done : usize = 0;
    while (done < w) {
        const r : i64 = sys_write(ofd, out[done..w], @as(u64, @intCast(w - done)));
        if (r <= 0) { sys_close(ofd); sys_exit(4); }
        done = done + @as(usize, @intCast(r));
    }
    sys_close(ofd);

    var line : [128]u8 = undefined;
    var qn : usize = q_log(t[0..ML_T_CELLS], line[0..128]);
    qn = put_bytes(line[0..128], qn, " rows=");
    qn = put_dec(line[0..128], qn, t[ML_T_ROWS]);
    qn = put_bytes(line[0..128], qn, " -> ");
    qn = put_bytes(line[0..128], qn, tp[0..tn]);
    qn = put_bytes(line[0..128], qn, "\n");
    _ = sys_write(1, line[0..128], @as(u64, @intCast(qn)));
    sys_exit(0);
}

test the_header_of_the_trace_file_parses_back_to_its_totals {
    // the file's first line is the contract the panel reads; the counts are written, not recomputed
    var out : [160]u8 = undefined;
    var w : usize = put_bytes(out[0..160], 0, "trace v1 total=");
    w = put_dec(out[0..160], w, 13069);
    w = put_bytes(out[0..160], w, " ok=");
    w = put_dec(out[0..160], w, 12479);
    w = put_bytes(out[0..160], w, " unfunded=");
    w = put_dec(out[0..160], w, 590);
    assert w == 42;
}
