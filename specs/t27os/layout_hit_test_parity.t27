// specs/t27os/layout_hit_test_parity.t27 -- Layout/hit-test parity suite for
// QUEEN CHAT.
// Part of M4 milestone (milestone #8). Closes #13187.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::layout_hit_test_parity;

pub const LAYOUT_HIT_TEST_PARITY_MAX_CHECKS : u32 = 16;

pub struct ParityCheck { check_id: str, layout_matches_hit_test: bool };

pub fn layout_hit_test_parity_ok(p: ParityCheck) -> bool {
    return p.layout_matches_hit_test;
}

test "layout_hit_test_parity_ok" {
    assert(layout_hit_test_parity_ok(ParityCheck { check_id: "check-1", layout_matches_hit_test: true }));
    assert(!layout_hit_test_parity_ok(ParityCheck { check_id: "check-2", layout_matches_hit_test: false }));
}

invariant layout_hit_test_parity_max_checks_positive {
    assert LAYOUT_HIT_TEST_PARITY_MAX_CHECKS > 0;
}