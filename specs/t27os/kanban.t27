// SPDX-License-Identifier: Apache-2.0
; specs/t27os/kanban.t27 -- t27k, the KANBAN board of T27 OS: issues and pull requests as cards, 100% widgets
; Owner, 2026-10-20 (decided): T27 OS is an ergonomic project-management system; each letter is a tool t27<letter>
; with its own page; K is t27k, the kanban board, and everything on the page is a widget. Closes #11275.
; ASCII only (L3), English only (LANG-EN). Artifact it draws (toolchain.t27 rule): the HUD view kanban of the app
; (agent_parts SURFACE_IDS "kanban", letter 10 there, hence the page moves to petal K) and `tri issues`.
; --
; The tree. BOARD holds 5 COLUMNs (BACKLOG, TODO, DOING, REVIEW, DONE); a COLUMN holds CARDs; a CARD holds
; CHIPs (the pinned agents, owner first) and BADGEs (the labels). Layout is the packer of dash.t27 (used, not
; copied): the columns are one row of 5, the cards of a column are one column of 1.
; --
; The host feeds LINES, LF separated, fields KB_TAB separated, no JSON in the spec (the host formats):
;   issue KB_TAB num KB_TAB state KB_TAB title KB_TAB labels KB_TAB paths KB_TAB letters
;     gh issue list --state all --limit 200 --json number,state,title,labels,body,closedAt
;     the host prints state as open, or closed/<days since closed>; labels and paths are comma lists;
;     paths are the Boundary paths of the issue body (specs/policy/issue_shape.t27), the first is the main one.
;   pr KB_TAB num KB_TAB state KB_TAB closes KB_TAB checks KB_TAB title KB_TAB paths KB_TAB letters
;     gh pr list --state all --limit 200 --json number,state,title,closingIssuesReferences,statusCheckRollup,
;       reviewRequests,files,mergedAt
;     state is open, merged/<days> or closed/<days>; closes is the issue number or 0; checks is one of
;     running, review (a review is requested), pass, fail, none; paths are the files the PR changes.
; --
; COLUMN RULE (column()): an open issue with no open PR is TODO, BACKLOG when labelled backlog; an open issue with
; an open PR is DOING; an open PR with checks running or a review requested is REVIEW (its issue folds into the PR
; card and is not drawn twice); a PR whose checks failed or are absent stays with its issue in DOING (folded); a
; merged PR, or a closed issue with no merged PR, is DONE for 7 days after closing; a PR closed unmerged is not drawn.
; --
; AGENTS of a card: the LAST field of its line, a comma list of letters 1..27, owner first, distinct, at most
; MAX_CHIPS used. The host fills it with domain_pulse::letter_of_path over each path (the Boundary paths of an
; issue, the files of a PR). The spec does not call domain_pulse itself: that module reads the 27 agent specs by
; module-qualified path, which neither gen nor t27b can splice into an importer (checked 2026-10-20), so the pin
; between paths and letters is the test `kanban_sample_paths_are_owned_by_the_letters_of_its_lines` in
; domain_pulse.t27, where those paths are resolved. A card whose list is empty is pinned to
; FALLBACK_LETTER (S, who owns ownership, as evolve.t27 decides for unowned paths): every card has >= 1 agent.
; The card's TOOL letter is its first agent (card_tool); the tool name and page come from agent_parts.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osKanban;

use t27os::dash::cell_w;
use t27os::dash::dash_cell_x;
use t27os::dash::dash_cell_y;
use t27os::dash::pack_h;
use t27os::dash::pack_at;
use t27os::evolve::why_not;
use t27os::evolve::R_AGENT_CAP;
use t27os::evolve::LETTER_UNOWNED;

// ---- node kinds of the tree ----
pub const KK_BOARD : u32 = 0;
pub const KK_COLUMN : u32 = 1;
pub const KK_CARD : u32 = 2;
pub const KK_CHIP : u32 = 3;
pub const KK_BADGE : u32 = 4;
pub const KK_KINDS : u32 = 5;

/// Kind of the i-th child kind of a node of kind k; KK_KINDS for none.
pub fn kb_child_kind(k: u32, i: u32) -> u32 {
    if (k == KK_BOARD and i == 0) { return KK_COLUMN; }
    if (k == KK_COLUMN and i == 0) { return KK_CARD; }
    if (k == KK_CARD and i == 0) { return KK_CHIP; }
    if (k == KK_CARD and i == 1) { return KK_BADGE; }
    return KK_KINDS;
}

// ---- columns ----
pub const COL_BACKLOG : u32 = 0;
pub const COL_TODO : u32 = 1;
pub const COL_DOING : u32 = 2;
pub const COL_REVIEW : u32 = 3;
pub const COL_DONE : u32 = 4;
pub const KB_COL_COUNT : u32 = 5;
pub const KB_COL_HIDDEN : u32 = 5;

pub const DONE_DAYS : u32 = 7;
pub const WIP_DOING : u32 = 3;
pub const MAX_CHIPS : u32 = 3;
pub const FALLBACK_LETTER : u32 = 19;
pub const KB_NONE : u32 = 4294967295;

pub fn column_name(c: u32) -> string {
    if (c == COL_BACKLOG) { return "BACKLOG"; }
    if (c == COL_TODO) { return "TODO"; }
    if (c == COL_DOING) { return "DOING"; }
    if (c == COL_REVIEW) { return "REVIEW"; }
    if (c == COL_DONE) { return "DONE"; }
    return "";
}

/// WIP limit of a column, 0 = none. DOING is capped by the agent cap of GOD MODE (evolve.t27 MAX_AGENTS = 3, held equal by a test).
pub fn wip_limit(c: u32) -> u32 {
    if (c == COL_DOING) { return WIP_DOING; }
    return 0;
}

pub fn wip_full(c: u32, count: u32) -> bool {
    const lim : u32 = wip_limit(c);
    if (lim == 0) { return false; }
    return count >= lim;
}

// ---- reading the lines ----
pub const KB_NL : u32 = 10;
pub const KB_TAB : u32 = 9;

/// End of the line that starts at ls: the index of its LF, or the text length.
pub fn kb_line_end(log: string, ls: u32) -> u32 {
    var ii : u32 = ls;
    while (ii < (log.len as u32)) {
        if ((log[ii] as u32) == KB_NL) { return ii; }
        ii = ii + 1;
    }
    return log.len as u32;
}

/// Start of field f of the line at ls, KB_NONE when the line has fewer fields.
pub fn fstart(log: string, ls: u32, f: u32) -> u32 {
    const le : u32 = kb_line_end(log, ls);
    var ii : u32 = ls;
    var ff : u32 = 0;
    while (ff < f) {
        while (ii < le and (log[ii] as u32) != KB_TAB) { ii = ii + 1; }
        if (ii >= le) { return KB_NONE; }
        ii = ii + 1;
        ff = ff + 1;
    }
    return ii;
}

/// End of the field that starts at fs (its KB_TAB, or the line end).
pub fn fend(log: string, fs: u32) -> u32 {
    var ii : u32 = fs;
    while (ii < (log.len as u32)) {
        const c : u32 = log[ii] as u32;
        if (c == KB_TAB or c == KB_NL) { return ii; }
        ii = ii + 1;
    }
    return log.len as u32;
}

/// Length of field f (0 when absent): the counted string of a title, a label list, a path list.
pub fn flen(log: string, ls: u32, f: u32) -> u32 {
    const fs : u32 = fstart(log, ls, f);
    if (fs == KB_NONE) { return 0; }
    return fend(log, fs) - fs;
}

/// Decimal value of log[a..b), stops at the first non-digit.
pub fn dec(log: string, a: u32, b: u32) -> u32 {
    var ii : u32 = a;
    var vv : u32 = 0;
    while (ii < b) {
        const c : u32 = log[ii] as u32;
        if (c < 48 or c > 57) { return vv; }
        vv = vv * 10 + (c - 48);
        ii = ii + 1;
    }
    return vv;
}

pub fn is_pr(log: string, ls: u32) -> bool {
    return (log[ls] as u32) == 112;
}

pub fn card_num(log: string, ls: u32) -> u32 {
    const fs : u32 = fstart(log, ls, 1);
    if (fs == KB_NONE) { return 0; }
    return dec(log, fs, fend(log, fs));
}

/// First byte of the state: o(pen), c(losed), m(erged).
pub fn state_byte(log: string, ls: u32) -> u32 {
    const fs : u32 = fstart(log, ls, 2);
    if (fs == KB_NONE) { return 0; }
    return log[fs] as u32;
}

/// Days since closing: the digits after the slash of the state, 0 when none.
pub fn state_days(log: string, ls: u32) -> u32 {
    const fs : u32 = fstart(log, ls, 2);
    if (fs == KB_NONE) { return 0; }
    const fe : u32 = fend(log, fs);
    var ii : u32 = fs;
    while (ii < fe) {
        if ((log[ii] as u32) == 47) { return dec(log, ii + 1, fe); }
        ii = ii + 1;
    }
    return 0;
}

/// Field index of the title, of the paths, and of the labels (a PR has none).
pub fn title_field(log: string, ls: u32) -> u32 {
    if (is_pr(log, ls)) { return 5; }
    return 3;
}

pub fn paths_field(log: string, ls: u32) -> u32 {
    if (is_pr(log, ls)) { return 6; }
    return 5;
}

pub fn letters_field(log: string, ls: u32) -> u32 {
    return paths_field(log, ls) + 1;
}

pub fn card_title_len(log: string, ls: u32) -> u32 {
    return flen(log, ls, title_field(log, ls));
}

/// Is the comma list of field f of the line made of exactly the word w among its items?
pub fn list_has(log: string, ls: u32, f: u32, w: string) -> bool {
    const fs : u32 = fstart(log, ls, f);
    if (fs == KB_NONE) { return false; }
    const fe : u32 = fend(log, fs);
    var ii : u32 = fs;
    var st : u32 = fs;
    while (ii <= fe) {
        if (ii == fe or (log[ii] as u32) == 44) {
            if (ii - st == (w.len as u32)) {
                var kk : u32 = 0;
                while (kk < (w.len as u32) and log[st + kk] == w[kk]) { kk = kk + 1; }
                if (kk == (w.len as u32)) { return true; }
            }
            st = ii + 1;
        }
        ii = ii + 1;
    }
    return false;
}

pub fn has_label(log: string, ls: u32, w: string) -> bool {
    if (is_pr(log, ls)) { return false; }
    return list_has(log, ls, 4, w);
}

/// checks of a PR line: running or review means it is being looked at.
pub fn pr_in_review(log: string, ls: u32) -> bool {
    const fs : u32 = fstart(log, ls, 4);
    if (fs == KB_NONE) { return false; }
    const c : u32 = log[fs] as u32;
    return c == 114;
}

/// Start of the next line after the one at ls, KB_NONE at the end.
pub fn next_line(log: string, ls: u32) -> u32 {
    const le : u32 = kb_line_end(log, ls);
    if (le + 1 >= (log.len as u32)) { return KB_NONE; }
    return le + 1;
}

/// Start of the open PR that closes issue num, KB_NONE if there is none.
pub fn open_pr_of(log: string, num: u32) -> u32 {
    var ls : u32 = 0;
    if (log.len == 0) { return KB_NONE; }
    while (ls != KB_NONE) {
        if (is_pr(log, ls) and state_byte(log, ls) == 111) {
            const fs : u32 = fstart(log, ls, 3);
            if (fs != KB_NONE and dec(log, fs, fend(log, fs)) == num) { return ls; }
        }
        ls = next_line(log, ls);
    }
    return KB_NONE;
}

/// Is there a merged PR that closes issue num?
pub fn merged_pr_of(log: string, num: u32) -> bool {
    var ls : u32 = 0;
    if (log.len == 0) { return false; }
    while (ls != KB_NONE) {
        if (is_pr(log, ls) and state_byte(log, ls) == 109) {
            const fs : u32 = fstart(log, ls, 3);
            if (fs != KB_NONE and dec(log, fs, fend(log, fs)) == num) { return true; }
        }
        ls = next_line(log, ls);
    }
    return false;
}

/// Is there an open issue num in the log (a PR folds into it)?
pub fn open_issue_of(log: string, num: u32) -> bool {
    var ls : u32 = 0;
    if (log.len == 0 or num == 0) { return false; }
    while (ls != KB_NONE) {
        if (is_pr(log, ls) == false and state_byte(log, ls) == 111 and card_num(log, ls) == num) { return true; }
        ls = next_line(log, ls);
    }
    return false;
}

/// THE COLUMN RULE (see the header).
pub fn column(log: string, ls: u32) -> u32 {
    const sb : u32 = state_byte(log, ls);
    const num : u32 = card_num(log, ls);
    if (is_pr(log, ls) == false) {
        if (sb == 111) {
            const p : u32 = open_pr_of(log, num);
            if (p != KB_NONE) {
                if (pr_in_review(log, p)) { return KB_COL_HIDDEN; }
                return COL_DOING;
            }
            if (has_label(log, ls, "backlog")) { return COL_BACKLOG; }
            return COL_TODO;
        }
        if (merged_pr_of(log, num)) { return KB_COL_HIDDEN; }
        if (state_days(log, ls) <= DONE_DAYS) { return COL_DONE; }
        return KB_COL_HIDDEN;
    }
    if (sb == 111) {
        if (pr_in_review(log, ls)) { return COL_REVIEW; }
        const fs : u32 = fstart(log, ls, 3);
        if (fs != KB_NONE and open_issue_of(log, dec(log, fs, fend(log, fs)))) { return KB_COL_HIDDEN; }
        return COL_DOING;
    }
    if (sb == 109 and state_days(log, ls) <= DONE_DAYS) { return COL_DONE; }
    return KB_COL_HIDDEN;
}

/// How many cards the board draws in column c.
pub fn count_in(log: string, c: u32) -> u32 {
    var ls : u32 = 0;
    var n : u32 = 0;
    if (log.len == 0) { return 0; }
    while (ls != KB_NONE) {
        if (column(log, ls) == c) { n = n + 1; }
        ls = next_line(log, ls);
    }
    return n;
}

/// Start of the k-th card of column c, in log order; KB_NONE past the end.
pub fn nth_card(log: string, c: u32, k: u32) -> u32 {
    var ls : u32 = 0;
    var n : u32 = 0;
    if (log.len == 0) { return KB_NONE; }
    while (ls != KB_NONE) {
        if (column(log, ls) == c) {
            if (n == k) { return ls; }
            n = n + 1;
        }
        ls = next_line(log, ls);
    }
    return KB_NONE;
}

// ---- the pinned agents ----

/// The k-th letter of the card's letters field (comma list); 0 past the end, for a letter out of 1..27 and for a
/// repeat of an earlier letter (the list is distinct by contract; a repeat is skipped, not trusted).
pub fn raw_agent_at(log: string, ls: u32, k: u32) -> u32 {
    const fs : u32 = fstart(log, ls, letters_field(log, ls));
    if (fs == KB_NONE) { return 0; }
    const fe : u32 = fend(log, fs);
    var ii : u32 = fs;
    var st : u32 = fs;
    var seen : u32 = 0;
    var n : u32 = 0;
    while (ii <= fe) {
        if (ii == fe or (log[ii] as u32) == 44) {
            if (ii > st) {
                const l : u32 = dec(log, st, ii);
                if (l >= 1 and l <= 27 and (seen & (1 << (l - 1))) == 0) {
                    if (n == k) { return l; }
                    seen = seen | (1 << (l - 1));
                    n = n + 1;
                }
            }
            st = ii + 1;
        }
        ii = ii + 1;
    }
    return 0;
}

/// How many agents the card pins: 1..MAX_CHIPS, never 0.
pub fn agent_count(log: string, ls: u32) -> u32 {
    var n : u32 = 0;
    while (n < MAX_CHIPS and raw_agent_at(log, ls, n) != 0) { n = n + 1; }
    if (n == 0) { return 1; }
    return n;
}

/// Agent k of the card, owner first; the fallback letter when no path has an owner.
pub fn agent_at(log: string, ls: u32, k: u32) -> u32 {
    if (k >= agent_count(log, ls)) { return 0; }
    const l : u32 = raw_agent_at(log, ls, k);
    if (l == 0) { return FALLBACK_LETTER; }
    return l;
}

/// The tool letter of the card: its owner.
pub fn card_tool(log: string, ls: u32) -> u32 {
    return agent_at(log, ls, 0);
}

// ---- drag and drop ----
pub const ACT_NONE : u32 = 0;
pub const ACT_REFUSED : u32 = 1;
pub const ACT_PARK : u32 = 2;
pub const ACT_START_AGENT : u32 = 3;
pub const ACT_PAUSE : u32 = 4;
pub const ACT_REQUEST_REVIEW : u32 = 5;
pub const ACT_REWORK : u32 = 6;
pub const ACT_WIP_FULL : u32 = 7;
pub const ACT_MERGE_ONLY : u32 = 8;

/// What dropping a card from column `from` onto column `to` does; doing = cards now in DOING.
///  BACKLOG <-> TODO   ACT_PARK: add or remove the label backlog (no agent moves).
///  TODO -> DOING      ACT_START_AGENT: one agent on a fresh lane worktree, the lane plan of evolve.t27 (Sonnet,
///                     Closes #N); ACT_WIP_FULL when DOING already holds the cap (WIP_DOING = 3 = MAX_CHIPS).
///  DOING -> TODO      ACT_PAUSE: stop the agent, the lane worktree stays.
///  DOING -> REVIEW    ACT_REQUEST_REVIEW: open the PR of the lane and ask for review.
///  REVIEW -> DOING    ACT_REWORK: hand the findings back to the agent (counts against the cap).
///  REVIEW -> DONE     ACT_MERGE_ONLY: refused. A card reaches DONE only when the PR merges through the gates
///                     (merge_judge); a drop never merges, never forces a close.
/// Every other move, any move out of DONE or onto BACKLOG from DOING, is ACT_REFUSED. Same column: ACT_NONE.
pub fn drag_action(from: u32, to: u32, doing: u32) -> u32 {
    if (from >= KB_COL_COUNT or to >= KB_COL_COUNT) { return ACT_REFUSED; }
    if (from == to) { return ACT_NONE; }
    if (from == COL_BACKLOG and to == COL_TODO) { return ACT_PARK; }
    if (from == COL_TODO and to == COL_BACKLOG) { return ACT_PARK; }
    if (from == COL_TODO and to == COL_DOING) {
        if (wip_full(COL_DOING, doing)) { return ACT_WIP_FULL; }
        return ACT_START_AGENT;
    }
    if (from == COL_DOING and to == COL_TODO) { return ACT_PAUSE; }
    if (from == COL_DOING and to == COL_REVIEW) { return ACT_REQUEST_REVIEW; }
    if (from == COL_REVIEW and to == COL_DOING) {
        if (wip_full(COL_DOING, doing)) { return ACT_WIP_FULL; }
        return ACT_REWORK;
    }
    if (from == COL_REVIEW and to == COL_DONE) { return ACT_MERGE_ONLY; }
    return ACT_REFUSED;
}

pub fn drag_allowed(from: u32, to: u32, doing: u32) -> bool {
    const a : u32 = drag_action(from, to, doing);
    return a != ACT_NONE and a != ACT_REFUSED and a != ACT_WIP_FULL and a != ACT_MERGE_ONLY;
}

// ---- layout: nested rects, the packer of dash.t27 ----
pub const PAD : f64 = 8.0;
pub const COL_GAP : f64 = 6.0;
pub const COL_HEAD : f64 = 28.0;
pub const CARD_PAD : f64 = 4.0;
pub const KB_CARD_H : f64 = 64.0;
pub const CARD_GAP : f64 = 6.0;
pub const KB_CHIP_W : f64 = 22.0;
pub const KB_CHIP_H : f64 = 16.0;
pub const KB_CHIP_GAP : f64 = 2.0;

fn fl(x: u32) -> f64 { return @as(f64, @floatFromInt(x)); }

pub fn col_w(w: f64) -> f64 { return cell_w(w - 2.0 * PAD, KB_COL_COUNT, COL_GAP); }
pub fn col_x(c: u32, w: f64) -> f64 { return PAD + dash_cell_x(c, w - 2.0 * PAD, KB_COL_COUNT, COL_GAP); }
pub fn board_card_x(c: u32, w: f64) -> f64 { return col_x(c, w) + CARD_PAD; }
pub fn board_card_w(w: f64) -> f64 { return col_w(w) - 2.0 * CARD_PAD; }
pub fn board_card_y(i: u32) -> f64 { return PAD + COL_HEAD + dash_cell_y(i, 1, KB_CARD_H, CARD_GAP); }
pub fn chip_x(c: u32, w: f64, i: u32) -> f64 { return board_card_x(c, w) + CARD_PAD + fl(i) * (KB_CHIP_W + KB_CHIP_GAP); }

/// Height of a column holding n cards.
pub fn col_h(n: u32) -> f64 { return COL_HEAD + pack_h(n, 1, KB_CARD_H, CARD_GAP) + PAD; }

/// Height of the board when the tallest column holds n cards.
pub fn board_h(n: u32) -> f64 { return PAD + col_h(n) + PAD; }

/// The column under x of a board of width w, KB_COL_HIDDEN (5) when none (a gap or the padding).
pub fn column_at(w: f64, x: f64) -> u32 {
    const rel : f64 = x - PAD;
    if (rel < 0.0) { return KB_COL_HIDDEN; }
    return pack_at(KB_COL_COUNT, w - 2.0 * PAD, KB_COL_COUNT, 1.0e9, COL_GAP, rel, 0.0);
}

/// The card under (x, y) of column c of a board of width w holding n cards, n when none.
pub fn board_card_at(n: u32, w: f64, c: u32, x: f64, y: f64) -> u32 {
    return pack_at(n, board_card_w(w), 1, KB_CARD_H, CARD_GAP, x - board_card_x(c, w), y - board_card_y(0));
}

// ---- the host feed (2026-10-20) ----
// While the K page is open the host runs ONE background `/bin/sh -c` every KANBAN_PERIOD seconds (agent_parts
// PERIOD_KANBAN = 60): gh prints the lines of the format above itself, through its --jq templates below (@tsv joins
// the fields with TABs and escapes any KB_TAB or LF inside a title), into ~/.t27os/kanban/issues.tsv and prs.tsv. A file
// is replaced only when gh succeeded (&& mv), so a failed run (offline, not signed in) keeps the old board.
// Letters: the issue Boundary paths are printed, the LETTERS field is left empty; with no census the card takes
// FALLBACK_LETTER and is marked GUESS (card_guess). No GitHub write is made anywhere (drops only propose).
pub const KANBAN_DIR : str = "/.t27os/kanban/";
pub const FILE_ISSUES : str = "issues.tsv";
pub const FILE_PRS : str = "prs.tsv";
pub const K_HEAD_A : str = "export HOME=\"";
pub const K_HEAD_B : str = "\"; export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin; D=$HOME/.t27os/kanban; mkdir -p $D; ";
pub const JQ_ISSUES : str = ".[] | [\"issue\", (.number|tostring), \"open\", .title, ([.labels[].name]|join(\",\")), ([(.body // \"\")|scan(\"specs/[A-Za-z0-9_./-]+\")]|.[0:6]|join(\",\")), \"\"] | @tsv";
pub const JQ_PRS : str = ".[] | [\"pr\", (.number|tostring), (if .state==\"OPEN\" then \"open\" elif .state==\"MERGED\" then \"merged/\" + (((now - (.mergedAt|fromdateiso8601))/86400)|floor|tostring) else \"closed/99\" end), ((.closingIssuesReferences[0].number // 0)|tostring), (if ((.statusCheckRollup // [])|length)==0 then \"none\" elif any(.statusCheckRollup[]; ((.status // \"COMPLETED\") != \"COMPLETED\") or ((.state // \"\") == \"PENDING\")) then \"running\" elif any(.statusCheckRollup[]; ((.conclusion // \"\")|IN(\"FAILURE\",\"TIMED_OUT\",\"CANCELLED\",\"STARTUP_FAILURE\",\"ACTION_REQUIRED\")) or ((.state // \"\")|IN(\"FAILURE\",\"ERROR\"))) then \"fail\" else \"pass\" end), .title, \"\", \"\"] | @tsv";
pub const GH_ISSUES_A : str = "gh issue list --repo gHashTag/t27 --state open --limit 60 --json number,title,labels,body --jq '";
pub const GH_PRS_A : str = "gh pr list --repo gHashTag/t27 --state all --limit 60 --json number,state,title,headRefName,closingIssuesReferences,statusCheckRollup,mergedAt --jq '";
pub const GH_ISSUES_B : str = "' > $D/issues.tsv.part 2>/dev/null && mv $D/issues.tsv.part $D/issues.tsv; rm -f $D/issues.tsv.part; ";
pub const GH_PRS_B : str = "' > $D/prs.tsv.part 2>/dev/null && mv $D/prs.tsv.part $D/prs.tsv; rm -f $D/prs.tsv.part; true";
pub const FEED_CAP : u32 = 24000;

/// A card with no letter in its LETTERS field is pinned to FALLBACK_LETTER by guess, and says so on screen.
pub fn card_guess(log: string, ls: u32) -> bool {
    return raw_agent_at(log, ls, 0) == 0;
}

// ---- a proposed move, kept on the board until the next refresh ----
/// The column a card is drawn in: the proposed one for the card pnum (0 = no proposal), else the rule's.
pub fn eff_column(log: string, ls: u32, pnum: u32, pto: u32) -> u32 {
    const c : u32 = column(log, ls);
    if (pnum != 0 and c != KB_COL_HIDDEN and card_num(log, ls) == pnum and pto < KB_COL_COUNT) { return pto; }
    return c;
}

pub fn eff_count_in(log: string, c: u32, pnum: u32, pto: u32) -> u32 {
    var ls : u32 = 0;
    var n : u32 = 0;
    if (log.len == 0) { return 0; }
    while (ls != KB_NONE) {
        if (eff_column(log, ls, pnum, pto) == c) { n = n + 1; }
        ls = next_line(log, ls);
    }
    return n;
}

pub fn eff_nth_card(log: string, c: u32, k: u32, pnum: u32, pto: u32) -> u32 {
    var ls : u32 = 0;
    var n : u32 = 0;
    if (log.len == 0) { return KB_NONE; }
    while (ls != KB_NONE) {
        if (eff_column(log, ls, pnum, pto) == c) {
            if (n == k) { return ls; }
            n = n + 1;
        }
        ls = next_line(log, ls);
    }
    return KB_NONE;
}

/// Does a drop of this action leave a proposal on the board? Never a GitHub write, never an agent.
pub fn act_proposes(a: u32) -> bool {
    return a == ACT_PARK or a == ACT_START_AGENT or a == ACT_PAUSE or a == ACT_REQUEST_REVIEW or a == ACT_REWORK;
}

pub fn act_text(a: u32) -> string {
    if (a == ACT_PARK) { return "PROPOSED: park or unpark (label backlog); nothing is written to GitHub"; }
    if (a == ACT_START_AGENT) { return "PROPOSED: start one agent on a lane worktree (Sonnet, Closes #N); GOD MODE spawns are off, nothing started"; }
    if (a == ACT_PAUSE) { return "PROPOSED: pause the agent, the lane worktree stays; nothing stopped"; }
    if (a == ACT_REQUEST_REVIEW) { return "PROPOSED: open the PR of the lane and ask for review; nothing opened"; }
    if (a == ACT_REWORK) { return "PROPOSED: hand the findings back to the agent; nothing sent"; }
    if (a == ACT_WIP_FULL) { return "REFUSED: DOING already holds 3 cards, the agent cap"; }
    if (a == ACT_MERGE_ONLY) { return "REFUSED: a card reaches DONE only when its PR merges through the gates"; }
    if (a == ACT_REFUSED) { return "REFUSED: not a board move"; }
    return "";
}

// ---- the facade glass_window imports (generic names there clash with the window's own: board_card_at, column, card_title_len) ----
pub const KB_COLS : u32 = 5;
pub fn kb_next(log: string, ls: u32) -> u32 { return next_line(log, ls); }
pub fn kb_num(log: string, ls: u32) -> u32 { return card_num(log, ls); }
pub fn kb_is_pr(log: string, ls: u32) -> bool { return is_pr(log, ls); }
pub fn kb_col_name(c: u32) -> string { return column_name(c); }
pub fn kb_count(log: string, c: u32, pnum: u32, pto: u32) -> u32 { return eff_count_in(log, c, pnum, pto); }
pub fn kb_nth(log: string, c: u32, k: u32, pnum: u32, pto: u32) -> u32 { return eff_nth_card(log, c, k, pnum, pto); }
pub fn kb_col_of(log: string, ls: u32) -> u32 { return column(log, ls); }
pub fn kb_wip_full(count: u32) -> bool { return wip_full(COL_DOING, count); }
pub fn kb_doing() -> u32 { return COL_DOING; }
pub fn kb_todo() -> u32 { return COL_TODO; }
pub fn kb_drop(from: u32, to: u32, doing: u32) -> u32 { return drag_action(from, to, doing); }
pub fn kb_proposes(a: u32) -> bool { return act_proposes(a); }
pub fn kb_text(a: u32) -> string { return act_text(a); }
pub fn kb_agents(log: string, ls: u32) -> u32 { return agent_count(log, ls); }
pub fn kb_agent(log: string, ls: u32, k: u32) -> u32 { return agent_at(log, ls, k); }
pub fn kb_title_at(log: string, ls: u32) -> u32 { return fstart(log, ls, title_field(log, ls)); }
pub fn kb_title_n(log: string, ls: u32) -> u32 { return card_title_len(log, ls); }
/// The first label of an issue, 0 length when none: start and length (cards show one badge).
pub fn kb_badge_at(log: string, ls: u32) -> u32 {
    if (is_pr(log, ls)) { return KB_NONE; }
    const fs : u32 = fstart(log, ls, 4);
    if (fs == KB_NONE) { return KB_NONE; }
    return fs;
}
pub fn kb_badge_n(log: string, ls: u32) -> u32 {
    const fs : u32 = kb_badge_at(log, ls);
    if (fs == KB_NONE) { return 0; }
    var e : u32 = fs;
    const fe : u32 = fend(log, fs);
    while (e < fe and (log[e] as u32) != 44) { e = e + 1; }
    return e - fs;
}
/// The check word of a PR for its badge: its first letter r(unning) / p(ass) / f(ail) / n(one), 0 for an issue.
pub fn kb_checks_byte(log: string, ls: u32) -> u32 {
    if (is_pr(log, ls) == false) { return 0; }
    const fs : u32 = fstart(log, ls, 4);
    if (fs == KB_NONE) { return 0; }
    return log[fs] as u32;
}
pub fn kb_pad() -> f64 { return PAD; }
pub fn kb_col_head() -> f64 { return COL_HEAD; }
pub fn kb_card_h() -> f64 { return KB_CARD_H; }
pub fn kb_card_gap() -> f64 { return CARD_GAP; }
pub fn kb_card_pad() -> f64 { return CARD_PAD; }
pub fn kb_col_x(c: u32, w: f64) -> f64 { return col_x(c, w); }
pub fn kb_col_w(w: f64) -> f64 { return col_w(w); }
pub fn kb_card_x(c: u32, w: f64) -> f64 { return board_card_x(c, w); }
pub fn kb_card_w(w: f64) -> f64 { return board_card_w(w); }
pub fn kb_card_y(i: u32) -> f64 { return board_card_y(i); }
pub fn kb_chip_x(c: u32, w: f64, i: u32) -> f64 { return chip_x(c, w, i); }
pub fn kb_chip_w() -> f64 { return KB_CHIP_W; }
pub fn kb_chip_h() -> f64 { return KB_CHIP_H; }
pub fn kb_col_at(w: f64, x: f64) -> u32 { return column_at(w, x); }
pub fn kb_card_at(n: u32, w: f64, c: u32, x: f64, y: f64) -> u32 { return board_card_at(n, w, c, x, y); }
/// Cards of a column that fit under the head in a board h tall.
pub fn kb_rows_fit(h: f64) -> u32 {
    const room : f64 = h - 2.0 * PAD - COL_HEAD;
    if (room < KB_CARD_H) { return 0; }
    return @as(u32, @intFromFloat((room + CARD_GAP) / (KB_CARD_H + CARD_GAP)));
}

/// The sample log of the tests, for importers whose own tests load a board (the window's drag tests).
pub fn kb_sample() -> string { return SAMPLE; }

// ---- tests: ten lines shaped on this repository's recent log ----
// Numbers and titles come from the log (#11275 the epic, #11264/#11278 the PTY server, #11265/#11277 the homes
// reseal, #11260 the KEY_FILES issue, #10938/#11104 the widgets, #11063 the night loop); the states, the labels, the
// paths and the PR number 11280 are SAMPLE data, made to hit every rule once.
pub const SAMPLE : string = "issue\t11275\topen\tT27 OS: ergonomic project management, one tool per letter\tt27os,epic\tspecs/t27os/agent_parts.t27,specs/t27os/homes.t27\t26\nissue\t11260\topen\tagents: KEY_FILES point at the directories each domain changes\tbacklog\tspecs/automation/x.t27\t10\nissue\t11264\topen\tT27 OS: the PTY server reads the Keychain itself\tt27os\tspecs/t27os/pty_server.t27\t26\npr\t11278\topen\t11264\trunning\tT27 OS: the PTY server reads the Keychain itself\tspecs/t27os/pty_server.t27,specs/t27os/keys.t27\t26\nissue\t10938\topen\twidgets: gatle drawn natively\twidgets\tspecs/t27f/widget_factory.t27,bootstrap/src/compiler.rs\t26,3\npr\t11280\topen\t10938\tfail\twidgets: gatle drawn natively\tspecs/t27f/widget_factory.t27,bootstrap/src/compiler.rs\t26,3\nissue\t11265\tclosed/2\tseals: homes.t27 resealed\tseals\t.trinity/seals/t27os_T27osHomes.json\t2\npr\t11277\tmerged/2\t11265\tpass\tseals: homes.t27 resealed (gen-drift)\t.trinity/seals/t27os_T27osHomes.json\t2\nissue\t11063\tclosed/20\tnight loop epic\tepic\tdocs/now/x.md\t5\nissue\t11104\topen\twidgets: catalog records every tool at PORT_DRAW\twidgets\t\t";

test the_sample_has_ten_lines_and_the_rule_puts_each_card_in_its_column {
    const s : string = SAMPLE;
    var ls : u32 = 0;
    var lines : u32 = 0;
    while (ls != KB_NONE) {
        lines = lines + 1;
        ls = next_line(s, ls);
    }
    assert lines == 10;
    ls = 0;
    assert column(s, ls) == COL_TODO;
    ls = next_line(s, ls);
    assert column(s, ls) == COL_BACKLOG;
    ls = next_line(s, ls);
    assert card_num(s, ls) == 11264;
    assert column(s, ls) == KB_COL_HIDDEN;
    ls = next_line(s, ls);
    assert is_pr(s, ls);
    assert column(s, ls) == COL_REVIEW;
    ls = next_line(s, ls);
    assert card_num(s, ls) == 10938;
    assert column(s, ls) == COL_DOING;
    ls = next_line(s, ls);
    assert column(s, ls) == KB_COL_HIDDEN;
    ls = next_line(s, ls);
    assert column(s, ls) == KB_COL_HIDDEN;
    ls = next_line(s, ls);
    assert card_num(s, ls) == 11277;
    assert column(s, ls) == COL_DONE;
    ls = next_line(s, ls);
    assert state_days(s, ls) == 20;
    assert column(s, ls) == KB_COL_HIDDEN;
    ls = next_line(s, ls);
    assert card_num(s, ls) == 11104;
    assert column(s, ls) == COL_TODO;
}

test the_column_counts_of_the_sample {
    const s : string = SAMPLE;
    assert count_in(s, COL_BACKLOG) == 1;
    assert count_in(s, COL_TODO) == 2;
    assert count_in(s, COL_DOING) == 1;
    assert count_in(s, COL_REVIEW) == 1;
    assert count_in(s, COL_DONE) == 1;
    assert count_in(s, KB_COL_HIDDEN) == 4;
    assert count_in(s, COL_BACKLOG) + count_in(s, COL_TODO) + count_in(s, COL_DOING) + count_in(s, COL_REVIEW) + count_in(s, COL_DONE) + count_in(s, KB_COL_HIDDEN) == 10;
    assert count_in("", COL_TODO) == 0;
}

test every_drawn_card_has_at_least_one_agent_owner_first {
    const s : string = SAMPLE;
    var c : u32 = 0;
    var cards : u32 = 0;
    while (c < KB_COL_COUNT) {
        var k : u32 = 0;
        while (k < count_in(s, c)) {
            const ls : u32 = nth_card(s, c, k);
            assert ls != KB_NONE;
            assert agent_count(s, ls) >= 1;
            assert agent_count(s, ls) <= MAX_CHIPS;
            assert agent_at(s, ls, 0) >= 1;
            assert agent_at(s, ls, 0) <= 27;
            assert agent_at(s, ls, agent_count(s, ls)) == 0;
            assert card_tool(s, ls) == agent_at(s, ls, 0);
            cards = cards + 1;
            k = k + 1;
        }
        c = c + 1;
    }
    assert cards == 6;
}

test agents_come_from_the_letters_field_owner_first_distinct {
    const s : string = SAMPLE;
    const epic : u32 = nth_card(s, COL_TODO, 0);
    assert card_num(s, epic) == 11275;
    assert agent_count(s, epic) == 1;
    assert agent_at(s, epic, 0) == 26;
    const pr : u32 = nth_card(s, COL_REVIEW, 0);
    assert card_num(s, pr) == 11278;
    assert agent_count(s, pr) == 1;
    const wid : u32 = nth_card(s, COL_DOING, 0);
    assert card_num(s, wid) == 10938;
    assert agent_count(s, wid) == 2;
    assert agent_at(s, wid, 0) == 26;
    assert agent_at(s, wid, 1) == 3;
    assert agent_at(s, wid, 2) == 0;
    const job : u32 = nth_card(s, COL_BACKLOG, 0);
    assert agent_at(s, job, 0) == 10;
    // no paths at all: pinned to the fallback letter, a card is never agentless
    const bare : u32 = nth_card(s, COL_TODO, 1);
    assert card_num(s, bare) == 11104;
    assert raw_agent_at(s, bare, 0) == 0;
    assert agent_count(s, bare) == 1;
    assert agent_at(s, bare, 0) == FALLBACK_LETTER;
    assert agent_at(s, bare, 1) == 0;
    // a repeat, a zero and a letter past 27 are skipped; at most MAX_CHIPS are used
    const odd : string = "issue\t1\topen\tt\t\tdocs/a.md\t3,3,0,28,10,27,5,7\n";
    assert agent_count(odd, 0) == 3;
    assert agent_at(odd, 0, 0) == 3;
    assert agent_at(odd, 0, 1) == 10;
    assert agent_at(odd, 0, 2) == 27;
    assert agent_at(odd, 0, 3) == 0;
}

test the_counted_title_and_labels_are_read_without_copying {
    const s : string = SAMPLE;
    const epic : u32 = nth_card(s, COL_TODO, 0);
    assert card_title_len(s, epic) == 57;
    assert has_label(s, epic, "epic");
    assert has_label(s, epic, "t27os");
    assert has_label(s, epic, "epi") == false;
    assert has_label(s, epic, "backlog") == false;
    assert has_label(s, nth_card(s, COL_REVIEW, 0), "epic") == false;
    assert card_num(s, nth_card(s, COL_DONE, 0)) == 11277;
    assert state_byte(s, nth_card(s, COL_DONE, 0)) == 109;
}

test the_done_window_is_seven_days_and_a_closed_issue_without_pr_is_done {
    const a : string = "issue\t5\tclosed/7\tx\t\tdocs/a.md\t5\n";
    const b : string = "issue\t6\tclosed/8\tx\t\tdocs/a.md\t5\n";
    const c : string = "pr\t7\tclosed/1\t0\tpass\tx\tdocs/a.md\t5\n";
    const d : string = "pr\t8\topen\t0\tnone\tx\tdocs/a.md\t5\n";
    const e : string = "pr\t9\topen\t0\treview\tx\tdocs/a.md\t5\n";
    assert column(a, 0) == COL_DONE;
    assert column(b, 0) == KB_COL_HIDDEN;
    assert column(c, 0) == KB_COL_HIDDEN;
    assert column(d, 0) == COL_DOING;
    assert column(e, 0) == COL_REVIEW;
}

test drag_rules_each_allowed_move_implies_one_action {
    assert drag_action(COL_BACKLOG, COL_TODO, 0) == ACT_PARK;
    assert drag_action(COL_TODO, COL_BACKLOG, 0) == ACT_PARK;
    assert drag_action(COL_TODO, COL_DOING, 0) == ACT_START_AGENT;
    assert drag_action(COL_TODO, COL_DOING, 2) == ACT_START_AGENT;
    assert drag_action(COL_DOING, COL_TODO, 3) == ACT_PAUSE;
    assert drag_action(COL_DOING, COL_REVIEW, 3) == ACT_REQUEST_REVIEW;
    assert drag_action(COL_REVIEW, COL_DOING, 1) == ACT_REWORK;
    assert drag_action(COL_TODO, COL_TODO, 0) == ACT_NONE;
    assert drag_allowed(COL_TODO, COL_DOING, 0);
    assert drag_allowed(COL_DOING, COL_REVIEW, 1);
}

test merge_is_never_forced_and_done_is_never_left {
    assert drag_action(COL_REVIEW, COL_DONE, 0) == ACT_MERGE_ONLY;
    assert drag_allowed(COL_REVIEW, COL_DONE, 0) == false;
    var f : u32 = 0;
    while (f < KB_COL_COUNT) {
        // nothing is dropped into DONE except through the merge (refused or merge-only), and DONE is a dead end
        if (f != COL_DONE) { assert drag_allowed(f, COL_DONE, 0) == false; }
        if (f != COL_DONE) { assert drag_action(COL_DONE, f, 0) == ACT_REFUSED; }
        f = f + 1;
    }
    assert drag_action(COL_BACKLOG, COL_DOING, 0) == ACT_REFUSED;
    assert drag_action(COL_DOING, COL_BACKLOG, 0) == ACT_REFUSED;
    assert drag_action(COL_TODO, COL_REVIEW, 0) == ACT_REFUSED;
    assert drag_action(COL_REVIEW, COL_TODO, 0) == ACT_REFUSED;
    assert drag_action(9, COL_TODO, 0) == ACT_REFUSED;
    assert drag_action(COL_TODO, KB_COL_HIDDEN, 0) == ACT_REFUSED;
}

test the_wip_limit_of_doing_is_the_agent_cap {
    assert WIP_DOING == 3;
    assert WIP_DOING == MAX_CHIPS;
    // the cap is the one of evolve.t27: GOD MODE refuses a 4th agent at exactly WIP_DOING running
    assert why_not(true, true, WIP_DOING - 1, 0) != R_AGENT_CAP;
    assert why_not(true, true, WIP_DOING, 0) == R_AGENT_CAP;
    assert FALLBACK_LETTER == LETTER_UNOWNED;
    assert wip_limit(COL_DOING) == WIP_DOING;
    assert wip_limit(COL_TODO) == 0;
    assert wip_full(COL_DOING, 2) == false;
    assert wip_full(COL_DOING, 3);
    assert wip_full(COL_DOING, 4);
    assert wip_full(COL_TODO, 400) == false;
    assert drag_action(COL_TODO, COL_DOING, 3) == ACT_WIP_FULL;
    assert drag_action(COL_REVIEW, COL_DOING, 3) == ACT_WIP_FULL;
    assert drag_allowed(COL_TODO, COL_DOING, 3) == false;
    // pausing or reviewing frees a slot and is never blocked by the cap
    assert drag_action(COL_DOING, COL_REVIEW, 3) == ACT_REQUEST_REVIEW;
    // the sample holds 1 card in DOING: room for two more starts
    assert wip_full(COL_DOING, count_in(SAMPLE, COL_DOING)) == false;
}

test the_tree_is_board_column_card_chip_and_badge {
    assert kb_child_kind(KK_BOARD, 0) == KK_COLUMN;
    assert kb_child_kind(KK_COLUMN, 0) == KK_CARD;
    assert kb_child_kind(KK_CARD, 0) == KK_CHIP;
    assert kb_child_kind(KK_CARD, 1) == KK_BADGE;
    assert kb_child_kind(KK_CHIP, 0) == KK_KINDS;
    assert kb_child_kind(KK_BADGE, 0) == KK_KINDS;
    assert kb_child_kind(KK_BOARD, 1) == KK_KINDS;
    assert column_name(COL_REVIEW) == "REVIEW";
    assert column_name(KB_COL_HIDDEN) == "";
}

test the_layout_nests_five_columns_of_cards_with_the_dash_packer {
    const w : f64 = 1000.0;
    // 5 columns, 4 gaps of 6, padding 8 each side: (1000 - 16 - 24) / 5 = 192
    assert col_w(w) == 192.0;
    assert col_x(0, w) == 8.0;
    assert col_x(1, w) == 206.0;
    assert col_x(4, w) == 8.0 + 4.0 * 198.0;
    assert board_card_w(w) == 184.0;
    assert board_card_x(0, w) == 12.0;
    assert board_card_y(0) == 36.0;
    assert board_card_y(1) == 106.0;
    assert col_h(0) == 36.0;
    assert col_h(2) == 28.0 + 134.0 + 8.0;
    assert board_h(2) == 8.0 + col_h(2) + 8.0;
    assert chip_x(0, w, 1) == 12.0 + 4.0 + 24.0;
    // the rects stay inside the board
    assert col_x(4, w) + col_w(w) + PAD == w;
}

test hit_testing_finds_the_column_then_the_card_and_misses_in_the_gaps {
    const w : f64 = 1000.0;
    assert column_at(w, 10.0) == COL_BACKLOG;
    assert column_at(w, 210.0) == COL_TODO;
    assert column_at(w, 500.0) == COL_DOING;
    assert column_at(w, 990.0) == COL_DONE;
    assert column_at(w, 203.0) == KB_COL_HIDDEN;
    assert column_at(w, 2.0) == KB_COL_HIDDEN;
    assert board_card_at(3, w, 1, board_card_x(1, w) + 5.0, board_card_y(0) + 5.0) == 0;
    assert board_card_at(3, w, 1, board_card_x(1, w) + 5.0, board_card_y(1) + 5.0) == 1;
    assert board_card_at(3, w, 1, board_card_x(1, w) + 5.0, board_card_y(0) + KB_CARD_H + 2.0) == 3;
    assert board_card_at(3, w, 1, board_card_x(1, w) + 5.0, board_card_y(3) + 5.0) == 3;
    assert board_card_at(3, w, 1, board_card_x(1, w) + 5.0, 5.0) == 3;
}

test the_feed_templates_print_the_line_format_with_tsv_and_write_nothing_to_github {
    assert JQ_ISSUES.len < 400;
    assert JQ_PRS.len < 1200;
    var i : u32 = 0;
    while (i < (JQ_PRS.len as u32)) { assert (JQ_PRS[i] as u32) < 127 and (JQ_PRS[i] as u32) != 39 and (JQ_PRS[i] as u32) != 10 and (JQ_PRS[i] as u32) != 9; i = i + 1; }
    i = 0;
    while (i < (JQ_ISSUES.len as u32)) { assert (JQ_ISSUES[i] as u32) < 127 and (JQ_ISSUES[i] as u32) != 39 and (JQ_ISSUES[i] as u32) != 10; i = i + 1; }
    assert list_has_word(JQ_ISSUES, "@tsv");
    assert list_has_word(JQ_PRS, "@tsv");
    assert list_has_word(JQ_ISSUES, "\"issue\"");
    assert list_has_word(JQ_PRS, "\"pr\"");
    assert list_has_word(JQ_PRS, "closingIssuesReferences");
    assert list_has_word(JQ_PRS, "\"merged/\"");
    assert list_has_word(GH_ISSUES_A, "--state open --limit 60 --json number,title,labels,body");
    assert list_has_word(GH_PRS_A, "--state all --limit 60 --json number,state,title,headRefName,closingIssuesReferences,statusCheckRollup,mergedAt");
    assert list_has_word(GH_ISSUES_A, "--repo gHashTag/t27");
    // read-only gh verbs only
    assert list_has_word(GH_ISSUES_A, "gh issue list");
    assert list_has_word(GH_PRS_A, "gh pr list");
    assert list_has_word(GH_ISSUES_A, "edit") == false;
    assert list_has_word(GH_ISSUES_B, "&& mv $D/issues.tsv.part $D/issues.tsv");
    assert list_has_word(GH_PRS_B, "&& mv $D/prs.tsv.part $D/prs.tsv");
    assert FEED_CAP == 24000;
    assert FILE_ISSUES == "issues.tsv";
}

fn list_has_word(t: string, w: string) -> bool {
    const n : u32 = t.len as u32;
    const m : u32 = w.len as u32;
    var i : u32 = 0;
    while (i + m <= n) {
        var j : u32 = 0;
        while (j < m and t[i + j] == w[j]) { j = j + 1; }
        if (j == m) { return true; }
        i = i + 1;
    }
    return false;
}

test a_card_with_no_letter_is_a_guess_and_a_proposal_moves_it_only_on_screen {
    const s : string = SAMPLE;
    var ls : u32 = 0;
    ls = next_line(s, ls);
    ls = next_line(s, ls);
    ls = next_line(s, ls);
    ls = next_line(s, ls);
    assert card_num(s, ls) == 10938;
    // issue 11104 (the last line) has no letters: a guess
    var last : u32 = 0;
    var cur : u32 = 0;
    while (cur != KB_NONE) { last = cur; cur = next_line(s, cur); }
    assert card_num(s, last) == 11104;
    assert card_guess(s, last);
    assert card_guess(s, 0) == false;
    assert agent_at(s, last, 0) == FALLBACK_LETTER;
    // 11275 is TODO; proposing DOING draws it there, the rule still says TODO
    assert column(s, 0) == COL_TODO;
    assert eff_column(s, 0, 11275, COL_DOING) == COL_DOING;
    assert eff_column(s, 0, 0, COL_DOING) == COL_TODO;
    assert eff_column(s, 0, 11264, COL_DOING) == COL_TODO;
    // a hidden card is never drawn by a proposal
    const hid : u32 = next_line(s, next_line(s, 0));
    assert column(s, hid) == KB_COL_HIDDEN;
    assert eff_column(s, hid, 11264, COL_DOING) == KB_COL_HIDDEN;
    assert eff_count_in(s, COL_TODO, 0, 0) == count_in(s, COL_TODO);
    assert eff_count_in(s, COL_DOING, 11275, COL_DOING) == count_in(s, COL_DOING) + 1;
    assert eff_count_in(s, COL_TODO, 11275, COL_DOING) == count_in(s, COL_TODO) - 1;
    assert eff_nth_card(s, COL_DOING, 0, 11275, COL_DOING) != KB_NONE;
    assert eff_nth_card(s, COL_DOING, 9, 11275, COL_DOING) == KB_NONE;
}

test the_proposal_texts_say_that_nothing_was_done {
    assert act_proposes(ACT_START_AGENT);
    assert act_proposes(ACT_PARK);
    assert act_proposes(ACT_NONE) == false;
    assert act_proposes(ACT_REFUSED) == false;
    assert act_proposes(ACT_WIP_FULL) == false;
    assert act_proposes(ACT_MERGE_ONLY) == false;
    assert list_has_word(act_text(ACT_START_AGENT), "nothing started");
    assert list_has_word(act_text(ACT_START_AGENT), "Sonnet");
    assert list_has_word(act_text(ACT_PARK), "nothing is written to GitHub");
    assert list_has_word(act_text(ACT_MERGE_ONLY), "REFUSED");
    assert list_has_word(act_text(ACT_WIP_FULL), "agent cap");
    assert act_text(ACT_NONE) == "";
    assert drag_action(COL_TODO, COL_DOING, 0) == ACT_START_AGENT;
    assert drag_action(COL_TODO, COL_DOING, 3) == ACT_WIP_FULL;
}

test the_facade_reads_a_card_and_its_layout_without_clashing_names {
    const s : string = SAMPLE;
    assert kb_num(s, 0) == 11275;
    assert kb_is_pr(s, 0) == false;
    assert kb_col_of(s, 0) == kb_todo();
    assert kb_col_name(kb_doing()) == "DOING";
    assert kb_count(s, kb_todo(), 0, 0) == 2;
    assert kb_agents(s, 0) == 1;
    assert kb_agent(s, 0, 0) == 26;
    const t : u32 = kb_title_at(s, 0);
    assert t != KB_NONE;
    assert (s[t] as u32) == 84;
    assert kb_title_n(s, 0) == 57;
    assert kb_badge_n(s, 0) == 5;
    const pr : u32 = kb_next(s, kb_next(s, kb_next(s, 0)));
    assert kb_is_pr(s, pr);
    assert kb_checks_byte(s, pr) == 114;
    assert kb_checks_byte(s, 0) == 0;
    assert kb_drop(kb_todo(), kb_doing(), 0) == ACT_START_AGENT;
    assert kb_proposes(ACT_START_AGENT);
    assert kb_wip_full(3);
    assert kb_wip_full(2) == false;
    // five columns across 700 pt, each card inside its column; a click finds column and card
    assert kb_col_w(700.0) * 5.0 + 4.0 * COL_GAP + 2.0 * kb_pad() == 700.0;
    assert kb_card_x(1, 700.0) > kb_col_x(1, 700.0);
    assert kb_card_w(700.0) < kb_col_w(700.0);
    assert kb_col_at(700.0, kb_col_x(2, 700.0) + 3.0) == 2;
    assert kb_card_at(3, 700.0, 2, kb_card_x(2, 700.0) + 3.0, kb_card_y(1) + 3.0) == 1;
    assert kb_card_at(3, 700.0, 2, kb_card_x(2, 700.0) + 3.0, kb_card_y(0) + kb_card_h() + 1.0) == 3;
    assert kb_rows_fit(100.0) == 0;
    assert kb_rows_fit(460.0) >= 5;
}

test the_line_and_field_readers_stop_at_the_edges {
    // a0 b1 TAB2 c3 d4 TAB5 TAB6 e7 f8 LF9 x10 y11 z12 TAB13 '1'14 LF15, length 16
    const g : string = "ab\tcd\t\tef\nxyz\t1\n";
    assert kb_line_end(g, 0) == 9;
    assert kb_line_end(g, 9) == 9;
    assert kb_line_end(g, 10) == 15;
    assert kb_line_end("abc", 0) == 3;
    assert kb_line_end("", 0) == 0;
    assert fstart(g, 0, 0) == 0;
    assert fstart(g, 0, 1) == 3;
    assert fstart(g, 0, 2) == 6;
    assert fstart(g, 0, 3) == 7;
    assert fstart(g, 0, 4) == KB_NONE;
    assert fstart(g, 10, 1) == 14;
    assert fstart(g, 10, 2) == KB_NONE;
    assert fend(g, 0) == 2;
    assert fend(g, 3) == 5;
    assert fend(g, 6) == 6;
    assert fend(g, 7) == 9;
    assert fend(g, 14) == 15;
    assert fend("abc", 0) == 3;
    assert fend("abc", 3) == 3;
    assert flen(g, 0, 0) == 2;
    assert flen(g, 0, 1) == 2;
    assert flen(g, 0, 2) == 0;
    assert flen(g, 0, 3) == 2;
    assert flen(g, 0, 4) == 0;
    assert flen(g, 10, 0) == 3;
    assert flen(g, 10, 1) == 1;
    assert flen(g, 10, 2) == 0;
    assert fstart(SAMPLE, 0, 6) == fend(SAMPLE, fstart(SAMPLE, 0, 5)) + 1;
}

test dec_reads_digits_and_stops_at_the_first_other_byte {
    const s : string = "12a45";
    assert dec(s, 0, 5) == 12;
    assert dec(s, 0, 3) == 12;
    assert dec(s, 0, 2) == 12;
    assert dec(s, 0, 1) == 1;
    assert dec(s, 0, 0) == 0;
    assert dec(s, 2, 5) == 0;
    assert dec(s, 3, 5) == 45;
    assert dec("0042", 0, 4) == 42;
    assert dec("4294967295", 0, 10) == 4294967295;
    assert dec("/9", 0, 2) == 0;
    assert dec(":9", 0, 2) == 0;
    assert dec("09", 0, 2) == 9;
}

test the_field_indexes_of_an_issue_and_of_a_pr {
    const s : string = SAMPLE;
    assert is_pr(s, 0) == false;
    assert title_field(s, 0) == 3;
    assert paths_field(s, 0) == 5;
    assert letters_field(s, 0) == 6;
    const pr : u32 = nth_card(s, COL_REVIEW, 0);
    assert is_pr(s, pr);
    assert title_field(s, pr) == 5;
    assert paths_field(s, pr) == 6;
    assert letters_field(s, pr) == 7;
    // the letters field of both kinds is the last one of the sample lines
    assert fend(s, fstart(s, 0, letters_field(s, 0))) == kb_line_end(s, 0);
    assert fend(s, fstart(s, pr, letters_field(s, pr))) == kb_line_end(s, pr);
}

test list_has_matches_whole_comma_items_only {
    const g : string = "issue\t1\topen\tt\ta,bb,c\tp\t1\n";
    assert list_has(g, 0, 4, "a");
    assert list_has(g, 0, 4, "bb");
    assert list_has(g, 0, 4, "c");
    assert list_has(g, 0, 4, "b") == false;
    assert list_has(g, 0, 4, "bbb") == false;
    assert list_has(g, 0, 4, "a,bb") == false;
    assert list_has(g, 0, 4, "ab") == false;
    assert list_has(g, 0, 4, "d") == false;
    assert list_has(g, 0, 9, "a") == false;
    assert list_has(g, 0, 3, "t");
    assert list_has(g, 0, 3, "tt") == false;
    assert list_has(g, 0, 2, "open");
    // an empty item between commas matches the empty word; a list with no empty item does not
    assert list_has("issue\t1\topen\tt\ta,,c\tp\t1\n", 0, 4, "");
    assert list_has(g, 0, 4, "") == false;
    // a word longer than the field, and the last item at the end of the text
    assert list_has("x\ta,b", 0, 1, "b");
    assert list_has("x\ta,b", 0, 1, "a,b,c") == false;
    assert list_has("x\ta,b", 0, 1, "bc") == false;
    assert list_has(SAMPLE, 0, 6, "26");
    assert list_has(SAMPLE, 0, 6, "2") == false;
}

test pr_in_review_reads_the_first_byte_of_the_checks_field {
    const a : string = "pr\t1\topen\t0\trunning\tx\tp\t5\n";
    const b : string = "pr\t1\topen\t0\treview\tx\tp\t5\n";
    const c : string = "pr\t1\topen\t0\tpass\tx\tp\t5\n";
    const d : string = "pr\t1\topen\t0\tfail\tx\tp\t5\n";
    const e : string = "pr\t1\topen\t0\tnone\tx\tp\t5\n";
    assert pr_in_review(a, 0);
    assert pr_in_review(b, 0);
    assert pr_in_review(c, 0) == false;
    assert pr_in_review(d, 0) == false;
    assert pr_in_review(e, 0) == false;
    assert pr_in_review("pr\t1\topen\n", 0) == false;
    assert pr_in_review("pr\t1\topen\t0\t\n", 0) == false;
    assert kb_checks_byte(a, 0) == 114;
    assert kb_checks_byte(c, 0) == 112;
    assert kb_checks_byte(d, 0) == 102;
    assert kb_checks_byte(e, 0) == 110;
    assert kb_checks_byte("pr\t1\topen\n", 0) == 0;
}

test the_lookups_of_the_issue_and_pr_of_a_number {
    const s : string = SAMPLE;
    // 11264 has the open PR 11278; 10938 the open PR 11280 (checks failed, still open)
    assert open_pr_of(s, 11264) != KB_NONE;
    assert card_num(s, open_pr_of(s, 11264)) == 11278;
    assert card_num(s, open_pr_of(s, 10938)) == 11280;
    assert is_pr(s, open_pr_of(s, 10938));
    // 11265 has only a merged PR, 11275 none at all
    assert open_pr_of(s, 11265) == KB_NONE;
    assert open_pr_of(s, 11275) == KB_NONE;
    assert open_pr_of(s, 11278) == KB_NONE;
    assert open_pr_of("", 11264) == KB_NONE;
    assert merged_pr_of(s, 11265);
    assert merged_pr_of(s, 11264) == false;
    assert merged_pr_of(s, 10938) == false;
    assert merged_pr_of(s, 11277) == false;
    assert merged_pr_of(s, 99) == false;
    assert merged_pr_of("", 11265) == false;
    assert open_issue_of(s, 11275);
    assert open_issue_of(s, 11264);
    assert open_issue_of(s, 11104);
    assert open_issue_of(s, 11265) == false;
    assert open_issue_of(s, 11063) == false;
    assert open_issue_of(s, 11278) == false;
    assert open_issue_of(s, 0) == false;
    assert open_issue_of("", 11275) == false;
    // number 0 is never an issue, even when an open issue line carries it
    assert open_issue_of("issue\t0\topen\tt\t\tp\t1\n", 0) == false;
    assert open_issue_of("issue\t7\topen\tt\t\tp\t1\n", 7);
}

test the_facade_nth_text_badge_and_geometry {
    const s : string = SAMPLE;
    assert kb_nth(s, COL_TODO, 0, 0, 0) == 0;
    assert card_num(s, kb_nth(s, COL_TODO, 1, 0, 0)) == 11104;
    assert kb_nth(s, COL_TODO, 2, 0, 0) == KB_NONE;
    assert kb_nth(s, COL_DOING, 0, 11275, COL_DOING) == 0;
    assert card_num(s, kb_nth(s, COL_DOING, 1, 11275, COL_DOING)) == 10938;
    assert kb_nth(s, COL_DOING, 2, 11275, COL_DOING) == KB_NONE;
    assert kb_nth("", COL_TODO, 0, 0, 0) == KB_NONE;
    assert kb_text(ACT_NONE) == "";
    assert kb_text(ACT_REFUSED) == "REFUSED: not a board move";
    assert kb_text(ACT_PAUSE) == act_text(ACT_PAUSE);
    assert kb_text(ACT_WIP_FULL) == "REFUSED: DOING already holds 3 cards, the agent cap";
    assert kb_text(ACT_REWORK) == "PROPOSED: hand the findings back to the agent; nothing sent";
    // the badge is the first label: its start, KB_NONE for a PR or a line with no label field
    const b : u32 = kb_badge_at(s, 0);
    assert b == fstart(s, 0, 4);
    assert (s[b] as u32) == 116;
    assert kb_badge_n(s, 0) == 5;
    assert kb_badge_at(s, nth_card(s, COL_REVIEW, 0)) == KB_NONE;
    assert kb_badge_n(s, nth_card(s, COL_REVIEW, 0)) == 0;
    assert kb_badge_at("issue\t1\topen\n", 0) == KB_NONE;
    const odd : string = "issue\t1\topen\tt\t\tdocs/a.md\t3\n";
    assert kb_badge_at(odd, 0) == fstart(odd, 0, 4);
    assert kb_badge_n(odd, 0) == 0;
    // geometry constants and the chip row at a 1000 pt board
    assert kb_col_head() == 28.0;
    assert kb_card_gap() == 6.0;
    assert kb_card_pad() == 4.0;
    assert kb_chip_w() == 22.0;
    assert kb_chip_h() == 16.0;
    assert kb_chip_x(0, 1000.0, 0) == 16.0;
    assert kb_chip_x(0, 1000.0, 1) == 40.0;
    assert kb_chip_x(0, 1000.0, 2) == 64.0;
    assert kb_chip_x(2, 1000.0, 0) == 412.0;
    assert kb_chip_x(2, 1000.0, 2) == 460.0;
    // the sample the facade hands out is the sample of this file
    assert kb_sample() == SAMPLE;
    assert kb_sample().len == SAMPLE.len;
    assert kb_count(kb_sample(), COL_DONE, 0, 0) == 1;
}
