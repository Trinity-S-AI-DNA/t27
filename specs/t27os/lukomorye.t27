// specs/t27os/lukomorye.t27 -- t27os: Lukomorye first slice, the Cat and the
// house whose window lights at night.
// Part of M1 (milestone #5). Closes #13089.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::lukomorye;

pub struct LukomoryeSlice { cat_present: bool, window_lit: bool };

pub fn lukomorye_window_lit(s: LukomoryeSlice) -> bool {
    return s.window_lit && s.cat_present;
}

test "lukomorye window lit" {
    assert(lukomorye_window_lit(LukomoryeSlice { cat_present: true, window_lit: true }));
    assert(!lukomorye_window_lit(LukomoryeSlice { cat_present: false, window_lit: true }));
}