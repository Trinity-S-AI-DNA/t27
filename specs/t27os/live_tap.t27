// SPDX-License-Identifier: Apache-2.0
; specs/t27os/live_tap.t27 -- the live tap of the LOCAL swarm into the work graph law (epic
; #12779, milestone M2). One direction, one law: a lanes-table transition becomes one work-graph
; event, and a recorded log folds through work_graph's apply_event unchanged.
; --
; THE LIVE SIDE. The lanes table (specs/t27os/lanes_view.t27) is the only thing the window reads
; about the swarm. Its transitions map onto the bus kinds of specs/t27f/work_graph.t27: a row
; that appears is a spawn, a row that vanishes is an exit, RUNNING after BLOCKED is a restart,
; BLOCKED from any other state is a down. Nothing else maps: an IDLE to RUNNING hop is no event,
; and the tap invents no delivers -- the actor bus states them (specs/queen/actor_events.t27),
; this spec only replays what was recorded.
; --
; THE OFFLINE SIDE. The recorded log's kind vector (work_graph_fixture's REPLAY_KIND_REF, the
; same 24 events the t27.ai/t27f/live/ page replays) folds through apply_event with deterministic
; pids, so the app can replay the scalar plane without a transport. A test holds the local copy of
; the vector equal to the fixture's, so a fixture change turns this spec red here first.
; --
; Purity: every function here is a pure function of its arguments; the graph carries no clock.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLiveTap;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::Event;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::edges;
use t27f::work_graph::graph_digest;
use t27f::work_graph::EV_SPAWN;
use t27f::work_graph::EV_EXIT;
use t27f::work_graph::EV_DOWN;
use t27f::work_graph::EV_RESTART;
use t27f::work_graph::EV_DELIVER;
use t27f::work_graph::EV_DELIVERS;
use t27f::work_graph::WG_OK;
use t27os::lanes_view::LVS_RUNNING;
use t27os::lanes_view::LVS_BLOCKED;
use t27f::work_graph_fixture::REPLAY_KIND_REF;

/// No event for this transition: the tap stays silent instead of inventing one.
pub const TAP_NONE : u8 = 255;

/// The event kind of a lane's transition. `appeared` and `vanished` are the row's presence flip
/// against the previous look of the table.
pub fn tap_transition(appeared : bool, vanished : bool, prev : u32, now : u32) -> u8 {
    if (appeared) { return EV_SPAWN; }
    if (vanished) { return EV_EXIT; }
    if (now == LVS_BLOCKED and prev != LVS_BLOCKED) { return EV_DOWN; }
    if (now == LVS_RUNNING and prev == LVS_BLOCKED) { return EV_RESTART; }
    return TAP_NONE;
}

/// Whether a kind carries into the graph at all.
pub fn tap_applies(kind : u8) -> bool { return kind != TAP_NONE; }

/// Applies one tapped event. A deliver taps as D_NONE with task 0: the lanes table states the
/// actor's work happened, never a task join -- the bus states that, and the tap invents nothing.
pub fn tap_apply(g : *WorkGraph, kind : u8, from : u64, to : u64, seq : u32) -> u8 {
    if (tap_applies(kind) == false) { return WG_OK; }
    // deliver 0 is work_graph's D_NONE: the cross-module splice of that const does not reach here
    return apply_event(g, Event { kind: kind, from_pid: from, to_pid: to, task_no: 0, deliver: 0, reason: 99, seq: seq, spec_id: 0 });
}

/// The recorded log's kind vector, the scalar plane the live page replays.
pub const TAP_REPLAY : [24]u8 = [0, 0, 0, 0, 0, 0, 0, 4, 4, 4, 4, 3, 1, 4, 4, 4, 4, 4, 2, 4, 3, 1, 4, 4];

/// One replay step at index e: deterministic pids (queen 1000, first spawn 1001), the seq is the
/// index, so every replay of the same vector builds the same graph bytes.
pub fn tap_replay_step(g : *WorkGraph, e : u32, kind : u8) -> u8 {
    if (kind == EV_SPAWN) { return tap_apply(g, kind, 1001 + (e as u64), 1000, e); }
    return tap_apply(g, kind, 1000 + ((e % 7) as u64), 1000, e);
}

/// Folds a whole recorded vector; the first error code stops the fold, WG_OK means all landed.
pub fn tap_fold(g : *WorkGraph, kinds : []const u8) -> u8 {
    var e : u32 = 0;
    while (e < kinds.len) {
        const r : u8 = tap_replay_step(g, e, kinds[e]);
        if (r != WG_OK) { return r; }
        e = e + 1;
    }
    return WG_OK;
}

// ---- tests ----

test the_tap_kinds_match_the_work_graph_bus {
    assert(EV_SPAWN == 0 and EV_EXIT == 1 and EV_DOWN == 2 and EV_RESTART == 3);
    assert(EV_DELIVER == 4 and EV_DELIVERS == 5);
}

test the_lane_transitions_map_onto_the_bus_kinds {
    assert(tap_transition(true, false, LVS_IDLE, LVS_RUNNING) == EV_SPAWN);
    assert(tap_transition(false, true, LVS_RUNNING, LVS_IDLE) == EV_EXIT);
    assert(tap_transition(false, false, LVS_RUNNING, LVS_BLOCKED) == EV_DOWN);
    assert(tap_transition(false, false, LVS_IDLE, LVS_BLOCKED) == EV_DOWN);
    assert(tap_transition(false, false, LVS_BLOCKED, LVS_RUNNING) == EV_RESTART);
    // the silent hops: nothing here is an event the bus would state
    assert(tap_transition(false, false, LVS_IDLE, LVS_RUNNING) == TAP_NONE);
    assert(tap_transition(false, false, LVS_RUNNING, LVS_RUNNING) == TAP_NONE);
    assert(tap_applies(TAP_NONE) == false and tap_applies(EV_DOWN));
}

test the_replay_vector_is_the_fixture_vector {
    var i : u32 = 0;
    while (i < 24) {
        assert(TAP_REPLAY[i as usize] == REPLAY_KIND_REF[i as usize]);
        i = i + 1;
    }
}

test the_recorded_log_folds_clean_and_deterministic {
    var a : WorkGraph = new_graph();
    var b : WorkGraph = new_graph();
    assert(tap_fold(&a, TAP_REPLAY[0..24]) == WG_OK);
    assert(tap_fold(&b, TAP_REPLAY[0..24]) == WG_OK);
    // 7 spawns name 7 actors plus the queen, 12 delivers give one ACTION each; the down, the
    // restarts, the exits and the counted windows name nothing new
    assert(nodes(&a) == 20);
    assert(edges(&a) == 12);
    // the same feed twice, the same graph bytes
    var da : [32]u8 = graph_digest(&a);
    var db : [32]u8 = graph_digest(&b);
    var i : u32 = 0;
    while (i < 32) {
        assert(da[i as usize] == db[i as usize]);
        i = i + 1;
    }
}

test a_silent_tap_changes_nothing_and_lifecycle_events_add_no_nodes {
    var g : WorkGraph = new_graph();
    assert(tap_apply(&g, TAP_NONE, 5, 1, 0) == WG_OK);
    assert(nodes(&g) == 0);
    assert(tap_apply(&g, EV_SPAWN, 11, 1, 0) == WG_OK);
    const n0 : u32 = nodes(&g);
    assert(n0 == 2);
    assert(tap_apply(&g, EV_DOWN, 11, 1, 1) == WG_OK);
    assert(tap_apply(&g, EV_RESTART, 11, 1, 2) == WG_OK);
    assert(tap_apply(&g, EV_EXIT, 11, 1, 3) == WG_OK);
    assert(nodes(&g) == n0);
    assert(edges(&g) == 0);
}
