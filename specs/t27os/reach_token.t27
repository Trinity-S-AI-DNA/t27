// SPDX-License-Identifier: Apache-2.0
// specs/t27os/reach_token.t27 -- the key a person copies, with a hidden block that says where to reach them over the
// internet (owner, 2026-10-23: "an ordinary user only shares his key; chat, calls and video then work on the same Wi-Fi
// and over the internet without any server of ours"; step U1 of the reach plan; Refs gHashTag/t27#11560). Pure
// decisions only: no @extern, no socket, no clock. The window reads its own addresses, the clock and the clipboard;
// every rule it follows about the copied text is a tested fn here. ASCII only (L3), English only (LANG-EN). Flat
// namespace (the window build splices imported modules): every name here starts with rt_ / RT_.
//
// THE COPIED KEY  KEY25 alone, or KEY25 + "-" + a block. KEY25 is the invite of peer_identity.t27, unchanged
//   (T27-XXXX-XXXX-XXXX-XXXX-C, 25 characters). The block is written in the invite's own alphabet (0-9 A-Z without
//   I L O U, peer_identity sym_char / sym_value), 5 bits a symbol, most significant bit first:
//     ver 2 bits (= 1) | has6 1 | has4 1 | epoch 16 (hours since 2026-01-01T00:00Z, mod 65536)
//     if has6: IPv6 address 128 bits | port 16 (the message port, P + 1)
//     if has4: IPv4 address 32 bits | port 16
//     zero bits to a whole symbol
//     check 2 symbols: the low 10 bits of CRC-32 (peer_identity crc32) over the 16 symbol values of the key followed by
//     the data symbol values, one byte each, the high 5 bits first.
//   Lengths: 25 (no block), 42 (IPv4 only), 61 (IPv6 only), 71 (both). Every one fits a QR code of version 4 at level L
//   (qr_scan QS_TEXT_MAX 78). With no internet address the copied key is the 25 characters, byte for byte as before.
// WHY THE KEY SYMBOLS ARE IN THE CHECK  a block pasted after another person's key never checks: an address is never
//   taken for the wrong person. Every single wrong symbol of the block is caught (the CRC-32 of these lengths has no
//   single-symbol error whose low 10 bits vanish); a symbol that turns the first one into another version reads as
//   the key alone.
// OLDER BUILDS  7132 and earlier take the first 25 characters (the add field's filter, friends_view fv_inv_char, stops
//   at INVITE_LEN), so pasting the whole text still adds the friend. Their QR scanner (qr_scan qs_scan_key) parses the
//   whole text as an invite and says "no code found" for a code with a block until they update; this is known.
// WHICH ADDRESS GOES IN  only an address a friend anywhere can send to: a global unicast IPv6 (call_ip6 ip6_class
//   GLOBAL: never unique local, link-local, v4-mapped, documentation, 6to4, Teredo, NAT64 64:ff9b::/96, anything
//   outside 2000::/3) and a public IPv4 (call_view cv_addr_class PUBLIC, and also never the shared address space of a
//   carrier NAT 100.64.0.0/10 or 192.0.0.0/24, where 464XLAT puts its CLAT address); a port of 0 never. The same rule
//   is applied when a block is read: a block that checks but names another kind of address gives no address for it.
// READING PASTED TEXT (rt_find)  a messenger adds words, changes case and breaks lines. The first 25 characters that
//   parse as an invite are the key (case ignored); a "-" right after it opens the block. Inside the block CR, LF, tab
//   and space are skipped; the block ends at its own length (the first symbol says it) or at any other character, so
//   "T27-... thanks" and two keys in one text read right (the first key wins). rt_parse then says KEY_ONLY, FULL or
//   BAD_BLOCK; a block of another version is the key alone (KEY_ONLY), a damaged one is BAD_BLOCK and the key still
//   counts: the friend is added, only the address is not taken.
// OLD KEYS  the epoch is the hour the key was copied. A key more than 48 hours old may name an old address (rt_is_old);
//   the window then says so in plain words. An hour ahead of this clock (the other machine's clock is ahead) is never
//   old.
module T27osReachToken;

use t27os::peer_identity::sym_char;
use t27os::peer_identity::sym_value;
use t27os::peer_identity::crc32;
use t27os::peer_identity::invite_make;
use t27os::peer_identity::invite_parse;
use t27os::peer_identity::INVITE_LEN;
use t27os::peer_identity::INV_OK;
use t27os::peer_identity::INV_LEN;
use t27os::peer_identity::FP_BYTES;
use t27os::call_ip6::IP6_EP;
use t27os::call_ip6::IP6_C_GLOBAL;
use t27os::call_ip6::ip6_class;
use t27os::call_ip6::ip6_mapped;
use t27os::call_ip6::ip6_port;
use t27os::call_ip6::ip6_v4of;
use t27os::call_ip6::ip6_ep_v4;
use t27os::call_ip6::ip6_clear;
use t27os::call_ip6::ip6_copy;
use t27os::call_ip6::ip6_is_set;
use t27os::call_ip6::ip6_same;
use t27os::call_ip6::ip6_parse;
use t27os::call_ip6::ip6_t_field;
use t27os::call_view::cv_addr_class;
use t27os::call_view::CV_AC_PUBLIC;
use t27os::qr::qr_version_for;
use t27os::qr_scan::QS_TEXT_MAX;
use t27os::friends_view::fv_inv_char;
use t27os::editors::same_bytes;

// ---------------------------------------------------------------- 1. the shape

/// The block's version.
pub const RT_VER : u32 = 1;
/// Bits of the block: the header (ver, has6, has4, epoch), an IPv6 endpoint, an IPv4 endpoint.
pub const RT_HDR_BITS : usize = 20;
pub const RT_V6_BITS : usize = 144;
pub const RT_V4_BITS : usize = 48;
/// The check symbols at the block's end.
pub const RT_CHECK : usize = 2;
/// The most symbols a block has (both endpoints: 212 bits in 43 symbols, then the check).
pub const RT_BLOCK_MAX : usize = 45;
/// The copied text: the key alone, with an IPv4, with an IPv6, with both.
pub const RT_LEN_KEY : usize = 25;
pub const RT_LEN_V4 : usize = 42;
pub const RT_LEN_V6 : usize = 61;
pub const RT_LEN_BOTH : usize = 71;
pub const RT_TEXT_MAX : usize = 71;
/// 2026-01-01T00:00:00Z in unix seconds: hour 0 of the epoch.
pub const RT_EPOCH_UNIX : u64 = 1767225600;
/// A key older than this many hours may name an old address.
pub const RT_OLD_H : u32 = 48;

/// rt_parse.
pub const RT_NONE : u32 = 0;
pub const RT_KEY_ONLY : u32 = 1;
pub const RT_FULL : u32 = 2;
pub const RT_BAD_BLOCK : u32 = 3;

/// The length of the copied text with these endpoints in its block.
pub fn rt_len_for(has6: bool, has4: bool) -> usize {
    if (!has6 and !has4) { return RT_LEN_KEY; }
    var bits : usize = RT_HDR_BITS;
    if (has6) { bits = bits + RT_V6_BITS; }
    if (has4) { bits = bits + RT_V4_BITS; }
    return INVITE_LEN + 1 + (bits + 4) / 5 + RT_CHECK;
}

/// The symbols of a block whose first symbol is s0, the check included; 0 for another version (so for any value past
/// 31) or a block with no endpoint (never written).
pub fn rt_block_len(s0: u32) -> usize {
    if ((s0 >> 3) != RT_VER) { return 0; }
    const has6 : bool = ((s0 >> 2) & 1) == 1;
    const has4 : bool = ((s0 >> 1) & 1) == 1;
    if (!has6 and !has4) { return 0; }
    return rt_len_for(has6, has4) - INVITE_LEN - 1;
}

// ---------------------------------------------------------------- 2. which addresses go in

/// An IPv6 endpoint a friend anywhere can send to: a global unicast address (ip6_class GLOBAL) and a port.
pub fn rt_cand_ok_v6(ep: []const u8) -> bool {
    if (ep.len < IP6_EP or ip6_port(ep) == 0) { return false; }
    return ip6_class(ep) == IP6_C_GLOBAL;
}

/// A public IPv4 (ip, 32 bits): call_view's PUBLIC class, less the carrier NAT space 100.64.0.0/10 and 192.0.0.0/24.
pub fn rt_v4_public(ip: u64) -> bool {
    if (cv_addr_class(ip) != CV_AC_PUBLIC) { return false; }
    const a : u64 = ip >> 24;
    const b : u64 = (ip >> 16) & 255;
    const c : u64 = (ip >> 8) & 255;
    if (a == 100 and b >= 64 and b <= 127) { return false; }
    if (a == 192 and b == 0 and c == 0) { return false; }
    return true;
}

/// An IPv4 endpoint (v4-mapped, call_ip6 ip6_ep_v4) a friend anywhere can send to: a public IPv4 and a port.
pub fn rt_cand_ok_v4(ep: []const u8) -> bool {
    if (ep.len < IP6_EP or !ip6_mapped(ep) or ip6_port(ep) == 0) { return false; }
    return rt_v4_public(ip6_v4of(ep) / 65536);
}

// ---------------------------------------------------------------- 3. the epoch

/// Hours since 2026-01-01T00:00Z of unix time unix_s, mod 65536; 0 for a clock before it.
pub fn rt_epoch_hours(unix_s: u64) -> u32 {
    if (unix_s < RT_EPOCH_UNIX) { return 0; }
    return @as(u32, @intCast(((unix_s - RT_EPOCH_UNIX) / 3600) % 65536));
}

/// A key copied at hour tok_h is old at hour now_h: more than RT_OLD_H hours before it (mod 65536). A key from the
/// future half (the other clock is ahead) is not old.
pub fn rt_is_old(tok_h: u32, now_h: u32) -> bool {
    const d : u32 = ((now_h & 65535) + 65536 - (tok_h & 65535)) & 65535;
    return d > RT_OLD_H and d < 32768;
}

// ---------------------------------------------------------------- 4. bits and the check

/// The k low bits of v (k <= 16), the highest first, at bit p of the symbols s (zeroed by the caller); the next bit.
fn rt_put(s: []u8, p: usize, v: u32, k: usize) -> usize {
    var i : usize = 0;
    while (i < k) {
        const bit : u32 = (v >> @as(u32, @intCast(k - 1 - i))) & 1;
        if (bit != 0) {
            const q : usize = p + i;
            s[q / 5] = s[q / 5] | @as(u8, @intCast(16 >> @as(u32, @intCast(q % 5))));
        }
        i = i + 1;
    }
    return p + k;
}

/// k bits (k <= 16) at bit p of the symbols s, the highest first.
fn rt_get(s: []const u8, p: usize, k: usize) -> u32 {
    var v : u32 = 0;
    var i : usize = 0;
    while (i < k) {
        const q : usize = p + i;
        const bit : u32 = (@as(u32, s[q / 5]) >> @as(u32, @intCast(4 - q % 5))) & 1;
        v = (v << 1) | bit;
        i = i + 1;
    }
    return v;
}

/// The 10-bit check of a block: CRC-32 over the 16 symbol values of key (a valid invite) and the nd data symbols d.
fn rt_check(key: []const u8, d: []const u8, nd: usize) -> u32 {
    var b : [59]u8 = undefined;
    var j : usize = 0;
    while (j < 16) {
        b[j] = @as(u8, @intCast(sym_value(key[4 + 5 * (j / 4) + j % 4]) & 31));
        j = j + 1;
    }
    var i : usize = 0;
    while (i < nd) {
        b[16 + i] = d[i];
        i = i + 1;
    }
    return crc32(b[0..59], 16 + nd) & 1023;
}

// ---------------------------------------------------------------- 5. the copied text

/// The block after the key in out[0..25] (a valid invite): "-" and the symbols at out[25..]; the whole length. No
/// address rule here: rt_encode decides what goes in (the tests write refused addresses with it).
fn rt_pack(out: []u8, has6: bool, ep6: []const u8, has4: bool, ep4: []const u8, epoch_h: u32) -> usize {
    var s : [45]u8 = undefined;
    var i : usize = 0;
    while (i < RT_BLOCK_MAX) {
        s[i] = 0;
        i = i + 1;
    }
    var f6 : u32 = 0;
    var f4 : u32 = 0;
    if (has6) { f6 = 1; }
    if (has4) { f4 = 1; }
    var p : usize = rt_put(s[0..45], 0, RT_VER, 2);
    p = rt_put(s[0..45], p, f6, 1);
    p = rt_put(s[0..45], p, f4, 1);
    p = rt_put(s[0..45], p, epoch_h & 65535, 16);
    if (has6) {
        i = 0;
        while (i < 16) {
            p = rt_put(s[0..45], p, @as(u32, ep6[i]), 8);
            i = i + 1;
        }
        p = rt_put(s[0..45], p, @as(u32, @intCast(ip6_port(ep6))), 16);
    }
    if (has4) {
        i = 12;
        while (i < 16) {
            p = rt_put(s[0..45], p, @as(u32, ep4[i]), 8);
            i = i + 1;
        }
        p = rt_put(s[0..45], p, @as(u32, @intCast(ip6_port(ep4))), 16);
    }
    const nd : usize = (p + 4) / 5;
    const c : u32 = rt_check(out[0..INVITE_LEN], s[0..45], nd);
    s[nd] = @as(u8, @intCast((c >> 5) & 31));
    s[nd + 1] = @as(u8, @intCast(c & 31));
    out[INVITE_LEN] = 45;
    i = 0;
    while (i < nd + RT_CHECK) {
        out[INVITE_LEN + 1 + i] = sym_char(@as(u32, s[i]));
        i = i + 1;
    }
    return INVITE_LEN + 1 + nd + RT_CHECK;
}

/// What COPY MY KEY and the QR carry for fingerprint fp (10 bytes): the key, and a block with ep6 when rt_cand_ok_v6
/// takes it and ep4 when rt_cand_ok_v4 does (an empty or refused endpoint is left out), stamped with hour epoch_h
/// (rt_epoch_hours; mod 65536). Into out; the length (25, 42, 61 or 71), 0 on a bad size.
pub fn rt_encode(fp: []const u8, ep6: []const u8, ep4: []const u8, epoch_h: u32, out: []u8) -> usize {
    if (fp.len != FP_BYTES) { return 0; }
    const has6 : bool = rt_cand_ok_v6(ep6);
    const has4 : bool = rt_cand_ok_v4(ep4);
    const n : usize = rt_len_for(has6, has4);
    if (out.len < n) { return 0; }
    if (invite_make(fp, out[0..INVITE_LEN]) != INVITE_LEN) { return 0; }
    if (n == RT_LEN_KEY) { return n; }
    return rt_pack(out, has6, ep6, has4, ep4, epoch_h);
}

// ---------------------------------------------------------------- 6. pasted text

/// CR, LF, tab and space: a messenger's line break or spacing inside the block.
fn rt_gap(c: u8) -> bool { return c == 32 or c == 9 or c == 10 or c == 13; }

/// The first key in text[0..n] with its block, as the copied text was: into out (RT_TEXT_MAX bytes at least) the 25
/// characters of the key in upper case and, when "-" follows the key at once, "-" and the block's symbols in upper
/// case, gaps left out, up to the block's own length (the first symbol says it; one symbol for another version) or the
/// first other character. The length written: 25 for a key alone, 0 when the text holds no key.
pub fn rt_find(text: []const u8, n: usize, out: []u8) -> usize {
    if (n > text.len or out.len < RT_TEXT_MAX) { return 0; }
    var i : usize = 0;
    while (i + INVITE_LEN <= n) {
        var fp : [10]u8 = undefined;
        if (invite_parse(text[i .. i + INVITE_LEN], fp[0..10]) == INV_OK) {
            invite_make(fp[0..10], out[0..INVITE_LEN]);
            var j : usize = i + INVITE_LEN;
            if (j >= n or text[j] != 45) { return INVITE_LEN; }
            out[INVITE_LEN] = 45;
            j = j + 1;
            var want : usize = RT_BLOCK_MAX;
            var got : usize = 0;
            while (j < n and got < want) {
                const c : u8 = text[j];
                if (!rt_gap(c)) {
                    const v : u32 = sym_value(c);
                    if (v > 31) { break; }
                    if (got == 0) {
                        want = rt_block_len(v);
                        if (want == 0) { want = 1; }
                    }
                    out[INVITE_LEN + 1 + got] = sym_char(v);
                    got = got + 1;
                }
                j = j + 1;
            }
            if (got == 0) { return INVITE_LEN; }
            return INVITE_LEN + 1 + got;
        }
        i = i + 1;
    }
    return 0;
}

/// Read the copied text t[0..n] (rt_find's output, or rt_encode's): the fingerprint into fp (10 bytes), the IPv6 and
/// IPv4 endpoints into ep6 and ep4 (18 bytes each, all zero when there is none) and the hour it was copied into
/// eh[0] (0 when there is no block). RT_NONE: no key (or a short argument; nothing is written then); RT_KEY_ONLY: the
/// key alone, a block of another version, or a block that checks with no address rt_cand_ok_v6 / rt_cand_ok_v4 take;
/// RT_FULL: the key and at least one address; RT_BAD_BLOCK: the key, and a block that is cut, too long, holds another
/// character, has a pad bit set or fails the check (no address is taken from it).
pub fn rt_parse(t: []const u8, n: usize, fp: []u8, ep6: []u8, ep4: []u8, eh: []u32) -> u32 {
    if (n > t.len or fp.len < FP_BYTES or ep6.len < IP6_EP or ep4.len < IP6_EP or eh.len < 1) { return RT_NONE; }
    ip6_clear(ep6);
    ip6_clear(ep4);
    eh[0] = 0;
    if (n < INVITE_LEN or invite_parse(t[0..INVITE_LEN], fp) != INV_OK) { return RT_NONE; }
    if (n == INVITE_LEN) { return RT_KEY_ONLY; }
    if (t[INVITE_LEN] != 45 or n == INVITE_LEN + 1) { return RT_BAD_BLOCK; }
    const s0 : u32 = sym_value(t[INVITE_LEN + 1]);
    if (s0 > 31) { return RT_BAD_BLOCK; }
    if ((s0 >> 3) != RT_VER) { return RT_KEY_ONLY; }
    const bl : usize = rt_block_len(s0);
    if (bl == 0 or n != INVITE_LEN + 1 + bl) { return RT_BAD_BLOCK; }
    var s : [45]u8 = undefined;
    var k : usize = 0;
    while (k < bl) {
        const v : u32 = sym_value(t[INVITE_LEN + 1 + k]);
        if (v > 31) { return RT_BAD_BLOCK; }
        s[k] = @as(u8, @intCast(v));
        k = k + 1;
    }
    const nd : usize = bl - RT_CHECK;
    const c : u32 = rt_check(t[0..INVITE_LEN], s[0..45], nd);
    if (@as(u32, s[nd]) != ((c >> 5) & 31) or @as(u32, s[nd + 1]) != (c & 31)) { return RT_BAD_BLOCK; }
    const has6 : bool = ((s0 >> 2) & 1) == 1;
    const has4 : bool = ((s0 >> 1) & 1) == 1;
    var bits : usize = RT_HDR_BITS;
    if (has6) { bits = bits + RT_V6_BITS; }
    if (has4) { bits = bits + RT_V4_BITS; }
    if (rt_get(s[0..45], bits, nd * 5 - bits) != 0) { return RT_BAD_BLOCK; }
    const e : u32 = rt_get(s[0..45], 4, 16);
    var p : usize = RT_HDR_BITS;
    var g6 : [18]u8 = undefined;
    var g4 : [18]u8 = undefined;
    ip6_clear(g6[0..18]);
    ip6_clear(g4[0..18]);
    if (has6) {
        k = 0;
        while (k < 16) {
            g6[k] = @as(u8, @intCast(rt_get(s[0..45], p, 8)));
            p = p + 8;
            k = k + 1;
        }
        const port6 : u32 = rt_get(s[0..45], p, 16);
        g6[16] = @as(u8, @intCast(port6 >> 8));
        g6[17] = @as(u8, @intCast(port6 & 255));
        p = p + 16;
    }
    if (has4) {
        const hi : u64 = @as(u64, rt_get(s[0..45], p, 16));
        const lo : u64 = @as(u64, rt_get(s[0..45], p + 16, 16));
        const port4 : u64 = @as(u64, rt_get(s[0..45], p + 32, 16));
        ip6_ep_v4(hi * 65536 + lo, port4, g4[0..18]);
    }
    var any : bool = false;
    if (has6 and rt_cand_ok_v6(g6[0..18])) {
        ip6_copy(ep6, g6[0..18]);
        any = true;
    }
    if (has4 and rt_cand_ok_v4(g4[0..18])) {
        ip6_copy(ep4, g4[0..18]);
        any = true;
    }
    if (!any) { return RT_KEY_ONLY; }
    eh[0] = e;
    return RT_FULL;
}

// ---------------------------------------------------------------- tests

/// The fingerprints of the tests (the first is peer_identity's test fingerprint: its key is T27-04HM-...).
const RT_T_FP1 : [10]u8 = [1, 35, 69, 103, 137, 171, 205, 239, 254, 220];
const RT_T_FP2 : [10]u8 = [254, 220, 186, 152, 118, 84, 50, 16, 1, 35];

/// The copied texts of the tests, from an independent reference encoder (Python, zlib.crc32), not from rt_encode:
/// FP1 with epoch 1234 and no address; FP1, epoch 7000, [3ffe:18:1917:f34e::1]:47728 and/or 203.0.113.7:47728; FP2,
/// epoch 65535, [3ffe:ffff:abcd:1234:5678:9abc:def0:fedc]:65535 and 198.51.100.200:51234; FP2, epoch 1, the IPv4 alone.
const RT_T_NONE : str = "T27-04HM-ASW9-NF6Y-ZZPW-D";
const RT_T_V4 : str = "T27-04HM-ASW9-NF6Y-ZZPW-D-A6TRSC0721XTE0A0";
const RT_T_V6 : str = "T27-04HM-ASW9-NF6Y-ZZPW-D-C6TR7ZZ0060S2ZSMW0000000000006X70VJ";
const RT_T_BOTH : str = "T27-04HM-ASW9-NF6Y-ZZPW-D-E6TR7ZZ0060S2ZSMW0000000000006X71JR0E43VMW06T";
const RT_T_BOTH2 : str = "T27-ZVEB-N63P-AGS1-0093-K-FZZZ7ZZFZZXBSM938NKRKAYDXW7YVKZZZHHKCK4CG8GQ2";
const RT_T_V4B : str = "T27-ZVEB-N63P-AGS1-0093-K-A001RRSP9J6848Y3";

fn rt_t_eq(a: []const u8, n: usize, s: []const u8) -> bool {
    if (n != s.len or n > a.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (a[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn rt_t_copy(dst: []u8, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len and i < dst.len) {
        dst[i] = s[i];
        i = i + 1;
    }
    return i;
}

fn rt_t_ep(s: []const u8, ep: []u8) -> bool { return ip6_parse(s, s.len, ep); }

/// The six test keys in one order (none, v4, v6, both, both2, v4b), picked by index. The tests walk them through this
/// pick and the address lists below through ip6_t_field instead of arrays of slices, which gen-verilog cannot lower
/// (W469), so the spec seals on every backend.
fn rt_t_tok(i: usize) -> []const u8 {
    if (i == 0) { return RT_T_NONE; }
    if (i == 1) { return RT_T_V4; }
    if (i == 2) { return RT_T_V6; }
    if (i == 3) { return RT_T_BOTH; }
    if (i == 4) { return RT_T_BOTH2; }
    return RT_T_V4B;
}

/// The address lists of the candidate tests, one '|'-separated text each.
const RT_T_NO6 : str = "[fd12:3456::1]:47728|[fc00::1]:47728|[fe80::1]:47728|[2001:db8::1]:47728|[3fff::1]:47728|[64:ff9b::c000:201]:47728|[2002:c000:201::1]:47728|[2001:0:4136:e378::1]:47728|[::1]:47728|[::]:47728|[ff02::1]:47728|[4000::1]:47728";
const RT_T_YES4 : str = "203.0.113.7:47728|198.51.100.200:1|100.63.255.255:47728|100.128.0.1:47728|192.0.1.1:47728|191.255.255.255:65535";
const RT_T_NO4 : str = "192.0.0.2:47728|192.0.0.255:47728|100.64.0.1:47728|100.127.255.254:47728|192.168.1.10:47728|10.0.0.1:47728|172.16.0.1:47728|172.31.255.255:47728|127.0.0.1:47728|0.1.2.3:47728|240.0.0.1:47728|255.255.255.255:47728|224.0.0.1:47728|169.254.1.1:47728";
const RT_T_PNO6 : str = "[fd12:3456::1]:47728|[fe80::1]:47728|[2001:db8::1]:47728|[64:ff9b::c000:201]:47728|[3ffe:18:1917:f34e::1]:47728|[::1]:47728";
const RT_T_PNO4 : str = "192.0.0.2:47728|100.64.0.1:47728|192.168.1.10:47728|10.1.2.3:47728|127.0.0.1:47728|0.0.0.1:47728|203.0.113.7:0";

/// The test endpoints: a = [3ffe:18:1917:f34e::1]:47728, b = 203.0.113.7:47728.
fn rt_t_a6(ep: []u8) -> void { rt_t_ep("[3ffe:18:1917:f34e::1]:47728", ep); }
fn rt_t_a4(ep: []u8) -> void { rt_t_ep("203.0.113.7:47728", ep); }

/// Recompute the two check symbols of the copied text t[0..n] after a test changed its data symbols.
fn rt_t_reseal(t: []u8, n: usize) -> void {
    var s : [45]u8 = undefined;
    const bl : usize = n - INVITE_LEN - 1;
    var k : usize = 0;
    while (k < bl) {
        s[k] = @as(u8, @intCast(sym_value(t[INVITE_LEN + 1 + k]) & 31));
        k = k + 1;
    }
    const c : u32 = rt_check(t[0..INVITE_LEN], s[0..45], bl - RT_CHECK);
    t[n - 2] = sym_char((c >> 5) & 31);
    t[n - 1] = sym_char(c & 31);
}

/// rt_parse of t[0..n] and nothing else asked.
fn rt_t_kind(t: []const u8, n: usize) -> u32 {
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    return rt_parse(t, n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]);
}

test rt_the_copied_key_has_one_length_per_kind_of_block_and_fits_a_small_qr_code {
    assert rt_len_for(false, false) == RT_LEN_KEY and RT_LEN_KEY == INVITE_LEN;
    assert rt_len_for(false, true) == RT_LEN_V4 and RT_LEN_V4 == 42;
    assert rt_len_for(true, false) == RT_LEN_V6 and RT_LEN_V6 == 61;
    assert rt_len_for(true, true) == RT_LEN_BOTH and RT_LEN_BOTH == 71 and RT_TEXT_MAX == RT_LEN_BOTH;
    assert RT_BLOCK_MAX == RT_LEN_BOTH - INVITE_LEN - 1;
    // the first symbol says the length: ver 01, has6, has4, the epoch's top bit
    assert rt_block_len(10) == 16 and rt_block_len(11) == 16;
    assert rt_block_len(12) == 35 and rt_block_len(13) == 35;
    assert rt_block_len(14) == 45 and rt_block_len(15) == 45;
    assert rt_block_len(8) == 0 and rt_block_len(9) == 0;
    assert rt_block_len(0) == 0 and rt_block_len(7) == 0 and rt_block_len(16) == 0;
    assert rt_block_len(31) == 0 and rt_block_len(32) == 0 and rt_block_len(42) == 0;
    // every length fits the scanner's text and a QR code of version 4 at level L
    const lens : [4]usize = [RT_LEN_KEY, RT_LEN_V4, RT_LEN_V6, RT_LEN_BOTH];
    var i : usize = 0;
    while (i < 4) {
        assert lens[i] <= QS_TEXT_MAX;
        assert qr_version_for(lens[i]) >= 2 and qr_version_for(lens[i]) <= 4;
        i = i + 1;
    }
    assert qr_version_for(RT_LEN_KEY) == 2 and qr_version_for(RT_LEN_BOTH) == 4;
}

test rt_the_copied_key_is_the_reference_encoders_text_bit_for_bit {
    var a6 : [18]u8 = undefined;
    var a4 : [18]u8 = undefined;
    var b6 : [18]u8 = undefined;
    var b4 : [18]u8 = undefined;
    rt_t_a6(a6[0..18]);
    rt_t_a4(a4[0..18]);
    assert rt_t_ep("[3ffe:ffff:abcd:1234:5678:9abc:def0:fedc]:65535", b6[0..18]);
    assert rt_t_ep("198.51.100.200:51234", b4[0..18]);
    var o : [80]u8 = undefined;
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..0], 1234, o[0..80]), RT_T_NONE);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..18], 7000, o[0..80]), RT_T_V4);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..18], a4[0..0], 7000, o[0..80]), RT_T_V6);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..18], a4[0..18], 7000, o[0..80]), RT_T_BOTH);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP2[0..10], b6[0..18], b4[0..18], 65535, o[0..80]), RT_T_BOTH2);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP2[0..10], b6[0..0], b4[0..18], 1, o[0..80]), RT_T_V4B);
    // the epoch is mod 65536; an all-zero endpoint is no endpoint
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..18], a4[0..18], 65536 + 7000, o[0..80]), RT_T_BOTH);
    var z : [18]u8 = undefined;
    ip6_clear(z[0..18]);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], z[0..18], z[0..18], 7000, o[0..80]), RT_T_NONE);
    // one hour later is another text (the epoch is in it)
    const later : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-A6TSSC0721XTE0M0";
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..18], 7001, o[0..80]), later);
    // short room and a wrong fingerprint size write nothing
    assert rt_encode(RT_T_FP1[0..10], a6[0..18], a4[0..18], 7000, o[0..70]) == 0;
    assert rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..18], 7000, o[0..41]) == 0;
    assert rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..0], 7000, o[0..24]) == 0;
    assert rt_encode(RT_T_FP1[0..9], a6[0..0], a4[0..0], 7000, o[0..80]) == 0;
    assert rt_encode(RT_T_FP1[0..10], a6[0..0], a4[0..0], 7000, o[0..25]) == 25;
}

test rt_every_kind_of_copied_key_reads_back_to_the_same_key_addresses_and_hour {
    var a6 : [18]u8 = undefined;
    var a4 : [18]u8 = undefined;
    var b6 : [18]u8 = undefined;
    var b4 : [18]u8 = undefined;
    rt_t_a6(a6[0..18]);
    rt_t_a4(a4[0..18]);
    assert rt_t_ep("[3ffe:ffff:abcd:1234:5678:9abc:def0:fedc]:65535", b6[0..18]);
    assert rt_t_ep("198.51.100.200:51234", b4[0..18]);
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    // the reference texts, as pasted
    assert rt_parse(RT_T_NONE, 25, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
    assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]) and eh[0] == 0;
    assert rt_parse(RT_T_V4, 42, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and ip6_same(e4[0..18], a4[0..18]);
    assert eh[0] == 7000;
    assert ip6_v4of(e4[0..18]) == 3405803783 * 65536 + 47728;
    assert rt_parse(RT_T_V6, 61, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert ip6_same(e6[0..18], a6[0..18]) and !ip6_is_set(e4[0..18]) and eh[0] == 7000 and ip6_port(e6[0..18]) == 47728;
    assert rt_parse(RT_T_BOTH, 71, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert ip6_same(e6[0..18], a6[0..18]) and ip6_same(e4[0..18], a4[0..18]) and eh[0] == 7000;
    assert rt_parse(RT_T_BOTH2, 71, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert same_bytes(fp[0..10], RT_T_FP2[0..10]) and ip6_same(e6[0..18], b6[0..18]) and ip6_same(e4[0..18], b4[0..18]);
    assert eh[0] == 65535 and ip6_port(e6[0..18]) == 65535 and ip6_port(e4[0..18]) == 51234;
    assert rt_parse(RT_T_V4B, 42, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert ip6_same(e4[0..18], b4[0..18]) and eh[0] == 1;
    // and what rt_encode makes, over many fingerprints, hours and both kinds
    var o : [80]u8 = undefined;
    var m : u32 = 0;
    while (m < 48) {
        var f : [10]u8 = undefined;
        var i : usize = 0;
        while (i < 10) {
            f[i] = @as(u8, @intCast((m * 53 + @as(u32, @intCast(i)) * 29 + 3) & 255));
            i = i + 1;
        }
        const h : u32 = (m * 1409) & 65535;
        var w6 : [18]u8 = undefined;
        var w4 : [18]u8 = undefined;
        assert ip6_copy(w6[0..18], a6[0..18]) and ip6_copy(w4[0..18], b4[0..18]);
        w6[15] = @as(u8, @intCast(m & 255));
        w6[17] = @as(u8, @intCast((m * 7) & 255));
        w4[15] = @as(u8, @intCast((m * 3) & 255));
        var kind : u32 = 0;
        while (kind < 4) {
            var n6 : usize = 0;
            var n4 : usize = 0;
            if ((kind & 1) == 1) { n6 = 18; }
            if ((kind & 2) == 2) { n4 = 18; }
            const n : usize = rt_encode(f[0..10], w6[0..n6], w4[0..n4], h, o[0..80]);
            assert n == rt_len_for(n6 > 0, n4 > 0);
            var back : [80]u8 = undefined;
            const k2 : usize = rt_find(o[0..80], n, back[0..80]);
            assert k2 == n and same_bytes(back[0..n], o[0..n]);
            const r : u32 = rt_parse(o[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]);
            assert same_bytes(fp[0..10], f[0..10]);
            if (kind == 0) {
                assert r == RT_KEY_ONLY and eh[0] == 0;
            } else {
                assert r == RT_FULL and eh[0] == h;
            }
            assert ip6_same(e6[0..18], w6[0..18]) == (n6 > 0) and ip6_is_set(e6[0..18]) == (n6 > 0);
            assert ip6_same(e4[0..18], w4[0..18]) == (n4 > 0) and ip6_is_set(e4[0..18]) == (n4 > 0);
            kind = kind + 1;
        }
        m = m + 1;
    }
}

test rt_the_first_25_characters_are_the_key_an_older_build_adds {
    var i : usize = 0;
    while (i < 6) {
        const t : []const u8 = rt_t_tok(i);
        var fp : [10]u8 = undefined;
        assert invite_parse(t[0..INVITE_LEN], fp[0..10]) == INV_OK;
        var mk : [25]u8 = undefined;
        assert invite_make(fp[0..10], mk[0..25]) == 25 and same_bytes(mk[0..25], t[0..25]);
        // the add field of 7132: fv_inv_char on every unit, stop at INVITE_LEN (glass_window cl_unit, qr_cam
        // qc_fill_field)
        var field : [25]u8 = undefined;
        var m : usize = 0;
        var j : usize = 0;
        while (j < t.len) {
            const c : u32 = fv_inv_char(@as(u32, t[j]));
            if (c != 0 and m < INVITE_LEN) {
                field[m] = @as(u8, @intCast(c));
                m = m + 1;
            }
            j = j + 1;
        }
        assert m == INVITE_LEN;
        var fp2 : [10]u8 = undefined;
        assert invite_parse(field[0..25], fp2[0..10]) == INV_OK and same_bytes(fp2[0..10], fp[0..10]);
        // the scanner of 7132 reads the whole code as an invite: a code with a block is not a key there
        if (t.len > INVITE_LEN) { assert invite_parse(t, fp2[0..10]) == INV_LEN; }
        i = i + 1;
    }
}

test rt_every_single_wrong_symbol_of_a_block_is_caught {
    var tried : u32 = 0;
    var caught : u32 = 0;
    var other_ver : u32 = 0;
    var i : usize = 0;
    while (i < 3) {
        const t : []const u8 = rt_t_tok(i + 1);
        var pos : usize = INVITE_LEN + 1;
        while (pos < t.len) {
            var v : u32 = 0;
            while (v < 32) {
                const ch : u8 = sym_char(v);
                if (ch != t[pos]) {
                    var a : [71]u8 = undefined;
                    const n : usize = rt_t_copy(a[0..71], t);
                    a[pos] = ch;
                    tried = tried + 1;
                    const r : u32 = rt_t_kind(a[0..71], n);
                    if (r == RT_BAD_BLOCK) { caught = caught + 1; }
                    // a first symbol of another version: the key alone, never an address
                    if (pos == INVITE_LEN + 1 and (v >> 3) != RT_VER and r == RT_KEY_ONLY) {
                        caught = caught + 1;
                        other_ver = other_ver + 1;
                    }
                }
                v = v + 1;
            }
            pos = pos + 1;
        }
        i = i + 1;
    }
    // (16 + 35 + 45) positions x 31 other symbols; at the first position 24 of the 31 are another version
    assert tried == 96 * 31;
    assert caught == tried;
    assert other_ver == 3 * 24;
}

test rt_a_block_pasted_after_another_key_never_checks {
    var i : usize = 0;
    while (i < 5) {
        const t : []const u8 = rt_t_tok(i + 1);
        var a : [71]u8 = undefined;
        const n : usize = rt_t_copy(a[0..71], t);
        // the other test key in front of the block
        var other : [25]u8 = undefined;
        var ofp : [10]u8 = RT_T_FP1;
        if (t[4] == 48) { ofp = RT_T_FP2; }
        assert invite_make(ofp[0..10], other[0..25]) == 25;
        rt_t_copy(a[0..25], other[0..25]);
        var fp : [10]u8 = undefined;
        var e6 : [18]u8 = undefined;
        var e4 : [18]u8 = undefined;
        var eh : [2]u32 = undefined;
        assert rt_parse(a[0..71], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_BAD_BLOCK;
        assert same_bytes(fp[0..10], ofp[0..10]) and !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]) and eh[0] == 0;
        i = i + 1;
    }
    // a block moved onto each key one symbol away (the key's own check symbol made right again)
    var a : [71]u8 = undefined;
    const n : usize = rt_t_copy(a[0..71], RT_T_BOTH);
    var pos : usize = 4;
    var tried : u32 = 0;
    while (pos < 23) {
        if (pos != 8 and pos != 13 and pos != 18) {
            var b : [71]u8 = a;
            b[pos] = sym_char((sym_value(a[pos]) + 1) & 31);
            var f2 : [10]u8 = undefined;
            var cv : u32 = 0;
            while (cv < 32 and invite_parse(b[0..25], f2[0..10]) != INV_OK) {
                b[24] = sym_char(cv);
                cv = cv + 1;
            }
            assert invite_parse(b[0..25], f2[0..10]) == INV_OK;
            tried = tried + 1;
            assert rt_t_kind(b[0..71], n) == RT_BAD_BLOCK;
        }
        pos = pos + 1;
    }
    assert tried == 16;
}

test rt_pasted_text_is_read_as_a_messenger_leaves_it {
    var o : [80]u8 = undefined;
    // lower case, a line break (CR LF; the '#' is the CR) and spaces inside the block, words around it
    var t1 : [100]u8 = undefined;
    const n1 : usize = rt_t_copy(t1[0..100], "Here is my key: t27-04hm-asw9-nf6y-zzpw-d-e6tr7zz0060s2zsmw#\n0000000000006x71jr0e43vmw06t thanks!");
    var k : usize = 0;
    while (k < n1) {
        if (t1[k] == 35) { t1[k] = 13; }
        k = k + 1;
    }
    assert rt_t_eq(o[0..80], rt_find(t1[0..n1], n1, o[0..80]), RT_T_BOTH);
    const t2 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-A6TR SC07 21XT E0A0";
    assert rt_t_eq(o[0..80], rt_find(t2, t2.len, o[0..80]), RT_T_V4);
    const t3 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-\nC6TR7ZZ0060S2ZSMW0000000000006X70VJ\n";
    assert rt_t_eq(o[0..80], rt_find(t3, t3.len, o[0..80]), RT_T_V6);
    // the block ends at its own length: a word right after it stays out
    const t4 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-A6TRSC0721XTE0A0thanks";
    assert rt_t_eq(o[0..80], rt_find(t4, t4.len, o[0..80]), RT_T_V4);
    // the key alone with words after it
    const t5 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D thanks";
    assert rt_t_eq(o[0..80], rt_find(t5, t5.len, o[0..80]), RT_T_NONE);
    assert rt_t_kind(o[0..80], 25) == RT_KEY_ONLY;
    const t6 : []const u8 = "t27-04hm-asw9-nf6y-zzpw-d";
    assert rt_t_eq(o[0..80], rt_find(t6, t6.len, o[0..80]), RT_T_NONE);
    // two keys: the first
    const t7 : []const u8 = "T27-ZVEB-N63P-AGS1-0093-K-A001RRSP9J6848Y3 and T27-04HM-ASW9-NF6Y-ZZPW-D-A6TRSC0721XTE0A0";
    assert rt_t_eq(o[0..80], rt_find(t7, t7.len, o[0..80]), RT_T_V4B);
    const t8 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D T27-ZVEB-N63P-AGS1-0093-K-A001RRSP9J6848Y3";
    assert rt_t_eq(o[0..80], rt_find(t8, t8.len, o[0..80]), RT_T_NONE);
    // "T27-" that is no key is passed over
    const t9 : []const u8 = "T27-OS is new. T27-04HM-ASW9-NF6Y-ZZPW-D-A6TRSC0721XTE0A0";
    assert rt_t_eq(o[0..80], rt_find(t9, t9.len, o[0..80]), RT_T_V4);
    // a gap between the key and the dash: the key alone
    const t10 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D -A6TRSC0721XTE0A0";
    assert rt_t_eq(o[0..80], rt_find(t10, t10.len, o[0..80]), RT_T_NONE);
    // a block cut by other text: the key, and a block rt_parse calls bad
    const t11 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-E6TR7ZZ0060S2Z, sorry";
    const n11 : usize = rt_find(t11, t11.len, o[0..80]);
    assert rt_t_eq(o[0..80], n11, "T27-04HM-ASW9-NF6Y-ZZPW-D-E6TR7ZZ0060S2Z");
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    assert rt_parse(o[0..80], n11, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_BAD_BLOCK;
    assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]);
    // a lone dash at the end, a dash and words: the key alone
    const t12 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-";
    assert rt_t_eq(o[0..80], rt_find(t12, t12.len, o[0..80]), RT_T_NONE);
    const t13 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D- !";
    assert rt_t_eq(o[0..80], rt_find(t13, t13.len, o[0..80]), RT_T_NONE);
    // a block of another version: one symbol, read as the key alone
    const t14 : []const u8 = "T27-04HM-ASW9-NF6Y-ZZPW-D-ZZZZZZZ";
    assert rt_t_eq(o[0..80], rt_find(t14, t14.len, o[0..80]), "T27-04HM-ASW9-NF6Y-ZZPW-D-Z");
    assert rt_t_kind(o[0..80], 27) == RT_KEY_ONLY;
    // the lower-case text itself also reads
    const lc : []const u8 = "t27-04hm-asw9-nf6y-zzpw-d-a6trsc0721xte0a0";
    assert rt_parse(lc, lc.len, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL and eh[0] == 7000;
    // no key: nothing
    assert rt_find("hello", 5, o[0..80]) == 0;
    assert rt_find("T27-04HM-ASW9-NF6Y-ZZPW-E", 25, o[0..80]) == 0;
    assert rt_find("T27-04HM-ASW9-NF6Y-ZZPW-", 24, o[0..80]) == 0;
    assert rt_find(t1[0..n1], n1 + 1, o[0..80]) == 0;
    assert rt_find(t1[0..n1], n1, o[0..70]) == 0;
    assert rt_find(t1[0..n1], 0, o[0..80]) == 0;
}

test rt_only_an_address_a_friend_anywhere_can_reach_goes_in {
    var e : [18]u8 = undefined;
    // IPv6: global unicast with a port only
    assert rt_t_ep("[3ffe:18:1917:f34e::1]:47728", e[0..18]) and rt_cand_ok_v6(e[0..18]);
    assert rt_t_ep("[2001:200::1]:1", e[0..18]) and rt_cand_ok_v6(e[0..18]);
    var lb : [48]u8 = undefined;
    var ln : usize = 0;
    var i : usize = 0;
    while (i < 12) {
        ln = ip6_t_field(RT_T_NO6, i, lb[0..48]);
        assert rt_t_ep(lb[0..ln], e[0..18]);
        assert rt_cand_ok_v6(e[0..18]) == false;
        i = i + 1;
    }
    assert rt_t_ep("[3ffe:18:1917:f34e::1]:47728", e[0..18]);
    e[16] = 0;
    e[17] = 0;
    assert rt_cand_ok_v6(e[0..18]) == false;
    assert rt_t_ep("203.0.113.7:47728", e[0..18]) and rt_cand_ok_v6(e[0..18]) == false;
    assert rt_cand_ok_v6(e[0..17]) == false;
    // IPv4: public only, never a carrier NAT's space or 192.0.0.0/24 (464XLAT's CLAT address)
    i = 0;
    while (i < 6) {
        ln = ip6_t_field(RT_T_YES4, i, lb[0..48]);
        assert rt_t_ep(lb[0..ln], e[0..18]);
        assert rt_cand_ok_v4(e[0..18]);
        i = i + 1;
    }
    i = 0;
    while (i < 14) {
        ln = ip6_t_field(RT_T_NO4, i, lb[0..48]);
        assert rt_t_ep(lb[0..ln], e[0..18]);
        assert rt_cand_ok_v4(e[0..18]) == false;
        i = i + 1;
    }
    assert ip6_ep_v4(3405803783, 0, e[0..18]) and rt_cand_ok_v4(e[0..18]) == false;
    assert rt_t_ep("[3ffe:18:1917:f34e::1]:47728", e[0..18]) and rt_cand_ok_v4(e[0..18]) == false;
    assert ip6_ep_v4(3405803783, 47728, e[0..18]) and rt_cand_ok_v4(e[0..17]) == false;
    assert rt_v4_public(4294967296) == false and rt_v4_public(3405803783);
    // the copied key leaves a refused address out: the key alone, or the block with the other one
    var u6 : [18]u8 = undefined;
    var p4 : [18]u8 = undefined;
    var c4 : [18]u8 = undefined;
    var a6 : [18]u8 = undefined;
    assert rt_t_ep("[fd12:3456::1]:47728", u6[0..18]);
    assert rt_t_ep("100.64.0.1:47728", c4[0..18]);
    rt_t_a4(p4[0..18]);
    rt_t_a6(a6[0..18]);
    var o : [80]u8 = undefined;
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], u6[0..18], c4[0..18], 7000, o[0..80]), RT_T_NONE);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], u6[0..18], p4[0..18], 7000, o[0..80]), RT_T_V4);
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], a6[0..18], c4[0..18], 7000, o[0..80]), RT_T_V6);
    // an IPv4 given as the IPv6 one, and the IPv6 as the IPv4 one, are left out
    assert rt_t_eq(o[0..80], rt_encode(RT_T_FP1[0..10], p4[0..18], a6[0..18], 7000, o[0..80]), RT_T_NONE);
}

test rt_a_block_that_checks_but_names_a_refused_address_gives_no_address {
    var key : [80]u8 = undefined;
    assert rt_t_copy(key[0..80], RT_T_NONE) == 25;
    var a6 : [18]u8 = undefined;
    var a4 : [18]u8 = undefined;
    rt_t_a6(a6[0..18]);
    rt_t_a4(a4[0..18]);
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    // rt_pack writes any address: a crafted key
    var lb : [48]u8 = undefined;
    var ln : usize = 0;
    var n : usize = 0;
    var i : usize = 0;
    while (i < 6) {
        var b6 : [18]u8 = undefined;
        ln = ip6_t_field(RT_T_PNO6, i, lb[0..48]);
        assert rt_t_ep(lb[0..ln], b6[0..18]);
        // the good address with port 0
        if (i == 4) {
            b6[16] = 0;
            b6[17] = 0;
        }
        n = rt_pack(key[0..80], true, b6[0..18], false, a4[0..0], 7000);
        assert n == RT_LEN_V6;
        assert rt_parse(key[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
        assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and eh[0] == 0;
        // with a good IPv4 beside it the IPv4 is taken, the IPv6 is not
        n = rt_pack(key[0..80], true, b6[0..18], true, a4[0..18], 7000);
        assert n == RT_LEN_BOTH;
        assert rt_parse(key[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
        assert !ip6_is_set(e6[0..18]) and ip6_same(e4[0..18], a4[0..18]) and eh[0] == 7000;
        i = i + 1;
    }
    // the v4-mapped form of an IPv4 in the IPv6 place
    var m6 : [18]u8 = undefined;
    assert ip6_copy(m6[0..18], a4[0..18]);
    n = rt_pack(key[0..80], true, m6[0..18], false, a4[0..0], 7000);
    assert rt_parse(key[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
    i = 0;
    while (i < 7) {
        var b4 : [18]u8 = undefined;
        if (i == 6) {
            assert ip6_ep_v4(3405803783, 0, b4[0..18]);
        } else {
            ln = ip6_t_field(RT_T_PNO4, i, lb[0..48]);
            assert rt_t_ep(lb[0..ln], b4[0..18]);
        }
        n = rt_pack(key[0..80], false, a6[0..0], true, b4[0..18], 7000);
        assert n == RT_LEN_V4;
        assert rt_parse(key[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
        assert !ip6_is_set(e4[0..18]) and eh[0] == 0;
        n = rt_pack(key[0..80], true, a6[0..18], true, b4[0..18], 7000);
        assert rt_parse(key[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
        assert ip6_same(e6[0..18], a6[0..18]) and !ip6_is_set(e4[0..18]);
        i = i + 1;
    }
    // rt_pack of good addresses is rt_encode's text
    n = rt_pack(key[0..80], true, a6[0..18], true, a4[0..18], 7000);
    assert rt_t_eq(key[0..80], n, RT_T_BOTH);
}

test rt_a_block_of_another_version_is_the_key_alone {
    var a : [71]u8 = undefined;
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    // version 0, 2 and 3 in the first symbol of each kind of block; whatever follows
    var i : usize = 0;
    while (i < 3) {
        var ver : u32 = 0;
        while (ver < 4) {
            if (ver != RT_VER) {
                const n : usize = rt_t_copy(a[0..71], rt_t_tok(i + 1));
                const s0 : u32 = sym_value(a[INVITE_LEN + 1]);
                a[INVITE_LEN + 1] = sym_char((ver << 3) | (s0 & 7));
                assert rt_parse(a[0..71], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
                assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]);
                assert eh[0] == 0;
                // a shorter or longer block of that version is the key alone too
                assert rt_t_kind(a[0..71], INVITE_LEN + 2) == RT_KEY_ONLY;
            }
            ver = ver + 1;
        }
        i = i + 1;
    }
}

test rt_a_damaged_block_is_bad_and_the_key_still_counts {
    var a : [80]u8 = undefined;
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    // cut by one symbol, one symbol too many
    var n : usize = rt_t_copy(a[0..80], RT_T_BOTH);
    assert rt_parse(a[0..80], n - 1, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_BAD_BLOCK;
    assert same_bytes(fp[0..10], RT_T_FP1[0..10]) and !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]) and eh[0] == 0;
    a[n] = 48;
    assert rt_t_kind(a[0..80], n + 1) == RT_BAD_BLOCK;
    // the IPv4 block with the IPv6 flag (and the other way): the length is wrong
    n = rt_t_copy(a[0..80], RT_T_V4);
    a[INVITE_LEN + 1] = sym_char(sym_value(a[INVITE_LEN + 1]) | 4);
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    n = rt_t_copy(a[0..80], RT_T_V6);
    a[INVITE_LEN + 1] = sym_char(sym_value(a[INVITE_LEN + 1]) ^ 6);
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    // version 1 with no address is never written
    n = rt_t_copy(a[0..80], RT_T_V4);
    a[INVITE_LEN + 1] = sym_char(8);
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK and rt_t_kind(a[0..80], INVITE_LEN + 2) == RT_BAD_BLOCK;
    // a character outside the alphabet, the check made right for the rest
    n = rt_t_copy(a[0..80], RT_T_V6);
    a[40] = 79;
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    a[40] = 33;
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    n = rt_t_copy(a[0..80], RT_T_V6);
    a[INVITE_LEN + 1] = 79;
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    // the letter O where a 0 stands: the alphabet has no O, so it is no symbol at all
    n = rt_t_copy(a[0..80], RT_T_V6);
    var z : usize = INVITE_LEN + 1;
    while (z < n and a[z] != 48) { z = z + 1; }
    assert z < n;
    a[z] = 79;
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    a[z] = 111;
    assert rt_t_kind(a[0..80], n) == RT_BAD_BLOCK;
    a[z] = 48;
    assert rt_t_kind(a[0..80], n) == RT_FULL;
    // a pad bit set, with the check computed over it: still refused
    const pads : [3]u32 = [2, 1, 3];
    var i : usize = 0;
    while (i < 3) {
        n = rt_t_copy(a[0..80], rt_t_tok(i + 1));
        const last : usize = n - RT_CHECK - 1;
        var b : u32 = 0;
        while (b < pads[i]) {
            var c : [80]u8 = a;
            c[last] = sym_char(sym_value(a[last]) ^ (@as(u32, 1) << @as(u32, @intCast(b))));
            rt_t_reseal(c[0..80], n);
            assert rt_t_kind(c[0..80], n) == RT_BAD_BLOCK;
            b = b + 1;
        }
        // the bit above the pad is data: changed and resealed it reads (another address or port)
        var d : [80]u8 = a;
        d[last] = sym_char(sym_value(a[last]) ^ (@as(u32, 1) << @as(u32, @intCast(pads[i]))));
        rt_t_reseal(d[0..80], n);
        assert rt_t_kind(d[0..80], n) == RT_FULL;
        i = i + 1;
    }
    // no dash after the key, a lone dash
    n = rt_t_copy(a[0..80], RT_T_V4);
    a[INVITE_LEN] = 48;
    assert rt_parse(a[0..80], n, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_BAD_BLOCK;
    assert same_bytes(fp[0..10], RT_T_FP1[0..10]);
    n = rt_t_copy(a[0..80], RT_T_V4);
    assert rt_t_kind(a[0..80], INVITE_LEN + 1) == RT_BAD_BLOCK;
    // (whatever stands past the end)
    a[INVITE_LEN + 1] = 90;
    assert rt_t_kind(a[0..80], INVITE_LEN + 1) == RT_BAD_BLOCK;
    // the key part decides first: no key, nothing
    n = rt_t_copy(a[0..80], RT_T_BOTH);
    a[24] = sym_char((sym_value(a[24]) + 1) & 31);
    assert rt_t_kind(a[0..80], n) == RT_NONE;
    assert rt_t_kind(a[0..80], 24) == RT_NONE;
    assert rt_t_kind(a[0..80], 0) == RT_NONE;
}

test rt_short_arguments_write_nothing {
    var fp : [10]u8 = undefined;
    var e6 : [18]u8 = undefined;
    var e4 : [18]u8 = undefined;
    var eh : [2]u32 = undefined;
    e6[0] = 7;
    e4[0] = 7;
    eh[0] = 7;
    assert rt_parse(RT_T_BOTH, 71, fp[0..9], e6[0..18], e4[0..18], eh[0..2]) == RT_NONE;
    assert rt_parse(RT_T_BOTH, 71, fp[0..10], e6[0..17], e4[0..18], eh[0..2]) == RT_NONE;
    assert rt_parse(RT_T_BOTH, 71, fp[0..10], e6[0..18], e4[0..17], eh[0..2]) == RT_NONE;
    assert rt_parse(RT_T_BOTH, 71, fp[0..10], e6[0..18], e4[0..18], eh[0..0]) == RT_NONE;
    assert rt_parse(RT_T_BOTH, 72, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_NONE;
    assert e6[0] == 7 and e4[0] == 7 and eh[0] == 7;
    // a call that reads clears what an earlier one left
    assert rt_parse(RT_T_BOTH, 71, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_FULL;
    assert rt_parse(RT_T_NONE, 25, fp[0..10], e6[0..18], e4[0..18], eh[0..2]) == RT_KEY_ONLY;
    assert !ip6_is_set(e6[0..18]) and !ip6_is_set(e4[0..18]) and eh[0] == 0;
}

test rt_the_hour_counts_from_2026_and_a_key_is_old_after_48_hours {
    assert RT_EPOCH_UNIX == 1767225600;
    assert rt_epoch_hours(1767225600) == 0;
    assert rt_epoch_hours(1767225600 + 3599) == 0;
    assert rt_epoch_hours(1767225600 + 3600) == 1;
    assert rt_epoch_hours(1767225600 + 7000 * 3600) == 7000;
    // 2026-10-23T12:00:00Z
    assert rt_epoch_hours(1792756800) == 7092;
    // a clock before 2026 reads hour 0; after 65536 hours it starts again
    assert rt_epoch_hours(1767225599) == 0 and rt_epoch_hours(0) == 0;
    assert rt_epoch_hours(2003155200 - 1) == 65535;
    assert rt_epoch_hours(2003155200) == 0 and rt_epoch_hours(2003158800) == 1;
    // old after 48 hours
    assert rt_is_old(100, 100) == false;
    assert rt_is_old(100, 148) == false;
    assert rt_is_old(100, 149);
    assert rt_is_old(100, 5000);
    // across the wrap of the hour count
    assert rt_is_old(65530, 10) == false;
    assert rt_is_old(65500, 30);
    assert rt_is_old(65535, 47) == false and rt_is_old(65535, 48);
    // a key from an hour or a day ahead (the other clock is ahead) is not old
    assert rt_is_old(200, 199) == false;
    assert rt_is_old(200, 176) == false;
    // 32767 hours back is old; 32768 and more is the future half
    assert rt_is_old(32869, 100);
    assert rt_is_old(32868, 100) == false;
    // the bits above 16 are not the hour's, and no value overflows
    assert rt_is_old(65536 + 100, 149) and rt_is_old(100, 65536 + 148) == false;
    assert rt_is_old(4294967295, 47) == false and rt_is_old(4294967295, 48);
    assert rt_is_old(65485, 4294967295) and rt_is_old(4294967295, 4294967295) == false;
}
