// specs/t27os/coder_registry.t27 -- t27os: coder registry contract.
// Part of M1 (milestone #5). Closes #13078.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::coder_registry;

pub const CODER_REGISTRY_MAX : u32 = 128;

pub struct CoderEntry { id: str, registered: bool };

pub fn coder_registry_entry_registered(e: CoderEntry) -> bool {
    return e.registered;
}

test "coder registry entry registered" {
    assert(coder_registry_entry_registered(CoderEntry { id: "coder-1", registered: true }));
    assert(!coder_registry_entry_registered(CoderEntry { id: "coder-2", registered: false }));
}

invariant coder_registry_max_positive {
    assert CODER_REGISTRY_MAX > 0;
}