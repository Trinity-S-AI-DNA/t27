// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_ui.t27 -- the human tab contract of the AI-browser, layer 5.
; One browser, two pilots: the person and the agent share one window through a
; wheel state (PERSON or AGENT) and a detent sheet that hands the wheel over
; (take) and back (return). The human tab is the cockpit; the agent reaches the
; same pages through the tool layer (browser_tools.t27), never through a second
; browser.
; -
; THE EMBED RULE. The app embeds remote pages in iframes only from origins the
; site rules list. A foreign origin is refused at build time of the frame, not
; hidden by CSS. can_embed fails closed: an origin not in the table is refused.
; -
; THE CHANNEL RULE. The video channel (screenshots, the visible tab) carries
; pixels only. Keys and scrolls travel through the API door (the tool layer);
; nothing typed on the video path counts as input. A key not listed in
; BROWSER_KEYS is dropped at the door.
; -
; LIVENESS LAW. The status poll every POLL_SECS seconds keeps the dashboard
; fresh but is not life: last_seen_at moves only on a real action (page open,
; key, scroll), never on a poll-only event. A tab that only polls is stale.
; -
; Witness: the TypeScript implementation in the trios repo (human tab, detent
; sheet, iframe guard, status poll). This file is the pure contract it must
; satisfy; t27b runs the tests below.
; ASCII only (L3), English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserUi;

; --- 1. Wheel state and the detent sheet ------------------------------------------------------------

pub const WHEEL_PERSON : u8 = 0;
pub const WHEEL_AGENT : u8 = 1;

pub const DETENT_TAKE : u8 = 0;
pub const DETENT_RETURN : u8 = 1;
pub const DETENT_NONE : u8 = 2;

/// Wheel after a detent action. take hands the wheel to the agent only from
/// PERSON; return hands it back only from AGENT; every other pair is a no-op
/// that keeps the state (the sheet never flips the wheel twice in one press).
pub fn wheel_next(state : u8, action : u8) -> u8 {
    if (state == WHEEL_PERSON and action == DETENT_TAKE) { return WHEEL_AGENT; }
    if (state == WHEEL_AGENT and action == DETENT_RETURN) { return WHEEL_PERSON; }
    return state;
}

/// The detent sheet, row per legal transition: from, action, to.
pub const SHEET_FROM : [2]u8 = [WHEEL_PERSON, WHEEL_AGENT];
pub const SHEET_ACT : [2]u8 = [DETENT_TAKE, DETENT_RETURN];
pub const SHEET_TO : [2]u8 = [WHEEL_AGENT, WHEEL_PERSON];
pub const SHEET_ROWS : usize = 2;

/// True when a transition is written on the sheet exactly as wheel_next plays it.
pub fn sheet_row_holds(row : usize) -> bool {
    if (row >= SHEET_ROWS) { return false; }
    return wheel_next(SHEET_FROM[row], SHEET_ACT[row]) == SHEET_TO[row];
}

; --- 2. Cockpit desks (component inventory) ---------------------------------------------------------

/// The five desks of the human tab, in display order. The tab renders these
/// and nothing else; a component outside the inventory is out of contract.
pub const DESKS : [5]str = ["status", "tabs", "import_logins", "site_rules", "detent_sheet"];
pub const DESK_COUNT : usize = 5;

/// Login sources the import desk may read. Only these; nothing scans a
/// browser profile not listed here.
pub const IMPORT_LOGINS : [3]str = ["chrome", "firefox", "keychain"];
pub const IMPORT_COUNT : usize = 3;

/// Site rules: an origin is embeddable only when listed with rule 1.
/// Rule 0 rows are named-but-refused; rows absent from the table are refused
/// too (fail closed).
pub const SITE_RULE_ORIGIN : [3]str = ["app.t27.ai", "127.0.0.1", "github.com"];
pub const SITE_RULE_ALLOW : [3]u8 = [1, 1, 0];
pub const SITE_RULE_COUNT : usize = 3;

/// Keys the API door accepts from the cockpit keyboard. The video channel
/// carries none of them.
pub const BROWSER_KEYS : [6]str = ["Enter", "Tab", "Escape", "ArrowUp", "ArrowDown", "Backspace"];
pub const KEY_COUNT : usize = 6;

pub fn desk_ok(i : usize) -> bool { return i < DESK_COUNT; }

/// The embed rule: origin listed with allow rule 1. Foreign origins refuse.
pub fn can_embed(origin : str) -> bool {
    var i : usize = 0;
    while (i < SITE_RULE_COUNT) {
        if (origin == SITE_RULE_ORIGIN[i]) { return SITE_RULE_ALLOW[i] == 1; }
        i = i + 1;
    }
    return false;
}

; --- 3. The channel rule ----------------------------------------------------------------------------

pub const CH_VIDEO : u8 = 0;
pub const CH_API : u8 = 1;

/// Every accepted key travels through the API door; the video channel never
/// carries one. An unknown key name is dropped.
pub fn key_channel(name : str) -> u8 {
    var i : usize = 0;
    while (i < KEY_COUNT) {
        if (name == BROWSER_KEYS[i]) { return CH_API; }
        i = i + 1;
    }
    return CH_VIDEO;
}

/// Count of keys that would travel on a given channel. The video answer is 0
/// by law, whatever the table holds.
pub fn keys_on_channel(ch : u8) -> usize {
    if (ch != CH_API) { return 0; }
    return KEY_COUNT;
}

; --- 4. Liveness ------------------------------------------------------------------------------------

pub const EVT_PAGE_OPEN : u8 = 0;
pub const EVT_KEY : u8 = 1;
pub const EVT_SCROLL : u8 = 2;
pub const EVT_POLL : u8 = 3;

pub const POLL_SECS : u32 = 10;

/// A poll-only event must NOT refresh last_seen_at; every real action does.
pub fn counts_as_liveness(kind : u8) -> bool {
    return kind != EVT_POLL;
}

/// Poll interval sanity: slow enough not to hammer the daemon, fast enough
/// for a live status desk.
pub fn poll_interval_ok() -> bool {
    return POLL_SECS >= 5 and POLL_SECS <= 60;
}

invariant the_wheel_has_exactly_two_states {
    assert wheel_next(WHEEL_PERSON, DETENT_TAKE) == WHEEL_AGENT;
    assert wheel_next(WHEEL_AGENT, DETENT_RETURN) == WHEEL_PERSON;
    assert wheel_next(WHEEL_PERSON, DETENT_RETURN) == WHEEL_PERSON;
    assert wheel_next(WHEEL_AGENT, DETENT_TAKE) == WHEEL_AGENT;
    assert SHEET_ROWS == 2;
}

invariant video_carries_no_keys {
    assert keys_on_channel(CH_VIDEO) == 0;
    assert keys_on_channel(CH_API) == KEY_COUNT;
    assert key_channel("Enter") == CH_API;
    assert key_channel("F12") == CH_VIDEO;
}

test embed_rule_fails_closed {
    assert can_embed("app.t27.ai");
    assert(can_embed("127.0.0.1"));
    assert(!can_embed("github.com"));
    assert(!can_embed("evil.example"));
    assert(!can_embed(""));
    var i : usize = 0;
    while (i < SITE_RULE_COUNT) {
        if (SITE_RULE_ALLOW[i] == 0) { assert(!can_embed(SITE_RULE_ORIGIN[i])); }
        i = i + 1;
    }
}

test detent_sheet_rows_match_wheel {
    var r : usize = 0;
    while (r < SHEET_ROWS) {
        assert(sheet_row_holds(r));
        r = r + 1;
    }
    assert(!sheet_row_holds(SHEET_ROWS));
}

test component_inventory_is_complete {
    assert(DESK_COUNT == 5);
    assert(desk_ok(0) and desk_ok(4));
    assert(!desk_ok(5));
    assert(IMPORT_COUNT == 3);
    assert(IMPORT_LOGINS[0] == "chrome");
    assert(KEY_COUNT == 6);
    assert(BROWSER_KEYS[0] == "Enter");
}

test poll_only_event_is_not_liveness {
    assert(!counts_as_liveness(EVT_POLL));
    assert(counts_as_liveness(EVT_PAGE_OPEN));
    assert(counts_as_liveness(EVT_KEY));
    assert(counts_as_liveness(EVT_SCROLL));
    assert(poll_interval_ok());
    assert(POLL_SECS == 10);
}
