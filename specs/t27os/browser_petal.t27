// SPDX-License-Identifier: Apache-2.0
; The B petal keeps BENCH and offers the 999 remote browser in its run-log toolbar.
; This file owns only the route and hit test; the remote broker owns identity and CDP.
module T27osBrowserPetal;

use t27os::bench::BP_PAD;
use t27os::bench::bp_card_w;
use t27os::bench::bp_card_y;
use t27os::bench::bp_btn_y;
use t27os::bench::bp_log_y;
use t27os::homes::WIDGET_COUNT;
use t27os::agent_parts::PAGE_BENCH;
use t27os::agent_parts::page_kind;

pub const BROWSER_PETAL : u32 = 1;
pub const BROWSER_LETTER : u32 = 2;
pub const BROWSER_URL : str = "https://app.t27.ai/game/browser";
pub const LIVE_BROWSER : u64 = @as(u64, WIDGET_COUNT) + 1;
pub const BROWSER_BUTTON_W : f64 = 86.0;
pub const BROWSER_BUTTON_H : f64 = 24.0;

/// BENCH holds two views: HARDWARE (default) and BROWSER (secondary, same petal).
pub const BENCH_MODE_HARDWARE : u8 = 0;
pub const BENCH_MODE_BROWSER : u8 = 1;

pub fn bench_mode(browser_live : bool) -> u8 {
    if (browser_live) { return BENCH_MODE_BROWSER; }
    return BENCH_MODE_HARDWARE;
}

pub fn browser_button_left(pw: f64) -> f64 {
    return BP_PAD + bp_card_w(pw) - BROWSER_BUTTON_W - 12.0;
}

pub fn browser_button_top() -> f64 { return bp_log_y() + 4.0; }

pub fn browser_button_hit(x: f64, y: f64, pw: f64) -> bool {
    const left : f64 = browser_button_left(pw);
    const top : f64 = browser_button_top();
    return x >= left and x < left + BROWSER_BUTTON_W and y >= top and y < top + BROWSER_BUTTON_H;
}

test second_petal_keeps_bench_and_owns_the_browser {
    assert BROWSER_PETAL == 1;
    assert BROWSER_LETTER == 2;
    assert page_kind(BROWSER_LETTER) == PAGE_BENCH;
    assert LIVE_BROWSER > @as(u64, WIDGET_COUNT);
    assert BROWSER_URL == "https://app.t27.ai/game/browser";
}

test browser_button_is_bounded_and_cannot_steal_hardware_controls {
    var pw : f64 = 300.0;
    while (pw <= 960.0) {
        const left : f64 = browser_button_left(pw);
        const top : f64 = browser_button_top();
        assert(browser_button_hit(left + 1.0, top + 1.0, pw));
        assert(browser_button_hit(left + BROWSER_BUTTON_W, top + 1.0, pw) == false);
        assert(browser_button_hit(left + 1.0, bp_card_y(0) + bp_btn_y(), pw) == false);
        assert(browser_button_hit(left + 1.0, bp_card_y(1) + bp_btn_y(), pw) == false);
        assert(left >= BP_PAD and left + BROWSER_BUTTON_W <= BP_PAD + bp_card_w(pw));
        pw = pw + 220.0;
    }
}

test bench_has_two_views_and_hardware_is_the_default {
    assert bench_mode(false) == BENCH_MODE_HARDWARE;
    assert bench_mode(true) == BENCH_MODE_BROWSER;
    // B is the second petal; the browser is a view inside it, never a 28th petal.
    assert BROWSER_PETAL == 1;
    assert LIVE_BROWSER > @as(u64, WIDGET_COUNT);
    assert BROWSER_URL == "https://app.t27.ai/game/browser";
}
