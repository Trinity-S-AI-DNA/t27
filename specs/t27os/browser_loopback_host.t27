// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_loopback_host.t27 -- one-connection HTTP view/input decisions for the
; 0.3.2 loopback listener on 127.0.0.1:47131. No @extern (pty_logic trap). Imports policy from
; browser_native_bridge.t27; bind bytes from browser_loopback_sock.t27; native file readiness from
; browser_native_framebuffer.t27. The host process accepts, reads one request, writes head + body,
; closes. Input POST appends one inbox line to in.txt when the pump is alive (embedded path until
; native input is wired).
; -
; HOST plumbing spec: specs/t27os/browser_loopback_runner.t27 (bridge_listen, one accept, I/O loop).
; This file is policy only: route_of, paths, statuses, put_head. Wire entry: glass_window CALL_SITE.
; Accept pattern: pty_server router_accept; POST input appends via br_inbox path (no O_CREAT).
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserLoopbackHost;

use t27os::browser_native_bridge::ROUTE_VIEW;
use t27os::browser_native_bridge::ROUTE_INPUT;
use t27os::browser_native_bridge::ROUTE_NONE;
use t27os::browser_native_bridge::route_of;
use t27os::browser_native_bridge::put_head;
use t27os::browser_native_bridge::inbox_refusal;
use t27os::browser_native_bridge::view_status;
use t27os::browser_native_bridge::R_OK;
use t27os::browser_native_bridge::R_BAD;
use t27os::browser_native_bridge::R_SECRET;
use t27os::browser_native_bridge::R_NOT_WIRED;
use t27os::browser_native_bridge::PIXEL_NONE;
use t27os::browser_native_bridge::PIXEL_JPEG;
use t27os::browser_native_bridge::PIXEL_PNG;
use t27os::browser_native_bridge::PIXEL_NATIVE;
use t27os::browser_native_bridge::EMBEDDED_FRAME;
use t27os::browser_native_bridge::source_name_of;
use t27os::browser_native_bridge::text_body;
use t27os::browser_native_bridge::span_eq;
use t27os::browser_native_bridge::has_bytes;
use t27os::browser_native_framebuffer::bridge_pixel_kind;
use t27os::browser_native_framebuffer::export_enabled;
use t27os::browser_native_framebuffer::EXPORT_BASENAME;
use t27os::browser_native_framebuffer::EXPORT_DIR_SUFFIX;
use t27os::browser_native_framebuffer::export_path;
use t27os::browser_native_framebuffer::PNG_B0;
use t27os::browser_native_framebuffer::PNG_B1;
use t27os::browser_native_framebuffer::PNG_B2;
use t27os::browser_native_framebuffer::PNG_B3;
use t27os::browser_loopback_sock::bridge_bind_bytes;
use t27os::browser_loopback_sock::bridge_bind_refusal;
use t27os::router_sock::SOCKADDR_IN_LEN;
use t27os::session_store::put_bytes;

pub const R_NOT_FOUND : u32 = 404;

pub const INBOX_BASENAME : string = "in.txt";
pub const FRAME_PNG : string = "frame.png";
pub const PART_SUFFIX : []const u8 = ".part";

/// Read-only structured state the window writes once per visible frame (state-only surface).
pub const STATE_BASENAME : string = "state.json";

/// View response: HTTP status and pixel kind for one GET /live/native.
pub fn view_response(pump_alive : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    const kind : u32 = bridge_pixel_kind(export_enabled(), pump_alive, b0, b1, b2, b3);
    return view_status(kind);
}

pub fn view_kind(pump_alive : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    return bridge_pixel_kind(export_enabled(), pump_alive, b0, b1, b2, b3);
}

/// Input POST: refusal code for one inbox line (embedded pump until E2E_PASSED).
pub fn input_response(line : []const u8, pump_alive : bool) -> u32 {
    return inbox_refusal(line, pump_alive);
}

/// Bind sockaddr length for the listener, or zero when refused.
pub fn listener_bind_len(out : []u8) -> usize {
    if (bridge_bind_refusal(false) != R_OK) { return 0; }
    return bridge_bind_bytes(out);
}

/// Build "<home>/.t27os/browser/<name>" into pb (glass_window br_path law).
pub fn data_path(hb : []const u8, name : []const u8, pb : []u8) -> usize {
    var n : usize = put_bytes(pb, 0, hb);
    n = put_bytes(pb, n, EXPORT_DIR_SUFFIX);
    n = put_bytes(pb, n, name);
    return n;
}

/// Basename the host may open for a picture kind. Empty when there is no disk file.
pub fn view_disk_name(kind : u32) -> string {
    if (kind == PIXEL_JPEG) { return EMBEDDED_FRAME; }
    if (kind == PIXEL_PNG) { return FRAME_PNG; }
    if (kind == PIXEL_NATIVE) { return EXPORT_BASENAME; }
    return "";
}

/// True only for the three picture files and the inbox. Rejects partial writes and unknown names.
pub fn disk_name_allowed(name : []const u8) -> bool {
    if (name.len == 0) { return false; }
    if (name.len >= PART_SUFFIX.len + 1) {
        const tail : usize = name.len - PART_SUFFIX.len;
        if (span_eq(name, tail, PART_SUFFIX.len, PART_SUFFIX)) { return false; }
    }
    if (span_eq(name, 0, name.len, EMBEDDED_FRAME)) { return true; }
    if (span_eq(name, 0, name.len, FRAME_PNG)) { return true; }
    if (span_eq(name, 0, name.len, EXPORT_BASENAME)) { return true; }
    if (span_eq(name, 0, name.len, INBOX_BASENAME)) { return true; }
    if (span_eq(name, 0, name.len, STATE_BASENAME)) { return true; }
    return false;
}

/// Path length for the GET body file, or zero when the kind has no lawful file.
pub fn view_disk_path(hb : []const u8, kind : u32, pb : []u8) -> usize {
    if (kind == PIXEL_JPEG) {
        if (!disk_name_allowed("frame.jpg")) { return 0; }
        return data_path(hb, EMBEDDED_FRAME, pb);
    }
    if (kind == PIXEL_PNG) {
        if (!disk_name_allowed("frame.png")) { return 0; }
        return data_path(hb, FRAME_PNG, pb);
    }
    if (kind == PIXEL_NATIVE) {
        if (!disk_name_allowed("native.png")) { return 0; }
        return data_path(hb, EXPORT_BASENAME, pb);
    }
    return 0;
}

/// HTTP status for GET view: 503 when magic says a frame exists but size is zero (stale path).
pub fn view_serve_code(pump_alive : bool, size : usize, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    const kind : u32 = view_kind(pump_alive, b0, b1, b2, b3);
    const st : u32 = view_status(kind);
    if (st == 200 and size == 0) { return 503; }
    return st;
}

/// True when the host streams a picture after the head (not a text_body fallback).
pub fn view_streams_file(code : u32, kind : u32) -> bool {
    if (code != 200) { return false; }
    if (kind == PIXEL_NONE) { return false; }
    return view_disk_name(kind) != "";
}

/// X-T27-Source tag on the wire (may differ from the disk basename for native).
pub fn view_wire_source(kind : u32) -> string {
    return source_name_of(kind);
}

/// Inbox path for one POST append.
pub fn inbox_path(hb : []const u8, pb : []u8) -> usize {
    return data_path(hb, INBOX_BASENAME, pb);
}

/// State path for the /live/state GET (streamed like the picture, never written by the host).
pub fn state_path(hb : []const u8, pb : []u8) -> usize {
    if (!disk_name_allowed(STATE_BASENAME)) { return 0; }
    return data_path(hb, STATE_BASENAME, pb);
}

/// HTTP status for POST /live/native/input from inbox_refusal.
pub fn input_http_code(line : []const u8, pump_alive : bool) -> u32 {
    const r : u32 = input_response(line, pump_alive);
    if (r == R_OK) { return 200; }
    if (r == R_SECRET or r == R_BAD) { return 400; }
    if (r == R_NOT_WIRED) { return 501; }
    return 400;
}

pub fn route_http_code(route : u32) -> u32 {
    if (route == ROUTE_NONE) { return R_NOT_FOUND; }
    return 0;
}

test bind_bytes_ready_when_law_passes {
    var sa : [16]u8 = undefined;
    assert listener_bind_len(sa[0..16]) == SOCKADDR_IN_LEN;
}

test view_serves_jpeg_while_native_export_is_off {
    assert !export_enabled();
    assert view_kind(true, 255, 216, 0, 0) != PIXEL_NONE;
    assert view_response(true, 255, 216, 0, 0) == 200;
    assert view_response(false, 0, 0, 0, 0) == 503;
}

test view_would_serve_native_png_when_export_is_on {
    assert EXPORT_BASENAME == "native.png";
    assert bridge_pixel_kind(true, false, PNG_B0, PNG_B1, PNG_B2, PNG_B3) == PIXEL_NATIVE;
    assert view_status(PIXEL_NATIVE) == 200;
}

test routes_match_bridge_paths {
    assert route_of("GET", "/live/native") == ROUTE_VIEW;
    assert route_of("POST", "/live/native/input") == ROUTE_INPUT;
    assert route_of("GET", "/live/s1") == ROUTE_NONE;
}

test input_uses_inbox_refusal {
    assert input_response("click 1 2 1", true) == R_OK;
    assert input_response("click 1 2 1", false) != R_OK;
    assert input_response("token", true) == R_BAD;
}

test put_head_still_view_only {
    var h : [512]u8 = undefined;
    const n : usize = put_head(h[0..512], 200, view_kind(true, 255, 216, 0, 0));
    assert n > 0;
    var i : usize = 0;
    while (i + 14 <= n) {
        if (h[i] == 88 and h[i + 1] == 45 and h[i + 2] == 84 and h[i + 3] == 45 and h[i + 4] == 84 and h[i + 5] == 50 and h[i + 6] == 55 and h[i + 7] == 45 and h[i + 8] == 86 and h[i + 9] == 105 and h[i + 10] == 101 and h[i + 11] == 119) {
            assert h[i + 12] == 58 and h[i + 13] == 32;
            break;
        }
        i = i + 1;
    }
}

test disk_names_whitelist_and_reject_partials {
    assert disk_name_allowed("frame.jpg");
    assert disk_name_allowed("frame.png");
    assert disk_name_allowed("native.png");
    assert disk_name_allowed("in.txt");
    assert disk_name_allowed("state.json");
    assert !disk_name_allowed("frame.jpg.part");
    assert !disk_name_allowed("native.png.part");
    assert !disk_name_allowed("pump.mjs");
    assert !disk_name_allowed("");
}

test view_disk_path_matches_home_browser_tree {
    var a : [48]u8 = undefined;
    var b : [48]u8 = undefined;
    const j : usize = view_disk_path("/Users/me", PIXEL_JPEG, a[0..48]);
    const n : usize = view_disk_path("/Users/me", PIXEL_NATIVE, b[0..48]);
    const e : usize = export_path("/Users/me", b[0..48]);
    assert j > 0 and n == e and n > 0;
    assert has_bytes(a[0..j], "frame.jpg");
    assert has_bytes(b[0..n], "native.png");
    assert view_wire_source(PIXEL_JPEG) == "frame.jpg";
    assert view_wire_source(PIXEL_NATIVE) == "glass_window";
    assert view_disk_name(PIXEL_NONE) == "";
}

test view_serve_code_needs_nonempty_file_for_200 {
    assert view_serve_code(true, 100, 255, 216, 0, 0) == 200;
    assert view_serve_code(true, 0, 255, 216, 0, 0) == 503;
    assert view_serve_code(false, 100, 255, 216, 0, 0) == 503;
    assert view_streams_file(200, PIXEL_JPEG);
    assert !view_streams_file(503, PIXEL_NONE);
    assert !view_streams_file(200, PIXEL_NONE);
}

test input_http_maps_refusal_to_status {
    assert input_http_code("click 1 2 1", true) == 200;
    assert input_http_code("click 1 2 1", false) == 501;
    assert input_http_code("token", true) == 400;
    var h : [256]u8 = undefined;
    const n : usize = put_head(h[0..256], input_http_code("click 1 2 1", true), PIXEL_NONE);
    assert has_bytes(h[0..n], "HTTP/1.1 200 OK");
    assert has_bytes(h[0..n], "Content-Type: text/plain");
    assert text_body(200) == "inbox\n";
}

test inbox_path_under_browser_dir {
    var p : [40]u8 = undefined;
    const n : usize = inbox_path("/home", p[0..40]);
    const d : usize = data_path("/home", INBOX_BASENAME, p[0..40]);
    assert n == d and n > 16;
    assert has_bytes(p[0..n], "/.t27os/browser/");
    assert has_bytes(p[0..n], "in.txt");
}

test unknown_route_is_404 {
    assert route_http_code(ROUTE_NONE) == R_NOT_FOUND;
    assert route_http_code(ROUTE_VIEW) == 0;
}

invariant host_never_binds_published {
    assert bridge_bind_refusal(true) != R_OK;
}