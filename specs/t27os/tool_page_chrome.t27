// SPDX-License-Identifier: Apache-2.0
; specs/t27os/tool_page_chrome.t27 -- the reusable letter-page chrome shared by every T27OS tool tab.
; Canonical layout (hero gauges, segment bar, INSTRUMENTS console, then SPECS / COMMANDS / SKILLS / PULSE /
; HOME) lives in specs/t27os/dash.t27 (N3 hero, N4 consoles, N5a sidebar targets, N5b areas). glass_window
; paints from dash.t27; this spec names which built tool pages embed in that chrome instead of replacing it,
; and the INSTRUMENTS slot geometry for the host draw and hit tests. Refs #13426, epic #11275.
; Restored 2026-11-27 (see 9b9c7d199, the lost-sweep park of dsh-48991503-41d0): master's glass_window.t27
; imports page_kind_uses_chrome / chrome_tool_open / chrome_tool_rect from this module, but the parked
; merge never carried the file, so `make t27os` was red for every branch (undeclared fn `chrome_tool_open`).
; The two UI Kit control-center fns (chrome_uikit_letter, chrome_uikit_page_kind) stay parked with their
; home specs/uikit/kit_iface.t27 in the same rescue ref; they return here when that module lands.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3), English only (LANG-EN).

module T27osToolPageChrome;

use t27os::agent_parts::PAGE_NONE;
use t27os::agent_parts::PAGE_BROWSER;
use t27os::agent_parts::PAGE_BENCH;
use t27os::agent_parts::PAGE_KANBAN;
use t27os::agent_parts::PAGE_QUEEN;
use t27os::agent_parts::PAGE_HIVE;
use t27os::agent_parts::PAGE_LOGS;
use t27os::agent_parts::PAGE_AGENTS;
use t27os::agent_parts::PAGE_VIZ_SPECS;
use t27os::agent_parts::PAGE_VIZ_GNN;
use t27os::agent_parts::PAGE_FRONTEND;
use t27os::dash::SEC_COUNT;
use t27os::dash::SEC_NAMES;
use t27os::dash::CPAD;
use t27os::dash::con_top;
use t27os::agent_parts::PAGE_KINDS;
use t27os::dash::con_cells;
use t27os::dash::con_h;
use t27os::dash::con_n;
use t27os::dash::plan;

/// Section order on every letter dashboard (sidebar scroll targets and page blocks); dash.t27 is SSOT.
pub const CHROME_SECTIONS : u32 = SEC_COUNT;

/// The name of chrome section k; SEC_NAMES[k].
pub fn chrome_section_name(k: u32) -> []const u8 {
    if (k >= SEC_COUNT) { return ""; }
    return SEC_NAMES[k];
}

/// The browser page owns its own tab strip and dashboard-in-tab; every other built page embeds in letter chrome.
pub fn page_kind_uses_chrome(kind: u32) -> bool {
    if (kind == PAGE_NONE or kind == PAGE_BROWSER) { return false; }
    if (kind >= PAGE_KINDS) { return false; }
    return kind >= PAGE_BENCH;
}

/// True while the tool body is shown inside INSTRUMENTS (TPG_DASH == 0 on a chrome letter).
pub fn chrome_tool_open(kind: u32, dash_on: u64) -> bool {
    if (page_kind_uses_chrome(kind) == false) { return false; }
    return dash_on == 0;
}

/// Minimum height of the INSTRUMENTS slot for kind (the full-page tools need the most room).
pub fn chrome_tool_min_h(kind: u32) -> f64 {
    if (kind == PAGE_FRONTEND) { return 480.0; }
    if (kind == PAGE_VIZ_SPECS or kind == PAGE_VIZ_GNN) { return 400.0; }
    return 320.0;
}

/// The INSTRUMENTS console frame as (x, y, w, h) in page points; y0 and lx come from the scrolling dashboard.
pub fn chrome_tool_rect(o: u32, ncon: []const u32, na: u32, pw: f64, y0: f64, lx: f64, kind: u32) -> [4]f64 {
    const top : f64 = y0 + con_top(o, ncon, na, pw, 0);
    const cells : u32 = con_cells(o, con_n(ncon, 0), pw);
    var h : f64 = con_h(cells, pw);
    const minh : f64 = chrome_tool_min_h(kind);
    if (h < minh) { h = minh; }
    return [4]f64 { lx, top, pw, h };
}

test chrome_section_order_matches_dash_sidebar {
    assert CHROME_SECTIONS == 8;
    assert chrome_section_name(1) == "INSTRUMENTS";
    assert chrome_section_name(3) == "SPECS";
    assert chrome_section_name(7) == "HOME";
}

test every_built_tool_page_but_browser_uses_letter_chrome {
    assert page_kind_uses_chrome(PAGE_NONE) == false;
    assert page_kind_uses_chrome(PAGE_BROWSER) == false;
    assert page_kind_uses_chrome(PAGE_BENCH);
    assert page_kind_uses_chrome(PAGE_KANBAN);
    assert page_kind_uses_chrome(PAGE_QUEEN);
    assert page_kind_uses_chrome(PAGE_HIVE);
    assert page_kind_uses_chrome(PAGE_LOGS);
    assert page_kind_uses_chrome(PAGE_AGENTS);
    assert page_kind_uses_chrome(PAGE_VIZ_SPECS);
    assert page_kind_uses_chrome(PAGE_VIZ_GNN);
    assert page_kind_uses_chrome(PAGE_FRONTEND);
    assert page_kind_uses_chrome(PAGE_KINDS) == false;
}

test chrome_tool_open_follows_the_dashboard_switch {
    assert chrome_tool_open(PAGE_FRONTEND, 0) == true;
    assert chrome_tool_open(PAGE_FRONTEND, 1) == false;
    assert chrome_tool_open(PAGE_BROWSER, 0) == false;
    assert chrome_tool_open(PAGE_KANBAN, 0) == true;
}

test chrome_tool_rect_grows_to_the_minimum_height {
    var nc : [32]u32 = undefined;
    const na : u32 = plan(4, nc[0..32]);
    const r = chrome_tool_rect(4, nc[0..32], na, 900.0, 0.0, 24.0, PAGE_FRONTEND);
    assert r[2] == 900.0;
    assert r[3] >= 480.0;
    assert r[1] >= CPAD;
}
