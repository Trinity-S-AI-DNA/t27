// SPDX-License-Identifier: Apache-2.0
; specs/t27os/promotion.t27 -- what a valid t27os build promotion carries.
; Issue #14218, milestone M0_PROMOTION_KERNEL_SPRINT (epic #13473). This spec
; owns the promotion of an OS build (a ladder binary and its release) from
; "built" to "released". It does NOT own the marketing promotion gate, which
; is specs/automation/promotion_kernel.t27, nor that gate's T27L audit
; schema, which is specs/promotion/t27l_promotion.t27 (#13483): one owner
; per claim, no second spec where one exists.
; Nothing here posts, sends mail, or starts a cron.
; Worked example, verified 2026-11-22: release t27os-ladder-512k-caps of the
; ladder serve binary, tagged and released with SHA256SUMS, a sigstore
; attestation and trinity-sbom.json, with the previous binary kept under
; ~/.t27os/bin and its restore command recorded in the release body.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osPromotion;

pub const MILESTONE : str = "M0_PROMOTION_KERNEL_SPRINT";
pub const ISSUE : str = "14218";
pub const WORKED_EXAMPLE_RELEASE : str = "t27os-ladder-512k-caps";

; FR-001. Inputs pin what was built: the commit, the caps configuration the
; binary was built with, and the build environment. A promotion whose inputs
; are not recorded cannot be reproduced and cannot be audited.
pub fn inputs_complete(has_commit: bool, has_caps_config: bool, has_environment: bool) -> bool {
    return has_commit and has_caps_config and has_environment;
}

; FR-002. Artifacts are what a consumer can check without the author: the
; binary digest, the SHA256SUMS manifest, the SBOM and the evidence log.
pub fn artifacts_complete(binary_sha256: bool, sha256sums: bool, sbom: bool, evidence_log: bool) -> bool {
    return binary_sha256 and sha256sums and sbom and evidence_log;
}

; FR-003. Gates decide before anything ships: the build, the health check,
; the smoke run, the regression tests and the written evidence. A failed or
; skipped gate is not a smaller promotion; it is no promotion.
pub fn gates_passed(build: bool, health: bool, smoke: bool, regression: bool, evidence_written: bool) -> bool {
    return build and health and smoke and regression and evidence_written;
}

; Rollback is part of the record, not a promise after the fact: the previous
; artifact by name, its sha256 and the restore command.
pub fn rollback_entry_ready(previous_name: bool, previous_sha256: bool, restore_command: bool) -> bool {
    return previous_name and previous_sha256 and restore_command;
}

; A promotion record is valid only when all four sections are complete.
; There is no default yes.
pub fn promotion_valid(inputs: bool, artifacts: bool, gates: bool, rollback: bool) -> bool {
    return inputs and artifacts and gates and rollback;
}

; A sha256 digest is 64 hex characters; a recorded digest of any other
; length is a typo, not evidence.
pub fn digest_is_sha256(digest_chars: u64) -> bool {
    return digest_chars == 64;
}

test inputs_complete_needs_commit_caps_and_environment {
    assert inputs_complete(true, true, true);
    assert inputs_complete(false, true, true) == false;
    assert inputs_complete(true, false, true) == false;
    assert inputs_complete(true, true, false) == false;
}

test artifacts_complete_needs_all_four_records {
    assert artifacts_complete(true, true, true, true);
    assert artifacts_complete(false, true, true, true) == false;
    assert artifacts_complete(true, false, true, true) == false;
    assert artifacts_complete(true, true, false, true) == false;
    assert artifacts_complete(true, true, true, false) == false;
}

test gates_passed_needs_all_five_checks {
    assert gates_passed(true, true, true, true, true);
    assert gates_passed(false, true, true, true, true) == false;
    assert gates_passed(true, false, true, true, true) == false;
    assert gates_passed(true, true, false, true, true) == false;
    assert gates_passed(true, true, true, false, true) == false;
    assert gates_passed(true, true, true, true, false) == false;
}

test rollback_entry_needs_name_digest_and_restore_command {
    assert rollback_entry_ready(true, true, true);
    assert rollback_entry_ready(false, true, true) == false;
    assert rollback_entry_ready(true, false, true) == false;
    assert rollback_entry_ready(true, true, false) == false;
}

test promotion_valid_refuses_any_incomplete_section {
    assert promotion_valid(true, true, true, true);
    assert promotion_valid(false, true, true, true) == false;
    assert promotion_valid(true, false, true, true) == false;
    assert promotion_valid(true, true, false, true) == false;
    assert promotion_valid(true, true, true, false) == false;
}

test a_digest_is_sha256_only_at_64_characters {
    assert digest_is_sha256(64);
    assert digest_is_sha256(63) == false;
    assert digest_is_sha256(65) == false;
    assert digest_is_sha256(0) == false;
}

test negative_control_identity_and_worked_example {
    assert MILESTONE == "M0_PROMOTION_KERNEL_SPRINT";
    assert ISSUE == "14218";
    assert WORKED_EXAMPLE_RELEASE == "t27os-ladder-512k-caps";
    assert WORKED_EXAMPLE_RELEASE != "this-release-is-wrong";
}
