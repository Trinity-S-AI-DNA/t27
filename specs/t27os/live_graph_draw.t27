// SPDX-License-Identifier: Apache-2.0
; specs/t27os/live_graph_draw.t27 -- draw the live mycelium graph: PTY pane events
; folded into work_graph, rendered as nodes + edges on black.
; Reads ~/.t27os/queen/live_events.txt (tap ring written by the live tap,
; specs/t27os/live_tap.t27) and folds into work_graph via apply_event. Outputs
; node positions (circle layout), colours (queen_live_graph palette) and edge
; endpoints for the window to draw. No fixture data: the data source is named
; on the surface.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osLiveGraphDraw;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::Event;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::node_kind_at_pub;
use t27f::work_graph::edges;
use t27f::work_graph::edge_from_at;
use t27f::work_graph::edge_to_at;
use t27f::work_graph::NK_SPEC;
use t27f::work_graph::NK_AGENT;
use t27f::work_graph::NK_TASK;
use t27f::work_graph::NK_ACTION;
use t27f::work_graph::NK_ARTIFACT;
use t27f::work_graph::NK_COUNT;
use t27f::work_graph::WG_OK;
use t27os::queen_live_graph::QLG_C_NEW;
use t27os::queen_live_graph::QLG_C_ACTIVE;
use t27os::queen_live_graph::QLG_C_DOWN;
use t27os::queen_live_graph::QLG_C_RESTART;
use t27os::queen_live_graph::QLG_C_EXIT;
use t27os::queen_live_graph::QLG_C_COUNT;
use t27os::queen_live_graph::qlg_colour_lvs;
use t27os::queen_graph_plane::qgp_parse_ring;
use t27os::queen_graph_plane::QGP_PARSE_CAP;
use t27os::session_store::put_dec;
use t27os::session_store::put_bytes;

// ---- the live surfaces -----------------------------------------------------------

/// Which live surface to draw: 0 none, 1 lanes band, 2 pty panes, 3 work graph.
pub const LGF_NONE : u8 = 0;
pub const LGF_LANES_BAND : u8 = 1;
pub const LGF_PTY_PANES : u8 = 2;
pub const LGF_WORK_GRAPH : u8 = 3;

/// The tap-ring file under the home.
pub const LGF_TAP_DIR : []const u8 = "/.t27os/queen/";
pub const LGF_TAP_FILE : []const u8 = "live_events.txt";
/// The PTY pane directory under the home.
pub const LGF_PTY_DIR : []const u8 = "/.t27os/pty/";

// ---- graph reading ----------------------------------------------------------------

/// Fold the tap ring text into the graph: every line is "kind pid".
pub fn lg_fold_ring(text : []const u8, g : *WorkGraph) -> u32 {
    var kinds : [QGP_PARSE_CAP]u8 = undefined;
    var pids : [QGP_PARSE_CAP]u64 = undefined;
    var n : u32 = qgp_parse_ring(text, kinds[0..QGP_PARSE_CAP], pids[0..QGP_PARSE_CAP]);
    var e : u32 = 0;
    while (e < n) {
        const r : u8 = apply_event(g, Event { kind: kinds[e], from_pid: pids[e], to_pid: 1000, task_no: 0, deliver: 0, reason: 99, seq: e, spec_id: 0 });
        if (r != WG_OK) { return e; }
        e = e + 1;
    }
    return n;
}

/// The palette colour of a node kind: five distinct colours, one law.
pub fn lg_colour(nk : u8) -> u32 {
    if (nk == NK_SPEC) { return QLG_C_NEW; }
    if (nk == NK_AGENT) { return QLG_C_ACTIVE; }
    if (nk == NK_TASK) { return QLG_C_RESTART; }
    if (nk == NK_ACTION) { return QLG_C_DOWN; }
    return QLG_C_EXIT;
}

/// Node position on the circle: index i of n, centred at (cx, cy) with radius r.
; Writes [x, y] into out[0..2]. Evenly spaced around the circle using the golden
; angle step (no transcendental functions needed).
pub fn lg_node_pos(i : u32, n : u32, cx : f64, cy : f64, r : f64, out : []f64) -> void {
    if (n == 0) { out[0] = cx; out[1] = cy; return; }
    const step : f64 = 2.39996322973; // 2*pi/phi^2 radians
    const a : f64 = (step * (i as f64)) - 1.57079632679; // start at top
    var c : f64 = 1.0 - (a * a) / 2.0 + (a * a * a * a) / 24.0;
    var s : f64 = a - (a * a * a) / 6.0 + (a * a * a * a * a) / 120.0;
    out[0] = cx + r * c;
    out[1] = cy + r * s;
}

/// Number of nodes in the graph.
pub fn lg_node_count(g : *WorkGraph) -> u32 {
    return nodes(g);
}

/// The kind of node n.
pub fn lg_node_kind(g : *WorkGraph, n : u32) -> u8 {
    return node_kind_at_pub(g, n);
}

/// The number of edges in the graph.
pub fn lg_edge_count(g : *WorkGraph) -> u32 {
    return edges(g);
}

/// The source node index of edge e.
pub fn lg_edge_from(g : *WorkGraph, e : u32) -> u32 {
    return edge_from_at(g, e);
}

/// The target node index of edge e.
pub fn lg_edge_to(g : *WorkGraph, e : u32) -> u32 {
    return edge_to_at(g, e);
}

// ---- trace dump -----------------------------------------------------------------

/// Kind name text for debug output.
pub fn lg_kind_name(nk : u8) -> []const u8 {
    if (nk == NK_SPEC) { return "SPEC"; }
    if (nk == NK_AGENT) { return "AGENT"; }
    if (nk == NK_TASK) { return "TASK"; }
    if (nk == NK_ACTION) { return "ACTION"; }
    return "ARTIFACT";
}

/// k-hop trace dump header: "k-hop from seed_pid\n".
pub fn lg_trace_header(out : []u8, seed_pid : u64) -> usize {
    var n : usize = 0;
    n = put_bytes(out[0..64], 0, "k-hop from ");
    n = put_dec(out[0..64], n, seed_pid);
    n = put_bytes(out[0..64], n, "\n");
    return n;
}

/// One trace line: "pid kind depth\n".
pub fn lg_trace_line(out : []u8, npid : u64, nkind : u8, depth : u32) -> usize {
    var n : usize = 0;
    n = put_dec(out[0..64], n, npid);
    n = put_bytes(out[0..64], n, " ");
    const kname : []const u8 = lg_kind_name(nkind);
    var ki : usize = 0;
    while (ki < kname.len) { n = put_bytes(out[0..64], n, kname[ki..ki+1]); ki = ki + 1; }
    n = put_bytes(out[0..64], n, " ");
    n = put_dec(out[0..64], n, depth);
    n = put_bytes(out[0..64], n, "\n");
    return n;
}

test lg_node_pos_returns_centre_when_empty {
    var pos : [2]f64 = undefined;
    lg_node_pos(0, 0, 100.0, 200.0, 50.0, pos[0..2]);
    assert(pos[0] == 100.0 and pos[1] == 200.0);
}

test lg_colour_returns_five_distinct_colours {
    assert(lg_colour(NK_SPEC) == QLG_C_NEW);
    assert(lg_colour(NK_AGENT) == QLG_C_ACTIVE);
    assert(lg_colour(NK_TASK) == QLG_C_RESTART);
    assert(lg_colour(NK_ACTION) == QLG_C_DOWN);
    assert(lg_colour(NK_ARTIFACT) == QLG_C_EXIT);
    var a : u8 = 0;
    while (a < NK_COUNT) {
        var b : u8 = a + 1;
        while (b < NK_COUNT) {
            assert(lg_colour(a) != lg_colour(b));
            b = b + 1;
        }
        a = a + 1;
    }
}

test lg_kind_name_returns_names {
    var k : []const u8 = lg_kind_name(NK_AGENT);
    assert(k.len > 0);
    assert(k[0] == 65); // 'A'
    k = lg_kind_name(NK_ACTION);
    assert(k[0] == 65); // 'A'
    k = lg_kind_name(NK_SPEC);
    assert(k[0] == 83); // 'S'
}

test lg_fold_ring_folds_events {
    var g : WorkGraph = new_graph();
    const text : []const u8 = "0 1001\n0 1002\n4 1001\n4 1002\n";
    var n : u32 = lg_fold_ring(text, &g);
    assert(n == 4);
    assert(nodes(&g) > 0);
    assert(edges(&g) > 0);
}

// ---- helpers --------------------------------------------------------------------
