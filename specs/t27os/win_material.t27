// SPDX-License-Identifier: Apache-2.0
; Refs #13251
; specs/t27os/win_material.t27 -- the window's two glass themes and its opaque fallback, with one
; shared rule that keeps white primary text readable on all three.
; Owner order START_T27OS_UI_KIT_NOW, 2026-11-08 (LAYOUT_AND_DUAL_GLASS_V2, ring 1): a light
; frosted-glass theme and a dark matte-black-glass theme, both with white primary text, a readable
; opaque fallback, and contrast protection from shared tint and scrim rules, not per-label patches.
; A theme is a row of the live theme levels of hot_reload.t27 (THV_*, permille). glass_window.t27
; already draws every surface, line and text run through lv(kit, THV_*), so switching a theme writes
; one row into the kit and changes nothing else: no second token path, no per-label colour.
; Dark is today's built-in row (glass_window.t27 thv_defaults), value for value.
; Material honesty: the blur is the native NSVisualEffectView behind-window blur that glass_window.t27
; sets through objc_msgSend. This module names the material and appearance each theme asks for. It is
; vibrancy blur, not Liquid Glass: no refraction, no lensing, no specular edge. Where the glass shows
; The glass rule is glass_window.t27 on_glass_th: Light is glass at every width; Dark is glass only
; at the docked panel width; Opaque is never glass (owner 2026-10-23, updated t27#13402).
; The rule. The backdrop behind the glass is any desktop, so the worst case is white. CoreGraphics
; and the compositor blend in encoded sRGB: black at alpha g over white leaves 1 - g. Under a
; surface of black alpha s with the white frost f on top (draw_ground) the backing is
; f + (1 - f) (1 - g) (1 - s). White text drawn at alpha a over a backing e is a + (1 - a) e.
; white_text_ok checks every text-bearing backing of a theme with the real sRGB transfer (Newton's
; method for the 2.4 power) against WCAG 4.5:1 for primary text and 3:1 for secondary labels.

module T27osWinMaterial;

use t27os::hot_reload::THV_COUNT;
use t27os::hot_reload::THV_TINT_BLACK;
use t27os::hot_reload::THV_STRICT_SIDE;
use t27os::hot_reload::THV_ELEVATED_BLACK;
use t27os::hot_reload::THV_STRICT_CONTENT;
use t27os::hot_reload::THV_PANEL_BLACK;
use t27os::hot_reload::THV_TEXT_WHITE;
use t27os::hot_reload::THV_LABEL_WHITE;
use t27os::hot_reload::THV_MUTED_WHITE;
use t27os::hot_reload::THV_BORDER_WHITE;
use t27os::hot_reload::THV_LINE_WHITE;
use t27os::hot_reload::THV_HIGHLIGHT_WHITE;
use t27os::hot_reload::THV_TERMINAL_TINT;

pub const TH_DARK : u32 = 0;
pub const TH_LIGHT : u32 = 1;
pub const TH_OPAQUE : u32 = 2;
pub const TH_COUNT : u32 = 3;

/// WCAG AA: body text, and large or secondary text.
pub const MIN_CONTRAST : f64 = 4.5;
pub const MIN_SECONDARY : f64 = 3.0;

/// The white frost draw_ground lays over a glass surface (glass_window.t27 SURF_FROST).
pub const FROST_WHITE : f64 = 0.05;

/// NSAppearance names the window asks for: 0 NSAppearanceNameAqua, 1 NSAppearanceNameDarkAqua.
pub const APPEAR_AQUA : u32 = 0;
pub const APPEAR_DARK_AQUA : u32 = 1;

/// NSVisualEffectMaterial values: 7 Sidebar (light frosted under Aqua), 13 HUDWindow (today's dark).
pub const NS_MATERIAL_SIDEBAR : u64 = 7;
pub const NS_MATERIAL_HUD : u64 = 13;

/// The theme rows, THV_COUNT permille levels each, in the order of hot_reload.t27 THV_*:
/// tint, side, elevated, content, panel, text, label, muted, border, line, highlight, tip, crown,
/// terminal, agents line.
/// Dark = glass_window.t27 today: its floor was 0.55 with labels at 0.50, which gave 4.11:1 and 2.42:1
/// on the bare ground; the owner's order of 2026-11-08 raised them to 0.58 and 0.60, the levels Light
/// already had, so both glass themes share one floor and one label level.
/// Light = the same black floor under text (0.58, so white primary
/// text passes even on the bare ground) over the light Sidebar material, lighter surfaces, brighter
/// hairlines and highlights: the desktop shows through frosted and grey, never near-white under
/// text. Opaque = black at 1.0 for the ground and every surface, so nothing of the glass shows.
/// Hover (order APPLY_APPLE_MATERIALS_GUIDANCE, 2026-11-08): a hovered control lays the highlight
/// white under a muted glyph. Muted 0.62 over highlight 0.08 (Dark) gave 2.77:1 and muted 0.70 over
/// highlight 0.18 (Light) 2.63:1 on the bare ground, both under the 3:1 non-text floor. Every row now
/// carries muted 0.70 (the level Light already had) and highlight 0.08: 3.09:1 (hover_ok).
pub const THEMES : [45]u32 = [
    580, 450, 580, 350, 580, 880, 600, 700, 140, 120, 80, 940, 700, 150, 600,
    580, 150, 300, 100, 250, 940, 600, 700, 300, 220, 80, 960, 760, 50, 700,
    1000, 1000, 580, 1000, 1000, 880, 600, 700, 140, 120, 80, 940, 700, 150, 600,
];

pub fn theme_ok(t: u32) -> bool {
    return t < TH_COUNT;
}

/// The next theme of the switch: dark, light, opaque, dark again. An unknown id falls back to dark.
pub fn next_theme(t: u32) -> u32 {
    if (t == TH_DARK) { return TH_LIGHT; }
    if (t == TH_LIGHT) { return TH_OPAQUE; }
    return TH_DARK;
}

/// Level id of theme t in permille; an unknown theme reads as dark, an unknown id as 0.
pub fn th_permille(t: u32, id: u32) -> u32 {
    var row : u32 = t;
    if (theme_ok(t) == false) { row = TH_DARK; }
    if (id >= THV_COUNT) { return 0; }
    return THEMES[@as(usize, row * THV_COUNT + id)];
}

pub fn th_level(t: u32, id: u32) -> f64 {
    return @as(f64, @floatFromInt(th_permille(t, id))) / 1000.0;
}

/// Write theme t into a THV_COUNT table (the caller packs it into the kit with thv_store).
pub fn th_fill(tbl: []u32, t: u32) -> void {
    var i : u32 = 0;
    while (i < THV_COUNT) {
        tbl[@as(usize, i)] = th_permille(t, i);
        i = i + 1;
    }
}

pub fn uses_blur(t: u32) -> bool {
    return t == TH_DARK or t == TH_LIGHT;
}

pub fn appearance(t: u32) -> u32 {
    if (t == TH_LIGHT) { return APPEAR_AQUA; }
    return APPEAR_DARK_AQUA;
}

pub fn ns_material(t: u32) -> u64 {
    if (t == TH_LIGHT) { return NS_MATERIAL_SIDEBAR; }
    return NS_MATERIAL_HUD;
}

fn root5(a: f64) -> f64 {
    if (a <= 0.0) { return 0.0; }
    var y : f64 = 1.0;
    var i : u32 = 0;
    while (i < 60) {
        const y2 : f64 = y * y;
        const y4 : f64 = y2 * y2;
        y = y - (y4 * y - a) / (5.0 * y4);
        i = i + 1;
    }
    return y;
}

/// The sRGB transfer: an encoded channel 0..1 to linear light.
pub fn srgb_to_lin(e: f64) -> f64 {
    if (e <= 0.04045) { return e / 12.92; }
    const t : f64 = (e + 0.055) / 1.055;
    const t2 : f64 = t * t;
    return t2 * root5(t2);
}

/// WCAG contrast of two relative luminances.
pub fn contrast(l1: f64, l2: f64) -> f64 {
    if (l1 >= l2) { return (l1 + 0.05) / (l2 + 0.05); }
    return (l2 + 0.05) / (l1 + 0.05);
}

/// Contrast of white text at alpha a over a neutral backing of encoded value e.
pub fn white_at(a: f64, e: f64) -> f64 {
    return contrast(srgb_to_lin(a + (1.0 - a) * e), srgb_to_lin(e));
}

/// The worst backing (white desktop) under a surface of level id in theme t; THV_COUNT = the bare ground.
pub fn backing(t: u32, id: u32) -> f64 {
    const g : f64 = th_level(t, THV_TINT_BLACK);
    if (id >= THV_COUNT) { return 1.0 - g; }
    const s : f64 = th_level(t, id);
    return FROST_WHITE + (1.0 - FROST_WHITE) * (1.0 - g) * (1.0 - s);
}

/// The text-bearing backings: the bare ground (title bar), the sidebar, the content and the panels.
pub const TEXT_GROUNDS : [4]u32 = [15, 1, 3, 4];

/// The shared rule: primary text keeps MIN_CONTRAST and labels MIN_SECONDARY on every text-bearing backing.
pub fn white_text_ok(t: u32) -> bool {
    var i : usize = 0;
    while (i < 4) {
        const e : f64 = backing(t, TEXT_GROUNDS[i]);
        if (white_at(th_level(t, THV_TEXT_WHITE), e) < MIN_CONTRAST) { return false; }
        if (white_at(th_level(t, THV_LABEL_WHITE), e) < MIN_SECONDARY) { return false; }
        i = i + 1;
    }
    return true;
}

/// The least black floor g that keeps primary text at alpha a passing on the bare ground.
pub fn floor_needed(a: f64) -> f64 {
    var lo : f64 = 0.0;
    var hi : f64 = 1.0;
    var i : u32 = 0;
    while (i < 40) {
        const mid : f64 = 0.5 * (lo + hi);
        if (white_at(a, 1.0 - mid) >= MIN_CONTRAST) { hi = mid; } else { lo = mid; }
        i = i + 1;
    }
    return hi;
}

// ---- hover, boundaries and the system accessibility settings -------------------------------------

/// Non-text contrast (3:1) of a muted glyph on a hovered control: the highlight white lifts the
/// backing of ground id first, then the glyph is drawn at the muted level over it.
pub fn hover_at(t: u32, id: u32) -> f64 {
    const e : f64 = backing(t, id);
    const h : f64 = th_level(t, THV_HIGHLIGHT_WHITE);
    return white_at(th_level(t, THV_MUTED_WHITE), h + (1.0 - h) * e);
}

pub fn hover_ok(t: u32) -> bool {
    var i : usize = 0;
    while (i < 4) {
        if (hover_at(t, TEXT_GROUNDS[i]) < MIN_SECONDARY) { return false; }
        i = i + 1;
    }
    return true;
}

/// Increase Contrast (NSWorkspace accessibilityDisplayShouldIncreaseContrast): hairlines and
/// dividers rise from decorative (Dark border 0.14 on the bare ground is 1.34:1) to this level,
/// which keeps 3:1 on every text-bearing ground of every theme.
pub const BOUNDARY_HC : u32 = 600;

pub fn boundary_hc_ok(t: u32) -> bool {
    const b : f64 = @as(f64, @floatFromInt(BOUNDARY_HC)) / 1000.0;
    var i : usize = 0;
    while (i < 4) {
        if (white_at(b, backing(t, TEXT_GROUNDS[i])) < MIN_SECONDARY) { return false; }
        i = i + 1;
    }
    return true;
}

/// The system state the window reads once a second, packed in one word: bit 0 Reduce Transparency,
/// bit 1 Increase Contrast, bit 2 set once the state has been applied (so 0 means never applied).
pub const A11Y_REDUCE : u64 = 1;
pub const A11Y_CONTRAST : u64 = 2;
pub const A11Y_APPLIED : u64 = 4;

pub fn a11y_key(reduce: bool, more: bool) -> u64 {
    var k : u64 = A11Y_APPLIED;
    if (reduce) { k = k + A11Y_REDUCE; }
    if (more) { k = k + A11Y_CONTRAST; }
    return k;
}

pub fn a11y_reduce(k: u64) -> bool {
    return k % 2 == 1;
}

pub fn a11y_contrast(k: u64) -> bool {
    return (k / 2) % 2 == 1;
}

/// Reduce Transparency shows the opaque row in place of either glass theme; the user's choice is
/// not changed (the caller keeps it in K_THEME), so turning the setting off returns to it. White
/// primary text (the owner's decision) has no light solid ground that passes, so the solid is black.
pub fn a11y_theme(t: u32, reduce: bool) -> u32 {
    if (reduce) { return TH_OPAQUE; }
    if (theme_ok(t) == false) { return TH_DARK; }
    return t;
}

/// Raise border and line to BOUNDARY_HC when Increase Contrast is on; levels already above stay.
pub fn a11y_boost(tbl: []u32, more: bool) -> void {
    if (more == false) { return; }
    if (tbl[@as(usize, THV_BORDER_WHITE)] < BOUNDARY_HC) { tbl[@as(usize, THV_BORDER_WHITE)] = BOUNDARY_HC; }
    if (tbl[@as(usize, THV_LINE_WHITE)] < BOUNDARY_HC) { tbl[@as(usize, THV_LINE_WHITE)] = BOUNDARY_HC; }
}

/// The row the window shows for the user's theme t under the system state k.
pub fn th_fill_a11y(tbl: []u32, t: u32, k: u64) -> void {
    th_fill(tbl, a11y_theme(t, a11y_reduce(k)));
    a11y_boost(tbl, a11y_contrast(k));
}

// ---- regions and their materials (order APPLY_APPLE_MATERIALS_GUIDANCE_TO_CURRENT_UI_RING) --------
// The functional layer (title and toolbar, navigation sidebar, inspector header, floating controls,
// transient surfaces) is where glass belongs; the content layer (the Lukomorye graph, agents and
// relations, tasks and artifacts, message history, inspector content) takes a standard material.
// What is wired today is one NSVisualEffectView behind the whole window (rg_now): the plan below is
// the contract the per-region views are built against, and it names its fallbacks honestly.

pub const RG_TITLE : u32 = 0;
pub const RG_SIDEBAR : u32 = 1;
pub const RG_CONTENT : u32 = 2;
pub const RG_INSP_HEAD : u32 = 3;
pub const RG_INSP_BODY : u32 = 4;
pub const RG_FLOAT : u32 = 5;
pub const RG_TRANSIENT : u32 = 6;
pub const RG_COUNT : u32 = 7;

pub const LAYER_FUNCTIONAL : u32 = 0;
pub const LAYER_CONTENT : u32 = 1;

/// Material kinds, one per native API; a standard material and Liquid Glass are never one kind.
/// MK_STANDARD: NSVisualEffectView (macOS 10.10+, semantic materials 10.14+).
/// MK_GLASS_REGULAR / MK_GLASS_CLEAR: NSGlassEffectView style regular / clear (macOS 26+).
/// MK_SOLID: no material, an opaque fill (Reduce Transparency, the opaque theme).
pub const MK_STANDARD : u32 = 1;
pub const MK_GLASS_REGULAR : u32 = 2;
pub const MK_GLASS_CLEAR : u32 = 3;
pub const MK_SOLID : u32 = 4;

/// Not wired: glass_window.t27 creates no NSGlassEffectView and no per-region view yet.
pub const GLASS_WIRED : bool = false;
pub const REGION_VIEWS_WIRED : bool = false;

/// NSVisualEffectMaterial values beside SIDEBAR 7 and HUD 13.
pub const NS_MATERIAL_TITLEBAR : u64 = 3;
pub const NS_MATERIAL_POPOVER : u64 = 6;
pub const NS_MATERIAL_HEADER : u64 = 10;
pub const NS_MATERIAL_WINDOW_BG : u64 = 12;
pub const NS_MATERIAL_TOOLTIP : u64 = 17;
pub const NS_MATERIAL_CONTENT_BG : u64 = 18;

/// NSVisualEffectBlendingMode.
pub const BLEND_BEHIND_WINDOW : u64 = 0;
pub const BLEND_WITHIN_WINDOW : u64 = 1;

pub fn rg_layer(r: u32) -> u32 {
    if (r == RG_CONTENT or r == RG_INSP_BODY) { return LAYER_CONTENT; }
    return LAYER_FUNCTIONAL;
}

/// Regular glass for the text-heavy functional surfaces, a standard material for content. No region
/// asks for clear glass: its readability over the graph has not been measured.
pub fn rg_wanted(r: u32) -> u32 {
    if (rg_layer(r) == LAYER_CONTENT) { return MK_STANDARD; }
    return MK_GLASS_REGULAR;
}

/// What a region gets: solid when transparency is reduced or the theme has no blur, the standard
/// material while glass is not wired, else what it asks for.
pub fn rg_kind(r: u32, t: u32, reduce: bool) -> u32 {
    if (reduce or uses_blur(t) == false) { return MK_SOLID; }
    const w : u32 = rg_wanted(r);
    if ((w == MK_GLASS_REGULAR or w == MK_GLASS_CLEAR) and GLASS_WIRED == false) { return MK_STANDARD; }
    return w;
}

/// The semantic NSVisualEffectView material of a region's standard fallback (the appearance makes it
/// light or dark).
pub fn rg_material(r: u32) -> u64 {
    if (r == RG_TITLE) { return NS_MATERIAL_TITLEBAR; }
    if (r == RG_SIDEBAR) { return NS_MATERIAL_SIDEBAR; }
    if (r == RG_CONTENT) { return NS_MATERIAL_WINDOW_BG; }
    if (r == RG_INSP_HEAD) { return NS_MATERIAL_HEADER; }
    if (r == RG_INSP_BODY) { return NS_MATERIAL_CONTENT_BG; }
    if (r == RG_FLOAT) { return NS_MATERIAL_POPOVER; }
    return NS_MATERIAL_TOOLTIP;
}

/// Behind-window where the desktop is what lies under a region (the title has nothing scrolling under
/// it, the inspector reserves its width, the content is the window base); within-window where a
/// region floats over the window's own content (floating controls, transient surfaces).
pub fn rg_blend(r: u32) -> u64 {
    if (r == RG_FLOAT or r == RG_TRANSIENT) { return BLEND_WITHIN_WINDOW; }
    return BLEND_BEHIND_WINDOW;
}

/// Today, for every region alike: the one behind-window view and the theme's material
/// (glass_window.t27 `glass`, BLEND_BEHIND_WINDOW).
pub fn rg_now(t: u32) -> u64 {
    return ns_material(t);
}

test the_transfer_is_srgb {
    assert @abs(srgb_to_lin(1.0) - 1.0) < 0.000001;
    assert srgb_to_lin(0.0) == 0.0;
    // mid-grey 0.5 encoded is 0.2140 linear
    assert @abs(srgb_to_lin(0.5) - 0.21404) < 0.0001;
    assert @abs(root5(32.0) - 2.0) < 0.000001;
}

test dark_is_todays_row {
    // glass_window.t27 thv_defaults: TINT_BLACK 0.58, STRICT_SIDE 0.45, ELEVATED_BLACK 0.58,
    // STRICT_CONTENT 0.35, PANEL_BLACK 0.58, TEXT_WHITE 0.88, LABEL_WHITE 0.60, TERMINAL_TINT 0.15
    assert th_permille(TH_DARK, THV_TINT_BLACK) == 580;
    assert th_permille(TH_DARK, THV_STRICT_SIDE) == 450;
    assert th_permille(TH_DARK, THV_ELEVATED_BLACK) == 580;
    assert th_permille(TH_DARK, THV_STRICT_CONTENT) == 350;
    assert th_permille(TH_DARK, THV_PANEL_BLACK) == 580;
    assert th_permille(TH_DARK, THV_TEXT_WHITE) == 880;
    assert th_permille(TH_DARK, THV_LABEL_WHITE) == 600;
    assert th_permille(TH_DARK, THV_TERMINAL_TINT) == 150;
    assert ns_material(TH_DARK) == 13 and appearance(TH_DARK) == APPEAR_DARK_AQUA;
}

test white_text_passes_light_and_opaque {
    assert white_text_ok(TH_LIGHT);
    assert white_text_ok(TH_OPAQUE);
    // the light floor alone carries primary text on a white desktop
    assert white_at(th_level(TH_LIGHT, THV_TEXT_WHITE), backing(TH_LIGHT, THV_COUNT)) > 4.9;
    assert th_level(TH_LIGHT, THV_TINT_BLACK) >= floor_needed(th_level(TH_LIGHT, THV_TEXT_WHITE));
    // opaque: primary text on #000000
    assert white_at(th_level(TH_OPAQUE, THV_TEXT_WHITE), backing(TH_OPAQUE, THV_COUNT)) > 15.0;
}

test dark_passes_on_every_text_ground {
    // computed, not a measurement of the native window: white desktop, encoded-sRGB blend, frost 0.05
    // under surfaces, the HUD material's own darkening left out (so the real window is darker)
    assert white_at(0.88, backing(TH_DARK, THV_STRICT_SIDE)) > 7.0;
    assert white_at(0.88, backing(TH_DARK, THV_STRICT_CONTENT)) > 6.0;
    assert white_at(0.88, backing(TH_DARK, THV_PANEL_BLACK)) > 9.0;
    // the bare ground under the title: 0.58 black over white leaves 0.42, white 0.88 on it is 4.56:1
    const bare : f64 = white_at(0.88, backing(TH_DARK, THV_COUNT));
    assert bare >= MIN_CONTRAST and bare < 4.6;
    // labels at 0.60 on the same ground: 3.05:1
    const lab : f64 = white_at(th_level(TH_DARK, THV_LABEL_WHITE), backing(TH_DARK, THV_COUNT));
    assert lab >= MIN_SECONDARY and lab < 3.1;
    assert white_text_ok(TH_DARK);
    assert th_level(TH_DARK, THV_TINT_BLACK) >= floor_needed(th_level(TH_DARK, THV_TEXT_WHITE));
}

test negative_control_the_old_dark_row_fails {
    // the row before 2026-11-08: floor 0.55 (ground 0.45) gave white 0.88 4.11:1, labels 0.50 2.42:1
    const old_text : f64 = white_at(0.88, 0.45);
    assert old_text > 4.0 and old_text < MIN_CONTRAST;
    assert white_at(0.50, 0.45) < MIN_SECONDARY;
    // the new floor alone does not carry the old labels (2.60:1), so the label level had to move too
    assert white_at(0.50, 0.42) < MIN_SECONDARY;
    // a floor 0.01 under the least one fails, so 0.58 is not passing by accident of the bisection
    assert white_at(0.88, 1.0 - (floor_needed(0.88) - 0.01)) < MIN_CONTRAST;
    assert floor_needed(0.88) > 0.575 and floor_needed(0.88) < 0.58;
}

test light_is_lighter_and_opaque_has_no_blur {
    assert th_permille(TH_LIGHT, THV_STRICT_SIDE) < th_permille(TH_DARK, THV_STRICT_SIDE);
    assert th_permille(TH_LIGHT, THV_STRICT_CONTENT) < th_permille(TH_DARK, THV_STRICT_CONTENT);
    assert th_permille(TH_LIGHT, THV_PANEL_BLACK) < th_permille(TH_DARK, THV_PANEL_BLACK);
    assert appearance(TH_LIGHT) == APPEAR_AQUA and ns_material(TH_LIGHT) == NS_MATERIAL_SIDEBAR;
    assert uses_blur(TH_DARK) and uses_blur(TH_LIGHT) and uses_blur(TH_OPAQUE) == false;
    assert th_permille(TH_OPAQUE, THV_TINT_BLACK) == 1000;
}

test the_switch_cycles_and_fills_one_row {
    assert next_theme(TH_DARK) == TH_LIGHT;
    assert next_theme(TH_LIGHT) == TH_OPAQUE;
    assert next_theme(TH_OPAQUE) == TH_DARK;
    assert next_theme(99) == TH_DARK;
    assert th_permille(99, THV_TINT_BLACK) == 580;
    assert th_permille(TH_DARK, 99) == 0;
    var tbl : [15]u32 = undefined;
    th_fill(tbl[0..15], TH_LIGHT);
    assert tbl[0] == 580 and tbl[1] == 150 and tbl[14] == 700;
    th_fill(tbl[0..15], TH_DARK);
    assert tbl[0] == 580 and tbl[5] == 880 and tbl[6] == 600;
}

test negative_control_white_on_bare_light_glass_fails {
    // white text straight on light frost over a white desktop is 1:1, far below 4.5
    assert white_at(1.0, 1.0) < 1.01;
    // a floor just under the least one fails
    assert white_at(0.94, 1.0 - (floor_needed(0.94) - 0.01)) < MIN_CONTRAST;
    // the light content backing made 0.3 brighter (a thinner black floor) fails at once
    assert white_at(0.94, backing(TH_LIGHT, THV_STRICT_CONTENT) + 0.3) < MIN_CONTRAST;
}

test negative_control_linear_blend_is_stricter {
    // blended in linear light the light floor would leave luminance 0.42, which fails: the rule is
    // stated for the encoded blend the renderer uses, and this test keeps that choice visible
    assert contrast(1.0, 1.0 - th_level(TH_LIGHT, THV_TINT_BLACK)) < MIN_CONTRAST;
}

test hover_glyphs_keep_three_to_one {
    // computed, white desktop, encoded-sRGB blend: muted 0.70 over highlight 0.08 over the bare ground
    // 0.42 is 3.09:1 in Dark and Light alike; the Light sidebar is darker, 3.36:1
    assert th_permille(TH_DARK, THV_MUTED_WHITE) == 700 and th_permille(TH_LIGHT, THV_MUTED_WHITE) == 700;
    assert th_permille(TH_DARK, THV_HIGHLIGHT_WHITE) == 80 and th_permille(TH_LIGHT, THV_HIGHLIGHT_WHITE) == 80;
    const dk : f64 = hover_at(TH_DARK, THV_COUNT);
    assert dk >= MIN_SECONDARY and dk < 3.15;
    const lt : f64 = hover_at(TH_LIGHT, THV_COUNT);
    assert lt >= MIN_SECONDARY and lt < 3.15;
    const ls : f64 = hover_at(TH_LIGHT, THV_STRICT_SIDE);
    assert ls > 3.3 and ls < 3.42;
    assert hover_ok(TH_DARK) and hover_ok(TH_LIGHT) and hover_ok(TH_OPAQUE);
    assert hover_at(TH_OPAQUE, THV_COUNT) > 9.0;
}

test negative_control_the_old_hover_levels_fail {
    // Dark before: muted 0.62 over highlight 0.08 on 0.42 = 2.77:1
    const od : f64 = white_at(0.62, 0.08 + 0.92 * 0.42);
    assert od > 2.7 and od < 2.85;
    // Light before: muted 0.70 over highlight 0.18 on 0.42 = 2.63:1
    const ol : f64 = white_at(0.70, 0.18 + 0.82 * 0.42);
    assert ol > 2.55 and ol < 2.7;
    // a Light highlight of 0.10 still fails (2.99:1), so 0.08 is the level, not a rounding
    assert white_at(0.70, 0.10 + 0.90 * 0.42) < MIN_SECONDARY;
    // muted 0.66 fails (2.93:1): the muted level had to move, not only the highlight
    assert white_at(0.66, 0.08 + 0.92 * 0.42) < MIN_SECONDARY;
}

test increase_contrast_lifts_the_boundaries {
    // the default Dark hairline is decorative: border 0.14 on the bare ground is 1.34:1
    const dflt : f64 = white_at(th_level(TH_DARK, THV_BORDER_WHITE), backing(TH_DARK, THV_COUNT));
    assert dflt > 1.3 and dflt < 1.4;
    // at BOUNDARY_HC 0.60: 3.05:1 on the bare ground, 3.31:1 on the Light sidebar
    const hb : f64 = white_at(0.6, backing(TH_DARK, THV_COUNT));
    assert hb >= MIN_SECONDARY and hb < 3.1;
    const hs : f64 = white_at(0.6, backing(TH_LIGHT, THV_STRICT_SIDE));
    assert hs > 3.25 and hs < 3.4;
    assert boundary_hc_ok(TH_DARK) and boundary_hc_ok(TH_LIGHT) and boundary_hc_ok(TH_OPAQUE);
    var tbl : [15]u32 = undefined;
    th_fill_a11y(tbl[0..15], TH_DARK, a11y_key(false, true));
    assert tbl[8] == 600 and tbl[9] == 600;
    // text, floor and tint are not touched by the contrast setting
    assert tbl[0] == 580 and tbl[5] == 880 and tbl[6] == 600;
    th_fill_a11y(tbl[0..15], TH_DARK, a11y_key(false, false));
    assert tbl[8] == 140 and tbl[9] == 120;
}

test negative_control_a_half_boundary_fails {
    // border 0.50 under Increase Contrast is 2.60:1 on the bare ground, under 3:1
    assert white_at(0.5, backing(TH_DARK, THV_COUNT)) < MIN_SECONDARY;
}

test reduce_transparency_shows_the_solid_and_keeps_the_choice {
    assert a11y_theme(TH_DARK, false) == TH_DARK and a11y_theme(TH_LIGHT, false) == TH_LIGHT;
    assert a11y_theme(TH_LIGHT, true) == TH_OPAQUE and a11y_theme(TH_DARK, true) == TH_OPAQUE;
    assert a11y_theme(99, false) == TH_DARK;
    const k : u64 = a11y_key(true, false);
    assert a11y_reduce(k) and a11y_contrast(k) == false and k >= A11Y_APPLIED;
    assert a11y_reduce(a11y_key(false, true)) == false and a11y_contrast(a11y_key(false, true));
    assert a11y_key(false, false) == A11Y_APPLIED;
    var tbl : [15]u32 = undefined;
    th_fill_a11y(tbl[0..15], TH_LIGHT, k);
    assert tbl[0] == 1000 and tbl[1] == 1000 and tbl[5] == 880;
    // both settings at once: the solid row with raised boundaries
    th_fill_a11y(tbl[0..15], TH_LIGHT, a11y_key(true, true));
    assert tbl[0] == 1000 and tbl[8] == 600 and tbl[9] == 600;
    assert white_text_ok(a11y_theme(TH_LIGHT, true));
}

test functional_and_content_layers_are_split {
    var fun : u32 = 0;
    var glass : u32 = 0;
    var r : u32 = 0;
    while (r < RG_COUNT) {
        if (rg_layer(r) == LAYER_FUNCTIONAL) { fun = fun + 1; }
        if (rg_wanted(r) == MK_GLASS_REGULAR) { glass = glass + 1; }
        // content never asks for glass, and no region asks for clear glass
        if (rg_layer(r) == LAYER_CONTENT) { assert rg_wanted(r) == MK_STANDARD; }
        assert rg_wanted(r) != MK_GLASS_CLEAR;
        r = r + 1;
    }
    assert fun == 5 and glass == 5;
    assert rg_layer(RG_CONTENT) == LAYER_CONTENT and rg_layer(RG_INSP_BODY) == LAYER_CONTENT;
    assert rg_layer(RG_INSP_HEAD) == LAYER_FUNCTIONAL;
    assert MK_STANDARD != MK_GLASS_REGULAR;
}

test the_fallbacks_are_named_and_the_blend_is_chosen {
    // glass is not wired, so every glass region falls back to its standard material, and Reduce
    // Transparency or the opaque theme make every region solid
    assert GLASS_WIRED == false and REGION_VIEWS_WIRED == false;
    var r : u32 = 0;
    var within : u32 = 0;
    while (r < RG_COUNT) {
        assert rg_kind(r, TH_DARK, false) == MK_STANDARD;
        assert rg_kind(r, TH_LIGHT, true) == MK_SOLID;
        assert rg_kind(r, TH_OPAQUE, false) == MK_SOLID;
        if (rg_blend(r) == BLEND_WITHIN_WINDOW) { within = within + 1; }
        r = r + 1;
    }
    assert within == 2;
    assert rg_blend(RG_FLOAT) == BLEND_WITHIN_WINDOW and rg_blend(RG_TRANSIENT) == BLEND_WITHIN_WINDOW;
    assert rg_blend(RG_SIDEBAR) == BLEND_BEHIND_WINDOW and rg_blend(RG_CONTENT) == BLEND_BEHIND_WINDOW;
    // seven regions, seven semantic materials
    assert rg_material(RG_TITLE) == 3 and rg_material(RG_SIDEBAR) == 7 and rg_material(RG_CONTENT) == 12;
    assert rg_material(RG_INSP_HEAD) == 10 and rg_material(RG_INSP_BODY) == 18;
    assert rg_material(RG_FLOAT) == 6 and rg_material(RG_TRANSIENT) == 17;
}

test negative_control_today_is_one_behind_window_blur {
    // what glass_window.t27 wires now: one material for every region; under Dark it is HUD 13, which
    // no region of the plan asks for, so all seven differ
    var differ : u32 = 0;
    var r : u32 = 0;
    while (r < RG_COUNT) {
        if (rg_material(r) != rg_now(TH_DARK)) { differ = differ + 1; }
        r = r + 1;
    }
    assert differ == 7;
    assert rg_now(TH_DARK) == NS_MATERIAL_HUD and rg_now(TH_LIGHT) == NS_MATERIAL_SIDEBAR;
}
