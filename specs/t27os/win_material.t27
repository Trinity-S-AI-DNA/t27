// SPDX-License-Identifier: Apache-2.0
; Refs #13251
; specs/t27os/win_material.t27 -- the window's two glass themes and its opaque fallback, with one
; shared rule that keeps white primary text readable on all three.
; Owner order START_T27OS_UI_KIT_NOW, 2026-11-08 (LAYOUT_AND_DUAL_GLASS_V2, ring 1): a light
; frosted-glass theme and a dark matte-black-glass theme, both with white primary text, a readable
; opaque fallback, and contrast protection from shared tint and scrim rules, not per-label patches.
; A theme is a row of the live theme levels of hot_reload.t27 (THV_*, permille). glass_window.t27
; already draws every surface, line and text run through lv(kit, THV_*), so switching a theme writes
; one row into the kit and changes nothing else: no second token path, no per-label colour.
; Dark is today's built-in row (glass_window.t27 thv_defaults), value for value.
; Material honesty: the blur is the native NSVisualEffectView behind-window blur that glass_window.t27
; sets through objc_msgSend. This module names the material and appearance each theme asks for. It is
; vibrancy blur, not Liquid Glass: no refraction, no lensing, no specular edge. Where the glass shows
; is still the one material rule of glass_window.t27 (on_glass: glass at the docked panel width,
; opaque #000000 in the full window, owner 2026-10-23); the opaque theme also covers the glass.
; The rule. The backdrop behind the glass is any desktop, so the worst case is white. CoreGraphics
; and the compositor blend in encoded sRGB: black at alpha g over white leaves 1 - g. Under a
; surface of black alpha s with the white frost f on top (draw_ground) the backing is
; f + (1 - f) (1 - g) (1 - s). White text drawn at alpha a over a backing e is a + (1 - a) e.
; white_text_ok checks every text-bearing backing of a theme with the real sRGB transfer (Newton's
; method for the 2.4 power) against WCAG 4.5:1 for primary text and 3:1 for secondary labels.

module T27osWinMaterial;

use t27os::hot_reload::THV_COUNT;
use t27os::hot_reload::THV_TINT_BLACK;
use t27os::hot_reload::THV_STRICT_SIDE;
use t27os::hot_reload::THV_ELEVATED_BLACK;
use t27os::hot_reload::THV_STRICT_CONTENT;
use t27os::hot_reload::THV_PANEL_BLACK;
use t27os::hot_reload::THV_TEXT_WHITE;
use t27os::hot_reload::THV_LABEL_WHITE;
use t27os::hot_reload::THV_TERMINAL_TINT;

pub const TH_DARK : u32 = 0;
pub const TH_LIGHT : u32 = 1;
pub const TH_OPAQUE : u32 = 2;
pub const TH_COUNT : u32 = 3;

/// WCAG AA: body text, and large or secondary text.
pub const MIN_CONTRAST : f64 = 4.5;
pub const MIN_SECONDARY : f64 = 3.0;

/// The white frost draw_ground lays over a glass surface (glass_window.t27 SURF_FROST).
pub const FROST_WHITE : f64 = 0.05;

/// NSAppearance names the window asks for: 0 NSAppearanceNameAqua, 1 NSAppearanceNameDarkAqua.
pub const APPEAR_AQUA : u32 = 0;
pub const APPEAR_DARK_AQUA : u32 = 1;

/// NSVisualEffectMaterial values: 7 Sidebar (light frosted under Aqua), 13 HUDWindow (today's dark).
pub const NS_MATERIAL_SIDEBAR : u64 = 7;
pub const NS_MATERIAL_HUD : u64 = 13;

/// The theme rows, THV_COUNT permille levels each, in the order of hot_reload.t27 THV_*:
/// tint, side, elevated, content, panel, text, label, muted, border, line, highlight, tip, crown,
/// terminal, agents line.
/// Dark = glass_window.t27 today. Light = the same black floor under text (0.58, so white primary
/// text passes even on the bare ground) over the light Sidebar material, lighter surfaces, brighter
/// hairlines and highlights: the desktop shows through frosted and grey, never near-white under
/// text. Opaque = black at 1.0 for the ground and every surface, so nothing of the glass shows.
pub const THEMES : [45]u32 = [
    550, 450, 580, 350, 580, 880, 500, 620, 140, 120, 80, 940, 700, 150, 600,
    580, 150, 300, 100, 250, 940, 600, 700, 300, 220, 180, 960, 760, 50, 700,
    1000, 1000, 580, 1000, 1000, 880, 500, 620, 140, 120, 80, 940, 700, 150, 600,
];

pub fn theme_ok(t: u32) -> bool {
    return t < TH_COUNT;
}

/// The next theme of the switch: dark, light, opaque, dark again. An unknown id falls back to dark.
pub fn next_theme(t: u32) -> u32 {
    if (t == TH_DARK) { return TH_LIGHT; }
    if (t == TH_LIGHT) { return TH_OPAQUE; }
    return TH_DARK;
}

/// Level id of theme t in permille; an unknown theme reads as dark, an unknown id as 0.
pub fn th_permille(t: u32, id: u32) -> u32 {
    var row : u32 = t;
    if (theme_ok(t) == false) { row = TH_DARK; }
    if (id >= THV_COUNT) { return 0; }
    return THEMES[@as(usize, row * THV_COUNT + id)];
}

pub fn th_level(t: u32, id: u32) -> f64 {
    return @as(f64, @floatFromInt(th_permille(t, id))) / 1000.0;
}

/// Write theme t into a THV_COUNT table (the caller packs it into the kit with thv_store).
pub fn th_fill(tbl: []u32, t: u32) -> void {
    var i : u32 = 0;
    while (i < THV_COUNT) {
        tbl[@as(usize, i)] = th_permille(t, i);
        i = i + 1;
    }
}

pub fn uses_blur(t: u32) -> bool {
    return t == TH_DARK or t == TH_LIGHT;
}

pub fn appearance(t: u32) -> u32 {
    if (t == TH_LIGHT) { return APPEAR_AQUA; }
    return APPEAR_DARK_AQUA;
}

pub fn ns_material(t: u32) -> u64 {
    if (t == TH_LIGHT) { return NS_MATERIAL_SIDEBAR; }
    return NS_MATERIAL_HUD;
}

fn root5(a: f64) -> f64 {
    if (a <= 0.0) { return 0.0; }
    var y : f64 = 1.0;
    var i : u32 = 0;
    while (i < 60) {
        const y2 : f64 = y * y;
        const y4 : f64 = y2 * y2;
        y = y - (y4 * y - a) / (5.0 * y4);
        i = i + 1;
    }
    return y;
}

/// The sRGB transfer: an encoded channel 0..1 to linear light.
pub fn srgb_to_lin(e: f64) -> f64 {
    if (e <= 0.04045) { return e / 12.92; }
    const t : f64 = (e + 0.055) / 1.055;
    const t2 : f64 = t * t;
    return t2 * root5(t2);
}

/// WCAG contrast of two relative luminances.
pub fn contrast(l1: f64, l2: f64) -> f64 {
    if (l1 >= l2) { return (l1 + 0.05) / (l2 + 0.05); }
    return (l2 + 0.05) / (l1 + 0.05);
}

/// Contrast of white text at alpha a over a neutral backing of encoded value e.
pub fn white_at(a: f64, e: f64) -> f64 {
    return contrast(srgb_to_lin(a + (1.0 - a) * e), srgb_to_lin(e));
}

/// The worst backing (white desktop) under a surface of level id in theme t; THV_COUNT = the bare ground.
pub fn backing(t: u32, id: u32) -> f64 {
    const g : f64 = th_level(t, THV_TINT_BLACK);
    if (id >= THV_COUNT) { return 1.0 - g; }
    const s : f64 = th_level(t, id);
    return FROST_WHITE + (1.0 - FROST_WHITE) * (1.0 - g) * (1.0 - s);
}

/// The text-bearing backings: the bare ground (title bar), the sidebar, the content and the panels.
pub const TEXT_GROUNDS : [4]u32 = [15, 1, 3, 4];

/// The shared rule: primary text keeps MIN_CONTRAST and labels MIN_SECONDARY on every text-bearing backing.
pub fn white_text_ok(t: u32) -> bool {
    var i : usize = 0;
    while (i < 4) {
        const e : f64 = backing(t, TEXT_GROUNDS[i]);
        if (white_at(th_level(t, THV_TEXT_WHITE), e) < MIN_CONTRAST) { return false; }
        if (white_at(th_level(t, THV_LABEL_WHITE), e) < MIN_SECONDARY) { return false; }
        i = i + 1;
    }
    return true;
}

/// The least black floor g that keeps primary text at alpha a passing on the bare ground.
pub fn floor_needed(a: f64) -> f64 {
    var lo : f64 = 0.0;
    var hi : f64 = 1.0;
    var i : u32 = 0;
    while (i < 40) {
        const mid : f64 = 0.5 * (lo + hi);
        if (white_at(a, 1.0 - mid) >= MIN_CONTRAST) { hi = mid; } else { lo = mid; }
        i = i + 1;
    }
    return hi;
}

test the_transfer_is_srgb {
    assert @abs(srgb_to_lin(1.0) - 1.0) < 0.000001;
    assert srgb_to_lin(0.0) == 0.0;
    // mid-grey 0.5 encoded is 0.2140 linear
    assert @abs(srgb_to_lin(0.5) - 0.21404) < 0.0001;
    assert @abs(root5(32.0) - 2.0) < 0.000001;
}

test dark_is_todays_row {
    // glass_window.t27 thv_defaults: TINT_BLACK 0.55, STRICT_SIDE 0.45, ELEVATED_BLACK 0.58,
    // STRICT_CONTENT 0.35, PANEL_BLACK 0.58, TEXT_WHITE 0.88, LABEL_WHITE 0.50, TERMINAL_TINT 0.15
    assert th_permille(TH_DARK, THV_TINT_BLACK) == 550;
    assert th_permille(TH_DARK, THV_STRICT_SIDE) == 450;
    assert th_permille(TH_DARK, THV_ELEVATED_BLACK) == 580;
    assert th_permille(TH_DARK, THV_STRICT_CONTENT) == 350;
    assert th_permille(TH_DARK, THV_PANEL_BLACK) == 580;
    assert th_permille(TH_DARK, THV_TEXT_WHITE) == 880;
    assert th_permille(TH_DARK, THV_LABEL_WHITE) == 500;
    assert th_permille(TH_DARK, THV_TERMINAL_TINT) == 150;
    assert ns_material(TH_DARK) == 13 and appearance(TH_DARK) == APPEAR_DARK_AQUA;
}

test white_text_passes_light_and_opaque {
    assert white_text_ok(TH_LIGHT);
    assert white_text_ok(TH_OPAQUE);
    // the light floor alone carries primary text on a white desktop
    assert white_at(th_level(TH_LIGHT, THV_TEXT_WHITE), backing(TH_LIGHT, THV_COUNT)) > 4.9;
    assert th_level(TH_LIGHT, THV_TINT_BLACK) >= floor_needed(th_level(TH_LIGHT, THV_TEXT_WHITE));
    // opaque: primary text on #000000
    assert white_at(th_level(TH_OPAQUE, THV_TEXT_WHITE), backing(TH_OPAQUE, THV_COUNT)) > 15.0;
}

test dark_surfaces_pass_and_the_bare_ground_is_measured {
    // every dark surface that carries text passes; the bare dark ground (0.55 under the title) gives
    // 4.1:1 on a white desktop, so the title bar is the one dark backing below AA in the worst case
    assert white_at(0.88, backing(TH_DARK, THV_STRICT_SIDE)) > 7.0;
    assert white_at(0.88, backing(TH_DARK, THV_STRICT_CONTENT)) > 6.0;
    assert white_at(0.88, backing(TH_DARK, THV_PANEL_BLACK)) > 7.0;
    const bare : f64 = white_at(0.88, backing(TH_DARK, THV_COUNT));
    assert bare > 4.0 and bare < 4.5;
    assert white_text_ok(TH_DARK) == false;
}

test light_is_lighter_and_opaque_has_no_blur {
    assert th_permille(TH_LIGHT, THV_STRICT_SIDE) < th_permille(TH_DARK, THV_STRICT_SIDE);
    assert th_permille(TH_LIGHT, THV_STRICT_CONTENT) < th_permille(TH_DARK, THV_STRICT_CONTENT);
    assert th_permille(TH_LIGHT, THV_PANEL_BLACK) < th_permille(TH_DARK, THV_PANEL_BLACK);
    assert appearance(TH_LIGHT) == APPEAR_AQUA and ns_material(TH_LIGHT) == NS_MATERIAL_SIDEBAR;
    assert uses_blur(TH_DARK) and uses_blur(TH_LIGHT) and uses_blur(TH_OPAQUE) == false;
    assert th_permille(TH_OPAQUE, THV_TINT_BLACK) == 1000;
}

test the_switch_cycles_and_fills_one_row {
    assert next_theme(TH_DARK) == TH_LIGHT;
    assert next_theme(TH_LIGHT) == TH_OPAQUE;
    assert next_theme(TH_OPAQUE) == TH_DARK;
    assert next_theme(99) == TH_DARK;
    assert th_permille(99, THV_TINT_BLACK) == 550;
    assert th_permille(TH_DARK, 99) == 0;
    var tbl : [15]u32 = undefined;
    th_fill(tbl[0..15], TH_LIGHT);
    assert tbl[0] == 580 and tbl[1] == 150 and tbl[14] == 700;
    th_fill(tbl[0..15], TH_DARK);
    assert tbl[0] == 550 and tbl[5] == 880;
}

test negative_control_white_on_bare_light_glass_fails {
    // white text straight on light frost over a white desktop is 1:1, far below 4.5
    assert white_at(1.0, 1.0) < 1.01;
    // a floor just under the least one fails
    assert white_at(0.94, 1.0 - (floor_needed(0.94) - 0.01)) < MIN_CONTRAST;
    // the light content backing made 0.3 brighter (a thinner black floor) fails at once
    assert white_at(0.94, backing(TH_LIGHT, THV_STRICT_CONTENT) + 0.3) < MIN_CONTRAST;
}

test negative_control_linear_blend_is_stricter {
    // blended in linear light the light floor would leave luminance 0.42, which fails: the rule is
    // stated for the encoded blend the renderer uses, and this test keeps that choice visible
    assert contrast(1.0, 1.0 - th_level(TH_LIGHT, THV_TINT_BLACK)) < MIN_CONTRAST;
}
