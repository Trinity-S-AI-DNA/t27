// SPDX-License-Identifier: Apache-2.0
// specs/t27os/vertical_agent_graph.t27 -- T27OS vertical agent graph: seed ->
// team -> creator -> subagents -> background -> visual.
// Part of M7 milestone (milestone #11). Closes #13633.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::vertical_agent_graph;

pub const VERTICAL_AGENT_GRAPH_MAX_LEVELS : u32 = 5;

pub struct AgentGraphLevel { name: str, active: bool };

pub fn agent_graph_level_active(l: AgentGraphLevel) -> bool {
    return l.active;
}

test "agent_graph_level_active" {
    assert(agent_graph_level_active(AgentGraphLevel { name: "seed", active: true }));
    assert(!agent_graph_level_active(AgentGraphLevel { name: "background", active: false }));
}

invariant vertical_agent_graph_max_levels_positive {
    assert VERTICAL_AGENT_GRAPH_MAX_LEVELS > 0;
}