// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_team_access.t27 -- Epic: DSH_TEAM_ACCESS_V1 — team access to
// DSH via https://t27.ai/dsh with Telegram auth.
// Part of M8 milestone (milestone #12). Closes #13615.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_team_access;

pub const DSH_TEAM_ACCESS_V1_URL : str = "https://t27.ai/dsh";

pub struct DshTeamAccess { telegram_auth: bool, access_granted: bool };

pub fn dsh_team_access_granted(a: DshTeamAccess) -> bool {
    return a.telegram_auth && a.access_granted;
}

test "dsh_team_access_granted" {
    assert(dsh_team_access_granted(DshTeamAccess { telegram_auth: true, access_granted: true }));
    assert(!dsh_team_access_granted(DshTeamAccess { telegram_auth: true, access_granted: false }));
    assert(!dsh_team_access_granted(DshTeamAccess { telegram_auth: false, access_granted: true }));
}

invariant dsh_team_access_v1_url_defined {
    assert DSH_TEAM_ACCESS_V1_URL == "https://t27.ai/dsh";
}