// SPDX-License-Identifier: Apache-2.0
; T27 OS CDP browser -- the agent's browser surface (BrowserOS neo) driven over the Chrome DevTools
; Protocol, written as a spec. The host runs BrowserOS neo with a CDP endpoint on a local port
; (measured 2026-11-01: neo answers /json/version on 127.0.0.1:9115, plain BrowserOS on 9102;
; 9000/9010/9200 answer 404 and carry no CDP). The wiring here is @extern (t27b only, like
; glass_window.t27): a `PUT /json/new?<url>` opens a tab, the tab's webSocketDebuggerUrl carries
; `Page.enable` and `Runtime.evaluate`, and the page text is read back as one string.
; GATE: this file is an @extern host spec -- t27c cannot compile it (master's text blocks the same
; way glass_window.t27 does); test it with `t27b test specs/t27os/cdp_browser.t27`.
; What is pure here (and therefore tested):
;   - endpoint pick: the discovery list of listening ports reduces to the ones that answer CDP;
;   - tab pick: an existing page tab with the exact target URL is reused, anything else opens new;
;   - the ledger route: the T27 ledger lives on the site root; an unknown `#/ledger` route must not
;     be invented (measured 2026-11-01: https://t27.ai/#/ledger lands on #/ with the site title);
;   - the read cap: page text is read back bounded, never whole (a run is a bounded read).
; The Ollama credit check (ref 57da343f) reads https://ollama.com/settings the same way; payments
; stay with the owner (CLAUDE.md forbidden list) -- this spec only READS the page.

module T27osCdpBrowser;

/// The CDP ports seen listening on 2026-11-01, in scan order.
pub const CDP_PORTS : [8]u16 = [9102, 9115, 9000, 9001, 9010, 9011, 9200, 9210];

/// The ports that answered `/json/version` with a Chrome protocol on 2026-11-01.
pub const CDP_PORTS_LIVE : [2]u16 = [9102, 9115];

/// The neo endpoint is the preferred one: it is the agent's own browser.
pub const NEO_PORT : u16 = 9115;

/// The T27 ledger is the site root; no `#/ledger` route exists.
pub const T27_LEDGER_URL : [29]u8 = "https://t27.ai/#/";

/// The billing page the Ollama auto-reload error names (read only).
pub const OLLAMA_SETTINGS_URL : [26]u8 = "https://ollama.com/settings";

/// How much page text one read returns.
pub const READ_CAP : usize = 4000;

/// Does a port belong to the live CDP set?
pub fn port_live(p : u16) -> bool {
  var i : usize = 0;
  while (i < CDP_PORTS_LIVE.len) {
    if (CDP_PORTS_LIVE[i] == p) { return true; }
    i = i + 1;
  }
  return false;
}

/// Which endpoint a drive uses: neo's port when it is live, else the first live port, else 0.
pub fn pick_endpoint(neo_live : bool, first_other_live : bool) -> u16 {
  if (neo_live) { return NEO_PORT; }
  if (first_other_live) { return CDP_PORTS_LIVE[0]; }
  return 0;
}

/// Reuse an already open page tab at the exact target URL? Only an exact whole-URL match on a
/// `page` target counts; a prefix match or another target type opens a new tab.
pub fn reuse_tab(is_page : bool, url_matches_exactly : bool) -> bool {
  return is_page and url_matches_exactly;
}

/// A route this site does not serve falls back to the root: the driver must not invent a ledger
/// route. The measured landing (2026-11-01) of an unknown hash route is the site title and `#/`.
pub fn route_of(requested_root : bool, requested_unknown_hash : bool) -> u8 {
  if (requested_root) { return 0; }
  if (requested_unknown_hash) { return 0; }
  return 1;
}

/// The read a settled page yields is capped: min(len, READ_CAP).
pub fn read_cap(len : usize) -> usize {
  if (len < READ_CAP) { return len; }
  return READ_CAP;
}

/// The tab-open verb CDP uses: `/json/new?<url>` answered with PUT. A GET on the same path is the
/// legacy form and is refused here, so one drive never mixes the two.
pub fn open_verb(use_put : bool) -> u8 {
  if (use_put) { return 1; }
  return 0;
}

test the_neo_port_is_live_and_the_dead_ports_are_not {
  assert port_live(9115) == true;
  assert port_live(9102) == true;
  assert port_live(9000) == false;
  assert port_live(9222) == false;
}

test the_endpoint_pick_prefers_neo_then_falls_back_then_refuses {
  assert pick_endpoint(true, true) == 9115;
  assert pick_endpoint(true, false) == 9115;
  assert pick_endpoint(false, true) == 9102;
  assert pick_endpoint(false, false) == 0;
}

test only_an_exact_page_match_is_reused {
  assert reuse_tab(true, true) == true;
  assert reuse_tab(true, false) == false;
  assert reuse_tab(false, true) == false;
}

test unknown_routes_land_on_the_root_and_a_known_route_stands {
  assert route_of(true, false) == 0;
  assert route_of(false, true) == 0;
  assert route_of(false, false) == 1;
}

test the_read_is_capped_not_whole {
  assert read_cap(10) == 10;
  assert read_cap(READ_CAP) == READ_CAP;
  assert read_cap(READ_CAP + 1) == READ_CAP;
}

test the_open_verb_is_put_only {
  assert open_verb(true) == 1;
  assert open_verb(false) == 0;
}

invariant a_dead_endpoint_never_drives { assert pick_endpoint(false, false) == 0; }

invariant the_ledger_url_is_the_site_root_never_an_invented_route {
  assert route_of(false, true) == 0;
}
