// App-specific generic-password storage. Private identity bytes never enter a file or diagnostic.
use t27os::keysync_host::ks_gen_pair;
use t27os::keysync_host::konst;
use t27os::keysync_host::take;
use t27os::keysync_host::cf_release;
pub fn li_class(n: []const u8) -> u64   {
    return @extern("objc_getClass");
}
pub fn li_sel(n: []const u8) -> u64   {
    return @extern("sel_registerName");
}
pub fn li_msg0(o:u64,s:u64)->u64   {
    return @extern("objc_msgSend");
}
pub fn li_msg1(o:u64,s:u64,a:u64)->u64   {
    return @extern("objc_msgSend");
}
pub fn li_msg2(o:u64,s:u64,a:u64,b:u64)->u64   {
    return @extern("objc_msgSend");
}
pub fn li_cf_make(a:u64,b:[]const u8,n:usize,e:u32,x:bool)->u64   {
    return @extern("CFStringCreateWithBytes");
}
pub fn li_cf(s:[]const u8)->u64   {
    return li_cf_make(0,s,s.len,134217984,false);
}
pub fn li_data(a:u64,b:[]const u8,n:usize)->u64   {
    return @extern("CFDataCreate");
}
pub fn li_find(q:u64,out:[1]u64)->i32   {
    return @extern("SecItemCopyMatching");
}
pub fn li_add(q:u64,out:u64)->i32   {
    return @extern("SecItemAdd");
}
pub fn li_set(q:u64,key:[]const u8,value:u64)->void   {
    li_msg2(q,li_sel("setObject:forKey:"),value,konst(key));
}
pub fn li_query()->u64   {
    const q:u64=li_msg0(li_class("NSMutableDictionary"),li_sel("new"));
    li_set(q,"kSecClass",konst("kSecClassGenericPassword"));
    const svc:u64=li_cf("ai.t27.localcomms.unified.identity.v1");
    li_set(q,"kSecAttrService",svc);
    cf_release(svc);
    const account:u64=li_cf("local-device-p256");
    li_set(q,"kSecAttrAccount",account);
    cf_release(account);
    // Explicitly device-only; never synchronizable/iCloud.
    li_set(q,"kSecAttrSynchronizable",konst("kCFBooleanFalse"));
    return q;
}
/// 1 loaded,2 created,0 refused. QA may explicitly request ephemeral memory (3).
pub fn li_identity(private_key:[]u8,public_key:[]u8,ephemeral:bool)->u32 {
    return li_identity_report(private_key,public_key,ephemeral,0);
}
pub fn li_signed(o:u64,s:u64,n:i64)->u64{return @extern("objc_msgSend");}
/// Only numeric OSStatus is observable; no SecItem result/data reaches diagnostics.
pub fn li_note(diagnostic:u64,key:[]const u8,status:i64)->void {
    if(diagnostic==0){return;}
    const value:u64=li_signed(li_class("NSNumber"),li_sel("numberWithLongLong:"),status);
    const label:u64=li_cf(key);li_msg2(diagnostic,li_sel("setObject:forKey:"),value,label);cf_release(label);
}
pub fn li_identity_report(private_key:[]u8,public_key:[]u8,ephemeral:bool,diagnostic:u64)->u32 {
    if (private_key.len!=97 or public_key.len!=65)   {
        return 0;
    }
    if (ephemeral)   {
        return if (ks_gen_pair(private_key,public_key)) 3 else 0;
    }
    var result:[1]u64=undefined;
    result[0]=0;
    const q:u64=li_query();
    li_set(q,"kSecReturnData",konst("kCFBooleanTrue"));
    const status:i32=li_find(q,result);
    li_note(diagnostic,"secItemCopyMatching",@as(i64,status));
    cf_release(q);
    if (status==0)   {
        if (take(result[0],private_key)!=97 or private_key[0]!=4)   {
            return 0;
        }
        var i:usize=0;
        while(i<65)  {
            public_key[i]=private_key[i];
            i=i+1;
        }
        return 1;
    }
    if (status!=-25300)   {
        return 0;
    }
    li_note(diagnostic,"keyGenerationAttempted",1);
    if (!ks_gen_pair(private_key,public_key))   {
        return 0;
    }
    const add:u64=li_query();
    const data:u64=li_data(0,private_key,97);
    li_set(add,"kSecValueData",data);
    cf_release(data);
    li_set(add,"kSecAttrAccessible",konst("kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly"));
    const saved:i32=li_add(add,0);
    li_note(diagnostic,"secItemAdd",@as(i64,saved));
    cf_release(add);
    return if(saved==0) 2 else 0;
}
test identity_buffers_must_be_exact_before_any_system_access   {
    var priv:[2]u8=undefined;
    var pubk:[2]u8=undefined;
    assert li_identity(priv[0..2],pubk[0..2],false)==0;
    assert li_identity(priv[0..2],pubk[0..2],true)==0;
}
