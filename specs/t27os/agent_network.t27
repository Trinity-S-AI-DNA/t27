// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agent_network.t27 -- agent network v1.
; One spec has one owner. One agent has one domain. A capability use is
; granted only when the orchestrator already allows it, and only when an
; audit bit is written. The display form of an id is 0x<ROLE>@<domain>.t27.
; The checked form is the packed integer below.
; This layer does not replace the letter cards in specs/agents. Those cards
; stay the path owners (identity.t27, ordinal 1..27). The names here classify
; commands. No command body moves in this layer.
; The window shell stays closed. This spec does not draw it.

module T27osAgentNetwork;

use t27os::orchestrator::WINDOW_SHELL_BLOCKED;
use t27os::orchestrator::oc_window_open;
use t27os::orchestrator::oc_allowed;
use t27os::orchestrator::oc_needs_owner;
use t27os::orchestrator::oc_pr_ok;
use t27os::orchestrator::OC_ACT_WINDOW;
use t27os::orchestrator::OC_ACT_COMMIT;
use t27os::orchestrator::OC_ACT_MERGE;
use t27os::orchestrator::OC_ACT_CRON;
use t27os::orchestrator::OC_ACT_MAC_TEST;
use t27os::orchestrator::OC_ACT_LAB;
use t27os::orchestrator::OC_ACT_PUBLISH;

/// 0: the letter cards remain the path owners.
pub const AN_REPLACES_LETTER_CARDS : u32 = 0;

pub const DOMAIN_COUNT : u32 = 27;

pub const DOM_AGENTS : u32 = 1;
pub const DOM_BUILD : u32 = 2;
pub const DOM_CONTRACTS : u32 = 3;
pub const DOM_DESIGN : u32 = 4;
pub const DOM_ECONOMICS : u32 = 5;
pub const DOM_FILES : u32 = 6;
pub const DOM_GOVERNANCE : u32 = 7;
pub const DOM_HEALTH : u32 = 8;
pub const DOM_INTEGRATION : u32 = 9;
pub const DOM_JOBS : u32 = 10;
pub const DOM_MEMORY : u32 = 11;
pub const DOM_TELEMETRY : u32 = 12;
pub const DOM_ACTORS : u32 = 13;
pub const DOM_NETWORK : u32 = 14;
pub const DOM_OPERATIONS : u32 = 15;
pub const DOM_PRODUCT : u32 = 16;
pub const DOM_QUALITY : u32 = 17;
pub const DOM_RESEARCH : u32 = 18;
pub const DOM_SECURITY : u32 = 19;
pub const DOM_TIME : u32 = 20;
pub const DOM_UX : u32 = 21;
pub const DOM_VISUAL : u32 = 22;
pub const DOM_WORKFLOW : u32 = 23;
pub const DOM_EXTENSIONS : u32 = 24;
pub const DOM_DELIVERY : u32 = 25;
pub const DOM_ZERO_TRUST : u32 = 26;
pub const DOM_KERNEL : u32 = 27;

/// Card file of each domain, index = domain - 1. T27# is kernel.t27.
pub const DOMAIN_FILE : [27]str = [
    "agents.t27", "build.t27", "contracts.t27", "design.t27", "economics.t27",
    "files.t27", "governance.t27", "health.t27", "integration.t27", "jobs.t27",
    "memory.t27", "telemetry.t27", "actors.t27", "network.t27", "operations.t27",
    "product.t27", "quality.t27", "research.t27", "security.t27", "time.t27",
    "ux.t27", "visual.t27", "workflow.t27", "extensions.t27", "delivery.t27",
    "zero-trust.t27", "kernel.t27"
];

pub const ROLE_NONE : u32 = 0;
pub const ROLE_SCOUT : u32 = 1;
pub const ROLE_ORCHESTRATOR : u32 = 2;
pub const ROLE_WORKER : u32 = 3;

/// Commands inventoried in this layer. Bodies are not moved.
pub const CMD_COUNT : u32 = 10;
pub const CMD_T27A_SPEC_SCAN : u32 = 1;
pub const CMD_T27C_CHECK : u32 = 2;
pub const CMD_TRI_TEST : u32 = 3;
pub const CMD_TRI_SEAL : u32 = 4;
pub const CMD_LANE_COMMIT : u32 = 5;
pub const CMD_LANE_PUSH : u32 = 6;
pub const CMD_PULL_REQUEST : u32 = 7;
pub const CMD_MERGE : u32 = 8;
pub const CMD_WINDOW : u32 = 9;
pub const CMD_CRON : u32 = 10;

pub const CMD_ABSENT : u32 = 0;
pub const CMD_LIVE : u32 = 1;

pub const AN_MIGRATED : u32 = 0;
pub const AN_SHIMS : u32 = 0;

pub fn an_domain_ok(domain: u32) -> bool {
    if (domain < 1) { return false; }
    if (domain > DOMAIN_COUNT) { return false; }
    return true;
}

pub fn an_canonical_ok(role: u32, domain: u32) -> bool {
    if (role == ROLE_NONE) { return false; }
    return an_domain_ok(domain);
}

/// Packed id. Domain is the low 5 bits, role is the rest. 32 is above 27.
pub fn an_pack(role: u32, domain: u32) -> u32 {
    return role * 32 + domain;
}

pub fn an_role_of(id: u32) -> u32 {
    return id / 32;
}

pub fn an_domain_of_id(id: u32) -> u32 {
    return id % 32;
}

/// A spec has exactly one owner.
pub fn an_spec_owner_ok(owners: u32) -> bool {
    return owners == 1;
}

/// A domain may hold many agents. An empty domain holds none.
pub fn an_domain_population_ok(agents: u32) -> bool {
    return agents >= 1;
}

/// T27A registers. T27L audits. T27# is the cross-cutting kernel.
pub fn an_registry_domain(domain: u32) -> bool {
    return domain == DOM_AGENTS;
}

pub fn an_audit_domain(domain: u32) -> bool {
    return domain == DOM_TELEMETRY;
}

pub fn an_kernel_domain(domain: u32) -> bool {
    return domain == DOM_KERNEL;
}

pub fn an_register_ok(role: u32, domain: u32, owners: u32) -> bool {
    if (an_canonical_ok(role, domain) == false) { return false; }
    return an_spec_owner_ok(owners);
}

pub fn an_spec_integrated(role: u32, domain: u32, owners: u32, spec_id: u32) -> bool {
    if (spec_id == 0) { return false; }
    return an_register_ok(role, domain, owners);
}

/// A lease is held by one agent for a positive tick count.
pub fn an_lease_held(holder: u32, ticks_left: u32) -> bool {
    if (holder == 0) { return false; }
    return ticks_left > 0;
}

/// The network cannot grant what the orchestrator refuses.
pub fn an_capability_grantable(act: u32) -> bool {
    return oc_allowed(act);
}

/// A use counts only when it was grantable and an audit record was written.
pub fn an_use_audited(act: u32, audit_written: bool) -> bool {
    if (an_capability_grantable(act) == false) { return false; }
    if (audit_written == false) { return false; }
    return true;
}

pub fn an_window_stays_blocked() -> bool {
    if (WINDOW_SHELL_BLOCKED != 1) { return false; }
    if (oc_window_open()) { return false; }
    if (oc_allowed(OC_ACT_WINDOW)) { return false; }
    return true;
}

/// tri t27a spec scan is not a live tool. The assembler pieces exist;
/// the command does not (toolchain.t27, t27a is not a tool).
pub fn an_command_live(cmd: u32) -> u32 {
    if (cmd == CMD_T27A_SPEC_SCAN) { return CMD_ABSENT; }
    if (cmd < 1) { return CMD_ABSENT; }
    if (cmd > CMD_COUNT) { return CMD_ABSENT; }
    return CMD_LIVE;
}

pub fn an_command_domain(cmd: u32) -> u32 {
    if (cmd == CMD_T27A_SPEC_SCAN) { return DOM_AGENTS; }
    if (cmd == CMD_T27C_CHECK) { return DOM_CONTRACTS; }
    if (cmd == CMD_TRI_TEST) { return DOM_QUALITY; }
    if (cmd == CMD_TRI_SEAL) { return DOM_BUILD; }
    if (cmd == CMD_LANE_COMMIT) { return DOM_OPERATIONS; }
    if (cmd == CMD_LANE_PUSH) { return DOM_DELIVERY; }
    if (cmd == CMD_PULL_REQUEST) { return DOM_WORKFLOW; }
    if (cmd == CMD_MERGE) { return DOM_GOVERNANCE; }
    if (cmd == CMD_WINDOW) { return DOM_UX; }
    if (cmd == CMD_CRON) { return DOM_JOBS; }
    return 0;
}

/// Gated commands ask the orchestrator. They are not a second allow list.
pub fn an_command_gated(cmd: u32) -> bool {
    if (cmd == CMD_TRI_TEST) { return oc_needs_owner(OC_ACT_MAC_TEST); }
    if (cmd == CMD_TRI_SEAL) { return oc_needs_owner(OC_ACT_LAB); }
    if (cmd == CMD_MERGE) { return oc_needs_owner(OC_ACT_MERGE); }
    if (cmd == CMD_WINDOW) { return oc_needs_owner(OC_ACT_WINDOW); }
    if (cmd == CMD_CRON) { return oc_needs_owner(OC_ACT_CRON); }
    if (cmd == CMD_PULL_REQUEST) { return false; }
    return false;
}

pub fn an_pr_ready(task_done: bool, checks_green: bool) -> bool {
    return oc_pr_ok(task_done, checks_green);
}

test twenty_seven_domains_and_the_letter_cards_stay {
    assert DOMAIN_COUNT == 27;
    assert AN_REPLACES_LETTER_CARDS == 0;
    assert DOMAIN_FILE[0] == "agents.t27";
    assert DOMAIN_FILE[11] == "telemetry.t27";
    assert DOMAIN_FILE[26] == "kernel.t27";
    assert an_domain_ok(DOM_AGENTS);
    assert an_domain_ok(DOM_KERNEL);
    assert an_domain_ok(0) == false;
    assert an_domain_ok(28) == false;
}

test a_canonical_id_is_one_role_and_one_domain {
    var id : u32 = an_pack(ROLE_SCOUT, DOM_AGENTS);
    assert an_canonical_ok(ROLE_SCOUT, DOM_AGENTS);
    assert an_canonical_ok(ROLE_NONE, DOM_AGENTS) == false;
    assert an_canonical_ok(ROLE_WORKER, 0) == false;
    assert an_role_of(id) == ROLE_SCOUT;
    assert an_domain_of_id(id) == DOM_AGENTS;
    assert an_pack(ROLE_ORCHESTRATOR, DOM_KERNEL) != id;
}

test one_owner_registers_and_a_domain_may_hold_many_agents {
    assert an_registry_domain(DOM_AGENTS);
    assert an_audit_domain(DOM_TELEMETRY);
    assert an_kernel_domain(DOM_KERNEL);
    assert an_spec_owner_ok(1);
    assert an_spec_owner_ok(0) == false;
    assert an_spec_owner_ok(2) == false;
    assert an_domain_population_ok(3);
    assert an_domain_population_ok(0) == false;
    assert an_register_ok(ROLE_ORCHESTRATOR, DOM_KERNEL, 1);
    assert an_register_ok(ROLE_WORKER, DOM_CONTRACTS, 2) == false;
    assert an_spec_integrated(ROLE_SCOUT, DOM_AGENTS, 1, 7);
    assert an_spec_integrated(ROLE_SCOUT, DOM_AGENTS, 1, 0) == false;
}

test a_lease_needs_a_holder_and_time_left {
    assert an_lease_held(an_pack(ROLE_WORKER, DOM_BUILD), 1);
    assert an_lease_held(0, 4) == false;
    assert an_lease_held(an_pack(ROLE_WORKER, DOM_BUILD), 0) == false;
}

test a_capability_use_is_granted_only_when_allowed_and_audited {
    assert an_capability_grantable(OC_ACT_COMMIT);
    assert an_capability_grantable(OC_ACT_MERGE) == false;
    assert an_use_audited(OC_ACT_COMMIT, true);
    assert an_use_audited(OC_ACT_COMMIT, false) == false;
    assert an_use_audited(OC_ACT_MERGE, true) == false;
    assert an_use_audited(OC_ACT_PUBLISH, true) == false;
}

test the_window_shell_stays_blocked {
    assert an_window_stays_blocked();
    assert oc_needs_owner(OC_ACT_WINDOW);
}

test ten_commands_are_classified_and_none_are_migrated {
    assert CMD_COUNT == 10;
    assert AN_MIGRATED == 0;
    assert AN_SHIMS == 0;
    assert an_command_live(CMD_T27A_SPEC_SCAN) == CMD_ABSENT;
    assert an_command_domain(CMD_T27A_SPEC_SCAN) == DOM_AGENTS;
    assert an_command_live(CMD_T27C_CHECK) == CMD_LIVE;
    assert an_command_domain(CMD_T27C_CHECK) == DOM_CONTRACTS;
    assert an_command_domain(CMD_LANE_COMMIT) == DOM_OPERATIONS;
    assert an_command_domain(CMD_LANE_PUSH) == DOM_DELIVERY;
    assert an_command_gated(CMD_LANE_COMMIT) == false;
    assert an_command_gated(CMD_TRI_TEST);
    assert an_command_gated(CMD_TRI_SEAL);
    assert an_command_gated(CMD_MERGE);
    assert an_command_gated(CMD_WINDOW);
    assert an_command_gated(CMD_CRON);
    assert an_command_domain(0) == 0;
    assert an_pr_ready(true, true);
    assert an_pr_ready(true, false) == false;
}
