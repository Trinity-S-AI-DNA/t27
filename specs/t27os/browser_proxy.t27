// SPDX-License-Identifier: Apache-2.0
; Closes #11392
; specs/t27os/browser_proxy.t27 -- LAYER 4: the same-origin proxy. A MODEL
; ONLY: the TypeScript proxy lives in the trios repo and is the witness;
; this file models its origin law as pure computation for t27b.
; -
; THE SAME-ORIGIN LAW. /live/* and /api/browser/* are served under the app
; origin, never on a second origin: a request is accepted iff its path has
; one of those prefixes AND its origin equals the app origin. Everything
; else is a refusal.
; -
; THE SPA REWRITE EXCEPTION. The SPA rewrites unknown paths to the app
; shell, but never /live/*, /api/*, nor an asset prefix: the list
; SPA_EXEMPT_PREFIXES names what the rewriter must leave alone.
; -
; THE COOKIE LAW. The session cookie is SameSite=Lax, first-party only. A
; foreign origin can never embed the view: can_embed(foreign) is false.
; -
; THE WS LAW. A WebSocket upgrade is allowed on /live/* only: the live view
; stream. An upgrade on /api/browser/* or anywhere else is refused.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserProxy;

use t27os::browser_pod::starts_with;
use t27os::browser_pod::bytes_same;

; --- 1. Constants -----------------------------------------------------------------------

pub const APP_ORIGIN : string = "https://app.t27.ai";

pub const LIVE_PREFIX : string = "/live/";
pub const BROWSER_API_PREFIX : string = "/api/browser/";

pub const SPA_EXEMPT_PREFIXES : [3]string = [
    "/live/",
    "/api/",
    "/assets/",
];

pub const COOKIE_NAME : string = "t27-browser-session";
pub const COOKIE_SAMESITE : string = "Lax";

; Refusal codes
pub const R_OK : u32 = 0;
pub const R_FOREIGN_ORIGIN : u32 = 403;
pub const R_PATH_NOT_PROXIED : u32 = 404;
pub const R_WS_UPGRADE_REFUSED : u32 = 426;

; --- 2. String helpers ---------------------------------------------------------------------

; starts_with and bytes_same live in browser_pod.t27 (one body, imported above).

/// True when the path carries one of the two proxied prefixes.
pub fn path_is_proxied(path : string) -> bool {
    if (starts_with(path, LIVE_PREFIX)) { return true; }
    return starts_with(path, BROWSER_API_PREFIX);
}

; --- 3. Same-origin admission ----------------------------------------------------------------

/// A request is accepted iff path is /live/* or /api/browser/* AND origin
/// equals the app origin. Anything else is refused, with the reason.
pub fn proxy_refusal(path : string, origin : string) -> u32 {
    if (!path_is_proxied(path)) { return R_PATH_NOT_PROXIED; }
    if (!bytes_same(origin, APP_ORIGIN)) { return R_FOREIGN_ORIGIN; }
    return R_OK;
}

/// Liveness of the two laws together, for guards that need a bool.
pub fn proxy_accepts(path : string, origin : string) -> bool {
    return proxy_refusal(path, origin) == R_OK;
}

; --- 4. SPA rewrite exception -------------------------------------------------------------------

/// The SPA rewriter must leave these paths alone: true when the path starts
/// with any SPA_EXEMPT_PREFIXES entry.
pub fn spa_exempt(path : string) -> bool {
    var ii : usize = 0;
    while (ii < 3) {
        if (starts_with(path, SPA_EXEMPT_PREFIXES[ii])) { return true; }
        ii = ii + 1;
    }
    return false;
}

/// A path the rewriter may claim: not proxied and not exempt.
pub fn spa_may_rewrite(path : string) -> bool {
    if (spa_exempt(path)) { return false; }
    return !path_is_proxied(path);
}

; --- 5. Cookie law -------------------------------------------------------------------------------

/// The session cookie is first-party SameSite=Lax: an origin may embed the
/// app only when it IS the app origin.
pub fn can_embed(origin : string) -> bool {
    return bytes_same(origin, APP_ORIGIN);
}

/// SameSite=Lax on the session cookie, never None, never Strict-for-view.
pub fn cookie_mode_ok(samesite : string) -> bool {
    return bytes_same(samesite, COOKIE_SAMESITE);
}

; --- 6. WS upgrade law ------------------------------------------------------------------------------

/// A WebSocket upgrade is allowed on /live/* only. /api/browser/* and every
/// other path refuse the upgrade.
pub fn ws_upgrade_refusal(path : string, origin : string) -> u32 {
    if (!bytes_same(origin, APP_ORIGIN)) { return R_FOREIGN_ORIGIN; }
    if (!starts_with(path, LIVE_PREFIX)) { return R_WS_UPGRADE_REFUSED; }
    return R_OK;
}

invariant same_origin_only {
    assert proxy_accepts("/live/s1?t=tok", APP_ORIGIN);
    assert proxy_accepts("/api/browser/tabs", APP_ORIGIN);
    assert(!proxy_accepts("/live/s1?t=tok", "https://evil.example"));
    assert(!proxy_accepts("/other/path", APP_ORIGIN));
    assert(proxy_refusal("/other/path", "https://evil.example") == R_PATH_NOT_PROXIED);
    assert(proxy_refusal("/live/s1?t=tok", "http://app.t27.ai") == R_FOREIGN_ORIGIN);
}

invariant ws_upgrades_live_only {
    assert ws_upgrade_refusal("/live/s1", APP_ORIGIN) == R_OK;
    assert ws_upgrade_refusal("/api/browser/tabs", APP_ORIGIN) == R_WS_UPGRADE_REFUSED;
    assert ws_upgrade_refusal("/live/s1", "https://evil.example") == R_FOREIGN_ORIGIN;
    assert ws_upgrade_refusal("/", APP_ORIGIN) == R_WS_UPGRADE_REFUSED;
}

invariant lax_first_party_cookies {
    assert cookie_mode_ok("Lax");
    assert(!cookie_mode_ok("None"));
    assert(!cookie_mode_ok("Strict"));
    assert can_embed(APP_ORIGIN);
    assert(!can_embed("https://evil.example"));
    assert(!can_embed(""));
}

test proxied_paths_by_prefix_only {
    assert(path_is_proxied("/live/abc"));
    assert(path_is_proxied("/api/browser/session"));
    assert(!path_is_proxied("/api/other"));
    assert(!path_is_proxied("/livex/s1"));
    assert(!path_is_proxied("/api/browserx/tabs"));
    assert(!path_is_proxied(""));
}

test spa_rewrite_exemptions_held {
    assert(spa_exempt("/live/s1"));
    assert(spa_exempt("/api/browser/tabs"));
    assert(spa_exempt("/api/anything"));
    assert(spa_exempt("/assets/app.js"));
    assert(!spa_exempt("/help/page"));
    assert(!spa_exempt("/dashboard"));
    assert(spa_may_rewrite("/help/page"));
    assert(!spa_may_rewrite("/live/s1"));
    assert(!spa_may_rewrite("/api/browser/tabs"));
    assert(!spa_may_rewrite("/assets/app.js"));
}

test acceptance_needs_both_prefix_and_origin {
    assert(proxy_accepts("/live/s9?t=k", APP_ORIGIN));
    assert(!proxy_accepts("/live/s9?t=k", "https://other.t27.ai"));
    assert(!proxy_accepts("/api/browser/logins", "https://evil.example"));
    assert(proxy_refusal("/api/browser/logins", "https://evil.example") == R_FOREIGN_ORIGIN);
    assert(proxy_accepts("/api/browser/sites", APP_ORIGIN));
}
