// SPDX-License-Identifier: Apache-2.0
// specs/t27os/native_log.t27 -- the durable session event log of the T27 OS native line
// (Refs #13212, FR-003): the BYTES of an append-only log and the law that recovers it after a
// restart. The file calls belong to native_host.t27 (tmp file, then rename); this spec owns the
// framing and the judgement.
//
// ONE EVENT IS ONE LINE:  E <seq> <kind> <plen> <hash> <escaped payload>\n
//   seq   1, 2, 3 ... with no gap; a line whose seq is not the expected one ends recovery
//   kind  EV_USER_INPUT .. EV_SESSION_STATE (1..6)
//   plen  the payload length before escaping; hash = text_hash of the unescaped payload
//   the payload escapes LF as \n, CR as \r and the backslash as \\ so a line never holds a raw LF
// A line is COMPLETE only if it ends in LF, its fields parse, its payload unescapes, its length and
// hash match and its seq is the next one. The first line that is not complete is a torn tail:
// recover keeps every complete event before it and reports valid_len, the byte length of that good
// prefix. Nothing after a bad line is trusted (the log only ever grows at its end).
//
// APPEND IS A REWRITE: append_image builds good prefix + new line. The host writes that image to a
// temporary file and renames it over the log, so a crash leaves either the old log or the new one,
// and a torn tail is dropped by the next append. No compaction: a log past LOG_MAX refuses to grow.
//
// WHAT NEVER GOES IN A PAYLOAD: request bytes (they may hold a bearer header). The provider_request
// payload is the model name and max_tokens; an error payload is a fixed class word.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osNativeLog;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::chat_log::text_hash;

// ---- constants ---------------------------------------------------------------------------------------------

pub const EV_USER_INPUT : u32 = 1;
pub const EV_PROVIDER_REQUEST : u32 = 2;
pub const EV_PROVIDER_RESPONSE : u32 = 3;
pub const EV_ERROR : u32 = 4;
pub const EV_TOKEN_USAGE : u32 = 5;
pub const EV_SESSION_STATE : u32 = 6;
pub const KIND_MAX : u32 = 6;

pub const ST_OPEN : u32 = 0;
pub const ST_ACTIVE : u32 = 1;
pub const ST_IDLE : u32 = 2;
pub const ST_CLOSED : u32 = 3;
pub const ST_NONE : u32 = 255;

pub const PAYLOAD_MAX : usize = 8192;
pub const LOG_MAX : usize = 65536;
pub const LOG_BAD : usize = 4294967295;

pub fn kind_label(k: u32) -> []const u8 {
    if (k == EV_USER_INPUT) { return "user_input"; }
    if (k == EV_PROVIDER_REQUEST) { return "provider_request"; }
    if (k == EV_PROVIDER_RESPONSE) { return "provider_response"; }
    if (k == EV_ERROR) { return "error"; }
    if (k == EV_TOKEN_USAGE) { return "token_usage"; }
    if (k == EV_SESSION_STATE) { return "session_state"; }
    return "unknown";
}

// ---- writing one line --------------------------------------------------------------------------------------

/// Appends the escaped form of src at `at`; returns the cursor. The caller has checked the room.
fn escape_into(out: []u8, at: usize, src: []const u8) -> usize {
    var n : usize = at;
    var i : usize = 0;
    while (i < src.len) {
        const c : u8 = src[i];
        if (c == 10) {
            out[n] = 92;
            out[n + 1] = 110;
            n = n + 2;
        } else if (c == 13) {
            out[n] = 92;
            out[n + 1] = 114;
            n = n + 2;
        } else if (c == 92) {
            out[n] = 92;
            out[n + 1] = 92;
            n = n + 2;
        } else {
            out[n] = c;
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// One event line, newline included. Returns its length; 0 when the kind is unknown, the payload is
/// over PAYLOAD_MAX or `out` has no room (a refusal, never a clipped line).
pub fn format_line(seq: u64, kind: u32, payload: []const u8, out: []u8) -> usize {
    if (kind < 1 or kind > KIND_MAX or payload.len > PAYLOAD_MAX) { return 0; }
    if (out.len < 80 + payload.len * 2) { return 0; }
    var n : usize = put_bytes(out, 0, "E ");
    n = put_dec(out, n, seq);
    n = put_bytes(out, n, " ");
    n = put_dec(out, n, @as(u64, kind));
    n = put_bytes(out, n, " ");
    n = put_dec(out, n, @as(u64, payload.len));
    n = put_bytes(out, n, " ");
    n = put_dec(out, n, text_hash(payload));
    n = put_bytes(out, n, " ");
    n = escape_into(out, n, payload);
    out[n] = 10;
    return n + 1;
}

/// The new file image: the good prefix old[0..valid_len] then `line`. Returns its length; 0 when the
/// result would pass LOG_MAX (no compaction in this line) or `out` is too short.
pub fn append_image(old: []const u8, valid_len: usize, line: []const u8, out: []u8) -> usize {
    if (valid_len > old.len or line.len == 0) { return 0; }
    const total : usize = valid_len + line.len;
    if (total > LOG_MAX or total > out.len) { return 0; }
    var i : usize = 0;
    while (i < valid_len) {
        out[i] = old[i];
        i = i + 1;
    }
    var j : usize = 0;
    while (j < line.len) {
        out[valid_len + j] = line[j];
        j = j + 1;
    }
    return total;
}

/// Extends an in-memory image in place: formats the event at img[len..] and returns the new length; 0 when
/// the event is refused or the image would pass LOG_MAX (img[len..] may then hold junk the caller ignores).
/// The durable write stays the host's: it writes the whole image to a temporary file and renames it.
pub fn push_event(img: []u8, len: usize, seq: u64, kind: u32, payload: []const u8) -> usize {
    if (len > img.len) { return 0; }
    const n : usize = format_line(seq, kind, payload, img[len..img.len]);
    if (n == 0 or len + n > LOG_MAX) { return 0; }
    return len + n;
}

// ---- reading one line --------------------------------------------------------------------------------------

pub struct Num {
    v: u64,
    next: usize,
    ok: bool,
}

/// A decimal field at `at`, which must be followed by one space; next is the index after that space.
fn read_dec(buf: []const u8, at: usize) -> Num {
    var r : Num = Num { v: 0, next: at, ok: false };
    var i : usize = at;
    var d : u32 = 0;
    while (i < buf.len and d < 19 and buf[i] >= 48 and buf[i] <= 57) {
        r.v = r.v * 10 + @as(u64, buf[i] - 48);
        d = d + 1;
        i = i + 1;
    }
    if (d == 0 or i >= buf.len or buf[i] != 32) { return r; }
    r.ok = true;
    r.next = i + 1;
    return r;
}

/// Decodes the escaped bytes buf[from..to] into scratch; the decoded length, or LOG_BAD on an unknown
/// escape or a scratch that is too short.
fn unescape(buf: []const u8, from: usize, to: usize, scratch: []u8) -> usize {
    var w : usize = 0;
    var i : usize = from;
    while (i < to) {
        if (w >= scratch.len) { return LOG_BAD; }
        const c : u8 = buf[i];
        if (c == 92) {
            if (i + 1 >= to) { return LOG_BAD; }
            const e : u8 = buf[i + 1];
            if (e == 110) {
                scratch[w] = 10;
            } else if (e == 114) {
                scratch[w] = 13;
            } else if (e == 92) {
                scratch[w] = 92;
            } else {
                return LOG_BAD;
            }
            i = i + 2;
        } else {
            scratch[w] = c;
            i = i + 1;
        }
        w = w + 1;
    }
    return w;
}

pub struct LineInfo {
    ok: bool,
    seq: u64,
    kind: u32,
    plen: usize,
    end: usize,
}

/// Judges the line that starts at `at`. When ok, scratch[0..plen] holds the unescaped payload and
/// `end` is the index after the line's LF.
pub fn parse_line(buf: []const u8, at: usize, expect_seq: u64, scratch: []u8) -> LineInfo {
    var li : LineInfo = LineInfo { ok: false, seq: 0, kind: 0, plen: 0, end: at };
    if (at + 2 > buf.len or buf[at] != 69 or buf[at + 1] != 32) { return li; }
    const a : Num = read_dec(buf, at + 2);
    if (a.ok == false or a.v != expect_seq) { return li; }
    const b : Num = read_dec(buf, a.next);
    if (b.ok == false or b.v < 1 or b.v > @as(u64, KIND_MAX)) { return li; }
    const c : Num = read_dec(buf, b.next);
    if (c.ok == false or c.v > @as(u64, PAYLOAD_MAX)) { return li; }
    const d : Num = read_dec(buf, c.next);
    if (d.ok == false) { return li; }
    var e : usize = d.next;
    while (e < buf.len and buf[e] != 10) { e = e + 1; }
    if (e >= buf.len) { return li; }
    const got : usize = unescape(buf, d.next, e, scratch);
    if (got == LOG_BAD or @as(u64, got) != c.v) { return li; }
    if (text_hash(scratch[0..got]) != d.v) { return li; }
    li.ok = true;
    li.seq = a.v;
    li.kind = @intCast(b.v);
    li.plen = got;
    li.end = e + 1;
    return li;
}

// ---- recovery ----------------------------------------------------------------------------------------------

pub struct Recovered {
    count: u32,
    next_seq: u64,
    valid_len: usize,
    last_state: u32,
}

/// The state a session_state payload names: its first byte as a digit 0..3; ST_NONE for anything else.
pub fn state_from_payload(p: []const u8) -> u32 {
    if (p.len != 1 or p[0] < 48 or p[0] > 51) { return ST_NONE; }
    return @as(u32, p[0] - 48);
}

/// The payload of a session_state event: one digit. Returns 1; 0 when the state is not 0..3.
pub fn state_payload(st: u32, out: []u8) -> usize {
    if (st > ST_CLOSED or out.len < 1) { return 0; }
    out[0] = @intCast(48 + st);
    return 1;
}

/// Walks the log from its first byte and keeps every complete event up to the first bad line.
pub fn recover(buf: []const u8, scratch: []u8) -> Recovered {
    var r : Recovered = Recovered { count: 0, next_seq: 1, valid_len: 0, last_state: ST_NONE };
    while (r.valid_len < buf.len) {
        const li : LineInfo = parse_line(buf, r.valid_len, r.next_seq, scratch);
        if (li.ok == false) { return r; }
        if (li.kind == EV_SESSION_STATE) {
            r.last_state = state_from_payload(scratch[0..li.plen]);
        }
        r.count = r.count + 1;
        r.next_seq = r.next_seq + 1;
        r.valid_len = li.end;
    }
    return r;
}

/// A session is continuable when it has events and was not closed. A crash in the middle of a turn
/// leaves ST_ACTIVE; that is continuable too.
pub fn continuable(r: Recovered) -> bool {
    return r.count > 0 and r.last_state != ST_CLOSED;
}

pub struct EventView {
    ok: bool,
    kind: u32,
    seq: u64,
    len: usize,
}

/// The n-th complete event (from 0): its kind, seq and payload (copied into `out`).
pub fn nth_event(buf: []const u8, scratch: []u8, n: u32, out: []u8) -> EventView {
    var v : EventView = EventView { ok: false, kind: 0, seq: 0, len: 0 };
    var at : usize = 0;
    var seq : u64 = 1;
    var i : u32 = 0;
    while (at < buf.len) {
        const li : LineInfo = parse_line(buf, at, seq, scratch);
        if (li.ok == false) { return v; }
        if (i == n) {
            if (li.plen > out.len) { return v; }
            var k : usize = 0;
            while (k < li.plen) {
                out[k] = scratch[k];
                k = k + 1;
            }
            v.ok = true;
            v.kind = li.kind;
            v.seq = li.seq;
            v.len = li.plen;
            return v;
        }
        at = li.end;
        seq = seq + 1;
        i = i + 1;
    }
    return v;
}

// ---- payload formats (no secret can enter through these) ---------------------------------------------------

/// "model=<model> max_tokens=<n>": the provider_request payload. Returns its length; 0 on no room.
pub fn request_payload(model: []const u8, max_tokens: u32, out: []u8) -> usize {
    if (out.len < model.len + 40) { return 0; }
    var n : usize = put_bytes(out, 0, "model=");
    n = put_bytes(out, n, model);
    n = put_bytes(out, n, " max_tokens=");
    return put_dec(out, n, @as(u64, max_tokens));
}

/// "prompt=<n> completion=<n>": the token_usage payload.
pub fn usage_payload(prompt_tokens: u64, completion_tokens: u64, out: []u8) -> usize {
    if (out.len < 48) { return 0; }
    var n : usize = put_bytes(out, 0, "prompt=");
    n = put_dec(out, n, prompt_tokens);
    n = put_bytes(out, n, " completion=");
    return put_dec(out, n, completion_tokens);
}

// ---- the tests ---------------------------------------------------------------------------------------------

test "a_line_round_trips_with_newlines_and_backslashes_in_the_payload" {
    var line : [256]u8 = undefined;
    const n : usize = format_line(1, EV_USER_INPUT, "a\nb\\c\rd", line[0..256]);
    assert n > 0;
    assert line[n - 1] == 10;
    var i : usize = 0;
    var raw_lf : u32 = 0;
    while (i + 1 < n) {
        if (line[i] == 10) { raw_lf = raw_lf + 1; }
        i = i + 1;
    }
    assert raw_lf == 0;
    var scratch : [64]u8 = undefined;
    const li : LineInfo = parse_line(line[0..n], 0, 1, scratch[0..64]);
    assert li.ok;
    assert li.kind == EV_USER_INPUT;
    assert li.plen == 7;
    assert scratch[1] == 10 and scratch[3] == 92 and scratch[5] == 13;
    assert li.end == n;
}

test "an_empty_payload_is_a_complete_event" {
    var line : [128]u8 = undefined;
    const n : usize = format_line(1, EV_ERROR, "", line[0..128]);
    var scratch : [8]u8 = undefined;
    const li : LineInfo = parse_line(line[0..n], 0, 1, scratch[0..8]);
    assert li.ok;
    assert li.plen == 0;
}

test "an_unknown_kind_or_an_oversize_payload_is_refused" {
    var line : [128]u8 = undefined;
    assert format_line(1, 0, "x", line[0..128]) == 0;
    assert format_line(1, 7, "x", line[0..128]) == 0;
    assert format_line(1, EV_ERROR, "x", line[0..40]) == 0;
}

test "recovery_keeps_complete_events_and_drops_a_torn_tail" {
    var l1 : [128]u8 = undefined;
    var l2 : [128]u8 = undefined;
    var l3 : [128]u8 = undefined;
    const n1 : usize = format_line(1, EV_SESSION_STATE, "0", l1[0..128]);
    const n2 : usize = format_line(2, EV_USER_INPUT, "hello", l2[0..128]);
    const n3 : usize = format_line(3, EV_PROVIDER_RESPONSE, "world", l3[0..128]);
    var img1 : [512]u8 = undefined;
    var img2 : [512]u8 = undefined;
    var img3 : [512]u8 = undefined;
    const m1 : usize = append_image(img1[0..0], 0, l1[0..n1], img1[0..512]);
    const m2 : usize = append_image(img1[0..m1], m1, l2[0..n2], img2[0..512]);
    const m3 : usize = append_image(img2[0..m2], m2, l3[0..n3], img3[0..512]);
    assert m3 == n1 + n2 + n3;
    var scratch : [64]u8 = undefined;
    const whole : Recovered = recover(img3[0..m3], scratch[0..64]);
    assert whole.count == 3;
    assert whole.next_seq == 4;
    assert whole.valid_len == m3;
    // tear the last line: cut 4 bytes, so its LF is gone
    const torn : Recovered = recover(img3[0..m3 - 4], scratch[0..64]);
    assert torn.count == 2;
    assert torn.next_seq == 3;
    assert torn.valid_len == m2;
}

test "a_flipped_payload_byte_fails_the_hash_and_ends_recovery" {
    var l1 : [128]u8 = undefined;
    const n1 : usize = format_line(1, EV_USER_INPUT, "hello", l1[0..128]);
    l1[n1 - 2] = 88;
    var scratch : [64]u8 = undefined;
    const r : Recovered = recover(l1[0..n1], scratch[0..64]);
    assert r.count == 0;
    assert r.valid_len == 0;
}

test "a_gap_in_the_sequence_ends_recovery" {
    var l1 : [128]u8 = undefined;
    var l3 : [128]u8 = undefined;
    const n1 : usize = format_line(1, EV_USER_INPUT, "a", l1[0..128]);
    const n3 : usize = format_line(3, EV_USER_INPUT, "c", l3[0..128]);
    var img : [512]u8 = undefined;
    var img2 : [512]u8 = undefined;
    const m1 : usize = append_image(img[0..0], 0, l1[0..n1], img[0..512]);
    const m2 : usize = append_image(img[0..m1], m1, l3[0..n3], img2[0..512]);
    var scratch : [64]u8 = undefined;
    const r : Recovered = recover(img2[0..m2], scratch[0..64]);
    assert r.count == 1;
    assert r.next_seq == 2;
}

test "an_append_after_a_torn_tail_drops_the_tail_and_keeps_the_next_seq" {
    var l1 : [128]u8 = undefined;
    var l2 : [128]u8 = undefined;
    const n1 : usize = format_line(1, EV_USER_INPUT, "first", l1[0..128]);
    const n2 : usize = format_line(2, EV_USER_INPUT, "second", l2[0..128]);
    var img : [512]u8 = undefined;
    var img2 : [512]u8 = undefined;
    const m1 : usize = append_image(img[0..0], 0, l1[0..n1], img[0..512]);
    const m2 : usize = append_image(img[0..m1], m1, l2[0..n2], img2[0..512]);
    var scratch : [64]u8 = undefined;
    const torn : Recovered = recover(img2[0..m2 - 3], scratch[0..64]);
    assert torn.count == 1;
    var l2b : [128]u8 = undefined;
    const n2b : usize = format_line(torn.next_seq, EV_USER_INPUT, "second again", l2b[0..128]);
    var img3 : [512]u8 = undefined;
    const m3 : usize = append_image(img2[0..m2 - 3], torn.valid_len, l2b[0..n2b], img3[0..512]);
    const r : Recovered = recover(img3[0..m3], scratch[0..64]);
    assert r.count == 2;
    assert r.valid_len == m3;
}

test "the_n_th_event_is_readable_with_its_kind_and_payload" {
    var l1 : [128]u8 = undefined;
    var l2 : [128]u8 = undefined;
    const n1 : usize = format_line(1, EV_USER_INPUT, "ping", l1[0..128]);
    const n2 : usize = format_line(2, EV_PROVIDER_RESPONSE, "pong", l2[0..128]);
    var img : [512]u8 = undefined;
    var img2 : [512]u8 = undefined;
    const m1 : usize = append_image(img[0..0], 0, l1[0..n1], img[0..512]);
    const m2 : usize = append_image(img[0..m1], m1, l2[0..n2], img2[0..512]);
    var scratch : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const e : EventView = nth_event(img2[0..m2], scratch[0..64], 1, out[0..64]);
    assert e.ok;
    assert e.kind == EV_PROVIDER_RESPONSE;
    assert e.seq == 2;
    assert e.len == 4;
    assert out[0] == 112 and out[3] == 103;
    assert nth_event(img2[0..m2], scratch[0..64], 2, out[0..64]).ok == false;
}

test "a_session_is_continuable_unless_closed_or_empty" {
    var l1 : [128]u8 = undefined;
    var l2 : [128]u8 = undefined;
    var sp : [4]u8 = undefined;
    assert state_payload(ST_ACTIVE, sp[0..4]) == 1;
    const n1 : usize = format_line(1, EV_SESSION_STATE, sp[0..1], l1[0..128]);
    var scratch : [64]u8 = undefined;
    const active : Recovered = recover(l1[0..n1], scratch[0..64]);
    assert active.last_state == ST_ACTIVE;
    assert continuable(active);
    assert state_payload(ST_CLOSED, sp[0..4]) == 1;
    const n2 : usize = format_line(1, EV_SESSION_STATE, sp[0..1], l2[0..128]);
    const closed : Recovered = recover(l2[0..n2], scratch[0..64]);
    assert closed.last_state == ST_CLOSED;
    assert continuable(closed) == false;
    const empty : Recovered = recover(l1[0..0], scratch[0..64]);
    assert continuable(empty) == false;
    assert state_payload(9, sp[0..4]) == 0;
}

test "the_log_refuses_to_grow_past_its_cap" {
    var line : [64]u8 = undefined;
    const n : usize = format_line(1, EV_ERROR, "x", line[0..64]);
    var old : [16]u8 = undefined;
    var out : [64]u8 = undefined;
    assert append_image(old[0..16], 16, line[0..n], out[0..64]) == 0;
    assert append_image(old[0..16], 17, line[0..n], out[0..64]) == 0;
}

test "push_event_extends_an_image_in_place_and_recovery_reads_it_back" {
    var img : [512]u8 = undefined;
    var scratch : [64]u8 = undefined;
    var len : usize = push_event(img[0..512], 0, 1, EV_USER_INPUT, "hi");
    assert len > 0;
    const l1 : usize = len;
    len = push_event(img[0..512], len, 2, EV_PROVIDER_RESPONSE, "yo");
    assert len > l1;
    const r : Recovered = recover(img[0..len], scratch[0..64]);
    assert r.count == 2;
    assert r.valid_len == len;
    assert push_event(img[0..512], 600, 3, EV_ERROR, "x") == 0;
    assert push_event(img[0..512], len, 3, 0, "x") == 0;
    assert push_event(img[0..100], len, 3, EV_ERROR, "x") == 0;
}

test "request_and_usage_payloads_carry_no_request_bytes" {
    var out : [96]u8 = undefined;
    const n : usize = request_payload("m-1", 64, out[0..96]);
    const want : []const u8 = "model=m-1 max_tokens=64";
    assert n == want.len;
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i];
        i = i + 1;
    }
    const u : usize = usage_payload(22, 9, out[0..96]);
    assert u == 24;
}
