// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_chats.t27 -- the right dock of T27 OS: a chat with the Queen.
; Owner, 2026-10-23: "make a sidebar on the right with a chat in it, so you can talk with the Queen".
; The Queen is a real agent cell (agents.t27 AGENT_QUEEN, bin "queen"); the one chat the window had for
; her side of the glass was the CONTROL DASHBOARD, which only shows the swarm's files -- it never let the
; user say anything to her. Her CLI chats live in panes owned by the PTY server, like every other agent,
; so the dock is the SAME model placed differently:
;   the dock  a column QP_W wide on the right edge (the panel regime of queen.t27: it opens at qp_left, and
;             the content math never forks -- glass just adds the dock into the one panel flag it passes on);
;   the chat  the pane grid of the Queen's session, resized to the dock and read through the same pty
;             polling the content pane uses; the transcript IS her terminal;
;   the input a one-line box at the foot. What is typed is collected in the dock's own buffer; Enter sends
;             the buffer's bytes plus CR into her pane (pty_client client_keys) and clears it. While the
;             dock is open the window's keystrokes go to the buffer, not straight to the pane.
; Decisions that live here, all pure: geometry, the dock's grid dims, the buffer edit (typing, backspace,
; paste with the printable cap), the send framing, the session pick, and who wins the one right dock.
; The host calls (client_keys, client_resize) and the drawing belong to glass_window.t27.
; The dock excludes the other right panels: opening one closes the other; exactly one thing docked right.

module T27osQueenChats;

use t27os::queen::QP_W;
use t27os::queen::QP_PAD;
use t27os::queen::qp_left;
use t27os::agents::AGENT_QUEEN;
use t27os::agents::AGENT_DSH;
use t27os::term_pane::TP_CELL_W;
use t27os::term_pane::TP_LINE_H;
use t27os::term_pane::TP_COLS_MIN;
use t27os::term_pane::TP_COLS_MAX;
use t27os::term_pane::TP_ROWS_MIN;
use t27os::term_pane::TP_ROWS_MAX;
use t27os::pty_proto::RE_OK;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---------------------------------------------------------------- geometry

pub const RC_TITLE : str = "QUEEN CHAT";
pub const RC_TITLE_Y : f64 = 20.0;
pub const RC_TERM_PAD : f64 = 12.0;
pub const RC_TERM_TOP : f64 = 44.0;
pub const RC_IN_H : f64 = 40.0;
pub const RC_IN_GAP : f64 = 12.0;
pub const RC_TEXT_MAX : usize = 200;
pub const RC_CR : u8 = 13;

/// The dock's left edge: the panel regime (the same edge and width the other right panels use).
pub fn rc_left(sw : f64) -> f64 { return qp_left(sw); }

/// The transcript rectangle (`top` = the top of the workspace, `foot` = the height of the status bar):
/// between the title and the input line, never under either.
pub fn rc_term_rect(sw : f64, sh : f64, top : f64, foot : f64, out : []f64) -> bool {
    out[0] = rc_left(sw) + RC_TERM_PAD;
    out[1] = top + RC_TERM_TOP;
    out[2] = QP_W - 2.0 * RC_TERM_PAD;
    out[3] = sh - foot - out[1] - RC_IN_GAP - RC_IN_H - QD_ROW_H;
    return out[2] > 0.0 and out[3] >= 4.0 * TP_LINE_H;
}

/// The delivery row (P0, owner 2026-11-03): between the transcript and the input line, the delivery status on
/// the left and the Send button on the right, so a press that goes nowhere is never silent.
pub const QD_ROW_H : f64 = 26.0;
pub const QD_BTN_W : f64 = 64.0;

pub fn qd_row_rect(sw : f64, sh : f64, top : f64, foot : f64, out : []f64) -> bool {
    out[0] = rc_left(sw) + QP_PAD;
    out[1] = sh - foot - RC_IN_GAP - RC_IN_H - QD_ROW_H;
    out[2] = QP_W - 2.0 * QP_PAD;
    out[3] = QD_ROW_H;
    return out[2] > QD_BTN_W;
}

/// The Send button: the right end of the delivery row, inset 2 at the top and the foot.
pub fn qd_send_rect(sw : f64, sh : f64, top : f64, foot : f64, out : []f64) -> bool {
    if (qd_row_rect(sw, sh, top, foot, out) == false) { return false; }
    out[0] = out[0] + out[2] - QD_BTN_W;
    out[1] = out[1] + 2.0;
    out[2] = QD_BTN_W;
    out[3] = QD_ROW_H - 4.0;
    return true;
}

pub fn on_qd_send(x : f64, y : f64, sw : f64, sh : f64, top : f64, foot : f64) -> bool {
    var r : [4]f64 = undefined;
    if (qd_send_rect(sw, sh, top, foot, r[0..4]) == false) { return false; }
    return x >= r[0] and x < r[0] + r[2] and y >= r[1] and y < r[1] + r[3];
}

/// The input line rectangle: full panel width minus the pad, at the foot above the status bar.
pub fn rc_input_rect(sw : f64, sh : f64, top : f64, foot : f64, out : []f64) -> bool {
    out[0] = rc_left(sw) + QP_PAD;
    out[1] = sh - foot - RC_IN_GAP - RC_IN_H;
    out[2] = QP_W - 2.0 * QP_PAD;
    out[3] = RC_IN_H;
    return out[2] > 0.0;
}

pub fn on_input(x : f64, y : f64, sw : f64, sh : f64, top : f64, foot : f64, ln : usize) -> bool {
    var r : [4]f64 = undefined;
    if (rc_input_rect(sw, sh, top, foot, r[0..4]) == false or y < r[1] or y >= r[1] + r[3] or x < r[0] or x >= r[0] + r[2]) { return false; }
    return x >= r[0] + @as(f64, @floatFromInt(ln)) * 7.2 or y < r[1] + r[3] * 0.5;
}

// ---------------------------------------------------------------- the dock's grid dims

/// The pane's cols at the dock: the transcript width divided by the cell width, clamped to the observed
/// terminal bounds. The pane is resized to these while the dock is open, so her terminal wraps for it.
pub fn rc_grid_cols(w : f64) -> u32 {
    if (w < 0.0) { return TP_COLS_MIN; }
    var c : u32 = (w / TP_CELL_W) as u32;
    if (c < TP_COLS_MIN) { c = TP_COLS_MIN; }
    if (c > TP_COLS_MAX) { c = TP_COLS_MAX; }
    return c;
}

/// The pane's rows at the dock: the transcript height divided by the line height, clamped the same way.
pub fn rc_grid_rows(h : f64) -> u32 {
    if (h < 0.0) { return TP_ROWS_MIN; }
    var r : u32 = (h / TP_LINE_H) as u32;
    if (r < TP_ROWS_MIN) { r = TP_ROWS_MIN; }
    if (r > TP_ROWS_MAX) { r = TP_ROWS_MAX; }
    return r;
}

// ---------------------------------------------------------------- the input buffer

/// A typed unit joins only when it prints: bytes 20h..7eh (the dock input, unlike the pane, holds no
/// control sequences itself).
pub fn rc_takes(unit : u8) -> bool { return unit >= 32 and unit < 127; }

/// The buffer keeps the text at 0 and its length in one byte at RC_TEXT_MAX; returns the new length.
pub fn rc_type(t : []u8, unit : u8) -> usize {
    var n : usize = t[RC_TEXT_MAX] as usize;
    if (rc_takes(unit) == false or n >= RC_TEXT_MAX) { return n; }
    t[n] = unit;
    n = n + 1;
    t[RC_TEXT_MAX] = n as u8;
    return n;
}

/// Backspace removes one printing unit (the bytes before the length), never the length byte itself.
pub fn rc_back(t : []u8) -> usize {
    var n : usize = t[RC_TEXT_MAX] as usize;
    if (n == 0) { return 0; }
    n = n - 1;
    t[n] = 0;
    t[RC_TEXT_MAX] = n as u8;
    return n;
}

/// The send payload: the buffer, then CR. t must hold the whole payload when it returns.
pub fn rc_payload(t : []u8) -> usize {
    var n : usize = t[RC_TEXT_MAX] as usize;
    t[n] = RC_CR;
    return n + 1;
}

/// After a send (or a close) the line is empty again: the bytes and the CR byte the send left behind
/// are zeroed, and the length returns to zero.
pub fn rc_clear(t : []u8) -> void {
    var i : usize = t[RC_TEXT_MAX] as usize + 1;
    t[RC_TEXT_MAX] = 0;
    while (i > 0) {
        i = i - 1;
        t[i] = 0;
    }
}

// ---------------------------------------------------------------- the session and the one dock

/// The chat follows the Queen's session: the index carries the Queen when it is open, else none -- glass
/// opens one in the chosen space (windows.t27 add_session) before the dock shows anything.
pub fn rc_session_good(cur : u32, agent : u32) -> bool {
    return cur != 4294967295 and agent == AGENT_QUEEN;
}

/// Who wins the one right dock: the chat excludes every other right panel, and a panel open keeps it out.
pub fn rc_wins(queenpanel : bool, doctor : bool, keys : bool, profile : bool) -> bool {
    if (queenpanel or doctor or keys or profile) { return false; }
    return true;
}

/// Opening the dock is one bit; pressing again closes it.
pub fn rc_flip(open : bool) -> bool { return open == false; }

/// The header switch: a QUEEN CHAT box left of the page switch (dash.t27 switch_x), same size, so the
/// right cluster reads QUEEN CHAT beside the page cycle and the profile circle stays put.
pub fn qc_left_of_switch(switch_l : f64) -> f64 { return switch_l - 8.0 - QC_W; }
pub fn on_qc_switch(x : f64, y : f64, switch_l : f64, ws_top : f64) -> bool {
    const l : f64 = qc_left_of_switch(switch_l);
    return x >= l and x <= l + QC_W and y >= ws_top + 11.0 and y <= ws_top + 33.0;
}
pub const QC_W : f64 = 84.0;

/// The foot link: QUEEN CHAT in the status bar's right end, left of KEYS (statusbar.t27), same width as the header box.
pub const QC_LINK_W : f64 = 84.0;

/// Owner, 2026-11-03: opening the chat must not move the person off the screen they are on (DSH included). The dock
/// owns the Queen's session apart from the selected one: it follows the selected session when that already is a Queen
/// chat (the centre then yields to the dock, as before), else the first Queen chat of the space, which glass opens when
/// the space has none. Nothing here, and nothing in the open handlers, writes the selected session.
pub fn rc_pick(cur : u32, cur_agent : u32, first_queen : u32) -> u32 {
    if (cur != 4294967295 and cur_agent == AGENT_QUEEN) { return cur; }
    return first_queen;
}

/// The dock streams its pane while it is open and has a session of its own, on any screen.
pub fn rc_live(dock_open : bool, rcs : u32) -> bool {
    return dock_open and rcs != 4294967295;
}

/// The centre column gives its terminal up only when the dock shows the very session it would show.
pub fn rc_hides_centre(dock_open : bool, cur : u32, rcs : u32) -> bool {
    return rc_live(dock_open, rcs) and cur == rcs;
}

/// The dock is live only while the chat follows the Queen's session.
pub fn rc_docked(dock_open : bool, cur : u32, agent : u32) -> bool {
    if (dock_open == false) { return false; }
    return rc_session_good(cur, agent);
}

/// A paste joins its printable bytes and stops at the cap; returns the length after.
pub fn rc_paste(t : []u8, clip : []const u8, m : usize) -> usize {
    var i : usize = 0;
    var n : usize = t[RC_TEXT_MAX] as usize;
    while (i < m) {
        if (rc_takes(clip[i]) and n < RC_TEXT_MAX) {
            t[n] = clip[i];
            n = n + 1;
        }
        i = i + 1;
    }
    t[RC_TEXT_MAX] = n as u8;
    return n;
}

// ---------------------------------------------------------------- the delivery of one message (P0, owner 2026-11-03)
//
// "wrote -> sent -> the Queen took it -> an answer appeared" as states the dock can draw. The dock is a view of the
// Queen's terminal pane, so the acknowledgements are the ones that exist there and no more: ACCEPTED means the pane
// server answered the write of every byte into her pty; OUTPUT means her pane produced more than the echo of what was
// sent. Neither is a parsed reply; the Queen program's own words are the transcript above the row. Every refusal
// names its cause and keeps the draft: nothing is ever swallowed.

pub const QD_IDLE : u32 = 0;
pub const QD_SENDING : u32 = 1;
pub const QD_ACCEPTED : u32 = 2;
pub const QD_OUTPUT : u32 = 3;
pub const QD_NO_SERVER : u32 = 4;
pub const QD_NO_PANE : u32 = 5;
pub const QD_WRITE_FAIL : u32 = 6;
pub const QD_EMPTY : u32 = 7;
pub const QD_READY : u32 = 8;

/// Bytes of output after a send that still count as the echo of the send (the typed line, its line end, a redraw).
pub const QD_ECHO_SLACK : usize = 32;

/// The link the dock has right now: no connection to the pane server, a server with no Queen pane (the table is full
/// or her program cannot start), or a live pane.
pub fn qd_link(server_up : bool, link_live : bool, pane_open : bool) -> u32 {
    if (server_up == false) { return QD_NO_SERVER; }
    if (link_live == false or pane_open == false) { return QD_NO_PANE; }
    return QD_READY;
}

/// What a press of Send (or Return) does: nothing typed sends nothing and is no error; a dead link is named and
/// sends nothing; a live link goes on to SENDING.
pub fn qd_decide(len : usize, link : u32) -> u32 {
    if (len == 0) { return QD_EMPTY; }
    if (link != QD_READY) { return link; }
    return QD_SENDING;
}

/// One chunk's answer from the pane server: a frame came back (`n` bytes) and its kind is RE_OK. A frame of
/// RE_ERR (her pane is gone) or no frame at all (timeout, closed socket) is a failure. Until 2026-11-03 glass
/// tested only `n == 0`, so an RE_ERR answer counted as delivered and the draft was erased.
pub fn qd_reply_ok(n : usize, op : u8) -> bool { return n > 0 and op == RE_OK; }

/// The write finished: the pane server answered every chunk, or it did not.
pub fn qd_after_write(ok : bool) -> u32 {
    if (ok) { return QD_ACCEPTED; }
    return QD_WRITE_FAIL;
}

pub fn qd_failed(state : u32) -> bool {
    return state == QD_NO_SERVER or state == QD_NO_PANE or state == QD_WRITE_FAIL;
}

/// The field is cleared only when the pane took the message; every other state keeps the draft.
pub fn qd_clears_draft(state : u32) -> bool { return state == QD_ACCEPTED; }

/// The message number advances once, when a message is accepted; a retry of a refused draft keeps its number.
pub fn qd_next_id(id : u32, state : u32) -> u32 {
    if (state == QD_ACCEPTED) { return id + 1; }
    return id;
}

/// Output after the send beyond the echo of the sent bytes.
pub fn qd_reply_seen(got : usize, sent : usize) -> bool { return got > sent + QD_ECHO_SLACK; }

/// The delivery state after `more` bytes of the pane's output arrived while the state was `state`.
pub fn qd_on_output(state : u32, got : usize, sent : usize) -> u32 {
    if (state == QD_ACCEPTED and qd_reply_seen(got, sent)) { return QD_OUTPUT; }
    return state;
}

/// The button reads Retry after a refusal, Send otherwise.
pub fn qd_retry(state : u32) -> bool { return qd_failed(state); }

/// The row's text. Idle shows the standing link; a delivery shows its stage and message number.
pub fn qd_status_text(out : []u8, state : u32, id : u32, link : u32) -> usize {
    var w : usize = 0;
    if (state == QD_SENDING) {
        w = put_bytes(out, w, "Sending #");
        w = put_dec(out, w, @as(u64, id));
        return put_bytes(out, w, "...");
    }
    if (state == QD_ACCEPTED) {
        w = put_bytes(out, w, "Accepted #");
        w = put_dec(out, w, @as(u64, id));
        return put_bytes(out, w, " by her pane");
    }
    if (state == QD_OUTPUT) {
        w = put_bytes(out, w, "Output after #");
        return put_dec(out, w, @as(u64, id));
    }
    if (state == QD_NO_SERVER) { return put_bytes(out, 0, "NOT SENT: no pane server"); }
    if (state == QD_NO_PANE) { return put_bytes(out, 0, "NOT SENT: no Queen pane"); }
    if (state == QD_WRITE_FAIL) { return put_bytes(out, 0, "NOT SENT: no answer"); }
    if (link == QD_NO_SERVER) { return put_bytes(out, 0, "No link to the pane server"); }
    if (link == QD_NO_PANE) { return put_bytes(out, 0, "No Queen pane on the server"); }
    return put_bytes(out, 0, "Queen pane connected");
}

invariant rc_dock_takes_the_panel_regime : QP_W >= 260.0 and QP_W <= 340.0 and RC_TEXT_MAX == 200;
invariant rc_the_dock_never_swallows_a_control_byte : rc_takes(13) == false and rc_takes(27) == false and rc_takes(32) and rc_takes(126) and rc_takes(127) == false;
invariant rc_input_sits_at_the_foot : RC_IN_H >= 32.0 and RC_IN_GAP >= 8.0;

/// The dock reads the text store region that sits above the profile region (labelled in glass TBO_RC);
/// these numbers fix its layout so the text and the length byte never overlap.
invariant rc_buffer_layout : RC_TEXT_MAX < 512 and RC_TEXT_MAX + 1 <= 512;

// ---------------------------------------------------------------- tests

test the_dock_binds_to_the_panel_geometry {
    const sw : f64 = 1400.0;
    assert rc_left(sw) == qp_left(sw);
    assert QP_W > 0.0;
    var r : [4]f64 = undefined;
    assert rc_term_rect(sw, 700.0, 34.0, 20.0, r[0..4]);
    assert r[0] == sw - QP_W + RC_TERM_PAD and r[2] == QP_W - 2.0 * RC_TERM_PAD;
    assert r[1] == 34.0 + RC_TERM_TOP;
    assert r[3] == 700.0 - 20.0 - 34.0 - RC_TERM_TOP - RC_IN_GAP - RC_IN_H - QD_ROW_H;
    var i : [4]f64 = undefined;
    assert rc_input_rect(sw, 700.0, 34.0, 20.0, i[0..4]);
    assert i[0] == sw - QP_W + QP_PAD and i[2] == QP_W - 2.0 * QP_PAD;
    assert i[1] == 700.0 - 20.0 - RC_IN_GAP - RC_IN_H;
    // the delivery row sits between the transcript and the input
    var d : [4]f64 = undefined;
    assert qd_row_rect(sw, 700.0, 34.0, 20.0, d[0..4]);
    assert d[1] == i[1] - QD_ROW_H and d[3] == QD_ROW_H;
    // transcript, delivery row and input never overlap, and none slides under the status bar
    assert r[1] + r[3] <= d[1];
    assert d[1] + d[3] <= i[1];
    assert i[1] + i[3] <= 700.0 - 20.0;
}

test the_grid_fits_the_dock_and_stays_in_the_observed_bounds {
    const w : f64 = QP_W - 2.0 * RC_TERM_PAD;
    var r : [4]f64 = undefined;
    assert rc_term_rect(1400.0, 700.0, 34.0, 20.0, r[0..4]);
    const c : u32 = rc_grid_cols(r[2]);
    const rows : u32 = rc_grid_rows(r[3]);
    assert c >= TP_COLS_MIN and c <= TP_COLS_MAX;
    assert rows >= TP_ROWS_MIN and rows <= TP_ROWS_MAX;
    assert (c as f64) * TP_CELL_W <= r[2] + TP_CELL_W;
    assert rc_grid_cols(-1.0) == TP_COLS_MIN;
    assert rc_grid_rows(-1.0) == TP_ROWS_MIN;
}

test typing_edits_the_line_and_the_send_frames_it {
    var t : [512]u8 = undefined;
    t[RC_TEXT_MAX] = 0;
    var n : usize = 0;
    n = rc_type(t[0..512], 'h');
    n = rc_type(t[0..512], 'i');
    n = rc_type(t[0..512], '!');
    assert n == 3 and t[0] == 'h' and t[1] == 'i' and t[2] == '!';
    assert rc_payload(t[0..512]) == 4 and t[3] == RC_CR;
    rc_clear(t[0..512]);
    assert t[RC_TEXT_MAX] == 0 and t[3] == 0;
    // control units never join and the cap holds
    assert rc_type(t[0..512], 27) == 0;
    var i : usize = 0;
    while (i < RC_TEXT_MAX) { assert rc_type(t[0..512], 'x') == i + 1; i = i + 1; }
    assert rc_type(t[0..512], 'y') == RC_TEXT_MAX;
    // backspace
    rc_clear(t[0..512]);
    n = rc_type(t[0..512], 'a');
    n = rc_type(t[0..512], 'b');
    n = rc_back(t[0..512]);
    assert n == 1 and t[0] == 'a';
    assert rc_back(t[0..512]) == 0;
    assert rc_back(t[0..512]) == 0;
}

test one_dock_at_a_time_and_the_queen_session_carries_it {
    assert rc_wins(false, false, false, false);
    assert rc_wins(false, false, false, false) and rc_wins(true, false, false, false) == false;
    assert rc_wins(false, true, true, true) == false;
    assert rc_flip(false) and rc_flip(true) == false;
    // the Queen's own number, the centre cell of the comb; index 0 is a real session, none is not
    assert AGENT_QUEEN == 4;
    assert rc_session_good(0, AGENT_QUEEN);
    assert rc_session_good(3, AGENT_QUEEN);
    assert rc_session_good(4294967295, AGENT_QUEEN) == false;
    assert rc_session_good(0, AGENT_QUEEN + 1) == false;
}

test the_header_switch_sits_left_of_the_page_switch_and_the_paste_holds_the_cap {
    // dash.t27 switch_x(1440.0) = 1440.0 - 42.0 - 8.0 - SWITCH_W; the QUEEN CHAT box is its left neighbour
    const l : f64 = qc_left_of_switch(1306.0);
    assert l == 1306.0 - 8.0 - QC_W;
    assert on_qc_switch(l + 1.0, 42.0 + 11.0 + 1.0, 1306.0, 42.0);
    assert on_qc_switch(l - 1.0, 64.0, 1306.0, 42.0) == false;
    assert on_qc_switch(l + 10.0, 42.0 + 33.0 + 1.0, 1306.0, 42.0) == false;
    var t : [512]u8 = undefined;
    t[RC_TEXT_MAX] = 0;
    var clip : [8]u8 = ['a', 13, 'b', 'c', 127, 200, 'd', 'e'];
    assert rc_paste(t[0..512], clip[0..8], 8) == 5;
    assert t[0] == 'a' and t[1] == 'b' and t[4] == 'e' and t[RC_TEXT_MAX] == 5;
    var i : usize = rc_paste(t[0..512], clip[0..8], 0);
    while (i < RC_TEXT_MAX) { i = rc_paste(t[0..512], clip[0..8], 8); }
    assert t[RC_TEXT_MAX] == RC_TEXT_MAX;
    rc_clear(t[0..512]);
    // the dock is live only when the chat follows the Queen's session
    assert rc_docked(false, 0, AGENT_QUEEN) == false;
    assert rc_docked(true, 0, AGENT_QUEEN + 1) == false;
    assert rc_docked(true, 0, AGENT_QUEEN);
}

test opening_the_chat_leaves_the_selected_session_alone_and_the_dock_follows_a_queen_chat_of_its_own {
    // owner 2026-11-03: on the DSH screen the chat slides in from the right and DSH stays; cur is session 0 (DSH),
    // the space's Queen chat is session 2
    const dsh : u32 = 0;
    const queen : u32 = 2;
    const rcs : u32 = rc_pick(dsh, AGENT_DSH, queen);
    assert rcs == queen;
    assert rc_live(true, rcs);
    assert rc_live(false, rcs) == false;
    // the centre keeps the DSH view while the dock is open: only the very session the dock shows is given up
    assert rc_hides_centre(true, dsh, rcs) == false;
    assert rc_hides_centre(true, queen, rcs);
    assert rc_hides_centre(false, queen, rcs) == false;
    // the selected session is a Queen chat already: the dock follows it, and the centre yields to it as before
    assert rc_pick(3, AGENT_QUEEN, queen) == 3;
    assert rc_hides_centre(true, 3, rc_pick(3, AGENT_QUEEN, queen));
    // no session selected (home) and none for the Queen yet: the dock waits for glass to open one
    assert rc_pick(4294967295, AGENT_QUEEN, 4294967295) == 4294967295;
    assert rc_live(true, 4294967295) == false;
    assert rc_hides_centre(true, 4294967295, 4294967295) == false;
}

// ---- the delivery of one message (P0, owner 2026-11-03)

test the_link_names_why_nothing_can_be_sent_and_an_empty_field_sends_nothing {
    assert qd_link(false, true, true) == QD_NO_SERVER;
    assert qd_link(true, false, true) == QD_NO_PANE;
    assert qd_link(true, true, false) == QD_NO_PANE;
    assert qd_link(true, true, true) == QD_READY;
    // an empty field is no error and no send, whatever the link
    assert qd_decide(0, QD_READY) == QD_EMPTY;
    assert qd_decide(0, QD_NO_PANE) == QD_EMPTY;
    // a dead link is named, never swallowed
    assert qd_decide(5, QD_NO_SERVER) == QD_NO_SERVER;
    assert qd_decide(5, QD_NO_PANE) == QD_NO_PANE;
    assert qd_decide(5, QD_READY) == QD_SENDING;
    assert qd_failed(QD_NO_SERVER) and qd_failed(QD_NO_PANE) and qd_failed(QD_WRITE_FAIL);
    assert qd_failed(QD_ACCEPTED) == false and qd_failed(QD_EMPTY) == false and qd_failed(QD_IDLE) == false;
}

test only_a_ok_frame_is_an_answer_and_an_error_frame_keeps_the_draft {
    assert qd_reply_ok(4, RE_OK);
    // the defect this replaces: an RE_ERR frame has a length too
    assert qd_reply_ok(4, 129) == false;
    assert qd_reply_ok(0, RE_OK) == false;
    assert qd_reply_ok(0, 0) == false;
    assert qd_after_write(true) == QD_ACCEPTED;
    assert qd_after_write(false) == QD_WRITE_FAIL;
    // the field is cleared only on ACCEPTED
    assert qd_clears_draft(QD_ACCEPTED);
    assert qd_clears_draft(QD_WRITE_FAIL) == false;
    assert qd_clears_draft(QD_NO_PANE) == false;
    assert qd_clears_draft(QD_NO_SERVER) == false;
    assert qd_clears_draft(QD_EMPTY) == false;
}

test the_message_number_advances_once_on_accept_and_a_retry_keeps_it {
    var id : u32 = 1;
    // first press: no Queen pane, refused; the number stays
    id = qd_next_id(id, QD_NO_PANE);
    assert id == 1;
    // retry: the write fails; still the same message
    id = qd_next_id(id, QD_WRITE_FAIL);
    assert id == 1;
    // third press: taken
    id = qd_next_id(id, QD_ACCEPTED);
    assert id == 2;
    // only a send that failed shows Retry on the button
    assert qd_retry(QD_NO_PANE) and qd_retry(QD_WRITE_FAIL) and qd_retry(QD_NO_SERVER);
    assert qd_retry(QD_ACCEPTED) == false and qd_retry(QD_IDLE) == false and qd_retry(QD_OUTPUT) == false;
}

test output_after_a_send_beyond_the_echo_is_the_only_sign_of_an_answer {
    // 12 bytes were sent; the pane echoes them and a line end: that is not an answer
    assert qd_reply_seen(14, 12) == false;
    assert qd_reply_seen(12 + QD_ECHO_SLACK, 12) == false;
    assert qd_reply_seen(12 + QD_ECHO_SLACK + 1, 12);
    // the state moves from ACCEPTED only
    assert qd_on_output(QD_ACCEPTED, 14, 12) == QD_ACCEPTED;
    assert qd_on_output(QD_ACCEPTED, 400, 12) == QD_OUTPUT;
    assert qd_on_output(QD_NO_PANE, 400, 12) == QD_NO_PANE;
    assert qd_on_output(QD_IDLE, 400, 12) == QD_IDLE;
    assert qd_on_output(QD_OUTPUT, 400, 12) == QD_OUTPUT;
}

test the_status_row_says_what_happened_in_plain_ascii {
    var b : [64]u8 = undefined;
    var n : usize = qd_status_text(b[0..64], QD_SENDING, 7, QD_READY);
    assert n == 13;
    assert b[0] == 83 and b[8] == 35 and b[9] == 55 and b[10] == 46;
    n = qd_status_text(b[0..64], QD_ACCEPTED, 12, QD_READY);
    assert n == 24;
    assert b[0] == 65 and b[9] == 35 and b[10] == 49 and b[11] == 50;
    n = qd_status_text(b[0..64], QD_OUTPUT, 3, QD_READY);
    assert n == 15;
    n = qd_status_text(b[0..64], QD_NO_PANE, 1, QD_NO_PANE);
    assert n == 23;
    assert b[0] == 78 and b[1] == 79 and b[2] == 84;
    n = qd_status_text(b[0..64], QD_NO_SERVER, 1, QD_NO_SERVER);
    assert n == 24;
    n = qd_status_text(b[0..64], QD_WRITE_FAIL, 1, QD_READY);
    assert n == 19;
    // idle: the standing link, honest even before a first press
    n = qd_status_text(b[0..64], QD_IDLE, 1, QD_READY);
    assert n == 20;
    n = qd_status_text(b[0..64], QD_IDLE, 1, QD_NO_PANE);
    assert n == 27;
    n = qd_status_text(b[0..64], QD_IDLE, 1, QD_NO_SERVER);
    assert n == 26;
    // every text is ASCII and fits the row
    var i : usize = 0;
    while (i < n) {
        assert b[i] >= 32 and b[i] < 127;
        i = i + 1;
    }
    assert n <= 34;
}

test a_mock_transport_walks_the_whole_chain_and_never_loses_the_draft {
    // This is a model-level mock: no pane, no socket, no model call. It is not the live Queen.
    var id : u32 = 1;
    var draft : usize = 11;
    var state : u32 = QD_IDLE;
    // 1. the pane server is up but the table is full: no Queen pane
    state = qd_decide(draft, qd_link(true, false, false));
    assert state == QD_NO_PANE;
    assert qd_clears_draft(state) == false;
    id = qd_next_id(id, state);
    assert id == 1 and draft == 11;
    // 2. a pane appears; the write of 11 bytes + CR is one chunk and the server answers RE_ERR
    state = qd_decide(draft, qd_link(true, true, true));
    assert state == QD_SENDING;
    var ok : bool = qd_reply_ok(4, 129);
    state = qd_after_write(ok);
    assert state == QD_WRITE_FAIL and qd_clears_draft(state) == false;
    id = qd_next_id(id, state);
    assert id == 1;
    // 3. the retry: RE_OK for every chunk of a 9000-byte message (3 chunks of at most 4000)
    state = qd_decide(draft, qd_link(true, true, true));
    assert state == QD_SENDING;
    ok = true;
    var c : u32 = 0;
    while (c < 3) {
        ok = ok and qd_reply_ok(4, RE_OK);
        c = c + 1;
    }
    state = qd_after_write(ok);
    assert state == QD_ACCEPTED and qd_clears_draft(state);
    id = qd_next_id(id, state);
    assert id == 2;
    // 4. the pane echoes the line, then answers
    state = qd_on_output(state, 13, 12);
    assert state == QD_ACCEPTED;
    state = qd_on_output(state, 200, 12);
    assert state == QD_OUTPUT;
    // 5. a chunk failing in the middle fails the whole send, and the draft stays
    ok = true;
    c = 0;
    while (c < 3) {
        var rn : usize = 4;
        if (c == 1) { rn = 0; }
        ok = ok and qd_reply_ok(rn, RE_OK);
        c = c + 1;
    }
    assert qd_after_write(ok) == QD_WRITE_FAIL;
}

test the_send_button_is_the_right_end_of_the_delivery_row_and_never_under_the_input {
    const sw : f64 = 1400.0;
    var r : [4]f64 = undefined;
    assert qd_send_rect(sw, 700.0, 34.0, 20.0, r[0..4]);
    var d : [4]f64 = undefined;
    assert qd_row_rect(sw, 700.0, 34.0, 20.0, d[0..4]);
    var i : [4]f64 = undefined;
    assert rc_input_rect(sw, 700.0, 34.0, 20.0, i[0..4]);
    // inside the row, on its right end, above the input
    assert r[0] + r[2] == d[0] + d[2];
    assert r[1] >= d[1] and r[1] + r[3] <= d[1] + d[3];
    assert r[1] + r[3] <= i[1];
    assert r[2] == QD_BTN_W;
    // the hit test agrees with the rect: its centre hits, a point on the input row and one left of it miss
    assert on_qd_send(r[0] + r[2] / 2.0, r[1] + r[3] / 2.0, sw, 700.0, 34.0, 20.0);
    assert on_qd_send(r[0] + r[2] / 2.0, i[1] + 5.0, sw, 700.0, 34.0, 20.0) == false;
    assert on_qd_send(r[0] - 1.0, r[1] + r[3] / 2.0, sw, 700.0, 34.0, 20.0) == false;
    assert on_qd_send(r[0] + r[2], r[1] + r[3] / 2.0, sw, 700.0, 34.0, 20.0) == false;
}

// ---- submit chain unit tests (qd_link, qd_decide, qd_reply_ok, qd_after_write, qd_status_text) ----

test qd_link_no_server_returns_no_server {
    assert qd_link(false, true, true) == QD_NO_SERVER;
}

test qd_link_no_pane_when_link_down {
    assert qd_link(true, false, true) == QD_NO_PANE;
    assert qd_link(true, true, false) == QD_NO_PANE;
    assert qd_link(true, false, false) == QD_NO_PANE;
}

test qd_link_ready_when_all_three_up {
    assert qd_link(true, true, true) == QD_READY;
}

test qd_decide_empty_when_nothing_typed {
    assert qd_decide(0, QD_READY) == QD_EMPTY;
}

test qd_decide_dead_link_returns_link {
    assert qd_decide(5, QD_NO_SERVER) == QD_NO_SERVER;
    assert qd_decide(5, QD_NO_PANE) == QD_NO_PANE;
}

test qd_decide_sending_when_link_ready {
    assert qd_decide(5, QD_READY) == QD_SENDING;
}

test qd_reply_ok_true_only_on_re_ok_with_bytes {
    assert qd_reply_ok(4, RE_OK);
    assert qd_reply_ok(0, RE_OK) == false;
    assert qd_reply_ok(4, RE_ERR) == false;
    assert qd_reply_ok(0, RE_ERR) == false;
}

test qd_after_write_accepted_on_ok_fail_on_not {
    assert qd_after_write(true) == QD_ACCEPTED;
    assert qd_after_write(false) == QD_WRITE_FAIL;
}

test qd_status_text_shows_each_state {
    var buf : [48]u8 = undefined;
    var n : usize;

    // sending
    n = qd_status_text(buf[0..48], QD_SENDING, 3, QD_READY);
    assert n > 0;
    assert buf[0] == 'S'; // "Sending #3..."

    // accepted
    n = qd_status_text(buf[0..48], QD_ACCEPTED, 7, QD_READY);
    assert n > 0;
    assert buf[0] == 'A'; // "Accepted #7 by her pane"

    // output
    n = qd_status_text(buf[0..48], QD_OUTPUT, 2, QD_READY);
    assert n > 0;
    assert buf[0] == 'O'; // "Output after #2"

    // no server
    n = qd_status_text(buf[0..48], QD_NO_SERVER, 0, QD_READY);
    assert n > 0;
    assert buf[0] == 'N'; // "NOT SENT: no pane server"

    // no pane
    n = qd_status_text(buf[0..48], QD_NO_PANE, 0, QD_READY);
    assert n > 0;
    assert buf[0] == 'N'; // "NOT SENT: no Queen pane"

    // write fail
    n = qd_status_text(buf[0..48], QD_WRITE_FAIL, 0, QD_READY);
    assert n > 0;
    assert buf[0] == 'N'; // "NOT SENT: no answer"

    // idle link states
    n = qd_status_text(buf[0..48], QD_IDLE, 0, QD_NO_SERVER);
    assert n > 0;
    assert buf[0] == 'N'; // "No link to the pane server"

    n = qd_status_text(buf[0..48], QD_IDLE, 0, QD_NO_PANE);
    assert n > 0;
    assert buf[0] == 'N'; // "No Queen pane on the server"

    n = qd_status_text(buf[0..48], QD_IDLE, 0, QD_READY);
    assert n > 0;
    assert buf[0] == 'Q'; // "Queen pane connected"
}
