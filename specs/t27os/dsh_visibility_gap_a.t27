// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_visibility_gap_a.t27 -- DSH visibility gap A: one lanes-
// table row per executor with its surface; DSH session id only from a
// token-free path, else no feed.
// Part of M4 milestone (milestone #8). Closes #13046.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_visibility_gap_a;

pub const DSH_VISIBILITY_GAP_A_MAX_EXECUTORS : u32 = 27;

pub struct ExecutorRow { executor_id: str, surface: str, session_id_from_token_free: bool };

pub fn executor_row_session_id_from_token_free(e: ExecutorRow) -> bool {
    return e.session_id_from_token_free;
}

test "executor_row_session_id_from_token_free" {
    assert(executor_row_session_id_from_token_free(ExecutorRow { executor_id: "exec-1", surface: "lane-table", session_id_from_token_free: true }));
    assert(!executor_row_session_id_from_token_free(ExecutorRow { executor_id: "exec-2", surface: "lane-table", session_id_from_token_free: false }));
}

invariant dsh_visibility_gap_a_max_executors_positive {
    assert DSH_VISIBILITY_GAP_A_MAX_EXECUTORS > 0;
}