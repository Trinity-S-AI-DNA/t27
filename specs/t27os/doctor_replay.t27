// SPDX-License-Identifier: Apache-2.0
// specs/t27os/doctor_replay.t27 -- t27os: Doctor replay test of the blocked
// pane of 2026-11-01 (idle notification in Doctor).
// Part of M1 (milestone #5). Closes #13049.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::doctor_replay;

pub const DOCTOR_REPLAY_DATE : str = "2026-11-01";

pub struct DoctorReplay { pane_id: str, blocked: bool, replayed: bool };

pub fn doctor_replay_replayed(r: DoctorReplay) -> bool {
    return r.replayed && r.blocked;
}

test "doctor replay replayed" {
    assert(doctor_replay_replayed(DoctorReplay { pane_id: "pane-0", blocked: true, replayed: true }));
    assert(!doctor_replay_replayed(DoctorReplay { pane_id: "pane-0", blocked: false, replayed: true }));
}

invariant doctor_replay_date_defined {
    assert DOCTOR_REPLAY_DATE == "2026-11-01";
}