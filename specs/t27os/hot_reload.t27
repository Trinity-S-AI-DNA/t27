// SPDX-License-Identifier: Apache-2.0
; specs/t27os/hot_reload.t27 -- hot reload for the T27 OS glass window, built by t27b.
; Owner, 2026-10-19: use t27b for hot-reload development.
; t27b builds the window to a Mach-O object on the lab; ld links it into T27OS.app on the Mac. The
; running window watches its own executable: every RELOAD_POLL frames it reads the file's modification
; date. When the date moves (ld wrote a new binary), it waits until RELOAD_SETTLE checks in a row see
; no further change (codesign rewrites the file once more right after ld), then saves what the user is
; looking at -- the open screen, the open task, the sidebar, the dashboard -- under HOT_KEY in the user
; defaults and execs itself. The new process finds HOT_KEY set, restores that state with no fade-in,
; and clears the key, so an ordinary launch still starts at home. No pkill, no relaunch by hand.
; Why exec and not a swapped dylib: t27b has no call through a function pointer yet, so a draw
; function cannot be looked up and called from a reloaded library. The window flickers once per swap.

; --
; LIVE DATA (owner, 2026-10-21: update in real time without a rebuild). Code changes need the bundle swap of
; release.t27; the data-driven layer does not. The release carries one small module in OUR language,
; t27os-live.t27 (specs/t27os/live_data.t27 is its source), fetched by the same one-minute conditional poll into
; ~/.t27os/live/live.t27. The window parses it HERE and applies it on the next frame, no restart:
;   - THEME: TH_* constants in permille (0..1000): the glass alphas and the white/black levels of the surfaces.
;     live_pack packs 6 values of 10 bits per word into three words that ride in the draw kit; live_get reads one.
;   - PETALS: the comma list of the petal names, accepted only when it has as many names as the built-in one.
; Rules, all tested below: the file must be the module T27osLive, must carry LIVE_REV and end with LIVE_END (a
; truncated download is refused whole), a revision lower than the applied one is refused (a stale cache cannot
; roll the theme back), a value outside 0..1000 or a missing key keeps the built-in default.
; Not live (still a bundle swap): colours of the ground, sizes and layout, the widget registry, the formula table,
; the status bar priorities -- their draw paths read compile-time tables.

module T27osHotReload;

use t27os::release::field_str;
use t27os::release::field_num;
use t27os::release::field_start;
use t27os::release::field_len;
use t27os::release::NO_FIELD;

/// Frames between two looks at the executable (0.5 s at 30 fps).
pub const RELOAD_POLL : u32 = 15;
/// Quiet checks in a row before the swap: ld and then codesign each write the file.
pub const RELOAD_SETTLE : u32 = 2;
/// No change seen since the last swap.
pub const RELOAD_IDLE : u32 = 4294967295;

/// The quiet-check count after one look: back to 0 when the file moved, unchanged when idle.
pub fn reload_wait(w: u32, moved: bool) -> u32 {
    if (moved) { return 0; }
    if (w == RELOAD_IDLE) { return w; }
    return w + 1;
}

/// True when the new binary has been quiet long enough to exec it.
pub fn reload_due(w: u32) -> bool {
    return w != RELOAD_IDLE and w >= RELOAD_SETTLE;
}

/// True on the frames that look at the executable.
pub fn reload_poll(frame: u32) -> bool {
    return frame % RELOAD_POLL == 0;
}

test a_new_binary_is_swapped_in_once_ld_and_codesign_are_done {
    var w : u32 = RELOAD_IDLE;
    w = reload_wait(w, false);
    assert reload_due(w) == false;
    // ld writes the binary
    w = reload_wait(w, true);
    assert reload_due(w) == false;
    // codesign writes it again before the window acts
    w = reload_wait(w, false);
    w = reload_wait(w, true);
    assert reload_due(w) == false;
    w = reload_wait(w, false);
    assert reload_due(w) == false;
    w = reload_wait(w, false);
    assert reload_due(w);
}

test the_window_looks_twice_a_second {
    assert reload_poll(0);
    assert reload_poll(RELOAD_POLL);
    assert reload_poll(1) == false;
    assert RELOAD_POLL * RELOAD_SETTLE == 30;
}

// ---------------------------------------------------------------- live data

/// The theme values the live module can move; the index is the id the window reads them by.
pub const THV_COUNT : u32 = 15;
pub const THV_TINT_BLACK : u32 = 0;
pub const THV_STRICT_SIDE : u32 = 1;
pub const THV_ELEVATED_BLACK : u32 = 2;
pub const THV_STRICT_CONTENT : u32 = 3;
pub const THV_PANEL_BLACK : u32 = 4;
pub const THV_TEXT_WHITE : u32 = 5;
pub const THV_LABEL_WHITE : u32 = 6;
pub const THV_MUTED_WHITE : u32 = 7;
pub const THV_BORDER_WHITE : u32 = 8;
pub const THV_LINE_WHITE : u32 = 9;
pub const THV_HIGHLIGHT_WHITE : u32 = 10;
pub const THV_TIP_WHITE : u32 = 11;
pub const THV_CROWN_WHITE : u32 = 12;
pub const THV_TERMINAL_TINT : u32 = 13;
pub const THV_AGENTS_LINE_ALPHA : u32 = 14;

/// The values of one packed word (10 bits each) and the words that carry them.
pub const THV_PER_WORD : u32 = 6;
pub const THV_MAX : u32 = 1000;
/// A live module larger than this is refused.
pub const LIVE_MAX_BYTES : usize = 2048;

pub const LIVE_OK : u8 = 0;
pub const LIVE_NO_MODULE : u8 = 1;
pub const LIVE_NO_REV : u8 = 2;
pub const LIVE_NO_END : u8 = 3;
pub const LIVE_TOO_BIG : u8 = 4;

pub const KEY_LIVE_REV : str = "pub const LIVE_REV : u32 = ";
pub const KEY_LIVE_END : str = "pub const LIVE_END : u32 = ";
pub const KEY_LIVE_PETALS : str = "pub const PETALS : str = ";
pub const LIVE_MODULE : str = "module T27osLive;";

/// The line a theme value is read from.
pub fn thv_key(i : u32) -> str {
    if (i == 0) { return "pub const TH_TINT_BLACK : u32 = "; }
    if (i == 1) { return "pub const TH_STRICT_SIDE : u32 = "; }
    if (i == 2) { return "pub const TH_ELEVATED_BLACK : u32 = "; }
    if (i == 3) { return "pub const TH_STRICT_CONTENT : u32 = "; }
    if (i == 4) { return "pub const TH_PANEL_BLACK : u32 = "; }
    if (i == 5) { return "pub const TH_TEXT_WHITE : u32 = "; }
    if (i == 6) { return "pub const TH_LABEL_WHITE : u32 = "; }
    if (i == 7) { return "pub const TH_MUTED_WHITE : u32 = "; }
    if (i == 8) { return "pub const TH_BORDER_WHITE : u32 = "; }
    if (i == 9) { return "pub const TH_LINE_WHITE : u32 = "; }
    if (i == 10) { return "pub const TH_HIGHLIGHT_WHITE : u32 = "; }
    if (i == 11) { return "pub const TH_TIP_WHITE : u32 = "; }
    if (i == 12) { return "pub const TH_CROWN_WHITE : u32 = "; }
    if (i == 13) { return "pub const TH_TERMINAL_TINT : u32 = "; }
    if (i == 14) { return "pub const TH_AGENTS_LINE_ALPHA : u32 = "; }
    return "";
}

fn thv_starts(t : []const u8, n : usize, at : usize, key : str) -> bool {
    if (at + key.len > n) { return false; }
    var j : usize = 0;
    while (j < key.len) {
        if (t[at + j] != key[j]) { return false; }
        j += 1;
    }
    return true;
}

/// Is the module declaration on a line of its own?
fn thv_has_module(t : []const u8, n : usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        if ((i == 0 or t[i - 1] == 10) and thv_starts(t, n, i, LIVE_MODULE)) { return true; }
        i += 1;
    }
    return false;
}

/// The revision the file carries, or NO_FIELD.
pub fn live_rev(t : []const u8, n : usize) -> u64 {
    return field_num(t, n, KEY_LIVE_REV, KEY_LIVE_REV.len);
}

/// Is this a live module worth applying at all? The declaration, a revision and the end marker.
pub fn live_check(t : []const u8, n : usize) -> u8 {
    if (n > LIVE_MAX_BYTES) { return LIVE_TOO_BIG; }
    if (!thv_has_module(t, n)) { return LIVE_NO_MODULE; }
    if (live_rev(t, n) == NO_FIELD) { return LIVE_NO_REV; }
    if (field_num(t, n, KEY_LIVE_END, KEY_LIVE_END.len) != 1) { return LIVE_NO_END; }
    return LIVE_OK;
}

/// A file is applied when it is sound and not older than what is applied (an equal revision is applied again:
/// the result is the same).
pub fn live_should_apply(check : u8, rev : u64, applied : u64) -> bool {
    if (check != LIVE_OK) { return false; }
    return rev >= applied;
}

/// Reads every theme key present into tbl (THV_COUNT entries, already holding the built-in defaults); a key that is
/// missing, has no digits or is above THV_MAX leaves its entry alone. The count of entries taken.
pub fn live_apply(t : []const u8, n : usize, tbl : []u32) -> u32 {
    var taken : u32 = 0;
    var i : u32 = 0;
    while (i < THV_COUNT) {
        const v : u64 = field_num(t, n, thv_key(i), thv_key(i).len);
        if (v != NO_FIELD and v <= (THV_MAX as u64)) {
            tbl[i] = v as u32;
            taken += 1;
        }
        i += 1;
    }
    return taken;
}

/// A built-in f64 level as permille (rounded), clamped to 0..THV_MAX.
pub fn thv_permille(x : f64) -> u32 {
    if (x <= 0.0) { return 0; }
    if (x >= 1.0) { return THV_MAX; }
    return (x * 1000.0 + 0.5) as u32;
}

/// Word w of the table: THV_PER_WORD values of 10 bits, value k at bit 10 * k.
pub fn live_pack(tbl : []const u32, w : u32) -> u64 {
    var out : u64 = 0;
    var k : u32 = 0;
    while (k < THV_PER_WORD) {
        const i : u32 = w * THV_PER_WORD + k;
        if (i < THV_COUNT) { out = out | (((tbl[i] & 1023) as u64) << ((k * 10) as u64)); }
        k += 1;
    }
    return out;
}

/// Value id as the f64 the draw code multiplies by, read from the three packed words.
pub fn live_get(w0 : u64, w1 : u64, w2 : u64, id : u32) -> f64 {
    var word : u64 = w0;
    if (id >= 2 * THV_PER_WORD) { word = w2; } else if (id >= THV_PER_WORD) { word = w1; }
    const k : u32 = id % THV_PER_WORD;
    const v : u64 = (word >> ((k * 10) as u64)) & 1023;
    return (v as f64) / 1000.0;
}

/// How many commas the text holds: names in a list = commas + 1.
pub fn live_commas(t : []const u8, at : usize, len : usize) -> u32 {
    var c : u32 = 0;
    var i : usize = 0;
    while (i < len) {
        if (t[at + i] == 44) { c += 1; }
        i += 1;
    }
    return c;
}

/// The petal-name list of the file as (start << 32 | length), or NO_FIELD when it is absent, empty, longer than 200
/// bytes or does not hold exactly `want_commas` commas (a different count would index past the built-in list).
pub fn live_petals(t : []const u8, n : usize, want_commas : u32) -> u64 {
    const f : u64 = field_str(t, n, KEY_LIVE_PETALS, KEY_LIVE_PETALS.len);
    if (f == NO_FIELD) { return NO_FIELD; }
    const len : usize = field_len(f);
    if (len == 0 or len > 200) { return NO_FIELD; }
    if (live_commas(t, field_start(f), len) != want_commas) { return NO_FIELD; }
    return f;
}

/// A small sample file, the way live_data.t27 writes it, for the tests below.
fn thv_sample(out : []u8, cap : usize) -> usize {
    var w : usize = 0;
    const lines : [6]str = [
        "module T27osLive;",
        "pub const LIVE_REV : u32 = 7;",
        "pub const TH_TEXT_WHITE : u32 = 900;",
        "pub const TH_LABEL_WHITE : u32 = 1500;",
        "pub const PETALS : str = \"A,B,C\";",
        "pub const LIVE_END : u32 = 1;"
    ];
    var i : u32 = 0;
    while (i < 6) {
        var j : usize = 0;
        while (j < lines[i].len and w < cap) { out[w] = lines[i][j]; w += 1; j += 1; }
        if (w < cap) { out[w] = 10; w += 1; }
        i += 1;
    }
    return w;
}


fn thv_defaults(tbl : []u32) -> void {
    var i : u32 = 0;
    while (i < THV_COUNT) { tbl[i] = 500 + i; i += 1; }
}

test a_sound_live_module_is_checked_by_its_declaration_revision_and_end_marker {
    var b : [512]u8 = undefined;
    const n : usize = thv_sample(b[0..512], 512);
    assert(live_check(b[0..512], n) == LIVE_OK);
    assert(live_rev(b[0..512], n) == 7);
    // a download cut short loses the end marker and is refused whole
    assert(live_check(b[0..512], n - 30) == LIVE_NO_END);
    // another module, or none, is not ours
    b[7] = 120;
    assert(live_check(b[0..512], n) == LIVE_NO_MODULE);
    // a file above the cap is refused before it is read
    assert(live_check(b[0..512], LIVE_MAX_BYTES + 1) == LIVE_TOO_BIG);
}

test a_stale_revision_never_rolls_the_theme_back {
    assert(live_should_apply(LIVE_OK, 7, 7));
    assert(live_should_apply(LIVE_OK, 8, 7));
    assert(live_should_apply(LIVE_OK, 6, 7) == false);
    assert(live_should_apply(LIVE_NO_END, 99, 7) == false);
    assert(live_should_apply(LIVE_OK, 0, 0));
}

test a_value_present_and_in_range_replaces_the_default_and_anything_else_keeps_it {
    var b : [512]u8 = undefined;
    const n : usize = thv_sample(b[0..512], 512);
    var tbl : [15]u32 = undefined;
    thv_defaults(tbl[0..15]);
    const taken : u32 = live_apply(b[0..512], n, tbl[0..15]);
    // TEXT_WHITE (900) is taken; LABEL_WHITE (1500) is above 1000 and keeps its default; the rest are absent
    assert(taken == 1);
    assert(tbl[THV_TEXT_WHITE] == 900);
    assert(tbl[THV_LABEL_WHITE] == 500 + THV_LABEL_WHITE);
    assert(tbl[THV_TINT_BLACK] == 500);
    assert(tbl[THV_AGENTS_LINE_ALPHA] == 514);
}

test the_theme_packs_into_three_words_and_reads_back_as_the_same_level {
    var tbl : [15]u32 = undefined;
    var i : u32 = 0;
    while (i < THV_COUNT) { tbl[i] = i * 55; i += 1; }
    tbl[THV_TEXT_WHITE] = 880;
    tbl[THV_AGENTS_LINE_ALPHA] = 600;
    tbl[THV_TINT_BLACK] = 1000;
    const w0 : u64 = live_pack(tbl[0..15], 0);
    const w1 : u64 = live_pack(tbl[0..15], 1);
    const w2 : u64 = live_pack(tbl[0..15], 2);
    i = 0;
    while (i < THV_COUNT) {
        const got : f64 = live_get(w0, w1, w2, i);
        const want : f64 = (tbl[i] as f64) / 1000.0;
        assert(got == want);
        i += 1;
    }
    assert(live_get(w0, w1, w2, THV_TEXT_WHITE) == 0.88);
    assert(live_get(w0, w1, w2, THV_AGENTS_LINE_ALPHA) == 0.6);
    assert(live_get(w0, w1, w2, THV_TINT_BLACK) == 1.0);
}

test a_builtin_level_survives_the_round_trip_through_permille {
    assert(thv_permille(0.55) == 550);
    assert(thv_permille(0.88) == 880);
    assert(thv_permille(0.6) == 600);
    assert(thv_permille(0.92) == 920);
    assert(thv_permille(0.0 - 1.0) == 0);
    assert(thv_permille(3.0) == 1000);
    // the f64 the window multiplies by is the literal it used before
    assert((thv_permille(0.88) as f64) / 1000.0 == 0.88);
    assert((thv_permille(0.46) as f64) / 1000.0 == 0.46);
    assert((thv_permille(0.14) as f64) / 1000.0 == 0.14);
}

test petal_names_are_taken_only_with_the_same_number_of_names {
    var b : [512]u8 = undefined;
    const n : usize = thv_sample(b[0..512], 512);
    const f : u64 = live_petals(b[0..512], n, 2);
    assert(f != NO_FIELD);
    assert(field_len(f) == 5);
    assert(b[field_start(f)] == 65);
    // the built-in list has another count: the live list is ignored instead of indexing past the end
    assert(live_petals(b[0..512], n, 3) == NO_FIELD);
    assert(live_petals(b[0..512], n, 1) == NO_FIELD);
    assert(live_commas(b[0..512], field_start(f), field_len(f)) == 2);
}

test there_is_one_key_per_value_and_each_names_its_constant {
    var i : u32 = 0;
    while (i < THV_COUNT) {
        assert(thv_key(i).len > 20);
        var j : u32 = i + 1;
        while (j < THV_COUNT) {
            assert(thv_key(i) != thv_key(j));
            j += 1;
        }
        i += 1;
    }
    assert(thv_key(THV_COUNT).len == 0);
}

test each_id_reads_the_line_of_its_own_name {
    assert(thv_key(THV_TINT_BLACK) == "pub const TH_TINT_BLACK : u32 = ");
    assert(thv_key(THV_STRICT_SIDE) == "pub const TH_STRICT_SIDE : u32 = ");
    assert(thv_key(THV_ELEVATED_BLACK) == "pub const TH_ELEVATED_BLACK : u32 = ");
    assert(thv_key(THV_STRICT_CONTENT) == "pub const TH_STRICT_CONTENT : u32 = ");
    assert(thv_key(THV_PANEL_BLACK) == "pub const TH_PANEL_BLACK : u32 = ");
    assert(thv_key(THV_TEXT_WHITE) == "pub const TH_TEXT_WHITE : u32 = ");
    assert(thv_key(THV_LABEL_WHITE) == "pub const TH_LABEL_WHITE : u32 = ");
    assert(thv_key(THV_MUTED_WHITE) == "pub const TH_MUTED_WHITE : u32 = ");
    assert(thv_key(THV_BORDER_WHITE) == "pub const TH_BORDER_WHITE : u32 = ");
    assert(thv_key(THV_LINE_WHITE) == "pub const TH_LINE_WHITE : u32 = ");
    assert(thv_key(THV_HIGHLIGHT_WHITE) == "pub const TH_HIGHLIGHT_WHITE : u32 = ");
    assert(thv_key(THV_TIP_WHITE) == "pub const TH_TIP_WHITE : u32 = ");
    assert(thv_key(THV_CROWN_WHITE) == "pub const TH_CROWN_WHITE : u32 = ");
    assert(thv_key(THV_TERMINAL_TINT) == "pub const TH_TERMINAL_TINT : u32 = ");
    assert(thv_key(THV_AGENTS_LINE_ALPHA) == "pub const TH_AGENTS_LINE_ALPHA : u32 = ");
}
