// SPDX-License-Identifier: Apache-2.0
; Refs #12945
; specs/t27os/replay_mode.t27 -- the dev-only replay mode of the T27 OS window (owner decision B, 2026-11-08).
; A replay run shows the window and its saved state and lets nothing leave it: no shell command (the heartbeat's
; git commit-tree and push, the lanes feed, the update check, Queen and GODMODE jobs, the pane server start), no
; NSTask (DOCTOR), no curl (dashboard widgets), no web load, no openURL from a button, no pane server socket, no
; settings write to the defaults domain (the snapshot under test).
; The window asks this module at each of those sites; a button reaches the same sites, so it cannot go around them.
; In replay a write is allowed only strictly under the dev data home.
; The mode is decided once, before the first frame and before any effect: the launch argument must be given, the
; bundle must be the dev channel and the data home must be the live home plus the dev suffix. The flag without that
; boundary is RM_REFUSE: the window quits before any effect. Without the flag the mode is RM_OFF and every effect is
; allowed, so the production window behaves as before.
; This module decides; it does not wire. The call sites live in glass_window.t27 and belong to its one writer.
; ASCII only (L3), English only (LANG-EN).

module T27osReplayMode;

use std::mem::bytes_eq;

/// No replay flag: every effect allowed, production behaviour unchanged.
pub const RM_OFF : u32 = 0;
/// Replay flag, dev bundle, dev data home: no effect leaves the window.
pub const RM_REPLAY : u32 = 1;
/// Replay flag without a confirmed boundary: the window quits before any effect.
pub const RM_REFUSE : u32 = 2;

/// The effect sites the window gates (the glass_window function in brackets).
/// /bin/sh -c (tg_spawn): heartbeat commit-tree and push, lanes feed, update check, Queen, GODMODE, pane server start.
pub const FX_SHELL : u32 = 0;
/// NSTask (dk_launch): DOCTOR jobs.
pub const FX_TASK : u32 = 1;
/// /usr/bin/curl (dash_spawn): dashboard widget fetches.
pub const FX_FETCH : u32 = 2;
/// WebView loadRequest.
pub const FX_WEB : u32 = 3;
/// NSWorkspace openURL from a button.
pub const FX_OPEN_URL : u32 = 4;
/// The pane server socket (term_connect).
pub const FX_PANE_LINK : u32 = 5;
/// A settings write (setObject:forKey:, setInteger:forKey:) to the defaults domain: in replay the domain is the
/// snapshot under test, so the run must not rewrite its own starting state; a toggle still works in memory.
pub const FX_DEFAULTS : u32 = 6;
pub const FX_COUNT : u32 = 7;

/// What a replay window shows where a live feed would be.
pub const RM_UNAVAILABLE : str = "unavailable (replay)";

fn rm_has_dotdot(p: []const u8) -> bool {
    var i : usize = 1;
    while (i < p.len) {
        if (p[i - 1] == 46 and p[i] == 46) { return true; }
        i = i + 1;
    }
    return false;
}

/// True when one launch argument is the replay flag, matched exactly: --t27os-replay
pub fn rm_is_flag(arg: []const u8) -> bool {
    return bytes_eq(arg, "--t27os-replay");
}

/// True when `home` is exactly `live` followed by `suffix` (the dev data home), with both parts set and the
/// suffix starting with a slash.
pub fn rm_home_ok(home: []const u8, live: []const u8, suffix: []const u8) -> bool {
    if (live.len == 0 or suffix.len == 0) { return false; }
    if (suffix[0] != 47) { return false; }
    if (home.len != live.len + suffix.len) { return false; }
    if (bytes_eq(home[0 .. live.len], live) == false) { return false; }
    return bytes_eq(home[live.len .. home.len], suffix);
}

/// The mode, decided once before the first frame.
pub fn rm_mode(flag: bool, is_dev: bool, home_ok: bool) -> u32 {
    if (flag == false) { return RM_OFF; }
    if (is_dev == false) { return RM_REFUSE; }
    if (home_ok == false) { return RM_REFUSE; }
    return RM_REPLAY;
}

/// True when effect site `fx` may run in `mode`. Only RM_OFF allows anything; an unknown site is refused.
pub fn rm_allows(mode: u32, fx: u32) -> bool {
    if (fx >= FX_COUNT) { return false; }
    return mode == RM_OFF;
}

/// True when the window may write `path` in `mode`: anything in RM_OFF; in RM_REPLAY only a path strictly under
/// the dev data home `home` with no ".." in it; nothing in RM_REFUSE.
pub fn rm_write_ok(mode: u32, path: []const u8, home: []const u8) -> bool {
    if (mode == RM_OFF) { return true; }
    if (mode != RM_REPLAY) { return false; }
    if (home.len == 0) { return false; }
    if (path.len <= home.len + 1) { return false; }
    if (bytes_eq(path[0 .. home.len], home) == false) { return false; }
    if (path[home.len] != 47) { return false; }
    return rm_has_dotdot(path) == false;
}

/// True when a live feed shows RM_UNAVAILABLE instead of a value.
pub fn rm_feed_unavailable(mode: u32) -> bool {
    return mode != RM_OFF;
}

test the_flag_is_matched_exactly {
    assert rm_is_flag("--t27os-replay") == true;
    assert rm_is_flag("--t27os-replay=1") == false;
    assert rm_is_flag("-t27os-replay") == false;
    assert rm_is_flag("--t27os-replaY") == false;
    assert rm_is_flag("") == false;
}

test the_dev_home_is_the_live_home_plus_the_suffix {
    assert rm_home_ok("/x/u/.t27os-dev", "/x/u", "/.t27os-dev") == true;
    assert rm_home_ok("/x/u", "/x/u", "/.t27os-dev") == false;
    assert rm_home_ok("/x/v/.t27os-dev", "/x/u", "/.t27os-dev") == false;
    assert rm_home_ok("/x/u/.t27os", "/x/u", "/.t27os-dev") == false;
    assert rm_home_ok("/x/u/.t27os-devX", "/x/u", "/.t27os-dev") == false;
    assert rm_home_ok("/.t27os-dev", "", "/.t27os-dev") == false;
    assert rm_home_ok("/x/u", "/x/u", "") == false;
    assert rm_home_ok("/x/u.t27os-dev", "/x/u", ".t27os-dev") == false;
}

test without_the_flag_production_is_unchanged {
    assert rm_mode(false, false, false) == RM_OFF;
    assert rm_mode(false, true, true) == RM_OFF;
    assert rm_mode(false, false, true) == RM_OFF;
    assert rm_allows(RM_OFF, FX_SHELL) == true;
    assert rm_allows(RM_OFF, FX_TASK) == true;
    assert rm_allows(RM_OFF, FX_FETCH) == true;
    assert rm_allows(RM_OFF, FX_WEB) == true;
    assert rm_allows(RM_OFF, FX_OPEN_URL) == true;
    assert rm_allows(RM_OFF, FX_PANE_LINK) == true;
    assert rm_allows(RM_OFF, FX_DEFAULTS) == true;
    assert rm_write_ok(RM_OFF, "/x/u/.t27os/state", "/x/u/.t27os-dev") == true;
    assert rm_feed_unavailable(RM_OFF) == false;
}

test the_flag_needs_the_dev_boundary {
    assert rm_mode(true, false, true) == RM_REFUSE;
    assert rm_mode(true, true, false) == RM_REFUSE;
    assert rm_mode(true, false, false) == RM_REFUSE;
    assert rm_mode(true, true, true) == RM_REPLAY;
}

test replay_and_refuse_allow_no_effect {
    assert rm_allows(RM_REPLAY, FX_SHELL) == false;
    assert rm_allows(RM_REPLAY, FX_TASK) == false;
    assert rm_allows(RM_REPLAY, FX_FETCH) == false;
    assert rm_allows(RM_REPLAY, FX_WEB) == false;
    assert rm_allows(RM_REPLAY, FX_OPEN_URL) == false;
    assert rm_allows(RM_REPLAY, FX_PANE_LINK) == false;
    assert rm_allows(RM_REPLAY, FX_DEFAULTS) == false;
    assert rm_allows(RM_REFUSE, FX_SHELL) == false;
    assert rm_allows(RM_REFUSE, FX_PANE_LINK) == false;
    assert rm_allows(RM_OFF, FX_COUNT) == false;
    assert rm_allows(7, FX_SHELL) == false;
    assert rm_feed_unavailable(RM_REPLAY) == true;
    assert rm_feed_unavailable(RM_REFUSE) == true;
}

test replay_writes_only_under_the_dev_home {
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-dev/.t27os/clicks.txt", "/x/u/.t27os-dev") == true;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os/pty.sock", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-devX/a", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-dev", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-dev/", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-dev/../.t27os/a", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/tmp/t27os-dev-doctor-0.out", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REFUSE, "/x/u/.t27os-dev/a", "/x/u/.t27os-dev") == false;
    assert rm_write_ok(RM_REPLAY, "/x/u/.t27os-dev/a", "") == false;
}
