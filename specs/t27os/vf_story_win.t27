// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_story_win.t27 -- minimal window/input adapter for the UIKit storybook browser.
; Connects keyboard/click events to SbSelection state: maps an event to a new selection, returns
; the resulting story index and theme for the host to render via vsm_render (vf_story_main.t27).
; This spec holds no layout, no colour, no font, no pixel arithmetic: those belong in vf_story_main
; and the visual factory.  Its job is to map an input event to a new SbSelection so the host can
; call vsm_render(sb_win_story(st), 375, 100, sb_win_theme(st)) and display the result.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfStoryWin;

use t27f::vf_storybook::SbSelection;
use t27f::vf_storybook::sb_selection;
use t27f::vf_storybook::sb_story_for_selection;
use t27f::vf_storybook::sb_variants_for_component_count;
use t27f::vf_storybook::sb_variants_for_component_at;
use t27f::vf_storybook::sb_states_for_component_variant_count;
use t27f::vf_storybook::sb_states_for_component_variant_at;
use t27f::vf_storybook::SB_COUNT;
use t27f::vf_storybook::SC_CARD;
use t27f::vf_storybook::SC_BUTTON;
use t27f::vf_storybook::SC_BADGE;
use t27f::vf_storybook::SC_COUNT;

; event codes -- host sends one of these on each input
; SW_EV_NONE: no-op, re-render current state
pub const SW_EV_NONE         : u8 = 0;
; SW_EV_NEXT_COMP: cycle to next component (wraps)
pub const SW_EV_NEXT_COMP    : u8 = 1;
; SW_EV_PREV_COMP: cycle to previous component (wraps)
pub const SW_EV_PREV_COMP    : u8 = 2;
; SW_EV_NEXT_VARIANT: next variant of current component (wraps, resets state)
pub const SW_EV_NEXT_VARIANT : u8 = 3;
; SW_EV_PREV_VARIANT: previous variant (wraps, resets state)
pub const SW_EV_PREV_VARIANT : u8 = 4;
; SW_EV_NEXT_STATE: next state of current component + variant (wraps)
pub const SW_EV_NEXT_STATE   : u8 = 5;
; SW_EV_PREV_STATE: previous state (wraps)
pub const SW_EV_PREV_STATE   : u8 = 6;
; SW_EV_TOGGLE_THEME: flip between light (0) and dark (1) theme
pub const SW_EV_TOGGLE_THEME : u8 = 7;
; SW_EV_RESET: reset to component 0 / variant 0 / state 0 / theme 0
pub const SW_EV_RESET        : u8 = 8;

; total distinct component codes covered by the catalog (SC_CARD = 0 .. SC_CONTAINER = 8)
pub const SW_COMP_COUNT : u32 = SC_COUNT;

pub struct SbWinState {
    pub sel   : SbSelection,
    pub theme : u32,
}

pub fn sb_win_initial() -> SbWinState {
    return SbWinState {
        sel: sb_selection(SC_CARD, 0, 0, 0),
        theme: 0,
    };
}

; (i + 1) mod n, clamped at 0 when n == 0
fn sw_next(i: u32, n: u32) -> u32 {
    if (n == 0) {
        return 0;
    }
    return (i + 1) % n;
}

; (i - 1) mod n, clamped at 0 when n == 0
fn sw_prev(i: u32, n: u32) -> u32 {
    if (n == 0) {
        return 0;
    }
    if (i == 0) {
        return n - 1;
    }
    return i - 1;
}

pub fn sb_win_handle(st: SbWinState, ev: u8) -> SbWinState {
    var ns : SbWinState = st;
    if (ev == SW_EV_NEXT_COMP) {
        const c = sw_next(st.sel.component, SW_COMP_COUNT);
        ns.sel = sb_selection(c, 0, 0, st.sel.view_mode);
    }
    if (ev == SW_EV_PREV_COMP) {
        const c = sw_prev(st.sel.component, SW_COMP_COUNT);
        ns.sel = sb_selection(c, 0, 0, st.sel.view_mode);
    }
    if (ev == SW_EV_NEXT_VARIANT) {
        const n = sb_variants_for_component_count(st.sel.component);
        const slot = sw_next(0, n);
        const v = sb_variants_for_component_at(st.sel.component, slot);
        ns.sel = sb_selection(st.sel.component, v, 0, st.sel.view_mode);
    }
    if (ev == SW_EV_PREV_VARIANT) {
        const n = sb_variants_for_component_count(st.sel.component);
        const slot = sw_prev(0, n);
        const v = sb_variants_for_component_at(st.sel.component, slot);
        ns.sel = sb_selection(st.sel.component, v, 0, st.sel.view_mode);
    }
    if (ev == SW_EV_NEXT_STATE) {
        const n = sb_states_for_component_variant_count(st.sel.component, st.sel.variant);
        const slot = sw_next(0, n);
        const s = sb_states_for_component_variant_at(st.sel.component, st.sel.variant, slot);
        ns.sel = sb_selection(st.sel.component, st.sel.variant, s, st.sel.view_mode);
    }
    if (ev == SW_EV_PREV_STATE) {
        const n = sb_states_for_component_variant_count(st.sel.component, st.sel.variant);
        const slot = sw_prev(0, n);
        const s = sb_states_for_component_variant_at(st.sel.component, st.sel.variant, slot);
        ns.sel = sb_selection(st.sel.component, st.sel.variant, s, st.sel.view_mode);
    }
    if (ev == SW_EV_TOGGLE_THEME) {
        if (ns.theme == 0) {
            ns.theme = 1;
        } else {
            ns.theme = 0;
        }
    }
    if (ev == SW_EV_RESET) {
        ns.sel = sb_selection(SC_CARD, 0, 0, 0);
        ns.theme = 0;
    }
    return ns;
}

; story index for the current state; SB_COUNT when no matching story exists
pub fn sb_win_story(st: SbWinState) -> u32 {
    return sb_story_for_selection(st.sel);
}

; theme for the current state (0 = light, 1 = dark)
pub fn sb_win_theme(st: SbWinState) -> u32 {
    return st.theme;
}

; true when the current state has a story in the catalog
pub fn sb_win_has_story(st: SbWinState) -> bool {
    return sb_win_story(st) < SB_COUNT;
}

test initial_state_resolves_to_story_0 {
    const st = sb_win_initial();
    assert sb_win_story(st) == 0;
    assert sb_win_has_story(st) == true;
    assert sb_win_theme(st) == 0;
}

test next_comp_moves_component_and_resets_variant_and_state {
    const st = sb_win_initial();
    const st2 = sb_win_handle(st, SW_EV_NEXT_COMP);
    assert st2.sel.component == SC_BUTTON;
    assert st2.sel.variant == 0;
    assert st2.sel.state == 0;
}

test prev_comp_from_0_wraps_to_last_component {
    const st = sb_win_initial();
    const st2 = sb_win_handle(st, SW_EV_PREV_COMP);
    assert st2.sel.component == SW_COMP_COUNT - 1;
}

test toggle_theme_flips_light_to_dark {
    const st = sb_win_initial();
    const st1 = sb_win_handle(st, SW_EV_TOGGLE_THEME);
    assert st1.theme == 1;
    const st2 = sb_win_handle(st1, SW_EV_TOGGLE_THEME);
    assert st2.theme == 0;
}

test reset_after_moves_returns_to_initial {
    const st = sb_win_initial();
    const st1 = sb_win_handle(st, SW_EV_NEXT_COMP);
    const st2 = sb_win_handle(st1, SW_EV_TOGGLE_THEME);
    const st3 = sb_win_handle(st2, SW_EV_RESET);
    assert st3.sel.component == SC_CARD;
    assert st3.sel.variant == 0;
    assert st3.theme == 0;
    assert sb_win_story(st3) == 0;
}

test next_comp_then_next_variant_gives_valid_story {
    const st = sb_win_initial();
    const st1 = sb_win_handle(st, SW_EV_NEXT_COMP);
    const st2 = sb_win_handle(st1, SW_EV_NEXT_VARIANT);
    assert sb_win_has_story(st2) == true;
}

test click_cycle_button_primary_to_secondary_state_machine {
    const st0 = sb_win_initial();
    const story0 = sb_win_story(st0);
    const st1 = sb_win_handle(st0, SW_EV_NEXT_VARIANT);
    const story1 = sb_win_story(st1);
    const st2 = sb_win_handle(st1, SW_EV_NEXT_STATE);
    const story2 = sb_win_story(st2);
    assert story0 != story1;
    assert story1 != story2;
    assert sb_win_has_story(st0) == true;
    assert sb_win_has_story(st1) == true;
    assert sb_win_has_story(st2) == true;
}
