// SPDX-License-Identifier: Apache-2.0
// T27 OS ws minimal sha1 probe -- stage-by-stage values of ws_sha1.t27's sha1 on the RFC test
// message "abc", one probe fn per stage, so a failing stage names itself. See the defect ledger in
// specs/t27os/ws_sha1.t27. Compiler identity is printed in the receipt (t27b --version + SHA-256).

module T27osWsMinSha1;

fn rotl32(x : u32, n : u32) -> u32 {
  return (x << n) | (x >> (32 - n));
}

fn put_be32(out : []u8, at : usize, v : u32) -> void {
  out[at] = (v >> 24) as u8;
  out[at + 1] = (v >> 16) as u8;
  out[at + 2] = (v >> 8) as u8;
  out[at + 3] = v as u8;
}

/// The padded message word i of "abc": w[0] = 0x61626380, w[14] = 0, w[15] = 24.
pub fn pw(i : usize) -> u32 {
  var w : [16]u32;
  const msg : string = "abc";
  var j : usize = 0;
  while (j < 16) {
    var word : u32 = 0;
    var k : usize = 0;
    while (k < 4) {
      const at : usize = j * 4 + k;
      var b : u8 = 0;
      if (at < 3) { b = msg[at] as u8; }
      if (at == 3) { b = 0x80; }
      word = (word << 8) | b as u32;
      k = k + 1;
    }
    w[j] = word;
    j = j + 1;
  }
  const bits : u64 = 24;
  w[14] = (bits >> 32) as u32;
  w[15] = bits as u32;
  return w[i];
}

/// The extended schedule word i (16..79), zeros below 16.
pub fn pe(i : usize) -> u32 {
  var w : [80]u32;
  var j : usize = 0;
  while (j < 16) {
    w[j] = pw(j);
    j = j + 1;
  }
  j = 16;
  while (j < 80) {
    w[j] = rotl32(w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16], 1);
    j = j + 1;
  }
  return w[i];
}

/// h0..h4 after the 80 rounds, folded to one word: (h0 / 16) + h1 + h2 / 8 + h3 + h4.
/// The known digest folds to 0x8E + 0x24 + 0x17 + 0x26 + 0x0 = 0xEF words-scale; the point of the
/// fold is a single small number a probe can compare: the real check is the byte test below.
pub fn run_sha1(out : []u8) -> usize {
  var h0 : u32 = 0x67452301;
  var h1 : u32 = 0x80000000 +% 0x6FCDAB89;
  var h2 : u32 = 0x80000000 +% 0x18BADCFE;
  var h3 : u32 = 0x10325476;
  var h4 : u32 = 0x80000000 +% 0x43D2E1F0;
  var ones : u32 = 0x80000000 +% 0x7FFFFFFF;
  var w : [80]u32;
  var j : usize = 0;
  while (j < 16) {
    w[j] = pw(j);
    j = j + 1;
  }
  j = 16;
  while (j < 80) {
    w[j] = rotl32(w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16], 1);
    j = j + 1;
  }
  var a : u32 = h0;
  var b : u32 = h1;
  var c : u32 = h2;
  var d : u32 = h3;
  var e : u32 = h4;
  j = 0;
  while (j < 80) {
    var f : u32 = 0;
    var k : u32 = 0;
    if (j < 20) {
      f = (b & c) | ((ones - b) & d);
      k = 0x5A827999;
    }
    if (j >= 20 and j < 40) {
      f = b ^ c ^ d;
      k = 0x6ED9EBA1;
    }
    if (j >= 40 and j < 60) {
      f = (b & c) | (b & d) | (c & d);
      k = 0x80000000 +% 0x0F1BBCDC;
    }
    if (j >= 60) {
      f = b ^ c ^ d;
      k = 0x80000000 +% 0x4A62C1D6;
    }
    const tmp : u32 = e +% k +% w[j] +% rotl32(a, 5) +% f; // FIPS 180-4: T = rotl5(a)+f+e+k+w[j]; no plain a term (the extra a was the digest bug)
    e = d;
    d = c;
    c = rotl32(b, 30);
    b = a;
    a = tmp;
    j = j + 1;
  }
  h0 = h0 +% a;
  h1 = h1 +% b;
  h2 = h2 +% c;
  h3 = h3 +% d;
  h4 = h4 +% e;
  put_be32(out, 0, h0);
  put_be32(out, 4, h1);
  put_be32(out, 8, h2);
  put_be32(out, 12, h3);
  put_be32(out, 16, h4);
  return 20;
}

test words_of_abc {
  // w[0] = 0x61626380, checked by halves to keep every literal below 0x80000000
  assert (pw(0) >> 16) == 0x6162;
  assert (pw(0) & 4095) == 0x380;
  assert pw(1) == 0;
  assert pw(13) == 0;
  assert pw(14) == 0;
  assert pw(15) == 24;
}

test extension_word_16 {
  // w[16] = rotl1(w13 ^ w8 ^ w2 ^ w0) = rotl1(0x61626380) = 0xC2C4C700
  assert (pe(16) >> 16) == 0xC2C4;
  assert (pe(16) & 4095) == 0x700;
}

test the_digest_is_the_rfc_vector_by_bytes {
  var d : [20]u8;
  const dd : []u8 = d[0..20];
  const n : usize = run_sha1(dd);
  assert n == 20;
  // a9993e36 4706816a ba3e2571 7850c26c 9cd0d89d
  assert dd[0] == 0xA9;
  assert dd[1] == 0x99;
  assert dd[2] == 0x3E;
  assert dd[3] == 0x36;
  assert dd[4] == 0x47;
  assert dd[5] == 0x06;
  assert dd[6] == 0x81;
  assert dd[7] == 0x6A;
  assert dd[8] == 0xBA;
  assert dd[9] == 0x3E;
  assert dd[10] == 0x25;
  assert dd[11] == 0x71;
  assert dd[12] == 0x78;
  assert dd[13] == 0x50;
  assert dd[14] == 0xC2;
  assert dd[15] == 0x6C;
  assert dd[16] == 0x9C;
  assert dd[17] == 0xD0;
  assert dd[18] == 0xD8;
  assert dd[19] == 0x9D;
}
