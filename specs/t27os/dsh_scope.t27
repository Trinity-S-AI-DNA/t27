// SPDX-License-Identifier: Apache-2.0
; specs/t27os/dsh_scope.t27 -- the gate that decides, before a DSH thread writes a file, whether the write is in scope.
; Owner, 2026-11-01: DSH codes only inside T27OS, and every thread carries an issue number, a DSH task id, a target
; path and a visual-core impact. Chain: Claude Code decides, DSH orchestrates, T27OS executes (see #12945; this spec is #13018).
; Four facts decide: (1) the thread has a GitHub issue number, (2) the target path is inside a T27OS root, (3) the target
; is not a hand-written foreign-language file, (4) the thread declares a visual-core impact (a petal or a band).
; The path rule is not written here: policy/own_language.t27 classify() says what is foreign. Hand-written .rs, .yaml and
; Dockerfile stay denied even inside a T27OS root; the owner's pasted allow-list of cli/**/src/*.rs, configs/*.yaml and
; docker/*.Dockerfile is NOT adopted (the Only-t27 rule overrides it), and no extension list is copied into this file.
; Modes: AUDIT decides, logs and never blocks, and it is the default. BLOCK is the same decision with the refusal made real;
; the owner flips DEFAULT_MODE in a separate PR, because a blocking gate on a task id that DSH does not export yet would
; stop every session. Any mode other than BLOCK reads as AUDIT, so a corrupt value never blocks a write.
; A failed check 1, 2 or 3 is V_WOULD_DENY in AUDIT and V_DENY in BLOCK. A missing impact (check 4) is V_INTERNAL_ONLY in
; both modes: the write is allowed, marked internal-only and not counted as visual-core progress.
; Pure module, no @extern. The PreToolUse host is out of scope; the comment block at the end of this file lists what it
; must provide, and which of those facts are documented for Claude Code and which are unverified for DSH.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osDshScope;

use policy::own_language::classify;
use policy::own_language::has_prefix;
use policy::own_language::DENY;

; --- 1. modes, verdicts and reasons ------------------------------------------------------------------------

/// The two modes. AUDIT logs and allows; BLOCK refuses.
pub const AUDIT : u8 = 0;
pub const BLOCK : u8 = 1;

/// The mode a host uses when nobody set one. The owner flips it to BLOCK in a separate PR.
pub const DEFAULT_MODE : u8 = AUDIT;

/// The verdict codes the host acts on. Only V_DENY stops the write (exit code 2).
pub const V_ALLOW : u8 = 0;
pub const V_INTERNAL_ONLY : u8 = 1;
pub const V_WOULD_DENY : u8 = 2;
pub const V_DENY : u8 = 3;

/// Why: the first fact that failed, for the log row. W_NO_IMPACT is not a refusal.
pub const W_OK : u8 = 0;
pub const W_NO_ISSUE : u8 = 1;
pub const W_OUTSIDE_ROOT : u8 = 2;
pub const W_FOREIGN : u8 = 3;
pub const W_NO_IMPACT : u8 = 4;

; --- 2. the decision over four facts ---------------------------------------------------------------------

/// The first fact that failed, in the order issue, root, foreign file, impact; W_OK when all four hold.
pub fn why(has_issue: bool, in_root: bool, foreign_denied: bool, has_impact: bool) -> u8 {
    if (has_issue == false) { return W_NO_ISSUE; }
    if (in_root == false) { return W_OUTSIDE_ROOT; }
    if (foreign_denied) { return W_FOREIGN; }
    if (has_impact == false) { return W_NO_IMPACT; }
    return W_OK;
}

/// The verdict for a reason in a mode. A failed check refuses only in BLOCK; a missing impact never refuses.
pub fn verdict_of_reason(mode: u8, w: u8) -> u8 {
    if (w == W_OK) { return V_ALLOW; }
    if (w == W_NO_IMPACT) { return V_INTERNAL_ONLY; }
    if (mode == BLOCK) { return V_DENY; }
    return V_WOULD_DENY;
}

/// The verdict over the four facts, already computed. The host computes in_root and foreign_denied from the path
/// with path_in_root and path_is_foreign below, or decide_path does it in one call.
pub fn decide(mode: u8, has_issue: bool, in_root: bool, foreign_denied: bool, has_impact: bool) -> u8 {
    return verdict_of_reason(mode, why(has_issue, in_root, foreign_denied, has_impact));
}

/// Does the host let the write through? Everything except V_DENY does (AUDIT never denies).
pub fn write_allowed(v: u8) -> bool {
    return v != V_DENY;
}

/// Does the write count as visual-core progress? Only a clean V_ALLOW does; V_INTERNAL_ONLY is allowed but not counted.
pub fn counts_toward_progress(v: u8) -> bool {
    return v == V_ALLOW;
}

; --- 3. the facts read from a path and a declaration ------------------------------------------------------

/// The T27OS roots, repo-relative, a comma list ending in '$' (the list shape of policy/own_language.t27):
/// specs/t27os/ in this repo, specs/os/ in the sibling t27os repo. The owner edits this one const.
pub const T27OS_ROOTS : str = "specs/t27os/,specs/os/,$";

/// The visual-core layers that count, each followed by its number ("petal 3", "band 2"); same list shape.
pub const IMPACT_LAYERS : str = "petal ,band ,$";

/// Is path[from..to] under a T27OS root? A root is a prefix, not a substring.
pub fn path_in_root(path: []const u8, from: usize, to: usize) -> bool {
    return has_prefix(T27OS_ROOTS, path, from, to);
}

/// Is path[from..to] a hand-written foreign file? The answer is own_language classify(), asked as a new file ('A'):
/// a DSH thread has no owner label, so it may not edit an existing foreign file either.
pub fn path_is_foreign(path: []const u8, from: usize, to: usize) -> bool {
    return classify('A', path, from, to) == DENY;
}

/// Does the declaration impact[from..to] name a layer and its number? "internal-only" and "" do not.
pub fn impact_declared(impact: []const u8, from: usize, to: usize) -> bool {
    return has_prefix(IMPACT_LAYERS, impact, from, to);
}

/// The reason for a thread, a repo-relative path path[0..plen] and a declaration impact[0..ilen].
pub fn why_path(has_issue: bool, path: []const u8, plen: usize, impact: []const u8, ilen: usize) -> u8 {
    return why(has_issue, path_in_root(path, 0, plen), path_is_foreign(path, 0, plen), impact_declared(impact, 0, ilen));
}

/// The verdict for a thread, a repo-relative path path[0..plen] and a declaration impact[0..ilen], in one call.
pub fn decide_path(mode: u8, has_issue: bool, path: []const u8, plen: usize, impact: []const u8, ilen: usize) -> u8 {
    return verdict_of_reason(mode, why_path(has_issue, path, plen, impact, ilen));
}

; --- 4. tests ---------------------------------------------------------------------------------------------

test the_default_mode_is_audit {
    assert DEFAULT_MODE == AUDIT;
    assert DEFAULT_MODE != BLOCK;
}

test an_unknown_mode_reads_as_audit {
    assert decide(7, false, true, false, true) == V_WOULD_DENY;
    assert decide(255, true, false, false, true) == V_WOULD_DENY;
    assert decide(7, true, true, false, true) == V_ALLOW;
}

test all_four_facts_good_is_allowed {
    assert decide(AUDIT, true, true, false, true) == V_ALLOW;
    assert decide(DEFAULT_MODE, true, true, false, true) == V_ALLOW;
}

test block_with_all_four_facts_good_is_still_allowed {
    assert decide(BLOCK, true, true, false, true) == V_ALLOW;
}

test no_issue_is_logged_in_audit_and_denied_in_block {
    assert decide(AUDIT, false, true, false, true) == V_WOULD_DENY;
    assert decide(BLOCK, false, true, false, true) == V_DENY;
}

test outside_the_root_is_logged_in_audit_and_denied_in_block {
    assert decide(AUDIT, true, false, false, true) == V_WOULD_DENY;
    assert decide(BLOCK, true, false, false, true) == V_DENY;
}

test a_foreign_file_is_logged_in_audit_and_denied_in_block {
    assert decide(AUDIT, true, true, true, true) == V_WOULD_DENY;
    assert decide(BLOCK, true, true, true, true) == V_DENY;
}

test no_impact_is_internal_only_in_both_modes {
    assert decide(AUDIT, true, true, false, false) == V_INTERNAL_ONLY;
    assert decide(BLOCK, true, true, false, false) == V_INTERNAL_ONLY;
}

test audit_never_returns_deny_for_any_combination {
    assert decide(AUDIT, true, true, true, true) != V_DENY;
    assert decide(AUDIT, true, true, true, false) != V_DENY;
    assert decide(AUDIT, true, true, false, true) != V_DENY;
    assert decide(AUDIT, true, true, false, false) != V_DENY;
    assert decide(AUDIT, true, false, true, true) != V_DENY;
    assert decide(AUDIT, true, false, true, false) != V_DENY;
    assert decide(AUDIT, true, false, false, true) != V_DENY;
    assert decide(AUDIT, true, false, false, false) != V_DENY;
    assert decide(AUDIT, false, true, true, true) != V_DENY;
    assert decide(AUDIT, false, true, true, false) != V_DENY;
    assert decide(AUDIT, false, true, false, true) != V_DENY;
    assert decide(AUDIT, false, true, false, false) != V_DENY;
    assert decide(AUDIT, false, false, true, true) != V_DENY;
    assert decide(AUDIT, false, false, true, false) != V_DENY;
    assert decide(AUDIT, false, false, false, true) != V_DENY;
    assert decide(AUDIT, false, false, false, false) != V_DENY;
}

test block_denies_every_combination_with_a_failed_check {
    assert decide(BLOCK, true, true, true, true) == V_DENY;
    assert decide(BLOCK, true, true, true, false) == V_DENY;
    assert decide(BLOCK, true, false, true, true) == V_DENY;
    assert decide(BLOCK, true, false, true, false) == V_DENY;
    assert decide(BLOCK, true, false, false, true) == V_DENY;
    assert decide(BLOCK, true, false, false, false) == V_DENY;
    assert decide(BLOCK, false, true, true, true) == V_DENY;
    assert decide(BLOCK, false, true, true, false) == V_DENY;
    assert decide(BLOCK, false, true, false, true) == V_DENY;
    assert decide(BLOCK, false, true, false, false) == V_DENY;
    assert decide(BLOCK, false, false, true, true) == V_DENY;
    assert decide(BLOCK, false, false, true, false) == V_DENY;
    assert decide(BLOCK, false, false, false, true) == V_DENY;
    assert decide(BLOCK, false, false, false, false) == V_DENY;
}

test a_failed_check_beats_a_missing_impact {
    assert decide(AUDIT, true, true, false, false) == V_INTERNAL_ONLY;
    assert decide(AUDIT, true, false, false, false) == V_WOULD_DENY;
    assert decide(BLOCK, true, true, true, false) == V_DENY;
}

test the_reason_is_the_first_failed_fact {
    assert why(false, false, true, false) == W_NO_ISSUE;
    assert why(true, false, true, false) == W_OUTSIDE_ROOT;
    assert why(true, true, true, false) == W_FOREIGN;
    assert why(true, true, false, false) == W_NO_IMPACT;
    assert why(true, true, false, true) == W_OK;
}

test only_deny_stops_a_write_and_only_allow_counts_as_progress {
    assert write_allowed(V_ALLOW);
    assert write_allowed(V_INTERNAL_ONLY);
    assert write_allowed(V_WOULD_DENY);
    assert write_allowed(V_DENY) == false;
    assert counts_toward_progress(V_ALLOW);
    assert counts_toward_progress(V_INTERNAL_ONLY) == false;
    assert counts_toward_progress(V_WOULD_DENY) == false;
    assert counts_toward_progress(V_DENY) == false;
}

test a_root_is_a_prefix_not_a_substring {
    assert path_in_root("specs/t27os/x.t27", 0, 17);
    assert path_in_root("specs/os/x.t27", 0, 14);
    assert path_in_root("docs/x.t27", 0, 10) == false;
    assert path_in_root("xspecs/t27os/x.t27", 0, 18) == false;
    assert path_in_root("specs/t27osx.t27", 0, 16) == false;
    assert path_in_root("", 0, 0) == false;
}

test foreign_files_follow_own_language_even_inside_a_root {
    assert path_is_foreign("specs/t27os/x.rs", 0, 16);
    assert path_is_foreign("specs/t27os/x.yaml", 0, 18);
    assert path_is_foreign("specs/t27os/Dockerfile", 0, 22);
    assert path_is_foreign("specs/t27os/x.t27", 0, 17) == false;
    assert path_is_foreign("specs/t27os/NOTES.md", 0, 20) == false;
}

test an_impact_needs_a_layer_and_its_number {
    assert impact_declared("petal 3", 0, 7);
    assert impact_declared("band 2", 0, 6);
    assert impact_declared("internal-only", 0, 13) == false;
    assert impact_declared("", 0, 0) == false;
}

test scenario_no_issue_on_a_t27os_spec {
    assert decide_path(AUDIT, false, "specs/t27os/x.t27", 17, "petal 3", 7) == V_WOULD_DENY;
    assert decide_path(BLOCK, false, "specs/t27os/x.t27", 17, "petal 3", 7) == V_DENY;
    assert why_path(false, "specs/t27os/x.t27", 17, "petal 3", 7) == W_NO_ISSUE;
}

test scenario_a_path_outside_the_roots {
    assert decide_path(AUDIT, true, "docs/x.t27", 10, "petal 3", 7) == V_WOULD_DENY;
    assert decide_path(BLOCK, true, "docs/x.t27", 10, "petal 3", 7) == V_DENY;
    assert why_path(true, "docs/x.t27", 10, "petal 3", 7) == W_OUTSIDE_ROOT;
}

test scenario_a_declared_thread_with_a_petal_is_allowed {
    assert decide_path(AUDIT, true, "specs/t27os/x.t27", 17, "petal 3", 7) == V_ALLOW;
    assert decide_path(BLOCK, true, "specs/t27os/x.t27", 17, "petal 3", 7) == V_ALLOW;
    assert decide_path(BLOCK, true, "specs/os/x.t27", 14, "band 2", 6) == V_ALLOW;
}

test scenario_no_visual_core_impact_is_internal_only {
    assert decide_path(AUDIT, true, "specs/t27os/x.t27", 17, "internal-only", 13) == V_INTERNAL_ONLY;
    assert decide_path(BLOCK, true, "specs/t27os/x.t27", 17, "", 0) == V_INTERNAL_ONLY;
    assert why_path(true, "specs/t27os/x.t27", 17, "", 0) == W_NO_IMPACT;
}

test scenario_a_hand_written_rust_or_dockerfile_inside_a_root {
    assert decide_path(AUDIT, true, "specs/t27os/x.rs", 16, "petal 3", 7) == V_WOULD_DENY;
    assert decide_path(BLOCK, true, "specs/t27os/x.rs", 16, "petal 3", 7) == V_DENY;
    assert decide_path(BLOCK, true, "specs/t27os/Dockerfile", 22, "petal 3", 7) == V_DENY;
    assert why_path(true, "specs/t27os/x.rs", 16, "petal 3", 7) == W_FOREIGN;
}

; --- 5. host requirements: what a PreToolUse host has to provide (this spec holds only the decision) -------
; Documented for Claude Code (hooks reference, checked against the docs, not against a running DSH):
; 1. stdin JSON: the hook receives one JSON object on stdin that carries tool_name and tool_input among its fields.
; 2. tool_input.file_path: for the Write and Edit tools it is the absolute target path.
; 3. exit code 2 with a stderr message: blocks the tool call and shows the stderr text to the model; exit 0 lets it run.
; Unverified for DSH, to be settled before DEFAULT_MODE may become BLOCK:
; 4. agent_id and agent_type: expected in the stdin JSON of a subagent call; not confirmed for the installed Claude Code build.
; 5. DSH_TASK_ID: no such environment variable exists in Claude Code; DSH must export it for the hook to read the task id.
; 6. issue number and visual-core impact: DSH has no thread record that carries them yet; the host must read them from one place DSH writes.
; Duties of the host, whatever DSH does:
; 7. path: make tool_input.file_path repo-relative and resolve dot segments and symlinks first; path_in_root is a prefix test.
; 8. facts: pass has_issue, the path and the impact to decide_path, or the four facts to decide; copy no root and no extension list.
; 9. exit code: exit 2 with a stderr message that names the reason (why_path) only when the verdict is V_DENY; exit 0 otherwise.
; 10. log: append one jsonl row per decision with time, DSH_TASK_ID, issue, path, mode, verdict and reason, in both modes.
; 11. progress: count a thread toward visual-core progress only when counts_toward_progress holds; mark V_INTERNAL_ONLY rows.
; 12. mode: read DEFAULT_MODE; the owner flips it to BLOCK in a separate PR once items 4 to 6 are verified.
