// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_native_bridge.t27 -- development line 0.3.2.
; The browser target is a loopback bridge onto the native T27 OS window
; (glass_window.t27, T27OS.app). It is not the embedded T27B page, and it is
; not the WASM player (plan B, ui_targets browser row).
; -
; Desktop release stays 0.3.1 (release.t27 VERSION_MAJOR/MINOR/PATCH). This
; file does not bump that triple. The bridge is end-to-end only when
; E2E_PASSED is 1. Until then view_mode is VIEW_ONLY and the ui_targets
; browser row stays MISSING.
; -
; What this file decides, and what the host must not invent:
; - Bind 127.0.0.1 only. Publishing the port, or binding any other host, is
;   refused. CDP port 9333 is the embedded agent page's loopback debug port
;   (glass_window BR_CDP_PORT). It is not this bridge and it is never published
;   (browser_pod cdp_publish_refusal).
; - Pixels of the native window are the CGBitmap glass_window hands to the
;   layer. NATIVE_EXPORT is 0: those bytes are not written out and are not
;   on this socket. frame.jpg under ~/.t27os/browser/ is the embedded page
;   screencast. It may be the GET body only while the pump pid is alive, and
;   that body does not set E2E_PASSED. A text/html body is not a picture.
; - Input that would reach the native window is NOT_WIRED until E2E_PASSED.
;   The embedded inbox (in.txt) accepts one pump line while that pump is
;   alive; the line is the grammar BR_PUMP_SCRIPT already reads. A secret
;   field is refused first. The bridge does not read the Keychain and does
;   not put a secret in the response.
; - The accept loop is not in this file. An @extern import would stop these
;   tests (pty_logic.t27). A listener may only do what the functions below
;   decide.
; - Sessions under ~/.t27os/sessions are written by the pty server only
;   (session_store pane-<id>.tmp then rename; a second server sees the live
;   unix socket and exits). This bridge never writes a record and never
;   spawns T27OS.app. A reconnect attaches or refuses.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserNativeBridge;

use t27os::browser_pod::cdp_publish_refusal;
use t27os::browser_pod::R_CDP_PUBLISH;
use t27os::browser_tab::LAYER_COUNT;
use t27os::browser_tab::TAB_LETTER;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

; --- 1. Release line and capability -------------------------------------------------------

pub const DESKTOP_RELEASE : string = "0.3.1";
pub const BRIDGE_LINE : string = "0.3.2";

/// 0 until a loopback client has seen native pixels and a returned input has
/// changed the native window. Do not set this from a screenshot of frame.jpg.
pub const E2E_PASSED : u32 = 0;

pub const VIEW_ONLY : u32 = 1;
pub const VIEW_NATIVE : u32 = 2;

pub const NATIVE_SOURCE : string = "glass_window";
pub const EMBEDDED_FRAME : string = "frame.jpg";

; --- 2. Loopback endpoint -----------------------------------------------------------------

pub const BRIDGE_HOST : string = "127.0.0.1";
/// Free of the pty router (47127), the dash origin (3080) and CDP (9333).
pub const BRIDGE_PORT : u32 = 47131;
pub const VIEW_PATH : string = "/live/native";
pub const INPUT_PATH : string = "/live/native/input";

pub const CDP_PORT : u32 = 9333;

pub const R_OK : u32 = 0;
pub const R_NOT_LOOPBACK : u32 = 403;
pub const R_NOT_WIRED : u32 = 501;
pub const R_SECRET : u32 = 400;
pub const R_SECOND_WRITER : u32 = 423;

; --- 3. Bind and CDP scope ----------------------------------------------------------------

/// True only for the literal loopback address. A name, a wildcard or an
/// empty host is not loopback.
pub fn loopback_host(host : string) -> bool {
    return host == BRIDGE_HOST;
}

/// A bind is lawful only on the loopback literal and only when the port is
/// not published off the machine.
pub fn bind_refusal(host : string, publish : bool) -> u32 {
    if (publish) { return R_NOT_LOOPBACK; }
    if (!loopback_host(host)) { return R_NOT_LOOPBACK; }
    return R_OK;
}

/// CDP 9333 is the embedded page debug port, never the desktop bridge.
pub fn cdp_is_desktop_bridge() -> bool {
    return false;
}

/// The embedded debug port may listen on loopback. Any publish is refused,
/// and so is any other port presented as this scope.
pub fn cdp_scope_ok(port : u32, loopback : bool, published : bool) -> bool {
    if (published) { return false; }
    if (!loopback) { return false; }
    if (cdp_is_desktop_bridge()) { return false; }
    return port == CDP_PORT;
}

; --- 4. Pixels and input -------------------------------------------------------------------

/// The native picture is the window the app draws. The JPEG the pump writes
/// is the embedded page.
pub fn source_is_native(name : string) -> bool {
    return name == NATIVE_SOURCE;
}

pub fn source_is_embedded_frame(name : string) -> bool {
    return name == EMBEDDED_FRAME;
}

/// VIEW_ONLY until the end-to-end flag is set. A frame.jpg body does not
/// flip this.
pub fn view_mode() -> u32 {
    if (E2E_PASSED == 0) { return VIEW_ONLY; }
    return VIEW_NATIVE;
}

pub fn e2e_passed() -> bool {
    return E2E_PASSED == 1;
}

/// Secret field names that must never appear in a client payload or a
/// response body. Compared as whole names, not as substrings.
pub fn payload_secret(field : string) -> bool {
    if (field == "authorization") { return true; }
    if (field == "cookie") { return true; }
    if (field == "key") { return true; }
    if (field == "token") { return true; }
    return false;
}

/// Native input is unwired until E2E_PASSED. A secret field is refused
/// first, so a wired bridge still drops it.
pub fn input_refusal(field : string) -> u32 {
    if (payload_secret(field)) { return R_SECRET; }
    if (!e2e_passed()) { return R_NOT_WIRED; }
    return R_OK;
}

pub fn path_is_bridge(path : string) -> bool {
    if (path == VIEW_PATH) { return true; }
    if (path == INPUT_PATH) { return true; }
    return false;
}

; --- 5. Session attach, no second writer, no spawn ----------------------------------------

pub const ATTACH : u32 = 1;
pub const REFUSE : u32 = 2;

/// The bridge never opens T27OS.app. Every combination of beat, path and
/// pty liveness is still a refusal to spawn. The pty supervisor owns relaunch.
pub fn spawn_on_reconnect(beat_fresh : bool, path_is_app : bool, pty_live : bool) -> bool {
    if (beat_fresh or path_is_app or pty_live) { return false; }
    return false;
}

/// A fresh beat whose executable is the app, or a live pty socket, means
/// attach. Anything else is a refusal. Neither result spawns a window.
pub fn reconnect_action(beat_fresh : bool, path_is_app : bool, pty_live : bool) -> u32 {
    if (spawn_on_reconnect(beat_fresh, path_is_app, pty_live)) { return REFUSE; }
    if (beat_fresh and path_is_app) { return ATTACH; }
    if (pty_live) { return ATTACH; }
    return REFUSE;
}

/// This module is not the pty server, so it cannot write pane-<id>.rec.
pub fn bridge_session_write_refusal() -> u32 {
    return R_SECOND_WRITER;
}

pub fn bridge_writes_sessions() -> bool {
    return false;
}

pub fn release_bump_allowed() -> bool {
    return false;
}

; --- 6. Picture bytes and the embedded inbox ------------------------------------------------

/// 0 until glass_window writes the CGBitmap it already draws. Do not raise
/// this because frame.jpg exists.
pub const NATIVE_EXPORT : u32 = 0;

pub const PIXEL_NONE : u32 = 0;
pub const PIXEL_JPEG : u32 = 1;
pub const PIXEL_PNG : u32 = 2;
pub const PIXEL_NATIVE : u32 = 3;

pub const ROUTE_NONE : u32 = 0;
pub const ROUTE_VIEW : u32 = 1;
pub const ROUTE_INPUT : u32 = 2;
/// GET /live/state: read-only structured state (state-only surface; view stays VIEW_ONLY).
pub const ROUTE_STATE : u32 = 3;

/// JSON body kind for the state endpoint (no pixels behind this kind).
pub const PIXEL_JSON : u32 = 4;

/// Same HTTP status as a secret refusal. Secret is checked first.
pub const R_BAD : u32 = 400;

pub fn native_framebuffer_export() -> bool {
    return NATIVE_EXPORT == 1;
}

/// Live pump plus file magic. A dead pump keeps a stale JPEG off the socket.
/// Native export, when it exists, wins over either embedded file.
pub fn pixel_kind(pump_alive : bool, b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> u32 {
    if (NATIVE_EXPORT == 1) { return PIXEL_NATIVE; }
    if (!pump_alive) { return PIXEL_NONE; }
    if (b0 == 255 and b1 == 216) { return PIXEL_JPEG; }
    if (b0 == 137 and b1 == 80 and b2 == 78 and b3 == 71) { return PIXEL_PNG; }
    return PIXEL_NONE;
}

pub fn serves_native_pixels(kind : u32) -> bool {
    return kind == PIXEL_NATIVE;
}

pub fn view_status(kind : u32) -> u32 {
    if (kind == PIXEL_JPEG or kind == PIXEL_PNG or kind == PIXEL_NATIVE) { return 200; }
    return 503;
}

pub fn content_type_of(kind : u32) -> string {
    if (kind == PIXEL_JPEG) { return "image/jpeg"; }
    if (kind == PIXEL_PNG or kind == PIXEL_NATIVE) { return "image/png"; }
    if (kind == PIXEL_JSON) { return "application/json"; }
    return "text/plain";
}

pub fn source_name_of(kind : u32) -> string {
    if (kind == PIXEL_NATIVE) { return NATIVE_SOURCE; }
    if (kind == PIXEL_JPEG) { return EMBEDDED_FRAME; }
    if (kind == PIXEL_PNG) { return "frame.png"; }
    if (kind == PIXEL_JSON) { return "state.json"; }
    return "none";
}

/// The embedded screencast is never the end-to-end pass. Native kind still
/// needs E2E_PASSED, which this file leaves at 0.
pub fn e2e_from_kind(kind : u32) -> bool {
    if (kind != PIXEL_NATIVE) { return false; }
    return E2E_PASSED == 1;
}

pub fn html_body_refused(mime : string) -> bool {
    return mime == "text/html";
}

pub fn text_body(code : u32) -> string {
    if (code == 200) { return "inbox\n"; }
    if (code == 400) { return "refused\n"; }
    if (code == 501) { return "not-wired\n"; }
    if (code == 503) { return "no-frame\n"; }
    return "";
}

pub fn span_eq(s : []const u8, a : usize, n : usize, w : []const u8) -> bool {
    if (n != w.len) { return false; }
    if (a + n > s.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (s[a + i] != w[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn has_bytes(s : []const u8, w : []const u8) -> bool {
    if (w.len == 0 or w.len > s.len) { return false; }
    var i : usize = 0;
    while (i + w.len <= s.len) {
        if (span_eq(s, i, w.len, w)) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn route_of(method : []const u8, path : []const u8) -> u32 {
    if (span_eq(method, 0, method.len, "GET") and span_eq(path, 0, path.len, "/live/native")) { return ROUTE_VIEW; }
    if (span_eq(method, 0, method.len, "POST") and span_eq(path, 0, path.len, "/live/native/input")) { return ROUTE_INPUT; }
    if (span_eq(method, 0, method.len, "GET") and span_eq(path, 0, path.len, "/live/state")) { return ROUTE_STATE; }
    return ROUTE_NONE;
}

/// CR LF. A `"\r"` string is a backslash and an r in this compiler, not byte 13.
fn put_crlf(out : []u8, at : usize) -> usize {
    if (at + 2 > out.len) { return at; }
    out[at] = 13;
    out[at + 1] = 10;
    return at + 2;
}

/// The head a listener sends. VIEW_ONLY stays on the wire until E2E_PASSED.
/// No Content-Length: the picture is streamed and the socket then closes.
pub fn put_head(out : []u8, code : u32, kind : u32) -> usize {
    var n : usize = put_bytes(out, 0, "HTTP/1.1 ");
    n = put_dec(out, n, @as(u64, @intCast(code)));
    n = put_bytes(out, n, " ");
    if (code == 200) { n = put_bytes(out, n, "OK"); }
    else if (code == 400) { n = put_bytes(out, n, "Bad Request"); }
    else if (code == 404) { n = put_bytes(out, n, "Not Found"); }
    else if (code == 501) { n = put_bytes(out, n, "Not Implemented"); }
    else { n = put_bytes(out, n, "Service Unavailable"); }
    n = put_crlf(out, n);
    n = put_bytes(out, n, "Content-Type: ");
    if (kind == PIXEL_JPEG) { n = put_bytes(out, n, "image/jpeg"); }
    else if (kind == PIXEL_PNG or kind == PIXEL_NATIVE) { n = put_bytes(out, n, "image/png"); }
    else if (kind == PIXEL_JSON) { n = put_bytes(out, n, "application/json"); }
    else { n = put_bytes(out, n, "text/plain"); }
    n = put_crlf(out, n);
    n = put_bytes(out, n, "X-T27-Source: ");
    if (kind == PIXEL_NATIVE) { n = put_bytes(out, n, "glass_window"); }
    else if (kind == PIXEL_JPEG) { n = put_bytes(out, n, "frame.jpg"); }
    else if (kind == PIXEL_PNG) { n = put_bytes(out, n, "frame.png"); }
    else if (kind == PIXEL_JSON) { n = put_bytes(out, n, "state.json"); }
    else { n = put_bytes(out, n, "none"); }
    n = put_crlf(out, n);
    n = put_bytes(out, n, "X-T27-View: VIEW_ONLY");
    n = put_crlf(out, n);
    n = put_bytes(out, n, "Cache-Control: no-store");
    n = put_crlf(out, n);
    n = put_bytes(out, n, "Connection: close");
    n = put_crlf(out, n);
    n = put_crlf(out, n);
    return n;
}

/// The head for GET /live/state: like put_head plus X-T27-Seq (the state version).
pub fn put_state_head(out : []u8, code : u32, seq : u64) -> usize {
    var n : usize = put_head(out, code, PIXEL_JSON);
    if (n == 0 or n + 32 > out.len) { return 0; }
    n = n - 2;
    n = put_bytes(out, n, "X-T27-Seq: ");
    n = put_dec(out, n, seq);
    n = put_crlf(out, n);
    n = put_crlf(out, n);
    return n;
}

fn line_len(s : []const u8) -> usize {
    var n : usize = s.len;
    if (n > 0 and s[n - 1] == 10) { n = n - 1; }
    if (n > 0 and s[n - 1] == 13) { n = n - 1; }
    return n;
}

fn take_uint(s : []const u8, i : usize, n : usize) -> usize {
    if (i >= n) { return i; }
    if (s[i] < 48 or s[i] > 57) { return i; }
    var j : usize = i;
    while (j < n and s[j] >= 48 and s[j] <= 57) { j = j + 1; }
    return j;
}

fn verb_end(s : []const u8, n : usize) -> usize {
    var i : usize = 0;
    while (i < n and s[i] != 32) { i = i + 1; }
    return i;
}

fn click_ok(s : []const u8, v : usize, n : usize) -> bool {
    if (v >= n or s[v] != 32) { return false; }
    const a : usize = take_uint(s, v + 1, n);
    if (a == v + 1 or a >= n or s[a] != 32) { return false; }
    const b : usize = take_uint(s, a + 1, n);
    if (b == a + 1) { return false; }
    if (b == n) { return true; }
    if (s[b] != 32) { return false; }
    const c : usize = take_uint(s, b + 1, n);
    return c == n and c != b + 1;
}

fn scroll_ok(s : []const u8, v : usize, n : usize) -> bool {
    if (v >= n or s[v] != 32) { return false; }
    var i : usize = v + 1;
    if (i < n and s[i] == 45) { i = i + 1; }
    const e : usize = take_uint(s, i, n);
    return e == n and e != i;
}

fn keys_ok(s : []const u8, v : usize, n : usize) -> bool {
    if (v >= n or s[v] != 32) { return false; }
    var i : usize = v + 1;
    if (i >= n) { return false; }
    var digit : bool = false;
    var prev_comma : bool = true;
    while (i < n) {
        const c : u8 = s[i];
        if (c >= 48 and c <= 57) {
            digit = true;
            prev_comma = false;
        } else if (c == 44) {
            if (prev_comma) { return false; }
            prev_comma = true;
        } else {
            return false;
        }
        i = i + 1;
    }
    return digit and !prev_comma;
}

fn go_ok(s : []const u8, v : usize, n : usize) -> bool {
    if (v >= n or s[v] != 32) { return false; }
    if (v + 1 >= n) { return false; }
    var i : usize = v + 1;
    while (i < n) {
        const c : u8 = s[i];
        if (c < 33 or c > 126) { return false; }
        i = i + 1;
    }
    return true;
}

fn fit_ok(s : []const u8, v : usize, n : usize) -> bool {
    if (v >= n or s[v] != 32) { return false; }
    const a : usize = take_uint(s, v + 1, n);
    if (a == v + 1 or a >= n or s[a] != 32) { return false; }
    const b : usize = take_uint(s, a + 1, n);
    return b == n and b != a + 1;
}

/// One line the resident pump already accepts: click, scroll, keys, go,
/// back, forward, reload, fit. Whole-word secrets are not a line.
pub fn inbox_shape_ok(s : []const u8) -> bool {
    const n : usize = line_len(s);
    if (n == 0 or n > 240) { return false; }
    const v : usize = verb_end(s, n);
    if (v == 0) { return false; }
    if (span_eq(s, 0, v, "back") or span_eq(s, 0, v, "forward") or span_eq(s, 0, v, "reload")) {
        return v == n;
    }
    if (span_eq(s, 0, v, "click")) { return click_ok(s, v, n); }
    if (span_eq(s, 0, v, "scroll")) { return scroll_ok(s, v, n); }
    if (span_eq(s, 0, v, "keys")) { return keys_ok(s, v, n); }
    if (span_eq(s, 0, v, "go")) { return go_ok(s, v, n); }
    if (span_eq(s, 0, v, "fit")) { return fit_ok(s, v, n); }
    return false;
}

pub fn line_has_secret(s : []const u8) -> bool {
    const n : usize = line_len(s);
    var i : usize = 0;
    while (i < n) {
        while (i < n and s[i] == 32) { i = i + 1; }
        const a : usize = i;
        while (i < n and s[i] != 32) { i = i + 1; }
        if (a == i) { return false; }
        if (span_eq(s, a, i - a, "authorization")) { return true; }
        if (span_eq(s, a, i - a, "cookie")) { return true; }
        if (span_eq(s, a, i - a, "key")) { return true; }
        if (span_eq(s, a, i - a, "token")) { return true; }
    }
    return false;
}

/// Embedded inbox, not the native window. Secret first, then shape, then
/// the live pump. A lawful line does not flip view_mode.
pub fn inbox_refusal(line : []const u8, pump_alive : bool) -> u32 {
    if (line_has_secret(line)) { return R_SECRET; }
    if (!inbox_shape_ok(line)) { return R_BAD; }
    if (!pump_alive) { return R_NOT_WIRED; }
    return R_OK;
}

; --- 7. Tests --------------------------------------------------------------------------------

test release_line_does_not_bump_desktop {
    assert DESKTOP_RELEASE == "0.3.1";
    assert BRIDGE_LINE == "0.3.2";
    assert DESKTOP_RELEASE != BRIDGE_LINE;
    assert !release_bump_allowed();
    assert TAB_LETTER == 2;
    assert LAYER_COUNT == 7;
}

test capability_stays_view_only_until_e2e {
    assert E2E_PASSED == 0;
    assert !e2e_passed();
    assert view_mode() == VIEW_ONLY;
    assert view_mode() != VIEW_NATIVE;
    assert source_is_native("glass_window");
    assert !source_is_native("frame.jpg");
    assert source_is_embedded_frame("frame.jpg");
    assert !source_is_embedded_frame("glass_window");
}

test bind_is_loopback_and_cdp_stays_unpublished {
    assert bind_refusal("127.0.0.1", false) == R_OK;
    assert bind_refusal("0.0.0.0", false) == R_NOT_LOOPBACK;
    assert bind_refusal("localhost", false) == R_NOT_LOOPBACK;
    assert bind_refusal("", false) == R_NOT_LOOPBACK;
    assert bind_refusal("127.0.0.1", true) == R_NOT_LOOPBACK;
    assert !cdp_is_desktop_bridge();
    assert cdp_scope_ok(9333, true, false);
    assert !cdp_scope_ok(9333, true, true);
    assert !cdp_scope_ok(9333, false, false);
    assert !cdp_scope_ok(9222, true, false);
    assert cdp_publish_refusal(true) == R_CDP_PUBLISH;
    assert cdp_publish_refusal(false) != R_CDP_PUBLISH;
}

test input_is_unwired_and_drops_secrets {
    assert input_refusal("click") == R_NOT_WIRED;
    assert input_refusal("authorization") == R_SECRET;
    assert input_refusal("cookie") == R_SECRET;
    assert input_refusal("key") == R_SECRET;
    assert input_refusal("token") == R_SECRET;
    assert !payload_secret("click");
    assert path_is_bridge("/live/native");
    assert path_is_bridge("/live/native/input");
    assert !path_is_bridge("/live/s1");
    assert !path_is_bridge("/api/browser/session");
}

test a_live_pump_jpeg_is_not_the_native_window {
    assert NATIVE_EXPORT == 0;
    assert !native_framebuffer_export();
    assert pixel_kind(true, 255, 216, 0, 0) == PIXEL_JPEG;
    assert pixel_kind(true, 137, 80, 78, 71) == PIXEL_PNG;
    assert pixel_kind(false, 255, 216, 0, 0) == PIXEL_NONE;
    assert pixel_kind(true, 0, 0, 0, 0) == PIXEL_NONE;
    assert view_status(PIXEL_JPEG) == 200;
    assert view_status(PIXEL_PNG) == 200;
    assert view_status(PIXEL_NONE) == 503;
    assert content_type_of(PIXEL_JPEG) == "image/jpeg";
    assert content_type_of(PIXEL_PNG) == "image/png";
    assert content_type_of(PIXEL_NONE) == "text/plain";
    assert content_type_of(PIXEL_JPEG) != "text/html";
    assert content_type_of(PIXEL_NONE) != "text/html";
    assert html_body_refused("text/html");
    assert !html_body_refused("image/jpeg");
    assert source_name_of(PIXEL_JPEG) == "frame.jpg";
    assert source_name_of(PIXEL_PNG) == "frame.png";
    assert source_name_of(PIXEL_NATIVE) == "glass_window";
    assert source_name_of(PIXEL_NONE) == "none";
    assert !serves_native_pixels(PIXEL_JPEG);
    assert serves_native_pixels(PIXEL_NATIVE);
    assert !e2e_from_kind(PIXEL_JPEG);
    assert !e2e_from_kind(PIXEL_PNG);
    assert !e2e_from_kind(PIXEL_NATIVE);
    assert !e2e_from_kind(PIXEL_NONE);
    assert view_mode() == VIEW_ONLY;
}

test the_head_names_the_embedded_file_and_stays_view_only {
    var h : [512]u8 = undefined;
    const n : usize = put_head(h[0..512], 200, PIXEL_JPEG);
    assert n > 0 and n < 512;
    assert has_bytes(h[0..n], "HTTP/1.1 200 OK");
    assert has_bytes(h[0..n], "Content-Type: image/jpeg");
    assert has_bytes(h[0..n], "X-T27-Source: frame.jpg");
    assert has_bytes(h[0..n], "X-T27-View: VIEW_ONLY");
    assert h[15] == 13 and h[16] == 10;
    assert !has_bytes(h[0..n], "text/html");
    const z : usize = put_head(h[0..512], 503, PIXEL_NONE);
    assert has_bytes(h[0..z], "HTTP/1.1 503 Service Unavailable");
    assert has_bytes(h[0..z], "Content-Type: text/plain");
    assert has_bytes(h[0..z], "X-T27-Source: none");
    assert text_body(503) == "no-frame\n";
    assert text_body(501) == "not-wired\n";
    assert text_body(400) == "refused\n";
    assert text_body(200) == "inbox\n";
}

test routes_are_the_two_bridge_paths {
    assert route_of("GET", "/live/native") == ROUTE_VIEW;
    assert route_of("POST", "/live/native/input") == ROUTE_INPUT;
    assert route_of("GET", "/live/native/input") == ROUTE_NONE;
    assert route_of("POST", "/live/native") == ROUTE_NONE;
    assert route_of("GET", "/live/s1") == ROUTE_NONE;
    assert route_of("GET", "/live/state") == ROUTE_STATE;
    assert route_of("POST", "/live/state") == ROUTE_NONE;
    assert VIEW_PATH == "/live/native";
    assert INPUT_PATH == "/live/native/input";
}

test the_inbox_accepts_a_pump_line_only_while_the_pump_is_alive {
    assert inbox_refusal("click 1 2 1", true) == R_OK;
    assert inbox_refusal("click 1 2", true) == R_OK;
    assert inbox_refusal("scroll 1", true) == R_OK;
    assert inbox_refusal("scroll -4", true) == R_OK;
    assert inbox_refusal("keys 32,13", true) == R_OK;
    assert inbox_refusal("go https://t27.ai", true) == R_OK;
    assert inbox_refusal("back", true) == R_OK;
    assert inbox_refusal("forward", true) == R_OK;
    assert inbox_refusal("reload", true) == R_OK;
    assert inbox_refusal("fit 911 725", true) == R_OK;
    assert inbox_refusal("scroll 1\n", true) == R_OK;
    assert inbox_refusal("click 1 2 1", false) == R_NOT_WIRED;
    assert inbox_refusal("click", true) == R_BAD;
    assert inbox_refusal("key 1", true) == R_BAD;
    assert inbox_refusal("go", true) == R_BAD;
    assert inbox_refusal("keys ,32", true) == R_BAD;
    assert inbox_refusal("token", true) == R_SECRET;
    assert inbox_refusal("click 1 2 1 token", true) == R_SECRET;
    assert inbox_refusal("authorization", false) == R_SECRET;
    assert input_refusal("click") == R_NOT_WIRED;
    assert view_mode() == VIEW_ONLY;
}

test reconnect_attaches_or_refuses_and_never_spawns {
    assert !spawn_on_reconnect(true, true, true);
    assert !spawn_on_reconnect(false, false, true);
    assert !spawn_on_reconnect(false, false, false);
    assert reconnect_action(true, true, true) == ATTACH;
    assert reconnect_action(false, false, true) == ATTACH;
    assert reconnect_action(true, false, false) == REFUSE;
    assert reconnect_action(false, false, false) == REFUSE;
    assert bridge_session_write_refusal() == R_SECOND_WRITER;
    assert !bridge_writes_sessions();
}

invariant view_only_while_e2e_is_open {
    assert view_mode() == VIEW_ONLY;
    assert !e2e_passed();
    assert !cdp_is_desktop_bridge();
    assert !bridge_writes_sessions();
    assert !release_bump_allowed();
    assert !native_framebuffer_export();
    assert !e2e_from_kind(PIXEL_JPEG);
    assert content_type_of(PIXEL_NONE) != "text/html";
}
