// SPDX-License-Identifier: Apache-2.0
// specs/t27os/peer_id.t27 -- Unique T27 OS User Number and Peer Target Addressing.
// Pure .t27 specification (zero @extern calls, ASCII/English only, L3/L4 compliant).
// Derives a deterministic, human-shareable 8-digit T27 number ("T27-XXXX-XXXX") from
// the local ~/.t27os/identity key file so any other T27 OS user can find this user in
// Peer Chat or place a Voice Call using that number.
//
// Namespace prefix: pid_ / PID_ (flat-namespace safe across all t27b imports).

module T27osPeerId;

pub const PID_LEN : usize = 13;
pub const PID_DIGITS : usize = 8;
pub const PID_DEFAULT_PORT : u32 = 47727;
pub const PID_PORT_MIN : u32 = 1024;
pub const PID_PORT_MAX : u32 = 65535;
pub const PID_HOST_MAX : usize = 64;
pub const PID_SHARE_MAX : usize = 128;
pub const PID_ID_MIN_BYTES : usize = 8;
pub const PID_PATH_MAX : usize = 512;

// ---------------------------------------------------------------- 1. Deterministic hash

/// Overflow-safe 64-bit mixing hash (no wrapping ops in t27 dialect).
/// Masks to 32 bits before multiplying by FNV prime 16777619 (max product < 2^56).
pub fn pid_hash64(data: []const u8) -> u64 {
    var h1 : u64 = 2166136261;
    var h2 : u64 = 3735928559;
    var i : usize = 0;
    while (i < data.len) {
        const b : u64 = @as(u64, data[i]);
        h1 = ((h1 ^ b) & 4294967295) * 16777619;
        h1 = (h1 ^ (h1 >> 16)) & 4294967295;
        h2 = ((h2 ^ (b + @as(u64, i & 255))) & 4294967295) * 2246822519;
        h2 = (h2 ^ (h2 >> 13)) & 4294967295;
        i = i + 1;
    }
    return ((h1 & 4294967295) << 32) | (h2 & 4294967295);
}

/// Write a single decimal digit (0..9) as ASCII '0'..'9'.
fn pid_digit_ch(v: u64) -> u8 {
    return @as(u8, @intCast(48 + (v % 10)));
}

/// Derive canonical unique number "T27-DDDD-DDDD" (13 bytes) from identity bytes.
/// Returns 13 on success, 0 if data is too short (< 8 bytes) or out < 13 bytes.
pub fn pid_from_identity(data: []const u8, out: []u8) -> usize {
    if (data.len < PID_ID_MIN_BYTES or out.len < PID_LEN) { return 0; }
    const h : u64 = pid_hash64(data);
    // Use high and low 32-bit halves mod 10000 so both 4-digit groups are uniformly spread.
    // Avoid 0000-0000 by folding if both halves are zero.
    var hi : u64 = ((h >> 32) & 4294967295) % 10000;
    var lo : u64 = (h & 4294967295) % 10000;
    if (hi == 0 and lo == 0) { hi = 2727; lo = 9999; }
    out[0] = 84;  // 'T'
    out[1] = 50;  // '2'
    out[2] = 55;  // '7'
    out[3] = 45;  // '-'
    out[4] = pid_digit_ch(hi / 1000);
    out[5] = pid_digit_ch((hi / 100) % 10);
    out[6] = pid_digit_ch((hi / 10) % 10);
    out[7] = pid_digit_ch(hi % 10);
    out[8] = 45;  // '-'
    out[9] = pid_digit_ch(lo / 1000);
    out[10] = pid_digit_ch((lo / 100) % 10);
    out[11] = pid_digit_ch((lo / 10) % 10);
    out[12] = pid_digit_ch(lo % 10);
    return PID_LEN;
}

// ---------------------------------------------------------------- 2. Validation & normalization

fn pid_is_digit(c: u8) -> bool {
    return c >= 48 and c <= 57;
}

fn pid_is_space(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
}

/// Exact canonical check: "T27-DDDD-DDDD" (13 ASCII bytes).
pub fn pid_valid(s: []const u8) -> bool {
    if (s.len != PID_LEN) { return false; }
    if (s[0] != 84 or s[1] != 50 or s[2] != 55 or s[3] != 45 or s[8] != 45) { return false; }
    if (pid_is_digit(s[4]) == false or pid_is_digit(s[5]) == false) { return false; }
    if (pid_is_digit(s[6]) == false or pid_is_digit(s[7]) == false) { return false; }
    if (pid_is_digit(s[9]) == false or pid_is_digit(s[10]) == false) { return false; }
    if (pid_is_digit(s[11]) == false or pid_is_digit(s[12]) == false) { return false; }
    return true;
}

/// Normalize user input ("t27-1234-5678", "1234-5678", "1234 5678", "12345678", "T2712345678")
/// into canonical "T27-1234-5678". Returns 13 on success, 0 if invalid.
pub fn pid_normalize(raw: []const u8, out: []u8) -> usize {
    if (out.len < PID_LEN) { return 0; }
    var start : usize = 0;
    var end : usize = raw.len;
    while (start < end and pid_is_space(raw[start])) { start = start + 1; }
    while (end > start and pid_is_space(raw[end - 1])) { end = end - 1; }
    if (start >= end) { return 0; }
    // Optional leading "T27" / "t27" prefix (optionally followed by '-' or ' ').
    if (end - start >= 3 and (raw[start] == 84 or raw[start] == 116) and raw[start + 1] == 50 and raw[start + 2] == 55) {
        start = start + 3;
        if (start < end and (raw[start] == 45 or raw[start] == 32)) { start = start + 1; }
    }
    var digs : [8]u8 = undefined;
    var dn : usize = 0;
    var i : usize = start;
    while (i < end) {
        const c : u8 = raw[i];
        if (pid_is_digit(c)) {
            if (dn >= PID_DIGITS) { return 0; }
            digs[dn] = c;
            dn = dn + 1;
        } else if (c == 45 or c == 32) {
            // Separator allowed between digit groups.
        } else {
            return 0;
        }
        i = i + 1;
    }
    if (dn != PID_DIGITS) { return 0; }
    out[0] = 84;
    out[1] = 50;
    out[2] = 55;
    out[3] = 45;
    out[4] = digs[0];
    out[5] = digs[1];
    out[6] = digs[2];
    out[7] = digs[3];
    out[8] = 45;
    out[9] = digs[4];
    out[10] = digs[5];
    out[11] = digs[6];
    out[12] = digs[7];
    return PID_LEN;
}

/// Byte-exact equality helper for two peer IDs or byte slices.
pub fn pid_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------- 3. Target address parser

fn pid_host_char_ok(c: u8) -> bool {
    if (c >= 48 and c <= 57) { return true; }   // 0-9
    if (c >= 65 and c <= 90) { return true; }   // A-Z
    if (c >= 97 and c <= 122) { return true; }  // a-z
    if (c == 46 or c == 45) { return true; }    // . -
    return false;
}

/// Parse a peer lookup / dial target:
///   "T27-1234-5678"                   -> id="T27-1234-5678", host="",            port=47727
///   "12345678@192.168.1.5"            -> id="T27-1234-5678", host="192.168.1.5", port=47727
///   "T27-1234-5678@127.0.0.1:47728"   -> id="T27-1234-5678", host="127.0.0.1",   port=47728
/// Writes out_lens[0]=id_len, out_lens[1]=host_len, out_lens[2]=port.
/// Returns true if valid, false otherwise.
pub fn pid_parse_target(raw: []const u8, id_out: []u8, host_out: []u8, out_lens: []u32) -> bool {
    if (out_lens.len < 3 or id_out.len < PID_LEN) { return false; }
    out_lens[0] = 0;
    out_lens[1] = 0;
    out_lens[2] = PID_DEFAULT_PORT;
    var s : usize = 0;
    var e : usize = raw.len;
    while (s < e and pid_is_space(raw[s])) { s = s + 1; }
    while (e > s and pid_is_space(raw[e - 1])) { e = e - 1; }
    if (s >= e) { return false; }
    // Look for '@' splitting number and host[:port].
    var at : usize = e;
    var i : usize = s;
    while (i < e) {
        if (raw[i] == 64) {
            at = i;
            break;
        }
        i = i + 1;
    }
    const idn : usize = pid_normalize(raw[s..at], id_out);
    if (idn != PID_LEN) { return false; }
    out_lens[0] = @as(u32, @intCast(idn));
    if (at == e) {
        return true;
    }
    // Parse host[:port] after '@'.
    const hs : usize = at + 1;
    if (hs >= e) { return false; }
    var colon : usize = e;
    i = hs;
    while (i < e) {
        if (raw[i] == 58) {
            colon = i;
            break;
        }
        i = i + 1;
    }
    const hlen : usize = colon - hs;
    if (hlen == 0 or hlen > PID_HOST_MAX or hlen > host_out.len) { return false; }
    i = 0;
    while (i < hlen) {
        if (pid_host_char_ok(raw[hs + i]) == false) { return false; }
        host_out[i] = raw[hs + i];
        i = i + 1;
    }
    out_lens[1] = @as(u32, @intCast(hlen));
    if (colon < e) {
        const ps : usize = colon + 1;
        if (ps >= e or e - ps > 5) { return false; }
        var pval : u32 = 0;
        i = ps;
        while (i < e) {
            if (pid_is_digit(raw[i]) == false) { return false; }
            pval = pval * 10 + @as(u32, raw[i] - 48);
            i = i + 1;
        }
        if (pval < PID_PORT_MIN or pval > PID_PORT_MAX) { return false; }
        out_lens[2] = pval;
    }
    return true;
}

// ---------------------------------------------------------------- 4. Share text & paths

fn pid_put(out: []u8, pos: usize, s: []const u8) -> usize {
    var p : usize = pos;
    var i : usize = 0;
    while (i < s.len and p < out.len) {
        out[p] = s[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn pid_put_u32(out: []u8, pos: usize, v: u32) -> usize {
    var tmp : [12]u8 = undefined;
    var n : usize = 0;
    var x : u32 = v;
    if (x == 0) {
        tmp[0] = 48;
        n = 1;
    } else {
        while (x > 0 and n < 12) {
            tmp[n] = @as(u8, @intCast(48 + (x % 10)));
            x = x / 10;
            n = n + 1;
        }
    }
    var p : usize = pos;
    while (n > 0 and p < out.len) {
        n = n - 1;
        out[p] = tmp[n];
        p = p + 1;
    }
    return p;
}

/// Format shareable contact text: "T27-XXXX-XXXX (nick) :47727" or "T27-XXXX-XXXX :47727".
pub fn pid_share_text(id: []const u8, nick: []const u8, port: u32, out: []u8) -> usize {
    if (pid_valid(id) == false) { return 0; }
    var p : usize = pid_put(out, 0, id);
    if (nick.len > 0) {
        p = pid_put(out, p, " (");
        p = pid_put(out, p, nick);
        p = pid_put(out, p, ")");
    }
    if (port >= PID_PORT_MIN and port <= PID_PORT_MAX) {
        p = pid_put(out, p, " :");
        p = pid_put_u32(out, p, port);
    }
    return p;
}

/// Build NUL-terminated path "<home>/.t27os/<suffix>" into out; returns byte len excluding NUL.
pub fn pid_home_path(home: []const u8, suffix: []const u8, out: []u8) -> usize {
    if (home.len == 0 or home[0] != 47) { return 0; }
    var hlen : usize = home.len;
    while (hlen > 1 and home[hlen - 1] == 47) { hlen = hlen - 1; }
    const need : usize = hlen + 8 + suffix.len + 1;
    if (need > out.len) { return 0; }
    var p : usize = pid_put(out, 0, home[0..hlen]);
    p = pid_put(out, p, "/.t27os/");
    p = pid_put(out, p, suffix);
    out[p] = 0;
    return p;
}

// ---------------------------------------------------------------- 5. Invariants & tests

invariant pid_constants_valid {
    assert PID_LEN == 13;
    assert PID_DIGITS == 8;
    assert PID_DEFAULT_PORT >= PID_PORT_MIN and PID_DEFAULT_PORT <= PID_PORT_MAX;
}

test pid_derivation_is_deterministic_and_distinct {
    var a : [13]u8 = undefined;
    var b : [13]u8 = undefined;
    var c : [13]u8 = undefined;
    assert pid_from_identity("T27OSID_seed_alpha_0001", a[0..13]) == 13;
    assert pid_from_identity("T27OSID_seed_alpha_0001", b[0..13]) == 13;
    assert pid_from_identity("T27OSID_seed_beta__0002", c[0..13]) == 13;
    assert pid_valid(a[0..13]);
    assert pid_equal(a[0..13], b[0..13]);
    assert pid_valid(c[0..13]);
    assert pid_equal(a[0..13], c[0..13]) == false;
    assert pid_from_identity("short", a[0..13]) == 0;
}

test pid_normalize_accepts_common_user_formats {
    var out : [13]u8 = undefined;
    assert pid_normalize("T27-4821-9304", out[0..13]) == 13;
    assert pid_equal(out[0..13], "T27-4821-9304");
    assert pid_normalize("  t27-4821-9304 \n", out[0..13]) == 13;
    assert pid_equal(out[0..13], "T27-4821-9304");
    assert pid_normalize("48219304", out[0..13]) == 13;
    assert pid_equal(out[0..13], "T27-4821-9304");
    assert pid_normalize("4821 9304", out[0..13]) == 13;
    assert pid_equal(out[0..13], "T27-4821-9304");
    assert pid_normalize("T2748219304", out[0..13]) == 13;
    assert pid_equal(out[0..13], "T27-4821-9304");
    assert pid_normalize("1234567", out[0..13]) == 0;
    assert pid_normalize("123456789", out[0..13]) == 0;
    assert pid_normalize("T27-ABCD-1234", out[0..13]) == 0;
}

test pid_parse_target_handles_number_and_direct_endpoint {
    var id : [13]u8 = undefined;
    var host : [64]u8 = undefined;
    var lens : [3]u32 = undefined;
    assert pid_parse_target("4821-9304", id[0..13], host[0..64], lens[0..3]);
    assert lens[0] == 13 and lens[1] == 0 and lens[2] == 47727;
    assert pid_equal(id[0..13], "T27-4821-9304");

    assert pid_parse_target("T27-4821-9304@192.168.1.42", id[0..13], host[0..64], lens[0..3]);
    assert lens[0] == 13 and lens[1] == 12 and lens[2] == 47727;
    assert pid_equal(host[0..12], "192.168.1.42");

    assert pid_parse_target("48219304@127.0.0.1:47728", id[0..13], host[0..64], lens[0..3]);
    assert lens[0] == 13 and lens[1] == 9 and lens[2] == 47728;
    assert pid_equal(id[0..13], "T27-4821-9304");
    assert pid_equal(host[0..9], "127.0.0.1");

    assert pid_parse_target("T27-4821-9304@127.0.0.1:80", id[0..13], host[0..64], lens[0..3]) == false;
    assert pid_parse_target("T27-4821-9304@", id[0..13], host[0..64], lens[0..3]) == false;
}

test pid_share_text_and_paths {
    var out : [128]u8 = undefined;
    const n : usize = pid_share_text("T27-4821-9304", "dima", 47727, out[0..128]);
    assert pid_equal(out[0..n], "T27-4821-9304 (dima) :47727");
    var p : [128]u8 = undefined;
    const pn : usize = pid_home_path("/Users/d/", "identity", p[0..128]);
    assert pn == 24 and pid_equal(p[0..pn], "/Users/d/.t27os/identity") and p[pn] == 0;
}
