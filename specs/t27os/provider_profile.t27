// SPDX-License-Identifier: Apache-2.0
; specs/t27os/provider_profile.t27 -- what a pane's environment looks like when the provider router is its base URL
; (#11032, M12b stage 2). The pane's agent must not carry the owner's subscription login, or it would send requests to
; the vendor directly and meet "organization has disabled Claude subscription access" instead of reaching the router.
; keys.t27 already names the variables that are stripped at spawn (CLAUDECODE and CLAUDE_CODE_*, plus the endpoint,
; login and model variables of the claude agent); this file does not repeat that list. It states the router's two
; facts about it: a subscription variable never reaches a pane, and the pane's base URL is the router's loopback
; address. The router listens on 127.0.0.1 only. No key value is read or written. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osProviderProfile;

use t27os::keys::AG_CLAUDE;
use t27os::keys::env_stripped;
use t27os::keys::agent_strips;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::editors::same_bytes;

/// The router's loopback prefix.
pub const ROUTER_HOST : []const u8 = "http://127.0.0.1:";

/// Is the variable removed from a pane of this agent at spawn.
pub fn pp_pane_strips(agent: u32, name: []const u8) -> bool {
    return env_stripped(name) or agent_strips(agent, name);
}

/// The base URL a pane is given: the router on this host and port. Returns the length written to out.
pub fn pp_base_url(out: []u8, port: u32) -> usize {
    const p : usize = put_bytes(out, 0, ROUTER_HOST);
    return put_dec(out, p, port as u64);
}

/// The router only accepts a loopback base URL.
pub fn pp_is_loopback(url: []const u8) -> bool {
    const k : usize = ROUTER_HOST.len;
    if (url.len <= k) { return false; }
    return same_bytes(url[0..k], ROUTER_HOST);
}

test "the_login_and_the_endpoint_variables_of_a_claude_pane_are_stripped" {
    assert pp_pane_strips(AG_CLAUDE, "CLAUDECODE");
    assert pp_pane_strips(AG_CLAUDE, "CLAUDE_CODE_OAUTH_TOKEN");
    assert pp_pane_strips(AG_CLAUDE, "ANTHROPIC_AUTH_TOKEN");
    assert pp_pane_strips(AG_CLAUDE, "ANTHROPIC_BASE_URL");
    assert pp_pane_strips(AG_CLAUDE, "ANTHROPIC_API_KEY");
}

test "ordinary_variables_pass_through" {
    assert pp_pane_strips(AG_CLAUDE, "HOME") == false;
    assert pp_pane_strips(AG_CLAUDE, "PATH") == false;
    assert pp_pane_strips(AG_CLAUDE, "T27OS_CWD") == false;
}

test "the_pane_base_url_is_the_router_on_loopback" {
    var out : [48]u8 = undefined;
    const n : usize = pp_base_url(out[0..], 8788);
    assert same_bytes(out[0..n], "http://127.0.0.1:8788");
    assert pp_is_loopback(out[0..n]);
    assert pp_is_loopback("https://api.anthropic.com") == false;
    assert pp_is_loopback("http://127.0.0.1:") == false;
}
