// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agent_home.t27 -- the Agent Home contract: what every agent home page must carry.
; Closes #13870 (see #13862). Pure spec: draws nothing, edits no window spec.
; The page-kind table is read from T27osAgentParts by `use` and called, never copied.
; Pilots: B (BENCH, letter 2), Q (QUEEN, 17), S (SPECS, 19). Honest masks: a field is present only when
; the tree backs it today (a page kind, a refresh period, parts in the gallery); everything else is missing.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osAgentHome;

use t27os::agent_parts::page_kind;
use t27os::agent_parts::page_period;
use t27os::agent_parts::PAGE_NONE;

; --- L1. The 15 contract fields (FR-001) ------------------------------------------------------------------

pub const F_IDENTITY     : u32 = 0;
pub const F_PURPOSE      : u32 = 1;
pub const F_LIVE_STATUS  : u32 = 2;
pub const F_DATA_SOURCES : u32 = 3;
pub const F_WIDGETS      : u32 = 4;
pub const F_SURFACES     : u32 = 5;
pub const F_COMMANDS     : u32 = 6;
pub const F_SKILLS       : u32 = 7;
pub const F_PULSE        : u32 = 8;
pub const F_NAVIGATION   : u32 = 9;
pub const F_EMPTY_STATE  : u32 = 10;
pub const F_ACCESSIBILITY: u32 = 11;
pub const F_THEMES       : u32 = 12;
pub const F_TESTS        : u32 = 13;
pub const F_EVIDENCE     : u32 = 14;
pub const FIELD_COUNT    : u32 = 15;

; Bit of a field in a presence mask: 2^f.
pub fn field_bit(f: u32) -> u32 {
    var b: u32 = 1;
    var i: u32 = 0;
    while (i < f) {
        b = b * 2;
        i = i + 1;
    }
    return b;
}

pub fn all_fields_mask() -> u32 {
    return field_bit(FIELD_COUNT) - 1;
}

pub fn has_field(mask: u32, f: u32) -> bool {
    if (f >= FIELD_COUNT) { return false; }
    return (mask / field_bit(f)) % 2 == 1;
}

pub fn fields_present(mask: u32) -> u32 {
    var n: u32 = 0;
    var f: u32 = 0;
    while (f < FIELD_COUNT) {
        if (has_field(mask, f)) { n = n + 1; }
        f = f + 1;
    }
    return n;
}

pub fn fields_missing(mask: u32) -> u32 {
    return FIELD_COUNT - fields_present(mask);
}

; A home is accepted only with all 15 fields; a missing field refuses it.
pub fn home_accepted(mask: u32) -> bool {
    return fields_present(mask) == FIELD_COUNT;
}

; --- L2. Data states and the LIVE law (FR-002) --------------------------------------------------------------

pub const DS_LIVE         : u32 = 0;
pub const DS_DEMO         : u32 = 1;
pub const DS_NOT_MEASURED : u32 = 2;
pub const DS_FAILED       : u32 = 3;
pub const DS_COUNT        : u32 = 4;

; A source is a bundle of four facts: owner, refresh interval (seconds), failure state, test.
; LIVE is granted only when all four exist. A metric with no connected source is NOT_MEASURED, never a value.
pub fn source_state(connected: bool, has_owner: bool, refresh_s: u32, has_failure_state: bool, has_test: bool) -> u32 {
    if (connected == false) { return DS_NOT_MEASURED; }
    if (has_owner == false) { return DS_NOT_MEASURED; }
    if (refresh_s == 0) { return DS_NOT_MEASURED; }
    if (has_failure_state == false) { return DS_NOT_MEASURED; }
    if (has_test == false) { return DS_NOT_MEASURED; }
    return DS_LIVE;
}

; The state a metric shows: a failed read is FAILED, an unconnected one NOT_MEASURED, a demo feed stays DEMO.
pub fn metric_state(connected: bool, is_demo: bool, read_failed: bool, granted: u32) -> u32 {
    if (connected == false) { return DS_NOT_MEASURED; }
    if (read_failed) { return DS_FAILED; }
    if (is_demo) { return DS_DEMO; }
    return granted;
}

; --- L3. Pilot homes (FR-003) ---------------------------------------------------------------------------------

pub const PILOT_B : u32 = 2;
pub const PILOT_Q : u32 = 17;
pub const PILOT_S : u32 = 19;
pub const PILOT_COUNT : u32 = 3;

pub fn pilot_letter(i: u32) -> u32 {
    if (i == 0) { return PILOT_B; }
    if (i == 1) { return PILOT_Q; }
    if (i == 2) { return PILOT_S; }
    return 0;
}

; Presence mask of a pilot letter, from what the tree backs today:
;   identity, navigation, surfaces -- the letter has a dedicated page kind (page_kind); the page is the surface;
;   widgets are NOT counted: the agent_parts widget loops exceed the comptime branch quota, so missing;
;   pulse                -- the page kind has a refresh period.
; Everything else (purpose, live_status, data_sources, commands, skills, empty_state, accessibility,
; themes, tests, evidence) is declared nowhere yet, so it is missing.
pub fn pilot_mask(letter: u32) -> u32 {
    var m: u32 = 0;
    let k: u32 = page_kind(letter);
    if (k != PAGE_NONE) {
        m = m + field_bit(F_IDENTITY) + field_bit(F_NAVIGATION) + field_bit(F_SURFACES);
        if (page_period(k) > 0) { m = m + field_bit(F_PULSE); }
    }
    return m;
}

pub fn pilot_missing(letter: u32) -> u32 {
    return fields_missing(pilot_mask(letter));
}

; --- L4. Tests (FR-004) ----------------------------------------------------------------------------------------

test fifteen_fields_with_distinct_bits {
    assert FIELD_COUNT == 15;
    assert F_EVIDENCE + 1 == FIELD_COUNT;
    assert field_bit(0) == 1;
    assert field_bit(14) == 16384;
    assert all_fields_mask() == 32767;
    assert fields_present(all_fields_mask()) == 15;
    assert fields_missing(0) == 15;
}

test full_home_is_accepted_and_missing_field_is_refused {
    assert home_accepted(all_fields_mask());
    assert home_accepted(all_fields_mask() - field_bit(F_EVIDENCE)) == false;
    assert home_accepted(all_fields_mask() - field_bit(F_THEMES)) == false;
    assert home_accepted(0) == false;
}

test live_needs_owner_refresh_failure_state_and_test {
    assert source_state(true, true, 60, true, true) == DS_LIVE;
    assert source_state(true, false, 60, true, true) == DS_NOT_MEASURED;
    assert source_state(true, true, 0, true, true) == DS_NOT_MEASURED;
    assert source_state(true, true, 60, false, true) == DS_NOT_MEASURED;
    assert source_state(true, true, 60, true, false) == DS_NOT_MEASURED;
}

test unconnected_metric_is_not_measured_never_a_value {
    assert metric_state(false, false, false, DS_LIVE) == DS_NOT_MEASURED;
    assert metric_state(false, true, false, DS_LIVE) == DS_NOT_MEASURED;
    assert metric_state(true, false, true, DS_LIVE) == DS_FAILED;
    assert metric_state(true, true, false, DS_LIVE) == DS_DEMO;
    assert metric_state(true, false, false, DS_LIVE) == DS_LIVE;
}

test pilots_are_b_q_s_and_no_pilot_passes_today {
    assert pilot_letter(0) == 2;
    assert pilot_letter(1) == 17;
    assert pilot_letter(2) == 19;
    assert page_kind(pilot_letter(0)) != PAGE_NONE;
    assert page_kind(pilot_letter(1)) != PAGE_NONE;
    assert page_kind(pilot_letter(2)) != PAGE_NONE;
    assert home_accepted(pilot_mask(PILOT_B)) == false;
    assert home_accepted(pilot_mask(PILOT_Q)) == false;
    assert home_accepted(pilot_mask(PILOT_S)) == false;
    assert has_field(pilot_mask(PILOT_B), F_IDENTITY);
    assert has_field(pilot_mask(PILOT_B), F_NAVIGATION);
    assert has_field(pilot_mask(PILOT_B), F_PULSE);
    assert has_field(pilot_mask(PILOT_B), F_TESTS) == false;
    assert has_field(pilot_mask(PILOT_B), F_EVIDENCE) == false;
}

test a_letter_with_no_page_has_no_identity {
    assert has_field(pilot_mask(1), F_IDENTITY) == false;
}

invariant every_pilot_misses_at_least_the_unbacked_fields {
    assert pilot_missing(PILOT_B) >= 10;
    assert pilot_missing(PILOT_Q) >= 10;
    assert pilot_missing(PILOT_S) >= 10;
}

invariant states_are_four_and_distinct {
    assert DS_COUNT == 4;
    assert DS_LIVE != DS_DEMO;
    assert DS_NOT_MEASURED != DS_FAILED;
}
