// SPDX-License-Identifier: Apache-2.0
; specs/t27os/woody_select_bot.t27 -- test bot @WoodySelect_bot contract.
// The bot answers in private chats and groups, shows status cards for the
// current task, and has no persistent state beyond the current session.
// Loaded by t27os home page as letter S (Selection) of the 27-agent alphabet.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::bot_woody_select;

pub const KIND : str = "t27os";
pub const ID : str = "bot-woody-select";
pub const NAME : str = "WoodySelect";
pub const VERSION : u32 = 1;
pub const REPO : str = "gHashTag/t27";
pub const BOT_NAME : str = "@WoodySelect_bot";
pub const BOT_TOKEN : str = ""; // owner must fill before first run
pub const ADMIN_CHAT_ID : i64 = 0; // owner chat id for admin commands

pub const MAX_MESSAGE_LEN : u32 = 4096;
pub const POLL_INTERVAL_MS : u32 = 3000;
pub const RETRY_DELAY_MS : u32 = 10000;
pub const MAX_RETRIES : u32 = 3;

pub const COMMAND_START : str = "/start";
pub const COMMAND_HELP : str = "/help";
pub const COMMAND_STATUS : str = "/status";
pub const COMMAND_STOP : str = "/stop";

pub const WELCOME_TEXT : str = "WoodySelect bot online. Test mode. Send /help for commands.";
pub const HELP_TEXT : str = "WoodySelect bot commands:\n/start - start conversation\n/help - show this help\n/status - show bot status\n/stop - stop the bot";

pub fn is_command(text: []u8) -> bool {
    return text.len > 0 && text[0] == '/';
}

pub fn command_name(text: []u8) -> str {
    var i : usize = 1;
    while (i < text.len && text[i] != ' ' && text[i] != '\n') {
        i = i + 1;
    }
    return text[0..i];
}

pub fn is_private(chat_type: str) -> bool {
    return chat_type == "private";
}

test bot_constants {
    assert KIND == "t27os";
    assert ID == "bot-woody-select";
    assert NAME == "WoodySelect";
    assert VERSION == 1;
    assert REPO == "gHashTag/t27";
    assert BOT_NAME == "@WoodySelect_bot";
    assert MAX_MESSAGE_LEN == 4096;
    assert POLL_INTERVAL_MS == 3000;
    assert RETRY_DELAY_MS == 10000;
    assert MAX_RETRIES == 3;
    assert COMMAND_START == "/start";
    assert COMMAND_HELP == "/help";
    assert COMMAND_STATUS == "/status";
    assert COMMAND_STOP == "/stop";
}

test is_command_recognizes_commands {
    assert is_command("/start");
    assert is_command("/help");
    assert is_command("/status");
    assert is_command("/stop");
    assert !is_command("hello");
    assert !is_command("");
}

test command_name_extracts_command {
    assert command_name("/start hello") == "/start";
    assert command_name("/help") == "/help";
    assert command_name("/status extra") == "/status";
    assert command_name("/stop") == "/stop";
}

test is_private_recognizes_private_chat {
    assert is_private("private");
    assert !is_private("group");
    assert !is_private("supergroup");
    assert !is_private("channel");
}

test max_message_len_fits_telegram_limit {
    assert MAX_MESSAGE_LEN == 4096;
}

test retry_delay_is_reasonable {
    assert RETRY_DELAY_MS > 1000;
    assert RETRY_DELAY_MS < 60000;
}

test max_retries_is_small {
    assert MAX_RETRIES > 0;
    assert MAX_RETRIES < 10;
}

test poll_interval_is_reasonable {
    assert POLL_INTERVAL_MS > 1000;
    assert POLL_INTERVAL_MS < 60000;
}

// phi^2 + 1/phi^2 = 3 | TRINITY