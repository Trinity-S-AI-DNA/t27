// SPDX-License-Identifier: Apache-2.0
; specs/t27os/browser_observe.t27 -- observability of the AI-browser, layer 7.
; Everything the agent does in the browser lands in one journal of bounded
; size. The journal is the memory the human reads; the announce rule, the
; watch links and the doctor are the three ways it reaches a person.
; -
; JOURNAL LAW. A step is one record with exactly these fields: ts, actor,
; tool, place, outcome. The journal is a ring of JOURNAL_CAP slots; step n
; lives at slot n mod JOURNAL_CAP and the oldest steps fall off silently.
; Nothing in the browser path waits on the journal.
; -
; THE ANNOUNCE RULE. A notify fires only when the AGENT started the visit;
; the person's own navigation is never announced (it is the person telling
; the machine, not the other way round). Any other agent action (read,
; click, type) is journaled but not announced.
; -
; THE WATCH LINK RULE. A watch link carries a one-time nonce, expires at a
; fixed instant, and dies after its first use. A link that is used, expired
; or reused refuses; a fresh link within its window passes exactly once.
; -
; THE DOCTOR. Four checks, each with a fix command the human can run in one
; step: every tab readable, no stale tab, no blank tab, no unsent text in a
; field. A check without a fix command is out of contract.
; -
; Witness: the TypeScript observability layer in the trios repo (journal,
; notify fan-out, watch-link store, doctor sweep). Pure contract; t27b runs
; the tests below.
; ASCII only (L3), English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserObserve;

; --- 1. The journal ---------------------------------------------------------------------------------

pub const ACTOR_PERSON : u8 = 0;
pub const ACTOR_AGENT : u8 = 1;

pub const OUTCOME_OK : u8 = 0;
pub const OUTCOME_FAIL : u8 = 1;
pub const OUTCOME_BLOCKED : u8 = 2;

pub const JOURNAL_CAP : usize = 64;

pub struct Step {
    pub ts : u64,
    pub actor : u8,
    pub tool : u8,
    pub place : u8,
    pub outcome : u8,
}

/// Slot of step n in the ring.
pub fn ring_slot(n : u64) -> usize {
    return (n % (JOURNAL_CAP as u64)) as usize;
}

/// A step record is well formed: known actor, known outcome, and a ts that
/// is not zero (time began before the browser did).
pub fn step_ok(s : Step) -> bool {
    if (s.ts == 0) { return false; }
    if (s.actor != ACTOR_PERSON and s.actor != ACTOR_AGENT) { return false; }
    return s.outcome == OUTCOME_OK or s.outcome == OUTCOME_FAIL or s.outcome == OUTCOME_BLOCKED;
}

; --- 2. The announce rule ---------------------------------------------------------------------------

pub const ACT_VISIT : u8 = 0;
pub const ACT_READ : u8 = 1;
pub const ACT_TYPE : u8 = 2;
pub const ACT_CLICK : u8 = 3;

/// A notify fires only for a visit the agent started. Person actions and
/// non-visit agent actions journal silently.
pub fn announce_needed(actor : u8, act : u8) -> bool {
    return actor == ACTOR_AGENT and act == ACT_VISIT;
}

; --- 3. Watch links ---------------------------------------------------------------------------------

pub const WATCH_NONCE_LEN : usize = 24;

/// 0 = grant, 1 = already used, 2 = expired, 3 = reused (used and being
/// presented again). The nonce dies at its first successful use; expiry is
/// checked before single-use.
pub fn watch_verdict(used : bool, expired : bool) -> u8 {
    if (expired) { return 2; }
    if (used) { return 1; }
    return 0;
}

/// A nonce is shaped right when it has the full length and is not the zero
/// string (first byte 0 stands for the empty nonce in the byte model).
pub fn nonce_ok(len : usize, first_byte : u8) -> bool {
    return len == WATCH_NONCE_LEN and first_byte != 0;
}

; --- 4. The doctor ----------------------------------------------------------------------------------

pub const DOCTOR_CHECKS : [4]str = ["tab_read", "staleTab", "blank", "unsentText"];
pub const DOCTOR_FIX : [4]str = [
    "browser_read",
    "browser_close_tab",
    "browser_open",
    "browser_type",
];
pub const DOCTOR_COUNT : usize = 4;

/// Doctor row i: named check, non-empty fix command. Row 0 (tab_read) is the
/// only check whose fix is a read; the others all change state.
pub fn doctor_row_ok(i : usize) -> bool {
    if (i >= DOCTOR_COUNT) { return false; }
    if (DOCTOR_CHECKS[i].len == 0) { return false; }
    if (DOCTOR_FIX[i].len == 0) { return false; }
    if (i == 0) { return DOCTOR_FIX[0] == "browser_read"; }
    return DOCTOR_FIX[i] != DOCTOR_FIX[0];
}

/// Index of a doctor check by name; DOCTOR_COUNT when absent.
pub fn doctor_index(name : str) -> usize {
    var i : usize = 0;
    while (i < DOCTOR_COUNT) {
        if (name == DOCTOR_CHECKS[i]) { return i; }
        i = i + 1;
    }
    return DOCTOR_COUNT;
}

invariant the_journal_is_bounded {
    assert JOURNAL_CAP == 64;
    assert ring_slot(0) == 0;
    assert ring_slot(63) == 63;
    assert ring_slot(64) == 0;
    assert ring_slot(1000) < JOURNAL_CAP;
}

invariant only_agent_visits_announce {
    assert announce_needed(ACTOR_AGENT, ACT_VISIT);
    assert !announce_needed(ACTOR_PERSON, ACT_VISIT);
    assert !announce_needed(ACTOR_AGENT, ACT_READ);
    assert !announce_needed(ACTOR_AGENT, ACT_TYPE);
    assert !announce_needed(ACTOR_AGENT, ACT_CLICK);
}

test ring_bound {
    var n : u64 = 0;
    while (n < 200) {
        assert(ring_slot(n) < JOURNAL_CAP);
        n = n + 1;
    }
    assert(ring_slot(127) == 63);
    assert(ring_slot(128) == 0);
}

test step_records_are_well_formed {
    var s : Step;
    s.ts = 1000; s.actor = ACTOR_AGENT; s.tool = 5; s.place = 2; s.outcome = OUTCOME_OK;
    assert(step_ok(s));
    s.ts = 0;
    assert(!step_ok(s));
    s.ts = 1000; s.actor = 9;
    assert(!step_ok(s));
    s.actor = ACTOR_PERSON; s.outcome = 7;
    assert(!step_ok(s));
    s.outcome = OUTCOME_BLOCKED;
    assert(step_ok(s));
}

test announce_filtered_by_actor {
    assert(announce_needed(ACTOR_AGENT, ACT_VISIT));
    assert(!announce_needed(ACTOR_PERSON, ACT_VISIT));
    assert(!announce_needed(ACTOR_PERSON, ACT_CLICK));
    assert(!announce_needed(ACTOR_AGENT, ACT_READ));
    assert(!announce_needed(ACTOR_AGENT, ACT_CLICK));
}

test nonce_single_use_and_expiry {
    assert(WATCH_NONCE_LEN == 24);
    assert(nonce_ok(24, 65));
    assert(!nonce_ok(23, 65));
    assert(!nonce_ok(24, 0));
    assert(watch_verdict(false, false) == 0);
    assert(watch_verdict(true, false) == 1);
    assert(watch_verdict(false, true) == 2);
    assert(watch_verdict(true, true) == 2);
}

test every_doctor_check_carries_a_fix {
    assert(DOCTOR_COUNT == 4);
    var i : usize = 0;
    while (i < DOCTOR_COUNT) {
        assert(doctor_row_ok(i));
        assert(doctor_index(DOCTOR_CHECKS[i]) == i);
        i = i + 1;
    }
    assert(!doctor_row_ok(DOCTOR_COUNT));
    assert(doctor_index("ghost") == DOCTOR_COUNT);
    assert(doctor_index("unsentText") == 3);
}
