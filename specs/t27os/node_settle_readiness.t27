// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_settle_readiness.t27 -- the settle readiness law (owner brief
// 2026-10-27): the THREE gates between a finished job and the first mTRI, in the
// order the laws decide them. first_missing_gate names the ONE gate a node must
// clear next, so "when do we get paid" is a read, never a discussion:
//   1. G_RECEIPT       -- the job receipt is COMPLETE (node_job_receipt.t27:
//                         32-hex challenge, FAIL 0, vacuous 0, exit 0);
//   2. G_VERIFICATIONS -- the receipt is VERIFIED (>= 2 agreeing independent
//                         votes; the t27b lab's signed master run is the second
//                         voter once it runs the commit the tick proved);
//   3. G_REGISTRATION  -- the node is registered in the coordinator's ledger
//                         (settle_bridge.t27 step 0 -- the OWNER's governance
//                         act; no agent may perform it).
// G_NONE means earning. Every gate below fails closed.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeSettleReadiness;

use t27os::node_job_receipt::R_COMPLETE;

pub const G_NONE : u8 = 0;
pub const G_RECEIPT : u8 = 1;
pub const G_VERIFICATIONS : u8 = 2;
pub const G_REGISTRATION : u8 = 3;

/// The first gate that still stands between the job and its mTRI.
pub fn first_missing_gate(receipt_complete : u8, agreeing_votes : usize, registered : bool) -> u8 {
    if (receipt_complete != R_COMPLETE) { return G_RECEIPT; }
    if (agreeing_votes < 2) { return G_VERIFICATIONS; }
    if (registered == false) { return G_REGISTRATION; }
    return G_NONE;
}

/// Earning means every gate is clear. There is no partial earning.
pub fn ready_to_earn(receipt_complete : u8, agreeing_votes : usize, registered : bool) -> bool {
    return first_missing_gate(receipt_complete, agreeing_votes, registered) == G_NONE;
}

test readiness_consts_hold {
    var a : u8 = G_NONE;
    var b : u8 = G_RECEIPT;
    var c : u8 = G_VERIFICATIONS;
    var d : u8 = G_REGISTRATION;
    assert a == 0;
    assert b == 1;
    assert c == 2;
    assert d == 3;
}

test the_gates_are_named_in_law_order {
    assert first_missing_gate(0, 0, false) == G_RECEIPT;
    assert first_missing_gate(1, 0, false) == G_VERIFICATIONS;
    assert first_missing_gate(1, 1, false) == G_VERIFICATIONS;
    assert first_missing_gate(1, 2, false) == G_REGISTRATION;
    assert first_missing_gate(1, 5, false) == G_REGISTRATION;
    assert first_missing_gate(1, 2, true) == G_NONE;
}

test earning_requires_every_gate {
    assert ready_to_earn(1, 2, true) == true;
    assert ready_to_earn(0, 2, true) == false;
    assert ready_to_earn(1, 1, true) == false;
    assert ready_to_earn(1, 2, false) == false;
    assert ready_to_earn(0, 0, false) == false;
}
