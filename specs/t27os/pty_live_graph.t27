// SPDX-License-Identifier: Apache-2.0
; specs/t27os/pty_live_graph.t27 -- G3: PTY panes folded into work graph (epic #12779)
; Reads ~/.t27os/pty/ pane events: "pid state name" per line. Folds into work graph.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osPtyLiveGraph;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::Event;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::WG_OK;

pub fn pty_state_to_kind(s : u32) -> u8 {
    if (s == 1) { return 0; }   // LVS_RUNNING -> EV_SPAWN
    if (s == 2) { return 2; }   // LVS_BLOCKED -> EV_DOWN
    if (s == 4) { return 1; }   // LVS_DONE -> EV_EXIT
    return 255;                 // LVS_STALLED, LVS_IDLE, LVS_READY: silent
}

pub fn pty_parse_line(text : str, at : usize) -> u32 {
    var i : usize = at;
    var e : usize = i;
    while (e < text.len and text[e] != 10) { e = e + 1; }
    var s : usize = i;
    while (s < e and text[s] == 32) { s = s + 1; }
    if (s >= e) { return 0; }
    if (text[s] == 35) { return (e - i + 1) as u32; }
    var ks : usize = s;
    var pid : u64 = 0;
    while (s < e and text[s] >= 48 and text[s] <= 57) { pid = pid * 10 + ((text[s] - 48) as u64); s = s + 1; }
    if (s == ks) { return 0; }
    while (s < e and text[s] == 32) { s = s + 1; }
    var st : u64 = 0;
    while (s < e and text[s] >= 48 and text[s] <= 57) { st = st * 10 + ((text[s] - 48) as u64); s = s + 1; }
    if (s == ks + 1) { return 0; }
    while (s < e and text[s] == 32) { s = s + 1; }
    var consumed : usize = e - i;
    if (e < text.len and text[e] == 10) { consumed = e - i + 1; }
    return consumed as u32;
}

/// Batch fold: one pass over text accumulates (kind, pid) pairs into arrays,
; then apply_event is called once per pair. `cap` bounds the internal arrays.
; Returns number of events applied.
pub fn pty_fold_batch(g : *WorkGraph, text : str, kinds : []u8, pids : []u64, cap : u32) -> u32 {
    var count : u32 = 0;
    var i : usize = 0;
    // first pass: parse all lines into arrays
    while (i < text.len) {
        var consumed : usize = pty_parse_line(text, i);
        if (consumed == 0) { i = i + 1; continue; }
        var e : usize = i;
        while (e < text.len and text[e] != 10) { e = e + 1; }
        var s : usize = i;
        while (s < e and text[s] == 32) { s = s + 1; }
        if (s >= e or text[s] == 35) { i = i + consumed; continue; }
        var ks : usize = s;
        var pid : u64 = 0;
        while (s < e and text[s] >= 48 and text[s] <= 57) { pid = pid * 10 + ((text[s] - 48) as u64); s = s + 1; }
        if (s == ks) { i = i + consumed; continue; }
        while (s < e and text[s] == 32) { s = s + 1; }
        var st : u64 = 0;
        while (s < e and text[s] >= 48 and text[s] <= 57) { st = st * 10 + ((text[s] - 48) as u64); s = s + 1; }
        if (s == ks + 1) { i = i + consumed; continue; }
        const kind : u8 = pty_state_to_kind(st as u32);
        if (kind != 255 and count < cap) {
            kinds[count] = kind;
            pids[count] = pid;
            count = count + 1;
        }
        i = i + consumed;
    }
    // second pass: apply_event per pair
    var applied : u32 = 0;
    var j : u32 = 0;
    while (j < count) {
        const r : u8 = apply_event(g, Event { kind: kinds[j], from_pid: pids[j], to_pid: 1000, task_no: 0, deliver: 0, reason: 99, seq: (pids[j] % 1000) as u32, spec_id: 0 });
        if (r == WG_OK) { applied = applied + 1; }
        j = j + 1;
    }
    return applied;
}

/// pty_fold: thin wrapper over batch fold with stack arrays (64-entry cap).
pub fn pty_fold(g : *WorkGraph, text : str) -> u32 {
    var kbuf : [64]u8 = undefined;
    var pbuf : [64]u64 = undefined;
    return pty_fold_batch(g, text, kbuf[0..64], pbuf[0..64], 64);
}

test pty_state_to_kind_maps_states {
    assert(pty_state_to_kind(1) == 0);
    assert(pty_state_to_kind(2) == 2);
    assert(pty_state_to_kind(4) == 1);
    assert(pty_state_to_kind(0) == 255);
    assert(pty_state_to_kind(3) == 255);
    assert(pty_state_to_kind(5) == 255);
}

test pty_parse_line_reads_pid_state_and_name {
    var buf : [64]u8 = undefined;
    var src : str = "1001 2 my-pane";
    var si : usize = 0;
    while (si < src.len) { buf[si] = src[si]; si = si + 1; }
    var consumed : usize = pty_parse_line(src, 0) as usize;
    assert(consumed == src.len);
    var s : usize = 0;
    while (s < buf.len and buf[s] == 32) { s = s + 1; }
    var pid : u64 = 0;
    while (s < buf.len and buf[s] >= 48 and buf[s] <= 57) { pid = pid * 10 + ((buf[s] - 48) as u64); s = s + 1; }
    assert(pid == 1001);
    while (s < buf.len and buf[s] == 32) { s = s + 1; }
    var st : u64 = 0;
    while (s < buf.len and buf[s] >= 48 and buf[s] <= 57) { st = st * 10 + ((buf[s] - 48) as u64); s = s + 1; }
    assert(st == 2);
    while (s < buf.len and buf[s] == 32) { s = s + 1; }
    var name : str = "my-pane";
    var name_len : usize = 5;
    var match_name : bool = true;
    var k : usize = 0;
    while (k < name_len) {
        if (buf[s + k] != name[k]) { match_name = false; }
        k = k + 1;
    }
    assert(match_name);
}

test pty_fold_folds_recorded_panes {
    var g : WorkGraph = new_graph();
    var n : u32 = pty_fold(&g, "1001 2 pane-one\n1002 1 pane-two\n1003 4 pane-three\n");
    assert(n == 3);
    assert(nodes(&g) > 0);
}

test pty_fold_ignores_blank_and_comments {
    var g : WorkGraph = new_graph();
    var n : u32 = pty_fold(&g, "# comment\n\n1001 1 pane-one\n   \n1002 2 pane-two\n");
    assert(n == 2);
    assert(nodes(&g) > 0);
}

test pty_fold_batch_applies_all_parsed_events {
    var g : WorkGraph = new_graph();
    var kbuf : [64]u8 = undefined;
    var pbuf : [64]u64 = undefined;
    var n : u32 = pty_fold_batch(&g, "1001 1 pane-one\n1002 2 pane-two\n1003 4 pane-three\n", kbuf[0..64], pbuf[0..64], 64);
    assert(n == 3);
    assert(nodes(&g) > 0);
}

test pty_fold_batch_respects_cap {
    var g : WorkGraph = new_graph();
    var kbuf : [4]u8 = undefined;
    var pbuf : [4]u64 = undefined;
    var n : u32 = pty_fold_batch(&g, "1001 1 a\n1002 1 b\n1003 1 c\n1004 1 d\n1005 1 e\n", kbuf[0..4], pbuf[0..4], 4);
    assert(n == 4);   // cap limits to 4
}
