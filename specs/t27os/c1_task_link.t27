// SPDX-License-Identifier: Apache-2.0
; specs/t27os/c1_task_link.t27 -- the C1 slice's chain from an assigned task to a verified result
; (owner's C1 scenario, 2026-11-03: one allowed Claude Code task -> panel -> attempt -> artifact
; -> the result checked by the intended test).
; --
; The chain, each step its own evidence:
;   plan.txt line   "#12976 P1 feat(t27os): dev-monitor skill..." names the task number and title
;   tl_bind         assigns that task to an executor agent in a PTY pane        -> ASSIGNED
;   tl_set_session  the pane's session id hash is recorded on the link
;   tl_set_artifact the pane's artifact (the spec file it wrote) is attached
;   tl_verify       the intended test ran on the artifact and passed           -> VERIFIED
; The link is monotone: once verified it never regresses (a new attempt is a new link), and a
; task that was never assigned from a plan line (task_no == 0) can never verify.
; WHAT IS NOT HERE: where plan.txt comes from, which tests ran, or that the pane produced the
; bytes -- tl_verify's three booleans are the HOST's measurements (the file exists on disk, the
; file is a .t27 spec, the spec's tests pass), never the link's own claim about itself.
; --
; The status rungs are the compact C1 view of the evidence ladder in
; specs/t27os/executor_registry.t27 (TL_DECLARED -> ER_DECLARED=0, TL_ASSIGNED -> ER_ASSIGNED=3,
; TL_VERIFIED -> ER_VERIFIED=6; the order is preserved 1:1). The ER_* constants cannot be use'd
; here: this tree holds no seal for executor_registry, and an import serves its sealed snapshot
; or nothing.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osC1TaskLink;

// ---------------------------------------------------------------- the ladder rungs

/// The three rungs tl_status returns, compact numbering for the C1 slice. Source ladder:
/// executor_registry.t27 ER_DECLARED=0 / ER_ASSIGNED=3 / ER_VERIFIED=6, mapped 1:1.
pub const TL_DECLARED : u8 = 0;
pub const TL_ASSIGNED : u8 = 1;
pub const TL_VERIFIED : u8 = 2;

/// What a verified link names as its verifier: the intended test of the artifact is the
/// artifact's own test suite, run by these two commands (the C1 gate runs both until green).
pub const TL_VERIFIER : str = "t27c test-report + t27b test";

// ---------------------------------------------------------------- the link

/// One task-to-executor-to-verified-result chain. task_no is the number a plan.txt line named
/// (#N; 0 = never assigned), executor is the agent cell as in executor_registry rows, pane is
/// the PTY pane that ran the attempt, session_hash is the pane session's id hash, and the
/// artifact fields carry what the attempt produced and what the check found.
pub struct TaskLink {
    task_no: u32,
    executor: u32,
    pane: u8,
    session_hash: u64,
    artifact_path: str,
    artifact_spec: bool,
    verified: bool,
    verified_by: str,
}

/// A declared, never-assigned link: the task is named but no plan line assigned it.
pub fn tl_new() -> TaskLink {
    return TaskLink {
        task_no: 0, executor: 0, pane: 0, session_hash: 0,
        artifact_path: "", artifact_spec: false, verified: false, verified_by: ""
    };
}

// ---------------------------------------------------------------- the chain

/// Out slots of tl_parse_plan_line: [0] task number, [1] title start, [2] title length.
/// (An out slice, not three *u32 out-params: t27b refuses a write-only reference parameter --
/// the same refusal specs/pins/parser.t27 gets -- and the out slice is the supported house
/// form, as session_store.t27's json_field.)
pub const TL_OUT_TASK : usize = 0;
pub const TL_OUT_AT : usize = 1;
pub const TL_OUT_LEN : usize = 2;

/// Parse one plan.txt line "#12976 P1 feat(t27os): dev-monitor skill..." into the task number
/// and the title span (everything after "#N" and its one separator space, to end of line).
/// Writes out[0..3]. Refuses: no leading '#', no digits, "#0", a ninth digit (more than 8
/// digits), and a character other than the separator space right after the number. On refusal
/// every out value is 0. A bare "#12976" parses with an empty title.
pub fn tl_parse_plan_line(line: []const u8, out: []u32) -> bool {
    out[TL_OUT_TASK] = 0;
    out[TL_OUT_AT] = 0;
    out[TL_OUT_LEN] = 0;
    if (line.len < 2) { return false; }
    if (line[0] != 35) { return false; } // '#'
    var i : usize = 1;
    var v : u64 = 0;
    var d : usize = 0;
    while (i < line.len and line[i] >= 48 and line[i] <= 57 and d < 8) {
        v = v * 10 + @as(u64, line[i] - 48);
        i = i + 1;
        d = d + 1;
    }
    if (d == 0) { return false; }
    // a ninth digit would pass the 8-digit cap: refuse rather than wrap
    if (i < line.len and line[i] >= 48 and line[i] <= 57) { return false; }
    if (i < line.len and line[i] != 32) { return false; } // "#12976x" is not a plan line
    if (v == 0) { return false; } // "#0" names no task
    out[TL_OUT_TASK] = @as(u32, @intCast(v));
    if (i < line.len) { i = i + 1; } // the one separator space
    out[TL_OUT_AT] = @as(u32, @intCast(i));
    out[TL_OUT_LEN] = @as(u32, @intCast(line.len - i));
    return true;
}

/// The assignment: task N to agent A in pane P, nothing else claimed yet. Task 0 is refused
/// (no plan line ever named it): the zero link comes back and the rung stays DECLARED.
pub fn tl_bind(task: u32, agent: u32, pane: u8) -> TaskLink {
    if (task == 0) { return tl_new(); }
    return TaskLink {
        task_no: task, executor: agent, pane: pane, session_hash: 0,
        artifact_path: "", artifact_spec: false, verified: false, verified_by: ""
    };
}

/// The attempt ran in a PTY pane: record the session it belongs to.
pub fn tl_set_session(link: *TaskLink, session_hash: u64) -> void {
    link.session_hash = session_hash;
}

/// The attempt produced its artifact: record the path and the declared kind (is it a .t27
/// spec). The kind recorded here is a claim; tl_verify is what checks it.
pub fn tl_set_artifact(link: *TaskLink, path: str, is_spec: bool) -> void {
    link.artifact_path = path;
    link.artifact_spec = is_spec;
}

/// The verification step. All three inputs are the HOST's measurements: the artifact file
/// exists on disk, it is a .t27 spec, and its own tests pass. verified is set only when all
/// three hold AND the link was assigned from a plan line. Monotone: a verified link never
/// regresses -- a failed later check is a fact about a new attempt, which is a new link.
pub fn tl_verify(link: *TaskLink, artifact_exists: bool, artifact_is_spec: bool, tests_pass: bool) -> void {
    if (link.verified) { return; }
    if (link.task_no == 0) { return; }
    if (artifact_exists == false) { return; }
    if (artifact_is_spec == false) { return; }
    if (tests_pass == false) { return; }
    link.verified = true;
    link.artifact_spec = true; // the check's finding overwrites the attach-time claim
    link.verified_by = TL_VERIFIER;
}

/// The rung this link stands on, per the ladder above.
pub fn tl_status(link: TaskLink) -> u8 {
    if (link.verified) { return TL_VERIFIED; }
    if (link.task_no != 0) { return TL_ASSIGNED; }
    return TL_DECLARED;
}

// ---------------------------------------------------------------- tests

/// Byte equality (the cross-backend idiom: explicit bytes, never str ==).
fn tl_eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len and a[i] == b[i]) { i = i + 1; }
    return i == a.len;
}

test parses_the_plan_line_into_task_and_title {
    const line : []const u8 = "#12976 P1 feat(t27os): dev-monitor skill...";
    var o : [3]u32 = undefined;
    assert(tl_parse_plan_line(line, o[0..3]) == true);
    assert(o[TL_OUT_TASK] == 12976);
    // the title span is everything after "#12976 " to end of line
    assert(o[TL_OUT_AT] == 7);
    assert(o[TL_OUT_LEN] == 36);
    const s0 : usize = @as(usize, @intCast(o[TL_OUT_AT]));
    const s1 : usize = s0 + @as(usize, @intCast(o[TL_OUT_LEN]));
    assert(line[s0] == 80); // 'P'
    assert(tl_eq(line[s0..s1], "P1 feat(t27os): dev-monitor skill..."));
}

test the_parser_refuses_lines_without_a_task_number {
    var o : [3]u32 = undefined;
    o[0] = 77; o[1] = 77; o[2] = 77;
    // empty, no '#', no digits after '#', a space right after '#'
    assert(tl_parse_plan_line("", o[0..3]) == false);
    assert(tl_parse_plan_line("12976 P1 x", o[0..3]) == false);
    assert(tl_parse_plan_line("#abc", o[0..3]) == false);
    assert(tl_parse_plan_line("# 12976", o[0..3]) == false);
    // a character other than the separator space right after the number
    assert(tl_parse_plan_line("#12976x", o[0..3]) == false);
    // "#0" names no task; nine digits pass the 8-digit cap
    assert(tl_parse_plan_line("#0", o[0..3]) == false);
    assert(tl_parse_plan_line("#123456789", o[0..3]) == false);
    // on refusal every out value is zeroed
    assert(o[0] == 0 and o[1] == 0 and o[2] == 0);
}

test a_bare_task_number_parses_with_an_empty_title {
    var o : [3]u32 = undefined;
    assert(tl_parse_plan_line("#12976", o[0..3]) == true);
    assert(o[TL_OUT_TASK] == 12976 and o[TL_OUT_LEN] == 0);
    // a trailing separator space still leaves an empty title
    assert(tl_parse_plan_line("#12976 ", o[0..3]) == true);
    assert(o[TL_OUT_TASK] == 12976 and o[TL_OUT_AT] == 7 and o[TL_OUT_LEN] == 0);
}

test bind_produces_an_assigned_link {
    var o : [3]u32 = undefined;
    assert(tl_parse_plan_line("#12966 P2 fix(t27os): pane restore", o[0..3]) == true);
    var l : TaskLink = tl_bind(o[TL_OUT_TASK], 0, 5);
    assert(tl_status(l) == TL_ASSIGNED);
    // the assignment and nothing else: no session, no artifact, no verification claimed
    assert(l.task_no == 12966 and l.executor == 0 and l.pane == 5);
    assert(l.verified == false and l.artifact_spec == false);
}

test bind_refuses_task_zero_and_stays_declared {
    var l : TaskLink = tl_bind(0, 0, 3);
    assert(l.task_no == 0);
    assert(tl_status(l) == TL_DECLARED);
    // and the refused link can never verify, whatever the checks claim
    tl_verify(&l, true, true, true);
    assert(l.verified == false);
    assert(tl_status(l) == TL_DECLARED);
}

test verify_with_everything_true_produces_verified {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_set_session(&l, 1234567890123);
    tl_set_artifact(&l, "specs/t27os/c1_task_link.t27", true);
    tl_verify(&l, true, true, true);
    assert(l.verified == true);
    assert(tl_status(l) == TL_VERIFIED);
    // the verified link names what verified it
    assert(tl_eq(l.verified_by, "t27c test-report + t27b test"));
}

test no_artifact_stays_assigned {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_verify(&l, false, true, true);
    assert(l.verified == false);
    assert(tl_status(l) == TL_ASSIGNED);
}

test a_non_spec_artifact_stays_assigned {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_set_artifact(&l, "notes/scratch.md", false);
    // the artifact exists and its tests pass, but it is not a .t27 spec: not the chain's product
    tl_verify(&l, true, false, true);
    assert(l.verified == false);
    assert(l.artifact_spec == false);
    assert(tl_status(l) == TL_ASSIGNED);
}

test failing_tests_stay_assigned {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_set_artifact(&l, "specs/t27os/c1_task_link.t27", true);
    tl_verify(&l, true, true, false);
    assert(l.verified == false);
    assert(tl_status(l) == TL_ASSIGNED);
    // an artifact attached but never verified does not claim a verifier
    assert(tl_eq(l.verified_by, ""));
}

test an_unassigned_task_is_never_verified {
    // the zero link: declared, never assigned from any plan line
    var l : TaskLink = tl_new();
    assert(tl_status(l) == TL_DECLARED);
    tl_verify(&l, true, true, true);
    assert(l.verified == false);
    assert(tl_status(l) == TL_DECLARED);
}

test verification_is_monotone {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_set_artifact(&l, "specs/t27os/c1_task_link.t27", true);
    tl_verify(&l, true, true, true);
    assert(tl_status(l) == TL_VERIFIED);
    // a later failed check cannot un-verify the link; a new attempt is a new link
    tl_verify(&l, false, false, false);
    assert(l.verified == true);
    assert(tl_status(l) == TL_VERIFIED);
    assert(tl_eq(l.verified_by, "t27c test-report + t27b test"));
}

test the_pane_session_and_artifact_are_recorded {
    var l : TaskLink = tl_bind(12976, 0, 3);
    tl_set_session(&l, 1234567890123);
    tl_set_artifact(&l, "specs/t27os/c1_task_link.t27", true);
    assert(l.session_hash == 1234567890123);
    assert(l.artifact_spec == true);
    assert(tl_eq(l.artifact_path, "specs/t27os/c1_task_link.t27"));
    // a non-spec attach records its declared kind too
    var m : TaskLink = tl_bind(12966, 1, 4);
    tl_set_artifact(&m, "notes/scratch.md", false);
    assert(m.artifact_spec == false);
    assert(tl_eq(m.artifact_path, "notes/scratch.md"));
}

test the_full_chain_climbs_declared_assigned_verified {
    // declared: the task is named but nothing is assigned yet
    var l : TaskLink = tl_new();
    assert(tl_status(l) == TL_DECLARED);
    // assigned: the plan line's task goes to an executor in a pane
    var o : [3]u32 = undefined;
    assert(tl_parse_plan_line("#12976 P1 feat(t27os): dev-monitor skill...", o[0..3]) == true);
    l = tl_bind(o[TL_OUT_TASK], 0, 3);
    assert(tl_status(l) == TL_ASSIGNED);
    // the attempt: a pane session, an artifact that is a spec
    tl_set_session(&l, 1234567890123);
    tl_set_artifact(&l, "specs/t27os/c1_task_link.t27", true);
    // verified: the intended test ran and passed
    tl_verify(&l, true, true, true);
    assert(tl_status(l) == TL_VERIFIED);
    assert(l.task_no == 12976 and l.pane == 3 and l.verified == true);
}

test the_rungs_pin_their_values_and_order {
    // the compact C1 rungs; the source ladder rungs they stand for are pinned in the header
    assert(TL_DECLARED == 0 and TL_ASSIGNED == 1 and TL_VERIFIED == 2);
    assert(TL_DECLARED < TL_ASSIGNED and TL_ASSIGNED < TL_VERIFIED);
    assert(TL_DECLARED != TL_ASSIGNED and TL_ASSIGNED != TL_VERIFIED);
}

invariant the_rungs_are_ordered_and_distinct {
    assert TL_DECLARED == 0 and TL_ASSIGNED == 1 and TL_VERIFIED == 2;
    assert TL_DECLARED < TL_ASSIGNED and TL_ASSIGNED < TL_VERIFIED;
}
