// SPDX-License-Identifier: Apache-2.0
// specs/t27os/router_sock.t27 -- the socket law of the stage-2 router: the bytes a listening socket needs.
// The syscalls exist already (pty_sys.t27 sys_socket / sys_bind / sys_listen / sys_accept -- the same calls
// take AF_INET as their domain parameter); what stage 2 lacked was the ADDRESS: an AF_UNIX bind takes a path,
// an AF_INET bind takes 16 bytes of sockaddr_in, and the port travels big-endian inside them. This spec owns
// those bytes and the parsing of the address they name. The accept loop that serves requests is thin
// plumbing and rides later; every RULE it must follow already lives in specs/t27os/router.t27 (the walk,
// answer_action, the transform split, the max_tokens floor).
// Refs gHashTag/t27#10782.
// phi^2 + 1/phi^2 = 3 | TRINITY

module T27osRouterSock;

use t27os::session_store::put_bytes;
use t27os::router::ROUTER_PORT;

// ---- the address family ------------------------------------------------------------------------------------

/// AF_INET, the domain an internet socket is opened with (sys_socket's first parameter).
pub const AF_INET : i32 = 2;
/// SOCK_STREAM, the kind a listening socket is opened with (sys_socket's second parameter).
pub const SOCK_STREAM : i32 = 0;
/// A sockaddr_in is 16 bytes on this platform: length byte, family, port, four address bytes, eight zero.
pub const SOCKADDR_IN_LEN : usize = 16;

// ---- the address -------------------------------------------------------------------------------------------

/// The four octets of a dotted IPv4 address: "127.0.0.1" into 4 bytes. Returns 0 on anything else -- no
/// hostnames, no hex, no spaces (the router binds one literal loopback address, never a name).
pub fn ipv4_parse(s: []const u8, out: []u8) -> usize {
    var n : usize = 0;
    var v : u32 = 0;
    var digits : u32 = 0;
    var i : usize = 0;
    while (i < s.len) {
        const ch : u8 = s[i];
        if (ch >= 48 and ch <= 57) {
            v = v * 10 + @as(u32, ch - 48);
            digits = digits + 1;
            if (digits > 3 or v > 255) { return 0; }
        } else if (ch == 46) {
            if (digits == 0 or n >= 4 or out.len < 4) { return 0; }
            out[n] = @intCast(v & 255);
            n = n + 1;
            v = 0;
            digits = 0;
        } else {
            return 0;
        }
        i = i + 1;
    }
    if (digits == 0 or n != 3 or out.len < 4) { return 0; }
    out[3] = @intCast(v & 255);
    return 4;
}

/// The two big-endian bytes a sockaddr_in carries the port in: 47127 travels as 0xB8, 0x17 -- high byte
/// first, the network order the kernel expects.
pub fn port_bytes(port: u16, out: []u8) -> usize {
    if (out.len < 2) { return 0; }
    out[0] = @intCast((port >> 8) & 255);
    out[1] = @intCast(port & 255);
    return 2;
}

/// The 16 bytes sys_bind wants for AF_INET: length 16, family AF_INET, the port big-endian, the four
/// address octets, then eight zeros. `ip` is dotted ("127.0.0.1"); returns 0 on an address that does not
/// parse. The router binds loopback only -- a pane on this Mac talks to this Mac.
pub fn sockaddr_in_fill(port: u16, ip: []const u8, out: []u8) -> usize {
    if (out.len < SOCKADDR_IN_LEN) { return 0; }
    var oct : [4]u8 = undefined;
    if (ipv4_parse(ip, oct[0..4]) != 4) { return 0; }
    var i : usize = 0;
    while (i < SOCKADDR_IN_LEN) {
        out[i] = 0;
        i = i + 1;
    }
    out[0] = @intCast(SOCKADDR_IN_LEN);
    out[1] = @intCast(AF_INET & 255);
    var pb : [2]u8 = undefined;
    _ = port_bytes(port, pb[0..2]);
    out[2] = pb[0];
    out[3] = pb[1];
    out[4] = oct[0];
    out[5] = oct[1];
    out[6] = oct[2];
    out[7] = oct[3];
    return SOCKADDR_IN_LEN;
}

/// The one address the router binds: loopback, the port the router spec owns (router.t27 ROUTER_PORT).
/// Returns the 16 bind bytes; 0 on a refusal.
pub fn router_bind_bytes(out: []u8) -> usize {
    return sockaddr_in_fill(ROUTER_PORT, "127.0.0.1", out);
}

test "an_ipv4_address_parses_into_four_octets" {
    var out : [4]u8 = undefined;
    assert ipv4_parse("127.0.0.1", out[0..4]) == 4;
    assert out[0] == 127 and out[1] == 0 and out[2] == 0 and out[3] == 1;
    assert ipv4_parse("10.255.0.7", out[0..4]) == 4;
    assert out[1] == 255 and out[3] == 7;
    assert ipv4_parse("", out[0..4]) == 0;
    assert ipv4_parse("127.0.0", out[0..4]) == 0;
    assert ipv4_parse("256.0.0.1", out[0..4]) == 0;
    assert ipv4_parse("127.0.0.1.", out[0..4]) == 0;
    assert ipv4_parse("localhost", out[0..4]) == 0;
}

test "the_port_travels_big_endian" {
    var out : [2]u8 = undefined;
    assert port_bytes(47127, out[0..2]) == 2;
    assert out[0] == 184 and out[1] == 23;
    assert port_bytes(80, out[0..2]) == 2;
    assert out[0] == 0 and out[1] == 80;
    assert port_bytes(47127, out[0..1]) == 0;
}

test "the_bind_bytes_are_a_sockaddr_in" {
    var out : [16]u8 = undefined;
    assert router_bind_bytes(out[0..16]) == 16;
    assert out[0] == 16;
    assert out[1] == 2;
    assert out[2] == 184 and out[3] == 23;
    assert out[4] == 127 and out[5] == 0 and out[6] == 0 and out[7] == 1;
    var i : usize = 8;
    while (i < 16) {
        assert out[i] == 0;
        i = i + 1;
    }
    assert sockaddr_in_fill(ROUTER_PORT, "localhost", out[0..16]) == 0;
    assert sockaddr_in_fill(ROUTER_PORT, "127.0.0.1", out[0..15]) == 0;
}
