fn dn_addr(out:[]u8,port:u64)->void {
    ck_wipe(out);
    out[0]=16;
    out[1]=2;
    out[2]=@as(u8,@intCast(port/256));
    out[3]=@as(u8,@intCast(port%256));
    out[4]=127;
    out[7]=1;
}
fn dn_proxy(port:u64)->i32 {
    const fd:i32=dn_socket(2,2,0);
    if(fd<0) {
        return -1;
    }
    var sa:[16]u8=undefined;
    dn_addr(sa[0..16],port);
    if(dn_bind(fd,sa[0..16],16)!=0 or dn_fcntl(fd,4,4)!=0) {
        dn_close_fd(fd);
        return -1;
    }
    return fd;
}
fn dn_proxy_pair(b:[]u8)->bool {
    var attempt:u32=0;
    while(attempt<8) {
        const chat:i32=dn_proxy(0);
        if(chat<0) {
            return false;
        }
        var sa:[16]u8=undefined;
        var size:[1]u32=undefined;
        size[0]=16;
        if(dn_sockname(chat,sa[0..16],size)!=0) {
            dn_close_fd(chat);
            return false;
        }
        const port:u64=@as(u64,sa[2])*256+@as(u64,sa[3]);
        if(port>0 and port<=65525) {
            const media:i32=dn_proxy(port+10);
            if(media>=0) {
                put_u64(b,DN_CHAT_FD,@as(u64,@intCast(chat+1)));
                put_u64(b,DN_MEDIA_FD,@as(u64,@intCast(media+1)));
                put_u64(b,DN_PROXY_PORT,port);
                return true;
            }
        }
        dn_close_fd(chat);
        attempt=attempt+1;
    }
    return false;
}
fn dn_method(c:u64,name:[]const u8,implementation:[]const u8,encoding:[]const u8)->bool {
    const f:u64=dn_symbol(18446744073709551614,implementation);
    return f!=0 and dn_add(c,dn_sel(name),f,encoding);
}
fn dn_delegate_class()->u64 {
    var c:u64=dn_cls("T27DirectoryHTTPDelegate");
    if(c!=0) {
        return c;
    }
    c=dn_allocate(dn_cls("NSObject"),"T27DirectoryHTTPDelegate",0);
    if(c==0) {
        return 0;
    }
    if(!dn_method(c,"connection:didReceiveResponse:","dn_received_response","v@:@@")
    or !dn_method(c,"connection:didReceiveData:","dn_received_data","v@:@@")
    or !dn_method(c,"connectionDidFinishLoading:","dn_finished","v@:@")
    or !dn_method(c,"connection:didFailWithError:","dn_failed","v@:@@")
    or !dn_method(c,"connection:willSendRequest:redirectResponse:","dn_redirect","@@:@@@")) {
        return 0;
    }
    dn_register(c);
    return c;
}
pub fn dn_open(root:u64,local_port:u64)->u64 {
    if(root==0 or local_port==0 or local_port>65525) {
        return 0;
    }
    const p:u64=dn_calloc(1,DN_BYTES);
    if(p==0) {
        return 0;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    put_u64(b,DN_ROOT,root);
    put_u64(b,DN_LOCAL_PORT,local_port);
    if(!dn_root_public(root,b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65],false)
    or dn_random(0,16,b[DN_SESSION..DN_SESSION+16])!=0 or !dn_proxy_pair(b)) {
        dn_close(p);
        return 0;
    }
    dn_net_open(b);
    const c:u64=dn_delegate_class();
    if(c==0) {
        dn_close(p);
        return 0;
    }
    const delegate:u64=dn_m0(c,dn_sel("new"));
    if(delegate==0) {
        dn_close(p);
        return 0;
    }
    put_u64(b,DN_DELEGATE,delegate);
    dn_assoc_set(delegate,DN_ASSOC,dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),p),1);
    return p;
}
pub fn dn_close(p:u64)->void {
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    put_u64(b,DN_CLOSED,1);
    const delegate:u64=get_u64(b,DN_DELEGATE);
    if(delegate!=0) {
        dn_assoc_set(delegate,DN_ASSOC,0,0);
    }
    const connection:u64=get_u64(b,DN_CONNECTION);
    if(connection!=0) {
        dn_m0(connection,dn_sel("cancel"));
        dn_release(connection);
    }
    const data:u64=get_u64(b,DN_DATA);
    if(data!=0) {
        dn_release(data);
    }
    const url:u64=get_u64(b,DN_URL);
    if(url!=0) {
        dn_release(url);
    }
    if(delegate!=0) {
        dn_release(delegate);
    }
    if(get_u64(b,DN_CHAT_FD)!=0) {
        dn_close_fd(@as(i32,@intCast(get_u64(b,DN_CHAT_FD)-1)));
    }
    if(get_u64(b,DN_MEDIA_FD)!=0) {
        dn_close_fd(@as(i32,@intCast(get_u64(b,DN_MEDIA_FD)-1)));
    }
    if(get_u64(b,DN_NET_FD)!=0) {
        dn_close_fd(@as(i32,@intCast(get_u64(b,DN_NET_FD)-1)));
    }
    ck_wipe(b);
    dn_free(p);
}
fn dn_equal(a:u64,text:[]const u8)->bool {
    return dn_m1(a,dn_sel("isEqualToString:"),dn_cf(text))%256!=0;
}
pub fn dn_configure(p:u64,text:u64,qa:bool)->bool {
    if(p==0 or text==0) {
        return false;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    const root:u64=get_u64(b,DN_ROOT);
    const chat:u32=dn_root_state(root,false);
    const audio:u32=dn_root_state(root,true);
    if((chat>0 and chat<5) or (audio>0 and audio<5) or get_u64(b,DN_CONNECTION)!=0) {
        return false;
    }
    const url:u64=dn_m1(dn_cls("NSURL"),dn_sel("URLWithString:"),text);
    if(url==0) {
        return false;
    }
    const scheme:u64=dn_m0(url,dn_sel("scheme"));
    const host:u64=dn_m0(url,dn_sel("host"));
    if(host==0 or dn_m0(host,dn_sel("length"))==0 or dn_m0(url,dn_sel("user"))!=0 or dn_m0(url,dn_sel("password"))!=0
    or dn_m0(url,dn_sel("query"))!=0 or dn_m0(url,dn_sel("fragment"))!=0) {
        return false;
    }
    if(!dn_equal(scheme,"https") and !(qa and dn_equal(scheme,"http") and dn_equal(host,"127.0.0.1") and dn_m0(dn_m0(url,dn_sel("port")),dn_sel("unsignedLongLongValue"))==49300)) {
        return false;
    }
    const path:u64=dn_m0(url,dn_sel("path"));
    if(path!=0 and !dn_equal(path,"") and !dn_equal(path,"/") and !dn_equal(path,"/t27")) {
        return false;
    }
    var endpoint:u64=url;
    if(!dn_equal(path,"/t27")) {
        endpoint=dn_m1(url,dn_sel("URLByAppendingPathComponent:"),dn_cf("t27"));
    }
    const old:u64=get_u64(b,DN_URL);
    if(old!=0) {
        dn_release(old);
    }
    put_u64(b,DN_URL,dn_retain(endpoint));
    put_u64(b,DN_STATE,1);
    put_u64(b,DN_ROOM_STATE,0);
    put_u64(b,DN_LOOKUP,1);
    put_u64(b,DN_NEXT,0);
    put_u64(b,DN_ERROR,0);
    return true;
}
fn dn_sync_peer(b:[]u8)->bool {
    var peer:[65]u8=undefined;
    const root:u64=get_u64(b,DN_ROOT);
    if(!dn_root_public(root,peer[0..65],true)) {
        return false;
    }
    if(!ck_same(peer[0..65],b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65])) {
        var i:usize=0;
        while(i<65) {
            b[DN_PEER_PUBLIC+i]=peer[i];
            i=i+1;
        }
        put_u64(b,DN_LOOKUP,1);
        put_u64(b,DN_ROOM_STATE,0);
        put_u64(b,DN_BOUND,0);
        put_u64(b,DN_DIRECT_STATE,0);
        put_u64(b,DN_DIRECT_ADMITTED,0);
        ck_wipe(b[DN_PEER_CANDIDATES..DN_PEER_CANDIDATES+145]);
    }
    if(get_u64(b,DN_BOUND)==0) {
        if(!dn_root_direct(root,2130706433,get_u64(b,DN_PROXY_PORT))) {
            return false;
        }
        put_u64(b,DN_BOUND,1);
    }
    return true;
}
pub fn dn_pair(p:u64,card:u64)->bool {
    if(p==0) {
        return false;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(!dn_root_pair(get_u64(b,DN_ROOT),card,2130706433,get_u64(b,DN_PROXY_PORT))) {
        return false;
    }
    return dn_sync_peer(b);
}
pub fn dn_connect(p:u64,audio:bool)->bool {
    if(p==0) {
        return false;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_URL)==0 or !dn_sync_peer(b)) {
        return false;
    }
    if(get_u64(b,DN_ROOM_STATE)==5) {
        put_u64(b,DN_DIRECT_STATE,0);
        put_u64(b,DN_ROUTE,0);
    }
    put_u64(b,DN_INTENT,if(audio) 2 else 1);
    put_u64(b,DN_LOOKUP,1);
    put_u64(b,DN_OFFLINE,0);
    return true;
}
pub fn dn_force_relay(p:u64,on:bool)->void {
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    put_u64(v.bytes,DN_FORCE,if(on) 1 else 0);
    if(on) {
        put_u64(v.bytes,DN_ROUTE,2);
        put_u64(v.bytes,DN_DIRECT_STATE,3);
        put_u64(v.bytes,DN_DIRECT_ADMITTED,0);
    }
    else {
        put_u64(v.bytes,DN_DIRECT_STATE,0);
    }
}
fn dn_increment(b:[]u8,at:usize,n:u64)->void {
    put_u64(b,at,get_u64(b,at)+n);
}
fn dn_realtime(kind:u32)->bool {
    return kind==CK_T_MEDIA or kind==CK_T_VIDEO or kind==CK_T_H264;
}
// Preserve the already submitted prefix. End discards stale unsent media only.
fn dn_end_queue(b:[]u8,channel:u64)->void {
    const head:u64=get_u64(b,DN_TX_HEAD);
    const tail:u64=get_u64(b,DN_TX_TAIL);
    var protected:u64=0;
    if(get_u64(b,DN_CONNECTION)!=0 and get_u64(b,DN_OPERATION)==7) {
        protected=get_u64(b,DN_INFLIGHT_FRAMES);
    }
    var read:u64=head+protected;
    var write:u64=read;
    while(read<tail) {
        const source:usize=DN_QUEUE+@as(usize,read%DN_QUEUE_ITEMS)*DN_ITEM;
        const word:u64=get_u64(b,source);
        const n:usize=@as(usize,word&4294967295);
        const discard:bool=(word>>32)==channel and n>=52 and n<=2048 and dn_realtime(ck_hdr_type(b[source+8..source+8+n]));
        if(discard) {
            dn_increment(b,DN_DROPPED,1);
        }
        else {
            const destination:usize=DN_QUEUE+@as(usize,write%DN_QUEUE_ITEMS)*DN_ITEM;
            var i:usize=0;
            while(i<DN_ITEM) {
                b[destination+i]=b[source+i];
                i=i+1;
            }
            write=write+1;
        }
        read=read+1;
    }
    put_u64(b,DN_TX_TAIL,write);
}
fn dn_queue_frame(b:[]u8,channel:u64,packet:[]const u8)->bool {
    if((channel!=1 and channel!=2) or packet.len<52 or packet.len>2048) {
        return false;
    }
    const kind:u32=ck_hdr_type(packet);
    if(kind==CK_T_BYE) {
        dn_end_queue(b,channel);
    }
    const head:u64=get_u64(b,DN_TX_HEAD);
    const tail:u64=get_u64(b,DN_TX_TAIL);
    const capacity:u64=if(dn_realtime(kind)) DN_QUEUE_ITEMS-16 else DN_QUEUE_ITEMS;
    if(tail-head>=capacity) {
        dn_increment(b,DN_DROPPED,1);
        return false;
    }
    const at:usize=DN_QUEUE+@as(usize,tail%DN_QUEUE_ITEMS)*DN_ITEM;
    put_u64(b,at,@as(u64,packet.len)|(channel<<32));
    var i:usize=0;
    while(i<packet.len) {
        b[at+8+i]=packet[i];
        i=i+1;
    }
    put_u64(b,DN_TX_TAIL,tail+1);
    return true;
}
fn dn_drain_proxy(b:[]u8)->void {
    var channel:u64=1;
    while(channel<=2) {
        const stored:u64=get_u64(b,if(channel==1) DN_CHAT_FD else DN_MEDIA_FD);
        if(stored!=0) {
            var count:u32=0;
            while(count<64) {
                var packet:[2049]u8=undefined;
                var from:[16]u8=undefined;
                var size:[1]u32=undefined;
                size[0]=16;
                const n:i64=dn_recv(@as(i32,@intCast(stored-1)),packet[0..2049],2049,0,from[0..16],size);
                if(n<=0) {
                    break;
                }
                const extra:u64=if(channel==2) 10 else 0;
                const expected:u64=get_u64(b,DN_LOCAL_PORT)+extra;
                const port:u64=@as(u64,from[2])*256+@as(u64,from[3]);
                if(size[0]==16 and from[1]==2 and from[4]==127 and from[5]==0 and from[6]==0 and from[7]==1 and port==expected and n>=52 and n<=2048) {
                    dn_increment(b,DN_PROXY_RECEIVED,1);
                    dn_queue_frame(b,channel,packet[0..@as(usize,@intCast(n))]);
                }
                else {
                    dn_increment(b,DN_DROPPED,1);
                }
                count=count+1;
            }
        }
        channel=channel+1;
    }
}
fn dn_deliver(b:[]u8,channel:u64,packet:[]const u8)->bool {
    if((channel!=1 and channel!=2) or packet.len<52 or packet.len>2048) {
        return false;
    }
    const stored:u64=get_u64(b,if(channel==1) DN_CHAT_FD else DN_MEDIA_FD);
    if(stored==0) {
        return false;
    }
    var to:[16]u8=undefined;
    const extra:u64=if(channel==2) 10 else 0;
    dn_addr(to[0..16],get_u64(b,DN_LOCAL_PORT)+extra);
    const n:i64=dn_send(@as(i32,@intCast(stored-1)),packet,@as(u64,packet.len),0,to[0..16],16);
    if(n!=@as(i64,@intCast(packet.len))) {
        put_u64(b,DN_SEND_ERRNO,dn_errno());
        return false;
    }
    dn_increment(b,DN_PROXY_SENT,1);
    return true;
}
fn dn_room_proof(b:[]u8,packet:[]const u8,nonce:[]const u8)->bool {
    if(packet.len!=304 or nonce.len!=16 or packet[5]!=6 or !ck_same(packet[40..56],nonce)) {
        return false;
    }
    const expiry:u64=get_u64(packet,32);
    const now:u64=dn_now();
    if(expiry<=now or expiry>now+120000) {
        return false;
    }
    return dw_verify(packet,b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65],b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65]);
}
fn dn_inbox(b:[]u8,response:[]const u8)->bool {
    if(response.len<64) {
        return false;
    }
    const batch:u64=get_u64(response,40);
    if(response.len==64) {
        return true;
    }
    if(batch==0) {
        return false;
    }
    if(batch<=get_u64(b,DN_ACK)) {
        return true;
    }
    var at:usize=64;
    var records:u32=0;
    while(at<response.len and records<256) {
        if(at+85>response.len) {
            return false;
        }
        const size:usize=@as(usize,response[at+2])+(@as(usize,response[at+3])<<8);
        if(size>2048 or at+85+size>response.len) {
            return false;
        }
        const kind:u8=response[at];
        const channel:u64=@as(u64,response[at+1]);
        const nonce:[]const u8=response[at+4..at+20];
        const sender:[]const u8=response[at+20..at+85];
        const payload:[]const u8=response[at+85..at+85+size];
        if(ck_same(sender,b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65])) {
            if(kind==1 or kind==2) {
                if(!dn_room_proof(b,payload,nonce)) {
                    put_u64(b,DN_ERROR,31);
                    return false;
                }
                if(kind==1) {
                    const state:u64=get_u64(b,DN_ROOM_STATE);
                    if(state!=5 or !ck_same(nonce,b[DN_ROOM..DN_ROOM+16])) {
                        var i:usize=0;
                        while(i<16) {
                            b[DN_ROOM+i]=nonce[i];
                            i=i+1;
                        }
                        i=0;
                        while(i<304) {
                            b[DN_PEER_ROOM_PROOF+i]=payload[i];
                            i=i+1;
                        }
                        put_u64(b,DN_ROLE,1);
                        put_u64(b,DN_ROOM_STATE,4);
                        put_u64(b,DN_ROUTE,0);
                        put_u64(b,DN_DIRECT_STATE,0);
                        put_u64(b,DN_LOOKUP,1);
                    }
                }
                else {
                    if(!ck_same(nonce,b[DN_ROOM..DN_ROOM+16])) {
                        put_u64(b,DN_ERROR,32);
                        return false;
                    }
                    var i:usize=0;
                    while(i<304) {
                        b[DN_PEER_ROOM_PROOF+i]=payload[i];
                        i=i+1;
                    }
                    dn_room_ready(b);
                }
            }
            else if(kind==3) {
                if(get_u64(b,DN_ROOM_STATE)!=5 or !ck_same(nonce,b[DN_ROOM..DN_ROOM+16])) {
                    put_u64(b,DN_ERROR,33);
                    return false;
                }
                if(!dn_deliver(b,channel,payload)) {
                    return false;
                }
                dn_increment(b,DN_RELAY_RECEIVED,1);
            }
            else {
                put_u64(b,DN_ERROR,34);
                return false;
            }
        }
        // Unknown public identities are not nominated and receive no room consent or content.
        at=at+85+size;
        records=records+1;
    }
    if(at!=response.len) {
        return false;
    }
    put_u64(b,DN_ACK,batch);
    return true;
}
fn dn_finish_http(b:[]u8)->void {
    const connection:u64=get_u64(b,DN_CONNECTION);
    put_u64(b,DN_CONNECTION,0);
    if(connection!=0) {
        dn_release(connection);
    }
    const data:u64=get_u64(b,DN_DATA);
    put_u64(b,DN_DATA,0);
    if(data!=0) {
        dn_release(data);
    }
}
fn dn_protocol_reply(b:[]u8,response:[]const u8)->void {
    const op:u64=get_u64(b,DN_OPERATION);
    if(!dw_reply(response,b[DN_SESSION..DN_SESSION+16],get_u64(b,DN_SENT_SEQUENCE)) or response[6]!=@as(u8,@intCast(op))) {
        put_u64(b,DN_ERROR,35);
        put_u64(b,DN_NEXT,dn_now()+1000);
        return;
    }
    const status:u8=response[5];
    const expiry:u64=get_u64(response,32);
    if(expiry>0) {
        put_u64(b,DN_EXPIRY,expiry);
    }
    if(status>=20) {
        put_u64(b,DN_ERROR,@as(u64,status));
        put_u64(b,DN_NEXT,dn_now()+1000);
        if(status==24 or status==25) {
            put_u64(b,DN_STATE,1);
            put_u64(b,DN_ROOM_STATE,0);
            put_u64(b,DN_ROUTE,0);
            put_u64(b,DN_LOOKUP,1);
            put_u64(b,DN_ACK,0);
            const root:u64=get_u64(b,DN_ROOT);
            dn_root_action(root,false,5);
            dn_root_action(root,true,5);
        }
        return;
    }
    put_u64(b,DN_ERROR,0);
    if(op==1 and status==1) {
        var i:usize=0;
        while(i<16) {
            b[DN_NONCE+i]=response[40+i];
            i=i+1;
        }
        put_u64(b,DN_STATE,2);
    }
    else if(op==2 and status==2) {
        put_u64(b,DN_STATE,3);
        put_u64(b,DN_LOOKUP,1);
        dn_increment(b,DN_REGISTERED,1);
    }
    else if(op==3 and status==3) {
        if(!dn_inbox(b,response)) {
            put_u64(b,DN_ERROR,36);
            put_u64(b,DN_NEXT,dn_now()+1000);
        }
    }
    else if(op==4) {
        dn_increment(b,DN_LOOKUPS,1);
        put_u64(b,DN_LOOKUP,0);
        if(status==4) {
            put_u64(b,DN_OFFLINE,0);
            dn_candidate_reply(b,response);
        }
        else if(status==8) {
            put_u64(b,DN_OFFLINE,1);
            put_u64(b,DN_NEXT,dn_now()+1000);
        }
        else {
            put_u64(b,DN_ERROR,37);
        }
    }
    else if(op==5 and status==5) {
        var i:usize=0;
        while(i<16) {
            b[DN_ROOM+i]=response[40+i];
            i=i+1;
        }
        put_u64(b,DN_ROLE,0);
        put_u64(b,DN_ROOM_STATE,2);
        put_u64(b,DN_ROOM_AT,dn_now());
    }
    else if(op==6 and (status==6 or status==7)) {
        if(status==7) {
            dn_room_ready(b);
        }
        else {
            put_u64(b,DN_ROOM_STATE,3);
        }
    }
    else if(op==9 and status==11) {
        put_u64(b,DN_ADVERTISE_AT,dn_now()+20000);
    }
    else if(op==7 and status==10) {
        const count:u64=get_u64(b,DN_INFLIGHT_FRAMES);
        put_u64(b,DN_TX_HEAD,get_u64(b,DN_TX_HEAD)+count);
        dn_increment(b,DN_RELAY_SENT,count);
        put_u64(b,DN_INFLIGHT_FRAMES,0);
    }
    else {
        put_u64(b,DN_ERROR,38);
        put_u64(b,DN_NEXT,dn_now()+1000);
    }
}
pub fn dn_received_response(self:u64,command:u64,connection:u64,response:u64)->void {
    const p:u64=dn_context(self);
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_CLOSED)!=0 or connection!=get_u64(b,DN_CONNECTION)) {
        return;
    }
    put_u64(b,DN_HTTP_STATUS,dn_m0(response,dn_sel("statusCode")));
    const data:u64=get_u64(b,DN_DATA);
    if(data!=0) {
        dn_m1(data,dn_sel("setLength:"),0);
    }
}
pub fn dn_received_data(self:u64,command:u64,connection:u64,data:u64)->void {
    const p:u64=dn_context(self);
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_CLOSED)!=0 or connection!=get_u64(b,DN_CONNECTION)) {
        return;
    }
    const output:u64=get_u64(b,DN_DATA);
    const incoming:u64=dn_m0(data,dn_sel("length"));
    if(output==0 or incoming>65536 or dn_m0(output,dn_sel("length"))>65536-incoming) {
        put_u64(b,DN_ERROR,39);
        dn_m0(connection,dn_sel("cancel"));
        dn_finish_http(b);
        return;
    }
    dn_m1(output,dn_sel("appendData:"),data);
    dn_increment(b,DN_HTTP_RECEIVED,incoming);
}
pub fn dn_finished(self:u64,command:u64,connection:u64)->void {
    const p:u64=dn_context(self);
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_CLOSED)!=0 or connection!=get_u64(b,DN_CONNECTION)) {
        return;
    }
    const data:u64=get_u64(b,DN_DATA);
    const length:u64=dn_m0(data,dn_sel("length"));
    if(get_u64(b,DN_HTTP_STATUS)==200 and length>=64 and length<=65536) {
        dn_peek(b[DN_RX..DN_RX_END],dn_m0(data,dn_sel("bytes")),length);
        dn_protocol_reply(b,b[DN_RX..DN_RX+@as(usize,length)]);
    }
    else {
        put_u64(b,DN_ERROR,40);
        put_u64(b,DN_NEXT,dn_now()+1000);
    }
    dn_finish_http(b);
}
pub fn dn_failed(self:u64,command:u64,connection:u64,error:u64)->void {
    const p:u64=dn_context(self);
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_CLOSED)!=0 or connection!=get_u64(b,DN_CONNECTION)) {
        return;
    }
    put_u64(b,DN_ERROR,dn_m0(error,dn_sel("code")));
    put_u64(b,DN_NEXT,dn_now()+1000);
    dn_finish_http(b);
}
pub fn dn_redirect(self:u64,command:u64,connection:u64,request:u64,response:u64)->u64 {
    const p:u64=dn_context(self);
    if(p==0) {
        return 0;
    }
    if(response!=0) {
        const v:DNView=dn_view(p);
        put_u64(v.bytes,DN_ERROR,41);
        return 0;
    }
    return request;
}
fn dn_post(b:[]u8,op:u8)->bool {
    if(get_u64(b,DN_CONNECTION)!=0 or get_u64(b,DN_URL)==0) {
        return false;
    }
    var body:[32464]u8=undefined;
    var body_length:usize=0;
    var flags:u8=0;
    const empty:[]const u8=body[0..0];
    var nonce:[]const u8=empty;
    var target:[]const u8=empty;
    if(op>=4 and op!=9) {
        target=b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65];
    }
    if(op==9) {
        target=b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65];
        body_length=dc_gather(get_u64(b,DN_NET_PORT),body[0..145]);
        if(body_length==0) {
            body[0]=0;
            body_length=1;
        }
    }
    if(op==2) {
        nonce=b[DN_NONCE..DN_NONCE+16];
    }
    if(op==5 or op==6 or op==7 or op==8) {
        nonce=b[DN_ROOM..DN_ROOM+16];
    }
    put_u64(b,DN_INFLIGHT_FRAMES,0);
    if(op==3) {
        put_u64(body[0..8],0,get_u64(b,DN_ACK));
        body_length=8;
    }
    if(op==7) {
        const head:u64=get_u64(b,DN_TX_HEAD);
        const tail:u64=get_u64(b,DN_TX_TAIL);
        var count:u64=0;
        while(head+count<tail and count<15) {
            const at:usize=DN_QUEUE+@as(usize,(head+count)%DN_QUEUE_ITEMS)*DN_ITEM;
            const item:u64=get_u64(b,at);
            const size:usize=@as(usize,item&4294967295);
            const channel:u8=@as(u8,@intCast(item>>32));
            if(size<52 or size>2048) {
                put_u64(b,DN_ERROR,42);
                return false;
            }
            if(count==0) {
                flags=channel;
            }
            if(channel!=flags or body_length+size+2>32464) {
                break;
            }
            body[body_length]=@as(u8,@intCast(size&255));
            body[body_length+1]=@as(u8,@intCast(size>>8));
            var i:usize=0;
            while(i<size) {
                body[body_length+2+i]=b[at+8+i];
                i=i+1;
            }
            body_length=body_length+2+size;
            count=count+1;
        }
        if(count==0) {
            return false;
        }
        put_u64(b,DN_INFLIGHT_FRAMES,count);
        put_u64(b,DN_INFLIGHT_CHANNEL,@as(u64,flags));
    }
    const packet:[]u8=b[DN_PACKET..DN_PACKET_END];
    if(!dw_init(packet,op,flags,b[DN_SESSION..DN_SESSION+16],b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65],target)) {
        return false;
    }
    const seq:u64=get_u64(b,DN_SEQUENCE)+1;
    put_u64(b,DN_SEQUENCE,seq);
    const length:usize=dw_payload(packet,seq,get_u64(b,DN_EXPIRY),nonce,body[0..body_length]);
    if(length<304 or length>32768) {
        return false;
    }
    if(op!=1) {
        var canonical:[222]u8=undefined;
        var signature:[128]u8=undefined;
        if(!dw_canonical(packet[0..length],canonical[0..222])) {
            return false;
        }
        const n:u64=dn_root_sign(get_u64(b,DN_ROOT),canonical[0..222],222,signature[0..128],128);
        if(n<8 or n>80) {
            put_u64(b,DN_ERROR,43);
            return false;
        }
        packet[DW_SIGLEN]=@as(u8,@intCast(n));
        packet[DW_SIGLEN+1]=0;
        var i:usize=0;
        while(i<80) {
            packet[DW_SIGNATURE+i]=if(i<@as(usize,n)) signature[i] else 0;
            i=i+1;
        }
    }
    if(op==6) {
        var i:usize=0;
        while(i<304) {
            b[DN_OWN_ROOM_PROOF+i]=packet[i];
            i=i+1;
        }
    }
    const request:u64=dn_request(dn_cls("NSMutableURLRequest"),dn_sel("requestWithURL:cachePolicy:timeoutInterval:"),get_u64(b,DN_URL),1,8.0);
    if(request==0) {
        put_u64(b,DN_ERROR,44);
        return false;
    }
    dn_m1(request,dn_sel("setHTTPMethod:"),dn_cf("POST"));
    dn_m2(request,dn_sel("setValue:forHTTPHeaderField:"),dn_cf("application/octet-stream"),dn_cf("Content-Type"));
    dn_m2(request,dn_sel("setValue:forHTTPHeaderField:"),dn_cf("no-store"),dn_cf("Cache-Control"));
    const number:u64=dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),@as(u64,length));
    dn_m2(request,dn_sel("setValue:forHTTPHeaderField:"),dn_m0(number,dn_sel("stringValue")),dn_cf("Content-Length"));
    dn_m1(request,dn_sel("setHTTPShouldHandleCookies:"),0);
    dn_m1(request,dn_sel("setHTTPBody:"),dn_data_new(dn_cls("NSData"),dn_sel("dataWithBytes:length:"),packet[0..length],@as(u64,length)));
    const data:u64=dn_retain(dn_m0(dn_cls("NSMutableData"),dn_sel("data")));
    put_u64(b,DN_DATA,data);
    put_u64(b,DN_OPERATION,@as(u64,op));
    put_u64(b,DN_SENT_SEQUENCE,seq);
    put_u64(b,DN_HTTP_STATUS,0);
    const connection:u64=dn_m2(dn_cls("NSURLConnection"),dn_sel("connectionWithRequest:delegate:"),request,get_u64(b,DN_DELEGATE));
    if(connection==0) {
        put_u64(b,DN_DATA,0);
        if(data!=0) {
            dn_release(data);
        }
        put_u64(b,DN_ERROR,45);
        return false;
    }
    put_u64(b,DN_CONNECTION,dn_retain(connection));
    dn_increment(b,DN_HTTP_SENT,@as(u64,length));
    dn_increment(b,DN_HTTP_REQUESTS,1);
    if(op==3) {
        put_u64(b,DN_POLL_AT,dn_now());
    }
    return true;
}
pub fn dn_tick(p:u64)->void {
    if(p==0) {
        return;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_CLOSED)!=0 or get_u64(b,DN_URL)==0) {
        return;
    }
    const peer:bool=dn_sync_peer(b);
    dn_drain_proxy(b);
    dn_direct_tick(b);
    const now:u64=dn_now();
    const root:u64=get_u64(b,DN_ROOT);
    if(get_u64(b,DN_ROOM_STATE)==5 and get_u64(b,DN_INTENT)!=0 and get_u64(b,DN_ROUTE)!=0) {
        const audio:bool=get_u64(b,DN_INTENT)==2;
        const state:u32=dn_root_state(root,audio);
        if(state>=5) {
            dn_root_action(root,audio,8);
        }
        if(state==0 or state>=5) {
            if(dn_root_connect(root,audio)) {
                put_u64(b,DN_INTENT,0);
            }
        }
        else {
            put_u64(b,DN_INTENT,0);
        }
    }
    if(get_u64(b,DN_CONNECTION)!=0 or get_u64(b,DN_URL)==0 or now<get_u64(b,DN_NEXT)) {
        return;
    }
    const state:u64=get_u64(b,DN_STATE);
    var op:u8=0;
    if(state==1) {
        op=1;
    }
    else if(state==2) {
        op=2;
    }
    else if(state==3) {
        const room:u64=get_u64(b,DN_ROOM_STATE);
        if(now>=get_u64(b,DN_ADVERTISE_AT)) {
            op=9;
        }
        else if(room==2 or room==4) {
            op=6;
        }
        else if(peer and get_u64(b,DN_LOOKUP)!=0) {
            op=4;
        }
        else if(peer and get_u64(b,DN_INTENT)!=0 and get_u64(b,DN_OFFLINE)!=0) {
            put_u64(b,DN_LOOKUP,1);
            put_u64(b,DN_NEXT,now+1000);
            return;
        }
        else if(peer and get_u64(b,DN_INTENT)!=0 and room==0 and get_u64(b,DN_OFFLINE)==0) {
            op=5;
        }
        else if(room==5 and now>=get_u64(b,DN_ROOM_REFRESH)) {
            op=6;
        }
        else if(room==5 and get_u64(b,DN_ROUTE)!=1 and get_u64(b,DN_TX_TAIL)>get_u64(b,DN_TX_HEAD) and get_u64(b,DN_OPERATION)!=7) {
            op=7;
        }
        else {
            const interval:u64=if(room==5) 0 else 250;
            if(now-get_u64(b,DN_POLL_AT)>=interval) {
                op=3;
            }
        }
    }
    if(op!=0 and !dn_post(b,op)) {
        put_u64(b,DN_NEXT,now+1000);
    }
}
pub fn dn_state(p:u64,k:u32)->u64 {
    if(p==0) {
        return 0;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(k==0) {
        return get_u64(b,DN_STATE);
    }
    if(k==1) {
        return get_u64(b,DN_ERROR);
    }
    if(k==2) {
        return get_u64(b,DN_HTTP_STATUS);
    }
    if(k==3) {
        return get_u64(b,DN_ROUTE);
    }
    if(k==4) {
        return get_u64(b,DN_REGISTERED);
    }
    if(k==5) {
        return get_u64(b,DN_LOOKUPS);
    }
    if(k==6) {
        return get_u64(b,DN_RELAY_SENT);
    }
    if(k==7) {
        return get_u64(b,DN_RELAY_RECEIVED);
    }
    if(k==8) {
        return get_u64(b,DN_PROXY_RECEIVED);
    }
    if(k==9) {
        return get_u64(b,DN_PROXY_SENT);
    }
    if(k==10) {
        return get_u64(b,DN_HTTP_SENT);
    }
    if(k==11) {
        return get_u64(b,DN_HTTP_RECEIVED);
    }
    if(k==12) {
        return get_u64(b,DN_DROPPED);
    }
    if(k==13) {
        return get_u64(b,DN_PROXY_PORT);
    }
    if(k==14) {
        return get_u64(b,DN_TX_TAIL)-get_u64(b,DN_TX_HEAD);
    }
    if(k==15) {
        return get_u64(b,DN_ROOM_STATE);
    }
    if(k==16) {
        return get_u64(b,DN_OFFLINE);
    }
    if(k==17) {
        return get_u64(b,DN_HTTP_REQUESTS);
    }
    if(k==18) {
        return get_u64(b,DN_LOCAL_PORT);
    }
    if(k==19) {
        return get_u64(b,DN_FORCE);
    }
    if(k==20) {
        return get_u64(b,DN_SEND_ERRNO);
    }
    if(k==21) {
        return get_u64(b,DN_DIRECT_STATE);
    }
    if(k==22) {
        return get_u64(b,DN_DIRECT_ATTEMPTS);
    }
    if(k==23) {
        return get_u64(b,DN_DIRECT_ERRNO);
    }
    if(k==24) {
        return get_u64(b,DN_DIRECT_SENT);
    }
    if(k==25) {
        return get_u64(b,DN_DIRECT_RECEIVED);
    }
    if(k==26) {
        return get_u64(b,DN_DIRECT_FALLBACKS);
    }
    if(k==27) {
        return get_u64(b,DN_NET_PORT);
    }
    if(k==28) {
        return @as(u64,b[DN_PEER_CANDIDATES]);
    }
    return 0;
}
pub fn dn_endpoint(p:u64)->u64 {
    if(p==0) {
        return 0;
    }
    const v:DNView=dn_view(p);
    return dn_m0(get_u64(v.bytes,DN_URL),dn_sel("absoluteString"));
}
pub fn dn_status(p:u64)->u64 {
    if(p==0) {
        return dn_cf("Owner transport unavailable; microphone off.");
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    if(get_u64(b,DN_URL)==0) {
        return dn_cf("Set the owner's HTTPS service, then pair a friend's public key.");
    }
    if(get_u64(b,DN_ERROR)!=0) {
        return dn_cf("Owner service unavailable or response refused. No server delivery is claimed.");
    }
    if(get_u64(b,DN_STATE)<3) {
        return dn_cf("Registering this device by signed key-possession proof...");
    }
    if(b[DN_PEER_PUBLIC]!=4) {
        return dn_cf("Device registered. Paste the nominated friend's public key.");
    }
    if(get_u64(b,DN_OFFLINE)!=0) {
        return dn_cf("Friend offline. No message has been delivered.");
    }
    if(get_u64(b,DN_ROOM_STATE)==5) {
        if(get_u64(b,DN_ROUTE)==1) {
            return dn_cf("Authenticated direct outgoing path. Each direction is verified independently.");
        }
        if(get_u64(b,DN_DIRECT_STATE)==1) {
            return dn_cf("Trying the friend's signed direct candidates...");
        }
        if(get_u64(b,DN_FORCE)==1) {
            return dn_cf("Encrypted owner relay explicitly selected for diagnosis.");
        }
        if(get_u64(b,DN_DIRECT_RECEIVED)>0) {
            return dn_cf("Outgoing owner relay; authenticated incoming direct path.");
        }
        return dn_cf("Direct unavailable; encrypted owner relay selected automatically.");
    }
    if(get_u64(b,DN_INTENT)!=0 or get_u64(b,DN_ROOM_STATE)!=0) {
        return dn_cf("Finding the nominated friend and authorizing a private pair room...");
    }
    return dn_cf("Peer key selected. Connect chat or call; no IP address required.");
}
pub fn dn_public_fingerprint(p:u64,peer:bool)->u64 {
    if(p==0) {
        return 0;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    const at:usize=if(peer) DN_PEER_PUBLIC else DN_OWN_PUBLIC;
    if(b[at]!=4) {
        return 0;
    }
    var hash:[32]u8=undefined;
    if(!ks_sha256(b[at..at+65],hash[0..32])) {
        return 0;
    }
    const hex:[]const u8="0123456789abcdef";
    var text:[64]u8=undefined;
    var i:usize=0;
    while(i<32) {
        text[i*2]=hex[hash[i]/16];
        text[i*2+1]=hex[hash[i]%16];
        i=i+1;
    }
    return dn_cf(text[0..64]);
}
test native_directory_regions_and_null_entry_are_safe {
    assert DN_PEER_ROOM_PROOF+304<=DN_RX and DN_RX_END<=DN_PACKET;
    assert DN_PACKET_END==DN_QUEUE and DN_QUEUE+64*DN_ITEM==DN_QUEUE_END and DN_QUEUE_END<=DN_BYTES;
    assert dn_open(0,49901)==0 and !dn_configure(0,0,false) and !dn_pair(0,0) and !dn_connect(0,false);
    assert dn_state(0,0)==0 and dn_endpoint(0)==0;
}
test end_preserves_inflight_prefix_and_discards_only_unsent_media {
    var bytes:[DN_BYTES]u8=undefined;
    ck_wipe(bytes[0..DN_BYTES]);
    var media:[52]u8=undefined;
    ck_wipe(media[0..52]);
    media[0]=84;
    media[1]=50;
    media[2]=55;
    media[3]=80;
    media[4]=1;
    media[5]=32;
    var i:u32=0;
    while(i<48) {
        assert dn_queue_frame(bytes[0..DN_BYTES],2,media[0..52]);
        i=i+1;
    }
    assert !dn_queue_frame(bytes[0..DN_BYTES],2,media[0..52]);
    put_u64(bytes[0..DN_BYTES],DN_CONNECTION,1);
    put_u64(bytes[0..DN_BYTES],DN_OPERATION,7);
    put_u64(bytes[0..DN_BYTES],DN_INFLIGHT_FRAMES,15);
    media[5]=20;
    assert dn_queue_frame(bytes[0..DN_BYTES],2,media[0..52]);
    assert get_u64(bytes[0..DN_BYTES],DN_TX_HEAD)==0 and get_u64(bytes[0..DN_BYTES],DN_TX_TAIL)==16;
    assert bytes[DN_QUEUE+14*DN_ITEM+8+5]==32 and bytes[DN_QUEUE+15*DN_ITEM+8+5]==20;
}
fn dn_net_option(fd:i32,level:i32,key:i32,value:[]const u8,n:u32)->i32 {
    return @extern("setsockopt");
}
fn dn_net_open(b:[]u8)->bool {
    const fd:i32=dn_socket(30,2,0);
    if(fd<0) {
        return false;
    }
    var zero:[4]u8=undefined;
    ck_wipe(zero[0..4]);
    var address:[28]u8=undefined;
    ck_wipe(address[0..28]);
    address[0]=28;
    address[1]=30;
    if(dn_net_option(fd,41,27,zero[0..4],4)!=0 or dn_bind(fd,address[0..28],28)!=0 or dn_fcntl(fd,4,4)!=0) {
        dn_close_fd(fd);
        return false;
    }
    var size:[1]u32=undefined;
    size[0]=28;
    if(dn_sockname(fd,address[0..28],size)!=0) {
        dn_close_fd(fd);
        return false;
    }
    put_u64(b,DN_NET_FD,@as(u64,@intCast(fd+1)));
    put_u64(b,DN_NET_PORT,@as(u64,address[2])*256+@as(u64,address[3]));
    return true;
}
fn dn_room_ready(b:[]u8)->void {
    if(get_u64(b,DN_ROOM_STATE)!=5) {
        put_u64(b,DN_ROUTE,0);
        put_u64(b,DN_DIRECT_STATE,0);
        put_u64(b,DN_DIRECT_ADMITTED,0);
    }
    put_u64(b,DN_ROOM_STATE,5);
    put_u64(b,DN_ROOM_REFRESH,dn_now()+20000);
}
fn dn_candidate_reply(b:[]u8,response:[]const u8)->bool {
    if(response.len==64) {
        return false;
    }
    if(response.len<369 or response.len>513) {
        return false;
    }
    const proof:[]const u8=response[64..response.len];
    const length:usize=@as(usize,dw_u32(proof,DW_LENGTH));
    if(proof[5]!=9 or length>145 or length+304!=proof.len or !dc_valid(proof[304..proof.len],false)
    or !dw_verify(proof,b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65],b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65])) {
        return false;
    }
    const expiry:u64=get_u64(proof,32);
    const now:u64=dn_now();
    if(expiry<=now or expiry>now+60000) {
        return false;
    }
    const old_length:usize=1+@as(usize,b[DN_PEER_CANDIDATES])*18;
    if(old_length>145 or !ck_same(b[DN_PEER_CANDIDATES..DN_PEER_CANDIDATES+old_length],proof[304..proof.len])) {
        put_u64(b,DN_DIRECT_ADMITTED,0);
        put_u64(b,DN_DIRECT_STATE,0);
        put_u64(b,DN_ROUTE,0);
    }
    ck_wipe(b[DN_PEER_CANDIDATES..DN_PEER_CANDIDATES+145]);
    var i:usize=0;
    while(i<length) {
        b[DN_PEER_CANDIDATES+i]=proof[304+i];
        i=i+1;
    }
    ck_wipe(b[DN_PEER_ADVERTISEMENT..DN_PEER_ADVERTISEMENT+512]);
    i=0;
    while(i<proof.len) {
        b[DN_PEER_ADVERTISEMENT+i]=proof[i];
        i=i+1;
    }
    return true;
}
fn dn_candidate_source(b:[]const u8,endpoint:[]const u8)->bool {
    const count:usize=@as(usize,b[DN_PEER_CANDIDATES]);
    if(count>8) {
        return false;
    }
    var i:usize=0;
    while(i<count) {
        const at:usize=DN_PEER_CANDIDATES+1+i*18;
        if(ck_same(endpoint,b[at..at+18])) {
            return true;
        }
        i=i+1;
    }
    return false;
}
fn dn_udp_send(b:[]u8,endpoint:[]const u8,packet:[]const u8)->bool {
    const stored:u64=get_u64(b,DN_NET_FD);
    if(stored==0 or !dn_candidate_source(b,endpoint)) {
        dn_increment(b,DN_DIRECT_DENIED,1);
        return false;
    }
    var address:[28]u8=undefined;
    if(ip6_sa6(endpoint,address[0..28])!=28) {
        return false;
    }
    var index:usize=0;
    while(index<8) {
        const at:usize=DN_PEER_CANDIDATES+1+index*18;
        if(ck_same(endpoint,b[at..at+18])) {
            break;
        }
        index=index+1;
    }
    if(index>=8) {
        return false;
    }
    const audit:usize=DN_DESTINATION_AUDIT+index*24;
    dn_increment(b,audit,1);
    const result:i64=dn_send(@as(i32,@intCast(stored-1)),packet,@as(u64,packet.len),0,address[0..28],28);
    if(result!=@as(i64,@intCast(packet.len))) {
        const error:u64=dn_errno();
        put_u64(b,DN_DIRECT_ERRNO,error);
        put_u64(b,audit+16,error);
        return false;
    }
    dn_increment(b,audit+8,1);
    return true;
}
fn dn_direct_proof(b:[]u8,endpoint:[]const u8,challenge:[]const u8,reply:bool)->bool {
    if(challenge.len!=16 or get_u64(b,DN_ROOM_STATE)!=5 or get_u64(b,DN_FORCE)==1) {
        return false;
    }
    var packet:[320]u8=undefined;
    if(!dw_init(packet[0..320],6,if(reply) 9 else 8,b[DN_SESSION..DN_SESSION+16],b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65],b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65])) {
        return false;
    }
    const seq:u64=get_u64(b,DN_DIRECT_SEQUENCE)+1;
    put_u64(b,DN_DIRECT_SEQUENCE,seq);
    const expiry:u64=get_u64(b,DN_EXPIRY);
    const now:u64=dn_now();
    if(expiry<=now) {
        return false;
    }
    const until:u64=if(expiry<now+10000) expiry else now+10000;
    if(dw_payload(packet[0..320],seq,until,b[DN_ROOM..DN_ROOM+16],challenge)!=320) {
        return false;
    }
    var canonical:[222]u8=undefined;
    var signature:[128]u8=undefined;
    if(!dw_canonical(packet[0..320],canonical[0..222])) {
        return false;
    }
    const n:u64=dn_root_sign(get_u64(b,DN_ROOT),canonical[0..222],222,signature[0..128],128);
    if(n<8 or n>80) {
        return false;
    }
    packet[DW_SIGLEN]=@as(u8,@intCast(n));
    packet[DW_SIGLEN+1]=0;
    var i:usize=0;
    while(i<@as(usize,n)) {
        packet[DW_SIGNATURE+i]=signature[i];
        i=i+1;
    }
    return dn_udp_send(b,endpoint,packet[0..320]);
}
fn dn_direct_probe_received(b:[]u8,endpoint:[]const u8,packet:[]const u8)->bool {
    if(packet.len!=320 or packet[5]!=6 or (packet[6]!=8 and packet[6]!=9) or get_u64(b,DN_ROOM_STATE)!=5 or get_u64(b,DN_FORCE)==1) {
        return false;
    }
    if(!dn_candidate_source(b,endpoint) or !ck_same(packet[40..56],b[DN_ROOM..DN_ROOM+16])
    or !ck_same(packet[8..24],b[DN_PEER_ROOM_PROOF+8..DN_PEER_ROOM_PROOF+24])
    or !dw_verify(packet,b[DN_PEER_PUBLIC..DN_PEER_PUBLIC+65],b[DN_OWN_PUBLIC..DN_OWN_PUBLIC+65])) {
        return false;
    }
    const now:u64=dn_now();
    const expiry:u64=get_u64(packet,32);
    if(expiry<=now or expiry>now+10000) {
        return false;
    }
    if(packet[6]==8) {
        dn_admit_source(b,endpoint);
        return dn_direct_proof(b,endpoint,packet[304..320],true);
    }
    if(!ck_same(packet[304..320],b[DN_DIRECT_CHALLENGE..DN_DIRECT_CHALLENGE+16])) {
        return false;
    }
    var i:usize=0;
    while(i<18) {
        b[DN_DIRECT_SELECTED+i]=endpoint[i];
        b[DN_DIRECT_INBOUND+i]=endpoint[i];
        i=i+1;
    }
    dn_admit_source(b,endpoint);
    put_u64(b,DN_DIRECT_STATE,2);
    put_u64(b,DN_ROUTE,1);
    put_u64(b,DN_DIRECT_LAST,now);
    return true;
}
fn dn_direct_fragment(b:[]u8,endpoint:[]const u8,packet:[]const u8)->bool {
    if(packet.len<36 or packet.len>1060 or packet[0]!=84 or packet[1]!=50 or packet[2]!=55 or packet[3]!=82 or packet[4]!=1
    or (packet[5]!=1 and packet[5]!=2) or packet[7]<1 or packet[7]>2 or packet[6]>=packet[7]
    or !dn_admitted_source(b,endpoint) or get_u64(b,DN_FORCE)==1
    or !ck_same(packet[8..24],b[DN_ROOM..DN_ROOM+16])) {
        return false;
    }
    const total:usize=@as(usize,packet[32])+@as(usize,packet[33])*256;
    const offset:usize=@as(usize,packet[6])*1024;
    if(total<52 or total>2048 or offset>=total or packet[7]!=@as(u8,@intCast((total+1023)/1024))) {
        return false;
    }
    const part:usize=if(total-offset>1024) 1024 else total-offset;
    if(packet.len!=36+part) {
        return false;
    }
    const seq:u64=get_u64(packet,24);
    const at:usize=DN_REASSEMBLY+@as(usize,seq%8)*DN_REASSEMBLY_ITEM;
    const now:u64=dn_now();
    if(get_u64(b,at)!=seq or get_u64(b,at+8)<=now) {
        ck_wipe(b[at..at+DN_REASSEMBLY_ITEM]);
        put_u64(b,at,seq);
        put_u64(b,at+8,now+2000);
        put_u64(b,at+16,@as(u64,total));
        b[at+24]=packet[5];
    }
    if(get_u64(b,at+16)!=@as(u64,total) or b[at+24]!=packet[5]) {
        return false;
    }
    const mask:u8=if(packet[6]==0) 1 else 2;
    if((b[at+25]&mask)!=0) {
        return true;
    }
    var i:usize=0;
    while(i<part) {
        b[at+40+offset+i]=packet[36+i];
        i=i+1;
    }
    b[at+25]=b[at+25]|mask;
    const complete:u8=if(packet[7]==1) 1 else 3;
    if(b[at+25]==complete) {
        if(!dn_deliver(b,@as(u64,packet[5]),b[at+40..at+40+total])) {
            return false;
        }
        dn_increment(b,DN_DIRECT_RECEIVED,1);
    }
    return true;
}
fn dn_direct_poll(b:[]u8)->void {
    const stored:u64=get_u64(b,DN_NET_FD);
    if(stored==0) {
        return;
    }
    var count:u32=0;
    while(count<64) {
        var packet:[1061]u8=undefined;
        var address:[28]u8=undefined;
        var size:[1]u32=undefined;
        size[0]=28;
        const n:i64=dn_recv(@as(i32,@intCast(stored-1)),packet[0..1061],1061,0,address[0..28],size);
        if(n<=0) {
            break;
        }
        var endpoint:[18]u8=undefined;
        if(n<=1060 and ip6_sa_take(address[0..28],@as(usize,size[0]),endpoint[0..18]) and dn_candidate_source(b,endpoint[0..18]) and get_u64(b,DN_ROOM_STATE)==5) {
            const bytes:[]const u8=packet[0..@as(usize,@intCast(n))];
            if(n==320 and packet[3]==68) {
                if(!dn_direct_probe_received(b,endpoint[0..18],bytes)) {
                    dn_increment(b,DN_DIRECT_DENIED,1);
                }
            }
            else {
                if(!dn_direct_fragment(b,endpoint[0..18],bytes)) {
                    dn_increment(b,DN_DIRECT_DENIED,1);
                }
            }
        }
        else {
            dn_increment(b,DN_DIRECT_DENIED,1);
        }
        count=count+1;
    }
}
fn dn_direct_flush(b:[]u8)->void {
    if(get_u64(b,DN_ROUTE)!=1 or (get_u64(b,DN_CONNECTION)!=0 and get_u64(b,DN_OPERATION)==7)) {
        return;
    }
    var count:u32=0;
    while(get_u64(b,DN_TX_HEAD)<get_u64(b,DN_TX_TAIL) and count<64) {
        const head:u64=get_u64(b,DN_TX_HEAD);
        const at:usize=DN_QUEUE+@as(usize,head%DN_QUEUE_ITEMS)*DN_ITEM;
        const word:u64=get_u64(b,at);
        const size:usize=@as(usize,word&4294967295);
        if(size<52 or size>2048) {
            return;
        }
        const seq:u64=get_u64(b,DN_DIRECT_SEQUENCE)+1;
        put_u64(b,DN_DIRECT_SEQUENCE,seq);
        const fragments:usize=(size+1023)/1024;
        var fragment:usize=0;
        var good:bool=true;
        while(fragment<fragments) {
            var packet:[1060]u8=undefined;
            ck_wipe(packet[0..36]);
            packet[0]=84;
            packet[1]=50;
            packet[2]=55;
            packet[3]=82;
            packet[4]=1;
            packet[5]=@as(u8,@intCast(word>>32));
            packet[6]=@as(u8,@intCast(fragment));
            packet[7]=@as(u8,@intCast(fragments));
            var i:usize=0;
            while(i<16) {
                packet[8+i]=b[DN_ROOM+i];
                i=i+1;
            }
            put_u64(packet[0..36],24,seq);
            packet[32]=@as(u8,@intCast(size&255));
            packet[33]=@as(u8,@intCast(size/256));
            const offset:usize=fragment*1024;
            const part:usize=if(size-offset>1024) 1024 else size-offset;
            i=0;
            while(i<part) {
                packet[36+i]=b[at+8+offset+i];
                i=i+1;
            }
            if(!dn_udp_send(b,b[DN_DIRECT_SELECTED..DN_DIRECT_SELECTED+18],packet[0..36+part])) {
                good=false;
                break;
            }
            fragment=fragment+1;
        }
        if(!good) {
            put_u64(b,DN_ROUTE,2);
            put_u64(b,DN_DIRECT_STATE,3);
            dn_increment(b,DN_DIRECT_FALLBACKS,1);
            return;
        }
        put_u64(b,DN_TX_HEAD,head+1);
        dn_increment(b,DN_DIRECT_SENT,1);
        count=count+1;
    }
}
fn dn_direct_tick(b:[]u8)->void {
    dn_direct_poll(b);
    if(get_u64(b,DN_ROOM_STATE)!=5) {
        return;
    }
    const now:u64=dn_now();
    if(get_u64(b,DN_FORCE)==1) {
        put_u64(b,DN_ROUTE,2);
        put_u64(b,DN_DIRECT_STATE,3);
        return;
    }
    const state:u64=get_u64(b,DN_DIRECT_STATE);
    if(state==0) {
        if(get_u64(b,DN_NET_FD)==0) {
            put_u64(b,DN_ROUTE,2);
            put_u64(b,DN_DIRECT_STATE,3);
            return;
        }
        if(dn_random(0,16,b[DN_DIRECT_CHALLENGE..DN_DIRECT_CHALLENGE+16])!=0) {
            put_u64(b,DN_ROUTE,2);
            put_u64(b,DN_DIRECT_STATE,3);
            return;
        }
        put_u64(b,DN_DIRECT_STATE,1);
        put_u64(b,DN_DIRECT_DEADLINE,now+1600);
        put_u64(b,DN_DIRECT_NEXT,0);
        put_u64(b,DN_DIRECT_INDEX,0);
    }
    if(state==1 and now>=get_u64(b,DN_DIRECT_DEADLINE)) {
        put_u64(b,DN_ROUTE,2);
        put_u64(b,DN_DIRECT_STATE,3);
        dn_increment(b,DN_DIRECT_FALLBACKS,1);
        return;
    }
    if((state==1 or state==2) and now>=get_u64(b,DN_DIRECT_NEXT)) {
        const count:usize=@as(usize,b[DN_PEER_CANDIDATES]);
        if(count>0 and count<=8) {
            const index:u64=get_u64(b,DN_DIRECT_INDEX);
            const at:usize=DN_PEER_CANDIDATES+1+@as(usize,index%@as(u64,count))*18;
            if(state==2) {
                if(dn_random(0,16,b[DN_DIRECT_CHALLENGE..DN_DIRECT_CHALLENGE+16])!=0) {
                    return;
                }
                dn_direct_proof(b,b[DN_DIRECT_SELECTED..DN_DIRECT_SELECTED+18],b[DN_DIRECT_CHALLENGE..DN_DIRECT_CHALLENGE+16],false);
            }
            else {
                dn_direct_proof(b,b[at..at+18],b[DN_DIRECT_CHALLENGE..DN_DIRECT_CHALLENGE+16],false);
            }
            dn_increment(b,DN_DIRECT_ATTEMPTS,1);
            put_u64(b,DN_DIRECT_INDEX,index+1);
        }
        const interval:u64=if(state==2) 1000 else 100;
        put_u64(b,DN_DIRECT_NEXT,now+interval);
    }
    if(state==2 and now>get_u64(b,DN_DIRECT_LAST)+2500) {
        put_u64(b,DN_ROUTE,2);
        put_u64(b,DN_DIRECT_STATE,3);
        dn_increment(b,DN_DIRECT_FALLBACKS,1);
    }
    dn_direct_flush(b);
}
test direct_regions_are_disjoint_and_unpaired_udp_is_denied {
    assert DN_DIRECT_SELECTED+18<=DN_DESTINATION_AUDIT and DN_DESTINATION_AUDIT+8*24<=DN_DIRECT_ADMITTED;
    assert DN_DIRECT_ADMITTED+8<=DN_DIRECT_INBOUND and DN_DIRECT_INBOUND+18<DN_OWN_PUBLIC;
    assert DN_QUEUE_END<=DN_OWN_CANDIDATES and DN_OWN_CANDIDATES+145<=DN_PEER_CANDIDATES;
    assert DN_PEER_CANDIDATES+145<=DN_PEER_ADVERTISEMENT and DN_PEER_ADVERTISEMENT+512<=DN_REASSEMBLY;
    assert DN_REASSEMBLY+8*DN_REASSEMBLY_ITEM<=DN_BYTES;
    var b:[DN_BYTES]u8=undefined;
    ck_wipe(b[0..DN_BYTES]);
    var endpoint:[18]u8=undefined;
    ck_wipe(endpoint[0..18]);
    var packet:[320]u8=undefined;
    ck_wipe(packet[0..320]);
    assert !dn_candidate_source(b[0..DN_BYTES],endpoint[0..18]);
    assert !dn_direct_probe_received(b[0..DN_BYTES],endpoint[0..18],packet[0..320]);
    assert !dn_direct_fragment(b[0..DN_BYTES],endpoint[0..18],packet[0..320]);
}
pub fn dn_destinations(p:u64)->u64 {
    if(p==0) {
        return 0;
    }
    const v:DNView=dn_view(p);
    const b:[]u8=v.bytes;
    const result:u64=dn_m0(dn_cls("NSMutableArray"),dn_sel("array"));
    var i:usize=0;
    while(i<@as(usize,b[DN_PEER_CANDIDATES]) and i<8) {
        const at:usize=DN_PEER_CANDIDATES+1+i*18;
        var text:[80]u8=undefined;
        const n:usize=ip6_text(b[at..at+18],text[0..80]);
        const row:u64=dn_m0(dn_cls("NSMutableDictionary"),dn_sel("dictionary"));
        dn_m2(row,dn_sel("setObject:forKey:"),dn_cf(text[0..n]),dn_cf("endpoint"));
        const audit:usize=DN_DESTINATION_AUDIT+i*24;
        dn_m2(row,dn_sel("setObject:forKey:"),dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),get_u64(b,audit)),dn_cf("attempts"));
        dn_m2(row,dn_sel("setObject:forKey:"),dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),get_u64(b,audit+8)),dn_cf("sentDatagrams"));
        dn_m2(row,dn_sel("setObject:forKey:"),dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),get_u64(b,audit+16)),dn_cf("errno"));
        dn_m1(result,dn_sel("addObject:"),row);
        i=i+1;
    }
    return result;
}
// Different verified IPv4/IPv6 source candidates may carry opposite directions.
fn dn_admit_source(b:[]u8,endpoint:[]const u8)->bool {
    var i:usize=0;
    while(i<@as(usize,b[DN_PEER_CANDIDATES]) and i<8) {
        const at:usize=DN_PEER_CANDIDATES+1+i*18;
        if(ck_same(endpoint,b[at..at+18])) {
            const bit:u64=@as(u64,1)<<@as(u6,@intCast(i));
            put_u64(b,DN_DIRECT_ADMITTED,get_u64(b,DN_DIRECT_ADMITTED)|bit);
            return true;
        }
        i=i+1;
    }
    return false;
}
fn dn_admitted_source(b:[]const u8,endpoint:[]const u8)->bool {
    var i:usize=0;
    while(i<@as(usize,b[DN_PEER_CANDIDATES]) and i<8) {
        const bit:u64=@as(u64,1)<<@as(u6,@intCast(i));
        const at:usize=DN_PEER_CANDIDATES+1+i*18;
        if((get_u64(b,DN_DIRECT_ADMITTED)&bit)!=0 and ck_same(endpoint,b[at..at+18])) {
            return true;
        }
        i=i+1;
    }
    return false;
}
test admitting_second_verified_candidate_does_not_revoke_the_first {
    var b:[DN_BYTES]u8=undefined;
    ck_wipe(b[0..DN_BYTES]);
    b[DN_PEER_CANDIDATES]=2;
    const a:usize=DN_PEER_CANDIDATES+1;
    const c:usize=a+18;
    b[a+10]=255;
    b[a+11]=255;
    b[a+12]=192;
    b[a+13]=168;
    b[a+14]=1;
    b[a+15]=3;
    b[a+16]=194;
    b[a+17]=237;
    b[c]=32;
    b[c+1]=1;
    b[c+2]=13;
    b[c+3]=184;
    b[c+15]=1;
    b[c+16]=194;
    b[c+17]=237;
    assert !dn_admitted_source(b[0..DN_BYTES],b[a..a+18]);
    assert dn_admit_source(b[0..DN_BYTES],b[a..a+18]);
    assert dn_admit_source(b[0..DN_BYTES],b[c..c+18]);
    assert dn_admitted_source(b[0..DN_BYTES],b[a..a+18]) and dn_admitted_source(b[0..DN_BYTES],b[c..c+18]);
    assert get_u64(b[0..DN_BYTES],DN_DIRECT_ADMITTED)==3;
    put_u64(b[0..DN_BYTES],DN_DIRECT_ADMITTED,0);
    assert !dn_admitted_source(b[0..DN_BYTES],b[a..a+18]) and !dn_admitted_source(b[0..DN_BYTES],b[c..c+18]);
}
