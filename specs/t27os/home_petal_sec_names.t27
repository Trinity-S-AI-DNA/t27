// specs/t27os/home_petal_sec_names.t27 -- HOME petal SEC_NAMES nav inside
// dashboard content panel.
// Part of M6 milestone (milestone #10). Closes #14070.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::home_petal_sec_names;

pub const HOME_PETAL_SEC_NAMES_MAX : u32 = 27;

pub struct HomePetalSecNames { name: str, in_dashboard_panel: bool };

pub fn home_petal_sec_names_in_panel(h: HomePetalSecNames) -> bool {
    return h.in_dashboard_panel;
}

test "home_petal_sec_names_in_panel" {
    assert(home_petal_sec_names_in_panel(HomePetalSecNames { name: "HOME", in_dashboard_panel: true }));
    assert(!home_petal_sec_names_in_panel(HomePetalSecNames { name: "HOME", in_dashboard_panel: false }));
}

invariant home_petal_sec_names_max_positive {
    assert HOME_PETAL_SEC_NAMES_MAX > 0;
}