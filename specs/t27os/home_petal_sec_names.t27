// specs/t27os/home_petal_sec_names.t27 -- t27os: move HOME petal SEC_NAMES nav inside
// dashboard content panel.
// Part of M10 milestone (milestone #14). Closes #14071.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::home_petal_sec_names;

pub const HOME_PETAL_MAX_ITEMS : u32 = 27;

pub struct HomePetal { id: str, nav_active: bool };

pub fn home_petal_nav_active(p: HomePetal) -> bool {
    return p.nav_active;
}

test "home_petal_nav_active" {
    assert(home_petal_nav_active(HomePetal { id: "home", nav_active: true }));
    assert(!home_petal_nav_active(HomePetal { id: "home", nav_active: false }));
}

invariant home_petal_max_items_positive {
    assert HOME_PETAL_MAX_ITEMS > 0;
}