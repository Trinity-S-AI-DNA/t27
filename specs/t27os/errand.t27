// SPDX-License-Identifier: Apache-2.0
// specs/t27os/errand.t27 -- t27os: errand contract for pane driving -- id, sent,
// accepted, running, returned.
// Part of M1 (milestone #5). Closes #13068.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::errand;

pub const ERRAND_MAX : u32 = 256;

pub struct Errand { id: str, sent: bool, accepted: bool, running: bool, returned: bool };

pub fn errand_complete(e: Errand) -> bool {
    return e.sent && e.accepted && e.running && e.returned;
}

test "errand complete" {
    assert(errand_complete(Errand { id: "e1", sent: true, accepted: true, running: true, returned: true }));
    assert(!errand_complete(Errand { id: "e2", sent: true, accepted: false, running: false, returned: false }));
}

invariant errand_max_positive {
    assert ERRAND_MAX > 0;
}