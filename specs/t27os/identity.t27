fn same(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_mirror_table_equals_the_agent_modules_cell_for_cell {
    var o : u32 = 1;
    while (o <= 27) {
        assert same(name_of(o), a_name_of(o));
        assert same(domain_of(o), a_domain_of(o));
        assert same(archetype_of(o), a_archetype_of(o));
        assert same(register_of(o), a_register_of(o));
        assert same(layer_of(o), a_layer_of(o));
        assert skill_n(o) == a_skill_n(o);
        assert tool_n(o) == a_tool_n(o);
        assert key_n(o) == a_key_n(o);
        var i : u32 = 0;
        while (i < a_skill_n(o)) { assert same(skill_at(o, i), a_skill_at(o, i)); i = i + 1; }
        i = 0;
        while (i < a_tool_n(o)) { assert same(tool_at(o, i), a_tool_at(o, i)); i = i + 1; }
        i = 0;
        while (i < a_key_n(o)) { assert same(key_at(o, i), a_key_at(o, i)); i = i + 1; }
        o = o + 1;
    }
}

test every_letter_has_a_name_a_domain_and_a_register {
    var o : u32 = 1;
    while (o <= 27) {
        assert a_name_of(o).len > 0;
        assert a_domain_of(o).len > 0;
        assert a_archetype_of(o).len > 0;
        assert a_register_of(o).len > 0;
        assert a_layer_of(o).len > 0;
        o = o + 1;
    }
    assert a_name_of(0).len == 0;
    assert a_name_of(28).len == 0;
    assert a_layer_of(1) == "Archetypal";
}

test the_card_of_gamma_reads_the_agent_module {
    assert a_name_of(3) == "Gamma";
    assert a_register_of(3) == "R2";
    assert a_skill_n(3) == 2;
    assert a_skill_at(3, 0) == "trinity/vibee-gen";
    assert a_tool_n(3) == 19;
    assert a_tool_at(3, 4) == "tri/abandoned";
    assert a_tool_at(3, 19).len == 0;
    assert a_tool_n(21) == 0;
    assert a_skill_at(99, 0).len == 0;
}

test the_key_files_are_read_by_use {
    assert a_key_n(7) == 3;
    assert a_key_at(7, 2) == "specs/graph/";
    assert a_key_at(7, 3).len == 0;
    assert a_key_n(0) == 0;
}
