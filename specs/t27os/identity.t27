    if (o == 14) { return N::LETTER_NAME; }
    if (o == 15) { return O::LETTER_NAME; }
    if (o == 16) { return P::LETTER_NAME; }
    if (o == 17) { return Q::LETTER_NAME; }
    if (o == 18) { return R::LETTER_NAME; }
    if (o == 19) { return S::LETTER_NAME; }
    if (o == 20) { return T::LETTER_NAME; }
    if (o == 21) { return U::LETTER_NAME; }
    if (o == 22) { return V::LETTER_NAME; }
    if (o == 23) { return W::LETTER_NAME; }
    if (o == 24) { return X::LETTER_NAME; }
