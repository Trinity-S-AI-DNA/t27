; T27OS-IDENTITY-SYSTEM
; Purpose: Implement "Native Names" (0x-convention) for Actors and Users.
; Law L7 Compliance: Spec-first ternary.

module identity_system {
  
  type ActorId = string;
  type NativeName = string; // Format: 0x[Name] or 0x[Hash]

  struct Identity {
    actor_id: ActorId;
    native_name: NativeName;
    verified: bool;
  }

  // Registry mapping ActorId to Identity
  identity_registry: Map<ActorId, Identity>;

  // Mapping for quick lookups from NativeName to ActorId
  name_to_id: Map<NativeName, ActorId>;

  task claim_name {
    input: id: ActorId, name: NativeName;
    
    // Validation: Name must start with 0x
    assert name.starts_with("0x") == true;
    
    // Check if name is already taken
    assert name_to_id.contains(name) == false;
    
    // Register the identity
    identity_registry[id] = { actor_id: id, native_name: name, verified: true };
    name_to_id[name] = id;
  }

  task resolve_name {
    input: name: NativeName;
    return name_to_id[name];
  }

  task resolve_id {
    input: id: ActorId;
    return identity_registry[id].native_name;
  }

  invariant uniqueness {
    // One name can belong to only one ActorId
    assert name_to_id.values().unique() == true;
  }

  // TDD
  test identity_flow {
    assert identity_system.claim_name("actor-1", "0xQueen") == true;
    assert identity_system.resolve_name("0xQueen") == "actor-1";
    assert identity_system.resolve_id("actor-1") == "0xQueen";
    assert identity_system.claim_name("actor-2", "0xQueen") == false;
  }

  test identity_invalid_format {
    // Should fail because it doesn't start with 0x
    assert identity_system.claim_name("actor-3", "Queen") == false;
  }

  test identity_collision {
    assert identity_system.claim_name("actor-4", "0xSovereign") == true;
    assert identity_system.claim_name("actor-5", "0xSovereign") == false;
  }
}
