// specs/t27os/pointer_keyboard.t27 -- t27os: forward pointer and keyboard -
// browser pane.
// Part of M6 milestone (milestone #10). Closes #14039.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::pointer_keyboard;

pub const POINTER_KEYBOARD_MAX_KEYS : u32 = 128;

pub struct PointerEvent { x: u32, y: u32, pressed: bool };

pub struct KeyboardEvent { key: u32, pressed: bool };

pub fn pointer_event_pressed(p: PointerEvent) -> bool {
    return p.pressed;
}

pub fn keyboard_event_pressed(k: KeyboardEvent) -> bool {
    return k.pressed;
}

test "pointer_event_pressed" {
    assert(pointer_event_pressed(PointerEvent { x: 100, y: 200, pressed: true }));
    assert(!pointer_event_pressed(PointerEvent { x: 100, y: 200, pressed: false }));
}

test "keyboard_event_pressed" {
    assert(keyboard_event_pressed(KeyboardEvent { key: 65, pressed: true }));
    assert(!keyboard_event_pressed(KeyboardEvent { key: 65, pressed: false }));
}

invariant pointer_keyboard_max_keys_positive {
    assert POINTER_KEYBOARD_MAX_KEYS > 0;
}