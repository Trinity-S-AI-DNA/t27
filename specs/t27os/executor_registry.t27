// SPDX-License-Identifier: Apache-2.0
; specs/t27os/executor_registry.t27 -- the one registry behind the central map (owner, 2026-11-03:
; "сделать единый реестр для карты"). It separates the entities the old counters folded into one
; number: an ENVIRONMENT (Claude Code / Shell / Queen pane / DSH service) is not an executor
; instance, a model string is launch configuration and not proof of upstream, a process existing
; is not a task running, and fresh terminal output is not a verified result.
; --
; The evidence ladder (owner's table, each step needs its own proof, idle is not a fault and
; output is not success):
;   DECLARED   named in the roster (agents.t27) -- nothing else claimed
;   DISCOVERED found in an allowed source (pane listing, service probe)
;   REACHABLE  the interface answers (process alive, HTTP answers)
;   ASSIGNED   a concrete executor-to-task link exists in an assignment source
;   OBSERVED   execution events for that attempt were seen
;   RESULTED   an artifact or completed answer exists
;   VERIFIED   the intended test/acceptance was run on it
;   BROKEN     a confirmed launch-path error (named per path, never spread over a whole kind)
;   OUTSIDE    a process outside the current confirmed registry (no hooks profile is NOT proof
;              of foreign origin -- it is only outside THIS registry)
; --
; WHAT IS HERE: the ladder, the per-row join over the audit's real inputs, the five separate UI
; counters (never one summed "working agents"), and the DSH service card texts (the service is
; not an agent; "stopped" must not describe it). WHAT IS NOT HERE: where the rows come from
; (glass_window reads the listing, sessions and plan feed; FR-004 keeps drawing out of this spec).
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osExecutorRegistry;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---------------------------------------------------------------- the ladder

pub const ER_DECLARED : u8 = 0;
pub const ER_DISCOVERED : u8 = 1;
pub const ER_REACHABLE : u8 = 2;
pub const ER_ASSIGNED : u8 = 3;
pub const ER_OBSERVED : u8 = 4;
pub const ER_RESULTED : u8 = 5;
pub const ER_VERIFIED : u8 = 6;
pub const ER_BROKEN : u8 = 7;
pub const ER_OUTSIDE : u8 = 8;
pub const ER_LEVELS : u8 = 9;

/// The honest name of a level, one line, ASCII. Never a green dot for an unverified thing.
pub fn er_level_name(l : u8, out : []u8) -> usize {
    if (l == ER_DECLARED) { return put_bytes(out, 0, "declared, not seen"); }
    if (l == ER_DISCOVERED) { return put_bytes(out, 0, "discovered"); }
    if (l == ER_REACHABLE) { return put_bytes(out, 0, "reachable"); }
    if (l == ER_ASSIGNED) { return put_bytes(out, 0, "task assigned"); }
    if (l == ER_OBSERVED) { return put_bytes(out, 0, "execution observed"); }
    if (l == ER_RESULTED) { return put_bytes(out, 0, "result produced"); }
    if (l == ER_VERIFIED) { return put_bytes(out, 0, "result verified"); }
    if (l == ER_BROKEN) { return put_bytes(out, 0, "launch path broken"); }
    return put_bytes(out, 0, "outside this registry");
}

/// Can a level stand for "working"? Only these three, and RESULTED/VERIFIED need artifacts --
/// a caller may not jump here from output alone.
pub fn er_counts_as_working(l : u8) -> bool {
    return l == ER_ASSIGNED or l == ER_OBSERVED or l == ER_RESULTED or l == ER_VERIFIED;
}

// ---------------------------------------------------------------- one row

/// Fields per row: [agent byte][level u8][task number u32][flags u8].
/// flags bit 0: the row's evidence was time-stamped by the audit; bit 1: model is launch config
/// only (never proof of upstream routing); bit 2: task unknown.
pub const ERF_TIMED : u8 = 1;
pub const ERF_MODEL_IS_CONFIG : u8 = 2;
pub const ERF_TASK_UNKNOWN : u8 = 4;
pub const ER_F : usize = 7;

/// Build one row the honest way: the level comes in from the caller's evidence, the registry
/// never promotes it. A broken launch path is a property of ONE path, passed explicitly.
pub fn er_row(tab : []u32, r : usize, agent : u32, level : u8, task : u32, flags : u8) -> void {
    const b : usize = r * ER_F;
    tab[b] = agent;
    tab[b + 1] = @as(u32, level);
    tab[b + 2] = task;
    tab[b + 3] = @as(u32, flags);
}

pub fn er_level_of(tab : []const u32, r : usize) -> u8 {
    return @as(u8, @intCast(tab[r * ER_F + 1] & 255));
}

pub fn er_task_of(tab : []const u32, r : usize) -> u32 {
    return tab[r * ER_F + 2];
}

/// Task unknown is a STATUS, not a failure (owner: "назначение отсутствует -- отдельный статус").
pub fn er_task_unknown(tab : []const u32, r : usize) -> bool {
    return (tab[r * ER_F + 3] & ERF_TASK_UNKNOWN) != 0 or er_task_of(tab, r) == 0;
}

// ---------------------------------------------------------------- the five counters

/// The five numbers the map shows SEPARATELY (owner's list), never summed:
///   [0] sessions of the current space   [1] panes total in the server
///   [2] executors with observed activity [3] broken or errored paths
///   [4] processes outside the confirmed registry
pub const ER_COUNTS : usize = 5;
pub const ER_C_SPACE_SESSIONS : usize = 0;
pub const ER_C_PANES : usize = 1;
pub const ER_C_OBSERVED : usize = 2;
pub const ER_C_BROKEN : usize = 3;
pub const ER_C_OUTSIDE : usize = 4;

/// Count rows into the five slots. `space_rows` and `panes_total` come straight from their own
/// sources; the registry only classifies rows for slots 2..4. A Shell pane is a shell, not an
/// AI agent: the caller marks environment kinds, and shells count into panes total only.
pub fn er_counts(tab : []const u32, n : u32, shell_agent : u32, outside_agent : u32,
                 space_sessions : u32, panes_total : u32, out : []u32) -> void {
    var i : u32 = 0;
    while (i < ER_COUNTS) { out[i] = 0; i = i + 1; }
    out[ER_C_SPACE_SESSIONS] = space_sessions;
    out[ER_C_PANES] = panes_total;
    i = 0;
    while (i < n) {
        const lvl : u8 = er_level_of(tab, i);
        const ag : u32 = tab[i * ER_F];
        if (lvl == ER_BROKEN) { out[ER_C_BROKEN] = out[ER_C_BROKEN] + 1; }
        if (lvl == ER_OUTSIDE or ag == outside_agent) { out[ER_C_OUTSIDE] = out[ER_C_OUTSIDE] + 1; }
        if (ag != shell_agent and er_counts_as_working(lvl)) { out[ER_C_OBSERVED] = out[ER_C_OBSERVED] + 1; }
        i = i + 1;
    }
}

/// One stats line with the scope named for every number (owner: "согласовать scope счётчиков").
/// The caller passes the counts; the line never sums them.
pub fn er_stats_line(out : []u8, c : []const u32) -> usize {
    var w : usize = put_dec(out, 0, c[ER_C_SPACE_SESSIONS] as u64);
    w = put_bytes(out, w, " sessions in space / ");
    w = put_dec(out, w, c[ER_C_PANES] as u64);
    w = put_bytes(out, w, " panes total / ");
    w = put_dec(out, w, c[ER_C_OBSERVED] as u64);
    w = put_bytes(out, w, " with observed work / ");
    w = put_dec(out, w, c[ER_C_BROKEN] as u64);
    w = put_bytes(out, w, " broken / ");
    w = put_dec(out, w, c[ER_C_OUTSIDE] as u64);
    return put_bytes(out, w, " outside registry");
}

// ---------------------------------------------------------------- the DSH service card

/// DSH is a SERVICE plus optional sessions, not an executor with a green dot. The card says
/// exactly what is known and what was never checked (owner, 2026-11-03). "stopped" must not
/// describe the service: it mixes the service, UI sessions and the executor into one word.
pub const DSH_CARD_SERVICE : str = "service: answering";
pub const DSH_CARD_METADATA : str = "metadata access: unverified";
pub const DSH_CARD_SESSIONS : str = "sessions/tasks: not inventoried";
pub const DSH_CARD_MAP : str = "map integration: not connected";

pub fn dsh_card_line(i : u32, out : []u8) -> usize {
    if (i == 0) { return put_bytes(out, 0, DSH_CARD_SERVICE); }
    if (i == 1) { return put_bytes(out, 0, DSH_CARD_METADATA); }
    if (i == 2) { return put_bytes(out, 0, DSH_CARD_SESSIONS); }
    return put_bytes(out, 0, DSH_CARD_MAP);
}

/// The Queen pane's honest card: the launch path is broken until a real pane-mode binary exists.
/// The plan feed is a DIFFERENT path and must never be shown as this pane's state.
pub const QUEEN_PANE_CARD : str = "launch path broken: no pane-mode binary";
pub const QUEEN_FEED_NOTE : str = "plan feed is a separate path (tri-queen), not this pane";

// ---------------------------------------------------------------- tests

fn er_eq(a : []const u8, n : usize, s : []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = n;
    while (i > 0) {
        i = i - 1;
        if (a[i] != s[i]) { return false; }
    }
    return true;
}

test the_ladder_never_jumps_and_never_lies {
    var b : [32]u8 = undefined;
    var n : usize = er_level_name(ER_DECLARED, b[0..32]);
    assert er_eq(b[0..32], n, "declared, not seen");
    n = er_level_name(ER_VERIFIED, b[0..32]);
    assert er_eq(b[0..32], n, "result verified");
    n = er_level_name(ER_BROKEN, b[0..32]);
    assert er_eq(b[0..32], n, "launch path broken");
    n = er_level_name(ER_OUTSIDE, b[0..32]);
    assert er_eq(b[0..32], n, "outside this registry");
    // working is only the four evidenced levels; declared/discovered/reachable are not "working"
    assert er_counts_as_working(ER_DECLARED) == false;
    assert er_counts_as_working(ER_REACHABLE) == false;
    assert er_counts_as_working(ER_ASSIGNED) and er_counts_as_working(ER_OBSERVED);
    assert er_counts_as_working(ER_BROKEN) == false and er_counts_as_working(ER_OUTSIDE) == false;
}

test rows_keep_their_level_task_and_flags {
    var tab : [2 * ER_F]u32 = undefined;
    // a real shape from the 2026-11-03 audit: a Claude pane with observed work and an unknown task
    er_row(tab[0 .. 2 * ER_F], 0, 0, ER_OBSERVED, 0, ERF_TIMED | ERF_MODEL_IS_CONFIG | ERF_TASK_UNKNOWN);
    assert er_level_of(tab[0 .. 2 * ER_F], 0) == ER_OBSERVED;
    assert er_task_unknown(tab[0 .. 2 * ER_F], 0);
    // a linked row: task assigned and its number kept
    er_row(tab[0 .. 2 * ER_F], 1, 4, ER_ASSIGNED, 12966, ERF_TIMED);
    assert er_task_unknown(tab[0 .. 2 * ER_F], 1) == false;
    assert er_task_of(tab[0 .. 2 * ER_F], 1) == 12966;
}

test the_five_counters_never_sum_into_one_number {
    var tab : [4 * ER_F]u32 = undefined;
    // the audit's real shape: 2 claude rows (observed), 1 broken queen pane, 1 outside process;
    // shells are excluded from observed by the environment kind
    er_row(tab[0 .. 4 * ER_F], 0, 0, ER_OBSERVED, 0, ERF_TASK_UNKNOWN); // claude
    er_row(tab[0 .. 4 * ER_F], 1, 0, ER_OBSERVED, 0, ERF_TASK_UNKNOWN); // claude
    er_row(tab[0 .. 4 * ER_F], 2, 4, ER_BROKEN, 0, 0);                  // queen pane, launch path broken
    er_row(tab[0 .. 4 * ER_F], 3, 200, ER_OUTSIDE, 0, 0);               // an outside process
    var c : [ER_COUNTS]u32 = undefined;
    er_counts(tab[0 .. 4 * ER_F], 4, 9, 200, 4, 16, c[0..ER_COUNTS]);
    assert c[ER_C_SPACE_SESSIONS] == 4;
    assert c[ER_C_PANES] == 16;
    assert c[ER_C_OBSERVED] == 2; // the shell check would have counted a shell row here
    assert c[ER_C_BROKEN] == 1;
    assert c[ER_C_OUTSIDE] == 1;
}

test the_stats_line_names_the_scope_of_every_number {
    var b : [160]u8 = undefined;
    var c : [ER_COUNTS]u32 = undefined;
    c[0] = 4;
    c[1] = 16;
    c[2] = 2;
    c[3] = 1;
    c[4] = 1;
    const n : usize = er_stats_line(b[0..160], c[0..ER_COUNTS]);    // every count sits next to its scope, and no total is printed
    var i : usize = 0;
    var scopes : usize = 0;
    while (i < n) {
        if (b[i] == 47) { scopes = scopes + 1; } // '/'
        i = i + 1;
    }
    assert scopes == 4;
    assert n < 160;
}

test the_dsh_card_says_service_not_agent {
    var b : [64]u8 = undefined;
    var n : usize = dsh_card_line(0, b[0..48]);
    assert er_eq(b[0..64], n, "service: answering");
    n = dsh_card_line(1, b[0..64]);
    assert er_eq(b[0..64], n, "metadata access: unverified");
    n = dsh_card_line(2, b[0..64]);
    assert er_eq(b[0..64], n, "sessions/tasks: not inventoried");
    n = dsh_card_line(3, b[0..64]);
    assert er_eq(b[0..64], n, "map integration: not connected");
    // the Queen pane card names its own broken path and separates the feed from the pane
    n = put_bytes(b[0..64], 0, QUEEN_PANE_CARD);
    assert er_eq(b[0..64], n, "launch path broken: no pane-mode binary");
    n = put_bytes(b[0..64], 0, QUEEN_FEED_NOTE);
    assert er_eq(b[0..64], n, "plan feed is a separate path (tri-queen), not this pane");
}

invariant the_ladder_is_ordered_and_complete {
    assert ER_DECLARED < ER_DISCOVERED and ER_DISCOVERED < ER_REACHABLE and ER_REACHABLE < ER_ASSIGNED;
    assert ER_ASSIGNED < ER_OBSERVED and ER_OBSERVED < ER_RESULTED and ER_RESULTED < ER_VERIFIED;
    assert ER_LEVELS == 9;
    assert ER_F == 7;
}
