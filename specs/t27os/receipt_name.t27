// SPDX-License-Identifier: Apache-2.0
; specs/t27os/receipt_name.t27 -- the name of a lab receipt, and the sha it may carry (board
; Trinity-S-AI-DNA/t27os#3, tasks t27os#11 and the third way of t27os#10; Refs gHashTag/t27#11840).
; The T27 OS lab (Trinity-S-AI-DNA/t27os .github/workflows/lab.yml) writes runs/<sha>.<c8>.json. Two
; measured defects had no law to break, because the name lived only in YAML:
;   - t27os#11: the scheduled trigger has no inputs, so a name built from the raw input sha is
;     "runs/.<c8>.json" -- a hidden dotfile with "sha": "" inside;
;   - t27os#10 (third way, run 39993710023): a full 40-hex sha was still sent through an
;     unauthenticated API lookup, the answer had no .sha, jq printed "null", and checkout died on it.
; The law, here:
;   - a sha is FULL when it is exactly 40 chars of 0-9a-f (lowercase, what git prints);
;   - the sha a run uses is the input when the input is full (no lookup at all), else the lookup's
;     answer when THAT is full, else the run is refused before checkout;
;   - the receipt is named only from that resolved sha: runs/ + sha + . + the first 8 chars of the
;     challenge DIGEST (sha256 hex of the challenge; the challenge itself is never published, lab.yml
;     "only its sha256 is published") + .json, 59 bytes; a short or non-hex digest refuses the name;
;   - the specs a run tests: the input list when it names at least one path, else the default core
;     set (DEFAULT_SPECS, the workflow_dispatch default) -- measured night tick 21: the schedule
;     fires (runs 40005713854, 40015647905) but carries no inputs, so the loop read "for spec in ;",
;     wrote no summary and died at cat; a run whose resolved list is still empty is refused, never
;     a receipt that verified nothing.
; Calling the API and writing the file are the boundary's work (the workflow TRI CLAW generates);
; every decision about what they return is here. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osReceiptName;

use t27os::keysync::contains;

/// A full git sha: 40 lowercase hex chars.
pub const SHA_LEN : u32 = 40;

/// The prefix of the challenge digest (sha256 hex) a receipt name keeps.
pub const C8 : u32 = 8;

/// len("runs/") + SHA_LEN + len(".") + C8 + len(".json")
pub const NAME_LEN : u32 = 59;

/// Where the resolved sha came from.
pub const SRC_INPUT : u8 = 1;
pub const SRC_LOOKUP : u8 = 2;
pub const SRC_REFUSED : u8 = 0;

/// The answer of receipt_name when no name may be written.
pub const NONE : u32 = 4294967295;

pub fn is_lower_hex(c: u8) -> bool {
    if (c >= '0' and c <= '9') { return true; }
    return c >= 'a' and c <= 'f';
}

/// True when s[0..n) is exactly SHA_LEN lowercase hex chars.
pub fn is_full_sha(s: []const u8, n: u32) -> bool {
    if (n != SHA_LEN) { return false; }
    var i : u32 = 0;
    while (i < n) {
        if (!is_lower_hex(s[i])) { return false; }
        i = i + 1;
    }
    return true;
}

/// Which sha the run uses: the input when full, else the lookup's answer when full, else refused.
/// A full input never reaches the lookup, so a rate-limited API cannot break a full-sha dispatch.
pub fn sha_source(input: []const u8, input_n: u32, lookup: []const u8, lookup_n: u32) -> u8 {
    if (is_full_sha(input, input_n)) { return SRC_INPUT; }
    if (is_full_sha(lookup, lookup_n)) { return SRC_LOOKUP; }
    return SRC_REFUSED;
}

fn put(out: []u8, at: u32, s: []const u8, n: u32) -> u32 {
    var i : u32 = 0;
    while (i < n) {
        out[at + i] = s[i];
        i = i + 1;
    }
    return at + n;
}

/// Writes runs/<sha>.<c8>.json into out and returns NAME_LEN, or NONE (writing nothing) when the sha
/// is not full, the challenge digest has fewer than C8 chars or a non-hex one among them, or out is short.
pub fn receipt_name(sha: []const u8, sha_n: u32, digest: []const u8, digest_n: u32, out: []u8, out_n: u32) -> u32 {
    if (!is_full_sha(sha, sha_n)) { return NONE; }
    if (digest_n < C8) { return NONE; }
    var i : u32 = 0;
    while (i < C8) {
        if (!is_lower_hex(digest[i])) { return NONE; }
        i = i + 1;
    }
    if (out_n < NAME_LEN) { return NONE; }
    var at : u32 = put(out, 0, "runs/", 5);
    at = put(out, at, sha, SHA_LEN);
    at = put(out, at, ".", 1);
    at = put(out, at, digest, C8);
    at = put(out, at, ".json", 5);
    return at;
}

/// Where the run's spec list came from.
pub const SPECS_INPUT : u8 = 1;
pub const SPECS_DEFAULT : u8 = 2;

/// The number of paths in lab.yml's workflow_dispatch default (the core set).
pub const DEFAULT_SPEC_COUNT : u32 = 6;

fn is_gap(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\n';
}

/// The number of whitespace-separated paths in s[0..n).
pub fn spec_count(s: []const u8, n: u32) -> u32 {
    var count : u32 = 0;
    var in_word : bool = false;
    var i : u32 = 0;
    while (i < n) {
        if (is_gap(s[i])) {
            in_word = false;
        } else {
            if (!in_word) { count = count + 1; }
            in_word = true;
        }
        i = i + 1;
    }
    return count;
}

/// The input list when it names at least one path, else the default core set.
pub fn specs_source(input: []const u8, input_n: u32) -> u8 {
    if (spec_count(input, input_n) > 0) { return SPECS_INPUT; }
    return SPECS_DEFAULT;
}

/// How many specs the run tests; 0 means the run is refused (no receipt that verified nothing).
pub fn run_spec_count(input: []const u8, input_n: u32, default_n: u32) -> u32 {
    if (specs_source(input, input_n) == SPECS_INPUT) { return spec_count(input, input_n); }
    return default_n;
}

fn same(a: []const u8, b: []const u8, n: u32) -> bool {
    var i : u32 = 0;
    while (i < n) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// --- the sha step text, for lab.yml (t27os#11; night tick 167) ----------
//
// sha_source as the boundary runs it: the input is tested for FULL before any lookup, and the
// answer is tested for FULL before checkout, so "null" ends the run instead of naming a receipt.
// TRI CLAW places SHA_STEP_YAML into lab.yml in place of the step quoted in OLD_SHA_STEP.

pub const FULL_TEST : str = "grep -qE '^[0-9a-f]{40}$'";
pub const INPUT_FIRST : str = "if printf '%s' \"$REF\" | grep -qE";
pub const LOOKUP_IN_ELSE : str = "else\n            FULL=$(curl";
pub const ANSWER_TESTED : str = "if ! printf '%s' \"$FULL\" | grep -qE";
pub const REFUSE : str = "exit 1\n";
pub const RESOLVED_OUT : str = "echo \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"";

pub const SHA_STEP_YAML : str = "      - name: resolve the sha (accepts short; empty = master)\n        id: sha\n        run: |\n          # a full input never reaches the lookup; no full sha, no run (t27 specs/t27os/receipt_name.t27)\n          REF=\"${{ inputs.sha }}\"\n          [ -z \"$REF\" ] && REF=master\n          if printf '%s' \"$REF\" | grep -qE '^[0-9a-f]{40}$'; then\n            FULL=\"$REF\"\n          else\n            FULL=$(curl -s https://api.github.com/repos/Trinity-S-AI-DNA/t27/commits/$REF | jq -r .sha)\n          fi\n          if ! printf '%s' \"$FULL\" | grep -qE '^[0-9a-f]{40}$'; then\n            echo \"refused: $REF resolved to $FULL, not a full sha\"\n            exit 1\n          fi\n          echo \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"\n          echo \"resolved: $FULL\"\n";

// lab.yml on Trinity-S-AI-DNA/t27os master, read night tick 167 (2026-10-25)
pub const OLD_SHA_STEP : str = "      - name: resolve the sha (accepts short; empty = master)\n        id: sha\n        run: |\n          REF=${{ inputs.sha }}\n          [ -z \"$REF\" ] && REF=master\n          FULL=$(curl -s https://api.github.com/repos/Trinity-S-AI-DNA/t27/commits/$REF | jq -r .sha)\n          echo \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"\n          echo \"resolved: $FULL\"\n";

// sha_step_ok(y): the input is tested before the lookup, the lookup sits in the else branch,
// the answer is tested and refused with exit 1, and only then is resolved written.
pub fn sha_step_ok(y: []const u8) -> bool {
    return contains(y, FULL_TEST) and contains(y, INPUT_FIRST) and contains(y, LOOKUP_IN_ELSE)
        and contains(y, ANSWER_TESTED) and contains(y, REFUSE) and contains(y, RESOLVED_OUT);
}

test the_sha_step_text_is_the_law {
    assert sha_step_ok(SHA_STEP_YAML);
    // the step keeps its id: every later step reads steps.sha.outputs.resolved
    assert contains(SHA_STEP_YAML, "        id: sha\n");
    // a quoted input: an empty schedule input is still one word for [ -z ]
    assert contains(SHA_STEP_YAML, "REF=\"${{ inputs.sha }}\"");
}

test negative_control_the_run_39993710023_step_is_refused {
    // the step that curled a full sha, got "null" and checked it out (t27os#10, third way)
    assert sha_step_ok(OLD_SHA_STEP) == false;
    assert contains(OLD_SHA_STEP, FULL_TEST) == false;
    assert contains(OLD_SHA_STEP, RESOLVED_OUT);
}

test each_sha_move_is_load_bearing {
    // the lookup outside the else branch: a full input would reach the API again
    assert sha_step_ok("if printf '%s' \"$REF\" | grep -qE '^[0-9a-f]{40}$'; then\nFULL=$(curl x)\nif ! printf '%s' \"$FULL\" | grep -qE x\nexit 1\necho \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"") == false;
    // the answer not tested: "null" is written as resolved
    assert sha_step_ok("if printf '%s' \"$REF\" | grep -qE '^[0-9a-f]{40}$'; then\nelse\n            FULL=$(curl x)\nexit 1\necho \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"") == false;
    // tested but not refused
    assert sha_step_ok("if printf '%s' \"$REF\" | grep -qE '^[0-9a-f]{40}$'; then\nelse\n            FULL=$(curl x)\nif ! printf '%s' \"$FULL\" | grep -qE x\necho \"resolved=$FULL\" >> \"$GITHUB_OUTPUT\"") == false;
}

invariant the_name_length_is_the_sum_of_its_parts {
    assert NAME_LEN == 5 + SHA_LEN + 1 + C8 + 5;
}

test a_full_sha_is_forty_lowercase_hex {
    assert is_full_sha("305d83ad99905d20b8534f297133e36eb1b00468", 40) == true;
    // 39 chars, uppercase, a non-hex char, and the "null" jq printed in run 39993710023
    assert is_full_sha("305d83ad99905d20b8534f297133e36eb1b0046", 39) == false;
    assert is_full_sha("305D83AD99905D20B8534F297133E36EB1B00468", 40) == false;
    assert is_full_sha("305d83ad99905d20b8534f297133e36eb1b0046g", 40) == false;
    assert is_full_sha("null", 4) == false;
    assert is_full_sha("", 0) == false;
}

test a_full_input_skips_the_lookup {
    // the lookup answered "null" (t27os#10, third way): a full input is used as-is
    assert sha_source("11da272bc76a01c77b812885531867aadbb91056", 40, "null", 4) == SRC_INPUT;
    // a branch name resolves through the lookup only when the lookup is full
    assert sha_source("master", 6, "aa186955c0000000000000000000000000000000", 40) == SRC_LOOKUP;
    assert sha_source("master", 6, "null", 4) == SRC_REFUSED;
}

test negative_control_a_scheduled_run_without_input_is_refused {
    // t27os#11: schedule events carry no inputs; empty input and empty lookup refuse the run
    assert sha_source("", 0, "", 0) == SRC_REFUSED;
    var out : [64]u8 = [42] ** 64;
    assert receipt_name("", 0, "ff17d40b", 8, &out, 64) == NONE;
    // nothing was written: no runs/.<c8>.json dotfile
    assert out[0] == 42;
}

test the_receipt_name_is_built_from_the_resolved_sha {
    // measured: challenge 1b743d46b81321e7 has sha256 prefix ff17d40b, and the lab wrote
    // runs/305d83ad99905d20b8534f297133e36eb1b00468.ff17d40b.json (Trinity-S-AI-DNA/t27os)
    var out : [64]u8 = [0] ** 64;
    const n = receipt_name("305d83ad99905d20b8534f297133e36eb1b00468", 40, "ff17d40b", 8, &out, 64);
    assert n == NAME_LEN;
    assert same(&out, "runs/305d83ad99905d20b8534f297133e36eb1b00468.ff17d40b.json", 59) == true;
}

test a_short_or_non_hex_digest_or_a_short_buffer_refuses_the_name {
    var out : [64]u8 = [42] ** 64;
    assert receipt_name("305d83ad99905d20b8534f297133e36eb1b00468", 40, "ff17d40", 7, &out, 64) == NONE;
    assert receipt_name("305d83ad99905d20b8534f297133e36eb1b00468", 40, "ff17d40z", 8, &out, 64) == NONE;
    assert receipt_name("305d83ad99905d20b8534f297133e36eb1b00468", 40, "ff17d40b", 8, &out, 58) == NONE;
    assert out[0] == 42;
}

test the_default_core_set_has_six_paths {
    // lab.yml workflow_dispatch default, read 2026-10-24 from Trinity-S-AI-DNA/t27os master
    const d = "specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27";
    assert spec_count(d, 148) == DEFAULT_SPEC_COUNT;
    assert spec_count("  specs/os/lab.t27\tspecs/os/home.t27 ", 37) == 2;
}

test negative_control_a_scheduled_run_tests_the_core_set_not_nothing {
    // runs 40005713854 and 40015647905: schedule, empty specs input, "for spec in ;" -> no receipt
    assert specs_source("", 0) == SPECS_DEFAULT;
    assert specs_source("   ", 3) == SPECS_DEFAULT;
    assert run_spec_count("", 0, DEFAULT_SPEC_COUNT) == 6;
    // a named list is used as-is
    assert specs_source("specs/t27os/lab_legs.t27", 24) == SPECS_INPUT;
    assert run_spec_count("specs/t27os/lab_legs.t27", 24, DEFAULT_SPEC_COUNT) == 1;
    // an empty default too: zero specs, the run is refused
    assert run_spec_count("", 0, 0) == 0;
}
