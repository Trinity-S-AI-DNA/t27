fn dq_m4(o:u64,s:u64,a:u64,b:u64,c:u64,d:u64)->u64{return @extern("objc_msgSend");}
// Compiled QA companion, concatenated with the unchanged native transport source.
// Two synthetic ephemeral identities, loopback sockets only, no audio/camera.
fn dq_sc_open(port:u64,ephemeral:bool,path:u64)->u64{return @extern("sc_open");}
fn dq_sc_card(root:u64)->u64{return @extern("sc_card");}
fn dq_sc_close(root:u64)->void{@extern("sc_close");}
fn dq_sc_tick(root:u64)->void{@extern("sc_tick");}
fn dq_sc_code(root:u64,audio:bool)->u64{return @extern("sc_code");}
fn dq_sc_send(root:u64,text:u64)->u32{return @extern("sc_send");}
fn dq_sc_stat(root:u64,audio:bool,key:u32)->u64{return @extern("sc_stat");}
fn dq_sc_visible(root:u64,on:bool)->void{@extern("sc_visible");}
fn dq_wait(us:u32)->i32{return @extern("usleep");}
fn dq_write(fd:i32,b:[]const u8,n:u64)->i64{return @extern("write");}
fn dq_note(text:[]const u8)->void{dq_write(1,text,@as(u64,text.len));var lf:[1]u8=undefined;lf[0]=10;dq_write(1,lf[0..1],1);}
fn dq_number(n:u64)->void {
    const text:u64=dn_m0(dn_m1(dn_cls("NSNumber"),dn_sel("numberWithUnsignedLongLong:"),n),dn_sel("description"));
    const length:u64=dn_m1(text,dn_sel("lengthOfBytesUsingEncoding:"),4);
    var bytes:[64]u8=undefined;if(length<64){dn_peek(bytes[0..64],dn_m0(text,dn_sel("UTF8String")),length);dq_note(bytes[0..@as(usize,length)]);}
}
fn dq_setup(p:u64,other:u64,room:[]const u8)->bool {
    const v:DNView=dn_view(p);const w:DNView=dn_view(other);const b:[]u8=v.bytes;const peer:[]u8=w.bytes;
    if(!dn_pair(p,dq_sc_card(get_u64(peer,DN_ROOT)))){return false;}
    var i:usize=0;while(i<16){b[DN_ROOM+i]=room[i];b[DN_PEER_ROOM_PROOF+8+i]=peer[DN_SESSION+i];i=i+1;}
    put_u64(b,DN_ROOM_STATE,5);put_u64(b,DN_EXPIRY,dn_now()+60000);
    const at:usize=DN_PEER_CANDIDATES;b[at]=1;b[at+11]=255;b[at+12]=255;b[at+13]=127;b[at+16]=1;
    const port:u64=get_u64(peer,DN_NET_PORT);b[at+17]=@as(u8,@intCast(port/256));b[at+18]=@as(u8,@intCast(port%256));
    dq_sc_visible(get_u64(b,DN_ROOT),true);return true;
}
fn dq_tick(a:u64,b:u64,cycles:u32)->void {
    const av:DNView=dn_view(a);const bv:DNView=dn_view(b);var i:u32=0;
    while(i<cycles){
        dn_drain_proxy(av.bytes);dn_direct_tick(av.bytes);dq_sc_tick(get_u64(av.bytes,DN_ROOT));
        dn_drain_proxy(bv.bytes);dn_direct_tick(bv.bytes);dq_sc_tick(get_u64(bv.bytes,DN_ROOT));
        dq_wait(8000);i=i+1;
    }
}
pub fn main()->i32 {
    const pool:u64=dn_m0(dn_cls("NSAutoreleasePool"),dn_sel("new"));
    const environment:u64=dn_m0(dn_m0(dn_cls("NSProcessInfo"),dn_sel("processInfo")),dn_sel("environment"));
    const path:u64=dn_m1(environment,dn_sel("objectForKey:"),dn_cf("T27_COMMS_QA_HOME"));
    if(path==0 or dn_m0(path,dn_sel("isAbsolutePath"))%256==0){return 20;}
    const manager:u64=dn_m0(dn_cls("NSFileManager"),dn_sel("defaultManager"));
    dq_m4(manager,dn_sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),path,1,0,0);
    const ar:u64=dq_sc_open(50061,true,dn_m1(path,dn_sel("stringByAppendingPathComponent:"),dn_cf("a")));
    const br:u64=dq_sc_open(50081,true,dn_m1(path,dn_sel("stringByAppendingPathComponent:"),dn_cf("b")));
    if(ar==0 or br==0){return 1;}
    const a:u64=dn_open(ar,50061);const b:u64=dn_open(br,50081);if(a==0 or b==0){return 2;}
    var room:[16]u8=undefined;if(dn_random(0,16,room[0..16])!=0){return 3;}
    if(!dq_setup(a,b,room[0..16]) or !dq_setup(b,a,room[0..16])){return 4;}
    dq_tick(a,b,120);
    if(dn_state(a,21)!=2 or dn_state(b,21)!=2){return 5;}
    dq_note("PASS two ephemeral principals authenticate a real loopback UDP direct path");
    if(!dn_root_connect(ar,false)){return 6;}
    dq_tick(a,b,50);if(dn_root_state(br,false)!=2){return 7;}
    if(!dn_root_action(br,false,1)){return 8;}
    dq_tick(a,b,60);
    const ac:u64=dq_sc_code(ar,false);const bc:u64=dq_sc_code(br,false);
    if(dn_root_state(ar,false)!=3 or dn_root_state(br,false)!=3 or ac==0 or ac!=bc){return 9;}
    if(dq_sc_send(ar,dn_cf("must not send before SAS"))!=0){return 10;}
    if(!dn_root_action(ar,false,3) or !dn_root_action(br,false,3)){return 11;}
    dq_tick(a,b,40);
    if(dn_root_state(ar,false)!=4 or dn_root_state(br,false)!=4){return 12;}
    // An authenticated incoming direct leg remains usable while only our outgoing leg falls back.
    const before:u64=dq_sc_stat(br,false,55);
    const fallback:DNView=dn_view(b);put_u64(fallback.bytes,DN_ROUTE,2);put_u64(fallback.bytes,DN_DIRECT_STATE,3);
    if(dq_sc_send(ar,dn_cf("synthetic direct UDP encrypted message"))==0){return 13;}
    dq_tick(a,b,100);
    if(dq_sc_stat(br,false,55)==0 or dq_sc_stat(ar,false,12)!=0 or dq_sc_stat(br,false,12)!=0){return 14;}
    if(dq_sc_stat(br,false,55)<=before){return 17;}
    dq_note("PASS asymmetric authenticated direct receive survives outgoing relay fallback");
    put_u64(fallback.bytes,DN_DIRECT_STATE,0);dq_tick(a,b,80);
    dq_note("PASS encrypted direct text after explicit SAS; no text or audio capture before consent");
    if(!dn_root_action(ar,false,5)){return 15;}dq_tick(a,b,60);
    if(dn_root_state(ar,false)!=5 or (dn_root_state(br,false)!=5 and dn_root_state(br,false)!=0) or dq_sc_stat(ar,false,28)!=1 or dq_sc_stat(br,false,28)!=2){dq_note("DIAG terminal states, reasons, direct states");dq_number(@as(u64,dn_root_state(ar,false)));dq_number(@as(u64,dn_root_state(br,false)));dq_number(dq_sc_stat(ar,false,28));dq_number(dq_sc_stat(br,false,28));dq_number(dn_state(a,21));dq_number(dn_state(b,21));return 16;}
    dq_note("PASS direct End reaches both terminals without media devices");
    dn_close(a);dn_close(b);dq_sc_close(ar);dq_sc_close(br);dn_m0(pool,dn_sel("drain"));return 0;
}
test direct_probe_is_loopback_and_never_opens_media {assert 50061+10<50081 and 120*8<1600;}
