// SPDX-License-Identifier: Apache-2.0
; specs/t27os/secrets.t27 -- the secrets SSOT law of T27 OS: one store directory, one reference form, one
; resolver. Issue gHashTag/t27#13954 (first slice: the law only).
; --
; What exists and is NOT restated here: the key master, specs/t27os/keys.t27, owns the provider rules (which
; provider has which key, masking, failure codes). This file owns only where a secret lives and how a
; consumer names it.
; --
; The store is `<home>/.t27os/keys`, one file per secret. A consumer never holds a path or a value in its own
; config; it holds a reference `t27os:keys/<name>` and asks the resolver. The runner token is named only as
; `t27os:keys/gitlab-runner`. `~/.dsh/` and `.env` files are not the store (policy below).
; --
; No secret value appears in this file; the fixtures are obviously fake strings.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osSecrets;

use t27os::editors::same_bytes;
use t27os::session_store::put_bytes;

/// FR-001: the one constant of the store directory, relative to the home directory.
pub const STORE_SUFFIX : str = "/.t27os/keys";

/// FR-002: the reference form is REF_PREFIX followed by the name.
pub const REF_PREFIX : str = "t27os:keys/";

/// Does hay[at..] start with needle?
fn starts_at(hay: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i < needle.len) {
        if (hay[at + i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// FR-003: is `name` a legal secret name? Non-empty; only a-z, 0-9, '-' and '_' (so no '/', no '..').
pub fn valid_name(name: []const u8) -> bool {
    if (name.len == 0) { return false; }
    var i : usize = 0;
    while (i < name.len) {
        const c : u8 = name[i];
        const ok : bool = (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95;
        if (ok == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// The store directory of `home`: home + STORE_SUFFIX. Returns its length.
pub fn store_dir(home: []const u8, out: []u8) -> usize {
    const n : usize = put_bytes(out, 0, home);
    return put_bytes(out, n, STORE_SUFFIX);
}

/// FR-002: map a reference and a home directory to the one file path under the store. Returns the length,
/// or 0 when the reference is refused (wrong prefix, bad name, empty home, or `out` too small).
pub fn resolve(reference: []const u8, home: []const u8, out: []u8) -> usize {
    if (home.len == 0) { return 0; }
    if (starts_at(reference, 0, REF_PREFIX) == false) { return 0; }
    const name : []const u8 = reference[REF_PREFIX.len .. reference.len];
    if (valid_name(name) == false) { return 0; }
    if (home.len + STORE_SUFFIX.len + 1 + name.len > out.len) { return 0; }
    var n : usize = store_dir(home, out);
    n = put_bytes(out, n, "/");
    return put_bytes(out, n, name);
}

/// FR-004: copy `line` into `out`, every occurrence of `value` replaced by `reference`. An empty value
/// changes nothing. Returns the length, or 0 when `out` is too small.
pub fn redact(line: []const u8, value: []const u8, reference: []const u8, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < line.len) {
        if (value.len > 0 and starts_at(line, i, value)) {
            if (n + reference.len > out.len) { return 0; }
            n = put_bytes(out, n, reference);
            i = i + value.len;
        } else {
            if (n + 1 > out.len) { return 0; }
            out[n] = line[i];
            n = n + 1;
            i = i + 1;
        }
    }
    return n;
}

/// Does `path` end with `tail`?
fn ends_with(path: []const u8, tail: []const u8) -> bool {
    if (tail.len > path.len) { return false; }
    return starts_at(path, path.len - tail.len, tail);
}

/// Does `path` hold `needle` anywhere?
fn holds(path: []const u8, needle: []const u8) -> bool {
    var i : usize = 0;
    while (i + needle.len <= path.len) {
        if (starts_at(path, i, needle)) { return true; }
        i = i + 1;
    }
    return false;
}

/// FR-005: may `path` be a secret store location? No when it ends in `.env`, or lies under `.dsh`.
pub fn store_allowed(path: []const u8) -> bool {
    if (path.len == 0) { return false; }
    if (ends_with(path, ".env")) { return false; }
    if (holds(path, "/.dsh/") or ends_with(path, "/.dsh")) { return false; }
    return true;
}

test resolves_a_reference_to_one_path_under_the_store {
    var out : [96]u8 = undefined;
    const n : usize = resolve("t27os:keys/zai", "/home/u", out[0..96]);
    assert same_bytes(out[0..n], "/home/u/.t27os/keys/zai");
}

test the_runner_token_resolves_by_reference_only {
    var out : [96]u8 = undefined;
    const n : usize = resolve("t27os:keys/gitlab-runner", "/home/u", out[0..96]);
    assert same_bytes(out[0..n], "/home/u/.t27os/keys/gitlab-runner");
}

test the_store_directory_is_the_one_constant {
    var out : [64]u8 = undefined;
    const n : usize = store_dir("/home/u", out[0..64]);
    assert same_bytes(out[0..n], "/home/u/.t27os/keys");
    assert same_bytes(STORE_SUFFIX, "/.t27os/keys");
}

test negative_control_empty_name_is_refused {
    var out : [96]u8 = undefined;
    assert resolve("t27os:keys/", "/home/u", out[0..96]) == 0;
    assert valid_name("") == false;
}

test negative_control_separator_and_dot_dot_are_refused {
    var out : [96]u8 = undefined;
    assert resolve("t27os:keys/a/b", "/home/u", out[0..96]) == 0;
    assert resolve("t27os:keys/..", "/home/u", out[0..96]) == 0;
    assert resolve("t27os:keys/a..b", "/home/u", out[0..96]) == 0;
    assert resolve("t27os:keys/../etc", "/home/u", out[0..96]) == 0;
}

test negative_control_bytes_outside_the_alphabet_are_refused {
    assert valid_name("Zai") == false;
    assert valid_name("a b") == false;
    assert valid_name("a.b") == false;
    assert valid_name("zai-2_x") == true;
}

test negative_control_wrong_prefix_or_empty_home_is_refused {
    var out : [96]u8 = undefined;
    assert resolve("t27os:key/zai", "/home/u", out[0..96]) == 0;
    assert resolve("zai", "/home/u", out[0..96]) == 0;
    assert resolve("t27os:keys/zai", "", out[0..96]) == 0;
}

test negative_control_a_buffer_too_small_gives_no_path {
    var out : [10]u8 = undefined;
    assert resolve("t27os:keys/zai", "/home/u", out[0..10]) == 0;
}

test redaction_replaces_the_value_by_its_reference {
    var out : [96]u8 = undefined;
    const n : usize = redact("token=FAKE-VALUE-123 end", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..n], "token=t27os:keys/zai end");
    assert holds(out[0..n], "FAKE-VALUE-123") == false;
}

test redaction_replaces_every_occurrence_and_keeps_other_text {
    var out : [96]u8 = undefined;
    const n : usize = redact("FAKE-VALUE-123 FAKE-VALUE-123", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..n], "t27os:keys/zai t27os:keys/zai");
    const m : usize = redact("nothing here", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..m], "nothing here");
}

test negative_control_redaction_never_writes_past_the_buffer {
    var out : [8]u8 = undefined;
    assert redact("a FAKE-VALUE-123 b", "FAKE-VALUE-123", "t27os:keys/zai", out[0..8]) == 0;
}

test policy_refuses_env_files_and_dsh {
    assert store_allowed("/home/u/.t27os/keys/zai") == true;
    assert store_allowed("/home/u/proj/.env") == false;
    assert store_allowed("/home/u/.dsh/credentials") == false;
    assert store_allowed("/home/u/.dsh") == false;
    assert store_allowed("") == false;
}
