; specs/t27os/secrets.t27 -- the secrets SSOT law of T27 OS: the Keychain service "ai.t27.os" is the canonical
; store, Issue Trinity-S-AI-DNA/t27#14207. Owner decision 2026-11-22: Keychain `ai.t27.os` is the canonical
; store; the old per-file key directory under the home folder is not a value source; its entries stay untouched until a separate inventory and owner approval.
; See specs/t27os/keys.t27 for the key manager and specs/t27os/secrets_ssot.t27 for the Secrets SSOT pointer.
; --
; The resolver maps `t27os:keys/<name>` to macOS Keychain service "ai.t27.os", account `<name>`. A consumer
; never holds a path or value; it holds a reference and asks the resolver. The runner token is named only as
; `t27os:keys/gitlab-runner`. `~/.dsh/` and `.env` files are not the store (policy below).
; --
; No secret value appears in this file; the fixtures are obviously fake strings.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osSecrets;

use t27os::editors::same_bytes;
use t27os::session_store::put_bytes;
use t27os::keys::KEYCHAIN_SERVICE;

/// Result codes for resolve function
pub const RESOLVE_OK : u8 = 0;
pub const RESOLVE_MISSING : u8 = 1;
pub const RESOLVE_NO_ROOM : u8 = 2;

/// Does hay[at..] start with needle?
fn starts_at(hay: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i < needle.len) {
        if (hay[at + i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// FR-003: is `name` a legal secret name? Non-empty; only a-z, 0-9, '-' and '_' (so no '/', no '..').
pub fn valid_name(name: []const u8) -> bool {
    if (name.len == 0) { return false; }
    var i : usize = 0;
    while (i < name.len) {
        const c : u8 = name[i];
        const ok : bool = (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95;
        if (ok == false) { return false; }
        i = i + 1;
    }
    return true;
}

/// FR-002: the reference form is REF_PREFIX followed by the name.
pub const REF_PREFIX : str = "t27os:keys/";

/// Resolve `t27os:keys/<name>` to Keychain service "ai.t27.os", account `<name>`. Returns:
/// RESOLVE_OK (success), RESOLVE_MISSING (wrong prefix, invalid name, or empty reference), or
/// RESOLVE_NO_ROOM (buffer too small). A missing or invalid key is RESOLVE_MISSING, never empty OK.
pub fn resolve(reference: []const u8, out_service: []u8, out_account: []u8) -> u8 {
    if (reference.len == 0) { return RESOLVE_MISSING; }
    if (starts_at(reference, 0, REF_PREFIX) == false) { return RESOLVE_MISSING; }
    const name : []const u8 = reference[REF_PREFIX.len .. reference.len];
    if (valid_name(name) == false) { return RESOLVE_MISSING; }
    if (KEYCHAIN_SERVICE.len > out_service.len or name.len > out_account.len) { return RESOLVE_NO_ROOM; }
    var n : usize = 0;
    n = put_bytes(out_service, n, KEYCHAIN_SERVICE);
    n = 0;
    n = put_bytes(out_account, n, name);
    return RESOLVE_OK;
}

/// FR-004: copy `line` into `out`, every occurrence of `value` replaced by `reference`. An empty value
/// changes nothing. Returns the length, or 0 when `out` is too small.
pub fn redact(line: []const u8, value: []const u8, reference: []const u8, out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < line.len) {
        if (value.len > 0 and starts_at(line, i, value)) {
            if (n + reference.len > out.len) { return 0; }
            n = put_bytes(out, n, reference);
            i = i + value.len;
        } else {
            if (n + 1 > out.len) { return 0; }
            out[n] = line[i];
            n = n + 1;
            i = i + 1;
        }
    }
    return n;
}

/// Does `path` end with `tail`?
fn ends_with(path: []const u8, tail: []const u8) -> bool {
    if (tail.len > path.len) { return false; }
    return starts_at(path, path.len - tail.len, tail);
}

/// Does `path` hold `needle` anywhere?
fn holds(path: []const u8, needle: []const u8) -> bool {
    var i : usize = 0;
    while (i + needle.len <= path.len) {
        if (starts_at(path, i, needle)) { return true; }
        i = i + 1;
    }
    return false;
}

/// FR-005: may `path` be a secret store location? No when it ends in `.env`, or lies under `.dsh`.
pub fn store_allowed(path: []const u8) -> bool {
    if (path.len == 0) { return false; }
    if (ends_with(path, ".env")) { return false; }
    if (holds(path, "/.dsh/") or ends_with(path, "/.dsh")) { return false; }
    return true;
}

test resolve_maps_to_keychain_service_and_account {
    var service : [16]u8 = undefined;
    var account : [32]u8 = undefined;
    assert resolve("t27os:keys/zai", service[0..16], account[0..32]) == RESOLVE_OK;
    assert same_bytes(service[0..9], "ai.t27.os");
    assert same_bytes(account[0..3], "zai");
}

test the_runner_token_maps_to_keychain_account {
    var service : [16]u8 = undefined;
    var account : [32]u8 = undefined;
    assert resolve("t27os:keys/gitlab-runner", service[0..16], account[0..32]) == RESOLVE_OK;
    assert same_bytes(service[0..9], "ai.t27.os");
    assert same_bytes(account[0..13], "gitlab-runner");
}

test the_service_constant_equals_keychain_service {
    assert same_bytes(KEYCHAIN_SERVICE, "ai.t27.os");
}

test negative_control_empty_name_is_missing {
    var service : [16]u8 = undefined;
    var account : [32]u8 = undefined;
    assert resolve("t27os:keys/", service[0..16], account[0..32]) == RESOLVE_MISSING;
    assert valid_name("") == false;
}

test negative_control_invalid_names_are_missing {
    var service : [16]u8 = undefined;
    var account : [32]u8 = undefined;
    assert resolve("t27os:keys/a/b", service[0..16], account[0..32]) == RESOLVE_MISSING;
    assert resolve("t27os:keys/..", service[0..16], account[0..32]) == RESOLVE_MISSING;
    assert resolve("t27os:keys/a..b", service[0..16], account[0..32]) == RESOLVE_MISSING;
    assert resolve("t27os:keys/../etc", service[0..16], account[0..32]) == RESOLVE_MISSING;
}

test negative_control_bytes_outside_the_alphabet_are_refused {
    assert valid_name("Zai") == false;
    assert valid_name("a b") == false;
    assert valid_name("a.b") == false;
    assert valid_name("zai-2_x") == true;
}

test negative_control_wrong_prefix_is_missing {
    var service : [16]u8 = undefined;
    var account : [32]u8 = undefined;
    assert resolve("t27os:key/zai", service[0..16], account[0..32]) == RESOLVE_MISSING;
    assert resolve("zai", service[0..16], account[0..32]) == RESOLVE_MISSING;
}

test negative_control_buffer_too_small_gives_no_room {
    var service : [8]u8 = undefined;
    var account : [2]u8 = undefined;
    assert resolve("t27os:keys/zai", service[0..8], account[0..2]) == RESOLVE_NO_ROOM;
}

test redaction_replaces_the_value_by_its_reference {
    var out : [96]u8 = undefined;
    const n : usize = redact("token=FAKE-VALUE-123 end", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..n], "token=t27os:keys/zai end");
    assert holds(out[0..n], "FAKE-VALUE-123") == false;
}

test redaction_replaces_every_occurrence_and_keeps_other_text {
    var out : [96]u8 = undefined;
    const n : usize = redact("FAKE-VALUE-123 FAKE-VALUE-123", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..n], "t27os:keys/zai t27os:keys/zai");
    const m : usize = redact("nothing here", "FAKE-VALUE-123", "t27os:keys/zai", out[0..96]);
    assert same_bytes(out[0..m], "nothing here");
}

test negative_control_redaction_buffer_too_small {
    var out : [8]u8 = undefined;
    assert redact("a FAKE-VALUE-123 b", "FAKE-VALUE-123", "t27os:keys/zai", out[0..8]) == 0;
}

test policy_refuses_env_files_and_dsh {
    assert store_allowed("/some/path/key") == true;
    assert store_allowed("/home/u/proj/.env") == false;
    assert store_allowed("/home/u/.dsh/credentials") == false;
    assert store_allowed("/home/u/.dsh") == false;
    assert store_allowed("") == false;
}
