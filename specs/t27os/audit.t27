// SPDX-License-Identifier: Apache-2.0
; specs/t27os/audit.t27 -- the machine-readable audit ledger of a t27os
; promotion. Issue #14223, milestone M0_PROMOTION_KERNEL_SPRINT (epic #13473).
; It extends the promotion_kernel audit event schema defined in
; specs/promotion/t27l_promotion.t27 (issue #13483): same surface, same
; action vocabulary, one schema, no second spec. The ledger replaces the
; single local text file as the record a reviewer can read: each promotion
; step writes one event with what ran, when, the exit code and the artifact
; digest. Names and hashes only -- no secret, no token, no PII (issue
; #14225 keeps that rule repo-wide).
; Nothing here posts, sends mail, or starts a cron.
; Worked example, verified 2026-11-22: release t27os-ladder-512k-caps
; replays as six ledger entries, each with exit code 0.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osPromotionAudit;

pub const SURFACE : str = "promotion_kernel";
pub const EXTENDS_ISSUE : str = "13483";
pub const LEDGER_ISSUE : str = "14223";
pub const WORKED_EXAMPLE_RELEASE : str = "t27os-ladder-512k-caps";

; The six promotion steps in the order the release process runs them: the
; five gates of specs/t27os/promotion.t27 plus the owner retest that closes
; the record. One audit event per step (FR-001).
pub const STEP_COUNT : usize = 6;
pub const STEP_NAMES : [6]str = ["build", "health", "smoke", "regression", "rollback_entry", "owner_retest"];
pub const STEP_BUILD : usize = 0;
pub const STEP_HEALTH : usize = 1;
pub const STEP_SMOKE : usize = 2;
pub const STEP_REGRESSION : usize = 3;
pub const STEP_ROLLBACK : usize = 4;
pub const STEP_OWNER_RETEST : usize = 5;

; The four fields of one audit event: what ran, when, the exit code and the
; artifact digest.
pub const EVENT_FIELD_COUNT : usize = 4;
pub const EVENT_FIELDS : [4]str = ["step", "utc", "rc", "sha256"];
pub const FIELD_STEP : usize = 0;
pub const FIELD_UTC : usize = 1;
pub const FIELD_RC : usize = 2;
pub const FIELD_SHA256 : usize = 3;

; An event is complete only when all four fields are present. There is no
; default yes: an event without a digest or an exit code is not evidence.
pub fn event_complete(has_step: bool, has_utc: bool, has_rc: bool, has_sha256: bool) -> bool {
    return has_step and has_utc and has_rc and has_sha256;
}

; The ledger allowlist (FR-002): exactly these nine field names may appear in
; a ledger entry -- the event fields, the rollback fields of
; specs/t27os/promotion.t27, and the release identity. A reviewer diffing a
; ledger against this table can prove no secret field was written.
pub const LEDGER_ALLOWED_FIELDS : [9]str = ["step", "utc", "rc", "sha256", "previous_name", "previous_sha256", "restore_command", "release", "commit"];
pub const LEDGER_FIELD_COUNT : usize = 9;

; ASCII case-exact key comparison; the allowlist is lowercase, so any name
; that differs in case from an allowed name is refused.
pub fn same_key(a: str, b: str) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

pub fn field_allowed(name: str) -> bool {
    for i in 0..LEDGER_FIELD_COUNT {
        if same_key(name, LEDGER_ALLOWED_FIELDS[i]) {
            return true;
        }
    }
    return false;
}

; A replay of the 2026-11-22 promotion: six steps, every exit code zero, so
; the ledger says the promotion it records actually passed (exit 0 on replay).
pub fn replay_ok(rcs: [6]u32) -> bool {
    for i in 0..STEP_COUNT {
        if rcs[i] != 0 {
            return false;
        }
    }
    return true;
}

test surface_extends_13483_without_a_second_schema {
    assert SURFACE == "promotion_kernel";
    assert EXTENDS_ISSUE == "13483";
    assert LEDGER_ISSUE == "14223";
    assert WORKED_EXAMPLE_RELEASE == "t27os-ladder-512k-caps";
}

test schema_pins_six_steps_and_four_event_fields {
    assert STEP_COUNT == 6;
    assert STEP_NAMES[STEP_BUILD] == "build";
    assert STEP_NAMES[STEP_HEALTH] == "health";
    assert STEP_NAMES[STEP_SMOKE] == "smoke";
    assert STEP_NAMES[STEP_REGRESSION] == "regression";
    assert STEP_NAMES[STEP_ROLLBACK] == "rollback_entry";
    assert STEP_NAMES[STEP_OWNER_RETEST] == "owner_retest";
    assert EVENT_FIELD_COUNT == 4;
    assert EVENT_FIELDS[FIELD_STEP] == "step";
    assert EVENT_FIELDS[FIELD_UTC] == "utc";
    assert EVENT_FIELDS[FIELD_RC] == "rc";
    assert EVENT_FIELDS[FIELD_SHA256] == "sha256";
    assert event_complete(true, true, true, true);
    assert event_complete(true, true, true, false) == false;
    assert event_complete(false, true, true, true) == false;
}

test no_secrets_and_no_pii_pass_the_allowlist {
    assert field_allowed("step");
    assert field_allowed("previous_sha256");
    assert field_allowed("restore_command");
    assert field_allowed("release");
    assert field_allowed("commit");
    assert field_allowed("api_key") == false;
    assert field_allowed("token") == false;
    assert field_allowed("password") == false;
    assert field_allowed("Step") == false;
    assert field_allowed("email") == false;
    assert field_allowed("") == false;
}

test worked_example_2026_11_22_replays_six_entries_exit_zero {
    let rcs : [6]u32 = [0, 0, 0, 0, 0, 0];
    assert replay_ok(rcs);
    let rcs_with_failure : [6]u32 = [0, 0, 1, 0, 0, 0];
    assert replay_ok(rcs_with_failure) == false;
}

test audit_steps_pin_the_promotion_gate_names {
    assert same_key(STEP_NAMES[STEP_BUILD], "build");
    assert same_key(STEP_NAMES[STEP_HEALTH], "health");
    assert same_key(STEP_NAMES[STEP_SMOKE], "smoke");
    assert same_key(STEP_NAMES[STEP_REGRESSION], "regression");
    assert same_key(STEP_NAMES[STEP_ROLLBACK], "rollback_entry");
    assert same_key(STEP_NAMES[STEP_OWNER_RETEST], "owner_retest");
}
