// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_web_ui_panel.t27 -- t27os: the DSH Web UI in a panel of its
// own (Cmd+Shift+D).
// Part of M8 milestone (milestone #12). Closes #13086.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dsh_web_ui_panel;

pub const DSH_WEB_UI_PANEL_KEY : str = "Cmd+Shift+D";

pub struct DshWebUiPanel { key: str, open: bool };

pub fn dsh_web_ui_panel_open(p: DshWebUiPanel) -> bool {
    return p.open;
}

test "dsh_web_ui_panel_open" {
    assert(dsh_web_ui_panel_open(DshWebUiPanel { key: DSH_WEB_UI_PANEL_KEY, open: true }));
    assert(!dsh_web_ui_panel_open(DshWebUiPanel { key: DSH_WEB_UI_PANEL_KEY, open: false }));
}

invariant dsh_web_ui_panel_key_defined {
    assert DSH_WEB_UI_PANEL_KEY == "Cmd+Shift+D";
}