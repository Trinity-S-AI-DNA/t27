module T27OsBrowserDriver;

use t27os::browser_pod::WEBRTC_MUX_MIN;
use t27os::browser_pod::WEBRTC_MUX_MAX;
use t27os::browser_pod::mux_in_range;


pub const D_DOCKER : u8 = 0;
pub const D_FIXED : u8 = 1;
pub const D_NONE : u8 = 2;


pub const POD_CREATING : u8 = 0;
pub const POD_RUNNING : u8 = 1;
pub const POD_STOPPING : u8 = 2;
pub const POD_STOPPED : u8 = 3;
pub const POD_GONE : u8 = 4;


pub const STOP_GRACE_SECS : u32 = 15;
pub const TAB_CAP : u32 = 8;
pub const IDLE_REAP_MS : u64 = 60000;
pub const ENV_BROWSER_POD_DRIVER : string = "BROWSER_POD_DRIVER";

pub const R_OK : u8 = 0;
pub const R_NOT_CONFIGURED : u32 = 503;
pub const R_RM_BEFORE_STOP : u8 = 6;
pub const R_KILL_NOT_STOP : u8 = 7;
pub const R_OUT_OF_PORTS : u8 = 8;


/// The route answer for a driver kind: NONE (env unset or unknown) refuses
/// with NOT-CONFIGURED; every real kind answers OK.
pub fn route_answer(kind : u8) -> u32 {
    if (kind == D_NONE) { return R_NOT_CONFIGURED; }
    return 0;
}

/// Kind from the environment value: unset or unknown routes to NONE, never
/// to a guess.
pub fn driver_kind_of_env(env_set : bool, value : string) -> u8 {
    if (!env_set) { return D_NONE; }
    if (value == "docker") { return D_DOCKER; }
    if (value == "fixed") { return D_FIXED; }
    return D_NONE;
}


/// A stop request is only well-formed with the full grace: anything else is
/// a SIGKILL in disguise and loses cookies.
pub fn stop_refusal(grace_secs : u32) -> u8 {
    if (grace_secs != STOP_GRACE_SECS) { return R_KILL_NOT_STOP; }
    return R_OK;
}

/// rm is legal only after a graceful stop completed: state must be
/// POD_STOPPED, reached from POD_STOPPING, never from POD_RUNNING or above.
pub fn rm_refusal(state : u8, grace_secs : u32) -> u8 {
    if (stop_refusal(grace_secs) != R_OK) { return R_KILL_NOT_STOP; }
    if (state != POD_STOPPED) { return R_RM_BEFORE_STOP; }
    return R_OK;
}

/// The whole order in one call: stop with grace, then rm from POD_STOPPED.
pub fn stop_then_rm_ok(state : u8, grace_secs : u32) -> bool {
    if (state != POD_RUNNING) { return false; }
    return rm_refusal(POD_STOPPED, grace_secs) == R_OK;
}


/// Next free mux port for the set used[0..n): the first port in range not
/// in the set; OUT-OF-PORTS (0) when the range is exhausted. Ports walk the
/// range from its minimum upward, so allocation is deterministic.
pub fn alloc_port(used : []u32, n : usize) -> u32 {
    var cand : u32 = WEBRTC_MUX_MIN;
    while (cand <= WEBRTC_MUX_MAX) {
        var taken : bool = false;
        var ii : usize = 0;
        while (ii < n) {
            if (used[ii] == cand) { taken = true; }
            ii = ii + 1;
        }
        if (!taken) { return cand; }
        cand = cand + 1;
    }
    return 0;
}

pub fn alloc_refusal(port : u32) -> u8 {
    if (port == 0) { return R_OUT_OF_PORTS; }
    return R_OK;
}

/// Two pods in one set never share a port: the whole allocation stays in
/// range and pairwise distinct.
pub fn alloc_set_ok(used : []u32, n : usize) -> bool {
    var ii : usize = 0;
    while (ii < n) {
        if (!mux_in_range(used[ii])) { return false; }
        var jj : usize = ii + 1;
        while (jj < n) {
            if (used[ii] == used[jj]) { return false; }
            jj = jj + 1;
        }
        ii = ii + 1;
    }
    return true;
}


/// Liveness is an open viewer socket. A session with a live viewer socket is
/// never reaped, however idle. Status polling refreshes nothing: polled_only
/// does not save a session whose socket closed past the idle budget.
pub fn reap_refusal(viewer_socket_open : bool, idle_ms : u64) -> u8 {
    if (viewer_socket_open) { return R_OK; }
    if (idle_ms < IDLE_REAP_MS) { return R_OK; }
    return R_RM_BEFORE_STOP;
}

/// The reaped pod is removed the lawful way: the sweeper calls rm only
/// through the stop-before-rm order of section 5.
pub fn sweeper_rm_ok(state : u8, grace_secs : u32) -> bool {
    return rm_refusal(state, grace_secs) == R_OK;
}

invariant stop_before_rm {
    assert stop_refusal(STOP_GRACE_SECS) == R_OK;
    assert stop_refusal(0) == R_KILL_NOT_STOP;
    assert rm_refusal(POD_RUNNING, STOP_GRACE_SECS) == R_RM_BEFORE_STOP;
    assert rm_refusal(POD_STOPPING, STOP_GRACE_SECS) == R_RM_BEFORE_STOP;
    assert rm_refusal(POD_STOPPED, STOP_GRACE_SECS) == R_OK;
    assert rm_refusal(POD_STOPPED, 0) == R_KILL_NOT_STOP;
}

invariant none_routes_not_configured {
    assert route_answer(D_NONE) == R_NOT_CONFIGURED;
    assert route_answer(D_DOCKER) == R_OK;
    assert route_answer(D_FIXED) == R_OK;
    assert driver_kind_of_env(false, "docker") == D_NONE;
    assert driver_kind_of_env(true, "docker") == D_DOCKER;
    assert driver_kind_of_env(true, "systemd") == D_NONE;
}

invariant reaper_needs_a_dead_socket_and_the_budget {
    assert reap_refusal(true, IDLE_REAP_MS) == R_OK;
    assert reap_refusal(false, IDLE_REAP_MS - 1) == R_OK;
    assert reap_refusal(false, IDLE_REAP_MS) != R_OK;
}

test stop_then_rm_order_holds {
    assert(stop_then_rm_ok(POD_RUNNING, STOP_GRACE_SECS));
    assert(!stop_then_rm_ok(POD_CREATING, STOP_GRACE_SECS));
    assert(!stop_then_rm_ok(POD_RUNNING, 0));
    assert(!stop_then_rm_ok(POD_GONE, STOP_GRACE_SECS));
    var state : u8 = POD_RUNNING;
    state = POD_STOPPING;
    assert(rm_refusal(state, STOP_GRACE_SECS) == R_RM_BEFORE_STOP);
    state = POD_STOPPED;
    assert(rm_refusal(state, STOP_GRACE_SECS) == R_OK);
    assert(sweeper_rm_ok(state, STOP_GRACE_SECS));
    assert(sweeper_rm_ok(state, 1) == false);
}

test none_driver_answers_not_configured {
    assert(driver_kind_of_env(false, "") == D_NONE);
    assert(route_answer(driver_kind_of_env(false, "")) == R_NOT_CONFIGURED);
    assert(route_answer(driver_kind_of_env(true, "fixed")) == R_OK);
    assert(TAB_CAP >= 1);
}

test port_allocation_stays_in_range_and_distinct {
    var used : [4]u32 = [0] ** 4;
    var n : usize = 0;
    var p = alloc_port(&used, n);
    used[0] = p;
    n = 1;
    assert(p == WEBRTC_MUX_MIN);
    p = alloc_port(&used, n);
    used[1] = p;
    n = 2;
    used[1] = WEBRTC_MUX_MIN + 3;
    p = alloc_port(&used, n);
    assert(p == WEBRTC_MUX_MIN + 1);
    used[1] = p;
    used[2] = WEBRTC_MUX_MIN + 4;
    n = 3;
    p = alloc_port(&used, n);
    assert(p == WEBRTC_MUX_MIN + 2);
    var clean : [3]u32 = [WEBRTC_MUX_MIN, WEBRTC_MUX_MIN + 1, WEBRTC_MUX_MIN + 2];
    assert(alloc_set_ok(&clean, 3));
    var dup : [3]u32 = [WEBRTC_MUX_MIN, WEBRTC_MUX_MIN, WEBRTC_MUX_MIN + 1];
    assert(!alloc_set_ok(&dup, 3));
    assert(!mux_in_range(0));
    assert(alloc_refusal(0) == R_OUT_OF_PORTS);
}

test reaper_ignores_polling_only_sessions {
    var polled_only_open : bool = false;
    var idle : u64 = IDLE_REAP_MS + 1000;
    assert(reap_refusal(polled_only_open, idle) != R_OK);
    assert(reap_refusal(polled_only_open, idle) == reap_refusal(polled_only_open, idle));
    assert(reap_refusal(true, idle) == R_OK);
    assert(reap_refusal(false, 1000) == R_OK);
}
