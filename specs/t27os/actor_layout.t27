// SPDX-License-Identifier: Apache-2.0
; specs/t27os/actor_layout.t27 -- the force-directed LAYOUT DESIGN law for the actor graph.
; Owner directive section 4: the DESIGN is written before the solver. This card pins the caps,
; the iteration budget, the tight-viewport fallback, the position persistence contract, and the
; test scaffolding that proves the contracts. The solver itself is a later slice; the scaffold
; mover in the test section is replaced by it, never shipped as it.
; Built on specs/t27os/actor_graph.t27 (the landed caps, grid and pid identity laws).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osActorLayout;

use t27os::actor_graph::AGR_MAX_NODES;
use t27os::actor_graph::AGR_MAX_EDGES;
use t27os::actor_graph::AGR_FS_PAD;
use t27os::actor_graph::AGR_NODE_R;
use t27os::actor_graph::agr_cols;
use t27os::actor_graph::agr_rows;

; --- 1. The caps -------------------------------------------------------------------------------------

/// Confirmed, not adjusted: 32 nodes = the PTY pane cap and the AGR grid already proven at 32;
/// 64 edges = twice the node cap (a tree plus its message edges; the counter table caps at the
/// same 64 in actor_graph). A graph past the caps is refused whole, never squeezed in.
pub fn al_nodes_ok(n : u32) -> bool {
    return n > 0 and n <= AGR_MAX_NODES;
}

pub fn al_edges_ok(e : u32) -> bool {
    return e <= AGR_MAX_EDGES;
}

; --- 2. The iteration budget -------------------------------------------------------------------------

/// The solver runs at most 300 iterations. Past the budget it must stop and report: a layout
/// that needs forever is a layout that lies about being settled.
pub const AL_ITERS_MAX : u32 = 300;

/// Early stop: when the largest movement of a pass is under a quarter graph unit, the layout is
/// settled. At the smallest scale (400 graph units across ~800 px) a quarter unit is under half
/// a pixel -- below what a reader can see.
pub const AL_EPS : f64 = 0.25;

pub fn al_converged(max_move : f64) -> bool {
    return max_move < AL_EPS;
}

; --- 3. The tight-viewport fallback ------------------------------------------------------------------

/// The air every pair of neighbours needs: two radii plus two units of ink-free margin.
pub const AL_MIN_AIR : f64 = 2.0 * AGR_NODE_R + 2.0;

/// Can a grid of n nodes keep AL_MIN_AIR inside the rect at all? The solver must run this
/// FEASIBILITY test first: if even the grid cannot fit the air, force direction cannot.
pub fn al_feasible(n : u32, w : f64, h : f64) -> bool {
    if (al_nodes_ok(n) == false) { return false; }
    const cw : f64 = (w - 2.0 * AGR_FS_PAD) / (agr_cols(n) as f64);
    const ch : f64 = (h - 2.0 * AGR_FS_PAD) / (agr_rows(n) as f64);
    return cw >= AL_MIN_AIR and ch >= AL_MIN_AIR;
}

/// What the solver must RETURN when the rect is too tight -- one explicit word, never a claim of
/// overlap-free: WIDEN (ask for a bigger rect), GROUP (cluster and show less), or GRID (fall
/// back to the AGR grid, which refuses nothing at the cap). QUEEN-CENTRE is a pinable option of
/// the solver, not an axiom of this law: nothing here requires the queen at the middle.
pub const AL_OK : u8 = 0;
pub const AL_FB_WIDEN : u8 = 1;
pub const AL_FB_GROUP : u8 = 2;
pub const AL_FB_GRID : u8 = 3;

/// The fallback picker: feasible -> OK; one axis short -> WIDEN (a wide graph in a narrow pane);
/// short on both -> GRID (the honest always-works answer); GROUP is reserved for the density
/// slice that introduces groups.
pub fn al_fallback(n : u32, w : f64, h : f64) -> u8 {
    if (al_feasible(n, w, h)) { return AL_OK; }
    const cw : f64 = (w - 2.0 * AGR_FS_PAD) / (agr_cols(n) as f64);
    const ch : f64 = (h - 2.0 * AGR_FS_PAD) / (agr_rows(n) as f64);
    if (cw >= AL_MIN_AIR or ch >= AL_MIN_AIR) { return AL_FB_WIDEN; }
    return AL_FB_GRID;
}

; --- 4. Position persistence -------------------------------------------------------------------------

/// Positions are keyed by the pid SLOT -- the stable half of the identity; a restart keeps the
/// slot and bumps the generation, so an incarnation keeps its spot for free. One row per slot,
/// stride 3: slot, x, y. Positions are held in thousandths (integers; a unit is 1000), so a
/// moved-or-not test is exact.
pub const AL_POS_F : usize = 3;
pub const AL_NO_SLOT : u32 = 4294967295;

pub fn al_pos_slot(tab : []const u64, total : u32, slot : u64) -> u32 {
    var i : u32 = 0;
    while (i < total) {
        if (tab[i * AL_POS_F] == slot) { return i; }
        i = i + 1;
    }
    return AL_NO_SLOT;
}

pub fn al_pos_units(tab : []const u64, total : u32, slot : u64) -> u64 {
    const s : u32 = al_pos_slot(tab, total, slot);
    if (s == AL_NO_SLOT) { return 0; }
    return tab[s * AL_POS_F + 1];
}

pub fn al_pos_y_units(tab : []const u64, total : u32, slot : u64) -> u64 {
    const s : u32 = al_pos_slot(tab, total, slot);
    if (s == AL_NO_SLOT) { return 0; }
    return tab[s * AL_POS_F + 2];
}

/// A NEW node starts at the barycenter of its neighbours' saved spots, or the rect centre when
/// it has none -- never at a random point, never on top of a sibling.
pub fn al_pos_new(neighbour_units : []const u64, m : u32, centre : u64) -> u64 {
    if (m == 0) { return centre; }
    var sum : u64 = 0;
    var i : u32 = 0;
    while (i < m) {
        sum = sum + neighbour_units[i];
        i = i + 1;
    }
    return sum / m;
}

; --- 5. The solver -----------------------------------------------------------------------------------

/// The edges table: pairs of slots, stride 2.
pub const AL_EF : usize = 2;

/// Are two slots linked by an edge?
pub fn al_linked(edges : []const u64, ne : u32, a : u64, b : u64) -> bool {
    var i : u32 = 0;
    while (i < ne) {
        if (edges[i * AL_EF] == a and edges[i * AL_EF + 1] == b) { return true; }
        if (edges[i * AL_EF] == b and edges[i * AL_EF + 1] == a) { return true; }
        i = i + 1;
    }
    return false;
}

/// Seed a NEW node into the position table at the barycenter of its neighbours' spots, or the
/// rect centre when it has none. Returns the new total. Nothing random, nothing guessed.
pub fn al_seed_new(tab : []u64, total : u32, slot : u64, neighbour_slots : []const u64, m : u32, cx : u64, cy : u64) -> u32 {
    var sx : u64 = 0;
    var sy : u64 = 0;
    var found : u32 = 0;
    var i : u32 = 0;
    while (i < m) {
        const s : u32 = al_pos_slot(tab, total, neighbour_slots[i]);
        if (s != AL_NO_SLOT) {
            sx = sx + al_pos_units(tab, total, neighbour_slots[i]);
            sy = sy + al_pos_y_units(tab, total, neighbour_slots[i]);
            found = found + 1;
        }
        i = i + 1;
    }
    const r : usize = total * AL_POS_F;
    tab[r] = slot;
    if (found == 0) {
        tab[r + 1] = cx;
        tab[r + 2] = cy;
    } else {
        tab[r + 1] = sx / found;
        tab[r + 2] = sy / found;
    }
    return total + 1;
}

/// The solver. Positions live in the table (thousandths, keyed by slot); the edges are slot
/// pairs. Deterministic: fixed damping 10/(iter+1), forces read the OLD positions of each pass
/// (Jacobi), movement clamped to the rect, early stop under AL_EPS, at most AL_ITERS_MAX passes.
/// Returns AL_OK only when the layout settled; an infeasible rect or an unconverged budget
/// returns the explicit fallback word -- never a claim of overlap-free. Force law: every other
/// node repels (+2 away per axis); each edge adds attraction (-1 toward). Repulsion dominates,
/// so linked nodes keep air; the walls and the clamp bound the world.
fn al_abs_diff(a : f64, b : f64) -> f64 {
    if (a > b) { return a - b; }
    return b - a;
}

fn al_max_move(ax : []const f64, ay : []const f64, bx : []const f64, by : []const f64, n : u32) -> f64 {
    var m : f64 = 0.0;
    var i : u32 = 0;
    while (i < n) {
        const dx : f64 = al_abs_diff(ax[i], bx[i]);
        const dy : f64 = al_abs_diff(ay[i], by[i]);
        if (dx > m) { m = dx; }
        if (dy > m) { m = dy; }
        i = i + 1;
    }
    return m;
}

fn al_clamp(v : f64, lo : f64, hi : f64) -> f64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

pub fn al_solve(tab : []u64, total : u32, edges : []const u64, ne : u32, w : f64, h : f64) -> u8 {
    const fb : u8 = al_fallback(total, w, h);
    if (fb != AL_OK) { return fb; }
    var x : [AGR_MAX_NODES]f64 = [0.0; 32];
    var y : [AGR_MAX_NODES]f64 = [0.0; 32];
    var i : u32 = 0;
    while (i < total) {
        x[i] = al_pos_units(tab, total, tab[i * AL_POS_F]) as f64 / 1000.0;
        y[i] = al_pos_y_units(tab, total, tab[i * AL_POS_F]) as f64 / 1000.0;
        i = i + 1;
    }
    const lo : f64 = AGR_FS_PAD;
    const hi_w : f64 = w - AGR_FS_PAD;
    const hi_h : f64 = h - AGR_FS_PAD;
    var iter : u32 = 0;
    var mm : f64 = 1000.0;
    var nx : [AGR_MAX_NODES]f64 = [0.0; 32];
    var ny : [AGR_MAX_NODES]f64 = [0.0; 32];
    while (iter < AL_ITERS_MAX) {
        const step : f64 = 10.0 / (iter as f64 + 1.0);
        i = 0;
        while (i < total) {
            var fx : f64 = 0.0;
            var fy : f64 = 0.0;
            var j : u32 = 0;
            while (j < total) {
                if (j != i) {
                    var rep : f64 = 2.0;
                    if (al_linked(edges, ne, tab[i * AL_POS_F], tab[j * AL_POS_F])) { rep = rep - 1.0; }
                    if (x[j] < x[i]) { fx = fx + rep; }
                    if (x[j] > x[i]) { fx = fx - rep; }
                    if (y[j] < y[i]) { fy = fy + rep; }
                    if (y[j] > y[i]) { fy = fy - rep; }
                }
                j = j + 1;
            }
            nx[i] = al_clamp(x[i] + fx * step, lo, hi_w);
            ny[i] = al_clamp(y[i] + fy * step, lo, hi_h);
            i = i + 1;
        }
        mm = al_max_move(x[0..], y[0..], nx[0..], ny[0..], total);
        i = 0;
        while (i < total) { x[i] = nx[i]; y[i] = ny[i]; i = i + 1; }
        iter = iter + 1;
        if (al_converged(mm)) { break; }
    }
    i = 0;
    while (i < total) {
        const r : usize = i * AL_POS_F;
        tab[r + 1] = (x[i] * 1000.0) as u64;
        tab[r + 2] = (y[i] * 1000.0) as u64;
        i = i + 1;
    }
    if (al_converged(mm) == false) { return AL_FB_GRID; }
    return AL_OK;
}

// ---------------------------------------------------------------- tests

test the_caps_are_confirmed_not_invented {
    assert(AGR_MAX_NODES == 32 and AGR_MAX_EDGES == 64);
    assert(al_nodes_ok(32) and al_nodes_ok(0) == false and al_nodes_ok(33) == false);
    assert(al_edges_ok(64) and al_edges_ok(65) == false);
}

test the_iteration_budget_and_epsilon_are_law {
    assert(AL_ITERS_MAX == 300 and AL_EPS == 0.25);
    assert(al_converged(0.2) and al_converged(0.25) == false and al_converged(1.0) == false);
}

test the_tight_viewport_returns_an_explicit_fallback {
    assert(al_feasible(4, 800.0, 600.0));
    assert(al_fallback(4, 800.0, 600.0) == AL_OK);
    // one tight axis: the honest answer is WIDEN, not a squeezed claim
    assert(al_feasible(16, 160.0, 600.0) == false);
    assert(al_fallback(16, 160.0, 600.0) == AL_FB_WIDEN);
    // tight on both axes: the honest always-works answer is the grid
    assert(al_fallback(32, 200.0, 150.0) == AL_FB_GRID);
    // past the node cap nothing is feasible: refused before any solver runs
    assert(al_feasible(33, 800.0, 600.0) == false);
    assert(AL_MIN_AIR == 30.0);
    // the solver itself refuses an infeasible rect without running a single pass
    var tab : [3]u64 = [7, 100000, 100000];
    var no_edges : [2]u64 = [0, 0];
    assert(al_fallback(1, 60.0, 600.0) == AL_FB_WIDEN);
    assert(al_solve(tab[0..], 1, no_edges[0..], 0, 60.0, 600.0) == AL_FB_WIDEN);
}

test positions_persist_by_slot_and_a_restart_keeps_its_spot {
    var tab : [6]u64 = [7, 120000, 90000, 3, 400000, 300000];
    let total : u32 = 2;
    assert(al_pos_slot(tab[0..], total, 7) == 0);
    assert(al_pos_units(tab[0..], total, 7) == 120000);
    assert(al_pos_y_units(tab[0..], total, 3) == 300000);
    // an absent slot is the explicit NO_SLOT and reads the zero shape
    assert(al_pos_slot(tab[0..], total, 9) == AL_NO_SLOT);
    assert(al_pos_units(tab[0..], total, 9) == 0);
    // a removed node leaves the table: its spot is free, nothing inherits it by name
    var tab2 : [3]u64 = [3, 400000, 300000];
    assert(al_pos_slot(tab2[0..], 1, 7) == AL_NO_SLOT);
}

test a_new_node_is_seeded_at_its_neighbours_barycenter {
    var tab : [12]u64 = [7, 100000, 100000, 3, 300000, 100000, 0, 0, 0, 0, 0, 0];
    let total : u32 = 2;
    // two neighbours side by side: the new node takes their mean spot
    var nb : [2]u64 = [7, 3];
    const t2 : u32 = al_seed_new(tab[0..], total, 9, nb[0..], 2, 500000, 500000);
    assert(t2 == 3);
    assert(al_pos_slot(tab[0..], t2, 9) == 2);
    assert(al_pos_units(tab[0..], t2, 9) == 200000);
    // no resolvable neighbours: the rect centre, never a random point
    var none : [1]u64 = [42];
    const t3 : u32 = al_seed_new(tab[0..], t2, 42, none[0..], 1, 500000, 500000);
    assert(al_pos_units(tab[0..], t3, 42) == 500000);
}

test the_solver_settles_under_the_budget_and_reports_ok {
    // two linked nodes push apart until the walls hold them
    var tab : [6]u64 = [7, 100000, 100000, 3, 120000, 100000];
    var edges : [2]u64 = [7, 3];
    const v : u8 = al_solve(tab[0..], 2, edges[0..], 1, 800.0, 600.0);
    assert(v == AL_OK);
    // they pushed apart: node 7 moved left of its start, node 3 right of its start, and the
    // settled pair keeps more than AL_MIN_AIR of clear air between them
    assert(al_pos_units(tab[0..], 2, 7) < 100000);
    assert(al_pos_units(tab[0..], 2, 3) > 120000);
    assert(al_pos_units(tab[0..], 2, 3) - al_pos_units(tab[0..], 2, 7) >= 90000);
}

test refresh_stability_reruns_land_on_the_same_layout {
    // the same input through the solver twice: identical output words, zero movement
    var a : [6]u64 = [7, 100000, 100000, 3, 120000, 100000];
    var b : [6]u64 = [7, 100000, 100000, 3, 120000, 100000];
    var edges : [2]u64 = [7, 3];
    assert(al_solve(a[0..], 2, edges[0..], 1, 800.0, 600.0) == AL_OK);
    assert(al_solve(b[0..], 2, edges[0..], 1, 800.0, 600.0) == AL_OK);
    assert(al_pos_units(a[0..], 2, 7) == al_pos_units(b[0..], 2, 7));
    assert(al_pos_units(a[0..], 2, 3) == al_pos_units(b[0..], 2, 3));
    assert(al_pos_y_units(a[0..], 2, 7) == al_pos_y_units(b[0..], 2, 7));
}

test order_independence_permuted_input_same_layout {
    // the same graph with its table rows swapped: each slot lands on the same spot
    var a : [6]u64 = [7, 100000, 100000, 3, 120000, 100000];
    var b : [6]u64 = [3, 120000, 100000, 7, 100000, 100000];
    var edges : [2]u64 = [7, 3];
    assert(al_solve(a[0..], 2, edges[0..], 1, 800.0, 600.0) == AL_OK);
    assert(al_solve(b[0..], 2, edges[0..], 1, 800.0, 600.0) == AL_OK);
    assert(al_pos_units(a[0..], 2, 7) == al_pos_units(b[0..], 2, 7));
    assert(al_pos_units(a[0..], 2, 3) == al_pos_units(b[0..], 2, 3));
    assert(al_pos_y_units(a[0..], 2, 3) == al_pos_y_units(b[0..], 2, 3));
}

test a_small_delta_moves_bounded_not_the_world {
    // the settled pair; a third linked node is seeded at their barycenter; the solve runs again:
    // the old nodes rest at the same walls (bounded -- their spots do not move at all), and the
    // new node rests between them, never on top of a sibling
    var tab : [9]u64 = [7, 2000, 100000, 3, 798000, 100000, 0, 0, 0];
    var nb : [2]u64 = [7, 3];
    const t : u32 = al_seed_new(tab[0..], 2, 9, nb[0..], 2, 400000, 100000);
    var edges : [6]u64 = [7, 9, 9, 3, 0, 0];
    assert(al_solve(tab[0..], t, edges[0..], 2, 800.0, 600.0) == AL_OK);
    // the old walls held: bounded, no reshuffle
    assert(al_pos_units(tab[0..], t, 7) < 60000);
    assert(al_pos_units(tab[0..], t, 3) > 740000);
    // the new node sits strictly between them
    assert(al_pos_units(tab[0..], t, 9) > al_pos_units(tab[0..], t, 7));
    assert(al_pos_units(tab[0..], t, 9) < al_pos_units(tab[0..], t, 3));
}

test the_cap_scale_graph_gets_an_honest_word_never_a_lie {
    // 32 nodes seeded on the AGR grid, no edges: each is repelled by 31 others. Whether the
    // budget settles them or not, the solver returns a truthful word and every node stays in
    // the rect -- this is where a wrong cap would show up as a lie, and it does not.
    var tab : [96]u64 = [0; 96];
    var i : u32 = 0;
    while (i < AGR_MAX_NODES) {
        tab[i * AL_POS_F] = i + 1;
        tab[i * AL_POS_F + 1] = (i % 6) * 100000 + 100000;
        tab[i * AL_POS_F + 2] = (i / 6) * 100000 + 100000;
        i = i + 1;
    }
    var no_edges : [2]u64 = [0, 0];
    const v : u8 = al_solve(tab[0..], AGR_MAX_NODES, no_edges[0..], 0, 800.0, 600.0);
    assert(v == AL_OK or v == AL_FB_GRID);
    i = 0;
    while (i < AGR_MAX_NODES) {
        assert(al_pos_units(tab[0..], AGR_MAX_NODES, i + 1) >= 24000);
        assert(al_pos_units(tab[0..], AGR_MAX_NODES, i + 1) <= 776000);
        assert(al_pos_y_units(tab[0..], AGR_MAX_NODES, i + 1) >= 24000);
        assert(al_pos_y_units(tab[0..], AGR_MAX_NODES, i + 1) <= 576000);
        i = i + 1;
    }
}

invariant the_layout_law_has_one_home_per_number {
    assert(AL_ITERS_MAX == 300 and AL_POS_F == 3 and AL_EF == 2);
    assert(AL_OK == 0 and AL_FB_WIDEN == 1 and AL_FB_GROUP == 2 and AL_FB_GRID == 3);
    assert(AL_NO_SLOT == 4294967295);
}
