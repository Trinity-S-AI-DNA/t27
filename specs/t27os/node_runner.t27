// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_runner.t27 -- the node runner's tick law (owner brief 2026-10-27):
// the four states a consenting market node walks, and the gates that refuse each step.
// The runner composes specs/t27os/node_market.t27's fail-closed rules (dispatch,
// key cap, payout, daily budget); this file adds only the ORDER: claim gates first,
// settle gates second, and an unknown state refuses (fail closed). The host glue
// runs the process; every DECISION below is checked by these tests.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeRunner;

use t27os::node_market::job_dispatch_ok;
use t27os::node_market::key_spend_ok;
use t27os::node_market::payout_mtri;
use t27os::node_market::budget_ok;

pub const ST_IDLE : u8 = 0;
pub const ST_CLAIMED : u8 = 1;
pub const ST_RUNNING : u8 = 2;
pub const ST_SETTLED : u8 = 3;
pub const ST_REFUSE : u8 = 4;

/// A node may claim a job only past BOTH gates: dispatch law (32-hex challenge,
/// at least one spec) and its contributed key's daily cap.
pub fn claim_ok(challenge : []const u8, spec_count : usize, spent_musd : u32, cap_musd : u32) -> bool {
    return job_dispatch_ok(challenge, spec_count) and key_spend_ok(spent_musd, cap_musd);
}

/// Settle returns the mTRI the node earns from this job: 0 means refuse.
/// A closed day refuses BEFORE the payout is computed -- the budget outranks
/// even a verified receipt.
pub fn settle_ok(receipt_verified : bool, units : u32, minted_today_mtri : u32) -> u32 {
    if (budget_ok(minted_today_mtri) == false) { return 0; }
    return payout_mtri(receipt_verified, units);
}

/// One tick's transition. The gates are precomputed by the host from the two
/// functions above; the table refuses anything the gates did not open, and an
/// unknown state refuses (fail closed).
pub fn next_state(state : u8, claim : bool, receipt_ok : bool, budget_ok_flag : bool) -> u8 {
    if (state == ST_IDLE) {
        if (claim == false) { return ST_REFUSE; }
        return ST_CLAIMED;
    }
    if (state == ST_CLAIMED) { return ST_RUNNING; }
    if (state == ST_RUNNING) {
        if (receipt_ok == false) { return ST_REFUSE; }
        if (budget_ok_flag == false) { return ST_REFUSE; }
        return ST_SETTLED;
    }
    return ST_REFUSE;
}

test runner_consts_hold {
    var a : u8 = ST_IDLE;
    var b : u8 = ST_CLAIMED;
    var c : u8 = ST_RUNNING;
    var d : u8 = ST_SETTLED;
    var e : u8 = ST_REFUSE;
    assert a == 0;
    assert b == 1;
    assert c == 2;
    assert d == 3;
    assert e == 4;
}

test claim_composes_both_fail_closed_gates {
    assert claim_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 1, 0, 500) == true;
    assert claim_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 0, 0, 500) == false;
    assert claim_ok("short", 1, 0, 500) == false;
    assert claim_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 1, 500, 500) == false;
    assert claim_ok("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 1, 499, 500) == true;
}

test settle_refuses_a_closed_day_before_paying {
    assert settle_ok(true, 10, 1000) == 0;
    assert settle_ok(true, 10, 999) == 10;
    assert settle_ok(false, 10, 0) == 0;
    assert settle_ok(true, 0, 0) == 0;
}

test the_happy_path_walks_all_four_states {
    assert next_state(ST_IDLE, true, false, false) == ST_CLAIMED;
    assert next_state(ST_CLAIMED, true, false, false) == ST_RUNNING;
    assert next_state(ST_RUNNING, true, true, true) == ST_SETTLED;
}

test every_gate_refuses_closed {
    assert next_state(ST_IDLE, false, true, true) == ST_REFUSE;
    assert next_state(ST_RUNNING, true, false, true) == ST_REFUSE;
    assert next_state(ST_RUNNING, true, true, false) == ST_REFUSE;
    assert next_state(9, true, true, true) == ST_REFUSE;
    assert next_state(255, true, true, true) == ST_REFUSE;
}
