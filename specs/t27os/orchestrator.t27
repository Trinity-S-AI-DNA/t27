// specs/t27os/orchestrator.t27 -- scout reads, the orchestrator decides, a worker waits.
// Merge, publish, a host file, a test run, and the window shell stay closed.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::orchestrator {

    use t27os::cache::cache_hit;
    use t27os::blockers::BK_EXTERNAL;
    use t27os::queue::SLOT_WAIT;
    use t27os::queue::next_slot;
    use t27os::reports::report_ready;
    use t27os::reports::MAY_MERGE;
    use t27os::dashboard::row_blocked;
    use t27os::dashboard::gate_class;
    use automation::t27_plan::window_shell;
    use automation::t27_plan::host_ready;
    use automation::t27_plan::OUT_OK;
    use automation::t27_plan::OUT_WAIT;
    use automation::t27_plan::OUT_BLOCKED;

    pub const ROLE_SCOUT : u8 = 1;
    pub const ROLE_WORKER : u8 = 2;
    pub const ROLE_ORCH : u8 = 3;

    pub fn decide(role: u8, ask_merge: bool, ask_host: bool, ask_window: bool) -> u8 {
        if (ask_merge || ask_host || ask_window || MAY_MERGE) { return OUT_BLOCKED; }
        if (role == ROLE_SCOUT || role == ROLE_ORCH) { return OUT_OK; }
        if (role == ROLE_WORKER) { return OUT_WAIT; }
        return OUT_BLOCKED;
    }

    /// The container lane is blocked, so the next slot stays empty.
    pub fn next_action() -> u8 {
        if (row_blocked() || gate_class() == BK_EXTERNAL) {
            return next_slot(SLOT_WAIT, BK_EXTERNAL, SLOT_WAIT, BK_EXTERNAL);
        }
        return 1;
    }

    test "the scout may read, the worker waits, and the window stays shut" {
        assert(decide(ROLE_SCOUT, false, false, false) == OUT_OK);
        assert(decide(ROLE_ORCH, false, false, false) == OUT_OK);
        assert(decide(ROLE_WORKER, false, false, false) == OUT_WAIT);
        assert(decide(ROLE_ORCH, true, false, false) == OUT_BLOCKED);
        assert(decide(ROLE_ORCH, false, true, false) == OUT_BLOCKED);
        assert(decide(ROLE_ORCH, false, false, true) == OUT_BLOCKED);
        assert(window_shell() == OUT_BLOCKED);
        assert(!host_ready());
        assert(!MAY_MERGE);
        assert(next_action() == 0);
        assert(cache_hit(4, 4));
        assert(report_ready(true, true, true, true, true));
        assert(!report_ready(false, true, true, true, true));
    }

    invariant no_slot_opens_while_the_gate_is_external {
        assert next_action() == 0;
        assert window_shell() == OUT_BLOCKED;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
