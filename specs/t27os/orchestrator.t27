// SPDX-License-Identifier: Apache-2.0
; specs/t27os/orchestrator.t27 -- what the project orchestrator may do.
; It watches lanes that were handed to it, and only while those lanes show
; a state, a permission question, a file, or a report. A commit and a push of
; the agent's own lane are the default. Merge, publication, mail, a paid
; call, a host file, a new shell, a test-report on this Mac, and the window
; shell stay off until a separate permission.
; The window shell is glass_window.t27. This spec does not draw it.

module T27osOrchestrator;

/// Collect status, read a diff, write a report, commit the task files,
/// push the lane. No extra permission. Push and a pull request still have
/// their own predicates below.
pub const OC_ACT_STATUS : u32 = 1;
pub const OC_ACT_DIFF : u32 = 2;
pub const OC_ACT_REPORT : u32 = 3;
pub const OC_ACT_COMMIT : u32 = 11;
pub const OC_ACT_PUSH : u32 = 12;
pub const OC_ACT_PR : u32 = 13;

/// Off until a separate permission names them.
pub const OC_ACT_HOST : u32 = 4;
pub const OC_ACT_LAB : u32 = 5;
pub const OC_ACT_MERGE : u32 = 6;
pub const OC_ACT_PUBLISH : u32 = 7;
pub const OC_ACT_WINDOW : u32 = 8;
pub const OC_ACT_ISSUE : u32 = 9;
pub const OC_ACT_CRON : u32 = 10;
pub const OC_ACT_EMAIL : u32 = 14;
pub const OC_ACT_PAID : u32 = 15;
pub const OC_ACT_SHELL : u32 = 16;
pub const OC_ACT_MAC_TEST : u32 = 17;
pub const OC_ACT_FORCE : u32 = 18;
pub const OC_ACT_REBASE : u32 = 19;

/// 1 while the window shell stays closed. The replacement is not ready.
pub const WINDOW_SHELL_BLOCKED : u32 = 1;

pub fn oc_allowed(act: u32) -> bool {
    if (act == OC_ACT_STATUS) { return true; }
    if (act == OC_ACT_DIFF) { return true; }
    if (act == OC_ACT_REPORT) { return true; }
    if (act == OC_ACT_COMMIT) { return true; }
    if (act == OC_ACT_PUSH) { return true; }
    if (act == OC_ACT_PR) { return true; }
    return false;
}

pub fn oc_needs_owner(act: u32) -> bool {
    return oc_allowed(act) == false;
}

/// A normal commit of this task's files on this lane. Secrets never go in.
pub fn oc_commit_ok(own_lane: bool, task_files_only: bool, has_secret: bool) -> bool {
    if (own_lane == false) { return false; }
    if (task_files_only == false) { return false; }
    if (has_secret) { return false; }
    return true;
}

/// Stay on the assigned lane. Master, force-push, and a shared rebase are off.
pub fn oc_branch_ok(is_master: bool, force: bool, rebase_shared: bool) -> bool {
    if (is_master) { return false; }
    if (force) { return false; }
    if (rebase_shared) { return false; }
    return true;
}

/// Push the lane after a local check. Not master, and not with unrelated files.
pub fn oc_push_ok(own_lane: bool, check_ok: bool, unrelated: bool, to_master: bool) -> bool {
    if (own_lane == false) { return false; }
    if (check_ok == false) { return false; }
    if (unrelated) { return false; }
    if (to_master) { return false; }
    return true;
}

/// A pull request waits until the task is complete and the checks are green.
/// Opening one does not merge it.
pub fn oc_pr_ok(task_done: bool, checks_green: bool) -> bool {
    if (task_done == false) { return false; }
    if (checks_green == false) { return false; }
    return true;
}

pub fn oc_window_open() -> bool {
    return false;
}

test status_diff_and_report_need_no_extra_permission {
    assert oc_allowed(OC_ACT_STATUS);
    assert oc_allowed(OC_ACT_DIFF);
    assert oc_allowed(OC_ACT_REPORT);
}

test host_lab_merge_publish_window_issue_and_cron_stay_off {
    assert oc_allowed(OC_ACT_HOST) == false;
    assert oc_allowed(OC_ACT_LAB) == false;
    assert oc_allowed(OC_ACT_MERGE) == false;
    assert oc_allowed(OC_ACT_PUBLISH) == false;
    assert oc_allowed(OC_ACT_WINDOW) == false;
    assert oc_allowed(OC_ACT_ISSUE) == false;
    assert oc_allowed(OC_ACT_CRON) == false;
}

test the_window_shell_stays_blocked {
    assert WINDOW_SHELL_BLOCKED == 1;
    assert oc_window_open() == false;
    assert oc_allowed(OC_ACT_WINDOW) == false;
    assert oc_needs_owner(OC_ACT_WINDOW);
}

test a_lane_commit_is_the_default_and_a_secret_is_not {
    assert oc_allowed(OC_ACT_COMMIT);
    assert oc_commit_ok(true, true, false);
    assert oc_commit_ok(false, true, false) == false;
    assert oc_commit_ok(true, false, false) == false;
    assert oc_commit_ok(true, true, true) == false;
}

test the_lane_branch_is_the_work_unit {
    assert oc_branch_ok(false, false, false);
    assert oc_branch_ok(true, false, false) == false;
    assert oc_branch_ok(false, true, false) == false;
    assert oc_branch_ok(false, false, true) == false;
    assert oc_needs_owner(OC_ACT_FORCE);
    assert oc_needs_owner(OC_ACT_REBASE);
}

test a_push_follows_a_green_local_check_and_stays_off_master {
    assert oc_allowed(OC_ACT_PUSH);
    assert oc_push_ok(true, true, false, false);
    assert oc_push_ok(true, false, false, false) == false;
    assert oc_push_ok(true, true, true, false) == false;
    assert oc_push_ok(true, true, false, true) == false;
}

test a_pull_request_waits_for_a_done_task_and_green_checks {
    assert oc_allowed(OC_ACT_PR);
    assert oc_pr_ok(true, true);
    assert oc_pr_ok(false, true) == false;
    assert oc_pr_ok(true, false) == false;
    assert oc_needs_owner(OC_ACT_MERGE);
}

test mail_paid_calls_a_new_shell_and_a_mac_test_report_need_the_owner {
    assert oc_needs_owner(OC_ACT_EMAIL);
    assert oc_needs_owner(OC_ACT_PAID);
    assert oc_needs_owner(OC_ACT_SHELL);
    assert oc_needs_owner(OC_ACT_MAC_TEST);
    assert oc_needs_owner(OC_ACT_HOST);
    assert oc_needs_owner(OC_ACT_PUBLISH);
}
