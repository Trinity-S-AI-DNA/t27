; --- 1. what the host observed, what the walk decided ------------------------------------------------------------

/// What the host saw for one attempt. `changes` is `git status --porcelain` of the worktree after the command;
/// `secret_rows` is how many journal rows the host wrote that gm_line_clean refused (0 on a healthy host).
pub struct GmObserved {
    exit_code: i32,
    final_state: u8,
    duration_ms: u64,
    changes: []const u8,
    acceptance_passed: bool,
    artifacts_present: u32,
    artifacts_nonempty: u32,
    orphans: u32,
    secret_rows: u32,
    head: []const u8,
}

/// Every decision of one walk, flat so a host can copy it field by field into the report.
pub struct GmOutcome {
    status: u8,
    diag: u16,
    class: u8,
    failed_gates: u32,
    attempts: u32,
    retry: u8,
    exit_code: i32,
    duration_ms: u64,
    events: u32,
    retries_journaled: u32,
    last_event: u8,
    journal_torn: bool,
    approvals_denied: u32,
}

; --- 2. helpers (private) ----------------------------------------------------------------------------------------

/// Non-empty lines of a newline list (the acceptance commands, the artifact manifest).
fn entries(list: []const u8) -> u32 {
    var n : u32 = 0;
    var in_line : bool = false;
    var i : usize = 0;
    while (i < list.len) {
        if (list[i] == 10) {
            if (in_line) { n = n + 1; }
            in_line = false;
        } else {
            in_line = true;
        }
        i = i + 1;
    }
    if (in_line) { n = n + 1; }
    return n;
}

/// Append ev when the journal allows it. A refused append is a walk bug: it marks the journal torn, so the journal
/// gate fails and the task can never end `completed` on a journal out of order.
fn journal_step(j: GmJournal, ev: u8) -> GmJournal {
    if (gm_journal_check(j, ev) != J_OK) {
        var r : GmJournal = j;
        r.torn = true;
        return r;
    }
    return gm_journal_apply(j, ev);
}

fn result_of(o: GmObserved) -> GmCommandResult {
    return GmCommandResult { exit_code: o.exit_code, final_state: o.final_state, duration_ms: o.duration_ms, stdout_bytes: 0, stderr_bytes: 0, truncated: false, orphans: o.orphans };
}

/// The outcome of a task that never ran: no attempt, no exit, no gate passed.
fn not_run(status: u8, diag: u16, class: u8, j: GmJournal, denied: u32) -> GmOutcome {
    return GmOutcome { status: status, diag: diag, class: class, failed_gates: G_ALL, attempts: 0, retry: RD_STOP_NOT_RETRYABLE, exit_code: 0, duration_ms: 0, events: j.count, retries_journaled: 0, last_event: EV_TASK_FAILED, journal_torn: j.torn, approvals_denied: denied };
}

; --- 3. the walk ---------------------------------------------------------------------------------------------------

/// The approval path: every contract check up to the command passed (gm_validate stops at E027 only after E001..E026),
/// and the command is refused because it is dangerous, not merely unlisted.
pub fn gm_needs_approval(t: GmTask) -> bool {
    return gm_validate(t) == E027 and gm_approval_needed(gm_executor_verdict(t));
}

/// One task, end to end. `first` is what the host saw on attempt 1, `again` on every retry.
pub fn gm_walk(t: GmTask, first: GmObserved, again: GmObserved) -> GmOutcome {
    var j : GmJournal = gm_journal_new();
    const diag : u16 = gm_validate(t);
    if (gm_needs_approval(t)) {
        j = journal_step(j, EV_TASK_VALIDATED);
        j = journal_step(j, EV_APPROVAL_REQUESTED);
        j = journal_step(j, EV_APPROVAL_DENIED);
        j = journal_step(j, EV_TASK_FAILED);
        return not_run(gm_final_status(GM_OK, true, FC_POLICY, G_ALL), diag, FC_POLICY, j, 1);
    }
    if (diag != GM_OK) {
        j = journal_step(j, EV_TASK_FAILED);
        return not_run(gm_final_status(diag, false, FC_NONE, G_ALL), diag, FC_NONE, j, 0);
    }
    j = journal_step(j, EV_TASK_VALIDATED);
    j = journal_step(j, EV_WORKTREE_CREATED);
    j = journal_step(j, EV_CHECKPOINT_CREATED);
    j = journal_step(j, EV_PTY_STARTED);
    var o : GmObserved = first;
    var attempts : u32 = 0;
    var class : u8 = FC_NONE;
    var prev_class : u8 = FC_NONE;
    var prev_exit : i32 = 0;
    var decide : u8 = RD_RETRY;
    var ran : bool = false;
    var bad : u32 = 0;
    while (decide == RD_RETRY) {
        if (attempts > 0) {
            j = journal_step(j, EV_RETRY_ATTEMPTED);
            o = again;
        }
        attempts = attempts + 1;
        j = journal_step(j, EV_COMMAND_STARTED);
        j = journal_step(j, EV_COMMAND_COMPLETED);
        ran = o.final_state == SV_EXITED and o.exit_code == 0;
        if (ran) {
            j = journal_step(j, EV_VALIDATION_STARTED);
            j = journal_step(j, EV_VALIDATION_COMPLETED);
        }
        bad = gm_changes_violations(o.changes, t.write_paths, t.create_paths, t.delete_paths, t.forbidden_paths);
        class = gm_classify(result_of(o), ran and o.acceptance_passed, bad == 0);
        j = journal_step(j, EV_CHECKPOINT_CREATED);
        decide = gm_retry_decide(class, t.retryable_mask, attempts - 1, t.max_retries, prev_class, prev_exit, o.exit_code);
        prev_class = class;
        prev_exit = o.exit_code;
    }
    const declared : u32 = entries(t.acceptance_commands);
    var tests_ran : u32 = 0;
    var tests_passed : u32 = 0;
    if (ran) { tests_ran = declared; }
    if (ran and o.acceptance_passed) { tests_passed = declared; }
    const test_ok : bool = gm_test_gate(declared, tests_ran, tests_passed);
    const artifact_ok : bool = gm_artifact_gate(entries(t.artifact_manifest), o.artifacts_present, o.artifacts_nonempty, bad);
    const policy_ok : bool = gm_policy_gate(bad, 0, o.orphans, o.secret_rows);
    const journal_ok : bool = gm_journal_gate(gm_journal_complete(j), j.torn);
    const rollback_ok : bool = gm_rollback_gate(@intCast(t.rollback_procedure.len), true, gm_head_ok(o.head));
    const failed : u32 = gm_gates_failed(test_ok, artifact_ok, policy_ok, journal_ok, rollback_ok);
    const status : u8 = gm_final_status(GM_OK, false, class, failed);
    var last : u8 = EV_TASK_FAILED;
    if (status == TS_COMPLETED) { last = EV_TASK_COMPLETED; }
    j = journal_step(j, last);
    return GmOutcome { status: status, diag: GM_OK, class: class, failed_gates: failed, attempts: attempts, retry: decide, exit_code: o.exit_code, duration_ms: o.duration_ms, events: j.count, retries_journaled: j.retries, last_event: last, journal_torn: j.torn, approvals_denied: 0 };
}

/// The report row of an outcome (gm_report_row); `at` when the buffer is too small.
pub fn gm_walk_report(out: []u8, at: usize, task_id: []const u8, r: GmOutcome, head: []const u8) -> usize {
    return gm_report_row(out, at, task_id, r.status, r.diag, r.class, r.attempts, r.exit_code, r.duration_ms, r.failed_gates, r.events, head);
}

; --- 4. tests ------------------------------------------------------------------------------------------------------

const HEAD : []const u8 = "4f2a9c01d3e5b7a8c6d4e2f0a1b3c5d7e9f80123";
const HEAD_LATER : []const u8 = "5f2a9c01d3e5b7a8c6d4e2f0a1b3c5d7e9f80123";

/// The green observation: exit 0, report.json created and present, acceptance passed, nothing left behind.
fn seen_green() -> GmObserved {
    return GmObserved { exit_code: 0, final_state: SV_EXITED, duration_ms: 420, changes: "?? build/report.json", acceptance_passed: true, artifacts_present: 1, artifacts_nonempty: 1, orphans: 0, secret_rows: 0, head: HEAD };
}

fn seen_state(state: u8, exit: i32) -> GmObserved {
    var o : GmObserved = seen_green();
    o.final_state = state;
    o.exit_code = exit;
    o.changes = "";
    o.acceptance_passed = false;
    o.artifacts_present = 0;
    o.artifacts_nonempty = 0;
    return o;
}

fn dangerous_task() -> GmTask {
    var t : GmTask = gm_task_godmode_001();
    t.exec_args = "-lc\nrm -rf build";
    return t;
}

// A: contract

test a_reference_task_is_accepted {
    const t : GmTask = gm_task_godmode_001();
    assert gm_validate(t) == GM_OK;
    assert gm_executor_verdict(t) == CV_ALLOW;
    assert !gm_needs_approval(t);
}

test a_entries_counts_non_empty_lines {
    assert entries("") == 0;
    assert entries("test -f build/report.json") == 1;
    assert entries("a\n\nb\n") == 2;
}

test a_bad_contract_is_rejected_before_anything_runs {
    var t : GmTask = gm_task_godmode_001();
    t.max_retries = 4;
    const r : GmOutcome = gm_walk(t, seen_green(), seen_green());
    assert r.status == TS_REJECTED and r.diag == E024;
    assert r.attempts == 0 and r.events == 1 and r.last_event == EV_TASK_FAILED;
    assert r.failed_gates == G_ALL;
}

// B: supervised execution

test b_green_supervisor_path {
    var s : u8 = SV_IDLE;
    assert gm_sv_action(s, SE_SPAWN, 0, 0, 120000, 0, GM_GRACE_MS, STOP_NONE) == ACT_SPAWN;
    s = gm_sv_next(s, SE_SPAWN, 0, 0, 120000, 0, GM_GRACE_MS, STOP_NONE);
    assert s == SV_STARTING;
    s = gm_sv_next(s, SE_SPAWN_OK, 5, 0, 120000, 0, GM_GRACE_MS, STOP_NONE);
    assert s == SV_RUNNING;
    s = gm_sv_next(s, SE_TICK, 400, 5, 120000, 0, GM_GRACE_MS, STOP_NONE);
    assert s == SV_RUNNING;
    assert gm_sv_action(s, SE_EXIT, 425, 5, 120000, 0, GM_GRACE_MS, STOP_NONE) == ACT_RECORD;
    s = gm_sv_next(s, SE_EXIT, 425, 5, 120000, 0, GM_GRACE_MS, STOP_NONE);
    assert s == SV_EXITED;
}

test b_timeout_terms_then_ends_timed_out {
    const budget : u64 = 120000;
    var s : u8 = SV_RUNNING;
    assert gm_sv_action(s, SE_TICK, 120005, 5, budget, 0, GM_GRACE_MS, STOP_NONE) == ACT_TERM_GROUP;
    s = gm_sv_next(s, SE_TICK, 120005, 5, budget, 0, GM_GRACE_MS, STOP_NONE);
    assert s == SV_STOPPING;
    s = gm_sv_next(s, SE_EXIT, 121000, 5, budget, 120005, GM_GRACE_MS, STOP_TIMEOUT);
    assert s == SV_TIMED_OUT;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_state(SV_TIMED_OUT, 143), seen_state(SV_TIMED_OUT, 143));
    assert r.class == FC_TIMEOUT and r.status == TS_TIMED_OUT;
}

test b_cancel_kills_group_and_is_never_retried {
    assert gm_sv_action(SV_RUNNING, SE_CANCEL, 300, 5, 120000, 0, GM_GRACE_MS, STOP_NONE) == ACT_KILL_GROUP;
    assert gm_sv_next(SV_RUNNING, SE_CANCEL, 300, 5, 120000, 0, GM_GRACE_MS, STOP_NONE) == SV_CANCELLED;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_state(SV_CANCELLED, 137), seen_green());
    assert r.class == FC_CANCELLED and r.status == TS_CANCELLED;
    assert r.attempts == 1 and r.retry == RD_STOP_NOT_RETRYABLE;
    assert r.last_event == EV_TASK_FAILED;
}

test b_left_behind_process_is_a_policy_failure {
    var o : GmObserved = seen_green();
    o.orphans = 1;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.class == FC_POLICY and r.status == TS_FAILED;
    assert (r.failed_gates & G_POLICY) != 0;
}

// C: isolation and safety

test c_dangerous_command_is_requested_then_denied {
    const t : GmTask = dangerous_task();
    assert gm_executor_verdict(t) == CV_DANGEROUS;
    assert gm_needs_approval(t);
    const r : GmOutcome = gm_walk(t, seen_green(), seen_green());
    assert r.status == TS_DENIED and r.diag == E027;
    assert r.attempts == 0 and r.approvals_denied == 1;
    assert r.events == 4 and !r.journal_torn;
}

test c_unlisted_command_is_rejected_not_asked {
    var t : GmTask = gm_task_godmode_001();
    t.exec_command = "ls";
    t.exec_args = "-la";
    assert gm_executor_verdict(t) == CV_NOT_ALLOWLISTED;
    assert !gm_needs_approval(t);
    const r : GmOutcome = gm_walk(t, seen_green(), seen_green());
    assert r.status == TS_REJECTED and r.diag == E027 and r.events == 1;
}

test c_write_into_git_or_a_forbidden_path_fails {
    const t : GmTask = gm_task_godmode_001();
    assert gm_changes_verdict("?? build/report.json", t.write_paths, t.create_paths, t.delete_paths, t.forbidden_paths) == PV_ALLOW;
    assert gm_changes_verdict(" M .git/HEAD", t.write_paths, t.create_paths, t.delete_paths, t.forbidden_paths) == PV_FORBIDDEN;
    var o : GmObserved = seen_green();
    o.changes = "?? build/report.json\nM  specs/t27os/godmode_001.t27\n M .git/HEAD";
    const r : GmOutcome = gm_walk(t, o, o);
    assert r.class == FC_POLICY and r.status == TS_FAILED;
    assert r.attempts == 1 and r.retry == RD_STOP_NOT_RETRYABLE;
    assert (r.failed_gates & G_POLICY) != 0 and (r.failed_gates & G_ARTIFACT) != 0;
}

/// A key-shaped word built at run time, so no secret-shaped literal sits in the source. A bare vendor token, not
/// NAME=value: the redactor's NAME=value rule matches its own `TOKEN=[REDACTED]` output again on a second pass.
fn fake_key(out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "auth sk-");
    var i : usize = 0;
    while (i < 30) {
        out[n] = 98;
        n = n + 1;
        i = i + 1;
    }
    return n;
}

test c_no_secret_reaches_the_journal {
    var src : [64]u8 = undefined;
    const k : usize = fake_key(src[0..64]);
    assert !gm_line_clean(src[0..k]);
    var buf : [512]u8 = undefined;
    const n : usize = gm_row(buf[0..512], 0, 5, 1762500000, "GODMODE-001", EV_COMMAND_COMPLETED, 0, src[0..k]);
    assert gm_line_clean(buf[0..n]);
    var o : GmObserved = seen_green();
    o.secret_rows = 1;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.status == TS_FAILED and (r.failed_gates & G_POLICY) != 0;
}

// D: journal and recovery

/// The green walk's events, in order, written as journal rows.
fn green_rows(out: []u8) -> usize {
    var n : usize = gm_row(out, 0, 1, 1762500000, "GODMODE-001", EV_TASK_VALIDATED, 0, "GM-OK");
    n = gm_row(out, n, 2, 1762500001, "GODMODE-001", EV_WORKTREE_CREATED, 0, ".claude/worktrees/godmode-001");
    n = gm_row(out, n, 3, 1762500001, "GODMODE-001", EV_CHECKPOINT_CREATED, 0, "step 1");
    n = gm_row(out, n, 4, 1762500002, "GODMODE-001", EV_PTY_STARTED, 0, "bash");
    n = gm_row(out, n, 5, 1762500002, "GODMODE-001", EV_COMMAND_STARTED, 0, "attempt 1");
    n = gm_row(out, n, 6, 1762500003, "GODMODE-001", EV_COMMAND_COMPLETED, 0, "exit 0");
    n = gm_row(out, n, 7, 1762500003, "GODMODE-001", EV_VALIDATION_STARTED, 0, "test -f build/report.json");
    n = gm_row(out, n, 8, 1762500003, "GODMODE-001", EV_VALIDATION_COMPLETED, 0, "passed 1/1");
    n = gm_row(out, n, 9, 1762500003, "GODMODE-001", EV_CHECKPOINT_CREATED, 0, "step 4");
    n = gm_row(out, n, 10, 1762500004, "GODMODE-001", EV_TASK_COMPLETED, 0, "gates 5/5");
    return n;
}

test d_green_journal_survives_a_restart {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_green(), seen_green());
    var buf : [2048]u8 = undefined;
    const n : usize = green_rows(buf[0..2048]);
    const j : GmJournal = gm_replay(buf[0..n]);
    assert !j.torn and j.terminal;
    assert j.count == r.events and j.count == 10;
}

test d_torn_tail_keeps_the_rows_before_it {
    var buf : [2048]u8 = undefined;
    const n : usize = green_rows(buf[0..2048]);
    const j : GmJournal = gm_replay(buf[0..n - 1]);
    assert j.torn and !j.terminal;
    assert j.count == 9;
}

test d_crash_in_the_command_resumes_at_the_command {
    var buf : [2048]u8 = undefined;
    var n : usize = gm_row(buf[0..2048], 0, 1, 1, "GODMODE-001", EV_TASK_VALIDATED, 0, "GM-OK");
    n = gm_row(buf[0..2048], n, 2, 2, "GODMODE-001", EV_WORKTREE_CREATED, 0, "ok");
    n = gm_row(buf[0..2048], n, 3, 2, "GODMODE-001", EV_CHECKPOINT_CREATED, 0, "step 1");
    n = gm_row(buf[0..2048], n, 4, 3, "GODMODE-001", EV_PTY_STARTED, 0, "bash");
    n = gm_row(buf[0..2048], n, 5, 3, "GODMODE-001", EV_COMMAND_STARTED, 0, "attempt 1");
    const j : GmJournal = gm_replay(buf[0..n]);
    assert !j.torn and j.open_commands == 1;
    const cp : GmCheckpoint = GmCheckpoint { task_id: "GODMODE-001", completed_steps: 7, current_step: ST_COMMAND, artifacts_done: 0, journal_seq: 3, head: HEAD, attempts: 1 };
    assert gm_resume_decide(j, true, cp, HEAD, 3) == RS_RESUME;
    assert gm_resume_step(cp) == ST_COMMAND;
    assert gm_resume_decide(j, true, cp, HEAD_LATER, 3) == RS_HEAD_MOVED;
    var row : [256]u8 = undefined;
    const m : usize = gm_checkpoint_row(row[0..256], 0, cp);
    assert gm_line_clean(row[0..m]);
}

test d_finished_task_is_not_resumed {
    var buf : [2048]u8 = undefined;
    const n : usize = green_rows(buf[0..2048]);
    const j : GmJournal = gm_replay(buf[0..n]);
    const cp : GmCheckpoint = GmCheckpoint { task_id: "GODMODE-001", completed_steps: 31, current_step: 5, artifacts_done: 1, journal_seq: 9, head: HEAD, attempts: 1 };
    assert gm_resume_decide(j, true, cp, HEAD, 3) == RS_ALREADY_TERMINAL;
}

// E: bounded completion

test e_green_path_completes_with_five_gates {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_green(), seen_green());
    assert r.status == TS_COMPLETED and r.class == FC_NONE and r.retry == RD_DONE;
    assert r.failed_gates == 0 and r.attempts == 1;
    assert r.last_event == EV_TASK_COMPLETED and !r.journal_torn;
    assert r.events == 10;
}

test e_missing_artifact_blocks_completion {
    var o : GmObserved = seen_green();
    o.artifacts_present = 0;
    o.artifacts_nonempty = 0;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.status == TS_FAILED and r.failed_gates == G_ARTIFACT;
    assert r.last_event == EV_TASK_FAILED;
}

test e_empty_artifact_blocks_completion {
    var o : GmObserved = seen_green();
    o.artifacts_nonempty = 0;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.status == TS_FAILED and r.failed_gates == G_ARTIFACT;
}

test e_failed_acceptance_blocks_completion {
    var o : GmObserved = seen_green();
    o.acceptance_passed = false;
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.class == FC_TEST_FAILED and r.status == TS_FAILED;
    assert (r.failed_gates & G_TEST) != 0;
    assert r.retry == RD_STOP_NOT_RETRYABLE;
}

test e_unknown_base_head_blocks_completion {
    var o : GmObserved = seen_green();
    o.head = "HEAD";
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), o, o);
    assert r.status == TS_FAILED and r.failed_gates == G_ROLLBACK;
}

test e_timeouts_stop_after_three_retries {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_state(SV_TIMED_OUT, 143), seen_state(SV_TIMED_OUT, 143));
    assert r.attempts == 4 and r.retries_journaled == 3;
    assert r.retry == RD_STOP_BUDGET and r.status == TS_TIMED_OUT;
    assert !r.journal_torn and r.last_event == EV_TASK_FAILED;
}

test e_fewer_retries_when_the_task_asks_for_fewer {
    var t : GmTask = gm_task_godmode_001();
    t.max_retries = 1;
    const r : GmOutcome = gm_walk(t, seen_state(SV_TIMED_OUT, 143), seen_state(SV_TIMED_OUT, 143));
    assert r.attempts == 2 and r.retry == RD_STOP_BUDGET;
}

test e_same_exit_twice_stops_early {
    var t : GmTask = gm_task_godmode_001();
    t.retryable_mask = gm_class_bit(FC_EXIT_NONZERO) | gm_class_bit(FC_TIMEOUT);
    const r : GmOutcome = gm_walk(t, seen_state(SV_EXITED, 2), seen_state(SV_EXITED, 2));
    assert r.class == FC_EXIT_NONZERO and r.attempts == 2;
    assert r.retry == RD_STOP_REPEATED and r.status == TS_FAILED;
}

test e_exit_not_in_mask_is_not_retried {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_state(SV_EXITED, 1), seen_green());
    assert r.attempts == 1 and r.retry == RD_STOP_NOT_RETRYABLE and r.status == TS_FAILED;
}

test e_transient_spawn_failure_then_green_completes {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_state(SV_SPAWN_FAILED, -1), seen_green());
    assert r.attempts == 2 and r.retries_journaled == 1;
    assert r.status == TS_COMPLETED and r.failed_gates == 0;
    assert r.events == 14;
}

test e_retry_decision_alone {
    assert gm_retry_decide(FC_TIMEOUT, gm_class_bit(FC_TIMEOUT), 0, 3, FC_NONE, 0, 143) == RD_RETRY;
    assert gm_retry_decide(FC_TIMEOUT, gm_class_bit(FC_TIMEOUT), 3, 9, FC_TIMEOUT, 143, 143) == RD_STOP_BUDGET;
}

test e_report_row_is_machine_readable {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_green(), seen_green());
    var buf : [512]u8 = undefined;
    const n : usize = gm_walk_report(buf[0..512], 0, "GODMODE-001", r, HEAD);
    assert n > 0 and buf[n - 1] == 10;
    const head : []const u8 = "{\"task\":\"GODMODE-001\",\"status\":\"completed\",\"diag\":\"GM-OK\",\"class\":\"none\",\"attempts\":1,";
    assert bytes_equal(buf[0..head.len], head);
    assert gm_line_clean(buf[0..n]);
}

test e_report_of_a_denied_task_names_the_code {
    const r : GmOutcome = gm_walk(dangerous_task(), seen_green(), seen_green());
    var buf : [512]u8 = undefined;
    const n : usize = gm_walk_report(buf[0..512], 0, "GODMODE-001", r, HEAD);
    const head : []const u8 = "{\"task\":\"GODMODE-001\",\"status\":\"denied\",\"diag\":\"GM-E027\",";
    assert n > head.len;
    assert bytes_equal(buf[0..head.len], head);
}

test e_report_buffer_too_small_writes_nothing {
    const r : GmOutcome = gm_walk(gm_task_godmode_001(), seen_green(), seen_green());
    var buf : [64]u8 = undefined;
    assert GM_REPORT_MAX > 64;
    assert gm_walk_report(buf[0..64], 0, "GODMODE-001", r, HEAD) == 0;
}
