// SPDX-License-Identifier: Apache-2.0
// specs/t27os/integer_overflow.t27 -- [bug] T27 OS window traps on integer
// overflow at startup (key-age lane weight 65536^4).
// Part of M4 milestone (milestone #8). Closes #13015.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::integer_overflow;

pub const KEY_AGE_LANE_WEIGHT_HIGH : u32 = 65536;
pub const KEY_AGE_LANE_WEIGHT_LOW : u32 = 65536;

pub struct WindowStartup { key_age_weight: u32, overflow: bool };

pub fn window_startup_overflow(w: WindowStartup) -> bool {
    return w.overflow;
}

test "window_startup_overflow" {
    assert(!window_startup_overflow(WindowStartup { key_age_weight: 0, overflow: false }));
    assert(window_startup_overflow(WindowStartup { key_age_weight: 0, overflow: true }));
}

invariant key_age_lane_weight_defined {
    assert KEY_AGE_LANE_WEIGHT_HIGH == 65536;
    assert KEY_AGE_LANE_WEIGHT_LOW == 65536;
}