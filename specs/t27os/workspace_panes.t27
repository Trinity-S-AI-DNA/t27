// specs/t27os/workspace_panes.t27 -- T27 OS: workspace task panes and installed
// CLI discovery.
// Part of M1 (milestone #5). Closes #13208.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::workspace_panes;

pub const WORKSPACE_PANE_MAX : u32 = 16;

pub struct WorkspacePane { id: str, cli_discovered: bool };

pub fn workspace_pane_cli_discovered(p: WorkspacePane) -> bool {
    return p.cli_discovered;
}

test "workspace pane cli discovered" {
    assert(workspace_pane_cli_discovered(WorkspacePane { id: "wp-1", cli_discovered: true }));
    assert(!workspace_pane_cli_discovered(WorkspacePane { id: "wp-2", cli_discovered: false }));
}

invariant workspace_pane_max_positive {
    assert WORKSPACE_PANE_MAX > 0;
}