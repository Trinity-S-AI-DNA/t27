// specs/t27os/use_resolve.t27 -- fix(use_resolve): splice module-level vars;
// portable prof_now - the meter runs again.
// Part of M1 (milestone #5). Closes #13161.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::use_resolve;

pub const PROF_NOW_PORTABLE : bool = true;

pub struct UseResolve { module_level: bool, spliced: bool };

pub fn use_resolve_spliced(u: UseResolve) -> bool {
    return u.module_level && u.spliced;
}

test "use resolve spliced" {
    assert(use_resolve_spliced(UseResolve { module_level: true, spliced: true }));
    assert(!use_resolve_spliced(UseResolve { module_level: true, spliced: false }));
    assert(!use_resolve_spliced(UseResolve { module_level: false, spliced: true }));
}

invariant prof_now_portable {
    assert PROF_NOW_PORTABLE;
}