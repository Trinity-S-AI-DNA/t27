// SPDX-License-Identifier: Apache-2.0
// T27 OS keys_probe: the check button of the KEYS tab -- the one host call of the key manager that needs
// Foundation. probe() sends the cheapest authenticated request of a provider (a GET; for z.ai one one-token
// POST) (table: keys.t27) and hands back the HTTP status; keys.t27 status_after_probe decides what it means.
// The key travels in a request header, never in the URL.
//
// It lives apart from keys_host.t27 (the Keychain and the push to the PTY server, libSystem only) because a
// module's @extern imports travel with it: the PTY server imports keys_host to read the Keychain itself, and a
// server that linked CoreFoundation and the Objective-C runtime for a probe it never sends would not link
// against libSystem alone. Only the window imports this module.
//
// Specs holding @extern cannot run tests under t27c; every rule probe follows is a tested fn in keys.t27
// (url, header name and value, body, whether a probe exists). This file only builds the request and sends it.
//
// Refs gHashTag/t27#10782, gHashTag/t27#11241.
module T27osKeysProbe;

use t27os::keys::PROBE_TIMEOUT_S;
use t27os::keys::probe_url;
use t27os::keys::probe_has;
use t27os::keys::probe_header_name;
use t27os::keys::probe_header_value;
use t27os::keys::probe_post;
use t27os::keys::probe_body;
use t27os::keys::probe_needs_version;
use t27os::keys::NV_CHAT_URL;
use t27os::nvidia_direct::NV_TIMEOUT_S;
use t27os::nvidia_direct::nv_probe_body;
use t27os::session_store::put_bytes;
use t27os::pty_proto::get_u64;
use t27os::pty_sys::sys_addr;

pub const UTF8_ENC : u32 = 134217984;

fn cf_str(alloc: u64, bytes: []const u8, n: usize, enc: u32, ext: bool) -> u64 { return @extern("CFStringCreateWithBytes"); }
fn cf_data(alloc: u64, bytes: []const u8, n: u64) -> u64 { return @extern("CFDataCreate"); }
fn cf_release(o: u64) -> void { @extern("CFRelease"); }
fn class_named(name: u64) -> u64 { return @extern("NSClassFromString"); }
fn sel_named(name: u64) -> u64 { return @extern("NSSelectorFromString"); }
fn msg0(o: u64, s: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg1(o: u64, s: u64, a: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg2(o: u64, s: u64, a: u64, b: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg3(o: u64, s: u64, a: u64, b: u64, c: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg_f(o: u64, s: u64, t: f64) -> u64 { return @extern("objc_msgSend"); }

fn cf(s: []const u8) -> u64 {
    return cf_str(0, s, s.len, UTF8_ENC, false);
}

fn cls(s: []const u8) -> u64 {
    const n : u64 = cf(s);
    const c : u64 = class_named(n);
    cf_release(n);
    return c;
}

fn sel(s: []const u8) -> u64 {
    const n : u64 = cf(s);
    const c : u64 = sel_named(n);
    cf_release(n);
    return c;
}

fn add_header(req: u64, name: []const u8, value: []const u8) -> void {
    const n : u64 = cf(name);
    const v : u64 = cf(value);
    msg2(req, sel("setValue:forHTTPHeaderField:"), v, n);
    cf_release(n);
    cf_release(v);
}

/// Send one request: `url`, one key header, a JSON body when `post`, the anthropic-version header when `version`;
/// the HTTP status, 0 when nothing answered within `timeout_s`.
fn send_req(url_b: []const u8, hn: []const u8, hv: []const u8, post: bool, body: []const u8, version: bool, timeout_s: u32) -> u32 {
    var none : [1]u8 = undefined;
    var got : [1]u64 = undefined;
    return send_req_x(url_b, hn, hv, post, body, version, timeout_s, none[0..0], got[0..1]);
}

/// send_req, and the answer's body (at most out.len bytes) into `out`; the byte count into got[0] (0 when none).
fn send_req_x(url_b: []const u8, hn: []const u8, hv: []const u8, post: bool, body: []const u8, version: bool, timeout_s: u32, out: []u8, got: []u64) -> u32 {
    got[0] = 0;
    const us : u64 = cf(url_b);
    const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), us);
    cf_release(us);
    if (url == 0) { return 0; }
    const req : u64 = msg1(cls("NSMutableURLRequest"), sel("requestWithURL:"), url);
    if (req == 0) { return 0; }
    msg_f(req, sel("setTimeoutInterval:"), @as(f64, @floatFromInt(timeout_s)));
    add_header(req, hn, hv);
    if (version) { add_header(req, "anthropic-version", "2023-06-01"); }
    if (post) {
        const data : u64 = cf_data(0, body, @as(u64, body.len));
        const pm : u64 = cf("POST");
        msg1(req, sel("setHTTPMethod:"), pm);
        msg1(req, sel("setHTTPBody:"), data);
        add_header(req, "content-type", "application/json");
        cf_release(pm);
        cf_release(data);
    }
    add_header(req, "User-Agent", "t27os");
    var resp : [8]u8 = undefined;
    var err : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) {
        resp[i] = 0;
        err[i] = 0;
        i = i + 1;
    }
    const data : u64 = msg3(cls("NSURLConnection"), sel("sendSynchronousRequest:returningResponse:error:"), req, sys_addr(resp[0..8], resp[0..8], 0), sys_addr(err[0..8], err[0..8], 0));
    const r : u64 = get_u64(resp[0..8], 0);
    if (r == 0) { return 0; }
    if (data != 0 and out.len > 0) {
        var want : u64 = msg0(data, sel("length"));
        if (want > @as(u64, out.len)) { want = @as(u64, out.len); }
        if (want > 0) {
            msg2(data, sel("getBytes:length:"), sys_addr(out, out, 0), want);
            got[0] = want;
        }
    }
    return @as(u32, @intCast(msg0(r, sel("statusCode"))));
}

/// The check button: one authenticated GET for provider p with `key`; the HTTP status, 0 when nothing
/// answered (no network, timeout) and 1 when the provider has no probe. Blocks up to PROBE_TIMEOUT_S.
pub fn probe(p: u32, key: []const u8) -> u32 {
    if (probe_has(p) == false) { return 1; }
    var ub : [160]u8 = undefined;
    const un : usize = probe_url(p, ub[0..160]);
    var hn : [24]u8 = undefined;
    var hv : [300]u8 = undefined;
    const nl : usize = probe_header_name(p, hn[0..24]);
    const vl : usize = probe_header_value(p, key, hv[0..300]);
    var bb : [200]u8 = undefined;
    var bl : usize = 0;
    if (probe_post(p)) { bl = probe_body(p, bb[0..200]); }
    return send_req(ub[0..un], hn[0..nl], hv[0..vl], probe_post(p), bb[0..bl], probe_needs_version(p), PROBE_TIMEOUT_S);
}

/// The cabinet's health check (keys_health.t27): one GET of `url` with the Authorization value `auth` (kh_bearer); the
/// HTTP status, 0 when nothing answered in `timeout_s`. The caller wipes `auth`.
pub fn probe_get(url: []const u8, auth: []const u8, timeout_s: u32) -> u32 {
    return send_req(url, "Authorization", auth, false, "", false, timeout_s);
}

/// probe_get, and the answer's body (at most out.len bytes) into out; its length into got[0]. The body of the key
/// check holds the limit and the usage, never the key.
pub fn probe_get_body(url: []const u8, auth: []const u8, timeout_s: u32, out: []u8, got: []u64) -> u32 {
    return send_req_x(url, "Authorization", auth, false, "", false, timeout_s, out, got);
}

/// One NVIDIA direct check (nvidia_direct.t27): a one-token chat completion of `model` (a dead-listed or empty
/// model becomes NV_MODEL_DEFAULT) with `key` as a Bearer token; the HTTP status, 0 when nothing answered in
/// NV_TIMEOUT_S. The key is wiped from the header buffer before return.
pub fn probe_nvidia(key: []const u8, model: []const u8) -> u32 {
    var hv : [300]u8 = undefined;
    if (key.len + 7 > 300) { return 0; }
    var vl : usize = put_bytes(hv[0..300], 0, "Bearer ");
    vl = put_bytes(hv[0..300], vl, key);
    var bb : [200]u8 = undefined;
    const bl : usize = nv_probe_body(model, bb[0..200]);
    const code : u32 = send_req(NV_CHAT_URL, "Authorization", hv[0..vl], true, bb[0..bl], false, NV_TIMEOUT_S);
    var i : usize = 0;
    while (i < 300) {
        hv[i] = 0;
        i = i + 1;
    }
    return code;
}

test the_probe_module_is_declared {
    var b : [4]u8 = undefined;
    b[0] = 1;
    assert b[0] == 1;
}
