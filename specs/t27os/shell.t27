// SPDX-License-Identifier: Apache-2.0
// specs/t27os/shell.t27 -- T27 OS Shell contract: sidebar, agent tabs, panels,
// window manager, Team runtime as part of the shell.
// Part of [EPIC] T27 OS Shell (#13895). Closes #13895.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::shell {

    pub const MODULE : str = "t27os_shell";
    pub const SURFACE : str = "shell";

    // ---- Shell model ------------------------------------------------------
    pub struct Shell {
        sidebar : bool,
        agent_tabs : bool,
        panels : bool,
        windows : bool,
        team_runtime : bool,
    };

    pub struct Tab {
        id : str,
        owner_agent : str,
        title : str,
        domain_id : str,
        write_scope : str,
        state : str,   // "open" | "focused" | "closed"
    };

    pub struct Window {
        id : str,
        state : str,   // "created" | "focused" | "closed" | "minimized" | "maximized" | "tiled" | "stacked"
        persist : bool,
    };

    // ---- Rules ------------------------------------------------------------
    // No tab without an owning agent.
    pub fn tab_has_owner(t: Tab) -> bool {
        return t.owner_agent != "";
    }

    // No domain word as a tab title.
    pub fn tab_title_is_not_domain(t: Tab) -> bool {
        return t.title != t.domain_id;
    }

    // No unnamed tab.
    pub fn tab_is_named(t: Tab) -> bool {
        return t.title != "";
    }

    // Every tab shows write scope, settings, capabilities, events and tasks.
    pub fn tab_complete(t: Tab) -> bool {
        return t.owner_agent != "" && t.title != "" && t.domain_id != "" && t.write_scope != "";
    }

    // Window state persists across launches.
    pub fn window_persists(w: Window) -> bool {
        return w.persist;
    }

    // Shell is ready only when all five parts exist.
    pub fn shell_ready(s: Shell) -> bool {
        return s.sidebar && s.agent_tabs && s.panels && s.windows && s.team_runtime;
    }

    // ---- Tests ------------------------------------------------------------
    test "every tab has an owning agent, a name, a domain and a write scope" {
        var t : Tab;
        t = Tab {
            id: "tab-1", owner_agent: "agent-a", title: "Agent A",
            domain_id: "orchestration", write_scope: "specs/t27os/shell.t27",
            state: "open",
        };
        assert(tab_has_owner(t));
        assert(tab_title_is_not_domain(t));
        assert(tab_is_named(t));
        assert(tab_complete(t));

        var unnamed : Tab = t;
        unnamed.title = "";
        assert(!tab_is_named(unnamed));

        var no_owner : Tab = t;
        no_owner.owner_agent = "";
        assert(!tab_has_owner(no_owner));
    }

    test "window state persists across launches" {
        assert(window_persists(Window {
            id: "w1", state: "focused", persist: true
        }));
        assert(!window_persists(Window {
            id: "w2", state: "created", persist: false
        }));
    }

    test "shell is ready only when all five parts exist" {
        assert(shell_ready(Shell {
            sidebar: true, agent_tabs: true, panels: true, windows: true,
            team_runtime: true,
        }));
        assert(!shell_ready(Shell {
            sidebar: true, agent_tabs: true, panels: true, windows: true,
            team_runtime: false,
        }));
    }

    invariant tabs_have_owners {
        assert tab_has_owner(Tab {
            id: "t", owner_agent: "a", title: "x", domain_id: "d",
            write_scope: "s", state: "open",
        });
    }

    invariant shell_not_ready_without_team_runtime {
        assert !shell_ready(Shell {
            sidebar: true, agent_tabs: true, panels: true, windows: true,
            team_runtime: false,
        });
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
