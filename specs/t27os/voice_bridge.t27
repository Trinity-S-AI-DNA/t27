use t27os::call_h264::vp_rate;
use t27os::call_session::CS_PEER_V6;
use t27os::call_session::VX_DEC_NO;
use t27os::call_session::LG_BAD;
// SPDX-License-Identifier: Apache-2.0
// Scalar ABI for the existing encrypted, consent-gated AudioQueue session.
use t27os::call_session::CS_LEN;
use t27os::call_session::CS_AUDIO_DEV;
use t27os::call_session::CS_AUDIO_TEST;
use t27os::call_session::cs_open;
use t27os::call_session::cs_call;
use t27os::call_session::cs_poll;
use t27os::call_session::cs_state;
use t27os::call_session::cs_answer;
use t27os::call_session::cs_decline;
use t27os::call_session::cs_confirm;
use t27os::call_session::cs_hangup;
use t27os::call_session::cs_dismiss;
use t27os::call_session::cs_mute;
use t27os::call_session::cs_code;
use t27os::call_session::cs_stat;
use t27os::call_session::cs_reason;
use t27os::call_session::cs_close;
fn vd_alloc(n: u64) -> u64 { return @extern("malloc"); }
fn vd_free(p: u64) -> void { @extern("free"); }
pub const VDView = struct { bytes: []u8, };
fn vd_view_set(dst: VDView, src: [2]u64, n: u64) -> u64 { return @extern("memmove"); }
fn vd_view(context: u64) -> VDView {
    var view : VDView = undefined;
    var words : [2]u64 = undefined; words[0] = context; words[1] = CS_LEN;
    vd_view_set(view, words, 16); return view;
}
// Explicit isolated test fingerprints, not account identities or enrollment.
pub fn vd_open_mode(port: u64, identity: u64, mode: u32) -> u64 {
    const context : u64 = vd_alloc(CS_LEN);
    if (context == 0) { return 0; }
    const view : VDView = vd_view(context);
    var fp : [10]u8 = undefined;
    var i : usize = 0;
    while (i < 10) { fp[i] = @as(u8, @intCast((identity >> @as(u6, @intCast((i % 8)*8))) & 255)); i = i + 1; }
    const opened : bool = cs_open(view.bytes, fp[0..10], 0, port, mode);
    if (!opened) { vd_free(context); return 0; }
    return context;
}
pub fn vd_dial(context: u64, ip: u64, port: u64, identity: u64) -> bool {
    if (context == 0) { return false; }
    const view : VDView = vd_view(context);
    var fp : [10]u8 = undefined;
    var i : usize = 0;
    while (i < 10) { fp[i] = @as(u8, @intCast((identity >> @as(u6, @intCast((i % 8)*8))) & 255)); i = i + 1; }
    return cs_call(view.bytes, ip, port, fp[0..10]);
}
pub fn vd_tick(context: u64) -> u32 {
    if (context == 0) { return 0; } const view : VDView = vd_view(context); return cs_poll(view.bytes); }
pub fn vd_state(context: u64) -> u32 {
    if (context == 0) { return 0; } const view : VDView = vd_view(context); return cs_state(view.bytes); }
pub fn vd_action(context: u64, action: u32) -> bool {
    if (context == 0) { return false; }
    const view : VDView = vd_view(context);
    if (action == 1) { return cs_answer(view.bytes); }
    if (action == 2) { return cs_decline(view.bytes); }
    if (action == 3) { return cs_confirm(view.bytes, true); }
    if (action == 4) { return cs_confirm(view.bytes, false); }
    if (action == 5) { return cs_hangup(view.bytes); }
    if (action == 6) { return cs_mute(view.bytes, true); }
    if (action == 7) { return cs_mute(view.bytes, false); }
    if (action == 8) { return cs_dismiss(view.bytes); }
    return false;
}
pub fn vd_code(context: u64) -> u64 {
    if (context == 0) { return 0; }
    const view : VDView = vd_view(context);
    var code : [6]u8 = undefined;
    if (!cs_code(view.bytes, code[0..6])) { return 0; }
    var value : u64 = 1; var i : usize = 0;
    while (i < 6) { value = value * 256 + code[i]; i = i + 1; }
    return value;
}
pub fn vd_stat(context: u64, k: u32) -> u64 {
    if (context == 0) { return 0; } const view : VDView = vd_view(context); return cs_stat(view.bytes, k); }
pub fn vd_reason(context: u64) -> u32 {
    if (context == 0) { return 0; } const view : VDView = vd_view(context); return cs_reason(view.bytes); }
pub fn vd_close(context: u64) -> void { if (context != 0) { const view : VDView = vd_view(context); cs_close(view.bytes); vd_free(context); } }
test action_values_are_bounded { assert vd_action(0, 0) == false; assert vd_action(0, 9) == false; }

use t27os::call_session::cs_peer_ep;
use t27os::call_session::cs_peer;
use t27os::call_ip6::ip6_mapped;
use t27os::call_ip6::ip6_v4of;
// Only a routing hint until explicit compare-code succeeds; not identity proof.
pub fn vd_peer4(context: u64) -> u64 {
    if (context == 0) { return 0; }
    const view : VDView = vd_view(context); var ep : [18]u8 = undefined;
    if (!cs_peer_ep(view.bytes, ep[0..18]) or !ip6_mapped(ep[0..18])) { return 0; }
    return ip6_v4of(ep[0..18]);
}

pub fn vd_peer_number(context: u64) -> u64 {
    if (context == 0) { return 0; } const view : VDView = vd_view(context); var fp : [10]u8 = undefined;
    cs_peer(view.bytes, fp[0..10]); var n : u64 = 0; var i : usize = 0;
    while (i < 8) { n = n | (@as(u64, fp[i]) << @as(u6,@intCast(i*8))); i = i + 1; } return n;
}

pub fn vd_open(port: u64, identity: u64, synthetic: bool) -> u64 { return vd_open_mode(port, identity, if (synthetic) CS_AUDIO_TEST else CS_AUDIO_DEV); }
