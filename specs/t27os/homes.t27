    42, 43, 44, 45, 194, 191, 46, 47, 48, 49, 50, 61, 62, 51, 52, 53, 54, 188, 55, 58, 59, 56, 60, 4, 189, 57, 193,
    70, 71, 72, 76, 89, 82, 77, 69, 88, 78, 90, 83, 79, 73, 84, 68, 75, 85, 74, 80, 86, 92, 93, 63, 64, 65, 67,
];
/// Returned for a widget no lesson opens.
pub const NO_COURSE : u32 = 7;

pub fn course_widget(c: u32, lesson: u32) -> u32 {
    if (c >= COURSE_COUNT or lesson >= LESSONS_PER_COURSE) {
        return WIDGET_COUNT;
    }
    return COURSE_WIDGETS[c * LESSONS_PER_COURSE + lesson];
}

pub fn course_of_widget(i: u32) -> u32 {
    var k : u32 = 0;
    while (k < 189) {
        if (COURSE_WIDGETS[k] == i) { return k / LESSONS_PER_COURSE; }
        k = k + 1;
    }
    return NO_COURSE;
}

pub fn widgets_without_course() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (course_of_widget(i) == NO_COURSE) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

; --- L6. Petals ------------------------------------------------------------------------------------------

pub const PETAL_CHAT : u32 = 2;
pub const HOME_PETAL : [8]u32 = [19, 20, 21, 22, 23, 24, 25, 2];
/// The 27 world names are WORLD_NAMES of t27f::petal_menu (the single definition): CHAT at index 2, the seven
/// product homes at 19..25 where REELS .. COMMUNITY stood, ABOUT at 26. The tests below pin it against HOME_PETAL.

pub fn petal_of_home(h: u32) -> u32 {
    if (home_ok(h) == false) {
        return PETAL_NONE;
    }
    return HOME_PETAL[h];
}

pub fn home_of_petal(p: u32) -> u32 {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        if (HOME_PETAL[h] == p) { return h; }
        h = h + 1;
    }
    return HOME_COUNT;
}

; --- L7. The list of a home tab --------------------------------------------------------------------------
; Owner, 2026-10-20: ugly design, no limit of cells, make everything in the style of the chat, bold headings
; like the course pages. A home tab is a scrolling list under a big title, and it lists EVERYTHING: every
; agent letter of the home, every named agent, every widget group (the runs of RUN_START), and for t27u every
; course. Item i of home h has a kind (what to draw) and an argument (which agent, group or course). The
; heights are fixed per kind, so the height of the whole page is a sum over the tables below and never typed.
; Counts are measured from the tables above, never typed. homes.t27 holds indices and anchors, not the 195
; widget ids: those stay in the gallery of gHashTag/trinity.

pub const IK_NONE : u32 = 0;
pub const IK_H_AGENTS : u32 = 1;
pub const IK_AGENT : u32 = 2;
pub const IK_NAMED : u32 = 3;
pub const IK_H_WIDGETS : u32 = 4;
pub const IK_RUN : u32 = 5;
pub const IK_NO_WIDGETS : u32 = 6;
pub const IK_H_COURSES : u32 = 7;
pub const IK_COURSE : u32 = 8;

/// Points above the first item: the kicker, the title, the lead (two lines), the law and the runner.
pub const HEAD_H : f64 = 214.0;
/// Points below the last item.
pub const END_PAD : f64 = 56.0;
pub const H2_H : f64 = 64.0;
pub const AGENT_ITEM_H : f64 = 56.0;
pub const RUN_ITEM_H : f64 = 56.0;
pub const EMPTY_ITEM_H : f64 = 44.0;
pub const COURSE_ITEM_H : f64 = 84.0;

pub fn runs_in(h: u32) -> u32 {
    var n : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        if (RUN_HOME[r] == h) { n = n + 1; }
        r = r + 1;
    }
    return n;
}

/// The run index of the n-th run of home h, RUN_COUNT when there is none.
pub fn nth_run(h: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        if (RUN_HOME[r] == h) {
            if (seen == n) { return r; }
            seen = seen + 1;
        }
        r = r + 1;
    }
    return RUN_COUNT;
}

/// How many widgets run r holds.
pub fn run_size(r: u32) -> u32 {
    if (r >= RUN_COUNT) { return 0; }
    if (r + 1 == RUN_COUNT) { return WIDGET_COUNT - RUN_START[r]; }
    return RUN_START[r + 1] - RUN_START[r];
}

/// The ordinal (1..27) of the n-th letter agent of home h, 0 when there is none.
pub fn nth_agent(h: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var k : u32 = 0;
    while (k < AGENT_COUNT) {
        if (AGENT_HOME[k] == h) {
            if (seen == n) { return k + 1; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0;
}

/// The index into NAMED_AGENTS of the n-th named agent of home h, NAMED_COUNT when there is none.
pub fn nth_named(h: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var k : u32 = 0;
    while (k < NAMED_COUNT) {
        if (NAMED_HOME[k] == h) {
            if (seen == n) { return k; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return NAMED_COUNT;
}

pub fn courses_in(h: u32) -> u32 {
    if (h == H_T27U) { return COURSE_COUNT; }
    return 0;
}

/// How many lessons of course c open a widget that is in the gallery.
pub fn course_lesson_widgets(c: u32) -> u32 {
    var n : u32 = 0;
    var l : u32 = 0;
    while (l < LESSONS_PER_COURSE) {
        if (course_widget(c, l) < WIDGET_COUNT) { n = n + 1; }
        l = l + 1;
    }
    return n;
}

/// Rows in the WIDGETS section: one per group, or one row saying there are none.
pub fn widget_rows(h: u32) -> u32 {
    const r : u32 = runs_in(h);
    if (r == 0) { return 1; }
    return r;
}

pub fn item_count(h: u32) -> u32 {
    if (home_ok(h) == false) { return 0; }
    var n : u32 = 1 + agents_in(h) + named_in(h) + 1 + widget_rows(h);
    if (courses_in(h) > 0) { n = n + 1 + courses_in(h); }
    return n;
}

/// Item i of home h as kind * 256 + argument: the agent ordinal, the NAMED index, the run index or the course
/// index; IK_NONE past the end.
fn item_pos(h: u32, i: u32) -> u32 {
    if (i >= item_count(h)) { return 0; }
    var j : u32 = i;
    if (j == 0) { return IK_H_AGENTS * 256; }
    j = j - 1;
    const na : u32 = agents_in(h);
    if (j < na) { return IK_AGENT * 256 + nth_agent(h, j); }
    j = j - na;
    const nn : u32 = named_in(h);
    if (j < nn) { return IK_NAMED * 256 + nth_named(h, j); }
    j = j - nn;
    if (j == 0) { return IK_H_WIDGETS * 256; }
    j = j - 1;
    const wr : u32 = widget_rows(h);
    if (j < wr) {
        if (runs_in(h) == 0) { return IK_NO_WIDGETS * 256; }
        return IK_RUN * 256 + nth_run(h, j);
    }
    j = j - wr;
    if (j == 0) { return IK_H_COURSES * 256; }
    return IK_COURSE * 256 + (j - 1);
}

pub fn item_kind(h: u32, i: u32) -> u32 { return item_pos(h, i) / 256; }
pub fn item_arg(h: u32, i: u32) -> u32 { return item_pos(h, i) % 256; }

pub fn kind_h(kind: u32) -> f64 {
    if (kind == IK_AGENT or kind == IK_NAMED) { return AGENT_ITEM_H; }
    if (kind == IK_RUN) { return RUN_ITEM_H; }
    if (kind == IK_NO_WIDGETS) { return EMPTY_ITEM_H; }
    if (kind == IK_COURSE) { return COURSE_ITEM_H; }
    if (kind == IK_NONE) { return 0.0; }
    return H2_H;
}

/// Top of item i, from the top of the page.
pub fn item_top(h: u32, i: u32) -> f64 {
    var y : f64 = HEAD_H;
    var k : u32 = 0;
    while (k < i and k < item_count(h)) {
        y = y + kind_h(item_kind(h, k));
        k = k + 1;
    }
    return y;
}

/// The height of the whole page of home h.
pub fn content_h(h: u32) -> f64 {
    if (home_ok(h) == false) { return 0.0; }
    return item_top(h, item_count(h)) + END_PAD;
}

/// The largest scroll offset, in whole points, for a view view_h tall.
pub fn scroll_max(h: u32, view_h: f64) -> u32 {
    const over : f64 = content_h(h) - view_h;
    if (over <= 0.0) { return 0; }
    return @as(u32, @intFromFloat(over)) + 1;
}

/// A scroll offset moved by dy points, held between 0 and the end of the page.
pub fn scroll_clamp(off: u32, dy: i64, h: u32, view_h: f64) -> u32 {
    var v : i64 = @as(i64, off) + dy;
    if (v < 0) { v = 0; }
    const m : i64 = @as(i64, scroll_max(h, view_h));
    if (v > m) { v = m; }
    return @as(u32, @intCast(v));
}

/// The item under the page point y (from the top of the page), item_count when it is none.
pub fn item_at(h: u32, y: f64) -> u32 {
    const n : u32 = item_count(h);
    var k : u32 = 0;
    while (k < n) {
        const t : f64 = item_top(h, k);
        if (y >= t and y < t + kind_h(item_kind(h, k))) { return k; }
        k = k + 1;
    }
    return n;
}

/// "1 widget", "27 lessons": the count, a space, then the singular or the plural word.
fn put_counted(out: []u8, at: usize, n: u32, one: []const u8, many: []const u8) -> usize {
    const c : usize = put_dec(out, at, @as(u64, n));
    const sp : usize = put_bytes(out, c, " ");
    if (n == 1) { return put_bytes(out, sp, one); }
    return put_bytes(out, sp, many);
}

/// The name part of an AGENT_NOTES line: the text after "<letter> " up to the colon.
fn put_note_name(out: []u8, at: usize, note: []const u8) -> usize {
    var i : usize = 0;
    while (i < note.len and note[i] != 32) { i = i + 1; }
    i = i + 1;
    var n : usize = at;
    while (i < note.len and note[i] != 58) {
        out[n] = note[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// The text of an AGENT_NOTES line after the colon and its space: where the agent lives and why.
fn put_note_rest(out: []u8, at: usize, note: []const u8) -> usize {
    var i : usize = 0;
    while (i < note.len and note[i] != 58) { i = i + 1; }
    i = i + 1;
    while (i < note.len and note[i] == 32) { i = i + 1; }
    var n : usize = at;
    while (i < note.len) {
        out[n] = note[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// ASCII upper case of s.
fn put_upper(out: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        var ch : u8 = s[i];
        if (ch >= 97 and ch <= 122) { ch = ch - 32; }
        out[at + i] = ch;
        i = i + 1;
    }
    return at + s.len;
}

/// The big title of the page: the home name in capitals, "T27C COMPILER".
pub fn home_title(h: u32, out: []u8) -> usize {
    if (home_ok(h) == false) { return 0; }
    return put_upper(out, 0, HOME_NAMES[h]);
}

/// The small line over the title: "HOME 3 OF 8".
pub fn home_kicker(h: u32, out: []u8) -> usize {
    if (home_ok(h) == false) { return 0; }
    var n : usize = put_bytes(out, 0, "HOME ");
    n = put_dec(out, n, @as(u64, h + 1));
    n = put_bytes(out, n, " OF ");
    return put_dec(out, n, @as(u64, HOME_COUNT));
}

/// The second line of a home's row in the sidebar: "13 agents, 127 widgets", with the courses for t27u.
pub fn home_line(h: u32, out: []u8) -> usize {
    if (home_ok(h) == false) { return 0; }
    var n : usize = put_counted(out, 0, agents_in(h) + named_in(h), "agent", "agents");
    n = put_bytes(out, n, ", ");
    n = put_counted(out, n, widgets_in(h), "widget", "widgets");
    if (courses_in(h) > 0) {
        n = put_bytes(out, n, ", ");
        n = put_counted(out, n, courses_in(h), "course", "courses");
    }
    return n;
}

/// The count at the right end of a home's row in the sidebar: its widgets.
pub fn home_count_text(h: u32, out: []u8) -> usize {
    if (home_ok(h) == false) { return 0; }
    return put_dec(out, 0, @as(u64, widgets_in(h)));
}

/// The badge of item i (a letter, "@", a count, a number); empty for a heading.
pub fn item_badge(h: u32, i: u32, out: []u8) -> usize {
    const kind : u32 = item_kind(h, i);
    const arg : u32 = item_arg(h, i);
    if (kind == IK_AGENT) { return put_bytes(out, 0, AGENT_LETTERS[arg - 1]); }
    if (kind == IK_NAMED) { return put_bytes(out, 0, "@"); }
    if (kind == IK_RUN) { return put_dec(out, 0, @as(u64, run_size(arg))); }
    if (kind == IK_COURSE) { return put_dec(out, 0, @as(u64, arg + 1)); }
    return 0;
}

/// The first line of item i: a heading's word, or the row's name.
pub fn item_title(h: u32, i: u32, out: []u8) -> usize {
    const kind : u32 = item_kind(h, i);
    const arg : u32 = item_arg(h, i);
    if (kind == IK_H_AGENTS) { return put_bytes(out, 0, "AGENTS"); }
    if (kind == IK_H_WIDGETS) { return put_bytes(out, 0, "WIDGETS"); }
    if (kind == IK_H_COURSES) { return put_bytes(out, 0, "COURSES"); }
    if (kind == IK_AGENT) { return put_note_name(out, 0, AGENT_NOTES[arg - 1]); }
    if (kind == IK_NAMED) { return put_bytes(out, 0, NAMED_AGENTS[arg]); }
    if (kind == IK_RUN) {
        const n : usize = put_counted(out, 0, run_size(arg), "widget", "widgets");
        const f : usize = put_bytes(out, n, " from ");
        return put_bytes(out, f, RUN_ANCHOR[arg]);
    }
    if (kind == IK_NO_WIDGETS) { return put_bytes(out, 0, "none in the gallery"); }
    if (kind == IK_COURSE) { return put_bytes(out, 0, COURSE_IDS[arg]); }
    return 0;
}

/// The second line of item i: a heading's total (shown at the right of the heading), or the row's domain.
pub fn item_line(h: u32, i: u32, out: []u8) -> usize {
    const kind : u32 = item_kind(h, i);
    const arg : u32 = item_arg(h, i);
    if (kind == IK_H_AGENTS) {
        var n : usize = put_counted(out, 0, agents_in(h), "letter agent", "letter agents");
        n = put_bytes(out, n, ", ");
        return put_counted(out, n, named_in(h), "named agent", "named agents");
    }
    if (kind == IK_H_WIDGETS) {
        var n : usize = put_counted(out, 0, widgets_in(h), "widget", "widgets");
        n = put_bytes(out, n, " in ");
        return put_counted(out, n, runs_in(h), "group", "groups");
    }
    if (kind == IK_H_COURSES) {
        var n : usize = put_counted(out, 0, COURSE_COUNT, "course", "courses");
        n = put_bytes(out, n, " of ");
        return put_counted(out, n, LESSONS_PER_COURSE, "lesson", "lessons");
    }
    if (kind == IK_AGENT) { return put_note_rest(out, 0, AGENT_NOTES[arg - 1]); }
    if (kind == IK_NAMED) { return put_bytes(out, 0, NAMED_NOTES[arg]); }
    if (kind == IK_RUN) { return put_bytes(out, 0, RUN_NOTES[arg]); }
    if (kind == IK_NO_WIDGETS) { return put_bytes(out, 0, "The gallery holds no page of this home."); }
    if (kind == IK_COURSE) {
        var n : usize = put_counted(out, 0, LESSONS_PER_COURSE, "lesson", "lessons");
        n = put_bytes(out, n, ", ");
        return put_counted(out, n, course_lesson_widgets(arg), "lesson widget", "lesson widgets");
    }
    return 0;
}

/// The third line: only a course has one, its share page under t27.ai and its spec.
pub fn item_note(h: u32, i: u32, out: []u8) -> usize {
    if (item_kind(h, i) == IK_COURSE) {
        const arg : u32 = item_arg(h, i);
        var n : usize = put_bytes(out, 0, "t27.ai/");
        n = put_bytes(out, n, COURSE_SHARE[arg]);
        n = put_bytes(out, n, "   ");
        return put_bytes(out, n, COURSE_SPECS[arg]);
    }
    return 0;
}


; --- Tests -----------------------------------------------------------------------------------------------

test there_are_eight_homes_with_a_full_row_each {
    assert HOME_COUNT == 8;
    assert HOME_IDS[H_T27A] == "t27a";
    assert HOME_IDS[H_T27U] == "t27u";
    assert HOME_IDS[H_QUEEN] == "queen";
    assert HOME_NAMES[H_T27T] == "t27t trainer";
    assert HOME_LAWS[H_T27T] == "specs/t27t/t27t.t27";
    assert HOME_LAWS[H_T27A] == "specs/isa/t27a.t27";
    assert HOME_RUNNERS[H_T27O] == "tri t27o <file.rs> [--oracle] [--check]";
    assert HOME_ROLES[H_T27U] == "The university: 7 courses of 27 lessons, each lesson one working widget.";
}

test every_letter_is_in_exactly_one_home_and_the_counts_add_up {
    assert AGENT_COUNT == 27;
    var total : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        total = total + agents_in(h);
        h = h + 1;
    }
    assert total == 27;
    var k : u32 = 0;
    while (k < AGENT_COUNT) {
        assert AGENT_HOME[k] < HOME_COUNT;
        k = k + 1;
    }
}

test the_agent_counts_per_home_are_pinned {
    assert agents_in(H_T27A) == 1;
    assert agents_in(H_T27B) == 1;
    assert agents_in(H_T27C) == 6;
    assert agents_in(H_T27F) == 1;
    assert agents_in(H_T27O) == 2;
    assert agents_in(H_T27T) == 2;
    assert agents_in(H_T27U) == 1;
    assert agents_in(H_QUEEN) == 13;
}

test the_letters_that_look_like_homes_are_not_confused {
    assert AGENT_LETTERS[1] == "B";
    assert home_of_agent(2) == H_T27C;
    assert AGENT_LETTERS[20] == "U";
    assert home_of_agent(21) == H_QUEEN;
    assert home_of_agent(9) == H_T27A;
    assert home_of_agent(11) == H_T27B;
    assert home_of_agent(8) == H_T27T;
    assert home_of_agent(26) == H_T27U;
    assert home_of_agent(20) == H_QUEEN;
    assert home_of_agent(27) == H_QUEEN;
    assert AGENT_LETTERS[26] == "Ti";
}

test the_ordinals_outside_one_to_27_belong_to_no_home {
    assert home_of_agent(0) == HOME_COUNT;
    assert home_of_agent(28) == HOME_COUNT;
}

test every_named_agent_has_a_home {
    assert NAMED_COUNT == 12;
    var total : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        total = total + named_in(h);
        h = h + 1;
    }
    assert total == 12;
    assert named_in(H_T27C) == 5;
    assert named_in(H_QUEEN) == 7;
    assert home_of_named(9) == H_T27C;
    assert NAMED_AGENTS[9] == "t27c-steward";
    assert home_of_named(10) == H_QUEEN;
    assert home_of_named(12) == HOME_COUNT;
}

test the_runs_are_ordered_and_cover_the_gallery {
    assert RUN_START[0] == 0;
    var r : u32 = 1;
    while (r < RUN_COUNT) {
        assert RUN_START[r] > RUN_START[r - 1];
        assert RUN_HOME[r] != RUN_HOME[r - 1];
        r = r + 1;
    }
    assert RUN_START[RUN_COUNT - 1] < WIDGET_COUNT;
}

test every_widget_has_exactly_one_home {
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        assert home_of_widget(i) < HOME_COUNT;
        i = i + 1;
    }
    var total : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        total = total + widgets_in(h);
        h = h + 1;
    }
    assert total == 195;
}

test the_widget_counts_per_home_are_pinned_and_recomputed {
    assert widgets_in(H_T27A) == 0;
    assert widgets_in(H_T27B) == 0;
    assert widgets_in(H_T27C) == 127;
    assert widgets_in(H_T27F) == 0;
    assert widgets_in(H_T27O) == 0;
    assert widgets_in(H_T27T) == 6;
    assert widgets_in(H_T27U) == 54;
    assert widgets_in(H_QUEEN) == 8;
}

