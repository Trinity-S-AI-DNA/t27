test negative_control_an_index_past_the_gallery_has_no_home {
    assert home_of_widget(195) == HOME_COUNT;
    assert home_of_widget(4294967295) == HOME_COUNT;
    assert home_of_widget(194) != HOME_COUNT;
    assert widgets_in(HOME_COUNT) == 0;
    assert home_ok(HOME_COUNT) == false;
}

test the_seven_courses_have_twenty_seven_lessons_each {
    assert COURSE_COUNT == 7;
    assert LESSONS_PER_COURSE == 27;
    assert COURSE_COUNT * LESSONS_PER_COURSE == 189;
    assert COURSE_IDS[0] == "t27-basics";
    assert COURSE_IDS[3] == "goldenfloat";
    assert COURSE_IDS[6] == "buses-and-peripherals";
    assert COURSE_SHARE[0] == "learn/";
    assert COURSE_SHARE[4] == "learn/verify-hardware/";
    assert COURSE_ROUTES[1] == "course";
    assert COURSE_SPECS[2] == "specs/course/ai-numbers.t27";
}

test the_lesson_widgets_are_in_the_gallery_and_never_repeat {
    var k : u32 = 0;
    while (k < 189) {
        assert COURSE_WIDGETS[k] < WIDGET_COUNT;
        var j : u32 = k + 1;
        while (j < 189) {
            assert COURSE_WIDGETS[k] != COURSE_WIDGETS[j];
            j = j + 1;
        }
        k = k + 1;
    }
}

test the_courses_that_own_their_lesson_widgets_are_in_t27u {
    var l : u32 = 0;
    while (l < LESSONS_PER_COURSE) {
        assert home_of_widget(course_widget(0, l)) == H_T27U;
        assert home_of_widget(course_widget(3, l)) == H_T27U;
        assert course_of_widget(course_widget(0, l)) == 0;
        assert course_of_widget(course_widget(3, l)) == 3;
        l = l + 1;
    }
    assert course_widget(0, 0) == 126;
    assert course_widget(3, 26) == 179;
    assert course_widget(2, 0) == 29;
}

test six_widgets_are_opened_by_no_lesson {
    assert widgets_without_course() == 6;
    assert course_of_widget(187) == NO_COURSE;
    assert course_of_widget(94) == NO_COURSE;
    assert course_of_widget(66) == NO_COURSE;
    assert course_of_widget(0) == 1;
    assert course_of_widget(192) == 1;
    assert course_widget(7, 0) == WIDGET_COUNT;
    assert course_widget(0, 27) == WIDGET_COUNT;
}

test chat_is_the_third_petal_and_the_homes_take_nineteen_to_twenty_five {
    assert PETAL_CHAT == 2;
    assert petal_of_home(H_T27A) == 19;
    assert petal_of_home(H_T27B) == 20;
    assert petal_of_home(H_T27C) == 21;
    assert petal_of_home(H_T27F) == 22;
    assert petal_of_home(H_T27O) == 23;
    assert petal_of_home(H_T27T) == 24;
    assert petal_of_home(H_T27U) == 25;
    assert petal_of_home(H_QUEEN) == PETAL_CHAT;
    assert petal_of_home(HOME_COUNT) == PETAL_NONE;
}

test home_of_petal_inverts_petal_of_home_and_the_rest_have_no_home {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        assert home_of_petal(petal_of_home(h)) == h;
        h = h + 1;
    }
    var n : u32 = 0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        if (home_of_petal(p) < HOME_COUNT) { n = n + 1; }
        p = p + 1;
    }
    assert n == 8;
    assert home_of_petal(26) == HOME_COUNT;
    assert home_of_petal(0) == HOME_COUNT;
    assert home_of_petal(18) == HOME_COUNT;
    assert home_of_petal(27) == HOME_COUNT;
}

test the_product_homes_sit_in_the_third_realm_and_about_stays_last {
    var h : u32 = 0;
    while (h < H_QUEEN) {
        assert HOME_PETAL[h] >= 19;
        assert HOME_PETAL[h] <= 25;
        assert HOME_PETAL[h] / 9 == 2;
        h = h + 1;
    }
    assert home_of_petal(26) != H_T27U;
}

/// Is field `petal` of the comma-separated list `names` exactly `word`? (the tests' reader of WORLD_NAMES)
fn world_is(names: []const u8, petal: u32, word: []const u8) -> bool {
    var b : [32]u8 = undefined;
    const n : usize = csv_field(names, petal, b[0..32]);
    if (n != word.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (b[i] != word[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_world_names_of_petal_menu_put_chat_third_and_name_every_home {
    assert world_is(WORLD_NAMES, PETAL_CHAT, "CHAT");
    assert world_is(WORLD_NAMES, 0, "LOGS");
    assert world_is(WORLD_NAMES, 19, "T27A");
    assert world_is(WORLD_NAMES, 20, "T27B");
    assert world_is(WORLD_NAMES, 21, "T27C");
    assert world_is(WORLD_NAMES, 22, "T27F");
    assert world_is(WORLD_NAMES, 23, "T27O");
    assert world_is(WORLD_NAMES, 24, "T27T");
    assert world_is(WORLD_NAMES, 25, "T27U");
    assert world_is(WORLD_NAMES, 26, "ABOUT");
    assert world_is(WORLD_NAMES, 16, "DePIN NODE");
    assert world_is(WORLD_NAMES, 1, "CODE");
    assert world_is(WORLD_NAMES, 18, "DOCS");
    assert world_is(WORLD_NAMES, 27, "ABOUT") == false;
    assert world_is(WORLD_NAMES, 2, "LOGS") == false;
    assert world_is(WORLD_NAMES, 0, "CHAT") == false;
    assert world_is(WORLD_NAMES, 19, "REELS") == false;
}

fn same(out: []const u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (out[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_run_walk_covers_the_gallery {
    var total : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        total = total + run_size(r);
        r = r + 1;
    }
    assert total == WIDGET_COUNT;
    assert run_size(RUN_COUNT) == 0;
    assert runs_in(H_T27C) == 6;
    assert runs_in(H_T27T) == 3;
    assert runs_in(H_T27U) == 1;
    assert runs_in(H_QUEEN) == 3;
    assert runs_in(H_T27A) == 0;
    assert nth_run(H_T27C, 0) == 0;
    assert nth_run(H_T27C, 5) == 11;
    assert nth_run(H_T27C, 6) == RUN_COUNT;
    assert nth_run(H_T27U, 0) == 6;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        var w : u32 = 0;
        var n : u32 = 0;
        while (n < runs_in(h)) {
            w = w + run_size(nth_run(h, n));
            n = n + 1;
        }
        assert w == widgets_in(h);
        h = h + 1;
    }
}

test every_agent_group_and_course_of_every_home_is_listed {
    var agents : u32 = 0;
    var named : u32 = 0;
    var runs : u32 = 0;
    var courses : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        var a : u32 = 0;
        var nm : u32 = 0;
        var r : u32 = 0;
        var c : u32 = 0;
        var w : u32 = 0;
        var heads : u32 = 0;
        var none : u32 = 0;
        var i : u32 = 0;
        while (i < item_count(h)) {
            const k : u32 = item_kind(h, i);
            assert k != IK_NONE;
            if (k == IK_AGENT) { a = a + 1; }
            if (k == IK_NAMED) { nm = nm + 1; }
            if (k == IK_RUN) { r = r + 1; w = w + run_size(item_arg(h, i)); }
            if (k == IK_COURSE) { c = c + 1; }
            if (k == IK_H_AGENTS or k == IK_H_WIDGETS or k == IK_H_COURSES) { heads = heads + 1; }
            if (k == IK_NO_WIDGETS) { none = none + 1; }
            i = i + 1;
        }
        assert a == agents_in(h);
        assert nm == named_in(h);
        assert r == runs_in(h);
        assert c == courses_in(h);
        assert w == widgets_in(h);
        assert none + r == widget_rows(h);
        assert item_kind(h, 0) == IK_H_AGENTS;
        if (h == H_T27U) { assert heads == 3; } else { assert heads == 2; }
        agents = agents + a;
        named = named + nm;
        runs = runs + r;
        courses = courses + c;
        h = h + 1;
    }
    assert agents == AGENT_COUNT;
    assert named == NAMED_COUNT;
    assert runs == RUN_COUNT;
    assert courses == COURSE_COUNT;
    assert item_count(H_T27A) == 4;
    assert item_count(H_T27C) == 19;
    assert item_count(H_T27U) == 12;
    assert item_count(H_QUEEN) == 25;
    assert item_count(HOME_COUNT) == 0;
    assert item_kind(H_T27A, 3) == IK_NO_WIDGETS;
    assert item_kind(H_T27A, 4) == IK_NONE;
    assert item_kind(H_T27U, 4) == IK_H_COURSES;
    assert item_kind(H_T27U, 11) == IK_COURSE;
    assert item_arg(H_T27U, 11) == 6;
}

test every_course_opens_twenty_seven_lesson_widgets_in_the_gallery {
    var c : u32 = 0;
    while (c < COURSE_COUNT) {
        assert course_lesson_widgets(c) == LESSONS_PER_COURSE;
        c = c + 1;
    }
}

test the_page_height_is_the_sum_of_its_items_and_no_item_overlaps_another {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        var i : u32 = 0;
        while (i < item_count(h)) {
            assert item_top(h, i) + kind_h(item_kind(h, i)) == item_top(h, i + 1);
            assert kind_h(item_kind(h, i)) > 0.0;
            assert item_at(h, item_top(h, i)) == i;
            assert item_at(h, item_top(h, i + 1) - 0.5) == i;
            i = i + 1;
        }
        assert item_top(h, 0) == HEAD_H;
        assert content_h(h) == item_top(h, item_count(h)) + END_PAD;
        assert item_at(h, HEAD_H - 1.0) == item_count(h);
        assert item_at(h, content_h(h)) == item_count(h);
        h = h + 1;
    }
    assert content_h(H_T27A) == 498.0;
    assert content_h(H_T27C) == 1350.0;
    assert content_h(H_T27U) == 1162.0;
    assert content_h(H_QUEEN) == 1686.0;
    assert content_h(HOME_COUNT) == 0.0;
}

test the_scroll_is_held_between_the_top_and_the_end_of_the_page {
    assert scroll_max(H_T27A, 1000.0) == 0;
    assert scroll_max(H_T27C, 400.0) == 951;
    assert scroll_clamp(0, -50, H_T27C, 400.0) == 0;
    assert scroll_clamp(10, 25, H_T27C, 400.0) == 35;
    assert scroll_clamp(10, -4, H_T27C, 400.0) == 6;
    assert scroll_clamp(900, 100000, H_T27C, 400.0) == 951;
    assert scroll_clamp(5, 100, H_T27A, 1000.0) == 0;
    assert scroll_clamp(5, 100, HOME_COUNT, 400.0) == 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        assert scroll_clamp(0, 1000000, h, 460.0) == scroll_max(h, 460.0);
        assert scroll_max(h, 460.0) + 460 >= @as(u32, @intFromFloat(content_h(h)));
        h = h + 1;
    }
}

test the_headings_and_rows_read_with_the_real_counts {
    var b : [256]u8 = undefined;
    var n : usize = home_title(H_T27C, b[0..256]);
    assert same(b[0..256], n, "T27C COMPILER");
    n = home_title(H_T27U, b[0..256]);
    assert same(b[0..256], n, "T27U UNIVERSITY");
    n = home_kicker(H_T27C, b[0..256]);
    assert same(b[0..256], n, "HOME 3 OF 8");
    n = home_line(H_T27C, b[0..256]);
    assert same(b[0..256], n, "11 agents, 127 widgets");
    n = home_line(H_T27U, b[0..256]);
    assert same(b[0..256], n, "1 agent, 54 widgets, 7 courses");
    n = home_line(H_T27A, b[0..256]);
    assert same(b[0..256], n, "1 agent, 0 widgets");
    n = home_count_text(H_T27C, b[0..256]);
    assert same(b[0..256], n, "127");
    n = item_title(H_T27C, 0, b[0..256]);
    assert same(b[0..256], n, "AGENTS");
    n = item_line(H_T27C, 0, b[0..256]);
    assert same(b[0..256], n, "6 letter agents, 5 named agents");
    n = item_badge(H_T27C, 1, b[0..256]);
    assert same(b[0..256], n, "B");
    n = item_title(H_T27C, 1, b[0..256]);
    assert same(b[0..256], n, "Build");
    n = item_title(H_T27C, 7, b[0..256]);
    assert same(b[0..256], n, "agent-c-compiler");
    n = item_badge(H_T27C, 7, b[0..256]);
    assert same(b[0..256], n, "@");
    n = item_title(H_T27C, 12, b[0..256]);
    assert same(b[0..256], n, "WIDGETS");
    n = item_line(H_T27C, 12, b[0..256]);
    assert same(b[0..256], n, "127 widgets in 6 groups");
    n = item_title(H_T27C, 13, b[0..256]);
    assert same(b[0..256], n, "12 widgets from x7-board");
    n = item_badge(H_T27C, 13, b[0..256]);
    assert same(b[0..256], n, "12");
    n = item_line(H_T27A, 2, b[0..256]);
    assert same(b[0..256], n, "0 widgets in 0 groups");
    n = item_title(H_T27A, 3, b[0..256]);
    assert same(b[0..256], n, "none in the gallery");
    n = item_title(H_T27U, 3, b[0..256]);
    assert same(b[0..256], n, "54 widgets from basics-what-a-spec-is");
    n = item_line(H_T27U, 4, b[0..256]);
    assert same(b[0..256], n, "7 courses of 27 lessons");
    n = item_title(H_T27U, 5, b[0..256]);
    assert same(b[0..256], n, "t27-basics");
    n = item_line(H_T27U, 5, b[0..256]);
    assert same(b[0..256], n, "27 lessons, 27 lesson widgets");
    n = item_note(H_T27U, 5, b[0..256]);
    assert same(b[0..256], n, "t27.ai/learn/   specs/course/t27-basics.t27");
    n = item_title(H_T27U, 11, b[0..256]);
    assert same(b[0..256], n, "buses-and-peripherals");
    n = item_badge(H_T27U, 11, b[0..256]);
    assert same(b[0..256], n, "7");
    n = item_note(H_T27U, 1, b[0..256]);
    assert n == 0;
}

test every_line_of_every_home_fits_its_buffer {
    var b : [256]u8 = undefined;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        var i : u32 = 0;
        while (i < item_count(h)) {
            assert item_title(h, i, b[0..256]) < 200;
            assert item_title(h, i, b[0..256]) > 0;
            assert item_line(h, i, b[0..256]) < 200;
            assert item_line(h, i, b[0..256]) > 0;
            assert item_note(h, i, b[0..256]) < 200;
            assert item_badge(h, i, b[0..256]) < 8;
            i = i + 1;
        }
        h = h + 1;
    }
}

test negative_control_past_the_end_there_is_no_text {
    var b : [256]u8 = undefined;
    assert item_title(H_T27A, 9, b[0..256]) == 0;
    assert item_line(H_T27A, 9, b[0..256]) == 0;
    assert item_note(H_T27A, 9, b[0..256]) == 0;
    assert item_badge(H_T27A, 9, b[0..256]) == 0;
    assert home_title(HOME_COUNT, b[0..256]) == 0;
    assert home_line(HOME_COUNT, b[0..256]) == 0;
}
