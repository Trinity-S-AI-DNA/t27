pub fn home_of_agent(ordinal: u32) -> u32 {
    if (ordinal < 1 or ordinal > AGENT_COUNT) {
        return HOME_COUNT;
    }
    return AGENT_HOME[ordinal - 1];
}

pub fn agents_in(h: u32) -> u32 {
    var n : u32 = 0;
    var k : u32 = 0;
    while (k < AGENT_COUNT) {
        if (AGENT_HOME[k] == h) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

