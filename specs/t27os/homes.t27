; SHARE is the share page under t27.ai: learn/ for the first course, learn/<id>/ for the rest.

pub const COURSE_COUNT : u32 = 7;
pub const LESSONS_PER_COURSE : u32 = 27;
pub const COURSE_IDS : [7]str = ["t27-basics", "course", "ai-numbers", "goldenfloat", "verify-hardware", "clocks-and-cdc", "buses-and-peripherals"];
pub const COURSE_ROUTES : [7]str = ["t27-basics", "course", "ai-numbers", "goldenfloat", "verify-hardware", "clocks-and-cdc", "buses-and-peripherals"];
pub const COURSE_SHARE : [7]str = ["learn/", "learn/course/", "learn/ai-numbers/", "learn/goldenfloat/", "learn/verify-hardware/", "learn/clocks-and-cdc/", "learn/buses-and-peripherals/"];
