    42, 43, 44, 45, 194, 191, 46, 47, 48, 49, 50, 61, 62, 51, 52, 53, 54, 188, 55, 58, 59, 56, 60, 4, 189, 57, 193,
    70, 71, 72, 76, 89, 82, 77, 69, 88, 78, 90, 83, 79, 73, 84, 68, 75, 85, 74, 80, 86, 92, 93, 63, 64, 65, 67,
];
/// Returned for a widget no lesson opens.
pub const NO_COURSE : u32 = 7;

pub fn course_widget(c: u32, lesson: u32) -> u32 {
    if (c >= COURSE_COUNT or lesson >= LESSONS_PER_COURSE) {
        return WIDGET_COUNT;
    }
    return COURSE_WIDGETS[c * LESSONS_PER_COURSE + lesson];
}

pub fn course_of_widget(i: u32) -> u32 {
    var k : u32 = 0;
    while (k < 189) {
        if (COURSE_WIDGETS[k] == i) { return k / LESSONS_PER_COURSE; }
        k = k + 1;
    }
    return NO_COURSE;
}

pub fn widgets_without_course() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (course_of_widget(i) == NO_COURSE) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

; --- L6. Petals ------------------------------------------------------------------------------------------

pub const PETAL_CHAT : u32 = 2;
pub const HOME_PETAL : [8]u32 = [19, 20, 21, 22, 23, 24, 25, 2];
/// The 27 world names are WORLD_NAMES of t27f::petal_menu (the single definition): CHAT at index 2, the seven
/// product homes at 19..25 where REELS .. COMMUNITY stood, ABOUT at 26. The tests below pin it against HOME_PETAL.

pub fn petal_of_home(h: u32) -> u32 {
    if (home_ok(h) == false) {
        return PETAL_NONE;
    }
    return HOME_PETAL[h];
}

pub fn home_of_petal(p: u32) -> u32 {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        if (HOME_PETAL[h] == p) { return h; }
        h = h + 1;
    }
    return HOME_COUNT;
}

; --- L7. The cards of a home tab -------------------------------------------------------------------------
; A home tab is a 3 x 3 grid of cards (petal_menu CARD_SLOTS). The order is fixed: the agents that live in
; the home (letter + name; four cards at most, the fourth reads "+N agents" when there are more), then one
; card with the home's widget total, then the widget groups (the runs of RUN_START that belong to the home;
; four at most, the last "+N groups" when there are more), then, for t27u only, the seven courses. A home
; with fewer than 9 cards leaves the rest empty. Counts are measured from the tables above, never typed.

pub const HOME_CARD_SLOTS : u32 = 9;
pub const MAX_AGENT_CARDS : u32 = 4;
pub const MAX_GROUP_CARDS : u32 = 4;

pub const CK_NONE : u32 = 0;
pub const CK_AGENT : u32 = 1;
pub const CK_AGENT_MORE : u32 = 2;
pub const CK_WIDGETS : u32 = 3;
pub const CK_GROUP : u32 = 4;
pub const CK_GROUP_MORE : u32 = 5;
pub const CK_COURSE : u32 = 6;

pub fn runs_in(h: u32) -> u32 {
    var n : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        if (RUN_HOME[r] == h) { n = n + 1; }
        r = r + 1;
    }
    return n;
}

/// The run index of the n-th run of home h, RUN_COUNT when there is none.
pub fn nth_run(h: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        if (RUN_HOME[r] == h) {
            if (seen == n) { return r; }
            seen = seen + 1;
        }
        r = r + 1;
    }
    return RUN_COUNT;
}

/// How many widgets run r holds.
pub fn run_size(r: u32) -> u32 {
    if (r >= RUN_COUNT) { return 0; }
    if (r + 1 == RUN_COUNT) { return WIDGET_COUNT - RUN_START[r]; }
    return RUN_START[r + 1] - RUN_START[r];
}

/// The ordinal (1..27) of the n-th letter agent of home h, 0 when there is none.
pub fn nth_agent(h: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var k : u32 = 0;
    while (k < AGENT_COUNT) {
        if (AGENT_HOME[k] == h) {
            if (seen == n) { return k + 1; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 0;
}

pub fn agent_cards(h: u32) -> u32 {
    const a : u32 = agents_in(h);
    if (a > MAX_AGENT_CARDS) { return MAX_AGENT_CARDS; }
    return a;
}

pub fn group_cards(h: u32) -> u32 {
    if (h == H_T27U) { return 0; }
    const g : u32 = runs_in(h);
    if (g > MAX_GROUP_CARDS) { return MAX_GROUP_CARDS; }
    return g;
}

pub fn home_cards(h: u32) -> u32 {
    if (home_ok(h) == false) { return 0; }
    var n : u32 = agent_cards(h) + 1 + group_cards(h);
    if (h == H_T27U) { n = n + COURSE_COUNT; }
    return n;
}

pub fn card_kind(h: u32, k: u32) -> u32 {
    if (k >= home_cards(h)) { return CK_NONE; }
    const na : u32 = agent_cards(h);
    if (k < na) {
        if (agents_in(h) > MAX_AGENT_CARDS and k + 1 == na) { return CK_AGENT_MORE; }
        return CK_AGENT;
    }
    if (k == na) { return CK_WIDGETS; }
    const g : u32 = group_cards(h);
    if (k < na + 1 + g) {
        if (runs_in(h) > MAX_GROUP_CARDS and k == na + g) { return CK_GROUP_MORE; }
        return CK_GROUP;
    }
    return CK_COURSE;
}

/// What a card points at: the agent ordinal, the number of agents or groups folded into "+N", the widget
/// total, the run index, or the course index.
pub fn card_arg(h: u32, k: u32) -> u32 {
    const kind : u32 = card_kind(h, k);
    const na : u32 = agent_cards(h);
    const g : u32 = group_cards(h);
    if (kind == CK_AGENT) { return nth_agent(h, k); }
    if (kind == CK_AGENT_MORE) { return agents_in(h) - (na - 1); }
    if (kind == CK_WIDGETS) { return widgets_in(h); }
    if (kind == CK_GROUP) { return nth_run(h, k - na - 1); }
    if (kind == CK_GROUP_MORE) { return runs_in(h) - (g - 1); }
    if (kind == CK_COURSE) { return k - na - 1 - g; }
    return 0;
}

/// "1 widget", "27 lessons": the count, a space, then the singular or the plural word.
fn put_counted(out: []u8, at: usize, n: u32, one: []const u8, many: []const u8) -> usize {
    const c : usize = put_dec(out, at, @as(u64, n));
    const sp : usize = put_bytes(out, c, " ");
    if (n == 1) { return put_bytes(out, sp, one); }
    return put_bytes(out, sp, many);
}

/// The name part of an AGENT_NOTES line: the text after "<letter> " up to the colon.
fn put_note_name(out: []u8, at: usize, note: []const u8) -> usize {
    var i : usize = 0;
    while (i < note.len and note[i] != 32) { i = i + 1; }
    i = i + 1;
    var n : usize = at;
    while (i < note.len and note[i] != 58) {
        out[n] = note[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// The first line of card k of home h, as bytes in out; returns the length (0 for an empty slot).
pub fn card_title(h: u32, k: u32, out: []u8) -> usize {
    const kind : u32 = card_kind(h, k);
    const arg : u32 = card_arg(h, k);
    if (kind == CK_AGENT) {
        var n : usize = put_bytes(out, 0, AGENT_LETTERS[arg - 1]);
        n = put_bytes(out, n, " ");
        return put_note_name(out, n, AGENT_NOTES[arg - 1]);
    }
    if (kind == CK_AGENT_MORE) {
        const c : usize = put_bytes(out, 0, "+");
        return put_counted(out, c, arg, "agent", "agents");
    }
    if (kind == CK_WIDGETS) { return put_counted(out, 0, arg, "widget", "widgets"); }
    if (kind == CK_GROUP) { return put_bytes(out, 0, RUN_ANCHOR[arg]); }
    if (kind == CK_GROUP_MORE) {
        const c : usize = put_bytes(out, 0, "+");
        return put_counted(out, c, arg, "group", "groups");
    }
    if (kind == CK_COURSE) { return put_bytes(out, 0, COURSE_IDS[arg]); }
    return 0;
}

/// The second line of card k of home h.
pub fn card_line(h: u32, k: u32, out: []u8) -> usize {
    const kind : u32 = card_kind(h, k);
    const arg : u32 = card_arg(h, k);
    if (kind == CK_AGENT) {
        var n : usize = put_bytes(out, 0, "agent ");
        n = put_dec(out, n, @as(u64, arg));
        n = put_bytes(out, n, " of ");
        return put_dec(out, n, @as(u64, AGENT_COUNT));
    }
    if (kind == CK_AGENT_MORE) {
        var n : usize = 0;
        var i : u32 = agent_cards(h) - 1;
        while (i < agents_in(h)) {
            if (i > agent_cards(h) - 1) { n = put_bytes(out, n, " "); }
            n = put_bytes(out, n, AGENT_LETTERS[nth_agent(h, i) - 1]);
            i = i + 1;
        }
        return n;
    }
    if (kind == CK_WIDGETS) {
        if (arg == 0) { return put_bytes(out, 0, "none in the gallery"); }
        const c : usize = put_bytes(out, 0, "in ");
        return put_counted(out, c, runs_in(h), "group", "groups");
    }
    if (kind == CK_GROUP) { return put_counted(out, 0, run_size(arg), "widget", "widgets"); }
    if (kind == CK_GROUP_MORE) {
        var total : u32 = 0;
        var i : u32 = runs_in(h) - arg;
        while (i < runs_in(h)) {
            total = total + run_size(nth_run(h, i));
            i = i + 1;
        }
        return put_counted(out, 0, total, "widget", "widgets");
    }
    if (kind == CK_COURSE) { return put_counted(out, 0, LESSONS_PER_COURSE, "lesson", "lessons"); }
    return 0;
}

/// The third line: only a course has one, its share page under t27.ai.
pub fn card_note(h: u32, k: u32, out: []u8) -> usize {
    if (card_kind(h, k) == CK_COURSE) {
        const n : usize = put_bytes(out, 0, "t27.ai/");
        return put_bytes(out, n, COURSE_SHARE[card_arg(h, k)]);
    }
    return 0;
}


; --- Tests -----------------------------------------------------------------------------------------------

test there_are_eight_homes_with_a_full_row_each {
    assert HOME_COUNT == 8;
    assert HOME_IDS[H_T27A] == "t27a";
    assert HOME_IDS[H_T27U] == "t27u";
    assert HOME_IDS[H_QUEEN] == "queen";
    assert HOME_NAMES[H_T27T] == "t27t trainer";
    assert HOME_LAWS[H_T27T] == "specs/t27t/t27t.t27";
    assert HOME_LAWS[H_T27A] == "specs/isa/t27a.t27";
    assert HOME_RUNNERS[H_T27O] == "tri t27o <file.rs> [--oracle] [--check]";
    assert HOME_ROLES[H_T27U] == "The university: 7 courses of 27 lessons, each lesson one working widget.";
}

test every_letter_is_in_exactly_one_home_and_the_counts_add_up {
    assert AGENT_COUNT == 27;
    var total : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        total = total + agents_in(h);
        h = h + 1;
    }
    assert total == 27;
    var k : u32 = 0;
    while (k < AGENT_COUNT) {
        assert AGENT_HOME[k] < HOME_COUNT;
        k = k + 1;
    }
}

test the_agent_counts_per_home_are_pinned {
    assert agents_in(H_T27A) == 1;
    assert agents_in(H_T27B) == 1;
    assert agents_in(H_T27C) == 6;
    assert agents_in(H_T27F) == 1;
    assert agents_in(H_T27O) == 2;
    assert agents_in(H_T27T) == 2;
    assert agents_in(H_T27U) == 1;
    assert agents_in(H_QUEEN) == 13;
}

test the_letters_that_look_like_homes_are_not_confused {
    assert AGENT_LETTERS[1] == "B";
    assert home_of_agent(2) == H_T27C;
    assert AGENT_LETTERS[20] == "U";
    assert home_of_agent(21) == H_QUEEN;
    assert home_of_agent(9) == H_T27A;
    assert home_of_agent(11) == H_T27B;
    assert home_of_agent(8) == H_T27T;
    assert home_of_agent(26) == H_T27U;
    assert home_of_agent(20) == H_QUEEN;
    assert home_of_agent(27) == H_QUEEN;
    assert AGENT_LETTERS[26] == "Ti";
}

test the_ordinals_outside_one_to_27_belong_to_no_home {
    assert home_of_agent(0) == HOME_COUNT;
    assert home_of_agent(28) == HOME_COUNT;
}

test every_named_agent_has_a_home {
    assert NAMED_COUNT == 12;
    var total : u32 = 0;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        total = total + named_in(h);
        h = h + 1;
    }
    assert total == 12;
    assert named_in(H_T27C) == 5;
    assert named_in(H_QUEEN) == 7;
    assert home_of_named(9) == H_T27C;
    assert NAMED_AGENTS[9] == "t27c-steward";
    assert home_of_named(10) == H_QUEEN;
    assert home_of_named(12) == HOME_COUNT;
}

test the_runs_are_ordered_and_cover_the_gallery {
    assert RUN_START[0] == 0;
    var r : u32 = 1;
    while (r < RUN_COUNT) {
        assert RUN_START[r] > RUN_START[r - 1];
        assert RUN_HOME[r] != RUN_HOME[r - 1];
        r = r + 1;
    }
    assert RUN_START[RUN_COUNT - 1] < WIDGET_COUNT;
}

