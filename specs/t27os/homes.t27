; --- L4. Widgets to homes --------------------------------------------------------------------------------
; The gallery has 195 widgets in one order. RUN_START[r] is the first index of run r and RUN_HOME[r] the
; home of every widget from there up to the next start. RUN_ANCHOR[r] is the id at that index, so a
; reader can find the run's start without the gallery open.

pub const WIDGET_COUNT : u32 = 195;
pub const RUN_COUNT : u32 = 13;
pub const RUN_START : [13]u32 = [0, 12, 13, 29, 31, 123, 126, 180, 185, 186, 187, 190, 191];
pub const RUN_HOME : [13]u32 = [2, 5, 2, 5, 2, 5, 6, 2, 7, 2, 7, 2, 7];
pub const RUN_ANCHOR : [13]str = [
    "x7-board", "gf16-calc", "idcode", "t27-cell", "uart-bucket", "t27c-gft-nll", "basics-what-a-spec-is",
    "t27-tri-vectors", "tri-selftest", "play-terminal-gates", "wars", "perf2-knockouts", "race-the-bee",
];
pub const RUN_NOTES : [13]str = [
    "The FPGA flow, then the bench tools up to gf16-calc: bitstream, fasm, pins, JTAG, timing, Verilog -- what t27c silicon emits.",
    "gf16-calc: a GoldenFloat calculator, t27t's format.",
    "idcode to lut-treemap: bench readouts of the build.",
    "t27-cell and t27-vs-nvfp4: number-format seats against FP4, the formats a trainer picks.",
    "uart-bucket, the tri-fpga casts, every t27c- compiler page up to t27c-gft-signed-mac and the audits after the lessons.",
    "t27c-gft-nll, -sgd-step, -xornet: loss, update and a net trained on XOR.",
    "Lesson-only widgets: basics-* (27) and golden-* (27) exist for the two courses that own them.",
    "t27-tri-* corpus audits up to t27-tri-lean.",
    "tri-selftest: checks tri, railway, python3 and the loop directory -- the Queen's loop tools.",
    "play-terminal-gates: the seven backends run on hello_world.",
    "wars, tri-game-tick, tri-game-vault: the Queen's arena and loop.",
    "perf2-knockouts: three performance bits, one knockout bitstream each -- a bitstream, so t27c.",
    "race-the-bee, gatle, tri-blog-list, tri-game-selftest: the agent game shelf and the Queen's blog list.",
];

pub fn home_of_widget(i: u32) -> u32 {
    if (i >= WIDGET_COUNT) {
        return HOME_COUNT;
    }
    var r : u32 = RUN_COUNT - 1;
    while (r > 0 and RUN_START[r] > i) {
        r = r - 1;
    }
    return RUN_HOME[r];
}

pub fn widgets_in(h: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (home_of_widget(i) == h) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

