    assert home_of_widget(30) == H_T27T;
    assert home_of_widget(31) == H_T27C;
    assert home_of_widget(122) == H_T27C;
    assert home_of_widget(123) == H_T27T;
    assert home_of_widget(125) == H_T27T;
    assert home_of_widget(126) == H_T27U;
    assert home_of_widget(179) == H_T27U;
    assert home_of_widget(180) == H_T27C;
    assert home_of_widget(184) == H_T27C;
    assert home_of_widget(185) == H_QUEEN;
    assert home_of_widget(186) == H_T27C;
    assert home_of_widget(187) == H_QUEEN;
    assert home_of_widget(189) == H_QUEEN;
