    assert COURSE_IDS[3] == "goldenfloat";
    assert COURSE_IDS[6] == "buses-and-peripherals";
    assert COURSE_SHARE[0] == "learn/";
    assert COURSE_SHARE[4] == "learn/verify-hardware/";
    assert COURSE_ROUTES[1] == "course";
    assert COURSE_SPECS[2] == "specs/course/ai-numbers.t27";
