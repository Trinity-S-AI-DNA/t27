test chat_is_the_third_petal_and_the_homes_take_nineteen_to_twenty_five {
    assert PETAL_CHAT == 2;
    assert petal_of_home(H_T27A) == 19;
    assert petal_of_home(H_T27B) == 20;
    assert petal_of_home(H_T27C) == 21;
    assert petal_of_home(H_T27F) == 22;
    assert petal_of_home(H_T27O) == 23;
    assert petal_of_home(H_T27T) == 24;
    assert petal_of_home(H_T27U) == 25;
    assert petal_of_home(H_QUEEN) == PETAL_CHAT;
    assert petal_of_home(HOME_COUNT) == PETAL_NONE;
}

test home_of_petal_inverts_petal_of_home_and_the_rest_have_no_home {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        assert home_of_petal(petal_of_home(h)) == h;
        h = h + 1;
    }
    var n : u32 = 0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        if (home_of_petal(p) < HOME_COUNT) { n = n + 1; }
        p = p + 1;
    }
    assert n == 8;
    assert home_of_petal(26) == HOME_COUNT;
    assert home_of_petal(0) == HOME_COUNT;
    assert home_of_petal(18) == HOME_COUNT;
    assert home_of_petal(27) == HOME_COUNT;
}

test the_product_homes_sit_in_the_third_realm_and_about_stays_last {
    var h : u32 = 0;
    while (h < H_QUEEN) {
        assert HOME_PETAL[h] >= 19;
        assert HOME_PETAL[h] <= 25;
        assert HOME_PETAL[h] / 9 == 2;
        h = h + 1;
    }
    assert home_of_petal(26) != H_T27U;
}

/// Is field `petal` of the comma-separated list `names` exactly `word`? (the tests' reader of WORLD_NAMES)
fn world_is(names: []const u8, petal: u32, word: []const u8) -> bool {
    var b : [32]u8 = undefined;
    const n : usize = csv_field(names, petal, b[0..32]);
    if (n != word.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (b[i] != word[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test the_world_names_of_petal_menu_put_chat_third_and_name_every_home {
    assert world_is(WORLD_NAMES, PETAL_CHAT, "CHAT");
    assert world_is(WORLD_NAMES, 0, "LOGS");
    assert world_is(WORLD_NAMES, 19, "T27A");
    assert world_is(WORLD_NAMES, 20, "T27B");
    assert world_is(WORLD_NAMES, 21, "T27C");
    assert world_is(WORLD_NAMES, 22, "T27F");
    assert world_is(WORLD_NAMES, 23, "T27O");
    assert world_is(WORLD_NAMES, 24, "T27T");
    assert world_is(WORLD_NAMES, 25, "T27U");
    assert world_is(WORLD_NAMES, 26, "ABOUT");
    assert world_is(WORLD_NAMES, 16, "DePIN NODE");
    assert world_is(WORLD_NAMES, 1, "CODE");
    assert world_is(WORLD_NAMES, 18, "DOCS");
    assert world_is(WORLD_NAMES, 27, "ABOUT") == false;
    assert world_is(WORLD_NAMES, 2, "LOGS") == false;
    assert world_is(WORLD_NAMES, 0, "CHAT") == false;
    assert world_is(WORLD_NAMES, 19, "REELS") == false;
}

fn same(out: []const u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (out[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

test every_home_has_a_card_count_that_fits_nine_slots {
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        assert home_cards(h) >= 1;
        assert home_cards(h) <= HOME_CARD_SLOTS;
        h = h + 1;
    }
    assert home_cards(H_T27A) == 2;
    assert home_cards(H_T27B) == 2;
    assert home_cards(H_T27C) == 9;
    assert home_cards(H_T27F) == 2;
    assert home_cards(H_T27O) == 3;
    assert home_cards(H_T27T) == 6;
    assert home_cards(H_T27U) == 9;
    assert home_cards(H_QUEEN) == 8;
    assert home_cards(HOME_COUNT) == 0;
    assert card_kind(H_T27A, 2) == CK_NONE;
    assert card_kind(H_T27U, 9) == CK_NONE;
}

test the_card_kinds_follow_the_fixed_order {
    assert card_kind(H_T27A, 0) == CK_AGENT;
    assert card_kind(H_T27A, 1) == CK_WIDGETS;
    assert card_kind(H_T27C, 0) == CK_AGENT;
    assert card_kind(H_T27C, 2) == CK_AGENT;
    assert card_kind(H_T27C, 3) == CK_AGENT_MORE;
    assert card_kind(H_T27C, 4) == CK_WIDGETS;
    assert card_kind(H_T27C, 5) == CK_GROUP;
    assert card_kind(H_T27C, 7) == CK_GROUP;
    assert card_kind(H_T27C, 8) == CK_GROUP_MORE;
    assert card_kind(H_T27U, 0) == CK_AGENT;
    assert card_kind(H_T27U, 1) == CK_WIDGETS;
    assert card_kind(H_T27U, 2) == CK_COURSE;
    assert card_kind(H_T27U, 8) == CK_COURSE;
    assert card_kind(H_QUEEN, 3) == CK_AGENT_MORE;
    assert card_kind(H_QUEEN, 5) == CK_GROUP;
    assert card_kind(H_QUEEN, 7) == CK_GROUP;
}

test the_run_walk_covers_the_gallery {
    var total : u32 = 0;
    var r : u32 = 0;
    while (r < RUN_COUNT) {
        total = total + run_size(r);
        r = r + 1;
    }
    assert total == WIDGET_COUNT;
    assert run_size(RUN_COUNT) == 0;
    assert runs_in(H_T27C) == 6;
    assert runs_in(H_T27T) == 3;
    assert runs_in(H_T27U) == 1;
    assert runs_in(H_QUEEN) == 3;
    assert runs_in(H_T27A) == 0;
    assert nth_run(H_T27C, 0) == 0;
    assert nth_run(H_T27C, 5) == 11;
    assert nth_run(H_T27C, 6) == RUN_COUNT;
    assert nth_run(H_T27U, 0) == 6;
    var h : u32 = 0;
    while (h < HOME_COUNT) {
        var w : u32 = 0;
        var n : u32 = 0;
        while (n < runs_in(h)) {
            w = w + run_size(nth_run(h, n));
            n = n + 1;
        }
        assert w == widgets_in(h);
        h = h + 1;
    }
}

test the_agent_cards_name_the_letter_and_the_name {
    var b : [64]u8 = undefined;
    var n : usize = card_title(H_T27B, 0, b[0..64]);
    assert same(b[0..64], n, "K Kernel / FPGA MAC");
    n = card_line(H_T27B, 0, b[0..64]);
    assert same(b[0..64], n, "agent 11 of 27");
    n = card_title(H_T27A, 0, b[0..64]);
    assert same(b[0..64], n, "I ISA");
    n = card_title(H_T27U, 0, b[0..64]);
    assert same(b[0..64], n, "Z Zero-Touch UX / Docs");
    n = card_title(H_T27C, 3, b[0..64]);
    assert same(b[0..64], n, "+3 agents");
    n = card_line(H_T27C, 3, b[0..64]);
    assert same(b[0..64], n, "L R V");
    n = card_title(H_QUEEN, 3, b[0..64]);
    assert same(b[0..64], n, "+10 agents");
}

test the_widget_cards_say_the_real_counts_including_zero {
    var b : [64]u8 = undefined;
    var n : usize = card_title(H_T27A, 1, b[0..64]);
    assert same(b[0..64], n, "0 widgets");
    n = card_line(H_T27A, 1, b[0..64]);
    assert same(b[0..64], n, "none in the gallery");
    n = card_title(H_T27C, 4, b[0..64]);
    assert same(b[0..64], n, "127 widgets");
    n = card_line(H_T27C, 4, b[0..64]);
    assert same(b[0..64], n, "in 6 groups");
    n = card_title(H_T27C, 5, b[0..64]);
    assert same(b[0..64], n, "x7-board");
    n = card_line(H_T27C, 5, b[0..64]);
    assert same(b[0..64], n, "12 widgets");
    n = card_title(H_T27C, 8, b[0..64]);
    assert same(b[0..64], n, "+3 groups");
    n = card_title(H_T27T, 2, b[0..64]);
    assert same(b[0..64], n, "6 widgets");
    n = card_title(H_T27U, 1, b[0..64]);
    assert same(b[0..64], n, "54 widgets");
    n = card_line(H_T27U, 1, b[0..64]);
    assert same(b[0..64], n, "in 1 group");
}

test the_course_cards_give_id_lessons_and_share_path {
    var b : [64]u8 = undefined;
    var n : usize = card_title(H_T27U, 2, b[0..64]);
    assert same(b[0..64], n, "t27-basics");
    n = card_line(H_T27U, 2, b[0..64]);
    assert same(b[0..64], n, "27 lessons");
    n = card_note(H_T27U, 2, b[0..64]);
    assert same(b[0..64], n, "t27.ai/learn/");
    n = card_title(H_T27U, 8, b[0..64]);
    assert same(b[0..64], n, "buses-and-peripherals");
    n = card_note(H_T27U, 8, b[0..64]);
    assert same(b[0..64], n, "t27.ai/learn/buses-and-peripherals/");
    n = card_note(H_T27U, 1, b[0..64]);
    assert n == 0;
}

test negative_control_an_empty_slot_has_no_text {
    var b : [64]u8 = undefined;
    assert card_title(H_T27A, 5, b[0..64]) == 0;
    assert card_line(H_T27A, 5, b[0..64]) == 0;
    assert card_note(H_T27A, 5, b[0..64]) == 0;
    assert card_title(HOME_COUNT, 0, b[0..64]) == 0;
}
