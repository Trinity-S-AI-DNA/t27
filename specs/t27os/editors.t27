// SPDX-License-Identifier: Apache-2.0
// T27 OS editors: "open in editor" for a SPACE or a pane's working directory. This spec is the table and
// the decisions; editors_host.t27 does the two system calls (access, posix_spawn).
//
// An editor is found by its app bundle (/Applications/<App>.app or ~/Applications/<App>.app) or, failing
// that, by its command-line launcher on the usual PATH directories. A bundle is launched through
// `open -a <App> <dir>` (no CLI install needed); a launcher alone is run as `<cli> <dir>`. Nothing is
// installed by T27 OS: an editor that is not there is reported missing.
//
// Refs gHashTag/t27#10782.
module T27osEditors;

use t27os::session_store::csv_field;
use t27os::session_store::put_bytes;

pub const EDITOR_COUNT : u32 = 9;
pub const E_VSCODE : u32 = 0;
pub const E_CURSOR : u32 = 1;
pub const E_ZED : u32 = 2;
pub const E_WINDSURF : u32 = 3;
pub const E_XCODE : u32 = 4;
pub const E_IDEA : u32 = 5;
pub const E_WEBSTORM : u32 = 6;
pub const E_SUBLIME : u32 = 7;
pub const E_NOVA : u32 = 8;

/// What the menu shows.
pub const EDITOR_NAMES : str = "VS Code,Cursor,Zed,Windsurf,Xcode,IntelliJ IDEA,WebStorm,Sublime Text,Nova";
/// The command-line launcher each editor installs.
pub const EDITOR_CLIS : str = "code,cursor,zed,windsurf,xed,idea,webstorm,subl,nova";
/// The app bundle name (without .app).
pub const EDITOR_APPS : str = "Visual Studio Code,Cursor,Zed,Windsurf,Xcode,IntelliJ IDEA,WebStorm,Sublime Text,Nova";

/// The directories a launcher is looked up in.
pub const CLI_DIRS : str = "/usr/local/bin,/opt/homebrew/bin,/usr/bin";

pub const HOW_NONE : u32 = 0;
pub const HOW_OPEN_APP : u32 = 1;
pub const HOW_CLI : u32 = 2;

pub fn editor_name(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_NAMES, i, out);
}

pub fn editor_cli(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_CLIS, i, out);
}

pub fn editor_app(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_APPS, i, out);
}

/// "/Applications/<App>.app" (home == "" ) or "<home>/Applications/<App>.app".
pub fn bundle_path(i: u32, home: []const u8, out: []u8) -> usize {
    var app : [32]u8 = undefined;
    const an : usize = editor_app(i, app[0..32]);
    if (an == 0) { return 0; }
    var n : usize = 0;
    if (home.len > 0) {
        n = put_bytes(out, 0, home);
    }
    n = put_bytes(out, n, "/Applications/");
    n = put_bytes(out, n, app[0..an]);
    n = put_bytes(out, n, ".app");
    return n;
}

/// "<dir>/<cli>" for the k-th launcher directory.
pub fn cli_path(i: u32, k: u32, out: []u8) -> usize {
    var dir : [24]u8 = undefined;
    const dn : usize = csv_field(CLI_DIRS, k, dir[0..24]);
    if (dn == 0) { return 0; }
    var cli : [16]u8 = undefined;
    const cn : usize = editor_cli(i, cli[0..16]);
    if (cn == 0) { return 0; }
    var n : usize = put_bytes(out, 0, dir[0..dn]);
    n = put_bytes(out, n, "/");
    n = put_bytes(out, n, cli[0..cn]);
    return n;
}

pub const CLI_DIR_COUNT : u32 = 3;

/// How to launch editor i given what was found: the app bundle wins over the launcher.
pub fn launch_how(has_bundle: bool, has_cli: bool) -> u32 {
    if (has_bundle) { return HOW_OPEN_APP; }
    if (has_cli) { return HOW_CLI; }
    return HOW_NONE;
}

/// A directory is fit to hand to an editor when it is an absolute path with no control characters.
pub fn dir_fits(dir: []const u8) -> bool {
    if (dir.len == 0) { return false; }
    if (dir.len > 400) { return false; }
    if (dir[0] != 47) { return false; }
    var i : usize = 0;
    while (i < dir.len) {
        if (dir[i] < 32) { return false; }
        if (dir[i] == 127) { return false; }
        i = i + 1;
    }
    return true;
}

test every_editor_has_a_name_a_launcher_and_a_bundle {
    var b : [40]u8 = undefined;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        assert editor_name(i, b[0..40]) > 0;
        assert editor_cli(i, b[0..40]) > 0;
        assert editor_app(i, b[0..40]) > 0;
        i = i + 1;
    }
    assert editor_name(EDITOR_COUNT, b[0..40]) == 0;
}

test the_launchers_are_the_ones_each_editor_ships {
    var b : [16]u8 = undefined;
    assert editor_cli(E_VSCODE, b[0..16]) == 4;
    assert b[0] == 99 and b[3] == 101;
    assert editor_cli(E_XCODE, b[0..16]) == 3;
    assert b[0] == 120;
    assert editor_cli(E_SUBLIME, b[0..16]) == 4;
    assert b[0] == 115 and b[3] == 108;
    assert editor_cli(E_ZED, b[0..16]) == 3;
}

test a_bundle_lives_under_applications {
    var p : [96]u8 = undefined;
    const n : usize = bundle_path(E_CURSOR, "", p[0..96]);
    assert n == 24;
    assert p[0] == 47 and p[14] == 67;
    assert p[n - 1] == 112;
    const h : usize = bundle_path(E_ZED, "/Users/tester", p[0..96]);
    assert h == 13 + 14 + 3 + 4;
    assert p[0] == 47 and p[6] == 47;
    assert bundle_path(EDITOR_COUNT, "", p[0..96]) == 0;
}

test a_launcher_is_looked_up_in_each_directory {
    var p : [64]u8 = undefined;
    const a : usize = cli_path(E_VSCODE, 0, p[0..64]);
    assert a == 19;
    assert p[0] == 47 and p[15] == 99;
    const b : usize = cli_path(E_VSCODE, 1, p[0..64]);
    assert b == 22;
    assert cli_path(E_VSCODE, CLI_DIR_COUNT, p[0..64]) == 0;
}

test the_bundle_wins_over_the_launcher {
    assert launch_how(true, true) == HOW_OPEN_APP;
    assert launch_how(true, false) == HOW_OPEN_APP;
    assert launch_how(false, true) == HOW_CLI;
    assert launch_how(false, false) == HOW_NONE;
}

test only_an_absolute_clean_directory_is_handed_over {
    assert dir_fits("/Users/tester/work");
    assert dir_fits("") == false;
    assert dir_fits("relative/dir") == false;
    assert dir_fits("-a /etc") == false;
    var b : [8]u8 = undefined;
    b[0] = 47;
    b[1] = 97;
    b[2] = 10;
    assert dir_fits(b[0..3]) == false;
}

// ---- the OPEN IN strip at the foot of the KEYS panel: the installed editors as a grid of text chips ----

pub const ED_COLS : u32 = 4;
pub const ED_SLOT_W : f64 = 66.0;
pub const ED_SLOT_H : f64 = 16.0;
pub const ED_NONE : u32 = 255;

/// The editor (index into the table) that is the k-th installed one in `mask`; ED_NONE when there are fewer.
pub fn nth_installed(mask: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        if (mask / editor_bit(i) % 2 == 1) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return ED_NONE;
}

pub fn installed_count(mask: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        if (mask / editor_bit(i) % 2 == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn editor_bit(i: u32) -> u32 {
    var r : u32 = 1;
    var k : u32 = 0;
    while (k < i) {
        r = r * 2;
        k = k + 1;
    }
    return r;
}

pub fn ed_slot_x(l: f64, pad: f64, k: u32) -> f64 {
    return l + pad + @as(f64, @floatFromInt(k % ED_COLS)) * ED_SLOT_W;
}

pub fn ed_slot_y(top: f64, k: u32) -> f64 {
    return top + @as(f64, @floatFromInt(k / ED_COLS)) * ED_SLOT_H;
}

/// Which installed-editor slot a click lands on (top = the strip's top edge); ED_NONE when none.
pub fn ed_hit(x: f64, y: f64, l: f64, pad: f64, top: f64, count: u32) -> u32 {
    var k : u32 = 0;
    while (k < count) {
        const sx : f64 = ed_slot_x(l, pad, k);
        const sy : f64 = ed_slot_y(top, k);
        if (x >= sx and x < sx + ED_SLOT_W and y >= sy and y < sy + ED_SLOT_H) { return k; }
        k = k + 1;
    }
    return ED_NONE;
}

test the_kth_installed_editor_skips_the_missing_ones {
    assert nth_installed(0, 0) == ED_NONE;
    assert nth_installed(1 + 4 + 16, 0) == 0;
    assert nth_installed(1 + 4 + 16, 1) == 2;
    assert nth_installed(1 + 4 + 16, 2) == 4;
    assert nth_installed(1 + 4 + 16, 3) == ED_NONE;
    assert installed_count(1 + 4 + 16) == 3;
    assert installed_count(0) == 0;
}

test a_click_lands_on_one_editor_chip {
    assert ed_hit(700.0 + 3.0, 400.0 + 3.0, 684.0, 16.0, 400.0, 6) == 0;
    assert ed_hit(700.0 + ED_SLOT_W + 3.0, 400.0 + 3.0, 684.0, 16.0, 400.0, 6) == 1;
    assert ed_hit(700.0 + 3.0, 400.0 + ED_SLOT_H + 3.0, 684.0, 16.0, 400.0, 6) == 4;
    assert ed_hit(700.0 + 3.0, 400.0 + ED_SLOT_H + 3.0, 684.0, 16.0, 400.0, 3) == ED_NONE;
    assert ed_hit(10.0, 10.0, 684.0, 16.0, 400.0, 6) == ED_NONE;
}
