// SPDX-License-Identifier: Apache-2.0
// T27 OS editors: "open in editor" for a SPACE or a pane's working directory. This spec is the table and
// the decisions; editors_host.t27 does the two system calls (access, posix_spawn).
//
// An editor is found by its app bundle (/Applications/<App>.app or ~/Applications/<App>.app) or, failing
// that, by its command-line launcher on the usual PATH directories. A bundle is launched through
// `open -a <bundle path> <dir>` (the path that was found, so a name with a space or two apps with a shared
// prefix cannot be mixed up; no CLI install needed); a launcher alone is run as `<cli> <dir>`. Xcode is the
// exception: `xed <dir>` opens a plain folder, `open -a Xcode` does not, so the launcher wins there, but
// /usr/bin/xed is a shim that every Mac has, so for Xcode only the bundle counts as installed. Nothing is
// installed by T27 OS: an editor that is not there is reported missing, with the reason (open_result).
//
// The mask of installed editors is a u32: at most 32 entries (MAX_EDITORS). Not looked up: JetBrains
// Toolbox installs (~/Applications/JetBrains Toolbox/<Product> <Edition>.app carries an edition suffix the
// table cannot guess; its shell-script launchers live outside CLI_DIRS).
//
// Owner, 2026-10-20: "check that all code editors are supported and fix what does not open" -- the table
// now names every editor found on the bench Mac (Cursor, Xcode, Antigravity, Antigravity IDE, ZCode)
// and the usual others.
//
// Refs gHashTag/t27#10782, gHashTag/t27#11223.
module T27osEditors;

use t27os::session_store::csv_field;
use t27os::session_store::put_bytes;
use t27os::session_store::SHELL_CELL;

pub const MAX_EDITORS : u32 = 32;
pub const EDITOR_COUNT : u32 = 27;
pub const E_VSCODE : u32 = 0;
pub const E_CURSOR : u32 = 1;
pub const E_ZED : u32 = 2;
pub const E_WINDSURF : u32 = 3;
pub const E_XCODE : u32 = 4;
pub const E_IDEA : u32 = 5;
pub const E_WEBSTORM : u32 = 6;
pub const E_SUBLIME : u32 = 7;
pub const E_NOVA : u32 = 8;
pub const E_ANTIGRAVITY : u32 = 9;
pub const E_ANTIGRAVITY_IDE : u32 = 10;
pub const E_ZCODE : u32 = 11;
pub const E_PYCHARM : u32 = 12;
pub const E_GOLAND : u32 = 13;
pub const E_CLION : u32 = 14;
pub const E_RUSTROVER : u32 = 15;
pub const E_RIDER : u32 = 16;
pub const E_PHPSTORM : u32 = 17;
pub const E_ANDROID_STUDIO : u32 = 18;
pub const E_VSCODE_INSIDERS : u32 = 19;
pub const E_VSCODIUM : u32 = 20;
pub const E_KIRO : u32 = 21;
pub const E_TRAE : u32 = 22;
pub const E_POSITRON : u32 = 23;
pub const E_BBEDIT : u32 = 24;
pub const E_TEXTMATE : u32 = 25;
pub const E_FLEET : u32 = 26;

/// What the menu shows (a chip is ED_SLOT_W wide: at most 16 characters).
pub const EDITOR_NAMES : str = "VS Code,Cursor,Zed,Windsurf,Xcode,IntelliJ IDEA,WebStorm,Sublime Text,Nova,Antigravity,Antigravity IDE,ZCode,PyCharm,GoLand,CLion,RustRover,Rider,PhpStorm,Android Studio,VS Code Insiders,VSCodium,Kiro,Trae,Positron,BBEdit,TextMate,Fleet";
/// The command-line launcher each editor installs; empty where the editor ships none (at most 15 characters).
pub const EDITOR_CLIS : str = "code,cursor,zed,windsurf,xed,idea,webstorm,subl,nova,antigravity,,,pycharm,goland,clion,rustrover,rider,phpstorm,studio,code-insiders,codium,kiro,trae,positron,bbedit,mate,fleet";
/// The app bundle name (without .app): the folder name under /Applications, checked against the bench Mac
/// for Cursor, Xcode, Antigravity, Antigravity IDE and ZCode (at most 31 characters).
pub const EDITOR_APPS : str = "Visual Studio Code,Cursor,Zed,Windsurf,Xcode,IntelliJ IDEA,WebStorm,Sublime Text,Nova,Antigravity,Antigravity IDE,ZCode,PyCharm,GoLand,CLion,RustRover,Rider,PhpStorm,Android Studio,Visual Studio Code - Insiders,VSCodium,Kiro,Trae,Positron,BBEdit,TextMate,Fleet";

/// The directories a launcher is looked up in.
pub const CLI_DIRS : str = "/usr/local/bin,/opt/homebrew/bin,/usr/bin";

pub const HOW_NONE : u32 = 0;
pub const HOW_OPEN_APP : u32 = 1;
pub const HOW_CLI : u32 = 2;

pub fn editor_name(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_NAMES, i, out);
}

pub fn editor_cli(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_CLIS, i, out);
}

pub fn editor_app(i: u32, out: []u8) -> usize {
    return csv_field(EDITOR_APPS, i, out);
}

/// "/Applications/<App>.app" (home == "" ) or "<home>/Applications/<App>.app".
pub fn bundle_path(i: u32, home: []const u8, out: []u8) -> usize {
    var app : [32]u8 = undefined;
    const an : usize = editor_app(i, app[0..32]);
    if (an == 0) { return 0; }
    var n : usize = 0;
    if (home.len > 0) {
        n = put_bytes(out, 0, home);
    }
    n = put_bytes(out, n, "/Applications/");
    n = put_bytes(out, n, app[0..an]);
    n = put_bytes(out, n, ".app");
    return n;
}

/// "<dir>/<cli>" for the k-th launcher directory.
pub fn cli_path(i: u32, k: u32, out: []u8) -> usize {
    var dir : [24]u8 = undefined;
    const dn : usize = csv_field(CLI_DIRS, k, dir[0..24]);
    if (dn == 0) { return 0; }
    var cli : [16]u8 = undefined;
    const cn : usize = editor_cli(i, cli[0..16]);
    if (cn == 0) { return 0; }
    var n : usize = put_bytes(out, 0, dir[0..dn]);
    n = put_bytes(out, n, "/");
    n = put_bytes(out, n, cli[0..cn]);
    return n;
}

pub const CLI_DIR_COUNT : u32 = 3;

/// How to launch an editor given what was found: the app bundle wins over the launcher.
pub fn launch_how(has_bundle: bool, has_cli: bool) -> u32 {
    if (has_bundle) { return HOW_OPEN_APP; }
    if (has_cli) { return HOW_CLI; }
    return HOW_NONE;
}

/// Xcode opens a plain folder badly through `open -a`; `xed <dir>` is made for it. And /usr/bin/xed is a
/// shim every Mac has, so for Xcode a launcher alone never counts as an installed editor.
pub fn cli_first(i: u32) -> bool {
    return i == E_XCODE;
}

/// How to launch editor i given what was found: launch_how, except Xcode -- the bundle must be there, and
/// then its launcher (xed) is used when it exists and `open -a` when it does not.
pub fn launch_pick(i: u32, has_bundle: bool, has_cli: bool) -> u32 {
    if (cli_first(i)) {
        if (has_bundle == false) { return HOW_NONE; }
        if (has_cli) { return HOW_CLI; }
        return HOW_OPEN_APP;
    }
    return launch_how(has_bundle, has_cli);
}

/// Whether the OPEN IN strip lists editor i.
pub fn is_installed(i: u32, has_bundle: bool, has_cli: bool) -> bool {
    return launch_pick(i, has_bundle, has_cli) != HOW_NONE;
}

/// Why an open did or did not start -- the strip shows OPEN_WORDS[result].
pub const OPEN_OK : u32 = 0;
pub const OPEN_BAD_DIR : u32 = 1;
pub const OPEN_NOT_FOUND : u32 = 2;
pub const OPEN_SPAWN_FAILED : u32 = 3;
pub const OPEN_BAD_EDITOR : u32 = 4;
/// No click yet: the strip says nothing.
pub const OPEN_NONE : u32 = 255;
pub const OPEN_WORDS : str = "opened,bad folder,not installed,could not start,unknown editor";

/// The result of opening a folder in editor i: `dir_ok` is dir_fits, `how` is launch_pick, `spawn_rc` is what
/// posix_spawn returned (0 = started). The first thing wrong wins, in the order the host finds it out.
pub fn open_result(i: u32, dir_ok: bool, how: u32, spawn_rc: i32) -> u32 {
    if (i >= EDITOR_COUNT) { return OPEN_BAD_EDITOR; }
    if (dir_ok == false) { return OPEN_BAD_DIR; }
    if (how == HOW_NONE) { return OPEN_NOT_FOUND; }
    if (spawn_rc != 0) { return OPEN_SPAWN_FAILED; }
    return OPEN_OK;
}

pub fn open_word(result: u32, out: []u8) -> usize {
    return csv_field(OPEN_WORDS, result, out);
}

/// True when editor i is called `name` in the menu.
pub fn name_is(i: u32, name: []const u8) -> bool {
    if (i >= EDITOR_COUNT) { return false; }
    var b : [48]u8 = undefined;
    const n : usize = editor_name(i, b[0..48]);
    return same_bytes(b[0..n], name);
}

/// Two byte strings are equal. After the length check one loop ORs the XOR of every byte pair into `d`, and
/// the strings are equal when `d` stays 0. It deliberately is not the early-exit compare the corpus already
/// has (igla/coder/tokenizer.t27, tri/crypto/hex.t27): it reads every byte whether or not an earlier one
/// differed, so its time depends on the length and not on where the first difference is.
pub fn same_bytes(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var d : u32 = 0;
    var k : usize = 0;
    while (k < a.len) {
        d = d | @as(u32, a[k] ^ b[k]);
        k = k + 1;
    }
    return d == 0;
}

/// The table index of the editor the menu calls `name`; EDITOR_COUNT when there is none.
pub fn editor_index(name: []const u8) -> u32 {
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        if (name_is(i, name)) { return i; }
        i = i + 1;
    }
    return EDITOR_COUNT;
}

/// A directory is fit to hand to an editor when it is an absolute path with no control characters.
pub fn dir_fits(dir: []const u8) -> bool {
    if (dir.len == 0) { return false; }
    if (dir.len > 400) { return false; }
    if (dir[0] != 47) { return false; }
    var i : usize = 0;
    while (i < dir.len) {
        if (dir[i] < 32) { return false; }
        if (dir[i] == 127) { return false; }
        i = i + 1;
    }
    return true;
}

test every_editor_has_a_name_and_a_bundle_that_fit_their_buffers {
    // measured into 64 bytes; csv_field does not check the buffer, so each limit below is the real one
    var b : [64]u8 = undefined;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        const nn : usize = editor_name(i, b[0..64]);
        assert nn > 0;
        assert nn <= 16;
        const an : usize = editor_app(i, b[0..64]);
        assert an > 0;
        assert an <= 31;
        assert editor_cli(i, b[0..64]) <= 15;
        i = i + 1;
    }
    assert EDITOR_COUNT <= MAX_EDITORS;
    // the three lists are the same length: past the last entry every one is empty, on it none is
    assert editor_name(EDITOR_COUNT, b[0..64]) == 0;
    assert editor_app(EDITOR_COUNT, b[0..64]) == 0;
    assert editor_cli(EDITOR_COUNT, b[0..64]) == 0;
    assert editor_name(EDITOR_COUNT - 1, b[0..64]) > 0;
    assert editor_app(EDITOR_COUNT - 1, b[0..64]) > 0;
    assert editor_cli(EDITOR_COUNT - 1, b[0..64]) > 0;
}

test the_editors_found_on_the_bench_mac_are_in_the_table {
    // measured 2026-10-20: /Applications holds Cursor, Xcode, Antigravity, Antigravity IDE and ZCode
    assert editor_index("Cursor") == E_CURSOR;
    assert editor_index("Xcode") == E_XCODE;
    assert editor_index("Antigravity") == E_ANTIGRAVITY;
    assert editor_index("Antigravity IDE") == E_ANTIGRAVITY_IDE;
    assert editor_index("ZCode") == E_ZCODE;
    assert editor_index("Emacs") == EDITOR_COUNT;
    assert editor_index("") == EDITOR_COUNT;
    assert editor_index("Antigravity I") == EDITOR_COUNT;
    assert name_is(E_ZCODE, "ZCode");
    assert name_is(E_ZCODE, "ZCod") == false;
    assert name_is(EDITOR_COUNT, "") == false;
    // the usual others are named too
    assert editor_index("PyCharm") == E_PYCHARM;
    assert editor_index("GoLand") == E_GOLAND;
    assert editor_index("CLion") == E_CLION;
    assert editor_index("RustRover") == E_RUSTROVER;
    assert editor_index("Rider") == E_RIDER;
    assert editor_index("PhpStorm") == E_PHPSTORM;
    assert editor_index("Android Studio") == E_ANDROID_STUDIO;
    assert editor_index("VS Code Insiders") == E_VSCODE_INSIDERS;
    assert editor_index("VSCodium") == E_VSCODIUM;
    assert editor_index("Kiro") == E_KIRO;
    assert editor_index("Trae") == E_TRAE;
    assert editor_index("Positron") == E_POSITRON;
    assert editor_index("BBEdit") == E_BBEDIT;
    assert editor_index("TextMate") == E_TEXTMATE;
    assert editor_index("Fleet") == E_FLEET;
}

test each_bench_editor_has_the_bundle_folder_name_the_disk_has {
    var p : [160]u8 = undefined;
    var n : usize = bundle_path(E_CURSOR, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Cursor.app");
    n = bundle_path(E_XCODE, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Xcode.app");
    n = bundle_path(E_ANTIGRAVITY, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Antigravity.app");
    // a name with a space stays one path: the host hands it over as one argv word
    n = bundle_path(E_ANTIGRAVITY_IDE, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Antigravity IDE.app");
    n = bundle_path(E_ZCODE, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/ZCode.app");
    n = bundle_path(E_ANTIGRAVITY_IDE, "/Users/tester", p[0..160]);
    assert same_bytes(p[0..n], "/Users/tester/Applications/Antigravity IDE.app");
    n = bundle_path(E_VSCODE, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Visual Studio Code.app");
    n = bundle_path(E_VSCODE_INSIDERS, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Visual Studio Code - Insiders.app");
    n = bundle_path(E_ANDROID_STUDIO, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Android Studio.app");
    n = bundle_path(E_SUBLIME, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/Sublime Text.app");
    n = bundle_path(E_IDEA, "", p[0..160]);
    assert same_bytes(p[0..n], "/Applications/IntelliJ IDEA.app");
}

test an_editor_with_no_launcher_is_found_by_its_bundle_alone {
    var b : [16]u8 = undefined;
    var p : [64]u8 = undefined;
    assert editor_cli(E_ZCODE, b[0..16]) == 0;
    assert editor_cli(E_ANTIGRAVITY_IDE, b[0..16]) == 0;
    assert cli_path(E_ZCODE, 0, p[0..64]) == 0;
    assert cli_path(E_ANTIGRAVITY_IDE, 1, p[0..64]) == 0;
    assert launch_pick(E_ZCODE, true, false) == HOW_OPEN_APP;
    assert launch_pick(E_ZCODE, false, false) == HOW_NONE;
    // the neighbours of the empty fields still read their own launcher
    assert editor_cli(E_ANTIGRAVITY, b[0..16]) == 11;
    assert editor_cli(E_PYCHARM, b[0..16]) == 7;
    assert b[0] == 112;
}

test xcode_opens_through_xed_and_only_when_the_bundle_is_there {
    assert cli_first(E_XCODE);
    assert cli_first(E_CURSOR) == false;
    assert launch_pick(E_XCODE, true, true) == HOW_CLI;
    assert launch_pick(E_XCODE, true, false) == HOW_OPEN_APP;
    // /usr/bin/xed is a shim every Mac has: it alone is not Xcode
    assert launch_pick(E_XCODE, false, true) == HOW_NONE;
    assert launch_pick(E_XCODE, false, false) == HOW_NONE;
    assert is_installed(E_XCODE, false, true) == false;
    assert is_installed(E_XCODE, true, true);
    // everything else: the bundle wins, a launcher alone is enough
    assert launch_pick(E_CURSOR, true, true) == HOW_OPEN_APP;
    assert launch_pick(E_CURSOR, false, true) == HOW_CLI;
    assert launch_pick(E_CURSOR, false, false) == HOW_NONE;
    assert is_installed(E_ZED, false, true);
    assert is_installed(E_ZED, false, false) == false;
}

test the_open_result_names_the_first_thing_that_went_wrong {
    assert open_result(E_CURSOR, true, HOW_OPEN_APP, 0) == OPEN_OK;
    assert open_result(E_XCODE, true, HOW_CLI, 0) == OPEN_OK;
    assert open_result(E_CURSOR, false, HOW_OPEN_APP, 0) == OPEN_BAD_DIR;
    assert open_result(E_CURSOR, true, HOW_NONE, 0) == OPEN_NOT_FOUND;
    assert open_result(E_CURSOR, true, HOW_CLI, 1) == OPEN_SPAWN_FAILED;
    assert open_result(E_CURSOR, true, HOW_CLI, 0 - 1) == OPEN_SPAWN_FAILED;
    assert open_result(EDITOR_COUNT, true, HOW_OPEN_APP, 0) == OPEN_BAD_EDITOR;
    // a bad folder is reported before a missing editor, a missing editor before a failed spawn
    assert open_result(E_CURSOR, false, HOW_NONE, 0) == OPEN_BAD_DIR;
    assert open_result(E_CURSOR, true, HOW_NONE, 1) == OPEN_NOT_FOUND;
    // the folder test is dir_fits
    assert open_result(E_ZED, dir_fits("/Users/tester/work"), HOW_OPEN_APP, 0) == OPEN_OK;
    assert open_result(E_ZED, dir_fits("work"), HOW_OPEN_APP, 0) == OPEN_BAD_DIR;
}

test every_open_result_has_a_word_the_strip_can_show {
    var b : [32]u8 = undefined;
    var r : u32 = 0;
    while (r <= OPEN_BAD_EDITOR) {
        const n : usize = open_word(r, b[0..32]);
        assert n > 0;
        assert n <= 16;
        r = r + 1;
    }
    assert open_word(OPEN_BAD_EDITOR + 1, b[0..32]) == 0;
    assert open_word(OPEN_NONE, b[0..32]) == 0;
    const k : usize = open_word(OPEN_NOT_FOUND, b[0..32]);
    assert same_bytes(b[0..k], "not installed");
    const o : usize = open_word(OPEN_OK, b[0..32]);
    assert same_bytes(b[0..o], "opened");
}

test the_whole_table_fits_the_32_bit_mask_and_the_strip {
    const all : u32 = 134217727;
    assert installed_count(all) == EDITOR_COUNT;
    assert nth_installed(all, EDITOR_COUNT - 1) == EDITOR_COUNT - 1;
    assert nth_installed(all, EDITOR_COUNT) == ED_NONE;
    // 27 chips are 9 rows of 3, each row ED_SLOT_H tall; the last chip stays inside the panel's 268 pt
    assert ed_slot_x(0.0, 0.0, EDITOR_COUNT - 1) + ED_SLOT_W <= 268.0;
    assert ED_COLS * ED_SLOT_W <= 268.0;
}

test the_launchers_are_the_ones_each_editor_ships {
    var b : [16]u8 = undefined;
    assert editor_cli(E_VSCODE, b[0..16]) == 4;
    assert b[0] == 99 and b[3] == 101;
    assert editor_cli(E_XCODE, b[0..16]) == 3;
    assert b[0] == 120;
    assert editor_cli(E_SUBLIME, b[0..16]) == 4;
    assert b[0] == 115 and b[3] == 108;
    assert editor_cli(E_ZED, b[0..16]) == 3;
}

test a_bundle_lives_under_applications {
    var p : [96]u8 = undefined;
    const n : usize = bundle_path(E_CURSOR, "", p[0..96]);
    assert n == 24;
    assert p[0] == 47 and p[14] == 67;
    assert p[n - 1] == 112;
    const h : usize = bundle_path(E_ZED, "/Users/tester", p[0..96]);
    assert h == 13 + 14 + 3 + 4;
    assert p[0] == 47 and p[6] == 47;
    assert bundle_path(EDITOR_COUNT, "", p[0..96]) == 0;
}

test a_launcher_is_looked_up_in_each_directory {
    var p : [64]u8 = undefined;
    const a : usize = cli_path(E_VSCODE, 0, p[0..64]);
    assert a == 19;
    assert p[0] == 47 and p[15] == 99;
    const b : usize = cli_path(E_VSCODE, 1, p[0..64]);
    assert b == 22;
    assert cli_path(E_VSCODE, CLI_DIR_COUNT, p[0..64]) == 0;
}

test the_bundle_wins_over_the_launcher {
    assert launch_how(true, true) == HOW_OPEN_APP;
    assert launch_how(true, false) == HOW_OPEN_APP;
    assert launch_how(false, true) == HOW_CLI;
    assert launch_how(false, false) == HOW_NONE;
}

test only_an_absolute_clean_directory_is_handed_over {
    assert dir_fits("/Users/tester/work");
    assert dir_fits("") == false;
    assert dir_fits("relative/dir") == false;
    assert dir_fits("-a /etc") == false;
    var b : [8]u8 = undefined;
    b[0] = 47;
    b[1] = 97;
    b[2] = 10;
    assert dir_fits(b[0..3]) == false;
}

// ---- the OPEN IN strip at the foot of the KEYS panel: the installed editors as a grid of text chips ----

/// Three chips of 88 pt fill the 268 pt of the Queen/KEYS panel (QP_W 300 less two QP_PAD): "Antigravity IDE"
/// and "VS Code Insiders" fit one chip at 9 pt, where four 66 pt chips overlapped.
pub const ED_COLS : u32 = 3;
pub const ED_SLOT_W : f64 = 88.0;
pub const ED_SLOT_H : f64 = 16.0;
pub const ED_NONE : u32 = 255;

/// The editor (index into the table) that is the k-th installed one in `mask`; ED_NONE when there are fewer.
pub fn nth_installed(mask: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        if (mask / editor_bit(i) % 2 == 1) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return ED_NONE;
}

pub fn installed_count(mask: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < EDITOR_COUNT) {
        if (mask / editor_bit(i) % 2 == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn editor_bit(i: u32) -> u32 {
    var r : u32 = 1;
    var k : u32 = 0;
    while (k < i) {
        r = r * 2;
        k = k + 1;
    }
    return r;
}

pub fn ed_slot_x(l: f64, pad: f64, k: u32) -> f64 {
    return l + pad + @as(f64, @floatFromInt(k % ED_COLS)) * ED_SLOT_W;
}

pub fn ed_slot_y(top: f64, k: u32) -> f64 {
    return top + @as(f64, @floatFromInt(k / ED_COLS)) * ED_SLOT_H;
}

/// Which installed-editor slot a click lands on (top = the strip's top edge); ED_NONE when none.
pub fn ed_hit(x: f64, y: f64, l: f64, pad: f64, top: f64, count: u32) -> u32 {
    var k : u32 = 0;
    while (k < count) {
        const sx : f64 = ed_slot_x(l, pad, k);
        const sy : f64 = ed_slot_y(top, k);
        if (x >= sx and x < sx + ED_SLOT_W and y >= sy and y < sy + ED_SLOT_H) { return k; }
        k = k + 1;
    }
    return ED_NONE;
}

test the_kth_installed_editor_skips_the_missing_ones {
    assert nth_installed(0, 0) == ED_NONE;
    assert nth_installed(1 + 4 + 16, 0) == 0;
    assert nth_installed(1 + 4 + 16, 1) == 2;
    assert nth_installed(1 + 4 + 16, 2) == 4;
    assert nth_installed(1 + 4 + 16, 3) == ED_NONE;
    assert installed_count(1 + 4 + 16) == 3;
    assert installed_count(0) == 0;
}

test a_click_lands_on_one_editor_chip {
    assert ed_hit(700.0 + 3.0, 400.0 + 3.0, 684.0, 16.0, 400.0, 6) == 0;
    assert ed_hit(700.0 + ED_SLOT_W + 3.0, 400.0 + 3.0, 684.0, 16.0, 400.0, 6) == 1;
    assert ed_hit(700.0 + 3.0, 400.0 + ED_SLOT_H + 3.0, 684.0, 16.0, 400.0, 6) == ED_COLS;
    assert ed_hit(700.0 + 3.0, 400.0 + ED_SLOT_H + 3.0, 684.0, 16.0, 400.0, 3) == ED_NONE;
    assert ed_hit(10.0, 10.0, 684.0, 16.0, 400.0, 6) == ED_NONE;
}

// ---- terminal editors: the ones that run inside a pane of the PTY server ----
// Owner, 2026-10-20: "T27OS opens inside!!". A GUI editor is another app's window; a terminal editor is a
// program a pane of pty_server.t27 can run, so its output is the window's own. The window sends a SPAWN for
// the shell cell (SHELL_CELL) whose model field is the editor's name (pty_logic.t27 launch_command), the
// directory or file to open is the pane's cwd, and the pane runs `<editor> '<path>'`. The editor is found
// on the server's PATH (the launchd plist carries the PATH of the shell that installed it); the window
// only chooses among those it saw in CLI_DIRS (term_path, term_pick).

pub const TERM_COUNT : u32 = 5;
pub const TERM_NONE : u32 = 255;
/// In order of preference (vim ships with macOS); each name is also the command that is run.
pub const TERM_NAMES : str = "vim,nvim,hx,micro,nano";
/// The longest path a pane can take as its cwd (pty_logic CWD_CAP - 1).
pub const TERM_PATH_MAX : usize = 255;

pub fn term_name(i: u32, out: []u8) -> usize {
    return csv_field(TERM_NAMES, i, out);
}

/// "<dir>/<name>" for the k-th launcher directory (CLI_DIRS): where the window looks for terminal editor i.
pub fn term_path(i: u32, k: u32, out: []u8) -> usize {
    var dir : [24]u8 = undefined;
    const dn : usize = csv_field(CLI_DIRS, k, dir[0..24]);
    if (dn == 0) { return 0; }
    var nm : [16]u8 = undefined;
    const nn : usize = term_name(i, nm[0..16]);
    if (nn == 0) { return 0; }
    var n : usize = put_bytes(out, 0, dir[0..dn]);
    n = put_bytes(out, n, "/");
    n = put_bytes(out, n, nm[0..nn]);
    return n;
}

/// The table index of the terminal editor called `name`; TERM_NONE when it is not one.
pub fn term_index(name: []const u8) -> u32 {
    var b : [16]u8 = undefined;
    var i : u32 = 0;
    while (i < TERM_COUNT) {
        const n : usize = term_name(i, b[0..16]);
        if (same_bytes(b[0..n], name)) { return i; }
        i = i + 1;
    }
    return TERM_NONE;
}

/// The editor to use given a mask (bit i set = terminal editor i was found): the first in preference
/// order; TERM_NONE when none was found.
pub fn term_pick(mask: u32) -> u32 {
    var i : u32 = 0;
    while (i < TERM_COUNT) {
        if (mask / editor_bit(i) % 2 == 1) { return i; }
        i = i + 1;
    }
    return TERM_NONE;
}

/// A path is fit to open inside a pane: dir_fits, short enough for a pane's cwd, and without the single
/// quote that would end the quoting around it in `sh -c`.
pub fn term_path_fits(path: []const u8) -> bool {
    if (dir_fits(path) == false) { return false; }
    if (path.len > TERM_PATH_MAX) { return false; }
    var i : usize = 0;
    while (i < path.len) {
        if (path[i] == 39) { return false; }
        i = i + 1;
    }
    return true;
}

/// `<editor> '<path>'` written into out -- the command line a pane runs (argv_text puts "exec " in front).
/// Returns its length; 0 when `pick` is no terminal editor or the path is not fit.
pub fn editor_command(pick: u32, path: []const u8, out: []u8) -> usize {
    if (pick >= TERM_COUNT or term_path_fits(path) == false) { return 0; }
    const nn : usize = term_name(pick, out);
    out[nn] = 32;
    out[nn + 1] = 39;
    const n : usize = put_bytes(out, nn + 2, path);
    out[n] = 39;
    return n + 1;
}

/// The SPAWN payload (pty_proto.t27) that asks the PTY server for terminal editor `pick` on `path`, for the
/// space and slot of the chat it opens beside: [SHELL_CELL][space][slot][path] TAB [editor]. The wire format
/// is the old one -- the shell cell with a model field. 0 when `pick` is no terminal editor or the path is
/// not fit (term_path_fits).
pub fn editor_spawn_payload(space: u32, slot: u32, pick: u32, path: []const u8, out: []u8) -> usize {
    if (pick >= TERM_COUNT or term_path_fits(path) == false) { return 0; }
    out[0] = @as(u8, @intCast(SHELL_CELL));
    out[1] = @as(u8, @intCast(space));
    out[2] = @as(u8, @intCast(slot));
    var n : usize = put_bytes(out, 3, path);
    out[n] = 9;
    n = n + 1;
    const nn : usize = term_name(pick, out[n .. n + 16]);
    return n + nn;
}

test the_terminal_editors_are_named_in_order_of_preference {
    var b : [16]u8 = undefined;
    var n : usize = term_name(0, b[0..16]);
    assert same_bytes(b[0..n], "vim");
    n = term_name(1, b[0..16]);
    assert same_bytes(b[0..n], "nvim");
    n = term_name(2, b[0..16]);
    assert same_bytes(b[0..n], "hx");
    n = term_name(3, b[0..16]);
    assert same_bytes(b[0..n], "micro");
    n = term_name(4, b[0..16]);
    assert same_bytes(b[0..n], "nano");
    assert term_name(TERM_COUNT, b[0..16]) == 0;
    assert term_index("vim") == 0;
    assert term_index("nano") == 4;
    assert term_index("emacs") == TERM_NONE;
    assert term_index("") == TERM_NONE;
    assert term_index("vi") == TERM_NONE;
    assert term_index("vimx") == TERM_NONE;
    // each name fits term_path's 16-byte buffer and the model field (model_ok: letters and digits)
    var i : u32 = 0;
    while (i < TERM_COUNT) {
        n = term_name(i, b[0..16]);
        assert n > 0;
        assert n <= 15;
        i = i + 1;
    }
}

test the_first_installed_terminal_editor_in_preference_order_is_picked {
    // the bench Mac has vim and nano (/usr/bin), no nvim, hx or micro
    assert term_pick(1 + 16) == 0;
    assert term_pick(16) == 4;
    assert term_pick(2 + 4 + 16) == 1;
    assert term_pick(8 + 16) == 3;
    assert term_pick(0) == TERM_NONE;
    // a bit past the table is no editor
    assert term_pick(32) == TERM_NONE;
}

test a_terminal_editor_is_looked_up_in_each_launcher_directory {
    var p : [64]u8 = undefined;
    var n : usize = term_path(0, 2, p[0..64]);
    assert same_bytes(p[0..n], "/usr/bin/vim");
    n = term_path(1, 1, p[0..64]);
    assert same_bytes(p[0..n], "/opt/homebrew/bin/nvim");
    n = term_path(4, 0, p[0..64]);
    assert same_bytes(p[0..n], "/usr/local/bin/nano");
    assert term_path(0, CLI_DIR_COUNT, p[0..64]) == 0;
    assert term_path(TERM_COUNT, 0, p[0..64]) == 0;
}

test only_a_clean_absolute_path_without_a_quote_opens_inside {
    assert term_path_fits("/Users/tester/work");
    assert term_path_fits("/Users/tester/my project");
    assert term_path_fits("/Users/tester/it's") == false;
    assert term_path_fits("") == false;
    assert term_path_fits("work") == false;
    assert term_path_fits("-c /etc/passwd") == false;
    var b : [8]u8 = undefined;
    b[0] = 47;
    b[1] = 97;
    b[2] = 10;
    assert term_path_fits(b[0..3]) == false;
    // a pane's cwd is shorter than 256 bytes
    var long : [300]u8 = undefined;
    var i : usize = 0;
    while (i < 300) {
        long[i] = 97;
        i = i + 1;
    }
    long[0] = 47;
    assert term_path_fits(long[0..255]);
    assert term_path_fits(long[0..256]) == false;
}

test an_editor_command_is_the_editor_and_the_quoted_path {
    var o : [400]u8 = undefined;
    var n : usize = editor_command(0, "/Users/tester/work", o[0..400]);
    assert same_bytes(o[0..n], "vim '/Users/tester/work'");
    // a path with a space stays one word for sh
    n = editor_command(4, "/Users/tester/my project/notes.txt", o[0..400]);
    assert same_bytes(o[0..n], "nano '/Users/tester/my project/notes.txt'");
    n = editor_command(term_pick(2 + 8), "/h", o[0..400]);
    assert same_bytes(o[0..n], "nvim '/h'");
    // refused: no such editor, a quote in the path, no path
    assert editor_command(TERM_COUNT, "/Users/tester", o[0..400]) == 0;
    assert editor_command(TERM_NONE, "/Users/tester", o[0..400]) == 0;
    assert editor_command(0, "/Users/te'ster", o[0..400]) == 0;
    assert editor_command(0, "", o[0..400]) == 0;
    assert editor_command(0, "relative", o[0..400]) == 0;
}

test the_editor_spawn_payload_is_the_shell_cell_the_path_a_tab_and_the_editor {
    var p : [300]u8 = undefined;
    const n : usize = editor_spawn_payload(2, 5, 4, "/h/w", p[0..300]);
    assert n == 3 + 4 + 1 + 4;
    assert p[0] == 9 and p[1] == 2 and p[2] == 5;
    assert same_bytes(p[3..7], "/h/w");
    assert p[7] == 9;
    assert same_bytes(p[8..n], "nano");
    assert SHELL_CELL == 9;
    assert editor_spawn_payload(0, 0, TERM_COUNT, "/h", p[0..300]) == 0;
    assert editor_spawn_payload(0, 0, 0, "/h'x", p[0..300]) == 0;
}
