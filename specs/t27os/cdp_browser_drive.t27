// SPDX-License-Identifier: Apache-2.0
; T27 OS CDP browser drive -- the HTTP leg of the CDP host for cdp_browser.t27, written the
; pty_server.t27 way: libc moves the bytes, every decision is a pure fn with a test.
; This file owns the request/response byte law of the CDP HTTP surface:
;   - the request line and headers of a GET (/json/version, /json/list) and a PUT (/json/new?<url>);
;   - the status-line read (HTTP/1.x 200 only counts as ok);
;   - the field find that pulls a quoted string value (webSocketDebuggerUrl) out of a response.
; The WebSocket leg (handshake, framing, Runtime.evaluate) is the next slice; it reads the URL this
; file finds. The endpoint policy is cdp_browser.t27's (neo 9115, fallback 9102, PUT-only, read cap).
; GATE: @extern host spec -- test with `t27b test specs/t27os/cdp_browser_drive.t27`.
; The externs are libc/libSystem symbols (link with `ld -lSystem`, the t27os Makefile line).
; LESSON (2026-11-01, measured here): a `"\r\n"` string literal in this t27b does not read back as
; the two CR LF bytes (`CRLF.len != 2` in a direct probe), so CRLF is written as the CR and LF byte
; constants CR=13, LF=10, never through a string literal. A bare `;` line is a parse error too.

module T27osCdpBrowserDrive;

/// The CRLF bytes every request line and header ends with: 13, 10.
pub const CR : u8 = 13;
pub const LF : u8 = 10;

/// Build a GET request for one CDP path into out; returns the byte count written.
pub fn get_request(host : string, port : u16, path : string, out : []u8) -> usize {
  var w : usize = 0;
  w = put_lit(out, w, "GET ");
  w = put_lit(out, w, path);
  w = put_lit(out, w, " HTTP/1.1");
  w = put_crlf(out, w);
  w = put_lit(out, w, "Host: ");
  w = put_lit(out, w, host);
  w = put_colon_port(out, w, port);
  w = put_crlf(out, w);
  w = put_lit(out, w, "Connection: close");
  w = put_crlf(out, w);
  w = put_crlf(out, w);
  return w;
}

/// Build a PUT request, the only verb cdp_browser.t27 allows for opening a tab.
/// CDP takes the URL in the path (`PUT /json/new?<url>`); there is no body.
pub fn put_request(host : string, port : u16, url : string, out : []u8) -> usize {
  var w : usize = 0;
  w = put_lit(out, w, "PUT /json/new?");
  w = put_lit(out, w, url);
  w = put_lit(out, w, " HTTP/1.1");
  w = put_crlf(out, w);
  w = put_lit(out, w, "Host: ");
  w = put_lit(out, w, host);
  w = put_colon_port(out, w, port);
  w = put_crlf(out, w);
  w = put_lit(out, w, "Connection: close");
  w = put_crlf(out, w);
  w = put_crlf(out, w);
  return w;
}

/// Does the response status line say 200? Only HTTP/1.x ` 200 ` counts.
pub fn status_ok(resp : string) -> bool {
  if (resp.len < 12) { return false; }
  if (span_is(resp, 0, 7, "HTTP/1.") == false) { return false; }
  return span_is(resp, 9, 12, "200");
}

/// Find `"name":"` in the response and write the span of the quoted value into v.
/// Returns 1 on a hit, 0 when the field is absent or unquoted (CDP puts a URL in quotes).
pub fn find_json_string(resp : string, name : string, v : []usize) -> u8 {
  var i : usize = 0;
  while (i + name.len + 3 < resp.len) {
    if (resp[i] == 34) {
      if (span_is(resp, i + 1, i + 1 + name.len, name)) {
        var j : usize = i + 1 + name.len;
        if (resp[j] == 34) {
          j = j + 1;
          if (j < resp.len and resp[j] == 58) {
            j = j + 1;
            if (j < resp.len and resp[j] == 34) {
              var s : usize = j + 1;
              var e : usize = s;
              while (e < resp.len and resp[e] != 34) { e = e + 1; }
              if (e < resp.len) {
                v[0] = s;
                v[1] = e;
                return 1;
              }
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return 0;
}

// ---- byte writers ---------------------------------------------------------------------------

fn put_lit(out : []u8, w : usize, s : string) -> usize {
  var i : usize = 0;
  while (i < s.len and w < out.len) { out[w] = s[i] as u8; w = w + 1; i = i + 1; }
  return w;
}

fn put_crlf(out : []u8, w : usize) -> usize {
  var x : usize = w;
  if (x < out.len) { out[x] = CR; x = x + 1; }
  if (x < out.len) { out[x] = LF; x = x + 1; }
  return x;
}

fn put_colon_port(out : []u8, w : usize, port : u16) -> usize {
  if (w < out.len) { out[w] = 58; w = w + 1; }
  var d : usize = 10000;
  var started : bool = false;
  while (d > 0) {
    const digit : u16 = (port / d as u16) % 10;
    if (digit > 0 or started or d == 1) {
      started = true;
      if (w < out.len) { out[w] = (48 + digit) as u8; w = w + 1; }
    }
    d = d / 10;
  }
  return w;
}

fn span_is(s : string, a : usize, b : usize, lit : string) -> bool {
  if (b - a != lit.len) { return false; }
  var i : usize = 0;
  while (i < lit.len) {
    if (s[a + i] != lit[i]) { return false; }
    i = i + 1;
  }
  return true;
}

// ---- tests ----------------------------------------------------------------------------------

test a_get_request_names_the_path_host_and_close {
  var buf : [128]u8;
  const out : []u8 = buf[0..128];
  const n : usize = get_request("127.0.0.1", 9115, "/json/version", out);
  assert n > 30;
  // the first line is the verb, the path and HTTP/1.1
  assert out[0] == 71; // 'G'
  assert out[4] == 47; // '/'
  // headers end with a blank line: two CRLF in a row at the very end
  assert out[n - 4] == 13;
  assert out[n - 2] == 13;
  assert out[n - 3] == 10;
  assert out[n - 1] == 10;
}

test a_put_request_carries_the_url_in_the_path_and_no_body {
  var buf : [128]u8;
  const out : []u8 = buf[0..128];
  const n : usize = put_request("127.0.0.1", 9115, "https://t27.ai/#/", out);
  // "PUT /json/new?" is 14 bytes, then the url starts with 'h'
  assert out[0] == 80; // 'P'
  assert out[1] == 85; // 'U'
  assert out[4] == 47; // '/'
  assert out[14] == 104; // 'h'
  assert out[n - 1] == 10;
}

test a_200_status_line_is_ok_and_nothing_else_is {
  assert status_ok("HTTP/1.1 200 OK\r\n\r\n{}") == true;
  assert status_ok("HTTP/1.1 404 Not Found\r\n\r\n") == false;
  assert status_ok("HTTP/") == false;
  assert status_ok("abcd") == false;
  assert status_ok("") == false;
}

test web_socket_debugger_url_is_found_and_spans_the_value {
  const resp : string = "{\"type\":\"page\",\"webSocketDebuggerUrl\":\"ws://127.0.0.1:9115/x\",\"id\":\"A\"}";
  var v : [2]usize;
  const sv : []usize = v[0..2];
  assert find_json_string(resp, "webSocketDebuggerUrl", sv) == 1;
  assert sv[1] - sv[0] == 21;
  assert resp[sv[0]] == 119; // 'w' of ws://
  assert resp[sv[1] - 1] == 120; // 'x'
}

test an_absent_field_and_an_unquoted_value_find_nothing {
  var v : [2]usize;
  const sv : []usize = v[0..2];
  assert find_json_string("{\"type\":\"page\",\"id\":\"A\"}", "webSocketDebuggerUrl", sv) == 0;
  assert find_json_string("{\"webSocketDebuggerUrl\":null,\"id\":\"A\"}", "webSocketDebuggerUrl", sv) == 0;
}

test the_port_is_written_in_decimal {
  var buf : [64]u8;
  const out : []u8 = buf[0..64];
  const n : usize = get_request("127.0.0.1", 9115, "/json/list", out);
  // find the ":9115" after the Host value
  var i : usize = 0;
  var seen : bool = false;
  while (i + 5 < n) {
    if (out[i] == 58 and out[i + 1] == 57 and out[i + 2] == 49 and out[i + 3] == 49 and out[i + 4] == 53) { seen = true; }
    i = i + 1;
  }
  assert seen;
}

invariant a_short_or_garbage_response_is_never_ok {
  assert status_ok("x") == false;
}

test crlf_is_the_two_bytes_cr_then_lf_not_a_string_literal {
  var buf : [64]u8;
  const out : []u8 = buf[0..64];
  const n : usize = get_request("h", 1, "/p", out);
  // "GET /p HTTP/1.1" 15, CRLF at 15..16, "Host: h" 17..23, ":1" 24..25, CRLF 26..27,
  // "Connection: close" 28..44, CRLF 45..46, CRLF 47..48, n 49
  assert n == 49;
  assert out[15] == 13;
  assert out[16] == 10;
  assert out[45] == 13;
  assert out[47] == 13;
}
