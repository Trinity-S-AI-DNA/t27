// Device-local addressing is a routing label, never authentication. SAS is still mandatory.
use t27os::peer_id::pid_normalize;
pub fn va_number(raw: []const u8) -> u64 {
    var canonical : [13]u8 = undefined;
    if (pid_normalize(raw, canonical[0..13]) != 13) { return 0; }
    var n : u64 = 0; var i : usize = 4;
    while (i < 13) { if (i != 8) { n = n*10 + canonical[i]-48; } i = i + 1; }
    return n;
}
pub fn va_format(number: u64, out: []u8) -> usize {
    if (number == 0 or number > 99999999 or out.len < 13) { return 0; }
    out[0]=84;out[1]=50;out[2]=55;out[3]=45;out[8]=45;
    var n : u64 = number; var i : usize = 13;
    while (i > 4) { i=i-1; if (i != 8) { out[i]=@as(u8,@intCast(n%10))+48;n=n/10; } }
    return 13;
}
test full_eight_digit_address_roundtrip {
    var out : [13]u8 = undefined; assert va_format(12345678, out[0..13]) == 13;
    assert va_number(out[0..13]) == 12345678 and va_number("87654321") == 87654321;
}
pub fn va_ipv4(raw: []const u8) -> u64 {
    var value : u64 = 0; var part : u64 = 0; var digits : usize = 0; var count : usize = 0; var i : usize = 0;
    while (i <= raw.len) {
        if (i == raw.len or raw[i] == 46) {
            if (digits == 0 or part > 255 or count > 3) { return 0; }
            value = value*256+part;count=count+1;part=0;digits=0;
        } else { if (raw[i]<48 or raw[i]>57 or digits>=3) { return 0; } part=part*10+raw[i]-48;digits=digits+1; }
        i=i+1;
    }
    if (count != 4) { return 0; } return value;
}
test ip_parser_preserves_address_and_rejects_bad_octets { assert va_ipv4("192.168.1.25") == 3232235801; assert va_ipv4("256.0.0.1") == 0; }
test leading_zero_numbers_and_invalid_ranges {
    var out : [13]u8 = undefined;
    assert va_number("T27-0000-0001") == 1 and va_format(1,out[0..13]) == 13 and va_number(out[0..13]) == 1;
    assert va_format(0,out[0..13]) == 0 and va_format(100000000,out[0..13]) == 0;
    assert va_number("not-a-number") == 0 and va_ipv4("1..2.3") == 0;
}
