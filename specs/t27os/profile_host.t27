// SPDX-License-Identifier: Apache-2.0
// T27 OS profile_host: where the own profile (profile.t27) touches the machine. Two groups of calls, no rules:
//   - libSystem: creat, write, fsync, close, rename, unlink, mkdir, lseek, getenv -- the profile folder
//     <home>/.t27os/profile (mode PRF_DIR_MODE), profile.t27p and avatar.png, each written through a .part file
//     and a rename, so a failed write never leaves half a file where the old one stood.
//   - AppKit and ImageIO: the system file panel (NSOpenPanel), the real content type and size of the chosen picture
//     (CGImageSourceGetType, PixelWidth, PixelHeight), a thumbnail with the EXIF orientation applied, the centred
//     square, a PRF_AVATAR_PX square PNG (CGBitmapContext, CGImageDestination).
// Every decision is a tested fn in profile.t27 (limits, error lines, nickname rules, the file text, the paths, the
// crop) or a small fn below that tests the ORDER of steps and the mapping of facts to codes. This file only asks
// the system, then acts on the answer.
//
// Specs holding @extern cannot run their calls under t27c: the externs are host primitives and no test executes
// them. The tests below cover the pure fns of this file; the panel, the decode and the file calls are NOT checked
// by any test here, and nothing in this file is evidence for the window.
//
// Failure rules (the order is prfh_next_step): the target file is touched by the rename alone; any earlier failure
// unlinks the .part and leaves the old file, so the old nickname and the old picture stay. A missing, foreign or
// damaged profile.t27p is read as "not set" (profile.t27 prf_parse_*); a profile that says avatar=1 while
// avatar.png is missing shows no picture (prfh_avatar_shown). A cancelled panel returns PRF_E_CANCELLED, which
// has no line (prf_error_text), so nothing is shown. No file name and no OS message ever leaves this module: the
// window gets a PRF_* code and shows prf_error_text of it.
//
// Imported by the window (glass_window.t27) in the next step; this file is not wired into any window yet.
//
// Refs gHashTag/t27#11560.
module T27osProfileHost;

use t27os::profile::PRF_OK;
use t27os::profile::PRF_E_UNREADABLE;
use t27os::profile::PRF_E_SAVE;
use t27os::profile::PRF_E_CANCELLED;
use t27os::profile::PRF_AVATAR_PX;
use t27os::profile::PRF_DIR_MODE;
use t27os::profile::PRF_DOC_MAX;
use t27os::profile::PRF_NICK_MAX_BYTES;
use t27os::profile::PRF_PICK_HINT;
use t27os::profile::PRF_PICK_MESSAGE;
use t27os::profile::PRF_F_DIR;
use t27os::profile::PRF_F_PROFILE;
use t27os::profile::PRF_F_PROFILE_PART;
use t27os::profile::PRF_F_AVATAR;
use t27os::profile::PRF_F_AVATAR_PART;
use t27os::profile::prf_picture_check;
use t27os::profile::prf_thumb_max;
use t27os::profile::prf_crop_side;
use t27os::profile::prf_crop_x;
use t27os::profile::prf_crop_y;
use t27os::profile::prf_nick_check;
use t27os::profile::prf_save_status;
use t27os::profile::prf_emit;
use t27os::profile::prf_parse_nick;
use t27os::profile::prf_parse_avatar;
use t27os::profile::prf_path;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_read;
use t27os::pty_sys::sys_close;
use t27os::pty_sys::sys_open_ro;
use t27os::pty_sys::sys_creat;
use t27os::pty_sys::sys_rename;
use t27os::pty_sys::sys_unlink;
use t27os::pty_sys::sys_mkdir;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_addr;

pub const PRFH_UTF8 : u32 = 134217984;
/// NSModalResponseOK, what NSOpenPanel runModal answers when a file was chosen.
pub const PRFH_PANEL_OK : u64 = 1;
/// The file mode of profile.t27p and avatar.png: owner read and write (0600).
pub const PRFH_FILE_MODE : u32 = 384;
pub const PRFH_SEEK_END : i32 = 2;
/// Room for a path with its 0 byte; a longer home gives no path (prf_path), so no file is touched.
pub const PRFH_PATH_CAP : usize = 1024;
/// ImageIO names a content type with a short string ("public.heic"); a longer answer is no type.
pub const PRFH_UTI_CAP : usize = 64;
/// kCFNumberSInt64Type and kCGImageAlphaPremultipliedLast.
pub const PRFH_NUM_S64 : u64 = 4;
pub const PRFH_ALPHA_LAST : u32 = 1;
pub const PRFH_QUALITY_HIGH : i32 = 3;

// ---------------------------------------------------------------- 1. the order of an atomic write (pure)

/// The steps of writing one file: create the .part, write all the bytes, fsync, close, rename over the target.
pub const PRFH_ST_CREATE : u32 = 0;
pub const PRFH_ST_WRITE : u32 = 1;
pub const PRFH_ST_SYNC : u32 = 2;
pub const PRFH_ST_CLOSE : u32 = 3;
pub const PRFH_ST_RENAME : u32 = 4;
/// Finished: the target holds the new bytes.
pub const PRFH_ST_DONE : u32 = 5;
/// Stopped: the target was not touched.
pub const PRFH_ST_ABORT : u32 = 6;

/// The step after `step` ended with `ok`: the next one, PRFH_ST_DONE after a rename that worked, PRFH_ST_ABORT after
/// any step that failed (and for a step that is not a step).
pub fn prfh_next_step(step: u32, ok: bool) -> u32 {
    if (step > PRFH_ST_RENAME or ok == false) { return PRFH_ST_ABORT; }
    return step + 1;
}

/// Does this step change the target file: the rename alone. Before it the target is as it was.
pub fn prfh_touches_target(step: u32) -> bool {
    return step == PRFH_ST_RENAME;
}

/// Must the .part be unlinked after `step` failed: once it exists (every step after the create); a failed create
/// made nothing.
pub fn prfh_part_left(failed: u32) -> bool {
    return failed > PRFH_ST_CREATE and failed <= PRFH_ST_RENAME;
}

/// Did a write(2) loop put all `want` bytes on disk: no short write left over.
pub fn prfh_all_written(wrote: u64, want: u64) -> bool {
    return wrote == want;
}

// ---------------------------------------------------------------- 2. facts to codes (pure)

/// The verdict on what the panel and ImageIO said about a chosen file. A cancelled panel is PRF_E_CANCELLED and
/// nothing else is looked at; a file that could not be opened or sized, or whose type ImageIO could not name, is
/// PRF_E_UNREADABLE; else the limits of profile.t27 decide (type, file size, sides, pixels).
pub fn prfh_facts_code(cancelled: bool, readable: bool, uti: []const u8, bytes: u64, w: u64, h: u64) -> u32 {
    if (cancelled) { return PRF_E_CANCELLED; }
    if (readable == false or uti.len == 0) { return PRF_E_UNREADABLE; }
    return prf_picture_check(uti, bytes, w, h);
}

/// The stages of making the avatar picture after the facts passed.
pub const PRFH_X_DECODE : u32 = 0;
pub const PRFH_X_CROP : u32 = 1;
pub const PRFH_X_ENCODE : u32 = 2;
pub const PRFH_X_COMMIT : u32 = 3;

/// The code for a picture that failed at a stage: reading it (decode, crop) is PRF_E_UNREADABLE; writing it
/// (encode, commit) is PRF_E_SAVE, whose line says the previous picture is kept.
pub fn prfh_stage_code(stage: u32) -> u32 {
    if (stage == PRFH_X_DECODE or stage == PRFH_X_CROP) { return PRF_E_UNREADABLE; }
    return PRF_E_SAVE;
}

/// Does choosing a picture also rewrite profile.t27p: only when there was none (the file must then say avatar=1).
/// The flag is written BEFORE the picture is renamed in, so a failure between the two leaves "avatar=1, no file",
/// which prfh_avatar_shown reads as no picture, never "a picture, no flag".
pub fn prfh_pick_writes_flag(had: bool) -> bool {
    return had == false;
}

/// Is the picture shown: the profile says so and avatar.png is there.
pub fn prfh_avatar_shown(flag: bool, file_present: bool) -> bool {
    return flag and file_present;
}

/// The code of a failed removal. The flag is rewritten first (atomic) and the file is unlinked after it, so a
/// failure keeps the picture; its line says the previous picture is kept.
pub fn prfh_remove_code(flag_written: bool) -> u32 {
    if (flag_written) { return PRF_OK; }
    return PRF_E_SAVE;
}

/// Where the parent folder of a path ends: the index of its last '/', 0 when there is none or it is the first byte.
pub fn prfh_parent_len(path: []const u8) -> usize {
    var i : usize = path.len;
    while (i > 1) {
        if (path[i - 1] == 47) { return i - 1; }
        i = i - 1;
    }
    return 0;
}

/// The profile text in the bytes read from disk: the same prf_parse_* the window uses, with a file larger than
/// PRF_DOC_MAX taken as damaged (res[0] = 1 when a picture is set, res[1] = the nickname length). The nickname
/// length, 0 for "not set".
pub fn prfh_parse(text: []const u8, nick: []u8, res: []u32) -> usize {
    res[0] = 0;
    res[1] = 0;
    if (text.len > PRF_DOC_MAX) { return 0; }
    const n : usize = prf_parse_nick(text, nick);
    if (prf_parse_avatar(text)) { res[0] = 1; }
    res[1] = @as(u32, @intCast(n));
    return n;
}

// ---------------------------------------------------------------- 3. host primitives (libSystem, Foundation, ImageIO)

fn sys_fsync(fd: i32) -> i32 { return @extern("fsync"); }
fn sys_lseek(fd: i32, off: i64, whence: i32) -> i64 { return @extern("lseek"); }

fn cf_make(alloc: u64, bytes: []const u8, n: usize, enc: u32, ext: bool) -> u64 { return @extern("CFStringCreateWithBytes"); }
fn cf_drop(o: u64) -> void { @extern("CFRelease"); }
fn cf_c_string(s: u64, buf: []u8, size: u64, enc: u32) -> bool { return @extern("CFStringGetCString"); }
fn cf_dict_get(d: u64, key: u64) -> u64 { return @extern("CFDictionaryGetValue"); }
fn cf_num_get(n: u64, kind: u64, out: []u8) -> bool { return @extern("CFNumberGetValue"); }
fn class_of(name: u64) -> u64 { return @extern("NSClassFromString"); }
fn selector_of(name: u64) -> u64 { return @extern("NSSelectorFromString"); }
fn send0(o: u64, s: u64) -> u64 { return @extern("objc_msgSend"); }
fn send1(o: u64, s: u64, a: u64) -> u64 { return @extern("objc_msgSend"); }
fn send_flag(o: u64, s: u64, a: bool) -> u64 { return @extern("objc_msgSend"); }
fn send_dict4(o: u64, s: u64, vals: [4]u64, keys: [4]u64, n: u64) -> u64 { return @extern("objc_msgSend"); }
fn send_text(o: u64, s: u64, buf: []u8, max: u64, enc: u64) -> bool { return @extern("objc_msgSend"); }

fn img_source(url: u64, opts: u64) -> u64 { return @extern("CGImageSourceCreateWithURL"); }
fn img_type(src: u64) -> u64 { return @extern("CGImageSourceGetType"); }
fn img_props(src: u64, idx: u64, opts: u64) -> u64 { return @extern("CGImageSourceCopyPropertiesAtIndex"); }
fn img_thumbnail(src: u64, idx: u64, opts: u64) -> u64 { return @extern("CGImageSourceCreateThumbnailAtIndex"); }
fn img_width(i: u64) -> u64 { return @extern("CGImageGetWidth"); }
fn img_height(i: u64) -> u64 { return @extern("CGImageGetHeight"); }
fn img_cut(i: u64, x: f64, y: f64, w: f64, h: f64) -> u64 { return @extern("CGImageCreateWithImageInRect"); }
fn img_drop(i: u64) -> void { @extern("CGImageRelease"); }
fn space_rgb() -> u64 { return @extern("CGColorSpaceCreateDeviceRGB"); }
fn space_drop(s: u64) -> void { @extern("CGColorSpaceRelease"); }
fn bmp_make(data: u64, w: usize, h: usize, bits: usize, row: usize, space: u64, info: u32) -> u64 { return @extern("CGBitmapContextCreate"); }
fn bmp_image(c: u64) -> u64 { return @extern("CGBitmapContextCreateImage"); }
fn bmp_drop(c: u64) -> void { @extern("CGContextRelease"); }
fn bmp_quality(c: u64, q: i32) -> void { @extern("CGContextSetInterpolationQuality"); }
fn bmp_draw(c: u64, x: f64, y: f64, w: f64, h: f64, i: u64) -> void { @extern("CGContextDrawImage"); }
fn dest_make(url: u64, kind: u64, count: u64, opts: u64) -> u64 { return @extern("CGImageDestinationCreateWithURL"); }
fn dest_add(d: u64, i: u64, opts: u64) -> void { @extern("CGImageDestinationAddImage"); }
fn dest_end(d: u64) -> bool { return @extern("CGImageDestinationFinalize"); }

fn text_of(s: []const u8) -> u64 {
    return cf_make(0, s, s.len, PRFH_UTF8, false);
}

fn named_class(s: []const u8) -> u64 {
    const t : u64 = text_of(s);
    const c : u64 = class_of(t);
    cf_drop(t);
    return c;
}

fn named_sel(s: []const u8) -> u64 {
    const t : u64 = text_of(s);
    const c : u64 = selector_of(t);
    cf_drop(t);
    return c;
}

fn file_url(path: []const u8, n: usize) -> u64 {
    const t : u64 = cf_make(0, path, n, PRFH_UTF8, false);
    const u : u64 = send1(named_class("NSURL"), named_sel("fileURLWithPath:"), t);
    cf_drop(t);
    return u;
}

// ---------------------------------------------------------------- 4. files

/// The path of a kind below the home folder (profile.t27 prf_path) with its 0 byte at out[n]; n, 0 when there is no
/// home or no room.
fn prfh_path_of(kind: u32, out: []u8) -> usize {
    var h : [512]u8 = undefined;
    h[0] = 72;
    h[1] = 79;
    h[2] = 77;
    h[3] = 69;
    h[4] = 0;
    const p : u64 = sys_getenv(h[0..5]);
    if (p == 0) { return 0; }
    const n : u64 = sys_strlen(p);
    if (n == 0 or n >= 512) { return 0; }
    sys_peek(h[0..512], p, n);
    return prf_path(h[0..@as(usize, n)], kind, out);
}

fn prfh_exists(path: []const u8) -> bool {
    const fd : i32 = sys_open_ro(path, 0);
    if (fd < 0) { return false; }
    sys_close(fd);
    return true;
}

/// Create <home>/.t27os and <home>/.t27os/profile (0700) when they are not there. True when the profile folder
/// can be used.
fn prfh_ensure_dir() -> bool {
    var d : [PRFH_PATH_CAP]u8 = undefined;
    const n : usize = prfh_path_of(PRF_F_DIR, d[0..PRFH_PATH_CAP]);
    if (n == 0) { return false; }
    const up : usize = prfh_parent_len(d[0..n]);
    if (up == 0) { return false; }
    // the parent: cut the path at its last '/' with a 0 byte, make it, put the slash back
    d[up] = 0;
    sys_mkdir(d[0..PRFH_PATH_CAP], PRF_DIR_MODE);
    d[up] = 47;
    sys_mkdir(d[0..PRFH_PATH_CAP], PRF_DIR_MODE);
    return prfh_exists(d[0..PRFH_PATH_CAP]);
}

/// Write `data` to the .part path, then rename it over the target, in the order of prfh_next_step. True only when
/// the rename worked; any failure unlinks the .part (prfh_part_left) and leaves the target as it was.
fn prfh_atomic_write(part: []const u8, target: []const u8, data: []const u8) -> bool {
    var step : u32 = PRFH_ST_CREATE;
    var fd : i32 = -1;
    var wrote : u64 = 0;
    var failed : u32 = PRFH_ST_DONE;
    while (step != PRFH_ST_DONE and step != PRFH_ST_ABORT) {
        var ok : bool = false;
        if (step == PRFH_ST_CREATE) {
            fd = sys_creat(part, PRFH_FILE_MODE);
            ok = fd >= 0;
        } else if (step == PRFH_ST_WRITE) {
            ok = true;
            while (ok and wrote < @as(u64, data.len)) {
                const w : i64 = sys_write(fd, data[@as(usize, wrote)..data.len], @as(u64, data.len) - wrote);
                if (w <= 0) {
                    ok = false;
                } else {
                    wrote = wrote + @as(u64, @intCast(w));
                }
            }
            ok = ok and prfh_all_written(wrote, @as(u64, data.len));
        } else if (step == PRFH_ST_SYNC) {
            ok = sys_fsync(fd) == 0;
        } else if (step == PRFH_ST_CLOSE) {
            ok = sys_close(fd) == 0;
            fd = -1;
        } else {
            ok = sys_rename(part, target) == 0;
        }
        const next : u32 = prfh_next_step(step, ok);
        if (next == PRFH_ST_ABORT) { failed = step; }
        step = next;
    }
    if (failed != PRFH_ST_DONE) {
        if (fd >= 0) { sys_close(fd); }
        if (prfh_part_left(failed)) { sys_unlink(part); }
        return false;
    }
    return true;
}

/// Write profile.t27p with this nickname and picture flag (prf_emit). False when the text cannot be formed (the
/// nickname fails prf_nick_check), no path exists, or the atomic write failed.
fn prfh_write_profile(nick: []const u8, has_avatar: bool) -> bool {
    var doc : [PRF_DOC_MAX]u8 = undefined;
    const dn : usize = prf_emit(nick, has_avatar, doc[0..PRF_DOC_MAX]);
    if (dn == 0) { return false; }
    if (prfh_ensure_dir() == false) { return false; }
    var part : [PRFH_PATH_CAP]u8 = undefined;
    var target : [PRFH_PATH_CAP]u8 = undefined;
    if (prfh_path_of(PRF_F_PROFILE_PART, part[0..PRFH_PATH_CAP]) == 0) { return false; }
    if (prfh_path_of(PRF_F_PROFILE, target[0..PRFH_PATH_CAP]) == 0) { return false; }
    return prfh_atomic_write(part[0..PRFH_PATH_CAP], target[0..PRFH_PATH_CAP], doc[0..dn]);
}

/// Read profile.t27p once at window start: the nickname into `nick`, its length returned, res[0] = 1 when a picture
/// is shown (the file says so and avatar.png is there), res[1] = the nickname length. A missing, unreadable, foreign
/// or damaged file is "not set": length 0 and res[0] = 0, no failure.
pub fn prfh_load(nick: []u8, res: []u32) -> usize {
    res[0] = 0;
    res[1] = 0;
    var p : [PRFH_PATH_CAP]u8 = undefined;
    if (prfh_path_of(PRF_F_PROFILE, p[0..PRFH_PATH_CAP]) == 0) { return 0; }
    const fd : i32 = sys_open_ro(p[0..PRFH_PATH_CAP], 0);
    if (fd < 0) { return 0; }
    var text : [PRF_DOC_MAX + 1]u8 = undefined;
    const r : i64 = sys_read(fd, text[0..PRF_DOC_MAX + 1], @as(u64, PRF_DOC_MAX + 1));
    sys_close(fd);
    if (r <= 0) { return 0; }
    const n : usize = prfh_parse(text[0..@as(usize, @intCast(r))], nick, res);
    if (res[0] == 1) {
        var a : [PRFH_PATH_CAP]u8 = undefined;
        var here : bool = false;
        if (prfh_path_of(PRF_F_AVATAR, a[0..PRFH_PATH_CAP]) > 0) { here = prfh_exists(a[0..PRFH_PATH_CAP]); }
        if (prfh_avatar_shown(true, here) == false) { res[0] = 0; }
    }
    return n;
}

/// Where avatar.png is, for the window to decode once outside draw(); the path length, 0 when there is no home.
pub fn prfh_avatar_path(out: []u8) -> usize {
    return prfh_path_of(PRF_F_AVATAR, out);
}

/// SAVE: check the nickname (prf_nick_check), write profile.t27p atomically, and answer with prf_save_status
/// (PRF_OK_SAVED, a nickname verdict, or PRF_E_PROFILE_SAVE). The nickname already kept stays when the write fails.
pub fn prfh_save_nick(nick: []const u8, has_avatar: bool) -> u32 {
    const check : u32 = prf_nick_check(nick);
    if (check != PRF_OK) { return prf_save_status(check, false); }
    return prf_save_status(check, prfh_write_profile(nick, has_avatar));
}

/// REMOVE PICTURE: the flag is rewritten to 0 first, then avatar.png is unlinked; the nickname is not touched
/// (kept as `nick`, empty means "not set"). PRF_OK, or PRF_E_SAVE with the picture kept.
pub fn prfh_remove(nick: []const u8) -> u32 {
    const wrote : bool = prfh_write_profile(nick, false);
    if (wrote == false) { return prfh_remove_code(false); }
    var a : [PRFH_PATH_CAP]u8 = undefined;
    if (prfh_path_of(PRF_F_AVATAR, a[0..PRFH_PATH_CAP]) > 0) { sys_unlink(a[0..PRFH_PATH_CAP]); }
    return prfh_remove_code(true);
}

// ---------------------------------------------------------------- 5. the panel, the facts, the picture

/// The system file panel: the chosen path in out with a 0 byte, its length; 0 when the panel was cancelled or gave
/// no path. Only the hint of extensions and the message of profile.t27 go in; the real check is the content type.
fn prfh_panel(out: []u8) -> usize {
    const panel : u64 = send0(named_class("NSOpenPanel"), named_sel("openPanel"));
    if (panel == 0) { return 0; }
    const msg : u64 = text_of(PRF_PICK_MESSAGE);
    send1(panel, named_sel("setMessage:"), msg);
    cf_drop(msg);
    const hint : u64 = text_of(PRF_PICK_HINT);
    const sp : u64 = text_of(" ");
    const types : u64 = send1(hint, named_sel("componentsSeparatedByString:"), sp);
    send1(panel, named_sel("setAllowedFileTypes:"), types);
    cf_drop(hint);
    cf_drop(sp);
    send_flag(panel, named_sel("setCanChooseDirectories:"), false);
    send_flag(panel, named_sel("setAllowsMultipleSelection:"), false);
    if (send0(panel, named_sel("runModal")) != PRFH_PANEL_OK) { return 0; }
    const url : u64 = send0(panel, named_sel("URL"));
    if (url == 0) { return 0; }
    const path : u64 = send0(url, named_sel("path"));
    if (path == 0) { return 0; }
    if (send_text(path, named_sel("getCString:maxLength:encoding:"), out, @as(u64, out.len), @as(u64, PRFH_UTF8)) == false) { return 0; }
    return @as(usize, sys_strlen(sys_addr(out, out, 0)));
}

/// An integer property of the first image of a source ("PixelWidth", "PixelHeight"); 0 when it is not there.
fn prfh_prop(props: u64, name: []const u8) -> u64 {
    const key : u64 = text_of(name);
    const num : u64 = cf_dict_get(props, key);
    cf_drop(key);
    if (num == 0) { return 0; }
    var v : [8]u8 = undefined;
    var i : usize = 0;
    while (i < 8) {
        v[i] = 0;
        i = i + 1;
    }
    if (cf_num_get(num, PRFH_NUM_S64, v[0..8]) == false) { return 0; }
    var x : u64 = 0;
    var k : usize = 8;
    while (k > 0) {
        k = k - 1;
        x = x * 256 + @as(u64, v[k]);
    }
    return x;
}

/// What the file really is: the content type into uti (its length), res[0] = bytes in the file, res[1] = width and
/// res[2] = height in pixels (as u32, 0 when unknown). The type is what ImageIO reports, never the file name. A file
/// that cannot be opened, or ImageIO cannot read, gives length 0.
fn prfh_facts(path: []const u8, n: usize, uti: []u8, res: []u32) -> usize {
    res[0] = 0;
    res[1] = 0;
    res[2] = 0;
    const fd : i32 = sys_open_ro(path, 0);
    if (fd < 0) { return 0; }
    const size : i64 = sys_lseek(fd, 0, PRFH_SEEK_END);
    sys_close(fd);
    if (size < 0) { return 0; }
    // a size above u32 is far past the limit; cap it so the answer still says "too big"
    if (size > 4294967295) {
        res[0] = 4294967295;
    } else {
        res[0] = @as(u32, @intCast(size));
    }
    const src : u64 = img_source(file_url(path, n), 0);
    if (src == 0) { return 0; }
    var len : usize = 0;
    const t : u64 = img_type(src);
    if (t != 0 and cf_c_string(t, uti, @as(u64, uti.len), PRFH_UTF8)) {
        len = @as(usize, sys_strlen(sys_addr(uti, uti, 0)));
    }
    const props : u64 = img_props(src, 0, 0);
    if (props != 0) {
        const w : u64 = prfh_prop(props, "PixelWidth");
        const h : u64 = prfh_prop(props, "PixelHeight");
        if (w > 4294967295) { res[1] = 4294967295; } else { res[1] = @as(u32, @intCast(w)); }
        if (h > 4294967295) { res[2] = 4294967295; } else { res[2] = @as(u32, @intCast(h)); }
        cf_drop(props);
    }
    cf_drop(src);
    return len;
}

/// The avatar picture of a file that passed the checks: a thumbnail whose short side is >= PRF_AVATAR_PX with the
/// EXIF orientation applied (prf_thumb_max), its centred square (prf_crop_*) scaled to PRF_AVATAR_PX square. 0 when
/// ImageIO, the crop or the bitmap fails; the caller releases a non-zero image with img_drop.
fn prfh_square(path: []const u8, n: usize, w: u64, h: u64) -> u64 {
    const big : u64 = prf_thumb_max(w, h);
    if (big == 0) { return 0; }
    const src : u64 = img_source(file_url(path, n), 0);
    if (src == 0) { return 0; }
    const yes : u64 = send_flag(named_class("NSNumber"), named_sel("numberWithBool:"), true);
    const num : u64 = send1(named_class("NSNumber"), named_sel("numberWithUnsignedLongLong:"), big);
    var keys : [4]u64 = undefined;
    var vals : [4]u64 = undefined;
    keys[0] = text_of("kCGImageSourceCreateThumbnailFromImageAlways");
    vals[0] = yes;
    keys[1] = text_of("kCGImageSourceThumbnailMaxPixelSize");
    vals[1] = num;
    keys[2] = text_of("kCGImageSourceCreateThumbnailWithTransform");
    vals[2] = yes;
    keys[3] = text_of("kCGImageSourceShouldCacheImmediately");
    vals[3] = yes;
    const opts : u64 = send_dict4(named_class("NSDictionary"), named_sel("dictionaryWithObjects:forKeys:count:"), vals, keys, 4);
    const thumb : u64 = img_thumbnail(src, 0, opts);
    cf_drop(keys[0]);
    cf_drop(keys[1]);
    cf_drop(keys[2]);
    cf_drop(keys[3]);
    cf_drop(src);
    if (thumb == 0) { return 0; }
    const tw : u64 = img_width(thumb);
    const th : u64 = img_height(thumb);
    const side : u64 = prf_crop_side(tw, th);
    if (side == 0) {
        img_drop(thumb);
        return 0;
    }
    const cut : u64 = img_cut(thumb, @as(f64, @floatFromInt(prf_crop_x(tw, th))), @as(f64, @floatFromInt(prf_crop_y(tw, th))), @as(f64, @floatFromInt(side)), @as(f64, @floatFromInt(side)));
    img_drop(thumb);
    if (cut == 0) { return 0; }
    const sp : u64 = space_rgb();
    const px : usize = @as(usize, PRF_AVATAR_PX);
    const ctx : u64 = bmp_make(0, px, px, 8, px * 4, sp, PRFH_ALPHA_LAST);
    space_drop(sp);
    if (ctx == 0) {
        img_drop(cut);
        return 0;
    }
    bmp_quality(ctx, PRFH_QUALITY_HIGH);
    bmp_draw(ctx, 0.0, 0.0, @as(f64, @floatFromInt(PRF_AVATAR_PX)), @as(f64, @floatFromInt(PRF_AVATAR_PX)), cut);
    const out : u64 = bmp_image(ctx);
    img_drop(cut);
    bmp_drop(ctx);
    return out;
}

/// Encode a picture as a PNG into the file at path (the .part). True when ImageIO finished it.
fn prfh_encode_png(img: u64, path: []const u8, n: usize) -> bool {
    const kind : u64 = text_of("public.png");
    const dest : u64 = dest_make(file_url(path, n), kind, 1, 0);
    cf_drop(kind);
    if (dest == 0) { return false; }
    dest_add(dest, img, 0);
    const ok : bool = dest_end(dest);
    cf_drop(dest);
    return ok;
}

/// CHOOSE PICTURE: open the panel, check the real file against the limits, make the square PNG and put it in place.
/// `nick` is the nickname the profile already keeps (empty = not set) and `had` whether a picture is set now.
/// PRF_OK when the new picture is in place; PRF_E_CANCELLED (no line, nothing shown) when the panel was cancelled;
/// otherwise the code of the failure (prf_picture_check, PRF_E_UNREADABLE, PRF_E_SAVE). On any failure the previous
/// picture and nickname stay. The caller takes the picture flag from prf_has_after_pick(had, code).
pub fn prfh_pick(nick: []const u8, had: bool) -> u32 {
    var chosen : [PRFH_PATH_CAP]u8 = undefined;
    const cn : usize = prfh_panel(chosen[0..PRFH_PATH_CAP]);
    if (cn == 0) { return PRF_E_CANCELLED; }
    var uti : [PRFH_UTI_CAP]u8 = undefined;
    var f : [3]u32 = undefined;
    const un : usize = prfh_facts(chosen[0..cn], cn, uti[0..PRFH_UTI_CAP], f[0..3]);
    const code : u32 = prfh_facts_code(false, un > 0, uti[0..un], @as(u64, f[0]), @as(u64, f[1]), @as(u64, f[2]));
    if (code != PRF_OK) { return code; }
    if (prfh_ensure_dir() == false) { return prfh_stage_code(PRFH_X_COMMIT); }
    const img : u64 = prfh_square(chosen[0..cn], cn, @as(u64, f[1]), @as(u64, f[2]));
    if (img == 0) { return prfh_stage_code(PRFH_X_DECODE); }
    var part : [PRFH_PATH_CAP]u8 = undefined;
    var target : [PRFH_PATH_CAP]u8 = undefined;
    const pn : usize = prfh_path_of(PRF_F_AVATAR_PART, part[0..PRFH_PATH_CAP]);
    const tn : usize = prfh_path_of(PRF_F_AVATAR, target[0..PRFH_PATH_CAP]);
    if (pn == 0 or tn == 0) {
        img_drop(img);
        return prfh_stage_code(PRFH_X_COMMIT);
    }
    const encoded : bool = prfh_encode_png(img, part[0..pn], pn);
    img_drop(img);
    if (encoded == false) {
        sys_unlink(part[0..PRFH_PATH_CAP]);
        return prfh_stage_code(PRFH_X_ENCODE);
    }
    // a first picture: the flag goes in before the rename (see prfh_pick_writes_flag)
    if (prfh_pick_writes_flag(had) and prfh_write_profile(nick, true) == false) {
        sys_unlink(part[0..PRFH_PATH_CAP]);
        return prfh_stage_code(PRFH_X_COMMIT);
    }
    if (sys_rename(part[0..PRFH_PATH_CAP], target[0..PRFH_PATH_CAP]) != 0) {
        sys_unlink(part[0..PRFH_PATH_CAP]);
        if (prfh_pick_writes_flag(had)) { prfh_write_profile(nick, false); }
        return prfh_stage_code(PRFH_X_COMMIT);
    }
    return PRF_OK;
}

// ---------------------------------------------------------------- tests (pure fns only; the host calls above are not run)

/// A buffer of n bytes holding a copy of s at the start; the length (a test helper, no host call).
fn prfh_t_copy(b: []u8, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len and i < b.len) {
        b[i] = s[i];
        i = i + 1;
    }
    return i;
}

test prfh_an_atomic_write_runs_its_steps_in_order_and_only_the_rename_touches_the_target {
    var s : u32 = PRFH_ST_CREATE;
    assert PRFH_ST_CREATE == 0 and PRFH_ST_WRITE == 1 and PRFH_ST_SYNC == 2 and PRFH_ST_CLOSE == 3 and PRFH_ST_RENAME == 4;
    s = prfh_next_step(s, true);
    assert s == PRFH_ST_WRITE;
    s = prfh_next_step(s, true);
    assert s == PRFH_ST_SYNC;
    s = prfh_next_step(s, true);
    assert s == PRFH_ST_CLOSE;
    s = prfh_next_step(s, true);
    assert s == PRFH_ST_RENAME;
    s = prfh_next_step(s, true);
    assert s == PRFH_ST_DONE;
    // a finished or unknown step goes nowhere
    assert prfh_next_step(PRFH_ST_DONE, true) == PRFH_ST_ABORT;
    assert prfh_next_step(PRFH_ST_ABORT, true) == PRFH_ST_ABORT;
    assert prfh_next_step(99, true) == PRFH_ST_ABORT;
    // only the rename changes the target
    assert prfh_touches_target(PRFH_ST_CREATE) == false;
    assert prfh_touches_target(PRFH_ST_WRITE) == false;
    assert prfh_touches_target(PRFH_ST_SYNC) == false;
    assert prfh_touches_target(PRFH_ST_CLOSE) == false;
    assert prfh_touches_target(PRFH_ST_RENAME);
    assert prfh_touches_target(PRFH_ST_DONE) == false;
}

test prfh_a_failure_at_any_step_aborts_and_the_target_is_never_reached {
    var step : u32 = 0;
    while (step <= PRFH_ST_RENAME) {
        assert prfh_next_step(step, false) == PRFH_ST_ABORT;
        step = step + 1;
    }
    // the steps before the rename leave the target as it was
    assert prfh_touches_target(PRFH_ST_CREATE) == false and prfh_touches_target(PRFH_ST_SYNC) == false;
    // the .part is unlinked once it exists; a failed create made nothing
    assert prfh_part_left(PRFH_ST_CREATE) == false;
    assert prfh_part_left(PRFH_ST_WRITE);
    assert prfh_part_left(PRFH_ST_SYNC);
    assert prfh_part_left(PRFH_ST_CLOSE);
    assert prfh_part_left(PRFH_ST_RENAME);
    assert prfh_part_left(PRFH_ST_DONE) == false;
    // a short write is a failed write
    assert prfh_all_written(100, 100);
    assert prfh_all_written(99, 100) == false;
    assert prfh_all_written(0, 100) == false;
    assert prfh_all_written(0, 0);
}

test prfh_a_cancelled_panel_is_no_error_and_changes_nothing {
    assert prfh_facts_code(true, true, "public.png", 1000, 100, 100) == PRF_E_CANCELLED;
    assert prfh_facts_code(true, false, "", 0, 0, 0) == PRF_E_CANCELLED;
    // the cancel has no line, so nothing is shown, and the picture flag is kept as it was
    assert prfh_facts_code(true, false, "", 0, 0, 0) == 8;
}

test prfh_facts_become_the_codes_of_the_profile_spec {
    assert prfh_facts_code(false, true, "public.png", 1000, 100, 100) == PRF_OK;
    assert prfh_facts_code(false, true, "public.jpeg", 20971520, 8192, 4000) == PRF_OK;
    assert prfh_facts_code(false, true, "public.heic", 1000, 8000, 5000) == PRF_OK;
    // by the real type, not the name: a GIF is refused whatever the file is called
    assert prfh_facts_code(false, true, "com.compuserve.gif", 1000, 100, 100) == 1;
    assert prfh_facts_code(false, true, "public.tiff", 1000, 100, 100) == 1;
    assert prfh_facts_code(false, true, "public.png", 20971521, 100, 100) == 2;
    assert prfh_facts_code(false, true, "public.png", 1000, 8193, 100) == 3;
    assert prfh_facts_code(false, true, "public.png", 1000, 8000, 5001) == 4;
    assert prfh_facts_code(false, true, "public.png", 1000, 31, 100) == 5;
    // an unreadable file, or a type ImageIO could not name, is unreadable (no type text is guessed)
    assert prfh_facts_code(false, false, "public.png", 1000, 100, 100) == PRF_E_UNREADABLE;
    assert prfh_facts_code(false, true, "", 1000, 100, 100) == PRF_E_UNREADABLE;
    // unreadable is told before any limit
    assert prfh_facts_code(false, false, "", 99999999, 99999, 99999) == PRF_E_UNREADABLE;
}

test prfh_a_failed_stage_maps_to_a_fixed_code {
    assert prfh_stage_code(PRFH_X_DECODE) == PRF_E_UNREADABLE;
    assert prfh_stage_code(PRFH_X_CROP) == PRF_E_UNREADABLE;
    assert prfh_stage_code(PRFH_X_ENCODE) == PRF_E_SAVE;
    assert prfh_stage_code(PRFH_X_COMMIT) == PRF_E_SAVE;
    assert prfh_stage_code(77) == PRF_E_SAVE;
    // the codes are the ones whose lines the window shows
    assert PRF_E_UNREADABLE == 6 and PRF_E_SAVE == 7;
}

test prfh_the_flag_is_written_before_the_picture_and_a_dangling_flag_shows_no_picture {
    assert prfh_pick_writes_flag(false);
    assert prfh_pick_writes_flag(true) == false;
    assert prfh_avatar_shown(true, true);
    assert prfh_avatar_shown(true, false) == false;
    assert prfh_avatar_shown(false, true) == false;
    assert prfh_avatar_shown(false, false) == false;
    // a failed removal keeps the picture and says so
    assert prfh_remove_code(true) == PRF_OK;
    assert prfh_remove_code(false) == PRF_E_SAVE;
}

test prfh_the_parent_folder_of_a_profile_path_is_found {
    var b : [PRFH_PATH_CAP]u8 = undefined;
    const n : usize = prf_path("/Users/ann", PRF_F_DIR, b[0..PRFH_PATH_CAP]);
    assert n == 25;
    // <home>/.t27os is the parent of <home>/.t27os/profile
    const up : usize = prfh_parent_len(b[0..n]);
    assert up == 17;
    assert b[up] == 47;
    assert prfh_parent_len("/") == 0;
    assert prfh_parent_len("") == 0;
    assert prfh_parent_len("abc") == 0;
    assert prfh_parent_len("/abc") == 0;
    assert prfh_parent_len("/a/b") == 2;
    // the file kinds sit in the same folder
    const f : usize = prf_path("/Users/ann", PRF_F_AVATAR_PART, b[0..PRFH_PATH_CAP]);
    assert f == 25 + 1 + 15;
    assert prfh_parent_len(b[0..f]) == n;
    // no home, a relative home or a home too long for the buffer gives no path, so no file is touched
    assert prf_path("", PRF_F_PROFILE, b[0..PRFH_PATH_CAP]) == 0;
    assert prf_path("Users/ann", PRF_F_PROFILE, b[0..PRFH_PATH_CAP]) == 0;
    assert prf_path("/Users/ann", PRF_F_PROFILE, b[0..20]) == 0;
}

test prfh_the_part_and_the_target_are_different_files_in_one_folder {
    var t : [PRFH_PATH_CAP]u8 = undefined;
    var p : [PRFH_PATH_CAP]u8 = undefined;
    const tn : usize = prf_path("/Users/ann/", PRF_F_PROFILE, t[0..PRFH_PATH_CAP]);
    const pn : usize = prf_path("/Users/ann/", PRF_F_PROFILE_PART, p[0..PRFH_PATH_CAP]);
    assert tn == 25 + 1 + 12;
    assert pn == tn + 5;
    // the part path is the target path plus ".part"
    var i : usize = 0;
    var same : bool = true;
    while (i < tn) {
        if (t[i] != p[i]) { same = false; }
        i = i + 1;
    }
    assert same;
    assert p[tn] == 46 and p[tn + 1] == 112 and p[tn + 2] == 97 and p[tn + 3] == 114 and p[tn + 4] == 116;
    assert prfh_parent_len(t[0..tn]) == prfh_parent_len(p[0..pn]);
    // the same for the picture
    const at : usize = prf_path("/Users/ann", PRF_F_AVATAR, t[0..PRFH_PATH_CAP]);
    const ap : usize = prf_path("/Users/ann", PRF_F_AVATAR_PART, p[0..PRFH_PATH_CAP]);
    assert ap == at + 5;
    assert t[at] == 0 and p[ap] == 0;
}

test prfh_a_profile_reads_back_through_the_same_functions {
    var doc : [PRF_DOC_MAX]u8 = undefined;
    var nick : [PRF_NICK_MAX_BYTES]u8 = undefined;
    var res : [2]u32 = undefined;
    // written with a nickname and a picture, read back: the same nickname and flag
    const dn : usize = prf_emit("ann", true, doc[0..PRF_DOC_MAX]);
    assert dn == 35;
    const n : usize = prfh_parse(doc[0..dn], nick[0..PRF_NICK_MAX_BYTES], res[0..2]);
    assert n == 3;
    assert nick[0] == 97 and nick[1] == 110 and nick[2] == 110;
    assert res[0] == 1 and res[1] == 3;
    // no nickname, no picture
    const en : usize = prf_emit("", false, doc[0..PRF_DOC_MAX]);
    assert en == 32;
    assert prfh_parse(doc[0..en], nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0 and res[1] == 0;
    // a nickname that fails the rules is never written
    assert prf_emit(" ann", true, doc[0..PRF_DOC_MAX]) == 0;
    // SAVE of such a nickname answers with the nickname verdict (spaces = 15) and never tries the write
    assert prf_save_status(prf_nick_check("a  b"), false) == 15;
}

test prfh_a_missing_foreign_or_damaged_profile_reads_as_not_set {
    var nick : [PRF_NICK_MAX_BYTES]u8 = undefined;
    var res : [2]u32 = undefined;
    var buf : [PRF_DOC_MAX + 40]u8 = undefined;
    // a missing file is an empty text
    assert prfh_parse("", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0 and res[1] == 0;
    // a foreign text, a wrong header, a cut file
    assert prfh_parse("hello", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0;
    assert prfh_parse("t27os.profile.v2\nnick=ann\navatar=1\n", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0;
    assert prfh_parse("t27os.profile.v1\nnick=ann\navatar=1", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0;
    assert prfh_parse("t27os.profile.v1\nnick=ann\navatar=2\n", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0;
    // a stored nickname that breaks the rules is not trusted, and neither is the picture flag beside it
    assert prfh_parse("t27os.profile.v1\nnick= ann\navatar=1\n", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0;
    // a file longer than the longest profile text is damaged, even when its start is well formed
    var n : usize = prfh_t_copy(buf[0..PRF_DOC_MAX + 40], "t27os.profile.v1\nnick=ann\navatar=1\n");
    while (n < PRF_DOC_MAX + 40) {
        buf[n] = 120;
        n = n + 1;
    }
    assert prfh_parse(buf[0..PRF_DOC_MAX + 40], nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 0 and res[1] == 0;
    // a picture flag without a nickname is a picture with no nickname
    assert prfh_parse("t27os.profile.v1\nnick=\navatar=1\n", nick[0..PRF_NICK_MAX_BYTES], res[0..2]) == 0;
    assert res[0] == 1 and res[1] == 0;
}

test prfh_the_picture_sizes_the_host_asks_for_come_from_the_profile_spec {
    // a 4000 x 3000 photo: ImageIO is asked for a long side of 342 (ceil(256 * 4000 / 3000)), the crop is 256
    assert prf_thumb_max(4000, 3000) == 342;
    assert prf_crop_side(342, 256) == 256;
    assert prf_crop_x(342, 256) == 43;
    assert prf_crop_y(342, 256) == 0;
    // a picture that failed the checks is never decoded
    assert prf_thumb_max(8193, 100) == 0;
    assert prf_thumb_max(0, 100) == 0;
    assert PRFH_ALPHA_LAST == 1;
    assert PRFH_FILE_MODE == 6 * 64;
    assert PRFH_PATH_CAP > 512 + 40;
}

invariant prfh_the_buffers_hold_what_the_profile_spec_writes {
    assert PRFH_UTI_CAP > 12;
    assert PRFH_PATH_CAP >= 512 + 1 + 40;
    assert PRF_DOC_MAX >= PRF_NICK_MAX_BYTES + 32;
}
