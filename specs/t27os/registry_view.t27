// SPDX-License-Identifier: Apache-2.0
// specs/t27os/registry_view.t27 -- t27os: read registry view codes from the
// registry - queen dash cards 3 and 7 are mispaired.
// Part of M4 milestone (milestone #8). Closes #13901.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::registry_view_codes;

pub const REGISTRY_VIEW_CARDS : u32 = 7;

pub struct RegistryViewCard { card_number: u32, correctly_paired: bool };

pub fn registry_view_card_correctly_paired(c: RegistryViewCard) -> bool {
    return c.correctly_paired;
}

test "registry_view_card_correctly_paired" {
    assert(registry_view_card_correctly_paired(RegistryViewCard { card_number: 3, correctly_paired: true }));
    assert(!registry_view_card_correctly_paired(RegistryViewCard { card_number: 7, correctly_paired: false }));
}

invariant registry_view_cards_defined {
    assert REGISTRY_VIEW_CARDS == 7;
}