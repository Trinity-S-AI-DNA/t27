// specs/t27os/layout_anomaly.t27 -- Layout anomaly detector for chat_layout.
// Part of M1 (milestone #5). Closes #13188.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::layout_anomaly;

pub const LAYOUT_ANOMALY_DETECTED : bool = false;

pub struct LayoutAnomaly { overlap: bool, stale_rect: bool };

pub fn layout_anomaly_present(a: LayoutAnomaly) -> bool {
    return a.overlap || a.stale_rect;
}

test "layout anomaly present" {
    assert(layout_anomaly_present(LayoutAnomaly { overlap: true, stale_rect: false }));
    assert(!layout_anomaly_present(LayoutAnomaly { overlap: false, stale_rect: false }));
}

invariant layout_anomaly_detected_default {
    assert !LAYOUT_ANOMALY_DETECTED;
}