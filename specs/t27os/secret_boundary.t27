// SPDX-License-Identifier: Apache-2.0
; The secret boundary of the promotion kernel (#14225, M0-P8, see #13473).
; One scan, run before any promotion or push, proves that no secret, token,
; cookie or key value entered the repo tree, a release asset, an evidence log
; or a promotion ledger entry. The scan records NAMES and SHA256 digests only;
; a secret VALUE never appears in a finding, a report, a log or a commit
; message. The deny-name table is the Lamb Labs .gitignore baseline (commit
; a7ef751 on gHashTag/t27-lamb-labs), reused here as data so both homes scan
; with the same vocabulary. A promotion gate (#14221 verdicts) refuses to run
; a promotion while the scan is dirty (FR-003). Worked example: the
; t27os-ladder-512k-caps release assets scan clean by name.
; The local secret stores (~/.t27os/keys, admin-token, ~/.dsh/.credentials.yaml)
; are out of boundary: they are never read, printed or moved by this spec.
module T27OsSecretBoundary;

pub const SURFACE_COUNT : usize = 4;
pub const SURFACE_REPO_TREE : usize = 0;
pub const SURFACE_RELEASE_ASSETS : usize = 1;
pub const SURFACE_EVIDENCE_LOGS : usize = 2;
pub const SURFACE_PROMOTION_LEDGER : usize = 3;
pub const SURFACES : [4]str = ["repo_tree", "release_assets", "evidence_logs", "promotion_ledger"];

; deny-name baseline: the Lamb Labs .gitignore patterns as data (FR-002)
pub const DENY_COUNT : usize = 12;
pub const DENY_NAMES : [12]str = ["dsh.json", ".env", "*.env", "secrets.json", "credentials.json", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "*.p12", "cookies.txt", "local-logs/"];

; the 2026-11-22 release assets this boundary has scanned clean, by name only
pub const ASSET_COUNT : usize = 5;
pub const ASSET_NAMES : [5]str = ["ladder-native-macos-arm64", "ladder-native-macos-arm64.sigstore.json", "SHA256SUMS", "SHA256SUMS.sigstore.json", "trinity-sbom.json"];

pub fn same_key(a : str, b : str) -> bool {
    let la : usize = a.len;
    let lb : usize = b.len;
    if la != lb { return false; }
    var i : usize = 0;
    while i < la {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

pub fn surface_named(name : str) -> bool {
    var i : usize = 0;
    while i < SURFACE_COUNT {
        if same_key(SURFACES[i], name) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn deny_name(name : str) -> bool {
    var i : usize = 0;
    while i < DENY_COUNT {
        if same_key(DENY_NAMES[i], name) { return true; }
        i = i + 1;
    }
    return false;
}

; a finding may carry the file name and its sha256, never the value (FR-001)
pub fn finding_record_allowed(has_name : bool, has_sha256 : bool, has_value : bool) -> bool {
    return has_name and has_sha256 and (has_value == false);
}

; FR-003: the promotion gate refuses while the scan is dirty
pub fn scan_blocks_promotion(dirty : bool) -> bool {
    return dirty;
}

test the_scan_covers_four_surfaces {
    assert SURFACE_COUNT == 4;
    assert surface_named("repo_tree");
    assert surface_named("release_assets");
    assert surface_named("evidence_logs");
    assert surface_named("promotion_ledger");
    assert surface_named("home_directory") == false;
}

test the_deny_table_carries_the_gitignore_baseline {
    assert deny_name("dsh.json");
    assert deny_name(".env");
    assert deny_name("secrets.json");
    assert deny_name("credentials.json");
    assert deny_name("id_rsa*");
    assert deny_name("cookies.txt");
    assert deny_name("local-logs/");
    assert deny_name("README.md") == false;
}

test a_finding_records_name_and_sha256_never_a_value {
    assert finding_record_allowed(true, true, false);
    assert finding_record_allowed(true, false, false) == false;
    assert finding_record_allowed(false, true, false) == false;
    assert finding_record_allowed(true, true, true) == false;
}

test a_dirty_scan_blocks_the_promotion_gate {
    assert scan_blocks_promotion(true);
    assert scan_blocks_promotion(false) == false;
}

test the_2026_11_22_release_assets_scan_clean_by_name {
    assert ASSET_COUNT == 5;
    assert same_key(ASSET_NAMES[0], "ladder-native-macos-arm64");
    assert same_key(ASSET_NAMES[2], "SHA256SUMS");
    assert same_key(ASSET_NAMES[4], "trinity-sbom.json");
    assert deny_name(ASSET_NAMES[0]) == false;
    assert deny_name(ASSET_NAMES[4]) == false;
}
