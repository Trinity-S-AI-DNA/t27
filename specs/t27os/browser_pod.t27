// SPDX-License-Identifier: Apache-2.0
; Closes #11392
; specs/t27os/browser_pod.t27 -- LAYER 1: the browser pod. A MODEL ONLY: the
; TypeScript pod lives in the trios repo and is the witness of this contract;
; this file models its laws as pure computation for t27b.
; -
; THE CDP LAW. Chrome DevTools Protocol listens on CDP_INTERNAL_PORT inside
; the container and is loopback-only there. It is NEVER published to the host
; or to any network: the only outside doors are the bridge port and the mux.
; A publish request is refused by law, not by configuration.
; -
; THE BRIDGE PORT. The CDP bridge is a WebSocket mux; its port IS the mux port
; of the pod. There is no separate mapping table: bridge_port_of(mux) = mux.
; -
; THE PROFILE VOLUME. One named Docker volume per profile id, always the
; fixed prefix plus the id, so the name is deterministic across recreations.
; -
; THE DEVTOOLS POLICY. Chromium refuses the bridge unless
; DeveloperToolsAvailability = 2 (POLICY_ENFORCED). Anything else, including
; the default, is a refusal.
; -
; THE POD IDENTITY. One pod per telegram_id: a pod claimed by owner A is not
; claimable by owner B while it lives.
; ASCII only (L3). English only (LANG-EN). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsBrowserPod;

; --- 1. Constants -----------------------------------------------------------------------

pub const CDP_INTERNAL_PORT : u32 = 9222;
pub const CDP_BRIDGE_PORT : u32 = 9223;
pub const WEBRTC_MUX_MIN : u32 = 52000;
pub const WEBRTC_MUX_MAX : u32 = 52999;
pub const PROFILE_VOLUME_PREFIX : string = "t27-browser-profile-";

pub const POLICY_ENFORCED : u32 = 2;
pub const POLICY_DEFAULT : u32 = 1;
pub const POLICY_DISABLED : u32 = 0;

; Refusal codes
pub const R_OK : u8 = 0;
pub const R_CDP_PUBLISH : u8 = 1;
pub const R_POLICY_NOT_ENFORCED : u8 = 2;
pub const R_MUX_OUT_OF_RANGE : u8 = 3;
pub const R_POD_TAKEN : u8 = 4;
pub const R_PROFILE_EMPTY : u8 = 5;

; --- 2. Prefix law: a byte-wise prefix test used below -----------------------------------

pub fn starts_with(s : string, pre : string) -> bool {
    if (s.len < pre.len) { return false; }
    var ii : u32 = 0;
    while (ii < (pre.len as u32)) {
        if ((s[ii] as u32) != (pre[ii] as u32)) { return false; }
        ii = ii + 1;
    }
    return true;
}

; --- 3. Bridge port = mux port -----------------------------------------------------------

/// The bridge port of a pod IS its mux port; the mapping is the identity and
/// the mux port must sit inside WEBRTC_MUX_MIN .. WEBRTC_MUX_MAX.
pub fn bridge_port_of(mux_port : u32) -> u32 {
    return mux_port;
}

pub fn mux_in_range(mux_port : u32) -> bool {
    return mux_port >= WEBRTC_MUX_MIN and mux_port <= WEBRTC_MUX_MAX;
}

/// Full bridge admission: in range, and the round-trip holds.
pub fn bridge_refusal(mux_port : u32) -> u8 {
    if (!mux_in_range(mux_port)) { return R_MUX_OUT_OF_RANGE; }
    return R_OK;
}

; --- 4. Profile volume name ---------------------------------------------------------------

/// The volume name law: name = prefix + id, nothing else. Held byte-wise so
/// the check needs no string concat: the caller passes the concrete name the
/// pod driver built (the TS pod is the witness that it does).
pub fn volume_name_ok(name : string, profile_id : string) -> bool {
    if (!starts_with(name, PROFILE_VOLUME_PREFIX)) { return false; }
    var total : u32 = (PROFILE_VOLUME_PREFIX.len + profile_id.len) as u32;
    if ((name.len as u32) != total) { return false; }
    var ii : u32 = (PROFILE_VOLUME_PREFIX.len) as u32;
    var jj : u32 = 0;
    while (jj < (profile_id.len as u32)) {
        if ((name[ii] as u32) != (profile_id[jj] as u32)) { return false; }
        ii = ii + 1;
        jj = jj + 1;
    }
    return true;
}

/// Deterministic across recreations: the law is a pure function of the id,
/// so two names for one id are always equal byte for byte.
pub fn volume_name_stable(a : string, b : string) -> bool {
    return bytes_same(a, b);
}

/// Byte-wise equality of two strings, used where == is not enough. The one home of this body
/// for the browser modules (browser_broker and browser_proxy import it).
pub fn bytes_same(a : string, b : string) -> bool {
    if (a.len != b.len) { return false; }
    var ii : u32 = 0;
    while (ii < (a.len as u32)) {
        if ((a[ii] as u32) != (b[ii] as u32)) { return false; }
        ii = ii + 1;
    }
    return true;
}

pub fn volume_refusal(profile_id : string) -> u8 {
    if (profile_id.len == 0) { return R_PROFILE_EMPTY; }
    return R_OK;
}

; --- 5. DevTools policy guard ---------------------------------------------------------------

pub fn devtools_policy_refusal(policy : u32) -> u8 {
    if (policy == POLICY_ENFORCED) { return R_OK; }
    return R_POLICY_NOT_ENFORCED;
}

; --- 6. CDP publish law ---------------------------------------------------------------------

/// CDP is loopback-only inside the container: any publish is refused.
pub fn cdp_publish_refusal(want_publish : bool) -> u8 {
    if (want_publish) { return R_CDP_PUBLISH; }
    return R_OK;
}

/// The only doors a pod exposes: the bridge mux port. CDP_INTERNAL_PORT is
/// never among them.
pub fn pod_door_ok(port : u32) -> bool {
    if (port == CDP_INTERNAL_PORT) { return false; }
    return mux_in_range(port);
}

; --- 7. One pod per telegram_id ---------------------------------------------------------------

/// A living pod holds its owner. Same owner: claim ok. Other owner: refused.
pub fn pod_claim_refusal(live : bool, owner_now : string, owner_ask : string) -> u8 {
    if (!live) { return R_OK; }
    if (owner_now == owner_ask) { return R_OK; }
    return R_POD_TAKEN;
}

invariant cdp_is_never_published {
    assert cdp_publish_refusal(true) == R_CDP_PUBLISH;
    assert cdp_publish_refusal(false) == R_OK;
    assert !pod_door_ok(CDP_INTERNAL_PORT);
    assert pod_door_ok(52100);
}

invariant bridge_is_the_mux {
    assert bridge_port_of(52123) == 52123;
    assert mux_in_range(WEBRTC_MUX_MIN) and mux_in_range(WEBRTC_MUX_MAX);
    assert !mux_in_range(WEBRTC_MUX_MIN - 1) and !mux_in_range(WEBRTC_MUX_MAX + 1);
}

invariant policy_must_be_enforced {
    assert devtools_policy_refusal(POLICY_ENFORCED) == R_OK;
    assert devtools_policy_refusal(POLICY_DEFAULT) == R_POLICY_NOT_ENFORCED;
    assert devtools_policy_refusal(POLICY_DISABLED) == R_POLICY_NOT_ENFORCED;
}

test bridge_port_round_trips {
    assert bridge_refusal(WEBRTC_MUX_MIN) == R_OK;
    assert bridge_refusal(WEBRTC_MUX_MAX) == R_OK;
    assert bridge_refusal(9223) == R_MUX_OUT_OF_RANGE;
    assert bridge_refusal(53000) == R_MUX_OUT_OF_RANGE;
    var m : u32 = 52001;
    while (m <= 52020) {
        assert(bridge_port_of(bridge_port_of(m)) == m);
        assert(mux_in_range(bridge_port_of(m)));
        m = m + 1;
    }
}

test volume_name_is_deterministic_and_prefixed {
    var n1 : string = "t27-browser-profile-p1";
    var n1b : string = "t27-browser-profile-p1";
    var n2 : string = "t27-browser-profile-p2";
    assert(volume_name_ok(n1, "p1"));
    assert(!volume_name_ok(n2, "p1"));
    assert(volume_name_stable(n1, n1b));
    assert(!volume_name_stable(n1, n2));
    assert(starts_with(n1, PROFILE_VOLUME_PREFIX));
    assert(volume_refusal("") == R_PROFILE_EMPTY);
    assert(volume_refusal("abc") == R_OK);
}

test cdp_publish_refused_and_doors_named {
    assert(cdp_publish_refusal(true) != R_OK);
    assert(pod_door_ok(CDP_BRIDGE_PORT) == false);
    assert(pod_door_ok(52999));
    assert(pod_claim_refusal(true, "tg1", "tg1") == R_OK);
    assert(pod_claim_refusal(true, "tg1", "tg2") == R_POD_TAKEN);
    assert(pod_claim_refusal(false, "", "tg2") == R_OK);
}
