// ---------------------------------------------------------------- the block

/// Endpoint of call_crypto_probe (EP_LEN = 960 bytes) at 0; then 64 u64 slots; then the last handshake message
/// (INVITE, ANSWER or REVEAL) and the last CONFIRM, kept for resends; the peer's sockaddr; the event ring; and at
/// CS_AUD the part F audio block of callback_probe (87680 bytes), whose address the audio callbacks receive.
pub const CS_SLOTS : usize = 960;
pub const CS_L1 : usize = 1472;
pub const CS_L2 : usize = 1728;
pub const CS_PADDR : usize = 1856;
pub const CS_EVQ : usize = 1872;
pub const CS_EVQ_N : u64 = 16;
pub const CS_AUD : usize = 2048;
/// After the audio block: 1024 bytes for the group call (96 u64 slots, then a 128 byte control body). One block is
/// one link of a group; a window holds up to GR_PEERS blocks side by side, link 0 first (it owns the socket and the
/// devices) and the group-wide slots live in the block of link 0.
pub const CS_GRP : usize = 89728;
pub const CS_GRP_LEN : usize = 1024;
pub const CS_GBODY : usize = 768;
/// After the group region: the video of a one to one call (owner, 2026-10-22). 1024 bytes of slots (the first VR_LEN
/// are the receiver's assembly state of call_core, then u64 slots VT_*), then three buffers of CS_VBUF bytes: the JPEG
/// in assembly, the last complete JPEG (what the window decodes) and the latest camera JPEG handed in by
/// cs_video_feed. Only link 0 uses them.
pub const CS_VID : usize = 90752;
pub const CS_VSLOTS : usize = 1024;
pub const CS_VBUF : usize = 24576;
pub const CS_VASM : usize = 91776;
pub const CS_VLAST : usize = 116352;
pub const CS_VCAM : usize = 140928;
/// After the video region: this device's identity and the peer's for the identity proof (1024 bytes, per link). Bytes
/// CI_ON .. CI_PUB are flags (CI_ON and the key pair stay across calls, the rest is cleared by cs_fresh); then the
/// own public key, the own private key (wiped by cs_close), the peer's stored key, the key the peer showed, the own
/// signature of this call and the sealed IDENT kept for resends.
pub const CS_ID : usize = 165504;
pub const CS_ID_LEN : usize = 1024;
/// The peer's address in full (owner, 2026-10-23, IPv6; call_ip6.t27), in the last 256 bytes of the identity region,
/// so cs_fresh clears it with the rest of the last peer: the sockaddr the socket sends to (sockaddr_in6, or
/// sockaddr_in on an IPv4 socket), its length, then the endpoint (16 bytes of address, the port). CS_PADDR is no
/// longer used: an IPv6 sockaddr is 28 bytes. Past CN6_KEEP, kept across calls (cs_id_fresh stops there): the last
/// verified endpoint (cs_verified_ep), the fingerprint and endpoint of the last call that was ACTIVE with the peer's
/// identity verified or stored, and when it was last seen so (ms). Only it may give another part of the window (the
/// chat) an address: an INVITE alone names any fingerprint from any address.
pub const CS_NET : usize = 166272;
const CN6_SA : usize = 0;
const CN6_SALEN : usize = 28;
const CN6_EP : usize = 32;
const CN6_KEEP : usize = 64;
const CN6_VFP : usize = 64;
const CN6_VEP : usize = 80;
const CN6_VAT : usize = 104;
/// The per-call net slots: datagrams not sent because they were bigger than IPv6 carries (IP6_UDP_MAX), in the
/// group region's per-call part (LG 3); INVITEs refused for their sender (ip6_from_ok), per link (LG 28).
const LG_BIG6 : u32 = 3;
const LG_FROM6 : u32 = 28;
/// cs_net(s, k).
pub const CS_NET_FAM : u32 = 0;
pub const CS_NET_SOCK6 : u32 = 1;
pub const CS_NET_BIG : u32 = 2;
pub const CS_NET_NOFROM : u32 = 3;
pub const CS_NET_COPY_TX : u32 = 4;
pub const CS_NET_COPY_RX : u32 = 5;
pub const CS_NET_CLOEXEC : u32 = 6;
/// What cs_peer gives for a native IPv6 peer: not an IPv4 (2^32), never 0 while there is a call.
pub const CS_PEER_V6 : u64 = 4294967296;
/// After the identity: the H.264 video of a one to one call (owner, 2026-10-23; call_h264.t27, section "H.264 video"
/// below): the receiver's and the sender's state, the meters, the slots, and the assembly buffer of VH_FRAME_MAX bytes.
/// Only link 0 uses it.
pub const CS_VH : usize = 166528;
pub const CS_LEN : usize = 299648;
const CI_ON : usize = 0;
const CI_PIN : usize = 1;
const CI_GOT : usize = 2;
const CI_OK : usize = 3;
const CI_SAME : usize = 4;
const CI_VERDICT : usize = 5;
