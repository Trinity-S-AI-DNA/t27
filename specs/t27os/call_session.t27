/// Tunables (cs_set): 40.. hold the values.
pub const CS_K_CALLING_MS : u32 = 40;
pub const CS_K_RINGING_MS : u32 = 41;
pub const CS_K_VERIFY_MS : u32 = 42;
pub const CS_K_SILENT_MS : u32 = 43;
pub const CS_K_JB_TARGET : u32 = 44;
pub const CS_K_JB_MAX : u32 = 45;
/// Test aids (set at launch on link 0, off by default): 1 = print GROUPSTAT lines once a second; seconds after the
/// group is whole at which this member leaves (0 = never); 1 = answer and confirm the group's other links by itself
/// after 2 s (never the first link: the window's AUTOTEST does that one); the amplitude of the TONE test waveform.
pub const CS_K_GSTATS : u32 = 46;
pub const CS_K_GLEAVE_S : u32 = 47;
pub const CS_K_GAUTO : u32 = 48;
pub const CS_K_TONE_AMP : u32 = 49;
/// 1 = send video while a one to one call is ACTIVE (the receiver always accepts it). 0 in a new session; the window
/// sets it unless T27OS_CALL_VIDEO=0.
pub const CS_K_VIDEO : u32 = 50;
/// Test aid: the video frame number whose part 1 is sealed but not sent (a lost datagram); 0 = none.
pub const CS_K_VDROP : u32 = 51;
/// Test aid: stop after this many video frames in a call (0 = no limit).
pub const CS_K_VLIMIT : u32 = 52;
/// The address of the test picture's encoder block (call_vid.t27 vgq_new), set by cs_video_encoder, kept across calls;
/// 0 = none, the generator's frame is then made inside the poll as before (probes and tests).
const CS_K_VENC : u32 = 53;
/// 1 = a public address in a group's member list may be called (the window sets it from T27OS_ALLOW_PUBLIC=1, the
/// same explicit allow the typed address needs); 0 = only a private network or this machine.
pub const CS_K_ALLOW_PUB : u32 = 57;
/// The window's H.264 encoder and decoder blocks (call_vt.t27 vte_new / vtd_new), set by cs_video_h264, kept across
/// calls; 0 = none (this side then sends the JPEG and cannot show H.264).
const CS_K_VHENC : u32 = 58;
const CS_K_VHDEC : u32 = 59;
/// Test aid (call_h264_probe, never the window): every n-th H.264 part is sealed and not sent, a lost datagram; 0 = none.
pub const CS_K_VHLOSS : u32 = 61;
/// Test aid (T27OS_QA=1): 1 = the IPv6 loopback ::1 may call and be called (call_ip6 ip6_from_ok). 0 by default.
pub const CS_K_LOOP6 : u32 = 62;
/// 1 when the socket is the dual-stack AF_INET6 one, 0 when cs_open fell back to an IPv4 socket.
const CS_SOCK6 : u32 = 63;

pub const CS_AUDIO_DEV : u32 = 1;
pub const CS_AUDIO_TEST : u32 = 2;
/// Like TEST (no devices) but the frames are a quiet triangle wave that names its sender, they go through the jitter
/// buffer, and a software speaker mixes the members every 10 ms exactly as the device callback does. A test mode.
pub const CS_AUDIO_TONE : u32 = 3;
/// A message session (chat, owner 2026-10-22): the same handshake and sealed channel, no audio and no video at all;
/// it alone carries CK_T_TEXT frames (cs_text_send / cs_text_take). The audio block is unused in this mode, so the
/// received text frames queue there (CS_TXQ).
pub const CS_AUDIO_NONE : u32 = 4;
/// Text counters (cs_stat): sealed and sent, opened and queued, dropped because the queue was full.
pub const CS_ST_TEXT_TX : u32 = 54;
pub const CS_ST_TEXT_RX : u32 = 55;
pub const CS_ST_TEXT_DROP : u32 = 56;
/// The queue of received text frames of a message session, inside the unused audio block: head u64, tail u64, then
/// CS_TXQ_N entries of CS_TXE bytes (length u16 LE, the opened payload).
pub const CS_TXQ : usize = 10240;
pub const CS_TXQ_N : u64 = 64;
pub const CS_TXE : usize = 744;
/// The largest text payload: a group part (group_core GM_PAYLOAD_MAX 738) fits, and its sealed frame (52 + 740 + 16)
/// fits the 808 bytes cs_text_send seals into.
pub const CS_TXT_MAX : usize = 740;

