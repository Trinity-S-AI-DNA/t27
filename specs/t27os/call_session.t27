/// Over IPv6 (call_ip6 ip6_audio_split): the redundant copies sent and taken as datagrams of their own.
pub const CS_ST_COPY_TX : u32 = 18;
pub const CS_ST_COPY_RX : u32 = 19;
const CS_FD : u32 = 20;
const CS_MODE : u32 = 21;
const CS_MUTED : u32 = 22;
const CS_SEEN : u32 = 23;
const CS_CODE_SAID : u32 = 24;
