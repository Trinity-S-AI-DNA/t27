    assert csv_fields(PROFILE_BASE_URLS) == PROFILE_COUNT;
    assert csv_fields(PROFILE_KEY_VARS) == PROFILE_COUNT;
    assert csv_fields(TIER_VARS) == TIER_COUNT;
    assert PROFILE_PROVIDER.len == PROFILE_COUNT;
    assert PROFILE_EMPTY_API_KEY.len == PROFILE_COUNT;
    assert PS_TIER0 + TIER_COUNT == PS_EMPTY_KEY;
    assert PS_EMPTY_KEY + 1 == PS_COUNT;
}

test no_profile_sets_a_variable_a_claude_pane_would_inherit {
    var o : [64]u8 = undefined;
    var pr : u32 = 0;
    while (pr < PROFILE_COUNT) {
        var k : u32 = 0;
        while (k < profile_var_count(pr)) {
            const n : usize = profile_var_name(pr, k, o[0..64]);
            assert n > 0;
            assert claude_strips(o[0..n]);
            k = k + 1;
        }
        pr = pr + 1;
    }
}

