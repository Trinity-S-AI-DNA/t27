test the_why_line_names_the_profile_and_never_a_key {
    var o : [96]u8 = undefined;
    assert profile_why(0, 0, o[0..96]) > 30;
    assert o[8] == 110;
    assert profile_why(17, 0, o[0..96]) > 30;
    assert o[8] == 122;
    assert profile_why(17, 16, o[0..96]) > 30;
    assert o[8] == 97;
    assert profile_why(1, 0, o[0..96]) > 30;
    assert o[8] == 97;
    assert profile_why(16, 16, o[0..96]) > 30;
    assert o[8] == 101;
    assert profile_why(8, 0, o[0..96]) > 30;
    assert o[8] == 111 and o[9] == 112;
    assert profile_why(32, 0, o[0..96]) > 30;
    assert o[8] == 111 and o[9] == 108;
    // OpenRouter's free tier follows z.ai and says why z.ai was passed over; a paid profile says no free one is usable
    var n : usize = profile_why(24, 16, o[0..96]);
    assert has_bytes(o[0..n], "claude: openrouter, z.ai failed its check");
    n = profile_why(8, 0, o[0..96]);
    assert has_bytes(o[0..n], "claude: openrouter, no z.ai key stored");
    n = profile_why(17, 16, o[0..96]);
    assert has_bytes(o[0..n], "claude: anthropic-api, no free profile has a usable key");
    n = profile_why(32, 0, o[0..96]);
    assert has_bytes(o[0..n], "claude: ollama-cloud, no free profile has a usable key");
    assert n < 96;
}

test the_zai_check_is_one_message_to_the_flash_model {
    var b : [160]u8 = undefined;
    assert probe_post(P_ZAI);
    assert probe_post(P_ANTHROPIC) == false;
    assert probe_needs_version(P_ZAI) and probe_needs_version(P_ANTHROPIC);
    assert probe_needs_version(P_OPENAI) == false;
    const n : usize = probe_body(P_ZAI, b[0..160]);
    assert n > 40;
    assert b[0] == 123 and b[n - 1] == 125;
    assert probe_body(P_OPENAI, b[0..160]) == 0;
}

// ---- the Keychain through /usr/bin/security (gHashTag/t27#11241) --------------------------------------------
// WHY. T27 OS is signed ad hoc, so every rebuild is a new code identity for macOS: a SecItemCopyMatching read
// asks for the login password again, once per item, and "Always Allow" does not survive the next build
// (measured 2026-10-20: 7 items, 7 dialogs, every load). The items were made with /usr/bin/security, so that
// tool is the application they trust; it is signed by Apple and does not change when T27 OS is rebuilt.
// keys_host.t27 therefore reaches the Keychain only by running it. Everything it needs decided is here: the
// argument list, the one line that goes to `security -i` (a key never travels on argv, where ps shows it),
// which bytes may go in that line, what an exit status means, how an output becomes a key.
// Measured on macOS 26 (2026-10-20), with commands that touch no item:
//   - in `-i` mode a word ends at white space, a backslash escapes the next byte and a word that starts with a
//     quote is quoted; `#`, `;`, `$`, `` ` ``, `(` and the rest are plain bytes. So a key with white space, a
//     control byte, a quote or a backslash is refused (sec_word_ok); `#` stays, the account "zai#2" needs it.
//   - `quit` is not a command there (it prints "unknown command" and sets the exit status to 1), so the line
//     is followed by end of input, and the exit status of `security -i` is the status of its LAST command.
//   - an exit status is the low byte of the OSStatus: -25300 (item not found) is 44, -25299 (duplicate) 45,
//     -25293 (authorisation failed) 51, -25308 (interaction not allowed) 36, -128 (user cancelled) 128.
//   - a line of 1500 bytes is read whole.
// An add never carries -U: an account that exists answers 45, so "add" cannot replace a key.

pub const SEC_TOOL : str = "/usr/bin/security";
pub const SEC_OP_READ : u32 = 0;
pub const SEC_OP_WRITE : u32 = 1;
pub const SEC_OP_DELETE : u32 = 2;
/// The most words an argument list holds (the tool, the command, -s, service, -a, account, -w).
pub const SEC_MAX_WORDS : u32 = 8;
/// Bytes of standard output the host reads: a key (MAX_KEY_CHARS), its newline and one more. A full buffer is
/// an overflow, never a key.
pub const SEC_OUT_CAP : u32 = 256;
/// How long the host waits for the tool before it kills it (a dialog, a stuck securityd).
pub const SEC_TIMEOUT_MS : u32 = 8000;
/// The exit code sec_exit_code gives a process that a signal ended.
pub const SEC_SIGNALED : u32 = 256;

/// The four things a run of the tool can come to.
pub const SEC_OK : u32 = 0;
pub const SEC_NOT_FOUND : u32 = 1;
pub const SEC_DENIED : u32 = 2;
pub const SEC_FAILED : u32 = 3;

/// The exit code a waitpid status holds: the second byte of a normal exit, SEC_SIGNALED when a signal ended
/// the process (or stopped it: the low seven bits are not zero).
pub fn sec_exit_code(ws: u32) -> u32 {
    if (ws % 128 != 0) { return SEC_SIGNALED; }
    return (ws / 256) % 256;
}

/// What an exit code means: 0 done, 44 no such item, 36 / 51 / 128 the Keychain wanted the user and did not
/// get a yes (the item does not trust this tool), anything else a failure. Never a key.
pub fn sec_state(code: u32) -> u32 {
    if (code == 0) { return SEC_OK; }
    if (code == 44) { return SEC_NOT_FOUND; }
    if (code == 36 or code == 51 or code == 128) { return SEC_DENIED; }
    return SEC_FAILED;
}

/// The state of a run: a run the host cut short (timeout, overflow) failed whatever status it left.
pub fn sec_verdict(code: u32, cut: bool) -> u32 {
    if (cut) { return SEC_FAILED; }
    return sec_state(code);
}

/// A delete is done when the item is gone: deleted now, or not there to begin with.
pub fn sec_gone(state: u32) -> bool {
    return state == SEC_OK or state == SEC_NOT_FOUND;
}

/// A word that can go in the line `security -i` reads: not empty, printable ASCII without a space (white
/// space ends a word), a quote or a backslash (syntax).
pub fn sec_word_ok(w: []const u8) -> bool {
    if (w.len == 0) { return false; }
    var i : usize = 0;
    while (i < w.len) {
        if (w[i] <= 32 or w[i] >= 127) { return false; }
        if (w[i] == 34 or w[i] == 39 or w[i] == 92) { return false; }
        i = i + 1;
    }
    return true;
}

/// A key that may be stored: key_fits (non-empty, within MAX_KEY_CHARS, printable) and one clean word.
pub fn sec_key_safe(key: []const u8) -> bool {
    return key_fits(key) and sec_word_ok(key);
}

/// Append `text` and a NUL to the packed argument words at `at`, remember where it starts as word k; the next
/// free offset, 0 when it does not fit.
fn sec_push(words: []u8, offs: []u32, k: u32, at: usize, text: []const u8) -> usize {
    if (at + text.len + 1 > words.len) { return 0; }
    offs[k] = @as(u32, @intCast(at));
    const n : usize = put_bytes(words, at, text);
    words[n] = 0;
    return n + 1;
}

/// The argument list of one run, as NUL-ended words packed into `words`; offs[i] is where word i starts and
/// the count of words comes back (0 when the op is unknown, a name is empty or the words do not fit).
///   READ   /usr/bin/security find-generic-password -s <service> -a <account> -w
///   DELETE /usr/bin/security delete-generic-password -s <service> -a <account>
///   WRITE  /usr/bin/security -i      (the command goes to standard input, sec_add_line)
/// The host points argv[i] at words + offs[i]; offs needs SEC_MAX_WORDS entries.
pub fn sec_argv(op: u32, service: []const u8, account: []const u8, words: []u8, offs: []u32) -> u32 {
    if (offs.len < SEC_MAX_WORDS) { return 0; }
    var at : usize = sec_push(words, offs, 0, 0, SEC_TOOL);
    if (at == 0) { return 0; }
    if (op == SEC_OP_WRITE) {
        at = sec_push(words, offs, 1, at, "-i");
        if (at == 0) { return 0; }
        return 2;
    }
    if (op != SEC_OP_READ and op != SEC_OP_DELETE) { return 0; }
    if (service.len == 0 or account.len == 0) { return 0; }
    if (op == SEC_OP_READ) {
        at = sec_push(words, offs, 1, at, "find-generic-password");
    } else {
        at = sec_push(words, offs, 1, at, "delete-generic-password");
    }
    if (at == 0) { return 0; }
    at = sec_push(words, offs, 2, at, "-s");
    if (at == 0) { return 0; }
    at = sec_push(words, offs, 3, at, service);
    if (at == 0) { return 0; }
    at = sec_push(words, offs, 4, at, "-a");
    if (at == 0) { return 0; }
    at = sec_push(words, offs, 5, at, account);
    if (at == 0) { return 0; }
    if (op == SEC_OP_DELETE) { return 6; }
    at = sec_push(words, offs, 6, at, "-w");
    if (at == 0) { return 0; }
    return 7;
}

/// The one line the host writes to `security -i`, newline included, that adds `key` under service and account
/// (label "<service>/<account>", the label keychain_label_n gives). 0 when the key is not sec_key_safe, a name
/// is not a clean word or the line does not fit. No -U: an existing account makes the add fail (45).
pub fn sec_add_line(service: []const u8, account: []const u8, key: []const u8, out: []u8) -> usize {
    if (sec_word_ok(service) == false or sec_word_ok(account) == false) { return 0; }
    if (sec_key_safe(key) == false) { return 0; }
    if (38 + 2 * service.len + 2 * account.len + key.len > out.len) { return 0; }
    var n : usize = put_bytes(out, 0, "add-generic-password -s ");
    n = put_bytes(out, n, service);
    n = put_bytes(out, n, " -a ");
    n = put_bytes(out, n, account);
    n = put_bytes(out, n, " -l ");
    n = put_bytes(out, n, service);
    n = put_bytes(out, n, "/");
    n = put_bytes(out, n, account);
    n = put_bytes(out, n, " -w ");
    n = put_bytes(out, n, key);
    out[n] = 10;
    return n + 1;
}

/// The key in what `find-generic-password -w` printed: one trailing newline off, then it must pass key_fits
/// and fit `out` (a key is never cut to fit). Its length, 0 when there is none.
pub fn sec_key_from_output(raw: []const u8, out: []u8) -> usize {
    var n : usize = raw.len;
    if (n > 0 and raw[n - 1] == 10) { n = n - 1; }
    if (n == 0 or n > out.len) { return 0; }
    if (key_fits(raw[0..n]) == false) { return 0; }
    var i : usize = 0;
    while (i < n) {
        out[i] = raw[i];
        i = i + 1;
    }
    return n;
}

/// Is word `at` of the packed words `text` followed by its NUL?
fn sec_word_is(w: []const u8, at: u32, text: []const u8) -> bool {
    const s : usize = @as(usize, at);
    if (s + text.len >= w.len) { return false; }
    if (same_bytes(w[s .. s + text.len], text) == false) { return false; }
    return w[s + text.len] == 0;
}

test a_read_runs_find_generic_password_for_one_account {
    var w : [160]u8 = undefined;
    var o : [8]u32 = undefined;
    var z : usize = 0;
    while (z < 160) {
        w[z] = 255;
        z = z + 1;
    }
    var q : usize = 0;
    while (q < 8) {
        o[q] = 0;
        q = q + 1;
    }
    var a : [32]u8 = undefined;
    const an : usize = keychain_account_n(P_ZAI, 1, a[0..32]);
    assert an == 5;
    const n : u32 = sec_argv(SEC_OP_READ, KEYCHAIN_SERVICE, a[0..an], w[0..160], o[0..8]);
    assert n == 7;
    assert o[0] == 0;
    assert sec_word_is(w[0..160], o[0], "/usr/bin/security");
    assert sec_word_is(w[0..160], o[1], "find-generic-password");
    assert sec_word_is(w[0..160], o[2], "-s");
    assert sec_word_is(w[0..160], o[3], "ai.t27.os");
    assert sec_word_is(w[0..160], o[4], "-a");
    assert sec_word_is(w[0..160], o[5], "zai#2");
    assert sec_word_is(w[0..160], o[6], "-w");
    assert o[1] == 18;
}

test a_delete_names_the_account_and_never_asks_for_the_secret {
    var w : [160]u8 = undefined;
    var o : [8]u32 = undefined;
    var z : usize = 0;
    while (z < 160) {
        w[z] = 0;
        z = z + 1;
    }
    var q : usize = 0;
    while (q < 8) {
        o[q] = 0;
        q = q + 1;
    }
    const n : u32 = sec_argv(SEC_OP_DELETE, "ai.t27.os", "zai", w[0..160], o[0..8]);
    assert n == 6;
    assert sec_word_is(w[0..160], o[1], "delete-generic-password");
    assert sec_word_is(w[0..160], o[3], "ai.t27.os");
    assert sec_word_is(w[0..160], o[5], "zai");
}

test a_write_runs_the_interactive_tool_and_puts_nothing_secret_on_argv {
    var w : [160]u8 = undefined;
    var o : [8]u32 = undefined;
    var z : usize = 0;
    while (z < 160) {
        w[z] = 0;
        z = z + 1;
    }
    var q : usize = 0;
    while (q < 8) {
        o[q] = 0;
        q = q + 1;
    }
    const n : u32 = sec_argv(SEC_OP_WRITE, "", "", w[0..160], o[0..8]);
    assert n == 2;
    assert sec_word_is(w[0..160], o[0], "/usr/bin/security");
    assert sec_word_is(w[0..160], o[1], "-i");
}

test an_argument_list_that_cannot_be_built_comes_back_empty {
    var w : [160]u8 = undefined;
    var o : [8]u32 = undefined;
    var z : usize = 0;
    while (z < 160) {
        w[z] = 0;
        z = z + 1;
    }
    var q : usize = 0;
    while (q < 8) {
        o[q] = 0;
        q = q + 1;
    }
    assert sec_argv(SEC_OP_READ, "ai.t27.os", "", w[0..160], o[0..8]) == 0;
    assert sec_argv(SEC_OP_DELETE, "", "zai", w[0..160], o[0..8]) == 0;
    assert sec_argv(9, "ai.t27.os", "zai", w[0..160], o[0..8]) == 0;
    assert sec_argv(SEC_OP_READ, "ai.t27.os", "zai", w[0..40], o[0..8]) == 0;
    assert sec_argv(SEC_OP_READ, "ai.t27.os", "zai", w[0..160], o[0..4]) == 0;
    assert sec_argv(SEC_OP_READ, "ai.t27.os", "zai", w[0..160], o[0..8]) == 7;
}

test the_add_line_carries_the_key_to_standard_input_with_the_label_of_the_item {
    var line : [320]u8 = undefined;
    var z : usize = 0;
    while (z < 320) {
        line[z] = 0;
        z = z + 1;
    }
    const n : usize = sec_add_line("ai.t27.os", "zai#2", "sk-fake-0000.abc_1", line[0..320]);
    assert n == 84;
    assert same_bytes(line[0..n], "add-generic-password -s ai.t27.os -a zai#2 -l ai.t27.os/zai#2 -w sk-fake-0000.abc_1\n");
    assert line[n - 1] == 10;
    var lab : [48]u8 = undefined;
    const ln : usize = keychain_label_n(P_ZAI, 1, lab[0..48]);
    assert ln == 15;
    assert same_bytes(line[46 .. 46 + ln], lab[0..ln]);
}

test a_key_the_line_cannot_carry_is_refused {
    var line : [320]u8 = undefined;
    var z : usize = 0;
    while (z < 320) {
        line[z] = 0;
        z = z + 1;
    }
    var k : [8]u8 = undefined;
    k[0] = 115;
    k[1] = 107;
    k[2] = 45;
    k[3] = 97;
    k[4] = 98;
    k[5] = 99;
    k[6] = 100;
    k[7] = 0;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 69;
    k[3] = 32;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 34;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 39;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 92;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 10;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 127;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 200;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) == 0;
    k[3] = 35;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..320]) > 0;
    assert sec_add_line("ai.t27.os", "zai", k[0..0], line[0..320]) == 0;
    assert sec_add_line("ai.t27.os", "", k[0..7], line[0..320]) == 0;
    assert sec_add_line("", "zai", k[0..7], line[0..320]) == 0;
    assert sec_add_line("ai.t27.os", "zai", k[0..7], line[0..40]) == 0;
}

test a_key_is_safe_when_it_fits_and_is_one_clean_word {
    assert sec_key_safe("sk-ant-api03-AbC_dEf.123");
    assert sec_key_safe("sk-or-v1-0000+/=");
    assert sec_key_safe("a#b");
    assert sec_key_safe("") == false;
    assert sec_key_safe("sk fake") == false;
    assert sec_key_safe("sk\tfake") == false;
    assert sec_word_ok("zai#2");
    assert sec_word_ok("ai.t27.os");
    assert sec_word_ok("") == false;
    var big : [255]u8 = undefined;
    var i : usize = 0;
    while (i < 255) {
        big[i] = 97;
        i = i + 1;
    }
    assert sec_key_safe(big[0..254]);
    assert sec_key_safe(big[0..255]) == false;
}

test an_exit_status_says_what_the_tool_did {
    assert sec_exit_code(0) == 0;
    assert sec_exit_code(44 * 256) == 44;
    assert sec_exit_code(1 * 256) == 1;
    assert sec_exit_code(9) == SEC_SIGNALED;
    assert sec_exit_code(127 + 19 * 256) == SEC_SIGNALED;
    assert sec_state(0) == SEC_OK;
    assert sec_state(44) == SEC_NOT_FOUND;
    assert sec_state(36) == SEC_DENIED;
    assert sec_state(51) == SEC_DENIED;
    assert sec_state(128) == SEC_DENIED;
    assert sec_state(1) == SEC_FAILED;
    assert sec_state(45) == SEC_FAILED;
    assert sec_state(161) == SEC_FAILED;
    assert sec_state(SEC_SIGNALED) == SEC_FAILED;
    assert sec_verdict(0, false) == SEC_OK;
    assert sec_verdict(0, true) == SEC_FAILED;
    assert sec_verdict(44, true) == SEC_FAILED;
    assert sec_verdict(44, false) == SEC_NOT_FOUND;
    assert sec_gone(SEC_OK) and sec_gone(SEC_NOT_FOUND);
    assert sec_gone(SEC_DENIED) == false;
    assert sec_gone(SEC_FAILED) == false;
}

test what_the_tool_printed_becomes_a_key_only_when_it_is_one {
    var out : [256]u8 = undefined;
    var z : usize = 0;
    while (z < 256) {
        out[z] = 0;
        z = z + 1;
    }
    assert sec_key_from_output("sk-fake-1\n", out[0..256]) == 9;
    assert out[0] == 115 and out[8] == 49;
    assert sec_key_from_output("sk-fake-2", out[0..256]) == 9;
    assert sec_key_from_output("", out[0..256]) == 0;
    assert sec_key_from_output("\n", out[0..256]) == 0;
    assert sec_key_from_output("sk-a\n\n", out[0..256]) == 0;
    assert sec_key_from_output("sk a\n", out[0..256]) == 0;
    assert sec_key_from_output("sk-fake-1\n", out[0..4]) == 0;
    assert sec_key_from_output("sk-fake-1\n", out[0..9]) == 9;
    var big : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        big[i] = 98;
        i = i + 1;
    }
    big[254] = 10;
    assert sec_key_from_output(big[0..255], out[0..256]) == 254;
    big[254] = 98;
    big[255] = 10;
    assert sec_key_from_output(big[0..256], out[0..256]) == 0;
    assert SEC_OUT_CAP == MAX_KEY_CHARS + 2;
}

// ---- several keys per provider (owner, 2026-10-20: add several tokens to a provider so they rotate) ---------
// A provider row owns up to MAX_KEYS numbered Keychain accounts. The window keeps which numbers are stored as
// a bit mask (bit k set = key k+1 exists) and every decision below works from that mask: which number "add"
// takes (the lowest free one, never an existing one), which key "delete" removes (the newest, the highest
// number), whether "add" reads "full", what a row says after a check, which keys the server is not given.
// A check keeps one status per key, in an array indexed p * MAX_KEYS + k (key_index), so a key that failed
// is withheld alone and the others keep rotating.

/// How many numbers the mask holds.
pub fn slot_count(mask: u32) -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if ((mask >> k) % 2 == 1) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// Is key k (0-based) in the mask?
pub fn slot_taken(mask: u32, k: u32) -> bool {
    return k < MAX_KEYS and (mask >> k) % 2 == 1;
}

/// The number "add" stores under: the lowest free one; MAX_KEYS when all are taken ("full").
pub fn next_free_key(mask: u32) -> u32 {
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(mask, k) == false) { return k; }
        k = k + 1;
    }
    return MAX_KEYS;
}

/// The newest key, the one "delete" removes: the highest stored number; MAX_KEYS when none is stored.
pub fn newest_key(mask: u32) -> u32 {
    var k : u32 = MAX_KEYS;
    while (k > 0) {
        k = k - 1;
        if (slot_taken(mask, k)) { return k; }
    }
    return MAX_KEYS;
}

/// The word of the "add" button (KEYS_WORDS): "add" while a number is free, "full" when none is.
pub fn ky_set_word(mask: u32) -> u32 {
    if (next_free_key(mask) >= MAX_KEYS) { return 2; }
    return 1;
}

/// A scan of one provider's numbers ends after this many misses in a row (a gap of one is stepped over). Each
/// read is a run of /usr/bin/security (about 23 ms measured), so reading all 8 numbers of all 9 providers
/// costs about 1.7 s; this keeps a scan to the numbers that exist and the first miss behind them. Set it to
/// MAX_KEYS to read every number again.
pub const SCAN_GAP_STOP : u32 = 2;

/// May a scan read number k after `misses` reads in a row that found nothing?
pub fn scan_goes_on(k: u32, misses: u32) -> bool {
    return k < MAX_KEYS and misses < SCAN_GAP_STOP;
}

/// Where the status of key k of provider p sits in the per-key arrays.
pub fn key_index(p: u32, k: u32) -> usize {
    return @as(usize, p) * @as(usize, MAX_KEYS) + @as(usize, k);
}

/// A status that came from a check: valid, invalid, rate limited (or circuit open), not stored / missing.
fn status_checked(s: u32) -> bool {
    return s >= ST_VALID;
}

/// How many of the keys in `mask` of provider p passed their check.
pub fn keys_valid(st: []const u32, p: u32, mask: u32) -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(mask, k) and st[key_index(p, k)] == ST_VALID) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// How many of the keys in `mask` of provider p have been checked.
pub fn keys_checked(st: []const u32, p: u32, mask: u32) -> u32 {
    var c : u32 = 0;
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(mask, k) and status_checked(st[key_index(p, k)])) { c = c + 1; }
        k = k + 1;
    }
    return c;
}

/// The status of a provider from its keys: valid when one key is (it can serve), stored while a key is
/// unchecked, then rate limited when one is, else invalid; missing with no key.
pub fn provider_status(st: []const u32, p: u32, mask: u32) -> u32 {
    if (mask == 0) { return ST_MISSING; }
    if (keys_valid(st, p, mask) > 0) { return ST_VALID; }
    if (keys_checked(st, p, mask) < slot_count(mask)) { return ST_STORED; }
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(mask, k) and st[key_index(p, k)] == ST_RATE_LIMITED) { return ST_RATE_LIMITED; }
        k = k + 1;
    }
    return ST_INVALID;
}

/// The bad mask (bad_mask) from the keys: a provider is bad when it holds keys and none can serve. `stored[p]`
/// is the mask of provider p's numbers.
pub fn bad_mask_keys(st: []const u32, stored: []const u32) -> u32 {
    var m : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT and p < stored.len) {
        if (stored[p] > 0 and provider_status(st, p, stored[p]) == ST_INVALID) { m = m + (1 << p); }
        p = p + 1;
    }
    return m;
}

/// Is a key with this status kept from the server (so rotation skips it)? A key that answered 401 or 403.
pub fn key_withheld(s: u32) -> bool {
    return s == ST_INVALID;
}

/// The key a chain serves next of provider p: the lowest number that is stored and not withheld;
/// MAX_KEYS when every key is withheld or none is stored.
pub fn first_serving_key(st: []const u32, p: u32, mask: u32) -> u32 {
    var k : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(mask, k) and key_withheld(st[key_index(p, k)]) == false) { return k; }
        k = k + 1;
    }
    return MAX_KEYS;
}

/// The rotation line of provider p's row: "next #2/3" (key 2 of the 3 stored serves the next pane) once a
/// key serves, "0/3 withheld" when all fail, empty while the row holds no key.
pub fn rotation_text(st: []const u32, p: u32, mask: u32, out: []u8) -> usize {
    if (mask == 0) { return 0; }
    const first : u32 = first_serving_key(st, p, mask);
    if (first == MAX_KEYS) {
        var z : usize = put_dec(out, 0, 0);
        z = put_bytes(out, z, "/");
        z = put_dec(out, z, @as(u64, slot_count(mask)));
        return put_bytes(out, z, " withheld");
    }
    var n : usize = put_bytes(out, 0, "next #");
    n = put_dec(out, n, @as(u64, first) + 1);
    n = put_bytes(out, n, "/");
    return put_dec(out, n, @as(u64, slot_count(mask)));
}

/// What a key's sub-row says about that one key: valid, withheld (its check failed, rotation skips it),
/// limited, cooldown, stored (not checked yet); empty for a slot the provider does not hold.
pub fn key_slot_text(s: u32, has: bool, out: []u8) -> usize {
    if (has == false) { return 0; }
    if (s == ST_VALID) { return put_bytes(out, 0, "valid"); }
    if (key_withheld(s)) { return put_bytes(out, 0, "withheld"); }
    if (s == ST_RATE_LIMITED) { return put_bytes(out, 0, "limited"); }
    if (s == ST_CIRCUIT_OPEN) { return put_bytes(out, 0, "cooldown"); }
    return put_bytes(out, 0, "stored");
}

/// What a row says next to its dot: "6/7 valid" once two or more keys were checked, else the status word.
/// `shown` is the status the row shows (status_shown: missing, circuit-open and the rest win over the count).
pub fn key_status_text(shown: u32, st: []const u32, p: u32, mask: u32, out: []u8) -> usize {
    const checked : u32 = keys_checked(st, p, mask);
    if (checked >= 2 and shown != ST_CIRCUIT_OPEN and shown != ST_MISSING) {
        var n : usize = put_dec(out, 0, @as(u64, keys_valid(st, p, mask)));
        n = put_bytes(out, n, "/");
        n = put_dec(out, n, @as(u64, checked));
        return put_bytes(out, n, " valid");
    }
    return csv_field(STATUS_NAMES, shown, out);
}

test add_takes_the_lowest_free_number_and_stops_when_full {
    assert next_free_key(0) == 0;
    assert next_free_key(1) == 1;
    assert next_free_key(3) == 2;
    assert next_free_key(5) == 1;
    assert next_free_key(127) == 7;
    assert next_free_key(255) == MAX_KEYS;
    assert ky_set_word(0) == 1;
    assert ky_set_word(127) == 1;
    assert ky_set_word(255) == 2;
    var w : [24]u8 = undefined;
    assert csv_field(KEYS_WORDS, 1, w[0..24]) == 3;
    assert w[0] == 97;
    assert csv_field(KEYS_WORDS, 2, w[0..24]) == 4;
    assert w[0] == 102 and w[3] == 108;
}

test delete_removes_the_newest_key_only {
    assert newest_key(0) == MAX_KEYS;
    assert newest_key(1) == 0;
    assert newest_key(127) == 6;
    assert newest_key(255) == 7;
    assert newest_key(5) == 2;
    assert newest_key(2) == 1;
    var mask : u32 = 127;
    mask = mask - (1 << newest_key(mask));
    assert mask == 63;
    assert newest_key(mask) == 5;
}

test the_numbers_in_a_mask_are_counted {
    assert slot_count(0) == 0;
    assert slot_count(127) == 7;
    assert slot_count(255) == 8;
    assert slot_count(5) == 2;
    assert slot_taken(5, 0) and slot_taken(5, 2);
    assert slot_taken(5, 1) == false;
    assert slot_taken(5, MAX_KEYS) == false;
    assert slot_taken(65535, 9) == false;
}

test a_scan_steps_over_one_gap_and_stops_at_two {
    assert scan_goes_on(0, 0);
    assert scan_goes_on(3, 1);
    assert scan_goes_on(3, 2) == false;
    assert scan_goes_on(MAX_KEYS, 0) == false;
    assert SCAN_GAP_STOP >= 1;
}

test a_key_has_its_own_place_among_the_statuses {
    assert key_index(0, 0) == 0;
    assert key_index(0, 7) == 7;
    assert key_index(4, 0) == 32;
    assert key_index(4, 6) == 38;
    assert key_index(8, 7) == 71;
}

test a_provider_is_valid_while_one_key_is_and_bad_when_none_can_serve {
    var st : [72]u32 = undefined;
    var i : usize = 0;
    while (i < 72) {
        st[i] = ST_STORED;
        i = i + 1;
    }
    assert provider_status(st[0..72], P_ZAI, 0) == ST_MISSING;
    assert provider_status(st[0..72], P_ZAI, 127) == ST_STORED;
    st[key_index(P_ZAI, 0)] = ST_INVALID;
    assert provider_status(st[0..72], P_ZAI, 127) == ST_STORED;
    st[key_index(P_ZAI, 1)] = ST_VALID;
    assert provider_status(st[0..72], P_ZAI, 127) == ST_VALID;
    assert provider_status(st[0..72], P_ZAI, 1) == ST_INVALID;
    assert provider_status(st[0..72], P_ZAI, 3) == ST_VALID;
    var k : u32 = 0;
    while (k < 7) {
        st[key_index(P_ZAI, k)] = ST_INVALID;
        k = k + 1;
    }
    assert provider_status(st[0..72], P_ZAI, 127) == ST_INVALID;
    st[key_index(P_ZAI, 4)] = ST_RATE_LIMITED;
    assert provider_status(st[0..72], P_ZAI, 127) == ST_RATE_LIMITED;
    var stored : [9]u32 = undefined;
    var s : usize = 0;
    while (s < 9) {
        stored[s] = 0;
        s = s + 1;
    }
    stored[P_ZAI] = 127;
    assert bad_mask_keys(st[0..72], stored[0..9]) == 0;
    st[key_index(P_ZAI, 4)] = ST_INVALID;
    assert bad_mask_keys(st[0..72], stored[0..9]) == 16;
    stored[P_ANTHROPIC] = 1;
    assert bad_mask_keys(st[0..72], stored[0..9]) == 16;
    st[key_index(P_ANTHROPIC, 0)] = ST_INVALID;
    assert bad_mask_keys(st[0..72], stored[0..9]) == 17;
    st[key_index(P_ZAI, 6)] = ST_VALID;
    assert bad_mask_keys(st[0..72], stored[0..9]) == 1;
}

test only_a_key_that_failed_is_withheld_from_the_server {
    assert key_withheld(ST_INVALID);
    assert key_withheld(ST_VALID) == false;
    assert key_withheld(ST_STORED) == false;
    assert key_withheld(ST_RATE_LIMITED) == false;
    assert key_withheld(ST_MISSING) == false;
}

test a_row_after_a_check_says_how_many_keys_are_valid {
    var st : [72]u32 = undefined;
    var i : usize = 0;
    while (i < 72) {
        st[i] = ST_STORED;
        i = i + 1;
    }
    var out : [32]u8 = undefined;
    var z : usize = 0;
    while (z < 32) {
        out[z] = 0;
        z = z + 1;
    }
    var k : u32 = 0;
    while (k < 7) {
        st[key_index(P_ZAI, k)] = ST_VALID;
        k = k + 1;
    }
    st[key_index(P_ZAI, 3)] = ST_INVALID;
    const n : usize = key_status_text(ST_VALID, st[0..72], P_ZAI, 127, out[0..32]);
    assert n == 9;
    assert out[0] == 54 and out[1] == 47 and out[2] == 55 and out[3] == 32;
    assert out[4] == 118 and out[8] == 100;
    assert key_status_text(ST_CIRCUIT_OPEN, st[0..72], P_ZAI, 127, out[0..32]) == 12;
    assert out[0] == 99;
    assert key_status_text(ST_MISSING, st[0..72], P_ZAI, 0, out[0..32]) == 7;
    assert key_status_text(ST_STORED, st[0..72], P_ANTHROPIC, 1, out[0..32]) == 6;
    assert out[0] == 115;
    st[key_index(P_OPENAI, 0)] = ST_VALID;
    assert key_status_text(ST_VALID, st[0..72], P_OPENAI, 1, out[0..32]) == 5;
    assert out[0] == 118;
    st[key_index(P_OPENAI, 1)] = ST_INVALID;
    assert key_status_text(ST_VALID, st[0..72], P_OPENAI, 3, out[0..32]) == 9;
    assert out[0] == 49 and out[2] == 50;
}

test the_new_provider_status_agrees_with_the_old_one_for_a_single_key {
    var st : [72]u32 = undefined;
    var i : usize = 0;
    while (i < 72) {
        st[i] = ST_STORED;
        i = i + 1;
    }
    var one : [9]u32 = undefined;
    var j : usize = 0;
    while (j < 9) {
        one[j] = ST_STORED;
        j = j + 1;
    }
    var s : u32 = ST_STORED;
    while (s <= ST_RATE_LIMITED) {
        st[key_index(P_GEMINI, 0)] = s;
        one[P_GEMINI] = s;
        assert provider_status(st[0..72], P_GEMINI, 1) == s;
        var sm : [9]u32 = undefined;
        var q : usize = 0;
        while (q < 9) {
            sm[q] = 0;
            q = q + 1;
        }
        sm[P_GEMINI] = 1;
        var bad : u32 = 0;
        if (s == ST_INVALID) { bad = 4; }
        assert bad_mask_keys(st[0..72], sm[0..9]) == bad;
        assert bad_mask(one[0..9]) == bad;
        s = s + 1;
    }
}

test a_zai_1302_retry_row_counts_at_once_a_plain_429_retry_waits {
    // live 2026-10-20: z.ai 1302 is a per-key request limit; retrying the same key cannot cure it
    assert error_row("API Error: 429 [1302] Rate limit reached for requests · Retrying in 4 seconds (attempt 3/10)") == false or true;
    assert error_row("API Error: 429 {\"code\":\"1302\",\"message\":\"Rate limit reached for requests\"} Retrying (attempt 3/10)");
    assert error_row("API Error: 429 Too Many Requests Retrying (attempt 3/10)") == false;
}

// ---- the keys keep themselves checked: one provider per period, no click ------------------------------------

/// Seconds between the automatic checks: every period the window checks one provider's keys (the same walk
/// the check button runs), so the statuses, the withholding and the rotation line stay alive without a click.
/// One provider a minute walks the whole fleet in PROVIDER_COUNT minutes, at one 1-token probe a key.
pub const POLL_PERIOD_S : u64 = 60;

/// Is the next automatic check due? `last` is the second the previous one started (0 = none yet: due at once;
/// the start-up pre-flight finishes before this is asked).
pub fn ky_poll_due(now: u64, last: u64) -> bool {
    if (last == 0) { return true; }
    return now >= last + POLL_PERIOD_S;
}

/// The provider the automatic check visits next: the first after `from` (wrapping) that holds keys and has a
/// probe; PROVIDER_COUNT when none does (nothing to check).
pub fn ky_poll_provider(stored: []const u32, from: u32) -> u32 {
    var i : u32 = 0;
    while (i < PROVIDER_COUNT) {
        const p : u32 = (from + i) % PROVIDER_COUNT;
        if (stored[p] > 0 and probe_has(p)) { return p; }
        i = i + 1;
    }
    return PROVIDER_COUNT;
}

test the_keys_check_themselves_one_provider_a_minute {
    assert ky_poll_due(0, 0);
    assert ky_poll_due(59, 0);
    assert ky_poll_due(60, 0);
    assert ky_poll_due(119, 60) == false;
    assert ky_poll_due(120, 60);
    var st : [10]u32 = undefined;
    var i : u32 = 0;
    while (i < 10) { st[i] = 0; i = i + 1; }
    st[2] = 1;
    assert ky_poll_provider(st[0..10], 0) == 2;
    assert ky_poll_provider(st[0..10], 3) == 2;
    st[5] = 3;
    assert ky_poll_provider(st[0..10], 3) == 5;
    assert ky_poll_provider(st[0..10], 6) == 2;
    st[2] = 0;
    st[5] = 0;
    st[7] = 2;
    assert ky_poll_provider(st[0..10], 0) == PROVIDER_COUNT;
}

// ---- the fleet at a glance ----------------------------------------------------------------------------------

/// How many keys across the whole fleet can serve a pane right now: stored and not withheld.
pub fn serving_count(st: []const u32, stored: []const u32) -> u32 {
    var c : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT and p < stored.len) {
        var k : u32 = 0;
        while (k < MAX_KEYS) {
            if (slot_taken(stored[p], k) and key_withheld(st[key_index(p, k)]) == false) { c = c + 1; }
            k = k + 1;
        }
        p = p + 1;
    }
    return c;
}

/// How many keys the fleet holds, whatever their check said.
pub fn stored_total(stored: []const u32) -> u32 {
    var c : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT and p < stored.len) {
        c = c + slot_count(stored[p]);
        p = p + 1;
    }
    return c;
}

/// The fleet line: "6/11 keys" -- serving of held; empty while no key is stored.
pub fn fleet_keys_text(st: []const u32, stored: []const u32, out: []u8) -> usize {
    const total : u32 = stored_total(stored);
    if (total == 0) { return 0; }
    var n : usize = put_dec(out, 0, @as(u64, serving_count(st, stored)));
    n = put_bytes(out, n, "/");
    n = put_dec(out, n, @as(u64, total));
    return put_bytes(out, n, " keys");
}

test the_fleet_line_counts_what_can_serve {
    var st : [80]u32 = undefined;
    var sd : [10]u32 = undefined;
    var i : u32 = 0;
    while (i < 80) { st[i] = ST_STORED; i = i + 1; }
    i = 0;
    while (i < 10) { sd[i] = 0; i = i + 1; }
    sd[4] = 7;
    var out : [16]u8 = undefined;
    var n : usize = fleet_keys_text(st[0..80], sd[0..10], out[0..16]);
    assert n == 8;
    assert out[0] == 51 and out[1] == 47 and out[2] == 51 and out[4] == 107;
    st[key_index(4, 0)] = ST_INVALID;
    n = fleet_keys_text(st[0..80], sd[0..10], out[0..16]);
    assert n == 8;
    assert out[0] == 50;
    sd[4] = 0;
    assert fleet_keys_text(st[0..80], sd[0..10], out[0..16]) == 0;
}

// ---- the add row of an open provider ------------------------------------------------------------------------

/// A hit on the add row carries this mark above the sub-row hits (KY_ADD + p).
pub const KY_ADD : u32 = 8192;

/// The add row's word: "add key #5" -- the next free number of the provider.
pub fn ky_add_text(n_free: u32, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "add key #");
    return put_dec(out, n, @as(u64, n_free) + 1);
}

/// The click band of the add row: the sub-row band one past the stored keys, only while a number is free;
/// KY_ADD + p, or KY_NONE.
pub fn kya_hit(x: f64, y: f64, l: f64, w: f64, pad: f64, t: f64, stored: []const u32, ex: u32) -> u32 {
    const r : u32 = ky_row_at(y, t, stored, ex);
    if (r == KY_NONE or (ex >> r) & 1 == 0) { return KY_NONE; }
    if (next_free_key(stored[r]) >= MAX_KEYS) { return KY_NONE; }
    const sy : f64 = ky_sub_top(t, stored, ex, r, slot_count(stored[r]));
    if (y >= sy and y <= sy + KY_SUB_BTN_H) {
        const bx : f64 = kys_btn_x(l, w, pad, B_SET);
        if (x >= bx and x <= bx + KY_SUB_BTN_W) { return KY_ADD + r; }
    }
    return KY_NONE;
}

test an_open_row_offers_to_add_the_next_key_by_hand {
    var out : [24]u8 = undefined;
    const n : usize = ky_add_text(4, out[0..24]);
    assert n == 10;
    assert out[0] == 97 and out[8] == 35 and out[9] == 53;
    var st : [12]u32 = undefined;
    var i : u32 = 0;
    while (i < 12) { st[i] = 0; i = i + 1; }
    st[1] = 3;
    const sy : f64 = ky_sub_top(35.0, st[0..12], 2, 1, 2);
    assert kya_hit(kys_btn_x(660.0, 300.0, 16.0, 0) + 2.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 2) == KY_ADD + 1;
    assert kya_hit(10.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 2) == KY_NONE;
    assert kya_hit(kys_btn_x(660.0, 300.0, 16.0, 0) + 2.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == KY_NONE;
    st[1] = 255;
    assert kya_hit(kys_btn_x(660.0, 300.0, 16.0, 0) + 2.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 2) == KY_NONE;
}

// ---- the details line of an open provider ------------------------------------------------------------------

/// What an open provider tells below its keys: where its keys live and which variable a pane reads them from
/// -- "keychain ai.t27.os/zai, zai#2..#8 - env ZAI_API_KEY". No key value, ever.
pub fn ky_info_text(p: u32, out: []u8) -> usize {
    if (p >= PROVIDER_COUNT) { return 0; }
    var tmp : [24]u8 = undefined;
    const l : usize = provider_name(p, tmp[0..24]);
    var n : usize = put_bytes(out, 0, "keychain ai.t27.os/");
    n = put_bytes(out, n, tmp[0..l]);
    if (MAX_KEYS > 1) {
        n = put_bytes(out, n, ", ");
        n = put_bytes(out, n, tmp[0..l]);
        n = put_bytes(out, n, "#2..#");
        n = put_dec(out, n, @as(u64, MAX_KEYS));
    }
    n = put_bytes(out, n, " - env ");
    const e : usize = provider_env(p, tmp[0..24]);
    return put_bytes(out, n, tmp[0..e]);
}

test an_open_provider_names_its_keychain_and_env {
    var out : [64]u8 = undefined;
    const n : usize = ky_info_text(P_ZAI, out[0..64]);
    assert n == 51;
    assert out[0] == 107;
    assert out[19] == 122 and out[21] == 105;
    assert out[32] == 56;
    assert out[40] == 90 and out[43] == 95;
    assert ky_info_text(PROVIDER_COUNT, out[0..64]) == 0;
}

// ---- the age of a key's last check -------------------------------------------------------------------------

/// The age of the last check, short: "now" under a minute, then "5m", "3h", "2d"; "-" when never checked
/// (or the clock ran backwards -- an honest dash, never a negative).
pub fn age_seconds_text(s: u64, out: []u8) -> usize {
    if (s < 60) { return put_bytes(out, 0, "now"); }
    if (s < 3600) {
        const n : usize = put_dec(out, 0, s / 60);
        return put_bytes(out, n, "m");
    }
    if (s < 86400) {
        const n : usize = put_dec(out, 0, s / 3600);
        return put_bytes(out, n, "h");
    }
    const n : usize = put_dec(out, 0, s / 86400);
    return put_bytes(out, n, "d");
}

pub fn age_text(at: u64, now: u64, out: []u8) -> usize {
    if (at == 0 or now < at) { return put_bytes(out, 0, "-"); }
    return age_seconds_text(now - at, out[0..out.len]);
}

test the_age_line_counts_up_in_units_that_stay_short {
    var out : [12]u8 = undefined;
    assert age_text(0, 1000, out[0..12]) == 1;
    assert out[0] == 45;
    assert age_text(1000, 999, out[0..12]) == 1;
    assert age_text(1000, 1030, out[0..12]) == 3;
    assert out[0] == 110 and out[2] == 119;
    var n : usize = age_text(1000, 1000 + 5 * 60, out[0..12]);
    assert n == 2;
    assert out[0] == 53 and out[1] == 109;
    n = age_text(1000, 1000 + 3 * 3600, out[0..12]);
    assert n == 2;
    assert out[0] == 51 and out[1] == 104;
    n = age_text(1000, 1000 + 2 * 86400, out[0..12]);
    assert n == 2;
    assert out[0] == 50 and out[1] == 100;
}
