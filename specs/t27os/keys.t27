test the_openrouter_profile_reaches_claude_code_by_the_same_variables_and_names_a_free_id_at_every_tier {
    var o : [64]u8 = undefined;
    // the base URL, the key variable and the empty API key are the ones the profile always had
    assert profile_var_count(PR_OPENROUTER) == 8;
    assert profile_var_name(PR_OPENROUTER, 0, o[0..64]) == 18;
    assert profile_var_text(PR_OPENROUTER, 0, o[0..64]) == 25;
    assert o[8] == 111 and o[24] == 105;
    assert profile_var_is_key(PR_OPENROUTER, 1);
    assert profile_var_name(PR_OPENROUTER, 1, o[0..64]) == 20;
    assert profile_var_text(PR_OPENROUTER, 1, o[0..64]) == 0;
    assert profile_var_name(PR_OPENROUTER, 7, o[0..64]) == 17;
    assert profile_var_is_key(PR_OPENROUTER, 7) == false;
    assert profile_var_text(PR_OPENROUTER, 7, o[0..64]) == 0;
    // the model variables (default, small-fast, haiku, sonnet, opus) all name the step's free id: no tier
    // asks OpenRouter for a paid model while the free ones answer
    assert profile_var_name(PR_OPENROUTER, 2, o[0..64]) == 15;
    assert profile_var_name(PR_OPENROUTER, 3, o[0..64]) == 26;
    assert profile_var_name(PR_OPENROUTER, 4, o[0..64]) == 29;
    assert profile_var_name(PR_OPENROUTER, 5, o[0..64]) == 30;
    assert profile_var_name(PR_OPENROUTER, 6, o[0..64]) == 28;
    var k : u32 = 2;
    while (k < 7) {
        var n : usize = profile_var_text_step(PR_OPENROUTER, k, 0, o[0..64]);
        assert n == 31 and begins_with(o[0..n], "minimax/minimax-m3.1-flash:free");
        n = profile_var_text_step(PR_OPENROUTER, k, 1, o[0..64]);
        assert n == 33 and begins_with(o[0..n], "nvidia/nemotron-3.5-super-vl:free");
        assert profile_var_text_step(PR_OPENROUTER, k, 2, o[0..64]) == 0;
        assert profile_var_text_step(PR_OPENROUTER, k, MODEL_STEPS, o[0..64]) == 0;
        k = k + 1;
    }
    assert tier_model(PR_OPENROUTER, TI_DEFAULT, o[0..64]) == 31;
}

test every_openrouter_model_id_is_a_free_one_and_no_other_profile_names_one {
    var o : [64]u8 = undefined;
    var st : u32 = 0;
    while (st < MODEL_STEPS) {
        var ti : u32 = 0;
        while (ti < TIER_COUNT) {
            const n : usize = tier_model_step(PR_OPENROUTER, ti, st, o[0..64]);
            if (n > 0) {
                assert n > 6;
                assert o[n - 5] == 58 and o[n - 4] == 102 and o[n - 3] == 114 and o[n - 2] == 101 and o[n - 1] == 101;
            }
            ti = ti + 1;
        }
        st = st + 1;
    }
    var pr : u32 = 0;
    while (pr < PROFILE_COUNT) {
        var s2 : u32 = 0;
        while (s2 < MODEL_STEPS and pr != PR_OPENROUTER) {
            const m : usize = tier_model_step(pr, TI_DEFAULT, s2, o[0..64]);
            assert has_bytes(o[0..m], ":free") == false;
            s2 = s2 + 1;
        }
        pr = pr + 1;
    }
}

test the_ollama_cloud_profile_names_one_cloud_model_for_every_tier {
    var o : [64]u8 = undefined;
    assert profile_var_count(PR_OLLAMA_CLOUD) == 8;
    assert profile_var_text(PR_OLLAMA_CLOUD, 0, o[0..64]) == 18;
    assert o[8] == 111 and o[17] == 109;
    assert profile_var_is_key(PR_OLLAMA_CLOUD, 1);
    var ti : u32 = 0;
    while (ti < TIER_COUNT) {
        assert tier_model(PR_OLLAMA_CLOUD, ti, o[0..64]) == 13;
        assert o[4] == 53;
        ti = ti + 1;
    }
    assert profile_var_name(PR_OLLAMA_CLOUD, 7, o[0..64]) == 17;
    assert profile_var_is_key(PR_OLLAMA_CLOUD, 7) == false;
    assert profile_var_text(PR_OLLAMA_CLOUD, 7, o[0..64]) == 0;
}

test the_new_profiles_follow_the_free_zai_tier_and_wait_for_their_own_key {
    assert pick_profile(8, 0) == PR_OPENROUTER;
    assert pick_profile(32, 0) == PR_OLLAMA_CLOUD;
    assert pick_profile(40, 0) == PR_OPENROUTER;
    assert pick_profile(40, 8) == PR_OLLAMA_CLOUD;
    assert pick_profile(40, 40) == PR_NONE;
    assert pick_profile(57, 0) == PR_ZAI;
    // z.ai failed: OpenRouter's free tier comes before the paid Anthropic API, whatever the profile numbers say
    assert pick_profile(57, 16) == PR_OPENROUTER;
    assert pick_profile(57, 17) == PR_OPENROUTER;
    assert pick_profile(57, 24) == PR_ANTHROPIC;
    assert pick_profile(57, 25) == PR_OLLAMA_CLOUD;
    assert pick_profile(4, 0) == PR_NONE;
    assert pick_profile(448, 0) == PR_NONE;
}

test the_chain_goes_forward_only_and_skips_a_missing_or_bad_key {
    assert next_profile(PR_NONE, 57, 0) == PR_ZAI;
    assert next_profile(PR_ZAI, 57, 0) == PR_OPENROUTER;
    assert next_profile(PR_OPENROUTER, 57, 0) == PR_ANTHROPIC;
    assert next_profile(PR_ANTHROPIC, 57, 0) == PR_OLLAMA_CLOUD;
    assert next_profile(PR_OLLAMA_CLOUD, 57, 0) == PR_NONE;
    assert next_profile(PR_ZAI, 57, 1) == PR_OPENROUTER;
    assert next_profile(PR_ZAI, 17, 0) == PR_ANTHROPIC;
    assert next_profile(PR_ANTHROPIC, 17, 0) == PR_NONE;
    assert next_profile(PR_OPENROUTER, 25, 0) == PR_ANTHROPIC;
    assert next_profile(PR_OPENROUTER, 57, 32) == PR_ANTHROPIC;
    assert next_profile(PR_ANTHROPIC, 57, 32) == PR_NONE;
    assert next_profile(PR_OPENROUTER, 57, 33) == PR_NONE;
    assert next_profile(PR_NONE, 0, 0) == PR_NONE;
    assert next_profile(PROFILE_COUNT, 57, 0) == PR_NONE;
    assert next_profile(7, 57, 0) == PR_NONE;
}

test pick_profile_is_the_start_of_the_chain {
    var stored : u32 = 0;
    while (stored < 64) {
        var bad : u32 = 0;
        while (bad < 64) {
            assert pick_profile(stored, bad) == next_profile(PR_NONE, stored, bad);
            bad = bad + 7;
        }
        stored = stored + 1;
    }
}

test a_profile_is_never_offered_twice_by_one_walk {
    var pr : u32 = next_profile(PR_NONE, 57, 0);
    var steps : u32 = 0;
    var prev : u32 = 255;
    while (pr != PR_NONE) {
        if (prev != 255) { assert profile_rank(pr) > profile_rank(prev); }
        prev = pr;
        pr = next_profile(pr, 57, 0);
        steps = steps + 1;
    }
    assert steps == PROFILE_COUNT;
}

test the_tier_order_is_free_zai_then_free_openrouter_then_paid {
    assert PROFILE_TIER.len == PROFILE_COUNT;
    assert PROFILE_TIER[PR_ZAI] == CT_ZAI_FREE;
    assert PROFILE_TIER[PR_OPENROUTER] == CT_OR_FREE;
    assert PROFILE_TIER[PR_ANTHROPIC] == CT_PAID;
    assert PROFILE_TIER[PR_OLLAMA_CLOUD] == CT_PAID;
    assert CT_ZAI_FREE < CT_OR_FREE and CT_OR_FREE < CT_PAID and CT_PAID + 1 == CT_COUNT;
    // the rank is the chain place: tier first, index second, and no two profiles share one
    assert profile_rank(PR_ZAI) < profile_rank(PR_OPENROUTER);
    assert profile_rank(PR_OPENROUTER) < profile_rank(PR_ANTHROPIC);
    assert profile_rank(PR_ANTHROPIC) < profile_rank(PR_OLLAMA_CLOUD);
    var a : u32 = 0;
    while (a < PROFILE_COUNT) {
        var b : u32 = a + 1;
        while (b < PROFILE_COUNT) {
            assert profile_rank(a) != profile_rank(b);
            b = b + 1;
        }
        a = a + 1;
    }
    assert profile_rank(PR_NONE) >= profile_rank(PR_OLLAMA_CLOUD);
    // a new pane with a key for every profile starts on z.ai, and each failure moves it one tier on
    assert pick_profile(57, 0) == PR_ZAI;
    assert next_profile(pick_profile(57, 0), 57, 16) == PR_OPENROUTER;
    assert next_profile(PR_OPENROUTER, 57, 24) == PR_ANTHROPIC;
    // the paid profiles are never offered while a free tier still has a usable key
    var stored : u32 = 0;
    while (stored < 64) {
        const first : u32 = pick_profile(stored, 0);
        if (first != PR_NONE and PROFILE_TIER[first] == CT_PAID) {
            assert (stored >> PROFILE_PROVIDER[PR_ZAI]) % 2 == 0;
            assert (stored >> PROFILE_PROVIDER[PR_OPENROUTER]) % 2 == 0;
        }
        stored = stored + 1;
    }
}

test with_no_openrouter_key_stored_the_free_tier_is_skipped_and_never_an_error_loop {
    // 17 = z.ai + Anthropic, no OpenRouter key: z.ai leads straight to the paid profile
    assert next_profile(PR_ZAI, 17, 0) == PR_ANTHROPIC;
    assert pick_profile(17, 16) == PR_ANTHROPIC;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 17, 0, 0, false) == PR_ANTHROPIC;
    // 16 = z.ai alone: nothing is left after it, the pane gives up and says so
    assert next_profile(PR_ZAI, 16, 0) == PR_NONE;
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 16, 0, 0, false) == FA_GIVE_UP;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 16, 0, 0, false) == PR_NONE;
    // 8 = an OpenRouter key alone: a pane with no profile starts on it
    assert pick_profile(8, 0) == PR_OPENROUTER;
    // with the key stored the tier is offered, and its own failure hands the pane to the paid profile
    assert next_profile(PR_ZAI, 25, 0) == PR_OPENROUTER;
    assert fo_target(FC_RATE_LIMITED, PR_ZAI, 25, 0, 0, false) == PR_OPENROUTER;
    assert fo_target(FC_RATE_LIMITED, PR_OPENROUTER, 25, 16, 1, false) == PR_ANTHROPIC;
    // an OpenRouter key that failed its check is skipped like a missing one
    assert next_profile(PR_ZAI, 25, 8) == PR_ANTHROPIC;
    assert pick_profile(25, 24) == PR_ANTHROPIC;
    // the walk ends in every combination of stored keys: no more steps than profiles
    var stored : u32 = 0;
    while (stored < 64) {
        var pr : u32 = next_profile(PR_NONE, stored, 0);
        var steps : u32 = 0;
        while (pr != PR_NONE and steps < 10) {
            pr = next_profile(pr, stored, 0);
            steps = steps + 1;
        }
        assert steps <= PROFILE_COUNT;
        stored = stored + 1;
    }
}

test an_openrouter_request_is_owed_exactly_when_its_key_is_absent {
    var o : [48]u8 = undefined;
    assert needs_key_request(P_OPENROUTER, 0);
    assert needs_key_request(P_OPENROUTER, 1) == false;
    assert needs_key_request(P_OPENROUTER, MAX_KEYS) == false;
    // no other provider is asked for: z.ai and the paid ones keep the old "no key stored" row
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (p != P_OPENROUTER) {
            assert needs_key_request(p, 0) == false;
            assert needs_key_request(p, 1) == false;
        }
        p = p + 1;
    }
    // the text is one short English line and is given only while the request is owed
    const n : usize = key_request_text(P_OPENROUTER, 0, o[0..48]);
    assert n == 44;
    assert begins_with(o[0..n], "Add an OpenRouter key to use its free models");
    assert key_request_text(P_OPENROUTER, 1, o[0..48]) == 0;
    assert key_request_text(P_ZAI, 0, o[0..48]) == 0;
    var i : usize = 0;
    while (i < n) {
        assert o[i] >= 32 and o[i] < 127;
        i = i + 1;
    }
}

test rotation_can_skip_the_key_that_just_failed {
    var used : [3]u64 = [50, 10, 30];
    var rest : [3]u64 = [0, 0, 0];
    assert rotate_pick_except(3, 1, used[0..3], rest[0..3], 100) == 2;
    assert rotate_pick_except(3, 2, used[0..3], rest[0..3], 100) == 1;
    assert rotate_pick_except(3, 3, used[0..3], rest[0..3], 100) == 1;
    rest[0] = 200;
    assert rotate_pick_except(3, 1, used[0..3], rest[0..3], 100) == 2;
    rest[2] = 200;
    assert rotate_pick_except(3, 1, used[0..3], rest[0..3], 100) == 3;
    assert rotate_pick_except(1, 0, used[0..3], rest[0..3], 100) == 1;
}

test a_second_key_has_its_own_keychain_item_and_the_first_keeps_the_old_one {
    var a : [48]u8 = undefined;
    var b : [48]u8 = undefined;
    assert keychain_label_n(P_OPENAI, 0, a[0..48]) == 16;
    assert keychain_label(P_OPENAI, b[0..48]) == 16;
    assert a[15] == b[15] and a[10] == b[10];
    assert keychain_label_n(P_OPENAI, 1, a[0..48]) == 18;
    assert a[16] == 35 and a[17] == 50;
    assert keychain_label_n(P_OPENAI, 2, a[0..48]) == 18;
    assert a[16] == 35 and a[17] == 51;
    assert keychain_label_n(P_OPENAI, MAX_KEYS, a[0..48]) == 0;
    assert keychain_label_n(PROVIDER_COUNT, 0, a[0..48]) == 0;
}

test a_status_code_must_stand_alone_to_count {
    assert has_code("API Error: 429 slow down", "429");
    assert has_code("error 429", "429");
    assert has_code("429 error", "429");
    assert has_code("error 429x", "429");
    assert has_code("error 1429", "429") == false;
    assert has_code("error 4290", "429") == false;
    assert has_code("error 14290 and 429", "429");
    assert has_code("error", "429") == false;
    assert has_code("", "429") == false;
    assert has_bytes("abc", "bc");
    assert has_bytes("abc", "abcd") == false;
    assert has_bytes("abc", "") == false;
}

test a_screen_line_is_sorted_into_a_failure_class {
    assert classify_line("API Error: 429 {\"error\":{\"message\":\"Insufficient balance\"}}") == FC_NO_BALANCE;
    assert classify_line("Insufficient balance") == FC_NO_BALANCE;
    assert classify_line("API Error: 429 rate limit reached, retry later") == FC_RATE_LIMITED;
    assert classify_line("Your organization has disabled Claude subscription access") == FC_SUBSCRIPTION;
    assert classify_line("API Error: 401 invalid credentials") == FC_LOGIN_REJECTED;
    assert classify_line("Request failed with error 403 forbidden") == FC_LOGIN_REJECTED;
    assert classify_line("API Error: 500 upstream failure") == FC_OTHER;
    assert classify_line("Edited 429 lines in 3 files") == FC_NONE;
    assert classify_line("error: read 14290 tokens") == FC_NONE;
    assert classify_line("Reading specs/t27os/keys.t27") == FC_NONE;
    assert classify_line("") == FC_NONE;
}

test an_overload_is_its_own_class_and_the_balance_code_still_marks_the_key_bad {
    // what z.ai answered on the free flash model, 2026-10-20 (code 1305, HTTP 529 or 429)
    assert classify_line("API Error: 529 {\"error\":{\"code\":\"1305\",\"message\":\"The service may be temporarily overloaded\"}}") == FC_OVERLOADED;
    assert classify_line("API Error: 429 {\"error\":{\"code\":\"1305\",\"message\":\"overloaded, retry\"}}") == FC_OVERLOADED;
    assert classify_line("API Error (529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}})") == FC_OVERLOADED;
    assert classify_line("Request failed with error 1305") == FC_OVERLOADED;
    assert classify_line("error 529") == FC_OVERLOADED;
    // the paid models answered 1113: still out of balance, even next to a 429 or the word overloaded
    assert classify_line("API Error: 429 {\"error\":{\"code\":\"1113\",\"message\":\"Insufficient balance\"}}") == FC_NO_BALANCE;
    assert classify_line("API Error: 429 {\"error\":{\"code\":\"1113\"") == FC_NO_BALANCE;
    assert classify_line("API Error: 429 code 1113 overloaded") == FC_NO_BALANCE;
    // a number glued to digits, or a line that is no error, is no overload
    assert classify_line("error 5290") == FC_NONE;
    assert classify_line("error 13050") == FC_NONE;
    assert classify_line("Edited 529 lines in 3 files") == FC_NONE;
    assert classify_line("the service was overloaded earlier") == FC_NONE;
    assert classify_line("API Error: 429 rate limit reached") == FC_RATE_LIMITED;
}

test only_an_error_row_is_ever_classified_never_the_body_of_the_transcript {
    assert error_row("API Error: 529 {\"error\":{\"code\":\"1305\"}}");
    assert error_row("   API Error: 429 Insufficient balance");
    assert error_row("Error: 401 invalid credentials");
    assert error_row("Request failed with error 403");
    assert error_row("Your organization has disabled Claude subscription access");
    assert error_row("Insufficient balance or no resource package");
    // a diff or a quoted line that merely shows the phrases
    assert error_row("+    assert classify_line(\"API Error: 429 Insufficient balance\") == FC_NO_BALANCE;") == false;
    assert error_row("The log said API Error: 529 yesterday") == false;
    assert error_row("  - Error handling for 429 added") == false;
    assert error_row("Reading specs/t27os/keys.t27") == false;
    assert error_row("") == false;
    assert error_row("   ") == false;
    // Claude Code's own retry in flight: the turn is alive, the failover waits
    assert error_row("API Error: 429 [1302] Rate limit reached for requests - Retrying in 4 seconds (attempt 3/10)");
    assert error_row("API Error: 429 rate limit reached - Retrying in 8 seconds (attempt 9/10)") == false;
    // a retry cannot cure an empty account, a disabled subscription or a rejected key: the row counts at once
    assert error_row("API Error: 429 {\"error\":{\"code\":\"1113\",\"message\":\"Insufficient balance or no resource package\"}} - Retrying in 8 seconds (attempt 9/10)");
    assert error_row("  API Error (401 invalid credentials) Retrying in 2 seconds (attempt 1/10)");
    assert error_row("Your organization has disabled Claude subscription access - Retrying in 2 seconds");
    // a diff or a quote that shows a retry row is still no error row
    assert error_row("+    \"API Error: 429 1113 Insufficient balance Retrying in 8 seconds (attempt 9/10)\"") == false;
    assert error_row("The log said API Error: 429 Insufficient balance Retrying") == false;
    assert begins_with("abc", "ab");
    assert begins_with("abc", "abcd") == false;
    assert begins_with("abc", "");
    assert begins_with("", "a") == false;
}

test an_overloaded_key_with_a_spare_swaps_the_key_and_keeps_the_profile {
    assert fo_action(FC_OVERLOADED, PR_ZAI, 57, 0, 0, true) == FA_RESPAWN_KEY;
    assert fo_target(FC_OVERLOADED, PR_ZAI, 57, 0, 0, true) == PR_ZAI;
    // no other key usable now: the pane leaves the profile, as for a throttled key with no spare
    assert fo_action(FC_OVERLOADED, PR_ZAI, 57, 0, 0, false) == FA_RESPAWN_NEXT;
    assert fo_target(FC_OVERLOADED, PR_ZAI, 57, 0, 0, false) == PR_OPENROUTER;
    assert fo_action(FC_OVERLOADED, PR_ZAI, 16, 0, 0, false) == FA_GIVE_UP;
    assert fo_action(FC_OVERLOADED, PR_NONE, 57, 0, 0, true) == FA_RESPAWN_NEXT;
    assert fo_action(FC_OVERLOADED, PR_ZAI, 57, 0, MAX_FAILOVERS, true) == FA_GIVE_UP;
    var done : u32 = 0;
    while (done < 100 and fo_action(FC_OVERLOADED, PR_ZAI, 57, 0, done, true) == FA_RESPAWN_KEY) {
        done = done + 1;
    }
    assert done == MAX_FAILOVERS;
}

test the_overload_why_line_names_the_class_and_never_a_key {
    var o : [128]u8 = undefined;
    const n : usize = fo_why(FC_OVERLOADED, PR_ZAI, FA_RESPAWN_KEY, PR_ZAI, 1, o[0..128]);
    assert has_bytes(o[0..n], "claude: zai overloaded (529), same profile with the next key");
    const m : usize = fo_why(FC_OVERLOADED, PR_ZAI, FA_RESPAWN_NEXT, PR_ANTHROPIC, 1, o[0..128]);
    assert has_bytes(o[0..m], "zai overloaded (529), respawn on anthropic-api");
    assert csv_fields(FC_WORDS) == FC_OVERLOADED + 1;
}

test a_failed_key_rests_by_the_kind_of_failure {
    assert key_rest_after(FC_RATE_LIMITED) == RATE_COOLDOWN_S;
    assert key_rest_after(FC_OVERLOADED) == OVERLOAD_COOLDOWN_S;
    assert key_rest_after(FC_NO_BALANCE) == BALANCE_REST_S;
    assert key_rest_after(FC_LOGIN_REJECTED) == REJECT_REST_S;
    assert key_rest_after(FC_NONE) == 0;
    assert key_rest_after(FC_OTHER) == 0;
    assert key_rest_after(FC_SUBSCRIPTION) == 0;
    assert key_rest_after(FC_OVERLOADED) > key_rest_after(FC_RATE_LIMITED);
    assert key_rest_after(FC_NO_BALANCE) > key_rest_after(FC_OVERLOADED);
    assert key_rest_after(FC_LOGIN_REJECTED) > key_rest_after(FC_NO_BALANCE);
}

test a_pane_takes_a_resting_key_only_when_no_key_is_free {
    var used : [4]u64 = [50, 10, 30, 0];
    var rest : [4]u64 = [0, 0, 0, KEY_NEVER];
    // slot 3 holds no key: never taken; the key used longest ago wins
    assert rotate_pick_soft(4, 4, used[0..4], rest[0..4], 100) == 1;
    assert rotate_pick_soft(4, 1, used[0..4], rest[0..4], 100) == 2;
    // every present key rests: the one that is free first
    rest[0] = 300;
    rest[1] = 200;
    rest[2] = 250;
    assert rotate_pick_except(4, 4, used[0..4], rest[0..4], 100) == 4;
    assert rotate_pick_soft(4, 4, used[0..4], rest[0..4], 100) == 1;
    assert rotate_pick_soft(4, 1, used[0..4], rest[0..4], 100) == 2;
    // only the skipped key is left: none
    rest[0] = KEY_NEVER;
    rest[2] = KEY_NEVER;
    assert rotate_pick_soft(4, 1, used[0..4], rest[0..4], 100) == 4;
    assert rotate_pick_soft(4, 4, used[0..4], rest[0..4], 100) == 1;
    rest[1] = KEY_NEVER;
    assert rotate_pick_soft(4, 4, used[0..4], rest[0..4], 100) == 4;
}

test eight_keys_rotate_so_each_is_used_once_before_any_is_used_twice {
    var used : [8]u64 = [0, 0, 0, 0, 0, 0, 0, 0];
    var rest : [8]u64 = [0, 0, 0, 0, 0, 0, 0, KEY_NEVER];
    var seen : u32 = 0;
    var t : u64 = 1;
    var round : u32 = 0;
    while (round < 7) {
        const k : u32 = rotate_pick(8, used[0..8], rest[0..8], t);
        assert k < 7;
        assert (seen >> k) % 2 == 0;
        seen = seen + (1 << k);
        used[k] = t;
        t = t + 1;
        round = round + 1;
    }
    assert seen == 127;
    assert rotate_pick(8, used[0..8], rest[0..8], t) == 0;
}

test the_account_of_key_k_is_the_provider_name_with_a_number {
    var a : [32]u8 = undefined;
    assert keychain_account_n(P_ZAI, 0, a[0..32]) == 3;
    assert a[0] == 122 and a[2] == 105;
    assert keychain_account_n(P_ZAI, 1, a[0..32]) == 5;
    assert a[3] == 35 and a[4] == 50;
    assert keychain_account_n(P_ZAI, 6, a[0..32]) == 5;
    assert a[3] == 35 and a[4] == 55;
    assert keychain_account_n(P_ANTHROPIC, 7, a[0..32]) == 11;
    assert a[9] == 35 and a[10] == 56;
    assert keychain_account_n(P_ZAI, MAX_KEYS, a[0..32]) == 0;
    assert keychain_account_n(PROVIDER_COUNT, 0, a[0..32]) == 0;
    assert MAX_KEYS == 8;
    var l : [48]u8 = undefined;
    assert keychain_label_n(P_ZAI, 7, l[0..48]) == 15;
    assert l[13] == 35 and l[14] == 56;
}

test each_agent_cli_gets_the_variable_of_every_provider_it_reads_and_no_other {
    // The pane's environment is built from AGENT_PROVIDERS and PROVIDER_ENVS only (pty_server inject_keys), one
    // variable per provider the cell reads, carrying the key the rotation picked. These are the pairs.
    var o : [40]u8 = undefined;
    var n : usize = provider_env(P_OPENAI, o[0..40]);
    assert agent_uses(1, P_OPENAI) and has_bytes(o[0..n], "OPENAI_API_KEY") and n == 14;
    n = provider_env(P_GEMINI, o[0..40]);
    assert agent_uses(2, P_GEMINI) and has_bytes(o[0..n], "GEMINI_API_KEY") and n == 14;
    n = provider_env(P_ZAI, o[0..40]);
    assert agent_uses(5, P_ZAI) and has_bytes(o[0..n], "ZAI_API_KEY") and n == 11;
    n = provider_env(P_CURSOR, o[0..40]);
    assert agent_uses(6, P_CURSOR) and has_bytes(o[0..n], "CURSOR_API_KEY") and n == 14;
    n = provider_env(P_GITHUB, o[0..40]);
    assert agent_uses(8, P_GITHUB) and has_bytes(o[0..n], "GITHUB_TOKEN") and n == 12;
    n = provider_env(P_OPENROUTER, o[0..40]);
    assert agent_uses(3, P_OPENROUTER) and agent_uses(7, P_OPENROUTER) and has_bytes(o[0..n], "OPENROUTER_API_KEY");
    // a cell never gets a variable of a provider it does not read
    assert agent_uses(1, P_ZAI) == false;
    assert agent_uses(2, P_OPENAI) == false;
    assert agent_uses(8, P_ANTHROPIC) == false;
    assert agent_uses(6, P_GITHUB) == false;
    // Claude Code is the one cell with profile variables, and its z.ai profile reads the z.ai provider's keys
    assert profile_agent(0) and profile_agent(3) and profile_agent(5);
    assert profile_agent(1) == false and profile_agent(2) == false and profile_agent(4) == false and profile_agent(6) == false;
    assert PROFILE_PROVIDER[PR_ZAI] == P_ZAI;
    // every provider a cell reads has a variable name
    var a : u32 = 0;
    while (a < AGENT_COUNT) {
        var p : u32 = 0;
        while (p < PROVIDER_COUNT) {
            if (agent_uses(a, p)) { assert provider_env(p, o[0..40]) > 0; }
            p = p + 1;
        }
        a = a + 1;
    }
}

test a_keys_row_says_how_many_keys_the_provider_holds {
    var o : [24]u8 = undefined;
    assert key_count_text(0, o[0..24]) == 0;
    assert key_count_text(1, o[0..24]) == 5;
    assert o[0] == 49 and o[2] == 107 and o[4] == 121;
    assert key_count_text(7, o[0..24]) == 6;
    assert o[0] == 55 and o[5] == 115;
    assert key_count_text(MAX_KEYS, o[0..24]) == 6;
    assert o[0] == 56;
}

test the_key_number_rides_in_the_high_nibble_of_the_setkey_byte {
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        var k : u32 = 0;
        while (k < MAX_KEYS) {
            const b : u32 = setkey_byte(p, k);
            assert b < 256;
            assert setkey_provider(b) == p;
            assert setkey_number(b) == k;
            k = k + 1;
        }
        p = p + 1;
    }
    // key 1 is the old frame byte
    assert setkey_byte(P_ZAI, 0) == P_ZAI;
    assert setkey_number(P_GONKA) == 0;
    // a byte from a newer client that this table cannot hold reads as unknown
    assert setkey_provider(setkey_byte(11, 0)) >= PROVIDER_COUNT;
    assert PROVIDER_COUNT <= SETKEY_STEP;
    assert MAX_KEYS * SETKEY_STEP <= 256;
}

test a_failure_marks_the_provider_bad_for_this_pane {
    assert fo_bad(FC_NO_BALANCE, PR_ZAI, 0) == 16;
    assert fo_bad(FC_LOGIN_REJECTED, PR_ANTHROPIC, 16) == 17;
    assert fo_bad(FC_LOGIN_REJECTED, PR_ANTHROPIC, 17) == 17;
    assert fo_bad(FC_RATE_LIMITED, PR_OPENROUTER, 0) == 8;
    assert fo_bad(FC_RATE_LIMITED, PR_OLLAMA_CLOUD, 0) == 32;
    assert fo_bad(FC_NONE, PR_ZAI, 0) == 0;
    assert fo_bad(FC_OTHER, PR_ZAI, 0) == 0;
    assert fo_bad(FC_NO_BALANCE, PR_NONE, 5) == 5;
}

test no_error_or_an_unknown_one_leaves_the_pane_alone {
    assert fo_action(FC_NONE, PR_ZAI, 57, 0, 0, false) == FA_KEEP;
    assert fo_action(FC_OTHER, PR_ZAI, 57, 0, 0, true) == FA_KEEP;
    assert fo_target(FC_NONE, PR_ZAI, 57, 0, 0, false) == PR_NONE;
}

test a_dead_profile_hands_the_pane_to_the_next_one {
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 57, 0, 0, false) == FA_RESPAWN_NEXT;
    // the free tiers first: z.ai, then OpenRouter's `:free` ids, then the paid profiles
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 57, 0, 0, false) == PR_OPENROUTER;
    assert fo_target(FC_RATE_LIMITED, PR_OPENROUTER, 57, 16, 1, false) == PR_ANTHROPIC;
    assert fo_target(FC_LOGIN_REJECTED, PR_ANTHROPIC, 57, 24, 2, false) == PR_OLLAMA_CLOUD;
    assert fo_target(FC_RATE_LIMITED, PR_OPENROUTER, 57, 17, 2, false) == PR_OLLAMA_CLOUD;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 41, 0, 0, false) == PR_OPENROUTER;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 40, 0, 0, false) == PR_OPENROUTER;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 33, 0, 0, false) == PR_ANTHROPIC;
}

test a_throttled_key_with_a_spare_swaps_the_key_and_keeps_the_profile {
    assert fo_action(FC_RATE_LIMITED, PR_ZAI, 57, 0, 0, true) == FA_RESPAWN_KEY;
    assert fo_target(FC_RATE_LIMITED, PR_ZAI, 57, 0, 0, true) == PR_ZAI;
    assert fo_bad(FC_RATE_LIMITED, PR_ZAI, 0) == 16;
    // an empty or a rejected key is one account's: another key of the provider is tried before the profile is left
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 57, 0, 0, true) == FA_RESPAWN_KEY;
    assert fo_target(FC_NO_BALANCE, PR_ZAI, 57, 0, 0, true) == PR_ZAI;
    assert fo_action(FC_LOGIN_REJECTED, PR_ZAI, 57, 0, 0, true) == FA_RESPAWN_KEY;
    // no spare key (or a subscription row, which names no key): the next profile, as before
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 57, 0, 0, false) == FA_RESPAWN_NEXT;
    assert fo_action(FC_LOGIN_REJECTED, PR_ZAI, 57, 0, 0, false) == FA_RESPAWN_NEXT;
    assert fo_action(FC_SUBSCRIPTION, PR_ZAI, 57, 0, 0, true) == FA_RESPAWN_NEXT;
    assert fo_action(FC_RATE_LIMITED, PR_NONE, 57, 0, 0, true) == FA_RESPAWN_NEXT;
    // with only z.ai keys stored an empty key used to end in a give-up although other keys were at hand
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 16, 0, 0, true) == FA_RESPAWN_KEY;
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 16, 0, 0, false) == FA_GIVE_UP;
}

test a_pane_without_a_key_takes_the_first_stored_profile {
    assert fo_action(FC_SUBSCRIPTION, PR_NONE, 16, 0, 0, false) == FA_RESPAWN_NEXT;
    assert fo_target(FC_SUBSCRIPTION, PR_NONE, 16, 0, 0, false) == PR_ZAI;
    assert fo_target(FC_SUBSCRIPTION, PR_NONE, 8, 0, 0, false) == PR_OPENROUTER;
    assert fo_action(FC_SUBSCRIPTION, PR_NONE, 0, 0, 0, false) == FA_GIVE_UP;
    assert fo_action(FC_SUBSCRIPTION, PR_NONE, 16, 16, 0, false) == FA_GIVE_UP;
    assert fo_action(FC_SUBSCRIPTION, PR_NONE, 6, 0, 0, false) == FA_GIVE_UP;
}

test the_last_profile_failing_gives_up {
    assert fo_action(FC_NO_BALANCE, PR_OLLAMA_CLOUD, 57, 57, 3, false) == FA_GIVE_UP;
    assert fo_target(FC_NO_BALANCE, PR_OLLAMA_CLOUD, 57, 57, 3, false) == PR_NONE;
    assert fo_action(FC_LOGIN_REJECTED, PR_ANTHROPIC, 17, 16, 1, false) == FA_GIVE_UP;
    assert fo_action(FC_RATE_LIMITED, PR_OLLAMA_CLOUD, 57, 0, 3, false) == FA_GIVE_UP;
    assert fo_action(FC_NO_BALANCE, 7, 57, 0, 0, false) == FA_GIVE_UP;
}

test a_pane_that_fails_on_every_profile_ends_in_give_up_after_each_was_tried_once {
    var pr : u32 = PR_NONE;
    var bad : u32 = 0;
    var done : u32 = 0;
    var tried : u32 = 0;
    var act : u32 = FA_KEEP;
    var guard : u32 = 0;
    while (guard < 30) {
        act = fo_action(FC_NO_BALANCE, pr, 57, bad, done, false);
        if (act != FA_RESPAWN_NEXT) { guard = 30; }
        else {
            bad = fo_bad(FC_NO_BALANCE, pr, bad);
            pr = fo_target(FC_NO_BALANCE, pr, 57, bad, done, false);
            assert (tried >> pr) % 2 == 0;
            tried = tried + (1 << pr);
            done = done + 1;
            guard = guard + 1;
        }
    }
    assert act == FA_GIVE_UP;
    assert done == PROFILE_COUNT;
    assert tried == 15;
}

test a_host_that_always_reports_a_spare_key_still_cannot_loop {
    var done : u32 = 0;
    while (done < 100 and fo_action(FC_RATE_LIMITED, PR_ZAI, 57, 0, done, true) == FA_RESPAWN_KEY) {
        done = done + 1;
    }
    assert done == MAX_FAILOVERS;
    assert fo_action(FC_RATE_LIMITED, PR_ZAI, 57, 0, done, true) == FA_GIVE_UP;
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 57, 0, MAX_FAILOVERS, false) == FA_GIVE_UP;
    assert MAX_FAILOVERS >= PROFILE_COUNT;
}

test the_failover_why_line_names_the_profile_and_the_move_and_never_a_key {
    var o : [128]u8 = undefined;
    var n : usize = fo_why(FC_NONE, PR_ZAI, FA_KEEP, PR_NONE, 0, o[0..128]);
    assert has_bytes(o[0..n], "no provider error");
    n = fo_why(FC_NO_BALANCE, PR_ZAI, FA_RESPAWN_NEXT, PR_ANTHROPIC, 0, o[0..128]);
    assert has_bytes(o[0..n], "claude: zai out of balance, respawn on anthropic-api");
    n = fo_why(FC_RATE_LIMITED, PR_OPENROUTER, FA_RESPAWN_KEY, PR_OPENROUTER, 2, o[0..128]);
    assert has_bytes(o[0..n], "openrouter rate limited (429), same profile with the next key");
    n = fo_why(FC_SUBSCRIPTION, PR_NONE, FA_RESPAWN_NEXT, PR_ZAI, 0, o[0..128]);
    assert has_bytes(o[0..n], "no profile subscription disabled, respawn on zai");
    n = fo_why(FC_LOGIN_REJECTED, PR_OLLAMA_CLOUD, FA_GIVE_UP, PR_NONE, 3, o[0..128]);
    assert has_bytes(o[0..n], "ollama-cloud login rejected (401/403), no profile left in the chain");
    assert n < 128;
    n = fo_why(FC_RATE_LIMITED, PR_ZAI, FA_GIVE_UP, PR_NONE, MAX_FAILOVERS, o[0..128]);
    assert has_bytes(o[0..n], "failover limit reached");
}

test a_pane_with_no_key_left_on_its_model_takes_the_next_model_of_the_tier_before_the_next_profile {
    // z.ai has two models: key swaps first (fo_action), then the next model, then fo_action's profile chain
    assert fo_action(FC_NO_BALANCE, PR_ZAI, 57, 0, 3, true) == FA_RESPAWN_KEY;
    assert fo_next_model(FC_NO_BALANCE, PR_ZAI, 0, 3, true) == false;
    assert fo_next_model(FC_NO_BALANCE, PR_ZAI, 0, 3, false);
    assert fo_next_model(FC_RATE_LIMITED, PR_ZAI, 0, 3, false);
    assert fo_next_model(FC_OVERLOADED, PR_ZAI, 0, 3, false);
    assert fo_next_model(FC_LOGIN_REJECTED, PR_ZAI, 0, 3, false);
    // on its last model, a profile with one model, a row that names no key, or at the cap: no model step
    assert fo_next_model(FC_NO_BALANCE, PR_ZAI, 1, 3, false) == false;
    assert fo_next_model(FC_NO_BALANCE, PR_ANTHROPIC, 0, 3, false) == false;
    assert fo_next_model(FC_NO_BALANCE, PR_NONE, 0, 3, false) == false;
    assert fo_next_model(FC_SUBSCRIPTION, PR_ZAI, 0, 3, false) == false;
    assert fo_next_model(FC_NONE, PR_ZAI, 0, 3, false) == false;
    assert fo_next_model(FC_OTHER, PR_ZAI, 0, 3, false) == false;
    assert fo_next_model(FC_NO_BALANCE, PR_ZAI, 0, MAX_FAILOVERS, false) == false;
    // OpenRouter's free tier holds the two verified models: the next one at step 0, none after the last
    assert fo_next_model(FC_RATE_LIMITED, PR_OPENROUTER, 0, 3, false);
    assert fo_next_model(FC_OVERLOADED, PR_OPENROUTER, 1, 3, false) == false;
    assert fo_next_model(FC_RATE_LIMITED, PR_OPENROUTER, 0, 3, true) == false;
    // the cap leaves room for every key of each free provider on each model of its tier, then every profile
    assert MAX_FAILOVERS >= MAX_KEYS * (profile_models(PR_ZAI) + profile_models(PR_OPENROUTER)) + PROFILE_COUNT;
    var o : [128]u8 = undefined;
    const n : usize = fo_why(FC_NO_BALANCE, PR_ZAI, FA_RESPAWN_MODEL, PR_ZAI, 3, o[0..128]);
    assert has_bytes(o[0..n], "claude: zai out of balance, every key tried, same profile on the next model");
    assert n < 128;
}

test a_pane_whose_zai_keys_all_rest_moves_to_openrouter_and_after_its_free_ids_to_the_paid_profile {
    // the decisions a pane meets in order, with every key of the tier failing: stored 57 = every profile has a key
    // z.ai, last key, last model: no key and no model left, so the next tier
    assert fo_next_model(FC_OVERLOADED, PR_ZAI, 1, 5, false) == false;
    assert fo_action(FC_OVERLOADED, PR_ZAI, 57, 0, 5, false) == FA_RESPAWN_NEXT;
    assert fo_target(FC_OVERLOADED, PR_ZAI, 57, 0, 5, false) == PR_OPENROUTER;
    // OpenRouter's only key failed: its two verified free ids in turn, then the paid profile
    assert fo_next_model(FC_RATE_LIMITED, PR_OPENROUTER, 0, 6, false);
    assert fo_next_model(FC_RATE_LIMITED, PR_OPENROUTER, 1, 7, false) == false;
    assert fo_action(FC_RATE_LIMITED, PR_OPENROUTER, 57, 16, 8, false) == FA_RESPAWN_NEXT;
    assert fo_target(FC_RATE_LIMITED, PR_OPENROUTER, 57, 16, 8, false) == PR_ANTHROPIC;
    // with no OpenRouter key stored (stored 49 = z.ai, Anthropic, Ollama): z.ai goes to the paid profile
    assert fo_target(FC_OVERLOADED, PR_ZAI, 49, 0, 5, false) == PR_ANTHROPIC;
    // with no paid key either (stored 16 or 24) the last free tier ends in the give-up line
    assert fo_action(FC_OVERLOADED, PR_ZAI, 16, 0, 5, false) == FA_GIVE_UP;
    assert fo_action(FC_RATE_LIMITED, PR_OPENROUTER, 24, 16, 8, false) == FA_GIVE_UP;
    var o : [128]u8 = undefined;
    const n : usize = fo_why(FC_OVERLOADED, PR_ZAI, FA_RESPAWN_NEXT, PR_OPENROUTER, 5, o[0..128]);
    assert has_bytes(o[0..n], "claude: zai overloaded (529), respawn on openrouter");
    const g : usize = fo_why(FC_RATE_LIMITED, PR_OPENROUTER, FA_GIVE_UP, PR_NONE, 8, o[0..128]);
    assert has_bytes(o[0..g], "claude: openrouter rate limited (429), no profile left in the chain, the pane stays");
    assert g < 128;
}

test the_openrouter_models_measured_on_a_key_are_the_only_ones_and_the_thinking_one_has_a_token_floor {
    var o : [64]u8 = undefined;
    assert tier_model_step(PR_OPENROUTER, TI_DEFAULT, 0, o[0..64]) == 31;
    assert begins_with(o[0..31], "minimax/minimax-m3.1-flash:free");
    assert tier_model_step(PR_OPENROUTER, TI_DEFAULT, 1, o[0..64]) == 33;
    assert begins_with(o[0..33], "nvidia/nemotron-3.5-super-vl:free");
    assert tier_model_step(PR_OPENROUTER, TI_DEFAULT, 2, o[0..64]) == 0;
    assert csv_field(MODELS_THIRD, PR_OPENROUTER, o[0..64]) == 0;
    // super-vl thinks first (31 output tokens measured): a text request needs more than max_tokens 16
    assert THINKING_MIN_TOKENS == 64 and THINKING_MIN_TOKENS > 31;
    assert model_min_tokens(PR_OPENROUTER, 1) == THINKING_MIN_TOKENS;
    assert model_min_tokens(PR_OPENROUTER, 0) == PLAIN_MIN_TOKENS;
    assert model_min_tokens(PR_ZAI, 0) == PLAIN_MIN_TOKENS;
    assert model_min_tokens(PR_ZAI, 1) == PLAIN_MIN_TOKENS;
}

test opencode_and_crush_take_the_zai_anthropic_and_openrouter_profiles_and_not_ollama {
    assert agent_profile_ok(AG_OPENCODE, PR_ZAI) and agent_profile_ok(AG_OPENCODE, PR_ANTHROPIC) and agent_profile_ok(AG_OPENCODE, PR_OPENROUTER);
    assert agent_profile_ok(AG_CRUSH, PR_ZAI) and agent_profile_ok(AG_CRUSH, PR_OPENROUTER);
    assert agent_profile_ok(AG_OPENCODE, PR_OLLAMA_CLOUD) == false and agent_profile_ok(AG_CRUSH, PR_OLLAMA_CLOUD) == false;
    assert agent_profile_ok(AG_CLAUDE, PR_OLLAMA_CLOUD);
    assert agent_profile_ok(1, PR_ZAI) == false and agent_profile_ok(AG_CRUSH, PR_NONE) == false;
    // only the ollama bit (5) stored: Claude Code has a key, OpenCode and Crush have none
    assert agent_stored(AG_CLAUDE, 32) == 32;
    assert agent_stored(AG_OPENCODE, 32) == 0 and pick_profile(agent_stored(AG_CRUSH, 32), 0) == PR_NONE;
    assert agent_stored(AG_CRUSH, 57) == 25;
    // the chain of a Crush pane with every key stored goes z.ai, OpenRouter, anthropic-api, then ends
    const st : u32 = agent_stored(AG_CRUSH, 511);
    assert pick_profile(st, 0) == PR_ZAI;
    assert next_profile(PR_ZAI, st, 0) == PR_OPENROUTER;
    assert next_profile(PR_OPENROUTER, st, 0) == PR_ANTHROPIC;
    assert next_profile(PR_ANTHROPIC, st, 0) == PR_NONE;
}

test an_opencode_pane_gets_the_key_variable_and_one_inline_config_that_holds_no_key {
    var o : [700]u8 = undefined;
    var m : [64]u8 = undefined;
    assert agent_var_count(AG_OPENCODE, PR_ZAI) == 2 and agent_var_count(AG_OPENCODE, PR_OPENROUTER) == 2;
    assert agent_var_count(AG_OPENCODE, PR_ANTHROPIC) == 1 and agent_var_count(AG_OPENCODE, PR_OLLAMA_CLOUD) == 0;
    var n : usize = agent_var_name(AG_OPENCODE, PR_ZAI, 0, m[0..64]);
    assert n == 11 and begins_with(m[0..n], "ZAI_API_KEY");
    assert agent_var_is_key(AG_OPENCODE, PR_ZAI, 0) and agent_var_is_key(AG_OPENCODE, PR_ZAI, 1) == false;
    n = agent_var_name(AG_OPENCODE, PR_ZAI, 1, m[0..64]);
    assert n == 23 and begins_with(m[0..n], "OPENCODE_CONFIG_CONTENT");
    n = agent_var_name(AG_OPENCODE, PR_OPENROUTER, 0, m[0..64]);
    assert begins_with(m[0..n], "OPENROUTER_API_KEY");
    n = agent_var_name(AG_OPENCODE, PR_ANTHROPIC, 0, m[0..64]);
    assert begins_with(m[0..n], "ANTHROPIC_API_KEY");
    assert agent_var_name(AG_OPENCODE, PR_ANTHROPIC, 1, m[0..64]) == 0;
    // z.ai: the OpenAI-compatible endpoint, glm-4.5-flash first, the key by reference to its variable
    n = agent_var_text_step(AG_OPENCODE, PR_ZAI, 1, 0, "/h", o[0..700]);
    assert n > 0 and n < 700;
    assert has_bytes(o[0..n], "\"baseURL\":\"https://api.z.ai/api/paas/v4\"");
    assert has_bytes(o[0..n], "\"apiKey\":\"{env:ZAI_API_KEY}\"");
    assert has_bytes(o[0..n], "\"model\":\"t27/glm-4.5-flash\"");
    assert has_bytes(o[0..n], "@ai-sdk/openai-compatible");
    n = agent_var_text_step(AG_OPENCODE, PR_ZAI, 1, 1, "/h", o[0..700]);
    assert has_bytes(o[0..n], "\"model\":\"t27/glm-4.7-flash\"");
    assert agent_var_text_step(AG_OPENCODE, PR_ZAI, 1, 2, "/h", o[0..700]) == 0;
    n = agent_var_text_step(AG_OPENCODE, PR_OPENROUTER, 1, 0, "/h", o[0..700]);
    assert has_bytes(o[0..n], "\"baseURL\":\"https://openrouter.ai/api/v1\"");
    assert has_bytes(o[0..n], "{env:OPENROUTER_API_KEY}");
    assert has_bytes(o[0..n], "\"model\":\"t27/minimax/minimax-m3.1-flash:free\"");
    n = agent_var_text_step(AG_OPENCODE, PR_OPENROUTER, 1, 1, "/h", o[0..700]);
    assert has_bytes(o[0..n], "t27/nvidia/nemotron-3.5-super-vl:free");
    // the key variable has no constant text, and no config exists for the profile with none
    assert agent_var_text_step(AG_OPENCODE, PR_ZAI, 0, 0, "/h", o[0..700]) == 0;
    assert opencode_config(PR_ANTHROPIC, 0, o[0..700]) == 0 and opencode_config(PR_NONE, 0, o[0..700]) == 0;
    // Claude Code keeps its own variables through the same door
    assert agent_var_count(AG_CLAUDE, PR_ZAI) == 7 and agent_var_is_key(AG_CLAUDE, PR_ZAI, 1);
    n = agent_var_text_step(AG_CLAUDE, PR_ZAI, 0, 0, "/h", o[0..700]);
    assert n == 30;
}

test a_crush_pane_gets_the_key_variable_and_the_directory_of_a_key_free_crush_json {
    var o : [800]u8 = undefined;
    var m : [64]u8 = undefined;
    assert agent_var_count(AG_CRUSH, PR_ZAI) == 2 and agent_var_count(AG_CRUSH, PR_OPENROUTER) == 2;
    assert agent_var_count(AG_CRUSH, PR_ANTHROPIC) == 1 and agent_var_count(AG_CRUSH, PR_OLLAMA_CLOUD) == 0;
    var n : usize = agent_var_name(AG_CRUSH, PR_ZAI, 1, m[0..64]);
    assert n == 19 and begins_with(m[0..n], "CRUSH_GLOBAL_CONFIG");
    n = agent_var_text_step(AG_CRUSH, PR_ZAI, 1, 0, "/Users/x", o[0..800]);
    assert n == 27 and begins_with(o[0..n], "/Users/x/.t27os/crush/zai-0");
    n = agent_var_text_step(AG_CRUSH, PR_OPENROUTER, 1, 1, "/Users/x", o[0..800]);
    assert begins_with(o[0..n], "/Users/x/.t27os/crush/openrouter-1");
    assert crush_config_dir("/h", PR_ZAI, MODEL_STEPS, o[0..800]) == 0;
    assert agent_config_file(AG_CRUSH, PR_ZAI) and agent_config_file(AG_CRUSH, PR_OPENROUTER);
    assert agent_config_file(AG_CRUSH, PR_ANTHROPIC) == false and agent_config_file(AG_OPENCODE, PR_ZAI) == false;
    n = crush_config_text(PR_ZAI, 0, o[0..800]);
    assert n > 0 and n < 800;
    assert has_bytes(o[0..n], "\"base_url\":\"https://api.z.ai/api/paas/v4\"");
    assert has_bytes(o[0..n], "\"api_key\":\"$ZAI_API_KEY\"");
    assert has_bytes(o[0..n], "\"large\":{\"provider\":\"t27\",\"model\":\"glm-4.5-flash\"}");
    assert has_bytes(o[0..n], "\"type\":\"openai-compat\"");
    n = crush_config_text(PR_OPENROUTER, 1, o[0..800]);
    assert has_bytes(o[0..n], "\"api_key\":\"$OPENROUTER_API_KEY\"");
    assert has_bytes(o[0..n], "\"small\":{\"provider\":\"t27\",\"model\":\"nvidia/nemotron-3.5-super-vl:free\"}");
    assert crush_config_text(PR_ANTHROPIC, 0, o[0..800]) == 0;
}

test opencode_and_crush_start_without_the_keys_and_configs_of_their_parent {
    assert agent_strips(AG_OPENCODE, "ZAI_API_KEY") and agent_strips(AG_CRUSH, "OPENROUTER_API_KEY");
    assert agent_strips(AG_OPENCODE, "OPENCODE_CONFIG_CONTENT") and agent_strips(AG_CRUSH, "CRUSH_GLOBAL_CONFIG");
    assert agent_strips(AG_CRUSH, "ANTHROPIC_API_KEY") and agent_strips(AG_OPENCODE, "OPENAI_API_KEY");
    assert agent_strips(AG_CRUSH, "PATH") == false and agent_strips(AG_CRUSH, "ZAI_API_KEYS") == false;
    assert agent_strips(AG_CLAUDE, "ANTHROPIC_AUTH_TOKEN") and agent_strips(AG_CLAUDE, "ZAI_API_KEY") == false;
    assert agent_strips(1, "ZAI_API_KEY") == false;
    assert csv_fields(AGENT_STRIPS) == AGENT_STRIP_COUNT;
}

test the_generic_classifier_reads_the_error_rows_of_opencode_and_crush_too {
    // neither agent documents what it prints on 401 or 429; the rows below are the shapes the classifier reads
    assert classify_line("Error: 429 Too Many Requests") == FC_RATE_LIMITED;
    assert classify_line("Error: 401 Unauthorized") == FC_LOGIN_REJECTED;
    assert classify_line("AI_APICallError: Insufficient balance or no resource package (1113)") == FC_NO_BALANCE;
    assert classify_line("Error: provider is overloaded") == FC_OVERLOADED;
    assert classify_line("Reading 429 files") == FC_NONE;
}

test an_agent_that_is_not_installed_says_so_instead_of_stopped {
    // mask: Claude Code (0), OpenCode (3) and Crush (5) installed
    const mask : u32 = 1 + 8 + 32;
    assert agent_installed(mask, 0) and agent_installed(mask, 3) and agent_installed(mask, 5);
    assert agent_installed(mask, 1) == false and agent_installed(mask, 8) == false and agent_installed(mask, AGENT_COUNT) == false;
    assert agent_state(mask, 1, false, 511) == AS_NOT_INSTALLED;
    assert agent_state(mask, 1, true, 511) == AS_NOT_INSTALLED;
    assert agent_state(mask, 6, false, 0) == AS_NOT_INSTALLED;
    assert agent_state(mask, 3, true, 16) == AS_RUNNING;
    assert agent_state(mask, 3, false, 16) == AS_STOPPED;
    // an installed profile agent with no key it can use says so; a z.ai key is enough for OpenCode now
    assert agent_state(mask, 3, false, 0) == AS_NO_KEY;
    assert agent_state(mask, 5, false, 32) == AS_NO_KEY;
    assert agent_state(mask, 5, false, 16) == AS_STOPPED;
    var o : [32]u8 = undefined;
    assert csv_field(AS_WORDS, AS_NOT_INSTALLED, o[0..32]) == 13;
    assert csv_fields(AS_WORDS) == 4;
}

test the_traffic_light_is_green_on_paid_yellow_on_free_and_red_without_balance {
    assert light_of(CT_PAID, false, 2) == L_GREEN;
    assert light_of(CT_ZAI_FREE, false, 3) == L_YELLOW;
    assert light_of(CT_OR_FREE, false, 1) == L_YELLOW;
    // the chain gave up, or no key can serve: red on every tier
    assert light_of(CT_PAID, true, 2) == L_RED;
    assert light_of(CT_ZAI_FREE, true, 7) == L_RED;
    assert light_of(CT_OR_FREE, false, 0) == L_RED;
    assert light_of(CT_PAID, false, 0) == L_RED;
    // no profile (an editor, a shell): no light
    assert light_of(CT_NO_TIER, false, 5) == L_NONE;
    assert light_of(CT_NO_TIER, true, 0) == L_NONE;
    assert light_of(CT_COUNT, false, 1) == L_NONE;
    // the profile tiers feed it
    assert PROFILE_TIER[PR_ZAI] == CT_ZAI_FREE and PROFILE_TIER[PR_OPENROUTER] == CT_OR_FREE and PROFILE_TIER[PR_ANTHROPIC] == CT_PAID;
    var o : [16]u8 = undefined;
    assert light_name(L_NONE, o[0..16]) == 4 and light_name(L_GREEN, o[0..16]) == 5;
    assert light_name(L_YELLOW, o[0..16]) == 6 and light_name(L_RED, o[0..16]) == 3;
    assert begins_with(o[0..3], "red");
}

test the_worst_light_over_the_running_panes_is_red_then_yellow_then_green {
    var l : [6]u32 = [L_GREEN, L_YELLOW, L_RED, L_NONE, L_GREEN, L_YELLOW];
    assert worst_light(l[0..6], 63) == L_RED;
    // a pane that does not run does not count
    assert worst_light(l[0..6], 63 - 4) == L_YELLOW;
    assert worst_light(l[0..6], 1 + 16) == L_GREEN;
    assert worst_light(l[0..6], 8) == L_NONE;
    assert worst_light(l[0..6], 0) == L_NONE;
    assert worst_light(l[0..0], 63) == L_NONE;
    assert L_RED > L_YELLOW and L_YELLOW > L_GREEN and L_GREEN > L_NONE;
}

test the_tooltip_pieces_name_the_model_and_the_reason {
    var o : [96]u8 = undefined;
    var n : usize = light_tip(L_YELLOW, "glm-4.5-flash", o[0..96]);
    assert n == 19 and begins_with(o[0..n], "free: glm-4.5-flash");
    n = light_tip(L_GREEN, "claude-sonnet-5-5", o[0..96]);
    assert begins_with(o[0..n], "paid: claude-sonnet-5-5");
    n = light_tip(L_RED, "glm-4.5-flash", o[0..96]);
    assert n == 25 and begins_with(o[0..n], "no balance: all keys rest");
    assert light_tip(L_NONE, "x", o[0..96]) == 0;
}

test the_light_travels_in_the_top_bits_of_the_listing_state_byte {
    assert shown_with_light(5, L_RED) == 5 + 192;
    assert shown_state_of(shown_with_light(5, L_RED)) == 5 and shown_light_of(shown_with_light(5, L_RED)) == L_RED;
    assert shown_light_of(shown_with_light(63, L_YELLOW)) == L_YELLOW and shown_state_of(shown_with_light(63, L_YELLOW)) == 63;
    // an old server sends the state alone: no light
    assert shown_light_of(5) == L_NONE and shown_state_of(5) == 5;
    assert shown_with_light(5, L_NONE) == 5;
}

