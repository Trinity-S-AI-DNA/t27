// SPDX-License-Identifier: Apache-2.0
; specs/t27os/keys.t27 -- the one key manager of T27 OS: which providers hold a key, which environment
; variable each agent reads, how a key is shown, what a probe answer does to a provider's status, which of
; several keys goes next, and what a freshly spawned pane gets in its environment.
; Owner, 2026-10-19: a KEYS tab modelled on trios, every key managed by one manager written in .t27.
; Mirrors the trios SR-00 decisions (not the Swift): ModelProvider, ModelKeyRotation (least recently used
; plus cooldown), ProviderCircuitBreaker, ProviderStatusService, KeychainSecrets.
; Storage is the macOS Keychain, service "ai.t27.os", one item per key (account = provider name for key 1,
; "<name>#2" .. "<name>#8" for the others, keychain_account_n).
; Never a plain file and never the repo. The Keychain is reached only by running /usr/bin/security (the
; section "the Keychain through /usr/bin/security" at the end), never through SecItem calls. This spec holds
; no key and no syscall: the Keychain, the probe and the child environment are host calls (keys_host.t27,
; pty_server.t27); only the decisions live here, so they run their tests (a module with @extern imports
; cannot). Every test uses fake values.
; Refs gHashTag/t27#10782.
; ---- MAP: the app.t27.ai account and its keys (read 2026-10-19, read-only; M12 follow-up) -----------------
; R = 999-multibots-telegraf apps/vibee-editor/render; Q = BrowserOS trios/agent-server/apps/server/src/api
; (queen-contributor-keys.ts lives at git commit 2b25f0bcf, not in the BrowserOS working tree).
; IDENTITY (EXISTS). A person signs in with a Telegram Mini App initData (R/auth.ts:509-591) or the Telegram
;   Login Widget (R/session-routes.ts:909). The server mints an HS256 session JWT, 600 s, claims sub=telegram
;   id, sid, jti (R/session.ts:137-170), sent as `Authorization: Bearer`. The long-lived refresh token is the
;   cookie __Host-t27_refresh (HttpOnly, Secure, SameSite=Strict; R/src/auth/refresh-cookie.ts:72) renewed by
;   POST /api/auth/refresh (R/session-routes.ts:1306). The key owner is `telegram:<id>`
;   (R/src/hive/contributor-keys-route.ts:31-45).
; KEYS (EXISTS, metadata only). Table queen_contributor_keys in the Queen's PostgreSQL, AES-256-GCM sealed
;   (Q/services/queen-contributor-keys.ts:185-259). Browser door GET/POST /api/hive/keys[...] ->
;   R/render-server.ts:9154 -> Queen with a shared server-to-server token. A key object is {id, provider
;   (nvidia|zai), label, fingerprint, model, enabled, createdAt, lastProbe{status, checkedAt, latencyMs},
;   contribution}. The secret is accepted on POST add and never returned.
; PROXY (MISSING). No route lets a client spend a stored key: no Anthropic-compatible /v1/messages, no
;   chat-completions proxy on a per-user key, no per-user delegated token. The keys are used only by the
;   Queen's own bees (Q queen-tick.ts:46, queen-dispatch.ts:36). So a pane cannot use server-side keys without
;   a copy on this Mac until that route exists (filed as an issue against 999-multibots-telegraf).
; NOT BUILT HERE: the KEYS tab listing the signed-in user's server keys needs a session token on this Mac;
;   the Mac app has no sign-in yet (refresh cookie lives on the auth.t27.ai host).
module T27osKeys;

use t27os::agents::AGENT_COUNT;
use t27os::editors::same_bytes;
use t27os::session_store::csv_field;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

/// Keychain service every item is stored under.
pub const KEYCHAIN_SERVICE : str = "ai.t27.os";

pub const PROVIDER_COUNT : u32 = 10;
pub const P_ANTHROPIC : u32 = 0;
pub const P_OPENAI : u32 = 1;
pub const P_GEMINI : u32 = 2;
pub const P_OPENROUTER : u32 = 3;
pub const P_ZAI : u32 = 4;
pub const P_OLLAMA : u32 = 5;
pub const P_GITHUB : u32 = 6;
pub const P_CURSOR : u32 = 7;
pub const P_GONKA : u32 = 8;
pub const P_NVIDIA : u32 = 9;

/// Provider names in cell order; also the Keychain account of each.
pub const PROVIDER_NAMES : str = "anthropic,openai,gemini,openrouter,zai,ollama,github,cursor,gonka,nvidia";
/// The environment variable the agent CLIs read the provider's key from.
pub const PROVIDER_ENVS : str = "ANTHROPIC_API_KEY,OPENAI_API_KEY,GEMINI_API_KEY,OPENROUTER_API_KEY,ZAI_API_KEY,OLLAMA_API_KEY,GITHUB_TOKEN,CURSOR_API_KEY,GONKA_API_KEY,NVIDIA_API_KEY";

pub const MAX_KEY_CHARS : u32 = 254;

/// Provider status, trios ProviderStatusService.
pub const ST_MISSING : u32 = 0;
pub const ST_STORED : u32 = 1;
pub const ST_VALID : u32 = 2;
pub const ST_INVALID : u32 = 3;
pub const ST_RATE_LIMITED : u32 = 4;
pub const ST_CIRCUIT_OPEN : u32 = 5;
pub const STATUS_NAMES : str = "missing,stored,valid,invalid,rate-limited,circuit-open";

/// Circuit breaker: this many failed probes in a row open the circuit, for CIRCUIT_COOLDOWN_S seconds.
pub const CIRCUIT_FAILS : u32 = 3;
pub const CIRCUIT_COOLDOWN_S : u64 = 60;
/// A key that answered 429 rests this long before rotation picks it again.
pub const RATE_COOLDOWN_S : u64 = 30;

/// Per agent cell (agents.t27 order: Claude, Codex, Gemini, OpenCode, Queen, Crush, Cursor, Aider, Copilot):
/// a bitmask over providers, bit p set when the agent reads provider p's key.
pub const AGENT_PROVIDERS : [10]u32 = [1, 2, 4, 11, 1, 63, 128, 15, 64, 0];

/// Does agent a read provider p's key?
pub fn agent_uses(a: u32, p: u32) -> bool {
    if (a >= AGENT_COUNT) { return false; }
    if (p >= PROVIDER_COUNT) { return false; }
    return (AGENT_PROVIDERS[a] >> p) % 2 == 1;
}

/// Copy the environment variable name of provider p into out; returns its length (0 when p is unknown).
pub fn provider_env(p: u32, out: []u8) -> usize {
    return csv_field(PROVIDER_ENVS, p, out);
}

/// Copy the name of provider p into out; returns its length.
pub fn provider_name(p: u32, out: []u8) -> usize {
    return csv_field(PROVIDER_NAMES, p, out);
}

/// A key is fit to store when it is non-empty, within MAX_KEY_CHARS and holds only printable ASCII
/// without a space (a pasted newline or a space is a paste mistake, not a key).
pub fn key_fits(key: []const u8) -> bool {
    if (key.len == 0) { return false; }
    if (key.len > MAX_KEY_CHARS) { return false; }
    var i : usize = 0;
    while (i < key.len) {
        if (key[i] <= 32) { return false; }
        if (key[i] >= 127) { return false; }
        i = i + 1;
    }
    return true;
}

/// How a key is shown: stars, then the last four characters when the key is at least 12 long (a shorter
/// key shows stars only, so at most a third of a key ever reaches the screen). Returns the length.
pub fn mask_key(key: []const u8, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "********");
    if (key.len >= 12) {
        n = put_bytes(out, n, key[key.len - 4 .. key.len]);
    }
    return n;
}

/// The status after a probe answered with HTTP status code http (0 = no answer: network down or timeout).
/// `prev` is the status before. A 5xx or no answer does not condemn the key: it keeps `prev` (the failure
/// feeds the circuit breaker, circuit_fails).
pub fn status_after_probe(prev: u32, http: u32) -> u32 {
    if (http >= 200 and http < 300) { return ST_VALID; }
    if (http == 401 or http == 403) { return ST_INVALID; }
    if (http == 429) { return ST_RATE_LIMITED; }
    if (prev == ST_MISSING) { return ST_MISSING; }
    return prev;
}

/// A probe that proves nothing about the key (no answer, 5xx) counts as a transport failure.
pub fn is_transport_failure(http: u32) -> bool {
    return http == 0 or http >= 500;
}

/// Consecutive transport failures after one more probe: reset by any answer that came from the provider.
pub fn circuit_fails(fails: u32, http: u32) -> u32 {
    if (is_transport_failure(http)) { return fails + 1; }
    return 0;
}

/// Is the circuit open at `now`? `opened` is when it opened (seconds), fails the failures in a row.
pub fn circuit_open(fails: u32, opened: u64, now: u64) -> bool {
    if (fails < CIRCUIT_FAILS) { return false; }
    return now < opened + CIRCUIT_COOLDOWN_S;
}

/// The status to show: a stored key whose circuit is open reads circuit-open; a missing key is missing.
pub fn status_shown(has_key: bool, status: u32, fails: u32, opened: u64, now: u64) -> u32 {
    if (has_key == false) { return ST_MISSING; }
    if (circuit_open(fails, opened, now)) { return ST_CIRCUIT_OPEN; }
    if (status == ST_MISSING) { return ST_STORED; }
    return status;
}

/// Rotation among n keys of one provider (trios ModelKeyRotation): the usable key used longest ago wins.
/// A key is usable when it is not cooling down (`rest_until[k] <= now`) and is not key `skip` (the one that
/// just failed; pass n to skip none). Returns n when none is usable.
pub fn rotate_pick_except(n: u32, skip: u32, last_used: []const u64, rest_until: []const u64, now: u64) -> u32 {
    var best : u32 = n;
    var k : u32 = 0;
    while (k < n) {
        if (rest_until[k] <= now and k != skip) {
            if (best == n) {
                best = k;
            } else if (last_used[k] < last_used[best]) {
                best = k;
            }
        }
        k = k + 1;
    }
    return best;
}

/// Rotation with no key skipped.
pub fn rotate_pick(n: u32, last_used: []const u64, rest_until: []const u64, now: u64) -> u32 {
    return rotate_pick_except(n, n, last_used, rest_until, now);
}

/// Names a child process must not inherit: the Claude Code session markers of whatever started the server.
/// They make the pane believe it is a child session ("Transcript saving is off") and cut its login.
pub fn env_stripped(name: []const u8) -> bool {
    if (name.len == 10) {
        if (name[0] == 67 and name[1] == 76 and name[2] == 65 and name[3] == 85 and name[4] == 68 and name[5] == 69) {
            if (name[6] == 67 and name[7] == 79 and name[8] == 68 and name[9] == 69) { return true; }
        }
    }
    if (name.len < 12) { return false; }
    var i : usize = 0;
    const pre : str = "CLAUDE_CODE_";
    while (i < 12) {
        if (name[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The providers whose keys a pane of agent a is given: the bitmask, narrowed to those stored.
pub fn spawn_mask(a: u32, stored: u32) -> u32 {
    if (a >= AGENT_COUNT) { return 0; }
    var m : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (agent_uses(a, p) and (stored >> p) % 2 == 1) { m = m + (1 << p); }
        p = p + 1;
    }
    return m;
}

/// The Keychain account of provider p (its name) plus the service: "ai.t27.os/anthropic". Returns length.
pub fn keychain_label(p: u32, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, KEYCHAIN_SERVICE);
    n = put_bytes(out, n, "/");
    var tmp : [24]u8 = undefined;
    const l : usize = csv_field(PROVIDER_NAMES, p, tmp[0..24]);
    n = put_bytes(out, n, tmp[0..l]);
    return n;
}

test every_agent_reads_its_own_key {
    assert agent_uses(0, P_ANTHROPIC);
    assert agent_uses(0, P_OPENAI) == false;
    assert agent_uses(1, P_OPENAI);
    assert agent_uses(2, P_GEMINI);
    assert agent_uses(4, P_ANTHROPIC);
    assert agent_uses(6, P_CURSOR);
    assert agent_uses(8, P_GITHUB);
    assert agent_uses(9, P_ANTHROPIC) == false;
    assert agent_uses(0, 9) == false;
}

test multi_provider_agents_get_every_provider_they_read {
    assert agent_uses(3, P_ANTHROPIC) and agent_uses(3, P_OPENAI) and agent_uses(3, P_OPENROUTER);
    assert agent_uses(3, P_ZAI) == false;
    assert agent_uses(5, P_ZAI) and agent_uses(5, P_OLLAMA) and agent_uses(5, P_GEMINI);
    assert agent_uses(7, P_ANTHROPIC) and agent_uses(7, P_GEMINI) and agent_uses(7, P_OPENROUTER);
}

test provider_tables_line_up {
    var out : [40]u8 = undefined;
    assert provider_name(P_ANTHROPIC, out[0..40]) == 9;
    assert provider_name(P_GONKA, out[0..40]) == 5;
    assert provider_name(9, out[0..40]) == 6;
    assert provider_name(10, out[0..40]) == 0;
    assert provider_env(P_ANTHROPIC, out[0..40]) == 17;
    assert out[0] == 65 and out[16] == 89;
    assert provider_env(P_GITHUB, out[0..40]) == 12;
    assert provider_env(P_GONKA, out[0..40]) == 13;
    assert provider_env(9, out[0..40]) == 14; // NVIDIA_API_KEY
    assert provider_env(10, out[0..40]) == 0;
}

test a_key_is_masked_to_four_characters_at_most {
    var out : [32]u8 = undefined;
    const n : usize = mask_key("sk-test-0000-abcd", out[0..32]);
    assert n == 12;
    assert out[0] == 42 and out[7] == 42;
    assert out[8] == 97 and out[11] == 100;
    const s : usize = mask_key("sk-test-00", out[0..32]);
    assert s == 8;
    assert out[7] == 42;
    const e : usize = mask_key("", out[0..32]);
    assert e == 8;
}

test a_pasted_key_must_be_one_clean_token {
    assert key_fits("sk-test-0000");
    assert key_fits("") == false;
    assert key_fits("sk test") == false;
    assert key_fits("sk-test\n") == false;
    assert key_fits("sk\ttest") == false;
}

test a_probe_answer_sets_the_status {
    assert status_after_probe(ST_STORED, 200) == ST_VALID;
    assert status_after_probe(ST_STORED, 401) == ST_INVALID;
    assert status_after_probe(ST_VALID, 403) == ST_INVALID;
    assert status_after_probe(ST_VALID, 429) == ST_RATE_LIMITED;
    assert status_after_probe(ST_RATE_LIMITED, 200) == ST_VALID;
    assert status_after_probe(ST_VALID, 503) == ST_VALID;
    assert status_after_probe(ST_STORED, 0) == ST_STORED;
    assert status_after_probe(ST_MISSING, 0) == ST_MISSING;
}

test three_failures_open_the_circuit_for_a_minute {
    var f : u32 = 0;
    f = circuit_fails(f, 0);
    f = circuit_fails(f, 503);
    assert circuit_open(f, 100, 101) == false;
    f = circuit_fails(f, 0);
    assert f == 3;
    assert circuit_open(f, 100, 101);
    assert circuit_open(f, 100, 159);
    assert circuit_open(f, 100, 160) == false;
    assert circuit_fails(f, 200) == 0;
    assert circuit_fails(f, 401) == 0;
}

test the_shown_status_follows_the_key_and_the_circuit {
    assert status_shown(false, ST_VALID, 0, 0, 0) == ST_MISSING;
    assert status_shown(true, ST_MISSING, 0, 0, 0) == ST_STORED;
    assert status_shown(true, ST_VALID, 0, 0, 0) == ST_VALID;
    assert status_shown(true, ST_VALID, 3, 100, 120) == ST_CIRCUIT_OPEN;
    assert status_shown(true, ST_VALID, 3, 100, 200) == ST_VALID;
}

test rotation_takes_the_key_used_longest_ago {
    var used : [3]u64 = [50, 10, 30];
    var rest : [3]u64 = [0, 0, 0];
    assert rotate_pick(3, used[0..3], rest[0..3], 100) == 1;
    rest[1] = 200;
    assert rotate_pick(3, used[0..3], rest[0..3], 100) == 2;
    rest[2] = 200;
    rest[0] = 200;
    assert rotate_pick(3, used[0..3], rest[0..3], 100) == 3;
    assert rotate_pick(3, used[0..3], rest[0..3], 200) == 1;
    assert rotate_pick(0, used[0..3], rest[0..3], 200) == 0;
}

test the_claude_code_markers_are_stripped_from_a_pane {
    assert env_stripped("CLAUDECODE");
    assert env_stripped("CLAUDE_CODE_CHILD_SESSION");
    assert env_stripped("CLAUDE_CODE_ENTRYPOINT");
    assert env_stripped("CLAUDE_CODE_");
    assert env_stripped("ANTHROPIC_API_KEY") == false;
    assert env_stripped("CLAUDE_CONFIG_DIR") == false;
    assert env_stripped("CLAUDE") == false;
    assert env_stripped("CLAUDECODEX") == false;
    assert env_stripped("HOME") == false;
}

test a_pane_gets_only_the_stored_keys_its_agent_reads {
    const all : u32 = 511;
    assert spawn_mask(0, all) == 1;
    assert spawn_mask(0, 2) == 0;
    assert spawn_mask(3, all) == 11;
    assert spawn_mask(3, 8) == 8;
    assert spawn_mask(8, 64) == 64;
    assert spawn_mask(8, 1) == 0;
    assert spawn_mask(9, all) == 0;
}

test the_keychain_item_is_named_by_service_and_provider {
    var out : [48]u8 = undefined;
    const n : usize = keychain_label(P_OPENAI, out[0..48]);
    assert n == 16;
    assert out[0] == 97 and out[9] == 47 and out[10] == 111;
}

test a_key_longer_than_the_server_slot_is_refused {
    var long : [300]u8 = undefined;
    var i : usize = 0;
    while (i < 300) { long[i] = 97; i = i + 1; }
    assert key_fits(long[0..254]);
    assert key_fits(long[0..255]) == false;
}

// ---- the check button: the cheapest authenticated request each provider answers ----
// A GET of the provider's model list (or whoami) with the key in a header -- never in the URL. The answer's
// HTTP status is all that is read (status_after_probe). cursor and gonka have no such public endpoint: their
// check stays "stored".
pub const PROBE_URLS : str = "https://api.anthropic.com/v1/models,https://api.openai.com/v1/models,https://generativelanguage.googleapis.com/v1beta/models,https://openrouter.ai/api/v1/auth/key,https://api.z.ai/api/anthropic/v1/messages,https://ollama.com/api/tags,https://api.github.com/user,,,https://integrate.api.nvidia.com/v1/models";
pub const AUTH_NONE : u32 = 0;
pub const AUTH_BEARER : u32 = 1;
pub const AUTH_X_API_KEY : u32 = 2;
pub const AUTH_X_GOOG : u32 = 3;
pub const PROBE_AUTH : [10]u32 = [2, 1, 3, 1, 2, 1, 1, 0, 0, 1];
pub const PROBE_TIMEOUT_S : u32 = 6;

pub fn probe_url(p: u32, out: []u8) -> usize {
    return csv_field(PROBE_URLS, p, out);
}

pub fn probe_has(p: u32) -> bool {
    if (p >= PROVIDER_COUNT) { return false; }
    return PROBE_AUTH[p] != AUTH_NONE;
}

/// The header that carries the key, and its value (the key itself, or "Bearer " + key).
pub fn probe_header_name(p: u32, out: []u8) -> usize {
    if (p >= PROVIDER_COUNT) { return 0; }
    const a : u32 = PROBE_AUTH[p];
    if (a == AUTH_BEARER) { return put_bytes(out, 0, "Authorization"); }
    if (a == AUTH_X_API_KEY) { return put_bytes(out, 0, "x-api-key"); }
    if (a == AUTH_X_GOOG) { return put_bytes(out, 0, "x-goog-api-key"); }
    return 0;
}

pub fn probe_header_value(p: u32, key: []const u8, out: []u8) -> usize {
    if (p >= PROVIDER_COUNT) { return 0; }
    var n : usize = 0;
    if (PROBE_AUTH[p] == AUTH_BEARER) { n = put_bytes(out, 0, "Bearer "); }
    return put_bytes(out, n, key);
}

test every_probe_has_a_url_and_a_header {
    var u : [160]u8 = undefined;
    var h : [40]u8 = undefined;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (probe_has(p)) {
            assert probe_url(p, u[0..160]) > 20;
            assert u[0] == 104 and u[4] == 115;
            assert probe_header_name(p, h[0..40]) > 0;
        } else {
            assert probe_url(p, u[0..160]) == 0;
        }
        p = p + 1;
    }
    assert probe_has(P_CURSOR) == false;
    assert probe_has(P_GONKA) == false;
    assert probe_has(P_NVIDIA);
    assert probe_has(10) == false;
}

test the_key_travels_in_a_header_never_in_the_url {
    var u : [160]u8 = undefined;
    var v : [64]u8 = undefined;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        if (probe_has(p)) {
            const n : usize = probe_url(p, u[0..160]);
            var i : usize = 0;
            while (i < n) {
                assert u[i] != 63 and u[i] != 61;
                i = i + 1;
            }
        }
        p = p + 1;
    }
    assert probe_header_value(P_OPENAI, "sk-test-0000", v[0..64]) == 19;
    assert v[0] == 66 and v[7] == 115;
    assert probe_header_value(P_ANTHROPIC, "sk-test-0000", v[0..64]) == 12;
    assert v[0] == 115;
}

// ---- the KEYS panel: layout, hit tests and what a click or a key means ----------------------------------
// The window (glass_window.t27) only draws and forwards; every decision is a tested fn here.

pub const KY_ROWS_Y : f64 = 56.0;
pub const KY_ROW_H : f64 = 44.0;
pub const KY_BTN_W : f64 = 56.0;
pub const KY_BTN_H : f64 = 18.0;
pub const KY_BTN_DY : f64 = 20.0;
pub const KY_BTN_GAP : f64 = 6.0;
pub const KY_LINK_W : f64 = 44.0;
pub const KY_NONE : u32 = 255;

/// A key's sub-row (a row opens and lists its keys one each): its height, its three smaller buttons and
/// the gap under the last one. A sub-row hit carries KY_SUB above the row hits, as KY_SUB + p*32 + k*4 + b.
pub const KY_SUB_H : f64 = 20.0;
pub const KY_SUB_BTN_W : f64 = 38.0;
pub const KY_SUB_BTN_H : f64 = 15.0;
pub const KY_SUB_GAP : f64 = 6.0;
pub const KY_SUB : u32 = 4096;
/// An open row also carries the add row and the details line below its keys (both KY_SUB_H bands tall).
pub const KY_SUB_EXTRA : f64 = 36.0;

pub const B_SET : u32 = 0;
pub const B_DELETE : u32 = 1;
pub const B_CHECK : u32 = 2;

pub const KA_NONE : u32 = 0;
pub const KA_EDIT : u32 = 1;
pub const KA_ARM : u32 = 2;
pub const KA_DELETE : u32 = 3;
pub const KA_CHECK : u32 = 4;

pub const KE_NONE : u32 = 0;
pub const KE_SAVE : u32 = 1;
pub const KE_CANCEL : u32 = 2;
pub const KE_BACK : u32 = 3;
pub const KE_PASTE : u32 = 4;
pub const KE_CHAR : u32 = 5;

pub const KEY_RETURN : u32 = 36;
pub const KEY_BACKSPACE : u32 = 51;
pub const KEY_ESC : u32 = 53;
pub const KEY_V : u32 = 9;

pub const KEYS_WORDS : str = "KEYS,add,full,delete,confirm,check,checking,no key,paste or type a key,enter saves  esc cancels,open in,next #,withheld,replace";

/// Top edge of provider row r in a panel whose top is t.
pub fn ky_row_top(t: f64, r: u32) -> f64 {
    return t + KY_ROWS_Y + @as(f64, @floatFromInt(r)) * KY_ROW_H;
}

/// Left edge of button b (SET, DELETE, CHECK): the three sit together at the right end of the row.
pub fn ky_btn_x(l: f64, w: f64, pad: f64, b: u32) -> f64 {
    return l + w - pad - 3.0 * KY_BTN_W - 2.0 * KY_BTN_GAP + @as(f64, @floatFromInt(b)) * (KY_BTN_W + KY_BTN_GAP);
}

/// The height of provider row r: the closed band, or the band plus one sub-row per stored key, the add row,
/// the details line and the gap.
pub fn ky_row_h(n_keys: u32, expanded: bool) -> f64 {
    if (expanded == false) { return KY_ROW_H; }
    return KY_ROW_H + @as(f64, @floatFromInt(n_keys)) * KY_SUB_H + KY_SUB_EXTRA + KY_SUB_GAP;
}

/// The top of provider row r with expansion `ex` (bit r set = its keys are shown); `stored[r]` is the row's
/// key mask. Every closed row is KY_ROW_H tall, so with ex = 0 this is the old even ladder (ky_row_top).
pub fn ky_top_of(t: f64, stored: []const u32, ex: u32, r: u32) -> f64 {
    var y : f64 = t + KY_ROWS_Y;
    var i : u32 = 0;
    while (i < r and i < stored.len) {
        y = y + ky_row_h(slot_count(stored[i]), (ex >> i) & 1 == 1);
        i = i + 1;
    }
    return y;
}

/// The y where the rows end: what the foot and the sections below the rows are laid out from.
pub fn ky_rows_bottom(t: f64, stored: []const u32, ex: u32) -> f64 {
    return ky_top_of(t, stored, ex, @as(u32, @intCast(stored.len)));
}

/// Which provider's row a y falls in; KY_NONE when it falls between or after the rows.
pub fn ky_row_at(y: f64, t: f64, stored: []const u32, ex: u32) -> u32 {
    var r : u32 = 0;
    while (r < stored.len) {
        const top : f64 = ky_top_of(t, stored, ex, r);
        if (y >= top and y < top + ky_row_h(slot_count(stored[r]), (ex >> r) & 1 == 1)) { return r; }
        r = r + 1;
    }
    return KY_NONE;
}

/// The y of sub-row i (i counts the row's stored keys from 0) of the expanded row r.
pub fn ky_sub_top(t: f64, stored: []const u32, ex: u32, r: u32, i: u32) -> f64 {
    return ky_top_of(t, stored, ex, r) + KY_ROW_H + @as(f64, @floatFromInt(i)) * KY_SUB_H;
}

/// Left edge of a sub-row's button b: three smaller buttons at the right end, under the row's own.
pub fn kys_btn_x(l: f64, w: f64, pad: f64, b: u32) -> f64 {
    return l + w - pad - 3.0 * KY_SUB_BTN_W - 2.0 * KY_BTN_GAP + @as(f64, @floatFromInt(b)) * (KY_SUB_BTN_W + KY_BTN_GAP);
}

/// Which sub-row button of which key a click lands on, as KY_SUB + p*32 + k*4 + b; KY_NONE when on none.
pub fn kys_hit(x: f64, y: f64, l: f64, w: f64, pad: f64, t: f64, stored: []const u32, ex: u32) -> u32 {
    const r : u32 = ky_row_at(y, t, stored, ex);
    if (r == KY_NONE or (ex >> r) & 1 == 0) { return KY_NONE; }
    var k : u32 = 0;
    var i : u32 = 0;
    while (k < MAX_KEYS) {
        if (slot_taken(stored[r], k)) {
            const sy : f64 = ky_sub_top(t, stored, ex, r, i);
            if (y >= sy and y <= sy + KY_SUB_BTN_H) {
                var b : u32 = 0;
                while (b < 3) {
                    const bx : f64 = kys_btn_x(l, w, pad, b);
                    if (x >= bx and x <= bx + KY_SUB_BTN_W) { return KY_SUB + r * 32 + k * 4 + b; }
                    b = b + 1;
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return KY_NONE;
}

/// The provider, the key and the button a sub-row hit names.
pub fn ky_sub_p(h: u32) -> u32 { return (h - KY_SUB) / 32; }
pub fn ky_sub_k(h: u32) -> u32 { return ((h - KY_SUB) % 32) / 4; }
pub fn ky_sub_b(h: u32) -> u32 { return (h - KY_SUB) % 4; }

/// Which button of which row a click lands on, as row * 4 + button; KY_NONE when it lands on none.
/// The rows' tops follow the expansion (`ex`, bit r set = row r's keys are shown; `stored[r]` is the row's
/// key mask), so a click is placed by the same spans the drawing uses.
pub fn ky_hit(x: f64, y: f64, l: f64, w: f64, pad: f64, t: f64, stored: []const u32, ex: u32) -> u32 {
    const r : u32 = ky_row_at(y, t, stored, ex);
    if (r == KY_NONE) { return KY_NONE; }
    const by : f64 = ky_top_of(t, stored, ex, r) + KY_BTN_DY;
    if (y >= by and y <= by + KY_BTN_H) {
        var b : u32 = 0;
        while (b < 3) {
            const bx : f64 = ky_btn_x(l, w, pad, b);
            if (x >= bx and x <= bx + KY_BTN_W) { return r * 4 + b; }
            b = b + 1;
        }
    }
    return KY_NONE;
}

/// The KEYS link in the sidebar foot, left of the DOCTOR link (which ends 14 from the right edge).
pub fn on_keys_link(x: f64, y: f64, side_w: f64, sh: f64, foot_h: f64, doc_w: f64) -> bool {
    const right : f64 = side_w - 14.0 - doc_w - 6.0;
    return x >= right - KY_LINK_W and x <= right and y >= sh - foot_h and y <= sh - 6.0;
}

/// What a click on button b of a row means. `stored`: the row has a key; `full`: it holds MAX_KEYS keys, so
/// "add" has no number left; `probed`: its provider has a check; `armed`: the row whose DELETE was clicked
/// once (KY_NONE when none); `row`: the clicked row.
pub fn ky_click(b: u32, stored: bool, full: bool, probed: bool, armed: u32, row: u32) -> u32 {
    if (b == B_SET) {
        if (full) { return KA_NONE; }
        return KA_EDIT;
    }
    if (stored == false) { return KA_NONE; }
    if (b == B_DELETE) {
        if (armed == row) { return KA_DELETE; }
        return KA_ARM;
    }
    if (b == B_CHECK and probed) { return KA_CHECK; }
    return KA_NONE;
}

/// What a click on a key's sub-row button means: the slot's own edit (it replaces that key), a delete that
/// asks twice (`armedk` holds p * MAX_KEYS + k of the armed sub-row, KY_NONE when none) and a check of that
/// one key only.
pub fn kys_click(b: u32, probed: bool, armedk: u32, p: u32, k: u32) -> u32 {
    const me : u32 = p * MAX_KEYS + k;
    if (b == B_SET) { return KA_EDIT; }
    if (b == B_DELETE) {
        if (armedk == me) { return KA_DELETE; }
        return KA_ARM;
    }
    if (b == B_CHECK and probed) { return KA_CHECK; }
    return KA_NONE;
}

/// A click on a row's label (not a button) opens that row's keys and closes the row that was open: the panel
/// stays short. Clicking the open row's label closes it.
pub fn expand_toggle(ex: u32, r: u32) -> u32 {
    if (r >= PROVIDER_COUNT) { return ex; }
    const bit : u32 = 1 << r;
    if (ex & bit == bit) { return ex ^ bit; }
    return bit;
}

/// What a key press means while a key is being typed. `code` is the macOS key code, `cmd` the Command bit.
pub fn ky_key(code: u32, cmd: bool) -> u32 {
    if (cmd) {
        if (code == KEY_V) { return KE_PASTE; }
        return KE_NONE;
    }
    if (code == KEY_RETURN) { return KE_SAVE; }
    if (code == KEY_ESC) { return KE_CANCEL; }
    if (code == KEY_BACKSPACE) { return KE_BACK; }
    return KE_CHAR;
}

/// A typed character is taken when it is printable ASCII without a space, a quote or a backslash (the three
/// that `security -i` reads as syntax, sec_word_ok) and the buffer has room.
pub fn ky_accepts(len: u32, ch: u32) -> bool {
    if (len >= MAX_KEY_CHARS) { return false; }
    if (ch == 34 or ch == 39 or ch == 92) { return false; }
    return ch > 32 and ch < 127;
}

/// A pasted text with its surrounding white space and control characters cut off; the length written.
pub fn trim_key(src: []const u8, out: []u8) -> usize {
    var a : usize = 0;
    var b : usize = src.len;
    while (a < b and src[a] <= 32) { a = a + 1; }
    while (b > a and src[b - 1] <= 32) { b = b - 1; }
    var n : usize = 0;
    while (a + n < b and n < out.len) {
        out[n] = src[a + n];
        n = n + 1;
    }
    return n;
}

test a_click_finds_its_row_and_button {
    var st : [12]u32 = undefined;
    var i : u32 = 0;
    while (i < 12) { st[i] = 0; i = i + 1; }
    const y : f64 = ky_row_top(35.0, 2) + KY_BTN_DY + 4.0;
    assert ky_hit(ky_btn_x(660.0, 300.0, 16.0, 0) + 3.0, y, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == 2 * 4 + B_SET;
    assert ky_hit(ky_btn_x(660.0, 300.0, 16.0, 1) + 5.0, y, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == 2 * 4 + B_DELETE;
    assert ky_hit(ky_btn_x(660.0, 300.0, 16.0, 2) + 5.0, y, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == 2 * 4 + B_CHECK;
    assert ky_hit(665.0, y, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == KY_NONE;
    assert ky_hit(900.0, 35.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == KY_NONE;
}

test the_spans_follow_the_expansion {
    var st : [12]u32 = undefined;
    var i : u32 = 0;
    while (i < 12) { st[i] = 0; i = i + 1; }
    st[0] = 7;
    // closed: the old even ladder
    assert ky_top_of(35.0, st[0..12], 0, 2) == ky_row_top(35.0, 2);
    assert ky_rows_bottom(35.0, st[0..12], 0) == ky_row_top(35.0, 12);
    // row 0 open with 3 keys: the next row shifts by the band plus three sub-rows, the add row and the
    // details line, and the gap
    const top1 : f64 = ky_top_of(35.0, st[0..12], 1, 1);
    assert top1 == 35.0 + KY_ROWS_Y + KY_ROW_H + 3.0 * KY_SUB_H + KY_SUB_EXTRA + KY_SUB_GAP;
    assert ky_row_at(top1 + 1.0, 35.0, st[0..12], 1) == 1;
    assert ky_row_at(35.0 + KY_ROWS_Y + 1.0, 35.0, st[0..12], 1) == 0;
    assert ky_row_at(10.0, 35.0, st[0..12], 1) == KY_NONE;
}

test a_row_opens_and_closes_one_at_a_time {
    assert expand_toggle(0, 4) == 16;
    assert expand_toggle(16, 4) == 0;
    assert expand_toggle(16, 2) == 4;
    assert expand_toggle(0, PROVIDER_COUNT) == 0;
}

test a_subrow_click_names_its_slot_and_button {
    var st : [12]u32 = undefined;
    var i : u32 = 0;
    while (i < 12) { st[i] = 0; i = i + 1; }
    st[1] = 5;
    const sy : f64 = ky_sub_top(35.0, st[0..12], 2, 1, 1);
    const h : u32 = kys_hit(kys_btn_x(660.0, 300.0, 16.0, 0) + 2.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 2);
    assert h == KY_SUB + 1 * 32 + 2 * 4 + B_SET;
    assert ky_sub_p(h) == 1;
    assert ky_sub_k(h) == 2;
    assert ky_sub_b(h) == B_SET;
    assert kys_hit(10.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 2) == KY_NONE;
    // a closed row has no sub-rows to hit
    assert kys_hit(kys_btn_x(660.0, 300.0, 16.0, 0) + 2.0, sy + 2.0, 660.0, 300.0, 16.0, 35.0, st[0..12], 0) == KY_NONE;
}

test a_subrow_button_means_edit_arm_delete_or_one_check {
    assert kys_click(B_SET, true, KY_NONE, 1, 2) == KA_EDIT;
    assert kys_click(B_DELETE, true, KY_NONE, 1, 2) == KA_ARM;
    assert kys_click(B_DELETE, true, 1 * MAX_KEYS + 2, 1, 2) == KA_DELETE;
    assert kys_click(B_DELETE, true, 1 * MAX_KEYS + 3, 1, 2) == KA_ARM;
    assert kys_click(B_CHECK, true, KY_NONE, 1, 2) == KA_CHECK;
    assert kys_click(B_CHECK, false, KY_NONE, 1, 2) == KA_NONE;
}

test the_rotation_line_names_the_next_serving_key {
    var st : [16]u32 = undefined;
    var i : u32 = 0;
    while (i < 16) { st[i] = ST_STORED; i = i + 1; }
    var out : [24]u8 = undefined;
    // three stored, none failed: key 1 serves next
    var n : usize = rotation_text(st[0..16], 0, 7, out[0..24]);
    assert n == 9;
    assert out[0] == 110 and out[5] == 35 and out[6] == 49 and out[8] == 51;
    // key 1 failed its check: key 2 serves next
    st[0] = ST_INVALID;
    n = rotation_text(st[0..16], 0, 7, out[0..24]);
    assert n == 9;
    assert out[6] == 50;
    // every key withheld: zero of three serve
    st[1] = ST_INVALID;
    st[2] = ST_INVALID;
    n = rotation_text(st[0..16], 0, 7, out[0..24]);
    assert n == 12;
    assert out[0] == 48 and out[2] == 51 and out[4] == 119;
    // no key, no line
    assert rotation_text(st[0..16], 0, 0, out[0..24]) == 0;
    assert first_serving_key(st[0..16], 0, 7) == MAX_KEYS;
    st[2] = ST_STORED;
    assert first_serving_key(st[0..16], 0, 7) == 2;
}

test a_key_subrow_says_what_that_key_is {
    var out : [16]u8 = undefined;
    assert key_slot_text(ST_VALID, true, out[0..16]) == 5;
    assert out[0] == 118 and out[4] == 100;
    assert key_slot_text(ST_INVALID, true, out[0..16]) == 8;
    assert out[0] == 119 and out[7] == 100;
    assert key_slot_text(ST_RATE_LIMITED, true, out[0..16]) == 7;
    assert key_slot_text(ST_STORED, true, out[0..16]) == 6;
    assert key_slot_text(ST_STORED, false, out[0..16]) == 0;
}

test delete_asks_twice {
    assert ky_click(B_DELETE, true, false, true, KY_NONE, 3) == KA_ARM;
    assert ky_click(B_DELETE, true, false, true, 3, 3) == KA_DELETE;
    assert ky_click(B_DELETE, true, false, true, 2, 3) == KA_ARM;
    assert ky_click(B_DELETE, false, false, true, KY_NONE, 3) == KA_NONE;
    assert ky_click(B_DELETE, true, true, true, 3, 3) == KA_DELETE;
}

test add_edits_until_the_provider_is_full_and_check_needs_a_key_and_a_probe {
    assert ky_click(B_SET, false, false, false, KY_NONE, 0) == KA_EDIT;
    assert ky_click(B_SET, true, false, true, KY_NONE, 0) == KA_EDIT;
    assert ky_click(B_SET, true, true, true, KY_NONE, 0) == KA_NONE;
    assert ky_click(B_CHECK, true, false, true, KY_NONE, 0) == KA_CHECK;
    assert ky_click(B_CHECK, true, true, true, KY_NONE, 0) == KA_CHECK;
    assert ky_click(B_CHECK, false, false, true, KY_NONE, 0) == KA_NONE;
    assert ky_click(B_CHECK, true, false, false, KY_NONE, 7) == KA_NONE;
}

test keys_while_typing {
    assert ky_key(KEY_RETURN, false) == KE_SAVE;
    assert ky_key(KEY_ESC, false) == KE_CANCEL;
    assert ky_key(KEY_BACKSPACE, false) == KE_BACK;
    assert ky_key(KEY_V, true) == KE_PASTE;
    assert ky_key(0, true) == KE_NONE;
    assert ky_key(0, false) == KE_CHAR;
    assert ky_accepts(0, 65);
    assert ky_accepts(0, 32) == false;
    assert ky_accepts(0, 10) == false;
    assert ky_accepts(MAX_KEY_CHARS, 65) == false;
    assert ky_accepts(0, 34) == false;
    assert ky_accepts(0, 39) == false;
    assert ky_accepts(0, 92) == false;
    assert ky_accepts(0, 45) and ky_accepts(0, 95) and ky_accepts(0, 35);
}

test a_pasted_text_loses_its_white_space {
    var out : [32]u8 = undefined;
    const n : usize = trim_key("  sk-abc\n", out[0..32]);
    assert n == 6;
    assert out[0] == 115 and out[5] == 99;
    assert trim_key("\n \t", out[0..32]) == 0;
    assert trim_key("sk-abc", out[0..4]) == 4;
}

test the_keys_link_sits_left_of_the_doctor_link {
    assert on_keys_link(272.0 - 14.0 - 84.0 - 6.0 - 20.0, 530.0, 272.0, 540.0, 30.0, 84.0);
    assert on_keys_link(272.0 - 20.0, 530.0, 272.0, 540.0, 30.0, 84.0) == false;
    assert on_keys_link(10.0, 530.0, 272.0, 540.0, 30.0, 84.0) == false;
}

// ---- the claude pane's PROFILE: which provider the Claude Code CLI talks to (M12) ----------------------
// The owner's screenshot (2026-10-19): a claude pane answered "Your organization has disabled Claude
// subscription access". A pane never uses the subscription login; it gets one of the API profiles below from
// the Keychain. Order: the free z.ai first, as the chain in specs/automation/agent-provider-chain.t27
// (ORDER_DEFAULT "zai,kie,...", WHY: the free route first, a paid one behind it). That spec is written in
// the brace module syntax and cannot be `use`d from here, so the order is restated once, below, and
// nowhere else. Kie and nemotron are not Anthropic-protocol endpoints; they join in stage 2 (the local
// router, which translates through specs/provider/transform.t27). OpenRouter and Ollama's cloud endpoint
// do document the Anthropic protocol (see PROFILE_PROVIDER below), so they are profiles now. The profile
// numbers below index every table; the order the chain walks them in is the tier order further down
// (PROFILE_TIER, profile_rank): z.ai free, then OpenRouter's `:free` ids, then the paid profiles.
pub const PR_ZAI : u32 = 0;
pub const PR_ANTHROPIC : u32 = 1;
pub const PR_OPENROUTER : u32 = 2;
pub const PR_OLLAMA_CLOUD : u32 = 3;
pub const PR_NONE : u32 = 255;
pub const PROFILE_COUNT : u32 = 4;
pub const PROFILE_NAMES : str = "zai,anthropic-api,openrouter,ollama-cloud";
/// The provider whose Keychain key backs each profile.
pub const PROFILE_PROVIDER : [4]u32 = [4, 0, 3, 5];

// ---- the tier order of the chain (gHashTag/t27#11285, FR-001) ----------------------------------------------
// Owner, 2026-10-20: free z.ai flash by default, OpenRouter's free tokens as well, never run out of tokens,
// keys rotate on errors. The chain has three tiers, walked in this order, and a pane tries ALL the keys of a
// tier (rotate_pick_except: the failed key rests, the next one is taken, fo_action) and every model of the tier
// (fo_next_model) before it moves to the next tier:
//   0 CT_ZAI_FREE  z.ai's free flash models (profile zai)
//   1 CT_OR_FREE   OpenRouter's `:free` model ids through an OpenRouter key from the Keychain (profile
//                  openrouter). With no OpenRouter key stored the tier is skipped, never an error loop:
//                  next_profile offers a profile only when its provider holds a key (needs_key_request says so)
//   2 CT_PAID      the paid profiles (anthropic-api, ollama-cloud), only after both free tiers rest
// PROFILE_NAMES stays the index order of every table; the chain order is the tier first and the index second.
pub const CT_ZAI_FREE : u32 = 0;
pub const CT_OR_FREE : u32 = 1;
pub const CT_PAID : u32 = 2;
pub const CT_COUNT : u32 = 3;
/// The tier of each profile, in PROFILE_NAMES order: zai, anthropic-api, openrouter, ollama-cloud.
pub const PROFILE_TIER : [4]u32 = [0, 2, 1, 2];
// A profile exists only for a provider that documents an Anthropic-protocol base URL on its own pages, read
// on 2026-10-20 (the page is named at each row below). None is used until its provider's key is stored.
//   zai          https://docs.z.ai/devpack/tool/claude
//   anthropic-api  Claude Code's own direct API (no base URL, the API key variable)
//   openrouter   https://openrouter.ai/docs/cookbook/coding-agents/claude-code-integration.md
//   ollama-cloud https://docs.ollama.com/integrations/claude-code (section "Connecting directly to Ollama's cloud")
// Documented too, but with no profile yet: DeepSeek, Moonshot (Kimi) and MiniMax. Each would need a
// provider row of its own above (PROVIDER_COUNT 9 -> 12), and the window and the server size their key
// tables by the nine rows; see docs/t27os/keys-orchestration.md for what their pages say.

// ---- the tier map: a default model plus a model per tier, as pure data (gHashTag/t27#11224, FR-001) -----
// Prior art: the open-source tool Free Claude Code (https://github.com/Alishahryar1/free-claude-code,
// read 2026-10-20) keeps one default model and lets each tier (opus, sonnet, haiku) override it; a tier left
// unset falls back to the default. Claude Code asks for a model by tier, and a provider that is not
// Anthropic serves models of its own name, so each profile maps every tier to a model it serves.
// One column per tier, one comma field per profile in PROFILE_NAMES order. An empty field means "same as
// the default model"; when the default is empty too, the variable is left unset and Claude Code keeps its
// own name for the tier. The small-fast model has no column: it follows the haiku tier.
pub const TI_DEFAULT : u32 = 0;
pub const TI_FAST : u32 = 1;
pub const TI_HAIKU : u32 = 2;
pub const TI_SONNET : u32 = 3;
pub const TI_OPUS : u32 = 4;
pub const TIER_COUNT : u32 = 5;
/// The variable each tier is set through (ANTHROPIC_SMALL_FAST_MODEL is the older name of the haiku slot).
pub const TIER_VARS : str = "ANTHROPIC_MODEL,ANTHROPIC_SMALL_FAST_MODEL,ANTHROPIC_DEFAULT_HAIKU_MODEL,ANTHROPIC_DEFAULT_SONNET_MODEL,ANTHROPIC_DEFAULT_OPUS_MODEL";
/// Only the free flash models answer on the owner's z.ai keys, so every tier of the zai profile names the
/// free flash tier's models; the paid ids (glm-5.2 and the like) answer 1113 "Insufficient balance or no
/// resource package" on every key. The z.ai page https://docs.z.ai/devpack/tool/claude (read 2026-10-20)
/// lists bigger models for the opus and sonnet tiers; they join here as one data edit when a key that
/// answers them is stored.
/// MEASURED 2026-10-20T08:49Z on the bench Mac (gHashTag/t27#11284): one 1-token call per Keychain key of
/// service ai.t27.os, accounts zai and zai#2 to zai#7 (seven keys, no key value is written here):
///   glm-4.5-flash  HTTP 200 on 7 of 7 keys        -> the first model of the tier, the default
///   glm-4.7-flash  HTTP 200 on 2 of 7 keys (zai#3 and zai#6), HTTP 529 code 1305 (overloaded) on the other
///                  5 of 7                         -> the second model of the tier
///   glm-5.2 and the other paid ids: 1113 on all keys (earlier measurement) -> not in the map at all.
/// A pane (new or restored) starts on the default; on 429, 1113, 1305 or 401/403 it rotates over every key of
/// the provider (the failed key resting), then takes the next model of the tier (MODELS_SECOND) and rotates
/// over the keys again, then leaves for the next profile of the chain (fo_action).
/// OpenRouter's tier (CT_OR_FREE, gHashTag/t27#11285): its `:free` model ids, taken from the public model list
/// https://openrouter.ai/api/v1/models read on 2026-10-20 (17 ids end in `:free`; these three list "tools" and
/// "tool_choice" among their supported parameters and a context of 1,000,000 tokens). NOT YET MEASURED ON A KEY:
/// no OpenRouter key is stored in the Keychain (the one found in old env files answers 401), so the order is the
/// list's, not a measurement. Measure each id with one 1-token call the day a key is stored and reorder this
/// table as the z.ai one was. Every tier of the profile names the default free id (the tier columns below are
/// empty for it); the paid `~anthropic/...` names OpenRouter also serves are not used by the free tier.
/// MEASURED 2026-10-20T09:50Z on the bench Mac by the keys-lane session, with the owner's OpenRouter key (Keychain
/// account openrouter; no key text anywhere): GET /api/v1/auth/key HTTP 200, is_free_tier false, key limit 50,
/// usage 0, through the profile's own endpoint (base https://openrouter.ai/api, POST /v1/messages, Anthropic format):
///   minimax/minimax-m3.1-flash:free       HTTP 200, text 'PONG' at max_tokens 16  -> first, the default
///   nvidia/nemotron-3.5-super-vl:free     HTTP 200, 'PONG' but it thinks first (content types thinking,text, 31
///                                         output tokens): max_tokens 16 gives EMPTY text -> second, floor
///                                         THINKING_MIN_TOKENS (model_min_tokens)
///   nvidia/nemotron-3.5-lightning:free    HTTP 200 twice with no parsable message body -> NOT verified, dropped
///                                         from MODELS_THIRD and never a default.
/// Fields: zai, anthropic-api, openrouter, ollama-cloud. Ollama's page names one cloud model, used for every tier.
pub const MODELS_DEFAULT : str = "glm-4.5-flash,,minimax/minimax-m3.1-flash:free,glm-5.3-flash";
/// The second model of each profile's tier (empty = the profile has one model): what a pane moves to when
/// every key of its provider failed on the default. The same fields as MODELS_DEFAULT.
pub const MODELS_SECOND : str = "glm-4.7-flash,,nvidia/nemotron-3.5-super-vl:free,";
/// The third model of each profile's tier (empty = the profile has fewer models). A profile that names a third
/// model names a second one too (profile_models counts up to the first empty step).
pub const MODELS_THIRD : str = ",,,";
/// How many models one profile's tier map can hold: step 0 is MODELS_DEFAULT, step 1 is MODELS_SECOND, step 2
/// is MODELS_THIRD.
pub const MODEL_STEPS : u32 = 3;
/// A request that must return text needs at least this many output tokens on a model that thinks first
/// (nemotron-3.5-super-vl: 31 tokens of thinking, measured 2026-10-20); the other models answer at 16.
pub const THINKING_MIN_TOKENS : u32 = 64;
pub const PLAIN_MIN_TOKENS : u32 = 16;
pub const MODELS_HAIKU : str = ",,,";
pub const MODELS_SONNET : str = ",,,";
pub const MODELS_OPUS : str = ",,,";
/// The OpenAI-compatible base URL of each profile, for the agents that do not speak the Anthropic protocol
/// (OpenCode, Crush); empty = the profile has none for them. z.ai general endpoint /api/paas/v4 (the owner named
/// it); OpenRouter https://openrouter.ai/api/v1. anthropic-api needs none (both agents read ANTHROPIC_API_KEY
/// themselves) and Ollama cloud's OpenAI route is not documented on a page this spec cites, so Ollama stays out of
/// the chain of OpenCode and Crush (agent_profile_ok).
pub const OAI_BASE_URLS : str = "https://api.z.ai/api/paas/v4,,https://openrouter.ai/api/v1,";
/// The Anthropic-protocol base URL of each profile; empty = Claude Code's own (the direct API).
pub const PROFILE_BASE_URLS : str = "https://api.z.ai/api/anthropic,,https://openrouter.ai/api,https://ollama.com";
/// The variable that carries the Keychain key: a bearer token for a gateway, the API key for Anthropic itself.
pub const PROFILE_KEY_VARS : str = "ANTHROPIC_AUTH_TOKEN,ANTHROPIC_API_KEY,ANTHROPIC_AUTH_TOKEN,ANTHROPIC_AUTH_TOKEN";
/// 1 when the profile also sets ANTHROPIC_API_KEY to the empty string: OpenRouter's and Ollama's pages both
/// say a stray API key in the environment makes Claude Code authenticate against Anthropic instead of the
/// gateway, so the variable is set empty rather than left to the parent shell.
pub const PROFILE_EMPTY_API_KEY : [4]u32 = [0, 0, 1, 1];

/// The variables of a profile come from fixed slots, in this order; a slot with no value is skipped.
pub const PS_BASE : u32 = 0;
pub const PS_KEY : u32 = 1;
pub const PS_TIER0 : u32 = 2;
pub const PS_EMPTY_KEY : u32 = 7;
pub const PS_COUNT : u32 = 8;
pub const PS_NONE : u32 = 255;

/// What a claude pane must not inherit from the shell that started the server: every variable that picks
/// an endpoint, a login or a model. CLAUDE_CODE_* (including the OAuth token) goes by env_stripped.
pub const CLAUDE_STRIPS : str = "ANTHROPIC_API_KEY,ANTHROPIC_AUTH_TOKEN,ANTHROPIC_BASE_URL,ANTHROPIC_MODEL,ANTHROPIC_SMALL_FAST_MODEL,ANTHROPIC_DEFAULT_HAIKU_MODEL,ANTHROPIC_DEFAULT_SONNET_MODEL,ANTHROPIC_DEFAULT_OPUS_MODEL,ANTHROPIC_CUSTOM_HEADERS";
pub const CLAUDE_STRIP_COUNT : u32 = 9;

/// Agent cells (agents.t27 order) that take the profile chain: Claude Code (0, Anthropic protocol), OpenCode (3)
/// and Crush (5), both through the OpenAI-compatible endpoints below (gHashTag/t27#11275). Codex, Gemini, Cursor,
/// Aider and Copilot are not installed on this Mac; the owner decides installs, so they have no profile.
pub const AG_CLAUDE : u32 = 0;
pub const AG_OPENCODE : u32 = 3;
pub const AG_CRUSH : u32 = 5;

/// Does agent a (cell order of agents.t27) get a profile?
pub fn profile_agent(a: u32) -> bool {
    return a == AG_CLAUDE or a == AG_OPENCODE or a == AG_CRUSH;
}

pub fn profile_name(pr: u32, out: []u8) -> usize {
    return csv_field(PROFILE_NAMES, pr, out);
}

/// How many comma-separated fields a table string has (an empty table has one).
pub fn csv_fields(list: []const u8) -> u32 {
    var n : u32 = 1;
    var i : usize = 0;
    while (i < list.len) {
        if (list[i] == 44) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The model profile pr serves for tier ti (TI_*), copied into out (64 bytes are enough); 0 when there is
/// none. A tier with no model of its own takes the profile's default model, as in Free Claude Code; the
/// small-fast tier takes the haiku one.
pub fn tier_model(pr: u32, ti: u32, out: []u8) -> usize {
    if (pr >= PROFILE_COUNT) { return 0; }
    if (ti >= TIER_COUNT) { return 0; }
    if (ti == TI_DEFAULT) { return csv_field(MODELS_DEFAULT, pr, out); }
    var n : usize = 0;
    if (ti == TI_SONNET) { n = csv_field(MODELS_SONNET, pr, out); }
    if (ti == TI_OPUS) { n = csv_field(MODELS_OPUS, pr, out); }
    if (ti == TI_HAIKU or ti == TI_FAST) { n = csv_field(MODELS_HAIKU, pr, out); }
    if (n > 0) { return n; }
    return csv_field(MODELS_DEFAULT, pr, out);
}

/// The model profile pr serves for tier ti at model step `step` (0 = MODELS_DEFAULT: tier_model; 1 and 2 = the
/// second and third model of the tier, MODELS_SECOND and MODELS_THIRD, which every tier of that profile
/// names); 0 when there is none.
pub fn tier_model_step(pr: u32, ti: u32, step: u32, out: []u8) -> usize {
    if (step == 0) { return tier_model(pr, ti, out); }
    if (step >= MODEL_STEPS or pr >= PROFILE_COUNT or ti >= TIER_COUNT) { return 0; }
    if (step == 1) { return csv_field(MODELS_SECOND, pr, out); }
    return csv_field(MODELS_THIRD, pr, out);
}

/// How many models profile pr's tier map holds: 1 to MODEL_STEPS (0 for no profile); the first empty step ends it.
pub fn profile_models(pr: u32) -> u32 {
    if (pr >= PROFILE_COUNT) { return 0; }
    var tmp : [64]u8 = undefined;
    var n : u32 = 1;
    while (n < MODEL_STEPS and tier_model_step(pr, TI_DEFAULT, n, tmp[0..64]) > 0) { n = n + 1; }
    return n;
}

/// Does the model at `step` have a successor in profile pr's tier map?
pub fn model_left(pr: u32, step: u32) -> bool {
    return step + 1 < profile_models(pr);
}

/// Does another profile (not pr) serve exactly `model` at some step and tier? Such an id is a gateway's own
/// name for a model, not something profile pr can answer.
fn served_elsewhere(pr: u32, model: []const u8) -> bool {
    var tmp : [64]u8 = undefined;
    var q : u32 = 0;
    while (q < PROFILE_COUNT) {
        var s : u32 = 0;
        while (s < MODEL_STEPS and q != pr) {
            var t : u32 = 0;
            while (t < TIER_COUNT) {
                const n : usize = tier_model_step(q, t, s, tmp[0..64]);
                if (n == model.len and n > 0 and begins_with(model, tmp[0..n])) { return true; }
                t = t + 1;
            }
            s = s + 1;
        }
        q = q + 1;
    }
    return false;
}

/// The model a claude pane that is restored, or started again by a failover, runs on under profile pr at
/// model step `step`: the one a fresh spawn would compute (the tier map's default model at that step), copied
/// into out (64 bytes are enough); never the model a saved record or an earlier profile left behind. A
/// profile that names no model of its own (the direct Anthropic API, OpenRouter) lets Claude Code keep its own
/// names, so the saved model stays unless another profile's tier map serves it (a z.ai id has no place on the
/// Anthropic API). No profile (a pane without a key) keeps the saved model. 0 = pass no model.
pub fn model_for_profile(pr: u32, step: u32, saved: []const u8, out: []u8) -> usize {
    if (pr < PROFILE_COUNT) {
        const n : usize = tier_model_step(pr, TI_DEFAULT, step, out);
        if (n > 0) { return n; }
        if (served_elsewhere(pr, saved)) { return 0; }
    }
    return put_bytes(out, 0, saved);
}

/// The base URL of profile pr (0 = none: the direct Anthropic API).
pub fn profile_base_url(pr: u32, out: []u8) -> usize {
    if (pr >= PROFILE_COUNT) { return 0; }
    return csv_field(PROFILE_BASE_URLS, pr, out);
}

/// Does profile pr set slot s (PS_*)? The key slot always; the others when they carry a value.
fn slot_present(pr: u32, s: u32) -> bool {
    if (pr >= PROFILE_COUNT) { return false; }
    if (s == PS_KEY) { return true; }
    if (s == PS_EMPTY_KEY) { return PROFILE_EMPTY_API_KEY[pr] == 1; }
    var tmp : [64]u8 = undefined;
    if (s == PS_BASE) { return profile_base_url(pr, tmp[0..64]) > 0; }
    if (s >= PS_TIER0 and s < PS_TIER0 + TIER_COUNT) { return tier_model(pr, s - PS_TIER0, tmp[0..64]) > 0; }
    return false;
}

/// The slot of the k-th variable of profile pr; PS_NONE past the last one.
fn profile_slot(pr: u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var s : u32 = 0;
    while (s < PS_COUNT) {
        if (slot_present(pr, s)) {
            if (seen == k) { return s; }
            seen = seen + 1;
        }
        s = s + 1;
    }
    return PS_NONE;
}

pub fn profile_var_count(pr: u32) -> u32 {
    var n : u32 = 0;
    var s : u32 = 0;
    while (s < PS_COUNT) {
        if (slot_present(pr, s)) { n = n + 1; }
        s = s + 1;
    }
    return n;
}

/// The name of variable k (40 bytes are enough).
pub fn profile_var_name(pr: u32, k: u32, out: []u8) -> usize {
    const s : u32 = profile_slot(pr, k);
    if (s == PS_NONE) { return 0; }
    if (s == PS_BASE) { return put_bytes(out, 0, "ANTHROPIC_BASE_URL"); }
    if (s == PS_KEY) { return csv_field(PROFILE_KEY_VARS, pr, out); }
    if (s == PS_EMPTY_KEY) { return put_bytes(out, 0, "ANTHROPIC_API_KEY"); }
    return csv_field(TIER_VARS, s - PS_TIER0, out);
}

/// True when variable k of the profile carries the Keychain key.
pub fn profile_var_is_key(pr: u32, k: u32) -> bool {
    return profile_slot(pr, k) == PS_KEY;
}

/// The constant value of variable k (0 for the key variable; a variable that is present with value 0 is set
/// to the empty string).
pub fn profile_var_text(pr: u32, k: u32, out: []u8) -> usize {
    return profile_var_text_step(pr, k, 0, out);
}

/// profile_var_text for a pane at model step `step`: the tier variables name that step's model.
pub fn profile_var_text_step(pr: u32, k: u32, step: u32, out: []u8) -> usize {
    const s : u32 = profile_slot(pr, k);
    if (s == PS_BASE) { return profile_base_url(pr, out); }
    if (s >= PS_TIER0 and s < PS_TIER0 + TIER_COUNT) { return tier_model_step(pr, s - PS_TIER0, step, out); }
    return 0;
}

/// Is `name` one of the variables a claude pane starts without?
pub fn claude_strips(name: []const u8) -> bool {
    var tmp : [40]u8 = undefined;
    var k : u32 = 0;
    while (k < CLAUDE_STRIP_COUNT) {
        const n : usize = csv_field(CLAUDE_STRIPS, k, tmp[0..40]);
        if (n == name.len) {
            var i : usize = 0;
            var same : bool = true;
            while (i < n) {
                if (tmp[i] != name[i]) { same = false; }
                i = i + 1;
            }
            if (same) { return true; }
        }
        k = k + 1;
    }
    return false;
}

// ---- the profile chain with numbered keys (gHashTag/t27#11224, FR-003) ------------------------------------
// Free Claude Code walks an ordered fallback list when a request fails after its retries, and each fallback
// entry may name a key number of its provider (key 1 first). Here the list is the profiles in tier order
// (PROFILE_TIER: the free z.ai tier, OpenRouter's free tier, then the paid profiles; the index breaks a tie),
// walked at pane spawn and pane failover (the failover decision is below), forward only: a profile that
// failed once is not tried again by the same pane, so the walk always ends.

/// The place of profile pr in the chain: its tier first, its index second; past every profile for a number
/// that is none.
pub fn profile_rank(pr: u32) -> u32 {
    if (pr >= PROFILE_COUNT) { return CT_COUNT * PROFILE_COUNT; }
    return PROFILE_TIER[pr] * PROFILE_COUNT + pr;
}

/// The first profile after `after` (PR_NONE = from the start) in chain order (profile_rank) whose provider key
/// is stored and has not failed (bad bit set); PR_NONE when the chain is over. A profile whose provider holds
/// no key is skipped, so a tier with no key (no OpenRouter key stored) costs the pane nothing. Any other
/// `after` out of range ends the chain.
pub fn next_profile(after: u32, stored: u32, bad: u32) -> u32 {
    var floor : u32 = 0;
    if (after != PR_NONE) {
        if (after >= PROFILE_COUNT) { return PR_NONE; }
        floor = profile_rank(after) + 1;
    }
    var best : u32 = PR_NONE;
    var pr : u32 = 0;
    while (pr < PROFILE_COUNT) {
        const bit : u32 = PROFILE_PROVIDER[pr];
        if ((stored >> bit) % 2 == 1 and (bad >> bit) % 2 == 0 and profile_rank(pr) >= floor) {
            if (best == PR_NONE or profile_rank(pr) < profile_rank(best)) { best = pr; }
        }
        pr = pr + 1;
    }
    return best;
}

/// The profile a new claude pane gets: the first in order whose provider key is stored and has not
/// failed its check (bad bit set). PR_NONE when there is none: the pane starts without a key and says so.
pub fn pick_profile(stored: u32, bad: u32) -> u32 {
    return next_profile(PR_NONE, stored, bad);
}

// ---- OpenCode and Crush take the same chain (gHashTag/t27#11275) -------------------------------------------
// Read from the installed versions on 2026-10-20 (OpenCode 1.3.15, Crush 0.92.0); neither `--help` lists an
// environment variable, so the names below come from what the binaries contain and what their pages document:
//   OpenCode  `opencode [project]`, `-m, --model  model to use in the format of provider/model`; the binary
//             names OPENCODE_CONFIG_CONTENT (an inline JSON config), OPENCODE_CONFIG, OPENCODE_CONFIG_DIR, and the
//             `{env:VAR_NAME}` reference a config value may use, and the package @ai-sdk/openai-compatible for a
//             custom OpenAI-compatible provider. So the profile is one inline config that holds no key (the key
//             is `{env:ZAI_API_KEY}`) plus the key variable.
//   Crush     `crush run -m, --model` exists, but the interactive `crush` has no model flag; the binary names
//             CRUSH_GLOBAL_CONFIG (a directory holding crush.json), CRUSH_GLOBAL_DATA, and its built-in providers
//             read $ZAI_API_KEY, $OPENROUTER_API_KEY, $ANTHROPIC_API_KEY, $OPENAI_API_KEY. A model needs a config
//             file: the host writes crush_config_text to <home>/.t27os/crush/<profile>-<step>/crush.json (no
//             key in it, `$ZAI_API_KEY` is expanded by Crush) and sets CRUSH_GLOBAL_CONFIG to that directory.
// What each prints on 401 or 429 neither page says and no key was spent to find out, so the failure
// classifier is the generic one (classify_line reads any line with "rror" and a status code, 1113, 1305).
// The two agents take the zai, anthropic-api and openrouter profiles; the Ollama cloud profile has no
// OpenAI-compatible URL on a page cited above, so it is out of their chain (agent_profile_ok).

/// May agent a run profile pr? Claude Code any; OpenCode and Crush the zai, anthropic-api and openrouter ones.
pub fn agent_profile_ok(a: u32, pr: u32) -> bool {
    if (pr >= PROFILE_COUNT) { return false; }
    if (a == AG_CLAUDE) { return true; }
    if (a == AG_OPENCODE or a == AG_CRUSH) { return pr == PR_ZAI or pr == PR_ANTHROPIC or pr == PR_OPENROUTER; }
    return false;
}

/// The stored-provider mask narrowed to the providers of the profiles agent a may run: what the chain walk of
/// a pane of agent a sees as stored.
pub fn agent_stored(a: u32, stored: u32) -> u32 {
    var m : u32 = 0;
    var pr : u32 = 0;
    while (pr < PROFILE_COUNT) {
        const bit : u32 = PROFILE_PROVIDER[pr];
        if (agent_profile_ok(a, pr) and (stored >> bit) % 2 == 1 and (m >> bit) % 2 == 0) { m = m + (1 << bit); }
        pr = pr + 1;
    }
    return m;
}

/// The model's output-token floor for a request that must return text: the thinking models need
/// THINKING_MIN_TOKENS (OpenRouter step 1, nemotron-3.5-super-vl), the rest PLAIN_MIN_TOKENS.
pub fn model_min_tokens(pr: u32, step: u32) -> u32 {
    if (pr == PR_OPENROUTER and step == 1) { return THINKING_MIN_TOKENS; }
    return PLAIN_MIN_TOKENS;
}

/// The OpenAI-compatible base URL of profile pr for OpenCode and Crush (0 = none).
pub fn oai_base_url(pr: u32, out: []u8) -> usize {
    if (pr >= PROFILE_COUNT) { return 0; }
    return csv_field(OAI_BASE_URLS, pr, out);
}

/// OpenCode's inline config (OPENCODE_CONFIG_CONTENT) for profile pr at model step `step`: one OpenAI-compatible
/// provider named t27 whose key is read from the provider's variable, and the model. 0 for a profile with no
/// OpenAI-compatible URL (anthropic-api needs no config). 600 bytes are enough. Holds no key.
pub fn opencode_config(pr: u32, step: u32, out: []u8) -> usize {
    var url : [64]u8 = undefined;
    var m : [64]u8 = undefined;
    var ev : [40]u8 = undefined;
    const ul : usize = oai_base_url(pr, url[0..64]);
    const ml : usize = tier_model_step(pr, TI_DEFAULT, step, m[0..64]);
    if (ul == 0 or ml == 0) { return 0; }
    const el : usize = provider_env(PROFILE_PROVIDER[pr], ev[0..40]);
    var n : usize = put_bytes(out, 0, "{\"$schema\":\"https://opencode.ai/config.json\",\"provider\":{\"t27\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"T27\",\"options\":{\"baseURL\":\"");
    n = put_bytes(out, n, url[0..ul]);
    n = put_bytes(out, n, "\",\"apiKey\":\"{env:");
    n = put_bytes(out, n, ev[0..el]);
    n = put_bytes(out, n, "}\"},\"models\":{\"");
    n = put_bytes(out, n, m[0..ml]);
    n = put_bytes(out, n, "\":{\"name\":\"");
    n = put_bytes(out, n, m[0..ml]);
    n = put_bytes(out, n, "\"}}}},\"model\":\"t27/");
    n = put_bytes(out, n, m[0..ml]);
    return put_bytes(out, n, "\"}");
}

/// Crush's crush.json for profile pr at model step `step`: the same provider, large and small model the one id.
/// 0 for a profile with no OpenAI-compatible URL. 800 bytes are enough. Holds no key (`$ZAI_API_KEY` is Crush's
/// own variable reference).
pub fn crush_config_text(pr: u32, step: u32, out: []u8) -> usize {
    var url : [64]u8 = undefined;
    var m : [64]u8 = undefined;
    var ev : [40]u8 = undefined;
    const ul : usize = oai_base_url(pr, url[0..64]);
    const ml : usize = tier_model_step(pr, TI_DEFAULT, step, m[0..64]);
    if (ul == 0 or ml == 0) { return 0; }
    const el : usize = provider_env(PROFILE_PROVIDER[pr], ev[0..40]);
    var n : usize = put_bytes(out, 0, "{\"$schema\":\"https://charm.land/crush.json\",\"providers\":{\"t27\":{\"name\":\"T27\",\"type\":\"openai-compat\",\"base_url\":\"");
    n = put_bytes(out, n, url[0..ul]);
    n = put_bytes(out, n, "\",\"api_key\":\"$");
    n = put_bytes(out, n, ev[0..el]);
    n = put_bytes(out, n, "\",\"models\":[{\"id\":\"");
    n = put_bytes(out, n, m[0..ml]);
    n = put_bytes(out, n, "\",\"name\":\"");
    n = put_bytes(out, n, m[0..ml]);
    n = put_bytes(out, n, "\",\"context_window\":128000,\"default_max_tokens\":8192}]}},\"models\":{\"large\":{\"provider\":\"t27\",\"model\":\"");
    n = put_bytes(out, n, m[0..ml]);
    n = put_bytes(out, n, "\"},\"small\":{\"provider\":\"t27\",\"model\":\"");
    n = put_bytes(out, n, m[0..ml]);
    return put_bytes(out, n, "\"}},\"options\":{\"disable_provider_auto_updates\":true}}");
}

/// The directory the host writes crush_config_text into for profile pr at `step`:
/// "<home>/.t27os/crush/<profile>-<step>". 0 when pr is no profile.
pub fn crush_config_dir(home: []const u8, pr: u32, step: u32, out: []u8) -> usize {
    if (pr >= PROFILE_COUNT or step >= MODEL_STEPS) { return 0; }
    var nm : [32]u8 = undefined;
    const nl : usize = profile_name(pr, nm[0..32]);
    var n : usize = put_bytes(out, 0, home);
    n = put_bytes(out, n, "/.t27os/crush/");
    n = put_bytes(out, n, nm[0..nl]);
    n = put_bytes(out, n, "-");
    return put_dec(out, n, @as(u64, step));
}

/// Does agent a's pane need a config written before it starts (Crush with an OpenAI-compatible profile)?
pub fn agent_config_file(a: u32, pr: u32) -> bool {
    var t : [64]u8 = undefined;
    return a == AG_CRUSH and agent_profile_ok(a, pr) and oai_base_url(pr, t[0..64]) > 0;
}

/// The number of variables a pane of agent a gets for profile pr: Claude Code the Anthropic-protocol set; OpenCode
/// and Crush the provider's key variable plus, when the profile has an OpenAI-compatible URL, one config variable
/// (OPENCODE_CONFIG_CONTENT, CRUSH_GLOBAL_CONFIG). 0 for a profile the agent may not run.
pub fn agent_var_count(a: u32, pr: u32) -> u32 {
    if (a == AG_CLAUDE) { return profile_var_count(pr); }
    if (agent_profile_ok(a, pr) == false) { return 0; }
    var tmp : [64]u8 = undefined;
    if (oai_base_url(pr, tmp[0..64]) > 0) { return 2; }
    return 1;
}

/// The name of variable k (40 bytes are enough).
pub fn agent_var_name(a: u32, pr: u32, k: u32, out: []u8) -> usize {
    if (a == AG_CLAUDE) { return profile_var_name(pr, k, out); }
    if (k >= agent_var_count(a, pr)) { return 0; }
    if (k == 0) { return provider_env(PROFILE_PROVIDER[pr], out); }
    if (a == AG_OPENCODE) { return put_bytes(out, 0, "OPENCODE_CONFIG_CONTENT"); }
    return put_bytes(out, 0, "CRUSH_GLOBAL_CONFIG");
}

/// True when variable k carries the Keychain key.
pub fn agent_var_is_key(a: u32, pr: u32, k: u32) -> bool {
    if (a == AG_CLAUDE) { return profile_var_is_key(pr, k); }
    return k == 0 and k < agent_var_count(a, pr);
}

/// The constant value of variable k at model step `step` (the key variable has none). `home` is the user's home
/// directory, for Crush's config directory. 700 bytes are enough.
pub fn agent_var_text_step(a: u32, pr: u32, k: u32, step: u32, home: []const u8, out: []u8) -> usize {
    if (a == AG_CLAUDE) { return profile_var_text_step(pr, k, step, out); }
    if (k != 1 or k >= agent_var_count(a, pr)) { return 0; }
    if (a == AG_OPENCODE) { return opencode_config(pr, step, out); }
    return crush_config_dir(home, pr, step, out);
}

/// What OpenCode and Crush must not inherit from the shell that started the server: every key, endpoint and
/// config variable of the providers they are given.
pub const AGENT_STRIPS : str = "ZAI_API_KEY,OPENROUTER_API_KEY,ANTHROPIC_API_KEY,OPENAI_API_KEY,OPENCODE_CONFIG_CONTENT,OPENCODE_CONFIG,CRUSH_GLOBAL_CONFIG,OPENAI_BASE_URL,ANTHROPIC_BASE_URL";
pub const AGENT_STRIP_COUNT : u32 = 9;

/// Is `name` a variable a pane of agent a starts without? Claude Code: claude_strips.
pub fn agent_strips(a: u32, name: []const u8) -> bool {
    if (a == AG_CLAUDE) { return claude_strips(name); }
    if (a != AG_OPENCODE and a != AG_CRUSH) { return false; }
    var tmp : [40]u8 = undefined;
    var k : u32 = 0;
    while (k < AGENT_STRIP_COUNT) {
        const n : usize = csv_field(AGENT_STRIPS, k, tmp[0..40]);
        if (same_bytes(tmp[0..n], name)) { return true; }
        k = k + 1;
    }
    return false;
}

// ---- an agent that is not installed (gHashTag/t27#11275) ---------------------------------------------------
// The host supplies a bit mask of the agent cells whose binary it found (agents.t27 AGENT_BINS on PATH); the
// window shows "not installed" for a missing one, never "stopped". Nothing is installed by T27 OS.
pub const AS_NOT_INSTALLED : u32 = 0;
pub const AS_STOPPED : u32 = 1;
pub const AS_RUNNING : u32 = 2;
pub const AS_NO_KEY : u32 = 3;

pub fn agent_installed(mask: u32, a: u32) -> bool {
    return a < AGENT_COUNT and (mask >> a) % 2 == 1;
}

/// What the window says about agent a's pane: not installed (mask), running, no key (a profile agent whose
/// chain holds no stored key), else stopped.
pub fn agent_state(mask: u32, a: u32, live: bool, stored: u32) -> u32 {
    if (agent_installed(mask, a) == false) { return AS_NOT_INSTALLED; }
    if (live) { return AS_RUNNING; }
    if (profile_agent(a) and pick_profile(agent_stored(a, stored), 0) == PR_NONE) { return AS_NO_KEY; }
    return AS_STOPPED;
}

pub const AS_WORDS : str = "not installed,stopped,running,no key stored";

// ---- the traffic light of an agent pane (gHashTag/t27#11314) -------------------------------------------------
// Owner, 2026-10-20: one light per agent pane. GREEN = the pane runs a paid profile (CT_PAID), YELLOW = it runs
// a free tier (CT_ZAI_FREE or CT_OR_FREE), RED = no balance: the chain gave up, or every usable key rests
// (1113 empty account, 401/403 rejected). An editor pane (and every cell without a profile) has no light. The
// codes are ordered so that the worst light is the largest one: RED 3 > YELLOW 2 > GREEN 1 > NONE 0.
pub const L_NONE : u32 = 0;
pub const L_GREEN : u32 = 1;
pub const L_YELLOW : u32 = 2;
pub const L_RED : u32 = 3;
pub const L_NAMES : str = "none,green,yellow,red";
/// The tier argument of light_of for a pane with no profile (an editor, a shell, a pane with no key yet).
pub const CT_NO_TIER : u32 = 255;

/// A key whose rest ends within this many seconds still counts as usable: a throttled key (30 s) or an
/// overloaded one (60 s) is busy, not out of balance; an empty (600 s) or rejected (3600 s) one is out.
pub const LIGHT_SOON_S : u64 = 60;

/// The light of a pane: `tier` the chain tier of its profile (CT_*, CT_NO_TIER for none), `gave_up` the chain
/// is over (FA_GIVE_UP), `usable` how many keys of its provider are free or rest less than LIGHT_SOON_S.
pub fn light_of(tier: u32, gave_up: bool, usable: u32) -> u32 {
    if (tier == CT_NO_TIER) { return L_NONE; }
    if (tier >= CT_COUNT) { return L_NONE; }
    if (gave_up or usable == 0) { return L_RED; }
    if (tier == CT_PAID) { return L_GREEN; }
    return L_YELLOW;
}

/// The worst light of the panes in `live` (bit i set = pane i runs) given each pane's light: RED over YELLOW
/// over GREEN; NONE when none runs or none has a light. For the sidebar foot.
pub fn worst_light(lights: []const u32, live: u32) -> u32 {
    var w : u32 = L_NONE;
    var i : usize = 0;
    while (i < lights.len and i < 32) {
        if ((live >> @as(u32, @intCast(i))) % 2 == 1 and lights[i] > w) { w = lights[i]; }
        i = i + 1;
    }
    return w;
}

pub fn light_name(l: u32, out: []u8) -> usize {
    return csv_field(L_NAMES, l, out);
}

/// The tooltip of a light, 96 bytes are enough: "free: <model>", "paid: <model>", "no balance: all keys rest";
/// nothing for NONE.
pub fn light_tip(l: u32, model: []const u8, out: []u8) -> usize {
    if (l == L_GREEN) {
        const n : usize = put_bytes(out, 0, "paid: ");
        return put_bytes(out, n, model);
    }
    if (l == L_YELLOW) {
        const n : usize = put_bytes(out, 0, "free: ");
        return put_bytes(out, n, model);
    }
    if (l == L_RED) { return put_bytes(out, 0, "no balance: all keys rest"); }
    return 0;
}

/// The LISTING `shown` byte with the light in its bits 6 and 7 (the state is below 64); the light of an old
/// server is 0 = none.
pub fn shown_with_light(shown: u32, l: u32) -> u32 {
    return shown % 64 + 64 * (l % 4);
}

pub fn shown_state_of(b: u32) -> u32 {
    return b % 64;
}

pub fn shown_light_of(b: u32) -> u32 {
    return b / 64 % 4;
}

/// How many keys one provider may hold, numbered from 1 (Free Claude Code: "key 1 first"). Eight, since the
/// owner stores seven z.ai keys and rotates over all of them (gHashTag/t27#11241).
pub const MAX_KEYS : u32 = 8;

/// The Keychain item of key number k (0-based; the panel says "key k+1") of provider p. Key 1 keeps the
/// plain label of keychain_label, so a key stored before numbering stays where it is; keys 2 to 8 add
/// "#2" to "#8". 0 for an unknown provider or a number past MAX_KEYS.
pub fn keychain_label_n(p: u32, k: u32, out: []u8) -> usize {
    if (p >= PROVIDER_COUNT or k >= MAX_KEYS) { return 0; }
    var n : usize = keychain_label(p, out);
    if (k == 0) { return n; }
    n = put_bytes(out, n, "#");
    return put_dec(out, n, @as(u64, k) + 1);
}

/// The Keychain account of key number k of provider p: the provider's name for key 1 and "<name>#<k+1>" for
/// the others ("zai", "zai#2", ...); the service is KEYCHAIN_SERVICE for all. 0 when p or k is out of range.
pub fn keychain_account_n(p: u32, k: u32, out: []u8) -> usize {
    if (p >= PROVIDER_COUNT or k >= MAX_KEYS) { return 0; }
    var n : usize = provider_name(p, out);
    if (k == 0) { return n; }
    n = put_bytes(out, n, "#");
    return put_dec(out, n, @as(u64, k) + 1);
}

/// What a KEYS row says next to the provider's name: nothing for no key, "1 key", "7 keys".
pub fn key_count_text(n: u32, out: []u8) -> usize {
    if (n == 0) { return 0; }
    const c : usize = put_dec(out, 0, @as(u64, n));
    if (n == 1) { return put_bytes(out, c, " key"); }
    return put_bytes(out, c, " keys");
}

/// A key travels to the PTY server in an OP_SETKEY frame whose pane byte names the provider; the key number
/// rides in the high nibble of that byte (k * 16 + p), so key 1 is the old frame byte for byte and an
/// older server refuses the others instead of misreading them.
pub const SETKEY_STEP : u32 = 16;

pub fn setkey_byte(p: u32, k: u32) -> u32 {
    return k * SETKEY_STEP + p;
}

/// The provider and the key number an OP_SETKEY pane byte names; the provider is PROVIDER_COUNT or more when
/// the byte is not one the server knows (the caller refuses it), the number is MAX_KEYS or more when too big.
pub fn setkey_provider(b: u32) -> u32 {
    return b % SETKEY_STEP;
}

pub fn setkey_number(b: u32) -> u32 {
    return b / SETKEY_STEP;
}

/// The bad mask from the providers' statuses (st[p]): invalid and circuit-open keys are not offered.
pub fn bad_mask(st: []const u32) -> u32 {
    var m : u32 = 0;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT and p < st.len) {
        if (st[p] == ST_INVALID or st[p] == ST_CIRCUIT_OPEN) { m = m + (1 << p); }
        p = p + 1;
    }
    return m;
}

/// The "why" line of the KEYS tab: which profile a claude pane gets and why. No key value, ever.
pub fn profile_why(stored: u32, bad: u32, out: []u8) -> usize {
    const pr : u32 = pick_profile(stored, bad);
    var tmp : [24]u8 = undefined;
    if (pr == PR_NONE) {
        if (stored == 0) { return put_bytes(out, 0, "claude: no key stored, the pane asks for a login"); }
        return put_bytes(out, 0, "claude: every stored key failed its check");
    }
    var n : usize = put_bytes(out, 0, "claude: ");
    const l : usize = profile_name(pr, tmp[0..24]);
    n = put_bytes(out, n, tmp[0..l]);
    if (pr == PR_ZAI) { return put_bytes(out, n, ", the first key in the chain order"); }
    if (PROFILE_TIER[pr] > CT_OR_FREE) { return put_bytes(out, n, ", no free profile has a usable key"); }
    const first : u32 = PROFILE_PROVIDER[PR_ZAI];
    if ((stored >> first) % 2 == 0) { return put_bytes(out, n, ", no z.ai key stored"); }
    return put_bytes(out, n, ", z.ai failed its check");
}

// ---- the request for the key of the OpenRouter tier (gHashTag/t27#11285, FR-003) ---------------------------
// The OpenRouter tier needs a key the owner stores in the KEYS tab (Keychain service ai.t27.os, account
// "openrouter"); until then next_profile skips it. The KEYS tab shows the request line below next to the
// provider's row while needs_key_request says so; nothing here holds or reads a key.

/// The line the KEYS tab shows for a provider whose key the free chain is waiting for.
pub const KEY_REQUEST_OPENROUTER : str = "Add an OpenRouter key to use its free models";

/// Does provider p owe the person a request for a key: OpenRouter's free tier is in the chain and no key of it is
/// stored (`stored_count` is how many keys the table holds for p, key_count_text's n). Every other provider
/// either has no tier waiting on it or is covered by the old "no key stored" text.
pub fn needs_key_request(p: u32, stored_count: u32) -> bool {
    return p == P_OPENROUTER and stored_count == 0;
}

/// The request line for provider p (out needs 48 bytes); 0 when needs_key_request is false.
pub fn key_request_text(p: u32, stored_count: u32, out: []u8) -> usize {
    if (needs_key_request(p, stored_count) == false) { return 0; }
    return put_bytes(out, 0, KEY_REQUEST_OPENROUTER);
}

// ---- the pane failover: what to do when a claude pane shows a provider error (gHashTag/t27#11224, FR-004) --
// Owner, 2026-10-20: panes that start Claude Code inherited a provider that answered 429 "Insufficient
// balance" or "organization has disabled Claude subscription access". Free Claude Code solves this inside a
// local proxy that retries and then walks a fallback list per request. T27 OS cannot run that proxy yet (no
// AF_INET server and no streamed HTTPS client in t27b, t27c issue 10902; router.t27 stops at decisions), but
// z.ai, OpenRouter and Ollama's cloud serve the Anthropic protocol themselves, so the walk is done per PANE:
// read the error off the screen, mark the profile bad for this pane, respawn the pane (Claude Code resumes its
// session) on the next profile. Everything here is a pure decision; the host reads the screen and respawns.
// It cannot loop: a respawn onto the next profile moves strictly forward in the chain, a respawn onto the next
// key of the same provider is counted, and MAX_FAILOVERS caps the count whatever the host reports.

/// What the screen showed.
pub const FC_NONE : u32 = 0;
pub const FC_RATE_LIMITED : u32 = 1;
pub const FC_NO_BALANCE : u32 = 2;
pub const FC_SUBSCRIPTION : u32 = 3;
pub const FC_LOGIN_REJECTED : u32 = 4;
pub const FC_OTHER : u32 = 5;
/// The provider shed the request: HTTP 529, z.ai code 1305 "service may be temporarily overloaded".
/// Measured 2026-10-20: on the free flash model five of seven z.ai keys answered it at once and one answered 200.
pub const FC_OVERLOADED : u32 = 6;
pub const FC_WORDS : str = "no error,rate limited (429),out of balance,subscription disabled,login rejected (401/403),other error,overloaded (529)";

/// What to do about it.
pub const FA_KEEP : u32 = 0;
pub const FA_RESPAWN_NEXT : u32 = 1;
pub const FA_RESPAWN_KEY : u32 = 2;
pub const FA_GIVE_UP : u32 = 3;
/// The same profile and the next model of its tier (MODELS_SECOND): every key of the provider failed on the
/// model the pane ran. Only pty_logic plan_failover gives it (fo_next_model); fo_action never does.
pub const FA_RESPAWN_MODEL : u32 = 4;

/// At most this many failovers per pane: every key of each free provider on each model of its tier (z.ai 8 keys on
/// 2 models, OpenRouter 8 keys on 3 models: 8 * 5 = 40), then every profile once, and a few spare.
pub const MAX_FAILOVERS : u32 = 48;

/// The index of the first occurrence of needle in hay at or after `from`; hay.len + 1 when absent.
fn find_bytes(hay: []const u8, needle: []const u8, from: usize) -> usize {
    if (needle.len == 0) { return hay.len + 1; }
    var i : usize = from;
    while (i + needle.len <= hay.len) {
        var j : usize = 0;
        while (j < needle.len and hay[i + j] == needle[j]) { j = j + 1; }
        if (j == needle.len) { return i; }
        i = i + 1;
    }
    return hay.len + 1;
}

/// Does needle occur in hay?
pub fn has_bytes(hay: []const u8, needle: []const u8) -> bool {
    return find_bytes(hay, needle, 0) <= hay.len;
}

/// Does the status code occur in hay as a number of its own: not glued to a digit on either side, so "429"
/// does not match "14290 tokens"?
pub fn has_code(hay: []const u8, code: []const u8) -> bool {
    var at : usize = find_bytes(hay, code, 0);
    while (at <= hay.len) {
        var glued : bool = false;
        if (at > 0) {
            if (hay[at - 1] >= 48 and hay[at - 1] <= 57) { glued = true; }
        }
        const e : usize = at + code.len;
        if (e < hay.len) {
            if (hay[e] >= 48 and hay[e] <= 57) { glued = true; }
        }
        if (glued == false) { return true; }
        at = find_bytes(hay, code, at + 1);
    }
    return false;
}

/// The failure class of one screen line, by plain byte matching. The two phrases are specific enough alone;
/// a bare status number counts only on a line that also says "error" (so "Edited 429 lines" is not a 429).
/// "Insufficient balance" (or its code, 1113) wins over 429: the provider sends both for an empty account.
/// An overload (529, code 1305, or the word "overloaded") wins over 429 too: z.ai sends 1305 under either
/// status, and a throttled key rests longer than a busy one. An "API Error" line that matches nothing is
/// FC_OTHER; any other line is FC_NONE.
pub fn classify_line(line: []const u8) -> u32 {
    if (has_bytes(line, "disabled Claude subscription")) { return FC_SUBSCRIPTION; }
    if (has_bytes(line, "Insufficient balance")) { return FC_NO_BALANCE; }
    if (has_bytes(line, "rror") == false) { return FC_NONE; }
    if (has_code(line, "1113")) { return FC_NO_BALANCE; }
    if (has_code(line, "529") or has_code(line, "1305") or has_bytes(line, "verloaded")) { return FC_OVERLOADED; }
    if (has_code(line, "429")) { return FC_RATE_LIMITED; }
    if (has_code(line, "401") or has_code(line, "403")) { return FC_LOGIN_REJECTED; }
    if (has_bytes(line, "API Error")) { return FC_OTHER; }
    return FC_NONE;
}

/// Does `hay` start with `needle`?
pub fn begins_with(hay: []const u8, needle: []const u8) -> bool {
    if (needle.len > hay.len) { return false; }
    var i : usize = 0;
    while (i < needle.len) {
        if (hay[i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// Does this line start the way Claude Code's error rows do?
fn error_start(t: []const u8) -> bool {
    if (begins_with(t, "API Error")) { return true; }
    if (begins_with(t, "Error")) { return true; }
    if (begins_with(t, "Request failed")) { return true; }
    if (begins_with(t, "Your organization has disabled")) { return true; }
    return begins_with(t, "Insufficient balance");
}

/// Is this screen line the error row Claude Code prints? classify_line may be run on it only then, never on
/// the body of the transcript: a diff or a quoted line that shows "Insufficient balance" or "API Error: 429"
/// starts with something else (a +, a quote, a word) and would otherwise make the pane leave a healthy
/// provider. Leading blanks are skipped. A row that says "Retrying" is Claude Code's own retry in flight and
/// the turn is still alive, so for a throttle or an overload the failover waits for the final row. A retry
/// cannot cure an empty account, a disabled subscription or a rejected key, though: z.ai answers an empty
/// account with HTTP 429 and code 1113, Claude Code retries that ten times (minutes), and the retry row is the
/// only row on the screen meanwhile (gHashTag/t27#11284). Such a row counts at once.
pub fn error_row(line: []const u8) -> bool {
    var a : usize = 0;
    while (a < line.len and line[a] == 32) { a = a + 1; }
    const t : []const u8 = line[a .. line.len];
    if (error_start(t) == false) { return false; }
    if (has_bytes(t, "Retrying") == false) { return true; }
    const c : u32 = classify_line(t);
    if (c == FC_RATE_LIMITED and has_code(t, "1302")) { return true; }
    return c == FC_NO_BALANCE or c == FC_SUBSCRIPTION or c == FC_LOGIN_REJECTED;
}

/// The bad mask after a failure of class `class` on profile pr: the profile's provider joins it. A line that
/// is no failure (FC_NONE, FC_OTHER) or a pane with no profile changes nothing.
pub fn fo_bad(class: u32, pr: u32, bad: u32) -> u32 {
    if (class == FC_NONE or class == FC_OTHER) { return bad; }
    if (pr >= PROFILE_COUNT) { return bad; }
    const bit : u32 = PROFILE_PROVIDER[pr];
    if ((bad >> bit) % 2 == 1) { return bad; }
    return bad + (1 << bit);
}

/// The failover decision for a pane whose screen showed `class` while it ran profile pr (PR_NONE = it
/// started without a key, which is where the "disabled Claude subscription access" line comes from).
/// `stored` and `bad` are the provider masks (bad: providers that failed for this pane or their check),
/// `done` the failovers this pane has had, `alt` whether another key of pr's provider is usable now
/// (rotate_pick_except over the keys, the failed one skipped). A throttled (429), overloaded (529), empty
/// (1113) or rejected (401/403) key with another key at hand swaps the key and keeps the profile: the keys
/// are separate accounts (the owner stores several z.ai keys), so one empty key says nothing about the next.
/// Every other failure, and a pane with no key of its provider left to try, leaves the profile for the next
/// one in the chain; when none is left, or the cap is reached, the pane stays as it is.
pub fn fo_action(class: u32, pr: u32, stored: u32, bad: u32, done: u32, alt: bool) -> u32 {
    if (class == FC_NONE or class == FC_OTHER) { return FA_KEEP; }
    if (done >= MAX_FAILOVERS) { return FA_GIVE_UP; }
    if (class != FC_SUBSCRIPTION and alt and pr < PROFILE_COUNT) { return FA_RESPAWN_KEY; }
    if (next_profile(pr, stored, fo_bad(class, pr, bad)) == PR_NONE) { return FA_GIVE_UP; }
    return FA_RESPAWN_NEXT;
}

/// The profile to respawn on for the action fo_action gave: the same one for a key swap, the next one in
/// the chain for FA_RESPAWN_NEXT, PR_NONE when the pane stays.
pub fn fo_target(class: u32, pr: u32, stored: u32, bad: u32, done: u32, alt: bool) -> u32 {
    const act : u32 = fo_action(class, pr, stored, bad, done, alt);
    if (act == FA_RESPAWN_KEY) { return pr; }
    if (act == FA_RESPAWN_NEXT) { return next_profile(pr, stored, fo_bad(class, pr, bad)); }
    return PR_NONE;
}

/// Should a pane that ran model `step` of profile pr move to the next model of the same profile? Yes when
/// the failure is one a key or a model answers (throttled, overloaded, empty, rejected), no key of the
/// provider is left to try on this model (`alt` false), the tier map has a next model (model_left) and the
/// cap is not reached. fo_action has already chosen a key swap when a key was left; this is the step before it
/// leaves the profile.
pub fn fo_next_model(class: u32, pr: u32, step: u32, done: u32, alt: bool) -> bool {
    if (class == FC_NONE or class == FC_OTHER or class == FC_SUBSCRIPTION) { return false; }
    if (alt or done >= MAX_FAILOVERS) { return false; }
    return model_left(pr, step);
}

/// The "why" line for a failover, for the KEYS tab and the pane's title (128 bytes are enough): names the
/// profile, the failure and the move. No key value, ever.
pub fn fo_why(class: u32, pr: u32, act: u32, nxt: u32, done: u32, out: []u8) -> usize {
    if (act == FA_KEEP) { return put_bytes(out, 0, "claude: no provider error, the pane stays"); }
    var tmp : [32]u8 = undefined;
    var n : usize = put_bytes(out, 0, "claude: ");
    if (pr < PROFILE_COUNT) {
        const l : usize = profile_name(pr, tmp[0..32]);
        n = put_bytes(out, n, tmp[0..l]);
    } else {
        n = put_bytes(out, n, "no profile");
    }
    n = put_bytes(out, n, " ");
    const w : usize = csv_field(FC_WORDS, class, tmp[0..32]);
    n = put_bytes(out, n, tmp[0..w]);
    if (act == FA_RESPAWN_KEY) { return put_bytes(out, n, ", same profile with the next key"); }
    if (act == FA_RESPAWN_MODEL) { return put_bytes(out, n, ", every key tried, same profile on the next model"); }
    if (act == FA_RESPAWN_NEXT) {
        n = put_bytes(out, n, ", respawn on ");
        const m : usize = profile_name(nxt, tmp[0..32]);
        return put_bytes(out, n, tmp[0..m]);
    }
    if (done >= MAX_FAILOVERS) { return put_bytes(out, n, ", failover limit reached, the pane stays"); }
    return put_bytes(out, n, ", no profile left in the chain, the pane stays");
}

/// How long a key rests after it caused a failure of class `class` (seconds): a throttled key 30 s, an
/// overloaded one 60 s (the service is busy, not the key, but the same key would meet the same queue), a key
/// with no balance 10 min, a rejected key an hour; a failure that names no key rests none.
pub const OVERLOAD_COOLDOWN_S : u64 = 60;
pub const BALANCE_REST_S : u64 = 600;
pub const REJECT_REST_S : u64 = 3600;

pub fn key_rest_after(class: u32) -> u64 {
    if (class == FC_RATE_LIMITED) { return RATE_COOLDOWN_S; }
    if (class == FC_OVERLOADED) { return OVERLOAD_COOLDOWN_S; }
    if (class == FC_NO_BALANCE) { return BALANCE_REST_S; }
    if (class == FC_LOGIN_REJECTED) { return REJECT_REST_S; }
    return 0;
}

/// The rest_until of a key slot that holds no key: no clock reaches it, so rotation never picks it.
pub const KEY_NEVER : u64 = 99999999999;

/// The key a new pane starts with: rotate_pick_except, and when every key is resting, the one whose rest ends
/// first (a pane with a resting key is better than a pane with none). Slots that hold no key carry KEY_NEVER
/// and are never taken. Returns n when the provider holds no usable key but the skipped one.
pub fn rotate_pick_soft(n: u32, skip: u32, last_used: []const u64, rest_until: []const u64, now: u64) -> u32 {
    const k : u32 = rotate_pick_except(n, skip, last_used, rest_until, now);
    if (k != n) { return k; }
    var best : u32 = n;
    var i : u32 = 0;
    while (i < n) {
        if (rest_until[i] < KEY_NEVER and i != skip) {
            if (best == n) {
                best = i;
            } else if (rest_until[i] < rest_until[best]) {
                best = i;
            }
        }
        i = i + 1;
    }
    return best;
}

/// z.ai has no cheap GET that proves a key opens the Anthropic-protocol route, so its check is one
/// one-token message to the flash model (free); the answer is read by status only.
pub fn probe_post(p: u32) -> bool {
    return p == P_ZAI;
}

/// Providers whose route wants the anthropic-version header.
pub fn probe_needs_version(p: u32) -> bool {
    return p == P_ANTHROPIC or p == P_ZAI;
}

pub fn probe_body(p: u32, out: []u8) -> usize {
    if (p != P_ZAI) { return 0; }
    var model : [64]u8 = undefined;
    const ml : usize = tier_model(PR_ZAI, TI_DEFAULT, model[0..64]);
    var n : usize = put_bytes(out, 0, "{\"model\":\"");
    n = put_bytes(out, n, model[0..ml]);
    return put_bytes(out, n, "\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}");
}

test the_free_zai_profile_comes_first {
    assert pick_profile(17, 0) == PR_ZAI;
    assert pick_profile(1, 0) == PR_ANTHROPIC;
    assert pick_profile(16, 0) == PR_ZAI;
    assert pick_profile(0, 0) == PR_NONE;
    assert pick_profile(2, 0) == PR_NONE;
}

test a_failed_key_hands_the_pane_to_the_next_profile {
    assert pick_profile(17, 16) == PR_ANTHROPIC;
    assert pick_profile(17, 1) == PR_ZAI;
    assert pick_profile(17, 17) == PR_NONE;
    var st : [9]u32 = [1, 0, 0, 0, 3, 0, 0, 0, 0];
