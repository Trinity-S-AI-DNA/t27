test every_tier_of_the_zai_profile_names_the_flash_model {
    var o : [64]u8 = undefined;
    var ti : u32 = 0;
    while (ti < TIER_COUNT) {
        assert tier_model(PR_ZAI, ti, o[0..64]) == 13;
        assert o[0] == 103 and o[12] == 104;
        ti = ti + 1;
    }
    assert tier_model(PR_ZAI, TIER_COUNT, o[0..64]) == 0;
    assert tier_model(PR_NONE, TI_DEFAULT, o[0..64]) == 0;
}

/// The model of tier ti at step as text, for an assertion (64 bytes are enough).
fn t_model(pr: u32, ti: u32, step: u32, o: []u8) -> usize {
    return tier_model_step(pr, ti, step, o);
}

test the_default_z_ai_model_is_the_free_flash_that_answered_on_every_key {
    // measured 2026-10-20T08:49Z: glm-4.5-flash answered 200 on 7 of 7 keys, glm-4.7-flash on 2 of 7 (529 on 5)
    var o : [64]u8 = undefined;
    var ti : u32 = 0;
    while (ti < TIER_COUNT) {
        const n : usize = t_model(PR_ZAI, ti, 0, o[0..64]);
        assert n == 13;
        assert begins_with(o[0..n], "glm-4.5-flash");
        ti = ti + 1;
    }
    const m : usize = tier_model(PR_ZAI, TI_DEFAULT, o[0..64]);
    assert m == 13 and begins_with(o[0..m], "glm-4.5-flash");
    // the second model of the tier, on every tier, only at step 1
    ti = 0;
    while (ti < TIER_COUNT) {
        const k : usize = t_model(PR_ZAI, ti, 1, o[0..64]);
        assert k == 13;
        assert begins_with(o[0..k], "glm-4.7-flash");
        ti = ti + 1;
    }
    // no paid id is in the map at any step or tier
    var pr : u32 = 0;
    while (pr < PROFILE_COUNT) {
        var st : u32 = 0;
        while (st < MODEL_STEPS) {
            var t : u32 = 0;
            while (t < TIER_COUNT) {
                const l : usize = t_model(pr, t, st, o[0..64]);
                assert has_bytes(o[0..l], "glm-5.2") == false;
                t = t + 1;
            }
            st = st + 1;
        }
        pr = pr + 1;
    }
    assert t_model(PR_ZAI, TI_DEFAULT, MODEL_STEPS, o[0..64]) == 0;
    assert t_model(PR_ANTHROPIC, TI_DEFAULT, 1, o[0..64]) == 0;
    assert t_model(PR_NONE, TI_DEFAULT, 0, o[0..64]) == 0;
}

test a_profile_knows_how_many_models_its_tier_holds {
    assert profile_models(PR_ZAI) == 2;
    assert profile_models(PR_ANTHROPIC) == 1;
    assert profile_models(PR_OPENROUTER) == 2;
    assert profile_models(PR_OLLAMA_CLOUD) == 1;
    assert profile_models(PR_NONE) == 0;
    assert model_left(PR_ZAI, 0);
    assert model_left(PR_ZAI, 1) == false;
    assert model_left(PR_ANTHROPIC, 0) == false;
    assert model_left(PR_OPENROUTER, 0);
    assert model_left(PR_OPENROUTER, 1) == false;
    assert model_left(PR_OPENROUTER, 2) == false;
    assert model_left(PR_NONE, 0) == false;
    assert MODEL_STEPS == 3;
    assert csv_fields(MODELS_SECOND) == PROFILE_COUNT;
    assert csv_fields(MODELS_THIRD) == PROFILE_COUNT;
    // a step is empty from the first gap on: no profile names a third model without a second
    var pr : u32 = 0;
    var tmp : [64]u8 = undefined;
    while (pr < PROFILE_COUNT) {
        if (csv_field(MODELS_THIRD, pr, tmp[0..64]) > 0) { assert csv_field(MODELS_SECOND, pr, tmp[0..64]) > 0; }
        pr = pr + 1;
    }
}

test the_tier_variables_of_a_pane_name_the_model_of_its_step {
    var o : [64]u8 = undefined;
    // zai: variable 2 is ANTHROPIC_MODEL; every tier variable follows the pane's step
    const a : usize = profile_var_text_step(PR_ZAI, 2, 0, o[0..64]);
    assert a == 13 and begins_with(o[0..a], "glm-4.5-flash");
    const b : usize = profile_var_text_step(PR_ZAI, 6, 1, o[0..64]);
    assert b == 13 and begins_with(o[0..b], "glm-4.7-flash");
    const c : usize = profile_var_text(PR_ZAI, 2, o[0..64]);
    assert c == 13 and begins_with(o[0..c], "glm-4.5-flash");
    // the base URL does not depend on the step
    assert profile_var_text_step(PR_ZAI, 0, 1, o[0..64]) == 30;
}

test a_restored_or_failed_over_pane_runs_the_model_its_profile_serves_never_the_saved_one {
    var o : [64]u8 = undefined;
    // the record of the live test said glm-5.2: every z.ai key answers 1113 for it, so it is not used
    var n : usize = model_for_profile(PR_ZAI, 0, "glm-5.2", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.5-flash");
    n = model_for_profile(PR_ZAI, 0, "glm-4.7-flash", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.5-flash");
    n = model_for_profile(PR_ZAI, 0, "", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.5-flash");
    // the next model of the tier, once every key failed on the first
    n = model_for_profile(PR_ZAI, 1, "glm-4.5-flash", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-4.7-flash");
    n = model_for_profile(PR_OLLAMA_CLOUD, 0, "glm-5.2", o[0..64]);
    assert n == 13 and begins_with(o[0..n], "glm-5.3-flash");
    // a profile with no model of its own keeps a saved model of Anthropic's, and drops one a gateway serves
    n = model_for_profile(PR_ANTHROPIC, 0, "claude-opus-5-5", o[0..64]);
    assert n == 15 and begins_with(o[0..n], "claude-opus-5-5");
    n = model_for_profile(PR_ANTHROPIC, 0, "glm-4.5-flash", o[0..64]);
    assert n == 0;
    n = model_for_profile(PR_ANTHROPIC, 0, "glm-4.7-flash", o[0..64]);
    assert n == 0;
    n = model_for_profile(PR_ANTHROPIC, 0, "", o[0..64]);
    assert n == 0;
    // OpenRouter's free tier names a model at each of its three steps, whatever the pane carried over
    n = model_for_profile(PR_OPENROUTER, 0, "glm-5.3-flash", o[0..64]);
    assert n == 31 and begins_with(o[0..n], "minimax/minimax-m3.1-flash:free");
    n = model_for_profile(PR_OPENROUTER, 1, "glm-4.7-flash", o[0..64]);
    assert n == 33 and begins_with(o[0..n], "nvidia/nemotron-3.5-super-vl:free");
    // the unverified lightning id is no third step any more
    n = model_for_profile(PR_OPENROUTER, 2, "", o[0..64]);
    assert n == 0;
    // a free id of OpenRouter's has no place on the Anthropic API a pane fails over to after it
    n = model_for_profile(PR_ANTHROPIC, 0, "minimax/minimax-m3.1-flash:free", o[0..64]);
    assert n == 0;
    // no profile (a pane that has no key): nothing to move it to, the saved model stays
    n = model_for_profile(PR_NONE, 0, "glm-5.2", o[0..64]);
    assert n == 7 and begins_with(o[0..n], "glm-5.2");
}

