// SPDX-License-Identifier: Apache-2.0
// specs/t27os/layout_hardening.t27 -- T27OS autonomous layout hardening.
// One layout resolver drives draw, hit-test, and native clipping.
// Structural invariants prevent overlap and stale rects.
// Part of [EPIC] T27OS autonomous layout hardening (#13186). Closes #13186.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::layout_hardening {

    pub const MODULE : str = "t27os_layout_hardening";
    pub const SURFACE : str = "layout";

    // ---- Layout resolver ---------------------------------------------------
    pub struct Resolver {
        drives_draw : bool,
        drives_hit_test : bool,
        drives_clipping : bool,
    };

    pub struct Rect {
        x : u32,
        y : u32,
        w : u32,
        h : u32,
        stale : bool,
    };

    // One resolver drives draw, hit-test, and native clipping.
    pub fn resolver_is_unified(r: Resolver) -> bool {
        return r.drives_draw && r.drives_hit_test && r.drives_clipping;
    }

    // Structural invariants prevent overlap and stale rects.
    pub fn rects_do_not_overlap(a: Rect, b: Rect) -> bool {
        return a.x + a.w <= b.x || b.x + b.w <= a.x
            || a.y + a.h <= b.y || b.y + b.h <= a.y;
    }

    pub fn rect_is_fresh(r: Rect) -> bool {
        return !r.stale;
    }

    // PR automation merges only fully green, policy-compliant PRs.
    pub fn pr_mergeable(green: bool, policy_compliant: bool) -> bool {
        return green && policy_compliant;
    }

    // Cross-lane blockers are attributed, not silently edited.
    pub fn blocker_attributed(has_owner: bool, named_issue: bool) -> bool {
        return has_owner && named_issue;
    }

    // ---- Tests ------------------------------------------------------------
    test "one resolver drives draw, hit-test, and clipping" {
        assert(resolver_is_unified(Resolver {
            drives_draw: true, drives_hit_test: true, drives_clipping: true
        }));
        assert(!resolver_is_unified(Resolver {
            drives_draw: true, drives_hit_test: false, drives_clipping: true
        }));
    }

    test "structural invariants prevent overlap and stale rects" {
        assert(rects_do_not_overlap(Rect { x: 0, y: 0, w: 10, h: 10, stale: false },
                                      Rect { x: 10, y: 0, w: 10, h: 10, stale: false }));
        assert(!rects_do_not_overlap(Rect { x: 0, y: 0, w: 20, h: 20, stale: false },
                                     Rect { x: 5, y: 5, w: 20, h: 20, stale: false }));
        assert(rect_is_fresh(Rect { x: 0, y: 0, w: 10, h: 10, stale: false }));
        assert(!rect_is_fresh(Rect { x: 0, y: 0, w: 10, h: 10, stale: true }));
    }

    test "PR automation merges only green, policy-compliant PRs" {
        assert(pr_mergeable(true, true));
        assert(!pr_mergeable(false, true));
        assert(!pr_mergeable(true, false));
        assert(!pr_mergeable(false, false));
    }

    test "cross-lane blockers are attributed" {
        assert(blocker_attributed(true, true));
        assert(!blocker_attributed(false, true));
        assert(!blocker_attributed(true, false));
        assert(!blocker_attributed(false, false));
    }

    invariant resolver_is_unified_invariant {
        assert resolver_is_unified(Resolver {
            drives_draw: true, drives_hit_test: true, drives_clipping: true
        });
    }

    invariant stale_rect_is_not_fresh {
        assert !rect_is_fresh(Rect { x: 0, y: 0, w: 1, h: 1, stale: true });
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
