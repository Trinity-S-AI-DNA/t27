// SPDX-License-Identifier: Apache-2.0
// specs/t27os/video_brand.t27 -- the brand contract for a T27OS blog video.
// One contract for every new video. It decides frame, palette role, type, kit
// allowlist, formula admission, the end card, and that the window stays shut.
// It does not draw, and it does not open glass_window.t27.
//
// Homes already exist. This file points at them and does not keep a second copy:
//   palette and type scale    specs/t27f/vf_theme.t27  (brand rules: specs/t27f/vf_brand.t27)
//   white triangle            specs/t27f/petal_menu.t27  (centre_fill, centre_hit)
//   formula motion            specs/t27f/formula_orbit.t27  (not restated here)
//   formula rows              specs/t27f/formula_table.t27
//                             generated from specs/physics/formula_registry.t27
//                             and specs/physics/pellis-formulas.t27
//   kit components            specs/t27f/ui_kit.t27  (plan IR: specs/t27f/ui_plan.t27)
//   wide and tall frames      specs/t27f/reel_factory.t27 FMT_REEL_WIDE / FMT_REEL_TALL
//   window shut               specs/automation/t27_plan.t27 window_shell
//   course that may use this  specs/course/fpga_course_v2.t27
//
// The live channel title spells the three in S3AI as a superscript. This file
// keeps the ASCII form Trinity S3AI. YouTube is not changed from here.
// A title character cap is a reading rule of this contract, not a glyph measurement.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::video_brand {

    use automation::t27_plan::window_shell;
    use automation::t27_plan::OUT_BLOCKED;
    use automation::t27_plan::GLASS_OPEN;
    use automation::t27_plan::KIT_PRESENT;
    use automation::t27_plan::KIT_REWRITTEN;
    use t27f::vf_theme::TH_T27;
    use t27f::vf_theme::TH_BG;
    use t27f::vf_theme::TH_TEXT;
    use t27f::vf_theme::TH_FONT_DISPLAY;
    use t27f::vf_theme::TH_FONT_MONO;
    use t27f::vf_theme::TH_FONT_W_HI;
    use t27f::vf_theme::TH_FONT_W_LO;
    use t27f::vf_theme::TH_FONT_STEPS;
    use t27f::vf_theme::TH_BP_PHONE;
    use t27f::vf_theme::TH_BP_PHONE_MAX;
    use t27f::vf_theme::TH_BODY_MIN;
    use t27f::vf_theme::th_color;
    use t27f::vf_theme::th_luma_gap;
    use t27f::vf_theme::th_font_name;
    use t27f::vf_theme::th_font_milli_px;
    use t27f::vf_theme::th_bp;
    use t27f::vf_theme::th_body_milli_px;
    use t27f::petal_menu::PETAL_COUNT;
    use t27f::petal_menu::PETAL_NONE;
    use t27f::petal_menu::RGB_WHITE;
    use t27f::petal_menu::IDLE_RGB;
    use t27f::petal_menu::BOX_CX;
    use t27f::petal_menu::centre_fill;
    use t27f::petal_menu::centre_hit;
    use t27f::petal_menu::fill;
    use t27f::petal_menu::hit;
    use t27f::formula_table::FORMULA_COUNT;
    use t27f::formula_table::ROW_COUNT;
    use t27f::formula_table::TAG_VERIFIED;
    use t27f::formula_table::tag_of;
    use t27f::ui_kit::KIT_COMPONENT_COUNT;
    use t27f::ui_kit::KV_PRIMARY;
    use t27f::ui_kit::KS_DEFAULT;
    use t27f::ui_kit::kit_button;
    use t27f::ui_kit::kit_card;
    use t27f::ui_kit::kit_input;
    use t27f::ui_kit::kit_badge;
    use t27f::ui_kit::kit_nav;
    use t27f::ui_kit::kit_table;
    use t27f::ui_kit::kit_node_count;
    use t27f::ui_kit::kit_parents_first;
    use t27f::reel_factory::FMT_REEL_WIDE;
    use t27f::reel_factory::FMT_REEL_TALL;
    use t27f::reel_factory::FMT_W;
    use t27f::reel_factory::FMT_H;

    pub const VBRAND_ID : str = "T27OS_VIDEO_BRAND_V1";
    pub const VBRAND_HANDLE : str = "@t27_lang";
    pub const VBRAND_CHANNEL : str = "Dmitrii Vasilev | TRI-27 - Trinity S3AI DNA";
    pub const VBRAND_YOUTUBE_MUTABLE : bool = false;

    pub const VBRAND_NOISE : bool = false;
    pub const VBRAND_SECOND_PALETTE : bool = false;
    pub const VBRAND_MATTE : bool = true;
    pub const VBRAND_MOTION_HERE : bool = false;

    pub const VBRAND_THEME_SPEC : str = "specs/t27f/vf_theme.t27";
    pub const VBRAND_BRAND_SPEC : str = "specs/t27f/vf_brand.t27";
    pub const VBRAND_MARK_SPEC : str = "specs/t27f/petal_menu.t27";
    pub const VBRAND_MOTION_SPEC : str = "specs/t27f/formula_orbit.t27";
    pub const VBRAND_FORMULA_SPEC : str = "specs/physics/formula_registry.t27";
    pub const VBRAND_PELLIS_SPEC : str = "specs/physics/pellis-formulas.t27";
    pub const VBRAND_TABLE_SPEC : str = "specs/t27f/formula_table.t27";
    pub const VBRAND_KIT_SPEC : str = "specs/t27f/ui_kit.t27";
    pub const VBRAND_PLAN_SPEC : str = "specs/t27f/ui_plan.t27";
    pub const VBRAND_FRAME_SPEC : str = "specs/t27f/reel_factory.t27";
    pub const VBRAND_WINDOW_SPEC : str = "specs/automation/t27_plan.t27";
    pub const VBRAND_COURSE_SPEC : str = "specs/course/fpga_course_v2.t27";

    // Reading caps for one screen. Chosen for a phone, not measured from glyphs.
    pub const VBRAND_TITLE_CHARS : u32 = 32;
    pub const VBRAND_LINE_CHARS : u32 = 42;
    pub const VBRAND_IDEAS : u32 = 1;

    // Allowlist index, in the order of the six kit builders. Not a second kit.
    pub const VBRAND_KIT_BUTTON : u32 = 0;
    pub const VBRAND_KIT_CARD : u32 = 1;
    pub const VBRAND_KIT_INPUT : u32 = 2;
    pub const VBRAND_KIT_BADGE : u32 = 3;
    pub const VBRAND_KIT_NAV : u32 = 4;
    pub const VBRAND_KIT_TABLE : u32 = 5;
    pub const VBRAND_KIT_COUNT : u32 = 6;

    // The wide frame unless a short vertical cut was asked for.
    pub fn vbrand_frame_w(vertical: bool) -> u32 {
        if (vertical) { return FMT_W[FMT_REEL_TALL]; }
        return FMT_W[FMT_REEL_WIDE];
    }

    pub fn vbrand_frame_h(vertical: bool) -> u32 {
        if (vertical) { return FMT_H[FMT_REEL_TALL]; }
        return FMT_H[FMT_REEL_WIDE];
    }

    /// 16:9 across, 9:16 only when vertical was asked for.
    pub fn vbrand_aspect_ok(vertical: bool) -> bool {
        let w : u32 = vbrand_frame_w(vertical);
        let h : u32 = vbrand_frame_h(vertical);
        if (w == 0 || h == 0) { return false; }
        if (vertical) { return w * 16 == h * 9; }
        return w * 9 == h * 16;
    }

    pub fn vbrand_theme() -> u32 { return TH_T27; }
    pub fn vbrand_ground_role() -> u32 { return TH_BG; }
    pub fn vbrand_ink_role() -> u32 { return TH_TEXT; }

    /// Page ground and ink are the theme roles. No second palette, no gray noise.
    pub fn vbrand_palette_ok() -> bool {
        if (VBRAND_NOISE || VBRAND_SECOND_PALETTE || !VBRAND_MATTE) { return false; }
        if (VBRAND_MOTION_HERE) { return false; }
        if (vbrand_theme() != TH_T27) { return false; }
        if (vbrand_ground_role() != TH_BG || vbrand_ink_role() != TH_TEXT) { return false; }
        return th_luma_gap(th_color(TH_T27, TH_TEXT), th_color(TH_T27, TH_BG)) > 0;
    }

    pub fn vbrand_noise_refused(noise: bool) -> bool {
        if (!vbrand_palette_ok()) { return true; }
        return noise;
    }

    /// The accent mark is the white centre triangle of petal_menu, not a new colour.
    pub fn vbrand_mark_ok() -> bool {
        if (PETAL_COUNT != 27) { return false; }
        if (RGB_WHITE != IDLE_RGB) { return false; }
        if (centre_fill() != fill(0, PETAL_NONE, 0)) { return false; }
        // Same probe the petal_menu centre-button test uses. The hole is not a petal.
        if (!centre_hit(BOX_CX, 240000)) { return false; }
        return hit(BOX_CX, 240000) == PETAL_NONE;
    }

    /// A row may appear only when formula_table tags it VERIFIED. Text stays in that table.
    pub fn vbrand_row_ok(i: u32) -> bool {
        if (i >= ROW_COUNT) { return false; }
        return tag_of(i) == TAG_VERIFIED;
    }

    pub fn vbrand_scale_grows() -> bool {
        var s : u32 = 0;
        while (s + 1 < TH_FONT_STEPS) {
            if (th_font_milli_px(s + 1) <= th_font_milli_px(s)) { return false; }
            s = s + 1;
        }
        return true;
    }

    pub fn vbrand_title_weight() -> u32 { return TH_FONT_W_HI[TH_FONT_DISPLAY]; }
    pub fn vbrand_body_weight() -> u32 { return TH_FONT_W_LO[TH_FONT_DISPLAY]; }

    pub fn vbrand_title_larger(title_step: u32, body_step: u32) -> bool {
        if (title_step >= TH_FONT_STEPS || body_step >= TH_FONT_STEPS) { return false; }
        return th_font_milli_px(title_step) > th_font_milli_px(body_step);
    }

    pub fn vbrand_line_ok(chars: u32, title: bool) -> bool {
        if (chars == 0) { return false; }
        if (title) { return chars <= VBRAND_TITLE_CHARS; }
        return chars <= VBRAND_LINE_CHARS;
    }

    pub fn vbrand_phone_ok() -> bool {
        if (th_bp(TH_BP_PHONE_MAX) != TH_BP_PHONE) { return false; }
        if (th_body_milli_px(TH_BP_PHONE_MAX) < TH_BODY_MIN) { return false; }
        if (vbrand_title_weight() <= vbrand_body_weight()) { return false; }
        return th_font_name(TH_FONT_DISPLAY) != th_font_name(TH_FONT_MONO);
    }

    pub fn vbrand_type_ok(title_step: u32, body_step: u32, title_chars: u32, line_chars: u32) -> bool {
        if (!vbrand_scale_grows() || !vbrand_phone_ok()) { return false; }
        if (!vbrand_title_larger(title_step, body_step)) { return false; }
        if (!vbrand_line_ok(title_chars, true)) { return false; }
        return vbrand_line_ok(line_chars, false);
    }

    pub fn vbrand_screen_ok(ideas: u32) -> bool {
        return ideas == VBRAND_IDEAS;
    }

    pub fn vbrand_kit_allowed(id: u32) -> bool {
        if (VBRAND_KIT_COUNT != KIT_COMPONENT_COUNT) { return false; }
        return id < VBRAND_KIT_COUNT;
    }

    pub fn vbrand_kit_built() -> bool {
        if (!KIT_PRESENT || KIT_REWRITTEN) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_BUTTON)) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_CARD)) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_INPUT)) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_BADGE)) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_NAV)) { return false; }
        if (!vbrand_kit_allowed(VBRAND_KIT_TABLE)) { return false; }
        let b = kit_button(KV_PRIMARY, KS_DEFAULT);
        let c = kit_card(KV_PRIMARY, KS_DEFAULT);
        let n = kit_input(KV_PRIMARY, KS_DEFAULT);
        let g = kit_badge(KV_PRIMARY);
        let v = kit_nav(0);
        let t = kit_table(1);
        if (kit_node_count(b) == 0 || !kit_parents_first(b)) { return false; }
        if (kit_node_count(c) == 0 || !kit_parents_first(c)) { return false; }
        if (kit_node_count(n) == 0 || !kit_parents_first(n)) { return false; }
        if (kit_node_count(g) == 0 || !kit_parents_first(g)) { return false; }
        if (kit_node_count(v) == 0 || !kit_parents_first(v)) { return false; }
        if (kit_node_count(t) == 0 || !kit_parents_first(t)) { return false; }
        return true;
    }

    pub fn vbrand_handle_ok(handle: str) -> bool {
        if (VBRAND_YOUTUBE_MUTABLE) { return false; }
        return handle == VBRAND_HANDLE;
    }

    /// End card: the triangle, the handle, and a call to action.
    pub fn vbrand_end_ok(has_mark: bool, handle: str, has_cta: bool) -> bool {
        if (!has_mark || !has_cta || !vbrand_mark_ok()) { return false; }
        return vbrand_handle_ok(handle);
    }

    /// Asking does not open the window. Both branches call the plan gate.
    pub fn vbrand_window() -> u8 { return window_shell(); }

    pub fn vbrand_window_ask(ask: bool) -> u8 {
        if (ask) { return window_shell(); }
        return window_shell();
    }

    test "the wide frame is 16:9 and the tall frame is only the vertical cut" {
        assert(vbrand_aspect_ok(false));
        assert(vbrand_aspect_ok(true));
        assert(vbrand_frame_w(false) > vbrand_frame_h(false));
        assert(vbrand_frame_h(true) > vbrand_frame_w(true));
        assert(vbrand_frame_w(false) == FMT_W[FMT_REEL_WIDE]);
        assert(vbrand_frame_h(false) == FMT_H[FMT_REEL_WIDE]);
        assert(vbrand_frame_w(true) == FMT_W[FMT_REEL_TALL]);
        assert(vbrand_frame_h(true) == FMT_H[FMT_REEL_TALL]);
    }

    test "the page uses the theme ground, and a noise layer is refused" {
        assert(vbrand_palette_ok());
        assert(vbrand_noise_refused(true));
        assert(!vbrand_noise_refused(false));
        assert(!VBRAND_SECOND_PALETTE);
        assert(!VBRAND_NOISE);
        assert(VBRAND_MATTE);
        assert(!VBRAND_MOTION_HERE);
        assert(VBRAND_MOTION_SPEC == "specs/t27f/formula_orbit.t27");
        assert(VBRAND_THEME_SPEC == "specs/t27f/vf_theme.t27");
        assert(th_color(vbrand_theme(), vbrand_ground_role()) == th_color(TH_T27, TH_BG));
        assert(th_color(vbrand_theme(), vbrand_ink_role()) == th_color(TH_T27, TH_TEXT));
    }

    test "the accent mark is the white centre triangle" {
        assert(vbrand_mark_ok());
        assert(VBRAND_MARK_SPEC == "specs/t27f/petal_menu.t27");
        assert(PETAL_COUNT == 27);
    }

    test "only a verified formula row may be shown" {
        var i : u32 = 0;
        var ok : u32 = 0;
        while (i < FORMULA_COUNT) {
            if (vbrand_row_ok(i)) { ok = ok + 1; }
            i = i + 1;
        }
        assert(ok == FORMULA_COUNT);
        assert(!vbrand_row_ok(FORMULA_COUNT));
        assert(!vbrand_row_ok(ROW_COUNT));
        assert(!vbrand_row_ok(ROW_COUNT + 1));
        assert(VBRAND_FORMULA_SPEC == "specs/physics/formula_registry.t27");
        assert(VBRAND_PELLIS_SPEC == "specs/physics/pellis-formulas.t27");
        assert(VBRAND_TABLE_SPEC == "specs/t27f/formula_table.t27");
    }

    test "titles are large, lines are short, and a phone width still reads" {
        assert(vbrand_scale_grows());
        assert(vbrand_phone_ok());
        assert(vbrand_type_ok(1, 0, VBRAND_TITLE_CHARS, VBRAND_LINE_CHARS));
        assert(!vbrand_type_ok(0, 0, 8, 8));
        assert(!vbrand_type_ok(1, 0, 0, 8));
        assert(!vbrand_line_ok(VBRAND_TITLE_CHARS + 1, true));
        assert(vbrand_line_ok(VBRAND_TITLE_CHARS, true));
        assert(!vbrand_line_ok(VBRAND_LINE_CHARS + 1, false));
        assert(vbrand_line_ok(VBRAND_LINE_CHARS, false));
        assert(th_font_name(TH_FONT_DISPLAY) != th_font_name(TH_FONT_MONO));
        assert(VBRAND_BRAND_SPEC == "specs/t27f/vf_brand.t27");
    }

    test "one screen holds one idea, and the kit allowlist is the six builders" {
        assert(vbrand_screen_ok(1));
        assert(!vbrand_screen_ok(0));
        assert(!vbrand_screen_ok(2));
        assert(vbrand_kit_built());
        assert(!vbrand_kit_allowed(VBRAND_KIT_COUNT));
        assert(!vbrand_kit_allowed(255));
        assert(VBRAND_KIT_SPEC == "specs/t27f/ui_kit.t27");
        assert(VBRAND_PLAN_SPEC == "specs/t27f/ui_plan.t27");
        assert(KIT_PRESENT);
        assert(!KIT_REWRITTEN);
    }

    test "the end card names the handle and the window stays shut" {
        assert(VBRAND_ID == "T27OS_VIDEO_BRAND_V1");
        assert(VBRAND_CHANNEL == "Dmitrii Vasilev | TRI-27 - Trinity S3AI DNA");
        assert(vbrand_handle_ok("@t27_lang"));
        assert(!vbrand_handle_ok("@other"));
        assert(vbrand_end_ok(true, "@t27_lang", true));
        assert(!vbrand_end_ok(false, "@t27_lang", true));
        assert(!vbrand_end_ok(true, "@t27_lang", false));
        assert(!vbrand_end_ok(true, "@other", true));
        assert(!VBRAND_YOUTUBE_MUTABLE);
        assert(vbrand_window() == OUT_BLOCKED);
        assert(vbrand_window_ask(true) == OUT_BLOCKED);
        assert(vbrand_window_ask(false) == OUT_BLOCKED);
        assert(!GLASS_OPEN);
        assert(VBRAND_WINDOW_SPEC == "specs/automation/t27_plan.t27");
        assert(VBRAND_COURSE_SPEC == "specs/course/fpga_course_v2.t27");
    }

    invariant the_video_brand_leaves_the_window_shut {
        assert vbrand_window() == OUT_BLOCKED;
        assert vbrand_window_ask(true) == OUT_BLOCKED;
        assert GLASS_OPEN == false;
        assert KIT_REWRITTEN == false;
    }

    invariant a_video_does_not_grow_a_second_palette {
        assert VBRAND_SECOND_PALETTE == false;
        assert VBRAND_NOISE == false;
        assert VBRAND_MOTION_HERE == false;
        assert VBRAND_YOUTUBE_MUTABLE == false;
        assert vbrand_palette_ok() == true;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
