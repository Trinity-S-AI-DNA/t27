// SPDX-License-Identifier: Apache-2.0
; specs/t27os/video_brand.t27 -- T27OS_VIDEO_BRAND_V1, the reusable contract for every new
; T27 OS blog video. Screens that use it live in specs/t27os/video_templates.t27.
; The window shell stays blocked: window_shell() is "blocked" and GLASS_OPEN is false.
; This module does not open glass_window.t27 and does not draw a second palette.
; Background is the dark-theme ground already in specs/t27f/vf_theme.t27 (vf_fill of
; THEME_DARK and VF_NONE). No noise, no second swatch.
; Accent is the white Trinity triangle: the same white as petal_menu RGB_WHITE and the
; dark-theme label. The triangle geometry stays in specs/t27f/petal_menu.t27.
; Frame size is the content factory's wide reel (16:9). The tall reel (9:16) is used
; only when a vertical cut is requested. YouTube moving already maps to the wide reel
; in specs/claw/social_visuals.t27; this module reads that, it does not copy a table.
; UI kit builders are the eight public builders of specs/t27f/ui_kit.t27, named here
; and built in the templates module. Formulas stay in formula_registry and pellis-formulas.
; Nothing here is posted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVideoBrand;

use t27f::ui_plan::THEME_DARK;
use t27f::visual_factory_contract::VF_NONE;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::vf_theme::vf_fill;
use t27f::vf_theme::vf_label;
use t27f::vf_theme::th_font_px;
use t27f::vf_theme::TH_BP_PHONE_MAX;
use t27f::vf_theme::th_body_milli_px;
use t27f::vf_theme::th_color;
use t27f::vf_theme::TH_PAPER;
use t27f::vf_theme::TH_BG;
use t27f::vf_theme::TH_ERROR_RGB;
use t27f::petal_menu::RGB_WHITE;
use t27f::reel_factory::FMT_W;
use t27f::reel_factory::FMT_H;
use t27f::reel_factory::FMT_REEL_WIDE;
use t27f::reel_factory::FMT_REEL_TALL;
use claw::social_visuals::pick_format;
use claw::social_visuals::CH_YOUTUBE;
use claw::social_visuals::KIND_MOVING;

pub const T27OS_VIDEO_BRAND_V1 : u32 = 1;

; The shell is not opened by a blog video. There is no setter.
pub const GLASS_OPEN : bool = false;

pub fn window_shell() -> str {
    return "blocked";
}

; Dark-theme ground. One flat fill. GROUND_NOISE false means no gray noise.
pub const GROUND_NOISE : bool = false;

pub fn brand_bg() -> u32 {
    return vf_fill(THEME_DARK, VF_NONE);
}

pub fn second_palette() -> bool {
    return false;
}

pub fn accent_rgb() -> u32 {
    return vf_label(THEME_DARK, VF_TEXT);
}

pub fn accent_is_white_triangle() -> bool {
    return accent_rgb() == RGB_WHITE;
}

; f5 on the theme type scale (TH_FONT_REM index 8). Scaled up to the frame so the
; same step is a large title on 16:9 and still at least body size at phone width.
pub const TITLE_STEP : u32 = 8;

pub fn frame_title_px(frame_w: u32) -> u32 {
    if TH_BP_PHONE_MAX == 0 {
        return 0;
    }
    return th_font_px(TITLE_STEP) * frame_w / TH_BP_PHONE_MAX;
}

; Advance is assumed at half an em (not measured from Outfit). A line that fits
; that advance across the frame is the short-line cap.
pub fn line_cap(frame_w: u32) -> u32 {
    let px : u32 = frame_title_px(frame_w);
    if px < 2 {
        return 0;
    }
    return frame_w * 2 / px;
}

pub fn line_short(frame_w: u32, chars: u32) -> bool {
    let cap : u32 = line_cap(frame_w);
    return chars > 0 and cap > 0 and chars <= cap;
}

pub fn title_readable_on_phone(frame_w: u32) -> bool {
    if frame_w == 0 {
        return false;
    }
    let milli : u32 = frame_title_px(frame_w) * 1000 * TH_BP_PHONE_MAX / frame_w;
    return milli >= th_body_milli_px(TH_BP_PHONE_MAX);
}

pub fn title_fits(frame_w: u32, frame_h: u32) -> bool {
    let px : u32 = frame_title_px(frame_w);
    return px > 0 and frame_h > px * 2;
}

pub fn frame_format(vertical: bool) -> usize {
    if vertical {
        return FMT_REEL_TALL;
    }
    return pick_format(CH_YOUTUBE, KIND_MOVING);
}

pub fn default_vertical() -> bool {
    return false;
}

pub fn cut_w(vertical: bool) -> u32 {
    return FMT_W[frame_format(vertical)];
}

pub fn cut_h(vertical: bool) -> u32 {
    return FMT_H[frame_format(vertical)];
}

; One screen carries one idea. A second idea is a second screen.
pub const IDEAS_PER_SCREEN : u32 = 1;

pub fn screen_ok(ideas: u32) -> bool {
    return ideas == IDEAS_PER_SCREEN;
}

pub const END_MARK : str = "trinity-triangle";
pub const HANDLE : str = "@t27_lang";
pub const CTA : str = "Read the work";

pub fn end_card_ok() -> bool {
    let w : u32 = cut_w(false);
    return accent_is_white_triangle() and END_MARK == "trinity-triangle" and HANDLE == "@t27_lang" and line_short(w, CTA.len) and line_short(w, HANDLE.len);
}

; Public builders of specs/t27f/ui_kit.t27, in source order. No other builder is a video widget.
pub const B_BUTTON : u32 = 0;
pub const B_CARD : u32 = 1;
pub const B_INPUT : u32 = 2;
pub const B_BADGE : u32 = 3;
pub const B_NAV : u32 = 4;
pub const B_TABLE : u32 = 5;
pub const B_TEXT : u32 = 6;
pub const B_CONTAINER : u32 = 7;
pub const BUILDER_COUNT : u32 = 8;

pub fn builder_name(i: u32) -> str {
    if i == B_BUTTON { return "kit_button"; }
    if i == B_CARD { return "kit_card"; }
    if i == B_INPUT { return "kit_input"; }
    if i == B_BADGE { return "kit_badge"; }
    if i == B_NAV { return "kit_nav"; }
    if i == B_TABLE { return "kit_table"; }
    if i == B_TEXT { return "kit_text"; }
    if i == B_CONTAINER { return "kit_container"; }
    return "";
}

pub fn builder_allowed(i: u32) -> bool {
    let name : str = builder_name(i);
    return name.len > 0;
}

pub const FORMULA_HOME : str = "specs/physics/formula_registry.t27";
pub const PELLIS_HOME : str = "specs/physics/pellis-formulas.t27";

pub fn restates_formulas() -> bool {
    return false;
}

invariant the_window_shell_stays_blocked {
    assert window_shell() == "blocked";
    assert GLASS_OPEN == false;
}

invariant the_default_cut_is_sixteen_by_nine {
    assert default_vertical() == false;
    assert cut_w(false) * 9 == cut_h(false) * 16;
    assert cut_w(true) * 16 == cut_h(true) * 9;
}

test version_and_shell {
    assert T27OS_VIDEO_BRAND_V1 == 1;
    assert window_shell() == "blocked";
    assert GLASS_OPEN == false;
    assert GROUND_NOISE == false;
    assert second_palette() == false;
    assert restates_formulas() == false;
    assert FORMULA_HOME == "specs/physics/formula_registry.t27";
    assert PELLIS_HOME == "specs/physics/pellis-formulas.t27";
}

test ground_is_the_dark_theme_and_the_accent_is_the_white_triangle {
    assert brand_bg() == vf_fill(THEME_DARK, VF_NONE);
    assert brand_bg() != th_color(TH_PAPER, TH_BG);
    assert brand_bg() != TH_ERROR_RGB;
    assert accent_rgb() == vf_label(THEME_DARK, VF_TEXT);
    assert accent_is_white_triangle();
    assert accent_rgb() == RGB_WHITE;
}

test wide_cut_is_the_youtube_moving_format_and_tall_is_requested {
    assert frame_format(false) == pick_format(CH_YOUTUBE, KIND_MOVING);
    assert frame_format(false) == FMT_REEL_WIDE;
    assert frame_format(true) == FMT_REEL_TALL;
    assert frame_format(false) != frame_format(true);
    assert cut_w(false) == FMT_W[FMT_REEL_WIDE];
    assert cut_h(false) == FMT_H[FMT_REEL_WIDE];
    assert cut_w(true) == FMT_W[FMT_REEL_TALL];
    assert cut_h(true) == FMT_H[FMT_REEL_TALL];
}

test titles_are_large_short_and_readable_at_phone_width {
    let w : u32 = cut_w(false);
    let h : u32 = cut_h(false);
    assert title_fits(w, h);
    assert title_readable_on_phone(w);
    assert title_fits(cut_w(true), cut_h(true));
    assert title_readable_on_phone(cut_w(true));
    assert line_cap(w) > 0;
    assert line_cap(w) <= 24;
    assert line_short(w, CTA.len);
    assert line_short(w, HANDLE.len);
    assert line_short(w, line_cap(w) + 1) == false;
    assert screen_ok(IDEAS_PER_SCREEN);
    assert screen_ok(2) == false;
    assert screen_ok(0) == false;
}

test end_card_and_kit_builders {
    assert end_card_ok();
    assert END_MARK == "trinity-triangle";
    assert HANDLE == "@t27_lang";
    assert CTA == "Read the work";
    assert BUILDER_COUNT == 8;
    assert builder_name(B_BUTTON) == "kit_button";
    assert builder_name(B_CARD) == "kit_card";
    assert builder_name(B_INPUT) == "kit_input";
    assert builder_name(B_BADGE) == "kit_badge";
    assert builder_name(B_NAV) == "kit_nav";
    assert builder_name(B_TABLE) == "kit_table";
    assert builder_name(B_TEXT) == "kit_text";
    assert builder_name(B_CONTAINER) == "kit_container";
    assert builder_allowed(B_TEXT);
    assert builder_allowed(BUILDER_COUNT) == false;
    assert builder_name(BUILDER_COUNT) == "";
}

test negative_control_refutes_an_open_shell {
    assert window_shell() != "open";
    assert GLASS_OPEN != true;
}
