use t27os::peer_identity::pi_fp_from_digest;
use t27os::peer_identity::id_build;
use t27os::peer_identity::id_check;
use t27os::peer_identity::id_action;
use t27os::peer_identity::ft_init;
use t27os::peer_identity::ft_check;
use t27os::peer_identity::FT_SHORT;
use t27os::peer_identity::FT2_LEN;
use t27os::peer_identity::FK_LEN;
use t27os::peer_identity::PIN_NEW;
use t27os::peer_identity::PIN_BAD;
use t27os::peer_identity::ft2_split;
use t27os::peer_identity::ft2_join;
