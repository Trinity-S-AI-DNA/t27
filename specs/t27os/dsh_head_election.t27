// SPDX-License-Identifier: Apache-2.0
// specs/t27os/dsh_head_election.t27 -- which rung is dsh's default head (owner
// brief 2026-10-27): the election law that flips the DeepSeek Harness default
// model between rungs (zai-pool, the own ollama node) FROM PROBE EVIDENCE, with
// hysteresis so a flapping rung cannot flap the head.
// --
// The evidence. Every PROBE_INTERVAL_S each rung gets ONE turn-sized probe
// (PROBE_TOKENS tokens, thinking disabled on zai -- the T27OS rule). A probe
// that answers 200 within the timeout extends that rung's alive-streak by one
// and resets the other's; a refusal (429/timeout/5xx) resets its own streak.
// Streaks count CONSECUTIVE probes, not history.
// --
// The hysteresis. The head flips to a challenger only when the challenger's
// streak has reached FLIP_STREAK (3 consecutive turn-sized wins) AND the
// current head's streak is 0 (it just failed). A single green probe does not
// move the head; a rung must out-serve the incumbent three probes running.
// Fail-closed: with no evidence at all the election keeps the current head.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsDshHeadElection;

pub const PROBE_INTERVAL_S : u32 = 60;
pub const PROBE_TOKENS : u32 = 100;
pub const FLIP_STREAK : usize = 3;

pub const HEAD_ZAI : u8 = 0;
pub const HEAD_OLLAMA : u8 = 1;

pub const E_KEEP : u8 = 0;
pub const E_FLIP : u8 = 1;

/// One election step. zai_streak/ollama_streak are the consecutive turn-sized
/// wins counted AFTER the latest probe of each rung; head is the current head.
/// Returns E_FLIP (with `to` naming the challenger) only past the hysteresis:
/// the challenger's streak reached FLIP_STREAK while the head's own streak is 0.
pub fn elect(head : u8, zai_streak : usize, ollama_streak : usize) -> u8 {
    if (head == HEAD_ZAI) {
        if (ollama_streak >= FLIP_STREAK and zai_streak == 0) { return E_FLIP; }
        return E_KEEP;
    }
    if (head == HEAD_OLLAMA) {
        if (zai_streak >= FLIP_STREAK and ollama_streak == 0) { return E_FLIP; }
        return E_KEEP;
    }
    return E_KEEP;
}

/// The head a flip lands on, given the current one.
pub fn other(head : u8) -> u8 {
    if (head == HEAD_ZAI) { return HEAD_OLLAMA; }
    return HEAD_ZAI;
}

test election_consts_hold {
    var i : u32 = PROBE_INTERVAL_S;
    var t : u32 = PROBE_TOKENS;
    var k : usize = FLIP_STREAK;
    assert i == 60;
    assert t == 100;
    assert k == 3;
}

test a_single_green_probe_never_moves_the_head {
    assert elect(HEAD_ZAI, 0, 1) == E_KEEP;
    assert elect(HEAD_ZAI, 2, 2) == E_KEEP;
    assert elect(HEAD_OLLAMA, 2, 2) == E_KEEP;
}

test the_head_flips_only_after_three_wins_over_a_dead_incumbent {
    assert elect(HEAD_ZAI, 0, 3) == E_FLIP;
    assert elect(HEAD_ZAI, 1, 3) == E_KEEP;
    assert elect(HEAD_OLLAMA, 3, 0) == E_FLIP;
    assert elect(HEAD_OLLAMA, 3, 1) == E_KEEP;
}

test an_alive_incumbent_is_never_flipped_away_from {
    assert elect(HEAD_ZAI, 1, 5) == E_KEEP;
    assert elect(HEAD_OLLAMA, 1, 5) == E_KEEP;
}

test other_names_the_challenger {
    assert other(HEAD_ZAI) == HEAD_OLLAMA;
    assert other(HEAD_OLLAMA) == HEAD_ZAI;
}

test an_unknown_head_keeps_the_line_fail_closed {
    assert elect(9, 0, 3) == E_KEEP;
}
