// SPDX-License-Identifier: Apache-2.0
// specs/t27os/handoff_view.t27 -- the handoff ledger as the T27OS sees it (#12286)
//
// The ledger (docs/coordination/HANDOFF.md, meaning in
// specs/tri/handoff/handoff.t27) speaks in the four states of a HELD TASK.
// The T27OS speaks in the five session states of an agent cell
// (specs/t27os/agents.t27: S_STOPPED..S_DONE). This file is the row between
// them, so `trigit handoff` ends in words the comb already understands:
//
//   taken or doing -> S_WORKING  a session is on it
//   blocked        -> S_BLOCKED  the cell needs_you
//   done           -> S_DONE     the session finished
//   no record      -> S_STOPPED  nobody is running for it
//
// Nothing here moves a session: it names the mapping, the way lanes_view
// names a lane. The row `<agent> <task> -> session <name>` is what the verb
// prints after the records, and hov_name is agents' states as words.
// phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsHandoffView;

use tri::handoff::handoff::ST_TAKEN;
use tri::handoff::handoff::ST_DOING;
use tri::handoff::handoff::ST_BLOCKED;
use tri::handoff::handoff::ST_DONE;
use tri::handoff::handoff::ST_UNKNOWN;
use tri::handoff::handoff::record_is_well_formed;
use tri::handoff::handoff::state_field_code;
use tri::handoff::handoff::nth_sep;
use tri::handoff::handoff::put_span;
use tri::handoff::handoff::put_lit;
use t27os::agents::S_STOPPED;
use t27os::agents::S_WORKING;
use t27os::agents::S_BLOCKED;
use t27os::agents::S_IDLE;
use t27os::agents::S_DONE;
use t27os::agents::needs_you;

/// The session state a handoff state means: a task taken or being done is a
/// session working, blocked is a cell waiting on the user, done is finished,
/// and a task no record holds has nothing running for it.
pub fn hov_session(s: u32) -> u32 {
    if (s == ST_TAKEN) { return S_WORKING; }
    if (s == ST_DOING) { return S_WORKING; }
    if (s == ST_BLOCKED) { return S_BLOCKED; }
    if (s == ST_DONE) { return S_DONE; }
    return S_STOPPED;
}

/// The word the comb would call that session state (agents.t27's five, in
/// agents' own order); any other value reads as stopped, never as a word
/// nobody's cell can hold.
pub fn hov_name(s: u32) -> str {
    if (s == S_STOPPED) { return "stopped"; }
    if (s == S_WORKING) { return "working"; }
    if (s == S_BLOCKED) { return "blocked"; }
    if (s == S_IDLE) { return "idle"; }
    if (s == S_DONE) { return "done"; }
    return "stopped";
}

/// The row for the record at [a,b): `<agent> <task> -> session <name>` with a
/// newline, laid into out from w. A span that is not a record gets no row: the
/// view shows what the contract already accepted and adds nothing of its own.
pub fn hov_row(f: []const u8, a: usize, b: usize, out: []u8, w: usize, cap: usize) -> usize {
    if (record_is_well_formed(f, a, b) == false) { return w; }
    const e0 : usize = nth_sep(f, a, b, 0);
    const e1 : usize = nth_sep(f, a, b, 1);
    w = put_span(out, w, cap, f, a, e0);
    w = put_lit(out, w, cap, " ");
    w = put_span(out, w, cap, f, e0 + 1, e1);
    w = put_lit(out, w, cap, " -> session ");
    w = put_lit(out, w, cap, hov_name(hov_session(state_field_code(f, a, b))));
    w = put_lit(out, w, cap, "\n");
    return w;
}

test a_held_task_maps_to_the_session_the_comb_would_show {
    assert hov_session(ST_TAKEN) == S_WORKING
    assert hov_session(ST_DOING) == S_WORKING
    assert hov_session(ST_BLOCKED) == S_BLOCKED
    assert hov_session(ST_DONE) == S_DONE
    assert hov_session(ST_UNKNOWN) == S_STOPPED
    // the mapping lands where agents.t27 itself lights the cell and not past it
    assert needs_you(hov_session(ST_BLOCKED))
    assert needs_you(hov_session(ST_DOING)) == false
    assert needs_you(hov_session(ST_TAKEN)) == false
}

test hov_name_reads_the_five_session_states_and_refuses_the_rest {
    assert hov_name(S_STOPPED) == "stopped"
    assert hov_name(S_WORKING) == "working"
    assert hov_name(S_BLOCKED) == "blocked"
    assert hov_name(S_IDLE) == "idle"
    assert hov_name(S_DONE) == "done"
    assert hov_name(99) == "stopped"
    assert hov_session(99) == S_STOPPED
}

test the_row_writes_agent_task_and_the_session_it_means {
    const f : str = "Buffy|viz-distill-graph|doing|#12218|page lives in the spec";
    let mut out : [256]u8 = [0; 256];
    let n : usize = hov_row(f, 0, 59, out[0..256], 0, 256);
    let mut want : [256]u8 = [0; 256];
    let k : usize = put_lit(want[0..256], 0, 256, "Buffy viz-distill-graph -> session working\n");
    assert n == k
    var i : usize = 0;
    while (i < n) {
        assert out[i] == want[i]
        i = i + 1;
    }
    // a done record is a finished session, and the row says so
    const d : str = "Codex|gen-python|done|#12249|the verb lands";
    let mut out2 : [256]u8 = [0; 256];
    let n2 : usize = hov_row(d, 0, 43, out2[0..256], 0, 256);
    let mut want2 : [256]u8 = [0; 256];
    let k2 : usize = put_lit(want2[0..256], 0, 256, "Codex gen-python -> session done\n");
    assert n2 == k2
    var j : usize = 0;
    while (j < n2) {
        assert out2[j] == want2[j]
        j = j + 1;
    }
}

test a_span_that_is_not_a_record_gets_no_row {
    const t : str = "# a title, no fields";
    let mut out : [64]u8 = [0; 64];
    assert hov_row(t, 0, 19, out[0..64], 0, 64) == 0
    const five : str = "a|b|hold|#1|x";
    assert hov_row(five, 0, 13, out[0..64], 0, 64) == 0
    assert hov_row("a|b|done|#1", 0, 11, out[0..64], 0, 64) == 0
}
