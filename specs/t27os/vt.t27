// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vt.t27 -- a minimal VT/ANSI terminal: bytes in, a grid of cells out. The T27 OS window feeds
; the output of a pane's PTY (pty_client.t27 READ) through vt_feed and draws the grid.
; Owner, 2026-10-19: agent CLIs run as real terminals; the window needs just enough of a terminal to show
; Claude Code, Codex and a shell: printable text, CR LF BS TAB, cursor moves, erase and scroll. Colour and
; style (SGR) are read and dropped: the screen is black and white.
; State is a u32 register file (ST_*) and the cells are one u32 codepoint each, row-major, cols * rows long;
; nothing else is kept, so a host loop owns two plain buffers and calls vt_feed per byte.
; Handled: printable ASCII and UTF-8 (decoded to a codepoint), CR, LF (scrolls at the bottom), BS, TAB (to
; the next multiple of 8), and CSI: A B C D (up, down, right, left), H f (position), G (column), d (row),
; J (erase display 0, 1, 2, 3), K (erase line 0, 1, 2). Every other CSI (m, h, l, r, ...), OSC strings
; (BEL or ESC \ ends them) and two-byte ESC sequences are consumed and dropped. A line that reaches the
; right edge wraps on the next printable (deferred wrap, as xterm does).

module T27osVt;

pub const ST_X : usize = 0;
pub const ST_Y : usize = 1;
pub const ST_COLS : usize = 2;
pub const ST_ROWS : usize = 3;
pub const ST_MODE : usize = 4;
pub const ST_P0 : usize = 5;
pub const ST_P1 : usize = 6;
pub const ST_NP : usize = 7;
pub const ST_UTF : usize = 8;
pub const ST_CP : usize = 9;
pub const ST_COUNT : usize = 10;

pub const M_GROUND : u32 = 0;
pub const M_ESC : u32 = 1;
pub const M_CSI : u32 = 2;
pub const M_OSC : u32 = 3;
pub const M_OSC_ESC : u32 = 4;

pub const BLANK : u32 = 32;
pub const REPLACEMENT : u32 = 65533;
pub const PARAM_MAX : u32 = 9999;

pub fn vt_init(st: []u32, cells: []u32, cols: u32, rows: u32) -> bool {
    if (cols == 0 or rows == 0 or cells.len < cols * rows or st.len < ST_COUNT) { return false; }
    var i : usize = 0;
    while (i < ST_COUNT) { st[i] = 0; i = i + 1; }
    st[ST_COLS] = cols;
    st[ST_ROWS] = rows;
    var c : usize = 0;
    while (c < cols * rows) { cells[c] = BLANK; c = c + 1; }
    return true;
}

pub fn vt_cell(st: []const u32, cells: []const u32, x: u32, y: u32) -> u32 {
    return cells[y * st[ST_COLS] + x];
}

fn blank_range(cells: []u32, from: u32, to: u32) -> bool {
    var i : u32 = from;
    while (i < to) { cells[i] = BLANK; i = i + 1; }
    return true;
}

fn scroll_up(st: []u32, cells: []u32) -> bool {
    const cols : u32 = st[ST_COLS];
    const rows : u32 = st[ST_ROWS];
    var i : u32 = 0;
    while (i < cols * (rows - 1)) {
        cells[i] = cells[i + cols];
        i = i + 1;
    }
    return blank_range(cells, cols * (rows - 1), cols * rows);
}

fn line_feed(st: []u32, cells: []u32) -> bool {
    if (st[ST_Y] + 1 >= st[ST_ROWS]) {
        return scroll_up(st, cells);
    }
    st[ST_Y] = st[ST_Y] + 1;
    return true;
}

fn put_cp(st: []u32, cells: []u32, cp: u32) -> bool {
    if (st[ST_X] >= st[ST_COLS]) {
        st[ST_X] = 0;
        line_feed(st, cells);
    }
    cells[st[ST_Y] * st[ST_COLS] + st[ST_X]] = cp;
    st[ST_X] = st[ST_X] + 1;
    return true;
}

fn one_if_zero(v: u32) -> u32 {
    if (v == 0) { return 1; }
    return v;
}

fn clamp_to(v: u32, max_excl: u32) -> u32 {
    if (v >= max_excl) { return max_excl - 1; }
    return v;
}

fn erase_display(st: []u32, cells: []u32, how: u32) -> bool {
    const cols : u32 = st[ST_COLS];
    const at : u32 = st[ST_Y] * cols + clamp_to(st[ST_X], cols);
    if (how == 0) { return blank_range(cells, at, cols * st[ST_ROWS]); }
    if (how == 1) { return blank_range(cells, 0, at + 1); }
    return blank_range(cells, 0, cols * st[ST_ROWS]);
}

fn erase_line(st: []u32, cells: []u32, how: u32) -> bool {
    const cols : u32 = st[ST_COLS];
    const row : u32 = st[ST_Y] * cols;
    const x : u32 = clamp_to(st[ST_X], cols);
    if (how == 0) { return blank_range(cells, row + x, row + cols); }
    if (how == 1) { return blank_range(cells, row, row + x + 1); }
    return blank_range(cells, row, row + cols);
}

fn csi_final(st: []u32, cells: []u32, b: u8) -> bool {
    const cols : u32 = st[ST_COLS];
    const rows : u32 = st[ST_ROWS];
    const p0 : u32 = st[ST_P0];
    const p1 : u32 = st[ST_P1];
    const x : u32 = clamp_to(st[ST_X], cols);
    if (b == 65) {
        // A: up
        const d : u32 = one_if_zero(p0);
        if (d > st[ST_Y]) { st[ST_Y] = 0; } else { st[ST_Y] = st[ST_Y] - d; }
    } else if (b == 66) {
        st[ST_Y] = clamp_to(st[ST_Y] + one_if_zero(p0), rows);
    } else if (b == 67) {
        st[ST_X] = clamp_to(x + one_if_zero(p0), cols);
    } else if (b == 68) {
        const d : u32 = one_if_zero(p0);
        if (d > x) { st[ST_X] = 0; } else { st[ST_X] = x - d; }
    } else if (b == 72 or b == 102) {
        st[ST_Y] = clamp_to(one_if_zero(p0) - 1, rows);
        st[ST_X] = clamp_to(one_if_zero(p1) - 1, cols);
    } else if (b == 71) {
        st[ST_X] = clamp_to(one_if_zero(p0) - 1, cols);
    } else if (b == 100) {
        st[ST_Y] = clamp_to(one_if_zero(p0) - 1, rows);
    } else if (b == 74) {
        erase_display(st, cells, p0);
    } else if (b == 75) {
        erase_line(st, cells, p0);
    }
    st[ST_MODE] = M_GROUND;
    return true;
}

fn utf8_byte(st: []u32, cells: []u32, b: u8) -> bool {
    const v : u32 = @as(u32, b);
    if (v >= 128 and v < 192) {
        if (st[ST_UTF] == 0) { return true; }
        st[ST_CP] = st[ST_CP] * 64 + (v & 63);
        st[ST_UTF] = st[ST_UTF] - 1;
        if (st[ST_UTF] == 0) { put_cp(st, cells, st[ST_CP]); }
        return true;
    }
    if (st[ST_UTF] != 0) {
        st[ST_UTF] = 0;
        put_cp(st, cells, REPLACEMENT);
    }
    if (v >= 192 and v < 224) { st[ST_UTF] = 1; st[ST_CP] = v & 31; return true; }
    if (v >= 224 and v < 240) { st[ST_UTF] = 2; st[ST_CP] = v & 15; return true; }
    if (v >= 240 and v < 248) { st[ST_UTF] = 3; st[ST_CP] = v & 7; return true; }
    return put_cp(st, cells, REPLACEMENT);
}

fn ground_byte(st: []u32, cells: []u32, b: u8) -> bool {
    if (b == 27) { st[ST_MODE] = M_ESC; return true; }
    if (b == 13) { st[ST_X] = 0; return true; }
    if (b == 10 or b == 11 or b == 12) { return line_feed(st, cells); }
    if (b == 8) {
        if (st[ST_X] > 0) { st[ST_X] = clamp_to(st[ST_X], st[ST_COLS]) - 1; }
        return true;
    }
    if (b == 9) {
        st[ST_X] = clamp_to((st[ST_X] / 8 + 1) * 8, st[ST_COLS]);
        return true;
    }
    if (b < 32 or b == 127) { return true; }
    if (b >= 128) { return utf8_byte(st, cells, b); }
    if (st[ST_UTF] != 0) { st[ST_UTF] = 0; put_cp(st, cells, REPLACEMENT); }
    return put_cp(st, cells, @as(u32, b));
}

fn csi_byte(st: []u32, cells: []u32, b: u8) -> bool {
    if (b >= 48 and b <= 57) {
        var v : u32 = @as(u32, b - 48);
        if (st[ST_NP] == 0) {
            st[ST_P0] = st[ST_P0] * 10 + v;
            if (st[ST_P0] > PARAM_MAX) { st[ST_P0] = PARAM_MAX; }
        } else if (st[ST_NP] == 1) {
            st[ST_P1] = st[ST_P1] * 10 + v;
            if (st[ST_P1] > PARAM_MAX) { st[ST_P1] = PARAM_MAX; }
        }
        return true;
    }
    if (b == 59) {
        st[ST_NP] = st[ST_NP] + 1;
        return true;
    }
    if (b >= 64 and b <= 126) { return csi_final(st, cells, b); }
    if (b == 27) { st[ST_MODE] = M_ESC; }
    return true;
}

/// Feed one byte of PTY output to the terminal.
pub fn vt_feed(st: []u32, cells: []u32, b: u8) -> bool {
    const mode : u32 = st[ST_MODE];
    if (mode == M_GROUND) { return ground_byte(st, cells, b); }
    if (mode == M_ESC) {
        if (b == 91) {
            st[ST_MODE] = M_CSI;
            st[ST_P0] = 0;
            st[ST_P1] = 0;
            st[ST_NP] = 0;
        } else if (b == 93) {
            st[ST_MODE] = M_OSC;
        } else if (b == 27) {
            st[ST_MODE] = M_ESC;
        } else {
            st[ST_MODE] = M_GROUND;
        }
        return true;
    }
    if (mode == M_CSI) { return csi_byte(st, cells, b); }
    if (mode == M_OSC) {
        if (b == 7) { st[ST_MODE] = M_GROUND; }
        if (b == 27) { st[ST_MODE] = M_OSC_ESC; }
        return true;
    }
    st[ST_MODE] = M_GROUND;
    return true;
}

/// Feed a run of bytes.
pub fn vt_feed_all(st: []u32, cells: []u32, src: []const u8) -> bool {
    var i : usize = 0;
    while (i < src.len) {
        vt_feed(st, cells, src[i]);
        i = i + 1;
    }
    return true;
}

/// Test helper: feed text in which "^" stands for ESC, "%" for CR, "_" for BS and "@" for BEL, since a
/// string literal here has no escapes for them.
fn fed(st: []u32, cells: []u32, src: []const u8) -> bool {
    var i : usize = 0;
    while (i < src.len) {
        var b : u8 = src[i];
        if (b == 94) { b = 27; }
        if (b == 37) { b = 13; }
        if (b == 95) { b = 8; }
        if (b == 64) { b = 7; }
        vt_feed(st, cells, b);
        i = i + 1;
    }
    return true;
}

test text_lands_on_the_grid_and_wraps {
    var st : [10]u32 = undefined;
    var cells : [40]u32 = undefined;
    assert vt_init(st[0..10], cells[0..40], 8, 5);
    fed(st[0..10], cells[0..40], "hello");
    assert vt_cell(st[0..10], cells[0..40], 0, 0) == 104;
    assert vt_cell(st[0..10], cells[0..40], 4, 0) == 111;
    assert st[ST_X] == 5;
    fed(st[0..10], cells[0..40], "world!");
    // 11 characters on an 8-column grid: the last 3 wrap onto row 1
    assert vt_cell(st[0..10], cells[0..40], 7, 0) == 114;
    assert vt_cell(st[0..10], cells[0..40], 0, 1) == 108;
    assert vt_cell(st[0..10], cells[0..40], 2, 1) == 33;
    assert st[ST_Y] == 1 and st[ST_X] == 3;
}

test control_characters_move_the_cursor {
    var st : [10]u32 = undefined;
    var cells : [40]u32 = undefined;
    assert vt_init(st[0..10], cells[0..40], 20, 2);
    fed(st[0..10], cells[0..40], "ab%\ncd");
    assert vt_cell(st[0..10], cells[0..40], 0, 1) == 99;
    fed(st[0..10], cells[0..40], "_X");
    assert vt_cell(st[0..10], cells[0..40], 1, 1) == 88;
    fed(st[0..10], cells[0..40], "%\ty");
    assert vt_cell(st[0..10], cells[0..40], 8, 1) == 121;
    assert st[ST_X] == 9;
}

test the_screen_scrolls_at_the_bottom {
    var st : [10]u32 = undefined;
    var cells : [30]u32 = undefined;
    assert vt_init(st[0..10], cells[0..30], 10, 3);
    fed(st[0..10], cells[0..30], "one%\ntwo%\nthree%\nfour");
    assert vt_cell(st[0..10], cells[0..30], 0, 0) == 116;
    assert vt_cell(st[0..10], cells[0..30], 1, 0) == 119;
    assert vt_cell(st[0..10], cells[0..30], 0, 1) == 116;
    assert vt_cell(st[0..10], cells[0..30], 2, 1) == 114;
    assert vt_cell(st[0..10], cells[0..30], 0, 2) == 102;
    assert vt_cell(st[0..10], cells[0..30], 5, 2) == 32;
    assert st[ST_Y] == 2;
}

test csi_moves_and_positions_the_cursor {
    var st : [10]u32 = undefined;
    var cells : [200]u32 = undefined;
    assert vt_init(st[0..10], cells[0..200], 20, 10);
    fed(st[0..10], cells[0..200], "^[5;7Hx");
    assert vt_cell(st[0..10], cells[0..200], 6, 4) == 120;
    fed(st[0..10], cells[0..200], "^[2A^[3Dy");
    assert vt_cell(st[0..10], cells[0..200], 4, 2) == 121;
    fed(st[0..10], cells[0..200], "^[B^[Cz");
    assert vt_cell(st[0..10], cells[0..200], 6, 3) == 122;
    fed(st[0..10], cells[0..200], "^[H");
    assert st[ST_X] == 0 and st[ST_Y] == 0;
    fed(st[0..10], cells[0..200], "^[99;99H");
    assert st[ST_X] == 19 and st[ST_Y] == 9;
    fed(st[0..10], cells[0..200], "^[9999A^[9999D");
    assert st[ST_X] == 0 and st[ST_Y] == 0;
    fed(st[0..10], cells[0..200], "^[12G^[4d");
    assert st[ST_X] == 11 and st[ST_Y] == 3;
}

test erase_clears_by_the_cursor {
    var st : [10]u32 = undefined;
    var cells : [60]u32 = undefined;
    assert vt_init(st[0..10], cells[0..60], 10, 6);
    var r : u32 = 0;
    while (r < 6) {
        fed(st[0..10], cells[0..60], "aaaaaaaaaa");
        r = r + 1;
    }
    fed(st[0..10], cells[0..60], "^[3;5H^[K");
    assert vt_cell(st[0..10], cells[0..60], 3, 2) == 97;
    assert vt_cell(st[0..10], cells[0..60], 4, 2) == 32;
    assert vt_cell(st[0..10], cells[0..60], 9, 2) == 32;
    fed(st[0..10], cells[0..60], "^[1K");
    assert vt_cell(st[0..10], cells[0..60], 0, 2) == 32;
    assert vt_cell(st[0..10], cells[0..60], 4, 2) == 32;
    fed(st[0..10], cells[0..60], "^[4;1H^[J");
    assert vt_cell(st[0..10], cells[0..60], 0, 3) == 32;
    assert vt_cell(st[0..10], cells[0..60], 9, 5) == 32;
    assert vt_cell(st[0..10], cells[0..60], 9, 1) == 97;
    fed(st[0..10], cells[0..60], "^[2J");
    assert vt_cell(st[0..10], cells[0..60], 9, 1) == 32;
}

test style_and_titles_are_dropped {
    var st : [10]u32 = undefined;
    var cells : [40]u32 = undefined;
    assert vt_init(st[0..10], cells[0..40], 20, 2);
    fed(st[0..10], cells[0..40], "^[1;31mred^[0m ^]0;a title@ok^]2;x^\\!");
    assert vt_cell(st[0..10], cells[0..40], 0, 0) == 114;
    assert vt_cell(st[0..10], cells[0..40], 2, 0) == 100;
    assert vt_cell(st[0..10], cells[0..40], 4, 0) == 111;
    assert vt_cell(st[0..10], cells[0..40], 6, 0) == 33;
    assert st[ST_X] == 7;
    assert st[ST_MODE] == M_GROUND;
    fed(st[0..10], cells[0..40], "^[?25l^[?2004h^c");
    assert st[ST_X] == 7 and st[ST_MODE] == M_GROUND;
}

test utf8_is_decoded_to_codepoints {
    var st : [10]u32 = undefined;
    var cells : [40]u32 = undefined;
    assert vt_init(st[0..10], cells[0..40], 20, 2);
    // e-acute (2 bytes), euro (3 bytes), a box-drawing corner (3 bytes), a rocket emoji (4 bytes)
    var a : [12]u8 = undefined;
    a[0] = 195; a[1] = 169;
    a[2] = 226; a[3] = 130; a[4] = 172;
    a[5] = 226; a[6] = 149; a[7] = 173;
    a[8] = 240; a[9] = 159; a[10] = 154; a[11] = 128;
    vt_feed_all(st[0..10], cells[0..40], a[0..12]);
    assert vt_cell(st[0..10], cells[0..40], 0, 0) == 233;
    assert vt_cell(st[0..10], cells[0..40], 1, 0) == 8364;
    assert vt_cell(st[0..10], cells[0..40], 2, 0) == 9581;
    assert vt_cell(st[0..10], cells[0..40], 3, 0) == 128640;
    assert st[ST_X] == 4;
    // a lead byte followed by ASCII is a broken sequence: one replacement, then the ASCII
    a[0] = 226; a[1] = 122;
    vt_feed_all(st[0..10], cells[0..40], a[0..2]);
    assert vt_cell(st[0..10], cells[0..40], 4, 0) == REPLACEMENT;
    assert vt_cell(st[0..10], cells[0..40], 5, 0) == 122;
    // a lone continuation byte is dropped
    a[0] = 169;
    vt_feed_all(st[0..10], cells[0..40], a[0..1]);
    assert st[ST_X] == 6;
}

test a_tiny_grid_cannot_be_overrun {
    var st : [10]u32 = undefined;
    var cells : [4]u32 = undefined;
    assert vt_init(st[0..10], cells[0..4], 2, 2);
    var i : u32 = 0;
    while (i < 50) {
        fed(st[0..10], cells[0..4], "ab^[9B^[9C_\n^[J");
        i = i + 1;
    }
    assert st[ST_X] < 3 and st[ST_Y] < 2;
    assert vt_init(st[0..10], cells[0..4], 3, 2) == false;
    assert vt_init(st[0..10], cells[0..4], 0, 2) == false;
}
