// SPDX-License-Identifier: Apache-2.0
// specs/t27os/layout_state.t27 -- t27os: shell layout state model (resizable
// left, right and bottom panels, overlay, Zen, persistent).
// Part of M1 (milestone #5). Closes #14047.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::layout_state;

pub const PANEL_MAX : u32 = 16;

pub struct Panel { id: str, side: str, resizable: bool, visible: bool };

pub struct Layout { panels: [16]Panel, panel_count: u32, zen_mode: bool };

pub fn layout_panel_count(l: Layout) -> u32 {
    return l.panel_count;
}

pub fn layout_zen_active(l: Layout) -> bool {
    return l.zen_mode;
}

pub fn panel_resizable(p: Panel) -> bool {
    return p.resizable;
}

test "layout panel count" {
    var l = Layout { panels: [_]Panel{ Panel{ id: "", side: "", resizable: false, visible: false } } ** 16, panel_count: 3, zen_mode: false };
    assert(layout_panel_count(l) == 3);
}

test "layout zen mode" {
    assert(layout_zen_active(Layout { panels: [_]Panel{ Panel{ id: "", side: "", resizable: false, visible: false } } ** 16, panel_count: 0, zen_mode: true }));
    assert(!layout_zen_active(Layout { panels: [_]Panel{ Panel{ id: "", side: "", resizable: false, visible: false } } ** 16, panel_count: 0, zen_mode: false }));
}

test "panel resizable" {
    assert(panel_resizable(Panel { id: "left", side: "left", resizable: true, visible: true }));
    assert(!panel_resizable(Panel { id: "right", side: "right", resizable: false, visible: true }));
}

invariant layout_panel_max {
    assert PANEL_MAX > 0;
}