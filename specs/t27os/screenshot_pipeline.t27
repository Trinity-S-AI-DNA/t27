// SPDX-License-Identifier: Apache-2.0
; specs/t27os/screenshot_pipeline.t27 -- the screenshot pipeline contract.
; Three roles: a renderer, a writer, and an artifact. A missing artifact is a
; failure. This file does not render, does not open a window, does not add a
; shell, and does not add a hand-written CLI.
; --
; Searched before adding (2026-11-10). None of these is this contract, so none
; was extended:
;   specs/course/course_hud_diff_main.t27  host diff of 13 PPM frames
;   specs/t27os/ui_snapshot.t27            what one frame contains
;   specs/t27os/observatory_capture.t27    pair law for an already captured snap
;   specs/port/trios/crates/trios-mcp/rings/SR-00/src/screenshot.t27
;                                          MCP base64 save
;   specs/claw/social_visuals.t27          publish gate for social stills
;   specs/t27f/vf_diff.t27                 pixel diff of two buffers
; --
; Merge waits for green required checks and a separate owner approval.
; A red check does not merge. The window shell stays blocked.
; --
; GAP: tri visual-update is the name in the visual-update skill and is not a
; built tri subcommand (no match under cli/tri/src, 2026-11-10). Gen cannot
; express that host command here. See #5980. SP_TRI_VISUAL_UPDATE_BUILT stays 0.
; This spec does not claim full coverage of the HUD, the Observatory, or stills.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osScreenshotPipeline;

use t27os::orchestrator::oc_allowed;
use t27os::orchestrator::oc_needs_owner;
use t27os::orchestrator::oc_window_open;
use t27os::orchestrator::OC_ACT_MERGE;
use t27os::orchestrator::OC_ACT_WINDOW;
use t27os::orchestrator::OC_ACT_CRON;
use t27os::orchestrator::WINDOW_SHELL_BLOCKED;

pub const SP_WRITER : u32 = 1;
pub const SP_RENDERER : u32 = 2;
pub const SP_ARTIFACT : u32 = 3;

pub const SP_NONE : u32 = 0;
pub const SP_EMPTY : u32 = 1;
pub const SP_BYTES : u32 = 2;

pub const SP_OK : u32 = 0;
pub const SP_NO_RENDER : u32 = 1;
pub const SP_NO_WRITE : u32 = 2;
pub const SP_MISSING : u32 = 3;
pub const SP_EMPTY_ART : u32 = 4;

; The tri command is not built. No host renderer, window, shell, or hand CLI.
pub const SP_TRI_VISUAL_UPDATE_BUILT : u32 = 0;
pub const SP_HOST_RENDERER : u32 = 0;
pub const SP_OPENS_WINDOW : u32 = 0;
pub const SP_ADDS_SHELL : u32 = 0;
pub const SP_HAND_CLI : u32 = 0;
pub const SP_STARTS_HOST_CRON : u32 = 0;
; 0: this spec does not claim complete coverage.
pub const SP_COVERAGE_COMPLETE : u32 = 0;

pub fn sp_role_known(role: u32) -> bool {
    if (role == SP_WRITER) { return true; }
    if (role == SP_RENDERER) { return true; }
    if (role == SP_ARTIFACT) { return true; }
    return false;
}

; Renderer, then writer, then a non-empty artifact. Anything else fails.
; An unknown artifact code fails closed as missing.
pub fn sp_verdict(rendered: bool, written: bool, artifact: u32) -> u32 {
    if (rendered == false) { return SP_NO_RENDER; }
    if (written == false) { return SP_NO_WRITE; }
    if (artifact == SP_NONE) { return SP_MISSING; }
    if (artifact == SP_EMPTY) { return SP_EMPTY_ART; }
    if (artifact == SP_BYTES) { return SP_OK; }
    return SP_MISSING;
}

pub fn sp_accept(rendered: bool, written: bool, artifact: u32) -> bool {
    if (sp_verdict(rendered, written, artifact) != SP_OK) { return false; }
    return true;
}

; Merge waits for green required checks and a separate owner approval.
; A red check does not merge.
pub fn sp_merge_ok(required_green: bool, owner_yes: bool, any_red: bool) -> bool {
    if (any_red) { return false; }
    if (required_green == false) { return false; }
    if (owner_yes == false) { return false; }
    if (oc_needs_owner(OC_ACT_MERGE) == false) { return false; }
    return true;
}

; The window shell stays blocked. A merge decision does not open it.
pub fn sp_window_blocked() -> bool {
    if (oc_window_open()) { return false; }
    if (WINDOW_SHELL_BLOCKED != 1) { return false; }
    if (oc_allowed(OC_ACT_WINDOW)) { return false; }
    return true;
}

test the_three_roles_are_writer_renderer_and_artifact {
    assert sp_role_known(SP_WRITER);
    assert sp_role_known(SP_RENDERER);
    assert sp_role_known(SP_ARTIFACT);
    assert sp_role_known(0) == false;
    assert SP_WRITER != SP_RENDERER;
    assert SP_RENDERER != SP_ARTIFACT;
}

test a_rendered_written_nonempty_artifact_passes {
    assert sp_verdict(true, true, SP_BYTES) == SP_OK;
    assert sp_accept(true, true, SP_BYTES);
}

test a_missing_artifact_is_a_failure {
    assert sp_verdict(true, true, SP_NONE) == SP_MISSING;
    assert sp_accept(true, true, SP_NONE) == false;
    assert sp_verdict(true, true, 9) == SP_MISSING;
    assert sp_accept(true, true, 9) == false;
}

test an_empty_artifact_is_a_failure {
    assert sp_verdict(true, true, SP_EMPTY) == SP_EMPTY_ART;
    assert sp_accept(true, true, SP_EMPTY) == false;
}

test a_renderer_or_writer_that_did_not_run_does_not_pass {
    assert sp_verdict(false, true, SP_BYTES) == SP_NO_RENDER;
    assert sp_verdict(true, false, SP_BYTES) == SP_NO_WRITE;
    assert sp_verdict(false, false, SP_NONE) == SP_NO_RENDER;
    assert sp_accept(false, true, SP_BYTES) == false;
    assert sp_accept(true, false, SP_BYTES) == false;
}

test merge_waits_for_green_checks_and_a_separate_owner_approval {
    assert sp_merge_ok(true, true, false);
    assert sp_merge_ok(true, false, false) == false;
    assert sp_merge_ok(false, true, false) == false;
    assert sp_merge_ok(false, false, false) == false;
    assert oc_needs_owner(OC_ACT_MERGE);
    assert oc_allowed(OC_ACT_MERGE) == false;
}

test a_red_check_does_not_merge {
    assert sp_merge_ok(true, true, true) == false;
    assert sp_merge_ok(false, true, true) == false;
    assert sp_merge_ok(true, false, true) == false;
}

test the_window_shell_stays_blocked {
    assert sp_window_blocked();
    assert sp_merge_ok(true, true, false);
    assert sp_window_blocked();
    assert oc_allowed(OC_ACT_WINDOW) == false;
    assert WINDOW_SHELL_BLOCKED == 1;
}

test this_layer_builds_no_host_and_claims_no_full_coverage {
    assert SP_TRI_VISUAL_UPDATE_BUILT == 0;
    assert SP_HOST_RENDERER == 0;
    assert SP_OPENS_WINDOW == 0;
    assert SP_ADDS_SHELL == 0;
    assert SP_HAND_CLI == 0;
    assert SP_STARTS_HOST_CRON == 0;
    assert SP_COVERAGE_COMPLETE == 0;
    assert oc_allowed(OC_ACT_CRON) == false;
    assert oc_window_open() == false;
}

invariant a_missing_artifact_is_never_accepted {
    assert sp_verdict(true, true, SP_NONE) == SP_MISSING;
    assert sp_accept(true, true, SP_NONE) == false;
}
