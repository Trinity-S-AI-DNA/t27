// SPDX-License-Identifier: Apache-2.0
; specs/t27os/content_calendar.t27 -- the 10-day cycle and the weekly cadence for
; promotion planning. See #13477 and epic #13473. The issue also names
; docs/promotion/content-calendar.md; that path is a new docs/ top level, which
; Article DOCS-TREE does not add here. This spec is the cycle law.
; A day carries one pillar tag. An asset is not publishable: PUBLISH_ENABLED
; and OUTBOUND_ENABLED are false, so asset_publishable is false even when every
; field is present. No claim sentence is stored here (paper numbers stay in
; specs/numeric/paper_claims.t27). A visual day still requires the blocked
; video-brand shell.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osContentCalendar;

use t27os::video_brand::window_shell;
use t27os::video_brand::GLASS_OPEN;
use t27os::video_brand::end_card_ok;
use t27os::video_brand::screen_ok;
use t27os::video_brand::T27OS_VIDEO_BRAND_V1;

pub const CYCLE_DAYS : u32 = 10;
pub const WEEK_DAYS : u32 = 7;
pub const PILLAR_COUNT : u32 = 6;
pub const PILLAR_CLAIM : u32 = 0;
pub const PILLAR_ARTIFACT : u32 = 1;
pub const PILLAR_VISUAL : u32 = 2;
pub const PILLAR_CTA : u32 = 3;
pub const PILLAR_METRIC : u32 = 4;
pub const PILLAR_PATH : u32 = 5;

pub const PUBLISH_ENABLED : bool = false;
pub const OUTBOUND_ENABLED : bool = false;

pub fn pillar_index(day: u32) -> u32 {
    return day % PILLAR_COUNT;
}

pub fn week_slot(day: u32) -> u32 {
    return day % WEEK_DAYS;
}

pub fn day_in_cycle(day: u32) -> bool {
    return day < CYCLE_DAYS;
}

pub fn cycle_week_span() -> u32 {
    return (CYCLE_DAYS + WEEK_DAYS - 1) / WEEK_DAYS;
}

pub fn pillar_tag(day: u32) -> str {
    let p : u32 = pillar_index(day);
    if p == PILLAR_CLAIM { return "claim"; }
    if p == PILLAR_ARTIFACT { return "artifact"; }
    if p == PILLAR_VISUAL { return "visual"; }
    if p == PILLAR_CTA { return "cta"; }
    if p == PILLAR_METRIC { return "metric"; }
    if p == PILLAR_PATH { return "path"; }
    return "";
}

; Missing field. "not measured" is the honest empty, and the asset stays unpublished.
pub fn field_note(present: bool) -> str {
    if present {
        return "present";
    }
    return "N/A: not measured";
}

pub fn stores_claim_text() -> bool {
    return false;
}

pub fn asset_publishable(has_claim: bool, has_artifact: bool, has_visual: bool, has_cta: bool, has_metric: bool, has_path: bool) -> bool {
    if PUBLISH_ENABLED == false {
        return false;
    }
    if OUTBOUND_ENABLED == false {
        return false;
    }
    return has_claim and has_artifact and has_visual and has_cta and has_metric and has_path;
}

pub fn visual_day_shell_blocked(day: u32) -> bool {
    if pillar_index(day) != PILLAR_VISUAL {
        return true;
    }
    return window_shell() == "blocked" and GLASS_OPEN == false and end_card_ok() and screen_ok(1);
}

invariant nothing_in_the_cycle_is_publishable {
    assert PUBLISH_ENABLED == false;
    assert OUTBOUND_ENABLED == false;
    assert asset_publishable(true, true, true, true, true, true) == false;
}

invariant a_visual_day_does_not_open_the_shell {
    assert visual_day_shell_blocked(PILLAR_VISUAL);
    assert window_shell() == "blocked";
    assert GLASS_OPEN == false;
}

test the_cycle_is_ten_days_and_the_week_is_seven {
    assert T27OS_VIDEO_BRAND_V1 == 1;
    assert CYCLE_DAYS == 10;
    assert WEEK_DAYS == 7;
    assert PILLAR_COUNT == 6;
    assert cycle_week_span() == 2;
    assert day_in_cycle(0);
    assert day_in_cycle(9);
    assert day_in_cycle(10) == false;
    assert week_slot(0) == 0;
    assert week_slot(6) == 6;
    assert week_slot(7) == 0;
    assert week_slot(9) == 2;
    assert pillar_index(0) == PILLAR_CLAIM;
    assert pillar_index(2) == PILLAR_VISUAL;
    assert pillar_index(8) == PILLAR_VISUAL;
    assert pillar_tag(0) == "claim";
    assert pillar_tag(1) == "artifact";
    assert pillar_tag(2) == "visual";
    assert pillar_tag(3) == "cta";
    assert pillar_tag(4) == "metric";
    assert pillar_tag(5) == "path";
    assert pillar_tag(8) == "visual";
}

test a_complete_asset_is_still_not_sent {
    assert stores_claim_text() == false;
    assert field_note(true) == "present";
    assert field_note(false) == "N/A: not measured";
    assert asset_publishable(true, true, true, true, true, true) == false;
    assert asset_publishable(false, false, false, false, false, false) == false;
    assert visual_day_shell_blocked(2);
    assert visual_day_shell_blocked(8);
    assert visual_day_shell_blocked(0);
}

test negative_control_refutes_a_live_post {
    assert PUBLISH_ENABLED != true;
    assert OUTBOUND_ENABLED != true;
    assert pillar_tag(99) != "publish";
}
