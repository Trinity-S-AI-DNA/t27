// TEMPORARY probe (isolated repro of the real-list count): delete after root-cause.
module T27osCdpBrowserWsProbe;

use t27os::cdp_browser_ws::count_url_matches;
use t27os::cdp_browser_ws::cm_v1;
use t27os::cdp_browser_ws::cm_v2;

test count_url_matches_on_the_real_peer_list_bytes {
  // the exact 133-byte /json/list body of the local peer (captured 2026-11-02)
  var p : [133]u8;
  p[0] = 91; p[1] = 123; p[2] = 34; p[3] = 100; p[4] = 101; p[5] = 115; p[6] = 99; p[7] = 114;
  p[8] = 105; p[9] = 112; p[10] = 116; p[11] = 105; p[12] = 111; p[13] = 110; p[14] = 34; p[15] = 58;
  p[16] = 34; p[17] = 102; p[18] = 105; p[19] = 120; p[20] = 116; p[21] = 117; p[22] = 114; p[23] = 101;
  p[24] = 34; p[25] = 44; p[26] = 34; p[27] = 116; p[28] = 121; p[29] = 112; p[30] = 101; p[31] = 34;
  p[32] = 58; p[33] = 34; p[34] = 112; p[35] = 97; p[36] = 103; p[37] = 101; p[38] = 34; p[39] = 44;
  p[40] = 34; p[41] = 117; p[42] = 114; p[43] = 108; p[44] = 34; p[45] = 58; p[46] = 34; p[47] = 104;
  p[48] = 116; p[49] = 116; p[50] = 112; p[51] = 115; p[52] = 58; p[53] = 47; p[54] = 47; p[55] = 116;
  p[56] = 50; p[57] = 55; p[58] = 46; p[59] = 97; p[60] = 105; p[61] = 47; p[62] = 35; p[63] = 47;
  p[64] = 34; p[65] = 44; p[66] = 34; p[67] = 119; p[68] = 101; p[69] = 98; p[70] = 83; p[71] = 111;
  p[72] = 99; p[73] = 107; p[74] = 101; p[75] = 116; p[76] = 68; p[77] = 101; p[78] = 98; p[79] = 117;
  p[80] = 103; p[81] = 103; p[82] = 101; p[83] = 114; p[84] = 85; p[85] = 114; p[86] = 108; p[87] = 34;
  p[88] = 58; p[89] = 32; p[90] = 34; p[91] = 119; p[92] = 115; p[93] = 58; p[94] = 47; p[95] = 47;
  p[96] = 49; p[97] = 50; p[98] = 55; p[99] = 46; p[100] = 48; p[101] = 46; p[102] = 48; p[103] = 46;
  p[104] = 49; p[105] = 58; p[106] = 57; p[107] = 56; p[108] = 57; p[109] = 51; p[110] = 47; p[111] = 100;
  p[112] = 101; p[113] = 118; p[114] = 116; p[115] = 111; p[116] = 111; p[117] = 108; p[118] = 115; p[119] = 47;
  p[120] = 112; p[121] = 97; p[122] = 103; p[123] = 101; p[124] = 47; p[125] = 84; p[126] = 69; p[127] = 83;
  p[128] = 84; p[129] = 49; p[130] = 34; p[131] = 125; p[132] = 93;
  const pp : []u8 = p[0..133];
  var ub : [17]u8 = [104, 116, 116, 112, 115, 58, 47, 47, 116, 50, 55, 46, 97, 105, 47, 35, 47];
  const uu : []u8 = ub[0..17];
  assert count_url_matches(pp, 133, uu) == 1;
}

test cm_v1_constant_return {
  assert cm_v1() == 7;
}

test cm_v2_scan_counts_the_url_field {
  assert cm_v2() == 1;
}
