// SPDX-License-Identifier: Apache-2.0
; specs/t27os/layout.t27 -- a small layout helper for T27 OS screens, so placement is computed and
; tested instead of tuned by eye.
; Owner, 2026-10-19: build a tool in .t27 that helps with layout.
; A row is a run of items on one centre line `mid`: icons and text. The helper answers the
; questions a screen keeps asking by hand:
;   where does the next item start (row_next: previous left + width + gap),
;   where is the top of an item of height h centred on the line (centre_top),
;   which text baseline puts the capitals of a font size on the line (baseline_for, cap_mid),
;   is a value on the device pixel grid (snap), and do two items share the line (same_line).
; Icons in one row share one height (ROW_ICON_H) so their top and bottom edges match; gaps in one
; row are equal (ROW_GAP). glass_window.t27 places its title bar with these functions.

module T27osLayout;

/// Capital height of the system UI font as a share of the point size (SF Pro / SF Mono, 0.70).
pub const CAP_SHARE : f64 = 0.70;
/// Icons in a title-bar row: one height, so the chevron and the logo start and end on the same lines.
pub const ROW_ICON_H : f64 = 11.0;
/// The gap between neighbours in a title-bar row.
pub const ROW_GAP : f64 = 8.0;
/// Two centre lines closer than this are the same line.
pub const LINE_EPS : f64 = 0.01;

/// Left edge of the item after one that starts at x and is w wide, gap apart.
pub fn row_next(x: f64, w: f64, gap: f64) -> f64 {
    return x + w + gap;
}

/// Top of an item of height h centred on the line mid.
pub fn centre_top(mid: f64, h: f64) -> f64 {
    return mid - 0.5 * h;
}

/// The centre of the capitals of a size-pt line drawn at baseline.
pub fn cap_mid(baseline: f64, size: f64) -> f64 {
    return baseline - 0.5 * CAP_SHARE * size;
}

/// The baseline that puts the capitals of a size-pt line centred on mid.
pub fn baseline_for(mid: f64, size: f64) -> f64 {
    return mid + 0.5 * CAP_SHARE * size;
}

/// v rounded to the nearest device pixel at the given backing scale (v >= 0).
pub fn snap(v: f64, scale: f64) -> f64 {
    const px : i64 = @as(i64, @intFromFloat(v * scale + 0.5));
    return @as(f64, @floatFromInt(px)) / scale;
}

/// True when two centre lines are the same line.
pub fn same_line(a: f64, b: f64) -> bool {
    return @abs(a - b) < LINE_EPS;
}

test a_row_steps_by_width_plus_gap {
    assert row_next(84.0, 5.0, ROW_GAP) == 97.0;
    assert row_next(row_next(84.0, 5.0, ROW_GAP), 13.0, ROW_GAP) == 118.0;
}

test icons_and_capitals_share_the_centre_line {
    const mid : f64 = 17.0;
    assert centre_top(mid, ROW_ICON_H) == 11.5;
    assert centre_top(mid, ROW_ICON_H) + ROW_ICON_H == 22.5;
    assert same_line(cap_mid(baseline_for(mid, 11.0), 11.0), mid);
    assert same_line(cap_mid(baseline_for(mid, 13.0), 13.0), mid);
    assert same_line(mid, mid + 0.5) == false;
}

test snap_lands_on_the_pixel_grid {
    assert snap(13.3, 2.0) == 13.5;
    assert snap(13.2, 2.0) == 13.0;
    assert snap(17.0, 2.0) == 17.0;
}

test gaps_are_positive {
    assert ROW_GAP > 0.0;
    assert ROW_ICON_H > 0.0;
    assert CAP_SHARE > 0.5 and CAP_SHARE < 0.8;
    // the gap opens the row: stepped with ROW_GAP the next item lands strictly past the zero-gap row
    assert row_next(84.0, 5.0, ROW_GAP) > row_next(84.0, 5.0, 0.0);
    assert row_next(0.0, 0.0, ROW_GAP) == ROW_GAP and row_next(0.0, 0.0, ROW_GAP) > 0.0;
    // the icon height holds a row open around its centre line
    assert centre_top(17.0, ROW_ICON_H) < 17.0 and centre_top(17.0, ROW_ICON_H) + ROW_ICON_H > 17.0;
    // the capital share lifts a baseline above the line it centres on (CAP_SHARE > 0)
    assert baseline_for(17.0, 11.0) > 17.0;
    // LINE_EPS splits: half an eps is still the same line, two eps are not
    assert same_line(0.0, 0.5 * LINE_EPS);
    assert same_line(0.0, 2.0 * LINE_EPS) == false;
}
