// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/experience_xai.t27 -- widget card for letter E (Experience XAI).
; Letter E's first instrument: lessons saved per ring, from specs/pipeline/experience_save.t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ExperienceXaiCard;

pub const KIND : str = "widget-card";
pub const ID : str = "experience-xai";
pub const TITLE : str = "Experience XAI: lessons saved per ring for letter E";
pub const DESCRIPTION : str = "Letter E's first instrument: lessons saved per ring, from specs/pipeline/experience_save.t27";

pub const EXPERIENCE_MAX_RINGS : u32 = 8;

/// How many rings the widget shows lessons saved for.
pub fn max_rings() -> u32 {
    return EXPERIENCE_MAX_RINGS;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "experience-xai";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Experience XAI: lessons saved per ring for letter E";
}

test max_rings_is_consistent {
    assert max_rings() == 8;
    assert EXPERIENCE_MAX_RINGS == 8;
}

test label_is_experience_xai {
    assert DESCRIPTION.len > 0;
}

invariant max_rings_constant {
    assert EXPERIENCE_MAX_RINGS == 8;
}

invariant description_names_experience_save {
    assert DESCRIPTION.len > 0;
}

endmodule
