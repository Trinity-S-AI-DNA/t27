// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/formal_conformance.t27 -- widget card for letter F (Formal Conformance).
; Letter F's first instrument: format verification vectors for letter F, the conformance checks
; that prove a number format follows its spec bit for bit. All numbers are computed by the spec itself.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module FormalConformanceCard;

pub const KIND : str = "widget-card";
pub const ID : str = "formal-conformance";
pub const TITLE : str = "Formal conformance: format verification vectors for letter F";
pub const DESCRIPTION : str = "Letter F's first instrument: format verification vectors, check by check.";

pub const CHECK_COUNT : u32 = 5;

pub const CHECK_NAMES : [5]str = [
    "layout",
    "bias",
    "round",
    "decode",
    "anchor",
];

/// How many conformance checks the widget card shows.
pub fn check_count() -> u32 {
    return CHECK_COUNT;
}

/// The name of check i (index 0..4), or "" past the end.
pub fn check_name(i: u32) -> str {
    if (i >= CHECK_COUNT) { return ""; }
    return CHECK_NAMES[i];
}

/// Is check i the anchor check (the phi^2 + 1/phi^2 = 3 vector)?
pub fn check_is_anchor(i: u32) -> bool {
    return i == 4;
}

/// The expected pass status of check i (all passing on a clean tree).
pub fn check_expected_pass(i: u32) -> bool {
    if (i >= CHECK_COUNT) { return false; }
    return true;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "formal-conformance";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Formal conformance: format verification vectors for letter F";
}

test check_count_is_5 {
    assert check_count() == 5;
    assert CHECK_COUNT == 5;
}

test check_names_cover_all_five {
    assert check_name(0) == "layout";
    assert check_name(1) == "bias";
    assert check_name(2) == "round";
    assert check_name(3) == "decode";
    assert check_name(4) == "anchor";
    assert check_name(5) == "";
}

test only_the_last_check_is_the_anchor {
    assert check_is_anchor(4);
    assert !check_is_anchor(0);
    assert !check_is_anchor(3);
}

test every_check_is_expected_to_pass {
    assert check_expected_pass(0);
    assert check_expected_pass(1);
    assert check_expected_pass(2);
    assert check_expected_pass(3);
    assert check_expected_pass(4);
}

invariant check_count_constant {
    assert CHECK_COUNT == 5;
}

invariant check_names_exist {
    assert check_name(0) == "layout";
    assert check_name(4) == "anchor";
}

endmodule
