// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/zero_touch_ux.t27 -- widget card for letter Z (Zero-Touch UX / Docs).
; Letter Z's first instrument: the documentation pages it serves, their names and count.
; All numbers are computed by the spec itself.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ZeroTouchUxCard;

pub const KIND : str = "widget-card";
pub const ID : str = "zero-touch-ux";
pub const TITLE : str = "Zero-Touch UX / Docs: documentation pages for letter Z";
pub const DESCRIPTION : str = "Letter Z's first instrument: the documentation pages served by the Zero-Touch UX / Docs domain, page by page.";

pub const PAGE_COUNT : u32 = 6;

pub const PAGE_NAMES : [6]str = [
    "t27.ai/",
    "/dashboard",
    "/start",
    "/chat",
    "/specs",
    "/blog and /blog/:slug",
];

/// How many documentation pages the widget card shows.
pub fn page_count() -> u32 {
    return PAGE_COUNT;
}

/// The name of page i, or "" past the end.
pub fn page_name(i: u32) -> str {
    if (i >= PAGE_COUNT) { return ""; }
    return PAGE_NAMES[i];
}

/// Is page i the home page (t27.ai/, the canonical first page)?
pub fn page_is_home(i: u32) -> bool {
    return i == 0;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "zero-touch-ux";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Zero-Touch UX / Docs: documentation pages for letter Z";
}

test page_count_is_six {
    assert page_count() == 6;
    assert PAGE_COUNT == 6;
}

test page_names_cover_home_to_blog {
    assert page_name(0) == "t27.ai/";
    assert page_name(1) == "/dashboard";
    assert page_name(5) == "/blog and /blog/:slug";
    assert page_name(6) == "";
}

test only_home_page_is_the_home_page {
    assert page_is_home(0);
    assert !page_is_home(1);
    assert !page_is_home(5);
}

invariant page_count_constant {
    assert PAGE_COUNT == 6;
}

invariant page_names_exist {
    assert page_name(0) == "t27.ai/";
    assert page_name(1) == "/dashboard";
    assert page_name(5) == "/blog and /blog/:slug";
}

endmodule
