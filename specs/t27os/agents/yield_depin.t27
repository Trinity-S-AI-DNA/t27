// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/yield_depin.t27 -- widget card for letter Y (Yield DePIN).
; Letter Y's first instrument: a DePIN proof readout.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module YieldDepinCard;

pub const KIND : str = "widget-card";
pub const ID : str = "yield-depin";
pub const TITLE : str = "Yield DePIN: proof readout for letter Y";
pub const DESCRIPTION : str = "Letter Y's first instrument: the DePIN proof readout.";

pub const PROOF_COUNT : u32 = 5;

pub fn proof_count() -> u32 {
    return PROOF_COUNT;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "yield-depin";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Yield DePIN: proof readout for letter Y";
}

test proof_count_is_5 {
    assert proof_count() == 5;
    assert PROOF_COUNT == 5;
}

invariant proof_count_constant {
    assert PROOF_COUNT == 5;
}

invariant proof_count_positive {
    assert PROOF_COUNT > 0;
}

endmodule
