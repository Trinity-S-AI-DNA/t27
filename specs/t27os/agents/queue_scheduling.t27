; specs/t27os/agents/queue_scheduling.t27 -- widget card for letter Q (Queue / Scheduling).
; Letter Q's first instrument: a wave loop queue readout, its five states,
; the count of queued waves and the state of each wave position.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module QueueSchedulingCard;

pub const KIND : str = "widget-card";
pub const ID : str = "queue-scheduling";
pub const TITLE : str = "Queue scheduling: wave loop queue for letter Q";
pub const DESCRIPTION : str = "Letter Q's first instrument: the wave loop queue of the Queen's scheduler, wave by wave.";

pub const QUEUE_COUNT : u32 = 5;

pub const QUEUE_STATES : [5]str = [
    "empty", "queued", "running", "draining", "done",
];

/// How many wave positions the queue holds.
pub fn queue_count() -> u32 {
    return QUEUE_COUNT;
}

/// The state name of wave position i (0..4), or "" past the end.
pub fn queue_state(i: u32) -> str {
    if (i >= QUEUE_COUNT) { return ""; }
    return QUEUE_STATES[i];
}

/// Is wave position i idle (empty or done)?
pub fn queue_is_idle(i: u32) -> bool {
    const s : str = queue_state(i);
    return s == "empty" or s == "done";
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "queue-scheduling";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Queue scheduling: wave loop queue for letter Q";
}

test queue_count_is_5 {
    assert queue_count() == 5;
    assert QUEUE_COUNT == 5;
}

test queue_states_cover_empty_to_done {
    assert queue_state(0) == "empty";
    assert queue_state(1) == "queued";
    assert queue_state(2) == "running";
    assert queue_state(4) == "done";
    assert queue_state(5) == "";
}

test empty_and_done_are_idle {
    assert queue_is_idle(0);
    assert queue_is_idle(4);
    assert !queue_is_idle(1);
    assert !queue_is_idle(2);
    assert !queue_is_idle(3);
}

invariant queue_count_constant {
    assert QUEUE_COUNT == 5;
}

invariant queue_states_exist {
    assert queue_state(0) == "empty";
    assert queue_state(4) == "done";
}

endmodule
