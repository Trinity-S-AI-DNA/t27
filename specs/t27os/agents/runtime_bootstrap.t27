// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/runtime_bootstrap.t27 -- widget card for letter R (Runtime Bootstrap).
; Letter R's first instrument: a boot-step ladder for the tri runtime.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module RuntimeBootstrapCard;

pub const KIND : str = "widget-card";
pub const ID : str = "runtime-bootstrap";
pub const TITLE : str = "Runtime Bootstrap: boot-step ladder for letter R";
pub const DESCRIPTION : str = "Letter R's first instrument: the tri runtime boot-step ladder.";

pub const BOOT_STEP_COUNT : u32 = 7;

pub fn boot_step_count() -> u32 {
    return BOOT_STEP_COUNT;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "runtime-bootstrap";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Runtime Bootstrap: boot-step ladder for letter R";
}

test boot_step_count_is_7 {
    assert boot_step_count() == 7;
    assert BOOT_STEP_COUNT == 7;
}

invariant boot_step_count_constant {
    assert BOOT_STEP_COUNT == 7;
}

invariant boot_step_count_positive {
    assert BOOT_STEP_COUNT > 0;
}

endmodule
