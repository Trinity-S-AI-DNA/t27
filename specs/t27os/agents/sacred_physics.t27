// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/sacred_physics.t27 -- widget card for letter P (Sacred Physics).
; Letter P's first instrument: a readout of the sacred physics lattice.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module SacredPhysicsCard;

pub const KIND : str = "widget-card";
pub const ID : str = "sacred-physics";
pub const TITLE : str = "Sacred Physics: lattice view for letter P";
pub const DESCRIPTION : str = "Letter P's first instrument: the sacred physics lattice readout.";

pub const LATTICE_SIZE : u32 = 27;

pub fn lattice_size() -> u32 {
    return LATTICE_SIZE;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "sacred-physics";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Sacred Physics: lattice view for letter P";
}

test lattice_size_is_27 {
    assert lattice_size() == 27;
    assert LATTICE_SIZE == 27;
}

invariant lattice_size_constant {
    assert LATTICE_SIZE == 27;
}

invariant lattice_size_positive {
    assert LATTICE_SIZE > 0;
}

endmodule
