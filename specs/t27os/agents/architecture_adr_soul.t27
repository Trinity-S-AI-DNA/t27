// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/architecture_adr_soul.t27 -- widget card for letter A (Architecture ADR SOUL).
; Letter A's first instrument: an ADR index card for specs/t27os/agents.t27 plus docs/adr/.
; All numbers are computed by the spec itself.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ArchitectureAdrSoulCard;

pub const KIND : str = "widget-card";
pub const ID : str = "architecture-adr-soul";
pub const TITLE : str = "Architecture ADR SOUL: ADR index card for letter A";
pub const DESCRIPTION : str = "Letter A's first instrument: an ADR index card for specs/t27os/agents.t27 plus docs/adr/.";

pub const ADR_COUNT : u32 = 4;

pub const ADR_NAMES : [4]str = [
    "t27a_isa", "t27mcp_dashboard", "glass_window", "domain_pulse",
];

pub const ADR_LETTER : [4]u32 = [
    1, 24, 1, 19,
];

pub const ADR_STATUS : [4]str = [
    "published", "draft", "published", "draft",
];

pub fn adr_count() -> u32 {
    return ADR_COUNT;
}

pub fn adr_name(i: u32) -> str {
    if (i >= ADR_COUNT) { return ""; }
    return ADR_NAMES[i];
}

pub fn adr_letter(i: u32) -> u32 {
    if (i >= ADR_COUNT) { return 0; }
    return ADR_LETTER[i];
}

pub fn adr_status(i: u32) -> str {
    if (i >= ADR_COUNT) { return ""; }
    return ADR_STATUS[i];
}

/// The letter that owns this widget card (A = ordinal 1).
pub fn owning_letter() -> u32 {
    return 1;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "architecture-adr-soul";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Architecture ADR SOUL: ADR index card for letter A";
}

test adr_count_and_entries_match_constants {
    assert adr_count() == 4;
    assert ADR_COUNT == 4;
}

test every_adr_references_a_valid_letter {
    var i : u32 = 0;
    while (i < ADR_COUNT) {
        assert adr_letter(i) >= 1;
        assert adr_letter(i) <= 27;
        i = i + 1;
    }
}

invariant adr_names_are_nonempty {
    var i : u32 = 0;
    while (i < ADR_COUNT) {
        assert adr_name(i).len > 0;
        i = i + 1;
    }
}

invariant adr_status_is_nonempty {
    var i : u32 = 0;
    while (i < ADR_COUNT) {
        assert adr_status(i).len > 0;
        i = i + 1;
    }
}

endmodule
