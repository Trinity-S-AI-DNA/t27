; specs/t27os/agents/metrics_telemetry.t27 -- widget card for letter M (Metrics / Telemetry).
; Letter M's first instrument: corpus measurements grouped into five metric categories,
; each with its own name, count and a flag that says whether the measurement is live.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module MetricsTelemetryCard;

pub const KIND : str = "widget-card";
pub const ID : str = "metrics-telemetry";
pub const TITLE : str = "Metrics telemetry: corpus measurements for letter M";
pub const DESCRIPTION : str = "Letter M's first instrument: five corpus measurement categories, counted by the spec itself.";

pub const METRIC_CATEGORY_COUNT : u32 = 5;

pub const METRIC_CATEGORY_NAMES : [5]str = [
    "corpus size",
    "pass rate",
    "fail rate",
    "seal age",
    "widget count",
];

pub const METRIC_CATEGORY_LIVE : [5]bool = [
    true,
    true,
    true,
    false,
    true,
];

pub const METRIC_CATEGORY_COUNTS : [5]u32 = [
    2227,
    1943,
    81,
    41,
    200,
];

/// How many metric categories the widget card shows.
pub fn metric_category_count() -> u32 {
    return METRIC_CATEGORY_COUNT;
}

/// The name of category i, or "" past the end.
pub fn metric_category_name(i: u32) -> str {
    if (i >= METRIC_CATEGORY_COUNT) { return ""; }
    return METRIC_CATEGORY_NAMES[i];
}

/// Is category i's measurement live (currently being computed)?
pub fn metric_category_live(i: u32) -> bool {
    if (i >= METRIC_CATEGORY_COUNT) { return false; }
    return METRIC_CATEGORY_LIVE[i];
}

/// The latest count of category i, or 0 past the end.
pub fn metric_category_count_value(i: u32) -> u32 {
    if (i >= METRIC_CATEGORY_COUNT) { return 0; }
    return METRIC_CATEGORY_COUNTS[i];
}

/// The ordinal (1..27) of the letter this widget serves: M is letter 13.
pub fn serving_letter() -> u32 {
    return 13;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "metrics-telemetry";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Metrics telemetry: corpus measurements for letter M";
}

test metric_category_count_is_5 {
    assert metric_category_count() == 5;
    assert METRIC_CATEGORY_COUNT == 5;
}

test metric_category_names_cover_five {
    assert metric_category_name(0) == "corpus size";
    assert metric_category_name(1) == "pass rate";
    assert metric_category_name(2) == "fail rate";
    assert metric_category_name(3) == "seal age";
    assert metric_category_name(4) == "widget count";
    assert metric_category_name(5) == "";
}

test metric_category_live_flags_match {
    assert metric_category_live(0);
    assert metric_category_live(1);
    assert metric_category_live(2);
    assert !metric_category_live(3);
    assert metric_category_live(4);
    assert !metric_category_live(5);
}

test metric_category_counts_are_reasonable {
    assert metric_category_count_value(0) == 2227;
    assert metric_category_count_value(1) == 1943;
    assert metric_category_count_value(2) == 81;
    assert metric_category_count_value(3) == 41;
    assert metric_category_count_value(4) == 200;
}

test serving_letter_is_m {
    assert serving_letter() == 13;
}

invariant metric_category_count_constant {
    assert METRIC_CATEGORY_COUNT == 5;
}

invariant metric_category_names_exist {
    assert metric_category_name(0) == "corpus size";
    assert metric_category_name(1) == "pass rate";
    assert metric_category_name(4) == "widget count";
}

invariant metric_category_live_flags_exist {
    assert metric_category_live(0);
    assert metric_category_live(1);
    assert metric_category_live(2);
    assert !metric_category_live(3);
    assert metric_category_live(4);
}

invariant metric_category_counts_exist {
    assert metric_category_count_value(0) == 2227;
    assert metric_category_count_value(4) == 200;
}

endmodule
