; specs/t27os/agents/universe_levels.t27 -- widget card for letter U (Universe Levels).
; Letter U's first instrument: the 27 petals as a level map.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module UniverseLevelsCard;

pub const KIND : str = "widget-card";
pub const ID : str = "universe-levels";
pub const TITLE : str = "Universe Levels: 27 petals as a level map for letter U";
pub const DESCRIPTION : str = "Letter U's first instrument: the 27-petal level map.";

pub const PETAL_COUNT : u32 = 27;

pub fn petal_count() -> u32 {
    return PETAL_COUNT;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "universe-levels";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Universe Levels: 27 petals as a level map for letter U";
}

test petal_count_is_27 {
    assert petal_count() == 27;
    assert PETAL_COUNT == 27;
}

invariant petal_count_constant {
    assert PETAL_COUNT == 27;
}

invariant petal_count_positive {
    assert PETAL_COUNT > 0;
}

endmodule
