// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/isa_registers.t27 -- widget card for letter I (ISA Registers).
; Letter I's first instrument: a readout of the 27 Coptic registers of the TRI27 ISA,
; their names, and whether each is zero. All numbers are computed by the spec itself.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ISARegistersCard;

pub const KIND : str = "widget-card";
pub const ID : str = "isa-registers";
pub const TITLE : str = "ISA registers: 27 Coptic registers of letter I";
pub const DESCRIPTION : str = "Letter I's first instrument: the TRI27 register file readout, register by register.";

pub const REGISTER_COUNT : u32 = 27;

pub const REGISTER_NAMES : [27]str = [
    "R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9",
    "R10", "R11", "R12", "R13", "R14", "R15", "R16", "R17", "R18", "R19",
    "R20", "R21", "R22", "R23", "R24", "R25", "R26",
];

/// How many registers the widget card shows.
pub fn register_count() -> u32 {
    return REGISTER_COUNT;
}

/// The name of register i (R0..R26), or "" past the end.
pub fn register_name(i: u32) -> str {
    if (i >= REGISTER_COUNT) { return ""; }
    return REGISTER_NAMES[i];
}

/// Is register i the zero register (R0, always reads as 0)?
pub fn register_is_zero(i: u32) -> bool {
    return i == 0;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "isa-registers";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "ISA registers: 27 Coptic registers of letter I";
}

test register_count_is_27 {
    assert register_count() == 27;
    assert REGISTER_COUNT == 27;
}

test register_names_cover_r0_to_r26 {
    assert register_name(0) == "R0";
    assert register_name(1) == "R1";
    assert register_name(26) == "R26";
    assert register_name(27) == "";
}

test only_r0_is_the_zero_register {
    assert register_is_zero(0);
    assert !register_is_zero(1);
    assert !register_is_zero(26);
}

invariant register_count_constant {
    assert REGISTER_COUNT == 27;
}

invariant register_names_exist {
    assert register_name(0) == "R0";
    assert register_name(1) == "R1";
    assert register_name(26) == "R26";
}

endmodule
