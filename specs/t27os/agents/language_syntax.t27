// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/language_syntax.t27 -- widget card for letter L (Language Syntax).
; Letter L's first instrument: a syntax-vNEXT sampler showing module lines of t27.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module LanguageSyntaxCard;

pub const KIND : str = "widget-card";
pub const ID : str = "language-syntax";
pub const TITLE : str = "Language Syntax: syntax-vNEXT sampler for letter L";
pub const DESCRIPTION : str = "Letter L's first instrument: syntax-vNEXT sampler of t27 module lines";

pub const SAMPLE_LINE_COUNT : u32 = 4;

pub const SAMPLE_LINES : [4]str = [
    "module LanguageSyntaxCard;",
    "pub const KIND : str = \"widget-card\";",
    "pub fn owning_letter() -> u32 { return 12; }",
    "endmodule",
];

pub fn owning_letter() -> u32 {
    return 12;
}

pub const INSTRUMENT_LABEL_FOR_LETTER_L : str = "LANGUAGE SYNTAX";

pub fn sample_line_count() -> u32 {
    return SAMPLE_LINE_COUNT;
}

pub fn sample_line(i: u32) -> str {
    if (i >= SAMPLE_LINE_COUNT) { return ""; }
    return SAMPLE_LINES[i];
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "language-syntax";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "Language Syntax: syntax-vNEXT sampler for letter L";
}

test owning_letter_is_L {
    assert owning_letter() == 12;
}

test sample_lines_exist {
    assert sample_line_count() == 4;
    assert sample_line(0) == "module LanguageSyntaxCard;";
    assert sample_line(1) == "pub const KIND : str = \"widget-card\";";
    assert sample_line(2) == "pub fn owning_letter() -> u32 { return 12; }";
    assert sample_line(3) == "endmodule";
    assert sample_line(4) == "";
}

invariant owning_letter_constant {
    assert owning_letter() == 12;
}

invariant sample_line_count_constant {
    assert SAMPLE_LINE_COUNT == 4;
}

endmodule
