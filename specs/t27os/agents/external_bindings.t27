// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/external_bindings.t27 -- widget card for letter X (External Bindings).
; Letter X's first instrument: a language-binding parity table.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ExternalBindingsCard;

pub const KIND : str = "widget-card";
pub const ID : str = "external-bindings";
pub const TITLE : str = "External Bindings: language-binding parity table for letter X";
pub const DESCRIPTION : str = "Letter X's first instrument: language-binding parity readout.";

pub const BINDING_COUNT : u32 = 6;

pub fn binding_count() -> u32 {
    return BINDING_COUNT;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "external-bindings";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "External Bindings: language-binding parity table for letter X";
}

test binding_count_is_6 {
    assert binding_count() == 6;
    assert BINDING_COUNT == 6;
}

invariant binding_count_constant {
    assert BINDING_COUNT == 6;
}

invariant binding_count_positive {
    assert BINDING_COUNT > 0;
}

endmodule
