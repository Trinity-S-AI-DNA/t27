// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/de_zig_migration.t27 -- widget card for letter D (De-Zig Migration).
; Letter D's first instrument: migration burn-down of t27c stages on Zig-free tree.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module DeZigMigrationCard;

pub const KIND : str = "widget-card";
pub const ID : str = "de-zig-migration";
pub const TITLE : str = "De-Zig Migration: t27c stages burn-down for letter D";
pub const DESCRIPTION : str = "Letter D's first instrument: migration burn-down of t27c stages on Zig-free tree";

pub const MIGRATION_STAGE_COUNT : u32 = 5;

pub const STAGES : [5]str = [
    "parse",
    "typecheck",
    "codegen",
    "seal",
    "verify",
];

/// How many migration stages the widget tracks.
pub fn stage_count() -> u32 {
    return MIGRATION_STAGE_COUNT;
}

/// The name of stage i, or "" past the end.
pub fn stage_name(i: u32) -> str {
    if (i >= MIGRATION_STAGE_COUNT) { return ""; }
    return STAGES[i];
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "de-zig-migration";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "De-Zig Migration: t27c stages burn-down for letter D";
}

test stage_count_is_consistent {
    assert stage_count() == 5;
    assert MIGRATION_STAGE_COUNT == 5;
}

test stages_exist {
    assert stage_name(0) == "parse";
    assert stage_name(1) == "typecheck";
    assert stage_name(2) == "codegen";
    assert stage_name(3) == "seal";
    assert stage_name(4) == "verify";
    assert stage_name(5) == "";
}

invariant stage_count_constant {
    assert MIGRATION_STAGE_COUNT == 5;
}

invariant stages_exist {
    assert STAGES[0] == "parse";
    assert STAGES[1] == "typecheck";
    assert STAGES[2] == "codegen";
    assert STAGES[3] == "seal";
    assert STAGES[4] == "verify";
}

endmodule
