// SPDX-License-Identifier: Apache-2.0
; Closes #11275
// specs/t27os/ladder.t27 -- the LADDER: the rung law for every LLM client on a
// T27 OS node (owner brief 2026-10-27, named after the rung metaphor the night
// was fought with). A client points at the local Ladder endpoint; the Ladder
// walks the rungs in the order below and serves the first rung that answers a
// TURN-SIZED request with 200. Laws:
//   1. Rungs are tried strictly in ladder order; a rung is skipped only on its
//      own refusal (429 quota, 402 unfunded, 5xx, timeout) or because it is
//      UNWIRED (law 8).
//   2. Every probe and every serve attempt is TURN-SIZED (PROBE_TOKENS
//      minimum): a 1-token answer is not evidence (measured 2026-10-26/27 --
//      one-token probes passed on keys that refused real turns).
//   3. FAIL CLOSED: when every rung refuses, the client receives a 503 JSON
//      naming the refusal of EVERY rung that was tried, in ladder order, so
//      that a tail rung cannot mask an earlier failure (owner 2026-11-01: the
//      old "last refusal" rule showed a tail rung's message for a z.ai or
//      ollama failure) -- never a silent fallback to an unverified answer,
//      never a retry loop without end.
//   4. The ladder endpoint binds LOOPBACK only: it is node plumbing, not a
//      network service.
//   5. A rung's key never leaves the node; the ladder reads keys from the
//      node's own store, clients authenticate to the ladder locally or not at
//      all over loopback.
//   6. THE REQUEST SHAPE IS A PROPERTY OF THE MODEL (measured 2026-11-05,
//      specs/t27os/lagger.t27 law 5): z.ai answers 400 with the provider code
//      1210 ("this model always engages in thinking and cannot be disabled")
//      when a request carries "thinking":{"type":"disabled"} for glm-5.3-flash
//      -- in every form (disabled AND low) -- while the same request WITHOUT
//      the member reaches the quota layer. So the member is OMITTED for
//      glm-5.3-flash and KEPT (disabled) for the two heads that accept it:
//      glm-4.7-flash answered 429/1305 (an overload, so the shape was
//      accepted) and glm-4.5-flash answers 200 with it (2026-11-22). A client
//      that sent a thinking member of its own keeps it: the ladder never adds
//      a second one.
//   7. SERVICE NOISE: a 1305/529 on glm-4.7-flash (owner finding 2026-10-25,
//      re-measured 2026-10-27) is transient service noise -- it says nothing
//      about the key or the model's presence on the plan. It rests the rung
//      NOISE_REST_S and keeps its place; only a quota-class refusal (429
//      quota, 402 unfunded) may demote a rung or mark its key bad.
//   8. UNWIRED: a rung with no key, or with no probed 200 on a turn-sized
//      request, is skipped with NO network call and recorded as unwired
//      (STATUS_UNWIRED). The ladder never makes up an upstream status for it.
//   9. THE PROBE WALKS THE MATRIX: a rung with several keys and several
//      models is proven by the first (model, key) pair that answers a
//      TURN-SIZED request with 200. The pairs are walked in ladder order --
//      the models of the rung's table, each with every key the node holds --
//      one attempt per pair, bounded by the pairs that exist (at most the
//      models of the table times MAX_KEYS keys). A client refusal (4xx)
//      advances to the next pair; a transient answer (5xx, 529, 1305) or
//      silence ends that rung's probe without claiming anything about the
//      pairs that were not tried. The pair that proved the rung is that
//      rung's sticky start: the next serve begins with it, and the probe of
//      another rung can never take it away.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsLadder;

use std::mem::bytes_eq;
use t27os::keys::MAX_KEYS;

// -- The rungs, in ladder order (index = attempt order) --
// Remote rungs come first; the node-local ollama rung is always last.
// RUNG 0: nvidia direct (nvapi keys listed the catalogue with 200 and refused
//         chat-completions with 403 on 2026-10-26, so this rung is live only
//         while its own probe state says PROBE_OK -- never assumed)
// RUNG 1: z.ai free pool, glm-4.5-flash (the coding-tier head, 5 rotating keys)
// RUNG 2: openrouter (after credits; the key limit is not a balance)
// RUNG 3: the node's own local ollama endpoint, gemma4:31b-cloud
// History 2026-11-01: the owner removed the deepseek rung (unfunded account);
// RUNG_COUNT stays 4 so the 4-bit tried mask (15) of ladder_speed.t27 holds.
pub const RUNG_COUNT : usize = 4;
pub const RUNG_NVIDIA : usize = 0;
pub const RUNG_ZAI : usize = 1;
pub const RUNG_OPENROUTER : usize = 2;
pub const RUNG_OLLAMA : usize = 3;

const RUNGS : u32 = RUNG_COUNT;

// -- Law 8: probe state and the unwired record --
// A probe state per rung, written by a TURN-SIZED probe only (law 2).
pub const PROBE_NONE : u32 = 0;
pub const PROBE_OK : u32 = 1;
pub const PROBE_REFUSED : u32 = 2;

// Recorded for a rung that made no network call. Not an HTTP status (those are
// 100 and up), so it can never be mistaken for an upstream answer.
pub const STATUS_UNWIRED : u32 = 0;

// -- Turn-sized evidence law --
pub const PROBE_TOKENS : u32 = 100;
pub const SERVE_MIN_TOKENS : u32 = PROBE_TOKENS;

// -- Fail-closed answer when every rung refuses --
pub const LAST_RESORT_STATUS : u32 = 503;

// -- Port: loopback only (law 4) --
pub const LADDER_PORT : u32 = 3131;

/// The next rung to try, given the last tried one. Runs 0..RUNG_COUNT-1 in
/// order; past the last rung the ladder is exhausted (fail closed).
pub fn next_rung(last_tried : usize) -> usize {
    return last_tried + 1;
}

/// A rung is exhausted when its index passed the last one.
pub fn ladder_exhausted(last_tried : usize) -> bool {
    return last_tried >= RUNG_COUNT;
}

/// A refusal moves the ladder on; a 200 stays. Anything in 429/402/5xx is a
/// refusal; other codes (4xx client mistakes) are ALSO refusals -- the ladder
/// never debugs the client, it just moves on.
pub fn refusal(status : u32) -> bool {
    if (status == 200) { return false; }
    return true;
}

// -- Law 6: the request shape is a property of the model (measured 2026-11-05) --
// z.ai answers 400 with the provider code 1210 ("this model always engages in thinking and cannot be
// disabled") when a request carries "thinking":{"type":"disabled"} for glm-5.3-flash, in every form
// (disabled AND low); the same request WITHOUT the member reaches the quota layer. So the member is
// OMITTED for that model and KEPT (disabled) for the two heads that accept it: glm-4.7-flash answered
// 429/1305 (an overload, so the shape was accepted) and glm-4.5-flash answers 200 with it (2026-11-22).
// The 2026-10-27 timing (thinking-off 11.7 s, thinking-on 45 s drain) was measured on the head the
// provider now refuses: it is history, not a rule.
pub const SHAPE_NONE : u32 = 0;
pub const SHAPE_DISABLED : u32 = 1;

/// The shape of one zai model: SHAPE_NONE (no thinking member at all) or SHAPE_DISABLED.
pub fn zai_model_shape(model : []const u8) -> u32 {
    if (bytes_eq(model, "glm-4.7-flash")) { return SHAPE_DISABLED; }
    if (bytes_eq(model, "glm-4.5-flash")) { return SHAPE_DISABLED; }
    return SHAPE_NONE;
}

/// True when the call carries "thinking":{"type":"disabled"}: the model accepts that shape and the
/// client sent no thinking member of its own (a client's member is kept and never duplicated).
pub fn zai_thinking_off(model : []const u8, client_asked : bool) -> bool {
    if (client_asked) { return false; }
    return zai_model_shape(model) == SHAPE_DISABLED;
}

// -- Law 7: service noise never demotes (owner finding 2026-10-25) --
// Same rest the key watcher gives an overloaded key (keys.t27
// OVERLOAD_COOLDOWN_S): the two laws must not disagree on 60 s.
pub const NOISE_REST_S : u64 = 60;

/// Transient service noise: overload and server errors, back on its own.
pub fn transient(status : u32) -> bool {
    if (status == 529 or status == 1305) { return true; }
    return status >= 500 and status < 600;
}

/// Only a quota-class refusal may demote a rung or mark its key bad: 429 says
/// the pool is drained, 402 says the account is unfunded. Noise never demotes.
pub fn demotes_rung(status : u32) -> bool {
    return status == 429 or status == 402;
}

// -- Law 8: a rung with no key or no probed 200 makes no network call --

/// The probe state after one turn-sized probe: a 200 with at least PROBE_TOKENS
/// of answer is PROBE_OK; a 200 with fewer proves nothing (law 2) and stays
/// PROBE_NONE; any other status is PROBE_REFUSED (nvidia 403, 2026-10-26).
pub fn probe_after(status : u32, tokens : u32) -> u32 {
    if (status != 200) { return PROBE_REFUSED; }
    if (tokens < PROBE_TOKENS) { return PROBE_NONE; }
    return PROBE_OK;
}

/// Wired = holds a key AND its probe state is PROBE_OK. A rung that is not wired
/// is skipped with no network call.
pub fn rung_wired(has_key : bool, probe : u32) -> bool {
    return has_key and probe == PROBE_OK;
}

/// What the ladder records for one rung: the upstream status when the rung was
/// called, STATUS_UNWIRED when it was not. Never an invented upstream status.
pub fn recorded_status(wired : bool, upstream : u32) -> u32 {
    if (wired) { return upstream; }
    return STATUS_UNWIRED;
}

// -- Law 9: the probe walks the rung's (model, key) matrix --
// The pairs of one rung are the models of its table, each with every key the node holds. The walk
// visits them in ladder order, one attempt per pair, and the pair that proves the rung becomes that
// rung's sticky start. The decision functions below are pure: the host half (ladder_serve.t27) only
// moves bytes.

/// What the probe does after one attempt: advance to the next pair, hold the winner, or end this
/// rung's probe.
pub const PROBE_STEP_NEXT : u32 = 0;
pub const PROBE_STEP_HOLD : u32 = 1;
pub const PROBE_STEP_STOP : u32 = 2;

/// The next step of the probe after one attempt: a turn-sized 200 (law 2) HOLDS the pair -- the rung
/// is proven and the pair becomes its sticky start; a client refusal (4xx) advances to the next pair;
/// a transient answer (5xx, 529, 1305) or silence STOPS this rung's probe, so the pairs that were not
/// tried are left unclaimed; a 200 below PROBE_TOKENS is not proof and advances like a refusal. The
/// walk ends when the matrix is spent.
pub fn probe_step(status : u32, tokens : u32, att : u32, cap : u32) -> u32 {
    if (status == 200 and tokens >= PROBE_TOKENS) { return PROBE_STEP_HOLD; }
    if (att + 1 >= cap) { return PROBE_STEP_STOP; }
    if (status == 0) { return PROBE_STEP_STOP; }
    if (status >= 500) { return PROBE_STEP_STOP; }
    return PROBE_STEP_NEXT;
}

/// The probe state a rung ends in after the walk: PROBE_OK when a turn-sized 200 proved it,
/// PROBE_REFUSED when the walk ended in a client refusal (the rung refused and the matrix is spent),
/// PROBE_NONE when it ended in a transient answer or in silence (nothing is claimed about the rung
/// or its keys -- law 7 says a transient answer never refuses a rung).
pub fn probe_end(status : u32, tokens : u32) -> u32 {
    if (status == 200) { return probe_after(status, tokens); }
    if (status >= 400 and status < 500) { return PROBE_REFUSED; }
    return PROBE_NONE;
}

// -- Law 3: the 503 names every rung that was tried, in ladder order --
// `tried` is the 4-bit mask of ladder_speed.t27 (bit r set = rung r was called
// and refused; 15 = all four). Bits above RUNG_COUNT are ignored.

/// True when the 503 body carries an entry for this rung.
pub fn names_refusal(tried : u32, rung : u32) -> bool {
    if (rung >= RUNGS) { return false; }
    return (tried >> rung) % 2 == 1;
}

/// The next rung named in the 503 body at or after `from`, in ladder order;
/// RUNG_COUNT when none is left.
pub fn next_named(tried : u32, from : u32) -> u32 {
    var r : u32 = from;
    while (r < RUNGS) {
        if ((tried >> r) % 2 == 1) { return r; }
        r = r + 1;
    }
    return RUNGS;
}

/// How many entries the 503 body carries.
pub fn named_count(tried : u32) -> u32 {
    var n : u32 = 0;
    var r : u32 = 0;
    while (r < RUNGS) {
        if ((tried >> r) % 2 == 1) { n = n + 1; }
        r = r + 1;
    }
    return n;
}

// -- The rung table: the one home of names, endpoints and models --
// ladder_serve.t27 reads it for /health, for every upstream call and for the
// 503 body; nothing there keeps a second copy. The nvidia and openrouter
// model ids are the lane's choice (2026-11-01, no measurement behind them
// yet): a rung whose id the provider does not know answers 4xx and the probe
// leaves it unwired, so a wrong id fails closed.
/// CALL_TIMEOUT_MS is an idle limit (#14231): curl aborts a call that moves under 1 B/s for that
/// long, so a silent provider is dropped fast while a reply that keeps streaming is not cut.
pub const CALL_TIMEOUT_MS : u64 = 90000;
/// The total backstop of one provider call, however fast it streams (curl max-time, #14231).
pub const CALL_MAX_MS : u64 = 600000;

/// The rung's name, as /health and the 503 body spell it; "" past the table.
pub fn rung_name(r : usize) -> []const u8 {
    if (r == RUNG_NVIDIA) { return "nvidia"; }
    if (r == RUNG_ZAI) { return "zai"; }
    if (r == RUNG_OLLAMA) { return "ollama"; }
    if (r == RUNG_OPENROUTER) { return "openrouter"; }
    return "";
}

/// The chat-completions endpoint of the rung; "" past the table.
pub fn rung_url(r : usize) -> []const u8 {
    if (r == RUNG_NVIDIA) { return "https://integrate.api.nvidia.com/v1/chat/completions"; }
    if (r == RUNG_ZAI) { return "https://api.z.ai/api/coding/paas/v4/chat/completions"; }
    if (r == RUNG_OLLAMA) { return "http://127.0.0.1:11434/v1/chat/completions"; }
    if (r == RUNG_OPENROUTER) { return "https://openrouter.ai/api/v1/chat/completions"; }
    return "";
}

/// A rung that needs no key: the node's own ollama (loopback, no auth header).
pub fn rung_keyless(r : usize) -> bool {
    return r == RUNG_OLLAMA;
}

/// The largest model table of a rung (the zai and nvidia rungs): 3 models.
pub const MAX_MODEL_COUNT : u32 = 3;

/// How many models the rung tries, in order, before it counts as refused.
pub fn rung_model_count(r : usize) -> usize {
    if (r == RUNG_ZAI or r == RUNG_NVIDIA) { return @as(usize, @intCast(MAX_MODEL_COUNT)); }
    if (r < RUNG_COUNT) { return 1; }
    return 0;
}

/// The maximum number of (model, key) attempts one rung's probe may make: the models of the rung's
/// table times the keys the node holds, never more than MAX_KEYS (keys.t27) * MAX_MODEL_COUNT.
pub const PROBE_CAP : u32 = MAX_KEYS * MAX_MODEL_COUNT;

/// How many unique (model, key) pairs a rung can attempt: the models of its table times the keys the
/// node holds (a keyless rung counts one), bounded by PROBE_CAP.
pub fn rung_probe_cap(r : usize, key_count : u32) -> u32 {
    const nm : usize = rung_model_count(r);
    if (nm == 0 or key_count == 0) { return 0; }
    const nk : u32 = if (rung_keyless(r)) { 1 } else { key_count };
    const total : u32 = @as(u32, @intCast(nm)) * nk;
    if (total > PROBE_CAP) { return PROBE_CAP; }
    return total;
}

/// Model m of the rung (0-based, in try order); "" past the table.
pub fn rung_model(r : usize, m : usize) -> []const u8 {
    if (r == RUNG_NVIDIA and m == 0) { return "minimaxai/minimax-m3.1-flash"; }
    if (r == RUNG_NVIDIA and m == 1) { return "nvidia/nemotron-3.5-lightning-30b-a3b"; }
    if (r == RUNG_NVIDIA and m == 2) { return "nvidia/nemotron-3-ultra-550b-a55b"; }
    if (r == RUNG_ZAI and m == 0) { return "glm-5.3-flash"; }
    if (r == RUNG_ZAI and m == 1) { return "glm-4.7-flash"; }
    if (r == RUNG_ZAI and m == 2) { return "glm-4.5-flash"; }
    if (r == RUNG_OLLAMA and m == 0) { return "gemma4:31b-cloud"; }
    if (r == RUNG_OPENROUTER and m == 0) { return "z-ai/glm-4.5-air:free"; }
    return "";
}

/// The class a refusal is named by in the 503 body (law 3), from the upstream
/// status the rung recorded: 0 is a call that got no HTTP answer at all.
pub fn refusal_class(status : u32) -> []const u8 {
    if (status == 200) { return "ok"; }
    if (status == 0) { return "unreachable"; }
    if (status == 402) { return "unfunded"; }
    if (status == 429) { return "quota"; }
    if (status == 401 or status == 403) { return "denied"; }
    if (transient(status)) { return "noise"; }
    if (status >= 400 and status < 500) { return "client"; }
    return "other";
}

test ladder_consts_hold {
    var rc : usize = RUNG_COUNT;
    var pt : u32 = PROBE_TOKENS;
    var port : u32 = LADDER_PORT;
    var last : u32 = LAST_RESORT_STATUS;
    assert rc == 4;
    assert pt == 100;
    assert port == 3131;
    assert last == 503;
}

test the_ladder_walks_in_order_and_fails_closed {
    assert ladder_exhausted(3) == false;
    assert ladder_exhausted(4) == true;
    assert next_rung(0) == 1;
    assert next_rung(1) == 2;
    assert next_rung(2) == 3;
}

test only_200_serves {
    assert refusal(200) == false;
    assert refusal(429) == true;
    assert refusal(402) == true;
    assert refusal(500) == true;
    assert refusal(503) == true;
}

test the_zai_head_runs_thinking_off_unless_the_client_asks {
    assert zai_thinking_off("glm-4.5-flash", false) == true;
    assert zai_thinking_off("glm-4.7-flash", false) == true;
    assert zai_thinking_off("glm-5.3-flash", false) == false;
    assert zai_thinking_off("glm-5.3-flash", true) == false;
    assert zai_thinking_off("", false) == false;
    // The shape is a property of the model (law 6), not a timer: 5.3 gets no
    // thinking member at all, 4.7 and 4.5 get exactly one disabled member.
    assert zai_model_shape("glm-5.3-flash") == SHAPE_NONE;
    assert zai_model_shape("glm-4.7-flash") == SHAPE_DISABLED;
    assert zai_model_shape("glm-4.5-flash") == SHAPE_DISABLED;
    assert zai_model_shape("gemma4:31b-cloud") == SHAPE_NONE;
}

test service_noise_rests_and_never_demotes {
    assert transient(1305) == true;
    assert transient(529) == true;
    assert transient(503) == true;
    assert transient(429) == false;
    assert transient(402) == false;
    assert demotes_rung(429) == true;
    assert demotes_rung(402) == true;
    assert demotes_rung(1305) == false;
    assert demotes_rung(529) == false;
    assert demotes_rung(503) == false;
}

test the_rung_table_is_nvidia_zai_openrouter_ollama {
    var rc : usize = RUNG_COUNT;
    var n : usize = RUNG_NVIDIA;
    var z : usize = RUNG_ZAI;
    var r : usize = RUNG_OPENROUTER;
    var o : usize = RUNG_OLLAMA;
    assert rc == 4;
    assert n == 0;
    assert z == 1;
    assert r == 2;
    assert o == 3;
    assert r + 1 == o;
    assert o + 1 == rc;
}

test a_rung_without_a_key_or_a_probed_200_is_unwired {
    assert rung_wired(true, PROBE_OK) == true;
    assert rung_wired(false, PROBE_OK) == false;
    assert rung_wired(true, PROBE_NONE) == false;
    assert rung_wired(true, PROBE_REFUSED) == false;
    assert rung_wired(false, PROBE_NONE) == false;
}

test the_nvidia_403_leaves_its_rung_unwired {
    assert probe_after(403, 100) == PROBE_REFUSED;
    assert probe_after(403, 0) == PROBE_REFUSED;
    assert rung_wired(true, probe_after(403, 100)) == false;
    assert rung_wired(true, probe_after(200, 100)) == true;
}

test a_one_token_answer_is_not_a_probe {
    assert probe_after(200, 1) == PROBE_NONE;
    assert probe_after(200, 99) == PROBE_NONE;
    assert probe_after(200, 100) == PROBE_OK;
    assert rung_wired(true, probe_after(200, 1)) == false;
}

test an_unwired_rung_records_unwired_never_an_upstream_status {
    assert recorded_status(false, 402) == STATUS_UNWIRED;
    assert recorded_status(false, 503) == STATUS_UNWIRED;
    assert recorded_status(false, 200) == STATUS_UNWIRED;
    assert recorded_status(true, 402) == 402;
    assert recorded_status(true, 429) == 429;
    assert STATUS_UNWIRED < 100;
}

test the_503_names_every_tried_rung_in_ladder_order {
    // z.ai, openrouter and ollama were called and refused; nvidia was unwired.
    assert names_refusal(14, 0) == false;
    assert names_refusal(14, 1) == true;
    assert names_refusal(14, 2) == true;
    assert names_refusal(14, 3) == true;
    assert next_named(14, 0) == 1;
    assert next_named(14, 2) == 2;
    assert next_named(14, 3) == 3;
    assert next_named(14, 4) == 4;
    assert named_count(14) == 3;
}

test a_tail_rung_cannot_mask_an_earlier_refusal {
    // openrouter (2) and ollama (3) refused: the body names openrouter first
    // and both entries, not the tail rung alone.
    assert next_named(12, 0) == 2;
    assert next_named(12, 3) == 3;
    assert named_count(12) == 2;
    assert names_refusal(12, 3) == true;
    assert names_refusal(12, 2) == true;
}

test the_503_covers_all_four_rungs_and_ignores_stray_bits {
    assert named_count(15) == 4;
    assert named_count(31) == 4;
    assert names_refusal(31, 4) == false;
    assert next_named(15, 0) == 0;
    assert named_count(0) == 0;
    assert next_named(0, 0) == 4;
    assert LAST_RESORT_STATUS == 503;
    assert refusal(LAST_RESORT_STATUS) == true;
}

test the_rung_table_has_no_deepseek_and_no_empty_row {
    var r : usize = 0;
    while (r < RUNG_COUNT) {
        assert rung_name(r).len > 0;
        assert rung_url(r).len > 0;
        assert rung_model_count(r) > 0;
        assert rung_model(r, 0).len > 0;
        assert rung_model(r, rung_model_count(r)).len == 0;
        assert rung_name(r)[0] != 100;
        r = r + 1;
    }
    assert rung_name(RUNG_COUNT).len == 0;
    assert rung_model_count(RUNG_COUNT) == 0;
    assert rung_name(RUNG_NVIDIA)[0] == 110;
    assert rung_name(RUNG_ZAI)[0] == 122;
    assert rung_model_count(RUNG_ZAI) == 3;
    assert rung_model(RUNG_ZAI, 0).len == 13;
    // Law 6: the shape is a property of the model. Model 0 of the zai table is glm-5.3-flash, which
    // takes NO thinking member; model 2 is glm-4.5-flash, which takes one disabled member.
    assert zai_thinking_off(rung_model(RUNG_ZAI, 0), false) == false;
    assert zai_thinking_off(rung_model(RUNG_ZAI, 2), false) == true;
    assert rung_keyless(RUNG_OLLAMA) == true;
    assert rung_keyless(RUNG_ZAI) == false;
    assert CALL_TIMEOUT_MS == 90000;
    assert CALL_MAX_MS == 600000;
    assert CALL_MAX_MS > CALL_TIMEOUT_MS;
}

test a_refusal_is_named_by_its_class {
    assert refusal_class(200).len == 2;
    assert refusal_class(0)[0] == 117;
    assert refusal_class(402)[0] == 117;
    assert refusal_class(429)[0] == 113;
    assert refusal_class(403)[0] == 100;
    assert refusal_class(1305)[0] == 110;
    assert refusal_class(503)[0] == 110;
    assert refusal_class(404)[0] == 99;
    assert refusal_class(302)[0] == 111;
}

invariant an_unwired_rung_never_shows_an_upstream_status
    assert recorded_status(false, 402) == STATUS_UNWIRED
    assert recorded_status(false, 429) == STATUS_UNWIRED
    assert rung_wired(false, PROBE_OK) == false

test probe_step_steps_through_the_matrix_correctly {
    // 200 with enough tokens holds the pair
    assert probe_step(200, 100, 0, 15) == PROBE_STEP_HOLD;
    assert probe_step(200, 240, 1, 15) == PROBE_STEP_HOLD;

    // 200 with insufficient tokens advances (like a refusal)
    assert probe_step(200, 99, 2, 15) == PROBE_STEP_NEXT;

    // 4xx refusals advance to next pair
    assert probe_step(429, 0, 3, 15) == PROBE_STEP_NEXT;
    assert probe_step(402, 0, 4, 15) == PROBE_STEP_NEXT;
    assert probe_step(400, 0, 5, 15) == PROBE_STEP_NEXT;

    // 5xx and no answer stop the rung's probe
    assert probe_step(500, 0, 6, 15) == PROBE_STEP_STOP;
    assert probe_step(503, 0, 7, 15) == PROBE_STEP_STOP;
    assert probe_step(0, 0, 8, 15) == PROBE_STEP_STOP;

    // Exhaustion stops: the last pair of the matrix ends the walk
    assert probe_step(429, 0, 13, 15) == PROBE_STEP_NEXT;
    assert probe_step(429, 0, 14, 15) == PROBE_STEP_STOP;
}

test probe_cap_bounds_the_matrix_at_most_model_count_times_key_count {
    // ZAI rung with the 5 observed keys: 3 models * 5 keys = 15 pairs
    assert rung_probe_cap(RUNG_ZAI, 5) == 15;
    assert rung_probe_cap(RUNG_ZAI, 8) == PROBE_CAP; // MAX_KEYS (8) * 3 models

    // nvidia: 3 models * the keys; the other rungs: 1 model * the keys the node holds
    assert rung_probe_cap(RUNG_NVIDIA, 5) == 15; // 3 models * 5 keys
    assert rung_probe_cap(RUNG_OPENROUTER, 5) == 5;
    assert rung_probe_cap(RUNG_OLLAMA, 1) == 1; // keyless

    // Never zero for a wired rung that holds keys, never above the cap
    assert rung_probe_cap(RUNG_ZAI, 5) > 0;
    assert rung_probe_cap(RUNG_NVIDIA, 5) > 0;
    assert rung_probe_cap(RUNG_ZAI, 100) == PROBE_CAP;
    assert rung_probe_cap(RUNG_ZAI, 0) == 0;
}

test nvidia_rung_names_only_models_the_live_catalogue_serves {
    // #14213: the retired id answered 410; these three answered 200 on 2026-11-22.
    assert rung_model_count(RUNG_NVIDIA) == 3;
    assert bytes_eq(rung_model(RUNG_NVIDIA, 0), "minimaxai/minimax-m3.1-flash");
    assert bytes_eq(rung_model(RUNG_NVIDIA, 1), "nvidia/nemotron-3.5-lightning-30b-a3b");
    assert bytes_eq(rung_model(RUNG_NVIDIA, 2), "nvidia/nemotron-3-ultra-550b-a55b");
    assert bytes_eq(rung_model(RUNG_NVIDIA, 3), "");
    assert rung_model_count(RUNG_OPENROUTER) == 1;
    assert rung_model_count(RUNG_OLLAMA) == 1;
}

test glm_53_flash_never_gets_thinking_member_while_47_and_45_do {
    // glm-5.3-flash never gets thinking member
    assert zai_thinking_off("glm-5.3-flash", false) == false;
    assert zai_thinking_off("glm-5.3-flash", true) == false;

    // glm-4.7-flash and glm-4.5-flash get thinking:disabled when client didn't ask
    assert zai_thinking_off("glm-4.7-flash", false) == true;
    assert zai_thinking_off("glm-4.5-flash", false) == true;

    // Client thinking member is preserved and never duplicated
    assert zai_thinking_off("glm-4.7-flash", true) == false;
    assert zai_thinking_off("glm-4.5-flash", true) == false;

    // Non-zai models don't use thinking member
    assert zai_thinking_off("gemma4:31b-cloud", false) == false;
    assert zai_thinking_off("minimaxai/minimax-m3.1-flash", false) == false;
    assert zai_thinking_off("z-ai/glm-4.5-air:free", false) == false;
}

test probe_walk_covers_15_unique_pairs_for_zai {
    const zai_cap : u32 = rung_probe_cap(RUNG_ZAI, 5);
    assert zai_cap == 15; // 3 models * 5 observed keys

    // Every (model, key) pair of the matrix is reachable and a turn-sized 200 holds it
    var model_idx : u32 = 0;
    while (model_idx < 3) {
        var key_idx : u32 = 0;
        while (key_idx < 5) {
            const attempt : u32 = model_idx * 5 + key_idx;
            const status : u32 = 200;
            const tokens : u32 = 240;
            const decision : u32 = probe_step(status, tokens, attempt, zai_cap);
            assert decision == PROBE_STEP_HOLD; // 200 with enough tokens holds
            key_idx = key_idx + 1;
        }
        model_idx = model_idx + 1;
    }
}

test error_responses_are_handled_correctly {
    // 400 continues to next pair
    assert probe_step(400, 50, 0, 15) == PROBE_STEP_NEXT;

    // 429 continues to next pair
    assert probe_step(429, 0, 1, 15) == PROBE_STEP_NEXT;

    // 402 continues to next pair
    assert probe_step(402, 0, 2, 15) == PROBE_STEP_NEXT;

    // 403 continues to next pair
    assert probe_step(403, 0, 3, 15) == PROBE_STEP_NEXT;

    // 500 stops the rung
    assert probe_step(500, 0, 4, 15) == PROBE_STEP_STOP;

    // 503 stops the rung
    assert probe_step(503, 0, 5, 15) == PROBE_STEP_STOP;

    // 1305 stops the rung
    assert probe_step(1305, 0, 6, 15) == PROBE_STEP_STOP;

    // No answer (0) stops the rung
    assert probe_step(0, 0, 7, 15) == PROBE_STEP_STOP;
}

test probe_tokens_threshold_is_strictly_applied {
    // Below threshold does not prove, even with 200
    assert probe_step(200, 99, 0, 15) == PROBE_STEP_NEXT;
    assert probe_step(200, 1, 1, 15) == PROBE_STEP_NEXT;
    assert probe_step(200, 50, 2, 15) == PROBE_STEP_NEXT;

    // At or above threshold proves
    assert probe_step(200, 100, 3, 15) == PROBE_STEP_HOLD;
    assert probe_step(200, 240, 4, 15) == PROBE_STEP_HOLD;
    assert probe_step(200, 1000, 5, 15) == PROBE_STEP_HOLD;
}
