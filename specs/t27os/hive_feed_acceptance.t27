// SPDX-License-Identifier: Apache-2.0
; specs/t27os/hive_feed_acceptance.t27 -- what the hive page may show about a feed file. The feeds below are
; synthetic, the parsers are devices.t27's own (the page reads nothing else), and every rule the owner set for
; the feed holds here as an assertion: a host is ONLINE only on a fresh heartbeat, a payload with a quote is
; not trusted, a "-" and a missing record are "not measured" (DV_NM, never a 0 that looks like a reading),
; and "behind" counts only when both builds are known. This is the acceptance rail for the feed this machine
; started keeping on 2026-10-23 (~/.t27os/hive/feed.txt): when the page and this spec disagree, the page is
; wrong. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osHiveFeedAcceptance;

use t27os::devices;

// Two machines: this one on a fresh heartbeat with a build and lanes, a second one older, then a pushed
// lane branch, an unpushed marker, the trigit facts, two claims, and the release pair.
const F_GOOD : string = "S|1792764090\nZ|1792764090|hb1 host=playras.local build=7229 lanes=11813:igla:green:42\nA|second|1792763000|hb1 host=second.lan lanes=-\nB|11813|rel-11788-extern-boundary\nB|10262|-\nG|unpushed|0\nG|claims|2\nC|10262\nC|11678\nP|t27os-latest|5aec047d\nP|t27os-v0.1.0-b7228|5aec047d\n";

// The same Z with a quote in the payload: a shell character, so the host is not trusted at all.
const F_QUOTE : string = "S|1792764090\nZ|1792764090|hb1 host=playras.local lanes=\"all\"\n";

// The job never ran: no S record, no release pair.
const F_NOS : string = "G|unpushed|0\nB|11813|rel-11788-extern-boundary\n";

test a_well_formed_feed_names_two_hosts_and_is_online {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    // three slots: the two heartbeats, and the pushed lane branch -- a B row whose field is not "-"
    // occupies a host slot by the grammar (measured; the "-" row of B|10262 correctly does not)
    assert n == 3;
    const now : u64 = 1792764090 + 60;
    assert devices.dv_host_state(now, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0) == devices.DS_ONLINE;
    assert devices.dv_host_state(now, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 1) == devices.DS_ONLINE;
    // the own build and the lanes the payload carried
    assert devices.dv_host_num(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0, "build") == 7229;
    // the trigit facts and the claim rows are counted, not guessed
    assert devices.dv_g(F_GOOD, "unpushed") == 0;
    assert devices.dv_g(F_GOOD, "claims") == 2;
    assert devices.dv_count(F_GOOD, 67) == 2;
    assert devices.dv_count(F_GOOD, 66) == 2;
}

test a_stale_heartbeat_goes_offline_and_a_dash_is_not_a_reading {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert n == 3;
    // half an hour past the last heartbeat the host is OFFLINE, not shown as a zero
    const late : u64 = 1792764090 + devices.DV_STALE_S + 1;
    assert devices.dv_host_state(late, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0) == devices.DS_OFFLINE;
    assert devices.dv_host_state(late, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 1) == devices.DS_OFFLINE;
    // "-" parses to DV_NM, which is not 0: the page shows "not measured", never a fake zero
    assert devices.dv_num("-\n", 0, 1) == devices.DV_NM;
    assert devices.DV_NM != 0;
}

test a_payload_with_a_quote_is_not_trusted {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_QUOTE, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert n == 0;
}

test no_s_record_and_no_release_pair_are_not_measured {
    assert devices.dv_count(F_NOS, 83) == 0;
    assert devices.dv_latest_build(F_NOS) == devices.DV_NM;
    assert devices.dv_latest_build(F_GOOD) == 7228;
    // "behind" needs both builds; level or ahead is 0, an unknown build is n/m
    assert devices.dv_behind(7229, 7228) == 1;
    assert devices.dv_behind(7228, 7228) == 0;
    assert devices.dv_behind(7228, 7229) == 0;
    assert devices.dv_behind(7228, devices.DV_NM) == devices.DV_NM;
}

// ---- the canvas: what draw_hive_page (glass_window.t27) puts on screen for each feed, read through the same
// devices.t27 calls the page makes. t27os#19 accept criterion 1: the page may show nothing these tests do not assert.

const PW : f64 = 744.0;
const PH : f64 = 430.0;

test the_canvas_draws_one_card_per_host_and_counts_two_online {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert n == 3;
    // every host gets its card on the standard page: no host is cut
    assert devices.dv_cards_fit(n, PW, PH) == n;
    // the header: "3 machines, 2 online", and the feed age comes from the S record
    const now : u64 = 1792764090 + 60;
    var online : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (devices.dv_host_state(now, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], i) == devices.DS_ONLINE) { online = online + 1; }
        i = i + 1;
    }
    assert online == 2;
    assert devices.dv_nth(F_GOOD, 83, 0) != devices.DV_NONE;
    // the third card is the pushed lane branch: no heartbeat, so NO HEARTBEAT and "never", not ONLINE
    assert devices.dv_host_state(now, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 2) == devices.DS_UNKNOWN;
    var out : [96]u8 = undefined;
    assert devices.dv_age_text(now, 0, out[0..96]) == 5;
}

test every_card_value_the_payload_lacks_reads_n_m {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert n == 3;
    const latest : u32 = devices.dv_latest_build(F_GOOD);
    var out : [96]u8 = undefined;
    // card 0: "T27 OS n/m  build 7229  current" -- no ver key, a known build one ahead of the release
    var w : usize = devices.dv_ident_text(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0, latest, out[0..96]);
    assert w == 31;
    assert out[7] == 110 and out[w - 1] == 116;
    // cards 1 and 2: "T27 OS n/m  build n/m" -- no comparison is made up
    w = devices.dv_ident_text(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 1, latest, out[0..96]);
    assert w == 21;
    w = devices.dv_ident_text(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 2, latest, out[0..96]);
    assert w == 21;
    // "t27c n/m" on every card: no host reports tc
    var c : u32 = 0;
    while (c < n) {
        w = devices.dv_tools_text(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], c, out[0..96]);
        assert w == 8 and out[5] == 110;
        // the three meters: n/m text over an empty bar, never a 0% that looks like a reading
        var m : u32 = 0;
        while (m < devices.RES_COUNT) {
            var key : string = "cpu";
            if (m == devices.RES_RAM) { key = "ram"; }
            if (m == devices.RES_DISK) { key = "disk"; }
            const v : u32 = devices.dv_host_num(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], c, key);
            assert v == devices.DV_NM;
            w = devices.dv_res_text(v, m, out[0..96]);
            assert w == 3 and out[0] == 110;
            assert devices.dv_res_fill(v, m) == 0;
            m = m + 1;
        }
        c = c + 1;
    }
}

test the_lane_rows_come_from_the_heartbeat_and_a_branch_card_has_none {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    const n : u32 = devices.dv_hosts(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert n == 3;
    // card 1 (second.lan) published lanes=- : "no lane running"
    const rs : usize = devices.dv_remote_lanes_at(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 1);
    assert rs != devices.DV_NONE;
    const re : usize = devices.dv_remote_lanes_end(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 1, rs);
    assert devices.dv_lane_n(F_GOOD[rs .. re]) == 0;
    // card 0's heartbeat carries one lane, issue 11813
    const r0 : usize = devices.dv_remote_lanes_at(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0);
    const e0 : usize = devices.dv_remote_lanes_end(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0, r0);
    assert devices.dv_lane_n(F_GOOD[r0 .. e0]) == 1;
    assert devices.dv_lane_field(F_GOOD[r0 .. e0], 0, 0) == 11813;
    // card 2 has no payload at all: "lanes n/m (no heartbeat)"
    assert devices.dv_remote_lanes_at(F_GOOD, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 2) == devices.DV_NONE;
}

test the_flow_strip_shows_counts_it_has_and_n_m_for_the_rest {
    assert devices.dv_stage_value(F_GOOD, devices.FS_CLAIMED) == 2;
    assert devices.dv_stage_value(F_GOOD, devices.FS_PUSHED) == 2;
    // G|unpushed|0 is a reading of zero: drawn as 0 with the lamp off
    assert devices.dv_stage_value(F_GOOD, devices.FS_BATCH) == 0;
    assert devices.dv_stage_lit(devices.dv_stage_value(F_GOOD, devices.FS_BATCH)) == false;
    // no G|queue and no M record: n/m, not 0
    assert devices.dv_stage_value(F_GOOD, devices.FS_LANDED) == devices.DV_NM;
    assert devices.dv_stage_value(F_GOOD, devices.FS_MERGED) == devices.DV_NM;
    assert devices.dv_stage_lit(devices.DV_NM) == false;
}

test a_quoted_feed_draws_no_card_and_a_feed_without_s_draws_every_stage_n_m {
    var tab : [devices.DH_F * devices.DV_MAX_HOSTS]u32 = undefined;
    // the quoted payload: zero cards, so the page says "no machine yet" instead of an untrusted row
    const nq : u32 = devices.dv_hosts(F_QUOTE, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert nq == 0;
    assert devices.dv_cards_fit(nq, PW, PH) == 0;
    // no S record: "feed n/m" in the header and n/m on all five stages, even where G rows exist
    assert devices.dv_nth(F_NOS, 83, 0) == devices.DV_NONE;
    var s : u32 = 0;
    while (s < devices.FS_COUNT) {
        assert devices.dv_stage_value(F_NOS, s) == devices.DV_NM;
        s = s + 1;
    }
    // its one card is the lane branch, with no heartbeat
    const nn : u32 = devices.dv_hosts(F_NOS, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS]);
    assert nn == 1;
    assert devices.dv_host_state(1792764090, tab[0 .. devices.DH_F * devices.DV_MAX_HOSTS], 0) == devices.DS_UNKNOWN;
}
