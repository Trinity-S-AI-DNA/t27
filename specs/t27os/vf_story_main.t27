// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_story_main.t27 -- host program: one UI Kit story as a viewable frame (Refs Trinity-S-AI-DNA/t27#13667). It takes the graph of
; story STORY (0..34, default 0) from vf_storybook, sets the viewport to FRAME_W design pixels (default 375), lets vf_layout resolve the
; geometry, paints it with vc_render_s in the style vct_style builds from the vf_tokens metrics at FRAME_PCT percent (default 100) in the
; theme FRAME_THEME (0 or 1, default 0), and writes a P6 frame to FRAME_OUT (default target/vf_story.ppm). The frame is as high as the
; lowest node edge the layout resolved; this file holds no rectangle of its own.
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. Module-level vars are never spliced by `use`, so the two byte buffers live here and are passed to vf_card as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfStoryMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_card::vc_render_s;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_NO_FOCUS;
use t27f::vf_card::VC_BAD_METRICS;
use t27f::vf_card::VC_BAD_RASTER;
use t27f::vf_storybook::sb_graph;
use t27f::vf_storybook::sb_count;
use t27f::vf_storybook::sb_id;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::vf_card_tok::vct_style;
use t27f::vf_scale::vf_s_size;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_relation_word;
use t27f::vf_meaning::vf_primary_action;

; sized to the frame_render pixel cap, 2073600 pixels: 6220800 RGB bytes plus the 16 header bytes
pub var VSM_RGB : [6220800]u8 = [0] ** 6220800;
pub var VSM_PPM : [6220816]u8 = [0] ** 6220816;

pub fn vsm_height(l: VfLayout) -> u32 {
    if (l.node_count == 0) {
        return 0;
    }
    var max_h: u32 = 0;
    var i: u32 = 0;
    while (i < l.node_count) {
        const node_bottom: u32 = l.y[i] + l.h[i];
        if (node_bottom > max_h) {
            max_h = node_bottom;
        }
        i += 1;
    }
    return max_h;
}

pub fn vsm_graph(story: u32, w: u32) -> VfGraph {
    var g : VfGraph = sb_graph(story);
    g.viewport_w = w;
    return g;
}

/// Render the story at story index w design pixels, pct percent, in theme; the vc_render_s code (0 is ok; VC_BAD_RASTER when story >= sb_count() or height is 0), then the PPM into VSM_PPM.
pub fn vsm_render(story: u32, w: u32, pct: u32, theme: u32) -> u32 {
    if (story >= sb_count()) {
        return VC_BAD_RASTER;
    }
    const m : VctMetrics = vct_metrics();
    if (m.status != 0) {
        return VC_BAD_METRICS;
    }
    const g : VfGraph = vsm_graph(story, w);
    const l : VfLayout = vf_layout(g);
    const h : u32 = vsm_height(l);
    if (h == 0) {
        return VC_BAD_RASTER;
    }
    const ow : u32 = vf_s_size(w, pct);
    const oh : u32 = vf_s_size(h, pct);
    const r : u32 = vc_render_s(g, l, &VSM_RGB, ow, oh, pct, theme, VC_NO_FOCUS, vct_style(m));
    if (r != VC_OK) {
        return r;
    }
    return ppm_write_into(&VSM_PPM, &VSM_RGB, ow, oh) as u32;
}

pub fn main() void {
    var width : u32 = 375;
    const qw = std.c.getenv("FRAME_W");
    if (qw != null) {
        const sp = qw.?;
        var wv : u32 = 0;
        var k : usize = 0;
        while (sp[k] != 0 and wv <= 4096) {
            if (sp[k] >= 48 and sp[k] <= 57) { wv = wv * 10 + ((sp[k] - 48) as u32); }
            k += 1;
        }
        if (wv > 0) { width = wv; }
    }
    var story : u32 = 0;
    const qs = std.c.getenv("STORY");
    if (qs != null) {
        const ps = qs.?;
        var sv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and sv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { sv = sv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        if (sv > 0) { story = sv; }
    }
    var pct : u32 = 100;
    const qs2 = std.c.getenv("FRAME_PCT");
    if (qs2 != null) {
        const ps = qs2.?;
        var pv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and pv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { pv = pv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        if (pv > 0) { pct = pv; }
    }
    var theme : u32 = 0;
    const qt = std.c.getenv("FRAME_THEME");
    if (qt != null) {
        const ts = qt.?;
        if (ts[0] == 49) { theme = 1; }
    }
    const g : VfGraph = vsm_graph(story, width);
    const l : VfLayout = vf_layout(g);
    const h : u32 = vsm_height(l);
    const out_h : u32 = vf_s_size(h, pct);
    const rr : u32 = vsm_render(story, width, pct, theme);
    if (rr != VC_OK) {
        std.debug.print("vf_story: render refused at story {d} width {d} scale {d} theme {d}, code {d}\n", .{ story, width, pct, theme, rr });
        std.c.exit(1);
    }
    const nbytes : usize = ppm_len(vf_s_size(width, pct), out_h) as usize;
    var path : [*:0]const u8 = "target/vf_story.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("vf_story: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&VSM_PPM), 1, nbytes, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != nbytes) {
        std.debug.print("vf_story: short write to {s}: {d} of {d} bytes\n", .{ path, w, nbytes });
        std.c.exit(2);
    }
    std.debug.print("vf_story: wrote {d} bytes to {s} (story {d}, {d}x{d}, P6, design width {d}, scale {d} percent, theme {d})\n", .{ nbytes, path, story, vf_s_size(width, pct), out_h, width, pct, theme });
    std.debug.print("vf_story: story ID = {s}\n", .{sb_id(story)});
    std.debug.print("meaning: node kind depth relation gap x y w h text\n", .{});
    var i : u32 = 0;
    while (i < l.node_count) {
        std.debug.print("  {d} {s} depth {d} {s} gap {d} at {d},{d} size {d}x{d} [{s}]\n", .{ i, vf_kind_word(g, i), vf_depth(g, i), vf_relation_word(vf_relation(g, l, i)), vf_gap(g, l, i), l.x[i], l.y[i], l.w[i], l.h[i], g.text[i] });
        i += 1;
    }
    std.debug.print("primary action: node {d}\n", .{vf_primary_action(g)});
}

/// The sum of the three colour bytes of the pixel (x, y) in a frame of width w (below 1000 wide: the header is 15 bytes).
fn vsm_sum(x: u32, y: u32, w: u32) -> u32 {
    const at : usize = (15 + (y * w + x) * 3) as usize;
    return (VSM_PPM[at] as u32) + (VSM_PPM[at + 1] as u32) + (VSM_PPM[at + 2] as u32);
}

test story_0_at_375_100_percent_theme_0_renders_with_code_0_and_the_buffer_starts_with_the_bytes_P6_n375_ {
    assert vsm_render(0, 375, 100, 0) == 0;
    const want : []const u8 = "P6\n375 ";
    var i : usize = 0;
    while (i < want.len) {
        assert VSM_PPM[i] == want[i];
        i += 1;
    }
}

test story_index_sb_count_is_refused {
    const count = sb_count();
    assert vsm_render(count, 375, 100, 0) != 0;
}

test vsm_height_of_the_layout_of_vsm_graph_0_375_is_above_0 {
    const g = vsm_graph(0, 375);
    const l = vf_layout(g);
    const h = vsm_height(l);
    assert h > 0;
}