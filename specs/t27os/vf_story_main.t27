// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_story_main.t27 -- host program: one UI Kit story as a viewable frame (Refs Trinity-S-AI-DNA/t27#13667). It takes the graph of
; story STORY (0..34, default 0) from vf_storybook, sets the viewport to FRAME_W design pixels (default 375), lets vf_layout resolve the
; geometry, paints it with vc_render_s in the style vct_style builds from the vf_tokens metrics at FRAME_PCT percent (default 100) in the
; theme FRAME_THEME (0 or 1, default 0), and writes a P6 frame to FRAME_OUT (default target/vf_story.ppm). The frame is as high as the
; lowest node edge the layout resolved; this file holds no rectangle of its own.
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. Module-level vars are never spliced by `use`, so the two byte buffers live here and are passed to vf_card as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfStoryMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_card::vc_render_s;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_NO_FOCUS;
use t27f::vf_card::VC_BAD_METRICS;
use t27f::vf_card::VC_BAD_RASTER;
use t27f::vf_storybook::sb_kit;
use t27f::ui_kit::UiKit;
use t27f::ui_kit::KV_PRIMARY;
use t27f::ui_kit::KV_SECONDARY;
use t27f::ui_kit::KV_SUCCESS;
use t27f::ui_kit::KV_WARN;
use t27f::ui_kit::KS_HOVER;
use t27f::ui_kit::KS_DISABLED;
use t27f::ui_kit::KS_ERROR;
use t27f::ui_kit::KS_FOCUS;
use t27f::visual_factory_contract::VF_VARIANTS;
use t27f::visual_factory_contract::VF_STATES;
use t27f::visual_factory_contract::PRIMARY;
use t27f::visual_factory_contract::SECONDARY;
use t27f::visual_factory_contract::SUCCESS;
use t27f::visual_factory_contract::WARNING;
use t27f::visual_factory_contract::HOVER;
use t27f::visual_factory_contract::FOCUS;
use t27f::visual_factory_contract::DISABLED;
use t27f::visual_factory_contract::ERROR;
use t27f::vf_storybook::sb_count;
use t27f::vf_storybook::sb_id;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::vf_card_tok::vct_style;
use t27f::vf_scale::vf_s_size;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_relation_word;
use t27f::vf_meaning::vf_primary_action;

; sized to the frame_render pixel cap, 2073600 pixels: 6220800 RGB bytes plus the 16 header bytes
pub var VSM_RGB : [6220800]u8 = [0] ** 6220800;
pub var VSM_PPM : [6220816]u8 = [0] ** 6220816;

pub fn vsm_height(l: VfLayout) -> u32 {
    if (l.node_count == 0) {
        return 0;
    }
    var max_h: u32 = 0;
    var i: u32 = 0;
    while (i < l.node_count) {
        const node_bottom: u32 = l.y[i] + l.h[i];
        if (node_bottom > max_h) {
            max_h = node_bottom;
        }
        i += 1;
    }
    return max_h;
}

/// the bit of a variant or state code in a contract mask: 1 << code
pub fn vsm_bit(code: u8) -> u32 {
    var b : u32 = 1;
    var i : u8 = 0;
    while (i < code) {
        b = b * 2;
        i += 1;
    }
    return b;
}

/// kit variant kv of a node of kind as a contract variant; 0 (V_DEFAULT) when kv has no contract variant (KV_GHOST) or VF_VARIANTS of the kind does not allow it
pub fn vsm_variant(kind: u8, kv: u32) -> u8 {
    var v : u8 = 0;
    if (kv == KV_PRIMARY) {
        v = PRIMARY;
    }
    if (kv == KV_SECONDARY) {
        v = SECONDARY;
    }
    if (kv == KV_SUCCESS) {
        v = SUCCESS;
    }
    if (kv == KV_WARN) {
        v = WARNING;
    }
    if (kind > 8) {
        return 0;
    }
    if ((VF_VARIANTS[kind] & vsm_bit(v)) == 0) {
        return 0;
    }
    return v;
}

/// kit state ks of a node of kind as a contract state; 0 (S_DEFAULT) when ks has no contract state (KS_PRESSED) or VF_STATES of the kind does not allow it
pub fn vsm_state(kind: u8, ks: u32) -> u8 {
    var s : u8 = 0;
    if (ks == KS_HOVER) {
        s = HOVER;
    }
    if (ks == KS_FOCUS) {
        s = FOCUS;
    }
    if (ks == KS_DISABLED) {
        s = DISABLED;
    }
    if (ks == KS_ERROR) {
        s = ERROR;
    }
    if (kind > 8) {
        return 0;
    }
    if ((VF_STATES[kind] & vsm_bit(s)) == 0) {
        return 0;
    }
    return s;
}

/// the graph of a story at w design pixels, with each kit node's variant and state carried into the graph through vsm_variant and vsm_state
pub fn vsm_graph(story: u32, w: u32) -> VfGraph {
    const k : UiKit = sb_kit(story);
    var g : VfGraph = k.graph;
    var i : u32 = 0;
    while (i < 16) {
        g.variant[i] = vsm_variant(g.kind[i], k.variant[i]);
        g.state[i] = vsm_state(g.kind[i], k.state[i]);
        i += 1;
    }
    g.viewport_w = w;
    return g;
}

/// Render the story at story index w design pixels, pct percent, in theme; the vc_render_s code (0 is ok; VC_BAD_RASTER when story >= sb_count() or height is 0), then the PPM into VSM_PPM.
pub fn vsm_render(story: u32, w: u32, pct: u32, theme: u32) -> u32 {
    if (story >= sb_count()) {
        return VC_BAD_RASTER;
    }
    const m : VctMetrics = vct_metrics();
    if (m.status != 0) {
        return VC_BAD_METRICS;
    }
    const g : VfGraph = vsm_graph(story, w);
    const l : VfLayout = vf_layout(g);
    const h : u32 = vsm_height(l);
    if (h == 0) {
        return VC_BAD_RASTER;
    }
    const ow : u32 = vf_s_size(w, pct);
    const oh : u32 = vf_s_size(h, pct);
    const r : u32 = vc_render_s(g, l, &VSM_RGB, ow, oh, pct, theme, VC_NO_FOCUS, vct_style(m));
    if (r != VC_OK) {
        return r;
    }
    return ppm_write_into(&VSM_PPM, &VSM_RGB, ow, oh) as u32;
}

pub fn main() void {
    var width : u32 = 375;
    const qw = std.c.getenv("FRAME_W");
    if (qw != null) {
        const sp = qw.?;
        var wv : u32 = 0;
        var k : usize = 0;
        while (sp[k] != 0 and wv <= 4096) {
            if (sp[k] >= 48 and sp[k] <= 57) { wv = wv * 10 + ((sp[k] - 48) as u32); }
            k += 1;
        }
        if (wv > 0) { width = wv; }
    }
    var story : u32 = 0;
    const qs = std.c.getenv("STORY");
    if (qs != null) {
        const ps = qs.?;
        var sv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and sv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { sv = sv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        if (sv > 0) { story = sv; }
    }
    var pct : u32 = 100;
    const qs2 = std.c.getenv("FRAME_PCT");
    if (qs2 != null) {
        const ps = qs2.?;
        var pv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and pv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { pv = pv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        if (pv > 0) { pct = pv; }
    }
    var theme : u32 = 0;
    const qt = std.c.getenv("FRAME_THEME");
    if (qt != null) {
        const ts = qt.?;
        if (ts[0] == 49) { theme = 1; }
    }
    const g : VfGraph = vsm_graph(story, width);
    const l : VfLayout = vf_layout(g);
    const h : u32 = vsm_height(l);
    const out_h : u32 = vf_s_size(h, pct);
    const rr : u32 = vsm_render(story, width, pct, theme);
    if (rr != VC_OK) {
        std.debug.print("vf_story: render refused at story {d} width {d} scale {d} theme {d}, code {d}\n", .{ story, width, pct, theme, rr });
        std.c.exit(1);
    }
    const nbytes : usize = ppm_len(vf_s_size(width, pct), out_h) as usize;
    var path : [*:0]const u8 = "target/vf_story.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("vf_story: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&VSM_PPM), 1, nbytes, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != nbytes) {
        std.debug.print("vf_story: short write to {s}: {d} of {d} bytes\n", .{ path, w, nbytes });
        std.c.exit(2);
    }
    std.debug.print("vf_story: wrote {d} bytes to {s} (story {d}, {d}x{d}, P6, design width {d}, scale {d} percent, theme {d})\n", .{ nbytes, path, story, vf_s_size(width, pct), out_h, width, pct, theme });
    std.debug.print("vf_story: story ID = {s}\n", .{sb_id(story)});
    std.debug.print("meaning: node kind depth relation gap x y w h text\n", .{});
    var i : u32 = 0;
    while (i < l.node_count) {
        std.debug.print("  {d} {s} depth {d} {s} gap {d} at {d},{d} size {d}x{d} [{s}]\n", .{ i, vf_kind_word(g, i), vf_depth(g, i), vf_relation_word(vf_relation(g, l, i)), vf_gap(g, l, i), l.x[i], l.y[i], l.w[i], l.h[i], g.text[i] });
        i += 1;
    }
    std.debug.print("primary action: node {d}\n", .{vf_primary_action(g)});
}

/// The sum of the three colour bytes of the pixel (x, y) in a frame of width w (below 1000 wide: the header is 15 bytes).
fn vsm_sum(x: u32, y: u32, w: u32) -> u32 {
    const at : usize = (15 + (y * w + x) * 3) as usize;
    return (VSM_PPM[at] as u32) + (VSM_PPM[at + 1] as u32) + (VSM_PPM[at + 2] as u32);
}

test story_0_at_375_100_percent_theme_0_renders_with_code_0_and_the_buffer_starts_with_the_bytes_P6_n375_ {
    assert vsm_render(0, 375, 100, 0) == 0;
    const want : []const u8 = "P6\n375 ";
    var i : usize = 0;
    while (i < want.len) {
        assert VSM_PPM[i] == want[i];
        i += 1;
    }
}

test story_index_sb_count_is_refused {
    const count = sb_count();
    assert vsm_render(count, 375, 100, 0) != 0;
}

test vsm_height_of_the_layout_of_vsm_graph_0_375_is_above_0 {
    const g = vsm_graph(0, 375);
    const l = vf_layout(g);
    const h = vsm_height(l);
    assert h > 0;
}

test vsm_variant_maps_kit_codes_and_filters_by_the_kind_mask {
    assert vsm_variant(4, 0) == 1;
    assert vsm_variant(4, 1) == 2;
    assert vsm_variant(4, 2) == 0;
    assert vsm_variant(4, 3) == 0;
    assert vsm_variant(7, 3) == 5;
    assert vsm_variant(7, 4) == 6;
    assert vsm_variant(7, 0) == 0;
    assert vsm_variant(1, 0) == 0;
    assert vsm_variant(9, 0) == 0;
}

test vsm_state_maps_kit_codes_and_filters_by_the_kind_mask {
    assert vsm_state(4, 1) == 1;
    assert vsm_state(4, 5) == 2;
    assert vsm_state(4, 3) == 3;
    assert vsm_state(4, 4) == 0;
    assert vsm_state(4, 2) == 0;
    assert vsm_state(5, 5) == 2;
    assert vsm_state(5, 4) == 4;
    assert vsm_state(5, 1) == 0;
    assert vsm_state(6, 1) == 1;
    assert vsm_state(6, 5) == 0;
    assert vsm_state(7, 1) == 0;
}

test the_graph_of_story_3_carries_SECONDARY_and_story_2_carries_DISABLED_on_the_button_node {
    const a = vsm_graph(3, 375);
    assert a.kind[1] == 4;
    assert a.variant[1] == 2;
    const b = vsm_graph(2, 375);
    assert b.variant[1] == 1;
    assert b.state[1] == 3;
    const c = vsm_graph(0, 375);
    assert c.state[1] == 0;
}

/// interaction runner: render every story in [from, to) in both themes at w design pixels and pct scale;
/// returns 0 when all pass, the failing story index + 1 (non-zero) on the first failure
pub fn vsm_run_all(from: u32, to: u32, w: u32, pct: u32) -> u32 {
    if (to > sb_count()) {
        return to + 1;
    }
    var i: u32 = from;
    while (i < to) {
        if (vsm_render(i, w, pct, 0) != 0) {
            return i + 1;
        }
        if (vsm_render(i, w, pct, 1) != 0) {
            return i + 1;
        }
        i += 1;
    }
    return 0;
}

; assertion runner: badge stories 20..24 (Primary, Secondary, Ghost, Success, Warn) render in both themes at 375px
test badge_primary_through_warn_render_at_375_both_themes {
    assert vsm_render(20, 375, 100, 0) == 0;
    assert vsm_render(20, 375, 100, 1) == 0;
    assert vsm_render(21, 375, 100, 0) == 0;
    assert vsm_render(21, 375, 100, 1) == 0;
    assert vsm_render(22, 375, 100, 0) == 0;
    assert vsm_render(22, 375, 100, 1) == 0;
    assert vsm_render(23, 375, 100, 0) == 0;
    assert vsm_render(23, 375, 100, 1) == 0;
    assert vsm_render(24, 375, 100, 0) == 0;
    assert vsm_render(24, 375, 100, 1) == 0;
}

; assertion runner: Badge Primary at 375px theme 0 writes a valid P6 frame into VSM_PPM
test badge_primary_frame_has_valid_ppm_header {
    assert vsm_render(20, 375, 100, 0) == 0;
    const want : []const u8 = "P6\n375 ";
    var i : usize = 0;
    while (i < want.len) {
        assert VSM_PPM[i] == want[i];
        i += 1;
    }
}

; assertion runner: all stories 0..33 (excluding story 34 which is pending #13513) render at 375px both themes
test all_stories_0_through_33_render_at_375_both_themes {
    assert vsm_run_all(0, 34, 375, 100) == 0;
}