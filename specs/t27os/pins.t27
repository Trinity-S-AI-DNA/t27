// SPDX-License-Identifier: Apache-2.0
; specs/t27os/pins.t27 -- the widgets a user pinned to a letter's page: file format, add, remove, dedupe, the '+' tile
; Owner, 2026-10-20: the user adds widgets himself. A '+' tile ends every widget grid (same size as an instrument tile,
; dashed 1 pt frame, a large '+' and ADD WIDGET). Pins are user layout, one file per letter, ~/.t27os/pins/<NN>
; (NN = the letter's ordinal 01..27), one widget id per line. Owner and agents stay agent_parts' (an id it does not
; know shows owner 0 "unassigned"). Pure decisions; the window only reads and writes the file and draws. Closes #11275.
; ASCII only (L3), English (LANG-EN). NOT YET WIRED: the picker panel and the CREATE NEW hand-off (see AGENTS.md).

module T27osPins;

use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::dash::tile_w;
use t27os::dash::tile_h;

pub const MAX_PINS : u32 = 64;
pub const MAX_ID : u32 = 64;
pub const PIN_NONE : u32 = 4294967295;

/// ~/.t27os/pins/<NN>, NUL-terminated (the NUL is not counted).
pub fn pin_path(home: []const u8, letter: u32, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, home);
    n = put_bytes(out, n, "/.t27os/pins/");
    if (letter < 10) { n = put_bytes(out, n, "0"); }
    n = put_dec(out, n, @as(u64, letter));
    out[n] = 0;
    return n;
}

fn id_char_ok(c: u8) -> bool {
    return (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 95;
}

/// An id a pin file may hold: 1..MAX_ID bytes of a-z 0-9 - _ (a newline or a path would corrupt the file).
pub fn id_ok(id: []const u8) -> bool {
    if (id.len == 0 or id.len > MAX_ID) { return false; }
    var i : usize = 0;
    while (i < id.len) {
        if (id_char_ok(id[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

fn same(buf: []const u8, s: usize, l: usize, id: []const u8) -> bool {
    if (l != id.len) { return false; }
    var k : usize = 0;
    while (k < l and buf[s + k] == id[k]) { k = k + 1; }
    return k == l;
}

/// Parse the file: offs[2k], offs[2k+1] = start, length of pin k. Blank lines, CR, bad ids and repeats are skipped,
/// at most MAX_PINS. Returns the pin count.
pub fn pins_parse(buf: []const u8, n: usize, offs: []u32) -> u32 {
    var cnt : u32 = 0;
    var i : usize = 0;
    while (i < n and cnt < MAX_PINS) {
        var e : usize = i;
        while (e < n and buf[e] != 10) { e = e + 1; }
        var l : usize = e - i;
        if (l > 0 and buf[i + l - 1] == 13) { l = l - 1; }
        if (id_ok(buf[i .. i + l])) {
            var dup : bool = false;
            var k : u32 = 0;
            while (k < cnt) {
                if (same(buf, @as(usize, offs[k * 2]), @as(usize, offs[k * 2 + 1]), buf[i .. i + l])) { dup = true; }
                k = k + 1;
            }
            if (dup == false) {
                offs[cnt * 2] = @as(u32, @intCast(i));
                offs[cnt * 2 + 1] = @as(u32, @intCast(l));
                cnt = cnt + 1;
            }
        }
        i = e + 1;
    }
    return cnt;
}

pub fn pin_index(buf: []const u8, offs: []const u32, cnt: u32, id: []const u8) -> u32 {
    var k : u32 = 0;
    while (k < cnt) {
        if (same(buf, @as(usize, offs[k * 2]), @as(usize, offs[k * 2 + 1]), id)) { return k; }
        k = k + 1;
    }
    return PIN_NONE;
}

/// Append `id` (once) to the text in buf[0..n]; returns the new length, n itself when the id is bad, already pinned,
/// the page holds MAX_PINS, or the buffer is full. The file stays one id per line, ending in a newline.
pub fn pin_add(buf: []u8, n: usize, id: []const u8) -> usize {
    if (id_ok(id) == false) { return n; }
    var offs : [128]u32 = undefined;
    const cnt : u32 = pins_parse(buf, n, offs[0..128]);
    if (cnt >= MAX_PINS or pin_index(buf, offs[0..128], cnt, id) != PIN_NONE) { return n; }
    if (n + id.len + 2 > buf.len) { return n; }
    var m : usize = n;
    if (m > 0 and buf[m - 1] != 10) { buf[m] = 10; m = m + 1; }
    m = put_bytes(buf, m, id);
    buf[m] = 10;
    return m + 1;
}

/// Remove `id`'s line; returns the new length (n when it was not pinned). Other lines stay as they were.
pub fn pin_remove(buf: []u8, n: usize, id: []const u8) -> usize {
    var out : usize = 0;
    var i : usize = 0;
    while (i < n) {
        var e : usize = i;
        while (e < n and buf[e] != 10) { e = e + 1; }
        var l : usize = e - i;
        if (l > 0 and buf[i + l - 1] == 13) { l = l - 1; }
        if (same(buf, i, l, id) == false) {
            var k : usize = i;
            while (k < e) { buf[out] = buf[k]; out = out + 1; k = k + 1; }
            if (e < n) { buf[out] = 10; out = out + 1; }
        }
        i = e + 1;
    }
    return out;
}

// ---- the '+' tile: the cell right after the last instrument tile (dash.t27 slot_cell: after the C block too) ----

use t27os::dash::slot_cell;
use t27os::dash::tile_rx;
use t27os::dash::tile_ry;
use t27os::dash::HIT_NONE;
use t27os::dash::hit_class;
use t27os::dash::HC_PLUS;
use t27os::agent_parts::WIDGET_ID;
use t27os::homes::WIDGET_COUNT;
use t27os::dash::gal_start;
use t27os::dash::gal_len;
use t27os::dash::GAL_IDS;
use t27os::dash::GAL_CAP;

pub fn add_cell(o: u32, count: u32, pw: f64) -> u32 { return slot_cell(o, count, pw); }

/// The tile's rect relative to the console frame: x, y, w, h.
pub fn add_x(o: u32, count: u32, pw: f64) -> f64 { return tile_rx(o, count, pw); }
pub fn add_y(o: u32, count: u32, pw: f64) -> f64 { return tile_ry(o, count, pw); }
pub fn add_w(pw: f64) -> f64 { return tile_w(pw); }
pub fn add_h(pw: f64) -> f64 { return tile_h(pw); }

/// (px, py) is a point relative to the console frame (frame origin = top-left of the console box).
pub fn on_add_tile(o: u32, px: f64, py: f64, count: u32, pw: f64) -> bool {
    const x : f64 = add_x(o, count, pw);
    const y : f64 = add_y(o, count, pw);
    return px >= x and px < x + add_w(pw) and py >= y and py < y + add_h(pw);
}

/// Cells the console needs for `count` tiles plus the '+' tile.
pub fn cells_with_add(count: u32) -> u32 { return count + 1; }

/// The panel widget index (agent_parts WIDGET_ID order) of a pinned id, WIDGET_COUNT when the id is no panel widget
/// (a gallery row nobody owns yet: its tile is a placeholder with the id and kind, never a blank).
pub fn widget_of_id(id: []const u8) -> u32 {
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        if (same(id, 0, id.len, WIDGET_ID[i])) { return i; }
        i = i + 1;
    }
    return WIDGET_COUNT;
}

/// The gallery row of an id, PIN_NONE when the live gallery does not list it.
pub fn row_of_id(buf: []const u8, tab: []const u32, total: u32, id: []const u8) -> u32 {
    var r : u32 = 0;
    while (r < total) {
        const st : usize = @as(usize, tab[(GAL_IDS * GAL_CAP + r) * 2]);
        const l : usize = @as(usize, tab[(GAL_IDS * GAL_CAP + r) * 2 + 1]);
        if (same(buf, st, l, id)) { return r; }
        r = r + 1;
    }
    return PIN_NONE;
}

// ---- the ADD WIDGET panel: PIN FROM GALLERY (search + grid) and CREATE NEW ----
// Geometry relative to the page view (vw x vh, origin at the content's top-left under the header).

pub const AP_NONE : u32 = 0;
pub const AP_CLOSE : u32 = 1;
pub const AP_CREATE : u32 = 2;
pub const AP_SEARCH : u32 = 3;
pub const AP_OUTSIDE : u32 = 4;
pub const AP_CELL : u32 = 100;
pub const AP_PAD : f64 = 16.0;
pub const AP_HEAD : f64 = 40.0;
pub const AP_SEARCH_H : f64 = 30.0;
pub const AP_CELL_W : f64 = 150.0;
pub const AP_CELL_H : f64 = 26.0;
pub const AP_GAP : f64 = 6.0;
pub const AP_RIGHT : f64 = 232.0;
pub const AP_QMAX : u32 = 32;

fn minf(a: f64, b: f64) -> f64 { if (a < b) { return a; } return b; }

pub fn ap_w(vw: f64) -> f64 { return minf(780.0, vw - 48.0); }
pub fn ap_h(vh: f64) -> f64 { return minf(540.0, vh - 48.0); }
pub fn ap_x(vw: f64) -> f64 { return 0.5 * (vw - ap_w(vw)); }
pub fn ap_y(vh: f64) -> f64 { return 0.5 * (vh - ap_h(vh)); }
pub fn ap_left_w(vw: f64) -> f64 { return ap_w(vw) - AP_RIGHT; }
pub fn ap_search_y(vh: f64) -> f64 { return ap_y(vh) + AP_HEAD; }
pub fn ap_grid_y(vh: f64) -> f64 { return ap_search_y(vh) + AP_SEARCH_H + 14.0; }
pub fn ap_cols(vw: f64) -> u32 {
    const c : f64 = (ap_left_w(vw) - 2.0 * AP_PAD + AP_GAP) / (AP_CELL_W + AP_GAP);
    if (c < 1.0) { return 1; }
    return @as(u32, @intFromFloat(c));
}
pub fn ap_rows(vw: f64, vh: f64) -> u32 {
    const r : f64 = (ap_y(vh) + ap_h(vh) - AP_PAD - ap_grid_y(vh) + AP_GAP) / (AP_CELL_H + AP_GAP);
    if (r < 1.0) { return 1; }
    return @as(u32, @intFromFloat(r));
}
pub fn ap_cap(vw: f64, vh: f64) -> u32 { return ap_cols(vw) * ap_rows(vw, vh); }
pub fn ap_cell_x(i: u32, vw: f64) -> f64 { return ap_x(vw) + AP_PAD + @as(f64, @floatFromInt(i % ap_cols(vw))) * (AP_CELL_W + AP_GAP); }
pub fn ap_cell_y(i: u32, vw: f64, vh: f64) -> f64 { return ap_grid_y(vh) + @as(f64, @floatFromInt(i / ap_cols(vw))) * (AP_CELL_H + AP_GAP); }
pub fn ap_create_x(vw: f64) -> f64 { return ap_x(vw) + ap_left_w(vw) + AP_PAD; }
pub fn ap_create_y(vh: f64) -> f64 { return ap_search_y(vh); }
pub fn ap_create_w() -> f64 { return AP_RIGHT - 2.0 * AP_PAD; }
pub fn ap_create_h() -> f64 { return 64.0; }

fn inr(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool { return x >= l and x < l + w and y >= t and y < t + h; }

/// What the point (x, y) of the page view is on, with `shown` matches in the grid (already capped by ap_cap).
pub fn ap_hit(vw: f64, vh: f64, x: f64, y: f64, shown: u32) -> u32 {
    if (inr(x, y, ap_x(vw) + ap_w(vw) - 36.0, ap_y(vh) + 6.0, 28.0, 28.0)) { return AP_CLOSE; }
    if (inr(x, y, ap_create_x(vw), ap_create_y(vh), ap_create_w(), ap_create_h())) { return AP_CREATE; }
    if (inr(x, y, ap_x(vw) + AP_PAD, ap_search_y(vh), ap_left_w(vw) - 2.0 * AP_PAD, AP_SEARCH_H)) { return AP_SEARCH; }
    var i : u32 = 0;
    while (i < shown) {
        if (inr(x, y, ap_cell_x(i, vw), ap_cell_y(i, vw, vh), AP_CELL_W, AP_CELL_H)) { return AP_CELL + i; }
        i = i + 1;
    }
    if (inr(x, y, ap_x(vw), ap_y(vh), ap_w(vw), ap_h(vh))) { return AP_NONE; }
    return AP_OUTSIDE;
}

/// The query: lowercase a-z 0-9 - _ ; push appends (folding capitals), pop removes the last.
pub fn query_push(q: []u8, n: u32, ch: u32) -> u32 {
    if (n >= AP_QMAX) { return n; }
    var c : u32 = ch;
    if (c >= 65 and c <= 90) { c = c + 32; }
    if (id_char_ok(@as(u8, @intCast(c % 256))) == false or c > 127) { return n; }
    q[n] = @as(u8, @intCast(c));
    return n + 1;
}
pub fn query_pop(n: u32) -> u32 { if (n == 0) { return 0; } return n - 1; }

/// Does the id of gallery row `row` contain the query (an empty query matches every row)?
pub fn row_matches(buf: []const u8, tab: []const u32, row: u32, q: []const u8, qn: u32) -> bool {
    const st : usize = @as(usize, tab[(GAL_IDS * GAL_CAP + row) * 2]);
    const l : usize = @as(usize, tab[(GAL_IDS * GAL_CAP + row) * 2 + 1]);
    const m : usize = @as(usize, qn);
    if (m == 0) { return true; }
    if (m > l) { return false; }
    var i : usize = 0;
    while (i + m <= l) {
        var k : usize = 0;
        while (k < m and buf[st + i + k] == q[k]) { k = k + 1; }
        if (k == m) { return true; }
        i = i + 1;
    }
    return false;
}

/// The row of the n-th match of the query among `total` gallery rows, PIN_NONE past the last.
pub fn nth_match(buf: []const u8, tab: []const u32, total: u32, q: []const u8, qn: u32, n: u32) -> u32 {
    var seen : u32 = 0;
    var r : u32 = 0;
    while (r < total) {
        if (row_matches(buf, tab, r, q, qn)) {
            if (seen == n) { return r; }
            seen = seen + 1;
        }
        r = r + 1;
    }
    return PIN_NONE;
}

pub fn match_count(buf: []const u8, tab: []const u32, total: u32, q: []const u8, qn: u32) -> u32 {
    var seen : u32 = 0;
    var r : u32 = 0;
    while (r < total) {
        if (row_matches(buf, tab, r, q, qn)) { seen = seen + 1; }
        r = r + 1;
    }
    return seen;
}

/// CREATE NEW: the commander line the agents dialog gets, typed but not sent: "new widget for <letter>: ".
pub fn create_line(letter_name: []const u8, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "new widget for ");
    n = put_bytes(out, n, letter_name);
    n = put_bytes(out, n, ": ");
    return n;
}

test the_pin_file_is_one_id_per_line_and_never_repeats {
    var b : [256]u8 = undefined;
    var o : [128]u32 = undefined;
    var n : usize = put_bytes(b[0..256], 0, "x7-board\n\nbit-diff\nx7-board\nBad Id\n");
    assert pins_parse(b[0..256], n, o[0..128]) == 2;
    assert o[1] == 8;
    assert o[2] == 10;
    assert pin_index(b[0..256], o[0..128], 2, "bit-diff") == 1;
    assert pin_index(b[0..256], o[0..128], 2, "nope") == PIN_NONE;
    n = pin_add(b[0..256], n, "gf16-calc");
    assert pins_parse(b[0..256], n, o[0..128]) == 3;
    assert pin_add(b[0..256], n, "gf16-calc") == n;
    assert pin_add(b[0..256], n, "Bad Id") == n;
    assert pin_add(b[0..256], n, "a\nb") == n;
    n = pin_remove(b[0..256], n, "bit-diff");
    assert pins_parse(b[0..256], n, o[0..128]) == 2;
    assert pin_index(b[0..256], o[0..128], 2, "bit-diff") == PIN_NONE;
    assert pin_remove(b[0..256], n, "bit-diff") == n;
}

test an_empty_file_takes_a_first_pin_and_the_page_holds_at_most_max_pins {
    var b : [4096]u8 = undefined;
    var n : usize = pin_add(b[0..4096], 0, "x7-board");
    assert n == 9;
    assert b[8] == 10;
    var i : u32 = 0;
    var id : [8]u8 = undefined;
    while (i < 80) {
        id[0] = 112;
        id[1] = 48 + @as(u8, @intCast(i / 10));
        id[2] = 48 + @as(u8, @intCast(i % 10));
        n = pin_add(b[0..4096], n, id[0..3]);
        i = i + 1;
    }
    var o : [128]u32 = undefined;
    assert pins_parse(b[0..4096], n, o[0..128]) == MAX_PINS;
}

test the_pin_path_is_per_letter {
    var p : [64]u8 = undefined;
    const n : usize = pin_path("/h", 7, p[0..64]);
    assert n == 2 + 13 + 2;
    assert p[n] == 0;
    assert p[n - 2] == 48;
    assert pin_path("/h", 27, p[0..64]) == n;
}

test the_add_tile_follows_the_last_tile_and_is_hit_where_it_is_drawn {
    const pw : f64 = 800.0;
    assert add_cell(4, 5, pw) == 5;
    assert add_w(pw) == tile_w(pw);
    assert add_h(pw) == tile_h(pw);
    assert on_add_tile(4, add_x(4, 5, pw) + 2.0, add_y(4, 5, pw) + 2.0, 5, pw);
    assert on_add_tile(4, add_x(4, 5, pw) - 2.0, add_y(4, 5, pw) + 2.0, 5, pw) == false;
    assert cells_with_add(5) == 6;
    assert add_cell(3, 5, pw) == slot_cell(3, 5, pw);
    assert add_cell(3, 0, pw) > 1;
    assert id_ok("") == false;
}

test the_add_panel_is_centred_and_its_zones_are_hit {
    const vw : f64 = 900.0;
    const vh : f64 = 600.0;
    assert ap_x(vw) > 0.0 and ap_y(vh) > 0.0;
    assert ap_w(vw) <= 780.0 and ap_h(vh) <= 540.0;
    assert ap_hit(vw, vh, ap_x(vw) + ap_w(vw) - 20.0, ap_y(vh) + 20.0, 5) == AP_CLOSE;
    assert ap_hit(vw, vh, ap_create_x(vw) + 4.0, ap_create_y(vh) + 4.0, 5) == AP_CREATE;
    assert ap_hit(vw, vh, ap_x(vw) + AP_PAD + 4.0, ap_search_y(vh) + 4.0, 5) == AP_SEARCH;
    assert ap_hit(vw, vh, ap_cell_x(3, vw) + 2.0, ap_cell_y(3, vw, vh) + 2.0, 5) == AP_CELL + 3;
    assert ap_hit(vw, vh, ap_cell_x(7, vw) + 2.0, ap_cell_y(7, vw, vh) + 2.0, 5) == AP_NONE;
    assert ap_hit(vw, vh, 2.0, 2.0, 5) == AP_OUTSIDE;
    assert ap_cap(vw, vh) >= 20;
    assert ap_cols(vw) >= 3;
    assert ap_cols(300.0) == 1 and ap_rows(300.0, 200.0) >= 1;
}

test the_typed_query_filters_the_gallery_by_id_and_a_tap_pins {
    var b : [128]u8 = undefined;
    var t : [2560]u32 = undefined;
    put_bytes(b[0..128], 0, "bit-diffgf16-calcx7-board");
    t[(GAL_IDS * GAL_CAP + 0) * 2] = 0;
    t[(GAL_IDS * GAL_CAP + 0) * 2 + 1] = 8;
    t[(GAL_IDS * GAL_CAP + 1) * 2] = 8;
    t[(GAL_IDS * GAL_CAP + 1) * 2 + 1] = 9;
    t[(GAL_IDS * GAL_CAP + 2) * 2] = 17;
    t[(GAL_IDS * GAL_CAP + 2) * 2 + 1] = 8;
    var q : [32]u8 = undefined;
    var qn : u32 = 0;
    assert match_count(b[0..128], t[0..2560], 3, q[0..32], 0) == 3;
    qn = query_push(q[0..32], qn, 71);
    qn = query_push(q[0..32], qn, 70);
    assert qn == 2 and q[0] == 103;
    assert match_count(b[0..128], t[0..2560], 3, q[0..32], qn) == 1;
    assert nth_match(b[0..128], t[0..2560], 3, q[0..32], qn, 0) == 1;
    assert nth_match(b[0..128], t[0..2560], 3, q[0..32], qn, 1) == PIN_NONE;
    qn = query_pop(qn);
    assert qn == 1 and match_count(b[0..128], t[0..2560], 3, q[0..32], qn) == 1;
    qn = query_pop(query_pop(qn));
    assert qn == 0;
    qn = query_push(q[0..32], 0, 45);
    assert match_count(b[0..128], t[0..2560], 3, q[0..32], qn) == 3;
    assert query_push(q[0..32], qn, 32) == qn;
    assert query_push(q[0..32], qn, 47) == qn;
    assert query_push(q[0..32], qn, 233) == qn;
    var f : [256]u8 = undefined;
    var fl : usize = pin_add(f[0..256], 0, "gf16-calc");
    var o : [128]u32 = undefined;
    assert pins_parse(f[0..256], fl, o[0..128]) == 1;
    assert pin_index(f[0..256], o[0..128], 1, "gf16-calc") == 0;
    fl = pin_remove(f[0..256], fl, "gf16-calc");
    assert fl == 0;
}

test create_new_prefills_the_commander_line_for_the_letter {
    var l : [64]u8 = undefined;
    const n : usize = create_line("C", l[0..64]);
    assert n == 15 + 1 + 2;
    assert l[0] == 110 and l[n - 1] == 32 and l[n - 2] == 58;
}

test a_pinned_id_resolves_to_a_panel_widget_or_to_a_placeholder_row {
    assert widget_of_id(WIDGET_ID[5]) == 5;
    assert widget_of_id(WIDGET_ID[194]) == 194;
    assert widget_of_id("no-such-widget") == WIDGET_COUNT;
    var b : [64]u8 = undefined;
    var t : [2560]u32 = undefined;
    put_bytes(b[0..64], 0, "bit-diffgf16-calc");
    t[(GAL_IDS * GAL_CAP + 0) * 2] = 0;
    t[(GAL_IDS * GAL_CAP + 0) * 2 + 1] = 8;
    t[(GAL_IDS * GAL_CAP + 1) * 2] = 8;
    t[(GAL_IDS * GAL_CAP + 1) * 2 + 1] = 9;
    assert row_of_id(b[0..64], t[0..2560], 2, "gf16-calc") == 1;
    assert row_of_id(b[0..64], t[0..2560], 2, "nope") == PIN_NONE;
}
