// specs/t27os/release_020.t27 -- t27os: release 0.2.0 -- gather the T27 OS
// work since 0.1.3 into one build.
// Part of M1 (milestone #5). Closes #12479.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::release_020;

pub const RELEASE_020_VERSION : str = "0.2.0";

pub struct Release { version: str, gathered: bool };

pub fn release_gathered(r: Release) -> bool {
    return r.gathered && r.version == RELEASE_020_VERSION;
}

test "release 0.2.0 gathered" {
    assert(release_gathered(Release { version: "0.2.0", gathered: true }));
    assert(!release_gathered(Release { version: "0.1.3", gathered: true }));
}

invariant release_020_version {
    assert RELEASE_020_VERSION == "0.2.0";
}