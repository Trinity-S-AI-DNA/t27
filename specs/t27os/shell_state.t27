// SPDX-License-Identifier: Apache-2.0
; specs/t27os/shell_state.t27 -- the ONE shell-state contract of the fullscreen
; actor-graph surface: the tab strip, the graph expansion mode, the selected
; entity, the viewport and the back transition. Both the graph drawer
; (glass_window.t27) and the graph law (actor_graph.t27) read these constants;
; nobody re-declares them locally. A tab switch NEVER clears the selected
; entity or the viewport; the inspector is a temporary overlay, never a
; permanent shrink of the graph area. ASCII only (L3). phi^2 + 1/phi^2 = 3

module T27osShellState;

// ---------------------------------------------------------------- the tabs

/// The compact tab strip of the main working screen, one law for the drawer
/// and the law spec: Graph is the default and the graph owns the full area.
pub const SS_TAB_GRAPH : u32 = 0;
pub const SS_TAB_TASKS : u32 = 1;
pub const SS_TAB_EVENTS : u32 = 2;
pub const SS_TAB_INSPECTOR : u32 = 3;
pub const SS_TAB_CHECKS : u32 = 4;
pub const SS_TAB_SETTINGS : u32 = 5;
pub const SS_TAB_COUNT : u32 = 6;
pub const SS_TAB_NAMES : [SS_TAB_COUNT]str = ["Graph", "Tasks", "Events", "Inspector", "Checks", "Settings"];

pub fn ss_tab_ok(t : u32) -> bool { return t < SS_TAB_COUNT; }
pub fn ss_tab_default() -> u32 { return SS_TAB_GRAPH; }

// ---------------------------------------------------------- the expansion

/// Two distinct, honest modes: the graph fills the whole working area of the
/// window (SS_XP_AREA), or fullscreen hides even the tab strip (SS_XP_FULL).
/// Fullscreen is always paired with an explicit exit: ss_fs_exit_ok refuses a
/// fullscreen state that has no way back. An in-window expansion never claims
/// to be the system mode - the host labels it.
pub const SS_XP_AREA : u32 = 0;
pub const SS_XP_FULL : u32 = 1;
pub const SS_XP_COUNT : u32 = 2;

pub fn ss_fs_exit_ok(xp : u32, exit_present : bool) -> bool {
    if (xp == SS_XP_AREA) { return true; }
    return exit_present;
}

// ------------------------------------------------- the selected entity law

/// The selection is an opaque identity word (the QLG_Z packed identity on the
/// graph, the task_tree task id on Tasks, the event seq on Events - the tab
/// decides what the word means). A tab switch preserves it; going back clears
/// only the selection, never the viewport. QLG_Z_GONE may flow through: a
/// gone entity is SHOWN as gone, never silently cleared.
pub const SS_SEL_NONE : u64 = 0;

pub fn ss_tab_switch_keeps_sel(tab_was : u32, tab_now : u32, sel : u64) -> u64 {
    return sel;
}

/// Back: clears the selection only. The viewport word passes through untouched.
pub fn ss_back(sel : u64, vp : u64) -> u64 { return vp; }

/// Viewport: packed (x, y, scale) host-side; the law only demands it survives
/// a tab switch and a back untouched.
pub fn ss_viewport_keep(vp : u64) -> u64 { return vp; }

// ---------------------------------------------------------------- tests

test the_tab_strip_is_six_tabs_with_graph_default {
    assert(SS_TAB_COUNT == 6);
    assert(ss_tab_default() == SS_TAB_GRAPH);
    var t : u32 = 0;
    while (t < SS_TAB_COUNT) {
        assert(ss_tab_ok(t));
        t = t + 1;
    }
    assert(ss_tab_ok(6) == false);
    assert(SS_TAB_NAMES[0] == "Graph");
    assert(SS_TAB_NAMES[5] == "Settings");
}

test the_two_expansion_modes_are_distinct_and_fullscreen_has_an_exit {
    assert(SS_XP_AREA != SS_XP_FULL and SS_XP_COUNT == 2);
    assert(ss_fs_exit_ok(SS_XP_AREA, false));
    assert(ss_fs_exit_ok(SS_XP_FULL, true));
    assert(ss_fs_exit_ok(SS_XP_FULL, false) == false);
}

test a_tab_switch_never_clears_the_selection_or_the_viewport {
    var sel : u64 = 0x1234;
    var vp : u64 = 0x5678;
    sel = ss_tab_switch_keeps_sel(SS_TAB_GRAPH, SS_TAB_TASKS, sel);
    assert(sel == 0x1234);
    assert(ss_viewport_keep(vp) == 0x5678);
    sel = ss_tab_switch_keeps_sel(SS_TAB_TASKS, SS_TAB_EVENTS, sel);
    assert(sel == 0x1234);
}

test back_clears_only_the_selection {
    assert(ss_back(0x1234, 0x5678) == 0x5678);
    assert(ss_back(SS_SEL_NONE, 0x5678) == 0x5678);
}

invariant the_selection_none_is_zero_so_the_store_defaults_to_overview {
    assert(SS_SEL_NONE == 0);
    assert(SS_TAB_GRAPH == 0);
}
