// ---- imports: Foundation, the ObjC runtime, AppKit through objc_msgSend, CoreGraphics, CoreText ----

fn cf_bytes(alloc: u64, bytes: []const u8, n: usize, enc: u32, ext: bool) -> u64 { return @extern("CFStringCreateWithBytes"); }
fn cf_release(o: u64) -> void { @extern("CFRelease"); }
fn unix_time(t: u64) -> u64 { return @extern("time"); }
/// Seconds since 2001 with sub-second precision: the clock of the animations.
fn abs_time() -> f64 { return @extern("CFAbsoluteTimeGetCurrent"); }
fn class_named(name: u64) -> u64 { return @extern("NSClassFromString"); }
fn sel_named(name: u64) -> u64 { return @extern("NSSelectorFromString"); }
fn pool_push() -> u64 { return @extern("objc_autoreleasePoolPush"); }
