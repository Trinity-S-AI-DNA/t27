/// The bytes of ~/<dir><file> into dst; the count (0 when the file is missing or empty).
fn tg_read(hb: []const u8, dir: []const u8, file: []const u8, dst: []u8) -> usize {
    var pb : [320]u8 = undefined;
    var n : usize = put_bytes(pb[0..320], 0, hb);
    n = put_bytes(pb[0..320], n, dir);
    n = put_bytes(pb[0..320], n, file);
    pb[n] = 0;
    const fd : i32 = sys_open_ro(pb[0..320], 0);
    if (fd < 0) { return 0; }
    const r : i64 = sys_read(fd, dst, @as(u64, dst.len));
    sys_close(fd);
    if (r <= 0) { return 0; }
    return @as(usize, @intCast(r));
}

/// Keep whole lines only: the length up to and including the last LF of buf[at .. at + n].
fn tg_whole_lines(buf: []const u8, at: usize, n: usize) -> usize {
    var e : usize = n;
    while (e > 0 and buf[at + e - 1] != 10) { e = e - 1; }
    return e;
}

/// Start `/bin/sh -c <cmd>` where tb[at .. at + 6] is reserved for "sh", "-c" and the command is tb[at + 6 .. end].
/// The pid, 0 when the spawn failed.
fn tg_spawn(tb: []u8, at: usize, end: usize) -> u64 {
    tb[at] = 115;
    tb[at + 1] = 104;
    tb[at + 2] = 0;
    tb[at + 3] = 45;
    tb[at + 4] = 99;
    tb[at + 5] = 0;
    tb[end] = 0;
    var argv : [8]u64 = undefined;
    argv[0] = sys_addr(tb[at .. tb.len], tb[0..1], 0);
    argv[1] = sys_addr(tb[at + 3 .. tb.len], tb[0..1], 0);
    argv[2] = sys_addr(tb[at + 6 .. tb.len], tb[0..1], 0);
    argv[3] = 0;
    argv[4] = 0;
    argv[5] = 0;
    argv[6] = 0;
    argv[7] = 0;
    var cp : [16]u8 = undefined;
    put_bytes(cp[0..16], 0, "/bin/sh");
    cp[7] = 0;
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    const rc : i32 = sys_spawn(pid, cp[0..16], 0, 0, argv, 0);
    if (rc != 0 or pid[0] == 0) { return 0; }
    return @as(u64, pid[0]);
}

/// 0 while the job runs, 1 when it ended well, 2 when it failed or is gone.
fn tg_done(pid: u64) -> u32 {
    var st : [2]u32 = undefined;
    st[0] = 0;
    const r : i32 = sys_waitpid(@as(i32, @intCast(pid)), st, 1);
    if (r == 0) { return 0; }
    if (r > 0 and st[0] == 0) { return 1; }
    return 2;
}

/// The head of every host script: sh, -c, then `export HOME=".."; export PATH=..; D=..; mkdir -p $D; ` (a, b = the two halves).
fn tg_head(tb: []u8, hb: []const u8, a: []const u8, b: []const u8) -> usize {
    var e : usize = TBO_CMD + 6;
    e = put_bytes(tb, e, a);
    e = put_bytes(tb, e, hb);
    e = put_bytes(tb, e, b);
    return e;
}

/// A job that has outlived FEED_KILL_S is killed; the next reap clears it.
fn tg_late(now: u64, start: u64, pid: u64) -> void {
    if (now > start + FEED_KILL_S) { sys_kill(@as(i32, @intCast(pid)), 9); }
}

fn tg_bump(tg: []u64) -> void { tg[TPG_GEN] = tg[TPG_GEN] + 1; }

// ---- B: the BENCH host feed and its actions ----

/// The state word of card c from what the last feed read.
fn bn_state(tg: []const u64, tb: []const u8, c: u32) -> u64 {
    const sl : usize = @as(usize, tg[TPG_BN_LEN]);
    const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
    const dl : usize = @as(usize, tg[TPG_BN_LEN + 1 + c]);
    const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
    var dv : u64 = 1;
    if (c == 1) { dv = 2; }
    const ran : bool = (tg[TPG_BN_DET] / dv) % 2 == 1;
    return card_state(@as(u8, @intCast(c)), tb[TBO_SCAN .. TBO_SCAN + sl], tb[d0 .. d0 + dl], ran, tb[TBO_LS .. TBO_LS + ll]);
}

fn bn_start_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    e = put_bytes(tb, e, FEED_SCAN);
    tg[TPG_BN_LAST] = now;
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BN_PID] = pid;
        tg[TPG_BN_STAGE] = 1;
        tg[TPG_BN_START] = now;
    }
}

/// The scan and the serial nodes are in: read them, then run --detect for each card whose cable is seen once.
fn bn_after_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const sn : usize = tg_read(hb, BENCH_DIR, FILE_SCAN, tb[TBO_SCAN .. TBO_DET0]);
    const ln : usize = tg_read(hb, BENCH_DIR, FILE_LS, tb[TBO_LS .. TBO_PATH]);
    tg[TPG_BN_LEN] = @as(u64, sn);
    tg[TPG_BN_LEN + 1] = 0;
    tg[TPG_BN_LEN + 2] = 0;
    tg[TPG_BN_LEN + 3] = @as(u64, ln);
    tg[TPG_BN_DET] = 0;
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    var any : bool = false;
    var c : u32 = 0;
    while (c < 2) {
        const cu : u8 = @as(u8, @intCast(c));
        const bus : u64 = card_busdev(cu, tb[TBO_SCAN .. TBO_SCAN + sn]);
        tg[TPG_BN_BUS + c] = bus;
        const st : u64 = card_state(cu, tb[TBO_SCAN .. TBO_SCAN + sn], "", false, tb[TBO_LS .. TBO_LS + ln]);
        const dl : u32 = feed_detect_len(cu, st, bus);
        if (dl > 0) {
            var k : u32 = 0;
            while (k < dl) {
                tb[e] = @as(u8, @intCast(feed_detect_char(cu, bus, k)));
                e = e + 1;
                k = k + 1;
            }
            var p : u32 = 0;
            while (p < FEED_DET_PIECES) {
                e = put_bytes(tb, e, feed_det_piece(cu, p));
                p = p + 1;
            }
            var bit : u64 = 1;
            if (c == 1) { bit = 2; }
            tg[TPG_BN_DET] = tg[TPG_BN_DET] + bit;
            any = true;
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    if (any) {
        e = put_bytes(tb, e, "true");
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_BN_PID] = pid;
            tg[TPG_BN_STAGE] = 2;
            tg[TPG_BN_START] = now;
            return;
        }
        tg[TPG_BN_DET] = 0;
    }
    tg_bump(tg);
}

fn bn_after_detect(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var c : u32 = 0;
    while (c < 2) {
        var dv : u64 = 1;
        if (c == 1) { dv = 2; }
        if ((tg[TPG_BN_DET] / dv) % 2 == 1) {
            const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
            tg[TPG_BN_LEN + 1 + c] = @as(u64, tg_read(hb, BENCH_DIR, file_detect(@as(u8, @intCast(c))), tb[d0 .. d0 + 2048]));
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    tg_bump(tg);
}

/// Every frame: reap the finished jobs, start the refresh when it is due and the page is open.
fn bench_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_BN_STAGE] != 0) {
        const d : u32 = tg_done(tg[TPG_BN_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_BN_START], tg[TPG_BN_PID]);
        } else {
            tg[TPG_BN_PID] = 0;
            if (tg[TPG_BN_STAGE] == 1) { bn_after_scan(tg, tb, hb, now); } else { bn_after_detect(tg, tb, hb, now); }
        }
    } else if (page_feed_due(PAGE_BENCH, open, now, tg[TPG_BN_LAST])) {
        bn_start_scan(tg, tb, hb, now);
    }
    if (tg[TPG_BA_PID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_BA_PID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_BA_START], tg[TPG_BA_PID]);
        } else {
            tg[TPG_BA_PID] = 0;
            tg[TPG_BA_RLEN] = @as(u64, tg_read(hb, BENCH_DIR, FILE_RUN, tb[TBO_RUN .. TBO_KAN]));
            tg_bump(tg);
        }
    }
}

/// Run FLASH (confirmed, SRAM load) or the UART view of card c as a background job writing run.txt.
fn bn_run(tg: []u64, tb: []u8, hb: []const u8, now: u64, card: u32, act: u8) -> void {
    if (tg[TPG_BA_PID] != 0) { return; }
    const cu : u8 = @as(u8, @intCast(card));
    const st : u64 = bn_state(tg, tb, card);
    const bus : u64 = tg[TPG_BN_BUS + card];
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    if (act == ACT_FLASH) {
        const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
        const fl : u32 = host_flash_len(cu, st, bus, tb[TBO_PATH .. TBO_PATH + pl], true);
        if (fl == 0) { return; }
        var k : u32 = 0;
        while (k < fl) {
            tb[e] = @as(u8, @intCast(host_flash_char(cu, bus, tb[TBO_PATH .. TBO_PATH + pl], k)));
            e = e + 1;
            k = k + 1;
        }
        e = put_bytes(tb, e, FEED_RUN_TAIL);
    } else if (act == ACT_UART) {
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const at : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        const pn : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], at);
        if (pn == 0 or pn > 120) { return; }
        var j : u32 = 0;
        while (j < pn) {
            tb[TBO_SCR + @as(usize, j)] = tb[TBO_LS + @as(usize, at) + @as(usize, j)];
            j = j + 1;
        }
        const port : []const u8 = tb[TBO_SCR .. TBO_SCR + @as(usize, pn)];
        if (uart_view_allowed(cu, st, port) == false) { return; }
        e = put_bytes(tb, e, UV_A);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_B);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_C);
    } else {
        return;
    }
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BA_PID] = pid;
        tg[TPG_BA_START] = now;
        tg[TPG_BA_CARD] = @as(u64, card);
        tg[TPG_BA_KIND] = @as(u64, act);
        tg[TPG_BA_RLEN] = 0;
    }
    tg_bump(tg);
}

/// What a click on the B page asks the host to run: 0 nothing, 1 the UART view, 2 the confirmed FLASH. The state it
/// changes (the dialogue, the refresh timer) is changed here; no job is started here.
fn bench_click_do(tg: []u64, tb: []const u8, hit: u32) -> u32 {
    if (hit == BH_NONE) { return 0; }
    const card : u32 = hit / 8;
    const kind : u32 = hit % 8;
    const st : u64 = bn_state(tg, tb, card);
    var run : u32 = 0;
    if (kind == BH_DETECT) {
        // DETECT runs the same refresh now (the next frame starts it when no stage is running)
        if (act_enabled(st, ACT_DETECT) and tg[TPG_BN_STAGE] == 0) { tg[TPG_BN_LAST] = 0; }
    } else if (kind == BH_FLASH) {
        if (act_enabled(st, ACT_FLASH)) {
            tg[TPG_BA_FS] = @as(u64, fs_next(FS_NONE, FE_FLASH_CLICK, false));
            tg[TPG_BA_CARD] = @as(u64, card);
            tg[TPG_BA_PLEN] = 0;
        }
    } else if (kind == BH_UART) {
        if (act_enabled(st, ACT_UART)) { run = 1; }
    } else if (kind == BH_CONFIRM) {
        if (tg[TPG_BA_FS] == FS_CONFIRM) {
            const ns : u32 = fs_next(FS_CONFIRM, FE_CONFIRM, true);
            tg[TPG_BA_FS] = 0;
            if (ns == FS_RUN) { run = 2; }
        }
    } else if (kind == BH_CANCEL) {
        tg[TPG_BA_FS] = @as(u64, fs_next(@as(u32, @intCast(tg[TPG_BA_FS])), FE_CANCEL, false));
    }
    tg_bump(tg);
    return run;
}

/// A click on the B page: hit = card * 8 + BH_*.
fn bench_click(tg: []u64, tb: []u8, hb: []const u8, now: u64, hit: u32) -> void {
    const run : u32 = bench_click_do(tg, tb, hit);
    if (run == 1) { bn_run(tg, tb, hb, now, hit / 8, ACT_UART); }
    if (run == 2) { bn_run(tg, tb, hb, now, hit / 8, ACT_FLASH); }
}

/// A key while the FLASH dialogue is open: ev is FE_RETURN, FE_ESCAPE, TG_EV_BACK or TG_EV_CHAR (ch = the character).
fn bench_key(tg: []u64, tb: []u8, ev: u32, ch: u32) -> void {
    const fs : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
    if (fs == FS_TYPING and ev == TG_EV_CHAR) {
        if (flash_char_ok(ch, @as(u32, @intCast(pl)))) {
            tb[TBO_PATH + pl] = @as(u8, @intCast(ch));
            tg[TPG_BA_PLEN] = @as(u64, pl + 1);
        }
    } else if (fs == FS_TYPING and ev == TG_EV_BACK) {
        if (pl > 0) { tg[TPG_BA_PLEN] = @as(u64, pl - 1); }
    } else if (ev == FE_RETURN or ev == FE_ESCAPE) {
        const ok : bool = flash_path_ok(tb[TBO_PATH .. TBO_PATH + pl]);
        tg[TPG_BA_FS] = @as(u64, fs_next(fs, ev, ok));
    }
    tg_bump(tg);
}

// ---- drawing helpers of the pages ----

fn tg_txt(c: u64, kit: [48]u64, s: []const u8, x: f64, y: f64, size: f64, weight: f64, alpha: f64, right: f64) -> f64 {
    if (s.len == 0) { return 0.0; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, alpha);
    return draw_fit(c, kit, s, s.len, x, y, size, weight, true, right);
}

/// "0x" and eight hex digits of v into out at at.
fn put_hex8(out: []u8, at: usize, v: u64) -> usize {
    var n : usize = put_bytes(out, at, "0x");
    var sh : u64 = 8;
    while (sh > 0) {
        sh = sh - 1;
        var d : u64 = v;
        var q : u64 = 0;
        while (q < sh) {
            d = d / 16;
            q = q + 1;
        }
        d = d % 16;
        if (d < 10) { out[n] = @as(u8, @intCast(48 + d)); } else { out[n] = @as(u8, @intCast(87 + d)); }
        n = n + 1;
    }
    return n;
}

/// A lamp of a bench card: grey ring, red, amber, green or blue-white disc, in the traffic-light palette.
fn draw_lamp(c: u64, x: f64, y: f64, lamp: u8, a: f64) -> void {
    if (lamp == LAMP_GREY) {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_line_width(c, 1.0);
        cg_arc(c, x, y, 4.0, 0.0, 6.283185307, 0);
        cg_stroke_path(c);
        return;
    }
    if (lamp == LAMP_RED) { draw_light_dot(c, x, y, LIGHT_RED, a); }
    if (lamp == LAMP_AMBER) { draw_light_dot(c, x, y, LIGHT_YELLOW, a); }
    if (lamp == LAMP_GREEN) { draw_light_dot(c, x, y, LIGHT_GREEN, a); }
    if (lamp == LAMP_BLUE) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
        cg_fill_path(c);
    }
}

fn tg_button(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, label: []const u8, hot: bool, on: bool, a: f64) -> void {
    round_rect(c, x, y, w, h, 5.0);
    cg_line_width(c, 1.0);
    var k : f64 = 0.35;
    if (hot and on) { k = 0.9; }
    if (on == false) { k = 0.16; }
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, k * a);
    cg_stroke_path(c);
    var ta : f64 = 1.0;
    if (on == false) { ta = 0.35; }
    const tw : f64 = bytes_w(kit, label, label.len, 9.5, WEIGHT_BOLD, true);
    tg_txt(c, kit, label, x + 0.5 * w - 0.5 * tw, y + 0.5 * h + 3.5, 9.5, WEIGHT_BOLD, ta * a, 0.0);
}

fn tg_in(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x < l + w and y >= t and y < t + h;
}

// ---- B: the page ----

fn draw_bench_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const cw : f64 = bp_card_w(pw);
    const ask : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const ask_card : u32 = @as(u32, @intCast(tg[TPG_BA_CARD]));
    const hit : u32 = bp_hit(mx - x0, my - y0, pw, BH_NONE);
    var line : [160]u8 = undefined;
    var ci : u32 = 0;
    while (ci < 2) {
        const cu : u8 = @as(u8, @intCast(ci));
        const cx : f64 = x0 + BP_PAD;
        const cy : f64 = y0 + bp_card_y(cu);
        const st : u64 = bn_state(tg, tb, ci);
        const ds : u8 = die_status(st);
        plate(c, cx, cy, cw, BP_CARD_H, sw, a);
        // title row: lamp, board, model (a GUESS says so), status word
        draw_lamp(c, cx + 16.0, cy + 17.0, lamp_of(ds), a);
        const tw : f64 = tg_txt(c, kit, card_title(cu), cx + 30.0, cy + 21.0, 13.0, WEIGHT_HEAVY, a, 0.0);
        var mal : f64 = 0.55;
        if (card_model_known(cu) == false) { mal = 0.38; }
        // the PL part is ESTABLISHED by the tool's own manufacturer/family/model lines (MEASURED); the board model stays a guess
        const mdn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const md0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        const mpl : u32 = @as(u32, card_chain_len(cu)) - 1;
        const mfa : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "manufacturer");
        const mfb : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "family");
        const mfc : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "model");
        if (mfc != 4294967295 and mfb != 4294967295 and mfa != 4294967295) {
            var mn : usize = put_bytes(line[0..160], 0, "PL ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfa) .. md0 + @as(usize, mfa) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfa))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfb) .. md0 + @as(usize, mfb) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfb))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfc) .. md0 + @as(usize, mfc) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfc))]);
            mn = put_bytes(line[0..160], mn, " (measured); board model: ");
            mn = put_bytes(line[0..160], mn, card_model_text(cu));
            tg_txt(c, kit, line[0..mn], cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, 0.7 * a, cx + cw - 150.0);
        } else {
            tg_txt(c, kit, card_model_text(cu), cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, mal * a, cx + cw - 150.0);
        }
        const sw2 : f64 = bytes_w(kit, die_status_text(ds), die_status_text(ds).len, 9.5, WEIGHT_SEMIBOLD, true);
        tg_txt(c, kit, die_status_text(ds), cx + cw - 14.0 - sw2, cy + 20.0, 9.5, WEIGHT_SEMIBOLD, a, 0.0);
        // the chain from TDI: one box per TAP with its IDCODE (live, else the one measured on 2026-10-20, else not measured)
        const n : u32 = card_chain_len(cu);
        const dn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const d0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        var k : u32 = 0;
        while (k < n) {
            const bx : f64 = cx + 14.0 + @as(f64, @floatFromInt(k)) * 118.0;
            const by : f64 = cy + 36.0;
            if (k > 0) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
                cg_fill_rect(c, bx - 22.0, by + 20.0, 22.0, 1.0);
            }
            round_rect(c, bx, by, 96.0, 42.0, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_stroke_path(c);
            tg_txt(c, kit, box_label(cu, k), bx + 8.0, by + 15.0, 10.0, WEIGHT_BOLD, a, bx + 92.0);
            const live : u64 = card_idcode_live(tb[d0 .. d0 + dn], k);
            const last : u64 = card_idcode_measured(cu, k);
            var ln : usize = 0;
            var ia : f64 = 0.9;
            if (idcode_known(live)) {
                ln = put_hex8(line[0..160], 0, live);
            } else if (idcode_known(last)) {
                ln = put_hex8(line[0..160], 0, last);
                ia = 0.45;
            } else {
                ln = put_bytes(line[0..160], 0, "not measured");
                ia = 0.45;
            }
            tg_txt(c, kit, line[0..ln], bx + 8.0, by + 32.0, 9.0, 0.0, ia * a, bx + 92.0);
            k = k + 1;
        }
        // the facts: cable, serial, busdev, uart; each says where it came from
        const fx : f64 = cx + 14.0 + @as(f64, @floatFromInt(n)) * 118.0 + 10.0;
        const fy : f64 = cy + 42.0;
        tg_txt(c, kit, "cable", fx, fy, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_cable_text(cu), fx + 50.0, fy, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "serial", fx, fy + 13.0, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_serial(cu), fx + 50.0, fy + 13.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "busdev", fx, fy + 26.0, 9.0, 0.0, 0.5 * a, 0.0);
        const bus : u64 = tg[TPG_BN_BUS + ci];
        if (bus_known(bus) and st_has(st, ST_CABLE)) {
            var bn : usize = put_dec(line[0..160], 0, bus / 1000);
            bn = put_bytes(line[0..160], bn, ":");
            bn = put_dec(line[0..160], bn, bus % 1000);
            tg_txt(c, kit, line[0..bn], fx + 50.0, fy + 26.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 26.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        tg_txt(c, kit, "uart", fx, fy + 39.0, 9.0, 0.0, 0.5 * a, 0.0);
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const pc : u32 = port_count(tb[TBO_LS .. TBO_LS + ll], cu);
        const p0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        if (pc > 0 and p0 != 4294967295) {
            var pn : usize = put_dec(line[0..160], 0, @as(u64, pc));
            if (pc == 1) { pn = put_bytes(line[0..160], pn, " port  "); } else { pn = put_bytes(line[0..160], pn, " ports  "); }
            var pj : u32 = 0;
            while (pj < pc and pj < 3) {
                const pj0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, pj);
                const pjl : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], pj0);
                const pja : usize = TBO_LS + @as(usize, pj0);
                if (pj > 0) { pn = put_bytes(line[0..160], pn, "  "); }
                pn = put_bytes(line[0..160], pn, tb[pja .. pja + @as(usize, pjl)]);
                pj = pj + 1;
            }
            tg_txt(c, kit, line[0..pn], fx + 50.0, fy + 39.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 39.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        // provenance of the numbers above: the command and how long ago it ran
        var pv : usize = 0;
        if (tg[TPG_BN_AT] > 0) {
            pv = put_bytes(line[0..160], 0, "measured ");
            const dran : bool = (tg[TPG_BN_DET] / (1 + ci)) % 2 == 1;
            if (dran and bus_known(bus)) {
                // the command this cable actually ran: -c digilent for the Adept FTDI2232, -c digilent_hs2 for the FT232H
                const rl2 : u32 = cmd_raw_len(cu, ACT_DETECT, bus, "") - 1;
                var rk : u32 = 0;
                while (rk < rl2 and pv < 120) {
                    line[pv] = @as(u8, @intCast(cmd_char(cu, ACT_DETECT, bus, "", rk)));
                    pv = pv + 1;
                    rk = rk + 1;
                }
            } else {
                pv = put_bytes(line[0..160], pv, src_command(SRC_SCAN_USB));
            }
            pv = put_bytes(line[0..160], pv, "  ");
            pv = put_dec(line[0..160], pv, now - tg[TPG_BN_AT]);
            pv = put_bytes(line[0..160], pv, " s ago");
        } else {
            pv = put_bytes(line[0..160], 0, "not measured yet: openFPGALoader --scan-usb");
        }
        tg_txt(c, kit, line[0..pv], cx + 14.0, cy + BP_CARD_H - 44.0, 8.0, 0.0, 0.42 * a, cx + cw - 10.0);
        // buttons, or the FLASH dialogue in their place
        const by2 : f64 = cy + bp_btn_y();
        if (ask != FS_NONE and ask_card == ci) {
            round_rect(c, cx + 2.0 * BP_PAD, by2, bp_field_w(cw), BP_BTN_H, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.6 * a);
            cg_stroke_path(c);
            const pl2 : usize = @as(usize, tg[TPG_BA_PLEN]);
            var fn2 : usize = 0;
            if (ask == FS_TYPING) {
                fn2 = put_bytes(line[0..160], 0, "FLASH .bit path: ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, "_");
            } else {
                fn2 = put_bytes(line[0..160], 0, "load ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, " into SRAM?");
            }
            tg_txt(c, kit, line[0..fn2], cx + 2.0 * BP_PAD + 8.0, by2 + 16.0, 9.5, 0.0, a, cx + 2.0 * BP_PAD + bp_field_w(cw) - 6.0);
            tg_button(c, kit, cx + bp_confirm_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CONFIRM", mx >= cx + bp_confirm_x(cw) + BP_PAD and mx < cx + bp_confirm_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, ask == FS_CONFIRM, a);
            tg_button(c, kit, cx + bp_cancel_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CANCEL", mx >= cx + bp_cancel_x(cw) + BP_PAD and mx < cx + bp_cancel_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, true, a);
        } else {
            var bi : u32 = 0;
            while (bi < 3) {
                tg_button(c, kit, cx + BP_PAD + @as(f64, @floatFromInt(bi)) * (BP_BTN_W + BP_BTN_GAP) + 0.0, by2, BP_BTN_W, BP_BTN_H, act_label(@as(u8, @intCast(bi))), hit == ci * 8 + bi, act_enabled(st, @as(u8, @intCast(bi))), a);
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }
    // the run log of FLASH and UART: the last lines of ~/.t27os/bench/run.txt, control bytes shown as spaces
    const ly : f64 = y0 + bp_log_y();
    const lh : f64 = bp_log_h(ph);
    plate(c, x0 + BP_PAD, ly, cw, lh, sw, a);
    var hn : usize = put_bytes(line[0..160], 0, "RUN LOG  ");
    if (tg[TPG_BA_PID] != 0) {
        hn = put_bytes(line[0..160], hn, "running ");
        hn = put_bytes(line[0..160], hn, act_label(@as(u8, @intCast(tg[TPG_BA_KIND]))));
    } else if (tg[TPG_BA_RLEN] > 0) {
        hn = put_bytes(line[0..160], hn, "last output of the host job");
    } else {
        hn = put_bytes(line[0..160], hn, "nothing run yet; FLASH asks for a .bit path and a confirm");
    }
    tg_txt(c, kit, line[0..hn], x0 + BP_PAD + 12.0, ly + 15.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, x0 + BP_PAD + cw - 10.0);
    const rl : usize = @as(usize, tg[TPG_BA_RLEN]);
    var rows : u32 = 0;
    if (lh > 40.0) { rows = @as(u32, @intFromFloat((lh - 28.0) / 12.0)); }
    // walk back from the end over `rows` lines
    var from : usize = rl;
    var seen : u32 = 0;
    while (from > 0 and seen < rows) {
        from = from - 1;
        if (tb[TBO_RUN + from] == 10 or tb[TBO_RUN + from] == 13) {
            if (from + 1 < rl) { seen = seen + 1; }
        }
    }
    var ry : f64 = ly + 30.0;
    var s0 : usize = from;
    while (s0 < rl and ry < ly + lh - 4.0) {
        var e0 : usize = s0;
        var ob : [120]u8 = undefined;
        var on : usize = 0;
        while (e0 < rl and tb[TBO_RUN + e0] != 10 and tb[TBO_RUN + e0] != 13) {
            const ch : u8 = tb[TBO_RUN + e0];
            if (on < 120) {
                if (ch >= 32 and ch < 127) { ob[on] = ch; } else { ob[on] = 32; }
                on = on + 1;
            }
            e0 = e0 + 1;
        }
        if (on > 0) {
            tg_txt(c, kit, ob[0..on], x0 + BP_PAD + 12.0, ry, 8.5, 0.0, 0.82 * a, x0 + BP_PAD + cw - 10.0);
            ry = ry + 12.0;
        }
        s0 = e0 + 1;
    }
}

// ---- K: the KANBAN host feed, the board and the drops ----

/// Read both feed files into the board's log: issues first, then pull requests, whole lines only.
fn kn_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const half : usize = @as(usize, FEED_CAP / 2);
    var n1 : usize = tg_read(hb, KANBAN_DIR, FILE_ISSUES, tb[TBO_KAN .. TBO_KAN + half]);
    n1 = tg_whole_lines(tb, TBO_KAN, n1);
    var n2 : usize = tg_read(hb, KANBAN_DIR, FILE_PRS, tb[TBO_KAN + n1 .. TBO_KAN + @as(usize, FEED_CAP)]);
    n2 = tg_whole_lines(tb, TBO_KAN + n1, n2);
    tg[TPG_K_LEN] = @as(u64, n1 + n2);
}

// ---- L: LANES and ACTORS in the chat sidebar (lanes_view.t27) ----

pub const TBO_LF : usize = 49152;
pub const TBO_LF_N : usize = 6000;
pub const TBO_LT : usize = 55152;
pub const TBO_LT_N : usize = 4800;
pub const TBO_LTXT : usize = 59952;
pub const TB_LANES_END : usize = 65536;
pub const TPG_L_LAST : u32 = 76;
pub const TPG_L_PID : u32 = 77;
pub const TPG_L_START : u32 = 78;
pub const TPG_L_LEN : u32 = 79;
pub const TPG_L_TPID : u32 = 80;
pub const TPG_L_TLEN : u32 = 81;
pub const TPG_L_TLAST : u32 = 82;
pub const TPG_L_TISSUE : u32 = 83;
/// sst[0..32] are the sessions' states; sst[SST_LV ..] is the lanes table the sidebar draws.
pub const SST_LVN : usize = 32;
pub const SST_LVOFF : usize = 33;
pub const SST_LVSEL : usize = 34;
pub const SST_LVTAIL : usize = 35;
pub const SST_LVKEY : usize = 36;
/// the log view's scroll (lines up from the bottom) and whether the kernel group is expanded
pub const SST_LVLSCR : usize = 38;
pub const SST_LVKX : usize = 39;
/// the pane server's phase (term_pane SRV_*), kept for the banner
pub const SST_SRV : usize = 556;
pub const SST_LV : usize = 40;
pub const SST_SIZE : usize = 560;
pub const LV_TAIL_LINES : u32 = 40;

/// Where the LANES block starts: right under the last AGENTS row (or its empty line).
pub fn lane_block_top(n: u32, rows: u32) -> f64 {
    var r : u32 = rows;
    if (r == 0) { r = 1; }
    return row_top(WS_TOP, GROUP_AGENTS, n, r - 1) + AGENT_ROW_H + 8.0;
}

/// Rows of the block that fit above the sidebar foot.
pub fn lane_block_vis(top: f64, sh: f64) -> u32 { return lv_visible(sh - FOOT_H - top); }

/// Is the point in the LANES block of the expanded sidebar?
pub fn on_lane_block(x: f64, y: f64, top: f64, sh: f64) -> bool {
    return x >= 12.0 and x < SIDE_W - 12.0 and y >= top and y < sh - FOOT_H;
}

/// One run of the feed job and its reap; the tail job likewise, again every two seconds while a tail is open.
fn lanes_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, up: bool, tail_issue: u32) -> void {
    if (tg[TPG_L_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_L_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_L_START], tg[TPG_L_PID]);
        } else {
            tg[TPG_L_PID] = 0;
            const n : usize = tg_read(hb, LV_DIR, LV_FILE, tb[TBO_LF .. TBO_LF + TBO_LF_N]);
            tg[TPG_L_LEN] = @as(u64, tg_whole_lines(tb, TBO_LF, n));
            tg_bump(tg);
        }
    } else if (lv_refresh_due(up, now, tg[TPG_L_LAST])) {
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = put_bytes(tb, e, LV_FEED_CMD);
        tg[TPG_L_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_L_PID] = pid;
            tg[TPG_L_START] = now;
        }
    }
    if (tg[TPG_L_TPID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_L_TPID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_L_TLAST], tg[TPG_L_TPID]);
        } else {
            tg[TPG_L_TPID] = 0;
            tg[TPG_L_TLEN] = @as(u64, tg_read(hb, LV_DIR, LV_TAIL_FILE, tb[TBO_LT .. TBO_LT + TBO_LT_N]));
            tg_bump(tg);
        }
    } else if (tail_issue != 0 and (tg[TPG_L_TLAST] == 0 or now >= tg[TPG_L_TLAST] + 2 or tg[TPG_L_TISSUE] != @as(u64, tail_issue))) {
        var e2 : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e2 = e2 + lv_tail_cmd(tail_issue, tb[e2 .. TBO_ROOT]);
        tg[TPG_L_TLAST] = now;
        tg[TPG_L_TISSUE] = @as(u64, tail_issue);
        const pid2 : u64 = tg_spawn(tb, TBO_CMD, e2);
        if (pid2 != 0) { tg[TPG_L_TPID] = pid2; }
    }
}

/// Rebuild the table the sidebar draws: this space's panes, the script lanes and own-git lines of the feed, the
/// Queen, the kernel tree. Called when the generation moved or a session changed; the table lives in sst.
fn lanes_build(sst: []u32, tb: []u8, tg: []const u64, ss: u64, space: u32, god: bool, now: u32) -> void {
    var n : u32 = 0;
    const rows : u32 = sessions_in(ss, space);
    var r : u32 = 0;
    var nm : [32]u8 = undefined;
    while (r < rows and r < 16) {
        const si : u32 = session_at_row(ss, space, r);
        const k : u32 = session_agent(ss, si);
        const ln : usize = csv_field(AGENT_NAMES, k, nm[0..32]);
        n = lv_pane_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, nm[0..ln], 0, 0, row_state(sst, si), false, 1, LV_NOT_MEASURED);
        r = r + 1;
    }
    n = lv_parse(tb[TBO_LF .. TBO_LF + @as(usize, tg[TPG_L_LEN])], now, sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    // the Queen's numbers come from the rows above (her lanes), counted before the own-git lines fold
    const tabv : []const u32 = sst[SST_LV .. SST_SIZE];
    const q_run : u32 = lv_work_count(tabv, n, LVS_RUNNING);
    const q_idle : u32 = lv_work_count(tabv, n, LVS_IDLE);
    const q_blk : u32 = lv_work_count(tabv, n, LVS_BLOCKED);
    const q_rev : u32 = lv_count(tabv, n, LVS_READY);
    // the footer bar's lanes and Queen items read these (statusbar.t27); the feed exists once the table has rows
    sst[SST_QRUN] = q_run;
    sst[SST_QIDLE] = q_idle;
    sst[SST_QBLK] = q_blk;
    sst[SST_QREV] = q_rev;
    sst[SST_QFEED] = 1;
    n = lv_queen_counts_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, q_run, q_idle, q_blk, q_rev, god);
    if (q_run == 0 and q_blk == 0) { n = lv_note_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n); }
    var ls : [16]u32 = undefined;
    var lj : u32 = 0;
    var lanes : u32 = 0;
    while (lj < n and lanes < 16) {
        if (sst[SST_LV + @as(usize, lj) * LV_F + LVF_SRC] == LV_SCRIPT) {
            ls[lanes] = sst[SST_LV + @as(usize, lj) * LV_F + LVF_STATE];
            lanes = lanes + 1;
        }
        lj = lj + 1;
    }
    n = lv_fold_trigit(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_kernel_rows(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, lanes, ls[0..16]);
    lv_sort(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_fold_kernel(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, sst[SST_LVKX] != 0);
    sst[SST_LVN] = n;
    sst[SST_LVOFF] = lv_scroll_clamp(sst[SST_LVOFF], n, 8);
    if (sst[SST_LVSEL] != LV_NONE) {
        var found : u32 = LV_NONE;
        var fj : u32 = 0;
        while (fj < n and found == LV_NONE) {
            if (sst[SST_LV + @as(usize, fj) * LV_F + LVF_SRC] == sst[SST_LVKEY] and sst[SST_LV + @as(usize, fj) * LV_F + LVF_ISSUE] == sst[SST_LVKEY + 1]) { found = fj; }
            fj = fj + 1;
        }
        sst[SST_LVSEL] = found;
    }
}

fn kanban_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_K_LOADED] == 0) {
        kn_load(tg, tb, hb);
        tg[TPG_K_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_K_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_K_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_K_START], tg[TPG_K_PID]);
        } else {
            tg[TPG_K_PID] = 0;
            kn_load(tg, tb, hb);
            tg[TPG_K_AT] = now;
            tg[TPG_K_PNUM] = 0;
            tg[TPG_K_ACT] = 0;
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_KANBAN, open, now, tg[TPG_K_LAST])) {
        var e : usize = tg_head(tb, hb, K_HEAD_A, K_HEAD_B);
        e = put_bytes(tb, e, GH_ISSUES_A);
        e = put_bytes(tb, e, JQ_ISSUES);
        e = put_bytes(tb, e, GH_ISSUES_B);
        e = put_bytes(tb, e, GH_PRS_A);
        e = put_bytes(tb, e, JQ_PRS);
        e = put_bytes(tb, e, GH_PRS_B);
        tg[TPG_K_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_K_PID] = pid;
            tg[TPG_K_START] = now;
        }
    }
}

/// The board is drawn below a 22 pt head strip.
pub const KN_HEAD : f64 = 22.0;

/// Column under x and the card line under (x, y) of the board at (x0, y0) pw x ph; KB_NONE for none.
fn kn_col_under(x: f64, pw: f64, x0: f64) -> u32 { return kb_col_at(pw, x - x0); }

fn kn_card_under(tg: []const u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> u32 {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const col : u32 = kb_col_at(pw, x - x0);
    if (col >= KB_COLS) { return KB_NONE; }
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const cnt : u32 = kb_count(log, col, pnum, pto);
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    var shown : u32 = 0;
    if (cnt > sc) { shown = cnt - sc; }
    if (shown > rows) { shown = rows; }
    const i : u32 = kb_card_at(shown, pw, col, x - x0, y - (y0 + KN_HEAD));
    if (i >= shown) { return KB_NONE; }
    return kb_nth(log, col, sc + i, pnum, pto);
}

/// Mouse down on the board: pick up the card under the pointer.
fn kanban_down(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    const ls : u32 = kn_card_under(tg, tb, x, y, x0, y0, pw, ph);
    if (ls == KB_NONE) { return; }
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    tg[TPG_K_DRAG] = @as(u64, ls) + 1;
    tg[TPG_K_FROM] = @as(u64, kn_col_under(x, pw, x0));
    tg_bump(tg);
}

/// Mouse up: the drop. Only the rules of kanban.t27 decide; an accepted move is a proposal kept on the board
/// until the next refresh (no GitHub write, no agent started), a refused one only says so.
fn kanban_up(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64) -> void {
    if (tg[TPG_K_DRAG] == 0) { return; }
    const ls : u32 = @as(u32, @intCast(tg[TPG_K_DRAG] - 1));
    tg[TPG_K_DRAG] = 0;
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const to : u32 = kn_col_under(x, pw, x0);
    tg_bump(tg);
    if (to >= KB_COLS or y < y0 + KN_HEAD) { return; }
    const from : u32 = @as(u32, @intCast(tg[TPG_K_FROM]));
    const doing : u32 = kb_count(log, kb_doing(), 0, 0);
    const act : u32 = kb_drop(from, to, doing);
    if (to == kb_col_of(log, ls)) {
        // back where the rule puts it: the proposal is gone
        tg[TPG_K_PNUM] = 0;
        tg[TPG_K_ACT] = 0;
        return;
    }
    tg[TPG_K_ACT] = @as(u64, act);
    if (kb_proposes(act)) {
        tg[TPG_K_PNUM] = @as(u64, kb_num(log, ls));
        tg[TPG_K_PTO] = @as(u64, to);
    }
}

fn kanban_scroll(tg: []u64, tb: []const u8, ph: f64, dir: i64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    var most : u32 = 0;
    var c : u32 = 0;
    while (c < KB_COLS) {
        const n : u32 = kb_count(log, c, pnum, pto);
        if (n > most) { most = n; }
        c = c + 1;
    }
    var maxs : u32 = 0;
    if (most > rows) { maxs = most - rows; }
    var s : i64 = @as(i64, @intCast(tg[TPG_K_SCROLL])) + dir;
    if (s < 0) { s = 0; }
    if (s > @as(i64, maxs)) { s = @as(i64, maxs); }
    tg[TPG_K_SCROLL] = @as(u64, @intCast(s));
    tg_bump(tg);
}

/// One card: id and badge, the title, the pinned agents (owner first, bold), a GUESS mark when no path named a letter.
fn draw_kn_card(c: u64, kit: [48]u64, tb: []const u8, len: usize, ls: u32, x: f64, y: f64, w: f64, hot: bool, proposed: bool, ghost: bool, sw: f64, full: bool, a0: f64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + len];
    var a : f64 = a0;
    if (ghost) { a = a0 * 0.55; }
    plate(c, x, y, w, kb_card_h(), sw, a);
    if (hot) {
        round_rect(c, x, y, w, kb_card_h(), TILE_CORNER);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
        cg_stroke_path(c);
    }
    if (proposed) { dashed_frame(c, x + 1.0, y + 1.0, w - 2.0, kb_card_h() - 2.0, a); }
    var hb : [48]u8 = undefined;
    var n : usize = 0;
    if (kb_is_pr(log, ls)) { n = put_bytes(hb[0..48], 0, "PR #"); } else { n = put_bytes(hb[0..48], 0, "#"); }
    n = put_dec(hb[0..48], n, @as(u64, kb_num(log, ls)));
    const iw : f64 = tg_txt(c, kit, hb[0..n], x + 7.0, y + 14.0, 9.0, WEIGHT_BOLD, a, 0.0);
    // the badge: a PR shows its checks, an issue its first label
    const cb : u32 = kb_checks_byte(log, ls);
    if (cb == 114) { tg_txt(c, kit, "checks running", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 112) { tg_txt(c, kit, "checks pass", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 102) { tg_txt(c, kit, "checks FAIL", x + 7.0 + iw + 8.0, y + 14.0, 8.0, WEIGHT_BOLD, 0.95 * a, x + w - 6.0); }
    const bn : u32 = kb_badge_n(log, ls);
    if (cb == 0 and bn > 0) {
        const bs : usize = @as(usize, kb_badge_at(log, ls));
        tg_txt(c, kit, tb[TBO_KAN + bs .. TBO_KAN + bs + @as(usize, bn)], x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.55 * a, x + w - 6.0);
    }
    const tn : usize = @as(usize, kb_title_n(log, ls));
    const ts : usize = @as(usize, kb_title_at(log, ls));
    tg_txt(c, kit, tb[TBO_KAN + ts .. TBO_KAN + ts + tn], x + 7.0, y + 30.0, 9.5, WEIGHT_SEMIBOLD, a, x + w - 6.0);
    // the agents: owner first, bold; on hover the full line
    const na : u32 = kb_agents(log, ls);
    var k : u32 = 0;
    while (k < na) {
        const l : u32 = kb_agent(log, ls, k);
        const chx : f64 = x + 7.0 + @as(f64, @floatFromInt(k)) * (kb_chip_w() + 2.0);
        const chy : f64 = y + kb_card_h() - kb_chip_h() - 5.0;
        round_rect(c, chx, chy, kb_chip_w(), kb_chip_h(), 3.0);
        cg_line_width(c, 1.0);
        var ka : f64 = 0.3;
        if (k == 0) { ka = 0.7; }
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
        cg_stroke_path(c);
        var wgt : f64 = 0.0;
        if (k == 0) { wgt = WEIGHT_BOLD; }
        if (l >= 1 and l <= 27) { tg_txt(c, kit, AGENT_LETTERS[l - 1], chx + 4.0, chy + 11.5, 8.5, wgt, a, 0.0); }
        k = k + 1;
    }
    if (card_guess(log, ls)) {
        tg_txt(c, kit, "GUESS", x + w - 40.0, y + kb_card_h() - 10.0, 7.5, 0.0, 0.45 * a, 0.0);
    }
    if (proposed) {
        tg_txt(c, kit, "PROPOSED", x + w - 56.0, y + 14.0, 7.5, WEIGHT_BOLD, 0.9 * a, 0.0);
    }
    if (hot) {
        var al : [64]u8 = undefined;
        var an : usize = put_bytes(al[0..64], 0, "AGENTS:");
        var q : u32 = 0;
        while (q < na) {
            an = put_bytes(al[0..64], an, " ");
            an = put_bytes(al[0..64], an, AGENT_LETTERS[kb_agent(log, ls, q) - 1]);
            q = q + 1;
        }
        if (card_guess(log, ls)) { an = put_bytes(al[0..64], an, " (guess: no path names a letter)"); }
        tg_txt(c, kit, al[0..an], x + 7.0, y + kb_card_h() - 22.0 + 0.0, 7.5, WEIGHT_SEMIBOLD, 0.8 * a, x + w - 6.0);
    }
}

fn draw_kanban_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const bx : f64 = x0;
    const by : f64 = y0 + KN_HEAD;
    const bh : f64 = ph - KN_HEAD;
    const rows : u32 = kb_rows_fit(bh);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    const drag : u32 = @as(u32, @intCast(tg[TPG_K_DRAG]));
    var line : [200]u8 = undefined;
    // head strip: BOARD, the data's age, the message of the last drop
    var hn : usize = put_bytes(line[0..200], 0, "BOARD  gHashTag/t27  ");
    if (tg[TPG_K_LEN] == 0) {
        hn = put_bytes(line[0..200], hn, "not measured: gh issue list / gh pr list gave nothing yet");
    } else if (tg[TPG_K_AT] > 0) {
        hn = put_bytes(line[0..200], hn, "gh refreshed ");
        hn = put_dec(line[0..200], hn, now - tg[TPG_K_AT]);
        hn = put_bytes(line[0..200], hn, " s ago, every 60 s while open");
    } else {
        hn = put_bytes(line[0..200], hn, "last saved copy, refreshing");
    }
    tg_txt(c, kit, line[0..hn], bx + kb_pad(), y0 + 14.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, bx + 0.55 * pw);
    const act : u32 = @as(u32, @intCast(tg[TPG_K_ACT]));
    if (kb_text(act).len > 0) {
        tg_txt(c, kit, kb_text(act), bx + 0.55 * pw, y0 + 14.0, 8.5, 0.0, 0.9 * a, bx + pw - kb_pad());
    }
    const hotls : u32 = kn_card_under(tg, tb, mx, my, x0, y0, pw, ph);
    const hotcol : u32 = kn_col_under(mx, pw, x0);
    var c2 : u32 = 0;
    while (c2 < KB_COLS) {
        const cx : f64 = bx + kb_col_x(c2, pw);
        const cwid : f64 = kb_col_w(pw);
        plate(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), sw, a);
        const cnt : u32 = kb_count(log, c2, pnum, pto);
        var cn : usize = put_bytes(line[0..200], 0, kb_col_name(c2));
        cn = put_bytes(line[0..200], cn, "  ");
        cn = put_dec(line[0..200], cn, @as(u64, cnt));
        if (c2 == kb_doing()) { cn = put_bytes(line[0..200], cn, " / 3"); }
        tg_txt(c, kit, line[0..cn], cx + 8.0, by + kb_pad() + 18.0, 9.5, WEIGHT_BOLD, a, cx + cwid - 6.0);
        if (drag != 0 and hotcol == c2) {
            const act2 : u32 = kb_drop(@as(u32, @intCast(tg[TPG_K_FROM])), c2, kb_count(log, kb_doing(), 0, 0));
            round_rect(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), TILE_CORNER);
            cg_line_width(c, 1.5);
            var ha : f64 = 0.25;
            if (kb_proposes(act2)) { ha = 0.9; }
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, ha * a);
            cg_stroke_path(c);
        }
        var shown : u32 = 0;
        if (cnt > sc) { shown = cnt - sc; }
        if (shown > rows) { shown = rows; }
        var i : u32 = 0;
        while (i < shown) {
            const ls : u32 = kb_nth(log, c2, sc + i, pnum, pto);
            if (ls != KB_NONE) {
                const isdrag : bool = drag != 0 and ls + 1 == drag;
                draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), ls, bx + kb_card_x(c2, pw), by + kb_card_y(i), kb_card_w(pw), hotls == ls and drag == 0, pnum != 0 and kb_num(log, ls) == pnum and pto == c2, isdrag, sw, full, a);
            }
            i = i + 1;
        }
        if (cnt > sc + shown) {
            var mn : usize = put_bytes(line[0..200], 0, "+");
            mn = put_dec(line[0..200], mn, @as(u64, cnt - sc - shown));
            mn = put_bytes(line[0..200], mn, " more (scroll)");
            tg_txt(c, kit, line[0..mn], cx + 8.0, by + bh - kb_pad() - 4.0, 8.0, 0.0, 0.5 * a, cx + cwid - 6.0);
        }
        c2 = c2 + 1;
    }
    if (drag != 0) {
        draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), drag - 1, mx - 0.5 * kb_card_w(pw), my - 12.0, kb_card_w(pw), true, false, false, sw, full, a);
    }
}

// ---- Q: the QUEEN live board ----

/// The folder the host jobs of the Q page run in: the repository of the space on screen, else the first bound
/// space. Written to tb[TBO_ROOT ..]; the byte count (0 when no space is bound).
fn qn_root(dk: [128]u64, space: u32, tb: []u8) -> usize {
    var found : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
    if (dk_len(dk, found) == 0) {
        var i : u32 = 0;
        while (i < SPACE_COUNT and dk_len(dk, found) == 0) {
            found = dk_at(dk, dk[DK_SLOTS], @as(u64, i));
            i = i + 1;
        }
    }
    if (dk_len(dk, found) == 0) { return 0; }
    return ns_bytes(found, tb[TBO_ROOT .. TBO_ROOT + 256]);
}

/// The value of counter m now: the host's two files, the two the window knows, the rest not measured.
fn qn_after(tg: []const u64, m: u32) -> u32 {
    if (m == M_LINKS or m == M_TESTS) { return @as(u32, @intCast(tg[TPG_Q_AFTER + m])); }
    if (m == M_NO_INSTRUMENT) { return live_no_instrument(); }
    if (m == M_UNASSIGNED) { return @as(u32, @intCast(tg[TPG_Q_UNASS])); }
    return qb_nm();
}

/// A refresh ended (or none could run): the lane log, and the start-of-day snapshot at the first refresh of a local day.
fn qn_finish(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    tg[TPG_Q_LANELEN] = @as(u64, tg_whole_lines(tb, TBO_LANES, tg_read(hb, QUEEN_DIR, FILE_LANES, tb[TBO_LANES .. TBO_CMD - 200])));
    const tz : i64 = @as(i64, @intCast(tg[TPG_Q_TZ])) - @as(i64, @intCast(TG_TZ_BIAS));
    if (snapshot_due(now, tg[TPG_Q_SNAP], tz)) {
        var m : u32 = 0;
        while (m < M_COUNT) {
            tg[TPG_Q_BEFORE + m] = @as(u64, qn_after(tg, m));
            m = m + 1;
        }
        tg[TPG_Q_SNAP] = now;
    }
    tg[TPG_Q_AT] = now;
    tg_bump(tg);
}

fn queen_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_Q_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_Q_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_Q_START], tg[TPG_Q_PID]);
        } else {
            tg[TPG_Q_PID] = 0;
            const n1 : usize = tg_read(hb, QUEEN_DIR, FILE_LINKS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_LINKS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n1]));
            const n2 : usize = tg_read(hb, QUEEN_DIR, FILE_TESTS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_TESTS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n2]));
            qn_finish(tg, tb, hb, now);
        }
    } else if (page_feed_due(PAGE_QUEEN, open, now, tg[TPG_Q_LAST])) {
        tg[TPG_Q_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            var e : usize = tg_head(tb, hb, Q_HEAD_A, Q_HEAD_B);
            e = put_bytes(tb, e, tb[TBO_ROOT .. TBO_ROOT + rn]);
            e = put_bytes(tb, e, Q_HEAD_C);
            e = put_bytes(tb, e, meter_cmd(M_LINKS));
            e = put_bytes(tb, e, Q_LINKS_TAIL);
            e = put_bytes(tb, e, meter_cmd(M_TESTS));
            e = put_bytes(tb, e, Q_TESTS_TAIL);
            const pid : u64 = tg_spawn(tb, TBO_CMD, e);
            if (pid != 0) {
                tg[TPG_Q_PID] = pid;
                tg[TPG_Q_START] = now;
                return;
            }
        }
        tg[TPG_Q_AFTER + M_LINKS] = @as(u64, qb_nm());
        tg[TPG_Q_AFTER + M_TESTS] = @as(u64, qb_nm());
        qn_finish(tg, tb, hb, now);
    }
}

// ---- the updater (release.t27): the window hosts the rules --------------------------------------------------
// Owner, 2026-10-20: updates install on every computer on the fly, online. release.t27 decides every step and
// writes every command; this block spawns the commands as `/bin/sh -c` jobs (tg_spawn), reaps them from the
// frame loop and reads their files. Words TPG_U_*; the job kinds below.
pub const TPG_U_ST : u32 = 90;
pub const TPG_U_PID : u32 = 91;
pub const TPG_U_KIND : u32 = 92;
pub const TPG_U_START : u32 = 93;
pub const TPG_U_LAST : u32 = 94;
pub const TPG_U_CUR : u32 = 95;
pub const TPG_U_CAND : u32 = 96;
pub const TPG_U_CANDV : u32 = 97;
pub const TPG_U_WHY : u32 = 98;
pub const TPG_U_GO : u32 = 99;
pub const TPG_U_QUIET : u32 = 100;
pub const TPG_U_BOOT : u32 = 101;
pub const TPG_U_UP0 : u32 = 102;
pub const TPG_U_MARK : u32 = 103;
pub const TPG_U_FAILB : u32 = 104;
pub const TPG_U_BLEN : u32 = 105;
pub const TPG_U_BUSY : u32 = 106;
pub const TPG_U_ON : u32 = 107;
pub const TPG_U_STAGED : u32 = 108;
/// Polls that failed in a row (release.t27 poll_gap backs the next one off), the second the toast began (0 = none),
/// the live module's applied revision, and a flag that the live file must be read again.
pub const TPG_U_FAILS : u32 = 180;
pub const TPG_U_TOAST : u32 = 181;
pub const TPG_V_REV : u32 = 182;
pub const TPG_V_DIRTY : u32 = 183;
pub const TPG_U_TSEC : u32 = 184;
/// The update channel (release.t27 CH_*, from T27OS_UPDATE_CHANNEL at launch), the source of the manifest the update
/// follows (SRC_*) and the owner its files are on (OW_*).
pub const TPG_U_CHAN : u32 = 185;
pub const TPG_U_SRC : u32 = 186;
pub const TPG_U_OWN : u32 = 187;
/// T27OS_QA=1 at launch (1) and the last UPDTICK signature logged (up_qa_sig + 1; 0 = none yet).
pub const TPG_U_QA : u32 = 188;
pub const TPG_U_QAL : u32 = 189;
pub const UP_CHECK : u64 = 1;
pub const UP_DOWNLOAD : u64 = 2;
pub const UP_STAGE : u64 = 3;
pub const UP_SWAP : u64 = 4;
pub const UP_MARK : u64 = 5;
pub const UP_CONFIRM : u64 = 6;
pub const UP_ROLLBACK : u64 = 7;
/// The manifest is read into tb[TBO_SCR ..], then the sums (two files, one after the other) and the three
/// --version outputs; the room is TBO_SCR .. TBO_SIZE.
pub const UP_MAN : usize = 2048;
pub const UP_SUMS : usize = 2560;
pub const UP_VER : usize = 128;
pub const UP_CAP : usize = 6000;
/// A job that outlives this is killed; the download is the long one. The poll is up to three 20-second fetches (the
/// live data and the manifests of both sources).
pub const UP_KILL_CHECK_S : u64 = 90;
pub const UP_KILL_LONG_S : u64 = 900;

/// Panes the server lists as working or blocked on you: the swap never happens while one is.
fn up_busy(sst: []const u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < 32) {
        const s : u32 = row_state(sst, i);
        if (s == S_WORKING or s == S_BLOCKED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Start the command that a release.t27 builder wrote at tb[TBO_CMD + 6 ..] (n bytes); false when it did not fit or did not start.
fn up_start(tg: []u64, tb: []u8, n: usize, kind: u64, now: u64) -> bool {
    if (n == 0 or n > UP_CAP) { return false; }
    const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + n);
    if (pid == 0) { return false; }
    tg[TPG_U_PID] = pid;
    tg[TPG_U_KIND] = kind;
    tg[TPG_U_START] = now;
    return true;
}

fn up_fail(tg: []u64, why: u8, mark_bad: bool) -> void {
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_FAILED, 0));
    tg[TPG_U_WHY] = @as(u64, why);
    tg[TPG_U_GO] = 0;
    if (mark_bad) { tg[TPG_U_FAILB] = tg[TPG_U_CAND]; }
    // any failed step backs the next poll off (a download that keeps failing must not retry every hour)
    tg[TPG_U_FAILS] = @as(u64, fails_after(false, @as(u32, @intCast(tg[TPG_U_FAILS]))));
}

/// The digits at the start of a small file (a build number followed by a newline).
fn up_num(tb: []const u8, at: usize, n: usize) -> u32 {
    var e : usize = 0;
    while (e < n and tb[at + e] >= 48 and tb[at + e] <= 57) { e = e + 1; }
    return parse_build(tb[at .. at + e], e);
}

/// The first start of this process: act on the marker an earlier swap left, and learn the build a rollback refused.
fn up_boot(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64) -> void {
    tg[TPG_U_BOOT] = 1;
    tg[TPG_U_UP0] = now;
    const rn : usize = tg_read(hb, UPD_DIR, F_REJECTED, tb[TBO_SCR .. TBO_SCR + 16]);
    tg[TPG_U_FAILB] = @as(u64, up_num(tb, TBO_SCR, rn));
    const mn : usize = tg_read(hb, UPD_DIR, F_PENDING, tb[TBO_SCR .. TBO_SCR + 8]);
    const mk : u8 = marker_of(mn > 0, tb[TBO_SCR]);
    const kn : usize = tg_read(hb, UPD_DIR, F_KEPT, tb[TBO_SCR .. TBO_SCR + 8]);
    const act : u8 = boot_action(mk, kn > 0);
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (act == BOOT_FIRST) {
        // the first start of a build the updater swapped in: say so in the header for TOAST_S seconds
        tg[TPG_U_TOAST] = now;
        tg[TPG_U_MARK] = 1;
        up_start(tg, tb, mark_cmd(out, UP_CAP, hb, hb.len), UP_MARK, now);
    } else if (act == BOOT_ROLLBACK) {
        up_start(tg, tb, rollback_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CUR]))), UP_ROLLBACK, now);
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    } else if (act == BOOT_BROKEN) {
        tg[TPG_U_MARK] = 1;
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    }
}

/// Read the manifest fetched from src into tb[TBO_SCR ..]; its length.
fn up_man_read(tb: []u8, hb: []const u8, src: u8) -> usize {
    return tg_read(hb, UPD_DIR, manifest_file(src), tb[TBO_SCR .. TBO_SCR + UP_MAN]);
}

/// Is the manifest of src, as fetched by this channel, one the app may follow? Its version and build go to vb[0], vb[1].
fn up_src_ok(tb: []u8, hb: []const u8, ch: u8, src: u8, vb: []u64) -> bool {
    vb[0] = 0;
    vb[1] = 0;
    if (channel_fetches(ch, src) == false) { return false; }
    const mn : usize = up_man_read(tb, hb, src);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    if (manifest_check_from(man, mn, src) != M_OK) { return false; }
    vb[0] = manifest_version(man, mn);
    vb[1] = manifest_build(man, mn);
    return true;
}

/// A poll finished: pick the channel's manifest (release.t27 channel_pick), judge it and start the download of a newer build.
fn up_checked(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const ch : u8 = @as(u8, @intCast(tg[TPG_U_CHAN]));
    var uv : [2]u64 = undefined;
    var fv : [2]u64 = undefined;
    const uok : bool = up_src_ok(tb, hb, ch, SRC_UPSTREAM, uv[0..2]);
    const fok : bool = up_src_ok(tb, hb, ch, SRC_FORK, fv[0..2]);
    const src : u8 = channel_pick(ch, uok, uv[0], @as(u32, @intCast(uv[1])), fok, fv[0], @as(u32, @intCast(fv[1])));
    if (src == SRC_NONE) {
        // no manifest of this channel can be followed: never fall back to another source's file
        tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_NO_OFFER, 0));
        tg[TPG_U_WHY] = @as(u64, WHY_MANIFEST);
        return;
    }
    const pick : u8 = src;
    const mn : usize = up_man_read(tb, hb, pick);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    const chk : u8 = manifest_check_from(man, mn, pick);
    const cb : u64 = manifest_build(man, mn);
    var bld : u32 = 0;
    if (cb != NO_FIELD) { bld = @as(u32, @intCast(cb)); }
    const ver : u64 = manifest_version(man, mn);
    const off : u8 = offer(chk, ver, bld, current_version(), @as(u32, @intCast(tg[TPG_U_CUR])), @as(u32, @intCast(tg[TPG_U_FAILB])), true);
    var st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    if (off == OFFER_UPDATE) {
        tg[TPG_U_CAND] = @as(u64, bld);
        tg[TPG_U_CANDV] = ver;
        tg[TPG_U_SRC] = @as(u64, pick);
        tg[TPG_U_OWN] = @as(u64, manifest_owner(man, mn));
        tg[TPG_U_WHY] = @as(u64, WHY_NONE);
        if (tg[TPG_U_STAGED] == @as(u64, bld)) {
            tg[TPG_U_ST] = @as(u64, U_STAGED);
            return;
        }
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_OFFER, 0));
        if (up_start(tg, tb, download_cmd(out, UP_CAP, hb, hb.len, ver, bld, @as(u8, @intCast(tg[TPG_U_OWN]))), UP_DOWNLOAD, now) == false) { up_fail(tg, WHY_DOWNLOAD, false); }
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(st, EV_NO_OFFER, 0));
    tg[TPG_U_WHY] = @as(u64, WHY_NONE);
    if (off == OFFER_BAD_MANIFEST) { tg[TPG_U_WHY] = @as(u64, WHY_MANIFEST); }
}

/// The download finished: its digests against the manifest, then the stage job.
fn up_downloaded(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = up_man_read(tb, hb, @as(u8, @intCast(tg[TPG_U_SRC])));
    var fb : [48]u8 = undefined;
    const fn1 : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const sn : usize = tg_read(hb, UPD_DIR, fb[0..fn1], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + sn], sn, tb[TBO_SCR .. TBO_SCR + mn], mn, 0, ROWS_DOWNLOADED);
    if (bad != 0) {
        up_fail(tg, WHY_SHA, true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_DOWNLOADED, 0));
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (up_start(tg, tb, stage_cmd(out, UP_CAP, hb, hb.len, tg[TPG_U_CANDV], b), UP_STAGE, now) == false) { up_fail(tg, WHY_STAGE, false); }
}

/// The stage finished (unzipped, signed, versions asked): every digest, every tool's commit, then staged or refused.
fn up_staged(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = up_man_read(tb, hb, @as(u8, @intCast(tg[TPG_U_SRC])));
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    var fb : [48]u8 = undefined;
    var fl : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const s1 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    fl = put_build_file(fb[0..48], 48, 0, b, "sums2.txt");
    const s2 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN + s1 .. TBO_SCR + UP_SUMS + 140]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + s1 + s2], s1 + s2, man, mn, 0, ROWS_ALL);
    const cm : u64 = field_str(man, mn, KEY_COMMIT, KEY_COMMIT.len);
    var want : []const u8 = man[0..0];
    if (cm != NO_FIELD) { want = man[field_start(cm) .. field_start(cm) + field_len(cm)]; }
    var worst : u8 = TV_OK;
    var k : u32 = 0;
    while (k < 3) {
        const at : usize = TBO_SCR + UP_SUMS + 140 + @as(usize, k) * UP_VER;
        if (k == 0) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27b.txt"); }
        if (k == 1) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27c.txt"); }
        if (k == 2) { fl = put_build_file(fb[0..48], 48, 0, b, "v_tri.txt"); }
        const vn : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[at .. at + UP_VER]);
        worst = tv_worse(worst, tool_verdict(tb[at .. at + vn], vn, want, want.len));
        k = k + 1;
    }
    const d : u8 = install_decision(bad, worst, tg[TPG_U_BLEN] > 0);
    if (d != ID_INSTALL) {
        up_fail(tg, why_of_decision(d), true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_SIGNED, 0));
    tg[TPG_U_STAGED] = @as(u64, b);
}

/// A job ended (ok: it exited 0). Decide the next step.
fn up_finished(tg: []u64, tb: []u8, hb: []const u8, now: u64, kind: u64, ok: bool) -> void {
    if (kind == UP_CHECK) {
        // the poll also fetched the live data: read it again whatever the manifest says
        tg[TPG_V_DIRTY] = 1;
        if (ok) {
            tg[TPG_U_FAILS] = @as(u64, fails_after(true, 0));
            up_checked(tg, tb, hb, now);
        } else { up_fail(tg, WHY_OFFLINE, false); }
    } else if (kind == UP_DOWNLOAD) {
        if (ok) { up_downloaded(tg, tb, hb, now); } else { up_fail(tg, WHY_DOWNLOAD, false); }
    } else if (kind == UP_STAGE) {
        if (ok) { up_staged(tg, tb, hb); } else { up_fail(tg, WHY_STAGE, true); }
    } else if (kind == UP_SWAP) {
        // a swap that worked ends in a relaunch (hot_reload); one that did not leaves the old app and says why
        if (ok == false) { up_fail(tg, WHY_SWAP, true); }
    }
}

/// One frame of the updater: reap the running job, else do the next thing that is due.
fn update_tick(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64, busy: u32) -> void {
    if (tg[TPG_U_ON] == 0) { return; }
    // the header toast: a redraw each second while it shows, and one when it goes
    if (tg[TPG_U_TOAST] != 0) {
        if (toast_on(now, tg[TPG_U_TOAST])) {
            if (tg[TPG_U_TSEC] != now) {
                tg[TPG_U_TSEC] = now;
                tg_bump(tg);
            }
        } else {
            tg[TPG_U_TOAST] = 0;
            tg_bump(tg);
        }
    }
    if (tg[TPG_U_BUSY] != @as(u64, busy)) {
        tg[TPG_U_BUSY] = @as(u64, busy);
        tg_bump(tg);
    }
    if (busy > 0) { tg[TPG_U_QUIET] = 0; } else if (tg[TPG_U_QUIET] == 0) { tg[TPG_U_QUIET] = now; }
    if (tg[TPG_U_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_U_PID]);
        if (d == 0) {
            var lim : u64 = UP_KILL_CHECK_S;
            if (tg[TPG_U_KIND] == UP_DOWNLOAD or tg[TPG_U_KIND] == UP_STAGE) { lim = UP_KILL_LONG_S; }
            if (now > tg[TPG_U_START] + lim) { sys_kill(@as(i32, @intCast(tg[TPG_U_PID])), 9); }
            return;
        }
        const kind : u64 = tg[TPG_U_KIND];
        tg[TPG_U_PID] = 0;
        up_finished(tg, tb, hb, now, kind, d == 1);
        tg_bump(tg);
        if (tg[TPG_U_PID] != 0) { return; }
    }
    if (tg[TPG_U_BOOT] == 0) {
        up_boot(tg, tb, hb, bp, now);
        tg_bump(tg);
        return;
    }
    if (tg[TPG_U_MARK] != 0 and confirm_due(now - tg[TPG_U_UP0])) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_MARK] = 0;
        up_start(tg, tb, confirm_cmd(out, UP_CAP, hb, hb.len), UP_CONFIRM, now);
        return;
    }
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    var quiet : u64 = 0;
    if (tg[TPG_U_QUIET] != 0 and now > tg[TPG_U_QUIET]) { quiet = now - tg[TPG_U_QUIET]; }
    if (swap_ready(st, busy, quiet, tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        const sn : usize = swap_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CAND])));
        tg[TPG_U_GO] = 0;
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_SWAP, busy));
        if (up_start(tg, tb, sn, UP_SWAP, now) == false) { up_fail(tg, WHY_SWAP, false); }
        tg_bump(tg);
        return;
    }
    if (st == U_IDLE and (check_due(now, tg[TPG_U_LAST], @as(u32, @intCast(tg[TPG_U_FAILS]))) or tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_LAST] = now;
        tg[TPG_U_GO] = 0;
        if (up_start(tg, tb, check_cmd(out, UP_CAP, hb, hb.len, @as(u8, @intCast(tg[TPG_U_CHAN]))), UP_CHECK, now)) {
            tg[TPG_U_ST] = @as(u64, update_step(st, EV_CHECK, busy));
        }
        tg_bump(tg);
    }
}

/// What one UPDTICK line says, packed: state, reason, job kind, a job running, a poll due, the updater held (a call
/// or T27OS_QUIET_JOBS), the updater on, and the candidate build. A new line is logged only when this changes.
pub fn up_qa_sig(tg: []const u64, due: bool, held: bool) -> u64 {
    var s : u64 = (tg[TPG_U_ST] % 256) + 256 * (tg[TPG_U_WHY] % 256) + 65536 * (tg[TPG_U_KIND] % 256);
    if (tg[TPG_U_PID] != 0) { s = s + 16777216; }
    if (due) { s = s + 33554432; }
    if (held) { s = s + 67108864; }
    if (tg[TPG_U_ON] != 0) { s = s + 134217728; }
    return s + 268435456 * (tg[TPG_U_CAND] % 16777216);
}

/// "UPDTICK on=1 held=0 st=1 why=0 job=1 run=1 due=0 last=.. fails=0 chan=2 cur=7107 cand=0\n", its length.
pub fn up_qa_line(tg: []const u64, due: bool, held: bool, out: []u8) -> usize {
    if (out.len < 200) { return 0; }
    var n : usize = put_bytes(out, 0, "UPDTICK on=");
    n = put_dec(out, n, tg[TPG_U_ON]);
    n = put_bytes(out, n, " held=");
    if (held) { n = put_bytes(out, n, "1"); } else { n = put_bytes(out, n, "0"); }
    n = put_bytes(out, n, " st=");
    n = put_dec(out, n, tg[TPG_U_ST]);
    n = put_bytes(out, n, " why=");
    n = put_dec(out, n, tg[TPG_U_WHY]);
    n = put_bytes(out, n, " job=");
    n = put_dec(out, n, tg[TPG_U_KIND]);
    n = put_bytes(out, n, " run=");
    if (tg[TPG_U_PID] != 0) { n = put_bytes(out, n, "1"); } else { n = put_bytes(out, n, "0"); }
    n = put_bytes(out, n, " due=");
    if (due) { n = put_bytes(out, n, "1"); } else { n = put_bytes(out, n, "0"); }
    n = put_bytes(out, n, " last=");
    n = put_dec(out, n, tg[TPG_U_LAST]);
    n = put_bytes(out, n, " fails=");
    n = put_dec(out, n, tg[TPG_U_FAILS]);
    n = put_bytes(out, n, " chan=");
    n = put_dec(out, n, tg[TPG_U_CHAN]);
    n = put_bytes(out, n, " cur=");
    n = put_dec(out, n, tg[TPG_U_CUR]);
    n = put_bytes(out, n, " cand=");
    n = put_dec(out, n, tg[TPG_U_CAND]);
    return put_bytes(out, n, "\n");
}

/// T27OS_QA=1 (a test aid): one UPDTICK line to stderr each time the GitHub updater's state, reason, job or hold
/// changes. That path logs nothing else (the UPDATE* lines are the friends' updater, update_agent.t27).
fn up_qa(tg: []u64, now: u64, held: bool) -> void {
    if (tg[TPG_U_QA] == 0) { return; }
    const due : bool = check_due(now, tg[TPG_U_LAST], @as(u32, @intCast(tg[TPG_U_FAILS])));
    const s : u64 = up_qa_sig(tg, due, held) + 1;
    if (s == tg[TPG_U_QAL]) { return; }
    tg[TPG_U_QAL] = s;
    var line : [200]u8 = undefined;
    const n : usize = up_qa_line(tg, due, held, line[0..200]);
    if (n > 0) { sys_write(2, line[0..n], @as(u64, n)); }
}

// ---- the live layer (hot_reload.t27): the data the window re-reads while it runs --------------------------------

/// The built-in level of every live theme value, as permille, in the order of hot_reload.t27 THV_*.
fn thv_defaults(tbl: []u32) -> void {
    tbl[THV_TINT_BLACK] = thv_permille(TINT_BLACK);
    tbl[THV_STRICT_SIDE] = thv_permille(STRICT_SIDE);
    tbl[THV_ELEVATED_BLACK] = thv_permille(ELEVATED_BLACK);
    tbl[THV_STRICT_CONTENT] = thv_permille(STRICT_CONTENT);
    tbl[THV_PANEL_BLACK] = thv_permille(PANEL_BLACK);
    tbl[THV_TEXT_WHITE] = thv_permille(TEXT_WHITE);
    tbl[THV_LABEL_WHITE] = thv_permille(LABEL_WHITE);
    tbl[THV_MUTED_WHITE] = thv_permille(MUTED_WHITE);
    tbl[THV_BORDER_WHITE] = thv_permille(BORDER_WHITE);
    tbl[THV_LINE_WHITE] = thv_permille(LINE_WHITE);
    tbl[THV_HIGHLIGHT_WHITE] = thv_permille(HIGHLIGHT_WHITE);
    tbl[THV_TIP_WHITE] = thv_permille(TIP_WHITE);
    tbl[THV_CROWN_WHITE] = thv_permille(CROWN_WHITE);
    tbl[THV_TERMINAL_TINT] = thv_permille(TERMINAL_TINT);
    tbl[THV_AGENTS_LINE_ALPHA] = thv_permille(AGENTS_LINE_ALPHA);
}

/// Pack a table into the three kit words the draw code reads.
fn thv_store(kk: []u64, tbl: []const u32) -> void {
    kk[K_LIVE0] = live_pack(tbl, 0);
    kk[K_LIVE1] = live_pack(tbl, 1);
    kk[K_LIVE2] = live_pack(tbl, 2);
}

/// One live theme level: what the draw code multiplies its alpha by (the constant until a live module moves it).
fn lv(kit: [48]u64, id: u32) -> f64 {
    return live_get(kit[K_LIVE0], kit[K_LIVE1], kit[K_LIVE2], id);
}

/// Read ~/.t27os/live/live.t27 and apply it to the kit: the theme levels and, when the count matches, the petal names.
/// A file that fails live_check, or is older than the applied revision, changes nothing. The caller redraws.
fn live_load(tg: []u64, tb: []u8, hb: []const u8, kk: []u64) -> bool {
    const n : usize = tg_read(hb, LIVE_DIR, F_LIVE, tb[TBO_SCR .. TBO_SCR + LIVE_MAX_BYTES + 1]);
    if (n == 0) { return false; }
    const t : []const u8 = tb[TBO_SCR .. TBO_SCR + n];
    const rev : u64 = live_rev(t, n);
    if (live_should_apply(live_check(t, n), rev, tg[TPG_V_REV]) == false) { return false; }
    var tbl : [15]u32 = undefined;
    thv_defaults(tbl[0..15]);
    live_apply(t, n, tbl[0..15]);
    thv_store(kk, tbl[0..15]);
    const pf : u64 = live_petals(t, n, PETAL_COUNT - 1);
    if (pf != NO_FIELD) {
        const ns : u64 = cf_bytes(0, t[field_start(pf) .. field_start(pf) + field_len(pf)], field_len(pf), UTF8, false);
        if (ns != 0) {
            const arr : u64 = msg1(ns, sel("componentsSeparatedByString:"), cf(","));
            msg0(arr, sel("retain"));
            kk[K_NAMES] = arr;
            cf_release(ns);
        }
    }
    tg[TPG_V_REV] = rev;
    return true;
}

/// The header toast "updated to <ver> b<build>", right of the title, for TOAST_S seconds after the first start of a
/// swapped-in build: a small glass chip at the right end of the header, left of the "+".
fn draw_update_toast(c: u64, kit: [48]u64, tg: []const u64, now: u64, sw: f64, a: f64) -> void {
    if (tg[TPG_U_ON] == 0 or toast_on(now, tg[TPG_U_TOAST]) == false) { return; }
    var w : [48]u8 = undefined;
    const n : usize = toast_text(w[0..48], 48, current_version(), @as(u32, @intCast(tg[TPG_U_CUR])));
    if (n == 0 or n > 48) { return; }
    const tw : f64 = bytes_w(kit, w[0..48], n, 10.5, WEIGHT_SEMIBOLD, false);
    const bw : f64 = tw + 20.0;
    const bx : f64 = new_chat_x(sw) - 12.0 - bw;
    const by : f64 = WS_TOP + 0.5 * (HEADER_H - 22.0);
    round_rect(c, bx, by, bw, 22.0, 11.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_HIGHLIGHT_WHITE) * 1.5 * a);
    cg_fill_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE) * a);
    draw_bytes(c, kit, w[0..48], n, bx + 10.0, by + 15.0, 10.5, WEIGHT_SEMIBOLD, false);
}

pub const UP_STRIP_H : f64 = 22.0;

/// The update line sits on the sidebar just above the foot, while there is something to say.
pub fn on_update_strip(x: f64, y: f64, sh: f64, ws: u32, collapsed: bool, shown: bool) -> bool {
    return shown and in_side(x, ws, collapsed) and y >= sh - FOOT_H - UP_STRIP_H and y < sh - FOOT_H;
}

fn draw_update_strip(c: u64, kit: [48]u64, tg: []const u64, mx: f64, my: f64, sh: f64, ws: u32, collapsed: bool, a: f64) -> void {
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    const why : u8 = @as(u8, @intCast(tg[TPG_U_WHY]));
    if (tg[TPG_U_ON] == 0 or strip_kind(st, why) == STRIP_HIDDEN) { return; }
    var w : [96]u8 = undefined;
    const n : usize = strip_text(w[0..96], 96, st, why, @as(u32, @intCast(tg[TPG_U_CAND])), @as(u32, @intCast(tg[TPG_U_BUSY])));
    if (n == 0 or n > 96) { return; }
    var la : f64 = lv(kit, THV_LABEL_WHITE);
    if (on_update_strip(mx, my, sh, ws, collapsed, true) or strip_kind(st, why) == STRIP_READY) { la = lv(kit, THV_TEXT_WHITE); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    draw_bytes(c, kit, w[0..96], n, 14.0, sh - FOOT_H - 8.0, 9.5, WEIGHT_SEMIBOLD, false);
}

/// The evolve Panel from what the window knows (see evolve_next): letters with no instrument, pinned to nothing, and widgets no letter owns.
fn make_panel(unassigned: u32) -> Panel {
    var p : Panel = Panel { master_red: false, blocked: 0, stale: 0, unowned_count: 0, no_instrument: 0, never_pinned: 0, no_widget_count: unassigned, no_widget: 0 };
    if (unassigned > 0) { p.no_widget = letter_bit(LETTER_UNOWNED); }
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (widgets_of_letter(l) == 0) { p.no_instrument = p.no_instrument + letter_bit(l); }
        if (pinned_widgets(l, false) + pinned_widgets(l, true) + pinned_surfaces(l, false) + pinned_surfaces(l, true) == 0) { p.never_pinned = p.never_pinned + letter_bit(l); }
        l = l + 1;
    }
    return p;
}

/// Tasks the Queen started in the last hour, read from the ring copy.
fn qn_started_hour(tg: []const u64, now: u64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < RING) {
        const e : u64 = tg[TPG_Q_RING + i];
        if (e != 0 and ev_control(e) == C_QUEEN_STARTED and now < ev_sec(e) + 3600) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn qn_node(c: u64, kit: [48]u64, n: u32, x0: f64, y0: f64, pw: f64, ph: f64, sw: f64, full: bool, a: f64) -> void {
    const nx : f64 = x0 + node_x(n, pw);
    const ny : f64 = y0 + node_y(n, pw, ph);
    plate(c, nx, ny, node_w(n, pw), node_h(n, pw, ph), sw, a);
    var nb : [32]u8 = undefined;
    const nn : usize = csv_field(QN_NAMES, n, nb[0..32]);
    tg_txt(c, kit, nb[0..nn], nx + 10.0, ny + 14.0, 9.5, WEIGHT_BOLD, a, nx + node_w(n, pw) - 10.0);
}

fn draw_queen_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    var line : [200]u8 = undefined;
    var wb : [64]u8 = undefined;
    const god : bool = tg[TPG_Q_GOD] != 0;
    var unp : u32 = @as(u32, @intCast(tg[TPG_Q_UNASS]));
    if (qb_measured(unp) == false) { unp = 0; }
    const panel : Panel = make_panel(unp);
    // ---- LAMPS: 27, each from the per-letter aggregate the host feeds; none is fed, so each says not measured
    qn_node(c, kit, QN_LAMPS, x0, y0, pw, ph, sw, full, a);
    tg_txt(c, kit, "not measured: domain_pulse cannot be linked into the window yet (#5980)", x0 + node_x(QN_LAMPS, pw) + 70.0, y0 + node_y(QN_LAMPS, pw, ph) + 14.0, 8.0, 0.0, 0.5 * a, x0 + node_x(QN_LAMPS, pw) + node_w(QN_LAMPS, pw) - 10.0);
    var li : u32 = 0;
    while (li < LAMP_COUNT) {
        const lx : f64 = x0 + node_x(QN_LAMPS, pw) + lamp_x(li, pw);
        const ly : f64 = y0 + node_y(QN_LAMPS, pw, ph) + lamp_y(li, pw);
        const lw : f64 = lamp_w(pw);
        const stt : u32 = lamp_status(tb[0..0], li + 1);
        round_rect(c, lx, ly, lw, 40.0, 4.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.22 * a);
        cg_stroke_path(c);
        tg_txt(c, kit, AGENT_LETTERS[li], lx + 5.0, ly + 13.0, 9.5, WEIGHT_BOLD, a, lx + lw - 3.0);
        if (stt == LS_NONE) {
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_stroke_path(c);
            tg_txt(c, kit, "n/m", lx + 18.0, ly + 31.0, 7.5, 0.0, 0.45 * a, lx + lw - 2.0);
        } else {
            var fa : f64 = 0.3;
            if (stt == LS_WARM) { fa = 0.55; }
            if (stt == LS_ACTIVE or stt == LS_BLOCKED) { fa = 0.95; }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, fa * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_fill_path(c);
        }
        li = li + 1;
    }
    // ---- FEED: her actions newest first, the ring merged with the lane log
    qn_node(c, kit, QN_FEED, x0, y0, pw, ph, sw, full, a);
    const fx : f64 = x0 + node_x(QN_FEED, pw);
    const fy : f64 = y0 + node_y(QN_FEED, pw, ph);
    const fw : f64 = node_w(QN_FEED, pw);
    const evn : u32 = @as(u32, @intCast(tg[TPG_Q_EVN]));
    const lanes : []const u8 = tb[TBO_LANES .. TBO_LANES + @as(usize, tg[TPG_Q_LANELEN])];
    var rb : u32 = 0;
    var lk : u32 = 0;
    var row : u32 = 0;
    const nrows : u32 = feed_rows(pw, ph);
    var shown : u32 = 0;
    while (row < nrows) {
        var rslot : u32 = ring_at(evn, rb);
        while (rslot != RING_NONE and feed_kind_of_control(ev_control(tg[TPG_Q_RING + rslot])) == FK_NONE) {
            rb = rb + 1;
            rslot = ring_at(evn, rb);
        }
        var rev : u64 = 0;
        if (rslot != RING_NONE) { rev = tg[TPG_Q_RING + rslot]; }
        const ls : u32 = lane_line_start(lanes, lk);
        var lsec : u64 = 0;
        var lleft : u32 = 0;
        if (ls != qb_nm()) { lsec = lane_sec(lanes, ls); lleft = 1; }
        var rleft : u32 = 0;
        if (rslot != RING_NONE) { rleft = 1; }
        const pick : u32 = merge_pick(rleft, ev_sec(rev), lleft, lsec);
        if (pick == qb_src_none()) { row = nrows; } else {
            const ry : f64 = fy + feed_row_y(row);
            var kind : u32 = FK_NONE;
            var sec : u64 = 0;
            var tn : usize = 0;
            var from_lane : bool = false;
            if (pick == qb_src_ring()) {
                kind = feed_kind_of_control(ev_control(rev));
                sec = ev_sec(rev);
                tn = put_bytes(line[0..200], 0, ring_text_head(kind));
                const lt : u32 = feed_letter_of_event(rev);
                if (lt != 0 and (kind == FK_LANE or kind == FK_ASKED)) { tn = put_bytes(line[0..200], tn, letter_char(lt)); }
                rb = rb + 1;
            } else {
                kind = lane_kind(lanes, ls);
                sec = lsec;
                from_lane = true;
                const ts : usize = @as(usize, lane_text_start(lanes, ls));
                const tl : usize = @as(usize, lane_text_len(lanes, ls));
                if (profile_ok(lanes[ts .. ts + tl])) {
                    const shown_n : usize = @as(usize, feed_text_len(@as(u32, @intCast(tl))));
                    tn = put_bytes(line[0..200], 0, lanes[ts .. ts + shown_n]);
                } else {
                    tn = put_bytes(line[0..200], 0, KEY_PLACEHOLDER);
                }
                lk = lk + 1;
            }
            tg_txt(c, kit, line[0..tn], fx + 10.0, ry + 13.0, 9.0, WEIGHT_SEMIBOLD, a, fx + fw - 10.0);
            var kn : usize = csv_field(FEED_WORDS, kind, wb[0..64]);
            kn = put_bytes(wb[0..64], kn, "  ");
            if (from_lane) { kn = put_bytes(wb[0..64], kn, "lane log"); } else { kn = put_bytes(wb[0..64], kn, "ring"); }
            tg_txt(c, kit, wb[0..kn], fx + 10.0, ry + 26.0, 8.0, 0.0, 0.5 * a, fx + fw - 70.0);
            var an : [32]u8 = undefined;
            const al : usize = csv_field(AGE_WORDS, age_word(now, sec), an[0..32]);
            const aw : f64 = bytes_w(kit, an[0..al], al, 8.0, 0.0, true);
            tg_txt(c, kit, an[0..al], fx + fw - 10.0 - aw, ry + 26.0, 8.0, 0.0, 0.6 * a, 0.0);
            shown = shown + 1;
            row = row + 1;
        }
    }
    if (shown == 0) {
        tg_txt(c, kit, "nothing yet: GOD MODE has not picked a gap, no lane has started", fx + 10.0, fy + 40.0, 8.5, 0.0, 0.5 * a, fx + fw - 10.0);
    }
    // ---- GAPS: the top ten in evolve order, each with why it is not started now
    qn_node(c, kit, QN_GAPS, x0, y0, pw, ph, sw, full, a);
    const gx : f64 = x0 + node_x(QN_GAPS, pw);
    const gy : f64 = y0 + node_y(QN_GAPS, pw, ph);
    const gw : f64 = node_w(QN_GAPS, pw);
    const started : u32 = qn_started_hour(tg, now);
    const evfl : u32 = @as(u32, @intCast(tg[TPG_Q_EVFL]));
    var gi : u32 = 0;
    var gshown : u32 = 0;
    while (gi < GAP_ROWS) {
        const gry : f64 = gy + gap_row_y(gi, pw, ph);
        if (gry + gap_row_h(pw, ph) > gy + node_h(QN_GAPS, pw, ph)) {
            // the column holds fewer than ten rows at this height (GAP_ROW_MIN); the rest are cut, not drawn over the next widget
            gi = GAP_ROWS;
        } else if (row_exists(panel, gi)) {
            gshown = gshown + 1;
            const g : u32 = nth_gap(panel, gi);
            const kind2 : u32 = gap_kind_of(g);
            var pcn : usize = csv_field(CLASS_WORDS, class_of_kind(kind2), line[0..200]);
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, letter_char(gap_letter_of(g)));
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, kind_phrase(kind2));
            tg_txt(c, kit, line[0..pcn], gx + 10.0, gry + 12.0, 8.5, WEIGHT_SEMIBOLD, a, gx + gw - 10.0);
            const why : u32 = row_why(panel, gi, evfl, god, true, 0, started, 0, 0);
            var wn : usize = put_bytes(wb[0..64], 0, "now: ");
            wn = wn + csv_field(WN_WORDS, why, wb[wn .. 64]);
            tg_txt(c, kit, wb[0..wn], gx + 10.0, gry + gap_row_h(pw, ph) - 5.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
        }
        if (gi < GAP_ROWS) { gi = gi + 1; }
    }
    var gtn : usize = put_bytes(line[0..200], 0, "top ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gshown));
    gtn = put_bytes(line[0..200], gtn, " of ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gap_total(panel)));
    gtn = put_bytes(line[0..200], gtn, " gaps, evolve order");
    tg_txt(c, kit, line[0..gtn], gx + 50.0, gy + 14.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
    // ---- METER: before -> after since the start of the local day, each with its direction
    qn_node(c, kit, QN_METER, x0, y0, pw, ph, sw, full, a);
    const mx0 : f64 = x0 + node_x(QN_METER, pw);
    const my0 : f64 = y0 + node_y(QN_METER, pw, ph);
    var mi : u32 = 0;
    while (mi < M_COUNT) {
        const cxm : f64 = mx0 + meter_cell_x(mi, pw);
        const cym : f64 = my0 + meter_cell_y(mi);
        const cwm : f64 = meter_cell_w(pw);
        const before : u32 = @as(u32, @intCast(tg[TPG_Q_BEFORE + mi]));
        const after : u32 = qn_after(tg, mi);
        const lb : usize = csv_field(M_LABELS, mi, line[0..200]);
        tg_txt(c, kit, line[0..lb], cxm + 4.0, cym + 10.0, 7.5, 0.0, 0.55 * a, cxm + cwm - 2.0);
        var vn : usize = 0;
        if (qb_measured(after)) { vn = put_dec(line[0..200], 0, @as(u64, after)); } else { vn = put_bytes(line[0..200], 0, "not measured"); }
        var vsize : f64 = 14.0;
        if (qb_measured(after) == false) { vsize = 9.0; }
        tg_txt(c, kit, line[0..vn], cxm + 4.0, cym + 28.0, vsize, WEIGHT_HEAVY, a, cxm + cwm - 2.0);
        const ds : u32 = delta_state(mi, before, after);
        var dn : usize = 0;
        if (ds == D_UNKNOWN) {
            dn = put_bytes(line[0..200], 0, "no baseline");
        } else {
            dn = put_bytes(line[0..200], 0, delta_sign(before, after));
            dn = put_dec(line[0..200], dn, @as(u64, delta_abs(before, after)));
            dn = put_bytes(line[0..200], dn, " ");
            dn = dn + csv_field(M_UNITS, mi, line[dn .. 200]);
            if (ds == D_BETTER) { dn = put_bytes(line[0..200], dn, "  better"); }
            if (ds == D_WORSE) { dn = put_bytes(line[0..200], dn, "  worse"); }
        }
        var da : f64 = 0.55;
        if (ds == D_BETTER) { da = 0.95; }
        tg_txt(c, kit, line[0..dn], cxm + 4.0, cym + 40.0, 7.5, 0.0, da * a, cxm + cwm - 2.0);
        mi = mi + 1;
    }
    var bc : u32 = 0;
    var bm : u32 = 0;
    while (bm < M_COUNT) {
        if (delta_state(bm, @as(u32, @intCast(tg[TPG_Q_BEFORE + bm])), qn_after(tg, bm)) == D_BETTER) { bc = bc + 1; }
        bm = bm + 1;
    }
    var hn2 : usize = put_dec(line[0..200], 0, @as(u64, bc));
    hn2 = put_bytes(line[0..200], hn2, " of 6 better since the start of the day");
    tg_txt(c, kit, line[0..hn2], mx0 + 90.0, my0 + 14.0, 8.0, 0.0, 0.6 * a, mx0 + node_w(QN_METER, pw) - 10.0);
    // ---- SAFETY: tasks this hour, agents against the cap, the key tier as a word, STOP
    qn_node(c, kit, QN_SAFETY, x0, y0, pw, ph, sw, full, a);
    const sx : f64 = x0 + node_x(QN_SAFETY, pw);
    const sy : f64 = y0 + node_y(QN_SAFETY, pw, ph);
    var si : u32 = 0;
    while (si < 4) {
        const cxs : f64 = sx + safety_cell_x(si, pw);
        const cys : f64 = sy + safety_cell_y(si);
        const cws : f64 = safety_cell_w(pw);
        if (si == SC_TASKS) {
            var tn2 : usize = put_dec(line[0..200], 0, @as(u64, started));
            tn2 = put_bytes(line[0..200], tn2, "/");
            tn2 = put_dec(line[0..200], tn2, @as(u64, budget_cap()));
            tg_txt(c, kit, "tasks this hour", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..tn2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, (cws - 8.0) * bar_fill(started, budget_cap()), 3.0);
        }
        if (si == SC_AGENTS) {
            var an2 : usize = put_dec(line[0..200], 0, 0);
            an2 = put_bytes(line[0..200], an2, "/");
            an2 = put_dec(line[0..200], an2, @as(u64, agents_cap()));
            tg_txt(c, kit, "agents running", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..an2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
        }
        if (si == SC_TIER) {
            const tier : u32 = @as(u32, @intCast(tg[TPG_Q_TIER]));
            const tw2 : usize = csv_field(KT_WORDS, tier, wb[0..64]);
            tg_txt(c, kit, "key tier", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            var tal : f64 = 0.9;
            if (tier_is_warning(tier)) {
                round_rect(c, cxs + 2.0, cys + 15.0, cws - 4.0, 18.0, 3.0);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
                cg_fill_path(c);
                cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
                draw_fit(c, kit, wb[0..tw2], tw2, cxs + 6.0, cys + 28.0, 9.0, WEIGHT_BOLD, true, cxs + cws - 4.0);
            } else {
                tg_txt(c, kit, wb[0..tw2], cxs + 4.0, cys + 28.0, 9.5, WEIGHT_SEMIBOLD, tal * a, cxs + cws - 2.0);
            }
        }
        if (si == SC_STOP) {
            const hot : bool = on_stop(mx - sx, my - sy, pw);
            tg_button(c, kit, cxs + 4.0, cys + 4.0, cws - 8.0, 22.0, "STOP", hot, god, a);
            tg_txt(c, kit, stop_effect(god), cxs + 4.0, cys + 36.0, 7.0, 0.0, 0.5 * a, cxs + cws - 2.0);
        }
        si = si + 1;
    }
}

// ---- H: the HIVE (devices) page and its host jobs (decisions: specs/t27os/devices.t27) ----

fn hive_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const n : usize = tg_read(hb, DV_DIR, DV_FILE, tb[TBO_HIVE .. TBO_HIVE + TBO_HIVE_N]);
    tg[TPG_H_LEN] = @as(u64, tg_whole_lines(tb, TBO_HIVE, n));
}

/// The feed job (refs on origin, trigit, this machine's probes) once a minute while the page is open, and the reap of both
/// jobs. The publisher is started by hive_publish.
fn hive_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_H_LOADED] == 0) {
        hive_load(tg, tb, hb);
        tg[TPG_H_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_H_PUB_PID] != 0) {
        if (tg_done(tg[TPG_H_PUB_PID]) == 0) { tg_late(now, tg[TPG_H_PUB_START], tg[TPG_H_PUB_PID]); } else { tg[TPG_H_PUB_PID] = 0; }
    }
    if (tg[TPG_H_PID] != 0) {
        if (tg_done(tg[TPG_H_PID]) == 0) {
            tg_late(now, tg[TPG_H_START], tg[TPG_H_PID]);
        } else {
            tg[TPG_H_PID] = 0;
            hive_load(tg, tb, hb);
            tg[TPG_H_AT] = now;
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_HIVE, open, now, tg[TPG_H_LAST])) {
        tg[TPG_H_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            const w : usize = dv_feed_cmd(hb, tb[TBO_ROOT .. TBO_ROOT + rn], tb[TBO_CMD + 6 .. TBO_ROOT]);
            const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
            if (pid != 0) {
                tg[TPG_H_PID] = pid;
                tg[TPG_H_START] = now;
            }
        }
    }
}

/// This machine's lanes field from the lanes table the sidebar draws (RUNNING script lanes), kept for the card and the beat.
fn hive_lanes(tg: []u64, tb: []u8, sst: []const u32) -> void {
    tg[TPG_H_LANES_LEN] = @as(u64, dv_lanes_text(sst[SST_LV .. SST_SIZE], sst[SST_LVN], tb[TBO_HLANES .. TBO_HLANES + TBO_HLANES_N]));
}

/// Publish this machine's heartbeat: the command is devices.t27's, run as a background job like the feeds.
fn hive_publish(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
    if (tg[TPG_H_PUB_PID] != 0 or rn == 0 or root_safe(tb[TBO_ROOT .. TBO_ROOT + rn]) == false) { return; }
    const ln : usize = @as(usize, tg[TPG_H_LANES_LEN]);
    const w : usize = dv_publish_cmd(hb, tb[TBO_ROOT .. TBO_ROOT + rn], tb[TBO_HLANES .. TBO_HLANES + ln], tb[TBO_CMD + 6 .. TBO_ROOT]);
    if (w == 0) { return; }
    const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
    if (pid != 0) {
        tg[TPG_H_PUB_PID] = pid;
        tg[TPG_H_PUB_START] = now;
    }
}

/// The pinned agents of widget w as chips at (x, y), owner first and bold (the kanban card's chips).
fn hv_chips(c: u64, kit: [48]u64, w: u32, x: f64, y: f64, a: f64) -> void {
    var k : u32 = 0;
    while (k < dw_agents(w)) {
        const l : u32 = dw_agent(w, k);
        const chx : f64 = x + @as(f64, @floatFromInt(k)) * 19.0;
        round_rect(c, chx, y, 17.0, 13.0, 3.0);
        cg_line_width(c, 1.0);
        var ka : f64 = 0.3;
        if (k == 0) { ka = 0.7; }
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
        cg_stroke_path(c);
        var wgt : f64 = 0.0;
        if (k == 0) { wgt = WEIGHT_BOLD; }
        if (l >= 1 and l <= 27) { tg_txt(c, kit, AGENT_LETTERS[l - 1], chx + 4.0, y + 10.0, 8.5, wgt, a, 0.0); }
        k = k + 1;
    }
}

/// A chip group with its tiny label ("ID", "RES", "LANES"), the widths of dw_agents; returns the x after it.
fn hv_group(c: u64, kit: [48]u64, label: []const u8, w: u32, x: f64, y: f64, a: f64) -> f64 {
    const lw : f64 = tg_txt(c, kit, label, x, y + 10.0, 6.5, 0.0, 0.5 * a, 0.0);
    hv_chips(c, kit, w, x + lw + 4.0, y, a);
    return x + lw + 4.0 + @as(f64, @floatFromInt(dw_agents(w))) * 19.0 + 8.0;
}

fn hv_dot(c: u64, x: f64, y: f64, lit: bool, a: f64) -> void {
    if (lit) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_arc(c, x, y, 3.5, 0.0, 6.283185307, 0);
        cg_fill_path(c);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_arc(c, x, y, 3.5, 0.0, 6.283185307, 0);
        cg_stroke_path(c);
    }
}

fn draw_hive_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const f : []const u8 = tb[TBO_HIVE .. TBO_HIVE + @as(usize, tg[TPG_H_LEN])];
    var tab : [24]u32 = undefined;
    const nh : u32 = dv_hosts(f, tab[0..24]);
    var line : [160]u8 = undefined;
    const latest : u32 = dv_latest_build(f);
    // ---- TRI NET header: the title, where the data comes from, how many machines are alive
    plate(c, x0 + DV_PAD, y0 + 2.0, pw - 2.0 * DV_PAD, DV_HEAD_H - 4.0, sw, a);
    tg_txt(c, kit, "TRI NET", x0 + DV_PAD + 10.0, y0 + 16.0, 10.5, WEIGHT_BOLD, a, 0.0);
    var online : u32 = 0;
    var hi : u32 = 0;
    while (hi < nh) {
        if (dv_host_state(now, tab[0..24], hi) == DS_ONLINE) { online = online + 1; }
        hi = hi + 1;
    }
    var hn : usize = dv_put_dec_hv(line[0..160], 0, nh);
    hn = put_bytes(line[0..160], hn, " machines, ");
    hn = put_dec(line[0..160], hn, @as(u64, online));
    hn = put_bytes(line[0..160], hn, " online   ");
    const sl : usize = dv_nth(f, 83, 0);
    if (sl == DV_NONE) {
        hn = put_bytes(line[0..160], hn, "feed n/m (first read in progress)");
    } else {
        const sle : usize = dv_line_end(f, sl);
        const sep : u32 = dv_num(f, dv_fstart(f, sl, sle, 1), sle);
        hn = put_bytes(line[0..160], hn, "feed ");
        hn = hn + dv_age_text(now, @as(u64, sep), line[hn .. 160]);
    }
    tg_txt(c, kit, line[0..hn], x0 + DV_PAD + 70.0, y0 + 15.0, 8.0, 0.0, 0.6 * a, x0 + pw - DV_PAD - 80.0);
    hv_chips(c, kit, DW_HEAD, x0 + pw - DV_PAD - 8.0 - 3.0 * 19.0, y0 + 5.0, a);
    // ---- the flow strip: claimed -> lane pushed -> trigit landed -> batch pushed -> merged
    var si : u32 = 0;
    while (si < FS_COUNT) {
        const fx : f64 = x0 + dv_flow_x(si, pw);
        const fy : f64 = y0 + dv_flow_y();
        const fw : f64 = dv_flow_w(pw);
        const v : u32 = dv_stage_value(f, si);
        plate(c, fx, fy, fw, DV_FLOW_H, sw, a);
        tg_txt(c, kit, FS_NAMES[si], fx + 8.0, fy + 13.0, 7.5, WEIGHT_SEMIBOLD, 0.7 * a, fx + fw - 22.0);
        hv_dot(c, fx + fw - 12.0, fy + 10.0, dv_stage_lit(v), a);
        var vn : usize = 0;
        var vsz : f64 = 20.0;
        if (v == DV_NM) { vn = put_bytes(line[0..160], 0, "n/m"); vsz = 12.0; } else { vn = put_dec(line[0..160], 0, @as(u64, v)); }
        tg_txt(c, kit, line[0..vn], fx + 8.0, fy + 38.0, vsz, WEIGHT_HEAVY, a, fx + fw - 8.0);
        const sn : usize = dv_stage_sub(f, si, line[0..160]);
        tg_txt(c, kit, line[0..sn], fx + 8.0, fy + 52.0, 6.5, 0.0, 0.55 * a, fx + fw - 8.0);
        hv_chips(c, kit, DW_CLAIMED + si, fx + fw - 8.0 - 3.0 * 19.0, fy + 20.0, a);
        if (si + 1 < FS_COUNT) {
            const ax : f64 = fx + fw + 4.0;
            const ay : f64 = fy + 0.5 * DV_FLOW_H;
            cg_line_width(c, 1.2);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.55 * a);
            cg_move(c, ax, ay - 5.0);
            cg_line(c, ax + 7.0, ay);
            cg_line(c, ax, ay + 5.0);
            cg_stroke_path(c);
        }
        si = si + 1;
    }
    // ---- one card per machine
    const fit : u32 = dv_cards_fit(nh, pw, ph);
    const lt : usize = @as(usize, tg[TPG_H_LANES_LEN]);
    var ci : u32 = 0;
    while (ci < fit) {
        const cx : f64 = x0 + dv_card_x(ci, pw);
        const cy : f64 = y0 + dv_card_y(ci, nh, pw, ph);
        const cw : f64 = dv_card_w(pw);
        const chh : f64 = dv_card_h(nh, pw, ph);
        const r : usize = @as(usize, ci) * DH_F;
        const st : u32 = dv_host_state(now, tab[0..24], ci);
        var ka : f64 = a;
        if (st != DS_ONLINE) { ka = 0.6 * a; }
        plate(c, cx, cy, cw, chh, sw, a);
        const ns : usize = @as(usize, tab[r + DH_NS]);
        const ne : usize = @as(usize, tab[r + DH_NE]);
        hv_dot(c, cx + 14.0, cy + 14.0, st == DS_ONLINE, ka);
        tg_txt(c, kit, f[ns .. ne], cx + 26.0, cy + 18.0, 11.0, WEIGHT_BOLD, ka, cx + cw - 110.0);
        const sw2 : usize = put_bytes(line[0..160], 0, DS_WORDS[st]);
        const sww : f64 = bytes_w(kit, line[0..sw2], sw2, 8.0, WEIGHT_BOLD, true);
        tg_txt(c, kit, line[0..sw2], cx + cw - 10.0 - sww, cy + 17.0, 8.0, WEIGHT_BOLD, ka, 0.0);
        var an : usize = put_bytes(line[0..160], 0, "heartbeat ");
        an = an + dv_age_text(now, @as(u64, tab[r + DH_SEEN]), line[an .. 160]);
        if (tab[r + DH_LOCAL] == 1) { an = put_bytes(line[0..160], an, "   (this machine)"); }
        tg_txt(c, kit, line[0..an], cx + 10.0, cy + 30.0, 7.5, 0.0, 0.55 * ka, cx + cw - 10.0);
        const idn : usize = dv_ident_text(f, tab[0..24], ci, latest, line[0..160]);
        tg_txt(c, kit, line[0..idn], cx + 10.0, cy + 44.0, 8.5, WEIGHT_SEMIBOLD, ka, cx + cw - 10.0);
        const tn : usize = dv_tools_text(f, tab[0..24], ci, line[0..160]);
        tg_txt(c, kit, line[0..tn], cx + 10.0, cy + 56.0, 8.0, 0.0, 0.7 * ka, cx + cw - 10.0);
        // the three meters
        var mi : u32 = 0;
        while (mi < RES_COUNT) {
            const mxp : f64 = cx + 10.0 + @as(f64, @floatFromInt(mi)) * (dv_meter_w(cw) + DV_GAP);
            const val : u32 = dv_host_num(f, tab[0..24], ci, RES_KEYS[mi]);
            tg_txt(c, kit, RES_LABELS[mi], mxp, cy + 68.0, 7.0, 0.0, 0.55 * ka, mxp + dv_meter_w(cw));
            const mn : usize = dv_res_text(val, mi, line[0..160]);
            tg_txt(c, kit, line[0..mn], mxp, cy + 81.0, 11.0, WEIGHT_HEAVY, ka, mxp + dv_meter_w(cw));
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * ka);
            cg_fill_rect(c, mxp, cy + 85.0, dv_meter_w(cw), 2.5);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * ka);
            cg_fill_rect(c, mxp, cy + 85.0, dv_meter_w(cw) * @as(f64, @floatFromInt(dv_res_fill(val, mi))) / 1000.0, 2.5);
            mi = mi + 1;
        }
        // the lanes running on this machine: its own rows for this machine, the heartbeat's field for the others
        var ls0 : usize = 0;
        var le0 : usize = 0;
        var lsrc : u32 = 0;
        if (tab[r + DH_LOCAL] == 1) {
            lsrc = 1;
        } else {
            const rs : usize = dv_remote_lanes_at(f, tab[0..24], ci);
            if (rs != DV_NONE) { ls0 = rs; le0 = dv_remote_lanes_end(f, tab[0..24], ci, rs); lsrc = 2; }
        }
        var lanes : []const u8 = f[0..0];
        if (lsrc == 1) { lanes = tb[TBO_HLANES .. TBO_HLANES + lt]; }
        if (lsrc == 2) { lanes = f[ls0 .. le0]; }
        const ln : u32 = dv_lane_n(lanes);
        const rows : u32 = dv_lane_rows(chh);
        if (lsrc == 0) {
            tg_txt(c, kit, "lanes n/m (no heartbeat)", cx + 10.0, cy + DV_LANE_Y + 9.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
        } else if (ln == 0) {
            tg_txt(c, kit, "no lane running", cx + 10.0, cy + DV_LANE_Y + 9.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
        } else {
            var lr : u32 = 0;
            while (lr < ln and lr < rows) {
                const ly : f64 = cy + DV_LANE_Y + @as(f64, @floatFromInt(lr)) * DV_LANE_H;
                if (lr + 1 == rows and ln > rows) {
                    var mn2 : usize = put_bytes(line[0..160], 0, "+");
                    mn2 = put_dec(line[0..160], mn2, @as(u64, ln - lr));
                    mn2 = put_bytes(line[0..160], mn2, " more");
                    tg_txt(c, kit, line[0..mn2], cx + 24.0, ly + 9.0, 8.0, 0.0, 0.6 * ka, cx + cw - 10.0);
                } else {
                    const lg : u32 = dv_lane_field(lanes, lr, 2);
                    if (lg != DV_NM) { draw_light_dot(c, cx + 14.0, ly + 5.5, lg, ka); }
                    const lnn : usize = dv_lane_text(lanes, lr, line[0..160]);
                    tg_txt(c, kit, line[0..lnn], cx + 24.0, ly + 9.0, 8.5, WEIGHT_SEMIBOLD, ka, cx + cw - 10.0);
                }
                lr = lr + 1;
            }
        }
        // the pinned agents of the card's three widgets
        var gx : f64 = cx + 10.0;
        gx = hv_group(c, kit, "ID", DW_MACHINE, gx, cy + chh - DV_CHIP_STRIP, ka);
        gx = hv_group(c, kit, "RES", DW_RESOURCES, gx, cy + chh - DV_CHIP_STRIP, ka);
        hv_group(c, kit, "LANES", DW_LANES, gx, cy + chh - DV_CHIP_STRIP, ka);
        ci = ci + 1;
    }
    if (nh == 0) {
        tg_txt(c, kit, "no machine yet: the first feed read has not finished (n/m)", x0 + DV_PAD + 10.0, y0 + dv_flow_y() + DV_FLOW_H + 40.0, 9.0, 0.0, 0.6 * a, x0 + pw - DV_PAD);
    }
}

fn dv_put_dec_hv(out: []u8, at: usize, v: u32) -> usize { return put_dec(out, at, @as(u64, v)); }

// ---- O: the formula orbit around the home logo (placement and hit: formula_orbit.t27; decisions: orbit_view.t27) ----

/// The stage the orbit lives on: the window below the title bar. Its centre is the logo's.
fn orb_stage_h(sh: f64) -> f64 { return sh - AREA_TOP; }

/// One frame of the orbit: re-layout when the stage or the logo changed, advance the clock (slower near the pointer; still for
/// reduced motion). The slots are ellipses around the logo (orbit_view.t27); the turn is clockwise on screen.
fn orbit_tick(tg: []u64, z: f64, sw: f64, sh: f64, mx: f64, my: f64, a_now: f64, rm: bool) -> void {
    const lh : f64 = home_px(z, sw, sh);
    const lw : f64 = lh * (logo_edge(0, true) - logo_edge(0, false)) / (logo_edge(1, true) - logo_edge(1, false));
    const r : i64 = ov_logo_r(@as(i64, @intFromFloat(lw)), @as(i64, @intFromFloat(lh)));
    const stw : i64 = @as(i64, @intFromFloat(sw));
    const sth : i64 = @as(i64, @intFromFloat(orb_stage_h(sh)));
    const key : u64 = ov_key(stw, sth, r);
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    var i : usize = 0;
    while (i < 32) { ra[i] = 0; rb[i] = 0; rp[i] = 0; i = i + 1; }
    if (tg[TPG_O_KEY] != key) {
        const n : usize = ov_layout(stw / 2, sth / 2, stw, sth, r, OV_MAX, ra[0..32], rb[0..32], rp[0..32]);
        i = 0;
        while (i < n) {
            tg[TPG_O_HX + @as(u32, @intCast(i))] = @as(u64, @intCast(ra[i]));
            tg[TPG_O_HY + @as(u32, @intCast(i))] = @as(u64, @intCast(rb[i]));
            tg[TPG_O_HP + @as(u32, @intCast(i))] = @as(u64, @intCast(rp[i]));
            i = i + 1;
        }
        tg[TPG_O_N] = @as(u64, n);
        tg[TPG_O_KEY] = key;
        tg[TPG_O_SEL] = 0;
    }
    const n2 : usize = @as(usize, tg[TPG_O_N]);
    i = 0;
    while (i < n2) {
        ra[i] = @as(i64, @intCast(tg[TPG_O_HX + @as(u32, @intCast(i))]));
        rb[i] = @as(i64, @intCast(tg[TPG_O_HY + @as(u32, @intCast(i))]));
        rp[i] = @as(i64, @intCast(tg[TPG_O_HP + @as(u32, @intCast(i))]));
        i = i + 1;
    }
    const now_ms : i64 = @as(i64, @intFromFloat(a_now * 1000.0));
    var dt : i64 = 0;
    if (tg[TPG_O_LAST] != 0) { dt = now_ms - @as(i64, @intCast(tg[TPG_O_LAST])); }
    tg[TPG_O_LAST] = @as(u64, @intCast(now_ms));
    const clock : i64 = @as(i64, @intCast(tg[TPG_O_CLOCK]));
    const px : i64 = @as(i64, @intFromFloat(mx));
    const py : i64 = @as(i64, @intFromFloat(my - AREA_TOP));
    const gap : i64 = ov_nearest_gap(stw / 2, sth / 2, ra[0..32], rb[0..32], rp[0..32], n2, ov_theta(clock, rm), px, py);
    tg[TPG_O_CLOCK] = @as(u64, @intCast(ov_clock_step(clock, dt, time_scale_permille(gap), rm)));
    tg[TPG_O_RM] = 0;
    if (rm) { tg[TPG_O_RM] = 1; }
}

fn orbit_load(tg: []const u64, ra: []i64, rb: []i64, rp: []i64) -> void {
    const n : usize = @as(usize, tg[TPG_O_N]);
    var i : usize = 0;
    while (i < 32) { ra[i] = 0; rb[i] = 0; rp[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) {
        ra[i] = @as(i64, @intCast(tg[TPG_O_HX + @as(u32, @intCast(i))]));
        rb[i] = @as(i64, @intCast(tg[TPG_O_HY + @as(u32, @intCast(i))]));
        rp[i] = @as(i64, @intCast(tg[TPG_O_HP + @as(u32, @intCast(i))]));
        i = i + 1;
    }
}

/// The formula under the pointer (index), or -1. The stage is sw wide and sh - AREA_TOP tall; the logo is its centre.
fn orbit_pick(tg: []const u64, mx: f64, my: f64, sw: f64, sh: f64) -> i64 {
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    orbit_load(tg, ra[0..32], rb[0..32], rp[0..32]);
    const theta : i64 = ov_theta(@as(i64, @intCast(tg[TPG_O_CLOCK])), tg[TPG_O_RM] != 0);
    return ov_hit(@as(i64, @intFromFloat(sw)) / 2, @as(i64, @intFromFloat(orb_stage_h(sh))) / 2, ra[0..32], rb[0..32], rp[0..32], @as(usize, tg[TPG_O_N]), theta, @as(i64, @intFromFloat(mx)), @as(i64, @intFromFloat(my - AREA_TOP)));
}

/// The orbit: only the formulas, white text, no frame, each turning clockwise on its ellipse; the hovered one is brighter
/// and underlined. A click opens the card with the name, value, error and sector.
fn orbit_draw(c: u64, kit: [48]u64, tg: []const u64, mx: f64, my: f64, sw: f64, sh: f64, full: bool, a: f64) -> void {
    const n : usize = @as(usize, tg[TPG_O_N]);
    if (n == 0) { return; }
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    orbit_load(tg, ra[0..32], rb[0..32], rp[0..32]);
    const theta : i64 = ov_theta(@as(i64, @intCast(tg[TPG_O_CLOCK])), tg[TPG_O_RM] != 0);
    const ccx : i64 = @as(i64, @intFromFloat(sw)) / 2;
    const ccy : i64 = @as(i64, @intFromFloat(orb_stage_h(sh))) / 2;
    const hot : i64 = orbit_pick(tg, mx, my, sw, sh);
    var line : [64]u8 = undefined;
    var i : usize = 0;
    while (i < n) {
        const x : f64 = @as(f64, @floatFromInt(ov_pos_x(ccx, ra[i], rp[i], theta)));
        const y : f64 = @as(f64, @floatFromInt(ov_pos_y(ccy, rb[i], rp[i], theta))) + AREA_TOP;
        const ln : usize = ov_label(@as(u32, @intCast(i)), line[0..64]);
        const tw : f64 = bytes_w(kit, line[0..ln], ln, 11.0, WEIGHT_SEMIBOLD, true);
        var al : f64 = 0.9;
        if (hot == @as(i64, @intCast(i))) { al = 1.0; }
        tg_txt(c, kit, line[0..ln], x - 0.5 * tw, y + 4.0, 11.0, WEIGHT_SEMIBOLD, al * a, 0.0);
        if (hot == @as(i64, @intCast(i))) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
            cg_fill_rect(c, x - 0.5 * tw, y + 7.0, tw, 1.0);
        }
        i = i + 1;
    }
    // the card of the formula that was clicked: centred on the stage, any click closes it
    if (tg[TPG_O_SEL] != 0) {
        const fi : u32 = @as(u32, @intCast(tg[TPG_O_SEL] - 1));
        const stw : i64 = @as(i64, @intFromFloat(sw));
        const sth : i64 = @as(i64, @intFromFloat(orb_stage_h(sh)));
        const kx : f64 = @as(f64, @floatFromInt(orb_card_x(stw)));
        const ky : f64 = @as(f64, @floatFromInt(orb_card_y(sth))) + AREA_TOP;
        const kw : f64 = @as(f64, @floatFromInt(orb_card_w(stw)));
        const kh : f64 = @as(f64, @floatFromInt(orb_card_h(sth)));
        var line : [96]u8 = undefined;
        plate(c, kx, ky, kw, kh, sw, a);
        const nn : usize = ov_field(fi, OF_NAME, line[0..96]);
        tg_txt(c, kit, line[0..nn], kx + 20.0, ky + 36.0, 17.0, WEIGHT_BOLD, a, kx + kw - 20.0);
        const en : usize = ov_card_line(fi, 0, line[0..96]);
        tg_txt(c, kit, line[0..en], kx + 20.0, ky + 64.0, 11.5, 0.0, 0.9 * a, kx + kw - 20.0);
        const vn : usize = ov_card_line(fi, 1, line[0..96]);
        tg_txt(c, kit, line[0..vn], kx + 20.0, ky + 104.0, 22.0, WEIGHT_HEAVY, a, kx + kw - 20.0);
        const sn : usize = ov_card_line(fi, 2, line[0..96]);
        tg_txt(c, kit, line[0..sn], kx + 20.0, ky + 134.0, 10.5, WEIGHT_SEMIBOLD, 0.8 * a, kx + kw - 20.0);
        tg_txt(c, kit, "VERIFIED against the measured value (error shown signed)", kx + 20.0, ky + 156.0, 8.5, 0.0, 0.6 * a, kx + kw - 20.0);
        var k : u32 = 0;
        while (k < 3) {
            const chx : f64 = kx + 20.0 + @as(f64, @floatFromInt(k)) * 19.0;
            const chy : f64 = ky + kh - 30.0;
            round_rect(c, chx, chy, 17.0, 13.0, 3.0);
            cg_line_width(c, 1.0);
            var ka : f64 = 0.3;
            if (k == 0) { ka = 0.7; }
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
            cg_stroke_path(c);
            var wgt : f64 = 0.0;
            if (k == 0) { wgt = WEIGHT_BOLD; }
            tg_txt(c, kit, AGENT_LETTERS[OV_AGENTS[k] - 1], chx + 4.0, chy + 10.0, 8.5, wgt, a, 0.0);
            k = k + 1;
        }
        tg_txt(c, kit, "click anywhere to close", kx + kw - 150.0, ky + kh - 20.0, 8.0, 0.0, 0.5 * a, kx + kw - 10.0);
    }
}

/// The page of letter kind `kind` in the content area of a home tab (below the header, right of the sidebar).
fn draw_tool_page(c: u64, kit: [48]u64, kind: u32, tg: []const u64, tb: []const u8, cx: f64, sw: f64, sh: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    const x0 : f64 = cx;
    const y0 : f64 = home_view_top();
    const pw : f64 = sw - cx;
    const ph : f64 = home_view_h(sh);
    const now : u64 = tg[TPG_NOW];
    if (kind == PAGE_BENCH) { draw_bench_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_KANBAN) { draw_kanban_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_QUEEN) { draw_queen_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_HIVE) { draw_hive_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
}

// ---- the key-light dot (owner directive gHashTag/t27#11314) ----
// A traffic-light dot on each agent pane header and one in the sidebar foot next to KEYS: the worst light of the
// running agent panes (red > yellow > green). The rule (keys.t27 light_of / worst_light, the listing field `light`)
// lives in the keys lane; this file only draws a light value it is given. Until that lane is merged the adapters
// below answer LIGHT_NONE, which draws no dot. The dot is the one colour signal allowed here, small, on glass.
pub const LIGHT_NONE : u32 = 0;
pub const LIGHT_GREEN : u32 = 1;
pub const LIGHT_YELLOW : u32 = 2;
pub const LIGHT_RED : u32 = 3;
pub const LIGHT_DOT_R : f64 = 3.5;

/// Adapter: the light of server pane `pane` (keys lane: the `light` field of the listing). Wire at merge.
pub fn pane_light_input(pane: u32) -> u32 { return LIGHT_NONE; }

/// Adapter: the worst light over the running agent panes (keys lane: worst_light). Wire at merge.
pub fn foot_light_input() -> u32 { return LIGHT_NONE; }

/// Red outranks yellow outranks green; none is the weakest.
pub fn light_worse(a: u32, b: u32) -> u32 {
    if (a > LIGHT_RED) { return b; }
    if (b > LIGHT_RED) { return a; }
    if (a >= b) { return a; }
    return b;
}

/// An editor pane has no dot; any other pane shows its light.
pub fn dot_light(is_editor: bool, light: u32) -> u32 {
    if (is_editor or light > LIGHT_RED) { return LIGHT_NONE; }
    return light;
}

pub fn dot_visible(light: u32) -> bool { return light >= LIGHT_GREEN and light <= LIGHT_RED; }

/// Colour channel k (0 r, 1 g, 2 b) of the dot.
pub fn light_chan(light: u32, k: u32) -> f64 {
    if (light == LIGHT_GREEN) { if (k == 0) { return 0.30; } if (k == 1) { return 0.85; } return 0.40; }
    if (light == LIGHT_YELLOW) { if (k == 0) { return 0.98; } if (k == 1) { return 0.78; } return 0.20; }
    if (light == LIGHT_RED) { if (k == 0) { return 0.95; } if (k == 1) { return 0.27; } return 0.25; }
    return 0.0;
}

fn draw_light_dot(c: u64, x: f64, y: f64, light: u32, a: f64) -> void {
    if (dot_visible(light) == false) { return; }
    cg_fill_rgba(c, light_chan(light, 0), light_chan(light, 1), light_chan(light, 2), 0.95 * a);
    cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
    cg_fill_path(c);
}

// ---- the QUEEN CONTROL DASHBOARD (queen_dash.t27): the page the sidebar's Queen row opens ----
// Layout, hit codes, texts and parsing are queen_dash.t27; this block reads the files, spawns the feed job and draws.
pub const TPG_QD_PLANN : u32 = 244;
pub const TPG_QD_TRIGN : u32 = 245;
pub const TPG_QD_BOARDN : u32 = 246; // reserve: the RAILWAY QUEEN BOARD tile left, the slot number is kept so the mirrors of the saved state keep their numbering
pub const TPG_QD_HIVEN : u32 = 247;
pub const TPG_QD_PID : u32 = 248;
pub const TPG_QD_LAST : u32 = 249;
pub const TPG_QD_FLAGS : u32 = 250;
pub const SST_QDASH : usize = 559;
pub const TBO_QD : usize = 71936;
pub const TBO_QD_PLAN : usize = 71936;
pub const TBO_QD_TRIG : usize = 73472;
pub const TBO_QD_BOARD : usize = 74496; // reserve: the 256 bytes of the left board.txt tile stay, so the chain below and TBO_PF at 76800 never move
pub const TBO_QD_HIVE : usize = 74752;
pub const QD_PLAN_CAP : usize = 1536;
pub const QD_TRIG_CAP : usize = 1024;
pub const QD_BOARD_CAP : usize = 256;
pub const QD_HIVE_CAP : usize = 2048;
pub const QD_HIVE_DIR : str = "/.t27os/hive/";
pub const QD_HIVE_FILE : str = "feed.txt";
pub const QD_HEADS : [5]str = ["ISSUE", "MODEL", "HOST", "STATE", "ELAPSED"];

/// The page's rectangle: the content area of the chat screen from the top of the workspace to the footer.
pub fn qd_area_x(ws: u32, collapsed: bool) -> f64 { return content_x(ws, collapsed); }
pub fn qd_area_w(sw: f64, ws: u32, collapsed: bool, panel: bool) -> f64 { return content_w(sw, ws, collapsed, panel); }
pub fn qd_area_h(sh: f64) -> f64 { return sh - WS_TOP - SB_H; }
pub fn qd_open(sst: []const u32, screen: bool, ws: u32) -> bool { return screen and sst[SST_QDASH] != 0 and ws != WS_COMPACT; }
pub fn on_qd_area(x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> bool {
    const l : f64 = qd_area_x(ws, collapsed);
    return x >= l and x < l + qd_area_w(sw, ws, collapsed, panel) and y >= WS_TOP and y < WS_TOP + qd_area_h(sh);
}

/// The k-th row of the lanes table that is work (a pane or a script lane, not a group header); LV_NONE past the last.
fn qd_lane_index(sst: []const u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < sst[SST_LVN] and i < 64) {
        const src : u32 = sst[SST_LV + (i as usize) * LV_F + LVF_SRC];
        if ((src == LV_PANE or src == LV_SCRIPT) and sst[SST_LV + (i as usize) * LV_F + LVF_DEPTH] != LV_GROUP_DEPTH) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return LV_NONE;
}
fn qd_lane_total(sst: []const u32) -> u32 {
    var k : u32 = 0;
    while (qd_lane_index(sst, k) != LV_NONE) { k = k + 1; }
    return k;
}

/// The feed job and the reads of the files others write under ~/.t27os/queen and of the hive feed.
fn qd_read(tg: []u64, tb: []u8, hb: []const u8) -> void {
    tg[TPG_QD_PLANN] = tg_read(hb, QD_QDIR, QD_FILE_PLAN, tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP]) as u64;
    tg[TPG_QD_TRIGN] = tg_read(hb, QD_QDIR, QD_FILE_TRIGIT, tb[TBO_QD_TRIG .. TBO_QD_TRIG + QD_TRIG_CAP]) as u64;
    tg[TPG_QD_HIVEN] = tg_read(hb, QD_HIVE_DIR, QD_HIVE_FILE, tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP]) as u64;
}
fn qd_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_QD_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_QD_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_QD_LAST], tg[TPG_QD_PID]);
        } else {
            tg[TPG_QD_PID] = 0;
            qd_read(tg, tb, hb);
            tg_bump(tg);
        }
    } else if (qd_feed_due(open, now, tg[TPG_QD_LAST])) {
        tg[TPG_QD_LAST] = now;
        qd_read(tg, tb, hb);
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = put_bytes(tb, e, QD_FEED_CMD);
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) { tg[TPG_QD_PID] = pid; }
        tg_bump(tg);
    }
}

/// The two lines of tile i (written to l1, l2); the lengths packed (n1 + 65536 * n2).
fn qd_lines(i: u32, tg: []const u64, sst: []const u32, tb: []const u8, l1: []u8, l2: []u8) -> u64 {
    const fl : u64 = tg[TPG_QD_FLAGS];
    const pn : usize = tg[TPG_QD_PLANN] as usize;
    const plan : []const u8 = tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP];
    const hn : usize = tg[TPG_SB_HOSTN] as usize;
    var n1 : usize = 0;
    var n2 : usize = 0;
    if (i == QD_T_GOD) {
        var ago : u64 = 0;
        if (tg[TPG_G_LAST] > 0 and tg[TPG_NOW] >= tg[TPG_G_LAST]) { ago = tg[TPG_NOW] - tg[TPG_G_LAST]; }
        n1 = qd_god_line1(l1, tg[TPG_Q_GOD] != 0, qd_fl_paused(fl));
        n2 = qd_god_line2(l2, tg[TPG_Q_GOD] != 0, qd_fl_paused(fl), ago, tg[TPG_G_LAST] == 0);
    } else if (i == QD_T_LOCAL) {
        var cap : u32 = qd_plan_key(plan, pn, "cap=");
        var run : u32 = qd_plan_key(plan, pn, "running=");
        var slots : u32 = qd_plan_key(plan, pn, "slots=");
        const have : bool = cap != QD_NOT_READ and run != QD_NOT_READ and slots != QD_NOT_READ;
        if (have == false) {
            cap = qd_fl_lanes(fl);
            run = sst[SST_QRUN];
            slots = lanes_free(run, cap);
        }
        n1 = qd_local_line1(l1, cap, run, slots);
        n2 = qd_local_line2(l2, have, cap, run, slots);
    } else if (i == QD_T_TRIGIT) {
        const tn : usize = tg[TPG_QD_TRIGN] as usize;
        const tt : []const u8 = tb[TBO_QD_TRIG .. TBO_QD_TRIG + QD_TRIG_CAP];
        if (tn == 0) {
            n1 = qd_no_feed(l1);
        } else {
            const s0 : usize = qd_line_start(tt, tn, 0);
            const s1 : usize = qd_line_start(tt, tn, 1);
            var e0 : usize = s0;
            while (e0 < tn and tt[e0] != 10) { e0 = e0 + 1; }
            n1 = qd_put_line(l1, 0, tt, s0, e0, 44);
            var e1 : usize = s1;
            while (e1 < tn and tt[e1] != 10) { e1 = e1 + 1; }
            n2 = qd_put_line(l2, 0, tt, s1, e1, 44);
        }
    } else if (i == QD_T_KEYS) {
        n1 = qd_keys_line1(l1, qd_fl_keys(fl));
        n2 = qd_keys_line2(l2, qd_fl_light(fl));
    } else if (i == QD_T_MACHINE) {
        var hb : [24]u8 = undefined;
        if (hn > 0 and hn <= 24) { unpack8(tg, TPG_SB_HOST as usize, hn, hb[0..24]); }
        const hv : []const u8 = tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP];
        const hvn : usize = tg[TPG_QD_HIVEN] as usize;
        var cpu : u32 = QD_NOT_READ;
        var ram : u32 = QD_NOT_READ;
        var disk : u32 = QD_NOT_READ;
        if (hn > 0 and hn <= 24) {
            cpu = qd_hive_own(hv, hvn, hb[0..24], hn, "cpu=");
            ram = qd_hive_own(hv, hvn, hb[0..24], hn, "ram=");
            disk = qd_hive_own(hv, hvn, hb[0..24], hn, "disk=");
        }
        if (sst[SST_DISK] > 0) { disk = sst[SST_DISK] - 1; }
        n1 = qd_machine_line1(l1, cpu, ram);
        n2 = qd_machine_line2(l2, disk);
    } else {
        const hv2 : []const u8 = tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP];
        const hvn2 : usize = tg[TPG_QD_HIVEN] as usize;
        const tot : u32 = qd_hive_total(hv2, hvn2);
        if (hvn2 == 0 or tot == 0) {
            n1 = qd_no_feed(l1);
        } else {
            n1 = qd_machines_line1(l1, qd_hive_online(hv2, hvn2, tg[TPG_NOW]), tot);
            var k : u32 = 0;
            while (k < 2 and k < tot) {
                if (k > 0) { n2 = put_bytes(l2, n2, ", "); }
                var nm : [24]u8 = undefined;
                const nl : usize = qd_hive_name(hv2, hvn2, k, nm[0..24]);
                n2 = put_bytes(l2, n2, nm[0..nl]);
                k = k + 1;
            }
        }
    }
    return (n1 as u64) + 65536 * (n2 as u64);
}

fn qd_button(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, label: []const u8, on: bool, hot: bool, a: f64) -> void {
    round_rect(c, x, y, w, QD_BTN_H, 5.0);
    if (on) {
        cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.22 * a);
        cg_fill_path(c);
        round_rect(c, x, y, w, QD_BTN_H, 5.0);
    }
    cg_line_width(c, 1.0);
    if (on) { cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a); } else if (hot) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a); } else { cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a); }
    cg_stroke_path(c);
    const lw : f64 = bytes_w(kit, label, label.len, 7.5, WEIGHT_SEMIBOLD, false);
    if (on) { cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, a); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a); }
    draw_bytes(c, kit, label, label.len, x + 0.5 * (w - lw), y + 12.5, 7.5, WEIGHT_SEMIBOLD, false);
}

/// The dashboard: 100% widgets in matte glass, each with its pinned agents.
fn draw_qdash(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, tb: []const u8, x0: f64, y0: f64, w: f64, h: f64, sw: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    draw_ground(c, x0, y0, w, h, SURF_CONTENT, sw, a);
    const fl : u64 = tg[TPG_QD_FLAGS];
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_bytes(c, kit, "QUEEN CONTROL DASHBOARD", 23, x0 + QD_PAD, y0 + 22.0, 11.0, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_close_x(c, qd_close_x(x0, w) + 8.0, y0 + 16.0, qd_hit(mx, my, x0, y0, w, h, 0, 0) == QD_QH_CLOSE, a);
    const lt : u32 = qd_table_rows(y0, w, h);
    const lrows : u32 = qd_lane_rows_shown(lt);
    const qrows : u32 = qd_queue_rows_shown(lt);
    const hit : u32 = qd_hit(mx, my, x0, y0, w, h, lrows, qrows);
    var i : u32 = 0;
    while (i < QD_TILE_COUNT) {
        const tx : f64 = qd_tile_x(i, x0, w);
        const ty : f64 = qd_tile_y(i, y0, w);
        const tw : f64 = qd_tile_w(w);
        round_rect(c, tx, ty, tw, QD_TILE_H, 8.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.04 * a);
        cg_fill_path(c);
        round_rect(c, tx, ty, tw, QD_TILE_H, 8.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, TILE_BORDER * a);
        cg_stroke_path(c);
        var nb : [32]u8 = undefined;
        const nn : usize = qd_tile_name(i, nb[0..32]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_bytes(c, kit, nb[0..32], nn, tx + 10.0, ty + 16.0, 8.0, WEIGHT_SEMIBOLD, false);
        var pb : [40]u8 = undefined;
        var pn : usize = put_bytes(pb[0..40], 0, "AGENTS ");
        pn = pn + qd_pin_text(i, pb[pn..40]);
        const pw2 : f64 = bytes_w(kit, pb[0..40], pn, 7.0, 0.0, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_bytes(c, kit, pb[0..40], pn, tx + tw - 10.0 - pw2, ty + 16.0, 7.0, 0.0, false);
        var l1 : [64]u8 = undefined;
        var l2 : [64]u8 = undefined;
        const ln : u64 = qd_lines(i, tg, sst, tb, l1[0..64], l2[0..64]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_fit(c, kit, l1[0..64], (ln % 65536) as usize, tx + 10.0, ty + 36.0, 11.0, WEIGHT_SEMIBOLD, false, tx + tw - 10.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_fit(c, kit, l2[0..64], (ln / 65536) as usize, tx + 10.0, ty + 51.0, 9.0, 0.0, false, tx + tw - 10.0);
        if (i == QD_T_GOD) {
            var gl : [16]u8 = undefined;
            var gn : usize = put_bytes(gl[0..16], 0, "GOD MODE OFF");
            if (tg[TPG_Q_GOD] != 0) { gn = put_bytes(gl[0..16], 0, "GOD MODE ON"); }
            qd_button(c, kit, qd_god_btn_x(tx), qd_btn_y(ty), QD_GOD_BTN_W + 14.0, gl[0..16], tg[TPG_Q_GOD] != 0, hit == QD_QH_GOD, a);
        }
        if (i == QD_T_LOCAL) {
            const by : f64 = qd_btn_y(ty);
            qd_button(c, kit, qd_tick_btn_x(tx), by, QD_TICK_BTN_W, "TICK NOW", qd_fl_now(fl), hit == QD_QH_TICK, a);
            qd_button(c, kit, qd_minus_x(tx), by, QD_STEP_W, "-", false, hit == QD_QH_MINUS, a);
            qd_button(c, kit, qd_plus_x(tx), by, QD_STEP_W, "+", false, hit == QD_QH_PLUS, a);
            var nbuf : [4]u8 = undefined;
            const nl : usize = put_dec(nbuf[0..4], 0, qd_fl_lanes(fl) as u64);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_bytes(c, kit, nbuf[0..4], nl, qd_num_x(tx) + 4.0, by + 12.5, 9.0, WEIGHT_SEMIBOLD, false);
            if (qd_fl_paused(fl)) { qd_button(c, kit, qd_pause_x(tx), by, QD_PAUSE_BTN_W, "RESUME", true, hit == QD_QH_PAUSE, a); } else { qd_button(c, kit, qd_pause_x(tx), by, QD_PAUSE_BTN_W, "PAUSE", false, hit == QD_QH_PAUSE, a); }
        }
        i = i + 1;
    }
    // the lanes table
    const lty : f64 = qd_lanes_top(y0, w);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, "LANES", 5, x0 + QD_PAD, lty + 14.0, 8.0, WEIGHT_SEMIBOLD, false);
    var pl : [24]u8 = undefined;
    const pln : usize = qd_pin_text(QD_W_LANES, pl[0..24]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_bytes(c, kit, pl[0..24], pln, x0 + QD_PAD + 44.0, lty + 14.0, 7.0, 0.0, false);
    var cI : u32 = 0;
    while (cI < 5) {
        draw_bytes(c, kit, QD_HEADS[cI as usize], QD_HEADS[cI as usize].len, qd_col_x(cI, x0, w), lty + 29.0, 7.0, WEIGHT_SEMIBOLD, false);
        cI = cI + 1;
    }
    const total : u32 = qd_lane_total(sst);
    var hb2 : [24]u8 = undefined;
    const hn2 : usize = tg[TPG_SB_HOSTN] as usize;
    if (hn2 > 0 and hn2 <= 24) { unpack8(tg, TPG_SB_HOST as usize, hn2, hb2[0..24]); }
    var r : u32 = 0;
    while (r < lrows and r < total) {
        const li : u32 = qd_lane_index(sst, r);
        const ry : f64 = qd_lane_row_y(r, y0, w);
        if (hit % 16 == QD_QH_LANE and hit / 16 == r) {
            round_rect(c, x0 + QD_PAD, ry, w - 2.0 * QD_PAD, QD_ROW_H, 4.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.07 * a);
            cg_fill_path(c);
        }
        const rb : usize = SST_LV + (li as usize) * LV_F;
        var tb1 : [24]u8 = undefined;
        var n3 : usize = 0;
        if (sst[rb + LVF_ISSUE] > 0 and sst[rb + LVF_ISSUE] < 100000000) {
            n3 = put_bytes(tb1[0..24], 0, "#");
            n3 = put_dec(tb1[0..24], n3, sst[rb + LVF_ISSUE] as u64);
        } else {
            n3 = put_bytes(tb1[0..24], 0, "-");
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_bytes(c, kit, tb1[0..24], n3, qd_col_x(0, x0, w), ry + 14.0, 9.0, 0.0, true);
        const mdl : u32 = sst[rb + LVF_MODEL];
        if (mdl < 7) { draw_bytes(c, kit, LVM_NAMES[mdl as usize], LVM_NAMES[mdl as usize].len, qd_col_x(1, x0, w), ry + 14.0, 9.0, 0.0, false); }
        if (hn2 > 0 and hn2 <= 24) { draw_bytes(c, kit, hb2[0..24], hn2, qd_col_x(2, x0, w), ry + 14.0, 9.0, 0.0, false); }
        const stt : u32 = sst[rb + LVF_STATE];
        if (stt < 7) { draw_bytes(c, kit, LVS_NAMES[stt as usize], LVS_NAMES[stt as usize].len, qd_col_x(3, x0, w), ry + 14.0, 9.0, WEIGHT_SEMIBOLD, false); }
        if (sst[rb + LVF_ELAPSED] != LV_NOT_MEASURED) {
            var eb : [24]u8 = undefined;
            const en : usize = lv_elapsed_text(sst[rb + LVF_ELAPSED], eb[0..24]);
            draw_bytes(c, kit, eb[0..24], en, qd_col_x(4, x0, w), ry + 14.0, 9.0, 0.0, true);
        }
        r = r + 1;
    }
    if (total == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_bytes(c, kit, "no lanes running", 16, qd_col_x(0, x0, w), qd_lane_row_y(0, y0, w) + 14.0, 9.0, 0.0, false);
    }
    // the P0/P1 queue: the picks of `tri-queen queen --plan tick`
    const qty : f64 = qd_queue_top(y0, w, lrows);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, "P0 / P1 QUEUE", 13, x0 + QD_PAD, qty + 14.0, 8.0, WEIGHT_SEMIBOLD, false);
    var pq : [24]u8 = undefined;
    const pqn : usize = qd_pin_text(QD_W_QUEUE, pq[0..24]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_bytes(c, kit, pq[0..24], pqn, x0 + QD_PAD + 94.0, qty + 14.0, 7.0, 0.0, false);
    const plan : []const u8 = tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP];
    const pn : usize = tg[TPG_QD_PLANN] as usize;
    const picks : u32 = qd_pick_count(plan, pn);
    var q : u32 = 0;
    while (q < qrows and q < picks) {
        const ps : usize = qd_pick_start(plan, pn, q);
        const qy : f64 = qd_queue_row_y(q, y0, w, lrows);
        if (hit % 16 == QD_QH_QUEUE and hit / 16 == q) {
            round_rect(c, x0 + QD_PAD, qy, w - 2.0 * QD_PAD, QD_ROW_H, 4.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.07 * a);
            cg_fill_path(c);
        }
        var qb : [96]u8 = undefined;
        const qn : usize = qd_put_line(qb[0..96], 0, plan, ps, qd_pick_end(plan, pn, ps), 90);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_fit(c, kit, qb[0..96], qn, qd_col_x(0, x0, w), qy + 14.0, 9.0, 0.0, true, x0 + w - QD_PAD);
        q = q + 1;
    }
    if (picks == 0) {
        // why there is none: the plan's own first line (an error line says why nothing is picked)
        var wb : [96]u8 = undefined;
        var wn : usize = 0;
        if (pn == 0) {
            wn = put_bytes(wb[0..96], 0, "no plan yet");
        } else {
            var e0 : usize = 0;
            while (e0 < pn and plan[e0] != 10) { e0 = e0 + 1; }
            wn = qd_put_line(wb[0..96], 0, plan, 0, e0, 90);
            if (qd_plan_key(plan, pn, "cap=") != QD_NOT_READ and e0 >= pn) { wn = put_bytes(wb[0..96], 0, "nothing to pick"); }
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_fit(c, kit, wb[0..96], wn, qd_col_x(0, x0, w), qd_queue_row_y(0, y0, w, lrows) + 14.0, 9.0, 0.0, false, x0 + w - QD_PAD);
    }
}

// ---- the header's right cluster and the footer bar (statusbar.t27 decides; this draws and reads the host) ----
// The state the bar shows lives in tg (u64 words): the host name and the commit packed 8 bytes a word, the last disk
// read, the GOD tick job; and in sst: the Queen's numbers the lanes table counted and the free disk.
pub const TPG_SB_HOST : u32 = 232;
pub const TPG_SB_HOSTN : u32 = 235;
pub const TPG_SB_COMMIT : u32 = 236;
pub const TPG_SB_COMMITN : u32 = 237;
pub const TPG_SB_AT : u32 = 238;
pub const TPG_G_PID : u32 = 239;
pub const TPG_G_LAST : u32 = 240;
pub const TPG_G_START : u32 = 241;
pub const TPG_G_RC : u32 = 242;
pub const TPG_G_NEXT : u32 = 243;
pub const SST_QRUN : usize = 552;
pub const SST_QIDLE : usize = 553;
pub const SST_QBLK : usize = 554;
pub const SST_QREV : usize = 555;
pub const SST_QFEED : usize = 557;
/// free disk in GB plus one; 0 = not read
pub const SST_DISK : usize = 558;
pub const GOLD_R : f64 = 1.0;
pub const GOLD_G : f64 = 0.78;
pub const GOLD_B : f64 = 0.2;

/// The right edge of the header's cluster: left of the title bar's refresh control, of the profile circle (PF_RESERVE)
/// and of the CALL pill (CV_RESERVE).
pub fn hdr_right(sw: f64) -> f64 { return dock_x(sw) - DOCK_STEP - 6.0 - PF_RESERVE - CV_RESERVE; }

/// Panes the server lists as running.
fn sb_panes(sst: []const u32) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < 32) {
        if (sst[i] != S_STOPPED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The worst key light over the running rows of the lanes table (red over yellow over green).
fn sb_worst_light(sst: []const u32) -> u32 {
    var w : u32 = LIGHT_NONE;
    var i : usize = 0;
    while (i < (sst[SST_LVN] as usize) and i < 64) {
        if (sst[SST_LV + i * LV_F + LVF_STATE] == LVS_RUNNING) { w = light_worse(w, sst[SST_LV + i * LV_F + LVF_LIGHT]); }
        i = i + 1;
    }
    return w;
}

fn sb_put(kit: [48]u64, slots: []u8, lens: []u32, widths: []f64, id: u32, n: usize, extra: f64) -> u32 {
    const o : usize = (id as usize) * SB_SLOT;
    sb_upper(slots[o .. o + SB_SLOT], n);
    lens[id as usize] = n as u32;
    widths[id as usize] = bytes_w(kit, slots[o .. o + SB_SLOT], n, SB_SIZE, WEIGHT_SEMIBOLD, false) + extra;
    return 1 << id;
}

/// Writes every present item's text into slots (SB_SLOT bytes each, upper case), its length and width; the present mask.
/// An item whose feed does not exist yet is not present.
/// The footer's update item: the friend's update when the ACCOUNT panel's UPDATE part has one (update_view.upv_bar_text:
/// available / updating N% / restart to update), else the self-updater's text when it runs (statusbar.upd_text), else none.
pub fn sb_upd_text(tg: []const u64, cl: []const u8, out: []u8) -> usize {
    const n : usize = upv_bar_text(@as(u32, cl[UPV_ST]), upv_has_offer(cl), upv_get64(cl, UPV_HAVE), upv_get64(cl, UPV_TOTAL), out);
    if (n > 0) { return n; }
    if (tg[TPG_U_ON] == 0) { return 0; }
    return upd_text(out, tg[TPG_U_ST] as u8, tg[TPG_U_WHY] as u8, PCT_UNKNOWN);
}

fn sb_build(kit: [48]u64, tg: []const u64, sst: []const u32, cl: []const u8, slots: []u8, lens: []u32, widths: []f64) -> u32 {
    var present : u32 = 0;
    const hn : usize = tg[TPG_SB_HOSTN] as usize;
    if (hn > 0 and hn <= 24) {
        var hb : [24]u8 = undefined;
        unpack8(tg, TPG_SB_HOST as usize, hn, hb[0..24]);
        const n : usize = host_text(slots[(IT_HOST as usize) * SB_SLOT .. (IT_HOST as usize) * SB_SLOT + SB_SLOT], hb[0..24], hn, tg[TPG_U_WHY] != (WHY_OFFLINE as u64));
        present = present + sb_put(kit, slots, lens, widths, IT_HOST, n, 0.0);
    }
    var cb : [8]u8 = undefined;
    const cn : usize = tg[TPG_SB_COMMITN] as usize;
    if (cn > 0 and cn <= 8) { unpack8(tg, TPG_SB_COMMIT as usize, cn, cb[0..8]); }
    var vn : usize = 0;
    if (cn <= 8) { vn = cn; }
    const nv : usize = ver_text(slots[(IT_VER as usize) * SB_SLOT .. (IT_VER as usize) * SB_SLOT + SB_SLOT], tg[TPG_U_CUR] as u32, cb[0..8], vn);
    present = present + sb_put(kit, slots, lens, widths, IT_VER, nv, 0.0);
    const nu : usize = sb_upd_text(tg, cl, slots[(IT_UPD as usize) * SB_SLOT .. (IT_UPD as usize) * SB_SLOT + SB_SLOT]);
    if (nu > 0) { present = present + sb_put(kit, slots, lens, widths, IT_UPD, nu, 0.0); }
    const ng : usize = god_text(slots[(IT_GOD as usize) * SB_SLOT .. (IT_GOD as usize) * SB_SLOT + SB_SLOT], tg[TPG_Q_GOD] != 0, sst[SST_QRUN], EV_MAX_AGENTS);
    present = present + sb_put(kit, slots, lens, widths, IT_GOD, ng, 0.0);
    const ns : usize = srv_text(slots[(IT_SRV as usize) * SB_SLOT .. (IT_SRV as usize) * SB_SLOT + SB_SLOT], sst[SST_SRV], sb_panes(sst));
    present = present + sb_put(kit, slots, lens, widths, IT_SRV, ns, 0.0);
    const lt : u32 = sb_worst_light(sst);
    if (lt != LIGHT_NONE) {
        const nl : usize = light_text(slots[(IT_LIGHT as usize) * SB_SLOT .. (IT_LIGHT as usize) * SB_SLOT + SB_SLOT], lt, "", 0);
        present = present + sb_put(kit, slots, lens, widths, IT_LIGHT, nl, 10.0);
    }
    if (sst[SST_QFEED] == 1) {
        const na : usize = lanes_text(slots[(IT_LANES as usize) * SB_SLOT .. (IT_LANES as usize) * SB_SLOT + SB_SLOT], sst[SST_QRUN], sst[SST_QBLK]);
        present = present + sb_put(kit, slots, lens, widths, IT_LANES, na, 0.0);
        const nq : usize = queen_text(slots[(IT_QUEEN as usize) * SB_SLOT .. (IT_QUEEN as usize) * SB_SLOT + SB_SLOT], sst[SST_QRUN], sst[SST_QIDLE], sst[SST_QBLK], sst[SST_QREV]);
        present = present + sb_put(kit, slots, lens, widths, IT_QUEEN, nq, 0.0);
    }
    if (sst[SST_DISK] > 0) {
        const nd : usize = load_text(slots[(IT_LOAD as usize) * SB_SLOT .. (IT_LOAD as usize) * SB_SLOT + SB_SLOT], NOT_READ, NOT_READ, sst[SST_DISK] - 1);
        present = present + sb_put(kit, slots, lens, widths, IT_LOAD, nd, 0.0);
    }
    if (tg[TPG_NOW] > 0) {
        const tz : i64 = @as(i64, @intCast(tg[TPG_Q_TZ])) - @as(i64, @intCast(TG_TZ_BIAS));
        const nk : usize = clock_text(slots[(IT_CLOCK as usize) * SB_SLOT .. (IT_CLOCK as usize) * SB_SLOT + SB_SLOT], tg[TPG_NOW], tz);
        present = present + sb_put(kit, slots, lens, widths, IT_CLOCK, nk, 0.0);
    }
    return present;
}

/// The footer item under (x, y): its id, IT_FOLD for the "...", SB_NONE for none.
fn sb_hit(kit: [48]u64, tg: []const u64, sst: []const u32, cl: []const u8, x: f64, y: f64, sw: f64, sh: f64) -> u32 {
    if (in_bar(y, sh) == false) { return SB_NONE; }
    var slots : [704]u8 = undefined;
    var lens : [11]u32 = undefined;
    var widths : [11]f64 = undefined;
    var k : usize = 0;
    while (k < 11) {
        lens[k] = 0;
        widths[k] = 0.0;
        k = k + 1;
    }
    const present : u32 = sb_build(kit, tg, sst, cl, slots[0..704], lens[0..11], widths[0..11]);
    const vis : u32 = visible_mask(present, widths[0..11], avail_w(sw));
    return sb_item_at(x, y, sh, vis, present, widths[0..11]);
}

/// The footer: matte glass across the window bottom, small caps, each item from its one source; OPEN SOURCE T27,
/// KEYS and DOCTOR at the right end. The items that do not fit fold into "..." with a tooltip list.
fn draw_footer(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, cl: []const u8, mx: f64, my: f64, sw: f64, sh: f64, full: bool, a: f64, kyp: bool, dlabel: u64, dp: bool) -> void {
    draw_ground(c, 0.0, sh - SB_H, sw, SB_H, SURF_SIDEBAR, sw, a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, 0.0, sh - SB_H, sw, HAIR);
    var slots : [704]u8 = undefined;
    var lens : [11]u32 = undefined;
    var widths : [11]f64 = undefined;
    var k : usize = 0;
    while (k < 11) {
        lens[k] = 0;
        widths[k] = 0.0;
        k = k + 1;
    }
    const present : u32 = sb_build(kit, tg, sst, cl, slots[0..704], lens[0..11], widths[0..11]);
    const vis : u32 = visible_mask(present, widths[0..11], avail_w(sw));
    const hot : u32 = sb_item_at(mx, my, sh, vis, present, widths[0..11]);
    const base : f64 = sh - 8.0;
    var id : u32 = 0;
    while (id < IT_COUNT) {
        if ((vis >> id) % 2 == 1) {
            const o : usize = (id as usize) * SB_SLOT;
            var x : f64 = sb_item_x(id, vis, present, widths[0..11]);
            var al : f64 = LABEL_WHITE;
            if (hot == id) { al = TEXT_WHITE; }
            if (id == IT_UPD and tg[TPG_U_ST] == (U_STAGED as u64)) { al = TEXT_WHITE; }
            if (id == IT_UPD and ac_upd_shown(cl)) { al = TEXT_WHITE; }
            if (id == IT_GOD and tg[TPG_Q_GOD] != 0) { al = TEXT_WHITE; }
            if (id == IT_LOAD and sst[SST_DISK] > 0 and load_red(NOT_READ, sst[SST_DISK] - 1)) { al = TEXT_WHITE; }
            if (id == IT_LIGHT) {
                draw_light_dot(c, x + 4.0, sh - 11.5, sb_worst_light(sst), a);
                x = x + 10.0;
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, al * a);
            draw_bytes(c, kit, slots[o .. o + SB_SLOT], lens[id as usize] as usize, x, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
            if (id == IT_GOD and tg[TPG_Q_GOD] != 0) {
                cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a);
                cg_arc(c, sb_item_x(id, vis, present, widths[0..11]) - 6.0, sh - 11.5, 2.5, 0.0, 6.283185307, 0);
                cg_fill_path(c);
            }
            if (id == IT_LOAD and sst[SST_DISK] > 0 and load_red(NOT_READ, sst[SST_DISK] - 1)) {
                cg_fill_rgba(c, 1.0, 0.25, 0.2, 0.95 * a);
                cg_arc(c, sb_item_x(id, vis, present, widths[0..11]) - 6.0, sh - 11.5, 2.5, 0.0, 6.283185307, 0);
                cg_fill_path(c);
            }
        }
        id = id + 1;
    }
    if (vis != present) {
        const fx : f64 = sb_item_x(IT_FOLD, vis, present, widths[0..11]);
        var fa : f64 = LABEL_WHITE;
        if (hot == IT_FOLD) { fa = TEXT_WHITE; }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, fa * a);
        draw_bytes(c, kit, "...", 3, fx, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
        if (hot == IT_FOLD) {
            var tip : [320]u8 = undefined;
            const tn : usize = fold_tip(slots[0..704], lens[0..11], present - vis, tip[0..320]);
            const tw : f64 = bytes_w(kit, tip[0..320], tn, SB_SIZE, WEIGHT_SEMIBOLD, false);
            var tx : f64 = fx;
            if (tx + tw + 16.0 > sw) { tx = sw - tw - 16.0; }
            if (tx < 4.0) { tx = 4.0; }
            round_rect(c, tx - 6.0, sh - SB_H - 22.0, tw + 12.0, 18.0, 5.0);
            cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.9 * a);
            cg_fill_path(c);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_bytes(c, kit, tip[0..320], tn, tx, sh - SB_H - 9.0, SB_SIZE, WEIGHT_SEMIBOLD, false);
        }
    }
    // the right end: OPEN SOURCE T27, KEYS (with the worst light), DOCTOR n
    var la : f64 = LABEL_WHITE;
    if (on_repo(mx, my, sw, sh)) { la = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    const lw : f64 = draw_text(c, kit, kit[K_REPO], repo_left(sw), base, SB_SIZE, WEIGHT_SEMIBOLD, false);
    if (on_repo(mx, my, sw, sh)) { cg_fill_rect(c, repo_left(sw), sh - 5.5, lw, HAIR); }
    var ka : f64 = LABEL_WHITE;
    if (kyp or on_keys(mx, my, sw, sh)) { ka = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ka * a);
    var kw : [16]u8 = undefined;
    const kn : usize = csv_field(KEYS_WORDS, 0, kw[0..16]);
    draw_bytes(c, kit, kw[0..16], kn, keys_left(sw) + 8.0, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
    draw_light_dot(c, keys_left(sw) + 1.0, sh - 11.5, sb_worst_light(sst), a);
    var da : f64 = LABEL_WHITE;
    if (dp or on_doc(mx, my, sw, sh)) { da = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, da * a);
    draw_text(c, kit, dlabel, doc_left(sw) + 22.0, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
}

/// GOD MODE's strip, just above the footer while it is on: the next gap, the running lanes, the last Queen tick.
fn draw_god_strip(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, sw: f64, sh: f64, full: bool, a: f64, god: bool) -> void {
    if (god == false) { return; }
    const top : f64 = strip_top(sh);
    draw_ground(c, 0.0, top, sw, STRIP_H, SURF_SIDEBAR, sw, a);
    var t : [128]u8 = undefined;
    var ago : u64 = NO_TICK;
    if (tg[TPG_G_LAST] > 0 and tg[TPG_NOW] >= tg[TPG_G_LAST]) { ago = tg[TPG_NOW] - tg[TPG_G_LAST]; }
    const n : usize = god_strip_text(t[0..128], tg[TPG_G_NEXT] as u32, sst[SST_QRUN], EV_MAX_AGENTS, ago, tg[TPG_G_RC] as u32);
    cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a);
    cg_arc(c, SB_PAD + 2.0, top + 8.0, 2.5, 0.0, 6.283185307, 0);
    cg_fill_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_bytes(c, kit, t[0..128], n, SB_PAD + 10.0, top + 11.5, SB_SIZE, WEIGHT_SEMIBOLD, false);
}

/// The header's right cluster: [version text] [UPDATE NOW when ready] [GOD MODE switch], always drawn.
fn draw_header_cluster(c: u64, kit: [48]u64, tg: []const u64, sw: f64, god: bool, brand_end: f64) -> void {
    const r : f64 = hdr_right(sw);
    const mid : f64 = 0.5 * TITLE_H;
    const ready : bool = tg[TPG_U_ON] != 0 and tg[TPG_U_ST] == (U_STAGED as u64);
    // the GOD MODE switch: gold glow when on
    const gx : f64 = god_x(r);
    round_rect(c, gx, mid - 0.5 * GOD_H, GOD_W, GOD_H, 9.0);
    if (god) {
        cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.22);
        cg_fill_path(c);
        round_rect(c, gx - 1.5, mid - 0.5 * GOD_H - 1.5, GOD_W + 3.0, GOD_H + 3.0, 10.5);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.35);
        cg_stroke_path(c);
        round_rect(c, gx, mid - 0.5 * GOD_H, GOD_W, GOD_H, 9.0);
        cg_line_width(c, 1.2);
        cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.95);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    }
    cg_stroke_path(c);
    var gt : [16]u8 = undefined;
    const gn : usize = put_bytes(gt[0..16], 0, "GOD MODE");
    const gw : f64 = bytes_w(kit, gt[0..16], gn, 7.5, WEIGHT_SEMIBOLD, false);
    if (god) { cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 1.0); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE); }
    draw_bytes(c, kit, gt[0..16], gn, gx + 0.5 * (GOD_W - gw), mid + 2.8, 7.5, WEIGHT_SEMIBOLD, false);
    if (ready) {
        const bx : f64 = hdr_btn_x(r);
        round_rect(c, bx, mid - 0.5 * HDR_BTN_H, HDR_BTN_W, HDR_BTN_H, 5.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        cg_stroke_path(c);
        var ut : [16]u8 = undefined;
        const un : usize = put_bytes(ut[0..16], 0, "UPDATE NOW");
        const uw : f64 = bytes_w(kit, ut[0..16], un, 7.5, WEIGHT_SEMIBOLD, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        draw_bytes(c, kit, ut[0..16], un, bx + 0.5 * (HDR_BTN_W - uw), mid + 2.8, 7.5, WEIGHT_SEMIBOLD, false);
    }
    // the version text, from the same constants as the bundle plist, never typed
    var h : [64]u8 = undefined;
    const hn : usize = header_text(h[0..64], tg[TPG_U_CUR] as u32, ready, tg[TPG_U_CANDV], tg[TPG_U_CAND] as u32);
    const hw : f64 = bytes_w(kit, h[0..64], hn, 9.0, WEIGHT_SEMIBOLD, false);
    const hx : f64 = hdr_text_right(r, ready) - hw;
    if (hx > brand_end + 12.0) {
        if (ready) { cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE); }
        draw_bytes(c, kit, h[0..64], hn, hx, mid + 3.2, 9.0, WEIGHT_SEMIBOLD, false);
    }
}

/// One run of the GOD tick job and its reap: while GOD MODE is on and a lane slot is free the local Queen is asked
/// for lanes (`tri-queen queen --lanes N tick`), at most every GOD_TICK_S seconds.
fn god_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, god: bool, running: u32) -> void {
    const cap : u32 = qd_fl_lanes(tg[TPG_QD_FLAGS]);
    const force : bool = qd_fl_now(tg[TPG_QD_FLAGS]);
    if (tg[TPG_G_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_G_PID]);
        if (d == 0) {
            if (now > tg[TPG_G_START] + 120) { sys_kill(@as(i32, @intCast(tg[TPG_G_PID])), 9); }
        } else {
            tg[TPG_G_PID] = 0;
            tg[TPG_G_RC] = 0;
            if (d != 1) { tg[TPG_G_RC] = 1; }
            tg_bump(tg);
        }
        return;
    }
    if (force) { tg[TPG_QD_FLAGS] = qd_fl_clear_now(tg[TPG_QD_FLAGS]); }
    if ((force and lanes_free(running, cap) > 0) or (force == false and god_tick_due(qd_tick_wanted(god, tg[TPG_QD_FLAGS]), now, tg[TPG_G_LAST], running, cap))) {
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = e + tick_cmd(tb[e .. TBO_ROOT], lanes_free(running, cap));
        tg[TPG_G_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_G_PID] = pid;
            tg[TPG_G_START] = now;
        } else {
            tg[TPG_G_RC] = 1;
        }
        tg_bump(tg);
    }
}

// ======================================================================================================
// P. PROFILE (owner, 2026-10-21; Refs gHashTag/t27#11560). profile.t27 decides (limits, the nickname rules, typing,
// the paste, the panel boxes, the state step), profile_host.t27 touches the machine (the file panel, ImageIO, the
// atomic files). This block only keeps the state, draws it and forwards the mouse and the keys.
//   - the header circle: PRF_HEAD_D wide, left of the refresh arc; the picture clipped to a circle, else the first
//     letter of the nickname on a dim disc, else an outline; a click opens or closes the panel;
//   - the PROFILE panel (the slot of the Queen, DOCTOR and KEYS panels): the big circle, CHOOSE PICTURE, REMOVE
//     PICTURE, the nickname field, SAVE, CANCEL and one status line (prf_error_text);
//   - the picture is decoded ONCE (pf_boot at launch, pf_choose after a pick), never inside draw(): the frame
//     only draws the CGImage kept in tg[TPG_PF_IMG].
// The state lives in a 512 byte region of the text store (TBO_PF): offsets below are relative to the region, so
// the fns take the region and the tests run on a plain array. The nickname bytes are at most PRF_NICK_MAX_BYTES.
// Nothing here is a test of the window: the tests below cover the boxes, the typing and the state steps only.
// ======================================================================================================
pub const TPG_PF_IMG : u32 = 255;
pub const TBO_PF : usize = 76800;
pub const PF_CAP : usize = 512;
pub const PF_OPEN : usize = 0;
pub const PF_STATE : usize = 1;
pub const PF_HAS : usize = 2;
pub const PF_CODE : usize = 3;
pub const PF_LEN : usize = 4;
pub const PF_SLEN : usize = 5;
pub const PF_HOLD_LO : usize = 6;
pub const PF_HOLD_HI : usize = 7;
pub const PF_TYPED : usize = 16;
pub const PF_SAVED : usize = 80;
/// The title bar's room taken by the circle: its diameter and the gap before the control it stands beside.
pub const PF_RESERVE : f64 = 32.0;

pub fn pf_head_right(sw: f64) -> f64 { return dock_x(sw) - DOCK_STEP; }
pub fn pf_head_cx(sw: f64) -> f64 { return prf_head_cx(pf_head_right(sw)); }
pub fn pf_head_cy() -> f64 { return prf_head_cy(TITLE_H); }
pub fn on_pf_head(x: f64, y: f64, sw: f64) -> bool { return prf_head_hit(x, y, pf_head_cx(sw), pf_head_cy()); }

/// CANCEL stands right of SAVE, in the same row and size.
pub fn pf_cancel_x(l: f64) -> f64 { return prf_save_x(l) + PRF_SAVE_W + PRF_BTN_GAP; }
pub fn on_pf_cancel(x: f64, y: f64, l: f64, t: f64) -> bool {
    return x >= pf_cancel_x(l) and x < pf_cancel_x(l) + PRF_SAVE_W and y >= prf_save_y(t) and y < prf_save_y(t) + PRF_BTN_H;
}

fn pf_get(pf: []const u8, at: usize) -> u32 { return @as(u32, pf[at]); }
fn pf_set(pf: []u8, at: usize, v: u32) -> void { pf[at] = @as(u8, @intCast(v)); }
pub fn pf_is_open(pf: []const u8) -> bool { return pf[PF_OPEN] != 0; }
pub fn pf_has(pf: []const u8) -> bool { return pf[PF_HAS] == 1; }
pub fn pf_editing(pf: []const u8) -> bool { return pf[PF_STATE] == 1; }

/// The nickname the field shows: the typed text while editing, else the saved one (offset and length in the region).
pub fn pf_shown_at(pf: []const u8) -> usize {
    if (pf_editing(pf)) { return PF_TYPED; }
    return PF_SAVED;
}
pub fn pf_shown_len(pf: []const u8) -> usize {
    if (pf_editing(pf)) { return @as(usize, pf[PF_LEN]); }
    return @as(usize, pf[PF_SLEN]);
}

fn pf_copy(pf: []u8, from: usize, to: usize, n: usize) -> void {
    var i : usize = 0;
    while (i < n) {
        pf[to + i] = pf[from + i];
        i = i + 1;
    }
}

/// A click on the field: edit the saved nickname.
pub fn pf_to_edit(pf: []u8) -> void {
    if (pf_editing(pf)) { return; }
    const n : usize = @as(usize, pf[PF_SLEN]);
    pf_copy(pf, PF_SAVED, PF_TYPED, n);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), PRF_EV_FIELD, true));
}

/// Escape or CANCEL (PRF_EV_CANCEL) and the close x or another panel (PRF_EV_CLOSE): the saved nickname comes back,
/// nothing is written, the status line is cleared.
pub fn pf_leave(pf: []u8, ev: u32) -> void {
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), ev, true));
    pf_set(pf, PF_LEN, @as(u32, pf[PF_SLEN]));
    pf_copy(pf, PF_SAVED, PF_TYPED, @as(usize, pf[PF_SLEN]));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
}

/// One typed UTF-16 unit (NSEvent characters): a surrogate pair is joined over two calls (prf_unit_cp / prf_unit_hold).
pub fn pf_unit(pf: []u8, unit: u32) -> void {
    const pend : u32 = pf_get(pf, PF_HOLD_LO) + 256 * pf_get(pf, PF_HOLD_HI);
    const cp : u32 = prf_unit_cp(pend, unit);
    const hold : u32 = prf_unit_hold(pend, unit);
    pf_set(pf, PF_HOLD_LO, hold % 256);
    pf_set(pf, PF_HOLD_HI, hold / 256);
    if (cp == PRF_NONE) { return; }
    const n : usize = prf_append(pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_LEN]), cp);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_CODE, PRF_OK);
}

pub fn pf_back(pf: []u8) -> void {
    const n : usize = prf_backspace(pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_LEN]));
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
}

/// Cmd+V: the pasteboard text joins the nickname (text only, the rules of prf_paste); a status line tells when part
/// of it was left out.
pub fn pf_paste_in(pf: []u8, src: []const u8) -> void {
    const len : usize = @as(usize, pf[PF_LEN]);
    const err : u32 = prf_paste_error(src, pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], len);
    const n : usize = prf_paste(src, pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], len);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_CODE, err);
}

/// SAVE (the button or Return): the typed nickname through prfh_save_nick; on success it becomes the saved one and
/// the edit ends, on a failure the edit stays and the status line says why.
pub fn pf_save(pf: []u8) -> void {
    if (pf_editing(pf) == false) { pf_to_edit(pf); }
    const n : usize = @as(usize, pf[PF_LEN]);
    const code : u32 = prfh_save_nick(pf[PF_TYPED .. PF_TYPED + n], pf_has(pf));
    const ok : bool = code == PRF_OK_SAVED;
    if (ok) {
        pf_copy(pf, PF_TYPED, PF_SAVED, n);
        pf_set(pf, PF_SLEN, @as(u32, @intCast(n)));
    }
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), PRF_EV_SAVE, ok));
    pf_set(pf, PF_CODE, code);
}

/// The saved picture as a CGImage, decoded now (ImageIO, 256 px). 0 when there is none or it does not decode.
fn pf_decode() -> u64 {
    var p : [1024]u8 = undefined;
    const n : usize = prfh_avatar_path(p[0..1024]);
    if (n == 0) { return 0; }
    return card_thumb(p[0..n], n, @as(u32, @intCast(PRF_AVATAR_PX)));
}

/// Launch: read profile.t27p once and decode avatar.png once. A missing or damaged file reads as "not set".
pub fn pf_boot(pf: []u8, tg: []u64) -> void {
    var res : [2]u32 = undefined;
    const n : usize = prfh_load(pf[PF_SAVED .. PF_SAVED + PRF_NICK_MAX_BYTES], res[0..2]);
    pf_set(pf, PF_SLEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_copy(pf, PF_SAVED, PF_TYPED, n);
    pf_set(pf, PF_HAS, 0);
    tg[TPG_PF_IMG] = 0;
    if (res[0] == 1) {
        const img : u64 = pf_decode();
        if (img != 0) {
            tg[TPG_PF_IMG] = img;
            pf_set(pf, PF_HAS, 1);
        }
    }
}

/// CHOOSE PICTURE: the system file panel, the checks and the square PNG are prfh_pick's; the new picture is decoded
/// here, once. A cancelled panel says nothing; a failure keeps the picture and nickname that were there.
pub fn pf_choose(pf: []u8, tg: []u64) -> void {
    const had : bool = pf_has(pf);
    var code : u32 = prfh_pick(pf[PF_SAVED .. PF_SAVED + @as(usize, pf[PF_SLEN])], had);
    if (code == PRF_OK) {
        const img : u64 = pf_decode();
        if (img != 0) {
            if (tg[TPG_PF_IMG] != 0) { cg_image_release(tg[TPG_PF_IMG]); }
            tg[TPG_PF_IMG] = img;
            pf_set(pf, PF_HAS, 1);
            code = PRF_OK_SAVED;
        } else {
            code = PRF_E_UNREADABLE;
        }
    } else if (code == PRF_E_CANCELLED) {
        code = PRF_OK;
    }
    pf_set(pf, PF_CODE, code);
}

/// REMOVE PICTURE: the nickname stays; on a failure the picture stays.
pub fn pf_remove(pf: []u8, tg: []u64) -> void {
    var code : u32 = prfh_remove(pf[PF_SAVED .. PF_SAVED + @as(usize, pf[PF_SLEN])]);
    if (code == PRF_OK) {
        if (tg[TPG_PF_IMG] != 0) { cg_image_release(tg[TPG_PF_IMG]); }
        tg[TPG_PF_IMG] = 0;
        pf_set(pf, PF_HAS, 0);
        code = PRF_OK_SAVED;
    }
    pf_set(pf, PF_CODE, code);
}

/// The circle: the picture clipped to it (in colour, prf_colour_ok), else the initial on a dim disc, else an outline.
fn draw_pf_avatar(c: u64, kit: [48]u64, img: u64, nick: []const u8, nn: usize, cx: f64, cy: f64, r: f64, lit: bool, a: f64) -> void {
    const look : u32 = prf_look(img != 0, nick[0..nn]);
    var ring : f64 = lv(kit, THV_LABEL_WHITE);
    if (lit) { ring = lv(kit, THV_TEXT_WHITE); }
    if (look == PRF_LOOK_PICTURE) {
        cg_save(c);
        cg_arc(c, cx, cy, r, 0.0, TAU, 0);
        cg_close(c);
        cg_clip(c);
        cg_alpha(c, a);
        cg_translate(c, cx - r, cy + r);
        cg_scale(c, 1.0, -1.0);
        cg_draw_image(c, 0.0, 0.0, 2.0 * r, 2.0 * r, img);
        cg_restore(c);
    } else if (look == PRF_LOOK_LETTER) {
        cg_arc(c, cx, cy, r, 0.0, TAU, 0);
        cg_close(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.14 * a);
        cg_fill_path(c);
        var ib : [4]u8 = undefined;
        const n : usize = prf_initial(nick[0..nn], ib[0..4]);
        const size : f64 = 1.0 * r;
        const w : f64 = bytes_w(kit, ib[0..4], n, size, WEIGHT_SEMIBOLD, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE) * a);
        draw_bytes(c, kit, ib[0..4], n, cx - 0.5 * w, cy + 0.36 * size, size, WEIGHT_SEMIBOLD, false);
    }
    cg_arc(c, cx, cy, r, 0.0, TAU, 0);
    cg_close(c);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, ring * a);
    cg_stroke_path(c);
}

/// A button of the PROFILE panel: the plate of the panel glass, a rounded outline, the word centred.
fn draw_pf_btn(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: []const u8, n: usize, live: bool, sw: f64, over: bool) -> void {
    draw_plate(c, bx - 2.0, by - 2.0, bw + 4.0, PRF_BTN_H + 4.0, sw);
    round_rect(c, bx, by, bw, PRF_BTN_H, 5.0);
    var ink : f64 = lv(kit, THV_TEXT_WHITE);
    if (live == false) { ink = lv(kit, THV_MUTED_WHITE); }
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over and live) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    const lw : f64 = bytes_w(kit, word, n, 9.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, n, bx + 0.5 * (bw - lw), by + 16.0, 9.5, WEIGHT_SEMIBOLD, false);
}

fn draw_profile_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, pf: []const u8, img: u64) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "PROFILE", 7, x, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    const has : bool = pf_has(pf);
    const d : f64 = prf_squeeze(t, sh);
    const u : f64 = t - d;
    const hit : u32 = prf_panel_hit_d(mx, my, l, QP_W, t, has, d);
    const editing : bool = pf_editing(pf);
    // the big circle always shows the SAVED nickname's initial; the field shows what is being typed
    draw_pf_avatar(c, kit, img, pf[PF_SAVED .. PF_SAVED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_SLEN]), prf_avatar_cx(l, QP_W), prf_avatar_cy_d(t, d), prf_avatar_r(d), hit == PRF_H_CHOOSE, 1.0);
    draw_pf_btn(c, kit, prf_btn_x(l, QP_W, 0), prf_btn_y(u), prf_btn_w(QP_W), "CHOOSE PICTURE", 14, true, sw, hit == PRF_H_CHOOSE);
    draw_pf_btn(c, kit, prf_btn_x(l, QP_W, 1), prf_btn_y(u), prf_btn_w(QP_W), "REMOVE PICTURE", 14, has, sw, hit == PRF_H_REMOVE);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "NICKNAME", 8, x, prf_label_y(u), 9.5, 0.0, false);
    // the field: a rounded outline, brighter while editing; the text is cut with an ellipsis before the right edge
    const fx : f64 = prf_field_x(l);
    const fy : f64 = prf_field_y(u);
    const fw : f64 = prf_field_w(QP_W);
    round_rect(c, fx, fy, fw, PRF_FIELD_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (editing) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    if (editing == false and hit == PRF_H_FIELD) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    cg_stroke_path(c);
    const at : usize = pf_shown_at(pf);
    const sn : usize = pf_shown_len(pf);
    var shown : [PRF_NICK_MAX_BYTES + 2]u8 = undefined;
    var i : usize = 0;
    while (i < sn) {
        shown[i] = pf[at + i];
        i = i + 1;
    }
    var tn : usize = sn;
    if (editing) {
        shown[tn] = 95;
        tn = tn + 1;
    }
    if (tn > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, shown[0 .. PRF_NICK_MAX_BYTES + 2], tn, fx + 8.0, fy + 17.5, 11.0, 0.0, false, fx + fw - 8.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "Type a nickname", 15, fx + 8.0, fy + 17.5, 11.0, 0.0, false);
    }
    draw_pf_btn(c, kit, prf_save_x(l), prf_save_y(u), PRF_SAVE_W, "SAVE", 4, true, sw, hit == PRF_H_SAVE);
    draw_pf_btn(c, kit, pf_cancel_x(l), prf_save_y(u), PRF_SAVE_W, "CANCEL", 6, editing, sw, editing and on_pf_cancel(mx, my, l, u));
    // the status line: the fixed line of prf_error_text, wrapped in the panel's width, at most three lines
    const msg : []const u8 = prf_error_text(pf_get(pf, PF_CODE));
    var from : usize = 0;
    var ln : u32 = 0;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    while (from < msg.len and ln < 3) {
        const rest : []const u8 = msg[from .. msg.len];
        const base : f64 = prf_status_y(u) + 13.0 * @as(f64, @floatFromInt(ln));
        var cut : usize = wrap_at(kit, rest, rest.len, 9.5, 0.0, right - x);
        if (ln == 2) { cut = rest.len; }
        if (base < sh - 6.0) { draw_fit(c, kit, rest, cut, x, base, 9.5, 0.0, false, right); }
        from = from + cut;
        if (from < msg.len and msg[from] == 32) { from = from + 1; }
        ln = ln + 1;
    }
}

// ======================================================================================================
// CL. CALL (owner, 2026-10-21; Refs gHashTag/t27#11560). call_session.t27 carries the call (the cs_* API over
// call_core and the part F audio path), call_view.t27 decides the view, the buttons, the address rules and the
// boxes. This block only opens the session once at launch, polls it from the main loop, keeps a snapshot of it in a
// 256 byte region of the text store (TBO_CL) that draw() reads, and turns a click or a key into one cs_* call.
//   - the title bar pill CALL, left of the profile circle, opens or closes the panel; an incoming call opens it;
//   - the CALL panel (the slot of the Queen, DOCTOR, KEYS and PROFILE panels): this device's address and test
//     fingerprint, then the view of call_view (address field and CALL; CANCEL; ANSWER / DECLINE; the 6 digits large
//     with CODES MATCH / CODES DIFFER; the duration with MUTE / END CALL; the reason with CLOSE).
//   - where it listens: T27OS_CALL_BIND (default 127.0.0.1; a private network or 127.x, or 0.0.0.0 for all interfaces,
//     warned on THIS DEVICE and announced with pub=1, call_view section 7), T27OS_CALL_PORT (47727);
//   - a public address is dialled only after ALLOW for that address (spent by the dial) or with T27OS_ALLOW_PUBLIC=1;
//     a taken port moves on to the next of at most ten (call_view section 6, cl_port_open), the one that opened is
//     kept in ~/.t27os/callport.t27 and said in the panel and the cabinet;
//     T27OS_CALL_AUDIO=test sends call_session's numbered test pattern instead of the microphone; T27OS_CALL_PEER
//     fills the address field at launch.
// The session block (CS_LEN bytes) is a local of main(): it never moves, as the audio callbacks need.
// ======================================================================================================
pub const TBO_CL : usize = 77312;
pub const CL_CAP : usize = 8192;
pub const CL_OPEN : usize = 0;
pub const CL_VIEW : usize = 1;
pub const CL_FOCUS : usize = 2;
pub const CL_ALEN : usize = 3;
pub const CL_MUTED : usize = 4;
pub const CL_SAID : usize = 5;
pub const CL_REASON : usize = 6;
pub const CL_NOTE : usize = 7;
pub const CL_UP : usize = 8;
pub const CL_TALKED : usize = 9;
pub const CL_CODE : usize = 10;
pub const CL_PFP : usize = 16;
pub const CL_PIP : usize = 26;
pub const CL_SECS : usize = 32;
pub const CL_SENT : usize = 36;
pub const CL_RECV : usize = 40;
pub const CL_GAP : usize = 44;
pub const CL_REJ : usize = 48;
pub const CL_ME_IP : usize = 52;
pub const CL_ME_PORT : usize = 56;
pub const CL_N10 : usize = 60;
pub const CL_ADDR : usize = 64;
pub const CL_NPOLL : usize = 96;
/// The audio counters of the part F block (callback_probe.t27, cs_stat 1000 + i): frames captured (2), underruns (4),
/// overruns (5), tx ring overruns (7).
pub const CL_CAPT : usize = 100;
pub const CL_UNDER : usize = 104;
pub const CL_OVER : usize = 108;
pub const CL_TXO : usize = 112;
/// The bytes the frame key folds in: everything draw() reads.
pub const CL_KEY_N : usize = 736;
/// Not drawn: 1 when T27OS_CALL_STATS is set, the call counters go to stderr once a second (a test aid, off by default).
pub const CL_STATS : usize = 120;
/// Not drawn: 1 when T27OS_CALL_AUTOTEST is set (test aid, not product behavior): an incoming call is answered 2 s after
/// it rings and the code is confirmed as matching 2 s after it appears. Off by default.
pub const CL_AUTO : usize = 121;
/// Video (owner, 2026-10-22), drawn: 1 while a video frame arrived within the last second, the serial of the picture
/// held (the session's CS_V_SERIAL), the frames shown and skipped so far, and the decoded CGImage of the last
/// complete frame (two u32, low then high; 0 = none). The window decodes a new picture whenever the serial changes.
/// Not drawn: 1 = a one to one call sends video (the camera, the test picture of call_vid.t27 until it is allowed);
/// on by default, T27OS_CALL_VIDEO=0 turns it off (cl_video_on).
pub const CL_VLIVE : usize = 124;
pub const CL_VSEND : usize = 125;
/// Not drawn: 1 when T27OS_CALL_CAMERA=0 (the camera stays off, the test generator is the source), the status of the
/// last camera start (0 running, 1 restricted, 2 denied, 3 no camera), and 1 once this call's start was tried.
pub const CL_CAMOFF : usize = 126;
pub const CL_CAMST : usize = 127;
pub const CL_VSER : usize = 128;
pub const CL_VSHOWN : usize = 132;
pub const CL_VSKIP : usize = 136;
/// Drawn: the camera's capture state (call_video.t27 CVS_*); FAILED puts "camera unavailable" on the video line while
/// the generator carries the call's video.
pub const CL_CAMSTATE : usize = 140;
pub const CL_VIMG : usize = 144;
pub const CL_VIMG_END : usize = 152;
/// Not drawn: the address of the live camera block (call_video.t27 cvl_new), two u32, low then high; 0 = none yet.
/// CL_CAMTRY is 1 once this call's start was tried (cleared when the call is over).
pub const CL_CAMP : usize = 152;
pub const CL_CAMTRY : usize = 160;
/// Not drawn: the address of the test picture's encoder block (call_vid.t27 vgq_new), two u32, low then high; 0 = none.
pub const CL_VENC : usize = 161;
/// Self-view (owner, 2026-10-23), drawn: the decoded CGImage of the user's own last camera frame (two u32, low then
/// high; 0 = none; not drawn, past the group video's links) and a counter of the frames decoded (one drawn byte after the
/// account block, wraps; a new frame redraws). Released when the call is over.
pub const CL_SELF : usize = 800;
pub const CL_SELF_N : usize = 229;
/// H.264 (owner, 2026-10-23; call_h264.t27, call_vt.t27), drawn and folded into the frame key (they change once a
/// second at most): the video this side sends (VN_*), frames a second received and sent, 1 while the remote picture is
/// H.264 (a 16:9 box), the received and the sent picture size, kbit/s received and sent (u16 each, little endian),
/// 1 once the remote and the own picture layers showed a picture in this call, the note's mode (VN_JPEG_* or 0).
pub const CL_VH_MODE : usize = 808;
pub const CL_VH_RXFPS : usize = 809;
pub const CL_VH_TXFPS : usize = 810;
pub const CL_VH_RWIDE : usize = 811;
pub const CL_VH_RXW : usize = 812;
pub const CL_VH_RXH : usize = 814;
pub const CL_VH_TXW : usize = 816;
pub const CL_VH_TXH : usize = 818;
pub const CL_VH_RXK : usize = 820;
pub const CL_VH_TXK : usize = 822;
pub const CL_VH_RPIC : usize = 824;
pub const CL_VH_SPIC : usize = 825;
pub const CL_VH_NOTE : usize = 826;
pub const CL_VH_KEY_END : usize = 828;
/// Not drawn: the encoder and decoder blocks (kept for the app's life), the remote picture's layer, the own picture's
/// layer and its YOU label, what the remote layer holds (a CVPixelBuffer or a CGImage of the old JPEG: kind 1 / 2) and
/// what the own layer holds, a JPEG picture waiting for the layer, the JPEG serial last taken, pictures put on the two
/// layers, 1 while the layers are shown, 1 while this call used the decoder, the frame the layers stand at (x, y, w, h
/// in quarter points), the camera's callbacks at the last second.
pub const CL_VH_ENC : usize = 832;
pub const CL_VH_DEC : usize = 840;
pub const CL_VH_LR : usize = 848;
pub const CL_VH_LS : usize = 856;
pub const CL_VH_LT : usize = 864;
pub const CL_VH_RPB : usize = 872;
pub const CL_VH_SPB : usize = 880;
pub const CL_VH_PIMG : usize = 888;
pub const CL_VH_JSER : usize = 896;
pub const CL_VH_RXN : usize = 900;
pub const CL_VH_SXN : usize = 904;
pub const CL_VH_RKIND : usize = 908;
pub const CL_VH_VIS : usize = 909;
pub const CL_VH_OPEN : usize = 910;
pub const CL_VH_GEOM : usize = 912;
pub const CL_VH_CAMCB : usize = 928;
pub const CL_VH_CAMFPS : usize = 932;
pub const CL_VH_END : usize = 936;
/// Not drawn: 1 while the call started by CALL on a friend's card (a voice call) runs: no camera, no video sent; back to
/// 0 (and video as launched) once the call block is idle again (ch_tick).
pub const CL_NOCAM : usize = 228;
/// Drawn: the configured call port (big-endian, like CL_ME_PORT, which holds the port that opened), the mask of the
/// ports tried that did not open (call_view cv_port_bit, two bytes) and how many were tried (call_view section 6).
pub const CL_BPORT : usize = 232;
/// The CALL panel's port line, between the title (25) and THIS DEVICE (call_view CV_ME_Y).
pub const CL_PORT_Y : f64 = 39.0;
pub const CL_PBUSY : usize = 234;
pub const CL_PTRIED : usize = 236;
/// Drawn (call_view section 7): 1 when T27OS_CALL_BIND=0.0.0.0 (all interfaces, warned on THIS DEVICE), 1 when
/// T27OS_ALLOW_PUBLIC=1, and the one public address ALLOW was pressed for (IPv4 then port, big-endian; 0 = none). The
/// consent lives only here, in memory, and the next dial spends it.
pub const CL_ANY : usize = 237;
pub const CL_PUBENV : usize = 238;
pub const CL_PUBOK : usize = 240;
/// Group video (owner, 2026-10-23), drawn: 0 = not a group call, else 1 + how many members' pictures the strip shows
/// (at most VG_SHOW), how many more members are heard only, the first two bytes of each shown member's fingerprint, the
/// low byte of each shown picture's serial (a new picture redraws), and bit i = tile i got a frame in the last second.
pub const CL_GV : usize = 246;
pub const CL_GV_MORE : usize = 247;
pub const CL_GV_TAG : usize = 248;
pub const CL_GV_SER : usize = 252;
pub const CL_GV_LIVE : usize = 254;
/// Not drawn: each tile's decoded CGImage (two u32, low then high), its full serial (u32) and its link (255 = none).
pub const CL_GVIMG : usize = 768;
pub const CL_GVSER : usize = 784;
pub const CL_GVLINK : usize = 792;
/// CN. Beyond the home network (owner, 2026-10-23; call_nat.t27), past the update part (update_view UPV_END). Drawn: the
/// PUBLIC line's state (call_nat CN_S_*), the address this Mac sends from on its default route (big-endian, 0 = none;
/// call_view cv_lan_pick), the public address (IPv4 then port, big-endian) and whole minutes since it came (at most 255).
pub const CL_N_ST : usize = 8096;
pub const CL_N_LAN : usize = 8100;
pub const CL_N_PUB : usize = 8104;
pub const CL_N_MIN : usize = 8110;
pub const CL_N_KEY_END : usize = 8112;
/// Not drawn: the lookup that runs (CN_RUN_*), LOOK UP pressed and not yet taken, requests sent in this round, the
/// state last said on stderr, the round's start, the last LOOK UP, the last answer and the last route lookup (ms), the
/// server (IPv4 then port), the transaction id of the round (12 bytes).
pub const CL_N_RUN : usize = 8112;
pub const CL_N_REQ : usize = 8113;
pub const CL_N_SENT : usize = 8114;
pub const CL_N_SAID : usize = 8115;
pub const CL_N_T0 : usize = 8116;
pub const CL_N_ASK : usize = 8120;
pub const CL_N_TOK : usize = 8124;
pub const CL_N_LANT : usize = 8128;
pub const CL_N_SRV : usize = 8132;
pub const CL_N_TX : usize = 8138;
/// Not drawn: the punch (T27OS_PUNCH with T27OS_QA=1, or a dial of a public address): its target (IPv4 then port),
/// probes sent, when it started (ms, low 32 bits; 0 = none), the probes received when last said on stderr.
pub const CL_N_PT : usize = 8150;
pub const CL_N_PSENT : usize = 8156;
pub const CL_N_PT0 : usize = 8160;
pub const CL_N_PSAID : usize = 8164;
pub const CL_N_END : usize = 8168;
pub const CN_RUN_IDLE : u32 = 0;
pub const CN_RUN_DNS : u32 = 1;
pub const CN_RUN_STUN : u32 = 2;
/// How often the window asks the system which address it sends from (a connect on a UDP socket: nothing is sent).
pub const CN_LAN_MS : u64 = 5000;
/// IP6. Calls over IPv6 (owner, 2026-10-23; call_ip6.t27), in three places of the CALL region that were free: past
/// the friends' rows (CL_V6_OWN .. CL_V6_PSAID), past the self-view (CL_V6 .. CL_V6_P6) and past the CN part
/// (CL_V6_PT .. CL_V6_END). Drawn (folded into the frame key: CL_V6_OWN .. CL_V6_OWN_END and CL_V6 .. CL_V6_KEY_END):
/// this device's own IPv6 with the call port (call_ip6 ip6_own_rank picks it, 0 rank = none), the typed address of
/// the debug field (it replaces CL_ADDR / CL_ALEN, too short for "[v6]:port"), ALLOW pressed for the typed IPv6 (the
/// next edit or dial clears it: the consent is for the address typed, as CL_PUBOK is for an IPv4), the family of the
/// current or last call (call_ip6 IP6_F_*), the rank of the own address, 1 while "copied" is shown. Not drawn: when the
/// own address was last read and the IPv6 probes last said on stderr; T27OS_QA=1 (the loopback ::1 may be dialled), 1
/// when the punch's target is the IPv6 one, that target, when "copied" began.
pub const CL_V6_OWN : usize = 736;
pub const CL_V6_OWN_END : usize = 754;
pub const CL_V6_OWNT : usize = 754;
pub const CL_V6_PSAID : usize = 758;
/// Test aid T27OS_CALL_DIAL_AFTER=<s> (only with T27OS_QA=1): when the one dial of the CALL field is due (ms, low 32
/// bits; 0 = none).
pub const CL_V6_DIALAT : usize = 762;
pub const CL_V6 : usize = 960;
pub const CL_V6_ALEN : usize = 960;
pub const CL_V6_TXT : usize = 961;
pub const CL_V6_OK : usize = 1008;
pub const CL_V6_FAM : usize = 1009;
pub const CL_V6_OWNR : usize = 1010;
pub const CL_V6_COPIED : usize = 1011;
pub const CL_V6_KEY_END : usize = 1012;
pub const CL_V6_QA : usize = 1012;
pub const CL_V6_P6 : usize = 1013;
pub const CL_V6_PT : usize = 8168;
pub const CL_V6_COPYT : usize = 8186;
pub const CL_V6_END : usize = 8190;
/// "copied" stands on the PUBLIC v6 line this long after a click.
pub const CL_V6_COPY_MS : u64 = 2000;

pub fn cl_consent(cl: []const u8) -> u64 {
    return cl_ip(cl, CL_PUBOK) * 65536 + ((@as(u64, cl[CL_PUBOK + 4]) << 8) | @as(u64, cl[CL_PUBOK + 5]));
}

pub fn cl_put_consent(cl: []u8, a: u64) -> void {
    cl_put_ip(cl, CL_PUBOK, a / 65536);
    cl_put_port(cl, CL_PUBOK + 4, a % 65536);
}

/// The endpoint typed in the debug field (call_ip6 ip6_parse: an IPv4 as v4-mapped, or an IPv6 only with T27OS_QA=1);
/// false when none.
pub fn cl_typed_ep(cl: []const u8, ep: []u8) -> bool {
    if (!ip6_parse(cl[CL_V6_TXT .. CL_V6_TXT + IP6_TEXT_MAX], @as(usize, cl[CL_V6_ALEN]), ep)) { return false; }
    return cl[CL_V6_QA] != 0 or ip6_mapped(ep);
}

/// The IPv4 typed in the debug field as ip * 65536 + port (0 = none, or an IPv6 is typed).
pub fn cl_typed_addr(cl: []const u8) -> u64 {
    var ep : [18]u8 = undefined;
    if (!cl_typed_ep(cl, ep[0..18])) { return 0; }
    return ip6_v4of(ep[0..18]);
}

/// The consent for the typed IPv6: the typed endpoint while ALLOW was pressed for it, else nothing (ep[0..0]).
fn cl_consent6(cl: []const u8, ep: []const u8) -> []const u8 {
    if (cl[CL_V6_OK] != 0) { return ep; }
    return ep[0..0];
}

/// The row under the debug CALL for the typed address (call_view cv_pub_row, call_ip6 ip6_pub_row): 1 shows ALLOW.
pub fn cl_pub_row(cl: []const u8) -> u32 {
    var ep : [18]u8 = undefined;
    if (cl_typed_ep(cl, ep[0..18]) and !ip6_mapped(ep[0..18])) {
        return ip6_pub_row(ep[0..18], cl[CL_PUBENV] != 0, cl_consent6(cl, ep[0..18]));
    }
    return cv_pub_row(cl_typed_addr(cl), cl[CL_PUBENV] != 0, cl_consent(cl));
}

/// ALLOW is drawn and answers: the debug part is shown and the typed public address waits for consent.
pub fn cl_allow_shown(cl: []const u8) -> bool {
    return cl[FV_DEBUG] != 0 and cl_pub_row(cl) == 1;
}
pub const CLW_AUTO_T : usize = 9;
/// The window's own call clock (main's [10]u64): when ACTIVE began, when the last poll returned, the longest gap from
/// the end of one poll to the start of the next while ACTIVE, the state the last snapshot saw, the system activity
/// token held while a call is up, the gaps over 10 ms and the polls counted while ACTIVE.
pub const CLW_T_ACTIVE : usize = 0;
pub const CLW_LAST : usize = 1;
pub const CLW_GAP : usize = 2;
pub const CLW_PREV : usize = 3;
pub const CLW_ACT : usize = 4;
pub const CLW_N10 : usize = 5;
pub const CLW_NPOLL : usize = 6;
pub const CLW_CURSOR : usize = 7;
pub const CLW_CURSOR_MS : usize = 8;

/// Setting the cursor is a round trip to the window server (a 5 s sample of a call: 634 of 1505 main-thread samples
/// in -[NSCursor set]). While a call is up the loop runs every few ms, so the cursor is set when it changes and at
/// most every CL_CURSOR_MS otherwise; with no call it is set every pass, as before.
pub const CL_CURSOR_MS : u64 = 200;
pub fn cl_cursor_due(live: bool, want: u64, last: u64, now: u64, at: u64) -> bool {
    if (!live or want != last or now < at) { return true; }
    return now - at >= CL_CURSOR_MS;
}

/// Two u32 (low then high) as one address.
pub fn cl_get64(cl: []const u8, at: usize) -> u64 { return cl_get32(cl, at) | (cl_get32(cl, at + 4) << 32); }

pub fn cl_put64(cl: []u8, at: usize, v: u64) -> void {
    cl_put32(cl, at, v & 4294967295);
    cl_put32(cl, at + 4, v >> 32);
}

/// A u16 field of the region (little endian), capped.
pub fn cl_put16(cl: []u8, at: usize, v: u64) -> void {
    var x : u64 = v;
    if (x > 65535) { x = 65535; }
    cl[at] = @as(u8, @intCast(x & 255));
    cl[at + 1] = @as(u8, @intCast(x >> 8));
}

pub fn cl_get16(cl: []const u8, at: usize) -> u64 { return @as(u64, cl[at]) | (@as(u64, cl[at + 1]) << 8); }

pub fn cl_get32(cl: []const u8, at: usize) -> u64 {
    return @as(u64, cl[at]) | (@as(u64, cl[at + 1]) << 8) | (@as(u64, cl[at + 2]) << 16) | (@as(u64, cl[at + 3]) << 24);
}

pub fn cl_put32(cl: []u8, at: usize, v: u64) -> void {
    var x : u64 = v;
    if (x > 4294967295) { x = 4294967295; }
    cl[at] = @as(u8, @intCast(x & 255));
    cl[at + 1] = @as(u8, @intCast((x >> 8) & 255));
    cl[at + 2] = @as(u8, @intCast((x >> 16) & 255));
    cl[at + 3] = @as(u8, @intCast((x >> 24) & 255));
}

/// The IPv4 kept big-endian at `at`.
pub fn cl_ip(cl: []const u8, at: usize) -> u64 {
    return (@as(u64, cl[at]) << 24) | (@as(u64, cl[at + 1]) << 16) | (@as(u64, cl[at + 2]) << 8) | @as(u64, cl[at + 3]);
}

pub fn cl_put_ip(cl: []u8, at: usize, ip: u64) -> void {
    cl[at] = @as(u8, @intCast((ip >> 24) & 255));
    cl[at + 1] = @as(u8, @intCast((ip >> 16) & 255));
    cl[at + 2] = @as(u8, @intCast((ip >> 8) & 255));
    cl[at + 3] = @as(u8, @intCast(ip & 255));
}

pub fn cl_me_port(cl: []const u8) -> u64 { return (@as(u64, cl[CL_ME_PORT]) << 8) | @as(u64, cl[CL_ME_PORT + 1]); }
pub fn cl_base_port(cl: []const u8) -> u64 { return (@as(u64, cl[CL_BPORT]) << 8) | @as(u64, cl[CL_BPORT + 1]); }
pub fn cl_port_busy(cl: []const u8) -> u64 { return (@as(u64, cl[CL_PBUSY]) << 8) | @as(u64, cl[CL_PBUSY + 1]); }

/// Keep port (0..65535) big-endian at cl[at].
pub fn cl_put_port(cl: []u8, at: usize, port: u64) -> void {
    cl[at] = @as(u8, @intCast((port >> 8) & 255));
    cl[at + 1] = @as(u8, @intCast(port & 255));
}

/// "port 47727 busy, using 47728" when the port that opened is not the configured one (call_view cv_port_busy_text).
pub fn cl_port_busy_line(cl: []const u8, out: []u8) -> usize {
    if (cl[CL_UP] == 0) { return 0; }
    return cv_port_busy_text(cl_base_port(cl), cl_me_port(cl), cl_port_busy(cl), out);
}

/// The panel's port line: "ONLINE  port 47728", then the busy text when there was one; "OFFLINE  10 call ports busy".
pub fn cl_port_status(cl: []const u8, out: []u8) -> usize {
    var used : u64 = 0;
    if (cl[CL_UP] != 0) { used = cl_me_port(cl); }
    var n : usize = cv_port_line(cl[CL_UP] != 0, used, cl_port_busy(cl), @as(u64, cl[CL_PTRIED]), out);
    var b : [96]u8 = undefined;
    const bn : usize = cl_port_busy_line(cl, b[0..96]);
    if (bn > 0 and n + 2 + bn <= out.len) {
        n = put_bytes(out, n, "  ");
        n = put_bytes(out, n, b[0..bn]);
    }
    return n;
}

/// ~/.t27os, then `leaf` after a slash, NUL-ended in out; the length without the NUL, 0 without HOME.
fn cl_state_path(leaf: []const u8, out: []u8) -> usize {
    const a : u64 = sys_getenv("HOME");
    if (a == 0) { return 0; }
    const hn : u64 = sys_strlen(a);
    if (hn == 0 or hn + 8 + @as(u64, leaf.len) + 2 > @as(u64, out.len)) { return 0; }
    sys_peek(out, a, hn);
    var n : usize = put_bytes(out, @as(usize, @intCast(hn)), "/.t27os");
    if (leaf.len > 0) {
        n = put_bytes(out, n, "/");
        n = put_bytes(out, n, leaf);
    }
    out[n] = 0;
    return n;
}

/// The port the last launch opened (~/.t27os/callport.t27, call_view cv_cp_parse); 0 for no file or a broken one
/// (left as found: the next launch that opens a port writes over it).
fn cl_port_saved() -> u64 {
    var p : [320]u8 = undefined;
    if (cl_state_path(CV_CP_LEAF, p[0..320]) == 0) { return 0; }
    const fd : i32 = sys_open_ro(p[0..320], 0);
    if (fd < 0) { return 0; }
    var t : [96]u8 = undefined;
    var got : i64 = 0;
    var more : bool = true;
    // one byte past the cap: a longer file is broken, not cut to fit
    while (more and got < 96) {
        const r : i64 = sys_read(fd, t[@as(usize, @intCast(got)) .. 96], @as(u64, @intCast(96 - got)));
        if (r <= 0) { more = false; } else { got = got + r; }
    }
    sys_close(fd);
    return cv_cp_parse(t[0 .. @as(usize, @intCast(got))]);
}

/// Write the port that opened (st, call_view cv_port_save_text): a temporary file of mode 0600 renamed over the old.
fn cl_port_save(st: []const u64) -> bool {
    var t : [96]u8 = undefined;
    const n : usize = cv_port_save_text(st, unix_time(0), t[0..96]);
    if (n == 0) { return false; }
    var d : [320]u8 = undefined;
    if (cl_state_path("", d[0..320]) == 0) { return false; }
    sys_mkdir(d[0..320], T27OS_HOME_MODE);
    var tmp : [320]u8 = undefined;
    var fin : [320]u8 = undefined;
    cl_state_path(CV_CP_LEAF_TMP, tmp[0..320]);
    cl_state_path(CV_CP_LEAF, fin[0..320]);
    const fd : i32 = sys_creat(tmp[0..320], 384);
    if (fd < 0) { return false; }
    const w : i64 = sys_write(fd, t[0..96], @as(u64, n));
    sys_close(fd);
    if (w != @as(i64, @intCast(n))) { return false; }
    return sys_rename(tmp[0..320], fin[0..320]) == 0;
}

/// Open the session on the configured port or, when it is taken, on the next of at most CV_PORT_TRIES (call_view
/// cv_port_plan: the base, the saved port, the rest); the port that opened goes to CL_ME_PORT and to the file, the
/// ports that did not to CL_PBUSY. True when one opened.
fn cl_port_open(cl: []u8, s: []u8, me: []const u8, bind: u64, base: u64, audio: u32) -> bool {
    var plan : [10]u64 = undefined;
    const np : usize = cv_port_plan(base, cl_port_saved(), plan[0..CV_PORT_TRIES]);
    var st : [3]u64 = undefined;
    st[CV_PS_USED] = 0;
    st[CV_PS_BUSY] = 0;
    st[CV_PS_TRIED] = 0;
    var i : usize = 0;
    var go : bool = np > 0;
    while (go and i < np) {
        const ok : bool = cs_open(s, me, bind, plan[i], audio);
        go = cv_port_step(st[0..CV_PS_LEN], base, plan[i], ok);
        i = i + 1;
    }
    cl_put_port(cl, CL_PBUSY, st[CV_PS_BUSY]);
    cl[CL_PTRIED] = @as(u8, @intCast(st[CV_PS_TRIED] & 255));
    if (st[CV_PS_USED] == 0) { return false; }
    cl_put_port(cl, CL_ME_PORT, st[CV_PS_USED]);
    cl_port_save(st[0..CV_PS_LEN]);
    return true;
}

/// Why the last call ended, one fixed line per call_session reason.
pub fn cl_reason_text(r: u32) -> str {
    if (r == CS_R_HANGUP) { return "You ended the call."; }
    if (r == CS_R_PEER_BYE) { return "The other side ended the call."; }
    if (r == CS_R_DECLINED) { return "The other side declined."; }
    if (r == CS_R_I_DECLINED) { return "You declined."; }
    if (r == CS_R_CANCELLED) { return "The caller cancelled."; }
    if (r == CS_R_NO_ANSWER) { return "No answer."; }
    if (r == CS_R_I_SAID_DIFFER) { return "You said the codes differ. Nothing was sent."; }
    if (r == CS_R_PEER_SAID_DIFFER) { return "The other side said the codes differ. Nothing was sent."; }
    if (r == CS_R_NOT_CONFIRMED) { return "The codes were not confirmed in time."; }
    if (r == CS_R_PEER_SILENT) { return "The other side went silent."; }
    if (r == CS_R_ERROR) { return "The call failed."; }
    if (r == CS_R_COMMITMENT) { return "The other side's key did not match its commitment."; }
    if (r == CS_R_AUDIO) { return "The microphone or the speakers could not start."; }
    if (r == CS_R_IDENTITY) { return "Refused: this is not the key stored for this friend."; }
    if (r == CS_R_UNVERIFIED) { return "Not verified yet: call once and compare the code."; }
    if (r == CS_R_INVITE) { return "Someone who is not your friend wrote: see INVITATIONS in ACCOUNT."; }
    if (r == CS_R_RATE) { return "Too many attempts: five codes did not match. Calls wait a minute."; }
    return "";
}

// Test aids that stand in for a person's step (owner, 2026-10-23): T27OS_CALL_AUTOTEST (answers and says "match"),
// T27OS_ID_RESTORE and T27OS_ID_CONFIRM=yes (open and replace the identity) act only when T27OS_QA=1 is set too.
// Without it they are ignored and one stderr line at launch names the ones that were set.

/// T27OS_QA reads exactly "1".
pub fn qa_on(v: []const u8, n: usize) -> bool { return n == 1 and v.len >= 1 and v[0] == 49; }

/// A test aid acts: it is set and QA is on.
pub fn qa_aid(qa: bool, set: bool) -> bool { return qa and set; }

/// The launch line for test aids set without QA ("QA off (T27OS_QA is not 1): ignored T27OS_CALL_AUTOTEST ..."), its
/// length; 0 when QA is on or none is set.
pub fn qa_note(qa: bool, auto: bool, restore: bool, confirm: bool, out: []u8) -> usize {
    if (qa or !(auto or restore or confirm) or out.len < 128) { return 0; }
    var n : usize = put_bytes(out, 0, "QA off (T27OS_QA is not 1): ignored");
    if (auto) { n = put_bytes(out, n, " T27OS_CALL_AUTOTEST"); }
    if (restore) { n = put_bytes(out, n, " T27OS_ID_RESTORE"); }
    if (confirm) { n = put_bytes(out, n, " T27OS_ID_CONFIRM"); }
    return put_bytes(out, n, "\n");
}

/// T27OS_QA from the environment.
fn qa_env() -> bool {
    var e : [8]u8 = undefined;
    const n : usize = cl_env("T27OS_QA", e[0..8]);
    return qa_on(e[0..8], n);
}

/// At launch, before anything is written: ~/.t27os made 0700, or one an older build made 0755 set to 0700 (audit P2,
/// owner 2026-10-23). The chmod result, -1 without HOME.
fn home_private() -> i32 {
    var d : [320]u8 = undefined;
    if (cl_state_path("", d[0..320]) == 0) { return -1; }
    sys_mkdir(d[0..320], T27OS_HOME_MODE);
    return sys_chmod(d[0..320], T27OS_HOME_MODE);
}

/// At launch, before the identity opens: the one line when test aids are set without QA.
fn qa_boot() -> void {
    var e : [8]u8 = undefined;
    const auto : bool = cl_env("T27OS_CALL_AUTOTEST", e[0..8]) > 0;
    const restore : bool = cl_env("T27OS_ID_RESTORE", e[0..8]) > 0;
    const confirm : bool = cl_env("T27OS_ID_CONFIRM", e[0..8]) > 0;
    var line : [128]u8 = undefined;
    const n : usize = qa_note(qa_env(), auto, restore, confirm, line[0..128]);
    if (n > 0) { sys_write(2, line[0..n], @as(u64, n)); }
}

/// How many bytes of a variable of length n are copied into a buffer of cap bytes: at most 31, never past cap.
pub fn cl_env_cap(n: u64, cap: usize) -> u64 {
    var m : u64 = n;
    if (m > 31) { m = 31; }
    if (m > @as(u64, cap)) { m = @as(u64, cap); }
    return m;
}

/// An environment variable (at most 31 bytes, cut at out.len) into out; its length, 0 when unset.
fn cl_env(name: []const u8, out: []u8) -> usize {
    const a : u64 = sys_getenv(name);
    if (a == 0) { return 0; }
    var n : u64 = sys_strlen(a);
    n = cl_env_cap(n, out.len);
    sys_peek(out, a, n);
    return @as(usize, @intCast(n));
}

/// Video in a call is on unless the variable reads exactly "0" (unset, "1" or anything else: on).
pub fn cl_video_on(e: []const u8, n: usize) -> bool {
    return !(n == 1 and e.len >= 1 and e[0] == 48);
}

/// Decimal digits only, 1..65535; 0 otherwise.
pub fn cl_port_of(t: []const u8, n: usize) -> u64 {
    if (n == 0 or n > 5) { return 0; }
    var v : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (t[i] < 48 or t[i] > 57) { return 0; }
        v = v * 10 + @as(u64, t[i] - 48);
        i = i + 1;
    }
    if (v > 65535) { return 0; }
    return v;
}

/// Launch: where this window listens, the audio mode, the session opened once. A refused address, or ten taken ports
/// (cl_port_open), leaves calls off with a note; nothing else depends on it.
pub fn cl_boot(cl: []u8, s: []u8) -> void {
    var e : [32]u8 = undefined;
    var n : usize = cl_env("T27OS_CALL_BIND", e[0..32]);
    const bind : u64 = cv_bind_parse(e[0..32], n);
    const bclass : u32 = cv_bind_class(bind);
    if (bclass == CV_B_ANY) { cl[CL_ANY] = 1; }
    n = cl_env("T27OS_ALLOW_PUBLIC", e[0..32]);
    if (n == 1 and e[0] == 49) { cl[CL_PUBENV] = 1; }
    var port : u64 = CV_PORT;
    n = cl_env("T27OS_CALL_PORT", e[0..32]);
    if (n > 0) { port = cl_port_of(e[0..32], n); }
    cl_put_ip(cl, CL_ME_IP, bind);
    cl_put_port(cl, CL_ME_PORT, port);
    cl_put_port(cl, CL_BPORT, port);
    var e6 : [64]u8 = undefined;
    n = cl_env("T27OS_CALL_PEER", e6[0..64]);
    if (n > 0 and n <= IP6_TEXT_MAX) {
        var i : usize = 0;
        while (i < n and ip6_addr_char(@as(u32, e6[i]))) {
            cl[CL_V6_TXT + i] = e6[i];
            i = i + 1;
        }
        cl[CL_V6_ALEN] = @as(u8, @intCast(i));
    }
    if (qa_env()) { cl[CL_V6_QA] = 1; }
    // test aid (T27OS_QA=1 only): T27OS_CALL_DIAL_AFTER=<s> dials the CALL field once, s seconds after launch, with the
    // key of T27OS_CALL_AUTODIAL in the add field, as CALL pressed by a person would (the rules of the address apply)
    n = cl_env("T27OS_CALL_DIAL_AFTER", e[0..32]);
    if (n > 0 and cl[CL_V6_QA] != 0) {
        var ki : [32]u8 = undefined;
        if (cl_env("T27OS_CALL_AUTODIAL", ki[0..32]) == INVITE_LEN) {
            var j : usize = 0;
            while (j < INVITE_LEN) {
                cl[FV_TYPED + j] = ki[j];
                j = j + 1;
            }
            cl[FV_INVLEN] = @as(u8, @intCast(INVITE_LEN));
            cl_put32(cl, CL_V6_DIALAT, cn_ms32(ckh_ms() + cl_port_of(e[0..32], n) * 1000));
        }
    }
    if (bclass == CV_B_NO or port == 0) {
        cl[CL_NOTE] = @as(u8, @intCast(CV_N_BIND));
        return;
    }
    var audio : u32 = CS_AUDIO_DEV;
    if (cl_env("T27OS_CALL_STATS", e[0..32]) > 0) { cl[CL_STATS] = 1; }
    // test aid, not product behavior: off unless the variable is set, and then only with T27OS_QA=1
    if (qa_aid(qa_env(), cl_env("T27OS_CALL_AUTOTEST", e[0..32]) > 0)) { cl[CL_AUTO] = 1; }
    // video: on unless T27OS_CALL_VIDEO=0 (the camera, the test generator of call_vid.t27 until it is allowed)
    n = cl_env("T27OS_CALL_VIDEO", e[0..32]);
    if (cl_video_on(e[0..32], n)) { cl[CL_VSEND] = 1; }
    // the camera is the source of a call's video unless T27OS_CALL_CAMERA=0
    n = cl_env("T27OS_CALL_CAMERA", e[0..32]);
    if (n == 1 and e[0] == 48) { cl[CL_CAMOFF] = 1; }
    n = cl_env("T27OS_CALL_AUDIO", e[0..32]);
    if (n == 4 and e[0] == 116 and e[1] == 101 and e[2] == 115 and e[3] == 116) { audio = CS_AUDIO_TEST; }
    // test aid: T27OS_CALL_AUDIO=tone is a quiet triangle wave that names its sender, mixed by a software speaker
    if (n == 4 and e[0] == 116 and e[1] == 111 and e[2] == 110 and e[3] == 101) { audio = CS_AUDIO_TONE; }
    // the fingerprint of this device's identity is the one the call frames name (a call is addressed to a key); a
    // damaged identity file is left as found and calls stay off
    var me : [10]u8 = undefined;
    if (!fe_identity(cl, me[0..10])) {
        cl[CL_NOTE] = @as(u8, @intCast(FN_IDENT));
        return;
    }
    if (cl_port_open(cl, s, me[0..10], bind, port, audio)) {
        // the port that opened is the one listened on and announced (TXT `port`), the base when it was free
        port = cl_me_port(cl);
        cl[CL_UP] = 1;
        // the identity key pair signs this device's part of every call (peer_identity: the key the friends stored)
        cs_identity(s, cl[FE_ID + ID_OFF_PUB .. FE_ID + ID_OFF_PUB + 65], cl[FE_ID + ID_OFF_PRIV .. FE_ID + ID_OFF_PRIV + 97]);
        // group call test aids (all off by default): GROUPSTAT lines with T27OS_CALL_STATS, T27OS_GROUP_LEAVE_AFTER=<s>
        // (leave that many seconds after the group is whole), T27OS_GROUP_AUTO (the group's further links answer and
        // confirm by themselves, like AUTOTEST does for the first), T27OS_CALL_TONE_AMP=<100..32767>
        if (cl[CL_STATS] != 0) { cs_set(s, CS_K_GSTATS, 1); }
        if (cl[CL_AUTO] != 0) { cs_set(s, CS_K_GAUTO, 1); }
        // a public address in a group's member list is called only under the same explicit allow as a typed one
        if (cl[CL_PUBENV] != 0) { cs_set(s, CS_K_ALLOW_PUB, 1); }
        // test aid: the IPv6 loopback ::1 may call and be called only with T27OS_QA=1 (call_ip6 ip6_dial_decide)
        if (cl[CL_V6_QA] != 0) { cs_set(s, CS_K_LOOP6, 1); }
        if (cl[CL_VSEND] != 0) {
            cs_set(s, CS_K_VIDEO, 1);
            // the test picture is encoded on its own queue, never in this loop's poll (no block: in the poll, as before)
            const vq : u64 = vgq_new();
            if (vq != 0) { cs_video_encoder(s, vq); }
            cl_put32(cl, CL_VENC, vq & 4294967295);
            cl_put32(cl, CL_VENC + 4, vq >> 32);
        }
        n = cl_env("T27OS_GROUP_LEAVE_AFTER", e[0..32]);
        if (n > 0) { cs_set(s, CS_K_GLEAVE_S, cl_port_of(e[0..32], n)); }
        n = cl_env("T27OS_CALL_TONE_AMP", e[0..32]);
        if (n > 0) { cs_set(s, CS_K_TONE_AMP, cl_port_of(e[0..32], n)); }
        rt_init(cl[FE_TONE .. FE_TONE + RT_BLOCK]);
        ug_listen(cl, bind);
        fe_net(cl, bind, port);
        cn_boot(cl);
    } else if (cl[CL_PTRIED] > 1) {
        cl[CL_NOTE] = @as(u8, @intCast(CV_N_PORTS));
    } else {
        cl[CL_NOTE] = @as(u8, @intCast(CV_N_SOCKET));
    }
}

// ======================================================================================================
// CN. Beyond the home network (owner, 2026-10-23; call_nat.t27 decides, this block moves the bytes; Refs
// dmitrii-f-t27/t27#13). With no T27OS_CALL_BIND the call socket listens on every interface (call_view section 7);
// cn_tick asks the system every CN_LAN_MS which address this Mac sends from (cl_lan_probe: connect on a UDP socket to
// 192.0.2.1, the documentation network, which sends nothing, then getsockname) so the panels can say
// "listening on <address>:<port>". The STUN lookup runs only when the person asks for it (LOOK UP on the PUBLIC line,
// or T27OS_STUN=1 at launch): the system resolver for CN_STUN_HOST (DNSServiceGetAddrInfo, pumped here, never
// blocking the loop), then the Binding request from the call socket (call_session cs_stun_send) on the schedule of
// cn_stun_step, the answer taken by cs_poll; while shown, asked again on cn_keep's schedule. The punch: probes to a
// target on cn_punch_due's schedule. Every change of the PUBLIC state and every new probe received is one line on
// stderr ("NATSTAT ...", "NATPROBE ...") that names ports and counts, never an address.
// ======================================================================================================

/// The 16-bit and 32-bit words of the CN part (big-endian ports, little-endian times).
fn cn_port_at(cl: []const u8, at: usize) -> u64 { return (@as(u64, cl[at]) << 8) | @as(u64, cl[at + 1]); }

/// The public address shown (ip * 65536 + port; 0 = none).
pub fn cl_nat_pub(cl: []const u8) -> u64 { return cl_ip(cl, CL_N_PUB) * 65536 + cn_port_at(cl, CL_N_PUB + 4); }

fn cn_put_addr(cl: []u8, at: usize, a: u64) -> void {
    cl_put_ip(cl, at, a / 65536);
    cl_put_port(cl, at + 4, a % 65536);
}

fn cn_addr_at(cl: []const u8, at: usize) -> u64 { return cl_ip(cl, at) * 65536 + cn_port_at(cl, at + 4); }

/// ms clock folded to 32 bits for the CN part, never 0 (0 means "not set").
fn cn_ms32(now: u64) -> u64 {
    const v : u64 = now & 4294967295;
    if (v == 0) { return 1; }
    return v;
}

/// ms since a 32-bit stamp taken by cn_ms32 (the clock wraps every 49 days: the difference is taken modulo 2^32).
fn cn_ago(now: u64, at: u64) -> u64 { return ((now & 4294967295) + 4294967296 - at) & 4294967295; }

/// The address this Mac sends from on its default route (call_view cv_lan_pick), 0 when there is none. A UDP connect
/// only picks the route: no datagram leaves.
fn cl_lan_probe() -> u64 {
    const fd : i32 = sys_socket(2, 2, 0);
    if (fd < 0) { return 0; }
    var a : [16]u8 = undefined;
    ckh_addr4(a[0..16], 3221225985, 9);
    if (sys_connect(fd, a[0..16], 16) != 0) {
        sys_close(fd);
        return 0;
    }
    var sa : [16]u8 = undefined;
    var ln : [4]u8 = undefined;
    ln[0] = 16; ln[1] = 0; ln[2] = 0; ln[3] = 0;
    const r : i32 = uh_getsockname(fd, sa[0..16], ln[0..4]);
    sys_close(fd);
    if (r != 0) { return 0; }
    return cv_lan_pick((@as(u64, sa[4]) << 24) | (@as(u64, sa[5]) << 16) | (@as(u64, sa[6]) << 8) | @as(u64, sa[7]));
}

/// getifaddrs(3) / freeifaddrs(3) and the fixed-argument ioctl stub (pty_sys uses it for TIOCSWINSZ).
fn cn6_getifaddrs(out: []u8) -> i32 { return @extern("getifaddrs"); }
fn cn6_freeifaddrs(p: u64) -> void { return @extern("freeifaddrs"); }
fn cn6_ioctl(fd: i32, req: u64, arg: []u8) -> i32 { return @extern("__ioctl"); }
/// SIOCGIFAFLAG_IN6 (_IOWR('i', 73, struct in6_ifreq), 288 bytes): an IPv6 address's flags (netinet6/in6_var.h).
pub const CN6_SIOCGIFAFLAG : u64 = 3240126793;
pub const CN6_IFREQ : usize = 288;

/// This device's own IPv6 to give a friend (call_ip6 ip6_own_rank: a stable secured global address first, then a
/// stable one, then a temporary one; never a tunnel, a deprecated or a CLAT46 address), with the call port, into ep
/// (18 bytes, cleared when there is none). Its rank, 0 = none. Read from the interfaces: no datagram leaves.
fn cn6_own(port: u64, ep: []u8) -> u32 {
    ip6_clear(ep);
    var head : [8]u8 = undefined;
    if (cn6_getifaddrs(head[0..8]) != 0) { return 0; }
    const first : u64 = upv_get64(head[0..8], 0);
    const fd : i32 = sys_socket(30, 2, 0);
    var best : u32 = 0;
    var p : u64 = first;
    var k : u32 = 0;
    while (p != 0 and k < 256) {
        var ia : [32]u8 = undefined;
        sys_peek(ia[0..32], p, 32);
        const ap : u64 = upv_get64(ia[0..32], 24);
        const iff : u64 = upv_get64(ia[0..32], 16) & 4294967295;
        if (ap != 0 and fd >= 0) {
            var sa : [28]u8 = undefined;
            sys_peek(sa[0..2], ap, 2);
            if (sa[1] == 30) {
                sys_peek(sa[0..28], ap, 28);
                var rq : [288]u8 = undefined;
                var z : usize = 0;
                while (z < CN6_IFREQ) {
                    rq[z] = 0;
                    z = z + 1;
                }
                // the interface name, a byte at a time up to its NUL (at most IFNAMSIZ - 1)
                const np : u64 = upv_get64(ia[0..32], 8);
                var i : usize = 0;
                while (np != 0 and i < 15) {
                    sys_peek(rq[i..i + 1], np + @as(u64, i), 1);
                    if (rq[i] == 0) { break; }
                    i = i + 1;
                }
                i = 0;
                while (i < 28) {
                    rq[16 + i] = sa[i];
                    i = i + 1;
                }
                if (cn6_ioctl(fd, CN6_SIOCGIFAFLAG, rq[0..CN6_IFREQ]) == 0) {
                    const af : u64 = upv_get64(rq[0..CN6_IFREQ], 16) & 4294967295;
                    const r : u32 = ip6_own_rank(sa[8..24], af, iff);
                    if (r > best) {
                        best = r;
                        i = 0;
                        while (i < 16) {
                            ep[i] = sa[8 + i];
                            i = i + 1;
                        }
                    }
                }
            }
        }
        p = upv_get64(ia[0..32], 0);
        k = k + 1;
    }
    if (fd >= 0) { sys_close(fd); }
    cn6_freeifaddrs(first);
    if (best == 0) { return 0; }
    ep[16] = @as(u8, @intCast((port >> 8) & 255));
    ep[17] = @as(u8, @intCast(port & 255));
    return best;
}

/// The PUBLIC v6 line was clicked: "[address]:port" to the clipboard, and the line says "copied" for a moment.
pub fn cn6_copy(cl: []u8) -> void {
    if (cl[CL_UP] == 0 or cl[CL_V6_OWNR] == 0) { return; }
    var t : [64]u8 = undefined;
    const n : usize = ip6_text(cl[CL_V6_OWN .. CL_V6_OWN_END], t[0..64]);
    if (n == 0) { return; }
    pb_copy(t[0..n], n);
    cl[CL_V6_COPIED] = 1;
    cl_put32(cl, CL_V6_COPYT, cn_ms32(ckh_ms()));
}

/// At launch, once the call socket is open: T27OS_STUN=1 asks for the lookup (the person's choice, said on stderr);
/// T27OS_PUNCH=<a.b.c.d:port> (a test aid, only with T27OS_QA=1) starts a punch toward that address.
fn cn_boot(cl: []u8) -> void {
    var e : [32]u8 = undefined;
    var n : usize = cl_env("T27OS_STUN", e[0..32]);
    if (n == 1 and e[0] == 49) {
        cl[CL_N_REQ] = 1;
        sys_write(2, "NATSTAT T27OS_STUN=1: this device asks stun.l.google.com for its public address\n", 81);
    }
    var e6 : [64]u8 = undefined;
    n = cl_env("T27OS_PUNCH", e6[0..64]);
    if (n > 0) {
        // <a.b.c.d:port> or [v6]:port (call_ip6 ip6_parse)
        var ep : [18]u8 = undefined;
        const okp : bool = n <= IP6_TEXT_MAX and ip6_parse(e6[0..64], n, ep[0..18]);
        if (qa_env() == false) {
            sys_write(2, "QA off (T27OS_QA is not 1): ignored T27OS_PUNCH\n", 49);
        } else if (okp and ip6_mapped(ep[0..18]) and cn_punch_ok(ip6_v4of(ep[0..18]))) {
            cn_punch_start(cl, ip6_v4of(ep[0..18]), ckh_ms());
        } else if (okp and !ip6_mapped(ep[0..18]) and ip6_punch_ok(ep[0..18], cl[CL_V6_QA] != 0)) {
            cn_punch_start6(cl, ep[0..18], ckh_ms());
            sys_write(2, "NATPROBE T27OS_PUNCH toward an IPv6 address\n", 44);
        } else {
            sys_write(2, "NATPROBE T27OS_PUNCH refused: not an address a probe may go to\n", 64);
        }
    }
}

/// Start (or restart) a punch toward a.
fn cn_punch_start(cl: []u8, a: u64, now: u64) -> void {
    cn_put_addr(cl, CL_N_PT, a);
    cl[CL_V6_P6] = 0;
    cl[CL_N_PSENT] = 0;
    cl_put32(cl, CL_N_PT0, cn_ms32(now));
}

/// Start (or restart) a punch toward the IPv6 endpoint ep: the same schedule (call_nat cn_punch_due).
fn cn_punch_start6(cl: []u8, ep: []const u8, now: u64) -> void {
    ip6_copy(cl[CL_V6_PT .. CL_V6_PT + IP6_EP], ep);
    cl[CL_V6_P6] = 1;
    cl[CL_N_PSENT] = 0;
    cl_put32(cl, CL_N_PT0, cn_ms32(now));
}

/// LOOK UP pressed (the PUBLIC line): taken by the next cn_tick when a lookup may be asked for.
pub fn cn_ask(cl: []u8) -> void {
    if (cl[CL_UP] != 0 and cn_can_ask(@as(u32, cl[CL_N_ST]))) { cl[CL_N_REQ] = 1; }
}

/// One NATSTAT line: the state, the public port (never the address), whether the public IP is the one this Mac sends
/// from (no router in between), the answers taken and refused, the probes received.
fn cn_say(cl: []const u8, s: []const u8) -> void {
    var line : [200]u8 = undefined;
    var n : usize = put_bytes(line[0..200], 0, "NATSTAT st=");
    n = put_dec(line[0..200], n, @as(u64, cl[CL_N_ST]));
    const a : u64 = cl_nat_pub(cl);
    n = put_bytes(line[0..200], n, " public_port=");
    n = put_dec(line[0..200], n, a % 65536);
    n = put_bytes(line[0..200], n, " local_port=");
    n = put_dec(line[0..200], n, cl_me_port(cl));
    n = put_bytes(line[0..200], n, " public_is_lan=");
    var same : u64 = 0;
    if (a != 0 and a / 65536 == cl_ip(cl, CL_N_LAN)) { same = 1; }
    n = put_dec(line[0..200], n, same);
    n = put_bytes(line[0..200], n, " lan=");
    var hl : u64 = 0;
    if (cl_ip(cl, CL_N_LAN) != 0) { hl = 1; }
    n = put_dec(line[0..200], n, hl);
    n = put_bytes(line[0..200], n, " rx=");
    n = put_dec(line[0..200], n, cs_nat(s, CS_N_RX));
    n = put_bytes(line[0..200], n, " refused=");
    n = put_dec(line[0..200], n, cs_nat(s, CS_N_BAD));
    n = put_bytes(line[0..200], n, " probes_in=");
    n = put_dec(line[0..200], n, cs_nat(s, CS_N_PROBES));
    n = put_bytes(line[0..200], n, " probes_out=");
    n = put_dec(line[0..200], n, @as(u64, cl[CL_N_PSENT]));
    n = put_bytes(line[0..200], n, " probes_in6=");
    n = put_dec(line[0..200], n, cs_nat(s, CS_N_P6));
    n = put_bytes(line[0..200], n, " probes_out6=");
    n = put_dec(line[0..200], n, cs_nat(s, CS_N_P6TX));
    n = put_bytes(line[0..200], n, " own6=");
    n = put_dec(line[0..200], n, @as(u64, cl[CL_V6_OWNR]));
    n = put_bytes(line[0..200], n, "\n");
    sys_write(2, line[0..200], @as(u64, n));
}

/// A new round of requests to the server already known: a fresh transaction id, nothing sent yet.
fn cn_round(cl: []u8, now: u64) -> bool {
    var t : [12]u8 = undefined;
    if (!ckh_rand(t[0..12])) { return false; }
    var i : usize = 0;
    while (i < CN_TXID) {
        cl[CL_N_TX + i] = t[i];
        i = i + 1;
    }
    cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_STUN));
    cl[CL_N_SENT] = 0;
    cl_put32(cl, CL_N_T0, cn_ms32(now));
    return true;
}

/// Every loop pass: the address this Mac sends from (every CN_LAN_MS), the lookup's next step, the refresh, the punch.
pub fn cn_tick(cl: []u8, s: []u8, nb: []u8, now: u64) -> void {
    if (nb.len < CN_NB_LEN) { return; }
    if (cl_get32(cl, CL_N_LANT) == 0 or cn_ago(now, cl_get32(cl, CL_N_LANT)) >= CN_LAN_MS) {
        cl_put_ip(cl, CL_N_LAN, cl_lan_probe());
        cl_put32(cl, CL_N_LANT, cn_ms32(now));
    }
    if (cl[CL_UP] == 0) {
        if (cl[CL_N_ST] != @as(u8, @intCast(CN_S_NOSOCK))) { cl[CL_N_ST] = @as(u8, @intCast(CN_S_NOSOCK)); }
        return;
    }
    if (cl[CL_N_ST] == @as(u8, @intCast(CN_S_NOSOCK))) { cl[CL_N_ST] = @as(u8, @intCast(CN_S_NONE)); }
    var st : u32 = @as(u32, cl[CL_N_ST]);
    const run : u32 = @as(u32, cl[CL_N_RUN]);
    // LOOK UP: the resolver first, every time the person asks (the server's address may have moved)
    if (cl[CL_N_REQ] != 0 and run == CN_RUN_IDLE) {
        cl[CL_N_REQ] = 0;
        cl_put32(cl, CL_N_ASK, cn_ms32(now));
        var k : usize = 0;
        while (k < CN_NB_LEN) {
            nb[k] = 0;
            k = k + 1;
        }
        put_bytes(nb[0..CN_NB_LEN], BE_HOST, CN_STUN_HOST);
        if (ih_addrinfo(nb[CN_NB_REF .. CN_NB_REF + 8], ih_addr(nb[0..BE_LEN])) == 0) {
            cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_DNS));
            cl_put32(cl, CL_N_T0, cn_ms32(now));
            st = CN_S_DNS;
        } else {
            st = CN_S_NODNS;
        }
    } else if (run == CN_RUN_DNS) {
        const ref : u64 = cl_get32(nb, CN_NB_REF) | (cl_get32(nb, CN_NB_REF + 4) << 32);
        ih_pump(ref, 0);
        if (nb[BE_STATE] == @as(u8, @intCast(BS_ADDRESSED))) {
            ih_free(ref);
            cl_put32(nb, CN_NB_REF, 0);
            cl_put32(nb, CN_NB_REF + 4, 0);
            const ip : u64 = (@as(u64, nb[BE_IP]) << 24) | (@as(u64, nb[BE_IP + 1]) << 16) | (@as(u64, nb[BE_IP + 2]) << 8) | @as(u64, nb[BE_IP + 3]);
            cn_put_addr(cl, CL_N_SRV, ip * 65536 + CN_STUN_PORT);
            if (cn_round(cl, now)) {
                if (st != CN_S_OK) { st = CN_S_ASK; }
            } else {
                cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_IDLE));
                st = CN_S_NOANSWER;
            }
        } else if (cn_ago(now, cl_get32(cl, CL_N_T0)) >= CN_DNS_MS) {
            ih_free(ref);
            cl_put32(nb, CN_NB_REF, 0);
            cl_put32(nb, CN_NB_REF + 4, 0);
            cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_IDLE));
            st = CN_S_NODNS;
        }
    } else if (run == CN_RUN_STUN) {
        const t0 : u64 = cl_get32(cl, CL_N_T0);
        const at : u64 = cs_nat(s, CS_N_AT);
        if (at != 0 and cs_nat(s, CS_N_PUB) != 0 and cn_ago(at, t0) < 2147483648) {
            // the answer came after this round started
            cn_put_addr(cl, CL_N_PUB, cs_nat(s, CS_N_PUB));
            cl_put32(cl, CL_N_TOK, cn_ms32(at));
            cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_IDLE));
            st = CN_S_OK;
        } else {
            const d : u32 = cn_stun_step(cn_ago(now, t0), @as(u32, cl[CL_N_SENT]));
            if (d == CN_SS_SEND) {
                const srv : u64 = cn_addr_at(cl, CL_N_SRV);
                cs_stun_send(s, cl[CL_N_TX .. CL_N_TX + CN_TXID], srv / 65536, srv % 65536);
                cl[CL_N_SENT] = cl[CL_N_SENT] + 1;
            } else if (d == CN_SS_GIVEUP) {
                cl[CL_N_RUN] = @as(u8, @intCast(CN_RUN_IDLE));
                // a refresh that got no answer: the shown address may have changed
                if (st == CN_S_OK) { st = CN_S_STALE; } else { st = CN_S_NOANSWER; }
            }
        }
    } else if (st == CN_S_OK) {
        const k2 : u32 = cn_keep(cn_ago(now, cl_get32(cl, CL_N_ASK)), cn_ago(now, cl_get32(cl, CL_N_TOK)));
        if (k2 == CN_K_STALE) {
            st = CN_S_STALE;
        } else if (k2 == CN_K_REFRESH) {
            cn_round(cl, now);
        }
    }
    if (st == CN_S_OK or st == CN_S_STALE) {
        var m : u64 = cn_ago(now, cl_get32(cl, CL_N_TOK)) / 60000;
        if (m > 255) { m = 255; }
        cl[CL_N_MIN] = @as(u8, @intCast(m));
    }
    cl[CL_N_ST] = @as(u8, @intCast(st));
    // the punch
    const pt0 : u64 = cl_get32(cl, CL_N_PT0);
    if (pt0 != 0) {
        const el : u64 = cn_ago(now, pt0);
        if (cn_punch_due(el, @as(u64, cl[CL_N_PSENT]))) {
            var sent : bool = false;
            if (cl[CL_V6_P6] != 0) { sent = cs_probe_send6(s, cl[CL_V6_PT .. CL_V6_PT + IP6_EP]); } else { sent = cs_probe_send(s, cn_addr_at(cl, CL_N_PT)); }
            if (sent) { cl[CL_N_PSENT] = cl[CL_N_PSENT] + 1; } else { cl_put32(cl, CL_N_PT0, 0); }
        } else if (el >= 30000) {
            cl_put32(cl, CL_N_PT0, 0);
            cn_say(cl, s);
        }
    }
    const pin : u64 = cs_nat(s, CS_N_PROBES);
    if (pin != cl_get32(cl, CL_N_PSAID)) {
        cl_put32(cl, CL_N_PSAID, pin);
        var pl : [96]u8 = undefined;
        var pn : usize = put_bytes(pl[0..96], 0, "NATPROBE in=");
        pn = put_dec(pl[0..96], pn, pin);
        pn = put_bytes(pl[0..96], pn, " in6=");
        pn = put_dec(pl[0..96], pn, cs_nat(s, CS_N_P6));
        pn = put_bytes(pl[0..96], pn, " from_port=");
        pn = put_dec(pl[0..96], pn, cs_nat(s, CS_N_PFROM) % 65536);
        pn = put_bytes(pl[0..96], pn, "\n");
        sys_write(2, pl[0..96], @as(u64, pn));
    }
    // IP6. this device's own IPv6 (every CN_LAN_MS, as the IPv4 above), and "copied" goes after CL_V6_COPY_MS
    if (cl_get32(cl, CL_V6_OWNT) == 0 or cn_ago(now, cl_get32(cl, CL_V6_OWNT)) >= CN_LAN_MS) {
        cl[CL_V6_OWNR] = @as(u8, @intCast(cn6_own(cl_me_port(cl), cl[CL_V6_OWN .. CL_V6_OWN_END])));
        cl_put32(cl, CL_V6_OWNT, cn_ms32(now));
    }
    if (cl[CL_V6_COPIED] != 0 and cn_ago(now, cl_get32(cl, CL_V6_COPYT)) >= CL_V6_COPY_MS) { cl[CL_V6_COPIED] = 0; }
    if (cl[CL_N_SAID] != cl[CL_N_ST]) {
        cl[CL_N_SAID] = cl[CL_N_ST];
        cn_say(cl, s);
    }
}

/// The CALL panel's first line: "ONLINE  listening on 192.168.15.8:47727" (call_view cv_listen_text), with the taken
/// port after it as cl_port_status says it; the port status alone while calls are off.
pub fn cl_listen_status(cl: []const u8, out: []u8) -> usize {
    if (cl[CL_UP] == 0 or out.len < 160) { return cl_port_status(cl, out); }
    var n : usize = put_bytes(out, 0, "ONLINE  ");
    n = n + cv_listen_text(cl_ip(cl, CL_ME_IP), cl_ip(cl, CL_N_LAN), cl_me_port(cl), out[n..out.len]);
    var b : [96]u8 = undefined;
    const bn : usize = cl_port_busy_line(cl, b[0..96]);
    if (bn > 0 and n + 2 + bn <= out.len) {
        n = put_bytes(out, n, "  ");
        n = put_bytes(out, n, b[0..bn]);
    }
    return n;
}

/// One decimal field of the stats line.
fn cl_stat_num(label: []const u8, v: u64) -> void {
    var d : [24]u8 = undefined;
    var i : usize = 24;
    var x : u64 = v;
    if (x == 0) { i = i - 1; d[i] = 48; }
    while (x > 0 and i > 0) {
        i = i - 1;
        d[i] = @as(u8, @intCast(48 + (x % 10)));
        x = x / 10;
    }
    sys_write(2, label, @as(u64, label.len));
    sys_write(2, d[i..24], @as(u64, 24 - i));
}

/// T27OS_PERF: user + system CPU of this process in nanoseconds (rusage_info_v0 user 16, system 24, in mach time units
/// scaled by the timebase numer / denom); ru keeps the sample for the memory fields; 0 when the call fails.
fn pf_cpu_ns(ru: []u8, tb: []const u8) -> u64 {
    if (pf_rusage(pf_getpid(), 0, ru) != 0) { return 0; }
    const t : u64 = upv_get64(ru, 16) + upv_get64(ru, 24);
    const numer : u64 = @as(u64, tb[0]) + 256 * @as(u64, tb[1]) + 65536 * @as(u64, tb[2]) + 16777216 * @as(u64, tb[3]);
    const denom : u64 = @as(u64, tb[4]) + 256 * @as(u64, tb[5]) + 65536 * @as(u64, tb[6]) + 16777216 * @as(u64, tb[7]);
    if (numer == 0 or denom == 0) { return t; }
    return t / denom * numer;
}

/// T27OS_PERF: one line every FG_PERF_S seconds: loop ticks and draws a second (tenths), children started, CPU per mille
/// of one core, resident and physical footprint in MB (rusage_info_v0 64 and 72), and whether the window is on screen.
fn pf_line(ticks: u64, draws: u64, spawns: u64, cpu: u64, ru: []const u8, secs: f64, vis: bool) -> void {
    var s10 : u64 = @as(u64, @intFromFloat(secs * 10.0));
    if (s10 == 0) { s10 = 1; }
    cl_stat_num("T27OS_PERF ticks_x10/s=", ticks * 100 / s10);
    cl_stat_num(" draws_x10/s=", draws * 100 / s10);
    cl_stat_num(" spawns=", spawns);
    cl_stat_num(" cpu_permille=", cpu);
    cl_stat_num(" rss_mb=", upv_get64(ru, 64) / 1048576);
    cl_stat_num(" footprint_mb=", upv_get64(ru, 72) / 1048576);
    var v : u64 = 0;
    if (vis) { v = 1; }
    cl_stat_num(" visible=", v);
    sys_write(2, "\n", 1);
}

/// T27OS_CALL_STATS: one line a second while ACTIVE, the counters the panel does not show.
fn cl_stats_line(cl: []u8, s: []u8, secs: u64) -> void {
    cl_stat_num("CALLSTAT t=", secs);
    cl_stat_num(" sent=", cs_stat(s, CS_ST_SENT));
    cl_stat_num(" recv=", cs_stat(s, CS_ST_ACCEPTED));
    cl_stat_num(" zero_rx=", cs_stat(s, CS_ST_ZERO_FRAMES));
    cl_stat_num(" muted_sent=", cs_stat(s, CS_ST_MUTED_SENT));
    cl_stat_num(" nonzero_rx=", cs_stat(s, CS_ST_NONZERO_RX));
    cl_stat_num(" abs_sum=", cs_stat(s, CS_ST_ABS_SUM));
    cl_stat_num(" abs_peak=", cs_stat(s, CS_ST_ABS_PEAK));
    cl_stat_num(" capt=", cs_stat(s, 1002));
    cl_stat_num(" under=", cs_stat(s, 1004));
    cl_stat_num(" over=", cs_stat(s, 1005));
    cl_stat_num(" txo=", cs_stat(s, 1007));
    cl_stat_num(" warm=", cs_stat(s, 1015));
    cl_stat_num(" jb=", cs_stat(s, 11948));
    cl_stat_num(" jbmax=", cs_stat(s, 11957));
    cl_stat_num(" grow=", cs_stat(s, 11955));
    cl_stat_num(" shrink=", cs_stat(s, 11956));
    cl_stat_num(" gap=", cs_stat(s, 11958));
    cl_stat_num(" pgap=", cl_get32(cl, CL_GAP));
    cl_stat_num(" p10=", cl_get32(cl, CL_N10));
    cl_stat_num(" ring_cb=", rt_stat(cl[FE_TONE .. FE_TONE + RT_BLOCK], RT_S_CB));
    cl_stat_num(" vlive=", @as(u64, cl[CL_VLIVE]));
    cl_stat_num(" vshown=", cl_get32(cl, CL_VSHOWN));
    cl_stat_num(" vskip=", cl_get32(cl, CL_VSKIP));
    cl_stat_num(" txcam=", cs_vstat(s, CS_V_CAM));
    cl_stat_num(" txgen=", cs_vstat(s, CS_V_GEN));
    cl_stat_num(" txframes=", cs_vstat(s, CS_V_TXFRAMES));
    cl_stat_num(" txencskip=", cs_vstat(s, CS_V_ENCSKIP));
    cl_stat_num(" txpollmax_ms=", cs_vstat(s, CS_V_MAKE_MAX));
    const vq : u64 = cl_get32(cl, CL_VENC) | (cl_get32(cl, CL_VENC + 4) << 32);
    cl_stat_num(" encjobs=", vgq_stat(vq, 1));
    cl_stat_num(" encmax_us=", vgq_stat(vq, 4));
    cl_stat_num(" camst=", @as(u64, cl[CL_CAMST]));
    const cp : u64 = cl_camp(cl);
    cl_stat_num(" camauth=", cvl_stat(cp, 4));
    cl_stat_num(" camans=", cvl_stat(cp, 13));
    cl_stat_num(" camrun=", cvl_stat(cp, 5));
    cl_stat_num(" camcb=", cvl_stat(cp, 0));
    cl_stat_num(" camenc=", cvl_stat(cp, 1));
    cl_stat_num(" camfail=", cvl_stat(cp, 2));
    cl_stat_num(" cambig=", cvl_stat(cp, 3));
    cl_stat_num(" cammean100=", cvl_stat(cp, 6));
    cl_stat_num(" cammeanavg100=", cvl_stat(cp, 7));
    cl_stat_num(" cammin100=", cvl_stat(cp, 8));
    cl_stat_num(" cammax100=", cvl_stat(cp, 9));
    cl_stat_num(" camw=", cvl_stat(cp, 10));
    cl_stat_num(" camh=", cvl_stat(cp, 11));
    cl_stat_num(" camfps=", cl_get32(cl, CL_VH_CAMFPS));
    cl_stat_num(" cam30=", cvl_stat(cp, 19));
    cl_stat_num(" campreset=", cvl_stat(cp, 20));
    cl_stat_num(" camh264=", cvl_stat(cp, 16));
    cl_stat_num(" camh264fail=", cvl_stat(cp, 17));
    // H.264: what this side sends (mode, rung, the ladder's bitrate) and what arrives, the codec's own numbers
    cl_stat_num(" vmode=", cs_vh_stat(s, CS_H_MODE));
    cl_stat_num(" vrung=", cs_vh_stat(s, CS_H_RUNG));
    cl_stat_num(" vkbps_target=", cs_vh_stat(s, CS_H_KBPS));
    cl_stat_num(" vrx_fps=", cs_vh_stat(s, CS_H_RX_FPS));
    cl_stat_num(" vrx_kbps=", cs_vh_stat(s, CS_H_RX_KBPS));
    cl_stat_num(" vrx_w=", cs_vh_stat(s, CS_H_RX_W));
    cl_stat_num(" vrx_h=", cs_vh_stat(s, CS_H_RX_H));
    cl_stat_num(" vrx_done=", cs_vh_stat(s, CS_H_RX_DONE));
    cl_stat_num(" vrx_keys=", cs_vh_stat(s, CS_H_RX_KEYS));
    cl_stat_num(" vrx_lost=", cs_vh_stat(s, CS_H_RX_LOST));
    cl_stat_num(" vrx_dropped=", cs_vh_stat(s, CS_H_RX_DROPPED));
    cl_stat_num(" vrx_held=", cs_vh_stat(s, CS_H_RX_HELD));
    cl_stat_num(" vrx_parts=", cs_vh_stat(s, CS_H_RX_PARTS));
    cl_stat_num(" vrx_refused=", cs_vh_stat(s, CS_H_RX_REFUSED));
    cl_stat_num(" vtx_fps=", cs_vh_stat(s, CS_H_TX_FPS));
    cl_stat_num(" vtx_kbps=", cs_vh_stat(s, CS_H_TX_KBPS));
    cl_stat_num(" vwire_kbps=", cs_vh_stat(s, CS_H_WIRE_KBPS));
    cl_stat_num(" vtx_w=", cs_vh_stat(s, CS_H_TX_W));
    cl_stat_num(" vtx_h=", cs_vh_stat(s, CS_H_TX_H));
    cl_stat_num(" vtx_frames=", cs_vh_stat(s, CS_H_TX_FRAMES));
    cl_stat_num(" vtx_keys=", cs_vh_stat(s, CS_H_TX_KEYS));
    cl_stat_num(" vtx_parts=", cs_vh_stat(s, CS_H_PARTS_TX));
    cl_stat_num(" vtx_stale=", cs_vh_stat(s, CS_H_STALE));
    cl_stat_num(" vtx_hold=", cs_vh_stat(s, CS_H_HOLD));
    cl_stat_num(" vtx_senderr=", cs_vh_stat(s, CS_H_SEND_ERR));
    cl_stat_num(" vkreq_tx=", cs_vh_stat(s, CS_H_KREQ_TX));
    cl_stat_num(" vkreq_rx=", cs_vh_stat(s, CS_H_KREQ_RX));
    cl_stat_num(" vforced=", cs_vh_stat(s, CS_H_FORCED));
    cl_stat_num(" vrep_tx=", cs_vh_stat(s, CS_H_REP_TX));
    cl_stat_num(" vrep_rx=", cs_vh_stat(s, CS_H_REP_RX));
    cl_stat_num(" vhello_tx=", cs_vh_stat(s, CS_H_HELLO_TX));
    cl_stat_num(" vhello_rx=", cs_vh_stat(s, CS_H_HELLO_RX));
    cl_stat_num(" vpeer_fps=", cs_vh_stat(s, CS_H_PEER_FPS));
    cl_stat_num(" vsteps=", cs_vh_stat(s, CS_H_STEPS));
    cl_stat_num(" vdec_err=", cs_vh_stat(s, CS_H_DEC_ERR));
    cl_stat_num(" vdec_busy=", cs_vh_stat(s, CS_H_BUSY));
    const ve : u64 = cl_get64(cl, CL_VH_ENC);
    const vd : u64 = cl_get64(cl, CL_VH_DEC);
    cl_stat_num(" enc_out=", vte_stat(ve, VE_OUT));
    cl_stat_num(" enc_keys=", vte_stat(ve, VE_KEYS));
    cl_stat_num(" enc_drop=", vte_stat(ve, VE_DROP));
    cl_stat_num(" enc_err=", vte_stat(ve, VE_ERR) + vte_stat(ve, VE_BIG) + vte_stat(ve, VE_CFAIL));
    cl_stat_num(" enc_ringfull=", vte_stat(ve, VE_OVER));
    cl_stat_num(" enc_lat_max_us=", vte_stat(ve, VE_LAT_MAX));
    var elm : u64 = 0;
    if (vte_stat(ve, VE_LAT_N) > 0) { elm = vte_stat(ve, VE_LAT_SUM) / vte_stat(ve, VE_LAT_N); }
    cl_stat_num(" enc_lat_mean_us=", elm);
    cl_stat_num(" enc_call_max_us=", vte_stat(ve, VE_CALL_MAX));
    cl_stat_num(" enc_lowlat=", vte_stat(ve, VE_LOWLAT));
    cl_stat_num(" enc_kbps=", vte_stat(ve, VE_KBPS));
    cl_stat_num(" enc_sessions=", vte_stat(ve, VE_CREATES));
    cl_stat_num(" enc_srcw=", vte_stat(ve, VE_SRCW));
    cl_stat_num(" enc_srch=", vte_stat(ve, VE_SRCH));
    cl_stat_num(" dec_out=", vtd_stat(vd, VDK_OUT));
    cl_stat_num(" dec_bad=", vtd_stat(vd, VDK_BAD) + vtd_stat(vd, VDK_DERR));
    cl_stat_num(" dec_sessions=", vtd_stat(vd, VDK_CREATES));
    cl_stat_num(" dec_lat_max_us=", vtd_stat(vd, VDK_LAT_MAX));
    var dlm : u64 = 0;
    if (vtd_stat(vd, VDK_LAT_N) > 0) { dlm = vtd_stat(vd, VDK_LAT_SUM) / vtd_stat(vd, VDK_LAT_N); }
    cl_stat_num(" dec_lat_mean_us=", dlm);
    cl_stat_num(" dec_job_max_us=", vtd_stat(vd, VDK_CALL_MAX));
    cl_stat_num(" dec_post_max_us=", vtd_stat(vd, VDK_POST_MAX));
    cl_stat_num(" dec_replaced=", vtd_stat(vd, VDK_REPL));
    cl_stat_num(" dec_dropped=", vtd_stat(vd, VDK_DROPPED));
    cl_stat_num(" dec_depth=", vtd_depth(vd));
    cl_stat_num(" lay_rx=", cl_get32(cl, CL_VH_RXN));
    cl_stat_num(" lay_self=", cl_get32(cl, CL_VH_SXN));
    cl_stat_num(" lay_vis=", @as(u64, cl[CL_VH_VIS]));
    // IP6: the family in use, the redundant copies sent and taken alone, datagrams too big for IPv6, refused senders
    const fw : []const u8 = ip6_fam_word(@as(u32, @intCast(cs_net(s, CS_NET_FAM) & 255)));
    sys_write(2, " fam=", 5);
    if (fw.len > 0) { sys_write(2, fw, @as(u64, fw.len)); } else { sys_write(2, "none", 4); }
    cl_stat_num(" copy_tx=", cs_net(s, CS_NET_COPY_TX));
    cl_stat_num(" copy_rx=", cs_net(s, CS_NET_COPY_RX));
    cl_stat_num(" big6=", cs_net(s, CS_NET_BIG));
    cl_stat_num(" nofrom6=", cs_net(s, CS_NET_NOFROM));
    sys_write(2, "\n", 1);
}

/// The live camera block, 0 when none.
pub fn cl_camp(cl: []const u8) -> u64 {
    return cl_get32(cl, CL_CAMP) | (cl_get32(cl, CL_CAMP + 4) << 32);
}

/// The camera in a call (call_video.t27): while the call is ACTIVE with video on, the start is queued once (setup and
/// startRunning run on the camera's own queue, the system asks for permission the first time); this pass never waits for
/// it. Until a camera frame comes, when it is refused or when none came in 3 s (FAILED, "camera unavailable"), the test
/// generator is the source; every new camera JPEG while LIVE is handed to cs_video_feed. When the call is over the stop
/// is queued, the camera is free.
pub fn cl_camera(cl: []u8, s: []u8) -> void {
    if (cl[CL_VSEND] == 0 or cl[CL_CAMOFF] != 0 or cl[CL_NOCAM] != 0) { return; }
    const st : u32 = cs_state(s);
    var cp : u64 = cl_camp(cl);
    if (st != CK_ACTIVE) {
        if (cp != 0 and cl[CL_CAMTRY] != 0) { cvl_stop(cp); }
        cl[CL_CAMTRY] = 0;
        cl[CL_CAMSTATE] = @as(u8, @intCast(CVS_IDLE));
        return;
    }
    if (cl[CL_CAMTRY] == 0) {
        cl[CL_CAMTRY] = 1;
        if (cp == 0) {
            var dump : u64 = 0;
            // the 40th JPEG goes to /tmp/camcall only under the stats and T27OS_QA=1 (a test aid)
            if (qa_aid(qa_env(), cl[CL_STATS] != 0)) { dump = 1; }
            cp = cvl_new(dump);
            cl_put32(cl, CL_CAMP, cp & 4294967295);
            cl_put32(cl, CL_CAMP + 4, cp >> 32);
        }
        if (cp == 0) { cl[CL_CAMST] = 3; cl[CL_CAMSTATE] = @as(u8, @intCast(CVS_FAILED)); return; }
        cl[CL_CAMST] = @as(u8, @intCast(cvl_start(cp)));
    }
    if (cp == 0) { return; }
    // a group call takes the camera's picture at its own size (160x120, 5 a second); one to one at 320x240
    cvl_small(cp, csg_on(s));
    const cs : u32 = cvl_tick(cp);
    cl[CL_CAMSTATE] = @as(u8, @intCast(cs));
    // H.264 once both ends agreed on it (call_session cs_vh_mode), into this window's encoder; the JPEG otherwise
    const henc : u64 = cl_vh_enc_use(cl, s);
    cvl_codec(cp, cs_vh_mode(s) == VN_H264 and henc != 0, henc);
    const res : u64 = cvl_stat(cp, 14);
    if (res != 0) { cl[CL_CAMST] = @as(u8, @intCast(res & 255)); }
    if (!cvs_use_camera(cs, 1)) { return; }
    var jpeg : [24000]u8 = undefined;
    const n : usize = cvl_take(cp, jpeg[0..24000]);
    // the user's own picture for the inset comes straight from the camera (cl_layers), not from this JPEG
    if (cvs_use_camera(cs, @as(u64, n))) { cs_video_feed(s, jpeg[0..n]); }
}

/// The encoder block the session may use now: this window's, while a one to one call sends video from a live camera
/// and the encoder could make its sessions; 0 otherwise (the session then sends the JPEG of the camera or the test
/// picture, as before).
pub fn cl_vh_enc_use(cl: []const u8, s: []const u8) -> u64 {
    const e : u64 = cl_get64(cl, CL_VH_ENC);
    if (e == 0 or cl[CL_VSEND] == 0 or cl[CL_CAMOFF] != 0 or cl[CL_NOCAM] != 0 or csg_on(s)) { return 0; }
    if (@as(u32, cl[CL_CAMSTATE]) != CVS_LIVE or vte_stat(e, VE_CFAIL) != 0) { return 0; }
    return e;
}

/// The note under the numbers: why the picture is small (an older build on the other side, no decoder there, no
/// encoder here) or nothing. Pure.
pub fn cl_vh_note_of(mode: u32, enc_failed: bool) -> u32 {
    if (mode == VN_JPEG_OLD or mode == VN_JPEG_PEER) { return mode; }
    if (mode == VN_JPEG_HERE and enc_failed) { return mode; }
    return 0;
}

/// The video line names a camera that gave up (FAILED) while the call goes on with the generator.
pub fn cl_cam_unavailable(cl: []const u8) -> bool {
    return cl[CL_VSEND] != 0 and cl[CL_CAMOFF] == 0 and @as(u32, cl[CL_CAMSTATE]) == CVS_FAILED;
}

/// The decoded picture of the user's own camera, 0 when none.
pub fn cl_self_img(cl: []const u8) -> u64 {
    return cl_get32(cl, CL_SELF) | (cl_get32(cl, CL_SELF + 4) << 32);
}

fn cl_self_set(cl: []u8, img: u64) -> void {
    const old : u64 = cl_self_img(cl);
    if (old != 0 and old != img) { vid_release_image(old); }
    cl_put32(cl, CL_SELF, img & 4294967295);
    cl_put32(cl, CL_SELF + 4, img >> 32);
}

/// The decoded picture held in the snapshot, 0 when none.
pub fn cl_vimg(cl: []const u8) -> u64 {
    return cl_get32(cl, CL_VIMG) | (cl_get32(cl, CL_VIMG + 4) << 32);
}

fn cl_vimg_set(cl: []u8, img: u64) -> void {
    cl_put32(cl, CL_VIMG, img & 4294967295);
    cl_put32(cl, CL_VIMG + 4, img >> 32);
}

/// The video of the call: while the call is ACTIVE, a new complete frame is decoded (ImageIO) into a CGImage the panel
/// draws; the old one is released. When the call is over the picture goes. The counters and the "video on" flag are
/// copied for the panel; a frame redraws the window (the frame key folds these bytes), at most 10 times a second.
pub fn cl_video(cl: []u8, s: []u8, now: u64) -> void {
    const st : u32 = cs_state(s);
    if (st == CK_ACTIVE and csg_on(s)) {
        cl_gvideo(cl, s, now);
        return;
    }
    cl_gvideo_clear(cl);
    if (st != CK_ACTIVE) {
        cl_vh_end(cl);
        cl_self_set(cl, 0);
        const old : u64 = cl_vimg(cl);
        if (old != 0) {
            vid_release_image(old);
            cl_vimg_set(cl, 0);
        }
        cl[CL_VLIVE] = 0;
        cl_put32(cl, CL_VSER, 0);
        cl_put32(cl, CL_VSHOWN, 0);
        cl_put32(cl, CL_VSKIP, 0);
        return;
    }
    // the encoder and the decoder, made once for the app's life; the session learns which it may use each pass
    if (cl_get64(cl, CL_VH_ENC) == 0) { cl_put64(cl, CL_VH_ENC, vte_new()); }
    if (cl_get64(cl, CL_VH_DEC) == 0) { cl_put64(cl, CL_VH_DEC, vtd_new()); }
    cs_video_h264(s, cl_vh_enc_use(cl, s), cl_get64(cl, CL_VH_DEC));
    cl[CL_VH_OPEN] = 1;
    // the JPEG of an older build (or of the first moments of a call): its picture goes to the layer, which shows it
    // without redrawing the window (cl_layers takes CL_VH_PIMG)
    const ser : u64 = cs_vstat(s, CS_V_SERIAL);
    if (ser != cl_get32(cl, CL_VH_JSER)) {
        const n : usize = cs_vlen(s);
        if (n > 0 and !cs_vh_live(s, now)) {
            const img : u64 = vid_decode(s[CS_VLAST .. CS_VLAST + n]);
            if (img != 0) {
                const old : u64 = cl_get64(cl, CL_VH_PIMG);
                if (old != 0) { vid_release_image(old); }
                cl_put64(cl, CL_VH_PIMG, img);
            }
        }
        cl_put32(cl, CL_VH_JSER, ser);
    }
    if (cs_vlive(s, now) or cs_vh_live(s, now)) { cl[CL_VLIVE] = 1; } else { cl[CL_VLIVE] = 0; }
}

/// The end of a call's video: the decoder's queue drains and its session goes, the layers' pictures are released and
/// hidden, the numbers go. Only once per call.
fn cl_vh_end(cl: []u8) -> void {
    if (cl[CL_VH_OPEN] == 0) { return; }
    cl[CL_VH_OPEN] = 0;
    vtd_close(cl_get64(cl, CL_VH_DEC));
    const lr : u64 = cl_get64(cl, CL_VH_LR);
    const ls : u64 = cl_get64(cl, CL_VH_LS);
    const lt : u64 = cl_get64(cl, CL_VH_LT);
    if (lr != 0) {
        msg_flag(lr, sel("setHidden:"), true);
        msg1(lr, sel("setContents:"), 0);
    }
    if (ls != 0) {
        msg_flag(ls, sel("setHidden:"), true);
        msg1(ls, sel("setContents:"), 0);
    }
    if (lt != 0) { msg_flag(lt, sel("setHidden:"), true); }
    cl_vh_hold_remote(cl, 0, 0);
    const sp : u64 = cl_get64(cl, CL_VH_SPB);
    if (sp != 0) { vt_pb_release(sp); }
    cl_put64(cl, CL_VH_SPB, 0);
    const pi : u64 = cl_get64(cl, CL_VH_PIMG);
    if (pi != 0) { vid_release_image(pi); }
    cl_put64(cl, CL_VH_PIMG, 0);
    cl[CL_VH_VIS] = 0;
    var i : usize = CL_VH_MODE;
    while (i < CL_VH_KEY_END) {
        cl[i] = 0;
        i = i + 1;
    }
    cl_put32(cl, CL_VH_JSER, 0);
    cl_put32(cl, CL_VH_GEOM, 0);
    cl_put32(cl, CL_VH_GEOM + 4, 0);
    cl_put32(cl, CL_VH_GEOM + 8, 0);
    cl_put32(cl, CL_VH_GEOM + 12, 0);
}

/// What the remote layer holds from now on (kind 1 a CVPixelBuffer, 2 a CGImage, 0 nothing); the old one is released.
fn cl_vh_hold_remote(cl: []u8, obj: u64, kind: u8) -> void {
    const old : u64 = cl_get64(cl, CL_VH_RPB);
    if (old != 0 and old != obj) {
        if (cl[CL_VH_RKIND] == 1) { vt_pb_release(old); }
        if (cl[CL_VH_RKIND] == 2) { vid_release_image(old); }
    }
    cl_put64(cl, CL_VH_RPB, obj);
    cl[CL_VH_RKIND] = kind;
}

/// The numbers of the H.264 video for the panel (once a second, with the other counters).
fn cl_vh_numbers(cl: []u8, s: []u8) -> void {
    const mode : u32 = cs_vh_mode(s);
    cl[CL_VH_MODE] = @as(u8, @intCast(mode & 255));
    var rx : u64 = cs_vh_stat(s, CS_H_RX_FPS);
    if (rx > 255) { rx = 255; }
    cl[CL_VH_RXFPS] = @as(u8, @intCast(rx));
    var tx : u64 = cs_vh_stat(s, CS_H_TX_FPS);
    if (tx > 255) { tx = 255; }
    cl[CL_VH_TXFPS] = @as(u8, @intCast(tx));
    if (rx > 0) { cl[CL_VH_RWIDE] = 1; } else if (cs_vstat(s, CS_V_SHOWN) > 0 and !cs_vh_live(s, ckh_ms())) { cl[CL_VH_RWIDE] = 0; }
    cl_put16(cl, CL_VH_RXW, cs_vh_stat(s, CS_H_RX_W));
    cl_put16(cl, CL_VH_RXH, cs_vh_stat(s, CS_H_RX_H));
    cl_put16(cl, CL_VH_TXW, cs_vh_stat(s, CS_H_TX_W));
    cl_put16(cl, CL_VH_TXH, cs_vh_stat(s, CS_H_TX_H));
    cl_put16(cl, CL_VH_RXK, cs_vh_stat(s, CS_H_RX_KBPS));
    cl_put16(cl, CL_VH_TXK, cs_vh_stat(s, CS_H_WIRE_KBPS));
    const e : u64 = cl_get64(cl, CL_VH_ENC);
    cl[CL_VH_NOTE] = @as(u8, @intCast(cl_vh_note_of(mode, e == 0 or vte_stat(e, VE_CFAIL) != 0) & 255));
    cl_put32(cl, CL_VSHOWN, cs_vstat(s, CS_V_SHOWN) + cs_vh_stat(s, CS_H_RX_DONE));
    cl_put32(cl, CL_VSKIP, cs_vstat(s, CS_V_SKIPPED) + cs_vh_stat(s, CS_H_RX_LOST));
    const cp : u64 = cl_camp(cl);
    const cb : u64 = cvl_stat(cp, 0);
    if (cb >= cl_get32(cl, CL_VH_CAMCB)) { cl_put32(cl, CL_VH_CAMFPS, cb - cl_get32(cl, CL_VH_CAMCB)); }
    cl_put32(cl, CL_VH_CAMCB, cb);
}

/// The pictures of a one to one call on two layers over the CALL panel's box (owner, 2026-10-23): the remote one (the
/// decoder's newest CVPixelBuffer on its IOSurface, or the old JPEG's CGImage) and the user's own camera, mirrored, in
/// its corner with the YOU label. Every pass takes what is new and sets it as the layer's contents: 30 pictures a second
/// without redrawing the window. `vis`: the CALL panel is the one shown. The layers are made the first time and stay.
pub fn cl_layers(cl: []u8, s: []u8, parent: u64, sw: f64, sh: f64, vis: bool) -> void {
    if (parent == 0 or cl[CL_UP] == 0) { return; }
    const active : bool = cs_state(s) == CK_ACTIVE and !csg_on(s) and cl[CL_VIEW] == @as(u8, @intCast(CV_ACTIVE));
    if (!active and cl[CL_VH_VIS] == 0) { return; }
    const tx : u64 = cls("CATransaction");
    msg0(tx, sel("begin"));
    msg_flag(tx, sel("setDisableActions:"), true);
    var lr : u64 = cl_get64(cl, CL_VH_LR);
    var ls : u64 = cl_get64(cl, CL_VH_LS);
    var lt : u64 = cl_get64(cl, CL_VH_LT);
    if (lr == 0) {
        lr = msg0(msg0(cls("CALayer"), sel("alloc")), sel("init"));
        msg1(lr, sel("setContentsGravity:"), cf("resizeAspect"));
        msg1(lr, sel("setBackgroundColor:"), cg_color(0.0, 0.0, 0.0, 1.0));
        msg_flag(lr, sel("setMasksToBounds:"), true);
        msg_flag(lr, sel("setHidden:"), true);
        msg1(parent, sel("addSublayer:"), lr);
        ls = msg0(msg0(cls("CALayer"), sel("alloc")), sel("init"));
        msg1(ls, sel("setContentsGravity:"), cf("resizeAspectFill"));
        msg1(ls, sel("setBackgroundColor:"), cg_color(0.0, 0.0, 0.0, 0.55));
        msg_flag(ls, sel("setMasksToBounds:"), true);
        msg_f(ls, sel("setBorderWidth:"), 1.0);
        msg1(ls, sel("setBorderColor:"), cg_color(1.0, 1.0, 1.0, 0.85));
        // mirrored like a mirror: [-1 0 0 1 0 0] (48 bytes, passed by reference)
        var m : [48]u8 = undefined;
        var mi : usize = 0;
        while (mi < 48) { m[mi] = 0; mi = mi + 1; }
        put_u64(m[0..48], 0, 13830554455654793216);
        put_u64(m[0..48], 24, 4607182418800017408);
        msg1(ls, sel("setAffineTransform:"), sys_addr(m[0..48], m[0..48], 0));
        msg_flag(ls, sel("setHidden:"), true);
        msg1(parent, sel("addSublayer:"), ls);
        lt = msg0(msg0(cls("CATextLayer"), sel("alloc")), sel("init"));
        msg1(lt, sel("setString:"), cf(cv_self_label()));
        msg1(lt, sel("setFont:"), cf("Helvetica-Bold"));
        msg_f(lt, sel("setFontSize:"), 9.0);
        msg_f(lt, sel("setContentsScale:"), RETINA);
        msg1(lt, sel("setForegroundColor:"), cg_color(1.0, 1.0, 1.0, 0.9));
        msg_flag(lt, sel("setHidden:"), true);
        msg1(parent, sel("addSublayer:"), lt);
        cl_put64(cl, CL_VH_LR, lr);
        cl_put64(cl, CL_VH_LS, ls);
        cl_put64(cl, CL_VH_LT, lt);
    }
    // the newest remote picture: H.264 from the decoder, else a JPEG picture waiting
    const pb : u64 = vtd_take(cl_get64(cl, CL_VH_DEC));
    if (pb != 0) {
        const surf : u64 = vt_pb_surface(pb);
        if (surf != 0) {
            msg1(lr, sel("setContents:"), surf);
            cl_vh_hold_remote(cl, pb, 1);
            cl_put32(cl, CL_VH_RXN, cl_get32(cl, CL_VH_RXN) + 1);
            cl[CL_VH_RPIC] = 1;
        } else {
            vt_pb_release(pb);
        }
    } else if (cl_get64(cl, CL_VH_PIMG) != 0) {
        const img : u64 = cl_get64(cl, CL_VH_PIMG);
        cl_put64(cl, CL_VH_PIMG, 0);
        msg1(lr, sel("setContents:"), img);
        cl_vh_hold_remote(cl, img, 2);
        cl_put32(cl, CL_VH_RXN, cl_get32(cl, CL_VH_RXN) + 1);
        cl[CL_VH_RPIC] = 1;
    }
    // the own picture, straight from the camera, while the call sends it
    const own_ok : bool = cv_self_mode(CV_ACTIVE, false, cl[CL_VSEND] != 0, cl[CL_CAMOFF] != 0, cl[CL_NOCAM] != 0, cl_cam_unavailable(cl), true) == CV_SELF_PIP;
    const op : u64 = cvl_take_self(cl_camp(cl));
    if (op != 0) {
        const os : u64 = vt_pb_surface(op);
        if (own_ok and os != 0) {
            msg1(ls, sel("setContents:"), os);
            const old : u64 = cl_get64(cl, CL_VH_SPB);
            if (old != 0) { vt_pb_release(old); }
            cl_put64(cl, CL_VH_SPB, op);
            cl_put32(cl, CL_VH_SXN, cl_get32(cl, CL_VH_SXN) + 1);
            cl[CL_VH_SPIC] = 1;
        } else {
            vt_pb_release(op);
        }
    }
    // where the box stands now (the same numbers draw_cl_video uses)
    const l : f64 = qp_left(sw);
    const x : f64 = l + QP_PAD;
    const bw : f64 = QP_W - 2.0 * QP_PAD;
    const top : f64 = cv_vbox_top(WS_TOP + CV_HINT_Y + 90.0);
    const room : f64 = sh - top - 16.0;
    const wide : bool = cl[CL_VH_RWIDE] != 0;
    const w : f64 = cv_vbox_w(bw, room, wide);
    const h : f64 = cv_vbox_h(bw, room, wide);
    const show : bool = active and vis and h >= 24.0;
    const show_r : bool = show and cl[CL_VH_RPIC] != 0;
    const show_s : bool = show and own_ok and cl[CL_VH_SPIC] != 0 and cv_self_fits(w, h);
    const qx : u64 = @as(u64, @intFromFloat(x * 4.0));
    const qy : u64 = @as(u64, @intFromFloat(top * 4.0));
    const qw : u64 = @as(u64, @intFromFloat(w * 4.0));
    const qh : u64 = @as(u64, @intFromFloat(h * 4.0)) | (@as(u64, @intFromFloat(sh)) << 16);
    if (qx != cl_get32(cl, CL_VH_GEOM) or qy != cl_get32(cl, CL_VH_GEOM + 4) or qw != cl_get32(cl, CL_VH_GEOM + 8) or qh != cl_get32(cl, CL_VH_GEOM + 12)) {
        cl_put32(cl, CL_VH_GEOM, qx);
        cl_put32(cl, CL_VH_GEOM + 4, qy);
        cl_put32(cl, CL_VH_GEOM + 8, qw);
        cl_put32(cl, CL_VH_GEOM + 12, qh);
        msg_rect(lr, sel("setFrame:"), x, cv_layer_y(sh, top, h), w, h);
        const iw : f64 = cv_self_w(w);
        const ih : f64 = iw * 0.75;
        const ix : f64 = cv_self_x(x, w, iw);
        const iy : f64 = cv_self_y(top, h, iw);
        msg_rect(ls, sel("setFrame:"), ix, cv_layer_y(sh, iy, ih), iw, ih);
        msg_rect(lt, sel("setFrame:"), ix + 4.0, cv_layer_y(sh, iy + 2.0, 12.0), 30.0, 12.0);
    }
    msg_flag(lr, sel("setHidden:"), !show_r);
    msg_flag(ls, sel("setHidden:"), !show_s);
    msg_flag(lt, sel("setHidden:"), !show_s);
    if (show_r or show_s) { cl[CL_VH_VIS] = 1; } else { cl[CL_VH_VIS] = 0; }
    msg0(tx, sel("commit"));
}

/// The decoded picture of tile i, 0 when none.
pub fn cl_gvimg(cl: []const u8, i: usize) -> u64 {
    return cl_get32(cl, CL_GVIMG + 8 * i) | (cl_get32(cl, CL_GVIMG + 8 * i + 4) << 32);
}

fn cl_gvimg_set(cl: []u8, i: usize, img: u64) -> void {
    const old : u64 = cl_gvimg(cl, i);
    if (old != 0 and old != img) { vid_release_image(old); }
    cl_put32(cl, CL_GVIMG + 8 * i, img & 4294967295);
    cl_put32(cl, CL_GVIMG + 8 * i + 4, img >> 32);
}

/// No group call: the tiles' pictures go and the strip is off.
fn cl_gvideo_clear(cl: []u8) -> void {
    var i : usize = 0;
    while (i < VG_SHOW) {
        cl_gvimg_set(cl, i, 0);
        cl_put32(cl, CL_GVSER + 4 * i, 0);
        cl[CL_GVLINK + i] = @as(u8, @intCast(VG_NO_LINK));
        i = i + 1;
    }
    cl[CL_GV] = 0;
    cl[CL_GV_MORE] = 0;
    cl[CL_GV_LIVE] = 0;
}

/// A group call's video: the links of the two members whose first frame came first (csg_vshow) become the tiles; a
/// tile decodes its member's last complete JPEG whenever that member's serial changed (a tile that changes member drops
/// its picture first). The others are heard only (CL_GV_MORE). VIDEO ON while any tile got a frame in the last second.
fn cl_gvideo(cl: []u8, s: []u8, now: u64) -> void {
    const sh : u32 = csg_vshow(s);
    var n : u8 = 0;
    var live : u8 = 0;
    var i : usize = 0;
    while (i < VG_SHOW) {
        const j : u32 = (sh >> @as(u32, @intCast(8 * i))) & 255;
        if (j != @as(u32, cl[CL_GVLINK + i])) {
            cl_gvimg_set(cl, i, 0);
            cl_put32(cl, CL_GVSER + 4 * i, 0);
            cl[CL_GVLINK + i] = @as(u8, @intCast(j));
        }
        if (j != VG_NO_LINK) {
            const jl : usize = @as(usize, j);
            const ser : u64 = csg_vlink(s, jl, 6) & 4294967295;
            if (ser != cl_get32(cl, CL_GVSER + 4 * i)) {
                const len : usize = @as(usize, @intCast(csg_vlink(s, jl, 7)));
                if (len > 0 and len <= CS_VBUF) {
                    const at : usize = jl * CS_LEN + CS_VLAST;
                    const img : u64 = vid_decode(s[at .. at + len]);
                    if (img != 0) { cl_gvimg_set(cl, i, img); }
                }
                cl_put32(cl, CL_GVSER + 4 * i, ser);
            }
            cl[CL_GV_TAG + 2 * i] = s[jl * CS_LEN + EP_PEER];
            cl[CL_GV_TAG + 2 * i + 1] = s[jl * CS_LEN + EP_PEER + 1];
            cl[CL_GV_SER + i] = @as(u8, @intCast(ser & 255));
            if (cs_vlive(s[jl * CS_LEN .. (jl + 1) * CS_LEN], now)) { live = live | @as(u8, @intCast(i + 1)); }
            n = n + 1;
        }
        i = i + 1;
    }
    cl[CL_GV] = n + 1;
    const up : u64 = csg_stat(s, 0);
    var more : u64 = 0;
    if (up > @as(u64, n)) { more = up - @as(u64, n); }
    cl[CL_GV_MORE] = @as(u8, @intCast(more & 255));
    cl[CL_GV_LIVE] = live;
    if (live != 0) { cl[CL_VLIVE] = 1; } else { cl[CL_VLIVE] = 0; }
}

/// Copy the session into the region draw() reads. The counters and the clock change at most once a second, so a call
/// redraws the window once a second, not on every frame that arrives.
pub fn cl_snapshot(cl: []u8, s: []u8, w: []u64, now: u64) -> void {
    const st : u32 = cs_state(s);
    var code : [6]u8 = undefined;
    const have : bool = cs_code(s, code[0..6]);
    if (st != CK_VERIFY and st != CK_ACTIVE) { cl[CL_SAID] = 0; }
    cl[CL_VIEW] = @as(u8, @intCast(cv_view(st, have, cl[CL_SAID] != 0)));
    var i : usize = 0;
    while (i < 6) {
        if (have) { cl[CL_CODE + i] = code[i]; } else { cl[CL_CODE + i] = 0; }
        i = i + 1;
    }
    var fp : [10]u8 = undefined;
    const ip : u64 = cs_peer(s, fp[0..10]);
    if (ip != 0) {
        i = 0;
        while (i < 10) {
            cl[CL_PFP + i] = fp[i];
            i = i + 1;
        }
        // an IPv6 peer has no IPv4 to show (call_session CS_PEER_V6): the panel names the family instead
        if (ip > 4294967295) { cl_put_ip(cl, CL_PIP, 0); } else { cl_put_ip(cl, CL_PIP, ip); }
        cl[CL_V6_FAM] = @as(u8, @intCast(cs_net(s, CS_NET_FAM) & 255));
    }
    if (cs_muted(s)) { cl[CL_MUTED] = 1; } else { cl[CL_MUTED] = 0; }
    cl[CL_REASON] = @as(u8, @intCast(cs_reason(s) & 255));
    const changed : bool = @as(u64, st) != w[CLW_PREV];
    var secs : u64 = cl_get32(cl, CL_SECS);
    if (st == CK_ACTIVE and w[CLW_T_ACTIVE] != 0 and now >= w[CLW_T_ACTIVE]) { secs = (now - w[CLW_T_ACTIVE]) / 1000; }
    if (changed or secs != cl_get32(cl, CL_SECS)) {
        cl_put32(cl, CL_SECS, secs);
        cl_put32(cl, CL_SENT, cs_stat(s, CS_ST_SENT));
        cl_put32(cl, CL_RECV, cs_stat(s, CS_ST_ACCEPTED));
        cl_put32(cl, CL_REJ, cs_stat(s, CS_ST_REJ_AEAD));
        cl_put32(cl, CL_GAP, w[CLW_GAP]);
        cl_put32(cl, CL_N10, w[CLW_N10]);
        cl_put32(cl, CL_NPOLL, w[CLW_NPOLL]);
        cl_put32(cl, CL_CAPT, cs_stat(s, 1002));
        cl_put32(cl, CL_UNDER, cs_stat(s, 1004));
        cl_put32(cl, CL_OVER, cs_stat(s, 1005));
        cl_put32(cl, CL_TXO, cs_stat(s, 1007));
        if (st == CK_ACTIVE and !csg_on(s)) { cl_vh_numbers(cl, s); }
        if (cl[CL_STATS] != 0 and st == CK_ACTIVE) { cl_stats_line(cl, s, secs); }
    }
    w[CLW_PREV] = @as(u64, st);
}

/// One pass of the main loop: read the socket (cs_poll, every event), measure the gap since the last poll while the
/// call carries audio, refresh the snapshot. True when a call started ringing here (the window opens the panel).
pub fn cl_tick(cl: []u8, s: []u8, w: []u64) -> bool {
    if (cl[CL_UP] == 0) { return false; }
    const now : u64 = ckh_ms();
    if (cs_state(s) == CK_ACTIVE and w[CLW_LAST] != 0) {
        var gap : u64 = 0;
        if (now > w[CLW_LAST]) { gap = now - w[CLW_LAST]; }
        if (gap > w[CLW_GAP]) { w[CLW_GAP] = gap; }
        if (gap > 10) { w[CLW_N10] = w[CLW_N10] + 1; }
        w[CLW_NPOLL] = w[CLW_NPOLL] + 1;
    }
    var rang : bool = false;
    var ev : u32 = cs_poll(s);
    var k : u32 = 0;
    while (ev != CS_EV_NONE and k < 32) {
        if (ev == CS_EV_RINGING) { rang = true; }
        if (ev == CS_EV_CALLING or ev == CS_EV_RINGING) {
            cl[CL_SAID] = 0;
            cl[CL_TALKED] = 0;
            cl_put32(cl, CL_SECS, 0);
        }
        if (ev == CS_EV_ACTIVE) {
            w[CLW_T_ACTIVE] = ckh_ms();
            w[CLW_GAP] = 0;
            w[CLW_N10] = 0;
            w[CLW_NPOLL] = 0;
            cl[CL_TALKED] = 1;
        }
        ev = cs_poll(s);
        k = k + 1;
    }
    // the friends: the daemon, the matches, the snapshot; a friend named by T27OS_FRIEND_DIAL is called as a click would
    const now2 : u64 = ckh_ms();
    const frow : usize = fe_tick(cl, now2);
    if (frow < FV_ROWS_SNAP) {
        const st0 : u32 = cs_state(s);
        if (st0 == CK_IDLE or st0 == CK_ENDED or st0 == CK_FAILED) {
            cl[CL_NOTE] = @as(u8, @intCast(fe_call(cl, s, frow)));
            fe_dial_done(cl);
        }
    }
    // a group call named by T27OS_CALL_AUTODIAL and T27OS_CALL_AUTODIAL2 (a test aid; false at once when they are not set)
    fe_group_tick(cl, s);
    // T27OS_CALL_DIAL_AFTER (a test aid, QA only): the one dial of the CALL field when it is due
    const dat : u64 = cl_get32(cl, CL_V6_DIALAT);
    if (dat != 0 and cn_ago(now2, dat) < 2147483648) {
        cl_put32(cl, CL_V6_DIALAT, 0);
        cl_dial(cl, s);
        var dl : [64]u8 = undefined;
        var dn : usize = put_bytes(dl[0..64], 0, "DIAL6 test aid: dialled, note ");
        dn = put_dec(dl[0..64], dn, @as(u64, cl[CL_NOTE]));
        dn = put_bytes(dl[0..64], dn, "\n");
        sys_write(2, dl[0..64], @as(u64, dn));
    }
    if (cl[CL_AUTO] != 0) { cl_autotest(cl, s, w, ckh_ms()); }
    cl_ring(cl, s);
    cl_video(cl, s, ckh_ms());
    cl_camera(cl, s);
    cl_snapshot(cl, s, w, ckh_ms());
    // the gap is measured from here: the time inside cs_poll (opening the audio queues once) is the poll's own work
    w[CLW_LAST] = ckh_ms();
    return rang;
}

/// T27OS_CALL_AUTOTEST (a test aid, off by default, not product behavior): ANSWER 2 s after an incoming call rings,
/// CODES MATCH 2 s after the code appears, both sides. w[CLW_AUTO_T] is when the state last changed.
pub fn cl_autotest(cl: []u8, s: []u8, w: []u64, now: u64) -> void {
    const st : u32 = cs_state(s);
    if (@as(u64, st) != w[CLW_PREV] or w[CLW_AUTO_T] == 0) { w[CLW_AUTO_T] = now; }
    if (now < w[CLW_AUTO_T] + 2000) { return; }
    if (st == CK_RINGING) {
        cs_answer(s);
        w[CLW_AUTO_T] = now;
    } else if (st == CK_VERIFY and cl[CL_SAID] == 0) {
        var code : [6]u8 = undefined;
        if (cs_code(s, code[0..6]) and cs_confirm(s, true)) { cl[CL_SAID] = 1; }
        w[CLW_AUTO_T] = now;
    }
}

/// The call signal follows the call state (ringtone.t27); with T27OS_CALL_STATS a line goes to stderr when its queue
/// opens or closes, with the counters.
pub fn cl_ring(cl: []u8, s: []u8) -> void {
    if (cl[CL_UP] == 0) { return; }
    const tone : []u8 = cl[FE_TONE .. FE_TONE + RT_BLOCK];
    const a : u64 = rt_stat(tone, RT_S_STARTS) + rt_stat(tone, RT_S_STOPS);
    rt_follow(tone, cs_state(s));
    if (cl[CL_STATS] != 0 and rt_stat(tone, RT_S_STARTS) + rt_stat(tone, RT_S_STOPS) != a) {
        var line : [256]u8 = undefined;
        const n : usize = rt_stat_line(tone, line[0..256]);
        sys_write(2, line[0..n], @as(u64, n));
        sys_write(2, "\n", 1);
    }
}

/// The debug call: the typed address, and the key typed in the add field (a valid invite) as the fingerprint of whoever
/// answers there. A refusal is a note under the fields.
pub fn cl_dial(cl: []u8, s: []u8) -> void {
    cl[CL_FOCUS] = 0;
    if (cl[CL_UP] == 0) {
        if (cl[CL_NOTE] == 0) { cl[CL_NOTE] = @as(u8, @intCast(CV_N_SOCKET)); }
        return;
    }
    var ep : [18]u8 = undefined;
    if (cl_typed_ep(cl, ep[0..18]) and !ip6_mapped(ep[0..18])) {
        cl[CL_NOTE] = @as(u8, @intCast(cl_dial6(cl, s, ep[0..18])));
        return;
    }
    const a : u64 = cl_typed_addr(cl);
    var note : u32 = 0;
    // a public address needs ALLOW for this very address (or T27OS_ALLOW_PUBLIC=1); the consent is spent by this dial
    var c : [1]u64 = undefined;
    c[0] = cl_consent(cl);
    const d : u32 = cv_dial_step(c[0..1], a, cl[CL_PUBENV] != 0);
    cl_put_consent(cl, c[0]);
    if (a == 0) {
        note = CV_N_ADDR;
    } else if (d == CV_D_ASK) {
        note = CV_N_PUBASK;
    } else if (d != CV_D_OK) {
        note = CV_N_NEVER;
    } else if (cv_is_self(a, cl_ip(cl, CL_ME_IP), cl_ip(cl, CL_N_LAN), cl_me_port(cl))) {
        note = CV_N_SELF;
    } else if (cn_same_router(a, cl_nat_pub(cl)) and cl[CL_N_ST] == @as(u8, @intCast(CN_S_OK))) {
        // this router's own public address: a friend behind it is called at its address on this network
        note = CV_N_ROUTER;
    } else {
        var fp : [10]u8 = undefined;
        if (!fe_typed_key(cl, fp[0..10])) {
            note = FN_KEYNEED;
        } else if (!cs_call(s, cv_addr_ip(a), cv_addr_port(a), fp[0..10])) {
            note = CV_N_REFUSED;
        } else if (cv_addr_class(cv_addr_ip(a)) == CV_AC_PUBLIC) {
            // a public address: probes from the call socket as well, so this router opens toward it (call_nat.t27)
            cn_punch_start(cl, a, ckh_ms());
        }
    }
    cl[CL_NOTE] = @as(u8, @intCast(note));
}

/// The debug call to a typed IPv6 (call_ip6.t27): a global address needs ALLOW for it (or T27OS_ALLOW_PUBLIC=1), spent
/// by this dial; a unique local one is this network; ::1 only with T27OS_QA=1; the rest never. A global address is
/// punched as well (the friend's router lets the call in once both sides sent). The note to show; 0 when it dialled.
pub fn cl_dial6(cl: []u8, s: []u8, ep: []const u8) -> u32 {
    var c : [18]u8 = undefined;
    ip6_clear(c[0..18]);
    if (cl[CL_V6_OK] != 0) { ip6_copy(c[0..18], ep); }
    const d : u32 = ip6_dial_step(c[0..18], ep, cl[CL_PUBENV] != 0, cl[CL_V6_QA] != 0);
    cl[CL_V6_OK] = 0;
    if (d == CV_D_ASK) { return CV_N_PUBASK; }
    if (d != CV_D_OK) { return CV_N_NEVER; }
    if (cl_is_self6(cl, ep)) { return CV_N_SELF; }
    var fp : [10]u8 = undefined;
    if (!fe_typed_key(cl, fp[0..10])) { return FN_KEYNEED; }
    if (!cs_call6(s, ep, fp[0..10])) { return CV_N_REFUSED; }
    if (ip6_class(ep) == IP6_C_GLOBAL) { cn_punch_start6(cl, ep, ckh_ms()); }
    return 0;
}

/// The typed IPv6 is this device: its own address (or ::1) and its call port.
pub fn cl_is_self6(cl: []const u8, ep: []const u8) -> bool {
    if (ip6_port(ep) != cl_me_port(cl)) { return false; }
    if (ip6_class(ep) == IP6_C_LOOPBACK) { return true; }
    return cl[CL_V6_OWNR] != 0 and ip6_same(ep, cl[CL_V6_OWN .. CL_V6_OWN + IP6_EP]);
}

/// The typed key added as a friend (fe_add); a key the engine refused as plain "not valid" gets the reason the panel can
/// name: the wrong length, or a last symbol that does not match (a mistyped or cut key).
pub fn cl_add(cl: []u8) -> u32 {
    const note : u32 = fe_add(cl, ckh_ms());
    if (note != FN_BAD) { return note; }
    return ac_bad_reason(cl[FV_TYPED .. FV_TYPED + 32], @as(usize, cl[FV_INVLEN]));
}

/// Return in a field: the invite field adds the friend, the address field makes the debug call.
pub fn cl_enter(cl: []u8, s: []u8, w: []u64) -> void {
    if (cl[CL_FOCUS] == 2) {
        cl[CL_NOTE] = @as(u8, @intCast(cl_add(cl)));
    } else {
        cl_do(cl, s, w, CV_A_DIAL);
    }
}

/// One hit in the IDLE view (friends_view fv_hit) as one action: copy my invite, focus a field, add a friend, show or hide
/// the debug part, the debug call, or call the friend of a row.
pub fn cl_front(cl: []u8, s: []u8, w: []u64, hit: u32) -> void {
    cl[CL_FOCUS] = 0;
    if (hit == FV_H_NONE) { return; }
    cl[CL_NOTE] = 0;
    if (hit == FV_H_INVITE) {
        pb_copy(cl[FV_INV .. FV_INV + INVITE_LEN], INVITE_LEN);
        cl[CL_NOTE] = @as(u8, @intCast(FN_COPIED));
    } else if (hit == FV_H_IFIELD) {
        cl[CL_FOCUS] = 2;
    } else if (hit == FV_H_ADD) {
        cl[CL_NOTE] = @as(u8, @intCast(cl_add(cl)));
    } else if (hit == FV_H_DEBUG) {
        if (cl[FV_DEBUG] == 0) { cl[FV_DEBUG] = 1; } else { cl[FV_DEBUG] = 0; }
    } else if (hit == FV_H_DFIELD) {
        cl[CL_FOCUS] = 1;
    } else if (hit == FV_H_DCALL) {
        cl_do(cl, s, w, CV_A_DIAL);
    } else if (hit == FV_H_DALLOW) {
        // the person's consent for the typed public address only, held in memory until the next dial
        var c : [1]u64 = undefined;
        c[0] = cl_consent(cl);
        var aep : [18]u8 = undefined;
        if (cl_typed_ep(cl, aep[0..18]) and !ip6_mapped(aep[0..18])) {
            if (ip6_askable(aep[0..18])) { cl[CL_V6_OK] = 1; }
        } else if (cv_allow(c[0..1], cl_typed_addr(cl))) { cl_put_consent(cl, c[0]); }
    } else if (hit >= FV_H_ROW) {
        if (cl[CL_UP] != 0) {
            cl[CL_NOTE] = @as(u8, @intCast(fe_call(cl, s, @as(usize, hit - FV_H_ROW))));
            cl_ring(cl, s);
            cl_snapshot(cl, s, w, ckh_ms());
        } else if (cl[CL_NOTE] == 0) {
            cl[CL_NOTE] = @as(u8, @intCast(CV_N_SOCKET));
        }
    }
}

/// One person's action (call_view cv_action) as one cs_* call; then a fresh snapshot.
pub fn cl_do(cl: []u8, s: []u8, w: []u64, act: u32) -> void {
    // with calls off (cl_boot left a note) the block was never opened: only the field and CALL answer, with the note
    if (cl[CL_UP] == 0 and act != CV_A_FOCUS and act != CV_A_DIAL) { return; }
    if (act == CV_A_FOCUS) {
        cl[CL_FOCUS] = 1;
        cl[CL_NOTE] = 0;
    } else if (act == CV_A_DIAL) {
        cl_dial(cl, s);
    } else if (act == CV_A_HANGUP) {
        cs_hangup(s);
    } else if (act == CV_A_ANSWER) {
        cs_answer(s);
    } else if (act == CV_A_DECLINE) {
        cs_decline(s);
    } else if (act == CV_A_MATCH) {
        if (cs_confirm(s, true)) { cl[CL_SAID] = 1; }
    } else if (act == CV_A_DIFFER) {
        cs_confirm(s, false);
    } else if (act == CV_A_MUTE) {
        cs_mute(s, !cs_muted(s));
    } else if (act == CV_A_CLOSE) {
        cs_dismiss(s);
        cl[CL_NOTE] = 0;
        cl[CL_TALKED] = 0;
        cl_put32(cl, CL_SECS, 0);
    }
    if (cl[CL_UP] != 0) {
        cl_ring(cl, s);
        cl_snapshot(cl, s, w, ckh_ms());
    }
}

/// One typed UTF-16 unit into the focused field: the invite field takes letters, digits and the dash (25 at most); the
/// address field digits, dots and a colon (CV_ADDR_MAX at most), and with T27OS_QA=1 also the hex digits and brackets
/// of an IPv6 (IP6_TEXT_MAX at most).
pub fn cl_unit(cl: []u8, unit: u32) -> void {
    if (cl[CL_FOCUS] == 2) {
        const ic : u32 = fv_inv_char(unit);
        const m : usize = @as(usize, cl[FV_INVLEN]);
        if (ic == 0 or m >= INVITE_LEN) { return; }
        cl[FV_TYPED + m] = @as(u8, @intCast(ic));
        cl[FV_INVLEN] = @as(u8, @intCast(m + 1));
        cl[CL_NOTE] = 0;
        return;
    }
    const n : usize = @as(usize, cl[CL_V6_ALEN]);
    if (cl[CL_V6_QA] != 0) {
        if (!ip6_addr_char(unit) or n >= IP6_TEXT_MAX) { return; }
    } else if (!cv_addr_char(unit) or n >= CV_ADDR_MAX) {
        return;
    }
    cl[CL_V6_TXT + n] = @as(u8, @intCast(unit));
    cl[CL_V6_ALEN] = @as(u8, @intCast(n + 1));
    // ALLOW was for the address as it was typed
    cl[CL_V6_OK] = 0;
    cl[CL_NOTE] = 0;
}

pub fn cl_back(cl: []u8) -> void {
    if (cl[CL_FOCUS] == 2) {
        if (cl[FV_INVLEN] > 0) { cl[FV_INVLEN] = cl[FV_INVLEN] - 1; }
    } else if (cl[CL_V6_ALEN] > 0) {
        cl[CL_V6_ALEN] = cl[CL_V6_ALEN] - 1;
        cl[CL_V6_OK] = 0;
    }
    cl[CL_NOTE] = 0;
}

/// While a call is up the process asks the system not to nap or coalesce its timers (NSProcessInfo activity,
/// NSActivityUserInitiated | NSActivityLatencyCritical): a window in the background must still poll every 10 ms.
pub const CL_ACTIVITY : u64 = 1095233437695;
fn cl_activity_begin() -> u64 {
    const pi : u64 = msg0(cls("NSProcessInfo"), sel("processInfo"));
    const tok : u64 = msg2(pi, sel("beginActivityWithOptions:reason:"), CL_ACTIVITY, cf("T27 OS call"));
    if (tok != 0) { msg0(tok, sel("retain")); }
    return tok;
}
fn cl_activity_end(tok: u64) -> void {
    const pi : u64 = msg0(cls("NSProcessInfo"), sel("processInfo"));
    msg1(pi, sel("endActivity:"), tok);
    msg0(tok, sel("release"));
}

/// The right edge of the title bar's CALL pill: left of the profile circle.
pub fn cl_head_right(sw: f64) -> f64 { return pf_head_cx(sw) - PRF_HEAD_R - CV_HEAD_GAP; }
pub fn on_cl_head(x: f64, y: f64, sw: f64) -> bool { return cv_head_hit(x, y, cl_head_right(sw), TITLE_H); }

/// The pill: outlined while no call is up, filled dim while one is, brighter while it rings here.
fn draw_cl_head(c: u64, kit: [48]u64, sw: f64, mx: f64, my: f64, cl: []const u8) -> void {
    const bx : f64 = cv_head_x(cl_head_right(sw));
    const by : f64 = cv_head_y(TITLE_H);
    const view : u32 = @as(u32, cl[CL_VIEW]);
    round_rect(c, bx, by, CV_HEAD_W, CV_HEAD_H, 0.5 * CV_HEAD_H);
    if (view == CV_RINGING) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.38);
        cg_fill_path(c);
        round_rect(c, bx, by, CV_HEAD_W, CV_HEAD_H, 0.5 * CV_HEAD_H);
    } else if (cv_live(view)) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.16);
        cg_fill_path(c);
        round_rect(c, bx, by, CV_HEAD_W, CV_HEAD_H, 0.5 * CV_HEAD_H);
    }
    var ring : f64 = lv(kit, THV_LABEL_WHITE);
    if ((cl[CL_OPEN] != 0 and cl[AC_ON] == 0) or on_cl_head(mx, my, sw)) { ring = lv(kit, THV_TEXT_WHITE); }
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, ring);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    const lw : f64 = bytes_w(kit, "CALL", 4, 9.0, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, "CALL", 4, bx + 0.5 * (CV_HEAD_W - lw), by + 12.5, 9.0, WEIGHT_SEMIBOLD, false);
}

/// Text wrapped in the panel's width, at most `lines` lines from the baseline `base`.
fn draw_cl_wrap(c: u64, kit: [48]u64, msg: []const u8, x: f64, right: f64, base: f64, size: f64, lines: u32, sh: f64) -> void {
    var from : usize = 0;
    var ln : u32 = 0;
    while (from < msg.len and ln < lines) {
        const rest : []const u8 = msg[from .. msg.len];
        const b : f64 = base + (size + 3.5) * @as(f64, @floatFromInt(ln));
        var cut : usize = wrap_at(kit, rest, rest.len, size, 0.0, right - x);
        if (ln + 1 == lines) { cut = rest.len; }
        if (cut == 0) { cut = rest.len; }
        if (b < sh - 6.0) { draw_fit(c, kit, rest, cut, x, b, size, 0.0, false, right); }
        from = from + cut;
        if (from < msg.len and msg[from] == 32) { from = from + 1; }
        ln = ln + 1;
    }
}

fn draw_cl_btn(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: []const u8, sw: f64, over: bool) -> void {
    draw_plate(c, bx - 2.0, by - 2.0, bw + 4.0, CV_BTN_H + 4.0, sw);
    round_rect(c, bx, by, bw, CV_BTN_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    const lw : f64 = bytes_w(kit, word, word.len, 9.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, word.len, bx + 0.5 * (bw - lw), by + 17.0, 9.5, WEIGHT_SEMIBOLD, false);
}

/// A filled or outlined 8 px dot: a friend is online (filled) or not (outlined).
fn draw_cl_dot(c: u64, kit: [48]u64, dx: f64, dy: f64, on: bool) -> void {
    round_rect(c, dx, dy, 8.0, 8.0, 4.0);
    if (on) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        cg_fill_path(c);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        cg_stroke_path(c);
    }
}

/// One text field of the panel: the box, the text (a caret while it is typed in), or while it is empty the caret (when
/// typed in) and the grey hint "e.g. ..." (friends_view.fv_field_hint), so the example never reads as typed text.
fn draw_cl_field(c: u64, kit: [48]u64, fx: f64, fy: f64, fw: f64, typing: bool, over: bool, txt: []const u8, tn: usize, example: []const u8) -> void {
    round_rect(c, fx, fy, fw, CV_FIELD_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (typing) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    if (!typing and over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    cg_stroke_path(c);
    var shown : [32]u8 = undefined;
    var an : usize = tn;
    if (an > 30) { an = 30; }
    var i : usize = 0;
    while (i < an) {
        shown[i] = txt[i];
        i = i + 1;
    }
    if (typing) {
        shown[an] = 95;
        an = an + 1;
    }
    if (tn > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, shown[0..32], an, fx + 8.0, fy + 17.5, 10.5, 0.0, true, fx + fw - 8.0);
    } else {
        var hx : f64 = fx + 8.0;
        if (typing) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_bytes(c, kit, "_", 1, hx, fy + 17.5, 10.5, 0.0, true);
            hx = hx + bytes_w(kit, "_", 1, 10.5, 0.0, true) + 2.0;
        }
        var hb : [40]u8 = undefined;
        const hn : usize = fv_field_hint(0, example, hb[0..40]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, hb[0..40], hn, hx, fy + 17.5, 10.5, 0.0, true, fx + fw - 8.0);
    }
}

/// The IDLE view of the CALL panel: this device's invite, the friends (nickname, short fingerprint, online or not and
/// when last met), the field that adds a friend by invite, and the debug call by address.
fn draw_cl_front(c: u64, kit: [48]u64, sh: f64, mx: f64, my: f64, l: f64, t: f64, cl: []const u8, ch: []const u8) -> void {
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const shown : u32 = @as(u32, cl[FV_SHOWN]);
    const debug : bool = cl[FV_DEBUG] != 0;
    const hit : u32 = fv_hit(mx, my, l, QP_W, t, shown, debug, cl_allow_shown(cl));
    var line : [96]u8 = undefined;
    // my invite: a click copies it
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "YOUR INVITE", 11, x, t + FV_INV_LABEL_Y, 9.5, 0.0, false);
    if (hit == FV_H_INVITE) { draw_bytes(c, kit, "click to copy", 13, x + 90.0, t + FV_INV_LABEL_Y, 9.5, 0.0, false); }
    if (cl[CL_UP] != 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, cl[FV_INV .. FV_INV + INVITE_LEN], INVITE_LEN, x, t + FV_INV_Y, 10.5, 0.0, true, right);
    }
    // the friends
    var n : usize = put_bytes(line[0..96], 0, "FRIENDS");
    if (cl[FV_COUNT] > 0) {
        n = put_bytes(line[0..96], n, "  ");
        n = put_dec(line[0..96], n, @as(u64, cl[FV_COUNT]));
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..96], n, x, t + FV_FR_LABEL_Y, 9.5, 0.0, false, right);
    if (cl[CL_UP] != 0 and cl[FV_NET] != @as(u8, @intCast(FV_NET_UP))) {
        draw_bytes(c, kit, "not announcing on the network", 29, x + 90.0, t + FV_FR_LABEL_Y, 9.5, 0.0, false);
    }
    const rows : usize = fv_rows_drawn(shown);
    if (shown == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_cl_wrap(c, kit, "No friends yet. Paste a friend's invite below, or send them yours.", x, right, t + FV_FR_LABEL_Y + 20.0, 9.5, 2, sh);
    }
    var i : usize = 0;
    while (i < rows) {
        const ry : f64 = fv_row_y(t, i);
        const r : usize = fv_row_at(i);
        const online : bool = cl[r + FR_ONLINE] != 0;
        if (hit == FV_H_ROW + @as(u32, @intCast(i))) {
            round_rect(c, x - 4.0, ry, right - x + 8.0, FV_ROW_H - 2.0, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            cg_stroke_path(c);
        }
        draw_cl_dot(c, kit, x + 1.0, ry + 7.0, online);
        const nl : usize = @as(usize, cl[r + FR_NICKLEN]);
        if (nl > 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_fit(c, kit, cl[r + FR_NICK .. r + FR_NICK + nl], nl, x + 16.0, ry + 13.0, 11.0, WEIGHT_SEMIBOLD, false, right - 40.0);
        } else {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            draw_bytes(c, kit, "(no name yet)", 13, x + 16.0, ry + 13.0, 11.0, 0.0, false);
        }
        if (online) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_bytes(c, kit, "CALL", 4, right - 28.0, ry + 13.0, 9.5, WEIGHT_SEMIBOLD, false);
        }
        n = fv_row_line(cl, i, chv_trust(ch, cl[r + FR_FP .. r + FR_FP + 10]), line[0..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x + 16.0, ry + 25.0, 9.0, 0.0, true, right);
        i = i + 1;
    }
    if (cl[FV_COUNT] > 5) {
        n = put_bytes(line[0..96], 0, "+");
        n = put_dec(line[0..96], n, @as(u64, cl[FV_COUNT]) - 5);
        n = put_bytes(line[0..96], n, " more are not shown");
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + FV_ADD_LABEL_Y - 8.0, 9.0, 0.0, false, right);
    }
    // add a friend by invite
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "ADD A FRIEND", 12, x, t + FV_ADD_LABEL_Y, 9.5, 0.0, false);
    draw_cl_field(c, kit, cv_field_x(l), t + FV_IFIELD_Y, cv_field_w(QP_W), cl[CL_FOCUS] == 2, hit == FV_H_IFIELD, cl[FV_TYPED .. FV_TYPED + INVITE_LEN], @as(usize, cl[FV_INVLEN]), "T27-XXXX-XXXX-XXXX-XXXX-C");
    draw_cl_btn(c, kit, cv_btn_x(l, QP_W, 0), t + FV_BTN_Y, cv_btn_w(QP_W), "ADD", l + QP_W, hit == FV_H_ADD);
    var dword : []const u8 = "DEBUG";
    if (debug) { dword = "HIDE DEBUG"; }
    draw_cl_btn(c, kit, cv_btn_x(l, QP_W, 1), t + FV_BTN_Y, cv_btn_w(QP_W), dword, l + QP_W, hit == FV_H_DEBUG);
    // the note under the buttons: a result of the last action, or why the friend that was clicked cannot be called
    const code : u32 = @as(u32, cl[CL_NOTE]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (code >= 32 and code < 38) {
        n = put_bytes(line[0..96], 0, "Cannot call now: ");
        const why : []const u8 = fv_offline_text(code);
        n = put_bytes(line[0..96], n, why);
        draw_cl_wrap(c, kit, line[0..n], x, right, t + FV_NOTE_Y, 9.5, 3, sh);
    } else if (fv_note_is_mine(code)) {
        draw_cl_wrap(c, kit, fv_note_text(code), x, right, t + FV_NOTE_Y, 9.5, 3, sh);
    } else {
        draw_cl_note(c, kit, cl, code, x, right, t + FV_NOTE_Y, sh);
    }
    if (debug) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_bytes(c, kit, "DEBUG: ADDRESS, CALLED WITH THE KEY TYPED ABOVE", 46, x, t + FV_DBG_LABEL_Y, 9.0, 0.0, false);
        var dhint : []const u8 = "192.168.1.10:47727";
        if (cl[CL_V6_QA] != 0) { dhint = "192.168.1.10:47727 or [IPv6]:47727"; }
        draw_cl_field(c, kit, cv_field_x(l), t + FV_DFIELD_Y, cv_field_w(QP_W), cl[CL_FOCUS] == 1, hit == FV_H_DFIELD, cl[CL_V6_TXT .. CL_V6_TXT + IP6_TEXT_MAX], @as(usize, cl[CL_V6_ALEN]), dhint);
        draw_cl_btn(c, kit, cv_btn_x(l, QP_W, 0), t + FV_DCALL_Y, cv_btn_w(QP_W), "CALL", l + QP_W, hit == FV_H_DCALL);
        // a public address (call_view section 7): ALLOW while it waits for consent, the row, and the port forward hint
        const prow : u32 = cl_pub_row(cl);
        if (prow != 0) {
            if (prow == 1) { draw_cl_btn(c, kit, cv_btn_x(l, QP_W, 1), t + FV_DCALL_Y, cv_btn_w(QP_W), "ALLOW", l + QP_W, hit == FV_H_DALLOW); }
            const pt : []const u8 = cv_pub_row_text(prow, cl[CL_PUBENV] != 0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_fit(c, kit, pt, pt.len, x, t + FV_PUB_Y, 9.5, WEIGHT_SEMIBOLD, false, right);
            var hb : [120]u8 = undefined;
            var hep : [18]u8 = undefined;
            var hport : u64 = 0;
            if (cl_typed_ep(cl, hep[0..18])) { hport = ip6_port(hep[0..18]); }
            var hn : usize = cv_pub_hint(hport, hb[0..120]);
            // there is no NAT on IPv6: no port to forward, the friend's router lets the call in after its probes
            if (hport != 0 and !ip6_mapped(hep[0..18])) { hn = put_bytes(hb[0..120], 0, "IPv6: no port to forward; ask the friend to start the punch toward you first."); }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            draw_cl_wrap(c, kit, hb[0..hn], x, right, t + FV_PUBHINT_Y, 9.0, 3, sh);
        }
    }
}

/// The video of the call under the counters: a line with the indicator ("VIDEO ON" while frames arrive, "NO VIDEO"
/// otherwise) and the frames shown / skipped, then the last picture at 4:3 in the width of the panel, as high as the
/// window leaves room for; a dark box with a word while there is no picture yet.
fn draw_cl_video(c: u64, kit: [48]u64, x: f64, right: f64, y: f64, sh: f64, cl: []const u8) -> void {
    if (cl[CL_GV] != 0) {
        draw_cl_gvideo(c, kit, x, right, y, sh, cl);
        return;
    }
    var line : [120]u8 = undefined;
    const live : bool = cl[CL_VLIVE] != 0;
    draw_cl_dot(c, kit, x, y - 8.0, live);
    var n : usize = 0;
    if (live) { n = put_bytes(line[0..120], 0, "VIDEO ON  "); } else { n = put_bytes(line[0..120], 0, "NO VIDEO  "); }
    // what arrives and what leaves: frames a second, size, kbit/s (call_h264 vh_side_text: "-" for nothing)
    n = vh_side_text(line[0..120], n, "in", @as(u64, cl[CL_VH_RXFPS]), cl_get16(cl, CL_VH_RXW), cl_get16(cl, CL_VH_RXH), cl_get16(cl, CL_VH_RXK));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..120], n, x + 14.0, y, 9.5, WEIGHT_SEMIBOLD, true, right);
    n = vh_side_text(line[0..120], 0, "out", @as(u64, cl[CL_VH_TXFPS]), cl_get16(cl, CL_VH_TXW), cl_get16(cl, CL_VH_TXH), cl_get16(cl, CL_VH_TXK));
    n = put_bytes(line[0..120], n, "   frames ");
    n = put_dec(line[0..120], n, cl_get32(cl, CL_VSHOWN));
    n = put_bytes(line[0..120], n, " lost ");
    n = put_dec(line[0..120], n, cl_get32(cl, CL_VSKIP));
    draw_fit(c, kit, line[0..120], n, x + 14.0, y + 12.0, 9.5, 0.0, true, right);
    // why the picture is small, or that the camera gave up
    const note : u32 = @as(u32, cl[CL_VH_NOTE]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    if (note != 0) {
        const nt : []const u8 = vn_note(note);
        draw_fit(c, kit, nt, nt.len, x + 14.0, y + 24.0, 9.0, 0.0, true, right);
    } else if (cl_cam_unavailable(cl)) {
        draw_fit(c, kit, "camera unavailable", 18, x + 14.0, y + 24.0, 9.0, 0.0, true, right);
    }
    const top : f64 = cv_vbox_top(y);
    const room : f64 = sh - top - 16.0;
    const wide : bool = cl[CL_VH_RWIDE] != 0;
    const w : f64 = cv_vbox_w(right - x, room, wide);
    const h : f64 = cv_vbox_h(right - x, room, wide);
    if (h < 24.0) { return; }
    // the picture itself is the remote layer over this box (cl_layers); the box and its word show until it comes
    draw_cl_pic(c, kit, x, top, w, h, 0, right, cl[CL_VH_RPIC] != 0);
    draw_cl_self(c, kit, x, top, w, h, cl);
}

/// The self-view over the remote picture's bottom-right corner (call_view cv_self_*): the user's own camera, mirrored,
/// named YOU; an empty inset before the first frame; "camera off" when there is no camera picture to show.
fn draw_cl_self(c: u64, kit: [48]u64, rx: f64, ry: f64, rw: f64, rh: f64, cl: []const u8) -> void {
    const mode : u32 = cv_self_mode(CV_ACTIVE, cl[CL_GV] != 0, cl[CL_VSEND] != 0, cl[CL_CAMOFF] != 0, cl[CL_NOCAM] != 0,
        cl_cam_unavailable(cl), cl[CL_VH_SPIC] != 0);
    if (mode == CV_SELF_NONE) { return; }
    if (mode == CV_SELF_OFF) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, cv_self_off_text(), 10, rx + 8.0, ry + rh - 8.0, 9.0, 0.0, true, rx + rw);
        return;
    }
    if (!cv_self_fits(rw, rh)) { return; }
    const sw : f64 = cv_self_w(rw);
    const sh : f64 = sw * 0.75;
    const sx : f64 = cv_self_x(rx, rw, sw);
    const sy : f64 = cv_self_y(ry, rh, sw);
    // the own picture is a layer over this inset (cl_layers): drawn here only the empty inset before its first frame
    if (mode == CV_SELF_PIP) { return; }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.55);
    cg_fill_rect(c, sx, sy, sw, sh);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.85);
    cg_fill_rect(c, sx, sy, sw, HAIR);
    cg_fill_rect(c, sx, sy + sh - HAIR, sw, HAIR);
    cg_fill_rect(c, sx, sy, HAIR, sh);
    cg_fill_rect(c, sx + sw - HAIR, sy, HAIR, sh);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, cv_self_label(), 3, sx + 4.0, sy + 11.0, 9.0, WEIGHT_SEMIBOLD, true, sx + sw);
}

/// A picture in a box of w x h at (x, top), drawn upright, with a hairline frame; a dark box with a word without one.
fn draw_cl_pic(c: u64, kit: [48]u64, x: f64, top: f64, w: f64, h: f64, img: u64, right: f64, layered: bool) -> void {
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.45);
    cg_fill_rect(c, x, top, w, h);
    if (layered) {
        // a layer shows the picture over this box
    } else if (img != 0) {
        cg_save(c);
        cg_translate(c, x, top + h);
        cg_scale(c, 1.0, -1.0);
        cg_draw_image(c, 0.0, 0.0, w, h, img);
        cg_restore(c);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, "waiting for video", 17, x + 8.0, top + 0.5 * h, 9.5, 0.0, true, right);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, x, top, w, HAIR);
    cg_fill_rect(c, x, top + h - HAIR, w, HAIR);
    cg_fill_rect(c, x, top, HAIR, h);
    cg_fill_rect(c, x + w - HAIR, top, HAIR, h);
}

/// The video of a group call (owner, 2026-10-23): the line ("VIDEO ON" / "NO VIDEO", how many shown, how many heard
/// only), then the strip (call_view cv_strip_*): one tile per shown member, at most two, each named by the first four
/// hex digits of its key; one member takes the width of the panel.
fn draw_cl_gvideo(c: u64, kit: [48]u64, x: f64, right: f64, y: f64, sh: f64, cl: []const u8) -> void {
    var line : [96]u8 = undefined;
    const live : bool = cl[CL_GV_LIVE] != 0;
    const n : u32 = @as(u32, cl[CL_GV]) - 1;
    draw_cl_dot(c, kit, x, y - 8.0, live);
    var k : usize = 0;
    if (live) { k = put_bytes(line[0..96], 0, "VIDEO ON"); } else { k = put_bytes(line[0..96], 0, "NO VIDEO"); }
    k = put_bytes(line[0..96], k, "   group   ");
    k = put_dec(line[0..96], k, @as(u64, n));
    k = put_bytes(line[0..96], k, " shown");
    if (cl[CL_GV_MORE] != 0) {
        k = put_bytes(line[0..96], k, "   +");
        k = put_dec(line[0..96], k, @as(u64, cl[CL_GV_MORE]));
        k = put_bytes(line[0..96], k, " by voice");
    }
    if (cl_cam_unavailable(cl)) { k = put_bytes(line[0..96], k, "   camera unavailable"); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..96], k, x + 14.0, y, 9.5, WEIGHT_SEMIBOLD, true, right);
    const top : f64 = y + 10.0;
    var tiles : u32 = n;
    if (tiles == 0) { tiles = 1; }
    const tw : f64 = cv_strip_w(tiles, right - x, sh - top - 16.0);
    const th : f64 = cv_strip_h(tw);
    if (th < 24.0) { return; }
    var i : u32 = 0;
    while (i < tiles) {
        const tx : f64 = cv_strip_x(i, x, tw);
        const iu : usize = @as(usize, i);
        draw_cl_pic(c, kit, tx, top, tw, th, cl_gvimg(cl, iu), tx + tw, false);
        if (i < n) {
            var tag : [16]u8 = undefined;
            const tn : usize = cl_hex2(tag[0..16], cl[CL_GV_TAG + 2 * iu], cl[CL_GV_TAG + 2 * iu + 1]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            draw_fit(c, kit, tag[0..16], tn, tx + 2.0, top + th + CV_STRIP_LABEL - 3.0, 9.0, 0.0, true, tx + tw);
        }
        i = i + 1;
    }
}

/// Two bytes as four lowercase hex digits (a member's tag under its tile); its length.
pub fn cl_hex2(out: []u8, a: u8, b: u8) -> usize {
    var i : usize = 0;
    while (i < 4) {
        var v : u8 = a;
        if (i >= 2) { v = b; }
        var d : u8 = v / 16;
        if (i % 2 == 1) { d = v % 16; }
        if (d < 10) { out[i] = 48 + d; } else { out[i] = 87 + d; }
        i = i + 1;
    }
    return 4;
}

/// A note of call_view; CV_N_PORTS names every port that was tried and taken.
fn draw_cl_note(c: u64, kit: [48]u64, cl: []const u8, code: u32, x: f64, right: f64, y: f64, sh: f64) -> void {
    if (code == CV_N_PORTS) {
        var t : [200]u8 = undefined;
        const n : usize = cv_port_all_busy_text(cl_base_port(cl), 0, cl_port_busy(cl), @as(u64, cl[CL_PTRIED]), t[0..CV_PORT_NOTE_CAP]);
        if (n > 0) {
            draw_cl_wrap(c, kit, t[0..n], x, right, y, 9.5, 3, sh);
            return;
        }
    }
    draw_cl_wrap(c, kit, cv_note_text(code), x, right, y, 9.5, 3, sh);
}

fn draw_call_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, cl: []const u8, ch: []const u8) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "CALL", 4, x, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    const view : u32 = @as(u32, cl[CL_VIEW]);
    var line : [96]u8 = undefined;
    // this device: where it listens and the fingerprint of its identity (the key a friend calls)
    // online or not and on which port; when the configured port was taken, which one and which is used instead
    var pl : [160]u8 = undefined;
    const pn : usize = cl_listen_status(cl, pl[0..160]);
    draw_cl_dot(c, kit, x, t + CL_PORT_Y - 8.0, cl[CL_UP] != 0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, pl[0..160], pn, x + 14.0, t + CL_PORT_Y, 9.5, WEIGHT_SEMIBOLD, false, right);
    // who gets through (call_view cv_who): every call rings for the person; where it listens is the line above
    var n : usize = put_bytes(line[0..96], 0, cv_who());
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..96], n, x, t + CV_ME_Y, 9.5, 0.0, false, right);
    if (cl[CL_UP] != 0) {
        n = put_bytes(line[0..96], 0, "fp ");
        n = n + fp_text(cl[FE_FP .. FE_FP + 10], line[n..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + CV_FPME_Y, 9.5, 0.0, true, right);
    }
    if (view == CV_IDLE) {
        draw_cl_front(c, kit, sh, mx, my, l, t, cl, ch);
        return;
    }
    const hit : u32 = cv_hit(mx, my, l, QP_W, t, view);
    if (view != CV_IDLE) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        const tt : []const u8 = cv_title(view);
        draw_fit(c, kit, tt, tt.len, x, t + CV_TITLE_Y, 14.0, WEIGHT_SEMIBOLD, false, right);
        // who: the friend the fingerprint belongs to (the nickname that friend announced), else the address a test
        // fingerprint names, else "someone not in your friends" with the invite that adds them
        const fa : u64 = cv_fp_addr(cl[CL_PFP .. CL_PFP + 10]);
        const fr : usize = fv_find_fp(cl, cl[CL_PFP .. CL_PFP + 10]);
        n = put_bytes(line[0..96], 0, "WITH  ");
        if (fr < FV_ROWS_SNAP) {
            const fnl : usize = @as(usize, cl[fv_row_at(fr) + FR_NICKLEN]);
            if (fnl > 0) {
                var fk : usize = 0;
                while (fk < fnl) {
                    line[n + fk] = cl[fv_row_at(fr) + FR_NICK + fk];
                    fk = fk + 1;
                }
                n = n + fnl;
                n = put_bytes(line[0..96], n, "  (friend)");
            } else {
                n = put_bytes(line[0..96], n, "a friend");
            }
        } else if (fa != 0) {
            n = n + cv_addr_text(cv_addr_ip(fa), cv_addr_port(fa), line[n..96]);
        } else {
            n = put_bytes(line[0..96], n, "someone not in your friends");
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + CV_PEER_Y, 11.0, 0.0, false, right);
        if (fr >= FV_ROWS_SNAP and fa == 0) {
            n = put_bytes(line[0..96], 0, "invite ");
            invite_make(cl[CL_PFP .. CL_PFP + 10], line[n..96]);
            n = n + INVITE_LEN;
        } else {
            n = put_bytes(line[0..96], 0, "fp ");
            n = n + fp_text(cl[CL_PFP .. CL_PFP + 10], line[n..96]);
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + CV_PFP_Y, 9.5, 0.0, true, right);
        var big : [16]u8 = undefined;
        if (view == CV_COMPARE or view == CV_WAIT) {
            const bn : usize = cv_code_text(cl[CL_CODE .. CL_CODE + 6], big[0..16]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_bytes(c, kit, big[0..16], bn, x, t + CV_BIG_Y, 34.0, WEIGHT_SEMIBOLD, true);
        } else if (view == CV_ACTIVE) {
            const bn : usize = cv_clock(cl_get32(cl, CL_SECS), big[0..16]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            const cw : f64 = draw_bytes(c, kit, big[0..16], bn, x, t + CV_BIG_Y, 34.0, WEIGHT_SEMIBOLD, true);
            n = put_bytes(line[0..96], 0, "code ");
            n = n + cv_code_text(cl[CL_CODE .. CL_CODE + 6], line[n..96]);
            if (cl[CL_MUTED] != 0) { n = put_bytes(line[0..96], n, "   MIC OFF"); }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            draw_fit(c, kit, line[0..96], n, x + cw + 14.0, t + CV_BIG_Y - 4.0, 9.5, WEIGHT_SEMIBOLD, true, right);
        } else if (view == CV_ENDED or view == CV_FAILED) {
            const rt : []const u8 = cl_reason_text(@as(u32, cl[CL_REASON]));
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_cl_wrap(c, kit, rt, x, right, t + CV_BIG_Y - 30.0, 11.0, 2, sh);
            if (cl[CL_TALKED] != 0) {
                n = put_bytes(line[0..96], 0, "lasted ");
                n = n + cv_clock(cl_get32(cl, CL_SECS), line[n..96]);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
                draw_fit(c, kit, line[0..96], n, x, t + CV_BIG_Y, 11.0, 0.0, true, right);
            }
        }
    }
    // the buttons of the view (call_view cv_btn_word), one row
    var b : u32 = 0;
    while (b < cv_btn_count(view)) {
        const word : []const u8 = cv_btn_word(view, b, cl[CL_MUTED] != 0);
        draw_cl_btn(c, kit, cv_btn_x(l, QP_W, b), cv_row_y(t, view), cv_btn_w(QP_W), word, sw, hit == CV_H_B0 + b);
        b = b + 1;
    }
    if (view == CV_IDLE) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_cl_note(c, kit, cl, @as(u32, cl[CL_NOTE]), x, right, t + CV_NOTE_Y, sh);
        return;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_cl_wrap(c, kit, cv_hint(view), x, right, t + CV_HINT_Y, 9.5, 3, sh);
    if (view == CV_ACTIVE or ((view == CV_ENDED or view == CV_FAILED) and cl[CL_TALKED] != 0)) {
        // what the session counted: sealed frames sent and accepted, AEAD refusals, the longest gap between two polls
        n = put_bytes(line[0..96], 0, "sent ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_SENT));
        n = put_bytes(line[0..96], n, "  received ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_RECV));
        n = put_bytes(line[0..96], n, "  rejected ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_REJ));
        // the family the call uses (call_ip6 ip6_fam): v4, v6 or v4-mapped; a network word, so with T27OS_QA=1 only
        const fw : []const u8 = ip6_fam_word(@as(u32, cl[CL_V6_FAM]));
        if (fw.len > 0 and cl[CL_V6_QA] != 0) {
            n = put_bytes(line[0..96], n, "  ");
            n = put_bytes(line[0..96], n, fw);
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + CV_HINT_Y + 44.0, 9.5, 0.0, true, right);
        n = put_bytes(line[0..96], 0, "poll gap max ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_GAP));
        n = put_bytes(line[0..96], n, " ms  over 10 ms ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_N10));
        n = put_bytes(line[0..96], n, " of ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_NPOLL));
        draw_fit(c, kit, line[0..96], n, x, t + CV_HINT_Y + 58.0, 9.5, 0.0, true, right);
        n = put_bytes(line[0..96], 0, "audio captured ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_CAPT));
        n = put_bytes(line[0..96], n, "  underruns ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_UNDER));
        n = put_bytes(line[0..96], n, "  overruns ");
        n = put_dec(line[0..96], n, cl_get32(cl, CL_OVER) + cl_get32(cl, CL_TXO));
        draw_fit(c, kit, line[0..96], n, x, t + CV_HINT_Y + 72.0, 9.5, 0.0, true, right);
    }
    if (view == CV_ACTIVE) { draw_cl_video(c, kit, x, right, t + CV_HINT_Y + 90.0, sh, cl); }
}

// ======================================================================================================
// A. ACCOUNT (owner, 2026-10-22; Refs gHashTag/t27#11560). account_view.t27 decides (the boxes, what a hit is, the
// scroll of a long list, the key to copy, the lines of text), friends_engine.t27 holds the friends (a window of the
// list from FV_SCROLL, remove), profile.t27 the nickname. This block only keeps the mode, draws it, and turns a hit into
// one call.
//   - the cabinet is the IDLE view of the CALL panel in a second mode (AC_ON): the profile circle in the title bar
//     opens it; a call that rings shows its own view over it; PROFILE (the picture) opens from the link in it;
//   - MY KEY: the T27-... string, a click on it or on COPY KEY puts it on the clipboard (pb_copy, the same bytes
//     a friend pastes into ADD A FRIEND); the short fingerprint stands beside it;
//   - a friend's row: a click opens the friend's card (block CH: MESSAGE, CALL, VIDEO); the unread count stands on the
//     row; COPY puts the friend's key on the clipboard; the x asks REMOVE? and only YES removes.
// ======================================================================================================
pub const AC_WHEEL_STEP : f64 = 14.0;

/// The cabinet is the mode of the panel (the call view may be over it).
pub fn ac_shown_mode(cl: []const u8) -> bool { return cl[AC_ON] != 0; }

/// The cabinet is what the panel shows: the mode is on and no call is in the way.
pub fn ac_shown(cl: []const u8) -> bool { return cl[AC_ON] != 0 and cl[CL_VIEW] == 0; }

/// Open the cabinet: the list from its first friend, no field typed in, no note.
pub fn ac_open(cl: []u8) -> void {
    cl[AC_ON] = 1;
    cl[CL_FOCUS] = 0;
    cl[CL_NOTE] = 0;
    ac_conf_clear(cl);
    fe_scroll(cl, 0, ckh_ms());
}

/// Leave the cabinet (closed, or the CALL pill taken instead): a nickname half typed is dropped, a removal that asked is
/// forgotten, the list goes back to its first friend for the CALL panel. Nothing happens when the cabinet was not open.
pub fn ac_leave(cl: []u8, pf: []u8) -> void {
    if (cl[AC_ON] == 0) { return; }
    cl[AC_ON] = 0;
    cl[CL_FOCUS] = 0;
    ac_conf_clear(cl);
    hv_close(cl);
    pf_leave(pf, PRF_EV_CLOSE);
    fe_scroll(cl, 0, ckh_ms());
}

/// The UPDATE part shows its button (update_view.upv_button: UPDATE, CANCEL or RESTART).
pub fn ac_upd_shown(cl: []const u8) -> bool { return upv_button(@as(u32, cl[UPV_ST]), upv_has_offer(cl)) != UPV_B_NONE; }

/// What a point means in the cabinet at this window size.
/// The PUBLIC line answers as LOOK UP: calls are up (the key and the line are shown) and a lookup may be asked for.
pub fn cn_shown(cl: []const u8) -> bool { return cl.len >= CL_CAP and cl[CL_UP] != 0 and cn_can_ask(@as(u32, cl[CL_N_ST])); }

pub fn ac_hit_now(x: f64, y: f64, sw: f64, sh: f64, cl: []const u8) -> u32 {
    const h : f64 = sh - WS_TOP;
    const vis : usize = ac_rows_vis(h);
    const raw : u32 = ac_hit(x, y, qp_left(sw), QP_W, WS_TOP, h, ac_rows_drawn(@as(usize, cl[FV_SHOWN]), vis), @as(usize, cl[FV_COUNT]), vis, ac_conf_row(cl), ac_upd_shown(cl));
    const r1 : u32 = ac_hit_stun(x, y, qp_left(sw), QP_W, WS_TOP, cn_shown(cl), ac_hit_qr(x, y, qp_left(sw), QP_W, WS_TOP, h, 0.0, cl[CL_UP] != 0, ac_qr_is_big(cl), raw));
    return ac_hit_v6(x, y, qp_left(sw), QP_W, WS_TOP, cn6_shown(cl), r1);
}

/// The PUBLIC v6 line is drawn: only with T27OS_QA=1 (an ordinary view names no address, owner 2026-10-23), while calls
/// are up and this device has a global IPv6 (call_ip6 ip6_own_rank).
pub fn cn6_shown(cl: []const u8) -> bool { return cl.len >= CL_CAP and cl[CL_V6_QA] != 0 and cl[CL_UP] != 0 and cl[CL_V6_OWNR] != 0; }

/// The friends rows that fit while the invitations are shown (account_view ac_inv_dy).
pub fn ac_vis_now(sh: f64, iv: []const u8) -> usize { return ac_vis_now_g(sh, iv, iv[0..0], iv[0..0]); }

/// GR. The rows of the GROUPS part (group_view gv_rows) for the groups' region gv; 0 for an empty slice (no part).
pub fn gw_part_rows(cl: []const u8, gv: []const u8, h: f64, dy: f64) -> usize {
    if (gv.len < GV_CAP or cl.len < CL_CAP) { return 0; }
    return gw_rows(cl, gv, h, dy);
}

/// The room the GROUPS part takes from the friends.
pub fn gw_part_room(rows: usize) -> f64 {
    if (rows == 0) { return 0.0; }
    return gv_part_h(rows);
}

/// ac_vis_now with the GROUPS part under the friends.
pub fn ac_vis_now_g(sh: f64, iv: []const u8, cl: []const u8, gv: []const u8) -> usize {
    const h : f64 = sh - WS_TOP;
    const dy : f64 = ac_inv_dy(ac_inv_rows(iv_waiting(iv)));
    return ac_rows_vis(h - dy - gw_part_room(gw_part_rows(cl, gv, h, dy)));
}

/// ac_hit_now with the INVITATIONS part of the invitations table iv.
pub fn ac_hit_now_iv(x: f64, y: f64, sw: f64, sh: f64, cl: []const u8, iv: []const u8) -> u32 { return ac_hit_now_iv_g(x, y, sw, sh, cl, iv, iv[0..0]); }

/// ac_hit_now_iv with the friends' rows that the GROUPS part leaves.
pub fn ac_hit_now_iv_g(x: f64, y: f64, sw: f64, sh: f64, cl: []const u8, iv: []const u8, gv: []const u8) -> u32 {
    const h : f64 = sh - WS_TOP;
    const inv : usize = ac_inv_rows(iv_waiting(iv));
    const vis : usize = ac_vis_now_g(sh, iv, cl, gv);
    const raw : u32 = ac_hit_inv(x, y, qp_left(sw), QP_W, WS_TOP, h, inv, ac_rows_drawn(@as(usize, cl[FV_SHOWN]), vis), @as(usize, cl[FV_COUNT]), vis, ac_conf_row(cl), ac_upd_shown(cl));
    return ac_hit_v6(x, y, qp_left(sw), QP_W, WS_TOP, cn6_shown(cl), ac_hit_stun(x, y, qp_left(sw), QP_W, WS_TOP, cn_shown(cl), ac_hit_qr(x, y, qp_left(sw), QP_W, WS_TOP, h, ac_inv_dy(inv), cl[CL_UP] != 0, ac_qr_is_big(cl), raw)));
}

/// The wheel takes a step over the friends part, wherever the invitations moved it.
pub fn ac_wheel_now(x: f64, y: f64, sw: f64, sh: f64, iv: []const u8) -> bool { return ac_wheel_now_g(x, y, sw, sh, iv, iv[0..0], iv[0..0]); }

/// ac_wheel_now with the GROUPS part under the friends.
pub fn ac_wheel_now_g(x: f64, y: f64, sw: f64, sh: f64, iv: []const u8, cl: []const u8, gv: []const u8) -> bool {
    return ac_wheel_area(x, y, qp_left(sw), QP_W, WS_TOP + ac_inv_dy(ac_inv_rows(iv_waiting(iv))), ac_vis_now_g(sh, iv, cl, gv));
}

// ---------------------------------------------------------------- IV. invitations (invites.t27, owner 2026-10-22)
// A message session from someone who is not a friend is answered (unless the person declined that key less than an
// hour ago), proves its key and ends by itself with CS_R_INVITE; ivw_take writes the invitation. It never opens: no
// line reaches a log, no call is answered. ACCEPT makes it a friend with the proven key stored; DECLINE hides it.

/// The proven key of an ended invitation session into the table; IV_A_* (0 when the peer is a friend by now, or is
/// this device). The friends table is not touched: only ACCEPT adds a friend.
pub fn ivw_record(cl: []const u8, iv: []u8, fp: []const u8, key: []const u8, nick: []const u8, nn: usize, now: u64) -> u32 {
    if (ft_find(cl[FE_FT .. FE_FT + FT_LEN], fp) != FT_MAX) { return 0; }
    if (ch_same_fp(fp, cl[FE_FP .. FE_FP + 10])) { return 0; }
    return iv_arrive(iv, fp, key, nick, nn, now);
}

/// One stderr line per invitation (the short key only, never a key): "INVITE abcd-1234 new|again|same|quiet|...".
fn ivw_log(fp: []const u8, word: []const u8) -> void {
    var line : [64]u8 = undefined;
    var n : usize = put_bytes(line[0..64], 0, "INVITE ");
    n = n + fv_short_fp(fp, line[n..64]);
    n = put_bytes(line[0..64], n, " ");
    n = put_bytes(line[0..64], n, word);
    sys_write(2, line[0..n], @as(u64, n));
    sys_write(2, "\n", 1);
}

fn ivw_word(r: u32) -> str {
    if (r == IV_A_NEW) { return "new"; }
    if (r == IV_A_SAME) { return "same"; }
    if (r == IV_A_AGAIN) { return "again"; }
    if (r == IV_A_QUIET) { return "quiet"; }
    return "refused";
}

/// The message session s just ended as an invitation: its fingerprint and proven key, the nickname the network
/// announces for it, into the table, which is saved.
pub fn ivw_take(cl: []u8, s: []const u8, iv: []u8, now: u64) -> void {
    var fp : [10]u8 = undefined;
    var k : [65]u8 = undefined;
    if (cs_id_proven(s, fp[0..10], k[0..65]) == false) { return; }
    var nb : [32]u8 = undefined;
    const nn : usize = fe_nick_for(cl, fp[0..10], nb[0..32]);
    const r : u32 = ivw_record(cl, iv, fp[0..10], k[0..65], nb[0..32], nn, now);
    if (r == 0) { return; }
    if (r == IV_A_NEW or r == IV_A_SAME or r == IV_A_AGAIN or r == IV_A_QUIET) { ih_invites_save(iv); }
    ivw_log(fp[0..10], ivw_word(r));
}

/// A session rings from someone who is not a friend: answered, so it proves its key and becomes an invitation; declined
/// while it rings when the person declined that key less than an hour ago.
pub fn ivw_ringing(cl: []const u8, s: []u8, iv: []const u8, now: u64) -> void {
    var rf : [10]u8 = undefined;
    if (chm_ringing(s, rf[0..10]) == false) { return; }
    if (ft_find(cl[FE_FT .. FE_FT + FT_LEN], rf[0..10]) != FT_MAX) { return; }
    if (chm_stranger_answer(iv_quiet(iv, rf[0..10], now))) { cs_answer(s); } else { cs_decline(s); }
}

/// ACCEPT of the invitation in view at k, without the files: the friend added (friends_engine fe_accept, which saves the
/// friends file when it is usable) with the row's nickname, the row's fingerprint and key out, the row removed. The
/// FN_* note; 0 when there is no such row.
pub fn ivw_accept_core(cl: []u8, iv: []u8, k: usize, now: u64, fp: []u8, key: []u8) -> u32 {
    const row : usize = ac_inv_row_of(iv, k);
    if (row == IV_MAX) { return 0; }
    iv_fp(iv, row, fp);
    iv_key(iv, row, key);
    var nb : [24]u8 = undefined;
    const nn : usize = @as(usize, iv[iv_at(row) + IR_NICKLEN]);
    var i : usize = 0;
    while (i < 24) {
        nb[i] = iv[iv_at(row) + IR_NICK + i];
        i = i + 1;
    }
    const note : u32 = fe_accept(cl, fp, nb[0..24], nn, now);
    if (note == FN_ADDED or note == FN_DUP or note == FN_NOSAVE) { iv_remove(iv, fp); }
    return note;
}

/// DECLINE of the invitation in view at k, without the file. False when there is no such row.
pub fn ivw_decline_core(iv: []u8, k: usize, now: u64) -> bool {
    const row : usize = ac_inv_row_of(iv, k);
    if (row == IV_MAX) { return false; }
    var fp : [10]u8 = undefined;
    iv_fp(iv, row, fp[0..10]);
    return iv_decline(iv, fp[0..10], now);
}

/// ACCEPT or DECLINE clicked: the table and the files; after ACCEPT the friend's key is stored (ih_pin_put checks again
/// that it hashes to the fingerprint), so the next session of this person is TRUSTED and the chat opens.
pub fn ivw_click(cl: []u8, iv: []u8, hit: u32, now: u64) -> void {
    const k : usize = ac_inv_hit_k(hit);
    cl[CL_NOTE] = 0;
    if (ac_inv_hit_accept(hit)) {
        var fp : [10]u8 = undefined;
        var key : [65]u8 = undefined;
        const note : u32 = ivw_accept_core(cl, iv, k, now, fp[0..10], key[0..65]);
        if (note == 0) { return; }
        if (note == FN_ADDED or note == FN_DUP) { ih_pin_put(fp[0..10], key[0..65]); }
        cl[CL_NOTE] = @as(u8, @intCast(note));
        ih_invites_save(iv);
        ivw_log(fp[0..10], "accepted");
    } else if (ivw_decline_core(iv, k, now)) {
        ih_invites_save(iv);
    }
}

/// This device's key to the clipboard; "copied" stands above the key for 2 s. Without an identity there is nothing to
/// copy and the note says why.
pub fn ac_copy_mine(cl: []u8, now: u64) -> void {
    var k : [32]u8 = undefined;
    const n : usize = ac_my_key(cl, k[0..32]);
    if (n == 0) {
        cl[CL_NOTE] = @as(u8, @intCast(FN_IDENT));
        return;
    }
    pb_copy(k[0..32], n);
    ac_note_copy(cl, AC_L_MINE);
    ac_flash_set(cl, AC_L_MINE, now);
    cl[CL_NOTE] = @as(u8, @intCast(FN_COPIED));
}

/// PASTE: the clipboard text (from its first "T27-") into the add field, in place of what stood there.
pub fn ac_paste_key(cl: []u8) -> void {
    var b : [256]u8 = undefined;
    const n : usize = pb_text(b[0..256]);
    cl[CL_FOCUS] = 2;
    cl[FV_INVLEN] = 0;
    cl[CL_NOTE] = 0;
    var i : usize = ac_paste_find(b[0..256], n);
    while (i < n) {
        cl_unit(cl, @as(u32, b[i]));
        i = i + 1;
    }
    if (cl[FV_INVLEN] == 0) { cl[CL_NOTE] = @as(u8, @intCast(FN_EMPTY)); }
}

/// ADD (or Return in the field): the typed key as a friend; a friend just added comes into view.
pub fn ac_add(cl: []u8, vis: usize) -> void {
    const note : u32 = cl_add(cl);
    cl[CL_NOTE] = @as(u8, @intCast(note));
    if (note == FN_ADDED or note == FN_NOSAVE) {
        fe_scroll(cl, ac_max_scroll(@as(usize, cl[FV_COUNT]), vis), ckh_ms());
    }
}

/// One hit in the cabinet as one action. 0 normally; 1 when the person asked for the picture (the window opens PROFILE).
pub fn ac_do(cl: []u8, s: []u8, w: []u64, pf: []u8, hit: u32, vis: usize) -> u32 {
    cl[CL_FOCUS] = 0;
    if (hit != AC_H_NICK and hit != AC_H_SAVE and pf_editing(pf)) { pf_leave(pf, PRF_EV_CANCEL); }
    // CALL and MESSAGE go through the friend's card (ac_call_or_message), not through here
    if (hit == AC_H_NONE or ac_hit_action(hit) != AC_A_NONE) {
        ac_conf_clear(cl);
        return 0;
    }
    cl[CL_NOTE] = 0;
    const now : u64 = ckh_ms();
    if (hit >= AC_H_NO) {
        ac_conf_clear(cl);
        return 0;
    }
    if (hit >= AC_H_YES) {
        const row : usize = @as(usize, hit - AC_H_YES);
        ac_conf_clear(cl);
        cl[CL_NOTE] = @as(u8, @intCast(fe_remove(cl, row, now)));
        fe_scroll(cl, ac_clamp_scroll(@as(usize, cl[FV_SCROLL]), @as(usize, cl[FV_COUNT]), vis), now);
        return 0;
    }
    if (hit >= AC_H_DEL) {
        const row : usize = @as(usize, hit - AC_H_DEL);
        ac_conf_clear(cl);
        if (row < @as(usize, cl[FV_SHOWN])) {
            var fp : [10]u8 = undefined;
            var k : usize = 0;
            while (k < 10) {
                fp[k] = cl[fv_row_at(row) + FR_FP + k];
                k = k + 1;
            }
            ac_conf_set(cl, fp[0..10]);
        }
        return 0;
    }
    ac_conf_clear(cl);
    if (hit >= AC_H_FCOPY) {
        var kb : [32]u8 = undefined;
        const kn : usize = ac_friend_key(cl, @as(usize, hit - AC_H_FCOPY), kb[0..32]);
        if (kn > 0) {
            pb_copy(kb[0..32], kn);
            ac_note_copy(cl, AC_L_FRIEND);
            ac_flash_set(cl, AC_L_FRIEND, now);
            cl[CL_NOTE] = @as(u8, @intCast(FN_FCOPIED));
        }
        return 0;
    }
    if (hit >= AC_H_ROW) {
        cl_front(cl, s, w, FV_H_ROW + (hit - AC_H_ROW));
        return 0;
    }
    if (hit == AC_H_KEY or hit == AC_H_COPYKEY) {
        ac_copy_mine(cl, now);
    } else if (hit == AC_H_QR) {
        ac_qr_toggle(cl);
    } else if (hit == AC_H_NICK) {
        pf_to_edit(pf);
    } else if (hit == AC_H_SAVE) {
        pf_save(pf);
    } else if (hit == AC_H_PICTURE) {
        return 1;
    } else if (hit == AC_H_UP or hit == AC_H_DOWN) {
        fe_scroll(cl, ac_scroll_by(@as(usize, cl[FV_SCROLL]), 1, hit == AC_H_UP, @as(usize, cl[FV_COUNT]), vis), now);
    } else if (hit == AC_H_IFIELD) {
        cl[CL_FOCUS] = 2;
    } else if (hit == AC_H_PASTE) {
        ac_paste_key(cl);
    } else if (hit == AC_H_ADD) {
        ac_add(cl, vis);
    }
    return 0;
}

/// CALL (in the head or on a row) or MESSAGE on a row: the friend's card is opened and its own CALL or MESSAGE is
/// pressed (ch_do), so the call and the chat go exactly the way they go from the card: an offline friend, calls off,
/// a friend not verified for messages each leave their reason on the card. True when the hit was one of these.
pub fn ac_call_or_message(cl: []u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64, cs: []u8, clw: []u64, pf: []u8, hit: u32, vis: usize) -> bool {
    const act : u32 = ac_hit_action(hit);
    if (act == AC_A_NONE) { return false; }
    ac_do(cl, cs, clw, pf, AC_H_NONE, vis);
    const row : usize = ac_hit_row(cl, hit);
    if (row >= FV_ROWS_SNAP) { return true; }
    ch_card(cl, v, row);
    var chit : u32 = CHV_H_CALL;
    if (act == AC_A_MESSAGE) { chit = CHV_H_MESSAGE; }
    ch_do(cl, v, s, m, log, buf, w, cs, clw, chit);
    return true;
}

// ---------------------------------------------------------------- A. BACKUP and RESTORE of the identity (id_backup.t27)
// The person keeps the identity in a file under a password and brings it back on a new device. id_backup.t27 decides
// the layout, the checks and the panel; id_backup_host.t27 seals, opens and moves the files. The password is in the
// panel's block only while typed, never drawn (stars), logged or folded into the frame key.

/// There is an identity to save: the one the friends engine opened checks (peer_identity id_check; public bytes only).
pub fn bk_have_id(cl: []const u8) -> bool { return id_check(cl[FE_ID .. FE_ID + ID_LEN]) == ID_OK; }

/// ac_hit_now_iv with BACKUP, RESTORE and the backup panel over it.
pub fn ac_hit_now_bk(x: f64, y: f64, sw: f64, sh: f64, cl: []const u8, iv: []const u8, bk: []const u8) -> u32 { return ac_hit_now_bk_g(x, y, sw, sh, cl, iv, bk, bk[0..0]); }

/// GR. The GROUPS part stands (the friends are shown: no backup panel, no large code in their place).
pub fn gw_part_shown(cl: []const u8, bk: []const u8) -> bool { return bk_open_shown(bk) == false and (ac_qr_is_big(cl) == false or cl[CL_UP] == 0); }

/// ac_hit_now_bk with the GROUPS part: "+", its arrows and rows answer GV_H_*, the rest of the part nothing.
pub fn ac_hit_now_bk_g(x: f64, y: f64, sw: f64, sh: f64, cl: []const u8, iv: []const u8, bk: []const u8, gv: []const u8) -> u32 {
    const h : f64 = sh - WS_TOP;
    const dy : f64 = ac_inv_dy(ac_inv_rows(iv_waiting(iv)));
    const rows : usize = gw_part_rows(cl, gv, h, dy);
    if (rows > 0 and gw_part_shown(cl, bk)) {
        const g : u32 = gv_hit(x, y, qp_left(sw), QP_W, WS_TOP, h, rows, gv_count(gv));
        if (g != GV_H_NONE) { return g; }
    }
    return bk_hit(x, y, qp_left(sw), QP_W, WS_TOP, h, dy, bk_have_id(cl), bk_mode(bk), ac_hit_now_iv_g(x, y, sw, sh, cl, iv, gv));
}

/// After an opening: a refusal leaves its note; the identity already in use says so; else the bytes wait for YES.
fn bk_settle(bk: []u8, st: u32, pt: []const u8, nfp: []const u8) -> void {
    if (st != BK_OK) {
        bk[BK_NOTE] = @as(u8, @intCast(bk_note_of(st)));
        return;
    }
    var id : [208]u8 = undefined;
    var ofp : [10]u8 = undefined;
    bk_wipe(ofp[0..10], 0, 10);
    const have : bool = bkh_current(id[0..208], ofp[0..10]);
    bk_wipe(id[0..208], 0, 208);
    var same : bool = have;
    var i : usize = 0;
    while (i < 10) {
        if (ofp[i] != nfp[i]) { same = false; }
        i = i + 1;
    }
    if (same) {
        bk[BK_NOTE] = @as(u8, @intCast(BK_N_SAME));
        return;
    }
    bk_hold(bk, pt, ofp[0..10], nfp);
}

/// SAVE (BACKUP) or OPEN (RESTORE), or Return in the password field. The password is wiped whatever happens.
pub fn bk_go(cl: []u8, bk: []u8) -> void {
    const m : u32 = bk_mode(bk);
    const pn : usize = @as(usize, bk[BK_PLEN]);
    if (m != BK_M_BACKUP and m != BK_M_RESTORE) { return; }
    if (bk_pass_ok(bk[BK_PASS .. BK_PASS + BK_PASS_MAX], pn) == false) {
        bk[BK_NOTE] = @as(u8, @intCast(BK_N_PASS));
        return;
    }
    if (m == BK_M_BACKUP) {
        var out : [BK_PATH_MAX]u8 = undefined;
        const note : u32 = bkh_save(bk[BK_PASS .. BK_PASS + BK_PASS_MAX], pn, out[0..BK_PATH_MAX]);
        bk_forget(bk);
        bk[BK_FOCUS] = 0;
        bk[BK_NOTE] = @as(u8, @intCast(note));
        if (note == BK_N_SAVED) {
            var k : usize = 0;
            while (k < BK_PATH_MAX and out[k] != 0) { k = k + 1; }
            bk_set_out(bk, out[0..BK_PATH_MAX], k);
        }
        return;
    }
    var pt : [237]u8 = undefined;
    var nfp : [10]u8 = undefined;
    const st : u32 = bkh_open(bk[BK_PATH .. BK_PATH + BK_PATH_CAP], @as(usize, bk[BK_PATHLEN]), bk[BK_PASS .. BK_PASS + BK_PASS_MAX], pn, pt[0..237], nfp[0..10]);
    bk_forget(bk);
    bk[BK_FOCUS] = 0;
    bk_settle(bk, st, pt[0..237], nfp[0..10]);
    bk_wipe(pt[0..237], 0, 237);
}

/// YES: the bytes that opened and checked replace ~/.t27os/identity (the old one to identity.bak); then wiped.
pub fn bk_yes(bk: []u8) -> void {
    if (bk_may_replace(BK_OK, bk_held(bk)) == false) { return; }
    const r : u32 = bkh_replace(bk[BK_PEND .. BK_PEND + BK_PT_LEN]);
    bk_forget(bk);
    bk[BK_MODE] = @as(u8, @intCast(BK_M_RESTORE));
    bk[BK_FOCUS] = 0;
    if (r == BK_OK) { bk[BK_NOTE] = @as(u8, @intCast(BK_N_RESTORED)); } else { bk[BK_NOTE] = @as(u8, @intCast(BK_N_SWAP)); }
}

/// NO: nothing changes; the opened bytes are wiped.
pub fn bk_no(bk: []u8) -> void {
    bk_forget(bk);
    bk[BK_MODE] = @as(u8, @intCast(BK_M_RESTORE));
    bk[BK_FOCUS] = 0;
    bk[BK_NOTE] = @as(u8, @intCast(BK_N_KEPT));
}

/// One hit of BACKUP, RESTORE or the panel as one action. A second press of the open panel's button closes it.
pub fn bk_click(cl: []u8, bk: []u8, hit: u32) -> void {
    cl[CL_FOCUS] = 0;
    if (hit == BK_H_BACKUP or hit == BK_H_RESTORE) {
        var m : u32 = BK_M_BACKUP;
        if (hit == BK_H_RESTORE) { m = BK_M_RESTORE; }
        if (bk_mode(bk) == m) {
            bk_close(bk);
        } else {
            bk_open(bk, m);
            if (ac_qr_is_big(cl)) { ac_qr_toggle(cl); }
        }
    } else if (hit == BK_H_PATH or hit == BK_H_PASS) {
        bk_focus_hit(bk, hit);
    } else if (hit == BK_H_GO) {
        bk_go(cl, bk);
    } else if (hit == BK_H_CANCEL) {
        bk_close(bk);
    } else if (hit == BK_H_YES) {
        bk_yes(bk);
    } else if (hit == BK_H_NO) {
        bk_no(bk);
    } else {
        bk[BK_FOCUS] = 0;
    }
}

fn bk_log(line: []const u8, n: usize) -> void {
    sys_write(2, line[0..n], @as(u64, n));
    sys_write(2, "\n", 1);
}

/// At launch (id_backup bk_launch): T27OS_ID_RESTORE=<file> opens the cabinet's RESTORE panel with the path; with
/// T27OS_ID_PASSWORD the file is opened and YES / NO asked; with T27OS_ID_CONFIRM=yes too it replaces the identity
/// here, before the identity is opened, so this run uses it. T27OS_ID_BACKUP=save with T27OS_ID_PASSWORD saves a
/// backup (test aids; the password is read once and removed from the environment). One stderr line each, IDBACKUP /
/// IDRESTORE, with the note or verdict and public fingerprints, never the password. True when the cabinet should open.
pub fn bk_boot(bk: []u8) -> bool {
    var p : [BK_PATH_MAX]u8 = undefined;
    // T27OS_ID_RESTORE and T27OS_ID_CONFIRM are test aids: ignored unless T27OS_QA=1 (qa_boot says so)
    const qa : bool = qa_env();
    var pn : usize = bkh_env("T27OS_ID_RESTORE", p[0..BK_PATH_MAX]);
    if (!qa_aid(qa, pn > 0)) { pn = 0; }
    var pw : [80]u8 = undefined;
    bk_wipe(pw[0..80], 0, 80);
    const wn : usize = bkh_env_pass(pw[0..80]);
    var e : [8]u8 = undefined;
    const en : usize = bkh_env("T27OS_ID_CONFIRM", e[0..8]);
    const yes : bool = qa_aid(qa, en == 3 and e[0] == 121 and e[1] == 101 and e[2] == 115);
    var line : [400]u8 = undefined;
    var n : usize = 0;
    const bn : usize = bkh_env("T27OS_ID_BACKUP", e[0..8]);
    if (bn == 4 and e[0] == 115 and e[1] == 97 and e[2] == 118 and e[3] == 101) {
        var out : [BK_PATH_MAX]u8 = undefined;
        const note : u32 = bkh_save(pw[0..80], wn, out[0..BK_PATH_MAX]);
        n = put_bytes(line[0..400], 0, "IDBACKUP note=");
        n = put_dec(line[0..400], n, @as(u64, note));
        if (note == BK_N_SAVED) {
            var k : usize = 0;
            while (k < BK_PATH_MAX and out[k] != 0) { k = k + 1; }
            n = put_bytes(line[0..400], n, " path=");
            n = put_bytes(line[0..400], n, out[0..k]);
        }
        bk_log(line[0..400], n);
    }
    const plan : u32 = bk_launch(pn, wn, yes);
    if (plan == BK_L_NONE) {
        bk_wipe(pw[0..80], 0, 80);
        return false;
    }
    bk_open(bk, BK_M_RESTORE);
    bk_set_path(bk, p[0..BK_PATH_MAX], pn);
    if (plan == BK_L_ASK) {
        bk[BK_FOCUS] = @as(u8, @intCast(BK_F_PASS));
        return true;
    }
    var pt : [237]u8 = undefined;
    var nfp : [10]u8 = undefined;
    const st : u32 = bkh_open(p[0..BK_PATH_MAX], pn, pw[0..80], wn, pt[0..237], nfp[0..10]);
    bk_wipe(pw[0..80], 0, 80);
    n = put_bytes(line[0..400], 0, "IDRESTORE open=");
    n = put_dec(line[0..400], n, @as(u64, st));
    if (st == BK_OK) {
        n = put_bytes(line[0..400], n, " fp=");
        n = n + bkh_fp_hex(nfp[0..10], line[n..400]);
    }
    bk_settle(bk, st, pt[0..237], nfp[0..10]);
    if (plan == BK_L_CONFIRM or bk_held(bk) == false) {
        bk_wipe(pt[0..237], 0, 237);
        if (bk_note(bk) == BK_N_SAME) { n = put_bytes(line[0..400], n, " same"); }
        bk_log(line[0..400], n);
        return true;
    }
    // T27OS_ID_CONFIRM=yes: the person's yes, given on the command line
    bk_wipe(pt[0..237], 0, 237);
    const r : u32 = bkh_replace(bk[BK_PEND .. BK_PEND + BK_PT_LEN]);
    n = put_bytes(line[0..400], n, " replace=");
    n = put_dec(line[0..400], n, @as(u64, r));
    bk_log(line[0..400], n);
    if (r != BK_OK) {
        bk_forget(bk);
        bk[BK_MODE] = @as(u8, @intCast(BK_M_RESTORE));
        bk[BK_NOTE] = @as(u8, @intCast(BK_N_SWAP));
        return true;
    }
    bk_close(bk);
    return false;
}

/// A fingerprint as the account token ("a944-ca2d-cee5"), or "(none)" when it is all zero (no identity was there).
fn bk_fp_token(fp: []const u8, out: []u8) -> usize {
    var z : u32 = 0;
    var i : usize = 0;
    while (i < 10) {
        z = z | @as(u32, fp[i]);
        i = i + 1;
    }
    if (z == 0) { return put_bytes(out, 0, "(none)"); }
    return ac_token_text(fp, out);
}

/// BACKUP and RESTORE in ME, right of CHANGE PICTURE (BACKUP only while there is an identity to save); the button of
/// the open panel is filled.
fn draw_bk_buttons(c: u64, kit: [48]u64, l: f64, t: f64, have: bool, mode: u32, hit: u32) -> void {
    const by : f64 = bk_btn_y(t);
    if (have) { draw_ac_btn_h(c, kit, bk_backup_x(l, QP_W), by, BK_BTN_W, AC_PIC_H, "BACKUP", mode == BK_M_BACKUP, hit == BK_H_BACKUP); }
    draw_ac_btn_h(c, kit, bk_restore_x(l, QP_W), by, BK_BTN_W, AC_PIC_H, "RESTORE", mode == BK_M_RESTORE or mode == BK_M_CONFIRM, hit == BK_H_RESTORE);
}

/// The panel in the friends' place: the title and CANCEL; RESTORE's path field; the password as stars with SAVE /
/// OPEN; the note (and the path saved). CONFIRM: the identity in use and the one restored, YES and NO.
fn draw_bk_sheet(c: u64, kit: [48]u64, l: f64, tf: f64, bk: []const u8, hit: u32) -> void {
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const m : u32 = bk_mode(bk);
    const ti : []const u8 = bk_title(m);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, ti, ti.len, x, bk_title_y(tf), 9.5, WEIGHT_SEMIBOLD, false);
    draw_ac_btn_h(c, kit, bk_cancel_x(l, QP_W), bk_cancel_y(tf), BK_CANCEL_W, 16.0, bk_cancel_word(bk), false, hit == BK_H_CANCEL);
    var line : [96]u8 = undefined;
    var n : usize = 0;
    if (m == BK_M_CONFIRM) {
        n = put_bytes(line[0..96], 0, "in use now:  ");
        n = n + bk_fp_token(bk[BK_OLDFP .. BK_OLDFP + 10], line[n..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_ac_fit(c, kit, line[0..96], n, x, bk_q1_y(tf), 9.5, 0.0, true, right);
        n = put_bytes(line[0..96], 0, "in backup:   ");
        n = n + bk_fp_token(bk[BK_NEWFP .. BK_NEWFP + 10], line[n..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_ac_fit(c, kit, line[0..96], n, x, bk_q2_y(tf), 9.5, WEIGHT_SEMIBOLD, true, right);
        draw_ac_btn_h(c, kit, bk_yes_x(l), bk_yes_y(tf), BK_YES_W, BK_FIELD_H, "YES", true, hit == BK_H_YES);
        draw_ac_btn_h(c, kit, bk_no_x(l), bk_yes_y(tf), BK_YES_W, BK_FIELD_H, "NO", false, hit == BK_H_NO);
        return;
    }
    if (m == BK_M_RESTORE) {
        // a long path shows its end, where the file name is
        const pl : usize = @as(usize, bk[BK_PATHLEN]);
        var from : usize = 0;
        if (pl > 30) { from = pl - 30; }
        draw_cl_field(c, kit, x, bk_path_y(tf), bk_field_w(QP_W), bk[BK_FOCUS] == @as(u8, @intCast(BK_F_PATH)), hit == BK_H_PATH, bk[BK_PATH + from .. BK_PATH + BK_PATH_CAP], pl - from, "~/Desktop/t27-backup-....t27id");
    }
    var stars : [64]u8 = undefined;
    const sn : usize = bk_mask(@as(usize, bk[BK_PLEN]), stars[0..64]);
    const py : f64 = bk_pass_y(tf, m);
    draw_cl_field(c, kit, x, py, bk_pass_w(QP_W), bk[BK_FOCUS] == @as(u8, @intCast(BK_F_PASS)), hit == BK_H_PASS, stars[0..64], sn, "password, 12 to 64 characters");
    draw_cl_btn(c, kit, bk_go_x(l, QP_W), py, BK_GO_W, bk_go_word(m), l + QP_W, hit == BK_H_GO);
    const note : u32 = bk_note(bk);
    const nt : []const u8 = bk_note_text(note);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (note == BK_N_SAVED) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    draw_ac_fit(c, kit, nt, nt.len, x, bk_note_y(tf, m), 9.0, 0.0, false, right);
    if (note == BK_N_SAVED) {
        const ol : usize = @as(usize, bk[BK_OUTLEN]);
        var of : usize = 0;
        if (ol > 46) { of = ol - 46; }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_ac_fit(c, kit, bk[BK_OUT + of .. BK_OUT + BK_OUT_CAP], ol - of, x, bk_note2_y(tf, m), 9.0, 0.0, true, right);
    } else {
        const n2 : []const u8 = bk_note2_text(note);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, n2, n2.len, x, bk_note2_y(tf, m), 9.0, 0.0, false, right);
    }
}

/// T27OS_ACCOUNT (a test aid, off by default): one line with what the cabinet shows, once at launch.
fn ac_log(cl: []const u8) -> void {
    var line : [384]u8 = undefined;
    var n : usize = put_bytes(line[0..384], 0, "ACCOUNTSTAT copies=");
    n = put_dec(line[0..384], n, ac_copies(cl));
    n = put_bytes(line[0..384], n, " key=");
    var q : usize = 0;
    while (q < INVITE_LEN) {
        line[n + q] = cl[FV_INV + q];
        q = q + 1;
    }
    n = n + INVITE_LEN;
    n = put_bytes(line[0..384], n, " ");
    n = n + ac_fp_line(cl[FE_FP .. FE_FP + 10], line[n..384]);
    n = put_bytes(line[0..384], n, " friends=");
    n = put_dec(line[0..384], n, @as(u64, cl[FV_COUNT]));
    n = put_bytes(line[0..384], n, " state=");
    n = n + ac_state_line(cl[CL_UP] != 0, cl[FV_NET] == @as(u8, @intCast(FV_NET_UP)), cl_ip(cl, CL_ME_IP), cl_ip(cl, CL_N_LAN), cl_me_port(cl), line[n..384]);
    n = put_bytes(line[0..384], n, " port=[");
    n = n + cl_port_status(cl, line[n..384]);
    n = put_bytes(line[0..384], n, "] ");
    n = n + ac_build_line(cl, line[n..384]);
    sys_write(2, line[0..n], @as(u64, n));
    sys_write(2, "\n", 1);
}

/// The UPDATE part's button: an outlined box AC_UPD_BTN_H tall with its word centred.
fn draw_ac_btn_small(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: str, over: bool) -> void {
    round_rect(c, bx, by, bw, AC_UPD_BTN_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    const lw : f64 = bytes_w(kit, word, word.len, 9.0, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, word.len, bx + 0.5 * (bw - lw), by + 12.5, 9.0, WEIGHT_SEMIBOLD, false);
}

/// A small outlined mark in a friend's row (COPY, x, YES, NO).
fn draw_ac_chip(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: []const u8, over: bool) -> void {
    round_rect(c, bx, by, bw, 14.0, 4.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    const lw : f64 = bytes_w(kit, word, word.len, 8.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, word.len, bx + 0.5 * (bw - lw), by + 10.5, 8.5, WEIGHT_SEMIBOLD, false);
}

/// The scroll arrow: a small box with a triangle; dim when the list cannot move that way.
fn draw_ac_arrow(c: u64, kit: [48]u64, ax: f64, ay: f64, up: bool, live: bool, over: bool) -> void {
    round_rect(c, ax, ay, AC_ARROW_W, AC_ARROW_H, 4.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over and live) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    if (up) {
        cg_move(c, ax + 5.0, ay + 11.0);
        cg_line(c, ax + 15.0, ay + 11.0);
        cg_line(c, ax + 10.0, ay + 5.0);
    } else {
        cg_move(c, ax + 5.0, ay + 5.0);
        cg_line(c, ax + 15.0, ay + 5.0);
        cg_line(c, ax + 10.0, ay + 11.0);
    }
    cg_close(c);
    var ink : f64 = lv(kit, THV_TEXT_WHITE);
    if (live == false) { ink = lv(kit, THV_MUTED_WHITE); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    cg_fill_path(c);
}

/// A button of the cabinet bh tall with its word centred; `filled` draws it white with dark ink (CALL to a friend who
/// is online, CALL in the head), else an outline.
fn draw_ac_btn_h(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, bh: f64, word: []const u8, filled: bool, over: bool) -> void {
    round_rect(c, bx, by, bw, bh, 5.0);
    if (filled) {
        var a : f64 = lv(kit, THV_LABEL_WHITE);
        if (over) { a = lv(kit, THV_TEXT_WHITE); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
        cg_fill_path(c);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
        if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    }
    var size : f64 = 9.0;
    if (bh < 16.0) { size = 8.5; }
    const lw : f64 = bytes_w(kit, word, word.len, size, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, word.len, bx + 0.5 * (bw - lw), by + 0.5 * bh + 0.36 * size, size, WEIGHT_SEMIBOLD, false);
}

/// One text cut to its room with an ellipsis (account_view ac_fit) and drawn.
fn draw_ac_fit(c: u64, kit: [48]u64, s: []const u8, n: usize, x: f64, base: f64, size: f64, weight: f64, mono: bool, right: f64) -> void {
    var b : [160]u8 = undefined;
    var m : usize = n;
    if (m > 156) { m = 156; }
    const k : usize = ac_fit(s, m, right - x, size, b[0..160]);
    draw_fit(c, kit, b[0..160], k, x, base, size, weight, mono, right);
}

/// A QR code of n modules (qr.t27, 1 = dark) at (qx, qy), md points a module: a white square with the QR_QUIET light
/// border, the dark modules black, one rectangle a run of a row; a thin light ring around it while it is under the
/// pointer (the small code is a button).
fn draw_ac_qr(c: u64, qm: []const u8, n: usize, qx: f64, qy: f64, md: f64, over: bool) -> void {
    const side : f64 = @as(f64, @floatFromInt(n + 2 * QR_QUIET)) * md;
    if (over) {
        round_rect(c, qx - 2.0, qy - 2.0, side + 4.0, side + 4.0, 4.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.9);
        cg_stroke_path(c);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0);
    cg_fill_rect(c, qx, qy, side, side);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    const ox : f64 = qx + @as(f64, @floatFromInt(QR_QUIET)) * md;
    const oy : f64 = qy + @as(f64, @floatFromInt(QR_QUIET)) * md;
    var r : usize = 0;
    while (r < n) {
        var cc : usize = 0;
        while (cc < n) {
            if (qr_dark(qm, n, r, cc)) {
                var e : usize = cc;
                while (e < n and qr_dark(qm, n, r, e)) { e = e + 1; }
                cg_fill_rect(c, ox + @as(f64, @floatFromInt(cc)) * md, oy + @as(f64, @floatFromInt(r)) * md, @as(f64, @floatFromInt(e - cc)) * md, md);
                cc = e;
            } else {
                cc = cc + 1;
            }
        }
        r = r + 1;
    }
}

fn draw_account_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, cl: []const u8, pf: []const u8, img: u64, ch: []const u8, kstored: []const u32, khl: []const u64, nvm: []const u8, kh: []const u8, now: u64, iv: []const u8, cnow: u64, bkgv: []const u8) -> void {
    // the backup panel's block and the groups' region (GR) travel as one slice, TBO_BK .. TB_SIZE; the groups' region is
    // grv here: gv is the line under the key
    const bk : []const u8 = bkgv[0..BK_CAP];
    const grv : []const u8 = bkgv[BK_CAP .. BK_CAP + GV_CAP];
    // QC. SCAN's block follows the groups' region in the same slice
    const qc : []const u8 = bkgv[BK_CAP + GV_CAP .. BK_CAP + GV_CAP + QC_CAP];
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const h : f64 = sh - t;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    // INVITATIONS between KEYS and the friends: the friends part moves down by dy while there is one
    const ivn : usize = iv_waiting(iv);
    const inv : usize = ac_inv_rows(ivn);
    const dy : f64 = ac_inv_dy(inv);
    const tf : f64 = t + dy;
    // GR. the GROUPS part under the friends takes its rows from them (none while the backup panel or the large code
    // stands in the friends' place)
    const grows : usize = gw_part_rows(cl, grv, h, dy);
    const gshown : bool = grows > 0 and gw_part_shown(cl, bk);
    const vis : usize = ac_rows_vis(h - dy - gw_part_room(grows));
    const shown : usize = @as(usize, cl[FV_SHOWN]);
    const drawn : usize = ac_rows_drawn(shown, vis);
    const count : usize = @as(usize, cl[FV_COUNT]);
    const scroll : usize = @as(usize, cl[FV_SCROLL]);
    const conf : usize = ac_conf_row(cl);
    const bkhave : bool = bk_have_id(cl);
    var hit : u32 = bk_hit(mx, my, l, QP_W, t, h, dy, bkhave, bk_mode(bk), ac_hit_qr(mx, my, l, QP_W, t, h, dy, cl[CL_UP] != 0, ac_qr_is_big(cl), ac_hit_inv(mx, my, l, QP_W, t, h, inv, drawn, count, vis, conf, ac_upd_shown(cl))));
    if (gshown) {
        const ghit : u32 = gv_hit(mx, my, l, QP_W, t, h, grows, gv_count(grv));
        if (ghit != GV_H_NONE) { hit = ghit; }
    }
    hit = qc_hit(mx, my, l, QP_W, t, h, qc_open(qc), hit);
    // HELP: "?" in the head, and its area in place of the friends while it is open (help_view.t27)
    const hvs : bool = hv_on(cl);
    hit = hv_hit(mx, my, l, QP_W, t, h, dy, cl, hit);
    // the key as a QR code (qr.t27): small in ME, large in place of the friends after a click on it
    var qm : [QR_CELLS_MAX]u8 = undefined;
    var qn : usize = 0;
    if (cl[CL_UP] != 0) {
        const qres : u32 = qr_make(cl[FV_INV .. FV_INV + INVITE_LEN], INVITE_LEN, qm[0..QR_CELLS_MAX]);
        if (qres != 0) { qn = qr_size(qr_ver_of(qres)); }
    }
    const qbmod : f64 = ac_qr_big_mod(t, h, tf);
    const qbig : bool = qn > 0 and ac_qr_is_big(cl) and qbmod > 0.0;
    var qright : f64 = right;
    if (qn > 0) { qright = ac_qr_text_right(l, QP_W); }
    var line : [96]u8 = undefined;
    var n : usize = 0;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "ACCOUNT", 7, x, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    // "?" right of the title (HELP); the number of invitations waiting right of it; then the unread lines of the groups (GR)
    draw_hv_btn(c, kit, hv_btn_x(l), hv_btn_y(t), hvs, hv_busy(cl) == false, hit == HV_H_BTN);
    var headx : f64 = x + AC_INV_HEAD_DX + HV_HEAD_SHIFT;
    if (ivn > 0) {
        var hb : [32]u8 = undefined;
        const hn : usize = ac_inv_head_text(ivn, hb[0..32]);
        const hw : f64 = bytes_w(kit, hb[0..32], hn, 8.5, WEIGHT_SEMIBOLD, false) + 12.0;
        round_rect(c, headx, t + 13.0, hw, 15.0, 7.5);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        cg_fill_path(c);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.85);
        draw_bytes(c, kit, hb[0..32], hn, headx + 6.0, t + 24.0, 8.5, WEIGHT_SEMIBOLD, false);
        headx = headx + hw + 6.0;
    }
    if (grv.len >= GV_CAP) { headx = draw_gv_head(c, kit, headx, t, grv); }
    // CALL in the head while there is someone to call: the first friend in view who is online (ac_call_target)
    if (ac_hcall_shown(count)) {
        draw_ac_btn_h(c, kit, ac_hcall_x(l, QP_W), t + AC_HCALL_Y, AC_HCALL_W, AC_HCALL_H, "CALL", true, hit == AC_H_HCALL);
    }
    // ME. the person: the big circle (the saved nickname's initial, or the picture), the nickname field, SAVE
    draw_pf_avatar(c, kit, img, pf[PF_SAVED .. PF_SAVED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_SLEN]), ac_av_cx(l), ac_av_cy(t), AC_AV_R, hit == AC_H_PICTURE, 1.0);
    const editing : bool = pf_editing(pf);
    const fx : f64 = ac_nick_x(l);
    const fy : f64 = t + AC_NICK_Y;
    const fw : f64 = ac_nick_w(QP_W);
    round_rect(c, fx, fy, fw, AC_NICK_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (editing) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    if (editing == false and hit == AC_H_NICK) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    cg_stroke_path(c);
    const at : usize = pf_shown_at(pf);
    const sn : usize = pf_shown_len(pf);
    var nb : [PRF_NICK_MAX_BYTES + 2]u8 = undefined;
    var i : usize = 0;
    while (i < sn) {
        nb[i] = pf[at + i];
        i = i + 1;
    }
    var tn : usize = sn;
    if (editing) {
        nb[tn] = 95;
        tn = tn + 1;
    }
    if (tn > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, nb[0 .. PRF_NICK_MAX_BYTES + 2], tn, fx + 8.0, fy + 17.5, 11.0, WEIGHT_SEMIBOLD, false, fx + fw - 8.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "Click to set a nickname", 23, fx + 8.0, fy + 17.5, 11.0, 0.0, false);
    }
    draw_cl_btn(c, kit, ac_save_x(l, QP_W), fy, AC_SAVE_W, "SAVE", sw, hit == AC_H_SAVE);
    if (hit == AC_H_PICTURE) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    draw_bytes(c, kit, "CHANGE PICTURE", 14, fx, t + AC_PIC_Y + 11.0, 9.5, 0.0, false);
    // ME. the account token, large (the first three groups of the fingerprint); right of it its word, "copied" for 2 s
    // after a copy, or the hover hint over the key
    if (cl[CL_UP] != 0) {
        n = ac_token_text(cl[FE_FP .. FE_FP + 10], line[0..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, line[0..96], n, x, t + AC_KEY_LABEL_Y, AC_TOK_SIZE, WEIGHT_SEMIBOLD, true, x + AC_FLASH_MINE_DX - 6.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "no token yet", 12, x, t + AC_KEY_LABEL_Y, 11.0, 0.0, false);
    }
    const flash : u32 = @as(u32, cl[AC_FLASH]);
    if (flash == AC_L_MINE) {
        const fw0 : []const u8 = ac_flash_text(flash);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_bytes(c, kit, fw0, fw0.len, x + AC_FLASH_MINE_DX, t + AC_KEY_LABEL_Y, 9.5, WEIGHT_SEMIBOLD, false);
    } else if (hit == AC_H_KEY) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_bytes(c, kit, "click to copy", 13, x + AC_FLASH_MINE_DX, t + AC_KEY_LABEL_Y, 9.5, 0.0, false);
    } else {
        const tw : []const u8 = ac_token_word();
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, tw, tw.len, x + AC_FLASH_MINE_DX, t + AC_KEY_LABEL_Y, 9.0, 0.0, false, right);
    }
    // ME. the key a friend pastes (a click copies it) and COPY beside it; under them what the key is for and where the
    // account lives (this device only: there is no server account)
    const kw : f64 = ac_key_w(QP_W);
    round_rect(c, x, t + AC_KEY_Y, kw, AC_KEY_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (hit == AC_H_KEY) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    if (cl[CL_UP] != 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, cl[FV_INV .. FV_INV + INVITE_LEN], INVITE_LEN, x + 7.0, t + AC_KEY_BASE, 11.0, WEIGHT_SEMIBOLD, true, x + kw - 5.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "no key: calls are off", 21, x + 7.0, t + AC_KEY_BASE, 10.0, 0.0, false);
    }
    draw_ac_btn_h(c, kit, ac_copy_x(l, QP_W), t + AC_COPY_Y, AC_COPY_W, AC_KEY_H, "COPY", false, hit == AC_H_COPYKEY);
    // BACKUP and RESTORE of the identity, right of CHANGE PICTURE (id_backup.t27)
    draw_bk_buttons(c, kit, l, t, bkhave, bk_mode(bk), hit);
    var gv : []const u8 = ac_give_text();
    var av : []const u8 = ac_account_text(false);
    if (qn > 0) {
        gv = ac_give_text_qr();
        av = ac_account_text_qr();
    }
    var v6b : [64]u8 = undefined;
    var v6n : usize = 0;
    if (cn6_shown(cl)) { v6n = ac_v6_line(cl[CL_V6_OWN .. CL_V6_OWN_END], cl[CL_V6_COPIED] != 0, v6b[0..64]); }
    if (v6n > 0) {
        // PUBLIC v6: this device's own IPv6 and the call port (call_ip6.t27), in the place of what the key is for; the
        // whole line copies it (AC_H_V6), smaller when it does not fit left of the code
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        if (hit == AC_H_V6) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
        const v6s : f64 = ac_v6_size(bytes_w(kit, v6b[0..64], v6n, AC_V6_SIZE, 0.0, false), qright - x);
        draw_ac_fit(c, kit, v6b[0..64], v6n, x, t + AC_GIVE_BASE, v6s, 0.0, false, qright);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_ac_fit(c, kit, gv, gv.len, x, t + AC_GIVE_BASE, 9.0, 0.0, false, qright);
    }
    if (qn > 0 and cl[CL_UP] != 0) {
        // PUBLIC: this device's address on the internet next to the key (call_nat.t27); the whole line is LOOK UP
        var pb : [128]u8 = undefined;
        const pbn : usize = ac_pub_line(@as(u32, cl[CL_N_ST]), cl_nat_pub(cl), @as(u64, cl[CL_N_MIN]), pb[0..128]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        if (hit == AC_H_STUN) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
        draw_ac_fit(c, kit, pb[0..128], pbn, x, t + AC_ACCT_BASE, 9.0, 0.0, false, qright);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, av, av.len, x, t + AC_ACCT_BASE, 9.0, 0.0, false, qright);
    }
    // the small code right of these lines; under it what a click does, unless the UPDATE button stands there
    if (qn > 0) {
        const qsx : f64 = ac_qr_small_x(l, QP_W);
        const qss : f64 = ac_qr_small_side();
        draw_ac_qr(c, qm[0..QR_CELLS_MAX], qn, qsx, t + AC_QR_Y, AC_QR_SMALL_MOD, hit == AC_H_QR or qbig);
        if (upv_button(@as(u32, cl[UPV_ST]), upv_has_offer(cl)) == UPV_B_NONE) {
            const qw : []const u8 = ac_qr_small_word(qbig);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            if (hit == AC_H_QR) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
            const qcw : f64 = bytes_w(kit, qw, qw.len, AC_QR_CAP_SIZE, 0.0, false);
            draw_bytes(c, kit, qw, qw.len, qsx + qss - qcw, t + AC_QR_Y + qss + AC_QR_CAP_DY, AC_QR_CAP_SIZE, 0.0, false);
        }
    }
    // this device: online or not, the port, discovery; then the version, the build and how long it has been up
    const up : bool = cl[CL_UP] != 0 and cl[FV_NET] == @as(u8, @intCast(FV_NET_UP));
    draw_cl_dot(c, kit, x, t + AC_STATE_Y - 8.0, up);
    n = ac_state_line(cl[CL_UP] != 0, cl[FV_NET] == @as(u8, @intCast(FV_NET_UP)), cl_ip(cl, CL_ME_IP), cl_ip(cl, CL_N_LAN), cl_me_port(cl), line[0..96]);
    // every call port tried was taken: the line says how many (the CALL panel lists them)
    if (cl[CL_UP] == 0 and cl[CL_PTRIED] > 1) { n = cl_port_status(cl, line[0..96]); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_fit(c, kit, line[0..96], n, x + 14.0, t + AC_STATE_Y, 9.5, WEIGHT_SEMIBOLD, false, qright);
    // the configured call port was taken: that comes first on the build line, the version and the build after it
    n = cl_port_busy_line(cl, line[0..96]);
    if (n > 0) { n = put_bytes(line[0..96], n, "  "); }
    n = n + ac_build_line(cl, line[n..96]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..96], n, x + 14.0, t + AC_BUILD_Y, 9.0, 0.0, true, qright);
    // UPDATE: a friend's newer build and its one button (UPDATE / CANCEL / RESTART), the progress or the reason, or what
    // this device serves (update_view.t27)
    const ub : u32 = upv_button(@as(u32, cl[UPV_ST]), upv_has_offer(cl));
    var uright : f64 = qright;
    if (ub != UPV_B_NONE) {
        uright = ac_upd_btn_x(l, QP_W) - 6.0;
        draw_ac_btn_small(c, kit, ac_upd_btn_x(l, QP_W), t + AC_UPD_BTN_Y, AC_UPD_BTN_W, upv_button_word(ub), hit == AC_H_UPD);
    }
    var ul : [128]u8 = undefined;
    var un : usize = upv_line1(cl, ul[0..128]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (cl[UPV_ST] != 0) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    draw_fit(c, kit, ul[0..128], un, x, t + AC_UPD_Y, 9.5, WEIGHT_SEMIBOLD, false, qright);
    un = upv_line2(cl, ul[0..128]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    draw_fit(c, kit, ul[0..128], un, x, t + AC_UPD2_Y, 9.0, 0.0, false, uright);
    // KEYS: one line a provider from the tables the window holds (the health of each key, the NVIDIA counts); a row
    // that cannot serve is muted with its reason; the health file's last check (kh, keys_health.t27) says live and
    // when, unless the KEYS panel checked the row later; no key value, no request from here
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "KEYS", 4, x, t + AC_KEYS_LABEL_Y, 9.5, 0.0, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    draw_bytes(c, kit, "values are never shown", 22, x + 36.0, t + AC_KEYS_LABEL_Y, 9.0, 0.0, false);
    var kf : [9]u64 = undefined;
    var kl : [128]u8 = undefined;
    var kp : usize = 0;
    while (kp < AC_KP_N) {
        const kb : f64 = ac_keys_row_base(t, kp);
        ac_kp_facts(kp, kstored, khl, nvm, now, kf[0..9]);
        ac_kp_seen(kp, kf[0..9], ac_kc_total(nvm, kp));
        const kst0 : u32 = @as(u32, @intCast(kf[6]));
        const kdim : bool = ac_kp_dim(kst0);
        draw_cl_dot(c, kit, x, kb - 7.0, ac_kp_live_kh(kp, kf[0..9], kh, now));
        var kink : f64 = lv(kit, THV_TEXT_WHITE);
        if (kdim) { kink = lv(kit, THV_MUTED_WHITE); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, kink);
        const kname : []const u8 = ac_kp_name(kp);
        draw_bytes(c, kit, kname, kname.len, x + AC_KEYS_NAME_DX, kb, 9.5, WEIGHT_SEMIBOLD, false);
        const kn : usize = ac_kp_line_kh(kp, kf[0..9], kh, now, kl[0..128]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        if (kdim) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE)); }
        draw_ac_fit(c, kit, kl[0..128], kn, x + AC_KEYS_VALUE_DX, kb, AC_KEYS_SIZE, 0.0, false, right);
        kp = kp + 1;
    }
    // INVITATIONS: the newest first; the nickname (the peer's own word), the short key, when, "again"; ACCEPT, DECLINE
    if (inv > 0) {
        n = ac_inv_label(ivn, line[0..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, line[0..96], n, x, ac_inv_label_y(t), 9.5, WEIGHT_SEMIBOLD, false, right);
        var ik : usize = 0;
        while (ik < inv) {
            const irow : usize = ac_inv_row_of(iv, ik);
            if (irow != IV_MAX) {
                const iy : f64 = ac_inv_row_y(t, ik);
                const ikk : u32 = @as(u32, @intCast(ik));
                const tr : f64 = ac_inv_acc_x(l, QP_W) - 6.0;
                var nb2 : [32]u8 = undefined;
                const nn2 : usize = ac_inv_name(iv, irow, nb2[0..32]);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
                draw_ac_fit(c, kit, nb2[0..32], nn2, x, iy + 12.0, 11.0, WEIGHT_SEMIBOLD, false, tr);
                n = ac_inv_line(iv, irow, cnow, line[0..96]);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
                draw_ac_fit(c, kit, line[0..96], n, x, iy + 24.0, 9.0, 0.0, false, tr);
                draw_ac_btn_h(c, kit, ac_inv_acc_x(l, QP_W), iy + AC_INV_BTN_DY, AC_INV_ACC_W, AC_INV_BTN_H, "ACCEPT", true, hit == AC_H_IACC + ikk);
                draw_ac_btn_h(c, kit, ac_inv_dec_x(l, QP_W), iy + AC_INV_BTN_DY, AC_INV_DEC_W, AC_INV_BTN_H, "DECLINE", false, hit == AC_H_IDEC + ikk);
            }
            ik = ik + 1;
        }
    }
    // HELP, the backup panel, or the large code, in place of the friends
    if (hvs) {
        draw_hv_part(c, kit, l, t, h, dy, cl);
    } else if (bk_open_shown(bk)) {
        draw_bk_sheet(c, kit, l, tf, bk, hit);
    } else if (qbig) {
        const fs : f64 = ac_qr_frame_side(qbmod);
        const fx : f64 = ac_qr_frame_x(l, QP_W, qbmod);
        const fy : f64 = ac_qr_frame_y(tf);
        const qt : []const u8 = ac_qr_big_title();
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_bytes(c, kit, qt, qt.len, x, tf + AC_FR_LABEL_Y, 9.5, WEIGHT_SEMIBOLD, false);
        round_rect(c, fx, fy, fs, fs, 8.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        if (hit == AC_H_QR) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
        cg_stroke_path(c);
        draw_ac_qr(c, qm[0..QR_CELLS_MAX], qn, fx + AC_QR_FRAME_PAD, fy + AC_QR_FRAME_PAD, qbmod, false);
        const qbw : []const u8 = ac_qr_big_word();
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, qbw, qbw.len, x, fy + fs + AC_QR_BIG_CAP_DY, 9.0, 0.0, false, right);
    } else {
        // WHO YOU CAN CALL: a window of the list, the arrows and the range when the list is longer than the window
        n = ac_fr_label(count, line[0..96]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_fit(c, kit, line[0..96], n, x, tf + AC_FR_LABEL_Y, 9.5, 0.0, false, x + AC_FLASH_FRIEND_DX - 4.0);
        if (flash == AC_L_FRIEND) {
            const fw1 : []const u8 = ac_flash_text(flash);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_fit(c, kit, fw1, fw1.len, x + AC_FLASH_FRIEND_DX, tf + AC_FR_LABEL_Y, 9.5, WEIGHT_SEMIBOLD, false, ac_up_x(l, QP_W) - 8.0);
        }
        if (count > vis) {
            n = ac_range_text(scroll, drawn, count, line[0..96]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            if (flash != AC_L_FRIEND) { draw_fit(c, kit, line[0..96], n, x + AC_FLASH_FRIEND_DX, tf + AC_FR_LABEL_Y, 9.0, 0.0, true, ac_up_x(l, QP_W) - 8.0); }
            draw_ac_arrow(c, kit, ac_up_x(l, QP_W), ac_arrow_y(tf), true, scroll > 0, hit == AC_H_UP);
            draw_ac_arrow(c, kit, ac_down_x(l, QP_W), ac_arrow_y(tf), false, scroll < ac_max_scroll(count, vis), hit == AC_H_DOWN);
        }
        if (count == 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            draw_cl_wrap(c, kit, ac_empty_text(count), x, right, tf + AC_FR_LABEL_Y + 18.0, 9.5, 2, sh);
        }
        i = 0;
        while (i < drawn) {
            const ry : f64 = ac_row_y(tf, i);
            const r : usize = fv_row_at(i);
            const k : u32 = @as(u32, @intCast(i));
            const online : bool = cl[r + FR_ONLINE] != 0;
            const asking : bool = conf == i;
            if (hit == AC_H_ROW + k or hit == AC_H_FCOPY + k or hit == AC_H_DEL + k or hit == AC_H_YES + k or hit == AC_H_NO + k or hit == AC_H_CALL + k or hit == AC_H_MSG + k) {
                round_rect(c, x - 4.0, ry, right - x + 8.0, AC_ROW_H - 2.0, 5.0);
                cg_line_width(c, 1.0);
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
                cg_stroke_path(c);
            }
            draw_cl_dot(c, kit, x + 1.0, ry + 6.0, online);
            const unr : u32 = chv_unr_get(ch, cl[r + FR_FP .. r + FR_FP + 10]);
            var nameright : f64 = ac_call_x(l, QP_W) - 6.0;
            if (unr > 0) { nameright = ac_call_x(l, QP_W) - 28.0; }
            if (asking) { nameright = ac_yes_x(l, QP_W) - 58.0; }
            const nl : usize = @as(usize, cl[r + FR_NICKLEN]);
            if (nl > 0) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
                draw_fit(c, kit, cl[r + FR_NICK .. r + FR_NICK + nl], nl, x + 16.0, ry + 12.0, 11.0, WEIGHT_SEMIBOLD, false, nameright);
            } else {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
                draw_fit(c, kit, "(no name yet)", 13, x + 16.0, ry + 12.0, 11.0, 0.0, false, nameright);
            }
            if (asking) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
                draw_bytes(c, kit, "REMOVE?", 7, ac_yes_x(l, QP_W) - 52.0, ry + 12.0, 9.5, WEIGHT_SEMIBOLD, false);
                draw_ac_chip(c, kit, ac_yes_x(l, QP_W), ry + 2.0, AC_ZONE_YES_W, "YES", hit == AC_H_YES + k);
                draw_ac_chip(c, kit, ac_no_x(l, QP_W), ry + 2.0, AC_ZONE_YES_W, "NO", hit == AC_H_NO + k);
            } else {
                if (unr > 0) { draw_ch_badge(c, kit, ac_call_x(l, QP_W) - 4.0, ry + 8.0, unr); }
                // CALL (filled while the friend is online), MESSAGE, copy the friend's key, remove
                draw_ac_btn_h(c, kit, ac_call_x(l, QP_W), ry + 2.0, AC_ZONE_CALL_W, 14.0, "CALL", online, hit == AC_H_CALL + k);
                draw_ac_chip(c, kit, ac_msg_x(l, QP_W), ry + 2.0, AC_ZONE_MSG_W, "MESSAGE", hit == AC_H_MSG + k);
                draw_ac_chip(c, kit, ac_fcopy_x(l, QP_W), ry + 2.0, AC_ZONE_COPY_W, "COPY", hit == AC_H_FCOPY + k);
                draw_ac_chip(c, kit, ac_del_x(l, QP_W), ry + 2.0, AC_ZONE_DEL_W, "x", hit == AC_H_DEL + k);
            }
            n = ac_row_line(cl, i, chv_trust(ch, cl[r + FR_FP .. r + FR_FP + 10]), line[0..96]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            draw_fit(c, kit, line[0..96], n, x + 16.0, ry + 23.0, 9.0, 0.0, true, right);
            i = i + 1;
        }
        // GR. the GROUPS part: under the friends, above the add part
        if (gshown) { draw_gv_part(c, kit, l, t, h, cl, grv, grows, hit); }
    }
    // add a friend: the field takes a pasted or typed key; PASTE reads the clipboard; ADD checks the last symbol (one line)
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "ADD A FRIEND BY KEY", 19, x, ac_add_label_y(t, h), 9.5, 0.0, false);
    draw_cl_field(c, kit, cv_field_x(l), ac_ifield_y(t, h), ac_ifield_w(QP_W), cl[CL_FOCUS] == 2, hit == AC_H_IFIELD, cl[FV_TYPED .. FV_TYPED + INVITE_LEN], @as(usize, cl[FV_INVLEN]), "T27-XXXX-XXXX-XXXX-XXXX-C");
    draw_cl_btn(c, kit, ac_paste_x(l, QP_W), ac_btn_y(t, h), AC_PASTE_W, "PASTE", sw, hit == AC_H_PASTE);
    draw_cl_btn(c, kit, ac_addb_x(l, QP_W), ac_btn_y(t, h), AC_ADDB_W, "ADD", sw, hit == AC_H_ADD);
    // the one status line: the nickname's while it is being typed (or when no note stands), else the note of the last action
    const code : u32 = @as(u32, cl[CL_NOTE]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (qc_msg_shown(qc, cnow)) {
        // QC. what the last scan said (key found, no code, the camera refused), for a few seconds
        draw_cl_wrap(c, kit, qc_text(qc_why(qc)), x, right, ac_note_y(t, h), 9.5, 2, sh);
    } else if (editing or code == 0) {
        draw_cl_wrap(c, kit, prf_error_text(pf_get(pf, PF_CODE)), x, right, ac_note_y(t, h), 9.5, 2, sh);
    } else if (code >= 32 and code < 38) {
        n = put_bytes(line[0..96], 0, "Cannot call now: ");
        n = put_bytes(line[0..96], n, fv_offline_text(code));
        draw_cl_wrap(c, kit, line[0..n], x, right, ac_note_y(t, h), 9.5, 2, sh);
    } else if (fv_note_is_mine(code)) {
        draw_cl_wrap(c, kit, fv_note_text(code), x, right, ac_note_y(t, h), 9.5, 2, sh);
    } else {
        draw_cl_wrap(c, kit, cv_note_text(code), x, right, ac_note_y(t, h), 9.5, 2, sh);
    }
    // QC. SCAN on the label line, and the preview over the friends part while a scan runs
    draw_qc_part(c, kit, l, t, h, qc, hit, cl[CL_VIEW] != 0, sw);
}

/// "?" right of the title ACCOUNT: a circle, filled while HELP is open, dim during a call (it does nothing then).
fn draw_hv_btn(c: u64, kit: [48]u64, bx: f64, by: f64, open: bool, live: bool, over: bool) -> void {
    round_rect(c, bx, by, HV_BTN_D, HV_BTN_D, 0.5 * HV_BTN_D);
    var ink : f64 = lv(kit, THV_TEXT_WHITE);
    if (live == false) { ink = lv(kit, THV_MUTED_WHITE); }
    if (open and live) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
        cg_fill_path(c);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.85);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
        if (over and live) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, ink); }
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    }
    const qw : f64 = bytes_w(kit, "?", 1, 11.0, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, "?", 1, bx + 0.5 * (HV_BTN_D - qw), by + 13.0, 11.0, WEIGHT_SEMIBOLD, false);
}

/// HELP in place of the friends: the five blocks (a title, its lines cut to the text width), scrolled by the state's
/// steps; a line not wholly inside the area is not drawn; "Esc - back" and, while more is below, "scroll for more".
fn draw_hv_part(c: u64, kit: [48]u64, l: f64, t: f64, h: f64, dy: f64, cl: []const u8) -> void {
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const maxw : f64 = hv_text_w(QP_W);
    const top : f64 = hv_top(t, dy);
    const foot : f64 = hv_foot_y(t, h);
    const max : usize = hv_max_scroll(hv_content_h(maxw), hv_view_h(t, h, dy));
    var sc : usize = @as(usize, cl[HV_SCROLL]);
    if (sc > max) { sc = max; }
    var st : [8]u32 = undefined;
    var ln : [8]u32 = undefined;
    var k : usize = 0;
    while (k < HV_N) {
        const by : f64 = hv_block_y(k, maxw, t, dy, sc);
        const tt : []const u8 = hv_title(k);
        const ty : f64 = by + HV_TITLE_H - 3.0;
        if (hv_line_in(ty, HV_TITLE_SIZE, top, foot)) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_bytes(c, kit, tt, tt.len, x, ty, HV_TITLE_SIZE, WEIGHT_SEMIBOLD, false);
        }
        const b : []const u8 = hv_body(k);
        const n : usize = hv_lines(k, maxw, st[0..8], ln[0..8]);
        var i : usize = 0;
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        while (i < n) {
            const ly : f64 = by + HV_TITLE_H + HV_LINE_H * @as(f64, @floatFromInt(i + 1)) - 3.0;
            if (hv_line_in(ly, HV_BODY_SIZE, top, foot)) {
                draw_bytes(c, kit, b[st[i] .. st[i] + ln[i]], @as(usize, ln[i]), x, ly, HV_BODY_SIZE, 0.0, false);
            }
            i = i + 1;
        }
        k = k + 1;
    }
    const fw : []const u8 = hv_foot();
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    draw_bytes(c, kit, fw, fw.len, x, foot + HV_LINE_H, 9.0, 0.0, false);
    if (sc < max) {
        const mw : []const u8 = hv_more();
        const mww : f64 = bytes_w(kit, mw, mw.len, 9.0, 0.0, false);
        draw_bytes(c, kit, mw, mw.len, right - mww, foot + HV_LINE_H, 9.0, 0.0, false);
    }
}

// ======================================================================================================
// QC. SCAN IN THE CABINET (owner, 2026-10-23). qr_cam.t27 decides (the states, the frame rate, the 20 s, the boxes);
// call_video.t27 cvl_scan_new captures (the call's capture path in scan mode, a block of its own: grey 640 x 480, at
// most one frame in 100 ms, never on this thread); qr_scan.t27 qs_scan_key reads the key. The state is the text
// store's QC region; the words of qcw (a local of main): QW_CP the scan camera's block, QW_NS and QW_NS_MAX the time
// the reader took (summed, longest), QW_FOFF the pixels' offset in the T27OS_QR_FRAME file (0: frames from the camera).
// Test aids (off by default): T27OS_QR_FRAME=<a 640 x 480 binary PGM> stands in for the camera; T27OS_QR_SCAN=1
// presses SCAN once the cabinet is open and logs one QRSCAN line when the scan ends (never the key).
// ======================================================================================================
pub const QW_CP : usize = 0;
pub const QW_NS : usize = 1;
pub const QW_NS_MAX : usize = 2;
pub const QW_FOFF : usize = 3;
pub const QW_N : usize = 8;
pub const QW_FILE_CAP : usize = 307600;

fn qw_ns(id: u32) -> u64 { return @extern("clock_gettime_nsec_np"); }
fn qw_gray() -> u64 { return @extern("CGColorSpaceCreateDeviceGray"); }
fn qw_space_release(sp: u64) -> void { @extern("CGColorSpaceRelease"); }
fn qw_ctx_release(ctx: u64) -> void { @extern("CGContextRelease"); }
fn qw_bitmap(data: []const u8, w: usize, h: usize, bits: usize, row: usize, space: u64, info: u32) -> u64 { return @extern("CGBitmapContextCreate"); }

/// A call is up (its view, or its session not idle): SCAN is off.
pub fn qw_in_call(cl: []const u8, cs: []const u8) -> bool { return cl[CL_VIEW] != 0 or cs_state(cs) != CK_IDLE; }

fn qw_img_drop(q: []u8) -> void {
    const img : u64 = qc_u64(q, QC_IMG);
    if (img != 0) {
        cg_image_release(img);
        qc_set_u64(q, QC_IMG, 0);
    }
}

/// The grey frame as the preview's picture (DeviceGray, 8 bits, no alpha); the old one released.
fn qw_image(q: []u8, g: []const u8) -> void {
    const space : u64 = qw_gray();
    const ctx : u64 = qw_bitmap(g, QC_FRAME_W, QC_FRAME_H, 8, QC_FRAME_W, space, 0);
    if (ctx != 0) {
        const img : u64 = cg_image(ctx);
        qw_ctx_release(ctx);
        if (img != 0) {
            qw_img_drop(q);
            qc_set_u64(q, QC_IMG, img);
        }
    }
    if (space != 0) { qw_space_release(space); }
}

/// One QRSCAN line on stderr while the test aid T27OS_QR_SCAN is set: how the scan ended, the frames read, the time
/// to the key, the frames refused, the reader's mean and longest time. Never the key.
fn qw_log(q: []const u8, w: []const u64) -> void {
    if (q[QC_AID] == 0) { return; }
    var b : [256]u8 = undefined;
    var n : usize = put_bytes(b[0..256], 0, "QRSCAN result=");
    if (qc_state(q) == QC_FOUND) { n = put_bytes(b[0..256], n, "found"); } else { n = put_dec(b[0..256], n, @as(u64, qc_why(q))); }
    n = put_bytes(b[0..256], n, " frames=");
    n = put_dec(b[0..256], n, qc_frames(q));
    n = put_bytes(b[0..256], n, " found_ms=");
    n = put_dec(b[0..256], n, qc_found_ms(q));
    n = put_bytes(b[0..256], n, " refused=");
    n = put_dec(b[0..256], n, qc_u64(q, QC_MISS));
    n = put_bytes(b[0..256], n, " read_us_mean=");
    var mean : u64 = 0;
    if (qc_frames(q) > 0) { mean = w[QW_NS] / qc_frames(q) / 1000; }
    n = put_dec(b[0..256], n, mean);
    n = put_bytes(b[0..256], n, " read_us_max=");
    n = put_dec(b[0..256], n, w[QW_NS_MAX] / 1000);
    if (q[QC_SRC] != 0) { n = put_bytes(b[0..256], n, " src=file\n"); } else { n = put_bytes(b[0..256], n, " src=camera\n"); }
    sys_write(2, b[0..n], @as(u64, n));
}

/// SCAN or CANCEL clicked at now. SCAN refreshes a refused camera's answer first (the person may have allowed it in
/// System Settings since), then starts the scan camera (its own block, made once) unless frames come from a file.
pub fn qw_click(q: []u8, cl: []u8, cs: []const u8, w: []u64, hit: u32, now: u64) -> void {
    if (hit == QC_H_SCAN) {
        const cam : u32 = @as(u32, q[QC_CAM]);
        if (q[QC_SRC] == 0 and (cam == QC_CAM_RESTRICTED or cam == QC_CAM_DENIED)) {
            q[QC_CAM] = @as(u8, @intCast(qc_cam_of_auth(cvl_auth())));
        }
        if (!qc_press(q, now, qw_in_call(cl, cs))) { return; }
        w[QW_NS] = 0;
        w[QW_NS_MAX] = 0;
        if (q[QC_SRC] != 0) { return; }
        if (w[QW_CP] == 0) { w[QW_CP] = cvl_scan_new(); }
        if (w[QW_CP] == 0) {
            qc_tick(q, now, false, true, 3);
            return;
        }
        cvl_start(w[QW_CP]);
    } else if (hit == QC_H_CANCEL) {
        if (qc_cancel(q, now) and w[QW_CP] != 0) { cvl_stop(w[QW_CP]); }
        qw_img_drop(q);
        qw_log(q, w);
    }
}

/// One pass: the test aid's press, a scan left behind by a closed cabinet, the camera's state, the 20 s, and at most
/// one frame in 100 ms read for the key (g the grey copy, bin the reader's work buffer, file the T27OS_QR_FRAME bytes).
/// A key fills the add field (the person still presses ADD) and stops the camera.
pub fn qw_tick(q: []u8, cl: []u8, cs: []const u8, w: []u64, g: []u8, bin: []u8, file: []const u8, now: u64) -> void {
    if (q[QC_AID] == 1 and cl[CL_OPEN] != 0 and cl[AC_ON] != 0) {
        q[QC_AID] = 2;
        qw_click(q, cl, cs, w, QC_H_SCAN, now);
    }
    if (qc_open(q) and cl[AC_ON] == 0) {
        if (qc_cancel(q, now) and w[QW_CP] != 0) { cvl_stop(w[QW_CP]); }
    }
    if (!qc_open(q)) {
        qw_img_drop(q);
        return;
    }
    const cp : u64 = w[QW_CP];
    var failed : bool = false;
    var why : u64 = 0;
    if (q[QC_SRC] == 0 and cp != 0 and qc_state(q) == QC_PREVIEW) {
        // FAILED counts once the setup answered, or once the camera is allowed (not while the system still asks)
        if (cvl_tick(cp) == CVS_FAILED) {
            why = cvl_stat(cp, 14);
            failed = why != 0 or cvl_stat(cp, 4) != 0;
        }
    }
    const a : u32 = qc_tick(q, now, qw_in_call(cl, cs), failed, why);
    if ((a & QC_A_STOP) != 0) {
        if (cp != 0) { cvl_stop(cp); }
        qw_log(q, w);
    }
    if ((a & QC_A_TAKE) == 0) { return; }
    var key : [32]u8 = undefined;
    var r : u32 = 0;
    const t0 : u64 = qw_ns(8);
    if (q[QC_SRC] != 0) {
        const off : usize = @as(usize, w[QW_FOFF]);
        if (off == 0 or off + QC_FRAME_N > file.len) { return; }
        r = qs_scan_key(file[off .. off + QC_FRAME_N], QC_FRAME_W, QC_FRAME_H, bin, key[0..32]);
    } else {
        if (cp == 0 or cvl_take_grey(cp, g) == 0) { return; }
        r = qs_scan_key(g[0..QC_FRAME_N], QC_FRAME_W, QC_FRAME_H, bin, key[0..32]);
    }
    const dt : u64 = qw_ns(8) - t0;
    w[QW_NS] = w[QW_NS] + dt;
    if (dt > w[QW_NS_MAX]) { w[QW_NS_MAX] = dt; }
    if (q[QC_SRC] != 0) {
        const off2 : usize = @as(usize, w[QW_FOFF]);
        qw_image(q, file[off2 .. off2 + QC_FRAME_N]);
    } else {
        qw_image(q, g[0..QC_FRAME_N]);
    }
    if (qc_frame(q, now, r)) {
        qc_fill_field(cl, key[0..INVITE_LEN]);
        cl[CL_FOCUS] = 2;
        cl[CL_NOTE] = 0;
        if (cp != 0) { cvl_stop(cp); }
        qw_log(q, w);
    }
}

/// SCAN: a small outlined chip; its word dim while SCAN would not start (a call, a refused or missing camera, a scan
/// already running).
fn draw_qc_scan(c: u64, kit: [48]u64, bx: f64, by: f64, on: bool, over: bool) -> void {
    round_rect(c, bx, by, QC_SCAN_W, QC_SCAN_H, 4.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over and on) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    var ink : f64 = lv(kit, THV_TEXT_WHITE);
    if (!on) { ink = lv(kit, THV_MUTED_WHITE); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    const lw : f64 = bytes_w(kit, "SCAN", 4, 8.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, "SCAN", 4, bx + 0.5 * (QC_SCAN_W - lw), by + 11.5, 8.5, WEIGHT_SEMIBOLD, false);
}

/// SCAN on the label line; while a scan runs (and 1.5 s after its key) the shade over the friends part, the preview
/// (the newest frame, or "starting the camera"), the line and CANCEL.
fn draw_qc_part(c: u64, kit: [48]u64, l: f64, t: f64, h: f64, qc: []const u8, hit: u32, oncall: bool, sw: f64) -> void {
    const open : bool = qc_open(qc);
    draw_qc_scan(c, kit, qc_scan_x(l, QP_W), qc_scan_y(t, h), !open and qc_off_why(qc, oncall) == QC_W_NONE, hit == QC_H_SCAN);
    if (!open) { return; }
    draw_plate(c, l + 8.0, qc_shade_y(t, h), QP_W - 16.0, qc_shade_h(), sw);
    const px : f64 = qc_prev_x(l, QP_W);
    const py : f64 = qc_prev_y(t, h);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.6);
    cg_fill_rect(c, px, py, QC_PREV_W, QC_PREV_H);
    const img : u64 = qc_u64(qc, QC_IMG);
    if (img != 0) {
        cg_save(c);
        cg_translate(c, px, py + QC_PREV_H);
        cg_scale(c, 1.0, -1.0);
        cg_draw_image(c, 0.0, 0.0, QC_PREV_W, QC_PREV_H, img);
        cg_restore(c);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, "starting the camera", 19, px + 8.0, py + 0.5 * QC_PREV_H, 9.5, 0.0, false, px + QC_PREV_W - 8.0);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, px, py, QC_PREV_W, HAIR);
    cg_fill_rect(c, px, py + QC_PREV_H - HAIR, QC_PREV_W, HAIR);
    cg_fill_rect(c, px, py, HAIR, QC_PREV_H);
    cg_fill_rect(c, px + QC_PREV_W - HAIR, py, HAIR, QC_PREV_H);
    const tx : []const u8 = qc_text(qc_why(qc));
    var weight : f64 = 0.0;
    if (qc_why(qc) == QC_W_FOUND) { weight = WEIGHT_SEMIBOLD; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_fit(c, kit, tx, tx.len, l + QP_PAD, qc_line_y(t, h), 9.5, weight, false, qc_cancel_x(l, QP_W) - 8.0);
    draw_ac_btn_h(c, kit, qc_cancel_x(l, QP_W), qc_cancel_y(t, h), QC_CANCEL_W, QC_CANCEL_H, "CANCEL", false, hit == QC_H_CANCEL);
}

// ======================================================================================================
// CH. A FRIEND'S CARD AND THE CHAT (owner, 2026-10-22; Refs gHashTag/t27#11560). chat_view.t27 decides (the boxes of the
// card and of the chat, the history's items, the field, the unread table, the text); chat_core.t27 and chat_host.t27
// keep the log and run the message session. This block owns the log of the one friend open (a local of main), the
// message session on the chat port (the call port + 1, chv_chat_port, the same bind address), and turns a hit into one
// call:
//   - a click on a friend's row in the cabinet opens the card (MESSAGE, CALL, VIDEO); MESSAGE opens the chat and sends
//     READ for what it shows; Return or SEND puts the text in the log as PENDING and the session sends it, or it waits
//     ("will send when online") until the friend is found again;
//   - CALL and VIDEO close a message session first (its log is written), then call the friend through cl_front /
//     fe_call, the one path a friend is called by; CALL starts no camera and sends no video (CL_NOCAM, CS_K_VIDEO 0);
//     when the call is over the cabinet shows the card again;
//   - one log is open at a time: another friend's session is answered by opening that friend's log, when nothing waits
//     in the open one and its chat is not on screen; while a call is up the message session is not run.
//   - T27OS_CHAT=card or =chat (a test aid, off by default): the first friend's card, or chat, once the list is known.
//   - T27OS_CHAT_SAY=n (a test aid, off by default, 1..99): with that chat open, n lines "say k of n" are typed and
//     sent one a second, the way Return sends what the person typed.
// ======================================================================================================
pub const TBO_CH : usize = 85504;
/// The open log (chat_core cl_bytes(CL_KEEP)) and the file scratch (chat_core CF_MAX + 1), as main declares them.
pub const CH_LOG_LEN : usize = 1016040;
pub const CH_BUF_LEN : usize = 1008041;
/// The window's chat clock (main's [10]u64): a log is open, when it is written next (0 = clean), when the history was
/// laid out, the history's height then, the test aid still to apply (1 card, 2 chat).
pub const CHW_LOADED : usize = 0;
pub const CHW_SAVE_AT : usize = 1;
pub const CHW_LAYOUT_AT : usize = 2;
pub const CHW_HH : usize = 3;
pub const CHW_AID : usize = 4;
/// The trust table: the friend count it was read for (+ 1, 0 = never read) and when the friends file was last read.
pub const CHW_TR_N : usize = 5;
pub const CHW_TR_AT : usize = 6;
/// T27OS_CHAT_SAY (a test aid): the lines still to send, when the next goes, how many in all.
pub const CHW_SAY : usize = 7;
pub const CHW_SAY_AT : usize = 8;
pub const CHW_SAY_N : usize = 9;
/// trust.t27: the session id (its first 8 bytes) whose identity verdict was last applied, of the call and of the
/// message session: one session's refusal is counted once, and a session that ended long ago (its block keeps the
/// verdict until the next session) never clears a refusal that came after it.
pub const CHW_RF_CALL : usize = 10;
pub const CHW_RF_MSG : usize = 11;
/// trust.t27 is there and could not be read (no permission, busy): 1 while it is never written over; the warnings of
/// this run wait in memory and are merged into the file's once a read goes through.
pub const CHW_TR_HELD : usize = 12;
/// How many stored keys of the friends file did not hash to their friend's fingerprint at the last read (+ 1, 0 =
/// none said yet): one line on stderr when it changes.
pub const CHW_FK_BAD : usize = 13;
/// IP6: when the chat socket last punched toward the friend of the last verified call over IPv6 (ch_tick_at).
pub const CHW_P6_AT : usize = 14;
pub const CHW_N : usize = 15;
/// How often the chat socket sends a probe to that friend's chat port: a home router forgets an unused pinhole in some
/// tens of seconds.
pub const CH6_PUNCH_MS : u64 = 5000;
/// How long after that call was last seen up the punch goes on (10 min, 120 probes at most), then it stops.
pub const CH6_PUNCH_FOR_MS : u64 = 600000;

/// Is the chat punch due at now: every CH6_PUNCH_MS (last = the last one, 0 = none yet), and only for
/// CH6_PUNCH_FOR_MS after the last verified call was last seen up (seen, call_session cs_verified_ep; 0 = there was
/// none: never).
pub fn ch6_punch_due(now: u64, last: u64, seen: u64) -> bool {
    if (seen == 0 or now >= seen + CH6_PUNCH_FOR_MS) { return false; }
    return last == 0 or now >= last + CH6_PUNCH_MS;
}
/// The test aid sends one line this often.
pub const CH_SAY_MS : u64 = 1000;
/// At most this many lines from the test aid.
pub const CH_SAY_MAX : u64 = 99;
/// The history is laid out again at least this often ("today" turns into a date after midnight).
pub const CH_RELAYOUT_MS : u64 = 30000;
/// A changed log is written this long after its first change (a burst of ACKs is one write); a sent line at once.
pub const CH_SAVE_MS : u64 = 1000;
/// A save that failed is tried again after CH_SAVE_RETRY_MS; the ACKs of the lines it holds wait for it.
pub const CH_SAVE_RETRY_MS : u64 = 1000;

/// How long a dirty log waits for its save: at once while incoming lines wait for it (their ACKs are held), else
/// CH_SAVE_MS so a burst is written once.
pub fn ch_save_gap(held: u64) -> u64 {
    if (held > 0) { return 0; }
    return CH_SAVE_MS;
}

/// The next save after one at now: none when it was written, a retry when it failed.
pub fn ch_save_next(saved: bool, now: u64) -> u64 {
    if (saved) { return 0; }
    return now + CH_SAVE_RETRY_MS;
}

/// The open log belongs to friend fp (chat_core keeps the friend's fingerprint at byte 28 of the log).
fn ch_log_is(log: []const u8, fp: []const u8) -> bool {
    var i : usize = 0;
    while (i < 10) {
        if (log[28 + i] != fp[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn ch_same_fp(a: []const u8, b: []const u8) -> bool {
    var i : usize = 0;
    while (i < 10) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The friend's chat address as ip * 65536 + port from its row; 0 when the friend is not in view or not online.
pub fn ch_friend_addr(cl: []const u8, fp: []const u8) -> u64 {
    const row : usize = fv_find_fp(cl, fp);
    if (row >= FV_ROWS_SNAP) { return 0; }
    const a : u64 = fv_row_addr(cl, row);
    if (a == 0) { return 0; }
    const p : u64 = chv_chat_port(a % 65536);
    if (p == 0) { return 0; }
    return (a / 65536) * 65536 + p;
}

/// The chat endpoint of friend fp over IPv6 into ep (cleared when none): the call block's last verified endpoint
/// (call_session cs_verified_ep: a call that was ACTIVE with fp's identity verified or stored, never an INVITE alone)
/// when that call was with fp over native IPv6, with the chat port (chat_view chv_chat_port).
pub fn ch_friend_ep6(cs: []const u8, fp: []const u8, ep: []u8) -> void {
    ip6_clear(ep);
    var lfp : [10]u8 = undefined;
    var lep : [18]u8 = undefined;
    if (cs.len < CS_LEN or cs_verified_ep(cs[0..CS_LEN], lfp[0..10], lep[0..18]) == 0) { return; }
    ch_ep6_of(lfp[0..10], lep[0..18], fp, ep);
}

/// The decision of ch_friend_ep6: the last call (fingerprint lfp, endpoint lep) was with fp over native IPv6 -> that
/// address at the chat port (chat_view chv_chat_port) into ep; else ep stays cleared.
pub fn ch_ep6_of(lfp: []const u8, lep: []const u8, fp: []const u8, ep: []u8) -> void {
    ip6_clear(ep);
    if (!ip6_is_set(lep) or ip6_mapped(lep) or !ch_same_fp(lfp, fp)) { return; }
    const p : u64 = chv_chat_port(ip6_port(lep));
    if (p == 0) { return; }
    ip6_copy(ep, lep);
    ep[16] = @as(u8, @intCast((p >> 8) & 255));
    ep[17] = @as(u8, @intCast(p & 255));
}

/// Launch, after cl_boot: the message session on the chat port; calls off or a taken port leave messages off
/// (CHV_UP 0). The unread count of every friend is read from the logs on disk, one after the other in the one buffer.
pub fn ch_boot(cl: []u8, v: []u8, s: []u8, log: []u8, buf: []u8, w: []u64, tt: []const u8) -> void {
    var i : usize = 0;
    while (i < CHW_N) {
        w[i] = 0;
        i = i + 1;
    }
    var e : [8]u8 = undefined;
    const en : usize = cl_env("T27OS_CHAT", e[0..8]);
    if (en == 4 and e[0] == 99 and e[1] == 97 and e[2] == 114 and e[3] == 100) { w[CHW_AID] = 1; }
    if (en == 4 and e[0] == 99 and e[1] == 104 and e[2] == 97 and e[3] == 116) { w[CHW_AID] = 2; }
    var se : [8]u8 = undefined;
    w[CHW_SAY_N] = ch_say_parse(se[0..8], cl_env("T27OS_CHAT_SAY", se[0..8]));
    w[CHW_SAY] = w[CHW_SAY_N];
    ch_trust_load(cl, v, w, tt);
    if (cl[CL_UP] == 0) { return; }
    const port : u64 = chv_chat_port(cl_me_port(cl));
    if (port == 0) { return; }
    if (cs_open(s, cl[FE_FP .. FE_FP + 10], cl_ip(cl, CL_ME_IP), port, CS_AUDIO_NONE) == false) { return; }
    // a message session opens only for a friend who proves the key stored for it, with this device's key on our side
    cs_identity(s, cl[FE_ID + ID_OFF_PUB .. FE_ID + ID_OFF_PUB + 65], cl[FE_ID + ID_OFF_PRIV .. FE_ID + ID_OFF_PRIV + 97]);
    cs_set(s, CS_K_CALLING_MS, CH_CALLING_MS);
    cs_set(s, CS_K_SILENT_MS, CH_SILENT_MS);
    v[CHV_UP] = 1;
    const n : usize = @as(usize, ft_count(cl[FE_FT .. FE_FT + FT_LEN]));
    i = 0;
    while (i < n and i < FT_MAX) {
        var fp : [10]u8 = undefined;
        if (ft_fp_at(cl[FE_FT .. FE_FT + FT_LEN], i, fp[0..10])) {
            if (chh_load(fp[0..10], log, CL_KEEP, buf) == CHH_LOADED) { chv_unr_set(v, fp[0..10], cl_unread(log)); }
        }
        i = i + 1;
    }
}

/// T27OS_CHAT_SAY's value: its decimal digits as a count, 0 when it is not a number from 1 to CH_SAY_MAX.
pub fn ch_say_parse(e: []const u8, n: usize) -> u64 {
    if (n == 0 or n > 2) { return 0; }
    var r : u64 = 0;
    var i : usize = 0;
    while (i < n) {
        if (e[i] < 48 or e[i] > 57) { return 0; }
        r = r * 10 + @as(u64, e[i] - 48);
        i = i + 1;
    }
    if (r > CH_SAY_MAX) { return 0; }
    return r;
}

/// The test aid's line k of n: "say k of n".
pub fn ch_say_text(out: []u8, k: u64, n: u64) -> usize {
    var at : usize = put_bytes(out, 0, "say ");
    at = put_dec(out, at, k);
    at = put_bytes(out, at, " of ");
    return put_dec(out, at, n);
}

/// The message session goes, whatever its state (a ringing one is declined, a live one hung up).
fn ch_close_session(s: []u8) -> void {
    const st : u32 = cs_state(s);
    if (st == CK_IDLE) { return; }
    if (st == CK_RINGING) {
        cs_decline(s);
    } else if (st != CK_ENDED and st != CK_FAILED) {
        cs_hangup(s);
    }
    cs_dismiss(s);
}

/// The log of friend fp becomes the open one (the one before it is written first; a session with another friend goes,
/// a ringing one from fp stays for chm_tick to answer). False when the log cannot be read.
pub fn ch_open_log(cl: []const u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64, fp: []const u8) -> bool {
    if (w[CHW_LOADED] != 0 and ch_log_is(log, fp)) { return true; }
    if (w[CHW_LOADED] != 0 and w[CHW_SAVE_AT] != 0) {
        if (chh_save(log, buf) == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
    }
    w[CHW_SAVE_AT] = 0;
    w[CHW_LOADED] = 0;
    var rf : [10]u8 = undefined;
    if (chm_ringing(s, rf[0..10]) == false or ch_same_fp(rf[0..10], fp) == false) { ch_close_session(s); }
    if ((chh_load(fp, log, CL_KEEP, buf) & 255) == CHH_IOERR) { return false; }
    w[CHW_LOADED] = 1;
    const a : u64 = ch_friend_addr(cl, fp);
    chm_init(m, fp, a / 65536, a % 65536);
    chv_unr_set(v, fp, cl_unread(log));
    v[CHV_DIRTY] = 1;
    return true;
}

/// The trust table from the friends file's key slots: a friend of the list with a stored key is pinned (a refusal seen
/// in this run, or one on file in trust.t27, is kept), one with none is not verified; a friend no longer in the list
/// loses its entry.
pub fn ch_trust_from_keys(cl: []const u8, v: []u8, keys: []const u8, tt: []const u8) -> void {
    var k : usize = 0;
    while (k < CHV_TR_MAX) {
        const a : usize = chv_tr_at(k);
        if (v[a + 10] != 0 and ft_find(cl[FE_FT .. FE_FT + FT_LEN], v[a .. a + 10]) == FT_MAX) { v[a + 10] = 0; }
        k = k + 1;
    }
    const n : usize = @as(usize, ft_count(cl[FE_FT .. FE_FT + FT_LEN]));
    var i : usize = 0;
    while (i < n and i < FT_MAX) {
        var fp : [10]u8 = undefined;
        if (ft_fp_at(cl[FE_FT .. FE_FT + FT_LEN], i, fp[0..10])) {
            const was : u32 = chv_tr_get(v, fp[0..10]);
            if (fk_find(keys[0..FK_LEN], fp[0..10]) != FT_MAX) {
                chv_tr_set(v, fp[0..10], tru_bits(tt, fp[0..10], FV_TB_PIN | (was & FV_TB_BAD)));
            } else {
                chv_tr_set(v, fp[0..10], 0);
            }
        }
        i = i + 1;
    }
}

/// Read the friends file's keys (public keys only; none is printed) into the trust table. A stored key that does not
/// hash to its friend's fingerprint is dropped by the read (that friend reads not verified); one line says how many.
pub fn ch_trust_load(cl: []const u8, v: []u8, w: []u64, tt: []const u8) -> void {
    var keys : [2400]u8 = undefined;
    var bad : u32 = ih_friends_keys_n(keys[0..FK_LEN]);
    if (bad == IH_FK_FAIL) { bad = 0; }
    if (w.len > CHW_FK_BAD and @as(u64, bad) + 1 != w[CHW_FK_BAD]) {
        if (bad > 0 or w[CHW_FK_BAD] > 1) {
            var line : [96]u8 = undefined;
            var n : usize = put_bytes(line[0..96], 0, "FRIENDS every stored key hashes to its fingerprint again");
            if (bad > 0) {
                n = put_bytes(line[0..96], 0, "FRIENDS ");
                n = put_dec(line[0..96], n, @as(u64, bad));
                n = put_bytes(line[0..96], n, " stored key(s) do not hash to the fingerprint, dropped: not verified");
            }
            sys_write(2, line[0..n], @as(u64, n));
            sys_write(2, "\n", 1);
        }
        w[CHW_FK_BAD] = @as(u64, bad) + 1;
    }
    ch_trust_from_keys(cl, v, keys[0..FK_LEN], tt);
    w[CHW_TR_N] = @as(u64, ft_count(cl[FE_FT .. FE_FT + FT_LEN])) + 1;
    w[CHW_TR_AT] = ckh_ms();
}

/// Launch: the key mismatch warnings from ~/.t27os/trust.t27 (a damaged file is kept aside as trust.t27.bad and the
/// table starts empty; a file that is there and cannot be read is left as it is and held: ch_trust_held); one line on
/// stderr with how many friends carry one. The open's IH_* status.
pub fn ch_trust_boot(tt: []u8) -> u32 {
    const r : u32 = ih_trust_open(tt);
    if ((r & 255) != 2 and (r & 255) != 1) { tru_init(tt); }
    var line : [96]u8 = undefined;
    var n : usize = put_bytes(line[0..96], 0, "TRUST loaded ");
    n = put_dec(line[0..96], n, @as(u64, tru_count(tt)));
    n = put_bytes(line[0..96], n, " key mismatch warning(s)");
    if ((r & 255) == 3) { n = put_bytes(line[0..96], n, ", damaged file kept"); }
    if ((r & 255) == IH_IOERR) { n = put_bytes(line[0..96], n, ", file unreadable: kept as is, not written"); }
    sys_write(2, line[0..n], @as(u64, n));
    sys_write(2, "\n", 1);
    return r;
}

/// After the launch's open (IH_*): 1 when trust.t27 must not be written until it reads (it could not be read).
pub fn ch_trust_held(r: u32) -> u64 {
    if ((r & 255) == IH_IOERR) { return 1; }
    return 0;
}

/// The warnings of this run (tt) folded into the file's table f: a friend's refusals add up, the latest time and
/// reason win, the latest refusal ends on top. A warning the file holds stays (a check that cleared one while the file
/// could not be read clears nothing on file: the next good check clears it).
pub fn ch_trust_merge(f: []u8, tt: []const u8) -> void {
    var i : usize = tru_count(tt);
    while (i > 0) {
        i = i - 1;
        const a : usize = tru_at(i);
        const fp : []const u8 = tt[a + TRR_FP .. a + TRR_FP + 10];
        const had : u64 = @as(u64, tru_refused(f, fp));
        var last : u64 = tru_last(tt, fp);
        if (tru_last(f, fp) > last) { last = tru_last(f, fp); }
        if (tru_refuse(f, fp, tt[a + TRR_REASON], last)) {
            var c : u64 = had + @as(u64, tru_refused(tt, fp));
            if (c > 4294967295) { c = 4294967295; }
            fv_put32(f, tru_at(tru_find(f, fp)) + TRR_COUNT, c);
            tru_seal(f);
        }
    }
}

/// May trust.t27 be written now? Not held: yes. Held: f is the file read again (fr its IH_* status); still unreadable
/// -> no, and tt keeps this run's warnings; read (or moved aside as damaged, f empty) -> tt becomes the file's
/// warnings with this run's merged in, the hold ends, yes.
pub fn ch_trust_gate(w: []u64, tt: []u8, f: []u8, fr: u32) -> bool {
    if (w[CHW_TR_HELD] == 0) { return true; }
    if ((fr & 255) == IH_IOERR) { return false; }
    if ((fr & 255) != IH_LOADED) { tru_init(f); }
    ch_trust_merge(f, tt);
    var i : usize = 0;
    while (i < TRU_LEN) {
        tt[i] = f[i];
        i = i + 1;
    }
    w[CHW_TR_HELD] = 0;
    return true;
}

/// Write trust.t27 when the gate allows it (a held file is read again first); one line when it is held.
fn ch_trust_write(w: []u64, tt: []u8) -> bool {
    var f : [1556]u8 = undefined;
    var fr : u32 = IH_LOADED;
    if (w[CHW_TR_HELD] != 0) { fr = ih_trust_open(f[0..TRU_LEN]); }
    if (!ch_trust_gate(w, tt, f[0..TRU_LEN], fr)) {
        var line : [96]u8 = undefined;
        var n : usize = put_bytes(line[0..96], 0, "TRUST file unreadable, not written; ");
        n = put_dec(line[0..96], n, @as(u64, tru_count(tt)));
        n = put_bytes(line[0..96], n, " warning(s) kept in memory");
        sys_write(2, line[0..n], @as(u64, n));
        sys_write(2, "\n", 1);
        return false;
    }
    return ih_trust_save(tt);
}

/// The verdict of one session (a call or the message session) on its peer's trust: a refused key is a mismatch, a
/// proven stored key clears it, a key stored after a matched code is read back from the friends file (at most every
/// CH_TR_READ_MS while the file still says otherwise).
pub const CH_TR_READ_MS : u64 = 2000;

/// The first 8 bytes of a session's id as a number (0 when there is no block): one session, one refusal on file.
fn ch_sid(s: []const u8) -> u64 {
    if (s.len < EP_SID + 8) { return 0; }
    var x : u64 = 0;
    var i : usize = 8;
    while (i > 0) {
        x = x * 256 + @as(u64, s[EP_SID + i - 1]);
        i = i - 1;
    }
    return x;
}

/// One session's identity verdict id (call_session CS_ID_*) on friend fp, session sid, in a call or the message
/// session, folded into the window's bits (v) and into trust.t27 (tt), once per session (the id of the session whose
/// verdict was applied is kept in w[CHW_RF_CALL] / w[CHW_RF_MSG]; an unverified session has no verdict yet). The
/// file's warning goes only with the person's own good check: the stored key proved again (VERIFIED), or, in a call,
/// the code compared and matched (STORED); a message session that stores a first key clears nothing. Returns
/// trust.t27 TRU_S_*: MARKED and CLEARED mean tt is to be written.
pub fn ch_trust_apply(v: []u8, w: []u64, tt: []u8, fp: []const u8, id: u32, sid: u64, call: bool, now: u64) -> u32 {
    var slot : usize = CHW_RF_MSG;
    var reason : u8 = TRU_R_MESSAGE;
    if (call) {
        slot = CHW_RF_CALL;
        reason = TRU_R_CALL;
    }
    if (id != CS_ID_REFUSED and id != CS_ID_VERIFIED and id != CS_ID_STORED) { return TRU_S_NONE; }
    if (w[slot] == sid) { return TRU_S_NONE; }
    w[slot] = sid;
    if (id == CS_ID_REFUSED) {
        chv_tr_step(v, fp, false, false, true);
        return tru_step(tt, fp, true, true, false, reason, now);
    }
    const r : u32 = tru_step(tt, fp, false, false, id == CS_ID_VERIFIED or call, reason, now);
    if (id == CS_ID_VERIFIED) { chv_tr_step(v, fp, false, true, false); }
    if (id == CS_ID_STORED) {
        const pin : bool = (chv_tr_get(v, fp) & FV_TB_PIN) != 0;
        chv_tr_step(v, fp, false, pin and tru_find(tt, fp) == TRU_MAX, false);
    }
    return r;
}

fn ch_trust_log(fp: []const u8, r: u32, n: u32) -> void {
    var line : [80]u8 = undefined;
    var k : usize = put_bytes(line[0..80], 0, "TRUST ");
    k = k + fv_short_fp(fp, line[k..80]);
    if (r == TRU_S_MARKED) {
        k = put_bytes(line[0..80], k, " key mismatch on file, refused ");
        k = put_dec(line[0..80], k, @as(u64, n));
    } else {
        k = put_bytes(line[0..80], k, " checked, warning cleared");
    }
    sys_write(2, line[0..k], @as(u64, k));
    sys_write(2, "\n", 1);
}

/// The verdict of session block s on its peer. The peer and the verdict are read whatever the state: a message session
/// that is refused ends and is dismissed within one poll, and its block keeps both until the next session wipes them.
pub fn ch_trust_session(cl: []const u8, v: []u8, w: []u64, tt: []u8, s: []const u8, call: bool, now: u64) -> void {
    if (s.len < CS_LEN) { return; }
    var fp : [10]u8 = undefined;
    var k : usize = 0;
    while (k < 10) {
        fp[k] = s[EP_PEER + k];
        k = k + 1;
    }
    if (ft_find(cl[FE_FT .. FE_FT + FT_LEN], fp[0..10]) == FT_MAX) { return; }
    const id : u32 = cs_id_state(s);
    if (id == CS_ID_STORED and (chv_tr_get(v, fp[0..10]) & FV_TB_PIN) == 0 and now >= w[CHW_TR_AT] + CH_TR_READ_MS) { ch_trust_load(cl, v, w, tt); }
    const r : u32 = ch_trust_apply(v, w, tt, fp[0..10], id, ch_sid(s), call, now);
    if (r == TRU_S_NONE) { return; }
    ch_trust_write(w, tt);
    ch_trust_log(fp[0..10], r, tru_refused(tt, fp[0..10]));
}

/// A friend's row in the cabinet: that friend's card.
pub fn ch_card(cl: []const u8, v: []u8, row: usize) -> void {
    if (row >= @as(usize, cl[FV_SHOWN]) or row >= FV_ROWS_SNAP) { return; }
    const r : usize = fv_row_at(row);
    chv_open_card(v, cl[r + FR_FP .. r + FR_FP + 10]);
    chv_friend(v, cl[r + FR_NICK .. r + FR_NICK + 24], @as(usize, cl[r + FR_NICKLEN]), cl[r + FR_ONLINE] != 0, fv_get32(cl, r + FR_AGO));
}

/// What a point means on the card or in the chat at this window size.
pub fn ch_hit_now(x: f64, y: f64, sw: f64, sh: f64, v: []const u8) -> u32 {
    if (chv_mode(v) == CHV_M_CARD) { return chv_card_hit(x, y, qp_left(sw), QP_W, WS_TOP); }
    if (chv_mode(v) == CHV_M_CHAT) { return chv_chat_hit(x, y, qp_left(sw), QP_W, WS_TOP, sh - WS_TOP); }
    if (gv_chat_shown(v)) { return gv_chat_hit(x, y, qp_left(sw), QP_W, WS_TOP, sh - WS_TOP); }
    return CHV_H_NONE;
}

/// Return or SEND: the typed text into the friend's log as PENDING (written at once); the session sends it, or it
/// waits for the friend. With messages off the text stays in the field and the note says why.
pub fn ch_send(cl: []const u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64) -> void {
    if (chv_mode(v) != CHV_M_CHAT) { return; }
    if (v[CHV_UP] == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_OFF));
        return;
    }
    var fp : [10]u8 = undefined;
    var i : usize = 0;
    while (i < 10) {
        fp[i] = v[CHV_FP + i];
        i = i + 1;
    }
    if (ch_open_log(cl, v, s, m, log, buf, w, fp[0..10]) == false) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE));
        return;
    }
    var t : [2000]u8 = undefined;
    const n : usize = chv_take(v, t[0..2000]);
    if (n == 0) { return; }
    const now : u64 = ckh_ms();
    if (chm_send(m, log, t[0..n], now) == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_LONG));
        return;
    }
    w[CHW_SAVE_AT] = now;
    v[CHV_DIRTY] = 1;
}

/// CALL (video false) or VIDEO on the card or in the chat: the friend must be online; the message session closes first
/// and its log is written; then the call goes the way a friend is always called (cl_front, fe_call).
pub fn ch_call(cl: []u8, v: []u8, s: []u8, log: []u8, buf: []u8, w: []u64, cs: []u8, clw: []u64, video: bool) -> void {
    v[CHV_NOTE] = 0;
    if (cl[CL_UP] == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_CALLS_OFF));
        return;
    }
    const row : usize = fv_find_fp(cl, v[CHV_FP .. CHV_FP + 10]);
    if (row >= FV_ROWS_SNAP) { return; }
    if (cl[fv_row_at(row) + FR_ONLINE] == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_OFFLINE));
        return;
    }
    if (video and cl[CL_VSEND] == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOVIDEO));
        return;
    }
    if (v[CHV_UP] != 0) { ch_close_session(s); }
    if (w[CHW_LOADED] != 0 and w[CHW_SAVE_AT] != 0) {
        w[CHW_SAVE_AT] = 0;
        if (chh_save(log, buf) == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
    }
    if (cs_state(cs) == CK_IDLE) {
        if (video) {
            cl[CL_NOCAM] = 0;
            cs_set(cs, CS_K_VIDEO, 1);
        } else {
            cl[CL_NOCAM] = 1;
            cs_set(cs, CS_K_VIDEO, 0);
        }
    }
    cl_front(cl, cs, clw, FV_H_ROW + @as(u32, @intCast(row)));
}

/// MESSAGE: the chat with the card's friend, its log open, every incoming line READ (sent with the next session).
pub fn ch_message(cl: []const u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64) -> void {
    ch_message_at(cl, v, s, m, log, buf, w, ckh_ms());
}

/// ch_message at the time now.
pub fn ch_message_at(cl: []const u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64, now: u64) -> void {
    var fp : [10]u8 = undefined;
    var i : usize = 0;
    while (i < 10) {
        fp[i] = v[CHV_FP + i];
        i = i + 1;
    }
    chv_open_chat(v);
    if (ch_open_log(cl, v, s, m, log, buf, w, fp[0..10])) {
        if (chm_open(m, log)) { w[CHW_SAVE_AT] = now + CH_SAVE_MS; }
        chv_unr_set(v, fp[0..10], 0);
    } else {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE));
    }
    if (v[CHV_UP] == 0) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_OFF)); }
}

/// One hit on the card or in the chat as one action.
pub fn ch_do(cl: []u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64, cs: []u8, clw: []u64, hit: u32) -> void {
    if (hit == CHV_H_NONE) { return; }
    if (hit == CHV_H_BACK) {
        if (w[CHW_LOADED] != 0 and w[CHW_SAVE_AT] != 0) {
            w[CHW_SAVE_AT] = 0;
            if (chh_save(log, buf) == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
        }
        chv_back(v);
        cl[CL_NOTE] = 0;
    } else if (hit == CHV_H_MESSAGE) {
        // a friend who is not verified: the reason, not a session the friend's side would refuse (CS_R_UNVERIFIED)
        const note : u32 = chv_message_note(chv_trust(v, v[CHV_FP .. CHV_FP + 10]));
        if (note != CHV_N_NONE) {
            v[CHV_NOTE] = @as(u8, @intCast(note));
        } else {
            ch_message(cl, v, s, m, log, buf, w);
        }
    } else if (hit == CHV_H_CALL or hit == CHV_H_VIDEO) {
        ch_call(cl, v, s, log, buf, w, cs, clw, hit == CHV_H_VIDEO);
    } else if (hit == CHV_H_FIELD or hit == CHV_H_HIST) {
        v[CHV_FOCUS] = 1;
    } else if (hit == CHV_H_SEND) {
        v[CHV_FOCUS] = 1;
        ch_send(cl, v, s, m, log, buf, w);
    }
}

/// One pass of the main loop: the friend of the card (its name, online, the card closes when it left the list), the
/// message session, the save, the history in view. tz is CHV_TZ_BIAS + seconds east of UTC, h the panel's height.
/// The message session is served on every pass while messages are up, whatever the panel shows and whatever the call
/// block holds: a call that ended stays CK_ENDED until its CLOSE is clicked, and an incoming session from a friend must
/// still be answered, its lines logged and ACKed, the unread count kept (READ goes out only once the chat is opened).
pub fn ch_tick(cl: []u8, v: []u8, s: []u8, m: []u8, log: []u8, asm: []u8, buf: []u8, w: []u64, cs: []u8, iv: []u8, gv: []u8, gx: []u8, tz: u64, h: f64, tt: []u8) -> void {
    ch_tick_at(cl, v, s, m, log, asm, buf, w, cs, iv, gv, gx, tz, h, ckh_ms(), tt);
}

/// ch_tick at the time now (ms of ckh_ms). gv and gx are the groups' region and the open group's buffer (GR; empty
/// slices: no group).
pub fn ch_tick_at(cl: []u8, v: []u8, s: []u8, m: []u8, log: []u8, asm: []u8, buf: []u8, w: []u64, cs: []u8, iv: []u8, gv: []u8, gx: []u8, tz: u64, h: f64, now: u64, tt: []u8) -> void {
    // IP6: after a verified call with a friend over IPv6 both chat sockets punch toward each other's chat port
    // (call_nat probes) for 10 min after it (ch6_punch_due), so a message then passes both routers; in memory only
    if (w.len > CHW_P6_AT and cs.len >= CS_LEN) {
        var pfp : [10]u8 = undefined;
        var pep : [18]u8 = undefined;
        if (ch6_punch_due(now, w[CHW_P6_AT], cs_verified_ep(cs[0..CS_LEN], pfp[0..10], pep[0..18]))) {
            w[CHW_P6_AT] = now;
            if (ft_find(cl[FE_FT .. FE_FT + FT_LEN], pfp[0..10]) != FT_MAX) {
                var cep : [18]u8 = undefined;
                ch_ep6_of(pfp[0..10], pep[0..18], pfp[0..10], cep[0..18]);
                if (ip6_is_set(cep[0..18])) { cs_probe_send6(s, cep[0..18]); }
            }
        }
    }
    // the call block goes back to its launch setting once a call is over (CALL turned video and the camera off for it)
    if (cl[CL_NOCAM] != 0 and cs_state(cs) == CK_IDLE) {
        cl[CL_NOCAM] = 0;
        cs_set(cs, CS_K_VIDEO, @as(u64, cl[CL_VSEND]));
    }
    // the test aid: the first friend's card or chat once the list is known
    if (w[CHW_AID] != 0 and cl[FV_SHOWN] > 0 and cl[CL_OPEN] != 0 and cl[AC_ON] != 0) {
        ch_card(cl, v, 0);
        if (w[CHW_AID] == 2) { ch_message_at(cl, v, s, m, log, buf, w, now); }
        w[CHW_AID] = 0;
    }
    // GR. the test aid T27OS_GROUP: the first group's chat, or NEW GROUP, once the cabinet is open
    // (=chat waits for a group to come, from the disk or by GROUP_INFO; =make makes "test" with the first friend)
    if (gv.len >= GV_CAP and gv[GV_G_AID] != 0 and cl[CL_OPEN] != 0 and cl[AC_ON] != 0) {
        if (gv[GV_G_AID] == 1) {
            gv_new_open(gv);
            gv[GV_G_AID] = 0;
        } else if (gv[GV_G_AID] == 3) {
            if (ft_count(cl[FE_FT .. FE_FT + FT_LEN]) > 0) {
                gw_make_aid(cl, v, gv, gx, buf, now);
                gv[GV_G_AID] = 0;
            }
        } else if (gv_count(gv) > 0) {
            gw_open_chat(cl, v, gv, gx, buf, 0, now);
            gv[GV_G_AID] = 0;
        }
    }
    // the test aid T27OS_CHAT_SAY: once the chat is open, one numbered line a second through the field and ch_send
    if (w[CHW_SAY] != 0 and w[CHW_AID] == 0 and (chv_mode(v) == CHV_M_CHAT or gv_chat_shown(v)) and now >= w[CHW_SAY_AT]) {
        var st : [32]u8 = undefined;
        const sn : usize = ch_say_text(st[0..32], w[CHW_SAY_N] - w[CHW_SAY] + 1, w[CHW_SAY_N]);
        chv_type_bytes(v, st[0..32], sn);
        if (gv_chat_shown(v)) { gw_send(cl, v, gv, gx, now); } else { ch_send(cl, v, s, m, log, buf, w); }
        w[CHW_SAY] = w[CHW_SAY] - 1;
        w[CHW_SAY_AT] = now + CH_SAY_MS;
    }
    // trust: the list changed (a friend added or removed) -> read the keys again; each session's verdict on its peer
    if (w[CHW_TR_N] != @as(u64, ft_count(cl[FE_FT .. FE_FT + FT_LEN])) + 1) { ch_trust_load(cl, v, w, tt); }
    ch_trust_session(cl, v, w, tt, cs, true, now);
    ch_trust_session(cl, v, w, tt, s, false, now);
    if (chv_mode(v) == CHV_M_CARD or chv_mode(v) == CHV_M_CHAT) {
        const row : usize = fv_find_fp(cl, v[CHV_FP .. CHV_FP + 10]);
        if (row >= FV_ROWS_SNAP) {
            chv_close(v);
        } else {
            const r : usize = fv_row_at(row);
            chv_friend(v, cl[r + FR_NICK .. r + FR_NICK + 24], @as(usize, cl[r + FR_NICKLEN]), cl[r + FR_ONLINE] != 0, fv_get32(cl, r + FR_AGO));
        }
    }
    if (v[CHV_UP] == 0) {
        gw_tick(cl, v, gv, gx, buf, 0, tz, h, now);
        return;
    }
    var gev : u32 = 0;
    if (w[CHW_LOADED] == 0) {
        // no log open: read the socket; a friend whose session rings gets its log opened (answered next pass); someone
        // who is not a friend is answered for an invitation (ivw_ringing) and its end is written (ivw_take)
        var e : u32 = cs_poll(s);
        var g : u32 = 0;
        while (e != CS_EV_NONE and g < 32) {
            if (e == CS_EV_ENDED or e == CS_EV_FAILED) {
                if ((chm_end_bits(e == CS_EV_FAILED, cs_reason(s)) & CHM_E_INVITE) != 0) { ivw_take(cl, s, iv, now); }
                cs_dismiss(s);
            }
            e = cs_poll(s);
            g = g + 1;
        }
        var rf : [10]u8 = undefined;
        if (chm_ringing(s, rf[0..10])) {
            if (ft_find(cl[FE_FT .. FE_FT + FT_LEN], rf[0..10]) == FT_MAX) {
                ivw_ringing(cl, s, iv, now);
            } else {
                ch_open_log(cl, v, s, m, log, buf, w, rf[0..10]);
            }
        }
    } else {
        var lf : [10]u8 = undefined;
        var i : usize = 0;
        while (i < 10) {
            lf[i] = log[28 + i];
            i = i + 1;
        }
        const a : u64 = ch_friend_addr(cl, lf[0..10]);
        chm_addr(m, a / 65536, a % 65536);
        // IP6: no fresh IPv4 for this friend here, but its last call came over IPv6: its chat port there (call_ip6
        // ip6_prefer: IPv4 on this network first); in memory only
        var c6 : [18]u8 = undefined;
        ch_friend_ep6(cs, lf[0..10], c6[0..18]);
        if (ip6_prefer(a, a != 0, c6[0..18]) == IP6_P_V6) { chm_addr6(m, c6[0..18]); } else { chm_addr6(m, c6[0..0]); }
        // GR. the open group's payloads ride this friend's session, and its lines owed to this friend go out over it
        // a GROUP_INFO is taken whatever group is open (the table and the ANNOUNCEs owed ride every pass)
        var ev : u32 = 0;
        if (gw_active(gv, gx)) {
            ev = chm_tick_g(m, s, log, asm, cl[FE_FT .. FE_FT + FT_LEN], cl[FE_FP .. FE_FP + 10], now, gx[GX_GRM..GX_ASM], gv[GV_T..GV_T_END], gx[GX_LOG..GX_LEN], gx[GX_ASM..GX_LOG], gv[GV_INFO..GV_INFO_END]);
        } else if (gv.len >= GV_CAP) {
            var gz : [1]u8 = undefined;
            ev = chm_tick_g(m, s, log, asm, cl[FE_FT .. FE_FT + FT_LEN], cl[FE_FP .. FE_FP + 10], now, gz[0..0], gv[GV_T..GV_T_END], gz[0..0], gz[0..0], gv[GV_INFO..GV_INFO_END]);
        } else {
            ev = chm_tick(m, s, log, asm, cl[FE_FT .. FE_FT + FT_LEN], cl[FE_FP .. FE_FP + 10], now);
        }
        if ((ev & CHM_E_GINFO) != 0) { gw_learned(cl, v, gv, gx, buf); }
        gev = ev;
        if ((ev & CHM_E_INVITE) != 0) { ivw_take(cl, s, iv, now); }
        if ((ev & CHM_E_STRANGER) != 0) { ivw_ringing(cl, s, iv, now); }
        const shown : bool = chv_mode(v) == CHV_M_CHAT and chv_is(v, lf[0..10]);
        if ((ev & CHM_E_NEW) != 0 and shown) { chm_open(m, log); }
        if ((ev & (CHM_E_NEW | CHM_E_STATUS | CHM_E_DIRTY)) != 0) { v[CHV_DIRTY] = 1; }
        if ((ev & CHM_E_DIRTY) != 0 and w[CHW_SAVE_AT] == 0) { w[CHW_SAVE_AT] = now + ch_save_gap(chm_held(m)); }
        chv_unr_set(v, lf[0..10], cl_unread(log));
        if ((ev & CHM_E_OTHER) != 0 and shown == false and cl_pending(log) == 0) {
            var of : [10]u8 = undefined;
            if (chm_ringing(s, of[0..10])) { ch_open_log(cl, v, s, m, log, buf, w, of[0..10]); }
        }
    }
    // a message session refused for its key ended and was dismissed in this pass: its verdict before the next one rings
    ch_trust_session(cl, v, w, tt, s, false, now);
    // the save, then the ACKs of the lines it put on disk; a failed save sends none and is tried again
    if (w[CHW_LOADED] != 0 and w[CHW_SAVE_AT] != 0 and now >= w[CHW_SAVE_AT]) {
        const saved : bool = chh_save(log, buf);
        w[CHW_SAVE_AT] = ch_save_next(saved, now);
        chm_saved(m, s, saved);
        if (saved == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
    }
    if (chv_mode(v) == CHV_M_CHAT and w[CHW_LOADED] != 0 and ch_log_is(log, v[CHV_FP .. CHV_FP + 10])) {
        const hh : f64 = chv_hist_h(h);
        const hu : u64 = @as(u64, @intFromFloat(hh));
        if (v[CHV_DIRTY] != 0 or hu != w[CHW_HH] or now >= w[CHW_LAYOUT_AT] + CH_RELAYOUT_MS) {
            chv_layout(v, log, now, tz, QP_W, hh);
            w[CHW_LAYOUT_AT] = now;
            w[CHW_HH] = hu;
        }
    }
    // GR. the fan-out to the next member owed, the open group's events, save and history
    gw_rotate(cl, v, s, m, log, buf, w, gv, gx);
    gw_tick(cl, v, gv, gx, buf, gev, tz, h, now);
}

/// The unread badge on a friend's row: a white pill ending at `right`, the count in dark ink.
fn draw_ch_badge(c: u64, kit: [48]u64, right: f64, cy: f64, n: u32) -> void {
    var b : [8]u8 = undefined;
    const bn : usize = chv_badge_text(n, b[0..8]);
    const tw : f64 = bytes_w(kit, b[0..8], bn, 8.5, WEIGHT_SEMIBOLD, false);
    var bw : f64 = tw + 10.0;
    if (bw < 16.0) { bw = 16.0; }
    round_rect(c, right - bw, cy - 7.0, bw, 14.0, 7.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    cg_fill_path(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.85);
    draw_bytes(c, kit, b[0..8], bn, right - 0.5 * bw - 0.5 * tw, cy + 3.0, 8.5, WEIGHT_SEMIBOLD, false);
}

/// The note line of the card: a chat note, else the last call note (why the friend cannot be called now).
fn draw_ch_note(c: u64, kit: [48]u64, cl: []const u8, v: []const u8, x: f64, right: f64, base: f64, sh: f64) -> void {
    var line : [96]u8 = undefined;
    const vc : u32 = @as(u32, v[CHV_NOTE]);
    const code : u32 = @as(u32, cl[CL_NOTE]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    if (vc != 0) {
        draw_cl_wrap(c, kit, chv_note_text(vc), x, right, base, 9.5, 2, sh);
    } else if (code >= 32 and code < 38) {
        var n : usize = put_bytes(line[0..96], 0, "Cannot call now: ");
        n = put_bytes(line[0..96], n, fv_offline_text(code));
        draw_cl_wrap(c, kit, line[0..n], x, right, base, 9.5, 2, sh);
    } else if (code != 0 and fv_note_is_mine(code)) {
        draw_cl_wrap(c, kit, fv_note_text(code), x, right, base, 9.5, 2, sh);
    } else if (code != 0) {
        draw_cl_wrap(c, kit, cv_note_text(code), x, right, base, 9.5, 2, sh);
    }
}

/// A card button that cannot be used now: no hover, its word muted (a click still says why, in the note line).
fn draw_ch_btn_off(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: []const u8, sw: f64) -> void {
    draw_plate(c, bx - 2.0, by - 2.0, bw + 4.0, CV_BTN_H + 4.0, sw);
    round_rect(c, bx, by, bw, CV_BTN_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    const lw : f64 = bytes_w(kit, word, word.len, 9.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, word.len, bx + 0.5 * (bw - lw), by + 17.0, 9.5, WEIGHT_SEMIBOLD, false);
}

fn draw_ch_card(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, cl: []const u8, v: []const u8, tt: []const u8) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const hit : u32 = chv_card_hit(mx, my, l, QP_W, t);
    var line : [96]u8 = undefined;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    draw_ac_btn_small(c, kit, chv_back_x(l), t + CHV_BACK_Y, CHV_BACK_W, "<", hit == CHV_H_BACK);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "FRIEND", 6, x + CHV_BACK_W + 8.0, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    // the friend: the circle (the nickname's initial), the nickname, the key's short form, online or when last met
    const nl : usize = @as(usize, v[CHV_NICKLEN]);
    draw_pf_avatar(c, kit, 0, v[CHV_NICK .. CHV_NICK + 32], nl, chv_av_cx(l), t + CHV_AV_CY, CHV_AV_R, false, 1.0);
    if (nl > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, v[CHV_NICK .. CHV_NICK + 32], nl, chv_nick_x(l), t + CHV_NICK_BASE, 13.0, WEIGHT_SEMIBOLD, false, right);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "(no name yet)", 13, chv_nick_x(l), t + CHV_NICK_BASE, 13.0, 0.0, false);
    }
    // the key and beside it whether it is verified (a check mark), not verified, or did not match last time
    const trust : u32 = chv_trust(v, v[CHV_FP .. CHV_FP + 10]);
    var tw : [32]u8 = undefined;
    const twn : usize = fv_trust_word_put(tw[0..32], trust);
    const twd : f64 = bytes_w(kit, tw[0..32], twn, 9.0, WEIGHT_SEMIBOLD, false);
    var n : usize = ac_fp_line(v[CHV_FP .. CHV_FP + 10], line[0..96]);
    const tx : f64 = chv_trust_x(l, QP_W, bytes_w(kit, line[0..96], n, 9.0, 0.0, true), twd);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    draw_fit(c, kit, line[0..96], n, chv_nick_x(l), t + CHV_FP_BASE, 9.0, 0.0, true, tx - CHV_TR_GAP);
    if (trust == FV_T_UNVERIFIED) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    draw_fit(c, kit, tw[0..32], twn, tx, t + CHV_FP_BASE, 9.0, WEIGHT_SEMIBOLD, false, right);
    // trust.t27: while a refusal is on file, how often and how long ago, under the key (the mark is not "verified")
    if (trust == FV_T_MISMATCH) {
        n = tru_line_for(tt, v[CHV_FP .. CHV_FP + 10], ckh_ms(), line[0..96]);
        if (n > 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_fit(c, kit, line[0..96], n, chv_nick_x(l), t + CHV_RF_BASE, 9.0, WEIGHT_SEMIBOLD, false, right);
        }
    }
    const online : bool = v[CHV_ONLINE] != 0;
    draw_cl_dot(c, kit, x, t + CHV_STATE_BASE - 8.0, online);
    n = chv_status_put(line[0..96], online, fv_get32(v, CHV_AGO), chv_unr_get(v, v[CHV_FP .. CHV_FP + 10]));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_fit(c, kit, line[0..96], n, x + 14.0, t + CHV_STATE_BASE, 10.0, WEIGHT_SEMIBOLD, false, right);
    // MESSAGE, CALL, VIDEO
    var b : u32 = 0;
    while (b < 3) {
        if (b == 0 and chv_message_ok(trust) == false) {
            draw_ch_btn_off(c, kit, chv_card_btn_x(l, QP_W, b), t + CHV_CARD_BTN_Y, chv_card_btn_w(QP_W), chv_card_word(b), sw);
        } else {
            draw_cl_btn(c, kit, chv_card_btn_x(l, QP_W, b), t + CHV_CARD_BTN_Y, chv_card_btn_w(QP_W), chv_card_word(b), sw, hit == CHV_H_MESSAGE + b);
        }
        b = b + 1;
    }
    if (trust == FV_T_MISMATCH) { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE)); }
    draw_cl_wrap(c, kit, chv_card_hint(online, trust), x, right, t + CHV_HINT_BASE, 9.5, 2, sh);
    draw_ch_note(c, kit, cl, v, x, right, t + CHV_CARD_NOTE_BASE, sh);
}

/// The history of the chat on screen (a friend's or a group's): the items chv_layout or gv_layout left, clipped to the
/// area between the header and the field; a group's incoming bubble is headed by its sender's name (GV_I_NAME).
fn draw_ch_history(c: u64, kit: [48]u64, l: f64, t: f64, h: f64, v: []const u8) -> void {
    const x : f64 = l + QP_PAD;
    // the history: the items chv_layout left, clipped to the area between the header and the field
    const ht : f64 = chv_hist_top(t);
    const hh : f64 = chv_hist_h(h);
    cg_save(c);
    cg_clip_rect(c, l + 1.0, ht, QP_W - 1.0, hh);
    const ni : usize = chv_nitems(v);
    var k : usize = 0;
    while (k < ni) {
        const kind : u32 = chv_item_kind(v, k);
        const ix : f64 = x + chv_item_x(v, k);
        const iy : f64 = ht + chv_item_y(v, k);
        const iw : f64 = chv_item_w(v, k);
        const out : bool = chv_item_dir(v, k) == CH_DIR_OUT;
        const o : usize = chv_item_text(k);
        const len : usize = chv_item_len(v, k);
        if (kind == CHV_I_BUBBLE) {
            round_rect(c, ix, iy, iw, chv_item_h(v, k), 8.0);
            if (out) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.16);
                cg_fill_path(c);
            } else {
                cg_line_width(c, 1.0);
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
                cg_stroke_path(c);
            }
        } else if (kind == CHV_I_LINE) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_fit(c, kit, v[o .. o + len], len, ix, iy + 11.0, CHV_FONT, 0.0, false, ix + iw + 4.0);
        } else if (kind == GV_I_NAME) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            draw_fit(c, kit, v[o .. o + len], len, ix, iy + 9.0, CHV_META_FONT, WEIGHT_SEMIBOLD, false, ix + iw + 4.0);
        } else if (kind == CHV_I_META) {
            const st : u32 = chv_item_state(v, k);
            var ink : f64 = lv(kit, THV_MUTED_WHITE);
            if (out and (st == CH_S_READ or st == CH_S_FAILED)) { ink = lv(kit, THV_TEXT_WHITE); }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
            var mx0 : f64 = ix;
            if (out) { mx0 = ix + iw - bytes_w(kit, v[o .. o + len], len, CHV_META_FONT, 0.0, false); }
            draw_bytes(c, kit, v[o .. o + len], len, mx0, iy + 9.0, CHV_META_FONT, 0.0, false);
        }
        k = k + 1;
    }
    cg_restore(c);
}

/// The chat's field (the end of a long text, a caret while typing) and SEND.
fn draw_ch_field(c: u64, kit: [48]u64, l: f64, t: f64, h: f64, v: []const u8, hit: u32) -> void {
    const fx : f64 = chv_field_x(l);
    const fy : f64 = chv_field_y(t, h);
    const fw : f64 = chv_field_w(QP_W);
    const focus : bool = v[CHV_FOCUS] != 0;
    round_rect(c, fx, fy, fw, CHV_FIELD_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (focus) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    if (focus == false and hit == CHV_H_FIELD) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    cg_stroke_path(c);
    const tl : usize = chv_tlen(v);
    if (tl == 0 and focus == false) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "Write a message", 15, fx + 8.0, fy + 17.0, CHV_FONT, 0.0, false);
    } else {
        const at : usize = chv_tail_at(v[CHV_TYPED .. CHV_TYPED + tl], tl, fw - 24.0, CHV_FONT);
        var tb : [2008]u8 = undefined;
        var q : usize = 0;
        while (at + q < tl) {
            tb[q] = v[CHV_TYPED + at + q];
            q = q + 1;
        }
        if (focus) {
            tb[q] = 95;
            q = q + 1;
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, tb[0..2008], q, fx + 8.0, fy + 17.0, CHV_FONT, 0.0, false, fx + fw - 6.0);
    }
    draw_cl_btn(c, kit, chv_send_x(l, QP_W), fy, CHV_SEND_W, "SEND", l + QP_W, hit == CHV_H_SEND);
}

fn draw_ch_chat(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, v: []const u8) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const h : f64 = sh - t;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const hit : u32 = chv_chat_hit(mx, my, l, QP_W, t, h);
    var line : [96]u8 = undefined;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    // the header: back, the friend's nickname and state, CALL and VIDEO, the panel's close mark
    draw_ac_btn_small(c, kit, chv_back_x(l), t + CHV_BACK_Y, CHV_BACK_W, "<", hit == CHV_H_BACK);
    const nl : usize = @as(usize, v[CHV_NICKLEN]);
    const nx : f64 = chv_hdr_nick_x(l);
    if (nl > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, v[CHV_NICK .. CHV_NICK + 32], nl, nx, t + CHV_HDR_NICK_BASE, 11.5, WEIGHT_SEMIBOLD, false, chv_hdr_call_x(l, QP_W) - 6.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, "(no name yet)", 13, nx, t + CHV_HDR_NICK_BASE, 11.5, 0.0, false, chv_hdr_call_x(l, QP_W) - 6.0);
    }
    const online : bool = v[CHV_ONLINE] != 0;
    var n : usize = chv_status_put(line[0..96], online, fv_get32(v, CHV_AGO), 0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
    draw_fit(c, kit, line[0..96], n, nx, t + CHV_HDR_STATE_BASE, 9.0, 0.0, false, chv_hdr_call_x(l, QP_W) - 6.0);
    draw_ac_btn_small(c, kit, chv_hdr_call_x(l, QP_W), t + CHV_BACK_Y, CHV_CHIP_W, "CALL", hit == CHV_H_CALL);
    draw_ac_btn_small(c, kit, chv_hdr_video_x(l, QP_W), t + CHV_BACK_Y, CHV_CHIP_W, "VIDEO", hit == CHV_H_VIDEO);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    draw_ch_history(c, kit, l, t, h, v);
    const ht : f64 = chv_hist_top(t);
    const hh : f64 = chv_hist_h(h);
    if (fv_get32(v, CHV_COUNT) == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_cl_wrap(c, kit, chv_empty_text(0), x, right, ht + 0.5 * hh, 10.0, 2, sh);
    }
    if (fv_get32(v, CHV_SCROLL) > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_bytes(c, kit, "newer below", 11, right - 52.0, ht + hh - 4.0, 8.5, 0.0, false);
    }
    draw_ch_field(c, kit, l, t, h, v, hit);
    // the note line: a chat note, else how many of the own lines wait for the friend
    const vc : u32 = @as(u32, v[CHV_NOTE]);
    if (vc != 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_fit(c, kit, chv_note_text(vc), chv_note_text(vc).len, x, chv_note_base(t, h), 9.0, 0.0, false, right);
    } else {
        n = chv_wait_put(line[0..96], online, @as(u32, @intCast(fv_get32(v, CHV_PENDING))));
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_fit(c, kit, line[0..96], n, x, chv_note_base(t, h), 9.0, 0.0, false, right);
    }
}

// ======================================================================================================
// GR. GROUPS IN THE CABINET (owner, 2026-10-23; Refs gHashTag/t27#11560). group_view.t27 decides (the GROUPS part, NEW
// GROUP, the group's chat in the chat_view region, the states, the unread badges); group_core.t27 and chat_host.t27
// keep the table, the logs and the fan-out. This block owns:
//   - the groups table: the GV region's copy of ~/.t27os/groups.t27, read at launch, written whole after CREATE;
//   - the open group (one at a time, chat_host grm_*): its block, its log and the log's assembly in one buffer of main
//     (gx: GX_GRM | GX_ASM | GX_LOG). Its group payloads ride every message session the window runs (chm_tick_g); the
//     first group is open from launch, so its lines are taken even before the person opens it;
//   - the fan-out: the window runs one message session at a time, so a line owed to several members goes to them one
//     after the other: while no friend's chat is on screen and the friend log open owes nothing, the next member who
//     is owed a line and is online gets its log opened (ch_open_log), and chm_tick_g dials it and sends;
//   - opening the group's chat reads its lines here (the badge goes); no READ goes out: group_core has no READ frame;
//   - T27OS_GROUP=chat or =new (a test aid, off by default): the first group's chat, or NEW GROUP, once the cabinet is
//     open; T27OS_CHAT_SAY types into the group's chat as it does into a friend's.
// ======================================================================================================
pub const GX_GRM : usize = 0;
pub const GX_ASM : usize = 256;
pub const GX_LOG : usize = 8320;
pub const GX_LEN : usize = 1024360;

/// A u64 slot of the groups' region (little endian).
fn gw_get64(b: []const u8, at: usize) -> u64 {
    var v : u64 = 0;
    var i : usize = 8;
    while (i > 0) {
        i = i - 1;
        v = v * 256 + @as(u64, b[at + i]);
    }
    return v;
}

fn gw_put64(b: []u8, at: usize, v: u64) -> void {
    var x : u64 = v;
    var i : usize = 0;
    while (i < 8) {
        b[at + i] = @as(u8, @intCast(x % 256));
        x = x / 256;
        i = i + 1;
    }
}

/// A group is open: the region and the buffer are whole and a group was read into them.
pub fn gw_active(gv: []const u8, gx: []const u8) -> bool { return gv.len >= GV_CAP and gx.len >= GX_LEN and gv[GV_G_ON] != 0; }

/// The table index of the open group.
fn gw_gi(gv: []const u8) -> usize { return @as(usize, gv[GV_G_ON]) - 1; }

/// The open group's log is written when it changed (at once or after its delay).
fn gw_flush(gv: []u8, gx: []const u8, buf: []u8) -> bool {
    if (gw_active(gv, gx) == false or gw_get64(gv, GV_G_SAVE_AT) == 0) { return true; }
    gw_put64(gv, GV_G_SAVE_AT, 0);
    return chh_save_group(gx[GX_LOG..GX_LEN], buf);
}

/// Group gi becomes the open one (the one before it is written first): its block and its log read. False when the
/// group is not in the table, this device is not in it, or its log cannot be read.
pub fn gw_load(cl: []const u8, gv: []u8, gx: []u8, buf: []u8, gi: usize) -> bool {
    if (gv.len < GV_CAP or gx.len < GX_LEN or gi >= gv_count(gv)) { return false; }
    if (@as(usize, gv[GV_G_ON]) == gi + 1) { return true; }
    gw_flush(gv, gx, buf);
    gv[GV_G_ON] = 0;
    if (grm_init(gx[GX_GRM..GX_ASM], gv[GV_T..GV_T_END], gt_id(gv[GV_T..GV_T_END], gi), cl[FE_FP .. FE_FP + 10]) == false) { return false; }
    if ((grm_load(gx[GX_GRM..GX_ASM], gv[GV_T..GV_T_END], cl[FE_FT .. FE_FT + FT_LEN], gx[GX_LOG..GX_LEN], CL_KEEP, buf) & 255) == CHH_IOERR) { return false; }
    gv[GV_G_ON] = @as(u8, @intCast(gi + 1));
    gv_unr_set(gv, gi, cl_unread(gx[GX_LOG..GX_LEN]));
    fv_put32(gv, GV_G_HH, 0);
    return true;
}

/// Launch, after ch_boot: the table, the unread count of every group from its log on disk (one after the other in the
/// open group's log), then the first group open. The test aid T27OS_GROUP.
pub fn gw_boot(cl: []const u8, gv: []u8, gx: []u8, buf: []u8) -> void {
    var i : usize = 0;
    while (i < GV_T) {
        gv[i] = 0;
        i = i + 1;
    }
    i = GV_INFO;
    while (i < GV_INFO_END) {
        gv[i] = 0;
        i = i + 1;
    }
    ghh_open(gv[GV_T..GV_T_END]);
    var e : [8]u8 = undefined;
    const en : usize = cl_env("T27OS_GROUP", e[0..8]);
    if (en == 4 and e[0] == 99 and e[1] == 104 and e[2] == 97 and e[3] == 116) { gv[GV_G_AID] = 2; }
    if (en == 3 and e[0] == 110 and e[1] == 101 and e[2] == 119) { gv[GV_G_AID] = 1; }
    if (en == 4 and e[0] == 109 and e[1] == 97 and e[2] == 107 and e[3] == 101) { gv[GV_G_AID] = 3; }
    const n : usize = gv_count(gv);
    i = 0;
    while (i < n) {
        if (chh_load_group(gt_id(gv[GV_T..GV_T_END], i), gx[GX_LOG..GX_LEN], CL_KEEP, buf) == CHH_LOADED) { gv_unr_set(gv, i, cl_unread(gx[GX_LOG..GX_LEN])); }
        i = i + 1;
    }
    if (n > 0) { gw_load(cl, gv, gx, buf, 0); }
}

/// A group's row: its chat, its lines read here (written soon), the badge gone.
pub fn gw_open_chat(cl: []const u8, v: []u8, gv: []u8, gx: []u8, buf: []u8, gi: usize, now: u64) -> void {
    if (gi >= gv_count(gv)) { return; }
    gv_chat_open(v, gt_id(gv[GV_T..GV_T_END], gi), gt_name(gv[GV_T..GV_T_END], gi));
    gv[GV_NOTE] = 0;
    if (gw_load(cl, gv, gx, buf, gi) == false) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE));
        return;
    }
    if (gv_read_all(gv, gi, gx[GX_LOG..GX_LEN])) { gw_put64(gv, GV_G_SAVE_AT, now + CH_SAVE_MS); }
    if (v[CHV_UP] == 0) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_OFF)); }
}

/// The members of the open group that can be sent to now: friends in view with an address (by member index).
pub fn gw_online(cl: []const u8, gv: []const u8) -> u32 {
    const gi : usize = gw_gi(gv);
    const n : usize = gt_n(gv[GV_T..GV_T_END], gi);
    var m : u32 = 0;
    var k : usize = 0;
    while (k < n) {
        if (ch_friend_addr(cl, gt_member(gv[GV_T..GV_T_END], gi, k)) != 0) { m = m | (@as(u32, 1) << @as(u32, @intCast(k))); }
        k = k + 1;
    }
    return m;
}

/// Return or SEND in the group's chat: the text into the group's log as PENDING for every member who is a friend
/// (written at once); the fan-out takes it to them.
pub fn gw_send(cl: []const u8, v: []u8, gv: []u8, gx: []u8, now: u64) -> void {
    if (gv_chat_shown(v) == false or gw_active(gv, gx) == false) { return; }
    if (v[CHV_UP] == 0) {
        v[CHV_NOTE] = @as(u8, @intCast(CHV_N_OFF));
        return;
    }
    var t : [2000]u8 = undefined;
    const n : usize = chv_take(v, t[0..2000]);
    if (n == 0) { return; }
    if (grm_send(gx[GX_GRM..GX_ASM], gv[GV_T..GV_T_END], cl[FE_FT .. FE_FT + FT_LEN], gx[GX_LOG..GX_LEN], t[0..n], now, gw_online(cl, gv)) == 0) {
        gv[GV_NOTE] = @as(u8, @intCast(GV_N_NOBODY));
        return;
    }
    gv[GV_NOTE] = 0;
    gw_put64(gv, GV_G_SAVE_AT, now);
    v[CHV_DIRTY] = 1;
}

/// One hit in the group's chat: back (the log written when it changed), the field, SEND.
pub fn gw_chat_do(cl: []const u8, v: []u8, gv: []u8, gx: []u8, buf: []u8, hit: u32) -> void {
    if (hit == CHV_H_BACK) {
        if (gw_flush(gv, gx, buf) == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
        gv_chat_back(v);
        gv[GV_NOTE] = 0;
    } else if (hit == CHV_H_FIELD or hit == CHV_H_HIST) {
        v[CHV_FOCUS] = 1;
    } else if (hit == CHV_H_SEND) {
        v[CHV_FOCUS] = 1;
        gw_send(cl, v, gv, gx, ckh_ms());
    }
}

/// CREATE: the ticked friends and this device as a group (chat_host ghh_make), the table written; the group stands
/// in the list at once. The GV_N_* note, GV_N_NONE when it was made.
pub fn gw_create(cl: []const u8, gv: []u8, now: u64) -> u32 {
    var why : u32 = gv_create_why(gv_picks(gv), gv_name_of(gv));
    if (why == GV_N_NONE and bk_have_id(cl) == false) { why = GV_N_NOKEY; }
    if (why != GV_N_NONE) {
        gv[GV_NOTE] = @as(u8, @intCast(why));
        return why;
    }
    var fps : [80]u8 = undefined;
    const k : usize = gv_picked_fps(gv, cl[FE_FT .. FE_FT + FT_LEN], fps[0..80]);
    var nm : [32]u8 = undefined;
    const nl : usize = @as(usize, gv[GV_NLEN]);
    var i : usize = 0;
    while (i < nl) {
        nm[i] = gv[GV_NAME + i];
        i = i + 1;
    }
    var id : [8]u8 = undefined;
    const r : u32 = ghh_make(gv[GV_T..GV_T_END], cl[FE_FT .. FE_FT + FT_LEN], cl[FE_FP .. FE_FP + 10], fps[0..80], k, nm[0..nl], now, id[0..8]);
    if (r != GR_OK) {
        why = GV_N_BAD;
        if (r == (GHH_TABLE | (GT_DUP << 8))) { why = GV_N_DUP; }
        if (r == (GHH_TABLE | (GT_FULL << 8))) { why = GV_N_TABLE; }
        gv[GV_NOTE] = @as(u8, @intCast(why));
        return why;
    }
    gv_new_close(gv);
    gv[GV_NOTE] = 0;
    if (ghh_save(gv[GV_T..GV_T_END]) == false) { gv[GV_NOTE] = @as(u8, @intCast(GV_N_NOSAVE)); }
    // every other member is owed the group's ANNOUNCE (GROUP_INFO) until it answers; gw_rotate dials it
    const ngi : usize = gt_find(gv[GV_T..GV_T_END], id[0..8]);
    if (ngi < GV_INFO_END - GV_INFO) { gv[GV_INFO + ngi] = @as(u8, @intCast(gi_owe_new(gv[GV_T..GV_T_END], ngi, cl[FE_FP .. FE_FP + 10]))); }
    // the new group comes into view at the end of the list
    fv_put32(gv, GV_GSCROLL, 255);
    return gv[GV_NOTE];
}

/// A GROUP_INFO put a group into the table (chat_host CHM_E_GINFO): groups.t27 is written, the group stands in the
/// list at once, and it becomes the open one when none is (so its lines are taken from now on).
pub fn gw_learned(cl: []const u8, v: []u8, gv: []u8, gx: []u8, buf: []u8) -> void {
    if (gv.len < GV_CAP) { return; }
    if (ghh_save(gv[GV_T..GV_T_END]) == false) { gv[GV_NOTE] = @as(u8, @intCast(GV_N_NOSAVE)); }
    const n : usize = gv_count(gv);
    if (n > 0 and gw_active(gv, gx) == false) { gw_load(cl, gv, gx, buf, n - 1); }
    fv_put32(gv, GV_GSCROLL, 255);
    v[CHV_DIRTY] = 1;
}

/// The test aid T27OS_GROUP=make: NEW GROUP with the first friend ticked and the name "test", CREATE, then that
/// group's chat (a group of two).
fn gw_make_aid(cl: []const u8, v: []u8, gv: []u8, gx: []u8, buf: []u8, now: u64) -> void {
    gv_new_open(gv);
    gv_pick_toggle(gv, 0, @as(usize, ft_count(cl[FE_FT .. FE_FT + FT_LEN])));
    gv_name_paste(gv, "test", 4);
    const r : u32 = gw_create(cl, gv, now);
    // run again with the group already made: its chat (the first group)
    if (r == GV_N_DUP) {
        gv_new_close(gv);
        gw_open_chat(cl, v, gv, gx, buf, 0, now);
        return;
    }
    if (r != GV_N_NONE and r != GV_N_NOSAVE) { return; }
    gw_open_chat(cl, v, gv, gx, buf, gv_count(gv) - 1, now);
}

/// One hit in NEW GROUP. h is the panel's height.
pub fn gw_new_do(cl: []const u8, gv: []u8, hit: u32, h: f64) -> void {
    const nf : usize = @as(usize, ft_count(cl[FE_FT .. FE_FT + FT_LEN]));
    const rows : usize = gv_pick_rows(h);
    var sc : usize = @as(usize, fv_get32(gv, GV_SSCROLL));
    gv[GV_FOCUS] = 0;
    if (hit == GV_S_BACK) {
        gv_new_close(gv);
        gv[GV_NOTE] = 0;
    } else if (hit == GV_S_NAME) {
        gv[GV_FOCUS] = 1;
    } else if (hit == GV_S_CREATE) {
        gw_create(cl, gv, ckh_ms());
    } else if (hit == GV_S_UP or hit == GV_S_DOWN) {
        fv_put32(gv, GV_SSCROLL, @as(u64, gv_scroll(sc, hit == GV_S_UP, nf, rows)));
    } else if (hit >= GV_S_PICK) {
        gv_pick_toggle(gv, sc + @as(usize, hit - GV_S_PICK), nf);
    }
}

/// The GROUPS part's rows now (group_view gv_rows), for a panel of height h whose friends part moved dy.
pub fn gw_rows(cl: []const u8, gv: []const u8, h: f64, dy: f64) -> usize { return gv_rows(gv_count(gv), @as(usize, cl[FV_COUNT]), h, dy); }

/// The first group in view, kept inside the list.
fn gw_gscroll(gv: []const u8, rows: usize) -> usize {
    const n : usize = gv_count(gv);
    var sc : usize = @as(usize, fv_get32(gv, GV_GSCROLL));
    if (n <= rows) { return 0; }
    if (sc > n - rows) { sc = n - rows; }
    return sc;
}

/// One hit in the GROUPS part: "+" opens NEW GROUP, a row the group's chat, the arrows move the list.
pub fn gw_part_do(cl: []u8, v: []u8, gv: []u8, gx: []u8, buf: []u8, hit: u32, rows: usize) -> void {
    cl[CL_FOCUS] = 0;
    const n : usize = gv_count(gv);
    const sc : usize = gw_gscroll(gv, rows);
    if (hit == GV_H_PLUS) {
        gv_new_open(gv);
    } else if (hit == GV_H_UP or hit == GV_H_DOWN) {
        fv_put32(gv, GV_GSCROLL, @as(u64, gv_scroll(sc, hit == GV_H_UP, n, rows)));
    } else if (hit >= GV_H_ROW and hit < GV_H_END) {
        const gi : usize = gv_row_group(sc, @as(usize, hit - GV_H_ROW), n);
        if (gi < n) { gw_open_chat(cl, v, gv, gx, buf, gi, ckh_ms()); }
    }
}

/// The fan-out: with no friend's chat on screen, the session idle and the friend log open owing nothing, the next
/// member who is owed a line of the open group and is online gets its log opened; chm_tick_g dials it next pass.
pub fn gw_rotate(cl: []const u8, v: []u8, s: []u8, m: []u8, log: []u8, buf: []u8, w: []u64, gv: []u8, gx: []u8) -> void {
    if (gv.len < GV_CAP or cs_state(s) != CK_IDLE) { return; }
    if (chv_mode(v) == CHV_M_CHAT or chv_mode(v) == CHV_M_CARD) { return; }
    if (w[CHW_LOADED] != 0 and cl_pending(log) > 0) { return; }
    const t : []const u8 = gv[GV_T..GV_T_END];
    if (gw_active(gv, gx)) {
        const gi : usize = gw_gi(gv);
        const n : usize = gt_n(t, gi);
        const me : u32 = gt_idx(t, gi, cl[FE_FP .. FE_FP + 10]);
        var j : usize = 0;
        while (j < n) {
            const k : usize = (@as(usize, gv[GV_G_NEXT]) + j) % n;
            const kk : u32 = @as(u32, @intCast(k));
            const fp : []const u8 = gt_member(t, gi, k);
            if (kk != me and gl_pending_for(gx[GX_LOG..GX_LEN], kk) > 0 and ch_friend_addr(cl, fp) != 0) {
                if (w[CHW_LOADED] != 0 and ch_log_is(log, fp)) { return; }
                ch_open_log(cl, v, s, m, log, buf, w, fp);
                gv[GV_G_NEXT] = @as(u8, @intCast((k + 1) % n));
                return;
            }
            j = j + 1;
        }
    }
    // the ANNOUNCEs still owed: the next member of a group made here that has not answered and is online
    if (w[CHW_LOADED] != 0 and ghm_owed(m, t, gv[GV_INFO..GV_INFO_END], cl[FE_FP .. FE_FP + 10]) > 0) { return; }
    var g : usize = 0;
    while (g < gv_count(gv) and g < GV_INFO_END - GV_INFO) {
        const owe : u32 = @as(u32, gv[GV_INFO + g]);
        var k : usize = 0;
        while (owe != 0 and k < gt_n(t, g)) {
            const fp : []const u8 = gt_member(t, g, k);
            if (((owe >> @as(u32, @intCast(k))) & 1) != 0 and ch_friend_addr(cl, fp) != 0) {
                if (w[CHW_LOADED] != 0 and ch_log_is(log, fp)) { return; }
                ch_open_log(cl, v, s, m, log, buf, w, fp);
                return;
            }
            k = k + 1;
        }
        g = g + 1;
    }
}

/// The open group's part of a pass: the events of chm_tick_g (a line in, a state changed), the save, the history.
pub fn gw_tick(cl: []const u8, v: []u8, gv: []u8, gx: []u8, buf: []u8, ev: u32, tz: u64, h: f64, now: u64) -> void {
    if (gw_active(gv, gx) == false) { return; }
    const gi : usize = gw_gi(gv);
    const glog : []u8 = gx[GX_LOG..GX_LEN];
    const shown : bool = gv_chat_shown(v);
    if ((ev & CHM_E_GNEW) != 0 and shown) {
        if (cl_open_read(glog) != 0 and gw_get64(gv, GV_G_SAVE_AT) == 0) { gw_put64(gv, GV_G_SAVE_AT, now + CH_SAVE_MS); }
    }
    if ((ev & (CHM_E_GNEW | CHM_E_GSTATUS | CHM_E_GDIRTY)) != 0) { v[CHV_DIRTY] = 1; }
    if ((ev & CHM_E_GDIRTY) != 0 and gw_get64(gv, GV_G_SAVE_AT) == 0) { gw_put64(gv, GV_G_SAVE_AT, now + CH_SAVE_MS); }
    gv_unr_set(gv, gi, cl_unread(glog));
    const at : u64 = gw_get64(gv, GV_G_SAVE_AT);
    if (at != 0 and now >= at) {
        if (gw_flush(gv, gx, buf) == false) { v[CHV_NOTE] = @as(u8, @intCast(CHV_N_NOSAVE)); }
    }
    if (shown) {
        const hh : f64 = chv_hist_h(h);
        const hu : u64 = @as(u64, @intFromFloat(hh));
        if (v[CHV_DIRTY] != 0 or hu != fv_get32(gv, GV_G_HH) or now >= gw_get64(gv, GV_G_LAYOUT_AT) + CH_RELAYOUT_MS) {
            const t : []const u8 = gv[GV_T..GV_T_END];
            const me : u32 = gt_idx(t, gi, cl[FE_FP .. FE_FP + 10]);
            var names : [200]u8 = undefined;
            gv_names(t, gi, cl[FE_FT .. FE_FT + FT_LEN], me, names[0..GV_NAMES]);
            gv_layout(v, glog, now, tz, QP_W, hh, names[0..GV_NAMES], me, gt_n(t, gi));
            gw_put64(gv, GV_G_LAYOUT_AT, now);
            fv_put32(gv, GV_G_HH, hu);
        }
    }
}

/// The frame key's part of the groups: the folded head and the table's CRC (a group made or a name changed redraws).
pub fn gw_key(gv: []const u8) -> u64 {
    var k : u64 = @as(u64, crc32(gv[GV_T..GV_T_END], GT_LEN));
    var i : usize = 0;
    while (i < GV_KEY_END) {
        k = k * 31 + @as(u64, gv[i]);
        k = k % 1099511627776;
        i = i + 1;
    }
    return k;
}

/// The GROUPS part of the cabinet: the label, the arrows for a long list, "+", a row a group (its name, how many
/// people, the unread badge), or the line that says how to make one.
fn draw_gv_part(c: u64, kit: [48]u64, l: f64, t: f64, h: f64, cl: []const u8, gv: []const u8, rows: usize, hit: u32) -> void {
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const n : usize = gv_count(gv);
    const sc : usize = gw_gscroll(gv, rows);
    var line : [64]u8 = undefined;
    var k0 : usize = gv_label(n, line[0..64]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..64], k0, x, gv_label_y(t, h, rows), 9.5, 0.0, false, gv_up_x(l, QP_W) - 6.0);
    if (n > rows) {
        draw_ac_arrow(c, kit, gv_up_x(l, QP_W), gv_plus_y(t, h, rows), true, sc > 0, hit == GV_H_UP);
        draw_ac_arrow(c, kit, gv_down_x(l, QP_W), gv_plus_y(t, h, rows), false, sc + rows < n, hit == GV_H_DOWN);
    }
    draw_ac_btn_h(c, kit, gv_plus_x(l, QP_W), gv_plus_y(t, h, rows), GV_PLUS_W, GV_PLUS_H, "+", false, hit == GV_H_PLUS);
    if (n == 0) {
        const et : []const u8 = gv_empty_row_text();
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, et, et.len, x, gv_row_y(t, h, rows, 0) + 14.0, 9.5, 0.0, false, right);
        return;
    }
    var k : usize = 0;
    while (k < rows) {
        const gi : usize = gv_row_group(sc, k, n);
        if (gi < n) {
            const ry : f64 = gv_row_y(t, h, rows, k);
            if (hit == GV_H_ROW + @as(u32, @intCast(k))) {
                round_rect(c, x - 4.0, ry, right - x + 8.0, GV_ROW_H - 2.0, 5.0);
                cg_line_width(c, 1.0);
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
                cg_stroke_path(c);
            }
            const unr : u32 = gv_unr_get(gv, gi);
            var pr : f64 = right;
            if (unr > 0) {
                draw_ch_badge(c, kit, right, ry + 10.0, unr);
                pr = right - 30.0;
            }
            const pn : usize = gv_people(gt_n(gv[GV_T..GV_T_END], gi), line[0..64]);
            const pw : f64 = bytes_w(kit, line[0..64], pn, 9.0, 0.0, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
            draw_bytes(c, kit, line[0..64], pn, pr - pw, ry + 14.0, 9.0, 0.0, false);
            const nm : []const u8 = gt_name(gv[GV_T..GV_T_END], gi);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            draw_ac_fit(c, kit, nm, nm.len, x, ry + 14.0, 11.0, WEIGHT_SEMIBOLD, false, pr - pw - 8.0);
        }
        k = k + 1;
    }
}

/// The head's count of unread group lines, at hx; the x where the next thing may start.
fn draw_gv_head(c: u64, kit: [48]u64, hx: f64, t: f64, gv: []const u8) -> f64 {
    var hb : [32]u8 = undefined;
    const hn : usize = gv_head_text(gv_unr_total(gv), hb[0..32]);
    if (hn == 0) { return hx; }
    const hw : f64 = bytes_w(kit, hb[0..32], hn, 8.5, WEIGHT_SEMIBOLD, false) + 12.0;
    round_rect(c, hx, t + 13.0, hw, 15.0, 7.5);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    cg_fill_path(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.85);
    draw_bytes(c, kit, hb[0..32], hn, hx + 6.0, t + 24.0, 8.5, WEIGHT_SEMIBOLD, false);
    return hx + hw + 6.0;
}

/// NEW GROUP: back, the title, the name, the friends with a box each (ticked or not), CREATE (muted with its reason
/// while it cannot be pressed), the note.
fn draw_gv_new(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, cl: []const u8, gv: []const u8) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const h : f64 = sh - t;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const ft : []const u8 = cl[FE_FT .. FE_FT + FT_LEN];
    const nf : usize = @as(usize, ft_count(ft));
    const rows : usize = gv_pick_rows(h);
    var sc : usize = @as(usize, fv_get32(gv, GV_SSCROLL));
    if (nf <= rows) { sc = 0; } else if (sc > nf - rows) { sc = nf - rows; }
    const hit : u32 = gv_new_hit(mx, my, l, QP_W, t, h, nf, sc);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    draw_ac_btn_small(c, kit, chv_back_x(l), t + CHV_BACK_Y, CHV_BACK_W, "<", hit == GV_S_BACK);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "NEW GROUP", 9, x + CHV_BACK_W + 8.0, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "NAME", 4, x, t + GV_NAME_LABEL_Y, 9.5, 0.0, false);
    draw_cl_field(c, kit, x, t + GV_NAME_Y, QP_W - 2.0 * QP_PAD, gv[GV_FOCUS] != 0, hit == GV_S_NAME, gv[GV_NAME .. GV_NAME + GR_NAME_MAX], @as(usize, gv[GV_NLEN]), "family, work, trip");
    var line : [64]u8 = undefined;
    const picks : u32 = gv_picks(gv);
    var n : usize = gv_pick_label(picks, line[0..64]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, line[0..64], n, x, t + GV_PICK_LABEL_Y, 9.5, 0.0, false, gv_sup_x(l, QP_W) - 6.0);
    if (nf > rows) {
        draw_ac_arrow(c, kit, gv_sup_x(l, QP_W), gv_sarrow_y(t), true, sc > 0, hit == GV_S_UP);
        draw_ac_arrow(c, kit, gv_sdown_x(l, QP_W), gv_sarrow_y(t), false, sc + rows < nf, hit == GV_S_DOWN);
    }
    if (nf == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_cl_wrap(c, kit, "No friends yet: add one by key in the cabinet first.", x, right, gv_pick_y(t, 0) + 14.0, 9.5, 2, sh);
    }
    var k : usize = 0;
    while (k < rows and sc + k < nf) {
        const i : usize = sc + k;
        const ry : f64 = gv_pick_y(t, k);
        const on : bool = gv_picked(gv, i);
        if (hit == GV_S_PICK + @as(u32, @intCast(k))) {
            round_rect(c, x - 4.0, ry, right - x + 8.0, GV_PICK_H - 2.0, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            cg_stroke_path(c);
        }
        // the box: an outline, filled with a dark check mark when ticked
        round_rect(c, x, ry + 5.0, GV_BOX, GV_BOX, 3.0);
        if (on) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            cg_fill_path(c);
            cg_move(c, x + 2.5, ry + 11.0);
            cg_line(c, x + 5.0, ry + 13.5);
            cg_line(c, x + 9.5, ry + 8.0);
            cg_line_width(c, 1.6);
            cg_stroke_rgba(c, 0.0, 0.0, 0.0, 0.9);
            cg_stroke_path(c);
        } else {
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            cg_stroke_path(c);
        }
        var fpb : [16]u8 = undefined;
        const fpn : usize = fv_short_fp(ft[FT_HDR + i * FT_ROW .. FT_HDR + i * FT_ROW + 10], fpb[0..16]);
        const fpw : f64 = bytes_w(kit, fpb[0..16], fpn, 9.0, 0.0, true);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, fpb[0..16], fpn, right - fpw, ry + 15.0, 9.0, 0.0, true);
        var nb : [32]u8 = undefined;
        const nn : usize = gv_ft_name(ft, i, nb[0..32]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_ac_fit(c, kit, nb[0..32], nn, x + GV_BOX + 8.0, ry + 15.0, 11.0, WEIGHT_SEMIBOLD, false, right - fpw - 8.0);
        k = k + 1;
    }
    // CREATE, muted while it cannot be pressed; under it the reason, or the note of the last try
    const cx : f64 = gv_create_x(l, QP_W);
    const cy : f64 = gv_create_y(t, h);
    const why : u32 = gv_create_why(picks, gv_name_of(gv));
    if (why == GV_N_NONE) { draw_cl_btn(c, kit, cx, cy, GV_CREATE_W, "CREATE", sw, hit == GV_S_CREATE); } else { draw_ch_btn_off(c, kit, cx, cy, GV_CREATE_W, "CREATE", sw); }
    var note : u32 = @as(u32, gv[GV_NOTE]);
    if (note == GV_N_NONE) { note = why; }
    const nt : []const u8 = gv_note_text(note);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_cl_wrap(c, kit, nt, x, cx - 8.0, gv_hint_y(t, h), 9.0, 2, sh);
}

/// The group's chat: back, the group's name and its people, the history (the senders' names over their lines), the
/// field and SEND, the note.
fn draw_gv_chat(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, cl: []const u8, v: []const u8, gv: []const u8) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const h : f64 = sh - t;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    const hit : u32 = gv_chat_hit(mx, my, l, QP_W, t, h);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    draw_ac_btn_small(c, kit, chv_back_x(l), t + CHV_BACK_Y, CHV_BACK_W, "<", hit == CHV_H_BACK);
    const nx : f64 = chv_hdr_nick_x(l);
    const nl : usize = @as(usize, v[CHV_NICKLEN]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_ac_fit(c, kit, v[CHV_NICK .. CHV_NICK + 32], nl, nx, t + CHV_HDR_NICK_BASE, 11.5, WEIGHT_SEMIBOLD, false, right - 22.0);
    if (gv.len >= GV_CAP and gv[GV_G_ON] != 0) {
        const gi : usize = @as(usize, gv[GV_G_ON]) - 1;
        const tt : []const u8 = gv[GV_T..GV_T_END];
        const me : u32 = gt_idx(tt, gi, cl[FE_FP .. FE_FP + 10]);
        var names : [200]u8 = undefined;
        gv_names(tt, gi, cl[FE_FT .. FE_FT + FT_LEN], me, names[0..GV_NAMES]);
        var rl : [160]u8 = undefined;
        const rn : usize = gv_roster_line(tt, gi, names[0..GV_NAMES], me, rl[0..160]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_ac_fit(c, kit, rl[0..160], rn, nx, t + CHV_HDR_STATE_BASE, 9.0, 0.0, false, right - 22.0);
    }
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    draw_ch_history(c, kit, l, t, h, v);
    const ht : f64 = chv_hist_top(t);
    const hh : f64 = chv_hist_h(h);
    if (fv_get32(v, CHV_COUNT) == 0) {
        const et : []const u8 = gv_chat_empty_text();
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_cl_wrap(c, kit, et, x, right, ht + 0.5 * hh, 10.0, 2, sh);
    }
    if (fv_get32(v, CHV_SCROLL) > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_bytes(c, kit, "newer below", 11, right - 52.0, ht + hh - 4.0, 8.5, 0.0, false);
    }
    draw_ch_field(c, kit, l, t, h, v, hit);
    const vc : u32 = @as(u32, v[CHV_NOTE]);
    var nt : []const u8 = "";
    if (vc != 0) { nt = chv_note_text(vc); } else if (gv.len >= GV_CAP and gv[GV_NOTE] != 0) { nt = gv_note_text(@as(u32, gv[GV_NOTE])); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_fit(c, kit, nt, nt.len, x, chv_note_base(t, h), 9.0, 0.0, false, right);
}

fn draw(c: u64, kit: [48]u64, frame: u32, state: u32, hov: u32, ma: f64, shown: u32, task: u32, space: u32, sp: u32, ss: u64, cur: u32, collapsed: bool, mx: f64, my: f64, z: f64, sw: f64, sh: f64, ws: u32, full: bool, qp: bool, ring: [8]u64, n: u32, now: u64, sug: u32, god: bool, glow: f64, dk: [128]u64, dp: bool, darmed: u32, doff: u32, dgo: u32, dlive: bool, dlabel: u64, tst: []const u32, tcells: []const u32, topen: u32, tcur: bool, kyp: bool, kstored: []const u32, kmask: []const u8, kmlen: []const u32, kst: []const u32, kfail: []const u32, kopen: []const u64, kedit: u32, kbuf: []const u8, klen: u32, karm: u32, kbusy: u32, kemask: u32, kewhy: u32, ktpick: u32, hs: u32, cons: bool, dc: []u64, gal: []const u8, gt: []const u32, evd: u32, evpk: u64, pb: []const u8, sst: []const u32, tg: []const u64, tb: []const u8) -> void {
    // evp, evn2 and evpr travel packed (the draw call is at the 64 parameter limit)
    const evp : u32 = @as(u32, @intCast(evpk % 1048576));
    const evn2 : u32 = @as(u32, @intCast(evpk / 1048576 % 1048576));
    const evpr : u32 = @as(u32, @intCast(evpk / 1099511627776));
    // P. the PROFILE panel is open while its flag byte in the text store says so
    const pfp : bool = tb[TBO_PF + PF_OPEN] != 0;
    // CL. the CALL panel, the same way
    const clp : bool = tb[TBO_CL + CL_OPEN] != 0;
    // RC. the QUEEN CHAT dock is shown while its flag in its own region says so (main writes rc_shown there:
    // the dock is open and no other right-hand panel is)
    const rc : bool = tb[TBO_RC + RC_FLAG] != 0;
    draw_backdrop(c, sw, sh, full);
    const ha : f64 = 1.0 - ma;
    if (ha > 0.0) {
        draw_logo(c, home_c(0, z, sw, sh), home_c(1, z, sw, sh), home_k(z, sw, sh), anim_off(frame) * 1000.0, state, hov, ha);
        orbit_draw(c, kit, tg, mx, my, sw, sh, full, ha);
        if (hov == PETAL_CENTRE) { draw_centre_tip(c, kit, ha, z, sw, sh); } else if (hov != PETAL_NONE) { draw_tooltip(c, kit, hov, ha, z, sw, sh); }
    }
    if (ma > 0.0) {
        // the screen of petal `shown`: the chat workspace for the CHAT petal (index 2), a home tab for t27a ..
        // t27u, an empty frame with the petal's name for every other petal
        if (shown == PETAL_CHAT and cons == false) {
            draw_chat(c, kit, shown, task, space, sp, ss, cur, ma, collapsed, mx, my, sw, sh, ws, dlabel, dp, full, topen != PANE_NONE, sst, tb);
            // the pane's grid: in the QUEEN CHAT dock when it is docked, else across the content
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE and rc_docked(rc, cur, session_agent(ss, cur)) == false) { draw_term(c, kit, tst, tcells, tcur, ma, collapsed, sw, sh, ws, full, qp or dp or kyp or pfp or clp, mx, my, tg); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE and sst[SST_SRV] != SRV_UP and rc_docked(rc, cur, session_agent(ss, cur)) == false) { draw_srv_banner(c, kit, sst[SST_SRV], content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp or pfp or clp), sh - WS_TOP - HEADER_H, mx, my, ma, full); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE) { draw_light_dot(c, sw - 124.0, WS_TOP + 0.5 * HEADER_H, dot_light(topen == VIEW_EDITOR, pane_light_input(topen)), ma); }
            draw_qc_switch(c, kit, sw, ma, mx, my);
            draw_switch(c, kit, "CONSOLE >", sw, ma, mx, my);
        } else {
            draw_home(c, kit, shown, ma, collapsed, mx, my, sw, sh, ws, hs, dlabel, dp, full, dc, gal, gt, pb, tg, tb);
        }
    }
    if (ma > 0.0 and shown == PETAL_CHAT and cons == false and sst[SST_QDASH] != 0 and ws != WS_COMPACT) {
        draw_qdash(c, kit, tg, sst, tb, qd_area_x(ws, collapsed), WS_TOP, qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp or clp), qd_area_h(sh), sw, mx, my, full, ma);
    }
    // exactly one right-hand panel is drawn (the Queen's, else DOCTOR's, else KEYS', else PROFILE, else CALL, else
    // the QUEEN CHAT dock -- rc is already false while any other is open): its ground first
    if (rc or qp or dp or kyp or pfp or clp) { draw_panel_ground(c, sw, sh); }
    if (rc) { draw_rc(c, kit, sw, sh, mx, my, full, ma, tst, tcells, tcur, topen, tb[TBO_RC .. TBO_RC + RC_CAP]); }
    if (qp) { draw_queen_panel(c, kit, sw, sh, mx, my, view_of(menu_open(state), shown), space, ss, cur, ring, n, now, sug, god, evd, evp, evn2, evpr); }
    if (dp and qp == false) { draw_doctor_panel(c, kit, dk, sw, sh, mx, my, darmed, doff, dgo, dlive); }
    if (kyp and qp == false and dp == false) { draw_keys_panel(c, kit, sw, sh, mx, my, kstored, kmask, kmlen, kst, kfail, kopen[0..9], now, kopen[KHL_AT .. KHL_AT + 144], kedit, kbuf, klen, karm, kbusy, kemask, kewhy, ktpick); }
    if (pfp and qp == false and dp == false and kyp == false) { draw_profile_panel(c, kit, sw, sh, mx, my, tb[TBO_PF .. TBO_PF + PF_CAP], tg[TPG_PF_IMG]); }
    if (clp and qp == false and dp == false and kyp == false and pfp == false) {
        if (ac_shown(tb[TBO_CL .. TBO_CL + CL_CAP])) {
            const chm0 : u32 = chv_mode(tb[TBO_CH .. TBO_CH + CHV_CAP]);
            if (chm0 == CHV_M_CARD) {
                draw_ch_card(c, kit, sw, sh, mx, my, tb[TBO_CL .. TBO_CL + CL_CAP], tb[TBO_CH .. TBO_CH + CHV_CAP], tb[TBO_TRU .. TBO_TRU + TRU_LEN]);
            } else if (chm0 == CHV_M_CHAT) {
                draw_ch_chat(c, kit, sw, sh, mx, my, tb[TBO_CH .. TBO_CH + CHV_CAP]);
            } else if (chm0 == GV_CHAT) {
                draw_gv_chat(c, kit, sw, sh, mx, my, tb[TBO_CL .. TBO_CL + CL_CAP], tb[TBO_CH .. TBO_CH + CHV_CAP], tb[TBO_GV .. TBO_GV + GV_CAP]);
            } else if (gv_new_shown(tb[TBO_GV .. TBO_GV + GV_CAP])) {
                draw_gv_new(c, kit, sw, sh, mx, my, tb[TBO_CL .. TBO_CL + CL_CAP], tb[TBO_GV .. TBO_GV + GV_CAP]);
            } else {
                draw_account_panel(c, kit, sw, sh, mx, my, tb[TBO_CL .. TBO_CL + CL_CAP], tb[TBO_PF .. TBO_PF + PF_CAP], tg[TPG_PF_IMG], tb[TBO_CH .. TBO_CH + CHV_CAP], kstored, kopen[KHL_AT .. KHL_AT + 144], kmask[544..640], kmask[640..808], now, tb[TBO_IV .. TBO_IV + IV_LEN], ckh_ms(), tb[TBO_BK .. TB_SIZE]);
            }
        } else {
            draw_call_panel(c, kit, sw, sh, mx, my, tb[TBO_CL .. TBO_CL + CL_CAP], tb[TBO_CH .. TBO_CH + CHV_CAP]);
        }
    }
    if (ma > 0.0) {
        var uws : u32 = ws;
        if (shown != PETAL_CHAT or cons) { uws = home_ws(ws); }
        draw_update_strip(c, kit, tg, mx, my, sh, uws, collapsed, ma);
        draw_update_toast(c, kit, tg, tg[TPG_NOW], sw, ma);
    }
    if (ma > 0.0) {
        draw_god_strip(c, kit, tg, sst, sw, sh, full, ma, god);
        draw_footer(c, kit, tg, sst, tb[TBO_CL .. TBO_CL + CL_CAP], mx, my, sw, sh, full, ma, kyp, dlabel, dp);
    }
    draw_titlebar(c, kit, sw, full, ma, tg, god, mx, my, tb[TBO_PF .. TBO_PF + PF_CAP], tb[TBO_CL .. TBO_CL + CL_CAP]);
    draw_edge_glow(c, sw, sh, glow, frame);
}

// ---- the DOCTOR host (doctor.t27): the handles it needs, made once, then the walk, the checks, the sums ----
// doctor.t27 decides; this block only lists folders, runs the command lines it names, reads their output and
// moves a confirmed folder to the Trash.

pub const NS_NOT_FOUND : u64 = 0x7fffffffffffffff;
pub const DK_SIZE : u32 = 128;
// columns, one entry per known repository, in discovery order
pub const DK_PATHS : u32 = 0;
pub const DK_FLAGS : u32 = 1;
pub const DK_KB : u32 = 2;
pub const DK_BUILD : u32 = 3;
pub const DK_REMOTE : u32 = 4;
pub const DK_BRANCH : u32 = 5;
pub const DK_MARK : u32 = 6;
// the walk queue
pub const DK_QUEUE : u32 = 7;
pub const DK_QDEPTH : u32 = 8;
pub const DK_QROOT : u32 = 9;
// sets and lists read from doctor.t27
pub const DK_SKIP : u32 = 10;
pub const DK_ALLOWED : u32 = 11;
pub const DK_AGENTS : u32 = 12;
pub const DK_JOBS : u32 = 13;
pub const DK_SLOTS : u32 = 14;
pub const DK_HIDDEN : u32 = 15;
pub const DK_ROWS : u32 = 16;
pub const DK_TASKS : u32 = 17;
pub const DK_TPATH : u32 = 18;
pub const DK_TJOB : u32 = 19;
pub const DK_OUTS : u32 = 20;
pub const DK_HOME : u32 = 21;
pub const DK_WORDS : u32 = 22;
pub const DK_FWORDS : u32 = 23;
pub const DK_KWORDS : u32 = 24;
pub const DK_NULL : u32 = 25;
pub const DK_EMPTY : u32 = 26;
pub const DK_FM : u32 = 27;
pub const DK_SEEDN : u32 = 28;
pub const DK_SEEDB : u32 = 29;
// strings
pub const DK_GIT : u32 = 30;
pub const DK_HEADF : u32 = 31;
pub const DK_WTS : u32 = 32;
pub const DK_DOT : u32 = 33;
pub const DK_SLASH : u32 = 34;
pub const DK_NL : u32 = 35;
pub const DK_MARKP : u32 = 36;
pub const DK_ARGSEP : u32 = 37;
pub const DK_STH : u32 = 38;
pub const DK_STHEAD : u32 = 39;
pub const DK_STSTASH : u32 = 40;
pub const DK_STEMRX : u32 = 41;
pub const DK_COMMA : u32 = 42;
pub const DK_SPACE : u32 = 43;
pub const DK_POINT : u32 = 44;
pub const DK_DEVNULL : u32 = 45;
pub const DK_WHITE : u32 = 46;
// classes
pub const DK_NUMBER : u32 = 47;
pub const DK_URL_CLS : u32 = 48;
pub const DK_STR_CLS : u32 = 49;
pub const DK_FH_CLS : u32 = 50;
pub const DK_TASK_CLS : u32 = 51;
pub const DK_DICT_CLS : u32 = 52;
pub const DK_CSET_CLS : u32 = 53;
// selectors
pub const DK_COUNT : u32 = 60;
pub const DK_AT : u32 = 61;
pub const DK_ADD : u32 = 62;
pub const DK_REMOVE_AT : u32 = 63;
pub const DK_REPLACE : u32 = 64;
pub const DK_INDEX : u32 = 65;
pub const DK_CONTAINS : u32 = 66;
pub const DK_NUM : u32 = 67;
pub const DK_VAL : u32 = 68;
pub const DK_APPEND_PATH : u32 = 69;
pub const DK_APPEND : u32 = 70;
pub const DK_EXISTS : u32 = 71;
pub const DK_PREFIX : u32 = 72;
pub const DK_RANGE : u32 = 73;
pub const DK_LAST : u32 = 74;
pub const DK_LIST : u32 = 75;
pub const DK_URL_PATH : u32 = 76;
pub const DK_IS_DIR : u32 = 77;
pub const DK_CLEAR : u32 = 78;
pub const DK_RUNNING : u32 = 79;
pub const DK_STATUS : u32 = 80;
pub const DK_LAUNCH : u32 = 81;
pub const DK_SET_LAUNCH : u32 = 82;
pub const DK_SET_ARGS : u32 = 83;
pub const DK_SET_OUT : u32 = 84;
pub const DK_SET_ERR : u32 = 85;
pub const DK_SET_IN : u32 = 86;
pub const DK_REPL : u32 = 87;
pub const DK_SPLIT : u32 = 88;
pub const DK_READ : u32 = 89;
pub const DK_CREATE : u32 = 90;
pub const DK_FH_WRITE : u32 = 91;
pub const DK_CLOSE : u32 = 92;
pub const DK_LONG : u32 = 93;
pub const DK_FILE_URL : u32 = 94;
pub const DK_TRASH : u32 = 95;
pub const DK_LENGTH : u32 = 96;
pub const DK_STRVAL : u32 = 97;
pub const DK_TRIM : u32 = 98;
pub const DK_PARENT : u32 = 99;
pub const DK_RX_REPL : u32 = 100;
pub const DK_CSET_COUNT : u32 = 101;
pub const DK_OBJ_FOR : u32 = 102;
pub const DK_SET_OBJ : u32 = 103;
pub const DK_WAIT : u32 = 104;
pub const DK_TILDE : u32 = 105;
pub const DK_NEW : u32 = 106;
pub const DK_RELEASE : u32 = 107;
pub const DK_SAME : u32 = 108;
pub const DK_FROM : u32 = 109;
pub const DK_SUB : u32 = 110;
pub const DK_TMPROOT : u32 = 111;
/// NSRegularExpressionSearch, and the slot the confirm-time re-check runs in (after the JOB_SLOTS).
pub const RX_SEARCH : u64 = 1024;
pub const NS_UTF8 : u64 = 4;
pub const SYNC_SLOT : u64 = 4;
pub const DOC_SUM_EVERY : u32 = 30;

fn dk_num(dk: [128]u64, x: u64) -> u64 {
    return msg1(dk[DK_NUMBER], dk[DK_NUM], x);
}

fn dk_at(dk: [128]u64, arr: u64, i: u64) -> u64 {
    return msg1(arr, dk[DK_AT], i);
}

fn dk_count(dk: [128]u64, arr: u64) -> u64 {
    return msg0(arr, dk[DK_COUNT]);
}

/// Column k, row i, as a number.
fn dk_get(dk: [128]u64, k: u32, i: u64) -> u64 {
    return msg0(dk_at(dk, dk[k], i), dk[DK_VAL]);
}

fn dk_set(dk: [128]u64, k: u32, i: u64, x: u64) -> void {
    msg2(dk[k], dk[DK_REPLACE], i, dk_num(dk, x));
}

fn dk_flags(dk: [128]u64, i: u64) -> u32 {
    return @as(u32, @intCast(dk_get(dk, DK_FLAGS, i)));
}

fn dk_put_flags(dk: [128]u64, i: u64, f: u32) -> void {
    dk_set(dk, DK_FLAGS, i, @as(u64, f));
}

fn dk_exists(dk: [128]u64, p: u64) -> bool {
    return msg_test1(dk[DK_FM], dk[DK_EXISTS], p);
}

fn dk_len(dk: [128]u64, s: u64) -> u64 {
    return msg0(s, dk[DK_LENGTH]);
}

/// A new owned NSMutableArray holding `n` copies of `fill`.
fn dk_array(dk: [128]u64, cls_m: u64, n: u64, fill: u64) -> u64 {
    const a : u64 = msg0(cls_m, dk[DK_NEW]);
    var i : u64 = 0;
    while (i < n) {
        msg1(a, dk[DK_ADD], fill);
        i = i + 1;
    }
    return a;
}

/// Repository p was seen on pass `pass`: mark it, or add it with what its folder says about it.
fn dk_register(dk: [128]u64, p: u64, pass: u64) -> void {
    const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
    if (i != NS_NOT_FOUND) {
        dk_set(dk, DK_MARK, i, pass);
        return;
    }
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    if (n >= @as(u64, LIST_MAX)) { return; }
    const git : u64 = msg1(p, dk[DK_APPEND_PATH], dk[DK_GIT]);
    var f : u32 = 0;
    f = with_flag(f, F_WORKTREE, dk_exists(dk, msg1(git, dk[DK_APPEND_PATH], dk[DK_HEADF])) == false);
    f = with_flag(f, F_HAS_WORKTREES, dk_exists(dk, msg1(git, dk[DK_APPEND_PATH], dk[DK_WTS])));
    const slashed : u64 = msg1(p, dk[DK_APPEND], dk[DK_SLASH]);
    const na : u64 = dk_count(dk, dk[DK_AGENTS]);
    var a : u64 = 0;
    while (a < na) {
        if (msg1(slashed, dk[DK_RANGE], dk_at(dk, dk[DK_AGENTS], a)) != NS_NOT_FOUND) { f = with_flag(f, DOC_F_AGENT, true); }
        a = a + 1;
    }
    // a repository below another: the outer one holds it
    var j : u64 = 0;
    while (j < n) {
        const q : u64 = dk_at(dk, dk[DK_PATHS], j);
        const qs : u64 = msg1(q, dk[DK_APPEND], dk[DK_SLASH]);
        if (msg_test1(slashed, dk[DK_PREFIX], qs)) { dk_put_flags(dk, j, with_flag(dk_flags(dk, j), F_NESTS, true)); }
        if (msg_test1(qs, dk[DK_PREFIX], slashed)) { f = with_flag(f, F_NESTS, true); }
        j = j + 1;
    }
    msg1(dk[DK_PATHS], dk[DK_ADD], p);
    msg1(dk[DK_FLAGS], dk[DK_ADD], dk_num(dk, @as(u64, f)));
    msg1(dk[DK_KB], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_BUILD], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_REMOTE], dk[DK_ADD], dk[DK_EMPTY]);
    msg1(dk[DK_BRANCH], dk[DK_ADD], dk[DK_EMPTY]);
    msg1(dk[DK_MARK], dk[DK_ADD], dk_num(dk, pass));
}

/// Forget repository i; a space bound to it lets go.
fn dk_drop(dk: [128]u64, i: u64) -> void {
    const p : u64 = dk_at(dk, dk[DK_PATHS], i);
    const s : u64 = msg1(dk[DK_SLOTS], dk[DK_INDEX], p);
    if (s != NS_NOT_FOUND) { msg2(dk[DK_SLOTS], dk[DK_REPLACE], s, dk[DK_EMPTY]); }
    msg1(dk[DK_FLAGS], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_KB], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_BUILD], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_REMOTE], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_BRANCH], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_MARK], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_PATHS], dk[DK_REMOVE_AT], i);
}

/// Queue the roots of a new pass.
fn dk_start_pass(dk: [128]u64) -> void {
    msg1(dk[DK_QUEUE], dk[DK_ADD], dk[DK_HOME]);
    msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, ROOT_HOME)));
    msg1(dk[DK_QUEUE], dk[DK_ADD], dk[DK_TMPROOT]);
    msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, ROOT_TMP)));
}

/// Walk up to SCAN_BUDGET queued folders from `head`; returns the new head.
fn dk_walk(dk: [128]u64, head: u64, pass: u64) -> u64 {
    var h : u64 = head;
    var b : u32 = 0;
    while (b < SCAN_BUDGET and h < dk_count(dk, dk[DK_QUEUE])) {
        const p : u64 = dk_at(dk, dk[DK_QUEUE], h);
        const d : u32 = @as(u32, @intCast(dk_get(dk, DK_QDEPTH, h)));
        const r : u32 = @as(u32, @intCast(dk_get(dk, DK_QROOT, h)));
        h = h + 1;
        b = b + 1;
        if (dk_exists(dk, msg1(p, dk[DK_APPEND_PATH], dk[DK_GIT]))) { dk_register(dk, p, pass); }
        const kids : u64 = msg4(dk[DK_FM], dk[DK_LIST], msg1(dk[DK_URL_CLS], dk[DK_FILE_URL], p), 0, 0, 0);
        if (kids != 0) {
            const nk : u64 = dk_count(dk, kids);
            var k : u64 = 0;
            while (k < nk) {
                const u : u64 = dk_at(dk, kids, k);
                if (msg_test(u, dk[DK_IS_DIR])) {
                    const name : u64 = msg0(u, dk[DK_LAST]);
                    const skipped : bool = msg_test1(dk[DK_SKIP], dk[DK_CONTAINS], name);
                    const hidden : bool = msg_test1(name, dk[DK_PREFIX], dk[DK_DOT]);
                    const allowed : bool = msg_test1(dk[DK_ALLOWED], dk[DK_CONTAINS], name);
                    if (enters(r, d + 1, skipped, hidden, allowed)) {
                        msg1(dk[DK_QUEUE], dk[DK_ADD], msg1(p, dk[DK_APPEND_PATH], name));
                        msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, @as(u64, d + 1)));
                        msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, r)));
                    }
                }
                k = k + 1;
            }
        }
    }
    return h;
}

/// End of a pass: forget every repository it did not see; returns how many went.
fn dk_sweep(dk: [128]u64, pass: u64) -> u64 {
    var gone : u64 = 0;
    var i : u64 = dk_count(dk, dk[DK_PATHS]);
    while (i > 0) {
        i = i - 1;
        if (dk_get(dk, DK_MARK, i) != pass) {
            dk_drop(dk, i);
            gone = gone + 1;
        }
    }
    msg0(dk[DK_QUEUE], dk[DK_CLEAR]);
    msg0(dk[DK_QDEPTH], dk[DK_CLEAR]);
    msg0(dk[DK_QROOT], dk[DK_CLEAR]);
    return gone;
}

/// Start job j on repository p in output slot `slot`; returns the task, 0 when the output file cannot open.
fn dk_launch(dk: [128]u64, slot: u64, p: u64, j: u32) -> u64 {
    const out : u64 = dk_at(dk, dk[DK_OUTS], slot);
    msg3(dk[DK_FM], dk[DK_CREATE], out, 0, 0);
    const fh : u64 = msg1(dk[DK_FH_CLS], dk[DK_FH_WRITE], out);
    if (fh == 0) { return 0; }
    const line : u64 = dk_at(dk, dk[DK_JOBS], @as(u64, j));
    const words : u64 = msg1(msg2(line, dk[DK_REPL], dk[DK_MARKP], p), dk[DK_SPLIT], dk[DK_ARGSEP]);
    const nw : u64 = dk_count(dk, words);
    const t : u64 = msg0(dk[DK_TASK_CLS], dk[DK_NEW]);
    msg1(t, dk[DK_SET_LAUNCH], dk_at(dk, words, 0));
    msg1(t, dk[DK_SET_ARGS], msg2(words, dk[DK_SUB], 1, nw - 1));
    msg1(t, dk[DK_SET_OUT], fh);
    msg1(t, dk[DK_SET_ERR], dk[DK_DEVNULL]);
    msg1(t, dk[DK_SET_IN], dk[DK_DEVNULL]);
    msg0(t, dk[DK_LAUNCH]);
    msg0(fh, dk[DK_CLOSE]);
    msg2(dk[DK_TPATH], dk[DK_REPLACE], slot, p);
    msg2(dk[DK_TJOB], dk[DK_REPLACE], slot, dk_num(dk, @as(u64, j)));
    return t;
}

/// A finished job in slot `slot` exited with `code`: read its output into the repository's columns.
fn dk_take(dk: [128]u64, slot: u64, code: u64) -> void {
    const p : u64 = dk_at(dk, dk[DK_TPATH], slot);
    const j : u32 = @as(u32, @intCast(dk_get(dk, DK_TJOB, slot)));
    const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
    if (i == NS_NOT_FOUND) { return; }
    const out : u64 = msg3(dk[DK_STR_CLS], dk[DK_READ], dk_at(dk, dk[DK_OUTS], slot), NS_UTF8, 0);
    if (out == 0) { return; }
    var f : u32 = dk_flags(dk, i);
    if (j == JOB_STATUS and code == 0) {
        f = with_flag(f, F_CHECKED, true);
        const lines : u64 = msg1(out, dk[DK_SPLIT], dk[DK_NL]);
        const nl : u64 = dk_count(dk, lines);
        var dirty : bool = false;
        var stash : bool = false;
        var k : u64 = 0;
        while (k < nl) {
            const ln : u64 = dk_at(dk, lines, k);
            if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STHEAD])) {
                msg2(dk[DK_BRANCH], dk[DK_REPLACE], i, msg1(ln, dk[DK_FROM], dk_len(dk, dk[DK_STHEAD])));
            } else if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STSTASH])) {
                stash = true;
            } else if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STH]) == false and dk_len(dk, ln) > 0) {
                dirty = true;
            }
            k = k + 1;
        }
        f = with_flag(f, F_DIRTY, dirty);
        f = with_flag(f, F_STASH, stash);
    }
    if (j == JOB_UNPUSHED and code == 0) {
        f = with_flag(f, F_PUSH_CHECKED, true);
        f = with_flag(f, F_UNPUSHED, dk_len(dk, msg1(out, dk[DK_TRIM], dk[DK_WHITE])) > 0);
    }
    if (j == JOB_REMOTE) {
        if (code == 0) {
            msg2(dk[DK_REMOTE], dk[DK_REPLACE], i, msg1(out, dk[DK_TRIM], dk[DK_WHITE]));
        } else {
            msg2(dk[DK_REMOTE], dk[DK_REPLACE], i, dk[DK_EMPTY]);
        }
        f = with_flag(f, F_NO_REMOTE, code != 0);
    }
    if (j == JOB_SIZE) {
        dk_set(dk, DK_KB, i, msg0(out, dk[DK_LONG]));
    }
    if (j == JOB_BUILD) {
        const lines : u64 = msg1(out, dk[DK_SPLIT], dk[DK_NL]);
        const nl : u64 = dk_count(dk, lines);
        var sum : u64 = 0;
        var k : u64 = 0;
        while (k < nl) {
            sum = sum + msg0(dk_at(dk, lines, k), dk[DK_LONG]);
            k = k + 1;
        }
        dk_set(dk, DK_BUILD, i, sum);
    }
    dk_put_flags(dk, i, f);
}

/// Run job j on repository i now and wait for it (the confirm-time re-check).
fn dk_run_now(dk: [128]u64, i: u64, j: u32) -> void {
    const t : u64 = dk_launch(dk, SYNC_SLOT, dk_at(dk, dk[DK_PATHS], i), j);
    if (t == 0) { return; }
    msg0(t, dk[DK_WAIT]);
    dk_take(dk, SYNC_SLOT, msg0(t, dk[DK_STATUS]) % 4294967296);
    msg0(t, dk[DK_RELEASE]);
}

/// A folder name with its copy suffix stripped.
fn dk_stem(dk: [128]u64, name: u64) -> u64 {
    return msg5(name, dk[DK_RX_REPL], dk[DK_STEMRX], dk[DK_EMPTY], RX_SEARCH, 0, dk_len(dk, name));
}

fn dk_stem_key(dk: [128]u64, p: u64) -> u64 {
    return msg1(msg0(p, dk[DK_PARENT]), dk[DK_APPEND_PATH], dk_stem(dk, msg0(p, dk[DK_LAST])));
}

/// The derived flags and the DOCTOR row order, from the columns; returns how many rows can go.
fn dk_recompute(dk: [128]u64) -> u32 {
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    const keepers : u64 = msg0(dk[DK_DICT_CLS], dk[DK_NEW]);
    const stems : u64 = msg0(dk[DK_CSET_CLS], dk[DK_NEW]);
    var i : u64 = 0;
    while (i < n) {
        const p : u64 = dk_at(dk, dk[DK_PATHS], i);
        var f : u32 = dk_flags(dk, i);
        f = with_flag(f, F_DUP, false);
        f = with_flag(f, F_REPEATED, false);
        f = with_flag(f, F_HEAVY, heavy(dk_get(dk, DK_KB, i)));
        f = with_flag(f, F_BUILD, build_heavy(dk_get(dk, DK_BUILD, i)));
        f = with_flag(f, F_BOUND, msg_test1(dk[DK_SLOTS], dk[DK_CONTAINS], p));
        f = with_flag(f, F_HIDDEN, msg_test1(dk[DK_HIDDEN], dk[DK_CONTAINS], p));
        dk_put_flags(dk, i, f);
        const rem : u64 = dk_at(dk, dk[DK_REMOTE], i);
        if (dup_candidate(f) and dk_len(dk, rem) > 0) {
            const b : u64 = msg1(keepers, dk[DK_OBJ_FOR], rem);
            if (b == 0) {
                msg2(keepers, dk[DK_SET_OBJ], dk_num(dk, i), rem);
            } else if (keeper_rank(f) < keeper_rank(dk_flags(dk, msg0(b, dk[DK_VAL])))) {
                msg2(keepers, dk[DK_SET_OBJ], dk_num(dk, i), rem);
            }
        }
        msg1(stems, dk[DK_ADD], dk_stem_key(dk, p));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        const p : u64 = dk_at(dk, dk[DK_PATHS], i);
        var f : u32 = dk_flags(dk, i);
        const rem : u64 = dk_at(dk, dk[DK_REMOTE], i);
        if (dup_candidate(f) and dk_len(dk, rem) > 0) {
            f = with_flag(f, F_DUP, msg0(msg1(keepers, dk[DK_OBJ_FOR], rem), dk[DK_VAL]) != i);
        }
        const name : u64 = msg0(p, dk[DK_LAST]);
        const suffixed : bool = msg_test1(name, dk[DK_SAME], dk_stem(dk, name)) == false;
        const cnt : u64 = msg1(stems, dk[DK_CSET_COUNT], dk_stem_key(dk, p));
        f = with_flag(f, F_REPEATED, made_again(@as(u32, @intCast(cnt)), suffixed));
        dk_put_flags(dk, i, f);
        i = i + 1;
    }
    msg0(keepers, dk[DK_RELEASE]);
    msg0(stems, dk[DK_RELEASE]);
    msg0(dk[DK_ROWS], dk[DK_CLEAR]);
    var go : u32 = 0;
    var g : u32 = 0;
    while (g < ROW_GROUPS) {
        i = 0;
        while (i < n) {
            const f : u32 = dk_flags(dk, i);
            if (row_group(f) == g) {
                msg1(dk[DK_ROWS], dk[DK_ADD], dk_num(dk, i));
                if (g == ROW_REMOVABLE) { go = go + 1; }
            }
            i = i + 1;
        }
        g = g + 1;
    }
    return go;
}

/// Bind space slot s to the first repository not in a slot whose bind rank is at most `most`; whether one was.
fn dk_bind(dk: [128]u64, s: u32, most: u32) -> bool {
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    var rank : u32 = RANK_AUTO;
    while (rank <= most) {
        var i : u64 = 0;
        while (i < n) {
            const p : u64 = dk_at(dk, dk[DK_PATHS], i);
            var f : u32 = dk_flags(dk, i);
            f = with_flag(f, F_HIDDEN, msg_test1(dk[DK_HIDDEN], dk[DK_CONTAINS], p));
            if (bind_rank(f) == rank and msg_test1(dk[DK_SLOTS], dk[DK_CONTAINS], p) == false) {
                msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, s), p);
                return true;
            }
            i = i + 1;
        }
        rank = rank + 1;
    }
    return false;
}

/// The sidebar names and branches of the six slots: the bound folder's name and branch, else the seed words.
fn dk_names(dk: [128]u64, names: u64, branches: u64) -> void {
    var s : u64 = 0;
    while (s < @as(u64, SPACE_COUNT)) {
        const p : u64 = dk_at(dk, dk[DK_SLOTS], s);
        if (dk_len(dk, p) > 0) {
            msg2(names, dk[DK_REPLACE], s, msg0(p, dk[DK_LAST]));
            const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
            if (i == NS_NOT_FOUND) {
                msg2(branches, dk[DK_REPLACE], s, dk[DK_EMPTY]);
            } else {
                msg2(branches, dk[DK_REPLACE], s, dk_at(dk, dk[DK_BRANCH], i));
            }
        } else {
            msg2(names, dk[DK_REPLACE], s, dk_at(dk, dk[DK_SEEDN], s));
            msg2(branches, dk[DK_REPLACE], s, dk_at(dk, dk[DK_SEEDB], s));
        }
        s = s + 1;
    }
}

/// Move repository i to the Trash if it is still removable after re-checking it now; whether it went.
fn dk_trash(dk: [128]u64, i: u64) -> bool {
    // forget the earlier answers first, so a check that fails now keeps the folder as "checking"
    dk_put_flags(dk, i, with_flag(with_flag(dk_flags(dk, i), F_CHECKED, false), F_PUSH_CHECKED, false));
    dk_run_now(dk, i, JOB_STATUS);
    dk_run_now(dk, i, JOB_UNPUSHED);
    if (removable(dk_flags(dk, i)) == false) { return false; }
    const url : u64 = msg1(dk[DK_URL_CLS], dk[DK_FILE_URL], dk_at(dk, dk[DK_PATHS], i));
    if (msg3(dk[DK_FM], dk[DK_TRASH], url, 0, 0) % 256 != 1) { return false; }
    dk_drop(dk, i);
    return true;
}

/// "12 MB" or "1.5 GB".
fn dk_size(dk: [128]u64, kb: u64) -> u64 {
    const whole : u64 = msg0(dk_num(dk, size_whole(kb)), dk[DK_STRVAL]);
    if (size_in_gb(kb)) {
        const t : u64 = msg1(msg1(whole, dk[DK_APPEND], dk[DK_POINT]), dk[DK_APPEND], msg0(dk_num(dk, size_tenth(kb)), dk[DK_STRVAL]));
        return msg1(msg1(t, dk[DK_APPEND], dk[DK_SPACE]), dk[DK_APPEND], dk_at(dk, dk[DK_WORDS], @as(u64, DL_GB)));
    }
    return msg1(msg1(whole, dk[DK_APPEND], dk[DK_SPACE]), dk[DK_APPEND], dk_at(dk, dk[DK_WORDS], @as(u64, DL_MB)));
}

/// The flag words a row prints, joined with ", ".
fn dk_flag_words(dk: [128]u64, f: u32) -> u64 {
    var s : u64 = dk[DK_EMPTY];
    var k : u32 = 0;
    while (k < FLAG_BITS) {
        if (shows_word(f, k)) {
            if (dk_len(dk, s) > 0) { s = msg1(s, dk[DK_APPEND], dk[DK_COMMA]); }
            s = msg1(s, dk[DK_APPEND], dk_at(dk, dk[DK_FWORDS], @as(u64, k)));
        }
        k = k + 1;
    }
    return s;
}

fn dk_word(dk: [128]u64, k: u32) -> u64 {
    return dk_at(dk, dk[DK_WORDS], @as(u64, k));
}

/// "n" as a string.
fn dk_int(dk: [128]u64, n: u64) -> u64 {
    return msg0(dk_num(dk, n), dk[DK_STRVAL]);
}

fn dk_cat(dk: [128]u64, a: u64, b: u64) -> u64 {
    return msg1(a, dk[DK_APPEND], b);
}

/// The repository whose remove button is under (x, y) in the DOCTOR panel, NS_NOT_FOUND when none is.
fn dk_btn_at(dk: [128]u64, x: f64, y: f64, sw: f64, sh: f64, off: u32) -> u64 {
    const l : f64 = qp_left(sw);
    const rows : u32 = doc_rows(sh, WS_TOP);
    const total : u64 = dk_count(dk, dk[DK_ROWS]);
    var r : u32 = 0;
    while (r < rows and @as(u64, off + r) < total) {
        const i : u64 = dk_get(dk, DK_ROWS, @as(u64, off + r));
        if (removable(dk_flags(dk, i)) and on_doc_btn(x, y, l, QP_W, QP_PAD, WS_TOP, r)) { return i; }
        r = r + 1;
    }
    return NS_NOT_FOUND;
}

/// W. DOCTOR n at the right end of the sidebar foot (doctor.t27 on_doc_link).
pub fn on_doctor_link(x: f64, y: f64, sw: f64, sh: f64) -> bool {
    return on_doc(x, y, sw, sh);
}

/// D. The DOCTOR panel, where the Queen panel sits: the summary, then one row per repository worth naming --
/// the ones that can go first, each with its own remove button that asks once more before it moves the
/// folder to the Trash.
fn draw_doctor_panel(c: u64, kit: [48]u64, dk: [128]u64, sw: f64, sh: f64, mx: f64, my: f64, armed: u32, off: u32, go: u32, live: bool) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    // the ground is draw_panel_ground's, drawn once before the panel
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_text(c, kit, dk_word(dk, DL_TITLE), x, t + DOC_HEAD_Y, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    // the summary: how many repositories, how many answered both checks, how many can go, and the walk
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    var checked : u64 = 0;
    var i : u64 = 0;
    while (i < n) {
        const f : u32 = dk_flags(dk, i);
        if (has(f, F_CHECKED) and has(f, F_PUSH_CHECKED)) { checked = checked + 1; }
        i = i + 1;
    }
    var s : u64 = dk_cat(dk, dk_cat(dk, dk_int(dk, n), dk[DK_SPACE]), dk_word(dk, DL_REPOS));
    s = dk_cat(dk, dk_cat(dk, dk_cat(dk, s, dk[DK_COMMA]), dk_int(dk, checked)), dk[DK_SPACE]);
    s = dk_cat(dk, s, dk_word(dk, DL_CHECKED));
    s = dk_cat(dk, dk_cat(dk, dk_cat(dk, s, dk[DK_COMMA]), dk_int(dk, @as(u64, go))), dk[DK_SPACE]);
    s = dk_cat(dk, s, dk_word(dk, DL_CAN_GO));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_text(c, kit, s, x, t + DOC_SUM_Y, 10.0, 0.0, false);
    var phase : u32 = DL_WATCHING;
    if (live) { phase = DL_SCANNING; }
    draw_text(c, kit, dk_word(dk, phase), x, t + DOC_SUM_Y + 16.0, 9.5, 0.0, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, x, t + DOC_ROWS_Y - 6.0, QP_W - 2.0 * QP_PAD, HAIR);
    const total : u64 = dk_count(dk, dk[DK_ROWS]);
    if (total == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_text(c, kit, dk_word(dk, DL_NOTHING), x, doc_row_top(t, 0) + 16.0, 10.0, 0.0, false);
        return;
    }
    const rows : u32 = doc_rows(sh, t);
    const bx : f64 = doc_btn_x(l, QP_W, QP_PAD);
    var r : u32 = 0;
    while (r < rows and @as(u64, off + r) < total) {
        const ri : u64 = dk_get(dk, DK_ROWS, @as(u64, off + r));
        const f : u32 = dk_flags(dk, ri);
        const p : u64 = dk_at(dk, dk[DK_PATHS], ri);
        const y : f64 = doc_row_top(t, r);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        const nw : f64 = draw_text(c, kit, msg0(p, dk[DK_LAST]), x, y + 14.0, 11.5, WEIGHT_SEMIBOLD, false);
        const kb : u64 = dk_get(dk, DK_KB, ri);
        if (kb > 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            draw_text(c, kit, dk_size(dk, kb), x + nw + 8.0, y + 14.0, 9.5, 0.0, true);
        }
        // why it is named: what keeps it, or the words for what it is
        var why : u64 = dk_flag_words(dk, f);
        if (leftover(f) and keep_reason(f) != KEEP_NONE) { why = dk_at(dk, dk[DK_KWORDS], @as(u64, keep_reason(f))); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_text(c, kit, why, x, y + 29.0, 9.5, 0.0, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_text(c, kit, msg0(p, dk[DK_TILDE]), x, y + 42.0, 8.5, 0.0, true);
        if (removable(f)) {
            const by : f64 = y + DOC_BTN_Y;
            const over : bool = on_doc_btn(mx, my, l, QP_W, QP_PAD, t, r);
            var word : u32 = DL_REMOVE;
            if (armed == @as(u32, @intCast(ri))) { word = DL_CONFIRM; }
            // a plate of the panel's glass first, so a long line under the button does not show through it
            draw_plate(c, bx - 6.0, by - 2.0, DOC_BTN_W + 6.0, DOC_BTN_H + 4.0, sw);
            round_rect(c, bx, by, DOC_BTN_W, DOC_BTN_H, 5.0);
            if (word == DL_CONFIRM) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
                cg_fill_path(c);
                cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
            } else {
                cg_line_width(c, 1.0);
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
                if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
                cg_stroke_path(c);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            }
            const lbl : u64 = dk_word(dk, word);
            const lw : f64 = text_w(kit, lbl, 9.5, WEIGHT_SEMIBOLD, false);
            draw_text(c, kit, lbl, bx + (DOC_BTN_W - lw) / 2.0, by + 13.5, 9.5, WEIGHT_SEMIBOLD, false);
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
        cg_fill_rect(c, x, y + DOC_ROW_H - 2.0, QP_W - 2.0 * QP_PAD, HAIR);
        r = r + 1;
    }
}

// ---- the dashboard's background work: the gallery text, the card files, the live web view ----

fn gallery_load(dc: []u64, gal: []u8, gt: []u32, hb: []const u8) -> void {
    var pb : [512]u8 = undefined;
    put_gallery_path(hb, pb[0..512]);
    const fd : i32 = sys_open_ro(pb[0..512], 0);
    if (fd < 0) { return; }
    const r : i64 = sys_read(fd, gal, @as(u64, GAL_MAX));
    sys_close(fd);
    if (r <= 0) { return; }
    const g : u32 = gal_parse(gal, @as(usize, @intCast(r)), gt);
    if (g > 0 and gal_mapped(gt) > 0) {
        dc[D_GN] = @as(u64, g);
        dc[D_GEN] = dc[D_GEN] + 1;
    }
}

/// Start `/usr/bin/curl -sfL -o <file>.part <url>` for widget wi (WIDGET_COUNT: the gallery) in slot `slot`
/// without waiting for it.
fn dash_spawn(dc: []u64, gal: []const u8, gt: []const u32, hb: []const u8, jp: []u32, jwi: []u32, slot: u32, wi: u32) -> void {
    var fb : [512]u8 = undefined;
    var ub : [320]u8 = undefined;
    var pb : [520]u8 = undefined;
    var fnn : usize = 0;
    var un : usize = 0;
    if (wi == WIDGET_COUNT) {
        fnn = put_gallery_path(hb, fb[0..512]);
        un = put_gallery_url(ub[0..320]);
    } else {
        fnn = put_card_path(hb, gal, gt, wi, fb[0..512]);
        un = put_card_url(gal, gt, wi, ub[0..320]);
    }
    if (un == 0) {
        if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FAILED; }
        return;
    }
    const pn : usize = put_part(fb[0..512], fnn, pb[0..520]);
    var ab : [1024]u8 = undefined;
    var offs : [8]u32 = undefined;
    put_argv(pb[0..520], pn, ub[0..320], un, ab[0..1024], offs[0..8]);
    var argv : [8]u64 = undefined;
    var k : u32 = 0;
    while (k < 7) {
        argv[k] = sys_addr(ab[@as(usize, offs[k]) .. 1024], ab[0..1], 0);
        k = k + 1;
    }
    argv[7] = 0;
    var cp : [16]u8 = undefined;
    put_bytes(cp[0..16], 0, "/usr/bin/curl");
    cp[13] = 0;
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    const rc : i32 = sys_spawn(pid, cp[0..16], 0, 0, argv, 0);
    if (rc != 0 or pid[0] == 0) {
        if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FAILED; }
        return;
    }
    jp[slot] = pid[0];
    jwi[slot] = wi;
    if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FETCH; }
}

/// Once a second: reap finished fetches (rename the .part file on success), read the gallery when it is
/// there, ask for it when it is not, and start the fetches the draw asked for (at most FETCH_SLOTS at once).
fn dash_tick(dc: []u64, gal: []u8, gt: []u32, hb: []const u8, jp: []u32, jwi: []u32, now: u64) -> void {
    if (dc[D_LAST] == now) { return; }
    dc[D_LAST] = now;
    var st : [2]u32 = undefined;
    var busy_gallery : bool = false;
    var j : u32 = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) {
            st[0] = 0;
            const r : i32 = sys_waitpid(@as(i32, @intCast(jp[j])), st, 1);
            if (r != 0) {
                const wi : u32 = jwi[j];
                var fb : [512]u8 = undefined;
                var pb : [520]u8 = undefined;
                var fnn : usize = 0;
                if (wi == WIDGET_COUNT) {
                    fnn = put_gallery_path(hb, fb[0..512]);
                } else {
                    fnn = put_card_path(hb, gal, gt, wi, fb[0..512]);
                }
                put_part(fb[0..512], fnn, pb[0..520]);
                const ok : bool = r > 0 and st[0] == 0;
                if (ok) { sys_rename(pb[0..520], fb[0..512]); } else { sys_unlink(pb[0..520]); }
                if (wi == WIDGET_COUNT) {
                    if (ok) { gallery_load(dc, gal, gt, hb); }
                } else if (ok) {
                    dc[D_ST + wi] = WS_NEW;
                } else {
                    dc[D_ST + wi] = WS_FAILED;
                }
                dc[D_GEN] = dc[D_GEN] + 1;
                jp[j] = 0;
            } else if (jwi[j] == WIDGET_COUNT) {
                busy_gallery = true;
            }
        }
        j = j + 1;
    }
    if (dc[D_GN] == 0) {
        gallery_load(dc, gal, gt, hb);
        if (dc[D_GN] == 0 and busy_gallery == false and now >= dc[D_GTRY] + 10) {
            dc[D_GTRY] = now;
            j = 0;
            while (j < FETCH_SLOTS) {
                if (jp[j] == 0) {
                    dash_spawn(dc, gal, gt, hb, jp, jwi, j, WIDGET_COUNT);
                    j = FETCH_SLOTS;
                } else {
                    j = j + 1;
                }
            }
        }
        return;
    }
    // the scan for cards to fetch: at most once a second, only while some card is not cached, and no more
    // than FETCH_CAP curls at a time (dash.t27: poll_due, fetch_ok)
    var cached : u32 = 0;
    var failed : u32 = 0;
    var running : u32 = 0;
    var wi2 : u32 = 0;
    while (wi2 < WIDGET_COUNT) {
        if (dc[D_ST + wi2] == WS_LOADED) { cached = cached + 1; }
        if (dc[D_ST + wi2] == WS_FAILED) { failed = failed + 1; }
        wi2 = wi2 + 1;
    }
    j = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) { running = running + 1; }
        j = j + 1;
    }
    if (poll_due(now, dc[D_POLL], cached, WIDGET_COUNT - failed) == false) { return; }
    dc[D_POLL] = now;
    wi2 = 0;
    j = 0;
    while (wi2 < WIDGET_COUNT and fetch_ok(running)) {
        if (dc[D_ST + wi2] == WS_WANT) {
            while (j < FETCH_SLOTS and jp[j] != 0) { j = j + 1; }
            if (j < FETCH_SLOTS) {
                dash_spawn(dc, gal, gt, hb, jp, jwi, j, wi2);
                if (jp[j] != 0) { running = running + 1; }
            }
        }
        wi2 = wi2 + 1;
    }
}

/// True while a fetch is running or asked for: the loop keeps ticking.
fn dash_busy(dc: []u64, jp: []const u32) -> bool {
    var j : u32 = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) { return true; }
        j = j + 1;
    }
    return false;
}

fn live_hide(dc: []u64) -> void {
    if (dc[D_WEB] != 0) {
        msg0(dc[D_WEB], sel("removeFromSuperview"));
        msg0(dc[D_WEB], sel("release"));
        dc[D_WEB] = 0;
    }
    dc[D_LIVE] = 0;
}

/// Re-paint the live page for the window or full-screen state (dash.t27 live_js): transparent glass or #000.
fn live_paint(wv: u64, full: bool) -> void {
    var jb : [512]u8 = undefined;
    const jn : usize = live_js(full, false, jb[0..512]);
    const js : u64 = cf_bytes(0, jb[0..512], jn, UTF8, false);
    msg2(wv, sel("evaluateJavaScript:completionHandler:"), js, 0);
    cf_release(js);
}

/// Open widget wi live: one WKWebView over the content area, loading the page the site itself embeds. In a window
/// the view draws no background and a document-start script clears the page's own black field; in full screen the
/// same script paints #000 (dash.t27 live_js).
fn live_show(dc: []u64, glass: u64, gal: []const u8, gt: []const u32, wi: u32, full: bool) -> void {
    if (dc[D_GN] == 0 or wi >= WIDGET_COUNT) { return; }
    live_hide(dc);
    const cfg : u64 = msg0(cls("WKWebViewConfiguration"), sel("new"));
    var jb : [512]u8 = undefined;
    const jn : usize = live_js(full, true, jb[0..512]);
    const js : u64 = cf_bytes(0, jb[0..512], jn, UTF8, false);
    const us0 : u64 = msg3(msg0(cls("WKUserScript"), sel("alloc")), sel("initWithSource:injectionTime:forMainFrameOnly:"), js, 0, 1);
    cf_release(js);
    msg1(msg0(cfg, sel("userContentController")), sel("addUserScript:"), us0);
    const wv : u64 = msg_rect_obj(msg0(cls("WKWebView"), sel("alloc")), sel("initWithFrame:configuration:"), 0.0, 0.0, 100.0, 100.0, cfg);
    if (wv == 0) { return; }
    const nobg : u64 = msg1(cls("NSNumber"), sel("numberWithBool:"), 0);
    const kdraw : u64 = cf("drawsBackground");
    msg2(wv, sel("setValue:forKey:"), nobg, kdraw);
    cf_release(kdraw);
    if (msg_test1(wv, sel("respondsToSelector:"), sel("setUnderPageBackgroundColor:"))) {
        msg1(wv, sel("setUnderPageBackgroundColor:"), msg0(cls("NSColor"), sel("clearColor")));
    }
    msg1(glass, sel("addSubview:"), wv);
    var ub : [320]u8 = undefined;
    const un : usize = put_page_url(gal, gt, wi, ub[0..320]);
    const us : u64 = cf_bytes(0, ub[0..320], un, UTF8, false);
    const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), us);
    cf_release(us);
    msg1(wv, sel("loadRequest:"), msg1(cls("NSURLRequest"), sel("requestWithURL:"), url));
    dc[D_WEB] = wv;
    dc[D_LIVE] = @as(u64, wi) + 1;
}

/// Read the pin file of `letter` into pb[0..PB_PINS]; the byte count (0 when there is no file).
fn pins_load(home: []const u8, letter: u32, pb: []u8) -> usize {
    var pp : [320]u8 = undefined;
    pin_path(home, letter, pp[0..320]);
    const fd : i32 = sys_open_ro(pp[0..320], 0);
    if (fd < 0) { return 0; }
    var r : i64 = sys_read(fd, pb[0..PB_PINS], @as(u64, PB_PINS));
    sys_close(fd);
    if (r < 0) { r = 0; }
    return @as(usize, @intCast(r));
}

/// Write pb[0..n] as the pin file of `letter` (the folders are made first).
fn pins_save(home: []const u8, letter: u32, pb: []const u8, n: usize) -> void {
    var pp : [320]u8 = undefined;
    var dp : [320]u8 = undefined;
    var k : usize = put_bytes(dp[0..320], 0, home);
    k = put_bytes(dp[0..320], k, "/.t27os/pins");
    dp[k] = 0;
    sys_mkdir(dp[0..320], T27OS_HOME_MODE);
    pin_path(home, letter, pp[0..320]);
    const fd : i32 = sys_creat(pp[0..320], T27OS_FILE_MODE);
    if (fd < 0) { return; }
    sys_write(fd, pb[0..PB_PINS], @as(u64, n));
    sys_close(fd);
}

/// The text for the commander line, set by CREATE NEW or a COMMANDS / SKILLS widget; the dialog types it, not sent.
fn set_prefill(dc: []u64, pb: []u8, line: []const u8) -> void {
    var n : usize = line.len;
    if (n > @as(usize, PRE_MAX)) { n = @as(usize, PRE_MAX); }
    var i : usize = 0;
    while (i < n) {
        pb[PB_PRE + i] = line[i];
        i = i + 1;
    }
    dc[D_PREN] = @as(u64, n);
}

// ---- the app ----

pub fn main() -> void {
    // a helper process of the updater (update_agent.t27: serve or fetch) never opens a window
    if (ug_main()) { return; }
    // T27OS_NVIDIA_CHECK=<1..5>: the direct NVIDIA checks with key rotation (nvidia_host.t27), then the process ends
    if (nv_check_main()) { return; }
    const s_alloc : u64 = sel("alloc");
    const app : u64 = msg0(cls("NSApplication"), sel("sharedApplication"));
    msg1(app, sel("setActivationPolicy:"), 0);
    const win : u64 = msg_window(msg0(cls("NSWindow"), s_alloc), sel("initWithContentRect:styleMask:backing:defer:"), 0.0, 0.0, W_PT, H_PT, STYLE, BACKING_BUFFERED, false);
    var brand_b : [16]u8 = undefined;
    const brand_s : u64 = cf_bytes(0, brand_b[0 .. 16], brand(brand_b[0 .. 16]), UTF8, false);
    msg1(win, sel("setTitle:"), brand_s);
    msg_flag(win, sel("setTitlebarAppearsTransparent:"), true);
    msg1(win, sel("setTitleVisibility:"), 1);
    msg_flag(win, sel("setMovableByWindowBackground:"), false);
    msg_flag(win, sel("setOpaque:"), false);
    msg1(win, sel("setBackgroundColor:"), msg0(cls("NSColor"), sel("clearColor")));
    msg1(win, sel("setAppearance:"), msg1(cls("NSAppearance"), sel("appearanceNamed:"), cf("NSAppearanceNameDarkAqua")));
    const glass : u64 = msg_rect(msg0(cls("NSVisualEffectView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg1(glass, sel("setMaterial:"), MATERIAL);
    msg1(glass, sel("setBlendingMode:"), BLEND_BEHIND);
    msg1(glass, sel("setState:"), STATE_ACTIVE);
    msg1(win, sel("setContentView:"), glass);
    msg1(win, sel("setCollectionBehavior:"), FULL_SCREEN_PRIMARY);
    msg1(glass, sel("setAutoresizingMask:"), SIZABLE);
    const view : u64 = msg_rect(msg0(cls("NSView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg_flag(view, sel("setWantsLayer:"), true);
    msg1(glass, sel("addSubview:"), view);
    msg1(view, sel("setAutoresizingMask:"), SIZABLE);
    const layer : u64 = msg0(view, sel("layer"));
    msg1(layer, sel("setContentsGravity:"), cf("resizeAspect"));
    // W. the blackGlass tint lives on the layer, so it covers the whole window in full screen too.
    // the launch material: the frame is the full window, so the opaque black (owner, 2026-10-23)
    msg1(layer, sel("setBackgroundColor:"), cg_color(GROUND_RGB, GROUND_RGB, GROUND_RGB, tint_alpha(W_PT)));
    msg0(win, sel("center"));
    // the smallest window that still shows the sidebar, a chat header and one line of the pane (audit
    // 2026-10-19); mouse moves wake the event wait, which grows to FG_IDLE_S while the screen is still
    msg_ff(win, sel("setContentMinSize:"), 480.0, 320.0);
    msg_flag(win, sel("setAcceptsMouseMovedEvents:"), true);
    msg1(win, sel("makeKeyAndOrderFront:"), 0);
    msg0(app, sel("finishLaunching"));
    // D. the Dock icon, drawn here rather than shipped as a foreign .icns file.
    const ic : u64 = cg_bitmap(0, 512, 512, 8, 2048, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(ic, 0.0, ICON_SIZE);
    cg_scale(ic, 1.0, -1.0);
    draw_app_icon(ic);
    const icon : u64 = msg_image(msg0(cls("NSImage"), s_alloc), sel("initWithCGImage:size:"), cg_image(ic), ICON_SIZE, ICON_SIZE);
    msg1(app, sel("setApplicationIconImage:"), icon);
    msg_flag(app, sel("activateIgnoringOtherApps:"), true);
    // Camera check (test aid, off by default, not product behavior): T27OS_CAMERA_PROBE=1 with T27OS_QA=1 captures the camera inside the
    // app (call_video.t27), prints the brightness table to stderr and exits; the camera permission is this bundle's.
    var cam_env : [32]u8 = undefined;
    if (qa_aid(qa_env(), cl_env("T27OS_CAMERA_PROBE", cam_env[0..32]) > 0)) { sys_exit(cv_probe_run()); }

    // the text kit: every class, selector and string the frames need, made once.
    const s_split : u64 = sel("componentsSeparatedByString:");
    var kit : [48]u64 = undefined;
    kit[K_FONT] = cls("NSFont");
    kit[K_MONO_SEL] = sel("monospacedSystemFontOfSize:weight:");
    kit[K_SYS_SEL] = sel("systemFontOfSize:weight:");
    kit[K_KEY_FONT] = cf("NSFont");
    kit[K_KEY_CTX] = cf("CTForegroundColorFromContext");
    kit[K_YES] = msg_flag(cls("NSNumber"), sel("numberWithBool:"), true);
    msg0(kit[K_YES], sel("retain"));
    kit[K_DICT] = cls("NSDictionary");
    kit[K_DICT_SEL] = sel("dictionaryWithObjects:forKeys:count:");
    kit[K_ATTR] = cls("NSAttributedString");
    kit[K_ALLOC] = s_alloc;
    kit[K_INIT] = sel("initWithString:attributes:");
    kit[K_RELEASE] = sel("release");
    kit[K_NAMES] = msg1(cf(WORLD_NAMES), s_split, cf(","));
    msg0(kit[K_NAMES], sel("retain"));
    kit[K_AT] = sel("objectAtIndex:");
    kit[K_TRINITY] = brand_s;
    kit[K_QUEEN] = cf("Queen");
    kit[K_CMD] = cf("Cmd+");
    kit[K_OPT] = cf("Option+");
    kit[K_CTRL] = cf("Ctrl+");
    kit[K_DIGITS] = msg1(cf("1,2,3,4,5,6,7,8,9"), s_split, cf(","));
    msg0(kit[K_DIGITS], sel("retain"));
    kit[K_OPEN_DASH] = cf("OPEN DASHBOARD");
    kit[K_AGENTS] = cf("AGENTS");
