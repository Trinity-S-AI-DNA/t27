    // and the next number it reads), and the editors found
    var kyp : bool = false;
    var kstored : [9]u32 = undefined;
    var kmask : [144]u8 = undefined;
    var kmlen : [9]u32 = undefined;
    var kst : [72]u32 = undefined;
    var kfail : [9]u32 = undefined;
    var kopen : [9]u64 = undefined;
    var kbuf : [256]u8 = undefined;
    var klen : u32 = 0;
    var kedit : u32 = KY_NONE;
    var karm : u32 = KY_NONE;
    var kbusy : u32 = KY_NONE;
    var kemask : u32 = 0;
    var kewhy : u32 = OPEN_NONE;
    // the terminal editor the strip's first chip opens inside (editors.t27 term_pick; TERM_NONE when none was
    // found) and the editor pane that chip spawned: its server pane id and the space it was opened for
    var ktpick : u32 = term_pick(term_mask());
    // a request to open the editor inside, served in one place below (queen.t27 IE_*), and the spaces the
    // editor was already opened for (queen.t27 edit_mark), so the Queen offers it once per space
    var iedit : u32 = IE_NONE;
    var edone : u64 = 0;
    var epane : u32 = PANE_NONE;
    var espace : u32 = 0;
    // the editor view: on while the editor pane is on screen, the chat and space it was opened on (the view
    // ends when either changes) and the second of the last Escape (Escape twice closes the view)
    var eview : bool = false;
    var ecur : u32 = SESSION_NONE;
    var esp : u32 = 0;
    var eesc : u64 = 0;
    var kpend : u32 = KY_NONE;
    var kbk : u32 = 0;
    var kpre : u32 = 0;
    var ki : u32 = 0;
    while (ki < 9) {
        kstored[ki] = 0;
        kmlen[ki] = 0;
        kfail[ki] = 0;
        kopen[ki] = 0;
        ki = ki + 1;
    }
    var kz : u32 = 0;
    while (kz < 72) {
        kst[kz] = ST_STORED;
        kz = kz + 1;
    }
    var khome : [256]u8 = undefined;
    var kdir : [512]u8 = undefined;
    var ktmp : [256]u8 = undefined;
    var auto_open : bool = true;
    // the terminal pane: the vt grid, the session it shows, offline or live, the server's pane id,
    // frames since the last key (the cursor stays solid while typing), the bytes in and out, the socket,
    // the read cursor into the pane's output and frames since the last connect attempt
    var tst : [32]u32 = undefined;
    var tcells : [960000]u32 = undefined;
    vt_init(tst[0..32], tcells[0..960000], TP_COLS_MIN, TP_ROWS_MIN);
    var tkey : [8]u8 = undefined;
    var techo : [8]u8 = undefined;
    var tout : [4100]u8 = undefined;
    var thome : [256]u8 = undefined;
    var tdir : [512]u8 = undefined;
    var tfd : i32 = -1;
    var tcursor : u64 = 0;
    var ttry : u32 = 0;
    var srvp : u32 = SRV_UP;
    var srvw : u32 = 0;
    var srvpid : u64 = 0;
    var srvretry : bool = false;
    var topen : u32 = PANE_NONE;
    var tlink : u32 = PANE_OFFLINE;
    var tpid : u32 = PANE_NONE;
    var tsince : u32 = 999;
    var tcur : bool = false;
    // the resize debounce: the grid that fit last frame and how many frames it has held
    var twc : u32 = 0;
    var twr : u32 = 0;
    var tstable : u32 = 0;
    // the frame gate (frame_gate.t27): the key on screen, frames since the last draw and since the key
    // last changed, a count of grid updates, and the next event wait
    var fshown : u64 = 0;
    var fsince : u32 = 9999;
    var fquiet : u32 = 0;
    var tfed : u64 = 0;
    var wacc : u32 = 0;
    var wlast : bool = true;
    var wkeys : [40]u8 = undefined;
    var fwait : f64 = FRAME_S;
    // animation clocks: the last time read, the fractional tick carry, the whole ticks of this frame
    var a_last : f64 = abs_time();
    var a_acc : f64 = 1.0;
    var a_frames : u32 = 0;
    const s_chars : u64 = sel("characters");
    const s_chars_raw : u64 = sel("charactersIgnoringModifiers");
    const s_char_at : u64 = sel("characterAtIndex:");
    const s_scroll_y : u64 = sel("scrollingDeltaY");
    const s_precise : u64 = sel("hasPreciseScrollingDeltas");
    // the default frame (window_keep.t27): the visible screen on a first launch or from the old 960 x 540; a frame the
    // user resized is kept. The defaults key is checked BEFORE the autosave name is set, which would write one.
    const fk_saved : bool = msg1(msg0(cls("NSUserDefaults"), sel("standardUserDefaults")), sel("objectForKey:"), cf("NSWindow Frame T27OS")) != 0;
    msg1(win, sel("setFrameAutosaveName:"), cf("T27OS"));
    msg_frame(msg1(win, s_value, k_frame), s_get, wf);
    if (wk_use_visible(fk_saved, wf[2], wf[3], msg0(cls("NSEvent"), sel("modifierFlags")))) {
        msg_frame(msg1(msg0(cls("NSScreen"), sel("mainScreen")), s_value, k_visible), s_get, vf);
        if (vf[2] > 100.0 and vf[3] > 100.0) { msg_set_frame(win, s_set_frame, vf[0], vf[1], vf[2], vf[3], true, false); }
    }
    // a hot swap always restores; an ordinary launch restores what was kept unless Option is held
    const wk_mods : u64 = msg0(cls("NSEvent"), sel("modifierFlags"));
    const wk_hot : bool = msg1(defs, sel("integerForKey:"), k_hot) == 1;
    if (!wk_hot and !wk_restore(1, wk_mods)) { msg2(defs, sel("setInteger:forKey:"), 0, k_kept); }
    if (wk_hot or wk_restore(msg1(defs, sel("integerForKey:"), k_kept), wk_mods)) {
        state = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_state)));
        shown = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_shown)));
        task = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_task)));
        space = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_space)));
        ss = msg1(defs, sel("integerForKey:"), k_ss);
        sp = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_sp)));
        if (spaces_shown(sp) == 0) { sp = SPACES_SEED; }
        if (space_is_open(sp, space) == false) { space = space_at_row(sp, 0); }
        cur = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_cur)));
        hs = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_hs)));
        if (cur >= session_count(ss)) { cur = SESSION_NONE; }
        const fl : u64 = msg1(defs, sel("integerForKey:"), k_flags);
        collapsed = fl % 2 == 1;
        dash = fl / 2 % 2 == 1;
        qp = fl / 4 % 2 == 1;
        god = fl / 8 % 2 == 1;
        dp = fl / 16 % 2 == 1;
        auto_open = fl / 32 % 2 == 0;
        evn = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_evn)));
        ri = 0;
        while (ri < RING) {
            ring[ri] = msg1(defs, sel("integerForKey:"), k_ev[ri]);
            ri = ri + 1;
        }
        if (menu_open(state)) { ma = 1.0; }
        msg2(defs, sel("setInteger:forKey:"), 0, k_hot);
    }
    hs_for = shown;
    while (msg_test(win, s_visible)) {
        const pool : u64 = pool_push();
        msg_point(msg1(win, s_value, k_mouse), s_get, pt);
        msg_frame(msg1(view, s_value, k_frame), s_get, fr);
        const sw : f64 = scene(fr[2], fr[3], 0);
        const sh : f64 = scene(fr[2], fr[3], 1);
        const narrow : bool = fr[2] < COMPACT_BELOW;
        const ws : u32 = workspace(sw, dash);
        var mx : f64 = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
        var my : f64 = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
        const full : bool = has_mod(msg0(win, s_mask), MASK_FULL_SCREEN);
        var z : f64 = 1.0;
        if (full) { z = FULL_LOGO; }
        if (tint_swap(full, was_full)) {
            if (full) { msg1(layer, sel("setBackgroundColor:"), tint_full); } else { msg1(layer, sel("setBackgroundColor:"), tint_win); }
            was_full = full;
            if (dcv[D_WEB] != 0) { live_paint(dcv[D_WEB], full); }
        }
        var vx : i64 = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
        var vy : i64 = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
        // H. the logo answers the mouse only at home, once the screen has gone.
        const home_live : bool = menu_open(state) == false and ma == 0.0 and my > AREA_TOP;
        // the CHAT petal's screen carries every chat control; a home tab (any other petal) carries only the
        // title bar's back chevron and its cards
        const screen : bool = menu_open(state) and ma >= 0.5 and shown == PETAL_CHAT and cons2 == false;
        const hscreen : bool = menu_open(state) and ma >= 0.5 and (shown != PETAL_CHAT or cons2);
        // the sidebar a screen shows: the chat's, or a home tab's
        var sws : u32 = ws;
        if (shown != PETAL_CHAT or cons2) { sws = home_ws(ws); }
        const hh : u32 = letter_of_petal(shown);
        now = unix_time(0);
        tgv[TPG_NOW] = now;
        // a letter with a built tool page shows it in place of its dashboard (agent_parts page_kind)
        const tpk : u32 = page_kind(hh);
        const tpg : bool = hscreen and ma >= 0.5 and shown != PETAL_CHAT and tpk != PAGE_NONE and tgv[TPG_DASH] == 0 and dcv[D_LIVE] == 0;
        var sug : u32 = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        var ev : u64 = msg_event(app, s_next, 0xffffffffffffffff, msg_f(date_cls, s_wait, fwait), mode, true);
        while (ev != 0) {
            const ty : u64 = msg0(ev, s_type);
            var used : bool = false;
            var ctl : u32 = C_NONE;
            var to_agents : bool = false;
            var carg : u32 = 0;
            if (ty == EV_LEFT_DOWN) {
                // the click is where the event says, not where the mouse was when the frame began
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                vx = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
                vy = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
                const lgh : u32 = lv_log_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, sw - content_x(ws, collapsed), sh - WS_TOP - HEADER_H);
                if (screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and (lgh == LVH_CLOSE or lgh == LVH_CRUMB)) {
                    // L. the log view's close x and its "back to chat" crumb return to the pane
                    if (lgh == LVH_CLOSE) { sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_CLOSE, 0); } else { sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_CRUMB, 0); }
                    tsince = 0;
                } else if (screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and lgh == LVH_BODY) {
                    // L. the log view is a view of its own: a click in it reaches nothing under it
                    tsince = 0;
                } else if (screen and topen != PANE_NONE and srvp != SRV_UP and sst[SST_LVSEL] == LV_NONE and tp_retry_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp), sh - WS_TOP - HEADER_H)) {
                    // T. the Retry button of the pane server banner: start the server again
                    srvretry = true;
                    tsince = 0;
                } else if (qp and on_panel(mx, my, sw, WS_TOP)) {
                    // Q. the Queen panel: close, GOD MODE, and the human gate on every suggestion
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        qp = false;
                        god = false;
                        ctl = C_QUEEN_KEY;
                    } else if (on_god(mx, my, sw, WS_TOP)) {
                        god = god == false;
                        if (god) { ctl = C_GOD_ON; } else { ctl = C_GOD_OFF; }
                        last_act = now;
                    } else if (sug != A_NONE and on_confirm(mx, my, sw, WS_TOP)) {
                        cur = act_cur(ss, sug, space, cur);
                        ss = act_sessions(ss, sug, space);
                        if (cur != SESSION_NONE) { task = session_agent(ss, cur); carg = task; }
                        // her editor suggestion: open this space's folder inside, once for the space
                        if (sug == A_EDIT) {
                            iedit = IE_USER;
                            edone = edit_mark(edone, space);
                        }
                        ctl = C_CONFIRM;
                    } else if (sug != A_NONE and on_dismiss(mx, my, sw, WS_TOP)) {
                        dismissed = sug;
                        ctl = C_DISMISS;
                    } else if (sug == A_NONE and evd != 0 and on_confirm(mx, my, sw, WS_TOP)) {
                        // the evolve suggestion, confirmed: a task shows its planned lane (EVOLVE_SPAWNS is false: nothing starts)
                        evfl = evfl | letter_bit(dec_letter(evd));
                        if (dec_action(evd) == D_TASK) {
                            evst = evst + 1;
                            evp = evd;
                            evn2 = evst;
                        }
                        carg = dec_letter(evd);
                        evd = 0;
                        ctl = C_CONFIRM;
                    } else if (sug == A_NONE and evd != 0 and on_dismiss(mx, my, sw, WS_TOP)) {
                        evfl = evfl | letter_bit(dec_letter(evd));
                        evd = 0;
                        ctl = C_DISMISS;
                    }
                } else if (kyp and qp == false and dp == false and on_panel(mx, my, sw, WS_TOP)) {
                    // K. the KEYS panel: close, a row's add (the next free number) / delete (the newest key, asks twice) / check (every key), an editor chip
                    const kl : f64 = qp_left(sw);
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        kyp = false;
                        karm = KY_NONE;
                        kedit = KY_NONE;
                        klen = 0;
                    } else {
                        const kh : u32 = ky_hit(mx, my, kl, QP_W, QP_PAD, WS_TOP);
                        const kq : u32 = kh / 4;
                        if (kh != KY_NONE) {
                            const kact : u32 = ky_click(kh % 4, kstored[kq] > 0, next_free_key(kstored[kq]) >= MAX_KEYS, probe_has(kq), karm, kq);
                            if (kact == KA_EDIT) {
                                kedit = kq;
                                klen = 0;
                                karm = KY_NONE;
                            } else if (kact == KA_ARM) {
                                karm = kq;
                                kedit = KY_NONE;
                                klen = 0;
                            } else if (kact == KA_DELETE) {
                                // the row's DELETE removes the newest key only (keys.t27 newest_key), from the Keychain and the server
                                const kdn : u32 = newest_key(kstored[kq]);
                                if (kdn < MAX_KEYS) {
                                    if (kc_del_n(kq, kdn)) {
                                        kst[key_index(kq, kdn)] = ST_STORED;
                                        if (tfd >= 0) { client_set_key(tfd, setkey_byte(kq, kdn), "", tout[0..4100]); }
                                    }
                                }
                                karm = KY_NONE;
                                kfail[kq] = 0;
                                keys_refresh(kstored[0..9], kmask[0..144], kmlen[0..9]);
                            } else if (kact == KA_CHECK) {
                                kbusy = kq;
                                kbk = 0;
                                kpend = 0;
                                karm = KY_NONE;
                            } else {
                                karm = KY_NONE;
                            }
                        } else {
                            karm = KY_NONE;
                            const kft : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT);
                            const keh : u32 = ed_hit(mx, my, kl, QP_PAD, foot_chips_top(kft), foot_chips(kft, sh, strip_count(kemask, ktpick)));
                            if (keh != ED_NONE) {
                                // the editor opens the folder of the space on screen (home when it is unbound)
                                var kdirs : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
                                if (dk_len(dk, kdirs) == 0) { kdirs = home_dir(); }
                                const khn : usize = ns_bytes(home_dir(), khome[0..256]);
                                const kdn : usize = ns_bytes(kdirs, kdir[0..512]);
                                const kchip : u32 = strip_chip(kemask, ktpick, keh);
                                if (kchip == CHIP_INSIDE and eview) {
                                    // the chip is also the way back to the chat; the editor keeps running in the server
                                    eview = false;
                                } else if (kchip == CHIP_INSIDE) {
                                    // T27 OS opens inside: the request is served below, where the Queen's is too
                                    iedit = IE_USER;
                                } else {
                                    kewhy = open_in_editor(kchip, khome[0..khn], kdir[0..kdn]);
                                }
                            }
                        }
                    }
                } else if (dp and on_panel(mx, my, sw, WS_TOP)) {
                    // D. the DOCTOR panel: close, or a row's remove / confirm -- one item, one human click each
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        dp = false;
                        darmed = ARMED_NONE;
                    } else {
                        const bi : u64 = dk_btn_at(dk, mx, my, sw, sh, doff);
                        if (bi != NS_NOT_FOUND) {
                            const o : u32 = click_on_row(darmed, @as(u32, @intCast(bi)), dk_flags(dk, bi));
                            darmed = after_click(o, @as(u32, @intCast(bi)));
                            if (o == CLICK_REMOVE) {
                                if (dk_trash(dk, bi)) { dnow = true; }
                            }
                        } else {
                            darmed = ARMED_NONE;
                        }
                    }
                } else if (screen and ws == WS_EXPANDED and collapsed == false and in_side(mx, ws, collapsed) and lv_row_at(my, lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sst[SST_LVOFF], sst[SST_LVN], lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh)) != LV_NONE) {
                    // L. a click on a lane or actor row opens its live log tail (a script lane) or its line (any other source)
                    const li : u32 = lv_row_at(my, lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sst[SST_LVOFF], sst[SST_LVN], lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh));
                    if (lv_is_group(sst[SST_LV .. SST_SIZE], li)) {
                        // the kernel group row folds and unfolds its actors; it opens no view
                        if (sst[SST_LVKX] != 0) { sst[SST_LVKX] = 0; } else { sst[SST_LVKX] = 1; }
                        lvat = 0;
                    } else {
                        sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_OPEN, li);
                        sst[SST_LVLSCR] = 0;
                        sst[SST_LVKEY] = sst[SST_LV + @as(usize, li) * LV_F + LVF_SRC];
                        sst[SST_LVKEY + 1] = sst[SST_LV + @as(usize, li) * LV_F + LVF_ISSUE];
                        lvcur = cur;
                    }
                    tsince = 0;
                } else if (term_up(screen, topen) and vt_chip_shown(tst[0..32]) and tp_chip_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp), sh - WS_TOP - HEADER_H)) {
                    // T. the "jump to live" chip: back to the live screen
                    vt_to_live(tst[0..32]);
                    tsince = 0;
                } else if (term_click(term_up(screen, topen), mx, my, sw, sh, ws, collapsed, qp or dp or kyp)) {
                    // T. a click on the terminal pane is the pane's: its cursor goes solid and nothing under it
                    // reacts (no card, no petal, no bar); every control the chain below answers lies outside
                    // on_term (the title bar, the header, the dashboard bar, the sidebar), or is a card
                    tsince = 0;
                } else if (on_home_button(mx, my, sw)) {
                    ctl = C_HOME;
                    state = on_back(state);
                } else if (on_full_button(mx, my, sw)) {
                    msg1(win, s_full, 0);
                } else if (on_dock_button(mx, my, sw) and full == false) {
                    // K. WindowManager: the panel docks 400 pt wide on the right edge, full visible height.
                    if (docked) {
                        msg_set_frame(win, s_set_frame, wf[0], wf[1], wf[2], wf[3], true, true);
                    } else {
                        msg_frame(msg1(win, s_value, k_frame), s_get, wf);
                        msg_frame(msg1(msg0(win, s_screen), s_value, k_visible), s_get, vf);
                        msg_set_frame(win, s_set_frame, vf[0] + vf[2] - PANEL_W, vf[1], PANEL_W, vf[3], true, true);
                    }
                    docked = docked == false;
                } else if ((screen or hscreen) and on_nav_back(mx, my, full)) {
                    if (hscreen and dcv[D_LIVE] != 0) {
                        live_hide(dcv[0..512]);
                    } else {
                        state = on_back(state);
                        ctl = C_HOME;
                    }
                } else if (screen and on_open_dash(mx, my, sw, ws)) {
                    dash = true;
                    ctl = C_DASHBOARD;
                } else if (screen and on_close_dash(mx, my, ws, collapsed)) {
                    dash = false;
                    ctl = C_DASHBOARD;
                } else if ((screen or hscreen) and on_side_toggle(mx, my, sws, collapsed)) {
                    collapsed = collapsed == false;
                    ctl = C_SIDEBAR;
                } else if (screen and on_switch(mx, my, sw, WS_TOP)) {
                    // the C petal's header: CONSOLE opens the cockpit of letter C
                    cons2 = true;
                } else if (hscreen and shown == PETAL_CHAT and on_switch(mx, my, sw, WS_TOP)) {
                    cons2 = false;
                } else if (hscreen and shown != PETAL_CHAT and tpk != PAGE_NONE and dcv[D_LIVE] == 0 and on_switch(mx, my, sw, WS_TOP)) {
                    // the page's header switch: the dashboard of this letter, and back
                    tgv[TPG_DASH] = 1 - tgv[TPG_DASH];
                    tgv[TPG_K_DRAG] = 0;
                    tg_bump(tgv[0..128]);
                } else if (tpg and mx >= content_x(home_ws(ws), collapsed) and my >= home_view_top()) {
                    // a click on a tool page: B buttons and the FLASH dialogue, K picks a card up, Q has STOP
                    const pgx : f64 = content_x(home_ws(ws), collapsed);
                    const pgy : f64 = home_view_top();
                    const pgw : f64 = sw - pgx;
                    const pgh : f64 = home_view_h(sh);
                    if (tpk == PAGE_BENCH) {
                        var askc : u32 = BH_NONE;
                        if (tgv[TPG_BA_FS] != 0) { askc = @as(u32, @intCast(tgv[TPG_BA_CARD])); }
                        bench_click(tgv[0..128], tbv[0..49152], dhb[0..dhn], now, bp_hit(mx - pgx, my - pgy, pgw, askc));
                    }
                    if (tpk == PAGE_KANBAN) { kanban_down(tgv[0..128], tbv[0..49152], mx, my, pgx, pgy, pgw, pgh); }
                    if (tpk == PAGE_QUEEN) {
                        if (god and on_stop(mx - (pgx + node_x(QN_SAFETY, pgw)), my - (pgy + node_y(QN_SAFETY, pgw, pgh)), pgw)) {
                            god = false;
                            ctl = stop_control(true);
                            tg_bump(tgv[0..128]);
                        }
                    }
                } else if (hscreen and in_side(mx, home_ws(ws), collapsed) and sec_at(mx, my, WS_TOP) != SEC_NONE) {
                    // H. a section row of this letter's sidebar scrolls its page to that section (no other letter is reachable here)
                    var snc : [32]u32 = undefined;
                    const sna : u32 = plan(hh, snc[0..32]);
                    snc[1] = pins_n(dcv[0..512], pbuf[0..4160]);
                    const sxt : f64 = sec_target(sec_at(mx, my, WS_TOP), hh, snc[0..32], sna, sw - content_x(home_ws(ws), collapsed) - 48.0);
                    if (sxt >= 0.0) {
                        hs = dash_scroll_clamp(hs, @as(i64, @intFromFloat(sxt)) - @as(i64, hs), dash_total_p(hh, sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
                    }
                } else if (hscreen and dcv[D_LIVE] != 0 and on_live_back(mx, my, content_x(home_ws(ws), collapsed), home_view_top())) {
                    live_hide(dcv[0..512]);
                } else if (hscreen and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0) {
                    // the ADD WIDGET panel: close, PIN FROM GALLERY (tap a cell), CREATE NEW (the agents dialog with a line typed)
                    const acx : f64 = content_x(home_ws(ws), collapsed);
                    const avt : f64 = home_view_top();
                    const aq : u32 = @as(u32, @intCast(dcv[D_ADDN]));
                    var ash : u32 = match_count(gal[0..49152], gt[0..2560], gal_total(gt[0..2560]), pbuf[PB_QUERY .. PB_QUERY + 32], aq);
                    if (ash > ap_cap(sw - acx, sh - avt)) { ash = ap_cap(sw - acx, sh - avt); }
                    const aph : u32 = ap_hit(sw - acx, sh - avt, mx - acx, my - avt, ash);
                    if (aph == AP_CLOSE or aph == AP_OUTSIDE) {
                        dcv[D_ADDP] = 0;
                    } else if (aph == AP_CREATE) {
                        var lnb : [96]u8 = undefined;
                        const lnn : usize = create_line(AGENT_LETTERS[hh - 1], lnb[0..96]);
                        set_prefill(dcv[0..512], pbuf[0..4160], lnb[0..lnn]);
                        dcv[D_ADDP] = 0;
                        to_agents = true;
                    } else if (aph >= AP_CELL) {
                        const arow : u32 = nth_match(gal[0..49152], gt[0..2560], gal_total(gt[0..2560]), pbuf[PB_QUERY .. PB_QUERY + 32], aq, aph - AP_CELL);
                        if (arow != PIN_NONE) {
                            const ast : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + arow) * 2]);
                            const aln : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + arow) * 2 + 1]);
                            dcv[D_PINN] = @as(u64, pin_add(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), gal[ast .. ast + aln]));
                            pins_save(dhb[0..dhn], hh, pbuf[0..4160], @as(usize, dcv[D_PINN]));
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] == 0 and dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160])) != HIT_NONE) {
                    // a tile: a gallery card opens its widget live; '+' opens the ADD panel; a pinned tile opens or (x) unpins;
                    // the agents block opens the dialog; an area widget acts (a command or skill types its line in the dialog)
                    const ph : u32 = dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160]));
                    const pcl : u32 = hit_class(ph);
                    const pix : u32 = hit_idx(ph);
                    var ppo : [128]u32 = undefined;
                    const ppc : u32 = pins_parse(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), ppo[0..128]);
                    if (pcl == HC_WIDGET) {
                        live_show(dcv[0..512], glass, gal[0..49152], gt[0..2560], pix, full);
                    } else if (pcl == HC_PIN and pix < ppc) {
                        const pws : u32 = widget_of_id(pbuf[@as(usize, ppo[pix * 2]) .. @as(usize, ppo[pix * 2]) + @as(usize, ppo[pix * 2 + 1])]);
                        if (pws < WIDGET_COUNT) { live_show(dcv[0..512], glass, gal[0..49152], gt[0..2560], pws, full); }
                    } else if (pcl == HC_UNPIN and pix < ppc) {
                        dcv[D_PINN] = @as(u64, pin_remove(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), pbuf[@as(usize, ppo[pix * 2]) .. @as(usize, ppo[pix * 2]) + @as(usize, ppo[pix * 2 + 1])]));
                        pins_save(dhb[0..dhn], hh, pbuf[0..4160], @as(usize, dcv[D_PINN]));
                    } else if (pcl == HC_PLUS) {
                        dcv[D_ADDP] = 1;
                        dcv[D_ADDN] = 0;
                    } else if (pcl == HC_CHAT) {
                        to_agents = true;
                    } else if (pcl == HC_AREA) {
                        const ak : u32 = pix / 256;
                        const ai : u32 = pix % 256;
                        if (ak == SEC_HOME) {
                            const hl : u32 = home_other(hh, ai);
                            if (hl > 0) {
                                state = hl - 1;
                                shown = hl - 1;
                                cons2 = true;
                                ctl = C_WORLD;
                                carg = hl - 1;
                            }
                        }
                        if (ak == SEC_COMMANDS and tool_n(hh) > 0) {
                            set_prefill(dcv[0..512], pbuf[0..4160], tool_at(hh, ai));
                            to_agents = true;
                        }
                        if (ak == SEC_SKILLS and skill_n(hh) > 0) {
                            set_prefill(dcv[0..512], pbuf[0..4160], skill_at(hh, ai));
                            to_agents = true;
                        }
                    }
                } else if (screen and on_new_chat(mx, my, sw, ws)) {
                    // N. "+" opens one more chat of the selected agent in this space and selects it
                    const nk : u32 = new_chat_agent(task);
                    const before : u32 = session_count(ss);
                    ss = add_session(ss, nk, space);
                    if (session_count(ss) > before) { cur = before; task = nk; }
                    ctl = C_NEW_CHAT;
                    carg = nk;
                } else if (screen and card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed) != CARD_SLOTS) {
                    // A. a tap on a cell opens that agent's chat here, or a first one if there is none
                    task = card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed);
                    ctl = C_CELL;
                    carg = task;
                    cur = SESSION_NONE;
                    if (task != AGENT_QUEEN) {
                        cur = first_of(ss, task, space);
                        if (cur == SESSION_NONE) {
                            const before : u32 = session_count(ss);
                            ss = add_session(ss, task, space);
                            if (session_count(ss) > before) { cur = before; }
                        }
                    }
                } else if (screen and in_side(mx, ws, collapsed) and on_space_plus(mx, my) and new_space(sp) != SPACE_NONE) {
                    // W. "+" opens the next closed space slot and selects it; a chat elsewhere is let go
                    space = new_space(sp);
                    sp = add_space(sp, space);
                    ctl = C_NEW_SPACE;
                    dk_bind(dk, space, RANK_PLUS);
                    dnow = true;
                    carg = space;
                    if (cur != SESSION_NONE) { cur = SESSION_NONE; task = CARD_SLOTS; }
                } else if ((screen or hscreen) and on_update_strip(mx, my, sh, sws, collapsed, strip_kind(@as(u8, @intCast(tgv[TPG_U_ST])), @as(u8, @intCast(tgv[TPG_U_WHY]))) != STRIP_HIDDEN and tgv[TPG_U_ON] != 0)) {
                    // U. the update line above the foot: Update now (install as soon as no pane is busy) or try again
                    tgv[TPG_U_GO] = 1;
                    tg_bump(tgv[0..128]);
                } else if (screen and on_keys_foot(mx, my, sh, ws, collapsed)) {
                    // K. KEYS in the foot opens or closes the panel; it takes the Queen and DOCTOR panels' place
                    kyp = kyp == false;
                    karm = KY_NONE;
                    kedit = KY_NONE;
                    klen = 0;
                    if (kyp) {
                        qp = false;
                        god = false;
                        dp = false;
                        keys_refresh(kstored[0..9], kmask[0..144], kmlen[0..9]);
                        // the refresh also hands the server every numbered key again (a server that restarted forgot them)
                        if (tfd >= 0) { keys_sync(tfd, kst[0..72], tout[0..4100]); }
                        const khn : usize = ns_bytes(home_dir(), khome[0..256]);
                        kemask = installed_mask(khome[0..khn]);
                        ktpick = term_pick(term_mask());
                        kewhy = OPEN_NONE;
                    }
                } else if ((screen or hscreen) and on_doctor_link(mx, my, sh, sws, collapsed)) {
                    // D. DOCTOR in the foot opens or closes the panel; it takes the Queen panel's place
                    dp = dp == false;
                    if (dp) { qp = false; god = false; kyp = false; }
                    darmed = ARMED_NONE;
                } else if ((screen or hscreen) and on_repo_link(mx, my, sh, sws, collapsed)) {
                    // W. OPEN SOURCE T27 opens the repository in the default browser
                    const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), cf(REPO_URL));
                    msg1(msg0(cls("NSWorkspace"), sel("sharedWorkspace")), sel("openURL:"), url);
                    ctl = C_REPO_LINK;
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_QUEEN, spaces_shown(sp), 1, my) == 0) {
                    // W. the Queen row selects the orchestrator and opens or closes her panel
                    task = AGENT_QUEEN;
                    cur = SESSION_NONE;
                    qp = qp == false;
                    qp = qp == false;
                    if (qp) { kyp = false; }
                    ctl = C_QUEEN_ROW;
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my) != ROW_NONE) {
                    // W. a space row selects the space; a chat that lives elsewhere is let go
                    const sr : u32 = row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my);
                    const rs : u32 = space_at_row(sp, sr);
                    if (spaces_shown(sp) > 1 and on_space_close(mx, my, row_top(WS_TOP, GROUP_SPACES, spaces_shown(sp), sr))) {
                        // W. its x closes the space and every chat in it; the selection moves to the first space left
                        ctl = C_CLOSE_SPACE;
                        carg = rs;
                        cur = after_drop(cur, ss, rs);
                        ss = drop_sessions_in(ss, rs);
                        sp = remove_space(sp, rs);
                        // D. a space bound to a repository hides it: the walk keeps it, the sidebar does not
                        const hp : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, rs));
                        if (dk_len(dk, hp) > 0) {
                            if (msg1(dk[DK_HIDDEN], dk[DK_CONTAINS], hp) == 0) { msg1(dk[DK_HIDDEN], dk[DK_ADD], hp); }
                            msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, rs), dk[DK_EMPTY]);
                        }
                        auto_open = false;
                        dnow = true;
                        if (cur == SESSION_NONE and task != AGENT_QUEEN) { task = CARD_SLOTS; }
                        if (space == rs) { space = space_at_row(sp, 0); }
                    } else {
                        space = rs;
                        ctl = C_SPACE_ROW;
                        carg = space;
                        if (cur != SESSION_NONE and session_space(ss, cur) != space) { cur = SESSION_NONE; task = CARD_SLOTS; }
                    }
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my) != ROW_NONE) {
                    // W. an agent row selects that chat; N. its x closes it
                    const r : u32 = row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my);
                    const si : u32 = session_at_row(ss, space, r);
                    if (on_row_close(mx, my, row_top(WS_TOP, GROUP_AGENTS, spaces_shown(sp), r))) {
                        if (si == cur) { task = CARD_SLOTS; }
                        ctl = C_CLOSE_CHAT;
                        topen = PANE_NONE;
                        carg = session_agent(ss, si);
                        ss = remove_session(ss, si);
                        cur = after_remove(cur, si);
                    } else {
                        cur = si;
                        task = session_agent(ss, si);
                        ctl = C_AGENT_ROW;
                        carg = task;
                    }
                } else if (home_live) {
                    const p : u32 = on_tap(STATE_HOME, to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc));
                    if (menu_open(p)) { state = p; shown = p; cons2 = tap_cons(p, false); ctl = C_WORLD; carg = p; }
                    if (menu_open(p) == false and centre_hit(to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc))) {
                        // the CENTRAL BUTTON opens the agents dialog (the chat workspace) as its own screen
                        state = home_tap(p, true);
                        shown = state;
                        cons2 = tap_cons(p, true);
                        ctl = C_WORLD;
                        carg = state;
                    }
                }
            }
            if (ty == EV_LEFT_UP and tgv[TPG_K_DRAG] != 0) {
                // K. the drop: kanban.t27 decides, an accepted move stays on the board as a proposal
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                kanban_up(tgv[0..128], tbv[0..49152], mx, my, content_x(home_ws(ws), collapsed), home_view_top(), sw - content_x(home_ws(ws), collapsed));
                used = true;
            }
            if (ty == EV_LEFT_DRAGGED and tgv[TPG_K_DRAG] != 0) { used = true; }
            if (to_agents) {
                // the agents dialog (the chat workspace of the C petal); a first chat is started when none is open
                state = PETAL_CHAT;
                shown = PETAL_CHAT;
                cons2 = false;
                if (cur == SESSION_NONE) {
                    const nk0 : u32 = new_chat_agent(task);
                    const before0 : u32 = session_count(ss);
                    ss = add_session(ss, nk0, space);
                    if (session_count(ss) > before0) { cur = before0; task = nk0; }
                }
            }
            if (ty == EV_SCROLL and screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and lv_log_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, sw - content_x(ws, collapsed), sh - WS_TOP - HEADER_H) != 0) {
                // L. the wheel scrolls the open log view by lines
                var gdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { gdy = gdy * 16.0; }
                gacc = gacc + gdy;
                const gvis : u32 = lv_log_vis(sh - WS_TOP - HEADER_H);
                var gnl : u32 = 0;
                if (sst[SST_LVKEY] == LV_SCRIPT) {
                    var gst : [40]u32 = undefined;
                    gnl = lv_tail_lines(tbv[TBO_LT .. TBO_LT + @as(usize, sst[SST_LVTAIL])], gst[0..40], LV_TAIL_LINES);
                }
                while (gacc >= LV_LOG_LINE_H) {
                    sst[SST_LVLSCR] = lv_log_scroll(sst[SST_LVLSCR], true, 1, gnl, gvis);
                    gacc = gacc - LV_LOG_LINE_H;
                }
                while (gacc <= -LV_LOG_LINE_H) {
                    sst[SST_LVLSCR] = lv_log_scroll(sst[SST_LVLSCR], false, 1, gnl, gvis);
                    gacc = gacc + LV_LOG_LINE_H;
                }
                used = true;
            } else if (ty == EV_SCROLL and screen and ws == WS_EXPANDED and collapsed == false and in_side(mx, ws, collapsed) and my >= lane_block_top(spaces_shown(sp), sessions_in(ss, space))) {
                // L. the wheel scrolls the LANES block by rows
                var ldy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { ldy = ldy * 16.0; }
                lacc = lacc + ldy;
                const lvis : u32 = lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh);
                while (lacc >= 24.0) {
                    if (sst[SST_LVOFF] > 0) { sst[SST_LVOFF] = sst[SST_LVOFF] - 1; }
                    lacc = lacc - 24.0;
                }
                while (lacc <= -24.0) {
                    sst[SST_LVOFF] = lv_scroll_clamp(sst[SST_LVOFF] + 1, sst[SST_LVN], lvis);
                    lacc = lacc + 24.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and term_up(screen, topen) and on_term(mx, my, sw, sh, ws, collapsed, qp or dp or kyp) and (qp or dp or kyp) == false) {
                // T. the wheel over a terminal pane: on the main screen it scrolls the history by sub-row pixels; on the
                // alternate screen it goes to the program as arrows, or as mouse reports when it asked for them (vt.t27)
                const wdy : f64 = msg_real(ev, s_scroll_y);
                const wnotch : bool = msg0(ev, s_precise) % 256 == 0;
                const wunits : u32 = tp_wheel_units(wdy, wnotch);
                const wup : bool = wdy > 0.0;
                if (vt_wheel_route(tst[0..32]) == ROUTE_VIEW) {
                    if (wup) { vt_view_up(tst[0..32], wunits); } else { vt_view_down(tst[0..32], wunits); }
                } else {
                    if (wup != wlast) { wacc = 0; }
                    wlast = wup;
                    wacc = wacc + wunits;
                    // three rows of travel (48 units) make one report of arrows or one mouse report
                    while (wacc >= 3 * VIEW_SUB) {
                        wacc = wacc - 3 * VIEW_SUB;
                        const wn : u32 = vt_wheel_bytes(tst[0..32], wup, tp_cell_col(mx, content_x(ws, collapsed), tst[ST_COLS]), tp_cell_row(my, WS_TOP + HEADER_H, tst[ST_ROWS]), wkeys[0..40]);
                        if (wn > 0 and tlink == PANE_LIVE) {
                            if (client_keys(tfd, tpid, wkeys[0 .. @as(usize, wn)], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                        }
                    }
                }
                tsince = 0;
                used = true;
            }
            if (ty == EV_SCROLL and dp and on_panel(mx, my, sw, WS_TOP)) {
                // D. the panel scrolls a row per 24 pt of wheel or trackpad travel
                var dy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { dy = dy * 16.0; }
                dacc = dacc + dy;
                while (dacc >= 24.0) {
                    doff = doc_scroll(@as(i64, doff) - 1, @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
                    dacc = dacc - 24.0;
                }
                while (dacc <= -24.0) {
                    doff = doc_scroll(@as(i64, doff) + 1, @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
                    dacc = dacc + 24.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and tpg and tpk == PAGE_KANBAN and on_home_view(mx, my, ws, collapsed)) {
                // K. the wheel scrolls every column of the board by cards
                var kdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { kdy = kdy * 16.0; }
                hacc = hacc + kdy;
                while (hacc >= 40.0) {
                    kanban_scroll(tgv[0..128], tbv[0..49152], home_view_h(sh), 0 - 1);
                    hacc = hacc - 40.0;
                }
                while (hacc <= -40.0) {
                    kanban_scroll(tgv[0..128], tbv[0..49152], home_view_h(sh), 1);
                    hacc = hacc + 40.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and tpg == false and hscreen and dcv[D_LIVE] == 0 and on_home_view(mx, my, ws, collapsed) and ((qp or kyp or dp) and on_panel(mx, my, sw, WS_TOP)) == false) {
                // H. a home tab's page scrolls with the wheel or trackpad; the offset stays between the top and the end
                var hdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { hdy = hdy * 16.0; }
                hacc = hacc + hdy;
                const hwhole : i64 = @as(i64, @intFromFloat(hacc));
                hacc = hacc - @as(f64, @floatFromInt(hwhole));
                hs = dash_scroll_clamp(hs, 0 - hwhole, dash_total_p(hh, sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
                used = true;
            }
            if (ty == EV_KEY_DOWN) {
                const key : u64 = msg0(ev, s_key);
                const flags : u64 = msg0(ev, s_flags);
                const cmd : bool = has_mod(flags, MOD_COMMAND);
                const digit : u32 = digit_of(key);
                const kp : u32 = petal_for_key(digit, flags);
                used = true;
                if (tpg and tpk == PAGE_BENCH and tgv[TPG_BA_FS] != 0 and cmd == false) {
                    // B. the FLASH dialogue owns the keyboard: characters fill the .bit path, Backspace erases, Return asks for the confirm, Escape cancels
                    if (key == KEY_ESCAPE) {
                        bench_key(tgv[0..128], tbv[0..49152], FE_ESCAPE, 0);
                    } else if (key == TG_KEY_RETURN) {
                        bench_key(tgv[0..128], tbv[0..49152], FE_RETURN, 0);
                    } else if (key == TG_KEY_BACKSPACE) {
                        bench_key(tgv[0..128], tbv[0..49152], TG_EV_BACK, 0);
                    } else {
                        const bc : u64 = msg0(ev, s_chars);
                        var bk : u64 = 0;
                        if (bc != 0) { bk = dk_len(dk, bc); }
                        var bj : u64 = 0;
                        while (bj < bk) {
                            bench_key(tgv[0..128], tbv[0..49152], TG_EV_CHAR, @as(u32, @intCast(msg_char(bc, s_char_at, bj) & 65535)));
                            bj = bj + 1;
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0 and cmd == false) {
                    // the ADD panel owns the keyboard: letters filter the gallery, Backspace erases, Escape closes
                    if (key == KEY_ESCAPE) {
                        dcv[D_ADDP] = 0;
                    } else if (key == 51) {
                        dcv[D_ADDN] = @as(u64, query_pop(@as(u32, @intCast(dcv[D_ADDN]))));
                    } else {
                        const qc : u64 = msg0(ev, s_chars);
                        var qk : u64 = 0;
                        if (qc != 0) { qk = dk_len(dk, qc); }
                        var qj : u64 = 0;
                        while (qj < qk) {
                            const qch : u32 = @as(u32, @intCast(msg_char(qc, s_char_at, qj) & 65535));
                            dcv[D_ADDN] = @as(u64, query_push(pbuf[PB_QUERY .. PB_QUERY + 32], @as(u32, @intCast(dcv[D_ADDN])), qch));
                            qj = qj + 1;
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] != 0 and key != KEY_ESCAPE and cmd == false) {
                    // the live page owns the keyboard; Escape closes it
                    used = false;
                } else if (hscreen and dcv[D_LIVE] != 0 and key == KEY_ESCAPE) {
                    live_hide(dcv[0..512]);
                } else if (key == KEY_J and cmd) {
                    // Q. Cmd+J opens or closes the Queen panel anywhere; with GOD MODE on it stops it
                    const r : u32 = on_queen_key(qp, god);
                    if (god) { ctl = C_GOD_OFF; } else { ctl = C_QUEEN_KEY; }
                    qp = r % 2 == 1;
                    if (qp) { kyp = false; }
                    god = r / 2 % 2 == 1;
                } else if (kyp and kedit != KY_NONE and qp == false and dp == false) {
                    // K. a key is being typed: Return saves it to the Keychain, Esc cancels, Cmd+V pastes
                    const kk : u32 = ky_key(@as(u32, @intCast(key)), cmd);
                    if (kk == KE_CANCEL) {
                        keys_wipe(kbuf[0..256]);
                        kedit = KY_NONE;
                        klen = 0;
                    } else if (kk == KE_BACK) {
                        if (klen > 0) {
                            klen = klen - 1;
                            kbuf[@as(usize, klen)] = 0;
                        }
                    } else if (kk == KE_SAVE) {
                        if (sec_key_safe(kbuf[0 .. @as(usize, klen)])) {
                            // the key takes the lowest free number of its provider, never an existing one
                            const ksn : u32 = next_free_key(kstored[kedit]);
                            if (ksn < MAX_KEYS) {
                                if (kc_put_n(kedit, ksn, kbuf[0 .. @as(usize, klen)])) {
                                    kst[key_index(kedit, ksn)] = ST_STORED;
                                    kfail[kedit] = 0;
                                    if (tfd >= 0) { client_set_key(tfd, setkey_byte(kedit, ksn), kbuf[0 .. @as(usize, klen)], tout[0..4100]); }
                                }
                            }
                            keys_wipe(kbuf[0..256]);
                            keys_refresh(kstored[0..9], kmask[0..144], kmlen[0..9]);
                            kedit = KY_NONE;
                            klen = 0;
                        }
                    } else if (kk == KE_PASTE) {
                        const pb : u64 = msg0(cls("NSPasteboard"), sel("generalPasteboard"));
                        const ps : u64 = msg1(pb, sel("stringForType:"), cf("public.utf8-plain-text"));
                        if (ps != 0) {
                            const pn : usize = ns_bytes(ps, ktmp[0..256]);
                            const tn : usize = trim_key(ktmp[0..pn], kbuf[0..256]);
                            klen = @as(u32, @intCast(tn));
                            if (klen > MAX_KEY_CHARS) { klen = MAX_KEY_CHARS; }
                            keys_wipe(ktmp[0..256]);
                        }
                    } else if (kk == KE_CHAR) {
                        const kc : u64 = msg0(ev, s_chars);
                        var kn : u64 = 0;
                        if (kc != 0) { kn = dk_len(dk, kc); }
                        var kj : u64 = 0;
                        while (kj < kn) {
                            const ch : u32 = @as(u32, @intCast(msg_char(kc, s_char_at, kj) & 65535));
                            if (ky_accepts(klen, ch)) {
                                kbuf[@as(usize, klen)] = @as(u8, @intCast(ch));
                                klen = klen + 1;
                            }
                            kj = kj + 1;
                        }
                    } else {
                        used = false;
                    }
                } else if (key == KEY_ESCAPE and god) {
                    god = false;
                    ctl = C_GOD_OFF;
                } else if (key == KEY_ESCAPE and dp) {
                    dp = false;
                    darmed = ARMED_NONE;
                } else if (key == KEY_ESCAPE and sst[SST_LVSEL] != LV_NONE and cmd == false) {
                    // L. Escape closes a lane's log view first
                    sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_ESC, 0);
                } else if (topen != PANE_NONE and cmd == false and screen) {
                    // T. the terminal pane takes every key without Cmd, Esc included, as bytes
                    const ctrl : bool = has_mod(flags, MOD_CONTROL);
                    var chs : u64 = msg0(ev, s_chars);
                    if (ctrl) { chs = msg0(ev, s_chars_raw); }
                    var cp : u32 = 0;
                    if (chs != 0 and dk_len(dk, chs) > 0) { cp = @as(u32, @intCast(msg_char(chs, s_char_at, 0) & 65535)); }
                    var kn : u32 = tp_key_bytes(@as(u32, @intCast(key)), cp, ctrl, tkey[0..8]);
                    // the editor view: Escape twice in a second closes it (esc_twice); the first still reaches the editor
                    if (topen == VIEW_EDITOR and key == KEY_ESCAPE) {
                        if (esc_twice(eesc, now)) {
                            eview = false;
                            eesc = 0;
                            kn = 0;
                        } else {
                            eesc = now;
                        }
                    }
                    if (kn > 0) {
                        vt_to_live(tst[0..32]);
                        if (tlink == PANE_LIVE) {
                            if (client_keys(tfd, tpid, tkey[0 .. @as(usize, kn)], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                        } else {
                            const en : u32 = tp_echo(tkey[0..8], kn, techo[0..8]);
                            var ei : u32 = 0;
                            while (ei < en) { vt_feed(tst[0..32], tcells[0..960000], techo[ei]); ei = ei + 1; }
                        }
                    }
                    tsince = 0;
                } else if (key == KEY_ESCAPE) {
                    state = on_back(state);
                } else if (cmd and digit == 0) {
                    state = on_back(state);
                } else if (kp != PETAL_NONE and menu_open(state) == false) {
                    state = kp;
                    shown = kp;
                    cons2 = tap_cons(kp, false);
                } else if (agents_key(key, flags) and menu_open(state) == false) {
                    // Cmd+Enter at home: the agents dialog
                    state = PETAL_CHAT;
                    shown = PETAL_CHAT;
                    cons2 = false;
                } else if (key == KEY_S and cmd and has_mod(flags, MOD_SHIFT)) {
                    collapsed = collapsed == false;
                } else if (key == KEY_F and cmd and has_mod(flags, MOD_CONTROL)) {
                    msg1(win, s_full, 0);
                } else {
                    used = false;
                }
            }
            // Q. every control the user pressed goes into the ring the Queen reads
            if (ctl != C_NONE) {
                ring[ring_next(evn)] = ev_pack(view_of(menu_open(state), shown), ctl, carg, now);
                evn = evn + 1;
                last_user = now;
                if (ctl != C_DISMISS) { dismissed = RING_NONE; }
            }
            if (used == false) { msg1(app, s_send, ev); }
            ev = msg_event(app, s_next, 0xffffffffffffffff, 0, mode, true);
        }
        // H. another home starts at its top; a resized window holds the offset inside its page
        if (shown != hs_for) {
            live_hide(dcv[0..512]);
            hs = 0;
            hacc = 0.0;
            hs_for = shown;
            tgv[TPG_DASH] = 0;
            tgv[TPG_K_DRAG] = 0;
            tgv[TPG_BA_FS] = 0;
            dcv[D_ADDP] = 0;
            dcv[D_ADDN] = 0;
            dcv[D_PINN] = @as(u64, pins_load(dhb[0..dhn], letter_of_petal(shown), pbuf[0..4160]));
            dcv[D_PINLET] = @as(u64, letter_of_petal(shown));
        }
        hs = dash_scroll_clamp(hs, 0, dash_total_p(letter_of_petal(shown), sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
        if (menu_open(state) == false) { cons2 = false; }
        if (dcv[D_LIVE] != 0 and (menu_open(state) == false or (shown == PETAL_CHAT and cons2 == false))) { live_hide(dcv[0..512]); }
        // B / K / Q. the tool pages' host feeds: reap finished jobs every frame, start a refresh while the page is open
        const tpk2 : u32 = page_kind(letter_of_petal(shown));
        const open2 : bool = menu_open(state) and ma >= 0.5 and shown != PETAL_CHAT and tgv[TPG_DASH] == 0 and dcv[D_LIVE] == 0;
        if (open2 and tpk2 == PAGE_QUEEN) {
            tgv[TPG_Q_GOD] = 0;
            if (god) { tgv[TPG_Q_GOD] = 1; }
            tgv[TPG_Q_EVFL] = @as(u64, evfl);
            tgv[TPG_Q_EVN] = @as(u64, evn);
            var tqm : u32 = 0;
            var tqp : u32 = 0;
            while (tqp < PROVIDER_COUNT) {
                if (kstored[tqp] != 0) { tqm = tqm + (1 << tqp); }
                tqp = tqp + 1;
            }
            tgv[TPG_Q_TIER] = @as(u64, tier_of(tqm));
            tgv[TPG_Q_UNASS] = @as(u64, qb_nm());
            if (dcv[D_GN] > 0) { tgv[TPG_Q_UNASS] = @as(u64, gal_unassigned(gt[0..2560])); }
            var tqr : u32 = 0;
            while (tqr < RING) {
                tgv[TPG_Q_RING + tqr] = ring[tqr];
                tqr = tqr + 1;
            }
            tgv[TPG_Q_ROOTLEN] = @as(u64, qn_root(dk, space, tbv[0..49152]));
        }
        bench_tick(tgv[0..128], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_BENCH);
        kanban_tick(tgv[0..128], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_KANBAN);
        queen_tick(tgv[0..128], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_QUEEN);
        update_tick(tgv[0..128], tbv[0..49152], dhb[0..dhn], ubp[0..ubn], now, up_busy(sst[0..560]));
        // L. the LANES block of the chat sidebar: the feed job, the tail of a clicked lane, the table once a second
        const lvup : bool = menu_open(state) and ma >= 0.5 and shown == PETAL_CHAT and cons2 == false and ws == WS_EXPANDED and collapsed == false;
        if (lvcur != cur) { sst[SST_LVSEL] = LV_NONE; }
        lvtail = 0;
        if (lvup and sst[SST_LVSEL] != LV_NONE and sst[SST_LVKEY] == LV_SCRIPT) { lvtail = sst[SST_LVKEY + 1]; }
        lanes_tick(tgv[0..128], tbv[0..65536], dhb[0..dhn], now, lvup, lvtail);
        sst[SST_LVTAIL] = @as(u32, @intCast(tgv[TPG_L_TLEN]));
        if (lvup and now != lvat) {
            lvat = now;
            lanes_build(sst[0..560], tbv[0..65536], tgv[0..128], ss, space, god, @as(u32, @intCast(now)));
        }
        if (menu_open(state) and (shown != PETAL_CHAT or cons2)) {
            dash_tick(dcv[0..512], gal[0..49152], gt[0..2560], dhb[0..dhn], jpid[0..6], jwi[0..6], now);
            thumbs_load(dcv[0..512], gal[0..49152], gt[0..2560], dhb[0..dhn]);
            if (dcv[D_WEB] != 0) {
                const wcx : f64 = content_x(home_ws(ws), collapsed);
                const wvt : f64 = home_view_top();
                const wsc : f64 = fit(fr[2], fr[3], sw, sh);
                msg_rect(dcv[D_WEB], sel("setFrame:"), view_x(live_x(wcx), fr[2], sw, wsc), view_y(live_y(wvt), live_h(sh, wvt), fr[3], sh, wsc), live_w(sw, wcx) * wsc, live_h(sh, wvt) * wsc);
            }
        }
        // K. a check button: the frame after the click shows "checking", then one number of the provider is
        // read and probed per frame (a probe blocks up to PROBE_TIMEOUT_S); its HTTP answer sets that key's status
        // and feeds the circuit breaker (keys.t27). Every stored key of the provider is checked, none is skipped.
        if (kbusy != KY_NONE) {
            if (kpend == 0) {
                kpend = 1;
            } else if (kbk >= MAX_KEYS) {
                kbusy = KY_NONE;
                kpend = KY_NONE;
                kbk = 0;
            } else {
                const kn2 : usize = kc_get_n(kbusy, kbk, ktmp[0..256]);
                if (kn2 > 0) {
                    const http : u32 = probe(kbusy, ktmp[0 .. kn2]);
                    const kix : usize = key_index(kbusy, kbk);
                    kfail[kbusy] = circuit_fails(kfail[kbusy], http);
                    if (kfail[kbusy] >= CIRCUIT_FAILS and kopen[kbusy] + 60 <= now) { kopen[kbusy] = now; }
                    kst[kix] = status_after_probe(kst[kix], http);
                    // M12: a key that failed its check is withheld from the server, so rotation skips it and the
                    // next claude pane takes the next profile when none is left (keys.t27 pick_profile); a key
                    // that passed is handed over again
                    if (tfd >= 0) {
                        if (key_withheld(kst[kix])) {
                            client_set_key(tfd, setkey_byte(kbusy, kbk), "", tout[0..4100]);
                        } else {
                            client_set_key(tfd, setkey_byte(kbusy, kbk), ktmp[0 .. kn2], tout[0..4100]);
                        }
                    }
                }
                keys_wipe(ktmp[0..256]);
                kbk = kbk + 1;
            }
        }
        // K. pre-flight (M12): once at start, check the stored key behind each claude profile, in the order
        // keys.t27 PROFILE_PROVIDER gives (all PROFILE_COUNT of them), so the first pane already avoids a dead key
        if (kbusy == KY_NONE and kpre < PROFILE_COUNT) {
            const kpp : u32 = PROFILE_PROVIDER[kpre];
            kpre = kpre + 1;
            if (probe_has(kpp) and kc_has(kpp)) {
                kbusy = kpp;
                kbk = 0;
                kpend = 0;
            }
        }
        // D. the walk: a slice of folders per frame; a finished pass forgets what it did not see, then rests
        if (walking) {
            qhead = dk_walk(dk, qhead, wpass);
            if (qhead >= dk_count(dk, dk[DK_QUEUE])) {
                if (dk_sweep(dk, wpass) > 0) { darmed = ARMED_NONE; }
                walking = false;
                qhead = 0;
                widle = 0;
                dnow = true;
            }
        } else {
            widle = widle + 1;
            if (pass_due(widle)) {
                wpass = wpass + 1;
                dk_start_pass(dk);
                walking = true;
            }
        }
        // D. the checks: JOB_SLOTS git / du jobs at a time, each repository in turn, then a rest
        var js : u64 = 0;
        while (js < @as(u64, JOB_SLOTS)) {
            const jt : u64 = dk_at(dk, dk[DK_TASKS], js);
            if (jt != dk[DK_NULL]) {
                if (msg0(jt, dk[DK_RUNNING]) % 256 == 0) {
                    dk_take(dk, js, msg0(jt, dk[DK_STATUS]) % 4294967296);
                    msg2(dk[DK_TASKS], dk[DK_REPLACE], js, dk[DK_NULL]);
                    dnow = true;
                }
            } else if (jrest == 0 and dk_count(dk, dk[DK_PATHS]) > 0) {
                if (jr >= dk_count(dk, dk[DK_PATHS])) {
                    jr = 0;
                    jj = 0;
                    jpass = jpass + 1;
                    jrest = RESCAN_FRAMES;
                } else {
                    while (jj < JOB_COUNT and job_due(jj, jpass) == false) { jj = jj + 1; }
                    if (jj < JOB_COUNT) {
                        const nt : u64 = dk_launch(dk, js, dk_at(dk, dk[DK_PATHS], jr), jj);
                        if (nt != 0) {
                            msg2(dk[DK_TASKS], dk[DK_REPLACE], js, nt);
                            msg0(nt, dk[DK_RELEASE]);
                        }
                        jj = jj + 1;
                    }
                    if (jj >= JOB_COUNT) {
                        jj = 0;
                        jr = jr + 1;
                    }
                }
            }
            js = js + 1;
        }
        if (jrest > 0) { jrest = jrest - 1; }
        // D. a deleted clone or worktree vanishes within a lap: one repository's .git checked per frame
        const vn : u64 = dk_count(dk, dk[DK_PATHS]);
        if (vn > 0) {
            if (vr >= vn) { vr = 0; }
            if (dk_exists(dk, msg1(dk_at(dk, dk[DK_PATHS], vr), dk[DK_APPEND_PATH], dk[DK_GIT])) == false) {
                dk_drop(dk, vr);
                darmed = ARMED_NONE;
                dnow = true;
            } else {
                vr = vr + 1;
            }
        }
        // D. the sums, the panel rows and the sidebar slots, every DOC_SUM_EVERY frames or when something moved
        if (dnow or frame % DOC_SUM_EVERY == 0) {
            dgo = dk_recompute(dk);
            var bsl : u32 = 0;
            while (bsl < SPACE_COUNT) {
                const bound : bool = dk_len(dk, dk_at(dk, dk[DK_SLOTS], @as(u64, bsl))) > 0;
                if (space_is_open(sp, bsl) == false and bound) {
                    msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, bsl), dk[DK_EMPTY]);
                } else if (space_is_open(sp, bsl) and bound == false) {
                    dk_bind(dk, bsl, RANK_AUTO);
                }
                bsl = bsl + 1;
            }
            var more : bool = auto_open;
            while (more and spaces_shown(sp) < SPACES_AUTO and new_space(sp) != SPACE_NONE) {
                const ns : u32 = new_space(sp);
                if (dk_bind(dk, ns, RANK_AUTO)) { sp = add_space(sp, ns); } else { more = false; }
            }
            dk_names(dk, kit[K_SPACE_NAMES], kit[K_BRANCHES]);
            msg2(defs, dk[DK_SET_OBJ], dk[DK_SLOTS], k_slots);
            msg2(defs, dk[DK_SET_OBJ], dk[DK_HIDDEN], k_hidden);
            dnow = false;
        }
        if (qp) { dp = false; }
        doff = doc_scroll(@as(i64, doff), @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
        var dlabel : u64 = dk_word(dk, DL_TITLE);
        if (dgo > 0) { dlabel = dk_cat(dk, dk_word(dk, DL_FOOT), dk_int(dk, @as(u64, dgo))); }
        // T. the terminal pane: a Claude Code chat on screen opens it in its space's folder (home when
        // the space is unbound); a new chat or a new size starts the grid over and replays the pane's
        // output from the server's ring; an offline pane tries the server again every TP_RETRY frames.
        // The same code shows the editor pane when the strip's "T27 OS" chip opened one (view_key): `want` is
        // the chat index, VIEW_EDITOR or nothing; the editor view ends when the screen leaves its chat or space.
        // T. the pane server starts itself: if ~/.t27os/pty.sock does not answer, the t27os-pty next to the app is started
        // by one backgrounded `sh -c` job (it outlives the app: the app never stops it, it owns the panes' history)
        if (srvpid != 0 and tg_done(srvpid) != 0) { srvpid = 0; }
        if (screen) {
            srvw = srvw + 1;
            if (tfd < 0 and srvp != SRV_FAILED and srvw % TP_START_POLL == 1) { tfd = term_connect(thome[0..256]); }
            var snp : u32 = tp_server_step(srvp, tfd >= 0, srvw);
            if (srvretry) {
                srvretry = false;
                srvp = SRV_FAILED;
                snp = SRV_STARTING;
            }
            if (tp_server_spawn_due(srvp, snp)) {
                srvw = 0;
                var exeb : [512]u8 = undefined;
                const exn : usize = ns_bytes(msg0(msg0(cls("NSBundle"), sel("mainBundle")), sel("executablePath")), exeb[0..512]);
                var scmd : [700]u8 = undefined;
                const sk : usize = tp_server_cmd(exeb[0..exn], scmd[0..700]);
                if (sk == 0) {
                    snp = SRV_FAILED;
                } else {
                    var se : usize = tg_head(tbv[0..65536], dhb[0..dhn], FEED_HEAD_A, TP_SRV_HEAD_B);
                    se = put_bytes(tbv[0..65536], se, scmd[0..sk]);
                    srvpid = tg_spawn(tbv[0..65536], TBO_CMD, se);
                    if (srvpid == 0) { snp = SRV_FAILED; }
                }
            }
            if (snp == SRV_UP and srvp != SRV_UP) { ttry = TP_RETRY; }
            srvp = snp;
        }
        sst[SST_SRV] = srvp;
        if (editor_view_stays(eview, screen, cur, ecur, space, esp) == false) { eview = false; }
        const want : u32 = view_key(eview, cur != SESSION_NONE and opens_pane(session_agent(ss, cur)), cur);
        if (screen and want != PANE_NONE) {
            const toy : f64 = WS_TOP + HEADER_H;
            // the grid ends at the left edge of an open right-hand panel: the pty gets the narrower size
            // through the resize below, and nothing of the terminal is under the panel
            const tw : f64 = content_w(sw, ws, collapsed, qp or dp or kyp);
            const th : f64 = sh - toy;
            // a drag changes the size every frame: the pane takes it once it has held TP_SETTLE frames, so
            // the grid and the ring replay run once per resize instead of once per frame
            tstable = tp_settle(tstable, tp_cols(tw) == twc and tp_rows(th) == twr);
            twc = tp_cols(tw);
            twr = tp_rows(th);
            var tgo : bool = tp_reset_due(topen, want) or tp_size_due(tst[ST_COLS], tst[ST_ROWS], tw, th, tstable);
            if (tlink == PANE_OFFLINE and topen == want) {
                ttry = ttry + 1;
                if (tp_retry_due(ttry)) {
                    ttry = 0;
                    if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                    if (tfd >= 0) { tgo = true; }
                }
            }
            if (tgo) {
                vt_init(tst[0..32], tcells[0..960000], tp_cols(tw), tp_rows(th));
                tcursor = 0;
                var tsp : u32 = espace;
                if (want != VIEW_EDITOR) { tsp = session_space(ss, cur); }
                var tcwd : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, tsp));
                if (dk_len(dk, tcwd) == 0) { tcwd = home_dir(); }
                if (topen != want or tlink != PANE_LIVE) {
                    tpid = PANE_NONE;
                    if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                    if (tfd >= 0) {
                        if (want == VIEW_EDITOR) { tpid = epane; } else { tpid = term_open(tfd, ss, cur, tcwd, tout[0..4100], tdir[0..512]); }
                    }
                    if (tpid != PANE_NONE and client_attach(tfd, tpid, tout[0..4100]) == 0) { tpid = PANE_NONE; }
                    if (tpid == PANE_NONE) { tlink = PANE_OFFLINE; } else { tlink = PANE_LIVE; }
                    // the editor pane is gone (the server restarted, or it was killed): back to the chat
                    if (tpid == PANE_NONE and want == VIEW_EDITOR) {
                        eview = false;
                        epane = PANE_NONE;
                    }
                    if (tpid == PANE_NONE and tfd >= 0) {
                        sys_close(tfd);
                        tfd = -1;
                    }
                }
                // the pty takes the new grid before the replay, so the program redraws at the full width
                if (tlink == PANE_LIVE) { client_resize(tfd, tpid, tst[ST_COLS], tst[ST_ROWS], tout[0..4100]); }
                if (tlink == PANE_OFFLINE) { term_banner(tst[0..32], tcells[0..960000], tcwd); }
                topen = want;
                tsince = 0;
                ttry = 0;
                tfed = tfed + 1;
            }
            if (tlink == PANE_LIVE) {
                var treads : u32 = 0;
                var tmore : bool = true;
                while (tmore) {
                    const rn : usize = client_read(tfd, tpid, tcursor, tout[0..4100]);
                    if (rn == 0) {
                        // the server went away: drop the socket; the retry finds it again after a restart
                        tmore = false;
                        tlink = PANE_OFFLINE;
                        sys_close(tfd);
                        tfd = -1;
                    } else {
                        const dn : usize = tp_data_len(tout[0..4100], rn);
                        if (dn > 0) {
                            tcursor = reply_cursor(tout[0..4100]);
                            tfed = tfed + 1;
                        }
                        var gi : usize = 0;
                        while (gi < dn) { vt_feed(tst[0..32], tcells[0..960000], tout[TP_DATA_AT + gi]); gi = gi + 1; }
                        treads = treads + 1;
                        tmore = tp_read_more(dn, treads);
                    }
                }
            }
            // a line asked for by CREATE NEW, a command or a skill widget is typed into the commander once the pane is live
            // (not sent: the user finishes it and presses Return)
            if (dcv[D_PREN] > 0 and tlink == PANE_LIVE and topen == want) {
                if (client_keys(tfd, tpid, pbuf[PB_PRE .. PB_PRE + @as(usize, dcv[D_PREN])], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                dcv[D_PREN] = 0;
            }
        } else {
            topen = PANE_NONE;
        }
        // the rows of the agents dialog show the state the server lists (pane state, live flag), refreshed twice a second
        if (tfd >= 0 and frame % 15 == 0) {
            const sln : usize = client_list(tfd, tout[0..4100]);
            var sj : u32 = 0;
            while (sj < 32 and sj < session_count(ss)) {
                sst[sj] = tp_state_of(tout[0..4100], sln, session_agent(ss, sj), tp_ordinal(ss, sj));
                sj = sj + 1;
            }
        }
        if (tsince < 999) { tsince = tsince + 1; }
        tcur = tp_cursor_on(frame, tsince);
        // Q. GOD MODE: with the panel open and the user still, the Queen runs her suggestion herself
        sug = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        if (god_due(god, qp, sug, now, last_user, last_act)) {
            const qc : u32 = queen_control(sug);
            cur = act_cur(ss, sug, space, cur);
            ss = act_sessions(ss, sug, space);
            var qa : u32 = 0;
            if (cur != SESSION_NONE) { task = session_agent(ss, cur); qa = task; }
            // the editor suggestion: GOD MODE opens this space's folder inside, once for the space (edit_mark),
            // so she does not reopen it every GOD_WAIT seconds; the log names the space
            if (sug == A_EDIT) {
                iedit = IE_GOD;
                edone = edit_mark(edone, space);
                qa = space;
            }
            ring[ring_next(evn)] = ev_pack(view_of(menu_open(state), shown), qc, qa, now);
            evn = evn + 1;
            last_act = now;
            sug = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        }
        // G. GOD MODE runs the evolve rule: with the panel open and nothing else suggested, its next action shows on the
        // strip (Confirm / Dismiss as for every suggestion) and is logged as hers once (C_QUEEN_STARTED / C_QUEEN_ASKED)
        if (god and qp and sug == A_NONE) {
            if (evd == 0) {
                // the key master decides first: no usable profile turns a task into an owner request (keys.t27 profiles)
                var evstored : u32 = 0;
                var evbad : u32 = 0;
                var ep : u32 = 0;
                while (ep < PROVIDER_COUNT) {
                    if (kstored[ep] != 0) { evstored = evstored + (1 << ep); }
                    ep = ep + 1;
                }
                ep = 0;
                while (ep < PROFILE_COUNT) {
                    const pv : u32 = PROFILE_PROVIDER[ep];
                    if (circuit_open(kfail[pv], kopen[pv], now)) { evbad = evbad + (1 << ep); }
                    ep = ep + 1;
                }
                evd = lane_gate(evolve_next(evfl, evst, gal_unassigned(gt[0..2560])), evstored, evbad);
                evpr = lane_profile(evstored, evbad);
                if (evd != 0) {
                    ring[ring_next(evn)] = log_event(evd, now);
                    evn = evn + 1;
                }
            }
        } else {
            evd = 0;
        }
        // E. the editor opens inside in one place, whoever asked: the strip's "T27 OS" chip or a confirmed A_EDIT
        // (IE_USER), or GOD MODE (IE_GOD). open_target keeps it inside; the editor pane takes the terminal area
        // on the next frame (view_key), on the folder of the space on screen (home when it is unbound).
        if (iedit != IE_NONE) {
            const itg : u32 = open_target(iedit == IE_GOD, ktpick != TERM_NONE, kemask != 0);
            var idirs : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
            if (dk_len(dk, idirs) == 0) { idirs = home_dir(); }
            const ihn : usize = ns_bytes(home_dir(), khome[0..256]);
            const idn : usize = ns_bytes(idirs, kdir[0..512]);
            edone = edit_mark(edone, space);
            if (itg == OT_INSIDE) {
                if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                var iep : u32 = PANE_NONE;
                if (tfd >= 0) { iep = edit_open(tfd, epane, espace, space, ktpick, kdir[0..idn], tout[0..4100]); }
                epane = iep;
                espace = space;
                kewhy = OPEN_OK;
                if (epane == PANE_NONE) {
                    kewhy = OPEN_SPAWN_FAILED;
                } else {
                    eview = true;
                    ecur = cur;
                    esp = space;
                    eesc = 0;
                    kyp = false;
                }
            } else if (itg == OT_OUTSIDE) {
                kewhy = open_in_editor(nth_installed(kemask, 0), khome[0..ihn], kdir[0..idn]);
            }
            iedit = IE_NONE;
        }
        // the animation clocks run on real time (frame_gate.t27 fg_ticks): the same 0.25 s at 30 or 60 redraws a second
        const a_now : f64 = abs_time();
        const a_k : f64 = fg_ticks(a_now - a_last);
        a_last = a_now;
        ma = wave_k(ma, menu_open(state), a_k);
        glow = glow_level_k(glow, glow_on(god), a_k);
        a_acc = a_acc + a_k;
        const a_whole : u32 = fg_whole(a_acc);
        a_acc = a_acc - @as(f64, @floatFromInt(a_whole));
        a_frames = a_whole;
        var hov : u32 = PETAL_NONE;
        if (home_live) { hov = hit_px(vx, vy, 960, 540); }
        if (home_live and hov == PETAL_NONE and centre_hit(to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc))) { hov = PETAL_CENTRE; }
        var on_control : bool = on_home_button(mx, my, sw) or on_full_button(mx, my, sw) or on_dock_button(mx, my, sw);
        if (hscreen and on_nav_back(mx, my, full)) { on_control = true; }
        if (screen and (on_nav_back(mx, my, full) or on_side_toggle(mx, my, ws, collapsed))) { on_control = true; }
        if (screen and (on_open_dash(mx, my, sw, ws) or on_close_dash(mx, my, ws, collapsed))) { on_control = true; }
        if (hscreen and (on_side_toggle(mx, my, sws, collapsed) or on_repo_link(mx, my, sh, sws, collapsed) or on_doctor_link(mx, my, sh, sws, collapsed))) { on_control = true; }
        if (hscreen and ma >= 1.0 and in_side(mx, home_ws(ws), collapsed) and sec_at(mx, my, WS_TOP) != SEC_NONE) { on_control = true; }
        if ((screen or (hscreen and shown == PETAL_CHAT)) and ma >= 1.0 and on_switch(mx, my, sw, WS_TOP)) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] == 0 and hit_class(dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160]))) != HC_SURFACE and dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160])) != HIT_NONE) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] != 0 and on_live_back(mx, my, content_x(home_ws(ws), collapsed), home_view_top())) { on_control = true; }
        if (screen and ma >= 1.0 and card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed) != CARD_SLOTS) { on_control = true; }
        if (screen and ma >= 1.0 and in_side(mx, ws, collapsed) and (row_at(WS_TOP, GROUP_QUEEN, spaces_shown(sp), 1, my) == 0 or row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my) != ROW_NONE or row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my) != ROW_NONE)) { on_control = true; }
        if (screen and on_new_chat(mx, my, sw, ws)) { on_control = true; }
        if (screen and (on_repo_link(mx, my, sh, ws, collapsed) or (in_side(mx, ws, collapsed) and on_space_plus(mx, my) and new_space(sp) != SPACE_NONE))) { on_control = true; }
        if (screen and on_doctor_link(mx, my, sh, ws, collapsed)) { on_control = true; }
        if ((screen or hscreen) and on_update_strip(mx, my, sh, sws, collapsed, strip_kind(@as(u8, @intCast(tgv[TPG_U_ST])), @as(u8, @intCast(tgv[TPG_U_WHY]))) != STRIP_HIDDEN and tgv[TPG_U_ON] != 0)) { on_control = true; }
        if (dp and (on_panel_close(mx, my, sw, WS_TOP) or dk_btn_at(dk, mx, my, sw, sh, doff) != NS_NOT_FOUND)) { on_control = true; }
        if (qp and (on_panel_close(mx, my, sw, WS_TOP) or on_god(mx, my, sw, WS_TOP) or ((sug != A_NONE or evd != 0) and (on_confirm(mx, my, sw, WS_TOP) or on_dismiss(mx, my, sw, WS_TOP))))) { on_control = true; }
        if (hov != PETAL_NONE or on_control) { msg0(hand, s_cursor_set); } else { msg0(arrow, s_cursor_set); }
        // U. the frame gate: fold what this frame shows into a key; an unchanged key with nothing
        // animating keeps the image already on the layer (frame_gate.t27)
        var fk : u64 = fg_mix(fg_mix(fg_mix(fg_mix(0, @as(u64, state)), @as(u64, hov)), fg_level(ma)), @as(u64, shown));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, task)), @as(u64, space)), @as(u64, sp)), ss);
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, cur)), fg_flag(collapsed)), fg_mouse(mx, sw)), fg_mouse(my, sh));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, fg_cell(sw)), fg_cell(sh)), @as(u64, ws)), fg_flag(full));
        fk = fg_mix(fg_mix(fg_mix(fk, fg_flag(qp)), @as(u64, evn)), @as(u64, sug));
        fk = fg_mix(fg_mix(fk, @as(u64, evd)), @as(u64, evp));
        fk = fg_mix(fg_mix(fk, @as(u64, hs)), fg_flag(cons2));
        fk = fg_mix(fg_mix(fg_mix(fk, dcv[D_GEN]), dcv[D_DEFER]), dcv[D_LIVE]);
        fk = fg_mix(fg_mix(fg_mix(fk, tgv[TPG_GEN]), fg_flag(open2)), tgv[TPG_DASH]);
        if (open2) { fk = fg_mix(fk, now); }
        const tbusy : bool = tgv[TPG_BN_PID] != 0 or tgv[TPG_BA_PID] != 0 or tgv[TPG_K_PID] != 0 or tgv[TPG_Q_PID] != 0;
        // the clock shows only in the queen panel's ages; outside it a ticking second must not count as a change
        if (qp) { fk = fg_mix(fk, now); }
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, fg_flag(god)), fg_level(glow)), fg_flag(dp)), @as(u64, darmed));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, doff)), @as(u64, dgo)), fg_flag(walking));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, topen)), fg_flag(tcur and topen != PANE_NONE)), tfed), fg_flag(narrow));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, tst[ST_X])), @as(u64, tst[ST_Y])), @as(u64, tst[ST_COLS] * 1000 + tst[ST_ROWS]));
        fk = fg_mix(fg_mix(fk, @as(u64, tst[ST_GEN])), @as(u64, vt_view(tst[0..32])));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, sst[SST_LVOFF])), @as(u64, sst[SST_LVSEL])), lvat);
        fk = fg_mix(fk, @as(u64, sst[SST_LVTAIL]));
        // the doctor's table and its label (a new string each frame while checks run) only show in its panel;
        // with the panel shut, the background walk does not wake the draw
        if (dp) {
            fk = fg_mix(fk, dlabel);
            var fki : usize = 0;
            while (fki < 128) {
                fk = fg_mix(fk, dk[fki]);
                fki = fki + 1;
            }
        }
        // the home logo flies in for ANIM_FRAMES, the menu waves open and shut, the GOD MODE edge glows
        const fanim : bool = frame < ANIM_FRAMES or (ma > 0.0 and ma < 1.0) or glow > 0.0;
        const fdraw : bool = fg_draw_due(fk, fshown, fanim, fsince);
        fquiet = fg_quiet(fquiet, fk != fshown or fanim or tbusy);
        fsince = fg_since(fsince, fdraw);
        fshown = fk;
        fwait = fg_wait_anim(fquiet, tlink == PANE_LIVE and topen != PANE_NONE, fanim, FRAME_S);
        msg_flag(tx_cls, s_quiet, true);
        if (fdraw and narrow) {
            draw(cc, kit, frame, state, hov, ma, shown, task, space, sp, ss, cur, collapsed, mx, my, z, sw, sh, ws, full, qp, ring, evn, now, sug, god, glow, dk, dp, darmed, doff, dgo, walking, dlabel, tst[0..32], tcells[0..960000], topen, tcur, kyp, kstored[0..9], kmask[0..144], kmlen[0..9], kst[0..72], kfail[0..9], kopen[0..9], kedit, kbuf[0..256], klen, karm, kbusy, kemask, kewhy, ktpick, hs, cons2, dcv[0..512], gal[0..49152], gt[0..2560], evd, @as(u64, evp) + @as(u64, evn2) * 1048576 + @as(u64, evpr) * 1099511627776, pbuf[0..4160], sst[0..560], tgv[0..128], tbv[0..65536]);
            const whole : u64 = cg_image(cc);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * RETINA, sh * RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        } else if (fdraw) {
            draw(c, kit, frame, state, hov, ma, shown, task, space, sp, ss, cur, collapsed, mx, my, z, sw, sh, ws, full, qp, ring, evn, now, sug, god, glow, dk, dp, darmed, doff, dgo, walking, dlabel, tst[0..32], tcells[0..960000], topen, tcur, kyp, kstored[0..9], kmask[0..144], kmlen[0..9], kst[0..72], kfail[0..9], kopen[0..9], kedit, kbuf[0..256], klen, karm, kbusy, kemask, kewhy, ktpick, hs, cons2, dcv[0..512], gal[0..49152], gt[0..2560], evd, @as(u64, evp) + @as(u64, evn2) * 1048576 + @as(u64, evpr) * 1099511627776, pbuf[0..4160], sst[0..560], tgv[0..128], tbv[0..65536]);
            const whole : u64 = cg_image(c);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * WIDE_RETINA, sh * WIDE_RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        }
        if (fdraw) { vt_clean(tst[0..32]); }
        // K. keep what the window shows: write it once a change has held still (window_keep.t27)
        const wk_fl : u64 = wk_flags(collapsed, dash, qp, god, dp, auto_open);
        const wk_k : u64 = fg_mix(wk_key(state, shown, task, space, ss, sp, cur, wk_fl, evn), @as(u64, hs));
        wk_n = wk_still(wk_n, wk_k, wk_last);
        wk_last = wk_k;
        if (frame == 0) { wk_saved = wk_k; }
        if (wk_due(wk_k, wk_saved, wk_n)) {
            msg2(defs, sel("setInteger:forKey:"), @as(u64, evn), k_evn);
            ri = 0;
            while (ri < RING) {
                msg2(defs, sel("setInteger:forKey:"), ring[ri], k_ev[ri]);
                ri = ri + 1;
            }
            msg2(defs, sel("setInteger:forKey:"), @as(u64, state), k_state);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, shown), k_shown);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, task), k_task);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, space), k_space);
            msg2(defs, sel("setInteger:forKey:"), ss, k_ss);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, sp), k_sp);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, cur), k_cur);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, hs), k_hs);
            msg2(defs, sel("setInteger:forKey:"), wk_fl, k_flags);
            msg2(defs, sel("setInteger:forKey:"), 1, k_kept);
            msg0(defs, sel("synchronize"));
            wk_saved = wk_k;
        }
        // R. a new binary from t27b + ld: wait until it is quiet, save the state, exec it
        if (reload_poll(frame)) {
            const now : u64 = msg0(msg2(files, s_attrs, exe, 0), s_mdate);
            const moved : bool = now == 0 or msg_test1(seen, s_same, now) == false;
            if (moved) {
                msg0(seen, sel("release"));
                seen = now;
                msg0(seen, sel("retain"));
            }
            waited = reload_wait(waited, moved);
            if (reload_due(waited) and seen != 0) {
                var fl : u64 = 0;
                if (collapsed) { fl = fl + 1; }
                if (dash) { fl = fl + 2; }
                if (qp) { fl = fl + 4; }
                if (god) { fl = fl + 8; }
                if (dp) { fl = fl + 16; }
                if (auto_open == false) { fl = fl + 32; }
                msg2(defs, sel("setInteger:forKey:"), @as(u64, evn), k_evn);
                ri = 0;
                while (ri < RING) {
                    msg2(defs, sel("setInteger:forKey:"), ring[ri], k_ev[ri]);
                    ri = ri + 1;
                }
                msg2(defs, sel("setInteger:forKey:"), @as(u64, state), k_state);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, shown), k_shown);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, task), k_task);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, space), k_space);
                msg2(defs, sel("setInteger:forKey:"), ss, k_ss);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, sp), k_sp);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, cur), k_cur);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, hs), k_hs);
                msg2(defs, sel("setInteger:forKey:"), fl, k_flags);
                msg2(defs, sel("setInteger:forKey:"), 1, k_hot);
                msg0(defs, sel("synchronize"));
                const path : u64 = msg0(exe, sel("UTF8String"));
                var argv : [2]u64 = undefined;
                argv[0] = path;
                argv[1] = 0;
                exec_self(path, argv);
                waited = RELOAD_IDLE;
            }
        }
        frame = frame + a_frames;
        pool_pop(pool);
    }
}

// ---- tests ----

test the_key_light_dot_has_one_colour_per_value_and_the_foot_is_the_worst {
    assert dot_visible(LIGHT_NONE) == false;
    assert dot_visible(LIGHT_GREEN);
    assert dot_visible(LIGHT_YELLOW);
    assert dot_visible(LIGHT_RED);
    assert dot_visible(9) == false;
    assert light_chan(LIGHT_GREEN, 1) > light_chan(LIGHT_GREEN, 0);
    assert light_chan(LIGHT_RED, 0) > light_chan(LIGHT_RED, 1);
    assert light_chan(LIGHT_YELLOW, 0) > light_chan(LIGHT_YELLOW, 2);
    assert light_chan(LIGHT_NONE, 0) == 0.0;
    // red > yellow > green; none never hides a light
    assert light_worse(LIGHT_GREEN, LIGHT_YELLOW) == LIGHT_YELLOW;
    assert light_worse(LIGHT_RED, LIGHT_YELLOW) == LIGHT_RED;
    assert light_worse(LIGHT_GREEN, LIGHT_RED) == LIGHT_RED;
    assert light_worse(LIGHT_NONE, LIGHT_GREEN) == LIGHT_GREEN;
    assert light_worse(LIGHT_YELLOW, LIGHT_NONE) == LIGHT_YELLOW;
    assert light_worse(LIGHT_NONE, LIGHT_NONE) == LIGHT_NONE;
    // an editor pane has no dot; the default adapters draw nothing
    assert dot_light(true, LIGHT_RED) == LIGHT_NONE;
    assert dot_light(false, LIGHT_RED) == LIGHT_RED;
    assert dot_light(false, 9) == LIGHT_NONE;
    assert pane_light_input(0) == LIGHT_NONE;
    assert foot_light_input() == LIGHT_NONE;
}

test the_screen_cross_fades_in_a_quarter_second {
    var a : f64 = 0.0;
    var i : u32 = 0;
    while (i < 7) { a = wave(a, true); i = i + 1; }
    assert a < 1.0;
    a = wave(a, true);
    assert a > 0.999;
    // 8 frames at 30 fps = 0.267 s, the nearest frame count to trios' 0.25 s easeInOut
    assert @abs(8.0 * FRAME_S - 0.25) < 0.02;
    i = 0;
    while (i < 8) { a = wave(a, false); i = i + 1; }
    assert a < 0.001;
}

test the_cross_fade_takes_the_same_time_at_any_redraw_rate {
    var a : f64 = 0.0;
    var i : u32 = 0;
    // 16 redraws at 60 fps = 0.267 s = the 8 ticks of 30 fps
    while (i < 16) { a = wave_k(a, true, 0.5); i = i + 1; }
    assert a > 0.999;
    a = 0.0;
    i = 0;
    while (i < 15) { a = wave_k(a, true, 0.5); i = i + 1; }
    assert a < 1.0;
    assert wave_k(0.5, false, 8.0) == 0.0;
}

test the_blocks_fly_in_from_800_units_and_settle_home {
    assert anim_off(0) == 800.0;
    assert anim_off(1) < 800.0;
    assert anim_off(40) < 10.0;
    assert anim_off(ANIM_FRAMES) == 0.0;
}

test the_glass_carries_trios_numbers {
    assert TINT_BLACK == 0.55;
    assert SURFACE_BLACK == 0.46;
    assert SIDEBAR_BLACK == 0.22;
    assert CONTENT_BLACK == 0.14;
    assert BORDER_WHITE == 0.14;
    assert SIDE_W == 272.0;
    assert HEADER_H == 44.0;
    assert WS_TOP == AREA_TOP;
    assert READABLE_W == 900.0;
    assert chan(outline(), 3) == 1.0;
}

test every_petal_flies_out_along_a_unit_direction {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const x : f64 = dir(p, 0);
        const y : f64 = dir(p, 1);
        assert @abs(x * x + y * y - 1.0) < 0.000001;
        p = p + 1;
    }
}

test the_title_bar_controls_clear_the_traffic_lights {
    // T. macOS draws close / minimise / zoom in x < 76 of the title bar.
    assert HOME_X >= 76.0;
    // the logo + TRINITY sit in the middle of the bar, clear of the traffic lights and the chevron
    assert on_home_button(30.0, 17.0, W_PT) == false;
    assert on_home_button(0.5 * W_PT, 17.0, W_PT);
    assert on_home_button(0.5 * PANEL_W, 17.0, PANEL_W);
    assert brand_left(PANEL_W, HOME_BTN_W) > HOME_X + BACK_W;
    assert brand_left(PANEL_W, HOME_BTN_W) + HOME_BTN_W < dock_x(PANEL_W) - DOCK_STEP;
    assert brand_left(W_PT, 100.0) + 0.5 * 100.0 == 0.5 * W_PT;
    assert home_x(true) < home_x(false);
    assert on_full_button(full_x(W_PT) + 10.0, 17.0, W_PT);
    assert full_x(W_PT) + FULL_PT <= W_PT - 16.0;
    assert on_dock_button(dock_x(W_PT) + 10.0, 17.0, W_PT);
    assert on_dock_button(full_x(W_PT) + 10.0, 17.0, W_PT) == false;
    assert dock_x(PANEL_W) > HOME_X + HOME_BTN_W;
    assert on_nav_back(30.0, 17.0, false) == false;
    assert on_nav_back(HOME_X + 4.0, 17.0, false);
    assert on_nav_back(30.0, AREA_TOP + 16.0, false) == false;
}

test the_home_logo_fills_063_of_the_area_and_maps_the_mouse_back {
    const z : f64 = 1.0;
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * home_k(z, W_PT, H_PT);
    assert @abs(h - LOGO_SHARE * 0.8 * (H_PT - AREA_TOP)) < 0.001;
    // the logo's own middle sits mid-area
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT));
    assert @abs(my - 0.5 * (AREA_TOP + H_PT)) < 0.001;
    // the logo stays below the title bar
    assert to_pt(logo_edge(1, false), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) > AREA_TOP;
    // the mouse on the logo centre maps to the centre petal_menu's hit test uses
    assert @abs(virt(home_c(0, z, W_PT, H_PT), 0, z, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, z, W_PT, H_PT), 1, z, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_tooltip_floats_30_points_above_its_petal {
    const z : f64 = 1.0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert @abs(to_pt(cen_y(p), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) - tip_y(p, z, W_PT, H_PT) - TIP_RISE) < 0.001;
        p = p + 1;
    }
}

test the_menu_shortcuts_follow_queen_menu_shortcut_policy {
    assert digit_of(18) == 1;
    assert digit_of(25) == 9;
    assert digit_of(29) == 0;
    assert digit_of(0) == NO_DIGIT;
    assert petal_for_key(1, MOD_COMMAND) == 0;
    assert petal_for_key(9, MOD_COMMAND) == 8;
    assert petal_for_key(1, MOD_OPTION) == 9;
    assert petal_for_key(9, MOD_OPTION) == 17;
    assert petal_for_key(1, MOD_CONTROL) == 18;
    assert petal_for_key(9, MOD_CONTROL) == 26;
    assert petal_for_key(1, MOD_COMMAND + MOD_SHIFT) == PETAL_NONE;
    assert petal_for_key(1, MOD_COMMAND + MOD_OPTION) == PETAL_NONE;
    assert petal_for_key(0, MOD_COMMAND) == PETAL_NONE;
    assert petal_for_key(1, 0) == PETAL_NONE;
}

test the_sidebar_collapses_and_the_cards_take_the_room {
    assert content_x(WS_EXPANDED, false) == SIDE_W + 1.0;
    assert content_x(WS_EXPANDED, true) == 0.0;
    assert body_w(W_PT, WS_EXPANDED, true) == READABLE_W;
    assert body_w(W_PT, WS_EXPANDED, false) < READABLE_W;
    assert body_left(W_PT, WS_EXPANDED, false) >= content_x(WS_EXPANDED, false) + BODY_PAD;
    assert body_left(W_PT, WS_EXPANDED, true) + body_w(W_PT, WS_EXPANDED, true) <= W_PT - BODY_PAD;
    assert on_side_toggle(SIDE_W + 1.0 + 20.0, WS_TOP + 22.0, WS_EXPANDED, false);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, true);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    const el : f64 = body_left(W_PT, WS_EXPANDED, false);
    const ew : f64 = body_w(W_PT, WS_EXPANDED, false);
    const eh : f64 = body_h(W_PT, H_PT, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, el, body_top(WS_EXPANDED), ew, eh), hex_c(0, 1, el, body_top(WS_EXPANDED), ew, eh), W_PT, H_PT, WS_EXPANDED, false) == 0;
    const cl : f64 = body_left(W_PT, WS_EXPANDED, true);
    const cw2 : f64 = body_w(W_PT, WS_EXPANDED, true);
    const ch2 : f64 = body_h(W_PT, H_PT, WS_EXPANDED, true);
    assert card_at(hex_c(4, 0, cl, body_top(WS_EXPANDED), cw2, ch2), hex_c(4, 1, cl, body_top(WS_EXPANDED), cw2, ch2), W_PT, H_PT, WS_EXPANDED, true) == 4;
    assert card_at(10.0, 10.0, W_PT, H_PT, WS_EXPANDED, false) == CARD_SLOTS;
}

test the_dock_icon_is_a_centred_white_logo_on_black {
    const k : f64 = logo_k_for(ICON_LOGO_PX);
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * k;
    assert @abs(h - ICON_LOGO_PX) < 0.001;
    // the logo's own middle lands on the icon centre on both axes
    const mx : f64 = to_pt(0.5 * (logo_edge(0, false) + logo_edge(0, true)), 0, icon_cen(0), k);
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, icon_cen(1), k);
    assert @abs(mx - 0.5 * ICON_SIZE) < 0.001;
    assert @abs(my - 0.5 * ICON_SIZE) < 0.001;
    assert ICON_LOGO_PX < ICON_TILE;
}

test the_cards_cascade_in_and_all_arrive_at_full_alpha {
    assert card_alpha(0.3, 0) > card_alpha(0.3, 8);
    var k : u32 = 0;
    while (k < CARD_SLOTS) { assert card_alpha(1.0, k) == 1.0; k = k + 1; }
}

test full_screen_keeps_the_scene_aspect_and_maps_the_mouse_back {
    assert fit(960.0, 540.0, W_PT, H_PT) == 1.0;
    assert fit(1920.0, 1200.0, W_PT, H_PT) == 2.0;
    assert view_to_scene(960.0, 1920.0, 1200.0, 0, W_PT, H_PT) == 480.0;
    assert view_to_scene(600.0, 1920.0, 1200.0, 1, W_PT, H_PT) == 270.0;
    assert view_to_scene(0.0, 960.0, 540.0, 1, W_PT, H_PT) == 540.0;
}

test full_screen_draws_the_home_logo_20_percent_smaller_and_still_hits {
    assert @abs(home_px(FULL_LOGO, W_PT, H_PT) - 0.8 * home_px(1.0, W_PT, H_PT)) < 0.000001;
    assert @abs(home_k(FULL_LOGO, W_PT, H_PT) - 0.8 * home_k(1.0, W_PT, H_PT)) < 0.000001;
    assert has_mod(MASK_FULL_SCREEN + STYLE, MASK_FULL_SCREEN);
    assert has_mod(STYLE, MASK_FULL_SCREEN) == false;
    // the smaller logo stays centred, and the mouse on its centre still maps to the hit-test centre
    assert @abs(virt(home_c(0, FULL_LOGO, W_PT, H_PT), 0, FULL_LOGO, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, FULL_LOGO, W_PT, H_PT), 1, FULL_LOGO, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_window_folds_into_the_trios_compact_panel_below_760 {
    // K. ChatWorkspaceLayout: expanded from 760, compact below, the forced dashboard on request.
    assert workspace(759.0, false) == WS_COMPACT;
    assert workspace(760.0, false) == WS_EXPANDED;
    assert workspace(760.0, true) == WS_EXPANDED;
    assert workspace(PANEL_W, true) == WS_DASHBOARD;
    assert side_w(WS_COMPACT, false) == 0.0;
    assert side_w(WS_DASHBOARD, false) == 0.0;
    assert side_w(WS_EXPANDED, false) == SIDE_W;
    // the OPEN DASHBOARD bar spans the panel, and only in compact
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_COMPACT);
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_DASHBOARD) == false;
    assert on_open_dash(200.0, WS_TOP + BAR_H + 5.0, PANEL_W, WS_COMPACT) == false;
    // Close Dashboard sits right of the toggle, only in the forced dashboard
    assert on_close_dash(close_x(WS_DASHBOARD, false) + 10.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    assert on_close_dash(close_x(WS_EXPANDED, false) + 10.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_COMPACT, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    // the narrow scene is the view point for point; the cards take the panel under the bar
    assert scene(PANEL_W, 900.0, 0) == PANEL_W;
    assert scene(PANEL_W, 900.0, 1) == 900.0;
    assert scene(PANEL_W, 2000.0, 1) == CH_MAX;
    assert fit(PANEL_W, 900.0, PANEL_W, 900.0) == 1.0;
    assert body_w(PANEL_W, WS_COMPACT, false) == PANEL_W - 2.0 * BODY_PAD;
    const kl : f64 = body_left(PANEL_W, WS_COMPACT, false);
    const kw : f64 = body_w(PANEL_W, WS_COMPACT, false);
    const kh : f64 = body_h(PANEL_W, 900.0, WS_COMPACT, false);
    assert card_at(hex_c(4, 0, kl, body_top(WS_COMPACT), kw, kh), hex_c(4, 1, kl, body_top(WS_COMPACT), kw, kh), PANEL_W, 900.0, WS_COMPACT, false) == 4;
    // the slots keep their wide shape instead of stretching down the panel
    assert @abs(body_h(PANEL_W, 900.0, WS_COMPACT, false) / body_w(PANEL_W, WS_COMPACT, false) - wide_shape()) < 0.000001;
    assert body_h(PANEL_W, 900.0, WS_COMPACT, false) < 900.0 - body_top(WS_COMPACT) - BODY_PAD;
    // the home logo fits inside the 400 pt panel and still maps back to the hit-test centre
    const k : f64 = home_k(1.0, PANEL_W, 900.0);
    assert to_pt(logo_edge(0, false), 0, home_c(0, 1.0, PANEL_W, 900.0), k) > 0.0;
    assert to_pt(logo_edge(0, true), 0, home_c(0, 1.0, PANEL_W, 900.0), k) < PANEL_W;
    assert @abs(virt(home_c(0, 1.0, PANEL_W, 900.0), 0, 1.0, PANEL_W, 900.0) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, 1.0, PANEL_W, 900.0), 1, 1.0, PANEL_W, 900.0) - 0.5 * H_PT) < 0.001;
    // the compact bitmap holds the widest and tallest narrow scene
    assert CW_MAX * RETINA <= 1520.0;
    assert CH_MAX * RETINA <= 2600.0;
}

test full_screen_draws_point_for_point_on_black_glass {
    // F. a 1728 x 1117 pt full screen is its own scene: no 960 x 540 upscale, no letterbox bands
    assert scene(1728.0, 1117.0, 0) == 1728.0;
    assert scene(1728.0, 1117.0, 1) == 1117.0;
    assert fit(1728.0, 1117.0, scene(1728.0, 1117.0, 0), scene(1728.0, 1117.0, 1)) == 1.0;
    assert scene(W_PT, H_PT, 0) == W_PT;
    assert scene(3000.0, 2000.0, 0) == SW_MAX;
    assert scene(3000.0, 2000.0, 1) == SH_MAX;
    assert SW_MAX * WIDE_RETINA <= 3840.0;
    assert SH_MAX * WIDE_RETINA <= 2400.0;
    // the hairline is one device pixel at the display's own scale
    assert HAIR * WIDE_RETINA == 1.0;
    assert TINT_FULL > TINT_BLACK;
    // F. full screen has no transparency: the layer is opaque black #000000 there (owner, 2026-10-20)
    assert TINT_FULL == 1.0;
    // F. the background is black glass: R = G = B = 0, clear in a window, opaque in full screen
    assert BACK_BLACK == 1.0;
    assert BACK_GLASS == 0.0;
    // the wipe covers a fractional edge: it reaches past the scene by at least a point
    assert BACK_BLEED >= 1.0;
    assert CROWN_WHITE == 0.70;
    assert STRICT_CARD_EDGE > STRICT_CARD_FILL;
    // the cards still tile the readable column in full screen
    const fl : f64 = body_left(1728.0, WS_EXPANDED, false);
    const fw : f64 = body_w(1728.0, WS_EXPANDED, false);
    const fh : f64 = body_h(1728.0, 1117.0, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, fl, body_top(WS_EXPANDED), fw, fh), hex_c(0, 1, fl, body_top(WS_EXPANDED), fw, fh), 1728.0, 1117.0, WS_EXPANDED, false) == 0;
}

test logo_is_the_brand_mark_and_title_says_trinity_once {
    // H. the home mark is glass petals with thin outlines (petal_menu.t27 owns the fills), the centre left open
    assert chan(fill(0, STATE_HOME, PETAL_NONE), 3) < 0.25;
    assert chan(fill(0, STATE_HOME, 0), 0) == 1.0;
    assert chan(outline_for(0, STATE_HOME, PETAL_NONE), 3) == 1.0;
    // S. one bar: the back chevron sits in the title bar right before the logo
    assert on_nav_back(FULL_HOME_X + 2.0, 0.5 * TITLE_H, true);
    assert on_nav_back(FULL_HOME_X + 2.0, AREA_TOP + 10.0, true) == false;
    // L. layout.t27: chevron, logo and TRINITY on one centre line, equal gaps, equal icon heights
    assert NAV_SHIFT == row_next(0.0, CHEV_W, ROW_GAP);
    assert same_line(cap_mid(baseline_for(0.5 * TITLE_H, 11.0), 11.0), 0.5 * TITLE_H);
    assert title_logo_w() > ROW_ICON_H;
    assert title_logo_w() < 2.0 * ROW_ICON_H;
    assert TITLE_LOGO_SCALE == 1.2;
}

test the_comb_holds_the_agents_with_the_queen_in_the_middle {
    // A. the Queen is the middle cell of the middle row
    assert AGENT_QUEEN / 3 == 1;
    assert AGENT_QUEEN % 3 == 1;
    // the mark and the name stay inside the cell
    assert AGENT_MARK_UP + AGENT_MARK < 1.0;
    assert AGENT_NAME_DOWN < 0.5;
    assert agent_name_pt(200.0) == AGENT_NAME_PT;
    assert agent_name_pt(40.0) < AGENT_NAME_MIN;
}

test cards_are_a_honeycomb_and_the_logo_has_two_sizes {
    // C. a 600 x 500 body: the comb fits both ways, cells do not touch, the middle row sits half a cell right
    const r : f64 = hex_r(600.0, 500.0);
    assert 3.5 * SQRT3 * r + 2.5 * HEX_GAP <= 600.001;
    assert 5.0 * r + 2.0 * HEX_GAP <= 500.001;
    assert in_hex(hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), r);
    assert hex_c(1, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) > SQRT3 * r;
    assert @abs(hex_c(3, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) - 0.5 * (SQRT3 * r + HEX_GAP)) < 0.001;
    assert @abs(hex_c(6, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0)) < 0.001;
    // a corner of the bounding box is outside the hexagon
    assert in_hex(0.0, 0.0, 0.5 * SQRT3 * r, r, r) == false;
    // H. the large mark is parted by a black cut; the small one by a finer one
    assert LOGO_SEAL > 0.0;
    assert LOGO_SEAL < LOGO_CUT;
}

test small_mark_keeps_the_centre_hole {
    // H. the hole is the mark's inner equilateral triangle: height = width * sqrt(3) / 2 within 1 percent
    const wd : f64 = HOLE_R - HOLE_L;
    assert @abs((HOLE_AY - HOLE_TOP) - 0.5 * SQRT3 * wd) < 0.01 * wd;
    assert @abs(HOLE_AX - 0.5 * (HOLE_L + HOLE_R)) < 1000.0;
    // it sits inside the logo box
    assert HOLE_L > logo_edge(0, false);
    assert HOLE_R < logo_edge(0, true);
    assert HOLE_TOP > logo_edge(1, false);
    assert HOLE_AY < logo_edge(1, true);
    assert HOLE_GROW > 1.0;
}

test the_sidebar_rows_answer_only_where_the_sidebar_is {
    assert in_side(20.0, WS_EXPANDED, false);
    assert in_side(20.0, WS_EXPANDED, true) == false;
    assert in_side(20.0, WS_COMPACT, false) == false;
    assert in_side(SIDE_W - 6.0, WS_EXPANDED, false) == false;
    // the Queen row stays where it was before the groups: label at +22, row at +30
    assert label_base(WS_TOP, GROUP_QUEEN, spaces_shown(SPACES_SEED)) == WS_TOP + 22.0;
    assert row_top(WS_TOP, GROUP_QUEEN, spaces_shown(SPACES_SEED), 0) == WS_TOP + 30.0;
    // with the three seed spaces, five chats fit above the foot strip of the 540-pt window; the sixth runs
    // under OPEN SOURCE T27 (scrolling is not built yet). The old claim, seven, ended at 547 pt.
    assert row_top(WS_TOP, GROUP_AGENTS, spaces_shown(SPACES_SEED), 4) + AGENT_ROW_H <= H_PT - FOOT_H;
    assert row_top(WS_TOP, GROUP_AGENTS, spaces_shown(SPACES_SEED), 5) + AGENT_ROW_H > H_PT - FOOT_H;
    // the foot link answers only inside the sidebar strip
    assert on_repo_link(40.0, H_PT - 20.0, H_PT, WS_EXPANDED, false);
    assert on_repo_link(40.0, H_PT - 20.0, H_PT, WS_EXPANDED, true) == false;
    assert on_repo_link(40.0, H_PT - FOOT_H - 2.0, H_PT, WS_EXPANDED, false) == false;
    assert on_doctor_link(SIDE_W - 40.0, H_PT - 20.0, H_PT, WS_EXPANDED, false);
    assert on_repo_link(SIDE_W - 40.0, H_PT - 20.0, H_PT, WS_EXPANDED, false) == false;
    assert on_doctor_link(40.0, H_PT - 20.0, H_PT, WS_EXPANDED, false) == false;
    // the SPACES "+" and a space row x sit at the right end, clear of the row text
    assert on_space_plus(SIDE_W - 26.0, label_base(WS_TOP, GROUP_SPACES, 3) - 3.5);
    assert on_space_plus(40.0, label_base(WS_TOP, GROUP_SPACES, 3) - 3.5) == false;
    const st : f64 = row_top(WS_TOP, GROUP_SPACES, 3, 0);
    assert on_space_close(SIDE_W - 26.0, st + 14.0, st);
    assert on_space_close(SIDE_W - 26.0, st + 30.0, st) == false;
}

test the_brand_is_trinity_s_superscript_three_ai_in_utf8 {
    var b : [16]u8 = undefined;
    assert brand(b[0 .. 16]) == BRAND_LEN;
    assert b[0] == 84;
    assert b[8] == 83;
    // U+00B3 is C2 B3 in UTF-8, written as bytes because a t27b literal does not decode \x
    assert b[9] == 0xC2;
    assert b[10] == 0xB3;
    assert b[11] == 65;
    assert b[12] == 73;
}

test every_comb_cell_gets_the_same_outline {
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        assert cell_line(k) == HAIR;
        // no hover and no task: every cell has the plain edge, cell 0 included
        assert cell_edge(k, CARD_SLOTS, CARD_SLOTS) == STRICT_CARD_EDGE;
        // hover and selection look the same on every cell
        assert cell_edge(k, k, CARD_SLOTS) == STRICT_HOVER_EDGE;
        assert cell_edge(k, CARD_SLOTS, k) == TASK_EDGE;
        k = k + 1;
    }
}

test the_new_chat_plus_and_the_row_close_answer_only_on_their_boxes {
    // N. "+" sits at the right end of the header, inside the content, never in the compact bar
    const sw : f64 = 1200.0;
    const ty : f64 = WS_TOP + 0.5 * HEADER_H;
    assert on_new_chat(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, sw, WS_EXPANDED);
    assert on_new_chat(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, sw, WS_COMPACT) == false;
    assert on_new_chat(new_chat_x(sw) - 4.0, ty, sw, WS_EXPANDED) == false;
    assert new_chat_x(sw) + TOGGLE_PT < sw;
    // it does not overlap the sidebar toggle
    assert on_side_toggle(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, WS_EXPANDED, false) == false;
    // N. the close x of a row is where its dot is drawn, and only there
    const top : f64 = 200.0;
    assert on_row_close(SIDE_W - 26.0, top + 19.0, top);
    assert on_row_close(40.0, top + 19.0, top) == false;
    assert on_row_close(SIDE_W - 26.0, top + 40.0, top) == false;
    assert in_side(SIDE_W - 26.0, WS_EXPANDED, false);
}

test a_window_is_matte_black_glass_and_full_screen_is_opaque_black {
    // owner, 2026-10-20: a window is clear over the blur and the 0.30 layer tint, as in trios
    assert backdrop_alpha(false) == 0.0;
    assert backdrop_clears(false);
    assert tint_alpha(false) == TINT_BLACK;
    // full screen has no transparency: the frame and the layer are #000000 with nothing under them
    assert backdrop_alpha(true) == 1.0;
    assert backdrop_clears(true) == false;
    assert tint_alpha(true) == 1.0;
    assert tint_alpha(true) > tint_alpha(false);
    // the two states never agree, so a swap can never leave a see-through full screen
    assert backdrop_alpha(true) > backdrop_alpha(false);
}

test the_ground_is_black_in_a_window_and_in_full_screen {
    // owner, 2026-10-20: the OS is black #000000, not grey; surfaces are glass layered on it
    assert GROUND_RGB == 0.0;
    assert TINT_BLACK == 0.55;
    assert tint_alpha(false) == 0.55;
    assert tint_alpha(false) >= 0.45 and tint_alpha(false) <= 0.65;
    assert SURF_FROST > 0.0 and SURF_FROST <= 0.08;
    assert tint_alpha(true) == 1.0;
    // a window's wallpaper glows through blurred: 35 to 55 percent shows, none in full screen
    assert 1.0 - tint_alpha(false) > 0.35;
    assert 1.0 - tint_alpha(true) == 0.0;
}

test the_layer_colour_changes_only_when_full_screen_does {
    assert tint_swap(true, false);
    assert tint_swap(false, true);
    assert tint_swap(false, false) == false;
    assert tint_swap(true, true) == false;
}

test the_editor_view_shares_the_terminal_areas_key_space_with_the_chat_panes {
    // editors.t27 keeps its own copies of these two numbers; the window's pane table is the truth
    assert VIEW_NONE == PANE_NONE;
    assert VIEW_EDITOR < PANE_NONE;
    assert VIEW_EDITOR > 255;
    // with no editor open the area shows what it always did: the chat's pane for Claude Code, else nothing
    assert view_key(false, true, 2) == 2;
    assert view_key(false, false, 2) == PANE_NONE;
    // the editor wins over the chat and does not need one
    assert view_key(true, true, 2) == VIEW_EDITOR;
    assert view_key(true, false, SESSION_NONE) == VIEW_EDITOR;
}

test every_surface_is_glass_in_a_window_and_opaque_black_in_full_screen {
    // owner, 2026-10-20: a window is matte black glass all over -- each surface a darker tint over the blur,
    // none opaque -- and full screen is opaque #000000 all over
    assert surface_alpha(SURF_SIDEBAR, false) == 0.45;
    assert surface_alpha(SURF_CONTENT, false) == 0.35;
    assert surface_alpha(SURF_TERMINAL, false) == 0.15;
    assert surface_alpha(SURF_PANEL, false) == 0.58;
    assert surface_alpha(SURF_SIDEBAR, true) == 1.0;
    assert surface_alpha(SURF_CONTENT, true) == 1.0;
    assert surface_alpha(SURF_TERMINAL, true) == 1.0;
    assert surface_alpha(SURF_PANEL, true) == 1.0;
    var k : u32 = SURF_SIDEBAR;
    while (k <= SURF_PANEL) {
        // never opaque in a window, always opaque in full screen, and then the same as the frame
        assert surface_alpha(k, false) < 1.0;
        assert surface_alpha(k, false) > 0.0;
        assert surface_clears(k, false);
        assert surface_alpha(k, true) == backdrop_alpha(true);
        assert surface_clears(k, true) == false;
        k = k + 1;
    }
    // the terminal is drawn over the content: together they are the sidebar's tone (0.4475 against 0.45)
    const both : f64 = 1.0 - (1.0 - surface_alpha(SURF_CONTENT, false)) * (1.0 - surface_alpha(SURF_TERMINAL, false));
    assert @abs(both - surface_alpha(SURF_SIDEBAR, false)) < 0.01;
    // a right-hand panel is the darkest surface, and still glass
    assert surface_alpha(SURF_PANEL, false) > surface_alpha(SURF_SIDEBAR, false);
    assert surface_alpha(SURF_PANEL, false) < 1.0;
    // a plate wiped inside a panel in full screen shows the layer, which is opaque black there
    assert tint_alpha(true) == 1.0;
}

test an_open_panel_takes_its_width_from_the_terminal {
    const sw : f64 = 960.0;
    // no panel: the content runs to the window's edge, as it always did
    assert content_right(sw, false) == sw;
    assert content_w(sw, WS_EXPANDED, false, false) == sw - content_x(WS_EXPANDED, false);
    // a panel (Queen, DOCTOR or KEYS, all QP_W wide): the content ends at the panel's left edge
    assert content_right(sw, true) == qp_left(sw);
    assert content_right(sw, true) == sw - QP_W;
    assert content_w(sw, WS_EXPANDED, false, true) == content_w(sw, WS_EXPANDED, false, false) - QP_W;
    assert content_w(sw, WS_EXPANDED, false, true) == 387.0;
    assert content_w(sw, WS_EXPANDED, true, true) == 660.0;
    // the grid the pty is resized to is narrower, and its last cell ends before the panel begins
    assert tp_cols(content_w(sw, WS_EXPANDED, false, true)) < tp_cols(content_w(sw, WS_EXPANDED, false, false));
    assert tp_cols(content_w(sw, WS_EXPANDED, false, true)) == 49;
    assert tp_cell_x(content_x(WS_EXPANDED, false), tp_cols(content_w(sw, WS_EXPANDED, false, true))) <= qp_left(sw);
    // full screen: wider window, same rule
    assert content_w(1920.0, WS_EXPANDED, false, true) == 1920.0 - QP_W - content_x(WS_EXPANDED, false);
    // a window too narrow for the panel leaves no negative width
    assert content_w(200.0, WS_COMPACT, false, true) == 0.0;
}

test the_keys_foot_gives_the_status_the_open_in_row_and_each_chip_row_a_band_at_960_by_540 {
    const ft : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT);
    const last : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT - 1);
    // the foot starts below the last provider row's buttons and plates
    assert last + KY_BTN_DY + KY_BTN_H + 2.0 <= foot_status_top(ft);
    // the bench Mac's six chips (T27 OS, Cursor, Xcode, Antigravity, Antigravity IDE, ZCode) are two rows
    assert foot_status_fits(ft, H_PT);
    assert foot_chips(ft, H_PT, 6) == 6;
    assert foot_chips_top(ft) + 2.0 * ED_SLOT_H <= H_PT;
    // the second row of chips (the screenshot's Antigravity row) is below the status line's ink, not on it
    const status_base : f64 = foot_status_top(ft) + FT_BASE;
    const row1_base : f64 = ed_slot_y(foot_chips_top(ft), ED_COLS) + ED_BASE;
    assert row1_base - FT_ASC > status_base + FT_DESC;
    // status, OPEN IN, chip row 0, chip row 1: each baseline is a full ink height below the one before
    const head_base : f64 = foot_head_top(ft) + FT_BASE;
    const row0_base : f64 = ed_slot_y(foot_chips_top(ft), 0) + ED_BASE;
    assert head_base - FT_ASC > status_base + FT_DESC;
    assert row0_base - FT_ASC > head_base + FT_DESC;
    assert row1_base - FT_ASC > row0_base + FT_DESC;
    // a taller window or a full screen shows every chip of a full table, and still nothing under the bottom edge
    assert foot_chips(ft, 900.0, EDITOR_COUNT) == EDITOR_COUNT;
    assert foot_chips(ft, 1440.0, EDITOR_COUNT) == EDITOR_COUNT;
    assert foot_bottom(ft, 900.0, EDITOR_COUNT) <= 900.0;
    // the window's own height holds six chips of a longer table: whole rows only, never a partial one
    assert foot_chips(ft, H_PT, EDITOR_COUNT) == 6;
}

/// Test helper: how many sampled points of the terminal's rectangle (every 12 pt) a window control answers at.
/// The title bar, the header (toggle, Close Dashboard, "+"), the compact dashboard bar, the sidebar and a
/// right-hand panel all lie outside that rectangle, so this is 0 in every layout. The home logo's petals need
/// the home screen, where no pane is up.
fn controls_under_term(sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> u32 {
    var hits : u32 = 0;
    const l : f64 = content_x(ws, collapsed);
    const r : f64 = l + content_w(sw, ws, collapsed, panel);
    var y : f64 = WS_TOP + HEADER_H;
    while (y < sh) {
        var x : f64 = l;
        while (x < r) {
            if (on_home_button(x, y, sw) or on_full_button(x, y, sw) or on_dock_button(x, y, sw)) { hits = hits + 1; }
            if (on_nav_back(x, y, false) or on_nav_back(x, y, true)) { hits = hits + 1; }
            if (on_open_dash(x, y, sw, ws) or on_close_dash(x, y, ws, collapsed)) { hits = hits + 1; }
            if (on_side_toggle(x, y, ws, collapsed) or on_new_chat(x, y, sw, ws)) { hits = hits + 1; }
            // the sidebar's rows and its "+" answer only where in_side says the sidebar is
            if (in_side(x, ws, collapsed)) { hits = hits + 1; }
            if (on_repo_link(x, y, sh, ws, collapsed) or on_doctor_link(x, y, sh, ws, collapsed) or on_keys_foot(x, y, sh, ws, collapsed)) { hits = hits + 1; }
            if (panel and on_panel(x, y, sw, WS_TOP)) { hits = hits + 1; }
            x = x + 12.0;
        }
        y = y + 12.0;
    }
    return hits;
}

test a_click_on_a_terminal_pane_is_the_panes_and_nothing_under_it_answers {
    // the bug: the input row of a Claude Code pane lies over a honeycomb cell, and the click opened an agent chat
    const sw : f64 = W_PT;
    const sh : f64 = H_PT;
    const bl : f64 = body_left(sw, WS_EXPANDED, false);
    const bt : f64 = body_top(WS_EXPANDED);
    const bw : f64 = body_w(sw, WS_EXPANDED, false);
    const bh : f64 = body_h(sw, sh, WS_EXPANDED, false);
    const cx : f64 = hex_c(4, 0, bl, bt, bw, bh);
    const cy : f64 = hex_c(4, 1, bl, bt, bw, bh);
    assert card_at(cx, cy, sw, sh, WS_EXPANDED, false) == 4;
    assert on_term(cx, cy, sw, sh, WS_EXPANDED, false, false);
    // with a pane up the click is the pane's and no card answers it, in the click and under the cursor
    assert term_click(term_up(true, 2), cx, cy, sw, sh, WS_EXPANDED, false, false);
    assert card_live(term_up(true, 2), cx, cy, sw, sh, WS_EXPANDED, false) == CARD_SLOTS;
    // the editor view is a pane too
    assert term_up(true, VIEW_EDITOR);
    assert term_click(term_up(true, VIEW_EDITOR), cx, cy, sw, sh, WS_EXPANDED, false, false);
    // with no pane the card answers as before, and the pane takes nothing
    assert term_up(true, PANE_NONE) == false;
    assert term_up(false, 2) == false;
    assert term_click(term_up(true, PANE_NONE), cx, cy, sw, sh, WS_EXPANDED, false, false) == false;
    assert card_live(term_up(true, PANE_NONE), cx, cy, sw, sh, WS_EXPANDED, false) == 4;
    // the rectangle is the terminal's: right of the sidebar, under the header, short of an open panel
    assert on_term(content_x(WS_EXPANDED, false) + 1.0, WS_TOP + HEADER_H + 1.0, sw, sh, WS_EXPANDED, false, false);
    assert on_term(content_x(WS_EXPANDED, false) - 2.0, WS_TOP + HEADER_H + 1.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(500.0, WS_TOP + HEADER_H - 1.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(500.0, sh, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(sw - 1.0, 300.0, sw, sh, WS_EXPANDED, false, false);
    assert on_term(sw - 1.0, 300.0, sw, sh, WS_EXPANDED, false, true) == false;
    assert on_term(qp_left(sw) - 1.0, 300.0, sw, sh, WS_EXPANDED, false, true);
    // the sidebar's rows, the header's buttons, the title bar, the dashboard bar: none is inside the rectangle
    assert controls_under_term(sw, sh, WS_EXPANDED, false, false) == 0;
    assert controls_under_term(sw, sh, WS_EXPANDED, false, true) == 0;
    assert controls_under_term(sw, sh, WS_EXPANDED, true, false) == 0;
    assert controls_under_term(1728.0, 1117.0, WS_EXPANDED, false, false) == 0;
    assert controls_under_term(1728.0, 1117.0, WS_EXPANDED, false, true) == 0;
    assert controls_under_term(700.0, 900.0, WS_DASHBOARD, false, false) == 0;
    assert controls_under_term(PANEL_W, 900.0, WS_COMPACT, false, false) == 0;
    assert controls_under_term(PANEL_W, 900.0, WS_COMPACT, false, true) == 0;
}

test chat_is_the_third_petal_and_cmd_3_opens_it {
    assert PETAL_CHAT == 2;
    assert petal_for_key(3, MOD_COMMAND) == PETAL_CHAT;
    assert petal_for_key(1, MOD_COMMAND) == 0;
    assert petal_for_key(4, MOD_COMMAND) == 3;
