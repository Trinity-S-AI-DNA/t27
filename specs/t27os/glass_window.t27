// ---- W window ----

pub const W_PT : f64 = 960.0;
pub const H_PT : f64 = 540.0;
pub const RETINA : f64 = 4.0;
/// titled | closable | miniaturizable | resizable | fullSizeContentView (the green button goes full screen)
pub const STYLE : u64 = 32783;
/// NSWindowCollectionBehaviorFullScreenPrimary
pub const FULL_SCREEN_PRIMARY : u64 = 128;
/// NSViewWidthSizable | NSViewHeightSizable
pub const SIZABLE : u64 = 18;
pub const BACKING_BUFFERED : u64 = 2;
/// NSVisualEffectMaterialHUDWindow, NSVisualEffectBlendingModeBehindWindow, state active
pub const MATERIAL : u64 = 13;
pub const BLEND_BEHIND : u64 = 0;
pub const STATE_ACTIVE : u64 = 1;
pub const UTF8 : u32 = 134217984;
/// kCGImageAlphaPremultipliedLast
pub const ALPHA_PREMUL_LAST : u32 = 1;
