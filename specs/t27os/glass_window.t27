    var iedit : u32 = IE_NONE;
    var edone : u64 = 0;
    var epane : u32 = PANE_NONE;
    var espace : u32 = 0;
    // the editor view: on while the editor pane is on screen, the chat and space it was opened on (the view
    // ends when either changes) and the second of the last Escape (Escape twice closes the view)
    var eview : bool = false;
    var ecur : u32 = SESSION_NONE;
    var esp : u32 = 0;
    var eesc : u64 = 0;
    var kpend : u32 = KY_NONE;
    var kbk : u32 = 0;
    var kpre : u32 = 0;
    var ki : u32 = 0;
    while (ki < 9) {
        kstored[ki] = 0;
        kmlen[ki] = 0;
        kfail[ki] = 0;
        kopen[ki] = 0;
        ki = ki + 1;
    }
    var kz : u32 = 0;
    while (kz < 72) {
        kst[kz] = ST_STORED;
        kz = kz + 1;
    }
    // the Devices view (keysync.t27) after the 144 mask bytes starts empty
    var kdv : usize = 144;
    while (kdv < 544) {
        kmask[kdv] = 0;
        kdv = kdv + 1;
    }
    var khome : [256]u8 = undefined;
    var kdir : [512]u8 = undefined;
    var ktmp : [256]u8 = undefined;
    var auto_open : bool = true;
    // the terminal pane: the vt grid, the session it shows, offline or live, the server's pane id,
    // frames since the last key (the cursor stays solid while typing), the bytes in and out, the socket,
    // the read cursor into the pane's output and frames since the last connect attempt
    var tst : [32]u32 = undefined;
    var tcells : [960000]u32 = undefined;
    vt_init(tst[0..32], tcells[0..960000], TP_COLS_MIN, TP_ROWS_MIN);
    var tkey : [8]u8 = undefined;
    var tclip : [262144]u8 = undefined;
    var tpaste : [262144]u8 = undefined;
    var techo : [8]u8 = undefined;
    var tout : [4100]u8 = undefined;
    var thome : [256]u8 = undefined;
    var tdir : [512]u8 = undefined;
    var tfd : i32 = -1;
    var tcursor : u64 = 0;
    var ttry : u32 = 0;
    var srvp : u32 = SRV_UP;
    var srvw : u32 = 0;
    var srvpid : u64 = 0;
    var srvretry : bool = false;
    var topen : u32 = PANE_NONE;
    var tlink : u32 = PANE_OFFLINE;
    var tpid : u32 = PANE_NONE;
    var tsince : u32 = 999;
    var tcur : bool = false;
    // the resize debounce: the grid that fit last frame and how many frames it has held
    var twc : u32 = 0;
    var twr : u32 = 0;
    var tstable : u32 = 0;
    // the frame gate (frame_gate.t27): the key on screen, frames since the last draw and since the key
    // last changed, a count of grid updates, and the next event wait
    var fshown : u64 = 0;
    var fsince : u32 = 9999;
    var fquiet : u32 = 0;
    var tfed : u64 = 0;
    var wacc : u32 = 0;
    var wlast : bool = true;
    var wkeys : [40]u8 = undefined;
    var fwait : f64 = FRAME_S;
    // animation clocks: the last time read, the fractional tick carry, the whole ticks of this frame
    var a_last : f64 = abs_time();
    var a_acc : f64 = 1.0;
    var a_frames : u32 = 0;
    const s_chars : u64 = sel("characters");
    const s_chars_raw : u64 = sel("charactersIgnoringModifiers");
    const s_char_at : u64 = sel("characterAtIndex:");
    const s_scroll_y : u64 = sel("scrollingDeltaY");
    const s_precise : u64 = sel("hasPreciseScrollingDeltas");
    // the default frame (window_keep.t27): the visible screen on a first launch or from the old 960 x 540; a frame the
    // user resized is kept. The defaults key is checked BEFORE the autosave name is set, which would write one.
    const fk_saved : bool = msg1(msg0(cls("NSUserDefaults"), sel("standardUserDefaults")), sel("objectForKey:"), cf("NSWindow Frame T27OS")) != 0;
    msg1(win, sel("setFrameAutosaveName:"), cf("T27OS"));
    msg_frame(msg1(win, s_value, k_frame), s_get, wf);
    if (wk_use_visible(fk_saved, wf[2], wf[3], msg0(cls("NSEvent"), sel("modifierFlags")))) {
        msg_frame(msg1(msg0(cls("NSScreen"), sel("mainScreen")), s_value, k_visible), s_get, vf);
        if (vf[2] > 100.0 and vf[3] > 100.0) { msg_set_frame(win, s_set_frame, vf[0], vf[1], vf[2], vf[3], true, false); }
    }
    // a hot swap always restores; an ordinary launch restores what was kept unless Option is held
    const wk_mods : u64 = msg0(cls("NSEvent"), sel("modifierFlags"));
    const wk_hot : bool = msg1(defs, sel("integerForKey:"), k_hot) == 1;
    if (!wk_hot and !wk_restore(1, wk_mods)) { msg2(defs, sel("setInteger:forKey:"), 0, k_kept); }
    if (wk_hot or wk_restore(msg1(defs, sel("integerForKey:"), k_kept), wk_mods)) {
        state = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_state)));
        shown = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_shown)));
        task = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_task)));
        space = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_space)));
        ss = msg1(defs, sel("integerForKey:"), k_ss);
        sp = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_sp)));
        if (spaces_shown(sp) == 0) { sp = SPACES_SEED; }
        if (space_is_open(sp, space) == false) { space = space_at_row(sp, 0); }
        cur = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_cur)));
        hs = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_hs)));
        if (cur >= session_count(ss)) { cur = SESSION_NONE; }
        const fl : u64 = msg1(defs, sel("integerForKey:"), k_flags);
        collapsed = fl % 2 == 1;
        dash = fl / 2 % 2 == 1;
        qp = fl / 4 % 2 == 1;
        god = fl / 8 % 2 == 1;
        dp = fl / 16 % 2 == 1;
        auto_open = fl / 32 % 2 == 0;
        evn = @as(u32, @intCast(msg1(defs, sel("integerForKey:"), k_evn)));
        ri = 0;
        while (ri < RING) {
            ring[ri] = msg1(defs, sel("integerForKey:"), k_ev[ri]);
            ri = ri + 1;
        }
        if (menu_open(state)) { ma = 1.0; }
        msg2(defs, sel("setInteger:forKey:"), 0, k_hot);
    }
    hs_for = shown;
    while (msg_test(win, s_visible)) {
        const pool : u64 = pool_push();
        msg_point(msg1(win, s_value, k_mouse), s_get, pt);
        msg_frame(msg1(view, s_value, k_frame), s_get, fr);
        const sw : f64 = scene(fr[2], fr[3], 0);
        const sh : f64 = scene(fr[2], fr[3], 1);
        const narrow : bool = fr[2] < COMPACT_BELOW;
        const ws : u32 = workspace(sw, dash);
        var mx : f64 = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
        var my : f64 = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
        const full : bool = has_mod(msg0(win, s_mask), MASK_FULL_SCREEN);
        var z : f64 = 1.0;
        if (full) { z = FULL_LOGO; }
        if (on_glass(sw) != was_glass) {
            msg1(layer, sel("setBackgroundColor:"), cg_color(GROUND_RGB, GROUND_RGB, GROUND_RGB, tint_alpha(sw)));
            was_glass = on_glass(sw);
            if (dcv[D_WEB] != 0) { live_paint(dcv[D_WEB], full); }
        }
        var vx : i64 = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
        var vy : i64 = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
        // H. the logo answers the mouse only at home, once the screen has gone.
        const home_live : bool = menu_open(state) == false and ma == 0.0 and my > AREA_TOP;
        // the CHAT petal's screen carries every chat control; a home tab (any other petal) carries only the
        // title bar's back chevron and its cards
        const screen : bool = menu_open(state) and ma >= 0.5 and shown == PETAL_CHAT and cons2 == false;
        const hscreen : bool = menu_open(state) and ma >= 0.5 and (shown != PETAL_CHAT or cons2);
        // the sidebar a screen shows: the chat's, or a home tab's
        var sws : u32 = ws;
        if (shown != PETAL_CHAT or cons2) { sws = home_ws(ws); }
        const hh : u32 = letter_of_petal(shown);
        now = unix_time(0);
        tgv[TPG_NOW] = now;
        // a letter with a built tool page shows it in place of its dashboard (agent_parts page_kind)
        const tpk : u32 = page_kind(hh);
        const tpg : bool = hscreen and ma >= 0.5 and shown != PETAL_CHAT and tpk != PAGE_NONE and tgv[TPG_DASH] == 0 and dcv[D_LIVE] == 0;
        var sug : u32 = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        var ev : u64 = msg_event(app, s_next, 0xffffffffffffffff, msg_f(date_cls, s_wait, fwait), mode, true);
        while (ev != 0) {
            const ty : u64 = msg0(ev, s_type);
            var used : bool = false;
            var ctl : u32 = C_NONE;
            var to_agents : bool = false;
            var carg : u32 = 0;
            var tact : u32 = 0;
            if (ty == EV_LEFT_DOWN) {
                // the click is where the event says, not where the mouse was when the frame began
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                vx = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
                vy = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
                const lgh : u32 = lv_log_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, sw - content_x(ws, collapsed), sh - WS_TOP - HEADER_H);
                const sbit : u32 = sb_hit(kit, tgv[0..256], sst[0..560], mx, my, sw, sh);
                const sbp : u32 = item_page(sbit);
                const hdr_ready : bool = tgv[TPG_U_ON] != 0 and tgv[TPG_U_ST] == (U_STAGED as u64);
                if (on_god_switch(mx, my, hdr_right(sw), TITLE_H)) {
                    // the GOD MODE switch in the header (statusbar.t27): on every screen, panel open or not
                    god = god == false;
                    if (god) { ctl = C_GOD_ON; } else { ctl = C_GOD_OFF; }
                    last_act = now;
                } else if (on_hdr_btn(mx, my, hdr_right(sw), TITLE_H, hdr_ready)) {
                    // the header's UPDATE NOW, the same press as the update line
                    tgv[TPG_U_GO] = 1;
                } else if (on_pf_head(mx, my, sw)) {
                    // P. the profile circle opens or closes the PROFILE panel; it takes the place of the Queen, DOCTOR and KEYS panels
                    pf_leave(tbv[TBO_PF .. TBO_PF + PF_CAP], PRF_EV_CLOSE);
                    pfp = pfp == false;
                    if (pfp) {
                        qp = false;
                        god = false;
                        dp = false;
                        kyp = false;
                        karm = KY_NONE;
                        kedit = KY_NONE;
                        klen = 0;
                    }
                    tsince = 0;
                    tg_bump(tgv[0..256]);
                } else if ((screen or hscreen) and in_bar(my, sh)) {
                    // the footer bar (statusbar.t27): each item opens its page; it wins over everything under it
                    if (sbp == PG_GOD) {
                        god = god == false;
                        if (god) { ctl = C_GOD_ON; } else { ctl = C_GOD_OFF; }
                        last_act = now;
                    } else if (sbp == PG_UPDATE) {
                        tgv[TPG_U_GO] = 1;
                        tg_bump(tgv[0..256]);
                    } else if (on_repo_link(mx, my, sw, sh)) {
                        const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), cf(REPO_URL));
                        msg1(msg0(cls("NSWorkspace"), sel("sharedWorkspace")), sel("openURL:"), url);
                        ctl = C_REPO_LINK;
                    } else if (screen and (on_keys_foot(mx, my, sw, sh) or sbp == PG_KEYS)) {
                        // K. KEYS in the foot opens or closes the panel; it takes the Queen and DOCTOR panels' place
                        kyp = kyp == false;
                        karm = KY_NONE;
                        kedit = KY_NONE;
                        klen = 0;
                        if (kyp) {
                            qp = false;
                            god = false;
                            pfp = false;
                            dp = false;
                            rc = false;
                            keys_refresh(kstored[0..9], kmask[0..144], kmlen[0..9]);
                            // the refresh also hands the server every numbered key again (a server that restarted forgot them)
                            if (tfd >= 0) { keys_sync(tfd, kst[0..72], tout[0..4100]); }
                            const khn : usize = ns_bytes(home_dir(), khome[0..256]);
                            kemask = installed_mask(khome[0..khn]);
                            ktpick = term_pick(term_mask());
                            kewhy = OPEN_NONE;
                        }
                    } else if (on_doctor_link(mx, my, sw, sh) or sbp == PG_DOCTOR) {
                        dp = dp == false;
                        if (dp) { qp = false; god = false; kyp = false; pfp = false; rc = false; }
                        darmed = ARMED_NONE;
                    } else if (sbp == PG_QUEEN) {
                        qp = qp == false;
                        if (qp) { dp = false; kyp = false; pfp = false; rc = false; }
                        last_act = now;
                    }
                    tsince = 0;
                } else if (qd_open(sst[0..560], screen, ws) and on_qd_area(mx, my, sw, sh, ws, collapsed, qp or dp or kyp or pfp)) {
                    // the CONTROL DASHBOARD takes every click in its rectangle (queen_dash.t27 qd_hit)
                    const qx0 : f64 = qd_area_x(ws, collapsed);
                    const qw0 : f64 = qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp);
                    const qh0 : f64 = qd_area_h(sh);
                    const qlt : u32 = qd_table_rows(WS_TOP, qw0, qh0);
                    const qlr : u32 = qd_lane_rows_shown(qlt);
                    const qqr : u32 = qd_queue_rows_shown(qlt);
                    const qhit : u32 = qd_hit(mx, my, qx0, WS_TOP, qw0, qh0, qlr, qqr);
                    const qk : u32 = qd_hit_kind(qhit);
                    if (qk == QD_QH_CLOSE) {
                        sst[SST_QDASH] = 0;
                    } else if (qk == QD_QH_GOD) {
                        god = god == false;
                        if (god) { ctl = C_GOD_ON; } else { ctl = C_GOD_OFF; }
                        last_act = now;
                    } else if (qk == QD_QH_TICK or qk == QD_QH_MINUS or qk == QD_QH_PLUS or qk == QD_QH_PAUSE) {
                        tgv[TPG_QD_FLAGS] = qd_fl_press(tgv[TPG_QD_FLAGS], qk);
                        tg_bump(tgv[0..256]);
                    } else if (qk == QD_QH_LANE) {
                        const qli : u32 = qd_lane_index(sst[0..560], qd_hit_row(qhit));
                        if (qli != LV_NONE) {
                            sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_OPEN, qli);
                            sst[SST_LVLSCR] = 0;
                            sst[SST_LVKEY] = sst[SST_LV + (qli as usize) * LV_F + LVF_SRC];
                            sst[SST_LVKEY + 1] = sst[SST_LV + (qli as usize) * LV_F + LVF_ISSUE];
                            lvcur = cur;
                            sst[SST_QDASH] = 0;
                        }
                    } else if (qk == QD_QH_QUEUE) {
                        const qpn : usize = tgv[TPG_QD_PLANN] as usize;
                        const qpt : []const u8 = tbv[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP];
                        const qps : usize = qd_pick_start(qpt, qpn, qd_hit_row(qhit));
                        const qiss : u32 = qd_issue_in(qpt, qps, qd_pick_end(qpt, qpn, qps));
                        if (qiss > 0) {
                            var qu : [96]u8 = undefined;
                            var qn : usize = put_bytes(qu[0..96], 0, REPO_URL);
                            qn = put_bytes(qu[0..96], qn, "/issues/");
                            qn = put_dec(qu[0..96], qn, qiss as u64);
                            const qurl : u64 = msg1(cls("NSURL"), sel("URLWithString:"), cf(qu[0..qn]));
                            msg1(msg0(cls("NSWorkspace"), sel("sharedWorkspace")), sel("openURL:"), qurl);
                        }
                    }
                    tsince = 0;
                } else if (screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and (lgh == LVH_CLOSE or lgh == LVH_CRUMB)) {
                    // L. the log view's close x and its "back to chat" crumb return to the pane
                    if (lgh == LVH_CLOSE) { sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_CLOSE, 0); } else { sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_CRUMB, 0); }
                    tsince = 0;
                } else if (screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and lgh == LVH_BODY) {
                    // L. the log view is a view of its own: a click in it reaches nothing under it
                    tsince = 0;
                } else if (screen and topen != PANE_NONE and srvp != SRV_UP and sst[SST_LVSEL] == LV_NONE and tp_retry_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp or pfp), sh - WS_TOP - HEADER_H)) {
                    // T. the Retry button of the pane server banner: start the server again
                    srvretry = true;
                    tsince = 0;
                } else if (rc and on_panel(mx, my, sw, WS_TOP)) {
                    // RC. the QUEEN CHAT dock: the close x returns to the content; the transcript reads
                    // and the input line takes the keystrokes (v1 does not select inside the dock)
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        rc = false;
                        ctl = C_QUEEN_CHAT;
                    }
                    tsince = 0;
                } else if (pfp and on_panel(mx, my, sw, WS_TOP)) {
                    // P. the PROFILE panel: close, the big circle and CHOOSE PICTURE, REMOVE PICTURE, the nickname field, SAVE, CANCEL
                    const pfh : u32 = prf_panel_hit_d(mx, my, qp_left(sw), QP_W, WS_TOP, pf_has(tbv[TBO_PF .. TBO_PF + PF_CAP]), prf_squeeze(WS_TOP, sh));
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        pf_leave(tbv[TBO_PF .. TBO_PF + PF_CAP], PRF_EV_CLOSE);
                        pfp = false;
                    } else if (pfh == PRF_H_CHOOSE) {
                        pf_choose(tbv[TBO_PF .. TBO_PF + PF_CAP], tgv[0..256]);
                    } else if (pfh == PRF_H_REMOVE) {
                        pf_remove(tbv[TBO_PF .. TBO_PF + PF_CAP], tgv[0..256]);
                    } else if (pfh == PRF_H_FIELD) {
                        pf_to_edit(tbv[TBO_PF .. TBO_PF + PF_CAP]);
                    } else if (pfh == PRF_H_SAVE) {
                        pf_save(tbv[TBO_PF .. TBO_PF + PF_CAP]);
                    } else if (on_pf_cancel(mx, my, qp_left(sw), WS_TOP - prf_squeeze(WS_TOP, sh)) and pf_editing(tbv[TBO_PF .. TBO_PF + PF_CAP])) {
                        pf_leave(tbv[TBO_PF .. TBO_PF + PF_CAP], PRF_EV_CANCEL);
                    }
                    tsince = 0;
                } else if (qp and on_panel(mx, my, sw, WS_TOP)) {
                    // Q. the Queen panel: close, GOD MODE, and the human gate on every suggestion
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        qp = false;
                        god = false;
                        ctl = C_QUEEN_KEY;
                    } else if (on_god(mx, my, sw, WS_TOP)) {
                        god = god == false;
                        if (god) { ctl = C_GOD_ON; } else { ctl = C_GOD_OFF; }
                        last_act = now;
                    } else if (sug != A_NONE and on_confirm(mx, my, sw, WS_TOP)) {
                        cur = act_cur(ss, sug, space, cur);
                        ss = act_sessions(ss, sug, space);
                        if (cur != SESSION_NONE) { task = session_agent(ss, cur); carg = task; }
                        // her editor suggestion: open this space's folder inside, once for the space
                        if (sug == A_EDIT) {
                            iedit = IE_USER;
                            edone = edit_mark(edone, space);
                        }
                        ctl = C_CONFIRM;
                    } else if (sug != A_NONE and on_dismiss(mx, my, sw, WS_TOP)) {
                        dismissed = sug;
                        ctl = C_DISMISS;
                    } else if (sug == A_NONE and evd != 0 and on_confirm(mx, my, sw, WS_TOP)) {
                        // the evolve suggestion, confirmed: a task shows its planned lane (EVOLVE_SPAWNS is false: nothing starts)
                        evfl = evfl | letter_bit(dec_letter(evd));
                        if (dec_action(evd) == D_TASK) {
                            evst = evst + 1;
                            evp = evd;
                            evn2 = evst;
                        }
                        carg = dec_letter(evd);
                        evd = 0;
                        ctl = C_CONFIRM;
                    } else if (sug == A_NONE and evd != 0 and on_dismiss(mx, my, sw, WS_TOP)) {
                        evfl = evfl | letter_bit(dec_letter(evd));
                        evd = 0;
                        ctl = C_DISMISS;
                    }
                } else if (kyp and qp == false and dp == false and on_panel(mx, my, sw, WS_TOP)) {
                    // K. the KEYS panel: close, a row's add (the next free number) / delete (the newest key, asks twice) / check (every key), an editor chip
                    const kl : f64 = qp_left(sw);
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        kyp = false;
                        karm = KY_NONE;
                        kedit = KY_NONE;
                        klen = 0;
                    } else {
                        const kh : u32 = ky_hit(mx, my, kl, QP_W, QP_PAD, WS_TOP);
                        const kq : u32 = kh / 4;
                        if (kh != KY_NONE) {
                            const kact : u32 = ky_click(kh % 4, kstored[kq] > 0, next_free_key(kstored[kq]) >= MAX_KEYS, probe_has(kq), karm, kq);
                            if (kact == KA_EDIT) {
                                kedit = kq;
                                klen = 0;
                                karm = KY_NONE;
                            } else if (kact == KA_ARM) {
                                karm = kq;
                                kedit = KY_NONE;
                                klen = 0;
                            } else if (kact == KA_DELETE) {
                                // the row's DELETE removes the newest key only (keys.t27 newest_key), from the Keychain and the server
                                const kdn : u32 = newest_key(kstored[kq]);
                                if (kdn < MAX_KEYS) {
                                    if (kc_del_n(kq, kdn)) {
                                        kst[key_index(kq, kdn)] = ST_STORED;
                                        if (tfd >= 0) { client_set_key(tfd, setkey_byte(kq, kdn), "", tout[0..4100]); }
                                    }
                                }
                                karm = KY_NONE;
                                kfail[kq] = 0;
                                keys_refresh(kstored[0..9], kmask[0..544], kmlen[0..9]);
                            } else if (kact == KA_CHECK) {
                                kbusy = kq;
                                kbk = 0;
                                kpend = 0;
                                karm = KY_NONE;
                            } else {
                                karm = KY_NONE;
                            }
                        } else {
                            karm = KY_NONE;
                            const kft : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT);
                            const keh : u32 = ed_hit(mx, my, kl, QP_PAD, foot_chips_top(kft), foot_chips(kft, sh, strip_count(kemask, ktpick)));
                            if (keh != ED_NONE) {
                                // the editor opens the folder of the space on screen (home when it is unbound)
                                var kdirs : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
                                if (dk_len(dk, kdirs) == 0) { kdirs = home_dir(); }
                                const khn : usize = ns_bytes(home_dir(), khome[0..256]);
                                const kdn : usize = ns_bytes(kdirs, kdir[0..512]);
                                const kchip : u32 = strip_chip(kemask, ktpick, keh);
                                if (kchip == CHIP_INSIDE and eview) {
                                    // the chip is also the way back to the chat; the editor keeps running in the server
                                    eview = false;
                                } else if (kchip == CHIP_INSIDE) {
                                    // T27 OS opens inside: the request is served below, where the Queen's is too
                                    iedit = IE_USER;
                                } else {
                                    kewhy = open_in_editor(kchip, khome[0..khn], kdir[0..kdn]);
                                }
                            }
                        }
                    }
                } else if (dp and on_panel(mx, my, sw, WS_TOP)) {
                    // D. the DOCTOR panel: close, or a row's remove / confirm -- one item, one human click each
                    if (on_panel_close(mx, my, sw, WS_TOP)) {
                        dp = false;
                        darmed = ARMED_NONE;
                    } else {
                        const bi : u64 = dk_btn_at(dk, mx, my, sw, sh, doff);
                        if (bi != NS_NOT_FOUND) {
                            const o : u32 = click_on_row(darmed, @as(u32, @intCast(bi)), dk_flags(dk, bi));
                            darmed = after_click(o, @as(u32, @intCast(bi)));
                            if (o == CLICK_REMOVE) {
                                if (dk_trash(dk, bi)) { dnow = true; }
                            }
                        } else {
                            darmed = ARMED_NONE;
                        }
                    }
                } else if (screen and ws == WS_EXPANDED and collapsed == false and in_side(mx, ws, collapsed) and lv_row_at(my, lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sst[SST_LVOFF], sst[SST_LVN], lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh)) != LV_NONE) {
                    // L. a click on a lane or actor row opens its live log tail (a script lane) or its line (any other source)
                    const li : u32 = lv_row_at(my, lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sst[SST_LVOFF], sst[SST_LVN], lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh));
                    if (lv_is_group(sst[SST_LV .. SST_SIZE], li)) {
                        // the kernel group row folds and unfolds its actors; it opens no view
                        if (sst[SST_LVKX] != 0) { sst[SST_LVKX] = 0; } else { sst[SST_LVKX] = 1; }
                        lvat = 0;
                    } else {
                        sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_OPEN, li);
                        sst[SST_LVLSCR] = 0;
                        sst[SST_LVKEY] = sst[SST_LV + @as(usize, li) * LV_F + LVF_SRC];
                        sst[SST_LVKEY + 1] = sst[SST_LV + @as(usize, li) * LV_F + LVF_ISSUE];
                        lvcur = cur;
                    }
                    tsince = 0;
                } else if (term_up(screen, topen) and tgv[TPG_T_MENU] != 0) {
                    // T. the right-click menu is open: a click on a row does it, a click anywhere else only closes the menu
                    const tmi : u32 = ti_menu_hit(mx, my, @as(f64, @floatFromInt(tgv[TPG_T_MX])), @as(f64, @floatFromInt(tgv[TPG_T_MY])));
                    tgv[TPG_T_MENU] = 0;
                    if (tmi == MENU_COPY) { tact = CMD_COPY; }
                    if (tmi == MENU_PASTE) { tact = CMD_PASTE; }
                    if (tmi == MENU_ALL) { tact = CMD_SELECT_ALL; }
                    tsince = 0;
                } else if (term_up(screen, topen) and vt_chip_shown(tst[0..32]) and tp_chip_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp or pfp), sh - WS_TOP - HEADER_H)) {
                    // T. the "jump to live" chip: back to the live screen
                    vt_to_live(tst[0..32]);
                    tsince = 0;
                } else if (term_click(term_up(screen, topen), mx, my, sw, sh, ws, collapsed, qp or dp or kyp or pfp) and (cur == SESSION_NONE or rc_docked(rc, cur, session_agent(ss, cur)) == false)) {
                    // T. a click on the terminal pane is the pane's: its cursor goes solid and nothing under it
                    // reacts (no card, no petal, no bar); every control the chain below answers lies outside
                    // on_term (the title bar, the header, the dashboard bar, the sidebar), or is a card.
                    // The press also starts a mouse selection (vt.t27): a click, a double click (word), a triple click
                    // (line), shift extends; the drag below follows it
                    tsince = 0;
                    vt_sel_begin(tst[0..32], tcells[0..960000], ti_line_at(tst[0..32], my, WS_TOP + HEADER_H), tp_cell_col(mx, content_x(ws, collapsed), tst[ST_COLS]), @as(u32, @intCast(msg0(ev, sel("clickCount")))), has_mod(msg0(ev, s_flags), MOD_SHIFT));
                    tgv[TPG_T_DRAG] = 1;
                } else if (on_home_button(mx, my, sw)) {
                    ctl = C_HOME;
                    state = on_back(state);
                } else if (on_full_button(mx, my, sw)) {
                    msg1(win, s_full, 0);
                } else if (on_dock_button(mx, my, sw) and full == false) {
                    // K. WindowManager: the panel docks 400 pt wide on the right edge, full visible height.
                    if (docked) {
                        msg_set_frame(win, s_set_frame, wf[0], wf[1], wf[2], wf[3], true, true);
                    } else {
                        msg_frame(msg1(win, s_value, k_frame), s_get, wf);
                        msg_frame(msg1(msg0(win, s_screen), s_value, k_visible), s_get, vf);
                        msg_set_frame(win, s_set_frame, vf[0] + vf[2] - PANEL_W, vf[1], PANEL_W, vf[3], true, true);
                    }
                    docked = docked == false;
                } else if ((screen or hscreen) and on_nav_back(mx, my, full)) {
                    if (hscreen and dcv[D_LIVE] != 0) {
                        live_hide(dcv[0..512]);
                    } else {
                        state = on_back(state);
                        ctl = C_HOME;
                    }
                } else if (screen and on_open_dash(mx, my, sw, ws)) {
                    dash = true;
                    ctl = C_DASHBOARD;
                } else if (screen and on_close_dash(mx, my, ws, collapsed)) {
                    dash = false;
                    ctl = C_DASHBOARD;
                } else if ((screen or hscreen) and on_side_toggle(mx, my, sws, collapsed)) {
                    collapsed = collapsed == false;
                    ctl = C_SIDEBAR;
                } else if (screen and shown == PETAL_CHAT and on_qc_switch(mx, my, switch_x(sw), WS_TOP)) {
                    // RC. the QUEEN CHAT dock toggles at its header box: opening docks right, closes every
                    // other right panel, and follows the Queen's chat -- hers in this space, or a new one
                    rc = rc_flip(rc);
                    if (rc) {
                        qp = false;
                        god = false;
                        dp = false;
                        kyp = false;
                        pfp = false;
                        if (cur == SESSION_NONE or rc_session_good(cur, session_agent(ss, cur)) == false) {
                            var qc : u32 = first_of(ss, AGENT_QUEEN, space);
                            if (qc == SESSION_NONE) {
                                const qs : u32 = session_count(ss);
                                ss = add_session(ss, AGENT_QUEEN, space);
                                if (session_count(ss) > qs) { qc = qs; }
                            }
                            if (qc != SESSION_NONE) {
                                cur = qc;
                                task = AGENT_QUEEN;
                            }
                        }
                    }
                    ctl = C_QUEEN_CHAT;
                    tsince = 0;
                } else if (screen and on_switch(mx, my, sw, WS_TOP)) {
                    // the C petal's header: CONSOLE opens the cockpit of letter C
                    cons2 = true;
                } else if (hscreen and shown == PETAL_CHAT and on_switch(mx, my, sw, WS_TOP)) {
                    cons2 = false;
                } else if (hscreen and shown != PETAL_CHAT and tpk != PAGE_NONE and dcv[D_LIVE] == 0 and on_switch(mx, my, sw, WS_TOP)) {
                    // the page's header switch: the dashboard of this letter, and back
                    tgv[TPG_DASH] = 1 - tgv[TPG_DASH];
                    tgv[TPG_K_DRAG] = 0;
                    tg_bump(tgv[0..256]);
                } else if (tpg and mx >= content_x(home_ws(ws), collapsed) and my >= home_view_top()) {
                    // a click on a tool page: B buttons and the FLASH dialogue, K picks a card up, Q has STOP
                    const pgx : f64 = content_x(home_ws(ws), collapsed);
                    const pgy : f64 = home_view_top();
                    const pgw : f64 = sw - pgx;
                    const pgh : f64 = home_view_h(sh);
                    if (tpk == PAGE_BENCH) {
                        var askc : u32 = BH_NONE;
                        if (tgv[TPG_BA_FS] != 0) { askc = @as(u32, @intCast(tgv[TPG_BA_CARD])); }
                        bench_click(tgv[0..256], tbv[0..49152], dhb[0..dhn], now, bp_hit(mx - pgx, my - pgy, pgw, askc));
                    }
                    if (tpk == PAGE_KANBAN) { kanban_down(tgv[0..256], tbv[0..49152], mx, my, pgx, pgy, pgw, pgh); }
                    if (tpk == PAGE_QUEEN) {
                        if (god and on_stop(mx - (pgx + node_x(QN_SAFETY, pgw)), my - (pgy + node_y(QN_SAFETY, pgw, pgh)), pgw)) {
                            god = false;
                            ctl = stop_control(true);
                            tg_bump(tgv[0..256]);
                        }
                    }
                    if (tpk == PAGE_VIZ_SPECS) { specs_viz_click(tgv[0..256], tbv[0..TB_SIZE], pgx, pgy, pgw, pgh, mx, my); }
                    if (tpk == PAGE_VIZ_GNN) { gnn_page_click(tgv[0..256], pgx, pgy, pgw, pgh, mx, my); }
                } else if (hscreen and in_side(mx, home_ws(ws), collapsed) and sec_at(mx, my, WS_TOP) != SEC_NONE) {
                    // H. a section row of this letter's sidebar scrolls its page to that section (no other letter is reachable here)
                    var snc : [32]u32 = undefined;
                    const sna : u32 = plan(hh, snc[0..32]);
                    snc[1] = pins_n(dcv[0..512], pbuf[0..4160]);
                    const sxt : f64 = sec_target(sec_at(mx, my, WS_TOP), hh, snc[0..32], sna, sw - content_x(home_ws(ws), collapsed) - 48.0);
                    if (sxt >= 0.0) {
                        hs = dash_scroll_clamp(hs, @as(i64, @intFromFloat(sxt)) - @as(i64, hs), dash_total_p(hh, sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
                    }
                } else if (hscreen and dcv[D_LIVE] != 0 and on_live_back(mx, my, content_x(home_ws(ws), collapsed), home_view_top())) {
                    live_hide(dcv[0..512]);
                } else if (hscreen and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0) {
                    // the ADD WIDGET panel: close, PIN FROM GALLERY (tap a cell), CREATE NEW (the agents dialog with a line typed)
                    const acx : f64 = content_x(home_ws(ws), collapsed);
                    const avt : f64 = home_view_top();
                    const aq : u32 = @as(u32, @intCast(dcv[D_ADDN]));
                    var ash : u32 = match_count(gal[0..49152], gt[0..2560], gal_total(gt[0..2560]), pbuf[PB_QUERY .. PB_QUERY + 32], aq);
                    if (ash > ap_cap(sw - acx, sh - avt)) { ash = ap_cap(sw - acx, sh - avt); }
                    const aph : u32 = ap_hit(sw - acx, sh - avt, mx - acx, my - avt, ash);
                    if (aph == AP_CLOSE or aph == AP_OUTSIDE) {
                        dcv[D_ADDP] = 0;
                    } else if (aph == AP_CREATE) {
                        var lnb : [96]u8 = undefined;
                        const lnn : usize = create_line(AGENT_LETTERS[hh - 1], lnb[0..96]);
                        set_prefill(dcv[0..512], pbuf[0..4160], lnb[0..lnn]);
                        dcv[D_ADDP] = 0;
                        to_agents = true;
                    } else if (aph >= AP_CELL) {
                        const arow : u32 = nth_match(gal[0..49152], gt[0..2560], gal_total(gt[0..2560]), pbuf[PB_QUERY .. PB_QUERY + 32], aq, aph - AP_CELL);
                        if (arow != PIN_NONE) {
                            const ast : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + arow) * 2]);
                            const aln : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + arow) * 2 + 1]);
                            dcv[D_PINN] = @as(u64, pin_add(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), gal[ast .. ast + aln]));
                            pins_save(dhb[0..dhn], hh, pbuf[0..4160], @as(usize, dcv[D_PINN]));
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] == 0 and dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160])) != HIT_NONE) {
                    // a tile: a gallery card opens its widget live; '+' opens the ADD panel; a pinned tile opens or (x) unpins;
                    // the agents block opens the dialog; an area widget acts (a command or skill types its line in the dialog)
                    const ph : u32 = dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160]));
                    const pcl : u32 = hit_class(ph);
                    const pix : u32 = hit_idx(ph);
                    var ppo : [128]u32 = undefined;
                    const ppc : u32 = pins_parse(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), ppo[0..128]);
                    if (pcl == HC_WIDGET) {
                        live_show(dcv[0..512], glass, gal[0..49152], gt[0..2560], pix, full);
                    } else if (pcl == HC_PIN and pix < ppc) {
                        const pws : u32 = widget_of_id(pbuf[@as(usize, ppo[pix * 2]) .. @as(usize, ppo[pix * 2]) + @as(usize, ppo[pix * 2 + 1])]);
                        if (pws < WIDGET_COUNT) { live_show(dcv[0..512], glass, gal[0..49152], gt[0..2560], pws, full); }
                    } else if (pcl == HC_UNPIN and pix < ppc) {
                        dcv[D_PINN] = @as(u64, pin_remove(pbuf[0..PB_PINS], @as(usize, dcv[D_PINN]), pbuf[@as(usize, ppo[pix * 2]) .. @as(usize, ppo[pix * 2]) + @as(usize, ppo[pix * 2 + 1])]));
                        pins_save(dhb[0..dhn], hh, pbuf[0..4160], @as(usize, dcv[D_PINN]));
                    } else if (pcl == HC_PLUS) {
                        dcv[D_ADDP] = 1;
                        dcv[D_ADDN] = 0;
                    } else if (pcl == HC_CHAT) {
                        to_agents = true;
                    } else if (pcl == HC_AREA) {
                        const ak : u32 = pix / 256;
                        const ai : u32 = pix % 256;
                        if (ak == SEC_HOME) {
                            const hl : u32 = home_other(hh, ai);
                            if (hl > 0) {
                                state = hl - 1;
                                shown = hl - 1;
                                cons2 = true;
                                ctl = C_WORLD;
                                carg = hl - 1;
                            }
                        }
                        if (ak == SEC_COMMANDS and tool_n(hh) > 0) {
                            set_prefill(dcv[0..512], pbuf[0..4160], tool_at(hh, ai));
                            to_agents = true;
                        }
                        if (ak == SEC_SKILLS and skill_n(hh) > 0) {
                            set_prefill(dcv[0..512], pbuf[0..4160], skill_at(hh, ai));
                            to_agents = true;
                        }
                    }
                } else if (screen and on_new_chat(mx, my, sw, ws)) {
                    // N. "+" opens one more chat of the selected agent in this space and selects it
                    const nk : u32 = new_chat_agent(task);
                    const before : u32 = session_count(ss);
                    ss = add_session(ss, nk, space);
                    if (session_count(ss) > before) { cur = before; task = nk; }
                    ctl = C_NEW_CHAT;
                    carg = nk;
                } else if (screen and card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed) != CARD_SLOTS) {
                    // A. a tap on a cell opens that agent's chat here, or a first one if there is none
                    task = card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed);
                    ctl = C_CELL;
                    carg = task;
                    cur = SESSION_NONE;
                    if (task != AGENT_QUEEN) {
                        cur = first_of(ss, task, space);
                        if (cur == SESSION_NONE) {
                            const before : u32 = session_count(ss);
                            ss = add_session(ss, task, space);
                            if (session_count(ss) > before) { cur = before; }
                        }
                    }
                } else if (screen and in_side(mx, ws, collapsed) and on_space_plus(mx, my) and new_space(sp) != SPACE_NONE) {
                    // W. "+" opens the next closed space slot and selects it; a chat elsewhere is let go
                    space = new_space(sp);
                    sp = add_space(sp, space);
                    ctl = C_NEW_SPACE;
                    dk_bind(dk, space, RANK_PLUS);
                    dnow = true;
                    carg = space;
                    if (cur != SESSION_NONE) { cur = SESSION_NONE; task = CARD_SLOTS; }
                } else if ((screen or hscreen) and on_update_strip(mx, my, sh, sws, collapsed, strip_kind(@as(u8, @intCast(tgv[TPG_U_ST])), @as(u8, @intCast(tgv[TPG_U_WHY]))) != STRIP_HIDDEN and tgv[TPG_U_ON] != 0)) {
                    // U. the update line above the foot: Update now (install as soon as no pane is busy) or try again
                    tgv[TPG_U_GO] = 1;
                    tg_bump(tgv[0..256]);
                } else if (screen and on_keys_foot(mx, my, sw, sh)) {
                    // K. KEYS in the foot opens or closes the panel; it takes the Queen and DOCTOR panels' place
                    kyp = kyp == false;
                    karm = KY_NONE;
                    kedit = KY_NONE;
                    klen = 0;
                    if (kyp) {
                        qp = false;
                        god = false;
                        pfp = false;
                        dp = false;
                        rc = false;
                        keys_refresh(kstored[0..9], kmask[0..544], kmlen[0..9]);
                        // the refresh also hands the server every numbered key again (a server that restarted forgot them)
                        if (tfd >= 0) { keys_sync(tfd, kst[0..72], tout[0..4100]); }
                        const khn : usize = ns_bytes(home_dir(), khome[0..256]);
                        kemask = installed_mask(khome[0..khn]);
                        ktpick = term_pick(term_mask());
                        kewhy = OPEN_NONE;
                    }
                } else if ((screen or hscreen) and on_doctor_link(mx, my, sw, sh)) {
                    // D. DOCTOR in the foot opens or closes the panel; it takes the Queen panel's place
                    dp = dp == false;
                    if (dp) { qp = false; god = false; kyp = false; pfp = false; rc = false; }
                    darmed = ARMED_NONE;
                } else if ((screen or hscreen) and on_repo_link(mx, my, sw, sh)) {
                    // W. OPEN SOURCE T27 opens the repository in the default browser
                    const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), cf(REPO_URL));
                    msg1(msg0(cls("NSWorkspace"), sel("sharedWorkspace")), sel("openURL:"), url);
                    ctl = C_REPO_LINK;
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_QUEEN, spaces_shown(sp), 1, my) == 0) {
                    // W. the Queen row selects the orchestrator and opens or closes her panel
                    task = AGENT_QUEEN;
                    cur = SESSION_NONE;
                    // owner 2026-10-20: pressing QUEEN opens the CONTROL DASHBOARD (queen_dash.t27), again closes it
                    if (sst[SST_QDASH] != 0) { sst[SST_QDASH] = 0; } else { sst[SST_QDASH] = 1; }
                    ctl = C_QUEEN_ROW;
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my) != ROW_NONE) {
                    // W. a space row selects the space; a chat that lives elsewhere is let go
                    const sr : u32 = row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my);
                    const rs : u32 = space_at_row(sp, sr);
                    if (spaces_shown(sp) > 1 and on_space_close(mx, my, row_top(WS_TOP, GROUP_SPACES, spaces_shown(sp), sr))) {
                        // W. its x closes the space and every chat in it; the selection moves to the first space left
                        ctl = C_CLOSE_SPACE;
                        carg = rs;
                        cur = after_drop(cur, ss, rs);
                        ss = drop_sessions_in(ss, rs);
                        sp = remove_space(sp, rs);
                        // D. a space bound to a repository hides it: the walk keeps it, the sidebar does not
                        const hp : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, rs));
                        if (dk_len(dk, hp) > 0) {
                            if (msg1(dk[DK_HIDDEN], dk[DK_CONTAINS], hp) == 0) { msg1(dk[DK_HIDDEN], dk[DK_ADD], hp); }
                            msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, rs), dk[DK_EMPTY]);
                        }
                        auto_open = false;
                        dnow = true;
                        if (cur == SESSION_NONE and task != AGENT_QUEEN) { task = CARD_SLOTS; }
                        if (space == rs) { space = space_at_row(sp, 0); }
                    } else {
                        space = rs;
                        ctl = C_SPACE_ROW;
                        carg = space;
                        if (cur != SESSION_NONE and session_space(ss, cur) != space) { cur = SESSION_NONE; task = CARD_SLOTS; }
                    }
                } else if (screen and in_side(mx, ws, collapsed) and row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my) != ROW_NONE) {
                    // W. an agent row selects that chat; N. its x closes it
                    const r : u32 = row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my);
                    const si : u32 = session_at_row(ss, space, r);
                    if (on_row_close(mx, my, row_top(WS_TOP, GROUP_AGENTS, spaces_shown(sp), r))) {
                        if (si == cur) { task = CARD_SLOTS; }
                        ctl = C_CLOSE_CHAT;
                        topen = PANE_NONE;
                        carg = session_agent(ss, si);
                        ss = remove_session(ss, si);
                        cur = after_remove(cur, si);
                    } else {
                        cur = si;
                        task = session_agent(ss, si);
                        ctl = C_AGENT_ROW;
                        carg = task;
                    }
                } else if (home_live and tgv[TPG_O_SEL] != 0) {
                    // O. a formula card is open: any click closes it and goes no further
                    tgv[TPG_O_SEL] = 0;
                } else if (home_live) {
                    const p : u32 = on_tap(STATE_HOME, to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc));
                    if (menu_open(p)) { state = p; shown = p; cons2 = tap_cons(p, false); ctl = C_WORLD; carg = p; }
                    if (menu_open(p) == false and centre_hit(to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc))) {
                        // the CENTRAL BUTTON opens the agents dialog (the chat workspace) as its own screen
                        state = home_tap(p, true);
                        shown = state;
                        cons2 = tap_cons(p, true);
                        ctl = C_WORLD;
                        carg = state;
                    }
                    // O. a click on a formula label (the petals and the centre were asked first) opens its card
                    if (menu_open(p) == false and centre_hit(to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc)) == false) {
                        const oi : i64 = orbit_pick(tgv[0..256], mx, my, sw, sh);
                        if (oi >= 0) { tgv[TPG_O_SEL] = @as(u64, @intCast(oi)) + 1; }
                    }
                }
            }
            if (ty == EV_LEFT_UP and tgv[TPG_K_DRAG] != 0) {
                // K. the drop: kanban.t27 decides, an accepted move stays on the board as a proposal
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                kanban_up(tgv[0..256], tbv[0..49152], mx, my, content_x(home_ws(ws), collapsed), home_view_top(), sw - content_x(home_ws(ws), collapsed));
                used = true;
            }
            if (ty == EV_LEFT_DRAGGED and tgv[TPG_K_DRAG] != 0) { used = true; }
            if (ty == EV_RIGHT_DOWN) {
                // T. a right click on the pane opens its COPY / PASTE / SELECT ALL menu where it landed
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                if (term_click(term_up(screen, topen), mx, my, sw, sh, ws, collapsed, qp or dp or kyp or pfp)) {
                    tgv[TPG_T_MENU] = 1;
                    tgv[TPG_T_MX] = @as(u64, @intFromFloat(ti_menu_x(mx, sw)));
                    tgv[TPG_T_MY] = @as(u64, @intFromFloat(ti_menu_y(my, sh)));
                    tsince = 0;
                    used = true;
                }
            }
            if (ty == EV_LEFT_DRAGGED and tgv[TPG_T_DRAG] != 0 and topen != PANE_NONE) {
                // T. the selection follows the pointer; above or below the pane the view scrolls with it
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                if (my < WS_TOP + HEADER_H + TP_PAD) {
                    vt_view_up(tst[0..32], TI_AUTOSCROLL);
                } else if (my > sh - 6.0) {
                    vt_view_down(tst[0..32], TI_AUTOSCROLL);
                }
                if (cur == SESSION_NONE or rc_docked(rc, cur, session_agent(ss, cur)) == false) {
                    vt_sel_drag(tst[0..32], tcells[0..960000], ti_line_at(tst[0..32], my, WS_TOP + HEADER_H), tp_cell_col(mx, content_x(ws, collapsed), tst[ST_COLS]));
                }
                tsince = 0;
                used = true;
            }
            if (ty == EV_LEFT_UP and tgv[TPG_T_DRAG] != 0) {
                // T. the button is up: a press that never moved selected nothing
                tgv[TPG_T_DRAG] = 0;
                if (tst[ST_SEL] == 2) { vt_sel_clear(tst[0..32]); }
                used = true;
            }
            if (to_agents) {
                // the agents dialog (the chat workspace of the C petal); a first chat is started when none is open
                state = PETAL_CHAT;
                shown = PETAL_CHAT;
                cons2 = false;
                if (cur == SESSION_NONE) {
                    const nk0 : u32 = new_chat_agent(task);
                    const before0 : u32 = session_count(ss);
                    ss = add_session(ss, nk0, space);
                    if (session_count(ss) > before0) { cur = before0; task = nk0; }
                }
            }
            if (ty == EV_SCROLL and screen and sst[SST_LVSEL] != LV_NONE and ws != WS_COMPACT and lv_log_hit(mx, my, content_x(ws, collapsed), WS_TOP + HEADER_H, sw - content_x(ws, collapsed), sh - WS_TOP - HEADER_H) != 0) {
                // L. the wheel scrolls the open log view by lines
                var gdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { gdy = gdy * 16.0; }
                gacc = gacc + gdy;
                const gvis : u32 = lv_log_vis(sh - WS_TOP - HEADER_H);
                var gnl : u32 = 0;
                if (sst[SST_LVKEY] == LV_SCRIPT) {
                    var gst : [40]u32 = undefined;
                    gnl = lv_tail_lines(tbv[TBO_LT .. TBO_LT + @as(usize, sst[SST_LVTAIL])], gst[0..40], LV_TAIL_LINES);
                }
                while (gacc >= LV_LOG_LINE_H) {
                    sst[SST_LVLSCR] = lv_log_scroll(sst[SST_LVLSCR], true, 1, gnl, gvis);
                    gacc = gacc - LV_LOG_LINE_H;
                }
                while (gacc <= -LV_LOG_LINE_H) {
                    sst[SST_LVLSCR] = lv_log_scroll(sst[SST_LVLSCR], false, 1, gnl, gvis);
                    gacc = gacc + LV_LOG_LINE_H;
                }
                used = true;
            } else if (ty == EV_SCROLL and screen and ws == WS_EXPANDED and collapsed == false and in_side(mx, ws, collapsed) and my >= lane_block_top(spaces_shown(sp), sessions_in(ss, space))) {
                // L. the wheel scrolls the LANES block by rows
                var ldy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { ldy = ldy * 16.0; }
                lacc = lacc + ldy;
                const lvis : u32 = lane_block_vis(lane_block_top(spaces_shown(sp), sessions_in(ss, space)), sh);
                while (lacc >= 24.0) {
                    if (sst[SST_LVOFF] > 0) { sst[SST_LVOFF] = sst[SST_LVOFF] - 1; }
                    lacc = lacc - 24.0;
                }
                while (lacc <= -24.0) {
                    sst[SST_LVOFF] = lv_scroll_clamp(sst[SST_LVOFF] + 1, sst[SST_LVN], lvis);
                    lacc = lacc + 24.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and term_up(screen, topen) and on_term(mx, my, sw, sh, ws, collapsed, qp or dp or kyp or pfp) and (qp or dp or kyp or pfp) == false) {
                // T. the wheel over a terminal pane: on the main screen it scrolls the history by sub-row pixels; on the
                // alternate screen it goes to the program as arrows, or as mouse reports when it asked for them (vt.t27)
                const wdy : f64 = msg_real(ev, s_scroll_y);
                const wnotch : bool = msg0(ev, s_precise) % 256 == 0;
                const wunits : u32 = tp_wheel_units(wdy, wnotch);
                const wup : bool = wdy > 0.0;
                if (vt_wheel_route(tst[0..32]) == ROUTE_VIEW) {
                    if (wup) { vt_view_up(tst[0..32], wunits); } else { vt_view_down(tst[0..32], wunits); }
                } else {
                    if (wup != wlast) { wacc = 0; }
                    wlast = wup;
                    wacc = wacc + wunits;
                    // three rows of travel (48 units) make one report of arrows or one mouse report
                    while (wacc >= 3 * VIEW_SUB) {
                        wacc = wacc - 3 * VIEW_SUB;
                        if (cur != SESSION_NONE and rc_docked(rc, cur, session_agent(ss, cur))) { break; }
                        const wn : u32 = vt_wheel_bytes(tst[0..32], wup, tp_cell_col(mx, content_x(ws, collapsed), tst[ST_COLS]), tp_cell_row(my, WS_TOP + HEADER_H, tst[ST_ROWS]), wkeys[0..40]);
                        if (wn > 0 and tlink == PANE_LIVE) {
                            if (client_keys(tfd, tpid, wkeys[0 .. @as(usize, wn)], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                        }
                    }
                }
                tsince = 0;
                used = true;
            }
            if (ty == EV_SCROLL and dp and on_panel(mx, my, sw, WS_TOP)) {
                // D. the panel scrolls a row per 24 pt of wheel or trackpad travel
                var dy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { dy = dy * 16.0; }
                dacc = dacc + dy;
                while (dacc >= 24.0) {
                    doff = doc_scroll(@as(i64, doff) - 1, @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
                    dacc = dacc - 24.0;
                }
                while (dacc <= -24.0) {
                    doff = doc_scroll(@as(i64, doff) + 1, @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
                    dacc = dacc + 24.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and tpg and tpk == PAGE_KANBAN and on_home_view(mx, my, ws, collapsed)) {
                // K. the wheel scrolls every column of the board by cards
                var kdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { kdy = kdy * 16.0; }
                hacc = hacc + kdy;
                while (hacc >= 40.0) {
                    kanban_scroll(tgv[0..256], tbv[0..49152], home_view_h(sh), 0 - 1);
                    hacc = hacc - 40.0;
                }
                while (hacc <= -40.0) {
                    kanban_scroll(tgv[0..256], tbv[0..49152], home_view_h(sh), 1);
                    hacc = hacc + 40.0;
                }
                used = true;
            }
            if (ty == EV_SCROLL and tpg == false and hscreen and dcv[D_LIVE] == 0 and on_home_view(mx, my, ws, collapsed) and ((qp or kyp or dp or pfp) and on_panel(mx, my, sw, WS_TOP)) == false) {
                // H. a home tab's page scrolls with the wheel or trackpad; the offset stays between the top and the end
                var hdy : f64 = msg_real(ev, s_scroll_y);
                if (msg0(ev, s_precise) % 256 == 0) { hdy = hdy * 16.0; }
                hacc = hacc + hdy;
                const hwhole : i64 = @as(i64, @intFromFloat(hacc));
                hacc = hacc - @as(f64, @floatFromInt(hwhole));
                hs = dash_scroll_clamp(hs, 0 - hwhole, dash_total_p(hh, sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
                used = true;
            }
            if (ty == EV_KEY_DOWN) {
                const key : u64 = msg0(ev, s_key);
                const flags : u64 = msg0(ev, s_flags);
                const cmd : bool = has_mod(flags, MOD_COMMAND);
                const digit : u32 = digit_of(key);
                const kp : u32 = petal_for_key(digit, flags);
                used = true;
                if (tpg and tpk == PAGE_BENCH and tgv[TPG_BA_FS] != 0 and cmd == false) {
                    // B. the FLASH dialogue owns the keyboard: characters fill the .bit path, Backspace erases, Return asks for the confirm, Escape cancels
                    if (key == KEY_ESCAPE) {
                        bench_key(tgv[0..256], tbv[0..49152], FE_ESCAPE, 0);
                    } else if (key == TG_KEY_RETURN) {
                        bench_key(tgv[0..256], tbv[0..49152], FE_RETURN, 0);
                    } else if (key == TG_KEY_BACKSPACE) {
                        bench_key(tgv[0..256], tbv[0..49152], TG_EV_BACK, 0);
                    } else {
                        const bc : u64 = msg0(ev, s_chars);
                        var bk : u64 = 0;
                        if (bc != 0) { bk = dk_len(dk, bc); }
                        var bj : u64 = 0;
                        while (bj < bk) {
                            bench_key(tgv[0..256], tbv[0..49152], TG_EV_CHAR, @as(u32, @intCast(msg_char(bc, s_char_at, bj) & 65535)));
                            bj = bj + 1;
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0 and cmd == false) {
                    // the ADD panel owns the keyboard: letters filter the gallery, Backspace erases, Escape closes
                    if (key == KEY_ESCAPE) {
                        dcv[D_ADDP] = 0;
                    } else if (key == 51) {
                        dcv[D_ADDN] = @as(u64, query_pop(@as(u32, @intCast(dcv[D_ADDN]))));
                    } else {
                        const qc : u64 = msg0(ev, s_chars);
                        var qk : u64 = 0;
                        if (qc != 0) { qk = dk_len(dk, qc); }
                        var qj : u64 = 0;
                        while (qj < qk) {
                            const qch : u32 = @as(u32, @intCast(msg_char(qc, s_char_at, qj) & 65535));
                            dcv[D_ADDN] = @as(u64, query_push(pbuf[PB_QUERY .. PB_QUERY + 32], @as(u32, @intCast(dcv[D_ADDN])), qch));
                            qj = qj + 1;
                        }
                    }
                } else if (hscreen and dcv[D_LIVE] != 0 and key != KEY_ESCAPE and cmd == false) {
                    // the live page owns the keyboard; Escape closes it
                    used = false;
                } else if (hscreen and dcv[D_LIVE] != 0 and key == KEY_ESCAPE) {
                    live_hide(dcv[0..512]);
                } else if (key == KEY_J and cmd) {
                    // Q. Cmd+J opens or closes the Queen panel anywhere; with GOD MODE on it stops it
                    const r : u32 = on_queen_key(qp, god);
                    if (god) { ctl = C_GOD_OFF; } else { ctl = C_QUEEN_KEY; }
                    qp = r % 2 == 1;
                    if (qp) { kyp = false; pfp = false; }
                    god = r / 2 % 2 == 1;
                } else if (pfp and pf_editing(tbv[TBO_PF .. TBO_PF + PF_CAP])) {
                    // P. the nickname is being typed: Return saves, Esc cancels, Backspace drops a code point, Cmd+V pastes text
                    const pk : u32 = ky_key(@as(u32, @intCast(key)), cmd);
                    if (pk == KE_CANCEL) {
                        pf_leave(tbv[TBO_PF .. TBO_PF + PF_CAP], PRF_EV_CANCEL);
                    } else if (pk == KE_BACK) {
                        pf_back(tbv[TBO_PF .. TBO_PF + PF_CAP]);
                    } else if (pk == KE_SAVE) {
                        pf_save(tbv[TBO_PF .. TBO_PF + PF_CAP]);
                    } else if (pk == KE_PASTE) {
                        const ppb : u64 = msg0(cls("NSPasteboard"), sel("generalPasteboard"));
                        const pps : u64 = msg1(ppb, sel("stringForType:"), cf("public.utf8-plain-text"));
                        if (pps != 0) {
                            const ppn : usize = ns_bytes(pps, ktmp[0..256]);
                            pf_paste_in(tbv[TBO_PF .. TBO_PF + PF_CAP], ktmp[0..ppn]);
                        }
                    } else if (pk == KE_CHAR) {
                        const pc : u64 = msg0(ev, s_chars);
                        var pn : u64 = 0;
                        if (pc != 0) { pn = dk_len(dk, pc); }
                        var pj : u64 = 0;
                        while (pj < pn) {
                            pf_unit(tbv[TBO_PF .. TBO_PF + PF_CAP], @as(u32, @intCast(msg_char(pc, s_char_at, pj) & 65535)));
                            pj = pj + 1;
                        }
                    } else {
                        used = false;
                    }
                } else if (pfp and key == KEY_ESCAPE and cmd == false) {
                    // P. Escape outside an edit closes the PROFILE panel
                    pf_leave(tbv[TBO_PF .. TBO_PF + PF_CAP], PRF_EV_CLOSE);
                    pfp = false;
                } else if (kyp and kedit != KY_NONE and qp == false and dp == false) {
                    // K. a key is being typed: Return saves it to the Keychain, Esc cancels, Cmd+V pastes
                    const kk : u32 = ky_key(@as(u32, @intCast(key)), cmd);
                    if (kk == KE_CANCEL) {
                        keys_wipe(kbuf[0..256]);
                        kedit = KY_NONE;
                        klen = 0;
                    } else if (kk == KE_BACK) {
                        if (klen > 0) {
                            klen = klen - 1;
                            kbuf[@as(usize, klen)] = 0;
                        }
                    } else if (kk == KE_SAVE) {
                        if (sec_key_safe(kbuf[0 .. @as(usize, klen)])) {
                            // the key takes the lowest free number of its provider, never an existing one
                            const ksn : u32 = next_free_key(kstored[kedit]);
                            if (ksn < MAX_KEYS) {
                                if (kc_put_n(kedit, ksn, kbuf[0 .. @as(usize, klen)])) {
                                    kst[key_index(kedit, ksn)] = ST_STORED;
                                    kfail[kedit] = 0;
                                    if (tfd >= 0) { client_set_key(tfd, setkey_byte(kedit, ksn), kbuf[0 .. @as(usize, klen)], tout[0..4100]); }
                                }
                            }
                            keys_wipe(kbuf[0..256]);
                            keys_refresh(kstored[0..9], kmask[0..544], kmlen[0..9]);
                            kedit = KY_NONE;
                            klen = 0;
                        }
                    } else if (kk == KE_PASTE) {
                        const pb : u64 = msg0(cls("NSPasteboard"), sel("generalPasteboard"));
                        const ps : u64 = msg1(pb, sel("stringForType:"), cf("public.utf8-plain-text"));
                        if (ps != 0) {
                            const pn : usize = ns_bytes(ps, ktmp[0..256]);
                            const tn : usize = trim_key(ktmp[0..pn], kbuf[0..256]);
                            klen = @as(u32, @intCast(tn));
                            if (klen > MAX_KEY_CHARS) { klen = MAX_KEY_CHARS; }
                            keys_wipe(ktmp[0..256]);
                        }
                    } else if (kk == KE_CHAR) {
                        const kc : u64 = msg0(ev, s_chars);
                        var kn : u64 = 0;
                        if (kc != 0) { kn = dk_len(dk, kc); }
                        var kj : u64 = 0;
                        while (kj < kn) {
                            const ch : u32 = @as(u32, @intCast(msg_char(kc, s_char_at, kj) & 65535));
                            if (ky_accepts(klen, ch)) {
                                kbuf[@as(usize, klen)] = @as(u8, @intCast(ch));
                                klen = klen + 1;
                            }
                            kj = kj + 1;
                        }
                    } else {
                        used = false;
                    }
                } else if (key == KEY_ESCAPE and sst[SST_QDASH] != 0 and cmd == false) {
                    // the CONTROL DASHBOARD closes first
                    sst[SST_QDASH] = 0;
                } else if (key == KEY_ESCAPE and god) {
                    god = false;
                    ctl = C_GOD_OFF;
                } else if (key == KEY_ESCAPE and dp) {
                    dp = false;
                    darmed = ARMED_NONE;
                } else if (key == KEY_ESCAPE and sst[SST_LVSEL] != LV_NONE and cmd == false) {
                    // L. Escape closes a lane's log view first
                    sst[SST_LVSEL] = lv_log_event(sst[SST_LVSEL], LVE_ESC, 0);
                } else if (tpg and tpk == PAGE_VIZ_SPECS and cmd == false and qp == false and kyp == false and pfp == false and specs_viz_key_takes(tbv[0..TB_SIZE], key)) {
                    // S. the SPECS page: arrows step and focus, Space flips an edge, S M X pick the aggregation, Esc clears a selection;
                    // a key the petal's map leaves alone (Esc with nothing selected, the digits) goes on down this chain
                    specs_viz_key(tgv[0..256], tbv[0..TB_SIZE], key);
                } else if (tpg and tpk == PAGE_VIZ_GNN and cmd == false and qp == false and kyp == false and pfp == false and gnn_page_key_takes(tgv[0..256], key)) {
                    // S2. the GNN work-graph page (t27#12370): Left and Right step k, Up and Down walk the focus, Return pins the
                    // focused node, Esc and Backspace clear a pin; a key the page's map leaves alone (Esc with nothing pinned, the
                    // digits) goes on down this chain
                    gnn_page_key(tgv[0..256], key);
                } else if (topen != PANE_NONE and screen and (cmd == false or tk_cmd_is_pane(@as(u32, @intCast(key))))) {
                    // T. the terminal pane takes every key without Cmd, Esc included, as bytes (term_input.t27); of the Cmd
                    // keys it takes copy, paste, select all and the line keys (Left, Right, Backspace); the window's
                    // shortcuts (T W F K + - , 1..9) never reach it
                    const ctrl : bool = has_mod(flags, MOD_CONTROL);
                    var chs : u64 = msg0(ev, s_chars);
                    if (ctrl) { chs = msg0(ev, s_chars_raw); }
                    var cp : u32 = 0;
                    if (chs != 0 and dk_len(dk, chs) > 0) { cp = @as(u32, @intCast(msg_char(chs, s_char_at, 0) & 65535)); }
                    var kn : u32 = tk_key_bytes(@as(u32, @intCast(key)), cp, @as(u32, @intCast(flags % 4294967296)), tst[ST_APPCUR] != 0, tkey[0..8]);
                    if (cmd) { tact = tk_cmd_route(@as(u32, @intCast(key))); }
                    if (tact == CMD_COPY or tact == CMD_PASTE or tact == CMD_SELECT_ALL) { kn = 0; } else { tact = 0; }
                    // RC. while the QUEEN CHAT is docked the keystrokes build the input line, not the raw
                    // pane bytes: printable units join it, Backspace takes one back, Return sends the line
                    // plus CR into her pane and clears it
                    var rcdk : bool = false;
                    if (cur != SESSION_NONE) { rcdk = rc_docked(rc, cur, session_agent(ss, cur)); }
                    if (rcdk and topen != VIEW_EDITOR) {
                        kn = 0;
                        vt_to_live(tst[0..32]);
                        vt_sel_clear(tst[0..32]);
                        if (key == TG_KEY_RETURN) {
                            if (tlink == PANE_LIVE) {
                                const rn : usize = rc_payload(tbv[TBO_RC .. TBO_RC + RC_TEXT_MAX + 1]);
                                if (client_keys(tfd, tpid, tbv[TBO_RC .. TBO_RC + rn], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                                ctl = C_QUEEN_SENT;
                            }
                            rc_clear(tbv[TBO_RC .. TBO_RC + RC_CAP]);
                        } else if (key == TG_KEY_BACKSPACE) {
                            rc_back(tbv[TBO_RC .. TBO_RC + RC_CAP]);
                        } else if (cmd == false and cp >= 32 and cp < 127) {
                            rc_type(tbv[TBO_RC .. TBO_RC + RC_CAP], @as(u8, @intCast(cp)));
                        }
                    }
                    if (tgv[TPG_T_MENU] != 0) {
                        // a key closes the right-click menu; Escape only closes it
                        tgv[TPG_T_MENU] = 0;
                        if (key == KEY_ESCAPE) { kn = 0; }
                    }
                    // the editor view: Escape twice in a second closes it (esc_twice); the first still reaches the editor
                    if (topen == VIEW_EDITOR and key == KEY_ESCAPE) {
                        if (esc_twice(eesc, now)) {
                            eview = false;
                            eesc = 0;
                            kn = 0;
                        } else {
                            eesc = now;
                        }
                    }
                    if (kn > 0) {
                        vt_to_live(tst[0..32]);
                        vt_sel_clear(tst[0..32]);
                        if (tlink == PANE_LIVE) {
                            if (client_keys(tfd, tpid, tkey[0 .. @as(usize, kn)], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                        } else {
                            const en : u32 = tp_echo(tkey[0..8], kn, techo[0..8]);
                            var ei : u32 = 0;
                            while (ei < en) { vt_feed(tst[0..32], tcells[0..960000], techo[ei]); ei = ei + 1; }
                        }
                    }
                    tsince = 0;
                } else if (key == KEY_ESCAPE) {
                    state = on_back(state);
                } else if (cmd and digit == 0) {
                    state = on_back(state);
                } else if (kp != PETAL_NONE and menu_open(state) == false) {
                    state = kp;
                    shown = kp;
                    cons2 = tap_cons(kp, false);
                } else if (agents_key(key, flags) and menu_open(state) == false) {
                    // Cmd+Enter at home: the agents dialog
                    state = PETAL_CHAT;
                    shown = PETAL_CHAT;
                    cons2 = false;
                } else if (key == KEY_S and cmd and has_mod(flags, MOD_SHIFT)) {
                    collapsed = collapsed == false;
                } else if (key == KEY_F and cmd and has_mod(flags, MOD_CONTROL)) {
                    msg1(win, s_full, 0);
                } else {
                    used = false;
                }
            }
            // T. copy, paste, select all (a key, or a row of the right-click menu); the host calls are pb_copy and pb_text
            if (tact != 0 and topen != PANE_NONE) {
                if (tact == CMD_COPY) {
                    const tcn : usize = ti_sel_text(tst[0..32], tcells[0..960000], tclip[0..262144]);
                    if (tcn > 0) { pb_copy(tclip[0..262144], tcn); }
                } else if (tact == CMD_SELECT_ALL) {
                    vt_sel_all(tst[0..32]);
                } else if (tact == CMD_PASTE) {
                    const tpn : usize = pb_text(tclip[0..262144]);
                    // RC. pasting into the dock joins the printable bytes of the line, capped
                    if (tpn > 0 and cur != SESSION_NONE and rc_docked(rc, cur, session_agent(ss, cur))) {
                        rc_paste(tbv[TBO_RC .. TBO_RC + RC_CAP], tclip[0..262144], tpn);
                    } else if (tpn > 0 and tlink == PANE_LIVE) {
                        const tpl : usize = ti_paste(tst[ST_BRPASTE] != 0, tclip[0 .. tpn], tpaste[0..262144]);
                        vt_to_live(tst[0..32]);
                        vt_sel_clear(tst[0..32]);
                        var tpo : usize = 0;
                        while (tpo < tpl) {
                            var tck : usize = tpl - tpo;
                            if (tck > 4000) { tck = 4000; }
                            if (client_keys(tfd, tpid, tpaste[tpo .. tpo + tck], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; tpo = tpl; } else { tpo = tpo + tck; }
                        }
                    }
                }
                tsince = 0;
            }
            // Q. every control the user pressed goes into the ring the Queen reads
            if (ctl != C_NONE) {
                ring[ring_next(evn)] = ev_pack(view_of(menu_open(state), shown), ctl, carg, now);
                evn = evn + 1;
                last_user = now;
                if (ctl != C_DISMISS) { dismissed = RING_NONE; }
            }
            if (used == false) { msg1(app, s_send, ev); }
            ev = msg_event(app, s_next, 0xffffffffffffffff, 0, mode, true);
        }
        // T. the right-click menu and a held selection press belong to a pane that is up
        if (term_up(screen, topen) == false) {
            tgv[TPG_T_MENU] = 0;
            tgv[TPG_T_DRAG] = 0;
        }
        // H. another home starts at its top; a resized window holds the offset inside its page
        if (shown != hs_for) {
            live_hide(dcv[0..512]);
            hs = 0;
            hacc = 0.0;
            hs_for = shown;
            tgv[TPG_DASH] = 0;
            tgv[TPG_K_DRAG] = 0;
            tgv[TPG_BA_FS] = 0;
            dcv[D_ADDP] = 0;
            dcv[D_ADDN] = 0;
            dcv[D_PINN] = @as(u64, pins_load(dhb[0..dhn], letter_of_petal(shown), pbuf[0..4160]));
            dcv[D_PINLET] = @as(u64, letter_of_petal(shown));
        }
        hs = dash_scroll_clamp(hs, 0, dash_total_p(letter_of_petal(shown), sw, content_x(home_ws(ws), collapsed), pins_n(dcv[0..512], pbuf[0..4160])), home_view_h(sh));
        if (menu_open(state) == false) { cons2 = false; }
        if (dcv[D_LIVE] != 0 and (menu_open(state) == false or (shown == PETAL_CHAT and cons2 == false))) { live_hide(dcv[0..512]); }
        // B / K / Q. the tool pages' host feeds: reap finished jobs every frame, start a refresh while the page is open
        const tpk2 : u32 = page_kind(letter_of_petal(shown));
        const open2 : bool = menu_open(state) and ma >= 0.5 and shown != PETAL_CHAT and tgv[TPG_DASH] == 0 and dcv[D_LIVE] == 0;
        if (open2 and tpk2 == PAGE_QUEEN) {
            tgv[TPG_Q_GOD] = 0;
            if (god) { tgv[TPG_Q_GOD] = 1; }
            tgv[TPG_Q_EVFL] = @as(u64, evfl);
            tgv[TPG_Q_EVN] = @as(u64, evn);
            var tqm : u32 = 0;
            var tqp : u32 = 0;
            while (tqp < PROVIDER_COUNT) {
                if (kstored[tqp] != 0) { tqm = tqm + (1 << tqp); }
                tqp = tqp + 1;
            }
            tgv[TPG_Q_TIER] = @as(u64, tier_of(tqm));
            tgv[TPG_Q_UNASS] = @as(u64, qb_nm());
            if (dcv[D_GN] > 0) { tgv[TPG_Q_UNASS] = @as(u64, gal_unassigned(gt[0..2560])); }
            var tqr : u32 = 0;
            while (tqr < RING) {
                tgv[TPG_Q_RING + tqr] = ring[tqr];
                tqr = tqr + 1;
            }
            tgv[TPG_Q_ROOTLEN] = @as(u64, qn_root(dk, space, tbv[0..49152]));
        }
        bench_tick(tgv[0..256], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_BENCH);
        kanban_tick(tgv[0..256], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_KANBAN);
        queen_tick(tgv[0..256], tbv[0..49152], dhb[0..dhn], now, open2 and tpk2 == PAGE_QUEEN);
        // H. HIVE: the page's feed while it is open, and this machine's heartbeat every 5 minutes (devices.t27): the lanes
        // feed runs first, so the beat carries the lanes as they are now, then hive_publish pushes refs/swarm/alive/<host>
        const hv_up : bool = open2 and tpk2 == PAGE_HIVE;
        // G. AGENTS: the same feed job as HIVE, run while the AGENTS page is open (one petal at a time, so the
        // two ticks never race); the root it needs is computed for either page, and the lanes table is refreshed
        // for either too, so THIS AGENT's lanes read live while this page is open.
        const ag_up : bool = open2 and tpk2 == PAGE_AGENTS;
        if (tgv[TPG_H_WANT] == 0 and tgv[TPG_H_PUB_PID] == 0 and dv_publish_due(true, now, tgv[TPG_H_PUB_LAST])) {
            tgv[TPG_H_WANT] = now;
            tgv[TPG_H_PUB_LAST] = now;
        }
        if (hv_up or ag_up or tgv[TPG_H_WANT] != 0) { tgv[TPG_Q_ROOTLEN] = @as(u64, qn_root(dk, space, tbv[0..49152])); }
        hive_tick(tgv[0..256], tbv[0..71936], dhb[0..dhn], now, hv_up);
        lg_tick(tgv[0..256], tbv[0..TB_SIZE], dhb[0..dhn], now, open2 and tpk2 == PAGE_LOGS);
        ag_tick(tgv[0..256], tbv[0..TB_SIZE], dhb[0..dhn], now, ag_up);
        update_tick(tgv[0..256], tbv[0..49152], dhb[0..dhn], ubp[0..ubn], now, up_busy(sst[0..560]));
        // the live data (hot_reload.t27): read again after every poll (and once at launch), applied on the next frame
        if (tgv[TPG_V_DIRTY] != 0) {
            tgv[TPG_V_DIRTY] = 0;
            if (live_load(tgv[0..256], tbv[0..49152], dhb[0..dhn], kit[0..48])) {
                // the window tint lives on the layer, not in a frame: set it again (the full window and full
                // screen keep their opaque black -- on_glass(sw) decides, not the live level)
                if (on_glass(sw)) {
                    msg1(layer, sel("setBackgroundColor:"), cg_color(GROUND_RGB, GROUND_RGB, GROUND_RGB, lv(kit, THV_TINT_BLACK)));
                }
                tg_bump(tgv[0..256]);
            }
        }
        // S. the footer bar's host reads: free disk every 10 s; the GOD tick (statusbar.t27 god_tick_due)
        if (now >= tgv[TPG_SB_AT] + 10) {
            tgv[TPG_SB_AT] = now;
            const sfm : u64 = msg0(cls("NSFileManager"), sel("defaultManager"));
            const sfk : u64 = cf("NSFileSystemFreeSize");
            const sfp : u64 = cf("/");
            const sfa : u64 = msg2(sfm, sel("attributesOfFileSystemForPath:error:"), sfp, 0);
            if (sfa != 0) {
                const sfn : u64 = msg1(sfa, sel("objectForKey:"), sfk);
                if (sfn != 0) { sst[SST_DISK] = @as(u32, @intCast(msg0(sfn, sel("unsignedLongLongValue")) / 1073741824)) + 1; }
            }
            cf_release(sfk);
            cf_release(sfp);
            tgv[TPG_G_NEXT] = 0;
            if (god) { tgv[TPG_G_NEXT] = @as(u64, evolve_next(evfl, evst, gal_unassigned(gt[0..2560]))); }
        }
        var qdk : u32 = 0;
        var qdp : u32 = 0;
        while (qdp < PROVIDER_COUNT) {
            if (kstored[qdp] != 0) { qdk = qdk + (1 << qdp); }
            qdp = qdp + 1;
        }
        tgv[TPG_QD_FLAGS] = qd_fl_with_keys(tgv[TPG_QD_FLAGS], qdk, sb_worst_light(sst[0..560]));
        qd_tick(tgv[0..256], tbv[0..77312], dhb[0..dhn], now, sst[SST_QDASH] != 0 and screen);
        god_tick(tgv[0..256], tbv[0..65536], dhb[0..dhn], now, god, sst[SST_QRUN]);
        // L. the LANES block of the chat sidebar: the feed job, the tail of a clicked lane, the table once a second
        const lvup : bool = menu_open(state) and ma >= 0.5 and shown == PETAL_CHAT and cons2 == false and ws == WS_EXPANDED and collapsed == false;
        if (lvcur != cur) { sst[SST_LVSEL] = LV_NONE; }
        lvtail = 0;
        if (lvup and sst[SST_LVSEL] != LV_NONE and sst[SST_LVKEY] == LV_SCRIPT) { lvtail = sst[SST_LVKEY + 1]; }
        lanes_tick(tgv[0..256], tbv[0..65536], dhb[0..dhn], now, lvup or hv_up or ag_up or tgv[TPG_H_WANT] != 0, lvtail);
        sst[SST_LVTAIL] = @as(u32, @intCast(tgv[TPG_L_TLEN]));
        if ((lvup or hv_up or ag_up) and now != lvat) {
            lvat = now;
            lanes_build(sst[0..560], tbv[0..65536], tgv[0..256], ss, space, god, @as(u32, @intCast(now)));
            hive_lanes(tgv[0..256], tbv[0..71936], sst[0..560]);
        }
        if (tgv[TPG_H_WANT] != 0 and tgv[TPG_L_PID] == 0 and tgv[TPG_L_LAST] >= tgv[TPG_H_WANT]) {
            lanes_build(sst[0..560], tbv[0..65536], tgv[0..256], ss, space, god, @as(u32, @intCast(now)));
            hive_lanes(tgv[0..256], tbv[0..71936], sst[0..560]);
            hive_publish(tgv[0..256], tbv[0..71936], dhb[0..dhn], now);
            tgv[TPG_H_WANT] = 0;
        }
        // O. the formula orbit: reduced motion is read once a second, the layout and the clock every frame
        if (tgv[TPG_O_RMAT] != now) {
            tgv[TPG_O_RMAT] = now;
            tgv[TPG_O_RMSYS] = 0;
            if (msg0(msg0(cls("NSWorkspace"), sel("sharedWorkspace")), sel("accessibilityDisplayShouldReduceMotion")) % 256 != 0) { tgv[TPG_O_RMSYS] = 1; }
        }
        // H. the heartbeat: once a second, the pty server's supervisor reads it (see beat_write)
        if (tgv[TPG_BEAT_AT] != now) {
            tgv[TPG_BEAT_AT] = now;
            beat_write(dhb[0..dhn], now);
        }
        orbit_tick(tgv[0..256], z, sw, sh, mx, my, abs_time(), tgv[TPG_O_RMSYS] != 0);
        if (menu_open(state) and (shown != PETAL_CHAT or cons2)) {
            dash_tick(dcv[0..512], gal[0..49152], gt[0..2560], dhb[0..dhn], jpid[0..6], jwi[0..6], now);
            thumbs_load(dcv[0..512], gal[0..49152], gt[0..2560], dhb[0..dhn]);
            if (dcv[D_WEB] != 0) {
                const wcx : f64 = content_x(home_ws(ws), collapsed);
                const wvt : f64 = home_view_top();
                const wsc : f64 = fit(fr[2], fr[3], sw, sh);
                msg_rect(dcv[D_WEB], sel("setFrame:"), view_x(live_x(wcx), fr[2], sw, wsc), view_y(live_y(wvt), live_h(sh, wvt), fr[3], sh, wsc), live_w(sw, wcx) * wsc, live_h(sh, wvt) * wsc);
            }
        }
        // K. a check button: the frame after the click shows "checking", then one number of the provider is
        // read and probed per frame (a probe blocks up to PROBE_TIMEOUT_S); its HTTP answer sets that key's status
        // and feeds the circuit breaker (keys.t27). Every stored key of the provider is checked, none is skipped.
        if (kbusy != KY_NONE) {
            if (kpend == 0) {
                kpend = 1;
            } else if (kbk >= MAX_KEYS) {
                kbusy = KY_NONE;
                kpend = KY_NONE;
                kbk = 0;
            } else {
                const kn2 : usize = kc_get_n(kbusy, kbk, ktmp[0..256]);
                if (kn2 > 0) {
                    const http : u32 = probe(kbusy, ktmp[0 .. kn2]);
                    const kix : usize = key_index(kbusy, kbk);
                    kfail[kbusy] = circuit_fails(kfail[kbusy], http);
                    if (kfail[kbusy] >= CIRCUIT_FAILS and kopen[kbusy] + 60 <= now) { kopen[kbusy] = now; }
                    kst[kix] = status_after_probe(kst[kix], http);
                    // M12: a key that failed its check is withheld from the server, so rotation skips it and the
                    // next claude pane takes the next profile when none is left (keys.t27 pick_profile); a key
                    // that passed is handed over again
                    if (tfd >= 0) {
                        if (key_withheld(kst[kix])) {
                            client_set_key(tfd, setkey_byte(kbusy, kbk), "", tout[0..4100]);
                        } else {
                            client_set_key(tfd, setkey_byte(kbusy, kbk), ktmp[0 .. kn2], tout[0..4100]);
                        }
                    }
                }
                keys_wipe(ktmp[0..256]);
                kbk = kbk + 1;
            }
        }
        // K. pre-flight (M12): once at start, check the stored key behind each claude profile, in the order
        // keys.t27 PROFILE_PROVIDER gives (all PROFILE_COUNT of them), so the first pane already avoids a dead key
        if (kbusy == KY_NONE and kpre < PROFILE_COUNT) {
            const kpp : u32 = PROFILE_PROVIDER[kpre];
            kpre = kpre + 1;
            if (probe_has(kpp) and kc_has(kpp)) {
                kbusy = kpp;
                kbk = 0;
                kpend = 0;
            }
        }
        // D. the walk: a slice of folders per frame; a finished pass forgets what it did not see, then rests
        if (walking) {
            qhead = dk_walk(dk, qhead, wpass);
            if (qhead >= dk_count(dk, dk[DK_QUEUE])) {
                if (dk_sweep(dk, wpass) > 0) { darmed = ARMED_NONE; }
                walking = false;
                qhead = 0;
                widle = 0;
                dnow = true;
            }
        } else {
            widle = widle + 1;
            if (pass_due(widle)) {
                wpass = wpass + 1;
                dk_start_pass(dk);
                walking = true;
            }
        }
        // D. the checks: JOB_SLOTS git / du jobs at a time, each repository in turn, then a rest
        var js : u64 = 0;
        while (js < @as(u64, JOB_SLOTS)) {
            const jt : u64 = dk_at(dk, dk[DK_TASKS], js);
            if (jt != dk[DK_NULL]) {
                if (msg0(jt, dk[DK_RUNNING]) % 256 == 0) {
                    dk_take(dk, js, msg0(jt, dk[DK_STATUS]) % 4294967296);
                    msg2(dk[DK_TASKS], dk[DK_REPLACE], js, dk[DK_NULL]);
                    dnow = true;
                }
            } else if (jrest == 0 and dk_count(dk, dk[DK_PATHS]) > 0) {
                if (jr >= dk_count(dk, dk[DK_PATHS])) {
                    jr = 0;
                    jj = 0;
                    jpass = jpass + 1;
                    jrest = RESCAN_FRAMES;
                } else {
                    while (jj < JOB_COUNT and job_wanted(jj, jpass, dk_flags(dk, jr)) == false) { jj = jj + 1; }
                    if (jj < JOB_COUNT) {
                        const nt : u64 = dk_launch(dk, js, dk_at(dk, dk[DK_PATHS], jr), jj);
                        if (nt != 0) {
                            msg2(dk[DK_TASKS], dk[DK_REPLACE], js, nt);
                            msg0(nt, dk[DK_RELEASE]);
                        }
                        jj = jj + 1;
                    }
                    if (jj >= JOB_COUNT) {
                        jj = 0;
                        jr = jr + 1;
                    }
                }
            }
            js = js + 1;
        }
        if (jrest > 0) { jrest = jrest - 1; }
        // D. a deleted clone or worktree vanishes within a lap: one repository's .git checked per frame
        const vn : u64 = dk_count(dk, dk[DK_PATHS]);
        if (vn > 0) {
            if (vr >= vn) { vr = 0; }
            if (dk_exists(dk, msg1(dk_at(dk, dk[DK_PATHS], vr), dk[DK_APPEND_PATH], dk[DK_GIT])) == false) {
                dk_drop(dk, vr);
                darmed = ARMED_NONE;
                dnow = true;
            } else {
                vr = vr + 1;
            }
        }
        // D. the sums, the panel rows and the sidebar slots, every DOC_SUM_EVERY frames or when something moved
        if (dnow or frame % DOC_SUM_EVERY == 0) {
            dgo = dk_recompute(dk);
            var bsl : u32 = 0;
            while (bsl < SPACE_COUNT) {
                const bound : bool = dk_len(dk, dk_at(dk, dk[DK_SLOTS], @as(u64, bsl))) > 0;
                if (space_is_open(sp, bsl) == false and bound) {
                    msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, bsl), dk[DK_EMPTY]);
                } else if (space_is_open(sp, bsl) and bound == false) {
                    dk_bind(dk, bsl, RANK_AUTO);
                }
                bsl = bsl + 1;
            }
            var more : bool = auto_open;
            while (more and spaces_shown(sp) < SPACES_AUTO and new_space(sp) != SPACE_NONE) {
                const ns : u32 = new_space(sp);
                if (dk_bind(dk, ns, RANK_AUTO)) { sp = add_space(sp, ns); } else { more = false; }
            }
            dk_names(dk, kit[K_SPACE_NAMES], kit[K_BRANCHES]);
            msg2(defs, dk[DK_SET_OBJ], dk[DK_SLOTS], k_slots);
            msg2(defs, dk[DK_SET_OBJ], dk[DK_HIDDEN], k_hidden);
            dnow = false;
        }
        if (qp) { dp = false; }
        doff = doc_scroll(@as(i64, doff), @as(u32, @intCast(dk_count(dk, dk[DK_ROWS]))), doc_rows(sh, WS_TOP));
        var dlabel : u64 = dk_word(dk, DL_TITLE);
        if (dgo > 0) { dlabel = dk_cat(dk, dk_word(dk, DL_FOOT), dk_int(dk, @as(u64, dgo))); }
        // T. the terminal pane: a Claude Code chat on screen opens it in its space's folder (home when
        // the space is unbound); a new chat or a new size starts the grid over and replays the pane's
        // output from the server's ring; an offline pane tries the server again every TP_RETRY frames.
        // The same code shows the editor pane when the strip's "T27 OS" chip opened one (view_key): `want` is
        // the chat index, VIEW_EDITOR or nothing; the editor view ends when the screen leaves its chat or space.
        // T. the pane server starts itself: if ~/.t27os/pty.sock does not answer, the t27os-pty next to the app is started
        // by one backgrounded `sh -c` job (it outlives the app: the app never stops it, it owns the panes' history)
        if (srvpid != 0 and tg_done(srvpid) != 0) { srvpid = 0; }
        if (screen) {
            srvw = srvw + 1;
            if (tfd < 0 and srvp != SRV_FAILED and srvw % TP_START_POLL == 1) { tfd = term_connect(thome[0..256]); }
            var snp : u32 = tp_server_step(srvp, tfd >= 0, srvw);
            if (srvretry) {
                srvretry = false;
                srvp = SRV_FAILED;
                snp = SRV_STARTING;
            }
            if (tp_server_spawn_due(srvp, snp)) {
                srvw = 0;
                var exeb : [512]u8 = undefined;
                const exn : usize = ns_bytes(msg0(msg0(cls("NSBundle"), sel("mainBundle")), sel("executablePath")), exeb[0..512]);
                var scmd : [700]u8 = undefined;
                const sk : usize = tp_server_cmd(exeb[0..exn], scmd[0..700]);
                if (sk == 0) {
                    snp = SRV_FAILED;
                } else {
                    var se : usize = tg_head(tbv[0..65536], dhb[0..dhn], FEED_HEAD_A, TP_SRV_HEAD_B);
                    se = put_bytes(tbv[0..65536], se, scmd[0..sk]);
                    srvpid = tg_spawn(tbv[0..65536], TBO_CMD, se);
                    if (srvpid == 0) { snp = SRV_FAILED; }
                }
            }
            if (snp == SRV_UP and srvp != SRV_UP) { ttry = TP_RETRY; }
            srvp = snp;
        }
        sst[SST_SRV] = srvp;
        if (editor_view_stays(eview, screen, cur, ecur, space, esp) == false) { eview = false; }
        const want : u32 = view_key(eview, cur != SESSION_NONE and opens_pane(session_agent(ss, cur)), cur);
        if (screen and want != PANE_NONE) {
            const toy : f64 = WS_TOP + HEADER_H;
            const rcdock : bool = cur != SESSION_NONE and rc_docked(rc, cur, session_agent(ss, cur));
            // the grid ends at the left edge of an open right-hand panel: the pty gets the narrower size
            // through the resize below, and nothing of the terminal is under the panel. The docked QUEEN
            // CHAT is its own area instead: the grid then takes the dock's transcript dims.
            var tw : f64 = content_w(sw, ws, collapsed, qp or dp or kyp or pfp);
            var th : f64 = sh - toy;
            var rct : [4]f64 = undefined;
            var chat_docked : bool = false;
            if (rcdock and rc_term_rect(sw, sh, WS_TOP, SB_H, rct[0..4])) { tw = rct[2]; th = rct[3]; chat_docked = true; }
            var tgc : u32 = tp_cols(tw);
            var tgr : u32 = tp_rows(th);
            if (chat_docked) { tgc = rc_grid_cols(tw); tgr = rc_grid_rows(th); }
            // a drag changes the size every frame: the pane takes it once it has held TP_SETTLE frames, so
            // the grid and the ring replay run once per resize instead of once per frame
            tstable = tp_settle(tstable, tgc == twc and tgr == twr);
            twc = tgc;
            twr = tgr;
            var tgo : bool = tp_reset_due(topen, want) or tp_size_due(tst[ST_COLS], tst[ST_ROWS], tw, th, tstable);
            if (tlink == PANE_OFFLINE and topen == want) {
                ttry = ttry + 1;
                if (tp_retry_due(ttry)) {
                    ttry = 0;
                    if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                    if (tfd >= 0) { tgo = true; }
                }
            }
            if (tgo) {
                vt_init(tst[0..32], tcells[0..960000], tgc, tgr);
                tcursor = 0;
                var tsp : u32 = espace;
                if (want != VIEW_EDITOR) { tsp = session_space(ss, cur); }
                var tcwd : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, tsp));
                if (dk_len(dk, tcwd) == 0) { tcwd = home_dir(); }
                if (topen != want or tlink != PANE_LIVE) {
                    tpid = PANE_NONE;
                    if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                    if (tfd >= 0) {
                        if (want == VIEW_EDITOR) { tpid = epane; } else { tpid = term_open(tfd, ss, cur, tcwd, tout[0..4100], tdir[0..512]); }
                    }
                    if (tpid != PANE_NONE and client_attach(tfd, tpid, tout[0..4100]) == 0) { tpid = PANE_NONE; }
                    if (tpid == PANE_NONE) { tlink = PANE_OFFLINE; } else { tlink = PANE_LIVE; }
                    // the editor pane is gone (the server restarted, or it was killed): back to the chat
                    if (tpid == PANE_NONE and want == VIEW_EDITOR) {
                        eview = false;
                        epane = PANE_NONE;
                    }
                    if (tpid == PANE_NONE and tfd >= 0) {
                        sys_close(tfd);
                        tfd = -1;
                    }
                }
                // the pty takes the new grid before the replay, so the program redraws at the full width
                if (tlink == PANE_LIVE) { client_resize(tfd, tpid, tst[ST_COLS], tst[ST_ROWS], tout[0..4100]); }
                if (tlink == PANE_OFFLINE) { term_banner(tst[0..32], tcells[0..960000], tcwd); }
                topen = want;
                tsince = 0;
                ttry = 0;
                tfed = tfed + 1;
            }
            if (tlink == PANE_LIVE) {
                var treads : u32 = 0;
                var tmore : bool = true;
                while (tmore) {
                    const rn : usize = client_read(tfd, tpid, tcursor, tout[0..4100]);
                    if (rn == 0) {
                        // the server went away: drop the socket; the retry finds it again after a restart
                        tmore = false;
                        tlink = PANE_OFFLINE;
                        sys_close(tfd);
                        tfd = -1;
                    } else {
                        const dn : usize = tp_data_len(tout[0..4100], rn);
                        if (dn > 0) {
                            tcursor = reply_cursor(tout[0..4100]);
                            tfed = tfed + 1;
                        }
                        var gi : usize = 0;
                        while (gi < dn) { vt_feed(tst[0..32], tcells[0..960000], tout[TP_DATA_AT + gi]); gi = gi + 1; }
                        treads = treads + 1;
                        tmore = tp_read_more(dn, treads);
                    }
                }
            }
            // a line asked for by CREATE NEW, a command or a skill widget is typed into the commander once the pane is live
            // (not sent: the user finishes it and presses Return)
            if (dcv[D_PREN] > 0 and tlink == PANE_LIVE and topen == want) {
                if (client_keys(tfd, tpid, pbuf[PB_PRE .. PB_PRE + @as(usize, dcv[D_PREN])], tout[0..4100]) == 0) { tlink = PANE_OFFLINE; }
                dcv[D_PREN] = 0;
            }
        } else {
            topen = PANE_NONE;
        }
        // the rows of the agents dialog show the state the server lists (pane state, live flag), refreshed twice a second
        if (tfd >= 0 and frame % 15 == 0) {
            const sln : usize = client_list(tfd, tout[0..4100]);
            var sj : u32 = 0;
            while (sj < 32 and sj < session_count(ss)) {
                sst[sj] = tp_state_of(tout[0..4100], sln, session_agent(ss, sj), tp_ordinal(ss, sj));
                sj = sj + 1;
            }
        }
        if (tsince < 999) { tsince = tsince + 1; }
        tcur = tp_cursor_on(frame, tsince);
        // Q. GOD MODE: with the panel open and the user still, the Queen runs her suggestion herself
        sug = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        if (god_due(god, qp, sug, now, last_user, last_act)) {
            const qc : u32 = queen_control(sug);
            cur = act_cur(ss, sug, space, cur);
            ss = act_sessions(ss, sug, space);
            var qa : u32 = 0;
            if (cur != SESSION_NONE) { task = session_agent(ss, cur); qa = task; }
            // the editor suggestion: GOD MODE opens this space's folder inside, once for the space (edit_mark),
            // so she does not reopen it every GOD_WAIT seconds; the log names the space
            if (sug == A_EDIT) {
                iedit = IE_GOD;
                edone = edit_mark(edone, space);
                qa = space;
            }
            ring[ring_next(evn)] = ev_pack(view_of(menu_open(state), shown), qc, qa, now);
            evn = evn + 1;
            last_act = now;
            sug = shown_suggestion(suggest_for(sessions_in(ss, space), cur != SESSION_NONE, screen and ktpick != TERM_NONE, edone, space), dismissed);
        }
        // G. GOD MODE runs the evolve rule: with the panel open and nothing else suggested, its next action shows on the
        // strip (Confirm / Dismiss as for every suggestion) and is logged as hers once (C_QUEEN_STARTED / C_QUEEN_ASKED)
        if (god and qp and sug == A_NONE) {
            if (evd == 0) {
                // the key master decides first: no usable profile turns a task into an owner request (keys.t27 profiles)
                var evstored : u32 = 0;
                var evbad : u32 = 0;
                var ep : u32 = 0;
                while (ep < PROVIDER_COUNT) {
                    if (kstored[ep] != 0) { evstored = evstored + (1 << ep); }
                    ep = ep + 1;
                }
                ep = 0;
                while (ep < PROFILE_COUNT) {
                    const pv : u32 = PROFILE_PROVIDER[ep];
                    if (circuit_open(kfail[pv], kopen[pv], now)) { evbad = evbad + (1 << ep); }
                    ep = ep + 1;
                }
                evd = lane_gate(evolve_next(evfl, evst, gal_unassigned(gt[0..2560])), evstored, evbad);
                evpr = lane_profile(evstored, evbad);
                if (evd != 0) {
                    ring[ring_next(evn)] = log_event(evd, now);
                    evn = evn + 1;
                }
            }
        } else {
            evd = 0;
        }
        // E. the editor opens inside in one place, whoever asked: the strip's "T27 OS" chip or a confirmed A_EDIT
        // (IE_USER), or GOD MODE (IE_GOD). open_target keeps it inside; the editor pane takes the terminal area
        // on the next frame (view_key), on the folder of the space on screen (home when it is unbound).
        if (iedit != IE_NONE) {
            const itg : u32 = open_target(iedit == IE_GOD, ktpick != TERM_NONE, kemask != 0);
            var idirs : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
            if (dk_len(dk, idirs) == 0) { idirs = home_dir(); }
            const ihn : usize = ns_bytes(home_dir(), khome[0..256]);
            const idn : usize = ns_bytes(idirs, kdir[0..512]);
            edone = edit_mark(edone, space);
            if (itg == OT_INSIDE) {
                if (tfd < 0) { tfd = term_connect(thome[0..256]); }
                var iep : u32 = PANE_NONE;
                if (tfd >= 0) { iep = edit_open(tfd, epane, espace, space, ktpick, kdir[0..idn], tout[0..4100]); }
                epane = iep;
                espace = space;
                kewhy = OPEN_OK;
                if (epane == PANE_NONE) {
                    kewhy = OPEN_SPAWN_FAILED;
                } else {
                    eview = true;
                    ecur = cur;
                    esp = space;
                    eesc = 0;
                    kyp = false;
                }
            } else if (itg == OT_OUTSIDE) {
                kewhy = open_in_editor(nth_installed(kemask, 0), khome[0..ihn], kdir[0..idn]);
            }
            iedit = IE_NONE;
        }
        // the animation clocks run on real time (frame_gate.t27 fg_ticks): the same 0.25 s at 30 or 60 redraws a second
        const a_now : f64 = abs_time();
        const a_k : f64 = fg_ticks(a_now - a_last);
        a_last = a_now;
        ma = wave_k(ma, menu_open(state), a_k);
        glow = glow_level_k(glow, glow_on(god), a_k);
        a_acc = a_acc + a_k;
        const a_whole : u32 = fg_whole(a_acc);
        a_acc = a_acc - @as(f64, @floatFromInt(a_whole));
        a_frames = a_whole;
        var hov : u32 = PETAL_NONE;
        if (home_live) { hov = hit_px(vx, vy, 960, 540); }
        if (home_live and hov == PETAL_NONE and centre_hit(to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc))) { hov = PETAL_CENTRE; }
        var on_control : bool = on_home_button(mx, my, sw) or on_full_button(mx, my, sw) or on_dock_button(mx, my, sw) or on_god_switch(mx, my, hdr_right(sw), TITLE_H);
        if (on_hdr_btn(mx, my, hdr_right(sw), TITLE_H, tgv[TPG_U_ON] != 0 and tgv[TPG_U_ST] == (U_STAGED as u64))) { on_control = true; }
        if (qd_open(sst[0..560], screen, ws) and on_qd_area(mx, my, sw, sh, ws, collapsed, qp or dp or kyp or pfp) and qd_hit(mx, my, qd_area_x(ws, collapsed), WS_TOP, qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp), qd_area_h(sh), qd_lane_rows_shown(qd_table_rows(WS_TOP, qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp), qd_area_h(sh))), qd_queue_rows_shown(qd_table_rows(WS_TOP, qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp), qd_area_h(sh)))) != QD_QH_NONE) { on_control = true; }
        if ((screen or hscreen) and sb_hit(kit, tgv[0..256], sst[0..560], mx, my, sw, sh) != SB_NONE) { on_control = true; }
        if (hscreen and on_nav_back(mx, my, full)) { on_control = true; }
        if (screen and (on_nav_back(mx, my, full) or on_side_toggle(mx, my, ws, collapsed))) { on_control = true; }
        if (screen and (on_open_dash(mx, my, sw, ws) or on_close_dash(mx, my, ws, collapsed))) { on_control = true; }
        if (hscreen and (on_side_toggle(mx, my, sws, collapsed) or on_repo_link(mx, my, sw, sh) or on_doctor_link(mx, my, sw, sh))) { on_control = true; }
        if (hscreen and ma >= 1.0 and in_side(mx, home_ws(ws), collapsed) and sec_at(mx, my, WS_TOP) != SEC_NONE) { on_control = true; }
        if ((screen or (hscreen and shown == PETAL_CHAT)) and ma >= 1.0 and on_switch(mx, my, sw, WS_TOP)) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] == 0 and dcv[D_ADDP] != 0) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] == 0 and hit_class(dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160]))) != HC_SURFACE and dash_pick2(hh, mx, my, sw, content_x(home_ws(ws), collapsed), hs, pins_n(dcv[0..512], pbuf[0..4160])) != HIT_NONE) { on_control = true; }
        if (hscreen and ma >= 1.0 and dcv[D_LIVE] != 0 and on_live_back(mx, my, content_x(home_ws(ws), collapsed), home_view_top())) { on_control = true; }
        if (screen and ma >= 1.0 and card_live(term_up(screen, topen), mx, my, sw, sh, ws, collapsed) != CARD_SLOTS) { on_control = true; }
        if (screen and ma >= 1.0 and in_side(mx, ws, collapsed) and (row_at(WS_TOP, GROUP_QUEEN, spaces_shown(sp), 1, my) == 0 or row_at(WS_TOP, GROUP_SPACES, spaces_shown(sp), spaces_shown(sp), my) != ROW_NONE or row_at(WS_TOP, GROUP_AGENTS, spaces_shown(sp), sessions_in(ss, space), my) != ROW_NONE)) { on_control = true; }
        if (screen and on_new_chat(mx, my, sw, ws)) { on_control = true; }
        if (screen and (on_repo_link(mx, my, sw, sh) or (in_side(mx, ws, collapsed) and on_space_plus(mx, my) and new_space(sp) != SPACE_NONE))) { on_control = true; }
        if (screen and on_doctor_link(mx, my, sw, sh)) { on_control = true; }
        if ((screen or hscreen) and on_update_strip(mx, my, sh, sws, collapsed, strip_kind(@as(u8, @intCast(tgv[TPG_U_ST])), @as(u8, @intCast(tgv[TPG_U_WHY]))) != STRIP_HIDDEN and tgv[TPG_U_ON] != 0)) { on_control = true; }
        if (dp and (on_panel_close(mx, my, sw, WS_TOP) or dk_btn_at(dk, mx, my, sw, sh, doff) != NS_NOT_FOUND)) { on_control = true; }
        if (on_pf_head(mx, my, sw)) { on_control = true; }
        if (pfp and (on_panel_close(mx, my, sw, WS_TOP) or prf_panel_hit_d(mx, my, qp_left(sw), QP_W, WS_TOP, pf_has(tbv[TBO_PF .. TBO_PF + PF_CAP]), prf_squeeze(WS_TOP, sh)) != PRF_H_NONE or on_pf_cancel(mx, my, qp_left(sw), WS_TOP - prf_squeeze(WS_TOP, sh)))) { on_control = true; }
        if (qp and (on_panel_close(mx, my, sw, WS_TOP) or on_god(mx, my, sw, WS_TOP) or ((sug != A_NONE or evd != 0) and (on_confirm(mx, my, sw, WS_TOP) or on_dismiss(mx, my, sw, WS_TOP))))) { on_control = true; }
        if (hov != PETAL_NONE or on_control) { msg0(hand, s_cursor_set); } else { msg0(arrow, s_cursor_set); }
        // P. the panel's flag byte is what draw() reads; the frame key folds in the whole profile region, so a typed
        // letter, a status line or a picture changes it and the frame is drawn
        if (pfp) { tbv[TBO_PF + PF_OPEN] = 1; } else { tbv[TBO_PF + PF_OPEN] = 0; }
        // U. the frame gate: fold what this frame shows into a key; an unchanged key with nothing
        // animating keeps the image already on the layer (frame_gate.t27)
        var fk : u64 = fg_mix(fg_mix(fg_mix(fg_mix(0, @as(u64, state)), @as(u64, hov)), fg_level(ma)), @as(u64, shown));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, task)), @as(u64, space)), @as(u64, sp)), ss);
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, cur)), fg_flag(collapsed)), fg_mouse(mx, sw)), fg_mouse(my, sh));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, fg_cell(sw)), fg_cell(sh)), @as(u64, ws)), fg_flag(full));
        fk = fg_mix(fg_mix(fg_mix(fk, fg_flag(qp)), @as(u64, evn)), @as(u64, sug));
        fk = fg_mix(fg_mix(fk, @as(u64, evd)), @as(u64, evp));
        fk = fg_mix(fg_mix(fg_mix(fk, tgv[TPG_U_ST]), tgv[TPG_U_WHY]), now / 60);
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, sst[SST_QRUN] * 1000 + sst[SST_QBLK])), @as(u64, sst[SST_DISK])), @as(u64, sst[SST_SRV]));
        fk = fg_mix(fg_mix(fk, tgv[TPG_G_LAST]), tgv[TPG_G_NEXT]);
        fk = fg_mix(fg_mix(fk, @as(u64, sst[SST_QDASH])), tgv[TPG_QD_FLAGS]);
        fk = fg_mix(fk, tgv[TPG_PF_IMG]);
        var fki2 : usize = 0;
        while (fki2 < 144) {
            fk = fg_mix(fk, @as(u64, tbv[TBO_PF + fki2]));
            fki2 = fki2 + 1;
        }
        fk = fg_mix(fg_mix(fk, @as(u64, hs)), fg_flag(cons2));
        fk = fg_mix(fg_mix(fg_mix(fk, dcv[D_GEN]), dcv[D_DEFER]), dcv[D_LIVE]);
        fk = fg_mix(fg_mix(fg_mix(fk, tgv[TPG_GEN]), fg_flag(open2)), tgv[TPG_DASH]);
        fk = fg_mix(fg_mix(fk, tgv[TPG_O_SEL]), tgv[TPG_O_N]);
        if (open2) { fk = fg_mix(fk, now); }
        const tbusy : bool = tgv[TPG_BN_PID] != 0 or tgv[TPG_BA_PID] != 0 or tgv[TPG_K_PID] != 0 or tgv[TPG_Q_PID] != 0;
        // the clock shows only in the queen panel's ages; outside it a ticking second must not count as a change
        if (qp) { fk = fg_mix(fk, now); }
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, fg_flag(god)), fg_level(glow)), fg_flag(dp)), @as(u64, darmed));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, doff)), @as(u64, dgo)), fg_flag(walking));
        fk = fg_mix(fg_mix(fg_mix(fg_mix(fk, @as(u64, topen)), fg_flag(tcur and topen != PANE_NONE)), tfed), fg_flag(narrow));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, tst[ST_X])), @as(u64, tst[ST_Y])), @as(u64, tst[ST_COLS] * 1000 + tst[ST_ROWS]));
        fk = fg_mix(fg_mix(fk, @as(u64, tst[ST_GEN])), @as(u64, vt_view(tst[0..32])));
        fk = fg_mix(fg_mix(fg_mix(fk, @as(u64, sst[SST_LVOFF])), @as(u64, sst[SST_LVSEL])), lvat);
        fk = fg_mix(fk, @as(u64, sst[SST_LVTAIL]));
        // the doctor's table and its label (a new string each frame while checks run) only show in its panel;
        // with the panel shut, the background walk does not wake the draw
        if (dp) {
            fk = fg_mix(fk, dlabel);
            var fki : usize = 0;
            while (fki < 128) {
                fk = fg_mix(fk, dk[fki]);
                fki = fki + 1;
            }
        }
        // the home logo flies in for ANIM_FRAMES, the menu waves open and shut, the GOD MODE edge glow fades in and out
        const fanim : bool = frame < ANIM_FRAMES or (ma > 0.0 and ma < 1.0) or (glow > 0.0 and glow < 1.0);
        // ticking (frame_gate.t27): the steady flame flickers on the tick count and the orbit drifts to whole points;
        // what they show goes into the key, so they draw when a pixel can change, at most once a tick
        const fflame : bool = glow > 0.0;
        const forbit : bool = ov_animates(ov_visible(@as(i64, @intFromFloat((1.0 - ma) * 1000.0))), tgv[TPG_O_RM] != 0, orb_n(tgv[TPG_O_N]));
        if (fflame) { fk = fg_mix(fk, @as(u64, frame)); }
        if (forbit) { fk = fg_mix(fk, orbit_key(tgv[0..256], mx, my, sw, sh)); }
        // a window no part of which is on a screen draws nothing; coming back changes the key, so it draws at once
        const fseen : bool = on_screen(msg0(win, s_occl));
        fk = fg_mix(fk, fg_flag(fseen));
        const flive : bool = tlink == PANE_LIVE and topen != PANE_NONE;
        // RC. the dock's open flag rides in its own region, synced here so the draw reads the same frame
        if (rc) { tbv[RC_FLAG] = 1; } else { tbv[RC_FLAG] = 0; }
        const fdraw : bool = fseen and fg_draw_due(fk, fshown, fanim, fsince);
        fquiet = fg_quiet(fquiet, fk != fshown or fanim or tbusy);
        fsince = fg_since(fsince, fdraw);
        fshown = fk;
        fwait = fg_hidden_wait(fseen, flive, fg_wait_anim(fquiet, flive, fanim, fflame or forbit, a_acc, FRAME_S));
        msg_flag(tx_cls, s_quiet, true);
        if (fdraw and narrow) {
            draw(cc, kit, frame, state, hov, ma, shown, task, space, sp, ss, cur, collapsed, mx, my, z, sw, sh, ws, full, qp, ring, evn, now, sug, god, glow, dk, dp, darmed, doff, dgo, walking, dlabel, tst[0..32], tcells[0..960000], topen, tcur, kyp, kstored[0..9], kmask[0..544], kmlen[0..9], kst[0..72], kfail[0..9], kopen[0..9], kedit, kbuf[0..256], klen, karm, kbusy, kemask, kewhy, ktpick, hs, cons2, dcv[0..512], gal[0..49152], gt[0..2560], evd, @as(u64, evp) + @as(u64, evn2) * 1048576 + @as(u64, evpr) * 1099511627776, pbuf[0..4160], sst[0..560], tgv[0..256], tbv[0..TB_SIZE]);
            const whole : u64 = cg_image(cc);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * RETINA, sh * RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        } else if (fdraw) {
            draw(c, kit, frame, state, hov, ma, shown, task, space, sp, ss, cur, collapsed, mx, my, z, sw, sh, ws, full, qp, ring, evn, now, sug, god, glow, dk, dp, darmed, doff, dgo, walking, dlabel, tst[0..32], tcells[0..960000], topen, tcur, kyp, kstored[0..9], kmask[0..544], kmlen[0..9], kst[0..72], kfail[0..9], kopen[0..9], kedit, kbuf[0..256], klen, karm, kbusy, kemask, kewhy, ktpick, hs, cons2, dcv[0..512], gal[0..49152], gt[0..2560], evd, @as(u64, evp) + @as(u64, evn2) * 1048576 + @as(u64, evpr) * 1099511627776, pbuf[0..4160], sst[0..560], tgv[0..256], tbv[0..TB_SIZE]);
            const whole : u64 = cg_image(c);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * WIDE_RETINA, sh * WIDE_RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        }
        if (fdraw) { vt_clean(tst[0..32]); }
        // K. keep what the window shows: write it once a change has held still (window_keep.t27)
        const wk_fl : u64 = wk_flags(collapsed, dash, qp, god, dp, auto_open);
        const wk_k : u64 = fg_mix(wk_key(state, shown, task, space, ss, sp, cur, wk_fl, evn), @as(u64, hs));
        wk_n = wk_still(wk_n, wk_k, wk_last);
        wk_last = wk_k;
        if (frame == 0) { wk_saved = wk_k; }
        if (wk_due(wk_k, wk_saved, wk_n)) {
            msg2(defs, sel("setInteger:forKey:"), @as(u64, evn), k_evn);
            ri = 0;
            while (ri < RING) {
                msg2(defs, sel("setInteger:forKey:"), ring[ri], k_ev[ri]);
                ri = ri + 1;
            }
            msg2(defs, sel("setInteger:forKey:"), @as(u64, state), k_state);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, shown), k_shown);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, task), k_task);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, space), k_space);
            msg2(defs, sel("setInteger:forKey:"), ss, k_ss);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, sp), k_sp);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, cur), k_cur);
            msg2(defs, sel("setInteger:forKey:"), @as(u64, hs), k_hs);
            msg2(defs, sel("setInteger:forKey:"), wk_fl, k_flags);
            msg2(defs, sel("setInteger:forKey:"), 1, k_kept);
            msg0(defs, sel("synchronize"));
            wk_saved = wk_k;
        }
        // R. a new binary from t27b + ld: wait until it is quiet, save the state, exec it
        if (reload_poll(frame)) {
            const mtime : u64 = msg0(msg2(files, s_attrs, exe, 0), s_mdate);
            const moved : bool = now == 0 or msg_test1(seen, s_same, mtime) == false;
            if (moved) {
                msg0(seen, sel("release"));
                seen = mtime;
                msg0(seen, sel("retain"));
            }
            waited = reload_wait(waited, moved);
            if (reload_due(waited) and seen != 0) {
                var fl : u64 = 0;
                if (collapsed) { fl = fl + 1; }
                if (dash) { fl = fl + 2; }
                if (qp) { fl = fl + 4; }
                if (god) { fl = fl + 8; }
                if (dp) { fl = fl + 16; }
                if (auto_open == false) { fl = fl + 32; }
                msg2(defs, sel("setInteger:forKey:"), @as(u64, evn), k_evn);
                ri = 0;
                while (ri < RING) {
                    msg2(defs, sel("setInteger:forKey:"), ring[ri], k_ev[ri]);
                    ri = ri + 1;
                }
                msg2(defs, sel("setInteger:forKey:"), @as(u64, state), k_state);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, shown), k_shown);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, task), k_task);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, space), k_space);
                msg2(defs, sel("setInteger:forKey:"), ss, k_ss);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, sp), k_sp);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, cur), k_cur);
                msg2(defs, sel("setInteger:forKey:"), @as(u64, hs), k_hs);
                msg2(defs, sel("setInteger:forKey:"), fl, k_flags);
                msg2(defs, sel("setInteger:forKey:"), 1, k_hot);
                msg0(defs, sel("synchronize"));
                const path : u64 = msg0(exe, sel("UTF8String"));
                var argv : [2]u64 = undefined;
                argv[0] = path;
                argv[1] = 0;
                exec_self(path, argv);
                waited = RELOAD_IDLE;
            }
        }
        frame = frame + a_frames;
        pool_pop(pool);
    }
    // the window closed: a clean quit, so the supervisor must not relaunch
    beat_clear(dhb[0..dhn]);
}

// ---- tests ----

test the_key_light_dot_has_one_colour_per_value_and_the_foot_is_the_worst {
    assert dot_visible(LIGHT_NONE) == false;
    assert dot_visible(LIGHT_GREEN);
    assert dot_visible(LIGHT_YELLOW);
    assert dot_visible(LIGHT_RED);
    assert dot_visible(9) == false;
    assert light_chan(LIGHT_GREEN, 1) > light_chan(LIGHT_GREEN, 0);
    assert light_chan(LIGHT_RED, 0) > light_chan(LIGHT_RED, 1);
    assert light_chan(LIGHT_YELLOW, 0) > light_chan(LIGHT_YELLOW, 2);
    assert light_chan(LIGHT_NONE, 0) == 0.0;
    // red > yellow > green; none never hides a light
    assert light_worse(LIGHT_GREEN, LIGHT_YELLOW) == LIGHT_YELLOW;
    assert light_worse(LIGHT_RED, LIGHT_YELLOW) == LIGHT_RED;
    assert light_worse(LIGHT_GREEN, LIGHT_RED) == LIGHT_RED;
    assert light_worse(LIGHT_NONE, LIGHT_GREEN) == LIGHT_GREEN;
    assert light_worse(LIGHT_YELLOW, LIGHT_NONE) == LIGHT_YELLOW;
    assert light_worse(LIGHT_NONE, LIGHT_NONE) == LIGHT_NONE;
    // an editor pane has no dot; the default adapters draw nothing
    assert dot_light(true, LIGHT_RED) == LIGHT_NONE;
    assert dot_light(false, LIGHT_RED) == LIGHT_RED;
    assert dot_light(false, 9) == LIGHT_NONE;
    assert pane_light_input(0) == LIGHT_NONE;
    assert foot_light_input() == LIGHT_NONE;
}

test the_screen_cross_fades_in_a_quarter_second {
    var a : f64 = 0.0;
    var i : u32 = 0;
    while (i < 7) { a = wave(a, true); i = i + 1; }
    assert a < 1.0;
    a = wave(a, true);
    assert a > 0.999;
    // 8 frames at 30 fps = 0.267 s, the nearest frame count to trios' 0.25 s easeInOut
    assert @abs(8.0 * FRAME_S - 0.25) < 0.02;
    i = 0;
    while (i < 8) { a = wave(a, false); i = i + 1; }
    assert a < 0.001;
}

test the_cross_fade_takes_the_same_time_at_any_redraw_rate {
    var a : f64 = 0.0;
    var i : u32 = 0;
    // 16 redraws at 60 fps = 0.267 s = the 8 ticks of 30 fps
    while (i < 16) { a = wave_k(a, true, 0.5); i = i + 1; }
    assert a > 0.999;
    a = 0.0;
    i = 0;
    while (i < 15) { a = wave_k(a, true, 0.5); i = i + 1; }
    assert a < 1.0;
    assert wave_k(0.5, false, 8.0) == 0.0;
}

test the_blocks_fly_in_from_800_units_and_settle_home {
    assert anim_off(0) == 800.0;
    assert anim_off(1) < 800.0;
    assert anim_off(40) < 10.0;
    assert anim_off(ANIM_FRAMES) == 0.0;
}

test the_glass_carries_trios_numbers {
    assert TINT_BLACK == 0.55;
    assert SURFACE_BLACK == 0.46;
    assert SIDEBAR_BLACK == 0.22;
    assert CONTENT_BLACK == 0.14;
    assert BORDER_WHITE == 0.14;
    assert SIDE_W == 272.0;
    assert HEADER_H == 44.0;
    assert WS_TOP == AREA_TOP;
    assert READABLE_W == 900.0;
    assert chan(outline(), 3) == 1.0;
}

test every_petal_flies_out_along_a_unit_direction {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const x : f64 = dir(p, 0);
        const y : f64 = dir(p, 1);
        assert @abs(x * x + y * y - 1.0) < 0.000001;
        p = p + 1;
    }
}

test the_title_bar_controls_clear_the_traffic_lights {
    // T. macOS draws close / minimise / zoom in x < 76 of the title bar.
    assert HOME_X >= 76.0;
    // the logo + TRINITY sit in the middle of the bar, clear of the traffic lights and the chevron
    assert on_home_button(30.0, 17.0, W_PT) == false;
    assert on_home_button(0.5 * W_PT, 17.0, W_PT);
    assert on_home_button(0.5 * PANEL_W, 17.0, PANEL_W);
    assert brand_left(PANEL_W, HOME_BTN_W) > HOME_X + BACK_W;
    assert brand_left(PANEL_W, HOME_BTN_W) + HOME_BTN_W < dock_x(PANEL_W) - DOCK_STEP;
    assert brand_left(W_PT, 100.0) + 0.5 * 100.0 == 0.5 * W_PT;
    assert home_x(true) < home_x(false);
    assert on_full_button(full_x(W_PT) + 10.0, 17.0, W_PT);
    assert full_x(W_PT) + FULL_PT <= W_PT - 16.0;
    assert on_dock_button(dock_x(W_PT) + 10.0, 17.0, W_PT);
    assert on_dock_button(full_x(W_PT) + 10.0, 17.0, W_PT) == false;
    assert dock_x(PANEL_W) > HOME_X + HOME_BTN_W;
    assert on_nav_back(30.0, 17.0, false) == false;
    assert on_nav_back(HOME_X + 4.0, 17.0, false);
    assert on_nav_back(30.0, AREA_TOP + 16.0, false) == false;
}

test the_home_logo_fills_063_of_the_area_and_maps_the_mouse_back {
    const z : f64 = 1.0;
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * home_k(z, W_PT, H_PT);
    assert @abs(h - LOGO_SHARE * 0.8 * (H_PT - AREA_TOP)) < 0.001;
    // the logo's own middle sits mid-area
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT));
    assert @abs(my - 0.5 * (AREA_TOP + H_PT)) < 0.001;
    // the logo stays below the title bar
    assert to_pt(logo_edge(1, false), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) > AREA_TOP;
    // the mouse on the logo centre maps to the centre petal_menu's hit test uses
    assert @abs(virt(home_c(0, z, W_PT, H_PT), 0, z, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, z, W_PT, H_PT), 1, z, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_tooltip_floats_30_points_above_its_petal {
    const z : f64 = 1.0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert @abs(to_pt(cen_y(p), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) - tip_y(p, z, W_PT, H_PT) - TIP_RISE) < 0.001;
        p = p + 1;
    }
}

test the_menu_shortcuts_follow_queen_menu_shortcut_policy {
    assert digit_of(18) == 1;
    assert digit_of(25) == 9;
    assert digit_of(29) == 0;
    assert digit_of(0) == NO_DIGIT;
    assert petal_for_key(1, MOD_COMMAND) == 0;
    assert petal_for_key(9, MOD_COMMAND) == 8;
    assert petal_for_key(1, MOD_OPTION) == 9;
    assert petal_for_key(9, MOD_OPTION) == 17;
    assert petal_for_key(1, MOD_CONTROL) == 18;
    assert petal_for_key(9, MOD_CONTROL) == 26;
    assert petal_for_key(1, MOD_COMMAND + MOD_SHIFT) == PETAL_NONE;
    assert petal_for_key(1, MOD_COMMAND + MOD_OPTION) == PETAL_NONE;
    assert petal_for_key(0, MOD_COMMAND) == PETAL_NONE;
    assert petal_for_key(1, 0) == PETAL_NONE;
}

test the_sidebar_collapses_and_the_cards_take_the_room {
    assert content_x(WS_EXPANDED, false) == SIDE_W + 1.0;
    assert content_x(WS_EXPANDED, true) == 0.0;
    assert body_w(W_PT, WS_EXPANDED, true) == READABLE_W;
    assert body_w(W_PT, WS_EXPANDED, false) < READABLE_W;
    assert body_left(W_PT, WS_EXPANDED, false) >= content_x(WS_EXPANDED, false) + BODY_PAD;
    assert body_left(W_PT, WS_EXPANDED, true) + body_w(W_PT, WS_EXPANDED, true) <= W_PT - BODY_PAD;
    assert on_side_toggle(SIDE_W + 1.0 + 20.0, WS_TOP + 22.0, WS_EXPANDED, false);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, true);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    const el : f64 = body_left(W_PT, WS_EXPANDED, false);
    const ew : f64 = body_w(W_PT, WS_EXPANDED, false);
    const eh : f64 = body_h(W_PT, H_PT, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, el, body_top(WS_EXPANDED), ew, eh), hex_c(0, 1, el, body_top(WS_EXPANDED), ew, eh), W_PT, H_PT, WS_EXPANDED, false) == 0;
    const cl : f64 = body_left(W_PT, WS_EXPANDED, true);
    const cw2 : f64 = body_w(W_PT, WS_EXPANDED, true);
    const ch2 : f64 = body_h(W_PT, H_PT, WS_EXPANDED, true);
    assert card_at(hex_c(4, 0, cl, body_top(WS_EXPANDED), cw2, ch2), hex_c(4, 1, cl, body_top(WS_EXPANDED), cw2, ch2), W_PT, H_PT, WS_EXPANDED, true) == 4;
    assert card_at(10.0, 10.0, W_PT, H_PT, WS_EXPANDED, false) == CARD_SLOTS;
}

test the_dock_icon_is_a_centred_white_logo_on_black {
    const k : f64 = logo_k_for(ICON_LOGO_PX);
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * k;
    assert @abs(h - ICON_LOGO_PX) < 0.001;
    // the logo's own middle lands on the icon centre on both axes
    const mx : f64 = to_pt(0.5 * (logo_edge(0, false) + logo_edge(0, true)), 0, icon_cen(0), k);
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, icon_cen(1), k);
    assert @abs(mx - 0.5 * ICON_SIZE) < 0.001;
    assert @abs(my - 0.5 * ICON_SIZE) < 0.001;
    assert ICON_LOGO_PX < ICON_TILE;
}

test the_cards_cascade_in_and_all_arrive_at_full_alpha {
    assert card_alpha(0.3, 0) > card_alpha(0.3, 8);
    var k : u32 = 0;
    while (k < CARD_SLOTS) { assert card_alpha(1.0, k) == 1.0; k = k + 1; }
}

test full_screen_keeps_the_scene_aspect_and_maps_the_mouse_back {
    assert fit(960.0, 540.0, W_PT, H_PT) == 1.0;
    assert fit(1920.0, 1200.0, W_PT, H_PT) == 2.0;
    assert view_to_scene(960.0, 1920.0, 1200.0, 0, W_PT, H_PT) == 480.0;
    assert view_to_scene(600.0, 1920.0, 1200.0, 1, W_PT, H_PT) == 270.0;
    assert view_to_scene(0.0, 960.0, 540.0, 1, W_PT, H_PT) == 540.0;
}

test full_screen_draws_the_home_logo_20_percent_smaller_and_still_hits {
    assert @abs(home_px(FULL_LOGO, W_PT, H_PT) - 0.8 * home_px(1.0, W_PT, H_PT)) < 0.000001;
    assert @abs(home_k(FULL_LOGO, W_PT, H_PT) - 0.8 * home_k(1.0, W_PT, H_PT)) < 0.000001;
    assert has_mod(MASK_FULL_SCREEN + STYLE, MASK_FULL_SCREEN);
    assert has_mod(STYLE, MASK_FULL_SCREEN) == false;
    // the smaller logo stays centred, and the mouse on its centre still maps to the hit-test centre
    assert @abs(virt(home_c(0, FULL_LOGO, W_PT, H_PT), 0, FULL_LOGO, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, FULL_LOGO, W_PT, H_PT), 1, FULL_LOGO, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_window_folds_into_the_trios_compact_panel_below_760 {
    // K. ChatWorkspaceLayout: expanded from 760, compact below, the forced dashboard on request.
    assert workspace(759.0, false) == WS_COMPACT;
    assert workspace(760.0, false) == WS_EXPANDED;
    assert workspace(760.0, true) == WS_EXPANDED;
    assert workspace(PANEL_W, true) == WS_DASHBOARD;
    assert side_w(WS_COMPACT, false) == 0.0;
    assert side_w(WS_DASHBOARD, false) == 0.0;
    assert side_w(WS_EXPANDED, false) == SIDE_W;
    // the OPEN DASHBOARD bar spans the panel, and only in compact
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_COMPACT);
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_DASHBOARD) == false;
    assert on_open_dash(200.0, WS_TOP + BAR_H + 5.0, PANEL_W, WS_COMPACT) == false;
    // Close Dashboard sits right of the toggle, only in the forced dashboard
    assert on_close_dash(close_x(WS_DASHBOARD, false) + 10.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    assert on_close_dash(close_x(WS_EXPANDED, false) + 10.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_COMPACT, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    // the narrow scene is the view point for point; the cards take the panel under the bar
    assert scene(PANEL_W, 900.0, 0) == PANEL_W;
    assert scene(PANEL_W, 900.0, 1) == 900.0;
    assert scene(PANEL_W, 2000.0, 1) == CH_MAX;
    assert fit(PANEL_W, 900.0, PANEL_W, 900.0) == 1.0;
    assert body_w(PANEL_W, WS_COMPACT, false) == PANEL_W - 2.0 * BODY_PAD;
    const kl : f64 = body_left(PANEL_W, WS_COMPACT, false);
    const kw : f64 = body_w(PANEL_W, WS_COMPACT, false);
    const kh : f64 = body_h(PANEL_W, 900.0, WS_COMPACT, false);
    assert card_at(hex_c(4, 0, kl, body_top(WS_COMPACT), kw, kh), hex_c(4, 1, kl, body_top(WS_COMPACT), kw, kh), PANEL_W, 900.0, WS_COMPACT, false) == 4;
    // the slots keep their wide shape instead of stretching down the panel
    assert @abs(body_h(PANEL_W, 900.0, WS_COMPACT, false) / body_w(PANEL_W, WS_COMPACT, false) - wide_shape()) < 0.000001;
    assert body_h(PANEL_W, 900.0, WS_COMPACT, false) < 900.0 - body_top(WS_COMPACT) - BODY_PAD;
    // the home logo fits inside the 400 pt panel and still maps back to the hit-test centre
    const k : f64 = home_k(1.0, PANEL_W, 900.0);
    assert to_pt(logo_edge(0, false), 0, home_c(0, 1.0, PANEL_W, 900.0), k) > 0.0;
    assert to_pt(logo_edge(0, true), 0, home_c(0, 1.0, PANEL_W, 900.0), k) < PANEL_W;
    assert @abs(virt(home_c(0, 1.0, PANEL_W, 900.0), 0, 1.0, PANEL_W, 900.0) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, 1.0, PANEL_W, 900.0), 1, 1.0, PANEL_W, 900.0) - 0.5 * H_PT) < 0.001;
    // the compact bitmap holds the widest and tallest narrow scene
    assert CW_MAX * RETINA <= 1520.0;
    assert CH_MAX * RETINA <= 2600.0;
}

test full_screen_draws_point_for_point_on_black_glass {
    // F. a 1728 x 1117 pt full screen is its own scene: no 960 x 540 upscale, no letterbox bands
    assert scene(1728.0, 1117.0, 0) == 1728.0;
    assert scene(1728.0, 1117.0, 1) == 1117.0;
    assert fit(1728.0, 1117.0, scene(1728.0, 1117.0, 0), scene(1728.0, 1117.0, 1)) == 1.0;
    assert scene(W_PT, H_PT, 0) == W_PT;
    assert scene(3000.0, 2000.0, 0) == SW_MAX;
    assert scene(3000.0, 2000.0, 1) == SH_MAX;
    assert SW_MAX * WIDE_RETINA <= 3840.0;
    assert SH_MAX * WIDE_RETINA <= 2400.0;
    // the hairline is one device pixel at the display's own scale
    assert HAIR * WIDE_RETINA == 1.0;
    assert TINT_FULL > TINT_BLACK;
    // F. full screen has no transparency: the layer is opaque black #000000 there (owner, 2026-10-20)
    assert TINT_FULL == 1.0;
    // F. the background is black glass: R = G = B = 0, clear in a window, opaque in full screen
    assert BACK_BLACK == 1.0;
    assert BACK_GLASS == 0.0;
    // the wipe covers a fractional edge: it reaches past the scene by at least a point
    assert BACK_BLEED >= 1.0;
    assert CROWN_WHITE == 0.70;
    assert STRICT_CARD_EDGE > STRICT_CARD_FILL;
    // the cards still tile the readable column in full screen
    const fl : f64 = body_left(1728.0, WS_EXPANDED, false);
    const fw : f64 = body_w(1728.0, WS_EXPANDED, false);
    const fh : f64 = body_h(1728.0, 1117.0, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, fl, body_top(WS_EXPANDED), fw, fh), hex_c(0, 1, fl, body_top(WS_EXPANDED), fw, fh), 1728.0, 1117.0, WS_EXPANDED, false) == 0;
}

test logo_is_the_brand_mark_and_title_says_trinity_once {
    // H. the home mark is glass petals with thin outlines (petal_menu.t27 owns the fills), the centre left open
    assert chan(fill(0, STATE_HOME, PETAL_NONE), 3) < 0.25;
    assert chan(fill(0, STATE_HOME, 0), 0) == 1.0;
    assert chan(outline_for(0, STATE_HOME, PETAL_NONE), 3) == 1.0;
    // S. one bar: the back chevron sits in the title bar right before the logo
    assert on_nav_back(FULL_HOME_X + 2.0, 0.5 * TITLE_H, true);
    assert on_nav_back(FULL_HOME_X + 2.0, AREA_TOP + 10.0, true) == false;
    // L. layout.t27: chevron, logo and TRINITY on one centre line, equal gaps, equal icon heights
    assert NAV_SHIFT == row_next(0.0, CHEV_W, ROW_GAP);
    assert same_line(cap_mid(baseline_for(0.5 * TITLE_H, 11.0), 11.0), 0.5 * TITLE_H);
    assert title_logo_w() > ROW_ICON_H;
    assert title_logo_w() < 2.0 * ROW_ICON_H;
    assert TITLE_LOGO_SCALE == 1.2;
}

test the_comb_holds_the_agents_with_the_queen_in_the_middle {
    // A. the Queen is the middle cell of the middle row
    assert AGENT_QUEEN / 3 == 1;
    assert AGENT_QUEEN % 3 == 1;
    // the mark and the name stay inside the cell
    assert AGENT_MARK_UP + AGENT_MARK < 1.0;
    assert AGENT_NAME_DOWN < 0.5;
    assert agent_name_pt(200.0) == AGENT_NAME_PT;
    assert agent_name_pt(40.0) < AGENT_NAME_MIN;
}

test cards_are_a_honeycomb_and_the_logo_has_two_sizes {
    // C. a 600 x 500 body: the comb fits both ways, cells do not touch, the middle row sits half a cell right
    const r : f64 = hex_r(600.0, 500.0);
    assert 3.5 * SQRT3 * r + 2.5 * HEX_GAP <= 600.001;
    assert 5.0 * r + 2.0 * HEX_GAP <= 500.001;
    assert in_hex(hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), r);
    assert hex_c(1, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) > SQRT3 * r;
    assert @abs(hex_c(3, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) - 0.5 * (SQRT3 * r + HEX_GAP)) < 0.001;
    assert @abs(hex_c(6, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0)) < 0.001;
    // a corner of the bounding box is outside the hexagon
    assert in_hex(0.0, 0.0, 0.5 * SQRT3 * r, r, r) == false;
    // H. the large mark is parted by a black cut; the small one by a finer one
    assert LOGO_SEAL > 0.0;
    assert LOGO_SEAL < LOGO_CUT;
}

test small_mark_keeps_the_centre_hole {
    // H. the hole is the mark's inner equilateral triangle: height = width * sqrt(3) / 2 within 1 percent
    const wd : f64 = HOLE_R - HOLE_L;
    assert @abs((HOLE_AY - HOLE_TOP) - 0.5 * SQRT3 * wd) < 0.01 * wd;
    assert @abs(HOLE_AX - 0.5 * (HOLE_L + HOLE_R)) < 1000.0;
    // it sits inside the logo box
    assert HOLE_L > logo_edge(0, false);
    assert HOLE_R < logo_edge(0, true);
    assert HOLE_TOP > logo_edge(1, false);
    assert HOLE_AY < logo_edge(1, true);
    assert HOLE_GROW > 1.0;
}

test the_sidebar_rows_answer_only_where_the_sidebar_is {
    assert in_side(20.0, WS_EXPANDED, false);
    assert in_side(20.0, WS_EXPANDED, true) == false;
    assert in_side(20.0, WS_COMPACT, false) == false;
    assert in_side(SIDE_W - 6.0, WS_EXPANDED, false) == false;
    // the Queen row stays where it was before the groups: label at +22, row at +30
    assert label_base(WS_TOP, GROUP_QUEEN, spaces_shown(SPACES_SEED)) == WS_TOP + 22.0;
    assert row_top(WS_TOP, GROUP_QUEEN, spaces_shown(SPACES_SEED), 0) == WS_TOP + 30.0;
    // with the three seed spaces, five chats fit above the foot strip of the 540-pt window; the sixth runs
    // under OPEN SOURCE T27 (scrolling is not built yet). The old claim, seven, ended at 547 pt.
    assert row_top(WS_TOP, GROUP_AGENTS, spaces_shown(SPACES_SEED), 4) + AGENT_ROW_H <= H_PT - FOOT_H;
    assert row_top(WS_TOP, GROUP_AGENTS, spaces_shown(SPACES_SEED), 5) + AGENT_ROW_H > H_PT - FOOT_H;
    // the foot link answers only inside the sidebar strip
    // the three links live at the right end of the footer bar (statusbar.t27), whatever the sidebar does
    assert on_repo_link(repo_left(W_PT) + 10.0, H_PT - 10.0, W_PT, H_PT);
    assert on_doctor_link(doc_left(W_PT) + 10.0, H_PT - 10.0, W_PT, H_PT);
    assert on_keys_foot(keys_left(W_PT) + 10.0, H_PT - 10.0, W_PT, H_PT);
    assert on_repo_link(repo_left(W_PT) + 10.0, H_PT - SB_H - 4.0, W_PT, H_PT) == false;
    assert on_repo_link(40.0, H_PT - 10.0, W_PT, H_PT) == false;
    assert on_doctor_link(repo_left(W_PT) + 10.0, H_PT - 10.0, W_PT, H_PT) == false;
    assert on_term(SIDE_W + 40.0, H_PT - 10.0, W_PT, H_PT, WS_EXPANDED, false, false) == false;
    // the SPACES "+" and a space row x sit at the right end, clear of the row text
    assert on_space_plus(SIDE_W - 26.0, label_base(WS_TOP, GROUP_SPACES, 3) - 3.5);
    assert on_space_plus(40.0, label_base(WS_TOP, GROUP_SPACES, 3) - 3.5) == false;
    const st : f64 = row_top(WS_TOP, GROUP_SPACES, 3, 0);
    assert on_space_close(SIDE_W - 26.0, st + 14.0, st);
    assert on_space_close(SIDE_W - 26.0, st + 30.0, st) == false;
}

test the_brand_is_trinity_s_superscript_three_ai_in_utf8 {
    var b : [16]u8 = undefined;
    assert brand(b[0 .. 16]) == BRAND_LEN;
    assert b[0] == 84;
    assert b[8] == 83;
    // U+00B3 is C2 B3 in UTF-8, written as bytes because a t27b literal does not decode \x
    assert b[9] == 0xC2;
    assert b[10] == 0xB3;
    assert b[11] == 65;
    assert b[12] == 73;
}

test every_comb_cell_gets_the_same_outline {
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        assert cell_line(k) == HAIR;
        // no hover and no task: every cell has the plain edge, cell 0 included
        assert cell_edge(k, CARD_SLOTS, CARD_SLOTS) == STRICT_CARD_EDGE;
        // hover and selection look the same on every cell
        assert cell_edge(k, k, CARD_SLOTS) == STRICT_HOVER_EDGE;
        assert cell_edge(k, CARD_SLOTS, k) == TASK_EDGE;
        k = k + 1;
    }
}

test the_new_chat_plus_and_the_row_close_answer_only_on_their_boxes {
    // N. "+" sits at the right end of the header, inside the content, never in the compact bar
    const sw : f64 = 1200.0;
    const ty : f64 = WS_TOP + 0.5 * HEADER_H;
    assert on_new_chat(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, sw, WS_EXPANDED);
    assert on_new_chat(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, sw, WS_COMPACT) == false;
    assert on_new_chat(new_chat_x(sw) - 4.0, ty, sw, WS_EXPANDED) == false;
    assert new_chat_x(sw) + TOGGLE_PT < sw;
    // it does not overlap the sidebar toggle
    assert on_side_toggle(new_chat_x(sw) + 0.5 * TOGGLE_PT, ty, WS_EXPANDED, false) == false;
    // N. the close x of a row is where its dot is drawn, and only there
    const top : f64 = 200.0;
    assert on_row_close(SIDE_W - 26.0, top + 19.0, top);
    assert on_row_close(40.0, top + 19.0, top) == false;
    assert on_row_close(SIDE_W - 26.0, top + 40.0, top) == false;
    assert in_side(SIDE_W - 26.0, WS_EXPANDED, false);
}

test the_panel_width_is_glass_and_the_full_window_width_is_opaque_black {
    // owner, 2026-10-23: "the matte glass was in the compact mode, and in the full one black #000000"
    assert on_glass(PANEL_W);
    assert backdrop_alpha(PANEL_W) == 0.0;
    assert backdrop_clears(PANEL_W);
    assert tint_alpha(PANEL_W) == TINT_BLACK;
    assert TINT_BLACK == 0.55;
    // the full window and full screen are #000000: the frame and the layer, nothing under them
    assert on_glass(W_PT) == false;
    assert backdrop_alpha(W_PT) == 1.0;
    assert backdrop_clears(W_PT) == false;
    assert tint_alpha(W_PT) == TINT_FULL;
    assert TINT_FULL == 1.0;
    assert tint_alpha(W_PT) > TINT_BLACK;
    // the two states never agree, so a material change can never leave a see-through full window
    assert backdrop_alpha(W_PT) > backdrop_alpha(PANEL_W);
    assert backdrop_clears(W_PT) == (backdrop_clears(PANEL_W) == false);
    assert 1.0 - TINT_BLACK > 0.35;
    assert SURF_FROST > 0.0 and SURF_FROST <= 0.08;
}

test the_ground_is_black_everywhere_and_the_glass_tints_it_at_the_panel_width {
    // owner, 2026-10-20: the OS is black #000000, not grey; surfaces are glass layered on it
    assert GROUND_RGB == 0.0;
    assert on_glass(PANEL_W);
    assert tint_alpha(PANEL_W) == 0.55;
    assert tint_alpha(PANEL_W) >= 0.45 and tint_alpha(PANEL_W) <= 0.65;
    // the compact panel's wallpaper glows through blurred: 35 to 55 percent shows
    assert 1.0 - tint_alpha(PANEL_W) > 0.35;
    assert on_glass(W_PT) == false;
    // the full window shows nothing through: 100 percent black
    assert tint_alpha(W_PT) == 1.0;
    assert 1.0 - tint_alpha(W_PT) == 0.0;
}

test the_editor_view_shares_the_terminal_areas_key_space_with_the_chat_panes {
    // editors.t27 keeps its own copies of these two numbers; the window's pane table is the truth
    assert VIEW_NONE == PANE_NONE;
    assert VIEW_EDITOR < PANE_NONE;
    assert VIEW_EDITOR > 255;
    // with no editor open the area shows what it always did: the chat's pane for Claude Code, else nothing
    assert view_key(false, true, 2) == 2;
    assert view_key(false, false, 2) == PANE_NONE;
    // the editor wins over the chat and does not need one
    assert view_key(true, true, 2) == VIEW_EDITOR;
    assert view_key(true, false, SESSION_NONE) == VIEW_EDITOR;
}

test every_surface_is_glass_at_the_panel_width_and_opaque_black_at_the_full_width {
    // owner, 2026-10-23: the compact (docked) panel is matte black glass all over -- each surface a
    // darker tint over the blur, none opaque -- and the full window and full screen are #000000 all over
    assert on_glass(PANEL_W);
    assert surface_alpha(SURF_SIDEBAR, PANEL_W) == 0.45;
    assert surface_alpha(SURF_CONTENT, PANEL_W) == 0.35;
    assert surface_alpha(SURF_TERMINAL, PANEL_W) == 0.15;
    assert surface_alpha(SURF_PANEL, PANEL_W) == 0.58;
    var k : u32 = SURF_SIDEBAR;
    while (k <= SURF_PANEL) {
        // never opaque on the glass
        assert surface_alpha(k, PANEL_W) < 1.0;
        assert surface_alpha(k, PANEL_W) > 0.0;
        assert surface_clears(k, PANEL_W);
        k = k + 1;
    }
    // the terminal is drawn over the content: together they are the sidebar's tone (0.4475 against 0.45)
    const both : f64 = 1.0 - (1.0 - surface_alpha(SURF_CONTENT, PANEL_W)) * (1.0 - surface_alpha(SURF_TERMINAL, PANEL_W));
    assert @abs(both - surface_alpha(SURF_SIDEBAR, PANEL_W)) < 0.01;
    // a right-hand panel is the darkest surface, and still glass
    assert surface_alpha(SURF_PANEL, PANEL_W) > surface_alpha(SURF_SIDEBAR, PANEL_W);
    assert surface_alpha(SURF_PANEL, PANEL_W) < 1.0;
    // the full window: every surface opaque #000000, the same as the frame and the layer
    assert on_glass(W_PT) == false;
    k = SURF_SIDEBAR;
    while (k <= SURF_PANEL) {
        assert surface_alpha(k, W_PT) == 1.0;
        assert surface_alpha(k, W_PT) == backdrop_alpha(W_PT);
        assert surface_clears(k, W_PT) == false;
        k = k + 1;
    }
    assert tint_alpha(W_PT) == 1.0;
}

test an_open_panel_takes_its_width_from_the_terminal {
    const sw : f64 = 960.0;
    // no panel: the content runs to the window's edge, as it always did
    assert content_right(sw, false) == sw;
    assert content_w(sw, WS_EXPANDED, false, false) == sw - content_x(WS_EXPANDED, false);
    // a panel (Queen, DOCTOR or KEYS, all QP_W wide): the content ends at the panel's left edge
    assert content_right(sw, true) == qp_left(sw);
    assert content_right(sw, true) == sw - QP_W;
    assert content_w(sw, WS_EXPANDED, false, true) == content_w(sw, WS_EXPANDED, false, false) - QP_W;
    assert content_w(sw, WS_EXPANDED, false, true) == 387.0;
    assert content_w(sw, WS_EXPANDED, true, true) == 660.0;
    // the grid the pty is resized to is narrower, and its last cell ends before the panel begins
    assert tp_cols(content_w(sw, WS_EXPANDED, false, true)) < tp_cols(content_w(sw, WS_EXPANDED, false, false));
    assert tp_cols(content_w(sw, WS_EXPANDED, false, true)) == 49;
    assert tp_cell_x(content_x(WS_EXPANDED, false), tp_cols(content_w(sw, WS_EXPANDED, false, true))) <= qp_left(sw);
    // full screen: wider window, same rule
    assert content_w(1920.0, WS_EXPANDED, false, true) == 1920.0 - QP_W - content_x(WS_EXPANDED, false);
    // a window too narrow for the panel leaves no negative width
    assert content_w(200.0, WS_COMPACT, false, true) == 0.0;
}

test the_keys_foot_gives_the_status_the_open_in_row_and_each_chip_row_a_band_at_960_by_540 {
    const ft : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT);
    const last : f64 = ky_row_top(WS_TOP, PROVIDER_COUNT - 1);
    // the foot starts below the last provider row's buttons and plates
    assert last + KY_BTN_DY + KY_BTN_H + 2.0 <= foot_status_top(ft);
    // the bench Mac's six chips (T27 OS, Cursor, Xcode, Antigravity, Antigravity IDE, ZCode) are two rows
    assert foot_status_fits(ft, H_PT);
    assert foot_chips(ft, H_PT, 6) == 6;
    assert foot_chips_top(ft) + 2.0 * ED_SLOT_H <= H_PT;
    // the second row of chips (the screenshot's Antigravity row) is below the status line's ink, not on it
    const status_base : f64 = foot_status_top(ft) + FT_BASE;
    const row1_base : f64 = ed_slot_y(foot_chips_top(ft), ED_COLS) + ED_BASE;
    assert row1_base - FT_ASC > status_base + FT_DESC;
    // status, OPEN IN, chip row 0, chip row 1: each baseline is a full ink height below the one before
    const head_base : f64 = foot_head_top(ft) + FT_BASE;
    const row0_base : f64 = ed_slot_y(foot_chips_top(ft), 0) + ED_BASE;
    assert head_base - FT_ASC > status_base + FT_DESC;
    assert row0_base - FT_ASC > head_base + FT_DESC;
    assert row1_base - FT_ASC > row0_base + FT_DESC;
    // a taller window or a full screen shows every chip of a full table, and still nothing under the bottom edge
    assert foot_chips(ft, 900.0, EDITOR_COUNT) == EDITOR_COUNT;
    assert foot_chips(ft, 1440.0, EDITOR_COUNT) == EDITOR_COUNT;
    assert foot_bottom(ft, 900.0, EDITOR_COUNT) <= 900.0;
    // the window's own height holds six chips of a longer table: whole rows only, never a partial one
    assert foot_chips(ft, H_PT, EDITOR_COUNT) == 6;
}

/// Test helper: how many sampled points of the terminal's rectangle (every 12 pt) a window control answers at.
/// The title bar, the header (toggle, Close Dashboard, "+"), the compact dashboard bar, the sidebar and a
/// right-hand panel all lie outside that rectangle, so this is 0 in every layout. The home logo's petals need
/// the home screen, where no pane is up.
fn controls_under_term(sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> u32 {
    var hits : u32 = 0;
    const l : f64 = content_x(ws, collapsed);
    const r : f64 = l + content_w(sw, ws, collapsed, panel);
    var y : f64 = WS_TOP + HEADER_H;
    while (y < sh - SB_H) {
        var x : f64 = l;
        while (x < r) {
            if (on_home_button(x, y, sw) or on_full_button(x, y, sw) or on_dock_button(x, y, sw)) { hits = hits + 1; }
            if (on_nav_back(x, y, false) or on_nav_back(x, y, true)) { hits = hits + 1; }
            if (on_open_dash(x, y, sw, ws) or on_close_dash(x, y, ws, collapsed)) { hits = hits + 1; }
            if (on_side_toggle(x, y, ws, collapsed) or on_new_chat(x, y, sw, ws)) { hits = hits + 1; }
            // the sidebar's rows and its "+" answer only where in_side says the sidebar is
            if (in_side(x, ws, collapsed)) { hits = hits + 1; }
            if (on_repo_link(x, y, sw, sh) or on_doctor_link(x, y, sw, sh) or on_keys_foot(x, y, sw, sh)) { hits = hits + 1; }
            if (panel and on_panel(x, y, sw, WS_TOP)) { hits = hits + 1; }
            x = x + 12.0;
        }
        y = y + 12.0;
    }
    return hits;
}

test a_click_on_a_terminal_pane_is_the_panes_and_nothing_under_it_answers {
    // the bug: the input row of a Claude Code pane lies over a honeycomb cell, and the click opened an agent chat
    const sw : f64 = W_PT;
    const sh : f64 = H_PT;
    const bl : f64 = body_left(sw, WS_EXPANDED, false);
    const bt : f64 = body_top(WS_EXPANDED);
    const bw : f64 = body_w(sw, WS_EXPANDED, false);
    const bh : f64 = body_h(sw, sh, WS_EXPANDED, false);
    const cx : f64 = hex_c(4, 0, bl, bt, bw, bh);
    const cy : f64 = hex_c(4, 1, bl, bt, bw, bh);
    assert card_at(cx, cy, sw, sh, WS_EXPANDED, false) == 4;
    assert on_term(cx, cy, sw, sh, WS_EXPANDED, false, false);
    // with a pane up the click is the pane's and no card answers it, in the click and under the cursor
    assert term_click(term_up(true, 2), cx, cy, sw, sh, WS_EXPANDED, false, false);
    assert card_live(term_up(true, 2), cx, cy, sw, sh, WS_EXPANDED, false) == CARD_SLOTS;
    // the editor view is a pane too
    assert term_up(true, VIEW_EDITOR);
    assert term_click(term_up(true, VIEW_EDITOR), cx, cy, sw, sh, WS_EXPANDED, false, false);
    // with no pane the card answers as before, and the pane takes nothing
    assert term_up(true, PANE_NONE) == false;
    assert term_up(false, 2) == false;
    assert term_click(term_up(true, PANE_NONE), cx, cy, sw, sh, WS_EXPANDED, false, false) == false;
    assert card_live(term_up(true, PANE_NONE), cx, cy, sw, sh, WS_EXPANDED, false) == 4;
    // the rectangle is the terminal's: right of the sidebar, under the header, short of an open panel
    assert on_term(content_x(WS_EXPANDED, false) + 1.0, WS_TOP + HEADER_H + 1.0, sw, sh, WS_EXPANDED, false, false);
    assert on_term(content_x(WS_EXPANDED, false) - 2.0, WS_TOP + HEADER_H + 1.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(500.0, WS_TOP + HEADER_H - 1.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(500.0, sh, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_term(sw - 1.0, 300.0, sw, sh, WS_EXPANDED, false, false);
    assert on_term(sw - 1.0, 300.0, sw, sh, WS_EXPANDED, false, true) == false;
    assert on_term(qp_left(sw) - 1.0, 300.0, sw, sh, WS_EXPANDED, false, true);
    // the sidebar's rows, the header's buttons, the title bar, the dashboard bar: none is inside the rectangle
    assert controls_under_term(sw, sh, WS_EXPANDED, false, false) == 0;
    assert controls_under_term(sw, sh, WS_EXPANDED, false, true) == 0;
    assert controls_under_term(sw, sh, WS_EXPANDED, true, false) == 0;
    assert controls_under_term(1728.0, 1117.0, WS_EXPANDED, false, false) == 0;
    assert controls_under_term(1728.0, 1117.0, WS_EXPANDED, false, true) == 0;
    assert controls_under_term(700.0, 900.0, WS_DASHBOARD, false, false) == 0;
    assert controls_under_term(PANEL_W, 900.0, WS_COMPACT, false, false) == 0;
    assert controls_under_term(PANEL_W, 900.0, WS_COMPACT, false, true) == 0;
}

test chat_is_the_third_petal_and_cmd_3_opens_it {
    assert PETAL_CHAT == 2;
    assert petal_for_key(3, MOD_COMMAND) == PETAL_CHAT;
    assert petal_for_key(1, MOD_COMMAND) == 0;
    assert petal_for_key(4, MOD_COMMAND) == 3;
    assert PETAL_CHAT != 0;
}

test each_petal_is_a_letter_and_draws_its_console {
    var p : u32 = 0;
    while (p < 27) {
        assert letter_of_petal(p) == p + 1;
        assert dash_total(letter_of_petal(p), 960.0, content_x(WS_EXPANDED, false)) > 0.0;
        p = p + 1;
    }
    assert letter_of_petal(27) == 0;
    assert dash_total(0, 960.0, content_x(WS_EXPANDED, false)) == 0.0;
    assert letter_of_petal(PETAL_CHAT) == 3;
}

test a_home_tab_keeps_the_chats_frame_and_the_narrow_window_keeps_its_own {
    assert home_ws(WS_EXPANDED) == WS_EXPANDED;
    assert home_ws(WS_DASHBOARD) == WS_EXPANDED;
    assert home_ws(WS_COMPACT) == WS_COMPACT;
    assert side_ws(PETAL_CHAT, WS_DASHBOARD) == WS_DASHBOARD;
    assert side_ws(21, WS_DASHBOARD) == WS_EXPANDED;
    assert side_ws(21, WS_COMPACT) == WS_COMPACT;
    // the sidebar toggle sits where the chat's does, and answers on a home tab in the expanded and forced layouts
    assert on_side_toggle(content_x(home_ws(WS_EXPANDED), false) + 20.0, WS_TOP + 22.0, home_ws(WS_EXPANDED), false);
    assert on_side_toggle(20.0, WS_TOP + 22.0, home_ws(WS_EXPANDED), true);
    assert on_side_toggle(20.0, WS_TOP + 22.0, home_ws(WS_COMPACT), false) == false;
    assert on_nav_back(home_x(false) + 2.0, 0.5 * TITLE_H, false);
    // the page starts under the header's divider
    assert home_view_top() == WS_TOP + HEADER_H + 1.0;
    assert home_view_h(H_PT) == H_PT - WS_TOP - HEADER_H - 1.0;
    assert HEAD_H > 200.0;
    assert WEIGHT_HEAVY > WEIGHT_BOLD;
    assert on_home_view(SIDE_W + 40.0, home_view_top() + 5.0, WS_EXPANDED, false);
    assert on_home_view(SIDE_W - 40.0, home_view_top() + 5.0, WS_EXPANDED, false) == false;
    assert on_home_view(SIDE_W - 40.0, home_view_top() + 5.0, WS_EXPANDED, true);
    assert on_home_view(SIDE_W + 40.0, WS_TOP + 10.0, WS_EXPANDED, false) == false;
}

test the_evolve_rule_shows_a_suggestion_but_starts_no_agent {
    assert EVOLVE_SPAWNS == false;
    const d : u32 = evolve_next(0, 0, 0);
    assert d != 0;
    assert dec_action(d) == D_TASK;
    assert dec_letter(d) >= 1 and dec_letter(d) <= LETTER_COUNT;
    assert evolve_next(0, 0, 5) != 0;
    assert evolve_next(0, 4, 0) == 0;
    const d2 : u32 = evolve_next(letter_bit(dec_letter(d)), 0, 0);
    assert d2 == 0 or dec_letter(d2) != dec_letter(d);
}

test the_sidebar_rows_of_one_letter_end_above_the_foot {
    assert sec_end(WS_TOP) <= H_PT - FOOT_H - 40.0;
    assert in_side(SIDE_W - 40.0, home_ws(WS_DASHBOARD), false);
    assert in_side(SIDE_W + 20.0, WS_EXPANDED, false) == false;
    assert sec_at(1.0, WS_TOP + 1.0, WS_TOP) == SEC_NONE;
}

test the_scroll_of_a_console_ends_with_the_page_and_the_thumb_stays_on_its_line {
    const vh : f64 = home_view_h(H_PT);
    const cx : f64 = content_x(WS_EXPANDED, false);
    var o : u32 = 1;
    var long : u32 = 0;
    while (o <= LETTER_COUNT) {
        const tot : f64 = dash_total(o, 960.0, cx);
        const m : u32 = dash_scroll_max(tot, vh);
        assert dash_scroll_clamp(m, 5000, tot, vh) == m;
        assert dash_scroll_clamp(0, -5000, tot, vh) == 0;
        assert tot - @as(f64, @floatFromInt(m)) <= vh + 1.0;
        if (m > 0) {
            long = long + 1;
            const th : f64 = thumb_h(vh, tot);
            assert th >= 28.0;
            assert th <= vh - 8.0;
            assert thumb_y(0, m, vh, th) == 4.0;
            assert @abs(thumb_y(m, m, vh, th) + th - (vh - 4.0)) < 0.001;
            assert thumb_y(m / 2, m, vh, th) > 4.0;
        }
        o = o + 1;
    }
    // the letters with many instruments (K, Z with the courses) scroll
    assert long >= 2;
    assert dash_scroll_max(dash_total(26, 960.0, cx), vh) > dash_scroll_max(dash_total(3, 960.0, cx), vh);
    assert thumb_y(0, 0, vh, 28.0) == 4.0;
}

test the_central_button_opens_the_agents_dialog_and_every_petal_opens_its_dashboard {
    // the hollow triangle is not a petal: the tap there is the agents dialog, petal C's chat screen
    assert PETAL_CENTRE != PETAL_NONE and PETAL_CENTRE > PETAL_COUNT;
    assert home_tap(PETAL_NONE, true) == PETAL_CHAT;
    assert home_tap(PETAL_NONE, false) == STATE_HOME;
    assert home_tap(5, false) == 5;
    // dashboard first: every petal, C included, opens the cockpit (cons2 true); the centre opens the dialog (cons2 false)
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert tap_cons(p, false);
        p = p + 1;
    }
    assert tap_cons(PETAL_NONE, true) == false;
    assert tap_cons(PETAL_CHAT, false);
    // the hover value and the shortcut: Cmd+Enter, alone
    assert agents_key(36, MOD_COMMAND);
    assert agents_key(36, 0) == false;
    assert agents_key(36, MOD_COMMAND + MOD_SHIFT) == false;
    assert agents_key(36, MOD_COMMAND + MOD_OPTION) == false;
    assert agents_key(18, MOD_COMMAND) == false;
    assert petal_for_key(digit_of(36), MOD_COMMAND) == PETAL_NONE;
}

test the_c_dashboard_has_the_agents_block_and_the_other_letters_do_not {
    const pw : f64 = 700.0;
    assert big_cols(PETAL_CHAT + 1, pw) == 2;
    assert big_cols(4, pw) == 0;
    assert hit_class(hit_pack(HC_CHAT, 0)) == HC_CHAT;
    assert hit_class(HIT_NONE) == 0;
    assert ID_H > 100.0 and GLYPH_PT >= 160.0 and GLYPH_PT <= 200.0;
    assert PB_QUERY >= PB_PINS and PB_PRE >= PB_QUERY + 32 and PB_PRE + 96 <= PB_SIZE;
    assert D_PINN > D_ST + 195 and D_PINN < D_KEYS and D_PINLET < D_KEYS;
    assert D_VIS > D_ST + 195 and D_VIS < D_PINN and D_REQ + REQ_VISIBLE <= D_WANTPX and D_TPX < D_KEYS;
}

test tiles_are_matte_glass_at_the_panel_width_and_black_at_the_full_width {
    assert on_glass(PANEL_W);
    assert tile_body_alpha(PANEL_W) == surface_alpha(SURF_CONTENT, PANEL_W);
    assert tile_body_alpha(PANEL_W) < 1.0;
    assert on_glass(W_PT) == false;
    assert tile_body_alpha(W_PT) == 1.0;
    assert tile_image_blend() == BLEND_SCREEN;
    assert tile_image_alpha() == 0.92;
    assert TILE_CORNER == 10.0;
    assert TILE_BORDER == 0.14;
}

test agents_are_hover_text_not_badges {
    var b : [24]u8 = undefined;
    const n : usize = agents_text(b[0..24], 11, 3, 22, 0);
    assert n == 9;
    assert b[0] == 75;
    assert b[1] == 32;
    assert b[2] == 46;
    assert b[4] == 67;
    assert agents_text(b[0..24], 0, 0, 0, 0) == 0;
    assert agents_text(b[0..24], 11, 0, 0, 0) == 1;
    var i : u32 = 0;
    while (i < WIDGET_COUNT) {
        assert agents_of_widget(i, 0) != 0;
        assert agents_text(b[0..24], @as(u32, agents_of_widget(i, 0)), @as(u32, agents_of_widget(i, 1)), @as(u32, agents_of_widget(i, 2)), @as(u32, agents_of_widget(i, 3))) >= 1;
        i = i + 1;
    }
}

// ---- tests of the tool pages' own glue (the decisions are tested in bench.t27, kanban.t27, queen_board.t27) ----

test hex_idcodes_print_as_eight_digits_and_whole_lines_are_kept {
    var b : [32]u8 = undefined;
    const n : usize = put_hex8(b[0..32], 0, 0x3727093);
    assert n == 10;
    assert b[0] == 48 and b[1] == 120 and b[2] == 48 and b[3] == 51 and b[4] == 55 and b[9] == 51;
    const n2 : usize = put_hex8(b[0..32], 0, 0x4ba00477);
    assert b[2] == 52 and b[3] == 98 and b[9] == 55;
    assert n2 == 10;
    var t : [16]u8 = undefined;
    t[0] = 97; t[1] = 10; t[2] = 98; t[3] = 99;
    assert tg_whole_lines(t[0..16], 0, 4) == 2;
    assert tg_whole_lines(t[0..16], 0, 2) == 2;
    assert tg_whole_lines(t[0..16], 2, 2) == 0;
    assert tg_whole_lines(t[0..16], 0, 0) == 0;
}

fn test_load(tb: []u8, at: usize, s: string) -> usize {
    var i : usize = 0;
    while (i < s.len) { tb[at + i] = s[i]; i = i + 1; }
    return s.len;
}

test the_bench_state_reads_the_regions_the_feed_filled {
    var tg : [128]u64 = undefined;
    var tb : [49152]u8 = undefined;
    var z : usize = 0;
    while (z < 128) { tg[z] = 0; z = z + 1; }
    const scan : string = "000 004 0x0403:0x6014 ft232H Digilent 210512180081 x\n000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const det : string = "index 0:\n\tidcode 0x4ba00477\nindex 1:\n\tidcode 0x3727093\n";
    tg[TPG_BN_LEN] = test_load(tb[0..49152], TBO_SCAN, scan) as u64;
    tg[TPG_BN_LEN + 2] = test_load(tb[0..49152], TBO_DET0 + 2048, det) as u64;
    // nothing ran yet: the cables are seen, --detect has not been read
    assert die_status(bn_state(tg[0..128], tb[0..49152], 1)) == 1;
    tg[TPG_BN_DET] = 2;
    assert die_status(bn_state(tg[0..128], tb[0..49152], 1)) == 2;
    // card 0 (AX7203): its cable is seen but its detect did not run
    assert die_status(bn_state(tg[0..128], tb[0..49152], 0)) == 1;
    tg[TPG_BN_BUS + 1] = 2;
    // FLASH opens the dialogue on a ready card and takes a .bit path, a Return and a CONFIRM stage; CANCEL ends it
    assert tg[TPG_BA_FS] == 0;
    bench_click_do(tg[0..128], tb[0..49152], 8 + BH_FLASH);
    assert tg[TPG_BA_FS] == FS_TYPING;
    assert tg[TPG_BA_CARD] == 1;
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 47);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 97);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 59);
    assert tg[TPG_BA_PLEN] == 2;
    bench_key(tg[0..128], tb[0..49152], FE_RETURN, 0);
    assert tg[TPG_BA_FS] == FS_TYPING;
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 46);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 98);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 105);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 116);
    bench_key(tg[0..128], tb[0..49152], TG_EV_BACK, 0);
    bench_key(tg[0..128], tb[0..49152], TG_EV_CHAR, 116);
    bench_key(tg[0..128], tb[0..49152], FE_RETURN, 0);
    assert tg[TPG_BA_FS] == FS_CONFIRM;
    assert tb[TBO_PATH] == 47 and tb[TBO_PATH + 1] == 97 and tg[TPG_BA_PLEN] == 6;
    // a Return never loads: it stays at the confirm line
    bench_key(tg[0..128], tb[0..49152], FE_RETURN, 0);
    assert tg[TPG_BA_FS] == FS_CONFIRM;
    bench_click_do(tg[0..128], tb[0..49152], 8 + BH_CANCEL);
    assert tg[TPG_BA_FS] == 0;
    // the AX7203's card cannot be flashed: its chain was never read
    bench_click_do(tg[0..128], tb[0..49152], BH_FLASH);
    assert tg[TPG_BA_FS] == 0;
    // DETECT asks for a refresh now
    tg[TPG_BN_LAST] = 90;
    bench_click_do(tg[0..128], tb[0..49152], 8 + BH_DETECT);
    assert tg[TPG_BN_LAST] == 0;
}

test the_board_picks_a_card_up_and_a_drop_only_proposes {
    var tg : [128]u64 = undefined;
    var tb : [49152]u8 = undefined;
    var z : usize = 0;
    while (z < 128) { tg[z] = 0; z = z + 1; }
    tg[TPG_K_LEN] = test_load(tb[0..49152], TBO_KAN, kb_sample()) as u64;
    const x0 : f64 = 280.0;
    const y0 : f64 = 79.0;
    const pw : f64 = 680.0;
    const ph : f64 = 461.0;
    const bh : f64 = ph - KN_HEAD;
    // the first TODO card (issue 11275) sits in column 1, slot 0
    const tx : f64 = x0 + kb_card_x(1, pw) + 4.0;
    const ty : f64 = y0 + KN_HEAD + kb_card_y(0) + 4.0;
    const ls : u32 = kn_card_under(tg[0..128], tb[0..49152], tx, ty, x0, y0, pw, ph);
    assert ls == 0;
    // a gap between two cards, and the column head, hold no card
    assert kn_card_under(tg[0..128], tb[0..49152], tx, y0 + KN_HEAD + 4.0, x0, y0, pw, ph) == KB_NONE;
    assert kn_card_under(tg[0..128], tb[0..49152], x0 + 2.0, ty, x0, y0, pw, ph) == KB_NONE;
    kanban_down(tg[0..128], tb[0..49152], tx, ty, x0, y0, pw, ph);
    assert tg[TPG_K_DRAG] == 1;
    assert tg[TPG_K_FROM] == 1;
    // TODO -> DOING: a proposal for card 11275 in column 2, the rule still says TODO
    kanban_up(tg[0..128], tb[0..49152], x0 + kb_col_x(2, pw) + 10.0, ty, x0, y0, pw);
    assert tg[TPG_K_DRAG] == 0;
    assert tg[TPG_K_PNUM] == 11275;
    assert tg[TPG_K_PTO] == 2;
    assert kb_proposes(tg[TPG_K_ACT] as u32);
    assert kb_text(tg[TPG_K_ACT] as u32).len > 20;
    // the proposal moved the card on screen: it is now the first of DOING
    const dx : f64 = x0 + kb_card_x(2, pw) + 4.0;
    var found : u32 = 0;
    var s : u32 = 0;
    while (s < 3) {
        const l2 : u32 = kn_card_under(tg[0..128], tb[0..49152], dx, y0 + KN_HEAD + kb_card_y(s) + 4.0, x0, y0, pw, ph);
        if (l2 == 0) { found = found + 1; }
        s = s + 1;
    }
    assert found == 1;
    // dropping it back on TODO removes the proposal
    kanban_down(tg[0..128], tb[0..49152], dx, y0 + KN_HEAD + kb_card_y(0) + 4.0, x0, y0, pw, ph);
    kanban_up(tg[0..128], tb[0..49152], x0 + kb_col_x(1, pw) + 10.0, ty, x0, y0, pw);
    assert tg[TPG_K_PNUM] == 0;
    // TODO -> DONE is refused and proposes nothing; a drop outside the board does nothing
    kanban_down(tg[0..128], tb[0..49152], tx, ty, x0, y0, pw, ph);
    kanban_up(tg[0..128], tb[0..49152], x0 + kb_col_x(4, pw) + 10.0, ty, x0, y0, pw);
    assert tg[TPG_K_PNUM] == 0;
    assert kb_proposes(tg[TPG_K_ACT] as u32) == false;
    assert kb_text(tg[TPG_K_ACT] as u32).len > 5;
    kanban_down(tg[0..128], tb[0..49152], tx, ty, x0, y0, pw, ph);
    kanban_up(tg[0..128], tb[0..49152], x0 - 20.0, ty, x0, y0, pw);
    assert tg[TPG_K_PNUM] == 0;
    assert tg[TPG_K_DRAG] == 0;
    // scrolling stays inside the longest column
    kanban_scroll(tg[0..128], tb[0..49152], ph, 1);
    assert tg[TPG_K_SCROLL] == 0;
    kanban_scroll(tg[0..128], tb[0..49152], ph, 0 - 1);
    assert tg[TPG_K_SCROLL] == 0;
    assert bh > 0.0;
}

test the_queen_page_reads_the_counters_the_host_wrote_and_says_not_measured_for_the_rest {
    var tg : [128]u64 = undefined;
    var z : usize = 0;
    while (z < 128) { tg[z] = 0; z = z + 1; }
    tg[TPG_Q_AFTER + M_LINKS] = 7;
    tg[TPG_Q_AFTER + M_TESTS] = 15000;
    tg[TPG_Q_UNASS] = 3;
    assert qn_after(tg[0..128], M_LINKS) == 7;
    assert qn_after(tg[0..128], M_TESTS) == 15000;
    assert qn_after(tg[0..128], M_NO_INSTRUMENT) == live_no_instrument();
    assert qn_after(tg[0..128], M_UNASSIGNED) == 3;
    assert qb_measured(qn_after(tg[0..128], 2)) == false;
    assert qb_measured(qn_after(tg[0..128], 5)) == false;
    // the ring copy: only a lane the Queen started inside the last hour counts
    tg[TPG_Q_RING] = ev_pack(0, C_QUEEN_STARTED, 3, 9000);
    tg[TPG_Q_RING + 1] = ev_pack(0, C_QUEEN_STARTED, 4, 100);
    tg[TPG_Q_RING + 2] = ev_pack(0, C_GOD_ON, 0, 9000);
    assert qn_started_hour(tg[0..128], 9100) == 1;
    assert qn_started_hour(tg[0..128], 20000) == 0;
    // the panel it shows gaps from: the letters with no instrument and no pins are the window's own facts
    const p : Panel = make_panel(0);
    assert row_exists(p, 0);
    assert nth_gap(p, 0) != 0;
    assert make_panel(5).no_widget_count == 5;
}

test the_lanes_block_sits_under_the_agents_rows_and_keeps_its_buffers_apart {
    const n : u32 = spaces_shown(SPACES_SEED);
    assert lane_block_top(n, 2) == row_top(WS_TOP, GROUP_AGENTS, n, 1) + AGENT_ROW_H + 8.0;
    assert lane_block_top(n, 0) == lane_block_top(n, 1);
    const top : f64 = lane_block_top(n, 1);
    assert on_lane_block(20.0, top + 5.0, top, H_PT);
    assert on_lane_block(SIDE_W + 1.0, top + 5.0, top, H_PT) == false;
    assert on_lane_block(20.0, H_PT - FOOT_H + 1.0, top, H_PT) == false;
    // the block never draws into the foot: its rows end above it
    assert lv_row_top(top, lane_block_vis(top, H_PT)) <= H_PT - FOOT_H + LV_LABEL_H;
    // the page store: the feed, the tail and the table text lie end to end inside the buffer, after the old regions
    assert TBO_LF >= TBO_SIZE and TBO_LF + TBO_LF_N <= TBO_LT;
    assert TBO_LT + TBO_LT_N <= TBO_LTXT;
    assert TBO_LTXT + LV_MAX as usize * LV_LINE <= TB_LANES_END;
    // the table fits the status array after the sessions' slots
    assert SST_LV + LV_MAX as usize * LV_F <= SST_SIZE;
    assert SST_LVKEY + 1 < SST_LV and SST_LVSEL < SST_LV and SST_LVOFF < SST_LV;
    assert TPG_L_TISSUE < TPG_N and TPG_L_LAST > TPG_PHASE;
}

test the_hive_page_and_the_orbit_keep_their_words_and_buffers_apart {
    // the words: HIVE after the lanes block's, the orbit's scalars, then 32 + 32 slots, all inside the status array
    assert TPG_H_LAST > TPG_L_TISSUE and TPG_H_LANES_LEN < TPG_O_N;
    assert TPG_O_RMSYS < TPG_O_HX and TPG_O_HX + 32 <= TPG_O_HY and TPG_O_HY + 32 <= TPG_O_HP and TPG_O_HP + 32 <= TPG_N as u32;
    assert OV_MAX == 32 and FORMULA_COUNT == 32;
    // the buffers: the feed text and the lanes field lie after the lanes block, end to end, inside the store
    assert TBO_HIVE == TB_LANES_END and TBO_HIVE + TBO_HIVE_N == TBO_HLANES;
    assert TBO_HLANES + TBO_HLANES_N == TBO_QD;
    // both jobs fit the command region (TBO_CMD + 6 .. TBO_ROOT) with room to spare
    var o : [4400]u8 = undefined;
    const wf : usize = dv_feed_cmd("/Users/someone", "/Users/someone/t27", o[0..4400]);
    assert wf > 0 and wf + 6 < TBO_ROOT - TBO_CMD;
    const wp : usize = dv_publish_cmd("/Users/someone", "/Users/someone/t27", "11367:4:1:3600", o[0..4400]);
    assert wp > 0 and wp + 6 < TBO_ROOT - TBO_CMD;
    // the root folder is only ever a plain path: a root with a quote runs nothing
    assert root_safe("/Users/someone/t27");
    assert root_safe("/Users/some one/t27'; rm") == false;
    // the label chip is the orbit's own size, and the card fits the smallest window
    assert LABEL_W > 100 and LABEL_H >= 26;
    assert orb_card_w(960) <= 520 and orb_card_h(505) <= 300;
    // HIVE is petal H (letter 8): its page is the devices page
    assert page_kind(8) == PAGE_HIVE;
    assert page_feed_due(PAGE_HIVE, true, 1060, 1000) and page_feed_due(PAGE_HIVE, false, 1060, 1000) == false;
}

test the_petal_under_the_mouse_is_the_petal_named_and_opened {
    // owner, 2026-10-20: the hover label must be the petal under the mouse. For every petal p: the point where it is
    // DRAWN (home_c / home_k), taken back through the window's own mouse mapping (virt, to_box, on_tap), hits p; its
    // label is WORLD_NAMES[p] (what draw_tooltip draws), and that is the page of letter p + 1 (what a click opens).
    const sc : i64 = fit_permille(960, 540);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const x : f64 = to_pt(cen_x(p), 0, home_c(0, 1.0, W_PT, H_PT), home_k(1.0, W_PT, H_PT));
        const y : f64 = to_pt(cen_y(p), 1, home_c(1, 1.0, W_PT, H_PT), home_k(1.0, W_PT, H_PT));
        const vx : i64 = @as(i64, @intFromFloat(virt(x, 0, 1.0, W_PT, H_PT)));
        const vy : i64 = @as(i64, @intFromFloat(virt(y, 1, 1.0, W_PT, H_PT)));
        const q : u32 = on_tap(STATE_HOME, to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc));
        assert q == p;
        var nb : [32]u8 = undefined;
        const nn : usize = csv_field(WORLD_NAMES, q, nb[0..32]);
        const page : []const u8 = page_of_letter(q + 1);
        assert nn == page.len;
        var i : usize = 0;
        while (i < nn) {
            assert nb[i] == page[i];
            i = i + 1;
        }
        // the letter drawn is the letter of the page opened: petal p is letter p + 1 (petal 0 = A)
        var lb2 : [4]u8 = undefined;
        const l2 : usize = csv_field(PETAL_LETTERS, q, lb2[0..4]);
        assert l2 >= 1 and lb2[0] == petal_letter_byte(q);
        assert letter_of_petal(q) == q + 1;
        if (q < 26) { assert lb2[0] == 65 + q as u8; }
        p = p + 1;
    }
    assert petal_letter_byte(0) == 65 and letter_of_petal(0) == 1;
}

test the_update_line_sits_above_the_foot_and_the_updater_words_are_their_own {
    assert on_update_strip(40.0, H_PT - FOOT_H - 10.0, H_PT, WS_EXPANDED, false, true);
    assert on_update_strip(40.0, H_PT - FOOT_H - 10.0, H_PT, WS_EXPANDED, false, false) == false;
    assert on_update_strip(40.0, H_PT - 5.0, H_PT, WS_EXPANDED, false, true) == false;
    assert on_update_strip(40.0, H_PT - FOOT_H - 10.0, H_PT, WS_EXPANDED, true, true) == false;
    assert TPG_U_ST > TPG_L_TISSUE and TPG_U_STAGED < TPG_N;
    // the scratch the updater reads into ends inside the text store
    assert TBO_SCR + UP_SUMS + 140 + 3 * UP_VER <= TBO_SIZE;
    assert UP_CAP + 7 <= TBO_ROOT - TBO_CMD;
}

test the_live_data_file_ships_the_built_in_levels_so_publishing_it_unedited_changes_nothing {
    var tbl : [15]u32 = undefined;
    thv_defaults(tbl[0..15]);
    assert tbl[THV_TINT_BLACK] == TH_TINT_BLACK;
    assert tbl[THV_STRICT_SIDE] == TH_STRICT_SIDE;
    assert tbl[THV_STRICT_CONTENT] == TH_STRICT_CONTENT;
    assert tbl[THV_ELEVATED_BLACK] == TH_ELEVATED_BLACK;
    assert tbl[THV_PANEL_BLACK] == TH_PANEL_BLACK;
    assert tbl[THV_TERMINAL_TINT] == TH_TERMINAL_TINT;
    assert tbl[THV_TEXT_WHITE] == TH_TEXT_WHITE;
    assert tbl[THV_LABEL_WHITE] == TH_LABEL_WHITE;
    assert tbl[THV_MUTED_WHITE] == TH_MUTED_WHITE;
    assert tbl[THV_BORDER_WHITE] == TH_BORDER_WHITE;
    assert tbl[THV_LINE_WHITE] == TH_LINE_WHITE;
    assert tbl[THV_HIGHLIGHT_WHITE] == TH_HIGHLIGHT_WHITE;
    assert tbl[THV_TIP_WHITE] == TH_TIP_WHITE;
    assert tbl[THV_CROWN_WHITE] == TH_CROWN_WHITE;
    assert tbl[THV_AGENTS_LINE_ALPHA] == TH_AGENTS_LINE_ALPHA;
    assert PETALS == WORLD_NAMES;
    assert LIVE_END == 1;
}

test the_live_levels_reach_the_kit_and_the_surface_alphas_follow_them {
    var tbl : [15]u32 = undefined;
    thv_defaults(tbl[0..15]);
    var kit : [48]u64 = undefined;
    thv_store(kit[0..48], tbl[0..15]);
    // built-in: the live path draws exactly what the constants did
    assert lv(kit, THV_TEXT_WHITE) == TEXT_WHITE;
    assert lv(kit, THV_LABEL_WHITE) == LABEL_WHITE;
    assert lv(kit, THV_MUTED_WHITE) == MUTED_WHITE;
    assert lv(kit, THV_TINT_BLACK) == TINT_BLACK;
    assert surface_alpha_lv(kit, SURF_SIDEBAR, PANEL_W) == surface_alpha(SURF_SIDEBAR, PANEL_W);
    assert surface_alpha_lv(kit, SURF_CONTENT, PANEL_W) == surface_alpha(SURF_CONTENT, PANEL_W);
    assert surface_alpha_lv(kit, SURF_TERMINAL, PANEL_W) == surface_alpha(SURF_TERMINAL, PANEL_W);
    assert surface_alpha_lv(kit, SURF_PANEL, PANEL_W) == surface_alpha(SURF_PANEL, PANEL_W);
    // a live module moved two levels: the next frame reads them, the rest stay
    tbl[THV_STRICT_SIDE] = 300;
    tbl[THV_TEXT_WHITE] = 950;
    thv_store(kit[0..48], tbl[0..15]);
    assert surface_alpha_lv(kit, SURF_SIDEBAR, PANEL_W) == 0.3;
    assert lv(kit, THV_TEXT_WHITE) == 0.95;
    assert surface_alpha_lv(kit, SURF_CONTENT, PANEL_W) == STRICT_CONTENT;
    // the full window stays opaque black whatever the live module says
    assert on_glass(W_PT) == false;
    assert surface_alpha_lv(kit, SURF_SIDEBAR, W_PT) == 1.0;
}

test the_petal_count_the_live_names_must_match_is_the_built_in_one {
    // 27 names, 26 commas: live_petals is asked for PETAL_COUNT - 1
    var commas : u32 = 0;
    var i : usize = 0;
    while (i < WORLD_NAMES.len) {
        if (WORLD_NAMES[i] == 44) { commas += 1; }
        i += 1;
    }
    assert commas == PETAL_COUNT - 1;
}

test the_pane_menu_slots_sit_above_the_orbit_slots {
    assert TPG_T_MENU > TPG_O_HP + 31;
    assert TPG_T_MX == TPG_T_MENU + 1 and TPG_T_MY == TPG_T_MX + 1 and TPG_T_DRAG == TPG_T_MY + 1;
    assert TPG_T_DRAG < TPG_N as u32;
    assert TPG_T_MENU > TPG_QD_FLAGS;
}

/// A zeroed profile region (a test helper; the window's own is in the text store).
fn pft_blank(pf: []u8) -> void {
    var i : usize = 0;
    while (i < pf.len) {
        pf[i] = 0;
        i = i + 1;
    }
}

/// Put the bytes of s at `at` in the region (a test helper).
fn pft_put(pf: []u8, at: usize, s: []const u8) -> usize {
    var i : usize = 0;
    while (i < s.len) {
        pf[at + i] = s[i];
        i = i + 1;
    }
    return s.len;
}

// P. These tests cover the boxes, the typing and the state steps of the profile (no window, no file, no picture):
// nothing here shows that the circle or the panel look right on screen.
test the_profile_circle_stands_between_the_header_cluster_and_the_refresh_arc {
    const widths : [4]f64 = [480.0, PANEL_W, W_PT, 1440.0];
    var i : usize = 0;
    while (i < 4) {
        const w : f64 = widths[i];
        const cx : f64 = pf_head_cx(w);
        // right of the cluster (GOD MODE, UPDATE NOW), left of the refresh arc (drawn at rx +- 4.5)
        assert cx - PRF_HEAD_R >= hdr_right(w);
        assert cx + PRF_HEAD_R < dock_x(w) - DOCK_STEP + 0.5 * FULL_PT - 4.5;
        assert pf_head_cy() == 0.5 * TITLE_H;
        assert on_pf_head(cx, pf_head_cy(), w);
        assert on_pf_head(cx + PRF_HEAD_R + 1.0, pf_head_cy(), w) == false;
        assert on_pf_head(cx, TITLE_H + 2.0, w) == false;
        // no other title bar control answers at the circle's centre, and the circle answers at none of theirs
        assert on_god_switch(cx, pf_head_cy(), hdr_right(w), TITLE_H) == false;
        assert on_dock_button(cx, pf_head_cy(), w) == false;
        assert on_full_button(cx, pf_head_cy(), w) == false;
        assert on_home_button(cx, pf_head_cy(), w) == false;
        assert on_pf_head(full_x(w) + 10.0, pf_head_cy(), w) == false;
        assert on_pf_head(dock_x(w) + 10.0, pf_head_cy(), w) == false;
        i = i + 1;
    }
    assert PF_RESERVE == PRF_HEAD_D + PRF_HEAD_GAP;
}

test the_profile_panel_boxes_hit_their_own_control_and_stay_inside_the_slot {
    const l : f64 = qp_left(W_PT);
    const t : f64 = WS_TOP;
    assert prf_panel_hit(prf_avatar_cx(l, QP_W), prf_avatar_cy(t), l, QP_W, t, false) == PRF_H_CHOOSE;
    assert prf_panel_hit(prf_btn_x(l, QP_W, 0) + 5.0, prf_btn_y(t) + 5.0, l, QP_W, t, false) == PRF_H_CHOOSE;
    assert prf_panel_hit(prf_btn_x(l, QP_W, 1) + 5.0, prf_btn_y(t) + 5.0, l, QP_W, t, true) == PRF_H_REMOVE;
    assert prf_panel_hit(prf_btn_x(l, QP_W, 1) + 5.0, prf_btn_y(t) + 5.0, l, QP_W, t, false) == PRF_H_NONE;
    assert prf_panel_hit(prf_field_x(l) + 20.0, prf_field_y(t) + 10.0, l, QP_W, t, false) == PRF_H_FIELD;
    assert prf_panel_hit(prf_save_x(l) + 20.0, prf_save_y(t) + 10.0, l, QP_W, t, false) == PRF_H_SAVE;
    assert prf_panel_hit(l - 5.0, prf_field_y(t) + 10.0, l, QP_W, t, false) == PRF_H_NONE;
    // CANCEL is its own box beside SAVE: it answers there, SAVE does not, and it ends inside the slot's padding
    const cx : f64 = pf_cancel_x(l) + 0.5 * PRF_SAVE_W;
    const cy : f64 = prf_save_y(t) + 0.5 * PRF_BTN_H;
    assert on_pf_cancel(cx, cy, l, t);
    assert prf_panel_hit(cx, cy, l, QP_W, t, true) == PRF_H_NONE;
    assert on_pf_cancel(prf_save_x(l) + 20.0, cy, l, t) == false;
    assert pf_cancel_x(l) >= prf_save_x(l) + PRF_SAVE_W;
    assert pf_cancel_x(l) + PRF_SAVE_W <= l + QP_W - QP_PAD;
    // both picture buttons, the field and the circle lie inside the 300 pt slot
    assert prf_btn_x(l, QP_W, 1) + prf_btn_w(QP_W) <= l + QP_W - QP_PAD + 0.001;
    assert prf_field_x(l) + prf_field_w(QP_W) <= l + QP_W - QP_PAD + 0.001;
    assert prf_avatar_cx(l, QP_W) - PRF_AV_R >= l and prf_avatar_cx(l, QP_W) + PRF_AV_R <= l + QP_W;
    // the three status lines end inside the default window
    assert prf_status_y(t) + 26.0 < H_PT;
}

test typing_joins_units_cuts_at_24_characters_and_goes_back_one_code_point {
    var pf : [512]u8 = undefined;
    pft_blank(pf[0..512]);
    pf_to_edit(pf[0..512]);
    assert pf_editing(pf[0..512]);
    assert pf_shown_at(pf[0..512]) == PF_TYPED;
    pf_unit(pf[0..512], 65);
    pf_unit(pf[0..512], 110);
    assert pf_shown_len(pf[0..512]) == 2;
    pf_back(pf[0..512]);
    assert pf_shown_len(pf[0..512]) == 1;
    // a Cyrillic letter is two bytes, a surrogate pair (one emoji) is four, joined over two units
    pf_unit(pf[0..512], 1103);
    assert pf_shown_len(pf[0..512]) == 3;
    pf_unit(pf[0..512], 55357);
    assert pf_shown_len(pf[0..512]) == 3;
    pf_unit(pf[0..512], 56832);
    assert pf_shown_len(pf[0..512]) == 7;
    pf_back(pf[0..512]);
    assert pf_shown_len(pf[0..512]) == 3;
    // a control character and a function key (63232 is the up arrow) add nothing
    pf_unit(pf[0..512], 1);
    pf_unit(pf[0..512], 63232);
    assert pf_shown_len(pf[0..512]) == 3;
    var k : u32 = 0;
    while (k < 40) {
        pf_unit(pf[0..512], 98);
        k = k + 1;
    }
    // A + one Cyrillic letter (2 bytes) + 22 more: 24 code points in 25 bytes
    assert pf_shown_len(pf[0..512]) == 25;
    assert prf_nick_cp_count(pf[PF_TYPED .. PF_TYPED + 25]) == 24;
    assert pf_shown_len(pf[0..512]) <= PRF_NICK_MAX_BYTES;
}

test escape_and_cancel_bring_the_saved_nickname_back_and_write_nothing {
    var pf : [512]u8 = undefined;
    pft_blank(pf[0..512]);
    pf_set(pf[0..512], PF_SLEN, @as(u32, @intCast(pft_put(pf[0..512], PF_SAVED, "Bob"))));
    assert pf_editing(pf[0..512]) == false;
    assert pf_shown_at(pf[0..512]) == PF_SAVED;
    assert pf_shown_len(pf[0..512]) == 3;
    pf_to_edit(pf[0..512]);
    assert pf_shown_at(pf[0..512]) == PF_TYPED;
    assert pf_shown_len(pf[0..512]) == 3;
    assert pf[PF_TYPED] == 66;
    pf_unit(pf[0..512], 88);
    assert pf_shown_len(pf[0..512]) == 4;
    // a second click on the field keeps the typed text
    pf_to_edit(pf[0..512]);
    assert pf_shown_len(pf[0..512]) == 4;
    pf_leave(pf[0..512], PRF_EV_CANCEL);
    assert pf_editing(pf[0..512]) == false;
    assert pf_shown_at(pf[0..512]) == PF_SAVED;
    assert pf_shown_len(pf[0..512]) == 3;
    assert pf[PF_SAVED + 2] == 98;
    assert pf_get(pf[0..512], PF_CODE) == PRF_OK;
    // closing the panel mid-edit ends it the same way
    pf_to_edit(pf[0..512]);
    pf_unit(pf[0..512], 89);
    pf_leave(pf[0..512], PRF_EV_CLOSE);
    assert pf_editing(pf[0..512]) == false;
    assert pf_shown_len(pf[0..512]) == 3;
}

test a_paste_keeps_the_printable_text_and_says_when_it_left_something_out {
    var pf : [512]u8 = undefined;
    pft_blank(pf[0..512]);
    pf_to_edit(pf[0..512]);
    pf_paste_in(pf[0..512], "Anna");
    assert pf_shown_len(pf[0..512]) == 4;
    assert pf_get(pf[0..512], PF_CODE) == PRF_OK;
    var dirty : [3]u8 = undefined;
    dirty[0] = 67;
    dirty[1] = 1;
    dirty[2] = 68;
    pf_paste_in(pf[0..512], dirty[0..3]);
    assert pf_shown_len(pf[0..512]) == 6;
    assert pf_get(pf[0..512], PF_CODE) == PRF_E_PASTE_PART;
    assert prf_error_text(PRF_E_PASTE_PART).len > 0;
    // a paste that passes 24 characters stops there
    pf_paste_in(pf[0..512], "0123456789012345678901234567890");
    assert pf_shown_len(pf[0..512]) == 24;
}

test the_profile_region_fits_the_text_store_and_its_words_are_free {
    assert TBO_PF == TBO_QD_HIVE + QD_HIVE_CAP;
    assert TBO_PF + PF_CAP == TBO_RC;
    assert TBO_RC + RC_CAP == TBO_LOG;
    assert TBO_LOG + TBO_LOG_N == TBO_AGENTS;
    assert TBO_AGENTS + TBO_AGENTS_N == TBO_SV and TBO_SV + TBO_SV_N == TB_SIZE;
    // the AGENTS page's words sit in the free run between the tail words and the updater, clear of the footer bar
    assert TPG_AG_LAST == TPG_L_TISSUE + 1;
    assert TPG_AG_LOADED < TPG_U_ST;
    assert TPG_AG_LOADED < TPG_SB_HOST or TPG_AG_LAST > TPG_SB_AT;
    assert TPG_SB_HOST + 3 == TPG_SB_HOSTN;
    assert TPG_AG_LOADED < TPG_N as u32;
    assert PF_TYPED + PRF_NICK_MAX_BYTES <= PF_SAVED;
    assert PF_SAVED + PRF_NICK_MAX_BYTES <= PF_CAP;
    assert PF_HOLD_HI < PF_TYPED;
    assert TPG_PF_IMG < TPG_N as u32;
    assert TPG_PF_IMG > TPG_T_DRAG;
    assert PRF_NICK_MAX_BYTES < 256;
}

test the_header_cluster_and_the_footer_bar_are_where_they_are_drawn_and_a_merge_cannot_drop_them {
    // the GOD MODE switch: drawn by draw_header_cluster at god_x(hdr_right), hit by the same box, on every screen
    const r : f64 = hdr_right(W_PT);
    assert on_god_switch(god_x(r) + 6.0, 0.5 * TITLE_H, r, TITLE_H);
    assert on_god_switch(god_x(r) + 6.0, TITLE_H + 6.0, r, TITLE_H) == false;
    // it sits left of the refresh and dock controls and right of the centred brand
    assert r <= dock_x(W_PT) - DOCK_STEP;
    assert god_x(r) > brand_left(W_PT, 140.0) + 140.0;
    // UPDATE NOW answers only while an update is staged
    assert on_hdr_btn(hdr_btn_x(r) + 6.0, 0.5 * TITLE_H, r, TITLE_H, true);
    assert on_hdr_btn(hdr_btn_x(r) + 6.0, 0.5 * TITLE_H, r, TITLE_H, false) == false;
    // the GOD strip sits right above the footer, the footer fills the bottom SB_H
    assert strip_top(H_PT) + STRIP_H == H_PT - SB_H;
    assert in_bar(H_PT - 1.0, H_PT) and in_bar(H_PT - SB_H - 1.0, H_PT) == false;
    // the state lives in words the host owns, none of them colliding
    assert TPG_SB_HOST + 3 == TPG_SB_HOSTN;
    assert TPG_SB_AT > TPG_SB_COMMITN and TPG_G_NEXT < TPG_N and TPG_SB_HOST > TPG_U_STAGED;
    assert SST_QRUN > SST_LV + 64 * LV_F - 1 and SST_DISK < SST_SIZE and SST_QFEED > SST_SRV;
    // the footer's items all have a page and the right end keeps its three links
    assert item_page(IT_GOD) == PG_GOD and item_page(IT_UPD) == PG_UPDATE and item_page(IT_LIGHT) == PG_KEYS;
    assert repo_left(W_PT) < keys_left(W_PT) and keys_left(W_PT) < doc_left(W_PT);
    assert EV_MAX_AGENTS == 3;
}

test the_queen_control_dashboard_is_where_it_is_drawn_and_nothing_overlaps_the_footer {
    // the page covers the content area from the top of the workspace to the footer, and takes its clicks only there
    const sw : f64 = W_PT;
    const sh : f64 = H_PT;
    assert on_qd_area(qd_area_x(WS_EXPANDED, false) + 10.0, WS_TOP + 10.0, sw, sh, WS_EXPANDED, false, false);
    assert on_qd_area(qd_area_x(WS_EXPANDED, false) + 10.0, sh - 4.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert on_qd_area(10.0, WS_TOP + 10.0, sw, sh, WS_EXPANDED, false, false) == false;
    assert WS_TOP + qd_area_h(sh) == sh - SB_H;
    // closed by default, and a compact panel never shows it
    var z : [560]u32 = undefined;
    var i : usize = 0;
    while (i < 560) { z[i] = 0; i = i + 1; }
    assert qd_open(z[0..560], true, WS_EXPANDED) == false;
    z[SST_QDASH] = 1;
    assert qd_open(z[0..560], true, WS_EXPANDED);
    assert qd_open(z[0..560], true, WS_COMPACT) == false;
    assert qd_open(z[0..560], false, WS_EXPANDED) == false;
    // the dashboard's words and buffers do not collide with the other feeds
    assert TPG_QD_PLANN > TPG_G_NEXT and TPG_QD_FLAGS < TPG_N and SST_QDASH < SST_SIZE and SST_QDASH != SST_DISK;
    assert TBO_QD_PLAN >= TB_LANES_END and TBO_QD_HIVE + QD_HIVE_CAP == TBO_PF and TBO_PF + PF_CAP == TBO_RC and TBO_RC + RC_CAP == TBO_LOG and TBO_LOG + TBO_LOG_N == TBO_AGENTS and TBO_AGENTS + TBO_AGENTS_N == TBO_SV and TBO_SV + TBO_SV_N == TB_SIZE;
    assert TBO_QD_TRIG == TBO_QD_PLAN + QD_PLAN_CAP and TBO_QD_BOARD == TBO_QD_TRIG + QD_TRIG_CAP and TBO_QD_HIVE == TBO_QD_BOARD + QD_BOARD_CAP;
    // the lanes table lists only work rows
    assert qd_lane_index(z[0..560], 0) == LV_NONE;
    z[SST_LVN] = 2;
    z[SST_LV + LVF_SRC] = LV_SCRIPT;
    z[SST_LV + LV_F + LVF_SRC] = LV_SCRIPT;
    z[SST_LV + LV_F + LVF_DEPTH] = LV_GROUP_DEPTH;
    assert qd_lane_index(z[0..560], 0) == 0;
    assert qd_lane_index(z[0..560], 1) == LV_NONE;
}

// ---- the S petal's SPECS page (#12199): the host maps pointer and keys, the petal spec decides ----

/// A buffer b[0..n] holds exactly the text s.
fn sv_is(b: []const u8, n: usize, s: []const u8) -> bool {
    if (n != s.len) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (b[i] != s[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/// The state words and the page's state bytes as launch leaves them, all zero; the petal reads an all-zero state as its open state.
fn sv_fresh(tg: []u64, tb: []u8) -> void {
    var i : usize = 0;
    while (i < 256) {
        tg[i] = 0;
        i = i + 1;
    }
    i = TBO_SV;
    while (i < TBO_SV + TBO_SV_N) {
        tb[i] = 0;
        i = i + 1;
    }
}

test the_specs_page_keeps_its_state_in_a_byte_region_of_its_own_and_names_its_keys {
    // the region ends the text store, right after the AGENTS feed, and holds the whole petal state
    assert TBO_SV == TBO_AGENTS + TBO_AGENTS_N and TBO_SV + TBO_SV_N == TB_SIZE and TBO_SV_N >= PSV_BYTES;
    assert PSV_BYTES == 48;
    assert specs_viz_key_code(SV_KEY_LEFT) == PSV_KEY_LEFT and specs_viz_key_code(SV_KEY_RIGHT) == PSV_KEY_RIGHT;
    assert specs_viz_key_code(SV_KEY_UP) == PSV_KEY_UP and specs_viz_key_code(SV_KEY_DOWN) == PSV_KEY_DOWN;
    assert specs_viz_key_code(TG_KEY_RETURN) == PSV_KEY_ACTIVATE and specs_viz_key_code(SV_KEY_SPACE) == PSV_KEY_TOGGLE;
    assert specs_viz_key_code(KEY_ESCAPE) == PSV_KEY_BACK and specs_viz_key_code(TG_KEY_BACKSPACE) == PSV_KEY_BACK;
    assert specs_viz_key_code(KEY_S) == PSV_KEY_SUM and specs_viz_key_code(SV_KEY_M) == PSV_KEY_MEAN and specs_viz_key_code(SV_KEY_X) == PSV_KEY_MAX;
    // a digit (the petal switch) and a letter the page does not name stay with the shell
    assert specs_viz_key_code(18) == PSV_KEY_NONE and specs_viz_key_code(19) == PSV_KEY_NONE and specs_viz_key_code(0) == PSV_KEY_NONE;
}

test a_trace_value_is_shown_with_six_decimals {
    var b : [32]u8 = undefined;
    assert sv_is(b[0..32], put_fix6(b[0..32], 0, 1000000), "1.000000");
    assert sv_is(b[0..32], put_fix6(b[0..32], 0, 0), "0.000000");
    assert sv_is(b[0..32], put_fix6(b[0..32], 0, 5), "0.000005");
    assert sv_is(b[0..32], put_fix6(b[0..32], 0, 123456789), "123.456789");
}

test the_pointer_maps_to_the_frame_at_any_page_size_and_outside_the_page_picks_nothing {
    // the page 1900 x 1000 points fits at scale 1000 with no margin; a smaller page scales and centres
    assert sv_whole(0.0) == 1 and sv_whole(1900.4) == 1900 and sv_whole(1000000.0) == 100000;
    assert sv_frame_of(0.0 - 1.0, 0, 1000) == PSV_NO_PICK and sv_frame_of(200000.0, 0, 1000) == PSV_NO_PICK;
    assert sv_frame_of(500.0, 0, 1000) == 500 and sv_frame_of(500.0, 100, 1000) == 400;
    assert sv_frame_of(500.0, 0, 500) == 1000;
    // inside the margin is outside the frame
    assert sv_frame_of(50.0, 100, 1000) == PSV_NO_PICK;
    var m : [3]f64 = undefined;
    sv_map(m[0..3], 200.0, 70.0, 1900.0, 1000.0);
    assert m[2] == 1.0 and m[0] == 200.0 and m[1] == 70.0;
    sv_map(m[0..3], 200.0, 70.0, 950.0, 1000.0);
    assert m[2] < 0.51 and m[2] > 0.49 and m[0] == 200.0 and m[1] > 70.0;
}

test a_click_on_a_node_selects_it_in_all_three_views_at_any_page_size_and_origin {
    const g : SpecGraph = psv_graph();
    const geo : PsvGeom = psv_geom(g);
    var sizes : [3]f64 = undefined;
    sizes[0] = 1900.0;
    sizes[1] = 1100.0;
    sizes[2] = 700.0;
    var si : usize = 0;
    while (si < 3) {
        const pw : f64 = sizes[si];
        const ph : f64 = 0.6 * pw;
        var m : [3]f64 = undefined;
        sv_map(m[0..3], 200.0, 70.0, pw, ph);
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            const vb : usize = @as(usize, v);
            var tg : [256]u64 = undefined;
            var tb : [TB_SIZE]u8 = undefined;
            sv_fresh(tg[0..256], tb[0..TB_SIZE]);
            const mx : f64 = sv_x(m[0..3], geo.nx[vb] + geo.nw[vb] / 2);
            const my : f64 = sv_y(m[0..3], geo.ny[vb] + geo.nh[vb] / 2);
            specs_viz_click(tg[0..256], tb[0..TB_SIZE], 200.0, 70.0, pw, ph, mx, my);
            const p : PsvState = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
            assert p.viz.selected == psv_node_ref(v);
            assert psv_seed(p) == v;
            const hl : PsvHl = psv_hl_tables(g, p);
            // the graph box, its matrix row and the touching edge lines all answer the one selection
            assert hl.node[vb] == VIZ_HL_SELECT;
            assert tg[TPG_GEN] != 0;
            v = v + 1;
        }
        si = si + 1;
    }
}

test a_hover_is_drawn_but_never_stored_and_the_stored_state_stays_the_clicked_one {
    const g : SpecGraph = psv_graph();
    const geo : PsvGeom = psv_geom(g);
    var tg : [256]u64 = undefined;
    var tb : [TB_SIZE]u8 = undefined;
    sv_fresh(tg[0..256], tb[0..TB_SIZE]);
    var m : [3]f64 = undefined;
    sv_map(m[0..3], 200.0, 70.0, 1700.0, 900.0);
    const mx : f64 = sv_x(m[0..3], geo.nx[4] + geo.nw[4] / 2);
    const my : f64 = sv_y(m[0..3], geo.ny[4] + geo.nh[4] / 2);
    const shown : PsvState = specs_viz_shown(g, tb[0..TB_SIZE], 200.0, 70.0, 1700.0, 900.0, mx, my);
    assert shown.viz.hover == psv_node_ref(4);
    const stored : PsvState = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert stored.viz.hover == VIZ_REF_NONE;
    // drawing wrote nothing: the state bytes are still the unopened zeros and the redraw counter did not move
    assert tb[TBO_SV] == 0 and tb[TBO_SV + 47] == 0 and tg[TPG_GEN] == 0;
    // the pointer off every entity leaves no hover
    const off : PsvState = specs_viz_shown(g, tb[0..TB_SIZE], 200.0, 70.0, 1700.0, 900.0, 5.0, 5.0);
    assert off.viz.hover == VIZ_REF_NONE;
}

test the_stepper_and_the_aggregation_choice_and_an_edge_toggle_work_from_clicks {
    var tg : [256]u64 = undefined;
    var tb : [TB_SIZE]u8 = undefined;
    sv_fresh(tg[0..256], tb[0..TB_SIZE]);
    const pw : f64 = 1900.0;
    const ph : f64 = 1000.0;
    var m : [3]f64 = undefined;
    sv_map(m[0..3], 0.0, 0.0, pw, ph);
    // the second choice cell is MEAN
    specs_viz_click(tg[0..256], tb[0..TB_SIZE], 0.0, 0.0, pw, ph, sv_x(m[0..3], PSV_CHOICE_X + PSV_CHOICE_CELL + 20), sv_y(m[0..3], PSV_CTRL_Y + 20));
    var p : PsvState = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.param == 1;
    // the fourth stepper slot is layer 2
    specs_viz_click(tg[0..256], tb[0..TB_SIZE], 0.0, 0.0, pw, ph, sv_x(m[0..3], PSV_STEP_X + 3 * PSV_STEP_CELL + 20), sv_y(m[0..3], PSV_CTRL_Y + 20));
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.step == 2;
    // an edge's gutter box turns it off: the state is DEMO and says one edge is off; again, and it is VERIFIED
    assert p.viz.truth == VIZ_TRUTH_VERIFIED and psv_edges_off(p.mask) == 0;
    specs_viz_click(tg[0..256], tb[0..TB_SIZE], 0.0, 0.0, pw, ph, sv_x(m[0..3], PSV_LIST_X + 10), sv_y(m[0..3], psv_line_y(3) + 5));
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.truth == VIZ_TRUTH_DEMO and psv_edges_off(p.mask) == 1 and (p.mask & psv_bit(3)) == 0;
    assert p.viz.param == 1 and p.viz.step == 2;
    specs_viz_click(tg[0..256], tb[0..TB_SIZE], 0.0, 0.0, pw, ph, sv_x(m[0..3], PSV_LIST_X + 10), sv_y(m[0..3], psv_line_y(3) + 5));
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.truth == VIZ_TRUTH_VERIFIED and psv_edges_off(p.mask) == 0;
    // a trace row sets the step
    specs_viz_click(tg[0..256], tb[0..TB_SIZE], 0.0, 0.0, pw, ph, sv_x(m[0..3], PSV_TRACE_X + 30), sv_y(m[0..3], psv_trace_row_y(4) + 20));
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.step == 4;
}

test the_keys_step_choose_toggle_and_clear_and_a_key_the_petal_leaves_alone_goes_on_to_the_shell {
    var tg : [256]u64 = undefined;
    var tb : [TB_SIZE]u8 = undefined;
    sv_fresh(tg[0..256], tb[0..TB_SIZE]);
    // nothing selected: Escape and Backspace are the shell's, so Escape still leaves the petal
    assert specs_viz_key_takes(tb[0..TB_SIZE], KEY_ESCAPE) == false;
    assert specs_viz_key_takes(tb[0..TB_SIZE], TG_KEY_BACKSPACE) == false;
    assert specs_viz_key_takes(tb[0..TB_SIZE], 18) == false;
    assert specs_viz_key_takes(tb[0..TB_SIZE], 0) == false;
    // the arrows step the layer, the letters choose the aggregation
    assert specs_viz_key_takes(tb[0..TB_SIZE], SV_KEY_RIGHT);
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_RIGHT);
    var p : PsvState = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.step == 1;
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_LEFT);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.step == 0;
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_X);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.param == 2;
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_M);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.param == 1;
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], KEY_S);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.param == 0;
    // down moves the focus, Return selects the focused entity, Space flips the selected edge or the focused one
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_DOWN);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.focus != VIZ_NO_FOCUS;
    assert specs_viz_key_takes(tb[0..TB_SIZE], TG_KEY_RETURN);
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], TG_KEY_RETURN);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.selected != VIZ_REF_NONE;
    // with a selection, Escape is the page's: it clears the selection and the next Escape is the shell's again
    assert specs_viz_key_takes(tb[0..TB_SIZE], KEY_ESCAPE);
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], KEY_ESCAPE);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.selected == VIZ_REF_NONE;
    assert specs_viz_key_takes(tb[0..TB_SIZE], KEY_ESCAPE) == false;
}

test the_space_key_flips_the_focused_edge_and_shows_demo_until_it_is_flipped_back {
    var tg : [256]u64 = undefined;
    var tb : [TB_SIZE]u8 = undefined;
    sv_fresh(tg[0..256], tb[0..TB_SIZE]);
    var p : PsvState = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.truth == VIZ_TRUTH_VERIFIED and p.mask == PSV_ALL_EDGES;
    // walk the focus to an edge: the focus order lists the nodes, then the edges
    var guard : u32 = 0;
    while (guard < 40 and viz_ref_kind(psv_focus_ref(p, p.viz.focus)) != VIZ_ENT_EDGE) {
        specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_DOWN);
        p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
        guard = guard + 1;
    }
    assert viz_ref_kind(psv_focus_ref(p, p.viz.focus)) == VIZ_ENT_EDGE;
    assert specs_viz_key_takes(tb[0..TB_SIZE], SV_KEY_SPACE);
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_SPACE);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.truth == VIZ_TRUTH_DEMO and psv_edges_off(p.mask) == 1;
    specs_viz_key(tg[0..256], tb[0..TB_SIZE], SV_KEY_SPACE);
    p = psv_load_bytes(tb[0..TB_SIZE], TBO_SV);
    assert p.viz.truth == VIZ_TRUTH_VERIFIED and p.mask == PSV_ALL_EDGES;
}

// ---- the GNN work-graph page: the window's wiring of t27f_gnn_work_graph_viz (t27#12370) ----

/// A table nobody has written: every word zero, so the GNN page reads as never opened.
fn gnn_fresh(tg: []u64) -> void {
    var i : usize = 0;
    while (i < 256) {
        tg[i] = 0;
        i = i + 1;
    }
}

/// A press at frame point (fx, fy) of the page (x0, y0, pw, ph).
fn gnn_click_frame(tg: []u64, fx: u32, fy: u32, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    var m : [3]f64 = undefined;
    sv_map(m[0..3], x0, y0, pw, ph);
    gnn_page_click(tg, x0, y0, pw, ph, sv_x(m[0..3], fx), sv_y(m[0..3], fy));
}

/// A press on the centre of node v of the page (x0, y0, pw, ph).
fn gnn_click_node(tg: []u64, v: u32, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    gnn_click_frame(tg, gnn_node_cx(v), gnn_node_cy(v), x0, y0, pw, ph);
}

test the_gnn_page_state_lives_in_five_distinct_free_tg_words_and_nowhere_else {
    var w : [5]u32 = undefined;
    w[0] = TPG_GNN_0;
    w[1] = TPG_GNN_1;
    w[2] = TPG_GNN_2;
    w[3] = TPG_GNN_3;
    w[4] = TPG_GNN_4;
    assert w[0] == 33 and w[1] == 75 and w[2] == 89 and w[3] == 109 and w[4] == 135;
    var i : usize = 0;
    while (i < 5) {
        assert w[i] < 256;
        var j : usize = i + 1;
        while (j < 5) {
            assert w[i] != w[j];
            j = j + 1;
        }
        i = i + 1;
    }
    // storing the open state writes word 0 (the lifecycle is not zero) and nothing outside the five, and bumps nothing
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    gnn_state_put(tg[0..256], gnn_open());
    assert tg[TPG_GNN_0] != 0;
    assert tg[TPG_GEN] == 0;
    var nz : u32 = 0;
    var k : usize = 0;
    while (k < 256) {
        if (tg[k] != 0) { nz = nz + 1; }
        k = k + 1;
    }
    var nf : u32 = 0;
    if (tg[TPG_GNN_0] != 0) { nf = nf + 1; }
    if (tg[TPG_GNN_1] != 0) { nf = nf + 1; }
    if (tg[TPG_GNN_2] != 0) { nf = nf + 1; }
    if (tg[TPG_GNN_3] != 0) { nf = nf + 1; }
    if (tg[TPG_GNN_4] != 0) { nf = nf + 1; }
    assert nz == nf;
}

test an_untouched_table_reads_as_the_open_gnn_state_and_a_stored_state_round_trips {
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    var p : VizState = gnn_state_get(tg[0..256]);
    assert gnn_k(p) == 1;
    assert p.selected == VIZ_REF_NONE and p.hover == VIZ_REF_NONE;
    assert p.truth == VIZ_TRUTH_DEMO;
    assert gnn_subject(p) == GNN_NO_NODE;
    // a pinned node and k = 3, through the window's own click, then into a second table and back
    gnn_click_node(tg[0..256], 9, 0.0, 0.0, 1900.0, 1000.0);
    gnn_click_frame(tg[0..256], GNN_CHOICE_X + 2 * GNN_CHOICE_CELL + 50, GNN_CTRL_Y + 20, 0.0, 0.0, 1900.0, 1000.0);
    p = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(p.selected) == 9 and gnn_k(p) == 3;
    var tg2 : [256]u64 = undefined;
    gnn_fresh(tg2[0..256]);
    gnn_state_put(tg2[0..256], p);
    const q : VizState = gnn_state_get(tg2[0..256]);
    assert q.selected == p.selected and q.hover == p.hover and q.param == p.param;
    assert q.step == p.step and q.focus == p.focus and q.revision == p.revision;
    assert q.lifecycle == p.lifecycle and q.truth == p.truth and q.item_count == p.item_count;
    assert q.focus_count == p.focus_count and q.param_count == p.param_count;
}

test a_click_on_each_node_selects_it_at_every_page_size_and_origin {
    var tg : [256]u64 = undefined;
    var sizes : [3]f64 = undefined;
    sizes[0] = 1900.0;
    sizes[1] = 1100.0;
    sizes[2] = 700.0;
    var si : usize = 0;
    while (si < 3) {
        const pw : f64 = sizes[si];
        const ph : f64 = 0.6 * pw;
        var v : u32 = 0;
        while (v < GNN_NODE_COUNT) {
            gnn_fresh(tg[0..256]);
            gnn_click_node(tg[0..256], v, 200.0, 70.0, pw, ph);
            const p : VizState = gnn_state_get(tg[0..256]);
            assert gnn_ref_node(p.selected) == v;
            assert gnn_subject(p) == v;
            assert tg[TPG_GEN] == 1;
            v = v + 1;
        }
        si = si + 1;
    }
}

test a_hover_is_drawn_but_never_stored_and_the_hovered_node_wins_over_the_pinned_one {
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    var m : [3]f64 = undefined;
    sv_map(m[0..3], 200.0, 70.0, 1900.0, 1000.0);
    const hx : f64 = sv_x(m[0..3], gnn_node_cx(4));
    const hy : f64 = sv_y(m[0..3], gnn_node_cy(4));
    // nothing pinned: the pointer over node 4 shows node 4, the table stays as it was
    const shown : VizState = gnn_shown(tg[0..256], 200.0, 70.0, 1900.0, 1000.0, hx, hy);
    assert gnn_ref_node(shown.hover) == 4;
    assert gnn_subject(shown) == 4;
    assert gnn_node_hl(shown, 4) == VIZ_HL_HOVER;
    const stored0 : VizState = gnn_state_get(tg[0..256]);
    assert stored0.hover == VIZ_REF_NONE;
    assert tg[TPG_GEN] == 0 and tg[TPG_GNN_0] == 0;
    // the pointer off every node (frame 5, 5) leaves no hover and no subject
    const away : VizState = gnn_shown(tg[0..256], 200.0, 70.0, 1900.0, 1000.0, 205.0, 75.0);
    assert away.hover == VIZ_REF_NONE;
    assert gnn_subject(away) == GNN_NO_NODE;
    // node 0 pinned, node 4 hovered: the drawn subject is 4, the stored one stays 0 and stays unhovered
    gnn_click_node(tg[0..256], 0, 200.0, 70.0, 1900.0, 1000.0);
    const both : VizState = gnn_shown(tg[0..256], 200.0, 70.0, 1900.0, 1000.0, hx, hy);
    assert gnn_subject(both) == 4;
    assert gnn_node_hl(both, 4) == VIZ_HL_HOVER and gnn_node_hl(both, 0) == VIZ_HL_SELECT;
    const kept : VizState = gnn_state_get(tg[0..256]);
    assert gnn_subject(kept) == 0 and kept.hover == VIZ_REF_NONE;
    assert tg[TPG_GEN] == 1;
}

test the_k_cells_set_the_depth_and_a_k_press_keeps_the_pinned_node {
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    gnn_click_node(tg[0..256], 3, 200.0, 70.0, 1900.0, 1000.0);
    var q : u32 = 0;
    while (q < GNN_K_MAX) {
        gnn_click_frame(tg[0..256], GNN_CHOICE_X + q * GNN_CHOICE_CELL + 50, GNN_CTRL_Y + 20, 200.0, 70.0, 1900.0, 1000.0);
        const p : VizState = gnn_state_get(tg[0..256]);
        assert gnn_k(p) == q + 1;
        assert gnn_ref_node(p.selected) == 3;
        q = q + 1;
    }
    // the same on a small page
    gnn_click_frame(tg[0..256], GNN_CHOICE_X + 20, GNN_CTRL_Y + 20, 10.0, 10.0, 700.0, 420.0);
    const s : VizState = gnn_state_get(tg[0..256]);
    assert gnn_k(s) == 1 and gnn_ref_node(s.selected) == 3;
}

test the_gnn_keys_step_k_walk_the_focus_pin_and_clear_and_the_rest_go_to_the_shell {
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    // the key map
    assert gnn_page_key_code(SV_KEY_LEFT) == GNN_KEY_LEFT and gnn_page_key_code(SV_KEY_RIGHT) == GNN_KEY_RIGHT;
    assert gnn_page_key_code(SV_KEY_UP) == GNN_KEY_UP and gnn_page_key_code(SV_KEY_DOWN) == GNN_KEY_DOWN;
    assert gnn_page_key_code(TG_KEY_RETURN) == GNN_KEY_ACTIVATE;
    assert gnn_page_key_code(TG_KEY_BACKSPACE) == GNN_KEY_BACK and gnn_page_key_code(KEY_ESCAPE) == GNN_KEY_BACK;
    assert gnn_page_key_code(SV_KEY_SPACE) == GNN_KEY_NONE and gnn_page_key_code(0) == GNN_KEY_NONE;
    // nothing pinned, nothing focused, k = 1: Left, Escape, Backspace, Return, the digits and an unmapped key are the shell's
    assert gnn_page_key_takes(tg[0..256], SV_KEY_LEFT) == false;
    assert gnn_page_key_takes(tg[0..256], KEY_ESCAPE) == false;
    assert gnn_page_key_takes(tg[0..256], TG_KEY_BACKSPACE) == false;
    assert gnn_page_key_takes(tg[0..256], TG_KEY_RETURN) == false;
    assert gnn_page_key_takes(tg[0..256], 18) == false;
    assert gnn_page_key_takes(tg[0..256], 19) == false;
    assert gnn_page_key_takes(tg[0..256], 20) == false;
    assert gnn_page_key_takes(tg[0..256], 0) == false;
    gnn_page_key(tg[0..256], KEY_ESCAPE);
    assert tg[TPG_GEN] == 0 and tg[TPG_GNN_0] == 0;
    // Right steps k to 2 and 3 and stops there; Left steps back
    assert gnn_page_key_takes(tg[0..256], SV_KEY_RIGHT);
    gnn_page_key(tg[0..256], SV_KEY_RIGHT);
    assert gnn_k(gnn_state_get(tg[0..256])) == 2;
    gnn_page_key(tg[0..256], SV_KEY_RIGHT);
    assert gnn_k(gnn_state_get(tg[0..256])) == 3;
    assert gnn_page_key_takes(tg[0..256], SV_KEY_RIGHT) == false;
    gnn_page_key(tg[0..256], SV_KEY_RIGHT);
    assert gnn_k(gnn_state_get(tg[0..256])) == 3 and tg[TPG_GEN] == 2;
    assert gnn_page_key_takes(tg[0..256], SV_KEY_LEFT);
    gnn_page_key(tg[0..256], SV_KEY_LEFT);
    assert gnn_k(gnn_state_get(tg[0..256])) == 2 and tg[TPG_GEN] == 3;
    // Down walks the focus over the nodes in order, Up goes back, Return pins the focused node
    gnn_page_key(tg[0..256], SV_KEY_DOWN);
    var p : VizState = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(gnn_focus_ref(p, p.focus)) == 0;
    gnn_page_key(tg[0..256], SV_KEY_DOWN);
    p = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(gnn_focus_ref(p, p.focus)) == 1;
    gnn_page_key(tg[0..256], SV_KEY_UP);
    p = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(gnn_focus_ref(p, p.focus)) == 0;
    assert gnn_page_key_takes(tg[0..256], TG_KEY_RETURN);
    gnn_page_key(tg[0..256], TG_KEY_RETURN);
    p = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(p.selected) == 0 and gnn_subject(p) == 0;
    assert gnn_k(p) == 2;
    // with a node pinned, Escape and Backspace are the page's; once it is cleared they are the shell's again
    assert gnn_page_key_takes(tg[0..256], KEY_ESCAPE);
    assert gnn_page_key_takes(tg[0..256], TG_KEY_BACKSPACE);
    gnn_page_key(tg[0..256], KEY_ESCAPE);
    p = gnn_state_get(tg[0..256]);
    assert p.selected == VIZ_REF_NONE and gnn_subject(p) == GNN_NO_NODE;
    assert gnn_page_key_takes(tg[0..256], KEY_ESCAPE) == false;
    assert gnn_page_key_takes(tg[0..256], TG_KEY_BACKSPACE) == false;
}

test a_press_outside_the_page_is_no_event_and_a_press_on_empty_frame_clears_only_a_pin {
    var tg : [256]u64 = undefined;
    gnn_fresh(tg[0..256]);
    // left of and above the page: nothing, nothing stored, nothing redrawn
    gnn_page_click(tg[0..256], 200.0, 70.0, 1900.0, 1000.0, 5.0, 5.0);
    assert tg[TPG_GEN] == 0 and tg[TPG_GNN_0] == 0;
    // empty frame (off every node) with nothing pinned: no event either
    gnn_click_frame(tg[0..256], 1000, 900, 200.0, 70.0, 1900.0, 1000.0);
    assert tg[TPG_GEN] == 0 and tg[TPG_GNN_0] == 0;
    // a pinned node survives a press outside the page and is cleared by a press on empty frame
    gnn_click_node(tg[0..256], 0, 200.0, 70.0, 1900.0, 1000.0);
    assert tg[TPG_GEN] == 1;
    gnn_page_click(tg[0..256], 200.0, 70.0, 1900.0, 1000.0, 5.0, 5.0);
    assert tg[TPG_GEN] == 1;
    const pinned : VizState = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(pinned.selected) == 0;
    gnn_click_frame(tg[0..256], 1000, 900, 200.0, 70.0, 1900.0, 1000.0);
    assert tg[TPG_GEN] == 2;
    const cleared : VizState = gnn_state_get(tg[0..256]);
    assert cleared.selected == VIZ_REF_NONE;
    // a second press on a pinned node unpins it (the contract's toggle)
    gnn_click_node(tg[0..256], 5, 200.0, 70.0, 1900.0, 1000.0);
    const again : VizState = gnn_state_get(tg[0..256]);
    assert gnn_ref_node(again.selected) == 5;
    gnn_click_node(tg[0..256], 5, 200.0, 70.0, 1900.0, 1000.0);
    const toggled : VizState = gnn_state_get(tg[0..256]);
    assert toggled.selected == VIZ_REF_NONE;
}

test the_side_panel_lines_are_the_pages_wording_built_from_the_specs_pieces {
    var b : [400]u8 = undefined;
    // node 0 is the AGENT "reviewer pid 4127"; its edges are 0 -> 4 (offer) and 0 -> 12 (diff), in that order
    var n : usize = gnn_head_line(b[0..400], 0, 1);
    assert sv_is(b[0..400], n, "gather for AGENT \"reviewer pid 4127\" at k = 1:");
    const r1 : GnnReach = gnn_reach(0, 1);
    n = gnn_hop_line(b[0..400], r1, 1);
    assert sv_is(b[0..400], n, "  hop 1: offer, diff");
    n = gnn_after_line(b[0..400], 1);
    assert sv_is(b[0..400], n, "after 1 message-passing layer, this node's embedding");
    // node 3 reaches 13 at one hop, 7 at two, and 1 and 11 at three; a fourth hop is empty
    const r3 : GnnReach = gnn_reach(3, 3);
    n = gnn_hop_line(b[0..400], r3, 1);
    assert sv_is(b[0..400], n, "  hop 1: receipt.json");
    n = gnn_hop_line(b[0..400], r3, 2);
    assert sv_is(b[0..400], n, "  hop 2: result");
    n = gnn_hop_line(b[0..400], r3, 3);
    assert sv_is(b[0..400], n, "  hop 3: runner, verify receipt");
    n = gnn_hop_line(b[0..400], r3, 4);
    assert sv_is(b[0..400], n, "  hop 4: (none)");
    // the layer word is plural past one
    n = gnn_after_line(b[0..400], 2);
    assert sv_is(b[0..400], n, "after 2 message-passing layers, this node's embedding");
    n = gnn_after_line(b[0..400], 3);
    assert sv_is(b[0..400], n, "after 3 message-passing layers, this node's embedding");
    // the text helpers: a quote byte, a size floor, a frame length as a float
    n = gnn_put_quote(b[0..400], 7);
    assert n == 8 and b[7] == 34;
    assert gnn_pt(3.0) == 6.5 and gnn_pt(13.0) == 13.0;
    assert gnn_f(7) == 7.0;
}

// Crash guard (#12368): a pid word is a pid only in 1 ..= 0x7FFFFFFF. The app trapped (EXC_BREAKPOINT) when
// @intCast met a word that held a host name or an orbit coordinate, and a bad word must never reach kill or waitpid.
test a_pid_word_is_a_pid_only_between_1_and_0x7fffffff {
    assert pid_ok(0) == false;
    assert pid_ok(1);
    assert pid_ok(99999);
    assert pid_ok(0x7FFFFFFF);
    assert pid_ok(0x80000000) == false;
    assert pid_ok(0xFFFFFFFF) == false;
    assert pid_ok(0xFFFFFFFFFFFFFFFF) == false;
}

test a_bad_pid_word_is_gone_and_is_never_reaped_or_killed {
    // eight host-name bytes read as a pid, as the AGENTS words once did
    assert tg_done(0x4142434445464748) == 2;
    assert tg_done(0) == 2;
    assert tg_done(0x80000000) == 2;
    // the late-job kill and the plain kill return without a syscall for a bad word (they would trap, or kill -1)
    tg_late(100000, 0, 0x4142434445464748);
    tg_late(100000, 0, 0);
    tg_kill(0xFFFFFFFFFFFFFFFF);
    tg_kill(0);
}

// The word map (#12368). tgv is one [256]u64 and every TPG_* constant names a word (or, with a base + offset
// use, a span of words). Two names on one word read each other's data: TPG_U_FAILS..TPG_U_TSEC (180..184) sat
// inside the orbit's TPG_O_HY span (168..199), the orbit overwrote them every frame, V_DIRTY never settled and
// the window redrew forever. Nothing checked it; this test does.
//
// NEXT AUTHOR: a new TPG_ word or span MUST get its line in the_word_map_has_no_overlap below, in the same
// commit, as (name, base, length). Length 1 is a plain word; a base + offset use (TPG_Q_RING + i) needs the
// full length. The test fails on the first overlap and on any word past TPG_N. Free words (2026-10-25):
// 33, 75, 89, 109, 135 (all five are reserved for the GNN page; word 2 is now TPG_BEAT_AT, the heartbeat).
//
// wm_claim marks base .. base + len in seen and says whether all of them were free and inside TPG_N.
fn wm_claim(seen: []u8, base: u32, len: u32) -> bool {
    const n : u32 = TPG_N as u32;
    if (len == 0 or base >= n or len > n - base) { return false; }
    var ok : bool = true;
    var i : u32 = 0;
    while (i < len) {
        const w : usize = @as(usize, base + i);
        if (seen[w] != 0) { ok = false; }
        seen[w] = 1;
        i = i + 1;
    }
    return ok;
}

test the_word_map_has_no_overlap {
    var seen : [256]u8 = undefined;
    var z : usize = 0;
    while (z < 256) {
        seen[z] = 0;
        z = z + 1;
    }
    assert wm_claim(seen[0..256], TPG_DASH, 1);
    assert wm_claim(seen[0..256], TPG_GEN, 1);
    assert wm_claim(seen[0..256], TPG_BN_LAST, 1);
    assert wm_claim(seen[0..256], TPG_BN_PID, 1);
    assert wm_claim(seen[0..256], TPG_BN_STAGE, 1);
