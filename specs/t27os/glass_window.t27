fn rr_attr_flags(at: []u8, flags: i32) -> i32 { return @extern("posix_spawnattr_setflags"); }

/// Start the relaunch of the executable exe[0..en] (hot_reload.t27 rr_method): the helper shell, or `open -n`, in a
/// NEW SESSION (POSIX_SPAWN_SETSID), so nothing the parent shell or terminal does to its session reaches it. True
/// when the child was started.
fn relaunch_start(exe: []const u8, en: usize, bn: usize, method: u32) -> bool {
    var buf : [1400]u8 = undefined;
    var at : [16]u8 = undefined;
    if (rr_attr_init(at[0..16]) != 0) { return false; }
    if (rr_attr_flags(at[0..16], 1024) != 0) { return false; }
    var argv : [8]u64 = undefined;
    var i : usize = 0;
    while (i < 8) { argv[i] = 0; i = i + 1; }
    var cp : [24]u8 = undefined;
    if (method == RR_HELPER) {
        buf[0] = 115;
        buf[1] = 104;
        buf[2] = 0;
        buf[3] = 45;
        buf[4] = 99;
        buf[5] = 0;
        const sn : usize = rr_script(buf[6..1390], @as(u32, @intCast(pf_getpid())), exe, en, bn);
        if (sn == 0 or sn >= 1380) { return false; }
        buf[6 + sn] = 0;
        argv[0] = sys_addr(buf[0..1400], exe[0..1], 0);
        argv[1] = sys_addr(buf[3..1400], exe[0..1], 0);
        argv[2] = sys_addr(buf[6..1400], exe[0..1], 0);
        put_bytes(cp[0..24], 0, "/bin/sh");
        cp[7] = 0;
    } else {
        // open -n <bundle>: the bundle path, NUL-terminated, after "open\0-n\0"
        put_bytes(buf[0..1400], 0, "open");
        buf[4] = 0;
        buf[5] = 45;
        buf[6] = 110;
        buf[7] = 0;
        if (bn + 9 > 1400) { return false; }
        i = 0;
        while (i < bn) { buf[8 + i] = exe[i]; i = i + 1; }
        buf[8 + bn] = 0;
        argv[0] = sys_addr(buf[0..1400], exe[0..1], 0);
        argv[1] = sys_addr(buf[5..1400], exe[0..1], 0);
        argv[2] = sys_addr(buf[8..1400], exe[0..1], 0);
        put_bytes(cp[0..24], 0, "/usr/bin/open");
        cp[13] = 0;
    }
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    // the child gets this process's environment (HOME, CFFIXED_USER_HOME, T27OS_*): an envp of 0 is an empty one
    var ep : [8]u8 = undefined;
    sys_peek(ep[0..8], sys_environ(), 8);
    var envp : u64 = 0;
    i = 8;
    while (i > 0) {
        i = i - 1;
        envp = (envp << 8) | @as(u64, ep[i]);
    }
    const rc : i32 = sys_spawn(pid, cp[0..24], 0, sys_addr(at[0..16], exe[0..1], 0), argv, envp);
    return rc == 0 and pid[0] != 0;
}
