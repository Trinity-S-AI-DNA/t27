// ---- small helpers ----

/// The product name the header and the window title show: "TRINITY S", U+00B3 SUPERSCRIPT THREE, "AI", as UTF-8.
/// Source stays ASCII (L3) and a t27b string literal keeps `\xC2` as four characters, so the superscript three
/// goes in as its two UTF-8 bytes; returns the length written.
pub const BRAND_HEAD : str = "TRINITY S";
pub const BRAND_TAIL : str = "AI";
pub const BRAND_LEN : usize = 13;

pub fn brand(out: []u8) -> usize {
    var n : usize = 0;
    var i : usize = 0;
    while (i < BRAND_HEAD.len) {
        out[n] = BRAND_HEAD[i];
        n = n + 1;
        i = i + 1;
    }
    out[n] = 0xC2;
    out[n + 1] = 0xB3;
    n = n + 2;
    i = 0;
    while (i < BRAND_TAIL.len) {
        out[n] = BRAND_TAIL[i];
        n = n + 1;
        i = i + 1;
    }
    return n;
}

fn cf(s: []const u8) -> u64 {
    return cf_bytes(0, s, s.len, UTF8, false);
}

fn cls(s: []const u8) -> u64 {
    return class_named(cf(s));
}

fn sel(s: []const u8) -> u64 {
    return sel_named(cf(s));
}

/// Channel k of a 0xAARRGGBB value in 0..1: 0 red, 1 green, 2 blue, 3 alpha.
pub fn chan(c: u32, k: u32) -> f64 {
    var v : u32 = c % 256;
    if (k == 3) { v = c / 16777216; }
    if (k == 0) { v = (c / 65536) % 256; }
    if (k == 1) { v = (c / 256) % 256; }
    return @as(f64, @floatFromInt(v)) / 255.0;
}

/// S. One step of the screen's opacity towards shown (1) or gone (0).
pub fn wave(a: f64, open: bool) -> f64 {
    if (open) { return clamp01(a + WAVE_STEP); }
    return clamp01(a - WAVE_STEP);
}

/// S. The cross-fade after k logical ticks (k = 1 is the 30 fps step; a 60 fps redraw passes 0.5).
pub fn wave_k(a: f64, open: bool, k: f64) -> f64 {
    if (open) { return clamp01(a + WAVE_STEP * k); }
    return clamp01(a - WAVE_STEP * k);
}

pub fn cen_x(p: u32) -> f64 {
    const i : u32 = p * 4;
    return @as(f64, @floatFromInt(QX[i] + QX[i + 1] + QX[i + 2] + QX[i + 3])) / 4.0;
}

pub fn cen_y(p: u32) -> f64 {
    const i : u32 = p * 4;
    return @as(f64, @floatFromInt(QY[i] + QY[i + 1] + QY[i + 2] + QY[i + 3])) / 4.0;
}

/// A. Unit direction a block flies in from: box centre -> its centroid ((1, 0) for a block on the centre).
pub fn dir(p: u32, axis: u32) -> f64 {
    const dx : f64 = cen_x(p) - @as(f64, @floatFromInt(BOX_CX));
    const dy : f64 = cen_y(p) - @as(f64, @floatFromInt(BOX_CY));
    const len : f64 = @sqrt(dx * dx + dy * dy);
    if (len <= 100.0) {
        if (axis == 0) { return 1.0; }
        return 0.0;
    }
    if (axis == 0) { return dx / len; }
    return dy / len;
}

/// A. How far (SVG units) every block still is from home after `frame` updates at 30 fps.
pub fn anim_off(frame: u32) -> f64 {
    var off : f64 = START_OFF;
    var v : f64 = 0.0;
    var f : u32 = 0;
    while (f < frame and f < ANIM_FRAMES) {
        if (f < PHASE1_FRAMES) {
            off = off - off * PHASE1_RATE * DT;
            v = 0.0 - off * V_HANDOFF;
        } else {
            v = v + (0.0 - off) * SPRING_K * DT;
            v = v * SPRING_DAMP;
            off = off + v * DT * 60.0;
        }
        f = f + 1;
    }
    if (frame >= ANIM_FRAMES) { return 0.0; }
    return off;
}

/// L. Extent of the logo on one axis (0 x, 1 y) in box milli-units: lowest or highest vertex.
pub fn logo_edge(axis: u32, high: bool) -> f64 {
    var best : i64 = QX[0];
    if (axis == 1) { best = QY[0]; }
    var i : u32 = 1;
    while (i < PETAL_COUNT * 4) {
        var v : i64 = QX[i];
        if (axis == 1) { v = QY[i]; }
        if (high and v > best) { best = v; }
        if (high == false and v < best) { best = v; }
        i = i + 1;
    }
    return @as(f64, @floatFromInt(best));
}

/// L. Size factor that makes the logo `px` points tall (1.0 = the size petal_menu's fit gives).
pub fn logo_k_for(px: f64) -> f64 {
    return px / ((logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale());
}

/// H. The home logo: 0.63 of the area under the title bar, centred in it (TriangleLogo's scale). The
/// scene is sw x sh points; in the narrow panel the width binds, so the logo keeps 0.63 of that too.
pub fn home_px(z: f64, sw: f64, sh: f64) -> f64 {
    var room : f64 = sh - AREA_TOP;
    const by_w : f64 = sw * (logo_edge(1, true) - logo_edge(1, false)) / (logo_edge(0, true) - logo_edge(0, false));
    if (by_w < room) { room = by_w; }
    return LOGO_SHARE * room * z * @as(f64, @floatFromInt(HOME_SCALE_PERMILLE)) / 1000.0;
}

pub fn home_k(z: f64, sw: f64, sh: f64) -> f64 {
    return logo_k_for(home_px(z, sw, sh));
}

/// H. Centre (for to_pt) that puts the logo's own middle at the middle of the area, on one axis.
pub fn logo_at(axis: u32, k: f64, mid_pt: f64) -> f64 {
    var c : f64 = @as(f64, @floatFromInt(BOX_CX));
    if (axis == 1) { c = @as(f64, @floatFromInt(BOX_CY)); }
    const mid : f64 = 0.5 * (logo_edge(axis, false) + logo_edge(axis, true));
    return mid_pt - (mid - c) / 1000.0 * scale() * k;
}

pub fn home_c(axis: u32, z: f64, sw: f64, sh: f64) -> f64 {
    if (axis == 0) { return logo_at(0, home_k(z, sw, sh), 0.5 * sw); }
    return logo_at(1, home_k(z, sw, sh), 0.5 * (AREA_TOP + sh));
}

/// A box coordinate in milli-units to a window point on one axis (0 x, 1 y; y grows down), for a logo
/// centred at `cen` and sized k.
pub fn to_pt(m: f64, axis: u32, cen: f64, k: f64) -> f64 {
    const s : f64 = scale() * k;
    if (axis == 0) { return cen + (m - @as(f64, @floatFromInt(BOX_CX))) / 1000.0 * s; }
    return cen + (m - @as(f64, @floatFromInt(BOX_CY))) / 1000.0 * s;
}

/// The mouse in the frame petal_menu's hit_px expects (logo centred in 960 x 540, size 1).
pub fn virt(v: f64, axis: u32, z: f64, sw: f64, sh: f64) -> f64 {
    var home : f64 = 0.5 * W_PT;
    if (axis == 1) { home = 0.5 * H_PT; }
    return home + (v - home_c(axis, z, sw, sh)) / home_k(z, sw, sh);
}

/// H. Where the tooltip pill centres for petal p: 30 pt above the petal's centre.
pub fn tip_x(p: u32, z: f64, sw: f64, sh: f64) -> f64 {
    return to_pt(cen_x(p), 0, home_c(0, z, sw, sh), home_k(z, sw, sh));
}

pub fn tip_y(p: u32, z: f64, sw: f64, sh: f64) -> f64 {
    return to_pt(cen_y(p), 1, home_c(1, z, sw, sh), home_k(z, sw, sh)) - TIP_RISE;
}

fn in_box(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x <= l + w and y >= t and y <= t + h;
}

/// T. Title-bar controls: logo + TRINITY (home), fullscreen.
/// T. Left edge of the title-bar logo: right of the traffic lights in a window, on the back chevron's
/// line in full screen (no traffic lights there).
pub fn home_x(full: bool) -> f64 {
    if (full) { return FULL_HOME_X; }
    return HOME_X;
}

/// T. Width of the title-bar logo drawn ROW_ICON_H tall, from the mark's own extent.
pub fn title_logo_w() -> f64 {
    return (logo_edge(0, true) - logo_edge(0, false)) / 1000.0 * scale() * logo_k_for(ROW_ICON_H * TITLE_LOGO_SCALE);
}

/// T. Left edge of a group w wide centred in a bar sw wide: the logo + TRINITY sit in the middle.
pub fn brand_left(sw: f64, w: f64) -> f64 {
    return 0.5 * (sw - w);
}

pub fn on_home_button(x: f64, y: f64, sw: f64) -> bool {
    return in_box(x, y, brand_left(sw, HOME_BTN_W), 0.0, HOME_BTN_W, TITLE_H);
}

pub fn full_x(sw: f64) -> f64 {
    return sw - FULL_INSET;
}

pub fn on_full_button(x: f64, y: f64, sw: f64) -> bool {
    return in_box(x, y, full_x(sw), 0.5 * (TITLE_H - FULL_PT), FULL_PT, FULL_PT);
}

/// K. The dock-panel control (sidebar.right): docks the window as the 400 pt trios panel, or undocks it.
pub fn dock_x(sw: f64) -> f64 {
    return full_x(sw) - DOCK_STEP;
}

pub fn on_dock_button(x: f64, y: f64, sw: f64) -> bool {
    return in_box(x, y, dock_x(sw), 0.5 * (TITLE_H - FULL_PT), FULL_PT, FULL_PT);
}

/// K. ChatWorkspaceLayout.metrics: expanded from 760 pt; below it compact, or the dashboard the user
/// forced open from the compact bar (isDashboardExpanded).
pub fn workspace(sw: f64, dash: bool) -> u32 {
    if (sw >= COMPACT_BELOW) { return WS_EXPANDED; }
    if (dash) { return WS_DASHBOARD; }
    return WS_COMPACT;
}

/// K. sidebarWidth: 272 only when expanded and not collapsed, else 0 (trios keeps a zero-width
/// sidebar and its divider in the forced dashboard).
pub fn side_w(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_EXPANDED and collapsed == false) { return SIDE_W; }
    return 0.0;
}

/// K. The "OPEN DASHBOARD" bar across the top of the compact workspace.
pub fn on_open_dash(x: f64, y: f64, sw: f64, ws: u32) -> bool {
    return ws == WS_COMPACT and in_box(x, y, 0.0, WS_TOP, sw, BAR_H);
}

/// S. The back chevron + logo + TRINITY in the one title bar.
pub fn on_nav_back(x: f64, y: f64, full: bool) -> bool {
    return in_box(x, y, home_x(full), 0.0, BACK_W, TITLE_H);
}

/// C. Left edge of the chat content: right of the sidebar and its divider, or 0 when collapsed.
pub fn content_x(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_COMPACT or collapsed) { return 0.0; }
    return side_w(ws, collapsed) + 1.0;
}

/// P. The right edge of the content area: the window's edge, or the left edge of the right-hand panel (Queen,
/// DOCTOR or KEYS) while one is open, so the terminal's grid ends where the panel starts and nothing of it
/// sits under the panel (owner, 2026-10-20: the terminal's text showed through the KEYS rows).
pub fn content_right(sw: f64, panel: bool) -> f64 {
    if (panel) { return qp_left(sw); }
    return sw;
}

/// P. The width the terminal's grid is laid out in: from the content's left edge to content_right, never negative.
pub fn content_w(sw: f64, ws: u32, collapsed: bool, panel: bool) -> f64 {
    const w : f64 = content_right(sw, panel) - content_x(ws, collapsed);
    if (w < 0.0) { return 0.0; }
    return w;
}

/// W. True when x is over the sidebar's rows (expanded workspace, sidebar shown).
pub fn in_side(x: f64, ws: u32, collapsed: bool) -> bool {
    return ws == WS_EXPANDED and collapsed == false and x >= 12.0 and x <= SIDE_W - 12.0;
}

pub fn on_side_toggle(x: f64, y: f64, ws: u32, collapsed: bool) -> bool {
    if (ws == WS_COMPACT) { return false; }
    return in_box(x, y, content_x(ws, collapsed) + 14.0, WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// K. "Close Dashboard" (rectangle.compress.vertical), right of the toggle, only in the forced dashboard.
pub fn close_x(ws: u32, collapsed: bool) -> f64 {
    return content_x(ws, collapsed) + 14.0 + TOGGLE_PT + 12.0;
}

pub fn on_close_dash(x: f64, y: f64, ws: u32, collapsed: bool) -> bool {
    return ws == WS_DASHBOARD and in_box(x, y, close_x(ws, collapsed), WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// N. "+" (new chat), at the right end of the header, the same 28 pt box as the toggle.
pub fn new_chat_x(sw: f64) -> f64 {
    return sw - 14.0 - TOGGLE_PT;
}

pub fn on_new_chat(x: f64, y: f64, sw: f64, ws: u32) -> bool {
    if (ws == WS_COMPACT) { return false; }
    return in_box(x, y, new_chat_x(sw), WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// N. The close x of an AGENTS row whose top is `top`: a 16 pt box centred where the dot sits.
pub fn on_row_close(x: f64, y: f64, top: f64) -> bool {
    return in_box(x, y, SIDE_W - 34.0, top + 11.0, 16.0, 16.0);
}

/// W. "+" in the SPACES label line: a 16 pt box at the right end, centred 3.5 pt above the baseline.
pub fn on_space_plus(x: f64, y: f64) -> bool {
    return in_box(x, y, SIDE_W - 34.0, label_base(WS_TOP, GROUP_SPACES, 0) - 11.5, 16.0, 16.0);
}

/// W. The close x of a SPACES row whose top is `top`, at the right end where the AGENTS x sits.
pub fn on_space_close(x: f64, y: f64, top: f64) -> bool {
    return in_box(x, y, SIDE_W - 34.0, top + 6.0, 16.0, 16.0);
}

/// W. OPEN SOURCE T27 at the foot of the sidebar, the strip FOOT_H above the bottom edge, left of DOCTOR.
pub fn on_repo_link(x: f64, y: f64, sh: f64, ws: u32, collapsed: bool) -> bool {
    return in_side(x, ws, collapsed) and y >= sh - FOOT_H and y <= sh - 6.0 and on_doc_link(x, y, SIDE_W, sh, FOOT_H) == false;
}

/// C. The readable column the cards live in: at most 900 pt, centred, at least 24 pt from each side.
pub fn body_w(sw: f64, ws: u32, collapsed: bool) -> f64 {
    const room : f64 = sw - content_x(ws, collapsed) - 2.0 * BODY_PAD;
    if (room > READABLE_W) { return READABLE_W; }
    return room;
}

pub fn body_left(sw: f64, ws: u32, collapsed: bool) -> f64 {
    return content_x(ws, collapsed) + 0.5 * (sw - content_x(ws, collapsed) - body_w(sw, ws, collapsed));
}

/// C/K. Under the 44 pt header and its divider, or under the 26 pt dashboard bar when compact.
pub fn body_top(ws: u32) -> f64 {
    if (ws == WS_COMPACT) { return WS_TOP + BAR_H + BODY_PAD; }
    return WS_TOP + HEADER_H + 1.0 + BODY_PAD;
}

/// K. In the narrow panel the 3 x 3 slots keep the shape they have in the wide window (top-aligned),
/// instead of stretching down the whole 400 pt column.
pub fn body_h(sw: f64, sh: f64, ws: u32, collapsed: bool) -> f64 {
    const room : f64 = sh - body_top(ws) - BODY_PAD;
    if (ws == WS_EXPANDED) { return room; }
    const keep : f64 = body_w(sw, ws, collapsed) * wide_shape();
    if (keep < room) { return keep; }
    return room;
}

/// K. Height over width of the card column in the wide window with the sidebar collapsed.
pub fn wide_shape() -> f64 {
    return (H_PT - body_top(WS_EXPANDED) - BODY_PAD) / READABLE_W;
}

/// C. Honeycomb: the nine cards are pointy-top hexagons, three rows of three, the middle row shifted
/// half a cell right. The cell radius (centre to corner) that fits a w x h body with HEX_GAP between cells.
pub fn hex_r(w: f64, h: f64) -> f64 {
    const byw : f64 = (w - 2.5 * HEX_GAP) / (3.5 * SQRT3);
    const byh : f64 = (h - 2.0 * HEX_GAP) / 5.0;
    if (byw < byh) { return byw; }
    return byh;
}

/// C. Centre of honeycomb cell k on one axis (0 x, 1 y) in a body at (l, t) of w x h, the comb centred.
pub fn hex_c(k: u32, axis: u32, l: f64, t: f64, w: f64, h: f64) -> f64 {
    const r : f64 = hex_r(w, h);
    const cw : f64 = SQRT3 * r;
    const col : f64 = @as(f64, @floatFromInt(k % 3));
    const row : f64 = @as(f64, @floatFromInt(k / 3));
    if (axis == 0) {
        var x : f64 = l + 0.5 * (w - (3.5 * cw + 2.5 * HEX_GAP)) + 0.5 * cw + col * (cw + HEX_GAP);
        if (k / 3 == 1) { x = x + 0.5 * (cw + HEX_GAP); }
        return x;
    }
    return t + 0.5 * (h - (5.0 * r + 2.0 * HEX_GAP)) + r + row * (1.5 * r + HEX_GAP);
}

/// C. Is (x, y) inside the pointy-top hexagon of radius r centred at (cx, cy)?
pub fn in_hex(x: f64, y: f64, cx: f64, cy: f64, r: f64) -> bool {
    const dx : f64 = @abs(x - cx);
    const dy : f64 = @abs(y - cy);
    return dx <= 0.5 * SQRT3 * r and dy <= r - dx / SQRT3;
}

/// C. The pointy-top hexagon path of radius r centred at (cx, cy).
fn hex_path(c: u64, cx: f64, cy: f64, r: f64) -> void {
    const hw : f64 = 0.5 * SQRT3 * r;
    cg_move(c, cx, cy - r);
    cg_line(c, cx + hw, cy - 0.5 * r);
    cg_line(c, cx + hw, cy + 0.5 * r);
    cg_line(c, cx, cy + r);
    cg_line(c, cx - hw, cy + 0.5 * r);
    cg_line(c, cx - hw, cy - 0.5 * r);
    cg_close(c);
}

/// C. The card slot under (x, y), CARD_SLOTS when none.
pub fn card_at(x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool) -> u32 {
    const l : f64 = body_left(sw, ws, collapsed);
    const t : f64 = body_top(ws);
    const w : f64 = body_w(sw, ws, collapsed);
    const h : f64 = body_h(sw, sh, ws, collapsed);
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        if (in_hex(x, y, hex_c(k, 0, l, t, w, h), hex_c(k, 1, l, t, w, h), hex_r(w, h))) { return k; }
        k = k + 1;
    }
    return CARD_SLOTS;
}

/// T. A terminal pane covers the content area: a chat whose agent opens one, or the editor view, on the chat
/// screen (`topen` is the pane the window shows, PANE_NONE when none).
pub fn term_up(screen: bool, topen: u32) -> bool {
    return screen and topen != PANE_NONE;
}

/// T. The terminal's rectangle, as draw_term lays it out: from the content's left edge to content_right,
/// from under the header to the bottom edge (half open: the header's hairline and the window's edge are out).
pub fn on_term(x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> bool {
    const l : f64 = content_x(ws, collapsed);
    const t : f64 = WS_TOP + HEADER_H;
    return x >= l and x < l + content_w(sw, ws, collapsed, panel) and y >= t and y < sh;
}

/// T. A click that belongs to the terminal: it lands on the rectangle of a pane that is up. The pane takes
/// it (the cursor goes solid) and nothing under it reacts -- the honeycomb cell there used to open an agent
/// chooser when the input row was clicked (owner, 2026-10-20).
pub fn term_click(up: bool, x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> bool {
    return up and on_term(x, y, sw, sh, ws, collapsed, panel);
}

/// C. The card slot a click or the cursor sees: none while a terminal pane is up (the cards are not drawn then,
/// the pane covers them), else the slot under (x, y).
pub fn card_live(up: bool, x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool) -> u32 {
    if (up) { return CARD_SLOTS; }
    return card_at(x, y, sw, sh, ws, collapsed);
}

/// C. Cards arrive one after another: slot k shows CASCADE of the fade later than slot k - 1.
pub fn card_alpha(ma: f64, k: u32) -> f64 {
    return clamp01((ma - CASCADE * @as(f64, @floatFromInt(k))) / (1.0 - CASCADE * 8.0));
}

/// S. Modifier bit test on NSEvent.modifierFlags.
pub fn has_mod(flags: u64, bit: u64) -> bool {
    return (flags / bit) % 2 == 1;
}

/// S. The digit a virtual key code types (0..9), NO_DIGIT for any other key.
pub fn digit_of(key: u64) -> u32 {
    if (key == 29) { return 0; }
    if (key == 18) { return 1; }
    if (key == 19) { return 2; }
    if (key == 20) { return 3; }
    if (key == 21) { return 4; }
    if (key == 23) { return 5; }
    if (key == 22) { return 6; }
    if (key == 26) { return 7; }
    if (key == 28) { return 8; }
    if (key == 25) { return 9; }
    return NO_DIGIT;
}

/// S. QueenMenuShortcutPolicy: exactly Cmd + 1..9 opens petals 0..8, Option 9..17, Control 18..26.
pub fn petal_for_key(digit: u32, flags: u64) -> u32 {
    if (digit < 1 or digit > 9) { return PETAL_NONE; }
    const cmd : bool = has_mod(flags, MOD_COMMAND);
    const opt : bool = has_mod(flags, MOD_OPTION);
    const ctl : bool = has_mod(flags, MOD_CONTROL);
    if (has_mod(flags, MOD_SHIFT)) { return PETAL_NONE; }
    if (cmd and opt == false and ctl == false) { return digit - 1; }
    if (opt and cmd == false and ctl == false) { return 9 + digit - 1; }
    if (ctl and cmd == false and opt == false) { return 18 + digit - 1; }
    return PETAL_NONE;
}

/// The hover value of the central button (a petal index is below 27, PETAL_NONE is 255).
pub const PETAL_CENTRE : u32 = 254;

/// Cmd+Enter alone, at home, opens the agents dialog (the chat workspace).
pub fn agents_key(key: u64, flags: u64) -> bool {
    return key == 36 and has_mod(flags, MOD_COMMAND) and has_mod(flags, MOD_SHIFT) == false and has_mod(flags, MOD_OPTION) == false and has_mod(flags, MOD_CONTROL) == false;
}

/// A tap at home: a petal opens its menu, the central button opens the agents dialog (petal C's screen), else home.
pub fn home_tap(p: u32, centre: bool) -> u32 {
    if (menu_open(p)) { return p; }
    if (centre) { return PETAL_CHAT; }
    return STATE_HOME;
}

/// Which screen of petal C that opens: every petal opens its DASHBOARD (cons2 true, also C's); only the central
/// button and Cmd+Enter open the agents dialog (cons2 false).
pub fn tap_cons(p: u32, centre: bool) -> bool {
    if (centre and menu_open(p) == false) { return false; }
    return true;
}

/// D. Dock icon centre on one axis for to_pt, so the logo's own middle (not the box centre) sits mid-icon.
pub fn icon_cen(axis: u32) -> f64 {
    return logo_at(axis, logo_k_for(ICON_LOGO_PX), 0.5 * ICON_SIZE);
}

/// K. The scene for a view of w x h points: the view itself, point for point, so text keeps its real
/// size and stays sharp in full screen (no upscaled 960 x 540 stage, no letterbox bands); capped by the
/// bitmap it draws into. axis 0 width, 1 height.
pub fn scene(w: f64, h: f64, axis: u32) -> f64 {
    if (w >= COMPACT_BELOW) {
        if (axis == 0) {
            if (w > SW_MAX) { return SW_MAX; }
            return w;
        }
        if (h > SH_MAX) { return SH_MAX; }
        return h;
    }
    if (axis == 0) { return w; }
    if (h > CH_MAX) { return CH_MAX; }
    return h;
}

/// Fit of the sw x sh scene into a view of w x h points (aspect kept, centred): the scale.
pub fn fit(w: f64, h: f64, sw: f64, sh: f64) -> f64 {
    const sx : f64 = w / sw;
    const sy : f64 = h / sh;
    if (sx < sy) { return sx; }
    return sy;
}

/// A view point (y up, as AppKit reports it) to a scene point (y down) on one axis.
pub fn view_to_scene(v: f64, w: f64, h: f64, axis: u32, sw: f64, sh: f64) -> f64 {
    const s : f64 = fit(w, h, sw, sh);
    if (axis == 0) { return (v - 0.5 * (w - sw * s)) / s; }
    return sh - (v - 0.5 * (h - sh * s)) / s;
}

// ---- text (CoreText lines, coloured by the context's fill colour) ----

fn mk_line(kit: [48]u64, s: u64, size: f64, weight: f64, mono: bool) -> u64 {
    var font : u64 = 0;
    if (mono) {
        font = msg_ff(kit[K_FONT], kit[K_MONO_SEL], size, weight);
    } else {
        font = msg_ff(kit[K_FONT], kit[K_SYS_SEL], size, weight);
    }
    var keys : [2]u64 = undefined;
    var vals : [2]u64 = undefined;
    keys[0] = kit[K_KEY_FONT];
    vals[0] = font;
    keys[1] = kit[K_KEY_CTX];
    vals[1] = kit[K_YES];
    const attrs : u64 = msg_dict(kit[K_DICT], kit[K_DICT_SEL], vals, keys, 2);
    const astr : u64 = msg2(msg0(kit[K_ATTR], kit[K_ALLOC]), kit[K_INIT], s, attrs);
    const line : u64 = ct_line(astr);
    msg0(astr, kit[K_RELEASE]);
    return line;
}

/// M11. The laid-out line for s in this style, cut with an ellipsis to `room` when it overflows
/// (TC_FREE: never cut). Borrowed from the cache (text_cache.t27): the caller must not release it.
fn cached_line(kit: [48]u64, s: u64, size: f64, weight: f64, mono: bool, room: f64) -> u64 {
    const key : u64 = msg1(kit[K_NUM_CLS], kit[K_NUM], tc_style(size, weight, mono, room));
    var table : u64 = msg1(kit[K_CACHE], kit[K_GET], key);
    if (table == 0) {
        table = msg0(kit[K_MDICT], kit[K_NEW]);
        msg2(kit[K_CACHE], kit[K_PUT], table, key);
        msg0(table, kit[K_RELEASE]);
    }
    const hit : u64 = msg1(table, kit[K_GET], s);
    if (hit != 0) { return hit; }
    if (tc_flush(msg0(table, kit[K_COUNT]))) { msg0(table, kit[K_FLUSH]); }
    var line : u64 = mk_line(kit, s, size, weight, mono);
    if (tc_cut(ct_width(line, 0, 0, 0), room)) {
        const tok : u64 = mk_line(kit, kit[K_ELL], size, weight, mono);
        const cut : u64 = ct_truncate(line, room, 1, tok);
        cf_release(tok);
        if (cut != 0) {
            cf_release(line);
            line = cut;
        }
    }
    // the table copies the text as its key and retains the line; ours goes
    msg2(table, kit[K_PUT], line, s);
    cf_release(line);
    return line;
}

fn text_w(kit: [48]u64, s: u64, size: f64, weight: f64, mono: bool) -> f64 {
    return ct_width(cached_line(kit, s, size, weight, mono, TC_FREE), 0, 0, 0);
}

fn draw_line(c: u64, line: u64, x: f64, base: f64) -> f64 {
    cg_save(c);
    cg_translate(c, x, base);
    cg_scale(c, 1.0, -1.0);
    cg_text_pos(c, 0.0, 0.0);
    ct_draw(line, c);
    cg_restore(c);
    return ct_width(line, 0, 0, 0);
}

/// Draws s with its baseline at (x, base) in the current fill colour; returns its width.
fn draw_text(c: u64, kit: [48]u64, s: u64, x: f64, base: f64, size: f64, weight: f64, mono: bool) -> f64 {
    return draw_line(c, cached_line(kit, s, size, weight, mono, TC_FREE), x, base);
}

/// M11. draw_text, cut with an ellipsis where it would pass `right`; draws nothing when under
/// TC_MIN_ROOM is left. Returns the width drawn.
fn draw_text_fit(c: u64, kit: [48]u64, s: u64, x: f64, base: f64, size: f64, weight: f64, mono: bool, right: f64) -> f64 {
    const room : f64 = tc_room(x, right);
    if (room <= 0.0) { return 0.0; }
    return draw_line(c, cached_line(kit, s, size, weight, mono, room), x, base);
}

fn world(kit: [48]u64, p: u32) -> u64 {
    return msg1(kit[K_NAMES], kit[K_AT], @as(u64, p));
}

// ---- drawing ----

fn round_rect(c: u64, x: f64, y: f64, w: f64, h: f64, r: f64) -> void {
    const p : u64 = cg_round_rect(x, y, w, h, r, r, 0);
    cg_add_path(c, p);
    cg_path_release(p);
}

fn set_fill(c: u64, argb: u32, k: f64) -> void {
    cg_fill_rgba(c, chan(argb, 0), chan(argb, 1), chan(argb, 2), chan(argb, 3) * k);
}

fn petal_path(c: u64, p: u32, cx: f64, cy: f64, k: f64, ox: f64, oy: f64) -> void {
    var v : u32 = 0;
    while (v < 4) {
        const x : f64 = to_pt(@as(f64, @floatFromInt(QX[p * 4 + v])) + ox, 0, cx, k);
        const y : f64 = to_pt(@as(f64, @floatFromInt(QY[p * 4 + v])) + oy, 1, cy, k);
        if (v == 0) { cg_move(c, x, y); } else { cg_line(c, x, y); }
        v = v + 1;
    }
    cg_close(c);
}

/// D. The Dock icon: the logo white on a black rounded square, drawn into a 512 px bitmap (y down).
fn draw_app_icon(c: u64) -> void {
    const m : f64 = 0.5 * (ICON_SIZE - ICON_TILE);
    round_rect(c, m, m, ICON_TILE, ICON_TILE, ICON_TILE * 0.225);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    cg_fill_path(c);
    const k : f64 = logo_k_for(ICON_LOGO_PX);
    cg_line_width(c, 3.0);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        petal_path(c, p, icon_cen(0), icon_cen(1), k, 0.0, 0.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0);
        cg_fill_path(c);
        petal_path(c, p, icon_cen(0), icon_cen(1), k, 0.0, 0.0);
        cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0);
        cg_stroke_path(c);
        p = p + 1;
    }
}

/// H. The large mark (home), trios look (owner, 2026-10-20; TriangleLogo.swift makePetalCanvas): idle petals black at 0.22,
/// hover a white fill, the open petal its realm colour, every outline white at full alpha, 1 px. No glow. The fills and
/// outlines come from petal_menu.t27 (fill, outline_for). The mark is centred at (cx, cy), sized k, at alpha a;
/// `off` is the fly-in distance (milli-units).
fn draw_logo(c: u64, cx: f64, cy: f64, k: f64, off: f64, state: u32, hov: u32, a: f64) -> void {
    const ow : f64 = @as(f64, @floatFromInt(OUTLINE_WIDTH_MILLI)) / 1000.0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const ox : f64 = dir(p, 0) * off;
        const oy : f64 = dir(p, 1) * off;
        petal_path(c, p, cx, cy, k, ox, oy);
        set_fill(c, fill(p, state, hov), a);
        cg_fill_path(c);
        petal_path(c, p, cx, cy, k, ox, oy);
        cg_line_width(c, ow);
        const oc : u32 = outline_for(p, state, hov);
        cg_stroke_rgba(c, chan(oc, 0), chan(oc, 1), chan(oc, 2), chan(oc, 3) * a);
        cg_stroke_path(c);
        p = p + 1;
    }
    draw_centre_button(c, cx, cy, k, hov == PETAL_CENTRE, a);
}

/// The central button (owner, 2026-10-20): the hollow inner triangle of the logo is the chat button. It draws nothing
/// at rest (no glyph); on hover the triangle fills white at CENTRE_HOVER_ALPHA, the petal hover rule at 0.18.
fn draw_centre_button(c: u64, cx: f64, cy: f64, k: f64, hot: bool, a: f64) -> void {
    if (hot == false) { return; }
    cg_move(c, to_pt(HOLE_L, 0, cx, k), to_pt(HOLE_TOP, 1, cy, k));
    cg_line(c, to_pt(HOLE_R, 0, cx, k), to_pt(HOLE_TOP, 1, cy, k));
    cg_line(c, to_pt(HOLE_AX, 0, cx, k), to_pt(HOLE_AY, 1, cy, k));
    cg_close(c);
    set_fill(c, centre_fill(), a);
    cg_fill_path(c);
}

/// The tooltip of the central button: "AGENTS  Cmd+Enter", 30 pt above the glyph.
fn draw_centre_tip(c: u64, kit: [48]u64, a: f64, z: f64, sw: f64, sh: f64) -> void {
    const k : f64 = home_k(z, sw, sh);
    const x0 : f64 = to_pt((HOLE_L + HOLE_R + HOLE_AX) / 3.0, 0, home_c(0, z, sw, sh), k);
    const y0 : f64 = to_pt((2.0 * HOLE_TOP + HOLE_AY) / 3.0, 1, home_c(1, z, sw, sh), k) - TIP_RISE;
    const w : f64 = bytes_w(kit, "AGENTS  Cmd+Enter", 17, 13.0, WEIGHT_SEMIBOLD, true) + 24.0;
    round_rect(c, x0 - 0.5 * w, y0 - 0.5 * TIP_H, w, TIP_H, 6.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TIP_WHITE * a);
    cg_fill_path(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
    draw_bytes(c, kit, "AGENTS  Cmd+Enter", 17, x0 - 0.5 * w + 12.0, y0 + 4.6, 13.0, WEIGHT_SEMIBOLD, true);
}

/// T. The small mark (title bar): white petals with a fine black cut, LOGO_SEAL thin (the large cut
/// would swallow a 14 pt mark), and the centre hole cut back in, hairline-thin at this size.
fn draw_template_logo(c: u64, cx: f64, cy: f64, k: f64) -> void {
    cg_line_width(c, LOGO_SEAL);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        petal_path(c, p, cx, cy, k, 0.0, 0.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0);
        cg_fill_path(c);
        petal_path(c, p, cx, cy, k, 0.0, 0.0);
        cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0);
        cg_stroke_path(c);
        p = p + 1;
    }
    // the centre hole, cut back in black and grown about its centroid so it survives at 14 pt
    const gx : f64 = (HOLE_L + HOLE_R + HOLE_AX) / 3.0;
    const gy : f64 = (2.0 * HOLE_TOP + HOLE_AY) / 3.0;
    cg_move(c, to_pt(gx + (HOLE_L - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_TOP - gy) * HOLE_GROW, 1, cy, k));
    cg_line(c, to_pt(gx + (HOLE_R - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_TOP - gy) * HOLE_GROW, 1, cy, k));
    cg_line(c, to_pt(gx + (HOLE_AX - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_AY - gy) * HOLE_GROW, 1, cy, k));
    cg_close(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    cg_fill_path(c);
}

/// T. The one title bar: (screen up) the back chevron, the template logo + TRINITY (home), (screen up)
/// the refresh arc, the dock-panel and fullscreen controls, the divider. The world name is not repeated
/// here: the content header already says it.
fn draw_titlebar(c: u64, kit: [48]u64, sw: f64, full: bool, ma: f64) -> void {
    const mid : f64 = 0.5 * TITLE_H;
    if (ma > 0.0) {
        const bx : f64 = home_x(full);
        cg_line_width(c, 1.2);
        const ct : f64 = centre_top(mid, ROW_ICON_H);
        cg_move(c, bx + CHEV_W, ct);
        cg_line(c, bx, mid);
        cg_line(c, bx + CHEV_W, ct + ROW_ICON_H);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * ma);
        cg_stroke_path(c);
        // refresh: an outline-only arrow arc one step left of the dock control
        const rx : f64 = dock_x(sw) - DOCK_STEP + 0.5 * FULL_PT;
        cg_line_width(c, 1.1);
        cg_arc(c, rx, mid, 4.5, 0.5, TAU - 0.4, 0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * ma);
        cg_stroke_path(c);
        cg_move(c, rx + 4.9, mid - 4.2);
        cg_line(c, rx + 4.5, mid - 0.9);
        cg_line(c, rx + 1.4, mid - 2.0);
        cg_stroke_path(c);
    }
    const k : f64 = logo_k_for(ROW_ICON_H * TITLE_LOGO_SCALE);
    const lw : f64 = title_logo_w();
    const tw : f64 = text_w(kit, kit[K_TRINITY], 11.0, WEIGHT_SEMIBOLD, false);
    const hx : f64 = brand_left(sw, row_next(lw, tw, ROW_GAP));
    draw_template_logo(c, logo_at(0, k, hx + 0.5 * lw), logo_at(1, k, mid), k);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_text(c, kit, kit[K_TRINITY], row_next(hx, lw, ROW_GAP), baseline_for(mid, 11.0), 11.0, WEIGHT_SEMIBOLD, false);
    // arrow.up.left.and.arrow.down.right, grokMuted
    const x : f64 = full_x(sw) + 4.0;
    const y : f64 = 0.5 * (TITLE_H - FULL_PT) + 4.0;
    cg_line_width(c, 1.4);
    cg_move(c, x, y);
    cg_line(c, x + 12.0, y + 12.0);
    cg_move(c, x, y + 5.0);
    cg_line(c, x, y);
    cg_line(c, x + 5.0, y);
    cg_move(c, x + 12.0, y + 7.0);
    cg_line(c, x + 12.0, y + 12.0);
    cg_line(c, x + 7.0, y + 12.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    cg_stroke_path(c);
    // K. sidebar.right, grokMuted: the dock-panel control
    const dx : f64 = dock_x(sw) + 2.0;
    const dy : f64 = 0.5 * (TITLE_H - 13.0);
    cg_line_width(c, 1.3);
    round_rect(c, dx, dy, 16.0, 13.0, 3.0);
    cg_move(c, dx + 10.5, dy);
    cg_line(c, dx + 10.5, dy + 13.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE);
    cg_fill_rect(c, 0.0, TITLE_H, sw, HAIR);
}

/// H. The hover tooltip for petal p: "NAME  Cmd+1" on a white pill.
fn draw_tooltip(c: u64, kit: [48]u64, p: u32, a: f64, z: f64, sw: f64, sh: f64) -> void {
    const name : u64 = world(kit, p);
    var pre : u64 = kit[K_CMD];
    if (p >= 9) { pre = kit[K_OPT]; }
    if (p >= 18) { pre = kit[K_CTRL]; }
    const dig : u64 = msg1(kit[K_DIGITS], kit[K_AT], @as(u64, p % 9));
    // the letter of the petal first ("A  ISA"): petal p is letter p + 1, the same index as the name and the page
    var lb : [4]u8 = undefined;
    const ln : usize = csv_field(PETAL_LETTERS, p, lb[0..4]);
    const lets : u64 = cf_bytes(0, lb[0..4], ln, UTF8, false);
    const wl : f64 = text_w(kit, lets, 13.0, WEIGHT_SEMIBOLD, true) + 10.0;
    const wn : f64 = text_w(kit, name, 13.0, WEIGHT_SEMIBOLD, true);
    const wp : f64 = text_w(kit, pre, 13.0, WEIGHT_SEMIBOLD, true);
    const wd : f64 = text_w(kit, dig, 13.0, WEIGHT_SEMIBOLD, true);
    const gap : f64 = 16.0;
    const w : f64 = wl + wn + gap + wp + wd + 24.0;
    const x : f64 = tip_x(p, z, sw, sh) - 0.5 * w;
    const y : f64 = tip_y(p, z, sw, sh) - 0.5 * TIP_H;
    round_rect(c, x, y, w, TIP_H, 6.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TIP_WHITE * a);
    cg_fill_path(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
    const base : f64 = tip_y(p, z, sw, sh) + 4.6;
    draw_text(c, kit, lets, x + 12.0, base, 13.0, WEIGHT_SEMIBOLD, true);
    draw_text(c, kit, name, x + 12.0 + wl, base, 13.0, WEIGHT_SEMIBOLD, true);
    draw_text(c, kit, pre, x + 12.0 + wl + wn + gap, base, 13.0, WEIGHT_SEMIBOLD, true);
    draw_text(c, kit, dig, x + 12.0 + wl + wn + gap + wp, base, 13.0, WEIGHT_SEMIBOLD, true);
    cf_release(lets);
}

/// W. A session-state dot centred at (x, y): the shape carries the state (black and white only).
fn draw_dot(c: u64, d: u32, x: f64, y: f64, a: f64) -> void {
    cg_line_width(c, 1.0);
    if (d == DOT_FILLED) {
        cg_arc(c, x, y, 3.5, 0.0, TAU, 0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.90 * a);
        cg_fill_path(c);
    } else if (d == DOT_ALERT) {
        cg_arc(c, x, y, 2.5, 0.0, TAU, 0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_fill_path(c);
        cg_arc(c, x, y, 5.0, 0.0, TAU, 0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.90 * a);
        cg_stroke_path(c);
    } else if (d == DOT_DIM) {
        cg_arc(c, x, y, 3.5, 0.0, TAU, 0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.35 * a);
        cg_fill_path(c);
    } else {
        var e : f64 = 0.30;
        if (d == DOT_RING) { e = 0.75; }
        cg_arc(c, x, y, 3.0, 0.0, TAU, 0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, e * a);
        cg_stroke_path(c);
    }
}

/// N. A close x centred on (x, y); a hairline box behind it while the pointer is on it.
fn draw_close_x(c: u64, x: f64, y: f64, lit: bool, a: f64) -> void {
    if (lit) {
        round_rect(c, x - 8.0, y - 8.0, 16.0, 16.0, 4.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
    }
    cg_line_width(c, 1.3);
    cg_move(c, x - 3.5, y - 3.5);
    cg_line(c, x + 3.5, y + 3.5);
    cg_move(c, x + 3.5, y - 3.5);
    cg_line(c, x - 3.5, y + 3.5);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
}

/// W. A sidebar row's ground: lit when selected, a faint fill under the mouse, nothing otherwise.
fn side_row(c: u64, y: f64, h: f64, selected: bool, hover: bool, a: f64) -> void {
    var f : f64 = 0.0;
    if (hover) { f = STRICT_HOVER_FILL; }
    if (selected) { f = TASK_FILL; }
    if (f > 0.0) {
        round_rect(c, 12.0, y, SIDE_W - 24.0, h, STRICT_R);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, f * a);
        cg_fill_path(c);
    }
}

/// W. The sidebar's ground and the divider on its right edge: the chat's and every home tab's.
fn draw_side_frame(c: u64, a: f64, sh: f64, full: bool) -> void {
    cg_fill_rgba(c, 0.0, 0.0, 0.0, surface_alpha(SURF_SIDEBAR, full) * a);
    cg_fill_rect(c, 0.0, WS_TOP, SIDE_W, sh - WS_TOP);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, SIDE_W, WS_TOP, HAIR, sh - WS_TOP);
}

/// W. The sidebar's foot, shared by the chat and the home tabs.
fn draw_side_foot(c: u64, kit: [48]u64, a: f64, mx: f64, my: f64, sh: f64, ws: u32, collapsed: bool, dlabel: u64, dlit: bool, full: bool) -> void {
    // W. the foot: a hairline, then OPEN SOURCE T27, which opens the repository (windows.t27 REPO_URL).
    // Its ground hides a long list under it; in a window it is the sidebar's glass again, not an opaque strip
    draw_ground(c, 0.0, sh - FOOT_H, SIDE_W, FOOT_H, SURF_SIDEBAR, full, a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, 12.0, sh - FOOT_H, SIDE_W - 24.0, HAIR);
    var la : f64 = LABEL_WHITE;
    if (on_repo_link(mx, my, sh, ws, collapsed)) { la = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    const lw : f64 = draw_text(c, kit, kit[K_REPO], 14.0, sh - 13.0, 9.5, WEIGHT_SEMIBOLD, false);
    if (on_repo_link(mx, my, sh, ws, collapsed)) {
        cg_fill_rect(c, 14.0, sh - 10.5, lw, HAIR);
    }
    // D. DOCTOR n at the right end of the foot opens the DOCTOR panel (doctor.t27)
    var da : f64 = LABEL_WHITE;
    if (dlit or on_doctor_link(mx, my, sh, ws, collapsed)) { da = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, da * a);
    draw_text(c, kit, dlabel, SIDE_W - 14.0 - DOC_LINK_W + 22.0, sh - 13.0, 9.5, WEIGHT_SEMIBOLD, false);
}

/// C. Chat workspace: sidebar (unless collapsed), divider, content with header, divider and cards.
/// K. Compact (ws 1): no sidebar, the OPEN DASHBOARD bar instead of the header. Forced dashboard (ws 2):
/// the expanded layout with a zero-width sidebar and the Close Dashboard button in the header.
/// The state shown for chat row si: what the server listed at the last refresh (S_STOPPED before any answer).
pub fn row_state(sst: []const u32, si: u32) -> u32 {
    if (si >= 32) { return S_STOPPED; }
    return sst[si];
}

fn draw_chat(c: u64, kit: [48]u64, shown: u32, task: u32, space: u32, sp: u32, ss: u64, cur: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, sh: f64, ws: u32, dlabel: u64, dlit: bool, full: bool, tup: bool, sst: []const u32, tb: []const u8) -> void {
    const cx : f64 = content_x(ws, collapsed);
    if (ws == WS_DASHBOARD and collapsed == false) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
        cg_fill_rect(c, 0.0, WS_TOP, HAIR, sh - WS_TOP);
    }
    if (ws == WS_EXPANDED and collapsed == false) {
        draw_side_frame(c, a, sh, full);
        // W. three groups (windows.t27): QUEEN, SPACES, AGENTS -- herdr's sidebar with the Queen on top
        const n : u32 = spaces_shown(sp);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_text(c, kit, kit[K_QUEEN_LBL], 14.0, label_base(WS_TOP, GROUP_QUEEN, n), 9.5, WEIGHT_SEMIBOLD, false);
        const qy : f64 = row_top(WS_TOP, GROUP_QUEEN, n, 0);
        side_row(c, qy, ROW_H, task == AGENT_QUEEN, in_box(mx, my, 12.0, qy, SIDE_W - 24.0, ROW_H), a);
        cg_move(c, 22.0, qy + 19.0);
        cg_line(c, 22.0, qy + 11.0);
        cg_line(c, 25.0, qy + 14.0);
        cg_line(c, 27.5, qy + 9.0);
        cg_line(c, 30.0, qy + 14.0);
        cg_line(c, 33.0, qy + 11.0);
        cg_line(c, 33.0, qy + 19.0);
        cg_close(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, CROWN_WHITE * a);
        cg_fill_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_text(c, kit, kit[K_QUEEN], 40.0, qy + 18.0, 11.5, WEIGHT_MEDIUM, false);
        // W. SPACES: a state dot, the name, the branch dim
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_text(c, kit, kit[K_SPACES], 14.0, label_base(WS_TOP, GROUP_SPACES, n), 9.5, WEIGHT_SEMIBOLD, false);
        // W. "+" at the right of the label opens the next closed space slot; hidden when all are open
        if (new_space(sp) != SPACE_NONE) {
            const pcx : f64 = SIDE_W - 26.0;
            const pcy : f64 = label_base(WS_TOP, GROUP_SPACES, n) - 3.5;
            if (on_space_plus(mx, my)) {
                round_rect(c, pcx - 8.0, pcy - 8.0, 16.0, 16.0, 4.0);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
                cg_fill_path(c);
            }
            cg_line_width(c, 1.3);
            cg_move(c, pcx - 4.0, pcy);
            cg_line(c, pcx + 4.0, pcy);
            cg_move(c, pcx, pcy - 4.0);
            cg_line(c, pcx, pcy + 4.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
            cg_stroke_path(c);
        }
        var i : u32 = 0;
        while (i < n) {
            const s : u32 = space_at_row(sp, i);
            const sy : f64 = row_top(WS_TOP, GROUP_SPACES, n, i);
            const sover : bool = in_box(mx, my, 12.0, sy, SIDE_W - 24.0, ROW_H);
            side_row(c, sy, ROW_H, s == space, sover, a);
            // every session is S_STOPPED until the host side starts agent processes
            draw_dot(c, dot_for(S_STOPPED), 20.0, sy + 14.0, a);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            const nw : f64 = draw_text_fit(c, kit, msg1(kit[K_SPACE_NAMES], kit[K_AT], @as(u64, s)), 30.0, sy + 18.0, 11.5, WEIGHT_MEDIUM, false, TEXT_RIGHT);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            draw_text_fit(c, kit, msg1(kit[K_BRANCHES], kit[K_AT], @as(u64, s)), 30.0 + nw + 8.0, sy + 18.0, 10.5, 0.0, false, TEXT_RIGHT);
            // W. a hovered space row shows an x that closes the space and its chats (not the last space)
            if (sover and n > 1) {
                draw_close_x(c, SIDE_W - 26.0, sy + 14.0, on_space_close(mx, my, sy), a);
            }
            i = i + 1;
        }
        // W. AGENTS: the sessions of the selected space
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_text(c, kit, kit[K_AGENTS], 14.0, label_base(WS_TOP, GROUP_AGENTS, n), 9.5, WEIGHT_SEMIBOLD, false);
        const rows : u32 = sessions_in(ss, space);
        if (rows == 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            draw_text(c, kit, kit[K_EMPTY], 14.0, row_top(WS_TOP, GROUP_AGENTS, n, 0) + 16.0, 10.5, 0.0, false);
        }
        var r : u32 = 0;
        while (r < rows) {
            const si : u32 = session_at_row(ss, space, r);
            const k : u32 = session_agent(ss, si);
            const ay : f64 = row_top(WS_TOP, GROUP_AGENTS, n, r);
            const over : bool = in_box(mx, my, 12.0, ay, SIDE_W - 24.0, AGENT_ROW_H);
            side_row(c, ay, AGENT_ROW_H, si == cur, over, a);
            draw_agent_mark(c, k, 27.5, ay + 19.0, 6.0, a);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            // the model this pane runs on and its key light, right of the name
            const amodel : u32 = lv_agent_model(k);
            var mwb : [16]u8 = undefined;
            const mwn : usize = put_bytes(mwb[0..16], 0, lv_model_word(amodel));
            var mww : f64 = 0.0;
            if (mwn > 0) { mww = bytes_w(kit, mwb[0..16], mwn, 8.0, WEIGHT_SEMIBOLD, false) + 6.0; }
            const nw : f64 = draw_text_fit(c, kit, msg1(kit[K_AGENT_NAMES], kit[K_AT], @as(u64, k)), 40.0, ay + 16.0, 11.5, WEIGHT_MEDIUM, false, TEXT_RIGHT - 16.0 - mww - 8.0);
            if (mwn > 0) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
                draw_bytes(c, kit, mwb[0..16], mwn, SIDE_W - 44.0 - mww + 6.0, ay + 15.0, 8.0, WEIGHT_SEMIBOLD, false);
                const alight : u32 = lv_light(amodel, false, 1);
                if (alight != L_NONE) {
                    cg_arc(c, SIDE_W - 38.0, ay + 12.0, 2.5, 0.0, TAU, 0);
                    if (alight == L_GREEN) { cg_fill_rgba(c, 0.30, 0.85, 0.45, a); }
                    else if (alight == L_YELLOW) { cg_fill_rgba(c, 0.95, 0.80, 0.25, a); }
                    else { cg_fill_rgba(c, 0.95, 0.35, 0.30, a); }
                    cg_fill_path(c);
                }
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            // N. a second chat of the same agent in this space reads "Claude Code 2"
            const cn : u32 = chat_number(ss, si);
            if (cn > 1 and cn <= 9) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
                draw_text(c, kit, msg1(kit[K_DIGITS], kit[K_AT], @as(u64, cn - 1)), 40.0 + nw + 4.0, ay + 16.0, 11.5, WEIGHT_MEDIUM, false);
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            const ww : f64 = draw_text(c, kit, msg1(kit[K_STATE_WORDS], kit[K_AT], @as(u64, row_state(sst, si))), 40.0, ay + 30.0, 9.5, 0.0, false);
            cg_arc(c, 40.0 + ww + 5.0, ay + 27.0, 1.5, 0.0, TAU, 0);
            cg_fill_path(c);
            draw_text_fit(c, kit, msg1(kit[K_SPACE_NAMES], kit[K_AT], @as(u64, space)), 40.0 + ww + 10.0, ay + 30.0, 9.5, 0.0, false, TEXT_RIGHT);
            // N. the hovered row trades its dot for a close x
            if (over) {
                draw_close_x(c, SIDE_W - 26.0, ay + 19.0, on_row_close(mx, my, ay), a);
            } else {
                draw_dot(c, dot_for(row_state(sst, si)), SIDE_W - 26.0, ay + 19.0, a);
            }
            r = r + 1;
        }
        draw_lanes_block(c, kit, sst, tb, lane_block_top(n, rows), sh, mx, my, a);
        draw_side_foot(c, kit, a, mx, my, sh, ws, collapsed, dlabel, dlit, full);
    }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, surface_alpha(SURF_CONTENT, full) * a);
    cg_fill_rect(c, cx, WS_TOP, sw - cx, sh - WS_TOP);
    if (ws == WS_COMPACT) {
        draw_dash_bar(c, kit, a, sw, on_open_dash(mx, my, sw, ws));
    } else {
        var hag : u64 = 0;
        var hsp : u64 = 0;
        if (shown == PETAL_CHAT and cur != SESSION_NONE) {
            hag = msg1(kit[K_AGENT_NAMES], kit[K_AT], @as(u64, session_agent(ss, cur)));
            hsp = msg1(kit[K_SPACE_NAMES], kit[K_AT], @as(u64, space));
        }
        draw_header(c, kit, shown, a, collapsed, mx, my, sw, ws, hag, hsp);
    }
    // the cards are the screen of a chat with no pane; with a terminal pane up they would show through its
    // glass, so they are not drawn
    if (tup == false) { draw_cards(c, kit, task, a, collapsed, mx, my, sw, sh, ws); }
    if (ws != WS_COMPACT and sst[SST_LVSEL] != LV_NONE) { draw_lane_tail(c, kit, sst, tb, content_x(ws, collapsed), WS_TOP + HEADER_H, sw - content_x(ws, collapsed), sh - WS_TOP - HEADER_H, a, full, mx, my); }
}

/// L. The LANES block of the chat sidebar: a label with the running count, then one two-line row per lane or actor
/// (lanes_view.t27 draws the bytes): the key light, source / issue / model, the state word at the right, the elapsed
/// time and the last line below. The lights are the key lights of keys.t27; no light when the model is unknown.
fn draw_lanes_block(c: u64, kit: [48]u64, sst: []const u32, tb: []const u8, top: f64, sh: f64, mx: f64, my: f64, a: f64) -> void {
    const n : u32 = sst[SST_LVN];
    const vis : u32 = lane_block_vis(top, sh);
    const tab : []const u32 = sst[SST_LV .. SST_SIZE];
    const txt : []const u8 = tb[TBO_LTXT .. TB_LANES_END];
    var hd : [48]u8 = undefined;
    var h : usize = put_bytes(hd[0..48], 0, "LANES AND ACTORS  ");
    h = put_dec(hd[0..48], h, @as(u64, lv_work_count(tab, n, LVS_RUNNING)));
    h = put_bytes(hd[0..48], h, " RUNNING");
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, hd[0..48], h, 14.0, top + 14.0, 9.5, WEIGHT_SEMIBOLD, false);
    if (vis == 0 or n == 0) { return; }
    cg_save(c);
    cg_clip_rect(c, 0.0, top + LV_LABEL_H, SIDE_W, sh - FOOT_H - top - LV_LABEL_H);
    var s : u32 = 0;
    while (s < vis) {
        const i : u32 = sst[SST_LVOFF] + s;
        if (i < n) {
            const y : f64 = lv_row_top(top, s);
            const over : bool = in_box(mx, my, 12.0, y, SIDE_W - 24.0, LV_ROW_H - 2.0);
            side_row(c, y, LV_ROW_H - 2.0, sst[SST_LVSEL] == i, over, a);
            const light : u32 = tab[@as(usize, i) * LV_F + LVF_LIGHT];
            if (lv_is_group(tab, i)) {
                // the kernel group: a chevron, right when folded and down when expanded
                cg_line_width(c, 1.3);
                if (sst[SST_LVKX] != 0) {
                    cg_move(c, 17.5, y + 10.0);
                    cg_line(c, 22.0, y + 14.5);
                    cg_line(c, 26.5, y + 10.0);
                } else {
                    cg_move(c, 20.0, y + 8.0);
                    cg_line(c, 24.5, y + 12.5);
                    cg_line(c, 20.0, y + 17.0);
                }
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
                cg_stroke_path(c);
            } else {
                cg_arc(c, 22.0, y + 12.0, 3.5, 0.0, TAU, 0);
                if (light == L_GREEN) { cg_fill_rgba(c, 0.30, 0.85, 0.45, a); }
                else if (light == L_YELLOW) { cg_fill_rgba(c, 0.95, 0.80, 0.25, a); }
                else if (light == L_RED) { cg_fill_rgba(c, 0.95, 0.35, 0.30, a); }
                else { cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.18 * a); }
                cg_fill_path(c);
            }
            var l1 : [96]u8 = undefined;
            const k1 : usize = lv_line1(tab, i, l1[0..96]);
            const sw : string = lv_state_word(tab, i);
            var wb : [16]u8 = undefined;
            const wn : usize = put_bytes(wb[0..16], 0, sw);
            const ww : f64 = bytes_w(kit, wb[0..16], wn, 8.5, WEIGHT_SEMIBOLD, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_fit(c, kit, l1[0..96], k1, 34.0, y + 14.0, 10.5, WEIGHT_MEDIUM, false, SIDE_W - 24.0 - ww - 12.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
            draw_bytes(c, kit, wb[0..16], wn, SIDE_W - 14.0 - ww, y + 14.0, 8.5, WEIGHT_SEMIBOLD, false);
            var l2 : [128]u8 = undefined;
            const k2 : usize = lv_line2(tab, txt, i, l2[0..128]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            draw_fit(c, kit, l2[0..128], k2, 34.0, y + 27.0, 9.5, 0.0, true, SIDE_W - 18.0);
        }
        s = s + 1;
    }
    cg_restore(c);
}

/// L. A clicked lane in the content area, as its own view that REPLACES the terminal (the terminal is not drawn
/// while it is open): a header "<KIND> <name> -- log" with a "back to chat" crumb and a close x, a cleared glass
/// ground, and the last lines of the .lane.log (a script lane) or the row's own line, scrolled with the wheel.
/// Escape, the x and the crumb close it (lanes_view.t27 lv_log_event).
fn draw_lane_tail(c: u64, kit: [48]u64, sst: []const u32, tb: []const u8, ox: f64, oy: f64, pw: f64, ph: f64, a: f64, full: bool, mx: f64, my: f64) -> void {
    const i : u32 = sst[SST_LVSEL];
    const tab : []const u32 = sst[SST_LV .. SST_SIZE];
    const txt : []const u8 = tb[TBO_LTXT .. TB_LANES_END];
    // the whole content area from the top of the window's header strip, right of the sidebar toggle
    const hx : f64 = ox + 14.0 + TOGGLE_PT + 8.0;
    draw_ground(c, hx, WS_TOP, ox + pw - hx, HEADER_H, SURF_CONTENT, full, a);
    draw_ground(c, ox, oy + HAIR, pw, ph - HAIR, SURF_TERMINAL, full, a);
    cg_save(c);
    cg_clip_rect(c, ox, WS_TOP, pw, oy + ph - WS_TOP);
    const hit : u32 = lv_log_hit(mx, my, ox, oy, pw, ph);
    // the crumb
    if (hit == LVH_CRUMB) {
        round_rect(c, ox + LV_LOG_PAD - 6.0, oy + 8.0, 124.0, 24.0, 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_bytes(c, kit, "< back to chat", 14, ox + LV_LOG_PAD, oy + 25.0, 10.5, WEIGHT_SEMIBOLD, false);
    // the title, centred between the crumb and the x
    var tt : [96]u8 = undefined;
    const tk : usize = lv_log_title(tab, txt, i, tt[0..96]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_fit(c, kit, tt[0..96], tk, ox + LV_LOG_PAD + 130.0, oy + 25.0, 12.0, WEIGHT_SEMIBOLD, false, ox + pw - LV_LOG_PAD - LV_LOG_X_W - 12.0);
    // the close x
    draw_close_x(c, ox + pw - LV_LOG_PAD - 0.5 * LV_LOG_X_W, oy + 20.0, hit == LVH_CLOSE, a);
    // the header's hairline
    cg_fill_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * a);
    cg_fill_rect(c, ox, oy + LV_LOG_HEAD_H, pw, HAIR);
    // the body: state word, then the lines
    var wb : [16]u8 = undefined;
    const wn : usize = put_bytes(wb[0..16], 0, lv_state_word(tab, i));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    const by : f64 = oy + LV_LOG_HEAD_H + LV_LOG_PAD;
    const src : u32 = tab[@as(usize, i) * LV_F + LVF_SRC];
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    if (lv_can_tail(src)) {
        const tl : usize = @as(usize, sst[SST_LVTAIL]);
        const buf : []const u8 = tb[TBO_LT .. TBO_LT + tl];
        var starts : [40]u32 = undefined;
        const nl : u32 = lv_tail_lines(buf, starts[0..40], LV_TAIL_LINES);
        const vis : u32 = lv_log_vis(ph);
        const first : u32 = lv_log_first(nl, vis, sst[SST_LVLSCR]);
        var k : u32 = 0;
        while (k < vis and first + k < nl) {
            const at : u32 = starts[first + k];
            const len : u32 = lv_line_len(buf, at);
            draw_fit(c, kit, buf[@as(usize, at) .. @as(usize, at + len)], @as(usize, len), ox + LV_LOG_PAD, by + @as(f64, k + 1) * LV_LOG_LINE_H - 3.0, TP_FONT - 1.0, 0.0, true, ox + pw - LV_LOG_PAD);
            k = k + 1;
        }
        if (nl == 0) { draw_bytes(c, kit, "reading the log...", 18, ox + LV_LOG_PAD, by + LV_LOG_LINE_H - 3.0, TP_FONT - 1.0, 0.0, true); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_bytes(c, kit, wb[0..16], wn, ox + pw - LV_LOG_PAD - 70.0, oy + ph - 10.0, 9.0, WEIGHT_SEMIBOLD, false);
    } else {
        var l2 : [128]u8 = undefined;
        const k2 : usize = lv_line2(tab, txt, i, l2[0..128]);
        draw_fit(c, kit, wb[0..16], wn, ox + LV_LOG_PAD, by + 12.0, 10.5, WEIGHT_SEMIBOLD, false, ox + pw - LV_LOG_PAD);
        draw_fit(c, kit, l2[0..128], k2, ox + LV_LOG_PAD, by + 34.0, TP_FONT, 0.0, true, ox + pw - LV_LOG_PAD);
    }
    cg_restore(c);
}

/// C. The sidebar.left toggle at the left of the 44 pt header; a faint box behind it while the pointer is on it.
fn draw_side_toggle(c: u64, a: f64, cx: f64, lit: bool) -> void {
    const ty : f64 = WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT);
    if (lit) {
        round_rect(c, cx + 14.0, ty, TOGGLE_PT, TOGGLE_PT, 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
    }
    const ix : f64 = cx + 14.0 + 6.0;
    const iy : f64 = ty + 7.5;
    cg_line_width(c, 1.3);
    round_rect(c, ix, iy, 16.0, 13.0, 3.0);
    cg_move(c, ix + 5.5, iy);
    cg_line(c, ix + 5.5, iy + 13.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
}

/// C. The 44 pt header: sidebar.left toggle, Close Dashboard when forced open, the title, the divider.
fn draw_header(c: u64, kit: [48]u64, shown: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, ws: u32, ag: u64, spn: u64) -> void {
    const cx : f64 = content_x(ws, collapsed);
    // header: sidebar.left toggle, then the title
    const ty : f64 = WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT);
    draw_side_toggle(c, a, cx, on_side_toggle(mx, my, ws, collapsed));
    var title_x : f64 = cx + 14.0 + TOGGLE_PT + 12.0;
    if (ws == WS_DASHBOARD) {
        // K. rectangle.compress.vertical, grokMuted: two arrows closing on a line
        const kx : f64 = close_x(ws, collapsed);
        if (on_close_dash(mx, my, ws, collapsed)) {
            round_rect(c, kx, ty, TOGGLE_PT, TOGGLE_PT, 6.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
            cg_fill_path(c);
        }
        const mxc : f64 = kx + 0.5 * TOGGLE_PT;
        const myc : f64 = ty + 0.5 * TOGGLE_PT;
        cg_line_width(c, 1.3);
        cg_move(c, mxc - 7.0, myc);
        cg_line(c, mxc + 7.0, myc);
        cg_move(c, mxc, myc - 8.0);
        cg_line(c, mxc, myc - 2.5);
        cg_move(c, mxc - 3.0, myc - 5.5);
        cg_line(c, mxc, myc - 2.5);
        cg_line(c, mxc + 3.0, myc - 5.5);
        cg_move(c, mxc, myc + 8.0);
        cg_line(c, mxc, myc + 2.5);
        cg_move(c, mxc - 3.0, myc + 5.5);
        cg_line(c, mxc, myc + 2.5);
        cg_line(c, mxc + 3.0, myc + 5.5);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        cg_stroke_path(c);
        title_x = kx + TOGGLE_PT + 12.0;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    const tw0 : f64 = draw_text(c, kit, world(kit, shown), title_x, WS_TOP + 0.5 * HEADER_H + 4.2, 12.0, WEIGHT_SEMIBOLD, false);
    // the CHAT header also names the selected agent and the space it works in
    if (ag != 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        const tw1 : f64 = draw_text(c, kit, ag, title_x + tw0 + 14.0, WS_TOP + 0.5 * HEADER_H + 4.2, 12.0, WEIGHT_MEDIUM, false);
        if (spn != 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            draw_text(c, kit, spn, title_x + tw0 + 14.0 + tw1 + 12.0, WS_TOP + 0.5 * HEADER_H + 4.2, 11.0, 0.0, false);
        }
    }
    // N. "+": a new chat for the selected agent, so several Claude Codes can run side by side
    const px : f64 = new_chat_x(sw);
    if (on_new_chat(mx, my, sw, ws)) {
        round_rect(c, px, ty, TOGGLE_PT, TOGGLE_PT, 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
    }
    cg_line_width(c, 1.3);
    cg_move(c, px + 0.5 * TOGGLE_PT - 6.0, ty + 0.5 * TOGGLE_PT);
    cg_line(c, px + 0.5 * TOGGLE_PT + 6.0, ty + 0.5 * TOGGLE_PT);
    cg_move(c, px + 0.5 * TOGGLE_PT, ty + 0.5 * TOGGLE_PT - 6.0);
    cg_line(c, px + 0.5 * TOGGLE_PT, ty + 0.5 * TOGGLE_PT + 6.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, cx, WS_TOP + HEADER_H, sw - cx, HAIR);
}

/// K. trios dashboardToggleButton: rectangle.split.3x1 (white 0.4), "OPEN DASHBOARD" (bold 10, white
/// 0.5), the expand arrows (grokMuted) on the right; elevated 0.25 fill, a 1 pt border 0.3 line under it.
fn draw_dash_bar(c: u64, kit: [48]u64, a: f64, sw: f64, lit: bool) -> void {
    var f : f64 = ELEVATED_BLACK * 0.25;
    if (lit) { f = ELEVATED_BLACK * 0.5; }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, f * a);
    cg_fill_rect(c, 0.0, WS_TOP, sw, BAR_H);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * 0.3 * a);
    cg_fill_rect(c, 0.0, WS_TOP + BAR_H - 1.0, sw, 1.0);
    const mid : f64 = WS_TOP + 0.5 * BAR_H;
    cg_line_width(c, 1.1);
    round_rect(c, 14.0, mid - 4.5, 13.0, 9.0, 1.5);
    cg_move(c, 18.3, mid - 4.5);
    cg_line(c, 18.3, mid + 4.5);
    cg_move(c, 22.7, mid - 4.5);
    cg_line(c, 22.7, mid + 4.5);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.5 * a);
    draw_text(c, kit, kit[K_OPEN_DASH], 33.0, mid + 3.6, 10.0, WEIGHT_BOLD, false);
    const x : f64 = sw - 14.0 - 8.0;
    const y : f64 = mid - 4.0;
    cg_line_width(c, 1.1);
    cg_move(c, x, y);
    cg_line(c, x + 8.0, y + 8.0);
    cg_move(c, x, y + 3.5);
    cg_line(c, x, y);
    cg_line(c, x + 3.5, y);
    cg_move(c, x + 8.0, y + 4.5);
    cg_line(c, x + 8.0, y + 8.0);
    cg_line(c, x + 4.5, y + 8.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
}

/// A. Unit rays at 45 degree steps for the Claude Code spark.
pub const RAY_X : [8]f64 = [1.0, 0.7071067811865476, 0.0, -0.7071067811865476, -1.0, -0.7071067811865476, 0.0, 0.7071067811865476];
pub const RAY_Y : [8]f64 = [0.0, 0.7071067811865476, 1.0, 0.7071067811865476, 0.0, -0.7071067811865476, -1.0, -0.7071067811865476];
/// A. The mark is AGENT_MARK of the cell radius, its centre AGENT_MARK_UP above the cell centre; the
/// name sits AGENT_NAME_DOWN below it. White only (FR-006), at MARK_WHITE.
pub const AGENT_MARK : f64 = 0.26;
pub const AGENT_MARK_UP : f64 = 0.10;
pub const AGENT_NAME_DOWN : f64 = 0.42;
pub const AGENT_NAME_PT : f64 = 12.0;
pub const MARK_WHITE : f64 = 0.85;
/// A. The name shrinks with the cell (AGENT_NAME_SHARE of the radius, at most AGENT_NAME_PT) and is left
/// out below AGENT_NAME_MIN, where it would not be readable.
pub const AGENT_NAME_SHARE : f64 = 0.15;
pub const AGENT_NAME_MIN : f64 = 8.0;

pub fn agent_name_pt(r: f64) -> f64 {
    if (AGENT_NAME_SHARE * r < AGENT_NAME_PT) { return AGENT_NAME_SHARE * r; }
    return AGENT_NAME_PT;
}

/// A. The mark of agent k centred at (x, y), half-size s: vector glyphs drawn here, not downloaded images.
fn draw_agent_mark(c: u64, k: u32, x: f64, y: f64, s: f64, a: f64) -> void {
    cg_line_width(c, 0.12 * s);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MARK_WHITE * a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MARK_WHITE * a);
    if (k == 0) {
        // Claude Code: a spark, long and short rays in turn
        cg_line_width(c, 0.18 * s);
        var i : u32 = 0;
        while (i < 8) {
            var r : f64 = s;
            if (i % 2 == 1) { r = 0.7 * s; }
            cg_move(c, x + 0.18 * s * RAY_X[i], y + 0.18 * s * RAY_Y[i]);
            cg_line(c, x + r * RAY_X[i], y + r * RAY_Y[i]);
            i = i + 1;
        }
        cg_stroke_path(c);
    } else if (k == 1) {
        // Codex: a prompt in a rounded square
        round_rect(c, x - s, y - s, 2.0 * s, 2.0 * s, 0.4 * s);
        cg_move(c, x - 0.5 * s, y - 0.4 * s);
        cg_line(c, x - 0.1 * s, y);
        cg_line(c, x - 0.5 * s, y + 0.4 * s);
        cg_move(c, x + 0.05 * s, y + 0.45 * s);
        cg_line(c, x + 0.55 * s, y + 0.45 * s);
        cg_stroke_path(c);
    } else if (k == 2) {
        // Gemini: a four-point star
        const w : f64 = 0.2 * s;
        cg_move(c, x, y - s);
        cg_line(c, x + w, y - w);
        cg_line(c, x + s, y);
        cg_line(c, x + w, y + w);
        cg_line(c, x, y + s);
        cg_line(c, x - w, y + w);
        cg_line(c, x - s, y);
        cg_line(c, x - w, y - w);
        cg_close(c);
        cg_fill_path(c);
    } else if (k == 3) {
        // OpenCode: an open frame around a solid block
        cg_move(c, x + 0.3 * s, y - s);
        cg_line(c, x - s, y - s);
        cg_line(c, x - s, y + s);
        cg_line(c, x + s, y + s);
        cg_line(c, x + s, y - 0.3 * s);
        cg_stroke_path(c);
        cg_fill_rect(c, x - 0.35 * s, y - 0.35 * s, 0.7 * s, 0.7 * s);
    } else if (k == 4) {
        // Queen: the crown of the sidebar row
        cg_move(c, x - s, y + 0.7 * s);
        cg_line(c, x - s, y - 0.5 * s);
        cg_line(c, x - 0.45 * s, y);
        cg_line(c, x, y - 0.9 * s);
        cg_line(c, x + 0.45 * s, y);
        cg_line(c, x + s, y - 0.5 * s);
        cg_line(c, x + s, y + 0.7 * s);
        cg_close(c);
        cg_fill_path(c);
    } else if (k == 5) {
        // Crush: a heart, one path (two lobes over the top, a point below) so no fill stacks
        cg_move(c, x, y + s);
        cg_arc(c, x - 0.45 * s, y - 0.3 * s, 0.5 * s, 0.5 * TAU, TAU, 0);
        cg_arc(c, x + 0.45 * s, y - 0.3 * s, 0.5 * s, 0.5 * TAU, TAU, 0);
        cg_close(c);
        cg_fill_path(c);
    } else if (k == 6) {
        // Cursor: a cube seen corner-on
        const hw : f64 = 0.5 * SQRT3 * s;
        hex_path(c, x, y, s);
        cg_move(c, x, y);
        cg_line(c, x, y + s);
        cg_move(c, x, y);
        cg_line(c, x - hw, y - 0.5 * s);
        cg_move(c, x, y);
        cg_line(c, x + hw, y - 0.5 * s);
        cg_stroke_path(c);
    } else if (k == 7) {
        // Aider: a speech bubble with three lines
        round_rect(c, x - s, y - 0.8 * s, 2.0 * s, 1.4 * s, 0.3 * s);
        cg_move(c, x - 0.5 * s, y + 0.6 * s);
        cg_line(c, x - 0.6 * s, y + s);
        cg_line(c, x - 0.1 * s, y + 0.6 * s);
        cg_move(c, x - 0.6 * s, y - 0.4 * s);
        cg_line(c, x + 0.6 * s, y - 0.4 * s);
        cg_move(c, x - 0.6 * s, y - 0.1 * s);
        cg_line(c, x + 0.6 * s, y - 0.1 * s);
        cg_move(c, x - 0.6 * s, y + 0.2 * s);
        cg_line(c, x + 0.2 * s, y + 0.2 * s);
        cg_stroke_path(c);
    } else {
        // Copilot: goggles
        round_rect(c, x - s, y - 0.45 * s, 0.85 * s, 0.9 * s, 0.3 * s);
        round_rect(c, x + 0.15 * s, y - 0.45 * s, 0.85 * s, 0.9 * s, 0.3 * s);
        cg_move(c, x - 0.15 * s, y - 0.1 * s);
        cg_line(c, x + 0.15 * s, y - 0.1 * s);
        cg_stroke_path(c);
        cg_fill_rect(c, x - 0.6 * s, y - 0.1 * s, 0.12 * s, 0.3 * s);
        cg_fill_rect(c, x + 0.48 * s, y - 0.1 * s, 0.12 * s, 0.3 * s);
    }
}

/// C. The nine card slots as a honeycomb in the readable column; A. each cell carries its agent mark and name.
/// F. The outline of comb cell k, given the hovered cell hk and the open task: the same width for every
/// cell, the alpha set only by hover and selection. The width is set before each cell's stroke because
/// draw_agent_mark changes the line width -- cell 0 alone got the hairline while every later cell was stroked
/// at the previous mark's width (owner, 2026-10-19: "why is this cell bolder than the others? it's a bug").
pub fn cell_line(k: u32) -> f64 {
    return HAIR;
}

pub fn cell_edge(k: u32, hk: u32, task: u32) -> f64 {
    if (k == task) { return TASK_EDGE; }
    if (k == hk) { return STRICT_HOVER_EDGE; }
    return STRICT_CARD_EDGE;
}

fn draw_cards(c: u64, kit: [48]u64, task: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, sh: f64, ws: u32) -> void {
    const l : f64 = body_left(sw, ws, collapsed);
    const t : f64 = body_top(ws);
    const w : f64 = body_w(sw, ws, collapsed);
    const h : f64 = body_h(sw, sh, ws, collapsed);
    const r : f64 = hex_r(w, h);
    var hk : u32 = CARD_SLOTS;
    if (a >= 1.0) { hk = card_at(mx, my, sw, sh, ws, collapsed); }
    // F. strict cells: hairline hexagons, a faint fill, no hover lift
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        const ka : f64 = card_alpha(a, k);
        var kf : f64 = STRICT_CARD_FILL;
        const lift : f64 = (1.0 - ka) * 6.0;
        if (k == hk) {
            kf = STRICT_HOVER_FILL;
        }
        if (k == task) {
            kf = TASK_FILL;
        }
        const kx : f64 = hex_c(k, 0, l, t, w, h);
        const ky : f64 = hex_c(k, 1, l, t, w, h) + lift;
        hex_path(c, kx, ky, r - 0.25);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, kf * ka);
        cg_fill_path(c);
        cg_line_width(c, cell_line(k));
        hex_path(c, kx, ky, r - 0.25);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, cell_edge(k, hk, task) * ka);
        cg_stroke_path(c);
        draw_agent_mark(c, k, kx, ky - AGENT_MARK_UP * r, AGENT_MARK * r, ka);
        const ns : f64 = agent_name_pt(r);
        if (ns >= AGENT_NAME_MIN) {
            const name : u64 = msg1(kit[K_AGENT_NAMES], kit[K_AT], @as(u64, k));
            const nw : f64 = text_w(kit, name, ns, WEIGHT_SEMIBOLD, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * ka);
            draw_text(c, kit, name, kx - 0.5 * nw, ky + AGENT_NAME_DOWN * r, ns, WEIGHT_SEMIBOLD, false);
        }
        k = k + 1;
    }
}

/// H. Text from a table constant, as bytes.
fn draw_str(c: u64, kit: [48]u64, s: []const u8, x: f64, base: f64, size: f64, weight: f64) -> f64 {
    return draw_bytes(c, kit, s, s.len, x, base, size, weight, false);
}

/// H. A home tab shares the chat's frame: a sidebar of 272 pt unless collapsed, the 44 pt header, the content.
/// The chat's forced-dashboard layout has no meaning there, so every width but the narrow one is the expanded one.
pub fn home_ws(ws: u32) -> u32 {
    if (ws == WS_COMPACT) { return WS_COMPACT; }
    return WS_EXPANDED;
}

/// H. The workspace whose sidebar the screen of petal p shows: the chat's own, or a home tab's.
pub fn side_ws(p: u32, ws: u32) -> u32 {
    if (p == PETAL_CHAT) { return ws; }
    return home_ws(ws);
}

/// H. The scrolling page starts under the header's divider and fills the rest of the window.
pub fn home_view_top() -> f64 { return WS_TOP + HEADER_H + 1.0; }

pub fn home_view_h(sh: f64) -> f64 { return sh - home_view_top(); }

pub fn on_home_view(x: f64, y: f64, ws: u32, collapsed: bool) -> bool {
    return y >= home_view_top() and x >= content_x(home_ws(ws), collapsed);
}

/// H. The scrollbar: a line 4 pt in from both ends of the view, its thumb as tall as the view is of the page
/// (28 pt at least), placed by the offset.
pub fn thumb_h(view: f64, total: f64) -> f64 {
    var t : f64 = (view - 8.0) * view / total;
    if (t < 28.0) { t = 28.0; }
    if (t > view - 8.0) { t = view - 8.0; }
    return t;
}

pub fn thumb_y(off: u32, top: u32, view: f64, th: f64) -> f64 {
    if (top == 0) { return 4.0; }
    return 4.0 + (view - 8.0 - th) * @as(f64, @floatFromInt(off)) / @as(f64, @floatFromInt(top));
}

/// H. Text from bytes, cut with an ellipsis where it would pass `right` (not cut when right is 0).
fn draw_fit(c: u64, kit: [48]u64, s: []const u8, n: usize, x: f64, base: f64, size: f64, weight: f64, mono: bool, right: f64) -> f64 {
    if (n == 0) { return 0.0; }
    const ns : u64 = cf_bytes(0, s, n, UTF8, false);
    if (ns == 0) { return 0.0; }
    var w : f64 = 0.0;
    if (right > 0.0) {
        w = draw_text_fit(c, kit, ns, x, base, size, weight, mono, right);
    } else {
        w = draw_text(c, kit, ns, x, base, size, weight, mono);
    }
    cf_release(ns);
    return w;
}

/// H. Where the first of two lines of s ends: n when it fits in `room`, else the last space that leaves it fitting.
fn wrap_at(kit: [48]u64, s: []const u8, n: usize, size: f64, weight: f64, room: f64) -> usize {
    if (bytes_w(kit, s, n, size, weight, false) <= room) { return n; }
    var k : usize = n;
    while (k > 0) {
        k = k - 1;
        if (s[k] == 32 and bytes_w(kit, s, k, size, weight, false) <= room) { return k; }
    }
    return n;
}

// ---- the instrument panel of a home tab (dash.t27 decides, this draws) ----
// dc is the dashboard's state: counters and handles in the first slots, one state per widget from D_ST, the
// image cache (widget keys from D_KEYS, NSImage handles from D_IMGS).

pub const D_GEN : u32 = 0;
pub const D_GN : u32 = 2;
pub const D_LIVE : u32 = 3;
pub const D_WEB : u32 = 4;
pub const D_BUDGET : u32 = 5;
pub const D_NEXT : u32 = 6;
pub const D_POLL : u32 = 14;
pub const D_LAST : u32 = 7;
pub const D_GTRY : u32 = 8;
pub const D_DEFER : u32 = 9;
pub const D_SEL_INIT : u32 = 10;
pub const D_SEL_CG : u32 = 11;
pub const D_CLS_IMG : u32 = 12;
pub const D_SEL_ALLOC : u32 = 13;
pub const D_ST : u32 = 16;
pub const D_KEYS : u32 = 256;
pub const D_IMGS : u32 = 384;
pub const D_SIZE : usize = 512;
pub const DECODES_PER_FRAME : u64 = 3;

/// The thumbnail of widget wi's card, 0 while it is not decoded yet. A lookup only (owner, 2026-10-20): the
/// draw path never opens, stats or decodes a file. A miss queues the widget (D_REQ_N, D_REQ) for thumbs_load.
fn card_img(dc: []u64, gal: []const u8, gt: []const u32, hb: []const u8, wi: u32) -> u64 {
    if (dc[D_GN] == 0 or wi >= WIDGET_COUNT) { return 0; }
    const st : u64 = dc[D_ST + wi];
    if (st != WS_LOADED and st != WS_NEW) { return 0; }
    const s0 : u32 = tk_find(dc[D_KEYS .. D_KEYS + 128], CACHE_SLOTS, wi);
    if (s0 < CACHE_SLOTS) {
        dc[D_NEXT] = dc[D_NEXT] + 1;
        dc[D_KEYS + s0] = tk_make(wi, dc[D_NEXT]);
        return dc[D_IMGS + s0];
    }
    card_ask(dc, wi, REQ_VISIBLE);
    return 0;
}

pub const REQ_VISIBLE : u32 = 8;
pub const REQ_AHEAD : u32 = 5;

/// Queue widget wi for decoding, once, while fewer than `room` are waiting.
fn card_ask(dc: []u64, wi: u32, room: u32) -> void {
    const n : u32 = @as(u32, @intCast(dc[D_REQ_N]));
    if (n >= room) { return; }
    var i : u32 = 0;
    while (i < n) {
        if (dc[D_REQ + i] == @as(u64, wi)) { return; }
        i = i + 1;
    }
    dc[D_REQ + n] = @as(u64, wi);
    dc[D_REQ_N] = @as(u64, n) + 1;
}

/// Drop every thumbnail (the tiles grew past the size they were cut for).
fn thumbs_flush(dc: []u64) -> void {
    var s : u32 = 0;
    while (s < CACHE_SLOTS) {
        if (dc[D_KEYS + s] != 0) {
            cg_image_release(dc[D_IMGS + s]);
            dc[D_KEYS + s] = 0;
            dc[D_IMGS + s] = 0;
        }
        s = s + 1;
    }
}

/// The thumbnail of the card file at path (n bytes), longest side px: ImageIO decodes straight to the small
/// size, now (kCGImageSourceShouldCacheImmediately). 0 when the file does not decode.
fn card_thumb(path: []const u8, n: usize, px: u32) -> u64 {
    const ps : u64 = cf_bytes(0, path, n, UTF8, false);
    const url : u64 = msg1(cls("NSURL"), sel("fileURLWithPath:"), ps);
    cf_release(ps);
    const yes : u64 = msg_flag(cls("NSNumber"), sel("numberWithBool:"), true);
    const num : u64 = msg1(cls("NSNumber"), sel("numberWithUnsignedLongLong:"), @as(u64, px));
    var keys : [3]u64 = undefined;
    var vals : [3]u64 = undefined;
    keys[0] = cf("kCGImageSourceCreateThumbnailFromImageAlways");
    vals[0] = yes;
    keys[1] = cf("kCGImageSourceThumbnailMaxPixelSize");
    vals[1] = num;
    keys[2] = cf("kCGImageSourceShouldCacheImmediately");
    vals[2] = yes;
    const opts : u64 = msg_dict3(cls("NSDictionary"), sel("dictionaryWithObjects:forKeys:count:"), vals, keys, 3);
    const src : u64 = img_src_url(url, 0);
    var img : u64 = 0;
    if (src != 0) {
        img = img_thumb(src, 0, opts);
        cf_release(src);
    }
    cf_release(keys[0]);
    cf_release(keys[1]);
    cf_release(keys[2]);
    return img;
}

/// Decode the queued cards, at most DECODES_PER_FRAME a frame, outside the draw (dash.t27: thumb_cap, thumb_px,
/// tk_slot). A card that is not on disk asks for a fetch (WS_WANT); a page without a card fails.
fn thumbs_load(dc: []u64, gal: []const u8, gt: []const u32, hb: []const u8) -> void {
    if (dc[D_GN] == 0) { return; }
    const want : u64 = dc[D_WANTPX];
    if (want > dc[D_TPX]) {
        thumbs_flush(dc);
        dc[D_TPX] = want;
    }
    var px : u32 = @as(u32, @intCast(dc[D_TPX]));
    if (px == 0) { px = 260; }
    const cap : u32 = thumb_cap(@as(u32, @intCast(dc[D_VIS])));
    var budget : u64 = DECODES_PER_FRAME;
    var i : u32 = 0;
    var keep : u32 = 0;
    const n : u32 = @as(u32, @intCast(dc[D_REQ_N]));
    while (i < n) {
        const wi : u32 = @as(u32, @intCast(dc[D_REQ + i]));
        i = i + 1;
        if (budget == 0) {
            dc[D_REQ + keep] = @as(u64, wi);
            keep = keep + 1;
        } else if (wi < WIDGET_COUNT and (dc[D_ST + wi] == WS_NEW or dc[D_ST + wi] == WS_LOADED) and tk_find(dc[D_KEYS .. D_KEYS + 128], CACHE_SLOTS, wi) >= CACHE_SLOTS) {
            var pb : [512]u8 = undefined;
            const pn : usize = put_card_path(hb, gal, gt, wi, pb[0..512]);
            const fd : i32 = sys_open_ro(pb[0..512], 0);
            if (fd < 0) {
                var ub : [320]u8 = undefined;
                if (put_card_url(gal, gt, wi, ub[0..320]) == 0) {
                    dc[D_ST + wi] = WS_FAILED;
                } else {
                    dc[D_ST + wi] = WS_WANT;
                }
                dc[D_GEN] = dc[D_GEN] + 1;
            } else {
                sys_close(fd);
                budget = budget - 1;
                const img : u64 = card_thumb(pb[0..512], pn, px);
                if (img == 0) {
                    dc[D_ST + wi] = WS_FAILED;
                } else {
                    const s : u32 = tk_slot(dc[D_KEYS .. D_KEYS + 128], CACHE_SLOTS, cap);
                    if (dc[D_KEYS + s] != 0) { cg_image_release(dc[D_IMGS + s]); }
                    dc[D_NEXT] = dc[D_NEXT] + 1;
                    dc[D_KEYS + s] = tk_make(wi, dc[D_NEXT]);
                    dc[D_IMGS + s] = img;
                    dc[D_ST + wi] = WS_LOADED;
                }
                dc[D_GEN] = dc[D_GEN] + 1;
            }
        }
    }
    dc[D_REQ_N] = @as(u64, keep);
}

/// A thin 1 pt frame with brighter corner brackets: the frame of every console, gauge and chip.
fn bracket_frame(c: u64, x: f64, y: f64, w: f64, h: f64, br: f64, a: f64, hot: bool) -> void {
    var k : f64 = 0.20;
    if (hot) { k = 0.55; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, k * a);
    cg_fill_rect(c, x, y, w, 1.0);
    cg_fill_rect(c, x, y + h - 1.0, w, 1.0);
    cg_fill_rect(c, x, y, 1.0, h);
    cg_fill_rect(c, x + w - 1.0, y, 1.0, h);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
    cg_fill_rect(c, x, y, br, 2.0);
    cg_fill_rect(c, x, y, 2.0, br);
    cg_fill_rect(c, x + w - br, y, br, 2.0);
    cg_fill_rect(c, x + w - 2.0, y, 2.0, br);
    cg_fill_rect(c, x, y + h - 2.0, br, 2.0);
    cg_fill_rect(c, x, y + h - br, 2.0, br);
    cg_fill_rect(c, x + w - br, y + h - 2.0, br, 2.0);
    cg_fill_rect(c, x + w - 2.0, y + h - br, 2.0, br);
}

/// An instrument's face: the card (rounded, clipped), a dark plate while it is missing, a 1 pt #2a2a2a border.
fn draw_card(c: u64, x: f64, y: f64, w: f64, h: f64, img: u64, hot: bool, full: bool, a: f64) -> void {
    plate(c, x, y, w, h, full, a);
    if (img != 0) {
        cg_save(c);
        round_rect(c, x, y, w, h, TILE_CORNER);
        cg_clip(c);
        // The card's black background drops out: screen blend over the glass, the coloured strokes stay.
        cg_blend(c, tile_image_blend(full));
        cg_alpha(c, tile_image_alpha(full) * a);
        cg_translate(c, x, y + h);
        cg_scale(c, 1.0, -1.0);
        cg_draw_image(c, 0.0, 0.0, w, h, img);
        cg_restore(c);
    }
    if (hot) {
        round_rect(c, x, y, w, h, TILE_CORNER);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
        cg_stroke_path(c);
    }
}

/// The label of widget wi: its id from the parsed gallery, "WIDGET n" while the gallery is not here yet.
fn widget_label(dc: []u64, gal: []const u8, gt: []const u32, wi: u32, out: []u8) -> usize {
    if (dc[D_GN] == 0 or wi >= WIDGET_COUNT) {
        const n : usize = put_bytes(out, 0, "WIDGET ");
        return put_dec(out, n, @as(u64, wi + 1));
    }
    const s : usize = gal_start(gt, GAL_IDS, wi);
    return put_bytes(out, 0, gal[s .. s + gal_len(gt, GAL_IDS, wi)]);
}

/// Text drawn as an outline only (the lesson number of the course): stroke mode, 1.5 pt white.
fn draw_outline(c: u64, kit: [48]u64, s: []const u8, n: usize, x: f64, base: f64, size: f64, a: f64) -> f64 {
    cg_line_width(c, 1.5);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, a);
    cg_text_mode(c, 1);
    const w : f64 = draw_fit(c, kit, s, n, x, base, size, WEIGHT_HEAVY, false, 0.0);
    cg_text_mode(c, 0);
    return w;
}

/// One gauge widget: a framed label over a mono readout.
fn draw_gauge(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, label: []const u8, v: []const u8, vn: usize, a: f64) -> void {
    bracket_frame(c, x, y, w, GAUGE_H, 4.0, a, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, label, label.len, x + 7.0, y + 10.0, 7.5, WEIGHT_SEMIBOLD, true, x + w - 4.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, v, vn, x + 7.0, y + 21.5, 11.5, WEIGHT_BOLD, true, x + w - 4.0);
}

/// What the page point (mx, my) is over (dash.t27 hit classes), HIT_NONE when nothing (also off the page); pc = pins.
fn dash_pick2(o: u32, mx: f64, my: f64, sw: f64, cx: f64, hs: u32, pc: u32) -> u32 {
    if (my < home_view_top() or mx < cx or o < 1 or o > LETTER_COUNT) { return HIT_NONE; }
    var nc : [32]u32 = undefined;
    const na : u32 = plan(o, nc[0..32]);
    nc[1] = pc;
    const lx : f64 = cx + 24.0;
    return dash_hit2(o, nc[0..32], na, sw - 24.0 - lx, mx - lx, my - (home_view_top() - @as(f64, @floatFromInt(hs))));
}

/// The widget the page point is over, NO_WIDGET when none.
fn dash_pick(o: u32, mx: f64, my: f64, sw: f64, cx: f64, hs: u32) -> u32 {
    const h : u32 = dash_pick2(o, mx, my, sw, cx, hs, 0);
    if (hit_class(h) == HC_WIDGET) { return hit_idx(h); }
    return NO_WIDGET;
}

/// The total height of home h's page for a window sw wide with the content column at cx, pc pinned tiles.
fn dash_total_p(o: u32, sw: f64, cx: f64, pc: u32) -> f64 {
    var nc : [32]u32 = undefined;
    const na : u32 = plan(o, nc[0..32]);
    nc[1] = pc;
    if (o < 1 or o > LETTER_COUNT) { return 0.0; }
    return page_h(o, nc[0..32], na, sw - 24.0 - (cx + 24.0));
}

fn dash_total(o: u32, sw: f64, cx: f64) -> f64 { return dash_total_p(o, sw, cx, 0); }

/// How many pins the page holds (pins.t27 parse of the text the window read from ~/.t27os/pins/<NN>).
fn pins_n(dc: []const u64, pb: []const u8) -> u32 {
    var po : [128]u32 = undefined;
    return pins_parse(pb[0..PB_PINS], @as(usize, dc[D_PINN]), po[0..128]);
}

/// The agents pinned to an instrument: a row of small letter boxes, the owner first (filled), then the letters
/// that feed it (outlined). Drawn on every tile; agents_of_instrument never returns 0 for the owner.
/// The agents of an instrument as one mono line "K . C . V" (owner first), written into out; returns its length.
/// Shown on hover only, under the tile title (owner, 2026-10-20: no badges on the image).
pub fn agents_text(out: []u8, l0: u32, l1: u32, l2: u32, l3: u32) -> usize {
    var n : usize = 0;
    var k : u32 = 0;
    while (k < 4) {
        var l : u32 = l0;
        if (k == 1) { l = l1; }
        if (k == 2) { l = l2; }
        if (k == 3) { l = l3; }
        if (l == 0 or l > 27) { return n; }
        if (k > 0) { n = put_bytes(out, n, " . "); }
        n = put_bytes(out, n, AGENT_LETTERS[l - 1]);
        k = k + 1;
    }
    return n;
}

fn draw_agents_line(c: u64, kit: [48]u64, x: f64, y: f64, right: f64, o: u32, t: u32, wi: u32, a: f64) -> void {
    var ab : [24]u8 = undefined;
    var n : usize = 0;
    if (wi < WIDGET_COUNT) {
        n = agents_text(ab[0..24], @as(u32, agents_of_widget(wi, 0)), @as(u32, agents_of_widget(wi, 1)), @as(u32, agents_of_widget(wi, 2)), @as(u32, agents_of_widget(wi, 3)));
    } else {
        n = agents_text(ab[0..24], agents_of_instrument(o, t, 0), agents_of_instrument(o, t, 1), agents_of_instrument(o, t, 2), agents_of_instrument(o, t, 3));
    }
    if (n == 0) { return; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, AGENTS_LINE_ALPHA * a);
    draw_fit(c, kit, ab[0..24], n, x, y, 7.5, WEIGHT_SEMIBOLD, true, right);
}

/// The CHAT / CONSOLE switch of petal C at the right end of the header.
fn draw_switch(c: u64, kit: [48]u64, label: []const u8, sw: f64, a: f64, mx: f64, my: f64) -> void {
    const hot : bool = on_switch(mx, my, sw, WS_TOP);
    round_rect(c, switch_x(sw), WS_TOP + 11.0, SWITCH_W, 22.0, 5.0);
    cg_line_width(c, 1.0);
    if (hot) {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
    } else {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.35 * a);
    }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    const w : f64 = bytes_w(kit, label, label.len, 9.5, WEIGHT_BOLD, true);
    draw_fit(c, kit, label, label.len, switch_x(sw) + 0.5 * SWITCH_W - 0.5 * w, WS_TOP + 25.5, 9.5, WEIGHT_BOLD, true, 0.0);
}

/// The live page of widget dc[D_LIVE] - 1: crumbs, a big outlined number, the title; the web view sits under it.
fn draw_live(c: u64, kit: [48]u64, dc: []u64, gal: []const u8, gt: []const u32, o: u32, a: f64, cx: f64, mx: f64, my: f64, sw: f64, sh: f64) -> void {
    const vt : f64 = home_view_top();
    const wi : u32 = @as(u32, @intCast(dc[D_LIVE] - 1));
    const lx : f64 = live_x(cx);
    var tb : [256]u8 = undefined;
    var n : usize = 0;
    if (on_live_back(mx, my, cx, vt)) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    }
    draw_fit(c, kit, "< BACK", 6, lx, vt + 24.0, 10.5, WEIGHT_SEMIBOLD, true, 0.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    n = put_bytes(tb[0..256], 0, "/  ");
    n = put_bytes(tb[0..256], n, INSTRUMENT_LABEL[o - 1]);
    n = put_bytes(tb[0..256], n, "  /  WIDGETS");
    draw_fit(c, kit, tb[0..256], n, lx + 88.0, vt + 24.0, 10.5, 0.0, true, sw - 32.0);
    // the pinned agents, in words: AGENTS: K owner . C ...
    n = put_bytes(tb[0..256], 0, "AGENTS: ");
    var ak : u32 = 0;
    while (ak < MAX_AGENTS and agents_of_widget(wi, ak) != 0) {
        const al : u32 = @as(u32, agents_of_widget(wi, ak));
        if (ak > 0) { n = put_bytes(tb[0..256], n, " . "); }
        n = put_bytes(tb[0..256], n, AGENT_LETTERS[al - 1]);
        n = put_bytes(tb[0..256], n, " ");
        n = put_bytes(tb[0..256], n, INSTRUMENT_LABEL[al - 1]);
        if (ak == 0) { n = put_bytes(tb[0..256], n, " (owner)"); }
        ak = ak + 1;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_fit(c, kit, tb[0..256], n, lx, vt + 44.0, 10.0, WEIGHT_SEMIBOLD, true, sw - 32.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    n = put_two(wi + 1, tb[0..256]);
    if (wi + 1 >= 100) { n = put_dec(tb[0..256], 0, @as(u64, wi + 1)); }
    const nw : f64 = draw_outline(c, kit, tb[0..256], n, lx, vt + 100.0, 50.0, a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    n = widget_label(dc, gal, gt, wi, tb[0..256]);
    draw_fit(c, kit, tb[0..256], n, lx + nw + 18.0, vt + 86.0, 28.0, WEIGHT_HEAVY, false, sw - 32.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    if (dc[D_GN] > 0) {
        n = put_page_url(gal, gt, wi, tb[0..256]);
        draw_fit(c, kit, tb[0..256], n, lx + nw + 18.0, vt + 102.0, 10.0, 0.0, true, sw - 32.0);
    }
    bracket_frame(c, lx, live_y(vt), live_w(sw, cx), live_h(sh, vt), 10.0, a, false);
}

// ---- the instrument panel's faces (owner, 2026-10-20): identity card, tiles, placeholders, '+', areas, ADD panel ----
// A window is matte glass, full screen is black: every plate here takes its fill from `plate` below.

pub const D_PINN : u32 = 240;
pub const D_ADDP : u32 = 241;
pub const D_ADDN : u32 = 242;
pub const D_PREN : u32 = 243;
pub const D_PINLET : u32 = 244;
// the thumbnail queue (owner, 2026-10-20): D_REQ_N waiting, ids in D_REQ.. (10 slots); sizes and counts beside it
pub const D_REQ_N : u32 = 245;
pub const D_REQ : u32 = 246;
pub const D_WANTPX : u32 = 254;
pub const D_TPX : u32 = 255;
pub const D_VIS : u32 = 238;
pub const PB_PINS : usize = 4000;
pub const PB_QUERY : usize = 4000;
pub const PB_PRE : usize = 4040;
pub const PB_SIZE : usize = 4160;
pub const PRE_MAX : u32 = 96;
pub const NOT_MEASURED : str = "not measured";

/// A tile plate: faint white on glass in a window, opaque black in full screen.
fn plate(c: u64, x: f64, y: f64, w: f64, h: f64, full: bool, a: f64) -> void {
    // Matte glass (owner, 2026-10-20): the tile body is the window's glass surface alpha, 1 pt white 0.14 border.
    cg_fill_rgba(c, 0.0, 0.0, 0.0, tile_body_alpha(full) * a);
    round_rect(c, x, y, w, h, TILE_CORNER);
    cg_fill_path(c);
    round_rect(c, x, y, w, h, TILE_CORNER);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, TILE_BORDER * a);
    cg_stroke_path(c);
}

/// A dashed 1 pt frame (the '+' tile): 6 on, 4 off.
fn dashed_frame(c: u64, x: f64, y: f64, w: f64, h: f64, k: f64) -> void {
    cg_fill_rgba(c, 1.0, 1.0, 1.0, k);
    var d : f64 = 0.0;
    while (d < w) {
        var l : f64 = 6.0;
        if (d + l > w) { l = w - d; }
        cg_fill_rect(c, x + d, y, l, 1.0);
        cg_fill_rect(c, x + d, y + h - 1.0, l, 1.0);
        d = d + 10.0;
    }
    d = 0.0;
    while (d < h) {
        var l : f64 = 6.0;
        if (d + l > h) { l = h - d; }
        cg_fill_rect(c, x, y + d, 1.0, l);
        cg_fill_rect(c, x + w - 1.0, y + d, 1.0, l);
        d = d + 10.0;
    }
}

/// A missing card: the id large, the kind under it, a subtle dot pattern (never a blank black rectangle).
fn draw_placeholder(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, id: []const u8, idn: usize, kind: []const u8, kn: usize, hot: bool, full: bool, a: f64) -> void {
    plate(c, x, y, w, h, full, a);
    cg_save(c);
    round_rect(c, x, y, w, h, TILE_CORNER);
    cg_clip(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.13 * a);
    var gy : f64 = y + 5.0;
    while (gy < y + h) {
        var gx : f64 = x + 5.0;
        while (gx < x + w) {
            cg_fill_rect(c, gx, gy, 1.2, 1.2);
            gx = gx + 9.0;
        }
        gy = gy + 9.0;
    }
    cg_restore(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, id, idn, x + 7.0, y + 0.5 * h + 3.0, 13.0, WEIGHT_HEAVY, true, x + w - 5.0);
    if (kn > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, kind, kn, x + 7.0, y + h - 8.0, 7.5, WEIGHT_SEMIBOLD, true, x + w - 5.0);
    }
    round_rect(c, x, y, w, h, TILE_CORNER);
    cg_line_width(c, 1.0);
    if (hot) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a); } else { cg_stroke_rgba(c, 1.0, 1.0, 1.0, TILE_BORDER * a); }
    cg_stroke_path(c);
}

/// The agent identity card widget (hero): a huge outlined glyph, NAME, DOMAIN as the title, ARCHETYPE / REGISTER /
/// LAYER in mono, tool + home, and the lamp (identity_table.t27, mirrored from specs/agents/<l>.t27).
fn draw_identity(c: u64, kit: [48]u64, o: u32, h: u32, x: f64, y: f64, w: f64, a: f64) -> void {
    bracket_frame(c, x, y, w, ID_H, 10.0, a, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    const gw : f64 = draw_outline(c, kit, AGENT_LETTERS[o - 1], AGENT_LETTERS[o - 1].len, x + 16.0, y + ID_H - 20.0, GLYPH_PT, a);
    const tx : f64 = x + 16.0 + gw + 26.0;
    const right : f64 = x + w - 12.0;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, name_of(o), name_of(o).len, tx, y + 44.0, 34.0, WEIGHT_HEAVY, false, right);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.92 * a);
    draw_fit(c, kit, domain_of(o), domain_of(o).len, tx, y + 66.0, 15.0, WEIGHT_SEMIBOLD, false, right);
    var k : u32 = 0;
    while (k < 5) {
        var lb : []const u8 = "ARCHETYPE";
        var vl : []const u8 = archetype_of(o);
        if (k == 1) { lb = "REGISTER"; vl = register_of(o); }
        if (k == 2) { lb = "LAYER"; vl = id_layer_of(o); }
        if (k == 3) { lb = "TOOL"; vl = HOME_IDS[h]; }
        if (k == 4) { lb = "HOME"; vl = HOME_NAMES[h]; }
        const ry : f64 = y + 92.0 + @as(f64, @floatFromInt(k)) * 15.0;
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, lb, lb.len, tx, ry, 8.0, WEIGHT_SEMIBOLD, true, tx + 78.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_fit(c, kit, vl, vl.len, tx + 84.0, ry, 9.5, 0.0, true, right);
        k = k + 1;
    }
    // the lamp: a ring (no measurement yet), the words say so
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.5 * a);
    cg_line_width(c, 1.0);
    round_rect(c, tx, y + ID_H - 20.0, 8.0, 8.0, 4.0);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, "LAMP  not measured (the host feeds git log)", 43, tx + 14.0, y + ID_H - 13.0, 8.5, WEIGHT_SEMIBOLD, true, right);
}

/// The agents dialog block of letter C: 2 columns x 2 rows, the nine agents of the dialog, one tap opens it.
fn draw_chat_block(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, hot: bool, full: bool, a: f64) -> void {
    plate(c, x, y, w, h, full, a);
    bracket_frame(c, x, y, w, h, 10.0, a, hot);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, "AGENTS", 6, x + 14.0, y + 34.0, 26.0, WEIGHT_HEAVY, false, x + w - 10.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, "THE DIALOG WITH THE CODING AGENTS", 33, x + 14.0, y + 52.0, 8.5, WEIGHT_SEMIBOLD, true, x + w - 10.0);
    var nm : [32]u8 = undefined;
    var i : u32 = 0;
    while (i < 9) {
        const cx : f64 = x + 14.0 + @as(f64, @floatFromInt(i % 3)) * (0.33 * (w - 20.0));
        const cy : f64 = y + 80.0 + @as(f64, @floatFromInt(i / 3)) * 24.0;
        if (cy + 14.0 < y + h - 26.0) {
            const n : usize = csv_field(AGENT_NAMES, i, nm[0..32]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_fit(c, kit, nm[0..32], n, cx, cy, 10.5, WEIGHT_SEMIBOLD, true, cx + 0.33 * (w - 20.0) - 6.0);
        }
        i = i + 1;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_fit(c, kit, "TAP TO OPEN  /  Cmd+Enter at home", 33, x + 14.0, y + h - 12.0, 8.5, WEIGHT_SEMIBOLD, true, x + w - 10.0);
}

/// The '+' tile: a dashed frame, a large '+', ADD WIDGET.
fn draw_plus(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, hot: bool, a: f64) -> void {
    var k : f64 = 0.35;
    if (hot) { k = 0.9; }
    dashed_frame(c, x, y, w, h, k * a);
    const mx : f64 = x + 0.5 * w;
    const my : f64 = y + 0.5 * h - 6.0;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, (0.35 + 0.6 * k) * a);
    cg_fill_rect(c, mx - 14.0, my - 1.0, 28.0, 2.0);
    cg_fill_rect(c, mx - 1.0, my - 14.0, 2.0, 28.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    const tw : f64 = bytes_w(kit, "ADD WIDGET", 10, 8.5, WEIGHT_SEMIBOLD, true);
    draw_fit(c, kit, "ADD WIDGET", 10, mx - 0.5 * tw, y + h - 10.0, 8.5, WEIGHT_SEMIBOLD, true, 0.0);
}

/// One small widget of a sidebar area: a framed cell, a mono label and an optional second line.
fn draw_area_cell(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, l1: []const u8, n1: usize, l2: []const u8, n2: usize, hot: bool, dim: bool, full: bool, a: f64) -> void {
    plate(c, x, y, w, AREA_ROW, full, a);
    bracket_frame(c, x, y, w, AREA_ROW, 5.0, a, hot);
    var ink : f64 = TEXT_WHITE;
    if (dim) { ink = MUTED_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ink * a);
    if (n2 > 0) {
        draw_fit(c, kit, l1, n1, x + 8.0, y + 16.0, 9.5, WEIGHT_SEMIBOLD, true, x + w - 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, l2, n2, x + 8.0, y + 31.0, 8.5, 0.0, true, x + w - 6.0);
    } else {
        draw_fit(c, kit, l1, n1, x + 8.0, y + 25.0, 10.0, WEIGHT_SEMIBOLD, true, x + w - 6.0);
    }
}

/// The areas under the console: SPECS, COMMANDS, SKILLS, PULSE, HOME (dash.t27 N5b), each a grid of small widgets.
fn draw_areas(c: u64, kit: [48]u64, o: u32, nc: []const u32, na: u32, pw: f64, lx: f64, y0: f64, vt: f64, sh: f64, hov_h: u32, full: bool, a: f64) -> void {
    var tb : [160]u8 = undefined;
    var k : u32 = SEC_SPECS;
    while (k < SEC_COUNT) {
        const top : f64 = y0 + area_top(k, o, nc, na, pw);
        const ah : f64 = area_h(k, o, pw);
        if (top + ah >= vt and top <= sh) {
            bracket_frame(c, lx, top, pw, ah, 10.0, a, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
            const hw : f64 = draw_fit(c, kit, SEC_NAMES[k], SEC_NAMES[k].len, lx + 12.0, top + 19.0, 13.0, WEIGHT_HEAVY, true, 0.0);
            var hn : usize = 0;
            if (k == SEC_SPECS) { hn = put_bytes(tb[0..160], 0, "census pending: the spec count is not measured yet"); }
            if (k == SEC_COMMANDS) { hn = put_bytes(tb[0..160], 0, "tri commands and MCP tools of the agent"); }
            if (k == SEC_SKILLS) { hn = put_bytes(tb[0..160], 0, "skills the agent holds"); }
            if (k == SEC_PULSE) { hn = put_bytes(tb[0..160], 0, "domain pulse: not measured until the host feeds git log"); }
            if (k == SEC_HOME) { hn = put_bytes(tb[0..160], 0, "the other letters of this home"); }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
            draw_fit(c, kit, tb[0..160], hn, lx + 12.0 + hw + 12.0, top + 18.0, 8.5, 0.0, true, lx + pw - 10.0);
            var i : u32 = 0;
            while (i < area_n(k, o)) {
                const ix : f64 = lx + area_ix(i, pw);
                const iy : f64 = top + area_iy(i, pw);
                const hot : bool = hov_h == hit_pack(HC_AREA, k * 256 + i);
                var n1 : usize = 0;
                var n2 : usize = 0;
                var l2 : [160]u8 = undefined;
                var dim : bool = false;
                if (k == SEC_SPECS) {
                    if (i == 0) {
                        n1 = put_bytes(tb[0..160], 0, "SPECS");
                        n2 = put_bytes(l2[0..160], 0, "census pending");
                    } else {
                        n1 = put_bytes(tb[0..160], 0, key_at(o, i - 1));
                        n2 = put_bytes(l2[0..160], 0, "key path");
                    }
                }
                if (k == SEC_COMMANDS) {
                    if (tool_n(o) == 0) {
                        n1 = put_bytes(tb[0..160], 0, "NO COMMANDS BOUND");
                        dim = true;
                    } else {
                        n1 = put_bytes(tb[0..160], 0, tool_at(o, i));
                        n2 = put_bytes(l2[0..160], 0, "press to run in C");
                    }
                }
                if (k == SEC_SKILLS) {
                    if (skill_n(o) == 0) {
                        n1 = put_bytes(tb[0..160], 0, "NO SKILLS BOUND");
                        dim = true;
                    } else {
                        n1 = put_bytes(tb[0..160], 0, skill_at(o, i));
                        n2 = put_bytes(l2[0..160], 0, "skill");
                    }
                }
                if (k == SEC_PULSE) {
                    if (i == 0) { n1 = put_bytes(tb[0..160], 0, "LAMP"); }
                    if (i == 1) { n1 = put_bytes(tb[0..160], 0, "LAST ACTIVITY"); }
                    if (i == 2) { n1 = put_bytes(tb[0..160], 0, "COMMITS 24H / 7D"); }
                    if (i == 3) { n1 = put_bytes(tb[0..160], 0, "7-DAY PULSE"); }
                    n2 = put_bytes(l2[0..160], 0, NOT_MEASURED);
                }
                if (k == SEC_HOME) {
                    const hl : u32 = home_other(o, i);
                    if (hl == 0) {
                        n1 = put_bytes(tb[0..160], 0, "NO OTHER LETTER");
                        dim = true;
                    } else {
                        n1 = put_bytes(tb[0..160], 0, AGENT_LETTERS[hl - 1]);
                        n1 = put_bytes(tb[0..160], n1, "  ");
                        n1 = put_bytes(tb[0..160], n1, name_of(hl));
                        n2 = put_bytes(l2[0..160], 0, INSTRUMENT_LABEL[hl - 1]);
                    }
                }
                if (iy + AREA_ROW >= vt and iy <= sh) {
                    draw_area_cell(c, kit, ix, iy, area_iw(pw), tb[0..160], n1, l2[0..160], n2, hot, dim, full, a);
                    if (k == SEC_PULSE and i == 3) {
                        // seven empty day bars: the sparkline waits for data
                        var d : u32 = 0;
                        while (d < 7) {
                            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.18 * a);
                            cg_fill_rect(c, ix + area_iw(pw) - 62.0 + @as(f64, @floatFromInt(d)) * 8.0, iy + 28.0, 5.0, 3.0);
                            d = d + 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
}

/// The ADD WIDGET panel over the page view (pins.t27 geometry): PIN FROM GALLERY with a search field and the grid of
/// matching gallery ids, CREATE NEW at the right. (cx, vt) is the view's corner, (vw, vh) its size.
fn draw_add_panel(c: u64, kit: [48]u64, dc: []u64, gal: []const u8, gt: []const u32, pb: []const u8, cx: f64, vt: f64, vw: f64, vh: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.40 * a);
    cg_fill_rect(c, cx, vt, vw, vh);
    const px : f64 = cx + ap_x(vw);
    const py : f64 = vt + ap_y(vh);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, surface_alpha(SURF_PANEL, full) * a);
    round_rect(c, px, py, ap_w(vw), ap_h(vh), 10.0);
    cg_fill_path(c);
    bracket_frame(c, px, py, ap_w(vw), ap_h(vh), 10.0, a, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, "ADD WIDGET", 10, px + AP_PAD, py + 26.0, 15.0, WEIGHT_HEAVY, true, px + 300.0);
    const hotx : bool = ap_hit(vw, vh, mx - cx, my - vt, 0) == AP_CLOSE;
    var kx : f64 = 0.55;
    if (hotx) { kx = 1.0; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, kx * a);
    draw_fit(c, kit, "x", 1, px + ap_w(vw) - 26.0, py + 26.0, 15.0, WEIGHT_SEMIBOLD, true, 0.0);
    // PIN FROM GALLERY
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, "PIN FROM GALLERY  (type to filter by id, tap to pin)", 51, px + AP_PAD, py + AP_HEAD - 4.0, 8.5, WEIGHT_SEMIBOLD, true, px + ap_left_w(vw));
    const sy : f64 = vt + ap_search_y(vh);
    bracket_frame(c, px + AP_PAD, sy, ap_left_w(vw) - 2.0 * AP_PAD, AP_SEARCH_H, 5.0, a, false);
    const qn : u32 = @as(u32, @intCast(dc[D_ADDN]));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    var qw : f64 = 0.0;
    if (qn > 0) {
        qw = draw_fit(c, kit, pb[PB_QUERY .. PB_QUERY + 32], @as(usize, qn), px + AP_PAD + 10.0, sy + 20.0, 12.0, WEIGHT_SEMIBOLD, true, px + ap_left_w(vw) - 20.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, "search the gallery", 18, px + AP_PAD + 10.0, sy + 20.0, 11.0, 0.0, true, px + ap_left_w(vw) - 20.0);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    cg_fill_rect(c, px + AP_PAD + 12.0 + qw, sy + 7.0, 1.5, 16.0);
    // the grid
    const total : u32 = gal_total(gt);
    const nm : u32 = match_count(gal, gt, total, pb[PB_QUERY .. PB_QUERY + 32], qn);
    var shown : u32 = nm;
    if (shown > ap_cap(vw, vh)) { shown = ap_cap(vw, vh); }
    var po : [128]u32 = undefined;
    const pc : u32 = pins_parse(pb[0..PB_PINS], @as(usize, dc[D_PINN]), po[0..128]);
    var i : u32 = 0;
    while (i < shown) {
        const row : u32 = nth_match(gal, gt, total, pb[PB_QUERY .. PB_QUERY + 32], qn, i);
        const gx : f64 = cx + ap_cell_x(i, vw);
        const gy : f64 = vt + ap_cell_y(i, vw, vh);
        const st : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + row) * 2]);
        const ln : usize = @as(usize, gt[(GAL_IDS * GAL_CAP + row) * 2 + 1]);
        const pinned : bool = pin_index(pb[0..PB_PINS], po[0..128], pc, gal[st .. st + ln]) != PIN_NONE;
        const hot : bool = ap_hit(vw, vh, mx - cx, my - vt, shown) == AP_CELL + i;
        plate(c, gx, gy, AP_CELL_W, AP_CELL_H, full, a);
        bracket_frame(c, gx, gy, AP_CELL_W, AP_CELL_H, 4.0, a, hot);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        if (pinned) { cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a); }
        draw_fit(c, kit, gal[st .. st + ln], ln, gx + 7.0, gy + 17.0, 9.5, 0.0, true, gx + AP_CELL_W - 18.0);
        if (pinned) { draw_fit(c, kit, "ok", 2, gx + AP_CELL_W - 17.0, gy + 17.0, 8.5, WEIGHT_BOLD, true, 0.0); }
        i = i + 1;
    }
    if (nm > shown) {
        var tb : [48]u8 = undefined;
        var tn : usize = put_dec(tb[0..48], 0, @as(u64, nm - shown));
        tn = put_bytes(tb[0..48], tn, " more: type to narrow");
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, tb[0..48], tn, px + AP_PAD, py + ap_h(vh) - 6.0, 8.5, 0.0, true, px + ap_left_w(vw));
    }
    if (nm == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, "no gallery widget matches", 25, px + AP_PAD, vt + ap_grid_y(vh) + 14.0, 10.0, 0.0, true, px + ap_left_w(vw));
    }
    // CREATE NEW
    const rx : f64 = cx + ap_create_x(vw);
    const ry : f64 = vt + ap_create_y(vh);
    const hotc : bool = ap_hit(vw, vh, mx - cx, my - vt, shown) == AP_CREATE;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, "CREATE NEW", 10, rx, ry - 4.0, 8.5, WEIGHT_SEMIBOLD, true, rx + ap_create_w());
    plate(c, rx, ry, ap_create_w(), ap_create_h(), full, a);
    bracket_frame(c, rx, ry, ap_create_w(), ap_create_h(), 6.0, a, hotc);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
    draw_fit(c, kit, "NEW WIDGET", 10, rx + 12.0, ry + 26.0, 13.0, WEIGHT_HEAVY, true, rx + ap_create_w() - 8.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_fit(c, kit, "opens the agents dialog with the", 32, rx + 12.0, ry + 42.0, 8.0, 0.0, true, rx + ap_create_w() - 6.0);
    draw_fit(c, kit, "line typed: the widget factory", 30, rx + 12.0, ry + 54.0, 8.0, 0.0, true, rx + ap_create_w() - 6.0);
}

/// H. The screen of a petal that is not the CHAT petal (t27 OS: black and white, shape and text only), in the
/// style of the chat: the 272 pt sidebar lists the homes (the open one lit, a tap switches to it) over the
/// chat's foot; the content has the 44 pt header and the sidebar toggle, then a page that scrolls: a big heavy
/// title, a larger muted lead, the law and the runner, and under bold headings EVERY agent, EVERY widget group
/// and (t27u) EVERY course of the home (homes.t27 L7). A petal that is no home shows the header only.
fn draw_home(c: u64, kit: [48]u64, p: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, sh: f64, ws: u32, hs: u32, dlabel: u64, dlit: bool, full: bool, dc: []u64, gal: []const u8, gt: []const u32, pb: []const u8, tgw: []const u64, tbw: []const u8) -> void {
    const o : u32 = letter_of_petal(p);
    const h : u32 = home_of_letter(o);
    const hws : u32 = home_ws(ws);
    const cx : f64 = content_x(hws, collapsed);
    var tb : [256]u8 = undefined;
    if (hws == WS_EXPANDED and collapsed == false) {
        // the sidebar: ONLY this letter's sections (a row scrolls the page to it), its home at the foot
        draw_side_frame(c, a, sh, full);
        var hv : u32 = SEC_NONE;
        if (a >= 1.0) { hv = sec_at(mx, my, WS_TOP); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, AGENT_LETTERS[o - 1], AGENT_LETTERS[o - 1].len, 18.0, WS_TOP + 18.0, 9.5, WEIGHT_SEMIBOLD, true, 0.0);
        var sk : u32 = 0;
        while (sk < SEC_COUNT) {
            const ry : f64 = sec_row_y(sk, WS_TOP);
            if (sk == hv) {
                round_rect(c, 8.0, ry, SIDE_W - 16.0, SEC_H - 4.0, 5.0);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.09 * a);
                cg_fill_path(c);
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_fit(c, kit, SEC_NAMES[sk], SEC_NAMES[sk].len, 18.0, ry + 17.0, 10.5, WEIGHT_SEMIBOLD, true, SIDE_W - 60.0);
            var sn : usize = 0;
            if (sk == SEC_INSTRUMENTS) { sn = put_dec(tb[0..256], 0, @as(u64, widgets_of_letter(o))); }
            if (sk == SEC_SURFACES) { sn = put_dec(tb[0..256], 0, @as(u64, surfaces_of_letter(o))); }
            if (sn > 0) {
                const snw : f64 = bytes_w(kit, tb[0..256], sn, 9.0, 0.0, true);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
                draw_fit(c, kit, tb[0..256], sn, SIDE_W - 18.0 - snw, ry + 17.0, 9.0, 0.0, true, 0.0);
            }
            sk = sk + 1;
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, HOME_IDS[h], HOME_IDS[h].len, 18.0, sh - FOOT_H - 26.0, 9.5, WEIGHT_SEMIBOLD, true, SIDE_W - 30.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_fit(c, kit, HOME_NAMES[h], HOME_NAMES[h].len, 18.0, sh - FOOT_H - 11.0, 9.0, 0.0, true, SIDE_W - 30.0);
        draw_side_foot(c, kit, a, mx, my, sh, hws, collapsed, dlabel, dlit, full);
    }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, surface_alpha(SURF_CONTENT, full) * a);
    cg_fill_rect(c, cx, WS_TOP, sw - cx, sh - WS_TOP);
    var tx : f64 = 14.0;
    if (hws == WS_EXPANDED) {
        draw_side_toggle(c, a, cx, on_side_toggle(mx, my, hws, collapsed));
        tx = cx + 14.0 + TOGGLE_PT + 12.0;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_text(c, kit, world(kit, p), tx, WS_TOP + 0.5 * HEADER_H + 4.2, 12.0, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, cx, WS_TOP + HEADER_H, sw - cx, HAIR);
    if (o < 1 or o > LETTER_COUNT) { return; }
    if (p == PETAL_CHAT) { draw_switch(c, kit, "< CHAT", sw, a, mx, my); }
    // a letter with a built tool page shows it in place of the dashboard (and a switch to go to the dashboard and back)
    const pgk : u32 = page_kind(o);
    if (pgk != PAGE_NONE and p != PETAL_CHAT) {
        if (tgw[TPG_DASH] == 0 and dc[D_LIVE] == 0) {
            cg_save(c);
            cg_clip_rect(c, cx, home_view_top(), sw - cx, home_view_h(sh));
            draw_tool_page(c, kit, pgk, tgw, tbw, cx, sw, sh, mx, my, full, a);
            cg_restore(c);
            draw_switch(c, kit, "DASHBOARD >", sw, a, mx, my);
            return;
        }
        if (dc[D_LIVE] == 0) { draw_switch(c, kit, "< PAGE", sw, a, mx, my); }
    }
    const vt : f64 = home_view_top();
    const vh : f64 = home_view_h(sh);
    const y0 : f64 = vt - @as(f64, @floatFromInt(hs));
    const lx : f64 = cx + 24.0;
    const rx : f64 = sw - 24.0;
    const pw : f64 = rx - lx;
    cg_save(c);
    cg_clip_rect(c, cx, vt, sw - cx, vh);
    if (dc[D_LIVE] != 0) {
        draw_live(c, kit, dc, gal, gt, o, a, cx, mx, my, sw, sh);
        cg_restore(c);
        return;
    }
    var hb : [256]u8 = undefined;
    const hn : usize = ns_bytes(home_dir(), hb[0..256]);
    var nc : [32]u32 = undefined;
    const na : u32 = plan(o, nc[0..32]);
    var po : [128]u32 = undefined;
    const pc : u32 = pins_parse(pb[0..PB_PINS], @as(usize, dc[D_PINN]), po[0..128]);
    nc[1] = pc;
    var hov_h : u32 = HIT_NONE;
    if (a >= 1.0 and my >= vt and mx >= cx and dc[D_ADDP] == 0) { hov_h = dash_hit2(o, nc[0..32], na, pw, mx - lx, my - y0); }
    const hov_w : u32 = hov_h;
    // HERO: the kicker, the agent identity card (huge glyph, name, domain, archetype, register, layer), four small gauges, the segment bar
    const nseg : u32 = seg_count(o);
    var loaded : u32 = 0;
    var sg : u32 = 0;
    while (sg < nseg) {
        const sw0 : u32 = seg_widget(o, sg);
        if (sw0 < WIDGET_COUNT and dc[D_ST + sw0] == WS_LOADED) { loaded = loaded + 1; }
        sg = sg + 1;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    var n : usize = put_bytes(tb[0..256], 0, "LETTER ");
    n = put_dec(tb[0..256], n, @as(u64, o));
    n = put_bytes(tb[0..256], n, " OF 27  //  REALM ");
    n = put_dec(tb[0..256], n, @as(u64, (o - 1) / 9 + 1));
    n = put_bytes(tb[0..256], n, "  //  ");
    n = put_bytes(tb[0..256], n, HOME_NAMES[h]);
    draw_fit(c, kit, tb[0..256], n, lx, y0 + 18.0, 9.0, WEIGHT_SEMIBOLD, true, rx);
    var cardw : f64 = pw;
    if (gauge_below(pw) == false) { cardw = pw - GAUGE_AREA - 14.0; }
    draw_identity(c, kit, o, h, lx, y0 + band_top(), cardw, a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.92 * a);
    draw_fit(c, kit, HOME_ROLES[h], HOME_ROLES[h].len, lx, y0 + band_top() + band_h(o, pw) + 15.0, 14.0, WEIGHT_MEDIUM, false, rx);
    var g2 : u32 = 0;
    while (g2 < 4) {
        var vn : usize = 0;
        if (g2 == 0) { vn = put_bytes(tb[0..256], 0, HOME_IDS[h]); }
        if (g2 == 1) { vn = put_dec(tb[0..256], 0, @as(u64, widgets_of_letter(o))); }
        if (g2 == 2) { vn = put_dec(tb[0..256], 0, @as(u64, surfaces_of_letter(o))); }
        if (g2 == 3) { vn = put_ratio(loaded, nseg, tb[0..256]); }
        draw_gauge(c, kit, lx + gauge_x(g2, pw), y0 + gauge_y(g2, o, pw), gauge_w(pw), GAUGE_NAMES[g2], tb[0..256], vn, a);
        g2 = g2 + 1;
    }
    const scols : u32 = seg_cols(nseg, pw);
    sg = 0;
    while (sg < nseg) {
        const sx : f64 = lx + @as(f64, @floatFromInt(sg % scols)) * (SEG + SEG_GAP);
        const sy : f64 = y0 + bar_top(o, pw) + @as(f64, @floatFromInt(sg / scols)) * (SEG + SEG_GAP);
        const sw1 : u32 = seg_widget(o, sg);
        if (sw1 < WIDGET_COUNT and dc[D_ST + sw1] == WS_LOADED) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.92 * a);
        } else {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.10 * a);
        }
        cg_fill_rect(c, sx, sy, SEG, SEG);
        sg = sg + 1;
    }
    // THE CONSOLE: the agents block (letter C), this letter's instruments (cards or placeholders), its pins, the '+' tile
    if (pc < 1000) {
        const cnt : u32 = nc[0] + pc;
        const top : f64 = y0 + con_top(o, nc[0..32], na, pw, 0);
        const ch : f64 = con_h(con_cells(o, cnt, pw), pw);
        if (top + ch >= vt and top <= sh) {
            bracket_frame(c, lx, top, pw, ch, 10.0, a, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
            const lw : f64 = draw_fit(c, kit, AGENT_LETTERS[o - 1], AGENT_LETTERS[o - 1].len, lx + 12.0, top + 18.0, 17.0, WEIGHT_HEAVY, true, 0.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            n = agent_domain(o, tb[0..256]);
            draw_fit(c, kit, tb[0..256], n, lx + 12.0 + lw + 10.0, top + 16.0, 11.0, WEIGHT_SEMIBOLD, true, rx - 150.0);
            n = put_readout(cnt, tb[0..256]);
            const rw : f64 = bytes_w(kit, tb[0..256], n, 9.0, 0.0, true);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
            draw_fit(c, kit, tb[0..256], n, rx - 12.0 - rw, top + 16.0, 9.0, 0.0, true, 0.0);
            if (big_cols(o, pw) > 0) {
                draw_chat_block(c, kit, lx + CPAD, top + CON_HEAD, big_w(o, pw), big_h(pw), hov_h == hit_pack(HC_CHAT, 0), full, a);
            }
            var t : u32 = 0;
            var near : u64 = 0;
            dc[D_WANTPX] = @as(u64, thumb_px(tile_w(pw), THUMB_SCALE));
            while (t <= cnt) {
                const tx2 : f64 = lx + tile_rx(o, t, pw);
                const ty : f64 = top + tile_ry(o, t, pw);
                // virtual grid: only a tile that meets the view is drawn; one within a row of it is only queued
                const in_view : bool = rect_visible(ty, cell_h(pw), vt, sh, 0.0);
                if (in_view == false and t < cnt and rect_visible(ty, cell_h(pw), vt, sh, cell_h(pw) + GAP)) {
                    near = near + 1;
                    const ncode : u32 = tile_code(o, t);
                    if (hit_class(ncode) == HC_WIDGET) {
                        const nwi : u32 = hit_idx(ncode);
                        if (dc[D_GN] > 0 and nwi < WIDGET_COUNT and (dc[D_ST + nwi] == WS_NEW or dc[D_ST + nwi] == WS_LOADED) and tk_find(dc[D_KEYS .. D_KEYS + 128], CACHE_SLOTS, nwi) >= CACHE_SLOTS) { card_ask(dc, nwi, REQ_AHEAD); }
                    }
                }
                if (in_view) {
                    near = near + 1;
                    if (t == cnt) {
                        draw_plus(c, kit, tx2, ty, tile_w(pw), tile_h(pw), hov_h == hit_pack(HC_PLUS, 0), a);
                    } else {
                        const code : u32 = tile_code(o, t);
                        const pk : u32 = hit_pack(HC_PIN, hit_idx(code));
                        var hot : bool = hov_h == code;
                        if (hit_class(code) == HC_PIN) { hot = hov_h == code or hov_h == hit_pack(HC_UNPIN, hit_idx(code)); }
                        var wi : u32 = WIDGET_COUNT;
                        var idn : usize = 0;
                        var kn : usize = 0;
                        var kb : [64]u8 = undefined;
                        var ib : [64]u8 = undefined;
                        if (hit_class(code) == HC_WIDGET) {
                            wi = hit_idx(code);
                            idn = widget_label(dc, gal, gt, wi, ib[0..64]);
                        }
                        if (hit_class(code) == HC_SURFACE) {
                            const sf : u32 = hit_idx(code);
                            idn = put_bytes(ib[0..64], 0, SURFACE_IDS[sf]);
                            kn = put_bytes(kb[0..64], 0, "APP SURFACE  ");
                            kn = put_bytes(kb[0..64], kn, SURFACE_KINDS[sf]);
                        }
                        if (hit_class(code) == HC_PIN) {
                            const pk2 : u32 = hit_idx(code);
                            const ps : usize = @as(usize, po[pk2 * 2]);
                            const pl : usize = @as(usize, po[pk2 * 2 + 1]);
                            idn = put_bytes(ib[0..64], 0, pb[ps .. ps + pl]);
                            wi = widget_of_id(pb[ps .. ps + pl]);
                            if (dc[D_GN] > 0) {
                                const rowp : u32 = row_of_id(gal, gt, gal_total(gt), pb[ps .. ps + pl]);
                                if (rowp != PIN_NONE) {
                                    const ks : usize = @as(usize, gt[(GAL_KINDS * GAL_CAP + rowp) * 2]);
                                    const kl : usize = @as(usize, gt[(GAL_KINDS * GAL_CAP + rowp) * 2 + 1]);
                                    kn = put_bytes(kb[0..64], 0, gal[ks .. ks + kl]);
                                }
                            }
                        }
                        var img : u64 = 0;
                        if (wi < WIDGET_COUNT) { img = card_img(dc, gal, gt, hb[0..hn], wi); }
                        if (img != 0) {
                            draw_card(c, tx2, ty, tile_w(pw), tile_h(pw), img, hot, full, a);
                        } else {
                            draw_placeholder(c, kit, tx2, ty, tile_w(pw), tile_h(pw), ib[0..64], idn, kb[0..64], kn, hot, full, a);
                        }
                        if (hot) {
                            cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
                        } else {
                            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.72 * a);
                        }
                        draw_fit(c, kit, ib[0..64], idn, tx2, ty + tile_h(pw) + 11.0, 9.0, 0.0, true, tx2 + tile_w(pw));
                        if (hot) {
                            draw_agents_line(c, kit, tx2, ty + tile_h(pw) + 20.0, tx2 + tile_w(pw), o, t, wi, a);
                        }
                        if (hit_class(code) == HC_PIN and hot) {
                            // the unpin x, shown on hover
                            const ux : f64 = tx2 + tile_w(pw) - UNPIN_W;
                            cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.7 * a);
                            cg_fill_rect(c, ux, ty, UNPIN_W, UNPIN_W);
                            cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
                            draw_fit(c, kit, "x", 1, ux + 4.5, ty + 12.0, 11.0, WEIGHT_BOLD, true, 0.0);
                        }
                    }
                }
                t = t + 1;
            }
            dc[D_VIS] = near;
        }
    }
    // COURSE MAPS: the letters whose home is t27u carry the 7 courses, rows of 9 modules, three lessons each
    if (h == H_T27U) {
        const ctop : f64 = y0 + courses_top(o, nc[0..32], na, pw);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
        draw_fit(c, kit, "COURSE MAPS", 11, lx, ctop + 20.0, 13.0, WEIGHT_HEAVY, true, 0.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_fit(c, kit, "7 COURSES / 9 MODULES / 3 LESSONS", 33, lx + 130.0, ctop + 20.0, 9.0, 0.0, true, rx);
        var cc : u32 = 0;
        while (cc < COURSE_COUNT) {
            const mtop : f64 = y0 + cm_top(o, nc[0..32], na, pw, cc);
            if (mtop + cm_h() >= vt and mtop <= sh) {
                bracket_frame(c, lx, mtop, pw, cm_h(), 10.0, a, false);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
                n = put_bytes(tb[0..256], 0, "COURSE ");
                n = put_dec(tb[0..256], n, @as(u64, cc + 1));
                n = put_bytes(tb[0..256], n, "  ");
                n = put_bytes(tb[0..256], n, COURSE_IDS[cc]);
                draw_fit(c, kit, tb[0..256], n, lx + 12.0, mtop + 17.0, 10.5, WEIGHT_SEMIBOLD, true, rx - 100.0);
                var m : u32 = 0;
                while (m < MODULES) {
                    const ry : f64 = mtop + cm_row_y(m);
                    if (ry + 30.0 >= vt and ry <= sh) {
                        n = put_two(m + 1, tb[0..256]);
                        draw_outline(c, kit, tb[0..256], n, lx + CPAD + 2.0, ry + 24.0, 24.0, a);
                        var l : u32 = 0;
                        while (l < DASH_LESSONS_PER_MODULE) {
                            const lwi : u32 = course_widget(cc, m * DASH_LESSONS_PER_MODULE + l);
                            const lcw : f64 = cell_w(cm_lessons_w(pw), DASH_LESSONS_PER_MODULE, GAP);
                            const lcx : f64 = lx + cm_lessons_x() + dash_cell_x(l, cm_lessons_w(pw), DASH_LESSONS_PER_MODULE, GAP);
                            const hot : bool = lwi == hov_w and lwi < WIDGET_COUNT;
                            round_rect(c, lcx, ry, lcw, 30.0, 4.0);
                            cg_line_width(c, 1.0);
                            if (hot) {
                                cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
                            } else {
                                cg_stroke_rgba(c, 0.165, 0.165, 0.165, a);
                            }
                            cg_stroke_path(c);
                            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
                            n = put_dec(tb[0..256], 0, @as(u64, m * DASH_LESSONS_PER_MODULE + l + 1));
                            draw_fit(c, kit, tb[0..256], n, lcx + 6.0, ry + 11.0, 7.5, 0.0, true, 0.0);
                            if (lwi < WIDGET_COUNT) {
                                const ow : u32 = @as(u32, agents_of_widget(lwi, 0));
                                if (ow > 0) {
                                    draw_fit(c, kit, AGENT_LETTERS[ow - 1], AGENT_LETTERS[ow - 1].len, lcx + lcw - 18.0, ry + 11.0, 7.5, WEIGHT_BOLD, true, 0.0);
                                }
                            }
                            if (hot) {
                                cg_fill_rgba(c, 1.0, 1.0, 1.0, a);
                            } else {
                                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.8 * a);
                            }
                            n = widget_label(dc, gal, gt, lwi, tb[0..256]);
                            draw_fit(c, kit, tb[0..256], n, lcx + 6.0, ry + 23.0, 9.5, 0.0, true, lcx + lcw - 6.0);
                            l = l + 1;
                        }
                    }
                    m = m + 1;
                }
            }
            cc = cc + 1;
        }
    }
    draw_areas(c, kit, o, nc[0..32], na, pw, lx, y0, vt, sh, hov_h, full, a);
    // the scrollbar: a faint line with a brighter thumb, only when the page is taller than the view
    const total : f64 = page_h(o, nc[0..32], na, pw);
    const smax : u32 = dash_scroll_max(total, vh);
    if (smax > 0) {
        const th : f64 = thumb_h(vh, total);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
        cg_fill_rect(c, sw - 8.0, vt + 4.0, 2.0, vh - 8.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_fill_rect(c, sw - 8.0, vt + thumb_y(hs, smax, vh, th), 2.0, th);
    }
    if (dc[D_ADDP] != 0) { draw_add_panel(c, kit, dc, gal, gt, pb, cx, vt, sw - cx, vh, mx, my, full, a); }
    cg_restore(c);
}

/// A lamp: a small disc, lit when the letter has parts, a ring when it has none.
fn n_lamp(c: u64, x: f64, y: f64, lit: bool, a: f64) -> void {
    if (lit) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        round_rect(c, x - 2.0, y - 2.0, 4.0, 4.0, 2.0);
        cg_fill_path(c);
    } else {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.35 * a);
        cg_line_width(c, 0.8);
        round_rect(c, x - 2.0, y - 2.0, 4.0, 4.0, 2.0);
        cg_stroke_path(c);
    }
}

/// F. The frame's fill alpha: clear in a window (matte black glass, the blur and the layer tint show
/// through), opaque black #000000 in full screen (no transparency there).
pub fn backdrop_alpha(full: bool) -> f64 {
    if (full) { return BACK_BLACK; }
    return BACK_GLASS;
}

/// F. A fill that is not opaque must first wipe the bitmap, or the last frame's pixels stay under it.
pub fn backdrop_clears(full: bool) -> bool {
    return backdrop_alpha(full) < 1.0;
}

/// F. The alpha of the layer's background colour: the window tint, or opaque black in full screen.
pub fn tint_alpha(full: bool) -> f64 {
    if (full) { return TINT_FULL; }
    return TINT_BLACK;
}

/// F. The layer's background colour is set again only when the full-screen state changes.
pub fn tint_swap(full: bool, was_full: bool) -> bool {
    return full != was_full;
}

/// F. Surfaces (owner, 2026-10-20): in a window every surface is a darker tint over the same matte black glass
/// -- the behind-window blur under the layer tint -- and none is opaque; in full screen every surface is
/// opaque black #000000, as the frame is (backdrop_alpha). One fn decides for all of them.
pub const SURF_SIDEBAR : u32 = 0;
pub const SURF_CONTENT : u32 = 1;
pub const SURF_TERMINAL : u32 = 2;
pub const SURF_PANEL : u32 = 3;
/// F. The terminal is drawn over the content's STRICT_CONTENT (0.35): 0.15 more brings the two to 0.4475,
/// the sidebar's 0.45 (the same look as the sidebar, which the owner called glass).
pub const TERMINAL_TINT : f64 = 0.15;
/// F. The right-hand panels (Queen, DOCTOR, KEYS) are the elevated surface of trios (0.58): their small
/// type needs more ground than the sidebar's.
pub const PANEL_BLACK : f64 = 0.58;

/// F. The alpha of a surface's black fill: its glass tint in a window, 1.0 (opaque #000000) in full screen.
pub fn surface_alpha(kind: u32, full: bool) -> f64 {
    if (full) { return 1.0; }
    if (kind == SURF_SIDEBAR) { return STRICT_SIDE; }
    if (kind == SURF_CONTENT) { return STRICT_CONTENT; }
    if (kind == SURF_TERMINAL) { return TERMINAL_TINT; }
    return PANEL_BLACK;
}

/// F. A surface that is not opaque must first wipe what was drawn under it, as the backdrop does, or the
/// cards and the last frame show through it.
pub fn surface_clears(kind: u32, full: bool) -> bool {
    return surface_alpha(kind, full) < 1.0;
}

/// Matte glass tiles (owner, 2026-10-20: the widgets too in transparent matte glass). Corner 10, a 1 pt white 0.14 border.
pub const TILE_CORNER : f64 = 10.0;
pub const TILE_BORDER : f64 = 0.14;
/// CGBlendMode screen (2): a card image's black background drops out over the glass, its coloured strokes stay.
pub const BLEND_SCREEN : u32 = 2;
pub const TILE_IMAGE_ALPHA : f64 = 0.92;
pub const AGENTS_LINE_ALPHA : f64 = 0.6;

/// The tile body: the window's glass surface alpha (SURF_CONTENT), opaque black in full screen.
pub fn tile_body_alpha(full: bool) -> f64 { return surface_alpha(SURF_CONTENT, full); }
/// Window: screen blend at 0.92. Full screen: the same look over black (screen over black shows the image as is).
pub fn tile_image_blend(full: bool) -> u32 { if (full) { return BLEND_SCREEN; } return BLEND_SCREEN; }
pub fn tile_image_alpha(full: bool) -> f64 { if (full) { return TILE_IMAGE_ALPHA; } return TILE_IMAGE_ALPHA; }

/// F. A black surface over a rectangle: wiped first when it is glass (and fully shown: during the 0.25 s
/// cross-fade `a` is below 1 and the wipe waits, so nothing pops), then the tint times `a`.
fn draw_ground(c: u64, x: f64, y: f64, w: f64, h: f64, kind: u32, full: bool, a: f64) -> void {
    if (surface_clears(kind, full) and a >= 1.0) {
        cg_blend(c, BLEND_CLEAR);
        cg_fill_rect(c, x, y, w, h);
        cg_blend(c, BLEND_NORMAL);
    }
    const s : f64 = surface_alpha(kind, full) * a;
    if (s > 0.0) {
        cg_fill_rgba(c, 0.0, 0.0, 0.0, s);
        cg_fill_rect(c, x, y, w, h);
        if (full == false and kind != SURF_TERMINAL) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, SURF_FROST * a);
            cg_fill_rect(c, x, y, w, h);
        }
    }
}

/// F. The ground under a right-hand panel, drawn once before it: the whole column from the top of the
/// workspace to the bottom edge, wiped to the glass and tinted (opaque black in full screen). The wipe reaches
/// BACK_BLEED past the right and bottom edges, where a fractional pixel would keep part of the last frame.
fn draw_panel_ground(c: u64, sw: f64, sh: f64, full: bool) -> void {
    const l : f64 = qp_left(sw);
    draw_ground(c, l, WS_TOP, sw - l + BACK_BLEED, sh - WS_TOP + BACK_BLEED, SURF_PANEL, full, 1.0);
}

/// F. A plate under a panel's button, so a long line of the row under it does not show through the button: the
/// panel's own glass wiped and tinted again, not an opaque black box. In full screen the wiped pixel shows
/// the layer's opaque black (tint_alpha(true) == 1.0), so the plate is #000000 there as well.
fn draw_plate(c: u64, x: f64, y: f64, w: f64, h: f64) -> void {
    draw_ground(c, x, y, w, h, SURF_PANEL, false, 1.0);
}

/// F. The background: clear (BLEND_CLEAR) in a window, one opaque black fill over the whole frame in full screen.
fn draw_backdrop(c: u64, sw: f64, sh: f64, full: bool) -> void {
    if (backdrop_clears(full)) {
        cg_blend(c, BLEND_CLEAR);
        cg_fill_rect(c, 0.0 - BACK_BLEED, 0.0 - BACK_BLEED, sw + 2.0 * BACK_BLEED, sh + 2.0 * BACK_BLEED);
        cg_blend(c, BLEND_NORMAL);
    }
    const a : f64 = backdrop_alpha(full);
    if (a > 0.0) {
        cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
        cg_fill_rect(c, 0.0 - BACK_BLEED, 0.0 - BACK_BLEED, sw + 2.0 * BACK_BLEED, sh + 2.0 * BACK_BLEED);
    }
}

/// One frame over the tinted glass: the home logo at 1 - ma, the screen for `shown` at ma, the title bar.
/// Q. The Queen panel (queen.t27): a black column on the right over any view -- GOD MODE, what the
/// user is looking at, her suggestion with Confirm and Dismiss, and the RECENT log of user and Queen
/// actions, newest first. A filled dot marks her actions, a ring the user's.
/// GOD MODE does not start a real agent pane yet: a confirmed task only shows its planned lane (evolve.t27).
pub const EVOLVE_SPAWNS : bool = false;

/// The Queen's evolve decision from what the window knows: letters with no instrument, letters pinned to
/// nothing, live widgets no letter owns (a gap for letter S). BLOCKED/stale/red need the git log (domain_pulse)
/// and are not read here. `inflight` = letters already confirmed or dismissed, `started` = tasks confirmed.
fn evolve_next(inflight: u32, started: u32, unassigned: u32) -> u32 {
    const p : Panel = make_panel(unassigned);
    return next_action(p, inflight, true, true, 0, started, 0, 0);
}

/// head + letter + "-" + n + tail, drawn small and fitted to the panel.
fn draw_lane(c: u64, kit: [48]u64, x: f64, y: f64, right: f64, head: []const u8, letter: u32, nn: u32, tail: []const u8) -> void {
    var b : [256]u8 = undefined;
    var n : usize = put_bytes(b[0..256], 0, head);
    n = put_bytes(b[0..256], n, letter_char(letter));
    n = put_bytes(b[0..256], n, "-");
    n = put_dec(b[0..256], n, @as(u64, nn));
    n = put_bytes(b[0..256], n, tail);
    draw_fit(c, kit, b[0..256], n, x, y, 8.5, 0.0, true, right);
}

fn draw_queen_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, view: u32, space: u32, ss: u64, cur: u32, ring: [8]u64, n: u32, now: u64, sug: u32, god: bool, evd: u32, evp: u32, evn2: u32, evpr: u32) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    // the ground is draw_panel_ground's, drawn once before the panel
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE);
    cg_fill_rect(c, l, t, HAIR, sh - t);
    // the crown and QUEEN
    cg_move(c, x, t + 26.0);
    cg_line(c, x, t + 18.0);
    cg_line(c, x + 3.0, t + 21.0);
    cg_line(c, x + 5.5, t + 16.0);
    cg_line(c, x + 8.0, t + 21.0);
    cg_line(c, x + 11.0, t + 18.0);
    cg_line(c, x + 11.0, t + 26.0);
    cg_close(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, CROWN_WHITE);
    cg_fill_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_QUEEN)), x + 18.0, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    // GOD MODE: an empty box when off, a filled one when on, and the words
    const gy : f64 = t + QP_GOD_Y;
    round_rect(c, x, gy, QP_W - 2.0 * QP_PAD, QP_GOD_H, 6.0);
    if (on_god(mx, my, sw, t)) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE);
        cg_fill_path(c);
        round_rect(c, x, gy, QP_W - 2.0 * QP_PAD, QP_GOD_H, 6.0);
    }
    cg_line_width(c, 1.0);
    if (god) { cg_line_width(c, 2.0); }
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (god) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE); }
    cg_stroke_path(c);
    round_rect(c, x + 12.0, gy + 15.0, 14.0, 14.0, 3.0);
    if (god) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        cg_fill_path(c);
    } else {
        cg_line_width(c, 1.3);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
        cg_stroke_path(c);
    }
    var gw : u32 = QL_GOD_OFF;
    var gs : u32 = QL_SUB_OFF;
    if (god) { gw = QL_GOD_ON; gs = QL_SUB_ON; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, gw)), x + 36.0, gy + 19.0, 11.5, WEIGHT_BOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, gs)), x + 36.0, gy + 34.0, 10.0, 0.0, false);
    // LOOKING AT: the view, then the space and the selected chat
    const cy : f64 = t + QP_CTX_Y;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_LOOKING)), x, cy, 9.5, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    if (view == VIEW_HOME) {
        draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_HOME)), x, cy + 20.0, 11.5, WEIGHT_MEDIUM, false);
    } else {
        draw_text(c, kit, world(kit, view), x, cy + 20.0, 11.5, WEIGHT_MEDIUM, false);
    }
    const sw1 : f64 = draw_text(c, kit, msg1(kit[K_SPACE_NAMES], kit[K_AT], @as(u64, space)), x, cy + 38.0, 10.5, WEIGHT_MEDIUM, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    if (cur == SESSION_NONE) {
        draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_NO_CHAT)), x + sw1 + 8.0, cy + 38.0, 10.5, 0.0, false);
    } else {
        const aw : f64 = draw_text(c, kit, msg1(kit[K_AGENT_NAMES], kit[K_AT], @as(u64, session_agent(ss, cur))), x + sw1 + 8.0, cy + 38.0, 10.5, 0.0, false);
        const cn : u32 = chat_number(ss, cur);
        if (cn > 1 and cn <= 9) {
            draw_text(c, kit, msg1(kit[K_DIGITS], kit[K_AT], @as(u64, cn - 1)), x + sw1 + 8.0 + aw + 4.0, cy + 38.0, 10.5, 0.0, false);
        }
    }
    // SUGGESTION, and the two buttons that put a human on every action
    const sy : f64 = t + QP_SUG_Y;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_SUGGESTION)), x, sy, 9.5, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_text(c, kit, msg1(kit[K_SUGGEST], kit[K_AT], @as(u64, sug)), x, sy + 20.0, 11.5, WEIGHT_MEDIUM, false);
    if (sug == A_NONE and evd != 0) {
        // GOD MODE's evolve rule (evolve.t27): what it would do next, as "<kind> -- letter <x>"
        var eb : [256]u8 = undefined;
        var en : usize = 0;
        if (dec_action(evd) == D_REQUEST) { en = put_bytes(eb[0..256], 0, "ASK OWNER: "); }
        en = put_bytes(eb[0..256], en, kind_phrase(dec_kind(evd)));
        en = put_bytes(eb[0..256], en, TITLE_MID);
        en = put_bytes(eb[0..256], en, letter_char(dec_letter(evd)));
        draw_fit(c, kit, eb[0..256], en, x, sy + 20.0, 10.5, WEIGHT_MEDIUM, false, sw - QP_PAD);
        // the key master's choice for the pane it would start: the profile NAME only, never a key
        if (dec_action(evd) == D_TASK and evpr != PROFILE_NONE) {
            en = put_bytes(eb[0..256], 0, "PROFILE: ");
            en = en + profile_name(evpr, eb[9..256]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
            draw_fit(c, kit, eb[0..256], en, x, sy + 33.0, 9.0, WEIGHT_SEMIBOLD, true, sw - QP_PAD);
        }
    }
    if (sug != A_NONE or evd != 0) {
        const by : f64 = t + QP_BTN_Y;
        // Confirm: a white box, black words
        round_rect(c, x, by, QP_BTN_W, QP_BTN_H, 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        if (on_confirm(mx, my, sw, t)) { cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0); }
        cg_fill_path(c);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
        draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_CONFIRM)), x + 14.0, by + 17.0, 11.0, WEIGHT_SEMIBOLD, false);
        // Dismiss: an outlined box
        const dx : f64 = x + QP_BTN_W + QP_BTN_GAP;
        round_rect(c, dx, by, QP_BTN_W, QP_BTN_H, 6.0);
        if (on_dismiss(mx, my, sw, t)) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE);
            cg_fill_path(c);
            round_rect(c, dx, by, QP_BTN_W, QP_BTN_H, 6.0);
        }
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_DISMISS)), dx + 14.0, by + 17.0, 11.0, WEIGHT_SEMIBOLD, false);
    }
    // RECENT: newest first; her actions a filled dot, the user's a ring
    const ry : f64 = t + QP_RECENT_Y;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_RECENT)), x, ry, 9.5, WEIGHT_SEMIBOLD, false);
    if (n == 0) {
        draw_text(c, kit, msg1(kit[K_QP], kit[K_AT], @as(u64, QL_EMPTY)), x, ry + 20.0, 10.5, 0.0, false);
    }
    const rows : u32 = recent_rows(sh, t);
    var b : u32 = 0;
    while (b < rows) {
        const slot : u32 = ring_at(n, b);
        if (slot != RING_NONE) {
            const e : u64 = ring[slot];
            const k : u32 = ev_control(e);
            const ly : f64 = ry + 20.0 + @as(f64, @floatFromInt(b)) * QP_LINE;
            if (by_queen(k)) {
                draw_dot(c, DOT_FILLED, x + 3.0, ly - 4.0, 1.0);
            } else {
                draw_dot(c, DOT_RING, x + 3.0, ly - 4.0, 1.0);
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
            const nw : f64 = draw_text(c, kit, msg1(kit[K_CONTROLS], kit[K_AT], @as(u64, k)), x + 14.0, ly, 11.0, 0.0, false);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
            const ak : u32 = arg_kind(k);
            if (ak == ARG_AGENT) {
                draw_text(c, kit, msg1(kit[K_AGENT_NAMES], kit[K_AT], @as(u64, ev_arg(e))), x + 14.0 + nw + 6.0, ly, 10.5, 0.0, false);
            } else if (ak == ARG_SPACE) {
                draw_text(c, kit, msg1(kit[K_SPACE_NAMES], kit[K_AT], @as(u64, ev_arg(e))), x + 14.0 + nw + 6.0, ly, 10.5, 0.0, false);
            }
            draw_text(c, kit, msg1(kit[K_AGES], kit[K_AT], @as(u64, age_word(now, ev_sec(e)))), sw - QP_PAD - 72.0, ly, 10.0, 0.0, false);
        }
        b = b + 1;
    }
    draw_plan(c, kit, sw, sh, evp, evn2);
}

/// Q. The planned lane of the last confirmed evolve task: worktree, branch, command (nothing is started).
fn draw_plan(c: u64, kit: [48]u64, sw: f64, sh: f64, evp: u32, evn2: u32) -> void {
    if (evp == 0 or dec_action(evp) != D_TASK) { return; }
    const x : f64 = qp_left(sw) + QP_PAD;
    const r : f64 = sw - QP_PAD;
    const y : f64 = sh - 60.0;
    const lt : u32 = dec_letter(evp);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    if (EVOLVE_SPAWNS) { draw_fit(c, kit, "LANE STARTED", 12, x, y, 9.0, WEIGHT_SEMIBOLD, true, r); } else { draw_fit(c, kit, "LANE PLANNED (nothing started)", 30, x, y, 9.0, WEIGHT_SEMIBOLD, true, r); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_lane(c, kit, x, y + 14.0, r, LANE_DIR, lt, evn2, "");
    draw_lane(c, kit, x, y + 26.0, r, BRANCH_HEAD, lt, evn2, "");
    var b : [256]u8 = undefined;
    var n : usize = put_bytes(b[0..256], 0, CMD_A);
    n = put_bytes(b[0..256], n, LANE_DIR);
    n = put_bytes(b[0..256], n, letter_char(lt));
    n = put_bytes(b[0..256], n, "-");
    n = put_dec(b[0..256], n, @as(u64, evn2));
    n = put_bytes(b[0..256], n, CMD_B);
    draw_fit(c, kit, b[0..256], n, x, y + 38.0, 8.5, 0.0, true, r);
}

/// Q. The GOD MODE glow (queen.t27): a blue gas flame along all four edges at level `g` on frame
/// `frame` -- GLOW_BANDS thin strips coloured cone to base (flame_rgb) with the spec's falloff and
/// flicker, then the cone hairline at the very edge with a GLOW_BLUR pt blue shadow. Nothing is drawn
/// at level 0, so the human-confirm mode keeps black edges.
fn draw_edge_glow(c: u64, sw: f64, sh: f64, g: f64, frame: u32) -> void {
    if (g <= 0.0) { return; }
    const bw : f64 = GLOW_W / @as(f64, @floatFromInt(GLOW_BANDS));
    var b : u32 = 0;
    while (b < GLOW_BANDS) {
        const d : f64 = @as(f64, @floatFromInt(b)) * bw;
        cg_fill_rgba(c, flame_rgb(b, 0), flame_rgb(b, 1), flame_rgb(b, 2), glow_alpha(g, b, frame));
        cg_fill_rect(c, d, d, sw - 2.0 * d, bw);
        cg_fill_rect(c, d, sh - d - bw, sw - 2.0 * d, bw);
        cg_fill_rect(c, d, d + bw, bw, sh - 2.0 * d - 2.0 * bw);
        cg_fill_rect(c, sw - d - bw, d + bw, bw, sh - 2.0 * d - 2.0 * bw);
        b = b + 1;
    }
    const ca : f64 = core_alpha(g, frame);
    const halo : u64 = cg_color(FLAME_MID_R, FLAME_MID_G, FLAME_MID_B, ca);
    cg_save(c);
    cg_shadow(c, 0.0, 0.0, GLOW_BLUR, halo);
    cg_fill_rgba(c, FLAME_CORE_R, FLAME_CORE_G, FLAME_CORE_B, ca);
    const cw : f64 = GLOW_CORE_W;
    cg_fill_rect(c, 0.0, 0.0, sw, cw);
    cg_fill_rect(c, 0.0, sh - cw, sw, cw);
    cg_fill_rect(c, 0.0, cw, cw, sh - 2.0 * cw);
    cg_fill_rect(c, sw - cw, cw, cw, sh - 2.0 * cw);
    cg_restore(c);
    cg_color_release(halo);
}

// ---- the terminal pane (Claude Code, AGENT 0) ----
// The pane talks to the T27 OS PTY server through specs/t27os/pty_client.t27: blocking round trips on
// ~/.t27os/pty.sock, one frame out and one back. Which server pane a chat is, and how a reply reads, are
// term_pane.t27 decisions; when no server answers the pane runs offline, echoing its own keys.

/// The UTF-8 bytes of an NSString into out; the count, cut at out.len.
fn ns_bytes(s: u64, out: []u8) -> usize {
    const p : u64 = msg0(s, sel("UTF8String"));
    if (p == 0) { return 0; }
    var n : u64 = sys_strlen(p);
    if (n > @as(u64, out.len)) { n = @as(u64, out.len); }
    sys_peek(out, p, n);
    return @as(usize, n);
}

/// Connect to the server under the home directory; the fd, -1 when nothing listens. A new connection means a
/// server that may have restarted and forgotten its keys, so every stored key is handed over again.
fn term_connect(hb: []u8) -> i32 {
    const hn : usize = ns_bytes(home_dir(), hb);
    const fd : i32 = client_connect(hb[0 .. hn]);
    if (fd >= 0) { push_keys(fd); }
    return fd;
}

/// The server pane for chat `cur`: the k-th pane of its agent when the server has one (a reopened
/// window lands here), else a new pane spawned in `cwd`. PANE_NONE when the server refuses or is gone.
fn term_open(fd: i32, ss: u64, cur: u32, cwd: u64, out: []u8, db: []u8) -> u32 {
    const a : u32 = session_agent(ss, cur);
    const ln : usize = client_list(fd, out);
    if (ln == 0) { return PANE_NONE; }
    const have : u32 = tp_pick_pane(out, ln, a, tp_ordinal(ss, cur));
    if (have != PANE_NONE) { return have; }
    const dn : usize = ns_bytes(cwd, db);
    const sn : usize = client_spawn(fd, a, session_space(ss, cur), cur, db[0 .. dn], out);
    return tp_spawned(out, sn);
}

/// The editor pane for `path` in `space` (T27 OS opens inside): the one already open when the server still
/// lists it live and it was opened for this space, else a new one; an old pane is killed first so panes do
/// not pile up. PANE_NONE when the server refuses or the path is not fit (editors.t27 term_path_fits).
fn edit_open(fd: i32, epane: u32, espace: u32, space: u32, pick: u32, path: []const u8, out: []u8) -> u32 {
    const ln : usize = client_list(fd, out);
    if (epane != PANE_NONE and espace == space and tp_pane_live(out, ln, epane)) { return epane; }
    if (epane != PANE_NONE) { client_kill(fd, epane, out); }
    const sn : usize = client_spawn_editor(fd, space, 0, pick, path, out);
    return tp_spawned(out, sn);
}

/// The offline banner: title, the cwd the pane opened in, the offline note and a prompt.
fn term_banner(st: []u32, cells: []u32, cwd: u64) -> bool {
    var nl : [2]u8 = undefined;
    nl[0] = 13;
    nl[1] = 10;
    vt_feed_all(st, cells, TP_LINE_TITLE);
    vt_feed_all(st, cells, nl[0..2]);
    vt_feed_all(st, cells, TP_LINE_CWD);
    var pb : [512]u8 = undefined;
    pb[0] = 0;
    if (cwd != 0) { msg_cstr(cwd, sel("getCString:maxLength:encoding:"), pb[0..512], @as(u64, TP_PATH_MAX), NS_UTF8); }
    var i : u32 = 0;
    var going : bool = true;
    while (going and i < TP_PATH_MAX) {
        if (pb[i] == 0) { going = false; } else { vt_feed(st, cells, pb[i]); i = i + 1; }
    }
    vt_feed_all(st, cells, nl[0..2]);
    vt_feed_all(st, cells, nl[0..2]);
    vt_feed_all(st, cells, TP_PROMPT);
    return true;
}

/// The pane server banner (replaces the raw offline line): a matte glass card in the middle of the pane area with
/// "Starting pane server..." (or the failure) and a Retry button. Drawn only while the server does not answer.
fn draw_srv_banner(c: u64, kit: [48]u64, phase: u32, ox: f64, oy: f64, pw: f64, ph: f64, mx: f64, my: f64, a: f64, full: bool) -> void {
    const bx : f64 = tp_ban_x(ox, pw);
    const by : f64 = tp_ban_y(oy, ph);
    round_rect(c, bx, by, TP_BAN_W, TP_BAN_H, 12.0);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.70 * a);
    cg_fill_path(c);
    round_rect(c, bx, by, TP_BAN_W, TP_BAN_H, 12.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, SURF_FROST * a);
    cg_fill_path(c);
    round_rect(c, bx + 0.5, by + 0.5, TP_BAN_W - 1.0, TP_BAN_H - 1.0, 12.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * a);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    if (phase == SRV_FAILED) {
        draw_bytes(c, kit, TP_SRV_FAILED, 30, bx + 24.0, by + 36.0, 13.0, WEIGHT_SEMIBOLD, false);
    } else {
        draw_bytes(c, kit, TP_SRV_STARTING, 23, bx + 24.0, by + 36.0, 13.0, WEIGHT_SEMIBOLD, false);
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, "your panes and their history live in it", 39, bx + 24.0, by + 56.0, 10.0, 0.0, false);
    const kx : f64 = tp_btn_x(ox, pw);
    const ky : f64 = tp_btn_y(oy, ph);
    const hot : bool = tp_retry_hit(mx, my, ox, oy, pw, ph);
    round_rect(c, kx, ky, TP_BTN_W, TP_BTN_H, 7.0);
    if (hot) { cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.18 * a); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a); }
    cg_fill_path(c);
    round_rect(c, kx + 0.5, ky + 0.5, TP_BTN_W - 1.0, TP_BTN_H - 1.0, 7.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * a);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_bytes(c, kit, TP_SRV_RETRY, 5, kx + 28.0, ky + 18.5, 11.0, WEIGHT_SEMIBOLD, false);
}

/// The pane: the content area under the header, one monospace line per grid row, a white block cursor with
/// its character redrawn in black. Its default background is a surface (surface_alpha SURF_TERMINAL): glass in
/// a window, opaque #000000 in full screen. The program's colours are dropped by vt.t27 (SGR is read and
/// discarded), so no cell has a background of its own: the one filled cell is the cursor. The area ends at
/// the left edge of an open right-hand panel (content_right), where the grid also ends.
fn draw_term(c: u64, kit: [48]u64, st: []const u32, cells: []const u32, curon: bool, a: f64, collapsed: bool, sw: f64, sh: f64, ws: u32, full: bool, panel: bool) -> void {
    const ox : f64 = content_x(ws, collapsed);
    const oy : f64 = WS_TOP + HEADER_H;
    const pw : f64 = content_w(sw, ws, collapsed, panel);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, surface_alpha(SURF_TERMINAL, full) * a);
    cg_fill_rect(c, ox, oy + HAIR, pw, sh - oy - HAIR);
    const cols : u32 = st[ST_COLS];
    const rows : u32 = st[ST_ROWS];
    var lb : [1600]u8 = undefined;
    cg_save(c);
    cg_clip_rect(c, ox, oy + HAIR, pw, sh - oy - HAIR);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    // scrollback (vt.t27): rows + 1 lines of history ++ grid; a sub-row view moves them down by a fraction of a line
    const shift : f64 = @as(f64, vt_view_frac(st)) * TP_LINE_H / @as(f64, VIEW_SUB);
    var y : u32 = 0;
    while (y <= rows) {
        var keep : u32 = 0;
        var x : u32 = 0;
        while (x < cols) {
            if (vt_view_cell(st, cells, y, x) != BLANK) { keep = x + 1; }
            x = x + 1;
        }
        if (keep > 0) {
            var n : u32 = 0;
            x = 0;
            while (x < keep) {
                n = tp_utf8(lb[0..1600], n, vt_view_cell(st, cells, y, x));
                x = x + 1;
            }
            const s : u64 = cf_bytes(0, lb[0..1600], @as(usize, @intCast(n)), UTF8, false);
            if (s != 0) {
                draw_text(c, kit, s, tp_cell_x(ox, 0), tp_cell_y(oy, y) - TP_LINE_H + shift + TP_BASE, TP_FONT, 0.0, true);
                cf_release(s);
            }
        }
        y = y + 1;
    }
    if (curon and rows > 0 and vt_view(st) == 0) {
        const cx : u32 = tp_cursor_col(st[ST_X], cols);
        var cy : u32 = st[ST_Y];
        if (cy >= rows) { cy = rows - 1; }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        cg_fill_rect(c, tp_cell_x(ox, cx), tp_cell_y(oy, cy), TP_CELL_W, TP_LINE_H);
        const under : u32 = cells[cy * cols + cx];
        if (under != BLANK) {
            const m : u32 = tp_utf8(lb[0..1600], 0, under);
            const g : u64 = cf_bytes(0, lb[0..1600], @as(usize, @intCast(m)), UTF8, false);
            if (g != 0) {
                cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
                draw_text(c, kit, g, tp_cell_x(ox, cx), tp_cell_y(oy, cy) + TP_BASE, TP_FONT, 0.0, true);
                cf_release(g);
            }
        }
    }
    // the chip that jumps back to live while the view is scrolled up: matte glass, white outline
    if (vt_chip_shown(st)) {
        const kx : f64 = tp_chip_x(ox, pw);
        const ky : f64 = tp_chip_y(oy, sh - oy);
        round_rect(c, kx, ky, TP_CHIP_W, TP_CHIP_H, 0.5 * TP_CHIP_H);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.82 * a);
        cg_fill_path(c);
        round_rect(c, kx, ky, TP_CHIP_W, TP_CHIP_H, 0.5 * TP_CHIP_H);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
        round_rect(c, kx + 0.5, ky + 0.5, TP_CHIP_W - 1.0, TP_CHIP_H - 1.0, 0.5 * TP_CHIP_H);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * a);
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_bytes(c, kit, "JUMP TO LIVE", 12, kx + 16.0, ky + 17.0, 9.5, WEIGHT_SEMIBOLD, true);
    }
    cg_restore(c);
}

// ---- K. the KEYS panel (keys.t27): one row per provider, where the Queen and DOCTOR panels sit ----------

/// A word of the KEYS panel, drawn from bytes; the width drawn.
fn draw_bytes(c: u64, kit: [48]u64, s: []const u8, n: usize, x: f64, base: f64, size: f64, weight: f64, mono: bool) -> f64 {
    const ns : u64 = cf_bytes(0, s, n, UTF8, false);
    if (ns == 0) { return 0.0; }
    const w : f64 = draw_text(c, kit, ns, x, base, size, weight, mono);
    cf_release(ns);
    return w;
}

fn bytes_w(kit: [48]u64, s: []const u8, n: usize, size: f64, weight: f64, mono: bool) -> f64 {
    const ns : u64 = cf_bytes(0, s, n, UTF8, false);
    if (ns == 0) { return 0.0; }
    const w : f64 = text_w(kit, ns, size, weight, mono);
    cf_release(ns);
    return w;
}

/// The Keychain is read here and nowhere else in the window: which numbers each provider holds (stored[p] is a
/// bit mask, bit k set = key k+1 exists; keys.t27 slot_count counts it) and the masked text of its newest key,
/// the highest number (16 bytes a provider). A scan stops after two misses in a row (keys.t27 scan_goes_on).
/// The full key is wiped from the buffer before the next one is read.
fn keys_refresh(stored: []u32, mask: []u8, mlen: []u32) -> void {
    var key : [256]u8 = undefined;
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        const at : usize = @as(usize, p) * 16;
        mlen[p] = 0;
        stored[p] = 0;
        var k : u32 = 0;
        var misses : u32 = 0;
        while (scan_goes_on(k, misses)) {
            const n : usize = kc_get_n(p, k, key[0..256]);
            if (n > 0) {
                misses = 0;
                mlen[p] = @as(u32, @intCast(mask_key(key[0..n], mask[at .. at + 16])));
                stored[p] = stored[p] + (1 << k);
            } else {
                misses = misses + 1;
            }
            var i : usize = 0;
            while (i < 256) {
                key[i] = 0;
                i = i + 1;
            }
            k = k + 1;
        }
        p = p + 1;
    }
}

/// Hand the server every stored key with its number (keys_host push_keys), then take back each key whose last
/// check failed (keys.t27 key_withheld), as the check button does: a refresh must not undo that. kst holds one
/// status per key (keys.t27 key_index).
fn keys_sync(fd: i32, kst: []const u32, out: []u8) -> void {
    push_keys(fd);
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        var k : u32 = 0;
        while (k < MAX_KEYS) {
            if (key_withheld(kst[key_index(p, k)])) { client_set_key(fd, setkey_byte(p, k), "", out); }
            k = k + 1;
        }
        p = p + 1;
    }
}

fn keys_wipe(buf: []u8) -> void {
    var i : usize = 0;
    while (i < buf.len) {
        buf[i] = 0;
        i = i + 1;
    }
}

fn status_dot(st: u32) -> u32 {
    if (st == ST_MISSING) { return DOT_RING; }
    if (st == ST_STORED) { return DOT_DIM; }
    if (st == ST_VALID) { return DOT_FILLED; }
    return DOT_ALERT;
}

/// One of the three buttons of a row: a plate of the panel's glass, a rounded outline, the word centred; `on`
/// draws it filled (the armed DELETE), `live` false draws it dim (nothing to delete or check).
fn draw_key_btn(c: u64, kit: [48]u64, bx: f64, by: f64, word: u32, on: bool, live: bool, over: bool) -> void {
    var w : [24]u8 = undefined;
    const n : usize = csv_field(KEYS_WORDS, word, w[0..24]);
    draw_plate(c, bx - 2.0, by - 2.0, KY_BTN_W + 4.0, KY_BTN_H + 4.0);
    round_rect(c, bx, by, KY_BTN_W, KY_BTN_H, 5.0);
    var ink : f64 = TEXT_WHITE;
    if (on) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        cg_fill_path(c);
        cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    } else {
        if (live == false) { ink = MUTED_WHITE; }
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
        if (over and live) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE); }
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    }
    const lw : f64 = bytes_w(kit, w[0..24], n, 9.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, w[0..24], n, bx + (KY_BTN_W - lw) / 2.0, by + 13.0, 9.5, WEIGHT_SEMIBOLD, false);
}

fn draw_keys_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, stored: []const u32, mask: []const u8, mlen: []const u32, kst: []const u32, kfail: []const u32, kopen: []const u64, now: u64, kedit: u32, kbuf: []const u8, klen: u32, karm: u32, kbusy: u32, kemask: u32, kewhy: u32, ktpick: u32) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    var w : [48]u8 = undefined;
    // the ground is draw_panel_ground's, drawn once before the panel
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE);
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    var n : usize = csv_field(KEYS_WORDS, 0, w[0..48]);
    draw_bytes(c, kit, w[0..48], n, x, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    var hint : u32 = 8;
    if (kedit != KY_NONE) { hint = 9; }
    n = csv_field(KEYS_WORDS, hint, w[0..48]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    draw_bytes(c, kit, w[0..48], n, x, t + 46.0, 9.5, 0.0, false);
    var p : u32 = 0;
    while (p < PROVIDER_COUNT) {
        const y : f64 = ky_row_top(t, p);
        const has : bool = stored[p] > 0;
        const st : u32 = status_shown(has, provider_status(kst, p, stored[p]), kfail[p], kopen[p], now);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        n = provider_name(p, w[0..48]);
        const nw : f64 = draw_bytes(c, kit, w[0..48], n, x, y + 14.0, 11.0, WEIGHT_SEMIBOLD, false);
        // how many keys the provider holds ("zai  7 keys"), right after its name; the line below shows the newest key, masked
        n = key_count_text(slot_count(stored[p]), w[0..48]);
        if (n > 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
            draw_bytes(c, kit, w[0..48], n, x + nw + 8.0, y + 14.0, 9.5, 0.0, false);
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        draw_dot(c, status_dot(st), x + 112.0, y + 10.0, 1.0);
        n = key_status_text(st, kst, p, stored[p], w[0..48]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
        draw_bytes(c, kit, w[0..48], n, x + 124.0, y + 14.0, 9.5, 0.0, false);
        // the key as typed (masked, with a caret) while it is being entered; else the stored key, masked
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
        if (kedit == p) {
            var tm : [24]u8 = undefined;
            var tn : usize = 0;
            if (klen > 0) { tn = mask_key(kbuf[0 .. @as(usize, klen)], tm[0..24]); }
            tm[tn] = 95;
            draw_bytes(c, kit, tm[0..24], tn + 1, x, y + 33.0, 10.0, 0.0, true);
        } else if (has) {
            draw_bytes(c, kit, mask[@as(usize, p) * 16 .. @as(usize, p) * 16 + 16], @as(usize, mlen[p]), x, y + 33.0, 10.0, 0.0, true);
        } else {
            n = csv_field(KEYS_WORDS, 7, w[0..48]);
            draw_bytes(c, kit, w[0..48], n, x, y + 33.0, 10.0, 0.0, false);
        }
        const hit : u32 = ky_hit(mx, my, l, QP_W, QP_PAD, t);
        const by : f64 = y + KY_BTN_DY;
        const setw : u32 = ky_set_word(stored[p]);
        draw_key_btn(c, kit, ky_btn_x(l, QP_W, QP_PAD, B_SET), by, setw, false, setw == 1, hit == p * 4 + B_SET);
        var delw : u32 = 3;
        if (karm == p) { delw = 4; }
        draw_key_btn(c, kit, ky_btn_x(l, QP_W, QP_PAD, B_DELETE), by, delw, karm == p, has, hit == p * 4 + B_DELETE);
        var chkw : u32 = 5;
        if (kbusy == p) { chkw = 6; }
        draw_key_btn(c, kit, ky_btn_x(l, QP_W, QP_PAD, B_CHECK), by, chkw, kbusy == p, has and probe_has(p), hit == p * 4 + B_CHECK);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE);
        cg_fill_rect(c, x, y + KY_ROW_H - 2.0, QP_W - 2.0 * QP_PAD, HAIR);
        p = p + 1;
    }
    // the claude profile and why (keys.t27 profile_why): which provider a new claude pane gets; no key text
    var sm : u32 = 0;
    var pi : u32 = 0;
    while (pi < PROVIDER_COUNT) {
        if (stored[pi] > 0) { sm = sm + (1 << pi); }
        pi = pi + 1;
    }
    var wy : [96]u8 = undefined;
    n = profile_why(sm, bad_mask_keys(kst, stored), wy[0..96]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
    // the foot (editors.t27 foot_*): the status row, then OPEN IN, then the chips, each in a band of its own
    // below the provider rows, so no two text rows share a y band (the status line sat on the chips)
    const ft : f64 = ky_row_top(t, PROVIDER_COUNT);
    if (foot_status_fits(ft, sh)) {
        draw_bytes(c, kit, wy[0..96], n, x, foot_status_top(ft) + FT_BASE, 9.5, 0.0, false);
    }
    // the OPEN IN strip: the editors found on this Mac (editors.t27), one chip each; only whole rows that fit
    const nc : u32 = foot_chips(ft, sh, strip_count(kemask, ktpick));
    if (nc > 0) {
        n = csv_field(KEYS_WORDS, 10, w[0..48]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE);
        const hw : f64 = draw_bytes(c, kit, w[0..48], n, x, foot_head_top(ft) + FT_BASE, 9.5, 0.0, false);
        // why the last click did not open an editor (editors.t27 open_word); nothing after an open that started
        if (kewhy != OPEN_NONE and kewhy != OPEN_OK) {
            n = open_word(kewhy, w[0..48]);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
            draw_bytes(c, kit, w[0..48], n, x + hw + 8.0, foot_head_top(ft) + FT_BASE, 9.5, 0.0, false);
        }
        const hv : u32 = ed_hit(mx, my, l, QP_PAD, foot_chips_top(ft), nc);
        var k : u32 = 0;
        while (k < nc) {
            n = strip_label(strip_chip(kemask, ktpick, k), w[0..48]);
            var ea : f64 = MUTED_WHITE;
            if (hv == k) { ea = TEXT_WHITE; }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, ea);
            const cx : f64 = ed_slot_x(l, QP_PAD, k);
            const cy : f64 = ed_slot_y(foot_chips_top(ft), k);
            const cw : f64 = draw_bytes(c, kit, w[0..48], n, cx, cy + ED_BASE, 9.0, 0.0, false);
            if (hv == k) { cg_fill_rect(c, cx, cy + ED_BASE + 2.0, cw, HAIR); }
            k = k + 1;
        }
    }
}

/// K. KEYS in the sidebar foot, left of DOCTOR (keys.t27 on_keys_link).
pub fn on_keys_foot(x: f64, y: f64, sh: f64, ws: u32, collapsed: bool) -> bool {
    return in_side(x, ws, collapsed) and on_keys_link(x, y, SIDE_W, sh, FOOT_H, DOC_LINK_W);
}

// ======================================================================================================
// TOOL PAGES (owner, 2026-10-20): B = BENCH (t27b), K = KANBAN (t27k), Q = QUEEN live board (t27q).
// The window only calls the decisions of bench.t27, kanban.t27 and queen_board.t27 (which page a letter has is
// agent_parts page_kind); everything below is drawing, the background jobs of the host feed and the state they
// leave. A page is glass in a window and opaque #000000 in full screen (plate, surface_alpha). A letter without a
// page keeps the dashboard; a page's header switch goes to the dashboard and back. State: tg (u64 words, TPG_*) and
// the text store tb (TBO_* regions). Every job is one `/bin/sh -c` started with posix_spawn and reaped with
// waitpid(WNOHANG) from the frame loop, so a draw never waits for it.
// ======================================================================================================
pub const TPG_N : usize = 128;
pub const TBO_SIZE : usize = 49152;
pub const TBO_SCAN : usize = 0;
pub const TBO_DET0 : usize = 2048;
pub const TBO_LS : usize = 6144;
pub const TBO_PATH : usize = 7168;
pub const TBO_RUN : usize = 7424;
pub const TBO_KAN : usize = 10000;
pub const TBO_LANES : usize = 34200;
pub const TBO_CMD : usize = 38400;
pub const TBO_ROOT : usize = 44800;
pub const TBO_SCR : usize = 45200;
pub const TPG_DASH : u32 = 0;
pub const TPG_GEN : u32 = 1;
pub const TPG_BN_LAST : u32 = 3;
pub const TPG_BN_PID : u32 = 4;
pub const TPG_BN_STAGE : u32 = 5;
pub const TPG_BN_START : u32 = 6;
pub const TPG_BN_DET : u32 = 7;
pub const TPG_BN_BUS : u32 = 8;
pub const TPG_BN_AT : u32 = 10;
pub const TPG_BN_LEN : u32 = 11;
pub const TPG_BA_PID : u32 = 15;
pub const TPG_BA_CARD : u32 = 16;
pub const TPG_BA_FS : u32 = 17;
pub const TPG_BA_PLEN : u32 = 18;
pub const TPG_BA_RLEN : u32 = 19;
pub const TPG_BA_START : u32 = 20;
pub const TPG_BA_KIND : u32 = 21;
pub const TPG_K_LAST : u32 = 24;
pub const TPG_K_PID : u32 = 25;
pub const TPG_K_START : u32 = 26;
pub const TPG_K_LEN : u32 = 27;
pub const TPG_K_DRAG : u32 = 28;
pub const TPG_K_FROM : u32 = 29;
pub const TPG_K_PNUM : u32 = 30;
pub const TPG_K_PTO : u32 = 31;
pub const TPG_K_ACT : u32 = 32;
pub const TPG_K_SCROLL : u32 = 34;
pub const TPG_K_AT : u32 = 35;
pub const TPG_K_LOADED : u32 = 36;
pub const TPG_Q_LAST : u32 = 40;
pub const TPG_Q_PID : u32 = 41;
pub const TPG_Q_START : u32 = 42;
pub const TPG_Q_AT : u32 = 43;
pub const TPG_Q_AFTER : u32 = 44;
pub const TPG_Q_BEFORE : u32 = 50;
pub const TPG_Q_SNAP : u32 = 56;
pub const TPG_Q_LANELEN : u32 = 57;
pub const TPG_Q_GOD : u32 = 58;
pub const TPG_Q_EVFL : u32 = 59;
pub const TPG_Q_TIER : u32 = 60;
pub const TPG_Q_UNASS : u32 = 61;
pub const TPG_Q_EVN : u32 = 62;
pub const TPG_Q_RING : u32 = 63;
pub const TPG_Q_TZ : u32 = 71;
pub const TPG_Q_ROOTLEN : u32 = 72;
pub const TPG_NOW : u32 = 73;
pub const TPG_PHASE : u32 = 74;
pub const TG_KEY_RETURN : u64 = 36;
pub const TG_KEY_BACKSPACE : u64 = 51;
pub const TG_EV_CHAR : u32 = 99;
pub const TG_EV_BACK : u32 = 98;
pub const TG_TZ_BIAS : u64 = 200000;

/// The bytes of ~/<dir><file> into dst; the count (0 when the file is missing or empty).
fn tg_read(hb: []const u8, dir: []const u8, file: []const u8, dst: []u8) -> usize {
    var pb : [320]u8 = undefined;
    var n : usize = put_bytes(pb[0..320], 0, hb);
    n = put_bytes(pb[0..320], n, dir);
    n = put_bytes(pb[0..320], n, file);
    pb[n] = 0;
    const fd : i32 = sys_open_ro(pb[0..320], 0);
    if (fd < 0) { return 0; }
    const r : i64 = sys_read(fd, dst, @as(u64, dst.len));
    sys_close(fd);
    if (r <= 0) { return 0; }
    return @as(usize, @intCast(r));
}

/// Keep whole lines only: the length up to and including the last LF of buf[at .. at + n].
fn tg_whole_lines(buf: []const u8, at: usize, n: usize) -> usize {
    var e : usize = n;
    while (e > 0 and buf[at + e - 1] != 10) { e = e - 1; }
    return e;
}

/// Start `/bin/sh -c <cmd>` where tb[at .. at + 6] is reserved for "sh", "-c" and the command is tb[at + 6 .. end].
/// The pid, 0 when the spawn failed.
fn tg_spawn(tb: []u8, at: usize, end: usize) -> u64 {
    tb[at] = 115;
    tb[at + 1] = 104;
    tb[at + 2] = 0;
    tb[at + 3] = 45;
    tb[at + 4] = 99;
    tb[at + 5] = 0;
    tb[end] = 0;
    var argv : [8]u64 = undefined;
    argv[0] = sys_addr(tb[at .. tb.len], tb[0..1], 0);
    argv[1] = sys_addr(tb[at + 3 .. tb.len], tb[0..1], 0);
    argv[2] = sys_addr(tb[at + 6 .. tb.len], tb[0..1], 0);
    argv[3] = 0;
    argv[4] = 0;
    argv[5] = 0;
    argv[6] = 0;
    argv[7] = 0;
    var cp : [16]u8 = undefined;
    put_bytes(cp[0..16], 0, "/bin/sh");
    cp[7] = 0;
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    const rc : i32 = sys_spawn(pid, cp[0..16], 0, 0, argv, 0);
    if (rc != 0 or pid[0] == 0) { return 0; }
    return @as(u64, pid[0]);
}

/// 0 while the job runs, 1 when it ended well, 2 when it failed or is gone.
fn tg_done(pid: u64) -> u32 {
    var st : [2]u32 = undefined;
    st[0] = 0;
    const r : i32 = sys_waitpid(@as(i32, @intCast(pid)), st, 1);
    if (r == 0) { return 0; }
    if (r > 0 and st[0] == 0) { return 1; }
    return 2;
}

/// The head of every host script: sh, -c, then `export HOME=".."; export PATH=..; D=..; mkdir -p $D; ` (a, b = the two halves).
fn tg_head(tb: []u8, hb: []const u8, a: []const u8, b: []const u8) -> usize {
    var e : usize = TBO_CMD + 6;
    e = put_bytes(tb, e, a);
    e = put_bytes(tb, e, hb);
    e = put_bytes(tb, e, b);
    return e;
}

/// A job that has outlived FEED_KILL_S is killed; the next reap clears it.
fn tg_late(now: u64, start: u64, pid: u64) -> void {
    if (now > start + FEED_KILL_S) { sys_kill(@as(i32, @intCast(pid)), 9); }
}

fn tg_bump(tg: []u64) -> void { tg[TPG_GEN] = tg[TPG_GEN] + 1; }

// ---- B: the BENCH host feed and its actions ----

/// The state word of card c from what the last feed read.
fn bn_state(tg: []const u64, tb: []const u8, c: u32) -> u64 {
    const sl : usize = @as(usize, tg[TPG_BN_LEN]);
    const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
    const dl : usize = @as(usize, tg[TPG_BN_LEN + 1 + c]);
    const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
    var dv : u64 = 1;
    if (c == 1) { dv = 2; }
    const ran : bool = (tg[TPG_BN_DET] / dv) % 2 == 1;
    return card_state(@as(u8, @intCast(c)), tb[TBO_SCAN .. TBO_SCAN + sl], tb[d0 .. d0 + dl], ran, tb[TBO_LS .. TBO_LS + ll]);
}

fn bn_start_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    e = put_bytes(tb, e, FEED_SCAN);
    tg[TPG_BN_LAST] = now;
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BN_PID] = pid;
        tg[TPG_BN_STAGE] = 1;
        tg[TPG_BN_START] = now;
    }
}

/// The scan and the serial nodes are in: read them, then run --detect for each card whose cable is seen once.
fn bn_after_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const sn : usize = tg_read(hb, BENCH_DIR, FILE_SCAN, tb[TBO_SCAN .. TBO_DET0]);
    const ln : usize = tg_read(hb, BENCH_DIR, FILE_LS, tb[TBO_LS .. TBO_PATH]);
    tg[TPG_BN_LEN] = @as(u64, sn);
    tg[TPG_BN_LEN + 1] = 0;
    tg[TPG_BN_LEN + 2] = 0;
    tg[TPG_BN_LEN + 3] = @as(u64, ln);
    tg[TPG_BN_DET] = 0;
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    var any : bool = false;
    var c : u32 = 0;
    while (c < 2) {
        const cu : u8 = @as(u8, @intCast(c));
        const bus : u64 = card_busdev(cu, tb[TBO_SCAN .. TBO_SCAN + sn]);
        tg[TPG_BN_BUS + c] = bus;
        const st : u64 = card_state(cu, tb[TBO_SCAN .. TBO_SCAN + sn], "", false, tb[TBO_LS .. TBO_LS + ln]);
        const dl : u32 = feed_detect_len(cu, st, bus);
        if (dl > 0) {
            var k : u32 = 0;
            while (k < dl) {
                tb[e] = @as(u8, @intCast(feed_detect_char(cu, bus, k)));
                e = e + 1;
                k = k + 1;
            }
            var p : u32 = 0;
            while (p < FEED_DET_PIECES) {
                e = put_bytes(tb, e, feed_det_piece(cu, p));
                p = p + 1;
            }
            var bit : u64 = 1;
            if (c == 1) { bit = 2; }
            tg[TPG_BN_DET] = tg[TPG_BN_DET] + bit;
            any = true;
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    if (any) {
        e = put_bytes(tb, e, "true");
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_BN_PID] = pid;
            tg[TPG_BN_STAGE] = 2;
            tg[TPG_BN_START] = now;
            return;
        }
        tg[TPG_BN_DET] = 0;
    }
    tg_bump(tg);
}

fn bn_after_detect(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var c : u32 = 0;
    while (c < 2) {
        var dv : u64 = 1;
        if (c == 1) { dv = 2; }
        if ((tg[TPG_BN_DET] / dv) % 2 == 1) {
            const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
            tg[TPG_BN_LEN + 1 + c] = @as(u64, tg_read(hb, BENCH_DIR, file_detect(@as(u8, @intCast(c))), tb[d0 .. d0 + 2048]));
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    tg_bump(tg);
}

/// Every frame: reap the finished jobs, start the refresh when it is due and the page is open.
fn bench_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_BN_STAGE] != 0) {
        const d : u32 = tg_done(tg[TPG_BN_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_BN_START], tg[TPG_BN_PID]);
        } else {
            tg[TPG_BN_PID] = 0;
            if (tg[TPG_BN_STAGE] == 1) { bn_after_scan(tg, tb, hb, now); } else { bn_after_detect(tg, tb, hb, now); }
        }
    } else if (page_feed_due(PAGE_BENCH, open, now, tg[TPG_BN_LAST])) {
        bn_start_scan(tg, tb, hb, now);
    }
    if (tg[TPG_BA_PID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_BA_PID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_BA_START], tg[TPG_BA_PID]);
        } else {
            tg[TPG_BA_PID] = 0;
            tg[TPG_BA_RLEN] = @as(u64, tg_read(hb, BENCH_DIR, FILE_RUN, tb[TBO_RUN .. TBO_KAN]));
            tg_bump(tg);
        }
    }
}

/// Run FLASH (confirmed, SRAM load) or the UART view of card c as a background job writing run.txt.
fn bn_run(tg: []u64, tb: []u8, hb: []const u8, now: u64, card: u32, act: u8) -> void {
    if (tg[TPG_BA_PID] != 0) { return; }
    const cu : u8 = @as(u8, @intCast(card));
    const st : u64 = bn_state(tg, tb, card);
    const bus : u64 = tg[TPG_BN_BUS + card];
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    if (act == ACT_FLASH) {
        const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
        const fl : u32 = host_flash_len(cu, st, bus, tb[TBO_PATH .. TBO_PATH + pl], true);
        if (fl == 0) { return; }
        var k : u32 = 0;
        while (k < fl) {
            tb[e] = @as(u8, @intCast(host_flash_char(cu, bus, tb[TBO_PATH .. TBO_PATH + pl], k)));
            e = e + 1;
            k = k + 1;
        }
        e = put_bytes(tb, e, FEED_RUN_TAIL);
    } else if (act == ACT_UART) {
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const at : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        const pn : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], at);
        if (pn == 0 or pn > 120) { return; }
        var j : u32 = 0;
        while (j < pn) {
            tb[TBO_SCR + @as(usize, j)] = tb[TBO_LS + @as(usize, at) + @as(usize, j)];
            j = j + 1;
        }
        const port : []const u8 = tb[TBO_SCR .. TBO_SCR + @as(usize, pn)];
        if (uart_view_allowed(cu, st, port) == false) { return; }
        e = put_bytes(tb, e, UV_A);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_B);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_C);
    } else {
        return;
    }
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BA_PID] = pid;
        tg[TPG_BA_START] = now;
        tg[TPG_BA_CARD] = @as(u64, card);
        tg[TPG_BA_KIND] = @as(u64, act);
        tg[TPG_BA_RLEN] = 0;
    }
    tg_bump(tg);
}

/// What a click on the B page asks the host to run: 0 nothing, 1 the UART view, 2 the confirmed FLASH. The state it
/// changes (the dialogue, the refresh timer) is changed here; no job is started here.
fn bench_click_do(tg: []u64, tb: []const u8, hit: u32) -> u32 {
    if (hit == BH_NONE) { return 0; }
    const card : u32 = hit / 8;
    const kind : u32 = hit % 8;
    const st : u64 = bn_state(tg, tb, card);
    var run : u32 = 0;
    if (kind == BH_DETECT) {
        // DETECT runs the same refresh now (the next frame starts it when no stage is running)
        if (act_enabled(st, ACT_DETECT) and tg[TPG_BN_STAGE] == 0) { tg[TPG_BN_LAST] = 0; }
    } else if (kind == BH_FLASH) {
        if (act_enabled(st, ACT_FLASH)) {
            tg[TPG_BA_FS] = @as(u64, fs_next(FS_NONE, FE_FLASH_CLICK, false));
            tg[TPG_BA_CARD] = @as(u64, card);
            tg[TPG_BA_PLEN] = 0;
        }
    } else if (kind == BH_UART) {
        if (act_enabled(st, ACT_UART)) { run = 1; }
    } else if (kind == BH_CONFIRM) {
        if (tg[TPG_BA_FS] == FS_CONFIRM) {
            const ns : u32 = fs_next(FS_CONFIRM, FE_CONFIRM, true);
            tg[TPG_BA_FS] = 0;
            if (ns == FS_RUN) { run = 2; }
        }
    } else if (kind == BH_CANCEL) {
        tg[TPG_BA_FS] = @as(u64, fs_next(@as(u32, @intCast(tg[TPG_BA_FS])), FE_CANCEL, false));
    }
    tg_bump(tg);
    return run;
}

/// A click on the B page: hit = card * 8 + BH_*.
fn bench_click(tg: []u64, tb: []u8, hb: []const u8, now: u64, hit: u32) -> void {
    const run : u32 = bench_click_do(tg, tb, hit);
    if (run == 1) { bn_run(tg, tb, hb, now, hit / 8, ACT_UART); }
    if (run == 2) { bn_run(tg, tb, hb, now, hit / 8, ACT_FLASH); }
}

/// A key while the FLASH dialogue is open: ev is FE_RETURN, FE_ESCAPE, TG_EV_BACK or TG_EV_CHAR (ch = the character).
fn bench_key(tg: []u64, tb: []u8, ev: u32, ch: u32) -> void {
    const fs : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
    if (fs == FS_TYPING and ev == TG_EV_CHAR) {
        if (flash_char_ok(ch, @as(u32, @intCast(pl)))) {
            tb[TBO_PATH + pl] = @as(u8, @intCast(ch));
            tg[TPG_BA_PLEN] = @as(u64, pl + 1);
        }
    } else if (fs == FS_TYPING and ev == TG_EV_BACK) {
        if (pl > 0) { tg[TPG_BA_PLEN] = @as(u64, pl - 1); }
    } else if (ev == FE_RETURN or ev == FE_ESCAPE) {
        const ok : bool = flash_path_ok(tb[TBO_PATH .. TBO_PATH + pl]);
        tg[TPG_BA_FS] = @as(u64, fs_next(fs, ev, ok));
    }
    tg_bump(tg);
}

// ---- drawing helpers of the pages ----

fn tg_txt(c: u64, kit: [48]u64, s: []const u8, x: f64, y: f64, size: f64, weight: f64, alpha: f64, right: f64) -> f64 {
    if (s.len == 0) { return 0.0; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, alpha);
    return draw_fit(c, kit, s, s.len, x, y, size, weight, true, right);
}

/// "0x" and eight hex digits of v into out at at.
fn put_hex8(out: []u8, at: usize, v: u64) -> usize {
    var n : usize = put_bytes(out, at, "0x");
    var sh : u64 = 8;
    while (sh > 0) {
        sh = sh - 1;
        var d : u64 = v;
        var q : u64 = 0;
        while (q < sh) {
            d = d / 16;
            q = q + 1;
        }
        d = d % 16;
        if (d < 10) { out[n] = @as(u8, @intCast(48 + d)); } else { out[n] = @as(u8, @intCast(87 + d)); }
        n = n + 1;
    }
    return n;
}

/// A lamp of a bench card: grey ring, red, amber, green or blue-white disc, in the traffic-light palette.
fn draw_lamp(c: u64, x: f64, y: f64, lamp: u8, a: f64) -> void {
    if (lamp == LAMP_GREY) {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_line_width(c, 1.0);
        cg_arc(c, x, y, 4.0, 0.0, 6.283185307, 0);
        cg_stroke_path(c);
        return;
    }
    if (lamp == LAMP_RED) { draw_light_dot(c, x, y, LIGHT_RED, a); }
    if (lamp == LAMP_AMBER) { draw_light_dot(c, x, y, LIGHT_YELLOW, a); }
    if (lamp == LAMP_GREEN) { draw_light_dot(c, x, y, LIGHT_GREEN, a); }
    if (lamp == LAMP_BLUE) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
        cg_fill_path(c);
    }
}

fn tg_button(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, label: []const u8, hot: bool, on: bool, a: f64) -> void {
    round_rect(c, x, y, w, h, 5.0);
    cg_line_width(c, 1.0);
    var k : f64 = 0.35;
    if (hot and on) { k = 0.9; }
    if (on == false) { k = 0.16; }
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, k * a);
    cg_stroke_path(c);
    var ta : f64 = 1.0;
    if (on == false) { ta = 0.35; }
    const tw : f64 = bytes_w(kit, label, label.len, 9.5, WEIGHT_BOLD, true);
    tg_txt(c, kit, label, x + 0.5 * w - 0.5 * tw, y + 0.5 * h + 3.5, 9.5, WEIGHT_BOLD, ta * a, 0.0);
}

fn tg_in(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x < l + w and y >= t and y < t + h;
}

// ---- B: the page ----

fn draw_bench_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, full: bool, a: f64, now: u64) -> void {
    const cw : f64 = bp_card_w(pw);
    const ask : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const ask_card : u32 = @as(u32, @intCast(tg[TPG_BA_CARD]));
    const hit : u32 = bp_hit(mx - x0, my - y0, pw, BH_NONE);
    var line : [160]u8 = undefined;
    var ci : u32 = 0;
    while (ci < 2) {
        const cu : u8 = @as(u8, @intCast(ci));
        const cx : f64 = x0 + BP_PAD;
        const cy : f64 = y0 + bp_card_y(cu);
        const st : u64 = bn_state(tg, tb, ci);
        const ds : u8 = die_status(st);
        plate(c, cx, cy, cw, BP_CARD_H, full, a);
        // title row: lamp, board, model (a GUESS says so), status word
        draw_lamp(c, cx + 16.0, cy + 17.0, lamp_of(ds), a);
        const tw : f64 = tg_txt(c, kit, card_title(cu), cx + 30.0, cy + 21.0, 13.0, WEIGHT_HEAVY, a, 0.0);
        var mal : f64 = 0.55;
        if (card_model_known(cu) == false) { mal = 0.38; }
        // the PL part is ESTABLISHED by the tool's own manufacturer/family/model lines (MEASURED); the board model stays a guess
        const mdn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const md0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        const mpl : u32 = @as(u32, card_chain_len(cu)) - 1;
        const mfa : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "manufacturer");
        const mfb : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "family");
        const mfc : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "model");
        if (mfc != 4294967295 and mfb != 4294967295 and mfa != 4294967295) {
            var mn : usize = put_bytes(line[0..160], 0, "PL ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfa) .. md0 + @as(usize, mfa) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfa))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfb) .. md0 + @as(usize, mfb) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfb))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfc) .. md0 + @as(usize, mfc) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfc))]);
            mn = put_bytes(line[0..160], mn, " (measured); board model: ");
            mn = put_bytes(line[0..160], mn, card_model_text(cu));
            tg_txt(c, kit, line[0..mn], cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, 0.7 * a, cx + cw - 150.0);
        } else {
            tg_txt(c, kit, card_model_text(cu), cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, mal * a, cx + cw - 150.0);
        }
        const sw2 : f64 = bytes_w(kit, die_status_text(ds), die_status_text(ds).len, 9.5, WEIGHT_SEMIBOLD, true);
        tg_txt(c, kit, die_status_text(ds), cx + cw - 14.0 - sw2, cy + 20.0, 9.5, WEIGHT_SEMIBOLD, a, 0.0);
        // the chain from TDI: one box per TAP with its IDCODE (live, else the one measured on 2026-10-20, else not measured)
        const n : u32 = card_chain_len(cu);
        const dn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const d0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        var k : u32 = 0;
        while (k < n) {
            const bx : f64 = cx + 14.0 + @as(f64, @floatFromInt(k)) * 118.0;
            const by : f64 = cy + 36.0;
            if (k > 0) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
                cg_fill_rect(c, bx - 22.0, by + 20.0, 22.0, 1.0);
            }
            round_rect(c, bx, by, 96.0, 42.0, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_stroke_path(c);
            tg_txt(c, kit, box_label(cu, k), bx + 8.0, by + 15.0, 10.0, WEIGHT_BOLD, a, bx + 92.0);
            const live : u64 = card_idcode_live(tb[d0 .. d0 + dn], k);
            const last : u64 = card_idcode_measured(cu, k);
            var ln : usize = 0;
            var ia : f64 = 0.9;
            if (idcode_known(live)) {
                ln = put_hex8(line[0..160], 0, live);
            } else if (idcode_known(last)) {
                ln = put_hex8(line[0..160], 0, last);
                ia = 0.45;
            } else {
                ln = put_bytes(line[0..160], 0, "not measured");
                ia = 0.45;
            }
            tg_txt(c, kit, line[0..ln], bx + 8.0, by + 32.0, 9.0, 0.0, ia * a, bx + 92.0);
            k = k + 1;
        }
        // the facts: cable, serial, busdev, uart; each says where it came from
        const fx : f64 = cx + 14.0 + @as(f64, @floatFromInt(n)) * 118.0 + 10.0;
        const fy : f64 = cy + 42.0;
        tg_txt(c, kit, "cable", fx, fy, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_cable_text(cu), fx + 50.0, fy, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "serial", fx, fy + 13.0, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_serial(cu), fx + 50.0, fy + 13.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "busdev", fx, fy + 26.0, 9.0, 0.0, 0.5 * a, 0.0);
        const bus : u64 = tg[TPG_BN_BUS + ci];
        if (bus_known(bus) and st_has(st, ST_CABLE)) {
            var bn : usize = put_dec(line[0..160], 0, bus / 1000);
            bn = put_bytes(line[0..160], bn, ":");
            bn = put_dec(line[0..160], bn, bus % 1000);
            tg_txt(c, kit, line[0..bn], fx + 50.0, fy + 26.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 26.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        tg_txt(c, kit, "uart", fx, fy + 39.0, 9.0, 0.0, 0.5 * a, 0.0);
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const pc : u32 = port_count(tb[TBO_LS .. TBO_LS + ll], cu);
        const p0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        if (pc > 0 and p0 != 4294967295) {
            var pn : usize = put_dec(line[0..160], 0, @as(u64, pc));
            if (pc == 1) { pn = put_bytes(line[0..160], pn, " port  "); } else { pn = put_bytes(line[0..160], pn, " ports  "); }
            var pj : u32 = 0;
            while (pj < pc and pj < 3) {
                const pj0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, pj);
                const pjl : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], pj0);
                const pja : usize = TBO_LS + @as(usize, pj0);
                if (pj > 0) { pn = put_bytes(line[0..160], pn, "  "); }
                pn = put_bytes(line[0..160], pn, tb[pja .. pja + @as(usize, pjl)]);
                pj = pj + 1;
            }
            tg_txt(c, kit, line[0..pn], fx + 50.0, fy + 39.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 39.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        // provenance of the numbers above: the command and how long ago it ran
        var pv : usize = 0;
        if (tg[TPG_BN_AT] > 0) {
            pv = put_bytes(line[0..160], 0, "measured ");
            const dran : bool = (tg[TPG_BN_DET] / (1 + ci)) % 2 == 1;
            if (dran and bus_known(bus)) {
                // the command this cable actually ran: -c digilent for the Adept FTDI2232, -c digilent_hs2 for the FT232H
                const rl2 : u32 = cmd_raw_len(cu, ACT_DETECT, bus, "") - 1;
                var rk : u32 = 0;
                while (rk < rl2 and pv < 120) {
                    line[pv] = @as(u8, @intCast(cmd_char(cu, ACT_DETECT, bus, "", rk)));
                    pv = pv + 1;
                    rk = rk + 1;
                }
            } else {
                pv = put_bytes(line[0..160], pv, src_command(SRC_SCAN_USB));
            }
            pv = put_bytes(line[0..160], pv, "  ");
            pv = put_dec(line[0..160], pv, now - tg[TPG_BN_AT]);
            pv = put_bytes(line[0..160], pv, " s ago");
        } else {
            pv = put_bytes(line[0..160], 0, "not measured yet: openFPGALoader --scan-usb");
        }
        tg_txt(c, kit, line[0..pv], cx + 14.0, cy + BP_CARD_H - 44.0, 8.0, 0.0, 0.42 * a, cx + cw - 10.0);
        // buttons, or the FLASH dialogue in their place
        const by2 : f64 = cy + bp_btn_y();
        if (ask != FS_NONE and ask_card == ci) {
            round_rect(c, cx + 2.0 * BP_PAD, by2, bp_field_w(cw), BP_BTN_H, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.6 * a);
            cg_stroke_path(c);
            const pl2 : usize = @as(usize, tg[TPG_BA_PLEN]);
            var fn2 : usize = 0;
            if (ask == FS_TYPING) {
                fn2 = put_bytes(line[0..160], 0, "FLASH .bit path: ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, "_");
            } else {
                fn2 = put_bytes(line[0..160], 0, "load ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, " into SRAM?");
            }
            tg_txt(c, kit, line[0..fn2], cx + 2.0 * BP_PAD + 8.0, by2 + 16.0, 9.5, 0.0, a, cx + 2.0 * BP_PAD + bp_field_w(cw) - 6.0);
            tg_button(c, kit, cx + bp_confirm_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CONFIRM", mx >= cx + bp_confirm_x(cw) + BP_PAD and mx < cx + bp_confirm_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, ask == FS_CONFIRM, a);
            tg_button(c, kit, cx + bp_cancel_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CANCEL", mx >= cx + bp_cancel_x(cw) + BP_PAD and mx < cx + bp_cancel_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, true, a);
        } else {
            var bi : u32 = 0;
            while (bi < 3) {
                tg_button(c, kit, cx + BP_PAD + @as(f64, @floatFromInt(bi)) * (BP_BTN_W + BP_BTN_GAP) + 0.0, by2, BP_BTN_W, BP_BTN_H, act_label(@as(u8, @intCast(bi))), hit == ci * 8 + bi, act_enabled(st, @as(u8, @intCast(bi))), a);
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }
    // the run log of FLASH and UART: the last lines of ~/.t27os/bench/run.txt, control bytes shown as spaces
    const ly : f64 = y0 + bp_log_y();
    const lh : f64 = bp_log_h(ph);
    plate(c, x0 + BP_PAD, ly, cw, lh, full, a);
    var hn : usize = put_bytes(line[0..160], 0, "RUN LOG  ");
    if (tg[TPG_BA_PID] != 0) {
        hn = put_bytes(line[0..160], hn, "running ");
        hn = put_bytes(line[0..160], hn, act_label(@as(u8, @intCast(tg[TPG_BA_KIND]))));
    } else if (tg[TPG_BA_RLEN] > 0) {
        hn = put_bytes(line[0..160], hn, "last output of the host job");
    } else {
        hn = put_bytes(line[0..160], hn, "nothing run yet; FLASH asks for a .bit path and a confirm");
    }
    tg_txt(c, kit, line[0..hn], x0 + BP_PAD + 12.0, ly + 15.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, x0 + BP_PAD + cw - 10.0);
    const rl : usize = @as(usize, tg[TPG_BA_RLEN]);
    var rows : u32 = 0;
    if (lh > 40.0) { rows = @as(u32, @intFromFloat((lh - 28.0) / 12.0)); }
    // walk back from the end over `rows` lines
    var from : usize = rl;
    var seen : u32 = 0;
    while (from > 0 and seen < rows) {
        from = from - 1;
        if (tb[TBO_RUN + from] == 10 or tb[TBO_RUN + from] == 13) {
            if (from + 1 < rl) { seen = seen + 1; }
        }
    }
    var ry : f64 = ly + 30.0;
    var s0 : usize = from;
    while (s0 < rl and ry < ly + lh - 4.0) {
        var e0 : usize = s0;
        var ob : [120]u8 = undefined;
        var on : usize = 0;
        while (e0 < rl and tb[TBO_RUN + e0] != 10 and tb[TBO_RUN + e0] != 13) {
            const ch : u8 = tb[TBO_RUN + e0];
            if (on < 120) {
                if (ch >= 32 and ch < 127) { ob[on] = ch; } else { ob[on] = 32; }
                on = on + 1;
            }
            e0 = e0 + 1;
        }
        if (on > 0) {
            tg_txt(c, kit, ob[0..on], x0 + BP_PAD + 12.0, ry, 8.5, 0.0, 0.82 * a, x0 + BP_PAD + cw - 10.0);
            ry = ry + 12.0;
        }
        s0 = e0 + 1;
    }
}

// ---- K: the KANBAN host feed, the board and the drops ----

/// Read both feed files into the board's log: issues first, then pull requests, whole lines only.
fn kn_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const half : usize = @as(usize, FEED_CAP / 2);
    var n1 : usize = tg_read(hb, KANBAN_DIR, FILE_ISSUES, tb[TBO_KAN .. TBO_KAN + half]);
    n1 = tg_whole_lines(tb, TBO_KAN, n1);
    var n2 : usize = tg_read(hb, KANBAN_DIR, FILE_PRS, tb[TBO_KAN + n1 .. TBO_KAN + @as(usize, FEED_CAP)]);
    n2 = tg_whole_lines(tb, TBO_KAN + n1, n2);
    tg[TPG_K_LEN] = @as(u64, n1 + n2);
}

// ---- L: LANES and ACTORS in the chat sidebar (lanes_view.t27) ----

pub const TBO_LF : usize = 49152;
pub const TBO_LF_N : usize = 6000;
pub const TBO_LT : usize = 55152;
pub const TBO_LT_N : usize = 4800;
pub const TBO_LTXT : usize = 59952;
pub const TB_LANES_END : usize = 65536;
pub const TPG_L_LAST : u32 = 76;
pub const TPG_L_PID : u32 = 77;
pub const TPG_L_START : u32 = 78;
pub const TPG_L_LEN : u32 = 79;
pub const TPG_L_TPID : u32 = 80;
pub const TPG_L_TLEN : u32 = 81;
pub const TPG_L_TLAST : u32 = 82;
pub const TPG_L_TISSUE : u32 = 83;
/// sst[0..32] are the sessions' states; sst[SST_LV ..] is the lanes table the sidebar draws.
pub const SST_LVN : usize = 32;
pub const SST_LVOFF : usize = 33;
pub const SST_LVSEL : usize = 34;
pub const SST_LVTAIL : usize = 35;
pub const SST_LVKEY : usize = 36;
/// the log view's scroll (lines up from the bottom) and whether the kernel group is expanded
pub const SST_LVLSCR : usize = 38;
pub const SST_LVKX : usize = 39;
/// the pane server's phase (term_pane SRV_*), kept for the banner
pub const SST_SRV : usize = 556;
pub const SST_LV : usize = 40;
pub const SST_SIZE : usize = 560;
pub const LV_TAIL_LINES : u32 = 40;

/// Where the LANES block starts: right under the last AGENTS row (or its empty line).
pub fn lane_block_top(n: u32, rows: u32) -> f64 {
    var r : u32 = rows;
    if (r == 0) { r = 1; }
    return row_top(WS_TOP, GROUP_AGENTS, n, r - 1) + AGENT_ROW_H + 8.0;
}

/// Rows of the block that fit above the sidebar foot.
pub fn lane_block_vis(top: f64, sh: f64) -> u32 { return lv_visible(sh - FOOT_H - top); }

/// Is the point in the LANES block of the expanded sidebar?
pub fn on_lane_block(x: f64, y: f64, top: f64, sh: f64) -> bool {
    return x >= 12.0 and x < SIDE_W - 12.0 and y >= top and y < sh - FOOT_H;
}

/// One run of the feed job and its reap; the tail job likewise, again every two seconds while a tail is open.
fn lanes_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, up: bool, tail_issue: u32) -> void {
    if (tg[TPG_L_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_L_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_L_START], tg[TPG_L_PID]);
        } else {
            tg[TPG_L_PID] = 0;
            const n : usize = tg_read(hb, LV_DIR, LV_FILE, tb[TBO_LF .. TBO_LF + TBO_LF_N]);
            tg[TPG_L_LEN] = @as(u64, tg_whole_lines(tb, TBO_LF, n));
            tg_bump(tg);
        }
    } else if (lv_refresh_due(up, now, tg[TPG_L_LAST])) {
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = put_bytes(tb, e, LV_FEED_CMD);
        tg[TPG_L_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_L_PID] = pid;
            tg[TPG_L_START] = now;
        }
    }
    if (tg[TPG_L_TPID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_L_TPID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_L_TLAST], tg[TPG_L_TPID]);
        } else {
            tg[TPG_L_TPID] = 0;
            tg[TPG_L_TLEN] = @as(u64, tg_read(hb, LV_DIR, LV_TAIL_FILE, tb[TBO_LT .. TBO_LT + TBO_LT_N]));
            tg_bump(tg);
        }
    } else if (tail_issue != 0 and (tg[TPG_L_TLAST] == 0 or now >= tg[TPG_L_TLAST] + 2 or tg[TPG_L_TISSUE] != @as(u64, tail_issue))) {
        var e2 : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e2 = e2 + lv_tail_cmd(tail_issue, tb[e2 .. TBO_ROOT]);
        tg[TPG_L_TLAST] = now;
        tg[TPG_L_TISSUE] = @as(u64, tail_issue);
        const pid2 : u64 = tg_spawn(tb, TBO_CMD, e2);
        if (pid2 != 0) { tg[TPG_L_TPID] = pid2; }
    }
}

/// Rebuild the table the sidebar draws: this space's panes, the script lanes and own-git lines of the feed, the
/// Queen, the kernel tree. Called when the generation moved or a session changed; the table lives in sst.
fn lanes_build(sst: []u32, tb: []u8, tg: []const u64, ss: u64, space: u32, god: bool, now: u32) -> void {
    var n : u32 = 0;
    const rows : u32 = sessions_in(ss, space);
    var r : u32 = 0;
    var nm : [32]u8 = undefined;
    while (r < rows and r < 16) {
        const si : u32 = session_at_row(ss, space, r);
        const k : u32 = session_agent(ss, si);
        const ln : usize = csv_field(AGENT_NAMES, k, nm[0..32]);
        n = lv_pane_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, nm[0..ln], 0, 0, row_state(sst, si), false, 1, LV_NOT_MEASURED);
        r = r + 1;
    }
    n = lv_parse(tb[TBO_LF .. TBO_LF + @as(usize, tg[TPG_L_LEN])], now, sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    // the Queen's numbers come from the rows above (her lanes), counted before the own-git lines fold
    const tabv : []const u32 = sst[SST_LV .. SST_SIZE];
    const q_run : u32 = lv_work_count(tabv, n, LVS_RUNNING);
    const q_idle : u32 = lv_work_count(tabv, n, LVS_IDLE);
    const q_blk : u32 = lv_work_count(tabv, n, LVS_BLOCKED);
    const q_rev : u32 = lv_count(tabv, n, LVS_READY);
    n = lv_queen_counts_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, q_run, q_idle, q_blk, q_rev, god);
    if (q_run == 0 and q_blk == 0) { n = lv_note_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n); }
    var ls : [16]u32 = undefined;
    var lj : u32 = 0;
    var lanes : u32 = 0;
    while (lj < n and lanes < 16) {
        if (sst[SST_LV + @as(usize, lj) * LV_F + LVF_SRC] == LV_SCRIPT) {
            ls[lanes] = sst[SST_LV + @as(usize, lj) * LV_F + LVF_STATE];
            lanes = lanes + 1;
        }
        lj = lj + 1;
    }
    n = lv_fold_trigit(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_kernel_rows(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, lanes, ls[0..16]);
    lv_sort(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_fold_kernel(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, sst[SST_LVKX] != 0);
    sst[SST_LVN] = n;
    sst[SST_LVOFF] = lv_scroll_clamp(sst[SST_LVOFF], n, 8);
    if (sst[SST_LVSEL] != LV_NONE) {
        var found : u32 = LV_NONE;
        var fj : u32 = 0;
        while (fj < n and found == LV_NONE) {
            if (sst[SST_LV + @as(usize, fj) * LV_F + LVF_SRC] == sst[SST_LVKEY] and sst[SST_LV + @as(usize, fj) * LV_F + LVF_ISSUE] == sst[SST_LVKEY + 1]) { found = fj; }
            fj = fj + 1;
        }
        sst[SST_LVSEL] = found;
    }
}

fn kanban_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_K_LOADED] == 0) {
        kn_load(tg, tb, hb);
        tg[TPG_K_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_K_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_K_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_K_START], tg[TPG_K_PID]);
        } else {
            tg[TPG_K_PID] = 0;
            kn_load(tg, tb, hb);
            tg[TPG_K_AT] = now;
            tg[TPG_K_PNUM] = 0;
            tg[TPG_K_ACT] = 0;
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_KANBAN, open, now, tg[TPG_K_LAST])) {
        var e : usize = tg_head(tb, hb, K_HEAD_A, K_HEAD_B);
        e = put_bytes(tb, e, GH_ISSUES_A);
        e = put_bytes(tb, e, JQ_ISSUES);
        e = put_bytes(tb, e, GH_ISSUES_B);
        e = put_bytes(tb, e, GH_PRS_A);
        e = put_bytes(tb, e, JQ_PRS);
        e = put_bytes(tb, e, GH_PRS_B);
        tg[TPG_K_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_K_PID] = pid;
            tg[TPG_K_START] = now;
        }
    }
}

/// The board is drawn below a 22 pt head strip.
pub const KN_HEAD : f64 = 22.0;

/// Column under x and the card line under (x, y) of the board at (x0, y0) pw x ph; KB_NONE for none.
fn kn_col_under(x: f64, pw: f64, x0: f64) -> u32 { return kb_col_at(pw, x - x0); }

fn kn_card_under(tg: []const u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> u32 {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const col : u32 = kb_col_at(pw, x - x0);
    if (col >= KB_COLS) { return KB_NONE; }
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const cnt : u32 = kb_count(log, col, pnum, pto);
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    var shown : u32 = 0;
    if (cnt > sc) { shown = cnt - sc; }
    if (shown > rows) { shown = rows; }
    const i : u32 = kb_card_at(shown, pw, col, x - x0, y - (y0 + KN_HEAD));
    if (i >= shown) { return KB_NONE; }
    return kb_nth(log, col, sc + i, pnum, pto);
}

/// Mouse down on the board: pick up the card under the pointer.
fn kanban_down(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    const ls : u32 = kn_card_under(tg, tb, x, y, x0, y0, pw, ph);
    if (ls == KB_NONE) { return; }
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    tg[TPG_K_DRAG] = @as(u64, ls) + 1;
    tg[TPG_K_FROM] = @as(u64, kn_col_under(x, pw, x0));
    tg_bump(tg);
}

/// Mouse up: the drop. Only the rules of kanban.t27 decide; an accepted move is a proposal kept on the board
/// until the next refresh (no GitHub write, no agent started), a refused one only says so.
fn kanban_up(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64) -> void {
    if (tg[TPG_K_DRAG] == 0) { return; }
    const ls : u32 = @as(u32, @intCast(tg[TPG_K_DRAG] - 1));
    tg[TPG_K_DRAG] = 0;
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const to : u32 = kn_col_under(x, pw, x0);
    tg_bump(tg);
    if (to >= KB_COLS or y < y0 + KN_HEAD) { return; }
    const from : u32 = @as(u32, @intCast(tg[TPG_K_FROM]));
    const doing : u32 = kb_count(log, kb_doing(), 0, 0);
    const act : u32 = kb_drop(from, to, doing);
    if (to == kb_col_of(log, ls)) {
        // back where the rule puts it: the proposal is gone
        tg[TPG_K_PNUM] = 0;
        tg[TPG_K_ACT] = 0;
        return;
    }
    tg[TPG_K_ACT] = @as(u64, act);
    if (kb_proposes(act)) {
        tg[TPG_K_PNUM] = @as(u64, kb_num(log, ls));
        tg[TPG_K_PTO] = @as(u64, to);
    }
}

fn kanban_scroll(tg: []u64, tb: []const u8, ph: f64, dir: i64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    var most : u32 = 0;
    var c : u32 = 0;
    while (c < KB_COLS) {
        const n : u32 = kb_count(log, c, pnum, pto);
        if (n > most) { most = n; }
        c = c + 1;
    }
    var maxs : u32 = 0;
    if (most > rows) { maxs = most - rows; }
    var s : i64 = @as(i64, @intCast(tg[TPG_K_SCROLL])) + dir;
    if (s < 0) { s = 0; }
    if (s > @as(i64, maxs)) { s = @as(i64, maxs); }
    tg[TPG_K_SCROLL] = @as(u64, @intCast(s));
    tg_bump(tg);
}

/// One card: id and badge, the title, the pinned agents (owner first, bold), a GUESS mark when no path named a letter.
fn draw_kn_card(c: u64, kit: [48]u64, tb: []const u8, len: usize, ls: u32, x: f64, y: f64, w: f64, hot: bool, proposed: bool, ghost: bool, full: bool, a0: f64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + len];
    var a : f64 = a0;
    if (ghost) { a = a0 * 0.55; }
    plate(c, x, y, w, kb_card_h(), full, a);
    if (hot) {
        round_rect(c, x, y, w, kb_card_h(), TILE_CORNER);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
        cg_stroke_path(c);
    }
    if (proposed) { dashed_frame(c, x + 1.0, y + 1.0, w - 2.0, kb_card_h() - 2.0, a); }
    var hb : [48]u8 = undefined;
    var n : usize = 0;
    if (kb_is_pr(log, ls)) { n = put_bytes(hb[0..48], 0, "PR #"); } else { n = put_bytes(hb[0..48], 0, "#"); }
    n = put_dec(hb[0..48], n, @as(u64, kb_num(log, ls)));
    const iw : f64 = tg_txt(c, kit, hb[0..n], x + 7.0, y + 14.0, 9.0, WEIGHT_BOLD, a, 0.0);
    // the badge: a PR shows its checks, an issue its first label
    const cb : u32 = kb_checks_byte(log, ls);
    if (cb == 114) { tg_txt(c, kit, "checks running", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 112) { tg_txt(c, kit, "checks pass", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 102) { tg_txt(c, kit, "checks FAIL", x + 7.0 + iw + 8.0, y + 14.0, 8.0, WEIGHT_BOLD, 0.95 * a, x + w - 6.0); }
    const bn : u32 = kb_badge_n(log, ls);
    if (cb == 0 and bn > 0) {
        const bs : usize = @as(usize, kb_badge_at(log, ls));
        tg_txt(c, kit, tb[TBO_KAN + bs .. TBO_KAN + bs + @as(usize, bn)], x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.55 * a, x + w - 6.0);
    }
    const tn : usize = @as(usize, kb_title_n(log, ls));
    const ts : usize = @as(usize, kb_title_at(log, ls));
    tg_txt(c, kit, tb[TBO_KAN + ts .. TBO_KAN + ts + tn], x + 7.0, y + 30.0, 9.5, WEIGHT_SEMIBOLD, a, x + w - 6.0);
    // the agents: owner first, bold; on hover the full line
    const na : u32 = kb_agents(log, ls);
    var k : u32 = 0;
    while (k < na) {
        const l : u32 = kb_agent(log, ls, k);
        const chx : f64 = x + 7.0 + @as(f64, @floatFromInt(k)) * (kb_chip_w() + 2.0);
        const chy : f64 = y + kb_card_h() - kb_chip_h() - 5.0;
        round_rect(c, chx, chy, kb_chip_w(), kb_chip_h(), 3.0);
        cg_line_width(c, 1.0);
        var ka : f64 = 0.3;
        if (k == 0) { ka = 0.7; }
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
        cg_stroke_path(c);
        var wgt : f64 = 0.0;
        if (k == 0) { wgt = WEIGHT_BOLD; }
        if (l >= 1 and l <= 27) { tg_txt(c, kit, AGENT_LETTERS[l - 1], chx + 4.0, chy + 11.5, 8.5, wgt, a, 0.0); }
        k = k + 1;
    }
    if (card_guess(log, ls)) {
        tg_txt(c, kit, "GUESS", x + w - 40.0, y + kb_card_h() - 10.0, 7.5, 0.0, 0.45 * a, 0.0);
    }
    if (proposed) {
        tg_txt(c, kit, "PROPOSED", x + w - 56.0, y + 14.0, 7.5, WEIGHT_BOLD, 0.9 * a, 0.0);
    }
    if (hot) {
        var al : [64]u8 = undefined;
        var an : usize = put_bytes(al[0..64], 0, "AGENTS:");
        var q : u32 = 0;
        while (q < na) {
            an = put_bytes(al[0..64], an, " ");
            an = put_bytes(al[0..64], an, AGENT_LETTERS[kb_agent(log, ls, q) - 1]);
            q = q + 1;
        }
        if (card_guess(log, ls)) { an = put_bytes(al[0..64], an, " (guess: no path names a letter)"); }
        tg_txt(c, kit, al[0..an], x + 7.0, y + kb_card_h() - 22.0 + 0.0, 7.5, WEIGHT_SEMIBOLD, 0.8 * a, x + w - 6.0);
    }
}

fn draw_kanban_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, full: bool, a: f64, now: u64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const bx : f64 = x0;
    const by : f64 = y0 + KN_HEAD;
    const bh : f64 = ph - KN_HEAD;
    const rows : u32 = kb_rows_fit(bh);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    const drag : u32 = @as(u32, @intCast(tg[TPG_K_DRAG]));
    var line : [200]u8 = undefined;
    // head strip: BOARD, the data's age, the message of the last drop
    var hn : usize = put_bytes(line[0..200], 0, "BOARD  gHashTag/t27  ");
    if (tg[TPG_K_LEN] == 0) {
        hn = put_bytes(line[0..200], hn, "not measured: gh issue list / gh pr list gave nothing yet");
    } else if (tg[TPG_K_AT] > 0) {
        hn = put_bytes(line[0..200], hn, "gh refreshed ");
        hn = put_dec(line[0..200], hn, now - tg[TPG_K_AT]);
        hn = put_bytes(line[0..200], hn, " s ago, every 60 s while open");
    } else {
        hn = put_bytes(line[0..200], hn, "last saved copy, refreshing");
    }
    tg_txt(c, kit, line[0..hn], bx + kb_pad(), y0 + 14.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, bx + 0.55 * pw);
    const act : u32 = @as(u32, @intCast(tg[TPG_K_ACT]));
    if (kb_text(act).len > 0) {
        tg_txt(c, kit, kb_text(act), bx + 0.55 * pw, y0 + 14.0, 8.5, 0.0, 0.9 * a, bx + pw - kb_pad());
    }
    const hotls : u32 = kn_card_under(tg, tb, mx, my, x0, y0, pw, ph);
    const hotcol : u32 = kn_col_under(mx, pw, x0);
    var c2 : u32 = 0;
    while (c2 < KB_COLS) {
        const cx : f64 = bx + kb_col_x(c2, pw);
        const cwid : f64 = kb_col_w(pw);
        plate(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), full, a);
        const cnt : u32 = kb_count(log, c2, pnum, pto);
        var cn : usize = put_bytes(line[0..200], 0, kb_col_name(c2));
        cn = put_bytes(line[0..200], cn, "  ");
        cn = put_dec(line[0..200], cn, @as(u64, cnt));
        if (c2 == kb_doing()) { cn = put_bytes(line[0..200], cn, " / 3"); }
        tg_txt(c, kit, line[0..cn], cx + 8.0, by + kb_pad() + 18.0, 9.5, WEIGHT_BOLD, a, cx + cwid - 6.0);
        if (drag != 0 and hotcol == c2) {
            const act2 : u32 = kb_drop(@as(u32, @intCast(tg[TPG_K_FROM])), c2, kb_count(log, kb_doing(), 0, 0));
            round_rect(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), TILE_CORNER);
            cg_line_width(c, 1.5);
            var ha : f64 = 0.25;
            if (kb_proposes(act2)) { ha = 0.9; }
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, ha * a);
            cg_stroke_path(c);
        }
        var shown : u32 = 0;
        if (cnt > sc) { shown = cnt - sc; }
        if (shown > rows) { shown = rows; }
        var i : u32 = 0;
        while (i < shown) {
            const ls : u32 = kb_nth(log, c2, sc + i, pnum, pto);
            if (ls != KB_NONE) {
                const isdrag : bool = drag != 0 and ls + 1 == drag;
                draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), ls, bx + kb_card_x(c2, pw), by + kb_card_y(i), kb_card_w(pw), hotls == ls and drag == 0, pnum != 0 and kb_num(log, ls) == pnum and pto == c2, isdrag, full, a);
            }
            i = i + 1;
        }
        if (cnt > sc + shown) {
            var mn : usize = put_bytes(line[0..200], 0, "+");
            mn = put_dec(line[0..200], mn, @as(u64, cnt - sc - shown));
            mn = put_bytes(line[0..200], mn, " more (scroll)");
            tg_txt(c, kit, line[0..mn], cx + 8.0, by + bh - kb_pad() - 4.0, 8.0, 0.0, 0.5 * a, cx + cwid - 6.0);
        }
        c2 = c2 + 1;
    }
    if (drag != 0) {
        draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), drag - 1, mx - 0.5 * kb_card_w(pw), my - 12.0, kb_card_w(pw), true, false, false, full, a);
    }
}

// ---- Q: the QUEEN live board ----

/// The folder the host jobs of the Q page run in: the repository of the space on screen, else the first bound
/// space. Written to tb[TBO_ROOT ..]; the byte count (0 when no space is bound).
fn qn_root(dk: [128]u64, space: u32, tb: []u8) -> usize {
    var found : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
    if (dk_len(dk, found) == 0) {
        var i : u32 = 0;
        while (i < SPACE_COUNT and dk_len(dk, found) == 0) {
            found = dk_at(dk, dk[DK_SLOTS], @as(u64, i));
            i = i + 1;
        }
    }
    if (dk_len(dk, found) == 0) { return 0; }
    return ns_bytes(found, tb[TBO_ROOT .. TBO_ROOT + 256]);
}

/// The value of counter m now: the host's two files, the two the window knows, the rest not measured.
fn qn_after(tg: []const u64, m: u32) -> u32 {
    if (m == M_LINKS or m == M_TESTS) { return @as(u32, @intCast(tg[TPG_Q_AFTER + m])); }
    if (m == M_NO_INSTRUMENT) { return live_no_instrument(); }
    if (m == M_UNASSIGNED) { return @as(u32, @intCast(tg[TPG_Q_UNASS])); }
    return qb_nm();
}

/// A refresh ended (or none could run): the lane log, and the start-of-day snapshot at the first refresh of a local day.
fn qn_finish(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    tg[TPG_Q_LANELEN] = @as(u64, tg_whole_lines(tb, TBO_LANES, tg_read(hb, QUEEN_DIR, FILE_LANES, tb[TBO_LANES .. TBO_CMD - 200])));
    const tz : i64 = @as(i64, @intCast(tg[TPG_Q_TZ])) - @as(i64, @intCast(TG_TZ_BIAS));
    if (snapshot_due(now, tg[TPG_Q_SNAP], tz)) {
        var m : u32 = 0;
        while (m < M_COUNT) {
            tg[TPG_Q_BEFORE + m] = @as(u64, qn_after(tg, m));
            m = m + 1;
        }
        tg[TPG_Q_SNAP] = now;
    }
    tg[TPG_Q_AT] = now;
    tg_bump(tg);
}

fn queen_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_Q_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_Q_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_Q_START], tg[TPG_Q_PID]);
        } else {
            tg[TPG_Q_PID] = 0;
            const n1 : usize = tg_read(hb, QUEEN_DIR, FILE_LINKS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_LINKS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n1]));
            const n2 : usize = tg_read(hb, QUEEN_DIR, FILE_TESTS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_TESTS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n2]));
            qn_finish(tg, tb, hb, now);
        }
    } else if (page_feed_due(PAGE_QUEEN, open, now, tg[TPG_Q_LAST])) {
        tg[TPG_Q_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            var e : usize = tg_head(tb, hb, Q_HEAD_A, Q_HEAD_B);
            e = put_bytes(tb, e, tb[TBO_ROOT .. TBO_ROOT + rn]);
            e = put_bytes(tb, e, Q_HEAD_C);
            e = put_bytes(tb, e, meter_cmd(M_LINKS));
            e = put_bytes(tb, e, Q_LINKS_TAIL);
            e = put_bytes(tb, e, meter_cmd(M_TESTS));
            e = put_bytes(tb, e, Q_TESTS_TAIL);
            const pid : u64 = tg_spawn(tb, TBO_CMD, e);
            if (pid != 0) {
                tg[TPG_Q_PID] = pid;
                tg[TPG_Q_START] = now;
                return;
            }
        }
        tg[TPG_Q_AFTER + M_LINKS] = @as(u64, qb_nm());
        tg[TPG_Q_AFTER + M_TESTS] = @as(u64, qb_nm());
        qn_finish(tg, tb, hb, now);
    }
}

// ---- the updater (release.t27): the window hosts the rules --------------------------------------------------
// Owner, 2026-10-20: updates install on every computer on the fly, online. release.t27 decides every step and
// writes every command; this block spawns the commands as `/bin/sh -c` jobs (tg_spawn), reaps them from the
// frame loop and reads their files. Words TPG_U_*; the job kinds below.
pub const TPG_U_ST : u32 = 90;
pub const TPG_U_PID : u32 = 91;
pub const TPG_U_KIND : u32 = 92;
pub const TPG_U_START : u32 = 93;
pub const TPG_U_LAST : u32 = 94;
pub const TPG_U_CUR : u32 = 95;
pub const TPG_U_CAND : u32 = 96;
pub const TPG_U_CANDV : u32 = 97;
pub const TPG_U_WHY : u32 = 98;
pub const TPG_U_GO : u32 = 99;
pub const TPG_U_QUIET : u32 = 100;
pub const TPG_U_BOOT : u32 = 101;
pub const TPG_U_UP0 : u32 = 102;
pub const TPG_U_MARK : u32 = 103;
pub const TPG_U_FAILB : u32 = 104;
pub const TPG_U_BLEN : u32 = 105;
pub const TPG_U_BUSY : u32 = 106;
pub const TPG_U_ON : u32 = 107;
pub const TPG_U_STAGED : u32 = 108;
pub const UP_CHECK : u64 = 1;
pub const UP_DOWNLOAD : u64 = 2;
pub const UP_STAGE : u64 = 3;
pub const UP_SWAP : u64 = 4;
pub const UP_MARK : u64 = 5;
pub const UP_CONFIRM : u64 = 6;
pub const UP_ROLLBACK : u64 = 7;
/// The manifest is read into tb[TBO_SCR ..], then the sums (two files, one after the other) and the three
/// --version outputs; the room is TBO_SCR .. TBO_SIZE.
pub const UP_MAN : usize = 2048;
pub const UP_SUMS : usize = 2560;
pub const UP_VER : usize = 128;
pub const UP_CAP : usize = 6000;
/// A job that outlives this is killed; the download is the long one.
pub const UP_KILL_CHECK_S : u64 = 60;
pub const UP_KILL_LONG_S : u64 = 900;

/// Panes the server lists as working or blocked on you: the swap never happens while one is.
fn up_busy(sst: []const u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < 32) {
        const s : u32 = row_state(sst, i);
        if (s == S_WORKING or s == S_BLOCKED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Start the command that a release.t27 builder wrote at tb[TBO_CMD + 6 ..] (n bytes); false when it did not fit or did not start.
fn up_start(tg: []u64, tb: []u8, n: usize, kind: u64, now: u64) -> bool {
    if (n == 0 or n > UP_CAP) { return false; }
    const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + n);
    if (pid == 0) { return false; }
    tg[TPG_U_PID] = pid;
    tg[TPG_U_KIND] = kind;
    tg[TPG_U_START] = now;
    return true;
}

fn up_fail(tg: []u64, why: u8, mark_bad: bool) -> void {
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_FAILED, 0));
    tg[TPG_U_WHY] = @as(u64, why);
    tg[TPG_U_GO] = 0;
    if (mark_bad) { tg[TPG_U_FAILB] = tg[TPG_U_CAND]; }
}

/// The digits at the start of a small file (a build number followed by a newline).
fn up_num(tb: []const u8, at: usize, n: usize) -> u32 {
    var e : usize = 0;
    while (e < n and tb[at + e] >= 48 and tb[at + e] <= 57) { e = e + 1; }
    return parse_build(tb[at .. at + e], e);
}

/// The first start of this process: act on the marker an earlier swap left, and learn the build a rollback refused.
fn up_boot(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64) -> void {
    tg[TPG_U_BOOT] = 1;
    tg[TPG_U_UP0] = now;
    const rn : usize = tg_read(hb, UPD_DIR, F_REJECTED, tb[TBO_SCR .. TBO_SCR + 16]);
    tg[TPG_U_FAILB] = @as(u64, up_num(tb, TBO_SCR, rn));
    const mn : usize = tg_read(hb, UPD_DIR, F_PENDING, tb[TBO_SCR .. TBO_SCR + 8]);
    const mk : u8 = marker_of(mn > 0, tb[TBO_SCR]);
    const kn : usize = tg_read(hb, UPD_DIR, F_KEPT, tb[TBO_SCR .. TBO_SCR + 8]);
    const act : u8 = boot_action(mk, kn > 0);
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (act == BOOT_FIRST) {
        tg[TPG_U_MARK] = 1;
        up_start(tg, tb, mark_cmd(out, UP_CAP, hb, hb.len), UP_MARK, now);
    } else if (act == BOOT_ROLLBACK) {
        up_start(tg, tb, rollback_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CUR]))), UP_ROLLBACK, now);
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    } else if (act == BOOT_BROKEN) {
        tg[TPG_U_MARK] = 1;
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    }
}

/// A poll finished: judge the manifest it fetched and start the download of a newer build.
fn up_checked(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    const chk : u8 = manifest_check(man, mn);
    const cb : u64 = manifest_build(man, mn);
    var bld : u32 = 0;
    if (cb != NO_FIELD) { bld = @as(u32, @intCast(cb)); }
    const ver : u64 = manifest_version(man, mn);
    const off : u8 = offer(chk, ver, bld, current_version(), @as(u32, @intCast(tg[TPG_U_CUR])), @as(u32, @intCast(tg[TPG_U_FAILB])), true);
    var st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    if (off == OFFER_UPDATE) {
        tg[TPG_U_CAND] = @as(u64, bld);
        tg[TPG_U_CANDV] = ver;
        tg[TPG_U_WHY] = @as(u64, WHY_NONE);
        if (tg[TPG_U_STAGED] == @as(u64, bld)) {
            tg[TPG_U_ST] = @as(u64, U_STAGED);
            return;
        }
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_OFFER, 0));
        if (up_start(tg, tb, download_cmd(out, UP_CAP, hb, hb.len, ver, bld), UP_DOWNLOAD, now) == false) { up_fail(tg, WHY_DOWNLOAD, false); }
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(st, EV_NO_OFFER, 0));
    tg[TPG_U_WHY] = @as(u64, WHY_NONE);
    if (off == OFFER_BAD_MANIFEST) { tg[TPG_U_WHY] = @as(u64, WHY_MANIFEST); }
}

/// The download finished: its digests against the manifest, then the stage job.
fn up_downloaded(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    var fb : [48]u8 = undefined;
    const fn1 : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const sn : usize = tg_read(hb, UPD_DIR, fb[0..fn1], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + sn], sn, tb[TBO_SCR .. TBO_SCR + mn], mn, 0, ROWS_DOWNLOADED);
    if (bad != 0) {
        up_fail(tg, WHY_SHA, true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_DOWNLOADED, 0));
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (up_start(tg, tb, stage_cmd(out, UP_CAP, hb, hb.len, tg[TPG_U_CANDV], b), UP_STAGE, now) == false) { up_fail(tg, WHY_STAGE, false); }
}

/// The stage finished (unzipped, signed, versions asked): every digest, every tool's commit, then staged or refused.
fn up_staged(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    var fb : [48]u8 = undefined;
    var fl : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const s1 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    fl = put_build_file(fb[0..48], 48, 0, b, "sums2.txt");
    const s2 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN + s1 .. TBO_SCR + UP_SUMS + 140]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + s1 + s2], s1 + s2, man, mn, 0, ROWS_ALL);
    const cm : u64 = field_str(man, mn, KEY_COMMIT, KEY_COMMIT.len);
    var want : []const u8 = man[0..0];
    if (cm != NO_FIELD) { want = man[field_start(cm) .. field_start(cm) + field_len(cm)]; }
    var worst : u8 = TV_OK;
    var k : u32 = 0;
    while (k < 3) {
        const at : usize = TBO_SCR + UP_SUMS + 140 + @as(usize, k) * UP_VER;
        if (k == 0) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27b.txt"); }
        if (k == 1) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27c.txt"); }
        if (k == 2) { fl = put_build_file(fb[0..48], 48, 0, b, "v_tri.txt"); }
        const vn : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[at .. at + UP_VER]);
        worst = tv_worse(worst, tool_verdict(tb[at .. at + vn], vn, want, want.len));
        k = k + 1;
    }
    const d : u8 = install_decision(bad, worst, tg[TPG_U_BLEN] > 0);
    if (d != ID_INSTALL) {
        up_fail(tg, why_of_decision(d), true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_SIGNED, 0));
    tg[TPG_U_STAGED] = @as(u64, b);
}

/// A job ended (ok: it exited 0). Decide the next step.
fn up_finished(tg: []u64, tb: []u8, hb: []const u8, now: u64, kind: u64, ok: bool) -> void {
    if (kind == UP_CHECK) {
        if (ok) { up_checked(tg, tb, hb, now); } else { up_fail(tg, WHY_OFFLINE, false); }
    } else if (kind == UP_DOWNLOAD) {
        if (ok) { up_downloaded(tg, tb, hb, now); } else { up_fail(tg, WHY_DOWNLOAD, false); }
    } else if (kind == UP_STAGE) {
        if (ok) { up_staged(tg, tb, hb); } else { up_fail(tg, WHY_STAGE, true); }
    } else if (kind == UP_SWAP) {
        // a swap that worked ends in a relaunch (hot_reload); one that did not leaves the old app and says why
        if (ok == false) { up_fail(tg, WHY_SWAP, true); }
    }
}

/// One frame of the updater: reap the running job, else do the next thing that is due.
fn update_tick(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64, busy: u32) -> void {
    if (tg[TPG_U_ON] == 0) { return; }
    if (tg[TPG_U_BUSY] != @as(u64, busy)) {
        tg[TPG_U_BUSY] = @as(u64, busy);
        tg_bump(tg);
    }
    if (busy > 0) { tg[TPG_U_QUIET] = 0; } else if (tg[TPG_U_QUIET] == 0) { tg[TPG_U_QUIET] = now; }
    if (tg[TPG_U_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_U_PID]);
        if (d == 0) {
            var lim : u64 = UP_KILL_CHECK_S;
            if (tg[TPG_U_KIND] == UP_DOWNLOAD or tg[TPG_U_KIND] == UP_STAGE) { lim = UP_KILL_LONG_S; }
            if (now > tg[TPG_U_START] + lim) { sys_kill(@as(i32, @intCast(tg[TPG_U_PID])), 9); }
            return;
        }
        const kind : u64 = tg[TPG_U_KIND];
        tg[TPG_U_PID] = 0;
        up_finished(tg, tb, hb, now, kind, d == 1);
        tg_bump(tg);
        if (tg[TPG_U_PID] != 0) { return; }
    }
    if (tg[TPG_U_BOOT] == 0) {
        up_boot(tg, tb, hb, bp, now);
        tg_bump(tg);
        return;
    }
    if (tg[TPG_U_MARK] != 0 and confirm_due(now - tg[TPG_U_UP0])) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_MARK] = 0;
        up_start(tg, tb, confirm_cmd(out, UP_CAP, hb, hb.len), UP_CONFIRM, now);
        return;
    }
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    var quiet : u64 = 0;
    if (tg[TPG_U_QUIET] != 0 and now > tg[TPG_U_QUIET]) { quiet = now - tg[TPG_U_QUIET]; }
    if (swap_ready(st, busy, quiet, tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        const sn : usize = swap_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CAND])));
        tg[TPG_U_GO] = 0;
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_SWAP, busy));
        if (up_start(tg, tb, sn, UP_SWAP, now) == false) { up_fail(tg, WHY_SWAP, false); }
        tg_bump(tg);
        return;
    }
    if (st == U_IDLE and (check_due(now, tg[TPG_U_LAST]) or tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_LAST] = now;
        tg[TPG_U_GO] = 0;
        if (up_start(tg, tb, check_cmd(out, UP_CAP, hb, hb.len), UP_CHECK, now)) {
            tg[TPG_U_ST] = @as(u64, update_step(st, EV_CHECK, busy));
        }
        tg_bump(tg);
    }
}

pub const UP_STRIP_H : f64 = 22.0;

/// The update line sits on the sidebar just above the foot, while there is something to say.
pub fn on_update_strip(x: f64, y: f64, sh: f64, ws: u32, collapsed: bool, shown: bool) -> bool {
    return shown and in_side(x, ws, collapsed) and y >= sh - FOOT_H - UP_STRIP_H and y < sh - FOOT_H;
}

fn draw_update_strip(c: u64, kit: [48]u64, tg: []const u64, mx: f64, my: f64, sh: f64, ws: u32, collapsed: bool, a: f64) -> void {
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    const why : u8 = @as(u8, @intCast(tg[TPG_U_WHY]));
    if (tg[TPG_U_ON] == 0 or strip_kind(st, why) == STRIP_HIDDEN) { return; }
    var w : [96]u8 = undefined;
    const n : usize = strip_text(w[0..96], 96, st, why, @as(u32, @intCast(tg[TPG_U_CAND])), @as(u32, @intCast(tg[TPG_U_BUSY])));
    if (n == 0 or n > 96) { return; }
    var la : f64 = LABEL_WHITE;
    if (on_update_strip(mx, my, sh, ws, collapsed, true) or strip_kind(st, why) == STRIP_READY) { la = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    draw_bytes(c, kit, w[0..96], n, 14.0, sh - FOOT_H - 8.0, 9.5, WEIGHT_SEMIBOLD, false);
}

/// The evolve Panel from what the window knows (see evolve_next): letters with no instrument, pinned to nothing, and widgets no letter owns.
fn make_panel(unassigned: u32) -> Panel {
    var p : Panel = Panel { master_red: false, blocked: 0, stale: 0, unowned_count: 0, no_instrument: 0, never_pinned: 0, no_widget_count: unassigned, no_widget: 0 };
    if (unassigned > 0) { p.no_widget = letter_bit(LETTER_UNOWNED); }
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (widgets_of_letter(l) == 0) { p.no_instrument = p.no_instrument + letter_bit(l); }
        if (pinned_widgets(l, false) + pinned_widgets(l, true) + pinned_surfaces(l, false) + pinned_surfaces(l, true) == 0) { p.never_pinned = p.never_pinned + letter_bit(l); }
        l = l + 1;
    }
    return p;
}

/// Tasks the Queen started in the last hour, read from the ring copy.
fn qn_started_hour(tg: []const u64, now: u64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < RING) {
        const e : u64 = tg[TPG_Q_RING + i];
        if (e != 0 and ev_control(e) == C_QUEEN_STARTED and now < ev_sec(e) + 3600) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn qn_node(c: u64, kit: [48]u64, n: u32, x0: f64, y0: f64, pw: f64, ph: f64, full: bool, a: f64) -> void {
    const nx : f64 = x0 + node_x(n, pw);
    const ny : f64 = y0 + node_y(n, pw, ph);
    plate(c, nx, ny, node_w(n, pw), node_h(n, pw, ph), full, a);
    var nb : [32]u8 = undefined;
    const nn : usize = csv_field(QN_NAMES, n, nb[0..32]);
    tg_txt(c, kit, nb[0..nn], nx + 10.0, ny + 14.0, 9.5, WEIGHT_BOLD, a, nx + node_w(n, pw) - 10.0);
}

fn draw_queen_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, full: bool, a: f64, now: u64) -> void {
    var line : [200]u8 = undefined;
    var wb : [64]u8 = undefined;
    const god : bool = tg[TPG_Q_GOD] != 0;
    var unp : u32 = @as(u32, @intCast(tg[TPG_Q_UNASS]));
    if (qb_measured(unp) == false) { unp = 0; }
    const panel : Panel = make_panel(unp);
    // ---- LAMPS: 27, each from the per-letter aggregate the host feeds; none is fed, so each says not measured
    qn_node(c, kit, QN_LAMPS, x0, y0, pw, ph, full, a);
    tg_txt(c, kit, "not measured: domain_pulse cannot be linked into the window yet (#5980)", x0 + node_x(QN_LAMPS, pw) + 70.0, y0 + node_y(QN_LAMPS, pw, ph) + 14.0, 8.0, 0.0, 0.5 * a, x0 + node_x(QN_LAMPS, pw) + node_w(QN_LAMPS, pw) - 10.0);
    var li : u32 = 0;
    while (li < LAMP_COUNT) {
        const lx : f64 = x0 + node_x(QN_LAMPS, pw) + lamp_x(li, pw);
        const ly : f64 = y0 + node_y(QN_LAMPS, pw, ph) + lamp_y(li, pw);
        const lw : f64 = lamp_w(pw);
        const stt : u32 = lamp_status(tb[0..0], li + 1);
        round_rect(c, lx, ly, lw, 40.0, 4.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.22 * a);
        cg_stroke_path(c);
        tg_txt(c, kit, AGENT_LETTERS[li], lx + 5.0, ly + 13.0, 9.5, WEIGHT_BOLD, a, lx + lw - 3.0);
        if (stt == LS_NONE) {
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_stroke_path(c);
            tg_txt(c, kit, "n/m", lx + 18.0, ly + 31.0, 7.5, 0.0, 0.45 * a, lx + lw - 2.0);
        } else {
            var fa : f64 = 0.3;
            if (stt == LS_WARM) { fa = 0.55; }
            if (stt == LS_ACTIVE or stt == LS_BLOCKED) { fa = 0.95; }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, fa * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_fill_path(c);
        }
        li = li + 1;
    }
    // ---- FEED: her actions newest first, the ring merged with the lane log
    qn_node(c, kit, QN_FEED, x0, y0, pw, ph, full, a);
    const fx : f64 = x0 + node_x(QN_FEED, pw);
    const fy : f64 = y0 + node_y(QN_FEED, pw, ph);
    const fw : f64 = node_w(QN_FEED, pw);
    const evn : u32 = @as(u32, @intCast(tg[TPG_Q_EVN]));
    const lanes : []const u8 = tb[TBO_LANES .. TBO_LANES + @as(usize, tg[TPG_Q_LANELEN])];
    var rb : u32 = 0;
    var lk : u32 = 0;
    var row : u32 = 0;
    const nrows : u32 = feed_rows(pw, ph);
    var shown : u32 = 0;
    while (row < nrows) {
        var rslot : u32 = ring_at(evn, rb);
        while (rslot != RING_NONE and feed_kind_of_control(ev_control(tg[TPG_Q_RING + rslot])) == FK_NONE) {
            rb = rb + 1;
            rslot = ring_at(evn, rb);
        }
        var rev : u64 = 0;
        if (rslot != RING_NONE) { rev = tg[TPG_Q_RING + rslot]; }
        const ls : u32 = lane_line_start(lanes, lk);
        var lsec : u64 = 0;
        var lleft : u32 = 0;
        if (ls != qb_nm()) { lsec = lane_sec(lanes, ls); lleft = 1; }
        var rleft : u32 = 0;
        if (rslot != RING_NONE) { rleft = 1; }
        const pick : u32 = merge_pick(rleft, ev_sec(rev), lleft, lsec);
        if (pick == qb_src_none()) { row = nrows; } else {
            const ry : f64 = fy + feed_row_y(row);
            var kind : u32 = FK_NONE;
            var sec : u64 = 0;
            var tn : usize = 0;
            var from_lane : bool = false;
            if (pick == qb_src_ring()) {
                kind = feed_kind_of_control(ev_control(rev));
                sec = ev_sec(rev);
                tn = put_bytes(line[0..200], 0, ring_text_head(kind));
                const lt : u32 = feed_letter_of_event(rev);
                if (lt != 0 and (kind == FK_LANE or kind == FK_ASKED)) { tn = put_bytes(line[0..200], tn, letter_char(lt)); }
                rb = rb + 1;
            } else {
                kind = lane_kind(lanes, ls);
                sec = lsec;
                from_lane = true;
                const ts : usize = @as(usize, lane_text_start(lanes, ls));
                const tl : usize = @as(usize, lane_text_len(lanes, ls));
                if (profile_ok(lanes[ts .. ts + tl])) {
                    const shown_n : usize = @as(usize, feed_text_len(@as(u32, @intCast(tl))));
                    tn = put_bytes(line[0..200], 0, lanes[ts .. ts + shown_n]);
                } else {
                    tn = put_bytes(line[0..200], 0, KEY_PLACEHOLDER);
                }
                lk = lk + 1;
            }
            tg_txt(c, kit, line[0..tn], fx + 10.0, ry + 13.0, 9.0, WEIGHT_SEMIBOLD, a, fx + fw - 10.0);
            var kn : usize = csv_field(FEED_WORDS, kind, wb[0..64]);
            kn = put_bytes(wb[0..64], kn, "  ");
            if (from_lane) { kn = put_bytes(wb[0..64], kn, "lane log"); } else { kn = put_bytes(wb[0..64], kn, "ring"); }
            tg_txt(c, kit, wb[0..kn], fx + 10.0, ry + 26.0, 8.0, 0.0, 0.5 * a, fx + fw - 70.0);
            var an : [32]u8 = undefined;
            const al : usize = csv_field(AGE_WORDS, age_word(now, sec), an[0..32]);
            const aw : f64 = bytes_w(kit, an[0..al], al, 8.0, 0.0, true);
            tg_txt(c, kit, an[0..al], fx + fw - 10.0 - aw, ry + 26.0, 8.0, 0.0, 0.6 * a, 0.0);
            shown = shown + 1;
            row = row + 1;
        }
    }
    if (shown == 0) {
        tg_txt(c, kit, "nothing yet: GOD MODE has not picked a gap, no lane has started", fx + 10.0, fy + 40.0, 8.5, 0.0, 0.5 * a, fx + fw - 10.0);
    }
    // ---- GAPS: the top ten in evolve order, each with why it is not started now
    qn_node(c, kit, QN_GAPS, x0, y0, pw, ph, full, a);
    const gx : f64 = x0 + node_x(QN_GAPS, pw);
    const gy : f64 = y0 + node_y(QN_GAPS, pw, ph);
    const gw : f64 = node_w(QN_GAPS, pw);
    const started : u32 = qn_started_hour(tg, now);
    const evfl : u32 = @as(u32, @intCast(tg[TPG_Q_EVFL]));
    var gi : u32 = 0;
    var gshown : u32 = 0;
    while (gi < GAP_ROWS) {
        const gry : f64 = gy + gap_row_y(gi, pw, ph);
        if (gry + gap_row_h(pw, ph) > gy + node_h(QN_GAPS, pw, ph)) {
            // the column holds fewer than ten rows at this height (GAP_ROW_MIN); the rest are cut, not drawn over the next widget
            gi = GAP_ROWS;
        } else if (row_exists(panel, gi)) {
            gshown = gshown + 1;
            const g : u32 = nth_gap(panel, gi);
            const kind2 : u32 = gap_kind_of(g);
            var pcn : usize = csv_field(CLASS_WORDS, class_of_kind(kind2), line[0..200]);
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, letter_char(gap_letter_of(g)));
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, kind_phrase(kind2));
            tg_txt(c, kit, line[0..pcn], gx + 10.0, gry + 12.0, 8.5, WEIGHT_SEMIBOLD, a, gx + gw - 10.0);
            const why : u32 = row_why(panel, gi, evfl, god, true, 0, started, 0, 0);
            var wn : usize = put_bytes(wb[0..64], 0, "now: ");
            wn = wn + csv_field(WN_WORDS, why, wb[wn .. 64]);
            tg_txt(c, kit, wb[0..wn], gx + 10.0, gry + gap_row_h(pw, ph) - 5.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
        }
        if (gi < GAP_ROWS) { gi = gi + 1; }
    }
    var gtn : usize = put_bytes(line[0..200], 0, "top ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gshown));
    gtn = put_bytes(line[0..200], gtn, " of ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gap_total(panel)));
    gtn = put_bytes(line[0..200], gtn, " gaps, evolve order");
    tg_txt(c, kit, line[0..gtn], gx + 50.0, gy + 14.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
    // ---- METER: before -> after since the start of the local day, each with its direction
    qn_node(c, kit, QN_METER, x0, y0, pw, ph, full, a);
    const mx0 : f64 = x0 + node_x(QN_METER, pw);
    const my0 : f64 = y0 + node_y(QN_METER, pw, ph);
    var mi : u32 = 0;
    while (mi < M_COUNT) {
        const cxm : f64 = mx0 + meter_cell_x(mi, pw);
        const cym : f64 = my0 + meter_cell_y(mi);
        const cwm : f64 = meter_cell_w(pw);
        const before : u32 = @as(u32, @intCast(tg[TPG_Q_BEFORE + mi]));
        const after : u32 = qn_after(tg, mi);
        const lb : usize = csv_field(M_LABELS, mi, line[0..200]);
        tg_txt(c, kit, line[0..lb], cxm + 4.0, cym + 10.0, 7.5, 0.0, 0.55 * a, cxm + cwm - 2.0);
        var vn : usize = 0;
        if (qb_measured(after)) { vn = put_dec(line[0..200], 0, @as(u64, after)); } else { vn = put_bytes(line[0..200], 0, "not measured"); }
        var vsize : f64 = 14.0;
        if (qb_measured(after) == false) { vsize = 9.0; }
        tg_txt(c, kit, line[0..vn], cxm + 4.0, cym + 28.0, vsize, WEIGHT_HEAVY, a, cxm + cwm - 2.0);
        const ds : u32 = delta_state(mi, before, after);
        var dn : usize = 0;
        if (ds == D_UNKNOWN) {
            dn = put_bytes(line[0..200], 0, "no baseline");
        } else {
            dn = put_bytes(line[0..200], 0, delta_sign(before, after));
            dn = put_dec(line[0..200], dn, @as(u64, delta_abs(before, after)));
            dn = put_bytes(line[0..200], dn, " ");
            dn = dn + csv_field(M_UNITS, mi, line[dn .. 200]);
            if (ds == D_BETTER) { dn = put_bytes(line[0..200], dn, "  better"); }
            if (ds == D_WORSE) { dn = put_bytes(line[0..200], dn, "  worse"); }
        }
        var da : f64 = 0.55;
        if (ds == D_BETTER) { da = 0.95; }
        tg_txt(c, kit, line[0..dn], cxm + 4.0, cym + 40.0, 7.5, 0.0, da * a, cxm + cwm - 2.0);
        mi = mi + 1;
    }
    var bc : u32 = 0;
    var bm : u32 = 0;
    while (bm < M_COUNT) {
        if (delta_state(bm, @as(u32, @intCast(tg[TPG_Q_BEFORE + bm])), qn_after(tg, bm)) == D_BETTER) { bc = bc + 1; }
        bm = bm + 1;
    }
    var hn2 : usize = put_dec(line[0..200], 0, @as(u64, bc));
    hn2 = put_bytes(line[0..200], hn2, " of 6 better since the start of the day");
    tg_txt(c, kit, line[0..hn2], mx0 + 90.0, my0 + 14.0, 8.0, 0.0, 0.6 * a, mx0 + node_w(QN_METER, pw) - 10.0);
    // ---- SAFETY: tasks this hour, agents against the cap, the key tier as a word, STOP
    qn_node(c, kit, QN_SAFETY, x0, y0, pw, ph, full, a);
    const sx : f64 = x0 + node_x(QN_SAFETY, pw);
    const sy : f64 = y0 + node_y(QN_SAFETY, pw, ph);
    var si : u32 = 0;
    while (si < 4) {
        const cxs : f64 = sx + safety_cell_x(si, pw);
        const cys : f64 = sy + safety_cell_y(si);
        const cws : f64 = safety_cell_w(pw);
        if (si == SC_TASKS) {
            var tn2 : usize = put_dec(line[0..200], 0, @as(u64, started));
            tn2 = put_bytes(line[0..200], tn2, "/");
            tn2 = put_dec(line[0..200], tn2, @as(u64, budget_cap()));
            tg_txt(c, kit, "tasks this hour", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..tn2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, (cws - 8.0) * bar_fill(started, budget_cap()), 3.0);
        }
        if (si == SC_AGENTS) {
            var an2 : usize = put_dec(line[0..200], 0, 0);
            an2 = put_bytes(line[0..200], an2, "/");
            an2 = put_dec(line[0..200], an2, @as(u64, agents_cap()));
            tg_txt(c, kit, "agents running", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..an2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
        }
        if (si == SC_TIER) {
            const tier : u32 = @as(u32, @intCast(tg[TPG_Q_TIER]));
            const tw2 : usize = csv_field(KT_WORDS, tier, wb[0..64]);
            tg_txt(c, kit, "key tier", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            var tal : f64 = 0.9;
            if (tier_is_warning(tier)) {
                round_rect(c, cxs + 2.0, cys + 15.0, cws - 4.0, 18.0, 3.0);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
                cg_fill_path(c);
                cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
                draw_fit(c, kit, wb[0..tw2], tw2, cxs + 6.0, cys + 28.0, 9.0, WEIGHT_BOLD, true, cxs + cws - 4.0);
            } else {
                tg_txt(c, kit, wb[0..tw2], cxs + 4.0, cys + 28.0, 9.5, WEIGHT_SEMIBOLD, tal * a, cxs + cws - 2.0);
            }
        }
        if (si == SC_STOP) {
            const hot : bool = on_stop(mx - sx, my - sy, pw);
            tg_button(c, kit, cxs + 4.0, cys + 4.0, cws - 8.0, 22.0, "STOP", hot, god, a);
            tg_txt(c, kit, stop_effect(god), cxs + 4.0, cys + 36.0, 7.0, 0.0, 0.5 * a, cxs + cws - 2.0);
        }
        si = si + 1;
    }
}

/// The page of letter kind `kind` in the content area of a home tab (below the header, right of the sidebar).
fn draw_tool_page(c: u64, kit: [48]u64, kind: u32, tg: []const u64, tb: []const u8, cx: f64, sw: f64, sh: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    const x0 : f64 = cx;
    const y0 : f64 = home_view_top();
    const pw : f64 = sw - cx;
    const ph : f64 = home_view_h(sh);
    const now : u64 = tg[TPG_NOW];
    if (kind == PAGE_BENCH) { draw_bench_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, full, a, now); }
    if (kind == PAGE_KANBAN) { draw_kanban_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, full, a, now); }
    if (kind == PAGE_QUEEN) { draw_queen_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, full, a, now); }
}

// ---- the key-light dot (owner directive gHashTag/t27#11314) ----
// A traffic-light dot on each agent pane header and one in the sidebar foot next to KEYS: the worst light of the
// running agent panes (red > yellow > green). The rule (keys.t27 light_of / worst_light, the listing field `light`)
// lives in the keys lane; this file only draws a light value it is given. Until that lane is merged the adapters
// below answer LIGHT_NONE, which draws no dot. The dot is the one colour signal allowed here, small, on glass.
pub const LIGHT_NONE : u32 = 0;
pub const LIGHT_GREEN : u32 = 1;
pub const LIGHT_YELLOW : u32 = 2;
pub const LIGHT_RED : u32 = 3;
pub const LIGHT_DOT_R : f64 = 3.5;

/// Adapter: the light of server pane `pane` (keys lane: the `light` field of the listing). Wire at merge.
pub fn pane_light_input(pane: u32) -> u32 { return LIGHT_NONE; }

/// Adapter: the worst light over the running agent panes (keys lane: worst_light). Wire at merge.
pub fn foot_light_input() -> u32 { return LIGHT_NONE; }

/// Red outranks yellow outranks green; none is the weakest.
pub fn light_worse(a: u32, b: u32) -> u32 {
    if (a > LIGHT_RED) { return b; }
    if (b > LIGHT_RED) { return a; }
    if (a >= b) { return a; }
    return b;
}

/// An editor pane has no dot; any other pane shows its light.
pub fn dot_light(is_editor: bool, light: u32) -> u32 {
    if (is_editor or light > LIGHT_RED) { return LIGHT_NONE; }
    return light;
}

pub fn dot_visible(light: u32) -> bool { return light >= LIGHT_GREEN and light <= LIGHT_RED; }

/// Colour channel k (0 r, 1 g, 2 b) of the dot.
pub fn light_chan(light: u32, k: u32) -> f64 {
    if (light == LIGHT_GREEN) { if (k == 0) { return 0.30; } if (k == 1) { return 0.85; } return 0.40; }
    if (light == LIGHT_YELLOW) { if (k == 0) { return 0.98; } if (k == 1) { return 0.78; } return 0.20; }
    if (light == LIGHT_RED) { if (k == 0) { return 0.95; } if (k == 1) { return 0.27; } return 0.25; }
    return 0.0;
}

fn draw_light_dot(c: u64, x: f64, y: f64, light: u32, a: f64) -> void {
    if (dot_visible(light) == false) { return; }
    cg_fill_rgba(c, light_chan(light, 0), light_chan(light, 1), light_chan(light, 2), 0.95 * a);
    cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
    cg_fill_path(c);
}

fn draw(c: u64, kit: [48]u64, frame: u32, state: u32, hov: u32, ma: f64, shown: u32, task: u32, space: u32, sp: u32, ss: u64, cur: u32, collapsed: bool, mx: f64, my: f64, z: f64, sw: f64, sh: f64, ws: u32, full: bool, qp: bool, ring: [8]u64, n: u32, now: u64, sug: u32, god: bool, glow: f64, dk: [128]u64, dp: bool, darmed: u32, doff: u32, dgo: u32, dlive: bool, dlabel: u64, tst: []const u32, tcells: []const u32, topen: u32, tcur: bool, kyp: bool, kstored: []const u32, kmask: []const u8, kmlen: []const u32, kst: []const u32, kfail: []const u32, kopen: []const u64, kedit: u32, kbuf: []const u8, klen: u32, karm: u32, kbusy: u32, kemask: u32, kewhy: u32, ktpick: u32, hs: u32, cons: bool, dc: []u64, gal: []const u8, gt: []const u32, evd: u32, evpk: u64, pb: []const u8, sst: []const u32, tg: []const u64, tb: []const u8) -> void {
    // evp, evn2 and evpr travel packed (the draw call is at the 64 parameter limit)
    const evp : u32 = @as(u32, @intCast(evpk % 1048576));
    const evn2 : u32 = @as(u32, @intCast(evpk / 1048576 % 1048576));
    const evpr : u32 = @as(u32, @intCast(evpk / 1099511627776));
    draw_backdrop(c, sw, sh, full);
    const ha : f64 = 1.0 - ma;
    if (ha > 0.0) {
        draw_logo(c, home_c(0, z, sw, sh), home_c(1, z, sw, sh), home_k(z, sw, sh), anim_off(frame) * 1000.0, state, hov, ha);
        if (hov == PETAL_CENTRE) { draw_centre_tip(c, kit, ha, z, sw, sh); } else if (hov != PETAL_NONE) { draw_tooltip(c, kit, hov, ha, z, sw, sh); }
    }
    if (ma > 0.0) {
        // the screen of petal `shown`: the chat workspace for the CHAT petal (index 2), a home tab for t27a ..
        // t27u, an empty frame with the petal's name for every other petal
        if (shown == PETAL_CHAT and cons == false) {
            draw_chat(c, kit, shown, task, space, sp, ss, cur, ma, collapsed, mx, my, sw, sh, ws, dlabel, dp, full, topen != PANE_NONE, sst, tb);
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE) { draw_term(c, kit, tst, tcells, tcur, ma, collapsed, sw, sh, ws, full, qp or dp or kyp); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE and sst[SST_SRV] != SRV_UP) { draw_srv_banner(c, kit, sst[SST_SRV], content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp), sh - WS_TOP - HEADER_H, mx, my, ma, full); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE) { draw_light_dot(c, sw - 124.0, WS_TOP + 0.5 * HEADER_H, dot_light(topen == VIEW_EDITOR, pane_light_input(topen)), ma); }
            draw_switch(c, kit, "CONSOLE >", sw, ma, mx, my);
        } else {
            draw_home(c, kit, shown, ma, collapsed, mx, my, sw, sh, ws, hs, dlabel, dp, full, dc, gal, gt, pb, tg, tb);
        }
    }
    // exactly one right-hand panel is drawn (the Queen's, else DOCTOR's, else KEYS'): its ground first
    if (qp or dp or kyp) { draw_panel_ground(c, sw, sh, full); }
    if (qp) { draw_queen_panel(c, kit, sw, sh, mx, my, view_of(menu_open(state), shown), space, ss, cur, ring, n, now, sug, god, evd, evp, evn2, evpr); }
    if (dp and qp == false) { draw_doctor_panel(c, kit, dk, sw, sh, mx, my, darmed, doff, dgo, dlive); }
    if (kyp and qp == false and dp == false) { draw_keys_panel(c, kit, sw, sh, mx, my, kstored, kmask, kmlen, kst, kfail, kopen, now, kedit, kbuf, klen, karm, kbusy, kemask, kewhy, ktpick); }
    if (ma > 0.0 and shown == PETAL_CHAT and cons == false and ws == WS_EXPANDED and collapsed == false) {
        // K. KEYS in the foot, left of DOCTOR
        var ka : f64 = LABEL_WHITE;
        if (kyp or on_keys_foot(mx, my, sh, ws, collapsed)) { ka = TEXT_WHITE; }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, ka * ma);
        var kw : [16]u8 = undefined;
        const kn : usize = csv_field(KEYS_WORDS, 0, kw[0..16]);
        draw_bytes(c, kit, kw[0..16], kn, SIDE_W - 14.0 - DOC_LINK_W - 6.0 - KY_LINK_W + 8.0, sh - 13.0, 9.5, WEIGHT_SEMIBOLD, false);
        draw_light_dot(c, SIDE_W - 14.0 - DOC_LINK_W - 6.0 - KY_LINK_W + 1.0, sh - 16.0, foot_light_input(), ma);
    }
    if (ma > 0.0) {
        var uws : u32 = ws;
        if (shown != PETAL_CHAT or cons) { uws = home_ws(ws); }
        draw_update_strip(c, kit, tg, mx, my, sh, uws, collapsed, ma);
    }
    draw_titlebar(c, kit, sw, full, ma);
    draw_edge_glow(c, sw, sh, glow, frame);
}

