fn ct_line(attr: u64) -> u64 { return @extern("CTLineCreateWithAttributedString"); }
fn ct_width(line: u64, ascent: u64, descent: u64, leading: u64) -> f64 { return @extern("CTLineGetTypographicBounds"); }
fn ct_draw(line: u64, c: u64) -> void { @extern("CTLineDraw"); }

// ---- small helpers ----

fn cf(s: []const u8) -> u64 {
    return cf_bytes(0, s, s.len, UTF8, false);
}

fn cls(s: []const u8) -> u64 {
    return class_named(cf(s));
}

fn sel(s: []const u8) -> u64 {
    return sel_named(cf(s));
}

/// Channel k of a 0xAARRGGBB value in 0..1: 0 red, 1 green, 2 blue, 3 alpha.
pub fn chan(c: u32, k: u32) -> f64 {
    var v : u32 = c % 256;
    if (k == 3) { v = c / 16777216; }
    if (k == 0) { v = (c / 65536) % 256; }
    if (k == 1) { v = (c / 256) % 256; }
    return @as(f64, @floatFromInt(v)) / 255.0;
}

pub fn clamp01(x: f64) -> f64 {
    if (x < 0.0) { return 0.0; }
    if (x > 1.0) { return 1.0; }
    return x;
}

/// S. One step of the screen's opacity towards shown (1) or gone (0).
pub fn wave(a: f64, open: bool) -> f64 {
    if (open) { return clamp01(a + WAVE_STEP); }
    return clamp01(a - WAVE_STEP);
}

/// Viewport pixels per box milli-unit x 1000, from petal_menu's fit.
pub fn scale() -> f64 {
    return @as(f64, @floatFromInt(fit_permille(960, 540))) / 1000.0;
}

pub fn cen_x(p: u32) -> f64 {
    const i : u32 = p * 4;
    return @as(f64, @floatFromInt(QX[i] + QX[i + 1] + QX[i + 2] + QX[i + 3])) / 4.0;
}

pub fn cen_y(p: u32) -> f64 {
    const i : u32 = p * 4;
    return @as(f64, @floatFromInt(QY[i] + QY[i + 1] + QY[i + 2] + QY[i + 3])) / 4.0;
}

/// A. Unit direction a block flies in from: box centre -> its centroid ((1, 0) for a block on the centre).
pub fn dir(p: u32, axis: u32) -> f64 {
    const dx : f64 = cen_x(p) - @as(f64, @floatFromInt(BOX_CX));
    const dy : f64 = cen_y(p) - @as(f64, @floatFromInt(BOX_CY));
    const len : f64 = @sqrt(dx * dx + dy * dy);
    if (len <= 100.0) {
        if (axis == 0) { return 1.0; }
        return 0.0;
    }
    if (axis == 0) { return dx / len; }
    return dy / len;
}

/// A. How far (SVG units) every block still is from home after `frame` updates at 30 fps.
pub fn anim_off(frame: u32) -> f64 {
    var off : f64 = START_OFF;
    var v : f64 = 0.0;
    var f : u32 = 0;
    while (f < frame and f < ANIM_FRAMES) {
        if (f < PHASE1_FRAMES) {
            off = off - off * PHASE1_RATE * DT;
            v = 0.0 - off * V_HANDOFF;
        } else {
            v = v + (0.0 - off) * SPRING_K * DT;
            v = v * SPRING_DAMP;
            off = off + v * DT * 60.0;
        }
        f = f + 1;
    }
    if (frame >= ANIM_FRAMES) { return 0.0; }
    return off;
}

/// L. Extent of the logo on one axis (0 x, 1 y) in box milli-units: lowest or highest vertex.
pub fn logo_edge(axis: u32, high: bool) -> f64 {
    var best : i64 = QX[0];
    if (axis == 1) { best = QY[0]; }
    var i : u32 = 1;
    while (i < PETAL_COUNT * 4) {
        var v : i64 = QX[i];
        if (axis == 1) { v = QY[i]; }
        if (high and v > best) { best = v; }
        if (high == false and v < best) { best = v; }
        i = i + 1;
    }
    return @as(f64, @floatFromInt(best));
}

/// L. Size factor that makes the logo `px` points tall (1.0 = the size petal_menu's fit gives).
pub fn logo_k_for(px: f64) -> f64 {
    return px / ((logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale());
}

/// H. The home logo: 0.63 of the area under the title bar, centred in it (TriangleLogo's scale). The
/// scene is sw x sh points; in the narrow panel the width binds, so the logo keeps 0.63 of that too.
pub fn home_px(z: f64, sw: f64, sh: f64) -> f64 {
    var room : f64 = sh - AREA_TOP;
    const by_w : f64 = sw * (logo_edge(1, true) - logo_edge(1, false)) / (logo_edge(0, true) - logo_edge(0, false));
    if (by_w < room) { room = by_w; }
    return LOGO_SHARE * room * z;
}

pub fn home_k(z: f64, sw: f64, sh: f64) -> f64 {
    return logo_k_for(home_px(z, sw, sh));
}

/// H. Centre (for to_pt) that puts the logo's own middle at the middle of the area, on one axis.
pub fn logo_at(axis: u32, k: f64, mid_pt: f64) -> f64 {
    var c : f64 = @as(f64, @floatFromInt(BOX_CX));
    if (axis == 1) { c = @as(f64, @floatFromInt(BOX_CY)); }
    const mid : f64 = 0.5 * (logo_edge(axis, false) + logo_edge(axis, true));
    return mid_pt - (mid - c) / 1000.0 * scale() * k;
}

pub fn home_c(axis: u32, z: f64, sw: f64, sh: f64) -> f64 {
    if (axis == 0) { return logo_at(0, home_k(z, sw, sh), 0.5 * sw); }
    return logo_at(1, home_k(z, sw, sh), 0.5 * (AREA_TOP + sh));
}

/// A box coordinate in milli-units to a window point on one axis (0 x, 1 y; y grows down), for a logo
/// centred at `cen` and sized k.
pub fn to_pt(m: f64, axis: u32, cen: f64, k: f64) -> f64 {
    const s : f64 = scale() * k;
    if (axis == 0) { return cen + (m - @as(f64, @floatFromInt(BOX_CX))) / 1000.0 * s; }
    return cen + (m - @as(f64, @floatFromInt(BOX_CY))) / 1000.0 * s;
}

/// The mouse in the frame petal_menu's hit_px expects (logo centred in 960 x 540, size 1).
pub fn virt(v: f64, axis: u32, z: f64, sw: f64, sh: f64) -> f64 {
    var home : f64 = 0.5 * W_PT;
    if (axis == 1) { home = 0.5 * H_PT; }
    return home + (v - home_c(axis, z, sw, sh)) / home_k(z, sw, sh);
}

/// H. Where the tooltip pill centres for petal p: 30 pt above the petal's centre.
pub fn tip_x(p: u32, z: f64, sw: f64, sh: f64) -> f64 {
    return to_pt(cen_x(p), 0, home_c(0, z, sw, sh), home_k(z, sw, sh));
}

pub fn tip_y(p: u32, z: f64, sw: f64, sh: f64) -> f64 {
    return to_pt(cen_y(p), 1, home_c(1, z, sw, sh), home_k(z, sw, sh)) - TIP_RISE;
}

fn in_box(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x <= l + w and y >= t and y <= t + h;
}

/// T. Title-bar controls: logo + TRINITY (home), fullscreen.
/// T. Left edge of the title-bar logo: right of the traffic lights in a window, on the back chevron's
/// line in full screen (no traffic lights there).
pub fn home_x(full: bool) -> f64 {
    if (full) { return FULL_HOME_X; }
    return HOME_X;
}

/// T. Width of the title-bar logo drawn ROW_ICON_H tall, from the mark's own extent.
pub fn title_logo_w() -> f64 {
    return (logo_edge(0, true) - logo_edge(0, false)) / 1000.0 * scale() * logo_k_for(ROW_ICON_H);
}

pub fn on_home_button(x: f64, y: f64, full: bool) -> bool {
    return in_box(x, y, home_x(full), 0.0, HOME_BTN_W, TITLE_H);
}

pub fn full_x(sw: f64) -> f64 {
    return sw - FULL_INSET;
}

pub fn on_full_button(x: f64, y: f64, sw: f64) -> bool {
    return in_box(x, y, full_x(sw), 0.5 * (TITLE_H - FULL_PT), FULL_PT, FULL_PT);
}

/// K. The dock-panel control (sidebar.right): docks the window as the 400 pt trios panel, or undocks it.
pub fn dock_x(sw: f64) -> f64 {
    return full_x(sw) - DOCK_STEP;
}

pub fn on_dock_button(x: f64, y: f64, sw: f64) -> bool {
    return in_box(x, y, dock_x(sw), 0.5 * (TITLE_H - FULL_PT), FULL_PT, FULL_PT);
}

/// K. ChatWorkspaceLayout.metrics: expanded from 760 pt; below it compact, or the dashboard the user
/// forced open from the compact bar (isDashboardExpanded).
pub fn workspace(sw: f64, dash: bool) -> u32 {
    if (sw >= COMPACT_BELOW) { return WS_EXPANDED; }
    if (dash) { return WS_DASHBOARD; }
    return WS_COMPACT;
}

/// K. sidebarWidth: 272 only when expanded and not collapsed, else 0 (trios keeps a zero-width
/// sidebar and its divider in the forced dashboard).
pub fn side_w(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_EXPANDED and collapsed == false) { return SIDE_W; }
    return 0.0;
}

/// K. The "OPEN DASHBOARD" bar across the top of the compact workspace.
pub fn on_open_dash(x: f64, y: f64, sw: f64, ws: u32) -> bool {
    return ws == WS_COMPACT and in_box(x, y, 0.0, WS_TOP, sw, BAR_H);
}

/// S. The back chevron + logo + TRINITY in the one title bar.
pub fn on_nav_back(x: f64, y: f64, full: bool) -> bool {
    return in_box(x, y, home_x(full), 0.0, BACK_W, TITLE_H);
}

/// C. Left edge of the chat content: right of the sidebar and its divider, or 0 when collapsed.
pub fn content_x(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_COMPACT or collapsed) { return 0.0; }
    return side_w(ws, collapsed) + 1.0;
}

pub fn on_side_toggle(x: f64, y: f64, ws: u32, collapsed: bool) -> bool {
    if (ws == WS_COMPACT) { return false; }
    return in_box(x, y, content_x(ws, collapsed) + 14.0, WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// K. "Close Dashboard" (rectangle.compress.vertical), right of the toggle, only in the forced dashboard.
pub fn close_x(ws: u32, collapsed: bool) -> f64 {
    return content_x(ws, collapsed) + 14.0 + TOGGLE_PT + 12.0;
}

pub fn on_close_dash(x: f64, y: f64, ws: u32, collapsed: bool) -> bool {
    return ws == WS_DASHBOARD and in_box(x, y, close_x(ws, collapsed), WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// C. The readable column the cards live in: at most 900 pt, centred, at least 24 pt from each side.
pub fn body_w(sw: f64, ws: u32, collapsed: bool) -> f64 {
    const room : f64 = sw - content_x(ws, collapsed) - 2.0 * BODY_PAD;
    if (room > READABLE_W) { return READABLE_W; }
    return room;
}

pub fn body_left(sw: f64, ws: u32, collapsed: bool) -> f64 {
    return content_x(ws, collapsed) + 0.5 * (sw - content_x(ws, collapsed) - body_w(sw, ws, collapsed));
}

/// C/K. Under the 44 pt header and its divider, or under the 26 pt dashboard bar when compact.
pub fn body_top(ws: u32) -> f64 {
    if (ws == WS_COMPACT) { return WS_TOP + BAR_H + BODY_PAD; }
    return WS_TOP + HEADER_H + 1.0 + BODY_PAD;
}

/// K. In the narrow panel the 3 x 3 slots keep the shape they have in the wide window (top-aligned),
/// instead of stretching down the whole 400 pt column.
pub fn body_h(sw: f64, sh: f64, ws: u32, collapsed: bool) -> f64 {
    const room : f64 = sh - body_top(ws) - BODY_PAD;
    if (ws == WS_EXPANDED) { return room; }
    const keep : f64 = body_w(sw, ws, collapsed) * wide_shape();
    if (keep < room) { return keep; }
    return room;
}

/// K. Height over width of the card column in the wide window with the sidebar collapsed.
pub fn wide_shape() -> f64 {
    return (H_PT - body_top(WS_EXPANDED) - BODY_PAD) / READABLE_W;
}

/// C. Honeycomb: the nine cards are pointy-top hexagons, three rows of three, the middle row shifted
/// half a cell right. The cell radius (centre to corner) that fits a w x h body with HEX_GAP between cells.
pub fn hex_r(w: f64, h: f64) -> f64 {
    const byw : f64 = (w - 2.5 * HEX_GAP) / (3.5 * SQRT3);
    const byh : f64 = (h - 2.0 * HEX_GAP) / 5.0;
    if (byw < byh) { return byw; }
    return byh;
}

/// C. Centre of honeycomb cell k on one axis (0 x, 1 y) in a body at (l, t) of w x h, the comb centred.
pub fn hex_c(k: u32, axis: u32, l: f64, t: f64, w: f64, h: f64) -> f64 {
    const r : f64 = hex_r(w, h);
    const cw : f64 = SQRT3 * r;
    const col : f64 = @as(f64, @floatFromInt(k % 3));
    const row : f64 = @as(f64, @floatFromInt(k / 3));
    if (axis == 0) {
        var x : f64 = l + 0.5 * (w - (3.5 * cw + 2.5 * HEX_GAP)) + 0.5 * cw + col * (cw + HEX_GAP);
        if (k / 3 == 1) { x = x + 0.5 * (cw + HEX_GAP); }
        return x;
    }
    return t + 0.5 * (h - (5.0 * r + 2.0 * HEX_GAP)) + r + row * (1.5 * r + HEX_GAP);
}

/// C. Is (x, y) inside the pointy-top hexagon of radius r centred at (cx, cy)?
pub fn in_hex(x: f64, y: f64, cx: f64, cy: f64, r: f64) -> bool {
    const dx : f64 = @abs(x - cx);
    const dy : f64 = @abs(y - cy);
    return dx <= 0.5 * SQRT3 * r and dy <= r - dx / SQRT3;
}

/// C. The pointy-top hexagon path of radius r centred at (cx, cy).
fn hex_path(c: u64, cx: f64, cy: f64, r: f64) -> void {
    const hw : f64 = 0.5 * SQRT3 * r;
    cg_move(c, cx, cy - r);
    cg_line(c, cx + hw, cy - 0.5 * r);
    cg_line(c, cx + hw, cy + 0.5 * r);
    cg_line(c, cx, cy + r);
    cg_line(c, cx - hw, cy + 0.5 * r);
    cg_line(c, cx - hw, cy - 0.5 * r);
    cg_close(c);
}

/// C. The card slot under (x, y), CARD_SLOTS when none.
pub fn card_at(x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool) -> u32 {
    const l : f64 = body_left(sw, ws, collapsed);
    const t : f64 = body_top(ws);
    const w : f64 = body_w(sw, ws, collapsed);
    const h : f64 = body_h(sw, sh, ws, collapsed);
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        if (in_hex(x, y, hex_c(k, 0, l, t, w, h), hex_c(k, 1, l, t, w, h), hex_r(w, h))) { return k; }
        k = k + 1;
    }
    return CARD_SLOTS;
}

/// C. Cards arrive one after another: slot k shows CASCADE of the fade later than slot k - 1.
pub fn card_alpha(ma: f64, k: u32) -> f64 {
    return clamp01((ma - CASCADE * @as(f64, @floatFromInt(k))) / (1.0 - CASCADE * 8.0));
}

/// S. Modifier bit test on NSEvent.modifierFlags.
pub fn has_mod(flags: u64, bit: u64) -> bool {
    return (flags / bit) % 2 == 1;
}

/// S. The digit a virtual key code types (0..9), NO_DIGIT for any other key.
pub fn digit_of(key: u64) -> u32 {
    if (key == 29) { return 0; }
    if (key == 18) { return 1; }
    if (key == 19) { return 2; }
    if (key == 20) { return 3; }
    if (key == 21) { return 4; }
    if (key == 23) { return 5; }
    if (key == 22) { return 6; }
    if (key == 26) { return 7; }
    if (key == 28) { return 8; }
    if (key == 25) { return 9; }
    return NO_DIGIT;
}

/// S. QueenMenuShortcutPolicy: exactly Cmd + 1..9 opens petals 0..8, Option 9..17, Control 18..26.
pub fn petal_for_key(digit: u32, flags: u64) -> u32 {
    if (digit < 1 or digit > 9) { return PETAL_NONE; }
    const cmd : bool = has_mod(flags, MOD_COMMAND);
    const opt : bool = has_mod(flags, MOD_OPTION);
    const ctl : bool = has_mod(flags, MOD_CONTROL);
    if (has_mod(flags, MOD_SHIFT)) { return PETAL_NONE; }
    if (cmd and opt == false and ctl == false) { return digit - 1; }
    if (opt and cmd == false and ctl == false) { return 9 + digit - 1; }
    if (ctl and cmd == false and opt == false) { return 18 + digit - 1; }
    return PETAL_NONE;
}

/// D. Dock icon centre on one axis for to_pt, so the logo's own middle (not the box centre) sits mid-icon.
pub fn icon_cen(axis: u32) -> f64 {
    return logo_at(axis, logo_k_for(ICON_LOGO_PX), 0.5 * ICON_SIZE);
}

/// K. The scene for a view of w x h points: the view itself, point for point, so text keeps its real
/// size and stays sharp in full screen (no upscaled 960 x 540 stage, no letterbox bands); capped by the
/// bitmap it draws into. axis 0 width, 1 height.
pub fn scene(w: f64, h: f64, axis: u32) -> f64 {
    if (w >= COMPACT_BELOW) {
        if (axis == 0) {
            if (w > SW_MAX) { return SW_MAX; }
            return w;
        }
        if (h > SH_MAX) { return SH_MAX; }
        return h;
    }
    if (axis == 0) { return w; }
    if (h > CH_MAX) { return CH_MAX; }
    return h;
}

/// Fit of the sw x sh scene into a view of w x h points (aspect kept, centred): the scale.
pub fn fit(w: f64, h: f64, sw: f64, sh: f64) -> f64 {
    const sx : f64 = w / sw;
    const sy : f64 = h / sh;
    if (sx < sy) { return sx; }
    return sy;
}

/// A view point (y up, as AppKit reports it) to a scene point (y down) on one axis.
pub fn view_to_scene(v: f64, w: f64, h: f64, axis: u32, sw: f64, sh: f64) -> f64 {
    const s : f64 = fit(w, h, sw, sh);
    if (axis == 0) { return (v - 0.5 * (w - sw * s)) / s; }
    return sh - (v - 0.5 * (h - sh * s)) / s;
}

// ---- text (CoreText lines, coloured by the context's fill colour) ----

fn mk_line(kit: [24]u64, s: u64, size: f64, weight: f64, mono: bool) -> u64 {
    var font : u64 = 0;
    if (mono) {
        font = msg_ff(kit[K_FONT], kit[K_MONO_SEL], size, weight);
    } else {
        font = msg_ff(kit[K_FONT], kit[K_SYS_SEL], size, weight);
    }
    var keys : [2]u64 = undefined;
    var vals : [2]u64 = undefined;
    keys[0] = kit[K_KEY_FONT];
    vals[0] = font;
    keys[1] = kit[K_KEY_CTX];
    vals[1] = kit[K_YES];
    const attrs : u64 = msg_dict(kit[K_DICT], kit[K_DICT_SEL], vals, keys, 2);
    const astr : u64 = msg2(msg0(kit[K_ATTR], kit[K_ALLOC]), kit[K_INIT], s, attrs);
    const line : u64 = ct_line(astr);
    msg0(astr, kit[K_RELEASE]);
    return line;
}

fn text_w(kit: [24]u64, s: u64, size: f64, weight: f64, mono: bool) -> f64 {
    const line : u64 = mk_line(kit, s, size, weight, mono);
    const w : f64 = ct_width(line, 0, 0, 0);
    cf_release(line);
    return w;
}

/// Draws s with its baseline at (x, base) in the current fill colour; returns its width.
fn draw_text(c: u64, kit: [24]u64, s: u64, x: f64, base: f64, size: f64, weight: f64, mono: bool) -> f64 {
    const line : u64 = mk_line(kit, s, size, weight, mono);
    const w : f64 = ct_width(line, 0, 0, 0);
    cg_save(c);
    cg_translate(c, x, base);
    cg_scale(c, 1.0, -1.0);
    cg_text_pos(c, 0.0, 0.0);
    ct_draw(line, c);
    cg_restore(c);
    cf_release(line);
    return w;
}

fn world(kit: [24]u64, p: u32) -> u64 {
    return msg1(kit[K_NAMES], kit[K_AT], @as(u64, p));
}

// ---- drawing ----

fn round_rect(c: u64, x: f64, y: f64, w: f64, h: f64, r: f64) -> void {
    const p : u64 = cg_round_rect(x, y, w, h, r, r, 0);
    cg_add_path(c, p);
    cg_path_release(p);
}

fn set_fill(c: u64, argb: u32, k: f64) -> void {
    cg_fill_rgba(c, chan(argb, 0), chan(argb, 1), chan(argb, 2), chan(argb, 3) * k);
}

fn petal_path(c: u64, p: u32, cx: f64, cy: f64, k: f64, ox: f64, oy: f64) -> void {
    var v : u32 = 0;
    while (v < 4) {
        const x : f64 = to_pt(@as(f64, @floatFromInt(QX[p * 4 + v])) + ox, 0, cx, k);
        const y : f64 = to_pt(@as(f64, @floatFromInt(QY[p * 4 + v])) + oy, 1, cy, k);
        if (v == 0) { cg_move(c, x, y); } else { cg_line(c, x, y); }
        v = v + 1;
    }
    cg_close(c);
}

/// D. The Dock icon: the logo white on a black rounded square, drawn into a 512 px bitmap (y down).
fn draw_app_icon(c: u64) -> void {
    const m : f64 = 0.5 * (ICON_SIZE - ICON_TILE);
    round_rect(c, m, m, ICON_TILE, ICON_TILE, ICON_TILE * 0.225);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    cg_fill_path(c);
    const k : f64 = logo_k_for(ICON_LOGO_PX);
    cg_line_width(c, 3.0);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        petal_path(c, p, icon_cen(0), icon_cen(1), k, 0.0, 0.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0);
        cg_fill_path(c);
        petal_path(c, p, icon_cen(0), icon_cen(1), k, 0.0, 0.0);
        cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0);
        cg_stroke_path(c);
        p = p + 1;
    }
}

/// H. The large mark (home): white petals parted by a thin black cut, the centre left open;
/// the hovered or open petal takes its realm colour centred at (cx, cy), sized k, at alpha a. `off` is the fly-in distance (milli-units).
fn draw_logo(c: u64, cx: f64, cy: f64, k: f64, off: f64, state: u32, hov: u32, a: f64) -> void {
    cg_line_width(c, LOGO_CUT);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const ox : f64 = dir(p, 0) * off;
        const oy : f64 = dir(p, 1) * off;
        petal_path(c, p, cx, cy, k, ox, oy);
        if (p == hov or p == state) { set_fill(c, fill(p, state, hov), a); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, LOGO_WHITE * a); }
        cg_fill_path(c);
        petal_path(c, p, cx, cy, k, ox, oy);
        cg_stroke_rgba(c, 0.0, 0.0, 0.0, a);
        cg_stroke_path(c);
        p = p + 1;
    }
}

/// T. The small mark (title bar): white petals with a fine black cut, LOGO_SEAL thin (the large cut
/// would swallow a 14 pt mark), and the centre hole cut back in, hairline-thin at this size.
fn draw_template_logo(c: u64, cx: f64, cy: f64, k: f64) -> void {
    cg_line_width(c, LOGO_SEAL);
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        petal_path(c, p, cx, cy, k, 0.0, 0.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 1.0);
        cg_fill_path(c);
        petal_path(c, p, cx, cy, k, 0.0, 0.0);
        cg_stroke_rgba(c, 0.0, 0.0, 0.0, 1.0);
        cg_stroke_path(c);
        p = p + 1;
    }
    // the centre hole, cut back in black and grown about its centroid so it survives at 14 pt
    const gx : f64 = (HOLE_L + HOLE_R + HOLE_AX) / 3.0;
    const gy : f64 = (2.0 * HOLE_TOP + HOLE_AY) / 3.0;
    cg_move(c, to_pt(gx + (HOLE_L - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_TOP - gy) * HOLE_GROW, 1, cy, k));
    cg_line(c, to_pt(gx + (HOLE_R - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_TOP - gy) * HOLE_GROW, 1, cy, k));
    cg_line(c, to_pt(gx + (HOLE_AX - gx) * HOLE_GROW, 0, cx, k), to_pt(gy + (HOLE_AY - gy) * HOLE_GROW, 1, cy, k));
    cg_close(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
    cg_fill_path(c);
}

/// T. The one title bar: (screen up) the back chevron, the template logo + TRINITY (home), (screen up)
/// the refresh arc, the dock-panel and fullscreen controls, the divider. The world name is not repeated
/// here: the content header already says it.
fn draw_titlebar(c: u64, kit: [24]u64, sw: f64, full: bool, ma: f64) -> void {
    const mid : f64 = 0.5 * TITLE_H;
    if (ma > 0.0) {
        const bx : f64 = home_x(full);
        cg_line_width(c, 1.2);
        const ct : f64 = centre_top(mid, ROW_ICON_H);
        cg_move(c, bx + CHEV_W, ct);
        cg_line(c, bx, mid);
        cg_line(c, bx + CHEV_W, ct + ROW_ICON_H);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * ma);
        cg_stroke_path(c);
        // refresh: an outline-only arrow arc one step left of the dock control
        const rx : f64 = dock_x(sw) - DOCK_STEP + 0.5 * FULL_PT;
        cg_line_width(c, 1.1);
        cg_arc(c, rx, mid, 4.5, 0.5, TAU - 0.4, 0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * ma);
        cg_stroke_path(c);
        cg_move(c, rx + 4.9, mid - 4.2);
        cg_line(c, rx + 4.5, mid - 0.9);
        cg_line(c, rx + 1.4, mid - 2.0);
        cg_stroke_path(c);
    }
    const hx : f64 = home_x(full) + NAV_SHIFT * ma;
    const k : f64 = logo_k_for(ROW_ICON_H);
    const lw : f64 = title_logo_w();
    draw_template_logo(c, logo_at(0, k, hx + 0.5 * lw), logo_at(1, k, mid), k);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
    draw_text(c, kit, kit[K_TRINITY], row_next(hx, lw, ROW_GAP), baseline_for(mid, 11.0), 11.0, WEIGHT_SEMIBOLD, false);
    // arrow.up.left.and.arrow.down.right, grokMuted
    const x : f64 = full_x(sw) + 4.0;
    const y : f64 = 0.5 * (TITLE_H - FULL_PT) + 4.0;
    cg_line_width(c, 1.4);
    cg_move(c, x, y);
    cg_line(c, x + 12.0, y + 12.0);
    cg_move(c, x, y + 5.0);
    cg_line(c, x, y);
    cg_line(c, x + 5.0, y);
    cg_move(c, x + 12.0, y + 7.0);
    cg_line(c, x + 12.0, y + 12.0);
    cg_line(c, x + 7.0, y + 12.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    cg_stroke_path(c);
    // K. sidebar.right, grokMuted: the dock-panel control
    const dx : f64 = dock_x(sw) + 2.0;
    const dy : f64 = 0.5 * (TITLE_H - 13.0);
    cg_line_width(c, 1.3);
    round_rect(c, dx, dy, 16.0, 13.0, 3.0);
    cg_move(c, dx + 10.5, dy);
    cg_line(c, dx + 10.5, dy + 13.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE);
    cg_fill_rect(c, 0.0, TITLE_H, sw, HAIR);
}

/// H. The hover tooltip for petal p: "NAME  Cmd+1" on a white pill.
fn draw_tooltip(c: u64, kit: [24]u64, p: u32, a: f64, z: f64, sw: f64, sh: f64) -> void {
    const name : u64 = world(kit, p);
    var pre : u64 = kit[K_CMD];
    if (p >= 9) { pre = kit[K_OPT]; }
    if (p >= 18) { pre = kit[K_CTRL]; }
    const dig : u64 = msg1(kit[K_DIGITS], kit[K_AT], @as(u64, p % 9));
    const wn : f64 = text_w(kit, name, 13.0, WEIGHT_SEMIBOLD, true);
    const wp : f64 = text_w(kit, pre, 13.0, WEIGHT_SEMIBOLD, true);
    const wd : f64 = text_w(kit, dig, 13.0, WEIGHT_SEMIBOLD, true);
    const gap : f64 = 16.0;
    const w : f64 = wn + gap + wp + wd + 24.0;
    const x : f64 = tip_x(p, z, sw, sh) - 0.5 * w;
    const y : f64 = tip_y(p, z, sw, sh) - 0.5 * TIP_H;
    round_rect(c, x, y, w, TIP_H, 6.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TIP_WHITE * a);
    cg_fill_path(c);
    cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
    const base : f64 = tip_y(p, z, sw, sh) + 4.6;
    draw_text(c, kit, name, x + 12.0, base, 13.0, WEIGHT_SEMIBOLD, true);
    draw_text(c, kit, pre, x + 12.0 + wn + gap, base, 13.0, WEIGHT_SEMIBOLD, true);
    draw_text(c, kit, dig, x + 12.0 + wn + gap + wp, base, 13.0, WEIGHT_SEMIBOLD, true);
}

/// C. Chat workspace: sidebar (unless collapsed), divider, content with header, divider and cards.
/// K. Compact (ws 1): no sidebar, the OPEN DASHBOARD bar instead of the header. Forced dashboard (ws 2):
/// the expanded layout with a zero-width sidebar and the Close Dashboard button in the header.
fn draw_chat(c: u64, kit: [24]u64, shown: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, sh: f64, ws: u32) -> void {
    const cx : f64 = content_x(ws, collapsed);
    if (ws == WS_DASHBOARD and collapsed == false) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
        cg_fill_rect(c, 0.0, WS_TOP, HAIR, sh - WS_TOP);
    }
    if (ws == WS_EXPANDED and collapsed == false) {
        cg_fill_rgba(c, 0.0, 0.0, 0.0, STRICT_SIDE * a);
        cg_fill_rect(c, 0.0, WS_TOP, SIDE_W, sh - WS_TOP);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
        cg_fill_rect(c, SIDE_W, WS_TOP, HAIR, sh - WS_TOP);
        // F. New task: square.and.pencil + text in a 30 pt hairline row, corner 4, no fill
        const ny : f64 = WS_TOP + 14.0;
        cg_line_width(c, HAIR);
        round_rect(c, 12.25, ny + 0.25, SIDE_W - 24.5, 29.5, STRICT_R);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * 1.4 * a);
        cg_stroke_path(c);
        cg_line_width(c, 1.0);
        round_rect(c, 22.0, ny + 10.0, 10.0, 10.0, 2.0);
        cg_move(c, 26.0, ny + 16.0);
        cg_line(c, 32.5, ny + 9.5);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        cg_stroke_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_text(c, kit, kit[K_NEW_TASK], 40.0, ny + 15.0 + 4.0, 11.5, WEIGHT_MEDIUM, false);
        // F. the section label, then the Queen row: a small white crown, no fill, no frame (black and white only)
        const ly : f64 = ny + 30.0 + 22.0;
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_text(c, kit, kit[K_AGENTS], 14.0, ly, 9.5, WEIGHT_SEMIBOLD, false);
        const qy : f64 = ly + 8.0;
        if (in_box(mx, my, 12.0, qy, SIDE_W - 24.0, 28.0)) {
            round_rect(c, 12.0, qy, SIDE_W - 24.0, 28.0, STRICT_R);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.05 * a);
            cg_fill_path(c);
        }
        cg_move(c, 22.0, qy + 19.0);
        cg_line(c, 22.0, qy + 11.0);
        cg_line(c, 25.0, qy + 14.0);
        cg_line(c, 27.5, qy + 9.0);
        cg_line(c, 30.0, qy + 14.0);
        cg_line(c, 33.0, qy + 11.0);
        cg_line(c, 33.0, qy + 19.0);
        cg_close(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, CROWN_WHITE * a);
        cg_fill_path(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_text(c, kit, kit[K_QUEEN], 40.0, qy + 14.0 + 4.0, 11.5, WEIGHT_MEDIUM, false);
    }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, STRICT_CONTENT * a);
    cg_fill_rect(c, cx, WS_TOP, sw - cx, sh - WS_TOP);
    if (ws == WS_COMPACT) {
        draw_dash_bar(c, kit, a, sw, on_open_dash(mx, my, sw, ws));
    } else {
        draw_header(c, kit, shown, a, collapsed, mx, my, sw, ws);
    }
    draw_cards(c, a, collapsed, mx, my, sw, sh, ws);
}

/// C. The 44 pt header: sidebar.left toggle, Close Dashboard when forced open, the title, the divider.
fn draw_header(c: u64, kit: [24]u64, shown: u32, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, ws: u32) -> void {
    const cx : f64 = content_x(ws, collapsed);
    // header: sidebar.left toggle, then the title
    const ty : f64 = WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT);
    if (on_side_toggle(mx, my, ws, collapsed)) {
        round_rect(c, cx + 14.0, ty, TOGGLE_PT, TOGGLE_PT, 6.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
        cg_fill_path(c);
    }
    const ix : f64 = cx + 14.0 + 6.0;
    const iy : f64 = ty + 7.5;
    cg_line_width(c, 1.3);
    round_rect(c, ix, iy, 16.0, 13.0, 3.0);
    cg_move(c, ix + 5.5, iy);
    cg_line(c, ix + 5.5, iy + 13.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
    var title_x : f64 = cx + 14.0 + TOGGLE_PT + 12.0;
    if (ws == WS_DASHBOARD) {
        // K. rectangle.compress.vertical, grokMuted: two arrows closing on a line
        const kx : f64 = close_x(ws, collapsed);
        if (on_close_dash(mx, my, ws, collapsed)) {
            round_rect(c, kx, ty, TOGGLE_PT, TOGGLE_PT, 6.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, HIGHLIGHT_WHITE * a);
            cg_fill_path(c);
        }
        const mxc : f64 = kx + 0.5 * TOGGLE_PT;
        const myc : f64 = ty + 0.5 * TOGGLE_PT;
        cg_line_width(c, 1.3);
        cg_move(c, mxc - 7.0, myc);
        cg_line(c, mxc + 7.0, myc);
        cg_move(c, mxc, myc - 8.0);
        cg_line(c, mxc, myc - 2.5);
        cg_move(c, mxc - 3.0, myc - 5.5);
        cg_line(c, mxc, myc - 2.5);
        cg_line(c, mxc + 3.0, myc - 5.5);
        cg_move(c, mxc, myc + 8.0);
        cg_line(c, mxc, myc + 2.5);
        cg_move(c, mxc - 3.0, myc + 5.5);
        cg_line(c, mxc, myc + 2.5);
        cg_line(c, mxc + 3.0, myc + 5.5);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        cg_stroke_path(c);
        title_x = kx + TOGGLE_PT + 12.0;
    }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_text(c, kit, world(kit, shown), title_x, WS_TOP + 0.5 * HEADER_H + 4.2, 12.0, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, cx, WS_TOP + HEADER_H, sw - cx, HAIR);
}

/// K. trios dashboardToggleButton: rectangle.split.3x1 (white 0.4), "OPEN DASHBOARD" (bold 10, white
/// 0.5), the expand arrows (grokMuted) on the right; elevated 0.25 fill, a 1 pt border 0.3 line under it.
fn draw_dash_bar(c: u64, kit: [24]u64, a: f64, sw: f64, lit: bool) -> void {
    var f : f64 = ELEVATED_BLACK * 0.25;
    if (lit) { f = ELEVATED_BLACK * 0.5; }
    cg_fill_rgba(c, 0.0, 0.0, 0.0, f * a);
    cg_fill_rect(c, 0.0, WS_TOP, sw, BAR_H);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, BORDER_WHITE * 0.3 * a);
    cg_fill_rect(c, 0.0, WS_TOP + BAR_H - 1.0, sw, 1.0);
    const mid : f64 = WS_TOP + 0.5 * BAR_H;
    cg_line_width(c, 1.1);
    round_rect(c, 14.0, mid - 4.5, 13.0, 9.0, 1.5);
    cg_move(c, 18.3, mid - 4.5);
    cg_line(c, 18.3, mid + 4.5);
    cg_move(c, 22.7, mid - 4.5);
    cg_line(c, 22.7, mid + 4.5);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.5 * a);
    draw_text(c, kit, kit[K_OPEN_DASH], 33.0, mid + 3.6, 10.0, WEIGHT_BOLD, false);
    const x : f64 = sw - 14.0 - 8.0;
    const y : f64 = mid - 4.0;
    cg_line_width(c, 1.1);
    cg_move(c, x, y);
    cg_line(c, x + 8.0, y + 8.0);
    cg_move(c, x, y + 3.5);
    cg_line(c, x, y);
    cg_line(c, x + 3.5, y);
    cg_move(c, x + 8.0, y + 4.5);
    cg_line(c, x + 8.0, y + 8.0);
    cg_line(c, x + 4.5, y + 8.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    cg_stroke_path(c);
}

/// C. The nine card slots as a honeycomb in the readable column.
fn draw_cards(c: u64, a: f64, collapsed: bool, mx: f64, my: f64, sw: f64, sh: f64, ws: u32) -> void {
    const l : f64 = body_left(sw, ws, collapsed);
    const t : f64 = body_top(ws);
    const w : f64 = body_w(sw, ws, collapsed);
    const h : f64 = body_h(sw, sh, ws, collapsed);
    const r : f64 = hex_r(w, h);
    var hk : u32 = CARD_SLOTS;
    if (a >= 1.0) { hk = card_at(mx, my, sw, sh, ws, collapsed); }
    // F. strict cells: hairline hexagons, a faint fill, no hover lift
    cg_line_width(c, HAIR);
    var k : u32 = 0;
    while (k < CARD_SLOTS) {
        const ka : f64 = card_alpha(a, k);
        var kf : f64 = STRICT_CARD_FILL;
        var ke : f64 = STRICT_CARD_EDGE;
        const lift : f64 = (1.0 - ka) * 6.0;
        if (k == hk) {
            kf = STRICT_HOVER_FILL;
            ke = STRICT_HOVER_EDGE;
        }
        const kx : f64 = hex_c(k, 0, l, t, w, h);
        const ky : f64 = hex_c(k, 1, l, t, w, h) + lift;
        hex_path(c, kx, ky, r - 0.25);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, kf * ka);
        cg_fill_path(c);
        hex_path(c, kx, ky, r - 0.25);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ke * ka);
        cg_stroke_path(c);
        k = k + 1;
    }
}

/// F. The background: one opaque black fill over the whole frame (#000000).
fn draw_backdrop(c: u64, sw: f64, sh: f64) -> void {
    cg_fill_rgba(c, 0.0, 0.0, 0.0, BACK_BLACK);
    cg_fill_rect(c, 0.0, 0.0, sw, sh);
}

/// One frame over the tinted glass: the home logo at 1 - ma, the screen for `shown` at ma, the title bar.
fn draw(c: u64, kit: [24]u64, frame: u32, state: u32, hov: u32, ma: f64, shown: u32, collapsed: bool, mx: f64, my: f64, z: f64, sw: f64, sh: f64, ws: u32, full: bool) -> void {
    cg_clear(c, 0.0, 0.0, sw, sh);
    draw_backdrop(c, sw, sh);
    const ha : f64 = 1.0 - ma;
    if (ha > 0.0) {
        draw_logo(c, home_c(0, z, sw, sh), home_c(1, z, sw, sh), home_k(z, sw, sh), anim_off(frame) * 1000.0, state, hov, ha);
        if (hov != PETAL_NONE) { draw_tooltip(c, kit, hov, ha, z, sw, sh); }
    }
    if (ma > 0.0) {
        draw_chat(c, kit, shown, ma, collapsed, mx, my, sw, sh, ws);
    }
    draw_titlebar(c, kit, sw, full, ma);
}

// ---- the app ----

pub fn main() -> void {
    const s_alloc : u64 = sel("alloc");
    const app : u64 = msg0(cls("NSApplication"), sel("sharedApplication"));
    msg1(app, sel("setActivationPolicy:"), 0);
    const win : u64 = msg_window(msg0(cls("NSWindow"), s_alloc), sel("initWithContentRect:styleMask:backing:defer:"), 0.0, 0.0, W_PT, H_PT, STYLE, BACKING_BUFFERED, false);
    msg1(win, sel("setTitle:"), cf("T27 OS"));
    msg_flag(win, sel("setTitlebarAppearsTransparent:"), true);
    msg1(win, sel("setTitleVisibility:"), 1);
    msg_flag(win, sel("setMovableByWindowBackground:"), false);
    msg_flag(win, sel("setOpaque:"), false);
    msg1(win, sel("setBackgroundColor:"), msg0(cls("NSColor"), sel("clearColor")));
    msg1(win, sel("setAppearance:"), msg1(cls("NSAppearance"), sel("appearanceNamed:"), cf("NSAppearanceNameDarkAqua")));
    const glass : u64 = msg_rect(msg0(cls("NSVisualEffectView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg1(glass, sel("setMaterial:"), MATERIAL);
    msg1(glass, sel("setBlendingMode:"), BLEND_BEHIND);
    msg1(glass, sel("setState:"), STATE_ACTIVE);
    msg1(win, sel("setContentView:"), glass);
    msg1(win, sel("setCollectionBehavior:"), FULL_SCREEN_PRIMARY);
    msg1(glass, sel("setAutoresizingMask:"), SIZABLE);
    const view : u64 = msg_rect(msg0(cls("NSView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg_flag(view, sel("setWantsLayer:"), true);
    msg1(glass, sel("addSubview:"), view);
    msg1(view, sel("setAutoresizingMask:"), SIZABLE);
    const layer : u64 = msg0(view, sel("layer"));
    msg1(layer, sel("setContentsGravity:"), cf("resizeAspect"));
    // W. the blackGlass tint lives on the layer, so it covers the whole window in full screen too.
    msg1(layer, sel("setBackgroundColor:"), cg_color(0.0, 0.0, 0.0, TINT_BLACK));
    msg0(win, sel("center"));
    msg1(win, sel("makeKeyAndOrderFront:"), 0);
    msg0(app, sel("finishLaunching"));
    // D. the Dock icon, drawn here rather than shipped as a foreign .icns file.
    const ic : u64 = cg_bitmap(0, 512, 512, 8, 2048, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(ic, 0.0, ICON_SIZE);
    cg_scale(ic, 1.0, -1.0);
    draw_app_icon(ic);
    const icon : u64 = msg_image(msg0(cls("NSImage"), s_alloc), sel("initWithCGImage:size:"), cg_image(ic), ICON_SIZE, ICON_SIZE);
    msg1(app, sel("setApplicationIconImage:"), icon);
    msg_flag(app, sel("activateIgnoringOtherApps:"), true);

    // the text kit: every class, selector and string the frames need, made once.
    const s_split : u64 = sel("componentsSeparatedByString:");
    var kit : [24]u64 = undefined;
    kit[K_FONT] = cls("NSFont");
    kit[K_MONO_SEL] = sel("monospacedSystemFontOfSize:weight:");
    kit[K_SYS_SEL] = sel("systemFontOfSize:weight:");
    kit[K_KEY_FONT] = cf("NSFont");
    kit[K_KEY_CTX] = cf("CTForegroundColorFromContext");
    kit[K_YES] = msg_flag(cls("NSNumber"), sel("numberWithBool:"), true);
    msg0(kit[K_YES], sel("retain"));
    kit[K_DICT] = cls("NSDictionary");
    kit[K_DICT_SEL] = sel("dictionaryWithObjects:forKeys:count:");
    kit[K_ATTR] = cls("NSAttributedString");
    kit[K_ALLOC] = s_alloc;
    kit[K_INIT] = sel("initWithString:attributes:");
    kit[K_RELEASE] = sel("release");
    kit[K_NAMES] = msg1(cf(WORLD_NAMES), s_split, cf(","));
    msg0(kit[K_NAMES], sel("retain"));
    kit[K_AT] = sel("objectAtIndex:");
    kit[K_TRINITY] = cf("TRINITY");
    kit[K_NEW_TASK] = cf("New task");
    kit[K_QUEEN] = cf("Queen");
    kit[K_CMD] = cf("Cmd+");
    kit[K_OPT] = cf("Option+");
    kit[K_CTRL] = cf("Ctrl+");
    kit[K_DIGITS] = msg1(cf("1,2,3,4,5,6,7,8,9"), s_split, cf(","));
    msg0(kit[K_DIGITS], sel("retain"));
    kit[K_OPEN_DASH] = cf("OPEN DASHBOARD");
    kit[K_AGENTS] = cf("AGENTS");

    const c : u64 = cg_bitmap(0, 3840, 2400, 8, 15360, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(c, 0.0, SH_MAX * WIDE_RETINA);
    cg_scale(c, WIDE_RETINA, 0.0 - WIDE_RETINA);
    // F. the window tint and the full-screen black glass, swapped when the style mask changes.
    const tint_win : u64 = cg_color(0.0, 0.0, 0.0, TINT_BLACK);
    const tint_full : u64 = cg_color(0.0, 0.0, 0.0, TINT_FULL);
    var was_full : bool = false;
    // K. the narrow panel draws point for point into its own bitmap, cropped to the view each frame.
    const cc : u64 = cg_bitmap(0, 3040, 5200, 8, 12160, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(cc, 0.0, CH_MAX * RETINA);
    cg_scale(cc, RETINA, 0.0 - RETINA);

    const s_next : u64 = sel("nextEventMatchingMask:untilDate:inMode:dequeue:");
    const s_send : u64 = sel("sendEvent:");
    const s_type : u64 = sel("type");
    const s_key : u64 = sel("keyCode");
    const s_flags : u64 = sel("modifierFlags");
    const s_value : u64 = sel("valueForKey:");
    const s_get : u64 = sel("getValue:");
    const s_visible : u64 = sel("isVisible");
    const s_mask : u64 = sel("styleMask");
    const s_contents : u64 = sel("setContents:");
    const s_wait : u64 = sel("dateWithTimeIntervalSinceNow:");
    const s_quiet : u64 = sel("setDisableActions:");
    const k_mouse : u64 = cf("mouseLocationOutsideOfEventStream");
    const k_click : u64 = cf("locationInWindow");
    const mode : u64 = cf("kCFRunLoopDefaultMode");
    const date_cls : u64 = cls("NSDate");
    const tx_cls : u64 = cls("CATransaction");
    const k_frame : u64 = cf("frame");
    const s_full : u64 = sel("toggleFullScreen:");
    const s_set_frame : u64 = sel("setFrame:display:animate:");
    const s_screen : u64 = sel("screen");
    const k_visible : u64 = cf("visibleFrame");
    const s_cursor_set : u64 = sel("set");
    const hand : u64 = msg0(cls("NSCursor"), sel("pointingHandCursor"));
    const arrow : u64 = msg0(cls("NSCursor"), sel("arrowCursor"));
    const sc : i64 = fit_permille(960, 540);

    var pt : [2]f64 = undefined;
    var fr : [4]f64 = undefined;
    var wf : [4]f64 = undefined;
    var vf : [4]f64 = undefined;
    var docked : bool = false;
    var dash : bool = false;
    var state : u32 = STATE_HOME;
    var shown : u32 = 0;
    var ma : f64 = 0.0;
    var collapsed : bool = false;
    var frame : u32 = 0;
    while (msg_test(win, s_visible)) {
        const pool : u64 = pool_push();
        msg_point(msg1(win, s_value, k_mouse), s_get, pt);
        msg_frame(msg1(view, s_value, k_frame), s_get, fr);
        const sw : f64 = scene(fr[2], fr[3], 0);
        const sh : f64 = scene(fr[2], fr[3], 1);
        const narrow : bool = fr[2] < COMPACT_BELOW;
        const ws : u32 = workspace(sw, dash);
        var mx : f64 = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
        var my : f64 = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
        const full : bool = has_mod(msg0(win, s_mask), MASK_FULL_SCREEN);
        var z : f64 = 1.0;
        if (full) { z = FULL_LOGO; }
        if (full != was_full) {
            if (full) { msg1(layer, sel("setBackgroundColor:"), tint_full); } else { msg1(layer, sel("setBackgroundColor:"), tint_win); }
            was_full = full;
        }
        var vx : i64 = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
        var vy : i64 = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
        // H. the logo answers the mouse only at home, once the screen has gone.
        const home_live : bool = menu_open(state) == false and ma == 0.0 and my > AREA_TOP;
        const screen : bool = menu_open(state) and ma >= 0.5;
        var ev : u64 = msg_event(app, s_next, 0xffffffffffffffff, msg_f(date_cls, s_wait, FRAME_S), mode, true);
        while (ev != 0) {
            const ty : u64 = msg0(ev, s_type);
            var used : bool = false;
            if (ty == EV_LEFT_DOWN) {
                // the click is where the event says, not where the mouse was when the frame began
                msg_point(msg1(ev, s_value, k_click), s_get, pt);
                mx = view_to_scene(pt[0], fr[2], fr[3], 0, sw, sh);
                my = view_to_scene(pt[1], fr[2], fr[3], 1, sw, sh);
                vx = @as(i64, @intFromFloat(virt(mx, 0, z, sw, sh)));
                vy = @as(i64, @intFromFloat(virt(my, 1, z, sw, sh)));
                if (on_home_button(mx, my, full)) {
                    state = on_back(state);
                } else if (on_full_button(mx, my, sw)) {
                    msg1(win, s_full, 0);
                } else if (on_dock_button(mx, my, sw) and full == false) {
                    // K. WindowManager: the panel docks 400 pt wide on the right edge, full visible height.
                    if (docked) {
                        msg_set_frame(win, s_set_frame, wf[0], wf[1], wf[2], wf[3], true, true);
                    } else {
                        msg_frame(msg1(win, s_value, k_frame), s_get, wf);
                        msg_frame(msg1(msg0(win, s_screen), s_value, k_visible), s_get, vf);
                        msg_set_frame(win, s_set_frame, vf[0] + vf[2] - PANEL_W, vf[1], PANEL_W, vf[3], true, true);
                    }
                    docked = docked == false;
                } else if (screen and on_nav_back(mx, my, full)) {
                    state = on_back(state);
                } else if (screen and on_open_dash(mx, my, sw, ws)) {
                    dash = true;
                } else if (screen and on_close_dash(mx, my, ws, collapsed)) {
                    dash = false;
                } else if (screen and on_side_toggle(mx, my, ws, collapsed)) {
                    collapsed = collapsed == false;
                } else if (home_live) {
                    const p : u32 = on_tap(STATE_HOME, to_box(vx, 480, BOX_CX, sc), to_box(vy, 270, BOX_CY, sc));
                    if (menu_open(p)) { state = p; shown = p; }
                }
            }
            if (ty == EV_KEY_DOWN) {
                const key : u64 = msg0(ev, s_key);
                const flags : u64 = msg0(ev, s_flags);
                const cmd : bool = has_mod(flags, MOD_COMMAND);
                const digit : u32 = digit_of(key);
                const kp : u32 = petal_for_key(digit, flags);
                used = true;
                if (key == KEY_ESCAPE) {
                    state = on_back(state);
                } else if (cmd and digit == 0) {
                    state = on_back(state);
                } else if (kp != PETAL_NONE and menu_open(state) == false) {
                    state = kp;
                    shown = kp;
                } else if (key == KEY_S and cmd and has_mod(flags, MOD_SHIFT)) {
                    collapsed = collapsed == false;
                } else if (key == KEY_F and cmd and has_mod(flags, MOD_CONTROL)) {
                    msg1(win, s_full, 0);
                } else {
                    used = false;
                }
            }
            if (used == false) { msg1(app, s_send, ev); }
            ev = msg_event(app, s_next, 0xffffffffffffffff, 0, mode, true);
        }
        ma = wave(ma, menu_open(state));
        var hov : u32 = PETAL_NONE;
        if (home_live) { hov = hit_px(vx, vy, 960, 540); }
        var on_control : bool = on_home_button(mx, my, full) or on_full_button(mx, my, sw) or on_dock_button(mx, my, sw);
        if (screen and (on_nav_back(mx, my, full) or on_side_toggle(mx, my, ws, collapsed))) { on_control = true; }
        if (screen and (on_open_dash(mx, my, sw, ws) or on_close_dash(mx, my, ws, collapsed))) { on_control = true; }
        if (hov != PETAL_NONE or on_control) { msg0(hand, s_cursor_set); } else { msg0(arrow, s_cursor_set); }
        msg_flag(tx_cls, s_quiet, true);
        if (narrow) {
            draw(cc, kit, frame, state, hov, ma, shown, collapsed, mx, my, z, sw, sh, ws, full);
            const whole : u64 = cg_image(cc);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * RETINA, sh * RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        } else {
            draw(c, kit, frame, state, hov, ma, shown, collapsed, mx, my, z, sw, sh, ws, full);
            const whole : u64 = cg_image(c);
            const img : u64 = cg_crop(whole, 0.0, 0.0, sw * WIDE_RETINA, sh * WIDE_RETINA);
            msg1(layer, s_contents, img);
            cg_image_release(img);
            cg_image_release(whole);
        }
        frame = frame + 1;
        pool_pop(pool);
    }
}

// ---- tests ----

test the_screen_cross_fades_in_a_quarter_second {
    var a : f64 = 0.0;
    var i : u32 = 0;
    while (i < 7) { a = wave(a, true); i = i + 1; }
    assert a < 1.0;
    a = wave(a, true);
    assert a > 0.999;
    // 8 frames at 30 fps = 0.267 s, the nearest frame count to trios' 0.25 s easeInOut
    assert @abs(8.0 * FRAME_S - 0.25) < 0.02;
    i = 0;
    while (i < 8) { a = wave(a, false); i = i + 1; }
    assert a < 0.001;
}

test the_blocks_fly_in_from_800_units_and_settle_home {
    assert anim_off(0) == 800.0;
    assert anim_off(1) < 800.0;
    assert anim_off(40) < 10.0;
    assert anim_off(ANIM_FRAMES) == 0.0;
}

test the_glass_carries_trios_numbers {
    assert TINT_BLACK == 0.30;
    assert SURFACE_BLACK == 0.46;
    assert SIDEBAR_BLACK == 0.22;
    assert CONTENT_BLACK == 0.14;
    assert BORDER_WHITE == 0.14;
    assert SIDE_W == 272.0;
    assert HEADER_H == 44.0;
    assert WS_TOP == AREA_TOP;
    assert READABLE_W == 900.0;
    assert chan(outline(), 3) == 1.0;
}

test every_petal_flies_out_along_a_unit_direction {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const x : f64 = dir(p, 0);
        const y : f64 = dir(p, 1);
        assert @abs(x * x + y * y - 1.0) < 0.000001;
        p = p + 1;
    }
}

test the_title_bar_controls_clear_the_traffic_lights {
    // T. macOS draws close / minimise / zoom in x < 76 of the title bar.
    assert HOME_X >= 76.0;
    assert on_home_button(30.0, 17.0, false) == false;
    assert on_home_button(HOME_X + 10.0, 17.0, false);
    // full screen: the logo moves onto the back chevron's line
    assert on_home_button(FULL_HOME_X + 10.0, 17.0, true);
    assert home_x(true) < home_x(false);
    assert on_full_button(full_x(W_PT) + 10.0, 17.0, W_PT);
    assert full_x(W_PT) + FULL_PT <= W_PT - 16.0;
    assert on_dock_button(dock_x(W_PT) + 10.0, 17.0, W_PT);
    assert on_dock_button(full_x(W_PT) + 10.0, 17.0, W_PT) == false;
    assert dock_x(PANEL_W) > HOME_X + HOME_BTN_W;
    assert on_nav_back(30.0, 17.0, false) == false;
    assert on_nav_back(HOME_X + 4.0, 17.0, false);
    assert on_nav_back(30.0, AREA_TOP + 16.0, false) == false;
}

test the_home_logo_fills_063_of_the_area_and_maps_the_mouse_back {
    const z : f64 = 1.0;
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * home_k(z, W_PT, H_PT);
    assert @abs(h - LOGO_SHARE * (H_PT - AREA_TOP)) < 0.001;
    // the logo's own middle sits mid-area
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT));
    assert @abs(my - 0.5 * (AREA_TOP + H_PT)) < 0.001;
    // the logo stays below the title bar
    assert to_pt(logo_edge(1, false), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) > AREA_TOP;
    // the mouse on the logo centre maps to the centre petal_menu's hit test uses
    assert @abs(virt(home_c(0, z, W_PT, H_PT), 0, z, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, z, W_PT, H_PT), 1, z, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_tooltip_floats_30_points_above_its_petal {
    const z : f64 = 1.0;
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert @abs(to_pt(cen_y(p), 1, home_c(1, z, W_PT, H_PT), home_k(z, W_PT, H_PT)) - tip_y(p, z, W_PT, H_PT) - TIP_RISE) < 0.001;
        p = p + 1;
    }
}

test the_menu_shortcuts_follow_queen_menu_shortcut_policy {
    assert digit_of(18) == 1;
    assert digit_of(25) == 9;
    assert digit_of(29) == 0;
    assert digit_of(0) == NO_DIGIT;
    assert petal_for_key(1, MOD_COMMAND) == 0;
    assert petal_for_key(9, MOD_COMMAND) == 8;
    assert petal_for_key(1, MOD_OPTION) == 9;
    assert petal_for_key(9, MOD_OPTION) == 17;
    assert petal_for_key(1, MOD_CONTROL) == 18;
    assert petal_for_key(9, MOD_CONTROL) == 26;
    assert petal_for_key(1, MOD_COMMAND + MOD_SHIFT) == PETAL_NONE;
    assert petal_for_key(1, MOD_COMMAND + MOD_OPTION) == PETAL_NONE;
    assert petal_for_key(0, MOD_COMMAND) == PETAL_NONE;
    assert petal_for_key(1, 0) == PETAL_NONE;
}

test the_sidebar_collapses_and_the_cards_take_the_room {
    assert content_x(WS_EXPANDED, false) == SIDE_W + 1.0;
    assert content_x(WS_EXPANDED, true) == 0.0;
    assert body_w(W_PT, WS_EXPANDED, true) == READABLE_W;
    assert body_w(W_PT, WS_EXPANDED, false) < READABLE_W;
    assert body_left(W_PT, WS_EXPANDED, false) >= content_x(WS_EXPANDED, false) + BODY_PAD;
    assert body_left(W_PT, WS_EXPANDED, true) + body_w(W_PT, WS_EXPANDED, true) <= W_PT - BODY_PAD;
    assert on_side_toggle(SIDE_W + 1.0 + 20.0, WS_TOP + 22.0, WS_EXPANDED, false);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, true);
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    const el : f64 = body_left(W_PT, WS_EXPANDED, false);
    const ew : f64 = body_w(W_PT, WS_EXPANDED, false);
    const eh : f64 = body_h(W_PT, H_PT, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, el, body_top(WS_EXPANDED), ew, eh), hex_c(0, 1, el, body_top(WS_EXPANDED), ew, eh), W_PT, H_PT, WS_EXPANDED, false) == 0;
    const cl : f64 = body_left(W_PT, WS_EXPANDED, true);
    const cw2 : f64 = body_w(W_PT, WS_EXPANDED, true);
    const ch2 : f64 = body_h(W_PT, H_PT, WS_EXPANDED, true);
    assert card_at(hex_c(4, 0, cl, body_top(WS_EXPANDED), cw2, ch2), hex_c(4, 1, cl, body_top(WS_EXPANDED), cw2, ch2), W_PT, H_PT, WS_EXPANDED, true) == 4;
    assert card_at(10.0, 10.0, W_PT, H_PT, WS_EXPANDED, false) == CARD_SLOTS;
}

test the_dock_icon_is_a_centred_white_logo_on_black {
    const k : f64 = logo_k_for(ICON_LOGO_PX);
    const h : f64 = (logo_edge(1, true) - logo_edge(1, false)) / 1000.0 * scale() * k;
    assert @abs(h - ICON_LOGO_PX) < 0.001;
    // the logo's own middle lands on the icon centre on both axes
    const mx : f64 = to_pt(0.5 * (logo_edge(0, false) + logo_edge(0, true)), 0, icon_cen(0), k);
    const my : f64 = to_pt(0.5 * (logo_edge(1, false) + logo_edge(1, true)), 1, icon_cen(1), k);
    assert @abs(mx - 0.5 * ICON_SIZE) < 0.001;
    assert @abs(my - 0.5 * ICON_SIZE) < 0.001;
    assert ICON_LOGO_PX < ICON_TILE;
}

test the_cards_cascade_in_and_all_arrive_at_full_alpha {
    assert card_alpha(0.3, 0) > card_alpha(0.3, 8);
    var k : u32 = 0;
    while (k < CARD_SLOTS) { assert card_alpha(1.0, k) == 1.0; k = k + 1; }
}

test full_screen_keeps_the_scene_aspect_and_maps_the_mouse_back {
    assert fit(960.0, 540.0, W_PT, H_PT) == 1.0;
    assert fit(1920.0, 1200.0, W_PT, H_PT) == 2.0;
    assert view_to_scene(960.0, 1920.0, 1200.0, 0, W_PT, H_PT) == 480.0;
    assert view_to_scene(600.0, 1920.0, 1200.0, 1, W_PT, H_PT) == 270.0;
    assert view_to_scene(0.0, 960.0, 540.0, 1, W_PT, H_PT) == 540.0;
}

test full_screen_draws_the_home_logo_20_percent_smaller_and_still_hits {
    assert @abs(home_px(FULL_LOGO, W_PT, H_PT) - 0.8 * home_px(1.0, W_PT, H_PT)) < 0.000001;
    assert @abs(home_k(FULL_LOGO, W_PT, H_PT) - 0.8 * home_k(1.0, W_PT, H_PT)) < 0.000001;
    assert has_mod(MASK_FULL_SCREEN + STYLE, MASK_FULL_SCREEN);
    assert has_mod(STYLE, MASK_FULL_SCREEN) == false;
    // the smaller logo stays centred, and the mouse on its centre still maps to the hit-test centre
    assert @abs(virt(home_c(0, FULL_LOGO, W_PT, H_PT), 0, FULL_LOGO, W_PT, H_PT) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, FULL_LOGO, W_PT, H_PT), 1, FULL_LOGO, W_PT, H_PT) - 0.5 * H_PT) < 0.001;
}

test the_window_folds_into_the_trios_compact_panel_below_760 {
    // K. ChatWorkspaceLayout: expanded from 760, compact below, the forced dashboard on request.
    assert workspace(759.0, false) == WS_COMPACT;
    assert workspace(760.0, false) == WS_EXPANDED;
    assert workspace(760.0, true) == WS_EXPANDED;
    assert workspace(PANEL_W, true) == WS_DASHBOARD;
    assert side_w(WS_COMPACT, false) == 0.0;
    assert side_w(WS_DASHBOARD, false) == 0.0;
    assert side_w(WS_EXPANDED, false) == SIDE_W;
    // the OPEN DASHBOARD bar spans the panel, and only in compact
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_COMPACT);
    assert on_open_dash(200.0, WS_TOP + 10.0, PANEL_W, WS_DASHBOARD) == false;
    assert on_open_dash(200.0, WS_TOP + BAR_H + 5.0, PANEL_W, WS_COMPACT) == false;
    // Close Dashboard sits right of the toggle, only in the forced dashboard
    assert on_close_dash(close_x(WS_DASHBOARD, false) + 10.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    assert on_close_dash(close_x(WS_EXPANDED, false) + 10.0, WS_TOP + 22.0, WS_EXPANDED, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_COMPACT, false) == false;
    assert on_side_toggle(20.0, WS_TOP + 22.0, WS_DASHBOARD, false);
    // the narrow scene is the view point for point; the cards take the panel under the bar
    assert scene(PANEL_W, 900.0, 0) == PANEL_W;
    assert scene(PANEL_W, 900.0, 1) == 900.0;
    assert scene(PANEL_W, 2000.0, 1) == CH_MAX;
    assert fit(PANEL_W, 900.0, PANEL_W, 900.0) == 1.0;
    assert body_w(PANEL_W, WS_COMPACT, false) == PANEL_W - 2.0 * BODY_PAD;
    const kl : f64 = body_left(PANEL_W, WS_COMPACT, false);
    const kw : f64 = body_w(PANEL_W, WS_COMPACT, false);
    const kh : f64 = body_h(PANEL_W, 900.0, WS_COMPACT, false);
    assert card_at(hex_c(4, 0, kl, body_top(WS_COMPACT), kw, kh), hex_c(4, 1, kl, body_top(WS_COMPACT), kw, kh), PANEL_W, 900.0, WS_COMPACT, false) == 4;
    // the slots keep their wide shape instead of stretching down the panel
    assert @abs(body_h(PANEL_W, 900.0, WS_COMPACT, false) / body_w(PANEL_W, WS_COMPACT, false) - wide_shape()) < 0.000001;
    assert body_h(PANEL_W, 900.0, WS_COMPACT, false) < 900.0 - body_top(WS_COMPACT) - BODY_PAD;
    // the home logo fits inside the 400 pt panel and still maps back to the hit-test centre
    const k : f64 = home_k(1.0, PANEL_W, 900.0);
    assert to_pt(logo_edge(0, false), 0, home_c(0, 1.0, PANEL_W, 900.0), k) > 0.0;
    assert to_pt(logo_edge(0, true), 0, home_c(0, 1.0, PANEL_W, 900.0), k) < PANEL_W;
    assert @abs(virt(home_c(0, 1.0, PANEL_W, 900.0), 0, 1.0, PANEL_W, 900.0) - 0.5 * W_PT) < 0.001;
    assert @abs(virt(home_c(1, 1.0, PANEL_W, 900.0), 1, 1.0, PANEL_W, 900.0) - 0.5 * H_PT) < 0.001;
    // the compact bitmap holds the widest and tallest narrow scene
    assert CW_MAX * RETINA <= 3040.0;
    assert CH_MAX * RETINA <= 5200.0;
}

test full_screen_draws_point_for_point_on_black_glass {
    // F. a 1728 x 1117 pt full screen is its own scene: no 960 x 540 upscale, no letterbox bands
    assert scene(1728.0, 1117.0, 0) == 1728.0;
    assert scene(1728.0, 1117.0, 1) == 1117.0;
    assert fit(1728.0, 1117.0, scene(1728.0, 1117.0, 0), scene(1728.0, 1117.0, 1)) == 1.0;
    assert scene(W_PT, H_PT, 0) == W_PT;
    assert scene(3000.0, 2000.0, 0) == SW_MAX;
    assert scene(3000.0, 2000.0, 1) == SH_MAX;
    assert SW_MAX * WIDE_RETINA <= 3840.0;
    assert SH_MAX * WIDE_RETINA <= 2400.0;
    // the hairline is one device pixel at the display's own scale
    assert HAIR * WIDE_RETINA == 1.0;
    assert TINT_FULL > TINT_BLACK;
    assert TINT_FULL < 1.0;
    // F. the background is opaque black: R = G = B = 0, alpha 1
    assert BACK_BLACK == 1.0;
    assert CROWN_WHITE == 0.70;
    assert STRICT_CARD_EDGE > STRICT_CARD_FILL;
    // the cards still tile the readable column in full screen
    const fl : f64 = body_left(1728.0, WS_EXPANDED, false);
    const fw : f64 = body_w(1728.0, WS_EXPANDED, false);
    const fh : f64 = body_h(1728.0, 1117.0, WS_EXPANDED, false);
    assert card_at(hex_c(0, 0, fl, body_top(WS_EXPANDED), fw, fh), hex_c(0, 1, fl, body_top(WS_EXPANDED), fw, fh), 1728.0, 1117.0, WS_EXPANDED, false) == 0;
}

test logo_is_the_brand_mark_and_title_says_trinity_once {
    // H. white petals with no outline, the centre left open, as the Trinity S3AI mark
    assert LOGO_WHITE > 0.9;
    assert LOGO_WHITE <= 1.0;
    // S. one bar: the back chevron sits in the title bar right before the logo
    assert on_nav_back(FULL_HOME_X + 2.0, 0.5 * TITLE_H, true);
    assert on_nav_back(FULL_HOME_X + 2.0, AREA_TOP + 10.0, true) == false;
    // L. layout.t27: chevron, logo and TRINITY on one centre line, equal gaps, equal icon heights
    assert NAV_SHIFT == row_next(0.0, CHEV_W, ROW_GAP);
    assert same_line(cap_mid(baseline_for(0.5 * TITLE_H, 11.0), 11.0), 0.5 * TITLE_H);
    assert title_logo_w() > ROW_ICON_H;
    assert title_logo_w() < 2.0 * ROW_ICON_H;
}

test cards_are_a_honeycomb_and_the_logo_has_two_sizes {
    // C. a 600 x 500 body: the comb fits both ways, cells do not touch, the middle row sits half a cell right
    const r : f64 = hex_r(600.0, 500.0);
    assert 3.5 * SQRT3 * r + 2.5 * HEX_GAP <= 600.001;
    assert 5.0 * r + 2.0 * HEX_GAP <= 500.001;
    assert in_hex(hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), hex_c(0, 0, 0.0, 0.0, 600.0, 500.0), hex_c(0, 1, 0.0, 0.0, 600.0, 500.0), r);
    assert hex_c(1, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) > SQRT3 * r;
    assert @abs(hex_c(3, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0) - 0.5 * (SQRT3 * r + HEX_GAP)) < 0.001;
    assert @abs(hex_c(6, 0, 0.0, 0.0, 600.0, 500.0) - hex_c(0, 0, 0.0, 0.0, 600.0, 500.0)) < 0.001;
    // a corner of the bounding box is outside the hexagon
    assert in_hex(0.0, 0.0, 0.5 * SQRT3 * r, r, r) == false;
    // H. the large mark is parted by a black cut; the small one by a finer one
    assert LOGO_SEAL > 0.0;
    assert LOGO_SEAL < LOGO_CUT;
}

test small_mark_keeps_the_centre_hole {
    // H. the hole is the mark's inner equilateral triangle: height = width * sqrt(3) / 2 within 1 percent
    const wd : f64 = HOLE_R - HOLE_L;
    assert @abs((HOLE_AY - HOLE_TOP) - 0.5 * SQRT3 * wd) < 0.01 * wd;
    assert @abs(HOLE_AX - 0.5 * (HOLE_L + HOLE_R)) < 1000.0;
    // it sits inside the logo box
    assert HOLE_L > logo_edge(0, false);
    assert HOLE_R < logo_edge(0, true);
    assert HOLE_TOP > logo_edge(1, false);
    assert HOLE_AY < logo_edge(1, true);
    assert HOLE_GROW > 1.0;
}
