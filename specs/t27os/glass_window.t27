    dk[DK_FLAGS] = msg0(marr, dk[DK_NEW]);
    dk[DK_KB] = msg0(marr, dk[DK_NEW]);
    dk[DK_BUILD] = msg0(marr, dk[DK_NEW]);
    dk[DK_REMOTE] = msg0(marr, dk[DK_NEW]);
    dk[DK_BRANCH] = msg0(marr, dk[DK_NEW]);
    dk[DK_MARK] = msg0(marr, dk[DK_NEW]);
