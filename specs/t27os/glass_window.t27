// ---- imports: Foundation, the ObjC runtime, AppKit through objc_msgSend, CoreGraphics, CoreText ----

fn cf_bytes(alloc: u64, bytes: []const u8, n: usize, enc: u32, ext: bool) -> u64 { return @extern("CFStringCreateWithBytes"); }
fn cf_release(o: u64) -> void { @extern("CFRelease"); }
fn class_named(name: u64) -> u64 { return @extern("NSClassFromString"); }
fn sel_named(name: u64) -> u64 { return @extern("NSSelectorFromString"); }
fn pool_push() -> u64 { return @extern("objc_autoreleasePoolPush"); }
fn pool_pop(p: u64) -> void { @extern("objc_autoreleasePoolPop"); }
fn msg0(o: u64, s: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg1(o: u64, s: u64, a: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg2(o: u64, s: u64, a: u64, b: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg_flag(o: u64, s: u64, a: bool) -> u64 { return @extern("objc_msgSend"); }
fn msg_test(o: u64, s: u64) -> bool { return @extern("objc_msgSend"); }
fn msg_f(o: u64, s: u64, t: f64) -> u64 { return @extern("objc_msgSend"); }
fn msg_ff(o: u64, s: u64, a: f64, b: f64) -> u64 { return @extern("objc_msgSend"); }
fn msg_dict(o: u64, s: u64, vals: [2]u64, keys: [2]u64, n: u64) -> u64 { return @extern("objc_msgSend"); }
fn msg_rect(o: u64, s: u64, x: f64, y: f64, w: f64, h: f64) -> u64 { return @extern("objc_msgSend"); }
fn msg_window(o: u64, s: u64, x: f64, y: f64, w: f64, h: f64, style: u64, backing: u64, later: bool) -> u64 { return @extern("objc_msgSend"); }
fn msg_event(o: u64, s: u64, mask: u64, until: u64, mode: u64, dequeue: bool) -> u64 { return @extern("objc_msgSend"); }
fn msg_point(o: u64, s: u64, out: [2]f64) -> void { @extern("objc_msgSend"); }
fn msg_frame(o: u64, s: u64, out: [4]f64) -> void { @extern("objc_msgSend"); }
fn msg_image(o: u64, s: u64, img: u64, w: f64, h: f64) -> u64 { return @extern("objc_msgSend"); }

fn cg_rgb() -> u64 { return @extern("CGColorSpaceCreateDeviceRGB"); }
fn cg_bitmap(data: u64, w: usize, h: usize, bits: usize, row: usize, space: u64, info: u32) -> u64 { return @extern("CGBitmapContextCreate"); }
fn cg_image(c: u64) -> u64 { return @extern("CGBitmapContextCreateImage"); }
fn cg_image_release(i: u64) -> void { @extern("CGImageRelease"); }
fn cg_translate(c: u64, x: f64, y: f64) -> void { @extern("CGContextTranslateCTM"); }
fn cg_scale(c: u64, x: f64, y: f64) -> void { @extern("CGContextScaleCTM"); }
fn cg_clear(c: u64, x: f64, y: f64, w: f64, h: f64) -> void { @extern("CGContextClearRect"); }
fn cg_fill_rect(c: u64, x: f64, y: f64, w: f64, h: f64) -> void { @extern("CGContextFillRect"); }
fn cg_fill_rgba(c: u64, r: f64, g: f64, b: f64, a: f64) -> void { @extern("CGContextSetRGBFillColor"); }
fn cg_stroke_rgba(c: u64, r: f64, g: f64, b: f64, a: f64) -> void { @extern("CGContextSetRGBStrokeColor"); }
fn cg_line_width(c: u64, w: f64) -> void { @extern("CGContextSetLineWidth"); }
fn cg_move(c: u64, x: f64, y: f64) -> void { @extern("CGContextMoveToPoint"); }
fn cg_line(c: u64, x: f64, y: f64) -> void { @extern("CGContextAddLineToPoint"); }
fn cg_arc(c: u64, x: f64, y: f64, r: f64, a0: f64, a1: f64, cw: u32) -> void { @extern("CGContextAddArc"); }
fn cg_close(c: u64) -> void { @extern("CGContextClosePath"); }
fn cg_fill_path(c: u64) -> void { @extern("CGContextFillPath"); }
fn cg_stroke_path(c: u64) -> void { @extern("CGContextStrokePath"); }
fn cg_round_rect(x: f64, y: f64, w: f64, h: f64, rx: f64, ry: f64, t: u64) -> u64 { return @extern("CGPathCreateWithRoundedRect"); }
fn cg_add_path(c: u64, p: u64) -> void { @extern("CGContextAddPath"); }
fn cg_path_release(p: u64) -> void { @extern("CGPathRelease"); }
fn cg_color(r: f64, g: f64, b: f64, a: f64) -> u64 { return @extern("CGColorCreateGenericRGB"); }
