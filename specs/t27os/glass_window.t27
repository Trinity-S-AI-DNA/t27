test the_word_map_claim_refuses_an_overlap_and_a_word_past_the_end {
    var seen : [256]u8 = undefined;
    var z : usize = 0;
    while (z < 256) {
        seen[z] = 0;
        z = z + 1;
    }
    assert wm_claim(seen[0..256], 168, 32);
    // the old U_FAILS word sat inside that span
    assert wm_claim(seen[0..256], 180, 1) == false;
    assert wm_claim(seen[0..256], 200, 32);
    assert wm_claim(seen[0..256], 255, 2) == false;
    assert wm_claim(seen[0..256], 256, 1) == false;
    assert wm_claim(seen[0..256], 5, 0) == false;
}

// Crash guard (#12368): the orbit stores its i64 layout in u64 words and must never trap on a negative value or on
// a word another name overwrote.
test the_orbit_store_and_load_clamp_instead_of_trapping {
    assert orb_w(0) == 0;
    assert orb_w(-1) == 0;
    assert orb_w(-9223372036854775807) == 0;
    assert orb_w(412) == 412;
    // a value in range comes back as it went in
    assert orb_r(orb_w(0)) == 0;
    assert orb_r(orb_w(412)) == 412;
    assert orb_r(orb_w(9223372036854775807)) == 9223372036854775807;
    // a word above i64 max (any neighbour's data) reads as 0
    assert orb_r(0x8000000000000000) == 0;
    assert orb_r(0xFFFFFFFFFFFFFFFF) == 0;
}

test the_orbit_slot_count_never_passes_the_32_slots_of_the_arrays {
    assert orb_n(0) == 0;
    assert orb_n(7) == 7;
    assert orb_n(32) == 32;
    assert orb_n(33) == 32;
    assert orb_n(0xFFFFFFFFFFFFFFFF) == 32;
}

test the_orbit_tick_survives_words_that_hold_garbage {
    var tg : [256]u64 = undefined;
    var z : usize = 0;
    while (z < 256) {
        tg[z] = 0;
        z = z + 1;
    }
    orbit_tick(tg[0..256], 1.0, 1280.0, 800.0, 100.0, 100.0, 5.0, false);
    assert tg[TPG_O_N] <= 32;
    // poison what the layout, the clock and the slot count hold, then tick again: no trap, the count stays in range
    tg[TPG_O_HX] = 0xFFFFFFFFFFFFFFFF;
    tg[TPG_O_HY + 1] = 0x8000000000000000;
    tg[TPG_O_HP + 2] = 0xFFFFFFFFFFFFFFFF;
    tg[TPG_O_CLOCK] = 0xFFFFFFFFFFFFFFFF;
    tg[TPG_O_LAST] = 0xFFFFFFFFFFFFFFFF;
    tg[TPG_O_N] = 0xFFFFFFFFFFFFFFFF;
    orbit_tick(tg[0..256], 1.0, 1280.0, 800.0, 100.0, 100.0, 6.0, false);
    assert orbit_pick(tg[0..256], 100.0, 100.0, 1280.0, 800.0) >= -1;
}

// ---- idle CPU (2026-10-25, Refs #12368): the frame bitmaps, the occlusion test and the orbit's key part ----

test the_frame_bitmaps_are_bgra_premultiplied_first_as_the_layer_composites {
    // kCGImageAlphaPremultipliedFirst (2) | kCGBitmapByteOrder32Little (2 << 12)
    assert frame_bitmap_info(CG_ALPHA_PREMUL_FIRST, CG_ORDER_32_LITTLE) == BGRA_PREMUL_FIRST;
    assert frame_bitmap_info(CG_ALPHA_PREMUL_FIRST, CG_ORDER_32_LITTLE) != ALPHA_PREMUL_LAST;
    assert frame_bitmap_info(ALPHA_PREMUL_LAST, 0) == ALPHA_PREMUL_LAST;
}

test a_window_is_seen_when_its_occlusion_state_has_the_visible_bit {
    assert on_screen(OCC_VISIBLE);
    assert on_screen(OCC_VISIBLE | 8192);
    assert on_screen(0) == false;
    assert on_screen(8192) == false;
}

test the_orbit_key_follows_the_label_positions_and_nothing_else {
    var tg : [256]u64 = undefined;
    var z : usize = 0;
    while (z < 256) {
        tg[z] = 0;
        z = z + 1;
    }
    orbit_tick(tg[0..256], 1.0, 1280.0, 800.0, -50.0, -50.0, 5.0, false);
    assert tg[TPG_O_N] > 0;
    tg[TPG_O_CLOCK] = 1000;
    const k1 : u64 = orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0);
    // the same state gives the same key
    assert orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0) == k1;
    // a quarter turn later (60 s at 1.5 degrees a second) the labels stand elsewhere
    tg[TPG_O_CLOCK] = 61000;
    assert orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0) != k1;
    // reduced motion holds the orbit still: the clock no longer moves the key
    tg[TPG_O_RM] = 1;
    const k2 : u64 = orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0);
    tg[TPG_O_CLOCK] = 1000;
    assert orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0) == k2;
    // an empty orbit has one key whatever its clock says
    tg[TPG_O_N] = 0;
    tg[TPG_O_RM] = 0;
    const k3 : u64 = orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0);
    tg[TPG_O_CLOCK] = 61000;
    assert orbit_key(tg[0..256], -50.0, -50.0, 1280.0, 800.0) == k3;
}

// ---- the heartbeat file (crash guard, issue 12368) ----

test the_app_nap_opt_out_is_user_initiated_without_holding_the_system_awake {
    // NSActivityUserInitiated is 0x00FFFFFF; bit 20 is NSActivityIdleSystemSleepDisabled, which must stay off.
    assert nap_opts(false) == NAP_OFF_OPTS;
    assert (nap_opts(false) & NS_ACT_IDLE_SLEEP_OFF) == 0;
    assert (nap_opts(true) & NS_ACT_IDLE_SLEEP_OFF) != 0;
    // NSActivityIdleDisplaySleepDisabled is bit 40; the display may still sleep either way.
    assert nap_opts(false) < 0x10000000000;
    assert nap_opts(true) < 0x10000000000;
}

test the_beat_text_is_the_pid_a_space_the_unix_second_and_a_newline {
    var out : [48]u8 = undefined;
    const n : usize = beat_text(out[0..48], 123, 1700000000);
    assert n == 15;
    assert out[0] == 49 and out[1] == 50 and out[2] == 51;
    assert out[3] == 32;
    assert out[4] == 49 and out[5] == 55 and out[6] == 48 and out[13] == 48;
    assert out[14] == 10;
    const m : usize = beat_text(out[0..48], 1, 9);
    assert m == 4;
    assert out[0] == 49 and out[1] == 32 and out[2] == 57 and out[3] == 10;
}

test the_beat_path_lives_under_the_live_folder_and_ends_in_a_nul {
    var out : [320]u8 = undefined;
    const n : usize = beat_path("/Users/tester", out[0..320], false);
    assert n == 34;
    assert out[n] == 0;
    assert out[13] == 47 and out[14] == 46;
    assert out[n - 1] == 116 and out[n - 2] == 97;
    const t : usize = beat_path("/Users/tester", out[0..320], true);
    assert t == 38;
    assert out[34] == 46 and out[35] == 116 and out[36] == 109 and out[37] == 112;
    assert out[t] == 0;
}

test the_beat_path_refuses_a_home_that_does_not_fit {
    var out : [320]u8 = undefined;
    var long : [256]u8 = undefined;
    var i : usize = 0;
    while (i < 256) {
        long[i] = 97;
        i = i + 1;
    }
    assert beat_path(long[0..201], out[0..320], false) == 0;
    assert beat_path(long[0..200], out[0..320], false) == 221;
    assert beat_path("/Users/tester", out[0..100], false) == 0;
}
