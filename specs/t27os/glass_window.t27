    var wpass : u64 = 0;
    var widle : u32 = RESCAN_FRAMES;
    var vr : u64 = 0;
    var jr : u64 = 0;
    var jj : u32 = 0;
    var jpass : u32 = 0;
    var jrest : u32 = 0;
