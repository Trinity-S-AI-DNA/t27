// ---- trios blackGlass values ----

/// F. Owner, 2026-10-20: 'where did the matte glass go?' The window's ground is black (RGB 0) at 0.55 over the
/// behind-window blur: the desktop glows through blurred and darkened (0.92 killed it). The surfaces are
/// lighter frosted layers on it (SURF_FROST white). Full screen is 1.0 (TINT_FULL), opaque #000000.
pub const TINT_BLACK : f64 = 0.55;
/// F. The frost a window surface adds over its black fill: white 0.05 (the hairlines are white 0.10).
pub const SURF_FROST : f64 = 0.05;
/// F. The ground's colour channel, the same for red, green and blue in both modes: #000000.
pub const GROUND_RGB : f64 = 0.0;
pub const BORDER_WHITE : f64 = 0.14;
pub const SURFACE_BLACK : f64 = 0.46;
pub const ELEVATED_BLACK : f64 = 0.58;
pub const SIDEBAR_BLACK : f64 = 0.22;
pub const CONTENT_BLACK : f64 = 0.14;
pub const HIGHLIGHT_WHITE : f64 = 0.08;
pub const MUTED_WHITE : f64 = 0.62;
pub const NAV_SHADE : f64 = 0.72;
pub const TIP_WHITE : f64 = 0.94;
/// F. The screen is black and white (t27#10831 FR-006): the queen crown is white at the old alpha.
pub const CROWN_WHITE : f64 = 0.70;
/// NSFontWeight
pub const WEIGHT_MEDIUM : f64 = 0.23;
pub const WEIGHT_SEMIBOLD : f64 = 0.3;
pub const WEIGHT_BOLD : f64 = 0.4;
