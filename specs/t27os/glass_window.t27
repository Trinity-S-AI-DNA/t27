fn cg_translate(c: u64, x: f64, y: f64) -> void { @extern("CGContextTranslateCTM"); }
fn cg_scale(c: u64, x: f64, y: f64) -> void { @extern("CGContextScaleCTM"); }
fn cg_clear(c: u64, x: f64, y: f64, w: f64, h: f64) -> void { @extern("CGContextClearRect"); }
