// S. SPECS (t27f#12199): the S petal's whole page state (PSV_BYTES = 48 bytes, the petal spec's psv_store_bytes),
// appended at the top of the same convention. It lives here, not in the tg words, because every free run of six
// tg words was taken; launch zeroes it, and a zero state reads as "not opened" (psv_open).
pub const TBO_SV : usize = 90112;
pub const TBO_SV_N : usize = 64;
pub const TB_SIZE : usize = 90176;
pub const TG_KEY_RETURN : u64 = 36;
pub const TG_KEY_BACKSPACE : u64 = 51;
pub const TG_EV_CHAR : u32 = 99;
pub const TG_EV_BACK : u32 = 98;
pub const TG_TZ_BIAS : u64 = 200000;

/// The bytes of ~/<dir><file> into dst; the count (0 when the file is missing or empty).
fn tg_read(hb: []const u8, dir: []const u8, file: []const u8, dst: []u8) -> usize {
    var pb : [320]u8 = undefined;
    var n : usize = put_bytes(pb[0..320], 0, hb);
    n = put_bytes(pb[0..320], n, dir);
    n = put_bytes(pb[0..320], n, file);
    pb[n] = 0;
    const fd : i32 = sys_open_ro(pb[0..320], 0);
    if (fd < 0) { return 0; }
    const r : i64 = sys_read(fd, dst, @as(u64, dst.len));
    sys_close(fd);
    if (r <= 0) { return 0; }
    return @as(usize, @intCast(r));
}

/// Keep whole lines only: the length up to and including the last LF of buf[at .. at + n].
fn tg_whole_lines(buf: []const u8, at: usize, n: usize) -> usize {
    var e : usize = n;
    while (e > 0 and buf[at + e - 1] != 10) { e = e - 1; }
    return e;
}

/// Start `/bin/sh -c <cmd>` where tb[at .. at + 6] is reserved for "sh", "-c" and the command is tb[at + 6 .. end].
/// The pid, 0 when the spawn failed.
fn tg_spawn(tb: []u8, at: usize, end: usize) -> u64 {
    tb[at] = 115;
    tb[at + 1] = 104;
    tb[at + 2] = 0;
    tb[at + 3] = 45;
    tb[at + 4] = 99;
    tb[at + 5] = 0;
    tb[end] = 0;
    var argv : [8]u64 = undefined;
    argv[0] = sys_addr(tb[at .. tb.len], tb[0..1], 0);
    argv[1] = sys_addr(tb[at + 3 .. tb.len], tb[0..1], 0);
    argv[2] = sys_addr(tb[at + 6 .. tb.len], tb[0..1], 0);
    argv[3] = 0;
    argv[4] = 0;
    argv[5] = 0;
    argv[6] = 0;
    argv[7] = 0;
    var cp : [16]u8 = undefined;
    put_bytes(cp[0..16], 0, "/bin/sh");
    cp[7] = 0;
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    const rc : i32 = sys_spawn(pid, cp[0..16], 0, 0, argv, 0);
    if (rc != 0 or pid[0] == 0) { return 0; }
    return @as(u64, pid[0]);
}

/// A word that can be a real process id: 1 ..= 0x7FFFFFFF. 0 is "no job"; a bigger word is a neighbour's data
/// (a host name, an orbit coordinate), and @intCast of it to i32 trapped (EXC_BREAKPOINT, brk #0x7) the whole app.
/// Every pid word goes through here before a syscall. A bad pid is never turned into 0 or -1, because
/// kill(-1, 9) kills everything the user owns and waitpid(0 or -1) reaps a child that is not ours.
fn pid_ok(pid: u64) -> bool {
    return pid >= 1 and pid <= 0x7FFFFFFF;
}

/// SIGKILL a job, once its pid word is a pid. Nothing happens for a bad word.
fn tg_kill(pid: u64) -> void {
    if (pid_ok(pid)) { sys_kill(@as(i32, @intCast(pid)), 9); }
}

/// 0 while the job runs, 1 when it ended well, 2 when it failed or is gone (a bad pid word is gone, never reaped).
fn tg_done(pid: u64) -> u32 {
    if (pid_ok(pid) == false) { return 2; }
    var st : [2]u32 = undefined;
    st[0] = 0;
    const r : i32 = sys_waitpid(@as(i32, @intCast(pid)), st, 1);
    if (r == 0) { return 0; }
    if (r > 0 and st[0] == 0) { return 1; }
    return 2;
}

/// The head of every host script: sh, -c, then `export HOME=".."; export PATH=..; D=..; mkdir -p $D; ` (a, b = the two halves).
fn tg_head(tb: []u8, hb: []const u8, a: []const u8, b: []const u8) -> usize {
    var e : usize = TBO_CMD + 6;
    e = put_bytes(tb, e, a);
    e = put_bytes(tb, e, hb);
    e = put_bytes(tb, e, b);
    return e;
}

/// A job that has outlived FEED_KILL_S is killed; the next reap clears it.
fn tg_late(now: u64, start: u64, pid: u64) -> void {
    if (now > start + FEED_KILL_S) { tg_kill(pid); }
}

fn tg_bump(tg: []u64) -> void { tg[TPG_GEN] = tg[TPG_GEN] + 1; }

// ---- B: the BENCH host feed and its actions ----

/// The state word of card c from what the last feed read.
fn bn_state(tg: []const u64, tb: []const u8, c: u32) -> u64 {
    const sl : usize = @as(usize, tg[TPG_BN_LEN]);
    const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
    const dl : usize = @as(usize, tg[TPG_BN_LEN + 1 + c]);
    const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
    var dv : u64 = 1;
    if (c == 1) { dv = 2; }
    const ran : bool = (tg[TPG_BN_DET] / dv) % 2 == 1;
    return card_state(@as(u8, @intCast(c)), tb[TBO_SCAN .. TBO_SCAN + sl], tb[d0 .. d0 + dl], ran, tb[TBO_LS .. TBO_LS + ll]);
}

fn bn_start_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    e = put_bytes(tb, e, FEED_SCAN);
    tg[TPG_BN_LAST] = now;
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BN_PID] = pid;
        tg[TPG_BN_STAGE] = 1;
        tg[TPG_BN_START] = now;
    }
}

/// The scan and the serial nodes are in: read them, then run --detect for each card whose cable is seen once.
fn bn_after_scan(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const sn : usize = tg_read(hb, BENCH_DIR, FILE_SCAN, tb[TBO_SCAN .. TBO_DET0]);
    const ln : usize = tg_read(hb, BENCH_DIR, FILE_LS, tb[TBO_LS .. TBO_PATH]);
    tg[TPG_BN_LEN] = @as(u64, sn);
    tg[TPG_BN_LEN + 1] = 0;
    tg[TPG_BN_LEN + 2] = 0;
    tg[TPG_BN_LEN + 3] = @as(u64, ln);
    tg[TPG_BN_DET] = 0;
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    var any : bool = false;
    var c : u32 = 0;
    while (c < 2) {
        const cu : u8 = @as(u8, @intCast(c));
        const bus : u64 = card_busdev(cu, tb[TBO_SCAN .. TBO_SCAN + sn]);
        tg[TPG_BN_BUS + c] = bus;
        const st : u64 = card_state(cu, tb[TBO_SCAN .. TBO_SCAN + sn], "", false, tb[TBO_LS .. TBO_LS + ln]);
        const dl : u32 = feed_detect_len(cu, st, bus);
        if (dl > 0) {
            var k : u32 = 0;
            while (k < dl) {
                tb[e] = @as(u8, @intCast(feed_detect_char(cu, bus, k)));
                e = e + 1;
                k = k + 1;
            }
            var p : u32 = 0;
            while (p < FEED_DET_PIECES) {
                e = put_bytes(tb, e, feed_det_piece(cu, p));
                p = p + 1;
            }
            var bit : u64 = 1;
            if (c == 1) { bit = 2; }
            tg[TPG_BN_DET] = tg[TPG_BN_DET] + bit;
            any = true;
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    if (any) {
        e = put_bytes(tb, e, "true");
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_BN_PID] = pid;
            tg[TPG_BN_STAGE] = 2;
            tg[TPG_BN_START] = now;
            return;
        }
        tg[TPG_BN_DET] = 0;
    }
    tg_bump(tg);
}

fn bn_after_detect(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    var c : u32 = 0;
    while (c < 2) {
        var dv : u64 = 1;
        if (c == 1) { dv = 2; }
        if ((tg[TPG_BN_DET] / dv) % 2 == 1) {
            const d0 : usize = TBO_DET0 + @as(usize, c) * 2048;
            tg[TPG_BN_LEN + 1 + c] = @as(u64, tg_read(hb, BENCH_DIR, file_detect(@as(u8, @intCast(c))), tb[d0 .. d0 + 2048]));
        }
        c = c + 1;
    }
    tg[TPG_BN_STAGE] = 0;
    tg[TPG_BN_AT] = now;
    tg_bump(tg);
}

/// Every frame: reap the finished jobs, start the refresh when it is due and the page is open.
fn bench_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_BN_STAGE] != 0) {
        const d : u32 = tg_done(tg[TPG_BN_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_BN_START], tg[TPG_BN_PID]);
        } else {
            tg[TPG_BN_PID] = 0;
            if (tg[TPG_BN_STAGE] == 1) { bn_after_scan(tg, tb, hb, now); } else { bn_after_detect(tg, tb, hb, now); }
        }
    } else if (page_feed_due(PAGE_BENCH, open, now, tg[TPG_BN_LAST])) {
        bn_start_scan(tg, tb, hb, now);
    }
    if (tg[TPG_BA_PID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_BA_PID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_BA_START], tg[TPG_BA_PID]);
        } else {
            tg[TPG_BA_PID] = 0;
            tg[TPG_BA_RLEN] = @as(u64, tg_read(hb, BENCH_DIR, FILE_RUN, tb[TBO_RUN .. TBO_KAN]));
            tg_bump(tg);
        }
    }
}

/// Run FLASH (confirmed, SRAM load) or the UART view of card c as a background job writing run.txt.
fn bn_run(tg: []u64, tb: []u8, hb: []const u8, now: u64, card: u32, act: u8) -> void {
    if (tg[TPG_BA_PID] != 0) { return; }
    const cu : u8 = @as(u8, @intCast(card));
    const st : u64 = bn_state(tg, tb, card);
    const bus : u64 = tg[TPG_BN_BUS + card];
    var e : usize = tg_head(tb, hb, FEED_HEAD_A, FEED_HEAD_B);
    if (act == ACT_FLASH) {
        const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
        const fl : u32 = host_flash_len(cu, st, bus, tb[TBO_PATH .. TBO_PATH + pl], true);
        if (fl == 0) { return; }
        var k : u32 = 0;
        while (k < fl) {
            tb[e] = @as(u8, @intCast(host_flash_char(cu, bus, tb[TBO_PATH .. TBO_PATH + pl], k)));
            e = e + 1;
            k = k + 1;
        }
        e = put_bytes(tb, e, FEED_RUN_TAIL);
    } else if (act == ACT_UART) {
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const at : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        const pn : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], at);
        if (pn == 0 or pn > 120) { return; }
        var j : u32 = 0;
        while (j < pn) {
            tb[TBO_SCR + @as(usize, j)] = tb[TBO_LS + @as(usize, at) + @as(usize, j)];
            j = j + 1;
        }
        const port : []const u8 = tb[TBO_SCR .. TBO_SCR + @as(usize, pn)];
        if (uart_view_allowed(cu, st, port) == false) { return; }
        e = put_bytes(tb, e, UV_A);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_B);
        e = put_bytes(tb, e, port);
        e = put_bytes(tb, e, UV_C);
    } else {
        return;
    }
    const pid : u64 = tg_spawn(tb, TBO_CMD, e);
    if (pid != 0) {
        tg[TPG_BA_PID] = pid;
        tg[TPG_BA_START] = now;
        tg[TPG_BA_CARD] = @as(u64, card);
        tg[TPG_BA_KIND] = @as(u64, act);
        tg[TPG_BA_RLEN] = 0;
    }
    tg_bump(tg);
}

/// What a click on the B page asks the host to run: 0 nothing, 1 the UART view, 2 the confirmed FLASH. The state it
/// changes (the dialogue, the refresh timer) is changed here; no job is started here.
fn bench_click_do(tg: []u64, tb: []const u8, hit: u32) -> u32 {
    if (hit == BH_NONE) { return 0; }
    const card : u32 = hit / 8;
    const kind : u32 = hit % 8;
    const st : u64 = bn_state(tg, tb, card);
    var run : u32 = 0;
    if (kind == BH_DETECT) {
        // DETECT runs the same refresh now (the next frame starts it when no stage is running)
        if (act_enabled(st, ACT_DETECT) and tg[TPG_BN_STAGE] == 0) { tg[TPG_BN_LAST] = 0; }
    } else if (kind == BH_FLASH) {
        if (act_enabled(st, ACT_FLASH)) {
            tg[TPG_BA_FS] = @as(u64, fs_next(FS_NONE, FE_FLASH_CLICK, false));
            tg[TPG_BA_CARD] = @as(u64, card);
            tg[TPG_BA_PLEN] = 0;
        }
    } else if (kind == BH_UART) {
        if (act_enabled(st, ACT_UART)) { run = 1; }
    } else if (kind == BH_CONFIRM) {
        if (tg[TPG_BA_FS] == FS_CONFIRM) {
            const ns : u32 = fs_next(FS_CONFIRM, FE_CONFIRM, true);
            tg[TPG_BA_FS] = 0;
            if (ns == FS_RUN) { run = 2; }
        }
    } else if (kind == BH_CANCEL) {
        tg[TPG_BA_FS] = @as(u64, fs_next(@as(u32, @intCast(tg[TPG_BA_FS])), FE_CANCEL, false));
    }
    tg_bump(tg);
    return run;
}

/// A click on the B page: hit = card * 8 + BH_*.
fn bench_click(tg: []u64, tb: []u8, hb: []const u8, now: u64, hit: u32) -> void {
    const run : u32 = bench_click_do(tg, tb, hit);
    if (run == 1) { bn_run(tg, tb, hb, now, hit / 8, ACT_UART); }
    if (run == 2) { bn_run(tg, tb, hb, now, hit / 8, ACT_FLASH); }
}

/// A key while the FLASH dialogue is open: ev is FE_RETURN, FE_ESCAPE, TG_EV_BACK or TG_EV_CHAR (ch = the character).
fn bench_key(tg: []u64, tb: []u8, ev: u32, ch: u32) -> void {
    const fs : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const pl : usize = @as(usize, tg[TPG_BA_PLEN]);
    if (fs == FS_TYPING and ev == TG_EV_CHAR) {
        if (flash_char_ok(ch, @as(u32, @intCast(pl)))) {
            tb[TBO_PATH + pl] = @as(u8, @intCast(ch));
            tg[TPG_BA_PLEN] = @as(u64, pl + 1);
        }
    } else if (fs == FS_TYPING and ev == TG_EV_BACK) {
        if (pl > 0) { tg[TPG_BA_PLEN] = @as(u64, pl - 1); }
    } else if (ev == FE_RETURN or ev == FE_ESCAPE) {
        const ok : bool = flash_path_ok(tb[TBO_PATH .. TBO_PATH + pl]);
        tg[TPG_BA_FS] = @as(u64, fs_next(fs, ev, ok));
    }
    tg_bump(tg);
}

// ---- drawing helpers of the pages ----

fn tg_txt(c: u64, kit: [48]u64, s: []const u8, x: f64, y: f64, size: f64, weight: f64, alpha: f64, right: f64) -> f64 {
    if (s.len == 0) { return 0.0; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, alpha);
    return draw_fit(c, kit, s, s.len, x, y, size, weight, true, right);
}

/// "0x" and eight hex digits of v into out at at.
fn put_hex8(out: []u8, at: usize, v: u64) -> usize {
    var n : usize = put_bytes(out, at, "0x");
    var sh : u64 = 8;
    while (sh > 0) {
        sh = sh - 1;
        var d : u64 = v;
        var q : u64 = 0;
        while (q < sh) {
            d = d / 16;
            q = q + 1;
        }
        d = d % 16;
        if (d < 10) { out[n] = @as(u8, @intCast(48 + d)); } else { out[n] = @as(u8, @intCast(87 + d)); }
        n = n + 1;
    }
    return n;
}

/// A lamp of a bench card: grey ring, red, amber, green or blue-white disc, in the traffic-light palette.
fn draw_lamp(c: u64, x: f64, y: f64, lamp: u8, a: f64) -> void {
    if (lamp == LAMP_GREY) {
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_line_width(c, 1.0);
        cg_arc(c, x, y, 4.0, 0.0, 6.283185307, 0);
        cg_stroke_path(c);
        return;
    }
    if (lamp == LAMP_RED) { draw_light_dot(c, x, y, LIGHT_RED, a); }
    if (lamp == LAMP_AMBER) { draw_light_dot(c, x, y, LIGHT_YELLOW, a); }
    if (lamp == LAMP_GREEN) { draw_light_dot(c, x, y, LIGHT_GREEN, a); }
    if (lamp == LAMP_BLUE) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
        cg_fill_path(c);
    }
}

fn tg_button(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, h: f64, label: []const u8, hot: bool, on: bool, a: f64) -> void {
    round_rect(c, x, y, w, h, 5.0);
    cg_line_width(c, 1.0);
    var k : f64 = 0.35;
    if (hot and on) { k = 0.9; }
    if (on == false) { k = 0.16; }
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, k * a);
    cg_stroke_path(c);
    var ta : f64 = 1.0;
    if (on == false) { ta = 0.35; }
    const tw : f64 = bytes_w(kit, label, label.len, 9.5, WEIGHT_BOLD, true);
    tg_txt(c, kit, label, x + 0.5 * w - 0.5 * tw, y + 0.5 * h + 3.5, 9.5, WEIGHT_BOLD, ta * a, 0.0);
}

fn tg_in(x: f64, y: f64, l: f64, t: f64, w: f64, h: f64) -> bool {
    return x >= l and x < l + w and y >= t and y < t + h;
}

// ---- B: the page ----

fn draw_bench_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const cw : f64 = bp_card_w(pw);
    const ask : u32 = @as(u32, @intCast(tg[TPG_BA_FS]));
    const ask_card : u32 = @as(u32, @intCast(tg[TPG_BA_CARD]));
    const hit : u32 = bp_hit(mx - x0, my - y0, pw, BH_NONE);
    var line : [160]u8 = undefined;
    var ci : u32 = 0;
    while (ci < 2) {
        const cu : u8 = @as(u8, @intCast(ci));
        const cx : f64 = x0 + BP_PAD;
        const cy : f64 = y0 + bp_card_y(cu);
        const st : u64 = bn_state(tg, tb, ci);
        const ds : u8 = die_status(st);
        plate(c, cx, cy, cw, BP_CARD_H, sw, a);
        // title row: lamp, board, model (a GUESS says so), status word
        draw_lamp(c, cx + 16.0, cy + 17.0, lamp_of(ds), a);
        const tw : f64 = tg_txt(c, kit, card_title(cu), cx + 30.0, cy + 21.0, 13.0, WEIGHT_HEAVY, a, 0.0);
        var mal : f64 = 0.55;
        if (card_model_known(cu) == false) { mal = 0.38; }
        // the PL part is ESTABLISHED by the tool's own manufacturer/family/model lines (MEASURED); the board model stays a guess
        const mdn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const md0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        const mpl : u32 = @as(u32, card_chain_len(cu)) - 1;
        const mfa : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "manufacturer");
        const mfb : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "family");
        const mfc : u32 = tp_field_at(tb[md0 .. md0 + mdn], mpl, "model");
        if (mfc != 4294967295 and mfb != 4294967295 and mfa != 4294967295) {
            var mn : usize = put_bytes(line[0..160], 0, "PL ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfa) .. md0 + @as(usize, mfa) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfa))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfb) .. md0 + @as(usize, mfb) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfb))]);
            mn = put_bytes(line[0..160], mn, " ");
            mn = put_bytes(line[0..160], mn, tb[md0 + @as(usize, mfc) .. md0 + @as(usize, mfc) + @as(usize, tp_field_len(tb[md0 .. md0 + mdn], mfc))]);
            mn = put_bytes(line[0..160], mn, " (measured); board model: ");
            mn = put_bytes(line[0..160], mn, card_model_text(cu));
            tg_txt(c, kit, line[0..mn], cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, 0.7 * a, cx + cw - 150.0);
        } else {
            tg_txt(c, kit, card_model_text(cu), cx + 30.0 + tw + 12.0, cy + 20.0, 9.0, 0.0, mal * a, cx + cw - 150.0);
        }
        const sw2 : f64 = bytes_w(kit, die_status_text(ds), die_status_text(ds).len, 9.5, WEIGHT_SEMIBOLD, true);
        tg_txt(c, kit, die_status_text(ds), cx + cw - 14.0 - sw2, cy + 20.0, 9.5, WEIGHT_SEMIBOLD, a, 0.0);
        // the chain from TDI: one box per TAP with its IDCODE (live, else the one measured on 2026-10-20, else not measured)
        const n : u32 = card_chain_len(cu);
        const dn : usize = @as(usize, tg[TPG_BN_LEN + 1 + ci]);
        const d0 : usize = TBO_DET0 + @as(usize, ci) * 2048;
        var k : u32 = 0;
        while (k < n) {
            const bx : f64 = cx + 14.0 + @as(f64, @floatFromInt(k)) * 118.0;
            const by : f64 = cy + 36.0;
            if (k > 0) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
                cg_fill_rect(c, bx - 22.0, by + 20.0, 22.0, 1.0);
            }
            round_rect(c, bx, by, 96.0, 42.0, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_stroke_path(c);
            tg_txt(c, kit, box_label(cu, k), bx + 8.0, by + 15.0, 10.0, WEIGHT_BOLD, a, bx + 92.0);
            const live : u64 = card_idcode_live(tb[d0 .. d0 + dn], k);
            const last : u64 = card_idcode_measured(cu, k);
            var ln : usize = 0;
            var ia : f64 = 0.9;
            if (idcode_known(live)) {
                ln = put_hex8(line[0..160], 0, live);
            } else if (idcode_known(last)) {
                ln = put_hex8(line[0..160], 0, last);
                ia = 0.45;
            } else {
                ln = put_bytes(line[0..160], 0, "not measured");
                ia = 0.45;
            }
            tg_txt(c, kit, line[0..ln], bx + 8.0, by + 32.0, 9.0, 0.0, ia * a, bx + 92.0);
            k = k + 1;
        }
        // the facts: cable, serial, busdev, uart; each says where it came from
        const fx : f64 = cx + 14.0 + @as(f64, @floatFromInt(n)) * 118.0 + 10.0;
        const fy : f64 = cy + 42.0;
        tg_txt(c, kit, "cable", fx, fy, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_cable_text(cu), fx + 50.0, fy, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "serial", fx, fy + 13.0, 9.0, 0.0, 0.5 * a, 0.0);
        tg_txt(c, kit, card_serial(cu), fx + 50.0, fy + 13.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        tg_txt(c, kit, "busdev", fx, fy + 26.0, 9.0, 0.0, 0.5 * a, 0.0);
        const bus : u64 = tg[TPG_BN_BUS + ci];
        if (bus_known(bus) and st_has(st, ST_CABLE)) {
            var bn : usize = put_dec(line[0..160], 0, bus / 1000);
            bn = put_bytes(line[0..160], bn, ":");
            bn = put_dec(line[0..160], bn, bus % 1000);
            tg_txt(c, kit, line[0..bn], fx + 50.0, fy + 26.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 26.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        tg_txt(c, kit, "uart", fx, fy + 39.0, 9.0, 0.0, 0.5 * a, 0.0);
        const ll : usize = @as(usize, tg[TPG_BN_LEN + 3]);
        const pc : u32 = port_count(tb[TBO_LS .. TBO_LS + ll], cu);
        const p0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, 0);
        if (pc > 0 and p0 != 4294967295) {
            var pn : usize = put_dec(line[0..160], 0, @as(u64, pc));
            if (pc == 1) { pn = put_bytes(line[0..160], pn, " port  "); } else { pn = put_bytes(line[0..160], pn, " ports  "); }
            var pj : u32 = 0;
            while (pj < pc and pj < 3) {
                const pj0 : u32 = port_at(tb[TBO_LS .. TBO_LS + ll], cu, pj);
                const pjl : u32 = port_len(tb[TBO_LS .. TBO_LS + ll], pj0);
                const pja : usize = TBO_LS + @as(usize, pj0);
                if (pj > 0) { pn = put_bytes(line[0..160], pn, "  "); }
                pn = put_bytes(line[0..160], pn, tb[pja .. pja + @as(usize, pjl)]);
                pj = pj + 1;
            }
            tg_txt(c, kit, line[0..pn], fx + 50.0, fy + 39.0, 9.0, 0.0, 0.9 * a, cx + cw - 10.0);
        } else {
            tg_txt(c, kit, "not measured", fx + 50.0, fy + 39.0, 9.0, 0.0, 0.4 * a, cx + cw - 10.0);
        }
        // provenance of the numbers above: the command and how long ago it ran
        var pv : usize = 0;
        if (tg[TPG_BN_AT] > 0) {
            pv = put_bytes(line[0..160], 0, "measured ");
            const dran : bool = (tg[TPG_BN_DET] / (1 + ci)) % 2 == 1;
            if (dran and bus_known(bus)) {
                // the command this cable actually ran: -c digilent for the Adept FTDI2232, -c digilent_hs2 for the FT232H
                const rl2 : u32 = cmd_raw_len(cu, ACT_DETECT, bus, "") - 1;
                var rk : u32 = 0;
                while (rk < rl2 and pv < 120) {
                    line[pv] = @as(u8, @intCast(cmd_char(cu, ACT_DETECT, bus, "", rk)));
                    pv = pv + 1;
                    rk = rk + 1;
                }
            } else {
                pv = put_bytes(line[0..160], pv, src_command(SRC_SCAN_USB));
            }
            pv = put_bytes(line[0..160], pv, "  ");
            pv = put_dec(line[0..160], pv, now - tg[TPG_BN_AT]);
            pv = put_bytes(line[0..160], pv, " s ago");
        } else {
            pv = put_bytes(line[0..160], 0, "not measured yet: openFPGALoader --scan-usb");
        }
        tg_txt(c, kit, line[0..pv], cx + 14.0, cy + BP_CARD_H - 44.0, 8.0, 0.0, 0.42 * a, cx + cw - 10.0);
        // buttons, or the FLASH dialogue in their place
        const by2 : f64 = cy + bp_btn_y();
        if (ask != FS_NONE and ask_card == ci) {
            round_rect(c, cx + 2.0 * BP_PAD, by2, bp_field_w(cw), BP_BTN_H, 5.0);
            cg_line_width(c, 1.0);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.6 * a);
            cg_stroke_path(c);
            const pl2 : usize = @as(usize, tg[TPG_BA_PLEN]);
            var fn2 : usize = 0;
            if (ask == FS_TYPING) {
                fn2 = put_bytes(line[0..160], 0, "FLASH .bit path: ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, "_");
            } else {
                fn2 = put_bytes(line[0..160], 0, "load ");
                fn2 = put_bytes(line[0..160], fn2, tb[TBO_PATH .. TBO_PATH + pl2]);
                fn2 = put_bytes(line[0..160], fn2, " into SRAM?");
            }
            tg_txt(c, kit, line[0..fn2], cx + 2.0 * BP_PAD + 8.0, by2 + 16.0, 9.5, 0.0, a, cx + 2.0 * BP_PAD + bp_field_w(cw) - 6.0);
            tg_button(c, kit, cx + bp_confirm_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CONFIRM", mx >= cx + bp_confirm_x(cw) + BP_PAD and mx < cx + bp_confirm_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, ask == FS_CONFIRM, a);
            tg_button(c, kit, cx + bp_cancel_x(cw) + BP_PAD, by2, BP_BTN_W, BP_BTN_H, "CANCEL", mx >= cx + bp_cancel_x(cw) + BP_PAD and mx < cx + bp_cancel_x(cw) + BP_PAD + BP_BTN_W and my >= by2 and my < by2 + BP_BTN_H, true, a);
        } else {
            var bi : u32 = 0;
            while (bi < 3) {
                tg_button(c, kit, cx + BP_PAD + @as(f64, @floatFromInt(bi)) * (BP_BTN_W + BP_BTN_GAP) + 0.0, by2, BP_BTN_W, BP_BTN_H, act_label(@as(u8, @intCast(bi))), hit == ci * 8 + bi, act_enabled(st, @as(u8, @intCast(bi))), a);
                bi = bi + 1;
            }
        }
        ci = ci + 1;
    }
    // the run log of FLASH and UART: the last lines of ~/.t27os/bench/run.txt, control bytes shown as spaces
    const ly : f64 = y0 + bp_log_y();
    const lh : f64 = bp_log_h(ph);
    plate(c, x0 + BP_PAD, ly, cw, lh, sw, a);
    var hn : usize = put_bytes(line[0..160], 0, "RUN LOG  ");
    if (tg[TPG_BA_PID] != 0) {
        hn = put_bytes(line[0..160], hn, "running ");
        hn = put_bytes(line[0..160], hn, act_label(@as(u8, @intCast(tg[TPG_BA_KIND]))));
    } else if (tg[TPG_BA_RLEN] > 0) {
        hn = put_bytes(line[0..160], hn, "last output of the host job");
    } else {
        hn = put_bytes(line[0..160], hn, "nothing run yet; FLASH asks for a .bit path and a confirm");
    }
    tg_txt(c, kit, line[0..hn], x0 + BP_PAD + 12.0, ly + 15.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, x0 + BP_PAD + cw - 10.0);
    const rl : usize = @as(usize, tg[TPG_BA_RLEN]);
    var rows : u32 = 0;
    if (lh > 40.0) { rows = @as(u32, @intFromFloat((lh - 28.0) / 12.0)); }
    // walk back from the end over `rows` lines
    var from : usize = rl;
    var seen : u32 = 0;
    while (from > 0 and seen < rows) {
        from = from - 1;
        if (tb[TBO_RUN + from] == 10 or tb[TBO_RUN + from] == 13) {
            if (from + 1 < rl) { seen = seen + 1; }
        }
    }
    var ry : f64 = ly + 30.0;
    var s0 : usize = from;
    while (s0 < rl and ry < ly + lh - 4.0) {
        var e0 : usize = s0;
        var ob : [120]u8 = undefined;
        var on : usize = 0;
        while (e0 < rl and tb[TBO_RUN + e0] != 10 and tb[TBO_RUN + e0] != 13) {
            const ch : u8 = tb[TBO_RUN + e0];
            if (on < 120) {
                if (ch >= 32 and ch < 127) { ob[on] = ch; } else { ob[on] = 32; }
                on = on + 1;
            }
            e0 = e0 + 1;
        }
        if (on > 0) {
            tg_txt(c, kit, ob[0..on], x0 + BP_PAD + 12.0, ry, 8.5, 0.0, 0.82 * a, x0 + BP_PAD + cw - 10.0);
            ry = ry + 12.0;
        }
        s0 = e0 + 1;
    }
}

// ---- K: the KANBAN host feed, the board and the drops ----

/// Read both feed files into the board's log: issues first, then pull requests, whole lines only.
fn kn_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const half : usize = @as(usize, FEED_CAP / 2);
    var n1 : usize = tg_read(hb, KANBAN_DIR, FILE_ISSUES, tb[TBO_KAN .. TBO_KAN + half]);
    n1 = tg_whole_lines(tb, TBO_KAN, n1);
    var n2 : usize = tg_read(hb, KANBAN_DIR, FILE_PRS, tb[TBO_KAN + n1 .. TBO_KAN + @as(usize, FEED_CAP)]);
    n2 = tg_whole_lines(tb, TBO_KAN + n1, n2);
    tg[TPG_K_LEN] = @as(u64, n1 + n2);
}

// ---- L: LANES and ACTORS in the chat sidebar (lanes_view.t27) ----

pub const TBO_LF : usize = 49152;
pub const TBO_LF_N : usize = 6000;
pub const TBO_LT : usize = 55152;
pub const TBO_LT_N : usize = 4800;
pub const TBO_LTXT : usize = 59952;
pub const TB_LANES_END : usize = 65536;
pub const TPG_L_LAST : u32 = 76;
pub const TPG_L_PID : u32 = 77;
pub const TPG_L_START : u32 = 78;
pub const TPG_L_LEN : u32 = 79;
pub const TPG_L_TPID : u32 = 80;
pub const TPG_L_TLEN : u32 = 81;
pub const TPG_L_TLAST : u32 = 82;
pub const TPG_L_TISSUE : u32 = 83;
/// sst[0..32] are the sessions' states; sst[SST_LV ..] is the lanes table the sidebar draws.
pub const SST_LVN : usize = 32;
pub const SST_LVOFF : usize = 33;
pub const SST_LVSEL : usize = 34;
pub const SST_LVTAIL : usize = 35;
pub const SST_LVKEY : usize = 36;
/// the log view's scroll (lines up from the bottom) and whether the kernel group is expanded
pub const SST_LVLSCR : usize = 38;
pub const SST_LVKX : usize = 39;
/// the pane server's phase (term_pane SRV_*), kept for the banner
pub const SST_SRV : usize = 556;
pub const SST_LV : usize = 40;
pub const SST_SIZE : usize = 560;
pub const LV_TAIL_LINES : u32 = 40;

/// Where the LANES block starts: right under the last AGENTS row (or its empty line).
pub fn lane_block_top(n: u32, rows: u32) -> f64 {
    var r : u32 = rows;
    if (r == 0) { r = 1; }
    return row_top(WS_TOP, GROUP_AGENTS, n, r - 1) + AGENT_ROW_H + 8.0;
}

/// Rows of the block that fit above the sidebar foot.
pub fn lane_block_vis(top: f64, sh: f64) -> u32 { return lv_visible(sh - FOOT_H - top); }

/// Is the point in the LANES block of the expanded sidebar?
pub fn on_lane_block(x: f64, y: f64, top: f64, sh: f64) -> bool {
    return x >= 12.0 and x < SIDE_W - 12.0 and y >= top and y < sh - FOOT_H;
}

/// One run of the feed job and its reap; the tail job likewise, again every two seconds while a tail is open.
fn lanes_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, up: bool, tail_issue: u32) -> void {
    if (tg[TPG_L_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_L_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_L_START], tg[TPG_L_PID]);
        } else {
            tg[TPG_L_PID] = 0;
            const n : usize = tg_read(hb, LV_DIR, LV_FILE, tb[TBO_LF .. TBO_LF + TBO_LF_N]);
            tg[TPG_L_LEN] = @as(u64, tg_whole_lines(tb, TBO_LF, n));
            tg_bump(tg);
        }
    } else if (lv_refresh_due(up, now, tg[TPG_L_LAST])) {
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = put_bytes(tb, e, LV_FEED_CMD);
        tg[TPG_L_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_L_PID] = pid;
            tg[TPG_L_START] = now;
        }
    }
    if (tg[TPG_L_TPID] != 0) {
        const d2 : u32 = tg_done(tg[TPG_L_TPID]);
        if (d2 == 0) {
            tg_late(now, tg[TPG_L_TLAST], tg[TPG_L_TPID]);
        } else {
            tg[TPG_L_TPID] = 0;
            tg[TPG_L_TLEN] = @as(u64, tg_read(hb, LV_DIR, LV_TAIL_FILE, tb[TBO_LT .. TBO_LT + TBO_LT_N]));
            tg_bump(tg);
        }
    } else if (tail_issue != 0 and (tg[TPG_L_TLAST] == 0 or now >= tg[TPG_L_TLAST] + 2 or tg[TPG_L_TISSUE] != @as(u64, tail_issue))) {
        var e2 : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e2 = e2 + lv_tail_cmd(tail_issue, tb[e2 .. TBO_ROOT]);
        tg[TPG_L_TLAST] = now;
        tg[TPG_L_TISSUE] = @as(u64, tail_issue);
        const pid2 : u64 = tg_spawn(tb, TBO_CMD, e2);
        if (pid2 != 0) { tg[TPG_L_TPID] = pid2; }
    }
}

/// Rebuild the table the sidebar draws: this space's panes, the script lanes and own-git lines of the feed, the
/// Queen, the kernel tree. Called when the generation moved or a session changed; the table lives in sst.
fn lanes_build(sst: []u32, tb: []u8, tg: []const u64, ss: u64, space: u32, god: bool, now: u32) -> void {
    var n : u32 = 0;
    const rows : u32 = sessions_in(ss, space);
    var r : u32 = 0;
    var nm : [32]u8 = undefined;
    while (r < rows and r < 16) {
        const si : u32 = session_at_row(ss, space, r);
        const k : u32 = session_agent(ss, si);
        const ln : usize = csv_field(AGENT_NAMES, k, nm[0..32]);
        n = lv_pane_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, nm[0..ln], 0, 0, row_state(sst, si), false, 1, LV_NOT_MEASURED);
        r = r + 1;
    }
    n = lv_parse(tb[TBO_LF .. TBO_LF + @as(usize, tg[TPG_L_LEN])], now, sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    // the Queen's numbers come from the rows above (her lanes), counted before the own-git lines fold
    const tabv : []const u32 = sst[SST_LV .. SST_SIZE];
    const q_run : u32 = lv_work_count(tabv, n, LVS_RUNNING);
    const q_idle : u32 = lv_work_count(tabv, n, LVS_IDLE);
    const q_blk : u32 = lv_work_count(tabv, n, LVS_BLOCKED);
    const q_rev : u32 = lv_count(tabv, n, LVS_READY);
    // the footer bar's lanes and Queen items read these (statusbar.t27); the feed exists once the table has rows
    sst[SST_QRUN] = q_run;
    sst[SST_QIDLE] = q_idle;
    sst[SST_QBLK] = q_blk;
    sst[SST_QREV] = q_rev;
    sst[SST_QFEED] = 1;
    n = lv_queen_counts_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, q_run, q_idle, q_blk, q_rev, god);
    if (q_run == 0 and q_blk == 0) { n = lv_note_row(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n); }
    var ls : [16]u32 = undefined;
    var lj : u32 = 0;
    var lanes : u32 = 0;
    while (lj < n and lanes < 16) {
        if (sst[SST_LV + @as(usize, lj) * LV_F + LVF_SRC] == LV_SCRIPT) {
            ls[lanes] = sst[SST_LV + @as(usize, lj) * LV_F + LVF_STATE];
            lanes = lanes + 1;
        }
        lj = lj + 1;
    }
    n = lv_fold_trigit(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_kernel_rows(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, lanes, ls[0..16]);
    lv_sort(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n);
    n = lv_fold_kernel(sst[SST_LV .. SST_SIZE], tb[TBO_LTXT .. TB_LANES_END], n, sst[SST_LVKX] != 0);
    sst[SST_LVN] = n;
    sst[SST_LVOFF] = lv_scroll_clamp(sst[SST_LVOFF], n, 8);
    if (sst[SST_LVSEL] != LV_NONE) {
        var found : u32 = LV_NONE;
        var fj : u32 = 0;
        while (fj < n and found == LV_NONE) {
            if (sst[SST_LV + @as(usize, fj) * LV_F + LVF_SRC] == sst[SST_LVKEY] and sst[SST_LV + @as(usize, fj) * LV_F + LVF_ISSUE] == sst[SST_LVKEY + 1]) { found = fj; }
            fj = fj + 1;
        }
        sst[SST_LVSEL] = found;
    }
}

fn kanban_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_K_LOADED] == 0) {
        kn_load(tg, tb, hb);
        tg[TPG_K_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_K_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_K_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_K_START], tg[TPG_K_PID]);
        } else {
            tg[TPG_K_PID] = 0;
            kn_load(tg, tb, hb);
            tg[TPG_K_AT] = now;
            tg[TPG_K_PNUM] = 0;
            tg[TPG_K_ACT] = 0;
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_KANBAN, open, now, tg[TPG_K_LAST])) {
        var e : usize = tg_head(tb, hb, K_HEAD_A, K_HEAD_B);
        e = put_bytes(tb, e, GH_ISSUES_A);
        e = put_bytes(tb, e, JQ_ISSUES);
        e = put_bytes(tb, e, GH_ISSUES_B);
        e = put_bytes(tb, e, GH_PRS_A);
        e = put_bytes(tb, e, JQ_PRS);
        e = put_bytes(tb, e, GH_PRS_B);
        tg[TPG_K_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_K_PID] = pid;
            tg[TPG_K_START] = now;
        }
    }
}

/// The board is drawn below a 22 pt head strip.
pub const KN_HEAD : f64 = 22.0;

/// Column under x and the card line under (x, y) of the board at (x0, y0) pw x ph; KB_NONE for none.
fn kn_col_under(x: f64, pw: f64, x0: f64) -> u32 { return kb_col_at(pw, x - x0); }

fn kn_card_under(tg: []const u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> u32 {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const col : u32 = kb_col_at(pw, x - x0);
    if (col >= KB_COLS) { return KB_NONE; }
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const cnt : u32 = kb_count(log, col, pnum, pto);
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    var shown : u32 = 0;
    if (cnt > sc) { shown = cnt - sc; }
    if (shown > rows) { shown = rows; }
    const i : u32 = kb_card_at(shown, pw, col, x - x0, y - (y0 + KN_HEAD));
    if (i >= shown) { return KB_NONE; }
    return kb_nth(log, col, sc + i, pnum, pto);
}

/// Mouse down on the board: pick up the card under the pointer.
fn kanban_down(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    const ls : u32 = kn_card_under(tg, tb, x, y, x0, y0, pw, ph);
    if (ls == KB_NONE) { return; }
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    tg[TPG_K_DRAG] = @as(u64, ls) + 1;
    tg[TPG_K_FROM] = @as(u64, kn_col_under(x, pw, x0));
    tg_bump(tg);
}

/// Mouse up: the drop. Only the rules of kanban.t27 decide; an accepted move is a proposal kept on the board
/// until the next refresh (no GitHub write, no agent started), a refused one only says so.
fn kanban_up(tg: []u64, tb: []const u8, x: f64, y: f64, x0: f64, y0: f64, pw: f64) -> void {
    if (tg[TPG_K_DRAG] == 0) { return; }
    const ls : u32 = @as(u32, @intCast(tg[TPG_K_DRAG] - 1));
    tg[TPG_K_DRAG] = 0;
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const to : u32 = kn_col_under(x, pw, x0);
    tg_bump(tg);
    if (to >= KB_COLS or y < y0 + KN_HEAD) { return; }
    const from : u32 = @as(u32, @intCast(tg[TPG_K_FROM]));
    const doing : u32 = kb_count(log, kb_doing(), 0, 0);
    const act : u32 = kb_drop(from, to, doing);
    if (to == kb_col_of(log, ls)) {
        // back where the rule puts it: the proposal is gone
        tg[TPG_K_PNUM] = 0;
        tg[TPG_K_ACT] = 0;
        return;
    }
    tg[TPG_K_ACT] = @as(u64, act);
    if (kb_proposes(act)) {
        tg[TPG_K_PNUM] = @as(u64, kb_num(log, ls));
        tg[TPG_K_PTO] = @as(u64, to);
    }
}

fn kanban_scroll(tg: []u64, tb: []const u8, ph: f64, dir: i64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const rows : u32 = kb_rows_fit(ph - KN_HEAD);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    var most : u32 = 0;
    var c : u32 = 0;
    while (c < KB_COLS) {
        const n : u32 = kb_count(log, c, pnum, pto);
        if (n > most) { most = n; }
        c = c + 1;
    }
    var maxs : u32 = 0;
    if (most > rows) { maxs = most - rows; }
    var s : i64 = @as(i64, @intCast(tg[TPG_K_SCROLL])) + dir;
    if (s < 0) { s = 0; }
    if (s > @as(i64, maxs)) { s = @as(i64, maxs); }
    tg[TPG_K_SCROLL] = @as(u64, @intCast(s));
    tg_bump(tg);
}

/// One card: id and badge, the title, the pinned agents (owner first, bold), a GUESS mark when no path named a letter.
fn draw_kn_card(c: u64, kit: [48]u64, tb: []const u8, len: usize, ls: u32, x: f64, y: f64, w: f64, hot: bool, proposed: bool, ghost: bool, sw: f64, full: bool, a0: f64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + len];
    var a : f64 = a0;
    if (ghost) { a = a0 * 0.55; }
    plate(c, x, y, w, kb_card_h(), sw, a);
    if (hot) {
        round_rect(c, x, y, w, kb_card_h(), TILE_CORNER);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.85 * a);
        cg_stroke_path(c);
    }
    if (proposed) { dashed_frame(c, x + 1.0, y + 1.0, w - 2.0, kb_card_h() - 2.0, a); }
    var hb : [48]u8 = undefined;
    var n : usize = 0;
    if (kb_is_pr(log, ls)) { n = put_bytes(hb[0..48], 0, "PR #"); } else { n = put_bytes(hb[0..48], 0, "#"); }
    n = put_dec(hb[0..48], n, @as(u64, kb_num(log, ls)));
    const iw : f64 = tg_txt(c, kit, hb[0..n], x + 7.0, y + 14.0, 9.0, WEIGHT_BOLD, a, 0.0);
    // the badge: a PR shows its checks, an issue its first label
    const cb : u32 = kb_checks_byte(log, ls);
    if (cb == 114) { tg_txt(c, kit, "checks running", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 112) { tg_txt(c, kit, "checks pass", x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.7 * a, x + w - 6.0); }
    if (cb == 102) { tg_txt(c, kit, "checks FAIL", x + 7.0 + iw + 8.0, y + 14.0, 8.0, WEIGHT_BOLD, 0.95 * a, x + w - 6.0); }
    const bn : u32 = kb_badge_n(log, ls);
    if (cb == 0 and bn > 0) {
        const bs : usize = @as(usize, kb_badge_at(log, ls));
        tg_txt(c, kit, tb[TBO_KAN + bs .. TBO_KAN + bs + @as(usize, bn)], x + 7.0 + iw + 8.0, y + 14.0, 8.0, 0.0, 0.55 * a, x + w - 6.0);
    }
    const tn : usize = @as(usize, kb_title_n(log, ls));
    const ts : usize = @as(usize, kb_title_at(log, ls));
    tg_txt(c, kit, tb[TBO_KAN + ts .. TBO_KAN + ts + tn], x + 7.0, y + 30.0, 9.5, WEIGHT_SEMIBOLD, a, x + w - 6.0);
    // the agents: owner first, bold; on hover the full line
    const na : u32 = kb_agents(log, ls);
    var k : u32 = 0;
    while (k < na) {
        const l : u32 = kb_agent(log, ls, k);
        const chx : f64 = x + 7.0 + @as(f64, @floatFromInt(k)) * (kb_chip_w() + 2.0);
        const chy : f64 = y + kb_card_h() - kb_chip_h() - 5.0;
        round_rect(c, chx, chy, kb_chip_w(), kb_chip_h(), 3.0);
        cg_line_width(c, 1.0);
        var ka : f64 = 0.3;
        if (k == 0) { ka = 0.7; }
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
        cg_stroke_path(c);
        var wgt : f64 = 0.0;
        if (k == 0) { wgt = WEIGHT_BOLD; }
        if (l >= 1 and l <= 27) { tg_txt(c, kit, AGENT_LETTERS[l - 1], chx + 4.0, chy + 11.5, 8.5, wgt, a, 0.0); }
        k = k + 1;
    }
    if (card_guess(log, ls)) {
        tg_txt(c, kit, "GUESS", x + w - 40.0, y + kb_card_h() - 10.0, 7.5, 0.0, 0.45 * a, 0.0);
    }
    if (proposed) {
        tg_txt(c, kit, "PROPOSED", x + w - 56.0, y + 14.0, 7.5, WEIGHT_BOLD, 0.9 * a, 0.0);
    }
    if (hot) {
        var al : [64]u8 = undefined;
        var an : usize = put_bytes(al[0..64], 0, "AGENTS:");
        var q : u32 = 0;
        while (q < na) {
            an = put_bytes(al[0..64], an, " ");
            an = put_bytes(al[0..64], an, AGENT_LETTERS[kb_agent(log, ls, q) - 1]);
            q = q + 1;
        }
        if (card_guess(log, ls)) { an = put_bytes(al[0..64], an, " (guess: no path names a letter)"); }
        tg_txt(c, kit, al[0..an], x + 7.0, y + kb_card_h() - 22.0 + 0.0, 7.5, WEIGHT_SEMIBOLD, 0.8 * a, x + w - 6.0);
    }
}

fn draw_kanban_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const log : []const u8 = tb[TBO_KAN .. TBO_KAN + @as(usize, tg[TPG_K_LEN])];
    const bx : f64 = x0;
    const by : f64 = y0 + KN_HEAD;
    const bh : f64 = ph - KN_HEAD;
    const rows : u32 = kb_rows_fit(bh);
    const pnum : u32 = @as(u32, @intCast(tg[TPG_K_PNUM]));
    const pto : u32 = @as(u32, @intCast(tg[TPG_K_PTO]));
    const sc : u32 = @as(u32, @intCast(tg[TPG_K_SCROLL]));
    const drag : u32 = @as(u32, @intCast(tg[TPG_K_DRAG]));
    var line : [200]u8 = undefined;
    // head strip: BOARD, the data's age, the message of the last drop
    var hn : usize = put_bytes(line[0..200], 0, "BOARD  gHashTag/t27  ");
    if (tg[TPG_K_LEN] == 0) {
        hn = put_bytes(line[0..200], hn, "not measured: gh issue list / gh pr list gave nothing yet");
    } else if (tg[TPG_K_AT] > 0) {
        hn = put_bytes(line[0..200], hn, "gh refreshed ");
        hn = put_dec(line[0..200], hn, now - tg[TPG_K_AT]);
        hn = put_bytes(line[0..200], hn, " s ago, every 60 s while open");
    } else {
        hn = put_bytes(line[0..200], hn, "last saved copy, refreshing");
    }
    tg_txt(c, kit, line[0..hn], bx + kb_pad(), y0 + 14.0, 9.0, WEIGHT_SEMIBOLD, 0.7 * a, bx + 0.55 * pw);
    const act : u32 = @as(u32, @intCast(tg[TPG_K_ACT]));
    if (kb_text(act).len > 0) {
        tg_txt(c, kit, kb_text(act), bx + 0.55 * pw, y0 + 14.0, 8.5, 0.0, 0.9 * a, bx + pw - kb_pad());
    }
    const hotls : u32 = kn_card_under(tg, tb, mx, my, x0, y0, pw, ph);
    const hotcol : u32 = kn_col_under(mx, pw, x0);
    var c2 : u32 = 0;
    while (c2 < KB_COLS) {
        const cx : f64 = bx + kb_col_x(c2, pw);
        const cwid : f64 = kb_col_w(pw);
        plate(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), sw, a);
        const cnt : u32 = kb_count(log, c2, pnum, pto);
        var cn : usize = put_bytes(line[0..200], 0, kb_col_name(c2));
        cn = put_bytes(line[0..200], cn, "  ");
        cn = put_dec(line[0..200], cn, @as(u64, cnt));
        if (c2 == kb_doing()) { cn = put_bytes(line[0..200], cn, " / 3"); }
        tg_txt(c, kit, line[0..cn], cx + 8.0, by + kb_pad() + 18.0, 9.5, WEIGHT_BOLD, a, cx + cwid - 6.0);
        if (drag != 0 and hotcol == c2) {
            const act2 : u32 = kb_drop(@as(u32, @intCast(tg[TPG_K_FROM])), c2, kb_count(log, kb_doing(), 0, 0));
            round_rect(c, cx, by + kb_pad(), cwid, bh - 2.0 * kb_pad(), TILE_CORNER);
            cg_line_width(c, 1.5);
            var ha : f64 = 0.25;
            if (kb_proposes(act2)) { ha = 0.9; }
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, ha * a);
            cg_stroke_path(c);
        }
        var shown : u32 = 0;
        if (cnt > sc) { shown = cnt - sc; }
        if (shown > rows) { shown = rows; }
        var i : u32 = 0;
        while (i < shown) {
            const ls : u32 = kb_nth(log, c2, sc + i, pnum, pto);
            if (ls != KB_NONE) {
                const isdrag : bool = drag != 0 and ls + 1 == drag;
                draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), ls, bx + kb_card_x(c2, pw), by + kb_card_y(i), kb_card_w(pw), hotls == ls and drag == 0, pnum != 0 and kb_num(log, ls) == pnum and pto == c2, isdrag, sw, full, a);
            }
            i = i + 1;
        }
        if (cnt > sc + shown) {
            var mn : usize = put_bytes(line[0..200], 0, "+");
            mn = put_dec(line[0..200], mn, @as(u64, cnt - sc - shown));
            mn = put_bytes(line[0..200], mn, " more (scroll)");
            tg_txt(c, kit, line[0..mn], cx + 8.0, by + bh - kb_pad() - 4.0, 8.0, 0.0, 0.5 * a, cx + cwid - 6.0);
        }
        c2 = c2 + 1;
    }
    if (drag != 0) {
        draw_kn_card(c, kit, tb, @as(usize, tg[TPG_K_LEN]), drag - 1, mx - 0.5 * kb_card_w(pw), my - 12.0, kb_card_w(pw), true, false, false, sw, full, a);
    }
}

// ---- Q: the QUEEN live board ----

/// The folder the host jobs of the Q page run in: the repository of the space on screen, else the first bound
/// space. Written to tb[TBO_ROOT ..]; the byte count (0 when no space is bound).
fn qn_root(dk: [128]u64, space: u32, tb: []u8) -> usize {
    var found : u64 = dk_at(dk, dk[DK_SLOTS], @as(u64, space));
    if (dk_len(dk, found) == 0) {
        var i : u32 = 0;
        while (i < SPACE_COUNT and dk_len(dk, found) == 0) {
            found = dk_at(dk, dk[DK_SLOTS], @as(u64, i));
            i = i + 1;
        }
    }
    if (dk_len(dk, found) == 0) { return 0; }
    return ns_bytes(found, tb[TBO_ROOT .. TBO_ROOT + 256]);
}

/// The value of counter m now: the host's two files, the two the window knows, the rest not measured.
fn qn_after(tg: []const u64, m: u32) -> u32 {
    if (m == M_LINKS or m == M_TESTS) { return @as(u32, @intCast(tg[TPG_Q_AFTER + m])); }
    if (m == M_NO_INSTRUMENT) { return live_no_instrument(); }
    if (m == M_UNASSIGNED) { return @as(u32, @intCast(tg[TPG_Q_UNASS])); }
    return qb_nm();
}

/// A refresh ended (or none could run): the lane log, and the start-of-day snapshot at the first refresh of a local day.
fn qn_finish(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    tg[TPG_Q_LANELEN] = @as(u64, tg_whole_lines(tb, TBO_LANES, tg_read(hb, QUEEN_DIR, FILE_LANES, tb[TBO_LANES .. TBO_CMD - 200])));
    const tz : i64 = @as(i64, @intCast(tg[TPG_Q_TZ])) - @as(i64, @intCast(TG_TZ_BIAS));
    if (snapshot_due(now, tg[TPG_Q_SNAP], tz)) {
        var m : u32 = 0;
        while (m < M_COUNT) {
            tg[TPG_Q_BEFORE + m] = @as(u64, qn_after(tg, m));
            m = m + 1;
        }
        tg[TPG_Q_SNAP] = now;
    }
    tg[TPG_Q_AT] = now;
    tg_bump(tg);
}

fn queen_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_Q_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_Q_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_Q_START], tg[TPG_Q_PID]);
        } else {
            tg[TPG_Q_PID] = 0;
            const n1 : usize = tg_read(hb, QUEEN_DIR, FILE_LINKS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_LINKS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n1]));
            const n2 : usize = tg_read(hb, QUEEN_DIR, FILE_TESTS, tb[TBO_SCR .. TBO_SCR + 64]);
            tg[TPG_Q_AFTER + M_TESTS] = @as(u64, counter_text(tb[TBO_SCR .. TBO_SCR + n2]));
            qn_finish(tg, tb, hb, now);
        }
    } else if (page_feed_due(PAGE_QUEEN, open, now, tg[TPG_Q_LAST])) {
        tg[TPG_Q_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            var e : usize = tg_head(tb, hb, Q_HEAD_A, Q_HEAD_B);
            e = put_bytes(tb, e, tb[TBO_ROOT .. TBO_ROOT + rn]);
            e = put_bytes(tb, e, Q_HEAD_C);
            e = put_bytes(tb, e, meter_cmd(M_LINKS));
            e = put_bytes(tb, e, Q_LINKS_TAIL);
            e = put_bytes(tb, e, meter_cmd(M_TESTS));
            e = put_bytes(tb, e, Q_TESTS_TAIL);
            const pid : u64 = tg_spawn(tb, TBO_CMD, e);
            if (pid != 0) {
                tg[TPG_Q_PID] = pid;
                tg[TPG_Q_START] = now;
                return;
            }
        }
        tg[TPG_Q_AFTER + M_LINKS] = @as(u64, qb_nm());
        tg[TPG_Q_AFTER + M_TESTS] = @as(u64, qb_nm());
        qn_finish(tg, tb, hb, now);
    }
}

// ---- the updater (release.t27): the window hosts the rules --------------------------------------------------
// Owner, 2026-10-20: updates install on every computer on the fly, online. release.t27 decides every step and
// writes every command; this block spawns the commands as `/bin/sh -c` jobs (tg_spawn), reaps them from the
// frame loop and reads their files. Words TPG_U_*; the job kinds below.
pub const TPG_U_ST : u32 = 90;
pub const TPG_U_PID : u32 = 91;
pub const TPG_U_KIND : u32 = 92;
pub const TPG_U_START : u32 = 93;
pub const TPG_U_LAST : u32 = 94;
pub const TPG_U_CUR : u32 = 95;
pub const TPG_U_CAND : u32 = 96;
pub const TPG_U_CANDV : u32 = 97;
pub const TPG_U_WHY : u32 = 98;
pub const TPG_U_GO : u32 = 99;
pub const TPG_U_QUIET : u32 = 100;
pub const TPG_U_BOOT : u32 = 101;
pub const TPG_U_UP0 : u32 = 102;
pub const TPG_U_MARK : u32 = 103;
pub const TPG_U_FAILB : u32 = 104;
pub const TPG_U_BLEN : u32 = 105;
pub const TPG_U_BUSY : u32 = 106;
pub const TPG_U_ON : u32 = 107;
pub const TPG_U_STAGED : u32 = 108;
/// Polls that failed in a row (release.t27 poll_gap backs the next one off), the second the toast began (0 = none),
/// the live module's applied revision, and a flag that the live file must be read again.
/// Words 37, 38, 39, 22, 23: they were 180..184, inside the orbit's TPG_O_HY span (168..199), and the orbit's
/// per-frame writes turned V_DIRTY and V_REV into garbage (an endless live reload, a frozen window). Never
/// put a word inside a span: add it to the word map test (the_word_map_has_no_overlap) in the same commit.
pub const TPG_U_FAILS : u32 = 37;
pub const TPG_U_TOAST : u32 = 38;
pub const TPG_V_REV : u32 = 39;
pub const TPG_V_DIRTY : u32 = 22;
pub const TPG_U_TSEC : u32 = 23;
pub const UP_CHECK : u64 = 1;
pub const UP_DOWNLOAD : u64 = 2;
pub const UP_STAGE : u64 = 3;
pub const UP_SWAP : u64 = 4;
pub const UP_MARK : u64 = 5;
pub const UP_CONFIRM : u64 = 6;
pub const UP_ROLLBACK : u64 = 7;
/// The manifest is read into tb[TBO_SCR ..], then the sums (two files, one after the other) and the three
/// --version outputs; the room is TBO_SCR .. TBO_SIZE.
pub const UP_MAN : usize = 2048;
pub const UP_SUMS : usize = 2560;
pub const UP_VER : usize = 128;
pub const UP_CAP : usize = 6000;
/// A job that outlives this is killed; the download is the long one.
pub const UP_KILL_CHECK_S : u64 = 60;
pub const UP_KILL_LONG_S : u64 = 900;

/// Panes the server lists as working or blocked on you: the swap never happens while one is.
fn up_busy(sst: []const u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < 32) {
        const s : u32 = row_state(sst, i);
        if (s == S_WORKING or s == S_BLOCKED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// Start the command that a release.t27 builder wrote at tb[TBO_CMD + 6 ..] (n bytes); false when it did not fit or did not start.
fn up_start(tg: []u64, tb: []u8, n: usize, kind: u64, now: u64) -> bool {
    if (n == 0 or n > UP_CAP) { return false; }
    const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + n);
    if (pid == 0) { return false; }
    tg[TPG_U_PID] = pid;
    tg[TPG_U_KIND] = kind;
    tg[TPG_U_START] = now;
    return true;
}

fn up_fail(tg: []u64, why: u8, mark_bad: bool) -> void {
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_FAILED, 0));
    tg[TPG_U_WHY] = @as(u64, why);
    tg[TPG_U_GO] = 0;
    if (mark_bad) { tg[TPG_U_FAILB] = tg[TPG_U_CAND]; }
    // any failed step backs the next poll off (a download that keeps failing must not retry every minute)
    tg[TPG_U_FAILS] = @as(u64, fails_after(false, @as(u32, @intCast(tg[TPG_U_FAILS]))));
}

/// The digits at the start of a small file (a build number followed by a newline).
fn up_num(tb: []const u8, at: usize, n: usize) -> u32 {
    var e : usize = 0;
    while (e < n and tb[at + e] >= 48 and tb[at + e] <= 57) { e = e + 1; }
    return parse_build(tb[at .. at + e], e);
}

/// The first start of this process: act on the marker an earlier swap left, and learn the build a rollback refused.
fn up_boot(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64) -> void {
    tg[TPG_U_BOOT] = 1;
    tg[TPG_U_UP0] = now;
    const rn : usize = tg_read(hb, UPD_DIR, F_REJECTED, tb[TBO_SCR .. TBO_SCR + 16]);
    tg[TPG_U_FAILB] = @as(u64, up_num(tb, TBO_SCR, rn));
    const mn : usize = tg_read(hb, UPD_DIR, F_PENDING, tb[TBO_SCR .. TBO_SCR + 8]);
    const mk : u8 = marker_of(mn > 0, tb[TBO_SCR]);
    const kn : usize = tg_read(hb, UPD_DIR, F_KEPT, tb[TBO_SCR .. TBO_SCR + 8]);
    const act : u8 = boot_action(mk, kn > 0);
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (act == BOOT_FIRST) {
        // the first start of a build the updater swapped in: say so in the header for TOAST_S seconds
        tg[TPG_U_TOAST] = now;
        tg[TPG_U_MARK] = 1;
        up_start(tg, tb, mark_cmd(out, UP_CAP, hb, hb.len), UP_MARK, now);
    } else if (act == BOOT_ROLLBACK) {
        up_start(tg, tb, rollback_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CUR]))), UP_ROLLBACK, now);
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    } else if (act == BOOT_BROKEN) {
        tg[TPG_U_MARK] = 1;
        tg[TPG_U_WHY] = @as(u64, WHY_BROKEN);
    }
}

/// A poll finished: judge the manifest it fetched and start the download of a newer build.
fn up_checked(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    const chk : u8 = manifest_check(man, mn);
    const cb : u64 = manifest_build(man, mn);
    var bld : u32 = 0;
    if (cb != NO_FIELD) { bld = @as(u32, @intCast(cb)); }
    const ver : u64 = manifest_version(man, mn);
    const off : u8 = offer(chk, ver, bld, current_version(), @as(u32, @intCast(tg[TPG_U_CUR])), @as(u32, @intCast(tg[TPG_U_FAILB])), true);
    var st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    if (off == OFFER_UPDATE) {
        tg[TPG_U_CAND] = @as(u64, bld);
        tg[TPG_U_CANDV] = ver;
        tg[TPG_U_WHY] = @as(u64, WHY_NONE);
        if (tg[TPG_U_STAGED] == @as(u64, bld)) {
            tg[TPG_U_ST] = @as(u64, U_STAGED);
            return;
        }
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_OFFER, 0));
        if (up_start(tg, tb, download_cmd(out, UP_CAP, hb, hb.len, ver, bld), UP_DOWNLOAD, now) == false) { up_fail(tg, WHY_DOWNLOAD, false); }
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(st, EV_NO_OFFER, 0));
    tg[TPG_U_WHY] = @as(u64, WHY_NONE);
    if (off == OFFER_BAD_MANIFEST) { tg[TPG_U_WHY] = @as(u64, WHY_MANIFEST); }
}

/// The download finished: its digests against the manifest, then the stage job.
fn up_downloaded(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    var fb : [48]u8 = undefined;
    const fn1 : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const sn : usize = tg_read(hb, UPD_DIR, fb[0..fn1], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + sn], sn, tb[TBO_SCR .. TBO_SCR + mn], mn, 0, ROWS_DOWNLOADED);
    if (bad != 0) {
        up_fail(tg, WHY_SHA, true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_DOWNLOADED, 0));
    const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
    if (up_start(tg, tb, stage_cmd(out, UP_CAP, hb, hb.len, tg[TPG_U_CANDV], b), UP_STAGE, now) == false) { up_fail(tg, WHY_STAGE, false); }
}

/// The stage finished (unzipped, signed, versions asked): every digest, every tool's commit, then staged or refused.
fn up_staged(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const b : u32 = @as(u32, @intCast(tg[TPG_U_CAND]));
    const mn : usize = tg_read(hb, UPD_DIR, F_MANIFEST, tb[TBO_SCR .. TBO_SCR + UP_MAN]);
    const man : []const u8 = tb[TBO_SCR .. TBO_SCR + mn];
    var fb : [48]u8 = undefined;
    var fl : usize = put_build_file(fb[0..48], 48, 0, b, "sums.txt");
    const s1 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_SUMS]);
    fl = put_build_file(fb[0..48], 48, 0, b, "sums2.txt");
    const s2 : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[TBO_SCR + UP_MAN + s1 .. TBO_SCR + UP_SUMS + 140]);
    const bad : u32 = sums_verdict(tb[TBO_SCR + UP_MAN .. TBO_SCR + UP_MAN + s1 + s2], s1 + s2, man, mn, 0, ROWS_ALL);
    const cm : u64 = field_str(man, mn, KEY_COMMIT, KEY_COMMIT.len);
    var want : []const u8 = man[0..0];
    if (cm != NO_FIELD) { want = man[field_start(cm) .. field_start(cm) + field_len(cm)]; }
    var worst : u8 = TV_OK;
    var k : u32 = 0;
    while (k < 3) {
        const at : usize = TBO_SCR + UP_SUMS + 140 + @as(usize, k) * UP_VER;
        if (k == 0) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27b.txt"); }
        if (k == 1) { fl = put_build_file(fb[0..48], 48, 0, b, "v_t27c.txt"); }
        if (k == 2) { fl = put_build_file(fb[0..48], 48, 0, b, "v_tri.txt"); }
        const vn : usize = tg_read(hb, UPD_DIR, fb[0..fl], tb[at .. at + UP_VER]);
        worst = tv_worse(worst, tool_verdict(tb[at .. at + vn], vn, want, want.len));
        k = k + 1;
    }
    const d : u8 = install_decision(bad, worst, tg[TPG_U_BLEN] > 0);
    if (d != ID_INSTALL) {
        up_fail(tg, why_of_decision(d), true);
        return;
    }
    tg[TPG_U_ST] = @as(u64, update_step(@as(u8, @intCast(tg[TPG_U_ST])), EV_SIGNED, 0));
    tg[TPG_U_STAGED] = @as(u64, b);
}

/// A job ended (ok: it exited 0). Decide the next step.
fn up_finished(tg: []u64, tb: []u8, hb: []const u8, now: u64, kind: u64, ok: bool) -> void {
    if (kind == UP_CHECK) {
        // the poll also fetched the live data: read it again whatever the manifest says
        tg[TPG_V_DIRTY] = 1;
        if (ok) {
            tg[TPG_U_FAILS] = @as(u64, fails_after(true, 0));
            up_checked(tg, tb, hb, now);
        } else { up_fail(tg, WHY_OFFLINE, false); }
    } else if (kind == UP_DOWNLOAD) {
        if (ok) { up_downloaded(tg, tb, hb, now); } else { up_fail(tg, WHY_DOWNLOAD, false); }
    } else if (kind == UP_STAGE) {
        if (ok) { up_staged(tg, tb, hb); } else { up_fail(tg, WHY_STAGE, true); }
    } else if (kind == UP_SWAP) {
        // a swap that worked ends in a relaunch (hot_reload); one that did not leaves the old app and says why
        if (ok == false) { up_fail(tg, WHY_SWAP, true); }
    }
}

/// One frame of the updater: reap the running job, else do the next thing that is due.
fn update_tick(tg: []u64, tb: []u8, hb: []const u8, bp: []const u8, now: u64, busy: u32) -> void {
    if (tg[TPG_U_ON] == 0) { return; }
    // the header toast: a redraw each second while it shows, and one when it goes
    if (tg[TPG_U_TOAST] != 0) {
        if (toast_on(now, tg[TPG_U_TOAST])) {
            if (tg[TPG_U_TSEC] != now) {
                tg[TPG_U_TSEC] = now;
                tg_bump(tg);
            }
        } else {
            tg[TPG_U_TOAST] = 0;
            tg_bump(tg);
        }
    }
    if (tg[TPG_U_BUSY] != @as(u64, busy)) {
        tg[TPG_U_BUSY] = @as(u64, busy);
        tg_bump(tg);
    }
    if (busy > 0) { tg[TPG_U_QUIET] = 0; } else if (tg[TPG_U_QUIET] == 0) { tg[TPG_U_QUIET] = now; }
    if (tg[TPG_U_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_U_PID]);
        if (d == 0) {
            var lim : u64 = UP_KILL_CHECK_S;
            if (tg[TPG_U_KIND] == UP_DOWNLOAD or tg[TPG_U_KIND] == UP_STAGE) { lim = UP_KILL_LONG_S; }
            if (now > tg[TPG_U_START] + lim) { tg_kill(tg[TPG_U_PID]); }
            return;
        }
        const kind : u64 = tg[TPG_U_KIND];
        tg[TPG_U_PID] = 0;
        up_finished(tg, tb, hb, now, kind, d == 1);
        tg_bump(tg);
        if (tg[TPG_U_PID] != 0) { return; }
    }
    if (tg[TPG_U_BOOT] == 0) {
        up_boot(tg, tb, hb, bp, now);
        tg_bump(tg);
        return;
    }
    if (tg[TPG_U_MARK] != 0 and confirm_due(now - tg[TPG_U_UP0])) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_MARK] = 0;
        up_start(tg, tb, confirm_cmd(out, UP_CAP, hb, hb.len), UP_CONFIRM, now);
        return;
    }
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    var quiet : u64 = 0;
    if (tg[TPG_U_QUIET] != 0 and now > tg[TPG_U_QUIET]) { quiet = now - tg[TPG_U_QUIET]; }
    if (swap_ready(st, busy, quiet, tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        const sn : usize = swap_cmd(out, UP_CAP, hb, hb.len, bp, @as(usize, tg[TPG_U_BLEN]), @as(u32, @intCast(tg[TPG_U_CAND])));
        tg[TPG_U_GO] = 0;
        tg[TPG_U_ST] = @as(u64, update_step(st, EV_SWAP, busy));
        if (up_start(tg, tb, sn, UP_SWAP, now) == false) { up_fail(tg, WHY_SWAP, false); }
        tg_bump(tg);
        return;
    }
    if (st == U_IDLE and (check_due(now, tg[TPG_U_LAST], @as(u32, @intCast(tg[TPG_U_FAILS]))) or tg[TPG_U_GO] != 0)) {
        const out : []u8 = tb[TBO_CMD + 6 .. TBO_CMD + 6 + UP_CAP];
        tg[TPG_U_LAST] = now;
        tg[TPG_U_GO] = 0;
        if (up_start(tg, tb, check_cmd(out, UP_CAP, hb, hb.len), UP_CHECK, now)) {
            tg[TPG_U_ST] = @as(u64, update_step(st, EV_CHECK, busy));
        }
        tg_bump(tg);
    }
}

// ---- the live layer (hot_reload.t27): the data the window re-reads while it runs --------------------------------

/// The built-in level of every live theme value, as permille, in the order of hot_reload.t27 THV_*.
fn thv_defaults(tbl: []u32) -> void {
    tbl[THV_TINT_BLACK] = thv_permille(TINT_BLACK);
    tbl[THV_STRICT_SIDE] = thv_permille(STRICT_SIDE);
    tbl[THV_ELEVATED_BLACK] = thv_permille(ELEVATED_BLACK);
    tbl[THV_STRICT_CONTENT] = thv_permille(STRICT_CONTENT);
    tbl[THV_PANEL_BLACK] = thv_permille(PANEL_BLACK);
    tbl[THV_TEXT_WHITE] = thv_permille(TEXT_WHITE);
    tbl[THV_LABEL_WHITE] = thv_permille(LABEL_WHITE);
    tbl[THV_MUTED_WHITE] = thv_permille(MUTED_WHITE);
    tbl[THV_BORDER_WHITE] = thv_permille(BORDER_WHITE);
    tbl[THV_LINE_WHITE] = thv_permille(LINE_WHITE);
    tbl[THV_HIGHLIGHT_WHITE] = thv_permille(HIGHLIGHT_WHITE);
    tbl[THV_TIP_WHITE] = thv_permille(TIP_WHITE);
    tbl[THV_CROWN_WHITE] = thv_permille(CROWN_WHITE);
    tbl[THV_TERMINAL_TINT] = thv_permille(TERMINAL_TINT);
    tbl[THV_AGENTS_LINE_ALPHA] = thv_permille(AGENTS_LINE_ALPHA);
}

/// Pack a table into the three kit words the draw code reads.
fn thv_store(kk: []u64, tbl: []const u32) -> void {
    kk[K_LIVE0] = live_pack(tbl, 0);
    kk[K_LIVE1] = live_pack(tbl, 1);
    kk[K_LIVE2] = live_pack(tbl, 2);
}

/// One live theme level: what the draw code multiplies its alpha by (the constant until a live module moves it).
fn lv(kit: [48]u64, id: u32) -> f64 {
    return live_get(kit[K_LIVE0], kit[K_LIVE1], kit[K_LIVE2], id);
}

/// Read ~/.t27os/live/live.t27 and apply it to the kit: the theme levels and, when the count matches, the petal names.
/// A file that fails live_check, or is older than the applied revision, changes nothing. The caller redraws.
fn live_load(tg: []u64, tb: []u8, hb: []const u8, kk: []u64) -> bool {
    const n : usize = tg_read(hb, LIVE_DIR, F_LIVE, tb[TBO_SCR .. TBO_SCR + LIVE_MAX_BYTES + 1]);
    if (n == 0) { return false; }
    const t : []const u8 = tb[TBO_SCR .. TBO_SCR + n];
    const rev : u64 = live_rev(t, n);
    if (live_should_apply(live_check(t, n), rev, tg[TPG_V_REV]) == false) { return false; }
    var tbl : [15]u32 = undefined;
    thv_defaults(tbl[0..15]);
    live_apply(t, n, tbl[0..15]);
    thv_store(kk, tbl[0..15]);
    const pf : u64 = live_petals(t, n, PETAL_COUNT - 1);
    if (pf != NO_FIELD) {
        const ns : u64 = cf_bytes(0, t[field_start(pf) .. field_start(pf) + field_len(pf)], field_len(pf), UTF8, false);
        if (ns != 0) {
            const arr : u64 = msg1(ns, sel("componentsSeparatedByString:"), cf(","));
            msg0(arr, sel("retain"));
            kk[K_NAMES] = arr;
            cf_release(ns);
        }
    }
    tg[TPG_V_REV] = rev;
    return true;
}

/// The header toast "updated to <ver> b<build>", right of the title, for TOAST_S seconds after the first start of a
/// swapped-in build: a small glass chip at the right end of the header, left of the "+".
fn draw_update_toast(c: u64, kit: [48]u64, tg: []const u64, now: u64, sw: f64, a: f64) -> void {
    if (tg[TPG_U_ON] == 0 or toast_on(now, tg[TPG_U_TOAST]) == false) { return; }
    var w : [48]u8 = undefined;
    const n : usize = toast_text(w[0..48], 48, current_version(), @as(u32, @intCast(tg[TPG_U_CUR])));
    if (n == 0 or n > 48) { return; }
    const tw : f64 = bytes_w(kit, w[0..48], n, 10.5, WEIGHT_SEMIBOLD, false);
    const bw : f64 = tw + 20.0;
    const bx : f64 = new_chat_x(sw) - 12.0 - bw;
    const by : f64 = WS_TOP + 0.5 * (HEADER_H - 22.0);
    round_rect(c, bx, by, bw, 22.0, 11.0);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_HIGHLIGHT_WHITE) * 1.5 * a);
    cg_fill_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE) * a);
    draw_bytes(c, kit, w[0..48], n, bx + 10.0, by + 15.0, 10.5, WEIGHT_SEMIBOLD, false);
}

pub const UP_STRIP_H : f64 = 22.0;

/// The update line sits on the sidebar just above the foot, while there is something to say.
pub fn on_update_strip(x: f64, y: f64, sh: f64, ws: u32, collapsed: bool, shown: bool) -> bool {
    return shown and in_side(x, ws, collapsed) and y >= sh - FOOT_H - UP_STRIP_H and y < sh - FOOT_H;
}

fn draw_update_strip(c: u64, kit: [48]u64, tg: []const u64, mx: f64, my: f64, sh: f64, ws: u32, collapsed: bool, a: f64) -> void {
    const st : u8 = @as(u8, @intCast(tg[TPG_U_ST]));
    const why : u8 = @as(u8, @intCast(tg[TPG_U_WHY]));
    if (tg[TPG_U_ON] == 0 or strip_kind(st, why) == STRIP_HIDDEN) { return; }
    var w : [96]u8 = undefined;
    const n : usize = strip_text(w[0..96], 96, st, why, @as(u32, @intCast(tg[TPG_U_CAND])), @as(u32, @intCast(tg[TPG_U_BUSY])));
    if (n == 0 or n > 96) { return; }
    var la : f64 = lv(kit, THV_LABEL_WHITE);
    if (on_update_strip(mx, my, sh, ws, collapsed, true) or strip_kind(st, why) == STRIP_READY) { la = lv(kit, THV_TEXT_WHITE); }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    draw_bytes(c, kit, w[0..96], n, 14.0, sh - FOOT_H - 8.0, 9.5, WEIGHT_SEMIBOLD, false);
}

/// The evolve Panel from what the window knows (see evolve_next): letters with no instrument, pinned to nothing, and widgets no letter owns.
fn make_panel(unassigned: u32) -> Panel {
    var p : Panel = Panel { master_red: false, blocked: 0, stale: 0, unowned_count: 0, no_instrument: 0, never_pinned: 0, no_widget_count: unassigned, no_widget: 0 };
    if (unassigned > 0) { p.no_widget = letter_bit(LETTER_UNOWNED); }
    var l : u32 = 1;
    while (l <= LETTER_COUNT) {
        if (widgets_of_letter(l) == 0) { p.no_instrument = p.no_instrument + letter_bit(l); }
        if (pinned_widgets(l, false) + pinned_widgets(l, true) + pinned_surfaces(l, false) + pinned_surfaces(l, true) == 0) { p.never_pinned = p.never_pinned + letter_bit(l); }
        l = l + 1;
    }
    return p;
}

/// Tasks the Queen started in the last hour, read from the ring copy.
fn qn_started_hour(tg: []const u64, now: u64) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < RING) {
        const e : u64 = tg[TPG_Q_RING + i];
        if (e != 0 and ev_control(e) == C_QUEEN_STARTED and now < ev_sec(e) + 3600) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn qn_node(c: u64, kit: [48]u64, n: u32, x0: f64, y0: f64, pw: f64, ph: f64, sw: f64, full: bool, a: f64) -> void {
    const nx : f64 = x0 + node_x(n, pw);
    const ny : f64 = y0 + node_y(n, pw, ph);
    plate(c, nx, ny, node_w(n, pw), node_h(n, pw, ph), sw, a);
    var nb : [32]u8 = undefined;
    const nn : usize = csv_field(QN_NAMES, n, nb[0..32]);
    tg_txt(c, kit, nb[0..nn], nx + 10.0, ny + 14.0, 9.5, WEIGHT_BOLD, a, nx + node_w(n, pw) - 10.0);
}

fn draw_queen_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    var line : [200]u8 = undefined;
    var wb : [64]u8 = undefined;
    const god : bool = tg[TPG_Q_GOD] != 0;
    var unp : u32 = @as(u32, @intCast(tg[TPG_Q_UNASS]));
    if (qb_measured(unp) == false) { unp = 0; }
    const panel : Panel = make_panel(unp);
    // ---- LAMPS: 27, each from the per-letter aggregate the host feeds; none is fed, so each says not measured
    qn_node(c, kit, QN_LAMPS, x0, y0, pw, ph, sw, full, a);
    tg_txt(c, kit, "not measured: domain_pulse cannot be linked into the window yet (#5980)", x0 + node_x(QN_LAMPS, pw) + 70.0, y0 + node_y(QN_LAMPS, pw, ph) + 14.0, 8.0, 0.0, 0.5 * a, x0 + node_x(QN_LAMPS, pw) + node_w(QN_LAMPS, pw) - 10.0);
    var li : u32 = 0;
    while (li < LAMP_COUNT) {
        const lx : f64 = x0 + node_x(QN_LAMPS, pw) + lamp_x(li, pw);
        const ly : f64 = y0 + node_y(QN_LAMPS, pw, ph) + lamp_y(li, pw);
        const lw : f64 = lamp_w(pw);
        const stt : u32 = lamp_status(tb[0..0], li + 1);
        round_rect(c, lx, ly, lw, 40.0, 4.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.22 * a);
        cg_stroke_path(c);
        tg_txt(c, kit, AGENT_LETTERS[li], lx + 5.0, ly + 13.0, 9.5, WEIGHT_BOLD, a, lx + lw - 3.0);
        if (stt == LS_NONE) {
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.4 * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_stroke_path(c);
            tg_txt(c, kit, "n/m", lx + 18.0, ly + 31.0, 7.5, 0.0, 0.45 * a, lx + lw - 2.0);
        } else {
            var fa : f64 = 0.3;
            if (stt == LS_WARM) { fa = 0.55; }
            if (stt == LS_ACTIVE or stt == LS_BLOCKED) { fa = 0.95; }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, fa * a);
            cg_arc(c, lx + 9.0, ly + 28.0, 4.0, 0.0, 6.283185307, 0);
            cg_fill_path(c);
        }
        li = li + 1;
    }
    // ---- FEED: her actions newest first, the ring merged with the lane log
    qn_node(c, kit, QN_FEED, x0, y0, pw, ph, sw, full, a);
    const fx : f64 = x0 + node_x(QN_FEED, pw);
    const fy : f64 = y0 + node_y(QN_FEED, pw, ph);
    const fw : f64 = node_w(QN_FEED, pw);
    const evn : u32 = @as(u32, @intCast(tg[TPG_Q_EVN]));
    const lanes : []const u8 = tb[TBO_LANES .. TBO_LANES + @as(usize, tg[TPG_Q_LANELEN])];
    var rb : u32 = 0;
    var lk : u32 = 0;
    var row : u32 = 0;
    const nrows : u32 = feed_rows(pw, ph);
    var shown : u32 = 0;
    while (row < nrows) {
        var rslot : u32 = ring_at(evn, rb);
        while (rslot != RING_NONE and feed_kind_of_control(ev_control(tg[TPG_Q_RING + rslot])) == FK_NONE) {
            rb = rb + 1;
            rslot = ring_at(evn, rb);
        }
        var rev : u64 = 0;
        if (rslot != RING_NONE) { rev = tg[TPG_Q_RING + rslot]; }
        const ls : u32 = lane_line_start(lanes, lk);
        var lsec : u64 = 0;
        var lleft : u32 = 0;
        if (ls != qb_nm()) { lsec = lane_sec(lanes, ls); lleft = 1; }
        var rleft : u32 = 0;
        if (rslot != RING_NONE) { rleft = 1; }
        const pick : u32 = merge_pick(rleft, ev_sec(rev), lleft, lsec);
        if (pick == qb_src_none()) { row = nrows; } else {
            const ry : f64 = fy + feed_row_y(row);
            var kind : u32 = FK_NONE;
            var sec : u64 = 0;
            var tn : usize = 0;
            var from_lane : bool = false;
            if (pick == qb_src_ring()) {
                kind = feed_kind_of_control(ev_control(rev));
                sec = ev_sec(rev);
                tn = put_bytes(line[0..200], 0, ring_text_head(kind));
                const lt : u32 = feed_letter_of_event(rev);
                if (lt != 0 and (kind == FK_LANE or kind == FK_ASKED)) { tn = put_bytes(line[0..200], tn, letter_char(lt)); }
                rb = rb + 1;
            } else {
                kind = lane_kind(lanes, ls);
                sec = lsec;
                from_lane = true;
                const ts : usize = @as(usize, lane_text_start(lanes, ls));
                const tl : usize = @as(usize, lane_text_len(lanes, ls));
                if (profile_ok(lanes[ts .. ts + tl])) {
                    const shown_n : usize = @as(usize, feed_text_len(@as(u32, @intCast(tl))));
                    tn = put_bytes(line[0..200], 0, lanes[ts .. ts + shown_n]);
                } else {
                    tn = put_bytes(line[0..200], 0, KEY_PLACEHOLDER);
                }
                lk = lk + 1;
            }
            tg_txt(c, kit, line[0..tn], fx + 10.0, ry + 13.0, 9.0, WEIGHT_SEMIBOLD, a, fx + fw - 10.0);
            var kn : usize = csv_field(FEED_WORDS, kind, wb[0..64]);
            kn = put_bytes(wb[0..64], kn, "  ");
            if (from_lane) { kn = put_bytes(wb[0..64], kn, "lane log"); } else { kn = put_bytes(wb[0..64], kn, "ring"); }
            tg_txt(c, kit, wb[0..kn], fx + 10.0, ry + 26.0, 8.0, 0.0, 0.5 * a, fx + fw - 70.0);
            var an : [32]u8 = undefined;
            const al : usize = csv_field(AGE_WORDS, age_word(now, sec), an[0..32]);
            const aw : f64 = bytes_w(kit, an[0..al], al, 8.0, 0.0, true);
            tg_txt(c, kit, an[0..al], fx + fw - 10.0 - aw, ry + 26.0, 8.0, 0.0, 0.6 * a, 0.0);
            shown = shown + 1;
            row = row + 1;
        }
    }
    if (shown == 0) {
        tg_txt(c, kit, "nothing yet: GOD MODE has not picked a gap, no lane has started", fx + 10.0, fy + 40.0, 8.5, 0.0, 0.5 * a, fx + fw - 10.0);
    }
    // ---- GAPS: the top ten in evolve order, each with why it is not started now
    qn_node(c, kit, QN_GAPS, x0, y0, pw, ph, sw, full, a);
    const gx : f64 = x0 + node_x(QN_GAPS, pw);
    const gy : f64 = y0 + node_y(QN_GAPS, pw, ph);
    const gw : f64 = node_w(QN_GAPS, pw);
    const started : u32 = qn_started_hour(tg, now);
    const evfl : u32 = @as(u32, @intCast(tg[TPG_Q_EVFL]));
    var gi : u32 = 0;
    var gshown : u32 = 0;
    while (gi < GAP_ROWS) {
        const gry : f64 = gy + gap_row_y(gi, pw, ph);
        if (gry + gap_row_h(pw, ph) > gy + node_h(QN_GAPS, pw, ph)) {
            // the column holds fewer than ten rows at this height (GAP_ROW_MIN); the rest are cut, not drawn over the next widget
            gi = GAP_ROWS;
        } else if (row_exists(panel, gi)) {
            gshown = gshown + 1;
            const g : u32 = nth_gap(panel, gi);
            const kind2 : u32 = gap_kind_of(g);
            var pcn : usize = csv_field(CLASS_WORDS, class_of_kind(kind2), line[0..200]);
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, letter_char(gap_letter_of(g)));
            pcn = put_bytes(line[0..200], pcn, "  ");
            pcn = put_bytes(line[0..200], pcn, kind_phrase(kind2));
            tg_txt(c, kit, line[0..pcn], gx + 10.0, gry + 12.0, 8.5, WEIGHT_SEMIBOLD, a, gx + gw - 10.0);
            const why : u32 = row_why(panel, gi, evfl, god, true, 0, started, 0, 0);
            var wn : usize = put_bytes(wb[0..64], 0, "now: ");
            wn = wn + csv_field(WN_WORDS, why, wb[wn .. 64]);
            tg_txt(c, kit, wb[0..wn], gx + 10.0, gry + gap_row_h(pw, ph) - 5.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
        }
        if (gi < GAP_ROWS) { gi = gi + 1; }
    }
    var gtn : usize = put_bytes(line[0..200], 0, "top ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gshown));
    gtn = put_bytes(line[0..200], gtn, " of ");
    gtn = put_dec(line[0..200], gtn, @as(u64, gap_total(panel)));
    gtn = put_bytes(line[0..200], gtn, " gaps, evolve order");
    tg_txt(c, kit, line[0..gtn], gx + 50.0, gy + 14.0, 8.0, 0.0, 0.55 * a, gx + gw - 10.0);
    // ---- METER: before -> after since the start of the local day, each with its direction
    qn_node(c, kit, QN_METER, x0, y0, pw, ph, sw, full, a);
    const mx0 : f64 = x0 + node_x(QN_METER, pw);
    const my0 : f64 = y0 + node_y(QN_METER, pw, ph);
    var mi : u32 = 0;
    while (mi < M_COUNT) {
        const cxm : f64 = mx0 + meter_cell_x(mi, pw);
        const cym : f64 = my0 + meter_cell_y(mi);
        const cwm : f64 = meter_cell_w(pw);
        const before : u32 = @as(u32, @intCast(tg[TPG_Q_BEFORE + mi]));
        const after : u32 = qn_after(tg, mi);
        const lb : usize = csv_field(M_LABELS, mi, line[0..200]);
        tg_txt(c, kit, line[0..lb], cxm + 4.0, cym + 10.0, 7.5, 0.0, 0.55 * a, cxm + cwm - 2.0);
        var vn : usize = 0;
        if (qb_measured(after)) { vn = put_dec(line[0..200], 0, @as(u64, after)); } else { vn = put_bytes(line[0..200], 0, "not measured"); }
        var vsize : f64 = 14.0;
        if (qb_measured(after) == false) { vsize = 9.0; }
        tg_txt(c, kit, line[0..vn], cxm + 4.0, cym + 28.0, vsize, WEIGHT_HEAVY, a, cxm + cwm - 2.0);
        const ds : u32 = delta_state(mi, before, after);
        var dn : usize = 0;
        if (ds == D_UNKNOWN) {
            dn = put_bytes(line[0..200], 0, "no baseline");
        } else {
            dn = put_bytes(line[0..200], 0, delta_sign(before, after));
            dn = put_dec(line[0..200], dn, @as(u64, delta_abs(before, after)));
            dn = put_bytes(line[0..200], dn, " ");
            dn = dn + csv_field(M_UNITS, mi, line[dn .. 200]);
            if (ds == D_BETTER) { dn = put_bytes(line[0..200], dn, "  better"); }
            if (ds == D_WORSE) { dn = put_bytes(line[0..200], dn, "  worse"); }
        }
        var da : f64 = 0.55;
        if (ds == D_BETTER) { da = 0.95; }
        tg_txt(c, kit, line[0..dn], cxm + 4.0, cym + 40.0, 7.5, 0.0, da * a, cxm + cwm - 2.0);
        mi = mi + 1;
    }
    var bc : u32 = 0;
    var bm : u32 = 0;
    while (bm < M_COUNT) {
        if (delta_state(bm, @as(u32, @intCast(tg[TPG_Q_BEFORE + bm])), qn_after(tg, bm)) == D_BETTER) { bc = bc + 1; }
        bm = bm + 1;
    }
    var hn2 : usize = put_dec(line[0..200], 0, @as(u64, bc));
    hn2 = put_bytes(line[0..200], hn2, " of 6 better since the start of the day");
    tg_txt(c, kit, line[0..hn2], mx0 + 90.0, my0 + 14.0, 8.0, 0.0, 0.6 * a, mx0 + node_w(QN_METER, pw) - 10.0);
    // ---- SAFETY: tasks this hour, agents against the cap, the key tier as a word, STOP
    qn_node(c, kit, QN_SAFETY, x0, y0, pw, ph, sw, full, a);
    const sx : f64 = x0 + node_x(QN_SAFETY, pw);
    const sy : f64 = y0 + node_y(QN_SAFETY, pw, ph);
    var si : u32 = 0;
    while (si < 4) {
        const cxs : f64 = sx + safety_cell_x(si, pw);
        const cys : f64 = sy + safety_cell_y(si);
        const cws : f64 = safety_cell_w(pw);
        if (si == SC_TASKS) {
            var tn2 : usize = put_dec(line[0..200], 0, @as(u64, started));
            tn2 = put_bytes(line[0..200], tn2, "/");
            tn2 = put_dec(line[0..200], tn2, @as(u64, budget_cap()));
            tg_txt(c, kit, "tasks this hour", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..tn2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, (cws - 8.0) * bar_fill(started, budget_cap()), 3.0);
        }
        if (si == SC_AGENTS) {
            var an2 : usize = put_dec(line[0..200], 0, 0);
            an2 = put_bytes(line[0..200], an2, "/");
            an2 = put_dec(line[0..200], an2, @as(u64, agents_cap()));
            tg_txt(c, kit, "agents running", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            tg_txt(c, kit, line[0..an2], cxs + 4.0, cys + 28.0, 13.0, WEIGHT_HEAVY, a, cxs + cws - 2.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * a);
            cg_fill_rect(c, cxs + 4.0, cys + 36.0, cws - 8.0, 3.0);
        }
        if (si == SC_TIER) {
            const tier : u32 = @as(u32, @intCast(tg[TPG_Q_TIER]));
            const tw2 : usize = csv_field(KT_WORDS, tier, wb[0..64]);
            tg_txt(c, kit, "key tier", cxs + 4.0, cys + 10.0, 7.5, 0.0, 0.55 * a, cxs + cws - 2.0);
            var tal : f64 = 0.9;
            if (tier_is_warning(tier)) {
                round_rect(c, cxs + 2.0, cys + 15.0, cws - 4.0, 18.0, 3.0);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
                cg_fill_path(c);
                cg_fill_rgba(c, 0.0, 0.0, 0.0, a);
                draw_fit(c, kit, wb[0..tw2], tw2, cxs + 6.0, cys + 28.0, 9.0, WEIGHT_BOLD, true, cxs + cws - 4.0);
            } else {
                tg_txt(c, kit, wb[0..tw2], cxs + 4.0, cys + 28.0, 9.5, WEIGHT_SEMIBOLD, tal * a, cxs + cws - 2.0);
            }
        }
        if (si == SC_STOP) {
            const hot : bool = on_stop(mx - sx, my - sy, pw);
            tg_button(c, kit, cxs + 4.0, cys + 4.0, cws - 8.0, 22.0, "STOP", hot, god, a);
            tg_txt(c, kit, stop_effect(god), cxs + 4.0, cys + 36.0, 7.0, 0.0, 0.5 * a, cxs + cws - 2.0);
        }
        si = si + 1;
    }
}

// ---- H: the HIVE (devices) page and its host jobs (decisions: specs/t27os/devices.t27) ----

fn hive_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const n : usize = tg_read(hb, DV_DIR, DV_FILE, tb[TBO_HIVE .. TBO_HIVE + TBO_HIVE_N]);
    tg[TPG_H_LEN] = @as(u64, tg_whole_lines(tb, TBO_HIVE, n));
}

/// The feed job (refs on origin, trigit, this machine's probes) once a minute while the page is open, and the reap of both
/// jobs. The publisher is started by hive_publish.
fn hive_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_H_LOADED] == 0) {
        hive_load(tg, tb, hb);
        tg[TPG_H_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_H_PUB_PID] != 0) {
        if (tg_done(tg[TPG_H_PUB_PID]) == 0) { tg_late(now, tg[TPG_H_PUB_START], tg[TPG_H_PUB_PID]); } else { tg[TPG_H_PUB_PID] = 0; }
    }
    if (tg[TPG_H_PID] != 0) {
        if (tg_done(tg[TPG_H_PID]) == 0) {
            tg_late(now, tg[TPG_H_START], tg[TPG_H_PID]);
        } else {
            tg[TPG_H_PID] = 0;
            hive_load(tg, tb, hb);
            tg[TPG_H_AT] = now;
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_HIVE, open, now, tg[TPG_H_LAST])) {
        tg[TPG_H_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            const w : usize = dv_feed_cmd(hb, tb[TBO_ROOT .. TBO_ROOT + rn], tb[TBO_CMD + 6 .. TBO_ROOT]);
            const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
            if (pid != 0) {
                tg[TPG_H_PID] = pid;
                tg[TPG_H_START] = now;
            }
        }
    }
}

/// This machine's lanes field from the lanes table the sidebar draws (RUNNING script lanes), kept for the card and the beat.
fn hive_lanes(tg: []u64, tb: []u8, sst: []const u32) -> void {
    tg[TPG_H_LANES_LEN] = @as(u64, dv_lanes_text(sst[SST_LV .. SST_SIZE], sst[SST_LVN], tb[TBO_HLANES .. TBO_HLANES + TBO_HLANES_N]));
}

/// Publish this machine's heartbeat: the command is devices.t27's, run as a background job like the feeds.
fn hive_publish(tg: []u64, tb: []u8, hb: []const u8, now: u64) -> void {
    const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
    if (tg[TPG_H_PUB_PID] != 0 or rn == 0 or root_safe(tb[TBO_ROOT .. TBO_ROOT + rn]) == false) { return; }
    const ln : usize = @as(usize, tg[TPG_H_LANES_LEN]);
    const w : usize = dv_publish_cmd(hb, tb[TBO_ROOT .. TBO_ROOT + rn], tb[TBO_HLANES .. TBO_HLANES + ln], tb[TBO_CMD + 6 .. TBO_ROOT]);
    if (w == 0) { return; }
    const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
    if (pid != 0) {
        tg[TPG_H_PUB_PID] = pid;
        tg[TPG_H_PUB_START] = now;
    }
}

// ---- L: the LOGS page (t27os#23) -- the night loop's own log tail, as the swarm's visible heartbeat ----

/// The tail text into the LOG region; the length skips a cut first line (a byte-tail starts mid-line) and any
/// cut last line (tg_whole_lines), so the parser only ever sees whole lines.
fn lg_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const n : usize = tg_read(hb, LG_DIR, LG_FILE, tb[TBO_LOG .. TBO_LOG + TBO_LOG_N]);
    // a full buffer means the tail job byte-cut the file: its first line starts mid-line; skip past its LF
    var off : usize = 0;
    if (n >= TBO_LOG_N) {
        while (off < n and tb[TBO_LOG + off] != 10) { off = off + 1; }
        if (off < n) { off = off + 1; }
    }
    if (off > n) { off = n; }
    tg[TPG_LG_OFF] = @as(u64, off);
    tg[TPG_LG_LEN] = @as(u64, off + tg_whole_lines(tb, TBO_LOG + off, n - off));
}

/// The tail job (tail -c 6144 log.txt into tail.txt) every PERIOD_LOGS while the page is open, and its reap.
fn lg_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_LG_LOADED] == 0) {
        lg_load(tg, tb, hb);
        tg[TPG_LG_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_LG_PID] != 0) {
        if (tg_done(tg[TPG_LG_PID]) == 0) {
            tg_late(now, tg[TPG_LG_START], tg[TPG_LG_PID]);
        } else {
            tg[TPG_LG_PID] = 0;
            lg_load(tg, tb, hb);
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_LOGS, open, now, tg[TPG_LG_LAST])) {
        tg[TPG_LG_LAST] = now;
        const w : usize = lg_tail_cmd(hb, tb[TBO_CMD + 6 .. TBO_ROOT]);
        if (w > 0) {
            const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
            if (pid != 0) {
                tg[TPG_LG_PID] = pid;
                tg[TPG_LG_START] = now;
            }
        }
    }
}

/// The bytes of f[a .. b) into out at w, sanitized (printable ASCII or a dot) and capped at cap; returns the new w.
fn lg_put_clean(out: []u8, w: usize, f: []const u8, a: usize, b: usize, cap: usize) -> usize {
    var i : usize = a;
    var o : usize = w;
    while (i < b and o < w + cap) {
        var ch : u8 = f[i];
        if (ch < 32 or ch > 126) { ch = 46; }
        out[o] = ch;
        o = o + 1;
        i = i + 1;
    }
    return o;
}

fn draw_logs_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const off : usize = @as(usize, tg[TPG_LG_OFF]);
    const len : usize = @as(usize, tg[TPG_LG_LEN]);
    const f : []const u8 = tb[TBO_LOG + off .. TBO_LOG + len];
    var tab : [DL_MAX * DL_F]u32 = undefined;
    const n : u32 = lg_rows(f, false, tab[0 .. DL_MAX * DL_F]);
    var line : [200]u8 = undefined;
    // ---- header: the title, where the tail comes from, how many rows
    plate(c, x0 + DV_PAD, y0 + 2.0, pw - 2.0 * DV_PAD, DV_HEAD_H - 4.0, sw, a);
    tg_txt(c, kit, "LOOP LOG", x0 + DV_PAD + 10.0, y0 + 16.0, 10.5, WEIGHT_BOLD, a, 0.0);
    var hn : usize = put_bytes(line[0..200], 0, "~/.t27os/loop/log.txt, tail 6 KB, ");
    hn = put_dec(line[0..200], hn, @as(u64, n));
    hn = put_bytes(line[0..200], hn, " events");
    tg_txt(c, kit, line[0..hn], x0 + DV_PAD + 110.0, y0 + 16.0, 8.5, 0.0, 0.7 * a, 0.0);
    if (n == 0 and tg[TPG_LG_PID] == 0) {
        tg_txt(c, kit, "no tail yet -- the first job runs while this page is open", x0 + DV_PAD + 10.0, y0 + DV_HEAD_H + 18.0, 9.0, 0.0, 0.6 * a, 0.0);
        return;
    }
    // ---- rows: the newest DL_MAX lines, the clock left, the kind word, the subject
    const row_h : f64 = 15.0;
    var y : f64 = y0 + DV_HEAD_H + 6.0;
    var r : u32 = 0;
    while (r < n) {
        const q : usize = @as(usize, r) * DL_F;
        const kind : u32 = tab[q + DL_KIND];
        // the clock column (UTC; a malformed line shows the dashes)
        const cw : usize = lg_clock(tab[q + DL_EPOCH], line[0..200]);
        tg_txt(c, kit, line[0..cw], x0 + DV_PAD + 4.0, y + 11.0, 8.0, 0.0, 0.55 * a, 0.0);
        // the kind word (LK_WORDS; BAD carries its own label)
        tg_txt(c, kit, LK_WORDS[kind], x0 + DV_PAD + 84.0, y + 11.0, 9.0, 0.0, a, 0.0);
        // the subject, sanitized and truncated
        const ss : usize = @as(usize, tab[q + DL_SS]);
        const se : usize = @as(usize, tab[q + DL_SE]);
        if (se > ss) {
            const w : usize = lg_put_clean(line[0..200], 0, f, ss, se, 72);
            tg_txt(c, kit, line[0..w], x0 + DV_PAD + 210.0, y + 11.0, 9.0, 0.0, 0.8 * a, 0.0);
        }
        y = y + row_h;
        r = r + 1;
    }
}

// ---- the S petal's SPECS page (#12199) ----
// The page holds no viz logic. t27f_petal_specs_viz answers every box, line, cell, shade, highlight, truth and
// inspector line over its own 1900 x 1000 frame; the fns below only fit that frame into the page area, turn the
// pointer back into frame coordinates, and draw what the petal computed. State: PSV_BYTES bytes at TBO_SV in the text store.

/// Mac key codes the page takes. The digits stay with the petal switch and a cmd chord stays with the shell.
pub const SV_KEY_LEFT : u64 = 123;
pub const SV_KEY_RIGHT : u64 = 124;
pub const SV_KEY_DOWN : u64 = 125;
pub const SV_KEY_UP : u64 = 126;
pub const SV_KEY_SPACE : u64 = 49;
pub const SV_KEY_M : u64 = 46;
pub const SV_KEY_X : u64 = 7;

/// A page extent in whole points, 1..100000 (the petal spec's fit takes unsigned integers).
fn sv_whole(x: f64) -> u32 {
    if (x < 1.0) { return 1; }
    if (x > 100000.0) { return 100000; }
    return @as(u32, @intFromFloat(x));
}

/// The frame-to-points map of one frame: m[0], m[1] the frame's origin on the window, m[2] its scale.
fn sv_map(m: []f64, x0: f64, y0: f64, pw: f64, ph: f64) -> void {
    const pwi : u32 = sv_whole(pw);
    const phi : u32 = sv_whole(ph);
    m[0] = x0 + @as(f64, @floatFromInt(psv_fit_ox(pwi, phi)));
    m[1] = y0 + @as(f64, @floatFromInt(psv_fit_oy(pwi, phi)));
    m[2] = @as(f64, @floatFromInt(psv_fit_scale(pwi, phi))) / 1000.0;
}

/// Frame x and y as window points, and a frame length as points.
fn sv_x(m: []const f64, f: u32) -> f64 { return m[0] + @as(f64, @floatFromInt(f)) * m[2]; }
fn sv_y(m: []const f64, f: u32) -> f64 { return m[1] + @as(f64, @floatFromInt(f)) * m[2]; }
fn sv_l(m: []const f64, f: u32) -> f64 { return @as(f64, @floatFromInt(f)) * m[2]; }

/// A pointer l points from the page's edge as a frame coordinate, for margin o and scale s (thousandths);
/// PSV_NO_PICK outside the page, which no view claims.
fn sv_frame_of(l: f64, o: u32, s: u32) -> u32 {
    if (l < 0.0 or l > 100000.0) { return PSV_NO_PICK; }
    return psv_to_frame(@as(u32, @intFromFloat(l)), o, s);
}

/// The abstract key (PSV_KEY_*) of a Mac key code; PSV_KEY_NONE for every key the page does not name.
fn specs_viz_key_code(key: u64) -> u32 {
    if (key == SV_KEY_LEFT) { return PSV_KEY_LEFT; }
    if (key == SV_KEY_RIGHT) { return PSV_KEY_RIGHT; }
    if (key == SV_KEY_UP) { return PSV_KEY_UP; }
    if (key == SV_KEY_DOWN) { return PSV_KEY_DOWN; }
    if (key == TG_KEY_RETURN) { return PSV_KEY_ACTIVATE; }
    if (key == SV_KEY_SPACE) { return PSV_KEY_TOGGLE; }
    if (key == TG_KEY_BACKSPACE or key == KEY_ESCAPE) { return PSV_KEY_BACK; }
    if (key == KEY_S) { return PSV_KEY_SUM; }
    if (key == SV_KEY_M) { return PSV_KEY_MEAN; }
    if (key == SV_KEY_X) { return PSV_KEY_MAX; }
    return PSV_KEY_NONE;
}

/// True when the petal spec turns this key into an event on the stored state. A key it leaves alone (Escape
/// with nothing selected, an unmapped key) goes on to the shell, so Escape still leaves the petal.
fn specs_viz_key_takes(tb: []const u8, key: u64) -> bool {
    const k : u32 = specs_viz_key_code(key);
    if (k == PSV_KEY_NONE) { return false; }
    const p : PsvState = psv_load_bytes(tb, TBO_SV);
    const x : PsvAct = psv_key_act(p, k);
    return x.ev != PSV_EV_NONE;
}

/// The key through the petal spec's map and reducer, stored; the bump redraws the page.
fn specs_viz_key(tg: []u64, tb: []u8, key: u64) -> void {
    const p : PsvState = psv_load_bytes(tb, TBO_SV);
    psv_store_bytes(tb, TBO_SV, psv_do(p, psv_key_act(p, specs_viz_key_code(key))));
    tg_bump(tg);
}

/// A press at window point (mx, my) on the page area (x0, y0, pw, ph): the petal spec's click map on the
/// stored state, stored back.
fn specs_viz_click(tg: []u64, tb: []u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64) -> void {
    const pwi : u32 = sv_whole(pw);
    const phi : u32 = sv_whole(ph);
    const s : u32 = psv_fit_scale(pwi, phi);
    const g : SpecGraph = psv_graph();
    const p : PsvState = psv_load_bytes(tb, TBO_SV);
    const fx : u32 = sv_frame_of(mx - x0, psv_fit_ox(pwi, phi), s);
    const fy : u32 = sv_frame_of(my - y0, psv_fit_oy(pwi, phi), s);
    psv_store_bytes(tb, TBO_SV, psv_do(p, psv_click_at(g, p, fx, fy)));
    tg_bump(tg);
}

/// The stored state with the pointer's hover applied. The hover is local to one drawn frame and never
/// stored, so a click or a key always starts from the stored state.
fn specs_viz_shown(g: SpecGraph, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64) -> PsvState {
    const pwi : u32 = sv_whole(pw);
    const phi : u32 = sv_whole(ph);
    const s : u32 = psv_fit_scale(pwi, phi);
    const p : PsvState = psv_load_bytes(tb, TBO_SV);
    const fx : u32 = sv_frame_of(mx - x0, psv_fit_ox(pwi, phi), s);
    const fy : u32 = sv_frame_of(my - y0, psv_fit_oy(pwi, phi), s);
    return psv_do(p, psv_hover_at(g, p, fx, fy));
}

/// v / 1000000 with six decimals ("1.000000"), the display form of a trace value.
fn put_fix6(out: []u8, at: usize, v: u64) -> usize {
    var n : usize = put_dec(out, at, v / 1000000);
    n = put_bytes(out, n, ".");
    const frac : u64 = v % 1000000;
    var d : u64 = 100000;
    while (d > 0) {
        n = put_dec(out, n, (frac / d) % 10);
        d = d / 10;
    }
    return n;
}

// ---- the viz palette in the window (owner, 2026-10-25: "we have a black background everywhere") ----
// t27f_viz_contract owns the six colours (VIZ_BG_RGB, VIZ_PANEL_RGB, VIZ_BORDER_RGB, VIZ_INK_RGB, VIZ_MUTED_RGB,
// VIZ_ACCENT_RGB) and the truth colours; every viz page of this window (the S page, the GNN page) draws through the fns
// below and repeats no hex of its own. A role is an 0xRRGGBB value; its alpha is the page's own fade.
// Owner, 2026-10-25, on all cards: no blue-black, it must be #000000. A card (VIZ_PANEL_RGB) is the page's black; the
// neutral grey VIZ_BORDER_RGB (R = G = B) separates it from the page.

/// 0xRRGGBB as the opaque 0xAARRGGBB value that set_fill and chan read.
fn vz_argb(rgb: u32) -> u32 { return 0xFF000000 + rgb; }

/// Fill colour: a palette role at alpha k.
fn vz_fill(c: u64, rgb: u32, k: f64) -> void { set_fill(c, vz_argb(rgb), k); }

/// Stroke colour: a palette role at alpha k.
fn vz_stroke(c: u64, rgb: u32, k: f64) -> void {
    const g : u32 = vz_argb(rgb);
    cg_stroke_rgba(c, chan(g, 0), chan(g, 1), chan(g, 2), k);
}

/// Text in a palette role at alpha `alpha`, clipped at x = right when right > 0; returns the drawn width.
fn vz_txt(c: u64, kit: [48]u64, rgb: u32, s: []const u8, x: f64, y: f64, size: f64, weight: f64, alpha: f64, right: f64) -> f64 {
    if (s.len == 0) { return 0.0; }
    vz_fill(c, rgb, alpha);
    return draw_fit(c, kit, s, s.len, x, y, size, weight, true, right);
}

/// The page's own black over (x0, y0, pw, ph): the palette's background at the matte-glass body alpha of a tile (opaque
/// in the full window and full screen), so a viz page is black whatever the surface under it.
fn vz_ground(c: u64, x0: f64, y0: f64, pw: f64, ph: f64, sw: f64, a: f64) -> void {
    vz_fill(c, VIZ_BG_RGB, tile_body_alpha(sw) * a);
    cg_fill_rect(c, x0, y0, pw, ph);
}

/// A panel rectangle: the palette's panel colour (#000000, the page's own black), told from the page by the neutral grey border.
fn vz_panel(c: u64, x: f64, y: f64, w: f64, h: f64, r: f64, a: f64) -> void {
    vz_fill(c, VIZ_PANEL_RGB, a);
    round_rect(c, x, y, w, h, r);
    cg_fill_path(c);
    vz_stroke(c, VIZ_BORDER_RGB, a);
    cg_line_width(c, 1.0);
    round_rect(c, x, y, w, h, r);
    cg_stroke_path(c);
}

/// Text centred on cx, in palette role `rgb`.
fn sv_center(c: u64, kit: [48]u64, t: []const u8, cx: f64, base: f64, size: f64, weight: f64, rgb: u32, alpha: f64) -> void {
    const w : f64 = bytes_w(kit, t, t.len, size, weight, true);
    vz_txt(c, kit, rgb, t, cx - 0.5 * w, base, size, weight, alpha, 0.0);
}

/// The plate under one box of the frame at (fx, fy, fw, fh): the palette's panel colour.
fn sv_plate(c: u64, m: []const f64, fx: u32, fy: u32, fw: u32, fh: u32, a: f64) -> void {
    vz_fill(c, VIZ_PANEL_RGB, a);
    round_rect(c, sv_x(m, fx), sv_y(m, fy), sv_l(m, fw), sv_l(m, fh), 2.0);
    cg_fill_path(c);
}

/// One box of the frame at (fx, fy, fw, fh), grown by gr points: an accent shade fk over whatever plate lies under it,
/// then a border whose colour, weight and alpha follow the petal's highlight h (none: the neutral grey border token,
/// hover: ink, select and related: accent). The shade is capped by the callers at 0.9; the box text is drawn after it,
/// in the ink.
fn sv_box(c: u64, m: []const f64, fx: u32, fy: u32, fw: u32, fh: u32, fk: f64, h: u8, gr: f64, a: f64) -> void {
    const bx : f64 = sv_x(m, fx) - gr;
    const by : f64 = sv_y(m, fy) - gr;
    const bw : f64 = sv_l(m, fw) + 2.0 * gr;
    const bh : f64 = sv_l(m, fh) + 2.0 * gr;
    if (fk > 0.0) {
        vz_fill(c, VIZ_ACCENT_RGB, fk * a);
        round_rect(c, bx, by, bw, bh, 2.0);
        cg_fill_path(c);
    }
    var lw : f64 = 1.0;
    var ka : f64 = 1.0;
    var bc : u32 = VIZ_BORDER_RGB;
    if (h == VIZ_HL_SELECT) {
        lw = 2.5;
        ka = 1.0;
        bc = VIZ_ACCENT_RGB;
    } else if (h == VIZ_HL_HOVER) {
        lw = 1.8;
        ka = 0.95;
        bc = VIZ_INK_RGB;
    } else if (h == PSV_HL_RELATED) {
        lw = 1.4;
        ka = 0.75;
        bc = VIZ_ACCENT_RGB;
    }
    round_rect(c, bx, by, bw, bh, 2.0);
    cg_line_width(c, lw);
    vz_stroke(c, bc, ka * a);
    cg_stroke_path(c);
}

/// A caption at frame (fx, fy) in palette role `rgb`, clipped at frame x fr when fr > 0.
fn sv_cap(c: u64, kit: [48]u64, m: []const f64, t: []const u8, fx: u32, fy: u32, size: f64, weight: f64, rgb: u32, alpha: f64, fr: u32) -> void {
    var right : f64 = 0.0;
    if (fr > 0) { right = sv_x(m, fr); }
    vz_txt(c, kit, rgb, t, sv_x(m, fx), sv_y(m, fy), size, weight, alpha, right);
}

fn draw_specs_viz_page(c: u64, kit: [48]u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    var mt : [3]f64 = undefined;
    sv_map(mt[0..3], x0, y0, pw, ph);
    const m : []const f64 = mt[0..3];
    var fs : f64 = 13.0 * m[2];
    if (fs < 6.5) { fs = 6.5; }
    vz_ground(c, x0, y0, pw, ph, sw, a);
    // everything below is the petal's answer for this frame, asked once: the graph is 60 KB, so no per-entity calls
    const g : SpecGraph = psv_graph();
    const p : PsvState = specs_viz_shown(g, tb, x0, y0, pw, ph, mx, my);
    const geo : PsvGeom = psv_geom(g);
    const hl : PsvHl = psv_hl_tables(g, p);
    const adj : PsvAdj = psv_adj_table(g, p.mask);
    const tr : PsvTrace = psv_trace_of(g, p);
    const seed : u32 = psv_seed(p);
    const hops : PsvDist = psv_hops_row(g, p.mask, seed);
    const hst : VizHost = psv_host();
    const step : u32 = p.viz.step;
    var line : [200]u8 = undefined;
    // ---- the truth badge: the dot and the word are the state's own, so an edge that is off reads DEMO, plainly
    const bi : usize = @as(usize, PSV_SLOT_BADGE);
    const bx : f64 = sv_x(m, hst.x[bi]);
    const by : f64 = sv_y(m, hst.y[bi]);
    const bw : f64 = sv_l(m, hst.w[bi]);
    const bh : f64 = sv_l(m, hst.h[bi]);
    vz_panel(c, bx, by, bw, bh, TILE_CORNER, a);
    cg_arc(c, bx + 0.07 * bw, by + 0.5 * bh, 0.13 * bh, 0.0, TAU, 0);
    vz_fill(c, viz_truth_rgb(p.viz.truth), a);
    cg_fill_path(c);
    const tname : str = viz_truth_name(p.viz.truth);
    vz_txt(c, kit, VIZ_INK_RGB, tname, bx + 0.14 * bw, by + 0.46 * bh, 1.15 * fs, WEIGHT_BOLD, a, 0.0);
    const eoff : u32 = psv_edges_off(p.mask);
    var bn : usize = 0;
    if (eoff == 0) {
        bn = put_bytes(line[0..200], 0, "every edge on");
    } else {
        bn = put_dec(line[0..200], 0, @as(u64, eoff));
        bn = put_bytes(line[0..200], bn, " edge(s) off: what-if, not the spec");
    }
    vz_txt(c, kit, VIZ_MUTED_RGB, line[0..bn], bx + 0.14 * bw, by + 0.86 * bh, 0.85 * fs, 0.0, a, bx + bw - 3.0);
    // ---- the aggregation choice: sum, mean, max
    var q : u32 = 0;
    while (q < PSV_AGG_COUNT) {
        const qx : u32 = PSV_CHOICE_X + q * PSV_CHOICE_CELL;
        var qk : f64 = 0.0;
        var qh : u8 = VIZ_HL_NONE;
        if (p.viz.param == q) {
            qk = 0.22;
            qh = VIZ_HL_SELECT;
        }
        sv_plate(c, m, qx, PSV_CTRL_Y, PSV_CHOICE_CELL - 6, PSV_CTRL_H, a);
        sv_box(c, m, qx, PSV_CTRL_Y, PSV_CHOICE_CELL - 6, PSV_CTRL_H, qk, qh, 0.0, a);
        const qname : str = PSV_AGG_NAMES[@as(usize, q)];
        sv_center(c, kit, qname, sv_x(m, qx) + 0.5 * sv_l(m, PSV_CHOICE_CELL - 6), sv_y(m, PSV_CTRL_Y) + 0.62 * sv_l(m, PSV_CTRL_H), fs, WEIGHT_BOLD, VIZ_INK_RGB, a);
        q = q + 1;
    }
    // ---- the stepper: PREV, layers 0..4, NEXT
    var sl : u32 = 0;
    while (sl < PSV_STEP_SLOTS) {
        const sx : u32 = PSV_STEP_X + sl * PSV_STEP_CELL;
        var sk : f64 = 0.0;
        var sh : u8 = VIZ_HL_NONE;
        var sn : usize = 0;
        if (sl == 0) {
            sn = put_bytes(line[0..200], 0, "PREV");
        } else if (sl == PSV_STEP_SLOTS - 1) {
            sn = put_bytes(line[0..200], 0, "NEXT");
        } else {
            sn = put_bytes(line[0..200], 0, "L");
            sn = put_dec(line[0..200], sn, @as(u64, sl - 1));
            if (sl - 1 == step) {
                sk = 0.22;
                sh = VIZ_HL_SELECT;
            }
        }
        sv_plate(c, m, sx, PSV_CTRL_Y, PSV_STEP_CELL - 6, PSV_CTRL_H, a);
        sv_box(c, m, sx, PSV_CTRL_Y, PSV_STEP_CELL - 6, PSV_CTRL_H, sk, sh, 0.0, a);
        sv_center(c, kit, line[0..sn], sv_x(m, sx) + 0.5 * sv_l(m, PSV_STEP_CELL - 6), sv_y(m, PSV_CTRL_Y) + 0.62 * sv_l(m, PSV_CTRL_H), fs, 0.0, VIZ_INK_RGB, a);
        sl = sl + 1;
    }
    // ---- the graph: the edges under the boxes (an edge that is off is faint and crossed), then the boxes
    var ej : u32 = 0;
    while (ej < PSV_EDGE_COUNT) {
        const eb : usize = @as(usize, ej);
        const eh : u8 = hl.edge[eb];
        var elw : f64 = 1.2;
        var ea : f64 = 0.8;
        var ec : u32 = VIZ_MUTED_RGB;
        if (eh == VIZ_HL_SELECT) {
            elw = 2.6;
            ea = 1.0;
            ec = VIZ_ACCENT_RGB;
        } else if (eh == VIZ_HL_HOVER) {
            elw = 2.0;
            ea = 0.95;
            ec = VIZ_INK_RGB;
        } else if (eh == PSV_HL_RELATED) {
            elw = 1.6;
            ea = 0.85;
            ec = VIZ_ACCENT_RGB;
        }
        const eon : bool = (p.mask & psv_bit(ej)) != 0;
        if (eon == false) { ea = 0.4 * ea; }
        const ex0 : f64 = sv_x(m, geo.ex0[eb]);
        const ey0 : f64 = sv_y(m, geo.ey0[eb]);
        const ex1 : f64 = sv_x(m, geo.ex1[eb]);
        const ey1 : f64 = sv_y(m, geo.ey1[eb]);
        cg_line_width(c, elw);
        vz_stroke(c, ec, ea * a);
        cg_move(c, ex0, ey0);
        cg_line(c, ex1, ey1);
        cg_stroke_path(c);
        if (eon == false) {
            const exm : f64 = 0.5 * (ex0 + ex1);
            const eym : f64 = 0.5 * (ey0 + ey1);
            cg_line_width(c, 1.4);
            vz_stroke(c, VIZ_MUTED_RGB, 0.9 * a);
            cg_move(c, exm - 3.5, eym - 3.5);
            cg_line(c, exm + 3.5, eym + 3.5);
            cg_move(c, exm - 3.5, eym + 3.5);
            cg_line(c, exm + 3.5, eym - 3.5);
            cg_stroke_path(c);
        }
        ej = ej + 1;
    }
    var nv : u32 = 0;
    while (nv < PSV_NODE_COUNT) {
        const nb : usize = @as(usize, nv);
        // the fill is the petal's own shade of this node's value at the current step, capped so the name stays readable
        const nk : f64 = 0.4 * @as(f64, @floatFromInt(psv_shade(tr, step, nv))) / 255.0;
        sv_plate(c, m, geo.nx[nb], geo.ny[nb], geo.nw[nb], geo.nh[nb], a);
        sv_box(c, m, geo.nx[nb], geo.ny[nb], geo.nw[nb], geo.nh[nb], nk, hl.node[nb], 0.0, a);
        const nname : str = g.node_name[nb];
        vz_txt(c, kit, VIZ_INK_RGB, nname, sv_x(m, geo.nx[nb]) + 4.0, sv_y(m, geo.ny[nb]) + 0.5 * sv_l(m, geo.nh[nb]) + 0.35 * fs, fs, 0.0, a, sv_x(m, geo.nx[nb] + geo.nw[nb]) - 3.0);
        nv = nv + 1;
    }
    // ---- the adjacency matrix: a filled cell is an edge that is on
    sv_cap(c, kit, m, "ADJACENCY", 20, 572, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    var mi : u32 = 0;
    while (mi < PSV_MATRIX_N) {
        var mj : u32 = 0;
        while (mj < PSV_MATRIX_N) {
            var mk : f64 = 0.0;
            if (psv_adj_has(adj, mi, mj)) { mk = 0.5; }
            sv_plate(c, m, psv_cell_x(mi, mj), psv_cell_y(mi, mj), PSV_CELL - 2, PSV_CELL - 2, a);
            sv_box(c, m, psv_cell_x(mi, mj), psv_cell_y(mi, mj), PSV_CELL - 2, PSV_CELL - 2, mk, hl.cell[@as(usize, mi * PSV_STRIDE + mj)], 0.0, a);
            mj = mj + 1;
        }
        mi = mi + 1;
    }
    // ---- the edge list: the gutter checkbox flips an edge, the line selects it
    sv_cap(c, kit, m, "EDGES", PSV_LIST_X, 572, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    var li : u32 = 0;
    while (li < PSV_EDGE_COUNT) {
        const lb : usize = @as(usize, li);
        const lon : bool = (p.mask & psv_bit(li)) != 0;
        const ly : u32 = psv_line_y(li);
        if (hl.edge[lb] != VIZ_HL_NONE) {
            sv_box(c, m, PSV_LIST_X, ly, PSV_LIST_W, PSV_LINE_H - 2, 0.0, hl.edge[lb], 0.0, a);
        }
        var lk : f64 = 0.0;
        if (lon) { lk = 0.7; }
        sv_plate(c, m, PSV_LIST_X + 8, ly + 4, 12, 12, a);
        sv_box(c, m, PSV_LIST_X + 8, ly + 4, 12, 12, lk, PSV_HL_RELATED, 0.0, a);
        var ln : usize = put_bytes(line[0..200], 0, g.node_name[@as(usize, geo.efrom[lb])]);
        ln = put_bytes(line[0..200], ln, " -> ");
        ln = put_bytes(line[0..200], ln, g.node_name[@as(usize, geo.eto[lb])]);
        var lc : u32 = VIZ_INK_RGB;
        var la : f64 = 1.0;
        if (lon == false) {
            lc = VIZ_MUTED_RGB;
            la = 0.7;
        }
        sv_cap(c, kit, m, line[0..ln], PSV_LIST_X + PSV_GUTTER + 4, ly + 15, fs, 0.0, lc, la * a, PSV_LIST_X + PSV_LIST_W - 2);
        li = li + 1;
    }
    // ---- the trace: one row per layer, a cell per node shaded by the petal; the current step's row is boxed
    var tn : usize = put_bytes(line[0..200], 0, "TRACE ");
    tn = put_bytes(line[0..200], tn, PSV_AGG_NAMES[@as(usize, p.viz.param)]);
    if (seed < PSV_NODE_COUNT) {
        tn = put_bytes(line[0..200], tn, " from ");
        tn = put_bytes(line[0..200], tn, g.node_name[@as(usize, seed)]);
    } else {
        tn = put_bytes(line[0..200], tn, " (no seed: click a node)");
    }
    sv_cap(c, kit, m, line[0..tn], PSV_TRACE_X, 572, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, PSV_TRACE_X + PSV_TRACE_W);
    var tk : u32 = 0;
    while (tk <= PSV_LAYERS) {
        const tky : u32 = psv_trace_row_y(tk);
        var tkh : u8 = VIZ_HL_NONE;
        if (tk == step) { tkh = VIZ_HL_SELECT; }
        sv_plate(c, m, PSV_TRACE_X, tky, PSV_TRACE_W, 58, a);
        sv_box(c, m, PSV_TRACE_X, tky, PSV_TRACE_W, 58, 0.0, tkh, 0.0, a);
        var tl : usize = put_bytes(line[0..200], 0, "L");
        tl = put_dec(line[0..200], tl, @as(u64, tk));
        sv_cap(c, kit, m, line[0..tl], PSV_TRACE_X + 10, tky + 24, fs, WEIGHT_BOLD, VIZ_INK_RGB, a, 0);
        var tv : u32 = 0;
        while (tv < PSV_NODE_COUNT) {
            const tk2 : f64 = 0.9 * @as(f64, @floatFromInt(psv_shade(tr, tk, tv))) / 255.0;
            sv_plate(c, m, psv_trace_cell_x(tv), tky + 6, PSV_TRACE_CELL - 2, PSV_TRACE_CELL - 2, a);
            sv_box(c, m, psv_trace_cell_x(tv), tky + 6, PSV_TRACE_CELL - 2, PSV_TRACE_CELL - 2, tk2, hl.node[@as(usize, tv)], 0.0, a);
            tv = tv + 1;
        }
        var tm : usize = put_bytes(line[0..200], 0, "max ");
        tm = put_fix6(line[0..200], tm, psv_layer_max(tr, tk));
        sv_cap(c, kit, m, line[0..tm], PSV_TRACE_X + 60, tky + 50, 0.8 * fs, 0.0, VIZ_MUTED_RGB, a, 0);
        tk = tk + 1;
    }
    // ---- the inspector: the subject (the hovered node, else the seed) and where it lives in the real spec
    const ii : usize = @as(usize, PSV_SLOT_INSPECTOR);
    const ix : u32 = hst.x[ii];
    const iy : u32 = hst.y[ii];
    const ir : u32 = ix + hst.w[ii];
    sv_cap(c, kit, m, "INSPECTOR", ix, 572, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    const sub : u32 = psv_subject(p);
    if (sub >= PSV_NODE_COUNT) {
        sv_cap(c, kit, m, "nothing selected", ix, iy + 28, fs, 0.0, VIZ_INK_RGB, a, ir);
        sv_cap(c, kit, m, "click a node, a matrix cell or an edge line", ix, iy + 54, 0.9 * fs, 0.0, VIZ_MUTED_RGB, a, ir);
    } else {
        sv_cap(c, kit, m, g.node_name[@as(usize, sub)], ix, iy + 28, 1.15 * fs, WEIGHT_BOLD, VIZ_INK_RGB, a, ir);
        var sd : usize = put_bytes(line[0..200], 0, "seed: ");
        if (seed < PSV_NODE_COUNT) {
            sd = put_bytes(line[0..200], sd, g.node_name[@as(usize, seed)]);
        } else {
            sd = put_bytes(line[0..200], sd, "none");
        }
        sv_cap(c, kit, m, line[0..sd], ix, iy + 54, fs, 0.0, VIZ_INK_RGB, a, ir);
        var sv : usize = put_bytes(line[0..200], 0, "value at L");
        sv = put_dec(line[0..200], sv, @as(u64, step));
        sv = put_bytes(line[0..200], sv, " (");
        sv = put_bytes(line[0..200], sv, PSV_AGG_NAMES[@as(usize, p.viz.param)]);
        sv = put_bytes(line[0..200], sv, "): ");
        sv = put_fix6(line[0..200], sv, psv_value(tr, step, sub));
        sv_cap(c, kit, m, line[0..sv], ix, iy + 80, fs, 0.0, VIZ_INK_RGB, a, ir);
        var sp : usize = 0;
        const hop : u32 = hops.d[@as(usize, sub)];
        if (seed >= PSV_NODE_COUNT) {
            sp = put_bytes(line[0..200], 0, "hops: no seed");
        } else if (hop >= PSV_FAR) {
            sp = put_bytes(line[0..200], 0, "hops: unreachable from the seed");
        } else {
            sp = put_bytes(line[0..200], 0, "hops from the seed: ");
            sp = put_dec(line[0..200], sp, @as(u64, hop));
        }
        sv_cap(c, kit, m, line[0..sp], ix, iy + 106, fs, 0.0, VIZ_INK_RGB, a, ir);
        var sf : usize = put_bytes(line[0..200], 0, "lines ");
        sf = put_dec(line[0..200], sf, @as(u64, psv_inspect_line_start(g, sub)));
        sf = put_bytes(line[0..200], sf, "-");
        sf = put_dec(line[0..200], sf, @as(u64, psv_inspect_line_end(g, sub)));
        sf = put_bytes(line[0..200], sf, " of ");
        sf = put_bytes(line[0..200], sf, g.spec_path);
        sv_cap(c, kit, m, line[0..sf], ix, iy + 132, 0.9 * fs, 0.0, VIZ_MUTED_RGB, a, ir);
    }
    sv_cap(c, kit, m, "left/right layer   up/down focus   return open", ix, iy + 300, 0.85 * fs, 0.0, VIZ_MUTED_RGB, a, ir);
    sv_cap(c, kit, m, "space flip edge   S M X sum mean max   esc clear", ix, iy + 322, 0.85 * fs, 0.0, VIZ_MUTED_RGB, a, ir);
    // ---- the keyboard focus ring, on whichever entity the petal's focus order points at
    const fr : u32 = psv_focus_ref(p, p.viz.focus);
    if (fr != VIZ_REF_NONE) {
        const frk : u32 = viz_ref_kind(fr);
        const fri : u32 = viz_ref_index(fr);
        if (frk == VIZ_ENT_NODE and fri < PSV_NODE_COUNT) {
            sv_box(c, m, geo.nx[@as(usize, fri)], geo.ny[@as(usize, fri)], geo.nw[@as(usize, fri)], geo.nh[@as(usize, fri)], 0.0, VIZ_HL_SELECT, 3.0, a);
        } else if (frk == VIZ_ENT_EDGE and fri < PSV_EDGE_COUNT) {
            sv_box(c, m, PSV_LIST_X, psv_line_y(fri), PSV_LIST_W, PSV_LINE_H - 2, 0.0, VIZ_HL_SELECT, 2.0, a);
        } else if (frk == VIZ_ENT_CELL and fri / PSV_STRIDE < PSV_MATRIX_N and fri % PSV_STRIDE < PSV_MATRIX_N) {
            sv_box(c, m, psv_cell_x(fri / PSV_STRIDE, fri % PSV_STRIDE), psv_cell_y(fri / PSV_STRIDE, fri % PSV_STRIDE), PSV_CELL - 2, PSV_CELL - 2, 0.0, VIZ_HL_SELECT, 2.0, a);
        }
    }
    sv_cap(c, kit, m, "SPECS: message passing over a real spec graph; every box, number and shade is computed by t27f_petal_specs_viz", 20, 972, 0.85 * fs, 0.0, VIZ_MUTED_RGB, a, PSV_FRAME_W);
}


// ---- the GNN work-graph page: the MAP petal's page (t27#12370, Refs t27#12173) ----
// t27f_gnn_work_graph_viz answers every box, edge, opacity, outline style, panel line and event over its own 1900 x 1000
// frame, the frame the S page fits; the fns below fit that frame into the page area, turn the pointer back into frame
// coordinates and draw what the spec computed, on the viz palette of t27f_viz_contract (no hex of their own, except the
// node and edge kind colours the spec owns). State: five words of the tg table, written by a click or a key and never by
// a hover. Hover a node and its k-hop neighbourhood lights up; the side panel lists what a k-layer GNN would gather.

/// The five tg words of the page's state. They are single-word gaps of the TPG table (33, 75, 89, 109 and 135 were
/// unused when the page was written). A zero first word means the page was never opened: the state is then gnn_open().
pub const TPG_GNN_0 : u32 = 33;
pub const TPG_GNN_1 : u32 = 75;
pub const TPG_GNN_2 : u32 = 89;
pub const TPG_GNN_3 : u32 = 109;
pub const TPG_GNN_4 : u32 = 135;

/// The stored state of the page: the five words through the spec's gnn_load.
fn gnn_state_get(tg: []const u64) -> VizState {
    var w : [5]u64 = undefined;
    w[0] = tg[TPG_GNN_0];
    w[1] = tg[TPG_GNN_1];
    w[2] = tg[TPG_GNN_2];
    w[3] = tg[TPG_GNN_3];
    w[4] = tg[TPG_GNN_4];
    return gnn_load(w[0..5], 0);
}

/// The state into its five words, through the spec's gnn_store.
fn gnn_state_put(tg: []u64, s: VizState) -> void {
    var w : [5]u64 = undefined;
    gnn_store(w[0..5], 0, s);
    tg[TPG_GNN_0] = w[0];
    tg[TPG_GNN_1] = w[1];
    tg[TPG_GNN_2] = w[2];
    tg[TPG_GNN_3] = w[3];
    tg[TPG_GNN_4] = w[4];
}

/// The stored state with the pointer's hover applied. The hover is local to one drawn frame and never stored, so a click
/// or a key always starts from the stored state.
fn gnn_shown(tg: []const u64, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64) -> VizState {
    const pwi : u32 = sv_whole(pw);
    const phi : u32 = sv_whole(ph);
    const s : u32 = psv_fit_scale(pwi, phi);
    const p : VizState = gnn_state_get(tg);
    const fx : u32 = sv_frame_of(mx - x0, psv_fit_ox(pwi, phi), s);
    const fy : u32 = sv_frame_of(my - y0, psv_fit_oy(pwi, phi), s);
    return gnn_do(p, gnn_hover_at(p, fx, fy));
}

/// A press at window point (mx, my) on the page area (x0, y0, pw, ph): the spec's click map on the stored state, stored
/// back. A press that is no event (outside the frame, empty space with nothing selected) stores and redraws nothing.
fn gnn_page_click(tg: []u64, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64) -> void {
    const pwi : u32 = sv_whole(pw);
    const phi : u32 = sv_whole(ph);
    const s : u32 = psv_fit_scale(pwi, phi);
    const p : VizState = gnn_state_get(tg);
    const fx : u32 = sv_frame_of(mx - x0, psv_fit_ox(pwi, phi), s);
    const fy : u32 = sv_frame_of(my - y0, psv_fit_oy(pwi, phi), s);
    const act : GnnAct = gnn_click_at(p, fx, fy);
    if (act.ev == GNN_EV_NONE) { return; }
    gnn_state_put(tg, gnn_do(p, act));
    tg_bump(tg);
}

/// The abstract key (GNN_KEY_*) of a Mac key code; GNN_KEY_NONE for every key the page does not name. The digits stay
/// with the petal switch (the spec maps them to k, the window does not take them) and a cmd chord stays with the shell.
fn gnn_page_key_code(key: u64) -> u32 {
    if (key == SV_KEY_LEFT) { return GNN_KEY_LEFT; }
    if (key == SV_KEY_RIGHT) { return GNN_KEY_RIGHT; }
    if (key == SV_KEY_UP) { return GNN_KEY_UP; }
    if (key == SV_KEY_DOWN) { return GNN_KEY_DOWN; }
    if (key == TG_KEY_RETURN) { return GNN_KEY_ACTIVATE; }
    if (key == TG_KEY_BACKSPACE or key == KEY_ESCAPE) { return GNN_KEY_BACK; }
    return GNN_KEY_NONE;
}

/// True when the spec turns this key into an event on the stored state. A key it leaves alone (Escape with nothing
/// selected, k already at its end, an unmapped key) goes on to the shell, so Escape still leaves the petal.
fn gnn_page_key_takes(tg: []const u64, key: u64) -> bool {
    const k : u32 = gnn_page_key_code(key);
    if (k == GNN_KEY_NONE) { return false; }
    const x : GnnAct = gnn_key_act(gnn_state_get(tg), k);
    return x.ev != GNN_EV_NONE;
}

/// The key through the spec's map and reducer, stored; the bump redraws the page.
fn gnn_page_key(tg: []u64, key: u64) -> void {
    const p : VizState = gnn_state_get(tg);
    const x : GnnAct = gnn_key_act(p, gnn_page_key_code(key));
    if (x.ev == GNN_EV_NONE) { return; }
    gnn_state_put(tg, gnn_do(p, x));
    tg_bump(tg);
}

/// A frame length (whole units) as a float.
fn gnn_f(x: u32) -> f64 { return @as(f64, @floatFromInt(x)); }

/// A type size, floored so the smallest page still shows legible text.
fn gnn_pt(size: f64) -> f64 {
    if (size < 6.5) { return 6.5; }
    return size;
}

/// The quote byte (34) at `at`; returns the position after it. The page's header line needs two, and a byte is
/// the plainest way to put one into a text buffer.
fn gnn_put_quote(out: []u8, at: usize) -> usize {
    out[at] = 34;
    return at + 1;
}

/// The size at which `s` fits in `room` points: `size` when it already fits, else shrunk in proportion, never below
/// 0.6 of `size` (the drawing clips with an ellipsis past that).
fn gnn_fit_size(kit: [48]u64, s: []const u8, size: f64, weight: f64, room: f64) -> f64 {
    if (s.len == 0 or room <= 0.0) { return size; }
    const w : f64 = bytes_w(kit, s, s.len, size, weight, true);
    if (w <= room) { return size; }
    var k : f64 = room / w;
    if (k < 0.6) { k = 0.6; }
    return size * k;
}

/// Adds the segment (x0, y0) - (x1, y1) to the current path as short dashes: `dash` on, `gap` off. A dash of 0 or less
/// adds the whole segment. The caller sets the colour and the width and strokes the path.
fn gnn_dashes_add(c: u64, x0: f64, y0: f64, x1: f64, y1: f64, dash: f64, gap: f64) -> void {
    if (dash <= 0.0) {
        cg_move(c, x0, y0);
        cg_line(c, x1, y1);
        return;
    }
    const dx : f64 = x1 - x0;
    const dy : f64 = y1 - y0;
    const len : f64 = @sqrt(dx * dx + dy * dy);
    if (len < 0.5) { return; }
    const ux : f64 = dx / len;
    const uy : f64 = dy / len;
    var step : f64 = dash + gap;
    if (step < 1.0) { step = 1.0; }
    var t : f64 = 0.0;
    while (t < len) {
        var e : f64 = t + dash;
        if (e > len) { e = len; }
        cg_move(c, x0 + ux * t, y0 + uy * t);
        cg_line(c, x0 + ux * e, y0 + uy * e);
        t = t + step;
    }
}

/// A dashed line, stroked in the colour and width the caller set.
fn gnn_dashed(c: u64, x0: f64, y0: f64, x1: f64, y1: f64, dash: f64, gap: f64) -> void {
    gnn_dashes_add(c, x0, y0, x1, y1, dash, gap);
    cg_stroke_path(c);
}

/// A dashed rounded-rectangle outline in the colour and width the caller set: four dashed sides, and each corner a solid
/// two-segment polyline through the 45 degree point of the arc it stands for (0.2929 r in from the corner).
fn gnn_dashed_box(c: u64, x: f64, y: f64, w: f64, h: f64, r: f64, dash: f64, gap: f64) -> void {
    const k : f64 = 0.2929 * r;
    cg_move(c, x, y + r);
    cg_line(c, x + k, y + k);
    cg_line(c, x + r, y);
    cg_move(c, x + w - r, y);
    cg_line(c, x + w - k, y + k);
    cg_line(c, x + w, y + r);
    cg_move(c, x + w, y + h - r);
    cg_line(c, x + w - k, y + h - k);
    cg_line(c, x + w - r, y + h);
    cg_move(c, x + r, y + h);
    cg_line(c, x + k, y + h - k);
    cg_line(c, x, y + h - r);
    gnn_dashes_add(c, x + r, y, x + w - r, y, dash, gap);
    gnn_dashes_add(c, x + w, y + r, x + w, y + h - r, dash, gap);
    gnn_dashes_add(c, x + w - r, y + h, x + r, y + h, dash, gap);
    gnn_dashes_add(c, x, y + h - r, x, y + r, dash, gap);
    cg_stroke_path(c);
}

/// A filled arrowhead on the end (x1, y1) of the segment from (x0, y0): the tip 1.6 sc past the end, the base 15.7 sc
/// back, 6.3 sc half-width. The caller sets the fill.
fn gnn_arrow(c: u64, x0: f64, y0: f64, x1: f64, y1: f64, sc: f64) -> void {
    const dx : f64 = x1 - x0;
    const dy : f64 = y1 - y0;
    const len : f64 = @sqrt(dx * dx + dy * dy);
    if (len < 1.0) { return; }
    const ux : f64 = dx / len;
    const uy : f64 = dy / len;
    const hw : f64 = 6.3 * sc;
    const bx : f64 = x1 - ux * 15.7 * sc;
    const by : f64 = y1 - uy * 15.7 * sc;
    cg_move(c, x1 + ux * 1.6 * sc, y1 + uy * 1.6 * sc);
    cg_line(c, bx - uy * hw, by + ux * hw);
    cg_line(c, bx + uy * hw, by - ux * hw);
    cg_close(c);
    cg_fill_path(c);
}

/// The highlight ring of one node box, grown by gr points, on the node's own rounded corners; the colour and weight
/// follow the highlight h as sv_box's border does (select: accent, hover: ink).
fn gnn_ring(c: u64, bx: f64, by: f64, bw: f64, bh: f64, rad: f64, gr: f64, h: u8, a: f64) -> void {
    var lw : f64 = 1.0;
    var ka : f64 = 1.0;
    var bc : u32 = VIZ_BORDER_RGB;
    if (h == VIZ_HL_SELECT) {
        lw = 2.5;
        bc = VIZ_ACCENT_RGB;
    } else if (h == VIZ_HL_HOVER) {
        lw = 1.8;
        ka = 0.95;
        bc = VIZ_INK_RGB;
    }
    round_rect(c, bx - gr, by - gr, bw + 2.0 * gr, bh + 2.0 * gr, rad + gr);
    cg_line_width(c, lw);
    vz_stroke(c, bc, ka * a);
    cg_stroke_path(c);
}

/// One line of the side panel (index i of the spec's panel), shrunk to fit and clipped at the panel's inner edge.
fn gnn_panel_line(c: u64, kit: [48]u64, m: []const f64, i: u32, s: []const u8, weight: f64, rgb: u32, a: f64) -> void {
    const left : f64 = sv_x(m, GNN_PANEL_X + GNN_PANEL_PAD);
    const right : f64 = sv_x(m, GNN_PANEL_X + GNN_PANEL_W - GNN_PANEL_PAD);
    const size : f64 = gnn_pt(gnn_fit_size(kit, s, 15.0 * m[2], weight, right - left));
    vz_txt(c, kit, rgb, s, left, sv_y(m, gnn_panel_line_y(i) + 21), size, weight, a, right);
}

/// The graph: the edges under the nodes, then the nodes. Opacities are the spec's (a node or edge outside the lit
/// neighbourhood is dimmed), outlines solid for an EXACT node and dashed otherwise, edges solid, dotted or dashed by kind.
fn draw_gnn_graph(c: u64, kit: [48]u64, m: []const f64, p: VizState, r: GnnReach, a: f64) -> void {
    const sc : f64 = m[2];
    var line : [200]u8 = undefined;
    var ew : f64 = 2.24 * sc;
    if (ew < 1.0) { ew = 1.0; }
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        const ek : u32 = gnn_edge_kind(j);
        const est : u32 = gnn_ek_style(ek);
        const eop : f64 = gnn_f(gnn_edge_opacity(r, j)) / 1000.0 * a;
        const ex0 : f64 = sv_x(m, gnn_edge_x0(j));
        const ey0 : f64 = sv_y(m, gnn_edge_y0(j));
        const ex1 : f64 = sv_x(m, gnn_edge_x1(j));
        const ey1 : f64 = sv_y(m, gnn_edge_y1(j));
        cg_line_width(c, ew);
        vz_stroke(c, gnn_ek_rgb(ek), eop);
        gnn_dashed(c, ex0, ey0, ex1, ey1, gnn_f(gnn_dash_on(est)) * sc, gnn_f(gnn_dash_off(est)) * sc);
        vz_fill(c, gnn_ek_rgb(ek), eop);
        gnn_arrow(c, ex0, ey0, ex1, ey1, sc);
        j = j + 1;
    }
    var lw : f64 = 1.8 * sc;
    if (lw < 1.0) { lw = 1.0; }
    const rad : f64 = 11.2 * sc;
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        const bx : f64 = sv_x(m, gnn_node_x(v));
        const by : f64 = sv_y(m, gnn_node_y(v));
        const bw : f64 = sv_l(m, GNN_BOX_W);
        const bh : f64 = sv_l(m, GNN_BOX_H);
        const nop : f64 = gnn_f(gnn_node_opacity(r, v)) / 1000.0 * a;
        const nrgb : u32 = gnn_nk_rgb(gnn_node_kind(v));
        // the black body at full alpha first, so an edge never shows through a dimmed node
        vz_fill(c, VIZ_PANEL_RGB, a);
        round_rect(c, bx, by, bw, bh, rad);
        cg_fill_path(c);
        cg_line_width(c, lw);
        vz_stroke(c, nrgb, nop);
        const nst : u32 = gnn_node_style(v);
        if (nst == GNN_ST_SOLID) {
            round_rect(c, bx, by, bw, bh, rad);
            cg_stroke_path(c);
        } else {
            gnn_dashed_box(c, bx, by, bw, bh, rad, gnn_f(gnn_dash_on(nst)) * sc, gnn_f(gnn_dash_off(nst)) * sc);
        }
        const nname : str = gnn_node_name(v);
        const nsz : f64 = gnn_pt(gnn_fit_size(kit, nname, 16.0 * sc, 0.0, bw - 8.0 * sc));
        sv_center(c, kit, nname, bx + 0.5 * bw, by + 21.6 * sc, nsz, 0.0, VIZ_INK_RGB, nop);
        var ln : usize = put_bytes(line[0..200], 0, gnn_node_kind_name(v));
        ln = put_bytes(line[0..200], ln, " ");
        ln = put_bytes(line[0..200], ln, gnn_node_id(v));
        const isz : f64 = gnn_pt(gnn_fit_size(kit, line[0..ln], 13.6 * sc, 0.0, bw - 8.0 * sc));
        sv_center(c, kit, line[0..ln], bx + 0.5 * bw, by + 40.0 * sc, isz, 0.0, VIZ_MUTED_RGB, nop);
        const nhl : u8 = gnn_node_hl(p, v);
        if (nhl != VIZ_HL_NONE) {
            gnn_ring(c, bx, by, bw, bh, rad, 3.0, nhl, a);
        }
        v = v + 1;
    }
    // the keyboard focus ring, on the node the spec's focus order points at
    const fnode : u32 = gnn_ref_node(gnn_focus_ref(p, p.focus));
    if (fnode != GNN_NO_NODE) {
        gnn_ring(c, sv_x(m, gnn_node_x(fnode)), sv_y(m, gnn_node_y(fnode)), sv_l(m, GNN_BOX_W), sv_l(m, GNN_BOX_H), rad, 5.0, VIZ_HL_SELECT, a);
    }
}

/// Line 0 of the side panel for the subject node v at depth k, into `out` (the page's wording, from the spec's pieces):
/// gather for KIND "name id" at k = K:
fn gnn_head_line(out: []u8, v: u32, k: u32) -> usize {
    var n : usize = put_bytes(out, 0, GNN_T_GATHER);
    n = put_bytes(out, n, gnn_node_kind_name(v));
    n = put_bytes(out, n, " ");
    n = gnn_put_quote(out, n);
    n = put_bytes(out, n, gnn_node_name(v));
    n = put_bytes(out, n, " ");
    n = put_bytes(out, n, gnn_node_id(v));
    n = gnn_put_quote(out, n);
    n = put_bytes(out, n, GNN_T_AT_K);
    n = put_dec(out, n, @as(u64, k));
    return put_bytes(out, n, ":");
}

/// The line of hop h (1..K) of the side panel: `  hop H: name, name`, or `(none)` when no node is exactly h hops away.
fn gnn_hop_line(out: []u8, r: GnnReach, h: u32) -> usize {
    var n : usize = put_bytes(out, 0, GNN_T_HOP);
    n = put_dec(out, n, @as(u64, h));
    n = put_bytes(out, n, ": ");
    const cnt : u32 = gnn_hop_count(r, h);
    if (cnt == 0) {
        return put_bytes(out, n, GNN_T_NONE);
    }
    var j : u32 = 0;
    while (j < cnt) {
        if (j > 0) { n = put_bytes(out, n, ", "); }
        n = put_bytes(out, n, gnn_node_name(gnn_hop_node(r, h, j)));
        j = j + 1;
    }
    return n;
}

/// The first closing line of the side panel: `after K message-passing layer(s), this node's embedding`; plural past one.
fn gnn_after_line(out: []u8, k: u32) -> usize {
    var n : usize = put_bytes(out, 0, GNN_T_AFTER);
    n = put_dec(out, n, @as(u64, k));
    n = put_bytes(out, n, GNN_T_LAYER);
    if (k > 1) { n = put_bytes(out, n, GNN_T_PLURAL); }
    return put_bytes(out, n, GNN_T_EMBED);
}

/// The side panel: the gather text of the subject node at depth k, or the idle hint. Every line is the spec's wording.
fn draw_gnn_panel(c: u64, kit: [48]u64, m: []const f64, p: VizState, r: GnnReach, a: f64) -> void {
    vz_panel(c, sv_x(m, GNN_PANEL_X), sv_y(m, GNN_PANEL_Y), sv_l(m, GNN_PANEL_W), sv_l(m, GNN_PANEL_H), TILE_CORNER, a);
    var line : [400]u8 = undefined;
    const sub : u32 = gnn_subject(p);
    if (sub == GNN_NO_NODE) {
        var i : u32 = 0;
        while (i < GNN_IDLE_COUNT) {
            var irgb : u32 = VIZ_MUTED_RGB;
            if (i < 4) { irgb = VIZ_INK_RGB; }
            const itext : str = GNN_IDLE_LINES[@as(usize, i)];
            gnn_panel_line(c, kit, m, i, itext, 0.0, irgb, a);
            i = i + 1;
        }
        return;
    }
    const kk : u32 = gnn_k(p);
    var n : usize = gnn_head_line(line[0..400], sub, kk);
    gnn_panel_line(c, kit, m, 0, line[0..n], WEIGHT_BOLD, VIZ_INK_RGB, a);
    var h : u32 = 1;
    while (h <= kk) {
        n = gnn_hop_line(line[0..400], r, h);
        gnn_panel_line(c, kit, m, h, line[0..n], 0.0, VIZ_INK_RGB, a);
        h = h + 1;
    }
    n = gnn_after_line(line[0..400], kk);
    gnn_panel_line(c, kit, m, kk + 1, line[0..n], 0.0, VIZ_MUTED_RGB, a);
    gnn_panel_line(c, kit, m, kk + 2, GNN_T_AGG, 0.0, VIZ_MUTED_RGB, a);
}

/// The legend: a row of node kinds (a black swatch outlined in the kind colour), a row of edge kinds (a sample line with
/// its arrowhead, styled as the edges are), and the outline row (solid EXACT, dashed DERIVED or UNKNOWN) with the keys.
fn draw_gnn_legend(c: u64, kit: [48]u64, m: []const f64, fs: f64, a: f64) -> void {
    const sc : f64 = m[2];
    vz_panel(c, sv_x(m, GNN_LEGEND_X), sv_y(m, GNN_LEGEND_Y), sv_l(m, GNN_LEGEND_W), sv_l(m, GNN_LEGEND_H), TILE_CORNER, a);
    const ry0 : u32 = GNN_LEG_ROW_Y[@as(usize, 0)];
    const ry1 : u32 = GNN_LEG_ROW_Y[@as(usize, 1)];
    const ry2 : u32 = GNN_LEG_ROW_Y[@as(usize, 2)];
    sv_cap(c, kit, m, "NODES", GNN_LEGEND_X + 14, ry0 + 15, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    sv_cap(c, kit, m, "EDGES", GNN_LEGEND_X + 14, ry1 + 15, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    sv_cap(c, kit, m, "OUTLINE", GNN_LEGEND_X + 14, ry2 + 15, 0.85 * fs, WEIGHT_BOLD, VIZ_MUTED_RGB, a, 0);
    var lw : f64 = 1.8 * sc;
    if (lw < 1.0) { lw = 1.0; }
    var ew : f64 = 2.24 * sc;
    if (ew < 1.0) { ew = 1.0; }
    var i : u32 = 0;
    while (i < GNN_NK_COUNT) {
        const lx : u32 = GNN_LEG_X0 + i * GNN_LEG_STEP;
        vz_fill(c, VIZ_PANEL_RGB, a);
        round_rect(c, sv_x(m, lx), sv_y(m, ry0), sv_l(m, 30), sv_l(m, GNN_LEG_ITEM_H), 4.0 * sc);
        cg_fill_path(c);
        cg_line_width(c, lw);
        vz_stroke(c, gnn_nk_rgb(i), a);
        round_rect(c, sv_x(m, lx), sv_y(m, ry0), sv_l(m, 30), sv_l(m, GNN_LEG_ITEM_H), 4.0 * sc);
        cg_stroke_path(c);
        sv_cap(c, kit, m, GNN_NK_NAMES[@as(usize, i)], lx + 40, ry0 + 15, fs, 0.0, VIZ_INK_RGB, a, 0);
        i = i + 1;
    }
    var e : u32 = 0;
    while (e < GNN_EK_COUNT) {
        const lx : u32 = GNN_LEG_X0 + e * GNN_LEG_STEP;
        const est : u32 = gnn_ek_style(e);
        const sx0 : f64 = sv_x(m, lx);
        const sx1 : f64 = sv_x(m, lx + 34);
        const sy : f64 = sv_y(m, ry1 + GNN_LEG_ITEM_H / 2);
        cg_line_width(c, ew);
        vz_stroke(c, gnn_ek_rgb(e), a);
        gnn_dashed(c, sx0, sy, sx1, sy, gnn_f(gnn_dash_on(est)) * sc, gnn_f(gnn_dash_off(est)) * sc);
        vz_fill(c, gnn_ek_rgb(e), a);
        gnn_arrow(c, sx0, sy, sx1, sy, 0.5 * sc);
        sv_cap(c, kit, m, GNN_EK_NAMES[@as(usize, e)], lx + 48, ry1 + 15, fs, 0.0, VIZ_INK_RGB, a, 0);
        e = e + 1;
    }
    cg_line_width(c, lw);
    vz_stroke(c, VIZ_INK_RGB, a);
    round_rect(c, sv_x(m, GNN_LEG_X0), sv_y(m, ry2), sv_l(m, 30), sv_l(m, GNN_LEG_ITEM_H), 4.0 * sc);
    cg_stroke_path(c);
    sv_cap(c, kit, m, "EXACT", GNN_LEG_X0 + 40, ry2 + 15, fs, 0.0, VIZ_INK_RGB, a, 0);
    const dst : u32 = GNN_ST_OUTLINE;
    gnn_dashed_box(c, sv_x(m, GNN_LEG_X0 + GNN_LEG_STEP), sv_y(m, ry2), sv_l(m, 30), sv_l(m, GNN_LEG_ITEM_H), 4.0 * sc, gnn_f(gnn_dash_on(dst)) * sc, gnn_f(gnn_dash_off(dst)) * sc);
    sv_cap(c, kit, m, "DERIVED / UNKNOWN", GNN_LEG_X0 + GNN_LEG_STEP + 40, ry2 + 15, fs, 0.0, VIZ_INK_RGB, a, 0);
    sv_cap(c, kit, m, "left/right k   up/down focus   return select   esc clear", 760, ry2 + 15, 0.85 * fs, 0.0, VIZ_MUTED_RGB, a, GNN_LEGEND_X + GNN_LEGEND_W - 10);
}

/// The page: the black ground, the truth badge, the k control, then the graph, the side panel and the legend.
fn draw_gnn_page(c: u64, kit: [48]u64, tg: []const u64, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, a: f64) -> void {
    var mt : [3]f64 = undefined;
    sv_map(mt[0..3], x0, y0, pw, ph);
    const m : []const f64 = mt[0..3];
    const fs : f64 = gnn_pt(13.0 * m[2]);
    vz_ground(c, x0, y0, pw, ph, sw, a);
    const p : VizState = gnn_shown(tg, x0, y0, pw, ph, mx, my);
    const r : GnnReach = gnn_reach_of(p);
    const hst : VizHost = gnn_host();
    // ---- the truth badge: the dot and the word are the state's own, so a fixture reads DEMO, plainly
    const bi : usize = @as(usize, GNN_SLOT_BADGE);
    const bx : f64 = sv_x(m, hst.x[bi]);
    const by : f64 = sv_y(m, hst.y[bi]);
    const bw : f64 = sv_l(m, hst.w[bi]);
    const bh : f64 = sv_l(m, hst.h[bi]);
    vz_panel(c, bx, by, bw, bh, TILE_CORNER, a);
    cg_arc(c, bx + 0.07 * bw, by + 0.5 * bh, 0.13 * bh, 0.0, TAU, 0);
    vz_fill(c, viz_truth_rgb(p.truth), a);
    cg_fill_path(c);
    const tname : str = viz_truth_name(p.truth);
    vz_txt(c, kit, VIZ_INK_RGB, tname, bx + 0.14 * bw, by + 0.46 * bh, 1.15 * fs, WEIGHT_BOLD, a, 0.0);
    vz_txt(c, kit, VIZ_MUTED_RGB, "fixture, not a fetch", bx + 0.14 * bw, by + 0.86 * bh, 0.85 * fs, 0.0, a, bx + bw - 3.0);
    // ---- the k control: k = 1, 2, 3
    var q : u32 = 0;
    while (q < GNN_K_MAX) {
        const qx : u32 = GNN_CHOICE_X + q * GNN_CHOICE_CELL;
        var qk : f64 = 0.0;
        var qh : u8 = VIZ_HL_NONE;
        if (p.param == q) {
            qk = 0.22;
            qh = VIZ_HL_SELECT;
        }
        sv_plate(c, m, qx, GNN_CTRL_Y, GNN_CHOICE_CELL - 6, GNN_CTRL_H, a);
        sv_box(c, m, qx, GNN_CTRL_Y, GNN_CHOICE_CELL - 6, GNN_CTRL_H, qk, qh, 0.0, a);
        const qname : str = GNN_K_NAMES[@as(usize, q)];
        sv_center(c, kit, qname, sv_x(m, qx) + 0.5 * sv_l(m, GNN_CHOICE_CELL - 6), sv_y(m, GNN_CTRL_Y) + 0.62 * sv_l(m, GNN_CTRL_H), fs, WEIGHT_BOLD, VIZ_INK_RGB, a);
        q = q + 1;
    }
    sv_cap(c, kit, m, "hover a node: its k-hop neighbourhood lights up", 720, 36, fs, 0.0, VIZ_MUTED_RGB, a, GNN_FRAME_W - 20);
    draw_gnn_graph(c, kit, m, p, r, a);
    draw_gnn_panel(c, kit, m, p, r, a);
    draw_gnn_legend(c, kit, m, fs, a);
}


// ---- G: the AGENTS page (t27os#3) -- this agent, the swarm, the Queen's ledger, in real time ----

/// The swarm feed text into the AGENTS region: the same file the HIVE page reads (devices.t27 owns the format
/// and the join decisions). The length drops a cut last line, so the parsers only ever see whole records.
fn ag_load(tg: []u64, tb: []u8, hb: []const u8) -> void {
    const n : usize = tg_read(hb, DV_DIR, DV_FILE, tb[TBO_AGENTS .. TBO_AGENTS + TBO_AGENTS_N]);
    tg[TPG_AG_LEN] = @as(u64, tg_whole_lines(tb, TBO_AGENTS, n));
}

/// The feed job (dv_feed_cmd, the HIVE page's own job) every PERIOD_AGENTS while the page is open, and its
/// reap. COUPLING, honestly: the petal menu shows one page at a time, so this tick and hive_tick never each run
/// a job at once, and the feed file the two share is written by whichever of them is open. Until the first job
/// of this page lands, it renders whatever the HIVE page last fetched (the header shows that feed's age).
fn ag_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_AG_LOADED] == 0) {
        ag_load(tg, tb, hb);
        tg[TPG_AG_LOADED] = 1;
        tg_bump(tg);
    }
    if (tg[TPG_AG_PID] != 0) {
        if (tg_done(tg[TPG_AG_PID]) == 0) {
            tg_late(now, tg[TPG_AG_START], tg[TPG_AG_PID]);
        } else {
            tg[TPG_AG_PID] = 0;
            ag_load(tg, tb, hb);
            tg_bump(tg);
        }
    } else if (page_feed_due(PAGE_AGENTS, open, now, tg[TPG_AG_LAST])) {
        tg[TPG_AG_LAST] = now;
        const rn : usize = @as(usize, tg[TPG_Q_ROOTLEN]);
        if (rn > 0 and root_safe(tb[TBO_ROOT .. TBO_ROOT + rn])) {
            const w : usize = dv_feed_cmd(hb, tb[TBO_ROOT .. TBO_ROOT + rn], tb[TBO_CMD + 6 .. TBO_ROOT]);
            if (w > 0) {
                const pid : u64 = tg_spawn(tb, TBO_CMD, TBO_CMD + 6 + w);
                if (pid != 0) {
                    tg[TPG_AG_PID] = pid;
                    tg[TPG_AG_START] = now;
                }
            }
        }
    }
}

/// One lane row (the light dot, then "#issue  MODEL  elapsed" of dv_lane_text) at (lx, ly); the HIVE card's row.
fn ag_lane_row(c: u64, kit: [48]u64, lanes: []const u8, i: u32, lx: f64, ly: f64, right: f64, a: f64) -> void {
    var row_line : [160]u8 = undefined;
    const lg : u32 = dv_lane_field(lanes, i, 2);
    if (lg != DV_NM) { draw_light_dot(c, lx + 4.0, ly + 4.5, lg, a); }
    const ln : usize = dv_lane_text(lanes, i, row_line[0..160]);
    tg_txt(c, kit, row_line[0..ln], lx + 14.0, ly + 8.0, 8.5, WEIGHT_SEMIBOLD, a, right);
}

fn draw_agents_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const f : []const u8 = tb[TBO_AGENTS .. TBO_AGENTS + @as(usize, tg[TPG_AG_LEN])];
    var tab : [24]u32 = undefined;
    const nh : u32 = dv_hosts(f, tab[0..24]);
    var led : [DC_MAX * DC_F]u32 = undefined;
    const nc : u32 = dv_claims(f, led[0 .. DC_MAX * DC_F]);
    var line : [160]u8 = undefined;
    // ---- header: the title, the swarm in numbers, the age of the feed itself
    plate(c, x0 + DV_PAD, y0 + 2.0, pw - 2.0 * DV_PAD, DV_HEAD_H - 4.0, sw, a);
    tg_txt(c, kit, "AGENTS", x0 + DV_PAD + 10.0, y0 + 16.0, 10.5, WEIGHT_BOLD, a, 0.0);
    // this machine is host 0 when the feed carries its Z record; the others are the swarm
    const local : bool = nh > 0 and tab[DH_LOCAL] == 1;
    var nrem : u32 = nh;
    if (local) { nrem = nh - 1; }
    var hn : usize = put_dec(line[0..160], 0, @as(u64, nrem));
    hn = put_bytes(line[0..160], hn, " in the swarm, ");
    hn = put_dec(line[0..160], hn, @as(u64, nc));
    hn = put_bytes(line[0..160], hn, " claims   ");
    const sl : usize = dv_nth(f, 83, 0);
    if (sl == DV_NONE) {
        hn = put_bytes(line[0..160], hn, "feed n/m (first read in progress)");
    } else {
        const sle : usize = dv_line_end(f, sl);
        const sep : u32 = dv_num(f, dv_fstart(f, sl, sle, 1), sle);
        hn = put_bytes(line[0..160], hn, "feed ");
        hn = hn + dv_age_text(now, @as(u64, sep), line[hn .. 160]);
    }
    tg_txt(c, kit, line[0..hn], x0 + DV_PAD + 66.0, y0 + 15.0, 8.0, 0.0, 0.6 * a, x0 + pw - DV_PAD - 8.0);
    if (nh == 0 and nc == 0 and tg[TPG_AG_PID] == 0 and tg[TPG_AG_LEN] == 0) {
        tg_txt(c, kit, "no feed yet -- the first job runs while this page is open", x0 + DV_PAD + 10.0, y0 + DV_HEAD_H + 18.0, 9.0, 0.0, 0.6 * a, 0.0);
        return;
    }
    // ---- section 1: THIS AGENT -- what this machine is doing now (its lanes, its queue)
    const ty : f64 = y0 + ag_this_y();
    plate(c, x0 + DV_PAD, ty, pw - 2.0 * DV_PAD, AG_THIS_H, sw, a);
    tg_txt(c, kit, "THIS AGENT", x0 + DV_PAD + 10.0, ty + 15.0, 7.5, WEIGHT_SEMIBOLD, 0.55 * a, 0.0);
    // the heartbeat age sits right-aligned on the label line, clear of the name below it
    var an_w : usize = put_bytes(line[0..160], 0, "heartbeat ");
    if (local) {
        an_w = an_w + dv_age_text(now, @as(u64, tab[DH_SEEN]), line[an_w .. 160]);
    } else {
        an_w = put_bytes(line[0..160], an_w, "n/m (no Z record)");
    }
    const anw : f64 = bytes_w(kit, line[0..an_w], an_w, 7.5, 0.0, true);
    tg_txt(c, kit, line[0..an_w], x0 + pw - DV_PAD - 4.0 - anw, ty + 15.0, 7.5, 0.0, 0.55 * a, 0.0);
    if (local) {
        const st : u32 = dv_host_state(now, tab[0..24], 0);
        var ka : f64 = a;
        if (st != DS_ONLINE) { ka = 0.6 * a; }
        hv_dot(c, x0 + DV_PAD + 14.0, ty + 30.0, st == DS_ONLINE, ka);
        tg_txt(c, kit, f[@as(usize, tab[DH_NS]) .. @as(usize, tab[DH_NE])], x0 + DV_PAD + 26.0, ty + 34.0, 11.0, WEIGHT_BOLD, ka, x0 + pw - DV_PAD - 4.0);
    } else {
        tg_txt(c, kit, "this machine", x0 + DV_PAD + 26.0, ty + 34.0, 11.0, WEIGHT_BOLD, a, x0 + pw - DV_PAD - 4.0);
    }
    // the lanes this machine runs now: the window's own field (kept fresh while this page is open, hive_lanes)
    const lt : usize = @as(usize, tg[TPG_H_LANES_LEN]);
    const lanes : []const u8 = tb[TBO_HLANES .. TBO_HLANES + lt];
    const lnn : u32 = dv_lane_n(lanes);
    if (lnn == 0) {
        tg_txt(c, kit, "no lane running", x0 + DV_PAD + 26.0, ty + 50.0, 8.0, 0.0, 0.5 * a, x0 + pw - DV_PAD - 4.0);
    } else {
        var lr : u32 = 0;
        while (lr < lnn and lr < 3) {
            ag_lane_row(c, kit, lanes, lr, x0 + DV_PAD + 18.0, ty + 42.0 + @as(f64, @floatFromInt(lr)) * 12.0, x0 + pw - DV_PAD - 4.0, a);
            lr = lr + 1;
        }
        if (lnn > 3) {
            var mn : usize = put_bytes(line[0..160], 0, "+");
            mn = put_dec(line[0..160], mn, @as(u64, lnn - 3));
            mn = put_bytes(line[0..160], mn, " more");
            tg_txt(c, kit, line[0..mn], x0 + pw - DV_PAD - 70.0, ty + 42.0 + 24.0, 8.0, 0.0, 0.6 * a, x0 + pw - DV_PAD - 4.0);
        }
    }
    // the queue state, from the feed's G records
    var qn : usize = put_bytes(line[0..160], 0, "trigit queue ");
    const qv : u32 = dv_g(f, "queue");
    if (qv == DV_NM) { qn = put_bytes(line[0..160], qn, "n/m"); } else { qn = put_dec(line[0..160], qn, @as(u64, qv)); }
    qn = put_bytes(line[0..160], qn, ", unpushed ");
    const uv : u32 = dv_g(f, "unpushed");
    if (uv == DV_NM) { qn = put_bytes(line[0..160], qn, "n/m"); } else { qn = put_dec(line[0..160], qn, @as(u64, uv)); }
    qn = put_bytes(line[0..160], qn, ", last push ");
    const sv : u32 = dv_g(f, "since");
    if (sv == DV_NM) { qn = put_bytes(line[0..160], qn, "n/m"); } else { qn = put_dec(line[0..160], qn, @as(u64, sv)); qn = put_bytes(line[0..160], qn, " min ago"); }
    tg_txt(c, kit, line[0..qn], x0 + DV_PAD + 26.0, ty + AG_THIS_H - 10.0, 8.0, 0.0, 0.7 * a, x0 + pw - DV_PAD - 4.0);
    // ---- section 2: THE SWARM -- one card per other agent: alive, its lanes, the lanes it pushed
    tg_txt(c, kit, "THE SWARM -- who is doing what, right now", x0 + DV_PAD + 2.0, y0 + ag_swarm_label_y() + 11.0, 8.0, WEIGHT_SEMIBOLD, 0.7 * a, 0.0);
    const fit : u32 = ag_cards_fit(nrem, pw, ph);
    var pui : [AG_PUSH_MAX]u32 = undefined;
    var k : u32 = 0;
    while (k < fit) {
        var i : u32 = k;
        if (local) { i = k + 1; }
        const cx : f64 = x0 + dv_card_x(k, pw);
        const cy : f64 = y0 + ag_card_y(k, pw);
        const cw : f64 = dv_card_w(pw);
        const r : usize = @as(usize, i) * DH_F;
        const st : u32 = dv_host_state(now, tab[0..24], i);
        var ka : f64 = a;
        if (st != DS_ONLINE) { ka = 0.6 * a; }
        plate(c, cx, cy, cw, AG_CARD_H, sw, a);
        hv_dot(c, cx + 14.0, cy + 14.0, st == DS_ONLINE, ka);
        tg_txt(c, kit, f[@as(usize, tab[r + DH_NS]) .. @as(usize, tab[r + DH_NE])], cx + 26.0, cy + 18.0, 11.0, WEIGHT_BOLD, ka, cx + cw - 78.0);
        const sw2 : usize = put_bytes(line[0..160], 0, DS_WORDS[st]);
        tg_txt(c, kit, line[0..sw2], cx + cw - 8.0 - bytes_w(kit, line[0..sw2], sw2, 8.0, WEIGHT_BOLD, true), cy + 17.0, 8.0, WEIGHT_BOLD, ka, 0.0);
        var an_x : usize = put_bytes(line[0..160], 0, "heartbeat ");
        an_x = an_x + dv_age_text(now, @as(u64, tab[r + DH_SEEN]), line[an_x .. 160]);
        tg_txt(c, kit, line[0..an_x], cx + 10.0, cy + 30.0, 7.5, 0.0, 0.55 * ka, cx + cw - 10.0);
        // its current lanes: the heartbeat's own field (dv_remote_lanes_*)
        const rs : usize = dv_remote_lanes_at(f, tab[0..24], i);
        if (rs == DV_NONE) {
            tg_txt(c, kit, "lanes n/m (no heartbeat)", cx + 10.0, cy + 46.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
        } else {
            const lanes2 : []const u8 = f[rs .. dv_remote_lanes_end(f, tab[0..24], i, rs)];
            const l2 : u32 = dv_lane_n(lanes2);
            if (l2 == 0) {
                tg_txt(c, kit, "no lane running", cx + 10.0, cy + 46.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
            } else {
                var lr : u32 = 0;
                while (lr < l2 and lr < 2) {
                    ag_lane_row(c, kit, lanes2, lr, cx + 6.0, cy + 40.0 + @as(f64, @floatFromInt(lr)) * 12.0, cx + cw - 10.0, ka);
                    lr = lr + 1;
                }
                if (l2 > 2) {
                    var mn : usize = put_bytes(line[0..160], 0, "+");
                    mn = put_dec(line[0..160], mn, @as(u64, l2 - 2));
                    mn = put_bytes(line[0..160], mn, " more");
                    tg_txt(c, kit, line[0..mn], cx + cw - 60.0, cy + 40.0 + 24.0, 8.0, 0.0, 0.6 * ka, cx + cw - 10.0);
                }
            }
        }
        // the lanes it pushed (B records naming it)
        const pn : u32 = dv_pushed_issues(f, tab[0..24], i, pui[0..AG_PUSH_MAX]);
        if (pn == 0) {
            tg_txt(c, kit, "pushed: none", cx + 10.0, cy + AG_CARD_H - 10.0, 7.5, 0.0, 0.45 * ka, cx + cw - 10.0);
        } else {
            var pw2 : usize = put_bytes(line[0..160], 0, "pushed:");
            var pk : u32 = 0;
            while (pk < pn) {
                pw2 = put_bytes(line[0..160], pw2, " #");
                pw2 = put_dec(line[0..160], pw2, @as(u64, pui[@as(usize, pk)]));
                pk = pk + 1;
            }
            tg_txt(c, kit, line[0..pw2], cx + 10.0, cy + AG_CARD_H - 10.0, 7.5, 0.0, 0.7 * ka, cx + cw - 10.0);
        }
        k = k + 1;
    }
    if (nrem == 0) {
        tg_txt(c, kit, "no other agent has published a heartbeat or pushed a lane yet", x0 + DV_PAD + 10.0, y0 + ag_cards_y() + 14.0, 8.0, 0.0, 0.5 * a, x0 + pw - DV_PAD);
    }
    // ---- section 3: THE QUEEN'S LEDGER -- every claim, and who holds it
    tg_txt(c, kit, "THE QUEEN'S LEDGER -- what was assigned and to whom", x0 + DV_PAD + 2.0, y0 + ag_ledger_label_y(fit, pw) + 11.0, 8.0, WEIGHT_SEMIBOLD, 0.7 * a, 0.0);
    const ly : f64 = y0 + ag_ledger_y(fit, pw);
    const rows : u32 = ag_ledger_fit(ag_ledger_y(fit, pw), ph);
    if (rows == 0 and nc > 0) {
        tg_txt(c, kit, "no room for the ledger rows on this page", x0 + DV_PAD + 10.0, ly + 10.0, 8.0, 0.0, 0.5 * a, x0 + pw - DV_PAD);
        return;
    }
    var q : u32 = 0;
    while (q < nc and q < rows) {
        const row : usize = @as(usize, q) * DC_F;
        const ry : f64 = ly + @as(f64, @floatFromInt(q)) * AG_ROW_H;
        var wn : usize = put_bytes(line[0..160], 0, "#");
        wn = put_dec(line[0..160], wn, @as(u64, led[row + DC_ISSUE]));
        const held : u32 = led[row + DC_STATE];
        if (held == DC_HELD) {
            // the issue and the prefix first, then the holder's name straight from the feed range
            wn = put_bytes(line[0..160], wn, "  held by ");
            const pre : f64 = bytes_w(kit, line[0..wn], wn, 9.0, 0.0, true);
            tg_txt(c, kit, line[0..wn], x0 + DV_PAD + 10.0, ry + 10.0, 9.0, 0.0, a, 0.0);
            tg_txt(c, kit, f[@as(usize, led[row + DC_HS]) .. @as(usize, led[row + DC_HE])], x0 + DV_PAD + 10.0 + pre + 4.0, ry + 10.0, 9.0, WEIGHT_SEMIBOLD, a, x0 + pw - DV_PAD - 4.0);
        } else if (held == DC_PUSHED) {
            wn = put_bytes(line[0..160], wn, "  lane pushed, holder unknown");
            tg_txt(c, kit, line[0..wn], x0 + DV_PAD + 10.0, ry + 10.0, 9.0, 0.0, a, x0 + pw - DV_PAD - 4.0);
        } else {
            wn = put_bytes(line[0..160], wn, "  open -- no lane pushed yet");
            tg_txt(c, kit, line[0..wn], x0 + DV_PAD + 10.0, ry + 10.0, 9.0, 0.0, 0.65 * a, x0 + pw - DV_PAD - 4.0);
        }
        q = q + 1;
    }
    if (nc > rows) {
        var mn : usize = put_bytes(line[0..160], 0, "+");
        mn = put_dec(line[0..160], mn, @as(u64, nc - rows));
        mn = put_bytes(line[0..160], mn, " more claims");
        tg_txt(c, kit, line[0..mn], x0 + DV_PAD + 10.0, ly + @as(f64, @floatFromInt(rows)) * AG_ROW_H + 10.0, 8.0, 0.0, 0.6 * a, x0 + pw - DV_PAD);
    }
    if (nc == 0) {
        tg_txt(c, kit, "no claim on origin right now -- the ledger is empty", x0 + DV_PAD + 10.0, ly + 10.0, 8.0, 0.0, 0.5 * a, x0 + pw - DV_PAD);
    }
}


/// The pinned agents of widget w as chips at (x, y), owner first and bold (the kanban card's chips).
fn hv_chips(c: u64, kit: [48]u64, w: u32, x: f64, y: f64, a: f64) -> void {
    var k : u32 = 0;
    while (k < dw_agents(w)) {
        const l : u32 = dw_agent(w, k);
        const chx : f64 = x + @as(f64, @floatFromInt(k)) * 19.0;
        round_rect(c, chx, y, 17.0, 13.0, 3.0);
        cg_line_width(c, 1.0);
        var ka : f64 = 0.3;
        if (k == 0) { ka = 0.7; }
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
        cg_stroke_path(c);
        var wgt : f64 = 0.0;
        if (k == 0) { wgt = WEIGHT_BOLD; }
        if (l >= 1 and l <= 27) { tg_txt(c, kit, AGENT_LETTERS[l - 1], chx + 4.0, y + 10.0, 8.5, wgt, a, 0.0); }
        k = k + 1;
    }
}

/// A chip group with its tiny label ("ID", "RES", "LANES"), the widths of dw_agents; returns the x after it.
fn hv_group(c: u64, kit: [48]u64, label: []const u8, w: u32, x: f64, y: f64, a: f64) -> f64 {
    const lw : f64 = tg_txt(c, kit, label, x, y + 10.0, 6.5, 0.0, 0.5 * a, 0.0);
    hv_chips(c, kit, w, x + lw + 4.0, y, a);
    return x + lw + 4.0 + @as(f64, @floatFromInt(dw_agents(w))) * 19.0 + 8.0;
}

fn hv_dot(c: u64, x: f64, y: f64, lit: bool, a: f64) -> void {
    if (lit) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.95 * a);
        cg_arc(c, x, y, 3.5, 0.0, 6.283185307, 0);
        cg_fill_path(c);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.45 * a);
        cg_arc(c, x, y, 3.5, 0.0, 6.283185307, 0);
        cg_stroke_path(c);
    }
}

fn draw_hive_page(c: u64, kit: [48]u64, tg: []const u64, tb: []const u8, x0: f64, y0: f64, pw: f64, ph: f64, mx: f64, my: f64, sw: f64, full: bool, a: f64, now: u64) -> void {
    const f : []const u8 = tb[TBO_HIVE .. TBO_HIVE + @as(usize, tg[TPG_H_LEN])];
    var tab : [24]u32 = undefined;
    const nh : u32 = dv_hosts(f, tab[0..24]);
    var line : [160]u8 = undefined;
    const latest : u32 = dv_latest_build(f);
    // ---- TRI NET header: the title, where the data comes from, how many machines are alive
    plate(c, x0 + DV_PAD, y0 + 2.0, pw - 2.0 * DV_PAD, DV_HEAD_H - 4.0, sw, a);
    tg_txt(c, kit, "TRI NET", x0 + DV_PAD + 10.0, y0 + 16.0, 10.5, WEIGHT_BOLD, a, 0.0);
    var online : u32 = 0;
    var hi : u32 = 0;
    while (hi < nh) {
        if (dv_host_state(now, tab[0..24], hi) == DS_ONLINE) { online = online + 1; }
        hi = hi + 1;
    }
    var hn : usize = dv_put_dec_hv(line[0..160], 0, nh);
    hn = put_bytes(line[0..160], hn, " machines, ");
    hn = put_dec(line[0..160], hn, @as(u64, online));
    hn = put_bytes(line[0..160], hn, " online   ");
    const sl : usize = dv_nth(f, 83, 0);
    if (sl == DV_NONE) {
        hn = put_bytes(line[0..160], hn, "feed n/m (first read in progress)");
    } else {
        const sle : usize = dv_line_end(f, sl);
        const sep : u32 = dv_num(f, dv_fstart(f, sl, sle, 1), sle);
        hn = put_bytes(line[0..160], hn, "feed ");
        hn = hn + dv_age_text(now, @as(u64, sep), line[hn .. 160]);
    }
    tg_txt(c, kit, line[0..hn], x0 + DV_PAD + 70.0, y0 + 15.0, 8.0, 0.0, 0.6 * a, x0 + pw - DV_PAD - 80.0);
    hv_chips(c, kit, DW_HEAD, x0 + pw - DV_PAD - 8.0 - 3.0 * 19.0, y0 + 5.0, a);
    // ---- the flow strip: claimed -> lane pushed -> trigit landed -> batch pushed -> merged
    var si : u32 = 0;
    while (si < FS_COUNT) {
        const fx : f64 = x0 + dv_flow_x(si, pw);
        const fy : f64 = y0 + dv_flow_y();
        const fw : f64 = dv_flow_w(pw);
        const v : u32 = dv_stage_value(f, si);
        plate(c, fx, fy, fw, DV_FLOW_H, sw, a);
        tg_txt(c, kit, FS_NAMES[si], fx + 8.0, fy + 13.0, 7.5, WEIGHT_SEMIBOLD, 0.7 * a, fx + fw - 22.0);
        hv_dot(c, fx + fw - 12.0, fy + 10.0, dv_stage_lit(v), a);
        var vn : usize = 0;
        var vsz : f64 = 20.0;
        if (v == DV_NM) { vn = put_bytes(line[0..160], 0, "n/m"); vsz = 12.0; } else { vn = put_dec(line[0..160], 0, @as(u64, v)); }
        tg_txt(c, kit, line[0..vn], fx + 8.0, fy + 38.0, vsz, WEIGHT_HEAVY, a, fx + fw - 8.0);
        const sn : usize = dv_stage_sub(f, si, line[0..160]);
        tg_txt(c, kit, line[0..sn], fx + 8.0, fy + 52.0, 6.5, 0.0, 0.55 * a, fx + fw - 8.0);
        hv_chips(c, kit, DW_CLAIMED + si, fx + fw - 8.0 - 3.0 * 19.0, fy + 20.0, a);
        if (si + 1 < FS_COUNT) {
            const ax : f64 = fx + fw + 4.0;
            const ay : f64 = fy + 0.5 * DV_FLOW_H;
            cg_line_width(c, 1.2);
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, 0.55 * a);
            cg_move(c, ax, ay - 5.0);
            cg_line(c, ax + 7.0, ay);
            cg_line(c, ax, ay + 5.0);
            cg_stroke_path(c);
        }
        si = si + 1;
    }
    // ---- one card per machine
    const fit : u32 = dv_cards_fit(nh, pw, ph);
    const lt : usize = @as(usize, tg[TPG_H_LANES_LEN]);
    var ci : u32 = 0;
    while (ci < fit) {
        const cx : f64 = x0 + dv_card_x(ci, pw);
        const cy : f64 = y0 + dv_card_y(ci, nh, pw, ph);
        const cw : f64 = dv_card_w(pw);
        const chh : f64 = dv_card_h(nh, pw, ph);
        const r : usize = @as(usize, ci) * DH_F;
        const st : u32 = dv_host_state(now, tab[0..24], ci);
        var ka : f64 = a;
        if (st != DS_ONLINE) { ka = 0.6 * a; }
        plate(c, cx, cy, cw, chh, sw, a);
        const ns : usize = @as(usize, tab[r + DH_NS]);
        const ne : usize = @as(usize, tab[r + DH_NE]);
        hv_dot(c, cx + 14.0, cy + 14.0, st == DS_ONLINE, ka);
        tg_txt(c, kit, f[ns .. ne], cx + 26.0, cy + 18.0, 11.0, WEIGHT_BOLD, ka, cx + cw - 110.0);
        const sw2 : usize = put_bytes(line[0..160], 0, DS_WORDS[st]);
        const sww : f64 = bytes_w(kit, line[0..sw2], sw2, 8.0, WEIGHT_BOLD, true);
        tg_txt(c, kit, line[0..sw2], cx + cw - 10.0 - sww, cy + 17.0, 8.0, WEIGHT_BOLD, ka, 0.0);
        var an_y : usize = put_bytes(line[0..160], 0, "heartbeat ");
        an_y = an_y + dv_age_text(now, @as(u64, tab[r + DH_SEEN]), line[an_y .. 160]);
        if (tab[r + DH_LOCAL] == 1) { an_y = put_bytes(line[0..160], an_y, "   (this machine)"); }
        tg_txt(c, kit, line[0..an_y], cx + 10.0, cy + 30.0, 7.5, 0.0, 0.55 * ka, cx + cw - 10.0);
        const idn : usize = dv_ident_text(f, tab[0..24], ci, latest, line[0..160]);
        tg_txt(c, kit, line[0..idn], cx + 10.0, cy + 44.0, 8.5, WEIGHT_SEMIBOLD, ka, cx + cw - 10.0);
        const tn : usize = dv_tools_text(f, tab[0..24], ci, line[0..160]);
        tg_txt(c, kit, line[0..tn], cx + 10.0, cy + 56.0, 8.0, 0.0, 0.7 * ka, cx + cw - 10.0);
        // the three meters
        var mi : u32 = 0;
        while (mi < RES_COUNT) {
            const mxp : f64 = cx + 10.0 + @as(f64, @floatFromInt(mi)) * (dv_meter_w(cw) + DV_GAP);
            const val : u32 = dv_host_num(f, tab[0..24], ci, RES_KEYS[mi]);
            tg_txt(c, kit, RES_LABELS[mi], mxp, cy + 68.0, 7.0, 0.0, 0.55 * ka, mxp + dv_meter_w(cw));
            const mn : usize = dv_res_text(val, mi, line[0..160]);
            tg_txt(c, kit, line[0..mn], mxp, cy + 81.0, 11.0, WEIGHT_HEAVY, ka, mxp + dv_meter_w(cw));
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.2 * ka);
            cg_fill_rect(c, mxp, cy + 85.0, dv_meter_w(cw), 2.5);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * ka);
            cg_fill_rect(c, mxp, cy + 85.0, dv_meter_w(cw) * @as(f64, @floatFromInt(dv_res_fill(val, mi))) / 1000.0, 2.5);
            mi = mi + 1;
        }
        // the lanes running on this machine: its own rows for this machine, the heartbeat's field for the others
        var ls0 : usize = 0;
        var le0 : usize = 0;
        var lsrc : u32 = 0;
        if (tab[r + DH_LOCAL] == 1) {
            lsrc = 1;
        } else {
            const rs : usize = dv_remote_lanes_at(f, tab[0..24], ci);
            if (rs != DV_NONE) { ls0 = rs; le0 = dv_remote_lanes_end(f, tab[0..24], ci, rs); lsrc = 2; }
        }
        var lanes : []const u8 = f[0..0];
        if (lsrc == 1) { lanes = tb[TBO_HLANES .. TBO_HLANES + lt]; }
        if (lsrc == 2) { lanes = f[ls0 .. le0]; }
        const ln : u32 = dv_lane_n(lanes);
        const rows : u32 = dv_lane_rows(chh);
        if (lsrc == 0) {
            tg_txt(c, kit, "lanes n/m (no heartbeat)", cx + 10.0, cy + DV_LANE_Y + 9.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
        } else if (ln == 0) {
            tg_txt(c, kit, "no lane running", cx + 10.0, cy + DV_LANE_Y + 9.0, 8.0, 0.0, 0.5 * ka, cx + cw - 10.0);
        } else {
            var lr : u32 = 0;
            while (lr < ln and lr < rows) {
                const ly : f64 = cy + DV_LANE_Y + @as(f64, @floatFromInt(lr)) * DV_LANE_H;
                if (lr + 1 == rows and ln > rows) {
                    var mn2 : usize = put_bytes(line[0..160], 0, "+");
                    mn2 = put_dec(line[0..160], mn2, @as(u64, ln - lr));
                    mn2 = put_bytes(line[0..160], mn2, " more");
                    tg_txt(c, kit, line[0..mn2], cx + 24.0, ly + 9.0, 8.0, 0.0, 0.6 * ka, cx + cw - 10.0);
                } else {
                    const lg : u32 = dv_lane_field(lanes, lr, 2);
                    if (lg != DV_NM) { draw_light_dot(c, cx + 14.0, ly + 5.5, lg, ka); }
                    const lnn : usize = dv_lane_text(lanes, lr, line[0..160]);
                    tg_txt(c, kit, line[0..lnn], cx + 24.0, ly + 9.0, 8.5, WEIGHT_SEMIBOLD, ka, cx + cw - 10.0);
                }
                lr = lr + 1;
            }
        }
        // the pinned agents of the card's three widgets
        var gx : f64 = cx + 10.0;
        gx = hv_group(c, kit, "ID", DW_MACHINE, gx, cy + chh - DV_CHIP_STRIP, ka);
        gx = hv_group(c, kit, "RES", DW_RESOURCES, gx, cy + chh - DV_CHIP_STRIP, ka);
        hv_group(c, kit, "LANES", DW_LANES, gx, cy + chh - DV_CHIP_STRIP, ka);
        ci = ci + 1;
    }
    if (nh == 0) {
        tg_txt(c, kit, "no machine yet: the first feed read has not finished (n/m)", x0 + DV_PAD + 10.0, y0 + dv_flow_y() + DV_FLOW_H + 40.0, 9.0, 0.0, 0.6 * a, x0 + pw - DV_PAD);
    }
}

fn dv_put_dec_hv(out: []u8, at: usize, v: u32) -> usize { return put_dec(out, at, @as(u64, v)); }

// ---- O: the formula orbit around the home logo (placement and hit: formula_orbit.t27; decisions: orbit_view.t27) ----

/// The stage the orbit lives on: the window below the title bar. Its centre is the logo's.
fn orb_stage_h(sh: f64) -> f64 { return sh - AREA_TOP; }

/// The orbit stores its i64 layout in u64 words. @intCast of a negative i64 to u64, or of a word above i64 max to i64
/// (a neighbour's data), is EXC_BREAKPOINT and takes the app down, so the store and the load clamp instead: a
/// negative coordinate is stored as 0 and a word above i64 max is read as 0. The same pair on both sides keeps a
/// value that is in range exactly as it was (orb_r(orb_w(v)) == v for v >= 0).
fn orb_w(v: i64) -> u64 {
    if (v < 0) { return 0; }
    return @as(u64, @intCast(v));
}

fn orb_r(w: u64) -> i64 {
    if (w > 0x7FFFFFFFFFFFFFFF) { return 0; }
    return @as(i64, @intCast(w));
}

/// The number of formulas on the orbit: the word, never more than the 32 slots the arrays hold.
fn orb_n(w: u64) -> usize {
    if (w > @as(u64, OV_MAX)) { return OV_MAX; }
    return @as(usize, w);
}

/// One frame of the orbit: re-layout when the stage or the logo changed, advance the clock (slower near the pointer; still for
/// reduced motion). The slots are ellipses around the logo (orbit_view.t27); the turn is clockwise on screen.
fn orbit_tick(tg: []u64, z: f64, sw: f64, sh: f64, mx: f64, my: f64, a_now: f64, rm: bool) -> void {
    const lh : f64 = home_px(z, sw, sh);
    const lw : f64 = lh * (logo_edge(0, true) - logo_edge(0, false)) / (logo_edge(1, true) - logo_edge(1, false));
    const r : i64 = ov_logo_r(@as(i64, @intFromFloat(lw)), @as(i64, @intFromFloat(lh)));
    const stw : i64 = @as(i64, @intFromFloat(sw));
    const sth : i64 = @as(i64, @intFromFloat(orb_stage_h(sh)));
    const key : u64 = ov_key(stw, sth, r);
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    var i : usize = 0;
    while (i < 32) { ra[i] = 0; rb[i] = 0; rp[i] = 0; i = i + 1; }
    if (tg[TPG_O_KEY] != key) {
        const n : usize = ov_layout(stw / 2, sth / 2, stw, sth, r, OV_MAX, ra[0..32], rb[0..32], rp[0..32]);
        i = 0;
        while (i < n) {
            tg[TPG_O_HX + @as(u32, @intCast(i))] = orb_w(ra[i]);
            tg[TPG_O_HY + @as(u32, @intCast(i))] = orb_w(rb[i]);
            tg[TPG_O_HP + @as(u32, @intCast(i))] = orb_w(rp[i]);
            i = i + 1;
        }
        tg[TPG_O_N] = @as(u64, n);
        tg[TPG_O_KEY] = key;
        tg[TPG_O_SEL] = 0;
    }
    const n2 : usize = orb_n(tg[TPG_O_N]);
    i = 0;
    while (i < n2) {
        ra[i] = orb_r(tg[TPG_O_HX + @as(u32, @intCast(i))]);
        rb[i] = orb_r(tg[TPG_O_HY + @as(u32, @intCast(i))]);
        rp[i] = orb_r(tg[TPG_O_HP + @as(u32, @intCast(i))]);
        i = i + 1;
    }
    const now_ms : i64 = @as(i64, @intFromFloat(a_now * 1000.0));
    var dt : i64 = 0;
    if (tg[TPG_O_LAST] != 0) { dt = now_ms - orb_r(tg[TPG_O_LAST]); }
    tg[TPG_O_LAST] = orb_w(now_ms);
    const clock : i64 = orb_r(tg[TPG_O_CLOCK]);
    const px : i64 = @as(i64, @intFromFloat(mx));
    const py : i64 = @as(i64, @intFromFloat(my - AREA_TOP));
    const gap : i64 = ov_nearest_gap(stw / 2, sth / 2, ra[0..32], rb[0..32], rp[0..32], n2, ov_theta(clock, rm), px, py);
    tg[TPG_O_CLOCK] = orb_w(ov_clock_step(clock, dt, time_scale_permille(gap), rm));
    tg[TPG_O_RM] = 0;
    if (rm) { tg[TPG_O_RM] = 1; }
}

fn orbit_load(tg: []const u64, ra: []i64, rb: []i64, rp: []i64) -> void {
    const n : usize = orb_n(tg[TPG_O_N]);
    var i : usize = 0;
    while (i < 32) { ra[i] = 0; rb[i] = 0; rp[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) {
        ra[i] = orb_r(tg[TPG_O_HX + @as(u32, @intCast(i))]);
        rb[i] = orb_r(tg[TPG_O_HY + @as(u32, @intCast(i))]);
        rp[i] = orb_r(tg[TPG_O_HP + @as(u32, @intCast(i))]);
        i = i + 1;
    }
}

/// The formula under the pointer (index), or -1. The stage is sw wide and sh - AREA_TOP tall; the logo is its centre.
fn orbit_pick(tg: []const u64, mx: f64, my: f64, sw: f64, sh: f64) -> i64 {
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    orbit_load(tg, ra[0..32], rb[0..32], rp[0..32]);
    const theta : i64 = ov_theta(orb_r(tg[TPG_O_CLOCK]), tg[TPG_O_RM] != 0);
    return ov_hit(@as(i64, @intFromFloat(sw / 2.0)), @as(i64, @intFromFloat(orb_stage_h(sh) / 2.0)), ra[0..32], rb[0..32], rp[0..32], orb_n(tg[TPG_O_N]), theta, @as(i64, @intFromFloat(mx)), @as(i64, @intFromFloat(my - AREA_TOP)));
}

/// What the orbit puts on screen, as a frame key part: every label's whole-point position and the hovered one.
/// The drift moves a label by a point a few times a second, so the window draws when one moves, not every sixtieth.
fn orbit_key(tg: []const u64, mx: f64, my: f64, sw: f64, sh: f64) -> u64 {
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    orbit_load(tg, ra[0..32], rb[0..32], rp[0..32]);
    const theta : i64 = ov_theta(orb_r(tg[TPG_O_CLOCK]), tg[TPG_O_RM] != 0);
    const ccx : i64 = @as(i64, @intFromFloat(sw / 2.0));
    const ccy : i64 = @as(i64, @intFromFloat(orb_stage_h(sh) / 2.0));
    const n : usize = orb_n(tg[TPG_O_N]);
    var k : u64 = orb_w(orbit_pick(tg, mx, my, sw, sh) + 1);
    var i : usize = 0;
    while (i < n) {
        k = fg_mix(fg_mix(k, orb_w(ov_pos_x(ccx, ra[i], rp[i], theta))), orb_w(ov_pos_y(ccy, rb[i], rp[i], theta)));
        i = i + 1;
    }
    return k;
}

/// The orbit: only the formulas, white text, no frame, each turning clockwise on its ellipse; the hovered one is brighter
/// and underlined. A click opens the card with the name, value, error and sector.
fn orbit_draw(c: u64, kit: [48]u64, tg: []const u64, mx: f64, my: f64, sw: f64, sh: f64, full: bool, a: f64) -> void {
    const n : usize = orb_n(tg[TPG_O_N]);
    if (n == 0) { return; }
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    orbit_load(tg, ra[0..32], rb[0..32], rp[0..32]);
    const theta : i64 = ov_theta(orb_r(tg[TPG_O_CLOCK]), tg[TPG_O_RM] != 0);
    const ccx : i64 = @as(i64, @intFromFloat(sw / 2.0));
    const ccy : i64 = @as(i64, @intFromFloat(orb_stage_h(sh) / 2.0));
    const hot : i64 = orbit_pick(tg, mx, my, sw, sh);
    var line : [64]u8 = undefined;
    var i : usize = 0;
    while (i < n) {
        const x : f64 = @as(f64, @floatFromInt(ov_pos_x(ccx, ra[i], rp[i], theta)));
        const y : f64 = @as(f64, @floatFromInt(ov_pos_y(ccy, rb[i], rp[i], theta))) + AREA_TOP;
        const ln : usize = ov_label(@as(u32, @intCast(i)), line[0..64]);
        const tw : f64 = bytes_w(kit, line[0..ln], ln, 11.0, WEIGHT_SEMIBOLD, true);
        var al : f64 = 0.9;
        if (hot == @as(i64, @intCast(i))) { al = 1.0; }
        tg_txt(c, kit, line[0..ln], x - 0.5 * tw, y + 4.0, 11.0, WEIGHT_SEMIBOLD, al * a, 0.0);
        if (hot == @as(i64, @intCast(i))) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.9 * a);
            cg_fill_rect(c, x - 0.5 * tw, y + 7.0, tw, 1.0);
        }
        i = i + 1;
    }
    // the card of the formula that was clicked: centred on the stage, any click closes it
    if (tg[TPG_O_SEL] != 0) {
        const fi : u32 = @as(u32, @intCast(tg[TPG_O_SEL] - 1));
        const stw : i64 = @as(i64, @intFromFloat(sw));
        const sth : i64 = @as(i64, @intFromFloat(orb_stage_h(sh)));
        const kx : f64 = @as(f64, @floatFromInt(orb_card_x(stw)));
        const ky : f64 = @as(f64, @floatFromInt(orb_card_y(sth))) + AREA_TOP;
        const kw : f64 = @as(f64, @floatFromInt(orb_card_w(stw)));
        const kh : f64 = @as(f64, @floatFromInt(orb_card_h(sth)));
        var card_line : [96]u8 = undefined;
        plate(c, kx, ky, kw, kh, sw, a);
        const nn : usize = ov_field(fi, OF_NAME, card_line[0..96]);
        tg_txt(c, kit, card_line[0..nn], kx + 20.0, ky + 36.0, 17.0, WEIGHT_BOLD, a, kx + kw - 20.0);
        const en : usize = ov_card_line(fi, 0, card_line[0..96]);
        tg_txt(c, kit, card_line[0..en], kx + 20.0, ky + 64.0, 11.5, 0.0, 0.9 * a, kx + kw - 20.0);
        const vn : usize = ov_card_line(fi, 1, card_line[0..96]);
        tg_txt(c, kit, card_line[0..vn], kx + 20.0, ky + 104.0, 22.0, WEIGHT_HEAVY, a, kx + kw - 20.0);
        const sn : usize = ov_card_line(fi, 2, card_line[0..96]);
        tg_txt(c, kit, card_line[0..sn], kx + 20.0, ky + 134.0, 10.5, WEIGHT_SEMIBOLD, 0.8 * a, kx + kw - 20.0);
        tg_txt(c, kit, "VERIFIED against the measured value (error shown signed)", kx + 20.0, ky + 156.0, 8.5, 0.0, 0.6 * a, kx + kw - 20.0);
        var k : u32 = 0;
        while (k < 3) {
            const chx : f64 = kx + 20.0 + @as(f64, @floatFromInt(k)) * 19.0;
            const chy : f64 = ky + kh - 30.0;
            round_rect(c, chx, chy, 17.0, 13.0, 3.0);
            cg_line_width(c, 1.0);
            var ka : f64 = 0.3;
            if (k == 0) { ka = 0.7; }
            cg_stroke_rgba(c, 1.0, 1.0, 1.0, ka * a);
            cg_stroke_path(c);
            var wgt : f64 = 0.0;
            if (k == 0) { wgt = WEIGHT_BOLD; }
            tg_txt(c, kit, AGENT_LETTERS[OV_AGENTS[k] - 1], chx + 4.0, chy + 10.0, 8.5, wgt, a, 0.0);
            k = k + 1;
        }
        tg_txt(c, kit, "click anywhere to close", kx + kw - 150.0, ky + kh - 20.0, 8.0, 0.0, 0.5 * a, kx + kw - 10.0);
    }
}

/// The page of letter kind `kind` in the content area of a home tab (below the header, right of the sidebar).
fn draw_tool_page(c: u64, kit: [48]u64, kind: u32, tg: []const u64, tb: []const u8, cx: f64, sw: f64, sh: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    const x0 : f64 = cx;
    const y0 : f64 = home_view_top();
    const pw : f64 = sw - cx;
    const ph : f64 = home_view_h(sh);
    const now : u64 = tg[TPG_NOW];
    if (kind == PAGE_BENCH) { draw_bench_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_KANBAN) { draw_kanban_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_QUEEN) { draw_queen_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_HIVE) { draw_hive_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_LOGS) { draw_logs_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_AGENTS) { draw_agents_page(c, kit, tg, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_VIZ_SPECS) { draw_specs_viz_page(c, kit, tb, x0, y0, pw, ph, mx, my, sw, full, a, now); }
    if (kind == PAGE_VIZ_GNN) { draw_gnn_page(c, kit, tg, x0, y0, pw, ph, mx, my, sw, a); }
}

// ---- the key-light dot (owner directive gHashTag/t27#11314) ----
// A traffic-light dot on each agent pane header and one in the sidebar foot next to KEYS: the worst light of the
// running agent panes (red > yellow > green). The rule (keys.t27 light_of / worst_light, the listing field `light`)
// lives in the keys lane; this file only draws a light value it is given. Until that lane is merged the adapters
// below answer LIGHT_NONE, which draws no dot. The dot is the one colour signal allowed here, small, on glass.
pub const LIGHT_NONE : u32 = 0;
pub const LIGHT_GREEN : u32 = 1;
pub const LIGHT_YELLOW : u32 = 2;
pub const LIGHT_RED : u32 = 3;
pub const LIGHT_DOT_R : f64 = 3.5;

/// Adapter: the light of server pane `pane` (keys lane: the `light` field of the listing). Wire at merge.
pub fn pane_light_input(pane: u32) -> u32 { return LIGHT_NONE; }

/// Adapter: the worst light over the running agent panes (keys lane: worst_light). Wire at merge.
pub fn foot_light_input() -> u32 { return LIGHT_NONE; }

/// Red outranks yellow outranks green; none is the weakest.
pub fn light_worse(a: u32, b: u32) -> u32 {
    if (a > LIGHT_RED) { return b; }
    if (b > LIGHT_RED) { return a; }
    if (a >= b) { return a; }
    return b;
}

/// An editor pane has no dot; any other pane shows its light.
pub fn dot_light(is_editor: bool, light: u32) -> u32 {
    if (is_editor or light > LIGHT_RED) { return LIGHT_NONE; }
    return light;
}

pub fn dot_visible(light: u32) -> bool { return light >= LIGHT_GREEN and light <= LIGHT_RED; }

/// Colour channel k (0 r, 1 g, 2 b) of the dot.
pub fn light_chan(light: u32, k: u32) -> f64 {
    if (light == LIGHT_GREEN) { if (k == 0) { return 0.30; } if (k == 1) { return 0.85; } return 0.40; }
    if (light == LIGHT_YELLOW) { if (k == 0) { return 0.98; } if (k == 1) { return 0.78; } return 0.20; }
    if (light == LIGHT_RED) { if (k == 0) { return 0.95; } if (k == 1) { return 0.27; } return 0.25; }
    return 0.0;
}

fn draw_light_dot(c: u64, x: f64, y: f64, light: u32, a: f64) -> void {
    if (dot_visible(light) == false) { return; }
    cg_fill_rgba(c, light_chan(light, 0), light_chan(light, 1), light_chan(light, 2), 0.95 * a);
    cg_arc(c, x, y, LIGHT_DOT_R, 0.0, 6.283185307, 0);
    cg_fill_path(c);
}

// ---- the QUEEN CONTROL DASHBOARD (queen_dash.t27): the page the sidebar's Queen row opens ----
// Layout, hit codes, texts and parsing are queen_dash.t27; this block reads the files, spawns the feed job and draws.
pub const TPG_QD_PLANN : u32 = 244;
pub const TPG_QD_TRIGN : u32 = 245;
pub const TPG_QD_BOARDN : u32 = 246; // reserve: the RAILWAY QUEEN BOARD tile left, the slot number is kept so the mirrors of the saved state keep their numbering
pub const TPG_QD_HIVEN : u32 = 247;
pub const TPG_QD_PID : u32 = 248;
pub const TPG_QD_LAST : u32 = 249;
pub const TPG_QD_FLAGS : u32 = 250;
pub const SST_QDASH : usize = 559;
pub const TBO_QD : usize = 71936;
pub const TBO_QD_PLAN : usize = 71936;
pub const TBO_QD_TRIG : usize = 73472;
pub const TBO_QD_BOARD : usize = 74496; // reserve: the 256 bytes of the left board.txt tile stay, so the chain below and TBO_PF at 76800 never move
pub const TBO_QD_HIVE : usize = 74752;
pub const QD_PLAN_CAP : usize = 1536;
pub const QD_TRIG_CAP : usize = 1024;
pub const QD_BOARD_CAP : usize = 256;
pub const QD_HIVE_CAP : usize = 2048;
pub const QD_HIVE_DIR : str = "/.t27os/hive/";
pub const QD_HIVE_FILE : str = "feed.txt";
pub const QD_HEADS : [5]str = ["ISSUE", "MODEL", "HOST", "STATE", "ELAPSED"];

/// The page's rectangle: the content area of the chat screen from the top of the workspace to the footer.
pub fn qd_area_x(ws: u32, collapsed: bool) -> f64 { return content_x(ws, collapsed); }
pub fn qd_area_w(sw: f64, ws: u32, collapsed: bool, panel: bool) -> f64 { return content_w(sw, ws, collapsed, panel); }
pub fn qd_area_h(sh: f64) -> f64 { return sh - WS_TOP - SB_H; }
pub fn qd_open(sst: []const u32, screen: bool, ws: u32) -> bool { return screen and sst[SST_QDASH] != 0 and ws != WS_COMPACT; }
pub fn on_qd_area(x: f64, y: f64, sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> bool {
    const l : f64 = qd_area_x(ws, collapsed);
    return x >= l and x < l + qd_area_w(sw, ws, collapsed, panel) and y >= WS_TOP and y < WS_TOP + qd_area_h(sh);
}

/// The k-th row of the lanes table that is work (a pane or a script lane, not a group header); LV_NONE past the last.
fn qd_lane_index(sst: []const u32, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < sst[SST_LVN] and i < 64) {
        const src : u32 = sst[SST_LV + (i as usize) * LV_F + LVF_SRC];
        if ((src == LV_PANE or src == LV_SCRIPT) and sst[SST_LV + (i as usize) * LV_F + LVF_DEPTH] != LV_GROUP_DEPTH) {
            if (seen == k) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return LV_NONE;
}
fn qd_lane_total(sst: []const u32) -> u32 {
    var k : u32 = 0;
    while (qd_lane_index(sst, k) != LV_NONE) { k = k + 1; }
    return k;
}

/// The feed job and the reads of the files others write under ~/.t27os/queen and of the hive feed.
fn qd_read(tg: []u64, tb: []u8, hb: []const u8) -> void {
    tg[TPG_QD_PLANN] = tg_read(hb, QD_QDIR, QD_FILE_PLAN, tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP]) as u64;
    tg[TPG_QD_TRIGN] = tg_read(hb, QD_QDIR, QD_FILE_TRIGIT, tb[TBO_QD_TRIG .. TBO_QD_TRIG + QD_TRIG_CAP]) as u64;
    tg[TPG_QD_HIVEN] = tg_read(hb, QD_HIVE_DIR, QD_HIVE_FILE, tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP]) as u64;
}
fn qd_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, open: bool) -> void {
    if (tg[TPG_QD_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_QD_PID]);
        if (d == 0) {
            tg_late(now, tg[TPG_QD_LAST], tg[TPG_QD_PID]);
        } else {
            tg[TPG_QD_PID] = 0;
            qd_read(tg, tb, hb);
            tg_bump(tg);
        }
    } else if (qd_feed_due(open, now, tg[TPG_QD_LAST])) {
        tg[TPG_QD_LAST] = now;
        qd_read(tg, tb, hb);
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = put_bytes(tb, e, QD_FEED_CMD);
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) { tg[TPG_QD_PID] = pid; }
        tg_bump(tg);
    }
}

/// The two lines of tile i (written to l1, l2); the lengths packed (n1 + 65536 * n2).
fn qd_lines(i: u32, tg: []const u64, sst: []const u32, tb: []const u8, l1: []u8, l2: []u8) -> u64 {
    const fl : u64 = tg[TPG_QD_FLAGS];
    const pn : usize = tg[TPG_QD_PLANN] as usize;
    const plan : []const u8 = tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP];
    const hn : usize = tg[TPG_SB_HOSTN] as usize;
    var n1 : usize = 0;
    var n2 : usize = 0;
    if (i == QD_T_GOD) {
        var ago : u64 = 0;
        if (tg[TPG_G_LAST] > 0 and tg[TPG_NOW] >= tg[TPG_G_LAST]) { ago = tg[TPG_NOW] - tg[TPG_G_LAST]; }
        n1 = qd_god_line1(l1, tg[TPG_Q_GOD] != 0, qd_fl_paused(fl));
        n2 = qd_god_line2(l2, tg[TPG_Q_GOD] != 0, qd_fl_paused(fl), ago, tg[TPG_G_LAST] == 0);
    } else if (i == QD_T_LOCAL) {
        var cap : u32 = qd_plan_key(plan, pn, "cap=");
        var run : u32 = qd_plan_key(plan, pn, "running=");
        var slots : u32 = qd_plan_key(plan, pn, "slots=");
        const have : bool = cap != QD_NOT_READ and run != QD_NOT_READ and slots != QD_NOT_READ;
        if (have == false) {
            cap = qd_fl_lanes(fl);
            run = sst[SST_QRUN];
            slots = lanes_free(run, cap);
        }
        n1 = qd_local_line1(l1, cap, run, slots);
        n2 = qd_local_line2(l2, have, cap, run, slots);
    } else if (i == QD_T_TRIGIT) {
        const tn : usize = tg[TPG_QD_TRIGN] as usize;
        const tt : []const u8 = tb[TBO_QD_TRIG .. TBO_QD_TRIG + QD_TRIG_CAP];
        if (tn == 0) {
            n1 = qd_no_feed(l1);
        } else {
            const s0 : usize = qd_line_start(tt, tn, 0);
            const s1 : usize = qd_line_start(tt, tn, 1);
            var e0 : usize = s0;
            while (e0 < tn and tt[e0] != 10) { e0 = e0 + 1; }
            n1 = qd_put_line(l1, 0, tt, s0, e0, 44);
            var e1 : usize = s1;
            while (e1 < tn and tt[e1] != 10) { e1 = e1 + 1; }
            n2 = qd_put_line(l2, 0, tt, s1, e1, 44);
        }
    } else if (i == QD_T_KEYS) {
        n1 = qd_keys_line1(l1, qd_fl_keys(fl));
        n2 = qd_keys_line2(l2, qd_fl_light(fl));
    } else if (i == QD_T_MACHINE) {
        var hb : [24]u8 = undefined;
        if (hn > 0 and hn <= 24) { unpack8(tg, TPG_SB_HOST as usize, hn, hb[0..24]); }
        const hv : []const u8 = tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP];
        const hvn : usize = tg[TPG_QD_HIVEN] as usize;
        var cpu : u32 = QD_NOT_READ;
        var ram : u32 = QD_NOT_READ;
        var disk : u32 = QD_NOT_READ;
        if (hn > 0 and hn <= 24) {
            cpu = qd_hive_own(hv, hvn, hb[0..24], hn, "cpu=");
            ram = qd_hive_own(hv, hvn, hb[0..24], hn, "ram=");
            disk = qd_hive_own(hv, hvn, hb[0..24], hn, "disk=");
        }
        if (sst[SST_DISK] > 0) { disk = sst[SST_DISK] - 1; }
        n1 = qd_machine_line1(l1, cpu, ram);
        n2 = qd_machine_line2(l2, disk);
    } else {
        const hv2 : []const u8 = tb[TBO_QD_HIVE .. TBO_QD_HIVE + QD_HIVE_CAP];
        const hvn2 : usize = tg[TPG_QD_HIVEN] as usize;
        const tot : u32 = qd_hive_total(hv2, hvn2);
        if (hvn2 == 0 or tot == 0) {
            n1 = qd_no_feed(l1);
        } else {
            n1 = qd_machines_line1(l1, qd_hive_online(hv2, hvn2, tg[TPG_NOW]), tot);
            var k : u32 = 0;
            while (k < 2 and k < tot) {
                if (k > 0) { n2 = put_bytes(l2, n2, ", "); }
                var nm : [24]u8 = undefined;
                const nl : usize = qd_hive_name(hv2, hvn2, k, nm[0..24]);
                n2 = put_bytes(l2, n2, nm[0..nl]);
                k = k + 1;
            }
        }
    }
    return (n1 as u64) + 65536 * (n2 as u64);
}

fn qd_button(c: u64, kit: [48]u64, x: f64, y: f64, w: f64, label: []const u8, on: bool, hot: bool, a: f64) -> void {
    round_rect(c, x, y, w, QD_BTN_H, 5.0);
    if (on) {
        cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.22 * a);
        cg_fill_path(c);
        round_rect(c, x, y, w, QD_BTN_H, 5.0);
    }
    cg_line_width(c, 1.0);
    if (on) { cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a); } else if (hot) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a); } else { cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a); }
    cg_stroke_path(c);
    const lw : f64 = bytes_w(kit, label, label.len, 7.5, WEIGHT_SEMIBOLD, false);
    if (on) { cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, a); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a); }
    draw_bytes(c, kit, label, label.len, x + 0.5 * (w - lw), y + 12.5, 7.5, WEIGHT_SEMIBOLD, false);
}

/// The dashboard: 100% widgets in matte glass, each with its pinned agents.
fn draw_qdash(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, tb: []const u8, x0: f64, y0: f64, w: f64, h: f64, sw: f64, mx: f64, my: f64, full: bool, a: f64) -> void {
    draw_ground(c, x0, y0, w, h, SURF_CONTENT, sw, a);
    const fl : u64 = tg[TPG_QD_FLAGS];
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_bytes(c, kit, "QUEEN CONTROL DASHBOARD", 23, x0 + QD_PAD, y0 + 22.0, 11.0, WEIGHT_SEMIBOLD, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_close_x(c, qd_close_x(x0, w) + 8.0, y0 + 16.0, qd_hit(mx, my, x0, y0, w, h, 0, 0) == QD_QH_CLOSE, a);
    const lt : u32 = qd_table_rows(y0, w, h);
    const lrows : u32 = qd_lane_rows_shown(lt);
    const qrows : u32 = qd_queue_rows_shown(lt);
    const hit : u32 = qd_hit(mx, my, x0, y0, w, h, lrows, qrows);
    var i : u32 = 0;
    while (i < QD_TILE_COUNT) {
        const tx : f64 = qd_tile_x(i, x0, w);
        const ty : f64 = qd_tile_y(i, y0, w);
        const tw : f64 = qd_tile_w(w);
        round_rect(c, tx, ty, tw, QD_TILE_H, 8.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.04 * a);
        cg_fill_path(c);
        round_rect(c, tx, ty, tw, QD_TILE_H, 8.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, TILE_BORDER * a);
        cg_stroke_path(c);
        var nb : [32]u8 = undefined;
        const nn : usize = qd_tile_name(i, nb[0..32]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
        draw_bytes(c, kit, nb[0..32], nn, tx + 10.0, ty + 16.0, 8.0, WEIGHT_SEMIBOLD, false);
        var pb : [40]u8 = undefined;
        var pn : usize = put_bytes(pb[0..40], 0, "AGENTS ");
        pn = pn + qd_pin_text(i, pb[pn..40]);
        const pw2 : f64 = bytes_w(kit, pb[0..40], pn, 7.0, 0.0, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_bytes(c, kit, pb[0..40], pn, tx + tw - 10.0 - pw2, ty + 16.0, 7.0, 0.0, false);
        var l1 : [64]u8 = undefined;
        var l2 : [64]u8 = undefined;
        const ln : u64 = qd_lines(i, tg, sst, tb, l1[0..64], l2[0..64]);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_fit(c, kit, l1[0..64], (ln % 65536) as usize, tx + 10.0, ty + 36.0, 11.0, WEIGHT_SEMIBOLD, false, tx + tw - 10.0);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_fit(c, kit, l2[0..64], (ln / 65536) as usize, tx + 10.0, ty + 51.0, 9.0, 0.0, false, tx + tw - 10.0);
        if (i == QD_T_GOD) {
            var gl : [16]u8 = undefined;
            var gn : usize = put_bytes(gl[0..16], 0, "GOD MODE OFF");
            if (tg[TPG_Q_GOD] != 0) { gn = put_bytes(gl[0..16], 0, "GOD MODE ON"); }
            qd_button(c, kit, qd_god_btn_x(tx), qd_btn_y(ty), QD_GOD_BTN_W + 14.0, gl[0..16], tg[TPG_Q_GOD] != 0, hit == QD_QH_GOD, a);
        }
        if (i == QD_T_LOCAL) {
            const by : f64 = qd_btn_y(ty);
            qd_button(c, kit, qd_tick_btn_x(tx), by, QD_TICK_BTN_W, "TICK NOW", qd_fl_now(fl), hit == QD_QH_TICK, a);
            qd_button(c, kit, qd_minus_x(tx), by, QD_STEP_W, "-", false, hit == QD_QH_MINUS, a);
            qd_button(c, kit, qd_plus_x(tx), by, QD_STEP_W, "+", false, hit == QD_QH_PLUS, a);
            var nbuf : [4]u8 = undefined;
            const nl : usize = put_dec(nbuf[0..4], 0, qd_fl_lanes(fl) as u64);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_bytes(c, kit, nbuf[0..4], nl, qd_num_x(tx) + 4.0, by + 12.5, 9.0, WEIGHT_SEMIBOLD, false);
            if (qd_fl_paused(fl)) { qd_button(c, kit, qd_pause_x(tx), by, QD_PAUSE_BTN_W, "RESUME", true, hit == QD_QH_PAUSE, a); } else { qd_button(c, kit, qd_pause_x(tx), by, QD_PAUSE_BTN_W, "PAUSE", false, hit == QD_QH_PAUSE, a); }
        }
        i = i + 1;
    }
    // the lanes table
    const lty : f64 = qd_lanes_top(y0, w);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, "LANES", 5, x0 + QD_PAD, lty + 14.0, 8.0, WEIGHT_SEMIBOLD, false);
    var pl : [24]u8 = undefined;
    const pln : usize = qd_pin_text(QD_W_LANES, pl[0..24]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_bytes(c, kit, pl[0..24], pln, x0 + QD_PAD + 44.0, lty + 14.0, 7.0, 0.0, false);
    var cI : u32 = 0;
    while (cI < 5) {
        draw_bytes(c, kit, QD_HEADS[cI as usize], QD_HEADS[cI as usize].len, qd_col_x(cI, x0, w), lty + 29.0, 7.0, WEIGHT_SEMIBOLD, false);
        cI = cI + 1;
    }
    const total : u32 = qd_lane_total(sst);
    var hb2 : [24]u8 = undefined;
    const hn2 : usize = tg[TPG_SB_HOSTN] as usize;
    if (hn2 > 0 and hn2 <= 24) { unpack8(tg, TPG_SB_HOST as usize, hn2, hb2[0..24]); }
    var r : u32 = 0;
    while (r < lrows and r < total) {
        const li : u32 = qd_lane_index(sst, r);
        const ry : f64 = qd_lane_row_y(r, y0, w);
        if (hit % 16 == QD_QH_LANE and hit / 16 == r) {
            round_rect(c, x0 + QD_PAD, ry, w - 2.0 * QD_PAD, QD_ROW_H, 4.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.07 * a);
            cg_fill_path(c);
        }
        const rb : usize = SST_LV + (li as usize) * LV_F;
        var tb1 : [24]u8 = undefined;
        var n3 : usize = 0;
        if (sst[rb + LVF_ISSUE] > 0 and sst[rb + LVF_ISSUE] < 100000000) {
            n3 = put_bytes(tb1[0..24], 0, "#");
            n3 = put_dec(tb1[0..24], n3, sst[rb + LVF_ISSUE] as u64);
        } else {
            n3 = put_bytes(tb1[0..24], 0, "-");
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_bytes(c, kit, tb1[0..24], n3, qd_col_x(0, x0, w), ry + 14.0, 9.0, 0.0, true);
        const mdl : u32 = sst[rb + LVF_MODEL];
        if (mdl < 7) { draw_bytes(c, kit, LVM_NAMES[mdl as usize], LVM_NAMES[mdl as usize].len, qd_col_x(1, x0, w), ry + 14.0, 9.0, 0.0, false); }
        if (hn2 > 0 and hn2 <= 24) { draw_bytes(c, kit, hb2[0..24], hn2, qd_col_x(2, x0, w), ry + 14.0, 9.0, 0.0, false); }
        const stt : u32 = sst[rb + LVF_STATE];
        if (stt < 7) { draw_bytes(c, kit, LVS_NAMES[stt as usize], LVS_NAMES[stt as usize].len, qd_col_x(3, x0, w), ry + 14.0, 9.0, WEIGHT_SEMIBOLD, false); }
        if (sst[rb + LVF_ELAPSED] != LV_NOT_MEASURED) {
            var eb : [24]u8 = undefined;
            const en : usize = lv_elapsed_text(sst[rb + LVF_ELAPSED], eb[0..24]);
            draw_bytes(c, kit, eb[0..24], en, qd_col_x(4, x0, w), ry + 14.0, 9.0, 0.0, true);
        }
        r = r + 1;
    }
    if (total == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_bytes(c, kit, "no lanes running", 16, qd_col_x(0, x0, w), qd_lane_row_y(0, y0, w) + 14.0, 9.0, 0.0, false);
    }
    // the P0/P1 queue: the picks of `tri-queen queen --plan tick`
    const qty : f64 = qd_queue_top(y0, w, lrows);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LABEL_WHITE * a);
    draw_bytes(c, kit, "P0 / P1 QUEUE", 13, x0 + QD_PAD, qty + 14.0, 8.0, WEIGHT_SEMIBOLD, false);
    var pq : [24]u8 = undefined;
    const pqn : usize = qd_pin_text(QD_W_QUEUE, pq[0..24]);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
    draw_bytes(c, kit, pq[0..24], pqn, x0 + QD_PAD + 94.0, qty + 14.0, 7.0, 0.0, false);
    const plan : []const u8 = tb[TBO_QD_PLAN .. TBO_QD_PLAN + QD_PLAN_CAP];
    const pn : usize = tg[TPG_QD_PLANN] as usize;
    const picks : u32 = qd_pick_count(plan, pn);
    var q : u32 = 0;
    while (q < qrows and q < picks) {
        const ps : usize = qd_pick_start(plan, pn, q);
        const qy : f64 = qd_queue_row_y(q, y0, w, lrows);
        if (hit % 16 == QD_QH_QUEUE and hit / 16 == q) {
            round_rect(c, x0 + QD_PAD, qy, w - 2.0 * QD_PAD, QD_ROW_H, 4.0);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.07 * a);
            cg_fill_path(c);
        }
        var qb : [96]u8 = undefined;
        const qn : usize = qd_put_line(qb[0..96], 0, plan, ps, qd_pick_end(plan, pn, ps), 90);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
        draw_fit(c, kit, qb[0..96], qn, qd_col_x(0, x0, w), qy + 14.0, 9.0, 0.0, true, x0 + w - QD_PAD);
        q = q + 1;
    }
    if (picks == 0) {
        // why there is none: the plan's own first line (an error line says why nothing is picked)
        var wb : [96]u8 = undefined;
        var wn : usize = 0;
        if (pn == 0) {
            wn = put_bytes(wb[0..96], 0, "no plan yet");
        } else {
            var e0 : usize = 0;
            while (e0 < pn and plan[e0] != 10) { e0 = e0 + 1; }
            wn = qd_put_line(wb[0..96], 0, plan, 0, e0, 90);
            if (qd_plan_key(plan, pn, "cap=") != QD_NOT_READ and e0 >= pn) { wn = put_bytes(wb[0..96], 0, "nothing to pick"); }
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE * a);
        draw_fit(c, kit, wb[0..96], wn, qd_col_x(0, x0, w), qd_queue_row_y(0, y0, w, lrows) + 14.0, 9.0, 0.0, false, x0 + w - QD_PAD);
    }
}

// ---- the header's right cluster and the footer bar (statusbar.t27 decides; this draws and reads the host) ----
// The state the bar shows lives in tg (u64 words): the host name and the commit packed 8 bytes a word, the last disk
// read, the GOD tick job; and in sst: the Queen's numbers the lanes table counted and the free disk.
pub const TPG_SB_HOST : u32 = 232;
pub const TPG_SB_HOSTN : u32 = 235;
pub const TPG_SB_COMMIT : u32 = 236;
pub const TPG_SB_COMMITN : u32 = 237;
pub const TPG_SB_AT : u32 = 238;
pub const TPG_G_PID : u32 = 239;
pub const TPG_G_LAST : u32 = 240;
pub const TPG_G_START : u32 = 241;
pub const TPG_G_RC : u32 = 242;
pub const TPG_G_NEXT : u32 = 243;
pub const SST_QRUN : usize = 552;
pub const SST_QIDLE : usize = 553;
pub const SST_QBLK : usize = 554;
pub const SST_QREV : usize = 555;
pub const SST_QFEED : usize = 557;
/// free disk in GB plus one; 0 = not read
pub const SST_DISK : usize = 558;
pub const GOLD_R : f64 = 1.0;
pub const GOLD_G : f64 = 0.78;
pub const GOLD_B : f64 = 0.2;

/// The right edge of the header's cluster: left of the title bar's refresh control and of the profile circle (PF_RESERVE).
pub fn hdr_right(sw: f64) -> f64 { return dock_x(sw) - DOCK_STEP - 6.0 - PF_RESERVE; }

/// Panes the server lists as running.
fn sb_panes(sst: []const u32) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < 32) {
        if (sst[i] != S_STOPPED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The worst key light over the running rows of the lanes table (red over yellow over green).
fn sb_worst_light(sst: []const u32) -> u32 {
    var w : u32 = LIGHT_NONE;
    var i : usize = 0;
    while (i < (sst[SST_LVN] as usize) and i < 64) {
        if (sst[SST_LV + i * LV_F + LVF_STATE] == LVS_RUNNING) { w = light_worse(w, sst[SST_LV + i * LV_F + LVF_LIGHT]); }
        i = i + 1;
    }
    return w;
}

fn sb_put(kit: [48]u64, slots: []u8, lens: []u32, widths: []f64, id: u32, n: usize, extra: f64) -> u32 {
    const o : usize = (id as usize) * SB_SLOT;
    sb_upper(slots[o .. o + SB_SLOT], n);
    lens[id as usize] = n as u32;
    widths[id as usize] = bytes_w(kit, slots[o .. o + SB_SLOT], n, SB_SIZE, WEIGHT_SEMIBOLD, false) + extra;
    return 1 << id;
}

/// Writes every present item's text into slots (SB_SLOT bytes each, upper case), its length and width; the present mask.
/// An item whose feed does not exist yet is not present.
fn sb_build(kit: [48]u64, tg: []const u64, sst: []const u32, slots: []u8, lens: []u32, widths: []f64) -> u32 {
    var present : u32 = 0;
    const hn : usize = tg[TPG_SB_HOSTN] as usize;
    if (hn > 0 and hn <= 24) {
        var hb : [24]u8 = undefined;
        unpack8(tg, TPG_SB_HOST as usize, hn, hb[0..24]);
        const n : usize = host_text(slots[(IT_HOST as usize) * SB_SLOT .. (IT_HOST as usize) * SB_SLOT + SB_SLOT], hb[0..24], hn, tg[TPG_U_WHY] != (WHY_OFFLINE as u64));
        present = present + sb_put(kit, slots, lens, widths, IT_HOST, n, 0.0);
    }
    var cb : [8]u8 = undefined;
    const cn : usize = tg[TPG_SB_COMMITN] as usize;
    if (cn > 0 and cn <= 8) { unpack8(tg, TPG_SB_COMMIT as usize, cn, cb[0..8]); }
    var vn : usize = 0;
    if (cn <= 8) { vn = cn; }
    const nv : usize = ver_text(slots[(IT_VER as usize) * SB_SLOT .. (IT_VER as usize) * SB_SLOT + SB_SLOT], tg[TPG_U_CUR] as u32, cb[0..8], vn);
    present = present + sb_put(kit, slots, lens, widths, IT_VER, nv, 0.0);
    if (tg[TPG_U_ON] != 0) {
        const nu : usize = upd_text(slots[(IT_UPD as usize) * SB_SLOT .. (IT_UPD as usize) * SB_SLOT + SB_SLOT], tg[TPG_U_ST] as u8, tg[TPG_U_WHY] as u8, PCT_UNKNOWN);
        present = present + sb_put(kit, slots, lens, widths, IT_UPD, nu, 0.0);
    }
    const ng : usize = god_text(slots[(IT_GOD as usize) * SB_SLOT .. (IT_GOD as usize) * SB_SLOT + SB_SLOT], tg[TPG_Q_GOD] != 0, sst[SST_QRUN], EV_MAX_AGENTS);
    present = present + sb_put(kit, slots, lens, widths, IT_GOD, ng, 0.0);
    const ns : usize = srv_text(slots[(IT_SRV as usize) * SB_SLOT .. (IT_SRV as usize) * SB_SLOT + SB_SLOT], sst[SST_SRV], sb_panes(sst));
    present = present + sb_put(kit, slots, lens, widths, IT_SRV, ns, 0.0);
    const lt : u32 = sb_worst_light(sst);
    if (lt != LIGHT_NONE) {
        const nl : usize = light_text(slots[(IT_LIGHT as usize) * SB_SLOT .. (IT_LIGHT as usize) * SB_SLOT + SB_SLOT], lt, "", 0);
        present = present + sb_put(kit, slots, lens, widths, IT_LIGHT, nl, 10.0);
    }
    if (sst[SST_QFEED] == 1) {
        const na : usize = lanes_text(slots[(IT_LANES as usize) * SB_SLOT .. (IT_LANES as usize) * SB_SLOT + SB_SLOT], sst[SST_QRUN], sst[SST_QBLK]);
        present = present + sb_put(kit, slots, lens, widths, IT_LANES, na, 0.0);
        const nq : usize = queen_text(slots[(IT_QUEEN as usize) * SB_SLOT .. (IT_QUEEN as usize) * SB_SLOT + SB_SLOT], sst[SST_QRUN], sst[SST_QIDLE], sst[SST_QBLK], sst[SST_QREV]);
        present = present + sb_put(kit, slots, lens, widths, IT_QUEEN, nq, 0.0);
    }
    if (sst[SST_DISK] > 0) {
        const nd : usize = load_text(slots[(IT_LOAD as usize) * SB_SLOT .. (IT_LOAD as usize) * SB_SLOT + SB_SLOT], NOT_READ, NOT_READ, sst[SST_DISK] - 1);
        present = present + sb_put(kit, slots, lens, widths, IT_LOAD, nd, 0.0);
    }
    if (tg[TPG_NOW] > 0) {
        const tz : i64 = @as(i64, @intCast(tg[TPG_Q_TZ])) - @as(i64, @intCast(TG_TZ_BIAS));
        const nk : usize = clock_text(slots[(IT_CLOCK as usize) * SB_SLOT .. (IT_CLOCK as usize) * SB_SLOT + SB_SLOT], tg[TPG_NOW], tz);
        present = present + sb_put(kit, slots, lens, widths, IT_CLOCK, nk, 0.0);
    }
    return present;
}

/// The footer item under (x, y): its id, IT_FOLD for the "...", SB_NONE for none.
fn sb_hit(kit: [48]u64, tg: []const u64, sst: []const u32, x: f64, y: f64, sw: f64, sh: f64) -> u32 {
    if (in_bar(y, sh) == false) { return SB_NONE; }
    var slots : [704]u8 = undefined;
    var lens : [11]u32 = undefined;
    var widths : [11]f64 = undefined;
    var k : usize = 0;
    while (k < 11) {
        lens[k] = 0;
        widths[k] = 0.0;
        k = k + 1;
    }
    const present : u32 = sb_build(kit, tg, sst, slots[0..704], lens[0..11], widths[0..11]);
    const vis : u32 = visible_mask(present, widths[0..11], avail_w(sw));
    return sb_item_at(x, y, sh, vis, present, widths[0..11]);
}

/// The footer: matte glass across the window bottom, small caps, each item from its one source; OPEN SOURCE T27,
/// KEYS and DOCTOR at the right end. The items that do not fit fold into "..." with a tooltip list.
fn draw_footer(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, mx: f64, my: f64, sw: f64, sh: f64, full: bool, a: f64, kyp: bool, dlabel: u64, dp: bool) -> void {
    draw_ground(c, 0.0, sh - SB_H, sw, SB_H, SURF_SIDEBAR, sw, a);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, LINE_WHITE * a);
    cg_fill_rect(c, 0.0, sh - SB_H, sw, HAIR);
    var slots : [704]u8 = undefined;
    var lens : [11]u32 = undefined;
    var widths : [11]f64 = undefined;
    var k : usize = 0;
    while (k < 11) {
        lens[k] = 0;
        widths[k] = 0.0;
        k = k + 1;
    }
    const present : u32 = sb_build(kit, tg, sst, slots[0..704], lens[0..11], widths[0..11]);
    const vis : u32 = visible_mask(present, widths[0..11], avail_w(sw));
    const hot : u32 = sb_item_at(mx, my, sh, vis, present, widths[0..11]);
    const base : f64 = sh - 8.0;
    var id : u32 = 0;
    while (id < IT_COUNT) {
        if ((vis >> id) % 2 == 1) {
            const o : usize = (id as usize) * SB_SLOT;
            var x : f64 = sb_item_x(id, vis, present, widths[0..11]);
            var al : f64 = LABEL_WHITE;
            if (hot == id) { al = TEXT_WHITE; }
            if (id == IT_UPD and tg[TPG_U_ST] == (U_STAGED as u64)) { al = TEXT_WHITE; }
            if (id == IT_GOD and tg[TPG_Q_GOD] != 0) { al = TEXT_WHITE; }
            if (id == IT_LOAD and sst[SST_DISK] > 0 and load_red(NOT_READ, sst[SST_DISK] - 1)) { al = TEXT_WHITE; }
            if (id == IT_LIGHT) {
                draw_light_dot(c, x + 4.0, sh - 11.5, sb_worst_light(sst), a);
                x = x + 10.0;
            }
            cg_fill_rgba(c, 1.0, 1.0, 1.0, al * a);
            draw_bytes(c, kit, slots[o .. o + SB_SLOT], lens[id as usize] as usize, x, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
            if (id == IT_GOD and tg[TPG_Q_GOD] != 0) {
                cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a);
                cg_arc(c, sb_item_x(id, vis, present, widths[0..11]) - 6.0, sh - 11.5, 2.5, 0.0, 6.283185307, 0);
                cg_fill_path(c);
            }
            if (id == IT_LOAD and sst[SST_DISK] > 0 and load_red(NOT_READ, sst[SST_DISK] - 1)) {
                cg_fill_rgba(c, 1.0, 0.25, 0.2, 0.95 * a);
                cg_arc(c, sb_item_x(id, vis, present, widths[0..11]) - 6.0, sh - 11.5, 2.5, 0.0, 6.283185307, 0);
                cg_fill_path(c);
            }
        }
        id = id + 1;
    }
    if (vis != present) {
        const fx : f64 = sb_item_x(IT_FOLD, vis, present, widths[0..11]);
        var fa : f64 = LABEL_WHITE;
        if (hot == IT_FOLD) { fa = TEXT_WHITE; }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, fa * a);
        draw_bytes(c, kit, "...", 3, fx, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
        if (hot == IT_FOLD) {
            var tip : [320]u8 = undefined;
            const tn : usize = fold_tip(slots[0..704], lens[0..11], present - vis, tip[0..320]);
            const tw : f64 = bytes_w(kit, tip[0..320], tn, SB_SIZE, WEIGHT_SEMIBOLD, false);
            var tx : f64 = fx;
            if (tx + tw + 16.0 > sw) { tx = sw - tw - 16.0; }
            if (tx < 4.0) { tx = 4.0; }
            round_rect(c, tx - 6.0, sh - SB_H - 22.0, tw + 12.0, 18.0, 5.0);
            cg_fill_rgba(c, 0.0, 0.0, 0.0, 0.9 * a);
            cg_fill_path(c);
            cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
            draw_bytes(c, kit, tip[0..320], tn, tx, sh - SB_H - 9.0, SB_SIZE, WEIGHT_SEMIBOLD, false);
        }
    }
    // the right end: OPEN SOURCE T27, KEYS (with the worst light), DOCTOR n
    var la : f64 = LABEL_WHITE;
    if (on_repo(mx, my, sw, sh)) { la = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, la * a);
    const lw : f64 = draw_text(c, kit, kit[K_REPO], repo_left(sw), base, SB_SIZE, WEIGHT_SEMIBOLD, false);
    if (on_repo(mx, my, sw, sh)) { cg_fill_rect(c, repo_left(sw), sh - 5.5, lw, HAIR); }
    var ka : f64 = LABEL_WHITE;
    if (kyp or on_keys(mx, my, sw, sh)) { ka = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ka * a);
    var kw : [16]u8 = undefined;
    const kn : usize = csv_field(KEYS_WORDS, 0, kw[0..16]);
    draw_bytes(c, kit, kw[0..16], kn, keys_left(sw) + 8.0, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
    draw_light_dot(c, keys_left(sw) + 1.0, sh - 11.5, sb_worst_light(sst), a);
    var da : f64 = LABEL_WHITE;
    if (dp or on_doc(mx, my, sw, sh)) { da = TEXT_WHITE; }
    cg_fill_rgba(c, 1.0, 1.0, 1.0, da * a);
    draw_text(c, kit, dlabel, doc_left(sw) + 22.0, base, SB_SIZE, WEIGHT_SEMIBOLD, false);
}

/// GOD MODE's strip, just above the footer while it is on: the next gap, the running lanes, the last Queen tick.
fn draw_god_strip(c: u64, kit: [48]u64, tg: []const u64, sst: []const u32, sw: f64, sh: f64, full: bool, a: f64, god: bool) -> void {
    if (god == false) { return; }
    const top : f64 = strip_top(sh);
    draw_ground(c, 0.0, top, sw, STRIP_H, SURF_SIDEBAR, sw, a);
    var t : [128]u8 = undefined;
    var ago : u64 = NO_TICK;
    if (tg[TPG_G_LAST] > 0 and tg[TPG_NOW] >= tg[TPG_G_LAST]) { ago = tg[TPG_NOW] - tg[TPG_G_LAST]; }
    const n : usize = god_strip_text(t[0..128], tg[TPG_G_NEXT] as u32, sst[SST_QRUN], EV_MAX_AGENTS, ago, tg[TPG_G_RC] as u32);
    cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.9 * a);
    cg_arc(c, SB_PAD + 2.0, top + 8.0, 2.5, 0.0, 6.283185307, 0);
    cg_fill_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE * a);
    draw_bytes(c, kit, t[0..128], n, SB_PAD + 10.0, top + 11.5, SB_SIZE, WEIGHT_SEMIBOLD, false);
}

/// The header's right cluster: [version text] [UPDATE NOW when ready] [GOD MODE switch], always drawn.
fn draw_header_cluster(c: u64, kit: [48]u64, tg: []const u64, sw: f64, god: bool, brand_end: f64) -> void {
    const r : f64 = hdr_right(sw);
    const mid : f64 = 0.5 * TITLE_H;
    const ready : bool = tg[TPG_U_ON] != 0 and tg[TPG_U_ST] == (U_STAGED as u64);
    // the GOD MODE switch: gold glow when on
    const gx : f64 = god_x(r);
    round_rect(c, gx, mid - 0.5 * GOD_H, GOD_W, GOD_H, 9.0);
    if (god) {
        cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.22);
        cg_fill_path(c);
        round_rect(c, gx - 1.5, mid - 0.5 * GOD_H - 1.5, GOD_W + 3.0, GOD_H + 3.0, 10.5);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.35);
        cg_stroke_path(c);
        round_rect(c, gx, mid - 0.5 * GOD_H, GOD_W, GOD_H, 9.0);
        cg_line_width(c, 1.2);
        cg_stroke_rgba(c, GOLD_R, GOLD_G, GOLD_B, 0.95);
    } else {
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE);
    }
    cg_stroke_path(c);
    var gt : [16]u8 = undefined;
    const gn : usize = put_bytes(gt[0..16], 0, "GOD MODE");
    const gw : f64 = bytes_w(kit, gt[0..16], gn, 7.5, WEIGHT_SEMIBOLD, false);
    if (god) { cg_fill_rgba(c, GOLD_R, GOLD_G, GOLD_B, 1.0); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE); }
    draw_bytes(c, kit, gt[0..16], gn, gx + 0.5 * (GOD_W - gw), mid + 2.8, 7.5, WEIGHT_SEMIBOLD, false);
    if (ready) {
        const bx : f64 = hdr_btn_x(r);
        round_rect(c, bx, mid - 0.5 * HDR_BTN_H, HDR_BTN_W, HDR_BTN_H, 5.0);
        cg_line_width(c, 1.0);
        cg_stroke_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        cg_stroke_path(c);
        var ut : [16]u8 = undefined;
        const un : usize = put_bytes(ut[0..16], 0, "UPDATE NOW");
        const uw : f64 = bytes_w(kit, ut[0..16], un, 7.5, WEIGHT_SEMIBOLD, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE);
        draw_bytes(c, kit, ut[0..16], un, bx + 0.5 * (HDR_BTN_W - uw), mid + 2.8, 7.5, WEIGHT_SEMIBOLD, false);
    }
    // the version text, from the same constants as the bundle plist, never typed
    var h : [64]u8 = undefined;
    const hn : usize = header_text(h[0..64], tg[TPG_U_CUR] as u32, ready, tg[TPG_U_CANDV], tg[TPG_U_CAND] as u32);
    const hw : f64 = bytes_w(kit, h[0..64], hn, 9.0, WEIGHT_SEMIBOLD, false);
    const hx : f64 = hdr_text_right(r, ready) - hw;
    if (hx > brand_end + 12.0) {
        if (ready) { cg_fill_rgba(c, 1.0, 1.0, 1.0, TEXT_WHITE); } else { cg_fill_rgba(c, 1.0, 1.0, 1.0, MUTED_WHITE); }
        draw_bytes(c, kit, h[0..64], hn, hx, mid + 3.2, 9.0, WEIGHT_SEMIBOLD, false);
    }
}

/// One run of the GOD tick job and its reap: while GOD MODE is on and a lane slot is free the local Queen is asked
/// for lanes (`tri-queen queen --lanes N tick`), at most every GOD_TICK_S seconds.
fn god_tick(tg: []u64, tb: []u8, hb: []const u8, now: u64, god: bool, running: u32) -> void {
    const cap : u32 = qd_fl_lanes(tg[TPG_QD_FLAGS]);
    const force : bool = qd_fl_now(tg[TPG_QD_FLAGS]);
    if (tg[TPG_G_PID] != 0) {
        const d : u32 = tg_done(tg[TPG_G_PID]);
        if (d == 0) {
            if (now > tg[TPG_G_START] + 120) { tg_kill(tg[TPG_G_PID]); }
        } else {
            tg[TPG_G_PID] = 0;
            tg[TPG_G_RC] = 0;
            if (d != 1) { tg[TPG_G_RC] = 1; }
            tg_bump(tg);
        }
        return;
    }
    if (force) { tg[TPG_QD_FLAGS] = qd_fl_clear_now(tg[TPG_QD_FLAGS]); }
    if ((force and lanes_free(running, cap) > 0) or (force == false and god_tick_due(qd_tick_wanted(god, tg[TPG_QD_FLAGS]), now, tg[TPG_G_LAST], running, cap))) {
        var e : usize = tg_head(tb, hb, FEED_HEAD_A, LV_HEAD_B);
        e = e + tick_cmd(tb[e .. TBO_ROOT], lanes_free(running, cap));
        tg[TPG_G_LAST] = now;
        const pid : u64 = tg_spawn(tb, TBO_CMD, e);
        if (pid != 0) {
            tg[TPG_G_PID] = pid;
            tg[TPG_G_START] = now;
        } else {
            tg[TPG_G_RC] = 1;
        }
        tg_bump(tg);
    }
}

// ======================================================================================================
// P. PROFILE (owner, 2026-10-21; Refs gHashTag/t27#11560). profile.t27 decides (limits, the nickname rules, typing,
// the paste, the panel boxes, the state step), profile_host.t27 touches the machine (the file panel, ImageIO, the
// atomic files). This block only keeps the state, draws it and forwards the mouse and the keys.
//   - the header circle: PRF_HEAD_D wide, left of the refresh arc; the picture clipped to a circle, else the first
//     letter of the nickname on a dim disc, else an outline; a click opens or closes the panel;
//   - the PROFILE panel (the slot of the Queen, DOCTOR and KEYS panels): the big circle, CHOOSE PICTURE, REMOVE
//     PICTURE, the nickname field, SAVE, CANCEL and one status line (prf_error_text);
//   - the picture is decoded ONCE (pf_boot at launch, pf_choose after a pick), never inside draw(): the frame
//     only draws the CGImage kept in tg[TPG_PF_IMG].
// The state lives in a 512 byte region of the text store (TBO_PF): offsets below are relative to the region, so
// the fns take the region and the tests run on a plain array. The nickname bytes are at most PRF_NICK_MAX_BYTES.
// Nothing here is a test of the window: the tests below cover the boxes, the typing and the state steps only.
// ======================================================================================================
pub const TPG_PF_IMG : u32 = 255;
pub const TBO_PF : usize = 76800;
pub const PF_CAP : usize = 512;
pub const PF_OPEN : usize = 0;
pub const PF_STATE : usize = 1;
pub const PF_HAS : usize = 2;
pub const PF_CODE : usize = 3;
pub const PF_LEN : usize = 4;
pub const PF_SLEN : usize = 5;
pub const PF_HOLD_LO : usize = 6;
pub const PF_HOLD_HI : usize = 7;
pub const PF_TYPED : usize = 16;
pub const PF_SAVED : usize = 80;
/// The title bar's room taken by the circle: its diameter and the gap before the control it stands beside.
pub const PF_RESERVE : f64 = 32.0;

pub fn pf_head_right(sw: f64) -> f64 { return dock_x(sw) - DOCK_STEP; }
pub fn pf_head_cx(sw: f64) -> f64 { return prf_head_cx(pf_head_right(sw)); }
pub fn pf_head_cy() -> f64 { return prf_head_cy(TITLE_H); }
pub fn on_pf_head(x: f64, y: f64, sw: f64) -> bool { return prf_head_hit(x, y, pf_head_cx(sw), pf_head_cy()); }

/// CANCEL stands right of SAVE, in the same row and size.
pub fn pf_cancel_x(l: f64) -> f64 { return prf_save_x(l) + PRF_SAVE_W + PRF_BTN_GAP; }
pub fn on_pf_cancel(x: f64, y: f64, l: f64, t: f64) -> bool {
    return x >= pf_cancel_x(l) and x < pf_cancel_x(l) + PRF_SAVE_W and y >= prf_save_y(t) and y < prf_save_y(t) + PRF_BTN_H;
}

fn pf_get(pf: []const u8, at: usize) -> u32 { return @as(u32, pf[at]); }
fn pf_set(pf: []u8, at: usize, v: u32) -> void { pf[at] = @as(u8, @intCast(v)); }
pub fn pf_is_open(pf: []const u8) -> bool { return pf[PF_OPEN] != 0; }
pub fn pf_has(pf: []const u8) -> bool { return pf[PF_HAS] == 1; }
pub fn pf_editing(pf: []const u8) -> bool { return pf[PF_STATE] == 1; }

/// The nickname the field shows: the typed text while editing, else the saved one (offset and length in the region).
pub fn pf_shown_at(pf: []const u8) -> usize {
    if (pf_editing(pf)) { return PF_TYPED; }
    return PF_SAVED;
}
pub fn pf_shown_len(pf: []const u8) -> usize {
    if (pf_editing(pf)) { return @as(usize, pf[PF_LEN]); }
    return @as(usize, pf[PF_SLEN]);
}

fn pf_copy(pf: []u8, from: usize, to: usize, n: usize) -> void {
    var i : usize = 0;
    while (i < n) {
        pf[to + i] = pf[from + i];
        i = i + 1;
    }
}

/// A click on the field: edit the saved nickname.
pub fn pf_to_edit(pf: []u8) -> void {
    if (pf_editing(pf)) { return; }
    const n : usize = @as(usize, pf[PF_SLEN]);
    pf_copy(pf, PF_SAVED, PF_TYPED, n);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), PRF_EV_FIELD, true));
}

/// Escape or CANCEL (PRF_EV_CANCEL) and the close x or another panel (PRF_EV_CLOSE): the saved nickname comes back,
/// nothing is written, the status line is cleared.
pub fn pf_leave(pf: []u8, ev: u32) -> void {
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), ev, true));
    pf_set(pf, PF_LEN, @as(u32, pf[PF_SLEN]));
    pf_copy(pf, PF_SAVED, PF_TYPED, @as(usize, pf[PF_SLEN]));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
}

/// One typed UTF-16 unit (NSEvent characters): a surrogate pair is joined over two calls (prf_unit_cp / prf_unit_hold).
pub fn pf_unit(pf: []u8, unit: u32) -> void {
    const pend : u32 = pf_get(pf, PF_HOLD_LO) + 256 * pf_get(pf, PF_HOLD_HI);
    const cp : u32 = prf_unit_cp(pend, unit);
    const hold : u32 = prf_unit_hold(pend, unit);
    pf_set(pf, PF_HOLD_LO, hold % 256);
    pf_set(pf, PF_HOLD_HI, hold / 256);
    if (cp == PRF_NONE) { return; }
    const n : usize = prf_append(pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_LEN]), cp);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_CODE, PRF_OK);
}

pub fn pf_back(pf: []u8) -> void {
    const n : usize = prf_backspace(pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_LEN]));
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_HOLD_LO, 0);
    pf_set(pf, PF_HOLD_HI, 0);
    pf_set(pf, PF_CODE, PRF_OK);
}

/// Cmd+V: the pasteboard text joins the nickname (text only, the rules of prf_paste); a status line tells when part
/// of it was left out.
pub fn pf_paste_in(pf: []u8, src: []const u8) -> void {
    const len : usize = @as(usize, pf[PF_LEN]);
    const err : u32 = prf_paste_error(src, pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], len);
    const n : usize = prf_paste(src, pf[PF_TYPED .. PF_TYPED + PRF_NICK_MAX_BYTES], len);
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_CODE, err);
}

/// SAVE (the button or Return): the typed nickname through prfh_save_nick; on success it becomes the saved one and
/// the edit ends, on a failure the edit stays and the status line says why.
pub fn pf_save(pf: []u8) -> void {
    if (pf_editing(pf) == false) { pf_to_edit(pf); }
    const n : usize = @as(usize, pf[PF_LEN]);
    const code : u32 = prfh_save_nick(pf[PF_TYPED .. PF_TYPED + n], pf_has(pf));
    const ok : bool = code == PRF_OK_SAVED;
    if (ok) {
        pf_copy(pf, PF_TYPED, PF_SAVED, n);
        pf_set(pf, PF_SLEN, @as(u32, @intCast(n)));
    }
    pf_set(pf, PF_STATE, prf_next(@as(u32, pf[PF_STATE]), PRF_EV_SAVE, ok));
    pf_set(pf, PF_CODE, code);
}

/// The saved picture as a CGImage, decoded now (ImageIO, 256 px). 0 when there is none or it does not decode.
fn pf_decode() -> u64 {
    var p : [1024]u8 = undefined;
    const n : usize = prfh_avatar_path(p[0..1024]);
    if (n == 0) { return 0; }
    return card_thumb(p[0..n], n, @as(u32, @intCast(PRF_AVATAR_PX)));
}

/// Launch: read profile.t27p once and decode avatar.png once. A missing or damaged file reads as "not set".
pub fn pf_boot(pf: []u8, tg: []u64) -> void {
    var res : [2]u32 = undefined;
    const n : usize = prfh_load(pf[PF_SAVED .. PF_SAVED + PRF_NICK_MAX_BYTES], res[0..2]);
    pf_set(pf, PF_SLEN, @as(u32, @intCast(n)));
    pf_set(pf, PF_LEN, @as(u32, @intCast(n)));
    pf_copy(pf, PF_SAVED, PF_TYPED, n);
    pf_set(pf, PF_HAS, 0);
    tg[TPG_PF_IMG] = 0;
    if (res[0] == 1) {
        const img : u64 = pf_decode();
        if (img != 0) {
            tg[TPG_PF_IMG] = img;
            pf_set(pf, PF_HAS, 1);
        }
    }
}

/// CHOOSE PICTURE: the system file panel, the checks and the square PNG are prfh_pick's; the new picture is decoded
/// here, once. A cancelled panel says nothing; a failure keeps the picture and nickname that were there.
pub fn pf_choose(pf: []u8, tg: []u64) -> void {
    const had : bool = pf_has(pf);
    var code : u32 = prfh_pick(pf[PF_SAVED .. PF_SAVED + @as(usize, pf[PF_SLEN])], had);
    if (code == PRF_OK) {
        const img : u64 = pf_decode();
        if (img != 0) {
            if (tg[TPG_PF_IMG] != 0) { cg_image_release(tg[TPG_PF_IMG]); }
            tg[TPG_PF_IMG] = img;
            pf_set(pf, PF_HAS, 1);
            code = PRF_OK_SAVED;
        } else {
            code = PRF_E_UNREADABLE;
        }
    } else if (code == PRF_E_CANCELLED) {
        code = PRF_OK;
    }
    pf_set(pf, PF_CODE, code);
}

/// REMOVE PICTURE: the nickname stays; on a failure the picture stays.
pub fn pf_remove(pf: []u8, tg: []u64) -> void {
    var code : u32 = prfh_remove(pf[PF_SAVED .. PF_SAVED + @as(usize, pf[PF_SLEN])]);
    if (code == PRF_OK) {
        if (tg[TPG_PF_IMG] != 0) { cg_image_release(tg[TPG_PF_IMG]); }
        tg[TPG_PF_IMG] = 0;
        pf_set(pf, PF_HAS, 0);
        code = PRF_OK_SAVED;
    }
    pf_set(pf, PF_CODE, code);
}

/// The circle: the picture clipped to it (in colour, prf_colour_ok), else the initial on a dim disc, else an outline.
fn draw_pf_avatar(c: u64, kit: [48]u64, img: u64, nick: []const u8, nn: usize, cx: f64, cy: f64, r: f64, lit: bool, a: f64) -> void {
    const look : u32 = prf_look(img != 0, nick[0..nn]);
    var ring : f64 = lv(kit, THV_LABEL_WHITE);
    if (lit) { ring = lv(kit, THV_TEXT_WHITE); }
    if (look == PRF_LOOK_PICTURE) {
        cg_save(c);
        cg_arc(c, cx, cy, r, 0.0, TAU, 0);
        cg_close(c);
        cg_clip(c);
        cg_alpha(c, a);
        cg_translate(c, cx - r, cy + r);
        cg_scale(c, 1.0, -1.0);
        cg_draw_image(c, 0.0, 0.0, 2.0 * r, 2.0 * r, img);
        cg_restore(c);
    } else if (look == PRF_LOOK_LETTER) {
        cg_arc(c, cx, cy, r, 0.0, TAU, 0);
        cg_close(c);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, 0.14 * a);
        cg_fill_path(c);
        var ib : [4]u8 = undefined;
        const n : usize = prf_initial(nick[0..nn], ib[0..4]);
        const size : f64 = 1.0 * r;
        const w : f64 = bytes_w(kit, ib[0..4], n, size, WEIGHT_SEMIBOLD, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE) * a);
        draw_bytes(c, kit, ib[0..4], n, cx - 0.5 * w, cy + 0.36 * size, size, WEIGHT_SEMIBOLD, false);
    }
    cg_arc(c, cx, cy, r, 0.0, TAU, 0);
    cg_close(c);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, ring * a);
    cg_stroke_path(c);
}

/// A button of the PROFILE panel: the plate of the panel glass, a rounded outline, the word centred.
fn draw_pf_btn(c: u64, kit: [48]u64, bx: f64, by: f64, bw: f64, word: []const u8, n: usize, live: bool, sw: f64, over: bool) -> void {
    draw_plate(c, bx - 2.0, by - 2.0, bw + 4.0, PRF_BTN_H + 4.0, sw);
    round_rect(c, bx, by, bw, PRF_BTN_H, 5.0);
    var ink : f64 = lv(kit, THV_TEXT_WHITE);
    if (live == false) { ink = lv(kit, THV_MUTED_WHITE); }
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (over and live) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    cg_stroke_path(c);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, ink);
    const lw : f64 = bytes_w(kit, word, n, 9.5, WEIGHT_SEMIBOLD, false);
    draw_bytes(c, kit, word, n, bx + 0.5 * (bw - lw), by + 16.0, 9.5, WEIGHT_SEMIBOLD, false);
}

fn draw_profile_panel(c: u64, kit: [48]u64, sw: f64, sh: f64, mx: f64, my: f64, pf: []const u8, img: u64) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    const right : f64 = l + QP_W - QP_PAD;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_bytes(c, kit, "PROFILE", 7, x, t + 25.0, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    const has : bool = pf_has(pf);
    const d : f64 = prf_squeeze(t, sh);
    const u : f64 = t - d;
    const hit : u32 = prf_panel_hit_d(mx, my, l, QP_W, t, has, d);
    const editing : bool = pf_editing(pf);
    // the big circle always shows the SAVED nickname's initial; the field shows what is being typed
    draw_pf_avatar(c, kit, img, pf[PF_SAVED .. PF_SAVED + PRF_NICK_MAX_BYTES], @as(usize, pf[PF_SLEN]), prf_avatar_cx(l, QP_W), prf_avatar_cy_d(t, d), prf_avatar_r(d), hit == PRF_H_CHOOSE, 1.0);
    draw_pf_btn(c, kit, prf_btn_x(l, QP_W, 0), prf_btn_y(u), prf_btn_w(QP_W), "CHOOSE PICTURE", 14, true, sw, hit == PRF_H_CHOOSE);
    draw_pf_btn(c, kit, prf_btn_x(l, QP_W, 1), prf_btn_y(u), prf_btn_w(QP_W), "REMOVE PICTURE", 14, has, sw, hit == PRF_H_REMOVE);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_bytes(c, kit, "NICKNAME", 8, x, prf_label_y(u), 9.5, 0.0, false);
    // the field: a rounded outline, brighter while editing; the text is cut with an ellipsis before the right edge
    const fx : f64 = prf_field_x(l);
    const fy : f64 = prf_field_y(u);
    const fw : f64 = prf_field_w(QP_W);
    round_rect(c, fx, fy, fw, PRF_FIELD_H, 5.0);
    cg_line_width(c, 1.0);
    cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
    if (editing) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
    if (editing == false and hit == PRF_H_FIELD) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE)); }
    cg_stroke_path(c);
    const at : usize = pf_shown_at(pf);
    const sn : usize = pf_shown_len(pf);
    var shown : [PRF_NICK_MAX_BYTES + 2]u8 = undefined;
    var i : usize = 0;
    while (i < sn) {
        shown[i] = pf[at + i];
        i = i + 1;
    }
    var tn : usize = sn;
    if (editing) {
        shown[tn] = 95;
        tn = tn + 1;
    }
    if (tn > 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        draw_fit(c, kit, shown[0 .. PRF_NICK_MAX_BYTES + 2], tn, fx + 8.0, fy + 17.5, 11.0, 0.0, false, fx + fw - 8.0);
    } else {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_bytes(c, kit, "Type a nickname", 15, fx + 8.0, fy + 17.5, 11.0, 0.0, false);
    }
    draw_pf_btn(c, kit, prf_save_x(l), prf_save_y(u), PRF_SAVE_W, "SAVE", 4, true, sw, hit == PRF_H_SAVE);
    draw_pf_btn(c, kit, pf_cancel_x(l), prf_save_y(u), PRF_SAVE_W, "CANCEL", 6, editing, sw, editing and on_pf_cancel(mx, my, l, u));
    // the status line: the fixed line of prf_error_text, wrapped in the panel's width, at most three lines
    const msg : []const u8 = prf_error_text(pf_get(pf, PF_CODE));
    var from : usize = 0;
    var ln : u32 = 0;
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    while (from < msg.len and ln < 3) {
        const rest : []const u8 = msg[from .. msg.len];
        const base : f64 = prf_status_y(u) + 13.0 * @as(f64, @floatFromInt(ln));
        var cut : usize = wrap_at(kit, rest, rest.len, 9.5, 0.0, right - x);
        if (ln == 2) { cut = rest.len; }
        if (base < sh - 6.0) { draw_fit(c, kit, rest, cut, x, base, 9.5, 0.0, false, right); }
        from = from + cut;
        if (from < msg.len and msg[from] == 32) { from = from + 1; }
        ln = ln + 1;
    }
}

fn draw(c: u64, kit: [48]u64, frame: u32, state: u32, hov: u32, ma: f64, shown: u32, task: u32, space: u32, sp: u32, ss: u64, cur: u32, collapsed: bool, mx: f64, my: f64, z: f64, sw: f64, sh: f64, ws: u32, full: bool, qp: bool, ring: [8]u64, n: u32, now: u64, sug: u32, god: bool, glow: f64, dk: [128]u64, dp: bool, darmed: u32, doff: u32, dgo: u32, dlive: bool, dlabel: u64, tst: []const u32, tcells: []const u32, topen: u32, tcur: bool, kyp: bool, kstored: []const u32, kmask: []const u8, kmlen: []const u32, kst: []const u32, kfail: []const u32, kopen: []const u64, kedit: u32, kbuf: []const u8, klen: u32, karm: u32, kbusy: u32, kemask: u32, kewhy: u32, ktpick: u32, hs: u32, cons: bool, dc: []u64, gal: []const u8, gt: []const u32, evd: u32, evpk: u64, pb: []const u8, sst: []const u32, tg: []const u64, tb: []const u8) -> void {
    // RC. the QUEEN CHAT dock's open flag rides in its own region (draw is at its parameter limit)
    const rc : bool = tb[RC_FLAG] != 0;
    // evp, evn2 and evpr travel packed (the draw call is at the 64 parameter limit)
    const evp : u32 = @as(u32, @intCast(evpk % 1048576));
    const evn2 : u32 = @as(u32, @intCast(evpk / 1048576 % 1048576));
    const evpr : u32 = @as(u32, @intCast(evpk / 1099511627776));
    // P. the PROFILE panel is open while its flag byte in the text store says so
    const pfp : bool = tb[TBO_PF + PF_OPEN] != 0;
    draw_backdrop(c, sw, sh, full);
    const ha : f64 = 1.0 - ma;
    if (ha > 0.0) {
        draw_logo(c, home_c(0, z, sw, sh), home_c(1, z, sw, sh), home_k(z, sw, sh), anim_off(frame) * 1000.0, state, hov, ha);
        orbit_draw(c, kit, tg, mx, my, sw, sh, full, ha);
        if (hov == PETAL_CENTRE) { draw_centre_tip(c, kit, ha, z, sw, sh); } else if (hov != PETAL_NONE) { draw_tooltip(c, kit, hov, ha, z, sw, sh); }
    }
    if (ma > 0.0) {
        // the screen of petal `shown`: the chat workspace for the CHAT petal (index 2), a home tab for t27a ..
        // t27u, an empty frame with the petal's name for every other petal
        if (shown == PETAL_CHAT and cons == false) {
            draw_chat(c, kit, shown, task, space, sp, ss, cur, ma, collapsed, mx, my, sw, sh, ws, dlabel, dp, full, topen != PANE_NONE, sst, tb);
            // the pane's grid: in the QUEEN CHAT dock when it is docked, else across the content
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE and rc_docked(rc, cur, session_agent(ss, cur)) == false) { draw_term(c, kit, tst, tcells, tcur, ma, collapsed, sw, sh, ws, full, qp or dp or kyp or pfp, mx, my, tg); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE and sst[SST_SRV] != SRV_UP and rc_docked(rc, cur, session_agent(ss, cur)) == false) { draw_srv_banner(c, kit, sst[SST_SRV], content_x(ws, collapsed), WS_TOP + HEADER_H, content_w(sw, ws, collapsed, qp or dp or kyp or pfp), sh - WS_TOP - HEADER_H, mx, my, ma, full); }
            if (topen != PANE_NONE and sst[SST_LVSEL] == LV_NONE) { draw_light_dot(c, sw - 124.0, WS_TOP + 0.5 * HEADER_H, dot_light(topen == VIEW_EDITOR, pane_light_input(topen)), ma); }
            draw_qc_switch(c, kit, sw, ma, mx, my);
            draw_switch(c, kit, "CONSOLE >", sw, ma, mx, my);
        } else {
            draw_home(c, kit, shown, ma, collapsed, mx, my, sw, sh, ws, hs, dlabel, dp, full, dc, gal, gt, pb, tg, tb);
        }
    }
    if (ma > 0.0 and shown == PETAL_CHAT and cons == false and sst[SST_QDASH] != 0 and ws != WS_COMPACT) {
        draw_qdash(c, kit, tg, sst, tb, qd_area_x(ws, collapsed), WS_TOP, qd_area_w(sw, ws, collapsed, qp or dp or kyp or pfp), qd_area_h(sh), sw, mx, my, full, ma);
    }
    // exactly one right-hand panel is drawn (the Queen's, else DOCTOR's, else KEYS', else the QUEEN CHAT
    // dock): its ground first
    if (rc or qp or dp or kyp or pfp) { draw_panel_ground(c, sw, sh); }
    if (rc) { draw_rc(c, kit, sw, sh, mx, my, full, ma, tst, tcells, tcur, topen, tb); }
    if (qp) { draw_queen_panel(c, kit, sw, sh, mx, my, view_of(menu_open(state), shown), space, ss, cur, ring, n, now, sug, god, evd, evp, evn2, evpr); }
    if (dp and qp == false) {
        // sst[SST_DISK] is the free gigabytes plus 1, 0 until the volume has been read
        var dfree : u64 = DISK_UNKNOWN;
        if (sst[SST_DISK] > 0) { dfree = @as(u64, sst[SST_DISK] - 1); }
        draw_doctor_panel(c, kit, dk, sw, sh, mx, my, darmed, doff, dgo, dlive, dfree);
    }
    if (kyp and qp == false and dp == false) { draw_keys_panel(c, kit, sw, sh, mx, my, kstored, kmask, kmlen, kst, kfail, kopen, now, kedit, kbuf, klen, karm, kbusy, kemask, kewhy, ktpick); }
    if (pfp and qp == false and dp == false and kyp == false) { draw_profile_panel(c, kit, sw, sh, mx, my, tb[TBO_PF .. TBO_PF + PF_CAP], tg[TPG_PF_IMG]); }
    if (ma > 0.0) {
        var uws : u32 = ws;
        if (shown != PETAL_CHAT or cons) { uws = home_ws(ws); }
        draw_update_strip(c, kit, tg, mx, my, sh, uws, collapsed, ma);
        draw_update_toast(c, kit, tg, tg[TPG_NOW], sw, ma);
    }
    if (ma > 0.0) {
        draw_god_strip(c, kit, tg, sst, sw, sh, full, ma, god);
        draw_footer(c, kit, tg, sst, mx, my, sw, sh, full, ma, kyp, dlabel, dp);
    }
    draw_titlebar(c, kit, sw, full, ma, tg, god, mx, my, tb[TBO_PF .. TBO_PF + PF_CAP]);
    draw_edge_glow(c, sw, sh, glow, frame);
}

// ---- the DOCTOR host (doctor.t27): the handles it needs, made once, then the walk, the checks, the sums ----
// doctor.t27 decides; this block only lists folders, runs the command lines it names, reads their output and
// moves a confirmed folder to the Trash.

pub const NS_NOT_FOUND : u64 = 0x7fffffffffffffff;
pub const DK_SIZE : u32 = 128;
// columns, one entry per known repository, in discovery order
pub const DK_PATHS : u32 = 0;
pub const DK_FLAGS : u32 = 1;
pub const DK_KB : u32 = 2;
pub const DK_BUILD : u32 = 3;
pub const DK_REMOTE : u32 = 4;
pub const DK_BRANCH : u32 = 5;
pub const DK_MARK : u32 = 6;
// the walk queue
pub const DK_QUEUE : u32 = 7;
pub const DK_QDEPTH : u32 = 8;
pub const DK_QROOT : u32 = 9;
// sets and lists read from doctor.t27
pub const DK_SKIP : u32 = 10;
pub const DK_ALLOWED : u32 = 11;
pub const DK_AGENTS : u32 = 12;
pub const DK_JOBS : u32 = 13;
pub const DK_SLOTS : u32 = 14;
pub const DK_HIDDEN : u32 = 15;
pub const DK_ROWS : u32 = 16;
pub const DK_TASKS : u32 = 17;
pub const DK_TPATH : u32 = 18;
pub const DK_TJOB : u32 = 19;
pub const DK_OUTS : u32 = 20;
pub const DK_HOME : u32 = 21;
pub const DK_WORDS : u32 = 22;
pub const DK_FWORDS : u32 = 23;
pub const DK_KWORDS : u32 = 24;
pub const DK_NULL : u32 = 25;
pub const DK_EMPTY : u32 = 26;
pub const DK_FM : u32 = 27;
pub const DK_SEEDN : u32 = 28;
pub const DK_SEEDB : u32 = 29;
// strings
pub const DK_GIT : u32 = 30;
pub const DK_HEADF : u32 = 31;
pub const DK_WTS : u32 = 32;
pub const DK_DOT : u32 = 33;
pub const DK_SLASH : u32 = 34;
pub const DK_NL : u32 = 35;
pub const DK_MARKP : u32 = 36;
pub const DK_ARGSEP : u32 = 37;
pub const DK_STH : u32 = 38;
pub const DK_STHEAD : u32 = 39;
pub const DK_STSTASH : u32 = 40;
pub const DK_STEMRX : u32 = 41;
pub const DK_COMMA : u32 = 42;
pub const DK_SPACE : u32 = 43;
pub const DK_POINT : u32 = 44;
pub const DK_DEVNULL : u32 = 45;
pub const DK_WHITE : u32 = 46;
// classes
pub const DK_NUMBER : u32 = 47;
pub const DK_URL_CLS : u32 = 48;
pub const DK_STR_CLS : u32 = 49;
pub const DK_FH_CLS : u32 = 50;
pub const DK_TASK_CLS : u32 = 51;
pub const DK_DICT_CLS : u32 = 52;
pub const DK_CSET_CLS : u32 = 53;
// selectors
pub const DK_COUNT : u32 = 60;
pub const DK_AT : u32 = 61;
pub const DK_ADD : u32 = 62;
pub const DK_REMOVE_AT : u32 = 63;
pub const DK_REPLACE : u32 = 64;
pub const DK_INDEX : u32 = 65;
pub const DK_CONTAINS : u32 = 66;
pub const DK_NUM : u32 = 67;
pub const DK_VAL : u32 = 68;
pub const DK_APPEND_PATH : u32 = 69;
pub const DK_APPEND : u32 = 70;
pub const DK_EXISTS : u32 = 71;
pub const DK_PREFIX : u32 = 72;
pub const DK_RANGE : u32 = 73;
pub const DK_LAST : u32 = 74;
pub const DK_LIST : u32 = 75;
pub const DK_URL_PATH : u32 = 76;
pub const DK_IS_DIR : u32 = 77;
pub const DK_CLEAR : u32 = 78;
pub const DK_RUNNING : u32 = 79;
pub const DK_STATUS : u32 = 80;
pub const DK_LAUNCH : u32 = 81;
pub const DK_SET_LAUNCH : u32 = 82;
pub const DK_SET_ARGS : u32 = 83;
pub const DK_SET_OUT : u32 = 84;
pub const DK_SET_ERR : u32 = 85;
pub const DK_SET_IN : u32 = 86;
pub const DK_REPL : u32 = 87;
pub const DK_SPLIT : u32 = 88;
pub const DK_READ : u32 = 89;
pub const DK_CREATE : u32 = 90;
pub const DK_FH_WRITE : u32 = 91;
pub const DK_CLOSE : u32 = 92;
pub const DK_LONG : u32 = 93;
pub const DK_FILE_URL : u32 = 94;
pub const DK_TRASH : u32 = 95;
pub const DK_LENGTH : u32 = 96;
pub const DK_STRVAL : u32 = 97;
pub const DK_TRIM : u32 = 98;
pub const DK_PARENT : u32 = 99;
pub const DK_RX_REPL : u32 = 100;
pub const DK_CSET_COUNT : u32 = 101;
pub const DK_OBJ_FOR : u32 = 102;
pub const DK_SET_OBJ : u32 = 103;
pub const DK_WAIT : u32 = 104;
pub const DK_TILDE : u32 = 105;
pub const DK_NEW : u32 = 106;
pub const DK_RELEASE : u32 = 107;
pub const DK_SAME : u32 = 108;
pub const DK_FROM : u32 = 109;
pub const DK_SUB : u32 = 110;
pub const DK_TMPROOT : u32 = 111;
/// NSRegularExpressionSearch, and the slot the confirm-time re-check runs in (after the JOB_SLOTS).
pub const RX_SEARCH : u64 = 1024;
pub const NS_UTF8 : u64 = 4;
pub const SYNC_SLOT : u64 = 4;
pub const DOC_SUM_EVERY : u32 = 30;

fn dk_num(dk: [128]u64, x: u64) -> u64 {
    return msg1(dk[DK_NUMBER], dk[DK_NUM], x);
}

fn dk_at(dk: [128]u64, arr: u64, i: u64) -> u64 {
    return msg1(arr, dk[DK_AT], i);
}

fn dk_count(dk: [128]u64, arr: u64) -> u64 {
    return msg0(arr, dk[DK_COUNT]);
}

/// Column k, row i, as a number.
fn dk_get(dk: [128]u64, k: u32, i: u64) -> u64 {
    return msg0(dk_at(dk, dk[k], i), dk[DK_VAL]);
}

fn dk_set(dk: [128]u64, k: u32, i: u64, x: u64) -> void {
    msg2(dk[k], dk[DK_REPLACE], i, dk_num(dk, x));
}

fn dk_flags(dk: [128]u64, i: u64) -> u32 {
    return @as(u32, @intCast(dk_get(dk, DK_FLAGS, i)));
}

fn dk_put_flags(dk: [128]u64, i: u64, f: u32) -> void {
    dk_set(dk, DK_FLAGS, i, @as(u64, f));
}

fn dk_exists(dk: [128]u64, p: u64) -> bool {
    return msg_test1(dk[DK_FM], dk[DK_EXISTS], p);
}

fn dk_len(dk: [128]u64, s: u64) -> u64 {
    return msg0(s, dk[DK_LENGTH]);
}

/// A new owned NSMutableArray holding `n` copies of `fill`.
fn dk_array(dk: [128]u64, cls_m: u64, n: u64, fill: u64) -> u64 {
    const a : u64 = msg0(cls_m, dk[DK_NEW]);
    var i : u64 = 0;
    while (i < n) {
        msg1(a, dk[DK_ADD], fill);
        i = i + 1;
    }
    return a;
}

/// Repository p was seen on pass `pass`: mark it, or add it with what its folder says about it.
fn dk_register(dk: [128]u64, p: u64, pass: u64) -> void {
    const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
    if (i != NS_NOT_FOUND) {
        dk_set(dk, DK_MARK, i, pass);
        return;
    }
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    if (n >= @as(u64, LIST_MAX)) { return; }
    const git : u64 = msg1(p, dk[DK_APPEND_PATH], dk[DK_GIT]);
    var f : u32 = 0;
    f = with_flag(f, F_WORKTREE, dk_exists(dk, msg1(git, dk[DK_APPEND_PATH], dk[DK_HEADF])) == false);
    f = with_flag(f, F_HAS_WORKTREES, dk_exists(dk, msg1(git, dk[DK_APPEND_PATH], dk[DK_WTS])));
    const slashed : u64 = msg1(p, dk[DK_APPEND], dk[DK_SLASH]);
    const na : u64 = dk_count(dk, dk[DK_AGENTS]);
    var a : u64 = 0;
    while (a < na) {
        if (msg1(slashed, dk[DK_RANGE], dk_at(dk, dk[DK_AGENTS], a)) != NS_NOT_FOUND) { f = with_flag(f, DOC_F_AGENT, true); }
        a = a + 1;
    }
    // a repository below another: the outer one holds it
    var j : u64 = 0;
    while (j < n) {
        const q : u64 = dk_at(dk, dk[DK_PATHS], j);
        const qs : u64 = msg1(q, dk[DK_APPEND], dk[DK_SLASH]);
        if (msg_test1(slashed, dk[DK_PREFIX], qs)) { dk_put_flags(dk, j, with_flag(dk_flags(dk, j), F_NESTS, true)); }
        if (msg_test1(qs, dk[DK_PREFIX], slashed)) { f = with_flag(f, F_NESTS, true); }
        j = j + 1;
    }
    msg1(dk[DK_PATHS], dk[DK_ADD], p);
    msg1(dk[DK_FLAGS], dk[DK_ADD], dk_num(dk, @as(u64, f)));
    msg1(dk[DK_KB], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_BUILD], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_REMOTE], dk[DK_ADD], dk[DK_EMPTY]);
    msg1(dk[DK_BRANCH], dk[DK_ADD], dk[DK_EMPTY]);
    msg1(dk[DK_MARK], dk[DK_ADD], dk_num(dk, pass));
}

/// Forget repository i; a space bound to it lets go.
fn dk_drop(dk: [128]u64, i: u64) -> void {
    const p : u64 = dk_at(dk, dk[DK_PATHS], i);
    const s : u64 = msg1(dk[DK_SLOTS], dk[DK_INDEX], p);
    if (s != NS_NOT_FOUND) { msg2(dk[DK_SLOTS], dk[DK_REPLACE], s, dk[DK_EMPTY]); }
    msg1(dk[DK_FLAGS], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_KB], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_BUILD], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_REMOTE], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_BRANCH], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_MARK], dk[DK_REMOVE_AT], i);
    msg1(dk[DK_PATHS], dk[DK_REMOVE_AT], i);
}

/// Queue the roots of a new pass.
fn dk_start_pass(dk: [128]u64) -> void {
    msg1(dk[DK_QUEUE], dk[DK_ADD], dk[DK_HOME]);
    msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, ROOT_HOME)));
    msg1(dk[DK_QUEUE], dk[DK_ADD], dk[DK_TMPROOT]);
    msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, 0));
    msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, ROOT_TMP)));
}

/// Walk up to SCAN_BUDGET queued folders from `head`; returns the new head.
fn dk_walk(dk: [128]u64, head: u64, pass: u64) -> u64 {
    var h : u64 = head;
    var b : u32 = 0;
    while (b < SCAN_BUDGET and h < dk_count(dk, dk[DK_QUEUE])) {
        const p : u64 = dk_at(dk, dk[DK_QUEUE], h);
        const d : u32 = @as(u32, @intCast(dk_get(dk, DK_QDEPTH, h)));
        const r : u32 = @as(u32, @intCast(dk_get(dk, DK_QROOT, h)));
        h = h + 1;
        b = b + 1;
        if (dk_exists(dk, msg1(p, dk[DK_APPEND_PATH], dk[DK_GIT]))) { dk_register(dk, p, pass); }
        const kids : u64 = msg4(dk[DK_FM], dk[DK_LIST], msg1(dk[DK_URL_CLS], dk[DK_FILE_URL], p), 0, 0, 0);
        if (kids != 0) {
            const nk : u64 = dk_count(dk, kids);
            var k : u64 = 0;
            while (k < nk) {
                const u : u64 = dk_at(dk, kids, k);
                if (msg_test(u, dk[DK_IS_DIR])) {
                    const name : u64 = msg0(u, dk[DK_LAST]);
                    const skipped : bool = msg_test1(dk[DK_SKIP], dk[DK_CONTAINS], name);
                    const hidden : bool = msg_test1(name, dk[DK_PREFIX], dk[DK_DOT]);
                    const allowed : bool = msg_test1(dk[DK_ALLOWED], dk[DK_CONTAINS], name);
                    if (enters(r, d + 1, skipped, hidden, allowed)) {
                        msg1(dk[DK_QUEUE], dk[DK_ADD], msg1(p, dk[DK_APPEND_PATH], name));
                        msg1(dk[DK_QDEPTH], dk[DK_ADD], dk_num(dk, @as(u64, d + 1)));
                        msg1(dk[DK_QROOT], dk[DK_ADD], dk_num(dk, @as(u64, r)));
                    }
                }
                k = k + 1;
            }
        }
    }
    return h;
}

/// End of a pass: forget every repository it did not see; returns how many went.
fn dk_sweep(dk: [128]u64, pass: u64) -> u64 {
    var gone : u64 = 0;
    var i : u64 = dk_count(dk, dk[DK_PATHS]);
    while (i > 0) {
        i = i - 1;
        if (dk_get(dk, DK_MARK, i) != pass) {
            dk_drop(dk, i);
            gone = gone + 1;
        }
    }
    msg0(dk[DK_QUEUE], dk[DK_CLEAR]);
    msg0(dk[DK_QDEPTH], dk[DK_CLEAR]);
    msg0(dk[DK_QROOT], dk[DK_CLEAR]);
    return gone;
}

/// Start job j on repository p in output slot `slot`; returns the task, 0 when the output file cannot open.
fn dk_launch(dk: [128]u64, slot: u64, p: u64, j: u32) -> u64 {
    const out : u64 = dk_at(dk, dk[DK_OUTS], slot);
    msg3(dk[DK_FM], dk[DK_CREATE], out, 0, 0);
    const fh : u64 = msg1(dk[DK_FH_CLS], dk[DK_FH_WRITE], out);
    if (fh == 0) { return 0; }
    const line : u64 = dk_at(dk, dk[DK_JOBS], @as(u64, j));
    const words : u64 = msg1(msg2(line, dk[DK_REPL], dk[DK_MARKP], p), dk[DK_SPLIT], dk[DK_ARGSEP]);
    const nw : u64 = dk_count(dk, words);
    const t : u64 = msg0(dk[DK_TASK_CLS], dk[DK_NEW]);
    msg1(t, dk[DK_SET_LAUNCH], dk_at(dk, words, 0));
    msg1(t, dk[DK_SET_ARGS], msg2(words, dk[DK_SUB], 1, nw - 1));
    msg1(t, dk[DK_SET_OUT], fh);
    // lsof's complaints join its pids: a failed run prints text, which reads as "in use" (the check fails closed);
    // a normal run prints nothing on stderr (measured 2026-10-25)
    if (j == JOB_LIVE) {
        msg1(t, dk[DK_SET_ERR], fh);
    } else {
        msg1(t, dk[DK_SET_ERR], dk[DK_DEVNULL]);
    }
    msg1(t, dk[DK_SET_IN], dk[DK_DEVNULL]);
    msg0(t, dk[DK_LAUNCH]);
    msg0(fh, dk[DK_CLOSE]);
    msg2(dk[DK_TPATH], dk[DK_REPLACE], slot, p);
    msg2(dk[DK_TJOB], dk[DK_REPLACE], slot, dk_num(dk, @as(u64, j)));
    return t;
}

/// A finished job in slot `slot` exited with `code`: read its output into the repository's columns.
fn dk_take(dk: [128]u64, slot: u64, code: u64) -> void {
    const p : u64 = dk_at(dk, dk[DK_TPATH], slot);
    const j : u32 = @as(u32, @intCast(dk_get(dk, DK_TJOB, slot)));
    const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
    if (i == NS_NOT_FOUND) { return; }
    const out : u64 = msg3(dk[DK_STR_CLS], dk[DK_READ], dk_at(dk, dk[DK_OUTS], slot), NS_UTF8, 0);
    if (out == 0) { return; }
    var f : u32 = dk_flags(dk, i);
    if (j == JOB_STATUS and code == 0) {
        f = with_flag(f, F_CHECKED, true);
        const lines : u64 = msg1(out, dk[DK_SPLIT], dk[DK_NL]);
        const nl : u64 = dk_count(dk, lines);
        var dirty : bool = false;
        var stash : bool = false;
        var k : u64 = 0;
        while (k < nl) {
            const ln : u64 = dk_at(dk, lines, k);
            if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STHEAD])) {
                msg2(dk[DK_BRANCH], dk[DK_REPLACE], i, msg1(ln, dk[DK_FROM], dk_len(dk, dk[DK_STHEAD])));
            } else if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STSTASH])) {
                stash = true;
            } else if (msg_test1(ln, dk[DK_PREFIX], dk[DK_STH]) == false and dk_len(dk, ln) > 0) {
                dirty = true;
            }
            k = k + 1;
        }
        f = with_flag(f, F_DIRTY, dirty);
        f = with_flag(f, F_STASH, stash);
    }
    if (j == JOB_UNPUSHED and code == 0) {
        f = with_flag(f, F_PUSH_CHECKED, true);
        f = with_flag(f, F_UNPUSHED, dk_len(dk, msg1(out, dk[DK_TRIM], dk[DK_WHITE])) > 0);
    }
    // lsof exits 1 whether or not it printed a pid, so only its output counts (stderr is joined to it, see dk_launch);
    // a code above 1 is no answer
    if (j == JOB_LIVE and code <= 1) {
        f = with_flag(f, F_IN_USE_CHECKED, true);
        f = with_flag(f, F_IN_USE, dk_len(dk, msg1(out, dk[DK_TRIM], dk[DK_WHITE])) > 0);
    }
    if (j == JOB_REMOTE) {
        if (code == 0) {
            msg2(dk[DK_REMOTE], dk[DK_REPLACE], i, msg1(out, dk[DK_TRIM], dk[DK_WHITE]));
        } else {
            msg2(dk[DK_REMOTE], dk[DK_REPLACE], i, dk[DK_EMPTY]);
        }
        f = with_flag(f, F_NO_REMOTE, code != 0);
    }
    if (j == JOB_SIZE) {
        dk_set(dk, DK_KB, i, msg0(out, dk[DK_LONG]));
    }
    if (j == JOB_BUILD) {
        const lines : u64 = msg1(out, dk[DK_SPLIT], dk[DK_NL]);
        const nl : u64 = dk_count(dk, lines);
        var sum : u64 = 0;
        var k : u64 = 0;
        while (k < nl) {
            sum = sum + msg0(dk_at(dk, lines, k), dk[DK_LONG]);
            k = k + 1;
        }
        dk_set(dk, DK_BUILD, i, sum);
    }
    dk_put_flags(dk, i, f);
}

/// Run job j on repository i now and wait for it (the confirm-time re-check).
fn dk_run_now(dk: [128]u64, i: u64, j: u32) -> void {
    const t : u64 = dk_launch(dk, SYNC_SLOT, dk_at(dk, dk[DK_PATHS], i), j);
    if (t == 0) { return; }
    msg0(t, dk[DK_WAIT]);
    dk_take(dk, SYNC_SLOT, msg0(t, dk[DK_STATUS]) % 4294967296);
    msg0(t, dk[DK_RELEASE]);
}

/// A folder name with its copy suffix stripped.
fn dk_stem(dk: [128]u64, name: u64) -> u64 {
    return msg5(name, dk[DK_RX_REPL], dk[DK_STEMRX], dk[DK_EMPTY], RX_SEARCH, 0, dk_len(dk, name));
}

fn dk_stem_key(dk: [128]u64, p: u64) -> u64 {
    return msg1(msg0(p, dk[DK_PARENT]), dk[DK_APPEND_PATH], dk_stem(dk, msg0(p, dk[DK_LAST])));
}

/// The derived flags and the DOCTOR row order, from the columns; returns how many rows can go.
fn dk_recompute(dk: [128]u64) -> u32 {
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    const keepers : u64 = msg0(dk[DK_DICT_CLS], dk[DK_NEW]);
    const stems : u64 = msg0(dk[DK_CSET_CLS], dk[DK_NEW]);
    var i : u64 = 0;
    while (i < n) {
        const p : u64 = dk_at(dk, dk[DK_PATHS], i);
        var f : u32 = dk_flags(dk, i);
        f = with_flag(f, F_DUP, false);
        f = with_flag(f, F_REPEATED, false);
        f = with_flag(f, F_HEAVY, heavy(dk_get(dk, DK_KB, i)));
        f = with_flag(f, F_BUILD, build_heavy(dk_get(dk, DK_BUILD, i)));
        f = with_flag(f, F_BOUND, msg_test1(dk[DK_SLOTS], dk[DK_CONTAINS], p));
        f = with_flag(f, F_HIDDEN, msg_test1(dk[DK_HIDDEN], dk[DK_CONTAINS], p));
        dk_put_flags(dk, i, f);
        const rem : u64 = dk_at(dk, dk[DK_REMOTE], i);
        if (dup_candidate(f) and dk_len(dk, rem) > 0) {
            const b : u64 = msg1(keepers, dk[DK_OBJ_FOR], rem);
            if (b == 0) {
                msg2(keepers, dk[DK_SET_OBJ], dk_num(dk, i), rem);
            } else if (keeper_rank(f) < keeper_rank(dk_flags(dk, msg0(b, dk[DK_VAL])))) {
                msg2(keepers, dk[DK_SET_OBJ], dk_num(dk, i), rem);
            }
        }
        msg1(stems, dk[DK_ADD], dk_stem_key(dk, p));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        const p : u64 = dk_at(dk, dk[DK_PATHS], i);
        var f : u32 = dk_flags(dk, i);
        const rem : u64 = dk_at(dk, dk[DK_REMOTE], i);
        if (dup_candidate(f) and dk_len(dk, rem) > 0) {
            f = with_flag(f, F_DUP, msg0(msg1(keepers, dk[DK_OBJ_FOR], rem), dk[DK_VAL]) != i);
        }
        const name : u64 = msg0(p, dk[DK_LAST]);
        const suffixed : bool = msg_test1(name, dk[DK_SAME], dk_stem(dk, name)) == false;
        const cnt : u64 = msg1(stems, dk[DK_CSET_COUNT], dk_stem_key(dk, p));
        f = with_flag(f, F_REPEATED, made_again(@as(u32, @intCast(cnt)), suffixed));
        dk_put_flags(dk, i, f);
        i = i + 1;
    }
    msg0(keepers, dk[DK_RELEASE]);
    msg0(stems, dk[DK_RELEASE]);
    msg0(dk[DK_ROWS], dk[DK_CLEAR]);
    var go : u32 = 0;
    var g : u32 = 0;
    while (g < ROW_GROUPS) {
        i = 0;
        while (i < n) {
            const f : u32 = dk_flags(dk, i);
            if (row_group(f) == g) {
                msg1(dk[DK_ROWS], dk[DK_ADD], dk_num(dk, i));
                if (g == ROW_REMOVABLE) { go = go + 1; }
            }
            i = i + 1;
        }
        g = g + 1;
    }
    return go;
}

/// Bind space slot s to the first repository not in a slot whose bind rank is at most `most`; whether one was.
fn dk_bind(dk: [128]u64, s: u32, most: u32) -> bool {
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    var rank : u32 = RANK_AUTO;
    while (rank <= most) {
        var i : u64 = 0;
        while (i < n) {
            const p : u64 = dk_at(dk, dk[DK_PATHS], i);
            var f : u32 = dk_flags(dk, i);
            f = with_flag(f, F_HIDDEN, msg_test1(dk[DK_HIDDEN], dk[DK_CONTAINS], p));
            if (bind_rank(f) == rank and msg_test1(dk[DK_SLOTS], dk[DK_CONTAINS], p) == false) {
                msg2(dk[DK_SLOTS], dk[DK_REPLACE], @as(u64, s), p);
                return true;
            }
            i = i + 1;
        }
        rank = rank + 1;
    }
    return false;
}

/// The sidebar names and branches of the six slots: the bound folder's name and branch, else the seed words.
fn dk_names(dk: [128]u64, names: u64, branches: u64) -> void {
    var s : u64 = 0;
    while (s < @as(u64, SPACE_COUNT)) {
        const p : u64 = dk_at(dk, dk[DK_SLOTS], s);
        if (dk_len(dk, p) > 0) {
            msg2(names, dk[DK_REPLACE], s, msg0(p, dk[DK_LAST]));
            const i : u64 = msg1(dk[DK_PATHS], dk[DK_INDEX], p);
            if (i == NS_NOT_FOUND) {
                msg2(branches, dk[DK_REPLACE], s, dk[DK_EMPTY]);
            } else {
                msg2(branches, dk[DK_REPLACE], s, dk_at(dk, dk[DK_BRANCH], i));
            }
        } else {
            msg2(names, dk[DK_REPLACE], s, dk_at(dk, dk[DK_SEEDN], s));
            msg2(branches, dk[DK_REPLACE], s, dk_at(dk, dk[DK_SEEDB], s));
        }
        s = s + 1;
    }
}

/// Move repository i to the Trash if it is still removable after re-checking it now; whether it went.
fn dk_trash(dk: [128]u64, i: u64) -> bool {
    // forget the earlier answers first, so a check that fails now keeps the folder as "checking"
    dk_put_flags(dk, i, with_flag(with_flag(with_flag(dk_flags(dk, i), F_CHECKED, false), F_PUSH_CHECKED, false), F_IN_USE_CHECKED, false));
    dk_run_now(dk, i, JOB_STATUS);
    dk_run_now(dk, i, JOB_UNPUSHED);
    dk_run_now(dk, i, JOB_LIVE);
    if (removable(dk_flags(dk, i)) == false) { return false; }
    const url : u64 = msg1(dk[DK_URL_CLS], dk[DK_FILE_URL], dk_at(dk, dk[DK_PATHS], i));
    if (msg3(dk[DK_FM], dk[DK_TRASH], url, 0, 0) % 256 != 1) { return false; }
    dk_drop(dk, i);
    return true;
}

/// "12 MB" or "1.5 GB".
fn dk_size(dk: [128]u64, kb: u64) -> u64 {
    const whole : u64 = msg0(dk_num(dk, size_whole(kb)), dk[DK_STRVAL]);
    if (size_in_gb(kb)) {
        const t : u64 = msg1(msg1(whole, dk[DK_APPEND], dk[DK_POINT]), dk[DK_APPEND], msg0(dk_num(dk, size_tenth(kb)), dk[DK_STRVAL]));
        return msg1(msg1(t, dk[DK_APPEND], dk[DK_SPACE]), dk[DK_APPEND], dk_at(dk, dk[DK_WORDS], @as(u64, DL_GB)));
    }
    return msg1(msg1(whole, dk[DK_APPEND], dk[DK_SPACE]), dk[DK_APPEND], dk_at(dk, dk[DK_WORDS], @as(u64, DL_MB)));
}

/// The flag words a row prints, joined with ", ".
fn dk_flag_words(dk: [128]u64, f: u32) -> u64 {
    var s : u64 = dk[DK_EMPTY];
    var k : u32 = 0;
    while (k < FLAG_BITS) {
        if (shows_word(f, k)) {
            if (dk_len(dk, s) > 0) { s = msg1(s, dk[DK_APPEND], dk[DK_COMMA]); }
            s = msg1(s, dk[DK_APPEND], dk_at(dk, dk[DK_FWORDS], @as(u64, k)));
        }
        k = k + 1;
    }
    return s;
}

fn dk_word(dk: [128]u64, k: u32) -> u64 {
    return dk_at(dk, dk[DK_WORDS], @as(u64, k));
}

/// "n" as a string.
fn dk_int(dk: [128]u64, n: u64) -> u64 {
    return msg0(dk_num(dk, n), dk[DK_STRVAL]);
}

fn dk_cat(dk: [128]u64, a: u64, b: u64) -> u64 {
    return msg1(a, dk[DK_APPEND], b);
}

/// The repository whose remove button is under (x, y) in the DOCTOR panel, NS_NOT_FOUND when none is.
fn dk_btn_at(dk: [128]u64, x: f64, y: f64, sw: f64, sh: f64, off: u32) -> u64 {
    const l : f64 = qp_left(sw);
    const rows : u32 = doc_rows(sh, WS_TOP);
    const total : u64 = dk_count(dk, dk[DK_ROWS]);
    var r : u32 = 0;
    while (r < rows and @as(u64, off + r) < total) {
        const i : u64 = dk_get(dk, DK_ROWS, @as(u64, off + r));
        if (removable(dk_flags(dk, i)) and on_doc_btn(x, y, l, QP_W, QP_PAD, WS_TOP, r)) { return i; }
        r = r + 1;
    }
    return NS_NOT_FOUND;
}

/// W. DOCTOR n at the right end of the sidebar foot (doctor.t27 on_doc_link).
pub fn on_doctor_link(x: f64, y: f64, sw: f64, sh: f64) -> bool {
    return on_doc(x, y, sw, sh);
}

/// D. The DOCTOR panel, where the Queen panel sits: the summary, then one row per repository worth naming --
/// the ones that can go first, each with its own remove button that asks once more before it moves the
/// folder to the Trash.
fn draw_doctor_panel(c: u64, kit: [48]u64, dk: [128]u64, sw: f64, sh: f64, mx: f64, my: f64, armed: u32, off: u32, go: u32, live: bool, free_gb: u64) -> void {
    const l : f64 = qp_left(sw);
    const t : f64 = WS_TOP;
    const x : f64 = l + QP_PAD;
    // the ground is draw_panel_ground's, drawn once before the panel
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, l, t, HAIR, sh - t);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
    draw_text(c, kit, dk_word(dk, DL_TITLE), x, t + DOC_HEAD_Y, 11.5, WEIGHT_SEMIBOLD, false);
    draw_close_x(c, sw - QP_PAD - 8.0, t + 20.0, on_panel_close(mx, my, sw, t), 1.0);
    // the summary: how many repositories, how many answered both checks, how many can go, and the walk
    const n : u64 = dk_count(dk, dk[DK_PATHS]);
    var checked : u64 = 0;
    var reclaim : u64 = 0;
    var i : u64 = 0;
    while (i < n) {
        const f : u32 = dk_flags(dk, i);
        if (answered(f)) { checked = checked + 1; }
        reclaim = reclaim + reclaimable_kb(f, dk_get(dk, DK_KB, i));
        i = i + 1;
    }
    var s : u64 = dk_cat(dk, dk_cat(dk, dk_int(dk, n), dk[DK_SPACE]), dk_word(dk, DL_REPOS));
    s = dk_cat(dk, dk_cat(dk, dk_cat(dk, s, dk[DK_COMMA]), dk_int(dk, checked)), dk[DK_SPACE]);
    s = dk_cat(dk, s, dk_word(dk, DL_CHECKED));
    s = dk_cat(dk, dk_cat(dk, dk_cat(dk, s, dk[DK_COMMA]), dk_int(dk, @as(u64, go))), dk[DK_SPACE]);
    s = dk_cat(dk, s, dk_word(dk, DL_CAN_GO));
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
    draw_text(c, kit, s, x, t + DOC_SUM_Y, 10.0, 0.0, false);
    var phase : u32 = DL_WATCHING;
    if (live) { phase = DL_SCANNING; }
    // the second line: "low disk" first when the volume is under the floor, then the phase, then what the
    // removable rows would give back
    var s2 : u64 = dk_word(dk, phase);
    if (disk_low(free_gb)) { s2 = dk_cat(dk, dk_cat(dk, dk_word(dk, DL_LOW), dk[DK_COMMA]), s2); }
    if (reclaim > 0) {
        s2 = dk_cat(dk, dk_cat(dk, s2, dk[DK_COMMA]), dk_size(dk, reclaim));
        s2 = dk_cat(dk, dk_cat(dk, s2, dk[DK_SPACE]), dk_word(dk, DL_RECLAIM));
    }
    draw_text(c, kit, s2, x, t + DOC_SUM_Y + 16.0, 9.5, 0.0, false);
    cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
    cg_fill_rect(c, x, t + DOC_ROWS_Y - 6.0, QP_W - 2.0 * QP_PAD, HAIR);
    const total : u64 = dk_count(dk, dk[DK_ROWS]);
    if (total == 0) {
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_text(c, kit, dk_word(dk, DL_NOTHING), x, doc_row_top(t, 0) + 16.0, 10.0, 0.0, false);
        return;
    }
    const rows : u32 = doc_rows(sh, t);
    const bx : f64 = doc_btn_x(l, QP_W, QP_PAD);
    var r : u32 = 0;
    while (r < rows and @as(u64, off + r) < total) {
        const ri : u64 = dk_get(dk, DK_ROWS, @as(u64, off + r));
        const f : u32 = dk_flags(dk, ri);
        const p : u64 = dk_at(dk, dk[DK_PATHS], ri);
        const y : f64 = doc_row_top(t, r);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
        const nw : f64 = draw_text(c, kit, msg0(p, dk[DK_LAST]), x, y + 14.0, 11.5, WEIGHT_SEMIBOLD, false);
        const kb : u64 = dk_get(dk, DK_KB, ri);
        if (kb > 0) {
            cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
            draw_text(c, kit, dk_size(dk, kb), x + nw + 8.0, y + 14.0, 9.5, 0.0, true);
        }
        // why it is named: what keeps it, or the words for what it is
        var why : u64 = dk_flag_words(dk, f);
        if (leftover(f) and keep_reason(f) != KEEP_NONE) { why = dk_at(dk, dk[DK_KWORDS], @as(u64, keep_reason(f))); }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_MUTED_WHITE));
        draw_text(c, kit, why, x, y + 29.0, 9.5, 0.0, false);
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LABEL_WHITE));
        draw_text(c, kit, msg0(p, dk[DK_TILDE]), x, y + 42.0, 8.5, 0.0, true);
        if (removable(f)) {
            const by : f64 = y + DOC_BTN_Y;
            const over : bool = on_doc_btn(mx, my, l, QP_W, QP_PAD, t, r);
            var word : u32 = DL_REMOVE;
            if (armed == @as(u32, @intCast(ri))) { word = DL_CONFIRM; }
            // a plate of the panel's glass first, so a long line under the button does not show through it
            draw_plate(c, bx - 6.0, by - 2.0, DOC_BTN_W + 6.0, DOC_BTN_H + 4.0, sw);
            round_rect(c, bx, by, DOC_BTN_W, DOC_BTN_H, 5.0);
            if (word == DL_CONFIRM) {
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
                cg_fill_path(c);
                cg_fill_rgba(c, 0.0, 0.0, 0.0, 1.0);
            } else {
                cg_line_width(c, 1.0);
                cg_stroke_rgba(c, 1.0, 1.0, 1.0, STRICT_HOVER_EDGE);
                if (over) { cg_stroke_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE)); }
                cg_stroke_path(c);
                cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_TEXT_WHITE));
            }
            const lbl : u64 = dk_word(dk, word);
            const lw : f64 = text_w(kit, lbl, 9.5, WEIGHT_SEMIBOLD, false);
            draw_text(c, kit, lbl, bx + (DOC_BTN_W - lw) / 2.0, by + 13.5, 9.5, WEIGHT_SEMIBOLD, false);
        }
        cg_fill_rgba(c, 1.0, 1.0, 1.0, lv(kit, THV_LINE_WHITE));
        cg_fill_rect(c, x, y + DOC_ROW_H - 2.0, QP_W - 2.0 * QP_PAD, HAIR);
        r = r + 1;
    }
}

// ---- the dashboard's background work: the gallery text, the card files, the live web view ----

fn gallery_load(dc: []u64, gal: []u8, gt: []u32, hb: []const u8) -> void {
    var pb : [512]u8 = undefined;
    put_gallery_path(hb, pb[0..512]);
    const fd : i32 = sys_open_ro(pb[0..512], 0);
    if (fd < 0) { return; }
    const r : i64 = sys_read(fd, gal, @as(u64, GAL_MAX));
    sys_close(fd);
    if (r <= 0) { return; }
    const g : u32 = gal_parse(gal, @as(usize, @intCast(r)), gt);
    if (g > 0 and gal_mapped(gt) > 0) {
        dc[D_GN] = @as(u64, g);
        dc[D_GEN] = dc[D_GEN] + 1;
    }
}

/// Start `/usr/bin/curl -sfL -o <file>.part <url>` for widget wi (WIDGET_COUNT: the gallery) in slot `slot`
/// without waiting for it.
fn dash_spawn(dc: []u64, gal: []const u8, gt: []const u32, hb: []const u8, jp: []u32, jwi: []u32, slot: u32, wi: u32) -> void {
    var fb : [512]u8 = undefined;
    var ub : [320]u8 = undefined;
    var pb : [520]u8 = undefined;
    var fnn : usize = 0;
    var un : usize = 0;
    if (wi == WIDGET_COUNT) {
        fnn = put_gallery_path(hb, fb[0..512]);
        un = put_gallery_url(ub[0..320]);
    } else {
        fnn = put_card_path(hb, gal, gt, wi, fb[0..512]);
        un = put_card_url(gal, gt, wi, ub[0..320]);
    }
    if (un == 0) {
        if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FAILED; }
        return;
    }
    const pn : usize = put_part(fb[0..512], fnn, pb[0..520]);
    var ab : [1024]u8 = undefined;
    var offs : [8]u32 = undefined;
    put_argv(pb[0..520], pn, ub[0..320], un, ab[0..1024], offs[0..8]);
    var argv : [8]u64 = undefined;
    var k : u32 = 0;
    while (k < 7) {
        argv[k] = sys_addr(ab[@as(usize, offs[k]) .. 1024], ab[0..1], 0);
        k = k + 1;
    }
    argv[7] = 0;
    var cp : [16]u8 = undefined;
    put_bytes(cp[0..16], 0, "/usr/bin/curl");
    cp[13] = 0;
    var pid : [2]u32 = undefined;
    pid[0] = 0;
    const rc : i32 = sys_spawn(pid, cp[0..16], 0, 0, argv, 0);
    if (rc != 0 or pid[0] == 0) {
        if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FAILED; }
        return;
    }
    jp[slot] = pid[0];
    jwi[slot] = wi;
    if (wi < WIDGET_COUNT) { dc[D_ST + wi] = WS_FETCH; }
}

/// Once a second: reap finished fetches (rename the .part file on success), read the gallery when it is
/// there, ask for it when it is not, and start the fetches the draw asked for (at most FETCH_SLOTS at once).
fn dash_tick(dc: []u64, gal: []u8, gt: []u32, hb: []const u8, jp: []u32, jwi: []u32, now: u64) -> void {
    if (dc[D_LAST] == now) { return; }
    dc[D_LAST] = now;
    var st : [2]u32 = undefined;
    var busy_gallery : bool = false;
    var j : u32 = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) {
            st[0] = 0;
            // a bad pid word is a finished fetch (-1, as waitpid answers for a pid that is not a child), never reaped
            var r : i32 = -1;
            if (pid_ok(@as(u64, jp[j]))) { r = sys_waitpid(@as(i32, @intCast(jp[j])), st, 1); }
            if (r != 0) {
                const wi : u32 = jwi[j];
                var fb : [512]u8 = undefined;
                var pb : [520]u8 = undefined;
                var fnn : usize = 0;
                if (wi == WIDGET_COUNT) {
                    fnn = put_gallery_path(hb, fb[0..512]);
                } else {
                    fnn = put_card_path(hb, gal, gt, wi, fb[0..512]);
                }
                put_part(fb[0..512], fnn, pb[0..520]);
                const ok : bool = r > 0 and st[0] == 0;
                if (ok) { sys_rename(pb[0..520], fb[0..512]); } else { sys_unlink(pb[0..520]); }
                if (wi == WIDGET_COUNT) {
                    if (ok) { gallery_load(dc, gal, gt, hb); }
                } else if (ok) {
                    dc[D_ST + wi] = WS_NEW;
                } else {
                    dc[D_ST + wi] = WS_FAILED;
                }
                dc[D_GEN] = dc[D_GEN] + 1;
                jp[j] = 0;
            } else if (jwi[j] == WIDGET_COUNT) {
                busy_gallery = true;
            }
        }
        j = j + 1;
    }
    if (dc[D_GN] == 0) {
        gallery_load(dc, gal, gt, hb);
        if (dc[D_GN] == 0 and busy_gallery == false and now >= dc[D_GTRY] + 10) {
            dc[D_GTRY] = now;
            j = 0;
            while (j < FETCH_SLOTS) {
                if (jp[j] == 0) {
                    dash_spawn(dc, gal, gt, hb, jp, jwi, j, WIDGET_COUNT);
                    j = FETCH_SLOTS;
                } else {
                    j = j + 1;
                }
            }
        }
        return;
    }
    // the scan for cards to fetch: at most once a second, only while some card is not cached, and no more
    // than FETCH_CAP curls at a time (dash.t27: poll_due, fetch_ok)
    var cached : u32 = 0;
    var failed : u32 = 0;
    var running : u32 = 0;
    var wi2 : u32 = 0;
    while (wi2 < WIDGET_COUNT) {
        if (dc[D_ST + wi2] == WS_LOADED) { cached = cached + 1; }
        if (dc[D_ST + wi2] == WS_FAILED) { failed = failed + 1; }
        wi2 = wi2 + 1;
    }
    j = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) { running = running + 1; }
        j = j + 1;
    }
    if (poll_due(now, dc[D_POLL], cached, WIDGET_COUNT - failed) == false) { return; }
    dc[D_POLL] = now;
    wi2 = 0;
    j = 0;
    while (wi2 < WIDGET_COUNT and fetch_ok(running)) {
        if (dc[D_ST + wi2] == WS_WANT) {
            while (j < FETCH_SLOTS and jp[j] != 0) { j = j + 1; }
            if (j < FETCH_SLOTS) {
                dash_spawn(dc, gal, gt, hb, jp, jwi, j, wi2);
                if (jp[j] != 0) { running = running + 1; }
            }
        }
        wi2 = wi2 + 1;
    }
}

/// True while a fetch is running or asked for: the loop keeps ticking.
fn dash_busy(dc: []u64, jp: []const u32) -> bool {
    var j : u32 = 0;
    while (j < FETCH_SLOTS) {
        if (jp[j] != 0) { return true; }
        j = j + 1;
    }
    return false;
}

fn live_hide(dc: []u64) -> void {
    if (dc[D_WEB] != 0) {
        msg0(dc[D_WEB], sel("removeFromSuperview"));
        msg0(dc[D_WEB], sel("release"));
        dc[D_WEB] = 0;
    }
    dc[D_LIVE] = 0;
}

/// Re-paint the live page for the window or full-screen state (dash.t27 live_js): transparent glass or #000.
fn live_paint(wv: u64, full: bool) -> void {
    var jb : [512]u8 = undefined;
    const jn : usize = live_js(full, false, jb[0..512]);
    const js : u64 = cf_bytes(0, jb[0..512], jn, UTF8, false);
    msg2(wv, sel("evaluateJavaScript:completionHandler:"), js, 0);
    cf_release(js);
}

/// Open widget wi live: one WKWebView over the content area, loading the page the site itself embeds. In a window
/// the view draws no background and a document-start script clears the page's own black field; in full screen the
/// same script paints #000 (dash.t27 live_js).
fn live_show(dc: []u64, glass: u64, gal: []const u8, gt: []const u32, wi: u32, full: bool) -> void {
    if (dc[D_GN] == 0 or wi >= WIDGET_COUNT) { return; }
    live_hide(dc);
    const cfg : u64 = msg0(cls("WKWebViewConfiguration"), sel("new"));
    var jb : [512]u8 = undefined;
    const jn : usize = live_js(full, true, jb[0..512]);
    const js : u64 = cf_bytes(0, jb[0..512], jn, UTF8, false);
    const us0 : u64 = msg3(msg0(cls("WKUserScript"), sel("alloc")), sel("initWithSource:injectionTime:forMainFrameOnly:"), js, 0, 1);
    cf_release(js);
    msg1(msg0(cfg, sel("userContentController")), sel("addUserScript:"), us0);
    const wv : u64 = msg_rect_obj(msg0(cls("WKWebView"), sel("alloc")), sel("initWithFrame:configuration:"), 0.0, 0.0, 100.0, 100.0, cfg);
    if (wv == 0) { return; }
    const nobg : u64 = msg1(cls("NSNumber"), sel("numberWithBool:"), 0);
    const kdraw : u64 = cf("drawsBackground");
    msg2(wv, sel("setValue:forKey:"), nobg, kdraw);
    cf_release(kdraw);
    if (msg_test1(wv, sel("respondsToSelector:"), sel("setUnderPageBackgroundColor:"))) {
        msg1(wv, sel("setUnderPageBackgroundColor:"), msg0(cls("NSColor"), sel("clearColor")));
    }
    msg1(glass, sel("addSubview:"), wv);
    var ub : [320]u8 = undefined;
    const un : usize = put_page_url(gal, gt, wi, ub[0..320]);
    const us : u64 = cf_bytes(0, ub[0..320], un, UTF8, false);
    const url : u64 = msg1(cls("NSURL"), sel("URLWithString:"), us);
    cf_release(us);
    msg1(wv, sel("loadRequest:"), msg1(cls("NSURLRequest"), sel("requestWithURL:"), url));
    dc[D_WEB] = wv;
    dc[D_LIVE] = @as(u64, wi) + 1;
}

/// Read the pin file of `letter` into pb[0..PB_PINS]; the byte count (0 when there is no file).
fn pins_load(home: []const u8, letter: u32, pb: []u8) -> usize {
    var pp : [320]u8 = undefined;
    pin_path(home, letter, pp[0..320]);
    const fd : i32 = sys_open_ro(pp[0..320], 0);
    if (fd < 0) { return 0; }
    var r : i64 = sys_read(fd, pb[0..PB_PINS], @as(u64, PB_PINS));
    sys_close(fd);
    if (r < 0) { r = 0; }
    return @as(usize, @intCast(r));
}

/// Write pb[0..n] as the pin file of `letter` (the folders are made first).
fn pins_save(home: []const u8, letter: u32, pb: []const u8, n: usize) -> void {
    var pp : [320]u8 = undefined;
    var dp : [320]u8 = undefined;
    var k : usize = put_bytes(dp[0..320], 0, home);
    k = put_bytes(dp[0..320], k, "/.t27os/pins");
    dp[k] = 0;
    sys_mkdir(dp[0..320], 493);
    pin_path(home, letter, pp[0..320]);
    const fd : i32 = sys_creat(pp[0..320], 420);
    if (fd < 0) { return; }
    sys_write(fd, pb[0..PB_PINS], @as(u64, n));
    sys_close(fd);
}

/// The text for the commander line, set by CREATE NEW or a COMMANDS / SKILLS widget; the dialog types it, not sent.
fn set_prefill(dc: []u64, pb: []u8, line: []const u8) -> void {
    var n : usize = line.len;
    if (n > @as(usize, PRE_MAX)) { n = @as(usize, PRE_MAX); }
    var i : usize = 0;
    while (i < n) {
        pb[PB_PRE + i] = line[i];
        i = i + 1;
    }
    dc[D_PREN] = @as(u64, n);
}

// ---- the heartbeat (crash guard, issue 12368) ----
// Once a second the frame loop writes "<pid> <unix seconds>\n" to ~/.t27os/live/app.beat and a clean quit removes
// the file. The pty server (pty_server.t27 beat_parse / sup_decide) reads it every 5 s: a pid that is gone with the
// file still there is a crash, a pid that is alive with a beat older than 20 s is a hang; either way it relaunches.
// The loop wakes at least every 0.5 s (frame_gate FG_IDLE_S), so a 1 Hz beat is never 20 s late unless the main
// thread is stuck. The file is written to app.beat.tmp and renamed over, so the reader never sees half a line.

/// The beat file ~/.t27os/live/app.beat (tmp: its .tmp twin), NUL-ended in out; the length without the NUL, or 0
/// when home is too long for out.
fn beat_path(home: []const u8, out: []u8, tmp: bool) -> usize {
    if (home.len > 200 or out.len < 260) { return 0; }
    var n : usize = put_bytes(out, 0, home);
    n = put_bytes(out, n, "/.t27os/live/app.beat");
    if (tmp) { n = put_bytes(out, n, ".tmp"); }
    out[n] = 0;
    return n;
}

/// "<pid> <unix seconds>\n", the bytes pty_server.t27 beat_parse reads; the length.
fn beat_text(out: []u8, pid: u64, now: u64) -> usize {
    var n : usize = put_dec(out, 0, pid);
    out[n] = 32;
    n = put_dec(out, n + 1, now);
    out[n] = 10;
    return n + 1;
}

fn app_pid() -> i32 { return @extern("getpid"); }

/// Write the beat for `now`: the tmp file, then rename over app.beat. The live folder is made on the first failure.
fn beat_write(home: []const u8, now: u64) -> void {
    var fb : [320]u8 = undefined;
    var pb : [320]u8 = undefined;
    if (beat_path(home, fb[0..320], false) == 0) { return; }
    if (beat_path(home, pb[0..320], true) == 0) { return; }
    var pid : u64 = 0;
    const raw : i32 = app_pid();
    if (raw > 0) { pid = @as(u64, @intCast(raw)); }
    var tb : [48]u8 = undefined;
    const tn : usize = beat_text(tb[0..48], pid, now);
    var fd : i32 = sys_creat(pb[0..320], 420);
    if (fd < 0) {
        var dp : [320]u8 = undefined;
        const k : usize = put_bytes(dp[0..320], 0, home);
        put_bytes(dp[0..320], k, "/.t27os/live");
        dp[k + 12] = 0;
        sys_mkdir(dp[0..320], 493);
        fd = sys_creat(pb[0..320], 420);
        if (fd < 0) { return; }
    }
    sys_write(fd, tb[0..tn], @as(u64, tn));
    sys_close(fd);
    sys_rename(pb[0..320], fb[0..320]);
}

/// A clean quit removes the beat, so the supervisor reads "no file" as "the owner closed the app".
fn beat_clear(home: []const u8) -> void {
    var fb : [320]u8 = undefined;
    if (beat_path(home, fb[0..320], false) == 0) { return; }
    sys_unlink(fb[0..320]);
}

// ---- the app ----

pub fn main() -> void {
    const s_alloc : u64 = sel("alloc");
    const app : u64 = msg0(cls("NSApplication"), sel("sharedApplication"));
    msg1(app, sel("setActivationPolicy:"), 0);
    // H. no App Nap, so the heartbeat keeps its second while the window is hidden (NAP_OFF_OPTS); the activity
    // object is retained, because it ends when it is released.
    const nap_s : u64 = cf("terminal panes and heartbeat");
    const nap_a : u64 = msg2(msg0(cls("NSProcessInfo"), sel("processInfo")), sel("beginActivityWithOptions:reason:"), nap_opts(false), nap_s);
    msg0(nap_a, sel("retain"));
    const win : u64 = msg_window(msg0(cls("NSWindow"), s_alloc), sel("initWithContentRect:styleMask:backing:defer:"), 0.0, 0.0, W_PT, H_PT, STYLE, BACKING_BUFFERED, false);
    var brand_b : [16]u8 = undefined;
    const brand_s : u64 = cf_bytes(0, brand_b[0 .. 16], brand(brand_b[0 .. 16]), UTF8, false);
    msg1(win, sel("setTitle:"), brand_s);
    msg_flag(win, sel("setTitlebarAppearsTransparent:"), true);
    msg1(win, sel("setTitleVisibility:"), 1);
    msg_flag(win, sel("setMovableByWindowBackground:"), false);
    msg_flag(win, sel("setOpaque:"), false);
    msg1(win, sel("setBackgroundColor:"), msg0(cls("NSColor"), sel("clearColor")));
    msg1(win, sel("setAppearance:"), msg1(cls("NSAppearance"), sel("appearanceNamed:"), cf("NSAppearanceNameDarkAqua")));
    const glass : u64 = msg_rect(msg0(cls("NSVisualEffectView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg1(glass, sel("setMaterial:"), MATERIAL);
    msg1(glass, sel("setBlendingMode:"), BLEND_BEHIND);
    msg1(glass, sel("setState:"), STATE_ACTIVE);
    msg1(win, sel("setContentView:"), glass);
    msg1(win, sel("setCollectionBehavior:"), FULL_SCREEN_PRIMARY);
    msg1(glass, sel("setAutoresizingMask:"), SIZABLE);
    const view : u64 = msg_rect(msg0(cls("NSView"), s_alloc), sel("initWithFrame:"), 0.0, 0.0, W_PT, H_PT);
    msg_flag(view, sel("setWantsLayer:"), true);
    msg1(glass, sel("addSubview:"), view);
    msg1(view, sel("setAutoresizingMask:"), SIZABLE);
    const layer : u64 = msg0(view, sel("layer"));
    msg1(layer, sel("setContentsGravity:"), cf("resizeAspect"));
    // W. the blackGlass tint lives on the layer, so it covers the whole window in full screen too.
    // the launch material: the frame is the full window, so the opaque black (owner, 2026-10-23)
    msg1(layer, sel("setBackgroundColor:"), cg_color(GROUND_RGB, GROUND_RGB, GROUND_RGB, tint_alpha(W_PT)));
    msg0(win, sel("center"));
    // the smallest window that still shows the sidebar, a chat header and one line of the pane (audit
    // 2026-10-19); mouse moves wake the event wait, which grows to FG_IDLE_S while the screen is still
    msg_ff(win, sel("setContentMinSize:"), 480.0, 320.0);
    msg_flag(win, sel("setAcceptsMouseMovedEvents:"), true);
    msg1(win, sel("makeKeyAndOrderFront:"), 0);
    msg0(app, sel("finishLaunching"));
    // D. the Dock icon, drawn here rather than shipped as a foreign .icns file.
    const ic : u64 = cg_bitmap(0, 512, 512, 8, 2048, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(ic, 0.0, ICON_SIZE);
    cg_scale(ic, 1.0, -1.0);
    draw_app_icon(ic);
    const icon : u64 = msg_image(msg0(cls("NSImage"), s_alloc), sel("initWithCGImage:size:"), cg_image(ic), ICON_SIZE, ICON_SIZE);
    msg1(app, sel("setApplicationIconImage:"), icon);
    msg_flag(app, sel("activateIgnoringOtherApps:"), true);

    // the text kit: every class, selector and string the frames need, made once.
    const s_split : u64 = sel("componentsSeparatedByString:");
    var kit : [48]u64 = undefined;
    kit[K_FONT] = cls("NSFont");
    kit[K_MONO_SEL] = sel("monospacedSystemFontOfSize:weight:");
    kit[K_SYS_SEL] = sel("systemFontOfSize:weight:");
    kit[K_KEY_FONT] = cf("NSFont");
    kit[K_KEY_CTX] = cf("CTForegroundColorFromContext");
    kit[K_YES] = msg_flag(cls("NSNumber"), sel("numberWithBool:"), true);
    msg0(kit[K_YES], sel("retain"));
    kit[K_DICT] = cls("NSDictionary");
    kit[K_DICT_SEL] = sel("dictionaryWithObjects:forKeys:count:");
    kit[K_ATTR] = cls("NSAttributedString");
    kit[K_ALLOC] = s_alloc;
    kit[K_INIT] = sel("initWithString:attributes:");
    kit[K_RELEASE] = sel("release");
    kit[K_NAMES] = msg1(cf(WORLD_NAMES), s_split, cf(","));
    msg0(kit[K_NAMES], sel("retain"));
    kit[K_AT] = sel("objectAtIndex:");
    kit[K_TRINITY] = brand_s;
    kit[K_QUEEN] = cf("Queen");
    kit[K_CMD] = cf("Cmd+");
    kit[K_OPT] = cf("Option+");
    kit[K_CTRL] = cf("Ctrl+");
    kit[K_DIGITS] = msg1(cf("1,2,3,4,5,6,7,8,9"), s_split, cf(","));
    msg0(kit[K_DIGITS], sel("retain"));
    kit[K_OPEN_DASH] = cf("OPEN DASHBOARD");
    kit[K_AGENTS] = cf("AGENTS");
    kit[K_AGENT_NAMES] = msg1(cf(AGENT_NAMES), s_split, cf(","));
    msg0(kit[K_AGENT_NAMES], sel("retain"));
    kit[K_SPACES] = cf("SPACES");
    kit[K_QUEEN_LBL] = cf("QUEEN");
    kit[K_CONTROLS] = msg1(cf(CONTROL_NAMES), s_split, cf(","));
    msg0(kit[K_CONTROLS], sel("retain"));
    kit[K_AGES] = msg1(cf(AGE_WORDS), s_split, cf(","));
    msg0(kit[K_AGES], sel("retain"));
    kit[K_SUGGEST] = msg1(cf(SUGGEST_WORDS), s_split, cf(","));
    msg0(kit[K_SUGGEST], sel("retain"));
    kit[K_QP] = msg1(cf(QP_WORDS), s_split, cf(","));
    msg0(kit[K_QP], sel("retain"));
    // D. mutable: the DOCTOR writes the bound repositories' names and branches into them
    kit[K_SPACE_NAMES] = msg0(msg1(cf(SPACE_NAMES), s_split, cf(",")), sel("mutableCopy"));
    msg0(kit[K_SPACE_NAMES], sel("retain"));
    kit[K_BRANCHES] = msg0(msg1(cf(SPACE_BRANCHES), s_split, cf(",")), sel("mutableCopy"));
    msg0(kit[K_BRANCHES], sel("retain"));
    kit[K_STATE_WORDS] = msg1(cf(STATE_WORDS), s_split, cf(","));
    msg0(kit[K_STATE_WORDS], sel("retain"));
    kit[K_EMPTY] = cf("Tap a cell to open a session");
    kit[K_REPO] = cf(REPO_LINK_TEXT);
    kit[K_MDICT] = cls("NSMutableDictionary");
    kit[K_NEW] = sel("new");
    // the live theme starts at the built-in levels; the live module (live_load) moves them while the window runs
    var th0 : [15]u32 = undefined;
    thv_defaults(th0[0..15]);
    thv_store(kit[0..48], th0[0..15]);
    kit[K_CACHE] = msg0(kit[K_MDICT], kit[K_NEW]);
    kit[K_GET] = sel("objectForKey:");
    kit[K_PUT] = sel("setObject:forKey:");
    kit[K_COUNT] = sel("count");
    kit[K_FLUSH] = sel("removeAllObjects");
    kit[K_NUM_CLS] = cls("NSNumber");
    kit[K_NUM] = sel("numberWithUnsignedLongLong:");
    var ell_buf : [1]u64 = undefined;
    ell_buf[0] = 8230;
    kit[K_ELL] = msg_chars(msg0(cls("NSString"), s_alloc), sel("initWithCharacters:length:"), ell_buf, 1);

    // the frames are drawn in the screen's colour space, BGRA, so the layer takes them without a conversion
    const scr : u64 = screen_space(win);
    const c : u64 = cg_bitmap(0, 3840, 2400, 8, 15360, scr, frame_bitmap_info(CG_ALPHA_PREMUL_FIRST, CG_ORDER_32_LITTLE));
    cg_translate(c, 0.0, SH_MAX * WIDE_RETINA);
    cg_scale(c, WIDE_RETINA, 0.0 - WIDE_RETINA);
    // F. the layer's background follows on_glass(sw), set again when the width (dock) or the full-screen
    // state turns it (owner, 2026-10-23: glass is the compact panel's; the full window is #000000).
    var was_glass : bool = on_glass(W_PT);
    // K. the narrow panel draws point for point into its own bitmap, cropped to the view each frame.
    const cc : u64 = cg_bitmap(0, 1520, 2600, 8, 6080, scr, frame_bitmap_info(CG_ALPHA_PREMUL_FIRST, CG_ORDER_32_LITTLE));
    cg_translate(cc, 0.0, CH_MAX * RETINA);
    cg_scale(cc, RETINA, 0.0 - RETINA);

    const s_next : u64 = sel("nextEventMatchingMask:untilDate:inMode:dequeue:");
    const s_occl : u64 = sel("occlusionState");
    const s_send : u64 = sel("sendEvent:");
    const s_type : u64 = sel("type");
