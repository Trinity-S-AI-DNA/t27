    msg1(dk[DK_OUTS], dk[DK_ADD], cf("/private/tmp/t27os-doctor-2.out"));
    msg1(dk[DK_OUTS], dk[DK_ADD], cf("/private/tmp/t27os-doctor-3.out"));
    msg1(dk[DK_OUTS], dk[DK_ADD], cf("/private/tmp/t27os-doctor-4.out"));
