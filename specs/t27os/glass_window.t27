    msg0(kit[K_AGENT_NAMES], sel("retain"));
    kit[K_SPACES] = cf("SPACES");
    kit[K_QUEEN_LBL] = cf("QUEEN");
    kit[K_CONTROLS] = msg1(cf(CONTROL_NAMES), s_split, cf(","));
    msg0(kit[K_CONTROLS], sel("retain"));
    kit[K_AGES] = msg1(cf(AGE_WORDS), s_split, cf(","));
    msg0(kit[K_AGES], sel("retain"));
    kit[K_SUGGEST] = msg1(cf(SUGGEST_WORDS), s_split, cf(","));
    msg0(kit[K_SUGGEST], sel("retain"));
    kit[K_QP] = msg1(cf(QP_WORDS), s_split, cf(","));
    msg0(kit[K_QP], sel("retain"));
    // D. mutable: the DOCTOR writes the bound repositories' names and branches into them
    kit[K_SPACE_NAMES] = msg0(msg1(cf(SPACE_NAMES), s_split, cf(",")), sel("mutableCopy"));
    msg0(kit[K_SPACE_NAMES], sel("retain"));
    kit[K_BRANCHES] = msg0(msg1(cf(SPACE_BRANCHES), s_split, cf(",")), sel("mutableCopy"));
    msg0(kit[K_BRANCHES], sel("retain"));
    kit[K_STATE_WORDS] = msg1(cf(STATE_WORDS), s_split, cf(","));
    msg0(kit[K_STATE_WORDS], sel("retain"));
    kit[K_EMPTY] = cf("Tap a cell to open a session");
    kit[K_REPO] = cf(REPO_LINK_TEXT);
    kit[K_MDICT] = cls("NSMutableDictionary");
    kit[K_NEW] = sel("new");
    // the live theme starts at the built-in levels; the live module (live_load) moves them while the window runs
    var th0 : [15]u32 = undefined;
    thv_defaults(th0[0..15]);
    thv_store(kit[0..48], th0[0..15]);
    kit[K_CACHE] = msg0(kit[K_MDICT], kit[K_NEW]);
    kit[K_GET] = sel("objectForKey:");
    kit[K_PUT] = sel("setObject:forKey:");
    kit[K_COUNT] = sel("count");
    kit[K_FLUSH] = sel("removeAllObjects");
    kit[K_NUM_CLS] = cls("NSNumber");
    kit[K_NUM] = sel("numberWithUnsignedLongLong:");
    var ell_buf : [1]u64 = undefined;
    ell_buf[0] = 8230;
    kit[K_ELL] = msg_chars(msg0(cls("NSString"), s_alloc), sel("initWithCharacters:length:"), ell_buf, 1);

    const c : u64 = cg_bitmap(0, 3840, 2400, 8, 15360, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(c, 0.0, SH_MAX * WIDE_RETINA);
    cg_scale(c, WIDE_RETINA, 0.0 - WIDE_RETINA);
    // F. the layer's background follows on_glass(sw), set again when the width (dock) or the full-screen
    // state turns it (owner, 2026-10-23: glass is the compact panel's; the full window is #000000).
    var was_glass : bool = on_glass(W_PT);
    // K. the narrow panel draws point for point into its own bitmap, cropped to the view each frame.
    const cc : u64 = cg_bitmap(0, 1520, 2600, 8, 6080, cg_rgb(), ALPHA_PREMUL_LAST);
    cg_translate(cc, 0.0, CH_MAX * RETINA);
    cg_scale(cc, RETINA, 0.0 - RETINA);

    const s_next : u64 = sel("nextEventMatchingMask:untilDate:inMode:dequeue:");
    const s_send : u64 = sel("sendEvent:");
    const s_type : u64 = sel("type");
    const s_key : u64 = sel("keyCode");
    const s_flags : u64 = sel("modifierFlags");
    const s_value : u64 = sel("valueForKey:");
    const s_get : u64 = sel("getValue:");
    const s_visible : u64 = sel("isVisible");
    const s_mask : u64 = sel("styleMask");
    const s_contents : u64 = sel("setContents:");
    const s_wait : u64 = sel("dateWithTimeIntervalSinceNow:");
    const s_quiet : u64 = sel("setDisableActions:");
    const k_mouse : u64 = cf("mouseLocationOutsideOfEventStream");
    const k_click : u64 = cf("locationInWindow");
    const mode : u64 = cf("kCFRunLoopDefaultMode");
    const date_cls : u64 = cls("NSDate");
    const tx_cls : u64 = cls("CATransaction");
    const k_frame : u64 = cf("frame");
    const s_full : u64 = sel("toggleFullScreen:");
    const s_set_frame : u64 = sel("setFrame:display:animate:");
    const s_screen : u64 = sel("screen");
    const k_visible : u64 = cf("visibleFrame");
    const s_cursor_set : u64 = sel("set");
    const hand : u64 = msg0(cls("NSCursor"), sel("pointingHandCursor"));
    const arrow : u64 = msg0(cls("NSCursor"), sel("arrowCursor"));
    const sc : i64 = fit_permille(960, 540);

    var pt : [2]f64 = undefined;
    var fr : [4]f64 = undefined;
    var wf : [4]f64 = undefined;
    var vf : [4]f64 = undefined;
    var docked : bool = false;
    var dash : bool = false;
    var state : u32 = STATE_HOME;
    var shown : u32 = 0;
    var ma : f64 = 0.0;
    var collapsed : bool = false;
    var frame : u32 = 0;
    var task : u32 = CARD_SLOTS;
    var space : u32 = 0;
    var ss : u64 = 0;
    var sp : u32 = SPACES_SEED;
    var cur : u32 = SESSION_NONE;
    // Q. the Queen panel (queen.t27): open, GOD MODE, the ring of recent events, a dismissed suggestion
    var qp : bool = false;
    // RC. the QUEEN CHAT dock (queen_chats.t27): the right dock the owner asked for -- a chat with her
    var rc : bool = false;
    var god : bool = false;
    var ring : [8]u64 = undefined;
    var ri : u32 = 0;
    while (ri < RING) {
        ring[ri] = 0;
        ri = ri + 1;
    }
    var evn : u32 = 0;
    var dismissed : u32 = RING_NONE;
    // GOD MODE evolve (evolve.t27): the decision on the strip, letters done or dismissed, tasks confirmed, the last plan
    var evd : u32 = 0;
    var evfl : u32 = 0;
    var evst : u32 = 0;
    var evp : u32 = 0;
    var evn2 : u32 = 0;
    var evpr : u32 = PROFILE_NONE;
    var last_user : u64 = 0;
    var last_act : u64 = 0;
    var now : u64 = unix_time(0);
    var glow : f64 = 0.0;
    // R. hot reload (hot_reload.t27): the executable, its date now, and the state a swap left behind
    const defs : u64 = msg0(cls("NSUserDefaults"), sel("standardUserDefaults"));
    const k_hot : u64 = cf("t27os.hot");
    const k_state : u64 = cf("t27os.state");
    const k_shown : u64 = cf("t27os.shown");
    const k_task : u64 = cf("t27os.task");
    const k_space : u64 = cf("t27os.space");
    // sessions2: the session byte became 1 + agent * 8 + space when spaces grew to six slots
    const k_ss : u64 = cf("t27os.sessions2");
    const k_sp : u64 = cf("t27os.spaces");
    const k_cur : u64 = cf("t27os.cur");
    const k_hs : u64 = cf("t27os.hs");
    const k_flags : u64 = cf("t27os.flags");
    const k_evn : u64 = cf("t27os.evn");
    var k_ev : [8]u64 = undefined;
    k_ev[0] = cf("t27os.ev0");
    k_ev[1] = cf("t27os.ev1");
    k_ev[2] = cf("t27os.ev2");
    k_ev[3] = cf("t27os.ev3");
    k_ev[4] = cf("t27os.ev4");
    k_ev[5] = cf("t27os.ev5");
    k_ev[6] = cf("t27os.ev6");
    k_ev[7] = cf("t27os.ev7");
