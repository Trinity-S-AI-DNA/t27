fn cg_rgb() -> u64 { return @extern("CGColorSpaceCreateDeviceRGB"); }
/// The colour space of the screen the window is on ([[win colorSpace] CGColorSpace]); DeviceRGB when it has none.
fn screen_space(win: u64) -> u64 {
    const ns : u64 = msg0(win, sel("colorSpace"));
    if (ns == 0) { return cg_rgb(); }
    const cs : u64 = msg0(ns, sel("CGColorSpace"));
    if (cs == 0) { return cg_rgb(); }
    return cs;
}
/// Is any part of the window on a screen? A covered, minimised or other-Space window draws nothing.
fn on_screen(occlusion: u64) -> bool { return (occlusion & OCC_VISIBLE) != 0; }
