// SPDX-License-Identifier: Apache-2.0
// specs/t27os/lagger_free_provider.t27 -- lagger: free-provider paths
// (OpenCode Zen, Groq, Gemini) and key_state with reset tracking.
// Part of M8 milestone (milestone #12). Closes #13323.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::lagger_free_provider;

pub const LAGGER_FREE_PROVIDER_MAX : u32 = 3;

pub struct FreeProvider { name: str, key_state_reset: bool };

pub fn free_provider_key_state_reset(p: FreeProvider) -> bool {
    return p.key_state_reset;
}

test "free_provider_key_state_reset" {
    assert(free_provider_key_state_reset(FreeProvider { name: "Zen", key_state_reset: true }));
    assert(!free_provider_key_state_reset(FreeProvider { name: "Groq", key_state_reset: false }));
}

invariant lagger_free_provider_max_positive {
    assert LAGGER_FREE_PROVIDER_MAX > 0;
}