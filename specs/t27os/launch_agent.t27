// SPDX-License-Identifier: Apache-2.0
; specs/t27os/launch_agent.t27 -- the launchd agent that keeps the T27 OS PTY server up (#11035, epic #11037).
; The PTY server (pty_server.t27) holds the panes; if it dies or the Mac reboots the panes go with it. A user launch
; agent restarts it at login and when it exits. This spec is the agent definition as data: the plist text is built from
; the values below, never typed into a second file. The server writes its own session records (session_store.t27) and
; restore_plan decides what each pane does after a restart; this file only starts the process.
; Facts: label ai.t27.os.pty, program target/t27os/t27os-pty (install.t27 APP_FILE), RunAtLoad and KeepAlive true, log
; file ~/t27os-pty.log for both streams, PATH carried in the environment. The home directory is passed in. No key value
; is read or written. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLaunchAgent;

use t27os::session_store::put_bytes;
use t27os::editors::same_bytes;

pub const LA_LABEL : []const u8 = "ai.t27.os.pty";
pub const LA_PROGRAM : []const u8 = "/t27os/t27os-pty";
pub const LA_LOG : []const u8 = "/t27os-pty.log";
pub const LA_PATH : []const u8 = "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin";

/// Where the agent file lives under the home directory.
pub const LA_FILE : []const u8 = "/Library/LaunchAgents/ai.t27.os.pty.plist";

fn la_line(out: []u8, w: usize, s: []const u8) -> usize {
    const p : usize = put_bytes(out, w, s);
    out[p] = 10;
    return p + 1;
}

/// The agent plist for a home directory and the release folder that holds t27os-pty. Returns the length written.
pub fn la_plist(out: []u8, home: []const u8, release: []const u8) -> usize {
    var w : usize = la_line(out, 0, "<?xml version='1.0' encoding='UTF-8'?>");
    w = la_line(out, w, "<plist version='1.0'>");
    w = la_line(out, w, "<dict>");
    w = put_bytes(out, w, "<key>Label</key><string>");
    w = put_bytes(out, w, LA_LABEL);
    w = la_line(out, w, "</string>");
    w = la_line(out, w, "<key>ProgramArguments</key>");
    w = put_bytes(out, w, "<array><string>");
    w = put_bytes(out, w, release);
    w = put_bytes(out, w, LA_PROGRAM);
    w = la_line(out, w, "</string></array>");
    w = la_line(out, w, "<key>RunAtLoad</key><true/>");
    w = la_line(out, w, "<key>KeepAlive</key><true/>");
    w = put_bytes(out, w, "<key>StandardOutPath</key><string>");
    w = put_bytes(out, w, home);
    w = put_bytes(out, w, LA_LOG);
    w = la_line(out, w, "</string>");
    w = put_bytes(out, w, "<key>StandardErrorPath</key><string>");
    w = put_bytes(out, w, home);
    w = put_bytes(out, w, LA_LOG);
    w = la_line(out, w, "</string>");
    w = put_bytes(out, w, "<key>EnvironmentVariables</key><dict><key>PATH</key><string>");
    w = put_bytes(out, w, LA_PATH);
    w = la_line(out, w, "</string></dict>");
    w = la_line(out, w, "</dict>");
    w = la_line(out, w, "</plist>");
    return w;
}

/// Does hay contain the fixed text nd.
pub fn la_has(hay: []const u8, nd: []const u8) -> bool {
    const k : usize = nd.len;
    if (k == 0 or hay.len < k) { return false; }
    var i : usize = 0;
    while (i + k <= hay.len) {
        var j : usize = 0;
        var same : bool = true;
        while (j < k) {
            if (hay[i + j] != nd[j]) { same = false; }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

/// The path of the agent file for a home directory.
pub fn la_path(out: []u8, home: []const u8) -> usize {
    const p : usize = put_bytes(out, 0, home);
    return put_bytes(out, p, LA_FILE);
}

test "the_agent_has_the_label_and_starts_at_load_and_keeps_alive" {
    var out : [1024]u8 = undefined;
    const n : usize = la_plist(out[0..], "/Users/x", "/Users/x/t27/target");
    const t : []const u8 = out[0..n];
    assert la_has(t, "<key>Label</key><string>ai.t27.os.pty</string>");
    assert la_has(t, "<key>RunAtLoad</key><true/>");
    assert la_has(t, "<key>KeepAlive</key><true/>");
}

test "the_program_is_the_release_pty_binary" {
    var out : [1024]u8 = undefined;
    const n : usize = la_plist(out[0..], "/Users/x", "/Users/x/t27/target");
    assert la_has(out[0..n], "<array><string>/Users/x/t27/target/t27os/t27os-pty</string></array>");
}

test "both_streams_go_to_the_log_under_home_and_path_is_set" {
    var out : [1024]u8 = undefined;
    const n : usize = la_plist(out[0..], "/Users/x", "/r");
    const t : []const u8 = out[0..n];
    assert la_has(t, "<key>StandardOutPath</key><string>/Users/x/t27os-pty.log</string>");
    assert la_has(t, "<key>StandardErrorPath</key><string>/Users/x/t27os-pty.log</string>");
    assert la_has(t, "<key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:");
}

test "the_agent_file_lives_in_the_user_launch_agents_folder" {
    var out : [128]u8 = undefined;
    const n : usize = la_path(out[0..], "/Users/x");
    assert same_bytes(out[0..n], "/Users/x/Library/LaunchAgents/ai.t27.os.pty.plist");
}
