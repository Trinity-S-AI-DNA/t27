// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_job_receipt.t27 -- what a node job's receipt is, and when it
// counts as VERIFIED (owner brief 2026-10-27, follows node_runner.t27 and
// settle_bridge.t27). The SIGNER is t27c's corpus-receipt machinery
// (specs/verified/signed_receipt.t27) -- imported by reference, never restated.
// This file decides the JOB-level shape: which fields a receipt carries, when it
// is complete, and that a verification vote reproduces the exact test counts.
// Laws it pins: a receipt without a 32-hex challenge, a nonzero FAIL count, or a
// vacuous test is not complete; a verification vote agrees only when EVERY count
// matches; the receipt is verified only with MIN_VERIFICATIONS independent votes
// (settle_bridge.t27's two, one vote per verifier key).
// Lengths are explicit everywhere (gen-c cannot lower slice .len -- #5980).
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeJobReceipt;

pub const CHALLENGE_HEX : usize = 32;
pub const MIN_VERIFICATIONS : usize = 2;

pub const R_INCOMPLETE : u8 = 0;
pub const R_COMPLETE : u8 = 1;

fn digit(b: u8) -> bool { return b >= 48 and b <= 57; }
fn hexlower(b: u8) -> bool { return digit(b) or (b >= 97 and b <= 102); }

/// A receipt is complete when its challenge is 32 lowercase hex, the run passed
/// (FAIL == 0), nothing was vacuous, and the run's exit was 0.
pub fn receipt_complete(ch_hex : usize, fail_count : u32, vacuous_count : u32, exit_zero : bool) -> u8 {
    if (ch_hex != CHALLENGE_HEX) { return R_INCOMPLETE; }
    if (fail_count != 0) { return R_INCOMPLETE; }
    if (vacuous_count != 0) { return R_INCOMPLETE; }
    if (exit_zero == false) { return R_INCOMPLETE; }
    return R_COMPLETE;
}

/// One verification vote: a re-run reproduces EVERY count (pass, fail, vacuous).
/// A vote that reproduces some counts but not all is a MISMATCH (settle_bridge's
/// rule 2: a disputed run refuses even when the other verification reproduced).
pub fn vote_agrees(pass_a : u32, fail_a : u32, vac_a : u32, pass_b : u32, fail_b : u32, vac_b : u32) -> bool {
    return pass_a == pass_b and fail_a == fail_b and vac_a == vac_b;
}

/// Verified = at least MIN_VERIFICATIONS agreeing votes on a complete receipt.
/// Votes beyond the minimum add nothing (one vote per verifier key is the
/// identity table's law, not this file's).
pub fn receipt_verified(complete : u8, agreeing_votes : usize) -> bool {
    if (complete != R_COMPLETE) { return false; }
    return agreeing_votes >= MIN_VERIFICATIONS;
}

test receipt_laws_hold {
    var ch : usize = CHALLENGE_HEX;
    var mv : usize = MIN_VERIFICATIONS;
    assert ch == 32;
    assert mv == 2;
}

test completeness_fails_closed {
    assert receipt_complete(32, 0, 0, true) == R_COMPLETE;
    assert receipt_complete(31, 0, 0, true) == R_INCOMPLETE;
    assert receipt_complete(32, 1, 0, true) == R_INCOMPLETE;
    assert receipt_complete(32, 0, 1, true) == R_INCOMPLETE;
    assert receipt_complete(32, 0, 0, false) == R_INCOMPLETE;
}

test a_vote_must_reproduce_every_count {
    assert vote_agrees(5, 0, 0, 5, 0, 0) == true;
    assert vote_agrees(5, 0, 0, 4, 0, 0) == false;
    assert vote_agrees(5, 0, 0, 5, 1, 0) == false;
    assert vote_agrees(5, 0, 0, 5, 0, 1) == false;
}

test verification_needs_two_agreeing_votes_on_a_complete_receipt {
    assert receipt_verified(R_COMPLETE, 0) == false;
    assert receipt_verified(R_COMPLETE, 1) == false;
    assert receipt_verified(R_COMPLETE, 2) == true;
    assert receipt_verified(R_INCOMPLETE, 2) == false;
    assert receipt_verified(R_INCOMPLETE, 5) == false;
}
