// SPDX-License-Identifier: Apache-2.0
// specs/t27os/pty.t27 -- t27os pty: stopped panes release their slot, pane
// limit 16 -> at least 64.
// Part of M1 (milestone #5). Closes #13965.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::pty;

pub const PANE_LIMIT_MIN : u32 = 64;

pub struct PaneTable { panes: [64]bool, active_count: u32 };

pub fn pty_pane_limit_ok(limit: u32) -> bool {
    return limit >= PANE_LIMIT_MIN;
}

pub fn pty_active_count(t: PaneTable) -> u32 {
    return t.active_count;
}

test "pty pane limit at least 64" {
    assert(pty_pane_limit_ok(64));
    assert(pty_pane_limit_ok(128));
    assert(!pty_pane_limit_ok(16));
}

test "pty active count" {
    assert(pty_active_count(PaneTable { panes: [_]bool{false} ** 64, active_count: 3 }) == 3);
}

invariant pty_pane_limit_min_is_64 {
    assert PANE_LIMIT_MIN == 64;
}