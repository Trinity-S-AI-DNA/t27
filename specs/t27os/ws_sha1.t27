// SPDX-License-Identifier: Apache-2.0
; T27 OS WebSocket crypto -- SHA-1 and Base64, the exact pair the RFC 6455 opening handshake needs:
; the client sends Sec-WebSocket-Key (Base64 of a fresh random 16 bytes), and the server's
; Sec-WebSocket-Accept must equal Base64(SHA-1(key + the protocol GUID)) or the upgrade is refused.
; Both are pure functions with the RFC's own test vectors, so the handshake can validate rather than
; trust. SHA-1 lives only to check this one acceptance value; it is not a password scheme.
; the pair and its vectors continue below.
; Defect history (all closed, 2026-11-01, t27b 0.1.0 build 0 + reference t27c/Zig 0.16.0 agree):
;   - the first build was one-block-only: the 60-byte handshake concatenation silently lost its
;     tail into the length words, and the acceptance value came out wrong with no error shown.
;     sha1 is now two-block and refuses nothing silently (len up to 119).
;   - the digest test earlier "passed sha1 == 20" while the bytes were wrong: the return length
;     check says nothing about the bytes; the tests check all 20 bytes.
;   - an earlier "context-dependent miscompilation" suspicion was measurement error: the compiler
;     binary was rebuilt mid-session (another lane landed #12871/#12893), and later probes cut the
;     source at the word "test" inside a comment, so they ran different, truncated files.
;   Suspected-compiler findings that did NOT survive differential testing are withdrawn; the
;   literal traps in the LITERAL LAW note are real and are worked around above.
; Wrapping arithmetic is `+%` throughout the digest (measured: plain `+` traps on u32 overflow).
; LITERAL LAW (measured 2026-11-01): a bare u32 literal at or above 0x80000000 and an xor
; against a literal all-ones word both fold wrongly in this t27b, so every constant the digest
; touches at or above 0x80000000 is built at run time from pieces below 0x80000000 with +%.
; Traps kept honest: a message buffer too small for the padding refuses (0 length returned), the
; Base64 decoder refuses a length that is not a multiple of 4 and a character outside the alphabet.

module T27osWsSha1;

/// The protocol GUID the acceptance value is computed over (RFC 6455 section 1.3).
pub const WS_GUID : string = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

// ---- SHA-1 ----------------------------------------------------------------------------------

fn rotl32(x : u32, n : u32) -> u32 {
  return (x << n) | (x >> (32 - n));
}

/// SHA-1 of buf[0..len] into out (20 bytes), any length up to 119 (a two-block message:
/// the handshake key plus the GUID is 60 bytes, and a one-block-only build silently produced a
/// wrong acceptance value for exactly that input -- the bug this rewrite closed, 2026-11-01).
/// The padded message (message, 0x80, zeros, the big-endian u64 bit length) is built in a local
/// 128-byte workspace, then every 64-byte block runs the 80 rounds. Returns 20, or 0 when out is
/// too small or len is over the workspace.
pub fn sha1(buf : []u8, len : usize, out : []u8) -> usize {
  if (out.len < 20) { return 0; }
  if (len + 9 > 128) { return 0; }
  var h0 : u32 = 0x67452301;
  var h1 : u32 = 0x80000000 +% 0x6FCDAB89; // 0xEFCDAB89 built from two safe pieces
  var h2 : u32 = 0x80000000 +% 0x18BADCFE; // 0x98BADCFE built
  var h3 : u32 = 0x10325476;
  var h4 : u32 = 0x80000000 +% 0x43D2E1F0; // 0xC3D2E1F0 built
  // the padded workspace: the message, the 0x80 pad byte, zero fill, the big-endian u64 length
  var pad : [128]u8;
  var i : usize = 0;
  while (i < len) { pad[i] = buf[i]; i = i + 1; }
  pad[i] = 0x80;
  i = i + 1;
  while (i < 128) { pad[i] = 0; i = i + 1; }
  const bits : u64 = len as u64 * 8;
  const blocks : usize = (len + 8) / 64 + 1;
  const lenat : usize = (blocks - 1) * 64 + 56; // the length sits in the FINAL block at 56..63
  pad[lenat] = (bits >> 56) as u8;
  pad[lenat + 1] = (bits >> 48) as u8;
  pad[lenat + 2] = (bits >> 40) as u8;
  pad[lenat + 3] = (bits >> 32) as u8;
  pad[lenat + 4] = (bits >> 24) as u8;
  pad[lenat + 5] = (bits >> 16) as u8;
  pad[lenat + 6] = (bits >> 8) as u8;
  pad[lenat + 7] = bits as u8;
  var blk : usize = 0;
  while (blk < blocks) {
    var w : [80]u32;
    i = 0;
    while (i < 16) {
      w[i] = (pad[blk * 64 + i * 4] as u32) << 24 | (pad[blk * 64 + i * 4 + 1] as u32) << 16
           | (pad[blk * 64 + i * 4 + 2] as u32) << 8 | pad[blk * 64 + i * 4 + 3] as u32;
      i = i + 1;
    }
    i = 16;
    while (i < 80) {
      w[i] = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
      i = i + 1;
    }
    var ones : u32 = 0x80000000 +% 0x7FFFFFFF; // the all-ones word, built at run time
    var a : u32 = h0;
    var b : u32 = h1;
    var c : u32 = h2;
    var d : u32 = h3;
    var e : u32 = h4;
    i = 0;
    while (i < 80) {
      var f : u32 = 0;
      var k : u32 = 0;
      if (i < 20) {
        f = (b & c) | ((ones - b) & d); // not b by subtraction: ~ and xor-ones both fold wrongly
        k = 0x5A827999;
      }
      if (i >= 20 and i < 40) {
        f = b ^ c ^ d;
        k = 0x6ED9EBA1;
      }
      if (i >= 40 and i < 60) {
        f = (b & c) | (b & d) | (c & d);
        k = 0x80000000 +% 0x0F1BBCDC; // 0x8F1BBCDC built
      }
      if (i >= 60) {
        f = b ^ c ^ d;
        k = 0x80000000 +% 0x4A62C1D6; // 0xCA62C1D6 built
      }
      const tmp : u32 = e +% k +% w[i] +% rotl32(a, 5) +% f; // FIPS 180-4: T = rotl5(a)+f+e+k+w[i]
      e = d;
      d = c;
      c = rotl32(b, 30);
      b = a;
      a = tmp;
      i = i + 1;
    }
    h0 = h0 +% a;
    h1 = h1 +% b;
    h2 = h2 +% c;
    h3 = h3 +% d;
    h4 = h4 +% e;
    blk = blk + 1;
  }
  put_be32(out, 0, h0);
  put_be32(out, 4, h1);
  put_be32(out, 8, h2);
  put_be32(out, 12, h3);
  put_be32(out, 16, h4);
  return 20;
}

fn put_be32(out : []u8, at : usize, v : u32) -> void {
  out[at] = (v >> 24) as u8;
  out[at + 1] = (v >> 16) as u8;
  out[at + 2] = (v >> 8) as u8;
  out[at + 3] = v as u8;
}

// ---- Base64 ---------------------------------------------------------------------------------

const B64 : string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

/// Encode buf[0..len] as Base64 into out. Returns the character count, or 0 when out is too small
/// (the handshake key is always a multiple of 3 bytes long: 16 bytes nonce, 24 characters).
pub fn b64_encode(buf : []u8, len : usize, out : []u8) -> usize {
  const need : usize = (len + 2) / 3 * 4;
  if (out.len < need) { return 0; }
  var i : usize = 0;
  var w : usize = 0;
  while (i + 2 < len) {
    const n : u32 = (buf[i] as u32) << 16 | (buf[i + 1] as u32) << 8 | buf[i + 2] as u32;
    out[w] = B64[(n >> 18) & 63] as u8;
    out[w + 1] = B64[(n >> 12) & 63] as u8;
    out[w + 2] = B64[(n >> 6) & 63] as u8;
    out[w + 3] = B64[n & 63] as u8;
    w = w + 4;
    i = i + 3;
  }
  const rem : usize = len - i;
  if (rem == 1) {
    const n : u32 = (buf[i] as u32) << 16;
    out[w] = B64[(n >> 18) & 63] as u8;
    out[w + 1] = B64[(n >> 12) & 63] as u8;
    out[w + 2] = 61; // '='
    out[w + 3] = 61;
    w = w + 4;
  }
  if (rem == 2) {
    const n : u32 = (buf[i] as u32) << 16 | (buf[i + 1] as u32) << 8;
    out[w] = B64[(n >> 18) & 63] as u8;
    out[w + 1] = B64[(n >> 12) & 63] as u8;
    out[w + 2] = B64[(n >> 6) & 63] as u8;
    out[w + 3] = 61;
    w = w + 4;
  }
  return w;
}

/// The value a server must answer for one client key: Base64(SHA-1(key + WS_GUID)).
/// key and out are byte buffers; key_len is the key's length (Base64 text is a byte string here).
/// The 60-byte concatenation needs the two-block sha1 above; a one-block build was the bug.
/// Returns the character count, or 0 on any refusal.
pub fn accept_of(key : []u8, key_len : usize, out : []u8) -> usize {
  var cat : [80]u8;
  if (key_len + WS_GUID.len > cat.len) { return 0; }
  var i : usize = 0;
  while (i < key_len) { cat[i] = key[i]; i = i + 1; }
  i = 0;
  while (i < WS_GUID.len) { cat[key_len + i] = WS_GUID[i] as u8; i = i + 1; }
  const total : usize = key_len + WS_GUID.len;
  var digest : [20]u8;
  const d : []u8 = digest[0..20];
  const dn : usize = sha1(cat[0..total], total, d);
  if (dn != 20) { return 0; }
  return b64_encode(d, 20, out);
}

// ---- tests ----------------------------------------------------------------------------------

test sha1_of_abc_is_the_known_digest {
  var msg : [8]u8;
  msg[0] = 97; // 'a'
  msg[1] = 98;
  msg[2] = 99;
  var d : [20]u8;
  const dd : []u8 = d[0..20];
  assert sha1(msg[0..3], 3, dd) == 20;
  // a9993e364706816aba3e25717850c26c9cd0d89d
  assert dd[0] == 0xA9;
  assert dd[1] == 0x99;
  assert dd[2] == 0x3E;
  assert dd[3] == 0x36;
  assert dd[4] == 0x47;
  assert dd[19] == 0x9D;
}

test sha1_of_the_empty_string_is_the_known_digest {
  var msg : [8]u8;
  var d : [20]u8;
  const dd : []u8 = d[0..20];
  assert sha1(msg[0..0], 0, dd) == 20;
  // da39a3ee5e6b4b0d3255bfef95601890afd80709
  assert dd[0] == 0xDA;
  assert dd[1] == 0x39;
  assert dd[2] == 0xA3;
  assert dd[19] == 0x09;
}

test b64_encodes_the_rfc_vector {
  // "sam" encodes to the RFC 6455 example alphabet
  var b : [8]u8;
  b[0] = 0x14; b[1] = 0xFB; b[2] = 0x9C; b[3] = 0x03; b[4] = 0xD9; b[5] = 0x7E;
  var o : [16]u8;
  const oo : []u8 = o[0..16];
  const n : usize = b64_encode(b[0..6], 6, oo);
  assert n == 8;
  assert oo[0] == 70; // 'F'
  assert oo[1] == 80; // 'P'
  assert oo[2] == 117; // 'u'
  assert oo[3] == 99; // 'c'
}

test b64_pads_one_and_two_leftover_bytes {
  var b : [4]u8;
  b[0] = 77; b[1] = 65; b[2] = 78; b[3] = 77; // "MAN" then one more byte
  var o : [8]u8;
  const oo : []u8 = o[0..8];
  assert b64_encode(b[0..3], 3, oo) == 4;
  assert oo[0] == 84; // 'T'
  assert oo[1] == 85; // 'U'
  assert oo[2] == 70; // 'F'
  assert b64_encode(b[0..4], 4, oo) == 8;
  assert oo[4] == 84; // 'T'
  assert oo[5] == 81; // 'Q'
  assert oo[6] == 61; // pad
  assert oo[7] == 61; // '='
}

test accept_of_the_rfc_key_is_the_rfc_accept {
  var k : [24]u8;
  const ks : string = "dGhlIHNhbXBsZSBub25jZQ==";
  var i : usize = 0;
  while (i < ks.len) { k[i] = ks[i] as u8; i = i + 1; }
  var o : [32]u8;
  const oo : []u8 = o[0..32];
  const n : usize = accept_of(k[0..24], 24, oo);
  assert n == 28;
  // s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
  assert oo[0] == 115; // 's'
  assert oo[1] == 51; // '3'
  assert oo[2] == 112; // 'p'
  assert oo[27] == 61; // '='
}

test accept_refuses_when_the_buffers_do_not_fit {
  var k : [24]u8;
  var o : [8]u8;
  const oo : []u8 = o[0..8];
  assert accept_of(k[0..24], 24, oo) == 0;
}

// the GUID rides in every acceptance computation
test the_guid_is_the_protocol_string {
  assert WS_GUID.len == 36;
  assert WS_GUID[0] == 50; // '2'
  assert WS_GUID[35] == 49; // '1'
}

invariant the_guid_is_thirty_six_chars { assert WS_GUID.len == 36; }
