// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents.t27 -- the coding agents T27 OS runs in its honeycomb, their session states and
; what happens to each session after the machine restarts.
; Owner, 2026-10-19: the honeycomb cells carry the marks of Claude Code, Codex, Crush, OpenCode, Gemini
; and others; chats are orchestrated from our app and sessions come back after a reboot.
; Studied first: herdr.dev (Apache 2.0, v0.9.5). Its model, which this spec follows:
;   a background server owns every agent terminal, so closing the window does not stop an agent;
;   each pane is read and marked working, blocked or idle, so the one waiting on you is shown;
;   after a restart the layout comes back and each agent's own session is resumed;
;   the agent CLIs are not wrapped or replaced, only their terminals are owned.
; Cell 4, the centre of the comb, is the Queen: our orchestrator, the one that prompts the others.
; The resume commands are each CLI's documented flag (Claude Code --resume, Codex resume, Gemini --resume,
; OpenCode --session, Cursor --resume, Aider --restore-chat-history, Copilot --resume). They are not yet
; probed on this machine; RESUME_UNKNOWN marks a CLI whose flag is not established, and such a session is
; relaunched fresh in its working directory instead of resumed.
; Host side still missing (follow-up): the terminal owner (posix_spawn + pty), the on-disk store of
; session records, and the state reader. This spec is the decisions they will read.

module T27osAgents;

pub const AGENT_COUNT : u32 = 9;
pub const AGENT_QUEEN : u32 = 4;
/// Names in cell order: top row, middle row (Queen in the centre), bottom row.
pub const AGENT_NAMES : str = "Claude Code,Codex,Gemini,OpenCode,Queen,Crush,Cursor,Aider,Copilot";
/// The command each cell launches.
pub const AGENT_BINS : str = "claude,codex,gemini,opencode,queen,crush,cursor-agent,aider,copilot";

/// How an agent's own session is brought back.
pub const RESUME_BY_ID : u32 = 0;
pub const RESUME_HISTORY : u32 = 1;
pub const RESUME_UNKNOWN : u32 = 2;
/// Per cell: Claude, Codex, Gemini, OpenCode, Queen, Crush, Cursor, Aider, Copilot.
pub const RESUME_KIND : [9]u32 = [0, 0, 0, 0, 2, 2, 0, 1, 0];

/// Session states, herdr's four plus STOPPED (no process: never started, crashed, or the machine restarted).
pub const S_STOPPED : u32 = 0;
pub const S_WORKING : u32 = 1;
pub const S_BLOCKED : u32 = 2;
pub const S_IDLE : u32 = 3;
pub const S_DONE : u32 = 4;

/// Events the terminal owner reports.
pub const E_OUTPUT : u32 = 0;
pub const E_PROMPT : u32 = 1;
pub const E_QUIET : u32 = 2;
pub const E_EXIT_OK : u32 = 3;
pub const E_EXIT_FAIL : u32 = 4;
pub const E_REBOOT : u32 = 5;
pub const E_INPUT : u32 = 6;

/// What a saved session gets when the app starts again.
pub const R_SKIP : u32 = 0;
pub const R_RESUME : u32 = 1;
pub const R_RELAUNCH : u32 = 2;

/// The next state of a session in state s on event e.
pub fn on_event(s: u32, e: u32) -> u32 {
    if (e == E_REBOOT) { return S_STOPPED; }
    if (e == E_EXIT_OK) { return S_DONE; }
    if (e == E_EXIT_FAIL) { return S_STOPPED; }
    if (s == S_STOPPED or s == S_DONE) { return s; }
    if (e == E_OUTPUT or e == E_INPUT) { return S_WORKING; }
    if (e == E_PROMPT) { return S_BLOCKED; }
    if (e == E_QUIET and s == S_WORKING) { return S_IDLE; }
    return s;
}

/// True when the session needs the user: the cell is lit so nobody hunts pane by pane.
pub fn needs_you(s: u32) -> bool {
    return s == S_BLOCKED;
}

/// What restart does with a session of agent a that was in state s when it was saved.
pub fn restore_action(a: u32, s: u32) -> u32 {
    if (s == S_DONE) { return R_SKIP; }
    if (a >= AGENT_COUNT) { return R_SKIP; }
    if (RESUME_KIND[a] == RESUME_UNKNOWN) { return R_RELAUNCH; }
    return R_RESUME;
}

/// The state a restored session shows before its process says anything.
pub fn restored_state(a: u32, s: u32) -> u32 {
    if (restore_action(a, s) == R_SKIP) { return s; }
    return S_IDLE;
}

test the_queen_sits_in_the_centre_cell {
    assert AGENT_QUEEN == 4;
    assert AGENT_COUNT == 9;
    assert RESUME_KIND[AGENT_QUEEN] == RESUME_UNKNOWN;
}

test states_follow_the_terminal {
    assert on_event(S_IDLE, E_OUTPUT) == S_WORKING;
    assert on_event(S_WORKING, E_PROMPT) == S_BLOCKED;
    assert needs_you(on_event(S_WORKING, E_PROMPT));
    assert on_event(S_BLOCKED, E_INPUT) == S_WORKING;
    assert on_event(S_WORKING, E_QUIET) == S_IDLE;
    assert on_event(S_BLOCKED, E_QUIET) == S_BLOCKED;
    assert on_event(S_WORKING, E_EXIT_OK) == S_DONE;
    assert on_event(S_DONE, E_OUTPUT) == S_DONE;
    assert on_event(S_WORKING, E_REBOOT) == S_STOPPED;
}

test a_reboot_brings_every_unfinished_session_back {
    // Claude Code was mid-task: resumed by its own session id
    assert restore_action(0, on_event(S_WORKING, E_REBOOT)) == R_RESUME;
    // Crush's resume flag is not established: relaunched fresh in the same directory
    assert restore_action(5, S_BLOCKED) == R_RELAUNCH;
    // a finished session stays finished
    assert restore_action(1, S_DONE) == R_SKIP;
    assert restored_state(0, S_STOPPED) == S_IDLE;
    assert restored_state(1, S_DONE) == S_DONE;
    // no agent outside the comb is restored
    assert restore_action(AGENT_COUNT, S_IDLE) == R_SKIP;
}
