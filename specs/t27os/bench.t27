test the_b_page_packs_two_cards_a_button_row_and_a_log_and_hits_them {
    assert CARD_COUNT == 2;
    const pw : f64 = 700.0;
    assert bp_card_w(pw) == 672.0;
    assert bp_card_w(2000.0) == BP_CARD_MAX_W;
    assert bp_card_y(CARD_AX7203) == BP_PAD;
    assert bp_card_y(CARD_ZYNQ) == BP_PAD + BP_CARD_H + BP_GAP;
    assert bp_log_y() == BP_PAD + 2.0 * (BP_CARD_H + BP_GAP);
    assert bp_log_h(100.0) == 56.0;
    assert bp_log_h(900.0) > 56.0;
    // the three buttons of card 0 and card 1, middle of each
    const by0 : f64 = bp_card_y(0) + bp_btn_y() + 5.0;
    const by1 : f64 = bp_card_y(1) + bp_btn_y() + 5.0;
    assert bp_hit(BP_PAD + bp_btn_x(0) + 5.0, by0, pw, BH_NONE) == BH_DETECT;
    assert bp_hit(BP_PAD + bp_btn_x(1) + 5.0, by0, pw, BH_NONE) == BH_FLASH;
    assert bp_hit(BP_PAD + bp_btn_x(2) + 5.0, by0, pw, BH_NONE) == BH_UART;
    assert bp_hit(BP_PAD + bp_btn_x(0) + 5.0, by1, pw, BH_NONE) == 8 + BH_DETECT;
    assert bp_hit(BP_PAD + bp_btn_x(2) + 5.0, by1, pw, BH_NONE) == 8 + BH_UART;
    // the gap between two buttons and the title row are no control
    assert bp_hit(BP_PAD + bp_btn_x(0) + BP_BTN_W + 2.0, by0, pw, BH_NONE) == BH_NONE;
    assert bp_hit(BP_PAD + 20.0, bp_card_y(0) + 10.0, pw, BH_NONE) == BH_NONE;
    // while card 1 asks for a path, its row holds the field, CONFIRM and CANCEL, and no DETECT
    const cw : f64 = bp_card_w(pw);
    assert bp_hit(BP_PAD + bp_confirm_x(cw) + 5.0, by1, pw, CARD_ZYNQ) == 8 + BH_CONFIRM;
    assert bp_hit(BP_PAD + bp_cancel_x(cw) + 5.0, by1, pw, CARD_ZYNQ) == 8 + BH_CANCEL;
    assert bp_hit(BP_PAD + BP_PAD + 5.0, by1, pw, CARD_ZYNQ) == 8 + BH_FIELD;
    assert bp_hit(BP_PAD + bp_btn_x(0) + BP_BTN_W + 40.0, by1, pw, CARD_ZYNQ) == 8 + BH_FIELD;
    assert bp_hit(BP_PAD + bp_btn_x(0) + 5.0, by0, pw, CARD_ZYNQ) == BH_DETECT;
    // the field, CONFIRM and CANCEL do not overlap
    assert bp_field_w(cw) > 100.0;
    assert BP_PAD + BP_PAD + bp_field_w(cw) < BP_PAD + bp_confirm_x(cw);
    assert bp_confirm_x(cw) + BP_BTN_W < bp_cancel_x(cw);
    // two cards and the log fit a 540 pt window below the header (about 450 pt)
    assert bp_log_y() < 340.0;
}

test idcode_and_bus_knownness_is_a_function_not_a_sentinel_the_window_repeats {
    assert idcode_known(0x3727093);
    assert idcode_known(HEX_NONE) == false;
    assert bus_known(4);
    assert bus_known(bus_none()) == false;
}

fn fmt_diff(f: u8, v: i64, want: string) -> u32 {
    // 0 when fmt_len and every fmt_char agree with want, and the char past the end is a blank
    var bad : u32 = 0;
    if (fmt_len(f, v) != (want.len as u32)) { bad = bad + 1; }
    var k : u32 = 0;
    while (k < (want.len as u32)) {
        if (fmt_char(f, v, k) != (want[k] as u32)) { bad = bad + 1; }
        k = k + 1;
    }
    if (fmt_char(f, v, want.len as u32) != 32) { bad = bad + 1; }
    if (fmt_char(f, v, (want.len as u32) + 7) != 32) { bad = bad + 1; }
    return bad;
}

fn cell_diff(f: u8, known: bool, v: i64, width: u32, want: string) -> u32 {
    var bad : u32 = 0;
    if (cell_len(f, known, v, width) != (want.len as u32)) { bad = bad + 1; }
    var k : u32 = 0;
    while (k < (want.len as u32)) {
        if (cell_char(f, known, v, width, k) != (want[k] as u32)) { bad = bad + 1; }
        k = k + 1;
    }
    return bad;
}

test prov_make_packs_kind_source_and_time_and_unpacks_them {
    assert prov_make(PV_MEASURED, BN_SRC_NONE, 0) == 0;
    assert prov_make(PV_DERIVED, BN_SRC_NONE, 0) == 1;
    assert prov_make(PV_NOT_MEASURED, BN_SRC_NONE, 0) == 2;
    assert prov_make(PV_MEASURED, SRC_SCAN_USB, 0) == 16;
    assert prov_make(PV_MEASURED, BN_SRC_NONE, 1) == 256;
    assert prov_make(PV_DERIVED, SRC_DETECT, 1791402176) == 1 + 32 + 1791402176 * 256;
    assert prov_make(15, 15, 0) == 255;
    const p : u64 = prov_make(PV_DERIVED, SRC_LS_TTY, 1792488364);
    assert prov_kind(p) == PV_DERIVED;
    assert prov_src(p) == SRC_LS_TTY;
    assert prov_at(p) == 1792488364;
    assert prov_make(PV_NOT_MEASURED, BN_SRC_NONE, 0) == prov_of(false, true, SRC_DETECT, 99);
    assert prov_of(true, true, SRC_YOSYS, 5) == prov_make(PV_DERIVED, SRC_YOSYS, 5);
    assert prov_of(true, false, SRC_YOSYS, 5) == prov_make(PV_MEASURED, SRC_YOSYS, 5);
}

test the_format_tables_give_digits_divisor_and_suffix_per_format {
    assert fmt_frac_digits(BN_F_COUNT) == 0;
    assert fmt_frac_digits(F_PERMILLE) == 1;
    assert fmt_frac_digits(F_NS) == 3;
    assert fmt_frac_digits(F_MHZ) == 3;
    assert fmt_frac_digits(9) == 0;
    assert fmt_divisor(BN_F_COUNT) == 1;
    assert fmt_divisor(F_PERMILLE) == 10;
    assert fmt_divisor(F_NS) == 1000;
    assert fmt_divisor(F_MHZ) == 1000;
    assert fmt_divisor(9) == 1;
    assert fmt_suffix(F_PERMILLE) == 1;
    assert fmt_suffix(BN_F_COUNT) == 0;
    assert fmt_suffix(F_NS) == 0;
    assert fmt_suffix(F_MHZ) == 0;
    assert fmt_neg(-1) == 1;
    assert fmt_neg(0) == 0;
    assert fmt_neg(1) == 0;
    assert fmt_neg(-1000000000000) == 1;
    assert fmt_neg(1000000000000) == 0;
    assert mag(0) == 0;
    assert mag(5) == 5;
    assert mag(-5) == 5;
    assert mag(1000000000000) == 1000000000000;
    assert mag(-1000000000000) == 1000000000000;
}

test decimal_digit_count_and_digit_j_of_a_zero_padded_number {
    assert dec_digits(0) == 1;
    assert dec_digits(9) == 1;
    assert dec_digits(10) == 2;
    assert dec_digits(99) == 2;
    assert dec_digits(100) == 3;
    assert dec_digits(4294967295) == 10;
    assert dec_digits(4294967296) == 10;
    assert dec_digits(10000000000) == 11;
    assert dec_char(123, 3, 0) == 49;
    assert dec_char(123, 3, 1) == 50;
    assert dec_char(123, 3, 2) == 51;
    assert dec_char(5, 3, 0) == 48;
    assert dec_char(5, 3, 1) == 48;
    assert dec_char(5, 3, 2) == 53;
    assert dec_char(0, 1, 0) == 48;
    assert dec_char(90, 2, 0) == 57;
    assert dec_char(90, 2, 1) == 48;
    // a number wider than nd keeps only its low nd digits
    assert dec_char(12345, 3, 0) == 51;
}

test fmt_len_and_fmt_char_print_sign_integer_fraction_and_percent {
    assert fmt_len(BN_F_COUNT, 0) == 1;
    assert fmt_len(BN_F_COUNT, 9) == 1;
    assert fmt_len(BN_F_COUNT, 10) == 2;
    assert fmt_len(BN_F_COUNT, -5) == 2;
    assert fmt_len(BN_F_COUNT, 123456) == 6;
    assert fmt_len(F_NS, 0) == 5;
    assert fmt_len(F_NS, 999) == 5;
    assert fmt_len(F_NS, 1000) == 5;
    assert fmt_len(F_NS, -1234) == 6;
    assert fmt_len(F_NS, 12500000) == 9;
    assert fmt_len(F_PERMILLE, 9) == 4;
    assert fmt_len(F_PERMILLE, 1000) == 6;
    assert fmt_len(F_PERMILLE, -9) == 5;
    assert fmt_len(F_MHZ, 846020) == 7;
    assert fmt_char(F_NS, -1234, 0) == 45;
    assert fmt_char(F_NS, -1234, 1) == 49;
    assert fmt_char(F_NS, -1234, 2) == 46;
    assert fmt_char(F_NS, -1234, 3) == 50;
    assert fmt_char(F_NS, -1234, 5) == 52;
    assert fmt_char(F_NS, -1234, 6) == 32;
    assert fmt_char(F_PERMILLE, 1000, 0) == 49;
    assert fmt_char(F_PERMILLE, 1000, 3) == 46;
    assert fmt_char(F_PERMILLE, 1000, 4) == 48;
    assert fmt_char(F_PERMILLE, 1000, 5) == 37;
    assert fmt_char(F_PERMILLE, 1000, 6) == 32;
    assert fmt_char(BN_F_COUNT, 0, 0) == 48;
    assert fmt_char(BN_F_COUNT, 0, 1) == 32;
    assert fmt_char(BN_F_COUNT, -7, 0) == 45;
    assert fmt_char(BN_F_COUNT, -7, 1) == 55;
    assert fmt_diff(BN_F_COUNT, 0, "0") == 0;
    assert fmt_diff(BN_F_COUNT, -70, "-70") == 0;
    assert fmt_diff(BN_F_COUNT, 4294967296, "4294967296") == 0;
    assert fmt_diff(F_NS, 5, "0.005") == 0;
    assert fmt_diff(F_NS, -5, "-0.005") == 0;
    assert fmt_diff(F_NS, 1000, "1.000") == 0;
    assert fmt_diff(F_NS, -12500000, "-12500.000") == 0;
    assert fmt_diff(F_PERMILLE, 0, "0.0%") == 0;
    assert fmt_diff(F_PERMILLE, 9, "0.9%") == 0;
    assert fmt_diff(F_PERMILLE, 999, "99.9%") == 0;
    assert fmt_diff(F_PERMILLE, 1000, "100.0%") == 0;
    assert fmt_diff(F_MHZ, 32870, "32.870") == 0;
    assert fmt_diff(F_MHZ, 846020, "846.020") == 0;
    assert fmt_diff(F_MHZ, 100000, "100.000") == 0;
    assert fmt_diff(F_NS, 1234, "1.235") == 1;
}

test cell_char_pads_on_the_left_and_cuts_nothing {
    assert cell_char(BN_F_COUNT, true, 1196, 8, 0) == 32;
    assert cell_char(BN_F_COUNT, true, 1196, 8, 3) == 32;
    assert cell_char(BN_F_COUNT, true, 1196, 8, 4) == 49;
    assert cell_char(BN_F_COUNT, true, 1196, 8, 7) == 54;
    assert cell_char(F_NS, true, -1234, 8, 1) == 32;
    assert cell_char(F_NS, true, -1234, 8, 2) == 45;
    assert cell_char(BN_F_COUNT, false, 0, 14, 0) == 32;
    assert cell_char(BN_F_COUNT, false, 0, 14, 1) == 32;
    assert cell_char(BN_F_COUNT, false, 0, 14, 2) == 110;
    assert cell_char(BN_F_COUNT, false, 0, 14, 13) == 100;
    assert cell_char(BN_F_COUNT, false, 0, 0, 0) == 110;
    assert cell_char(BN_F_COUNT, true, 123456789, 4, 0) == 49;
    assert cell_char(BN_F_COUNT, true, 123456789, 4, 8) == 57;
    assert cell_char(BN_F_COUNT, true, 5, 1, 0) == 53;
    assert cell_diff(F_PERMILLE, true, 500, 9, "    50.0%") == 0;
    assert cell_diff(F_MHZ, false, 7, 12, "not measured") == 0;
}

test num_at_and_num_end_read_a_run_of_digits {
    assert num_at("abc123def", 3) == 123;
    assert num_at("abc123def", 4) == 23;
    assert num_at("abc123def", 0) == HEX_NONE;
    assert num_at("abc123def", 6) == HEX_NONE;
    assert num_at("123", 0) == 123;
    assert num_at("007", 0) == 7;
    assert num_at("12 3", 0) == 12;
    assert num_at("12:3", 0) == 12;
    assert num_at("5", 0) == 5;
    assert num_at("5", 1) == HEX_NONE;
    assert num_at("", 0) == HEX_NONE;
    assert num_at("/9", 0) == HEX_NONE;
    assert num_at(":9", 0) == HEX_NONE;
    assert num_at("0", 0) == 0;
    assert num_at("4294967296", 0) == 4294967296;
    assert num_end("abc123def", 3) == 6;
    assert num_end("abc123def", 4) == 6;
    assert num_end("abc", 0) == 0;
    assert num_end("123", 0) == 3;
    assert num_end("123", 3) == 3;
    assert num_end("", 0) == 0;
    assert num_end("12:3", 0) == 2;
    assert num_end("/", 0) == 0;
    assert num_end(":", 0) == 0;
    assert num_end("09", 0) == 2;
    assert num_end("a9", 1) == 2;
}

test card_lookups_name_the_board_model_and_cable {
    assert card_board(CARD_AX7203) == BOARD_AX7203;
    assert card_board(CARD_ZYNQ) == BOARD_PZSDR_D;
    assert card_board(CARD_COUNT) == BOARD_AX7203;
    assert card_board(255) == BOARD_AX7203;
    assert card_model_text(CARD_AX7203) == "ALINX AX7203 (camera)";
    assert card_model_text(CARD_ZYNQ) == "model not established (guess)";
    assert card_cable_text(CARD_AX7203) == "Digilent HS2 FT232H";
    assert card_cable_text(CARD_ZYNQ) == "Digilent Adept FTDI2232";
    assert card_digit(CARD_AX7203) == "0";
    assert card_digit(CARD_ZYNQ) == "1";
    assert card_digit(CARD_COUNT) == "0";
}

test tp_nth_start_finds_the_hex_digits_of_each_tap_with_any_spacing {
    const det1 : string = "empty\nJtag frequency : requested 6.00MHz    -> real 6.00MHz   \nindex 0:\n\tidcode   0x4ba00477\n\ttype     ARM cortex A9\n\tirlength 4\nindex 1:\n\tidcode 0x3727093\n\tmanufacturer xilinx\n";
    assert tp_nth_start(det1, 0) == text_find(det1, "0x4ba00477", 0) + 2;
    assert tp_nth_start(det1, 1) == text_find(det1, "0x3727093", 0) + 2;
    assert tp_nth_start(det1, 2) == NOT_FOUND;
    assert tp_nth_start(det1, 100) == NOT_FOUND;
    assert tp_nth_start("", 0) == NOT_FOUND;
    assert tp_nth_start("idcode", 0) == NOT_FOUND;
    assert tp_nth_start("idcode ", 0) == NOT_FOUND;
    assert tp_nth_start("idcode 0", 0) == NOT_FOUND;
    assert tp_nth_start("idcode 0x", 0) == 9;
    assert tp_nth_start("idcode 0x5", 0) == 9;
    assert tp_nth_start("idcode\t\t0x5", 0) == 10;
    assert tp_nth_start("idcode0x5", 0) == 8;
    assert tp_nth_start("idcode 1x5", 0) == NOT_FOUND;
    assert tp_nth_start("idcode 0X5", 0) == NOT_FOUND;
    assert tp_nth_start("idcode zz\nidcode 0x7", 0) == 19;
    assert tp_nth_start("idcode zz\nidcode 0x7", 1) == NOT_FOUND;
    assert tp_nth_start("idcode 0x1\nidcode 0x2", 1) == 20;
}

test port_belongs_takes_the_serial_plus_at_most_one_channel_digit {
    const ax : string = "/dev/cu.usbserial-210512180081\n";
    assert port_belongs(ax, 0, BOARD_AX7203);
    assert port_belongs(ax, 0, BOARD_PZSDR_D) == false;
    assert port_belongs("/dev/cu.usbserial-210512180081", 0, BOARD_AX7203);
    assert port_belongs("/dev/cu.usbserial-2105121800810\n", 0, BOARD_AX7203);
    assert port_belongs("/dev/cu.usbserial-2105121800819\n", 0, BOARD_AX7203);
    assert port_belongs("/dev/cu.usbserial-21051218008100\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-210512180081a\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-210512180081/\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-210512180081:\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-21051218008\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-210512180082\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbserial-110512180081\n", 0, BOARD_AX7203) == false;
    assert port_belongs("/dev/cu.usbmodem-210512180081\n", 0, BOARD_AX7203) == false;
    assert port_belongs("", 0, BOARD_AX7203) == false;
    // the prefix must sit on the line of `at`, and `at` may start any later line
    const two : string = "foo\n/dev/cu.usbserial-210512180081\n";
    assert port_belongs(two, 0, BOARD_AX7203) == false;
    assert port_belongs(two, 4, BOARD_AX7203);
    const z : string = "/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-210512180081\n";
    assert port_belongs(z, 0, BOARD_PZSDR_D);
    assert port_belongs(z, 0, BOARD_AX7203) == false;
    assert port_belongs(z, 32, BOARD_AX7203);
    assert port_belongs(z, 32, BOARD_PZSDR_D) == false;
}

test arg_safe_takes_path_characters_and_nothing_a_shell_reads {
    assert arg_safe("") == false;
    assert arg_safe("a");
    assert arg_safe("0");
    assert arg_safe("Z");
    assert arg_safe("/tmp/a-b_c.d+e~f0Z9.bit");
    assert arg_safe("/dev/cu.usbserial-2102038592890");
    assert arg_safe("a b") == false;
    assert arg_safe(" ") == false;
    assert arg_safe("a;b") == false;
    assert arg_safe("a&b") == false;
    assert arg_safe("a|b") == false;
    assert arg_safe("a$b") == false;
    assert arg_safe("a`b") == false;
    assert arg_safe("a\nb") == false;
    assert arg_safe("a\tb") == false;
    assert arg_safe("a\"b") == false;
    assert arg_safe("a'b") == false;
    assert arg_safe("a(b") == false;
    assert arg_safe("a*b") == false;
    assert arg_safe("a,b") == false;
    assert arg_safe("a:b") == false;
    assert arg_safe("a=b") == false;
    assert arg_safe("a@b") == false;
    assert arg_safe("a[b") == false;
    assert arg_safe("a{b") == false;
    assert arg_safe("a\\b") == false;
    assert arg_safe("abc;") == false;
    assert arg_safe(";abc") == false;
}

test ends_with_compares_the_tail_byte_by_byte {
    assert ends_with("a.bit", ".bit");
    assert ends_with(".bit", ".bit");
    assert ends_with("", "");
    assert ends_with("a", "");
    assert ends_with("bit", ".bit") == false;
    assert ends_with("", ".bit") == false;
    assert ends_with("a.bix", ".bit") == false;
    assert ends_with("a.bit ", ".bit") == false;
    assert ends_with("xbit", ".bit") == false;
    assert ends_with("a.bit.bin", ".bit") == false;
    assert ends_with("a.Bit", ".bit") == false;
    assert ends_with("ab", "ab");
    assert ends_with("ab", "b");
    assert ends_with("ab", "a") == false;
}

test the_command_pieces_have_their_text_and_length {
    // pieces 0..8: text, cable, text, bus digits, colon, device digits, tail, path, end
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 0, "") == "openFPGALoader -c ";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 0, "") == "screen ";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 1, "") == "digilent";
    assert cmd_text(CARD_AX7203, ACT_FLASH, 1, "") == "digilent_hs2";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 1, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 2, "") == " --busdev-num ";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 2, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 3, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 4, "") == ":";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 4, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 5, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 6, "") == " --detect\n";
    assert cmd_text(CARD_ZYNQ, ACT_FLASH, 6, "") == " ";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 6, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 7, "/x") == "";
    assert cmd_text(CARD_ZYNQ, ACT_FLASH, 7, "/x.bit") == "/x.bit";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 7, "/dev/p") == "/dev/p";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 8, "") == "";
    assert cmd_text(CARD_ZYNQ, ACT_FLASH, 8, "") == "\n";
    assert cmd_text(CARD_ZYNQ, ACT_UART, 8, "") == " 115200\n";
    assert cmd_text(CARD_ZYNQ, ACT_DETECT, 9, "") == "";
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 0) == 18;
    assert cmd_piece_len(CARD_ZYNQ, ACT_UART, 2, "", 0) == 7;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 1) == 8;
    assert cmd_piece_len(CARD_AX7203, ACT_DETECT, 4, "", 1) == 12;
    assert cmd_piece_len(CARD_AX7203, ACT_UART, 4, "", 1) == 0;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 2) == 14;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 4) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_UART, 2, "", 4) == 0;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 6) == 10;
    assert cmd_piece_len(CARD_ZYNQ, ACT_FLASH, 2, "", 6) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 7) == 6;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "/x.bit", 7) == 0;
    assert cmd_piece_len(CARD_ZYNQ, ACT_FLASH, 2, "", 8) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_UART, 2, "", 8) == 8;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 9) == 0;
    // the bus pieces count digits of bus / 1000 and bus % 1000 (not zero padded); a UART command has none
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 3) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 2, "", 5) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 1006, "", 3) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 1006, "", 5) == 1;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 12345, "", 3) == 2;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 12345, "", 5) == 3;
    assert cmd_piece_len(CARD_ZYNQ, ACT_DETECT, 100999, "", 3) == 3;
    assert cmd_piece_len(CARD_ZYNQ, ACT_UART, 12345, "", 3) == 0;
    assert cmd_piece_len(CARD_ZYNQ, ACT_UART, 12345, "", 5) == 0;
    assert cmd_raw_len(CARD_ZYNQ, ACT_DETECT, 2, "") == 53;
    assert cmd_raw_len(CARD_AX7203, ACT_DETECT, 4, "") == 57;
    assert cmd_raw_len(CARD_ZYNQ, ACT_DETECT, 12345, "") == 53 + 3;
    assert cmd_raw_len(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit") == 18 + 8 + 14 + 3 + 1 + 6 + 1;
    assert cmd_raw_len(CARD_ZYNQ, ACT_UART, 0, "/dev/p") == 7 + 6 + 8;
    assert cmd_raw_len(CARD_ZYNQ, ACT_UART, 12345, "") == 15;
}

test cmd_char_walks_the_pieces_and_ends_with_zero {
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 0) == 111;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 17) == 32;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 18) == 100;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 25) == 116;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 40) == 48;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 41) == 58;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 42) == 50;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 43) == 32;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 52) == 10;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 53) == 0;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 2, "", 400) == 0;
    // a two-digit bus and a three-digit device: 12:345
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 40) == 49;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 41) == 50;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 42) == 58;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 43) == 51;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 44) == 52;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 45) == 53;
    assert cmd_char(CARD_ZYNQ, ACT_DETECT, 12345, "", 46) == 32;
    assert cmd_char(CARD_AX7203, ACT_DETECT, 4, "", 18) == 100;
    assert cmd_char(CARD_AX7203, ACT_DETECT, 4, "", 29) == 50;
    assert cmd_char(CARD_AX7203, ACT_DETECT, 4, "", 30) == 32;
    // FLASH: the path sits between the blank and the LF
    assert cmd_char(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 43) == 32;
    assert cmd_char(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 44) == 47;
    assert cmd_char(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 49) == 116;
    assert cmd_char(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 50) == 10;
    assert cmd_char(CARD_ZYNQ, ACT_FLASH, 2, "/x.bit", 51) == 0;
    // UART: screen, path, baud
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 0) == 115;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 6) == 32;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 7) == 47;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 12) == 112;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 13) == 32;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 14) == 49;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 20) == 10;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 0, "/dev/p", 21) == 0;
    assert cmd_char(CARD_ZYNQ, ACT_UART, 12345, "/dev/p", 7) == 47;
}

test cmd_allowed_gates_card_state_bus_path_confirm_and_the_cap {
    const scan : string = "000 004 0x0403:0x6014 ft232H Digilent 210512180081 x\n000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const zynq : string = "index 0:\n\tidcode 0x4ba00477\nindex 1:\n\tidcode 0x3727093\n";
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n/dev/cu.usbserial-210512180081\n";
    const z : u64 = card_state(CARD_ZYNQ, scan, zynq, true, ls);
    const portless : u64 = card_state(CARD_ZYNQ, scan, zynq, true, "");
    const empty : u64 = card_state(CARD_ZYNQ, scan, "Jtag frequency\n", true, ls);
    const up : string = "/dev/cu.usbserial-2102038592891";
    // DETECT: any state with a cable, a bus, no argument rule
    assert cmd_allowed(CARD_ZYNQ, ACT_DETECT, z, 2, "", false);
    assert cmd_allowed(CARD_ZYNQ, ACT_DETECT, z, 2, "a b; rm", false);
    assert cmd_allowed(CARD_ZYNQ, ACT_DETECT, empty, 2, "", false);
    assert cmd_allowed(CARD_ZYNQ, ACT_DETECT, 0, 2, "", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_DETECT, z, BUSDEV_NONE, "", false) == false;
    assert cmd_allowed(CARD_COUNT, ACT_DETECT, z, 2, "", false) == false;
    assert cmd_allowed(255, ACT_DETECT, z, 2, "", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_COUNT, z, 2, "", false) == false;
    // FLASH: ready chain, a bus, a safe .bit path, a confirm
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, "/tmp/a.bit", true);
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, "/tmp/a.bit", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, "/tmp/a.bin", true) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, "/tmp/a b.bit", true) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, "", true) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, BUSDEV_NONE, "/tmp/a.bit", true) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, empty, 2, "/tmp/a.bit", true) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, 0, 2, "/tmp/a.bit", true) == false;
    // UART: a port exists, the path begins with the port prefix, no bus is needed
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, BUSDEV_NONE, up, false);
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 2, up, true);
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, portless, 2, up, false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 2, "", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 2, "/dev/null", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 2, "x/dev/cu.usbserial-1", false) == false;
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 2, "/dev/cu.usbserial-1;x", false) == false;
    // the 200-byte cap: FLASH is 45 bytes plus the path, UART is 15 plus the node
    const p155 : string = "/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bit";
    const p156 : string = "/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bit";
    assert (p155.len as u32) == 155;
    assert (p156.len as u32) == 156;
    assert cmd_raw_len(CARD_ZYNQ, ACT_FLASH, 2, p155) == CMD_CAP;
    assert cmd_raw_len(CARD_ZYNQ, ACT_FLASH, 2, p156) == CMD_CAP + 1;
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, p155, true);
    assert cmd_allowed(CARD_ZYNQ, ACT_FLASH, z, 2, p156, true) == false;
    const u185 : string = "/dev/cu.usbserial-11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111";
    const u186 : string = "/dev/cu.usbserial-111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111";
    assert (u185.len as u32) == 185;
    assert cmd_raw_len(CARD_ZYNQ, ACT_UART, 0, u185) == CMD_CAP;
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 0, u185, false);
    assert cmd_allowed(CARD_ZYNQ, ACT_UART, z, 0, u186, false) == false;
}

test feed_det_piece_and_feed_detect_char_build_the_redirect_and_the_command {
    assert feed_det_piece(CARD_ZYNQ, 0) == " > $D/det";
    assert feed_det_piece(CARD_ZYNQ, 1) == "1";
    assert feed_det_piece(CARD_AX7203, 1) == "0";
    assert feed_det_piece(CARD_ZYNQ, 2) == ".txt.part 2>&1; mv $D/det";
    assert feed_det_piece(CARD_ZYNQ, 3) == "1";
    assert feed_det_piece(CARD_AX7203, 3) == "0";
    assert feed_det_piece(CARD_ZYNQ, 4) == ".txt.part $D/det";
    assert feed_det_piece(CARD_ZYNQ, 5) == "1";
    assert feed_det_piece(CARD_AX7203, 5) == "0";
    assert feed_det_piece(CARD_ZYNQ, 6) == ".txt; ";
    assert feed_det_piece(CARD_ZYNQ, 7) == "";
    assert feed_det_piece(CARD_ZYNQ, 100) == "";
    assert FEED_DET_PIECES == 7;
    // the command is the DETECT PTY command, char for char, one shorter than the raw length at its LF
    assert feed_detect_char(CARD_ZYNQ, 2, 0) == 111;
    assert feed_detect_char(CARD_ZYNQ, 2, 40) == 48;
    assert feed_detect_char(CARD_ZYNQ, 2, 43) == 32;
    assert feed_detect_char(CARD_ZYNQ, 2, 51) == 116;
    assert feed_detect_char(CARD_ZYNQ, 2, 52) == 10;
    assert feed_detect_char(CARD_AX7203, 4, 18) == 100;
    assert feed_detect_char(CARD_AX7203, 4, 30) == 32;
    assert feed_detect_char(CARD_ZYNQ, 1006, 40) == 49;
    assert feed_detect_char(CARD_ZYNQ, 1006, 42) == 54;
}
