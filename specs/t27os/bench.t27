test the_flash_dialogue_asks_for_a_path_then_a_click_and_never_loads_on_a_key {
    assert fs_next(FS_NONE, FE_FLASH_CLICK, false) == FS_TYPING;
    assert fs_next(FS_NONE, FE_RETURN, true) == FS_NONE;
    assert fs_next(FS_NONE, FE_CONFIRM, true) == FS_NONE;
    assert fs_next(FS_TYPING, FE_RETURN, false) == FS_TYPING;
    assert fs_next(FS_TYPING, FE_RETURN, true) == FS_CONFIRM;
    assert fs_next(FS_TYPING, FE_ESCAPE, true) == FS_NONE;
    assert fs_next(FS_TYPING, FE_CANCEL, true) == FS_NONE;
    assert fs_next(FS_TYPING, FE_CONFIRM, true) == FS_TYPING;
    assert fs_next(FS_CONFIRM, FE_RETURN, true) == FS_CONFIRM;
    assert fs_next(FS_CONFIRM, FE_CONFIRM, true) == FS_RUN;
    assert fs_next(FS_CONFIRM, FE_ESCAPE, true) == FS_NONE;
    assert fs_next(FS_CONFIRM, FE_CANCEL, true) == FS_NONE;
    // every path to FS_RUN passes the confirm stage
    var st : u32 = FS_NONE;
    st = fs_next(st, FE_FLASH_CLICK, true);
    st = fs_next(st, FE_CONFIRM, true);
    assert st != FS_RUN;
    st = fs_next(st, FE_RETURN, true);
    assert st == FS_CONFIRM;
    st = fs_next(st, FE_CONFIRM, true);
    assert st == FS_RUN;
    assert fs_next(FS_RUN, FE_RETURN, true) == FS_NONE;
}

