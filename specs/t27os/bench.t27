test percent_is_permille_rounded_half_up {
    // 1196 LUT is the yosys count in docs/analog/board-regression-2026-10-19.md
    assert permille(1196, 134600) == 9;
    assert permille(67300, 134600) == 500;
    assert permille(134600, 134600) == 1000;
    assert permille(0, 134600) == 0;
    assert permille(5, 0) == 0;
    assert cell_is(F_PERMILLE, true, 9, 0, "0.9%");
    assert cell_is(F_PERMILLE, true, 500, 0, "50.0%");
    assert cell_is(F_PERMILLE, true, 1000, 0, "100.0%");
}

test picoseconds_print_as_nanoseconds_with_three_decimals_and_a_sign {
    assert cell_is(F_NS, true, 1234, 0, "1.234");
    assert cell_is(F_NS, true, 0, 0, "0.000");
    assert cell_is(F_NS, true, 5, 0, "0.005");
    assert cell_is(F_NS, true, -1234, 0, "-1.234");
    assert cell_is(F_NS, true, -5, 0, "-0.005");
    assert cell_is(F_NS, true, -12500000, 0, "-12500.000");
    assert cell_is(F_MHZ, true, 32870, 0, "32.870");
    assert cell_is(F_MHZ, true, 846020, 0, "846.020");
}

test negative_slack_is_a_violation_and_unknown_slack_says_nothing {
    assert timing_verdict(true, 250) == TIMING_MET;
    assert timing_verdict(true, 0) == TIMING_MET;
    assert timing_verdict(true, -1) == TIMING_VIOLATED;
    assert timing_verdict(false, -1) == TIMING_UNKNOWN;
    assert timing_verdict(false, 0) == TIMING_UNKNOWN;
}

test a_value_without_a_measurement_prints_not_measured_never_zero {
    assert cell_is(BN_F_COUNT, false, 0, 0, "not measured");
    assert cell_is(F_NS, false, 0, 0, "not measured");
    assert cell_is(F_MHZ, false, 0, 0, "not measured");
    assert cell_is(F_PERMILLE, false, 0, 0, "not measured");
    // a measured zero is a zero: "0 DSP" is a result
    assert cell_is(BN_F_COUNT, true, 0, 0, "0");
    assert cell_is(BN_F_COUNT, false, 0, 0, "0") == false;
}

test columns_align_to_the_right {
    assert cell_is(BN_F_COUNT, true, 1196, 8, "    1196");
    assert cell_is(F_NS, true, -1234, 8, "  -1.234");
    assert cell_is(BN_F_COUNT, false, 0, 14, "  not measured");
    assert cell_is(BN_F_COUNT, true, 123456789, 4, "123456789");
    assert cell_len(BN_F_COUNT, true, 7, 6) == 6;
    assert cell_len(BN_F_COUNT, false, 0, 6) == 12;
}

test fmax_parses_the_nextpnr_line {
    // docs/theory/IGLA-FORMAL-RESULTS.md line 23846 and 23848
    assert fmax_khz("    Max frequency for clock 'slowclk': 32.87 MHz (PASS at 8.85 MHz)") == 32870;
    assert fmax_khz("    Max frequency for clock 'cfgmclk': 846.02 MHz (PASS at 70.77 MHz)") == 846020;
    assert fmax_khz("Max frequency for clock 'c': 100 MHz") == 100000;
    assert fmax_khz("nothing here") == HEX_NONE;
    assert fmax_khz("Max frequency for clock 'c': MHz") == HEX_NONE;
}

test the_receipt_gives_the_loaded_seal_and_its_time {
    // docs/reports/silicon-runs/index.json, first receipt (pretty-printed layout)
    const r : string = "{\n        \"auth\": \"FRESH\",\n        \"device_dna\": \"050d58218fd9854\",\n        \"seal_hash\": \"sha256:a769f41ecf2da17a27d68cabd5f0a132f010b89a3d08eade51a454ba8064e7fa\",\n        \"utc_unix\": 1791402176,\n        \"verdict_word\": 0\n}";
    assert receipt_utc(r) == 1791402176;
    assert receipt_seal_prefix(r) == 0xa769f41e;
    assert receipt_utc("{}") == HEX_NONE;
    assert receipt_seal_prefix("{}") == HEX_NONE;
    assert receipt_seal_prefix("\"seal_hash\": \"sha256:a76") == HEX_NONE;
}

test the_uart_counter_counts_lines {
    assert uart_lines("") == 0;
    assert uart_lines("a\nb\nc\n") == 3;
    assert uart_lines("no newline yet") == 0;
}

test the_2026_10_20_bench_two_cables_on_bus_zero {
    const scan : string = "found 2 USB device\nBus device vid:pid       probe type      manufacturer serial               product\n000 004    0x0403:0x6014 ft232H          Digilent     210512180081         Digilent USB Device\n000 002    0x0403:0x6010 FTDI2232        Digilent     210203859289         Digilent Adept USB Device\n";
    assert scan_busdev(scan, BOARD_AX7203) == 4;
    assert scan_busdev(scan, BOARD_PZSDR_D) == 2;
    assert scan_busdev("001:006 0x0403:0x6014 ft232H Digilent 210512180081 x\n", BOARD_AX7203) == 1006;
    // three QMTech cables share one serial: no single busdev
    const three : string = "001 004 0x0403:0x6014 a 210512180081 b\n001 006 0x0403:0x6014 a 210512180081 b\n001 008 0x0403:0x6014 a 210512180081 b\n";
    assert scan_busdev(three, BOARD_AX7203) == BUSDEV_NONE;
    assert scan_busdev("", BOARD_PZSDR_D) == BUSDEV_NONE;
    assert line_start("ab\ncd", 4) == 3;
    assert line_start("ab\ncd", 1) == 0;
}

test a_two_device_chain_and_an_empty_chain_are_told_apart {
    const zynq : string = "index 0:\n\tidcode 0x4ba00477\n\ttype ARM cortex A9\n\tirlength 4\nindex 1:\n\tidcode 0x3727093\n";
    const empty : string = "Jtag frequency : requested 6.00MHz -> real 6.00MHz\n";
    assert chain_state(zynq, BOARD_PZSDR_D) == CH_OK;
    assert chain_state(empty, BOARD_AX7203) == CH_EMPTY;
    assert chain_state(zynq, BOARD_AX7203) == CH_OTHER;
    assert chain_state("index 0:\n\tidcode 0x3636093\n", BOARD_AX7203) == CH_OK;
    const scan : string = "000 004 0x0403:0x6014 ft232H Digilent 210512180081 x\n000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n/dev/cu.usbserial-210512180081\n";
    const z : u64 = card_state(CARD_ZYNQ, scan, zynq, true, ls);
    const x : u64 = card_state(CARD_AX7203, scan, empty, true, ls);
    assert die_status(z) == DIE_READY;
    assert die_status_text(die_status(z)) == "ready";
    assert st_has(z, ST_PORT);
    assert die_status(x) == DIE_CHAIN_EMPTY;
    assert die_status_text(die_status(x)) == "chain empty";
    assert die_status(x) != DIE_NO_CABLE;
    // no cable at all is a different word
    assert die_status(card_state(CARD_ZYNQ, "", "", false, "")) == DIE_NO_CABLE;
    // a cable that --detect has not been run against is not an empty chain
    assert die_status(card_state(CARD_AX7203, scan, "", false, ls)) == DIE_CABLE_ONLY;
    assert lamp_of(DIE_NO_CABLE) == LAMP_GREY;
    assert lamp_of(DIE_CHAIN_EMPTY) == LAMP_RED;
    assert lamp_of(DIE_CABLE_ONLY) == LAMP_AMBER;
    assert lamp_of(DIE_READY) == LAMP_GREEN;
    assert lamp_of(DIE_RUNNING) == LAMP_BLUE;
}

test the_real_zynq_and_empty_detect_files_of_2026_10_20_are_read_whole {
    const det1 : string = "empty\nJtag frequency : requested 6.00MHz    -> real 6.00MHz   \nindex 0:\n\tidcode   0x4ba00477\n\ttype     ARM cortex A9\n\tirlength 4\nindex 1:\n\tidcode 0x3727093\n\tmanufacturer xilinx\n\tfamily zynq\n\tmodel  xc7z020\n\tirlength 6\n";
    const det0 : string = "empty\nJtag frequency : requested 6.00MHz    -> real 6.00MHz   \n";
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n/dev/cu.usbserial-210512180081\n";
    const scan : string = "empty\nBus device vid:pid       probe_type manufacturer serial       product\n000 004    0x0403:0x6014 ft232H     Digilent     210512180081 Digilent USB Device\n000 002    0x0403:0x6010 FTDI2232   Digilent     210203859289 Digilent Adept USB Device\n";
    assert tp_count(det1) == 2;
    assert tp_count(det0) == 0;
    assert tp_idcode(det1, 0) == 0x4ba00477;
    assert tp_idcode(det1, 1) == 0x3727093;
    assert tp_idcode(det1, 2) == HEX_NONE;
    assert card_idcode_live(det1, 0) == 0x4ba00477;
    assert card_idcode_live(det1, 1) == 0x3727093;
    assert chain_state(det1, BOARD_PZSDR_D) == CH_OK;
    assert chain_state(det0, BOARD_AX7203) == CH_EMPTY;
    assert chain_state(det1, BOARD_AX7203) == CH_OTHER;
    assert tp_field_len(det1, tp_field_at(det1, 1, "manufacturer")) == 6;
    assert tp_field_len(det1, tp_field_at(det1, 1, "family")) == 4;
    assert tp_field_len(det1, tp_field_at(det1, 1, "model")) == 7;
    assert tp_field_at(det1, 0, "model") == NOT_FOUND;
    assert tp_field_at(det0, 0, "model") == NOT_FOUND;
    assert text_find(det1, "xc7z020", 0) == tp_field_at(det1, 1, "model");
    const z : u64 = card_state(CARD_ZYNQ, scan, det1, true, ls);
    const x : u64 = card_state(CARD_AX7203, scan, det0, true, ls);
    assert die_status(z) == DIE_READY;
    assert lamp_of(die_status(z)) == LAMP_GREEN;
    assert die_status(x) == DIE_CHAIN_EMPTY;
    assert lamp_of(die_status(x)) == LAMP_RED;
    assert port_count(ls, BOARD_PZSDR_D) == 2;
    assert port_count(ls, BOARD_AX7203) == 1;
    assert port_len(ls, port_at(ls, CARD_AX7203, 0)) == 30;
    const bz : u64 = card_busdev(CARD_ZYNQ, scan);
    const bx : u64 = card_busdev(CARD_AX7203, scan);
    assert bz == 2;
    assert bx == 4;
    assert cmd_is(CARD_ZYNQ, ACT_DETECT, z, bz, "", false, "openFPGALoader -c digilent --busdev-num 0:2 --detect\n");
    assert cmd_is(CARD_AX7203, ACT_DETECT, x, bx, "", false, "openFPGALoader -c digilent_hs2 --busdev-num 0:4 --detect\n");
}

test serial_ports_belong_by_the_cable_serial {
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n/dev/cu.usbserial-210512180081\n";
    assert port_count(ls, BOARD_PZSDR_D) == 2;
    assert port_count(ls, BOARD_AX7203) == 1;
    assert port_nth_start(ls, BOARD_PZSDR_D, 0) == 22;
    assert port_nth_start(ls, BOARD_PZSDR_D, 1) == 54;
    assert port_nth_start(ls, BOARD_PZSDR_D, 2) == NOT_FOUND;
    // a longer digit tail is another serial
    assert port_count("/dev/cu.usbserial-21020385928912\n", BOARD_PZSDR_D) == 0;
    assert port_count("", BOARD_AX7203) == 0;
}

test the_card_states_its_chain_provenance_and_layout {
    assert CARD_COUNT == 2;
    assert card_title(CARD_ZYNQ) == "Zynq XC7Z020";
    assert card_chain_len(CARD_ZYNQ) == 2;
    assert box_label(CARD_ZYNQ, 0) == "ARM A9";
    assert box_label(CARD_ZYNQ, 1) == "PL";
    assert box_label(CARD_AX7203, 0) == "PL";
    assert card_idcode_measured(CARD_ZYNQ, 0) == 0x4ba00477;
    assert card_idcode_measured(CARD_ZYNQ, 1) == 0x3727093;
    assert card_idcode_measured(CARD_AX7203, 0) == HEX_NONE;
    assert card_serial(CARD_ZYNQ) == "210203859289";
    assert card_model_known(CARD_ZYNQ) == false;
    assert card_model_known(CARD_AX7203);
    // a measured value carries its command and time; the AX7203's idcode today is not measured, not 0
    assert prov_kind(card_prov(CARD_ZYNQ, FLD_IDCODE)) == PV_MEASURED;
    assert prov_at(card_prov(CARD_ZYNQ, FLD_IDCODE)) == 1792488364;
    assert prov_kind(card_prov(CARD_AX7203, FLD_IDCODE)) == PV_NOT_MEASURED;
    assert prov_kind(card_prov(CARD_AX7203, FLD_CHAIN)) == PV_MEASURED;
    assert card_measured_command(CARD_ZYNQ, FLD_CHAIN) == "openFPGALoader -c digilent --busdev-num 0:2 --detect";
    assert card_measured_command(CARD_AX7203, FLD_CHAIN) == "openFPGALoader -c digilent_hs2 --busdev-num 0:4 --detect";
    assert box_x(1) == 17;
    assert chain_width(CARD_ZYNQ) == 31;
    assert chain_width(CARD_AX7203) == 14;
    assert btn_x(2) == 22;
    assert ROW_COUNT == 8;
    assert row_label(ROW_BUSDEV) == "busdev";
}

test button_commands_are_text_pieces_under_the_cap_and_flash_needs_a_path_and_a_confirm {
    const scan : string = "000 004 0x0403:0x6014 ft232H Digilent 210512180081 x\n000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const zynq : string = "index 0:\n\tidcode 0x4ba00477\nindex 1:\n\tidcode 0x3727093\n";
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n/dev/cu.usbserial-210512180081\n";
    const z : u64 = card_state(CARD_ZYNQ, scan, zynq, true, ls);
    const bus : u64 = scan_busdev(scan, BOARD_PZSDR_D);
    assert cmd_is(CARD_ZYNQ, ACT_DETECT, z, bus, "", false, "openFPGALoader -c digilent --busdev-num 0:2 --detect\n");
    assert cmd_is(CARD_ZYNQ, ACT_UART, z, bus, "/dev/cu.usbserial-2102038592891", false, "screen /dev/cu.usbserial-2102038592891 115200\n");
    // FLASH: no path, no confirm, a wrong suffix, or a shell character each give no command
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, "", true) == 0;
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, "/tmp/a.bit", false) == 0;
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, "/tmp/a.txt", true) == 0;
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, "/tmp/a.bit; rm -rf x", true) == 0;
    assert cmd_is(CARD_ZYNQ, ACT_FLASH, z, bus, "/tmp/a.bit", true, "openFPGALoader -c digilent --busdev-num 0:2 /tmp/a.bit\n");
    assert act_needs_confirm(ACT_FLASH);
    assert act_needs_confirm(ACT_DETECT) == false;
    // the UART button takes only a serial node
    assert cmd_len(CARD_ZYNQ, ACT_UART, z, bus, "/etc/passwd", false) == 0;
    // an empty chain still allows DETECT, never FLASH
    const x : u64 = card_state(CARD_AX7203, scan, "Jtag frequency : requested 6.00MHz\n", true, ls);
    assert act_enabled(x, ACT_DETECT);
    assert act_enabled(x, ACT_FLASH) == false;
    assert cmd_is(CARD_AX7203, ACT_DETECT, x, 4, "", false, "openFPGALoader -c digilent_hs2 --busdev-num 0:4 --detect\n");
    assert cmd_len(CARD_AX7203, ACT_FLASH, x, 4, "/tmp/a.bit", true) == 0;
    // no cable, nothing runs; no bus read, no openFPGALoader command
    assert cmd_len(CARD_ZYNQ, ACT_DETECT, 0, bus, "", false) == 0;
    assert cmd_len(CARD_ZYNQ, ACT_DETECT, z, BUSDEV_NONE, "", false) == 0;
    // over the 200-byte cap is refused
    const long : string = "/tmp/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bit";
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, long, true) == 0;
    assert cmd_len(CARD_ZYNQ, ACT_FLASH, z, bus, "/tmp/a.bit", true) <= CMD_CAP;
    assert act_label(ACT_DETECT) == "DETECT";
    assert act_label(ACT_FLASH) == "FLASH";
    assert act_label(ACT_UART) == "UART";
}

fn feed_line(c: u8, st: u64, bus: u64, out: []u8) -> u32 {
    // the stage-2 text of one card, built the way the host builds it
    var n : u32 = 0;
    const dl : u32 = feed_detect_len(c, st, bus);
    var k : u32 = 0;
    while (k < dl) { out[n] = feed_detect_char(c, bus, k) as u8; n = n + 1; k = k + 1; }
    var p : u32 = 0;
    while (p < FEED_DET_PIECES) {
        const t : string = feed_det_piece(c, p);
        var j : u32 = 0;
        while (j < (t.len as u32)) { out[n] = t[j] as u8; n = n + 1; j = j + 1; }
        p = p + 1;
    }
    return n;
}

test the_detect_stage_builds_one_redirected_command_per_card_with_a_single_cable {
    const scan : string = "000 004 0x0403:0x6014 ft232H Digilent 210512180081 x\n000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const ls : string = "";
    const z : u64 = card_state(CARD_ZYNQ, scan, "", false, ls);
    const bus : u64 = card_busdev(CARD_ZYNQ, scan);
    assert bus == 2;
    var b : [400]u8 = undefined;
    const n : u32 = feed_line(CARD_ZYNQ, z, bus, b[0..400]);
    const want : string = "openFPGALoader -c digilent --busdev-num 0:2 --detect > $D/det1.txt.part 2>&1; mv $D/det1.txt.part $D/det1.txt; ";
    assert n == (want.len as u32);
    var i : u32 = 0;
    while (i < n) { assert (b[i] as u32) == (want[i] as u32); i = i + 1; }
    const x : u64 = card_state(CARD_AX7203, scan, "", false, ls);
    const n2 : u32 = feed_line(CARD_AX7203, x, card_busdev(CARD_AX7203, scan), b[0..400]);
    const want2 : string = "openFPGALoader -c digilent_hs2 --busdev-num 0:4 --detect > $D/det0.txt.part 2>&1; mv $D/det0.txt.part $D/det0.txt; ";
    assert n2 == (want2.len as u32);
    // no cable, no command; two cables of one row (no single busdev), no command
    assert feed_detect_len(CARD_ZYNQ, 0, BUSDEV_NONE) == 0;
    assert feed_detect_len(CARD_ZYNQ, z, BUSDEV_NONE) == 0;
    const three : string = "001 004 0x0403:0x6014 a 210512180081 b\n001 006 0x0403:0x6014 a 210512180081 b\n";
    assert card_busdev(CARD_AX7203, three) == BUSDEV_NONE;
    assert file_detect(CARD_AX7203) == "det0.txt";
    assert file_detect(CARD_ZYNQ) == "det1.txt";
}

test the_feed_pieces_keep_the_log_files_in_the_bench_dir_and_never_a_key_or_a_network_call {
    assert text_find(FEED_HEAD_B, "mkdir -p $D", 0) != TEXT_NONE;
    assert text_find(FEED_HEAD_B, "/opt/homebrew/bin", 0) != TEXT_NONE;
    assert text_find(FEED_SCAN, "openFPGALoader --scan-usb", 0) == 0;
    assert text_find(FEED_SCAN, "mv $D/scan.txt.part $D/scan.txt", 0) != TEXT_NONE;
    assert text_find(FEED_SCAN, "mv $D/ls.txt.part $D/ls.txt", 0) != TEXT_NONE;
    assert text_find(FEED_SCAN, "curl", 0) == TEXT_NONE;
    assert text_find(FEED_RUN_TAIL, "mv $D/run.txt.part $D/run.txt", 0) != TEXT_NONE;
    assert BENCH_DIR == "/.t27os/bench/";
    assert FILE_SCAN == "scan.txt";
    assert FILE_LS == "ls.txt";
    assert FILE_RUN == "run.txt";
    assert FEED_KILL_S > 10;
    // the scan command is the one SRC_SCAN_USB names for provenance, without the cable flag
    assert text_find(src_command(SRC_SCAN_USB), "--scan-usb", 0) != TEXT_NONE;
    assert text_find(src_command(SRC_LS_TTY), "ls /dev/cu.usbserial-", 0) == 0;
}

test flash_runs_as_an_sram_load_without_its_line_feed_and_only_when_confirmed {
    const scan : string = "000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const zynq : string = "index 0:\n\tidcode 0x4ba00477\nindex 1:\n\tidcode 0x3727093\n";
    const z : u64 = card_state(CARD_ZYNQ, scan, zynq, true, "");
    const want : string = "openFPGALoader -c digilent --busdev-num 0:2 /tmp/a.bit";
    assert host_flash_len(CARD_ZYNQ, z, 2, "/tmp/a.bit", true) == (want.len as u32);
    assert host_flash_len(CARD_ZYNQ, z, 2, "/tmp/a.bit", false) == 0;
    assert host_flash_len(CARD_ZYNQ, z, 2, "/tmp/a.bit; id", true) == 0;
    assert host_flash_len(CARD_ZYNQ, z, 2, "/tmp/a.rbf", true) == 0;
    var k : u32 = 0;
    while (k < (want.len as u32)) { assert host_flash_char(CARD_ZYNQ, 2, "/tmp/a.bit", k) == (want[k] as u32); k = k + 1; }
    // -f (write to flash memory) is never part of it
    assert text_find(want, " -f ", 0) == TEXT_NONE;
    // a chain that did not answer cannot be flashed
    const e : u64 = card_state(CARD_ZYNQ, scan, "Jtag frequency\n", true, "");
    assert host_flash_len(CARD_ZYNQ, e, 2, "/tmp/a.bit", true) == 0;
}

test the_uart_view_takes_a_serial_node_of_the_card_and_nothing_else {
    const scan : string = "000 002 0x0403:0x6010 FTDI2232 Digilent 210203859289 y\n";
    const ls : string = "/dev/cu.usbserial-130\n/dev/cu.usbserial-2102038592890\n/dev/cu.usbserial-2102038592891\n";
    const z : u64 = card_state(CARD_ZYNQ, scan, "", false, ls);
    assert port_at(ls, CARD_ZYNQ, 0) == 22;
    assert port_len(ls, 22) == 31;
    assert port_len(ls, NOT_FOUND) == 0;
    assert uart_view_allowed(CARD_ZYNQ, z, "/dev/cu.usbserial-2102038592890");
    assert uart_view_allowed(CARD_ZYNQ, z, "/dev/cu.usbserial-2102038592890; rm x") == false;
    assert uart_view_allowed(CARD_ZYNQ, z, "/etc/passwd") == false;
    assert uart_view_allowed(CARD_ZYNQ, 0, "/dev/cu.usbserial-2102038592890") == false;
    assert text_find(UV_B, "115200", 0) != TEXT_NONE;
    assert text_find(UART_BAUD_TEXT, "115200", 0) != TEXT_NONE;
    assert text_find(UV_C, "kill $p", 0) != TEXT_NONE;
}

test the_live_idcode_is_read_per_tap_and_a_missing_tap_is_not_measured {
