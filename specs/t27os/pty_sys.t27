// SPDX-License-Identifier: Apache-2.0
// T27 OS pty_sys: the libSystem calls the PTY server and its client make, as t27b @extern imports
// (gHashTag/t27#8946). One home for them, so the server and the client share a declaration instead of each
// keeping a copy. Nothing here decides anything; every decision is a fn in pty_proto, session_store,
// pane_state or pty_server, tested there.
//
// Calling rules these signatures follow (arm64 Darwin): a str or slice argument is its bytes' address, an
// aggregate array is its own address, a scalar goes by value, an `int` result is read as i32 and an
// ssize_t result as i64. Variadic C calls (open with O_CREAT, fcntl, ioctl) are not imported: their
// variadic arguments travel on the stack, which an @extern call does not fill (t27#10902). creat(2) makes
// the files, poll(2) replaces O_NONBLOCK, and a size change calls __ioctl, the fixed-argument syscall stub
// libsystem_kernel exports and the variadic ioctl() wraps: (int fd, unsigned long req, void *arg).
//
// Refs gHashTag/t27#10782.
module T27osPtySys;

pub fn sys_write(fd: i32, b: []const u8, n: u64) -> i64 { return @extern("write"); }
pub fn sys_read(fd: i32, b: []u8, n: u64) -> i64 { return @extern("read"); }
pub fn sys_close(fd: i32) -> i32 { return @extern("close"); }
pub fn sys_open_ro(path: []const u8, flags: i32) -> i32 { return @extern("open"); }
pub fn sys_creat(path: []const u8, mode: u32) -> i32 { return @extern("creat"); }
pub fn sys_rename(from: []const u8, to: []const u8) -> i32 { return @extern("rename"); }
pub fn sys_unlink(path: []const u8) -> i32 { return @extern("unlink"); }
pub fn sys_mkdir(path: []const u8, mode: u32) -> i32 { return @extern("mkdir"); }
pub fn sys_chdir(path: []const u8) -> i32 { return @extern("chdir"); }
pub fn sys_getenv(name: []const u8) -> u64 { return @extern("getenv"); }

pub fn sys_getpid() -> i32 { return @extern("getpid"); }
pub fn sys_setenv(name: []const u8, val: []const u8, overwrite: i32) -> i32 { return @extern("setenv"); }
pub fn sys_strlen(p: u64) -> u64 { return @extern("strlen"); }
/// memmove with a raw source address: copy n bytes from memory at `src` into dst.
pub fn sys_peek(dst: []u8, src: u64, n: u64) -> u64 { return @extern("memmove"); }
/// memmove with n = 0 hands back dst's address, which is how a byte buffer becomes an argv entry.
pub fn sys_addr(dst: []u8, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }
pub fn sys_socket(domain: i32, kind: i32, proto: i32) -> i32 { return @extern("socket"); }
pub fn sys_bind(fd: i32, addr: []const u8, len: u32) -> i32 { return @extern("bind"); }
pub fn sys_connect(fd: i32, addr: []const u8, len: u32) -> i32 { return @extern("connect"); }
pub fn sys_listen(fd: i32, backlog: i32) -> i32 { return @extern("listen"); }
pub fn sys_accept(fd: i32, addr: u64, len: u64) -> i32 { return @extern("accept"); }
pub fn sys_poll(fds: []u8, n: u64, ms: i32) -> i32 { return @extern("poll"); }
pub fn sys_forkpty(master: [2]u32, name: u64, term: u64, ws: []const u8) -> i32 { return @extern("forkpty"); }
pub fn sys_execv(path: []const u8, argv: [4]u64) -> i32 { return @extern("execv"); }
pub fn sys_exit(code: i32) -> void { @extern("_exit"); }
pub fn sys_waitpid(pid: i32, status: [2]u32, opts: i32) -> i32 { return @extern("waitpid"); }
pub fn sys_kill(pid: i32, sig: i32) -> i32 { return @extern("kill"); }
/// ioctl(fd, TIOCSWINSZ, &winsize) without the variadic wrapper; ws is the 8-byte struct winsize.
pub fn sys_set_winsize(fd: i32, req: u64, ws: []const u8) -> i32 { return @extern("__ioctl"); }
pub fn sys_signal(sig: i32, handler: u64) -> u64 { return @extern("signal"); }
pub fn sys_gettimeofday(tv: []u8, tz: u64) -> i32 { return @extern("gettimeofday"); }
pub fn sys_random(b: []u8, n: u64) -> void { @extern("arc4random_buf"); }
/// The address of the `environ` variable (a char***): read twice to walk the process environment.
pub fn sys_environ() -> u64 { return @extern("_NSGetEnviron"); }
pub fn sys_unsetenv(name: []const u8) -> i32 { return @extern("unsetenv"); }
/// posix_spawn(&pid, path, file_actions, attr, argv, envp): starts a program without waiting for it. pid is the
/// 4-byte result (pid[0]); argv holds up to 7 words and a 0; file_actions, attr and envp are 0 for none.
pub fn sys_spawn(pid: [2]u32, path: []const u8, fa: u64, attr: u64, argv: [8]u64, envp: u64) -> i32 { return @extern("posix_spawn"); }
pub fn sys_exe_path(b: []u8, size: [2]u32) -> i32 { return @extern("_NSGetExecutablePath"); }

test the_imports_are_declared {
    var b : [4]u8 = undefined;
    b[0] = 1;
    assert b[0] == 1;
}

// --------------------------------------------------- file comparison driver
// Chunked byte comparison of two files on disk for the staged-candidate
// identity check (dev_swap.t27 holds the verdict model; the IO lives here
// beside the externs). Sequential windows need no offset primitive. Short
// reads are partial windows, never silently equal; one side reaching EOF
// while the other still returns bytes is a length verdict; open or read
// errors are CMP_IO.


/// Create a file with bytes (test helper). The slice ABI passes (ptr, len)
/// to creat, which reads len as mode - the created file may have garbage
/// permissions. For production use a host-diff shim is needed.
pub fn file_put(path : []const u8, bytes : []const u8) -> i32 {
    const fd : i32 = sys_open_ro(path, 65);
    if (fd < 0) { return fd; }
    _ = sys_write(fd, bytes, @as(u64, @intCast(bytes.len)));
    _ = sys_close(fd);
    return 0;
}

pub const CMP_OK : u8 = 0;
pub const CMP_DIFF : u8 = 1;
pub const CMP_LENGTH : u8 = 2;
pub const CMP_IO : u8 = 3;

fn _c(fd : i32) -> void { _ = sys_close(fd); }

/// Compare two files by path in windows of buf_a.len bytes.
pub fn file_cmp(fa : []const u8, fb : []const u8, buf_a : []u8, buf_b : []u8) -> u8 {
    const fa_fd : i32 = sys_open_ro(fa, 0);
    if (fa_fd < 0) { _c(fa_fd); return CMP_IO; }
    const fb_fd : i32 = sys_open_ro(fb, 0);
    if (fb_fd < 0) { _c(fa_fd); return CMP_IO; }
    var verdict : u8 = CMP_OK;
    while (true) {
        const na : i64 = sys_read(fa_fd, buf_a, @as(u64, @intCast(buf_a.len)));
        const nb : i64 = sys_read(fb_fd, buf_b, @as(u64, @intCast(buf_b.len)));
        if (na < 0 or nb < 0) { verdict = CMP_IO; break; }
        if (na == 0 and nb == 0) { break; }
        const common : i64 = if (na < nb) { na } else { nb };
        var i : i64 = 0;
        var hit : bool = false;
        while (i < common) {
            if (buf_a[@as(usize, @intCast(i))] != buf_b[@as(usize, @intCast(i))]) { verdict = CMP_DIFF; hit = true; break; }
            i += 1;
        }
        if (hit) { break; }
        if (na != nb) { verdict = CMP_LENGTH; break; }
        if (na == 0) { break; }
    }
    _c(fa_fd);
    _c(fb_fd);
    return verdict;
}

/// KNOWN BROKEN, kept as a recorded ABI finding: the slice ABI passes
/// (ptr, len) where C open reads (path, flags), and creat(path, mode) reads
/// (path, mode-as-len) - created files ended up mode ---x------ (no read, no
/// write), so a spec cannot create its own fixtures. Test fixtures are made by
/// the harness (bash) instead; creation from a spec needs a host-diff shim
/// that decouples the mode argument from the slice length.
pub fn sys_create_file(path : []const u8) -> i32 { return @extern("creat"); }

test file_cmp_identical_files_ok {
    const fa : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/a1.bin";
    const fb : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/a2.bin";
    _ = file_put(fa, "same-bytes");
    _ = file_put(fb, "same-bytes");
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp(fa, fb, ba[0..64], bb[0..64]) == CMP_OK);
}

test file_cmp_first_byte_diff {
    const fa : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/b1.bin";
    const fb : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/b2.bin";
    _ = file_put(fa, "AAA-tail");
    _ = file_put(fb, "BAA-tail");
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp(fa, fb, ba[0..64], bb[0..64]) == CMP_DIFF);
}

test file_cmp_last_byte_diff {
    const fa : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/c1.bin";
    const fb : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/c2.bin";
    _ = file_put(fa, "tail-AAZ");
    _ = file_put(fb, "tail-AAY");
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp(fa, fb, ba[0..64], bb[0..64]) == CMP_DIFF);
}

test file_cmp_length_mismatch {
    const fa : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/d1.bin";
    const fb : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/d2.bin";
    _ = file_put(fa, "12345678");
    _ = file_put(fb, "1234567");
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp(fa, fb, ba[0..64], bb[0..64]) == CMP_LENGTH);
}

test file_cmp_missing_file_is_io {
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp("/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/absent-a.bin", "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/absent-b.bin", ba[0..64], bb[0..64]) == CMP_IO);
}

test file_cmp_empty_files_ok {
    const fa : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/e1.bin";
    const fb : str = "/Users/playra/t27/.claude/worktrees/lane-research-graph-heat-bench-13045/target/t27os/test-files/e2.bin";
    _ = file_put(fa, "");
    _ = file_put(fb, "");
    var ba : [64]u8 = undefined;
    var bb : [64]u8 = undefined;
    assert(file_cmp(fa, fb, ba[0..64], bb[0..64]) == CMP_OK);
}

/// Create (truncate) a file. The slice ABI passes (ptr, len); creat reads the
/// second argument as the permission mode, so the len lands as mode - harmless
/// for a test-only creation (created files live in the build-output test area).
