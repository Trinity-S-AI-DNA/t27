// SPDX-License-Identifier: Apache-2.0
// T27 OS pty_sys: the libSystem calls the PTY server and its client make, as t27b @extern imports
// (gHashTag/t27#8946). One home for them, so the server and the client share a declaration instead of each
// keeping a copy. Nothing here decides anything; every decision is a fn in pty_proto, session_store,
// pane_state or pty_server, tested there.
//
// Calling rules these signatures follow (arm64 Darwin): a str or slice argument is its bytes' address, an
// aggregate array is its own address, a scalar goes by value, an `int` result is read as i32 and an
// ssize_t result as i64. Variadic C calls (open with O_CREAT, fcntl, ioctl) are not imported: their
// variadic arguments travel on the stack, which an @extern call does not fill (t27#10902). creat(2) makes
// the files, poll(2) replaces O_NONBLOCK, and a size change calls __ioctl, the fixed-argument syscall stub
// libsystem_kernel exports and the variadic ioctl() wraps: (int fd, unsigned long req, void *arg).
//
// Refs gHashTag/t27#10782.
module T27osPtySys;

pub fn sys_write(fd: i32, b: []const u8, n: u64) -> i64 { return @extern("write"); }
pub fn sys_read(fd: i32, b: []u8, n: u64) -> i64 { return @extern("read"); }
pub fn sys_close(fd: i32) -> i32 { return @extern("close"); }
pub fn sys_open_ro(path: []const u8, flags: i32) -> i32 { return @extern("open"); }
pub fn sys_creat(path: []const u8, mode: u32) -> i32 { return @extern("creat"); }
pub fn sys_rename(from: []const u8, to: []const u8) -> i32 { return @extern("rename"); }
pub fn sys_unlink(path: []const u8) -> i32 { return @extern("unlink"); }
pub fn sys_mkdir(path: []const u8, mode: u32) -> i32 { return @extern("mkdir"); }
pub fn sys_chdir(path: []const u8) -> i32 { return @extern("chdir"); }
pub fn sys_getenv(name: []const u8) -> u64 { return @extern("getenv"); }
pub fn sys_setenv(name: []const u8, val: []const u8, overwrite: i32) -> i32 { return @extern("setenv"); }
pub fn sys_strlen(p: u64) -> u64 { return @extern("strlen"); }
/// memmove with a raw source address: copy n bytes from memory at `src` into dst.
pub fn sys_peek(dst: []u8, src: u64, n: u64) -> u64 { return @extern("memmove"); }
/// memmove with n = 0 hands back dst's address, which is how a byte buffer becomes an argv entry.
pub fn sys_addr(dst: []u8, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }
pub fn sys_socket(domain: i32, kind: i32, proto: i32) -> i32 { return @extern("socket"); }
pub fn sys_bind(fd: i32, addr: []const u8, len: u32) -> i32 { return @extern("bind"); }
pub fn sys_connect(fd: i32, addr: []const u8, len: u32) -> i32 { return @extern("connect"); }
pub fn sys_listen(fd: i32, backlog: i32) -> i32 { return @extern("listen"); }
pub fn sys_accept(fd: i32, addr: u64, len: u64) -> i32 { return @extern("accept"); }
pub fn sys_poll(fds: []u8, n: u64, ms: i32) -> i32 { return @extern("poll"); }
pub fn sys_forkpty(master: [2]u32, name: u64, term: u64, ws: []const u8) -> i32 { return @extern("forkpty"); }
pub fn sys_execv(path: []const u8, argv: [4]u64) -> i32 { return @extern("execv"); }
pub fn sys_exit(code: i32) -> void { @extern("_exit"); }
pub fn sys_waitpid(pid: i32, status: [2]u32, opts: i32) -> i32 { return @extern("waitpid"); }
pub fn sys_kill(pid: i32, sig: i32) -> i32 { return @extern("kill"); }
/// ioctl(fd, TIOCSWINSZ, &winsize) without the variadic wrapper; ws is the 8-byte struct winsize.
pub fn sys_set_winsize(fd: i32, req: u64, ws: []const u8) -> i32 { return @extern("__ioctl"); }
pub fn sys_signal(sig: i32, handler: u64) -> u64 { return @extern("signal"); }
pub fn sys_gettimeofday(tv: []u8, tz: u64) -> i32 { return @extern("gettimeofday"); }
pub fn sys_random(b: []u8, n: u64) -> void { @extern("arc4random_buf"); }
pub fn sys_exe_path(b: []u8, size: [2]u32) -> i32 { return @extern("_NSGetExecutablePath"); }

test the_imports_are_declared {
    var b : [4]u8 = undefined;
    b[0] = 1;
    assert b[0] == 1;
}
