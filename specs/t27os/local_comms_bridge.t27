}
fn sc_file_sync(fd:i32)->i32 {
    return @extern("fsync");
}
fn sc_save(b:[]u8)->bool {
    const n:usize=cf_encode(b[SC_LOG..SC_LOG_END],b[SC_FILE..SC_FILE_END]);
    if(n==0) {
        return false;
    }
    const data:u64=sc_data(0,b[SC_FILE..SC_FILE+n],n);
    const ok:bool=sc_m2(data,sc_sel("writeToFile:atomically:"),get_u64(b,SC_PATH),1)!=0;
    cf_release(data);
    if(!ok) {
        return false;
    }
    const path:u64=sc_m0(get_u64(b,SC_PATH),sc_sel("UTF8String"));
    if(sc_file_chmod(path,384)!=0) {
        return false;
    }
    const fd:i32=sc_file_open(path,0,0);
    if(fd<0) {
        return false;
    }
    const durable:bool=sc_file_sync(fd)==0;
    sc_socket_close(fd);
    return durable;
}
/// port is chat; audio is port+10. home_path is an app-owned chat file, never a private-key file.
pub fn sc_open(port:u64,ephemeral:bool,home_path:u64)->u64 {
    return sc_open_report(port,ephemeral,home_path,0);
}
fn sc_error_pointer()->u64 {
    return @extern("__error");
}
fn sc_error_copy(out:[1]i32,p:u64,n:u64)->u64 {
    return @extern("memmove");
}
fn sc_errno()->i64 {
    var value:[1]i32=undefined;
    sc_error_copy(value,sc_error_pointer(),4);
    return @as(i64,value[0]);
}
pub fn sc_open_report(port:u64,ephemeral:bool,home_path:u64,diagnostic:u64)->u64 {
    if(port==0 or port>65525 or home_path==0) {
        return 0;
    }
    const p:u64=sc_malloc(SC_BYTES);
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    ck_wipe(v.bytes);
    var priv:[97]u8=undefined;
    var pubk:[65]u8=undefined;
    var fp:[10]u8=undefined;
    const identity:u32=li_identity_report(priv[0..97],pubk[0..65],ephemeral,diagnostic);
    li_note(diagnostic,"identityStorage",@as(i64,identity));
    if(identity==0 or !ih_fingerprint(pubk[0..65],fp[0..10])) {
        ck_wipe(priv[0..97]);
        sc_free(p);
        return 0;
    }
    const chat:bool=cs_open(v.bytes[0..CS_LEN],fp[0..10],0,port,CS_TEXT_PAIR);
    const chat_errno:i64=if(chat) 0 else sc_errno();
    const audio:bool=cs_open(v.bytes[CS_LEN..2*CS_LEN],fp[0..10],0,port+10,CS_AUDIO_DEV);
    const audio_errno:i64=if(audio) 0 else sc_errno();
    li_note(diagnostic,"chatSocketOpened",if(chat) 1 else 0);
    li_note(diagnostic,"chatSocketErrno",chat_errno);
    li_note(diagnostic,"audioSocketOpened",if(audio) 1 else 0);
    li_note(diagnostic,"audioSocketErrno",audio_errno);
    if(!chat or !audio) {
        ck_wipe(priv[0..97]);
        if(chat) {
            sc_video_stop(p);
            cs_close(v.bytes[0..CS_LEN]);
        }
        if(audio) {
            cs_close(v.bytes[CS_LEN..2*CS_LEN]);
        }
        sc_free(p);
        return 0;
    }
    cs_set(v.bytes[0..CS_LEN],CS_K_SILENT_MS,60000);
    cs_local_deny_all(v.bytes[0..CS_LEN]);
    cs_local_deny_all(v.bytes[CS_LEN..2*CS_LEN]);
    const own:bool=cs_identity(v.bytes[0..CS_LEN],pubk[0..65],priv[0..97]) and cs_identity(v.bytes[CS_LEN..2*CS_LEN],pubk[0..65],priv[0..97]);
    ck_wipe(priv[0..97]);
    li_note(diagnostic,"identityAccepted",if(own) 1 else 0);
    if(!own) {
        sc_video_stop(p);
        cs_close(v.bytes[0..CS_LEN]);
        cs_close(v.bytes[CS_LEN..2*CS_LEN]);
        sc_free(p);
        return 0;
    }
    var i:usize=0;
    while(i<65) {
        v.bytes[SC_PUBLIC+i]=pubk[i];
        i=i+1;
    }
    while(i<75) {
        v.bytes[SC_PUBLIC+i]=fp[i-65];
        i=i+1;
    }
    put_u64(v.bytes,SC_HOME,sc_m0(home_path,sc_sel("retain")));
    sc_m4(sc_m0(sc_cls("NSFileManager"),sc_sel("defaultManager")),sc_sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"),home_path,1,0,0);
    put_u64(v.bytes,SC_ID_STORAGE,identity);
    return p;
}
/// Public card is never placed in diagnostic reports. Normal UI explicitly pastes it.
pub fn sc_card(p:u64)->u64 {
    if(p==0) {
        return sc_cf("");
    }
    const v:SCView=sc_view(p);
    var card:[136]u8=undefined;
    const prefix:[]const u8="t27p1:";
    const hex:[]const u8="0123456789abcdef";
    var i:usize=0;
    while(i<6) {
        card[i]=prefix[i];
        i=i+1;
    }
    i=0;
    while(i<65) {
        card[6+i*2]=hex[v.bytes[SC_PUBLIC+i]/16];
        card[7+i*2]=hex[v.bytes[SC_PUBLIC+i]%16];
        i=i+1;
    }
    return sc_cf(card[0..136]);
}
fn sc_nibble(c:u8)->u32 {
    if(c>=48 and c<=57) {
        return c-48;
    }
    if(c>=97 and c<=102) {
        return c-87;
    }
    return 255;
}
pub fn sc_pair(p:u64,card:u64,ip:u64,port:u64)->bool {
    if(p==0 or port==0 or port>65525 or ip==0 or ip>=3758096384) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(cs_state(v.bytes[0..CS_LEN])!=0 or cs_state(v.bytes[CS_LEN..2*CS_LEN])!=0) {
        return false;
    }
    var raw:[160]u8=undefined;
    const n:usize=sc_bytes(card,raw[0..160]);
    if(n!=136) {
        return false;
    }
    const prefix:[]const u8="t27p1:";
    var i:usize=0;
    while(i<6) {
        if(raw[i]!=prefix[i]) {
            return false;
        }
        i=i+1;
    }
    var pubk:[65]u8=undefined;
    i=0;
    while(i<65) {
        const a:u32=sc_nibble(raw[6+i*2]);
        const b:u32=sc_nibble(raw[7+i*2]);
        if(a>15 or b>15) {
            return false;
        }
        pubk[i]=@as(u8,@intCast(a*16+b));
        i=i+1;
    }
    var fp:[10]u8=undefined;
    if(!ih_fingerprint(pubk[0..65],fp[0..10])) {
        return false;
    }
    if(!cs_pair_card(v.bytes[0..CS_LEN],pubk[0..65]) or !cs_pair_card(v.bytes[CS_LEN..2*CS_LEN],pubk[0..65])) {
        return false;
    }
    if(!cs_pair_endpoint(v.bytes[0..CS_LEN],ip,port) or !cs_pair_endpoint(v.bytes[CS_LEN..2*CS_LEN],ip,port+10)) {
        return false;
    }
    i=0;
    while(i<10) {
        v.bytes[SC_PEER_FP+i]=fp[i];
        i=i+1;
    }
    put_u64(v.bytes,SC_PEER_IP,ip);
    put_u64(v.bytes,SC_PEER_PORT,port);
    var name:[24]u8=undefined;
    cf_name(fp[0..10],name[0..24]);
    const old_path:u64=get_u64(v.bytes,SC_PATH);
    if(old_path!=0) {
        cf_release(old_path);
    }
    put_u64(v.bytes,SC_PATH,sc_m0(sc_m1(get_u64(v.bytes,SC_HOME),sc_sel("stringByAppendingPathComponent:"),sc_cf(name[0..24])),sc_sel("retain")));
    cl_init(v.bytes[SC_LOG..SC_LOG_END],fp[0..10],32);
    chm_init(v.bytes[SC_DRIVER..SC_DRIVER_END],fp[0..10],ip,port);
    put_u64(v.bytes,SC_PAIRED,0);
    put_u64(v.bytes,SC_HISTORY_ERROR,0);
    const data:u64=sc_m1(sc_cls("NSData"),sc_sel("dataWithContentsOfFile:"),get_u64(v.bytes,SC_PATH));
    const size:u64=sc_m0(data,sc_sel("length"));
    if(size>0 and size<67000) {
        sc_copy(v.bytes[SC_FILE..SC_FILE_END],sc_m0(data,sc_sel("bytes")),size);
        if(cf_decode(v.bytes[SC_FILE..SC_FILE+@as(usize,@intCast(size))],v.bytes[SC_LOG..SC_LOG_END])!=0) {
            put_u64(v.bytes,SC_HISTORY_ERROR,2);
            return false;
        }
    }
    if((size==0 or size>=67000) and sc_m1(sc_m0(sc_cls("NSFileManager"),sc_sel("defaultManager")),sc_sel("fileExistsAtPath:"),get_u64(v.bytes,SC_PATH))!=0) {
        put_u64(v.bytes,SC_HISTORY_ERROR,2);
        return false;
    }
    put_u64(v.bytes,SC_PAIRED,1);
    return true;
}
pub fn sc_connect(p:u64,audio:bool)->bool {
    if(p==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(get_u64(v.bytes,SC_PAIRED)!=1) {
        return false;
    }
    const at:usize=if(audio) CS_LEN else 0;
    return cs_call(v.bytes[at..at+CS_LEN],get_u64(v.bytes,SC_PEER_IP),get_u64(v.bytes,SC_PEER_PORT)+(if(audio) @as(u64,10) else @as(u64,0)),v.bytes[SC_PEER_FP..SC_PEER_FP_END]);
}
pub fn sc_action(p:u64,audio:bool,action:u32)->bool {
    if(p==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    const at:usize=if(audio) CS_LEN else 0;
    const s:[]u8=v.bytes[at..at+CS_LEN];
    if(action==1) {
        return cs_answer(s);
    }
    if(action==2) {
        return cs_decline(s);
    }
    if(action==3) {
        return cs_confirm(s,true);
    }
    if(action==4) {
        return cs_confirm(s,false);
    }
    if(action==5) {
        return cs_hangup(s);
    }
    if(action==6) {
        cs_mute(s,true);
        return true;
    }
    if(action==7) {
        cs_mute(s,false);
        return true;
    }
    if(action==8) {
        return cs_dismiss(s);
    }
    return false;
}
pub fn sc_tick(p:u64)->void {
    if(p==0) {
        return;
    }
    const v:SCView=sc_view(p);
    sc_qa_pump(p,v.bytes);
    if(get_u64(v.bytes,SC_PAIRED)!=1) {
        return;
    }
    const previous:u32=cs_state(v.bytes[0..CS_LEN]);
    if(previous!=4) {
        cs_poll(v.bytes[0..CS_LEN]);
    }
    sc_camera_tick(p);
    cs_poll(v.bytes[CS_LEN..2*CS_LEN]);
    if(previous!=4 and cs_state(v.bytes[0..CS_LEN])==4) {
        put_u64(v.bytes,SC_DRIVER_LAST,sc_now());
        cl_session_start(v.bytes[SC_LOG..SC_LOG_END]);
    }
    if(cs_state(v.bytes[0..CS_LEN])==4) {
        const e:u32=chm_tick(v.bytes[SC_DRIVER..SC_DRIVER_END],v.bytes[0..CS_LEN],v.bytes[SC_LOG..SC_LOG_END],v.bytes[SC_ASM..SC_ASM_END],v.bytes[SC_FRIENDS..SC_FRIENDS_END],v.bytes[SC_OWN_FP..SC_OWN_FP_END],sc_now());
        if(e!=0) {
            chm_saved(v.bytes[SC_DRIVER..SC_DRIVER_END],v.bytes[0..CS_LEN],sc_save(v.bytes));
        }
        if(get_u64(v.bytes,SC_VISIBLE)==1) {
            sc_read_commit(v.bytes);
        }
    }
}
pub fn sc_send(p:u64,text:u64)->u32 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    if(cs_state(v.bytes[0..CS_LEN])!=4) {
        return 0;
    }
    var raw:[2001]u8=undefined;
    const n:usize=sc_bytes(text,raw[0..2001]);
    if(n==0) {
        return 0;
    }
    sc_memcpy(v.bytes[SC_SNAPSHOT..SC_SNAPSHOT_END],v.bytes[SC_LOG..SC_LOG_END],SC_LOG_BYTES);
    const m:u32=chm_send(v.bytes[SC_DRIVER..SC_DRIVER_END],v.bytes[SC_LOG..SC_LOG_END],raw[0..n],sc_now());
    if(m!=0 and !sc_save(v.bytes)) {
        put_u64(v.bytes,SC_HISTORY_ERROR,3);
        sc_memcpy(v.bytes[SC_LOG..SC_LOG_END],v.bytes[SC_SNAPSHOT..SC_SNAPSHOT_END],SC_LOG_BYTES);
        return 0;
    }
    return m;
}
pub fn sc_state(p:u64,audio:bool)->u32 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    const at:usize=if(audio) CS_LEN else 0;
    return cs_state(v.bytes[at..at+CS_LEN]);
}
pub fn sc_code(p:u64,audio:bool)->u64 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    const at:usize=if(audio) CS_LEN else 0;
    if(cs_id_state(v.bytes[at..at+CS_LEN])!=CS_ID_VERIFIED) {
        return 0;
    }
    var code:[6]u8=undefined;
    if(!cs_code(v.bytes[at..at+CS_LEN],code[0..6])) {
        return 0;
    }
    var n:u64=1;
    var i:usize=0;
    while(i<6) {
        n=n*256+code[i];
        i=i+1;
    }
    return n;
}
pub fn sc_transcript(p:u64)->u64 {
    if(p==0) {
        return sc_cf("");
    }
    const v:SCView=sc_view(p);
    const text:u64=sc_auto(sc_m0(sc_cls("NSMutableString"),sc_sel("new")));
    const log:[]u8=v.bytes[SC_LOG..SC_LOG_END];
    var i:usize=0;
    while(i<cl_count(log)) {
        const direction:[]const u8=if(cl_dir(log,i)==1) "You: " else "Friend: ";
        sc_m1(text,sc_sel("appendString:"),sc_cf(direction));
        sc_m1(text,sc_sel("appendString:"),sc_cf(cl_text(log,i)));
        const status:u32=cl_state(log,i);
        const label:[]const u8=if(status==4) " [READ]\n" else if(status==3) " [DELIVERED]\n" else if(status==5) " [FAILED]\n" else " [PENDING]\n";
        sc_m1(text,sc_sel("appendString:"),sc_cf(label));
        i=i+1;
    }
    return text;
}
pub fn sc_stat(p:u64,audio:bool,k:u32)->u64 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    const at:usize=if(audio) CS_LEN else 0;
    if(k==135) {
        return if(cs_audio_capture_running(v.bytes[at..at+CS_LEN])) 1 else 0;
    }
    if(k==136) {
        return if(cs_audio_listening(v.bytes[at..at+CS_LEN])) 1 else 0;
    }
    if(k==134) {
        return cs_send_errno(v.bytes[at..at+CS_LEN]);
    }
    if(k==130) {
        return get_u64(v.bytes,SC_CAMERA_STATE);
    }
    if(k==131) {
        return get_u64(v.bytes,SC_VIDEO_SOURCE);
    }
    if(k==132) {
        return get_u64(v.bytes,SC_MEDIA_MODE);
    }
    if(k==133) {
        return cs_reason(v.bytes[CS_LEN..2*CS_LEN]);
    }
    if(k<100 or k>=1000) {
        return cs_stat(v.bytes[at..at+CS_LEN],k);
    }
    if(k>=200 and k<240) {
        return chm_stat(v.bytes[SC_DRIVER..SC_DRIVER_END],k-200);
    }
    if(k==100) {
        return get_u64(v.bytes,SC_ID_STORAGE);
    }
    if(k==101) {
        return cl_count(v.bytes[SC_LOG..SC_LOG_END]);
    }
    if(k==114) {
        return get_u64(v.bytes,SC_HISTORY_ERROR);
    }
    if(k==113) {
        return cs_relay_ready(v.bytes[at..at+CS_LEN]);
    }
    if(k==120) {
        return get_u64(v.bytes,SC_CARD_PEER);
    }
    if(k==121) {
        return get_u64(v.bytes,SC_CARD_SENT);
    }
    if(k>=110 and k<=112) {
        return cs_pair_net(v.bytes[at..at+CS_LEN],k-110);
    }
    return 0;
}
pub fn sc_close(p:u64)->void {
    if(p==0) {
        return;
    }
    const v:SCView=sc_view(p);
    sc_video_stop(p);
    cs_close(v.bytes[0..CS_LEN]);
    cs_close(v.bytes[CS_LEN..2*CS_LEN]);
    const qfd:u64=get_u64(v.bytes,SC_CARD_FD);
    if(qfd!=0) {
        sc_socket_close(@as(i32,@intCast(qfd-1)));
    }
    const path:u64=get_u64(v.bytes,SC_PATH);
    if(path!=0) {
        cf_release(path);
    }
    cf_release(get_u64(v.bytes,SC_HOME));
    ck_wipe(v.bytes);
    sc_free(p);
}
test null_context_never_sends_or_opens_a_device {
    assert sc_state(0,false)==0 and sc_code(0,true)==0;
    assert !sc_connect(0,false);
    assert sc_send(0,0)==0;
}
/// Called by the actual foreground conversation view, not by the transport timer.
pub fn sc_visible(p:u64,visible:bool)->void {
    if(p==0) {
        return;
    }
    const v:SCView=sc_view(p);
    put_u64(v.bytes,SC_VISIBLE,if(visible) 1 else 0);
}
fn sc_read_commit(b:[]u8)->void {
    sc_memcpy(b[SC_SNAPSHOT..SC_SNAPSHOT_END],b[SC_LOG..SC_LOG_END],SC_LOG_BYTES);
    sc_memcpy(b[SC_DRIVER_SNAPSHOT..SC_DRIVER_SNAPSHOT_END],b[SC_DRIVER..SC_DRIVER_END],384);
    if(chm_open(b[SC_DRIVER..SC_DRIVER_END],b[SC_LOG..SC_LOG_END])) {
        if(sc_save(b)) {
            chm_saved(b[SC_DRIVER..SC_DRIVER_END],b[0..CS_LEN],true);
        }
        else {
            sc_memcpy(b[SC_LOG..SC_LOG_END],b[SC_SNAPSHOT..SC_SNAPSHOT_END],SC_LOG_BYTES);
            sc_memcpy(b[SC_DRIVER..SC_DRIVER_END],b[SC_DRIVER_SNAPSHOT..SC_DRIVER_SNAPSHOT_END],384);
        }
    }
}
// Explicit QA-only public-card handoff. Bound to two nominated loopback UDP endpoints;
// no clipboard, plist, file or report ever contains this public key. No private material sent.
fn sc_socket(a:i32,b:i32,c:i32)->i32 {
    return @extern("socket");
}
fn sc_bind(fd:i32,sa:[]const u8,n:u32)->i32 {
    return @extern("bind");
}
fn sc_fcntl(fd:i32,op:i32,v:u64)->i32 {
    return @extern("__fcntl");
}
fn sc_socket_close(fd:i32)->i32 {
    return @extern("close");
}
fn sc_sendto(fd:i32,b:[]const u8,n:u64,f:i32,sa:[]const u8,sn:u32)->i64 {
    return @extern("sendto");
}
fn sc_recvfrom(fd:i32,b:[]u8,n:u64,f:i32,sa:[]u8,sn:[]u32)->i64 {
    return @extern("recvfrom");
}
fn sc_sockaddr(port:u64,out:[]u8)->void {
    var i:usize=0;
    while(i<16) {
        out[i]=0;
        i=i+1;
    }
    out[0]=16;
    out[1]=2;
    out[2]=@as(u8,@intCast(port/256));
    out[3]=@as(u8,@intCast(port%256));
    out[4]=127;
    out[7]=1;
}
pub fn sc_qa_exchange(p:u64,own_port:u64,peer_port:u64)->bool {
    if(p==0 or own_port<50000 or own_port>50100 or peer_port<50000 or peer_port>50100 or own_port==peer_port) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(get_u64(v.bytes,SC_CARD_FD)!=0) {
        return true;
    }
    const fd:i32=sc_socket(2,2,0);
    if(fd<0) {
        return false;
    }
    var sa:[16]u8=undefined;
    sc_sockaddr(own_port,sa[0..16]);
    if(sc_bind(fd,sa[0..16],16)!=0) {
        sc_socket_close(fd);
        return false;
    }
    sc_fcntl(fd,4,4);
    put_u64(v.bytes,SC_CARD_FD,@as(u64,@intCast(fd))+1);
    put_u64(v.bytes,SC_CARD_PEER,peer_port);
    put_u64(v.bytes,SC_CARD_TICKS,0);
    return true;
}
fn sc_qa_pump(p:u64,b:[]u8)->void {
    const stored:u64=get_u64(b,SC_CARD_FD);
    const count:u64=get_u64(b,SC_CARD_TICKS);
    if(stored==0 or count>=750) {
        return;
    }
    const fd:i32=@as(i32,@intCast(stored-1));
    var to:[16]u8=undefined;
    sc_sockaddr(get_u64(b,SC_CARD_PEER),to[0..16]);
    if(count%20==0) {
        sc_sendto(fd,b[SC_PUBLIC..SC_OWN_FP],65,0,to[0..16],16);
        put_u64(b,SC_CARD_SENT,get_u64(b,SC_CARD_SENT)+1);
    }
    var from:[16]u8=undefined;
    ck_wipe(from[0..16]);
    var len:[1]u32=undefined;
    len[0]=16;
    var public_key:[66]u8=undefined;
    const n:i64=sc_recvfrom(fd,public_key[0..66],66,0,from[0..16],len[0..1]);
    if(n==65 and get_u64(b,SC_PAIRED)==0) {
        var equal:bool=true;
        var i:usize=0;
        while(i<16) {
            if(from[i]!=to[i]) {
                equal=false;
            }
            i=i+1;
        }
        if(equal) {
            var card:[136]u8=undefined;
            const prefix:[]const u8="t27p1:";
            const hex:[]const u8="0123456789abcdef";
            i=0;
            while(i<6) {
                card[i]=prefix[i];
                i=i+1;
            }
            i=0;
            while(i<65) {
                card[6+i*2]=hex[public_key[i]/16];
                card[7+i*2]=hex[public_key[i]%16];
                i=i+1;
            }
            sc_pair(p,sc_cf(card[0..136]),2130706433,get_u64(b,SC_CARD_PEER_CHAT));
        }
    }
    put_u64(b,SC_CARD_TICKS,count+1);
}
pub fn sc_qa_target(p:u64,own_card_port:u64,peer_card_port:u64,peer_chat_port:u64)->bool {
    if(p==0 or peer_chat_port<49900 or peer_chat_port>49999) {
        return false;
    }
    const v:SCView=sc_view(p);
    put_u64(v.bytes,SC_CARD_PEER_CHAT,peer_chat_port);
    return sc_qa_exchange(p,own_card_port,peer_card_port);
}
test local_bridge_regions_do_not_overlap_and_private_identity_is_not_a_log {
    assert 2*CS_LEN<=SC_LOG and SC_LOG_END<=SC_FILE and SC_FILE_END<=SC_ASM;
    assert SC_ASM_END<=SC_DRIVER and SC_DRIVER_END<=SC_FRIENDS and SC_FRIENDS_END<=SC_SNAPSHOT;
    assert SC_SNAPSHOT_END<=SC_DRIVER_SNAPSHOT and SC_DRIVER_SNAPSHOT_END<=SC_PATH;
    assert SC_PATH+8<=SC_ID_STORAGE and SC_ID_STORAGE+8<=SC_PEER_FP;
    assert SC_PEER_FP_END<=SC_PEER_IP and SC_PEER_IP+8<=SC_PEER_PORT;
    assert SC_PEER_PORT+8<=SC_PAIRED and SC_PAIRED+8<=SC_VISIBLE;
    assert SC_VISIBLE+8<=SC_HOME and SC_HOME+8<=SC_CARD_FD;
    assert SC_CARD_FD+8<=SC_CARD_PEER and SC_CARD_PEER+8<=SC_PUBLIC;
    assert SC_PUBLIC+65==SC_OWN_FP and SC_OWN_FP_END<=SC_CARD_TICKS;
    assert SC_CARD_TICKS+8<=SC_CARD_SENT and SC_CARD_SENT+8<=SC_CARD_PEER_CHAT;
    assert SC_CARD_PEER_CHAT+8<=SC_HISTORY_ERROR and SC_HISTORY_ERROR+8<SC_BYTES;
}
/// Change only the transport endpoint after explicit user relay selection; peer card stays pinned.
pub fn sc_relay(p:u64,ip:u64,port:u64,role:u32)->bool {
    if(p==0 or ip==0 or ip>=3758096384 or port==0 or port>65525 or (role!=1 and role!=2)) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(get_u64(v.bytes,SC_PAIRED)!=1) {
        return false;
    }
    const chat:u32=cs_state(v.bytes[0..CS_LEN]);
    const audio:u32=cs_state(v.bytes[CS_LEN..2*CS_LEN]);
    if((chat>0 and chat<5) or (audio>0 and audio<5)) {
        return false;
    }
    cs_dismiss(v.bytes[0..CS_LEN]);
    cs_dismiss(v.bytes[CS_LEN..2*CS_LEN]);
    if(!cs_pair_endpoint(v.bytes[0..CS_LEN],ip,port) or !cs_pair_endpoint(v.bytes[CS_LEN..2*CS_LEN],ip,port+10)) {
        return false;
    }
    if(!cs_relay_start(v.bytes[0..CS_LEN],role) or !cs_relay_start(v.bytes[CS_LEN..2*CS_LEN],role)) {
        return false;
    }
    chm_addr(v.bytes[SC_DRIVER..SC_DRIVER_END],ip,port);
    put_u64(v.bytes,SC_PEER_IP,ip);
    put_u64(v.bytes,SC_PEER_PORT,port);
    return true;
}
/// Select a direct endpoint for the already-pasted peer card; fresh SAS is still required.
pub fn sc_direct(p:u64,ip:u64,port:u64)->bool {
    if(p==0 or ip==0 or ip>=3758096384 or port==0 or port>65525) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(get_u64(v.bytes,SC_PAIRED)!=1) {
        return false;
    }
    const chat:u32=cs_state(v.bytes[0..CS_LEN]);
    const audio:u32=cs_state(v.bytes[CS_LEN..2*CS_LEN]);
    if((chat>0 and chat<5) or (audio>0 and audio<5)) {
        return false;
    }
    cs_dismiss(v.bytes[0..CS_LEN]);
    cs_dismiss(v.bytes[CS_LEN..2*CS_LEN]);
    if(!cs_pair_endpoint(v.bytes[0..CS_LEN],ip,port) or !cs_pair_endpoint(v.bytes[CS_LEN..2*CS_LEN],ip,port+10)) {
        return false;
    }
    cs_relay_stop(v.bytes[0..CS_LEN]);
    cs_relay_stop(v.bytes[CS_LEN..2*CS_LEN]);
    chm_addr(v.bytes[SC_DRIVER..SC_DRIVER_END],ip,port);
    put_u64(v.bytes,SC_PEER_IP,ip);
    put_u64(v.bytes,SC_PEER_PORT,port);
    return true;
}
pub fn sc_media_select(p:u64,video_only:bool)->bool {
    if(p==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(!cs_media_select(v.bytes[CS_LEN..2*CS_LEN],video_only)) {
        return false;
    }
    put_u64(v.bytes,SC_MEDIA_MODE,if(video_only) 6 else 1);
    return true;
}
pub fn sc_video_start(p:u64,source:u32)->bool {
    if(p==0 or (source!=1 and source!=2)) {
        return false;
    }
    const v:SCView=sc_view(p);
    if(cs_state(v.bytes[CS_LEN..2*CS_LEN])!=4) {
        return false;
    }
    sc_video_stop(p);
    put_u64(v.bytes,SC_VIDEO_SOURCE,@as(u64,source));
    cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_VSOURCE,@as(u64,source));
    if(source==2) {
        return cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_VIDEO,1);
    }
    var camera:u64=get_u64(v.bytes,SC_CAMERA);
    if(camera==0) {
        camera=cvl_new(0);
        put_u64(v.bytes,SC_CAMERA,camera);
    }
    if(camera==0) {
        put_u64(v.bytes,SC_CAMERA_STATE,3);
        return false;
    }
    const status:u32=cvl_start(camera);
    put_u64(v.bytes,SC_CAMERA_STATE,@as(u64,status));
    return true;
}
pub fn sc_video_stop(p:u64)->void {
    if(p==0) {
        return;
    }
    const v:SCView=sc_view(p);
    const camera:u64=get_u64(v.bytes,SC_CAMERA);
    if(camera!=0) {
        cvl_stop(camera);
    }
    cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_VIDEO,0);
    put_u64(v.bytes,SC_VIDEO_SOURCE,0);
    put_u64(v.bytes,SC_CAMERA_STATE,0);
}
fn sc_camera_tick(p:u64)->void {
    const v:SCView=sc_view(p);
    const camera:u64=get_u64(v.bytes,SC_CAMERA);
    if(cs_state(v.bytes[CS_LEN..2*CS_LEN])!=4) {
        sc_video_stop(p);
        return;
    }
    if(get_u64(v.bytes,SC_VIDEO_SOURCE)!=1 or camera==0) {
        return;
    }
    const status:u32=cvl_tick(camera);
    put_u64(v.bytes,SC_CAMERA_STATE,@as(u64,status));
    if(status!=2) {
        cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_VIDEO,0);
        return;
    }
    var jpeg:[24000]u8=undefined;
    const n:usize=cvl_take(camera,jpeg[0..24000]);
    if(n>0 and cs_video_feed(v.bytes[CS_LEN..2*CS_LEN],jpeg[0..n])) {
        cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_VIDEO,1);
    }
}
pub fn sc_video_stat(p:u64,k:u32)->u64 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    return cs_vstat(v.bytes[CS_LEN..2*CS_LEN],k);
}
pub fn sc_video_data(p:u64)->u64 {
    if(p==0) {
        return 0;
    }
    const v:SCView=sc_view(p);
    const n:usize=cs_vlen(v.bytes[CS_LEN..2*CS_LEN]);
    if(n==0) {
        return 0;
    }
    return li_data(0,v.bytes[CS_LEN+CS_VLAST..CS_LEN+CS_VLAST+n],n);
}
test camera_metadata_is_disjoint_and_null_safe {
    assert SC_HISTORY_ERROR+8<=SC_CAMERA and SC_CAMERA+8<=SC_VIDEO_SOURCE;
    assert SC_VIDEO_SOURCE+8<=SC_CAMERA_STATE and SC_CAMERA_STATE+8<=SC_MEDIA_MODE and SC_MEDIA_MODE+8<SC_BYTES;
    assert !sc_video_start(0,1) and !sc_video_start(0,2) and sc_video_data(0)==0;
    assert !sc_media_select(0,true);
}
pub fn sc_audio_diagnostics(p:u64,on:bool)->bool {
    if(p==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    return cs_set(v.bytes[CS_LEN..2*CS_LEN],CS_K_AUDIO_DEBUG,if(on) 1 else 0);
}
pub fn sc_camera_authorization()->u64 {
    return cvl_auth();
}
fn sc_directory_read(out:[]u8,p:u64,n:u64)->u64 {
    return @extern("memmove");
}
fn sc_directory_write(p:u64,b:[]const u8,n:u64)->u64 {
    return @extern("memmove");
}
/// Scalar private-process ABI: only public points or DER signatures leave this adapter.
pub fn sc_directory_public(p:u64,out:u64,peer:bool)->bool {
    if(p==0 or out==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    var public_key:[65]u8=undefined;
    if(!cs_directory_public(v.bytes[0..CS_LEN],public_key[0..65],peer)) {
        return false;
    }
    sc_directory_write(out,public_key[0..65],65);
    return true;
}
pub fn sc_directory_sign(p:u64,message:u64,length:u64,out:u64,capacity:u64)->u64 {
    if(p==0 or message==0 or out==0 or length!=222 or capacity<80) {
        return 0;
    }
    const v:SCView=sc_view(p);
    var canonical:[222]u8=undefined;
    var signature:[128]u8=undefined;
    sc_directory_read(canonical[0..222],message,222);
    const n:usize=cs_directory_sign(v.bytes[0..CS_LEN],canonical[0..222],signature[0..128]);
    if(n<8 or n>80) {
        return 0;
    }
    sc_directory_write(out,signature[0..n],@as(u64,n));
    return @as(u64,n);
}
pub fn sc_listen_select(p:u64,on:bool)->bool {
    if(p==0) {
        return false;
    }
    const v:SCView=sc_view(p);
    return cs_audio_listen_select(v.bytes[CS_LEN..2*CS_LEN],on);
}
