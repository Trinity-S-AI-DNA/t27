fn sc_bytes(o:u64,out:[]u8)->usize {
    if(o==0) {
        return 0;
    }
    const n:u64=sc_m1(o,sc_sel("lengthOfBytesUsingEncoding:"),4);
    if(n==0 or n>=out.len) {
        return 0;
    }
    if(!sc_cstring(o,sc_sel("getCString:maxLength:encoding:"),out,out.len,4)) {
        return 0;
    }
    return @as(usize,@intCast(n));
}
fn sc_copy(out:[]u8,p:u64,n:u64)->u64 {
    return @extern("memmove");
}
fn sc_now()->u64 {
    return sc_clock(6)/1000000;
}
fn sc_clock(clock:u32)->u64 {
    return @extern("clock_gettime_nsec_np");
