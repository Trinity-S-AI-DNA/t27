// SPDX-License-Identifier: Apache-2.0
// specs/t27os/session_protection.t27 -- Prevent agent session from killing
// its own host/web process.
// Part of M1 (milestone #5). Closes #13632.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::session_protection;

pub struct SessionProtection { self_kill_prevented: bool };

pub fn session_protection_self_kill_prevented(p: SessionProtection) -> bool {
    return p.self_kill_prevented;
}

test "session protection self kill prevented" {
    assert(session_protection_self_kill_prevented(SessionProtection { self_kill_prevented: true }));
    assert(!session_protection_self_kill_prevented(SessionProtection { self_kill_prevented: false }));
}