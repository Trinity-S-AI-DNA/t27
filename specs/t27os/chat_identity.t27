// SPDX-License-Identifier: Apache-2.0
; specs/t27os/chat_identity.t27 -- who is speaking in the Queen's conversation: the owner (a confirmed
; GitHub account, never a guessed username) and the agent that did the work (its exact name, mark,
; task and state). Owner, 2026-11-04: the owner sees that THEY set the task, a concrete agent returned a
; result, and the Queen verified it and chose the next step.
; --
; The owner. The account is the one T27 OS itself holds, confirmed by GET /user in the sign-in
; (gh_signin.t27 / gh_signin_host.t27: login, numeric id, avatar_url -> 256 px avatar in the profile).
; A browser session and a Git CLI login are NOT this account: nothing here reads them. The token is never
; here: this module holds a numeric id, a length and a flag, and the displayed text lives in the host's
; profile buffers. oi_status answers one of three things -- connected, needs a check, not connected --
; and the avatar shows the confirmed image only when the account is connected; otherwise the initial.
; A different numeric id (a sign-out and a new account, or a renamed login) invalidates the image cache
; (oi_cache_valid) so one person's face is never shown for another account.
; --
; The agent. A signature names the harness (the program in the pane), an optional role, the task and the
; state; the model is a separate line and is never invented (an empty model reads "model: unknown").
; The Queen has the crown mark; a harness with a local, permitted asset uses it; any other harness gets a
; neutral disc with its initial and its written name -- never a borrowed logo.
; WHAT IS NOT HERE: the sign-in itself, reading the profile, decoding the avatar and drawing -- the host
; (glass_window.t27) measures and draws; the booleans here are its measurements.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27osChatIdentity;

use t27os::agents::AGENT_NAMES;
use t27os::agents::AGENT_COUNT;
use t27os::agents::AGENT_QUEEN;
use t27os::agents::AGENT_DSH;
use t27os::agents::AGENT_DSH_NAME;
use t27os::gh_signin::gsi_login_ok;
use t27os::queen_verdict::qv_label;
use t27os::session_store::csv_field;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// ---------------------------------------------------------------- the owner

pub const OI_NOT_CONNECTED : u8 = 0;
pub const OI_CONNECTED : u8 = 1;
pub const OI_NEEDS_CHECK : u8 = 2;

/// The confirmed owner account. github_user_id is the stable key (a login can be renamed); 0 = none.
/// login_len / name_len are the lengths of text the host keeps; has_avatar is true only for an image that
/// came from the confirmed account's avatar_url. last_verified_at is the host's clock at the GET /user.
pub struct OwnerIdentity {
    github_user_id: u64,
    login_len: u8,
    name_len: u8,
    has_avatar: bool,
    status: u8,
    last_verified_at: u64,
}

pub fn oi_new() -> OwnerIdentity {
    return OwnerIdentity {
        github_user_id: 0, login_len: 0, name_len: 0, has_avatar: false,
        status: OI_NOT_CONNECTED, last_verified_at: 0
    };
}

/// What GET /user answered becomes an identity. Refused (nothing connected) when the numeric id is 0 or the
/// login is not a GitHub login (gsi_login_ok): a guessed or empty username never gets an avatar.
pub fn oi_confirm(id : u64, login : []const u8, name_len : u8, avatar_ok : bool, now : u64) -> OwnerIdentity {
    if (id == 0) { return oi_new(); }
    if (gsi_login_ok(login) == false) { return oi_new(); }
    return OwnerIdentity {
        github_user_id: id, login_len: login.len as u8, name_len: name_len, has_avatar: avatar_ok,
        status: OI_CONNECTED, last_verified_at: now
    };
}

/// Sign-out, or an account that no longer answers: the identity and its image are gone.
pub fn oi_sign_out() -> OwnerIdentity {
    return oi_new();
}

/// The status from what the host sees. A token that exists but whose account was not confirmed this run
/// (or answered with a failure) is NEEDS_CHECK, not connected and not silently trusted.
pub fn oi_status(token_present : bool, confirmed : bool) -> u8 {
    if (token_present == false) { return OI_NOT_CONNECTED; }
    if (confirmed) { return OI_CONNECTED; }
    return OI_NEEDS_CHECK;
}

pub const OAV_INITIAL : u8 = 0;
pub const OAV_IMAGE : u8 = 1;

/// The confirmed image only for a connected account that has one; every other case is the initial.
pub fn oi_avatar_mode(status : u8, has_image : bool) -> u8 {
    if (status == OI_CONNECTED and has_image) { return OAV_IMAGE; }
    return OAV_INITIAL;
}

/// The cached image belongs to an account: it is used again only for the same non-zero numeric id.
pub fn oi_cache_valid(cached_id : u64, current_id : u64) -> bool {
    return cached_id != 0 and cached_id == current_id;
}

/// The fallback letter: the login's first character, upper-cased; '?' when there is none.
pub fn oi_initial(login : []const u8) -> u8 {
    if (login.len == 0) { return 63; }
    const c : u8 = login[0];
    if (c >= 97 and c <= 122) { return c - 32; }
    return c;
}

/// The profile card's state line.
pub fn oi_status_text(out : []u8, status : u8) -> usize {
    if (status == OI_CONNECTED) { return put_bytes(out, 0, "GitHub connected"); }
    if (status == OI_NEEDS_CHECK) { return put_bytes(out, 0, "GitHub connection needs a check"); }
    return put_bytes(out, 0, "GitHub not connected");
}

// ---------------------------------------------------------------- the agent

pub const AM_CROWN : u8 = 0;
pub const AM_ASSET : u8 = 1;
pub const AM_DISC : u8 = 2;

/// The mark in front of an agent's name. Queen: the crown. A harness whose local asset the host found and
/// may use (asset_ok): that asset. Anything else: a neutral disc with the initial.
pub fn ai_mark(harness : u32, asset_ok : bool) -> u8 {
    if (harness == AGENT_QUEEN) { return AM_CROWN; }
    if (asset_ok and (harness < AGENT_COUNT or harness == AGENT_DSH)) { return AM_ASSET; }
    return AM_DISC;
}

/// The harness's written name (the program in the pane). An unknown harness reads "Agent".
pub fn ai_name(out : []u8, harness : u32) -> usize {
    if (harness < AGENT_COUNT) { return csv_field(AGENT_NAMES, harness, out); }
    if (harness == AGENT_DSH) { return put_bytes(out, 0, AGENT_DSH_NAME); }
    return put_bytes(out, 0, "Agent");
}

/// "<harness> / <role> - task #<n>": who, in what part, on which task. The role part is left out when the Queen
/// named none; the task part when the card has no task. The model is not here: it has its own line.
pub fn ai_head(out : []u8, harness : u32, role : []const u8, task_no : u32) -> usize {
    var w : usize = ai_name(out, harness);
    if (role.len > 0) {
        w = put_bytes(out, w, " / ");
        w = put_bytes(out, w, role);
    }
    if (task_no > 0) {
        w = put_bytes(out, w, " - task #");
        w = put_dec(out, w, @as(u64, task_no));
    }
    return w;
}

/// The head, then " - <state>" (the verdict machine's own words for the state).
pub fn ai_signature(out : []u8, harness : u32, role : []const u8, task_no : u32, state : u8) -> usize {
    var w : usize = ai_head(out, harness, role, task_no);
    w = put_bytes(out, w, " - ");
    var tmp : [40]u8 = undefined;
    const n : usize = qv_label(tmp[0..40], state);
    var i : usize = 0;
    while (i < n) {
        out[w + i] = tmp[i];
        i = i + 1;
    }
    return w + n;
}

/// The model line. Never invented: an empty model reads "model: unknown".
pub fn ai_model_line(out : []u8, model : []const u8) -> usize {
    var w : usize = put_bytes(out, 0, "model: ");
    if (model.len == 0) { return put_bytes(out, w, "unknown"); }
    return put_bytes(out, w, model);
}

// ---------------------------------------------------------------- tests

test a_token_alone_is_not_a_confirmed_owner {
    assert oi_status(false, false) == OI_NOT_CONNECTED;
    assert oi_status(false, true) == OI_NOT_CONNECTED;
    assert oi_status(true, false) == OI_NEEDS_CHECK;
    assert oi_status(true, true) == OI_CONNECTED;
}

test a_guessed_or_empty_username_gets_no_identity {
    const ok : OwnerIdentity = oi_confirm(583231, "gHashTag", 5, true, 1000);
    assert ok.status == OI_CONNECTED;
    assert ok.github_user_id == 583231;
    assert ok.login_len == 8;
    assert ok.has_avatar;
    // negative controls
    assert oi_confirm(0, "gHashTag", 5, true, 1000).status == OI_NOT_CONNECTED;
    assert oi_confirm(583231, "", 5, true, 1000).status == OI_NOT_CONNECTED;
    assert oi_confirm(583231, "bad name", 5, true, 1000).status == OI_NOT_CONNECTED;
    assert oi_confirm(583231, "not/a/login", 5, true, 1000).has_avatar == false;
}

test sign_out_clears_the_identity {
    const gone : OwnerIdentity = oi_sign_out();
    assert gone.status == OI_NOT_CONNECTED;
    assert gone.github_user_id == 0;
    assert gone.has_avatar == false;
}

test the_image_is_shown_only_for_a_connected_account {
    assert oi_avatar_mode(OI_CONNECTED, true) == OAV_IMAGE;
    assert oi_avatar_mode(OI_CONNECTED, false) == OAV_INITIAL;
    assert oi_avatar_mode(OI_NEEDS_CHECK, true) == OAV_INITIAL;
    assert oi_avatar_mode(OI_NOT_CONNECTED, true) == OAV_INITIAL;
}

test a_changed_account_invalidates_the_cached_image {
    assert oi_cache_valid(583231, 583231);
    assert oi_cache_valid(583231, 99) == false;
    assert oi_cache_valid(0, 0) == false;
    assert oi_cache_valid(583231, 0) == false;
}

test the_initial_is_the_logins_first_letter {
    assert oi_initial("gHashTag") == 71;
    assert oi_initial("Alice") == 65;
    assert oi_initial("7zip") == 55;
    assert oi_initial("") == 63;
}

test the_status_line_names_each_state {
    var b : [48]u8 = undefined;
    assert oi_status_text(b[0..48], OI_CONNECTED) == 16;
    assert oi_status_text(b[0..48], OI_NEEDS_CHECK) == 31;
    assert oi_status_text(b[0..48], OI_NOT_CONNECTED) == 20;
    assert b[0] == 71 and b[7] == 110;
}

test the_queen_has_the_crown_and_an_unknown_harness_a_neutral_disc {
    assert ai_mark(AGENT_QUEEN, false) == AM_CROWN;
    assert ai_mark(AGENT_QUEEN, true) == AM_CROWN;
    assert ai_mark(0, true) == AM_ASSET;
    assert ai_mark(AGENT_DSH, true) == AM_ASSET;
    // no asset the host may use: a disc, not a borrowed logo
    assert ai_mark(0, false) == AM_DISC;
    assert ai_mark(AGENT_DSH, false) == AM_DISC;
    // a harness number no one registered is a disc even with an asset flag
    assert ai_mark(77, true) == AM_DISC;
}

test the_harness_has_its_written_name {
    var b : [40]u8 = undefined;
    assert ai_name(b[0..40], 0) == 11;
    assert b[0] == 67 and b[6] == 32 and b[7] == 67;
    assert ai_name(b[0..40], AGENT_QUEEN) == 5;
    assert ai_name(b[0..40], AGENT_DSH) == 3;
    assert ai_name(b[0..40], 77) == 5;
}

test the_signature_carries_harness_role_task_and_state {
    var b : [96]u8 = undefined;
    // "Claude Code" (11) + " / " (3) + "UI agent" (8) + " - task #" (9) + "42" (2) + " - " (3) + "Verifying" (9)
    assert ai_signature(b[0..96], 0, "UI agent", 42, 2) == 45;
    assert b[0] == 67 and b[11] == 32 and b[14] == 85 and b[31] == 52 and b[36] == 86 and b[44] == 103;
    // no role, no task: the name, then the state
    // "OpenCode" (8) + " - " (3) + "Accepted" (8)
    assert ai_signature(b[0..96], 3, "", 0, 3) == 19;
    assert b[0] == 79 and b[11] == 65;
}

test the_head_is_the_signature_without_the_state {
    var b : [96]u8 = undefined;
    // "Claude Code" (11) + " / " (3) + "UI agent" (8) + " - task #" (9) + "42" (2)
    assert ai_head(b[0..96], 0, "UI agent", 42) == 33;
    assert b[11] == 32 and b[14] == 85 and b[31] == 52 and b[32] == 50;
    assert ai_head(b[0..96], 3, "", 0) == 8;
    // "OpenCode" (8) + " - task #" (9) + "7" (1)
    assert ai_head(b[0..96], 3, "", 7) == 18;
}

test the_model_is_a_separate_line_and_never_invented {
    var b : [48]u8 = undefined;
    // "model: " (7) + "glm-4.7-flash" (13)
    assert ai_model_line(b[0..48], "glm-4.7-flash") == 20;
    assert b[7] == 103;
    // "model: " (7) + "unknown" (7)
    assert ai_model_line(b[0..48], "") == 14;
    assert b[7] == 117;
}
