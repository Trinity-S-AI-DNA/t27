// SPDX-License-Identifier: Apache-2.0
; specs/t27os/queen_graph_plane.t27 -- the graph plane of the LIVE MYCELIUM band (epic #12779,
; the gx-plane step): the tap's event ring folds through the work graph law into per-kind node
; counts and one row position per kind, so the band can draw TASK, ACTION and the rest -- not
; only the agent plane -- without the window holding a single rule of its own (FR-004).
; --
; THE RING. The host keeps two parallel arrays -- one event kind and one pid per entry, at most
; QGP_RING of them (the oldest fall out; the ring never truncates a fold, it bounds what a fold
; reads). The fold is the law's own: spawn names the actor and the queen, deliver is performed
; with its sequence as the ACTION id, everything else lands as the bus states it. The same ring
; folds twice into the same sha256 -- purity, inherited.
; --
; THE ROWS AND COLOURS. One row per node kind, top to bottom in NK_ order, each kind in its own
; palette colour of specs/t27os/queen_live_graph.t27 (SPEC new green, AGENT active blue, TASK
; restart amber, ACTION down red, ARTIFACT exit grey -- five kinds, five distinct colours). The
; row test holds the mapping bijective, so no kind ever hides under another.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osQueenGraphPlane;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::Event;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::node_kind_at_pub;
use t27f::work_graph::graph_digest;
use t27f::work_graph::NK_SPEC;
use t27f::work_graph::NK_AGENT;
use t27f::work_graph::NK_TASK;
use t27f::work_graph::NK_ACTION;
use t27f::work_graph::NK_ARTIFACT;
use t27f::work_graph::NK_COUNT;
use t27f::work_graph::WG_OK;
use t27os::live_tap::TAP_REPLAY;
use t27os::queen_live_graph::QLG_C_NEW;
use t27os::queen_live_graph::QLG_C_ACTIVE;
use t27os::queen_live_graph::QLG_C_RESTART;
use t27os::queen_live_graph::QLG_C_DOWN;
use t27os::queen_live_graph::QLG_C_EXIT;

/// Ring capacity: the host bounds what a fold reads; past it the fold refuses whole. 127, not
/// 128: the counts the fold feeds the flags word wrap modulo 128, and a ring of 127 events can
/// never wrap one.
pub const QGP_RING : u32 = 127;
pub const QGP_ERR_RING : u8 = 9;

/// Folds a ring of (kind, pid) pairs into the graph: every entry is applied in order, a deliver
/// takes its ring index as the ACTION id. Kinds are the bus's own numbers (0 spawn, 4 deliver).
/// Refuses whole past the ring cap, leaving the graph as it was.
pub fn qgp_fold(g : *WorkGraph, kinds : []const u8, pids : []const u64) -> u8 {
    if (kinds.len > QGP_RING as usize) { return QGP_ERR_RING; }
    var e : u32 = 0;
    while (e < kinds.len) {
        const r : u8 = apply_one(g, kinds[e], pids[e], 1, e);
        if (r != WG_OK) { return r; }
        e = e + 1;
    }
    return WG_OK;
}

fn apply_one(g : *WorkGraph, kind : u8, from : u64, to : u64, seq : u32) -> u8 {
    // deliver 0 is work_graph's D_NONE; its const does not splice across modules (see live_tap)
    return apply_event(g, Event { kind: kind, from_pid: from, to_pid: to, task_no: 0, deliver: 0, reason: 99, seq: seq, spec_id: 0 });
}

/// How many nodes of one kind the graph holds.
pub fn qgp_count_kind(g : *WorkGraph, nk : u8) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < nodes(g)) {
        if (node_kind_at_pub(g, i) == nk) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// The palette colour of a node kind: SPEC new, AGENT active, TASK restart, ACTION down,
/// ARTIFACT exit -- five kinds, five distinct colours, one law.
pub fn qgp_colour(nk : u8) -> u32 {
    if (nk == NK_SPEC) { return QLG_C_NEW; }
    if (nk == NK_AGENT) { return QLG_C_ACTIVE; }
    if (nk == NK_TASK) { return QLG_C_RESTART; }
    if (nk == NK_ACTION) { return QLG_C_DOWN; }
    return QLG_C_EXIT;
}

/// The row's y of a kind inside the band: NK order top to bottom, rows clear of each other.
pub fn qgp_row_y(nk : u8, y : f64, h : f64) -> f64 {
    const rows : f64 = NK_COUNT as f64;
    const idx : f64 = qgp_row_index(nk) as f64;
    return y + h * (idx + 0.5) / rows;
}
fn qgp_row_index(nk : u8) -> u32 {
    if (nk == NK_SPEC) { return 0; }
    if (nk == NK_AGENT) { return 1; }
    if (nk == NK_TASK) { return 2; }
    if (nk == NK_ACTION) { return 3; }
    return 4;
}

/// Parses a ring file's text into (kind, pid) pairs: one event per line, decimal "kind pid";
/// blank lines and `#` comment lines are skipped. Parsing stops at the first malformed line --
/// a half-read ring is refused, not guessed. Returns the parsed count, never past either
/// array's length.
pub const QGP_PARSE_CAP : u32 = 128;
pub fn qgp_parse_ring(text : []const u8, kinds : []u8, pids : []u64) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < text.len) {
        var e : usize = i;
        while (e < text.len and text[e] != 10) { e = e + 1; }
        var s : usize = i;
        while (s < e and text[s] == 32) { s = s + 1; }
        const had : bool = s < e;
        if (s < e and text[s] == 35) { i = e + 1; continue; }
        const ks : usize = s;
        var k : u64 = 0;
        while (s < e and text[s] >= 48 and text[s] <= 57) { k = k * 10 + ((text[s] - 48) as u64); s = s + 1; }
        const ke : usize = s;
        while (s < e and text[s] == 32) { s = s + 1; }
        const ps : usize = s;
        var p : u64 = 0;
        while (s < e and text[s] >= 48 and text[s] <= 57) { p = p * 10 + ((text[s] - 48) as u64); s = s + 1; }
        while (s < e and text[s] == 32) { s = s + 1; }
        if (ke > ks and s > ps and s == e) {
            if (n >= kinds.len or n >= pids.len or k >= NK_COUNT) { return n; }
            kinds[n as usize] = k as u8;
            pids[n as usize] = p;
            n = n + 1;
        } else if (had) {
            return n;
        }
        i = e + 1;
    }
    return n;
}

/// Whether a ring file is a DEMO ring: its first line starts with `# `. A demo ring is named on
/// the surface, never drawn as live.
pub fn qgp_is_demo(text : []const u8) -> bool {
    return text.len >= 2 and text[0] == 35 and text[1] == 32;
}

/// Packs the five per-kind node counts into the free high bits (27..61) of the dashboard's flags
/// word -- the window has no spare state word, and these bits are the dashboard's own. Each
/// count wraps modulo 128; the ring caps at 127 events, so a fold never wraps one.
pub fn qgp_pack_counts(fl : u64, ca : u32, ct : u32, cc : u32, cn : u32, cf : u32) -> u64 {
    var out : u64 = fl;
    out = out - ((out / 134217728) % 128) * 134217728 + ((ca % 128) as u64) * 134217728;
    out = out - ((out / 17179869184) % 128) * 17179869184 + ((ct % 128) as u64) * 17179869184;
    out = out - ((out / 2199023255552) % 128) * 2199023255552 + ((cc % 128) as u64) * 2199023255552;
    out = out - ((out / 281474976710656) % 128) * 281474976710656 + ((cn % 128) as u64) * 281474976710656;
    out = out - ((out / 36028797018963968) % 128) * 36028797018963968 + ((cf % 128) as u64) * 36028797018963968;
    return out;
}
pub fn qgp_count_agent(fl : u64) -> u32 { return ((fl / 134217728) % 128) as u32; }
pub fn qgp_count_task(fl : u64) -> u32 { return ((fl / 17179869184) % 128) as u32; }
pub fn qgp_count_action(fl : u64) -> u32 { return ((fl / 2199023255552) % 128) as u32; }
pub fn qgp_count_artifact(fl : u64) -> u32 { return ((fl / 281474976710656) % 128) as u32; }
pub fn qgp_count_spec(fl : u64) -> u32 { return ((fl / 36028797018963968) % 128) as u32; }

/// Bit 62: the ring file announced itself a demo (`# ` first line). A demo ring is named on the
/// surface, never drawn as live.
pub fn qgp_pack_demo(fl : u64, demo : bool) -> u64 {
    if (demo) { return fl + 4611686018427387904; }
    return fl;
}
pub fn qgp_is_demo_flag(fl : u64) -> bool { return (fl / 4611686018427387904) % 2 == 1; }

/// Counts a folded graph per kind and packs the five counts into the flags word in one step.
pub fn qgp_pack_graph(fl : u64, g : *WorkGraph) -> u64 {
    return qgp_pack_counts(fl,
        qgp_count_kind(g, NK_AGENT),
        qgp_count_kind(g, NK_TASK),
        qgp_count_kind(g, NK_ACTION),
        qgp_count_kind(g, NK_ARTIFACT),
        qgp_count_kind(g, NK_SPEC));
}

// ---- tests ----

test the_recorded_log_folds_into_the_five_kinds {
    var g : WorkGraph = new_graph();
    var kinds : [24]u8 = undefined;
    var pids : [24]u64 = undefined;
    var i : u32 = 0;
    while (i < 24) {
        kinds[i as usize] = TAP_REPLAY[i as usize];
        pids[i as usize] = 1001 + (i % 7) as u64;
        i = i + 1;
    }
    assert(qgp_fold(&g, kinds[0..24], pids[0..24]) == WG_OK);
    assert(nodes(&g) == 20);
    assert(qgp_count_kind(&g, NK_AGENT) == 8);
    assert(qgp_count_kind(&g, NK_ACTION) == 12);
    assert(qgp_count_kind(&g, NK_SPEC) + qgp_count_kind(&g, NK_TASK) + qgp_count_kind(&g, NK_ARTIFACT) == 0);
}

test the_same_ring_folds_twice_into_the_same_bytes {
    var a : WorkGraph = new_graph();
    var b : WorkGraph = new_graph();
    var kinds : [24]u8 = undefined;
    var pids : [24]u64 = undefined;
    var i : u32 = 0;
    while (i < 24) {
        kinds[i as usize] = TAP_REPLAY[i as usize];
        pids[i as usize] = 1001 + (i % 7) as u64;
        i = i + 1;
    }
    assert(qgp_fold(&a, kinds[0..24], pids[0..24]) == WG_OK);
    assert(qgp_fold(&b, kinds[0..24], pids[0..24]) == WG_OK);
    var da : [32]u8 = graph_digest(&a);
    var db : [32]u8 = graph_digest(&b);
    i = 0;
    while (i < 32) {
        assert(da[i as usize] == db[i as usize]);
        i = i + 1;
    }
}

test the_five_kinds_take_five_distinct_colours_and_rows {
    assert(qgp_colour(NK_SPEC) == QLG_C_NEW);
    assert(qgp_colour(NK_AGENT) == QLG_C_ACTIVE);
    assert(qgp_colour(NK_TASK) == QLG_C_RESTART);
    assert(qgp_colour(NK_ACTION) == QLG_C_DOWN);
    assert(qgp_colour(NK_ARTIFACT) == QLG_C_EXIT);
    var a : u8 = 0;
    while (a < NK_COUNT) {
        var b : u8 = a + 1;
        while (b < NK_COUNT) {
            assert(qgp_colour(a) != qgp_colour(b));
            assert(qgp_row_y(a, 0.0, 150.0) != qgp_row_y(b, 0.0, 150.0));
            b = b + 1;
        }
        // every row sits inside the band
        const ry : f64 = qgp_row_y(a, 0.0, 150.0);
        assert(ry > 0.0 and ry < 150.0);
        a = a + 1;
    }
}

test a_ring_past_its_cap_refuses_whole_and_unchanged {
    var g : WorkGraph = new_graph();
    var kinds : [129]u8 = undefined;
    var pids : [129]u64 = undefined;
    var i : u32 = 0;
    while (i < 129) {
        kinds[i as usize] = 0;
        pids[i as usize] = 5000 + i as u64;
        i = i + 1;
    }
    assert(qgp_fold(&g, kinds[0..129], pids[0..129]) == QGP_ERR_RING);
    assert(nodes(&g) == 0);
}

test the_ring_file_parses_and_names_its_demo_mark {
    var kinds : [8]u8 = undefined;
    var pids : [8]u64 = undefined;
    const text : []const u8 = "# demo ring\n0 1001\n4 1002\n\n";
    const n : u32 = qgp_parse_ring(text, kinds[0..8], pids[0..8]);
    assert(n == 2 and qgp_is_demo(text));
    assert(kinds[0] == 0 and pids[0] == 1001 and kinds[1] == 4 and pids[1] == 1002);
    // a malformed line refuses the rest: a half-read ring is not guessed
    const bad : []const u8 = "0 1001\njunk\n4 1002\n";
    assert(qgp_parse_ring(bad, kinds[0..8], pids[0..8]) == 1);
    // a kind without its pid refuses too
    const half : []const u8 = "0 1001\n4\n";
    assert(qgp_parse_ring(half, kinds[0..8], pids[0..8]) == 1);
    // no leading mark, not a demo
    const live : []const u8 = "0 7\n";
    assert(qgp_parse_ring(live, kinds[0..8], pids[0..8]) == 1 and qgp_is_demo(live) == false);
}

test the_five_counts_pack_into_the_flags_high_bits {
    var fl : u64 = 5;
    fl = qgp_pack_counts(fl, 3, 0, 12, 1, 0);
    assert(qgp_count_agent(fl) == 3 and qgp_count_task(fl) == 0 and qgp_count_action(fl) == 12);
    assert(qgp_count_artifact(fl) == 1 and qgp_count_spec(fl) == 0);
    assert(fl % 2 == 1);
    // a count past 127 wraps -- and the ring caps at 127 events, so a fold never wraps one
    fl = qgp_pack_counts(0, 200, 0, 0, 0, 0);
    assert(qgp_count_agent(fl) == 72);
    // the 127-event ring folds without a wrap: 127 agents stay 127
    fl = qgp_pack_counts(0, 127, 0, 0, 0, 0);
    assert(qgp_count_agent(fl) == 127);
}

test a_folded_graph_packs_its_counts {
    var g : WorkGraph = new_graph();
    var kinds : [24]u8 = undefined;
    var pids : [24]u64 = undefined;
    var i : u32 = 0;
    while (i < 24) {
        kinds[i as usize] = TAP_REPLAY[i as usize];
        pids[i as usize] = 1001 + (i % 7) as u64;
        i = i + 1;
    }
    assert(qgp_fold(&g, kinds[0..24], pids[0..24]) == WG_OK);
    const fl : u64 = qgp_pack_graph(0, &g);
    assert(qgp_count_agent(fl) == 8 and qgp_count_action(fl) == 12);
    assert(qgp_count_task(fl) == 0 and qgp_count_spec(fl) == 0 and qgp_count_artifact(fl) == 0);
    // the demo bit rides bit 62 and never collides with the counts
    const fd : u64 = qgp_pack_demo(fl, true);
    assert(qgp_is_demo_flag(fd) and qgp_count_agent(fd) == 8);
    assert(qgp_is_demo_flag(qgp_pack_demo(fl, false)) == false);
}
