// Dedicated T27 communications entry. It never initializes the Carbon dashboard,
// account gateway, legacy discovery, agents or another application's settings.
fn cm_class(name:[]const u8)->u64 {
    return @extern("objc_getClass");
}
fn cm_selector(name:[]const u8)->u64 {
    return @extern("sel_registerName");
}
fn cm_message0(object:u64,selector:u64)->u64 {
    return @extern("objc_msgSend");
}
fn cm_message1(object:u64,selector:u64,value:u64)->u64 {
    return @extern("objc_msgSend");
}
fn cm_string_new(allocator:u64,bytes:[]const u8,n:u64,encoding:u32,external:bool)->u64 {
    return @extern("CFStringCreateWithBytes");
}
fn cm_open_controller()->u64 {
    return @extern("lu_open_mac");
}
pub fn cm_local_only_allowed(flag:u64)->bool {
    return flag==1;
}
pub fn main()->i32 {
    const pool:u64=cm_message0(cm_class("NSAutoreleasePool"),cm_selector("new"));
    const bundle:u64=cm_message0(cm_class("NSBundle"),cm_selector("mainBundle"));
    const name:[]const u8="T27LocalOnlyDefault";
    const key:u64=cm_string_new(0,name,@as(u64,name.len),134217984,false);
    const value:u64=cm_message1(bundle,cm_selector("objectForInfoDictionaryKey:"),key);
    const flag:u64=cm_message0(value,cm_selector("boolValue"))%256;
    if(!cm_local_only_allowed(flag)) {
        return 2;
    }
    const app:u64=cm_message0(cm_class("NSApplication"),cm_selector("sharedApplication"));
    if(app==0 or cm_open_controller()==0) {
        return 3;
    }
    cm_message0(app,cm_selector("run"));
    cm_message0(pool,cm_selector("drain"));
    return 0;
}
test dedicated_entry_requires_explicit_bundle_mode_before_controller {
    assert cm_local_only_allowed(1);
    assert !cm_local_only_allowed(0) and !cm_local_only_allowed(2);
}
