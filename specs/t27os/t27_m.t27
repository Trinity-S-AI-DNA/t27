// SPDX-License-Identifier: Apache-2.0
// specs/t27os/t27_m.t27 -- T27 M ("Mother", the Golden Builder): the layer
// that builds T27 OS. The harness, free-model router, actor map and one UI
// model drawn on four surfaces.
// Part of [EPIC] T27 M, the Golden Builder (#12945). Closes #12945.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::t27_m {

    pub const MODULE : str = "t27_m";
    pub const SURFACE : str = "golden_builder";

    // ---- The harness --------------------------------------------------------
    pub struct Harness {
        starts : bool,
        reports : bool,
        survives_provider_failure : bool,
        resumes_from_artifact : bool,
    };

    // ---- Routing tiers (from specs/claw/model_route.t27) -------------------
    pub const TIER_PANE : str = "pane";
    pub const TIER_SONNET : str = "sonnet";
    pub const TIER_OPUS : str = "opus";

    // ---- Surfaces -----------------------------------------------------------
    pub const SURFACE_FPGA : str = "fpga_framebuffer";
    pub const SURFACE_NATIVE : str = "native_window";
    pub const SURFACE_BROWSER : str = "t27f_live";
    pub const SURFACE_MOBILE : str = "mobile";

    // ---- Rules --------------------------------------------------------------
    // The harness starts, reports, survives a provider failure and resumes.
    pub fn harness_reliable(h: Harness) -> bool {
        return h.starts && h.reports && h.survives_provider_failure && h.resumes_from_artifact;
    }

    // A provider switch keeps trace_id, step and budget.
    pub fn provider_switch_keeps(keep_trace: bool, keep_step: bool, keep_budget: bool) -> bool {
        return keep_trace && keep_step && keep_budget;
    }

    // Recovery reads durable artifacts, never compacted chat history.
    pub fn recovery_reads_artifacts(reads_artifacts: bool, reads_compacted_history: bool) -> bool {
        return reads_artifacts && !reads_compacted_history;
    }

    // Nothing under this epic mints, promises or prices TRI or XP.
    pub fn mints_tri() -> bool {
        return false;
    }

    pub fn prices_xp() -> bool {
        return false;
    }

    // ---- Tests ------------------------------------------------------------
    test "the harness starts, reports, survives failure and resumes" {
        assert(harness_reliable(Harness {
            starts: true, reports: true, survives_provider_failure: true,
            resumes_from_artifact: true,
        }));
        assert(!harness_reliable(Harness {
            starts: true, reports: true, survives_provider_failure: false,
            resumes_from_artifact: true,
        }));
    }

    test "a provider switch keeps trace, step and budget" {
        assert(provider_switch_keeps(true, true, true));
        assert(!provider_switch_keeps(false, true, true));
        assert(!provider_switch_keeps(true, false, true));
        assert(!provider_switch_keeps(true, true, false));
    }

    test "recovery reads durable artifacts, never compacted history" {
        assert(recovery_reads_artifacts(true, false));
        assert(!recovery_reads_artifacts(false, false));
        assert(!recovery_reads_artifacts(true, true));
    }

    test "no TRI minting or XP pricing" {
        assert(!mints_tri());
        assert(!prices_xp());
    }

    invariant harness_must_be_fully_reliable {
        assert harness_reliable(Harness {
            starts: true, reports: true, survives_provider_failure: true,
            resumes_from_artifact: true,
        });
    }

    invariant no_tri_or_xp {
        assert !mints_tri();
        assert !prices_xp();
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
