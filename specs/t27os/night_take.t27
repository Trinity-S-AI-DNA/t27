// SPDX-License-Identifier: Apache-2.0
; specs/t27os/night_take.t27 -- what a night tick may take (gHashTag/t27#11835, board Trinity-S-AI-DNA/t27os#3,
; task "Claim-refs as a mandatory step"). The T27 OS night loop (specs/crons/t27os-night-loop.t27) fires every
; 15 minutes; before this card its take rule lived only as prose in the tick prompt. Here it is the law:
;   - a task in state.json .done is never retaken;
;   - a task in .inprogress belongs to another actor (the day session or a sibling tick) and is skipped;
;   - a task in .blocked is taken again only with a new angle or an owner note on its issue;
;   - a claim ref refs/swarm/claims/<n> written by someone else is a hold, whatever state.json says --
;     the ref is the one fact two ticks on two machines both read, so it wins over the local file;
;   - among what is takeable, the top Pareto score wins (impact * 1000 / effort), ties to the lower index;
;     an effort of 0 means "not estimated" and scores 0, so an unestimated task is never the top pick.
; The retake rule (gHashTag/t27#11892, retros of ticks 20 and 24 in ~/.t27os/loop/state.json):
;   - an .inprogress entry older than STALE_S returns to the pool -- the actor is presumed gone;
;   - a task whose remainder waits only on a leg no tick can run (the t27b leg, a workflow edit via TRI CLAW)
;     is not taken, so ticks stop re-opening finished law;
;   - a task blocked CRED_REPEAT times on the same credential leaves the pool for a request to its holder.
; Reading state.json and listing the refs is the boundary's work (git ls-remote, the file); everything decided
; about what they say is here. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osNightTake;

/// The lane of a task in ~/.t27os/loop/state.json. LANE_OPEN: in none of the three lists.
pub const LANE_OPEN : u8 = 0;
pub const LANE_DONE : u8 = 1;
pub const LANE_BLOCKED : u8 = 2;
pub const LANE_INPROGRESS : u8 = 3;

/// The pick of an empty or fully held board.
pub const NONE : u32 = 4294967295;

/// The Pareto scale: impact * SCALE / effort keeps three digits of the ratio in whole numbers.
pub const SCALE : u32 = 1000;

/// May this tick take the task? `claimed_by_other` is 1 when refs/swarm/claims/<n> exists and was not
/// written by this tick; `new_angle` is 1 when the blocked task carries a new angle or an owner note.
pub fn may_take(lane: u8, claimed_by_other: u8, new_angle: u8) -> bool {
    if (claimed_by_other != 0) { return false; }
    if (lane == LANE_DONE) { return false; }
    if (lane == LANE_INPROGRESS) { return false; }
    if (lane == LANE_BLOCKED) { return new_angle != 0; }
    return lane == LANE_OPEN;
}

/// impact * SCALE / effort; 0 for an unestimated (effort 0) task.
pub fn pareto_score(impact: u32, effort: u32) -> u32 {
    if (effort == 0) { return 0; }
    return impact * SCALE / effort;
}

/// The index of the task to take among the first n, or NONE. A takeable task with score 0 is still
/// takeable, but only when nothing better is: the first strictly higher score replaces the pick.
pub fn pick(lanes: []const u8, others: []const u8, angles: []const u8, impact: []const u32, effort: []const u32, n: u32) -> u32 {
    var best : u32 = NONE;
    var best_score : u32 = 0;
    var i : u32 = 0;
    while (i < n) {
        if (may_take(lanes[i], others[i], angles[i])) {
            const s : u32 = pareto_score(impact[i], effort[i]);
            if (best == NONE or s > best_score) {
                best = i;
                best_score = s;
            }
        }
        i = i + 1;
    }
    return best;
}

test done_inprogress_and_a_foreign_claim_are_never_taken {
    assert may_take(LANE_DONE, 0, 1) == false;
    assert may_take(LANE_INPROGRESS, 0, 1) == false;
    // the claim ref wins over the local file: an open task claimed by another actor is held
    assert may_take(LANE_OPEN, 1, 0) == false;
    assert may_take(LANE_OPEN, 0, 0) == true;
}

test a_blocked_task_needs_a_new_angle {
    assert may_take(LANE_BLOCKED, 0, 0) == false;
    assert may_take(LANE_BLOCKED, 0, 1) == true;
    // a new angle does not lift someone else's claim
    assert may_take(LANE_BLOCKED, 1, 1) == false;
    // a lane code nobody wrote a rule for takes nothing
    assert may_take(9, 0, 1) == false;
}

test the_pareto_score_and_an_unestimated_effort {
    assert pareto_score(8, 2) == 4000;
    assert pareto_score(3, 3) == 1000;
    assert pareto_score(9, 0) == 0;
    assert pareto_score(0, 5) == 0;
}

test pick_takes_the_top_takeable_score_ties_to_the_lower_index {
    // task 0 scores highest but is in progress; task 1 is claimed by another actor; tasks 2 and 3 tie
    const lanes : [5]u8 = [3, 0, 0, 0, 1];
    const others : [5]u8 = [0, 1, 0, 0, 0];
    const angles : [5]u8 = [0, 0, 0, 0, 0];
    const impact : [5]u32 = [9, 9, 6, 3, 9];
    const effort : [5]u32 = [1, 1, 2, 1, 1];
    assert pick(lanes[0 .. 5], others[0 .. 5], angles[0 .. 5], impact[0 .. 5], effort[0 .. 5], 5) == 2;
    // only the first three looked at: task 2 still wins
    assert pick(lanes[0 .. 5], others[0 .. 5], angles[0 .. 5], impact[0 .. 5], effort[0 .. 5], 3) == 2;
}

test an_unestimated_task_is_taken_only_when_nothing_else_is {
    const lanes : [2]u8 = [0, 0];
    const others : [2]u8 = [0, 0];
    const angles : [2]u8 = [0, 0];
    const impact : [2]u32 = [9, 1];
    const effort : [2]u32 = [0, 4];
    assert pick(lanes[0 .. 2], others[0 .. 2], angles[0 .. 2], impact[0 .. 2], effort[0 .. 2], 2) == 1;
    assert pick(lanes[0 .. 2], others[0 .. 2], angles[0 .. 2], impact[0 .. 2], effort[0 .. 2], 1) == 0;
}

test negative_control_a_fully_held_board_picks_none {
    const lanes : [4]u8 = [1, 3, 2, 0];
    const others : [4]u8 = [0, 0, 0, 1];
    const angles : [4]u8 = [0, 0, 0, 0];
    const impact : [4]u32 = [9, 9, 9, 9];
    const effort : [4]u32 = [1, 1, 1, 1];
    assert pick(lanes[0 .. 4], others[0 .. 4], angles[0 .. 4], impact[0 .. 4], effort[0 .. 4], 4) == NONE;
    assert pick(lanes[0 .. 4], others[0 .. 4], angles[0 .. 4], impact[0 .. 4], effort[0 .. 4], 0) == NONE;
}

/// An .inprogress entry older than this many seconds is presumed abandoned (two hours).
pub const STALE_S : u64 = 7200;

/// What is left of a task, as its state.json "left" field reads.
pub const LEFT_WORK : u8 = 0;
pub const LEFT_T27B_LEG : u8 = 1;
pub const LEFT_TRI_CLAW : u8 = 2;

/// Blocks on the same credential after which the task becomes a request to the credential holder.
pub const CRED_REPEAT : u32 = 2;

/// Clock skew between two machines that a stamp ahead of `now` may carry and still read as fresh
/// (gHashTag/t27#11974). Further ahead, the stamp is malformed: tick 59 typed 06:40Z at 06:29Z, and a
/// mistyped day would hide the entry from the retake rule for days.
pub const SKEW_S : u64 = 300;

/// Is the in-progress entry stamped `since` abandoned at `now` (epoch seconds)? A stamp up to SKEW_S ahead
/// reads fresh; one further ahead is malformed and reads stale, so the task returns to the pool.
pub fn stale_claim(now: u64, since: u64) -> bool {
    if (now < since) { return since - now > SKEW_S; }
    return now - since > STALE_S;
}

/// Does the remainder wait only on a leg no night tick can run? A remainder code nobody wrote a rule for waits too.
pub fn leg_only(left: u8) -> bool {
    return left != LEFT_WORK;
}

/// Has the task been blocked on the same credential often enough to leave the pool for a request?
pub fn to_request(cred_blocks: u32) -> bool {
    return cred_blocks >= CRED_REPEAT;
}

/// may_take with the retake rule. `stale` is 1 when stale_claim held for the entry; the caller passes
/// claimed_by_other = 0 only when the claim ref is as old as the entry.
pub fn may_retake(lane: u8, claimed_by_other: u8, new_angle: u8, stale: u8, left: u8, cred_blocks: u32) -> bool {
    if (claimed_by_other != 0) { return false; }
    if (leg_only(left)) { return false; }
    if (to_request(cred_blocks)) { return false; }
    if (lane == LANE_INPROGRESS) { return stale != 0; }
    return may_take(lane, claimed_by_other, new_angle);
}

test an_entry_older_than_two_hours_is_stale_and_a_small_clock_skew_is_not {
    assert stale_claim(10000, 2800) == false;
    assert stale_claim(10001, 2800) == true;
    assert stale_claim(1792789438, 1792770319) == true;
    // a sibling clock 60 s ahead, and the skew bound itself, read fresh
    assert stale_claim(5000, 5060) == false;
    assert stale_claim(5000, 5300) == false;
}

test a_stamp_further_ahead_than_the_skew_is_malformed_and_stale {
    assert stale_claim(5000, 5301) == true;
    // tick 59: since 06:40Z written at 06:29Z, 11 minutes ahead
    assert stale_claim(1792823340, 1792824000) == true;
    // a mistyped day
    assert stale_claim(100, 86500) == true;
    assert may_retake(LANE_INPROGRESS, 0, 0, 1, LEFT_WORK, 0) == true;
}

test a_stale_in_progress_task_returns_to_the_pool_a_fresh_one_does_not {
    assert may_retake(LANE_INPROGRESS, 0, 0, 0, LEFT_WORK, 0) == false;
    // the old rule still answers for every other lane
    assert may_retake(LANE_OPEN, 0, 0, 0, LEFT_WORK, 0) == true;
    assert may_retake(LANE_BLOCKED, 0, 1, 0, LEFT_WORK, 0) == true;
    assert may_retake(LANE_DONE, 0, 1, 1, LEFT_WORK, 0) == false;
}

test a_remainder_that_waits_on_a_leg_is_not_retaken {
    assert leg_only(LEFT_T27B_LEG) == true;
    assert leg_only(LEFT_TRI_CLAW) == true;
    assert leg_only(7) == true;
    assert may_retake(LANE_INPROGRESS, 0, 0, 1, LEFT_T27B_LEG, 0) == false;
    assert may_retake(LANE_OPEN, 0, 0, 0, LEFT_TRI_CLAW, 0) == false;
}

test blocked_twice_on_one_credential_goes_to_a_request {
    assert to_request(1) == false;
    assert to_request(2) == true;
    assert may_retake(LANE_BLOCKED, 0, 1, 0, LEFT_WORK, 1) == true;
    assert may_retake(LANE_BLOCKED, 0, 1, 0, LEFT_WORK, 2) == false;
}

test negative_control_staleness_does_not_lift_a_live_claim_ref {
    assert may_retake(LANE_INPROGRESS, 1, 1, 1, LEFT_WORK, 0) == false;
    assert may_retake(LANE_OPEN, 1, 0, 0, LEFT_WORK, 0) == false;
}
