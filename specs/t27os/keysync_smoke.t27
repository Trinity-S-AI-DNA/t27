// SPDX-License-Identifier: Apache-2.0
; specs/t27os/keysync_smoke.t27 -- run keysync_host.t27's OS calls once, on FAKE data and in-memory keys (no Keychain
; item is read or written): seal/open, sign/verify and their negative controls, SHA-256 of "abc". Not part of the app.
; Build:  t27b build specs/t27os/keysync_smoke.t27 -o smoke.o --macho
;         ld -arch arm64 -platform_version macos 11.0 $(xcrun --show-sdk-version) -syslibroot $(xcrun --show-sdk-path) \
;            -e _main -lSystem -framework CoreFoundation -framework Security -o smoke smoke.o
; Prints one line per check and "keysync-smoke: N/N" ; exit 0 only when all pass. Refs gHashTag/t27#11444.

module T27osKeysyncSmoke;

use t27os::keysync_host::ks_sha256;
use t27os::keysync_host::ks_gen_pair;
use t27os::keysync_host::ks_seal;
use t27os::keysync_host::ks_open;
use t27os::keysync_host::ks_sign;
use t27os::keysync_host::ks_verify;
use t27os::editors::same_bytes;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_exit;

fn say(s: []const u8, ok: bool) -> bool {
    if (ok) { sys_write(1, "ok   ", 5); } else { sys_write(1, "FAIL ", 5); }
    sys_write(1, s, @as(u64, s.len));
    sys_write(1, "\n", 1);
    return ok;
}

pub fn main() -> void {
    var good : u32 = 0;
    var sp : [97]u8 = undefined;
    var spub : [65]u8 = undefined;
    var gp : [97]u8 = undefined;
    var gpub : [65]u8 = undefined;
    var op : [97]u8 = undefined;
    var opub : [65]u8 = undefined;
    var dg : [32]u8 = undefined;
    var ct : [512]u8 = undefined;
    var pt : [512]u8 = undefined;
    var sg : [128]u8 = undefined;
    if (say("sha256 of abc starts ba7816bf", ks_sha256("abc", dg[0..32]) and dg[0] == 186 and dg[1] == 120 and dg[2] == 22 and dg[3] == 191)) { good = good + 1; }
    const g1 : bool = ks_gen_pair(sp[0..97], spub[0..65]);
    const g2 : bool = ks_gen_pair(gp[0..97], gpub[0..65]);
    const g3 : bool = ks_gen_pair(op[0..97], opub[0..65]);
    if (say("three pairs generated, public keys start 04", g1 and g2 and g3 and spub[0] == 4 and gpub[0] == 4 and !same_bytes(spub[0..65], gpub[0..65]))) { good = good + 1; }
    const plain : []const u8 = "sk-fake-0123456789abcdef0123456789abcdef";
    const cn : usize = ks_seal(spub[0..65], plain, ct[0..512]);
    if (say("seal gives a ciphertext longer than the plaintext", cn > plain.len + 60)) { good = good + 1; }
    const pn : usize = ks_open(sp[0..97], ct[0..cn], pt[0..512]);
    if (say("open with the right key returns the plaintext", pn == plain.len and same_bytes(pt[0..pn], plain))) { good = good + 1; }
    if (say("open with another device's key fails", ks_open(op[0..97], ct[0..cn], pt[0..512]) == 0)) { good = good + 1; }
    ct[cn - 1] = ct[cn - 1] ^ 1;
    if (say("open of a damaged ciphertext fails", ks_open(sp[0..97], ct[0..cn], pt[0..512]) == 0)) { good = good + 1; }
    const c2 : usize = ks_seal(spub[0..65], plain, ct[0..512]);
    if (say("a second seal of the same key succeeds with the same length", c2 > 0 and c2 == cn)) { good = good + 1; }
    const msg : []const u8 = "t27os.keysync.v1.approve\ntarget=00\nby=11\n";
    const sn : usize = ks_sign(gp[0..97], msg, sg[0..128]);
    if (say("signature verifies", sn > 0 and ks_verify(gpub[0..65], msg, sg[0..sn]))) { good = good + 1; }
    if (say("signature fails for another message", !ks_verify(gpub[0..65], "t27os.keysync.v1.approve\ntarget=01\nby=11\n", sg[0..sn]))) { good = good + 1; }
    if (say("signature fails under another public key", !ks_verify(opub[0..65], msg, sg[0..sn]))) { good = good + 1; }
    sg[sn - 1] = sg[sn - 1] ^ 1;
    if (say("a damaged signature fails", !ks_verify(gpub[0..65], msg, sg[0..sn]))) { good = good + 1; }
    if (good == 11) { sys_write(1, "keysync-smoke: 11/11\n", 21); sys_exit(0); }
    sys_write(1, "keysync-smoke: FAILED\n", 22);
    sys_exit(1);
}

test the_smoke_module_is_declared {
    var b : [4]u8 = undefined;
    b[0] = 1;
    assert b[0] == 1;
}
