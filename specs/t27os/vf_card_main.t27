// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_card_main.t27 -- host program: viewable frames of the T27F task card in the t27.ai look (Refs gHashTag/t27#13214,
; T27F-007). It lays the task card out at FRAME_W design pixels wide (default 375; 768 and 1280 are the other two widths), paints it
; with vf_card (theme tokens from vf_theme, Outfit labels from vf_type, antialiased area-coverage fills) at FRAME_PCT percent
; (50..400, default 100) in the theme FRAME_THEME (0 = t27 black, 1 = paper, default 0), and writes the raster as a binary PPM P6
; (15 header bytes below 1000 wide, 16 from 1000, then W * H * 3 RGB bytes) to FRAME_OUT. It prints the meaning of every node
; (vf_meaning) to stderr, as vf_frame_main does, so a human can compare the frame with the lines.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. The tests below pin bytes of the PPM (a header, the background corner, ink inside the title
; node); they do not say the frame looks right. "The card looks right" and "the type is not pixelated" start only when somebody has
; opened the frame. vf_layout returns the same rectangles at 375, 768 and 1280, so the three frames differ only in raster width.
; --
; BUILD AND RUN (a heavy build: on the lab or in a T27 OS pane, not on the Mac without the owner's word):
;   t27c gen specs/t27os/vf_card_main.t27 > vf_card.zig
;   zig build-exe vf_card.zig -lc
;   FRAME_W=768 FRAME_PCT=200 FRAME_THEME=0 FRAME_OUT=target/vf_card_768.ppm ./vf_card 2> target/vf_card_768.txt
;   ffmpeg -y -i target/vf_card_768.ppm target/vf_card_768.png
; FRAME_OUT defaults to target/vf_card.ppm, a path under the working directory (target/ is gitignored), never /tmp. The raster is
; capped at 2073600 pixels (frame_render's cap): 1280 wide at 300 or 400 percent is refused. An unopenable FRAME_OUT or a short
; write exits 2; a render refusal (a scale outside 50..400, a theme other than 0 or 1, a raster past the cap) exits 1.
; --
; Module-level vars are never spliced by `use`, so the two byte buffers live here and are passed to vf_card as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfCardMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_px_card;
use t27f::vf_card::vc_render;
use t27f::vf_card::VC_OK;
use t27f::vf_scale::vf_s_size;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_relation_word;
use t27f::vf_meaning::vf_primary_action;

; sized to the frame_render pixel cap, 2073600 pixels: 6220800 RGB bytes plus the 16 header bytes
pub var VCM_RGB : [6220800]u8 = [0] ** 6220800;
pub var VCM_PPM : [6220816]u8 = [0] ** 6220816;

pub const VCM_H : u32 = 192;

/// Render the task card at w design pixels, pct percent, in theme; the vc_render code (0 is ok), then the PPM into VCM_PPM.
pub fn vcm_render(w: u32, pct: u32, theme: u32) -> u32 {
    const g : VfGraph = vf_px_card(w);
    const l : VfLayout = vf_layout(g);
    const ow : u32 = vf_s_size(w, pct);
    const oh : u32 = vf_s_size(VCM_H, pct);
    const r : u32 = vc_render(g, l, &VCM_RGB, ow, oh, pct, theme);
    if r != VC_OK {
        return r;
    }
    return ppm_write_into(&VCM_PPM, &VCM_RGB, ow, oh) as u32;
}

pub fn main() void {
    var width : u32 = 375;
    const qw = std.c.getenv("FRAME_W");
    if (qw != null) {
        const sp = qw.?;
        var wv : u32 = 0;
        var k : usize = 0;
        while (sp[k] != 0 and wv <= 4096) {
            if (sp[k] >= 48 and sp[k] <= 57) { wv = wv * 10 + ((sp[k] - 48) as u32); }
            k += 1;
        }
        if (wv > 0) { width = wv; }
    }
    var pct : u32 = 100;
    const qs = std.c.getenv("FRAME_PCT");
    if (qs != null) {
        const ps = qs.?;
        var pv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and pv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { pv = pv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        if (pv > 0) { pct = pv; }
    }
    var theme : u32 = 0;
    const qt = std.c.getenv("FRAME_THEME");
    if (qt != null) {
        const ts = qt.?;
        if (ts[0] == 49) { theme = 1; }
    }
    const out_w : u32 = vf_s_size(width, pct);
    const out_h : u32 = vf_s_size(VCM_H, pct);
    const rr : u32 = vcm_render(width, pct, theme);
    if (rr != VC_OK) {
        std.debug.print("vf_card: render refused at width {d} scale {d} theme {d}, code {d}\n", .{ width, pct, theme, rr });
        std.c.exit(1);
    }
    const nbytes : usize = ppm_len(out_w, out_h) as usize;
    var path : [*:0]const u8 = "target/vf_card.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("vf_card: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    const w : usize = std.c.fwrite(@ptrCast(&VCM_PPM), 1, nbytes, fp.?);
    _ = std.c.fclose(fp.?);
    if (w != nbytes) {
        std.debug.print("vf_card: short write to {s}: {d} of {d} bytes\n", .{ path, w, nbytes });
        std.c.exit(2);
    }
    std.debug.print("vf_card: wrote {d} bytes to {s} ({d}x{d}, P6, design width {d}, scale {d} percent, theme {d})\n", .{ nbytes, path, out_w, out_h, width, pct, theme });
    const g : VfGraph = vf_px_card(width);
    const l : VfLayout = vf_layout(g);
    std.debug.print("meaning: node kind depth relation gap x y w h text\n", .{});
    var i : u32 = 0;
    while (i < l.node_count) {
        std.debug.print("  {d} {s} depth {d} {s} gap {d} at {d},{d} size {d}x{d} [{s}]\n", .{ i, vf_kind_word(g, i), vf_depth(g, i), vf_relation_word(vf_relation(g, l, i)), vf_gap(g, l, i), l.x[i], l.y[i], l.w[i], l.h[i], g.text[i] });
        i += 1;
    }
    std.debug.print("primary action: node {d}\n", .{vf_primary_action(g)});
    std.debug.print("vf_card: a byte-level frame; open it and compare with the lines above before saying it looks right\n", .{});
}

test the_375_card_is_a_375_by_192_p6_frame {
    assert vcm_render(375, 100, 0) == 0;
    const want : []const u8 = "P6\n375 192\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert VCM_PPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(375, 192) == 216015;
}

test the_corner_is_the_theme_background_and_papers_differs {
    assert vcm_render(375, 100, 0) == 0;
    const dark : u32 = VCM_PPM[15 + (191 * 375 + 374) * 3] as u32;
    assert vcm_render(375, 100, 1) == 0;
    const light : u32 = VCM_PPM[15 + (191 * 375 + 374) * 3] as u32;
    assert dark < 128;
    assert light > 128;
}

test the_title_node_carries_ink_at_200_percent {
    assert vcm_render(375, 200, 0) == 0;
    const g : VfGraph = vf_px_card(375);
    const l : VfLayout = vf_layout(g);
    const ow : u32 = vf_s_size(375, 200);
    var best : u32 = 0;
    var y : u32 = l.y[1] * 2;
    while (y < (l.y[1] + l.h[1]) * 2) {
        var x : u32 = l.x[1] * 2;
        while (x < (l.x[1] + l.w[1]) * 2) {
            const at : usize = (16 + (y * ow + x) * 3) as usize;
            if (VCM_PPM[at] as u32 > best) { best = VCM_PPM[at] as u32; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert best > 150;
}

test a_scale_outside_50_to_400_and_a_bad_theme_are_refused {
    assert vcm_render(375, 49, 0) != 0;
    assert vcm_render(375, 401, 0) != 0;
    assert vcm_render(375, 100, 2) != 0;
    assert vcm_render(1280, 400, 0) != 0;
    assert vcm_render(1280, 200, 0) == 0;
}
