// SPDX-License-Identifier: Apache-2.0
// specs/t27os/web3_wallet.t27 -- T27 OS: sign in with a local web3 wallet
// (Sign-In with Ethereum, verified on the home).
// Part of M1 (milestone #5). Closes #13331.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::web3_wallet;

pub struct Web3Wallet { signed_in: bool, verified: bool };

pub fn web3_wallet_signed_in(w: Web3Wallet) -> bool {
    return w.signed_in && w.verified;
}

test "web3 wallet signed in" {
    assert(web3_wallet_signed_in(Web3Wallet { signed_in: true, verified: true }));
    assert(!web3_wallet_signed_in(Web3Wallet { signed_in: true, verified: false }));
}