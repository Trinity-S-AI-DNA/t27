// SPDX-License-Identifier: Apache-2.0
; specs/t27os/release.t27 -- how T27 OS is versioned, released and updated (gHashTag/t27#11315, FR-003 and FR-004;
; part of the T27 OS epic #11037). Owner, 2026-10-20: bring T27 OS to a release.
; --
; WHAT IS DECIDED HERE (every rule has a test below):
; - The version: semver from the constants VERSION_MAJOR/MINOR/PATCH; the build number is the commit count
;   (`git rev-list --count HEAD`), written into the bundle as CFBundleVersion by install.t27 plist_text.
; - The tags (gHashTag/t27#11403): a T27 OS release is tagged t27os-v<semver>-b<build>; v0.1.0 is GoldenFloat's.
;   The app polls ONE fixed address, the manifest asset of the release named exactly t27os-latest, whose
;   assets are replaced on every publish (`gh release upload --clobber`); that works across mixed tags, which
;   releases/latest/download does not. The manifest names the versioned release for every file it points to.
; - The release manifest, in OUR language (own-language-first): a .t27 module text, not JSON. The app reads
;   the constants of it that this file names and nothing else. manifest_from_sums writes it from the sums file
;   the publish step makes, manifest_check judges a text the app downloaded.
; - The update rule (owner, 2026-10-20: updates install on every computer on the fly, online): the app looks
;   at the manifest at launch and every UPD_POLL_S (10 minutes); a newer build is downloaded into
;   ~/.t27os/updates/<build>/ and verified at once; it is SWAPPED IN only when no pane is busy (and has been
;   quiet for SWAP_QUIET_S, or the Update-now control was pressed). The swap moves the running bundle to
;   ~/.t27os/updates/previous (the one kept), installs the toolchain in ~/.t27os/bin, restarts the pane server
;   through launchd when its own build changed, and touches the executable so hot_reload.t27 relaunches.
;   A start that does not live CONFIRM_AFTER_S seconds is rolled back by the next start, which refuses it.
; - The toolchain (owner, 2026-10-20): every release also ships arm64 t27b, t27c and tri built from the same
;   commit. They are installed only when each one's `--version` names the manifest's COMMIT.
; - The pane server lives under launchd (label SERVER_LABEL): a process that is a child of the app or of a
;   shell dies with its terminal (measured on this Mac), a launchctl-submitted one survives.
; - The release steps as a plan (`tri t27os release --plan`) and the publish script (`tri t27os publish --yes`).
; --
; WHAT IS NOT HERE: the posix_spawn of sh and the file reads; they are host calls (glass_window.t27 tg_spawn)
; and take these rules as their answers. Every shell command the host runs is TEXT made here and tested.
; Trust: the sha256 in the manifest proves a file is the one the manifest names, not who wrote the manifest;
; both come from the same https address on github.com/gHashTag/t27/releases, which url_ok enforces, and the
; unzipped bundle must still pass `codesign -v`. A Developer ID signature is the owner's step.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osRelease;

use claw::text;

// ---------------------------------------------------------------- the version

pub const VERSION_MAJOR : u32 = 0;
pub const VERSION_MINOR : u32 = 1;
pub const VERSION_PATCH : u32 = 1;

/// The packed value of "no version": a text that is not a semver.
pub const NO_VERSION : u64 = 18446744073709551615;

/// Each part is at most 6 digits and is packed in 20 bits, so a packed version compares as a semver does.
pub const PART_MAX : u32 = 999999;

pub fn pack_version(major : u32, minor : u32, patch : u32) -> u64 {
    return ((major as u64) << 40) | ((minor as u64) << 20) | (patch as u64);
}

/// The version this source tree builds.
pub fn current_version() -> u64 {
    return pack_version(VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH);
}

pub fn version_major(v : u64) -> u32 { return ((v >> 40) & 1048575) as u32; }
pub fn version_minor(v : u64) -> u32 { return ((v >> 20) & 1048575) as u32; }
pub fn version_patch(v : u64) -> u32 { return (v & 1048575) as u32; }

/// Writes v in decimal at w, clipped at cap; the new cursor. (No scratch array: the digits are written
/// from the most significant one by dividing, so the generated Rust needs no initializer.)
pub fn put_number(out : []u8, cap : usize, w : usize, v : u32) -> usize {
    var scale : u32 = 1;
    while (v / scale >= 10) { scale = scale * 10; }
    var k : usize = w;
    var rest : u32 = v;
    while (scale > 0) {
        const d : u32 = rest / scale;
        if (k < cap) { out[k] = (48 + d) as u8; }
        k += 1;
        rest = rest - d * scale;
        scale = scale / 10;
    }
    return k;
}

/// Writes "major.minor.patch" at w, clipped at cap; the new cursor.
pub fn put_semver(out : []u8, cap : usize, w : usize, v : u64) -> usize {
    var k : usize = put_number(out, cap, w, version_major(v));
    k = put_str(out, cap, k, ".", 1);
    k = put_number(out, cap, k, version_minor(v));
    k = put_str(out, cap, k, ".", 1);
    return put_number(out, cap, k, version_patch(v));
}

/// Reads one part of a semver: digits, no leading zero unless the part is "0", at most 6 digits. The part
/// goes to the high half of the result; the cursor after it goes to the low half. A bad part is NO_VERSION.
pub fn read_part(t : []const u8, n : usize, at : usize) -> u64 {
    if (at >= n) { return NO_VERSION; }
    var i : usize = at;
    var v : u32 = 0;
    while (i < n and t[i] >= '0' and t[i] <= '9') {
        if (i - at >= 6) { return NO_VERSION; }
        v = v * 10 + ((t[i] - '0') as u32);
        i += 1;
    }
    if (i == at) { return NO_VERSION; }
    if (t[at] == '0' and i - at > 1) { return NO_VERSION; }
    return ((v as u64) << 32) | (i as u64);
}

/// "a.b.c" to a packed version; NO_VERSION for anything else (a prefix, a suffix, a missing part).
pub fn semver_parse(t : []const u8, n : usize) -> u64 {
    var a : u64 = read_part(t, n, 0);
    if (a == NO_VERSION) { return NO_VERSION; }
    var p : usize = (a & 4294967295) as usize;
    if (p >= n or t[p] != '.') { return NO_VERSION; }
    var b : u64 = read_part(t, n, p + 1);
    if (b == NO_VERSION) { return NO_VERSION; }
    p = (b & 4294967295) as usize;
    if (p >= n or t[p] != '.') { return NO_VERSION; }
    var c : u64 = read_part(t, n, p + 1);
    if (c == NO_VERSION) { return NO_VERSION; }
    p = (c & 4294967295) as usize;
    if (p != n) { return NO_VERSION; }
    return pack_version((a >> 32) as u32, (b >> 32) as u32, (c >> 32) as u32);
}

/// The candidate is an update only if both are versions and the candidate is strictly newer.
pub fn is_newer(candidate : u64, current : u64) -> bool {
    if (candidate == NO_VERSION or current == NO_VERSION) { return false; }
    return candidate > current;
}

// ---------------------------------------------------------------- tags and addresses

/// A release is tagged t27os-v<semver>-b<build> (#11403); v0.1.0 and its kin are GoldenFloat's.
pub const TAG_PREFIX : str = "t27os-v";
/// The release whose assets are replaced on every publish: the one fixed address the app polls.
pub const LATEST_TAG : str = "t27os-latest";
pub const MANIFEST_ASSET : str = "t27os-release.t27";
pub const MANIFEST_URL : str = "https://github.com/gHashTag/t27/releases/download/t27os-latest/t27os-release.t27";
/// Every address the manifest names (the zip, the notes) starts with this.
pub const URL_PREFIX : str = "https://github.com/gHashTag/t27/releases/";
pub const URL_PREFIX_LEN : usize = 41;
/// The toolchain assets of a release (Apple silicon), and the pane server inside the zip.
pub const A_T27B : str = "t27b-darwin-arm64";
pub const A_T27C : str = "t27c-darwin-arm64";
pub const A_TRI : str = "tri-darwin-arm64";
pub const A_PTY : str = "t27os-pty";

/// The manifest's lines the app reads, up to the value.
pub const KEY_VERSION : str = "pub const VERSION : str = ";
pub const KEY_BUILD : str = "pub const BUILD : u32 = ";
pub const KEY_SHA : str = "pub const SHA256 : str = ";
pub const KEY_MIN : str = "pub const MIN_MACOS : str = ";
pub const KEY_URL : str = "pub const URL : str = ";
pub const KEY_NOTES : str = "pub const NOTES : str = ";
pub const KEY_COMMIT : str = "pub const COMMIT : str = ";
pub const KEY_T27B : str = "pub const T27B_SHA256 : str = ";
pub const KEY_T27C : str = "pub const T27C_SHA256 : str = ";
pub const KEY_TRI : str = "pub const TRI_SHA256 : str = ";
pub const KEY_PTY : str = "pub const PTY_SHA256 : str = ";

/// manifest_check results; the first failure in this order.
pub const M_OK : u8 = 0;
pub const M_NO_VERSION : u8 = 1;
pub const M_NO_BUILD : u8 = 2;
pub const M_BAD_SHA : u8 = 3;
pub const M_BAD_MIN : u8 = 4;
pub const M_BAD_URL : u8 = 5;
pub const M_BAD_NOTES : u8 = 6;
pub const M_BAD_COMMIT : u8 = 7;
pub const M_BAD_TOOL : u8 = 8;

/// A field not found, as the packed (start, length) pair.
pub const NO_FIELD : u64 = 18446744073709551615;

fn rl_put(out : []u8, cap : usize, w : usize, s : str) -> usize {
    return put_str(out, cap, w, s, s.len);
}

fn at_line_start(t : []const u8, i : usize) -> bool {
    if (i == 0) { return true; }
    return t[i - 1] == 10;
}

fn starts_here(t : []const u8, n : usize, at : usize, key : str, key_len : usize) -> bool {
    if (at + key_len > n) { return false; }
    var j : usize = 0;
    while (j < key_len) {
        if (t[at + j] != key[j]) { return false; }
        j += 1;
    }
    return true;
}

/// A string field: the line `<key>"value";`. The result is (start of value << 32) | length of value, or
/// NO_FIELD when no line starts with the key, the value is not quoted, or it has no closing quote on its line.
pub fn field_str(t : []const u8, n : usize, key : str, key_len : usize) -> u64 {
    var i : usize = 0;
    while (i < n) {
        if (at_line_start(t, i) and starts_here(t, n, i, key, key_len)) {
            const q : usize = i + key_len;
            if (q >= n or t[q] != 34) { return NO_FIELD; }
            var e : usize = q + 1;
            while (e < n and t[e] != 34 and t[e] != 10) { e += 1; }
            if (e >= n or t[e] != 34) { return NO_FIELD; }
            return (((q + 1) as u64) << 32) | ((e - q - 1) as u64);
        }
        i += 1;
    }
    return NO_FIELD;
}

/// A number field: the line `<key>digits;`. The number, or NO_FIELD (no digits, more than 9, no line).
pub fn field_num(t : []const u8, n : usize, key : str, key_len : usize) -> u64 {
    var i : usize = 0;
    while (i < n) {
        if (at_line_start(t, i) and starts_here(t, n, i, key, key_len)) {
            var e : usize = i + key_len;
            var v : u64 = 0;
            while (e < n and t[e] >= '0' and t[e] <= '9') {
                if (e - (i + key_len) >= 9) { return NO_FIELD; }
                v = v * 10 + ((t[e] - '0') as u64);
                e += 1;
            }
            if (e == i + key_len) { return NO_FIELD; }
            return v;
        }
        i += 1;
    }
    return NO_FIELD;
}

pub fn field_start(f : u64) -> usize { return (f >> 32) as usize; }
pub fn field_len(f : u64) -> usize { return (f & 4294967295) as usize; }

/// n lowercase hex digits at t[at ..].
fn rl_hex_run(t : []const u8, at : usize, n : usize) -> bool {
    var i : usize = 0;
    while (i < n) {
        const c : u8 = t[at + i];
        if (!((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f'))) { return false; }
        i += 1;
    }
    return true;
}

/// 64 lowercase hex digits.
pub fn sha_ok(t : []const u8, n : usize) -> bool {
    if (n != 64) { return false; }
    return rl_hex_run(t, 0, 64);
}

/// A commit: 40 lowercase hex digits.
pub fn commit_ok(t : []const u8, n : usize) -> bool {
    if (n != 40) { return false; }
    return rl_hex_run(t, 0, 40);
}

/// An address the app may fetch: https on github.com/gHashTag/t27/releases/, with something after it and no space.
pub fn url_ok(t : []const u8, n : usize) -> bool {
    if (n <= URL_PREFIX_LEN) { return false; }
    if (!starts_here(t, n, 0, URL_PREFIX, URL_PREFIX_LEN)) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (t[i] <= 32 or t[i] == 34 or t[i] == 39 or t[i] == 92 or t[i] > 126) { return false; }
        i += 1;
    }
    return true;
}

/// "major.minor" or "major": a macOS version, packed as major * 1000 + minor; 4294967295 for anything else.
pub fn macos_parse(t : []const u8, n : usize) -> u32 {
    var a : u64 = read_part(t, n, 0);
    if (a == NO_VERSION) { return 4294967295; }
    const major : u32 = (a >> 32) as u32;
    var p : usize = (a & 4294967295) as usize;
    if (p == n) { return major * 1000; }
    if (t[p] != '.') { return 4294967295; }
    var b : u64 = read_part(t, n, p + 1);
    if (b == NO_VERSION) { return 4294967295; }
    p = (b & 4294967295) as usize;
    if (p != n) { return 4294967295; }
    return major * 1000 + ((b >> 32) as u32);
}

/// Does this Mac meet the manifest's minimum? host is major * 1000 + minor.
pub fn macos_meets(min_text : []const u8, n : usize, host : u32) -> bool {
    const m : u32 = macos_parse(min_text, n);
    if (m == 4294967295) { return false; }
    return host >= m;
}

fn rl_line(out : []u8, cap : usize, w : usize, s : str) -> usize {
    var k : usize = put_str(out, cap, w, s, s.len);
    if (k < cap) { out[k] = 10; }
    return k + 1;
}

fn put_slice(out : []u8, cap : usize, w : usize, b : []const u8, b_len : usize) -> usize {
    var i : usize = 0;
    while (i < b_len) {
        if (w + i < cap) { out[w + i] = b[i]; }
        i += 1;
    }
    return w + b_len;
}

/// The release tag, t27os-v<semver>-b<build>.
pub fn put_tag(out : []u8, cap : usize, w : usize, v : u64, build : u32) -> usize {
    const k : usize = put_tag_head(out, cap, w, v);
    return put_number(out, cap, k, build);
}

/// The tag up to the build number: t27os-v<semver>-b
pub fn put_tag_head(out : []u8, cap : usize, w : usize, v : u64) -> usize {
    var k : usize = rl_put(out, cap, w, TAG_PREFIX);
    k = put_semver(out, cap, k, v);
    return rl_put(out, cap, k, "-b");
}

/// The zip's file name, T27OS-<semver>.zip.
pub fn put_zip_name(out : []u8, cap : usize, w : usize, v : u64) -> usize {
    var k : usize = rl_put(out, cap, w, "T27OS-");
    k = put_semver(out, cap, k, v);
    return rl_put(out, cap, k, ".zip");
}

/// Where every file of one release is downloaded from: <releases>/download/<tag>/
pub fn put_base(out : []u8, cap : usize, w : usize, v : u64, build : u32) -> usize {
    var k : usize = rl_put(out, cap, w, URL_PREFIX);
    k = rl_put(out, cap, k, "download/");
    k = put_tag(out, cap, k, v, build);
    return rl_put(out, cap, k, "/");
}

/// The zip's address, and the notes' address (the release page).
pub fn put_zip_url(out : []u8, cap : usize, w : usize, v : u64, build : u32) -> usize {
    const k : usize = put_base(out, cap, w, v, build);
    return put_zip_name(out, cap, k, v);
}

pub fn put_notes_url(out : []u8, cap : usize, w : usize, v : u64, build : u32) -> usize {
    var k : usize = rl_put(out, cap, w, URL_PREFIX);
    k = rl_put(out, cap, k, "tag/");
    return put_tag(out, cap, k, v, build);
}

// ---------------------------------------------------------------- the manifest

/// A decimal number of at most 9 digits at t[at ..], no leading zero: the position after it, or NO_FIELD when
/// it is not exactly want.
fn rl_eat_num(t : []const u8, e : usize, at : usize, want : u32) -> u64 {
    var i : usize = at;
    var v : u32 = 0;
    while (i < e and t[i] >= '0' and t[i] <= '9' and i - at < 9) {
        v = v * 10 + ((t[i] - '0') as u32);
        i += 1;
    }
    if (i == at or v != want or (t[at] == '0' and i - at > 1)) { return NO_FIELD; }
    return i as u64;
}

/// A semver at t[at ..] that is exactly v: the position after it, or NO_FIELD.
fn rl_eat_semver(t : []const u8, e : usize, at : usize, v : u64) -> u64 {
    var p : usize = at;
    var part : u32 = 0;
    while (part < 3) {
        const r : u64 = read_part(t, e, p);
        if (r == NO_VERSION) { return NO_FIELD; }
        var want : u32 = version_major(v);
        if (part == 1) { want = version_minor(v); }
        if (part == 2) { want = version_patch(v); }
        if ((r >> 32) as u32 != want) { return NO_FIELD; }
        p = (r & 4294967295) as usize;
        if (part < 2) {
            if (p >= e or t[p] != '.') { return NO_FIELD; }
            p += 1;
        }
        part += 1;
    }
    return p as u64;
}

/// Does the field f of t read exactly the address put_zip_url (notes = false) or put_notes_url (notes = true)
/// would write for this version and build? No buffer: the text is compared piece by piece.
pub fn url_is_expected(t : []const u8, f : u64, v : u64, build : u32, notes : bool) -> bool {
    const e : usize = field_start(f) + field_len(f);
    var p : usize = field_start(f);
    if (!starts_here(t, e, p, URL_PREFIX, URL_PREFIX_LEN)) { return false; }
    p += URL_PREFIX_LEN;
    if (notes) {
        if (!starts_here(t, e, p, "tag/", 4)) { return false; }
        p += 4;
    } else {
        if (!starts_here(t, e, p, "download/", 9)) { return false; }
        p += 9;
    }
    if (!starts_here(t, e, p, TAG_PREFIX, TAG_PREFIX.len)) { return false; }
    p += TAG_PREFIX.len;
    var q : u64 = rl_eat_semver(t, e, p, v);
    if (q == NO_FIELD) { return false; }
    p = q as usize;
    if (!starts_here(t, e, p, "-b", 2)) { return false; }
    q = rl_eat_num(t, e, p + 2, build);
    if (q == NO_FIELD) { return false; }
    p = q as usize;
    if (notes) { return p == e; }
    if (!starts_here(t, e, p, "/T27OS-", 7)) { return false; }
    q = rl_eat_semver(t, e, p + 7, v);
    if (q == NO_FIELD) { return false; }
    p = q as usize;
    if (!starts_here(t, e, p, ".zip", 4)) { return false; }
    return p + 4 == e;
}

fn rl_hash_field(t : []const u8, n : usize, key : str) -> bool {
    const f : u64 = field_str(t, n, key, key.len);
    if (f == NO_FIELD) { return false; }
    return sha_ok(t[field_start(f)..field_start(f) + field_len(f)], field_len(f));
}

/// The version a manifest names (NO_VERSION when it names none) and its build (NO_FIELD when none).
pub fn manifest_version(t : []const u8, n : usize) -> u64 {
    const v : u64 = field_str(t, n, KEY_VERSION, KEY_VERSION.len);
    if (v == NO_FIELD) { return NO_VERSION; }
    return semver_parse(t[field_start(v)..field_start(v) + field_len(v)], field_len(v));
}

pub fn manifest_build(t : []const u8, n : usize) -> u64 {
    return field_num(t, n, KEY_BUILD, KEY_BUILD.len);
}

/// The first thing wrong with a manifest text the app downloaded, or M_OK.
pub fn manifest_check(t : []const u8, n : usize) -> u8 {
    const ver : u64 = manifest_version(t, n);
    if (ver == NO_VERSION) { return M_NO_VERSION; }
    const bd : u64 = manifest_build(t, n);
    if (bd == NO_FIELD) { return M_NO_BUILD; }
    if (!rl_hash_field(t, n, KEY_SHA)) { return M_BAD_SHA; }
    const m : u64 = field_str(t, n, KEY_MIN, KEY_MIN.len);
    if (m == NO_FIELD) { return M_BAD_MIN; }
    if (macos_parse(t[field_start(m)..field_start(m) + field_len(m)], field_len(m)) == 4294967295) { return M_BAD_MIN; }
    const u : u64 = field_str(t, n, KEY_URL, KEY_URL.len);
    if (u == NO_FIELD) { return M_BAD_URL; }
    if (!url_ok(t[field_start(u)..field_start(u) + field_len(u)], field_len(u))) { return M_BAD_URL; }
    if (!url_is_expected(t, u, ver, bd as u32, false)) { return M_BAD_URL; }
    const w : u64 = field_str(t, n, KEY_NOTES, KEY_NOTES.len);
    if (w == NO_FIELD) { return M_BAD_NOTES; }
    if (!url_ok(t[field_start(w)..field_start(w) + field_len(w)], field_len(w))) { return M_BAD_NOTES; }
    if (!url_is_expected(t, w, ver, bd as u32, true)) { return M_BAD_NOTES; }
    const c : u64 = field_str(t, n, KEY_COMMIT, KEY_COMMIT.len);
    if (c == NO_FIELD) { return M_BAD_COMMIT; }
    if (!commit_ok(t[field_start(c)..field_start(c) + field_len(c)], field_len(c))) { return M_BAD_COMMIT; }
    if (!rl_hash_field(t, n, KEY_T27B) or !rl_hash_field(t, n, KEY_T27C) or !rl_hash_field(t, n, KEY_TRI) or !rl_hash_field(t, n, KEY_PTY)) { return M_BAD_TOOL; }
    return M_OK;
}

// ---------------------------------------------------------------- the sums file

/// The sums file the publish step writes and the app computes after a download: an optional first line
/// `COMMIT <40 hex>`, then one `shasum -a 256` line per file: 64 hex, two spaces, the file name.
/// The start of the 64 hex digits of the row named name, or NO_FIELD.
pub fn sums_row(t : []const u8, n : usize, name : str) -> u64 {
    var i : usize = 0;
    while (i + 66 + name.len <= n) {
        if (at_line_start(t, i) and t[i + 64] == 32 and t[i + 65] == 32 and rl_hex_run(t, i, 64)) {
            var j : usize = 0;
            while (j < name.len and t[i + 66 + j] == name[j]) { j += 1; }
            const e : usize = i + 66 + name.len;
            if (j == name.len and (e == n or t[e] == 10)) { return i as u64; }
        }
        i += 1;
    }
    return NO_FIELD;
}

/// The same for the row of the zip of version v: T27OS-<semver>.zip.
pub fn sums_row_zip(t : []const u8, n : usize, v : u64) -> u64 {
    var i : usize = 0;
    while (i + 66 + 6 + 4 <= n) {
        if (at_line_start(t, i) and t[i + 64] == 32 and t[i + 65] == 32 and rl_hex_run(t, i, 64) and starts_here(t, n, i + 66, "T27OS-", 6)) {
            var e : usize = i + 66;
            while (e < n and t[e] != 10) { e += 1; }
            if (e - (i + 66) > 10 and starts_here(t, n, e - 4, ".zip", 4) and rl_eat_semver(t, e - 4, i + 72, v) == ((e - 4) as u64)) { return i as u64; }
        }
        i += 1;
    }
    return NO_FIELD;
}

/// Row k of a release: 0 the zip, 1 t27b, 2 t27c, 3 tri, 4 the pane server.
pub fn rl_row(t : []const u8, n : usize, v : u64, k : u32) -> u64 {
    if (k == 0) { return sums_row_zip(t, n, v); }
    if (k == 1) { return sums_row(t, n, A_T27B); }
    if (k == 2) { return sums_row(t, n, A_T27C); }
    if (k == 3) { return sums_row(t, n, A_TRI); }
    return sums_row(t, n, A_PTY);
}

fn rl_row_key(k : u32) -> str {
    if (k == 0) { return KEY_SHA; }
    if (k == 1) { return KEY_T27B; }
    if (k == 2) { return KEY_T27C; }
    if (k == 3) { return KEY_TRI; }
    return KEY_PTY;
}

/// The start of the commit of the `COMMIT <40 hex>` line, or NO_FIELD.
pub fn sums_commit(t : []const u8, n : usize) -> u64 {
    var i : usize = 0;
    while (i + 47 <= n) {
        if (at_line_start(t, i) and starts_here(t, n, i, "COMMIT ", 7) and rl_hex_run(t, i + 7, 40) and (i + 47 == n or t[i + 47] == 10)) { return (i + 7) as u64; }
        i += 1;
    }
    return NO_FIELD;
}

fn rl_sha_line(out : []u8, cap : usize, w : usize, key : str, sums : []const u8, at : u64) -> usize {
    var k : usize = rl_put(out, cap, w, key);
    k = rl_put(out, cap, k, "\"");
    const a : usize = at as usize;
    k = put_slice(out, cap, k, sums[a..a + 64], 64);
    return rl_line(out, cap, k, "\";");
}

/// The manifest of a release, a t27 module, from the sums file. The length written (a result above cap means
/// it was clipped), or 0 when the sums lack a row or the commit.
pub fn manifest_from_sums(out : []u8, cap : usize, v : u64, build : u32, sums : []const u8, sn : usize) -> usize {
    const rz : u64 = rl_row(sums, sn, v, 0);
    const rb : u64 = rl_row(sums, sn, v, 1);
    const rc : u64 = rl_row(sums, sn, v, 2);
    const rt : u64 = rl_row(sums, sn, v, 3);
    const rp : u64 = rl_row(sums, sn, v, 4);
    const cm : u64 = sums_commit(sums, sn);
    if (rz == NO_FIELD or rb == NO_FIELD or rc == NO_FIELD or rt == NO_FIELD or rp == NO_FIELD or cm == NO_FIELD) { return 0; }
    var w : usize = 0;
    w = rl_line(out, cap, w, "; T27 OS release manifest, written by specs/t27os/release.t27 manifest_from_sums. The app reads the");
    w = rl_line(out, cap, w, "; constants below and nothing else.");
    w = rl_line(out, cap, w, "module T27osReleaseManifest;");
    w = rl_put(out, cap, w, KEY_VERSION);
    w = rl_put(out, cap, w, "\"");
    w = put_semver(out, cap, w, v);
    w = rl_line(out, cap, w, "\";");
    w = rl_put(out, cap, w, KEY_BUILD);
    w = put_number(out, cap, w, build);
    w = rl_line(out, cap, w, ";");
    w = rl_sha_line(out, cap, w, KEY_SHA, sums, rz);
    w = rl_put(out, cap, w, KEY_MIN);
    w = rl_line(out, cap, w, "\"11.0\";");
    w = rl_put(out, cap, w, KEY_URL);
    w = rl_put(out, cap, w, "\"");
    w = put_zip_url(out, cap, w, v, build);
    w = rl_line(out, cap, w, "\";");
    w = rl_put(out, cap, w, KEY_NOTES);
    w = rl_put(out, cap, w, "\"");
    w = put_notes_url(out, cap, w, v, build);
    w = rl_line(out, cap, w, "\";");
    w = rl_put(out, cap, w, KEY_COMMIT);
    w = rl_put(out, cap, w, "\"");
    const ca : usize = cm as usize;
    w = put_slice(out, cap, w, sums[ca..ca + 40], 40);
    w = rl_line(out, cap, w, "\";");
    w = rl_sha_line(out, cap, w, KEY_T27B, sums, rb);
    w = rl_sha_line(out, cap, w, KEY_T27C, sums, rc);
    w = rl_sha_line(out, cap, w, KEY_TRI, sums, rt);
    w = rl_sha_line(out, cap, w, KEY_PTY, sums, rp);
    return w;
}

/// Does the downloaded file carry the digest the manifest names? Both are 64 hex digits; a bad length is no.
pub fn sha_matches(computed : []const u8, computed_len : usize, wanted : []const u8, wanted_len : usize) -> bool {
    if (!sha_ok(computed, computed_len) or !sha_ok(wanted, wanted_len)) { return false; }
    var i : usize = 0;
    while (i < 64) {
        if (computed[i] != wanted[i]) { return false; }
        i += 1;
    }
    return true;
}

/// The rows of one release, in the order the app checks them: the zip, t27b, t27c, tri (after the download),
/// then the pane server (after the unzip).
pub const ROWS_DOWNLOADED : u32 = 4;
pub const ROWS_ALL : u32 = 5;

/// Rows first .. last-1 of the sums the app computed against the manifest. 0 when every one matches, else the
/// number (1 based) of the first row that does not: a missing row, a bad digest or a different digest.
pub fn sums_verdict(sums : []const u8, sn : usize, man : []const u8, mn : usize, first : u32, last : u32) -> u32 {
    const ver : u64 = manifest_version(man, mn);
    if (ver == NO_VERSION) { return first + 1; }
    var k : u32 = first;
    while (k < last) {
        const key : str = rl_row_key(k);
        const f : u64 = field_str(man, mn, key, key.len);
        const r : u64 = rl_row(sums, sn, ver, k);
        if (f == NO_FIELD or r == NO_FIELD) { return k + 1; }
        const a : usize = r as usize;
        if (!sha_matches(sums[a..a + 64], 64, man[field_start(f)..field_start(f) + field_len(f)], field_len(f))) { return k + 1; }
        k += 1;
    }
    return 0;
}

// ---------------------------------------------------------------- the toolchain

/// What `tri --version`, `t27c --version` and `t27b --version` print after their first line (which is the
/// tool's name and release, `t27c 0.5.2`, and stays what it was): `build <commit count> commit <sha>`.
pub fn version_text(out : []u8, cap : usize, name : str, ver : str, build : u32, commit : str) -> usize {
    var w : usize = rl_put(out, cap, 0, name);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, ver);
    w = rl_line(out, cap, w, "");
    w = rl_put(out, cap, w, "build ");
    w = put_number(out, cap, w, build);
    w = rl_put(out, cap, w, " commit ");
    w = rl_put(out, cap, w, commit);
    return rl_line(out, cap, w, "");
}

/// The word after " commit " in a --version output, as (start << 32) | length, or NO_FIELD.
pub fn version_commit(t : []const u8, n : usize) -> u64 {
    var i : usize = 0;
    while (i + 8 <= n) {
        if (starts_here(t, n, i, " commit ", 8)) {
            const s : usize = i + 8;
            var e : usize = s;
            while (e < n and t[e] > 32) { e += 1; }
            if (e == s) { return NO_FIELD; }
            return ((s as u64) << 32) | ((e - s) as u64);
        }
        i += 1;
    }
    return NO_FIELD;
}

pub const TV_OK : u8 = 0;
pub const TV_NO_COMMIT : u8 = 1;
pub const TV_DIFFERS : u8 = 2;

/// Does one tool's --version output name the commit the manifest names? A tool that prints no commit (an old
/// build, or "unknown") is TV_NO_COMMIT; a different commit is TV_DIFFERS. The word may be abbreviated to 7
/// or more digits and must be the start of the 40.
pub fn tool_verdict(vt : []const u8, n : usize, want : []const u8, want_n : usize) -> u8 {
    const f : u64 = version_commit(vt, n);
    if (f == NO_FIELD or !commit_ok(want, want_n)) { return TV_NO_COMMIT; }
    const s : usize = field_start(f);
    const l : usize = field_len(f);
    if (l < 7 or l > 40 or !rl_hex_run(vt, s, l)) { return TV_NO_COMMIT; }
    var i : usize = 0;
    while (i < l) {
        if (vt[s + i] != want[i]) { return TV_DIFFERS; }
        i += 1;
    }
    return TV_OK;
}

/// The worse of two verdicts (a differing commit is the worst).
pub fn tv_worse(a : u8, b : u8) -> u8 {
    if (a == TV_DIFFERS or b == TV_DIFFERS) { return TV_DIFFERS; }
    if (a == TV_NO_COMMIT or b == TV_NO_COMMIT) { return TV_NO_COMMIT; }
    return TV_OK;
}

pub const ID_INSTALL : u8 = 0;
pub const ID_REFUSE_SHA : u8 = 1;
pub const ID_REFUSE_COMMIT : u8 = 2;
pub const ID_REFUSE_NO_COMMIT : u8 = 3;
pub const ID_REFUSE_BUNDLE : u8 = 4;

/// Install the staged app and toolchain together or not at all. sums_bad is a sums_verdict (0 = every digest
/// matches), tools the worst tool_verdict, bundle_ok that the running app is a bundle this updater can replace.
pub fn install_decision(sums_bad : u32, tools : u8, bundle_ok : bool) -> u8 {
    if (sums_bad != 0) { return ID_REFUSE_SHA; }
    if (tools == TV_DIFFERS) { return ID_REFUSE_COMMIT; }
    if (tools == TV_NO_COMMIT) { return ID_REFUSE_NO_COMMIT; }
    if (!bundle_ok) { return ID_REFUSE_BUNDLE; }
    return ID_INSTALL;
}

// ---------------------------------------------------------------- the update rule

/// The app looks at the manifest at launch (no check yet) and every 10 minutes after the last one.
pub const UPD_POLL_S : u64 = 600;
/// A start that lives this long is a good build.
pub const CONFIRM_AFTER_S : u64 = 60;
/// A staged update is swapped in once no pane has been busy for this long (the Update-now control skips it).
pub const SWAP_QUIET_S : u64 = 60;

/// Is a check due? Seconds since the epoch. No check yet (0) is due; a clock that went back is due too, so a
/// wrong clock cannot silence updates for a day.
pub fn check_due(now : u64, last_check : u64) -> bool {
    if (last_check == 0) { return true; }
    if (now < last_check) { return true; }
    return now - last_check >= UPD_POLL_S;
}

/// Never swap while a pane is busy (working or blocked on you).
pub fn idle_enough(busy_panes : u32) -> bool {
    return busy_panes == 0;
}

/// A staged update is installed when no pane is busy and either the panes have rested for SWAP_QUIET_S or the
/// owner pressed Update now.
pub fn swap_ready(state : u8, busy_panes : u32, quiet_s : u64, pressed : bool) -> bool {
    if (state != U_STAGED or !idle_enough(busy_panes)) { return false; }
    return pressed or quiet_s >= SWAP_QUIET_S;
}

/// A candidate is newer by version, or by build at the same version. A version that does not read is never newer.
pub fn is_newer_build(cand_v : u64, cand_b : u32, cur_v : u64, cur_b : u32) -> bool {
    if (cand_v == NO_VERSION or cur_v == NO_VERSION) { return false; }
    if (cand_v != cur_v) { return cand_v > cur_v; }
    return cand_b > cur_b;
}

/// What the app does with a manifest.
pub const OFFER_NONE : u8 = 0;
pub const OFFER_UPDATE : u8 = 1;
pub const OFFER_BAD_MANIFEST : u8 = 2;
pub const OFFER_OLD_MACOS : u8 = 3;
pub const OFFER_REJECTED : u8 = 4;

/// First match wins: a manifest that fails manifest_check, a build that is not newer, a build a rollback put out
/// (rejected_b, 0 = none), a Mac below the minimum. Otherwise download.
pub fn offer(check : u8, cand_v : u64, cand_b : u32, cur_v : u64, cur_b : u32, rejected_b : u32, os_ok : bool) -> u8 {
    if (check != M_OK) { return OFFER_BAD_MANIFEST; }
    if (!is_newer_build(cand_v, cand_b, cur_v, cur_b)) { return OFFER_NONE; }
    if (rejected_b != 0 and cand_b == rejected_b) { return OFFER_REJECTED; }
    if (!os_ok) { return OFFER_OLD_MACOS; }
    return OFFER_UPDATE;
}

/// The update, one step at a time. A state is where the app is; an event is what just happened.
pub const U_IDLE : u8 = 0;
pub const U_CHECKING : u8 = 1;
pub const U_DOWNLOADING : u8 = 2;
pub const U_VERIFYING : u8 = 3;
pub const U_STAGED : u8 = 4;
pub const U_SWAPPED : u8 = 5;

pub const EV_CHECK : u8 = 0;
pub const EV_OFFER : u8 = 1;
pub const EV_NO_OFFER : u8 = 2;
pub const EV_DOWNLOADED : u8 = 3;
pub const EV_FAILED : u8 = 4;
pub const EV_SHA_OK : u8 = 5;
pub const EV_SHA_BAD : u8 = 6;
pub const EV_SIGNED : u8 = 7;
pub const EV_SWAP : u8 = 8;

/// The next state. Any failure falls back to idle (the next check is UPD_POLL_S away); a check starts from idle
/// whatever the panes do (it only fetches a small file); the swap only when they rest.
pub fn update_step(state : u8, event : u8, busy_panes : u32) -> u8 {
    if (event == EV_FAILED or event == EV_SHA_BAD or event == EV_NO_OFFER) { return U_IDLE; }
    if (state == U_IDLE and event == EV_CHECK) { return U_CHECKING; }
    if (state == U_CHECKING and event == EV_OFFER) { return U_DOWNLOADING; }
    if (state == U_DOWNLOADING and event == EV_DOWNLOADED) { return U_VERIFYING; }
    if (state == U_VERIFYING and event == EV_SHA_OK) { return U_VERIFYING; }
    if (state == U_VERIFYING and event == EV_SIGNED) { return U_STAGED; }
    if (state == U_STAGED and event == EV_SWAP) {
        if (idle_enough(busy_panes)) { return U_SWAPPED; }
        return U_STAGED;
    }
    return state;
}

// ---------------------------------------------------------------- rollback

/// The marker file ~/.t27os/updates/pending: the swap writes "1"; the new build's first start rewrites it to
/// "2" and removes it once it has lived CONFIRM_AFTER_S. A start that finds "2" therefore follows a build that
/// did not live that long.
pub const MK_NONE : u8 = 0;
pub const MK_SWAPPED : u8 = 1;
pub const MK_STARTED : u8 = 2;

/// The marker from the first byte of the file (0 bytes = no marker).
pub fn marker_of(has_byte : bool, b : u8) -> u8 {
    if (!has_byte) { return MK_NONE; }
    if (b == '1') { return MK_SWAPPED; }
    if (b == '2') { return MK_STARTED; }
    return MK_NONE;
}

pub const BOOT_RUN : u8 = 0;
pub const BOOT_ROLLBACK : u8 = 1;
pub const BOOT_BROKEN : u8 = 2;
pub const BOOT_FIRST : u8 = 3;

/// "swapped": this is the first start of the new build, mark it started. "started" and a previous bundle kept:
/// put it back. "started" and nothing to go back to: run on and report it (BOOT_BROKEN), do not loop.
pub fn boot_action(marker : u8, previous_kept : bool) -> u8 {
    if (marker == MK_NONE) { return BOOT_RUN; }
    if (marker == MK_SWAPPED) { return BOOT_FIRST; }
    if (previous_kept) { return BOOT_ROLLBACK; }
    return BOOT_BROKEN;
}

/// The running build is confirmed good once it has lived long enough; the marker is removed then.
pub fn confirm_due(uptime_s : u64) -> bool {
    return uptime_s >= CONFIRM_AFTER_S;
}

/// One previous bundle is kept: the swap replaces it, a rollback consumes it.
pub fn previous_after(swapped : bool, rolled_back : bool, previous_kept : bool) -> bool {
    if (rolled_back) { return false; }
    if (swapped) { return true; }
    return previous_kept;
}

/// The build a rollback refuses from then on: the one that was running when the marker was found.
pub fn rejected_after(boot : u8, running_b : u32, rejected_b : u32) -> u32 {
    if (boot == BOOT_ROLLBACK) { return running_b; }
    return rejected_b;
}

// ---------------------------------------------------------------- what the window shows

/// Why an update did not go on (shown in the window's foot); WHY_OFFLINE is silent.
pub const WHY_NONE : u8 = 0;
pub const WHY_OFFLINE : u8 = 1;
pub const WHY_MANIFEST : u8 = 2;
pub const WHY_DOWNLOAD : u8 = 3;
pub const WHY_SHA : u8 = 4;
pub const WHY_STAGE : u8 = 5;
pub const WHY_COMMIT : u8 = 6;
pub const WHY_NO_COMMIT : u8 = 7;
pub const WHY_BUNDLE : u8 = 8;
pub const WHY_SWAP : u8 = 9;
pub const WHY_BROKEN : u8 = 10;

/// The reason an install_decision refusal shows.
pub fn why_of_decision(d : u8) -> u8 {
    if (d == ID_REFUSE_SHA) { return WHY_SHA; }
    if (d == ID_REFUSE_COMMIT) { return WHY_COMMIT; }
    if (d == ID_REFUSE_NO_COMMIT) { return WHY_NO_COMMIT; }
    if (d == ID_REFUSE_BUNDLE) { return WHY_BUNDLE; }
    return WHY_NONE;
}

pub const STRIP_HIDDEN : u8 = 0;
pub const STRIP_PROGRESS : u8 = 1;
pub const STRIP_READY : u8 = 2;
pub const STRIP_FAILED : u8 = 3;

pub fn strip_kind(state : u8, why : u8) -> u8 {
    if (state == U_DOWNLOADING or state == U_VERIFYING or state == U_SWAPPED) { return STRIP_PROGRESS; }
    if (state == U_STAGED) { return STRIP_READY; }
    if (state == U_IDLE and why >= WHY_MANIFEST) { return STRIP_FAILED; }
    return STRIP_HIDDEN;
}

fn rl_why_text(why : u8) -> str {
    if (why == WHY_MANIFEST) { return "the manifest is not valid"; }
    if (why == WHY_DOWNLOAD) { return "the download failed"; }
    if (why == WHY_SHA) { return "a sha256 differs from the manifest"; }
    if (why == WHY_STAGE) { return "unzip or code signature failed"; }
    if (why == WHY_COMMIT) { return "the toolchain is from another commit"; }
    if (why == WHY_NO_COMMIT) { return "the toolchain names no commit"; }
    if (why == WHY_BUNDLE) { return "this copy is not an installed app"; }
    if (why == WHY_SWAP) { return "the swap failed, the old app stays"; }
    if (why == WHY_BROKEN) { return "the last update did not start; rolled back"; }
    return "";
}

/// The line in the window's foot. The length written (clipped at cap).
pub fn strip_text(out : []u8, cap : usize, state : u8, why : u8, build : u32, busy_panes : u32) -> usize {
    var w : usize = 0;
    if (state == U_DOWNLOADING) { w = rl_put(out, cap, w, "UPDATING: downloading build "); return put_number(out, cap, w, build); }
    if (state == U_VERIFYING) { w = rl_put(out, cap, w, "UPDATING: verifying build "); return put_number(out, cap, w, build); }
    if (state == U_SWAPPED) { return rl_put(out, cap, w, "UPDATING: restarting"); }
    if (state == U_STAGED) {
        if (!idle_enough(busy_panes)) {
            w = rl_put(out, cap, w, "UPDATE READY build ");
            w = put_number(out, cap, w, build);
            return rl_put(out, cap, w, " (panes busy)");
        }
        w = rl_put(out, cap, w, "UPDATE NOW build ");
        return put_number(out, cap, w, build);
    }
    if (strip_kind(state, why) == STRIP_FAILED) {
        w = rl_put(out, cap, w, "UPDATE FAILED: ");
        return rl_put(out, cap, w, rl_why_text(why));
    }
    return 0;
}

/// The running build from the bundle's CFBundleVersion text; 0 when it is not a commit count.
pub fn parse_build(t : []const u8, n : usize) -> u32 {
    if (n == 0 or n > 9) { return 0; }
    var v : u32 = 0;
    var i : usize = 0;
    while (i < n) {
        if (t[i] < '0' or t[i] > '9') { return 0; }
        v = v * 10 + ((t[i] - '0') as u32);
        i += 1;
    }
    return v;
}

// ---------------------------------------------------------------- the commands the host runs

/// The pane server under launchd (measured on this Mac: a child of a terminal or of the app dies with it).
pub const SERVER_LABEL : str = "ai.t27.os.pty";
/// The PATH of the server and so of every pane: ~/.t27os/bin first, so every machine runs the release's
/// t27b, t27c and tri.
pub const SERVER_PATH : str = "$HOME/.t27os/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin";

/// A path the host may put inside a double-quoted shell word: letters, digits and / . _ + @ -.
pub fn path_ok(t : []const u8, n : usize) -> bool {
    if (n == 0) { return false; }
    var i : usize = 0;
    while (i < n) {
        const c : u8 = t[i];
        if (!((c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '/' or c == '.' or c == '_' or c == '+' or c == '@' or c == '-')) { return false; }
        i += 1;
    }
    return true;
}

/// Does the path run through a cargo output folder ("/target/")? A bundle built by `make t27os` in a checkout
/// is a developer's, and an update must never replace it.
pub fn dev_path(t : []const u8, n : usize) -> bool {
    var i : usize = 0;
    while (i + 8 <= n) {
        if (starts_here(t, n, i, "/target/", 8)) { return true; }
        i += 1;
    }
    return false;
}

/// The length of the bundle path inside the running executable's path (".../T27OS.app/Contents/MacOS/T27OS"),
/// 0 when the app does not run from a bundle (a dev build), runs from a checkout's target folder, or the path
/// is not path_ok.
pub fn bundle_len(exe : []const u8, n : usize) -> usize {
    const tail : usize = 21;
    if (n <= tail + 4 or !path_ok(exe, n) or dev_path(exe, n)) { return 0; }
    if (!starts_here(exe, n, n - tail, "/Contents/MacOS/T27OS", tail)) { return 0; }
    if (!starts_here(exe, n, n - tail - 4, ".app", 4)) { return 0; }
    return n - tail;
}

fn rl_head(out : []u8, cap : usize, home : []const u8, hn : usize) -> usize {
    var w : usize = rl_put(out, cap, 0, "export HOME=\"");
    w = put_slice(out, cap, w, home, hn);
    return rl_put(out, cap, w, "\"; export PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin; U=$HOME/.t27os/updates; mkdir -p $U/previous $HOME/.t27os/bin; ");
}

/// Start the pane server under launchd: the label is removed first so a stale one cannot block the submit.
fn rl_server_start(out : []u8, cap : usize, w : usize) -> usize {
    var k : usize = rl_put(out, cap, w, "launchctl remove ");
    k = rl_put(out, cap, k, SERVER_LABEL);
    k = rl_put(out, cap, k, " 2>/dev/null; launchctl submit -l ");
    k = rl_put(out, cap, k, SERVER_LABEL);
    k = rl_put(out, cap, k, " -- /usr/bin/env PATH=\"");
    k = rl_put(out, cap, k, SERVER_PATH);
    return rl_put(out, cap, k, "\" HOME=\"$HOME\" $HOME/.t27os/t27os-pty");
}

/// Restart it: remove the label, stop a server that was started by hand, give it a second, submit.
fn rl_server_restart(out : []u8, cap : usize, w : usize) -> usize {
    const k : usize = rl_put(out, cap, w, "pkill -x t27os-pty 2>/dev/null; sleep 1; ");
    return rl_server_start(out, cap, k);
}

pub fn server_restart_text(out : []u8, cap : usize) -> usize {
    return rl_server_restart(out, cap, 0);
}

/// The poll: fetch the manifest (exit status = the fetch's), and start the pane server when it is installed
/// and nothing runs.
pub fn check_cmd(out : []u8, cap : usize, home : []const u8, hn : usize) -> usize {
    var w : usize = rl_head(out, cap, home, hn);
    w = rl_put(out, cap, w, "curl -fsS --max-time 20 -o $U/manifest.tmp ");
    w = rl_put(out, cap, w, MANIFEST_URL);
    w = rl_put(out, cap, w, " && mv -f $U/manifest.tmp $U/manifest.t27; R=$?; [ -x $HOME/.t27os/t27os-pty ] && ! pgrep -x t27os-pty >/dev/null && { ");
    w = rl_server_start(out, cap, w);
    return rl_put(out, cap, w, "; }; exit $R");
}

/// The download of one release into ~/.t27os/updates/<build>/ and the digests of what arrived (sums.txt).
pub fn download_cmd(out : []u8, cap : usize, home : []const u8, hn : usize, v : u64, build : u32) -> usize {
    var w : usize = rl_head(out, cap, home, hn);
    w = rl_put(out, cap, w, "B=$U/");
    w = put_number(out, cap, w, build);
    w = rl_put(out, cap, w, "; rm -rf $B; mkdir -p $B; cd $B || exit 1; D=");
    w = put_base(out, cap, w, v, build);
    w = rl_put(out, cap, w, "; F=\"");
    w = put_zip_name(out, cap, w, v);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, A_T27B);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, A_T27C);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, A_TRI);
    return rl_put(out, cap, w, "\"; for f in $F; do curl -fsS --max-time 600 -o $f $D$f || exit 1; done; shasum -a 256 $F > sums.txt");
}

/// Unzip, sign ad hoc and verify the new bundle, digest the pane server inside it, and ask each staged tool
/// for its --version. Every step must succeed.
pub fn stage_cmd(out : []u8, cap : usize, home : []const u8, hn : usize, v : u64, build : u32) -> usize {
    var w : usize = rl_head(out, cap, home, hn);
    w = rl_put(out, cap, w, "B=$U/");
    w = put_number(out, cap, w, build);
    w = rl_put(out, cap, w, "; cd $B || exit 1; rm -rf stage; ditto -x -k ");
    w = put_zip_name(out, cap, w, v);
    w = rl_put(out, cap, w, " stage && xattr -cr stage && chmod +x ");
    w = rl_put(out, cap, w, A_T27B);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, A_T27C);
    w = rl_put(out, cap, w, " ");
    w = rl_put(out, cap, w, A_TRI);
    w = rl_put(out, cap, w, " && codesign --force --deep -s - stage/T27OS/T27OS.app && codesign -v stage/T27OS/T27OS.app && (cd stage/T27OS && shasum -a 256 t27os-pty) > sums2.txt && ./");
    w = rl_put(out, cap, w, A_T27B);
    w = rl_put(out, cap, w, " --version > v_t27b.txt 2>&1 && ./");
    w = rl_put(out, cap, w, A_T27C);
    w = rl_put(out, cap, w, " --version > v_t27c.txt 2>&1 && ./");
    w = rl_put(out, cap, w, A_TRI);
    return rl_put(out, cap, w, " --version > v_tri.txt 2>&1");
}

/// The swap. Everything is prepared beside its destination first (a failure there changes nothing), then the
/// old bundle moves to previous/ and the new one takes its place (undone if that fails), the toolchain and the
/// pane server are renamed over (the old ones kept as .prev), the pane server is restarted under launchd when
/// its digest changed, and the executable is touched so hot_reload.t27 relaunches.
pub fn swap_cmd(out : []u8, cap : usize, home : []const u8, hn : usize, bundle : []const u8, bn : usize, build : u32) -> usize {
    var w : usize = rl_head(out, cap, home, hn);
    w = rl_put(out, cap, w, "B=$U/");
    w = put_number(out, cap, w, build);
    w = rl_put(out, cap, w, "; N=$B/stage/T27OS; BIN=$HOME/.t27os/bin; P=$HOME/.t27os/t27os-pty; A=\"");
    w = put_slice(out, cap, w, bundle, bn);
    w = rl_put(out, cap, w, "\"; OLD=$(shasum -a 256 < $P 2>/dev/null); ");
    w = rl_put(out, cap, w, "for t in t27b t27c tri; do cp $B/$t-darwin-arm64 $BIN/$t.new || exit 1; [ ! -f $BIN/$t ] || cp -p $BIN/$t $BIN/$t.prev; done; ");
    w = rl_put(out, cap, w, "cp $N/t27os-pty $P.new || exit 1; [ ! -f $P ] || cp -p $P $P.prev; ");
    w = rl_put(out, cap, w, "rm -rf $U/previous/T27OS.app; echo 1 > $U/pending; ");
    w = rl_put(out, cap, w, "mv \"$A\" $U/previous/T27OS.app || { rm -f $U/pending; exit 1; }; ");
    w = rl_put(out, cap, w, "mv $N/T27OS.app \"$A\" || { mv $U/previous/T27OS.app \"$A\"; rm -f $U/pending; exit 1; }; echo 1 > $U/previous/kept; ");
    w = rl_put(out, cap, w, "for t in t27b t27c tri; do mv -f $BIN/$t.new $BIN/$t; done; mv -f $P.new $P; ");
    w = rl_put(out, cap, w, "NEW=$(shasum -a 256 < $P); [ \"$OLD\" = \"$NEW\" ] || { ");
    w = rl_server_restart(out, cap, w);
    return rl_put(out, cap, w, "; }; touch \"$A/Contents/MacOS/T27OS\"");
}

/// The first start of a new build: mark it started, so a start that finds the mark follows one that died.
pub fn mark_cmd(out : []u8, cap : usize, home : []const u8, hn : usize) -> usize {
    const w : usize = rl_head(out, cap, home, hn);
    return rl_put(out, cap, w, "echo 2 > $U/pending");
}

/// The build lived CONFIRM_AFTER_S: it is good.
pub fn confirm_cmd(out : []u8, cap : usize, home : []const u8, hn : usize) -> usize {
    const w : usize = rl_head(out, cap, home, hn);
    return rl_put(out, cap, w, "rm -f $U/pending");
}

/// The previous start did not live: put the previous bundle and tools back, remember the bad build.
pub fn rollback_cmd(out : []u8, cap : usize, home : []const u8, hn : usize, bundle : []const u8, bn : usize, build : u32) -> usize {
    var w : usize = rl_head(out, cap, home, hn);
    w = rl_put(out, cap, w, "BIN=$HOME/.t27os/bin; A=\"");
    w = put_slice(out, cap, w, bundle, bn);
    w = rl_put(out, cap, w, "\"; echo ");
    w = put_number(out, cap, w, build);
    w = rl_put(out, cap, w, " > $U/rejected; rm -rf $U/bad.app; mv \"$A\" $U/bad.app && mv $U/previous/T27OS.app \"$A\" && rm -f $U/pending $U/previous/kept; ");
    w = rl_put(out, cap, w, "for t in t27b t27c tri; do [ ! -f $BIN/$t.prev ] || mv -f $BIN/$t.prev $BIN/$t; done; touch \"$A/Contents/MacOS/T27OS\"");
    return w;
}

/// Files the window reads, under ~/.t27os/updates/ (the directory has its slash at both ends).
pub const UPD_DIR : str = "/.t27os/updates/";
pub const F_MANIFEST : str = "manifest.t27";
pub const F_PENDING : str = "pending";
pub const F_KEPT : str = "previous/kept";
pub const F_REJECTED : str = "rejected";

/// <build>/<name>, the path of a file inside one release's directory.
pub fn put_build_file(out : []u8, cap : usize, w : usize, build : u32, name : str) -> usize {
    var k : usize = put_number(out, cap, w, build);
    k = rl_put(out, cap, k, "/");
    return rl_put(out, cap, k, name);
}

// ---------------------------------------------------------------- the release plan

/// `tri t27os release --plan`: the numbered steps with the exact commands. Nothing here runs them.
pub const PLAN_STEPS : u32 = 6;

pub fn plan_text(out : []u8, cap : usize, v : u64) -> usize {
    var w : usize = 0;
    w = rl_put(out, cap, w, "# T27 OS release ");
    w = put_semver(out, cap, w, v);
    w = rl_line(out, cap, w, " -- the plan only; nothing below was run");
    w = rl_line(out, cap, w, "# `tri t27os publish --yes` runs all of it. T27OS_SIGN_ID names a Developer ID Application identity (else ad hoc).");
    w = rl_line(out, cap, w, "1. build the app and the toolchain from one commit:");
    w = rl_line(out, cap, w, "   export T27_BUILD=$(git rev-list --count HEAD) T27_COMMIT=$(git rev-parse HEAD)");
    w = rl_line(out, cap, w, "   cargo build --release -p t27c -p tri -p t27b");
    w = rl_line(out, cap, w, "   make t27os T27OS_BUILD=$(git rev-list --count HEAD)");
    w = rl_line(out, cap, w, "2. zip the app and the pane server:");
    w = rl_put(out, cap, w, "   ditto -c -k --keepParent target/t27os/pub/T27OS target/t27os/pub/");
    w = put_zip_name(out, cap, w, v);
    w = rl_line(out, cap, w, "");
    w = rl_line(out, cap, w, "3. sha256 of the zip and of each tool, and the commit:");
    w = rl_put(out, cap, w, "   shasum -a 256 ");
    w = put_zip_name(out, cap, w, v);
    w = rl_line(out, cap, w, " t27b-darwin-arm64 t27c-darwin-arm64 tri-darwin-arm64");
    w = rl_line(out, cap, w, "4. manifest:");
    w = rl_line(out, cap, w, "   tri t27os manifest --build $(git rev-list --count HEAD) --sums target/t27os/pub/sums.txt > target/t27os/pub/t27os-release.t27");
    w = rl_line(out, cap, w, "5. notes (the latest commits):");
    w = rl_line(out, cap, w, "   git log --format='- %s' -20 > target/t27os/pub/notes.md");
    w = rl_line(out, cap, w, "6. publish, then point t27os-latest at the new manifest:");
    w = rl_put(out, cap, w, "   gh release create ");
    w = put_tag_head(out, cap, w, v);
    w = rl_line(out, cap, w, "<build> <the five files> --latest=false");
    w = rl_put(out, cap, w, "   gh release upload ");
    w = rl_put(out, cap, w, LATEST_TAG);
    w = rl_line(out, cap, w, " target/t27os/pub/t27os-release.t27 --clobber");
    return w;
}

/// The publish script: `tri t27os publish --yes` hands it to sh. It stops at the first failure (set -e), builds
/// app and toolchain from the same clean commit, checks that each tool names that commit, unzips the zip to
/// look inside it, writes the manifest and creates the release and the pointer.
pub fn publish_text(out : []u8, cap : usize, v : u64) -> usize {
    var w : usize = 0;
    w = rl_line(out, cap, w, "set -e");
    w = rl_line(out, cap, w, "cd \"$(git rev-parse --show-toplevel)\"");
    w = rl_line(out, cap, w, "B=$(git rev-list --count HEAD); C=$(git rev-parse HEAD); S=$(printf %s \"$C\" | cut -c1-7)");
    w = rl_line(out, cap, w, "test -z \"$(git status --porcelain --untracked-files=no)\" || { echo 'tri t27os publish: uncommitted changes' >&2; exit 2; }");
    w = rl_put(out, cap, w, "TAG=");
    w = put_tag_head(out, cap, w, v);
    w = rl_line(out, cap, w, "$B");
    w = rl_put(out, cap, w, "Z=");
    w = put_zip_name(out, cap, w, v);
    w = rl_line(out, cap, w, "");
    w = rl_line(out, cap, w, "T=${CARGO_TARGET_DIR:-target}; O=target/t27os; P=$O/pub; N=darwin-arm64");
    w = rl_line(out, cap, w, "export T27_BUILD=$B T27_COMMIT=$C");
    w = rl_line(out, cap, w, "cargo build --release -p t27c -p tri -p t27b");
    w = rl_line(out, cap, w, "make t27os T27OS_BUILD=$B");
    w = rl_line(out, cap, w, "rm -rf $P; mkdir -p $P/T27OS; cp -R $O/T27OS.app $O/t27os-pty $P/T27OS/");
    w = rl_line(out, cap, w, "ditto -c -k --keepParent $P/T27OS $P/$Z");
    w = rl_line(out, cap, w, "for t in t27b t27c tri; do cp $T/release/$t $P/$t-$N; $P/$t-$N --version | grep -q \" commit $S\" || { echo \"$t does not name commit $S\" >&2; exit 2; }; done");
    w = rl_line(out, cap, w, "rm -rf $P/chk; ditto -x -k $P/$Z $P/chk; test -d $P/chk/T27OS/T27OS.app; test -f $P/chk/T27OS/t27os-pty; codesign -v $P/chk/T27OS/T27OS.app");
    w = rl_line(out, cap, w, "{ echo \"COMMIT $C\"; (cd $P && shasum -a 256 $Z t27b-$N t27c-$N tri-$N); (cd $P/T27OS && shasum -a 256 t27os-pty); } > $P/sums.txt");
    w = rl_line(out, cap, w, "$T/release/tri t27os manifest --build $B --sums $P/sums.txt > $P/t27os-release.t27");
    w = rl_line(out, cap, w, "git log --format='- %s' -20 > $P/notes.md");
    w = rl_line(out, cap, w, "gh release create $TAG $P/$Z $P/t27b-$N $P/t27c-$N $P/tri-$N $P/t27os-release.t27 --title \"T27 OS $B\" --notes-file $P/notes.md --latest=false --target $C");
    w = rl_put(out, cap, w, "gh release view ");
    w = rl_put(out, cap, w, LATEST_TAG);
    w = rl_put(out, cap, w, " >/dev/null 2>&1 || gh release create ");
    w = rl_put(out, cap, w, LATEST_TAG);
    w = rl_line(out, cap, w, " --title 'T27 OS latest' --notes 'The newest T27 OS manifest, replaced on every publish.' --latest=false --target $C");
    w = rl_put(out, cap, w, "gh release upload ");
    w = rl_put(out, cap, w, LATEST_TAG);
    w = rl_line(out, cap, w, " $P/t27os-release.t27 --clobber");
    w = rl_put(out, cap, w, "echo \"published $TAG and pointed ");
    w = rl_put(out, cap, w, LATEST_TAG);
    w = rl_line(out, cap, w, " at it\"");
    return w;
}

/// The plan runs nothing, so it is never "publishing"; anything that would publish is refused until the owner
/// has said yes, which this verb takes as --yes.
pub fn publish_allowed(plan_only : bool, owner_yes : bool) -> bool {
    if (plan_only) { return false; }
    return owner_yes;
}

pub const REFUSAL : str = "tri t27os publish: publishing needs the owner's explicit --yes; `tri t27os release --plan` prints the steps and runs none";
pub const REFUSAL_LEN : usize = 121;

// ---------------------------------------------------------------- tests

fn rl_has(buf : []const u8, n : usize, needle : str) -> bool {
    return buf_has(buf, n, needle, needle.len);
}

/// A sums file for tests: row k's digest is the hex digit d repeated 64 times, the commit is 40 times 'c'.
fn rl_test_sums(out : []u8, cap : usize, v : u64, d0 : u8, d1 : u8, d2 : u8, d3 : u8, d4 : u8) -> usize {
    var w : usize = rl_put(out, cap, 0, "COMMIT cccccccccccccccccccccccccccccccccccccccc\n");
    var k : u32 = 0;
    while (k < 5) {
        var d : u8 = d0;
        if (k == 1) { d = d1; }
        if (k == 2) { d = d2; }
        if (k == 3) { d = d3; }
        if (k == 4) { d = d4; }
        var i : usize = 0;
        while (i < 64) {
            if (w + i < cap) { out[w + i] = d; }
            i += 1;
        }
        w += 64;
        w = rl_put(out, cap, w, "  ");
        if (k == 0) { w = put_zip_name(out, cap, w, v); }
        if (k == 1) { w = rl_put(out, cap, w, A_T27B); }
        if (k == 2) { w = rl_put(out, cap, w, A_T27C); }
        if (k == 3) { w = rl_put(out, cap, w, A_TRI); }
        if (k == 4) { w = rl_put(out, cap, w, A_PTY); }
        w = rl_put(out, cap, w, "\n");
        k += 1;
    }
    return w;
}

test the_version_is_semver_from_three_constants {
    assert(current_version() == pack_version(0, 1, 1));
    var out : [32]u8 = undefined;
    const n : usize = put_semver(out[0..32], 32, 0, pack_version(12, 3, 456));
    assert(n == 8);
    assert(rl_has(out[0..32], n, "12.3.456"));
    assert(version_major(pack_version(12, 3, 456)) == 12);
    assert(version_minor(pack_version(12, 3, 456)) == 3);
    assert(version_patch(pack_version(12, 3, 456)) == 456);
}

test a_semver_text_parses_and_anything_else_does_not {
    assert(semver_parse("0.1.0", 5) == pack_version(0, 1, 0));
    assert(semver_parse("10.20.30", 8) == pack_version(10, 20, 30));
    assert(semver_parse("999999.999999.999999", 20) == pack_version(999999, 999999, 999999));
    assert(semver_parse("1.2", 3) == NO_VERSION);
    assert(semver_parse("1.2.3.4", 7) == NO_VERSION);
    assert(semver_parse("v1.2.3", 6) == NO_VERSION);
    assert(semver_parse("1.2.3-rc1", 9) == NO_VERSION);
    assert(semver_parse("01.2.3", 6) == NO_VERSION);
    assert(semver_parse("1..3", 4) == NO_VERSION);
    assert(semver_parse("", 0) == NO_VERSION);
    assert(semver_parse("1.2.1000000", 11) == NO_VERSION);
}

test a_newer_version_is_an_update_and_an_equal_or_unreadable_one_is_not {
    assert(is_newer(pack_version(0, 1, 1), pack_version(0, 1, 0)));
    assert(is_newer(pack_version(0, 2, 0), pack_version(0, 1, 99)));
    assert(is_newer(pack_version(1, 0, 0), pack_version(0, 99, 99)));
    assert(is_newer(pack_version(0, 1, 0), pack_version(0, 1, 0)) == false);
    assert(is_newer(pack_version(0, 0, 9), pack_version(0, 1, 0)) == false);
    assert(is_newer(NO_VERSION, pack_version(0, 1, 0)) == false);
    assert(is_newer(pack_version(9, 9, 9), NO_VERSION) == false);
}

test the_same_version_with_a_higher_build_is_newer {
    const v : u64 = pack_version(0, 1, 1);
    assert(is_newer_build(v, 4461, v, 4460));
    assert(is_newer_build(v, 4460, v, 4460) == false);
    assert(is_newer_build(v, 4459, v, 4460) == false);
    assert(is_newer_build(pack_version(0, 1, 2), 1, v, 9999));
    assert(is_newer_build(pack_version(0, 1, 0), 99999, v, 1) == false);
    assert(is_newer_build(NO_VERSION, 9, v, 1) == false);
}

test the_tag_is_t27os_v_semver_b_build_and_the_poll_address_is_the_latest_pointer {
    var out : [128]u8 = undefined;
    const n : usize = put_tag(out[0..128], 128, 0, pack_version(0, 1, 1), 4460);
    assert(n == 18);
    assert(rl_has(out[0..128], n, "t27os-v0.1.1-b4460"));
    assert(TAG_PREFIX.len == 7);
    assert(rl_has(out[0..128], 7, "v0.1.1") == false);
    assert(MANIFEST_URL.len == 80);
    assert(rl_has(MANIFEST_URL, MANIFEST_URL.len, "/releases/download/t27os-latest/t27os-release.t27"));
    assert(LATEST_TAG.len == 12);
    assert(url_ok(MANIFEST_URL, MANIFEST_URL.len));
    const m : usize = put_zip_url(out[0..128], 128, 0, pack_version(0, 1, 1), 4460);
    assert(rl_has(out[0..128], m, "https://github.com/gHashTag/t27/releases/download/t27os-v0.1.1-b4460/T27OS-0.1.1.zip"));
    const k : usize = put_notes_url(out[0..128], 128, 0, pack_version(0, 1, 1), 4460);
    assert(rl_has(out[0..128], k, "https://github.com/gHashTag/t27/releases/tag/t27os-v0.1.1-b4460"));
}

test the_manifest_is_written_in_t27_from_the_sums_and_read_back {
    var sums : [1024]u8 = undefined;
    const sn : usize = rl_test_sums(sums[0..1024], 1024, pack_version(0, 1, 1), 'a', 'b', 'd', 'e', 'f');
    var out : [2048]u8 = undefined;
    const n : usize = manifest_from_sums(out[0..2048], 2048, pack_version(0, 1, 1), 4460, sums[0..1024], sn);
    assert(n > 0);
    assert(n < 2048);
    assert(rl_has(out[0..2048], n, "module T27osReleaseManifest;"));
    assert(rl_has(out[0..2048], n, "pub const VERSION : str = \"0.1.1\";"));
    assert(rl_has(out[0..2048], n, "pub const BUILD : u32 = 4460;"));
    assert(rl_has(out[0..2048], n, "pub const MIN_MACOS : str = \"11.0\";"));
    assert(rl_has(out[0..2048], n, "pub const COMMIT : str = \"cccccccccccccccccccccccccccccccccccccccc\";"));
    assert(rl_has(out[0..2048], n, "pub const T27B_SHA256 : str = \"bbbb"));
    assert(rl_has(out[0..2048], n, "pub const PTY_SHA256 : str = \"ffff"));
    assert(out[n - 1] == 10);
    assert(manifest_check(out[0..2048], n) == M_OK);
    assert(manifest_version(out[0..2048], n) == pack_version(0, 1, 1));
    assert(manifest_build(out[0..2048], n) == 4460);
}

test a_short_buffer_for_the_manifest_is_detected_and_incomplete_sums_give_nothing {
    var sums : [1024]u8 = undefined;
    const sn : usize = rl_test_sums(sums[0..1024], 1024, pack_version(0, 1, 1), '0', '1', '2', '3', '4');
    var big : [2048]u8 = undefined;
    const full : usize = manifest_from_sums(big[0..2048], 2048, pack_version(0, 1, 1), 1, sums[0..1024], sn);
    var small : [100]u8 = undefined;
    const n : usize = manifest_from_sums(small[0..100], 100, pack_version(0, 1, 1), 1, sums[0..1024], sn);
    assert(n == full);
    assert(n > 100);
    // sums of another version have no row for this zip name
    assert(manifest_from_sums(big[0..2048], 2048, pack_version(0, 1, 2), 1, sums[0..1024], sn) == 0);
    // sums without the commit line
    assert(manifest_from_sums(big[0..2048], 2048, pack_version(0, 1, 1), 1, sums[48..1024], sn - 48) == 0);
}

test a_manifest_with_any_field_wrong_is_refused_by_name {
    assert(manifest_check("module X;", 9) == M_NO_VERSION);
    var sums : [1024]u8 = undefined;
    const sn : usize = rl_test_sums(sums[0..1024], 1024, pack_version(0, 1, 1), 'b', 'b', 'b', 'b', 'b');
    var good : [2048]u8 = undefined;
    const n : usize = manifest_from_sums(good[0..2048], 2048, pack_version(0, 1, 1), 7, sums[0..1024], sn);
    assert(manifest_check(good[0..2048], n) == M_OK);
    var bad : [2048]u8 = undefined;
    var j : usize = 0;
    // an uppercase digit in the zip's sha
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_SHA, KEY_SHA.len))] = 'B';
    assert(manifest_check(bad[0..2048], n) == M_BAD_SHA);
    // a version that is not semver
    j = 0;
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_VERSION, KEY_VERSION.len)) + 1] = 'x';
    assert(manifest_check(bad[0..2048], n) == M_NO_VERSION);
    // a url off github.com/gHashTag/t27/releases
    j = 0;
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_URL, KEY_URL.len)) + 8] = 'x';
    assert(manifest_check(bad[0..2048], n) == M_BAD_URL);
    // a url that is on the release path but names another tag than the version and build
    j = 0;
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_URL, KEY_URL.len)) + 61] = '9';
    assert(manifest_check(bad[0..2048], n) == M_BAD_URL);
    // a commit that is not 40 hex digits
    j = 0;
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_COMMIT, KEY_COMMIT.len)) + 3] = 'G';
    assert(manifest_check(bad[0..2048], n) == M_BAD_COMMIT);
    // a tool digest that is not hex
    j = 0;
    while (j < n) { bad[j] = good[j]; j += 1; }
    bad[field_start(field_str(bad[0..2048], n, KEY_TRI, KEY_TRI.len)) + 5] = '-';
    assert(manifest_check(bad[0..2048], n) == M_BAD_TOOL);
}

test an_address_must_be_https_on_the_release_path {
    assert(url_ok("https://github.com/gHashTag/t27/releases/download/v1.0.0/a.zip", 62));
    assert(url_ok("http://github.com/gHashTag/t27/releases/download/v1.0.0/a.zip", 61) == false);
    assert(url_ok("https://evil.example/gHashTag/t27/releases/download/a.zip", 57) == false);
    assert(url_ok("https://github.com/gHashTag/t27/releases/", 41) == false);
    assert(url_ok("https://github.com/gHashTag/t27/releases/a b", 44) == false);
    assert(url_ok("https://github.com/gHashTag/t27/releases/a'b", 44) == false);
    assert(url_ok("", 0) == false);
}

test a_sha_is_sixty_four_lowercase_hex_digits_and_a_commit_forty {
    assert(sha_ok("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", 64));
    assert(sha_ok("0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef", 64) == false);
    assert(sha_ok("0123456789abcdef", 16) == false);
    assert(sha_ok("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdeg", 64) == false);
    assert(sha_matches("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", 64, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", 64));
    assert(sha_matches("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", 64, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde0", 64) == false);
    assert(sha_matches("", 0, "", 0) == false);
    assert(commit_ok("0123456789abcdef0123456789abcdef01234567", 40));
    assert(commit_ok("0123456789abcdef0123456789abcdef0123456", 39) == false);
    assert(commit_ok("0123456789abcdef0123456789abcdef0123456Z", 40) == false);
}

test the_downloaded_files_must_carry_the_digests_the_manifest_names {
    const v : u64 = pack_version(0, 1, 1);
    var s1 : [1024]u8 = undefined;
    const n1 : usize = rl_test_sums(s1[0..1024], 1024, v, 'a', 'b', 'd', 'e', 'f');
    var man : [2048]u8 = undefined;
    const mn : usize = manifest_from_sums(man[0..2048], 2048, v, 4460, s1[0..1024], n1);
    assert(sums_verdict(s1[0..1024], n1, man[0..2048], mn, 0, ROWS_ALL) == 0);
    assert(sums_verdict(s1[0..1024], n1, man[0..2048], mn, 0, ROWS_DOWNLOADED) == 0);
    // the zip differs
    var s2 : [1024]u8 = undefined;
    const n2 : usize = rl_test_sums(s2[0..1024], 1024, v, '1', 'b', 'd', 'e', 'f');
    assert(sums_verdict(s2[0..1024], n2, man[0..2048], mn, 0, ROWS_ALL) == 1);
    // t27b differs
    const n3 : usize = rl_test_sums(s2[0..1024], 1024, v, 'a', '1', 'd', 'e', 'f');
    assert(sums_verdict(s2[0..1024], n3, man[0..2048], mn, 0, ROWS_ALL) == 2);
    // the pane server differs: caught after the unzip, not before
    const n4 : usize = rl_test_sums(s2[0..1024], 1024, v, 'a', 'b', 'd', 'e', '1');
    assert(sums_verdict(s2[0..1024], n4, man[0..2048], mn, 0, ROWS_DOWNLOADED) == 0);
    assert(sums_verdict(s2[0..1024], n4, man[0..2048], mn, 0, ROWS_ALL) == 5);
    assert(sums_verdict(s2[0..1024], n4, man[0..2048], mn, 4, ROWS_ALL) == 5);
    // a row missing, an empty file
    assert(sums_verdict(s1[0..1024], 66 + 17, man[0..2048], mn, 0, ROWS_ALL) == 1);
    assert(sums_verdict(s1[0..1024], 0, man[0..2048], mn, 0, ROWS_ALL) == 1);
    // a row whose name only starts like the wanted one does not count
    assert(sums_row("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  tri-darwin-arm64x\n", 83, A_TRI) == NO_FIELD);
}

test the_minimum_macos_is_compared_as_major_and_minor {
    assert(macos_parse("11.0", 4) == 11000);
    assert(macos_parse("14", 2) == 14000);
    assert(macos_parse("13.4", 4) == 13004);
    assert(macos_parse("11.x", 4) == 4294967295);
    assert(macos_parse("", 0) == 4294967295);
    assert(macos_parse("11.0.1", 6) == 4294967295);
    assert(macos_meets("11.0", 4, 26000));
    assert(macos_meets("11.0", 4, 11000));
    assert(macos_meets("14.2", 4, 14001) == false);
    assert(macos_meets("14.2", 4, 14002));
    assert(macos_meets("nope", 4, 26000) == false);
}

test the_tools_print_their_build_and_commit_and_the_installer_reads_it_back {
    var out : [128]u8 = undefined;
    const n : usize = version_text(out[0..128], 128, "t27c", "0.5.2", 4460, "0123456789abcdef0123456789abcdef01234567");
    assert(rl_has(out[0..128], n, "t27c 0.5.2\nbuild 4460 commit 0123456789abcdef0123456789abcdef01234567\n"));
    const f : u64 = version_commit(out[0..128], n);
    assert(field_len(f) == 40);
    assert(version_commit("t27c 0.5.2\n", 11) == NO_FIELD);
    assert(version_commit("x commit \n", 10) == NO_FIELD);
    const want : str = "0123456789abcdef0123456789abcdef01234567";
    assert(tool_verdict(out[0..128], n, want, 40) == TV_OK);
}

test a_toolchain_from_another_commit_or_naming_none_is_refused {
    const want : str = "0123456789abcdef0123456789abcdef01234567";
    // an abbreviated commit is fine when it starts the wanted one
    assert(tool_verdict("t27b 0.1.0\nbuild 9 commit 0123456\n", 33, want, 40) == TV_OK);
    assert(tool_verdict("t27b 0.1.0\nbuild 9 commit 0123457\n", 33, want, 40) == TV_DIFFERS);
    assert(tool_verdict("t27b 0.1.0\nbuild 9 commit 012345\n", 32, want, 40) == TV_NO_COMMIT);
    assert(tool_verdict("t27b 0.1.0\nbuild 0 commit unknown\n", 34, want, 40) == TV_NO_COMMIT);
    assert(tool_verdict("t27c 0.5.2\n", 11, want, 40) == TV_NO_COMMIT);
    assert(tool_verdict("error: unexpected argument '--version' found\n", 44, want, 40) == TV_NO_COMMIT);
    assert(tool_verdict("t27b 0.1.0\nbuild 9 commit 0123456\n", 33, want, 39) == TV_NO_COMMIT);
    assert(tv_worse(TV_OK, TV_DIFFERS) == TV_DIFFERS);
    assert(tv_worse(TV_NO_COMMIT, TV_OK) == TV_NO_COMMIT);
    assert(tv_worse(TV_NO_COMMIT, TV_DIFFERS) == TV_DIFFERS);
    assert(tv_worse(TV_OK, TV_OK) == TV_OK);
}

test the_install_is_all_or_nothing {
    assert(install_decision(0, TV_OK, true) == ID_INSTALL);
    assert(install_decision(2, TV_OK, true) == ID_REFUSE_SHA);
    assert(install_decision(0, TV_DIFFERS, true) == ID_REFUSE_COMMIT);
    assert(install_decision(0, TV_NO_COMMIT, true) == ID_REFUSE_NO_COMMIT);
    assert(install_decision(0, TV_OK, false) == ID_REFUSE_BUNDLE);
    assert(install_decision(1, TV_DIFFERS, false) == ID_REFUSE_SHA);
    assert(why_of_decision(ID_INSTALL) == WHY_NONE);
    assert(why_of_decision(ID_REFUSE_COMMIT) == WHY_COMMIT);
    assert(why_of_decision(ID_REFUSE_SHA) == WHY_SHA);
}

test a_check_is_due_at_launch_and_every_ten_minutes {
    assert(UPD_POLL_S == 600);
    assert(check_due(1000000, 0));
    assert(check_due(1000000, 1000000) == false);
    assert(check_due(1000599, 1000000) == false);
    assert(check_due(1000600, 1000000));
    assert(check_due(1900000, 1000000));
    assert(check_due(500, 1000000));
}

test a_swap_waits_for_rest_and_for_quiet_unless_the_owner_presses {
    assert(swap_ready(U_STAGED, 0, 60, false));
    assert(swap_ready(U_STAGED, 0, 59, false) == false);
    assert(swap_ready(U_STAGED, 0, 0, true));
    assert(swap_ready(U_STAGED, 1, 600, false) == false);
    assert(swap_ready(U_STAGED, 3, 600, true) == false);
    assert(swap_ready(U_DOWNLOADING, 0, 600, true) == false);
    assert(swap_ready(U_IDLE, 0, 600, true) == false);
    assert(idle_enough(0) and idle_enough(1) == false);
}

test the_offer_follows_the_manifest_the_build_the_rollback_and_the_mac {
    const cur : u64 = pack_version(0, 1, 0);
    const nxt : u64 = pack_version(0, 2, 0);
    assert(offer(M_OK, nxt, 9, cur, 5, 0, true) == OFFER_UPDATE);
    assert(offer(M_BAD_SHA, nxt, 9, cur, 5, 0, true) == OFFER_BAD_MANIFEST);
    assert(offer(M_OK, cur, 5, cur, 5, 0, true) == OFFER_NONE);
    assert(offer(M_OK, cur, 6, cur, 5, 0, true) == OFFER_UPDATE);
    assert(offer(M_OK, pack_version(0, 0, 9), 99, cur, 5, 0, true) == OFFER_NONE);
    assert(offer(M_OK, nxt, 9, cur, 5, 9, true) == OFFER_REJECTED);
    assert(offer(M_OK, nxt, 9, cur, 5, 8, true) == OFFER_UPDATE);
    assert(offer(M_OK, nxt, 9, cur, 5, 0, false) == OFFER_OLD_MACOS);
}

test the_update_walks_check_download_verify_stage_swap {
    var s : u8 = U_IDLE;
    s = update_step(s, EV_CHECK, 0);
    assert(s == U_CHECKING);
    s = update_step(s, EV_OFFER, 0);
    assert(s == U_DOWNLOADING);
    s = update_step(s, EV_DOWNLOADED, 0);
    assert(s == U_VERIFYING);
    s = update_step(s, EV_SHA_OK, 0);
    assert(s == U_VERIFYING);
    s = update_step(s, EV_SIGNED, 0);
    assert(s == U_STAGED);
    s = update_step(s, EV_SWAP, 0);
    assert(s == U_SWAPPED);
}

test a_check_runs_while_panes_work_but_the_swap_waits_for_rest {
    assert(update_step(U_IDLE, EV_CHECK, 5) == U_CHECKING);
    assert(update_step(U_STAGED, EV_SWAP, 1) == U_STAGED);
    assert(update_step(U_STAGED, EV_SWAP, 0) == U_SWAPPED);
}

test a_failure_a_bad_digest_or_no_offer_falls_back_to_idle {
    assert(update_step(U_DOWNLOADING, EV_FAILED, 0) == U_IDLE);
    assert(update_step(U_VERIFYING, EV_SHA_BAD, 0) == U_IDLE);
    assert(update_step(U_CHECKING, EV_NO_OFFER, 0) == U_IDLE);
    assert(update_step(U_STAGED, EV_FAILED, 0) == U_IDLE);
}

test an_event_out_of_order_changes_nothing {
    assert(update_step(U_IDLE, EV_DOWNLOADED, 0) == U_IDLE);
    assert(update_step(U_CHECKING, EV_SWAP, 0) == U_CHECKING);
    assert(update_step(U_DOWNLOADING, EV_SIGNED, 0) == U_DOWNLOADING);
    assert(update_step(U_SWAPPED, EV_CHECK, 0) == U_SWAPPED);
}

test a_start_that_did_not_live_sixty_seconds_rolls_back_but_the_first_start_does_not {
    assert(CONFIRM_AFTER_S == 60);
    assert(confirm_due(59) == false);
    assert(confirm_due(60));
    assert(marker_of(false, '1') == MK_NONE);
    assert(marker_of(true, '1') == MK_SWAPPED);
    assert(marker_of(true, '2') == MK_STARTED);
    assert(marker_of(true, 'x') == MK_NONE);
    assert(boot_action(MK_NONE, true) == BOOT_RUN);
    assert(boot_action(MK_NONE, false) == BOOT_RUN);
    assert(boot_action(MK_SWAPPED, true) == BOOT_FIRST);
    assert(boot_action(MK_STARTED, true) == BOOT_ROLLBACK);
    assert(boot_action(MK_STARTED, false) == BOOT_BROKEN);
}

test one_previous_bundle_is_kept_and_a_rollback_consumes_it {
    assert(previous_after(true, false, false));
    assert(previous_after(true, false, true));
    assert(previous_after(false, true, true) == false);
    assert(previous_after(false, false, true));
    assert(previous_after(false, false, false) == false);
}

test the_build_a_rollback_removed_is_not_offered_again {
    assert(rejected_after(BOOT_ROLLBACK, 4461, 0) == 4461);
    assert(rejected_after(BOOT_RUN, 4461, 0) == 0);
    assert(rejected_after(BOOT_BROKEN, 4461, 4400) == 4400);
    const v : u64 = pack_version(0, 1, 1);
    assert(offer(M_OK, v, 4461, v, 4460, rejected_after(BOOT_ROLLBACK, 4461, 0), true) == OFFER_REJECTED);
}

test the_window_shows_progress_a_button_and_the_reason_it_failed {
    var out : [96]u8 = undefined;
    var n : usize = strip_text(out[0..96], 96, U_DOWNLOADING, WHY_NONE, 4461, 0);
    assert(rl_has(out[0..96], n, "UPDATING: downloading build 4461"));
    n = strip_text(out[0..96], 96, U_STAGED, WHY_NONE, 4461, 0);
    assert(rl_has(out[0..96], n, "UPDATE NOW build 4461"));
    n = strip_text(out[0..96], 96, U_STAGED, WHY_NONE, 4461, 2);
    assert(rl_has(out[0..96], n, "UPDATE READY build 4461 (panes busy)"));
    n = strip_text(out[0..96], 96, U_IDLE, WHY_SHA, 4461, 0);
    assert(rl_has(out[0..96], n, "UPDATE FAILED: a sha256 differs from the manifest"));
    assert(strip_text(out[0..96], 96, U_IDLE, WHY_NONE, 4461, 0) == 0);
    assert(strip_text(out[0..96], 96, U_IDLE, WHY_OFFLINE, 4461, 0) == 0);
    assert(strip_kind(U_STAGED, WHY_NONE) == STRIP_READY);
    assert(strip_kind(U_VERIFYING, WHY_NONE) == STRIP_PROGRESS);
    assert(strip_kind(U_IDLE, WHY_COMMIT) == STRIP_FAILED);
    assert(strip_kind(U_IDLE, WHY_OFFLINE) == STRIP_HIDDEN);
    assert(strip_kind(U_CHECKING, WHY_NONE) == STRIP_HIDDEN);
}

test the_running_build_and_bundle_are_read_from_the_app_itself {
    assert(parse_build("4460", 4) == 4460);
    assert(parse_build("", 0) == 0);
    assert(parse_build("44a0", 4) == 0);
    assert(parse_build("1234567890", 10) == 0);
    assert(bundle_len("/Applications/T27OS.app/Contents/MacOS/T27OS", 44) == 23);
    assert(bundle_len("/Users/x/t27/target/t27os/T27OS.app/Contents/MacOS/T27OS", 56) == 0);
    assert(dev_path("/Users/x/t27/target/t27os/T27OS.app", 35));
    assert(bundle_len("/Users/x/Applications/T27OS.app/Contents/MacOS/T27OS", 52) == 31);
    assert(bundle_len("/Users/x/t27/target/dev/T27OS", 29) == 0);
    assert(bundle_len("/Applications/T 27.app/Contents/MacOS/T27OS", 43) == 0);
    assert(path_ok("/Users/x/.t27os", 15));
    assert(path_ok("/Users/x y", 10) == false);
    assert(path_ok("/Users/x\"y", 10) == false);
    assert(path_ok("/Users/$HOME", 12) == false);
    assert(path_ok("", 0) == false);
}

test the_pane_server_lives_under_launchd_with_the_toolchain_first_on_its_path {
    assert(SERVER_LABEL.len == 13);
    assert(rl_has(SERVER_LABEL, 13, "ai.t27.os.pty"));
    assert(rl_has(SERVER_PATH, SERVER_PATH.len, "$HOME/.t27os/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"));
    var out : [1024]u8 = undefined;
    const n : usize = server_restart_text(out[0..1024], 1024);
    assert(n < 1024);
    assert(rl_has(out[0..1024], n, "pkill -x t27os-pty"));
    assert(rl_has(out[0..1024], n, "launchctl remove ai.t27.os.pty"));
    assert(rl_has(out[0..1024], n, "launchctl submit -l ai.t27.os.pty -- /usr/bin/env PATH=\"$HOME/.t27os/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:"));
    assert(rl_has(out[0..1024], n, "HOME=\"$HOME\" $HOME/.t27os/t27os-pty"));
    // the server is never a child of a shell: no nohup, no background &
    assert(rl_has(out[0..1024], n, "nohup") == false);
    assert(rl_has(out[0..1024], n, " &") == false);
}

test the_poll_fetches_the_latest_manifest_and_keeps_the_server_running {
    var out : [2048]u8 = undefined;
    const n : usize = check_cmd(out[0..2048], 2048, "/Users/x", 8);
    assert(n < 2048);
    assert(rl_has(out[0..2048], n, "export HOME=\"/Users/x\";"));
    assert(rl_has(out[0..2048], n, "curl -fsS --max-time 20 -o $U/manifest.tmp https://github.com/gHashTag/t27/releases/download/t27os-latest/t27os-release.t27"));
    assert(rl_has(out[0..2048], n, "mv -f $U/manifest.tmp $U/manifest.t27"));
    assert(rl_has(out[0..2048], n, "pgrep -x t27os-pty"));
    assert(rl_has(out[0..2048], n, "launchctl submit -l ai.t27.os.pty"));
    assert(rl_has(out[0..2048], n, "exit $R"));
}

test the_download_and_the_stage_name_the_files_of_one_release_and_sign_the_bundle {
    var out : [2048]u8 = undefined;
    const v : u64 = pack_version(0, 1, 1);
    var n : usize = download_cmd(out[0..2048], 2048, "/Users/x", 8, v, 4460);
    assert(n < 2048);
    assert(rl_has(out[0..2048], n, "B=$U/4460;"));
    assert(rl_has(out[0..2048], n, "D=https://github.com/gHashTag/t27/releases/download/t27os-v0.1.1-b4460/;"));
    assert(rl_has(out[0..2048], n, "F=\"T27OS-0.1.1.zip t27b-darwin-arm64 t27c-darwin-arm64 tri-darwin-arm64\""));
    assert(rl_has(out[0..2048], n, "curl -fsS --max-time 600 -o $f $D$f || exit 1"));
    assert(rl_has(out[0..2048], n, "shasum -a 256 $F > sums.txt"));
    n = stage_cmd(out[0..2048], 2048, "/Users/x", 8, v, 4460);
    assert(n < 2048);
    assert(rl_has(out[0..2048], n, "ditto -x -k T27OS-0.1.1.zip stage"));
    assert(rl_has(out[0..2048], n, "codesign --force --deep -s - stage/T27OS/T27OS.app && codesign -v stage/T27OS/T27OS.app"));
    assert(rl_has(out[0..2048], n, "shasum -a 256 t27os-pty) > sums2.txt"));
    assert(rl_has(out[0..2048], n, "./t27b-darwin-arm64 --version > v_t27b.txt"));
    assert(rl_has(out[0..2048], n, "./tri-darwin-arm64 --version > v_tri.txt"));
}

test the_swap_keeps_the_previous_bundle_and_tools_and_restarts_the_server_only_when_it_changed {
    var out : [4096]u8 = undefined;
    const n : usize = swap_cmd(out[0..4096], 4096, "/Users/x", 8, "/Applications/T27OS.app", 23, 4460);
    assert(n < 4096);
    assert(rl_has(out[0..4096], n, "A=\"/Applications/T27OS.app\";"));
    assert(rl_has(out[0..4096], n, "mv \"$A\" $U/previous/T27OS.app"));
    assert(rl_has(out[0..4096], n, "mv $N/T27OS.app \"$A\" || { mv $U/previous/T27OS.app \"$A\";"));
    assert(rl_has(out[0..4096], n, "cp -p $BIN/$t $BIN/$t.prev"));
    assert(rl_has(out[0..4096], n, "mv -f $BIN/$t.new $BIN/$t"));
    assert(rl_has(out[0..4096], n, "echo 1 > $U/pending"));
    assert(rl_has(out[0..4096], n, "[ \"$OLD\" = \"$NEW\" ] || { pkill -x t27os-pty"));
    assert(rl_has(out[0..4096], n, "launchctl submit -l ai.t27.os.pty"));
    // the executable is touched last so the window relaunches
    assert(rl_has(out[0..4096], n, "; }; touch \"$A/Contents/MacOS/T27OS\""));
    assert(out[n - 1] == '"');
}

test a_start_that_did_not_live_puts_the_previous_bundle_and_tools_back {
    var out : [2048]u8 = undefined;
    var n : usize = rollback_cmd(out[0..2048], 2048, "/Users/x", 8, "/Applications/T27OS.app", 23, 4461);
    assert(rl_has(out[0..2048], n, "echo 4461 > $U/rejected"));
    assert(rl_has(out[0..2048], n, "mv $U/previous/T27OS.app \"$A\" && rm -f $U/pending $U/previous/kept"));
    assert(rl_has(out[0..2048], n, "mv -f $BIN/$t.prev $BIN/$t"));
    n = mark_cmd(out[0..2048], 2048, "/Users/x", 8);
    assert(rl_has(out[0..2048], n, "echo 2 > $U/pending"));
    n = confirm_cmd(out[0..2048], 2048, "/Users/x", 8);
    assert(rl_has(out[0..2048], n, "rm -f $U/pending"));
    var f : [64]u8 = undefined;
    n = put_build_file(f[0..64], 64, 0, 4460, "sums.txt");
    assert(rl_has(f[0..64], n, "4460/sums.txt"));
}

test the_release_plan_names_the_tag_the_toolchain_and_the_pointer {
    var out : [4096]u8 = undefined;
    const n : usize = plan_text(out[0..4096], 4096, pack_version(0, 1, 1));
    assert(n < 4096);
    assert(PLAN_STEPS == 6);
    assert(rl_has(out[0..4096], n, "make t27os T27OS_BUILD=$(git rev-list --count HEAD)"));
    assert(rl_has(out[0..4096], n, "cargo build --release -p t27c -p tri -p t27b"));
    assert(rl_has(out[0..4096], n, "ditto -c -k --keepParent target/t27os/pub/T27OS target/t27os/pub/T27OS-0.1.1.zip"));
    assert(rl_has(out[0..4096], n, "tri t27os manifest --build"));
    assert(rl_has(out[0..4096], n, "gh release create t27os-v0.1.1-b<build> "));
    assert(rl_has(out[0..4096], n, "gh release upload t27os-latest target/t27os/pub/t27os-release.t27 --clobber"));
    assert(rl_has(out[0..4096], n, "the plan only; nothing below was run"));
    assert(rl_has(out[0..4096], n, "1. build"));
    assert(rl_has(out[0..4096], n, "6. publish"));
}

test the_publish_script_builds_from_one_clean_commit_and_checks_before_it_publishes {
    var out : [4096]u8 = undefined;
    const n : usize = publish_text(out[0..4096], 4096, pack_version(0, 1, 1));
    assert(n < 4096);
    assert(rl_has(out[0..4096], n, "set -e\n"));
    assert(rl_has(out[0..4096], n, "git status --porcelain --untracked-files=no"));
    assert(rl_has(out[0..4096], n, "TAG=t27os-v0.1.1-b$B\n"));
    assert(rl_has(out[0..4096], n, "Z=T27OS-0.1.1.zip\n"));
    assert(rl_has(out[0..4096], n, "export T27_BUILD=$B T27_COMMIT=$C\ncargo build --release -p t27c -p tri -p t27b\nmake t27os T27OS_BUILD=$B"));
    assert(rl_has(out[0..4096], n, "ditto -c -k --keepParent $P/T27OS $P/$Z"));
    assert(rl_has(out[0..4096], n, "grep -q \" commit $S\""));
    assert(rl_has(out[0..4096], n, "test -d $P/chk/T27OS/T27OS.app; test -f $P/chk/T27OS/t27os-pty; codesign -v"));
    assert(rl_has(out[0..4096], n, "gh release create $TAG $P/$Z"));
    assert(rl_has(out[0..4096], n, "--latest=false"));
    assert(rl_has(out[0..4096], n, "gh release upload t27os-latest $P/t27os-release.t27 --clobber"));
    // the checks come before the first gh call
    assert(find_pos(out[0..4096], n, "codesign -v") < find_pos(out[0..4096], n, "gh release create $TAG"));
}

fn find_pos(buf : []const u8, n : usize, needle : str) -> usize {
    var i : usize = 0;
    while (i + needle.len <= n) {
        if (starts_here(buf, n, i, needle, needle.len)) { return i; }
        i += 1;
    }
    return n;
}

test publishing_is_refused_without_the_owners_yes_and_the_plan_never_publishes {
    assert(publish_allowed(true, true) == false);
    assert(publish_allowed(true, false) == false);
    assert(publish_allowed(false, false) == false);
    assert(publish_allowed(false, true));
    assert(REFUSAL_LEN == REFUSAL.len);
}

test the_zip_row_and_the_urls_are_matched_by_version_and_build_without_a_buffer {
    var sums : [1024]u8 = undefined;
    const v : u64 = pack_version(0, 1, 1);
    const sn : usize = rl_test_sums(sums[0..1024], 1024, v, 'a', 'b', 'd', 'e', 'f');
    assert(sums_row_zip(sums[0..1024], sn, v) != NO_FIELD);
    assert(sums_row_zip(sums[0..1024], sn, pack_version(0, 1, 2)) == NO_FIELD);
    assert(sums_row_zip(sums[0..1024], sn, pack_version(0, 1, 11)) == NO_FIELD);
    assert(sums_row_zip(sums[0..1024], sn, pack_version(10, 1, 1)) == NO_FIELD);
    assert(sums_row_zip("", 0, v) == NO_FIELD);
    const u : str = "\"https://github.com/gHashTag/t27/releases/download/t27os-v0.1.1-b4460/T27OS-0.1.1.zip\"";
    const f : u64 = ((1 as u64) << 32) | ((u.len - 2) as u64);
    assert(url_is_expected(u, f, v, 4460, false));
    assert(url_is_expected(u, f, v, 4461, false) == false);
    assert(url_is_expected(u, f, v, 446, false) == false);
    assert(url_is_expected(u, f, pack_version(0, 1, 2), 4460, false) == false);
    assert(url_is_expected(u, f, v, 4460, true) == false);
    const n : str = "\"https://github.com/gHashTag/t27/releases/tag/t27os-v0.1.1-b4460\"";
    assert(url_is_expected(n, ((1 as u64) << 32) | ((n.len - 2) as u64), v, 4460, true));
    const z : str = "\"https://github.com/gHashTag/t27/releases/tag/t27os-v0.1.1-b04460\"";
    assert(url_is_expected(z, ((1 as u64) << 32) | ((z.len - 2) as u64), v, 4460, true) == false);
}
