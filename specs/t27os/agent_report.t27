// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agent_report.t27 -- the rows of the agent-work report: what a thread is called, who runs it,
; which state it is in, its check counts, and how the rows are ordered and measured.
; Owner, 2026-11-01: report on the work of the agents online, with a dashboard. This spec is the durable data
; model behind the one-off inline snapshot, so a T27 OS tile can later draw the same rows from a feed.
; Rules (owner): every thread has an issue number, so a row with issue number 0 is flagged no-issue; a percent is
; shown only with its countable source done / total, and with total 0 the row reads "not measured" (epic-progress
; rule, 2026-10-26), never 0 and never an invented number.
; This is a pure module: no @extern and no window wiring. The host draws the text, this spec only decides.

module T27osAgentReport;

/// Thread states, in the order a report lists them: blocked first, then running, idle, done.
pub const AR_STATE_BLOCKED : u8 = 0;
pub const AR_STATE_RUNNING : u8 = 1;
pub const AR_STATE_IDLE : u8 = 2;
pub const AR_STATE_DONE : u8 = 3;

/// A state code outside the four ranks after all of them, so a corrupt row sinks to the bottom.
pub const AR_RANK_UNKNOWN : u8 = 4;

/// Issue number 0 means the thread has no issue; every thread must have one.
pub const AR_NO_ISSUE_NUMBER : u32 = 0;

/// The visual-core impact of a thread that touches no visual core.
pub const AR_IMPACT_INTERNAL : str = "internal-only";

/// What a row reads in place of a percent whose total is 0.
pub const AR_NOT_MEASURED_TEXT : str = "not measured";

/// One thread of agent work.
pub struct AgentReportRow {
    issue_number: u32,
    title: str,
    agent_name: str,
    state: u8,
    pass_count: u32,
    fail_count: u32,
    pending: u32,
    impact: str,
}

/// Whether the percent of done / total is measured at all: only a countable total counts.
pub fn ar_percent_known(total: u32) -> bool {
    return total > 0;
}

/// done / total as a whole percent. 0 when total is 0 (ask ar_percent_known first: 0 there means
/// "not measured", not zero percent); done is clamped to total, so the result is never above 100.
/// The product is formed in u64, so a large done cannot overflow.
pub fn ar_percent(done: u32, total: u32) -> u32 {
    if (total == 0) { return 0; }
    if (done >= total) { return 100; }
    return ((done as u64) * 100 / (total as u64)) as u32;
}

/// Whether an issue number is the no-issue number.
pub fn ar_no_issue(issue_number: u32) -> bool {
    return issue_number == AR_NO_ISSUE_NUMBER;
}

/// Whether a row carries the no-issue flag.
pub fn ar_row_no_issue(row: AgentReportRow) -> bool {
    return ar_no_issue(row.issue_number);
}

/// The word a state is printed as.
pub fn ar_state_to_str(state: u8) -> str {
    if (state == AR_STATE_BLOCKED) { return "blocked"; }
    if (state == AR_STATE_RUNNING) { return "running"; }
    if (state == AR_STATE_IDLE) { return "idle"; }
    if (state == AR_STATE_DONE) { return "done"; }
    return "unknown";
}

/// Where a state sits in the report: blocked 0, running 1, idle 2, done 3, anything else last.
pub fn ar_state_rank(state: u8) -> u8 {
    if (state == AR_STATE_BLOCKED) { return 0; }
    if (state == AR_STATE_RUNNING) { return 1; }
    if (state == AR_STATE_IDLE) { return 2; }
    if (state == AR_STATE_DONE) { return 3; }
    return AR_RANK_UNKNOWN;
}

/// -1 when state a is listed before state b, 1 when after, 0 when equal.
pub fn ar_compare_state(a: u8, b: u8) -> i8 {
    const ra : u8 = ar_state_rank(a);
    const rb : u8 = ar_state_rank(b);
    if (ra < rb) { return -1; }
    if (ra > rb) { return 1; }
    return 0;
}

/// The row order: by state only. Rows of one state compare equal, so a stable sort keeps the input order inside a state.
pub fn ar_row_compare(a: AgentReportRow, b: AgentReportRow) -> i8 {
    return ar_compare_state(a.state, b.state);
}

/// A fixture row for the tests: a given issue number and state, one pending check, internal-only impact.
pub fn ar_fixture_row(issue_number: u32, state: u8) -> AgentReportRow {
    return AgentReportRow { issue_number: issue_number, title: "fixture", agent_name: "claude", state: state, pass_count: 0, fail_count: 0, pending: 1, impact: AR_IMPACT_INTERNAL };
}

test percent_shows_done_over_total {
    assert ar_percent(2, 4) == 50;
    assert ar_percent(3, 4) == 75;
    assert ar_percent(1, 1) == 100;
    assert ar_percent(10, 20) == 50;
    assert ar_percent_known(4);
}

test zero_percent_with_a_total_is_measured {
    assert ar_percent(0, 5) == 0;
    assert ar_percent_known(5);
    assert ar_percent(0, 100) == 0;
    assert ar_percent_known(100);
}

test zero_total_is_not_measured {
    assert ar_percent(0, 0) == 0;
    assert ar_percent_known(0) == false;
    assert ar_percent(5, 0) == 0;
    assert AR_NOT_MEASURED_TEXT == "not measured";
}

test done_above_total_is_clamped_to_100 {
    assert ar_percent(9, 4) == 100;
    assert ar_percent(5, 4) == 100;
    assert ar_percent(4, 4) == 100;
}

test large_counts_do_not_overflow {
    assert ar_percent(4000000000, 4000000001) == 99;
    assert ar_percent(2000000000, 4000000000) == 50;
}

test an_issue_number_of_zero_is_flagged {
    assert ar_no_issue(0);
    assert ar_no_issue(13019) == false;
    assert ar_row_no_issue(ar_fixture_row(0, AR_STATE_IDLE));
    assert ar_row_no_issue(ar_fixture_row(13019, AR_STATE_IDLE)) == false;
}

test state_words_match_the_codes {
    assert ar_state_to_str(AR_STATE_BLOCKED) == "blocked";
    assert ar_state_to_str(AR_STATE_RUNNING) == "running";
    assert ar_state_to_str(AR_STATE_IDLE) == "idle";
    assert ar_state_to_str(AR_STATE_DONE) == "done";
    assert ar_state_to_str(255) == "unknown";
}

test states_compare_blocked_running_idle_done {
    assert ar_compare_state(AR_STATE_BLOCKED, AR_STATE_RUNNING) == -1;
    assert ar_compare_state(AR_STATE_BLOCKED, AR_STATE_IDLE) == -1;
    assert ar_compare_state(AR_STATE_BLOCKED, AR_STATE_DONE) == -1;
    assert ar_compare_state(AR_STATE_RUNNING, AR_STATE_IDLE) == -1;
    assert ar_compare_state(AR_STATE_RUNNING, AR_STATE_DONE) == -1;
    assert ar_compare_state(AR_STATE_IDLE, AR_STATE_DONE) == -1;
}

test states_compare_the_other_way_round {
    assert ar_compare_state(AR_STATE_RUNNING, AR_STATE_BLOCKED) == 1;
    assert ar_compare_state(AR_STATE_IDLE, AR_STATE_BLOCKED) == 1;
    assert ar_compare_state(AR_STATE_DONE, AR_STATE_BLOCKED) == 1;
    assert ar_compare_state(AR_STATE_IDLE, AR_STATE_RUNNING) == 1;
    assert ar_compare_state(AR_STATE_DONE, AR_STATE_RUNNING) == 1;
    assert ar_compare_state(AR_STATE_DONE, AR_STATE_IDLE) == 1;
}

test a_state_equals_itself_and_an_unknown_state_sorts_last {
    assert ar_compare_state(AR_STATE_BLOCKED, AR_STATE_BLOCKED) == 0;
    assert ar_compare_state(AR_STATE_RUNNING, AR_STATE_RUNNING) == 0;
    assert ar_compare_state(AR_STATE_IDLE, AR_STATE_IDLE) == 0;
    assert ar_compare_state(AR_STATE_DONE, AR_STATE_DONE) == 0;
    assert ar_compare_state(AR_STATE_DONE, 9) == -1;
    assert ar_compare_state(9, AR_STATE_BLOCKED) == 1;
}

test three_threads_order_blocked_running_done {
    const blocked : AgentReportRow = ar_fixture_row(13019, AR_STATE_BLOCKED);
    const running : AgentReportRow = ar_fixture_row(13020, AR_STATE_RUNNING);
    const done : AgentReportRow = ar_fixture_row(13021, AR_STATE_DONE);
    assert ar_row_compare(blocked, running) == -1;
    assert ar_row_compare(running, done) == -1;
    assert ar_row_compare(blocked, done) == -1;
    assert ar_row_compare(done, blocked) == 1;
}

test rows_of_one_state_keep_the_input_order {
    const first : AgentReportRow = ar_fixture_row(9, AR_STATE_RUNNING);
    const second : AgentReportRow = ar_fixture_row(2, AR_STATE_RUNNING);
    assert ar_row_compare(first, second) == 0;
    assert ar_row_compare(second, first) == 0;
}
