        const port:u64=lu_m0(lu_string(self,lu_get(self,105)),lu_sel("longLongValue"));
        if(!(if(routed) dn_pair(directory,lu_string(self,lu_get(self,106))) else sc_pair(p,lu_string(self,lu_get(self,106)),va_ipv4(raw[0..n]),port))) {
            if(sc_stat(p,false,114)==2) {
                lu_error(self,"Existing friend history is invalid/unreadable; preserved unchanged. Pairing refused.");
            }
            else {
                lu_error(self,"Pair refused: check PUBLIC card and exact selected endpoint.");
            }
        }
        else {
            lu_text(self,lu_get(self,106),lu_cf(""));
            lu_status(self,"Card selected. Connect, then compare codes. This number is only a label.");
        }
    }
    if(tag==2) {
        if(!(if(routed) dn_connect(directory,false) else sc_connect(p,false))) {
            lu_error(self,"Chat connect refused: pair first or finish current session.");
        }
    }
    if(tag==3) {
        sc_action(p,false,1);
    }
    if(tag==4) {
        sc_action(p,false,3);
    }
    if(tag==5) {
        sc_action(p,false,4);
    }
    if(tag==6 and sc_media_select(p,false) and sc_listen_select(p,false) and lu_audio_ready(self)) {
        if(routed) {
            dn_connect(directory,true);
        }
        else {
            sc_connect(p,true);
        }
    }
    if(tag==7 and sc_media_select(p,false) and sc_listen_select(p,false) and lu_audio_ready(self)) {
        sc_action(p,true,1);
    }
    if(tag==8) {
        sc_action(p,true,3);
    }
    if(tag==9) {
        sc_action(p,true,4);
    }
    if(tag==10) {
        const mute:u64=lu_val(self,111);
        sc_action(p,true,if(mute==0) 6 else 7);
        lu_mark(self,111,if(mute==0) 1 else 0);
