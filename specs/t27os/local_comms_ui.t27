pub fn lu_pressed(self:u64,command:u64,sender:u64)->void {
    lu_dispatch(self,lu_m0(sender,lu_sel("tag")));
}
fn lu_code_text(code:u64,out:[]u8)->usize {
    if(code==0) {
        return 0;
    }
    var i:usize=0;
    while(i<6) {
        out[5-i]=@as(u8,@intCast((code>>@as(u6,@intCast(i*8)))&255));
        i=i+1;
    }
    return 6;
}
fn lu_render(self:u64)->void {
    const p:u64=lu_ctx(self);
    const serial:u64=sc_video_stat(p,18);
    if(serial!=0 and serial!=lu_val(self,124) and sc_state(p,true)==4) {
        const data:u64=sc_video_data(p);
        if(data!=0) {
            const image:u64=lu_auto(lu_m1(lu_m0(lu_cls(if(lu_mobile(self)) "UIImage" else "NSImage"),lu_sel("alloc")),lu_sel("initWithData:"),data));
            if(image!=0) {
                lu_m1(lu_get(self,123),lu_sel("setImage:"),image);
                lu_mark(self,124,serial);
            }
            lu_release(data);
        }
    }
    if(sc_state(p,true)!=4) {
        lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    }
    const chat:u32=sc_state(p,false);
    const audio:u32=sc_state(p,true);
    const cc:u64=sc_code(p,false);
    const ac:u64=sc_code(p,true);
    const status:u64=lu_new("NSMutableString");
    const error:u64=lu_get(self,122);
    if(error!=0) {
        lu_m1(status,lu_sel("appendString:"),error);
        lu_m1(status,lu_sel("appendString:"),lu_cf("\n"));
    }
    lu_m1(status,lu_sel("appendString:"),lu_cf(if(chat==4) "Chat verified / encrypted" else if(chat==3) "Chat: compare both devices" else if(chat==2) "Incoming chat - Answer or Decline" else if(chat==1) "Connecting chat" else "Chat idle / ended"));
    if(sc_stat(p,true,136)==1) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\nListening only: microphone off; silence sent as keepalive."));
    }
    if(audio==4 and sc_stat(p,true,22)!=0) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\nMicrophone muted"));
    }
    var digits:[6]u8=undefined;
    if(chat==3 and lu_code_text(cc,digits[0..6])==6) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("  "));
        lu_m1(status,lu_sel("appendString:"),lu_cf(digits[0..6]));
    }
    const source:u64=sc_stat(p,true,131);
    if(source!=0) {
        lu_m1(status,lu_sel("appendString:"),lu_cf(if(source==2) "\nVIDEO SOURCE: moving TEST frames (no camera)" else if(sc_stat(p,true,130)==2) "\nVIDEO SOURCE: live camera" else if(sc_stat(p,true,130)==3) "\nCamera unavailable/denied; no fallback test frames" else "\nCamera starting; no frames until available"));
    }
    lu_m1(status,lu_sel("appendString:"),lu_cf(if(audio==4) if(sc_stat(p,true,132)==6) "\nVideo-only channel verified; microphone off" else "\nAudio connected" else if(audio==3) if(ac==0) "\nWaiting for verified peer identity and code..." else "\nAudio: compare both devices" else if(audio==2) "\nIncoming audio" else if(audio==1) "\nCalling audio" else if(audio>=5) lu_call_ended_text(sc_stat(p,true,133)) else "\nMicrophone off"));
    if(audio==3 and lu_code_text(ac,digits[0..6])==6) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("  "));
        lu_m1(status,lu_sel("appendString:"),lu_cf(digits[0..6]));
    }
    if(dn_endpoint(lu_val(self,130))!=0) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\n"));
        lu_m1(status,lu_sel("appendString:"),dn_status(lu_val(self,130)));
    }
    lu_text(self,lu_get(self,103),status);
    const transcript:u64=sc_transcript(p);
    lu_m1(lu_get(self,107),lu_sel(if(lu_mobile(self)) "setText:" else "setString:"),transcript);
    lu_m1(lu_get(self,304),lu_sel("setEnabled:"),if(chat==3 and cc!=0) 1 else 0);
    lu_m1(lu_get(self,308),lu_sel("setEnabled:"),if(audio==3 and ac!=0) 1 else 0);
}
pub fn lu_tick(self:u64,command:u64,timer:u64)->void {
    const p:u64=lu_ctx(self);
    if(p==0) {
        return;
    }
    dn_tick(lu_val(self,130));
    sc_tick(p);
    if(sc_state(p,true)==0 or sc_state(p,true)>=5) {
        lu_audio_deactivate(self);
    }
    if(lu_mobile(self)) {
        lu_idle(self,lu_val(self,115)==1 and (sc_state(p,true)==4 or lu_val(self,116)==1));
    }
    const tick:u64=lu_val(self,112)+1;
    lu_mark(self,112,tick);
    if(tick%30==0) {
        lu_render(self);
        if(lu_val(self,116)==1) {
            lu_control(self);
        }
    }
}
pub fn lu_inactive(self:u64,command:u64,event:u64)->void {
    lu_mark(self,115,0);
    const p:u64=lu_ctx(self);
    sc_visible(p,false);
    sc_video_stop(p);
    sc_action(p,true,5);
    if(lu_mobile(self)) {
        lu_idle(self,false);
        lu_audio_deactivate(self);
    }
}
pub fn lu_active(self:u64,command:u64,event:u64)->void {
    lu_mark(self,115,1);
    sc_visible(lu_ctx(self),true);
}
pub fn lu_closed(self:u64,command:u64,event:u64)->void {
    const p:u64=lu_ctx(self);
    lu_m0(lu_get(self,110),lu_sel("invalidate"));
    const directory:u64=lu_val(self,130);
    lu_mark(self,130,0);
    dn_close(directory);
    sc_close(p);
    if(lu_mobile(self)) {
        lu_idle(self,false);
        lu_audio_deactivate(self);
    }
    lu_mark(self,102,0);
}
