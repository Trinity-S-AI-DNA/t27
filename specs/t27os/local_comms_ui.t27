fn lu_audio_ready(self:u64)->bool {
    if(!lu_mobile(self)) {
        const capture:u64=lu_cls("AVCaptureDevice");
        const authorization:u64=lu_m1(capture,lu_sel("authorizationStatusForMediaType:"),lu_cf("soun"));
        if(authorization==3) {
            return true;
        }
        if(authorization==0) {
            lu_permission_request(self,capture);
            lu_error(self,"Allow this Unified Local Preview microphone, then tap Call or Answer audio again.");
        }
        else {
            lu_error(self,"Microphone denied/restricted for Unified Local Preview. Chat remains available.");
        }
        return false;
    }
    lu_idle(self,true);
    const session:u64=lu_m0(lu_cls("AVAudioSession"),lu_sel("sharedInstance"));
    const permission:u64=lu_m0(session,lu_sel("recordPermission"));
    if(permission!=1735552628) {
        if(permission==1970168948) {
            lu_permission_request(self,session);
            lu_error(self,"Allow microphone, then tap Call or Answer audio again.");
        }
        else {
            lu_error(self,"Microphone denied. Chat works independently; audio remains off.");
        }
        return false;
    }
    if(lu_val(self,128)==1) {
        return true;
    }
    const diagnostic:u64=lu_new("NSMutableDictionary");
    lu_set(self,126,diagnostic,1);
    lu_record(diagnostic,"microphonePermission",permission);
    const category_ok:u64=lu_m3(session,lu_sel("setCategory:withOptions:error:"),lu_cf("AVAudioSessionCategoryPlayAndRecord"),8,0)%256;
    lu_record(diagnostic,"categoryOK",category_ok);
    if(category_ok==0) {
        return false;
    }
    const active_ok:u64=lu_m2(session,lu_sel("setActive:error:"),1,0)%256;
    lu_record(diagnostic,"activeOK",active_ok);
    lu_m2(diagnostic,lu_sel("setObject:forKey:"),lu_m0(session,lu_sel("category")),lu_cf("category"));
    lu_m2(diagnostic,lu_sel("setObject:forKey:"),lu_m0(session,lu_sel("mode")),lu_cf("mode"));
    lu_record(diagnostic,"sampleRate",@as(u64,@intFromFloat(lu_real(session,lu_sel("sampleRate")))));
    lu_record(diagnostic,"inputChannels",lu_m0(session,lu_sel("inputNumberOfChannels")));
    lu_record(diagnostic,"outputChannels",lu_m0(session,lu_sel("outputNumberOfChannels")));
    const route:u64=lu_m0(session,lu_sel("currentRoute"));
    lu_record(diagnostic,"routeInputs",lu_m0(lu_m0(route,lu_sel("inputs")),lu_sel("count")));
    lu_record(diagnostic,"routeOutputs",lu_m0(lu_m0(route,lu_sel("outputs")),lu_sel("count")));
    if(active_ok==0) {
        lu_error(self,"Audio session activation refused; microphone remains off.");
        return false;
    }
    lu_mark(self,128,1);
    return true;
}
fn lu_dispatch(self:u64,tag:u64)->void {
