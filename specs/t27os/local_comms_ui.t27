            lu_text(self,lu_get(self,108),lu_cf(""));
        }
        else {
            lu_error(self,"Message was not durably queued. Verify channel and local storage.");
        }
    }
    if(tag==18) {
        var raw:[64]u8=undefined;
        const n:usize=lu_bytes(lu_string(self,lu_get(self,104)),raw[0..64]);
        const port:u64=lu_m0(lu_string(self,lu_get(self,105)),lu_sel("longLongValue"));
        if(!sc_direct(p,va_ipv4(raw[0..n]),port)) {
            lu_error(self,"Direct selection refused: pair first and end current calls.");
        }
    }
    if(tag==16 or tag==17) {
        var raw:[64]u8=undefined;
        const n:usize=lu_bytes(lu_string(self,lu_get(self,104)),raw[0..64]);
        const port:u64=lu_m0(lu_string(self,lu_get(self,105)),lu_sel("longLongValue"));
        if(!sc_relay(p,va_ipv4(raw[0..n]),port,if(tag==16) 1 else 2)) {
