            const item:u64=lu_new("NSMutableDictionary");
            lu_m2(item,lu_sel("setObject:forKey:"),sc_card(p),lu_cf("public.utf8-plain-text"));
            const options:u64=lu_new("NSMutableDictionary");
            lu_m2(options,lu_sel("setObject:forKey:"),lu_m1(lu_cls("NSNumber"),lu_sel("numberWithBool:"),1),lu_option("UIPasteboardOptionLocalOnly"));
            const items:u64=lu_m1(lu_cls("NSArray"),lu_sel("arrayWithObject:"),item);
            lu_m2(lu_m0(lu_cls("UIPasteboard"),lu_sel("generalPasteboard")),lu_sel("setItems:options:"),items,options);
        }
