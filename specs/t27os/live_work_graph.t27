// SPDX-License-Identifier: Apache-2.0
// specs/t27os/live_work_graph.t27 -- t27os: Live Work Graph, one screen
// showing all agent work online.
// Part of M7 milestone (milestone #11). Closes #13423.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::live_work_graph;

pub const LIVE_WORK_GRAPH_MAX_AGENTS : u32 = 27;

pub struct AgentWork { agent_id: str, online: bool };

pub fn agent_work_online(w: AgentWork) -> bool {
    return w.online;
}

test "agent_work_online" {
    assert(agent_work_online(AgentWork { agent_id: "agent-1", online: true }));
    assert(!agent_work_online(AgentWork { agent_id: "agent-2", online: false }));
}

invariant live_work_graph_max_agents_positive {
    assert LIVE_WORK_GRAPH_MAX_AGENTS > 0;
}