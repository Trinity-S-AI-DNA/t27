; specs/t27os/model_control_panel.t27 -- THE MODEL PANEL, decision half: the four questions the owner
; asked (epic #13172) and the rows that answer them. glass_window.t27 only draws what this places.
; --
; The four questions, in the owner's order:
;   1. WHAT IS RUNNING NOW        -> q_running, and a row per attempt with running = 1;
;   2. WHY THIS MODEL             -> q_why: the route reason, the rung it fell back from, the policy;
;   3. WHOSE CREDENTIALS          -> q_whose: the credential's source and slot, the account alias,
;                                    or "not-recorded" when the record does not know;
;   4. HOW MUCH WAS SPENT         -> q_spend: known, estimated, reserved and the count of unknown
;                                    rows, with "unknown N (not counted)" -- never a zero.
; --
; Laws this spec keeps:
;   - A ROW IS A TRACE RECORD. row_from_trace copies the trace spec's cells; the panel has no second
;     idea of what a request is.
;   - RESERVED IS NOT SPENT. Money held by an in-flight send is counted in its own column and only
;     for the rows that are still running, so a reservation cannot be counted twice.
;   - UNKNOWN IS A COUNT, NOT A ZERO. A row with no cost raises the unknown count; it adds nothing to
;     known or estimated.
;   - THE PANEL IS A PLACE IN THE WINDOW, NOT A NEW WINDOW. The geometry here is the right-hand
;     panel slot (the KEYS, DOCTOR, PROFILE slot), so glass_window can draw it beside them.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsModelControlPanel;

use t27os::model_trace::TR_REQUESTED_MODEL;
use t27os::model_trace::TR_RESOLVED_PROVIDER;
use t27os::model_trace::TR_ROUTE_REASON;
use t27os::model_trace::TR_FALLBACK_RUNG;
use t27os::model_trace::TR_POLICY;
use t27os::model_trace::TR_UPSTREAM;
use t27os::model_trace::TR_GATEWAY;
use t27os::model_trace::TR_BODY_CLASS;
use t27os::model_trace::TR_COST_KIND;
use t27os::model_trace::TR_COST_MICRO;
use t27os::model_trace::TR_ATTEMPT;
use t27os::model_trace::MT_OK;
use t27os::model_trace::CK_KNOWN;
use t27os::model_trace::CK_ESTIMATED;
use t27os::model_trace::CK_UNKNOWN;
use t27os::model_trace::RR_FALLBACK;
use t27os::model_trace::classify_pair;
use t27os::model_trace::ambiguous;
use t27os::model_trace::model_name;
use t27os::model_trace::provider_name;
use t27os::model_trace::route_word;
use t27os::model_trace::class_word;
use t27os::model_trace::cost_kind_word;
use t27os::model_trace::policy_word;
use t27os::model_trace::put_micro;
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;
use t27os::editors::same_bytes;

// ---- 1. A row of the panel ----

pub const MP_RUNNING : usize = 0;
pub const MP_COST_KIND : usize = 1;
pub const MP_COST_MICRO : usize = 2;
pub const MP_RESERVED : usize = 3;
pub const MP_MODEL : usize = 4;
pub const MP_PROVIDER : usize = 5;
pub const MP_ROUTE : usize = 6;
pub const MP_FALLBACK_RUNG : usize = 7;
pub const MP_POLICY : usize = 8;
pub const MP_UPSTREAM : usize = 9;
pub const MP_GATEWAY : usize = 10;
pub const MP_BODY_CLASS : usize = 11;
pub const MP_ATTEMPT : usize = 12;
pub const MP_CELLS : usize = 13;

/// Copy the trace record's cells into a panel row. `running` and `reserved` are the two facts the
/// trace cannot know by itself: the attempt is still open, and this much money is held for it.
pub fn row_from_trace(tr: []const u64, running: u64, reserved: u64, row: []u64) -> bool {
    row[MP_RUNNING] = running;
    row[MP_COST_KIND] = tr[TR_COST_KIND];
    row[MP_COST_MICRO] = tr[TR_COST_MICRO];
    row[MP_RESERVED] = reserved;
    row[MP_MODEL] = tr[TR_REQUESTED_MODEL];
    row[MP_PROVIDER] = tr[TR_RESOLVED_PROVIDER];
    row[MP_ROUTE] = tr[TR_ROUTE_REASON];
    row[MP_FALLBACK_RUNG] = tr[TR_FALLBACK_RUNG];
    row[MP_POLICY] = tr[TR_POLICY];
    row[MP_UPSTREAM] = tr[TR_UPSTREAM];
    row[MP_GATEWAY] = tr[TR_GATEWAY];
    row[MP_BODY_CLASS] = tr[TR_BODY_CLASS];
    row[MP_ATTEMPT] = tr[TR_ATTEMPT];
    return true;
}

// ---- 2. The totals ----

pub const MT_T_RUNNING : usize = 0;
pub const MT_T_KNOWN : usize = 1;
pub const MT_T_ESTIMATED : usize = 2;
pub const MT_T_RESERVED : usize = 3;
pub const MT_T_UNKNOWN : usize = 4;
pub const MT_T_COUNT : usize = 5;
pub const MT_T_CELLS : usize = 6;

/// Sum the rows. Reserved money is summed only for rows that are still running: a finished attempt's
/// reservation has already been reconciled into known or estimated.
pub fn totals(rows: []const u64, n: u32, out: []u64) -> void {
    var i : usize = 0;
    while (i < MT_T_CELLS) { out[i] = 0; i = i + 1; }
    var r : u32 = 0;
    while (r < n) {
        const b : usize = @as(usize, r) * MP_CELLS;
        const kind : u32 = @intCast(rows[b + MP_COST_KIND]);
        const micro : u64 = rows[b + MP_COST_MICRO];
        if (kind == CK_KNOWN) {
            out[MT_T_KNOWN] = out[MT_T_KNOWN] + micro;
        } else if (kind == CK_ESTIMATED) {
            out[MT_T_ESTIMATED] = out[MT_T_ESTIMATED] + micro;
        } else {
            out[MT_T_UNKNOWN] = out[MT_T_UNKNOWN] + 1;
        }
        if (rows[b + MP_RUNNING] != 0) {
            out[MT_T_RUNNING] = out[MT_T_RUNNING] + 1;
            out[MT_T_RESERVED] = out[MT_T_RESERVED] + rows[b + MP_RESERVED];
        }
        r = r + 1;
    }
    out[MT_T_COUNT] = @as(u64, n);
}

// ---- 3. The four answers ----

pub fn q_running(running: u32, total: u32, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "running: ");
    n = put_dec(out, n, @as(u64, running));
    n = put_bytes(out, n, " of ");
    n = put_dec(out, n, @as(u64, total));
    return n;
}

pub fn q_why(route: u32, rung: u32, policy: u32, out: []u8) -> usize {
    var w : [32]u8 = undefined;
    var n : usize = put_bytes(out, 0, "why: ");
    const rn : usize = route_word(route, w[0..32]);
    n = put_bytes(out, n, w[0..rn]);
    if (route == RR_FALLBACK) {
        n = put_bytes(out, n, " after rung ");
        n = put_dec(out, n, @as(u64, rung));
    }
    n = put_bytes(out, n, " (policy ");
    const pn : usize = policy_word(policy, w[0..32]);
    n = put_bytes(out, n, w[0..pn]);
    n = put_bytes(out, n, ")");
    return n;
}

/// The credential is named by source and slot; the account is a configured alias. When the record
/// never held one, the panel says so instead of leaving a blank that reads as "none".
pub fn q_whose(cred: []const u8, account_known: bool, account: []const u8, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "whose: ");
    n = put_bytes(out, n, cred);
    n = put_bytes(out, n, " account=");
    if (account_known) {
        n = put_bytes(out, n, account);
    } else {
        n = put_bytes(out, n, "not-recorded");
    }
    return n;
}

pub fn q_spend(t: []const u64, out: []u8) -> usize {
    var n : usize = put_bytes(out, 0, "spend: known usd ");
    n = put_micro(out, n, t[MT_T_KNOWN]);
    n = put_bytes(out, n, " | estimated usd ");
    n = put_micro(out, n, t[MT_T_ESTIMATED]);
    n = put_bytes(out, n, " | reserved usd ");
    n = put_micro(out, n, t[MT_T_RESERVED]);
    n = put_bytes(out, n, " | unknown ");
    n = put_dec(out, n, t[MT_T_UNKNOWN]);
    n = put_bytes(out, n, " (not counted)");
    return n;
}

/// One row: the attempt, the requested model, the provider that answered (or refused), the route,
/// the status pair, the class with its ambiguity flag, and the cost kind.
pub fn row_line(r: []const u64, out: []u8) -> usize {
    var w : [32]u8 = undefined;
    var n : usize = put_bytes(out, 0, "#");
    n = put_dec(out, n, r[MP_ATTEMPT]);
    n = put_bytes(out, n, " ");
    const mn : usize = model_name(@intCast(r[MP_MODEL]), w[0..32]);
    n = put_bytes(out, n, w[0..mn]);
    n = put_bytes(out, n, "->");
    const pn : usize = provider_name(@intCast(r[MP_PROVIDER]), w[0..32]);
    n = put_bytes(out, n, w[0..pn]);
    n = put_bytes(out, n, " ");
    const rn : usize = route_word(@intCast(r[MP_ROUTE]), w[0..32]);
    n = put_bytes(out, n, w[0..rn]);
    n = put_bytes(out, n, " ");
    n = put_dec(out, n, r[MP_UPSTREAM]);
    n = put_bytes(out, n, "/");
    n = put_dec(out, n, r[MP_GATEWAY]);
    n = put_bytes(out, n, " ");
    const cn : usize = class_word(classify_pair(@intCast(r[MP_GATEWAY]), @intCast(r[MP_BODY_CLASS])), w[0..32]);
    n = put_bytes(out, n, w[0..cn]);
    n = put_bytes(out, n, " amb=");
    if (ambiguous(@intCast(r[MP_GATEWAY]), @intCast(r[MP_BODY_CLASS]))) {
        n = put_bytes(out, n, "1");
    } else {
        n = put_bytes(out, n, "0");
    }
    n = put_bytes(out, n, " cost=");
    const kn : usize = cost_kind_word(@intCast(r[MP_COST_KIND]), w[0..32]);
    n = put_bytes(out, n, w[0..kn]);
    return n;
}

// ---- 4. The place in the window ----

pub const MP_NONE : u32 = 255;
pub const MP_PANEL_W : f64 = 400.0;
pub const MP_PAD : f64 = 16.0;
pub const MP_HEAD_H : f64 = 108.0;
pub const MP_ROW_H : f64 = 34.0;
pub const MP_CLOSE : f64 = 16.0;

/// The top of row i, where the panel's content starts at `top` (the workspace top).
pub fn mp_row_y(top : f64, i : u32) -> f64 {
    return top + MP_HEAD_H + @as(f64, @floatFromInt(i)) * MP_ROW_H;
}

/// The row under a point, or MP_NONE above the rows and below the last one.
pub fn mp_row_at(y : f64, top : f64, n : u32) -> u32 {
    if (y < top + MP_HEAD_H) { return MP_NONE; }
    const d : f64 = y - top - MP_HEAD_H;
    const i : u32 = @intCast(@as(u64, @intFromFloat(d / MP_ROW_H)));
    if (i >= n) { return MP_NONE; }
    return i;
}

/// The close box sits in the panel's header, right-aligned.
pub fn mp_close_x(sw : f64) -> f64 { return sw - MP_PAD - MP_CLOSE; }
pub fn mp_close_y(top : f64) -> f64 { return top + 14.0; }

pub fn on_mp_close(x : f64, y : f64, sw : f64, top : f64) -> bool {
    return x >= mp_close_x(sw) and x <= mp_close_x(sw) + MP_CLOSE and y >= mp_close_y(top) and y <= mp_close_y(top) + MP_CLOSE;
}

/// The panel owns the right-hand strip; a click inside it is the panel's, never the content's.
pub fn on_mp_panel(x : f64, y : f64, sw : f64, sh : f64, top : f64) -> bool {
    return x >= sw - MP_PANEL_W and y >= top and y <= sh;
}

// ---- 5. Tests ----

fn incident_trace() -> [23]u64 {
    var c : [23]u64 = undefined;
    var i : usize = 0;
    while (i < 23) { c[i] = 0; i = i + 1; }
    c[TR_REQUESTED_MODEL] = 0;
    c[TR_RESOLVED_PROVIDER] = 2;
    c[TR_ROUTE_REASON] = 1;
    c[TR_FALLBACK_RUNG] = 2;
    c[TR_POLICY] = 0;
    c[TR_UPSTREAM] = 402;
    c[TR_GATEWAY] = 503;
    c[TR_BODY_CLASS] = 1;
    c[TR_COST_KIND] = CK_UNKNOWN;
    c[TR_ATTEMPT] = 4;
    return c;
}

test a_row_is_the_trace_record_and_prints_the_status_pair {
    const tr : [23]u64 = incident_trace();
    var row : [MP_CELLS]u64 = undefined;
    assert row_from_trace(tr[0..23], 0, 0, row[0..MP_CELLS]);
    assert row[MP_MODEL] == 0;
    assert row[MP_PROVIDER] == 2;
    assert row[MP_UPSTREAM] == 402;
    assert row[MP_GATEWAY] == 503;
    var out : [96]u8 = undefined;
    const n : usize = row_line(row[0..MP_CELLS], out[0..96]);
    assert same_bytes(out[0..n], "#4 glm-4.5-flash->deepseek fallback 402/503 unfunded amb=1 cost=unknown");
}

test the_totals_keep_reserved_apart_and_count_unknowns {
    const tr : [23]u64 = incident_trace();
    var rows : [3 * MP_CELLS]u64 = undefined;
    // row 0: running, estimated 1370, reserved 2000
    var r0 : [MP_CELLS]u64 = undefined;
    assert row_from_trace(tr[0..23], 1, 2000, r0[0..MP_CELLS]);
    r0[MP_COST_KIND] = CK_ESTIMATED;
    r0[MP_COST_MICRO] = 1370;
    // row 1: finished, known 0 (a request that never left the node)
    var r1 : [MP_CELLS]u64 = undefined;
    assert row_from_trace(tr[0..23], 0, 0, r1[0..MP_CELLS]);
    r1[MP_COST_KIND] = CK_KNOWN;
    r1[MP_COST_MICRO] = 0;
    // row 2: refused, unknown, with a reservation that must NOT be counted (it is not running)
    var r2 : [MP_CELLS]u64 = undefined;
    assert row_from_trace(tr[0..23], 0, 500, r2[0..MP_CELLS]);
    r2[MP_COST_KIND] = CK_UNKNOWN;
    r2[MP_COST_MICRO] = 0;
    var k : usize = 0;
    while (k < MP_CELLS) {
        rows[k] = r0[k];
        rows[MP_CELLS + k] = r1[k];
        rows[2 * MP_CELLS + k] = r2[k];
        k = k + 1;
    }
    var t : [MT_T_CELLS]u64 = undefined;
    totals(rows[0..3 * MP_CELLS], 3, t[0..MT_T_CELLS]);
    assert t[MT_T_COUNT] == 3;
    assert t[MT_T_RUNNING] == 1;
    assert t[MT_T_KNOWN] == 0;
    assert t[MT_T_ESTIMATED] == 1370;
    assert t[MT_T_RESERVED] == 2000;
    assert t[MT_T_UNKNOWN] == 1;
}

test the_spend_line_names_every_kind_and_never_turns_an_unknown_into_zero {
    var t : [MT_T_CELLS]u64 = undefined;
    t[MT_T_RUNNING] = 1;
    t[MT_T_KNOWN] = 0;
    t[MT_T_ESTIMATED] = 1370;
    t[MT_T_RESERVED] = 2000;
    t[MT_T_UNKNOWN] = 1;
    t[MT_T_COUNT] = 3;
    var out : [160]u8 = undefined;
    const n : usize = q_spend(t[0..MT_T_CELLS], out[0..160]);
    assert same_bytes(out[0..n], "spend: known usd 0.000000 | estimated usd 0.001370 | reserved usd 0.002000 | unknown 1 (not counted)");
    // with no unknown row the count is 0 and the phrase still says what it means
    t[MT_T_UNKNOWN] = 0;
    const m : usize = q_spend(t[0..MT_T_CELLS], out[0..160]);
    assert same_bytes(out[0..m], "spend: known usd 0.000000 | estimated usd 0.001370 | reserved usd 0.002000 | unknown 0 (not counted)");
}

test the_four_answers_are_one_line_each {
    var out : [128]u8 = undefined;
    const a : usize = q_running(1, 3, out[0..128]);
    assert same_bytes(out[0..a], "running: 1 of 3");
    const b : usize = q_why(RR_FALLBACK, 2, 0, out[0..128]);
    assert same_bytes(out[0..b], "why: fallback after rung 2 (policy 2026-11-04.1)");
    const c : usize = q_whose("env:T27_DEEPSEEK_KEY#0", false, "", out[0..128]);
    assert same_bytes(out[0..c], "whose: env:T27_DEEPSEEK_KEY#0 account=not-recorded");
    const d : usize = q_whose("env:DSH_ZAI_POOL#2", true, "free-pool", out[0..128]);
    assert same_bytes(out[0..d], "whose: env:DSH_ZAI_POOL#2 account=free-pool");
}

test a_direct_route_does_not_claim_a_rung {
    var out : [96]u8 = undefined;
    const n : usize = q_why(0, 2, 0, out[0..96]);
    assert same_bytes(out[0..n], "why: direct (policy 2026-11-04.1)");
}

test the_panel_owns_its_strip_and_its_close_box {
    assert on_mp_panel(700.0, 200.0, 800.0, 600.0, 44.0);
    assert on_mp_panel(399.0, 200.0, 800.0, 600.0, 44.0) == false;
    assert on_mp_close(800.0 - 16.0 - 8.0, 44.0 + 20.0, 800.0, 44.0);
    assert on_mp_close(400.0, 200.0, 800.0, 44.0) == false;
    assert mp_row_y(44.0, 0) == 152.0;
    assert mp_row_y(44.0, 2) == 220.0;
    assert mp_row_at(150.0, 44.0, 3) == MP_NONE;
    assert mp_row_at(160.0, 44.0, 3) == 0;
    assert mp_row_at(200.0, 44.0, 3) == 1;
    assert mp_row_at(260.0, 44.0, 3) == MP_NONE;
    assert mp_row_at(200.0, 44.0, 1) == MP_NONE;
}
