// specs/t27os/agent_registry_view.t27 -- t27os: agent_registry_view --
// AN_SLUGS + VfGraph, 27 domains, no glass_window layout.
// Part of M7 milestone (milestone #11). Closes #13417.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::agent_registry_view;

pub const AGENT_REGISTRY_VIEW_MAX_DOMAINS : u32 = 27;

pub struct DomainView { slug: str, visible: bool };

pub fn domain_view_visible(d: DomainView) -> bool {
    return d.visible;
}

test "domain_view_visible" {
    assert(domain_view_visible(DomainView { slug: "agent-a", visible: true }));
    assert(!domain_view_visible(DomainView { slug: "agent-b", visible: false }));
}

invariant agent_registry_view_max_domains_positive {
    assert AGENT_REGISTRY_VIEW_MAX_DOMAINS > 0;
}