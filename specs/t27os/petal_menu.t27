// SPDX-License-Identifier: Apache-2.0
// specs/t27os/petal_menu.t27 -- T27OS UI: the 27-petal menu on the desktop
// window through one display list.
// Part of M1 (milestone #5). Closes #13299.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::petal_menu;

pub const PETAL_COUNT : u32 = 27;

pub struct PetalMenu { petals: [27]str, petal_count: u32 };

pub fn petal_menu_count(m: PetalMenu) -> u32 {
    return m.petal_count;
}

test "petal menu count" {
    assert(petal_menu_count(PetalMenu { petals: [_]str{""} ** 27, petal_count: 27 }) == 27);
}

invariant petal_count_is_27 {
    assert PETAL_COUNT == 27;
}