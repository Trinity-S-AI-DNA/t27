// SPDX-License-Identifier: Apache-2.0
; specs/t27os/release_verify.t27 -- the post-publish verify: one command, one verdict
; (Trinity-S-AI-DNA/t27#12479, Pareto variant 3). The publish step ships six files and points
; t27os-latest at a manifest; the boot gate once refused a stale artifact the hard way. This is
; the law of checking a published release AFTER the fact, before any computer polls it:
; the manifest passes manifest_check, the sums agree with it on every row, and the release
; listing carries the complete asset set. One word answers: OK, or the first thing wrong.
; --
; What already exists, and is NOT rebuilt here:
; - release.t27: the manifest law -- manifest_check (every field, URL and NOTES self-consistent
;   with the version and build), sums_verdict (digest agreement per row), manifest_from_sums
;   (the writer; the tests here build their fixture WITH it), the asset-name constants,
;   sums_row (the tests tamper one row through it, not through hand-counted offsets).
; - The app's own poll-and-swap rule stays in release.t27; this spec is the PUBLISHER's gate.
; ASCII only (L3), English. Every test uses fake digests built from repeated hex letters.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osReleaseVerify;

use t27os::release::manifest_check;
use t27os::release::manifest_from_sums;
use t27os::release::manifest_version;
use t27os::release::sums_verdict;
use t27os::release::sums_row;
use t27os::release::ROWS_ALL;
use t27os::release::put_zip_name;
use t27os::release::MANIFEST_ASSET;
use t27os::release::LIVE_ASSET;
use t27os::release::A_T27B;
use t27os::release::A_T27C;
use t27os::release::A_TRI;
use t27os::release::M_OK;
use t27os::release::NO_VERSION;
use t27os::release::pack_version;

; --- 1. The verdict vocabulary ----------------------------------------------------------------

pub const V_OK : u8 = 0;
pub const V_BAD_MANIFEST : u8 = 1;
pub const V_SUMS : u8 = 2;
pub const V_ASSETS : u8 = 3;
pub const VERDICT_NAMES : str = "ok,bad-manifest,sums,assets";

; --- 2. Small text helpers (self-contained; the shapes release.t27 uses) ----------------------

fn contains(s : []const u8, needle : []const u8) -> bool {
    if (needle.len == 0 or s.len < needle.len) { return false; }
    var i : usize = 0;
    while (i + needle.len <= s.len) {
        var j : usize = 0;
        while (j < needle.len and s[i + j] == needle[j]) { j += 1; }
        if (j == needle.len) { return true; }
        i += 1;
    }
    return false;
}

fn put_s(out : []u8, cap : usize, w : usize, s : []const u8) -> usize {
    var k : usize = w;
    var i : usize = 0;
    while (i < s.len) {
        if (k < cap) { out[k] = s[i]; }
        k += 1;
        i += 1;
    }
    return k;
}

fn put_digest(out : []u8, cap : usize, w : usize, d : u8) -> usize {
    var k : usize = w;
    var i : usize = 0;
    while (i < 64) {
        if (k < cap) { out[k] = d; }
        k += 1;
        i += 1;
    }
    return k;
}

fn put_line(out : []u8, cap : usize, w : usize, s : []const u8) -> usize {
    const k : usize = put_s(out, cap, w, s);
    return put_s(out, cap, k, "\n");
}

; --- 3. The asset set of a published release --------------------------------------------------

; The six files a publish must carry: the zip, the three tools, the manifest, the live data.
pub const REQUIRED_ASSET_COUNT : u32 = 6;

/// Every required asset name appears in the release listing. The zip's name is DERIVED from the
; version the manifest names (put_zip_name), so a listing of the wrong zip cannot pass.
pub fn assets_complete(listing : []const u8, man : []const u8, mn : usize, scratch : []u8, cap : usize) -> bool {
    const v : u64 = manifest_version(man, mn);
    if (v == NO_VERSION) { return false; }
    const zn : usize = put_zip_name(scratch, cap, 0, v);
    if (contains(listing, scratch[0..zn]) == false) { return false; }
    if (contains(listing, A_T27B) == false) { return false; }
    if (contains(listing, A_T27C) == false) { return false; }
    if (contains(listing, A_TRI) == false) { return false; }
    if (contains(listing, MANIFEST_ASSET) == false) { return false; }
    return contains(listing, LIVE_ASSET);
}

; --- 4. The one verdict ------------------------------------------------------------------------

/// The whole law in one call, in order -- the first failure is the answer:
/// 1. the manifest passes release.t27's manifest_check (every field, URLs self-consistent);
/// 2. the sums the publisher computed agree with the manifest on every row (zip, t27b, t27c,
///    tri, pane server) -- a stale zip or a re-uploaded tool without a manifest refresh fails here;
/// 3. the release listing carries all six assets.
/// Pure: the caller hands in the three texts and a scratch buffer for the derived zip name.
pub fn verify(man : []const u8, mn : usize, sums : []const u8, sn : usize,
    listing : []const u8, scratch : []u8, cap : usize) -> u8 {
    if (manifest_check(man, mn) != M_OK) { return V_BAD_MANIFEST; }
    if (sums_verdict(sums, sn, man, mn, 0, ROWS_ALL) != 0) { return V_SUMS; }
    if (assets_complete(listing, man, mn, scratch, cap) == false) { return V_ASSETS; }
    return V_OK;
}

; --- 5. Test fixture: the sums text in release.t27's shasum shape, built from pub writers ------

fn test_sums(out : []u8, cap : usize, v : u64, d0 : u8, d1 : u8, d2 : u8, d3 : u8, d4 : u8) -> usize {
    var w : usize = put_line(out, cap, 0, "COMMIT cccccccccccccccccccccccccccccccccccccccc");
    w = put_digest(out, cap, w, d0);
    w = put_s(out, cap, w, "  ");
    const zs : usize = put_zip_name(out, cap, w, v);
    w = put_line(out, cap, w, out[w..zs]);
    w = put_digest(out, cap, w, d1);
    w = put_s(out, cap, w, "  ");
    w = put_line(out, cap, w, A_T27B);
    w = put_digest(out, cap, w, d2);
    w = put_s(out, cap, w, "  ");
    w = put_line(out, cap, w, A_T27C);
    w = put_digest(out, cap, w, d3);
    w = put_s(out, cap, w, "  ");
    w = put_line(out, cap, w, A_TRI);
    w = put_digest(out, cap, w, d4);
    w = put_s(out, cap, w, "  ");
    return put_line(out, cap, w, "t27os-pty");
}

fn test_listing(out : []u8, cap : usize, v : u64, with_tri : bool) -> usize {
    const zs : usize = put_zip_name(out, cap, 0, v);
    var w : usize = put_line(out, cap, 0, out[0..zs]);
    w = put_line(out, cap, w, A_T27B);
    w = put_line(out, cap, w, A_T27C);
    if (with_tri) { w = put_line(out, cap, w, A_TRI); }
    w = put_line(out, cap, w, MANIFEST_ASSET);
    return put_line(out, cap, w, LIVE_ASSET);
}


; --- 6. Tests ----------------------------------------------------------------------------------

test a_good_release_verifies_ok {
    const v : u64 = pack_version(0, 2, 0);
    var sums : [512]u8 = undefined;
    const sn : usize = test_sums(sums[0..512], 512, v, 'a', 'b', 'c', 'd', 'e');
    var man : [1024]u8 = undefined;
    const mn : usize = manifest_from_sums(man[0..1024], 1024, v, 7554, sums[0..sn], sn);
    var scratch : [128]u8 = undefined;
    var listing : [256]u8 = undefined;
    const ln : usize = test_listing(listing[0..256], 256, v, true);
    assert mn > 0;
    assert manifest_check(man[0..mn], mn) == M_OK;
    assert verify(man[0..mn], mn, sums[0..sn], sn, listing[0..ln], scratch[0..128], 128) == V_OK;
}

test a_stale_zip_or_a_retouched_tool_breaks_the_sums {
    const v : u64 = pack_version(0, 2, 0);
    var sums : [512]u8 = undefined;
    const sn : usize = test_sums(sums[0..512], 512, v, 'a', 'b', 'c', 'd', 'e');
    var man : [1024]u8 = undefined;
    const mn : usize = manifest_from_sums(man[0..1024], 1024, v, 7554, sums[0..sn], sn);
    var scratch : [128]u8 = undefined;
    var listing : [256]u8 = undefined;
    const ln : usize = test_listing(listing[0..256], 256, v, true);
    // a tool re-uploaded without a manifest refresh: tamper the tri of the row digest through sums_row
    var s2 : [512]u8 = undefined;
    var k : usize = 0;
    while (k < sn) { s2[k] = sums[k]; k += 1; }
    const tri : u64 = sums_row(s2[0..sn], sn, A_TRI);
    assert tri != 18446744073709551615;
    s2[tri] = 122;
    assert verify(man[0..mn], mn, s2[0..sn], sn, listing[0..ln], scratch[0..128], 128) == V_SUMS;
    // the published zip of an OLDER version: row 0 names a different semver than the manifest
    var s3 : [512]u8 = undefined;
    const sn3 : usize = test_sums(s3[0..512], 512, pack_version(0, 1, 3), 'a', 'b', 'c', 'd', 'e');
    assert verify(man[0..mn], mn, s3[0..sn3], sn3, listing[0..ln], scratch[0..128], 128) == V_SUMS;
}

test a_release_missing_an_asset_fails_the_asset_set {
    const v : u64 = pack_version(0, 2, 0);
    var sums : [512]u8 = undefined;
    const sn : usize = test_sums(sums[0..512], 512, v, 'a', 'b', 'c', 'd', 'e');
    var man : [1024]u8 = undefined;
    const mn : usize = manifest_from_sums(man[0..1024], 1024, v, 7554, sums[0..sn], sn);
    var scratch : [128]u8 = undefined;
    var listing : [256]u8 = undefined;
    const ln : usize = test_listing(listing[0..256], 256, v, false);
    assert verify(man[0..mn], mn, sums[0..sn], sn, listing[0..ln], scratch[0..128], 128) == V_ASSETS;
}

test a_manifest_that_is_not_a_manifest_fails_first {
    const v : u64 = pack_version(0, 2, 0);
    var sums : [512]u8 = undefined;
    const sn : usize = test_sums(sums[0..512], 512, v, 'a', 'b', 'c', 'd', 'e');
    var scratch : [128]u8 = undefined;
    var listing : [256]u8 = undefined;
    const ln : usize = test_listing(listing[0..256], 256, v, true);
    let junk : []const u8 = "module Something;\npub const A : u32 = 1;\n";
    assert verify(junk, junk.len, sums[0..sn], sn, listing[0..ln], scratch[0..128], 128) == V_BAD_MANIFEST;
}

; --- 7. Invariants -----------------------------------------------------------------------------

invariant the_verdict_vocabulary_is_four_words {
    assert V_OK == 0 and V_BAD_MANIFEST == 1 and V_SUMS == 2 and V_ASSETS == 3;
    assert REQUIRED_ASSET_COUNT == 6;
}
