// SPDX-License-Identifier: Apache-2.0
// specs/t27os/coder_registry_contract.t27 -- t27os: coder registry contract --
// provider, transport, evidence level, errand, permission, recovery for Claude
// Code, DSH, Codex, Gemini.
// Part of M8 milestone (milestone #12). Closes #13076.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::coder_registry_contract;

pub const CODER_REGISTRY_MAX_PROVIDERS : u32 = 8;

pub struct CoderRegistryEntry { provider: str, evidence_level: u32 };

pub fn coder_registry_entry_evidence_level(e: CoderRegistryEntry) -> u32 {
    return e.evidence_level;
}

test "coder_registry_entry_evidence_level" {
    assert(coder_registry_entry_evidence_level(CoderRegistryEntry { provider: "Claude Code", evidence_level: 3 }) == 3);
    assert(coder_registry_entry_evidence_level(CoderRegistryEntry { provider: "DSH", evidence_level: 1 }) == 1);
}

invariant coder_registry_max_providers_positive {
    assert CODER_REGISTRY_MAX_PROVIDERS > 0;
}