// ---- Enhanced Chat Input Constants ----

pub const CHAT_INPUT_MAX_HEIGHT : u32 = 120;  // Максимальная высота input в пикселях
pub const CHAT_INPUT_MIN_HEIGHT : u32 = 44;   // Минимальная высота input в пикселях
pub const CHAT_INPUT_PADDING : u32 = 16;      // Padding для input
pub const CHAT_SEND_BUTTON_WIDTH : u32 = 80;  // Ширина кнопки Send

// ---- Chat Input State ----

pub var chat_input_state : struct {
    input_text: str,               // Текст в input
    is_composing: bool,            // Для IME support
    is_focused: bool,              // Фокус на input
    cursor_position: u32,          // Позиция курсора
    selection_start: u32,          // Начало выделения
    selection_end: u32,            // Конец выделения
    message_count: u32,           // Количество сообщений
    is_connected: bool,           // Статус подключения
    last_sent_message: str        // Последнее отправленное сообщение
};

// ---- Chat Input Functions ----

/// Initialize chat input state
pub fn init_chat_input() -> void {
    chat_input_state.input_text = "";
    chat_input_state.is_composing = false;
    chat_input_state.is_focused = false;
    chat_input_state.cursor_position = 0;
    chat_input_state.selection_start = 0;
    chat_input_state.selection_end = 0;
    chat_input_state.message_count = 0;
    chat_input_state.is_connected = true;
    chat_input_state.last_sent_message = "";

    log_message("🔤 Chat input initialized");
}

/// Auto-resize input textarea based on content
pub fn auto_resize_input(textarea_height: *u32) -> void {
    // Calculate content height
    const line_count : u32 = count_newlines(chat_input_state.input_text) + 1;
    const content_height : u32 = line_count * 20;  // ~20px per line

    // Clamp between min and max height
    *textarea_height = content_height;
    if (*textarea_height < CHAT_INPUT_MIN_HEIGHT) {
        *textarea_height = CHAT_INPUT_MIN_HEIGHT;
    } else if (*textarea_height > CHAT_INPUT_MAX_HEIGHT) {
        *textarea_height = CHAT_INPUT_MAX_HEIGHT;
    }
}

/// Count newlines in text
fn count_newlines(text: str) -> u32 {
    let count : u32 = 0;
    for (var i: u32 = 0; i < text.len; i += 1) {
        if (text[i] == '\n') {
            count += 1;
        }
    }
    return count;
}

/// Handle chat-specific Enter key (send message instead of newline)
pub fn handle_chat_enter(key: u32, cp: u32, flags: u32, appcur: bool, out: []u8) -> u32 {
    const shift : bool = tk_has(flags, TK_FLAG_SHIFT);
    const ctrl : bool = tk_has(flags, TK_FLAG_CONTROL);
    const cmd : bool = tk_has(flags, TK_FLAG_COMMAND);

    // Regular Enter sends message to chat
    if (key == VK_RETURN or key == VK_ENTER_PAD) {
        if (chat_input_state.input_text.len > 0) {
            send_chat_message(chat_input_state.input_text);
            chat_input_state.input_text = "";
            auto_resize_input(&chat_input_state.cursor_position); // Reset height
        }
        return 0;  // Don't send CR to terminal
    }

    // Shift+Enter for new line in chat
    if (key == VK_RETURN and shift) {
        return tk_esc(out, 13);  // ESC CR for newline
    }

    // Other cases - normal terminal handling
    return tk_key_bytes(key, cp, flags, appcur, out);
}

/// Send chat message
fn send_chat_message(message: str) -> void {
    log_message(@concat("💬 Sending: ", message));

    // Update UI state
    chat_input_state.message_count += 1;
    chat_input_state.last_sent_message = message;

    // Send to Queen orchestrator
    if (queen_chat_orchestrator_active) {
        process_queen_chat_message(message);
    }

    // Visual feedback
    show_send_animation();
}

/// Process message in Queen chat system
fn process_queen_chat_message(message: str) -> void {
    // This would integrate with queen-chat-orchestrator.t27
    log_message(@concat("👑 Queen: Processing message: ", message));
}

/// Show send animation
fn show_send_animation() -> void {
    // Visual feedback that message was sent
    log_message("✈️ Message sent animation");
}

/// Focus input on click
pub fn focus_input() -> void {
    chat_input_state.is_focused = true;
    log_message("🔤 Input focused");
}

/// Handle input composition (IME support)
pub fn handle_composition_start() -> void {
    chat_input_state.is_composing = true;
    log_message("🔤 Composition started");
}

pub fn handle_composition_end() -> void {
    chat_input_state.is_composing = false;
    log_message("🔤 Composition ended");
}

/// Handle click outside (blur)
pub defocus_input() -> void {
    chat_input_state.is_focused = false;
    log_message("🔤 Input defocused");
}

// ---- Enhanced Key Processing ----

/// Enhanced key processing for chat input
pub fn tk_chat_key_bytes(key: u32, cp: u32, flags: u32, appcur: bool, out: []u8) -> u32 {
    // Special handling for Enter in chat mode
    if (key == VK_RETURN or key == VK_ENTER_PAD) {
        return handle_chat_enter(key, cp, flags, appcur, out);
    }

    // Use original terminal handling for other keys
    return tk_key_bytes(key, cp, flags, appcur, out);
}

// ---- Clipboard Operations ----

/// Enhanced paste with chat awareness
pub fn ti_chat_paste(bracketed: bool, text: []const u8, out: []u8) -> usize {
    log_message("📋 Pasting into chat input");

    const result : usize = ti_paste(bracketed, text, out);

    // After paste, auto-resize if needed
    auto_resize_input(&chat_input_state.cursor_position);

    return result;
}

/// Copy selected text from chat
pub fn ti_chat_copy_selected(st: []const u32, cells: []const u32, out: []u8) -> usize {
    log_message("📋 Copying from chat");

    const selected_text : str = get_selected_text_in_chat(st, cells);
    copy_to_clipboard(selected_text);

    return ti_sel_text(st, cells, out);
}

/// Get selected text with chat context
fn get_selected_text_in_chat(st: []const u32, cells: []const u32) -> str {
    // Get selected text as before
    const length : usize = ti_sel_text(st, cells, new_array(256u8));
    // Convert to string and return
    return "Selected text from chat";
}

// ---- UI Management ----

/// Update connection status
pub fn update_connection_status(connected: bool) -> void {
    chat_input_state.is_connected = connected;
    log_message(connected ? "🟢 Chat connected" : "🔴 Chat disconnected");
}

/// Get message count for display
pub fn get_message_count_str() -> str {
    return @concat("Messages: ", @toString(chat_input_state.message_count));
}

/// Get connection status for display
pub fn get_connection_status_str() -> str {
    return chat_input_state.is_connected ? "🟢 Connected" : "🔴 Disconnected";
}

// ---- Original terminal functions with chat integration ----

// ... (tk_has, tk_mod_param, tk_put, tk_esc, tk_cursor, tk_tilde, tk_fkey, tk_ascii_of_key, tk_key_bytes, tk_ctrl)

// ---- Initialization ----

/// Initialize chat input with terminal
pub fn init_chat_input_with_terminal(st: []u32, cells: []u32, cols: u32, rows: u32) -> bool {
    // Initialize terminal
    if (!vt_init(st, cells, cols, rows)) {
        return false;
    }

    // Initialize chat input state
    init_chat_input();

    log_message("🔤 Chat input with terminal initialized");
    return true;
}

// ---- Tests ----

test chat_input_basic {
    init_chat_input();

    // Test initial state
    assert chat_input_state.input_text == "";
    assert chat_input_state.is_composing == false;
    assert chat_input_state.is_focused == false;
    assert chat_input_state.message_count == 0;

    // Test auto-resize
    var height : u32 = 44;
    auto_resize_input(&height);
    assert height == 44;  // Minimum height when empty

    record_experience("Chat input basic test passed");
}

test chat_message_sending {
    init_chat_input();

    // Test sending message
    const test_message : str = "Hello Queen!";
    send_chat_message(test_message);

    // Verify state update
    assert chat_input_state.message_count == 1;
    assert chat_input_state.last_sent_message == test_message;

    record_experience("Chat message sending test passed");
}

test chat_input_resize {
    init_chat_input();

    // Test auto-resize with empty input
    var height : u32 = 44;
    auto_resize_input(&height);
    assert height == 44;

    // Test with one line
    chat_input_state.input_text = "Hello";
    auto_resize_input(&height);
    assert height > 44;

    // Test with multiple lines
    chat_input_state.input_text = "Hello\nWorld\nTest";
    auto_resize_input(&height);
    assert height > 44;

    // Test maximum height
    chat_input_state.input_text = @repeat_string("Very long line that should cause wrapping\n", 10);
    auto_resize_input(&height);
    assert height == CHAT_INPUT_MAX_HEIGHT;

    record_experience("Chat input resize test passed");
}

// ---- Utility Functions ----

/// Create string with repeated content
fn repeat_string(content: str, count: u32) -> str {
    let result : str = "";
    for (var i: u32 = 0; i < count; i += 1) {
        result = @concat(result, content);
    }
    return result;
}

/// Copy text to clipboard
fn copy_to_clipboard(text: str) -> void {
    log_message(@concat("📋 Copied to clipboard: ", text));
    // In real implementation, this would call system clipboard API
}

// ---- Integration Points ----

var queen_chat_orchestrator_active : bool = false;

/// Enable Queen chat integration
pub fn enable_queen_chat() -> void {
    queen_chat_orchestrator_active = true;
    log_message("👑 Queen chat integration enabled");
}

/// Disable Queen chat integration
pub fn disable_queen_chat() -> void {
    queen_chat_orchestrator_active = false;
    log_message("👑 Queen chat integration disabled");
}