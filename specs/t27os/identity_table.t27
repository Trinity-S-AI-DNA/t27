; specs/t27os/identity_table.t27 -- the identity fields of the 27 agent letters as plain tables t27b can import
; t27b resolves `use` of ITEMS only, not `agents::A` + `A::X` from an imported module, so the window reads this table.
; It is a MIRROR, not a second truth: specs/t27os/identity.t27 reads every field from specs/agents/<l>.t27 by `use` and
; fails when one cell here differs (the drift gate). To change a field, change specs/agents/<l>.t27 and this table
; together; the test says which cell is stale. ASCII only (L3), English only (LANG-EN).

module T27osIdentityTable;

pub const NAME_TAB : [27]str = ["Alpha", "Beta", "Gamma", "Delta", "Epsilon", "Phi", "Gamma (var.)", "Eta", "Iota", "Iota-extended", "Kappa", "Lambda", "Mu", "Nu", "Omicron", "Pi", "Theta", "Rho", "Sigma", "Tau", "Upsilon", "Vau (var.)", "Double-Vav", "Chi", "Psi", "Zeta", "Ti"];
