pub fn name_of(o: u32) -> str { if (o < 1 or o > 27) { return ""; } return NAME_TAB[o - 1]; }
pub fn domain_of(o: u32) -> str { if (o < 1 or o > 27) { return ""; } return DOMAIN_TAB[o - 1]; }
pub fn archetype_of(o: u32) -> str { if (o < 1 or o > 27) { return ""; } return ARCH_TAB[o - 1]; }
pub fn register_of(o: u32) -> str { if (o < 1 or o > 27) { return ""; } return REG_TAB[o - 1]; }
pub fn layer_of(o: u32) -> str { if (o < 1 or o > 27) { return ""; } return LAYER_TAB[o - 1]; }
pub fn skill_n(o: u32) -> u32 { if (o < 1 or o > 27) { return 0; } return SKILL_OFF[o] - SKILL_OFF[o - 1]; }
pub fn tool_n(o: u32) -> u32 { if (o < 1 or o > 27) { return 0; } return TOOL_OFF[o] - TOOL_OFF[o - 1]; }
pub fn key_n(o: u32) -> u32 { if (o < 1 or o > 27) { return 0; } return KEY_OFF[o] - KEY_OFF[o - 1]; }
pub fn skill_at(o: u32, i: u32) -> str { if (i >= skill_n(o)) { return ""; } return SKILL_FLAT[SKILL_OFF[o - 1] + i]; }
pub fn tool_at(o: u32, i: u32) -> str { if (i >= tool_n(o)) { return ""; } return TOOL_FLAT[TOOL_OFF[o - 1] + i]; }
pub fn key_at(o: u32, i: u32) -> str { if (i >= key_n(o)) { return ""; } return KEY_FLAT[KEY_OFF[o - 1] + i]; }

test the_table_reads_back {
    assert name_of(3) == "Gamma";
    assert tool_n(3) == 19;
    assert tool_at(3, 19).len == 0;
    assert name_of(0).len == 0;
    assert skill_at(3, 1) == "t27/self-host";
    assert key_n(27) > 0;
}
