// SPDX-License-Identifier: Apache-2.0
; specs/t27os/windows.t27 -- the window model of T27 OS: spaces, the agent sessions in them, and the
; sidebar that lists both, after herdr.
; Owner, 2026-10-19: implement herdr's window logic, but with three groups -- queen, spaces, agents.
; herdr's sidebar has a "spaces" group (repository, branch, a dot coloured by its agents) and an
; "agents" group (pane name, "state . agent"). T27 OS keeps that and puts the Queen above both, because
; the Queen is the one that prompts every other agent:
;   QUEEN   the orchestrator row, always there;
;   SPACES  one row per workspace: a state dot, the name, the branch in dim text;
;   AGENTS  the sessions of the selected space: the agent mark, its name, then its state and space.
; Sessions are a list of up to seven chats, one byte each packed in a u64 (agent and space), so the whole
; model is one integer that the hot reload saves and restores. An agent may run several chats at once
; (owner, 2026-10-19: "a + button for a new chat, so several Claude Codes can run, and deletion from the
; side menu"). A tap on a honeycomb cell selects that agent's first chat in the space, opening one if
; there is none; "+" in the header always opens a new chat; the x on a hovered AGENTS row closes it.
; Black and white only (FR-006): the state is a dot shape, not a colour --
;   stopped a faint ring, idle a ring, working a filled dot, blocked a filled dot in a ring (needs you),
;   done a dim filled dot.
; Seed data, not yet read from disk: the first three SPACE_NAMES and SPACE_BRANCHES are the repositories this
; app is built from; "+" in the SPACES label line opens one of three more slots (no repository bound yet), and
; the x on a hovered space row closes a space and its chats. The host side (follow-up, see agents.t27) will
; read spaces from git worktrees and states from the terminal owner; until then every session shows
; S_STOPPED, which is true -- no agent process is started yet.

module T27osWindows;

use t27os::agents::AGENT_COUNT;
use t27os::agents::AGENT_QUEEN;
use t27os::agents::S_STOPPED;
use t27os::agents::S_WORKING;
use t27os::agents::S_BLOCKED;
use t27os::agents::S_IDLE;
use t27os::agents::S_DONE;

/// Space slots. The first three are the repositories this app is built from; "+" in the SPACES label line
/// opens the next closed slot, and the x on a hovered space row closes one. SPACES_SEED is the open set at first
/// start, one bit per slot.
pub const SPACE_COUNT : u32 = 6;
pub const SPACE_NAMES : str = "t27,trinity,t27os,space 4,space 5,space 6";
pub const SPACE_BRANCHES : str = "master,main,feat/t27os-petal-menu,no repository,no repository,no repository";
pub const SPACES_SEED : u32 = 7;
/// The foot of the sidebar: one line, OPEN SOURCE T27, that opens the repository so others can build
/// features with us (owner, 2026-10-19; renamed from I LOVE OPEN SOURCE the same day). Black and white like the rest; FOOT_H is its strip above the bottom edge.
pub const REPO_LINK_TEXT : str = "OPEN SOURCE T27";
pub const REPO_URL : str = "https://github.com/gHashTag/t27";
pub const FOOT_H : f64 = 34.0;
/// The words for S_STOPPED .. S_DONE, in state order.
pub const STATE_WORDS : str = "stopped,working,blocked,idle,done";
pub const SPACE_NONE : u32 = 4294967295;

/// Dot shapes for a state.
pub const DOT_FAINT : u32 = 0;
pub const DOT_RING : u32 = 1;
pub const DOT_FILLED : u32 = 2;
pub const DOT_ALERT : u32 = 3;
pub const DOT_DIM : u32 = 4;

/// Sidebar geometry from the top of the workspace (points).
pub const LABEL_BASE : f64 = 22.0;
pub const ROWS_OFF : f64 = 30.0;
pub const ROW_H : f64 = 28.0;
pub const ROW_STEP : f64 = 30.0;
pub const AGENT_ROW_H : f64 = 38.0;
pub const AGENT_STEP : f64 = 40.0;
pub const GROUP_GAP : f64 = 14.0;
pub const GROUP_QUEEN : u32 = 0;
pub const GROUP_SPACES : u32 = 1;
pub const GROUP_AGENTS : u32 = 2;
pub const ROW_NONE : u32 = 4294967295;

/// Up to SESSION_MAX sessions, one byte each in a u64, kept in opening order with no holes: byte i is 0 for
/// no session, else 1 + agent * 8 + space. Seven keeps the shift in remove_session inside 64 bits; the 540-pt
/// window shows five of them above the sidebar foot (glass_window.t27 layout test), scrolling is not built yet.
pub const SESSION_MAX : u32 = 7;
pub const SESSION_NONE : u32 = 4294967295;
/// The agent a "+" opens when no agent session is selected: Claude Code, cell 0.
pub const NEW_CHAT_DEFAULT : u32 = 0;

fn pow256(k: u32) -> u64 {
    var p : u64 = 1;
    var i : u32 = 0;
    while (i < k) {
        p = p * 256;
        i = i + 1;
    }
    return p;
}

fn slot(ss: u64, i: u32) -> u64 {
    if (i >= SESSION_MAX) { return 0; }
    return ss / pow256(i) % 256;
}

/// How many sessions are open.
pub fn session_count(ss: u64) -> u32 {
    var n : u32 = 0;
    while (n < SESSION_MAX and slot(ss, n) != 0) { n = n + 1; }
    return n;
}

/// The agent of session i (AGENT_COUNT when there is none).
pub fn session_agent(ss: u64, i: u32) -> u32 {
    const b : u64 = slot(ss, i);
    if (b == 0) { return AGENT_COUNT; }
    return @as(u32, @intCast((b - 1) / 8));
}

/// The space session i lives in, SPACE_NONE when there is none.
pub fn session_space(ss: u64, i: u32) -> u32 {
    const b : u64 = slot(ss, i);
    if (b == 0) { return SPACE_NONE; }
    return @as(u32, @intCast((b - 1) % 8));
}

/// `ss` with one more session of agent k in space s, at index session_count(ss); unchanged when full or out
/// of range. An agent may run any number of sessions -- several Claude Codes at once.
pub fn add_session(ss: u64, k: u32, s: u32) -> u64 {
    const n : u32 = session_count(ss);
    if (k >= AGENT_COUNT or s >= SPACE_COUNT or n >= SESSION_MAX) { return ss; }
    return ss + @as(u64, 1 + k * 8 + s) * pow256(n);
}

/// `ss` with session i closed; the later ones move down one index.
pub fn remove_session(ss: u64, i: u32) -> u64 {
    if (i >= session_count(ss)) { return ss; }
    const p : u64 = pow256(i);
    return ss % p + ss / pow256(i + 1) * p;
}

/// The selected index after session i is closed: none if it was the one closed, one lower if it was after.
pub fn after_remove(cur: u32, i: u32) -> u32 {
    if (cur == SESSION_NONE or cur < i) { return cur; }
    if (cur == i) { return SESSION_NONE; }
    return cur - 1;
}

/// How many sessions space s holds.
pub fn sessions_in(ss: u64, s: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SESSION_MAX) {
        if (session_space(ss, i) == s) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The session on row r of space s's AGENTS list, SESSION_NONE past the last row.
pub fn session_at_row(ss: u64, s: u32, r: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SESSION_MAX) {
        if (session_space(ss, i) == s) {
            if (n == r) { return i; }
            n = n + 1;
        }
        i = i + 1;
    }
    return SESSION_NONE;
}

/// The first session of agent k in space s, SESSION_NONE when it has none there.
pub fn first_of(ss: u64, k: u32, s: u32) -> u32 {
    var i : u32 = 0;
    while (i < SESSION_MAX) {
        if (session_agent(ss, i) == k and session_space(ss, i) == s) { return i; }
        i = i + 1;
    }
    return SESSION_NONE;
}

/// 1 for an agent's first chat in its space, 2 for the second, and so on: the row shows "Claude Code 2".
pub fn chat_number(ss: u64, i: u32) -> u32 {
    var n : u32 = 1;
    var j : u32 = 0;
    while (j < i) {
        if (session_agent(ss, j) == session_agent(ss, i) and session_space(ss, j) == session_space(ss, i)) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

/// The agent "+" opens: the selected agent, else Claude Code (the Queen does not run in a chat session).
pub fn new_chat_agent(task: u32) -> u32 {
    if (task < AGENT_COUNT and task != AGENT_QUEEN) { return task; }
    return NEW_CHAT_DEFAULT;
}

fn slot_bit(k: u32) -> u32 {
    var p : u32 = 1;
    var i : u32 = 0;
    while (i < k) {
        p = p * 2;
        i = i + 1;
    }
    return p;
}

/// Whether space slot s is open in the set sp (one bit per slot).
pub fn space_is_open(sp: u32, s: u32) -> bool {
    if (s >= SPACE_COUNT) { return false; }
    return sp / slot_bit(s) % 2 == 1;
}

/// How many spaces the SPACES group shows.
pub fn spaces_shown(sp: u32) -> u32 {
    var n : u32 = 0;
    var s : u32 = 0;
    while (s < SPACE_COUNT) {
        if (space_is_open(sp, s)) { n = n + 1; }
        s = s + 1;
    }
    return n;
}

/// The space slot on row r of the SPACES group, SPACE_NONE past the last row.
pub fn space_at_row(sp: u32, r: u32) -> u32 {
    var n : u32 = 0;
    var s : u32 = 0;
    while (s < SPACE_COUNT) {
        if (space_is_open(sp, s)) {
            if (n == r) { return s; }
            n = n + 1;
        }
        s = s + 1;
    }
    return SPACE_NONE;
}

/// The row space slot s sits on, ROW_NONE when it is closed.
pub fn row_of_space(sp: u32, s: u32) -> u32 {
    if (space_is_open(sp, s) == false) { return ROW_NONE; }
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < s) {
        if (space_is_open(sp, j)) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

/// The slot "+" opens: the first closed one, SPACE_NONE when all are open.
pub fn new_space(sp: u32) -> u32 {
    var s : u32 = 0;
    while (s < SPACE_COUNT) {
        if (space_is_open(sp, s) == false) { return s; }
        s = s + 1;
    }
    return SPACE_NONE;
}

/// `sp` with slot s opened; unchanged when it is open or out of range.
pub fn add_space(sp: u32, s: u32) -> u32 {
    if (s >= SPACE_COUNT or space_is_open(sp, s)) { return sp; }
    return sp + slot_bit(s);
}

/// `sp` with slot s closed; the last open space stays, so the window always has one.
pub fn remove_space(sp: u32, s: u32) -> u32 {
    if (space_is_open(sp, s) == false or spaces_shown(sp) <= 1) { return sp; }
    return sp - slot_bit(s);
}

/// `ss` with every session of space s closed, the others kept in order.
pub fn drop_sessions_in(ss: u64, s: u32) -> u64 {
    var out : u64 = ss;
    var i : u32 = SESSION_MAX;
    while (i > 0) {
        i = i - 1;
        if (session_space(out, i) == s) { out = remove_session(out, i); }
    }
    return out;
}

/// The selected session after drop_sessions_in(ss, s): none if it was in s, else its new index.
pub fn after_drop(cur: u32, ss: u64, s: u32) -> u32 {
    if (cur == SESSION_NONE or cur >= session_count(ss)) { return SESSION_NONE; }
    if (session_space(ss, cur) == s) { return SESSION_NONE; }
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < cur) {
        if (session_space(ss, i) != s) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The dot a session in state st shows.
pub fn dot_for(st: u32) -> u32 {
    if (st == S_WORKING) { return DOT_FILLED; }
    if (st == S_BLOCKED) { return DOT_ALERT; }
    if (st == S_IDLE) { return DOT_RING; }
    if (st == S_DONE) { return DOT_DIM; }
    return DOT_FAINT;
}

/// How loud a state is in its space's dot: the one waiting on you wins.
pub fn loudness(st: u32) -> u32 {
    if (st == S_BLOCKED) { return 4; }
    if (st == S_WORKING) { return 3; }
    if (st == S_IDLE) { return 2; }
    if (st == S_DONE) { return 1; }
    return 0;
}

/// The louder of two states.
pub fn louder(a: u32, b: u32) -> u32 {
    if (loudness(b) > loudness(a)) { return b; }
    return a;
}

/// Top of a sidebar group, from the workspace top t, with n space rows above the AGENTS group.
pub fn group_top(t: f64, g: u32, n: u32) -> f64 {
    const spaces : f64 = t + ROWS_OFF + ROW_H + GROUP_GAP;
    if (g == GROUP_QUEEN) { return t; }
    if (g == GROUP_SPACES) { return spaces; }
    return spaces + ROWS_OFF + @as(f64, @floatFromInt(n)) * ROW_STEP - (ROW_STEP - ROW_H) + GROUP_GAP;
}

/// Baseline of a group's label.
pub fn label_base(t: f64, g: u32, n: u32) -> f64 {
    return group_top(t, g, n) + LABEL_BASE;
}

/// Top of row i in a group.
pub fn row_top(t: f64, g: u32, n: u32, i: u32) -> f64 {
    var step : f64 = ROW_STEP;
    if (g == GROUP_AGENTS) { step = AGENT_STEP; }
    return group_top(t, g, n) + ROWS_OFF + @as(f64, @floatFromInt(i)) * step;
}

/// The row of group g under y, given `rows` rows in it; ROW_NONE between or past the rows.
pub fn row_at(t: f64, g: u32, n: u32, rows: u32, y: f64) -> u32 {
    var h : f64 = ROW_H;
    if (g == GROUP_AGENTS) { h = AGENT_ROW_H; }
    var i : u32 = 0;
    while (i < rows) {
        const top : f64 = row_top(t, g, n, i);
        if (y >= top and y <= top + h) { return i; }
        i = i + 1;
    }
    return ROW_NONE;
}

test several_chats_of_one_agent_open_and_close {
    var ss : u64 = 0;
    assert session_count(ss) == 0;
    assert session_agent(ss, 0) == AGENT_COUNT;
    // "+" three times with Claude Code selected, then Codex in space 2
    ss = add_session(ss, 0, 0);
    ss = add_session(ss, 0, 0);
    ss = add_session(ss, 5, 2);
    ss = add_session(ss, 0, 0);
    assert session_count(ss) == 4;
    assert sessions_in(ss, 0) == 3;
    assert sessions_in(ss, 2) == 1;
    assert session_agent(ss, 2) == 5;
    assert session_space(ss, 2) == 2;
    assert chat_number(ss, 0) == 1;
    assert chat_number(ss, 1) == 2;
    assert chat_number(ss, 3) == 3;
    assert session_at_row(ss, 0, 2) == 3;
    assert session_at_row(ss, 0, 3) == SESSION_NONE;
    assert first_of(ss, 5, 2) == 2;
    assert first_of(ss, 5, 0) == SESSION_NONE;
    // close the second Claude Code: the later sessions move down one index, in order
    ss = remove_session(ss, 1);
    assert session_count(ss) == 3;
    assert session_agent(ss, 1) == 5;
    assert session_agent(ss, 2) == 0;
    assert chat_number(ss, 2) == 2;
    // closing past the end, or an out-of-range agent or space, changes nothing
    assert remove_session(ss, 3) == ss;
    assert add_session(ss, AGENT_COUNT, 0) == ss;
    assert add_session(ss, 1, SPACE_COUNT) == ss;
}

test seven_sessions_fill_the_list_and_the_selection_follows_a_close {
    var ss : u64 = 0;
    var i : u32 = 0;
    while (i < SESSION_MAX + 2) {
        ss = add_session(ss, AGENT_COUNT - 1, SPACE_COUNT - 1);
        i = i + 1;
    }
    assert session_count(ss) == SESSION_MAX;
    assert session_agent(ss, SESSION_MAX - 1) == AGENT_COUNT - 1;
    // the last slot closes without overflowing the shift
    assert session_count(remove_session(ss, SESSION_MAX - 1)) == SESSION_MAX - 1;
    assert session_count(remove_session(ss, 0)) == SESSION_MAX - 1;
    assert after_remove(3, 3) == SESSION_NONE;
    assert after_remove(4, 3) == 3;
    assert after_remove(2, 3) == 2;
    assert after_remove(SESSION_NONE, 0) == SESSION_NONE;
    // "+" opens the selected agent, Claude Code when the Queen or nothing is selected
    assert new_chat_agent(5) == 5;
    assert new_chat_agent(AGENT_QUEEN) == NEW_CHAT_DEFAULT;
    assert new_chat_agent(AGENT_COUNT) == NEW_CHAT_DEFAULT;
}

test the_state_is_a_shape_and_the_blocked_one_wins {
    assert dot_for(S_STOPPED) == DOT_FAINT;
    assert dot_for(S_IDLE) == DOT_RING;
    assert dot_for(S_WORKING) == DOT_FILLED;
    assert dot_for(S_BLOCKED) == DOT_ALERT;
    assert dot_for(S_DONE) == DOT_DIM;
    assert louder(S_WORKING, S_BLOCKED) == S_BLOCKED;
    assert louder(S_BLOCKED, S_IDLE) == S_BLOCKED;
    assert louder(S_STOPPED, S_DONE) == S_DONE;
}

test the_three_groups_stack_queen_spaces_agents {
    const t : f64 = 35.0;
    assert label_base(t, GROUP_QUEEN, 3) == 57.0;
    assert row_top(t, GROUP_QUEEN, 3, 0) == 65.0;
    // SPACES starts a gap below the Queen row
    assert group_top(t, GROUP_SPACES, 3) == 65.0 + ROW_H + GROUP_GAP;
    // AGENTS starts a gap below the last space row
    assert group_top(t, GROUP_AGENTS, 3) == row_top(t, GROUP_SPACES, 3, 2) + ROW_H + GROUP_GAP;
    assert row_at(t, GROUP_SPACES, 3, 3, row_top(t, GROUP_SPACES, 3, 1) + 1.0) == 1;
    assert row_at(t, GROUP_SPACES, 3, 3, row_top(t, GROUP_SPACES, 3, 1) - 1.0) == ROW_NONE;
    assert row_at(t, GROUP_AGENTS, 3, 2, row_top(t, GROUP_AGENTS, 3, 1) + 30.0) == 1;
    assert row_at(t, GROUP_AGENTS, 3, 2, row_top(t, GROUP_AGENTS, 3, 2) + 1.0) == ROW_NONE;
}

test a_plus_opens_a_space_and_the_x_closes_it_with_its_chats {
    var sp : u32 = SPACES_SEED;
    assert spaces_shown(sp) == 3;
    assert space_at_row(sp, 2) == 2;
    assert space_at_row(sp, 3) == SPACE_NONE;
    // "+" opens slot 3, then slot 4
    assert new_space(sp) == 3;
    sp = add_space(sp, new_space(sp));
    sp = add_space(sp, new_space(sp));
    assert spaces_shown(sp) == 5;
    // close trinity: the rows below move up one
    sp = remove_space(sp, 1);
    assert space_is_open(sp, 1) == false;
    assert space_at_row(sp, 1) == 2;
    assert row_of_space(sp, 3) == 2;
    assert row_of_space(sp, 1) == ROW_NONE;
    // the next "+" reuses the closed slot
    assert new_space(sp) == 1;
    // all open: "+" has nothing to open, and adding twice changes nothing
    var all : u32 = 0;
    var s : u32 = 0;
    while (s < SPACE_COUNT) {
        all = add_space(all, s);
        s = s + 1;
    }
    assert new_space(all) == SPACE_NONE;
    assert add_space(all, 0) == all;
    // the last space cannot be closed
    assert remove_space(1, 0) == 1;
    // closing a space closes its chats; the selection follows
    var ss : u64 = 0;
    ss = add_session(ss, 0, 0);
    ss = add_session(ss, 1, 1);
    ss = add_session(ss, 2, 0);
    ss = add_session(ss, 3, 1);
    ss = add_session(ss, 4, 5);
    const left : u64 = drop_sessions_in(ss, 1);
    assert session_count(left) == 3;
    assert session_agent(left, 1) == 2;
    assert session_space(left, 2) == 5;
    assert after_drop(1, ss, 1) == SESSION_NONE;
    assert after_drop(2, ss, 1) == 1;
    assert after_drop(4, ss, 1) == 2;
    assert after_drop(SESSION_NONE, ss, 1) == SESSION_NONE;
}

test the_foot_strip_holds_the_link {
    // the strip is taller than a space row, so the line under it is easy to hit
    assert FOOT_H > ROW_H;
    // the words are the owner's: OPEN SOURCE T27, three words, ending in the project's name
    var gaps : u32 = 0;
    var i : usize = 0;
    while (i < REPO_LINK_TEXT.len) {
        if (REPO_LINK_TEXT[i] == 32) { gaps = gaps + 1; }
        i = i + 1;
    }
    assert gaps == 2;
    assert REPO_LINK_TEXT[REPO_LINK_TEXT.len - 1] == 55;
}

test loudness_ranks_blocked_over_working_over_idle_over_done_over_the_rest {
    assert loudness(S_BLOCKED) == 4;
    assert loudness(S_WORKING) == 3;
    assert loudness(S_IDLE) == 2;
    assert loudness(S_DONE) == 1;
    assert loudness(S_STOPPED) == 0;
    assert loudness(9) == 0;
    assert loudness(4294967295) == 0;
}
