// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_runner_tick_argv.t27 -- the HOST argv law for one runner tick
// (owner brief 2026-10-27, follows specs/t27os/node_runner.t27). The runner glue
// is host plumbing; its DECISIONS are this spec. One tick = one job, and the job
// is always the same shape: prove one spec with the real front end. The builder
// below writes the exact words the host runs (dispatch.t27's argv pattern) and
// REFUSES to write a single word unless the gates hold: a 32-hex challenge,
// exactly one spec path, and the spec path beginning with "specs/" and ending
// ".t27" (a tick runs the market's own specs, never an arbitrary file).
// Fail closed: zero words means the host runs nothing.
// -- LENGTHS ARE EXPLICIT, EVERYWHERE. gen-c lowers a slice's own `.len` into
// invalid C (`c.len`, the #5980 family), so every slice travels with its length
// as a separate usize parameter -- the gates_pins.t27 idiom. The refusal is
// written into a caller buffer and returned as a length (0 = no refusal), for
// the same reason.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeRunnerTickArgv;

pub const A_RUN : u8 = 0;
pub const A_REFUSE : u8 = 1;
pub const CHALLENGE_HEX : usize = 32;

fn digit(b: u8) -> bool { return b >= 48 and b <= 57; }
fn hexlower(b: u8) -> bool { return digit(b) or (b >= 97 and b <= 102); }

fn hex32(c: []const u8, n: usize) -> bool {
    if (n != CHALLENGE_HEX) { return false; }
    var i : usize = 0;
    while (i < n) {
        if (hexlower(c[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

fn spec_path_ok(s: []const u8, n: usize) -> bool {
    if (n < 10) { return false; }
    if (s[0] != 115 or s[1] != 112 or s[2] != 101 or s[3] != 99 or s[4] != 115 or s[5] != 47) { return false; }
    return s[n - 4] == 46 and s[n - 3] == 116 and s[n - 2] == 50 and s[n - 1] == 55;
}

fn put_s(out: []u8, at: usize, cap: usize, s: []const u8, n: usize) -> usize {
    var i : usize = 0;
    var w : usize = at;
    while (i < n and w < cap) {
        out[w] = s[i];
        w = w + 1;
        i = i + 1;
    }
    return w;
}

/// One tick's words: the compiler, the verb, the spec. Written only when the
/// dispatch law holds for this challenge and the path is a specs/ *.t27 path.
pub fn tick_argv(out: []u8, cap: usize, challenge: []const u8, ch_len: usize, spec: []const u8, sp_len: usize) -> usize {
    if (hex32(challenge, ch_len) == false) { return 0; }
    if (spec_path_ok(spec, sp_len) == false) { return 0; }
    var w : usize = put_s(out, 0, cap, "t27c\ntest-report\n", 17);
    w = put_s(out, w, cap, spec, sp_len);
    return w;
}

/// The refusal written into the caller's buffer; returns its length.
/// Zero means no refusal -- the tick would run.
pub fn tick_refusal(out: []u8, cap: usize, challenge: []const u8, ch_len: usize, spec: []const u8, sp_len: usize) -> usize {
    if (hex32(challenge, ch_len) == false) {
        return put_s(out, 0, cap, "challenge: exactly 32 lowercase hex expected", 44);
    }
    if (spec_path_ok(spec, sp_len) == false) {
        return put_s(out, 0, cap, "spec: a specs/ *.t27 path expected", 34);
    }
    return 0;
}

test the_tick_words_are_exact {
    var buf : [256]u8 = undefined;
    const ch : str = "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4";
    const sp : str = "specs/t27os/node_runner.t27";
    const n : usize = tick_argv(buf[0..256], 256, ch, 32, sp, 27);
    assert n > 0;
    const want : str = "t27c\ntest-report\nspecs/t27os/node_runner.t27";
    // 5 + 12 + 27 = 44, spelled out: gen-c cannot lower str.len (the #5980 trap)
    var want_n : usize = 44;
    var same : bool = n == want_n;
    var i : usize = 0;
    while (same and i < n) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
}

test the_tick_refuses_closed {
    var buf : [256]u8 = undefined;
    var r : usize = tick_refusal(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 32, "specs/t27os/node_runner.t27", 27);
    assert r == 0;
    assert tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 32, "specs/t27os/node_runner.t27", 27) > 0;
    assert tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 32, "specs/t27os/node_runner.t27", 27) > 0;
    r = tick_refusal(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d", 31, "specs/t27os/node_runner.t27", 27);
    assert r > 0;
    r = tick_refusal(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 32, "node_runner.t27", 15);
    assert r > 0;
    r = tick_refusal(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", 32, "specs/t27os/readme.md", 21);
    assert r > 0;
}
