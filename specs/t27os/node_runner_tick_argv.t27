// SPDX-License-Identifier: Apache-2.0
// specs/t27os/node_runner_tick_argv.t27 -- the HOST argv law for one runner tick
// (owner brief 2026-10-27, follows specs/t27os/node_runner.t27). The runner glue
// is host plumbing; its DECISIONS are this spec. One tick = one job, and the job
// is always the same shape: prove one spec with the real front end. The builder
// below writes the exact words the host runs (dispatch.t27's argv pattern) and
// REFUSES to write a single word unless the gates hold: a 32-hex challenge,
// exactly one spec path, and the spec path beginning with "specs/" (a tick runs
// the market's own specs, never an arbitrary file the challenge did not name).
// Fail closed: zero words means the host runs nothing.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27OsNodeRunnerTickArgv;

use t27os::node_market::job_dispatch_ok;

pub const A_RUN : u8 = 0;
pub const A_REFUSE : u8 = 1;

fn digit(b: u8) -> bool { return b >= 48 and b <= 57; }
fn hexlower(b: u8) -> bool { return digit(b) or (b >= 97 and b <= 102); }

fn hex32(c: []const u8) -> bool {
    if (c.len != 32) { return false; }
    var i : usize = 0;
    while (i < 32) {
        if (hexlower(c[i]) == false) { return false; }
        i = i + 1;
    }
    return true;
}

fn spec_path_ok(s: []const u8) -> bool {
    if (s.len < 10) { return false; }
    if (s[0] != 115 or s[1] != 112 or s[2] != 101 or s[3] != 99 or s[4] != 115 or s[5] != 47) { return false; }
    return s[s.len - 4] == 46 and s[s.len - 3] == 116 and s[s.len - 2] == 50 and s[s.len - 1] == 55;
}

/// One tick's words: the compiler, the verb, the spec. Written only when the
/// dispatch law holds for this challenge and the path is a specs/ *.t27 path.
pub fn tick_argv(out: []u8, cap: usize, challenge: []const u8, spec: []const u8) -> usize {
    if (hex32(challenge) == false) { return 0; }
    if (spec_path_ok(spec) == false) { return 0; }
    var w : usize = put_s(out, 0, cap, "t27c\ntest-report\n");
    w = put_s(out, w, cap, spec);
    return w;
}

/// The refusal text a host prints when it runs nothing (empty means no refusal).
pub fn tick_refusal(challenge: []const u8, spec: []const u8) -> []const u8 {
    if (hex32(challenge) == false) { return "challenge: exactly 32 lowercase hex expected"; }
    if (spec_path_ok(spec) == false) { return "spec: a specs/ *.t27 path expected"; }
    return "";
}

fn put_s(out: []u8, at: usize, cap: usize, s: []const u8) -> usize {
    var i : usize = 0;
    var w : usize = at;
    while (i < s.len and w < cap) {
        out[w] = s[i];
        w = w + 1;
        i = i + 1;
    }
    return w;
}

test the_tick_words_are_exact {
    var buf : [256]u8 = undefined;
    const n : usize = tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/t27os/node_runner.t27");
    assert n > 0;
    const want : str = "t27c\ntest-report\nspecs/t27os/node_runner.t27";
    var same : bool = n == want.len;
    var i : usize = 0;
    while (same and i < n) { if (buf[i] != @as(u8, want[i])) { same = false; } i = i + 1; }
    assert same;
}

test the_tick_refuses_closed {
    var buf : [256]u8 = undefined;
    assert tick_argv(buf[0..256], 256, "", "specs/t27os/node_runner.t27") == 0;
    assert tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d", "specs/t27os/node_runner.t27") == 0;
    assert tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "node_runner.t27") == 0;
    assert tick_argv(buf[0..256], 256, "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/t27os/readme.md") == 0;
    assert tick_refusal("", "specs/t27os/node_runner.t27").len > 0;
    assert tick_refusal("a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4", "specs/t27os/node_runner.t27").len == 0;
}
