// specs/t27os/dashboard.t27 -- one lane row for the orchestrator.
// This is not the Queen board (specs/queen/dashboard.t27) and it draws no window.
// Reading of PR 13502 at head prefix 2723c099, 2026-11-09:
//   validate, parse-ratchet, own-language, and L1 traceability succeeded.
//   Issue Gate run 42659558714 completed as startup_failure on pull_request_target.
//   Five other checks failed and their logs were not read, so they stay unknown:
//   duplicate-bodies, emit-bitexact, coverage, spec-guards, t27b-native-ratchet.
// total_gaps was not recomputed here.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::dashboard {

    use t27os::blockers::BK_EXTERNAL;
    use t27os::blockers::BK_UNKNOWN;
    use t27os::blockers::blocker_class;
    use automation::t27_plan::GLASS_OPEN;

    pub const CONTAINER_PR : u32 = 13502;
    pub const CONTAINER_ISSUE : u32 = 13491;
    pub const HEAD_PREFIX : u32 = 656654489;
    pub const NAMED_GREEN : u8 = 4;
    pub const UNREAD_FAILURES : u8 = 5;
    pub const GATE_RUN : u64 = 42659558714;

    pub fn gate_class() -> u8 {
        return blocker_class(true, true, true);
    }

    pub fn unread_class() -> u8 {
        return blocker_class(true, false, false);
    }

    pub fn row_blocked() -> bool {
        return gate_class() == BK_EXTERNAL || unread_class() == BK_UNKNOWN;
    }

    test "the container row is blocked and the window flag is closed" {
        assert(CONTAINER_PR == 13502);
        assert(CONTAINER_ISSUE == 13491);
        assert(HEAD_PREFIX == 656654489);
        assert(NAMED_GREEN == 4);
        assert(UNREAD_FAILURES == 5);
        assert(GATE_RUN == 42659558714);
        assert(gate_class() == BK_EXTERNAL);
        assert(unread_class() == BK_UNKNOWN);
        assert(row_blocked());
        assert(!GLASS_OPEN);
    }

    invariant the_window_flag_stays_closed {
        assert GLASS_OPEN == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
