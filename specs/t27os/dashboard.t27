; specs/t27os/dashboard.t27 -- one row of the orchestrator dashboard.
; A row is a lane that was handed over. The shown byte is the PTY list byte:
; bits 0..5 are the pane state (agents.t27), bits 6..7 are the key light
; (keys.t27 shown_state_of). Blocked means the lane asked a person.
; Drawing stays in the window shell, which this spec does not open.

module T27osDashboard;

use t27os::agents::S_BLOCKED;
use t27os::agents::S_WORKING;
use t27os::agents::S_IDLE;
use t27os::keys::shown_state_of;

pub fn dash_state(shown: u32) -> u32 {
    return shown_state_of(shown);
}

pub fn dash_needs_person(shown: u32) -> bool {
    return dash_state(shown) == S_BLOCKED;
}

test a_blocked_shown_byte_needs_a_person {
    assert dash_state(130) == S_BLOCKED;
    assert dash_needs_person(130);
}

test a_working_or_idle_shown_byte_does_not {
    assert dash_state(129) == S_WORKING;
    assert dash_needs_person(129) == false;
    assert dash_state(131) == S_IDLE;
    assert dash_needs_person(131) == false;
}
