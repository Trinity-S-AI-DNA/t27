// specs/t27os/github_avatar.t27 -- t27os: fetch github avatar - header.
// Part of M1 (milestone #5). Closes #13753.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::github_avatar;

pub struct GithubAvatar { url: str, fetched: bool };

pub fn github_avatar_fetched(a: GithubAvatar) -> bool {
    return a.fetched;
}

test "github avatar fetched" {
    assert(github_avatar_fetched(GithubAvatar { url: "https://github.com/avatar.png", fetched: true }));
    assert(!github_avatar_fetched(GithubAvatar { url: "https://github.com/avatar.png", fetched: false }));
}