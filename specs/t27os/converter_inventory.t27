// specs/t27os/converter_inventory.t27 -- A1 DATA: converter inventory emits
// the netlist block census.
// Part of M1 (milestone #5). Closes #13651.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::converter_inventory;

pub const CONVERTER_INVENTORY_MAX : u32 = 512;

pub struct ConverterEntry { id: str, census_emitted: bool };

pub fn converter_inventory_census_emitted(c: ConverterEntry) -> bool {
    return c.census_emitted;
}

test "converter inventory census emitted" {
    assert(converter_inventory_census_emitted(ConverterEntry { id: "conv-1", census_emitted: true }));
    assert(!converter_inventory_census_emitted(ConverterEntry { id: "conv-2", census_emitted: false }));
}

invariant converter_inventory_max_positive {
    assert CONVERTER_INVENTORY_MAX > 0;
}