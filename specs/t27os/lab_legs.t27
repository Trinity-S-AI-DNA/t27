// SPDX-License-Identifier: Apache-2.0
// specs/t27os/lab_legs.t27 -- the two-compiler legs of one lab receipt line (issue #11889;
// board Trinity-S-AI-DNA/t27os#3; night loop Refs #11873).
//
// The night-loop law says "both compilers green (t27c test-report + t27b test) before any
// commit", but the T27 OS lab (Trinity-S-AI-DNA/t27os .github/workflows/lab.yml) runs only the
// t27c leg. Measured 2026-10-23: ticks 10-18 left nine PRs (#11870 #11874 #11875 #11884 #11886
// #11888, t27os#14, t27os#15) with "t27b leg" as the only thing left, and an @extern spec
// (glass_window.t27, PR #11420) read as BLOCKED although t27b is the compiler that runs it.
//
// The law, here:
//   - each spec on a receipt has two legs, t27c and t27b; each leg is PASS, FAIL, VACUOUS,
//     BLOCKED or ABSENT (the leg never ran);
//   - a spec is green only when both legs PASS;
//   - one excuse: a t27c BLOCKED on an @extern spec, when its t27b leg PASSes (t27c cannot
//     compile @extern; t27b is its compiler). A t27b BLOCKED is never excused;
//   - a night PR may leave draft only when every spec it touches is green.
// The receipt-level verdict (omitted, failed, blocked, vacuous specs) stays at its home,
// specs/t27os/labs.t27 :: fn receipt_verdict; this file decides one line, labs.t27 the receipt.
// Running the commands is the executor's work (the lab.yml TRI CLAW generates); the commands
// it must run are named below as data. The t27b job also carries the asm leg (T27B_ASM_STEP_YAML,
// t27#12871): the static hot-loop length of each named shootout spec under t27b, gcc -O2 and
// zig ReleaseFast. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLabLegs;

use t27os::keysync::contains;
use t27os::lab_publish::{publish_ok, T27B_PUBLISH_YAML};

// --- the state of one leg ------------------------------------------------

pub const LEG_ABSENT : u8 = 0;
pub const LEG_PASS : u8 = 1;
pub const LEG_FAIL : u8 = 2;
pub const LEG_VACUOUS : u8 = 3;
pub const LEG_BLOCKED : u8 = 4;

// --- the verdict of one spec line ----------------------------------------

pub const LINE_GREEN : u8 = 1;
pub const LINE_RED : u8 = 2;

// --- the executor commands, as data for the lab.yml generator -----------

pub const T27B_BUILD : str = "cargo build --release -p t27b";
pub const T27B_RUN : str = "./target/release/t27b test";
pub const T27C_RUN : str = "./target/release/t27c test-report";

// --- the t27b job, as text for lab.yml (tick 28) --------------------------
//
// Measured 2026-10-24: t27b's JIT runs only on aarch64 (cli/t27b/src/jit.rs JIT_SUPPORTED),
// and the lab job runs on ubuntu-latest, which is x86_64; the t27 CI runs t27b on
// ubuntu-24.04-arm (.github/workflows/t27b-native.yml). So the t27b leg is not one more step
// in the lab job; it is a second job on an arm64 runner that needs the first.
// TRI CLAW makes two edits to Trinity-S-AI-DNA/t27os .github/workflows/lab.yml:
//   1. RUN_OUTPUTS_YAML goes under "runs-on: ubuntu-latest" of job "run", so the second
//      job tests the same sha the first one resolved;
//   2. T27B_JOB_YAML is appended after the last step of job "run".
// The job runs t27b with --check (the interpreter cross-check), because without it t27b
// prints no "runtime asserts" line and a vacuous pass cannot be told from a real one. It
// writes one line per spec into runs/<sha>.t27b.txt, in the receipt's own key=value shape,
// so leg_state above can read it. The spec list reaches bash as $SPECS from the step's env,
// never by expansion into the run body; that law is specs/t27os/lab_inputs.t27 (#11950, #11952).

pub const T27B_RUNNER : str = "runs-on: ubuntu-24.04-arm";
pub const X86_RUNNER : str = "runs-on: ubuntu-latest";
pub const T27B_CHECK : str = "--check";
pub const T27B_NEEDS : str = "needs: run";
pub const T27B_SAME_SHA : str = "needs.run.outputs.resolved";
pub const T27B_LINE_TAG : str = "|leg=t27b|";
pub const T27B_ASSERTS_LINE : str = ": runtime asserts ";
// Measured 2026-10-25 (lab run 40161451315, #12219): the step runs under bash -e -o pipefail,
// so when t27b prints no runtime-asserts line the assignment takes grep's status 1 and -e
// kills the whole leg before it writes a line. The capture ends in "|| true", so such a spec
// gets asserts=NA (never a pass) and the next spec still runs.
pub const T27B_ASSERTS_GUARD : str = "awk '{print $NF}' || true)";
// Measured 2026-10-25 (lab run 40163543896, #12219): specs/t27os/hdmi_grab_main.t27 passed 2/2
// on t27c and got tests=NA on t27b, and the leg had sent t27b's whole output to /tmp/b.txt, so
// the log could not say why. A spec with no count now prints the last 20 lines of that output
// into the job log; the receipt line stays NA (never a pass).
pub const T27B_NA_TAIL : str = "if [ -z \"${3:-}\" ]; then echo \"--- ${spec}: t27b gave no count; its last 20 lines:\"; tail -n 20 /tmp/b.txt; fi";

pub fn na_tail_ok(y: []const u8) -> bool {
    return contains(y, T27B_NA_TAIL);
}

// The spec list of a scheduled run. lab.yml documents "empty = the default core set", but on a
// schedule event GitHub fills no inputs and applies no defaults, so `${{ inputs.specs }}` is
// empty: both loops ran zero times and the gate refused the empty summary. Measured
// 2026-10-25: 6 of 6 scheduled lab runs failed that way (01:42Z .. 13:58Z, last 40200028058),
// each still building t27c on a pool runner while dispatched receipts queued. Both jobs read
// the list through LAB_SPECS_EXPR, which falls back to the core set by itself.
pub const LAB_CORE_SPECS : str = "specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27";
pub const LAB_SPECS_EXPR : str = "${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}";
pub const RUN_SPECS_ENV_YAML : str = "    env:\n      LAB_SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n";
pub const RUN_SPECS_LOOP : str = "for spec in $LAB_SPECS; do";
pub const BARE_SPECS : str = "${{ inputs.specs }}";

// specs_list_ok(y): a job text names its specs through the fallback expression, never the bare
// input a schedule leaves empty.
pub fn specs_list_ok(y: []const u8) -> bool {
    return contains(y, LAB_SPECS_EXPR) and contains(LAB_SPECS_EXPR, LAB_CORE_SPECS)
        and !contains(y, BARE_SPECS);
}

pub const RUN_OUTPUTS_YAML : str = "    outputs:\n      resolved: ${{ steps.sha.outputs.resolved }}\n";

pub const T27B_JOB_YAML : str = "  t27b:\n    needs: run\n    runs-on: ubuntu-24.04-arm\n    timeout-minutes: 40\n    steps:\n      - name: check out this repo (receipt home)\n        uses: actions/checkout@v4\n        with:\n          persist-credentials: true\n      - name: check out t27 at the sha the run job resolved\n        uses: actions/checkout@v4\n        with:\n          repository: Trinity-S-AI-DNA/t27\n          ref: ${{ needs.run.outputs.resolved }}\n          path: t27\n          persist-credentials: false\n      - name: t27b leg -- test every named spec natively on arm64 (t27#11889)\n        shell: bash\n        env:\n          SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n        run: |\n          set -f\n          sha=${{ needs.run.outputs.resolved }}\n          out=\"$GITHUB_WORKSPACE/runs/$sha.t27b.txt\"\n          mkdir -p \"$GITHUB_WORKSPACE/runs\"\n          : > \"$out\"\n          cd t27\n          cargo build --release -p t27b\n          for spec in $SPECS; do\n            ./target/release/t27b test \"$spec\" --check > /tmp/b.txt 2>&1 || true\n            set -- $(grep -E 'passed, [0-9]+ failed, [0-9]+ total$' /tmp/b.txt | tail -1 | awk '{print $(NF-5), $(NF-3), $(NF-1)}')\n            asserts=$(grep -E ': runtime asserts ' /tmp/b.txt | tail -1 | awk '{print $NF}' || true)\n            vac=0\n            if [ \"$asserts\" = \"0\" ]; then vac=1; fi\n            echo \"${spec}|leg=t27b|tests=${3:-NA}|pass=${1:-NA}|FAIL=${2:-NA}|vacuous=${vac}|asserts=${asserts:-NA}\" >> \"$out\"\n            if [ -z \"${3:-}\" ]; then echo \"--- ${spec}: t27b gave no count; its last 20 lines:\"; tail -n 20 /tmp/b.txt; fi\n          done\n          cat \"$out\"\n      - name: publish the t27b leg beside the receipt\n        shell: bash\n        run: |\n          git config user.name \"t27os lab\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add runs/*.t27b.txt\n          git commit -m \"lab: t27b leg for ${{ needs.run.outputs.resolved }}\"\n          for i in 1 2 3; do git pull --rebase origin master && git push origin HEAD:master && break; sleep 5; done\n";

// t27b_job_ok(y): the job text TRI CLAW appends is the one this law asks for -- arm64, after
// the run job, on its resolved sha, building and running t27b with --check, and writing a
// tagged line per spec.
pub fn t27b_job_ok(y: []const u8) -> bool {
    return contains(y, T27B_RUNNER) and !contains(y, X86_RUNNER)
        and contains(y, T27B_NEEDS) and contains(y, T27B_SAME_SHA)
        and contains(y, T27B_BUILD) and contains(y, T27B_RUN) and contains(y, T27B_CHECK)
        and contains(y, T27B_ASSERTS_LINE) and contains(y, T27B_ASSERTS_GUARD)
        and contains(y, T27B_LINE_TAG);
}

// run_outputs_ok(y): the run job exports the sha it resolved, so the two legs test one commit.
pub fn run_outputs_ok(y: []const u8) -> bool {
    return contains(y, "outputs:") and contains(y, "steps.sha.outputs.resolved");
}

// --- the t27b gate (Refs #12871) ------------------------------------------
//
// Measured 2026-11-09 (lab run 42566079417, PR #13383): at t27 8f7aaee865 the t27b leg wrote
// "specs/tri/shootout/l1_clamp.t27|leg=t27b|tests=7|pass=5|FAIL=2|vacuous=0|asserts=26" and
// the run still concluded success: only the t27c summary had a gate. A t27b row now passes
// only when it is a t27b row with FAIL=0, so a failing test (FAIL=2) and an NA row (t27b gave
// no count because it could not build or run the spec, FAIL=NA) both fail the run, and so does
// a row the gate cannot read. T27B_GATE_YAML is the last step of job t27b, after the leg and
// the asm listing are published, so the evidence lands before the run turns red. Its grep keeps
// exactly the rows t27b_row_ok refuses; a missing receipt fails too. Vacuity stays out of this
// gate, as it stays out of the t27c one; leg_state below already keeps VACUOUS out of PASS.

pub const T27B_ROW_PASS : str = "|FAIL=0|";
pub const T27B_GATE_GREP : str = "! grep -v '|leg=t27b|.*|FAIL=0|' $f";
pub const T27B_GATE_FILE : str = "[ -f $f ] &&";
pub const T27B_GATE_YAML : str = "      - name: gate -- a t27b row that is not FAIL=0 (a failing test, or NA when t27b could not run the spec) fails the run, after the leg is published (t27 specs/t27os/lab_legs.t27, fn t27b_row_ok)\n        run: \"f=runs/${{ needs.run.outputs.resolved }}.t27b.txt; [ -f $f ] && ! grep -v '|leg=t27b|.*|FAIL=0|' $f || { echo '::error::t27b rows above are FAIL>0 or NA'; exit 1; }\"\n";

// t27b_row_ok(row): one line of runs/<sha>.t27b.txt passes the gate.
pub fn t27b_row_ok(row: []const u8) -> bool {
    return contains(row, T27B_LINE_TAG) and contains(row, T27B_ROW_PASS);
}

// t27b_gate_ok(y): the step reads the resolved sha's t27b receipt, fails closed when it is
// missing, keeps the refused rows, and does not swallow grep's verdict.
pub fn t27b_gate_ok(y: []const u8) -> bool {
    return contains(y, T27B_GATE_GREP) and contains(y, T27B_GATE_FILE)
        and contains(y, T27B_SAME_SHA) and contains(y, ".t27b.txt")
        and contains(y, "exit 1") and !contains(y, "|| true");
}

// leg_state(ran, blocked, passed, failed, vacuous): the state of one leg from the counts its
// compiler printed. A leg that never ran is ABSENT; blocked beats every count; a failed test
// beats a vacuous one; zero passing tests is VACUOUS, never PASS.
pub fn leg_state(ran: bool, blocked: bool, passed: u32, failed: u32, vacuous: u32) -> u8 {
    if (!ran) {
        return LEG_ABSENT;
    }
    if (blocked) {
        return LEG_BLOCKED;
    }
    if (failed > 0) {
        return LEG_FAIL;
    }
    if (vacuous > 0) {
        return LEG_VACUOUS;
    }
    if (passed == 0) {
        return LEG_VACUOUS;
    }
    return LEG_PASS;
}

// line_verdict(t27c, t27b, extern_spec): the verdict of one receipt line.
pub fn line_verdict(t27c: u8, t27b: u8, extern_spec: bool) -> u8 {
    if (t27b != LEG_PASS) {
        return LINE_RED;
    }
    if (t27c == LEG_PASS) {
        return LINE_GREEN;
    }
    if (t27c == LEG_BLOCKED and extern_spec) {
        return LINE_GREEN;
    }
    return LINE_RED;
}

// may_leave_draft(touched, green): a night PR leaves draft only when every spec it touches
// has a green line; a PR that touches no spec has no receipt to stand on and stays draft.
pub fn may_leave_draft(touched: u32, green: u32) -> bool {
    if (touched == 0) {
        return false;
    }
    return green == touched;
}

// --- asm leg (axis C of the t27b bench, t27#12871) -------------------------
//
// Axis C asks how many instructions t27b spends on a hot-loop iteration against gcc -O2 and
// zig ReleaseFast. The only numbers so far are 3.43 (t27b / gcc -O2) and 4.47 (t27b / zig
// ReleaseFast) in docs/reports/t27b-bench-2026-10.md: dynamic instruction-count geomeans over
// 20 tier-1 specs under qemu, from a one-off run that nobody can repeat. This leg gives a
// number the lab repeats on every dispatch that names a shootout spec.
//
// What it counts, per spec, for each of the three listings (t27b asm; objdump -d of the gcc -O2
// object built from t27c gen-c; objdump -d of the zig ReleaseFast test binary built from t27c
// gen with every declaration kept): inside the functions the spec declares (functions, tests
// and invariants, by the names t27b asm prints), a back branch is a branch whose target was
// already seen in the same function; the hot loop is the longest span from such a target to
// its branch, inclusive. The receipt line gives the three spans, the bl calls inside each span
// and x100 = round(100 * t27b / reference), which reads against 343 (gcc) and 447 (zig).
//
// Caveats the receipt carries in its columns, not in prose: t27b does not inline, so a call in
// its loop body is counted as one bl (t27b_calls) while gcc and zig count the inlined body; an
// unrolled or vectorised loop does several source iterations per span; the count is static, so
// it says nothing of how often the loop runs. A spec without a loop reports 0 and x100=NA.
//
// The step text has no backslash, so jq decodes the literal below byte for byte into lab.yml.

pub const ASM_RUN : str = "./target/release/t27b asm";
pub const ASM_GCC : str = "gcc -std=gnu11 -O2";
pub const ASM_ZIG : str = "zig test -O ReleaseFast";
pub const ASM_ZIG_ARM : str = "zig-aarch64-linux-0.16.0";
pub const ASM_ZIG_X86 : str = "zig-x86_64";
pub const ASM_DUMP : str = "objdump -d";
pub const ASM_KEEP_DECLS : str = "refAllDecls(@This())";
pub const ASM_BACK_BRANCH : str = "(t in at)";
pub const ASM_LINE_TAG : str = "|leg=asm|";
pub const ASM_OUT : str = "runs/$sha.asm.txt";
pub const ASM_PUBLISH_PATH : str = "-- runs/${{ needs.run.outputs.resolved }}.asm.txt";
pub const ASM_ONLY_SHOOTOUT : str = "if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}";
pub const ASM_RATIO : str = "gx=$(( (bt * 100 + g / 2) / g ))";

pub const T27B_ASM_STEP_YAML : str = "      - name: asm leg -- static hot-loop length of the shootout specs, t27b vs gcc -O2 vs zig ReleaseFast (t27#12871)\n        if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}\n        timeout-minutes: 25\n        shell: bash\n        env:\n          SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n        run: |\n          set -f\n          sha=${{ needs.run.outputs.resolved }}\n          out=\"$GITHUB_WORKSPACE/runs/$sha.asm.txt\"\n          mkdir -p \"$GITHUB_WORKSPACE/runs\" /tmp/asm /tmp/zig\n          : > \"$out\"\n          : > /tmp/asm/listing.txt\n          curl -fsSL \"https://ziglang.org/download/0.16.0/zig-aarch64-linux-0.16.0.tar.xz\" -o /tmp/zig.tar.xz\n          tar -xJf /tmp/zig.tar.xz -C /tmp/zig --strip-components=1\n          cd t27\n          cargo build --release -p t27c\n          hot() {\n            awk -v re=\"^((test|invariant)[ ._]|[^ ]*[.])?($1)([.][^ ]*)?$\" '\n              /^[0-9a-f]+ <.*>:$/ { f = $2; gsub(/[<>:]/, \"\", f); on = (f ~ re); split(\"\", at); n = 0; next }\n              / ; line [0-9]+$/ { f = $1; if (f == \"test\" || f == \"invariant\") f = $2; sub(/:$/, \"\", f); sub(/^_/, \"\", f); on = (f ~ re); split(\"\", at); n = 0; next }\n              on && /^ +[0-9a-f]+:/ {\n                a = $1; sub(/:$/, \"\", a); n++; at[a] = n; L[n] = $0; c[n] = c[n - 1] + ($3 == \"bl\"); m = $3; t = \"\"\n                if (m == \"b\" || m ~ /^b[.]/) t = $4; else if (m == \"cbz\" || m == \"cbnz\") t = $5; else if (m == \"tbz\" || m == \"tbnz\") t = $6\n                sub(/^0x/, \"\", t)\n                if (t != \"\" && (t in at)) { k = n - at[t] + 1; if (k > hot) { hot = k; calls = c[n] - c[at[t] - 1]; hf = f; H = \"\"; for (i = at[t]; i <= n; i++) H = H L[i] ORS } }\n              }\n              END { print hot + 0, calls + 0, (hf == \"\" ? \"-\" : hf); printf \"%s\", H }' \"$2\"\n          }\n          echo \"# asm leg, t27@${sha}: the hot loop is the longest span from a back branch target to that branch, inclusive, in the spec functions (aarch64, static count)\" >> \"$out\"\n          echo \"# t27b asm | gcc -O2 of t27c gen-c ($(gcc -dumpfullversion)) | zig ReleaseFast of t27c gen ($(/tmp/zig/zig version)); x100 = 100 * t27b / reference\" >> \"$out\"\n          for spec in $SPECS; do\n            case \"$spec\" in specs/tri/shootout/*) ;; *) continue ;; esac\n            s=\"/tmp/asm/$(basename \"$spec\" .t27)\"\n            : > \"$s.err\"; : > \"$s.t27b.s\"; : > \"$s.gcc.s\"; : > \"$s.zig.s\"\n            ./target/release/t27b asm \"$spec\" > \"$s.t27b.s\" 2>> \"$s.err\" || true\n            names=$(awk '/ ; line [0-9]+$/ { f = $1; if (f == \"test\" || f == \"invariant\") f = $2; sub(/:$/, \"\", f); sub(/^_/, \"\", f); print f }' \"$s.t27b.s\" | paste -sd'|' -)\n            names=${names:-NONE}\n            ./target/release/t27c gen-c \"$spec\" > \"$s.c\" 2>> \"$s.err\" && gcc -std=gnu11 -O2 -w -c \"$s.c\" -o \"$s.o\" 2>> \"$s.err\" && objdump -d \"$s.o\" > \"$s.gcc.s\" || true\n            ./target/release/t27c gen \"$spec\" > \"$s.zig\" 2>> \"$s.err\" && echo 'test { @import(\"std\").testing.refAllDecls(@This()); }' >> \"$s.zig\" && /tmp/zig/zig test -O ReleaseFast --test-no-exec -femit-bin=\"$s.elf\" \"$s.zig\" 2>> \"$s.err\" && objdump -d \"$s.elf\" > \"$s.zig.s\" || true\n            for p in t27b gcc zig; do hot \"$names\" \"$s.$p.s\" > \"$s.$p.hot\"; done\n            read -r bt bc bf < \"$s.t27b.hot\" || true\n            read -r g gc gf < \"$s.gcc.hot\" || true\n            read -r z zc zf < \"$s.zig.hot\" || true\n            gx=NA; zx=NA\n            if [ \"$bt\" -gt 0 ] && [ \"$g\" -gt 0 ]; then gx=$(( (bt * 100 + g / 2) / g )); fi\n            if [ \"$bt\" -gt 0 ] && [ \"$z\" -gt 0 ]; then zx=$(( (bt * 100 + z / 2) / z )); fi\n            echo \"${spec}|leg=asm|t27b=${bt}|t27b_calls=${bc}|gcc_O2=${g}|gcc_calls=${gc}|zig_RFast=${z}|zig_calls=${zc}|gcc_x100=${gx}|zig_x100=${zx}|fn=${bf}/${gf}/${zf}\" >> \"$out\"\n            for p in t27b gcc zig; do echo \"--- ${spec} ${p}: $(head -n 1 \"$s.$p.hot\")\"; tail -n +2 \"$s.$p.hot\"; done >> /tmp/asm/listing.txt\n            if [ ! -s \"$s.t27b.s\" ] || [ ! -s \"$s.gcc.s\" ] || [ ! -s \"$s.zig.s\" ]; then echo \"--- ${spec}: a listing is missing; the last 20 error lines:\"; tail -n 20 \"$s.err\"; fi\n          done\n          cat /tmp/asm/listing.txt >> \"$out\"\n          cat \"$out\"\n      - name: publish the asm leg beside the receipt\n        if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}\n        shell: bash\n        run: |\n          # the receipt home is master, whatever ref was dispatched (t27 specs/t27os/lab_publish.t27)\n          git config user.name \"t27os lab\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add runs/${{ needs.run.outputs.resolved }}.asm.txt\n          git diff --cached --quiet && exit 0\n          git commit -q -m \"lab asm leg (staging)\"\n          rcpt=$(git rev-parse HEAD)\n          for i in 1 2 3; do\n            git fetch origin master\n            git checkout -q -f -B receipt origin/master\n            git checkout \"$rcpt\" -- runs/${{ needs.run.outputs.resolved }}.asm.txt\n            git diff --cached --quiet && exit 0\n            git commit -q -m \"lab: asm leg for ${{ needs.run.outputs.resolved }}\"\n            git push origin HEAD:master && exit 0\n            sleep 5\n          done\n          exit 1\n";

// asm_measures_ok(y): the step runs t27b asm, gcc -O2 and zig ReleaseFast on the same spec,
// disassembles the two references with objdump, keeps every zig declaration, counts back
// branches, and writes a tagged line into runs/<sha>.asm.txt.
pub fn asm_measures_ok(y: []const u8) -> bool {
    return contains(y, ASM_RUN) and contains(y, ASM_GCC) and contains(y, ASM_ZIG)
        and contains(y, ASM_DUMP) and contains(y, ASM_KEEP_DECLS) and contains(y, ASM_BACK_BRANCH)
        and contains(y, ASM_LINE_TAG) and contains(y, ASM_OUT);
}

// asm_arm_ok(y): the zig it fetches is the arm64 one, the job's own architecture, so the three
// listings are all aarch64.
pub fn asm_arm_ok(y: []const u8) -> bool {
    return contains(y, ASM_ZIG_ARM) and !contains(y, ASM_ZIG_X86);
}

// asm_guard_ok(y): the leg runs only when the dispatch names a shootout spec, reads the list
// through the documented fallback, and measures the sha the run job resolved.
pub fn asm_guard_ok(y: []const u8) -> bool {
    return contains(y, ASM_ONLY_SHOOTOUT) and specs_list_ok(y) and contains(y, T27B_SAME_SHA);
}

// asm_publish_ok(y): the asm file reaches master the way every receipt does (lab_publish.t27),
// and only that file.
pub fn asm_publish_ok(y: []const u8) -> bool {
    return publish_ok(y) and contains(y, ASM_PUBLISH_PATH);
}

pub fn asm_step_ok(y: []const u8) -> bool {
    return asm_measures_ok(y) and asm_arm_ok(y) and asm_guard_ok(y) and asm_publish_ok(y);
}

// asm_x100(b, r): the receipt's ratio column, round(100 * b / r); 0 stands for NA (no loop in
// one of the two listings).
pub fn asm_x100(b: u32, r: u32) -> u32 {
    if (b == 0) {
        return 0;
    }
    if (r == 0) {
        return 0;
    }
    return (b * 100 + r / 2) / r;
}

// --- tests ---------------------------------------------------------------

test leg_state_reads_the_counts {
    assert leg_state(false, false, 7, 0, 0) == LEG_ABSENT;
    assert leg_state(true, true, 7, 0, 0) == LEG_BLOCKED;
    assert leg_state(true, false, 6, 1, 0) == LEG_FAIL;
    assert leg_state(true, false, 6, 1, 1) == LEG_FAIL;
    assert leg_state(true, false, 6, 0, 1) == LEG_VACUOUS;
    assert leg_state(true, false, 0, 0, 0) == LEG_VACUOUS;
    assert leg_state(true, false, 7, 0, 0) == LEG_PASS;
}

test line_red_without_a_t27b_leg {
    // the #11884 specimen: labs 11/11 under t27c, no t27b line on the receipt
    var c : u8 = leg_state(true, false, 11, 0, 0);
    var b : u8 = leg_state(false, false, 0, 0, 0);
    assert line_verdict(c, b, false) == LINE_RED;
}

test line_green_on_both_legs {
    var c : u8 = leg_state(true, false, 11, 0, 0);
    var b : u8 = leg_state(true, false, 11, 0, 0);
    assert line_verdict(c, b, false) == LINE_GREEN;
}

test extern_excuse_is_one_way {
    // the glass_window specimen: t27c blocked on @extern, t27b runs it
    assert line_verdict(LEG_BLOCKED, LEG_PASS, true) == LINE_GREEN;
    // the same t27c block on a spec without @extern is a defect, not an excuse
    assert line_verdict(LEG_BLOCKED, LEG_PASS, false) == LINE_RED;
    // a t27b block is never excused, extern or not
    assert line_verdict(LEG_PASS, LEG_BLOCKED, true) == LINE_RED;
    assert line_verdict(LEG_BLOCKED, LEG_BLOCKED, true) == LINE_RED;
}

test line_red_on_any_bad_leg {
    assert line_verdict(LEG_FAIL, LEG_PASS, false) == LINE_RED;
    assert line_verdict(LEG_VACUOUS, LEG_PASS, false) == LINE_RED;
    assert line_verdict(LEG_ABSENT, LEG_PASS, false) == LINE_RED;
    assert line_verdict(LEG_PASS, LEG_FAIL, false) == LINE_RED;
    assert line_verdict(LEG_PASS, LEG_VACUOUS, false) == LINE_RED;
    // an extern spec does not excuse a failing t27c leg
    assert line_verdict(LEG_FAIL, LEG_PASS, true) == LINE_RED;
}

test draft_exit_needs_every_touched_spec_green {
    assert may_leave_draft(0, 0) == false;
    assert may_leave_draft(2, 1) == false;
    assert may_leave_draft(2, 2) == true;
}

invariant a_pass_is_never_vacuous {
    // zero passing tests can never make a PASS leg, whatever else the counts say
    assert leg_state(true, false, 0, 0, 0) != LEG_PASS;
}

test t27b_job_is_the_law {
    assert t27b_job_ok(T27B_JOB_YAML);
    assert run_outputs_ok(RUN_OUTPUTS_YAML);
    // the job writes the receipt's key=value shape, with the counts leg_state reads
    assert contains(T27B_JOB_YAML, "|tests=");
    assert contains(T27B_JOB_YAML, "|FAIL=");
    assert contains(T27B_JOB_YAML, "|vacuous=");
}

test t27b_job_refused_on_x86 {
    // negative control: the same job on the lab job's own runner cannot run the JIT
    assert t27b_job_ok("  t27b:\n    needs: run\n    runs-on: ubuntu-latest\n    steps:\n      - run: cargo build --release -p t27b; ./target/release/t27b test s --check; needs.run.outputs.resolved : runtime asserts |leg=t27b|\n") == false;
}

test t27b_job_refused_without_check {
    // without --check t27b prints no runtime-asserts line, so vacuity is unknowable
    assert t27b_job_ok("  t27b:\n    needs: run\n    runs-on: ubuntu-24.04-arm\n    steps:\n      - run: cargo build --release -p t27b; ./target/release/t27b test s; needs.run.outputs.resolved : runtime asserts |leg=t27b|\n") == false;
    // nor on its own sha: a job that does not read the run job's output tests master
    assert t27b_job_ok("  t27b:\n    needs: run\n    runs-on: ubuntu-24.04-arm\n    steps:\n      - run: cargo build --release -p t27b; ./target/release/t27b test s --check; : runtime asserts |leg=t27b|\n") == false;
    assert run_outputs_ok("    runs-on: ubuntu-latest\n") == false;
}

test t27b_job_refused_with_unguarded_asserts {
    // the job text of lab run 40161451315: a spec with no runtime-asserts line ends the leg
    const ok : str = "  t27b:\n    needs: run\n    runs-on: ubuntu-24.04-arm\n    steps:\n      - run: cargo build --release -p t27b; ./target/release/t27b test s --check; needs.run.outputs.resolved; asserts=$(grep -E ': runtime asserts ' b | awk '{print $NF}' || true) |leg=t27b|\n";
    assert t27b_job_ok(ok);
    assert t27b_job_ok("  t27b:\n    needs: run\n    runs-on: ubuntu-24.04-arm\n    steps:\n      - run: cargo build --release -p t27b; ./target/release/t27b test s --check; needs.run.outputs.resolved; asserts=$(grep -E ': runtime asserts ' b | awk '{print $NF}') |leg=t27b|\n") == false;
    assert contains(T27B_JOB_YAML, T27B_ASSERTS_GUARD);
}

test t27b_job_shows_why_a_count_is_missing {
    // the job text carries the tail line, so an NA row in runs/<sha>.t27b.txt has its reason in the log
    assert na_tail_ok(T27B_JOB_YAML);
    // negative control: the job text of lab run 40163543896 swallowed t27b's output
    assert na_tail_ok("            echo \"${spec}|leg=t27b|tests=${3:-NA}\" >> \"$out\"\n          done\n") == false;
    // the tail goes to the log, not into the receipt line: that line keeps its key=value shape
    assert contains(T27B_JOB_YAML, "|tests=${3:-NA}|");
}

test a_scheduled_run_still_names_specs {
    // both jobs read the list through the fallback, so a schedule tick tests the core set
    assert specs_list_ok(T27B_JOB_YAML);
    assert specs_list_ok(RUN_SPECS_ENV_YAML);
    assert contains(RUN_SPECS_ENV_YAML, "LAB_SPECS: ");
    // the run job's loop reads the env line, not the input
    assert contains(RUN_SPECS_LOOP, "$LAB_SPECS") and !contains(RUN_SPECS_LOOP, BARE_SPECS);
}

test bare_input_refused {
    // negative control: the loop of lab run 40200028058 (schedule, zero specs, no summary)
    assert specs_list_ok("          for spec in ${{ inputs.specs }}; do\n") == false;
    // negative control: the t27b env line before this law
    assert specs_list_ok("        env:\n          SPECS: ${{ inputs.specs }}\n") == false;
    // a fallback to some other list is not the documented core set
    assert specs_list_ok("    env:\n      LAB_SPECS: ${{ inputs.specs || 'specs/t27f/hud.t27' }}\n") == false;
}

test asm_step_is_the_law {
    assert asm_step_ok(T27B_ASM_STEP_YAML);
    // the receipt line carries the three spans, the calls in each and both ratios
    assert contains(T27B_ASM_STEP_YAML, "|t27b=${bt}|t27b_calls=${bc}|");
    assert contains(T27B_ASM_STEP_YAML, "|gcc_O2=${g}|gcc_calls=${gc}|");
    assert contains(T27B_ASM_STEP_YAML, "|zig_RFast=${z}|zig_calls=${zc}|");
    assert contains(T27B_ASM_STEP_YAML, "|gcc_x100=${gx}|zig_x100=${zx}|");
    assert contains(T27B_ASM_STEP_YAML, ASM_RATIO);
    assert contains(T27B_ASM_STEP_YAML, "lab: asm leg for ${{ needs.run.outputs.resolved }}");
    assert contains(T27B_ASM_STEP_YAML, "          exit 1\n");
    // no backslash, so the jq-decoded literal is the lab.yml text byte for byte
    assert !contains(T27B_ASM_STEP_YAML, "\\");
}

test asm_ratio_matches_the_step {
    // the shell column is (bt * 100 + g / 2) / g; these are the same numbers
    assert asm_x100(343, 100) == 343;
    assert asm_x100(447, 100) == 447;
    assert asm_x100(2, 3) == 67;
    assert asm_x100(1, 3) == 33;
    assert asm_x100(5, 0) == 0;
    assert asm_x100(0, 7) == 0;
}

test asm_measures_refused_without_a_part {
    const ok : str = "./target/release/t27b asm s; gcc -std=gnu11 -O2 -c; zig test -O ReleaseFast; objdump -d o; refAllDecls(@This()); (t in at); |leg=asm|; runs/$sha.asm.txt";
    assert asm_measures_ok(ok);
    // negative control: no objdump, so the reference counts never exist
    assert asm_measures_ok("./target/release/t27b asm s; gcc -std=gnu11 -O2 -c; zig test -O ReleaseFast; refAllDecls(@This()); (t in at); |leg=asm|; runs/$sha.asm.txt") == false;
    // negative control: zig drops the unreferenced spec functions without refAllDecls
    assert asm_measures_ok("./target/release/t27b asm s; gcc -std=gnu11 -O2 -c; zig test -O ReleaseFast; objdump -d o; (t in at); |leg=asm|; runs/$sha.asm.txt") == false;
    // negative control: a whole-function count is not a loop count
    assert asm_measures_ok("./target/release/t27b asm s; gcc -std=gnu11 -O2 -c; zig test -O ReleaseFast; objdump -d o; refAllDecls(@This()); |leg=asm|; runs/$sha.asm.txt") == false;
    // the t27b job itself measures nothing of this
    assert asm_step_ok(T27B_JOB_YAML) == false;
}

test asm_zig_must_be_arm {
    assert asm_arm_ok("curl -fsSL https://ziglang.org/download/0.16.0/zig-aarch64-linux-0.16.0.tar.xz");
    // negative control: an x86 zig cannot run on the arm runner, and its listing is not aarch64
    assert asm_arm_ok("curl -fsSL https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz") == false;
    assert asm_arm_ok("zig-aarch64-linux-0.16.0 zig-x86_64-linux-0.16.0") == false;
}

test asm_guard_needs_shootout_fallback_and_sha {
    const ok : str = "        if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}\n          SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n          sha=${{ needs.run.outputs.resolved }}\n";
    assert asm_guard_ok(ok);
    // negative control: without the guard every schedule tick downloads zig and builds t27c
    assert asm_guard_ok("          SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n          sha=${{ needs.run.outputs.resolved }}\n") == false;
    // negative control: the bare input, refused as in bare_input_refused
    assert asm_guard_ok("        if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}\n          SPECS: ${{ inputs.specs }}\n          sha=${{ needs.run.outputs.resolved }}\n") == false;
    // negative control: a step that does not read the run job's sha measures master
    assert asm_guard_ok("        if: ${{ contains(inputs.specs, 'specs/tri/shootout/') }}\n          SPECS: ${{ inputs.specs || 'specs/t27f/work_graph.t27 specs/queen/actors.t27 specs/t27f/export_video.t27 specs/t27f/frame_render.t27 specs/t27f/live_mode.t27 specs/t27f/hud.t27' }}\n") == false;
}

test asm_publish_is_the_receipt_law {
    const ok : str = "git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit checkout \"$rcpt\" -- runs/${{ needs.run.outputs.resolved }}.asm.txt\ngit push origin HEAD:master && exit 0\n";
    assert asm_publish_ok(ok);
    // negative control: the pull-based loop lab_publish.t27 retired
    assert asm_publish_ok("git fetch origin master\ngit checkout -q -f -B receipt origin/master\ngit pull --rebase origin master\ngit checkout \"$rcpt\" -- runs/${{ needs.run.outputs.resolved }}.asm.txt\ngit push origin HEAD:master && exit 0\n") == false;
    // negative control: the t27b publish step is lawful but carries the other file
    assert publish_ok(T27B_PUBLISH_YAML);
    assert asm_publish_ok(T27B_PUBLISH_YAML) == false;
}

test t27b_row_verdict {
    // the row of lab run 42566079417 (t27 8f7aaee865): two failing tests, and the run said success
    assert t27b_row_ok("specs/tri/shootout/l1_clamp.t27|leg=t27b|tests=7|pass=5|FAIL=2|vacuous=0|asserts=26") == false;
    // an NA row: t27b gave no count because it could not build or run the spec
    assert t27b_row_ok("specs/t27os/hdmi_grab_main.t27|leg=t27b|tests=NA|pass=NA|FAIL=NA|vacuous=0|asserts=NA") == false;
    // a two-digit failure count is not FAIL=0
    assert t27b_row_ok("s.t27|leg=t27b|tests=12|pass=2|FAIL=10|vacuous=0|asserts=9") == false;
    // a t27c summary row is not a t27b row, FAIL=0 or not
    assert t27b_row_ok("s.t27|tests=7|pass=7|FAIL=0|vacuous=0|blocked=0") == false;
    // the same spec at t27 09bf007d65: 7 of 7
    assert t27b_row_ok("specs/tri/shootout/l1_clamp.t27|leg=t27b|tests=7|pass=7|FAIL=0|vacuous=0|asserts=26");
}

test t27b_gate_is_the_law {
    assert t27b_gate_ok(T27B_GATE_YAML);
    // the grep keeps the rows t27b_row_ok refuses: the t27b tag, then FAIL=0
    assert contains(T27B_GATE_GREP, T27B_LINE_TAG) and contains(T27B_GATE_GREP, T27B_ROW_PASS);
    // negative control: the job before this law had no gate, so a FAIL=2 row concluded success
    assert t27b_gate_ok(T27B_JOB_YAML) == false;
    assert t27b_gate_ok(T27B_ASM_STEP_YAML) == false;
    // negative control: a gate that swallows grep's verdict cannot fail
    assert t27b_gate_ok("        run: \"f=runs/${{ needs.run.outputs.resolved }}.t27b.txt; [ -f $f ] && ! grep -v '|leg=t27b|.*|FAIL=0|' $f || true; exit 1\"\n") == false;
    // negative control: without the file test a missing receipt passes the gate
    assert t27b_gate_ok("        run: \"f=runs/${{ needs.run.outputs.resolved }}.t27b.txt; ! grep -v '|leg=t27b|.*|FAIL=0|' $f || { exit 1; }\"\n") == false;
}
