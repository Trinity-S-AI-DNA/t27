// SPDX-License-Identifier: Apache-2.0
; specs/t27os/vf_frame_main.t27 -- host program: viewable frames of the T27F task card (Refs gHashTag/t27#13214,
; T27F-005 visual gap, T27F-006 widths). It lays the task card out at FRAME_W wide (default 375; 768 and 1280 are the other
; two widths of the viewport table), renders it with vf_render (flat fills, outlines, 5x7 labels), writes the Wx192 raster as a
; binary PPM P6 (15 header bytes below 1000 wide, 16 from 1000, then W * 192 * 3 RGB bytes) to FRAME_OUT, and prints the meaning
; of every node (kind, depth, relation to the previous sibling, gap, rectangle, label) from vf_meaning to stderr.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM. The tests below pin bytes of the PPM; they do not say it looks right. The claim
; "the card looks right" starts only when somebody has opened the frame and compared it with the meaning lines.
; --
; BUILD AND RUN (a heavy build: on the lab or in a T27 OS pane, not on the Mac without the owner's word):
;   t27c gen specs/t27os/vf_frame_main.t27 > vf_frame.zig
;   zig build-exe vf_frame.zig -lc
;   FRAME_W=768 FRAME_OUT=target/vf_frame_768.ppm ./vf_frame 2> target/vf_frame_768.txt
;   ffmpeg -y -i target/vf_frame_768.ppm target/vf_frame_768.png
; FRAME_W is 1..1280 (the buffers are sized for 1280); anything else that is not a number keeps 375. FRAME_OUT defaults to
; target/vf_frame.ppm, a path under the working directory (target/ is gitignored), never /tmp.
; FRAME_PCT (25..400, absent or 0 = the flat vf_render path above) renders through vf_scale at that percent of the design size, with
; every edge weighted by the area it covers (antialiased): 768 wide at 200 percent is a 1536 x 384 frame, 375 at 150 is 563 x 288.
; The raster is capped at 2073600 pixels (frame_render's cap); 1280 at 300 or 400 percent is refused.
; An unopenable FRAME_OUT or a short write exits 2; a render refusal (a width past 1280, a scale outside 25..400) exits 1.
; --
; Module-level vars are never spliced by `use`, so the two byte buffers live here and are passed to vf_render as slices.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osVfFrameMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_px_card;
use t27f::vf_render::vf_render_ppm;
use t27f::vf_render::VF_R_OK;
use t27f::frame_render::ppm_len;
use t27f::frame_render::ppm_write_into;
use t27f::vf_scale::vf_render_scaled;
use t27f::vf_scale::vf_s_size;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_relation_word;
use t27f::vf_meaning::vf_primary_action;

; sized for the widest frame, 1280 x 192: 1280 * 192 * 3 = 737280 RGB bytes, plus the 16 header bytes of P6 1280 192 255
pub var VFM_RGB : [737280]u8 = [0] ** 737280;
pub var VFM_PPM : [737296]u8 = [0] ** 737296;

// the scaled frames (FRAME_PCT) are sized to the frame_render pixel cap, 2073600 pixels: 6220800 RGB bytes plus the 16 header bytes
pub var VFM_SRGB : [6220800]u8 = [0] ** 6220800;
pub var VFM_SPPM : [6220816]u8 = [0] ** 6220816;

pub const VFM_W : u32 = 375;
pub const VFM_H : u32 = 192;

/// Render g laid out as l at w x VFM_H into VFM_PPM; the vf_render result (0 is ok).
pub fn vfm_render(g: VfGraph, l: VfLayout, w: u32) -> u8 {
    return vf_render_ppm(g, l, &VFM_RGB, &VFM_PPM, w, VFM_H);
}

/// Render g laid out as l, w design pixels wide, at pct percent with antialiased edges into VFM_SPPM; 0 is ok.
/// The raster is vf_s_size(w, pct) x vf_s_size(VFM_H, pct); a scale outside 25..400 or a raster past the pixel cap is refused.
pub fn vfm_render_scaled(g: VfGraph, l: VfLayout, w: u32, pct: u32) -> u8 {
    var ow : u32 = vf_s_size(w, pct);
    var oh : u32 = vf_s_size(VFM_H, pct);
    var r : u8 = vf_render_scaled(g, l, &VFM_SRGB, ow, oh, pct);
    if r != VF_R_OK {
        return r;
    }
    return ppm_write_into(&VFM_SPPM, &VFM_SRGB, ow, oh);
}

pub fn main() void {
    var width : u32 = VFM_W;
    const qw = std.c.getenv("FRAME_W");
    if (qw != null) {
        const sp = qw.?;
        var wv : u32 = 0;
        var k : usize = 0;
        while (sp[k] != 0 and wv <= 4096) {
            if (sp[k] >= 48 and sp[k] <= 57) { wv = wv * 10 + ((sp[k] - 48) as u32); }
            k += 1;
        }
        if (wv > 0) { width = wv; }
    }
    var pct : u32 = 0;
    const qs = std.c.getenv("FRAME_PCT");
    if (qs != null) {
        const ps = qs.?;
        var pv : u32 = 0;
        var j : usize = 0;
        while (ps[j] != 0 and pv <= 4096) {
            if (ps[j] >= 48 and ps[j] <= 57) { pv = pv * 10 + ((ps[j] - 48) as u32); }
            j += 1;
        }
        pct = pv;
    }
    const g : VfGraph = vf_px_card(width);
    const l : VfLayout = vf_layout(g);
    var out_w : u32 = width;
    var out_h : u32 = VFM_H;
    var rr : u8 = VF_R_OK;
    if (pct == 0) {
        rr = vfm_render(g, l, width);
    } else {
        out_w = vf_s_size(width, pct);
        out_h = vf_s_size(VFM_H, pct);
        rr = vfm_render_scaled(g, l, width, pct);
    }
    if (rr != VF_R_OK) {
        std.debug.print("vf_frame: render refused at width {d} scale {d}, code {d}\n", .{ width, pct, rr });
        std.c.exit(1);
    }
    const nbytes : usize = ppm_len(out_w, out_h) as usize;
    var path : [*:0]const u8 = "target/vf_frame.ppm";
    const q = std.c.getenv("FRAME_OUT");
    if (q != null) { path = q.?; }
    const fp = std.c.fopen(path, "wb");
    if (fp == null) {
        std.debug.print("vf_frame: cannot open {s} for writing\n", .{path});
        std.c.exit(2);
    }
    var w : usize = 0;
    if (pct == 0) {
        w = std.c.fwrite(@ptrCast(&VFM_PPM), 1, nbytes, fp.?);
    } else {
        w = std.c.fwrite(@ptrCast(&VFM_SPPM), 1, nbytes, fp.?);
    }
    _ = std.c.fclose(fp.?);
    if (w != nbytes) {
        std.debug.print("vf_frame: short write to {s}: {d} of {d} bytes\n", .{ path, w, nbytes });
        std.c.exit(2);
    }
    std.debug.print("vf_frame: wrote {d} bytes to {s} ({d}x{d}, P6, design width {d}, scale {d} percent, 0 = flat)\n", .{ nbytes, path, out_w, out_h, width, pct });
    std.debug.print("meaning: node kind depth relation gap x y w h text\n", .{});
    var i : u32 = 0;
    while (i < l.node_count) {
        std.debug.print("  {d} {s} depth {d} {s} gap {d} at {d},{d} size {d}x{d} [{s}]\n", .{ i, vf_kind_word(g, i), vf_depth(g, i), vf_relation_word(vf_relation(g, l, i)), vf_gap(g, l, i), l.x[i], l.y[i], l.w[i], l.h[i], g.text[i] });
        i += 1;
    }
    std.debug.print("primary action: node {d}\n", .{vf_primary_action(g)});
    std.debug.print("vf_frame: a byte-level frame; open it and compare with the lines above before saying it looks right\n", .{});
}

test the_375_frame_is_15_header_bytes_plus_216000_rgb_bytes {
    const g : VfGraph = vf_px_card(375);
    const l : VfLayout = vf_layout(g);
    assert vfm_render(g, l, 375) == VF_R_OK;
    const want : []const u8 = "P6\n375 192\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert VFM_PPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(375, 192) == 216015;
    // pixel (0,0) is the card outline 0x444444 = 68 68 68, straight after the header
    assert VFM_PPM[15] == 68;
    assert VFM_PPM[16] == 68;
    assert VFM_PPM[17] == 68;
    // pixel (300,10) sits at 15 + (10 * 375 + 300) * 3 = 12165 and is the card fill 0xF5F5F5 = 245
    assert VFM_PPM[12165] == 245;
    assert VFM_PPM[12166] == 245;
    assert VFM_PPM[12167] == 245;
}

test the_768_frame_is_15_header_bytes_plus_442368_rgb_bytes {
    const g : VfGraph = vf_px_card(768);
    const l : VfLayout = vf_layout(g);
    assert vfm_render(g, l, 768) == VF_R_OK;
    const want : []const u8 = "P6\n768 192\n255\n";
    var i : usize = 0;
    while (i < want.len) {
        assert VFM_PPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(768, 192) == 442383;
    assert VFM_PPM[15] == 68;
    // pixel (700,10) sits at 15 + (10 * 768 + 700) * 3 = 25155 and is the card fill 245
    assert VFM_PPM[25155] == 245;
    // the last byte is the bottom-right outline pixel of the card
    assert VFM_PPM[442382] == 68;
}

test the_1280_frame_is_16_header_bytes_plus_737280_rgb_bytes {
    const g : VfGraph = vf_px_card(1280);
    const l : VfLayout = vf_layout(g);
    assert vfm_render(g, l, 1280) == VF_R_OK;
    const want : []const u8 = "P6\n1280 192\n255\n";
    assert want.len == 16;
    var i : usize = 0;
    while (i < want.len) {
        assert VFM_PPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(1280, 192) == 737296;
    assert VFM_PPM[16] == 68;
    // pixel (1200,10) sits at 16 + (10 * 1280 + 1200) * 3 = 42016 and is the card fill 245
    assert VFM_PPM[42016] == 245;
    // the Save button does not move with the width: pixel (50,160) is its fill 0x1565C0, red 21
    assert VFM_PPM[614566] == 21;
    assert VFM_PPM[737295] == 68;
}

test the_768_frame_at_200_percent_is_1536_by_384 {
    const g : VfGraph = vf_px_card(768);
    const l : VfLayout = vf_layout(g);
    assert vfm_render_scaled(g, l, 768, 200) == VF_R_OK;
    const want : []const u8 = "P6\n1536 384\n255\n";
    assert want.len == 16;
    var i : usize = 0;
    while (i < want.len) {
        assert VFM_SPPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(1536, 384) == 1769488;
    assert VFM_SPPM[16] == 68;
    // pixel (2,2) sits at 16 + (2 * 1536 + 2) * 3 = 9238 and is the card fill 245: the 2 px outline is two output pixels wide
    assert VFM_SPPM[9238] == 245;
}

test the_375_frame_at_150_percent_mixes_the_outline_edge {
    const g : VfGraph = vf_px_card(375);
    const l : VfLayout = vf_layout(g);
    assert vfm_render_scaled(g, l, 375, 150) == VF_R_OK;
    const want : []const u8 = "P6\n563 288\n255\n";
    assert want.len == 15;
    var i : usize = 0;
    while (i < want.len) {
        assert VFM_SPPM[i] == want[i];
        i += 1;
    }
    assert ppm_len(563, 288) == 486447;
    // pixel (0,100) is the outline 68, pixel (1,100) at 15 + (100 * 563 + 1) * 3 = 168918 is half outline half fill: 157
    assert VFM_SPPM[15 + 100 * 563 * 3] == 68;
    assert VFM_SPPM[168918] == 157;
}

test a_scale_outside_25_to_400_or_past_the_cap_is_refused {
    const g : VfGraph = vf_px_card(375);
    const l : VfLayout = vf_layout(g);
    assert vfm_render_scaled(g, l, 375, 24) != VF_R_OK;
    assert vfm_render_scaled(g, l, 375, 401) != VF_R_OK;
    const g2 : VfGraph = vf_px_card(1280);
    const l2 : VfLayout = vf_layout(g2);
    assert vfm_render_scaled(g2, l2, 1280, 400) != VF_R_OK;
    assert vfm_render_scaled(g2, l2, 1280, 200) == VF_R_OK;
}

test a_broken_layout_changes_the_bytes {
    // negative control: widen the title past the card; the same pixel turns into the title fill 0x222222 = 34
    const g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    l.w[1] = 400;
    assert vfm_render(g, l, 375) == VF_R_OK;
    assert VFM_PPM[12165] == 34;
    assert VFM_PPM[12166] == 34;
    assert VFM_PPM[12167] == 34;
}
