// SPDX-License-Identifier: Apache-2.0
// specs/t27os/tool_call.t27 -- T27 OS tool_call.t27: tool call, structured
// result, read-only allowlist (Wave A2).
// Part of M1 (milestone #5). Closes #13070.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::tool_call;

pub const TOOL_ALLOWLIST_MAX : u32 = 32;

pub struct ToolCall { tool: str, read_only: bool, allowed: bool };

pub fn tool_call_allowed(c: ToolCall) -> bool {
    return c.allowed && c.read_only;
}

test "tool call allowed" {
    assert(tool_call_allowed(ToolCall { tool: "read", read_only: true, allowed: true }));
    assert(!tool_call_allowed(ToolCall { tool: "write", read_only: false, allowed: true }));
    assert(!tool_call_allowed(ToolCall { tool: "read", read_only: true, allowed: false }));
}

invariant tool_allowlist_max_positive {
    assert TOOL_ALLOWLIST_MAX > 0;
}