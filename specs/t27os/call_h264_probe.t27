fn hp_dlsym(h: u64, name: []const u8) -> u64 { return @extern("dlsym"); }
fn hp_calloc(n: u64, size: u64) -> u64 { return @extern("calloc"); }
fn hp_now() -> f64 { return @extern("CFAbsoluteTimeGetCurrent"); }
fn hp_cf_dict(alloc: u64, keys: u64, vals: u64, n: u64, kcb: u64, vcb: u64) -> u64 { return @extern("CFDictionaryCreate"); }
fn hp_pb_create(alloc: u64, w: u64, h: u64, fmt: u32, attrs: u64, out: u64) -> i32 { return @extern("CVPixelBufferCreate"); }
fn hp_pb_lock(pb: u64, flags: u64) -> i32 { return @extern("CVPixelBufferLockBaseAddress"); }
fn hp_pb_unlock(pb: u64, flags: u64) -> i32 { return @extern("CVPixelBufferUnlockBaseAddress"); }
fn hp_pb_base(pb: u64) -> u64 { return @extern("CVPixelBufferGetBaseAddress"); }
fn hp_pb_row(pb: u64) -> u64 { return @extern("CVPixelBufferGetBytesPerRow"); }
fn hp_memset(p: u64, c: i32, n: u64) -> u64 { return @extern("memset"); }

const HP_RTLD : u64 = 18446744073709551614;
const HP_POOL : u64 = 8;
const HP_W : u64 = 1280;
const HP_H : u64 = 720;

fn hp_us() -> u64 { return @as(u64, @intFromFloat(hp_now() * 1000000.0)); }

fn hp_tag(caller: bool) -> void {
    if (caller) { ckh_line("[A] "); } else { ckh_line("[B] "); }
}

fn hp_n(caller: bool, label: []const u8, v: u64) -> void {
    hp_tag(caller);
    ckh_num(label, v);
}

/// Frame i into pb: a grey level that changes, a white bar 64 pixels wide moving 8 pixels a frame.
fn hp_paint(pb: u64, i: u64) -> void {
    hp_pb_lock(pb, 0);
    const base : u64 = hp_pb_base(pb);
    const row : u64 = hp_pb_row(pb);
    hp_memset(base, @as(i32, @intCast(40 + (i * 3) % 180)), row * HP_H);
    const bx : u64 = (i * 8) % (HP_W - 64);
    var y : u64 = 0;
    while (y < HP_H) {
        hp_memset(base + y * row + bx * 4, 255, 256);
        y = y + 1;
    }
    hp_pb_unlock(pb, 0);
}

/// A pool of HP_POOL source buffers on IOSurfaces at mem + 64; true when all were made.
fn hp_pool(mem: u64) -> bool {
    const empty : u64 = hp_cf_dict(0, 0, 0, 0, hp_dlsym(HP_RTLD, "kCFTypeDictionaryKeyCallBacks"), hp_dlsym(HP_RTLD, "kCFTypeDictionaryValueCallBacks"));
    cbp_put(mem, vt_konst("kCVPixelBufferIOSurfacePropertiesKey"));
    cbp_put(mem + 8, empty);
    const attrs : u64 = hp_cf_dict(0, mem, mem + 8, 1, hp_dlsym(HP_RTLD, "kCFTypeDictionaryKeyCallBacks"), hp_dlsym(HP_RTLD, "kCFTypeDictionaryValueCallBacks"));
    var k : u64 = 0;
    var made : u64 = 0;
    while (k < HP_POOL) {
        cbp_put(mem + 64 + k * 8, 0);
        if (hp_pb_create(0, HP_W, HP_H, VT_BGRA, attrs, mem + 64 + k * 8) == 0 and cbp_get(mem + 64 + k * 8) != 0) { made = made + 1; }
        k = k + 1;
    }
    return made == HP_POOL;
}

fn hp_side(caller: bool) -> bool {
    var fa : [10]u8 = undefined;
    var fb : [10]u8 = undefined;
    ckh_fps(fa[0..10], fb[0..10]);
    var my_port : u64 = 47792;
    var peer_port : u64 = 47791;
    if (caller) {
        my_port = 47791;
        peer_port = 47792;
    }
    var inv : [32]u8 = undefined;
    const invn : usize = ckh_env("CS_PEER_INVITE", inv[0..32]);
    var wfp : [10]u8 = undefined;
    const window : bool = caller and invn == INVITE_LEN and invite_parse(inv[0..INVITE_LEN], wfp[0..10]) == INV_OK;
    if (window) { peer_port = 47727; }
    my_port = ckh_env_num("CS_PORT", my_port);
    peer_port = ckh_env_num("CS_PEER_PORT", peer_port);
    const secs : u64 = ckh_env_num("CS_HSECS", 20);
    const hloss : u64 = ckh_env_num("CS_HLOSS", 0);
    var eb : [32]u8 = undefined;
    const old : bool = ckh_env("CS_HEXPECT", eb[0..32]) == 3 and eb[0] == 111 and eb[1] == 108 and eb[2] == 100;
    const v6 : bool = ckh_env("CS_V6", eb[0..32]) == 1 and eb[0] == 49;
    // the other side's loss: its parts are lost, so this side sees the losses (both sides are given the same CS_HLOSS)
    if (my_port == 0 or my_port > 65535 or peer_port == 0 or peer_port > 65535 or secs == 0 or secs > 600) {
        ckh_line("NOT RUN: CS_PORT, CS_PEER_PORT or CS_HSECS is malformed\n");
        return false;
    }
    var s : [299648]u8 = undefined;
    var me : [10]u8 = undefined;
    var peer : [10]u8 = undefined;
    var i : usize = 0;
    while (i < 10) {
        if (caller) { me[i] = fa[i]; peer[i] = fb[i]; } else { me[i] = fb[i]; peer[i] = fa[i]; }
        if (window) { peer[i] = wfp[i]; }
        i = i + 1;
    }
    var bind : u64 = 2130706433;
    if (v6) { bind = 0; }
    if (!cs_open(s[0..CS_LEN], me[0..10], bind, my_port, CS_AUDIO_TEST)) {
        ckh_line("NOT RUN: cs_open failed (socket or bind)\n");
        return false;
    }
    const e : u64 = vte_new();
    const d : u64 = vtd_new();
    const mem : u64 = hp_calloc(1, 256);
    var all : bool = true;
    all = ckh_check("encoder, decoder and 8 source buffers", e != 0 and d != 0 and mem != 0 and hp_pool(mem)) and all;
    all = ckh_check("video on, codec blocks handed in", cs_set(s[0..CS_LEN], CS_K_VIDEO, 1) and cs_video_h264(s[0..CS_LEN], e, d)) and all;
    if (hloss != 0) { all = ckh_check("a part in every CS_HLOSS is lost on the way", cs_set(s[0..CS_LEN], CS_K_VHLOSS, hloss)) and all; }
    if (v6) { all = ckh_check("the dual-stack socket on ::, the IPv6 loopback allowed (test aid)", cs_net(s[0..CS_LEN], CS_NET_SOCK6) == 1 and cs_set(s[0..CS_LEN], CS_K_LOOP6, 1)) and all; }
    if (!all) { return false; }
    var p6 : [18]u8 = undefined;
    ip6_clear(p6[0..18]);
    p6[15] = 1;
    p6[16] = @as(u8, @intCast((peer_port >> 8) & 255));
    p6[17] = @as(u8, @intCast(peer_port & 255));
    var dialled : bool = true;
    if (caller and v6) { dialled = cs_call6(s[0..CS_LEN], p6[0..18], peer[0..10]); }
    if (caller and !v6) { dialled = cs_call(s[0..CS_LEN], 2130706433, peer_port, peer[0..10]); }
    if (!dialled) {
        ckh_line("NOT RUN: cs_call refused\n");
        cs_close(s[0..CS_LEN]);
        return false;
    }
    var ended : bool = false;
    var hung : bool = false;
    var t_act : u64 = 0;
    var next_us : u64 = 0;
    var made : u64 = 0;
    var taken : u64 = 0;
    var last_pb : u64 = 0;
    var wbad : u64 = 0;
    // pictures decoded per whole second of video (the decoder's own count), and the slowest 5-second window
    var per : [600]u64 = undefined;
    var aper : [600]u64 = undefined;
    var z : usize = 0;
    while (z < 600) { per[z] = 0; aper[z] = 0; z = z + 1; }
    var sec_mark : u64 = 0;
    var out_mark : u64 = 0;
    var acc_mark : u64 = 0;
    var acc_min : u64 = 1000000;
    var nsec : u64 = 0;
    var jpeg0 : u64 = 0;
    var jpeg1 : u64 = 0;
    var jtx0 : u64 = 0;
    var jtx1 : u64 = 0;
    const t0 : u64 = ckh_ms();
    while (ckh_ms() - t0 < 60000 + secs * 1000 and !(ended and cs_state(s[0..CS_LEN]) == CK_IDLE)) {
        ckh_usleep(1000);
        var ev : u32 = cs_poll(s[0..CS_LEN]);
        while (ev != CS_EV_NONE) {
            if (ev == CS_EV_RINGING) { cs_answer(s[0..CS_LEN]); }
            if (ev == CS_EV_CODE) { cs_confirm(s[0..CS_LEN], true); }
            if (ev == CS_EV_ENDED or ev == CS_EV_FAILED) {
                ended = true;
                cs_dismiss(s[0..CS_LEN]);
            }
            ev = cs_poll(s[0..CS_LEN]);
        }
        const now : u64 = ckh_ms();
        if (cs_state(s[0..CS_LEN]) == CK_ACTIVE) {
            if (t_act == 0) {
                t_act = now;
                sec_mark = now;
                acc_mark = cs_stat(s[0..CS_LEN], CS_ST_ACCEPTED);
            }
            // the "camera": a frame every 33.3 ms, into the encoder once both ends agreed on H.264 (as the window's
            // camera does: cl_camera hands frames to the encoder only in that mode)
            const us : u64 = hp_us();
            if (cs_vh_mode(s[0..CS_LEN]) == VN_H264 and (next_us == 0 or us >= next_us)) {
                if (next_us == 0) { next_us = us; }
                next_us = next_us + 33333;
                const pb : u64 = cbp_get(mem + 64 + (made % HP_POOL) * 8);
                hp_paint(pb, made);
                vte_encode(e, pb, us);
                made = made + 1;
            }
            // the "window": take the newest picture
            const got : u64 = vtd_take(d);
            if (got != 0) {
                taken = taken + 1;
                if (vt_pb_w(got) != HP_W or vt_pb_h(got) != HP_H) { wbad = wbad + 1; }
                if (last_pb != 0) { vt_pb_release(last_pb); }
                last_pb = got;
            }
            if (now >= sec_mark + 1000 and nsec < 600) {
                const o : u64 = vtd_stat(d, VDK_OUT);
                const acc : u64 = cs_stat(s[0..CS_LEN], CS_ST_ACCEPTED);
                // the first two seconds are the codecs' start (sessions are made): not counted
                if (now - t_act >= 3000) {
                    if (nsec == 0) {
                        jpeg0 = cs_vstat(s[0..CS_LEN], CS_V_SHOWN);
                        jtx0 = cs_vstat(s[0..CS_LEN], CS_V_TXFRAMES);
                    }
                    jpeg1 = cs_vstat(s[0..CS_LEN], CS_V_SHOWN);
                    jtx1 = cs_vstat(s[0..CS_LEN], CS_V_TXFRAMES);
                    per[@as(usize, nsec)] = o - out_mark;
                    aper[@as(usize, nsec)] = acc - acc_mark;
                    nsec = nsec + 1;
                }
                hp_tag(caller);
                ckh_line("HSTAT");
                ckh_num(" t=", (now - t_act) / 1000);
                hp_n(caller, "  decoded in the second: ", o - out_mark);
                hp_n(caller, "  audio accepted in the second: ", acc - acc_mark);
                hp_n(caller, "  rx fps / kbit/s: ", cs_vh_stat(s[0..CS_LEN], CS_H_RX_FPS) * 100000 + cs_vh_stat(s[0..CS_LEN], CS_H_RX_KBPS));
                hp_n(caller, "  tx fps / wire kbit/s: ", cs_vh_stat(s[0..CS_LEN], CS_H_TX_FPS) * 100000 + cs_vh_stat(s[0..CS_LEN], CS_H_WIRE_KBPS));
                out_mark = o;
                acc_mark = acc;
                sec_mark = sec_mark + 1000;
            }
            if (caller and !hung and now - t_act >= secs * 1000) {
                hp_tag(caller);
                ckh_line("the person hangs up\n");
                cs_hangup(s[0..CS_LEN]);
                hung = true;
            }
        }
    }
    const v : []const u8 = s[0..CS_LEN];
    var sum : u64 = 0;
    var wmin : u64 = 1000000;
    var k : u64 = 0;
    while (k < nsec) {
        sum = sum + per[@as(usize, k)];
        if (k + 5 <= nsec) {
            var w5 : u64 = 0;
            var a5 : u64 = 0;
            var j : u64 = 0;
            while (j < 5) {
                w5 = w5 + per[@as(usize, k + j)];
                a5 = a5 + aper[@as(usize, k + j)];
                j = j + 1;
            }
            if (w5 < wmin) { wmin = w5; }
            if (a5 < acc_min) { acc_min = a5; }
        }
        k = k + 1;
    }
    var avg10 : u64 = 0;
    if (nsec > 0) { avg10 = sum * 10 / nsec; }
    hp_n(caller, "mode (1 = H.264): ", cs_vh_stat(v, CS_H_MODE));
    hp_n(caller, "frames made by the synthetic camera: ", made);
    hp_n(caller, "TX coded frames sent: ", cs_vh_stat(v, CS_H_TX_FRAMES));
    hp_n(caller, "TX key frames sent: ", cs_vh_stat(v, CS_H_TX_KEYS));
    hp_n(caller, "TX frames dropped as stale: ", cs_vh_stat(v, CS_H_STALE));
    hp_n(caller, "TX passes held by the bucket: ", cs_vh_stat(v, CS_H_HOLD));
    hp_n(caller, "TX ladder: rung / kbit/s: ", cs_vh_stat(v, CS_H_RUNG) * 100000 + cs_vh_stat(v, CS_H_KBPS));
    hp_n(caller, "TX reports received: ", cs_vh_stat(v, CS_H_REP_RX));
    hp_n(caller, "RX frames completed: ", cs_vh_stat(v, CS_H_RX_DONE));
    hp_n(caller, "RX key frames: ", cs_vh_stat(v, CS_H_RX_KEYS));
    hp_n(caller, "RX frames lost / dropped half built / held by the gate: ", cs_vh_stat(v, CS_H_RX_LOST) * 1000000 + cs_vh_stat(v, CS_H_RX_DROPPED) * 1000 + cs_vh_stat(v, CS_H_RX_HELD));
    hp_n(caller, "RX key frame requests sent: ", cs_vh_stat(v, CS_H_KREQ_TX));
    hp_n(caller, "RX picture: ", cs_vh_stat(v, CS_H_RX_W) * 10000 + cs_vh_stat(v, CS_H_RX_H));
    hp_n(caller, "decoder pictures out: ", vtd_stat(d, VDK_OUT));
    hp_n(caller, "decoder refusals: ", vtd_errors(d) + cs_vh_stat(v, CS_H_DEC_ERR));
    hp_n(caller, "decode latency max us: ", vtd_stat(d, VDK_LAT_MAX));
    hp_n(caller, "decode post max us (poll thread): ", vtd_stat(d, VDK_POST_MAX));
    hp_n(caller, "encode latency max us: ", vte_stat(e, VE_LAT_MAX));
    hp_n(caller, "encode call max us: ", vte_stat(e, VE_CALL_MAX));
    hp_n(caller, "pictures taken by the window side: ", taken);
    hp_n(caller, "seconds counted: ", nsec);
    hp_n(caller, "decoded pictures a second, mean x10: ", avg10);
    hp_n(caller, "decoded pictures in the slowest 5 s: ", wmin);
    hp_n(caller, "audio frames sent / accepted: ", cs_stat(s[0..CS_LEN], CS_ST_SENT) * 100000 + cs_stat(s[0..CS_LEN], CS_ST_ACCEPTED));
    hp_n(caller, "audio accepted in the slowest 5 s: ", acc_min);
    hp_n(caller, "refused: AEAD / replay: ", cs_stat(s[0..CS_LEN], CS_ST_REJ_AEAD) * 1000 + cs_stat(s[0..CS_LEN], CS_ST_REJ_REPLAY));
    hp_n(caller, "H.264 parts lost on the way (this side's test aid): ", cs_vh_stat(v, CS_H_LOST_TX));
    hp_n(caller, "JPEG frames shown / sent in the counted seconds: ", (jpeg1 - jpeg0) * 100000 + (jtx1 - jtx0));
    all = ckh_check("the call ended and the session is back in IDLE", ended) and all;
    if (old) {
        all = ckh_check("an older build: this side fell back to the JPEG (no word from it)", cs_vh_stat(v, CS_H_MODE) == @as(u64, VN_JPEG_OLD)) and all;
        all = ckh_check("its JPEG arrives, 8+ frames a second", nsec >= 5 and (jpeg1 - jpeg0) * 10 >= nsec * 80) and all;
        all = ckh_check("this side's JPEG leaves, 8+ frames a second", nsec >= 5 and (jtx1 - jtx0) * 10 >= nsec * 80) and all;
        all = ckh_check("no H.264 either way", cs_vh_stat(v, CS_H_RX_DONE) == 0 and cs_vh_stat(v, CS_H_TX_FRAMES) == 0) and all;
        all = ckh_check("the sound kept flowing (490+ of 500 frames accepted in every 5 counted seconds)", nsec >= 5 and acc_min >= 490) and all;
        all = ckh_check("0 AEAD failures, 0 replays", cs_stat(s[0..CS_LEN], CS_ST_REJ_AEAD) + cs_stat(s[0..CS_LEN], CS_ST_REJ_REPLAY) == 0) and all;
        if (last_pb != 0) { vt_pb_release(last_pb); }
        vtd_close(d);
        vte_close(e);
        cs_close(s[0..CS_LEN]);
        return all;
    }
    if (hloss != 0) {
        // the other side lost parts on their way here: the gate and the key frame requests must have brought it back
        all = ckh_check("both ends agreed on H.264", cs_vh_stat(v, CS_H_MODE) == @as(u64, VN_H264)) and all;
        all = ckh_check("losses seen, frames held back and key frames asked for", cs_vh_stat(v, CS_H_RX_LOST) + cs_vh_stat(v, CS_H_RX_DROPPED) > 0 and cs_vh_stat(v, CS_H_KREQ_TX) > 0) and all;
        all = ckh_check("it came back: at least 20 pictures a second on average", nsec >= 5 and avg10 >= 200) and all;
        all = ckh_check("no decoder refusal (a broken frame is never decoded)", vtd_errors(d) + cs_vh_stat(v, CS_H_DEC_ERR) == 0) and all;
        all = ckh_check("the sound kept flowing (490+ of 500 frames accepted in every 5 counted seconds)", nsec >= 5 and acc_min >= 490) and all;
        if (last_pb != 0) { vt_pb_release(last_pb); }
        vtd_close(d);
        vte_close(e);
        cs_close(s[0..CS_LEN]);
        return all;
    }
    all = ckh_check("both ends agreed on H.264", cs_vh_stat(v, CS_H_MODE) == @as(u64, VN_H264)) and all;
    all = ckh_check("at least 28 pictures a second on average", nsec >= 5 and avg10 >= 280) and all;
    all = ckh_check("at least 25 a second in the slowest 5 seconds", nsec >= 5 and wmin >= 125) and all;
    all = ckh_check("1280x720 pictures", cs_vh_stat(v, CS_H_RX_W) == HP_W and cs_vh_stat(v, CS_H_RX_H) == HP_H and wbad == 0) and all;
    // the start: the encoder's session takes up to a second to make, and the first key frame can go stale behind it;
    // the gate then holds the P-frames back until the requested key frame comes (at most a second of them)
    all = ckh_check("nothing lost, no decoder refusal, at most a second held back at the start", cs_vh_stat(v, CS_H_RX_LOST) + cs_vh_stat(v, CS_H_RX_DROPPED) + vtd_errors(d) == 0 and cs_vh_stat(v, CS_H_RX_HELD) <= 30) and all;
    // a second's count wobbles by a few frames with the moment it is read (94 then 106); five seconds do not
    all = ckh_check("the sound kept flowing (490+ of 500 frames accepted in every 5 counted seconds)", nsec >= 5 and acc_min >= 490) and all;
    all = ckh_check("0 AEAD failures, 0 replays", cs_stat(s[0..CS_LEN], CS_ST_REJ_AEAD) + cs_stat(s[0..CS_LEN], CS_ST_REJ_REPLAY) == 0) and all;
    if (v6) {
        hp_n(caller, "family (2 = v6) / datagrams too big for IPv6: ", cs_net(v, CS_NET_FAM) * 1000 + cs_net(v, CS_NET_BIG));
        all = ckh_check("over IPv6 (family v6), parts sent, none too big for IPv6 (big6 0)", cs_net(v, CS_NET_FAM) == @as(u64, IP6_F_V6) and cs_vh_stat(v, CS_H_PARTS_TX) > 0 and cs_net(v, CS_NET_BIG) == 0) and all;
    }
    if (last_pb != 0) { vt_pb_release(last_pb); }
    vtd_close(d);
    vte_close(e);
    cs_close(s[0..CS_LEN]);
    return all;
}

pub fn main() -> void {
    // Never true: makes sure the audio callbacks are emitted and so exported for dlsym.
    var z : [8]u8 = undefined;
    put_u64(z[0..8], 0, 0);
    if (get_u64(z[0..8], 0) == 99) {
        cbp_fin(0, 0, 0, 0, 0, 0);
        cbp_fout(0, 0, 0);
    }
    var rb : [32]u8 = undefined;
    const rn : usize = ckh_env("CS_ROLE", rb[0..32]);
    var ok : bool = false;
    if (rn == 6 and rb[0] == 99 and rb[5] == 114) {
        ok = hp_side(true);
    } else if (rn == 6 and rb[0] == 99 and rb[5] == 101) {
        ok = hp_side(false);
    } else {
        ckh_line("CS_ROLE must be caller or callee\n");
    }
    if (ok) {
        ckh_line("ALL CHECKS PASSED\n");
        sys_exit(0);
    }
    ckh_line("SOME CHECKS FAILED\n");
    sys_exit(1);
}
