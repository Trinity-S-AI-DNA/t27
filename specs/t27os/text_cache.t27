// SPDX-License-Identifier: Apache-2.0
; specs/t27os/text_cache.t27 -- which text line the T27 OS window may reuse, and how wide a sidebar label may run.
; Audit, 2026-10-19 (epic #10782, M11): every label was laid out from scratch on every drawn frame -- a font
; lookup, an attribute dictionary, an attributed string and a CoreText line, then thrown away. The window now
; keeps each laid-out line in a table keyed by its style and its text (the text compared by content, so a
; renamed space never shows a stale line) and lays it out again only on a miss. The table is emptied once it
; holds TC_CAP lines, which bounds it without a per-entry age. A label that would run past the edge of its
; column is cut by CoreText with an ellipsis to the width left; that width is part of the style, so the
; same text at two widths is two entries.

module T27osTextCache;

/// Lines the table may hold before it is emptied.
pub const TC_CAP : u64 = 512;
/// The narrowest room worth drawing a cut label into, in points; below it the label is left out.
pub const TC_MIN_ROOM : f64 = 18.0;
/// No cut: the style of a label that may run as wide as it likes.
pub const TC_FREE : f64 = 0.0;

/// A point value as quarter points, clamped to 16 bits.
pub fn tc_q(p: f64) -> u64 {
    if (p <= 0.0) { return 0; }
    if (p >= 16383.0) { return 65535; }
    return @as(u64, @intFromFloat(p * 4.0));
}

/// The style part of a line's key: size, weight, mono, and the cut width (TC_FREE for none).
/// Weight is an NSFontWeight in [-1, 1], shifted to [0, 2] first.
pub fn tc_style(size: f64, weight: f64, mono: bool, cut: f64) -> u64 {
    var m : u64 = 0;
    if (mono) { m = 1; }
    return (tc_q(size) << 33) | (tc_q(weight + 1.0) << 17) | (m << 16) | tc_q(cut);
}

/// Empty the table before adding to it?
pub fn tc_flush(count: u64) -> bool {
    return count >= TC_CAP;
}

/// The room a label starting at x has before `right`, or 0 when it is under TC_MIN_ROOM.
pub fn tc_room(x: f64, right: f64) -> f64 {
    const r : f64 = right - x;
    if (r < TC_MIN_ROOM) { return 0.0; }
    return r;
}

/// Cut a line `w` wide to `room`? Only when a cut width is set and the line overflows it.
pub fn tc_cut(w: f64, room: f64) -> bool {
    return room > 0.0 and w > room;
}

test styles_differ_in_every_part {
    const a : u64 = tc_style(11.5, 0.23, false, TC_FREE);
    assert a != tc_style(12.0, 0.23, false, TC_FREE);
    assert a != tc_style(11.5, 0.3, false, TC_FREE);
    assert a != tc_style(11.5, 0.23, true, TC_FREE);
    assert a != tc_style(11.5, 0.23, false, 200.0);
    assert a == tc_style(11.5, 0.23, false, TC_FREE);
    // a light weight (negative) and a heavy one stay apart
    assert tc_style(10.0, -0.4, false, TC_FREE) != tc_style(10.0, 0.4, false, TC_FREE);
}

test quarter_points_clamp {
    assert tc_q(-2.0) == 0;
    assert tc_q(1.0) == 4;
    assert tc_q(11.5) == 46;
    assert tc_q(99999.0) == 65535;
}

test the_table_empties_at_the_cap {
    assert tc_flush(0) == false;
    assert tc_flush(TC_CAP - 1) == false;
    assert tc_flush(TC_CAP);
}

test a_label_is_cut_only_when_it_overflows {
    assert tc_room(30.0, 232.0) == 202.0;
    assert tc_room(220.0, 232.0) == 0.0;
    assert tc_cut(250.0, 202.0);
    assert tc_cut(150.0, 202.0) == false;
    assert tc_cut(250.0, TC_FREE) == false;
}
