; Regression pin for #12664: a bare use of a name imported as `use mod::NAME`
; must splice from the module the import line names, even when the closure
; also holds a same-name declaration -- keysync's F_SLOT (: u32 = 1) beside
; session_store's F_SLOT (: usize = 2, reached keysync -> keys ->
; session_store). Before the fix the name was refused as ambiguous and the
; asserts died with `undeclared identifier`. The rule is R6 of
; specs/compiler/use_splice.t27 (`scoped_pick`).
module KeysyncScopeProbe;
use t27os::keysync::F_SLOT;
use t27os::keysync::F_COUNT;
test keysync_fields_win_over_closure_namesakes {
    assert F_SLOT == 1;
    assert F_COUNT == 14;
}
