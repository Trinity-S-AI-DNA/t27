// specs/t27os/hardware_tab.t27 -- Hardware tab separation from BENCH.
// Part of M10 milestone (milestone #14). Closes #13192.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::hardware_tab;

pub const HARDWARE_TAB_MAX_DEVICES : u32 = 16;

pub struct HardwareDevice { id: str, separated: bool };

pub fn hardware_device_separated(d: HardwareDevice) -> bool {
    return d.separated;
}

test "hardware_device_separated" {
    assert(hardware_device_separated(HardwareDevice { id: "ax7203", separated: true }));
    assert(!hardware_device_separated(HardwareDevice { id: "bench", separated: false }));
}

invariant hardware_tab_max_devices_positive {
    assert HARDWARE_TAB_MAX_DEVICES > 0;
}