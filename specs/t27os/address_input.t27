// specs/t27os/address_input.t27 -- t27os: add address input - browser pane.
// Part of M1 (milestone #5). Closes #14038.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::address_input;

pub const ADDRESS_MAX_LEN : u32 = 2048;

pub struct AddressInput { value: str, focused: bool };

pub fn address_input_focused(a: AddressInput) -> bool {
    return a.focused;
}

pub fn address_input_value(a: AddressInput) -> str {
    return a.value;
}

test "address input focused" {
    assert(address_input_focused(AddressInput { value: "https://t27.ai", focused: true }));
    assert(!address_input_focused(AddressInput { value: "https://t27.ai", focused: false }));
}

invariant address_max_len_positive {
    assert ADDRESS_MAX_LEN > 0;
}