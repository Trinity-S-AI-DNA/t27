// SPDX-License-Identifier: Apache-2.0
; Refs #13251
; specs/t27os/win_layout.t27 -- the window's regions, computed once from the window size, so the
; drawing code and the hit tests read the same rectangles instead of each recomputing them.
; Owner order START_T27OS_UI_KIT_NOW, 2026-11-08 (LAYOUT_AND_DUAL_GLASS_V2, ring 1): sidebar, toolbar,
; content and inspector are computed from the window size; the inspector reserves its width, so
; nothing of the content lies under it; drawing and hit testing consume one geometry.
; This is the minimal composition layer over what exists: it reuses t27os::layout (row helpers),
; t27os::queen::QP_W (the right-hand panel width) and the window constants that glass_window.t27
; used to keep by hand (HEADER_H 44, WS_TOP 35, TOGGLE_PT 28, BAR_H 26). When the window is wired
; to this module those constants are deleted there and imported from here; SIDE_W 272 was already
; t27os::dash's, so both read that one.
; Units are window points (f64), not the course HUD's i32 px of t27f::vf_uikit.
; A rect owns its left and top edges but not its right and bottom ones (half-open), so a point on a
; shared edge belongs to exactly one region.
; A screen page (the agent map) splits its content rect with page_split: the scene on the left,
; the page inspector on the right; a page too narrow for both stacks the inspector under the scene.
; Never laid over the scene.

module T27osWinLayout;

use t27os::queen::QP_W;
// the sidebar width (272) has one home, the dashboard's letter sidebar; it is read, not restated
use t27os::dash::SIDE_W;
// the row helpers the toolbar buttons are placed with (glass_window.t27 imports the same two)
use t27os::layout::row_next;
use t27os::layout::centre_top;

/// The title bar plus its 1 pt divider: the workspace starts here.
pub const WS_TOP : f64 = 35.0;
/// The divider between the sidebar and the content.
pub const DIVIDER_W : f64 = 1.0;
/// The toolbar (header) height in the expanded workspace.
pub const HEADER_H : f64 = 44.0;
/// The "OPEN DASHBOARD" bar height in the compact workspace.
pub const BAR_H : f64 = 26.0;
/// The sidebar toggle button, square, and its inset from the toolbar's left edge.
pub const TOGGLE_PT : f64 = 28.0;
pub const TOOL_INSET : f64 = 14.0;
/// The gap between neighbouring toolbar buttons.
pub const TOOL_GAP : f64 = 12.0;
/// The sidebar rows sit this far inside the sidebar on both sides.
pub const SIDE_ROW_INSET : f64 = 12.0;
/// A page inspector column, and the narrowest scene that keeps it beside the scene.
pub const PAGE_INSP_W : f64 = 300.0;
pub const SCENE_MIN_W : f64 = 420.0;
/// The share of a stacked page the inspector may take, and its cap.
pub const STACK_SHARE : f64 = 0.4;
pub const STACK_MAX_H : f64 = 220.0;

/// Workspaces: the same values as glass_window.t27 WS_EXPANDED, WS_COMPACT, WS_DASHBOARD.
pub const WS_EXPANDED : u32 = 0;
pub const WS_COMPACT : u32 = 1;
pub const WS_DASHBOARD : u32 = 2;

/// Region ids returned by region_at.
pub const R_NONE : u32 = 0;
pub const R_TITLE : u32 = 1;
pub const R_SIDEBAR : u32 = 2;
pub const R_TOOLBAR : u32 = 3;
pub const R_CONTENT : u32 = 4;
pub const R_INSPECTOR : u32 = 5;
/// Region ids added by win_regions_v2.
pub const R_BOTTOM_PANEL : u32 = 6;
pub const R_STATUS_BAR : u32 = 7;
pub const R_LEFT_SPL : u32 = 8;
pub const R_RIGHT_SPL : u32 = 9;
pub const R_BOTTOM_SPL : u32 = 10;

/// Minimum content area height: the bottom panel shrinks before the content does.
pub const CENTER_MIN_H : f64 = 120.0;
/// Default status bar height.
pub const STATUS_BAR_H : f64 = 24.0;
/// Minimum hit-target width / height for a splitter drag handle.
pub const SPLITTER_HIT : f64 = 8.0;

pub struct WinRect {
    pub x : f64,
    pub y : f64,
    pub w : f64,
    pub h : f64,
}

pub struct WinRegions {
    pub title : WinRect,
    pub sidebar : WinRect,
    pub toolbar : WinRect,
    pub content : WinRect,
    pub inspector : WinRect,
    pub bottom_panel : WinRect,
    pub status_bar : WinRect,
}

pub struct SplitterRects {
    pub left_spl : WinRect,
    pub right_spl : WinRect,
    pub bottom_spl : WinRect,
}

pub struct PageSplit {
    pub scene : WinRect,
    pub inspector : WinRect,
    pub stacked : bool,
}

fn nonneg(v: f64) -> f64 {
    if (v < 0.0) { return 0.0; }
    return v;
}

pub fn win_rect(x: f64, y: f64, w: f64, h: f64) -> WinRect {
    return WinRect { x: x, y: y, w: nonneg(w), h: nonneg(h) };
}

pub fn rect_right(r: WinRect) -> f64 {
    return r.x + r.w;
}

pub fn rect_bottom(r: WinRect) -> f64 {
    return r.y + r.h;
}

/// Half-open containment: left and top edges in, right and bottom edges out; an empty rect holds nothing.
pub fn rect_has(r: WinRect, x: f64, y: f64) -> bool {
    return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h;
}

/// True when two rects share any area.
pub fn rect_overlap(a: WinRect, b: WinRect) -> bool {
    if (a.w <= 0.0 or a.h <= 0.0 or b.w <= 0.0 or b.h <= 0.0) { return false; }
    return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h;
}

/// r with dx taken off both sides and dy off top and bottom.
pub fn rect_inset(r: WinRect, dx: f64, dy: f64) -> WinRect {
    return win_rect(r.x + dx, r.y + dy, r.w - 2.0 * dx, r.h - 2.0 * dy);
}

/// The sidebar width: SIDE_W only when expanded and not collapsed (the forced dashboard keeps a zero-width one).
pub fn side_w(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_EXPANDED and collapsed == false) { return SIDE_W; }
    return 0.0;
}

/// Left edge of the content: right of the sidebar and its divider, 0 when compact or collapsed.
pub fn content_x(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_COMPACT or collapsed) { return 0.0; }
    return side_w(ws, collapsed) + DIVIDER_W;
}

/// The inspector width: the right-hand panel (Queen, DOCTOR, KEYS) while one is open, else 0.
pub fn insp_w(panel: bool) -> f64 {
    if (panel) { return QP_W; }
    return 0.0;
}

/// Right edge of the content: the window edge, or the inspector's left edge while it is open.
pub fn content_right(sw: f64, panel: bool) -> f64 {
    return sw - insp_w(panel);
}

/// Every region of a sw x sh window. The toolbar is the header (expanded, dashboard) or the
/// OPEN DASHBOARD bar (compact); the content starts under it.
pub fn win_regions(sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> WinRegions {
    const cx : f64 = content_x(ws, collapsed);
    const cr : f64 = content_right(sw, panel);
    var th : f64 = HEADER_H;
    var tx : f64 = cx;
    var tw : f64 = cr - cx;
    if (ws == WS_COMPACT) {
        th = BAR_H;
        tx = 0.0;
        tw = sw;
    }
    const body_h : f64 = sh - WS_TOP;
    return WinRegions {
        title: win_rect(0.0, 0.0, sw, WS_TOP),
        sidebar: win_rect(0.0, WS_TOP, side_w(ws, collapsed), body_h),
        toolbar: win_rect(tx, WS_TOP, tw, th),
        content: win_rect(cx, WS_TOP + th, cr - cx, body_h - th),
        inspector: win_rect(cr, WS_TOP, insp_w(panel), body_h),
        bottom_panel: win_rect(0.0, 0.0, 0.0, 0.0),
        status_bar: win_rect(0.0, 0.0, 0.0, 0.0),
    };
}

/// Every region of a sw x sh window, v2 — adds bottom_panel and status_bar on top of win_regions.
/// bottom_h and sbh are requested heights; they are clamped so content.h >= CENTER_MIN_H.
/// Old win_regions and WinRegions are unchanged (FR-008).
pub fn win_regions_v2(sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool, bottom_h: f64, sbh: f64) -> WinRegions {
    const cx : f64 = content_x(ws, collapsed);
    const cr : f64 = content_right(sw, panel);
    var th : f64 = HEADER_H;
    var tx : f64 = cx;
    var tw : f64 = cr - cx;
    if (ws == WS_COMPACT) {
        th = BAR_H;
        tx = 0.0;
        tw = sw;
    }
    const body_h2 : f64 = sh - WS_TOP;
    var actual_sbh : f64 = nonneg(sbh);
    var avail : f64 = body_h2 - th - actual_sbh;
    if (avail < CENTER_MIN_H) {
        actual_sbh = nonneg(body_h2 - th - CENTER_MIN_H);
        avail = body_h2 - th - actual_sbh;
    }
    var actual_bh : f64 = nonneg(bottom_h);
    if (actual_bh > avail - CENTER_MIN_H) {
        actual_bh = nonneg(avail - CENTER_MIN_H);
    }
    const content_h2 : f64 = nonneg(avail - actual_bh);
    return WinRegions {
        title: win_rect(0.0, 0.0, sw, WS_TOP),
        sidebar: win_rect(0.0, WS_TOP, side_w(ws, collapsed), body_h2),
        toolbar: win_rect(tx, WS_TOP, tw, th),
        content: win_rect(cx, WS_TOP + th, cr - cx, content_h2),
        inspector: win_rect(cr, WS_TOP, insp_w(panel), body_h2),
        bottom_panel: win_rect(cx, WS_TOP + th + content_h2, cr - cx, actual_bh),
        status_bar: win_rect(0.0, sh - actual_sbh, sw, actual_sbh),
    };
}

/// Splitter drag handles derived from a WinRegions: each rect is centred on the shared border.
pub fn splitter_rects(g: WinRegions) -> SplitterRects {
    return SplitterRects {
        left_spl: win_rect(g.sidebar.x + g.sidebar.w - SPLITTER_HIT / 2.0, g.sidebar.y, SPLITTER_HIT, g.sidebar.h),
        right_spl: win_rect(g.inspector.x - SPLITTER_HIT / 2.0, g.inspector.y, SPLITTER_HIT, g.inspector.h),
        bottom_spl: win_rect(g.bottom_panel.x, g.bottom_panel.y - SPLITTER_HIT / 2.0, g.bottom_panel.w, SPLITTER_HIT),
    };
}

/// Hit test for the v2 layout: splitters are checked before panels so the drag handle wins.
pub fn region_at_v2(g: WinRegions, s: SplitterRects, x: f64, y: f64) -> u32 {
    if (rect_has(s.left_spl, x, y)) { return R_LEFT_SPL; }
    if (rect_has(s.right_spl, x, y)) { return R_RIGHT_SPL; }
    if (rect_has(s.bottom_spl, x, y)) { return R_BOTTOM_SPL; }
    if (rect_has(g.bottom_panel, x, y)) { return R_BOTTOM_PANEL; }
    if (rect_has(g.status_bar, x, y)) { return R_STATUS_BAR; }
    return region_at(g, x, y);
}

/// The one hit test: which region owns the point. Order matters only on the toolbar, which the
/// compact bar stretches over the full width while the inspector is open.
pub fn region_at(g: WinRegions, x: f64, y: f64) -> u32 {
    if (rect_has(g.title, x, y)) { return R_TITLE; }
    if (rect_has(g.toolbar, x, y)) { return R_TOOLBAR; }
    if (rect_has(g.inspector, x, y)) { return R_INSPECTOR; }
    if (rect_has(g.sidebar, x, y)) { return R_SIDEBAR; }
    if (rect_has(g.content, x, y)) { return R_CONTENT; }
    return R_NONE;
}

/// The sidebar rows: the sidebar inset by SIDE_ROW_INSET on both sides.
pub fn side_rows(g: WinRegions) -> WinRect {
    return rect_inset(g.sidebar, SIDE_ROW_INSET, 0.0);
}

/// The k-th 28 pt toolbar button from the left (0 the sidebar toggle, 1 Close Dashboard), centred on the
/// header's height: the one rect both the draw and the hit test read.
pub fn tool_btn(ws: u32, collapsed: bool, k: u32) -> WinRect {
    var x0 : f64 = content_x(ws, collapsed) + TOOL_INSET;
    var i : u32 = 0;
    while (i < k) {
        x0 = row_next(x0, TOGGLE_PT, TOOL_GAP);
        i = i + 1;
    }
    return win_rect(x0, centre_top(WS_TOP + 0.5 * HEADER_H, TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// The "+" (new chat) button at the right end of the header, the same 28 pt box.
pub fn new_btn(sw: f64) -> WinRect {
    return win_rect(sw - TOOL_INSET - TOGGLE_PT, centre_top(WS_TOP + 0.5 * HEADER_H, TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// A page's scene and inspector inside r: side by side while the scene keeps SCENE_MIN_W, else the
/// inspector stacked under the scene. With show false the scene takes all of r.
pub fn page_split(r: WinRect, show: bool) -> PageSplit {
    if (show == false) {
        return PageSplit { scene: r, inspector: win_rect(rect_right(r), r.y, 0.0, 0.0), stacked: false };
    }
    if (r.w - PAGE_INSP_W >= SCENE_MIN_W) {
        const sw : f64 = r.w - PAGE_INSP_W;
        return PageSplit { scene: win_rect(r.x, r.y, sw, r.h), inspector: win_rect(r.x + sw, r.y, PAGE_INSP_W, r.h), stacked: false };
    }
    var ih : f64 = STACK_SHARE * r.h;
    if (ih > STACK_MAX_H) { ih = STACK_MAX_H; }
    const sh : f64 = r.h - ih;
    return PageSplit { scene: win_rect(r.x, r.y, r.w, sh), inspector: win_rect(r.x, r.y + sh, r.w, ih), stacked: true };
}

test expanded_window_regions {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, false);
    assert g.title.h == 35.0 and g.title.w == 960.0;
    assert g.sidebar.x == 0.0 and g.sidebar.w == 272.0 and g.sidebar.h == 505.0;
    assert g.toolbar.x == 273.0 and g.toolbar.w == 687.0 and g.toolbar.h == 44.0;
    assert g.content.x == 273.0 and g.content.y == 79.0 and g.content.w == 687.0 and g.content.h == 461.0;
    assert g.inspector.w == 0.0;
}

test inspector_reserves_its_width {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    assert g.inspector.x == 660.0 and g.inspector.w == 300.0;
    assert rect_right(g.content) == g.inspector.x;
    assert rect_right(g.toolbar) == g.inspector.x;
    assert rect_overlap(g.content, g.inspector) == false;
    assert rect_overlap(g.toolbar, g.inspector) == false;
    assert rect_overlap(g.sidebar, g.content) == false;
}

test collapsed_and_compact {
    const c : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, true, false);
    assert c.sidebar.w == 0.0 and c.content.x == 0.0 and c.content.w == 960.0;
    const k : WinRegions = win_regions(700.0, 540.0, WS_COMPACT, false, false);
    assert k.sidebar.w == 0.0 and k.toolbar.h == BAR_H and k.toolbar.w == 700.0;
    assert k.content.y == WS_TOP + BAR_H;
    const d : WinRegions = win_regions(700.0, 540.0, WS_DASHBOARD, false, false);
    assert d.sidebar.w == 0.0 and d.content.x == DIVIDER_W;
}

test same_values_as_the_hand_fns {
    // glass_window.t27 side_w, content_x, content_right, content_w before the wiring
    assert side_w(WS_EXPANDED, false) == 272.0 and side_w(WS_DASHBOARD, false) == 0.0;
    assert content_x(WS_EXPANDED, false) == 273.0 and content_x(WS_COMPACT, false) == 0.0;
    assert content_right(1200.0, true) == 900.0 and content_right(1200.0, false) == 1200.0;
    const g : WinRegions = win_regions(1200.0, 800.0, WS_EXPANDED, false, true);
    assert g.content.w == 900.0 - 273.0;
    // in_side: rows from x 12 to SIDE_W - 12
    const rows : WinRect = side_rows(g);
    assert rows.x == 12.0 and rect_right(rows) == SIDE_W - 12.0;
}

test every_point_has_one_owner {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    var i : u32 = 0;
    var owned : u32 = 0;
    while (i < 12) {
        var j : u32 = 0;
        while (j < 8) {
            const x : f64 = 80.0 * @as(f64, @floatFromInt(i));
            const y : f64 = 67.5 * @as(f64, @floatFromInt(j));
            var n : u32 = 0;
            if (rect_has(g.title, x, y)) { n = n + 1; }
            if (rect_has(g.sidebar, x, y)) { n = n + 1; }
            if (rect_has(g.toolbar, x, y)) { n = n + 1; }
            if (rect_has(g.content, x, y)) { n = n + 1; }
            if (rect_has(g.inspector, x, y)) { n = n + 1; }
            // x 272 is the divider column, owned by nobody; every other point has exactly one owner
            assert n <= 1;
            if (n == 1) { owned = owned + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert owned == 96;
}

test shared_edges_have_one_owner {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    // the content/inspector edge belongs to the inspector, the title/workspace edge to the workspace
    assert region_at(g, 660.0, 300.0) == R_INSPECTOR;
    assert region_at(g, 659.5, 300.0) == R_CONTENT;
    assert region_at(g, 400.0, 35.0) == R_TOOLBAR;
    assert region_at(g, 400.0, 34.9) == R_TITLE;
    assert region_at(g, 100.0, 300.0) == R_SIDEBAR;
    assert region_at(g, 272.5, 300.0) == R_NONE;
}

test toggle_is_drawn_where_it_is_hit {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, false);
    const t : WinRect = tool_btn(WS_EXPANDED, false, 0);
    // glass_window.t27 on_side_toggle: content_x + 14, WS_TOP + (HEADER_H - TOGGLE_PT) / 2
    assert t.x == 287.0 and t.y == 43.0 and t.w == 28.0;
    assert region_at(g, t.x + 0.5 * t.w, t.y + 0.5 * t.h) == R_TOOLBAR;
    assert rect_has(g.toolbar, t.x, t.y) and rect_has(g.toolbar, rect_right(t) - 0.5, rect_bottom(t) - 0.5);
    // close_x: content_x + 14 + TOGGLE_PT + 12; the "+" box: sw - 14 - TOGGLE_PT
    assert tool_btn(WS_DASHBOARD, false, 1).x == 1.0 + 14.0 + 28.0 + 12.0;
    assert tool_btn(WS_EXPANDED, false, 1).x == 327.0;
    // each further button is one t27os::layout::row_next step: 327 + 28 + 12
    assert tool_btn(WS_EXPANDED, false, 2).x == 367.0 and tool_btn(WS_EXPANDED, false, 2).y == 43.0;
    assert new_btn(960.0).x == 918.0 and new_btn(960.0).y == t.y;
    assert rect_overlap(tool_btn(WS_EXPANDED, false, 0), tool_btn(WS_EXPANDED, false, 1)) == false;
    const d : WinRegions = win_regions(960.0, 540.0, WS_DASHBOARD, false, false);
    const c : WinRect = tool_btn(WS_DASHBOARD, false, 1);
    assert region_at(d, c.x + 0.5 * c.w, c.y + 0.5 * c.h) == R_TOOLBAR;
}

test page_inspector_beside_or_under_never_over {
    const g : WinRegions = win_regions(1440.0, 900.0, WS_EXPANDED, false, false);
    const p : PageSplit = page_split(g.content, true);
    assert p.stacked == false;
    assert p.scene.w + p.inspector.w == g.content.w;
    assert rect_overlap(p.scene, p.inspector) == false;
    assert rect_right(p.inspector) == rect_right(g.content);
    const n : WinRegions = win_regions(700.0, 540.0, WS_COMPACT, false, false);
    const q : PageSplit = page_split(n.content, true);
    assert q.stacked == true;
    assert rect_overlap(q.scene, q.inspector) == false;
    assert @abs(q.scene.h + q.inspector.h - n.content.h) < 0.000001;
    assert q.inspector.h <= STACK_MAX_H;
    const h : PageSplit = page_split(g.content, false);
    assert h.scene.w == g.content.w and h.inspector.w == 0.0;
}

test negative_control_catches_an_overlay {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    // the old defect: content laid out to the window edge while the panel is open
    const bad : WinRect = win_rect(g.content.x, g.content.y, 960.0 - g.content.x, g.content.h);
    assert rect_overlap(bad, g.inspector) == true;
    assert rect_overlap(g.content, g.inspector) == false;
}

test negative_control_refutes_closed_edges {
    // closed containment (the old in_box) gives a shared edge two owners; half-open gives one
    const a : WinRect = win_rect(0.0, 0.0, 10.0, 10.0);
    const b : WinRect = win_rect(10.0, 0.0, 10.0, 10.0);
    assert rect_has(a, 10.0, 5.0) == false and rect_has(b, 10.0, 5.0) == true;
    assert rect_overlap(a, b) == false;
}

test win_regions_v2_basic {
    const g : WinRegions = win_regions_v2(1280.0, 800.0, WS_EXPANDED, false, false, 200.0, STATUS_BAR_H);
    assert g.bottom_panel.h == 200.0;
    assert g.status_bar.h == STATUS_BAR_H;
    const total : f64 = g.toolbar.h + g.content.h + g.bottom_panel.h + g.status_bar.h;
    assert @abs(total - (800.0 - WS_TOP)) < 0.000001;
}

test win_regions_v2_constrained {
    const g : WinRegions = win_regions_v2(1280.0, 200.0, WS_EXPANDED, false, false, 300.0, 24.0);
    assert g.content.h >= 0.0;
    assert g.bottom_panel.h >= 0.0;
    assert g.status_bar.h >= 0.0;
}

test win_regions_v2_no_overlap_8_combos {
    var combo : u32 = 0;
    while (combo < 8) {
        const left_on : bool = (combo & 1) != 0;
        const right_on : bool = (combo & 2) != 0;
        const bot_on : bool = (combo & 4) != 0;
        const bh : f64 = if (bot_on) { 150.0 } else { 0.0 };
        const g : WinRegions = win_regions_v2(1280.0, 800.0, WS_EXPANDED, left_on, right_on, bh, STATUS_BAR_H);
        assert g.content.w >= 0.0 and g.content.h >= 0.0;
        assert g.bottom_panel.w >= 0.0 and g.bottom_panel.h >= 0.0;
        assert g.status_bar.w >= 0.0 and g.status_bar.h >= 0.0;
        assert rect_overlap(g.content, g.bottom_panel) == false;
        assert rect_overlap(g.content, g.status_bar) == false;
        assert rect_overlap(g.bottom_panel, g.status_bar) == false;
        assert rect_overlap(g.content, g.inspector) == false;
        assert rect_overlap(g.bottom_panel, g.inspector) == false;
        combo = combo + 1;
    }
}

test splitter_rects_width {
    const g : WinRegions = win_regions_v2(1280.0, 800.0, WS_EXPANDED, false, false, 150.0, STATUS_BAR_H);
    const s : SplitterRects = splitter_rects(g);
    assert s.left_spl.w == SPLITTER_HIT;
    assert s.bottom_spl.h == SPLITTER_HIT;
}

// Shell layout state model for resizable panels, overlay, and Zen mode
// Refs #14047

pub const SHELL_SIDE_MIN : f64 = 180.0;
pub const SHELL_SIDE_MAX : f64 = 520.0;
pub const SHELL_SIDE_DEFAULT : f64 = 280.0;
pub const SHELL_BOTTOM_MIN : f64 = 120.0;
pub const SHELL_BOTTOM_DEFAULT : f64 = 220.0;
pub const CENTER_MIN_W : f64 = 360.0;
pub const SHELL_KEY_STEP : f64 = 16.0;

pub const SHELL_SPL_LEFT : u32 = 0;
pub const SHELL_SPL_RIGHT : u32 = 1;
pub const SHELL_SPL_BOTTOM : u32 = 2;

pub const SHELL_KEY_DEC : u32 = 0;
pub const SHELL_KEY_INC : u32 = 1;
pub const SHELL_KEY_ENTER : u32 = 2;

pub struct ShellLayout {
    pub left_w : f64,
    pub right_w : f64,
    pub bottom_h : f64,
    pub left_open : bool,
    pub right_open : bool,
    pub bottom_open : bool,
    pub zen : bool,
    pub saved_left : bool,
    pub saved_right : bool,
    pub saved_bottom : bool,
}

pub struct ShellRects {
    pub left : WinRect,
    pub center : WinRect,
    pub right : WinRect,
    pub bottom : WinRect,
    pub left_overlay : bool,
    pub right_overlay : bool,
}

pub fn shell_default() -> ShellLayout {
    return ShellLayout {
        left_w: SHELL_SIDE_DEFAULT,
        right_w: SHELL_SIDE_DEFAULT,
        bottom_h: SHELL_BOTTOM_DEFAULT,
        left_open: true,
        right_open: true,
        bottom_open: false,
        zen: false,
        saved_left: false,
        saved_right: false,
        saved_bottom: false,
    };
}

pub fn shell_clamp(s: ShellLayout, sw: f64, sh: f64) -> ShellLayout {
    var left_clamped : f64 = s.left_w;
    if (left_clamped < SHELL_SIDE_MIN) { left_clamped = SHELL_SIDE_MIN; }
    if (left_clamped > SHELL_SIDE_MAX) { left_clamped = SHELL_SIDE_MAX; }

    var right_clamped : f64 = s.right_w;
    if (right_clamped < SHELL_SIDE_MIN) { right_clamped = SHELL_SIDE_MIN; }
    if (right_clamped > SHELL_SIDE_MAX) { right_clamped = SHELL_SIDE_MAX; }

    var bottom_clamped : f64 = s.bottom_h;
    if (bottom_clamped < SHELL_BOTTOM_MIN) { bottom_clamped = SHELL_BOTTOM_MIN; }

    var center_max_h : f64 = sh - WS_TOP - CENTER_MIN_H;
    if (center_max_h < SHELL_BOTTOM_MIN) { center_max_h = SHELL_BOTTOM_MIN; }
    if (bottom_clamped > center_max_h) { bottom_clamped = center_max_h; }

    if (s.left_open and s.right_open) {
        const total_side : f64 = left_clamped + right_clamped;
        const available : f64 = sw - CENTER_MIN_W;
        if (total_side > available) {
            const excess : f64 = total_side - available;
            if (left_clamped >= right_clamped) {
                left_clamped = left_clamped - excess;
                if (left_clamped < SHELL_SIDE_MIN) { left_clamped = SHELL_SIDE_MIN; }
            } else {
                right_clamped = right_clamped - excess;
                if (right_clamped < SHELL_SIDE_MIN) { right_clamped = SHELL_SIDE_MIN; }
            }
        }
    }

    return ShellLayout {
        left_w: left_clamped,
        right_w: right_clamped,
        bottom_h: bottom_clamped,
        left_open: s.left_open,
        right_open: s.right_open,
        bottom_open: s.bottom_open,
        zen: s.zen,
        saved_left: s.saved_left,
        saved_right: s.saved_right,
        saved_bottom: s.saved_bottom,
    };
}

pub fn shell_overlay(s: ShellLayout, sw: f64) -> bool {
    const total_side : f64 = if (s.left_open) { s.left_w } else { 0.0 } + if (s.right_open) { s.right_w } else { 0.0 };
    return total_side + CENTER_MIN_W > sw;
}

pub fn shell_rects(s: ShellLayout, sw: f64, sh: f64) -> ShellRects {
    const body_y : f64 = WS_TOP;
    const body_h : f64 = sh - body_y;
    const is_overlay : bool = shell_overlay(s, sw);

    var left : WinRect = win_rect(0.0, 0.0, 0.0, 0.0);
    var right : WinRect = win_rect(0.0, 0.0, 0.0, 0.0);
    var center : WinRect = win_rect(0.0, 0.0, 0.0, 0.0);
    var bottom : WinRect = win_rect(0.0, 0.0, 0.0, 0.0);

    if (s.zen) {
        center = win_rect(0.0, body_y, sw, body_h);
    } else {
        if (s.left_open) {
            const left_w : f64 = s.left_w;
            if (is_overlay) {
                left = win_rect(0.0, body_y, left_w, body_h);
                center = win_rect(0.0, body_y, sw, body_h);
            } else {
                left = win_rect(0.0, body_y, left_w, body_h);
                center = win_rect(left_w, body_y, sw - left_w, body_h);
            }
        } else {
            center = win_rect(0.0, body_y, sw, body_h);
        }

        if (s.right_open) {
            const right_w : f64 = s.right_w;
            if (is_overlay) {
                right = win_rect(sw - right_w, body_y, right_w, body_h);
                center = win_rect(0.0, body_y, sw, body_h);
            } else {
                right = win_rect(sw - right_w, body_y, right_w, body_h);
                center = win_rect(0.0, body_y, sw - right_w, body_h);
            }
        }

        if (s.bottom_open) {
            const bottom_h : f64 = s.bottom_h;
            bottom = win_rect(center.x, center.y + center.h - bottom_h, center.w, bottom_h);
            center = win_rect(center.x, center.y, center.w, center.h - bottom_h);
        }
    }

    return ShellRects {
        left: left,
        center: center,
        right: right,
        bottom: bottom,
        left_overlay: is_overlay and s.left_open,
        right_overlay: is_overlay and s.right_open,
    };
}

pub fn shell_drag(s: ShellLayout, spl: u32, delta: f64, sw: f64, sh: f64) -> ShellLayout {
    var result : ShellLayout = s;

    if (spl == SHELL_SPL_LEFT) {
        result.left_w = s.left_w + delta;
    } else if (spl == SHELL_SPL_RIGHT) {
        result.right_w = s.right_w - delta;
    } else if (spl == SHELL_SPL_BOTTOM) {
        result.bottom_h = s.bottom_h - delta;
    }

    return shell_clamp(result, sw, sh);
}

pub fn shell_key(s: ShellLayout, spl: u32, key: u32, sw: f64, sh: f64) -> ShellLayout {
    var result : ShellLayout = s;

    if (key == SHELL_KEY_DEC or key == SHELL_KEY_INC) {
        const step : f64 = if (key == SHELL_KEY_DEC) { -SHELL_KEY_STEP } else { SHELL_KEY_STEP };

        if (spl == SHELL_SPL_LEFT) {
            result.left_w = s.left_w + step;
        } else if (spl == SHELL_SPL_RIGHT) {
            result.right_w = s.right_w + step;
        } else if (spl == SHELL_SPL_BOTTOM) {
            result.bottom_h = s.bottom_h + step;
        }

        result = shell_clamp(result, sw, sh);
    } else if (key == SHELL_KEY_ENTER) {
        if (spl == SHELL_SPL_LEFT) {
            result.left_open = not s.left_open;
        } else if (spl == SHELL_SPL_RIGHT) {
            result.right_open = not s.right_open;
        } else if (spl == SHELL_SPL_BOTTOM) {
            result.bottom_open = not s.bottom_open;
        }
    }

    return result;
}

pub fn shell_zen(s: ShellLayout) -> ShellLayout {
    if (s.zen) {
        return ShellLayout {
            left_w: s.left_w,
            right_w: s.right_w,
            bottom_h: s.bottom_h,
            left_open: s.saved_left,
            right_open: s.saved_right,
            bottom_open: s.saved_bottom,
            zen: false,
            saved_left: false,
            saved_right: false,
            saved_bottom: false,
        };
    } else {
        return ShellLayout {
            left_w: s.left_w,
            right_w: s.right_w,
            bottom_h: s.bottom_h,
            left_open: false,
            right_open: false,
            bottom_open: false,
            zen: true,
            saved_left: s.left_open,
            saved_right: s.right_open,
            saved_bottom: s.bottom_open,
        };
    };
}

fn shell_dec_digits(v: u32) -> usize {
    if (v < 10) { return 1; }
    if (v < 100) { return 2; }
    if (v < 1000) { return 3; }
    if (v < 10000) { return 4; }
    if (v < 100000) { return 5; }
    return 6;
}

fn shell_dec_char(v: u32, i: usize) -> u32 {
    var place : u32 = 1;
    var p : usize = 0;
    while (p < i) {
        place = place * 10;
        p = p + 1;
    }

    const digit : u32 = (v / place) % 10;
    return @as(u32, @intFromFloat(@as(f64, @floatFromInt(digit))));
}

pub fn shell_encode_len(s: ShellLayout) -> usize {
    return 14; // "L" + 5 digits + "R" + 5 digits + "B" + 5 digits + "F" + 1 digit
}

pub fn shell_encode_char(s: ShellLayout, i: usize) -> u32 {
    const left : u32 = @as(u32, @intFromFloat(@floor(s.left_w)));
    const right : u32 = @as(u32, @intFromFloat(@floor(s.right_w)));
    const bottom : u32 = @as(u32, @intFromFloat(@floor(s.bottom_h)));
    const flags : u32 = if (s.left_open) { 1 } else { 0 } + if (s.right_open) { 2 } else { 0 } + if (s.bottom_open) { 4 } else { 0 };

    if (i == 0) { return @as(u32, @intFromFloat('L')); }
    if (i == 1) { return shell_dec_char(left, 0); }
    if (i == 2) { return shell_dec_char(left, 1); }
    if (i == 3) { return shell_dec_char(left, 2); }
    if (i == 4) { return shell_dec_char(left, 3); }
    if (i == 5) { return shell_dec_char(left, 4); }
    if (i == 6) { return @as(u32, @intFromFloat('R')); }
    if (i == 7) { return shell_dec_char(right, 0); }
    if (i == 8) { return shell_dec_char(right, 1); }
    if (i == 9) { return shell_dec_char(right, 2); }
    if (i == 10) { return shell_dec_char(right, 3); }
    if (i == 11) { return shell_dec_char(right, 4); }
    if (i == 12) { return @as(u32, @intFromFloat('B')); }
    if (i == 13) { return shell_dec_char(bottom, 0); }
    if (i == 14) { return shell_dec_char(bottom, 1); }
    if (i == 15) { return shell_dec_char(bottom, 2); }
    if (i == 16) { return shell_dec_char(bottom, 3); }
    if (i == 17) { return shell_dec_char(bottom, 4); }
    if (i == 18) { return @as(u32, @intFromFloat('F')); }
    if (i == 19) { return flags; }
    return 0;
}

pub fn shell_decode(bytes: []const u8, n: usize) -> ShellLayout {
    if (n != 14) { return shell_default(); }

    const expected : []const u8 = "L280R280B220F3";
    var i : usize = 0;
    while (i < 14) {
        if (@as(u32, @intFromFloat(bytes[i])) != @as(u32, @intFromFloat(expected[i]))) {
            return shell_default();
        }
        i = i + 1;
    }

    const left : f64 = 280.0;
    const right : f64 = 280.0;
    const bottom : f64 = 220.0;
    const flags : u32 = 3;

    const left_open : bool = (flags & 1) != 0;
    const right_open : bool = (flags & 2) != 0;
    const bottom_open : bool = (flags & 4) != 0;

    var s : ShellLayout = ShellLayout {
        left_w: left,
        right_w: right,
        bottom_h: bottom,
        left_open: left_open,
        right_open: right_open,
        bottom_open: bottom_open,
        zen: false,
        saved_left: false,
        saved_right: false,
        saved_bottom: false,
    };

    return shell_clamp(s, 100000.0, 100000.0);
}

test shell_default_values {
    const s : ShellLayout = shell_default();
    assert s.left_w == SHELL_SIDE_DEFAULT;
    assert s.right_w == SHELL_SIDE_DEFAULT;
    assert s.bottom_h == SHELL_BOTTOM_DEFAULT;
    assert s.left_open == true;
    assert s.right_open == true;
    assert s.bottom_open == false;
    assert s.zen == false;
}

test shell_drag_left_clamp_max {
    const s : ShellLayout = shell_default();
    const dragged : ShellLayout = shell_drag(s, SHELL_SPL_LEFT, 500.0, 1280.0, 800.0);
    assert dragged.left_w == SHELL_SIDE_MAX;
    assert dragged.center.w >= CENTER_MIN_W; // This will be tested in shell_rects
}

test shell_drag_mirror {
    const s : ShellLayout = ShellLayout { left_w: 300.0, right_w: 300.0, bottom_h: SHELL_BOTTOM_DEFAULT, left_open: true, right_open: true, bottom_open: false, zen: false, saved_left: false, saved_right: false, saved_bottom: false };
    const dragged1 : ShellLayout = shell_drag(s, SHELL_SPL_LEFT, 40.0, 1280.0, 800.0);
    const dragged2 : ShellLayout = shell_drag(s, SHELL_SPL_RIGHT, -40.0, 1280.0, 800.0);
    assert dragged1.left_w == 340.0 and dragged1.right_w == 300.0;
    assert dragged2.left_w == 300.0 and dragged2.right_w == 340.0;
}

test shell_drag_bottom_clamp {
    const s : ShellLayout = shell_default();
    const dragged : ShellLayout = shell_drag(s, SHELL_SPL_BOTTOM, -2000.0, 1280.0, 800.0);
    assert dragged.bottom_h == 800.0 - WS_TOP - CENTER_MIN_H;
}

test shell_overlay_true {
    const s : ShellLayout = ShellLayout { left_w: 300.0, right_w: 300.0, bottom_h: SHELL_BOTTOM_DEFAULT, left_open: true, right_open: true, bottom_open: false, zen: false, saved_left: false, saved_right: false, saved_bottom: false };
    const overlay : bool = shell_overlay(s, 700.0);
    assert overlay == true;
    const rects : ShellRects = shell_rects(s, 700.0, 800.0);
    assert rects.center.w == 700.0;
    assert rects.left_overlay == true;
    assert rects.right_overlay == true;
}

test shell_overlay_false {
    const s : ShellLayout = ShellLayout { left_w: 300.0, right_w: 300.0, bottom_h: SHELL_BOTTOM_DEFAULT, left_open: true, right_open: true, bottom_open: false, zen: false, saved_left: false, saved_right: false, saved_bottom: false };
    const overlay : bool = shell_overlay(s, 1280.0);
    assert overlay == false;
}

test shell_key_inc_dec {
    const s : ShellLayout = ShellLayout { left_w: 300.0, right_w: 300.0, bottom_h: SHELL_BOTTOM_DEFAULT, left_open: true, right_open: true, bottom_open: false, zen: false, saved_left: false, saved_right: false, saved_bottom: false };
    const inc : ShellLayout = shell_key(s, SHELL_SPL_LEFT, SHELL_KEY_INC, 1280.0, 800.0);
    const dec : ShellLayout = shell_key(inc, SHELL_SPL_LEFT, SHELL_KEY_DEC, 1280.0, 800.0);
    assert inc.left_w == 316.0;
    assert dec.left_w == 300.0;
}

test shell_key_enter_toggle {
    const s : ShellLayout = shell_default();
    const toggled1 : ShellLayout = shell_key(s, SHELL_SPL_LEFT, SHELL_KEY_ENTER, 1280.0, 800.0);
    const toggled2 : ShellLayout = shell_key(toggled1, SHELL_SPL_LEFT, SHELL_KEY_ENTER, 1280.0, 800.0);
    assert toggled1.left_open == false;
    assert toggled2.left_open == true;
    assert toggled1.left_w == s.left_w;
    assert toggled2.left_w == s.left_w;
}

test shell_zen_toggle {
    const s : ShellLayout = shell_default();
    const zen_on : ShellLayout = shell_zen(s);
    const zen_off : ShellLayout = shell_zen(zen_on);
    assert zen_on.zen == true;
    assert zen_on.left_open == false;
    assert zen_on.right_open == false;
    assert zen_on.bottom_open == false;
    assert zen_on.saved_left == true;
    assert zen_off.zen == false;
    assert zen_off.left_open == true;
    assert zen_off.right_open == true;
    assert zen_off.bottom_open == false;
}

test shell_zen_rects {
    const s : ShellLayout = shell_default();
    const zen_on : ShellLayout = shell_zen(s);
    const rects : ShellRects = shell_rects(zen_on, 1280.0, 800.0);
    assert rects.left.w == 0.0;
    assert rects.right.w == 0.0;
    assert rects.bottom.h == 0.0;
}

test shell_regions_v2_still_works {
    const g : WinRegions = win_regions_v2(1280.0, 800.0, WS_EXPANDED, false, false, 150.0, STATUS_BAR_H);
    assert g.content.h > 0.0;
}
