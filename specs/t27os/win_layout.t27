// SPDX-License-Identifier: Apache-2.0
; Refs #13251
; specs/t27os/win_layout.t27 -- the window's regions, computed once from the window size, so the
; drawing code and the hit tests read the same rectangles instead of each recomputing them.
; Owner order START_T27OS_UI_KIT_NOW, 2026-11-08 (LAYOUT_AND_DUAL_GLASS_V2, ring 1): sidebar, toolbar,
; content and inspector are computed from the window size; the inspector reserves its width, so
; nothing of the content lies under it; drawing and hit testing consume one geometry.
; This is the minimal composition layer over what exists: it reuses t27os::layout (row helpers),
; t27os::queen::QP_W (the right-hand panel width) and the window constants that glass_window.t27
; used to keep by hand (HEADER_H 44, WS_TOP 35, TOGGLE_PT 28, BAR_H 26). When the window is wired
; to this module those constants are deleted there and imported from here; SIDE_W 272 was already
; t27os::dash's, so both read that one.
; Units are window points (f64), not the course HUD's i32 px of t27f::vf_uikit.
; A rect owns its left and top edges but not its right and bottom ones (half-open), so a point on a
; shared edge belongs to exactly one region.
; A screen page (the agent map) splits its content rect with page_split: the scene on the left,
; the page inspector on the right; a page too narrow for both stacks the inspector under the scene.
; Never laid over the scene.

module T27osWinLayout;

use t27os::queen::QP_W;
// the sidebar width (272) has one home, the dashboard's letter sidebar; it is read, not restated
use t27os::dash::SIDE_W;

/// The title bar plus its 1 pt divider: the workspace starts here.
pub const WS_TOP : f64 = 35.0;
/// The divider between the sidebar and the content.
pub const DIVIDER_W : f64 = 1.0;
/// The toolbar (header) height in the expanded workspace.
pub const HEADER_H : f64 = 44.0;
/// The "OPEN DASHBOARD" bar height in the compact workspace.
pub const BAR_H : f64 = 26.0;
/// The sidebar toggle button, square, and its inset from the toolbar's left edge.
pub const TOGGLE_PT : f64 = 28.0;
pub const TOOL_INSET : f64 = 14.0;
/// The gap between neighbouring toolbar buttons.
pub const TOOL_GAP : f64 = 12.0;
/// The sidebar rows sit this far inside the sidebar on both sides.
pub const SIDE_ROW_INSET : f64 = 12.0;
/// A page inspector column, and the narrowest scene that keeps it beside the scene.
pub const PAGE_INSP_W : f64 = 300.0;
pub const SCENE_MIN_W : f64 = 420.0;
/// The share of a stacked page the inspector may take, and its cap.
pub const STACK_SHARE : f64 = 0.4;
pub const STACK_MAX_H : f64 = 220.0;

/// Workspaces: the same values as glass_window.t27 WS_EXPANDED, WS_COMPACT, WS_DASHBOARD.
pub const WS_EXPANDED : u32 = 0;
pub const WS_COMPACT : u32 = 1;
pub const WS_DASHBOARD : u32 = 2;

/// Region ids returned by region_at.
pub const R_NONE : u32 = 0;
pub const R_TITLE : u32 = 1;
pub const R_SIDEBAR : u32 = 2;
pub const R_TOOLBAR : u32 = 3;
pub const R_CONTENT : u32 = 4;
pub const R_INSPECTOR : u32 = 5;

pub struct WinRect {
    pub x : f64,
    pub y : f64,
    pub w : f64,
    pub h : f64,
}

pub struct WinRegions {
    pub title : WinRect,
    pub sidebar : WinRect,
    pub toolbar : WinRect,
    pub content : WinRect,
    pub inspector : WinRect,
}

pub struct PageSplit {
    pub scene : WinRect,
    pub inspector : WinRect,
    pub stacked : bool,
}

fn nonneg(v: f64) -> f64 {
    if (v < 0.0) { return 0.0; }
    return v;
}

pub fn win_rect(x: f64, y: f64, w: f64, h: f64) -> WinRect {
    return WinRect { x: x, y: y, w: nonneg(w), h: nonneg(h) };
}

pub fn rect_right(r: WinRect) -> f64 {
    return r.x + r.w;
}

pub fn rect_bottom(r: WinRect) -> f64 {
    return r.y + r.h;
}

/// Half-open containment: left and top edges in, right and bottom edges out; an empty rect holds nothing.
pub fn rect_has(r: WinRect, x: f64, y: f64) -> bool {
    return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h;
}

/// True when two rects share any area.
pub fn rect_overlap(a: WinRect, b: WinRect) -> bool {
    if (a.w <= 0.0 or a.h <= 0.0 or b.w <= 0.0 or b.h <= 0.0) { return false; }
    return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h;
}

/// r with dx taken off both sides and dy off top and bottom.
pub fn rect_inset(r: WinRect, dx: f64, dy: f64) -> WinRect {
    return win_rect(r.x + dx, r.y + dy, r.w - 2.0 * dx, r.h - 2.0 * dy);
}

/// The sidebar width: SIDE_W only when expanded and not collapsed (the forced dashboard keeps a zero-width one).
pub fn side_w(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_EXPANDED and collapsed == false) { return SIDE_W; }
    return 0.0;
}

/// Left edge of the content: right of the sidebar and its divider, 0 when compact or collapsed.
pub fn content_x(ws: u32, collapsed: bool) -> f64 {
    if (ws == WS_COMPACT or collapsed) { return 0.0; }
    return side_w(ws, collapsed) + DIVIDER_W;
}

/// The inspector width: the right-hand panel (Queen, DOCTOR, KEYS) while one is open, else 0.
pub fn insp_w(panel: bool) -> f64 {
    if (panel) { return QP_W; }
    return 0.0;
}

/// Right edge of the content: the window edge, or the inspector's left edge while it is open.
pub fn content_right(sw: f64, panel: bool) -> f64 {
    return sw - insp_w(panel);
}

/// Every region of a sw x sh window. The toolbar is the header (expanded, dashboard) or the
/// OPEN DASHBOARD bar (compact); the content starts under it.
pub fn win_regions(sw: f64, sh: f64, ws: u32, collapsed: bool, panel: bool) -> WinRegions {
    const cx : f64 = content_x(ws, collapsed);
    const cr : f64 = content_right(sw, panel);
    var th : f64 = HEADER_H;
    var tx : f64 = cx;
    var tw : f64 = cr - cx;
    if (ws == WS_COMPACT) {
        th = BAR_H;
        tx = 0.0;
        tw = sw;
    }
    const body_h : f64 = sh - WS_TOP;
    return WinRegions {
        title: win_rect(0.0, 0.0, sw, WS_TOP),
        sidebar: win_rect(0.0, WS_TOP, side_w(ws, collapsed), body_h),
        toolbar: win_rect(tx, WS_TOP, tw, th),
        content: win_rect(cx, WS_TOP + th, cr - cx, body_h - th),
        inspector: win_rect(cr, WS_TOP, insp_w(panel), body_h),
    };
}

/// The one hit test: which region owns the point. Order matters only on the toolbar, which the
/// compact bar stretches over the full width while the inspector is open.
pub fn region_at(g: WinRegions, x: f64, y: f64) -> u32 {
    if (rect_has(g.title, x, y)) { return R_TITLE; }
    if (rect_has(g.toolbar, x, y)) { return R_TOOLBAR; }
    if (rect_has(g.inspector, x, y)) { return R_INSPECTOR; }
    if (rect_has(g.sidebar, x, y)) { return R_SIDEBAR; }
    if (rect_has(g.content, x, y)) { return R_CONTENT; }
    return R_NONE;
}

/// The sidebar rows: the sidebar inset by SIDE_ROW_INSET on both sides.
pub fn side_rows(g: WinRegions) -> WinRect {
    return rect_inset(g.sidebar, SIDE_ROW_INSET, 0.0);
}

/// The k-th 28 pt toolbar button from the left (0 the sidebar toggle, 1 Close Dashboard), centred on the
/// header's height: the one rect both the draw and the hit test read.
pub fn tool_btn(ws: u32, collapsed: bool, k: u32) -> WinRect {
    const x0 : f64 = content_x(ws, collapsed) + TOOL_INSET + @as(f64, @floatFromInt(k)) * (TOGGLE_PT + TOOL_GAP);
    return win_rect(x0, WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// The "+" (new chat) button at the right end of the header, the same 28 pt box.
pub fn new_btn(sw: f64) -> WinRect {
    return win_rect(sw - TOOL_INSET - TOGGLE_PT, WS_TOP + 0.5 * (HEADER_H - TOGGLE_PT), TOGGLE_PT, TOGGLE_PT);
}

/// A page's scene and inspector inside r: side by side while the scene keeps SCENE_MIN_W, else the
/// inspector stacked under the scene. With show false the scene takes all of r.
pub fn page_split(r: WinRect, show: bool) -> PageSplit {
    if (show == false) {
        return PageSplit { scene: r, inspector: win_rect(rect_right(r), r.y, 0.0, 0.0), stacked: false };
    }
    if (r.w - PAGE_INSP_W >= SCENE_MIN_W) {
        const sw : f64 = r.w - PAGE_INSP_W;
        return PageSplit { scene: win_rect(r.x, r.y, sw, r.h), inspector: win_rect(r.x + sw, r.y, PAGE_INSP_W, r.h), stacked: false };
    }
    var ih : f64 = STACK_SHARE * r.h;
    if (ih > STACK_MAX_H) { ih = STACK_MAX_H; }
    const sh : f64 = r.h - ih;
    return PageSplit { scene: win_rect(r.x, r.y, r.w, sh), inspector: win_rect(r.x, r.y + sh, r.w, ih), stacked: true };
}

test expanded_window_regions {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, false);
    assert g.title.h == 35.0 and g.title.w == 960.0;
    assert g.sidebar.x == 0.0 and g.sidebar.w == 272.0 and g.sidebar.h == 505.0;
    assert g.toolbar.x == 273.0 and g.toolbar.w == 687.0 and g.toolbar.h == 44.0;
    assert g.content.x == 273.0 and g.content.y == 79.0 and g.content.w == 687.0 and g.content.h == 461.0;
    assert g.inspector.w == 0.0;
}

test inspector_reserves_its_width {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    assert g.inspector.x == 660.0 and g.inspector.w == 300.0;
    assert rect_right(g.content) == g.inspector.x;
    assert rect_right(g.toolbar) == g.inspector.x;
    assert rect_overlap(g.content, g.inspector) == false;
    assert rect_overlap(g.toolbar, g.inspector) == false;
    assert rect_overlap(g.sidebar, g.content) == false;
}

test collapsed_and_compact {
    const c : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, true, false);
    assert c.sidebar.w == 0.0 and c.content.x == 0.0 and c.content.w == 960.0;
    const k : WinRegions = win_regions(700.0, 540.0, WS_COMPACT, false, false);
    assert k.sidebar.w == 0.0 and k.toolbar.h == BAR_H and k.toolbar.w == 700.0;
    assert k.content.y == WS_TOP + BAR_H;
    const d : WinRegions = win_regions(700.0, 540.0, WS_DASHBOARD, false, false);
    assert d.sidebar.w == 0.0 and d.content.x == DIVIDER_W;
}

test same_values_as_the_hand_fns {
    // glass_window.t27 side_w, content_x, content_right, content_w before the wiring
    assert side_w(WS_EXPANDED, false) == 272.0 and side_w(WS_DASHBOARD, false) == 0.0;
    assert content_x(WS_EXPANDED, false) == 273.0 and content_x(WS_COMPACT, false) == 0.0;
    assert content_right(1200.0, true) == 900.0 and content_right(1200.0, false) == 1200.0;
    const g : WinRegions = win_regions(1200.0, 800.0, WS_EXPANDED, false, true);
    assert g.content.w == 900.0 - 273.0;
    // in_side: rows from x 12 to SIDE_W - 12
    const rows : WinRect = side_rows(g);
    assert rows.x == 12.0 and rect_right(rows) == SIDE_W - 12.0;
}

test every_point_has_one_owner {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    var i : u32 = 0;
    var owned : u32 = 0;
    while (i < 12) {
        var j : u32 = 0;
        while (j < 8) {
            const x : f64 = 80.0 * @as(f64, @floatFromInt(i));
            const y : f64 = 67.5 * @as(f64, @floatFromInt(j));
            var n : u32 = 0;
            if (rect_has(g.title, x, y)) { n = n + 1; }
            if (rect_has(g.sidebar, x, y)) { n = n + 1; }
            if (rect_has(g.toolbar, x, y)) { n = n + 1; }
            if (rect_has(g.content, x, y)) { n = n + 1; }
            if (rect_has(g.inspector, x, y)) { n = n + 1; }
            // x 272 is the divider column, owned by nobody; every other point has exactly one owner
            assert n <= 1;
            if (n == 1) { owned = owned + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert owned == 96;
}

test shared_edges_have_one_owner {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    // the content/inspector edge belongs to the inspector, the title/workspace edge to the workspace
    assert region_at(g, 660.0, 300.0) == R_INSPECTOR;
    assert region_at(g, 659.5, 300.0) == R_CONTENT;
    assert region_at(g, 400.0, 35.0) == R_TOOLBAR;
    assert region_at(g, 400.0, 34.9) == R_TITLE;
    assert region_at(g, 100.0, 300.0) == R_SIDEBAR;
    assert region_at(g, 272.5, 300.0) == R_NONE;
}

test toggle_is_drawn_where_it_is_hit {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, false);
    const t : WinRect = tool_btn(WS_EXPANDED, false, 0);
    // glass_window.t27 on_side_toggle: content_x + 14, WS_TOP + (HEADER_H - TOGGLE_PT) / 2
    assert t.x == 287.0 and t.y == 43.0 and t.w == 28.0;
    assert region_at(g, t.x + 0.5 * t.w, t.y + 0.5 * t.h) == R_TOOLBAR;
    assert rect_has(g.toolbar, t.x, t.y) and rect_has(g.toolbar, rect_right(t) - 0.5, rect_bottom(t) - 0.5);
    // close_x: content_x + 14 + TOGGLE_PT + 12; the "+" box: sw - 14 - TOGGLE_PT
    assert tool_btn(WS_DASHBOARD, false, 1).x == 1.0 + 14.0 + 28.0 + 12.0;
    assert tool_btn(WS_EXPANDED, false, 1).x == 327.0;
    assert new_btn(960.0).x == 918.0 and new_btn(960.0).y == t.y;
    assert rect_overlap(tool_btn(WS_EXPANDED, false, 0), tool_btn(WS_EXPANDED, false, 1)) == false;
    const d : WinRegions = win_regions(960.0, 540.0, WS_DASHBOARD, false, false);
    const c : WinRect = tool_btn(WS_DASHBOARD, false, 1);
    assert region_at(d, c.x + 0.5 * c.w, c.y + 0.5 * c.h) == R_TOOLBAR;
}

test page_inspector_beside_or_under_never_over {
    const g : WinRegions = win_regions(1440.0, 900.0, WS_EXPANDED, false, false);
    const p : PageSplit = page_split(g.content, true);
    assert p.stacked == false;
    assert p.scene.w + p.inspector.w == g.content.w;
    assert rect_overlap(p.scene, p.inspector) == false;
    assert rect_right(p.inspector) == rect_right(g.content);
    const n : WinRegions = win_regions(700.0, 540.0, WS_COMPACT, false, false);
    const q : PageSplit = page_split(n.content, true);
    assert q.stacked == true;
    assert rect_overlap(q.scene, q.inspector) == false;
    assert @abs(q.scene.h + q.inspector.h - n.content.h) < 0.000001;
    assert q.inspector.h <= STACK_MAX_H;
    const h : PageSplit = page_split(g.content, false);
    assert h.scene.w == g.content.w and h.inspector.w == 0.0;
}

test negative_control_catches_an_overlay {
    const g : WinRegions = win_regions(960.0, 540.0, WS_EXPANDED, false, true);
    // the old defect: content laid out to the window edge while the panel is open
    const bad : WinRect = win_rect(g.content.x, g.content.y, 960.0 - g.content.x, g.content.h);
    assert rect_overlap(bad, g.inspector) == true;
    assert rect_overlap(g.content, g.inspector) == false;
}

test negative_control_refutes_closed_edges {
    // closed containment (the old in_box) gives a shared edge two owners; half-open gives one
    const a : WinRect = win_rect(0.0, 0.0, 10.0, 10.0);
    const b : WinRect = win_rect(10.0, 0.0, 10.0, 10.0);
    assert rect_has(a, 10.0, 5.0) == false and rect_has(b, 10.0, 5.0) == true;
    assert rect_overlap(a, b) == false;
}
