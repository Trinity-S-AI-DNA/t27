module T27DirectoryCrypto;
// Platform adapter only. P-256/SHA-256/DER validation is OpenSSL libcrypto, not new crypto.
// The build supplies official OpenSSL headers; pointer handles remain process-local.
pub fn dr_crypto_shape(message_len:u32,signature_len:u32)->bool {
    return message_len>0 and message_len<=512 and signature_len>=8 and signature_len<=80;
}
pub fn dr_verify(public_key:[65]u8,message:[512]u8,message_len:u32,signature:[80]u8,signature_len:u32)->bool {
    if(public_key[0]!=4 or !dr_crypto_shape(message_len,signature_len)) {
        return false;
    }
    const key:u64=EC_KEY_new_by_curve_name(415);
    if(key==0) {
        return false;
    }
    const group:u64=EC_KEY_get0_group(key);
    const point:u64=EC_POINT_new(group);
    var ok:bool=false;
    if(point!=0) {
        if(EC_POINT_oct2point(group,point,public_key,65,0)==1 and EC_KEY_set_public_key(key,point)==1) {
            var digest:[32]u8=undefined;
            SHA256(message,message_len,digest);
            ok=ECDSA_verify(0,digest,32,signature,signature_len,key)==1;
        }
        EC_POINT_free(point);
    }
    EC_KEY_free(key);
    return ok;
}
test crypto_input_bounds_refuse_empty_and_oversized_messages {
    assert !dr_crypto_shape(0,70) and !dr_crypto_shape(513,70);
    assert !dr_crypto_shape(32,7) and !dr_crypto_shape(32,81);
    assert dr_crypto_shape(32,70) and dr_crypto_shape(512,80);
}
