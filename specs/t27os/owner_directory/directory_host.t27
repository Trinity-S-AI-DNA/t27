module T27DirectoryHost;
// gen-C SDK host: product entry is dt_owner_run mapped to main by the compiler flag.
// Tests retain the generated T27_TEST_MAIN instead; no generated code is edited.
// Bounded signed-key directory and pair-authorized opaque relay.
// No private keys, content keys, file serving, redirects or third-party service calls.
fn dt_now()->u64 {
    var tv:[2]i64=undefined;
    if(gettimeofday(tv,0)!=0) {
        return 0;
    }
    return @as(u64,@intCast(tv[0]))*1000+@as(u64,@intCast(tv[1]))/1000;
}
fn dt_send_all(fd:i32,packet:[65536]u8,n:u32)->bool {
    var at:u32=0;
    while(at<n) {
        const sent:i64=send(fd,packet+at,n-at,16384);
        if(sent<=0) {
            return false;
        }
        at=at+@as(u32,@intCast(sent));
    }
    return true;
}
pub fn dt_service_port()->u32 {
    return 49300;
}
pub fn dt_owner_run()->i32 {
    const fd:i32=socket(10,1,0);
    if(fd<0) {
        return 1;
    }
    var on:[1]i32=undefined;
    on[0]=1;
    var off:[1]i32=undefined;
    off[0]=0;
    setsockopt(fd,1,2,on,4);
    if(setsockopt(fd,41,26,off,4)!=0) {
        close(fd);
        return 2;
    }
    var sa:[28]u8=undefined;
    var i:u32=0;
    while(i<28) {
        sa[i]=0;
        i=i+1;
    }
    sa[0]=10;
    const port:u32=dt_service_port();
    sa[2]=@as(u8,@intCast(port/256));
    sa[3]=@as(u8,@intCast(port%256));
    if(bind(fd,sa,28)!=0 or listen(fd,8)!=0) {
        close(fd);
        return 3;
    }
    var db:[600000]u8=undefined;
    i=0;
    while(i<600000) {
        db[i]=0;
        i=i+1;
    }
    while(true) {
        var from:[28]u8=undefined;
        var size:[1]u32=undefined;
        size[0]=28;
        const client:i32=accept(fd,from,size);
        if(client<0) {
            continue;
        }
        var timeout:[2]i64=undefined;
        timeout[0]=2;
        timeout[1]=0;
        setsockopt(client,1,20,timeout,16);
        setsockopt(client,1,21,timeout,16);
        var request:[65536]u8=undefined;
        var used:u32=0;
        var end:u32=0;
        const started:u64=dt_now();
        while(used<8192 and end==0 and dt_now()-started<3000) {
            const n:i64=recv(client,request+used,8192-used,0);
            if(n<=0) {
                break;
            }
            used=used+@as(u32,@intCast(n));
            end=dt_header_end(request,used);
        }
        if(end==0) {
            close(client);
            continue;
        }
        const length:i64=dt_content_length(request,end);
        if(length<0 or length>32768) {
            close(client);
            continue;
        }
        const total:u32=end+@as(u32,@intCast(length));
        while(used<total and dt_now()-started<3000) {
            const n:i64=recv(client,request+used,total-used,0);
            if(n<=0) {
                break;
            }
            used=used+@as(u32,@intCast(n));
        }
        if(used!=total) {
            close(client);
            continue;
        }
        if(dt_post(request,end)) {
            var packet:[32768]u8=undefined;
            i=0;
            while(i<@as(u32,@intCast(length))) {
                packet[i]=request[end+i];
                i=i+1;
            }
            var random:[16]u8=undefined;
            if(getrandom(random,16,0)!=16) {
                close(client);
                continue;
            }
            var response:[65536]u8=undefined;
            const count:u32=dp_process(db,packet,@as(u32,@intCast(length)),response,dt_now(),random);
            var head:[512]u8=undefined;
            const h:u32=dt_binary_head(head,count);
            send(client,head,h,16384);
            dt_send_all(client,response,count);
        }
        else {
            var response:[512]u8=undefined;
            const count:u32=dh_response(response,dh_health_request(request,used));
            send(client,response,count,16384);
        }
        close(client);
    }
    close(fd);
    return 0;
}
test owner_directory_uses_unprivileged_fixed_service_port {
    assert dt_service_port()==49300 and dt_service_port()>1024 and dt_service_port()<65536;
}
