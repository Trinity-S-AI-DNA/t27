module T27DirectoryHealth;
pub fn dh_health_request(b:[2048]u8,n:i64)->bool {
    return n>=16
    and b[0]==71
    and b[1]==69
    and b[2]==84
    and b[3]==32
    and b[4]==47
    and b[5]==104
    and b[6]==101
    and b[7]==97
    and b[8]==108
    and b[9]==116
    and b[10]==104
    and b[11]==32
    and b[12]==72
    and b[13]==84
    and b[14]==84
    and b[15]==80;
}
test health_route_does_not_accept_root_or_arbitrary_paths {
    var b:[2048]u8=undefined;
    var i:u32=0;
    while(i<2048) {
        b[i]=0;
        i=i+1;
    }
    assert !dh_health_request(b,0);
    const text:str="GET /health HTTP";
    i=0;
    while(i<16) {
        b[i]=text[i];
        i=i+1;
    }
    assert dh_health_request(b,16);
    b[4]=46;
    assert !dh_health_request(b,16);
    b[4]=47;
    b[5]=46;
    assert !dh_health_request(b,16);
}
fn dh_line(out:[512]u8,at:u32,text:str,n:u32)->u32 {
    var i:u32=0;
    while(i<n) {
        out[at+i]=text[i];
        i=i+1;
    }
    out[at+n]=13;
    out[at+n+1]=10;
    return at+n+2;
}
pub fn dh_response(out:[512]u8,ok:bool)->u32 {
    var at:u32=0;
    if(ok) {
        at=dh_line(out,at,"HTTP/1.1 200 OK",15);
        at=dh_line(out,at,"Content-Type: application/json",30);
        at=dh_line(out,at,"Content-Length: 40",18);
        at=dh_line(out,at,"Cache-Control: no-store",23);
    }
    else {
        at=dh_line(out,at,"HTTP/1.1 404 Not Found",22);
        at=dh_line(out,at,"Content-Length: 0",17);
    }
    at=dh_line(out,at,"Connection: close",17);
    out[at]=13;
    out[at+1]=10;
    at=at+2;
    if(ok) {
        const body:str="{\"service\":\"t27-owner-qa\",\"health\":\"ok\"}";
        var i:u32=0;
        while(i<40) {
            out[at+i]=body[i];
            i=i+1;
        }
        at=at+40;
    }
    return at;
}
test response_has_real_crlf_and_bounded_body {
    var b:[512]u8=undefined;
    const n:u32=dh_response(b,true);
    assert n<512 and b[15]==13 and b[16]==10;
    assert b[n-1]==125 and b[n-40]==123;
    const m:u32=dh_response(b,false);
    assert m<512 and b[m-4]==13 and b[m-3]==10 and b[m-2]==13 and b[m-1]==10;
}
