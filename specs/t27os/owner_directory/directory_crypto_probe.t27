module T27DirectoryCryptoProbe;
// Reads synthetic PUBLIC verification data from a private pipe; emits no payload.
pub fn main()->i32 {
    var packet:[178]u8=undefined;
    var at:u32=0;
    // read into one-byte offset through the ordinary C pointer expression emitted by gen-c.
    while(at<178) {
        const n:i64=read(0,packet+at,178-at);
        if(n<=0) {
            return 10;
        }
        at=at+@as(u32,@intCast(n));
    }
    var public_key:[65]u8=undefined;
    var message:[512]u8=undefined;
    var signature:[80]u8=undefined;
    var i:u32=0;
    while(i<65) {
        public_key[i]=packet[i];
        i=i+1;
    }
    i=0;
    while(i<80) {
        signature[i]=packet[66+i];
        i=i+1;
    }
    i=0;
    while(i<512) {
        message[i]=0;
        i=i+1;
    }
    i=0;
    while(i<32) {
        message[i]=packet[146+i];
        i=i+1;
    }
    const signature_len:u32=packet[65];
    if(!dr_verify(public_key,message,32,signature,signature_len)) {
        return 11;
    }
    message[0]=message[0]^1;
    if(dr_verify(public_key,message,32,signature,signature_len)) {
        return 12;
    }
    message[0]=message[0]^1;
    signature[signature_len-1]=signature[signature_len-1]^1;
    if(dr_verify(public_key,message,32,signature,signature_len)) {
        return 13;
    }
    signature[signature_len-1]=signature[signature_len-1]^1;
    public_key[0]=0;
    if(dr_verify(public_key,message,32,signature,signature_len)) {
        return 14;
    }
    return 0;
}
test pipe_probe_record_is_fixed_and_public_only {
    assert 65+1+80+32==178;
}
