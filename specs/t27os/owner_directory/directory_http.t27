module T27DirectoryHTTP;
// Bounded HTTP/1 framing for one dedicated endpoint. No chunked bodies or file routing.
pub fn dt_header_end(b:[65536]u8,n:u32)->u32 {
    if(n>65536) {
        return 0;
    }
    var i:u32=0;
    while(i+3<n and i<8192) {
        if(b[i]==13 and b[i+1]==10 and b[i+2]==13 and b[i+3]==10) {
            return i+4;
        }
        i=i+1;
    }
    return 0;
}
fn dt_lower(v:u8)->u8 {
    return if(v>=65 and v<=90) v+32 else v;
}
fn dt_name(b:[65536]u8,at:u32,n:u32,text:str,length:u32)->bool {
    if(n!=length) {
        return false;
    }
    var i:u32=0;
    while(i<n) {
        if(dt_lower(b[at+i])!=@as(u8,text[i])) {
            return false;
        }
        i=i+1;
    }
    return true;
}
pub fn dt_content_length(b:[65536]u8,end:u32)->i64 {
    if(end<4 or end>8196) {
        return -1;
    }
    var cursor:u32=0;
    while(cursor+1<end) {
        if(b[cursor]==13 and b[cursor+1]==10) {
            cursor=cursor+2;
            break;
        }
        cursor=cursor+1;
    }
    var found:bool=false;
    var length:u32=0;
    while(cursor+1<end) {
        if(b[cursor]==13 and b[cursor+1]==10) {
            break;
        }
        const start:u32=cursor;
        var colon:u32=0;
        while(cursor+1<end and !(b[cursor]==13 and b[cursor+1]==10)) {
            if(b[cursor]==0) {
                return -1;
            }
            if(b[cursor]==58 and colon==0) {
                colon=cursor;
            }
            cursor=cursor+1;
        }
        if(cursor+1>=end or colon==0) {
            return -1;
        }
        if(dt_name(b,start,colon-start,"transfer-encoding",17)) {
            return -1;
        }
        if(dt_name(b,start,colon-start,"content-length",14)) {
            if(found) {
                return -1;
            }
            found=true;
            var at:u32=colon+1;
            while(at<cursor and b[at]==32) {
                at=at+1;
            }
            if(at==cursor) {
                return -1;
            }
            while(at<cursor) {
                if(b[at]<48 or b[at]>57) {
                    return -1;
                }
                length=length*10+@as(u32,b[at]-48);
                if(length>32768) {
                    return -1;
                }
                at=at+1;
            }
        }
        cursor=cursor+2;
    }
    return @as(i64,length);
}
pub fn dt_post(b:[65536]u8,n:u32)->bool {
    return n>=18
    and b[0]==80
    and b[1]==79
    and b[2]==83
    and b[3]==84
    and b[4]==32
    and b[5]==47
    and b[6]==116
    and b[7]==50
    and b[8]==55
    and b[9]==32
    and b[10]==72
    and b[11]==84
    and b[12]==84
    and b[13]==80
    and b[14]==47
    and b[15]==49
    and b[16]==46
    and b[17]==49;
}
fn dt_line(out:[512]u8,at:u32,text:str,n:u32)->u32 {
    var i:u32=0;
    while(i<n) {
        out[at+i]=text[i];
        i=i+1;
    }
    out[at+n]=13;
    out[at+n+1]=10;
    return at+n+2;
}
pub fn dt_binary_head(out:[512]u8,length:u32)->u32 {
    var at:u32=dt_line(out,0,"HTTP/1.1 200 OK",15);
    at=dt_line(out,at,"Content-Type: application/octet-stream",38);
    const name:str="Content-Length: ";
    var i:u32=0;
    while(i<16) {
        out[at+i]=name[i];
        i=i+1;
    }
    at=at+16;
    var digits:[10]u8=undefined;
    var count:u32=0;
    var value:u32=length;
    while(true) {
        digits[count]=@as(u8,@intCast(value%10))+48;
        count=count+1;
        value=value/10;
        if(value==0) {
            break;
        }
    }
    while(count>0) {
        count=count-1;
        out[at]=digits[count];
        at=at+1;
    }
    out[at]=13;
    out[at+1]=10;
    at=at+2;
    at=dt_line(out,at,"Cache-Control: no-store",23);
    at=dt_line(out,at,"Connection: close",17);
    out[at]=13;
    out[at+1]=10;
    return at+2;
}
test strict_http_framing_refuses_ambiguous_or_oversized_lengths {
    var b:[65536]u8=undefined;
    var i:u32=0;
    while(i<65536) {
        b[i]=0;
        i=i+1;
    }
    // Build real CRLF bytes rather than relying on target string escape differences.
    const line:str="POST /t27 HTTP/1.1";
    i=0;
    while(i<18) {
        b[i]=line[i];
        i=i+1;
    }
    b[18]=13;
    b[19]=10;
    const header:str="Content-Length: 304";
    i=0;
    while(i<19) {
        b[20+i]=header[i];
        i=i+1;
    }
    b[39]=13;
    b[40]=10;
    b[41]=13;
    b[42]=10;
    assert dt_header_end(b,43)==43 and dt_content_length(b,43)==304 and dt_post(b,43);
    b[36]=57;
    b[37]=57;
    b[38]=57;
    assert dt_content_length(b,43)==999;
    b[20]=0;
    assert dt_content_length(b,43)==-1;
    assert dt_header_end(b,65537)==0;
}
test binary_response_header_is_bounded_and_uses_crlf {
    var out:[512]u8=undefined;
    const n:u32=dt_binary_head(out,32832);
    assert n<512 and out[15]==13 and out[16]==10 and out[n-4]==13 and out[n-3]==10 and out[n-2]==13 and out[n-1]==10;
}
