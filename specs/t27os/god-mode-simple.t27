; Owner, 2026-10-21: Simplified version compatible with T27 syntax
; φ^2 + 1/φ² = 3 | TRINITY

module T27osGodModeSimple;

/// GOD MODE state constants
pub const GOD_MODE_OFF : u32 = 0;
pub const GOD_MODE_ON : u32 = 1;
pub const GOD_MODE_PENDING : u32 = 2;

/// Convert boolean to GodModeState for backward compatibility
pub fn from_bool(value: bool) -> u32 {
    if (value) { return GOD_MODE_ON; }
    return GOD_MODE_OFF;
}

/// Convert GodModeState to boolean for legacy components
pub fn to_bool(state: u32) -> bool {
    return state == GOD_MODE_ON;
}

/// Get the display text for the current state
pub fn display_text(state: u32) -> str {
    if (state == GOD_MODE_OFF) {
        return "GOD MODE OFF";
    } else if (state == GOD_MODE_ON) {
        return "GOD MODE ON";
    } else {
        return "GOD MODE...";
    }
}

/// Edge glow colors based on state
pub const GLOW_OFF_R : f64 = 0.0;
pub const GLOW_OFF_G : f64 = 0.0;
pub const GLOW_OFF_B : f64 = 0.0;
pub const GLOW_ON_R : f64 = 0.22;
pub const GLOW_ON_G : f64 = 0.10;
pub const GLOW_ON_B : f64 = 0.80;
pub const GLOW_PENDING_R : f64 = 0.39;
pub const GLOW_PENDING_G : f64 = 0.26;
pub const GLOW_PENDING_B : f64 = 0.90;

/// Smooth transition parameters
pub const TRANSITION_STEPS : u32 = 5;
pub const TRANSITION_DELAY_MS : u64 = 100;

/// Check if a state transition is allowed
pub fn can_transition(from: u32, to: u32) -> bool {
    // Allow all valid transitions
    if (from == GOD_MODE_OFF) {
        return to == GOD_MODE_ON or to == GOD_MODE_PENDING;
    } else if (from == GOD_MODE_ON) {
        return to == GOD_MODE_OFF or to == GOD_MODE_PENDING;
    } else if (from == GOD_MODE_PENDING) {
        return to == GOD_MODE_ON or to == GOD_MODE_OFF;
    }
    return false;
}

/// Get the transition sequence between states
pub fn transition_sequence(from: u32, to: u32) -> [3]u32 {
    var sequence : [3]u32 = undefined;

    if (from == to) {
        // No transition needed
        sequence[0] = from;
        return sequence;
    }

    if (from == GOD_MODE_OFF && to == GOD_MODE_ON) {
        sequence[0] = GOD_MODE_OFF;
        sequence[1] = GOD_MODE_PENDING;
        sequence[2] = GOD_MODE_ON;
        return sequence;
    }

    if (from == GOD_MODE_ON && to == GOD_MODE_OFF) {
        sequence[0] = GOD_MODE_ON;
        sequence[1] = GOD_MODE_PENDING;
        sequence[2] = GOD_MODE_OFF;
        return sequence;
    }

    // Default: direct transition
    sequence[0] = from;
    sequence[1] = to;
    return sequence;
}

/// Calculate glow intensity for a given state and transition progress
pub fn glow_intensity(state: u32, progress: f64) -> f64 {
    if (state == GOD_MODE_OFF) {
        return 0.0 * progress;
    } else if (state == GOD_MODE_ON) {
        return 1.0 * progress;
    } else { // GOD_MODE_PENDING
        // Pulsing effect for pending state
        const pulse : f64 = @sin(@as(f64, @intFromInt(progress * 360)) * 3.14159 / 180);
        return 0.5 + 0.5 * pulse;
    }
}

/// Unified event handling for GOD MODE
pub const GOD_MODE_TOGGLE : u32 = 0;
pub const GOD_MODE_ACTIVATE : u32 = 1;
pub const GOD_MODE_DEACTIVATE : u32 = 2;
pub const GOD_MODE_FORCE_OFF : u32 = 3;

/// Process a GOD MODE event and return the new state
pub fn process_event(current: u32, event: u32) -> u32 {
    if (event == GOD_MODE_TOGGLE) {
        if (current == GOD_MODE_OFF) return GOD_MODE_ON;
        if (current == GOD_MODE_ON) return GOD_MODE_OFF;
        return current; // PENDING toggles to opposite
    } else if (event == GOD_MODE_ACTIVATE) {
        if (current == GOD_MODE_OFF) return GOD_MODE_ON;
        return current;
    } else if (event == GOD_MODE_DEACTIVATE) {
        if (current == GOD_MODE_ON) return GOD_MODE_OFF;
        return current;
    } else if (event == GOD_MODE_FORCE_OFF) {
        return GOD_MODE_OFF; // Always force off
    }
    return current;
}

/// UI state management
pub const UIState : struct {
    current: u32 = GOD_MODE_OFF,
    display: u32 = GOD_MODE_OFF,  // What's currently displayed
    last_update: u64 = 0,         // Timestamp of last state change
    is_animating: bool = false    // Whether transition animation is running
};

/// Update UI state with new GOD MODE state
pub fn update_ui(ui: *UIState, new_state: u32, now: u64) -> void {
    if (ui.current != new_state) {
        ui.current = new_state;
        ui.last_update = now;

        // Start animation for state changes
        if (new_state == GOD_MODE_OFF or new_state == GOD_MODE_ON) {
            ui.is_animating = true;
            ui.display = GOD_MODE_PENDING; // Show intermediate state
        } else {
            ui.display = new_state;
        }
    }
}

/// Complete UI transition
pub fn complete_ui_transition(ui: *UIState) -> void {
    ui.display = ui.current;
    ui.is_animating = false;
}

/// Legacy compatibility layer - converts old constants to new system
pub const LEGACY : struct {
    C_GOD_ON: u32 = 11,    // Maps to TOGGLE
    C_GOD_OFF: u32 = 12   // Maps to FORCE_OFF
};

/// Migration helper for existing code
pub fn migrate_legacy_control(control: u32) -> GodModeEvent {
    if (control == LEGACY.C_GOD_ON) {
        return Toggle;
    } else if (control == LEGACY.C_GOD_OFF) {
        return ForceOff;
    }
    return Toggle; // Default toggle for safety
}

// Basic tests
test god_mode_state_conversion {
    // Boolean conversion
    assert from_bool(true) == GOD_MODE_ON;
    assert from_bool(false) == GOD_MODE_OFF;
    assert to_bool(GOD_MODE_ON) == true;
    assert to_bool(GOD_MODE_OFF) == false;
    assert to_bool(GOD_MODE_PENDING) == false;

    // Display text
    assert display_text(GOD_MODE_OFF) == "GOD MODE OFF";
    assert display_text(GOD_MODE_ON) == "GOD MODE ON";
    assert display_text(GOD_MODE_PENDING) == "GOD MODE...";
}

test transition_validity {
    // Valid transitions
    assert can_transition(GOD_MODE_OFF, GOD_MODE_ON) == true;
    assert can_transition(GOD_MODE_OFF, GOD_MODE_PENDING) == true;
    assert can_transition(GOD_MODE_ON, GOD_MODE_OFF) == true;
    assert can_transition(GOD_MODE_ON, GOD_MODE_PENDING) == true;
    assert can_transition(GOD_MODE_PENDING, GOD_MODE_ON) == true;
    assert can_transition(GOD_MODE_PENDING, GOD_MODE_OFF) == true;

    // Invalid transitions
    assert can_transition(GOD_MODE_OFF, GOD_MODE_OFF) == false;
    assert can_transition(GOD_MODE_ON, GOD_MODE_ON) == false;
}

test event_processing {
    // Toggle events
    assert process_event(GOD_MODE_OFF, Toggle) == GOD_MODE_ON;
    assert process_event(GOD_MODE_ON, Toggle) == GOD_MODE_OFF;
    assert process_event(GOD_MODE_PENDING, Toggle) == GOD_MODE_PENDING;

    // Activate/deactivate
    assert process_event(GOD_MODE_OFF, Activate) == GOD_MODE_ON;
    assert process_event(GOD_MODE_ON, Deactivate) == GOD_MODE_OFF;
    assert process_event(GOD_MODE_OFF, Deactivate) == GOD_MODE_OFF;

    // Force off
    assert process_event(GOD_MODE_ON, ForceOff) == GOD_MODE_OFF;
    assert process_event(GOD_MODE_PENDING, ForceOff) == GOD_MODE_OFF;
    assert process_event(GOD_MODE_OFF, ForceOff) == GOD_MODE_OFF;
}

test glow_intensity_calculation {
    // Off state has no glow
    assert glow_intensity(GOD_MODE_OFF, 0.5) == 0.0;

    // On state has full glow
    assert glow_intensity(GOD_MODE_ON, 1.0) == 1.0;

    // Pending state has pulsing glow
    const intensity1 : f64 = glow_intensity(GOD_MODE_PENDING, 0.0);
    const intensity2 : f64 = glow_intensity(GOD_MODE_PENDING, 0.25);
    assert intensity1 != intensity2; // Should pulse
}