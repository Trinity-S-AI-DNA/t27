// SPDX-License-Identifier: Apache-2.0
; specs/t27os/orch_page.t27 -- the model of the new Queen orchestrator page of T27 OS, built only from UI Kit components
; Refs Trinity-S-AI-DNA/t27#13718
; The old page model is specs/t27os/queen_dash.t27 (read for content only, not changed). This spec adds a design switch and a theme switch
; Design PRESERVED keeps the old look, design UIKIT draws the same sections from specs/t27f/ui_kit.t27 builders; the page state keeps every other field when either switch moves
; Every pub name carries the op_ / OP_ prefix: t27b has a flat namespace and glass_window.t27 owns many short names
; The host must not invent coordinates: sections, tiles and the inside of each section are integer functions here (the inside through vf_layout)
; Colour: no literal in this spec. op_color delegates to th_color (vf_theme); th_color knows two tables (TH_T27 and TH_PAPER), so light maps to PAPER, dark and high contrast map to T27. op_fill and op_label read the per-theme kind tables of vf_theme for the AERT check
; Graph cap is VF_MAX_NODES = 16 per graph, so a section is several small graphs: header = title + nav + two buttons, tile = card + badge, mycelium = one container, lanes = one table, queue = one nav

module t27os_orch_page;
use t27f::ui_plan::THEME_LIGHT;
use t27f::ui_plan::THEME_DARK;
use t27f::ui_plan::THEME_HIGH_CONTRAST;
use t27f::ui_plan::THEME_KINDS;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_MAX_NODES;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::vf_validate;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_layout::vf_layout_equal;
use t27f::vf_theme::th_color;
use t27f::vf_theme::vf_fill;
use t27f::vf_theme::vf_label;
use t27f::vf_theme::vf_aert_ok;
use t27f::vf_theme::TH_T27;
use t27f::vf_theme::TH_PAPER;
use t27f::vf_theme::TH_BG;
use t27f::vf_theme::TH_TEXT;
use t27f::ui_kit::UiKit;
use t27f::ui_kit::KV_PRIMARY;
use t27f::ui_kit::KV_SECONDARY;
use t27f::ui_kit::KV_GHOST;
use t27f::ui_kit::KV_SUCCESS;
use t27f::ui_kit::KV_WARN;
use t27f::ui_kit::KS_DEFAULT;
use t27f::ui_kit::kit_card;
use t27f::ui_kit::kit_badge;
use t27f::ui_kit::kit_button;
use t27f::ui_kit::kit_nav;
use t27f::ui_kit::kit_table;
use t27f::ui_kit::kit_text;
use t27f::ui_kit::kit_container;
use t27f::ui_kit::kit_node_count;

; design ids
pub const OP_DESIGN_PRESERVED : u32 = 0;
pub const OP_DESIGN_UIKIT : u32 = 1;
pub const OP_DESIGN_COUNT : u32 = 2;

; sections, top to bottom
pub const OP_SEC_HEADER : u32 = 0;
pub const OP_SEC_TILES : u32 = 1;
pub const OP_SEC_MYCELIUM : u32 = 2;
pub const OP_SEC_LANES : u32 = 3;
pub const OP_SEC_QUEUE : u32 = 4;
pub const OP_SEC_COUNT : u32 = 5;

; tiles: god mode, local queen, trigit, keys, this machine, machines online
pub const OP_TILE_COUNT : u32 = 6;
pub const OP_TILE_NAMES : [6]str = ["GOD MODE", "LOCAL QUEEN", "TRIGIT", "KEYS", "THIS MACHINE", "MACHINES ONLINE"];
pub const OP_LABEL_DESIGN : str = "DESIGN";
pub const OP_LABEL_THEME : str = "THEME";
pub const OP_LABEL_ON : str = "ON";
pub const OP_LABEL_OFF : str = "OFF";

; geometry in px, integers: page padding, gap, tile height, section heights, column breakpoints
pub const OP_PAD : u32 = 16;
pub const OP_GAP : u32 = 12;
pub const OP_TILE_H : u32 = 96;
pub const OP_HEADER_H : u32 = 64;
pub const OP_MYCELIUM_H : u32 = 160;
pub const OP_LANES_H : u32 = 160;
pub const OP_QUEUE_MIN_H : u32 = 120;
pub const OP_BP_4 : u32 = 1100;
pub const OP_BP_3 : u32 = 800;
pub const OP_BP_2 : u32 = 520;

pub struct OpRect {
    x: u32,
    y: u32,
    w: u32,
    h: u32,
}

; page state: design, theme, selected lane, scroll offset, open section
pub struct OpState {
    design: u32,
    theme: u8,
    lane: u32,
    scroll: u32,
    open_sec: u32,
}

pub fn op_state_new() -> OpState {
    return OpState { design: OP_DESIGN_UIKIT, theme: THEME_LIGHT, lane: 0, scroll: 0, open_sec: OP_SEC_TILES };
}

pub fn op_design_ok(d: u32) -> bool {
    return d < OP_DESIGN_COUNT;
}

pub fn op_design_next(d: u32) -> u32 {
    if d + 1 >= OP_DESIGN_COUNT {
        return 0;
    }
    return d + 1;
}

pub fn op_theme_ok(t: u8) -> bool {
    return t < THEME_KINDS;
}

; light -> dark -> high contrast -> light
pub fn op_theme_next(t: u8) -> u8 {
    if t == THEME_LIGHT {
        return THEME_DARK;
    }
    if t == THEME_DARK {
        return THEME_HIGH_CONTRAST;
    }
    return THEME_LIGHT;
}

; the switches return the state unchanged except one field; an invalid id leaves the state unchanged
pub fn op_switch_design(s: OpState, d: u32) -> OpState {
    var n : OpState = s;
    if op_design_ok(d) {
        n.design = d;
    }
    return n;
}

pub fn op_switch_theme(s: OpState, t: u8) -> OpState {
    var n : OpState = s;
    if op_theme_ok(t) {
        n.theme = t;
    }
    return n;
}

; colour: no literal here, only delegation
pub fn op_theme_table(theme: u8) -> u32 {
    if theme == THEME_LIGHT {
        return TH_PAPER;
    }
    return TH_T27;
}

pub fn op_color(theme: u8, role: u32) -> u32 {
    return th_color(op_theme_table(theme), role);
}

pub fn op_fill(theme: u8, kind: u8) -> u32 {
    return vf_fill(theme, kind);
}

pub fn op_label(theme: u8, kind: u8) -> u32 {
    return vf_label(theme, kind);
}

pub fn op_label_ok(theme: u8, kind: u8) -> bool {
    return vf_aert_ok(vf_label(theme, kind), vf_fill(theme, kind));
}

; builders: only kit components, one graph per piece (each stays under the 16-node cap)
fn op_set_text(k: UiKit, i: u32, txt: str) -> UiKit {
    var g : VfGraph = k.graph;
    if i < g.node_count {
        g.text[i] = txt;
    }
    var n : UiKit = k;
    n.graph = g;
    return n;
}

pub fn op_header_title() -> UiKit {
    return op_set_text(kit_text(KV_PRIMARY), 0, "QUEEN");
}

pub fn op_header_nav(active: u32) -> UiKit {
    return kit_nav(active);
}

pub fn op_header_design_button() -> UiKit {
    return op_set_text(kit_button(KV_SECONDARY, KS_DEFAULT), 1, OP_LABEL_DESIGN);
}

pub fn op_header_theme_button() -> UiKit {
    return op_set_text(kit_button(KV_GHOST, KS_DEFAULT), 1, OP_LABEL_THEME);
}

pub fn op_tile_card(i: u32) -> UiKit {
    var k : UiKit = kit_card(KV_PRIMARY, KS_DEFAULT);
    if i < OP_TILE_COUNT {
        k = op_set_text(k, 1, OP_TILE_NAMES[i]);
    }
    return k;
}

pub fn op_tile_badge(on: bool) -> UiKit {
    if on {
        return op_set_text(kit_badge(KV_SUCCESS), 0, OP_LABEL_ON);
    }
    return op_set_text(kit_badge(KV_WARN), 0, OP_LABEL_OFF);
}

pub fn op_mycelium_band() -> UiKit {
    return kit_container(DIR_COLUMN);
}

pub fn op_lanes_table() -> UiKit {
    return kit_table(2);
}

pub fn op_queue_list(selected: u32) -> UiKit {
    return kit_nav(selected);
}

; one representative graph per section, the one that fills the section body
pub fn op_section_graph(sec: u32, s: OpState) -> UiKit {
    if sec == OP_SEC_HEADER {
        return op_header_nav(0);
    }
    if sec == OP_SEC_TILES {
        return op_tile_card(0);
    }
    if sec == OP_SEC_MYCELIUM {
        return op_mycelium_band();
    }
    if sec == OP_SEC_LANES {
        return op_lanes_table();
    }
    return op_queue_list(s.lane);
}

; page layout
pub fn op_cols(w: u32) -> u32 {
    if w >= OP_BP_4 {
        return 4;
    }
    if w >= OP_BP_3 {
        return 3;
    }
    if w >= OP_BP_2 {
        return 2;
    }
    return 1;
}

pub fn op_inner_w(w: u32) -> u32 {
    if w <= 2 * OP_PAD {
        return 0;
    }
    return w - 2 * OP_PAD;
}

pub fn op_tile_w(w: u32) -> u32 {
    let c : u32 = op_cols(w);
    return (op_inner_w(w) - (c - 1) * OP_GAP) / c;
}

pub fn op_tile_rows(w: u32) -> u32 {
    let c : u32 = op_cols(w);
    return (OP_TILE_COUNT + c - 1) / c;
}

pub fn op_tiles_h(w: u32) -> u32 {
    return op_tile_rows(w) * (OP_TILE_H + OP_GAP) + OP_GAP;
}

pub fn op_tile_rect(i: u32, x0: u32, y0: u32, w: u32) -> OpRect {
    let c : u32 = op_cols(w);
    let tw : u32 = op_tile_w(w);
    return OpRect {
        x: x0 + OP_PAD + (i % c) * (tw + OP_GAP),
        y: y0 + OP_GAP + (i / c) * (OP_TILE_H + OP_GAP),
        w: tw,
        h: OP_TILE_H,
    };
}

fn op_section_h_fixed(sec: u32, w: u32) -> u32 {
    if sec == OP_SEC_HEADER {
        return OP_HEADER_H;
    }
    if sec == OP_SEC_TILES {
        return op_tiles_h(w);
    }
    if sec == OP_SEC_MYCELIUM {
        return OP_MYCELIUM_H;
    }
    if sec == OP_SEC_LANES {
        return OP_LANES_H;
    }
    return OP_QUEUE_MIN_H;
}

pub fn op_section_y(sec: u32, w: u32, h: u32) -> u32 {
    var y : u32 = 0;
    var s : u32 = 0;
    while s < sec and s < OP_SEC_COUNT {
        y = y + op_section_h_fixed(s, w);
        s = s + 1;
    }
    return y;
}

; the queue takes the rest of the page height, never less than OP_QUEUE_MIN_H
pub fn op_section_h(sec: u32, w: u32, h: u32) -> u32 {
    if sec == OP_SEC_QUEUE {
        let top : u32 = op_section_y(OP_SEC_QUEUE, w, h);
        if h > top + OP_QUEUE_MIN_H {
            return h - top;
        }
        return OP_QUEUE_MIN_H;
    }
    return op_section_h_fixed(sec, w);
}

pub fn op_section_rect(sec: u32, w: u32, h: u32) -> OpRect {
    return OpRect { x: 0, y: op_section_y(sec, w, h), w: w, h: op_section_h(sec, w, h) };
}

pub fn op_page_h(w: u32, h: u32) -> u32 {
    return op_section_y(OP_SEC_QUEUE, w, h) + op_section_h(OP_SEC_QUEUE, w, h);
}

; the inside of a section: the kit graph with the viewport set to the section content box, resolved by vf_layout
pub fn op_section_layout(sec: u32, s: OpState, w: u32, h: u32) -> VfLayout {
    let k : UiKit = op_section_graph(sec, s);
    var g : VfGraph = k.graph;
    g.viewport_w = op_inner_w(w);
    g.viewport_h = op_section_h(sec, w, h);
    return vf_layout(g);
}

; every node of the section layout lies inside the section content box
pub fn op_section_inside_fits(sec: u32, s: OpState, w: u32, h: u32) -> bool {
    let l : VfLayout = op_section_layout(sec, s, w, h);
    var i : u32 = 0;
    while i < l.node_count {
        if l.x[i] + l.w[i] > op_inner_w(w) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn op_section_fits(sec: u32, w: u32, h: u32) -> bool {
    let r : OpRect = op_section_rect(sec, w, h);
    return r.x + r.w <= w;
}

pub fn op_tile_fits(i: u32, w: u32) -> bool {
    let r : OpRect = op_tile_rect(i, 0, 0, w);
    return r.x + r.w + OP_PAD <= w and r.w > 0;
}

; an agent-grid page (a proposal, not wired: owner 2026-11-14, Home stays the LOGO-1b triangle with the
; formula orbit): a header with the QUEEN button, then one UI Kit card per agent, 27 cards in a grid
pub const OP_HOME_CELLS : u32 = 27;
pub const OP_HOME_TILE_H : u32 = 64;
pub const OP_HOME_TOP : u32 = 56;
pub const OP_HOME_BTN_W : u32 = 120;
pub const OP_HOME_BTN_H : u32 = 32;
pub const OP_HIT_QUEEN : u32 = 254;
pub const OP_HIT_NONE : u32 = 255;

; the host theme word (win_material: 0 dark, 1 light, 2 opaque) as a ui_plan theme id
pub fn op_theme_of_host(th: u32) -> u8 {
    if th == 1 {
        return THEME_LIGHT;
    }
    if th == 2 {
        return THEME_HIGH_CONTRAST;
    }
    return THEME_DARK;
}

; 9 columns at the widest, then 6, then 3: 3, 5 or 9 rows
pub fn op_home_cols(w: u32) -> u32 {
    if w >= OP_BP_4 {
        return 9;
    }
    if w >= OP_BP_3 {
        return 6;
    }
    return 3;
}

pub fn op_home_tile_w(w: u32) -> u32 {
    let c : u32 = op_home_cols(w);
    return (op_inner_w(w) - (c - 1) * OP_GAP) / c;
}

pub fn op_home_tile_rect(i: u32, w: u32) -> OpRect {
    let c : u32 = op_home_cols(w);
    let tw : u32 = op_home_tile_w(w);
    return OpRect {
        x: OP_PAD + (i % c) * (tw + OP_GAP),
        y: OP_HOME_TOP + OP_HEADER_H + (i / c) * (OP_HOME_TILE_H + OP_GAP),
        w: tw,
        h: OP_HOME_TILE_H,
    };
}

; the QUEEN button sits at the right end of the header row
pub fn op_home_queen_rect(w: u32) -> OpRect {
    return OpRect { x: w - OP_PAD - OP_HOME_BTN_W, y: OP_HOME_TOP + (OP_HEADER_H - OP_HOME_BTN_H) / 2, w: OP_HOME_BTN_W, h: OP_HOME_BTN_H };
}

pub fn op_in(r: OpRect, x: u32, y: u32) -> bool {
    return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h;
}

; a point on the page: an agent index below 27, OP_HIT_QUEEN, or OP_HIT_NONE
pub fn op_home_hit(x: u32, y: u32, w: u32) -> u32 {
    if op_in(op_home_queen_rect(w), x, y) {
        return OP_HIT_QUEEN;
    }
    var i : u32 = 0;
    while i < OP_HOME_CELLS {
        if op_in(op_home_tile_rect(i, w), x, y) {
            return i;
        }
        i = i + 1;
    }
    return OP_HIT_NONE;
}

; the glass material of the home and the Queen page (owner 2026-11-14: matte black frosted glass in dark,
; the visionOS warm taupe glass in light). One table per theme, each entry 0xRRGGBBAA; the host reads it and
; holds no colour of its own. Roles: the backdrop's top and bottom (an opaque vertical ramp), a pane, a pane
; under the pointer or selected, the pane rim (a hairline), the ink and the dim ink on a pane, the pane's
; cast shadow, and the sheen (a faint white on the pane's upper half)
pub const OP_GL_BACK_TOP : u32 = 0;
pub const OP_GL_BACK_BOT : u32 = 1;
pub const OP_GL_PANE : u32 = 2;
pub const OP_GL_PANE_HOT : u32 = 3;
pub const OP_GL_RIM : u32 = 4;
pub const OP_GL_INK : u32 = 5;
pub const OP_GL_INK_DIM : u32 = 6;
pub const OP_GL_SHADOW : u32 = 7;
pub const OP_GL_SHEEN : u32 = 8;
pub const OP_GL_ROLES : u32 = 9;
pub const OP_GL_DARK : [9]u32 = [0x1C1B1AFF, 0x080808FF, 0xFFFFFF14, 0xFFFFFF2E, 0xFFFFFF29, 0xFFFFFFEB, 0xFFFFFF8C, 0x00000080, 0xFFFFFF0D];
pub const OP_GL_LIGHT : [9]u32 = [0xCBC3BAFF, 0x958C83FF, 0x5A4E4499, 0x9C9087B3, 0xFFFFFF4D, 0xFFFFFFF5, 0xFFFFFFB3, 0x3A2E2540, 0xFFFFFF14];
pub const OP_GL_HC : [9]u32 = [0x000000FF, 0x000000FF, 0x000000FF, 0x333333FF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0x00000000];
; the pane and tile corner radii, in points
pub const OP_GL_R_TILE : u32 = 14;
pub const OP_GL_R_PILL : u32 = 16;

pub fn op_glass(theme: u8, role: u32) -> u32 {
    if role >= OP_GL_ROLES {
        return 0;
    }
    if theme == THEME_LIGHT {
        return OP_GL_LIGHT[role];
    }
    if theme == THEME_HIGH_CONTRAST {
        return OP_GL_HC[role];
    }
    return OP_GL_DARK[role];
}

; one channel (0 red, 1 green, 2 blue, 3 alpha) of an 0xRRGGBBAA word
pub fn op_ch(rgba: u32, ch: u32) -> u32 {
    if ch == 0 {
        return (rgba / 16777216) % 256;
    }
    if ch == 1 {
        return (rgba / 65536) % 256;
    }
    if ch == 2 {
        return (rgba / 256) % 256;
    }
    return rgba % 256;
}

; one channel of the pane laid over the middle of the backdrop ramp (source-over, integer)
pub fn op_gl_ground(theme: u8, ch: u32) -> u32 {
    let back : u32 = (op_ch(op_glass(theme, OP_GL_BACK_TOP), ch) + op_ch(op_glass(theme, OP_GL_BACK_BOT), ch)) / 2;
    let p : u32 = op_glass(theme, OP_GL_PANE);
    let a : u32 = op_ch(p, 3);
    return (op_ch(p, ch) * a + back * (255 - a)) / 255;
}

; W3C AERT brightness of a ground or an opaque ink, 0..255
pub fn op_gl_bright_ground(theme: u8) -> u32 {
    return (299 * op_gl_ground(theme, 0) + 587 * op_gl_ground(theme, 1) + 114 * op_gl_ground(theme, 2)) / 1000;
}

pub fn op_gl_bright_ink(theme: u8) -> u32 {
    let k : u32 = op_glass(theme, OP_GL_INK);
    return (299 * op_ch(k, 0) + 587 * op_ch(k, 1) + 114 * op_ch(k, 2)) / 1000;
}

; the Home petals (owner 2026-11-14: "black and white, absolute"): pure white #FFFFFF on Dark, pure black
; #000000 on Light, each with a hairline in the opposite colour; the hot petal (hovered or open) is one step
; toward the backdrop. High contrast is black with a white line. Roles: fill, hot fill, line (0xRRGGBBAA)
pub const OP_PT_FILL : u32 = 0;
pub const OP_PT_FILL_HOT : u32 = 1;
pub const OP_PT_LINE : u32 = 2;
pub const OP_PT_ROLES : u32 = 3;
pub const OP_PT_DARK : [3]u32 = [0xFFFFFFFF, 0xE6E6E6FF, 0x000000FF];
pub const OP_PT_LIGHT : [3]u32 = [0x000000FF, 0x1A1A1AFF, 0xFFFFFFFF];
pub const OP_PT_HC : [3]u32 = [0x000000FF, 0x333333FF, 0xFFFFFFFF];

pub fn op_petal(theme: u8, role: u32) -> u32 {
    if role >= OP_PT_ROLES {
        return 0;
    }
    if theme == THEME_LIGHT {
        return OP_PT_LIGHT[role];
    }
    if theme == THEME_HIGH_CONTRAST {
        return OP_PT_HC[role];
    }
    return OP_PT_DARK[role];
}

; tests
test glass_backdrop_is_opaque_and_panes_are_frosted {
    let ts : [2]u8 = [THEME_DARK, THEME_LIGHT];
    var i : u32 = 0;
    while i < 2 {
        let t : u8 = ts[i];
        assert op_ch(op_glass(t, OP_GL_BACK_TOP), 3) == 255;
        assert op_ch(op_glass(t, OP_GL_BACK_BOT), 3) == 255;
        assert op_ch(op_glass(t, OP_GL_PANE), 3) > 0;
        assert op_ch(op_glass(t, OP_GL_PANE), 3) < 255;
        assert op_ch(op_glass(t, OP_GL_PANE_HOT), 3) > op_ch(op_glass(t, OP_GL_PANE), 3);
        i = i + 1;
    }
    assert op_glass(THEME_DARK, OP_GL_ROLES) == 0;
}

test dark_glass_is_matte_black_and_light_glass_is_warm {
    // matte black: the ramp stays under 32 of 255 on every channel and the pane frost under 0.1
    assert op_ch(op_glass(THEME_DARK, OP_GL_BACK_TOP), 0) < 32;
    assert op_ch(op_glass(THEME_DARK, OP_GL_PANE), 3) < 26;
    // warm: red over blue on the light ramp and the light pane
    assert op_ch(op_glass(THEME_LIGHT, OP_GL_BACK_TOP), 0) > op_ch(op_glass(THEME_LIGHT, OP_GL_BACK_TOP), 2);
    assert op_ch(op_glass(THEME_LIGHT, OP_GL_PANE), 0) > op_ch(op_glass(THEME_LIGHT, OP_GL_PANE), 2);
}

test ink_on_glass_passes_aert_brightness_in_every_theme {
    let ts : [3]u8 = [THEME_DARK, THEME_LIGHT, THEME_HIGH_CONTRAST];
    var i : u32 = 0;
    while i < 3 {
        assert op_gl_bright_ink(ts[i]) >= op_gl_bright_ground(ts[i]) + 125;
        i = i + 1;
    }
}

test home_theme_follows_the_host_word {
    assert op_theme_of_host(0) == THEME_DARK;
    assert op_theme_of_host(1) == THEME_LIGHT;
    assert op_theme_of_host(2) == THEME_HIGH_CONTRAST;
    assert op_theme_of_host(9) == THEME_DARK;
}

test home_grid_fits_and_every_tile_is_hit_at_its_centre {
    let ws : [3]u32 = [1512, 900, 600];
    var wi : u32 = 0;
    while wi < 3 {
        let w : u32 = ws[wi];
        var i : u32 = 0;
        while i < OP_HOME_CELLS {
            let r : OpRect = op_home_tile_rect(i, w);
            assert r.w > 0;
            assert r.x + r.w + OP_PAD <= w;
            assert op_home_hit(r.x + r.w / 2, r.y + r.h / 2, w) == i;
            i = i + 1;
        }
        let q : OpRect = op_home_queen_rect(w);
        assert op_home_hit(q.x + 1, q.y + 1, w) == OP_HIT_QUEEN;
        assert op_home_hit(1, 1, w) == OP_HIT_NONE;
        wi = wi + 1;
    }
    assert op_home_cols(1512) == 9;
    assert op_home_cols(900) == 6;
    assert op_home_cols(600) == 3;
}

test home_gap_between_tiles_is_not_a_hit {
    let a : OpRect = op_home_tile_rect(0, 1512);
    assert op_home_hit(a.x + a.w + OP_GAP / 2, a.y + 1, 1512) == OP_HIT_NONE;
    assert OP_HIT_QUEEN != OP_HIT_NONE and OP_HIT_QUEEN >= OP_HOME_CELLS;
}

test design_default_is_uikit {
    assert OP_DESIGN_PRESERVED == 0;
    assert op_state_new().design == OP_DESIGN_UIKIT;
    assert op_state_new().theme == THEME_LIGHT;
    assert op_design_ok(0) == true;
    assert op_design_ok(1) == true;
    assert op_design_ok(2) == false;
}

test design_and_theme_round_trips {
    assert op_design_next(OP_DESIGN_PRESERVED) == OP_DESIGN_UIKIT;
    assert op_design_next(OP_DESIGN_UIKIT) == OP_DESIGN_PRESERVED;
    assert op_design_next(op_design_next(OP_DESIGN_PRESERVED)) == OP_DESIGN_PRESERVED;
    assert op_theme_next(THEME_LIGHT) == THEME_DARK;
    assert op_theme_next(THEME_DARK) == THEME_HIGH_CONTRAST;
    assert op_theme_next(THEME_HIGH_CONTRAST) == THEME_LIGHT;
    assert op_theme_next(op_theme_next(op_theme_next(THEME_LIGHT))) == THEME_LIGHT;
    assert op_theme_next(op_theme_next(op_theme_next(THEME_DARK))) == THEME_DARK;
    assert op_theme_next(op_theme_next(op_theme_next(THEME_HIGH_CONTRAST))) == THEME_HIGH_CONTRAST;
}

test design_switch_preserves_state {
    var s : OpState = op_state_new();
    s.lane = 2;
    s.scroll = 340;
    s.open_sec = OP_SEC_LANES;
    s.theme = THEME_DARK;
    let n : OpState = op_switch_design(s, OP_DESIGN_UIKIT);
    assert n.design == OP_DESIGN_UIKIT;
    assert n.theme == THEME_DARK;
    assert n.lane == 2;
    assert n.scroll == 340;
    assert n.open_sec == OP_SEC_LANES;
    let bad : OpState = op_switch_design(s, 9);
    assert bad.design == s.design;
    assert bad.lane == 2;
}

test theme_switch_preserves_state {
    var s : OpState = op_state_new();
    s.lane = 1;
    s.scroll = 70;
    s.design = OP_DESIGN_UIKIT;
    let n : OpState = op_switch_theme(s, THEME_HIGH_CONTRAST);
    assert n.theme == THEME_HIGH_CONTRAST;
    assert n.design == OP_DESIGN_UIKIT;
    assert n.lane == 1;
    assert n.scroll == 70;
    assert n.open_sec == s.open_sec;
    assert op_switch_theme(s, THEME_KINDS).theme == s.theme;
}

test tiles_and_sections_are_named_and_ordered {
    assert OP_TILE_COUNT == 6;
    assert OP_TILE_NAMES[0].len == 8;
    assert OP_TILE_NAMES[1].len == 11;
    assert OP_TILE_NAMES[2].len == 6;
    assert OP_TILE_NAMES[3].len == 4;
    assert OP_TILE_NAMES[4].len == 12;
    assert OP_TILE_NAMES[5].len == 15;
    assert OP_SEC_HEADER < OP_SEC_TILES;
    assert OP_SEC_TILES < OP_SEC_MYCELIUM;
    assert OP_SEC_MYCELIUM < OP_SEC_LANES;
    assert OP_SEC_LANES < OP_SEC_QUEUE;
    assert OP_SEC_COUNT == 5;
}

test every_builder_is_a_valid_kit_graph_under_the_cap {
    let s : OpState = op_state_new();
    var i : u32 = 0;
    while i < OP_TILE_COUNT {
        let c : UiKit = op_tile_card(i);
        assert vf_validate(c.graph) == VF_OK;
        assert kit_node_count(c) <= VF_MAX_NODES;
        assert c.graph.text[1].len == OP_TILE_NAMES[i].len;
        i = i + 1;
    }
    assert vf_validate(op_tile_badge(true).graph) == VF_OK;
    assert vf_validate(op_tile_badge(false).graph) == VF_OK;
    assert op_tile_badge(true).graph.text[0].len == OP_LABEL_ON.len;
    assert op_tile_badge(false).graph.text[0].len == OP_LABEL_OFF.len;
    assert op_header_design_button().graph.text[1].len == OP_LABEL_DESIGN.len;
    assert op_header_theme_button().graph.text[1].len == OP_LABEL_THEME.len;
    assert vf_validate(op_header_design_button().graph) == VF_OK;
    assert vf_validate(op_header_theme_button().graph) == VF_OK;
    assert vf_validate(op_header_title().graph) == VF_OK;
    var sec : u32 = 0;
    while sec < OP_SEC_COUNT {
        let k : UiKit = op_section_graph(sec, s);
        assert vf_validate(k.graph) == VF_OK;
        assert kit_node_count(k) >= 1;
        assert kit_node_count(k) <= VF_MAX_NODES;
        sec = sec + 1;
    }
    assert kit_node_count(op_lanes_table()) == 13;
}

test tile_columns_follow_the_breakpoints {
    assert op_cols(1400) == 4;
    assert op_cols(1100) == 4;
    assert op_cols(1099) == 3;
    assert op_cols(800) == 3;
    assert op_cols(799) == 2;
    assert op_cols(520) == 2;
    assert op_cols(519) == 1;
    assert op_cols(480) == 1;
    assert op_tile_rows(1400) == 2;
    assert op_tile_rows(900) == 2;
    assert op_tile_rows(600) == 3;
    assert op_tile_rows(480) == 6;
}

test every_tile_fits_the_page_width_and_none_overlap {
    var wi : u32 = 0;
    let ws : [3]u32 = [480, 900, 1400];
    while wi < 3 {
        let w : u32 = ws[wi];
        var i : u32 = 0;
        while i < OP_TILE_COUNT {
            assert op_tile_fits(i, w) == true;
            let a : OpRect = op_tile_rect(i, 0, 0, w);
            assert a.h == OP_TILE_H;
            assert a.y + a.h <= op_tiles_h(w);
            var j : u32 = i + 1;
            while j < OP_TILE_COUNT {
                let b : OpRect = op_tile_rect(j, 0, 0, w);
                let apart : bool = a.x + a.w + OP_GAP <= b.x or b.x + b.w + OP_GAP <= a.x or a.y + a.h + OP_GAP <= b.y or b.y + b.h + OP_GAP <= a.y;
                assert apart == true;
                j = j + 1;
            }
            i = i + 1;
        }
        wi = wi + 1;
    }
}

test every_section_fits_the_page_width_at_three_widths {
    var wi : u32 = 0;
    let ws : [3]u32 = [480, 900, 1400];
    while wi < 3 {
        let w : u32 = ws[wi];
        let h : u32 = 900;
        var s : u32 = 0;
        var prev_end : u32 = 0;
        while s < OP_SEC_COUNT {
            assert op_section_fits(s, w, h) == true;
            let r : OpRect = op_section_rect(s, w, h);
            assert r.h > 0;
            assert r.y == prev_end;
            prev_end = r.y + r.h;
            s = s + 1;
        }
        assert op_page_h(w, h) == prev_end;
        wi = wi + 1;
    }
}

test the_queue_takes_the_rest_but_never_less_than_its_minimum {
    assert op_section_h(OP_SEC_QUEUE, 1400, 200) == OP_QUEUE_MIN_H;
    assert op_section_h(OP_SEC_QUEUE, 1400, 2000) > OP_QUEUE_MIN_H;
    assert op_section_y(OP_SEC_HEADER, 900, 900) == 0;
    assert op_section_y(OP_SEC_TILES, 900, 900) == OP_HEADER_H;
}

test the_inside_of_each_section_fits_its_box_at_three_widths {
    let s : OpState = op_state_new();
    let ws : [3]u32 = [480, 900, 1400];
    var wi : u32 = 0;
    while wi < 3 {
        var sec : u32 = 0;
        while sec < OP_SEC_COUNT {
            let l : VfLayout = op_section_layout(sec, s, ws[wi], 900);
            assert l.node_count >= 1;
            assert op_section_inside_fits(sec, s, ws[wi], 900) == true;
            sec = sec + 1;
        }
        wi = wi + 1;
    }
}

test a_theme_switch_leaves_every_rect_equal {
    let s : OpState = op_state_new();
    let ws : [3]u32 = [480, 900, 1400];
    var wi : u32 = 0;
    while wi < 3 {
        let w : u32 = ws[wi];
        var sec : u32 = 0;
        while sec < OP_SEC_COUNT {
            let a : VfLayout = op_section_layout(sec, s, w, 900);
            let t1 : OpState = op_switch_theme(s, THEME_DARK);
            let t2 : OpState = op_switch_theme(s, THEME_HIGH_CONTRAST);
            assert vf_layout_equal(a, op_section_layout(sec, t1, w, 900)) == true;
            assert vf_layout_equal(a, op_section_layout(sec, t2, w, 900)) == true;
            let d1 : OpState = op_switch_design(s, OP_DESIGN_UIKIT);
            assert vf_layout_equal(a, op_section_layout(sec, d1, w, 900)) == true;
            sec = sec + 1;
        }
        wi = wi + 1;
    }
}

test colours_delegate_and_themes_differ {
    assert op_color(THEME_LIGHT, TH_BG) == th_color(TH_PAPER, TH_BG);
    assert op_color(THEME_DARK, TH_BG) == th_color(TH_T27, TH_BG);
    assert op_color(THEME_HIGH_CONTRAST, TH_TEXT) == th_color(TH_T27, TH_TEXT);
    assert op_color(THEME_LIGHT, TH_BG) != op_color(THEME_DARK, TH_BG);
    assert op_fill(THEME_LIGHT, VF_BADGE) != op_fill(THEME_DARK, VF_BADGE);
    assert op_theme_table(THEME_LIGHT) == TH_PAPER;
}

test label_on_fill_passes_aert_for_dark_and_high_contrast {
    assert op_label_ok(THEME_DARK, VF_TEXT) == true;
    assert op_label_ok(THEME_DARK, VF_BUTTON) == true;
    assert op_label_ok(THEME_DARK, VF_BADGE) == true;
    assert op_label_ok(THEME_HIGH_CONTRAST, VF_TEXT) == true;
    assert op_label_ok(THEME_HIGH_CONTRAST, VF_BUTTON) == true;
    assert op_label_ok(THEME_HIGH_CONTRAST, VF_BADGE) == true;
}

test light_aert_finding_is_recorded_not_hidden {
    // vf_theme already records this: white on the light button 0x1565C0 fails AERT colour difference (451 < 500); the DESIGN and THEME buttons carry that label in light
    assert op_label_ok(THEME_LIGHT, VF_TEXT) == true;
    assert op_label_ok(THEME_LIGHT, VF_BADGE) == true;
    assert op_label_ok(THEME_LIGHT, VF_BUTTON) == false;
}

test home_petals_are_absolute_black_and_white {
    // Dark: pure white petals with a pure black line; Light: pure black petals with a pure white line
    assert op_petal(THEME_DARK, OP_PT_FILL) == 0xFFFFFFFF;
    assert op_petal(THEME_DARK, OP_PT_LINE) == 0x000000FF;
    assert op_petal(THEME_LIGHT, OP_PT_FILL) == 0x000000FF;
    assert op_petal(THEME_LIGHT, OP_PT_LINE) == 0xFFFFFFFF;
    assert op_petal(THEME_DARK, OP_PT_ROLES) == 0;
}

test home_petals_are_opaque_and_the_line_is_the_opposite_colour {
    let ts : [3]u8 = [THEME_DARK, THEME_LIGHT, THEME_HIGH_CONTRAST];
    var i : u32 = 0;
    while i < 3 {
        let t : u8 = ts[i];
        assert op_ch(op_petal(t, OP_PT_FILL), 3) == 255;
        assert op_ch(op_petal(t, OP_PT_FILL_HOT), 3) == 255;
        assert op_ch(op_petal(t, OP_PT_LINE), 3) == 255;
        // fill and line sit at the two ends of the grey scale
        assert op_ch(op_petal(t, OP_PT_FILL), 0) + op_ch(op_petal(t, OP_PT_LINE), 0) == 255;
        // the hot fill differs from the idle fill
        assert op_ch(op_petal(t, OP_PT_FILL_HOT), 0) != op_ch(op_petal(t, OP_PT_FILL), 0);
        i = i + 1;
    }
}
