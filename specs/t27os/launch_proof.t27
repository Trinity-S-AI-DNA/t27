// SPDX-License-Identifier: Apache-2.0
// launch_proof.t27 -- minimal real-launch proof: a .t27 spec, compiled by t27b --macho and linked
// against libSystem, that (a) admits the registered program /bin/echo, (b) really starts it as an
// OS process via posix_spawn, (c) observes its real output on the inherited stdout and its exit via
// waitpid on the exact spawned pid, and (d) refuses an unregistered program before reaching a spawn.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27osLaunchProof;

// put_bytes and put_dec are session_store.t27's; reused here, not written again (dupe ratchet).
use t27os::session_store::put_bytes;
use t27os::session_store::put_dec;

// libSystem imports, inline (same signatures as specs/t27os/pty_sys.t27 in the working tree).
fn sys_addr(dst: []u8, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }
fn sys_peek(dst: []u8, src: u64, n: u64) -> u64 { return @extern("memmove"); }
fn sys_spawn(pid: [2]u32, path: []const u8, fa: u64, attr: u64, argv: [8]u64, envp: u64) -> i32 { return @extern("posix_spawn"); }
fn sys_waitpid(pid: i32, status: [2]u32, opts: i32) -> i32 { return @extern("waitpid"); }
fn sys_exit(code: i32) -> void { @extern("_exit"); }
fn sys_write(fd: i32, b: []const u8, n: u64) -> i64 { return @extern("write"); }
fn sys_getenv(name: []const u8) -> u64 { return @extern("getenv"); }
fn sys_strlen(p: u64) -> u64 { return @extern("strlen"); }

// Admission: the only registered program is /bin/echo. Anything else is denied.
fn admit(path: []const u8, n: usize) -> bool {
    if (n != 9) { return false; }
    const want : []const u8 = "/bin/echo";
    var i : usize = 0;
    while (i < 9) {
        if (path[i] != want[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn main() -> void {
    // the program under test comes from the environment; absent is a refusal
    const p : u64 = sys_getenv("T27OS_TARGET");
    if (p == 0) { sys_exit(1); }
    const plen : u64 = sys_strlen(p);
    if (plen >= 64) { sys_exit(1); }
    var path : [64]u8 = undefined;
    _ = sys_peek(path[0..64], p, plen);
    const n : usize = @as(usize, @intCast(plen));
    path[n] = 0;

    // admission gate: an unregistered program is refused before any spawn
    if (admit(path[0..64], n) == false) {
        var msg : [8]u8 = undefined;
        const mn : usize = put_bytes(msg[0..8], 0, "DENIED\n");
        _ = sys_write(2, msg[0..8], @as(u64, @intCast(mn)));
        sys_exit(7);
    }

    // build argv: [0] = program path, [1] = the argument, rest NULL
    var buf : [256]u8 = undefined;
    var a0 : usize = put_bytes(buf[0..256], 0, path[0..n]);
    buf[a0] = 0;
    const p0 : u64 = sys_addr(buf[0..256], buf[0..256], 0);
    var a1 : usize = put_bytes(buf[0..256], a0 + 1, "T27-REAL-LAUNCH-PROOF");
    buf[a1] = 0;
    const p1 : u64 = sys_addr(buf[a0 + 1 .. 256], buf[a0 + 1 .. 256], 0);

    var pid : [2]u32 = undefined;
    pid[0] = 0;
    pid[1] = 0;
    var argv : [8]u64 = undefined;
    argv[0] = p0;
    argv[1] = p1;
    argv[2] = 0;
    argv[3] = 0;
    argv[4] = 0;
    argv[5] = 0;
    argv[6] = 0;
    argv[7] = 0;

    // the real launch: posix_spawn, stdout/stderr inherited so the child's output is observed
    const rc : i32 = sys_spawn(pid, buf[0..256], 0, 0, argv, 0);
    if (rc != 0) { sys_exit(2); }

    // evidence of the real pid on stderr, then wait on exactly that pid
    var ev : [32]u8 = undefined;
    var en : usize = put_bytes(ev[0..32], 0, "SPAWNED pid=");
    en = put_dec(ev[0..32], en, @as(u64, @intCast(pid[0])));
    ev[en] = 10;
    en = en + 1;
    _ = sys_write(2, ev[0..32], @as(u64, @intCast(en)));

    var ws : [2]u32 = undefined;
    ws[0] = 0;
    ws[1] = 0;
    const w : i32 = sys_waitpid(@as(i32, @intCast(pid[0])), ws, 0);
    if (w < 0) { sys_exit(3); }
    if (w != @as(i32, @intCast(pid[0]))) { sys_exit(4); }
    sys_exit(0);
}

test the_admission_allowlist {
    var ok : [9]u8 = undefined;
    _ = put_bytes(ok[0..9], 0, "/bin/echo");
    assert(admit(ok[0..9], 9));
    var bad : [11]u8 = undefined;
    _ = put_bytes(bad[0..11], 0, "/usr/bin/wc");
    assert(admit(bad[0..11], 11) == false);
}
