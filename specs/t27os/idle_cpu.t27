// SPDX-License-Identifier: Apache-2.0
// specs/t27os/idle_cpu.t27 -- T27 OS: idle CPU 19% with a page open -- find and
// remove the busy redraw.
// Part of M10 milestone (milestone #14). Closes #11419.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::idle_cpu;

pub const IDLE_CPU_MAX_PCT : u32 = 10;

pub struct CpuState { cpu_pct: u32, page_open: bool };

pub fn idle_cpu_ok(c: CpuState) -> bool {
    return c.cpu_pct <= IDLE_CPU_MAX_PCT || !c.page_open;
}

test "idle_cpu_ok" {
    assert(idle_cpu_ok(CpuState { cpu_pct: 5, page_open: true }));
    assert(!idle_cpu_ok(CpuState { cpu_pct: 19, page_open: true }));
    assert(idle_cpu_ok(CpuState { cpu_pct: 50, page_open: false }));
}

invariant idle_cpu_max_pct_positive {
    assert IDLE_CPU_MAX_PCT > 0;
}