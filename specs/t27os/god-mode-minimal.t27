; Owner, 2026-10-21: Minimal version that compiles with T27
; φ^2 + 1/φ² = 3 | TRINITY

module T27osGodModeMinimal;

/// GOD MODE state constants
pub const GOD_MODE_OFF : u32 = 0;
pub const GOD_MODE_ON : u32 = 1;
pub const GOD_MODE_PENDING : u32 = 2;

/// Convert boolean to GodModeState for backward compatibility
pub fn from_bool(value: bool) -> u32 {
    if (value) { return GOD_MODE_ON; }
    return GOD_MODE_OFF;
}

/// Convert GodModeState to boolean for legacy components
pub fn to_bool(state: u32) -> bool {
    return state == GOD_MODE_ON;
}

/// Get the display text for the current state
pub fn display_text(state: u32) -> str {
    if (state == GOD_MODE_OFF) {
        return "GOD MODE OFF";
    } else if (state == GOD_MODE_ON) {
        return "GOD MODE ON";
    } else {
        return "GOD MODE...";
    }
}

/// Edge glow colors based on state
pub const GLOW_OFF_R : f64 = 0.0;
pub const GLOW_OFF_G : f64 = 0.0;
pub const GLOW_OFF_B : f64 = 0.0;
pub const GLOW_ON_R : f64 = 0.22;
pub const GLOW_ON_G : f64 = 0.10;
pub const GLOW_ON_B : f64 = 0.80;

/// Check if a state transition is allowed
pub fn can_transition(from: u32, to: u32) -> bool {
    // Allow all valid transitions
    if (from == GOD_MODE_OFF) {
        return to == GOD_MODE_ON or to == GOD_MODE_PENDING;
    } else if (from == GOD_MODE_ON) {
        return to == GOD_MODE_OFF or to == GOD_MODE_PENDING;
    } else if (from == GOD_MODE_PENDING) {
        return to == GOD_MODE_ON or to == GOD_MODE_OFF;
    }
    return false;
}

/// Calculate glow intensity for a given state and progress
pub fn glow_intensity(state: u32, progress: f64) -> f64 {
    if (state == GOD_MODE_OFF) {
        return 0.0 * progress;
    } else if (state == GOD_MODE_ON) {
        return 1.0 * progress;
    } else { // GOD_MODE_PENDING
        // Simple pulsing effect
        const pulse : f64 = @sin(progress * 360 * 3.14159 / 180);
        return 0.5 + 0.5 * pulse;
    }
}

/// Process a GOD MODE toggle event
pub fn toggle_state(current: u32) -> u32 {
    if (current == GOD_MODE_OFF) return GOD_MODE_ON;
    if (current == GOD_MODE_ON) return GOD_MODE_OFF;
    return current; // PENDING stays PENDING
}

// Basic tests
test god_mode_state_conversion {
    // Boolean conversion
    assert from_bool(true) == GOD_MODE_ON;
    assert from_bool(false) == GOD_MODE_OFF;
    assert to_bool(GOD_MODE_ON) == true;
    assert to_bool(GOD_MODE_OFF) == false;
    assert to_bool(GOD_MODE_PENDING) == false;

    // Display text
    assert display_text(GOD_MODE_OFF) == "GOD MODE OFF";
    assert display_text(GOD_MODE_ON) == "GOD MODE ON";
    assert display_text(GOD_MODE_PENDING) == "GOD MODE...";
}

test transition_validity {
    // Valid transitions
    assert can_transition(GOD_MODE_OFF, GOD_MODE_ON) == true;
    assert can_transition(GOD_MODE_OFF, GOD_MODE_PENDING) == true;
    assert can_transition(GOD_MODE_ON, GOD_MODE_OFF) == true;
    assert can_transition(GOD_MODE_ON, GOD_MODE_PENDING) == true;
    assert can_transition(GOD_MODE_PENDING, GOD_MODE_ON) == true;
    assert can_transition(GOD_MODE_PENDING, GOD_MODE_OFF) == true;

    // Invalid transitions
    assert can_transition(GOD_MODE_OFF, GOD_MODE_OFF) == false;
    assert can_transition(GOD_MODE_ON, GOD_MODE_ON) == false;
}

test toggle_function {
    // Toggle functionality
    assert toggle_state(GOD_MODE_OFF) == GOD_MODE_ON;
    assert toggle_state(GOD_MODE_ON) == GOD_MODE_OFF;
    assert toggle_state(GOD_MODE_PENDING) == GOD_MODE_PENDING;
}

test glow_intensity_calculation {
    // Off state has no glow
    assert glow_intensity(GOD_MODE_OFF, 0.5) == 0.0;

    // On state has full glow
    assert glow_intensity(GOD_MODE_ON, 1.0) == 1.0;

    // Pending state has pulsing glow (different values at different progress)
    const intensity1 : f64 = glow_intensity(GOD_MODE_PENDING, 0.0);
    const intensity2 : f64 = glow_intensity(GOD_MODE_PENDING, 0.5);
    assert intensity1 != intensity2; // Should pulse
}