// SPDX-License-Identifier: Apache-2.0
; specs/t27os/orbit_view.t27 -- the formula orbit around the home logo of T27 OS: what the window shows and when
; Brand visual (AGENTS.md, owner 2026-10-20): the 32 VERIFIED formulas of formula_table.t27 drift on a golden spiral
; around the home logo (placement, drift, pointer push, hit test: formula_orbit.t27, used and not copied). This file is
; the thin decision layer between those four calls and the window: the cache key of the layout (recomputed only when
; the stage or the logo changes), the logo's keep-out radius from its size, the clock step (reduced motion freezes it,
; a stalled frame does not jump it), the label and card TEXT (name, value, signed error, expression, sector), and the
; alpha rule. Pure integers and bytes, tested; the window only draws what these functions answer. ASCII only (L3).
; --
; Labels are white text on a matte glass chip, drawn only where the layout put them: the layout keeps every slot off the
; keep-out circle (the logo's bounding circle grown 8 percent), so a label is never over the logo or a petal, whatever
; the clock and the pointer do (formula_orbit.t27 proves it by bounds; the test here sweeps it again with this file's
; radius). How many of the 32 fit depends on the stage: a small window shows fewer, a large one or full screen all 32
; (the rule is formula_orbit's PAD; this file never squeezes it).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osOrbitView;

use t27os::lanes_view::lv_put;
use t27os::lanes_view::lv_put_str;
use t27f::formula_orbit::layout;
use t27f::formula_orbit::item_x;
use t27f::formula_orbit::item_y;
use t27f::formula_orbit::clears_circle;
use t27f::formula_orbit::LABEL_W;
use t27f::formula_orbit::LABEL_H;
use t27f::formula_orbit::KEEP_PERMILLE;
use t27f::formula_orbit::isqrt;
use t27f::formula_orbit::sin_pm;
use t27f::formula_orbit::cos_pm;
use t27f::formula_orbit::GOLDEN_MDEG;
use t27f::formula_table::FORMULA_COUNT;
use t27f::formula_table::FORMULA_TEXT;
use t27f::formula_table::formula_field_start;
use t27f::formula_table::formula_field_len;
use t27f::formula_table::err_milli_pct;
use t27f::formula_table::ROW_COUNT;
use t27f::formula_table::TAG_VERIFIED;
use t27f::formula_table::TAG_CANDIDATE;
use t27f::formula_table::CLOSE_MILLI_PCT;
use t27f::formula_table::tag_of;
use t27f::formula_table::repro_milli_pct;

pub const OV_MAX : usize = 32;
/// A frame that took longer than this is clamped (the window was asleep or dragged), so the labels never jump.
pub const OV_DT_CAP_MS : i64 = 100;
pub const OV_NONE : i64 = 0 - 1;

/// The pinned agents of the formula widgets (owner first): P Physics / SacredPhysics owns the formulas, N Numeric / GoldenFloat
/// owns the numbers they are checked in, F Formal Conformance owns the verification that admits a row.
pub const OV_AGENTS : [3]u32 = [16, 14, 6];
pub const OV_WHY : str = "P owns the formulas; N owns the GoldenFloat numbers they are computed in; F owns the conformance that admits a VERIFIED row";
/// The owner's agent id: slot 0 of OV_AGENTS (OV_WHY: P owns the formulas).
pub const OV_AGENT_OWNER : u32 = 16;
/// The largest agent id a widget may pin.
pub const OV_AGENT_MAX : u32 = 27;

/// True when a pinned agent list is owner-first and clean: the owner sits in slot 0, no agent is
/// pinned twice, and every id is a live agent slot (1..OV_AGENT_MAX).
pub fn ov_agents_ok(a : []const u32, owner : u32) -> bool {
    if (a.len == 0) { return false; }
    if (a[0] != owner) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] < 1 or a[i] > OV_AGENT_MAX) { return false; }
        var j : usize = i + 1;
        while (j < a.len) {
            if (a[i] == a[j]) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

pub const OF_NAME : u32 = 0;
pub const OF_EXPR : u32 = 1;
pub const OF_VALUE : u32 = 2;
pub const OF_SECTOR : u32 = 3;

/// The radius of the circle around the logo: half the diagonal of the box that holds it, in points.
pub fn ov_logo_r(logo_w: i64, logo_h: i64) -> i64 {
    return isqrt((logo_w / 2) * (logo_w / 2) + (logo_h / 2) * (logo_h / 2));
}

/// The layout depends on the stage and the logo only: this key changes exactly when it must be recomputed.
pub fn ov_key(sw: i64, sh: i64, r: i64) -> u64 {
    return (sw as u64) * 1000000000 + (sh as u64) * 10000 + (r as u64);
}

/// Advance the clock by dt_ms at scale permille of real time. Reduced motion never moves it; dt is clamped to
/// [0, OV_DT_CAP_MS], so a stall or a clock that went back does not jump the labels.
pub fn ov_clock_step(clock: i64, dt_ms: i64, scale_permille: i64, reduce: bool) -> i64 {
    if (reduce) { return clock; }
    var dt : i64 = dt_ms;
    if (dt < 0) { dt = 0; }
    if (dt > OV_DT_CAP_MS) { dt = OV_DT_CAP_MS; }
    return clock + dt * scale_permille / 1000;
}

/// Is the orbit drawn at all? Only while the home logo is on screen (alpha of the home layer above zero).
pub fn ov_visible(home_alpha_permille: i64) -> bool { return home_alpha_permille > 0; }

/// Does the orbit need a redraw every frame? Not when the motion is reduced or nothing is placed.
pub fn ov_animates(visible: bool, reduce: bool, placed: usize) -> bool {
    return visible and reduce == false and placed > 0;
}

// ---- which rows the orbit may show, and how bright (owner 2026-10-21: VERIFIED and candidate rows, |err| <= 1 percent, candidates a little dimmer) ----
// formula_table.t27 now holds every close hit (ROW_COUNT rows) with a TAG and the error recomputed against the cited measured value. The rule is here;
// the window still draws the first FORMULA_COUNT = OV_MAX = 32 rows (glass_window.t27 sizes its arrays by 32), so wiring the rule into the draw loop and
// raising that cap is the next step. Conjectures never show; a row whose recomputed error is beyond 1 percent never shows, whatever its tag says.
pub const OV_ALPHA_VERIFIED : i64 = 1000;
pub const OV_ALPHA_CANDIDATE : i64 = 720;

/// The alpha (permille) of a row from its tag and its recomputed error in thousandths of a percent; 0 = not shown.
pub fn ov_row_alpha_permille(tag: u32, repro_milli: i64) -> i64 {
    var m : i64 = repro_milli;
    if (m < 0) { m = 0 - m; }
    if (m > CLOSE_MILLI_PCT) { return 0; }
    if (tag == TAG_VERIFIED) { return OV_ALPHA_VERIFIED; }
    if (tag == TAG_CANDIDATE) { return OV_ALPHA_CANDIDATE; }
    return 0;
}

/// The alpha of row i of the table (0 = hidden).
pub fn ov_row_alpha(i: u32) -> i64 {
    if (i >= ROW_COUNT) { return 0; }
    return ov_row_alpha_permille(tag_of(i), repro_milli_pct(i));
}

/// Field f (OF_*) of formula i copied into out; the length.
pub fn ov_field(i: u32, f: u32, out: []u8) -> usize {
    if (i >= FORMULA_COUNT) { return 0; }
    const st : usize = @as(usize, formula_field_start(i, f));
    const ln : usize = @as(usize, formula_field_len(i, f));
    var w : usize = 0;
    while (w < ln) {
        w = lv_put(out, w, @as(u8, FORMULA_TEXT[st + w]));
    }
    return w;
}

/// The signed error in percent from thousandths of a percent: "-0.620%", "+0.029%", "0.000%".
pub fn ov_err_text(milli: i64, out: []u8) -> usize {
    var w : usize = 0;
    var m : i64 = milli;
    if (m < 0) { w = lv_put(out, w, 45); m = 0 - m; } else if (m > 0) { w = lv_put(out, w, 43); }
    const whole : i64 = m / 1000;
    const frac : i64 = m % 1000;
    var d : [12]u8 = undefined;
    var n : usize = 0;
    var q : i64 = whole;
    if (q == 0) { d[0] = 48; n = 1; }
    while (q > 0) { d[n] = @as(u8, @intCast(48 + q % 10)); q = q / 10; n = n + 1; }
    var i : usize = 0;
    while (i < n) { w = lv_put(out, w, d[n - 1 - i]); i = i + 1; }
    w = lv_put(out, w, 46);
    w = lv_put(out, w, @as(u8, @intCast(48 + frac / 100)));
    w = lv_put(out, w, @as(u8, @intCast(48 + frac / 10 % 10)));
    w = lv_put(out, w, @as(u8, @intCast(48 + frac % 10)));
    return lv_put(out, w, 37);
}

/// The second line of a label: the value, two spaces, the signed error.
pub fn ov_value_line(i: u32, out: []u8) -> usize {
    var w : usize = ov_field(i, OF_VALUE, out);
    w = lv_put(out, w, 32);
    w = lv_put(out, w, 32);
    var e : [16]u8 = undefined;
    const en : usize = ov_err_text(err_milli_pct(i), e[0..16]);
    var k : usize = 0;
    while (k < en) { w = lv_put(out, w, e[k]); k = k + 1; }
    return w;
}

/// The card's body lines for formula i, one per call: 0 expression, 1 value and error, 2 sector.
pub fn ov_card_line(i: u32, line: u32, out: []u8) -> usize {
    if (line == 0) { return ov_label(i, out); }
    if (line == 1) { return ov_value_line(i, out); }
    return ov_field(i, OF_SECTOR, out);
}


// ---- the rotating ring layout (owner, 2026-10-20: only the formulas are visible and they turn CLOCKWISE) ----
// formula_orbit.t27 places labels on a golden spiral and lets them drift: good for a still field, but a RIGID rotation of
// those slots would let labels overlap or leave the stage. So the motion lives here: labels sit on concentric ELLIPSES
// around the logo (the stage's own shape) and every label turns on its ellipse by the same angle theta. A candidate slot
// is accepted only when, for EVERY phase of the turn (72 steps of 5 degrees), it clears the logo's keep-out circle and
// keeps its distance to every slot already accepted. Nothing can overlap, leave the stage or touch the logo at any time.
// Screen y points DOWN, so an angle that grows from +x towards +y is clockwise on screen: theta grows with the clock.
pub const OV_W : i64 = 160;
pub const OV_H : i64 = 22;
pub const OV_GAPX : i64 = 20;
pub const OV_GAPY : i64 = 14;
pub const OV_MARGIN : i64 = 10;
pub const OV_KEEP_PAD : i64 = 6;
pub const OV_STEP : i64 = 40;
pub const OV_RINGS : i64 = 8;
pub const OV_CAND : i64 = 24;
pub const OV_PHASE_MDEG : i64 = 5000;
/// One turn in 4 minutes: 1.5 degrees a second, in milli-degrees per second of (pointer-slowed) clock.
pub const OV_OMEGA_MDEG_PER_S : i64 = 1500;

fn ov_abs(v: i64) -> i64 {
    if (v < 0) { return 0 - v; }
    return v;
}

/// The turn angle in milli-degrees at a clock in ms; 0 for reduced motion. Positive = clockwise on screen.
pub fn ov_theta(clock_ms: i64, reduce: bool) -> i64 {
    if (reduce) { return 0; }
    return clock_ms * OV_OMEGA_MDEG_PER_S / 1000;
}

pub fn ov_pos_x(cx: i64, a: i64, phi: i64, theta: i64) -> i64 { return cx + a * cos_pm(phi + theta) / 1000; }
pub fn ov_pos_y(cy: i64, b: i64, phi: i64, theta: i64) -> i64 { return cy + b * sin_pm(phi + theta) / 1000; }

/// Two labels are apart when they clear each other on x or on y by the gaps.
pub fn ov_apart(x1: i64, y1: i64, x2: i64, y2: i64) -> bool {
    return ov_abs(x1 - x2) >= OV_W + OV_GAPX or ov_abs(y1 - y2) >= OV_H + OV_GAPY;
}

/// The label rectangle (grown by OV_KEEP_PAD) stays outside the circle of radius keep around (cx, cy).
pub fn ov_clear(x: i64, y: i64, cx: i64, cy: i64, keep: i64) -> bool {
    var dx : i64 = ov_abs(x - cx) - (OV_W / 2 + OV_KEEP_PAD);
    var dy : i64 = ov_abs(y - cy) - (OV_H / 2 + OV_KEEP_PAD);
    if (dx < 0) { dx = 0; }
    if (dy < 0) { dy = 0; }
    return dx * dx + dy * dy >= keep * keep;
}

fn ov_ring_clear(cx: i64, cy: i64, a: i64, b: i64, keep: i64) -> bool {
    var s : i64 = 0;
    while (s < 360000) {
        if (ov_clear(ov_pos_x(cx, a, s, 0), ov_pos_y(cy, b, s, 0), cx, cy, keep) == false) { return false; }
        s = s + OV_PHASE_MDEG;
    }
    return true;
}

fn ov_slot_ok(cx: i64, cy: i64, a: i64, b: i64, phi: i64, ra: []const i64, rb: []const i64, rp: []const i64, found: usize) -> bool {
    var m : usize = 0;
    while (m < found) {
        var s : i64 = 0;
        while (s < 360000) {
            if (ov_apart(ov_pos_x(cx, a, phi + s, 0), ov_pos_y(cy, b, phi + s, 0), ov_pos_x(cx, ra[m], rp[m] + s, 0), ov_pos_y(cy, rb[m], rp[m] + s, 0)) == false) { return false; }
            s = s + OV_PHASE_MDEG;
        }
        m = m + 1;
    }
    return true;
}

/// Fill ra, rb (semi-axes) and rp (start angle, milli-degrees) with up to nmax slots on concentric ellipses around
/// (cx, cy) in a stage sw x sh, outside the keep-out circle; the count. Outer ellipse first.
pub fn ov_layout(cx: i64, cy: i64, sw: i64, sh: i64, keep: i64, nmax: usize, ra: []i64, rb: []i64, rp: []i64) -> usize {
    const a_max : i64 = sw / 2 - OV_W / 2 - OV_MARGIN;
    const b_max : i64 = sh / 2 - OV_H / 2 - OV_MARGIN;
    var found : usize = 0;
    if (a_max <= 0 or b_max <= 0) { return 0; }
    var j : i64 = 0;
    var go : bool = true;
    while (j < OV_RINGS and go and found < nmax) {
        const b : i64 = b_max - j * OV_STEP;
        const a : i64 = a_max - j * OV_STEP * a_max / b_max;
        if (b <= 0 or a <= 0 or ov_ring_clear(cx, cy, a, b, keep) == false) {
            go = false;
        } else {
            var k : i64 = 0;
            while (k < OV_CAND and found < nmax) {
                const phi : i64 = (k * 360000 / OV_CAND + j * GOLDEN_MDEG) % 360000;
                if (ov_slot_ok(cx, cy, a, b, phi, ra, rb, rp, found)) {
                    ra[found] = a;
                    rb[found] = b;
                    rp[found] = phi;
                    found = found + 1;
                }
                k = k + 1;
            }
        }
        j = j + 1;
    }
    return found;
}

/// The formula under the pointer (index) at turn theta, or -1: the label rectangle OV_W x OV_H centred on the label.
pub fn ov_hit(cx: i64, cy: i64, ra: []const i64, rb: []const i64, rp: []const i64, n: usize, theta: i64, px: i64, py: i64) -> i64 {
    var i : usize = 0;
    while (i < n) {
        if (ov_abs(px - ov_pos_x(cx, ra[i], rp[i], theta)) <= OV_W / 2 and ov_abs(py - ov_pos_y(cy, rb[i], rp[i], theta)) <= OV_H / 2) { return i as i64; }
        i = i + 1;
    }
    return OV_NONE;
}

/// Distance from the pointer to the nearest label centre (for the slow-down near the pointer).
pub fn ov_nearest_gap(cx: i64, cy: i64, ra: []const i64, rb: []const i64, rp: []const i64, n: usize, theta: i64, px: i64, py: i64) -> i64 {
    var best : i64 = 1000000;
    var i : usize = 0;
    while (i < n) {
        const dx : i64 = px - ov_pos_x(cx, ra[i], rp[i], theta);
        const dy : i64 = py - ov_pos_y(cy, rb[i], rp[i], theta);
        const d : i64 = isqrt(dx * dx + dy * dy);
        if (d < best) { best = d; }
        i = i + 1;
    }
    return best;
}

// ---- the formula as written: the registry expression, set for reading ----
// PHI, PI and E become phi, pi and e; "pow(x, y)" becomes x^y (x or y in parentheses when it holds a space); " * " becomes a
// space (juxtaposition) and " / " a slash; a number's ".0" is dropped. Everything else is copied.

fn ov_is_word_byte(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 46;
}

fn ov_all_digits_dot0(s: []const u8, a: usize, b: usize) -> bool {
    if (b - a < 3 or s[b - 1] != 48 or s[b - 2] != 46) { return false; }
    var i : usize = a;
    while (i < b - 2) {
        if (s[i] < 48 or s[i] > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn ov_word(s: []const u8, a: usize, b: usize, out: []u8, w0: usize) -> usize {
    var w : usize = w0;
    if (b - a == 3 and s[a] == 80 and s[a + 1] == 72 and s[a + 2] == 73) { return lv_put_str(out, w, "phi"); }
    if (b - a == 2 and s[a] == 80 and s[a + 1] == 73) { return lv_put_str(out, w, "pi"); }
    if (b - a == 1 and s[a] == 69) { return lv_put(out, w, 101); }
    var e : usize = b;
    if (ov_all_digits_dot0(s, a, b)) { e = b - 2; }
    var i : usize = a;
    while (i < e) { w = lv_put(out, w, s[i]); i = i + 1; }
    return w;
}

fn ov_is3(s: []const u8, i: usize, b: usize, c: u8) -> bool {
    return i + 3 <= b and s[i] == 32 and s[i + 1] == c and s[i + 2] == 32;
}

/// The text of s[a .. b] with no pow( in it.
fn ov_scan_plain(s: []const u8, a: usize, b: usize, out: []u8, w0: usize) -> usize {
    var w : usize = w0;
    var i : usize = a;
    while (i < b) {
        if (ov_is3(s, i, b, 42)) {
            w = lv_put(out, w, 32);
            i = i + 3;
        } else if (ov_is3(s, i, b, 47)) {
            w = lv_put(out, w, 47);
            i = i + 3;
        } else if (ov_is_word_byte(s[i])) {
            var j : usize = i;
            while (j < b and ov_is_word_byte(s[j])) { j = j + 1; }
            w = ov_word(s, i, j, out, w);
            i = j;
        } else {
            w = lv_put(out, w, s[i]);
            i = i + 1;
        }
    }
    return w;
}

fn ov_has_space(s: []const u8, a: usize, b: usize) -> bool {
    var i : usize = a;
    while (i < b) {
        if (s[i] == 32) { return true; }
        i = i + 1;
    }
    return false;
}

fn ov_arg(s: []const u8, a: usize, b: usize, out: []u8, w0: usize) -> usize {
    var w : usize = w0;
    const wrap : bool = ov_has_space(s, a, b);
    if (wrap) { w = lv_put(out, w, 40); }
    w = ov_scan_plain(s, a, b, out, w);
    if (wrap) { w = lv_put(out, w, 41); }
    return w;
}

/// The registry expression as it is read on screen; the length written.
pub fn ov_pretty_expr(s: []const u8, out: []u8) -> usize {
    var w : usize = 0;
    var i : usize = 0;
    var seg : usize = 0;
    while (i < s.len) {
        if (i + 4 <= s.len and s[i] == 112 and s[i + 1] == 111 and s[i + 2] == 119 and s[i + 3] == 40) {
            // pow(x, y): the first top-level comma and its closing parenthesis
            var depth : i64 = 0;
            var c : usize = i + 4;
            while (c < s.len and (s[c] != 44 or depth > 0)) {
                if (s[c] == 40) { depth = depth + 1; }
                if (s[c] == 41) { depth = depth - 1; }
                c = c + 1;
            }
            var p : usize = c + 1;
            depth = 0;
            while (p < s.len and (s[p] != 41 or depth > 0)) {
                if (s[p] == 40) { depth = depth + 1; }
                if (s[p] == 41) { depth = depth - 1; }
                p = p + 1;
            }
            if (c >= s.len or p >= s.len) { return ov_scan_plain(s, seg, s.len, out, w); }
            w = ov_scan_plain(s, seg, i, out, w);
            var y0 : usize = c + 1;
            if (y0 < p and s[y0] == 32) { y0 = y0 + 1; }
            w = ov_arg(s, i + 4, c, out, w);
            w = lv_put(out, w, 94);
            w = ov_arg(s, y0, p, out, w);
            i = p + 1;
            seg = i;
        } else {
            i = i + 1;
        }
    }
    return ov_scan_plain(s, seg, s.len, out, w);
}


// ---- math notation (owner, 2026-10-20: draw phi as the Greek letter) ----
// The registry text stays ASCII (L3 applies to this source too), so the UTF-8 bytes are written from byte values here,
// never as literal non-ASCII characters; the window hands them to CoreText as UTF-8.
//   phi -> CF 86 (U+03C6), pi -> CF 80 (U+03C0), a product space -> C2 B7 (U+00B7, the middle dot),
//   ^ followed by an optional - and digits -> superscripts: 0 E2 81 B0, 1 C2 B9, 2 C2 B2, 3 C2 B3, 4..9 E2 81 B4..B9, minus E2 81 BB.
pub const OV_PHI_B0 : u8 = 207;
pub const OV_PHI_B1 : u8 = 134;
pub const OV_PI_B1 : u8 = 128;
pub const OV_DOT_B0 : u8 = 194;
pub const OV_DOT_B1 : u8 = 183;
pub const OV_SUPMINUS_B2 : u8 = 187;

fn ov_put2(out: []u8, w: usize, b0: u8, b1: u8) -> usize {
    return lv_put(out, lv_put(out, w, b0), b1);
}

fn ov_put3(out: []u8, w: usize, b0: u8, b1: u8, b2: u8) -> usize {
    return lv_put(out, ov_put2(out, w, b0, b1), b2);
}

/// The superscript of the digit d (0..9) in UTF-8.
fn ov_sup_digit(out: []u8, w: usize, d: u8) -> usize {
    if (d == 1) { return ov_put2(out, w, 194, 185); }
    if (d == 2) { return ov_put2(out, w, 194, 178); }
    if (d == 3) { return ov_put2(out, w, 194, 179); }
    if (d == 0) { return ov_put3(out, w, 226, 129, 176); }
    return ov_put3(out, w, 226, 129, 176 + d);
}

fn ov_is_alpha_byte(b: u8) -> bool {
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95;
}

/// The ASCII text of ov_pretty_expr as it is drawn: phi and pi as letters, ^n as superscripts, a product space as a dot.
pub fn ov_math(s: []const u8, out: []u8) -> usize {
    var w : usize = 0;
    var i : usize = 0;
    while (i < s.len) {
        const b : u8 = s[i];
        const prev_alpha : bool = i > 0 and ov_is_alpha_byte(s[i - 1]);
        if (ov_is_alpha_byte(b) and prev_alpha == false) {
            var j : usize = i;
            while (j < s.len and (ov_is_alpha_byte(s[j]) or (s[j] >= 48 and s[j] <= 57 and j > i))) { j = j + 1; }
            if (j - i == 3 and s[i] == 112 and s[i + 1] == 104 and s[i + 2] == 105) {
                w = ov_put2(out, w, OV_PHI_B0, OV_PHI_B1);
            } else if (j - i == 2 and s[i] == 112 and s[i + 1] == 105) {
                w = ov_put2(out, w, OV_PHI_B0, OV_PI_B1);
            } else {
                var k : usize = i;
                while (k < j) { w = lv_put(out, w, s[k]); k = k + 1; }
            }
            i = j;
        } else if (b == 94 and i + 1 < s.len and ((s[i + 1] >= 48 and s[i + 1] <= 57) or (s[i + 1] == 45 and i + 2 < s.len and s[i + 2] >= 48 and s[i + 2] <= 57))) {
            var j : usize = i + 1;
            if (s[j] == 45) {
                w = ov_put3(out, w, 226, 129, OV_SUPMINUS_B2);
                j = j + 1;
            }
            while (j < s.len and s[j] >= 48 and s[j] <= 57) {
                w = ov_sup_digit(out, w, s[j] - 48);
                j = j + 1;
            }
            i = j;
        } else if (b == 32 and i > 0 and i + 1 < s.len and s[i - 1] != 43 and s[i - 1] != 45 and s[i + 1] != 43 and s[i + 1] != 45 and s[i + 1] != 47 and s[i - 1] != 47) {
            w = ov_put2(out, w, OV_DOT_B0, OV_DOT_B1);
            i = i + 1;
        } else {
            w = lv_put(out, w, b);
            i = i + 1;
        }
    }
    return w;
}

/// The label of formula i: its expression, set for reading. Nothing else (name, value and error are in the card).
pub fn ov_label(i: u32, out: []u8) -> usize {
    var raw : [96]u8 = undefined;
    var pre : [96]u8 = undefined;
    const n : usize = ov_field(i, OF_EXPR, raw[0..96]);
    const pn : usize = ov_pretty_expr(raw[0..n], pre[0..96]);
    return ov_math(pre[0..pn], out);
}

// ---- tests ----

fn ov_same(a: []const u8, b: string) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) {
        if (a[i] != @as(u8, b[i])) { return false; }
        i = i + 1;
    }
    return true;
}

test the_formula_widgets_carry_their_agents_owner_first {
    assert OV_AGENTS[0] == 16;
    assert OV_AGENTS[1] != OV_AGENTS[0] and OV_AGENTS[2] != OV_AGENTS[0] and OV_AGENTS[1] != OV_AGENTS[2];
    assert OV_AGENTS[0] <= 27 and OV_AGENTS[1] <= 27 and OV_AGENTS[2] <= 27;
    assert OV_AGENTS[0] >= 1 and OV_AGENTS[1] >= 1 and OV_AGENTS[2] >= 1;
    assert OV_WHY.len > 20;
    // the pinned trio is owner-first over the whole table: the owner in slot 0, nobody pinned twice,
    // every id a live agent slot
    assert ov_agents_ok(OV_AGENTS[0..3], OV_AGENT_OWNER);
    // the check bites: a trio that opens with the second agent is not owner-first
    var wrong : [3]u32 = [OV_AGENTS[1], OV_AGENTS[0], OV_AGENTS[2]];
    assert ov_agents_ok(wrong[0..3], OV_AGENT_OWNER) == false;
    // and an id that is not pinned first is not the owner of this order
    assert ov_agents_ok(OV_AGENTS[0..3], OV_AGENTS[1]) == false;
}

test the_keep_out_radius_is_the_half_diagonal_of_the_logo_box {
    assert ov_logo_r(300, 400) == 250;
    assert ov_logo_r(0, 0) == 0;
    assert ov_logo_r(290, 254) > 190 and ov_logo_r(290, 254) < 200;
}

test the_layout_key_changes_with_the_stage_or_the_logo_and_not_otherwise {
    assert ov_key(960, 505, 193) == ov_key(960, 505, 193);
    assert ov_key(960, 505, 193) != ov_key(961, 505, 193);
    assert ov_key(960, 505, 193) != ov_key(960, 506, 193);
    assert ov_key(960, 505, 193) != ov_key(960, 505, 194);
}

test the_clock_runs_at_the_scale_stops_for_reduced_motion_and_never_jumps {
    assert ov_clock_step(1000, 16, 1000, false) == 1016;
    assert ov_clock_step(1000, 16, 250, false) == 1004;
    assert ov_clock_step(1000, 16, 1000, true) == 1000;
    assert ov_clock_step(1000, 5000, 1000, false) == 1100;
    assert ov_clock_step(1000, 0 - 40, 1000, false) == 1000;
    assert ov_animates(true, false, 12);
    assert ov_animates(true, true, 12) == false;
    assert ov_animates(false, false, 12) == false;
    assert ov_animates(true, false, 0) == false;
    assert ov_visible(1000) and ov_visible(1) and ov_visible(0) == false;
}

test the_error_is_signed_in_percent_with_three_decimals {
    var o : [24]u8 = undefined;
    var n : usize = ov_err_text(0 - 620, o[0..24]);
    assert ov_same(o[0..n], "-0.620%");
    n = ov_err_text(29, o[0..24]);
    assert ov_same(o[0..n], "+0.029%");
    n = ov_err_text(0, o[0..24]);
    assert ov_same(o[0..n], "0.000%");
    n = ov_err_text(1360, o[0..24]);
    assert ov_same(o[0..n], "+1.360%");
}

test a_label_reads_name_value_and_error_from_the_generated_table {
    var o : [64]u8 = undefined;
    var n : usize = ov_field(0, OF_NAME, o[0..64]);
    assert ov_same(o[0..n], "gamma_phi");
    n = ov_field(0, OF_EXPR, o[0..64]);
    assert ov_same(o[0..n], "pow(PHI, -3.0)");
    n = ov_value_line(0, o[0..64]);
    assert ov_same(o[0..n], "0.236067977  -0.620%");
    n = ov_field(0, OF_SECTOR, o[0..64]);
    assert ov_same(o[0..n], "gauge-coupling");
    n = ov_card_line(3, 1, o[0..64]);
    assert ov_same(o[0..n], "137.035999  +0.029%");
    assert ov_field(32, OF_NAME, o[0..64]) == 0;
    // every formula has a name, a value and a sector to show
    var i : u32 = 0;
    while (i < FORMULA_COUNT) {
        assert ov_field(i, OF_NAME, o[0..64]) > 0;
        assert ov_field(i, OF_VALUE, o[0..64]) > 0;
        assert ov_field(i, OF_SECTOR, o[0..64]) > 0;
        i = i + 1;
    }
}

test the_turn_is_clockwise_on_screen_and_reduced_motion_holds_still {
    // screen y points down: at angle 0 the label is right of the centre; a clockwise turn takes it DOWN (y grows), then left
    const x0 : i64 = ov_pos_x(500, 300, 0, 0);
    const y0 : i64 = ov_pos_y(250, 200, 0, 0);
    assert x0 == 800 and y0 == 250;
    const y1 : i64 = ov_pos_y(250, 200, 0, 10000);
    assert y1 > y0;
    const x2 : i64 = ov_pos_x(500, 300, 0, 90000);
    assert x2 < 505 and x2 > 495;
    assert ov_pos_y(250, 200, 0, 90000) > 440;
    // a quarter turn from the top (270 deg) goes to the right: clockwise
    assert ov_pos_x(500, 300, 270000, 10000) > ov_pos_x(500, 300, 270000, 0);
    // the angle grows with the clock, and is 0 when the motion is reduced
    assert ov_theta(1000, false) == 1500;
    assert ov_theta(240000, false) == 360000;
    assert ov_theta(5000, true) == 0;
    assert ov_theta(0, false) == 0;
}

test every_label_clears_the_logo_and_every_other_label_and_stays_on_the_stage_at_every_turn_angle {
    var ra : [32]i64 = undefined;
    var rb : [32]i64 = undefined;
    var rp : [32]i64 = undefined;
    var z : usize = 0;
    while (z < 32) { ra[z] = 0; rb[z] = 0; rp[z] = 0; z = z + 1; }
    const keep : i64 = ov_logo_r(290, 254);
    const n : usize = ov_layout(480, 252, 960, 505, keep, OV_MAX, ra[0..32], rb[0..32], rp[0..32]);
    assert n >= 12 and n <= 32;
    var th : i64 = 0;
    while (th < 360000) {
        var i : usize = 0;
        while (i < n) {
            const x : i64 = ov_pos_x(480, ra[i], rp[i], th);
            const y : i64 = ov_pos_y(252, rb[i], rp[i], th);
            assert ov_clear(x, y, 480, 252, keep);
            assert x - OV_W / 2 >= 0 and x + OV_W / 2 <= 960 and y - OV_H / 2 >= 0 and y + OV_H / 2 <= 505;
            var j : usize = i + 1;
            while (j < n) {
                assert ov_apart(x, y, ov_pos_x(480, ra[j], rp[j], th), ov_pos_y(252, rb[j], rp[j], th));
                j = j + 1;
            }
            i = i + 1;
        }
        th = th + 7300;
    }
    // a bigger stage places more, up to all 32
    const big : usize = ov_layout(720, 400, 1440, 800, keep, OV_MAX, ra[0..32], rb[0..32], rp[0..32]);
    assert big > n and big <= 32;
    // the hit test finds the label under the pointer and nothing elsewhere
    const hx : i64 = ov_pos_x(720, ra[0], rp[0], 12345);
    const hy : i64 = ov_pos_y(400, rb[0], rp[0], 12345);
    assert ov_hit(720, 400, ra[0..32], rb[0..32], rp[0..32], big, 12345, hx, hy) == 0;
    assert ov_hit(720, 400, ra[0..32], rb[0..32], rp[0..32], big, 12345, 720, 400) == OV_NONE;
    assert ov_nearest_gap(720, 400, ra[0..32], rb[0..32], rp[0..32], big, 12345, hx, hy) == 0;
}


test the_label_is_the_expression_only_set_for_reading_in_ascii {
    var raw : [96]u8 = undefined;
    var o : [96]u8 = undefined;
    var n : usize = ov_field(0, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "phi^-3");
    n = ov_field(1, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "ln(2)/pi");
    n = ov_field(3, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "GA - 2/phi^3 + (3 phi)^-5");
    n = ov_field(7, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "8 phi^2 pi^2");
    n = ov_field(4, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "1/(phi^4 + phi)");
    n = ov_field(5, OF_EXPR, raw[0..96]);
    n = ov_pretty_expr(raw[0..n], o[0..96]);
    assert ov_same(o[0..n], "156.5");
    // no registry leftover in any label
    var i : u32 = 0;
    while (i < FORMULA_COUNT) {
        n = ov_field(i, OF_EXPR, raw[0..96]);
        n = ov_pretty_expr(raw[0..n], o[0..96]);
        assert n > 0 and n <= 40;
        var k : usize = 0;
        while (k < n) {
            assert o[k] != 37 and o[k] != 124;
            if (k + 3 < n) { assert (o[k] == 112 and o[k + 1] == 111 and o[k + 2] == 119 and o[k + 3] == 40) == false; }
            if (k + 1 < n) { assert (o[k] == 46 and o[k + 1] == 48) == false; }
            k = k + 1;
        }
        i = i + 1;
    }
}

test phi_pi_and_exponents_are_drawn_as_math_with_utf8_bytes_from_a_table {
    var o : [96]u8 = undefined;
    // phi^-3 -> U+03C6 U+207B U+00B3
    var n : usize = ov_label(0, o[0..96]);
    assert n == 7;
    assert o[0] == 207 and o[1] == 134 and o[2] == 226 and o[3] == 129 and o[4] == 187 and o[5] == 194 and o[6] == 179;
    // ln(2)/pi -> "ln(2)/" then U+03C0
    n = ov_label(1, o[0..96]);
    assert n == 8 and o[0] == 108 and o[1] == 110 and o[5] == 47 and o[6] == 207 and o[7] == 128;
    // 8 phi^2 pi^2 -> 8 . phi^2 . pi^2 with the middle dot U+00B7 between factors
    n = ov_label(7, o[0..96]);
    assert n == 13;
    assert o[0] == 56 and o[1] == 194 and o[2] == 183 and o[3] == 207 and o[4] == 134 and o[5] == 194 and o[6] == 178;
    assert o[7] == 194 and o[8] == 183 and o[9] == 207 and o[10] == 128 and o[11] == 194 and o[12] == 178;
    // sums keep their spaces: 1/(phi^4 + phi)
    n = ov_label(4, o[0..96]);
    assert o[0] == 49 and o[1] == 47 and o[2] == 40 and o[3] == 207 and o[4] == 134;
    var k : usize = 0;
    var plus : bool = false;
    while (k + 2 < n) {
        if (o[k] == 32 and o[k + 1] == 43 and o[k + 2] == 32) { plus = true; }
        k = k + 1;
    }
    assert plus;
    // superscript digits, a bare ^ stays, names that only contain phi or pi are not letters
    n = ov_math("x^0 x^1 x^4 x^9", o[0..96]);
    assert o[1] == 226 and o[2] == 129 and o[3] == 176 and o[4] == 194 and o[5] == 183;
    n = ov_math("a^b", o[0..96]);
    assert ov_same(o[0..n], "a^b");
    n = ov_math("pie", o[0..96]);
    assert ov_same(o[0..n], "pie");
    n = ov_math("gamma_phi()", o[0..96]);
    assert ov_same(o[0..n], "gamma_phi()");
    // every label is well-formed UTF-8: a continuation byte always follows a lead or another continuation
    var i : u32 = 0;
    while (i < FORMULA_COUNT) {
        n = ov_label(i, o[0..96]);
        assert n > 0 and n < 96;
        var q : usize = 0;
        while (q < n) {
            if (o[q] >= 128 and o[q] < 192) { assert q > 0 and o[q - 1] >= 128; }
            q = q + 1;
        }
        i = i + 1;
    }
}

test the_orbit_shows_verified_and_candidate_rows_within_1_percent_candidates_dimmer {
    assert ov_row_alpha_permille(0, 620) == 1000;
    assert ov_row_alpha_permille(0, 0 - 620) == 1000;
    assert ov_row_alpha_permille(1, 999) == 720;
    assert ov_row_alpha_permille(1, 1000) == 720;
    assert ov_row_alpha_permille(1, 1001) == 0;
    assert ov_row_alpha_permille(0, 1360) == 0;
    assert ov_row_alpha_permille(2, 0) == 0;
    assert OV_ALPHA_CANDIDATE < OV_ALPHA_VERIFIED and OV_ALPHA_CANDIDATE > 0;
}

test the_rule_on_the_table_hides_far_registry_rows_and_every_conjecture {
    assert ov_row_alpha(0) == 1000;
    assert ov_row_alpha(8) == 0;
    assert ov_row_alpha(32) == 720;
    assert ov_row_alpha(ROW_COUNT - 1) == 0;
    assert ov_row_alpha(ROW_COUNT) == 0;
    var shown : u32 = 0;
    var bright : u32 = 0;
    var i : u32 = 0;
    while (i < ROW_COUNT) {
        const a : i64 = ov_row_alpha(i);
        if (a > 0) { shown = shown + 1; }
        if (a == OV_ALPHA_VERIFIED) { bright = bright + 1; }
        i = i + 1;
    }
    assert bright == 20;
    assert shown == 91;
}
