; PARALLEL-SPEC-GEN-SPEC
; Purpose: Coordinate parallel generation of specification fragments by a swarm of actors.
; Law L7 Compliance: Spec-first ternary.

module parallel_gen {
  
  type FragmentId = string;
  type SpecId = string;
  type Content = string;
  type ActorId = string;

  struct SpecFragment {
    fragment_id: FragmentId;
    spec_id: SpecId;
    actor_id: ActorId;
    content: Content;
    hash: string;
    sequence: int;
  }

  // The coordinator that manages the fragments
  coordinator: Map<SpecId, List<SpecFragment>>;
  
  // Mapping of Actor roles to fragment IDs
  swarm_map: Map<SpecId, Map<ActorId, FragmentId>>;

  task submit_fragment {
    input: fragment: SpecFragment;
    
    // Verify fragment integrity via the T27-SSOT state graph
    assert state_graph.verify_fragment(fragment.hash) == true;
    
    // Update the coordinator
    coordinator[fragment.spec_id].push(fragment);
    
    // Mark actor as complete for this fragment
    swarm_map[fragment.spec_id][fragment.actor_id] = fragment.fragment_id;
    
    // Check if all required fragments for the spec are present
    if (is_complete(fragment.spec_id)) {
      synthesize_spec(fragment.spec_id);
    }
  }

  task synthesize_spec {
    input: spec_id: SpecId;
    
    // Merge fragments sorted by sequence
    const sorted_fragments = sort_by_sequence(coordinator[spec_id]);
    const final_content = merge_fragments(sorted_fragments);
    
    write_spec(spec_id, final_content);
    
    // Seal the final generated spec
    assert seal_spec(spec_id) == "GREEN";
  }

  // Internal helpers
  function is_complete(spec_id: SpecId) -> bool {
    return coordinator[spec_id].length == swarm_map[spec_id].length;
  }

  function sort_by_sequence(frags: List<SpecFragment>) -> List<SpecFragment> {
    return frags.sort(f => f.sequence);
  }

  function merge_fragments(frags: List<SpecFragment>) -> Content {
    return frags.map(f => f.content).join("");
  }

  invariant structural_integrity {
    // The synthesized spec must be a valid .t27 module
    assert is_valid_t27(coordinator.values());
  }

  // TDD: Test cases
  test parallel_gen_flow {
    // Setup
    const spec_id = "spec-101";
    swarm_map[spec_id] = { "actor-1": "f1", "actor-2": "f2" };

    // Submit first fragment
    assert parallel_gen.submit_fragment({
      fragment_id: "f1", 
      spec_id: spec_id, 
      actor_id: "actor-1",
      content: "module test { ", 
      hash: "h1", 
      sequence: 0
    }) == true;

    // Submit second fragment
    assert parallel_gen.submit_fragment({
      fragment_id: "f2", 
      spec_id: spec_id, 
      actor_id: "actor-2",
      content: " }", 
      hash: "h2", 
      sequence: 1
    }) == true;

    // Verify synthesized output
    assert read_spec(spec_id) == "module test {  }";
  }

  test parallel_gen_out_of_order {
    // Setup
    const spec_id = "spec-102";
    swarm_map[spec_id] = { "actor-1": "f1", "actor-2": "f2" };

    // Submit second fragment FIRST
    assert parallel_gen.submit_fragment({
      fragment_id: "f2", 
      spec_id: spec_id, 
      actor_id: "actor-2",
      content: " }", 
      hash: "h2", 
      sequence: 1
    }) == true;

    // Submit first fragment SECOND
    assert parallel_gen.submit_fragment({
      fragment_id: "f1", 
      spec_id: spec_id, 
      actor_id: "actor-1",
      content: "module test { ", 
      hash: "h1", 
      sequence: 0
    }) == true;

    // Verify synthesized output is still correct due to sequence sorting
    assert read_spec(spec_id) == "module test {  }";
  }

  test parallel_gen_invalid_hash {
    const spec_id = "spec-103";
    swarm_map[spec_id] = { "actor-1": "f1" };
    
    // This should fail because state_graph.verify_fragment("bad_hash") == false
    assert parallel_gen.submit_fragment({
      fragment_id: "f1", 
      spec_id: spec_id, 
      actor_id: "actor-1",
      content: "module fail {}", 
      hash: "bad_hash", 
      sequence: 0
    }) == false;
  }
}
