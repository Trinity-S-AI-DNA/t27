; T27-HANDSHAKE-SPEC
; Purpose: Define a secure, verifiable hand-off protocol for decentralized actors.
; Law L7 Compliance: Spec-first ternary.

module handshake {
  
  type ActorId = string;
  type TaskId = string;
  type ContextHash = string;

  struct HandshakePacket {
    from: ActorId;
    to: ActorId;
    task_id: TaskId;
    context_hash: ContextHash;
    signature: string;
  }

  task initiate_handshake {
    input: packet: HandshakePacket;
    
    // Verify the packet signature
    assert verify_signature(packet.from, packet.signature) == true;
    
    // Check if the receiver is available (via state_graph)
    assert state_graph.get_status(packet.to) == "IDLE";
    
    // Update state graph to mark task transfer
    state_graph.update_state(packet.to, "WORKING");
    state_graph.update_state(packet.from, "IDLE");
    
    return "ACCEPTED";
  }

  invariant transfer_atomicity {
    // A task cannot be owned by two actors simultaneously
    assert count_owners(task_id) == 1;
  }
}

test handshake_flow {
  assert handshake.initiate_handshake({
    from: "agent-1", 
    to: "agent-2", 
    task_id: "task-101", 
    context_hash: "hash_ctx", 
    signature: "sig_1"
  }) == "ACCEPTED"
}
