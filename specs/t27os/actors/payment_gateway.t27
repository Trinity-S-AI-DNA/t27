; TRI-PAYMENT-GATEWAY-SPEC
; Purpose: Verification-gated incentive system for decentralized actors.
; Law L7 Compliance: Spec-first ternary.

module payment_gateway {
  
  type ActorId = string;
  type SealHash = string;
  type Amount = number;

  struct Payment {
    actor_id: ActorId;
    amount: Amount;
    seal_ref: SealHash;
    timestamp: timestamp;
  }

  // The treasury of $TRI tokens
  treasury: number = 1000000;

  task claim_incentive {
    input: id, seal_hash;
    
    // Verification Gate: The seal MUST be green
    assert verify_seal(seal_hash) == "GREEN";
    
    // Prevent double-claiming the same seal
    assert !already_claimed(seal_hash);
    
    // Pay the agent
    const payment_amount = 100;
    treasury -= payment_amount;
    record_payment(id, payment_amount, seal_hash);
    
    return "PAID";
  }

  invariant solvent {
    // Treasury must never go negative
    assert treasury >= 0;
  }
}

test payment_flow {
  assert payment_gateway.claim_incentive("agent-1", "green_hash") == "PAID"
}
