// SPDX-License-Identifier: Apache-2.0
// specs/t27os/system_pulse.t27 -- System pulse: what the swarm is doing, and
// what has stopped.
// Part of M1 (milestone #5). Closes #12306.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::system_pulse;

pub const PULSE_AGENT_MAX : u32 = 27;

pub struct PulseAgent { letter: str, active: bool, stopped: bool };

pub fn pulse_agent_stopped(a: PulseAgent) -> bool {
    return a.stopped && !a.active;
}

test "pulse agent stopped" {
    assert(pulse_agent_stopped(PulseAgent { letter: "B", active: false, stopped: true }));
    assert(!pulse_agent_stopped(PulseAgent { letter: "C", active: true, stopped: false }));
}

invariant pulse_agent_max_positive {
    assert PULSE_AGENT_MAX > 0;
}