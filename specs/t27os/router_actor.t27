// SPDX-License-Identifier: Apache-2.0
// specs/t27os/router_actor.t27 -- the accept loop as an actor (specs/queen/actors.t27 vocabulary):
// one bounded mailbox of accepted connections, one pure step per message, a fault that closes the
// connection without killing the loop, and a backoff after repeated faults. No threads, no timers:
// the host feeds one message per accepted connection and one tick per frame -- the same shape the
// PTY server's loop already runs. The wire bytes are router_serve.t27's (serve_answer), the socket
// bytes are router_sock.t27's, the walk is router.t27's; this spec owns the ACTOR's laws.
// phi^2 + 1/phi^2 = 3 | TRINITY

module T27osRouterActor;

use t27os::router_serve::serve_answer;
use t27os::router_sock::AF_INET;
use t27os::router_sock::SOCKADDR_IN_LEN;
use t27os::router_sock::router_bind_bytes;
use t27os::pty_client::SOCK_STREAM;
use t27os::pty_sys::sys_socket;
use t27os::pty_sys::sys_bind;
use t27os::pty_sys::sys_listen;
use t27os::pty_sys::sys_close;

/// The actor's listener: one AF_INET stream socket bound by router_sock's bytes and listening.
/// The fd, or -1 on any refusal -- the host then goes on with its own work.
pub fn router_listen() -> i32 {
    const fd : i32 = sys_socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) { return -1; }
    var sa : [SOCKADDR_IN_LEN]u8 = undefined;
    const sn : usize = router_bind_bytes(sa[0..SOCKADDR_IN_LEN]);
    if (sn != SOCKADDR_IN_LEN) { _ = sys_close(fd); return -1; }
    if (sys_bind(fd, sa[0..SOCKADDR_IN_LEN], @as(u32, @intCast(sn))) != 0) { _ = sys_close(fd); return -1; }
    if (sys_listen(fd, 16) != 0) { _ = sys_close(fd); return -1; }
    return fd;
}

// ---- the mailbox --------------------------------------------------------------------------------------------

/// Connections waiting in the mailbox: bounded, so a client storm cannot grow the actor without
/// bound -- a connection over the bound is refused at accept time, not queued.
pub const CONN_MAILBOX : u32 = 8;

/// Does an accept fit the mailbox? The count is the connections already waiting.
pub fn accept_fits(waiting: u32) -> bool {
    return waiting < CONN_MAILBOX;
}

// ---- the step -----------------------------------------------------------------------------------------------

/// Connection states: the line was read (LN), the answer is on the wire (AN), the socket is closed (CL).
pub const CS_LINE_READ : u32 = 0;
pub const CS_ANSWERED : u32 = 1;
pub const CS_CLOSED : u32 = 2;

/// One actor step: from LINE_READ with a request line, the answer composes (router_serve serve_answer)
/// and the state becomes ANSWERED; from ANSWERED the socket closes (CL). CLOSED is final. The answer
/// bytes return through `out` with their length; a line that does not fit the out buffer faults.
pub fn conn_step(state: u32, line: []const u8, body: []const u8, out: []u8) -> u32 {
    if (state == CS_LINE_READ) {
        if (out.len < line.len + body.len + 128) { return CS_CLOSED; }
        _ = serve_answer(line, body, out);
        return CS_ANSWERED;
    }
    if (state == CS_ANSWERED) { return CS_CLOSED; }
    return CS_CLOSED;
}

// ---- the supervision ----------------------------------------------------------------------------------------

/// Faults in a row before the actor backs off: a burst of broken clients must not spin the loop hot.
pub const FAULT_LIMIT : u32 = 16;
/// The backoff after FAULT_LIMIT faults in a row, in ticks.
pub const BACKOFF_TICKS : u32 = 30;

/// The loop stays alive through any single fault: one broken connection is closed, the actor keeps
/// accepting. `alive` never turns false here -- the supervisor's decision (restart or stop) is
/// actors.t27's, driven by these counts.
pub fn loop_alive(faults_in_row: u32) -> bool {
    return faults_in_row < FAULT_LIMIT;
}

/// The tick's decision with the backoff: a tick during backoff is skipped (0), a live tick steps (1).
pub fn tick_decision(faults_in_row: u32, backoff_left: u32) -> u32 {
    if (faults_in_row >= FAULT_LIMIT and backoff_left > 0) { return 0; }
    return 1;
}

test "a_connection_walks_line_answered_closed" {
    var out : [256]u8 = undefined;
    const line : []const u8 = "POST /v1/messages HTTP/1.1";
    var s : u32 = conn_step(CS_LINE_READ, line, "{}", out[0..256]);
    assert s == CS_ANSWERED;
    s = conn_step(s, line, "{}", out[0..256]);
    assert s == CS_CLOSED;
    s = conn_step(s, line, "{}", out[0..256]);
    assert s == CS_CLOSED;
}

test "a_refused_connection_closes_the_same_way" {
    var out : [256]u8 = undefined;
    const bad : []const u8 = "POST /v1/messages/count_tokens HTTP/1.1";
    const s : u32 = conn_step(CS_LINE_READ, bad, "{}", out[0..256]);
    assert s == CS_ANSWERED;
}

test "an_answer_that_does_not_fit_closes_without_escaping" {
    var small : [8]u8 = undefined;
    const line : []const u8 = "POST /v1/messages HTTP/1.1";
    const s : u32 = conn_step(CS_LINE_READ, line, "{}", small[0..8]);
    assert s == CS_CLOSED;
}

test "the_mailbox_is_bounded_and_the_loop_survives_faults" {
    assert accept_fits(0);
    assert accept_fits(7);
    assert accept_fits(CONN_MAILBOX) == false;
    assert loop_alive(0);
    assert loop_alive(FAULT_LIMIT - 1);
    assert loop_alive(FAULT_LIMIT) == false;
    assert tick_decision(0, 0) == 1;
    assert tick_decision(FAULT_LIMIT, 5) == 0;
    assert tick_decision(FAULT_LIMIT, 0) == 1;
}
