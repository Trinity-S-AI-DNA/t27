// specs/t27os/agent_command.t27 -- t27os: add agent command line and step log
// - browser pane.
// Part of M1 (milestone #5). Closes #14041.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::agent_command;

pub const COMMAND_LOG_MAX : u32 = 256;

pub struct AgentCommand { command: str, step_logged: bool };

pub fn agent_command_logged(c: AgentCommand) -> bool {
    return c.step_logged && c.command != "";
}

test "agent command logged" {
    assert(agent_command_logged(AgentCommand { command: "run spec", step_logged: true }));
    assert(!agent_command_logged(AgentCommand { command: "", step_logged: true }));
    assert(!agent_command_logged(AgentCommand { command: "run spec", step_logged: false }));
}

invariant command_log_max_positive {
    assert COMMAND_LOG_MAX > 0;
}