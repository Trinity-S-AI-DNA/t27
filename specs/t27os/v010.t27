// SPDX-License-Identifier: Apache-2.0
// specs/t27os/v010.t27 -- T27 OS v0.1.0-alpha.1: native chat slice, LM Studio
// adapter, durable events, one.
// Part of M1 (milestone #5). Closes #13212.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::v010;

pub const VERSION_ALPHA_1 : str = "0.1.0-alpha.1";

pub struct V010Release { version: str, native_chat: bool, durable_events: bool };

pub fn v010_durable_events(r: V010Release) -> bool {
    return r.durable_events;
}

test "v010 version" {
    assert(VERSION_ALPHA_1 == "0.1.0-alpha.1");
}

test "v010 durable events" {
    assert(v010_durable_events(V010Release { version: "0.1.0-alpha.1", native_chat: true, durable_events: true }));
    assert(!v010_durable_events(V010Release { version: "0.1.0-alpha.1", native_chat: true, durable_events: false }));
}