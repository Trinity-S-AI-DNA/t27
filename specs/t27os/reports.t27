// specs/t27os/reports.t27 -- one report has status, done, blocked, next, requests.
// Filling the five fields does not merge, publish, or run a test.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27os::reports {

    pub const MAY_MERGE : bool = false;
    pub const MAY_PUBLISH : bool = false;
    pub const MAY_TEST : bool = false;

    pub fn report_ready(status: bool, done: bool, blocked: bool, next: bool, requests: bool) -> bool {
        return status && done && blocked && next && requests;
    }

    test "five fields make a report and none of them grants a merge" {
        assert(report_ready(true, true, true, true, true));
        assert(!report_ready(true, true, true, true, false));
        assert(!MAY_MERGE);
        assert(!MAY_PUBLISH);
        assert(!MAY_TEST);
    }

    invariant the_report_does_not_merge {
        assert MAY_MERGE == false;
        assert MAY_PUBLISH == false;
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
