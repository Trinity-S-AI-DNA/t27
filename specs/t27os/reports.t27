// SPDX-License-Identifier: Apache-2.0
; specs/t27os/reports.t27 -- a lane report is complete only with five fields:
; status, done, blocked, next, and requests out. A missing field is not a
; finished report. The text of the fields lives with the lane; this spec
; checks that each field was supplied.

module T27osReports;

use t27os::orchestrator::oc_pr_ok;

pub const RF_STATUS : u32 = 1;
pub const RF_DONE : u32 = 2;
pub const RF_BLOCKED : u32 = 4;
pub const RF_NEXT : u32 = 8;
pub const RF_REQUESTS : u32 = 16;
pub const RF_ALL : u32 = 31;

pub fn report_complete(bits: u32) -> bool {
    return (bits & RF_ALL) == RF_ALL;
}

pub fn report_missing(bits: u32) -> u32 {
    return RF_ALL - (bits & RF_ALL);
}

/// The chain is commit, lane, report, then a pull request. The report does
/// not merge. A pull request waits on the orchestrator predicate.
pub fn report_may_open_pr(bits: u32, task_done: bool, checks_green: bool) -> bool {
    if (report_complete(bits) == false) { return false; }
    return oc_pr_ok(task_done, checks_green);
}

test five_fields_make_a_complete_report {
    assert report_complete(RF_ALL);
    assert report_missing(RF_ALL) == 0;
}

test a_report_without_requests_out_is_not_complete {
    var bits : u32 = RF_STATUS + RF_DONE + RF_BLOCKED + RF_NEXT;
    assert report_complete(bits) == false;
    assert report_missing(bits) == RF_REQUESTS;
}

test a_complete_report_opens_a_pr_only_when_the_task_and_checks_are_green {
    assert report_may_open_pr(RF_ALL, true, true);
    assert report_may_open_pr(RF_ALL, true, false) == false;
    assert report_may_open_pr(RF_ALL, false, true) == false;
    var bits : u32 = RF_STATUS + RF_DONE + RF_BLOCKED + RF_NEXT;
    assert report_may_open_pr(bits, true, true) == false;
}
