// SPDX-License-Identifier: Apache-2.0
; specs/t27os/dsh_mcp_bridge.t27 -- MCP to ACP bridge for task dispatch through DSH
; Owner, 2026-11-01: task dispatch "through the local DSH MCP". 127.0.0.1:3080 is the DSH Web UI, not an MCP server.
; DSH is an MCP client; its programmatic server surface is ACP (JSON-RPC over stdio). This bridge maps MCP tools to ACP.
; The tool names are EXPECTED names (a proposal for the day a server is registered); the ACP names are verified in the DSH source.
; Fact: the server registers requests initialize, authenticate, session/new, session/list, session/resume, session/close,
; session/set_config_option, session/prompt and the notification session/cancel (deepseek-harness packages/acp/acp/src/index.ts lines 379-390).
; The SDK also defines session/load, session/fork and session/set_mode, which that server does NOT register, so they are not in the table.
; The gate decides: unknown tools, issue 0, out-of-scope target paths and absent conductor go are refused; valid requests with no go are held.
; Order rationale: a request that can never become valid (unknown tool, issue 0, a target outside scope) is refused even while go is absent.
; Hold means "valid, waiting for the go"; so go absent AND issue 0 answers REFUSE (FR-002: issue 0 is refused whatever the other inputs are).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27osDshMcpBridge;

use t27os::dsh_scope::path_in_root;
use t27os::dsh_scope::path_is_foreign;

; --- 1. tool ids and tables --------------------------------------------------------------------------

pub const T_NONE : u8 = 0;
pub const T_CREATE : u8 = 1;
pub const T_PROMPT : u8 = 2;
pub const T_CANCEL : u8 = 3;
pub const T_LIST : u8 = 4;
pub const T_RESUME : u8 = 5;
pub const T_CLOSE : u8 = 6;
pub const TOOL_COUNT : u8 = 6;

pub const TOOL_NAME : [7]str = ["", "dsh_task_create", "dsh_task_prompt", "dsh_task_cancel", "dsh_task_list", "dsh_task_resume", "dsh_task_close"];
pub const ACP_METHOD : [7]str = ["", "session/new", "session/prompt", "session/cancel", "session/list", "session/resume", "session/close"];
pub const ACP_HANDSHAKE : str = "initialize";

pub fn tool_known(t: u8) -> bool {
    return t >= T_CREATE and t <= T_CLOSE;
}

pub fn tool_name(t: u8) -> str {
    if (t >= T_CREATE and t <= T_CLOSE) {
        return TOOL_NAME[t];
    }
    return "";
}

pub fn acp_method(t: u8) -> str {
    if (t >= T_CREATE and t <= T_CLOSE) {
        return ACP_METHOD[t];
    }
    return "";
}

pub fn acp_is_notification(t: u8) -> bool {
    return t == T_CANCEL;
}

; --- 2. gate codes and reasons -------------------------------------------------------------------------

pub const D_HOLD : u8 = 0;
pub const D_REFUSE : u8 = 1;
pub const D_MAP : u8 = 2;

pub const R_OK : u8 = 0;
pub const R_UNKNOWN_TOOL : u8 = 1;
pub const R_NO_ISSUE : u8 = 2;
pub const R_OUT_OF_SCOPE : u8 = 3;
pub const R_NO_GO : u8 = 4;

pub fn why(tool: u8, go: bool, issue: u32, in_scope: bool) -> u8 {
    if (!tool_known(tool)) {
        return R_UNKNOWN_TOOL;
    }
    if (issue == 0) {
        return R_NO_ISSUE;
    }
    if (tool == T_CREATE and in_scope == false) {
        return R_OUT_OF_SCOPE;
    }
    if (go == false) {
        return R_NO_GO;
    }
    return R_OK;
}

pub fn decide_of_reason(r: u8) -> u8 {
    if (r == R_OK) {
        return D_MAP;
    }
    if (r == R_NO_GO) {
        return D_HOLD;
    }
    return D_REFUSE;
}

pub fn decide(tool: u8, go: bool, issue: u32, in_scope: bool) -> u8 {
    return decide_of_reason(why(tool, go, issue, in_scope));
}

pub fn acp_requests(d: u8) -> u8 {
    return if (d == D_MAP) { 1 } else { 0 };
}

pub fn mapped_method(tool: u8, go: bool, issue: u32, in_scope: bool) -> str {
    if (decide(tool, go, issue, in_scope) == D_MAP) {
        return acp_method(tool);
    }
    return "";
}

pub fn one_ok(tool: u8, go: bool, issue: u32, in_scope: bool) -> bool {
    const d = decide(tool, go, issue, in_scope);
    if (acp_requests(d) <= 1) {
        if (d == D_MAP) {
            return acp_requests(d) == 1;
        }
        return true;
    }
    return false;
}

pub fn path_in_scope(path: []const u8, plen: usize) -> bool {
    return path_in_root(path, 0, plen) and !path_is_foreign(path, 0, plen);
}

pub fn decide_path(tool: u8, go: bool, issue: u32, path: []const u8, plen: usize) -> u8 {
    return decide(tool, go, issue, path_in_scope(path, plen));
}

; --- 3. tests -----------------------------------------------------------------------------------------

test tool_known_works {
    assert tool_known(T_NONE) == false;
    assert tool_known(T_CREATE) == true;
    assert tool_known(T_PROMPT) == true;
    assert tool_known(T_CANCEL) == true;
    assert tool_known(T_LIST) == true;
    assert tool_known(T_RESUME) == true;
    assert tool_known(T_CLOSE) == true;
    assert tool_known(TOOL_COUNT + 1) == false;
    assert tool_known(255) == false;
}

test tool_name_returns_empty_for_unknown {
    assert tool_name(T_NONE) == "";
    assert tool_name(7) == "";
    assert tool_name(255) == "";
}

test tool_name_returns_correct_names {
    assert tool_name(T_CREATE) == "dsh_task_create";
    assert tool_name(T_PROMPT) == "dsh_task_prompt";
    assert tool_name(T_CANCEL) == "dsh_task_cancel";
    assert tool_name(T_LIST) == "dsh_task_list";
    assert tool_name(T_RESUME) == "dsh_task_resume";
    assert tool_name(T_CLOSE) == "dsh_task_close";
}

test acp_method_returns_empty_for_unknown {
    assert acp_method(T_NONE) == "";
    assert acp_method(7) == "";
    assert acp_method(255) == "";
}

test acp_method_returns_correct_methods {
    assert acp_method(T_CREATE) == "session/new";
    assert acp_method(T_PROMPT) == "session/prompt";
    assert acp_method(T_CANCEL) == "session/cancel";
    assert acp_method(T_LIST) == "session/list";
    assert acp_method(T_RESUME) == "session/resume";
    assert acp_method(T_CLOSE) == "session/close";
}

test no_method_is_session_load_fork_or_set_mode {
    assert acp_method(T_CREATE) != "session/load";
    assert acp_method(T_PROMPT) != "session/fork";
    assert acp_method(T_CANCEL) != "session/set_mode";
    assert acp_method(T_LIST) != "session/load";
    assert acp_method(T_RESUME) != "session/set_mode";
    assert acp_method(T_CLOSE) != "session/fork";
}

test acp_is_notification_only_for_cancel {
    assert acp_is_notification(T_CANCEL) == true;
    assert acp_is_notification(T_CREATE) == false;
    assert acp_is_notification(T_PROMPT) == false;
    assert acp_is_notification(T_LIST) == false;
    assert acp_is_notification(T_RESUME) == false;
    assert acp_is_notification(T_CLOSE) == false;
}

test issue_0_refuses_all_tools_even_with_go_and_scope {
    assert why(T_CREATE, true, 0, true) == R_NO_ISSUE;
    assert decide(T_CREATE, true, 0, true) == D_REFUSE;
    assert why(T_PROMPT, true, 0, true) == R_NO_ISSUE;
    assert decide(T_PROMPT, true, 0, true) == D_REFUSE;
    assert why(T_CANCEL, true, 0, true) == R_NO_ISSUE;
    assert decide(T_CANCEL, true, 0, true) == D_REFUSE;
    assert why(T_LIST, true, 0, true) == R_NO_ISSUE;
    assert decide(T_LIST, true, 0, true) == D_REFUSE;
    assert why(T_RESUME, true, 0, true) == R_NO_ISSUE;
    assert decide(T_RESUME, true, 0, true) == D_REFUSE;
    assert why(T_CLOSE, true, 0, true) == R_NO_ISSUE;
    assert decide(T_CLOSE, true, 0, true) == D_REFUSE;
}

test issue_0_with_go_false_still_refuses_create_and_prompt {
    assert decide(T_CREATE, false, 0, true) == D_REFUSE;
    assert decide(T_PROMPT, false, 0, true) == D_REFUSE;
}

test refuse_scenario {
    assert mapped_method(T_CREATE, true, 0, true) == "";
    assert acp_requests(decide(T_CREATE, true, 0, true)) == 0;
    assert mapped_method(T_PROMPT, true, 0, true) == "";
    assert acp_requests(decide(T_PROMPT, true, 0, true)) == 0;
    assert mapped_method(T_CANCEL, true, 0, true) == "";
    assert acp_requests(decide(T_CANCEL, true, 0, true)) == 0;
    assert mapped_method(T_LIST, true, 0, true) == "";
    assert acp_requests(decide(T_LIST, true, 0, true)) == 0;
    assert mapped_method(T_RESUME, true, 0, true) == "";
    assert acp_requests(decide(T_RESUME, true, 0, true)) == 0;
    assert mapped_method(T_CLOSE, true, 0, true) == "";
    assert acp_requests(decide(T_CLOSE, true, 0, true)) == 0;
}

test hold_scenario {
    assert decide(T_CREATE, false, 13028, true) == D_HOLD;
    assert why(T_CREATE, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_CREATE, false, 13028, true) == "";
    assert decide(T_PROMPT, false, 13028, true) == D_HOLD;
    assert why(T_PROMPT, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_PROMPT, false, 13028, true) == "";
    assert decide(T_CANCEL, false, 13028, true) == D_HOLD;
    assert why(T_CANCEL, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_CANCEL, false, 13028, true) == "";
    assert decide(T_LIST, false, 13028, true) == D_HOLD;
    assert why(T_LIST, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_LIST, false, 13028, true) == "";
    assert decide(T_RESUME, false, 13028, true) == D_HOLD;
    assert why(T_RESUME, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_RESUME, false, 13028, true) == "";
    assert decide(T_CLOSE, false, 13028, true) == D_HOLD;
    assert why(T_CLOSE, false, 13028, true) == R_NO_GO;
    assert acp_requests(D_HOLD) == 0;
    assert mapped_method(T_CLOSE, false, 13028, true) == "";
}

test create_with_in_scope_false_refuses_even_with_go_and_issue {
    assert decide(T_CREATE, true, 13028, false) == D_REFUSE;
    assert decide(T_CREATE, false, 13028, false) == D_REFUSE;
}

test prompt_with_in_scope_false_maps_when_go_and_issue_are_present {
    assert decide(T_PROMPT, true, 13028, false) == D_MAP;
    assert mapped_method(T_PROMPT, true, 13028, false) == "session/prompt";
}

test map_scenario {
    assert decide(T_CREATE, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_CREATE, true, 13028, true) == "session/new";
    assert decide(T_PROMPT, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_PROMPT, true, 13028, true) == "session/prompt";
    assert decide(T_CANCEL, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_CANCEL, true, 13028, true) == "session/cancel";
    assert decide(T_LIST, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_LIST, true, 13028, true) == "session/list";
    assert decide(T_RESUME, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_RESUME, true, 13028, true) == "session/resume";
    assert decide(T_CLOSE, true, 13028, true) == D_MAP;
    assert acp_requests(D_MAP) == 1;
    assert mapped_method(T_CLOSE, true, 13028, true) == "session/close";
}

test unknown_tools_refuse_even_with_go_issue_and_scope {
    assert why(T_NONE, true, 13028, true) == R_UNKNOWN_TOOL;
    assert decide(T_NONE, true, 13028, true) == D_REFUSE;
    assert why(7, true, 13028, true) == R_UNKNOWN_TOOL;
    assert decide(7, true, 13028, true) == D_REFUSE;
    assert why(255, true, 13028, true) == R_UNKNOWN_TOOL;
    assert decide(255, true, 13028, true) == D_REFUSE;
}

test order_unknown_tool_beats_issue_0 {
    assert why(T_NONE, true, 13028, true) == R_UNKNOWN_TOOL;
    assert why(T_CREATE, true, 0, true) == R_NO_ISSUE;
}

test order_issue_0_beats_out_of_scope {
    assert why(T_CREATE, true, 0, true) == R_NO_ISSUE;
    assert why(T_CREATE, true, 13028, false) == R_OUT_OF_SCOPE;
}

test order_out_of_scope_beats_no_go {
    assert why(T_CREATE, true, 13028, false) == R_OUT_OF_SCOPE;
    assert why(T_CREATE, false, 13028, false) == R_OUT_OF_SCOPE;
}

test exactly_one_acp_request_when_mapped {
    assert one_ok(T_CREATE, false, 0, true) == true;
    assert one_ok(T_CREATE, true, 0, true) == true;
    assert one_ok(T_CREATE, false, 13028, true) == true;
    assert one_ok(T_CREATE, true, 13028, true) == true;
    assert one_ok(T_PROMPT, false, 0, true) == true;
    assert one_ok(T_PROMPT, true, 0, true) == true;
    assert one_ok(T_PROMPT, false, 13028, true) == true;
    assert one_ok(T_PROMPT, true, 13028, true) == true;
    assert one_ok(T_CANCEL, false, 0, true) == true;
    assert one_ok(T_CANCEL, true, 0, true) == true;
    assert one_ok(T_CANCEL, false, 13028, true) == true;
    assert one_ok(T_CANCEL, true, 13028, true) == true;
    assert one_ok(T_LIST, false, 0, true) == true;
    assert one_ok(T_LIST, true, 0, true) == true;
    assert one_ok(T_LIST, false, 13028, true) == true;
    assert one_ok(T_LIST, true, 13028, true) == true;
    assert one_ok(T_RESUME, false, 0, true) == true;
    assert one_ok(T_RESUME, true, 0, true) == true;
    assert one_ok(T_RESUME, false, 13028, true) == true;
    assert one_ok(T_RESUME, true, 13028, true) == true;
    assert one_ok(T_CLOSE, false, 0, true) == true;
    assert one_ok(T_CLOSE, true, 0, true) == true;
    assert one_ok(T_CLOSE, false, 13028, true) == true;
    assert one_ok(T_CLOSE, true, 13028, true) == true;
    assert one_ok(T_CREATE, false, 13028, false) == true;
    assert one_ok(T_CREATE, true, 13028, false) == true;
}

test decide_path_works_with_paths {
    assert decide_path(T_CREATE, true, 13028, "specs/t27os/x.t27", 17) == D_MAP;
    assert decide_path(T_CREATE, true, 13028, "docs/x.t27", 10) == D_REFUSE;
    assert decide_path(T_CREATE, true, 13028, "specs/t27os/x.rs", 16) == D_REFUSE;
}

test tool_names_are_distinct {
    assert tool_name(T_CREATE) != tool_name(T_PROMPT);
    assert tool_name(T_CREATE) != tool_name(T_CANCEL);
    assert tool_name(T_PROMPT) != tool_name(T_CANCEL);
}

; --- 4. host requirements: what a bridge must still provide ---------------------------------------------
; Documented for MCP integration:
; 1. MCP initialize handshake on the MCP side: not wired in this spec.
; 2. Spawn the 'dsh' ACP profile and the ACP initialize call: not wired.
; 3. stdio newline-delimited JSON-RPC framing: not wired (a gap that t27c cannot express goes to gHashTag/t27#5980 with a minimal .t27 repro, never hand-written).
; 4. Read the go file (path from specs/crons/general_conductor.t27 GC_GO_FILE): not wired.
; 5. Resolve tool name to its id: compare with tool_name(1..6).
; 6. Derive issue and path from the call: not wired.
; 7. Register the server: owner's word only.
; 8. Logging: not wired.
; Plainly: none of the integration exists today. This spec holds only the table and the gate.