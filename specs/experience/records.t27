// SPDX-License-Identifier: Apache-2.0
; specs/experience/records.t27 -- what an experience record IS, for the E EXPERIENCE petal
; Owner directive (petal unblock wave): E was blocked-by-law because no spec said what a record
; is. This card is that law, and it is honest by construction:
; - a record has an identity, a kind, and at least one reference to where its content came from
;   (a spec path, an issue number, a command receipt). A record that names no source invents its
;   data, and this law refuses it.
; - a record may carry a number only when the entry states the command that measured it; an
;   unmeasured entry carries the explicit zero-and-unmeasured shape, never a guessed value.
; - truth law: a FIXTURE record is a hand-written or replayed entry used to test the petal's
;   drawing and folding; a LIVE record is one written by a real session's wrap-up. A fixture
;   record proves layout laws and is never published as the experience of real work.
; Feeding: once the petal is fed records that pass this law, E may claim: it shows real recorded
; experience, each entry sourced, each number measured or explicitly not measured. It may not
; claim: that the experience is current, verified, or complete -- those are the source's to say.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ExperienceRecords;

use queen::actor_semantics::TRUTH_FIXTURE;
use queen::actor_semantics::TRUTH_LIVE;

; --- 1. Identity --------------------------------------------------------------------------------------

/// A record id packs the session that wrote it and the entry number within that session. One home
/// per session: the entry number is local to its writer, the session id is the global half.
pub const XR_STRIDE : u64 = 4096;

pub fn xr_record_id(session: u64, entry: u32) -> u64 {
    return session * XR_STRIDE + entry as u64;
}

pub fn xr_record_session(rid: u64) -> u64 {
    return rid / XR_STRIDE;
}

pub fn xr_record_entry(rid: u64) -> u32 {
    return (rid % XR_STRIDE) as u32;
}

; --- 2. Kinds -----------------------------------------------------------------------------------------

pub const XK_LESSON : u8 = 0;
pub const XK_DECISION : u8 = 1;
pub const XK_MEASUREMENT : u8 = 2;
pub const XK_PATTERN : u8 = 3;
pub const RECORD_KINDS : u8 = 4;
pub const KIND_NAMES : [4]str = ["lesson", "decision", "measurement", "pattern"];

pub fn xr_kind_ok(kind: u8) -> bool {
    return kind < RECORD_KINDS;
}

; --- 3. References: no invented data ------------------------------------------------------------------

/// Every record cites at least one source, and every source is one of the kinds this law knows:
/// a spec path (token), an issue number (> 0), or a command receipt (a non-empty command id).
pub const XS_SPEC : u8 = 0;
pub const XS_ISSUE : u8 = 1;
pub const XS_COMMAND : u8 = 2;
pub const SOURCE_KINDS : u8 = 3;

pub fn xr_source_kind_ok(sk: u8) -> bool {
    return sk < SOURCE_KINDS;
}

/// A record with zero references invents its data: refused.
pub fn xr_references_ok(refs: u32) -> bool {
    return refs >= 1;
}

/// An issue reference is a real number; a command receipt is non-empty; a spec path token is
/// bounded and non-empty (TOKEN_MAX as events.t27 bounds its tokens).
pub const TOKEN_MAX : usize = 128;

pub fn xr_source_value_ok(sk: u8, number: u64, token_len: usize) -> bool {
    if (xr_source_kind_ok(sk) == false) { return false; }
    if (sk == XS_ISSUE) { return number > 0 and token_len == 0; }
    if (sk == XS_SPEC or sk == XS_COMMAND) { return token_len >= 1 and token_len <= TOKEN_MAX and number == 0; }
    return false;
}

; --- 4. Honest numbers --------------------------------------------------------------------------------

/// A record carries a number only when the entry states how it was measured. Unmeasured: the
/// value field must be the explicit nothing (0) and the honest flag false -- the petal then
/// prints "not measured", never 0 as a result.
pub const NOT_MEASURED : u64 = 0;

pub fn xr_value_ok(measured: bool, value: u64) -> bool {
    if (measured) { return true; }
    return value == NOT_MEASURED;
}

; --- 5. Truth -----------------------------------------------------------------------------------------

/// Whether a record may be published: only a LIVE one (a real session's wrap-up). A fixture
/// record proves the petal's layout and folding laws and stops there.
pub fn xr_publishable(truth: u8) -> bool {
    return truth == TRUTH_LIVE;
}

test a_record_id_splints_into_session_and_entry {
    let rid : u64 = xr_record_id(7, 3);
    assert xr_record_session(rid) == 7;
    assert xr_record_entry(rid) == 3;
    // two entries of one session never collide; two sessions never share an id
    assert xr_record_id(7, 3) != xr_record_id(7, 4);
    assert xr_record_id(7, 3) != xr_record_id(8, 3);
}

test the_kinds_are_four_and_named {
    assert RECORD_KINDS == 4;
    assert xr_kind_ok(XK_LESSON) == true;
    assert xr_kind_ok(XK_PATTERN) == true;
    assert xr_kind_ok(RECORD_KINDS) == false;
    assert xr_kind_ok(255) == false;
    assert KIND_NAMES[0] == "lesson" and KIND_NAMES[2] == "measurement";
}

test every_record_cites_its_sources {
    assert xr_references_ok(1) == true;
    assert xr_references_ok(5) == true;
    assert xr_references_ok(0) == false;
}

test a_source_names_one_real_thing {
    // an issue: a positive number, no token
    assert xr_source_value_ok(XS_ISSUE, 11377, 0) == true;
    assert xr_source_value_ok(XS_ISSUE, 0, 0) == false;
    assert xr_source_value_ok(XS_ISSUE, 5, 4) == false;
    // a spec path or a command receipt: a bounded non-empty token, no number
    assert xr_source_value_ok(XS_SPEC, 0, 22) == true;
    assert xr_source_value_ok(XS_COMMAND, 0, 12) == true;
    assert xr_source_value_ok(XS_SPEC, 0, 0) == false;
    assert xr_source_value_ok(XS_SPEC, 9, 3) == false;
    assert xr_source_value_ok(XS_SPEC, 0, TOKEN_MAX) == true;
    assert xr_source_value_ok(XS_SPEC, 0, TOKEN_MAX + 1) == false;
    // no such source kind
    assert xr_source_value_ok(SOURCE_KINDS, 1, 1) == false;
}

test a_number_needs_a_measurement {
    assert xr_value_ok(true, 42) == true;
    assert xr_value_ok(true, 0) == true;
    // unmeasured: only the explicit nothing, never a guessed value
    assert xr_value_ok(false, NOT_MEASURED) == true;
    assert xr_value_ok(false, 42) == false;
}

test a_fixture_record_is_never_published {
    assert xr_publishable(TRUTH_FIXTURE) == false;
    assert xr_publishable(TRUTH_LIVE) == true;
}

invariant the_record_law_has_one_home_per_concept {
    assert RECORD_KINDS == 4 and SOURCE_KINDS == 3;
    assert XR_STRIDE == 4096;
    assert TOKEN_MAX == 128;
    assert NOT_MEASURED == 0;
}
