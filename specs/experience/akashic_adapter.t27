; specs/experience/akashic_adapter.t27 -- the akashic-log row -> experience record adapter
; Owner directive (E/R/Y read-route wave): the E EXPERIENCE petal reads records.t27 entries, but
; the only writer so far is the host route (pipeline/experience_save.t27), which stays the named
; missing link. This card is the pure transformation between the two row shapes, so the petal can
; read an akashic-log dump without the host. No host I/O here: rows arrive as fixture words.
; ---
; WHAT IS DECIDED HERE: the akashic row shape (verdict, skill_len, notes_len, timestamp_ns,
; commit_hash -- the ExperienceRecord fields of experience_save.t27), the verdict -> record kind
; mapping (identity for pass/fail, exactly as experience_save's verdict_to_code does), the law
; that a SKIP row is dropped (a skip is not experience; converting it invents one), the honest
; reference-poor marking when both reference fields are absent (records.t27 demands at least one
; source; the adapter marks the row rather than inventing a citation), and the notes_len ->
; measured/unmeasured value law (records.t27: a number needs a measurement).
; Fixture-fed only: the pinned rows below are FIXTURE truth and never publishable as live.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module ExperienceAkashicAdapter;

use experience::records::XK_LESSON;
use experience::records::XK_DECISION;
use experience::records::XK_MEASUREMENT;
use experience::records::RECORD_KINDS;
use experience::records::xr_kind_ok;
use experience::records::xr_references_ok;
use experience::records::xr_value_ok;
use experience::records::xr_source_value_ok;
use experience::records::xr_publishable;
use experience::records::NOT_MEASURED;
use experience::records::TOKEN_MAX;
use experience::records::XS_SPEC;
use experience::records::XS_COMMAND;
use queen::actor_semantics::TRUTH_FIXTURE;
use queen::actor_semantics::TRUTH_LIVE;

; --- 1. The akashic row ------------------------------------------------------------------------------

/// The akashic-log row, field for field the ExperienceRecord of pipeline/experience_save.t27.
/// The verdict values are pinned here because experience_save's constants are private to its
/// card; the values are its VERDICT_PASS/FAIL/SKIP.
pub const AK_VERDICT_PASS : u8 = 0;
pub const AK_VERDICT_FAIL : u8 = 1;
pub const AK_VERDICT_SKIP : u8 = 2;
pub const AK_VERDICTS : u8 = 3;

pub fn ak_verdict_ok(verdict : u8) -> bool {
    return verdict < AK_VERDICTS;
}

/// A SKIP row is not experience: the adapter drops it, never converts it into a record.
pub fn ak_is_record(verdict : u8) -> bool {
    return verdict != AK_VERDICT_SKIP;
}

/// The verdict passes through as the record kind (identity, like verdict_to_code upstream):
/// pass writes a lesson, fail writes a decision, and the third slot stays out of the mapping
/// because skips never reach this function.
pub fn ak_kind(verdict : u8) -> u8 {
    return verdict;
}

; --- 2. References ----------------------------------------------------------------------------------

/// A row cites its sources through its reference fields: a non-empty skill (a spec token) and a
/// non-zero commit (a command receipt). A row with neither is REFERENCE-POOR: the adapter says so
/// instead of inventing a citation, and records.t27 refuses it as an entry.
pub fn ak_reference_poor(skill_len : u64, commit_hash : u64) -> bool {
    return skill_len == 0 and commit_hash == 0;
}

/// How many sources the row carries.
pub fn ak_reference_count(skill_len : u64, commit_hash : u64) -> u32 {
    var n : u32 = 0;
    if (skill_len > 0) { n = n + 1; }
    if (commit_hash != 0) { n = n + 1; }
    return n;
}

/// The skill token length must fit the records token law (a spec path, bounded).
pub fn ak_skill_ok(skill_len : u64) -> bool {
    return skill_len == 0 or (skill_len <= TOKEN_MAX as u64 and xr_source_value_ok(XS_SPEC, 0, skill_len as usize));
}

/// The commit hash rides as a command receipt (a bounded non-empty token stands in for it).
pub fn ak_commit_ok(commit_hash : u64) -> bool {
    return commit_hash == 0 or xr_source_value_ok(XS_COMMAND, 0, 8);
}

; --- 3. The value -----------------------------------------------------------------------------------

/// notes_len is the only number the row carries. Measured when the notes exist, otherwise the
/// explicit nothing -- records.t27 refuses a number without its measurement.
pub fn ak_value_measured(notes_len : u64) -> bool {
    return notes_len > 0;
}

pub fn ak_value(notes_len : u64) -> u64 {
    if (ak_value_measured(notes_len)) { return notes_len; }
    return NOT_MEASURED;
}

; --- 4. The entry -----------------------------------------------------------------------------------

/// The whole row against the records law: a real verdict, a legal kind, at least one reference
/// (never reference-poor), and the value law. This is the gate the petal reads through.
pub fn ak_entry_ok(verdict : u8, skill_len : u64, notes_len : u64, commit_hash : u64) -> bool {
    if (ak_is_record(verdict) == false) { return false; }
    if (xr_kind_ok(ak_kind(verdict)) == false) { return false; }
    if (ak_reference_poor(skill_len, commit_hash)) { return false; }
    if (xr_references_ok(ak_reference_count(skill_len, commit_hash)) == false) { return false; }
    if (ak_skill_ok(skill_len) == false) { return false; }
    if (ak_commit_ok(commit_hash) == false) { return false; }
    return xr_value_ok(ak_value_measured(notes_len), ak_value(notes_len));
}

; --- 5. The fixture ---------------------------------------------------------------------------------

/// The pinned fixture rows: four akashic rows replayed for the petal's tests -- a clean pass, a
/// clean fail, a reference-poor row, and a skip. FIXTURE truth, never published as live.
pub const FK_VERDICT : [4]u8 = [AK_VERDICT_PASS, AK_VERDICT_FAIL, AK_VERDICT_PASS, AK_VERDICT_SKIP];
pub const FK_SKILL : [4]u64 = [22, 31, 0, 0];
pub const FK_NOTES : [4]u64 = [140, 0, 55, 0];
pub const FK_COMMIT : [4]u64 = [16993466740395317137, 0, 0, 0];

// ---------------------------------------------------------------- tests

test the_row_shape_carries_the_experience_save_verdicts {
    assert(AK_VERDICT_PASS == 0 and AK_VERDICT_FAIL == 1 and AK_VERDICT_SKIP == 2);
    assert(ak_verdict_ok(AK_VERDICT_PASS) and ak_verdict_ok(AK_VERDICT_SKIP));
    assert(ak_verdict_ok(AK_VERDICTS) == false);
}

test a_skip_row_is_dropped_never_converted {
    assert(ak_is_record(AK_VERDICT_PASS) and ak_is_record(AK_VERDICT_FAIL));
    assert(ak_is_record(AK_VERDICT_SKIP) == false);
    // and the gate refuses the whole row for it
    assert(ak_entry_ok(AK_VERDICT_SKIP, 22, 140, 1) == false);
}

test the_verdict_passes_through_as_the_kind {
    assert(ak_kind(AK_VERDICT_PASS) == XK_LESSON);
    assert(ak_kind(AK_VERDICT_FAIL) == XK_DECISION);
    // the kind must be legal against the records law
    assert(xr_kind_ok(ak_kind(AK_VERDICT_PASS)) and xr_kind_ok(ak_kind(AK_VERDICT_FAIL)));
}

test a_row_without_references_is_marked_reference_poor {
    assert(ak_reference_poor(0, 0));
    assert(ak_reference_poor(22, 0) == false);
    assert(ak_reference_poor(0, 7) == false);
    // the fixture's third row is the reference-poor one, and the gate refuses it honestly
    assert(ak_reference_poor(FK_SKILL[2], FK_COMMIT[2]));
    assert(ak_entry_ok(FK_VERDICT[2], FK_SKILL[2], FK_NOTES[2], FK_COMMIT[2]) == false);
    // a cited row carries its count against the records reference law
    assert(ak_reference_count(22, 7) == 2 and xr_references_ok(2));
    assert(ak_reference_count(22, 0) == 1 and xr_references_ok(1));
}

test the_notes_number_needs_its_measurement {
    // measured: the notes length rides as the value
    assert(ak_value_measured(140) and ak_value(140) == 140);
    // unmeasured: the explicit nothing, never a guessed number
    assert(ak_value_measured(0) == false and ak_value(0) == NOT_MEASURED);
    assert(xr_value_ok(ak_value_measured(FK_NOTES[0]), ak_value(FK_NOTES[0])));
    assert(xr_value_ok(ak_value_measured(FK_NOTES[1]), ak_value(FK_NOTES[1])));
    // the skill token obeys the records token bound
    assert(ak_skill_ok(22) and ak_skill_ok(0) and ak_skill_ok(TOKEN_MAX as u64 + 1) == false);
}

test the_fixture_rows_read_as_the_records_law_says {
    // row 0: a clean pass with both references -- a full record
    assert(ak_entry_ok(FK_VERDICT[0], FK_SKILL[0], FK_NOTES[0], FK_COMMIT[0]));
    // row 1: a fail with a skill but no commit -- still cited, still a record
    assert(ak_entry_ok(FK_VERDICT[1], FK_SKILL[1], FK_NOTES[1], FK_COMMIT[1]));
    // row 2: reference-poor -- refused above; row 3: skip -- dropped above
    assert(ak_entry_ok(FK_VERDICT[3], FK_SKILL[3], FK_NOTES[3], FK_COMMIT[3]) == false);
    // the fixture is fixture truth: never publishable as the experience of real work
    assert(xr_publishable(TRUTH_FIXTURE) == false and xr_publishable(TRUTH_LIVE));
}

invariant the_adapter_adds_no_second_record_law {
    assert(RECORD_KINDS == 4 and AK_VERDICTS == 3);
    assert(ak_reference_poor(0, 0) and ak_reference_poor(1, 1) == false);
}
