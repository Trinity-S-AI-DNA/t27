// SPDX-License-Identifier: Apache-2.0
; 01 -- Values and types
; Lesson 1 of the t27 tutorial. Every constant carries an explicit width,
; because a spec has to say what reaches hardware rather than let a compiler
; pick for it. Nothing here is inferred.
; phi^2 + 1/phi^2 = 3 | TRINITY

module tutorial-01-values;

// ============================================================================
// Integers
//
// Width and signedness are part of the name's type, always written out.
// u = unsigned, i = signed, and the number is the bit width.
// ============================================================================

pub const SMALL_UNSIGNED : u8 = 200;
pub const SMALL_SIGNED : i8 = -100;
pub const WIDE_UNSIGNED : u16 = 65535;
pub const WIDER : u32 = 4000000000;
pub const SIGNED_32 : i32 = -2000000;

// ============================================================================
// Other bases
//
// Hex and binary are ordinary integer literals. Binary is worth using wherever
// the value IS a bit pattern -- a mask written as 0b111111111 documents its own
// width in a way that 511 does not.
// ============================================================================

pub const AS_HEX : u16 = 0xFFFF;
pub const AS_BINARY : u8 = 0b1010;
pub const MANTISSA_MASK : u16 = 0b111111111;

// ============================================================================
// Floats and booleans
// ============================================================================

pub const RATIO : f32 = 1.5;
pub const PRECISE : f64 = 2.25;

pub const ENABLED : bool = true;
pub const DISABLED : bool = false;

// ============================================================================
// The trit
//
// This language is built on three states rather than two. A trit is stored in
// an i8 and is only ever -1, 0 or +1; the invariant at the bottom is what
// makes that a claim rather than a comment.
// ============================================================================

pub const TRIT_NEG : i8 = -1;
pub const TRIT_ZERO : i8 = 0;
pub const TRIT_POS : i8 = 1;

pub const TRINITY : i8 = 3;

// ============================================================================
// Invariants
//
// An invariant states something that must hold for the module as a whole. It
// is checked, not decorative.
// ============================================================================

// ============================================================================
// Tests
//
// A test states something about the values above that would break if one of
// them were written wrong. Each assert names a concrete number, so a typo in a
// constant fails here rather than in whatever reads it later.
//
// Each test first copies the constants into `var` locals. A constant compared
// with a constant is settled by the compiler before any test runs, so nothing
// would be checked at run time; a `var` is a value the program holds, and
// reading it is the run-time check. That is also the difference between the
// two: `const` is a fact about the spec, `var` is storage.
// ============================================================================

test "each base spells the number it claims" {
    var hex : u16 = AS_HEX;
    var bin : u8 = AS_BINARY;
    var mask : u16 = MANTISSA_MASK;
    try std.testing.expectEqual(@as(u16, 65535), hex);
    try std.testing.expectEqual(WIDE_UNSIGNED, hex);
    try std.testing.expectEqual(@as(u8, 10), bin);
    try std.testing.expectEqual(@as(u16, 511), mask);
}

test "signed and unsigned constants hold their written values" {
    var small_u : u8 = SMALL_UNSIGNED;
    var small_i : i8 = SMALL_SIGNED;
    var wider : u32 = WIDER;
    var signed_32 : i32 = SIGNED_32;
    try std.testing.expectEqual(@as(u8, 200), small_u);
    try std.testing.expectEqual(@as(i8, -100), small_i);
    try std.testing.expectEqual(@as(u32, 4000000000), wider);
    try std.testing.expectEqual(@as(i32, -2000000), signed_32);
}

test "the three trits are distinct and sum to zero" {
    var neg : i8 = TRIT_NEG;
    var zero : i8 = TRIT_ZERO;
    var pos : i8 = TRIT_POS;
    try std.testing.expectEqual(@as(i8, 0), neg + zero + pos);
    try std.testing.expectEqual(TRINITY, pos - neg + 1);
    try std.testing.expect(neg < zero);
    try std.testing.expect(zero < pos);
}

test "floats and booleans" {
    var ratio : f32 = RATIO;
    var precise : f64 = PRECISE;
    var on : bool = ENABLED;
    var off : bool = DISABLED;
    try std.testing.expectEqual(@as(f32, 3.0), ratio * 2.0);
    try std.testing.expectEqual(@as(f64, 4.5), precise * 2.0);
    try std.testing.expect(on);
    try std.testing.expect(!off);
}

invariant trit_range_is_three_states
    assert TRIT_POS - TRIT_NEG + 1 == TRINITY

invariant masks_match_their_widths
    assert MANTISSA_MASK == 511
