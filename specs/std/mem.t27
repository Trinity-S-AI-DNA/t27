// SPDX-License-Identifier: Apache-2.0
// specs/std/mem.t27 -- the loops over byte runs that every text-scanning spec in this tree used to copy:
// equality, prefix, suffix, find, count, trim. Written once (epic gHashTag/t27#12444, row B).
// Measured 2026-10-25: 216 helpers take two text parameters and answer a bool (`same_text` x12,
// `contains` x11, `str_eq` x10, `starts_with` x9, `ends_with` x8, `bytes_eq` x4 and about 40 more
// names), and 44 of them have the exact signature `(a: []const u8, b: []const u8)` that `bytes_eq` has here.
// The ratchet cannot join them: its body key includes the parameter names.
// Signature: `[]const u8` with `.len`, the shape the callers already have. (The t27os `(s, n)` pairs
// are the exception, not the rule, and they can pass `s` as it is when `n` equals `s.len`.)
// Every name carries the `bytes_` prefix on purpose: the `use` splice refuses two different bodies under
// one bare name (R4), and `starts_with`, `ends_with`, `contains` already exist in this tree with other
// signatures; a caller that imports `bytes_starts_with` cannot collide with them.
// No dependency on std::text, no module constants (same reason as std::text), and a lookup answers -1
// when it finds nothing, so an index is a signed `i64`.
// Not for hardware specs (the ones that lower to Verilog) until gHashTag/t27#8769 is closed.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module std::mem;

/// The two runs have the same length and the same bytes.
pub fn bytes_eq(x: []const u8, y: []const u8) -> bool {
    if (x.len != y.len) { return false; }
    var k : usize = 0;
    while (k < x.len) {
        if (x[k] != y[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// The first n bytes are the same; false when either run is shorter than n.
pub fn bytes_eq_prefix(x: []const u8, y: []const u8, n: usize) -> bool {
    if (x.len < n or y.len < n) { return false; }
    var k : usize = 0;
    while (k < n) {
        if (x[k] != y[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// s begins with p (the empty prefix is always there).
pub fn bytes_starts_with(s: []const u8, p: []const u8) -> bool {
    if (s.len < p.len) { return false; }
    return bytes_eq_prefix(s, p, p.len);
}

/// s ends with q (the empty suffix is always there).
pub fn bytes_ends_with(s: []const u8, q: []const u8) -> bool {
    if (s.len < q.len) { return false; }
    const off = s.len - q.len;
    var k : usize = 0;
    while (k < q.len) {
        if (s[off + k] != q[k]) { return false; }
        k = k + 1;
    }
    return true;
}

/// The index of the first place `needle` occurs in `s`, or -1. The empty needle is found at 0.
pub fn bytes_index_of(s: []const u8, needle: []const u8) -> i64 {
    if (needle.len > s.len) { return -1; }
    const last = s.len - needle.len;
    var at : usize = 0;
    while (at <= last) {
        var k : usize = 0;
        while (k < needle.len and s[at + k] == needle[k]) { k = k + 1; }
        if (k == needle.len) { return @as(i64, @intCast(at)); }
        at = at + 1;
    }
    return -1;
}

/// `needle` occurs somewhere in `s`.
pub fn bytes_contains(s: []const u8, needle: []const u8) -> bool {
    return bytes_index_of(s, needle) >= 0;
}

/// The index of the first byte equal to b, or -1.
pub fn bytes_index_of_byte(s: []const u8, b: u8) -> i64 {
    var k : usize = 0;
    while (k < s.len) {
        if (s[k] == b) { return @as(i64, @intCast(k)); }
        k = k + 1;
    }
    return -1;
}

/// How many bytes of s are equal to b.
pub fn bytes_count(s: []const u8, b: u8) -> u32 {
    var n : u32 = 0;
    var k : usize = 0;
    while (k < s.len) {
        if (s[k] == b) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

/// The index of the first byte of s that is not b; s.len when every byte is b.
pub fn bytes_trim_start(s: []const u8, b: u8) -> usize {
    var k : usize = 0;
    while (k < s.len and s[k] == b) { k = k + 1; }
    return k;
}

/// One past the last byte of s that is not b; 0 when every byte is b.
pub fn bytes_trim_end(s: []const u8, b: u8) -> usize {
    var e : usize = s.len;
    while (e > 0 and s[e - 1] == b) { e = e - 1; }
    return e;
}

test eq_takes_equal_runs {
    assert bytes_eq("abc", "abc");
    assert bytes_eq("", "");
    assert bytes_eq("a", "a");
}

test eq_refuses_a_different_byte_at_either_end {
    assert bytes_eq("abc", "abd") == false;
    assert bytes_eq("abc", "xbc") == false;
    assert bytes_eq("abc", "axc") == false;
}

test eq_refuses_a_different_length {
    assert bytes_eq("abc", "ab") == false;
    assert bytes_eq("ab", "abc") == false;
    assert bytes_eq("a", "") == false;
    assert bytes_eq("", "a") == false;
}

test eq_prefix_takes_the_first_n_bytes {
    assert bytes_eq_prefix("abcd", "abxy", 2);
    assert bytes_eq_prefix("abc", "xyz", 0);
    assert bytes_eq_prefix("ab", "ab", 2);
}

test eq_prefix_refuses_the_byte_at_n_minus_one {
    assert bytes_eq_prefix("abcd", "abxy", 3) == false;
    assert bytes_eq_prefix("abcd", "xbcd", 1) == false;
}

test eq_prefix_refuses_a_run_shorter_than_n {
    assert bytes_eq_prefix("ab", "abcd", 3) == false;
    assert bytes_eq_prefix("abcd", "ab", 3) == false;
    assert bytes_eq_prefix("", "", 1) == false;
}

test starts_with_takes_a_prefix {
    assert bytes_starts_with("hello", "he");
    assert bytes_starts_with("hello", "hello");
    assert bytes_starts_with("hello", "");
    assert bytes_starts_with("", "");
}

test starts_with_refuses_other_bytes_and_longer_prefixes {
    assert bytes_starts_with("he", "hello") == false;
    assert bytes_starts_with("hello", "hf") == false;
    assert bytes_starts_with("hello", "ello") == false;
    assert bytes_starts_with("", "h") == false;
}

test ends_with_takes_a_suffix {
    assert bytes_ends_with("hello", "llo");
    assert bytes_ends_with("hello", "hello");
    assert bytes_ends_with("hello", "");
    assert bytes_ends_with("", "");
}

test ends_with_refuses_other_bytes_and_longer_suffixes {
    assert bytes_ends_with("llo", "hello") == false;
    assert bytes_ends_with("hello", "lla") == false;
    assert bytes_ends_with("hello", "hell") == false;
    assert bytes_ends_with("", "o") == false;
}

test index_of_finds_the_first_place {
    assert bytes_index_of("abcabc", "bc") == 1;
    assert bytes_index_of("abcabc", "a") == 0;
    assert bytes_index_of("abcabc", "abc") == 0;
}

test index_of_finds_the_last_possible_place {
    assert bytes_index_of("abcd", "cd") == 2;
    assert bytes_index_of("abcd", "d") == 3;
}

test index_of_answers_minus_one_when_absent {
    assert bytes_index_of("abcd", "x") == -1;
    assert bytes_index_of("abcd", "dc") == -1;
    assert bytes_index_of("abcd", "cde") == -1;
}

test index_of_the_empty_needle_is_at_zero {
    assert bytes_index_of("abc", "") == 0;
    assert bytes_index_of("", "") == 0;
}

test index_of_a_needle_longer_than_the_run_is_absent {
    assert bytes_index_of("ab", "abc") == -1;
    assert bytes_index_of("", "a") == -1;
}

test index_of_a_partial_match_does_not_count {
    assert bytes_index_of("aab", "ab") == 1;
    assert bytes_index_of("aaab", "aab") == 1;
    assert bytes_index_of("aaa", "aab") == -1;
}

test contains_agrees_with_index_of {
    assert bytes_contains("hello world", "o w");
    assert bytes_contains("hello", "hello");
    assert bytes_contains("hello", "");
}

test contains_refuses_what_is_not_there {
    assert bytes_contains("hello", "world") == false;
    assert bytes_contains("", "a") == false;
    assert bytes_contains("hello", "hellos") == false;
}

test index_of_byte_finds_the_first {
    assert bytes_index_of_byte("a,b,c", 44) == 1;
    assert bytes_index_of_byte("a,b,c", 97) == 0;
    assert bytes_index_of_byte("a,b,c", 99) == 4;
}

test index_of_byte_answers_minus_one_when_absent {
    assert bytes_index_of_byte("a,b,c", 59) == -1;
    assert bytes_index_of_byte("", 44) == -1;
}

test count_counts_every_occurrence {
    assert bytes_count("a,b,c", 44) == 2;
    assert bytes_count("aaa", 97) == 3;
    assert bytes_count(",", 44) == 1;
}

test count_of_an_absent_byte_is_zero {
    assert bytes_count("abc", 44) == 0;
    assert bytes_count("", 44) == 0;
}

test trim_start_skips_the_leading_run {
    assert bytes_trim_start("  ab", 32) == 2;
    assert bytes_trim_start("ab", 32) == 0;
    assert bytes_trim_start(" ab ", 32) == 1;
}

test trim_start_of_a_run_of_only_b_is_the_length {
    assert bytes_trim_start("   ", 32) == 3;
    assert bytes_trim_start("", 32) == 0;
}

test trim_end_skips_the_trailing_run {
    assert bytes_trim_end("ab  ", 32) == 2;
    assert bytes_trim_end("ab", 32) == 2;
    assert bytes_trim_end(" ab ", 32) == 3;
}

test trim_end_of_a_run_of_only_b_is_zero {
    assert bytes_trim_end("   ", 32) == 0;
    assert bytes_trim_end("", 32) == 0;
}

test trim_leaves_the_inner_run {
    assert bytes_trim_start("a  b", 32) == 0;
    assert bytes_trim_end("a  b", 32) == 4;
    assert bytes_trim_end(" a  b ", 32) - bytes_trim_start(" a  b ", 32) == 4;
}
