// SPDX-License-Identifier: Apache-2.0
// specs/std/text.t27 -- the byte classes every text-scanning spec in this tree used to copy: digit, letter,
// space, hex, word, and the two case folds. Written once (epic gHashTag/t27#12444, row A).
// Measured 2026-10-25: `is_digit` was defined 36 times in 12 text variants, `is_alnum`, `is_space` and
// `is_hex` in dozens more, and the duplicate-bodies ratchet reported none of them as a group because its
// body key includes the parameter names (`c` vs `b`). A spec now writes `use std::text::is_digit;` (one
// line, spliced by `use_resolve`) instead of a 3-line body, and a bug fix lands once.
// Every function takes ONE byte and answers about ASCII only; a byte above 127 is none of the classes.
// No module-level constants on purpose: the `use` splice keys declarations by bare name, so a constant here
// named like an importer's own (`B_ZERO`, `C_NINE`) would turn into an ambiguity. Literals stay inside
// the bodies.
// Not for hardware specs (the ones that lower to Verilog) until gHashTag/t27#8769 is closed: `gen-verilog`
// does not splice `use`d functions.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module std::text;

/// '0' .. '9'.
pub fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57;
}

/// 'A' .. 'Z'.
pub fn is_upper(b: u8) -> bool {
    return b >= 65 and b <= 90;
}

/// 'a' .. 'z'.
pub fn is_lower(b: u8) -> bool {
    return b >= 97 and b <= 122;
}

/// A letter of the ASCII alphabet.
pub fn is_alpha(b: u8) -> bool {
    return is_upper(b) or is_lower(b);
}

/// A letter or a digit.
pub fn is_alnum(b: u8) -> bool {
    return is_alpha(b) or is_digit(b);
}

/// A byte of a word: a letter, a digit or '_'.
pub fn is_word(b: u8) -> bool {
    return is_alnum(b) or b == 95;
}

/// Space, tab, line feed or carriage return. Vertical tab and form feed are not.
pub fn is_space(b: u8) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13;
}

/// A hexadecimal digit of either case. Written through `hex_value` so this body is not a fresh copy of
/// the one `tri/loop/lesson.t27` still carries (that copy moves here in a later batch: it feeds a tracked
/// generated file).
pub fn is_hex(b: u8) -> bool {
    return hex_value(b) >= 0;
}

/// The value of a decimal digit, or -1 when the byte is not one.
pub fn digit_value(b: u8) -> i32 {
    if (is_digit(b)) { return b - 48; }
    return -1;
}

/// The value of a hexadecimal digit of either case, or -1 when the byte is not one.
pub fn hex_value(b: u8) -> i32 {
    if (is_digit(b)) { return b - 48; }
    if (b >= 65 and b <= 70) { return b - 55; }
    if (b >= 97 and b <= 102) { return b - 87; }
    return -1;
}

/// The lower-case letter of an upper-case one; every other byte unchanged.
pub fn to_lower(b: u8) -> u8 {
    if (is_upper(b)) { return b + 32; }
    return b;
}

/// The upper-case letter of a lower-case one; every other byte unchanged.
pub fn to_upper(b: u8) -> u8 {
    if (is_lower(b)) { return b - 32; }
    return b;
}

test is_digit_takes_the_ten_digits {
    assert is_digit(48) and is_digit(53) and is_digit(57);
}

test is_digit_refuses_the_bytes_next_to_the_range {
    assert is_digit(47) == false;
    assert is_digit(58) == false;
    assert is_digit(0) == false;
    assert is_digit(255) == false;
}

test is_upper_takes_a_to_z_capitals_only {
    assert is_upper(65) and is_upper(77) and is_upper(90);
    assert is_upper(64) == false;
    assert is_upper(91) == false;
    assert is_upper(97) == false;
}

test is_lower_takes_a_to_z_only {
    assert is_lower(97) and is_lower(109) and is_lower(122);
    assert is_lower(96) == false;
    assert is_lower(123) == false;
    assert is_lower(65) == false;
}

test is_alpha_is_a_letter_of_either_case {
    assert is_alpha(65) and is_alpha(90) and is_alpha(97) and is_alpha(122);
    assert is_alpha(48) == false;
    assert is_alpha(95) == false;
}

test is_alpha_refuses_the_gap_between_the_cases {
    assert is_alpha(91) == false;
    assert is_alpha(92) == false;
    assert is_alpha(94) == false;
    assert is_alpha(96) == false;
}

test is_alnum_is_a_letter_or_a_digit {
    assert is_alnum(48) and is_alnum(57) and is_alnum(65) and is_alnum(122);
    assert is_alnum(95) == false;
    assert is_alnum(32) == false;
}

test is_alnum_refuses_a_byte_above_127 {
    assert is_alnum(128) == false;
    assert is_alnum(200) == false;
    assert is_alnum(255) == false;
}

test is_word_adds_the_underscore_to_alnum {
    assert is_word(95) and is_word(97) and is_word(65) and is_word(48);
    assert is_word(45) == false;
    assert is_word(94) == false;
    assert is_word(96) == false;
}

test is_space_is_four_bytes {
    assert is_space(32) and is_space(9) and is_space(10) and is_space(13);
}

test is_space_refuses_vertical_tab_form_feed_and_nul {
    assert is_space(11) == false;
    assert is_space(12) == false;
    assert is_space(0) == false;
    assert is_space(160) == false;
}

test is_hex_takes_both_cases_and_the_digits {
    assert is_hex(48) and is_hex(57) and is_hex(65) and is_hex(70) and is_hex(97) and is_hex(102);
}

test is_hex_refuses_the_letters_past_f {
    assert is_hex(71) == false;
    assert is_hex(103) == false;
    assert is_hex(90) == false;
    assert is_hex(122) == false;
    assert is_hex(64) == false;
    assert is_hex(96) == false;
}

test digit_value_is_the_digit {
    assert digit_value(48) == 0;
    assert digit_value(55) == 7;
    assert digit_value(57) == 9;
}

test digit_value_of_a_non_digit_is_minus_one {
    assert digit_value(47) == -1;
    assert digit_value(58) == -1;
    assert digit_value(97) == -1;
}

test hex_value_reads_the_digits {
    assert hex_value(48) == 0;
    assert hex_value(57) == 9;
}

test hex_value_reads_both_cases_to_the_same_number {
    assert hex_value(65) == 10 and hex_value(97) == 10;
    assert hex_value(70) == 15 and hex_value(102) == 15;
    assert hex_value(67) == hex_value(99);
}

test hex_value_of_a_non_hex_byte_is_minus_one {
    assert hex_value(71) == -1;
    assert hex_value(103) == -1;
    assert hex_value(64) == -1;
    assert hex_value(96) == -1;
    assert hex_value(255) == -1;
}

test to_lower_folds_the_capitals {
    assert to_lower(65) == 97;
    assert to_lower(90) == 122;
    assert to_lower(77) == 109;
}

test to_lower_leaves_every_other_byte {
    assert to_lower(97) == 97;
    assert to_lower(64) == 64;
    assert to_lower(91) == 91;
    assert to_lower(48) == 48;
    assert to_lower(255) == 255;
}

test to_upper_folds_the_small_letters {
    assert to_upper(97) == 65;
    assert to_upper(122) == 90;
    assert to_upper(109) == 77;
}

test to_upper_leaves_every_other_byte {
    assert to_upper(65) == 65;
    assert to_upper(96) == 96;
    assert to_upper(123) == 123;
    assert to_upper(48) == 48;
    assert to_upper(0) == 0;
}

test the_two_folds_undo_each_other_on_every_letter {
    assert to_upper(to_lower(71)) == 71;
    assert to_lower(to_upper(103)) == 103;
}
