// SPDX-License-Identifier: Apache-2.0
// specs/std/signmag.t27 -- std::signmag GF-T core, blocked on #8769.
// Sign-magnitude core for GF-T formats: sign bit + magnitude.
// Part of M5 milestone (milestone #9). Closes #12448.
// phi^2 + 1/phi^2 = 3 | TRINITY

module std::signmag;

pub const SIGNMAG_BITS : u32 = 16;
pub const SIGNMAG_EXP_BITS : u32 = 5;
pub const SIGNMAG_MANT_BITS : u32 = 10;

pub struct SignMag { sign: bool, exp: u32, mant: u32 };

pub fn signmag_sign(s: SignMag) -> bool {
    return s.sign;
}

pub fn signmag_exp(s: SignMag) -> u32 {
    return s.exp;
}

pub fn signmag_mant(s: SignMag) -> u32 {
    return s.mant;
}

pub fn signmag_zero() -> SignMag {
    return SignMag { sign: false, exp: 0, mant: 0 };
}

pub fn signmag_one() -> SignMag {
    return SignMag { sign: false, exp: SIGNMAG_EXP_BITS, mant: 0 };
}

test "signmag_zero_sign" {
    assert(!signmag_sign(signmag_zero()));
}

test "signmag_one_exp" {
    assert(signmag_exp(signmag_one()) == SIGNMAG_EXP_BITS);
}

test "signmag_zero_mant" {
    assert(signmag_mant(signmag_zero()) == 0);
}

invariant signmag_bits_positive {
    assert SIGNMAG_BITS > 0;
}

invariant signmag_exp_bits_positive {
    assert SIGNMAG_EXP_BITS > 0;
}

invariant signmag_mant_bits_positive {
    assert SIGNMAG_MANT_BITS > 0;
}