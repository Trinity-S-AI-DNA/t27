// specs/runtime/session_checkpoint_save.t27
// The session-checkpoint-save skill: it writes the durable checkpoint at a
// safe boundary, and when the write fails it keeps the last known-good
// checkpoint and says so.
//
// Owner: T27_SESSION_NEVER_DIES_01 (issue #12895), 2026-10-30.
//
// OWNS:
//   - the skill that saves a checkpoint at a safe boundary
//   - the atomicity of the save
//   - the failed-write behaviour: the previous known-good checkpoint survives,
//     the failure is visible, and the failed step is not reported durable
//   - the WRITE autonomy of this skill
//
// DOES NOT OWN (never restate these facts here):
//   - the versioned payload, the meaningful boundaries, the durable and failed
//     states and the last-known-good resume selection:
//     specs/runtime/session_continuity_contract.t27
//   - when a checkpoint is mandatory and the resume decision per state:
//     specs/system/session-continuity.t27
//   - the Doctor lifecycle states and the user-visible status bar:
//     specs/system/session-doctor.t27
//   - the recovery ladder levels: specs/system/session-recovery-ladder.t27
//   - the checkpoint verification skill:
//     specs/agents/dsh-session-recovery-verify.t27

module session_checkpoint_save;

// ─── Autonomy ──────────────────────────────────────────────────────────────
//
// The vocabulary is owned by the Doctor: specs/system/session-doctor.t27.

pub const AUTONOMY_WRITE : u8 = 3;

// ─── Safe boundaries ───────────────────────────────────────────────────────

pub const BOUNDARY_TOOL_CALL_COMPLETED : u8 = 0;
pub const BOUNDARY_SUBTASK_FINISHED : u8 = 1;
pub const BOUNDARY_ARTIFACT_WRITTEN : u8 = 2;
pub const BOUNDARY_PROVIDER_RESPONSE_COMMITTED : u8 = 3;
pub const BOUNDARY_COUNT : u32 = 4;

// ─── Save outcome ──────────────────────────────────────────────────────────

pub const SAVE_WRITTEN : u8 = 0;
pub const SAVE_SKIPPED : u8 = 1;
pub const SAVE_FAILED : u8 = 2;

// ─── Checkpoint states ─────────────────────────────────────────────────────

pub const CHECKPOINT_PENDING : u8 = 0;
pub const CHECKPOINT_DURABLE : u8 = 1;
pub const CHECKPOINT_FAILED : u8 = 2;

// ─── Functions ─────────────────────────────────────────────────────────────

// skill_name() - the skill this module is.
pub fn skill_name() -> u8 {
    return AUTONOMY_WRITE;
}

// skill_autonomy() - this skill writes session state and nothing else.
pub fn skill_autonomy() -> u8 {
    return AUTONOMY_WRITE;
}

// boundary_is_safe_to_save(boundary) -> bool
// A checkpoint is written at every meaningful step and at no other moment.
pub fn boundary_is_safe_to_save(boundary: u8) -> bool {
    if (boundary < BOUNDARY_COUNT) {
        return true;
    }
    return false;
}

// save_decision(boundary) -> u8
pub fn save_decision(boundary: u8) -> u8 {
    if (boundary_is_safe_to_save(boundary) == false) {
        return SAVE_SKIPPED;
    }
    return SAVE_WRITTEN;
}

// save_is_atomic(wrote_temp_file, renamed_into_place) -> bool
// A checkpoint that is half written is a checkpoint that cannot be trusted.
pub fn save_is_atomic(wrote_temp_file: bool, renamed_into_place: bool) -> bool {
    if (wrote_temp_file == false) {
        return false;
    }
    if (renamed_into_place == false) {
        return false;
    }
    return true;
}

// write_succeeded(outcome) -> bool
pub fn write_succeeded(outcome: u8) -> bool {
    if (outcome == SAVE_WRITTEN) {
        return true;
    }
    return false;
}

// durable_state_for_outcome(outcome) -> u8
// A written checkpoint is durable. A failed one is not, and a skipped one
// leaves the previous state alone.
pub fn durable_state_for_outcome(outcome: u8) -> u8 {
    if (outcome == SAVE_WRITTEN) {
        return CHECKPOINT_DURABLE;
    }
    if (outcome == SAVE_FAILED) {
        return CHECKPOINT_FAILED;
    }
    return CHECKPOINT_PENDING;
}

// failed_write_preserves_last_known_good(outcome, previous_was_durable) -> bool
// The previous known-good checkpoint is still there after a failed write.
pub fn failed_write_preserves_last_known_good(outcome: u8, previous_was_durable: bool) -> bool {
    if (outcome != SAVE_FAILED) {
        return true;
    }
    return previous_was_durable;
}

// failed_write_is_visible(outcome, user_notified) -> bool
// A failed write is announced: the user learns the work is no longer
// protected.
pub fn failed_write_is_visible(outcome: u8, user_notified: bool) -> bool {
    if (outcome != SAVE_FAILED) {
        return true;
    }
    return user_notified;
}

// failed_write_must_not_report_the_step_durable(outcome) -> bool
pub fn failed_write_must_not_report_the_step_durable(outcome: u8) -> bool {
    if (outcome == SAVE_FAILED) {
        return false;
    }
    return true;
}

// checkpoint_survives_a_crash(boundary, outcome, atomic) -> bool
// After a crash the last good checkpoint is still readable.
pub fn checkpoint_survives_a_crash(boundary: u8, outcome: u8, atomic: bool) -> bool {
    if (boundary_is_safe_to_save(boundary) == false) {
        return false;
    }
    if (write_succeeded(outcome) == false) {
        return false;
    }
    if (atomic == false) {
        return false;
    }
    return true;
}

// save_precedes_mutation(save_written, mutation_started) -> bool
// The checkpoint is on disk before the mutation it protects.
pub fn save_precedes_mutation(save_written: bool, mutation_started: bool) -> bool {
    if (mutation_started == false) {
        return true;
    }
    return save_written;
}

// ═══════════════════════════════════════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════════════════════════════════════

test "the_save_skill_writes_session_state" {
    assert(skill_autonomy() == AUTONOMY_WRITE);
}

test "a_checkpoint_is_saved_at_every_meaningful_boundary" {
    assert(BOUNDARY_COUNT == 4);
    assert(save_decision(BOUNDARY_TOOL_CALL_COMPLETED) == SAVE_WRITTEN);
    assert(save_decision(BOUNDARY_SUBTASK_FINISHED) == SAVE_WRITTEN);
    assert(save_decision(BOUNDARY_ARTIFACT_WRITTEN) == SAVE_WRITTEN);
    assert(save_decision(BOUNDARY_PROVIDER_RESPONSE_COMMITTED) == SAVE_WRITTEN);
    assert(save_decision(BOUNDARY_COUNT) == SAVE_SKIPPED);
}

test "the_save_is_atomic" {
    assert(save_is_atomic(true, true) == true);
    assert(save_is_atomic(true, false) == false);
    assert(save_is_atomic(false, true) == false);
    assert(save_is_atomic(false, false) == false);
}

test "a_written_checkpoint_is_durable_and_a_failed_one_is_not" {
    assert(durable_state_for_outcome(SAVE_WRITTEN) == CHECKPOINT_DURABLE);
    assert(durable_state_for_outcome(SAVE_FAILED) == CHECKPOINT_FAILED);
    assert(durable_state_for_outcome(SAVE_SKIPPED) == CHECKPOINT_PENDING);
    assert(write_succeeded(SAVE_WRITTEN) == true);
    assert(write_succeeded(SAVE_FAILED) == false);
}

test "a_failed_write_keeps_the_last_known_good_checkpoint" {
    assert(failed_write_preserves_last_known_good(SAVE_FAILED, true) == true);
    assert(failed_write_preserves_last_known_good(SAVE_FAILED, false) == false);
    assert(failed_write_preserves_last_known_good(SAVE_WRITTEN, false) == true);
}

test "a_failed_write_is_visible_and_never_reports_the_step_durable" {
    assert(failed_write_is_visible(SAVE_FAILED, true) == true);
    assert(failed_write_is_visible(SAVE_FAILED, false) == false);
    assert(failed_write_is_visible(SAVE_WRITTEN, false) == true);
    assert(failed_write_must_not_report_the_step_durable(SAVE_FAILED) == false);
    assert(failed_write_must_not_report_the_step_durable(SAVE_WRITTEN) == true);
}

test "the_checkpoint_survives_a_crash" {
    assert(checkpoint_survives_a_crash(BOUNDARY_ARTIFACT_WRITTEN, SAVE_WRITTEN, true) == true);
    assert(checkpoint_survives_a_crash(BOUNDARY_ARTIFACT_WRITTEN, SAVE_WRITTEN, false) == false);
    assert(checkpoint_survives_a_crash(BOUNDARY_ARTIFACT_WRITTEN, SAVE_FAILED, true) == false);
    assert(checkpoint_survives_a_crash(BOUNDARY_COUNT, SAVE_WRITTEN, true) == false);
}

test "the_checkpoint_is_on_disk_before_the_mutation_it_protects" {
    assert(save_precedes_mutation(true, true) == true);
    assert(save_precedes_mutation(false, true) == false);
    assert(save_precedes_mutation(false, false) == true);
}

// ═══════════════════════════════════════════════════════════════════════════
// Invariants
// ═══════════════════════════════════════════════════════════════════════════

invariant a_checkpoint_is_saved_at_every_meaningful_boundary {
    save_decision(BOUNDARY_TOOL_CALL_COMPLETED) == SAVE_WRITTEN;
    save_decision(BOUNDARY_PROVIDER_RESPONSE_COMMITTED) == SAVE_WRITTEN;
    save_decision(BOUNDARY_COUNT) == SAVE_SKIPPED;
}

invariant no_mutation_outruns_the_checkpoint {
    save_precedes_mutation(false, true) == false;
    save_precedes_mutation(true, true) == true;
}

invariant an_untrusted_checkpoint_is_never_claimed_as_saved {
    checkpoint_survives_a_crash(BOUNDARY_ARTIFACT_WRITTEN, SAVE_WRITTEN, false) == false;
    checkpoint_survives_a_crash(BOUNDARY_ARTIFACT_WRITTEN, SAVE_FAILED, true) == false;
}

invariant a_failed_save_never_destroys_the_last_known_good {
    failed_write_preserves_last_known_good(SAVE_FAILED, false) == false;
    failed_write_preserves_last_known_good(SAVE_FAILED, true) == true;
}

invariant a_failed_save_is_always_visible_and_never_durable {
    failed_write_is_visible(SAVE_FAILED, false) == false;
    failed_write_must_not_report_the_step_durable(SAVE_FAILED) == false;
}

// ═══════════════════════════════════════════════════════════════════════════
// Benchmarks
// ═══════════════════════════════════════════════════════════════════════════

bench save_decision_cost {
    ; Measure: the cost of deciding whether a boundary needs a save
    target: < 10ms on typical hardware
    iterations: 1000
    setup: create_test_boundaries()
    measure: save_decision(setup.boundary)
}

bench failed_write_handling_cost {
    ; Measure: the cost of the failed-write path
    target: < 10ms on typical hardware
    iterations: 1000
    setup: create_test_write_outcomes()
    measure: failed_write_preserves_last_known_good(setup.outcome, setup.previous_was_durable)
}
