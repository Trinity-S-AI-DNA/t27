// SPDX-License-Identifier: Apache-2.0
; specs/jobs/suite_ledger_steward.t27 -- the corpus (suite) ledger steward, as a job the Queen runs
; (specs/queen/jobs.t27). The counterpart of specs/jobs/t27b_ledger_steward.t27 for
; docs/reports/suite_expectations.json, the ledger behind the `Corpus ratchet` check.
; The steps are the ones a person ran by hand each time master's `Corpus ratchet` went red on a fall:
; read the run's findings, drop the rows whose specs now pass, re-pin the discard counts that fell,
; lower max_entries to the count, open an issue and a PR that closes it (#10172, #8345, #7804, #6437).
; What the steward may apply and what it refuses is decided in specs/ci/suite_ledger_steward.t27
; (RULES), compiled to wasm like every card decision; this card names the steps.
; A job starts when master's CHECK job of WORKFLOW completes red and no job was started for its
; commit (suite_ledger_steward.t27 run_starts_job). The run's findings are read from its ARTIFACT:
; SUMMARY_FILE carries the RatchetVerdict under `ratchet` and the per-spec results (the first failing
; phase, the discard total and its channels); LOG_FILE is quoted in the issue and the PR.
; The job's parameters are the run (its Actions run id) and the run's commit.
;   0 CHECK  steward-run             the run is pinned as the subject: its ref is master, its t27c was
;                                    built from that commit, the ratchet reached its verdict, and
;                                    master's ledger is the ledger the run compared against
;                                    (run_stewardable); otherwise the job fails as SKIP
;   1 EFFECT steward-refusals-issue  when run_verdict is REFUSE: one issue for this run, listing each
;                                    refused row with its reason (row_refusal, discard_refusal,
;                                    gate_refusal, or run_refusal) and the rows the steward would have
;                                    applied; otherwise PASS, nothing done
;   2 CHECK  steward-appliable       run_verdict is APPLY: some row is the steward's, the cap fits
;                                    (cap_fits) and the drops are no flood (DROP_LIMIT); a refused row
;                                    stays as master has it and is listed in the PR; REFUSE fails the
;                                    job, pointing at the issue
;   3 EFFECT steward-ledger-issue    the issue the ledger commit and the PR close (the Issue Gate:
;                                    `Closes #N` in the commit and on line 1 of the PR body),
;                                    labelled ISSUE_LABEL
;   4 EFFECT steward-compose         compose the ledger from master's, row by row (entry_action: DROP
;                                    removes the row, REPIN writes the run's discard_tokens and
;                                    discard_by_channel; KEEP and REFUSE leave it); max_gate_failures by
;                                    gate_action; max_entries = cap_after. It does NOT run
;                                    `--bless-expectations`: bless drops the `_why_entries_*` notes and
;                                    would write a rise. Rows stay in (path, phase) order, the notes
;                                    stay, one line naming the run and this card is appended to
;                                    `_why_entries_fell`, and the file keeps serde's pretty layout with
;                                    a trailing newline. Push it as one commit to BRANCH_PREFIX + the
;                                    run's commit (12 hex)
;   5 EFFECT steward-pull-request    the PR from that branch to master, body line 1 `Closes #<issue>`,
;                                    with a table of the rows by action and every refused row
;   6 EFFECT steward-auto-merge      enable auto-merge with MERGE_METHOD while the checks are pending
;                                    (GitHub refuses it once they finished with a non-required red)
;   7 WAIT   steward-merged          the PR merged; a day without it fails the job (jobs.t27)
; Every EFFECT goes through the effects journal (control.t27 section 7) under the key
; JOURNAL_PREFIX + the run's commit + ":" + its STEP_WHAT, so a Queen that restarts mid-step looks
; before she acts and never opens a second issue or PR for one run. STEP_EFFECT names the effect kind
; each step needs from the supervisor.
; Read at run time by the supervisor's vendored compiler wasm: the supervisor reads the constants;
; the two functions are only what the card's tests ask of them.
; Not wired yet: the trigger needs the supervisor (lab.py) to watch WORKFLOW, which is foreign code
; behind the owner-approved-foreign label; until then the card is the decision and nothing runs it.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module JobSuiteLedgerSteward;

pub const JOB_NAME : str = "suite-ledger-steward";
pub const REPO : str = "gHashTag/t27";
pub const BASE_BRANCH : str = "master";
pub const LEDGER : str = "docs/reports/suite_expectations.json";
pub const RULES : str = "specs/ci/suite_ledger_steward.t27";

/// Where a master run is read: the corpus ratchet workflow, its job, and the artifact it uploads.
pub const TRIGGERS : [1]str = ["corpus-ratchet"];
pub const WORKFLOW : str = "corpus-ratchet.yml";
pub const CHECK : str = "Corpus ratchet (expected-failure ledger)";
pub const ARTIFACT : str = "corpus-ratchet-log";
pub const SUMMARY_FILE : str = "suite_summary.json";
pub const LOG_FILE : str = "ratchet.log";

/// The two parameters a job of this card starts with.
pub const PARAMS : [2]str = ["run", "commit"];

/// What the steward writes.
pub const BRANCH_PREFIX : str = "steward/suite-ledger-";
pub const ISSUE_LABEL : str = "suite-ledger-steward";
pub const GENERATED_BY : str = "suite ledger steward (specs/jobs/suite_ledger_steward.t27)";
pub const MERGE_METHOD : str = "squash";
pub const JOURNAL_PREFIX : str = "suite-ledger:";

/// Step kinds by number (specs/queen/jobs.t27: CHECK 0, WAIT 1, EFFECT 2), and the executor each
/// step names. A name the supervisor does not know fails the step: it never guesses.
pub const STEP_COUNT : u32 = 8;
pub const STEP_KIND : [8]u8 = [0, 2, 0, 2, 2, 2, 2, 1];
pub const STEP_WHAT : [8]str = [
    "steward-run", "steward-refusals-issue", "steward-appliable", "steward-ledger-issue",
    "steward-compose", "steward-pull-request", "steward-auto-merge", "steward-merged"
];

/// The effect kind each step needs ("" for a CHECK or a WAIT).
pub const STEP_EFFECT : [8]str = ["", "issue", "", "issue", "push", "pull-request", "auto-merge", ""];

/// Which suite_ledger_steward.t27 effect code (EF_*) each EFFECT step is; 255 for a CHECK or a WAIT.
/// effect_wanted(run_verdict, code) says whether the step acts or answers PASS with nothing done.
pub const STEP_EF : [8]u8 = [255, 0, 255, 2, 1, 3, 4, 255];

/// The refusal issue is the only effect before the appliable CHECK; the ledger issue, the ledger and
/// its PR come only after it, so every check passed at the subject before the first of them
/// (jobs.t27 effect_may_run).
pub const REFUSAL_STEP : u32 = 1;
pub const APPLIABLE_STEP : u32 = 2;
pub const LEDGER_ISSUE_STEP : u32 = 3;
pub const COMPOSE_STEP : u32 = 4;

/// Whether a step writes the steward's batch: an EFFECT after the appliable CHECK (the ledger issue,
/// the branch, the PR, auto-merge). The refusal issue before it only reports.
pub fn writes_the_repo(step: u32) -> bool {
    if (step >= STEP_COUNT) { return false; }
    if (STEP_KIND[step] != 2) { return false; }
    return step > APPLIABLE_STEP;
}

/// The suite_ledger_steward.t27 effect code of a step, 255 for a CHECK, a WAIT or a step past the end.
pub fn step_ef(step: u32) -> u8 {
    if (step >= STEP_COUNT) { return 255; }
    return STEP_EF[step];
}

test the_card_writes_the_ledger_only_after_its_checks {
    assert writes_the_repo(0) == false;
    assert writes_the_repo(REFUSAL_STEP) == false;
    assert writes_the_repo(APPLIABLE_STEP) == false;
    assert writes_the_repo(LEDGER_ISSUE_STEP) == true;
    assert writes_the_repo(COMPOSE_STEP) == true;
    assert writes_the_repo(5) == true;
    assert writes_the_repo(6) == true;
    assert writes_the_repo(7) == false;
    assert writes_the_repo(STEP_COUNT) == false;
    assert STEP_KIND[0] == 0;
    assert STEP_KIND[APPLIABLE_STEP] == 0;
    assert STEP_KIND[7] == 1;
}

test every_effect_step_names_its_effect {
    assert step_ef(REFUSAL_STEP) == 0;
    assert step_ef(LEDGER_ISSUE_STEP) == 2;
    assert step_ef(COMPOSE_STEP) == 1;
    assert step_ef(5) == 3;
    assert step_ef(6) == 4;
    assert step_ef(0) == 255;
    assert step_ef(APPLIABLE_STEP) == 255;
    assert step_ef(7) == 255;
    assert step_ef(STEP_COUNT) == 255;
}

invariant the_steps_are_ordered {
    assert REFUSAL_STEP == 1;
    assert APPLIABLE_STEP == 2;
    assert LEDGER_ISSUE_STEP == 3;
    assert COMPOSE_STEP == 4;
    assert COMPOSE_STEP < STEP_COUNT;
}
