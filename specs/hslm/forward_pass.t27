// SPDX-License-Identifier: Apache-2.0
// Module: Minimal Forward Pass for LLM Inference (VSA, character level)
// φ² + 1/φ² = 3 | TRINITY
//
// This spec never compiled: its tests read q_role, k_role, v_role, context
// and role, which nothing declared; four functions had empty bodies; the rest
// returned an empty vector, 0.0 or their own argument; every invariant was
// `assert true`; and the benches named role1..role8, which do not exist.
//
// It is written out now on dense hypervectors of ROLE_DIM trits (stored as
// i8 in {-1, 0, +1}) in module storage:
//   - char_hv: a fixed pseudo-random +-1 vector per character
//   - bind (elementwise product, its own inverse), bundle (majority),
//     permute (cyclic shift, encodes position), similarity (cosine)
//   - attention: the query is compared with every positioned context vector
//     bound with the key role; the best match, bound with the value role, is
//     the head's output. Three heads are bundled.
//   - Hebbian successor counts and their lookup
//   - a direct role learned from a corpus: role = bundle over t of
//     bind(summary(window before t), char_hv(corpus[t])), so that
//     bind(summary, role) decodes to the next character; generation slides
//     the window; refinement adds the terms the role still gets wrong.
// resonatorTrainStep (FF1/FF2 roles) is not written: nothing here says what
// those roles are, and a function returning 0.0 is not a training step.

module ForwardPass {
    use base::types;

    // ========================================================================
    // 1. Constants
    // ========================================================================

    // Number of attention heads in multi-head architecture
    pub const HEAD_COUNT : usize = 3;

    // Forward pass version: 3 = dense VSA rewrite with hard attention
    pub const FORWARD_VERSION : u32 = 3;

    // Role vector dimension for VSA operations
    pub const ROLE_DIM : usize = 500;

    // Context window size for autoregression
    pub const CONTEXT_WINDOW : usize = 8;

    // Number of printable ASCII characters for Hebbian
    pub const HEBBIAN_CHARS : usize = 95;

    // ASCII offset for printable characters
    pub const HEBBIAN_OFFSET : usize = 32;

    // Maximum passes for refinement
    pub const MAX_REFINE_PASSES : usize = 3;

    // ========================================================================
    // 2. Types and storage
    // ========================================================================

    // RoleVector: an attention role (Q, K, V per head) or a learned direct role
    pub struct RoleVector {
        role_id : u8,
        vector : [ROLE_DIM]i8,
    }

    // counts[a * HEBBIAN_CHARS + b] = how often printable char b follows a
    var hebbian : [HEBBIAN_CHARS * HEBBIAN_CHARS]u16 = undefined;

    var acc : [ROLE_DIM]i32 = undefined;
    var summary_hv : [ROLE_DIM]i8 = undefined;
    var query_hv : [ROLE_DIM]i8 = undefined;
    var pos_hv : [ROLE_DIM]i8 = undefined;
    var key_hv : [ROLE_DIM]i8 = undefined;
    var bound_hv : [ROLE_DIM]i8 = undefined;
    var char_buf : [ROLE_DIM]i8 = undefined;
    var head_out : [HEAD_COUNT * ROLE_DIM]i8 = undefined;
    // The context position each head attended to in the last multiHeadAttention
    var head_pos : [HEAD_COUNT]usize = undefined;
    var gen_window : [CONTEXT_WINDOW]u8 = undefined;

    // ========================================================================
    // 3. Hypervector operations
    // ========================================================================

    // Trit i of character c: +1 or -1 from three rounds of squaring modulo the
    // prime 1000003. A single linear hash would make two characters' vectors
    // shifted copies of one bit stream, and some pairs would correlate strongly.
    fn char_trit(c: u8, i: usize) -> i8 {
        const x1 = ((@as(usize, c) + 1) * 7919 + i * 104729 + 12345) % 1000003;
        const x2 = (x1 * x1 + @as(usize, c)) % 1000003;
        const x3 = (x2 * x2 + i) % 1000003;
        if ((x3 / 16) % 2 == 0) {
            return 1;
        }
        return -1;
    }

    fn char_hv(c: u8, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[i] = char_trit(c, i);
            i = i + 1;
        }
    }

    fn sign_of(x: i32) -> i8 {
        if (x > 0) {
            return 1;
        }
        if (x < 0) {
            return -1;
        }
        return 0;
    }

    // Elementwise product; for +-1 vectors bind(bind(a, b), b) == a
    fn bind(a: []const i8, b: []const i8, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[i] = a[i] * b[i];
            i = i + 1;
        }
    }

    // Majority of three
    fn bundle3(a: []const i8, b: []const i8, c: []const i8, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[i] = sign_of(@as(i32, a[i]) + @as(i32, b[i]) + @as(i32, c[i]));
            i = i + 1;
        }
    }

    // Cyclic shift by `shift` places: out[(i + shift) % ROLE_DIM] = a[i]
    fn permute(a: []const i8, shift: usize, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[(i + shift) % ROLE_DIM] = a[i];
            i = i + 1;
        }
    }

    // Cosine similarity; 0 when either vector is all zeros
    fn similarity(a: []const i8, b: []const i8) -> f64 {
        var dot : i32 = 0;
        var na : i32 = 0;
        var nb : i32 = 0;
        var i : usize = 0;
        while (i < ROLE_DIM) {
            dot = dot + @as(i32, a[i]) * @as(i32, b[i]);
            na = na + @as(i32, a[i]) * @as(i32, a[i]);
            nb = nb + @as(i32, b[i]) * @as(i32, b[i]);
            i = i + 1;
        }
        if (na == 0 or nb == 0) {
            return 0.0;
        }
        return @as(f64, @floatFromInt(dot)) / sqrt(@as(f64, @floatFromInt(na)) * @as(f64, @floatFromInt(nb)));
    }

    // Character c at position p: permute(char_hv(c), p)
    fn positioned_hv(c: u8, p: usize, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[(i + p) % ROLE_DIM] = char_trit(c, i);
            i = i + 1;
        }
    }

    fn sign_into(out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            out[i] = sign_of(acc[i]);
            i = i + 1;
        }
    }

    // ========================================================================
    // 4. Context and decoding
    // ========================================================================

    // Bundle of the positioned context characters (ties become 0)
    pub fn summarizeContext(context: []const u8, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            acc[i] = 0;
            i = i + 1;
        }
        var p : usize = 0;
        while (p < context.len) {
            i = 0;
            while (i < ROLE_DIM) {
                acc[(i + p) % ROLE_DIM] = acc[(i + p) % ROLE_DIM] + @as(i32, char_trit(context[p], i));
                i = i + 1;
            }
            p = p + 1;
        }
        sign_into(out);
    }

    // The printable character whose hypervector is most similar to hv
    pub fn directDecode(hv: []const i8) -> u8 {
        var best : usize = 0;
        var best_score : f64 = -2.0;
        var b : usize = 0;
        while (b < HEBBIAN_CHARS) {
            const c : u8 = @intCast(HEBBIAN_OFFSET + b);
            char_hv(c, &char_buf);
            const s = similarity(hv, &char_buf);
            if (s > best_score) {
                best_score = s;
                best = b;
            }
            b = b + 1;
        }
        return @intCast(HEBBIAN_OFFSET + best);
    }

    // ========================================================================
    // 5. Attention
    // ========================================================================

    // Hard attention: score_p = similarity(query, bind(positioned_p, k_role));
    // out = bind(positioned_best, v_role). Returns the best position.
    pub fn singleHeadAttention(context: []const u8, query: []const i8, k_role: *const RoleVector, v_role: *const RoleVector, out: []i8) -> usize {
        var best : usize = 0;
        var best_score : f64 = -2.0;
        var p : usize = 0;
        while (p < context.len) {
            positioned_hv(context[p], p, &pos_hv);
            bind(&pos_hv, &k_role.vector, &key_hv);
            const s = similarity(query, &key_hv);
            if (s > best_score) {
                best_score = s;
                best = p;
            }
            p = p + 1;
        }
        positioned_hv(context[best], best, &pos_hv);
        bind(&pos_hv, &v_role.vector, out);
        return best;
    }

    // Head h reads roles[3h] (Q), roles[3h + 1] (K), roles[3h + 2] (V), with
    // query bind(summary, Q); the three head outputs are bundled into out
    pub fn multiHeadAttention(context: []const u8, roles: []const RoleVector, out: []i8) -> void {
        summarizeContext(context, &summary_hv);
        var h : usize = 0;
        while (h < HEAD_COUNT) {
            bind(&summary_hv, &roles[3 * h].vector, &query_hv);
            const ho = h * ROLE_DIM;
            head_pos[h] = singleHeadAttention(context, &query_hv, &roles[3 * h + 1], &roles[3 * h + 2], head_out[ho..ho + ROLE_DIM]);
            h = h + 1;
        }
        bundle3(head_out[0..ROLE_DIM], head_out[ROLE_DIM..2 * ROLE_DIM], head_out[2 * ROLE_DIM..3 * ROLE_DIM], out);
    }

    // Multi-head forward pass into out; returns the loss 1 - similarity(out, target)
    pub fn forwardPass(context: []const u8, roles: []const RoleVector, target: []const i8, out: []i8) -> f64 {
        multiHeadAttention(context, roles, out);
        return 1.0 - similarity(out, target);
    }

    // ========================================================================
    // 6. Hebbian successor counts
    // ========================================================================

    fn printable(c: u8) -> bool {
        return @as(usize, c) >= HEBBIAN_OFFSET and @as(usize, c) < HEBBIAN_OFFSET + HEBBIAN_CHARS;
    }

    pub fn buildHebbianCounts(corpus: []const u8) -> void {
        var i : usize = 0;
        while (i < HEBBIAN_CHARS * HEBBIAN_CHARS) {
            hebbian[i] = 0;
            i = i + 1;
        }
        var t : usize = 1;
        while (t < corpus.len) {
            if (printable(corpus[t - 1]) and printable(corpus[t])) {
                const k = (@as(usize, corpus[t - 1]) - HEBBIAN_OFFSET) * HEBBIAN_CHARS + (@as(usize, corpus[t]) - HEBBIAN_OFFSET);
                hebbian[k] = hebbian[k] + 1;
            }
            t = t + 1;
        }
    }

    pub fn hebbianCount(a: u8, b: u8) -> u16 {
        return hebbian[(@as(usize, a) - HEBBIAN_OFFSET) * HEBBIAN_CHARS + (@as(usize, b) - HEBBIAN_OFFSET)];
    }

    // Successors of char_idx (0-based printable index) bundled with their counts as weights
    pub fn hebbianLookup(char_idx: usize, out: []i8) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            acc[i] = 0;
            i = i + 1;
        }
        var b : usize = 0;
        while (b < HEBBIAN_CHARS) {
            const n = @as(i32, hebbian[char_idx * HEBBIAN_CHARS + b]);
            if (n > 0) {
                const c : u8 = @intCast(HEBBIAN_OFFSET + b);
                i = 0;
                while (i < ROLE_DIM) {
                    acc[i] = acc[i] + n * @as(i32, char_trit(c, i));
                    i = i + 1;
                }
            }
            b = b + 1;
        }
        sign_into(out);
    }

    // ========================================================================
    // 7. Direct role
    // ========================================================================

    // summarizeContext reuses acc, so the role accumulator is kept apart
    var role_acc : [ROLE_DIM]i32 = undefined;

    fn add_role_term(corpus: []const u8, t: usize) -> void {
        summarizeContext(corpus[t - CONTEXT_WINDOW..t], &summary_hv);
        var i : usize = 0;
        while (i < ROLE_DIM) {
            role_acc[i] = role_acc[i] + @as(i32, summary_hv[i]) * @as(i32, char_trit(corpus[t], i));
            i = i + 1;
        }
    }

    fn role_from_acc(role: *RoleVector) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            role.vector[i] = sign_of(role_acc[i]);
            i = i + 1;
        }
    }

    // The role that maps each window of the corpus to the character after it
    pub fn computeDirectRole(corpus: []const u8, role: *RoleVector) -> void {
        var i : usize = 0;
        while (i < ROLE_DIM) {
            role_acc[i] = 0;
            i = i + 1;
        }
        var t : usize = CONTEXT_WINDOW;
        while (t < corpus.len) {
            add_role_term(corpus, t);
            t = t + 1;
        }
        role.role_id = 0;
        role_from_acc(role);
    }

    // The next character after a window: decode(bind(summary(window), role))
    pub fn directPredict(window: []const u8, role: *const RoleVector) -> u8 {
        summarizeContext(window, &summary_hv);
        bind(&summary_hv, &role.vector, &bound_hv);
        return directDecode(&bound_hv);
    }

    // Windows of the corpus whose next character the role gets wrong
    pub fn directErrors(corpus: []const u8, role: *const RoleVector) -> usize {
        var errors : usize = 0;
        var t : usize = CONTEXT_WINDOW;
        while (t < corpus.len) {
            if (directPredict(corpus[t - CONTEXT_WINDOW..t], role) != corpus[t]) {
                errors = errors + 1;
            }
            t = t + 1;
        }
        return errors;
    }

    // Perceptron passes: each window still predicted wrong adds its term again.
    // Returns the errors left after the last pass.
    pub fn refineDirectRole(corpus: []const u8, role: *RoleVector, num_passes: usize) -> usize {
        computeDirectRole(corpus, role);
        var pass : usize = 0;
        while (pass < num_passes and pass < MAX_REFINE_PASSES) {
            var t : usize = CONTEXT_WINDOW;
            while (t < corpus.len) {
                if (directPredict(corpus[t - CONTEXT_WINDOW..t], role) != corpus[t]) {
                    add_role_term(corpus, t);
                }
                t = t + 1;
            }
            role_from_acc(role);
            pass = pass + 1;
        }
        return directErrors(corpus, role);
    }

    // Autoregressive generation from the last CONTEXT_WINDOW characters of seed.
    // Returns the number of characters written.
    pub fn generateWithDirectRole(seed: []const u8, role: *const RoleVector, output_buf: []u8, max_tokens: usize) -> usize {
        var i : usize = 0;
        while (i < CONTEXT_WINDOW) {
            gen_window[i] = seed[seed.len - CONTEXT_WINDOW + i];
            i = i + 1;
        }
        var n : usize = 0;
        while (n < max_tokens and n < output_buf.len) {
            const c = directPredict(&gen_window, role);
            output_buf[n] = c;
            i = 0;
            while (i + 1 < CONTEXT_WINDOW) {
                gen_window[i] = gen_window[i + 1];
                i = i + 1;
            }
            gen_window[CONTEXT_WINDOW - 1] = c;
            n = n + 1;
        }
        return n;
    }

    // ========================================================================
    // 8. Test probes
    // ========================================================================

    var probe_a : [ROLE_DIM]i8 = undefined;
    var probe_b : [ROLE_DIM]i8 = undefined;
    var probe_c : [ROLE_DIM]i8 = undefined;
    var probe_d : [ROLE_DIM]i8 = undefined;
    var probe_out : [ROLE_DIM]i8 = undefined;
    var probe_roles : [3 * HEAD_COUNT]RoleVector = undefined;
    var probe_role : RoleVector = undefined;
    var probe_text : [16]u8 = undefined;

    fn char_similarity(a: u8, b: u8) -> f64 {
        char_hv(a, &probe_a);
        char_hv(b, &probe_b);
        return similarity(&probe_a, &probe_b);
    }

    // similarity(bind(bind(a, b), b), a)
    fn unbind_similarity() -> f64 {
        char_hv('a', &probe_a);
        char_hv('k', &probe_b);
        bind(&probe_a, &probe_b, &probe_c);
        bind(&probe_c, &probe_b, &probe_d);
        return similarity(&probe_d, &probe_a);
    }

    // similarity(bind(a, b), a): binding hides its inputs
    fn bound_similarity() -> f64 {
        char_hv('a', &probe_a);
        char_hv('k', &probe_b);
        bind(&probe_a, &probe_b, &probe_c);
        return similarity(&probe_c, &probe_a);
    }

    // similarity(bundle3(a, b, c), input): 0.5 expected for each input
    fn bundle_similarity(which: usize) -> f64 {
        char_hv('x', &probe_a);
        char_hv('y', &probe_b);
        char_hv('z', &probe_c);
        bundle3(&probe_a, &probe_b, &probe_c, &probe_d);
        if (which == 0) {
            return similarity(&probe_d, &probe_a);
        }
        if (which == 1) {
            return similarity(&probe_d, &probe_b);
        }
        char_hv('w', &probe_a);
        return similarity(&probe_d, &probe_a);
    }

    // shift = 0: similarity(permute(a, 1), a); shift = 1: permute back by ROLE_DIM - 1
    fn permute_similarity(back: bool) -> f64 {
        char_hv('q', &probe_a);
        permute(&probe_a, 1, &probe_b);
        if (back) {
            permute(&probe_b, ROLE_DIM - 1, &probe_c);
            return similarity(&probe_c, &probe_a);
        }
        return similarity(&probe_b, &probe_a);
    }

    fn decode_probe(c: u8) -> u8 {
        char_hv(c, &probe_a);
        return directDecode(&probe_a);
    }

    // Context "hello"; the query is position 3 bound with the key role
    fn attention_best() -> usize {
        char_hv('K', &probe_roles[1].vector);
        char_hv('V', &probe_roles[2].vector);
        positioned_hv('l', 3, &probe_a);
        bind(&probe_a, &probe_roles[1].vector, &probe_b);
        return singleHeadAttention("hello", &probe_b, &probe_roles[1], &probe_roles[2], &probe_out);
    }

    // The output, unbound from the value role, is the attended positioned vector
    fn attention_value_similarity() -> f64 {
        const best = attention_best();
        bind(&probe_out, &probe_roles[2].vector, &probe_c);
        positioned_hv('l', best, &probe_a);
        return similarity(&probe_c, &probe_a);
    }

    // Position 2 holds 'l' as well, but at another shift: it must not match
    fn attention_other_l_similarity() -> f64 {
        if (attention_best() != 3) {
            return 1.0;
        }
        bind(&probe_out, &probe_roles[2].vector, &probe_c);
        positioned_hv('l', 2, &probe_a);
        return similarity(&probe_c, &probe_a);
    }

    fn setup_roles() -> void {
        var r : usize = 0;
        while (r < 3 * HEAD_COUNT) {
            probe_roles[r].role_id = @intCast(r);
            char_hv(@intCast(65 + r), &probe_roles[r].vector);
            r = r + 1;
        }
    }

    // Similarity of the multi-head output with head h's output
    fn multi_head_similarity(h: usize) -> f64 {
        setup_roles();
        multiHeadAttention("the cat", &probe_roles, &probe_out);
        return similarity(&probe_out, head_out[h * ROLE_DIM..(h + 1) * ROLE_DIM]);
    }

    // Loss against the output itself, then against an unrelated vector
    fn forward_loss(self_target: bool) -> f64 {
        setup_roles();
        if (self_target) {
            multiHeadAttention("the cat", &probe_roles, &probe_d);
            return forwardPass("the cat", &probe_roles, &probe_d, &probe_out);
        }
        char_hv('~', &probe_d);
        return forwardPass("the cat", &probe_roles, &probe_d, &probe_out);
    }

    fn hebbian_probe(a: u8, b: u8) -> u16 {
        buildHebbianCounts("hello");
        return hebbianCount(a, b);
    }

    // 'a' is followed by 'b' three times and by 'c' once
    fn hebbian_next(c: u8) -> u8 {
        buildHebbianCounts("abababac");
        hebbianLookup(@as(usize, c) - HEBBIAN_OFFSET, &probe_a);
        return directDecode(&probe_a);
    }

    const PERIODIC : []const u8 = "abcabcabcabcabcabcabc";
    const SENTENCE : []const u8 = "the cat sat on the mat and the rat sat on the hat by the cat";

    fn periodic_prediction() -> u8 {
        computeDirectRole(PERIODIC, &probe_role);
        return directPredict(PERIODIC[0..CONTEXT_WINDOW], &probe_role);
    }

    fn periodic_errors() -> usize {
        computeDirectRole(PERIODIC, &probe_role);
        return directErrors(PERIODIC, &probe_role);
    }

    // Generate 5 characters after "abcabcab": expected "cabca"
    fn generated(index: usize) -> u8 {
        computeDirectRole(PERIODIC, &probe_role);
        const n = generateWithDirectRole("abcabcab", &probe_role, &probe_text, 5);
        if (n != 5) {
            return 0;
        }
        return probe_text[index];
    }

    fn generated_count(max_tokens: usize) -> usize {
        computeDirectRole(PERIODIC, &probe_role);
        return generateWithDirectRole("abcabcab", &probe_role, &probe_text, max_tokens);
    }

    fn sentence_errors_before() -> usize {
        computeDirectRole(SENTENCE, &probe_role);
        return directErrors(SENTENCE, &probe_role);
    }

    fn sentence_errors_after(passes: usize) -> usize {
        return refineDirectRole(SENTENCE, &probe_role, passes);
    }

    // ========================================================================
    // TDD - Tests
    // ========================================================================

    test char_hv_is_quasi_orthogonal
        given same = char_similarity('a', 'a')
        when other = char_similarity('a', 'b')
        then same == 1.0 and @abs(other) < 0.2 and @abs(char_similarity('h', 'e')) < 0.2

    test bind_is_its_own_inverse
        given back = unbind_similarity()
        when hidden = bound_similarity()
        then back == 1.0 and @abs(hidden) < 0.2

    test bundle3_stays_similar_to_each_input
        given s0 = bundle_similarity(0)
        when s1 = bundle_similarity(1)
        then s0 > 0.35 and s1 > 0.35 and @abs(bundle_similarity(2)) < 0.2

    test permute_moves_and_returns
        given moved = permute_similarity(false)
        when back = permute_similarity(true)
        then @abs(moved) < 0.2 and back == 1.0

    test direct_decode_returns_the_encoded_char
        given x = decode_probe('x')
        when space = decode_probe(' ')
        then x == 'x' and space == ' ' and decode_probe('~') == '~'

    test single_head_attention_finds_the_queried_position
        given best = attention_best()
        when value = attention_value_similarity()
        then best == 3 and value == 1.0 and @abs(attention_other_l_similarity()) < 0.2

    test multi_head_attention_bundles_three_heads
        given s0 = multi_head_similarity(0)
        when s2 = multi_head_similarity(2)
        then s0 > 0.35 and s2 > 0.35 and multi_head_similarity(1) > 0.35

    test forward_pass_loss_is_one_minus_similarity
        given at_self = forward_loss(true)
        when unrelated = forward_loss(false)
        then at_self == 0.0 and unrelated > 0.8 and unrelated < 1.2

    // "hello": h->e, e->l, l->l, l->o once each
    test hebbian_counts_correct_for_corpus
        given he = hebbian_probe('h', 'e')
        when ll = hebbian_probe('l', 'l')
        then he == 1 and ll == 1 and hebbian_probe('l', 'o') == 1 and hebbian_probe('o', 'h') == 0

    test hebbian_lookup_decodes_the_most_frequent_successor
        given after_a = hebbian_next('a')
        when after_b = hebbian_next('b')
        then after_a == 'b' and after_b == 'a'

    test direct_role_predicts_a_periodic_corpus
        given next = periodic_prediction()
        when errors = periodic_errors()
        then next == 'c' and errors == 0

    test generate_with_direct_role_continues_the_pattern
        given c0 = generated(0)
        when c4 = generated(4)
        then c0 == 'c' and generated(1) == 'a' and generated(2) == 'b' and generated(3) == 'c' and c4 == 'a'

    test generate_with_direct_role_respects_the_buffer
        given n = generated_count(40)
        when m = generated_count(3)
        then n == 16 and m == 3

    // 51 windows of SENTENCE: the bundled role gets 16 wrong; three perceptron
    // passes leave 12 (measured on the lab, 2026-10-18; the vectors are fixed,
    // so the counts are exact)
    test refine_direct_role_reduces_errors
        given before = sentence_errors_before()
        when after = sentence_errors_after(MAX_REFINE_PASSES)
        then before == 16 and after == 12

    // ========================================================================
    // TDD - Invariants
    // ========================================================================

    invariant multi_head_has_three_heads
        assert HEAD_COUNT == 3

    invariant hebbian_covers_printable_ascii
        assert HEBBIAN_OFFSET == 32 and HEBBIAN_OFFSET + HEBBIAN_CHARS == 127

    invariant context_window_fits_a_role
        assert CONTEXT_WINDOW > 0 and CONTEXT_WINDOW < ROLE_DIM

    invariant forward_version_is_the_dense_rewrite
        assert FORWARD_VERSION == 3
}
