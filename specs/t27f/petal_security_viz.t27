; ---------------------------------------------------------------- constants

/// The fixture: twelve changes, so twelve focusable items.
pub const PTIV_CHANGE_COUNT : u32 = 12;
/// Trace rows (steps 0..2): the three layers, in the order a change meets them.
pub const PTIV_LAYERS : u32 = 3;
/// Flip choices: 0 changes nothing, 1..8 each flip one fact in every change.
pub const PTIV_FLIPS : u32 = 9;
/// The petal's row in the plan (agent letter Ti, index 26).
pub const PTIV_PETAL : u32 = 26;
/// "No change": nothing is hovered or selected, or the ref is not one of the twelve.
pub const PTIV_NO_CHANGE : u32 = 65535;
/// "No value": a hidden trace row, a row past the fixture, no change under the pointer.
pub const PTIV_NO_VALUE : u32 = 255;

/// The layers a change can meet, in order, and the answer "none of them".
pub const PTIV_L_PRECOMMIT : u32 = 0;
pub const PTIV_L_PREPUSH : u32 = 1;
pub const PTIV_L_CI : u32 = 2;
pub const PTIV_L_NONE : u32 = 3;

/// What a layer did with a change on its route.
pub const PTIV_S_SKIPPED : u32 = 0;
pub const PTIV_S_PASSED : u32 = 1;
pub const PTIV_S_STOPPED : u32 = 2;
pub const PTIV_S_UNREACHED : u32 = 3;

/// The rule the config matches on a change: the gitleaks defaults, the custom rule, or nothing.
pub const PTIV_R_DEFAULT : u32 = 0;
pub const PTIV_R_PASSWORD : u32 = 1;
pub const PTIV_R_NONE : u32 = 2;

/// The allowlist that excuses a match: none, the placeholder words (custom rule only), the path, the line.
pub const PTIV_X_NONE : u32 = 0;
pub const PTIV_X_PLACEHOLDER : u32 = 1;
pub const PTIV_X_PATH : u32 = 2;
pub const PTIV_X_LINE : u32 = 3;

/// What a change adds: nothing secret-shaped, a shape the default rules are meant to catch, or a quoted
/// literal assigned to a key name (the custom rule's shape).
pub const PTIV_SH_PLAIN : u32 = 0;
pub const PTIV_SH_PROVIDER : u32 = 1;
pub const PTIV_SH_PASSWORD : u32 = 2;

/// Where it sits: an ordinary file, the generated symbol inventory, or the verified GF16 constant line.
pub const PTIV_SITE_ORDINARY : u32 = 0;
pub const PTIV_SITE_INVENTORY : u32 = 1;
pub const PTIV_SITE_LINE : u32 = 2;

/// The word in a key name: the five the custom rule lists, then one it does not.
pub const PTIV_KW_PASSPHRASE : u32 = 0;
pub const PTIV_KW_PASSWORD : u32 = 1;
pub const PTIV_KW_PASSWD : u32 = 2;
pub const PTIV_KW_WIFI : u32 = 3;
pub const PTIV_KW_PSK : u32 = 4;
pub const PTIV_KW_OTHER : u32 = 5;
pub const PTIV_KW_COUNT : u32 = 6;

/// The placeholder word a literal carries: none, three the config excuses, one it does not.
pub const PTIV_PH_NONE : u32 = 0;
pub const PTIV_PH_EXAMPLE : u32 = 1;
pub const PTIV_PH_CHANGEME : u32 = 2;
pub const PTIV_PH_DUMMY : u32 = 3;
pub const PTIV_PH_SAMPLE : u32 = 4;
pub const PTIV_PH_COUNT : u32 = 5;

/// The flip choices (the contract's param).
pub const PTIV_F_NONE : u32 = 0;
pub const PTIV_F_HOOKS_OFF : u32 = 1;
pub const PTIV_F_SKIP_COMMIT : u32 = 2;
pub const PTIV_F_SKIP_PUSH : u32 = 3;
pub const PTIV_F_NOT_LOCAL : u32 = 4;
pub const PTIV_F_OTHER_WORD : u32 = 5;
pub const PTIV_F_SHORT : u32 = 6;
pub const PTIV_F_REFERENCE : u32 = 7;
pub const PTIV_F_PLACEHOLDER : u32 = 8;

/// Pixel geometry in frame coordinates.
pub const PTIV_BADGE_X : u32 = 20;
pub const PTIV_BADGE_Y : u32 = 10;
pub const PTIV_BADGE_W : u32 = 300;
pub const PTIV_BADGE_H : u32 = 40;
pub const PTIV_LINE_H : u32 = 22;
pub const PTIV_LIST_X : u32 = 20;
pub const PTIV_LIST_Y : u32 = 60;
pub const PTIV_LIST_W : u32 = 440;
pub const PTIV_TRACE_X : u32 = 480;
pub const PTIV_TRACE_Y : u32 = 60;
pub const PTIV_TRACE_W : u32 = 400;

/// Host slot numbers, in the depth-first order ptiv_host adds them (index order is focus order).
pub const PTIV_SLOT_BADGE : u32 = 0;
pub const PTIV_SLOT_LIST : u32 = 1;
pub const PTIV_SLOT_TRACE : u32 = 2;

; ---------------------------------------------------------------- L4 config: the questions put to the bytes

/// The short queries put to the config bytes. A query is a needle and its length (the counted-string idiom
/// of claw/text.t27); none of them is a rule, they only ask whether the source's text holds a word.
pub const PTIV_N_DEFAULTS : str = "useDefault = true";
pub const PTIV_N_DEFAULTS_LEN : usize = 17;
pub const PTIV_N_RULE_ID : str = "id = \"hardcoded-password-literal\"";
pub const PTIV_N_RULE_ID_LEN : usize = 33;
pub const PTIV_N_REFS : str = "<>${}";
pub const PTIV_N_REFS_LEN : usize = 5;
pub const PTIV_N_PATH : str = "conformance/trinity/inventory\\.json";
pub const PTIV_N_PATH_LEN : usize = 35;
pub const PTIV_N_LINE : str = "# fallback for GF16";
pub const PTIV_N_LINE_LEN : usize = 19;

/// The key-name words as the keywords array writes them (quoted), then a word the array does not hold.
pub const PTIV_KW_NEEDLES : [6]str = ["\"passphrase\"", "\"password\"", "\"passwd\"", "\"wifi\"", "\"psk\"", "\"token\""];
pub const PTIV_KW_LENS : [6]usize = [12, 10, 8, 6, 5, 7];

/// The placeholder words as the allowlist regex writes them (between bars); entry 0 is "no word".
pub const PTIV_PH_NEEDLES : [5]str = ["", "|example|", "|changeme|", "|dummy|", "|sample|"];
pub const PTIV_PH_LENS : [5]usize = [0, 9, 10, 7, 8];

/// Whether the config the three layers read holds the needle. The bytes are the source's own writer
/// output (gitleaks_toml); a config that outgrew the buffer answers false for every query.
fn ptiv_cfg_has(needle: str, needle_len: usize) -> bool {
    var cfg : [2048]u8 = [0; 2048];
    let n : usize = gitleaks_toml(&cfg, 2048);
    if (n > 2048) {
        return false;
    }
    return buf_has(&cfg, n, needle, needle_len);
}

/// The number of bytes the writer reports for the config: the source's own pinned length, TOML_LEN.
pub fn ptiv_cfg_len() -> usize {
    var cfg : [2048]u8 = [0; 2048];
    return gitleaks_toml(&cfg, 2048);
}

/// Whether the gitleaks default rules stay on (the extend section of the config).
pub fn ptiv_cfg_defaults_on() -> bool {
    return ptiv_cfg_has(PTIV_N_DEFAULTS, PTIV_N_DEFAULTS_LEN);
}

/// Whether the custom rule that adds plain passwords and Wi-Fi passphrases is in the config.
pub fn ptiv_cfg_rule_named() -> bool {
    return ptiv_cfg_has(PTIV_N_RULE_ID, PTIV_N_RULE_ID_LEN);
}

/// Whether the custom rule lists the key-name word w (PTIV_KW_*). An id past the table is not listed.
pub fn ptiv_cfg_lists_word(w: u32) -> bool {
    if (w >= PTIV_KW_COUNT) {
        return false;
    }
    return ptiv_cfg_has(PTIV_KW_NEEDLES[w as usize], PTIV_KW_LENS[w as usize]);
}

/// Whether the value class of the rule excludes the characters a reference is written with, so a
/// value that is a reference to an environment variable is not read as a literal.
pub fn ptiv_cfg_excludes_refs() -> bool {
    return ptiv_cfg_has(PTIV_N_REFS, PTIV_N_REFS_LEN);
}

/// Whether the placeholder allowlist of the custom rule names the word w (PTIV_PH_*). "No word" and an
/// id past the table are not excused.
pub fn ptiv_cfg_excuses_word(w: u32) -> bool {
    if (w == PTIV_PH_NONE or w >= PTIV_PH_COUNT) {
        return false;
    }
    return ptiv_cfg_has(PTIV_PH_NEEDLES[w as usize], PTIV_PH_LENS[w as usize]);
}

/// Whether the global allowlist excuses the generated symbol inventory by path.
pub fn ptiv_cfg_path_allowed() -> bool {
    return ptiv_cfg_has(PTIV_N_PATH, PTIV_N_PATH_LEN);
}

/// Whether the global allowlist excuses the verified GF16 fallback line.
pub fn ptiv_cfg_line_allowed() -> bool {
    return ptiv_cfg_has(PTIV_N_LINE, PTIV_N_LINE_LEN);
}

/// The minimum literal length the custom rule asks for, read out of the regex as the number between
/// braces and a comma ("{N,}"). 0 when the config holds no such count. The "${}" of the value class has
/// no digits, so it is skipped.
pub fn ptiv_cfg_min_len() -> u32 {
    var cfg : [2048]u8 = [0; 2048];
    let n : usize = gitleaks_toml(&cfg, 2048);
    if (n > 2000) {
        return 0;
    }
    var i : usize = 0;
    while (i < n) {
        if (cfg[i] == '{') {
            var j : usize = i + 1;
            var v : u32 = 0;
            while (j < n and cfg[j] >= '0' and cfg[j] <= '9') {
                v = v * 10 + (cfg[j] as u32) - 48;
                j = j + 1;
            }
            if (j > i + 1 and cfg[j] == ',' and cfg[j + 1] == '}') {
                return v;
            }
        }
        i = i + 1;
    }
    return 0;
}

; ---------------------------------------------------------------- L3 fixture (facts only)

/// One fixture change as the facts the rules read. Every field is an enum, a flag or a count: nothing
/// here is text, and nothing decides.
pub struct PtivChange {
    shape: u32,
    kw: u32,
    width: u32,
    ph: u32,
    site: u32,
    refv: bool,
    hooks_on: bool,
    skip_commit: bool,
    skip_push: bool,
    is_local: bool,
}

/// A change that adds nothing secret-shaped, on the normal route: hooks installed, no --no-verify, a
/// local commit. It is also the stand-in for a row past the fixture.
pub fn ptiv_blank() -> PtivChange {
    return PtivChange { shape: PTIV_SH_PLAIN, kw: PTIV_KW_OTHER, width: 0, ph: PTIV_PH_NONE, site: PTIV_SITE_ORDINARY, refv: false, hooks_on: true, skip_commit: false, skip_push: false, is_local: true };
}

/// Change i of the fixture. 0 a literal on a listed key name, normal route. 1 a provider-shaped change,
/// normal route. 2 a literal, the commit skips its hook. 3 a literal, both hooks skipped. 4 a
/// provider-shaped change pushed with no local commit. 5 a literal that carries the word example.
/// 6 a literal one character under the minimum. 7 a provider-shaped change in the generated inventory.
/// 8 a literal that carries the word sample, which the config does not excuse. 9 a listed key name whose
/// value is a reference. 10 a provider-shaped constant on the verified GF16 line. 11 plain prose.
pub fn ptiv_change(i: u32) -> PtivChange {
    var c : PtivChange = ptiv_blank();
    if (i == 0) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PASSWORD;
        c.width = 8;
    }
    if (i == 1) {
        c.shape = PTIV_SH_PROVIDER;
    }
    if (i == 2) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PSK;
        c.width = 12;
        c.skip_commit = true;
    }
    if (i == 3) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_WIFI;
        c.width = 10;
        c.skip_commit = true;
        c.skip_push = true;
    }
    if (i == 4) {
        c.shape = PTIV_SH_PROVIDER;
        c.is_local = false;
    }
    if (i == 5) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PASSPHRASE;
        c.width = 9;
        c.ph = PTIV_PH_EXAMPLE;
    }
    if (i == 6) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PASSWD;
        c.width = 5;
    }
    if (i == 7) {
        c.shape = PTIV_SH_PROVIDER;
        c.site = PTIV_SITE_INVENTORY;
    }
    if (i == 8) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PASSWORD;
        c.width = 8;
        c.ph = PTIV_PH_SAMPLE;
    }
    if (i == 9) {
        c.shape = PTIV_SH_PASSWORD;
        c.kw = PTIV_KW_PASSWORD;
        c.width = 8;
        c.refv = true;
    }
    if (i == 10) {
        c.shape = PTIV_SH_PROVIDER;
        c.site = PTIV_SITE_LINE;
    }
    return c;
}

; ---------------------------------------------------------------- L6 flips (the input change)

/// The flip k applied to a change: 0 nothing, 1 lefthook is not installed, 2 the commit uses
/// --no-verify, 3 the push uses --no-verify, 4 the change reaches the remote with no local commit,
/// 5 the key name becomes a word the rule does not list, 6 the literal is one character under the
/// config's own minimum, 7 the value becomes a reference, 8 the literal carries the word example. Any
/// other k changes nothing.
pub fn ptiv_flip(c: PtivChange, k: u32) -> PtivChange {
    var n : PtivChange = c;
    if (k == PTIV_F_HOOKS_OFF) {
        n.hooks_on = false;
    }
    if (k == PTIV_F_SKIP_COMMIT) {
        n.skip_commit = true;
    }
    if (k == PTIV_F_SKIP_PUSH) {
        n.skip_push = true;
    }
    if (k == PTIV_F_NOT_LOCAL) {
        n.is_local = false;
    }
    if (k == PTIV_F_OTHER_WORD) {
        n.kw = PTIV_KW_OTHER;
    }
    if (k == PTIV_F_SHORT and ptiv_cfg_min_len() > 0) {
        n.width = ptiv_cfg_min_len() - 1;
    }
    if (k == PTIV_F_REFERENCE) {
        n.refv = true;
    }
    if (k == PTIV_F_PLACEHOLDER) {
        n.ph = PTIV_PH_EXAMPLE;
    }
    return n;
}

/// Change i with flip k switched on.
pub fn ptiv_change_under(i: u32, k: u32) -> PtivChange {
    return ptiv_flip(ptiv_change(i), k);
}

; ---------------------------------------------------------------- L5 rules (the config's answer over the facts)

/// The rule the config matches on a change. A provider-shaped change meets the default rules when the
/// config keeps them on. A literal meets the custom rule when the rule is in the config, the key-name
/// word is one it lists, the value is not a reference the value class excludes, and the literal is at
/// least as long as the config's own minimum. Anything else matches no rule.
pub fn ptiv_rule_for(c: PtivChange) -> u32 {
    if (c.shape == PTIV_SH_PROVIDER and ptiv_cfg_defaults_on()) {
        return PTIV_R_DEFAULT;
    }
    if (c.shape == PTIV_SH_PASSWORD and ptiv_cfg_rule_named() and ptiv_cfg_lists_word(c.kw)) {
        let floor : u32 = ptiv_cfg_min_len();
        let value_read : bool = c.refv == false or ptiv_cfg_excludes_refs() == false;
        if (value_read and floor > 0 and c.width >= floor) {
            return PTIV_R_PASSWORD;
        }
    }
    return PTIV_R_NONE;
}

/// The allowlist that excuses a matched rule, or PTIV_X_NONE. The path and the line allowlists are
/// global: they excuse any rule. The placeholder allowlist belongs to the custom rule alone, so a
/// provider-shaped change is not excused by a placeholder word. Nothing matched, nothing to excuse.
pub fn ptiv_excuse_for(c: PtivChange, rule: u32) -> u32 {
    if (rule == PTIV_R_NONE) {
        return PTIV_X_NONE;
    }
    if (c.site == PTIV_SITE_INVENTORY and ptiv_cfg_path_allowed()) {
        return PTIV_X_PATH;
    }
    if (c.site == PTIV_SITE_LINE and ptiv_cfg_line_allowed()) {
        return PTIV_X_LINE;
    }
    if (rule == PTIV_R_PASSWORD and ptiv_cfg_excuses_word(c.ph)) {
        return PTIV_X_PLACEHOLDER;
    }
    return PTIV_X_NONE;
}

/// Whether the layer scans this change on its route. The two local layers need a local commit and
/// installed hooks, and each is skipped by its own --no-verify. CI scans every push and pull request,
/// so it always runs (the recorded layer table; see the header).
pub fn ptiv_layer_runs(c: PtivChange, layer: u32) -> bool {
    if (layer == PTIV_L_PRECOMMIT) {
        return c.is_local and c.hooks_on and c.skip_commit == false;
    }
    if (layer == PTIV_L_PREPUSH) {
        return c.is_local and c.hooks_on and c.skip_push == false;
    }
    return layer == PTIV_L_CI;
}

/// The first layer that scans the change on its route, in the order pre-commit, pre-push, CI.
pub fn ptiv_first_layer(c: PtivChange) -> u32 {
    var l : u32 = 0;
    while (l < PTIV_LAYERS) {
        if (ptiv_layer_runs(c, l)) {
            return l;
        }
        l = l + 1;
    }
    return PTIV_L_NONE;
}

/// What the gate says about a change: the rule the config matched, the allowlist that excused it, and
/// the layer that stops it (PTIV_L_NONE when nothing is matched or the match is excused).
pub struct PtivVerdict {
    rule: u32,
    excuse: u32,
    stop: u32,
}

/// The verdict of a change. All three layers read the one config, so the rule and the excuse do not
/// depend on the route; the route only decides which layer meets the change first.
pub fn ptiv_verdict(c: PtivChange) -> PtivVerdict {
    let matched : u32 = ptiv_rule_for(c);
    let excused : u32 = ptiv_excuse_for(c, matched);
    var layer : u32 = PTIV_L_NONE;
    if (matched != PTIV_R_NONE and excused == PTIV_X_NONE) {
        layer = ptiv_first_layer(c);
    }
    return PtivVerdict { rule: matched, excuse: excused, stop: layer };
}

/// The rule that actually stopped the change: the matched rule when it was not excused, else none.
pub fn ptiv_fired(v: PtivVerdict) -> u32 {
    if (v.rule != PTIV_R_NONE and v.excuse == PTIV_X_NONE) {
        return v.rule;
    }
    return PTIV_R_NONE;
}

/// What a layer did with the change: skipped (it does not scan this route), stopped it, let it pass, or
/// never saw it because an earlier layer had already stopped it. PTIV_NO_VALUE past the last layer.
pub fn ptiv_state_of(c: PtivChange, v: PtivVerdict, layer: u32) -> u32 {
    if (layer >= PTIV_LAYERS) {
        return PTIV_NO_VALUE;
    }
    if (ptiv_layer_runs(c, layer) == false) {
        return PTIV_S_SKIPPED;
    }
    if (v.stop == PTIV_L_NONE) {
        return PTIV_S_PASSED;
    }
    if (v.stop == layer) {
        return PTIV_S_STOPPED;
    }
    if (v.stop < layer) {
        return PTIV_S_UNREACHED;
    }
    return PTIV_S_PASSED;
}

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the truth the last load reported.
pub struct PtivState {
    viz: VizState,
    loaded: u8,
}

/// The truth shown for a loaded truth and a flip: a claimable truth (LIVE or VERIFIED) becomes DEMO while
/// a flip is on; CACHED, DEMO and UNKNOWN are kept as loaded.
pub fn ptiv_truth_for(loaded: u8, knob: u32) -> u8 {
    if (knob != 0 and viz_may_claim(loaded)) {
        return VIZ_TRUTH_DEMO;
    }
    return loaded;
}

/// The one reducer of the petal. Every event goes to viz_apply; only the truth is recomputed afterwards,
/// when a load finishes (the new loaded truth) or the flip moves.
pub fn ptiv_apply(p: PtivState, ev: u8, a: u32, b: u32) -> PtivState {
    var n : PtivState = p;
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING) {
        n.loaded = v.truth;
    }
    if (ev == VIZ_EV_LOADED or ev == VIZ_EV_PARAM_SET) {
        v.truth = ptiv_truth_for(n.loaded, v.param);
    }
    n.viz = v;
    return n;
}

/// Whether the shown truth is the one the rule gives for the loaded truth and the flip.
pub fn ptiv_truth_holds(p: PtivState) -> bool {
    return p.viz.truth == ptiv_truth_for(p.loaded, p.viz.param);
}

/// A petal that has not loaded: idle, truth UNKNOWN, no flip.
pub fn ptiv_idle() -> PtivState {
    return PtivState { viz: viz_init(PTIV_LAYERS, PTIV_FLIPS), loaded: VIZ_TRUTH_UNKNOWN };
}

/// A petal opened on the first n changes (at most all twelve): LOAD, then LOADED. Twelve changes load
/// VERIFIED; an empty fixture loads UNKNOWN, because nothing was read.
pub fn ptiv_open_n(n: u32) -> PtivState {
    var count : u32 = n;
    var truth : u8 = VIZ_TRUTH_VERIFIED;
    if (count > PTIV_CHANGE_COUNT) {
        count = PTIV_CHANGE_COUNT;
    }
    if (count == 0) {
        truth = VIZ_TRUTH_UNKNOWN;
    }
    var p : PtivState = ptiv_apply(ptiv_idle(), VIZ_EV_LOAD, 0, 0);
    p = ptiv_apply(p, VIZ_EV_LOADED, count, truth as u32);
    return p;
}

/// A petal ready to explore: all twelve changes, truth VERIFIED, three layers, nine flips.
pub fn ptiv_open() -> PtivState {
    return ptiv_open_n(PTIV_CHANGE_COUNT);
}

; ---------------------------------------------------------------- L2 entities

/// Change i as an entity: viz_ref(NODE, i).
pub fn ptiv_change_ref(i: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, i);
}

/// The change a ref names when it is a node below `rows`, else PTIV_NO_CHANGE.
pub fn ptiv_change_at(r: u32, rows: u32) -> u32 {
    if (viz_ref_kind(r) == VIZ_ENT_NODE and viz_ref_index(r) < rows) {
        return viz_ref_index(r);
    }
    return PTIV_NO_CHANGE;
}

/// The changes the views show: all loaded ones while READY, none while loading, empty or failed.
pub fn ptiv_rows(p: PtivState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return 0;
    }
    if (p.viz.item_count > PTIV_CHANGE_COUNT) {
        return PTIV_CHANGE_COUNT;
    }
    return p.viz.item_count;
}

/// The entity of focus index f: changes 0..11. VIZ_REF_NONE past the end.
pub fn ptiv_focus_ref(p: PtivState, f: u32) -> u32 {
    if (f >= p.viz.focus_count or f >= PTIV_CHANGE_COUNT) {
        return VIZ_REF_NONE;
    }
    return ptiv_change_ref(f);
}

/// ACTIVATE on the focused item: the same as clicking it. Nothing focused is a no-op.
pub fn ptiv_activate(p: PtivState) -> PtivState {
    let r : u32 = ptiv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    return ptiv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// The change the trace describes: the hovered change if there is one, else the selected one, else
/// PTIV_NO_CHANGE.
pub fn ptiv_subject(p: PtivState) -> u32 {
    let rows : u32 = ptiv_rows(p);
    let h : u32 = ptiv_change_at(p.viz.hover, rows);
    if (h != PTIV_NO_CHANGE) {
        return h;
    }
    return ptiv_change_at(p.viz.selected, rows);
}

; ---------------------------------------------------------------- L7 views: list

/// The layer that stops change i under the current flip (PTIV_L_NONE when none does);
/// PTIV_NO_VALUE past the rows.
pub fn ptiv_list_stop(p: PtivState, i: u32) -> u32 {
    if (i >= ptiv_rows(p)) {
        return PTIV_NO_VALUE;
    }
    return ptiv_verdict(ptiv_change_under(i, p.viz.param)).stop;
}

/// The rule that stopped change i under the current flip (PTIV_R_NONE when nothing did);
/// PTIV_NO_VALUE past the rows.
pub fn ptiv_list_rule(p: PtivState, i: u32) -> u32 {
    if (i >= ptiv_rows(p)) {
        return PTIV_NO_VALUE;
    }
    return ptiv_fired(ptiv_verdict(ptiv_change_under(i, p.viz.param)));
}

/// How the list draws change i: the contract's one highlight rule; none past the rows.
pub fn ptiv_list_hl(p: PtivState, i: u32) -> u8 {
    if (i >= ptiv_rows(p)) {
        return VIZ_HL_NONE;
    }
    return viz_highlight(p.viz, ptiv_change_ref(i));
}

/// The inverse of the list layout: the change under a pixel (frame coordinates), else VIZ_REF_NONE.
pub fn ptiv_list_hit(p: PtivState, px: u32, py: u32) -> u32 {
    if (px < PTIV_LIST_X or px >= PTIV_LIST_X + PTIV_LIST_W or py < PTIV_LIST_Y) {
        return VIZ_REF_NONE;
    }
    let i : u32 = (py - PTIV_LIST_Y) / PTIV_LINE_H;
    if (i >= ptiv_rows(p)) {
        return VIZ_REF_NONE;
    }
    return ptiv_change_ref(i);
}

/// How many changes the gate stops at the layer (PTIV_L_NONE counts the changes nothing stops).
pub fn ptiv_stopped_count(p: PtivState, layer: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < ptiv_rows(p)) {
        if (ptiv_list_stop(p, i) == layer) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; ---------------------------------------------------------------- L7 views: trace

/// How many layer rows are revealed: none without a subject, else the layers up to the current step.
pub fn ptiv_trace_shown(p: PtivState) -> u32 {
    if (ptiv_subject(p) == PTIV_NO_CHANGE) {
        return 0;
    }
    return viz_clamp(p.viz.step, PTIV_LAYERS) + 1;
}

/// What layer k did with the subject under the current flip; PTIV_NO_VALUE while the row is hidden
/// (past the current step) or there is no subject.
pub fn ptiv_trace_state(p: PtivState, k: u32) -> u32 {
    let s : u32 = ptiv_subject(p);
    if (s == PTIV_NO_CHANGE or k >= ptiv_trace_shown(p)) {
        return PTIV_NO_VALUE;
    }
    let c : PtivChange = ptiv_change_under(s, p.viz.param);
    return ptiv_state_of(c, ptiv_verdict(c), k);
}

/// The rule layer k matched on the subject, shown only for a layer that scanned it (stopped or passed);
/// PTIV_NO_VALUE for a skipped, unreached or hidden row.
pub fn ptiv_trace_rule(p: PtivState, k: u32) -> u32 {
    let st : u32 = ptiv_trace_state(p, k);
    if (st != PTIV_S_STOPPED and st != PTIV_S_PASSED) {
        return PTIV_NO_VALUE;
    }
    return ptiv_verdict(ptiv_change_under(ptiv_subject(p), p.viz.param)).rule;
}

/// The allowlist that excused the match at layer k, shown only for a layer that scanned the subject;
/// PTIV_NO_VALUE for a skipped, unreached or hidden row.
pub fn ptiv_trace_excuse(p: PtivState, k: u32) -> u32 {
    let st : u32 = ptiv_trace_state(p, k);
    if (st != PTIV_S_STOPPED and st != PTIV_S_PASSED) {
        return PTIV_NO_VALUE;
    }
    return ptiv_verdict(ptiv_change_under(ptiv_subject(p), p.viz.param)).excuse;
}

; ---------------------------------------------------------------- L8 truth: the badge

/// The truth the badge shows: the state's truth, an unknown code read as UNKNOWN.
pub fn ptiv_badge(p: PtivState) -> u8 {
    return viz_truth(p.viz.truth);
}

/// The badge colour, 0xRRGGBB, from the contract's table.
pub fn ptiv_badge_rgb(p: PtivState) -> u32 {
    return viz_truth_rgb(ptiv_badge(p));
}

/// Whether the petal may present its answers as a result: true only for LIVE or VERIFIED.
pub fn ptiv_badge_claims(p: PtivState) -> bool {
    return viz_may_claim(ptiv_badge(p));
}

; ---------------------------------------------------------------- L9 host

/// The layout: the badge, then the list and the trace, all root slots (the petal is not wrapped in a
/// frame, so it embeds under any slot of another host). Frame coordinates.
pub fn ptiv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PTIV_BADGE_X, PTIV_BADGE_Y, PTIV_BADGE_W, PTIV_BADGE_H);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, PTIV_LIST_X, PTIV_LIST_Y, PTIV_LIST_W, PTIV_CHANGE_COUNT * PTIV_LINE_H);
    h = vh_add(h, VIZ_REP_TRACE, VH_ROOT, PTIV_TRACE_X, PTIV_TRACE_Y, PTIV_TRACE_W, PTIV_LAYERS * PTIV_LINE_H);
    return h;
}

/// The reps of the petal: the list, the layer trace and the truth badge. The plan's row 26 holds 276.
pub fn ptiv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_TRACE) | viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// The petal's reducer and the contract's agree on the event, and the event changed the state.
fn ptiv_t_routes(p: PtivState, ev: u8, a: u32, b: u32) -> bool {
    let mine : PtivState = ptiv_apply(p, ev, a, b);
    let theirs : VizState = viz_apply(p.viz, ev, a, b);
    return viz_same(mine.viz, theirs) and mine.viz.revision == theirs.revision and viz_same(mine.viz, p.viz) == false;
}

/// An open petal with flip k switched on, through the reducer.
fn ptiv_t_flip(k: u32) -> PtivState {
    return ptiv_apply(ptiv_open(), VIZ_EV_PARAM_SET, k, 0);
}

/// Change i selected in p, through the reducer.
fn ptiv_t_select(p: PtivState, i: u32) -> PtivState {
    return ptiv_apply(p, VIZ_EV_SELECT, ptiv_change_ref(i), 0);
}

/// Reload p: LOAD, then LOADED with n items and the truth t.
fn ptiv_t_reload(p: PtivState, n: u32, t: u8) -> PtivState {
    let loading : PtivState = ptiv_apply(p, VIZ_EV_LOAD, 0, 0);
    return ptiv_apply(loading, VIZ_EV_LOADED, n, t as u32);
}

/// Whether change i under flip k has this matched rule, this excuse and this stopping layer.
fn ptiv_t_is(i: u32, k: u32, rule: u32, excuse: u32, stop: u32) -> bool {
    let v : PtivVerdict = ptiv_verdict(ptiv_change_under(i, k));
    return v.rule == rule and v.excuse == excuse and v.stop == stop;
}

/// The stopping layer of change i under flip k.
fn ptiv_t_stop(i: u32, k: u32) -> u32 {
    return ptiv_verdict(ptiv_change_under(i, k)).stop;
}

/// A direct question to the source's bytes, without the petal's probes: the writer, then buf_has.
fn ptiv_t_direct(needle: str, needle_len: usize) -> bool {
    var raw : [4096]u8 = undefined;
    let total : usize = gitleaks_toml(&raw, 4096);
    return total <= 4096 and buf_has(&raw, total, needle, needle_len);
}

; ---------------------------------------------------------------- tests: state (one VizState, one reducer)

test a_fresh_petal_is_idle_and_unknown {
    let p : PtivState = ptiv_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert p.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert p.loaded == VIZ_TRUTH_UNKNOWN;
    assert p.viz.revision == 0;
    assert p.viz.step_count == PTIV_LAYERS;
    assert p.viz.param_count == PTIV_FLIPS;
    assert ptiv_rows(p) == 0;
    assert ptiv_badge_claims(p) == false;
    assert ptiv_truth_holds(p);
}

test open_loads_the_twelve_changes_with_the_truth_verified {
    let p : PtivState = ptiv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == 12;
    assert p.viz.focus_count == 12;
    assert ptiv_rows(p) == PTIV_CHANGE_COUNT;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.loaded == VIZ_TRUTH_VERIFIED;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.viz.step == 0;
    assert p.viz.param == 0;
    assert p.viz.revision == 2;
    assert ptiv_truth_holds(p);
}

test every_event_goes_through_the_one_reducer {
    let p : PtivState = ptiv_open();
    assert ptiv_t_routes(p, VIZ_EV_HOVER, ptiv_change_ref(2), 0);
    assert ptiv_t_routes(p, VIZ_EV_SELECT, ptiv_change_ref(3), 0);
    assert ptiv_t_routes(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert ptiv_t_routes(p, VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_t_routes(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert ptiv_t_routes(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert ptiv_t_routes(p, VIZ_EV_MOTION, 1, 0);
    // The flip event: the contract's parameter and revision, plus the recomputed truth.
    let q : PtivState = ptiv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    let r : VizState = viz_apply(p.viz, VIZ_EV_PARAM_SET, 5, 0);
    assert q.viz.param == r.param;
    assert q.viz.revision == r.revision;
    assert q.viz.revision == p.viz.revision + 1;
    assert r.truth == VIZ_TRUTH_VERIFIED;
    assert q.viz.truth == VIZ_TRUTH_DEMO;
}

test hover_select_back_and_clear_edit_the_one_state {
    var p : PtivState = ptiv_open();
    p = ptiv_apply(p, VIZ_EV_HOVER, ptiv_change_ref(2), 0);
    assert p.viz.hover == ptiv_change_ref(2);
    p = ptiv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert p.viz.hover == VIZ_REF_NONE;
    p = ptiv_t_select(p, 4);
    assert p.viz.selected == ptiv_change_ref(4);
    assert viz_back_closes(p.viz) == false;
    // Selecting the selected change clears it; selecting another switches.
    p = ptiv_t_select(p, 4);
    assert p.viz.selected == VIZ_REF_NONE;
    p = ptiv_t_select(p, 4);
    p = ptiv_t_select(p, 5);
    assert p.viz.selected == ptiv_change_ref(5);
    p = ptiv_apply(p, VIZ_EV_BACK, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    assert viz_back_closes(p.viz);
    p = ptiv_t_select(p, 1);
    p = ptiv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
}

test step_and_flip_are_clamped_to_their_ranges {
    var p : PtivState = ptiv_open();
    p = ptiv_apply(p, VIZ_EV_STEP_SET, 99, 0);
    assert p.viz.step == 2;
    let r : u32 = p.viz.revision;
    p = ptiv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert p.viz.step == 2;
    assert p.viz.revision == r;
    p = ptiv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 1;
    p = ptiv_apply(p, VIZ_EV_STEP_SET, 0, 0);
    p = ptiv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 0;
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 99, 0);
    assert p.viz.param == 8;
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert p.viz.param == 5;
}

; ---------------------------------------------------------------- tests: entities and lifecycle edges

test a_change_is_a_node_ref_and_an_out_of_range_ref_names_no_change {
    assert ptiv_change_ref(3) == viz_ref(VIZ_ENT_NODE, 3);
    assert ptiv_change_ref(3) == 65539;
    assert viz_ref_kind(ptiv_change_ref(3)) == VIZ_ENT_NODE;
    assert viz_ref_index(ptiv_change_ref(3)) == 3;
    assert ptiv_change_at(ptiv_change_ref(3), 12) == 3;
    assert ptiv_change_at(ptiv_change_ref(3), 3) == PTIV_NO_CHANGE;
    assert ptiv_change_at(ptiv_change_ref(12), 12) == PTIV_NO_CHANGE;
    assert ptiv_change_at(ptiv_change_ref(20), 12) == PTIV_NO_CHANGE;
    assert ptiv_change_at(viz_ref(VIZ_ENT_EDGE, 3), 12) == PTIV_NO_CHANGE;
    assert ptiv_change_at(viz_ref(VIZ_ENT_CELL, 3), 12) == PTIV_NO_CHANGE;
    assert ptiv_change_at(VIZ_REF_NONE, 12) == PTIV_NO_CHANGE;
    // A hovered or selected ref outside the twelve names no subject, so no view shows anything for it.
    var p : PtivState = ptiv_apply(ptiv_open(), VIZ_EV_HOVER, ptiv_change_ref(20), 0);
    p = ptiv_t_select(p, 12);
    assert p.viz.hover == ptiv_change_ref(20);
    assert ptiv_subject(p) == PTIV_NO_CHANGE;
    assert ptiv_trace_shown(p) == 0;
    assert ptiv_trace_state(p, 0) == PTIV_NO_VALUE;
    assert ptiv_trace_rule(p, 0) == PTIV_NO_VALUE;
    assert ptiv_trace_excuse(p, 0) == PTIV_NO_VALUE;
    assert ptiv_list_stop(p, 12) == PTIV_NO_VALUE;
    assert ptiv_list_rule(p, 12) == PTIV_NO_VALUE;
    assert ptiv_list_hl(p, 20) == VIZ_HL_NONE;
    assert ptiv_list_hl(p, 11) == VIZ_HL_NONE;
    assert ptiv_focus_ref(p, 11) == ptiv_change_ref(11);
    assert ptiv_focus_ref(p, 12) == VIZ_REF_NONE;
    // The blank change stands in for a row past the fixture: plain prose on the normal route.
    assert ptiv_t_is(40, 0, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_first_layer(ptiv_change(40)) == PTIV_L_PRECOMMIT;
}

test loading_ignores_interaction_and_shows_no_rows {
    let ready : PtivState = ptiv_open();
    let p : PtivState = ptiv_apply(ready, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert ptiv_rows(p) == 0;
    assert viz_same(ptiv_apply(p, VIZ_EV_HOVER, ptiv_change_ref(2), 0).viz, p.viz);
    assert viz_same(ptiv_apply(p, VIZ_EV_SELECT, ptiv_change_ref(2), 0).viz, p.viz);
    assert viz_same(ptiv_apply(p, VIZ_EV_STEP_NEXT, 0, 0).viz, p.viz);
    assert viz_same(ptiv_apply(p, VIZ_EV_PARAM_SET, 3, 0).viz, p.viz);
    assert ptiv_list_stop(p, 0) == PTIV_NO_VALUE;
    assert ptiv_list_hl(p, 0) == VIZ_HL_NONE;
    assert ptiv_list_hit(p, 30, 70) == VIZ_REF_NONE;
    assert ptiv_subject(p) == PTIV_NO_CHANGE;
    assert ptiv_trace_state(p, 0) == PTIV_NO_VALUE;
    assert ptiv_stopped_count(p, PTIV_L_CI) == 0;
    // The load finishing brings the rows back, with the selection and hover cleared.
    let done : PtivState = ptiv_apply(p, VIZ_EV_LOADED, 12, VIZ_TRUTH_VERIFIED as u32);
    assert done.viz.lifecycle == VIZ_LC_READY;
    assert ptiv_rows(done) == 12;
    assert ptiv_list_stop(done, 0) == PTIV_L_PRECOMMIT;
}

test an_empty_fixture_is_empty_and_every_view_says_nothing {
    let e : PtivState = ptiv_open_n(0);
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert e.viz.focus_count == 0;
    assert e.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert ptiv_badge_claims(e) == false;
    assert ptiv_rows(e) == 0;
    assert ptiv_list_stop(e, 0) == PTIV_NO_VALUE;
    assert ptiv_list_hit(e, 30, 70) == VIZ_REF_NONE;
    assert ptiv_trace_shown(e) == 0;
    assert viz_same(ptiv_apply(e, VIZ_EV_HOVER, ptiv_change_ref(0), 0).viz, e.viz);
    assert viz_same(ptiv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz, e.viz);
    assert ptiv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz.focus == VIZ_NO_FOCUS;
    // More changes than the fixture holds are clamped; fewer shorten every view and the focus ring.
    assert ptiv_open_n(99).viz.item_count == 12;
    var p : PtivState = ptiv_open_n(3);
    assert ptiv_rows(p) == 3;
    assert ptiv_list_stop(p, 2) == PTIV_L_PREPUSH;
    assert ptiv_list_stop(p, 3) == PTIV_NO_VALUE;
    assert ptiv_list_hit(p, 30, 60 + 3 * 22) == VIZ_REF_NONE;
    assert ptiv_stopped_count(p, PTIV_L_PRECOMMIT) == 2;
    assert ptiv_stopped_count(p, PTIV_L_PREPUSH) == 1;
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 2;
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
}

test a_failed_load_is_an_error_and_retry_loads_again {
    var p : PtivState = ptiv_apply(ptiv_open(), VIZ_EV_FAILED, 5, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 5;
    assert ptiv_rows(p) == 0;
    assert ptiv_list_stop(p, 0) == PTIV_NO_VALUE;
    assert ptiv_trace_state(p, 0) == PTIV_NO_VALUE;
    assert viz_same(ptiv_apply(p, VIZ_EV_SELECT, ptiv_change_ref(1), 0).viz, p.viz);
    p = ptiv_apply(p, VIZ_EV_RETRY, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert p.viz.error == 0;
    p = ptiv_apply(p, VIZ_EV_LOADED, 12, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert ptiv_rows(p) == 12;
    assert ptiv_list_stop(p, 1) == PTIV_L_PRECOMMIT;
}

; ---------------------------------------------------------------- tests: the config is the source's own bytes

test the_probes_are_questions_put_to_the_bytes_the_source_writes {
    var raw : [4096]u8 = undefined;
    let total : usize = gitleaks_toml(&raw, 4096);
    assert total == TOML_LEN;
    assert ptiv_cfg_len() == TOML_LEN;
    assert TOML_LEN <= 2048;
    // Each probe agrees with a direct question to the same bytes, and with what the source pins.
    assert ptiv_cfg_defaults_on();
    assert buf_has(&raw, total, "useDefault = true", 17) == true;
    assert ptiv_cfg_rule_named();
    assert buf_has(&raw, total, "id = \"hardcoded-password-literal\"", 33) == true;
    assert ptiv_cfg_excludes_refs();
    assert buf_has(&raw, total, "<>${}", 5) == true;
    assert ptiv_cfg_path_allowed();
    assert buf_has(&raw, total, "conformance/trinity/inventory\\.json", 35) == true;
    assert ptiv_cfg_line_allowed();
    assert buf_has(&raw, total, "# fallback for GF16", 19) == true;
    // The five key-name words the source's own test pins are listed; a sixth word is not.
    assert ptiv_cfg_lists_word(PTIV_KW_PASSPHRASE);
    assert ptiv_cfg_lists_word(PTIV_KW_PASSWORD);
    assert ptiv_cfg_lists_word(PTIV_KW_PASSWD);
    assert ptiv_cfg_lists_word(PTIV_KW_WIFI);
    assert ptiv_cfg_lists_word(PTIV_KW_PSK);
    assert ptiv_cfg_lists_word(PTIV_KW_OTHER) == false;
    assert ptiv_cfg_lists_word(PTIV_KW_COUNT) == false;
    assert buf_has(&raw, total, "keywords = [\"passphrase\", \"password\", \"passwd\", \"wifi\", \"psk\"]", 61) == true;
    assert buf_has(&raw, total, "\"token\"", 7) == false;
    // Three placeholder words are excused; sample is not, and neither is "no word".
    assert ptiv_cfg_excuses_word(PTIV_PH_EXAMPLE);
    assert ptiv_cfg_excuses_word(PTIV_PH_CHANGEME);
    assert ptiv_cfg_excuses_word(PTIV_PH_DUMMY);
    assert ptiv_cfg_excuses_word(PTIV_PH_SAMPLE) == false;
    assert ptiv_cfg_excuses_word(PTIV_PH_NONE) == false;
    assert ptiv_cfg_excuses_word(PTIV_PH_COUNT) == false;
    assert buf_has(&raw, total, "changeme|placeholder", 20) == true;
    assert buf_has(&raw, total, "|sample|", 8) == false;
    // The minimum literal length is the number between the braces of the regex.
    assert ptiv_cfg_min_len() == 6;
    assert buf_has(&raw, total, "{6,}", 4) == true;
}

test every_query_ends_where_its_length_says {
    // A runtime index, as the source does it: the last byte of each needle sits at length - 1, so an
    // over-counted length would read past the string and an under-counted one would land inside it.
    var w : usize = 0;
    while (w < 6) {
        let s : str = PTIV_KW_NEEDLES[w];
        let e : usize = PTIV_KW_LENS[w] - 1;
        assert s[0] == '"';
        assert s[e] == '"';
        w = w + 1;
    }
    var q : usize = 1;
    while (q < 5) {
        let s : str = PTIV_PH_NEEDLES[q];
        let e : usize = PTIV_PH_LENS[q] - 1;
        assert s[0] == '|';
        assert s[e] == '|';
        q = q + 1;
    }
    var i : usize = PTIV_N_DEFAULTS_LEN - 1;
    assert PTIV_N_DEFAULTS[i] == 'e';
    i = PTIV_N_RULE_ID_LEN - 1;
    assert PTIV_N_RULE_ID[i] == '"';
    i = PTIV_N_REFS_LEN - 1;
    assert PTIV_N_REFS[i] == '}';
    i = PTIV_N_PATH_LEN - 1;
    assert PTIV_N_PATH[i] == 'n';
    i = PTIV_N_LINE_LEN - 1;
    assert PTIV_N_LINE[i] == '6';
}

; ---------------------------------------------------------------- tests: which layer, which rule

test the_fixture_stops_are_the_gates_answers {
    // Stopped: rule, no excuse, and the layer the route reaches first.
    assert ptiv_t_is(0, 0, PTIV_R_PASSWORD, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    assert ptiv_t_is(1, 0, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    assert ptiv_t_is(2, 0, PTIV_R_PASSWORD, PTIV_X_NONE, PTIV_L_PREPUSH);
    assert ptiv_t_is(3, 0, PTIV_R_PASSWORD, PTIV_X_NONE, PTIV_L_CI);
    assert ptiv_t_is(4, 0, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_CI);
    // Matched and excused: the placeholder, the path and the line allowlists.
    assert ptiv_t_is(5, 0, PTIV_R_PASSWORD, PTIV_X_PLACEHOLDER, PTIV_L_NONE);
    assert ptiv_t_is(7, 0, PTIV_R_DEFAULT, PTIV_X_PATH, PTIV_L_NONE);
    assert ptiv_t_is(10, 0, PTIV_R_DEFAULT, PTIV_X_LINE, PTIV_L_NONE);
    // Never matched: one under the minimum, a reference, plain prose.
    assert ptiv_t_is(6, 0, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(9, 0, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(11, 0, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    // A near miss: the word sample looks like a placeholder, the config does not excuse it.
    assert ptiv_t_is(8, 0, PTIV_R_PASSWORD, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    // The fired rule is the matched rule only when no allowlist excused it.
    assert ptiv_fired(ptiv_verdict(ptiv_change(0))) == PTIV_R_PASSWORD;
    assert ptiv_fired(ptiv_verdict(ptiv_change(1))) == PTIV_R_DEFAULT;
    assert ptiv_fired(ptiv_verdict(ptiv_change(5))) == PTIV_R_NONE;
    assert ptiv_fired(ptiv_verdict(ptiv_change(7))) == PTIV_R_NONE;
    assert ptiv_fired(ptiv_verdict(ptiv_change(6))) == PTIV_R_NONE;
    // The list view shows the same stops and rules.
    let p : PtivState = ptiv_open();
    assert ptiv_list_stop(p, 0) == PTIV_L_PRECOMMIT;
    assert ptiv_list_stop(p, 2) == PTIV_L_PREPUSH;
    assert ptiv_list_stop(p, 3) == PTIV_L_CI;
    assert ptiv_list_stop(p, 5) == PTIV_L_NONE;
    assert ptiv_list_rule(p, 0) == PTIV_R_PASSWORD;
    assert ptiv_list_rule(p, 1) == PTIV_R_DEFAULT;
    assert ptiv_list_rule(p, 4) == PTIV_R_DEFAULT;
    assert ptiv_list_rule(p, 5) == PTIV_R_NONE;
    // And the pinned layer codes: pre-commit 0, pre-push 1, CI 2, none 3.
    assert ptiv_list_stop(p, 0) == 0;
    assert ptiv_list_stop(p, 2) == 1;
    assert ptiv_list_stop(p, 3) == 2;
    assert ptiv_list_stop(p, 6) == 3;
}

test the_near_misses_are_decided_by_the_configs_own_text {
    // Sample is not on the config's placeholder list, example is; the petal follows the bytes.
    assert ptiv_t_direct("|example|", 9) == true;
    assert ptiv_t_direct("|sample|", 8) == false;
    assert ptiv_verdict(ptiv_change(5)).excuse == PTIV_X_PLACEHOLDER;
    assert ptiv_verdict(ptiv_change(8)).excuse == PTIV_X_NONE;
    // Change 6 is one character under the minimum the regex asks for, read from the regex.
    assert ptiv_change(6).width + 1 == ptiv_cfg_min_len();
    assert ptiv_t_direct("{6,}", 4) == true;
    // At the minimum the same change matches; one under, it does not.
    var c : PtivChange = ptiv_change(6);
    c.width = ptiv_cfg_min_len();
    assert ptiv_rule_for(c) == PTIV_R_PASSWORD;
    c.width = ptiv_cfg_min_len() - 1;
    assert ptiv_rule_for(c) == PTIV_R_NONE;
    // A reference value is read as a literal only if the config did not exclude the reference characters.
    assert ptiv_t_direct("<>${}", 5) == true;
    assert ptiv_rule_for(ptiv_change(9)) == PTIV_R_NONE;
    var d : PtivChange = ptiv_change(9);
    d.refv = false;
    assert ptiv_rule_for(d) == PTIV_R_PASSWORD;
    // A key name outside the five listed words meets no custom rule, whatever else is true.
    var e : PtivChange = ptiv_change(0);
    e.kw = PTIV_KW_OTHER;
    assert ptiv_rule_for(e) == PTIV_R_NONE;
    // The placeholder allowlist is the custom rule's own: a provider-shaped change keeps its stop.
    var f : PtivChange = ptiv_change(1);
    f.ph = PTIV_PH_EXAMPLE;
    assert ptiv_excuse_for(f, PTIV_R_DEFAULT) == PTIV_X_NONE;
    assert ptiv_verdict(f).stop == PTIV_L_PRECOMMIT;
    // The path and the line allowlists are global: they excuse either rule.
    assert ptiv_excuse_for(ptiv_change(7), PTIV_R_PASSWORD) == PTIV_X_PATH;
    assert ptiv_excuse_for(ptiv_change(10), PTIV_R_PASSWORD) == PTIV_X_LINE;
    assert ptiv_excuse_for(ptiv_change(0), PTIV_R_NONE) == PTIV_X_NONE;
}

test a_layer_runs_only_on_a_route_that_reaches_it {
    var l : u32 = 0;
    while (l < PTIV_LAYERS) {
        assert ptiv_layer_runs(ptiv_change(0), l);
        l = l + 1;
    }
    // Change 2 skips the commit hook; change 3 skips both; change 4 has no local commit.
    assert ptiv_layer_runs(ptiv_change(2), PTIV_L_PRECOMMIT) == false;
    assert ptiv_layer_runs(ptiv_change(2), PTIV_L_PREPUSH);
    assert ptiv_layer_runs(ptiv_change(2), PTIV_L_CI);
    assert ptiv_layer_runs(ptiv_change(3), PTIV_L_PRECOMMIT) == false;
    assert ptiv_layer_runs(ptiv_change(3), PTIV_L_PREPUSH) == false;
    assert ptiv_layer_runs(ptiv_change(3), PTIV_L_CI);
    assert ptiv_layer_runs(ptiv_change(4), PTIV_L_PRECOMMIT) == false;
    assert ptiv_layer_runs(ptiv_change(4), PTIV_L_PREPUSH) == false;
    assert ptiv_layer_runs(ptiv_change(4), PTIV_L_CI);
    // Not installed hooks look like a bot push: only CI is left. A layer past CI is not a layer.
    assert ptiv_layer_runs(ptiv_flip(ptiv_change(0), PTIV_F_HOOKS_OFF), PTIV_L_PRECOMMIT) == false;
    assert ptiv_layer_runs(ptiv_flip(ptiv_change(0), PTIV_F_HOOKS_OFF), PTIV_L_PREPUSH) == false;
    assert ptiv_layer_runs(ptiv_flip(ptiv_change(0), PTIV_F_HOOKS_OFF), PTIV_L_CI);
    assert ptiv_layer_runs(ptiv_change(0), PTIV_L_NONE) == false;
    // The first layer that runs is the one that stops a change the config matches; for a change the
    // config does not stop, the first layer still runs but there is nothing for it to stop.
    assert ptiv_first_layer(ptiv_change(0)) == PTIV_L_PRECOMMIT;
    assert ptiv_first_layer(ptiv_change(2)) == PTIV_L_PREPUSH;
    assert ptiv_first_layer(ptiv_change(3)) == PTIV_L_CI;
    assert ptiv_first_layer(ptiv_change(4)) == PTIV_L_CI;
    assert ptiv_first_layer(ptiv_change(5)) == PTIV_L_PRECOMMIT;
    assert ptiv_verdict(ptiv_change(5)).stop == PTIV_L_NONE;
    assert ptiv_verdict(ptiv_change(0)).stop == ptiv_first_layer(ptiv_change(0));
}

; ---------------------------------------------------------------- tests: the trace walks the layers

test the_trace_reveals_layers_up_to_the_current_step {
    // No subject: nothing revealed.
    var p : PtivState = ptiv_open();
    assert ptiv_trace_shown(p) == 0;
    assert ptiv_trace_state(p, 0) == PTIV_NO_VALUE;
    // Change 2 (the commit hook skipped) at step 0: only pre-commit is shown, and it did not run.
    p = ptiv_t_select(p, 2);
    assert ptiv_trace_shown(p) == 1;
    assert ptiv_trace_state(p, 0) == PTIV_S_SKIPPED;
    assert ptiv_trace_state(p, 1) == PTIV_NO_VALUE;
    p = ptiv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert ptiv_trace_shown(p) == 2;
    assert ptiv_trace_state(p, 1) == PTIV_S_STOPPED;
    assert ptiv_trace_state(p, 2) == PTIV_NO_VALUE;
    p = ptiv_apply(p, VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_trace_shown(p) == 3;
    assert ptiv_trace_state(p, 0) == PTIV_S_SKIPPED;
    assert ptiv_trace_state(p, 1) == PTIV_S_STOPPED;
    assert ptiv_trace_state(p, 2) == PTIV_S_UNREACHED;
    assert ptiv_trace_state(p, 3) == PTIV_NO_VALUE;
    // Stepping back hides the last row again.
    p = ptiv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert ptiv_trace_shown(p) == 2;
    assert ptiv_trace_state(p, 2) == PTIV_NO_VALUE;
    assert ptiv_trace_state(p, 1) == PTIV_S_STOPPED;
}

test the_trace_names_the_rule_and_the_excuse_of_each_layer_that_scanned {
    // Change 0 is stopped by the first layer; the two later layers never see it.
    var p : PtivState = ptiv_apply(ptiv_t_select(ptiv_open(), 0), VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_trace_state(p, 0) == PTIV_S_STOPPED;
    assert ptiv_trace_state(p, 1) == PTIV_S_UNREACHED;
    assert ptiv_trace_state(p, 2) == PTIV_S_UNREACHED;
    assert ptiv_trace_rule(p, 0) == PTIV_R_PASSWORD;
    assert ptiv_trace_excuse(p, 0) == PTIV_X_NONE;
    assert ptiv_trace_rule(p, 1) == PTIV_NO_VALUE;
    assert ptiv_trace_excuse(p, 2) == PTIV_NO_VALUE;
    // Change 5 passes all three layers, because the placeholder allowlist excused the custom rule.
    p = ptiv_apply(ptiv_t_select(ptiv_open(), 5), VIZ_EV_STEP_SET, 2, 0);
    var k : u32 = 0;
    while (k < PTIV_LAYERS) {
        assert ptiv_trace_state(p, k) == PTIV_S_PASSED;
        assert ptiv_trace_rule(p, k) == PTIV_R_PASSWORD;
        assert ptiv_trace_excuse(p, k) == PTIV_X_PLACEHOLDER;
        k = k + 1;
    }
    // Change 7 passes because of the path; change 6 passes because no rule matched at all.
    p = ptiv_apply(ptiv_t_select(ptiv_open(), 7), VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_trace_rule(p, 1) == PTIV_R_DEFAULT;
    assert ptiv_trace_excuse(p, 1) == PTIV_X_PATH;
    p = ptiv_apply(ptiv_t_select(ptiv_open(), 6), VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_trace_state(p, 2) == PTIV_S_PASSED;
    assert ptiv_trace_rule(p, 2) == PTIV_R_NONE;
    assert ptiv_trace_excuse(p, 2) == PTIV_X_NONE;
    // Change 4 reached CI alone: the two local layers are skipped and show no rule.
    p = ptiv_apply(ptiv_t_select(ptiv_open(), 4), VIZ_EV_STEP_SET, 2, 0);
    assert ptiv_trace_state(p, 0) == PTIV_S_SKIPPED;
    assert ptiv_trace_rule(p, 0) == PTIV_NO_VALUE;
    assert ptiv_trace_state(p, 2) == PTIV_S_STOPPED;
    assert ptiv_trace_rule(p, 2) == PTIV_R_DEFAULT;
}

; ---------------------------------------------------------------- tests: one input change, recomputed

test not_installing_the_hooks_leaves_ci_as_the_only_layer {
    let before : PtivState = ptiv_open();
    let p : PtivState = ptiv_t_flip(PTIV_F_HOOKS_OFF);
    assert p.viz.param == 1;
    assert p.viz.revision == before.viz.revision + 1;
    // Before: stops at all three layers. After: every stop that was a stop moves to CI.
    assert ptiv_stopped_count(before, PTIV_L_PRECOMMIT) == 3;
    assert ptiv_stopped_count(before, PTIV_L_PREPUSH) == 1;
    assert ptiv_stopped_count(before, PTIV_L_CI) == 2;
    assert ptiv_stopped_count(before, PTIV_L_NONE) == 6;
    assert ptiv_stopped_count(p, PTIV_L_PRECOMMIT) == 0;
    assert ptiv_stopped_count(p, PTIV_L_PREPUSH) == 0;
    assert ptiv_stopped_count(p, PTIV_L_CI) == 6;
    assert ptiv_stopped_count(p, PTIV_L_NONE) == 6;
    assert ptiv_list_stop(p, 0) == PTIV_L_CI;
    assert ptiv_list_stop(p, 1) == PTIV_L_CI;
    assert ptiv_list_stop(p, 2) == PTIV_L_CI;
    assert ptiv_list_stop(p, 8) == PTIV_L_CI;
    assert ptiv_list_stop(p, 5) == PTIV_L_NONE;
    // The one config does not care which layer reads it: the rule is the same, only the layer moved.
    assert ptiv_list_rule(p, 0) == ptiv_list_rule(before, 0);
    assert ptiv_list_rule(p, 1) == ptiv_list_rule(before, 1);
    assert ptiv_list_rule(p, 0) == PTIV_R_PASSWORD;
}

test skipping_one_hook_moves_the_stop_one_layer_on {
    // --no-verify on the commit: pre-commit is skipped, pre-push takes over.
    let sc : PtivState = ptiv_t_flip(PTIV_F_SKIP_COMMIT);
    assert ptiv_list_stop(sc, 0) == PTIV_L_PREPUSH;
    assert ptiv_list_stop(sc, 1) == PTIV_L_PREPUSH;
    assert ptiv_list_stop(sc, 2) == PTIV_L_PREPUSH;
    assert ptiv_list_stop(sc, 3) == PTIV_L_CI;
    assert ptiv_list_stop(sc, 4) == PTIV_L_CI;
    assert ptiv_list_stop(sc, 8) == PTIV_L_PREPUSH;
    assert ptiv_stopped_count(sc, PTIV_L_PRECOMMIT) == 0;
    assert ptiv_stopped_count(sc, PTIV_L_PREPUSH) == 4;
    assert ptiv_stopped_count(sc, PTIV_L_CI) == 2;
    // --no-verify on the push alone changes nothing for a commit that pre-commit already stops;
    // it only takes pre-push away from the change that had skipped the commit hook.
    let sp : PtivState = ptiv_t_flip(PTIV_F_SKIP_PUSH);
    assert ptiv_list_stop(sp, 0) == PTIV_L_PRECOMMIT;
    assert ptiv_list_stop(sp, 1) == PTIV_L_PRECOMMIT;
    assert ptiv_list_stop(sp, 2) == PTIV_L_CI;
    assert ptiv_list_stop(sp, 3) == PTIV_L_CI;
    assert ptiv_stopped_count(sp, PTIV_L_PRECOMMIT) == 3;
    assert ptiv_stopped_count(sp, PTIV_L_PREPUSH) == 0;
    assert ptiv_stopped_count(sp, PTIV_L_CI) == 3;
    // CI is the backstop: --no-verify never gets a change past it.
    assert ptiv_t_stop(0, PTIV_F_SKIP_COMMIT) != PTIV_L_NONE;
    assert ptiv_t_stop(3, PTIV_F_SKIP_PUSH) == PTIV_L_CI;
    // A change that reaches the remote with no local commit is seen by CI alone.
    let nl : PtivState = ptiv_t_flip(PTIV_F_NOT_LOCAL);
    assert ptiv_list_stop(nl, 0) == PTIV_L_CI;
    assert ptiv_list_stop(nl, 2) == PTIV_L_CI;
    assert ptiv_list_stop(nl, 4) == PTIV_L_CI;
    assert ptiv_list_stop(nl, 8) == PTIV_L_CI;
    assert ptiv_stopped_count(nl, PTIV_L_CI) == 6;
    assert ptiv_stopped_count(nl, PTIV_L_PRECOMMIT) == 0;
}

test a_content_flip_changes_what_the_config_matches_and_not_the_route {
    // The key name becomes a word outside the five the rule lists: the source's bytes say so.
    assert ptiv_t_direct("\"password\"", 10) == true;
    assert ptiv_t_direct("\"token\"", 7) == false;
    assert ptiv_t_is(0, PTIV_F_OTHER_WORD, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(2, PTIV_F_OTHER_WORD, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(8, PTIV_F_OTHER_WORD, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(5, PTIV_F_OTHER_WORD, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    // A provider-shaped change has no key name to rename.
    assert ptiv_t_is(1, PTIV_F_OTHER_WORD, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    // The literal becomes one character under the config's own minimum.
    assert ptiv_t_is(0, PTIV_F_SHORT, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(3, PTIV_F_SHORT, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(1, PTIV_F_SHORT, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    assert ptiv_change_under(0, PTIV_F_SHORT).width == ptiv_cfg_min_len() - 1;
    // The value becomes a reference.
    assert ptiv_t_is(0, PTIV_F_REFERENCE, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(8, PTIV_F_REFERENCE, PTIV_R_NONE, PTIV_X_NONE, PTIV_L_NONE);
    assert ptiv_t_is(4, PTIV_F_REFERENCE, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_CI);
    // The literal carries the word example: excused for the custom rule, not for the default rules.
    assert ptiv_t_is(0, PTIV_F_PLACEHOLDER, PTIV_R_PASSWORD, PTIV_X_PLACEHOLDER, PTIV_L_NONE);
    assert ptiv_t_is(8, PTIV_F_PLACEHOLDER, PTIV_R_PASSWORD, PTIV_X_PLACEHOLDER, PTIV_L_NONE);
    assert ptiv_t_is(1, PTIV_F_PLACEHOLDER, PTIV_R_DEFAULT, PTIV_X_NONE, PTIV_L_PRECOMMIT);
    assert ptiv_t_is(7, PTIV_F_PLACEHOLDER, PTIV_R_DEFAULT, PTIV_X_PATH, PTIV_L_NONE);
    // The list shows it: with the key name renamed, nothing is stopped by the custom rule any more.
    let p : PtivState = ptiv_t_flip(PTIV_F_OTHER_WORD);
    assert ptiv_stopped_count(p, PTIV_L_PRECOMMIT) == 1;
    assert ptiv_stopped_count(p, PTIV_L_PREPUSH) == 0;
    assert ptiv_stopped_count(p, PTIV_L_CI) == 1;
    assert ptiv_stopped_count(p, PTIV_L_NONE) == 10;
    assert ptiv_list_rule(p, 0) == PTIV_R_NONE;
    assert ptiv_list_rule(p, 1) == PTIV_R_DEFAULT;
}

test route_flips_only_move_the_layer_and_content_flips_only_remove_stops {
    var i : u32 = 0;
    while (i < PTIV_CHANGE_COUNT) {
        let base : PtivVerdict = ptiv_verdict(ptiv_change(i));
        var k : u32 = 1;
        while (k < PTIV_FLIPS) {
            let c : PtivChange = ptiv_change_under(i, k);
            let v : PtivVerdict = ptiv_verdict(c);
            if (k <= PTIV_F_NOT_LOCAL) {
                // A route flip: the config's answer is the same, the layer is the same or later.
                assert v.rule == base.rule;
                assert v.excuse == base.excuse;
                if (base.stop == PTIV_L_NONE) {
                    assert v.stop == PTIV_L_NONE;
                } else {
                    assert v.stop >= base.stop;
                    assert v.stop < PTIV_L_NONE;
                }
            } else {
                // A content flip: the route is the same, and a stop is kept or removed, never made.
                var l : u32 = 0;
                while (l < PTIV_LAYERS) {
                    assert ptiv_layer_runs(c, l) == ptiv_layer_runs(ptiv_change(i), l);
                    l = l + 1;
                }
                if (base.stop == PTIV_L_NONE) {
                    assert v.stop == PTIV_L_NONE;
                } else {
                    assert v.stop == base.stop or v.stop == PTIV_L_NONE;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    // The loop saw a stop kept and a stop removed.
    assert ptiv_t_stop(1, PTIV_F_OTHER_WORD) == PTIV_L_PRECOMMIT;
    assert ptiv_t_stop(0, PTIV_F_OTHER_WORD) == PTIV_L_NONE;
}

; ---------------------------------------------------------------- tests: truth

test an_untouched_petal_is_verified_and_the_badge_may_claim {
    let p : PtivState = ptiv_open();
    assert ptiv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert ptiv_badge_claims(p);
    assert ptiv_badge_rgb(p) == viz_truth_rgb(VIZ_TRUTH_VERIFIED);
    assert ptiv_badge_rgb(p) != viz_truth_rgb(VIZ_TRUTH_DEMO);
    // Looking is not leaving the data: hover, select, step and focus keep the claim.
    var q : PtivState = ptiv_apply(p, VIZ_EV_HOVER, ptiv_change_ref(1), 0);
    q = ptiv_t_select(q, 4);
    q = ptiv_apply(q, VIZ_EV_STEP_SET, 2, 0);
    q = ptiv_apply(q, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert ptiv_badge_claims(q);
    assert ptiv_truth_holds(q);
    // An unknown truth code reads as UNKNOWN, never as a claim.
    var u : PtivState = p;
    u.viz.truth = 77;
    assert ptiv_badge(u) == VIZ_TRUTH_UNKNOWN;
    assert ptiv_badge_claims(u) == false;
}

test leaving_the_data_shows_demo_and_returning_restores_the_claim {
    let open : PtivState = ptiv_open();
    var p : PtivState = ptiv_apply(open, VIZ_EV_PARAM_SET, 3, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_DEMO;
    assert ptiv_badge_claims(p) == false;
    assert p.loaded == VIZ_TRUTH_VERIFIED;
    assert ptiv_truth_holds(p);
    // Another flip is still a demo.
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_DEMO;
    assert p.viz.revision == open.viz.revision + 2;
    // A reload that finishes while a flip is on keeps the DEMO label.
    let again : PtivState = ptiv_t_reload(p, 12, VIZ_TRUTH_VERIFIED);
    assert again.viz.lifecycle == VIZ_LC_READY;
    assert again.viz.param == 5;
    assert again.loaded == VIZ_TRUTH_VERIFIED;
    assert ptiv_badge(again) == VIZ_TRUTH_DEMO;
    // Back to the recorded facts: VERIFIED again, and the state is the opened one.
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert ptiv_badge_claims(p);
    assert viz_same(p.viz, open.viz);
    assert p.viz.revision == open.viz.revision + 3;
}

test a_reload_keeps_cached_and_unknown_and_follows_live {
    var p : PtivState = ptiv_t_reload(ptiv_open(), 12, VIZ_TRUTH_CACHED);
    assert ptiv_badge(p) == VIZ_TRUTH_CACHED;
    assert p.loaded == VIZ_TRUTH_CACHED;
    assert ptiv_badge_claims(p) == false;
    // A flip on cached data stays cached: it never claimed a result to begin with.
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 3, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_CACHED;
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_CACHED;
    // A host that fed real changes to the gate would report LIVE itself; a flip still makes it a demo.
    p = ptiv_t_reload(p, 12, VIZ_TRUTH_LIVE);
    assert ptiv_badge(p) == VIZ_TRUTH_LIVE;
    assert ptiv_badge_claims(p);
    p = ptiv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert ptiv_badge(p) == VIZ_TRUTH_DEMO;
    // A truth code outside the table reloads as UNKNOWN and never claims.
    let odd : PtivState = ptiv_t_reload(ptiv_open(), 12, 77);
    assert ptiv_badge(odd) == VIZ_TRUTH_UNKNOWN;
    assert odd.loaded == VIZ_TRUTH_UNKNOWN;
    assert ptiv_badge_claims(odd) == false;
    assert ptiv_truth_holds(odd);
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_every_change_forward_and_back_and_wraps {
    var p : PtivState = ptiv_open();
    var i : u32 = 0;
    while (i < PTIV_CHANGE_COUNT) {
        p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == i;
        assert viz_is_focused(p.viz, i);
        assert ptiv_focus_ref(p, p.viz.focus) == ptiv_change_ref(i);
        i = i + 1;
    }
    // The thirteenth press wraps to the first change.
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    // Backward from nothing focused starts at the last change, walks down and wraps.
    var q : PtivState = ptiv_open();
    var j : u32 = PTIV_CHANGE_COUNT;
    while (j > 0) {
        q = ptiv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
        j = j - 1;
        assert q.viz.focus == j;
        assert ptiv_focus_ref(q, q.viz.focus) == ptiv_change_ref(j);
    }
    q = ptiv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == 11;
}

test activate_selects_the_focused_change_and_activating_again_clears_it {
    var p : PtivState = ptiv_open();
    // Nothing focused: activate is a no-op.
    assert viz_same(ptiv_activate(p).viz, p.viz);
    assert ptiv_activate(p).viz.revision == p.viz.revision;
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ptiv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ptiv_activate(p);
    assert p.viz.selected == ptiv_change_ref(2);
    assert ptiv_subject(p) == 2;
    assert ptiv_trace_state(p, 0) == PTIV_S_SKIPPED;
    p = ptiv_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    assert ptiv_subject(p) == PTIV_NO_CHANGE;
}

test reduced_motion_gives_zero_milliseconds {
    var p : PtivState = ptiv_open();
    assert viz_motion_ms(p.viz, 250) == 250;
    p = ptiv_apply(p, VIZ_EV_MOTION, 1, 0);
    assert p.viz.reduced_motion == 1;
    assert viz_motion_ms(p.viz, 250) == 0;
    assert viz_motion_ms(p.viz, 0) == 0;
    p = ptiv_apply(p, VIZ_EV_MOTION, 0, 0);
    assert viz_motion_ms(p.viz, 250) == 250;
    // The preference is not an interaction: it is honoured before the petal has loaded.
    let idle : PtivState = ptiv_apply(ptiv_idle(), VIZ_EV_MOTION, 1, 0);
    assert idle.viz.reduced_motion == 1;
    assert viz_motion_ms(idle.viz, 250) == 0;
}

; ---------------------------------------------------------------- tests: views against views

test the_views_read_one_state_and_agree {
    var p : PtivState = ptiv_t_select(ptiv_open(), 4);
    p = ptiv_apply(p, VIZ_EV_STEP_SET, 2, 0);
    // One selection lights one list line, and the trace describes that change.
    var i : u32 = 0;
    while (i < PTIV_CHANGE_COUNT) {
        if (i == 4) {
            assert ptiv_list_hl(p, i) == VIZ_HL_SELECT;
        } else {
            assert ptiv_list_hl(p, i) == VIZ_HL_NONE;
        }
        i = i + 1;
    }
    assert ptiv_subject(p) == 4;
    assert ptiv_list_stop(p, 4) == PTIV_L_CI;
    assert ptiv_trace_state(p, PTIV_L_CI) == PTIV_S_STOPPED;
    assert ptiv_trace_rule(p, PTIV_L_CI) == ptiv_list_rule(p, 4);
    assert ptiv_list_rule(p, 4) == PTIV_R_DEFAULT;
    // Hover another change: it takes the trace, the selection keeps its list line.
    p = ptiv_apply(p, VIZ_EV_HOVER, ptiv_change_ref(2), 0);
    assert ptiv_subject(p) == 2;
    assert ptiv_list_hl(p, 2) == VIZ_HL_HOVER;
    assert ptiv_list_hl(p, 4) == VIZ_HL_SELECT;
    assert ptiv_trace_state(p, PTIV_L_PREPUSH) == PTIV_S_STOPPED;
    assert ptiv_list_stop(p, 2) == PTIV_L_PREPUSH;
    // Leave: the selected change is the subject again. Back: nothing is.
    p = ptiv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert ptiv_subject(p) == 4;
    assert ptiv_trace_state(p, PTIV_L_CI) == PTIV_S_STOPPED;
    p = ptiv_apply(p, VIZ_EV_BACK, 0, 0);
    assert ptiv_subject(p) == PTIV_NO_CHANGE;
    assert ptiv_list_hl(p, 4) == VIZ_HL_NONE;
    assert ptiv_trace_shown(p) == 0;
}

test list_and_trace_agree_for_every_change_and_every_flip {
    var k : u32 = 0;
    while (k < PTIV_FLIPS) {
        var i : u32 = 0;
        while (i < PTIV_CHANGE_COUNT) {
            var p : PtivState = ptiv_t_select(ptiv_t_flip(k), i);
            p = ptiv_apply(p, VIZ_EV_STEP_SET, 2, 0);
            var stopped : u32 = 0;
            var at : u32 = PTIV_L_NONE;
            var l : u32 = 0;
            while (l < PTIV_LAYERS) {
                if (ptiv_trace_state(p, l) == PTIV_S_STOPPED) {
                    stopped = stopped + 1;
                    at = l;
                }
                l = l + 1;
            }
            // At most one layer stops a change, and it is the layer the list names.
            assert stopped <= 1;
            assert at == ptiv_list_stop(p, i);
            if (at == PTIV_L_NONE) {
                assert ptiv_list_rule(p, i) == PTIV_R_NONE;
            } else {
                assert ptiv_trace_rule(p, at) == ptiv_list_rule(p, i);
                assert ptiv_list_rule(p, i) != PTIV_R_NONE;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

test the_stop_counts_add_up_to_the_rows_under_every_flip {
    var k : u32 = 0;
    while (k < PTIV_FLIPS) {
        let p : PtivState = ptiv_t_flip(k);
        let total : u32 = ptiv_stopped_count(p, PTIV_L_PRECOMMIT) + ptiv_stopped_count(p, PTIV_L_PREPUSH) + ptiv_stopped_count(p, PTIV_L_CI) + ptiv_stopped_count(p, PTIV_L_NONE);
        assert total == ptiv_rows(p);
        assert total == 12;
        assert ptiv_stopped_count(p, PTIV_NO_VALUE) == 0;
        k = k + 1;
    }
}

; ---------------------------------------------------------------- tests: host and plan

test the_host_validates_and_places_each_view_in_its_slot {
    let h : VizHost = ptiv_host();
    assert h.count == 3;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_LIST;
    assert h.rep[2] == VIZ_REP_TRACE;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[2] == VH_ROOT;
    // The slot rects are the layout constants: twelve list lines, three trace lines.
    assert h.x[1] == PTIV_LIST_X;
    assert h.y[1] == PTIV_LIST_Y;
    assert h.w[1] == PTIV_LIST_W;
    assert h.h[1] == 264;
    assert h.h[2] == 66;
    // A point in each slot lands in that slot; gaps and the outside are nothing.
    assert vh_hit(h, 30, 20) == PTIV_SLOT_BADGE;
    assert vh_hit(h, 40, 100) == PTIV_SLOT_LIST;
    assert vh_hit(h, 500, 100) == PTIV_SLOT_TRACE;
    assert vh_hit(h, 470, 100) == VH_NONE;
    assert vh_hit(h, 40, 324) == VH_NONE;
    assert vh_hit(h, 500, 126) == VH_NONE;
    assert vh_hit(h, 5, 5) == VH_NONE;
}

test a_list_hit_agrees_with_the_host_hit {
    let p : PtivState = ptiv_open();
    let h : VizHost = ptiv_host();
    var i : u32 = 0;
    while (i < PTIV_CHANGE_COUNT) {
        let py : u32 = PTIV_LIST_Y + i * PTIV_LINE_H + 3;
        assert ptiv_list_hit(p, 30, py) == ptiv_change_ref(i);
        assert vh_hit(h, 30, py) == PTIV_SLOT_LIST;
        i = i + 1;
    }
    // The edges of the list: one line past the twelfth, left of it and right of it are nothing.
    assert ptiv_list_hit(p, 30, 324) == VIZ_REF_NONE;
    assert ptiv_list_hit(p, 30, 59) == VIZ_REF_NONE;
    assert ptiv_list_hit(p, 19, 70) == VIZ_REF_NONE;
    assert ptiv_list_hit(p, 460, 70) == VIZ_REF_NONE;
    assert vh_hit(h, 19, 70) == VH_NONE;
    assert vh_hit(h, 460, 70) == VH_NONE;
    // The badge is a slot of the host but not a list line.
    assert ptiv_list_hit(p, 30, 20) == VIZ_REF_NONE;
    assert vh_hit(h, 30, 20) == PTIV_SLOT_BADGE;
    // A click on a line goes through the one reducer and selects that change.
    let q : PtivState = ptiv_apply(p, VIZ_EV_SELECT, ptiv_list_hit(p, 30, 60 + 3 * 22 + 5), 0);
    assert q.viz.selected == ptiv_change_ref(3);
    assert ptiv_trace_state(q, 0) == PTIV_S_SKIPPED;
}

test the_petal_embeds_in_the_contract_host {
    var outer : VizHost = vh_blank();
    outer = vh_add(outer, VIZ_REP_TEXT, VH_ROOT, 0, 0, 1400, 400);
    let e : VizHost = vh_embed(outer, ptiv_host(), 0, 10, 10);
    assert e.count == 4;
    assert vh_validate(e) == VH_OK;
    assert e.rep[1] == VIZ_REP_BADGE;
    assert e.rep[2] == VIZ_REP_LIST;
    assert e.rep[3] == VIZ_REP_TRACE;
    assert e.parent[1] == 0;
    assert e.parent[3] == 0;
    // The petal moved by the slot offset and nothing else.
    assert vh_depth(e, 2) == 2;
    assert vh_abs_x(e, 2) == 30;
    assert vh_abs_y(e, 2) == 70;
    assert vh_hit(e, 40, 80) == 2;
    assert vh_hit(e, 1300, 390) == 0;
    assert vh_hit(e, 1500, 100) == VH_NONE;
    // The list hit test, shifted by the same offset, names the same change.
    let p : PtivState = ptiv_open();
    assert ptiv_list_hit(p, 40 - 10, 80 + 22 - 10) == ptiv_change_ref(1);
    assert vh_hit(e, 40, 80 + 22) == 2;
    // The embedded host still holds exactly the petal's reps plus the frame's text.
    assert psv_host_reps(e) == ptiv_reps() + viz_rep_bit(VIZ_REP_TEXT);
}

test the_plan_row_for_security_matches_this_petal {
    assert PTIV_PETAL == 26;
    assert pvp_reps(PTIV_PETAL) == 276;
    assert ptiv_reps() == 276;
    assert ptiv_reps() == pvp_reps(PTIV_PETAL);
    // 276 = list 4 + trace 16 + badge 256.
    assert ptiv_reps() == 4 + 16 + 256;
    assert psv_host_reps(ptiv_host()) == ptiv_reps();
    assert viz_plan_ok(ptiv_reps());
    assert viz_plan_ok(pvp_reps(PTIV_PETAL));
    assert viz_is_linked(ptiv_reps());
    assert viz_view_count(ptiv_reps()) == 2;
    // The truth the plan promises for this row is the truth the opened petal shows.
    assert pvp_truth(PTIV_PETAL) == ptiv_badge(ptiv_open());
    assert pvp_truth(PTIV_PETAL) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- invariant

invariant the_layout_and_the_tables_fit_their_frames {
    assert PTIV_LIST_X + PTIV_LIST_W <= PTIV_TRACE_X;
    assert PTIV_BADGE_Y + PTIV_BADGE_H <= PTIV_LIST_Y;
    assert PTIV_LIST_Y == PTIV_TRACE_Y;
    assert PTIV_CHANGE_COUNT <= 16;
    assert PTIV_CHANGE_COUNT * PTIV_LINE_H == 264;
    assert PTIV_LAYERS == 3;
    assert PTIV_FLIPS == 9;
    assert PTIV_L_NONE == PTIV_LAYERS;
    assert PTIV_KW_OTHER + 1 == PTIV_KW_COUNT;
    assert PTIV_PH_SAMPLE + 1 == PTIV_PH_COUNT;
    assert PTIV_F_PLACEHOLDER + 1 == PTIV_FLIPS;
}
