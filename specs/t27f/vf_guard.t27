// SPDX-License-Identifier: Apache-2.0
; T27F-007 ring 10 agent guard: vf_guard classifies a spec path into a layer and decides whether a role may write it
; Refs gHashTag/t27#13214
; Architecture: object graph -> meaning -> layout -> theme -> render. An agent writes only the first two layers;
; layout, theme and render belong to the engine, so an agent cannot lie with layout.
; Two more layers sit outside that one-way flow and belong to the owner alone, for agent AND engine:
;   contract = the schema, validator and version (visual_factory_contract), so nobody can weaken vf_validate by editing the contract
;   check    = the policy and the cross-layer checks (vf_guard itself, vf_ring1, vf_brand), so nobody can weaken the guard or a check
; Every vf_* / ui_kit / outfit_* spec is listed by name below; a spec not listed is GL_OTHER and writable by the owner only
; This module is the policy as data plus tests. Wiring it into a hook is a separate step and is NOT done here.
; Match is on the full repo-relative path string, exact; a path outside the table is GL_OTHER.
; Limits: no globbing, no directory rules, no symlink handling; the table lists every guarded path by name

module t27f_vf_guard;

pub const GL_GRAPH : u32 = 0;
pub const GL_MEANING : u32 = 1;
pub const GL_LAYOUT : u32 = 2;
pub const GL_THEME : u32 = 3;
pub const GL_RENDER : u32 = 4;
pub const GL_OTHER : u32 = 5;
pub const GL_CONTRACT : u32 = 6;
pub const GL_CHECK : u32 = 7;
pub const GD_LAYERS : u32 = 8;

pub const GR_AGENT : u32 = 0;
pub const GR_ENGINE : u32 = 1;
pub const GR_OWNER : u32 = 2;
pub const GD_ROLES : u32 = 3;

pub const GD_LAYER_NAMES : [8]str = ["graph", "meaning", "layout", "theme", "render", "other", "contract", "check"];

; GD_PATH_LAYER is a table of integer literals: 0 graph, 1 meaning, 2 layout, 3 theme, 4 render, 6 contract, 7 check
; row by row it is: contract 6, guard 7, ring1 7, task_card 0, ui_kit 0, meaning 1, snapshot 1, layout 2, extent 2,
; theme 3, outfit_r 3, outfit_b 3, outfit_atlas 3, brand 7, pixel 4, render 4, scale 4, type 4, card 4, diff 4,
; storybook 4, t27os frame_main 4, t27os type_main 4
pub const GD_PATH_COUNT : u32 = 23;
pub const GD_PATHS : [23]str = [
    "specs/t27f/visual_factory_contract.t27",
    "specs/t27f/vf_guard.t27",
    "specs/t27f/vf_ring1.t27",
    "specs/t27f/stories/task_card.t27",
    "specs/t27f/ui_kit.t27",
    "specs/t27f/vf_meaning.t27",
    "specs/t27f/vf_snapshot.t27",
    "specs/t27f/vf_layout.t27",
    "specs/t27f/vf_extent.t27",
    "specs/t27f/vf_theme.t27",
    "specs/t27f/outfit_r_data.t27",
    "specs/t27f/outfit_b_data.t27",
    "specs/t27f/outfit_atlas.t27",
    "specs/t27f/vf_brand.t27",
    "specs/t27f/vf_pixel.t27",
    "specs/t27f/vf_render.t27",
    "specs/t27f/vf_scale.t27",
    "specs/t27f/vf_type.t27",
    "specs/t27f/vf_card.t27",
    "specs/t27f/vf_diff.t27",
    "specs/t27f/vf_storybook.t27",
    "specs/t27os/vf_frame_main.t27",
    "specs/t27os/vf_type_main.t27",
];
pub const GD_PATH_LAYER : [23]u32 = [6, 7, 7, 0, 0, 1, 1, 2, 2, 3, 3, 3, 3, 7, 4, 4, 4, 4, 4, 4, 4, 4, 4];

; layer of a path: the first table row that equals it, GL_OTHER when none does
pub fn gd_layer_of(path: str) -> u32 {
    let p : str = path;
    var i : u32 = 0;
    while i < GD_PATH_COUNT {
        let cand : str = GD_PATHS[i];
        let hit : bool = p == cand;
        if hit == true {
            return GD_PATH_LAYER[i];
        }
        i = i + 1;
    }
    return GL_OTHER;
}

; the role-by-layer matrix; a role or layer out of range is refused before anything else
; the owner writes every layer; other and contract and check are owner-only; the engine writes graph..render; an agent writes graph and meaning
pub fn gd_allows(role: u32, layer: u32) -> bool {
    if role >= GD_ROLES {
        return false;
    }
    if layer >= GD_LAYERS {
        return false;
    }
    if role == GR_OWNER {
        return true;
    }
    if layer == GL_OTHER {
        return false;
    }
    if layer == GL_CONTRACT {
        return false;
    }
    if layer == GL_CHECK {
        return false;
    }
    if role == GR_ENGINE {
        return true;
    }
    if layer == GL_GRAPH {
        return true;
    }
    if layer == GL_MEANING {
        return true;
    }
    return false;
}

pub fn gd_may_write(role: u32, path: str) -> bool {
    let layer : u32 = gd_layer_of(path);
    let ok : bool = gd_allows(role, layer);
    return ok;
}

pub fn gd_layer_name(layer: u32) -> str {
    if layer >= GD_LAYERS {
        return GD_LAYER_NAMES[GL_OTHER];
    }
    return GD_LAYER_NAMES[layer];
}

; how many table rows sit in a layer; the layer counts add up to GD_PATH_COUNT
pub fn gd_layer_count(layer: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < GD_PATH_COUNT {
        if GD_PATH_LAYER[i] == layer {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; how many of four paths the role may NOT write
pub fn gd_violation_count(role: u32, p0: str, p1: str, p2: str, p3: str) -> u32 {
    var bad : u32 = 0;
    let ok0 : bool = gd_may_write(role, p0);
    if ok0 == false {
        bad = bad + 1;
    }
    let ok1 : bool = gd_may_write(role, p1);
    if ok1 == false {
        bad = bad + 1;
    }
    let ok2 : bool = gd_may_write(role, p2);
    if ok2 == false {
        bad = bad + 1;
    }
    let ok3 : bool = gd_may_write(role, p3);
    if ok3 == false {
        bad = bad + 1;
    }
    return bad;
}

; data flows graph -> render and never back: layer a may read layer b only when b is not later than a
; the contract is readable from every layer and reads nothing else; a check layer reads every known layer and no layer reads a check; other reads and is read by nothing
pub fn gd_order_ok(a: u32, b: u32) -> bool {
    if a >= GD_LAYERS {
        return false;
    }
    if b >= GD_LAYERS {
        return false;
    }
    if a == GL_OTHER {
        return false;
    }
    if b == GL_OTHER {
        return false;
    }
    if a == GL_CHECK {
        return true;
    }
    if b == GL_CHECK {
        return false;
    }
    if a == GL_CONTRACT {
        if b == GL_CONTRACT {
            return true;
        }
        return false;
    }
    if b == GL_CONTRACT {
        return true;
    }
    if b <= a {
        return true;
    }
    return false;
}

test layer_of_table {
    assert gd_layer_of("specs/t27f/visual_factory_contract.t27") == 6;
    assert gd_layer_of("specs/t27f/stories/task_card.t27") == 0;
    assert gd_layer_of("specs/t27f/vf_meaning.t27") == 1;
    assert gd_layer_of("specs/t27f/vf_snapshot.t27") == 1;
    assert gd_layer_of("specs/t27f/vf_layout.t27") == 2;
    assert gd_layer_of("specs/t27f/vf_extent.t27") == 2;
    assert gd_layer_of("specs/t27f/vf_theme.t27") == 3;
    assert gd_layer_of("specs/t27f/outfit_r_data.t27") == 3;
    assert gd_layer_of("specs/t27f/outfit_b_data.t27") == 3;
    assert gd_layer_of("specs/t27f/vf_pixel.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_render.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_scale.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_type.t27") == 4;
    assert gd_layer_of("specs/t27os/vf_frame_main.t27") == 4;
    assert gd_layer_of("specs/t27f/unknown.t27") == 5;
    assert gd_layer_of("") == 5;
}

test layer_of_exact_match_only {
    assert gd_layer_of("vf_layout.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_layout.t27x") == 5;
    assert gd_layer_of("specs/t27f/stories/other.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_frame_main.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_layout.t27") != 5;
}

test new_specs_have_their_layer {
    assert gd_layer_of("specs/t27f/ui_kit.t27") == GL_GRAPH;
    assert gd_layer_of("specs/t27f/outfit_atlas.t27") == GL_THEME;
    assert gd_layer_of("specs/t27f/vf_card.t27") == GL_RENDER;
    assert gd_layer_of("specs/t27f/vf_diff.t27") == GL_RENDER;
    assert gd_layer_of("specs/t27f/vf_storybook.t27") == GL_RENDER;
    assert gd_layer_of("specs/t27os/vf_type_main.t27") == GL_RENDER;
    assert gd_layer_of("specs/t27f/vf_brand.t27") == GL_CHECK;
    assert gd_layer_of("specs/t27f/vf_guard.t27") == GL_CHECK;
    assert gd_layer_of("specs/t27f/vf_ring1.t27") == GL_CHECK;
    assert gd_layer_of("specs/t27f/visual_factory_contract.t27") == GL_CONTRACT;
}

test every_listed_spec_resolves_to_a_layer {
    var i : u32 = 0;
    while i < GD_PATH_COUNT {
        let p : str = GD_PATHS[i];
        let layer : u32 = gd_layer_of(p);
        assert layer == GD_PATH_LAYER[i];
        assert layer != GL_OTHER;
        assert layer < GD_LAYERS;
        i = i + 1;
    }
    assert gd_layer_count(GL_GRAPH) == 2;
    assert gd_layer_count(GL_MEANING) == 2;
    assert gd_layer_count(GL_LAYOUT) == 2;
    assert gd_layer_count(GL_THEME) == 4;
    assert gd_layer_count(GL_RENDER) == 9;
    assert gd_layer_count(GL_OTHER) == 0;
    assert gd_layer_count(GL_CONTRACT) == 1;
    assert gd_layer_count(GL_CHECK) == 3;
    var total : u32 = 0;
    var k : u32 = 0;
    while k < GD_LAYERS {
        total = total + gd_layer_count(k);
        k = k + 1;
    }
    assert total == GD_PATH_COUNT;
}

test contract_is_owner_only {
    assert gd_layer_of("specs/t27f/visual_factory_contract.t27") == GL_CONTRACT;
    assert gd_may_write(GR_AGENT, "specs/t27f/visual_factory_contract.t27") == false;
    assert gd_may_write(GR_ENGINE, "specs/t27f/visual_factory_contract.t27") == false;
    assert gd_may_write(GR_OWNER, "specs/t27f/visual_factory_contract.t27");
    assert gd_may_write(GR_AGENT, "specs/t27f/vf_guard.t27") == false;
    assert gd_may_write(GR_ENGINE, "specs/t27f/vf_guard.t27") == false;
    assert gd_may_write(GR_AGENT, "specs/t27f/vf_ring1.t27") == false;
    assert gd_may_write(GR_ENGINE, "specs/t27f/vf_ring1.t27") == false;
    assert gd_may_write(GR_OWNER, "specs/t27f/vf_guard.t27");
    assert gd_may_write(GR_OWNER, "specs/t27f/vf_ring1.t27");
    // negative control: the same agent role may still write a graph-layer and a meaning-layer file
    assert gd_may_write(GR_AGENT, "specs/t27f/stories/task_card.t27");
    assert gd_may_write(GR_AGENT, "specs/t27f/ui_kit.t27");
    assert gd_may_write(GR_AGENT, "specs/t27f/vf_meaning.t27");
    // and the engine may still write a render-layer file
    assert gd_may_write(GR_ENGINE, "specs/t27f/vf_card.t27");
}

test agent_scope {
    assert gd_may_write(0, "specs/t27f/visual_factory_contract.t27") == false;
    assert gd_may_write(0, "specs/t27f/stories/task_card.t27");
    assert gd_may_write(0, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(0, "specs/t27f/vf_layout.t27") == false;
    assert gd_may_write(0, "specs/t27f/vf_theme.t27") == false;
    assert gd_may_write(0, "specs/t27f/vf_render.t27") == false;
    assert gd_may_write(0, "specs/t27os/vf_frame_main.t27") == false;
    assert gd_may_write(0, "specs/t27f/unknown.t27") == false;
}

test engine_scope {
    assert gd_may_write(1, "specs/t27f/vf_layout.t27");
    assert gd_may_write(1, "specs/t27f/vf_theme.t27");
    assert gd_may_write(1, "specs/t27f/vf_scale.t27");
    assert gd_may_write(1, "specs/t27f/visual_factory_contract.t27") == false;
    assert gd_may_write(1, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(1, "specs/t27f/unknown.t27") == false;
}

test owner_scope {
    assert gd_may_write(2, "specs/t27f/visual_factory_contract.t27");
    assert gd_may_write(2, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(2, "specs/t27f/vf_layout.t27");
    assert gd_may_write(2, "specs/t27f/vf_theme.t27");
    assert gd_may_write(2, "specs/t27f/vf_render.t27");
    assert gd_may_write(2, "specs/t27os/vf_frame_main.t27");
    assert gd_may_write(2, "specs/t27f/unknown.t27");
}

test violations {
    let agent_bad : u32 = gd_violation_count(0, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    let engine_bad : u32 = gd_violation_count(1, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    let owner_bad : u32 = gd_violation_count(2, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    assert agent_bad == 4;
    assert engine_bad == 2;
    assert owner_bad == 0;
    assert agent_bad != engine_bad;
}

test order {
    assert gd_order_ok(4, 2);
    assert gd_order_ok(2, 4) == false;
    assert gd_order_ok(0, 0);
    assert gd_order_ok(0, 1) == false;
    assert gd_order_ok(5, 0) == false;
    assert gd_order_ok(0, 5) == false;
    assert gd_order_ok(4, 3);
    assert gd_order_ok(3, 2);
}

test order_with_contract_and_check {
    // every pipeline layer may read the contract; the contract reads nothing downstream
    assert gd_order_ok(GL_GRAPH, GL_CONTRACT);
    assert gd_order_ok(GL_LAYOUT, GL_CONTRACT);
    assert gd_order_ok(GL_RENDER, GL_CONTRACT);
    assert gd_order_ok(GL_CONTRACT, GL_CONTRACT);
    assert gd_order_ok(GL_CONTRACT, GL_GRAPH) == false;
    assert gd_order_ok(GL_CONTRACT, GL_RENDER) == false;
    // a check reads every known layer, nothing in the pipeline or the contract reads a check
    assert gd_order_ok(GL_CHECK, GL_GRAPH);
    assert gd_order_ok(GL_CHECK, GL_RENDER);
    assert gd_order_ok(GL_CHECK, GL_CONTRACT);
    assert gd_order_ok(GL_CHECK, GL_CHECK);
    assert gd_order_ok(GL_RENDER, GL_CHECK) == false;
    assert gd_order_ok(GL_CONTRACT, GL_CHECK) == false;
    // other and out-of-range ids are refused both ways
    assert gd_order_ok(GL_CHECK, GL_OTHER) == false;
    assert gd_order_ok(GL_OTHER, GL_CONTRACT) == false;
    assert gd_order_ok(GL_CONTRACT, GL_OTHER) == false;
    assert gd_order_ok(8, 0) == false;
    assert gd_order_ok(0, 8) == false;
}

test names {
    let n0 : str = gd_layer_name(0);
    let n1 : str = gd_layer_name(1);
    let n2 : str = gd_layer_name(2);
    let n3 : str = gd_layer_name(3);
    let n4 : str = gd_layer_name(4);
    let n5 : str = gd_layer_name(5);
    let n6 : str = gd_layer_name(6);
    let n7 : str = gd_layer_name(7);
    let n9 : str = gd_layer_name(9);
    assert n0 == "graph";
    assert n1 == "meaning";
    assert n2 == "layout";
    assert n3 == "theme";
    assert n4 == "render";
    assert n5 == "other";
    assert n6 == "contract";
    assert n7 == "check";
    assert n9 == "other";
    let wrong : bool = n2 == "theme";
    assert wrong == false;
}

test out_of_range_is_refused {
    assert gd_allows(9, 0) == false;
    assert gd_allows(0, 9) == false;
    assert gd_allows(3, 0) == false;
    assert gd_allows(2, 8) == false;
    assert gd_may_write(9, "specs/t27f/vf_meaning.t27") == false;
}

test matrix {
    assert gd_allows(0, 0);
    assert gd_allows(0, 1);
    assert gd_allows(0, 2) == false;
    assert gd_allows(0, 3) == false;
    assert gd_allows(0, 4) == false;
    assert gd_allows(0, 5) == false;
    assert gd_allows(0, 6) == false;
    assert gd_allows(0, 7) == false;
    assert gd_allows(1, 0);
    assert gd_allows(1, 1);
    assert gd_allows(1, 2);
    assert gd_allows(1, 3);
    assert gd_allows(1, 4);
    assert gd_allows(1, 5) == false;
    assert gd_allows(1, 6) == false;
    assert gd_allows(1, 7) == false;
    assert gd_allows(2, 0);
    assert gd_allows(2, 1);
    assert gd_allows(2, 2);
    assert gd_allows(2, 3);
    assert gd_allows(2, 4);
    assert gd_allows(2, 5);
    assert gd_allows(2, 6);
    assert gd_allows(2, 7);
}
