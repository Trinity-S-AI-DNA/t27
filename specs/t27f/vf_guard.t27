// SPDX-License-Identifier: Apache-2.0
; T27F-007 ring 10 agent guard: vf_guard classifies a spec path into a layer and decides whether a role may write it
; Refs gHashTag/t27#13214
; Architecture: object graph -> meaning -> layout -> theme -> render. An agent writes only the first two layers;
; layout, theme and render belong to the engine, so an agent cannot lie with layout.
; This module is the policy as data plus tests. Wiring it into a hook is a separate step and is NOT done here.
; Match is on the full repo-relative path string, exact; a path outside the table is GL_OTHER.
; Limits: no globbing, no directory rules, no symlink handling; the table lists every guarded path by name

module t27f_vf_guard;

pub const GL_GRAPH : u32 = 0;
pub const GL_MEANING : u32 = 1;
pub const GL_LAYOUT : u32 = 2;
pub const GL_THEME : u32 = 3;
pub const GL_RENDER : u32 = 4;
pub const GL_OTHER : u32 = 5;
pub const GD_LAYERS : u32 = 6;

pub const GR_AGENT : u32 = 0;
pub const GR_ENGINE : u32 = 1;
pub const GR_OWNER : u32 = 2;
pub const GD_ROLES : u32 = 3;

pub const GD_LAYER_NAMES : [6]str = ["graph", "meaning", "layout", "theme", "render", "other"];

pub const GD_PATH_COUNT : u32 = 14;
pub const GD_PATHS : [14]str = [
    "specs/t27f/visual_factory_contract.t27",
    "specs/t27f/stories/task_card.t27",
    "specs/t27f/vf_meaning.t27",
    "specs/t27f/vf_snapshot.t27",
    "specs/t27f/vf_layout.t27",
    "specs/t27f/vf_extent.t27",
    "specs/t27f/vf_theme.t27",
    "specs/t27f/outfit_r_data.t27",
    "specs/t27f/outfit_b_data.t27",
    "specs/t27f/vf_pixel.t27",
    "specs/t27f/vf_render.t27",
    "specs/t27f/vf_scale.t27",
    "specs/t27f/vf_type.t27",
    "specs/t27os/vf_frame_main.t27",
];
pub const GD_PATH_LAYER : [14]u32 = [0, 0, 1, 1, 2, 2, 3, 3, 3, 4, 4, 4, 4, 4];

; layer of a path: the first table row that equals it, GL_OTHER when none does
pub fn gd_layer_of(path: str) -> u32 {
    let p : str = path;
    var i : u32 = 0;
    while i < GD_PATH_COUNT {
        let cand : str = GD_PATHS[i];
        let hit : bool = p == cand;
        if hit == true {
            return GD_PATH_LAYER[i];
        }
        i = i + 1;
    }
    return GL_OTHER;
}

; the role-by-layer matrix; a role or layer out of range is refused before anything else
pub fn gd_allows(role: u32, layer: u32) -> bool {
    if role >= GD_ROLES {
        return false;
    }
    if layer >= GD_LAYERS {
        return false;
    }
    if role == GR_OWNER {
        return true;
    }
    if layer == GL_OTHER {
        return false;
    }
    if role == GR_ENGINE {
        return true;
    }
    if layer == GL_GRAPH {
        return true;
    }
    if layer == GL_MEANING {
        return true;
    }
    return false;
}

pub fn gd_may_write(role: u32, path: str) -> bool {
    let layer : u32 = gd_layer_of(path);
    let ok : bool = gd_allows(role, layer);
    return ok;
}

pub fn gd_layer_name(layer: u32) -> str {
    if layer >= GD_LAYERS {
        return GD_LAYER_NAMES[GL_OTHER];
    }
    return GD_LAYER_NAMES[layer];
}

; how many of four paths the role may NOT write
pub fn gd_violation_count(role: u32, p0: str, p1: str, p2: str, p3: str) -> u32 {
    var bad : u32 = 0;
    let ok0 : bool = gd_may_write(role, p0);
    if ok0 == false {
        bad = bad + 1;
    }
    let ok1 : bool = gd_may_write(role, p1);
    if ok1 == false {
        bad = bad + 1;
    }
    let ok2 : bool = gd_may_write(role, p2);
    if ok2 == false {
        bad = bad + 1;
    }
    let ok3 : bool = gd_may_write(role, p3);
    if ok3 == false {
        bad = bad + 1;
    }
    return bad;
}

; data flows graph -> render and never back: layer a may read layer b only when b is not later than a
pub fn gd_order_ok(a: u32, b: u32) -> bool {
    if a >= GL_OTHER {
        return false;
    }
    if b >= GL_OTHER {
        return false;
    }
    if b <= a {
        return true;
    }
    return false;
}

test layer_of_table {
    assert gd_layer_of("specs/t27f/visual_factory_contract.t27") == 0;
    assert gd_layer_of("specs/t27f/stories/task_card.t27") == 0;
    assert gd_layer_of("specs/t27f/vf_meaning.t27") == 1;
    assert gd_layer_of("specs/t27f/vf_snapshot.t27") == 1;
    assert gd_layer_of("specs/t27f/vf_layout.t27") == 2;
    assert gd_layer_of("specs/t27f/vf_extent.t27") == 2;
    assert gd_layer_of("specs/t27f/vf_theme.t27") == 3;
    assert gd_layer_of("specs/t27f/outfit_r_data.t27") == 3;
    assert gd_layer_of("specs/t27f/outfit_b_data.t27") == 3;
    assert gd_layer_of("specs/t27f/vf_pixel.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_render.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_scale.t27") == 4;
    assert gd_layer_of("specs/t27f/vf_type.t27") == 4;
    assert gd_layer_of("specs/t27os/vf_frame_main.t27") == 4;
    assert gd_layer_of("specs/t27f/unknown.t27") == 5;
    assert gd_layer_of("") == 5;
}

test layer_of_exact_match_only {
    assert gd_layer_of("vf_layout.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_layout.t27x") == 5;
    assert gd_layer_of("specs/t27f/stories/other.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_frame_main.t27") == 5;
    assert gd_layer_of("specs/t27f/vf_layout.t27") != 5;
}

test agent_scope {
    assert gd_may_write(0, "specs/t27f/visual_factory_contract.t27");
    assert gd_may_write(0, "specs/t27f/stories/task_card.t27");
    assert gd_may_write(0, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(0, "specs/t27f/vf_layout.t27") == false;
    assert gd_may_write(0, "specs/t27f/vf_theme.t27") == false;
    assert gd_may_write(0, "specs/t27f/vf_render.t27") == false;
    assert gd_may_write(0, "specs/t27os/vf_frame_main.t27") == false;
    assert gd_may_write(0, "specs/t27f/unknown.t27") == false;
}

test engine_scope {
    assert gd_may_write(1, "specs/t27f/vf_layout.t27");
    assert gd_may_write(1, "specs/t27f/vf_theme.t27");
    assert gd_may_write(1, "specs/t27f/vf_scale.t27");
    assert gd_may_write(1, "specs/t27f/visual_factory_contract.t27");
    assert gd_may_write(1, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(1, "specs/t27f/unknown.t27") == false;
}

test owner_scope {
    assert gd_may_write(2, "specs/t27f/visual_factory_contract.t27");
    assert gd_may_write(2, "specs/t27f/vf_meaning.t27");
    assert gd_may_write(2, "specs/t27f/vf_layout.t27");
    assert gd_may_write(2, "specs/t27f/vf_theme.t27");
    assert gd_may_write(2, "specs/t27f/vf_render.t27");
    assert gd_may_write(2, "specs/t27os/vf_frame_main.t27");
    assert gd_may_write(2, "specs/t27f/unknown.t27");
}

test violations {
    let agent_bad : u32 = gd_violation_count(0, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    let engine_bad : u32 = gd_violation_count(1, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    let owner_bad : u32 = gd_violation_count(2, "specs/t27f/visual_factory_contract.t27", "specs/t27f/vf_layout.t27", "specs/t27f/vf_theme.t27", "specs/t27f/unknown.t27");
    assert agent_bad == 3;
    assert engine_bad == 1;
    assert owner_bad == 0;
    assert agent_bad != engine_bad;
}

test order {
    assert gd_order_ok(4, 2);
    assert gd_order_ok(2, 4) == false;
    assert gd_order_ok(0, 0);
    assert gd_order_ok(0, 1) == false;
    assert gd_order_ok(5, 0) == false;
    assert gd_order_ok(0, 5) == false;
    assert gd_order_ok(4, 3);
    assert gd_order_ok(3, 2);
}

test names {
    let n0 : str = gd_layer_name(0);
    let n1 : str = gd_layer_name(1);
    let n2 : str = gd_layer_name(2);
    let n3 : str = gd_layer_name(3);
    let n4 : str = gd_layer_name(4);
    let n5 : str = gd_layer_name(5);
    let n9 : str = gd_layer_name(9);
    assert n0 == "graph";
    assert n1 == "meaning";
    assert n2 == "layout";
    assert n3 == "theme";
    assert n4 == "render";
    assert n5 == "other";
    assert n9 == "other";
    let wrong : bool = n2 == "theme";
    assert wrong == false;
}

test out_of_range_is_refused {
    assert gd_allows(9, 0) == false;
    assert gd_allows(0, 9) == false;
    assert gd_allows(3, 0) == false;
    assert gd_allows(2, 6) == false;
    assert gd_may_write(9, "specs/t27f/vf_meaning.t27") == false;
}

test matrix {
    assert gd_allows(0, 0);
    assert gd_allows(0, 1);
    assert gd_allows(0, 2) == false;
    assert gd_allows(0, 3) == false;
    assert gd_allows(0, 4) == false;
    assert gd_allows(0, 5) == false;
    assert gd_allows(1, 0);
    assert gd_allows(1, 1);
    assert gd_allows(1, 2);
    assert gd_allows(1, 3);
    assert gd_allows(1, 4);
    assert gd_allows(1, 5) == false;
    assert gd_allows(2, 0);
    assert gd_allows(2, 1);
    assert gd_allows(2, 2);
    assert gd_allows(2, 3);
    assert gd_allows(2, 4);
    assert gd_allows(2, 5);
}
