// SPDX-License-Identifier: Apache-2.0
; T27F-005 visual gap: vf_render paints the merged vf_layout rectangles of a visual-factory graph into an RGB buffer and a P6 PPM
; Refs gHashTag/t27#13214, epic #13214
; The first viewable frame of the task card as bytes: flat fills from vf_pixel, a 1-pixel outline, labels from the frame_render 5x7 font
; It writes no file: a host program saves the bytes, and the tests here prove the bytes
; Reads VfGraph, VfLayout, vf_pixel and frame_render, edits none of them
; Limits: no antialiasing, no scaling, no input values, no card text, one flat fill per kind, topmost means highest node index
; Labels are white: every labelled fill (text 0x222222, badge 0x2E7D32, button 0x1565C0) is dark, and a dark label on the text fill would be invisible
; It is NOT a human-eye proof: tests pin pixel bytes, and nobody has opened the frame yet
; All arithmetic is u32 and non-negative: compare before subtracting; i32 appears only at the draw_text call

module t27f_vf_render;
use t27f::scene::Q8;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_pixel_color;
use t27f::vf_pixel::vf_paint_id;
use t27f::vf_pixel::VF_PX_NONE;
use t27f::vf_pixel::VF_PALETTE;
use t27f::vf_pixel::vf_px_card;
use t27f::frame_render::draw_text;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::ppm_len;
use t27f::frame_render::TEXT_TRANSPARENT;
use t27f::frame_render::FRAME_OK;

; outline colour 0x444444 and the label colour 0xFFFFFF, as decimal
pub const VF_R_BORDER : u32 = 4473924;
pub const VF_R_TEXT_LIGHT : u32 = 16777215;

; results: ok, or the buffer is too small (or w or h is 0, or w or h is over 4096)
pub const VF_R_OK : u8 = 0;
pub const VF_R_SMALL : u8 = 1;

; the test raster: 375 x 192 pixels, 375 * 192 * 3 = 216000 RGB bytes, plus the 15 header bytes of P6 375 192 255
pub var VF_T_RGB : [216000]u8 = [0;216000];
pub var VF_T_PPM : [216015]u8 = [0;216015];

; true when the pixel lies on the 1-pixel outline of node i: the right and bottom edges are w - 1 and h - 1 past the origin
fn vf_on_outline(l: VfLayout, i: u32, px: u32, py: u32) -> bool {
    if px == l.x[i] {
        return true;
    }
    if px + 1 == l.x[i] + l.w[i] {
        return true;
    }
    if py == l.y[i] {
        return true;
    }
    if py + 1 == l.y[i] + l.h[i] {
        return true;
    }
    return false;
}

; paint the graph into rgb (w * h * 3 bytes, row by row, top row first), then draw the labels of text, badge and button nodes
pub fn vf_render_rgb(g: VfGraph, l: VfLayout, rgb: []u8, w: u32, h: u32) -> u8 {
    if w == 0 or h == 0 {
        return VF_R_SMALL;
    }
    if w > 4096 or h > 4096 {
        return VF_R_SMALL;
    }
    var need : u32 = w * h * 3;
    if need > (rgb.len as u32) {
        return VF_R_SMALL;
    }

    var py : u32 = 0;
    while py < h {
        var px : u32 = 0;
        while px < w {
            var col : u32 = vf_pixel_color(g, l, px, py);
            var id : u32 = vf_paint_id(g, l, px, py);
            if id != VF_PX_NONE {
                if vf_on_outline(l, id, px, py) {
                    col = VF_R_BORDER;
                }
            }
            var at : usize = ((py * w + px) * 3) as usize;
            rgb[at] = ((col / 65536) % 256) as u8;
            rgb[at + 1] = ((col / 256) % 256) as u8;
            rgb[at + 2] = (col % 256) as u8;
            px = px + 1;
        }
        py = py + 1;
    }

    var ni : u32 = 0;
    while ni < l.node_count {
        var k : u8 = g.kind[ni];
        var fg : u32 = VF_R_TEXT_LIGHT;
        var labelled : bool = false;
        if k == VF_TEXT {
            labelled = true;
        }
        if k == VF_BADGE {
            labelled = true;
        }
        if k == VF_BUTTON {
            labelled = true;
        }
        let s : str = g.text[ni];
        var has_text : bool = true;
        if s == "" {
            has_text = false;
        }
        if labelled and has_text {
            var ty : u32 = l.y[ni];
            if l.h[ni] > 7 {
                ty = ty + (l.h[ni] - 7) / 2;
            }
            var dr : u8 = draw_text(rgb, w, h, (l.x[ni] + 4) as i32, ty as i32, s, fg as i32, TEXT_TRANSPARENT, Q8);
            if dr != FRAME_OK {
                return dr;
            }
        }
        ni = ni + 1;
    }
    return VF_R_OK;
}

; render into rgb, then lay the P6 file down in dst: the render's refusal, else the PPM writer's result
pub fn vf_render_ppm(g: VfGraph, l: VfLayout, rgb: []u8, dst: []u8, w: u32, h: u32) -> u8 {
    var rr : u8 = vf_render_rgb(g, l, rgb, w, h);
    if rr != VF_R_OK {
        return rr;
    }
    return ppm_write_into(dst, rgb, w, h);
}

; colour 0xRRGGBB of the test-raster pixel (x, y)
fn vf_t_px(x: u32, y: u32) -> u32 {
    var at : usize = ((y * 375 + x) * 3) as usize;
    var r : u32 = VF_T_RGB[at] as u32;
    var gr : u32 = VF_T_RGB[at + 1] as u32;
    var b : u32 = VF_T_RGB[at + 2] as u32;
    return r * 65536 + gr * 256 + b;
}

; how many pixels of colour col lie in x0 <= x < x1 and y0 <= y < y1
fn vf_t_count(x0: u32, x1: u32, y0: u32, y1: u32, col: u32) -> u32 {
    var cnt : u32 = 0;
    var cy : u32 = y0;
    while cy < y1 {
        var cx : u32 = x0;
        while cx < x1 {
            if vf_t_px(cx, cy) == col {
                cnt = cnt + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    return cnt;
}

test renders_ok {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    var small : [10]u8 = [0; 10];
    assert vf_render_rgb(g, l, &small, 375, 192) == VF_R_SMALL;
    assert vf_render_rgb(g, l, &VF_T_RGB, 0, 192) == VF_R_SMALL;
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 0) == VF_R_SMALL;
}

test outline {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    assert vf_t_px(0, 0) == VF_R_BORDER;
    assert vf_t_px(374, 191) == VF_R_BORDER;
    assert vf_t_px(300, 100) == VF_PALETTE[VF_CARD as u32];
}

test fills {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    assert vf_t_px(100, 160) == VF_PALETTE[VF_BUTTON as u32];
    assert vf_t_px(100, 120) == VF_PALETTE[VF_INPUT as u32];
    assert vf_t_px(52, 56) == VF_PALETTE[VF_BADGE as u32];
    assert vf_t_px(106, 160) == VF_PALETTE[VF_STACK as u32];
    assert vf_t_px(8, 160) == VF_R_BORDER;
}

test text_is_drawn {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    // the Save label row starts at 154 + (40 - 7) / 2 = 170; the 30 px title row starts at 8 + (30 - 7) / 2 = 19
    assert vf_t_count(12, 37, 170, 177, VF_R_TEXT_LIGHT) >= 1;
    assert vf_t_count(12, 87, 19, 26, VF_R_TEXT_LIGHT) >= 1;
    g.text[6] = "";
    g.text[1] = "";
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    assert vf_t_count(12, 37, 170, 177, VF_R_TEXT_LIGHT) == 0;
    assert vf_t_count(12, 87, 19, 26, VF_R_TEXT_LIGHT) == 0;
}

test ppm_bytes {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_ppm(g, l, &VF_T_RGB, &VF_T_PPM, 375, 192) == VF_R_OK;
    assert VF_T_PPM[0] == 80;
    assert VF_T_PPM[1] == 54;
    assert VF_T_PPM[2] == 10;
    assert VF_T_PPM[3] == 51;
    assert VF_T_PPM[4] == 55;
    assert VF_T_PPM[5] == 53;
    assert VF_T_PPM[6] == 32;
    assert VF_T_PPM[7] == 49;
    assert VF_T_PPM[8] == 57;
    assert VF_T_PPM[9] == 50;
    assert VF_T_PPM[10] == 10;
    assert VF_T_PPM[11] == 50;
    assert VF_T_PPM[12] == 53;
    assert VF_T_PPM[13] == 53;
    assert VF_T_PPM[14] == 10;
    assert VF_T_PPM[15] == 68;
    assert VF_T_PPM[16] == 68;
    assert VF_T_PPM[17] == 68;
    assert VF_T_PPM[216014] == 68;
    assert ppm_len(375, 192) == 216015;
}

test layout_break_shows {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    var before : u32 = vf_t_px(300, 10);
    assert before == VF_PALETTE[VF_CARD as u32];
    l.w[1] = 400;
    assert vf_render_rgb(g, l, &VF_T_RGB, 375, 192) == VF_R_OK;
    var after : u32 = vf_t_px(300, 10);
    assert after == VF_PALETTE[VF_TEXT as u32];
    assert after == 0x222222;
    assert after != before;
}
