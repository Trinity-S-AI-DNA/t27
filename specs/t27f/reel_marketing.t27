// SPDX-License-Identifier: Apache-2.0
// specs/t27f/reel_marketing.t27 -- what a short vertical reel must do to work as marketing, as
// numbers a renderer's layout and timing are tested against: where the platforms draw their own
// interface over the picture, how soon the hook must land, how often the picture must change, and
// how long and how big the call to action stays at the end.
//
// WHY: the owner, 2026-10-18, on the token_floor reel: study how marketing reels are made, so that
// ours is marketing too. A reel that is right but sits under the platform's buttons, opens on an
// empty frame or ends without an address does not sell anything.
//
// THE PRACTICE, as the 2026 creator and vendor guides give it (directional: none of it is a
// platform's published law, and the guides disagree on the numbers):
//
//     the overlay  Instagram Reels, TikTok and YouTube Shorts draw over a 1080x1920 reel: the
//                  account line at the top, the caption, the audio line and the action button at
//                  the bottom, the like/comment/share rail on the right. Measured margins, organic
//                  posts, by source, are in REEL_SOURCE_MARGIN; REEL_SAFE takes the widest margin of
//                  every edge, so what is inside shows on all three alike. Ads need more (Meta
//                  asks for the bottom 40% free under a disclaimer): NOT CLAIMED here, and that is
//                  the zone specs/automation/crm-lead-magnet.t27 holds for its story frame.
//     the hook     most of the viewers who leave, leave in the first 3 s. The statement is on
//                  screen, written and readable, inside REEL_HOOK_TEXT_MS, and the voice has
//                  started inside REEL_FIRST_WORD_MS.
//     captions     feeds autoplay muted, so the words are burned in, inside the safe zone, and
//                  the first caption is the hook itself.
//     pace         a new picture -- a new shot, the camera arriving somewhere -- at least every
//                  REEL_RESET_MS, or attention resets elsewhere.
//     the CTA      the address, big, inside the safe zone, held still for the reel's last
//                  REEL_CTA_MIN_MS at least. The house template holds 3 s
//                  (owner_voice_reel.CTA_HOLD_MS); a reel whose voice runs longer keeps this floor.
//     the length   15 to 30 s keeps retention highest.
//
// Sources (fetched 2026-10-18): postplanify.com/blog/social-media-safe-zones-2026-complete-guide,
// uplads.com/tools/safe-zone-checker (zones verified July 2026), xyla.ai/tools/social-media-sizes,
// reelsafezone.com, adaptlypost.com/blog/social-media-safe-zones-2026-complete-guide,
// opus.pro/blog/ideal-youtube-shorts-length-format-retention, capcut.com/create/short-form-video-hooks.
//
// NOT CLAIMED: that a reel inside these numbers is watched; the numbers are the floor a marketing
// reel stands on, not a forecast of its reach.
// phi^2 + 1/phi^2 = 3 | TRINITY

module reel_marketing;

pub const ID : str = "reel-marketing";
pub const MEASURED_ON : str = "2026-10-18";

// ---- the overlay ----
pub const REEL_W : f64 = 1080.0;
pub const REEL_H : f64 = 1920.0;

// Per source, organic post, px of 1080x1920: top, bottom, left, right. 0 where the source names
// no margin on that edge.
//   0 TikTok, PostPlanify             1 TikTok, Uplads (organic)       2 TikTok, Xyla
//   3 Instagram Reels, PostPlanify    4 Instagram Reels, ReelSafeZone  5 Instagram Reels, Xyla
//   6 all three, AdaptlyPost: a 900x1400 area centred in the frame
pub const REEL_SOURCES : usize = 7;
pub const REEL_SOURCE_MARGIN : [28]f64 = [
    108.0, 320.0, 60.0, 120.0,
    130.0, 320.0, 44.0, 140.0,
    130.0, 484.0, 0.0, 140.0,
    210.0, 310.0, 0.0, 84.0,
    220.0, 280.0, 0.0, 160.0,
    220.0, 430.0, 130.0, 130.0,
    260.0, 260.0, 90.0, 90.0
];

// The widest margin of edge e (0 top, 1 bottom, 2 left, 3 right) over every source.
pub fn reel_margin(e: usize) -> f64 {
    var m : f64 = 0.0;
    var s : usize = 0;
    while (s < REEL_SOURCES) {
        const v = REEL_SOURCE_MARGIN[s * 4 + e];
        if (v > m) { m = v; }
        s = s + 1;
    }
    return m;
}

// The safe rect of the tall frame, k 0..3: x0, y0, x1, y1.
pub fn reel_safe(k: usize) -> f64 {
    if (k == 0) { return reel_margin(2); }
    if (k == 1) { return reel_margin(0); }
    if (k == 2) { return REEL_W - reel_margin(3); }
    return REEL_H - reel_margin(1);
}

// True when the box (x0, y0)-(x1, y1), tall-frame px, shows on every platform.
pub fn reel_shows(x0: f64, y0: f64, x1: f64, y1: f64) -> bool {
    return x0 >= reel_safe(0) && y0 >= reel_safe(1) && x1 <= reel_safe(2) && y1 <= reel_safe(3);
}

// ---- the clock ----
pub const REEL_FIRST_WORD_MS : i32 = 500;   // the voice has started
pub const REEL_HOOK_TEXT_MS : i32 = 1000;   // the hook's statement is written on screen
pub const REEL_HOOK_MS : i32 = 3000;        // the window the viewer decides in
pub const REEL_RESET_MS : i32 = 3000;       // the longest a picture may stay unchanged
pub const REEL_CTA_MIN_MS : i32 = 1500;     // the address, still, at the end
pub const REEL_MIN_MS : i32 = 15000;
pub const REEL_MAX_MS : i32 = 30000;

// ---- legibility ----
// A 1080 px wide frame is about 68 mm on a 6.1 inch phone: 40 px of cap height is 2.5 mm, the
// smallest a statement is read at a glance; a CTA line is set at 64 px of type or more.
pub const REEL_TEXT_MIN_PX : f64 = 40.0;
pub const REEL_CTA_MIN_PX : f64 = 64.0;

pub fn reel_length_ok(ms: i32) -> bool {
    return ms >= REEL_MIN_MS && ms <= REEL_MAX_MS;
}

// ---- tests ----

test "the safe rect takes the widest margin of every edge, and leaves a picture" {
    assert(reel_margin(0) == 260.0);
    assert(reel_margin(1) == 484.0);
    assert(reel_margin(2) == 130.0);
    assert(reel_margin(3) == 160.0);
    // every source's own zone holds the union: no edge of it is closer than any source allows
    var s : usize = 0;
    while (s < REEL_SOURCES) {
        assert(reel_safe(1) >= REEL_SOURCE_MARGIN[s * 4]);
        assert(REEL_H - reel_safe(3) >= REEL_SOURCE_MARGIN[s * 4 + 1]);
        assert(reel_safe(0) >= REEL_SOURCE_MARGIN[s * 4 + 2]);
        assert(REEL_W - reel_safe(2) >= REEL_SOURCE_MARGIN[s * 4 + 3]);
        s = s + 1;
    }
    // what is left is 790 x 1176, three fifths of the frame's height
    assert(reel_safe(2) - reel_safe(0) == 790.0);
    assert(reel_safe(3) - reel_safe(1) == 1176.0);
}

test "the overlay check bites: the old caption line and the old tag line are under the platform" {
    // a caption centred at y 1700, as token_floor's tall cut had it, is under the caption and audio
    assert(reel_shows(60.0, 1629.0, 1020.0, 1777.0) == false);
    // a tag at y 96 is under the account line; one at the right edge under the rail
    assert(reel_shows(60.0, 96.0, 400.0, 132.0) == false);
    assert(reel_shows(600.0, 600.0, 1000.0, 640.0) == false);
    assert(reel_shows(130.0, 260.0, 920.0, 1436.0));
}

test "the clock: the hook inside the decision window, the CTA after it, the length in range" {
    assert(REEL_FIRST_WORD_MS < REEL_HOOK_TEXT_MS);
    assert(REEL_HOOK_TEXT_MS < REEL_HOOK_MS);
    assert(REEL_HOOK_MS + REEL_CTA_MIN_MS < REEL_MIN_MS);
    assert(REEL_RESET_MS * 5 <= REEL_MIN_MS);
    assert(reel_length_ok(15000));
    assert(reel_length_ok(30000));
    assert(reel_length_ok(14999) == false);
    assert(reel_length_ok(45000) == false);
    assert(REEL_TEXT_MIN_PX < REEL_CTA_MIN_PX);
}
