// SPDX-License-Identifier: Apache-2.0
; T27F renderer artifact: the shared menu frame through one target, written to stdout as a binary PPM
; Refs gHashTag/t27#13296 gHashTag/t27#13297 gHashTag/t27#13298
; VF_TARGET=web     the RGBA bytes canvas_put_pixels would get, packed back to RGB
; VF_TARGET=native  the RGB bytes t27os_blit would get
; VF_TARGET=fpga    the AXI4-Lite write list replayed through the fill-engine model
; Any other value exits 2; a refused frame exits 3; no extern of the three renderers is called
; Run: t27b build this spec to an object, link it with -undefined dynamic_lookup (the unused
; renderer externs stay unresolved), then VF_TARGET=fpga ./m > target/vf/fpga.ppm

module t27f_vf_render_main;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_exit;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::ppm_len;
use t27f::frame_render::FRAME_OK;
use t27f::vf_render::VF_R_OK;
use t27f::vf_menu::vf_menu_graph;
use t27f::vf_menu::VF_MENU_H;
use t27f::vf_render_web::vf_web_plan;
use t27f::vf_render_native::vf_native_plan;
use t27f::vf_render_fpga::vf_fpga_plan;
use t27f::vf_render_fpga::vf_fpga_engine;

; every buffer is a local: a t27b object file has no writable data section for a module-level var
pub const VF_M_W : u32 = 375;

; 0 web, 1 native, 2 fpga, 255 unknown, from the first byte of the target name
pub fn vf_main_target(c: u8) -> u8 {
    if c == 119 { return 0; }
    if c == 110 { return 1; }
    if c == 102 { return 2; }
    return 255;
}

; render the menu through target t into rgb (375 x 84 x 3); the render code
; rgba (x 4), ops (240), addr and data (512) are the web and fpga routes' scratch
pub fn vf_main_render(t: u8, rgb: []u8, rgba: []u8, ops: []u32, addr: []u32, data: []u32) -> u8 {
    var g : VfGraph = vf_menu_graph(VF_M_W);
    var l : VfLayout = vf_layout(g);
    if t == 0 {
        var code : u8 = vf_web_plan(g, l, rgb, rgba, VF_M_W, VF_MENU_H);
        if code != VF_R_OK {
            return code;
        }
        // overwrite the raster with what the canvas would show, so the PPM is the RGBA path
        var i : u32 = 0;
        while i < VF_M_W * VF_MENU_H {
            rgb[(i * 3) as usize] = rgba[(i * 4) as usize];
            rgb[(i * 3 + 1) as usize] = rgba[(i * 4 + 1) as usize];
            rgb[(i * 3 + 2) as usize] = rgba[(i * 4 + 2) as usize];
            i = i + 1;
        }
        return code;
    }
    if t == 1 {
        return vf_native_plan(g, l, rgb, VF_M_W, VF_MENU_H);
    }
    var n : u32 = vf_fpga_plan(g, l, VF_M_W, VF_MENU_H, ops, addr, data);
    return vf_fpga_engine(addr, data, n, rgb, VF_M_W, VF_MENU_H);
}

; a position-weighted checksum of a 375 x 84 frame
pub fn vf_main_sum(rgb: []const u8) -> u64 {
    var s : u64 = 0;
    var i : usize = 0;
    while i < 94500 {
        s = s + (rgb[i] as u64) * ((i % 251) as u64 + 1);
        i = i + 1;
    }
    return s;
}

pub fn main() -> void {
    const p : u64 = sys_getenv("VF_TARGET");
    if p == 0 {
        sys_exit(2);
    }
    var name : [8]u8 = [0; 8];
    var nn : u64 = sys_strlen(p);
    if nn == 0 {
        sys_exit(2);
    }
    if nn > 8 {
        nn = 8;
    }
    sys_peek(name[0..8], p, nn);
    var t : u8 = vf_main_target(name[0]);
    if t == 255 {
        sys_exit(2);
    }
    var rgb : [94500]u8 = [0; 94500];
    var rgba : [126000]u8 = [0; 126000];
    var ops : [240]u32 = [0; 240];
    var addr : [512]u32 = [0; 512];
    var data : [512]u32 = [0; 512];
    var ppm : [94514]u8 = [0; 94514];
    if vf_main_render(t, &rgb, &rgba, &ops, &addr, &data) != VF_R_OK {
        sys_exit(3);
    }
    if ppm_write_into(&ppm, &rgb, VF_M_W, VF_MENU_H) != FRAME_OK {
        sys_exit(3);
    }
    var len : u32 = ppm_len(VF_M_W, VF_MENU_H);
    sys_write(1, ppm[0..94514], @as(u64, len));
    sys_exit(0);
}

test targets_from_names {
    assert vf_main_target(119) == 0;
    assert vf_main_target(110) == 1;
    assert vf_main_target(102) == 2;
    assert vf_main_target(120) == 255;
    // "P6\n375 84\n255\n" is 14 bytes
    assert ppm_len(VF_M_W, VF_MENU_H) == 94514;
}

test three_targets_one_frame {
    // all three routes give the same bytes for the menu frame, each into its own zeroed buffer
    var rn : [94500]u8 = [0; 94500];
    var rw : [94500]u8 = [0; 94500];
    var rf : [94500]u8 = [0; 94500];
    var rgba : [126000]u8 = [0; 126000];
    var ops : [240]u32 = [0; 240];
    var addr : [512]u32 = [0; 512];
    var data : [512]u32 = [0; 512];
    assert vf_main_render(1, &rn, &rgba, &ops, &addr, &data) == VF_R_OK;
    assert vf_main_render(0, &rw, &rgba, &ops, &addr, &data) == VF_R_OK;
    assert vf_main_render(2, &rf, &rgba, &ops, &addr, &data) == VF_R_OK;
    var sn : u64 = vf_main_sum(&rn);
    assert sn > 0;
    assert vf_main_sum(&rw) == sn;
    assert vf_main_sum(&rf) == sn;
    // negative control: one changed byte changes the sum
    rf[47000] = rf[47000] + 1;
    assert vf_main_sum(&rf) != sn;
}
