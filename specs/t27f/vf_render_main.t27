// SPDX-License-Identifier: Apache-2.0
; T27F renderer artifact: the shared menu frame through one target, written to stdout as a binary PPM
; Refs gHashTag/t27#13296 gHashTag/t27#13297 gHashTag/t27#13298 gHashTag/t27#13214
; Every target draws the UI Kit frame: vct_render's boxes and Outfit labels in theme TH_T27
; VF_TARGET=web     the canvas draw list (vf_draw_ops) replayed into RGB, what canvas_fill_rect and canvas_draw_text paint
;   (the RGBA pixel path stays tested in vf_render_web; a 162000-byte local here lowers to a 1296000-bit Verilog
;   signal, over the 2^20-bit absurd-width gate of tools/check_verilog_widths.py)
; VF_TARGET=native  the RGB bytes t27os_blit would get
; VF_TARGET=fpga    the AXI4-Lite write list (boxes + text spans) replayed through the fill-engine model
; Any other value exits 2; a refused frame exits 3; no extern of the three renderers is called
; Run: t27b build this spec to an object, link it with -undefined dynamic_lookup (the unused
; renderer externs stay unresolved), then VF_TARGET=fpga ./m > target/vf/fpga.ppm

module t27f_vf_render_main;
use t27os::pty_sys::sys_write;
use t27os::pty_sys::sys_getenv;
use t27os::pty_sys::sys_strlen;
use t27os::pty_sys::sys_peek;
use t27os::pty_sys::sys_exit;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::frame_render::ppm_write_into;
use t27f::frame_render::ppm_len;
use t27f::frame_render::FRAME_OK;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_BAD_RASTER;
use t27f::vf_menu::vf_menu_graph;
use t27f::vf_menu::VF_MENU_H;
use t27f::vf_render_web::vf_draw_ops;
use t27f::vf_render_web::vf_ops_replay;
use t27f::vf_render_native::vf_native_plan;
use t27f::vf_render_fpga::vf_fpga_plan;
use t27f::vf_render_fpga::vf_fpga_engine;

; every buffer is a local: a t27b object file has no writable data section for a module-level var
pub const VF_M_W : u32 = 375;

; 0 web, 1 native, 2 fpga, 255 unknown, from the first byte of the target name
pub fn vf_main_target(c: u8) -> u8 {
    if c == 119 { return 0; }
    if c == 110 { return 1; }
    if c == 102 { return 2; }
    return 255;
}

; render the menu through target t into rgb (375 x 108 x 3); vf_card's code
; ops (240) is the web route's draw list and the fpga route's scratch; full and base (x 3), addr and data (32768) the fpga route's
pub fn vf_main_render(t: u8, rgb: []u8, ops: []u32, full: []u8, base: []u8, addr: []u32, data: []u32) -> u32 {
    var g : VfGraph = vf_menu_graph(VF_M_W);
    var l : VfLayout = vf_layout(g);
    if t == 0 {
        // the vector path: the draw list the canvas gets, painted back with the painter's own fill and text
        var n : u32 = vf_draw_ops(g, l, VF_M_W, VF_MENU_H, ops);
        if n == 0 {
            return VC_BAD_RASTER;
        }
        return vf_ops_replay(g, l, ops, n, rgb, VF_M_W, VF_MENU_H);
    }
    if t == 1 {
        return vf_native_plan(g, l, rgb, VF_M_W, VF_MENU_H);
    }
    var n : u32 = vf_fpga_plan(g, l, VF_M_W, VF_MENU_H, ops, full, base, addr, data);
    if n == 0 {
        return VC_BAD_RASTER;
    }
    return vf_fpga_engine(addr, data, n, rgb, VF_M_W, VF_MENU_H);
}

; a position-weighted checksum of a 375 x 108 frame
pub fn vf_main_sum(rgb: []const u8) -> u64 {
    var s : u64 = 0;
    var i : usize = 0;
    while i < 121500 {
        s = s + (rgb[i] as u64) * ((i % 251) as u64 + 1);
        i = i + 1;
    }
    return s;
}

pub fn main() -> void {
    const p : u64 = sys_getenv("VF_TARGET");
    if p == 0 {
        sys_exit(2);
    }
    var name : [8]u8 = [0; 8];
    var nn : u64 = sys_strlen(p);
    if nn == 0 {
        sys_exit(2);
    }
    if nn > 8 {
        nn = 8;
    }
    sys_peek(name[0..8], p, nn);
    var t : u8 = vf_main_target(name[0]);
    if t == 255 {
        sys_exit(2);
    }
    var rgb : [121500]u8 = [0; 121500];
    var ops : [240]u32 = [0; 240];
    var full : [121500]u8 = [0; 121500];
    var base : [121500]u8 = [0; 121500];
    var addr : [32768]u32 = [0; 32768];
    var data : [32768]u32 = [0; 32768];
    var ppm : [121515]u8 = [0; 121515];
    if vf_main_render(t, &rgb, &ops, &full, &base, &addr, &data) != VC_OK {
        sys_exit(3);
    }
    if ppm_write_into(&ppm, &rgb, VF_M_W, VF_MENU_H) != FRAME_OK {
        sys_exit(3);
    }
    var len : u32 = ppm_len(VF_M_W, VF_MENU_H);
    sys_write(1, ppm[0..121515], @as(u64, len));
    sys_exit(0);
}

test targets_from_names {
    assert vf_main_target(119) == 0;
    assert vf_main_target(110) == 1;
    assert vf_main_target(102) == 2;
    assert vf_main_target(120) == 255;
    // "P6\n375 108\n255\n" is 15 bytes
    assert ppm_len(VF_M_W, VF_MENU_H) == 121515;
}

test three_targets_one_frame {
    // all three routes give the same bytes for the menu frame, each into its own zeroed buffer
    var rn : [121500]u8 = [0; 121500];
    var rw : [121500]u8 = [0; 121500];
    var rf : [121500]u8 = [0; 121500];
    var ops : [240]u32 = [0; 240];
    var full : [121500]u8 = [0; 121500];
    var base : [121500]u8 = [0; 121500];
    var addr : [32768]u32 = [0; 32768];
    var data : [32768]u32 = [0; 32768];
    assert vf_main_render(1, &rn, &ops, &full, &base, &addr, &data) == VC_OK;
    assert vf_main_render(0, &rw, &ops, &full, &base, &addr, &data) == VC_OK;
    assert vf_main_render(2, &rf, &ops, &full, &base, &addr, &data) == VC_OK;
    var sn : u64 = vf_main_sum(&rn);
    assert sn > 0;
    assert vf_main_sum(&rw) == sn;
    assert vf_main_sum(&rf) == sn;
    // negative control: one changed byte changes the sum
    rf[60000] = rf[60000] + 1;
    assert vf_main_sum(&rf) != sn;
}
