; specs/t27f/petal_queen_viz.t27 -- petal 17 (Q QUEEN) of the interactive visualization epic.
; Refs epic t27#12173; built on specs/t27f/viz_contract.t27 (the landed drill law).
; --
; Question: "What is the Queen doing right now, and what did she improve today?"
; Source:   specs/t27os/queen_board.t27 -- the feed words (FK_* over FEED_WORDS, ring_text_head,
;           ring_text_len), the source merge (merge_pick, QB_SRC_*), the not-measured word law
;           (QB_NOT_MEASURED) and today's improvement meters (M_LABELS). specs/t27os/evolve.t27
;           names the gaps (G_* kinds) and letters (letter_char). Called, never copied.
; Fixture:  queen_board keeps no event data -- it grades what the log feeds -- so the ring rows
;           and meter readings below are this petal's recorded reading of those laws, pinned
;           FIXTURE, never publishable as live.
; Identity: a gap's identity word is KIND + 16 * LETTER (evolve names the kind, the letter the
;           gap touches); the same gap re-picked days later packs the same identity.
; Flags:    view = feed strip + gap card + meter row; source = specs/t27os/queen_board.t27 +
;           specs/t27os/evolve.t27; live = NO (fixture-fed; the live log read is the host route).
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module PetalQueenViz;

use t27f::viz_contract::VizState;
use t27f::viz_contract::viz_apply;
use t27f::viz_contract::viz_init;
use t27f::viz_contract::viz_ref;
use t27f::viz_contract::viz_ref_kind;
use t27f::viz_contract::VIZ_REF_NONE;
use t27f::viz_contract::VIZ_ENT_NODE;
use t27f::viz_contract::VIZ_ENT_CELL;
use t27f::viz_contract::VIZ_EV_COUNT;
use t27f::viz_contract::VIZ_EV_LOAD;
use t27f::viz_contract::VIZ_EV_LOADED;
use t27f::viz_contract::VIZ_EV_DRILL;
use t27f::viz_contract::VIZ_EV_BACK;
use t27f::viz_contract::VIZ_LC_READY;
use t27f::viz_contract::VIZ_LV_OVERVIEW;
use t27f::viz_contract::VIZ_LV_DETAIL;
use t27f::viz_contract::VIZ_ZOOM_NONE;
use t27f::viz_contract::VIZ_ZOOM_LIVE;
use t27f::viz_contract::VIZ_TRUTH_DEMO;
use t27os::queen_board::FK_PICKED;
use t27os::queen_board::FK_LANE;
use t27os::queen_board::FK_PASS;
use t27os::queen_board::FK_FAIL;
use t27os::queen_board::FK_ASKED;
use t27os::queen_board::FK_COUNT;
use t27os::queen_board::ring_text_head;
use t27os::queen_board::ring_text_len;
use t27os::queen_board::merge_pick;
use t27os::queen_board::QB_SRC_RING;
use t27os::queen_board::QB_SRC_LANE;
use t27os::queen_board::QB_SRC_NONE;
use t27os::queen_board::QB_NOT_MEASURED;
use t27os::evolve::G_RED;
use t27os::evolve::G_BLOCKED;
use t27os::evolve::G_STALE;
use t27os::evolve::letter_char;

; --- 1. The gap identity -----------------------------------------------------------------------------

/// A gap's identity word: kind + 16 * letter. Two gaps of one kind on different letters are
/// different entities; the same gap re-picked packs the same word.
pub const PQ_STRIDE : u32 = 16;

pub fn pq_gap_identity(kind : u32, letter : u32) -> u32 {
    return kind + PQ_STRIDE * letter;
}

/// The gap's entity ref, packed as a node -- never zero for a real kind.
pub fn pq_gap_ref(kind : u32, letter : u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, pq_gap_identity(kind, letter));
}

; --- 2. The fixture ring -----------------------------------------------------------------------------

/// The petal's recorded ring rows: control kind, letter, and the seconds each row names. The
/// newest row is index 0 -- the board's ring reads most recent first.
pub const FR_COUNT : u32 = 4;
pub const FR_KIND : [4]u32 = [FK_LANE, FK_PASS, FK_PICKED, FK_ASKED];
pub const FR_LETTER : [4]u32 = [3, 0, 9, 2];
pub const FR_SEC : [4]u64 = [90, 240, 600, 1500];

/// The current action: the newest ring row's kind and letter.
pub fn pq_now_kind() -> u32 {
    return FR_KIND[0];
}

pub fn pq_now_letter() -> u32 {
    return FR_LETTER[0];
}

/// The not-measured shape: an empty ring has no current action. The honest word comes from the
/// source's own NOT_MEASURED law, never a guessed kind.
pub fn pq_now_measured() -> bool {
    return FR_COUNT > 0 and FR_KIND[0] < FK_COUNT;
}

; --- 3. The meters -----------------------------------------------------------------------------------

/// Today's improvements, one reading per M_LABELS entry. The labels live in the source; the
/// readings are the petal's recorded fixture.
pub const PQ_METERS : u32 = 6;
pub const PQ_METER_VALUE : [6]u32 = [4, 312, 2, 1, 0, 1];

/// One meter row is not measured when the host sent the NOT_MEASURED word; the petal carries the
/// word, never a zero that looks like a reading.
pub fn pq_meter_value(m : u32, raw : u32) -> u32 {
    if (raw == QB_NOT_MEASURED) { return QB_NOT_MEASURED; }
    return raw;
}

/// The source of the current action when both feeds speak: the source's own merge law decides.
pub fn pq_source(ring_left : u32, lane_left : u32, ring_sec : u64, lane_sec : u64) -> u32 {
    return merge_pick(ring_left, ring_sec, lane_left, lane_sec);
}

; --- 4. The state door -------------------------------------------------------------------------------

/// The petal event: a new ring row lands (a = its kind, b = its letter), above VIZ_EV_COUNT.
pub const PHQ_EV_FEED : u8 = VIZ_EV_COUNT;

pub fn phq_init() -> VizState {
    return viz_init(2, PQ_METERS);
}

/// The one input door: contract events to viz_apply; a feed event is recorded through the same
/// door (the revision proves the page changed).
pub fn phq_apply(s : VizState, ev : u8, a : u32, b : u32) -> VizState {
    var n : VizState = viz_apply(s, ev, a, b);
    if (ev == PHQ_EV_FEED) { n.revision = n.revision + 1; }
    return n;
}

/// Drill into a gap: its identity word through the one door. The zero word drills as NONE, which
/// the contract refuses -- no gap, no card, no invention.
pub fn pq_drill(s : VizState, kind : u32, letter : u32) -> VizState {
    return phq_apply(s, VIZ_EV_DRILL, pq_gap_identity(kind, letter), 0);
}

; --- 5. The badge ------------------------------------------------------------------------------------

/// The badge truth: the ring rows and meter readings are recorded fixture, so the page reads
/// DEMO, never LIVE.
pub fn pq_badge_truth() -> u8 {
    return VIZ_TRUTH_DEMO;
}

// ---------------------------------------------------------------- tests

test the_current_action_reads_the_newest_ring_row {
    var s : VizState = phq_init();
    s = phq_apply(s, VIZ_EV_LOAD, 0, 0);
    s = phq_apply(s, VIZ_EV_LOADED, PQ_METERS, VIZ_TRUTH_DEMO as u32);
    assert(s.lifecycle == VIZ_LC_READY);
    // the newest row names the current action: a lane for letter c
    assert(pq_now_kind() == FK_LANE and pq_now_letter() == 3);
    assert(pq_now_measured());
    // the source's own text law counts the line: head + the letter's char
    assert(ring_text_head(FK_LANE) == "started a lane for letter ");
    assert(ring_text_len(FK_LANE, 3) == ring_text_head(FK_LANE).len + 1);
    assert(letter_char(3) == "c");
}

test the_gap_identity_is_kind_plus_16_letter {
    // different kinds or different letters are different gaps
    assert(pq_gap_identity(G_RED, 3) == G_RED + PQ_STRIDE * 3);
    assert(pq_gap_identity(G_RED, 3) != pq_gap_identity(G_BLOCKED, 3));
    assert(pq_gap_identity(G_RED, 3) != pq_gap_identity(G_RED, 9));
    // the same gap re-picked packs the same identity -- the drill survives a refresh
    assert(pq_gap_identity(G_STALE, 2) == pq_gap_identity(G_STALE, 2));
    // the ref carries the node kind and never collapses to NONE for a real gap
    assert(pq_gap_ref(G_RED, 3) != VIZ_REF_NONE and viz_ref_kind(pq_gap_ref(G_RED, 3)) == VIZ_ENT_NODE);
}

test the_drill_moves_to_detail_and_back_clears {
    var s : VizState = phq_init();
    s = phq_apply(s, VIZ_EV_LOAD, 0, 0);
    s = phq_apply(s, VIZ_EV_LOADED, PQ_METERS, VIZ_TRUTH_DEMO as u32);
    s = pq_drill(s, G_RED, 3);
    assert(s.level == VIZ_LV_DETAIL and s.zoom_id == pq_gap_identity(G_RED, 3));
    assert(s.zoom_gone == VIZ_ZOOM_LIVE);
    // BACK returns to overview and clears the zoom (the contract's drill law)
    s = phq_apply(s, VIZ_EV_BACK, 0, 0);
    assert(s.level == VIZ_LV_OVERVIEW and s.zoom_id == VIZ_ZOOM_NONE and s.zoom_gone == VIZ_ZOOM_LIVE);
    // drilling with no gap (identity NONE) is refused: no invented card
    s = phq_apply(s, VIZ_EV_DRILL, VIZ_ZOOM_NONE, 0);
    assert(s.level == VIZ_LV_OVERVIEW);
}

test the_meters_carry_the_not_measured_word {
    // a raw NOT_MEASURED reading rides as itself -- never a zero that looks like a reading
    assert(pq_meter_value(2, QB_NOT_MEASURED) == QB_NOT_MEASURED);
    assert(pq_meter_value(2, 12) == 12);
    assert(QB_NOT_MEASURED == 4294967295);
    // the fixture readings are small honest numbers; the source owns the labels
    assert(PQ_METERS == 6 and PQ_METER_VALUE[4] == 0);
}

test the_source_merge_is_the_boards_law {
    // both feeds silent: none; one feed: that one; both: the fresher seconds win
    assert(pq_source(0, 0, 0, 0) == QB_SRC_NONE);
    assert(pq_source(1, 0, 90, 0) == QB_SRC_RING);
    assert(pq_source(0, 1, 0, 90) == QB_SRC_LANE);
    assert(pq_source(1, 1, 90, 30) == QB_SRC_RING);
    assert(pq_source(1, 1, 30, 90) == QB_SRC_LANE);
}

test every_input_goes_through_phq_apply_to_viz_apply {
    var s : VizState = phq_init();
    const r0 : u32 = s.revision;
    s = phq_apply(s, VIZ_EV_LOAD, 0, 0);
    assert(s.revision == r0 + 1);
    s = phq_apply(s, VIZ_EV_LOADED, PQ_METERS, VIZ_TRUTH_DEMO as u32);
    s = phq_apply(s, PHQ_EV_FEED, FK_PASS, 0);
    assert(s.revision == r0 + 3);
}

test the_fixture_is_never_live {
    assert(pq_badge_truth() == VIZ_TRUTH_DEMO);
    var s : VizState = phq_init();
    s = phq_apply(s, VIZ_EV_LOAD, 0, 0);
    s = phq_apply(s, VIZ_EV_LOADED, PQ_METERS, VIZ_TRUTH_DEMO as u32);
    s = phq_apply(s, PHQ_EV_FEED, FK_FAIL, 5);
    assert(s.truth == VIZ_TRUTH_DEMO);
}

invariant the_queen_petal_sends_every_input_through_one_reducer {
    assert(PQ_STRIDE == 16 and PHQ_EV_FEED == VIZ_EV_COUNT);
    assert(FK_COUNT > FK_ASKED and PQ_METERS == 6);
}
