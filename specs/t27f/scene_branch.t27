// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_branch.t27 -- scene A_BRANCH of reel_factory.t27: a decision tree. The stream
// starts at the foot and splits at every level, once per `if` or `switch` the lesson counts; the
// path the lesson's own bytes pick is drawn thick and lit in the accent, the others thin and dim.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: a branch is a place where the program chooses. The depth of the tree is the lesson's content
// count (3 to 5 levels), and the path taken at each level is one bit of the lesson's code.
//
// THE FUNCTION: branch_px(t, acc, n, x, y) is the colour of canvas point (x, y). Level l has 2^l
// nodes spread across 360 pixels; level 0 is at y = 570 and the top level at y = 90.
//
// NOT CLAIMED: the path is a choice read from the bytes, not the lesson's control flow.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_branch;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_disc;
use t27f::scene_raster::near_seg;
use t27f::scene_raster::clamp;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_byte;

pub const TOP_Y : i32 = 90;
pub const FOOT_Y : i32 = 570;
pub const DIM_EDGE : i32 = 0x39426B;

pub fn levels(n: i32) -> i32 {
    return clamp(n + 2, 3, 5);
}
pub fn pow2(l: i32) -> i32 {
    var p : i32 = 1;
    var k : i32 = 0;
    while (k < l) { p = p * 2; k = k + 1; }
    return p;
}
// The y of level l of a tree of lv levels.
pub fn level_y(l: i32, lv: i32) -> i32 {
    return FOOT_Y - @divTrunc(l * (FOOT_Y - TOP_Y), lv);
}
// The x of node i of level l: the 2^l nodes share the 360 pixels.
pub fn node_x(l: i32, i: i32) -> i32 {
    return @divTrunc((i * 2 + 1) * 360, pow2(l) * 2);
}
// The index, at level l, of the node on the path the lesson takes.
pub fn path_at(t: usize, l: i32) -> i32 {
    var i : i32 = 0;
    var k : i32 = 1;
    while (k <= l) {
        i = i * 2 + fmod(lex_byte(t, k * 5 + 1), 2);
        k = k + 1;
    }
    return i;
}

pub fn branch_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(5, acc, seed_of(t, n, 5), x, y);
    if (y < TOP_Y - 14 || y > FOOT_Y + 14) { return c0; }
    const lv = levels(n);
    var l : i32 = 1;
    var hit : i32 = 0;
    while (l <= lv) {
        const ya = level_y(l, lv);
        const yb = level_y(l - 1, lv);
        if (y >= ya - 12 && y <= yb + 12) {
            const cnt = pow2(l);
            const tk = path_at(t, l);
            var i : i32 = 0;
            while (i < cnt) {
                const px = node_x(l, i);
                const pp = node_x(l - 1, @divTrunc(i, 2));
                const on = (i == tk);
                if (on && in_disc(x, y, px, ya, 11)) { return acc; }
                if (!on && in_disc(x, y, px, ya, 6)) { return DIM_EDGE; }
                if (on && near_seg(x, y, pp, yb, px, ya, 3)) { return acc; }
                if (!on && near_seg(x, y, pp, yb, px, ya, 1)) { hit = 1; }
                i = i + 1;
            }
        }
        l = l + 1;
    }
    if (in_disc(x, y, node_x(0, 0), level_y(0, lv), 14)) { return rgb(245, 245, 245); }
    if (hit == 1) { return DIM_EDGE; }
    return c0;
}

// ---- tests ----

test "the tree has 3 to 5 levels and its nodes fit the canvas" {
    assert(levels(0) == 3);
    assert(levels(2) == 4);
    assert(levels(9) == 5);
    var l : i32 = 0;
    while (l <= 5) {
        var i : i32 = 0;
        while (i < (pow2(l))) {
            assert(node_x(l, i) > 0 && node_x(l, i) < 360);
            i = i + 1;
        }
        assert(level_y(l, 5) >= TOP_Y && level_y(l, 5) <= FOOT_Y);
        l = l + 1;
    }
    assert(level_y(0, 4) == FOOT_Y);
    assert(level_y(4, 4) == TOP_Y);
}

test "the path is one node a level and follows the lesson's bytes" {
    var l : i32 = 0;
    while (l <= 5) {
        assert(path_at(13, l) >= 0 && path_at(13, l) < (pow2(l)));
        l = l + 1;
    }
    var differ : i32 = 0;
    var t : usize = 1;
    while (t < 27) {
        if (path_at(t, 5) != path_at(t - 1, 5)) { differ = differ + 1; }
        t = t + 1;
    }
    assert(differ > 8);
}

test "another lesson draws another tree" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = branch_px(13, 0xE0409A, 3, x, y);
            const b = branch_px(20, 0xE0409A, 3, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (branch_px(8, 0x3B82F6, 2, x, y) != branch_px(8, 0x3B82F6, 2, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
