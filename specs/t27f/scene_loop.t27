// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_loop.t27 -- scene A_LOOP of reel_factory.t27: concentric orbits, one ring per
// loop the lesson counts, with 12 slots on every ring; a slot holds a dot when the lesson's next
// byte is not a multiple of three, in the accent when it is one more than a multiple.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: a loop is something that goes round. Three plus the lesson's content count rings (at most 8),
// and the count itself in the centre, so a lesson with more loops draws a fuller orbit.
//
// THE FUNCTION: loop_px(t, acc, n, x, y) is the colour of canvas point (x, y). The centre is
// (180, 320); the rings stand 16 to 19 pixels apart out to a radius of 160.
//
// NOT CLAIMED: the dots are placed from the lesson's bytes, they do not run the loop.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_loop;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_disc;
use t27f::scene_raster::in_ring;
use t27f::scene_raster::num_on;
use t27f::scene_raster::imin;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_bg::cos24;
use t27f::scene_bg::sin24;
use t27f::scene_lex::lex_byte;

pub const LCX : i32 = 180;
pub const LCY : i32 = 320;
pub const SLOTS : i32 = 12;
pub const RING_DIM : i32 = 0x2C3354;

pub fn ring_count(n: i32) -> i32 {
    return 3 + imin(n, 5);
}
pub fn ring_radius(j: i32, rings: i32) -> i32 {
    return 40 + @divTrunc(j * 120, rings);
}
// 0 no dot, 1 a dot, 2 a dot in the accent: the slot m of ring j of lesson t.
pub fn slot_of(t: usize, j: i32, m: i32) -> i32 {
    return fmod(lex_byte(t, j * SLOTS + m), 3);
}

pub fn loop_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(4, acc, seed_of(t, n, 4), x, y);
    if (in_disc(x, y, LCX, LCY, 26)) {
        if (in_disc(x, y, LCX, LCY, 24)) {
            if (num_on(n, x, y, LCX - 6, LCY - 10, 4)) { return rgb(245, 245, 245); }
            return mix(rgb(10, 12, 24), acc, 90);
        }
        return acc;
    }
    if (!in_disc(x, y, LCX, LCY, 172)) { return c0; }
    const rings = ring_count(n);
    var j : i32 = 0;
    while (j < rings) {
        const rj = ring_radius(j, rings);
        if (in_ring(x, y, LCX, LCY, rj - 8, rj + 8)) {
            var m : i32 = 0;
            while (m < SLOTS) {
                const k = m * 2 + fmod(j, 2);
                const dx = LCX + @divTrunc(rj * cos24(k), 1000);
                const dy = LCY + @divTrunc(rj * sin24(k), 1000);
                const s = slot_of(t, j, m);
                if (s > 0 && in_disc(x, y, dx, dy, 6)) {
                    if (s == 2) { return acc; }
                    return rgb(235, 238, 250);
                }
                m = m + 1;
            }
            if (in_ring(x, y, LCX, LCY, rj, rj + 1)) { return RING_DIM; }
        }
        j = j + 1;
    }
    return c0;
}

// ---- tests ----

test "the rings count the lesson's loops" {
    assert(ring_count(1) == 4);
    assert(ring_count(5) == 8);
    assert(ring_count(40) == 8);
    var j : i32 = 0;
    while (j < 8) {
        assert(ring_radius(j, 8) >= 40 && ring_radius(j, 8) < 160);
        j = j + 1;
    }
    assert(ring_radius(0, 4) == 40);
}

test "the dots are the lesson's bytes: another lesson draws another orbit" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = loop_px(14, 0x8B5CF6, 3, x, y);
            const b = loop_px(15, 0x8B5CF6, 3, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "a lesson with more loops draws more rings" {
    var few : i32 = 0;
    var many : i32 = 0;
    var x : i32 = LCX + 30;
    while (x < LCX + 175) {
        if (loop_px(14, 0x8B5CF6, 1, x, LCY) != bg_px(4, 0x8B5CF6, seed_of(14, 1, 4), x, LCY)) { few = few + 1; }
        if (loop_px(14, 0x8B5CF6, 5, x, LCY) != bg_px(4, 0x8B5CF6, seed_of(14, 5, 4), x, LCY)) { many = many + 1; }
        x = x + 1;
    }
    assert(many > 0);
    assert(few > 0);
    assert(ring_count(5) > ring_count(1));
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (loop_px(6, 0x3B82F6, 4, x, y) != loop_px(6, 0x3B82F6, 4, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
