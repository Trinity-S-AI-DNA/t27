// SPDX-License-Identifier: Apache-2.0
// specs/t27f/live_gx_wasm.t27 -- the WASM-SHAPE CARD instantiating live_graph_export.t27's
// gx_ exports: the card whose `use` line names the five fns the wasm32 module exports.
// The export-set rule (specs/tri/t27b/wasm.t27 floor 17's ANSWER, rule 1): the module's
// export entries are the main file's own pub fns plus the pub fns its `use` lines name
// -- this file names exactly gx_node_count, gx_node_kind, gx_node_name_ptr,
// gx_node_name_len and gx_replay, so the module's surface IS the law's own surface,
// with no second copy of the graph anywhere. Everything the splice pulls besides those
// five (work_graph's nodes, apply_event and their closure) are function-section rows
// and call targets, never export entries.
//
// WHY THE POINTER PARAMS STILL CROSS. Every accessor takes `gx: *GraphExport`; floor 17
// (the pointer-carrier parameter law) admits exactly that pointee as an i32 carrier --
// the pointer's whole content is the struct's base offset in module memory, a module
// constant the caller passes as plain i32. The declared type text rides the IR through
// ir::Func::param_text (the floor-17 plumbing) so the law's param_carrier sees the
// pointee; every other pointer still refuses.
//
// NOT CLAIMED: no body lowering lives on this card (the call body is the next floor --
// today the build's walk stops at the five admitted signatures' first body construct,
// named, not silent); no memory image is mounted here (floor 12's emit_with_image owns
// that when the stateful bodies lower); the card modifies neither live_graph_export nor
// work_graph, and its own test pins only what the card itself declares -- the law's own
// tests own the fns' behavior.
// phi^2 + 1/phi^2 = 3 | TRINITY

module live_gx_wasm;

use t27f::live_graph_export::{gx_node_count, gx_node_kind, gx_node_name_ptr, gx_node_name_len, gx_replay};
use t27f::live_graph_export::{NAME_OFF, NAME_ROW, LOG_OFF, LOG_BYTES};

test the_card_regions_are_the_law_s_own {
    // The card's own surface: the region constants the exported accessors answer in,
    // pinned as pulled (this card declares no layout of its own).
    assert NAME_ROW == 32;
    assert LOG_OFF > NAME_OFF;
    assert LOG_BYTES == 2048;
    // and at runtime, through a walk the compiler cannot fold: three name rows
    // tile exactly as the law's own region arithmetic says
    var rows : u32 = 0;
    var total : u32 = 0;
    while (rows < 3) {
        total = total + NAME_ROW;
        rows = rows + 1;
    }
    assert total == 96;
}
