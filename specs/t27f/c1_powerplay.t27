// SPDX-License-Identifier: Apache-2.0
// specs/t27f/c1_powerplay.t27 -- the PowerPlay acceptance gate for C1 (owner approved all
// three Pareto variants, 2026-11-03). The rule comes from verified science:
// Schmidhuber, arXiv:1112.5309 + Frontiers in Psychology 2013 -- a modification is accepted
// only when it (a) provably solves all previously stored tasks AND (b) solves at least one
// the unmodified predecessor cannot.
// --
// Applied to the C1 slice: the baseline passes a fixed set of checks; the candidate must
// pass every baseline check (monotone, no regression) AND at least one check the baseline
// failed (the improvement). A candidate that neither regresses nor improves is NEUTRAL --
// useful to know, not accepted, not rejected.
// --
// ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fC1PowerPlay;

/// The check result for one named check.
pub const PP_PASS : u8 = 0;
pub const PP_FAIL : u8 = 1;
pub const PP_SKIP : u8 = 2;

/// The gate outcome for a candidate against the baseline's results.
pub const PP_ACCEPT : u8 = 0;   // monotone improvement: all baseline checks still pass + at least one new
pub const PP_NEUTRAL : u8 = 1;  // same results as baseline: no regression, no improvement
pub const PP_REGRESS : u8 = 2;  // at least one check that passed on the baseline now fails
pub const PP_BROKEN : u8 = 3;   // the candidate itself fails validation before the check sweep

/// The PowerPlay gate: compare baseline check results (parallel arrays of PP_PASS/PP_FAIL)
/// against candidate check results. Same length required (the checks are fixed by the protocol).
///
/// Rules (Schmidhuber 2011/2013):
///   (a) MONOTONE: every check that PASSED on the baseline must still pass on the candidate.
///       A regression here is a rejection, not a trade-off.
///   (b) IMPROVEMENT: at least one check that FAILED on the baseline now passes on the candidate.
///   (c) NEUTRAL: identical results -- useful information, not accepted, not rejected.
///
/// Returns PP_ACCEPT, PP_NEUTRAL or PP_REGRESS. PP_BROKEN is never returned by this fn (the
/// caller validates the candidate first; the gate judges checks, not well-formedness).
pub fn pp_gate(base_results: []const u8, cand_results: []const u8) -> u8 {
    if (base_results.len != cand_results.len) { return PP_REGRESS; }
    var improved : bool = false;
    var regressed : bool = false;
    var i : usize = 0;
    while (i < base_results.len) {
        const b : u8 = base_results[i];
        const c : u8 = cand_results[i];
        if (b == PP_PASS and c != PP_PASS) { regressed = true; }
        if (b == PP_FAIL and c == PP_PASS) { improved = true; }
        i = i + 1;
    }
    if (regressed) { return PP_REGRESS; }
    if (improved) { return PP_ACCEPT; }
    return PP_NEUTRAL;
}

/// The improvement count: how many checks the candidate turned from fail to pass.
pub fn pp_improvement_count(base_results: []const u8, cand_results: []const u8) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < base_results.len and i < cand_results.len) {
        if (base_results[i] == PP_FAIL and cand_results[i] == PP_PASS) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The regression count: how many checks the candidate turned from pass to fail.
pub fn pp_regression_count(base_results: []const u8, cand_results: []const u8) -> u32 {
    var n : u32 = 0;
    var i : usize = 0;
    while (i < base_results.len and i < cand_results.len) {
        if (base_results[i] == PP_PASS and cand_results[i] != PP_PASS) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The baseline pass rate in permille (0..1000): the checks that pass / total checks.
/// A caller that has zero checks gets 0 -- never a fabricated 1000.
pub fn pp_pass_rate(results: []const u8) -> u32 {
    if (results.len == 0) { return 0; }
    var passes : u32 = 0;
    var i : usize = 0;
    while (i < results.len) {
        if (results[i] == PP_PASS) { passes = passes + 1; }
        i = i + 1;
    }
    return passes * 1000 / @as(u32, @intCast(results.len));
}

// ---------------------------------------------------------------- tests

test the_gate_accepts_when_the_candidate_improves_without_regressing {
    // baseline: check 0 passes, check 1 fails, check 2 passes
    var base : [3]u8 = undefined;
    var cand : [3]u8 = undefined;
    base[0] = PP_PASS; base[1] = PP_FAIL; base[2] = PP_PASS;
    cand[0] = PP_PASS; cand[1] = PP_PASS; cand[2] = PP_PASS;
    const r : u8 = pp_gate(base[0..3], cand[0..3]);
    assert(r == PP_ACCEPT);
    assert(pp_improvement_count(base[0..3], cand[0..3]) == 1);
    assert(pp_regression_count(base[0..3], cand[0..3]) == 0);
}

test the_gate_rejects_when_the_candidate_regresses {
    // baseline: all pass; candidate: check 0 regressed
    var base : [3]u8 = undefined;
    var cand : [3]u8 = undefined;
    base[0] = PP_PASS; base[1] = PP_PASS; base[2] = PP_PASS;
    cand[0] = PP_PASS; cand[1] = PP_FAIL; cand[2] = PP_PASS;
    const r : u8 = pp_gate(base[0..3], cand[0..3]);
    assert(r == PP_REGRESS);
    // even if the candidate also improved check 2, the regression dominates
    const cand2 : [3]u8 = undefined;
    cand2[0] = PP_PASS; cand2[1] = PP_PASS; cand2[2] = PP_PASS;
    const r2 : u8 = pp_gate(base[0..3], cand2[0..3]);
    assert(r2 == PP_NEUTRAL); // baseline was all-pass: candidate is the same, not better
}

test the_gate_reports_neutral_when_the_candidate_matches_the_baseline {
    var results : [3]u8 = undefined;
    results[0] = PP_PASS; results[1] = PP_FAIL; results[2] = PP_PASS;
    const r : u8 = pp_gate(results[0..3], results[0..3]);
    assert(r == PP_NEUTRAL);
    assert(pp_improvement_count(results[0..3], results[0..3]) == 0);
}

test the_pass_rate_is_zero_for_an_empty_check_set {
    var empty : [0]u8 = undefined;
    assert(pp_pass_rate(empty[0..0]) == 0);
    var some : [3]u8 = undefined;
    some[0] = PP_PASS; some[1] = PP_PASS; some[2] = PP_FAIL;
    assert(pp_pass_rate(some[0..3]) == 666);
}

test the_improvement_and_regression_counts_are_independent {
    var base : [4]u8 = undefined;
    var cand : [4]u8 = undefined;
    base[0] = PP_FAIL; base[1] = PP_PASS; base[2] = PP_FAIL; base[3] = PP_PASS;
    cand[0] = PP_PASS; cand[1] = PP_PASS; cand[2] = PP_FAIL; cand[3] = PP_FAIL;
    const imp : u32 = pp_improvement_count(base[0..4], cand[0..4]);
    const reg : u32 = pp_regression_count(base[0..4], cand[0..4]);
    assert(imp == 1); // check 0 went fail->pass
    assert(reg == 1); // check 3 went pass->fail
    // the gate reports a regression: monotone means no baseline pass may fail
    const r : u8 = pp_gate(base[0..4], cand[0..4]);
    assert(r == PP_REGRESS);
}

test different_length_arrays_are_a_regression {
    var base : [2]u8 = undefined;
    var cand : [1]u8 = undefined;
    base[0] = PP_PASS; base[1] = PP_PASS;
    cand[0] = PP_PASS;
    assert(pp_gate(base[0..2], cand[0..1]) == PP_REGRESS);
}

invariant the_powerplay_codes_are_distinct {
    assert(PP_ACCEPT != PP_NEUTRAL and PP_NEUTRAL != PP_REGRESS and PP_REGRESS != PP_BROKEN);
    assert(PP_PASS != PP_FAIL and PP_FAIL != PP_SKIP);
}
