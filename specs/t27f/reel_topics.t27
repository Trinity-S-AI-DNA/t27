pub const TOPIC_LINE0 : [28]u16 = [
0, 7, 12, 17, 24, 33, 43, 51, 63, 78, 84, 99, 110, 126, 147, 166, 173, 186, 200, 206, 213, 222, 230, 238, 247, 252, 264, 272
];

// Where text item i is in TEXT_CP, and how long it is.
pub fn item(t: usize, lang: usize, f: usize) -> usize {
    return (t * LANGS + lang) * FIELDS + f;
}
pub fn id_item(t: usize) -> usize {
    return ID_ITEM0 + t;
}
pub fn course_title_item(lang: usize) -> usize {
    return COURSE_ITEM0 + lang * 2;
}
pub fn lesson_of_item(lang: usize) -> usize {
    return COURSE_ITEM0 + lang * 2 + 1;
}
pub fn item_len(i: usize) -> usize {
    return @as(usize, ITEM_LEN[i]);
}
// Code point k of item i.
pub fn cp(i: usize, k: usize) -> u32 {
    return @as(u32, TEXT_CP[@as(usize, ITEM_START[i]) + k]);
}

// The code of lesson t: its first line and how many lines it has, and byte k of line l.
pub fn code_line0(t: usize) -> usize {
    return @as(usize, TOPIC_LINE0[t]);
}
pub fn code_lines(t: usize) -> usize {
    return @as(usize, TOPIC_LINE0[t + 1]) - @as(usize, TOPIC_LINE0[t]);
}
pub fn line_len(l: usize) -> usize {
    return @as(usize, LINE_START[l + 1]) - @as(usize, LINE_START[l]);
}
pub fn code_byte(l: usize, k: usize) -> u8 {
    return CODE[@as(usize, LINE_START[l]) + k];
}
// The lesson's number in its course, 1-based, and its module on the course map, 0-based.
pub fn lesson_n(t: usize) -> usize {
    return t + 1;
}
pub fn module_of(t: usize) -> usize {
    return t / MODULE_LESSONS;
}

// A letter the reel fonts draw: printable ASCII, or the Cyrillic block A..ya plus yo.
fn drawable(c: u32) -> bool {
    return (c >= 32 && c <= 126) || (c >= 1040 && c <= 1105);
}
fn spells(i: usize, k: usize, c0: u32, c1: u32, c2: u32) -> bool {
    return cp(i, k) == c0 && cp(i, k + 1) == c1 && cp(i, k + 2) == c2;
}

test "the item table tiles TEXT_CP with no gap and no overlap" {
    var i : usize = 0;
    while (i + 1 < ITEMS) {
        assert(@as(usize, ITEM_START[i]) + item_len(i) == @as(usize, ITEM_START[i + 1]));
        i = i + 1;
    }
    assert(@as(usize, ITEM_START[ITEMS - 1]) + item_len(ITEMS - 1) == TEXT_CPS);
    assert(ITEM_START[0] == 0);
    assert(COURSE_ITEM0 + 4 == ITEMS);
    assert(ID_ITEM0 == TOPICS * LANGS * FIELDS);
    assert(COURSE_ITEM0 == ID_ITEM0 + TOPICS);
}

test "every lesson has a title, a goal and a task in both languages" {
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < LANGS) {
            assert(item_len(item(t, lang, 0)) >= 4);
            assert(item_len(item(t, lang, 1)) >= 20);
            assert(item_len(item(t, lang, 2)) >= 20);
            lang = lang + 1;
        }
        assert(item_len(id_item(t)) >= 4);
        t = t + 1;
    }
}

test "every code point is one the reel fonts draw" {
    var k : usize = 0;
    while (k < TEXT_CPS) {
        assert(drawable(@as(u32, TEXT_CP[k])));
        k = k + 1;
    }
    var b : usize = 0;
    while (b < CODE_BYTES) {
        assert(CODE[b] >= 32 && CODE[b] <= 126);
        b = b + 1;
    }
}

test "the Russian items are Russian and the English ones are not" {
    // RU title of lesson 0 opens with Che (1063); EN title opens with W (87).
    assert(cp(item(0, 1, 0), 0) == 1063);
    assert(cp(item(0, 0, 0), 0) == 87);
    var t : usize = 0;
    while (t < TOPICS) {
        var cyr : usize = 0;
        var k : usize = 0;
        const ru = item(t, 1, 1);
        while (k < item_len(ru)) {
            if (cp(ru, k) >= 1040) {
                cyr = cyr + 1;
            }
            k = k + 1;
        }
        assert(cyr * 2 > item_len(ru));
        var j : usize = 0;
        const en = item(t, 0, 1);
        while (j < item_len(en)) {
            assert(cp(en, j) < 128);
            j = j + 1;
        }
        t = t + 1;
    }
}

test "the course strings carry the two holes the generator fills" {
    // "Lesson {0} of {1}" and its Russian; '{' is 123, '0' is 48, '}' is 125.
    var lang : usize = 0;
    while (lang < LANGS) {
        const i = lesson_of_item(lang);
        var holes : usize = 0;
        var k : usize = 0;
        while (k + 2 < item_len(i)) {
            if (cp(i, k) == 123 && cp(i, k + 2) == 125) {
                holes = holes + 1;
            }
            k = k + 1;
        }
        assert(holes == 2);
        assert(item_len(course_title_item(lang)) > 20);
        lang = lang + 1;
    }
}

test "the code table tiles CODE, and every lesson's code opens with its module line" {
    assert(LINE_START[0] == 0);
    assert(@as(usize, LINE_START[CODE_LINES]) == CODE_BYTES);
    assert(TOPIC_LINE0[0] == 0);
    assert(@as(usize, TOPIC_LINE0[TOPICS]) == CODE_LINES);
    var t : usize = 0;
    while (t < TOPICS) {
        assert(code_lines(t) >= 3);
        const l = code_line0(t);
        // "module basics_"
        assert(code_byte(l, 0) == 109 && code_byte(l, 1) == 111 && code_byte(l, 6) == 32);
        assert(code_byte(l, 7) == 98 && code_byte(l, 13) == 95);
        t = t + 1;
    }
    var l : usize = 0;
    while (l < CODE_LINES) {
        assert(line_len(l) >= 1 && line_len(l) <= 84);
        l = l + 1;
    }
}

test "lesson 0 is What a spec is, and its id is its page" {
    // "Wha", "spe" in the title; the id what-a-spec-is is 14 letters.
    assert(spells(item(0, 0, 0), 0, 87, 104, 97));
    assert(spells(item(0, 0, 0), 7, 115, 112, 101));
    assert(item_len(id_item(0)) == 14);
    assert(cp(id_item(0), 4) == 45);
    assert(lesson_n(26) == 27);
    assert(module_of(26) == 8);
    assert(module_of(3) == 1);
}
