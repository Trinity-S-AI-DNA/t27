// SPDX-License-Identifier: Apache-2.0
; T27F UI history, step 04: the 600 / 640 breakpoint seam stays pinned, recorded with frames at the four seam widths (Refs gHashTag/t27#13214, epic #13214)
; The typed record of docs/reports/ui-history/2026-11-07/step-04-breakpoint-seam-pinned/ (the frames live there; MANIFEST.md there is a reading
;   copy of this file and holds no field of its own). Shape and rules: ui_history. The log (ui_history_log) lists this step after step 03
;   (ui_history_s03), which stays as filed: this step is a new record, never an edit of an earlier one
; This step changes no value and no pixel. vf_theme splits widths at 600 and vf_layout at 640 and vf_ring1 already pins that disagreement as
;   numbers; the owner's order is that the seam stays pinned. What this step adds is the history entry and a measurement: whether the task card
;   reads the seam at all. BEFORE and AFTER are therefore the same behaviour, one binary run twice, and the changed list says so
; Paths are relative to the step folder. The measured facts are the ones a byte comparison, a test or a source search backs; nothing here says
;   the card looks better, and visual_review is PENDING_OWNER until the owner has opened the frames and said so in chat
; ASCII only (L3)

module T27fUiHistoryS04;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;

pub const US4_SEQ : u32 = 4;
pub const US4_ID : str = "ui-2026-11-07-step-04";
pub const US4_FOLDER : str = "docs/reports/ui-history/2026-11-07/step-04-breakpoint-seam-pinned";

const US4_BEFORE : [12]str = [
    "01-before/before_599_p100_t0.png",
    "01-before/before_600_p100_t0.png",
    "01-before/before_639_p100_t0.png",
    "01-before/before_640_p100_t0.png",
    "", "", "", "", "", "", "", "",
];

const US4_AFTER : [12]str = [
    "02-after/after_599_p100_t0.png",
    "02-after/after_600_p100_t0.png",
    "02-after/after_639_p100_t0.png",
    "02-after/after_640_p100_t0.png",
    "", "", "", "", "", "", "", "",
];

const US4_DIFF : [12]str = [
    "03-diff/cmp_599_p100_t0.png",
    "03-diff/cmp_600_p100_t0.png",
    "03-diff/cmp_639_p100_t0.png",
    "03-diff/cmp_640_p100_t0.png",
    "", "", "", "", "", "", "", "",
];

const US4_TOK_NAMES : [12]str = [
    "breakpoint.seam_600_640",
    "breakpoint.card_dependency",
    "", "", "", "", "", "", "", "", "", "",
];

const US4_TOK_BEFORE : [12]str = [
    "600 in vf_theme (phone up to 600) and 640 in vf_layout (small below 640), pinned only as numbers in the vf_ring1 tests and absent from the UI history",
    "not recorded whether the task card reads either width class",
    "", "", "", "", "", "", "", "", "", "",
];

const US4_TOK_AFTER : [12]str = [
    "600 and 640 unchanged and still pinned; the seam (601 to 639 and exactly 1024, 40 widths in 1 to 2000) is now a history step with frames at 599, 600, 639 and 640",
    "measured by source search and by frames: the card graph sets no per-breakpoint direction, the painter specs name neither th_bp nor vf_breakpoint, and the interior rectangles are equal at the four widths",
    "", "", "", "", "", "", "", "", "", "",
];

const US4_MEASURED : [12]str = [
    "two renders per width by the same binary (built from 853db3e75b; the commits since add docs and history specs only) are byte-identical at 599, 600, 639 and 640 wide (md5 equal, 0 differing pixels): the renderer is deterministic and this step moves no pixel",
    "rectangles, equal at all four widths: title 16,16 80x20; badge 16,52 48x24; field stack 16,92 160x66; owner label 16,92 80x20; input 16,118 160x40; actions stack 16,174 202x40; Save 16,174 96x40; Cancel 122,174 96x40; only the root card changes, and it is as wide as the viewport (599, 600, 639, 640 by 230)",
    "the seam as vf_ring1 pins it: the theme and the layout answer a different class at 601 to 639 (39 widths) and at 1024, 40 widths in 1 to 2000 and none outside; the three preview widths 375, 768 and 1280 agree",
    "source search: direction_md, BP_MD and DIR_INHERIT occur in none of vf_card, vf_card_tok, vf_storybook and vf_card_main, and th_bp and vf_breakpoint occur in none of vf_card, vf_card_tok, vf_storybook, vf_card_main, vf_render and vf_scale, so the seam is not read by the task card",
    "", "", "", "", "", "", "", "",
];

const US4_LIMITS : [12]str = [
    "no person has looked at any frame in this step; nothing here claims the card looks better, and byte-identical rasters are not evidence of visual quality",
    "BEFORE and AFTER are one binary run twice: the step proves determinism and no change, not a decision; whether the breakpoint is 600 or 640 stays the owner's pick and stays pinned",
    "the root card is as wide as the viewport at 599 to 640 although layout.card.max_inline resolves to 560; that was measured and is not changed here",
    "the seam is read through the task card and the five-node sample graph of vf_ring1; another graph may read the class and may show a difference",
    "widths 768 and 1280 are not expanded before the token scale is reconciled with vf_proportion",
    "", "", "", "", "", "", "",
];

pub fn us4_step() -> UiStep {
    var st : UiStep = UiStep {
        seq: US4_SEQ,
        step_id: US4_ID,
        date: "2026-11-07",
        commit: "the commit that adds this record (BEFORE and AFTER frames are the 853db3e75b behaviour, one binary run twice)",
        branch: "claude/t27f-007-outfit-type",
        theme: "t0 black",
        viewport: "599, 600, 639 and 640 (the four widths around the 600 and 640 breakpoints)",
        scale: "100 percent",
        before_n: 4,
        before_paths: US4_BEFORE,
        after_n: 4,
        after_paths: US4_AFTER,
        diff_n: 4,
        diff_paths: US4_DIFF,
        token_n: 2,
        token_names: US4_TOK_NAMES,
        token_before: US4_TOK_BEFORE,
        token_after: US4_TOK_AFTER,
        intended_change: "No value changes. The 600 breakpoint of vf_theme and the 640 breakpoint of vf_layout stay pinned, as the owner ordered. This step records the seam as a history step with frames at 599, 600, 639 and 640, and measures whether the task card reads it. BEFORE and AFTER are the same behaviour on purpose, so the DIFF is empty. Whether the seam should be closed, and at which width, is the owner's call.",
        measured_n: 4,
        measured: US4_MEASURED,
        limit_n: 5,
        limits: US4_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test step_four_holds_every_rule_of_the_schema {
    let st : UiStep = us4_step();
    assert uh_validate(st) == UH_OK;
}

test step_four_is_pinned_as_filed {
    let st : UiStep = us4_step();
    assert st.seq == 4;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    assert st.before_n == 4;
    assert st.after_n == 4;
    assert st.diff_n == 4;
    assert st.token_n == 2;
    assert st.measured_n == 4;
    assert st.limit_n == 5;
}

test step_four_names_its_folder_branch_and_seam {
    let st : UiStep = us4_step();
    let id : str = st.step_id;
    let want : str = US4_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-04";
    let folder : str = US4_FOLDER;
    assert folder == "docs/reports/ui-history/2026-11-07/step-04-breakpoint-seam-pinned";
    let br : str = st.branch;
    assert br == "claude/t27f-007-outfit-type";
    let names : [12]str = st.token_names;
    let seam : str = names[0];
    assert seam == "breakpoint.seam_600_640";
}
