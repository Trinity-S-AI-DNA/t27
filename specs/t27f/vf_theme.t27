// SPDX-License-Identifier: Apache-2.0
; vf_theme is the token table of the visual factory: fill, outline and label colour per theme and kind, gap and padding per theme
; Refs Trinity-S-AI-DNA/t27#13251 (graph-first UI engine, ring 4 groundwork)
; Theme ids are THEME_LIGHT, THEME_DARK and THEME_HIGH_CONTRAST from specs/t27f/ui_plan.t27, used here and never redefined
; Kind ids are the nine kinds of specs/t27f/visual_factory_contract.t27: none, container, stack, text, button, input, card, badge, list
; Nothing reads this table yet: vf_pixel and vf_render still paint from VF_PALETTE, VF_R_BORDER and VF_R_TEXT_LIGHT
; The light row is those constants, copied as literals and pinned to them by a test, so wiring this table in later changes 0 pixels
; Gap and padding: vf_layout has no named gap or padding constant, both are per-node VfGraph fields (default 0)
; The light gap and pad are the 8 px the task card story sets (specs/t27f/stories/task_card.t27), pinned to that graph by a test
; Readability is the W3C AERT colour-visibility rule, NOT the WCAG 2 contrast ratio: no claim about WCAG is made here
; AERT: brightness = (299 R + 587 G + 114 B) / 1000, brightness difference >= 125, colour difference |dR| + |dG| + |dB| >= 500
; Brightness is kept in thousandths (299 R + 587 G + 114 B, white = 255000) so the 125 floor is exact, with no rounding
; Finding for the owner: the light button (white label on 0x1565C0) FAILS AERT on colour difference, 451 < 500
; Its brightness difference is 167546 / 1000, which passes; light text and light badge pass; light is not changed here
; Tables are flat [27]u32, index = theme * 9 + kind; an out-of-range theme reads light, an out-of-range kind reads none
; All arithmetic is u32 and non-negative: compare before subtracting

module VfTheme;
use t27f::ui_plan::THEME_LIGHT;
use t27f::ui_plan::THEME_DARK;
use t27f::ui_plan::THEME_HIGH_CONTRAST;
use t27f::ui_plan::THEME_KINDS;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NONE;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_KINDS;
use t27f::vf_pixel::VF_PALETTE;
use t27f::vf_render::VF_R_BORDER;
use t27f::vf_render::VF_R_TEXT_LIGHT;
use t27f::stories::task_card::task_card_graph;

; fill 0xRRGGBB, rows light, dark, high contrast; columns none, container, stack, text, button, input, card, badge, list
pub const VF_TH_FILL : [27]u32 = [
    0xFFFFFF, 0xFAFAFA, 0xFAFAFA, 0x222222, 0x1565C0, 0xEEEEEE, 0xF5F5F5, 0x2E7D32, 0xFAFAFA,
    0x121212, 0x1E1E1E, 0x1E1E1E, 0x000000, 0x0D47A1, 0x2C2C2C, 0x242424, 0x1B5E20, 0x1E1E1E,
    0x000000, 0x000000, 0x000000, 0x000000, 0xFFFFFF, 0x000000, 0x000000, 0xFFFF00, 0x000000
];

; outline 0xRRGGBB, same layout: light is VF_R_BORDER 0x444444 for every kind
pub const VF_TH_OUTLINE : [27]u32 = [
    0x444444, 0x444444, 0x444444, 0x444444, 0x444444, 0x444444, 0x444444, 0x444444, 0x444444,
    0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E, 0x9E9E9E,
    0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00, 0xFFFF00
];

; label 0xRRGGBB, same layout: light is VF_R_TEXT_LIGHT 0xFFFFFF for every kind; high contrast puts black on its white button and yellow badge
pub const VF_TH_LABEL : [27]u32 = [
    0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF,
    0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF,
    0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0xFFFFFF, 0x000000, 0xFFFFFF, 0xFFFFFF, 0x000000, 0xFFFFFF
];

; gap and padding in px by theme: light, dark, high contrast
pub const VF_TH_GAP : [3]u32 = [8, 8, 12];
pub const VF_TH_PAD : [3]u32 = [8, 8, 12];

; the theme row, light when t is not a theme id
pub fn vf_th_row(t: u8) -> u32 {
    var ti : u32 = t as u32;
    if ti >= (THEME_KINDS as u32) {
        ti = THEME_LIGHT as u32;
    }
    return ti;
}

; the table index theme * 9 + kind, kind none when k is not a kind id
pub fn vf_th_at(t: u8, k: u8) -> u32 {
    var ki : u32 = k as u32;
    if ki >= (VF_KINDS as u32) {
        ki = VF_NONE as u32;
    }
    return vf_th_row(t) * (VF_KINDS as u32) + ki;
}

pub fn vf_fill(t: u8, k: u8) -> u32 {
    return VF_TH_FILL[vf_th_at(t, k)];
}

pub fn vf_outline(t: u8, k: u8) -> u32 {
    return VF_TH_OUTLINE[vf_th_at(t, k)];
}

pub fn vf_label(t: u8, k: u8) -> u32 {
    return VF_TH_LABEL[vf_th_at(t, k)];
}

pub fn vf_gap(t: u8) -> u32 {
    return VF_TH_GAP[vf_th_row(t)];
}

pub fn vf_pad(t: u8) -> u32 {
    return VF_TH_PAD[vf_th_row(t)];
}

; AERT brightness in thousandths: 299 R + 587 G + 114 B, black 0, white 255000
pub fn vf_aert_brightness_milli(c: u32) -> u32 {
    return 299 * ((c >> 16) & 255) + 587 * ((c >> 8) & 255) + 114 * (c & 255);
}

; AERT brightness difference in thousandths, never negative
pub fn vf_aert_brightness_diff_milli(fg: u32, bg: u32) -> u32 {
    let bf : u32 = vf_aert_brightness_milli(fg);
    let bb : u32 = vf_aert_brightness_milli(bg);
    if bf >= bb {
        return bf - bb;
    }
    return bb - bf;
}

; AERT colour difference |dR| + |dG| + |dB|, 0 to 765
pub fn vf_aert_colour_diff(fg: u32, bg: u32) -> u32 {
    var sum : u32 = 0;
    var sh : u32 = 0;
    while sh <= 16 {
        let a : u32 = (fg >> sh) & 255;
        let b : u32 = (bg >> sh) & 255;
        if a >= b {
            sum = sum + (a - b);
        } else {
            sum = sum + (b - a);
        }
        sh = sh + 8;
    }
    return sum;
}

; W3C AERT colour visibility, not WCAG 2: brightness difference >= 125 and colour difference >= 500
pub fn vf_aert_ok(fg: u32, bg: u32) -> bool {
    if vf_aert_brightness_diff_milli(fg, bg) < 125000 {
        return false;
    }
    return vf_aert_colour_diff(fg, bg) >= 500;
}

test light_equals_the_palette_the_renderer_draws {
    var k : u8 = 0;
    while k < VF_KINDS {
        assert vf_fill(THEME_LIGHT, k) == VF_PALETTE[k as u32];
        assert vf_outline(THEME_LIGHT, k) == VF_R_BORDER;
        assert vf_label(THEME_LIGHT, k) == VF_R_TEXT_LIGHT;
        k = k + 1;
    }
    let g : VfGraph = task_card_graph();
    assert vf_gap(THEME_LIGHT) == g.gap[0];
    assert vf_gap(THEME_LIGHT) == g.gap[5];
    assert vf_pad(THEME_LIGHT) == g.padding[0];
}

test every_label_passes_aert_on_its_fill {
    // every theme x labelled kind passes, except the one light pair named below
    assert vf_aert_ok(vf_label(THEME_LIGHT, VF_TEXT), vf_fill(THEME_LIGHT, VF_TEXT)) == true;
    assert vf_aert_ok(vf_label(THEME_LIGHT, VF_BADGE), vf_fill(THEME_LIGHT, VF_BADGE)) == true;
    assert vf_aert_ok(vf_label(THEME_DARK, VF_TEXT), vf_fill(THEME_DARK, VF_TEXT)) == true;
    assert vf_aert_ok(vf_label(THEME_DARK, VF_BUTTON), vf_fill(THEME_DARK, VF_BUTTON)) == true;
    assert vf_aert_ok(vf_label(THEME_DARK, VF_BADGE), vf_fill(THEME_DARK, VF_BADGE)) == true;
    assert vf_aert_ok(vf_label(THEME_HIGH_CONTRAST, VF_TEXT), vf_fill(THEME_HIGH_CONTRAST, VF_TEXT)) == true;
    assert vf_aert_ok(vf_label(THEME_HIGH_CONTRAST, VF_BUTTON), vf_fill(THEME_HIGH_CONTRAST, VF_BUTTON)) == true;
    assert vf_aert_ok(vf_label(THEME_HIGH_CONTRAST, VF_BADGE), vf_fill(THEME_HIGH_CONTRAST, VF_BADGE)) == true;
    // finding, light is not changed here: white on the light button 0x1565C0 fails colour difference, 451 < 500
    let fg : u32 = vf_label(THEME_LIGHT, VF_BUTTON);
    let bg : u32 = vf_fill(THEME_LIGHT, VF_BUTTON);
    assert vf_aert_brightness_diff_milli(fg, bg) == 167546;
    assert vf_aert_colour_diff(fg, bg) == 451;
    assert vf_aert_ok(fg, bg) == false;
}

test dark_differs_from_light {
    assert vf_fill(THEME_DARK, VF_TEXT) != vf_fill(THEME_LIGHT, VF_TEXT);
    assert vf_fill(THEME_DARK, VF_BUTTON) != vf_fill(THEME_LIGHT, VF_BUTTON);
    assert vf_fill(THEME_DARK, VF_BADGE) != vf_fill(THEME_LIGHT, VF_BADGE);
}

test nc_a_label_equal_to_its_fill_fails {
    var k : u8 = 0;
    while k < VF_KINDS {
        let c : u32 = vf_fill(THEME_LIGHT, k);
        assert vf_aert_ok(c, c) == false;
        k = k + 1;
    }
    assert vf_aert_ok(0x000000, 0x000000) == false;
    assert vf_aert_ok(0xFFFFFF, 0xFFFFFF) == false;
    assert vf_aert_ok(0xFFFFFF, 0x000000) == true;
}
