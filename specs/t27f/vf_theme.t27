// SPDX-License-Identifier: Apache-2.0
; T27F-007 ring 4: vf_theme holds the design tokens of the visual factory and a resolver, colour, font, spacing, radius and nothing else
; Refs gHashTag/t27#13214
; Pipeline the owner ordered: object graph -> meaning -> layout -> THEME -> render, so swapping a theme changes tokens only
; Tokens are facts copied from the live CSS of https://t27.ai/#/course read on 2026-11-07, not a claim about visual correctness
; The paper theme is our own light swap, it is not on that page
; Reads the VF_* node kind ids from specs/t27f/visual_factory_contract.t27 and never edits it
; Limits: no theme inheritance, no alpha, no contrast search, no font metrics; the type and space scales take no theme on purpose
; All arithmetic is u32 and non-negative: compare before subtracting; rem x 1000 means 0.8125 rem is stored as 812
; Second scale, open seam: TH_FONT_REM, TH_SPACE_REM and TH_PAD_CARD (20, 12, 16 for the three paddings) here, and TH_CARD_INSET and TH_CARD_MAX_W,
; are a second set of numbers next to the bounded semantic tokens of vf_tokens (vf_proportion generates them). The task card takes its padding,
; gaps, type sizes and width from vf_tokens through vf_card_tok; the theme values stay the defaults of vc_render_state and are pinned against
; the tokens in vf_card_tok, not unified

module t27f_vf_theme;
use t27f::visual_factory_contract::VF_NONE;
use t27f::visual_factory_contract::VF_CONTAINER;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_LIST;
use t27f::visual_factory_contract::VF_UNKNOWN;

; themes: the site (black) and our own light swap
pub const TH_T27 : u32 = 0;
pub const TH_PAPER : u32 = 1;
pub const TH_THEMES : u32 = 2;

; colour roles, the index into both rgb tables
pub const TH_BG : u32 = 0;
pub const TH_TEXT : u32 = 1;
pub const TH_MUTED : u32 = 2;
pub const TH_ACCENT : u32 = 3;
pub const TH_ACCENT_DARK : u32 = 4;
pub const TH_GOLD : u32 = 5;
pub const TH_BORDER : u32 = 6;
pub const TH_CARD_BORDER : u32 = 7;
pub const TH_CARD_BORDER_HOVER : u32 = 8;
pub const TH_CARD_DESC : u32 = 9;
pub const TH_CARD_FOOT : u32 = 10;
pub const TH_ROLES : u32 = 11;

; magenta: the unmistakable error colour for an unknown theme or role
pub const TH_ERROR_RGB : u32 = 0xFF00FF;

; site theme as read from the page; BORDER is white at 8 percent over black
pub const TH_RGB_T27 : [11]u32 = [0x000000, 0xFFFFFF, 0x888888, 0x00FF88, 0x00CC66, 0xFFD700, 0x141414, 0x333333, 0xFFFFFF, 0xA6A6A6, 0x8A8A8A];

; paper theme, our own swap: same roles, light ground
pub const TH_RGB_PAPER : [11]u32 = [0xFFFFFF, 0x000000, 0x666666, 0x00A35C, 0x007A45, 0xB38F00, 0xEBEBEB, 0xCCCCCC, 0x000000, 0x4D4D4D, 0x666666];

; type scale, golden ratio, rem x 1000 (rem = 16 px), steps 0..9 = f-3 f-2 f-1 f0 f1 f2 f3 f4 f5 f6
; 0.8125 rem is stored as 812
pub const TH_FONT_STEPS : u32 = 10;
pub const TH_FONT_REM : [10]u32 = [750, 812, 875, 1000, 1272, 1618, 2058, 2618, 4236, 6854];

; space scale, rem x 1000, steps 0..6 = sp-1 sp0 sp1 sp2 sp3 sp4 sp5
pub const TH_SPACE_STEPS : u32 = 7;
pub const TH_SPACE_REM : [7]u32 = [382, 618, 1000, 1618, 2618, 4236, 6854];

pub const TH_REM_PX : u32 = 16;

; fixed sizes in px
pub const TH_RADIUS_CARD : u32 = 12;
pub const TH_PAD_CARD : u32 = 20;
pub const TH_GAP_CARD : u32 = 10;
pub const TH_GAP_CATALOG : u32 = 16;
pub const TH_TITLE_PX : u32 = 22;
pub const TH_MAX_W : u32 = 1200;
pub const TH_NARROW_W : u32 = 680;
pub const TH_TOUCH_MIN : u32 = 44;

; task-card layout decisions of T27F-007 (owner review of the 375 frame), design px: they are choices of vf_card, not site CSS facts
;   TH_CARD_INSET: the first ink row and the left ink edge of a card's text start at least this far inside the card edge
;   TH_CARD_MAX_W: a card is at most this wide, a wider viewport centres it
;   TH_FOCUS_W: the width of the focus ring, one px wider than the 1 px outline it replaces
;   TH_CAP_MILLI: cap height of Outfit in thousandths of the type size, used to place a baseline. ASSUMED at 0.7 em, not measured from the glyph data
pub const TH_CARD_INSET : u32 = 12;
pub const TH_CARD_MAX_W : u32 = 480;
pub const TH_FOCUS_W : u32 = 2;
pub const TH_CAP_MILLI : u32 = 700;

; breakpoints: phone up to 600, tablet up to 1024, desktop up to 1600 and wider is still desktop
pub const TH_BP_PHONE : u32 = 0;
pub const TH_BP_TABLET : u32 = 1;
pub const TH_BP_DESKTOP : u32 = 2;
pub const TH_BP_PHONE_MAX : u32 = 600;
pub const TH_BP_TABLET_MAX : u32 = 1024;
pub const TH_BP_DESKTOP_MAX : u32 = 1600;

; font families: ids, names, and the weights the page loads
pub const TH_FONT_DISPLAY : u32 = 0;
pub const TH_FONT_MONO : u32 = 1;
pub const TH_FONT_FAMILIES : u32 = 2;
pub const TH_FONT_NAMES : [2]str = ["Outfit", "JetBrains Mono"];
pub const TH_FONT_W_LO : [2]u32 = [400, 400];
pub const TH_FONT_W_HI : [2]u32 = [800, 500];

; body size is clamp(0.95 rem, 1.2 vw, 1.05 rem) in milli-px: 15200 .. 16800, one vw step is 12 milli-px
pub const TH_BODY_MIN : u32 = 15200;
pub const TH_BODY_MAX : u32 = 16800;
pub const TH_BODY_VW : u32 = 12;

pub fn th_color(theme: u32, role: u32) -> u32 {
    if role >= TH_ROLES {
        return TH_ERROR_RGB;
    }
    if theme == TH_T27 {
        return TH_RGB_T27[role];
    }
    if theme == TH_PAPER {
        return TH_RGB_PAPER[role];
    }
    return TH_ERROR_RGB;
}

pub fn th_kind_role(kind: u32) -> u32 {
    if kind == VF_TEXT as u32 {
        return TH_TEXT;
    }
    if kind == VF_BUTTON as u32 {
        return TH_ACCENT;
    }
    if kind == VF_INPUT as u32 {
        return TH_CARD_BORDER;
    }
    if kind == VF_CARD as u32 {
        return TH_BORDER;
    }
    if kind == VF_BADGE as u32 {
        return TH_GOLD;
    }
    if kind == VF_CONTAINER as u32 {
        return TH_BG;
    }
    if kind == VF_STACK as u32 {
        return TH_BG;
    }
    if kind == VF_LIST as u32 {
        return TH_BG;
    }
    return TH_MUTED;
}

pub fn th_kind_color(theme: u32, kind: u32) -> u32 {
    return th_color(theme, th_kind_role(kind));
}

pub fn th_font_name(id: u32) -> str {
    if id >= TH_FONT_FAMILIES {
        return "";
    }
    return TH_FONT_NAMES[id];
}

// the scales below take no theme: swapping the theme must not move a single pixel of geometry
pub fn th_font_milli_px(step: u32) -> u32 {
    if step >= TH_FONT_STEPS {
        return 0;
    }
    return TH_FONT_REM[step] * TH_REM_PX;
}

pub fn th_space_milli_px(step: u32) -> u32 {
    var px : u32 = 0;
    if step < TH_SPACE_STEPS {
        px = TH_SPACE_REM[step] * TH_REM_PX;
    }
    return px;
}

pub fn th_font_px(step: u32) -> u32 {
    return (th_font_milli_px(step) + 500) / 1000;
}

pub fn th_bp(w: u32) -> u32 {
    if w <= TH_BP_PHONE_MAX {
        return TH_BP_PHONE;
    }
    if w <= TH_BP_TABLET_MAX {
        return TH_BP_TABLET;
    }
    return TH_BP_DESKTOP;
}

pub fn th_body_milli_px(w: u32) -> u32 {
    // at or past 1400 px the clamp is already at its top; this also keeps w * 12 from overflowing
    if w >= TH_BODY_MAX / TH_BODY_VW {
        return TH_BODY_MAX;
    }
    var v : u32 = w * TH_BODY_VW;
    if v < TH_BODY_MIN {
        return TH_BODY_MIN;
    }
    return v;
}

pub fn th_luma(rgb: u32) -> u32 {
    var r : u32 = rgb / 65536;
    var g : u32 = (rgb / 256) % 256;
    var b : u32 = rgb % 256;
    return (r * 299 + g * 587 + b * 114) / 1000;
}

pub fn th_luma_gap(a: u32, b: u32) -> u32 {
    var la : u32 = th_luma(a);
    var lb : u32 = th_luma(b);
    if la >= lb {
        return la - lb;
    }
    return lb - la;
}

test site_colours {
    assert th_color(TH_T27, TH_BG) == 0x000000;
    assert th_color(TH_T27, TH_TEXT) == 0xFFFFFF;
    assert th_color(TH_T27, TH_MUTED) == 0x888888;
    assert th_color(TH_T27, TH_ACCENT) == 0x00FF88;
    assert th_color(TH_T27, TH_ACCENT_DARK) == 0x00CC66;
    assert th_color(TH_T27, TH_GOLD) == 0xFFD700;
    assert th_color(TH_T27, TH_BORDER) == 0x141414;
    assert th_color(TH_T27, TH_CARD_BORDER) == 0x333333;
    assert th_color(TH_T27, TH_CARD_BORDER_HOVER) == 0xFFFFFF;
    assert th_color(TH_T27, TH_CARD_DESC) == 0xA6A6A6;
    assert th_color(TH_T27, TH_CARD_FOOT) == 0x8A8A8A;
}

test paper_swap {
    assert th_color(TH_PAPER, TH_BG) == 0xFFFFFF;
    assert th_color(TH_PAPER, TH_TEXT) == 0x000000;
    assert th_color(TH_PAPER, TH_ACCENT) == 0x00A35C;
    assert th_color(TH_T27, TH_BG) != th_color(TH_PAPER, TH_BG);
    assert th_color(TH_T27, TH_TEXT) != th_color(TH_PAPER, TH_TEXT);
    // the geometry functions take no theme, that is the point: the same answers whichever theme was asked
    var theme : u32 = 0;
    while theme < TH_THEMES {
        var role : u32 = 0;
        while role < TH_ROLES {
            assert th_color(theme, role) != TH_ERROR_RGB;
            role = role + 1;
        }
        assert th_font_milli_px(4) == 20352;
        assert th_space_milli_px(3) == 25888;
        assert th_bp(768) == 1;
        theme = theme + 1;
    }
}

test type_scale {
    assert th_font_milli_px(0) == 12000;
    assert th_font_milli_px(3) == 16000;
    assert th_font_milli_px(4) == 20352;
    assert th_font_milli_px(9) == 109664;
    assert th_font_milli_px(10) == 0;
    assert th_font_px(4) == 20;
    assert th_font_px(9) == 110;
    // golden check: 1272 * 1272 = 1617984 against 1618 * 1000 = 1618000, compare before subtracting
    var f1 : u32 = TH_FONT_REM[4];
    var f2 : u32 = TH_FONT_REM[5];
    var sq : u32 = f1 * f1;
    var want : u32 = f2 * 1000;
    var gap : u32 = 0;
    if sq >= want {
        gap = sq - want;
    } else {
        gap = want - sq;
    }
    assert gap == 16;
    assert gap * 1000 <= want;
    // and once more a whole step up: 1618 * 1618 = 2617924 against 2618 * 1000
    var sq2 : u32 = f2 * f2;
    var want2 : u32 = TH_FONT_REM[7] * 1000;
    var gap2 : u32 = 0;
    if sq2 >= want2 {
        gap2 = sq2 - want2;
    } else {
        gap2 = want2 - sq2;
    }
    assert gap2 == 76;
    assert gap2 * 1000 <= want2;
}

test space_scale {
    assert th_space_milli_px(0) == 6112;
    assert th_space_milli_px(2) == 16000;
    assert th_space_milli_px(6) == 109664;
    assert th_space_milli_px(7) == 0;
}

test breakpoints {
    assert th_bp(375) == 0;
    assert th_bp(600) == 0;
    assert th_bp(601) == 1;
    assert th_bp(768) == 1;
    assert th_bp(1024) == 1;
    assert th_bp(1025) == 2;
    assert th_bp(1280) == 2;
    assert th_bp(1600) == 2;
    assert th_bp(1920) == 2;
}

test body_clamp {
    assert th_body_milli_px(375) == 15200;
    assert th_body_milli_px(768) == 15200;
    assert th_body_milli_px(1266) == 15200;
    assert th_body_milli_px(1267) == 15204;
    assert th_body_milli_px(1280) == 15360;
    assert th_body_milli_px(1399) == 16788;
    assert th_body_milli_px(1400) == 16800;
    assert th_body_milli_px(1600) == 16800;
    assert th_body_milli_px(1920) == 16800;
}

test kind_roles {
    assert th_kind_color(TH_T27, VF_BUTTON as u32) == 0x00FF88;
    assert th_kind_color(TH_T27, VF_TEXT as u32) == 0xFFFFFF;
    assert th_kind_color(TH_T27, VF_BADGE as u32) == 0xFFD700;
    assert th_kind_color(TH_T27, VF_CONTAINER as u32) == 0x000000;
    assert th_kind_color(TH_T27, VF_STACK as u32) == 0x000000;
    assert th_kind_color(TH_T27, VF_LIST as u32) == 0x000000;
    assert th_kind_color(TH_T27, VF_CARD as u32) == 0x141414;
    assert th_kind_color(TH_T27, VF_INPUT as u32) == 0x333333;
    assert th_kind_color(TH_T27, VF_NONE as u32) == 0x888888;
    assert th_kind_color(TH_T27, VF_UNKNOWN as u32) == 0x888888;
    assert th_kind_color(TH_PAPER, VF_TEXT as u32) == 0x000000;
    assert th_kind_color(TH_PAPER, VF_BUTTON as u32) == 0x00A35C;
    assert th_kind_color(TH_PAPER, VF_CONTAINER as u32) == 0xFFFFFF;
    assert th_kind_role(VF_BUTTON as u32) == TH_ACCENT;
}

test legible {
    // W3C brightness difference: luma 299 587 114 over 1000, hand computed
    assert th_luma(0x000000) == 0;
    assert th_luma(0xFFFFFF) == 255;
    assert th_luma(0x888888) == 136;
    assert th_luma(0x666666) == 102;
    assert th_luma(0xFF0000) == 76;
    assert th_luma(0x00FF00) == 149;
    assert th_luma(0x0000FF) == 29;
    assert th_luma(0x00FF88) == 165;
    assert th_luma(0x00A35C) == 106;
    assert th_luma_gap(th_color(TH_T27, TH_BG), th_color(TH_T27, TH_TEXT)) >= 125;
    assert th_luma_gap(th_color(TH_PAPER, TH_BG), th_color(TH_PAPER, TH_TEXT)) >= 125;
    assert th_luma_gap(th_color(TH_T27, TH_BG), th_color(TH_T27, TH_MUTED)) >= 50;
    assert th_luma_gap(th_color(TH_PAPER, TH_BG), th_color(TH_PAPER, TH_MUTED)) >= 50;
    assert th_luma_gap(th_color(TH_T27, TH_BG), th_color(TH_T27, TH_MUTED)) == 136;
    assert th_luma_gap(th_color(TH_PAPER, TH_BG), th_color(TH_PAPER, TH_MUTED)) == 153;
    assert th_luma_gap(th_color(TH_T27, TH_BG), th_color(TH_T27, TH_ACCENT)) >= 125;
    assert th_luma_gap(th_color(TH_PAPER, TH_BG), th_color(TH_PAPER, TH_ACCENT)) >= 125;
}

test fixed_tokens {
    assert TH_RADIUS_CARD == 12;
    assert TH_PAD_CARD == 20;
    assert TH_GAP_CARD == 10;
    assert TH_GAP_CATALOG == 16;
    assert TH_TITLE_PX == 22;
    assert TH_MAX_W == 1200;
    assert TH_NARROW_W == 680;
    assert TH_TOUCH_MIN == 44;
    assert TH_BP_DESKTOP_MAX == 1600;
    assert TH_FONT_W_LO[TH_FONT_DISPLAY] == 400;
    assert TH_FONT_W_HI[TH_FONT_DISPLAY] == 800;
    assert TH_FONT_W_LO[TH_FONT_MONO] == 400;
    assert TH_FONT_W_HI[TH_FONT_MONO] == 500;
}

test card_layout_tokens {
    assert TH_CARD_INSET == 12;
    assert TH_CARD_MAX_W == 480;
    assert TH_FOCUS_W == 2;
    assert TH_CAP_MILLI == 700;
    // the inset leaves room: two insets fit in the narrowest card, and a card is narrower than the catalogue width
    assert TH_CARD_INSET * 2 < TH_CARD_MAX_W;
    assert TH_CARD_MAX_W < TH_MAX_W;
    assert TH_CARD_INSET < TH_PAD_CARD;
    // negative controls: the ring must be wider than the 1 px outline, and a cap height is below one em
    assert TH_FOCUS_W > 1;
    assert TH_CAP_MILLI < 1000;
    assert TH_CARD_MAX_W != TH_MAX_W;
}

test negative_control {
    // a table shifted by one must fail these
    assert th_color(TH_T27, TH_ACCENT) != th_color(TH_T27, TH_ACCENT_DARK);
    assert th_color(TH_T27, TH_ACCENT) == 0x00FF88;
    assert th_color(TH_T27, TH_CARD_FOOT) == 0x8A8A8A;
    assert th_color(TH_PAPER, TH_CARD_FOOT) == 0x666666;
    assert th_color(5, 0) == 0xFF00FF;
    assert th_color(0, 99) == 0xFF00FF;
    assert th_color(1, 11) == 0xFF00FF;
    // the golden check is not vacuous: the scale shifted by one step is far outside one permille
    var s1 : u32 = TH_FONT_REM[3];
    var s2 : u32 = TH_FONT_REM[5];
    var sq : u32 = s1 * s1;
    var want : u32 = s2 * 1000;
    var gap : u32 = 0;
    if sq >= want {
        gap = sq - want;
    } else {
        gap = want - sq;
    }
    assert gap * 1000 > want;
}
