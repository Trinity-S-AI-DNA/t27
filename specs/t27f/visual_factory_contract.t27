// SPDX-License-Identifier: Apache-2.0
; T27F visual factory contract: a typed UI object graph of 8 primitive components, validated before render
; Refs gHashTag/t27#13216 epic #13214, reuses ui_plan.t27, does not replace it (ui_plan = domain widgets on a grid; this = primitive layer)
; Claims: 8 component kinds, role system, validation, output contracts; NOT claims: no renderer, no layout (vf_layout.t27)

module t27f_visual_factory_contract;
use t27f::ui_plan::bit;
use t27f::ui_plan::has_bit;
use t27f::ui_plan::THEME_LIGHT;
use t27f::ui_plan::THEME_DARK;
use t27f::ui_plan::THEME_HIGH_CONTRAST;

pub const VF_CONTRACT_VERSION : u32 = 1;
pub const VF_MAX_NODES : u32 = 16;
pub const VF_NO_PARENT : u8 = 255;
pub const VF_NO_REF : u8 = 255;

pub const VF_NONE : u8 = 0;
pub const VF_CONTAINER : u8 = 1;
pub const VF_STACK : u8 = 2;
pub const VF_TEXT : u8 = 3;
pub const VF_BUTTON : u8 = 4;
pub const VF_INPUT : u8 = 5;
pub const VF_CARD : u8 = 6;
pub const VF_BADGE : u8 = 7;
pub const VF_LIST : u8 = 8;
pub const VF_KINDS : u8 = 9;
pub const VF_UNKNOWN : u8 = 255;

pub const VF_NAMES : [9]str = ["none", "container", "stack", "text", "button", "input", "card", "badge", "list"];
pub const VF_BASE : [9]u8 = [0, 1, 2, 3, 4, 5, 1, 7, 8];

pub const ROLE_NONE : u8 = 0;
pub const GROUP : u8 = 1;
pub const TEXT : u8 = 2;
pub const BUTTON : u8 = 3;
pub const TEXTBOX : u8 = 4;
pub const STATUS : u8 = 5;
pub const LIST : u8 = 6;
pub const ARTICLE : u8 = 7;

pub const ROLE_NAMES : [8]str = ["none", "group", "text", "button", "textbox", "status", "list", "article"];
pub const VF_ROLE : [9]u8 = [0, 1, 1, 2, 3, 4, 7, 5, 6];

pub const VF_INTERACTIVE : [9]u8 = [0, 0, 0, 0, 1, 1, 0, 0, 0];
pub const VF_MAX_CHILDREN : [9]u8 = [0, 8, 8, 0, 0, 0, 8, 0, 8];

pub const P_TEXT : u8 = 0;
pub const P_LABEL : u8 = 1;
pub const P_LABEL_REF : u8 = 2;
pub const P_VARIANT : u8 = 3;
pub const P_STATE : u8 = 4;
pub const P_TEST_ID : u8 = 5;
pub const P_PLACEHOLDER : u8 = 6;

; VF_PROPS per kind: 0 none {}, 1 container {label, variant, test id}, 2 stack {test id},
; 3 text {text, label, variant, test id}, 4 button {text, label, variant, state, test id},
; 5 input {label ref, state, test id, placeholder}, 6 card {label, variant, state, test id},
; 7 badge {text, variant, test id}, 8 list {label, test id}
pub const VF_PROPS : [9]u32 = [0, 42, 32, 43, 59, 116, 58, 41, 34];

pub const V_DEFAULT : u8 = 0;
pub const PRIMARY : u8 = 1;
pub const SECONDARY : u8 = 2;
pub const OUTLINED : u8 = 3;
pub const ELEVATED : u8 = 4;
pub const SUCCESS : u8 = 5;
pub const WARNING : u8 = 6;
pub const DANGER : u8 = 7;
pub const V_KINDS : u8 = 8;

; VF_VARIANTS per kind: 0 none {}, 1 container {0}, 2 stack {0}, 3 text {0,2},
; 4 button {0,1,2,7}, 5 input {0}, 6 card {0,3,4}, 7 badge {0,5,6,7}, 8 list {0}
pub const VF_VARIANTS : [9]u32 = [0, 0, 0, 5, 135, 0, 25, 225, 0];

pub const S_DEFAULT : u8 = 0;
pub const HOVER : u8 = 1;
pub const FOCUS : u8 = 2;
pub const DISABLED : u8 = 3;
pub const ERROR : u8 = 4;
pub const S_KINDS : u8 = 5;

; VF_STATES per kind: 0 none {}, 1 container {}, 2 stack {}, 3 text {},
; 4 button {0,1,2,3}, 5 input {0,2,3,4}, 6 card {0,1}, 7 badge {}, 8 list {}
pub const VF_STATES : [9]u32 = [0, 0, 0, 0, 15, 29, 3, 0, 0];

pub const DISPLAY_STACK : u8 = 0;
pub const DISPLAY_GRID : u8 = 1;
pub const DIR_ROW : u8 = 0;
pub const DIR_COLUMN : u8 = 1;
pub const DIR_INHERIT : u8 = 255;
pub const ALIGN_START : u8 = 0;
pub const ALIGN_CENTER : u8 = 1;
pub const ALIGN_END : u8 = 2;
pub const ALIGN_STRETCH : u8 = 3;
pub const JUSTIFY_START : u8 = 0;
pub const JUSTIFY_CENTER : u8 = 1;
pub const JUSTIFY_END : u8 = 2;
pub const JUSTIFY_SPACE_BETWEEN : u8 = 3;

pub const BP_SM : u8 = 0;
pub const BP_MD : u8 = 1;
pub const BP_LG : u8 = 2;
pub const BP_MIN_WIDTH : [3]u32 = [0, 640, 1024];

pub const TOK_FG : u8 = 0;
pub const BG : u8 = 1;
pub const SURFACE : u8 = 2;
pub const ACCENT : u8 = 3;
pub const MUTED : u8 = 4;
pub const BORDER : u8 = 5;
pub const TOK_KINDS : u8 = 6;

; token RGB per theme row: fg, bg, surface, accent, muted, border
; THEME_LIGHT, then THEME_DARK, then THEME_HIGH_CONTRAST
pub const VF_TOKEN_RGB : [18]u32 = [
    1118481, 16777215, 16119285, 2056127, 5855577, 13421772,
    15658734, 1118481, 1973790, 9090296, 10526880, 4473924,
    0, 16777215, 16777215, 238, 0, 0
];

pub const VF_SPACE : [6]u32 = [0, 4, 8, 12, 16, 24];

pub struct VfGraph {
    contract_version: u32,
    theme: u8,
    viewport_w: u32,
    viewport_h: u32,
    node_count: u32,
    kind: [16]u8,
    parent: [16]u8,
    props: [16]u32,
    text: [16]str,
    label: [16]str,
    label_ref: [16]u8,
    variant: [16]u8,
    state: [16]u8,
    test_id: [16]str,
    display: [16]u8,
    direction: [16]u8,
    direction_md: [16]u8,
    columns: [16]u8,
    gap: [16]u32,
    padding: [16]u32,
    margin: [16]u32,
    align: [16]u8,
    justify: [16]u8,
    grow: [16]u32,
    shrink: [16]u32,
    basis: [16]u32,
    min_w: [16]u32,
    max_w: [16]u32,
    min_h: [16]u32,
    max_h: [16]u32,
}

pub fn vf_blank_graph() -> VfGraph {
    var g : VfGraph = VfGraph {
        contract_version: 1,
        theme: THEME_LIGHT,
        viewport_w: 375,
        viewport_h: 812,
        node_count: 0,
        kind: [VF_UNKNOWN; 16],
        parent: [VF_NO_PARENT; 16],
        props: [0; 16],
        text: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        label: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        label_ref: [VF_NO_REF; 16],
        variant: [V_DEFAULT; 16],
        state: [S_DEFAULT; 16],
        test_id: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        display: [DISPLAY_STACK; 16],
        direction: [DIR_ROW; 16],
        direction_md: [DIR_INHERIT; 16],
        columns: [1; 16],
        gap: [0; 16],
        padding: [0; 16],
        margin: [0; 16],
        align: [ALIGN_START; 16],
        justify: [JUSTIFY_START; 16],
        grow: [0; 16],
        shrink: [1; 16],
        basis: [0; 16],
        min_w: [0; 16],
        max_w: [0; 16],
        min_h: [0; 16],
        max_h: [0; 16],
    };
    return g;
}

pub fn vf_add(g: VfGraph, kind: u8, parent: u8, props: u32, test_id: str) -> VfGraph {
    var new_count : u32 = g.node_count + 1;
    if new_count > VF_MAX_NODES {
        return g;
    }

    var new_g : VfGraph = g;
    new_g.node_count = new_count;
    new_g.kind[new_count - 1] = kind;
    new_g.parent[new_count - 1] = parent;
    new_g.props[new_count - 1] = props;
    new_g.test_id[new_count - 1] = test_id;

    return new_g;
}

pub fn vf_kind_id(name: str) -> u8 {
    if name == "none" {
        return VF_NONE;
    } else if name == "container" {
        return VF_CONTAINER;
    } else if name == "stack" {
        return VF_STACK;
    } else if name == "text" {
        return VF_TEXT;
    } else if name == "button" {
        return VF_BUTTON;
    } else if name == "input" {
        return VF_INPUT;
    } else if name == "card" {
        return VF_CARD;
    } else if name == "badge" {
        return VF_BADGE;
    } else if name == "list" {
        return VF_LIST;
    } else {
        return VF_UNKNOWN;
    }
}

pub fn vf_base(kind: u8) -> u8 {
    var v : u8 = VF_UNKNOWN;
    if kind < VF_KINDS {
        v = VF_BASE[kind];
    }
    return v;
}

pub fn vf_role(kind: u8) -> u8 {
    var v : u8 = ROLE_NONE;
    if kind < VF_KINDS {
        v = VF_ROLE[kind];
    }
    return v;
}

pub fn vf_is_interactive(kind: u8) -> bool {
    var v : bool = false;
    if kind < VF_KINDS {
        v = VF_INTERACTIVE[kind] > 0;
    }
    return v;
}

pub fn vf_child_count(g: VfGraph, i: u32) -> u32 {
    var count : u32 = 0;
    var c : u32 = 0;
    while c < g.node_count {
        if g.parent[c] == i as u8 {
            count = count + 1;
        }
        c = c + 1;
    }
    return count;
}

pub fn vf_accessible_name(g: VfGraph, i: u32) -> str {
    if i >= g.node_count {
        return "";
    }

    let label : str = g.label[i];
    if label != "" {
        return label;
    }

    let kind : u8 = g.kind[i];
    if kind == VF_INPUT and g.label_ref[i] < g.node_count {
        let ref_node : u8 = g.label_ref[i];
        return g.text[ref_node];
    }

    return g.text[i];
}

pub fn vf_node_code(g: VfGraph, i: u32) -> u8 {
    if i >= g.node_count {
        return VF_OK;
    }

    let kind : u8 = g.kind[i];
    if kind >= VF_KINDS {
        return E_UNKNOWN_COMPONENT;
    }

    if g.parent[i] != VF_NO_PARENT and VF_MAX_CHILDREN[g.kind[g.parent[i]]] == 0 {
        return E_CHILD_NOT_ALLOWED;
    }

    var child_count : u32 = vf_child_count(g, i);
    if VF_MAX_CHILDREN[kind] > 0 and child_count > VF_MAX_CHILDREN[kind] as u32 {
        return E_TOO_MANY_CHILDREN;
    }

    let props : u32 = g.props[i];
    if (props & VF_PROPS[kind]) != props {
        return E_PROP_NOT_ALLOWED;
    }

    let variant : u8 = g.variant[i];
    if variant > 0 and (VF_VARIANTS[kind] & bit(variant)) == 0 {
        return E_VARIANT;
    }

    let state : u8 = g.state[i];
    if state > 0 and (VF_STATES[kind] & bit(state)) == 0 {
        return E_STATE;
    }

    if kind == VF_INPUT {
        if g.label_ref[i] == VF_NO_REF {
            return E_INPUT_LABEL;
        }
        if g.label_ref[i] < g.node_count {
            let ref_node : u8 = g.label_ref[i];
            if g.kind[ref_node] != VF_TEXT or g.text[ref_node] == "" {
                return E_INPUT_LABEL;
            }
        }
    }

    if vf_is_interactive(kind) and vf_accessible_name(g, i) == "" {
        return E_A11Y_NAME;
    }

    if kind == VF_TEXT and g.text[i] == "" and g.label[i] == "" {
        return E_TEXT_EMPTY;
    }

    let test_id : str = g.test_id[i];
    if test_id == "" {
        return E_TEST_ID;
    }

    var j : u32 = 0;
    while j < i {
        if g.test_id[j] == test_id {
            return E_TEST_ID;
        }
        j = j + 1;
    }

    let display : u8 = g.display[i];
    if display > 1 {
        return E_LAYOUT_ENUM;
    }

    let direction : u8 = g.direction[i];
    if direction > 1 {
        return E_LAYOUT_ENUM;
    }

    let direction_md : u8 = g.direction_md[i];
    if direction_md != 0 and direction_md != 1 and direction_md != 255 {
        return E_LAYOUT_ENUM;
    }

    let align : u8 = g.align[i];
    if align > 3 {
        return E_LAYOUT_ENUM;
    }

    let justify : u8 = g.justify[i];
    if justify > 3 {
        return E_LAYOUT_ENUM;
    }

    if g.min_w[i] > g.max_w[i] and g.max_w[i] != 0 {
        return E_LAYOUT_RANGE;
    }

    if g.min_h[i] > g.max_h[i] and g.max_h[i] != 0 {
        return E_LAYOUT_RANGE;
    }

    if display == DISPLAY_GRID and g.columns[i] == 0 {
        return E_LAYOUT_RANGE;
    }

    return VF_OK;
}

pub fn vf_validate(g: VfGraph) -> u8 {
    if g.contract_version != VF_CONTRACT_VERSION {
        return E_VERSION;
    }

    if g.theme > 2 {
        return E_THEME;
    }

    if g.viewport_w == 0 or g.viewport_h == 0 {
        return E_VIEWPORT;
    }

    if g.node_count == 0 or g.node_count > VF_MAX_NODES {
        return E_NODE_COUNT;
    }

    if g.parent[0] != VF_NO_PARENT {
        return E_ROOT;
    }

    var i : u32 = 1;
    while i < g.node_count {
        if g.parent[i] == VF_NO_PARENT {
            return E_ROOT;
        }
        if g.parent[i] >= i as u8 {
            return E_PARENT_ORDER;
        }
        i = i + 1;
    }

    i = 0;
    while i < g.node_count {
        if vf_node_code(g, i) != VF_OK {
            return vf_node_code(g, i);
        }
        i = i + 1;
    }

    return VF_OK;
}

pub fn vf_first_bad_node(g: VfGraph) -> u32 {
    let code : u8 = vf_validate(g);
    if code == VF_OK {
        return 16;
    }

    if code >= E_VERSION and code <= E_PARENT_ORDER {
        return 16;
    }

    var i : u32 = 0;
    while i < g.node_count {
        if vf_node_code(g, i) == code {
            return i;
        }
        i = i + 1;
    }

    return 0;
}

pub const VF_OK : u8 = 0;
pub const E_VERSION : u8 = 1;
pub const E_THEME : u8 = 2;
pub const E_VIEWPORT : u8 = 3;
pub const E_NODE_COUNT : u8 = 4;
pub const E_ROOT : u8 = 5;
pub const E_PARENT_ORDER : u8 = 6;
pub const E_UNKNOWN_COMPONENT : u8 = 7;
pub const E_CHILD_NOT_ALLOWED : u8 = 8;
pub const E_TOO_MANY_CHILDREN : u8 = 9;
pub const E_PROP_NOT_ALLOWED : u8 = 10;
pub const E_VARIANT : u8 = 11;
pub const E_STATE : u8 = 12;
pub const E_A11Y_NAME : u8 = 13;
pub const E_INPUT_LABEL : u8 = 14;
pub const E_TEXT_EMPTY : u8 = 15;
pub const E_TEST_ID : u8 = 16;
pub const E_LAYOUT_ENUM : u8 = 17;
pub const E_LAYOUT_RANGE : u8 = 18;
pub const VF_CODE_KINDS : u8 = 19;

pub const VF_CODE_NAMES : [19]str = [
    "VF000", "VF001", "VF002", "VF003", "VF004", "VF005", "VF006", "VF007", "VF008", "VF009",
    "VF010", "VF011", "VF012", "VF013", "VF014", "VF015", "VF016", "VF017", "VF018"
];

pub fn vf_code_name(c: u8) -> str {
    var v : str = "VF???";
    if c < VF_CODE_KINDS {
        v = VF_CODE_NAMES[c];
    }
    return v;
}

pub fn vf_breakpoint(width: u32) -> u8 {
    if width < BP_MIN_WIDTH[1] {
        return BP_SM;
    } else if width < BP_MIN_WIDTH[2] {
        return BP_MD;
    } else {
        return BP_LG;
    }
}

pub fn vf_token(theme: u8, tok: u8) -> u32 {
    var v : u32 = 0;
    if theme < 3 and tok < TOK_KINDS {
        v = VF_TOKEN_RGB[theme * 6 + tok];
    }
    return v;
}

pub fn vf_sample_graph() -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "card");
    var g1 : VfGraph = vf_add(g0, VF_STACK, 0, bit(P_TEST_ID), "body");
    var g2 : VfGraph = vf_add(g1, VF_TEXT, 1, bit(P_TEXT) + bit(P_LABEL) + bit(P_TEST_ID), "name-label");
    var g3 : VfGraph = vf_add(g2, VF_INPUT, 1, bit(P_LABEL_REF) + bit(P_TEST_ID), "name-input");
    var g4 : VfGraph = vf_add(g3, VF_BUTTON, 1, bit(P_TEXT) + bit(P_LABEL) + bit(P_VARIANT) + bit(P_TEST_ID), "save");

    g4.label[0] = "Sample card";
    g4.direction[1] = DIR_COLUMN;
    g4.text[2] = "Name";
    g4.label_ref[3] = 2;
    g4.text[4] = "Save";
    g4.variant[4] = PRIMARY;

    return g4;
}

pub fn vf_bad_fixture(c: u8) -> VfGraph {
    var g : VfGraph = vf_sample_graph();

    if c == E_VERSION {
        g.contract_version = 2;
    } else if c == E_THEME {
        g.theme = 3;
    } else if c == E_VIEWPORT {
        g.viewport_w = 0;
    } else if c == E_NODE_COUNT {
        g.node_count = 0;
    } else if c == E_ROOT {
        g.parent[3] = VF_NO_PARENT;
    } else if c == E_PARENT_ORDER {
        g.parent[2] = 3;
    } else if c == E_UNKNOWN_COMPONENT {
        g.kind[2] = 9;
    } else if c == E_CHILD_NOT_ALLOWED {
        g.parent[3] = 2;
    } else if c == E_TOO_MANY_CHILDREN {
        g.node_count = 13;
        var i : u32 = 5;
        while i < 13 {
            g.kind[i] = VF_BADGE;
            g.parent[i] = 1;
            i = i + 1;
        }
    } else if c == E_PROP_NOT_ALLOWED {
        g.props[1] = g.props[1] + bit(P_TEXT);
    } else if c == E_VARIANT {
        g.variant[2] = PRIMARY;
    } else if c == E_STATE {
        g.state[2] = HOVER;
    } else if c == E_A11Y_NAME {
        g.text[4] = "";
    } else if c == E_INPUT_LABEL {
        g.label_ref[3] = VF_NO_REF;
    } else if c == E_TEXT_EMPTY {
        g.text[2] = "";
    } else if c == E_TEST_ID {
        g.test_id[4] = "card";
    } else if c == E_LAYOUT_ENUM {
        g.align[1] = 4;
    } else if c == E_LAYOUT_RANGE {
        g.min_w[1] = 100;
        g.max_w[1] = 50;
    }

    return g;
}

test registry_has_eight_components {
    assert VF_KINDS == 9;
    assert VF_NAMES[0] == "none";
    assert VF_NAMES[VF_KINDS - 1] == "list";
}

test card_reuses_container {
    assert VF_BASE[VF_CARD] == VF_CONTAINER;
}

test roles_are_fixed {
    assert VF_ROLE[VF_BUTTON] == BUTTON;
    assert VF_ROLE[VF_INPUT] == TEXTBOX;
}

test sample_graph_is_valid {
    let g : VfGraph = vf_sample_graph();
    assert vf_validate(g) == 0;
    assert vf_first_bad_node(g) == 16;
}

test each_bad_fixture_gets_its_own_code {
    var c : u8 = 1;
    while c < VF_CODE_KINDS {
        let g : VfGraph = vf_bad_fixture(c);
        assert vf_validate(g) == c;
        c = c + 1;
    }
}

test code_names_are_stable {
    assert vf_code_name(0) == "VF000";
    assert vf_code_name(13) == "VF013";
    assert vf_code_name(18) == "VF018";
    assert vf_code_name(40) == "VF???";
}

test accessible_names {
    let g : VfGraph = vf_sample_graph();
    assert vf_accessible_name(g, 0) == "Sample card";
    assert vf_accessible_name(g, 4) == "Save";
    assert vf_accessible_name(g, 3) == "Name";
}

test breakpoints {
    assert vf_breakpoint(639) == BP_SM;
    assert vf_breakpoint(640) == BP_MD;
    assert vf_breakpoint(1023) == BP_MD;
    assert vf_breakpoint(1024) == BP_LG;
}

test tokens_per_theme {
    let light_fg : u32 = vf_token(THEME_LIGHT, TOK_FG);
    let light_bg : u32 = vf_token(THEME_LIGHT, BG);
    assert light_fg != light_bg;

    var c : u32 = 0;
    while c < 18 {
        let token : u32 = vf_token(0, c as u8);
        assert token < 16777216;
        c = c + 1;
    }
}

test output_contracts {
    assert VF_ARTIFACT_SCHEMA == "t27f.vf.artifact/1";
    assert VF_ARTIFACT_FIELDS[0] == "schema";
    assert VF_ARTIFACT_FIELDS[10] == "digest";
    assert VF_MANIFEST_FIELDS[4] == "entry";
    assert VF_SNAPSHOT_FIELDS[6] == "test_id";
}

test first_bad_node_points_at_the_node {
    let g8 : VfGraph = vf_bad_fixture(8);
    assert vf_first_bad_node(g8) == 3;

    let g13 : VfGraph = vf_bad_fixture(13);
    assert vf_first_bad_node(g13) == 4;

    let g1 : VfGraph = vf_bad_fixture(1);
    assert vf_first_bad_node(g1) == 16;
}

pub const VF_ARTIFACT_SCHEMA : str = "t27f.vf.artifact/1";
pub const VF_ARTIFACT_FIELDS : [11]str = [
    "schema", "contract_version", "story", "viewport", "breakpoint", "theme", "nodes", "layout", "a11y", "diagnostics", "digest"
];
pub const VF_MANIFEST_FIELDS : [5]str = ["story", "contract_version", "viewports", "themes", "entry"];
pub const VF_PREVIEW_VIEWPORTS : [3]u32 = [375, 768, 1280];
pub const VF_SNAPSHOT_FIELDS : [7]str = ["index", "kind", "rect", "role", "name", "focus", "test_id"];
pub const VF_SNAP_INT_PX : bool = true;
pub const VF_SNAP_TIMESTAMPS : bool = false;
pub const VF_SNAP_ABS_PATHS : bool = false;