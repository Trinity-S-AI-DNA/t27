// SPDX-License-Identifier: Apache-2.0
; specs/t27f/sieve_design_law.t27 -- T27OS UI sieve: nine HIG filters, seventeen components,
; and the design law derived from the GOLDEN SIEVE method (specs/compiler/theory/sieve.t27).
; The sieve pattern:
;   - each filter is a decidable predicate with a source citation
;   - each cell is PRESENT, PARTIAL (exists with limits), MISSING (gap), or NA (not applicable)
;   - MISSING when a property is known absent; PARTIAL when no source confirms full realization
;   - only MISSING removes a component from the PRESENT verdict; NA and PARTIAL never do
;   - for T27OS components we are the source: a known gap is MISSING, not PARTIAL
;   - every MISSING cell maps to a fix issue (the component's story issue)
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3)
; Refs #13432

module T27fSieveDesignLaw;

; ---- Cell values (Kleene 3-logic, same encoding as CompilerTheorySieve) ----------------------
; MISSING = known gap, blocks PRESENT verdict; PARTIAL = exists with stated limit;
; PRESENT = fully realized, sourced; NA = not applicable for this component/filter
pub const MISSING : u8 = 0;
pub const PARTIAL : u8 = 1;
pub const PRESENT : u8 = 2;
pub const NA      : u8 = 3;

; ---- Components (candidate index) -----------------------------------------------------------
; 0-7: defined in specs/t27f/ui_kit.t27 (PR #13427, merged 2026-11-09)
; 8-16: not yet in any spec (accessed 2026-11-09)
pub const C_CONTAINER  : u32 = 0;
pub const C_TEXT       : u32 = 1;
pub const C_BUTTON     : u32 = 2;
pub const C_BADGE      : u32 = 3;
pub const C_CARD       : u32 = 4;
pub const C_INPUT      : u32 = 5;
pub const C_NAV        : u32 = 6;
pub const C_TABLE      : u32 = 7;
pub const C_TITLE_BAR  : u32 = 8;
pub const C_SIDEBAR    : u32 = 9;
pub const C_PANEL      : u32 = 10;
pub const C_LANE_ROW   : u32 = 11;
pub const C_LOG_ROW    : u32 = 12;
pub const C_GRAPH_NODE : u32 = 13;
pub const C_PETAL      : u32 = 14;
pub const C_LIVE_GRAPH : u32 = 15;
pub const C_QUEEN_DASH : u32 = 16;
pub const COMPONENTS   : u32 = 17;
; KIT_COUNT: components with VfGraph definitions today (ui_kit.t27, PR #13427)
pub const KIT_COUNT    : u32 = 8;

; ---- HIG Filters (Apple Human Interface Guidelines, developer.apple.com/design/human-interface-guidelines, 2026-11-09) ----
; F1 CLARITY       -- text is legible at every size; icons are precise; emphasis drives comprehension.
; F2 CONSISTENCY   -- familiar standards; icons, text, and elements behave predictably across surfaces.
; F3 HIERARCHY     -- visual weight, size, and placement guide attention; content hierarchy drives layout.
; F4 FEEDBACK      -- every action acknowledged; state changes are visible; progress is communicated.
; F5 ACCESSIBILITY -- VoiceOver labels; Dynamic Type scaling; contrast >= 4.5:1 (WCAG AA);
;                     touch targets >= 44x44 pt.
; F6 SIMPLICITY    -- minimal elements; nothing decorative without purpose; content fills space.
; F7 FAMILIARITY   -- builds on conventions users know; predictable gestures, placements, iconography.
; F8 FLEXIBILITY   -- adapts to multiple sizes, densities, and contexts without layout breakage.
; F9 CRAFT         -- pixel precision; micro-interaction polish; animation easing; detail quality.
pub const F_CLARITY       : u32 = 1;
pub const F_CONSISTENCY   : u32 = 2;
pub const F_HIERARCHY     : u32 = 3;
pub const F_FEEDBACK      : u32 = 4;
pub const F_ACCESSIBILITY : u32 = 5;
pub const F_SIMPLICITY    : u32 = 6;
pub const F_FAMILIARITY   : u32 = 7;
pub const F_FLEXIBILITY   : u32 = 8;
pub const F_CRAFT         : u32 = 9;
pub const FILTERS         : u32 = 9;

; Kleene conjunction: MISSING < PARTIAL < PRESENT; NA reads as PRESENT (never removes).
pub fn as_kleene(v: u8) -> u8 {
    if (v == NA) { return PRESENT; }
    return v;
}

pub fn k_and(a: u8, b: u8) -> u8 {
    var x : u8 = as_kleene(a);
    var y : u8 = as_kleene(b);
    if (x < y) { return x; }
    return y;
}

; ---- Kit baseline cells (source: specs/t27f/ui_kit.t27 at PR #13427, master 37ecbbaf) ------
; F1 CLARITY:       PARTIAL -- VF_* type roles define semantic identity; no typographic scale.
; F2 CONSISTENCY:   PARTIAL -- KV_*/KS_* constants are uniform across all 8 components.
; F3 HIERARCHY:     MISSING -- no visual weight, size relationships, or spacing tokens.
; F4 FEEDBACK:      PARTIAL -- KS_HOVER/PRESSED/FOCUS constants exist; no visual response spec.
; F5 ACCESSIBILITY: MISSING -- no ARIA labels, contrast ratios, or touch-target sizes.
; F6 SIMPLICITY:    PARTIAL -- VfGraph is minimal; no decorative elements in spec.
; F7 FAMILIARITY:   PARTIAL -- names (button, card, input...) follow HIG component conventions.
; F8 FLEXIBILITY:   PARTIAL -- variant system enables adaptation; no responsive geometry.
; F9 CRAFT:         MISSING -- no animation, micro-interaction, or pixel-precision spec.
pub fn cell_kit(f: u32) -> u8 {
    if (f == F_CLARITY)       { return PARTIAL; }
    if (f == F_CONSISTENCY)   { return PARTIAL; }
    if (f == F_HIERARCHY)     { return MISSING; }
    if (f == F_FEEDBACK)      { return PARTIAL; }
    if (f == F_ACCESSIBILITY) { return MISSING; }
    if (f == F_SIMPLICITY)    { return PARTIAL; }
    if (f == F_FAMILIARITY)   { return PARTIAL; }
    if (f == F_FLEXIBILITY)   { return PARTIAL; }
    return MISSING;
}

; Components 0-7 share the kit baseline at this point in time.
; As fix issues land, their cell functions gain per-filter overrides.
pub fn cell_container(f: u32)  -> u8 { return cell_kit(f); }
pub fn cell_text(f: u32)       -> u8 { return cell_kit(f); }
pub fn cell_button(f: u32)     -> u8 { return cell_kit(f); }
pub fn cell_badge(f: u32)      -> u8 { return cell_kit(f); }
pub fn cell_card(f: u32)       -> u8 { return cell_kit(f); }
pub fn cell_input(f: u32)      -> u8 { return cell_kit(f); }
pub fn cell_nav(f: u32)        -> u8 { return cell_kit(f); }
pub fn cell_table(f: u32)      -> u8 { return cell_kit(f); }

; Components 8-16: no spec yet; all cells MISSING.
pub fn cell_new(f: u32) -> u8 { return MISSING; }

pub fn cell_title_bar(f: u32)  -> u8 { return cell_new(f); }
pub fn cell_sidebar(f: u32)    -> u8 { return cell_new(f); }
pub fn cell_panel(f: u32)      -> u8 { return cell_new(f); }
pub fn cell_lane_row(f: u32)   -> u8 { return cell_new(f); }
pub fn cell_log_row(f: u32)    -> u8 { return cell_new(f); }
pub fn cell_graph_node(f: u32) -> u8 { return cell_new(f); }
pub fn cell_petal(f: u32)      -> u8 { return cell_new(f); }
pub fn cell_live_graph(f: u32) -> u8 { return cell_new(f); }
pub fn cell_queen_dash(f: u32) -> u8 { return cell_new(f); }

pub fn value(c: u32, f: u32) -> u8 {
    if (c == C_CONTAINER)  { return cell_container(f); }
    if (c == C_TEXT)       { return cell_text(f); }
    if (c == C_BUTTON)     { return cell_button(f); }
    if (c == C_BADGE)      { return cell_badge(f); }
    if (c == C_CARD)       { return cell_card(f); }
    if (c == C_INPUT)      { return cell_input(f); }
    if (c == C_NAV)        { return cell_nav(f); }
    if (c == C_TABLE)      { return cell_table(f); }
    if (c == C_TITLE_BAR)  { return cell_title_bar(f); }
    if (c == C_SIDEBAR)    { return cell_sidebar(f); }
    if (c == C_PANEL)      { return cell_panel(f); }
    if (c == C_LANE_ROW)   { return cell_lane_row(f); }
    if (c == C_LOG_ROW)    { return cell_log_row(f); }
    if (c == C_GRAPH_NODE) { return cell_graph_node(f); }
    if (c == C_PETAL)      { return cell_petal(f); }
    if (c == C_LIVE_GRAPH) { return cell_live_graph(f); }
    return cell_queen_dash(f);
}

; A component's verdict over all nine filters (Kleene AND).
pub fn verdict(c: u32) -> u8 {
    var f : u32 = 1;
    var v : u8 = PRESENT;
    while (f <= FILTERS) {
        v = k_and(v, value(c, f));
        f = f + 1;
    }
    return v;
}

; Number of MISSING cells for a component.
pub fn gap_count(c: u32) -> u32 {
    var f : u32 = 1;
    var n : u32 = 0;
    while (f <= FILTERS) {
        if (value(c, f) == MISSING) { n = n + 1; }
        f = f + 1;
    }
    return n;
}

pub fn cells_with(c: u32, v: u8) -> u32 {
    var f : u32 = 1;
    var n : u32 = 0;
    while (f <= FILTERS) {
        if (value(c, f) == v) { n = n + 1; }
        f = f + 1;
    }
    return n;
}

; Total MISSING cells across all 17 components.
pub fn total_gaps() -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (c < COMPONENTS) {
        n = n + gap_count(c);
        c = c + 1;
    }
    return n;
}

; Components at PRESENT verdict (all filters satisfied or NA).
pub fn present_count() -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (c < COMPONENTS) {
        if (verdict(c) == PRESENT) { n = n + 1; }
        c = c + 1;
    }
    return n;
}

; The container story issue. The three container MISSING cells point here.
; The cells stay MISSING: the story does not prove hierarchy, accessibility or craft.
pub const CONTAINER_STORY_ISSUE : u32 = 13491;

; The text story issue. The three text MISSING cells point here and stay MISSING.
pub const TEXT_STORY_ISSUE : u32 = 13521;

; Map a MISSING cell to its fix issue. 0 means the issue is not yet filed.
; Updated as component story issues land (see t_sdl_3).
pub fn fix_issue(c: u32, f: u32) -> u32 {
    if (value(c, f) != MISSING) { return 0; }
    if (c == C_CONTAINER) {
        if (f == F_HIERARCHY) { return CONTAINER_STORY_ISSUE; }
        if (f == F_ACCESSIBILITY) { return CONTAINER_STORY_ISSUE; }
        if (f == F_CRAFT) { return CONTAINER_STORY_ISSUE; }
    }
    if (c == C_TEXT) {
        if (f == F_HIERARCHY) { return TEXT_STORY_ISSUE; }
        if (f == F_ACCESSIBILITY) { return TEXT_STORY_ISSUE; }
        if (f == F_CRAFT) { return TEXT_STORY_ISSUE; }
    }
    return 0;
}

; ==================================================================================================
; T_SDL_1 -- at law creation (master 37ecbbaf, 2026-11-09) no component is fully PRESENT.
; Statement. No component passes all nine HIG filters: kit components (0-7) each have three
; MISSING cells (F3, F5, F9) and new components (8-16) have nine MISSING cells each. Proof: the
; cell functions above and the counts below.
; ==================================================================================================

test t_sdl_1_no_component_is_present {
    assert present_count() == 0;
    var c : u32 = 0;
    while (c < COMPONENTS) {
        assert verdict(c) == MISSING;
        c = c + 1;
    }
}

; ==================================================================================================
; T_SDL_2 -- the kit baseline: eight components share three MISSING and six PARTIAL cells.
; Statement. Components 0-7 (defined in ui_kit.t27 at PR #13427) share the cell_kit baseline:
; F3 (hierarchy), F5 (accessibility), F9 (craft) are MISSING; the remaining six are PARTIAL.
; New components 8-16 each have nine MISSING cells. Total gaps = 8*3 + 9*9 = 105.
; ==================================================================================================

test t_sdl_2_kit_baseline_three_missing {
    var c : u32 = 0;
    while (c < KIT_COUNT) {
        assert cells_with(c, MISSING) == 3;
        assert cells_with(c, PARTIAL) == 6;
        assert cells_with(c, PRESENT) == 0;
        c = c + 1;
    }
}

test t_sdl_2_new_components_all_missing {
    var c : u32 = KIT_COUNT;
    while (c < COMPONENTS) {
        assert cells_with(c, MISSING) == FILTERS;
        c = c + 1;
    }
}

test t_sdl_2_total_gaps {
    assert total_gaps() == 105;
}

; ==================================================================================================
; T_SDL_3 -- every MISSING cell maps to a fix issue, or is still unresolved.
; Statement. At law creation all 105 fix_issue() calls returned 0. The container story
; issue maps the three container MISSING cells (F3, F5, F9) and leaves them MISSING.
; The text story issue maps the three text MISSING cells the same way.
; Unresolved MISSINGs are 105 - 6 = 99. Other components are unchanged.
; ==================================================================================================

test t_sdl_3_unresolved_count_at_law_creation {
    var c : u32 = 0;
    var unresolved : u32 = 0;
    while (c < COMPONENTS) {
        var f : u32 = 1;
        while (f <= FILTERS) {
            if (value(c, f) == MISSING) {
                if (fix_issue(c, f) == 0) { unresolved = unresolved + 1; }
            }
            f = f + 1;
        }
        c = c + 1;
    }
    assert unresolved == 99;
    assert total_gaps() == 105;
}

test t_sdl_3_container_cells_point_at_the_story_issue {
    assert fix_issue(C_CONTAINER, F_HIERARCHY) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_ACCESSIBILITY) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_CRAFT) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_CLARITY) == 0;
    assert fix_issue(C_CONTAINER, F_FEEDBACK) == 0;
    assert fix_issue(C_TEXT, F_HIERARCHY) == TEXT_STORY_ISSUE;
    assert fix_issue(C_BUTTON, F_CRAFT) == 0;
    assert fix_issue(C_QUEEN_DASH, F_CLARITY) == 0;
    assert value(C_CONTAINER, F_HIERARCHY) == MISSING;
    assert value(C_CONTAINER, F_ACCESSIBILITY) == MISSING;
    assert value(C_CONTAINER, F_CRAFT) == MISSING;
    assert CONTAINER_STORY_ISSUE == 13491;
}

test t_sdl_3_text_cells_point_at_the_story_issue {
    assert fix_issue(C_TEXT, F_HIERARCHY) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_ACCESSIBILITY) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_CRAFT) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_CLARITY) == 0;
    assert fix_issue(C_TEXT, F_FEEDBACK) == 0;
    assert fix_issue(C_BUTTON, F_HIERARCHY) == 0;
    assert value(C_TEXT, F_HIERARCHY) == MISSING;
    assert value(C_TEXT, F_ACCESSIBILITY) == MISSING;
    assert value(C_TEXT, F_CRAFT) == MISSING;
    assert TEXT_STORY_ISSUE == 13521;
}

; ==================================================================================================
; T_SDL_4 -- Kleene properties.
; Negative control: a component with one MISSING among PARTIAL cells is removed; a PARTIAL alone
; yields PARTIAL; NA never removes.
; ==================================================================================================

test t_sdl_4_kleene_negative_controls {
    assert k_and(PRESENT, MISSING) == MISSING;
    assert k_and(PARTIAL, PARTIAL) == PARTIAL;
    assert k_and(NA, MISSING) == MISSING;
    assert k_and(NA, PARTIAL) == PARTIAL;
    assert k_and(NA, PRESENT) == PRESENT;
    assert as_kleene(NA) == PRESENT;
}

; ==================================================================================================
; T_SDL_5 -- the kit HIG gaps, ordered by fix priority.
; Statement. The three MISSING filters for kit components are:
;   F3 HIERARCHY   -- no visual weight, spacing tokens, or size relationships
;   F5 ACCESSIBILITY -- no ARIA labels, contrast ratios, or touch-target sizes
;   F9 CRAFT       -- no animation, micro-interaction, or pixel-precision spec
; These are the three properties a component story MUST address to move its verdict to PRESENT.
; Proof: cell_kit returns MISSING exactly for F3, F5, F9.
; ==================================================================================================

test t_sdl_5_kit_missing_filters {
    assert value(C_BUTTON, F_HIERARCHY)     == MISSING;
    assert value(C_BUTTON, F_ACCESSIBILITY) == MISSING;
    assert value(C_BUTTON, F_CRAFT)         == MISSING;
    assert value(C_BUTTON, F_CLARITY)       == PARTIAL;
    assert value(C_BUTTON, F_CONSISTENCY)   == PARTIAL;
    assert value(C_BUTTON, F_FEEDBACK)      == PARTIAL;
    assert value(C_BUTTON, F_SIMPLICITY)    == PARTIAL;
    assert value(C_BUTTON, F_FAMILIARITY)   == PARTIAL;
    assert value(C_BUTTON, F_FLEXIBILITY)   == PARTIAL;
}

test t_sdl_5_new_component_all_nine_missing {
    assert cells_with(C_TITLE_BAR, MISSING)  == 9;
    assert cells_with(C_QUEEN_DASH, MISSING) == 9;
    assert cells_with(C_PETAL, MISSING)      == 9;
    assert cells_with(C_LIVE_GRAPH, MISSING) == 9;
}
