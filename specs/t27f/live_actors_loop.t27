// SPDX-License-Identifier: Apache-2.0
; specs/t27f/live_actors_loop.t27 -- the card of the T27F Live Actors Map improvement loop (anchor
; issue #12988, a child of the closed epic #12779). The loop keeps one ledger of gaps. Each tick
; reads the ledger, skips every gap that an open PR, a lane or a held file owns, and works on
; exactly one unowned gap, chosen by Pareto order.
; --
; THE LEDGER. One row per gap: a name, who owns it (a kind and a label), the impact and the cost
; (1..5) the tick's read-only inventory scored it with, and the command that measured the row's
; evidence, or for a row the inventory could not measure yet the command the next tick runs. A
; row without a command is refused by a test (FR-006: a figure carries its command).
; --
; THE PICK. A gap is a candidate when nobody owns it and no tick has landed it. The Pareto front
; of the candidates is the set that no other candidate dominates (no less impact for no more
; cost, strictly better in one). The pick is the front's best impact per cost, ties to the lower
; index. No candidate means the tick stops and reports (FR-008: stopping is a valid outcome).
; --
; THE TIE TO THE PLAN CARD. The rows that speak of petals read specs/t27os/live_petal_plan.t27
; and hold no copy of its figures: the gap stays open exactly while the card shows a petal that
; is not live, so a wiring PR never has to touch this ledger to stay green.
; --
; Purity: every function is a pure function of the ledger and the done flags; no clock, no
; network. The ledger is data that each tick's inventory rewrites; the readers hold the rules.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27fLiveActorsLoop;

use t27os::live_petal_plan::LP_LIVE;
use t27os::live_petal_plan::LP_SURFACES;
use t27os::live_petal_plan::LP_S_NONE;

/// The number of gap rows in the ledger.
pub const LA_GAPS : u32 = 7;
/// The pick when no candidate is left: the tick stops and reports.
pub const LA_NO_GAP : u32 = 255;

// ---- owner kinds ----

/// Nobody owns the gap: a tick may take it.
pub const LA_OWN_NONE : u8 = 0;
/// An open PR owns the gap.
pub const LA_OWN_PR : u8 = 1;
/// A lane (a worktree on a branch) owns the gap.
pub const LA_OWN_LANE : u8 = 2;
/// The gap waits on a file that an owned gap holds.
pub const LA_OWN_FILE : u8 = 3;

// ---- gap indices ----

pub const LA_G_CARD : u32 = 0;
pub const LA_G_BAND : u32 = 1;
pub const LA_G_PETALS : u32 = 2;
pub const LA_G_KHOP : u32 = 3;
pub const LA_G_WEB : u32 = 4;
pub const LA_G_REDS : u32 = 5;
pub const LA_G_INLINE : u32 = 6;

// ---- the ledger, read on 2026-10-31 against master 8255399175 ----

pub const LA_NAMES : [7]str = [
    "loop card: the gap ledger and the Pareto pick",
    "land the Queen band tap ring from lane/queen-band-graph",
    "bring the next petals live, lowest wave first on the plan card",
    "k-hop reading (milestone M4) fed by live nodes, not the recorded log",
    "t27.ai/t27f/live/ drawing names its source: recorded log, never live",
    "five red checks on master",
    "T27B inline decision glue (Point 2)",
];

pub const LA_KINDS : [7]u8 = [0, 2, 3, 3, 0, 1, 1];

pub const LA_OWNERS : [7]str = [
    "unowned",
    "lane t27os-live-12779 on lane/queen-band-graph",
    "file held: specs/t27os/glass_window.t27 by lane t27os-live-12779",
    "file held: specs/t27os/glass_window.t27 by lane t27os-live-12779",
    "unowned",
    "PR 12967 and PR 12990",
    "PR 12961",
];

pub const LA_IMPACT : [7]u8 = [5, 5, 4, 3, 3, 2, 1];
pub const LA_COST : [7]u8 = [1, 3, 4, 4, 2, 3, 5];

/// The command that measured each row. The web row is measured only as far as the page's status
/// line (live.js says the replay waits and ships a recorded log of 24 events); whether the drawing
/// itself labels the log as recorded is what the next tick settles before it edits anything.
pub const LA_COMMANDS : [7]str = [
    "ls specs/t27f/live_actors_loop.t27",
    "git rev-list --left-right --count origin/master...lane/queen-band-graph",
    "sed -n '/^pub const LP_LIVE/,/];/p' specs/t27os/live_petal_plan.t27",
    "grep -n -i khop specs/t27f/gnn_work_graph_viz.t27",
    "curl -s https://t27.ai/t27f/live/live.js | grep -n -i -E 'fixture|replay|empty'",
    "gh api repos/Trinity-S-AI-DNA/t27/commits/8255399175/check-runs",
    "gh pr view 12961 --repo Trinity-S-AI-DNA/t27 --json mergeStateStatus",
];

/// Which gaps a tick has landed: this card's own PR lands the first, so the card at rest already
/// names the next unowned gap. Each tick's PR flips its own flag.
pub const LA_DONE : [7]u8 = [1, 0, 0, 0, 0, 0, 0];

// ---- readers ----

/// The owner label of gap i, or "unowned".
pub fn la_owner(i : u32) -> str { return LA_OWNERS[i as usize]; }

/// Whether gap i can be taken: nobody owns it and no tick has landed it.
pub fn la_candidate(i : u32, done : []const u8) -> bool {
    return LA_KINDS[i as usize] == LA_OWN_NONE and done[i as usize] == 0;
}

/// Whether gap k dominates gap i: no less impact, no more cost, strictly better in one of them.
pub fn la_dominates(k : u32, i : u32) -> bool {
    const ik : u8 = LA_IMPACT[k as usize];
    const ii : u8 = LA_IMPACT[i as usize];
    const ck : u8 = LA_COST[k as usize];
    const ci : u8 = LA_COST[i as usize];
    return ik >= ii and ck <= ci and (ik > ii or ck < ci);
}

/// Whether gap i is a candidate that no other candidate dominates.
pub fn la_on_front(i : u32, done : []const u8) -> bool {
    if (la_candidate(i, done) == false) { return false; }
    var k : u32 = 0;
    while (k < 7) {
        if (k != i and la_candidate(k, done) and la_dominates(k, i)) { return false; }
        k = k + 1;
    }
    return true;
}

/// The gap this tick works on: the front's best impact per cost (compared by cross product, no
/// division), ties to the lower index. LA_NO_GAP when no candidate is left.
pub fn la_pick(done : []const u8) -> u32 {
    var best : u32 = LA_NO_GAP;
    var i : u32 = 0;
    while (i < 7) {
        if (la_on_front(i, done)) {
            var better : bool = best == LA_NO_GAP;
            if (better == false) {
                const a : u32 = (LA_IMPACT[i as usize] as u32) * (LA_COST[best as usize] as u32);
                const b : u32 = (LA_IMPACT[best as usize] as u32) * (LA_COST[i as usize] as u32);
                better = a > b;
            }
            if (better) { best = i; }
        }
        i = i + 1;
    }
    return best;
}

/// How many petals the plan card shows with no surface at all, counted from the card.
pub fn la_petals_without_surface() -> u32 {
    var i : u32 = 0;
    var n : u32 = 0;
    while (i < 27) {
        if (LP_SURFACES[i as usize] == LP_S_NONE) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// How many petals the plan card shows as fed by real data today, counted from the card.
pub fn la_petals_live() -> u32 {
    var i : u32 = 0;
    var n : u32 = 0;
    while (i < 27) {
        if (LP_LIVE[i as usize] == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// How many petals the plan card marks live although they host no surface; the card's own honesty
/// rule says none.
pub fn la_live_without_surface() -> u32 {
    var i : u32 = 0;
    var n : u32 = 0;
    while (i < 27) {
        if (LP_LIVE[i as usize] == 1 and LP_SURFACES[i as usize] == LP_S_NONE) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// ---- tests ----

fn lal_eq(a : []const u8, b : []const u8) -> bool {
    var same : bool = a.len == b.len;
    var i : usize = 0;
    while (same and i < a.len) { same = a[i] == b[i]; i = i + 1; }
    return same;
}

test every_row_is_scored_owned_named_and_carries_its_command {
    var i : u32 = 0;
    while (i < 7) {
        assert(LA_NAMES[i as usize].len >= 8);
        assert(LA_OWNERS[i as usize].len >= 7);
        assert(LA_COMMANDS[i as usize].len >= 8);
        assert(LA_KINDS[i as usize] <= LA_OWN_FILE);
        assert(LA_IMPACT[i as usize] >= 1 and LA_IMPACT[i as usize] <= 5);
        assert(LA_COST[i as usize] >= 1 and LA_COST[i as usize] <= 5);
        // a row is unowned exactly when its label says so
        assert((LA_KINDS[i as usize] == LA_OWN_NONE) == lal_eq(la_owner(i), "unowned"));
        i = i + 1;
    }
}

test an_owned_gap_is_skipped_and_the_owner_is_named {
    var done : [7]u8 = [0, 0, 0, 0, 0, 0, 0];
    // the band gap carries the most impact per cost after the card, and a lane owns it
    assert(LA_KINDS[LA_G_BAND as usize] == LA_OWN_LANE);
    assert(la_candidate(LA_G_BAND, done[0..7]) == false);
    assert(la_pick(done[0..7]) != LA_G_BAND);
    assert(la_owner(LA_G_BAND).len > 7);
    // no owned gap is ever a candidate or on the front, whatever the tick has landed
    var i : u32 = 0;
    while (i < 7) {
        if (LA_KINDS[i as usize] != LA_OWN_NONE) {
            assert(la_candidate(i, done[0..7]) == false);
            assert(la_on_front(i, done[0..7]) == false);
            assert(la_pick(done[0..7]) != i);
        }
        i = i + 1;
    }
}

test dominance_is_irreflexive_and_never_mutual {
    var i : u32 = 0;
    while (i < 7) {
        assert(la_dominates(i, i) == false);
        var k : u32 = 0;
        while (k < 7) {
            assert((la_dominates(i, k) and la_dominates(k, i)) == false);
            k = k + 1;
        }
        i = i + 1;
    }
}

test the_pareto_front_drops_the_dominated_candidate {
    var done : [7]u8 = [0, 0, 0, 0, 0, 0, 0];
    // the card (impact 5, cost 1) dominates the web gap (3, 2): both unowned, one on the front
    assert(la_dominates(LA_G_CARD, LA_G_WEB));
    assert(la_on_front(LA_G_CARD, done[0..7]));
    assert(la_on_front(LA_G_WEB, done[0..7]) == false);
    // once the card is landed the web gap is the front
    done[0] = 1;
    assert(la_on_front(LA_G_CARD, done[0..7]) == false);
    assert(la_on_front(LA_G_WEB, done[0..7]));
}

test the_pick_walks_the_unowned_gaps_by_pareto_order_and_then_stops {
    var done : [7]u8 = [0, 0, 0, 0, 0, 0, 0];
    assert(la_pick(done[0..7]) == LA_G_CARD);
    done[0] = 1;
    assert(la_pick(done[0..7]) == LA_G_WEB);
    done[4] = 1;
    // nothing unowned is left: the tick stops and reports instead of taking an owned gap
    assert(la_pick(done[0..7]) == LA_NO_GAP);
}

test the_card_at_rest_names_the_next_unowned_gap {
    assert(LA_DONE[LA_G_CARD as usize] == 1);
    assert(la_pick(LA_DONE[0..7]) == LA_G_WEB);
    assert(la_candidate(la_pick(LA_DONE[0..7]), LA_DONE[0..7]));
}

test the_pick_is_always_on_the_front {
    var done : [7]u8 = [0, 0, 0, 0, 0, 0, 0];
    var m : u32 = 0;
    while (m < 3) {
        done[0] = 0;
        done[4] = 0;
        if (m == 1) { done[0] = 1; }
        if (m == 2) { done[0] = 1; done[4] = 1; }
        const p : u32 = la_pick(done[0..7]);
        if (p != LA_NO_GAP) { assert(la_on_front(p, done[0..7])); }
        m = m + 1;
    }
}

test the_petal_gap_stays_open_exactly_while_the_plan_card_shows_a_petal_not_live {
    // read from the card, not copied: the gap closes only when every petal is live
    assert(la_petals_live() < 27);
    assert(la_petals_without_surface() <= 27);
    // honesty rule of the card: a live petal hosts a surface, so none is live without one
    assert(la_live_without_surface() == 0);
}
