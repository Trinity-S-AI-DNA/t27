pub const PHI : f64 = 1.6180339887498948;
pub const PI : f64 = 3.141592653589793;
pub const LN3 : f64 = 1.0986122886681098;
pub const LNPI : f64 = 1.1447298858494002;
pub const LNPHI : f64 = 0.48121182505960347;

pub fn formula_field_start(i : u32, f : u32) -> u32 { return FIELD_START[i * 4 + f]; }
pub fn formula_field_len(i : u32, f : u32) -> u32 { return FIELD_LEN[i * 4 + f]; }
pub fn err_milli_pct(i : u32) -> i64 { return ERR_MILLI_PCT[i]; }
pub fn abs_err(i : u32) -> i64 { if ERR_MILLI_PCT[i] < 0 { return 0 - ERR_MILLI_PCT[i]; } return ERR_MILLI_PCT[i]; }
pub fn repro_milli_pct(i : u32) -> i64 { return REPRO_MILLI_PCT[i]; }
pub fn abs_repro(i : u32) -> i64 { if REPRO_MILLI_PCT[i] < 0 { return 0 - REPRO_MILLI_PCT[i]; } return REPRO_MILLI_PCT[i]; }
pub fn tag_of(i : u32) -> u32 { return TAG_OF[i]; }
/// Is row i within 1 percent of the measured value its source cites, recomputed?
pub fn is_close(i : u32) -> bool { return abs_repro(i) <= CLOSE_MILLI_PCT; }

pub fn tag_count(t : u32) -> u32 {
    var c : u32 = 0;
    var i : u32 = 0;
    while (i < ROW_COUNT) { if TAG_OF[i] == t { c = c + 1; } i = i + 1; }
    return c;
}

fn pow_int(x : f64, n : u32) -> f64 {
    var r : f64 = 1.0;
    var i : u32 = 0;
    while (i < n) { r = r * x; i = i + 1; }
    return r;
}

/// The closed forms of RECIPE_KIND 1..8.
pub fn closed_form(kind : u32) -> f64 {
    if kind == 1 { return @log(2.0) / PI; }
    if kind == 2 { return @log(3.0) / PI; }
    if kind == 3 { return 360.0 / (PHI * PHI) - 2.0 / pow_int(PHI, 3) + 1.0 / pow_int(3.0 * PHI, 5); }
    if kind == 4 { return 1.0 / (pow_int(PHI, 4) + PHI); }
    if kind == 5 { return 1.0 + (1.0 / 137.035999084) / pow_int(PHI, 3); }
    if kind == 6 { return pow_int(5.0 / PHI, 4); }
    const th : f64 = 0.22673;
    if kind == 7 { return @cos(th); }
    const vud : f64 = 7.0 * @exp(3.0 * LNPI - 5.0 * LNPHI - 3.0);
    const ns : f64 = 3.0 * @exp(3.0 * LNPHI - 4.0 * LNPI + 2.0);
    return @exp(ns * @log(vud));
}

/// The value of row i, recomputed from its recipe.
pub fn recipe_value(i : u32) -> f64 {
    if RECIPE_KIND[i] != 0 { return closed_form(RECIPE_KIND[i]); }
    const x : f64 = @as(f64, @floatFromInt(RECIPE_K[i])) * LN3 + @as(f64, @floatFromInt(RECIPE_M[i])) * LNPI + @as(f64, @floatFromInt(RECIPE_P[i])) * LNPHI + @as(f64, @floatFromInt(RECIPE_Q[i]));
    return RECIPE_N[i] * @exp(x);
}

/// The signed error of row i against its measured value, in thousandths of a percent, rounded to the nearest.
pub fn recomputed_milli_pct(i : u32) -> i64 {
    const r : f64 = (recipe_value(i) - MEASURED[i]) / MEASURED[i] * 100000.0;
    if r < 0.0 { return 0 - @as(i64, @intFromFloat(0.5 - r)); }
    return @as(i64, @intFromFloat(r + 0.5));
}

test every_row_is_counted_and_tagged {
    assert FORMULA_COUNT == 32;
    assert ROW_COUNT == 358;
    assert tag_count(TAG_VERIFIED) == 32;
    assert tag_count(TAG_CANDIDATE) == 71;
    assert tag_count(TAG_CONJECTURE) == 255;
    assert tag_count(TAG_VERIFIED) + tag_count(TAG_CANDIDATE) + tag_count(TAG_CONJECTURE) == ROW_COUNT;
}

test verified_rows_come_first_then_candidates_then_conjectures {
    var i : u32 = 1;
    while (i < ROW_COUNT) { assert TAG_OF[i] >= TAG_OF[i - 1]; i = i + 1; }
    assert TAG_OF[0] == TAG_VERIFIED;
    assert TAG_OF[31] == TAG_VERIFIED;
    assert TAG_OF[32] == TAG_CANDIDATE;
    assert TAG_OF[ROW_COUNT - 1] == TAG_CONJECTURE;
}

test fields_tile_the_text_without_gaps {
    assert formula_field_start(0, 0) == 0;
    assert formula_field_start(ROW_COUNT - 1, 3) + formula_field_len(ROW_COUNT - 1, 3) == 30525;
    assert formula_field_start(0, 1) == formula_field_start(0, 0) + formula_field_len(0, 0);
    var k : u32 = 1;
    while (k < ROW_COUNT * 4) {
        assert FIELD_START[k] == FIELD_START[k - 1] + FIELD_LEN[k - 1];
        assert FIELD_LEN[k] > 0;
        k = k + 1;
    }
}

test the_first_32_rows_are_the_registrys_and_unchanged {
    assert err_milli_pct(0) == -620;
    assert abs_err(0) == 620;
    assert abs_err(17) < 2000;
    assert err_milli_pct(3) == 29;
    assert ERR_MILLI_PCT[31] == 94;
}

test every_value_is_recomputed_from_its_recipe_within_1e_9 {
    var i : u32 = 0;
    while (i < ROW_COUNT) {
        const a : f64 = recipe_value(i);
        const b : f64 = VALUE[i];
        assert @abs(a - b) <= 1.0e-9 * @abs(b);
        i = i + 1;
    }
}

test every_error_is_recomputed_from_the_measured_value {
    var i : u32 = 0;
    while (i < ROW_COUNT) {
        const d : i64 = recomputed_milli_pct(i) - REPRO_MILLI_PCT[i];
        assert d >= -1 and d <= 1;
        i = i + 1;
    }
}

test rows_from_32_on_are_all_within_1_percent_and_carry_their_recomputed_error {
    var i : u32 = 32;
    while (i < ROW_COUNT) {
        assert is_close(i);
        assert ERR_MILLI_PCT[i] == REPRO_MILLI_PCT[i];
        i = i + 1;
    }
}

test some_registry_rows_are_not_within_1_percent_when_recomputed {
    var far : u32 = 0;
    var i : u32 = 0;
    while (i < FORMULA_COUNT) { if is_close(i) == false { far = far + 1; } i = i + 1; }
    assert far == 12;
    assert is_close(0);
    assert is_close(8) == false;
    assert is_close(17) == false;
}

test the_close_rows_are_counted_per_tag {
    var v : u32 = 0;
    var c : u32 = 0;
    var j : u32 = 0;
    var i : u32 = 0;
    while (i < ROW_COUNT) {
        if is_close(i) {
            if TAG_OF[i] == TAG_VERIFIED { v = v + 1; }
            if TAG_OF[i] == TAG_CANDIDATE { c = c + 1; }
            if TAG_OF[i] == TAG_CONJECTURE { j = j + 1; }
        }
        i = i + 1;
    }
    assert v == 20;
    assert c == 71;
    assert j == 255;
}
