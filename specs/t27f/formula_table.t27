/// Sector names in order of first appearance: gauge-coupling, electroweak, lepton, quark, ckm, pmns, cosmology, higgs, qcd.
pub const SECTOR_OF : [32]u32 = [0, 0, 0, 0, 0, 0, 1, 1, 2, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 7, 4, 4, 4, 5, 5, 2, 8, 6, 6];

pub fn field_start(i : u32, f : u32) -> u32 { return FIELD_START[i * 4 + f]; }
pub fn field_len(i : u32, f : u32) -> u32 { return FIELD_LEN[i * 4 + f]; }
pub fn err_milli_pct(i : u32) -> i64 { return ERR_MILLI_PCT[i]; }
pub fn abs_err(i : u32) -> i64 { if ERR_MILLI_PCT[i] < 0 { return 0 - ERR_MILLI_PCT[i]; } return ERR_MILLI_PCT[i]; }

test every_row_is_verified_and_counted {
    assert FORMULA_COUNT == 32;
    assert SECTOR_COUNT == 9;
}

test fields_tile_the_text_without_gaps {
    assert field_start(0, 0) == 0;
    assert field_start(31, 3) + field_len(31, 3) == 1949;
    assert field_start(0, 1) == field_start(0, 0) + field_len(0, 0);
    assert field_len(0, 0) > 0;
}

test errors_are_small_and_signed {
    assert err_milli_pct(0) == -620;
    assert abs_err(0) == 620;
    assert abs_err(17) < 2000;
}
