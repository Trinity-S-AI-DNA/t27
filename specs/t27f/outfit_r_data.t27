test glyph_table_matches_hb_shape {
    assert R_ADV[0] == 261;
    assert R_LSB[0] == 63;
    assert R_WID[0] == 129;
    assert R_ADV[40] == 258;
    assert R_LSB[40] == 82;
    assert R_WID[40] == 94;
    assert R_ADV[93] == 542;
    assert R_LSB[93] == 54;
    assert R_WID[93] == 435;
    assert R_LSB[73] == -128;
}

test strip_geometry {
    assert STRIP_W == WORDS_PER_ROW * 32;
    assert STRIP_H > BASELINE;
    assert GLYPHS == 94;
    assert FIRST + GLYPHS == 127;
    assert UPM == 1000;
}

test first_and_last_rows_are_blank {
    var top : u32 = 0;
    var bot : u32 = 0;
    var c : u32 = 0;
    while c < WORDS_PER_ROW {
        top = top | R_INK[c as usize];
        bot = bot | R_INK[((STRIP_H - 1) * WORDS_PER_ROW + c) as usize];
        c = c + 1;
    }
    assert top == 0;
    assert bot == 0;
}

test the_foot_row_has_ink {
    var foot : u32 = 0;
    var c : u32 = 0;
    while c < WORDS_PER_ROW {
        foot = foot | R_INK[((BASELINE - 1) * WORDS_PER_ROW + c) as usize];
        c = c + 1;
    }
    assert foot != 0;
}

test cols_are_the_column_or {
    var bad : u32 = 0;
    var c : u32 = 0;
    while c < WORDS_PER_ROW {
        var acc : u32 = 0;
        var r : u32 = 0;
        while r < STRIP_H {
            acc = acc | R_INK[(r * WORDS_PER_ROW + c) as usize];
            r = r + 1;
        }
        if acc != R_COLS[c as usize] {
            bad = bad + 1;
        }
        c = c + 1;
    }
    assert bad == 0;
}

test cols_control_a_dropped_row_would_differ {
    var bad : u32 = 0;
    var c : u32 = 0;
    while c < WORDS_PER_ROW {
        var acc : u32 = 0;
        var r : u32 = 0;
        while r < STRIP_H {
            if r != BASELINE - 1 {
                acc = acc | R_INK[(r * WORDS_PER_ROW + c) as usize];
            }
            r = r + 1;
        }
        if acc != R_COLS[c as usize] {
            bad = bad + 1;
        }
        c = c + 1;
    }
    assert bad > 0;
}
