// SPDX-License-Identifier: Apache-2.0
; specs/t27f/outfit_r_data.t27 -- Outfit Regular (weight 400) as a 1-bit glyph strip, tool-written data.
; WHY: the owner asked for real typography instead of the 5x7 pixel font (glyph57). t27.ai sets its
; text in Outfit; this module is that face as a source bitmap that vf_type.t27 scales with exact area
; coverage, so text is anti-aliased at any size from about 10 px to 80 px instead of stepping in font
; pixels.
; WHAT IS HERE: R_INK is the strip, STRIP_W x STRIP_H bits, row-major, 32 bits to a word, the leftmost
; pixel in the most significant bit; a set bit is ink. It holds the 94 printable ASCII glyphs (33..126,
; in order, one space between them), the baseline on the edge above row BASELINE (the foot of an H
; is row BASELINE - 1), drawn at EM px to the em. R_COLS is the
; column OR of the strip (a set bit = some row has ink in that column), so each glyph's run can be
; found. R_ADV, R_LSB and R_WID are HarfBuzz's own numbers in font units (1000 to the em): advance, left
; bearing and ink width. Nothing is hand-typed. The functions that read this live in vf_type.t27.
; PROVENANCE (Mac, 2026-11-07; every step is a stock tool, no script written):
;   outfit-latin.woff2 from t27.ai, sha256 92684e4acde79ef07758cd09380b7e01e9824d8b061eddeda046f78c166d7b12
;   fonttools ttLib.woff2 decompress -> outfit.ttf, sha256 c1a939a6521ef97e4223833cea50791352525d778d45c0a531ed1ccc6c530dd3
;   fonttools varLib.instancer -q outfit.ttf wght=400 -o outfit-400.ttf, sha256 538cb9909fd5a2ce15122b9376e5ef73a4a3711078de8e2c191ea1581d36d42a
;   magick -size 7360x88 xc:black +antialias -density 72 -font outfit-400.ttf -pointsize 80 -fill white
;     -annotate +16+68 "@text1.txt" -threshold 50% -negate -depth 1 strip.pbm   (ImageMagick 7.1.2-11;
;     text1.txt = the 94 characters, each followed by one space; ffmpeg here has no drawtext)
;   tail -c +12 strip.pbm > strip.bin, sha256 3014ac27fe90efe5069f08343ce07f9527fbe7e981ba6924bac66ae3af30c335 (the 11-byte PBM header removed)
;   god -An -v --endian=big -tu4 -w32 strip.bin   -> the rows of R_INK below (GNU od, coreutils)
;   magick strip.pbm -crop 7360x1 +repage -evaluate-sequence min -depth 1 cols.pbm  (the min of the 88 rows is
;     the OR of the ink, ink being black); tail -c 920 cols.pbm; the same god command  -> R_COLS
;   hb-shape --font-file=outfit-400.ttf --features=-kern --show-extents --output-format=text
;     --text=<the 94 characters>  (HarfBuzz 14.4.0) -> R_ADV, R_LSB, R_WID
;   sed -E 's/[[:<:]](INK|COLS|ADV|LSB|WID)[[:>:]]/R_\1/g'  (names prefixed so vf_type can import both
;     faces into one module: t27 has no import alias and both modules would otherwise export INK)
; NOT CLAIMED: glyphs are not hinted and pairs are not kerned (kerning is off in hb-shape and the
; strip has a space between glyphs). The 1-bit source is 80 px to the em: above that size edges
; would show the source pixels, so vf_type refuses to draw above 80 px.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_outfit_r_data;

pub const STRIP_W : u32 = 7360;
pub const STRIP_H : u32 = 88;
pub const WORDS_PER_ROW : u32 = 230;
pub const BASELINE : u32 = 68;
pub const EM : u32 = 80;
pub const GLYPHS : u32 = 94;
pub const FIRST : u32 = 33;
pub const UPM : u32 = 1000;

