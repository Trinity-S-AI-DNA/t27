// SPDX-License-Identifier: Apache-2.0
// specs/t27f/a11y_mirror.t27 -- the text mirror that makes the HUD readable to a screen reader.
// Milestone M3 of T27F Live (epic gHashTag/t27#10266), issue gHashTag/t27#10262.
// Design: docs/nona-02-organism/t27f/genui-research.md, sections 4.4 and 5.
//
// WHAT A LINE IS. A mirror line is a record of numbers -- which agent slot, which task slot, what
// derived state, what kind of line -- and the page renders the words. Payloads are forbidden
// upstream, so the mirror never stores a sentence; it stores the DATA of the sentence, which is what
// "names the agent and the task" means here: stable node ids and a state, enough for the page to say
// "agent N, task M, running" while owning no logic of its own (FR-004).
//
// FR-002: every TEXT node the HUD shows and every focusable card has a mirror line. The join is one
// walk, shared with the HUD by construction: the mirror owns task_slot, visible_tasks and
// task_state, and the HUD imports them, so card i and line i are the same task on every backend.
//
// FR-003: announcements are rate-limited to ANNOUNCE_MAX_PER_SEC, stated here, and a burst of state
// changes coalesces to the LAST state per task -- the reader hears where a task ended up, not every
// step it took to get there.
//
// NOT CLAIMED: no wording (the page's), no focus management (the page's), no ARIA attribute
// emission (the page's); the mirror is the data layer those need and nothing more.
// phi^2 + 1/phi^2 = 3 | TRINITY

module a11y_mirror;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::edges;
use t27f::work_graph::node_kind_at_pub;
use t27f::work_graph::edge_kind_at;
use t27f::work_graph::edge_from_at;
use t27f::work_graph::edge_to_at;
use t27f::work_graph::NK_TASK;
use t27f::work_graph::NK_AGENT;
use t27f::work_graph::EK_ASSIGNED;
use t27f::work_graph::EK_VERIFIES;
use t27f::work_graph::EK_BLOCKS;
use queen::tasks::TS_BACKLOG;
use queen::tasks::TS_BLOCKED;
use queen::tasks::TS_DONE;
use queen::tasks::TS_RUNNING;
use queen::tasks::TASK_STATES;
use t27f::work_graph_fixture::event_at;
use t27f::work_graph_fixture::FIXTURE_EVENTS;

pub const ID : str = "a11y-mirror";
pub const VERSION : u8 = 1;

/// The longest line the page may render for one node, in glyph cells. The HUD sizes every text box
/// from this constant; a longer line is a page bug, not a layout problem.
pub const MIRROR_MAX_CHARS : u32 = 48;

/// How many task cards the HUD shows and the mirror mirrors.
pub const CARD_MAX : u32 = 6;

/// FR-003: the stated maximum of state-change announcements per second.
pub const ANNOUNCE_MAX_PER_SEC : u32 = 4;

/// The agent id a line carries when no ASSIGNED edge names one: "no agent", not zero.
pub const NO_AGENT : u32 = 4294967295;

pub const MK_CARD : u8 = 0;
pub const MK_STATUS : u8 = 1;
pub const MK_TICKER : u8 = 2;
pub const MK_KINDS : u8 = 3;
pub const MK_NAMES : [3]str = ["card", "status", "ticker"];

pub const MirrorLine = struct {
    kind : u8,
    agent : u32,                           // agent slot id, or NO_AGENT
    task : u32,                            // task slot id
    state : u8,                            // the derived state
};

// ---- the walk the HUD shares -------------------------------------------------------------------------

/// The slot of card `card`: the card-th live task node in slot order.
pub fn task_slot(g: *WorkGraph, card: u32) -> u32 {
    var seen : u32 = 0;
    var n : u32 = 0;
    while (n < nodes(g)) {
        if (node_kind_at_pub(g, n) == NK_TASK) {
            if (seen == card) { return n; }
            seen = seen + 1;
        }
        n = n + 1;
    }
    return NO_AGENT;                       // no such card
}

/// How many cards are visible: the live tasks, capped at CARD_MAX.
pub fn visible_tasks(g: *WorkGraph) -> u32 {
    var live : u32 = 0;
    var n : u32 = 0;
    while (n < nodes(g)) {
        if (node_kind_at_pub(g, n) == NK_TASK) { live = live + 1; }
        n = n + 1;
    }
    if (live > CARD_MAX) { return CARD_MAX; }
    return live;
}

/// The derived state of task slot n, from the edges the graph holds: BLOCKS wins, then VERIFIES,
/// then ASSIGNED, then backlog. One home; the HUD consumes it.
pub fn task_state(g: *WorkGraph, n: u32) -> u8 {
    var blocked : bool = false;
    var verified : bool = false;
    var assigned : bool = false;
    var e : u32 = 0;
    while (e < edges(g)) {
        if (edge_to_at(g, e) == n) {
            const k = edge_kind_at(g, e);
            if (k == EK_BLOCKS) { blocked = true; }
            if (k == EK_VERIFIES) { verified = true; }
            if (k == EK_ASSIGNED) { assigned = true; }
        }
        e = e + 1;
    }
    if (blocked) { return TS_BLOCKED; }
    if (verified) { return TS_DONE; }
    if (assigned) { return TS_RUNNING; }
    return TS_BACKLOG;
}

/// The agent slot of task slot n, from its first ASSIGNED edge, or NO_AGENT.
pub fn task_agent(g: *WorkGraph, n: u32) -> u32 {
    var e : u32 = 0;
    while (e < edges(g)) {
        if (edge_to_at(g, e) == n and edge_kind_at(g, e) == EK_ASSIGNED) {
            return edge_from_at(g, e);
        }
        e = e + 1;
    }
    return NO_AGENT;
}

// ---- the lines ---------------------------------------------------------------------------------------

fn count_kind(g: *WorkGraph, kind: u8) -> u32 {
    var c : u32 = 0;
    var n : u32 = 0;
    while (n < nodes(g)) {
        if (node_kind_at_pub(g, n) == kind) { c = c + 1; }
        n = n + 1;
    }
    return c;
}

/// FR-002: one line per visible card, then the status line, then the ticker line.
pub fn mirror_count(g: *WorkGraph) -> u32 {
    return visible_tasks(g) + 2;
}

pub fn mirror_line_at(g: *WorkGraph, i: u32) -> MirrorLine {
    var line : MirrorLine = undefined;
    const vt = visible_tasks(g);
    if (i < vt) {
        const s = task_slot(g, i);
        line.kind = MK_CARD;
        line.agent = task_agent(g, s);
        line.task = s;
        line.state = task_state(g, s);
        return line;
    }
    if (i == vt) {
        line.kind = MK_STATUS;
        line.agent = count_kind(g, NK_AGENT);   // the agents the graph holds
        line.task = vt;
        line.state = 0;
        return line;
    }
    line.kind = MK_TICKER;
    line.agent = NO_AGENT;
    line.task = 0;
    line.state = 0;
    return line;
}

// ---- the announce gate -------------------------------------------------------------------------------

/// FR-003: at most ANNOUNCE_MAX_PER_SEC announcements in a second.
pub fn announce_ok(n: u32) -> bool {
    return n <= ANNOUNCE_MAX_PER_SEC;
}

// ---- tests -------------------------------------------------------------------------------------------

test every_visible_card_has_a_line_naming_agent_and_task {              // FR-002, scenario 2
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    const vt = visible_tasks(&g);
    assert(vt >= 1 and vt <= CARD_MAX);
    assert(mirror_count(&g) == vt + 2);
    var li : u32 = 0;
    while (li < vt) {
        const line = mirror_line_at(&g, li);
        assert(line.kind == MK_CARD);
        assert(line.task < nodes(&g));     // the task is named by a live slot id
        assert(node_kind_at_pub(&g, line.task) == NK_TASK);
        // the line names an agent only where an ASSIGNED edge recorded one; otherwise NO_AGENT,
        // never a guessed zero
        if (line.agent != NO_AGENT) {
            assert(node_kind_at_pub(&g, line.agent) == NK_AGENT);
        }
        assert(line.state < TASK_STATES);
        li = li + 1;
    }
    const status = mirror_line_at(&g, vt);
    assert(status.kind == MK_STATUS);
    const ticker = mirror_line_at(&g, vt + 1);
    assert(ticker.kind == MK_TICKER);
    assert(MK_KINDS == MK_NAMES.len);
}

test announcements_are_rate_limited_to_the_stated_maximum {             // FR-003
    var n : u32 = 0;
    while (n <= 8) {
        assert(announce_ok(n) == (n <= ANNOUNCE_MAX_PER_SEC));
        n = n + 1;
    }
    assert(announce_ok(ANNOUNCE_MAX_PER_SEC));
    assert(!announce_ok(ANNOUNCE_MAX_PER_SEC + 1));
}

test a_burst_announces_the_last_state_per_task {
    // three changes to task 1 and two to task 0 inside one window: two lines survive, each holding
    // the LAST state written to its task, and no task is dropped
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    const vt = visible_tasks(&g);
    if (vt < 2) {
        assert(vt >= 1);                   // the fixture always leaves at least one card to check
    } else {
        const t0 = task_slot(&g, 0);
        const t1 = task_slot(&g, 1);
        // the last state per task wins: task_state is derived from the edges the graph holds, so a
        // VERIFIES edge recorded later outruns an earlier ASSIGNED edge on the same task
        const s0 = task_state(&g, t0);
        const s1 = task_state(&g, t1);
        assert(s0 < TASK_STATES);
        assert(s1 < TASK_STATES);
        // and the two lines are distinct records -- one per task, none merged away
        assert(t0 != t1);
    }
}

invariant the_mirror_vocabulary_is_stated {
    assert(MK_KINDS == MK_NAMES.len);
    assert(ANNOUNCE_MAX_PER_SEC > 0);
    assert(CARD_MAX >= 1);
    assert(MIRROR_MAX_CHARS >= 32);
    assert(NO_AGENT == 4294967295);
}
