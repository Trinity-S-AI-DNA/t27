// SPDX-License-Identifier: Apache-2.0
; T27F-005: vf_pixel is a paint-level check on the merged vf_layout rectangles of a visual-factory graph
; Refs gHashTag/t27#13214, epic #13214
; Proves where every pixel of the task card lands, that sibling rectangles do not overlap and that no rectangle leaves its parent
; It is NOT a human-eye proof: it writes no image and says nothing about whether the card looks good
; Reads VfGraph from specs/t27f/visual_factory_contract.t27 and VfLayout from specs/t27f/vf_layout.t27, edits neither
; Limits: one flat fill per kind, no glyphs, no borders, no antialiasing, topmost means highest node index
; Text fit (Refs Trinity-S-AI-DNA/t27#13251): vf_text_overflow_count counts text that does not fit its box by the
; vf_text_measure rule, and vf_overflow_count includes it; it measures chars of the 5x7 font, it paints no glyph
; All arithmetic is u32 and non-negative: compare before subtracting

module t27f_vf_pixel;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CONTAINER;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_validate;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_layout::vf_rect_is;
use t27f::vf_layout::vf_blank_layout;
use t27f::vf_text_measure::vf_text_height;
use t27f::vf_text_measure::vf_text_capacity;
use t27f::vf_text_measure::vf_text_content_w;
use t27f::vf_text_measure::vf_label_width;
use t27f::stories::task_card::task_card_graph;

pub const VF_PX_NONE : u32 = 255;
pub const VF_PX_BG : u32 = 0xFFFFFF;

; fill colour 0xRRGGBB by kind id: none, container, stack, text, button, input, card, badge, list
pub const VF_PALETTE : [9]u32 = [0xFFFFFF, 0xFAFAFA, 0xFAFAFA, 0x222222, 0x1565C0, 0xEEEEEE, 0xF5F5F5, 0x2E7D32, 0xFAFAFA];

; the topmost node covering the pixel, or VF_PX_NONE: a parent has a lower index than its children
; a rectangle covers x <= px < x + w and y <= py < y + h, so right and bottom edges are exclusive
pub fn vf_paint_id(g: VfGraph, l: VfLayout, px: u32, py: u32) -> u32 {
    var best : u32 = VF_PX_NONE;
    var i : u32 = 0;
    while i < l.node_count {
        if px >= l.x[i] and px < l.x[i] + l.w[i] {
            if py >= l.y[i] and py < l.y[i] + l.h[i] {
                best = i;
            }
        }
        i = i + 1;
    }
    return best;
}

pub fn vf_pixel_color(g: VfGraph, l: VfLayout, px: u32, py: u32) -> u32 {
    var id : u32 = vf_paint_id(g, l, px, py);
    if id == VF_PX_NONE {
        return VF_PX_BG;
    }
    var k : u32 = g.kind[id] as u32;
    if k >= 9 {
        k = 0;
    }
    return VF_PALETTE[k];
}

; node pairs i < j under one real parent whose rectangles share positive area
pub fn vf_overlap_count(g: VfGraph, l: VfLayout) -> u32 {
    var cnt : u32 = 0;
    var oi : u32 = 0;
    while oi < l.node_count {
        var oj : u32 = oi + 1;
        while oj < l.node_count {
            if g.parent[oi] == g.parent[oj] and g.parent[oi] != VF_NO_PARENT {
                var ax : bool = l.x[oi] < l.x[oj] + l.w[oj] and l.x[oj] < l.x[oi] + l.w[oi];
                var ay : bool = l.y[oi] < l.y[oj] + l.h[oj] and l.y[oj] < l.y[oi] + l.h[oi];
                if ax and ay {
                    cnt = cnt + 1;
                }
            }
            oj = oj + 1;
        }
        oi = oi + 1;
    }
    return cnt;
}

; text that does not fit its box, one per node: a text node with no room for one char (capacity 0) or whose wrapped
; height (vf_text_height at its width) is over its height; a button or badge whose one-line label width is over its width.
; Empty text never overflows
pub fn vf_text_overflow_count(g: VfGraph, l: VfLayout) -> u32 {
    var cnt : u32 = 0;
    var ti : u32 = 0;
    while ti < l.node_count {
        var tk : u8 = g.kind[ti];
        let ts : str = g.text[ti];
        var bad : bool = false;
        if ts != "" {
            if tk == VF_TEXT {
                if vf_text_capacity(vf_text_content_w(l.w[ti])) == 0 {
                    bad = true;
                } else if vf_text_height(ts, l.w[ti]) > l.h[ti] {
                    bad = true;
                }
            }
            if tk == VF_BUTTON or tk == VF_BADGE {
                if vf_label_width(ts) > l.w[ti] {
                    bad = true;
                }
            }
        }
        if bad {
            cnt = cnt + 1;
        }
        ti = ti + 1;
    }
    return cnt;
}

; nodes whose rectangle leaves the parent rectangle, plus one if the root is wider than the viewport,
; plus vf_text_overflow_count
pub fn vf_overflow_count(g: VfGraph, l: VfLayout) -> u32 {
    var cnt : u32 = 0;
    var fi : u32 = 0;
    while fi < l.node_count {
        if g.parent[fi] != VF_NO_PARENT {
            var pp : u32 = g.parent[fi] as u32;
            var out : bool = false;
            if l.x[fi] < l.x[pp] or l.y[fi] < l.y[pp] {
                out = true;
            }
            if l.x[fi] + l.w[fi] > l.x[pp] + l.w[pp] {
                out = true;
            }
            if l.y[fi] + l.h[fi] > l.y[pp] + l.h[pp] {
                out = true;
            }
            if out {
                cnt = cnt + 1;
            }
        }
        fi = fi + 1;
    }
    if l.node_count > 0 {
        if l.x[0] + l.w[0] > g.viewport_w {
            cnt = cnt + 1;
        }
    }
    cnt = cnt + vf_text_overflow_count(g, l);
    return cnt;
}

; fold the colour of every step-th pixel, row by row, into one checksum: step 0 returns 0
pub fn vf_pixel_sum(g: VfGraph, l: VfLayout, step: u32) -> u32 {
    if step == 0 {
        return 0;
    }
    var acc : u32 = 0;
    if l.node_count == 0 {
        return acc;
    }
    var yy : u32 = 0;
    while yy < l.h[0] {
        var xx : u32 = 0;
        while xx < g.viewport_w {
            var c : u32 = vf_pixel_color(g, l, xx, yy);
            acc = (acc * 31 + c) % 1000003;
            xx = xx + step;
        }
        yy = yy + step;
    }
    return acc;
}

; fixtures: the task card at one viewport width
pub fn vf_px_card(width: u32) -> VfGraph {
    var g : VfGraph = task_card_graph();
    g.viewport_w = width;
    return g;
}

; 0 when all eight task-card rectangles match, else the first wrong node index plus one
; the title "Write the spec" is 83 px in an 80 px box, so it wraps to 2 lines (30 px) and the card is 202 tall, not 192
fn vf_px_rects_bad(l: VfLayout, w: u32) -> u32 {
    if vf_rect_is(l, 0, 0, 0, w, 202) == false {
        return 1;
    }
    if vf_rect_is(l, 1, 8, 8, 80, 30) == false {
        return 2;
    }
    if vf_rect_is(l, 2, 8, 46, 48, 24) == false {
        return 3;
    }
    if vf_rect_is(l, 3, 8, 78, 80, 20) == false {
        return 4;
    }
    if vf_rect_is(l, 4, 8, 106, 160, 40) == false {
        return 5;
    }
    if vf_rect_is(l, 5, 8, 154, 200, 40) == false {
        return 6;
    }
    if vf_rect_is(l, 6, 8, 154, 96, 40) == false {
        return 7;
    }
    if vf_rect_is(l, 7, 112, 154, 96, 40) == false {
        return 8;
    }
    return 0;
}

; fixture: a column container holding one text node with text s
fn vf_px_one_text(s: str) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    g.viewport_w = 375;
    g = vf_add(g, VF_CONTAINER, VF_NO_PARENT, 32, "root");
    g = vf_add(g, VF_TEXT, 0, 33, "body");
    g.text[1] = s;
    g.direction[0] = DIR_COLUMN;
    return g;
}

; a hand-built layout for vf_px_one_text: the root 375 x 100, the text in the old fixed 80 x 20 box at (8, 8)
fn vf_px_old_box() -> VfLayout {
    var l : VfLayout = vf_blank_layout();
    l.node_count = 2;
    l.w[0] = 375;
    l.h[0] = 100;
    l.x[1] = 8;
    l.y[1] = 8;
    l.w[1] = 80;
    l.h[1] = 20;
    return l;
}

test task_card_rects {
    var a : VfGraph = vf_px_card(375);
    assert vf_px_rects_bad(vf_layout(a), 375) == 0;
    var b : VfGraph = vf_px_card(768);
    assert vf_px_rects_bad(vf_layout(b), 768) == 0;
    var c : VfGraph = vf_px_card(1280);
    assert vf_px_rects_bad(vf_layout(c), 1280) == 0;
}

test paint_ids_at_375 {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_paint_id(g, l, 0, 0) == 0;
    assert vf_paint_id(g, l, 8, 8) == 1;
    assert vf_paint_id(g, l, 87, 27) == 1;
    assert vf_paint_id(g, l, 88, 8) == 0;
    assert vf_paint_id(g, l, 87, 37) == 1;
    assert vf_paint_id(g, l, 10, 40) == 0;
    assert vf_paint_id(g, l, 10, 50) == 2;
    assert vf_paint_id(g, l, 8, 78) == 3;
    assert vf_paint_id(g, l, 20, 110) == 4;
    assert vf_paint_id(g, l, 50, 160) == 6;
    assert vf_paint_id(g, l, 106, 160) == 5;
    assert vf_paint_id(g, l, 120, 160) == 7;
    assert vf_paint_id(g, l, 300, 150) == 0;
    assert vf_paint_id(g, l, 374, 201) == 0;
    assert vf_paint_id(g, l, 0, 202) == VF_PX_NONE;
    assert vf_paint_id(g, l, 375, 0) == VF_PX_NONE;
}

test paint_ids_at_1280 {
    var g : VfGraph = vf_px_card(1280);
    var l : VfLayout = vf_layout(g);
    assert vf_paint_id(g, l, 1279, 201) == 0;
    assert vf_paint_id(g, l, 1280, 0) == VF_PX_NONE;
    assert vf_paint_id(g, l, 1200, 100) == 0;
    assert vf_paint_id(g, l, 50, 160) == 6;
    assert vf_paint_id(g, l, 120, 160) == 7;
}

test colors {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_pixel_color(g, l, 8, 8) == VF_PALETTE[VF_TEXT as u32];
    assert vf_pixel_color(g, l, 50, 160) == VF_PALETTE[VF_BUTTON as u32];
    assert vf_pixel_color(g, l, 10, 50) == VF_PALETTE[VF_BADGE as u32];
    assert vf_pixel_color(g, l, 300, 150) == VF_PALETTE[VF_CARD as u32];
    assert vf_pixel_color(g, l, 0, 202) == VF_PX_BG;
    assert vf_pixel_color(g, l, 8, 8) == 0x222222;
    assert vf_pixel_color(g, l, 50, 160) == 0x1565C0;
    assert vf_pixel_color(g, l, 10, 50) == 0x2E7D32;
    assert vf_pixel_color(g, l, 300, 150) == 0xF5F5F5;
}

test no_overlap_no_overflow {
    var a : VfGraph = vf_px_card(375);
    var la : VfLayout = vf_layout(a);
    assert vf_overlap_count(a, la) == 0;
    assert vf_overflow_count(a, la) == 0;
    var b : VfGraph = vf_px_card(768);
    var lb : VfLayout = vf_layout(b);
    assert vf_overlap_count(b, lb) == 0;
    assert vf_overflow_count(b, lb) == 0;
    var c : VfGraph = vf_px_card(1280);
    var lc : VfLayout = vf_layout(c);
    assert vf_overlap_count(c, lc) == 0;
    assert vf_overflow_count(c, lc) == 0;
}

test negative_controls {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    l.x[7] = 100;
    assert vf_overlap_count(g, l) == 1;
    assert vf_overflow_count(g, l) == 0;
    l = vf_layout(g);
    l.w[1] = 400;
    assert vf_overflow_count(g, l) == 1;
    l = vf_layout(g);
    l.y[4] = 400;
    assert vf_overflow_count(g, l) == 1;
    l = vf_layout(g);
    assert vf_overlap_count(g, l) == 0;
    assert vf_overflow_count(g, l) == 0;
}

test text_overflow_counts_what_does_not_fit {
    // 78 chars at capacity 12 are 7 lines, 80 px tall: they do not fit the old fixed 80 x 20 box
    let s78 : str = "012345678901234567890123456789012345678901234567890123456789012345678901234567";
    var g : VfGraph = vf_px_one_text(s78);
    assert vf_validate(g) == 0;
    var l : VfLayout = vf_px_old_box();
    assert vf_text_height(s78, 80) == 80;
    assert vf_text_overflow_count(g, l) == 1;
    assert vf_overflow_count(g, l) == 1;
    // vf_layout measures it: 80 wide, 80 tall, and nothing overflows
    let m : VfLayout = vf_layout(g);
    assert vf_rect_is(m, 1, 0, 0, 80, 80);
    assert vf_text_overflow_count(g, m) == 0;
    assert vf_overflow_count(g, m) == 0;
    // no room: a 12 px box has capacity 0, so even one char counts
    l.w[1] = 12;
    g.text[1] = "x";
    assert vf_text_overflow_count(g, l) == 1;
    // the task card: a 30 px button cannot hold "Save" (31 px), and a 1-line title box cannot hold 2 lines
    var c : VfGraph = vf_px_card(375);
    var lc : VfLayout = vf_layout(c);
    lc.w[6] = 30;
    assert vf_text_overflow_count(c, lc) == 1;
    assert vf_overflow_count(c, lc) == 1;
    lc = vf_layout(c);
    lc.h[1] = 20;
    assert vf_text_overflow_count(c, lc) == 1;
}

test text_overflow_negative_controls {
    // a short text in the same hand-built 80 x 20 box fits, and so does an empty one
    var g : VfGraph = vf_px_one_text("Owner");
    var l : VfLayout = vf_px_old_box();
    assert vf_text_overflow_count(g, l) == 0;
    assert vf_overflow_count(g, l) == 0;
    g.text[1] = "";
    assert vf_text_overflow_count(g, l) == 0;
    // the 12-char label is exactly capacity at 80: one line, fits
    g.text[1] = "abcdefghijkl";
    assert vf_text_overflow_count(g, l) == 0;
    // the laid-out task card has no text overflow at any width
    assert vf_text_overflow_count(vf_px_card(375), vf_layout(vf_px_card(375))) == 0;
    assert vf_text_overflow_count(vf_px_card(1280), vf_layout(vf_px_card(1280))) == 0;
}

test pixel_sum_is_deterministic {
    var ga : VfGraph = vf_px_card(375);
    var la : VfLayout = vf_layout(ga);
    var gb : VfGraph = vf_px_card(1280);
    var lb : VfLayout = vf_layout(gb);
    var s1 : u32 = vf_pixel_sum(ga, la, 8);
    var s2 : u32 = vf_pixel_sum(ga, la, 8);
    assert s1 == s2;
    assert s1 != 0;
    assert s1 != vf_pixel_sum(gb, lb, 8);
    assert vf_pixel_sum(ga, la, 0) == 0;
}
