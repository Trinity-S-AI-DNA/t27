// SPDX-License-Identifier: Apache-2.0
; specs/t27f/vf_proportion_card_main.t27 -- host program: the first specimen of vf_proportion (Refs Trinity-S-AI-DNA/t27#13251,
; proportion ring 1 and the start of ring 2). It prints the token sheet with provenance (spacing, type, split, the touch
; target) and draws the existing task card (specs/t27f/stories/task_card.t27) at 375x812 twice: BEFORE with its hand
; spacing (padding 8, gaps 8, controls 40 high) and AFTER with spacing tokens applied by node kind (vpc_apply), plus the
; pixel diff. Files: target/course/vp/card_375_{before,after,diff}.ppm; the sheet and both layouts go to stderr.
; --
; vpc_apply is a specimen of the theme step, kept here and not in a theme module while draft PR #13254 owns vf_theme: a
; card gets padding space[0] and gap space[-2], a stack gets gap space[-2], a button or input gets min_h from the type
; step type[1] raised to the 44 px touch minimum (the floor decides that height, not phi). It reads node kinds only, never
; coordinates. vpc_offgrid_count and vpc_small_target_count are the two lints the tests run on BEFORE and AFTER.
; --
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM, and the pixel diff is not a quality score. The tests pin the token values, that
; the meaning digest stays, that the geometry moves, that no node overflows, and the two lints. Whether AFTER reads better
; than BEFORE is for a person who has opened both frames.
; --
; BUILD AND RUN (a heavy build: in a T27 OS pane or on the lab, not on the Mac without the owner's word):
;   t27c gen specs/t27f/vf_proportion_card_main.t27 > vpc.zig
;   zig build-exe vpc.zig -lc
;   mkdir -p target/course/vp
;   ./vpc 2> target/course/vp/sheet.txt
; An unopenable path or a short write exits 2; a render or diff refusal exits 1.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module VfProportionCardMain;

use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_overlap_count;
use t27f::vf_pixel::vf_overflow_count;
use t27f::vf_render::vf_render_ppm;
use t27f::vf_render::VF_R_OK;
use t27f::vf_meaning::vf_kind_word;
use t27f::vf_meaning::vf_meaning_digest;
use t27f::vf_meaning::vf_spatial_digest;
use t27f::vf_diff::VfDiffBox;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_diff::vf_diff_bbox;
use t27f::vf_diff::vf_diff_frame;
use t27f::vf_diff::VF_D_OK;
use t27f::stories::task_card::task_card_graph;
use t27f::vf_proportion::VfToken;
use t27f::vf_proportion::VfSplit;
use t27f::vf_proportion::vf_prop_token;
use t27f::vf_proportion::vf_prop_floor;
use t27f::vf_proportion::vf_prop_split;
use t27f::vf_proportion::vf_prop_milli;
use t27f::vf_proportion::VP_SPACE;
use t27f::vf_proportion::VP_TYPE;
use t27f::vf_proportion::VP_REM_PX;
use t27f::vf_proportion::VP_TOUCH_MIN_PX;
use t27f::vf_proportion::VP_EXC_TOUCH_MIN;

pub var VPC_RGB_A : [913500]u8 = [0] ** 913500;
pub var VPC_PPM_A : [913515]u8 = [0] ** 913515;
pub var VPC_RGB_B : [913500]u8 = [0] ** 913500;
pub var VPC_PPM_B : [913515]u8 = [0] ** 913515;
pub var VPC_RGB_D : [913500]u8 = [0] ** 913500;

pub const VPC_W : u32 = 375;
pub const VPC_H : u32 = 812;
pub const VPC_HDR : usize = 15;
pub const VPC_RGB : usize = 913500;
pub const VPC_BYTES : usize = 913515;

/// One spacing step at 1 rem: round_half_up(16 * phi^(p2 / 2)) px; 0 for a step outside the profile.
pub fn vpc_space(p2: i32) -> u32 {
    return vf_prop_token(VP_SPACE, VP_REM_PX, 0, 0, p2, 0).value;
}

/// The control height: the type step type[1] (16 * phi^(1/2), 20 px) raised to the 44 px touch minimum.
pub fn vpc_target() -> VfToken {
    return vf_prop_floor(vf_prop_token(VP_TYPE, VP_REM_PX, 0, 0, 1, 0), VP_TOUCH_MIN_PX, VP_EXC_TOUCH_MIN);
}

/// The specimen theme step: spacing tokens by node kind, never by position or coordinate.
pub fn vpc_apply(g: VfGraph) -> VfGraph {
    var r : VfGraph = g;
    let t : u32 = vpc_target().value;
    var i : u32 = 0;
    while i < r.node_count {
        if r.kind[i] == VF_CARD {
            r.padding[i] = vpc_space(0);
            r.gap[i] = vpc_space(0 - 2);
        }
        if r.kind[i] == VF_STACK {
            r.gap[i] = vpc_space(0 - 2);
        }
        if r.kind[i] == VF_BUTTON or r.kind[i] == VF_INPUT {
            if r.min_h[i] < t {
                r.min_h[i] = t;
            }
        }
        i = i + 1;
    }
    return r;
}

/// Whether v is 0 or one of the spacing steps at 1 rem.
pub fn vpc_on_grid(v: u32) -> bool {
    if v == 0 {
        return true;
    }
    var p2 : i32 = 0 - 4;
    while p2 <= 8 {
        if vpc_space(p2) == v {
            return true;
        }
        p2 = p2 + 2;
    }
    return false;
}

/// Lint: how many padding and gap values of g sit off the spacing grid.
pub fn vpc_offgrid_count(g: VfGraph) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count {
        if vpc_on_grid(g.padding[i]) == false {
            n = n + 1;
        }
        if vpc_on_grid(g.gap[i]) == false {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// Lint: how many buttons and inputs are laid out under 44 px high or wide.
pub fn vpc_small_target_count(g: VfGraph, l: VfLayout) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < l.node_count {
        if g.kind[i] == VF_BUTTON or g.kind[i] == VF_INPUT {
            if l.h[i] < VP_TOUCH_MIN_PX or l.w[i] < VP_TOUCH_MIN_PX {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

pub fn main() void {
    std.debug.print("vf_proportion token sheet: n = {d} px (1 rem), integer nano arithmetic, one half-up rounding\n", .{VP_REM_PX});
    std.debug.print("spacing profile (n 8..32, p even -4..8 in halves, value 4..128 px):\n", .{});
    var p2 : i32 = 0 - 4;
    while (p2 <= 8) {
        const t : VfToken = vf_prop_token(VP_SPACE, VP_REM_PX, 0, 0, p2, 0);
        std.debug.print("  space[{d}] = {d} px, {d} mrem, round_half_up(16 * phi^({d}/2)), raw {d}, clamp {d}, exc {d}, status {d}\n", .{ p2, t.value, vf_prop_milli(t), p2, t.raw, t.clamp, t.exc, t.status });
        p2 += 2;
    }
    std.debug.print("type profile (n 12..20, p -2..8 in halves, value 10..128 px; printed only, the renderer has one 5x7 font):\n", .{});
    var q2 : i32 = 0 - 2;
    while (q2 <= 8) {
        const t : VfToken = vf_prop_token(VP_TYPE, VP_REM_PX, 0, 0, q2, 0);
        std.debug.print("  type[{d}] = {d} px, {d} mrem, round_half_up(16 * phi^({d}/2)), raw {d}, clamp {d}, exc {d}, status {d}\n", .{ q2, t.value, vf_prop_milli(t), q2, t.raw, t.clamp, t.exc, t.status });
        q2 += 1;
    }
    const tg : VfToken = vpc_target();
    std.debug.print("touch target = {d} px: type[1] raw {d} raised by the floor {d}, exc {d} (1 = TOUCH_MIN, specs/ui/viewport.t27)\n", .{ tg.value, tg.raw, VP_TOUCH_MIN_PX, tg.exc });
    std.debug.print("split profile (major = round_half_up(n * phi^-1), minor = n - major):\n", .{});
    const sa : VfSplit = vf_prop_split(375);
    const sb : VfSplit = vf_prop_split(768);
    const sc : VfSplit = vf_prop_split(1280);
    std.debug.print("  375 -> {d} + {d}; 768 -> {d} + {d}; 1280 -> {d} + {d}\n", .{ sa.major, sa.minor, sb.major, sb.minor, sc.major, sc.minor });
    std.debug.print("not in this slice: 3^k, pi^m, e^q (any non-zero exponent is refused), the motion profile\n", .{});

    const gb : VfGraph = task_card_graph();
    const lb : VfLayout = vf_layout(gb);
    const ga : VfGraph = vpc_apply(gb);
    const la : VfLayout = vf_layout(ga);
    if (vf_render_ppm(gb, lb, &VPC_RGB_A, &VPC_PPM_A, VPC_W, VPC_H) != VF_R_OK) {
        std.debug.print("vpc: BEFORE render refused\n", .{});
        std.c.exit(1);
    }
    if (vf_render_ppm(ga, la, &VPC_RGB_B, &VPC_PPM_B, VPC_W, VPC_H) != VF_R_OK) {
        std.debug.print("vpc: AFTER render refused\n", .{});
        std.c.exit(1);
    }
    if (vf_diff_frame(&VPC_RGB_A, &VPC_RGB_B, &VPC_RGB_D, VPC_W, VPC_H) != VF_D_OK) {
        std.debug.print("vpc: diff refused\n", .{});
        std.c.exit(1);
    }
    var f : u8 = 0;
    while (f < 3) {
        var path : [*:0]const u8 = "target/course/vp/card_375_before.ppm";
        if (f == 1) { path = "target/course/vp/card_375_after.ppm"; }
        if (f == 2) { path = "target/course/vp/card_375_diff.ppm"; }
        const fp = std.c.fopen(path, "wb");
        if (fp == null) {
            std.debug.print("vpc: cannot open {s} for writing\n", .{path});
            std.c.exit(2);
        }
        var wn : usize = 0;
        if (f == 0) { wn = std.c.fwrite(@ptrCast(&VPC_PPM_A), 1, VPC_BYTES, fp.?); }
        if (f == 1) { wn = std.c.fwrite(@ptrCast(&VPC_PPM_B), 1, VPC_BYTES, fp.?); }
        if (f == 2) {
            wn = std.c.fwrite(@ptrCast(&VPC_PPM_A), 1, VPC_HDR, fp.?);
            wn += std.c.fwrite(@ptrCast(&VPC_RGB_D), 1, VPC_RGB, fp.?);
        }
        _ = std.c.fclose(fp.?);
        if (wn != VPC_BYTES) {
            std.debug.print("vpc: short write to {s}: {d} of {d} bytes\n", .{ path, wn, VPC_BYTES });
            std.c.exit(2);
        }
        std.debug.print("wrote {d} bytes to {s}\n", .{ wn, path });
        f += 1;
    }
    const bx : VfDiffBox = vf_diff_bbox(&VPC_RGB_A, &VPC_RGB_B, VPC_W, VPC_H);
    std.debug.print("diff: {d} pixels differ, bbox {d},{d}-{d},{d} (a count, not a quality score)\n", .{ vf_diff_count(&VPC_RGB_A, &VPC_RGB_B, VPC_W, VPC_H), bx.x0, bx.y0, bx.x1, bx.y1 });
    std.debug.print("BEFORE: meaning {d} spatial {d} overlap {d} overflow {d} off-grid {d} small targets {d}\n", .{ vf_meaning_digest(gb), vf_spatial_digest(gb, lb), vf_overlap_count(gb, lb), vf_overflow_count(gb, lb), vpc_offgrid_count(gb), vpc_small_target_count(gb, lb) });
    std.debug.print("AFTER:  meaning {d} spatial {d} overlap {d} overflow {d} off-grid {d} small targets {d}\n", .{ vf_meaning_digest(ga), vf_spatial_digest(ga, la), vf_overlap_count(ga, la), vf_overflow_count(ga, la), vpc_offgrid_count(ga), vpc_small_target_count(ga, la) });
    std.debug.print("changed fields: node kind field before -> after (token)\n", .{});
    var i : u32 = 0;
    while (i < gb.node_count) {
        if (gb.padding[i] != ga.padding[i]) { std.debug.print("  {d} {s} padding {d} -> {d} (space[0])\n", .{ i, vf_kind_word(gb, i), gb.padding[i], ga.padding[i] }); }
        if (gb.gap[i] != ga.gap[i]) { std.debug.print("  {d} {s} gap {d} -> {d} (space[-2])\n", .{ i, vf_kind_word(gb, i), gb.gap[i], ga.gap[i] }); }
        if (gb.min_h[i] != ga.min_h[i]) { std.debug.print("  {d} {s} min_h {d} -> {d} (type[1] floored to touch)\n", .{ i, vf_kind_word(gb, i), gb.min_h[i], ga.min_h[i] }); }
        i += 1;
    }
    std.debug.print("layout: node kind BEFORE x,y wxh | AFTER x,y wxh [text]\n", .{});
    var j : u32 = 0;
    while (j < lb.node_count) {
        std.debug.print("  {d} {s} {d},{d} {d}x{d} | {d},{d} {d}x{d} [{s}]\n", .{ j, vf_kind_word(gb, j), lb.x[j], lb.y[j], lb.w[j], lb.h[j], la.x[j], la.y[j], la.w[j], la.h[j], gb.text[j] });
        j += 1;
    }
    std.debug.print("vpc: open BEFORE, AFTER and the diff before saying AFTER looks better\n", .{});
}

test the_tokens_replace_the_hand_spacing {
    let b : VfGraph = task_card_graph();
    let a : VfGraph = vpc_apply(b);
    assert b.padding[0] == 8;
    assert b.gap[0] == 8;
    assert b.gap[5] == 8;
    assert a.padding[0] == 16;
    assert a.gap[0] == 10;
    assert a.gap[5] == 10;
    assert a.min_h[4] == 44;
    assert a.min_h[6] == 44;
    assert a.min_h[7] == 44;
    // a text node gets nothing
    assert a.min_h[1] == 0;
}

test the_apply_is_a_fixed_point {
    let a : VfGraph = vpc_apply(task_card_graph());
    let aa : VfGraph = vpc_apply(a);
    var i : u32 = 0;
    while i < a.node_count {
        assert aa.padding[i] == a.padding[i];
        assert aa.gap[i] == a.gap[i];
        assert aa.min_h[i] == a.min_h[i];
        i = i + 1;
    }
}

test the_offgrid_lint_finds_the_hand_spacing {
    // BEFORE: padding 8 of the card, gap 8 of the card, gap 8 of the action row; AFTER: none
    assert vpc_offgrid_count(task_card_graph()) == 3;
    assert vpc_offgrid_count(vpc_apply(task_card_graph())) == 0;
    // negative control: one broken gap is found
    var g : VfGraph = vpc_apply(task_card_graph());
    g.gap[5] = 9;
    assert vpc_offgrid_count(g) == 1;
    assert vpc_on_grid(10);
    assert vpc_on_grid(9) == false;
}

test the_targets_reach_44_after_and_not_before {
    let gb : VfGraph = task_card_graph();
    let lb : VfLayout = vf_layout(gb);
    let ga : VfGraph = vpc_apply(gb);
    let la : VfLayout = vf_layout(ga);
    assert lb.h[6] == 40;
    assert vpc_small_target_count(gb, lb) == 3;
    assert la.h[4] == 44;
    assert la.h[6] == 44;
    assert la.h[7] == 44;
    assert vpc_small_target_count(ga, la) == 0;
}

test the_meaning_stays_and_the_geometry_moves {
    let gb : VfGraph = task_card_graph();
    let ga : VfGraph = vpc_apply(gb);
    assert vf_meaning_digest(ga) == vf_meaning_digest(gb);
    assert vf_spatial_digest(ga, vf_layout(ga)) != vf_spatial_digest(gb, vf_layout(gb));
}

test both_fit_the_frame_without_overflow {
    let gb : VfGraph = task_card_graph();
    let lb : VfLayout = vf_layout(gb);
    let ga : VfGraph = vpc_apply(gb);
    let la : VfLayout = vf_layout(ga);
    assert vf_overflow_count(gb, lb) == 0;
    assert vf_overflow_count(ga, la) == 0;
    assert la.w[0] <= VPC_W;
    assert la.y[0] + la.h[0] <= VPC_H;
}

test the_after_frame_differs_and_a_frame_has_no_diff_with_itself {
    let gb : VfGraph = task_card_graph();
    let ga : VfGraph = vpc_apply(gb);
    assert vf_render_ppm(gb, vf_layout(gb), &VPC_RGB_A, &VPC_PPM_A, VPC_W, VPC_H) == VF_R_OK;
    assert vf_render_ppm(ga, vf_layout(ga), &VPC_RGB_B, &VPC_PPM_B, VPC_W, VPC_H) == VF_R_OK;
    assert vf_diff_count(&VPC_RGB_A, &VPC_RGB_B, VPC_W, VPC_H) > 0;
    assert vf_diff_count(&VPC_RGB_A, &VPC_RGB_A, VPC_W, VPC_H) == 0;
}
