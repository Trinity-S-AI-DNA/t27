// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_title.t27 -- scene A_TITLE of reel_factory.t27: the lesson's own title as big
// kinetic letters. Eleven letters a line at scale 7, every letter on its own wave so the line
// ripples, with a hard shadow under it and every third letter in the accent.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: for a lesson that has no picture of its own the honest picture is its name. Different
// titles are different lengths and break into different lines, so no two lessons draw one wall of
// text.
//
// THE FUNCTION: title_px(t, acc, n, x, y) is the colour of canvas point (x, y). Letter k of line r
// stands at x = 26 + 28 * k, y = y0 + 50 * r + wave; y0 centres the block on the canvas.
//
// NOT CLAIMED: it breaks on every 11th letter, not on word boundaries.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_title;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::char_on;
use t27f::scene_raster::tri_wave;
use t27f::scene_raster::imin;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::reel_topics::item;
use t27f::reel_topics::item_len;
use t27f::reel_topics::cp;

pub const PER_LINE : i32 = 11;
pub const LX0 : i32 = 26;
pub const ADV : i32 = 28;
pub const PITCH : i32 = 50;
pub const SHADOW : i32 = 5;

pub fn title_len(t: usize) -> i32 {
    return @as(i32, @intCast(item_len(item(t, 0, 0))));
}
pub fn title_lines(t: usize) -> i32 {
    return imin(@divTrunc(title_len(t) + PER_LINE - 1, PER_LINE), 8);
}
pub fn title_ch(t: usize, i: i32) -> i32 {
    if (i < 0 || i >= title_len(t)) { return 0; }
    return @as(i32, @intCast(cp(item(t, 0, 0), @as(usize, @intCast(i)))));
}
// The top of the block of title lines, so that it sits in the middle of the canvas.
pub fn title_y0(t: usize) -> i32 {
    return 320 - @divTrunc(title_lines(t) * PITCH, 2);
}
// How far letter i is lifted off its line.
pub fn wave(t: usize, i: i32) -> i32 {
    return tri_wave(i * 9 + @as(i32, @intCast(t)) * 5, 40, 14);
}

// Whether letter i of the title is drawn at canvas point (x, y), shifted by (sx, sy).
pub fn letter_on(t: usize, i: i32, x: i32, y: i32, sx: i32, sy: i32) -> bool {
    const c = title_ch(t, i);
    if (c <= 32) { return false; }
    const k = @mod(i, PER_LINE);
    const r = @divTrunc(i, PER_LINE);
    return char_on(c, x - sx, y - sy, LX0 + k * ADV, title_y0(t) + r * PITCH - wave(t, i) + 14, 7);
}

pub fn title_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(3, acc, seed_of(t, n, 9), x, y);
    const k = @divTrunc(x - LX0, ADV);
    if (x < LX0 || k >= PER_LINE) { return c0; }
    const lines = title_lines(t);
    const dy = y - title_y0(t);
    if (dy < 0 - SHADOW || dy > lines * PITCH + 30) { return c0; }
    var r : i32 = 0;
    while (r < lines) {
        const i = r * PER_LINE + k;
        if (letter_on(t, i, x, y, 0, 0)) {
            if (@mod(i, 3) == 0) { return acc; }
            return rgb(245, 247, 255);
        }
        if (letter_on(t, i, x, y, SHADOW, SHADOW)) { return rgb(4, 5, 12); }
        r = r + 1;
    }
    return c0;
}

// ---- tests ----

test "the title is the lesson's own, in letters the font draws" {
    var t : usize = 0;
    while (t < 27) {
        assert(title_len(t) > 2);
        assert(title_lines(t) >= 1 && title_lines(t) <= 8);
        assert(title_y0(t) >= 100 && title_y0(t) <= 300);
        t = t + 1;
    }
    assert(title_ch(0, 0) > 32);
    assert(title_ch(0, 900) == 0);
}

test "the letters ripple, each on its own wave" {
    var seen : i32 = 0;
    var i : i32 = 0;
    while (i < 11) {
        assert(wave(5, i) >= 0 && wave(5, i) < 14);
        if (wave(5, i) != wave(5, 0)) { seen = seen + 1; }
        i = i + 1;
    }
    assert(seen > 6);
}

test "another title draws another wall of letters" {
    var white : i32 = 0;
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = title_px(2, 0xF5B700, 3, x, y);
            const b = title_px(23, 0xF5B700, 3, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a == 0xF5F7FF) { white = white + 1; }
            if (a != b) { diff = diff + 1; }
            x = x + 2;
        }
        y = y + 2;
    }
    assert(white > 100);
    assert(diff > 5000);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (title_px(11, 0x3B82F6, 6, x, y) != title_px(11, 0x3B82F6, 6, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
