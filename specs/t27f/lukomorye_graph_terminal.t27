use t27os::t27m::TM_FC_PERMANENT;
use t27os::t27r::TR_E_OK;
use t27os::t27r::TR_E_UNVERIFIED;
use t27os::t27r::TR_E_DISPUTED;
use t27os::t27l::tl_action_id;

// ---- layers of the oak ----

pub const LK_L_ROOT : u8 = 0;
pub const LK_L_TRUNK : u8 = 1;
pub const LK_L_BRANCH : u8 = 2;
pub const LK_L_TWIG : u8 = 3;
pub const LK_L_LEAF : u8 = 4;
pub const LK_L_SPACE : u8 = 5;
pub const LK_L_COUNT : u8 = 6;

pub const LK_COL : i32 = SPACE_3;
pub const LK_ROW : i32 = SPACE_4 * 3;

/// The layer of a node from its kind; an artifact is a leaf only when verified, else a bud on the twigs.
pub fn lk_layer_of(kind: u8, verified: bool) -> u8 {
    if (kind == NK_SPEC || kind == NX_ROOT) { return LK_L_ROOT; }
    if (kind == NX_TRUNK) { return LK_L_TRUNK; }
    if (kind == NX_EPIC) { return LK_L_BRANCH; }
    if (kind == NX_ISSUE) { return LK_L_TWIG; }
    if (wx_is_artifact(kind)) {
        if (verified) { return LK_L_LEAF; }
        return LK_L_TWIG;
    }
    return LK_L_SPACE;
}

/// The scenario act of a layer: 1 roots, 2 trunk, 3 branches, 4 twigs, 5 leaves, 6 space.
pub fn lk_act_of(layer: u8) -> u8 {
    return layer + 1;
}

/// The tree layout of the graph. Arrays are indexed by node number; order[] holds node numbers in
/// growth order. parent[] is NODE_CAP for a node with no BELONGS_TO edge.
pub struct LkLayout {
    n: u32,
    layer: [2048]u8,
    bud: [2048]u8,
    ver: [2048]u8,
    parent: [2048]u32,
    rank: [2048]u32,
    slot: [2048]u32,
    order: [2048]u32,
    x: [2048]i32,
    y: [2048]i32,
    per_layer: [6]u32,
    tree_edges: u32,
    cross_edges: u32,
}

pub fn lk_new_layout() -> LkLayout {
    return LkLayout {
        n: 0,
        layer: [0] ** 2048,
        bud: [0] ** 2048,
        ver: [0] ** 2048,
        parent: [0] ** 2048,
        rank: [0] ** 2048,
        slot: [0] ** 2048,
        order: [0] ** 2048,
        x: [0] ** 2048,
        y: [0] ** 2048,
        per_layer: [0] ** 6,
        tree_edges: 0,
        cross_edges: 0,
    };
}

/// Sort key of node i on layer l: the rank of its tree parent when that parent sits on a lower layer,
/// else NODE_CAP (after every parented node). Ties keep node-index order (the sort is stable).
fn lk_key(lay: *LkLayout, i: u32, l: u8) -> u32 {
    var p = lay.parent[i];
    if (p == NODE_CAP) { return NODE_CAP; }
    if (lay.layer[p] >= l) { return NODE_CAP; }
    return lay.rank[p];
}

/// Lay the graph out as the oak; returns the node count. Pure: same graph, same layout.
pub fn lk_layout(g: *WorkGraph, lay: *LkLayout) -> u32 {
    var n = nodes(g);
    lay.n = n;
    lay.tree_edges = 0;
    lay.cross_edges = 0;
    var i : u32 = 0;
    while (i < n) {
        lay.ver[i] = 0;
        lay.parent[i] = NODE_CAP;
        i = i + 1;
    }
    // one pass: verified artifacts, then tree parents (first BELONGS_TO), every other edge a cross edge
    var e : u32 = 0;
    while (e < edges(g)) {
        var f = edge_from_at(g, e);
        if (edge_kind_at(g, e) == EK_VERIFIES && edge_label_at(g, e) == LABEL_EXACT) {
            if (wx_is_artifact(node_kind_at_pub(g, f)) && node_label_at(g, f) == LABEL_EXACT) {
                if (node_kind_at_pub(g, edge_to_at(g, e)) == NX_ISSUE) { lay.ver[f] = 1; }
            }
        }
        if (edge_kind_at(g, e) == EX_BELONGS_TO && lay.parent[f] == NODE_CAP) {
            lay.parent[f] = edge_to_at(g, e);
            lay.tree_edges = lay.tree_edges + 1;
        } else {
            lay.cross_edges = lay.cross_edges + 1;
        }
        e = e + 1;
    }
    i = 0;
    while (i < n) {
        var k = node_kind_at_pub(g, i);
        lay.layer[i] = lk_layer_of(k, lay.ver[i] == 1);
        lay.bud[i] = 0;
        if (wx_is_artifact(k) && lay.ver[i] == 0) { lay.bud[i] = 1; }
        i = i + 1;
    }
    // layer by layer, a stable insertion sort on lk_key; ranks of lower layers are already set
    var pos : u32 = 0;
    var l : u8 = 0;
    while (l < LK_L_COUNT) {
        var start = pos;
        i = 0;
        while (i < n) {
            if (lay.layer[i] == l) {
                var key = lk_key(lay, i, l);
                var j = pos;
                var moving = true;
                while (moving) {
                    if (j == start) {
                        moving = false;
                    } else {
                        if (lk_key(lay, lay.order[j - 1], l) > key) {
                            lay.order[j] = lay.order[j - 1];
                            j = j - 1;
                        } else {
                            moving = false;
                        }
                    }
                }
                lay.order[j] = i;
                pos = pos + 1;
            }
            i = i + 1;
        }
        var cnt = pos - start;
        lay.per_layer[l] = cnt;
        var s = start;
        while (s < pos) {
            var m = lay.order[s];
            lay.rank[m] = s;
            lay.slot[m] = s - start;
            lay.x[m] = (2 * ((s - start) as i32) - ((cnt as i32) - 1)) * LK_COL;
            lay.y[m] = (l as i32) * LK_ROW;
            s = s + 1;
        }
        l = l + 1;
    }
    return n;
}

/// The k-th node of the growth order (roots first, crown and space last).
pub fn lk_growth_at(lay: *LkLayout, k: u32) -> u32 {
    if (k >= lay.n) { return NODE_CAP; }
    return lay.order[k];
}

/// Edges touching n: what tree_neighborhood_expanded shows (every kind, both directions).
pub fn lk_degree(g: *WorkGraph, n: u32) -> u32 {
    var c : u32 = 0;
    var e : u32 = 0;
    while (e < edges(g)) {
        if (edge_from_at(g, e) == n || edge_to_at(g, e) == n) { c = c + 1; }
        e = e + 1;
    }
    return c;
}

// ---- camera: six frames of one view ----

pub const LK_FR_GROUND : u8 = 0;
pub const LK_FR_AXO_L : u8 = 1;
pub const LK_FR_AXO_R : u8 = 2;
pub const LK_FR_PLAN : u8 = 3;
pub const LK_FR_FRONT : u8 = 4;
pub const LK_FR_SIDE : u8 = 5;
pub const LK_FR_COUNT : u8 = 6;

pub const LK_MARGIN : u32 = 34;
pub const LK_SPAN_MIN : u32 = 68;

pub struct LkBox {
    x0: i32,
    y0: i32,
    x1: i32,
    y1: i32,
}

/// A fitted camera. cx2 / cy2 are twice the centre (no halving), zoom is per mille of a layout unit.
pub struct LkCam {
    frame: u8,
    cx2: i32,
    cy2: i32,
    yaw: i32,
    pitch: i32,
    zoom_milli: u32,
}

pub fn lk_frame_yaw(f: u8) -> i32 {
    if (f == LK_FR_AXO_L) { return 0 - 45; }
    if (f == LK_FR_AXO_R) { return 45; }
    if (f == LK_FR_SIDE) { return 90; }
    return 0;
}

pub fn lk_frame_pitch(f: u8) -> i32 {
    if (f == LK_FR_GROUND) { return 15; }
    if (f == LK_FR_AXO_L || f == LK_FR_AXO_R) { return 35; }
    if (f == LK_FR_PLAN) { return 90; }
    return 0;
}

/// cos in per mille for the frame angles; any other angle answers 1000.
pub fn lk_cos_milli(deg: i32) -> u32 {
    var d = deg;
    if (d < 0) { d = 0 - d; }
    if (d == 15) { return 966; }
    if (d == 35) { return 819; }
    if (d == 45) { return 707; }
    if (d == 90) { return 0; }
    return 1000;
}

pub fn lk_bbox(lay: *LkLayout) -> LkBox {
    if (lay.n == 0) { return LkBox { x0: 0, y0: 0, x1: 0, y1: 0 }; }
    var x0 = lay.x[0];
    var x1 = lay.x[0];
    var y0 = lay.y[0];
    var y1 = lay.y[0];
    var i : u32 = 1;
    while (i < lay.n) {
        if (lay.x[i] < x0) { x0 = lay.x[i]; }
        if (lay.x[i] > x1) { x1 = lay.x[i]; }
        if (lay.y[i] < y0) { y0 = lay.y[i]; }
        if (lay.y[i] > y1) { y1 = lay.y[i]; }
        i = i + 1;
    }
    return LkBox { x0: x0, y0: y0, x1: x1, y1: y1 };
}

/// fitToField: fit the box, seen from frame f, into a field_w x field_h field. The layout is planar, so
/// a frame's projected width is w * cos(yaw) and its height h * cos(pitch), each floored at LK_SPAN_MIN.
pub fn lk_fit(b: LkBox, f: u8, field_w: u32, field_h: u32) -> LkCam {
    var w = (b.x1 - b.x0) as u32;
    var h = (b.y1 - b.y0) as u32;
    var pw = w * lk_cos_milli(lk_frame_yaw(f)) / 1000;
    var ph = h * lk_cos_milli(lk_frame_pitch(f)) / 1000;
    if (pw < LK_SPAN_MIN) { pw = LK_SPAN_MIN; }
    if (ph < LK_SPAN_MIN) { ph = LK_SPAN_MIN; }
    var zw = field_w * 1000 / (pw + 2 * LK_MARGIN);
    var zh = field_h * 1000 / (ph + 2 * LK_MARGIN);
    var z = zw;
    if (zh < z) { z = zh; }
    return LkCam { frame: f, cx2: b.x0 + b.x1, cy2: b.y0 + b.y1, yaw: lk_frame_yaw(f), pitch: lk_frame_pitch(f), zoom_milli: z };
}

pub const LK_CAM_DELTA_PCT : u32 = 5;
pub const LK_CAM_STABLE_MS : u32 = 500;
pub const LK_CAM_COOLDOWN_MS : u32 = 1000;

/// Camera hysteresis: move only on a zoom change of at least 5 percent that has been stable 500 ms,
/// and not within 1000 ms of the last move. A critical user action (a click) moves at once.
pub fn lk_cam_should_move(old_zoom: u32, new_zoom: u32, stable_ms: u32, since_move_ms: u32, critical: bool) -> bool {
    if (critical) { return true; }
    if (since_move_ms < LK_CAM_COOLDOWN_MS) { return false; }
    if (stable_ms < LK_CAM_STABLE_MS) { return false; }
    var d : u32 = 0;
    if (new_zoom > old_zoom) { d = new_zoom - old_zoom; } else { d = old_zoom - new_zoom; }
    return d * 100 >= old_zoom * LK_CAM_DELTA_PCT;
}

// ---- admission: graph backpressure, refuse and dead-letter, never truncate ----

pub const LK_NODE_BUDGET : u32 = 1000;
pub const LK_EDGE_BUDGET : u32 = 5000;
pub const LK_EVENT_MAX_NODES : u32 = 5;
pub const LK_EVENT_MAX_EDGES : u32 = 4;

pub const LK_OK : u8 = 0;
pub const LK_REFUSED_OVERFLOW : u8 = 1;
pub const LK_REFUSED_INVALID : u8 = 2;

pub fn lk_node_high() -> u32 {
    return tm_mbox_high(LK_NODE_BUDGET);
}

pub fn lk_edge_high() -> u32 {
    return tm_mbox_high(LK_EDGE_BUDGET);
}

/// Would the widest event still fit both budgets?
pub fn lk_admit(n: u32, e: u32) -> u8 {
    if (n + LK_EVENT_MAX_NODES > LK_NODE_BUDGET) { return LK_REFUSED_OVERFLOW; }
    if (e + LK_EVENT_MAX_EDGES > LK_EDGE_BUDGET) { return LK_REFUSED_OVERFLOW; }
    return LK_OK;
}

/// graph_backpressure_triggered (warn): at or above 80 percent of either budget.
pub fn lk_alert(n: u32, e: u32) -> bool {
    return tm_backpressure_alert(n, LK_NODE_BUDGET) || tm_backpressure_alert(e, LK_EDGE_BUDGET);
}

/// The dead letter a refusal writes (t27m.t27 tm_dead_letter): reason and failure class.
pub fn lk_dl_reason(code: u8) -> u8 {
    if (code == LK_REFUSED_INVALID) { return TM_DL_INVALID; }
    return TM_DL_OVERFLOW;
}

pub fn lk_dl_class(code: u8) -> u8 {
    if (code == LK_REFUSED_INVALID) { return TM_FC_PERMANENT; }
    return TM_FC_TRANSIENT;
}

/// Apply one feed event under the budgets: whole or not at all.
pub fn lk_apply_event(g: *WorkGraph, ev: Event) -> u8 {
    if (ev.kind >= EV_COUNT) { return LK_REFUSED_INVALID; }
    if (lk_admit(nodes(g), edges(g)) != LK_OK) { return LK_REFUSED_OVERFLOW; }
    if (apply_event(g, ev) != WG_OK) { return LK_REFUSED_INVALID; }
    return LK_OK;
}

// ---- bridge provenance ----

pub const LK_PV_VERIFIED : u8 = 0;
pub const LK_PV_UNVERIFIED : u8 = 1;
pub const LK_PV_DISPUTED : u8 = 2;

/// t27r.t27 tr_fact_state -> provenance. Anything that is not OK or DISPUTED is unverified.
pub fn lk_provenance(fact_state: u8) -> u8 {
    if (fact_state == TR_E_OK) { return LK_PV_VERIFIED; }
    if (fact_state == TR_E_DISPUTED) { return LK_PV_DISPUTED; }
    return LK_PV_UNVERIFIED;
}

pub fn lk_pv_edge_label(pv: u8) -> u8 {
    if (pv == LK_PV_VERIFIED) { return LABEL_EXACT; }
    if (pv == LK_PV_DISPUTED) { return LABEL_UNKNOWN; }
    return LABEL_SUGGESTED;
}

pub fn lk_pv_node_label(pv: u8) -> u8 {
    if (pv == LK_PV_VERIFIED) { return LABEL_EXACT; }
    return LABEL_UNKNOWN;
}

/// Is an edge of this kind, direction AND label stored? (wx_has_edge ignores the label, and a later
/// verification must add its EXACT edge beside the old SUGGESTED one.)
fn lk_has_labeled_edge(g: *WorkGraph, kind: u8, from: u32, to: u32, label: u8) -> bool {
    var e : u32 = 0;
    while (e < edges(g)) {
        if (edge_kind_at(g, e) == kind && edge_from_at(g, e) == from && edge_to_at(g, e) == to) {
            if (edge_label_at(g, e) == label) { return true; }
        }
        e = e + 1;
    }
    return false;
}

/// A work_graph_ext add result as an LK code: WG_OK -> LK_OK, a full graph -> LK_REFUSED_OVERFLOW,
/// any other refusal (index, kind, shape, self loop) -> LK_REFUSED_INVALID.
fn lk_from_wx(r: u8) -> u8 {
    if (r == WG_OK) { return LK_OK; }
    if (r == WX_E_CAP) { return LK_REFUSED_OVERFLOW; }
    return LK_REFUSED_INVALID;
}

/// A bridge artifact: BELONGS_TO and VERIFIES to its issue, labelled by provenance. Replay-safe: the
/// same provenance twice adds nothing; a new provenance adds its VERIFIES edge and keeps the old one.
/// Returns LK codes only, like lk_apply_event, so lk_admit_event, lk_dl_reason and lk_dl_class apply:
/// LK_OK, LK_REFUSED_OVERFLOW (budget or cap) or LK_REFUSED_INVALID (bad index, kind or shape).
pub fn lk_bridge_add_artifact(g: *WorkGraph, issue: u32, artifact_id: u64, kind: u8, fact_state: u8) -> u8 {
    if (issue >= nodes(g)) { return LK_REFUSED_INVALID; }
    if (node_kind_at_pub(g, issue) != NX_ISSUE || !wx_is_artifact(kind)) { return LK_REFUSED_INVALID; }
    if (lk_admit(nodes(g), edges(g)) != LK_OK) { return LK_REFUSED_OVERFLOW; }
    var pv = lk_provenance(fact_state);
    var a = wx_ensure_node(g, kind, artifact_id, lk_pv_node_label(pv));
    if (a == NODE_CAP) { return LK_REFUSED_OVERFLOW; }
    var r = lk_from_wx(wx_ensure_edge(g, EX_BELONGS_TO, a, issue, lk_pv_edge_label(pv)));
    if (r != LK_OK) { return r; }
    if (lk_has_labeled_edge(g, EK_VERIFIES, a, issue, lk_pv_edge_label(pv))) { return LK_OK; }
    return lk_from_wx(wx_add_edge(g, EK_VERIFIES, a, issue, lk_pv_edge_label(pv)));
}

// ---- honesty, passes, events ----

pub const LK_SRC_NONE : u8 = 0;
pub const LK_SRC_FIXTURE : u8 = 1;
pub const LK_SRC_REPLAY : u8 = 2;
pub const LK_SRC_LIVE : u8 = 3;

pub fn lk_live_badge(src: u8) -> bool {
    return src == LK_SRC_LIVE;
}

/// The honest empty state: no feed, or a feed with nothing in it.
pub fn lk_empty_state(src: u8, n: u32) -> bool {
    return src == LK_SRC_NONE || n == 0;
}

pub const LK_PASS_INK : u8 = 0;
pub const LK_PASS_COLOR : u8 = 1;

pub fn lk_pass_allowed(pass: u8, ink_done: bool) -> bool {
    if (pass == LK_PASS_INK) { return true; }
    return pass == LK_PASS_COLOR && ink_done;
}

/// The T27L action of a feed source change.
pub fn lk_feed_event(src: u8) -> u8 {
    if (src == LK_SRC_NONE) { return tl_action_id("live_feed_missing"); }
    if (src == LK_SRC_LIVE) { return tl_action_id("live_feed_connected"); }
    return tl_action_id("replay_started");
}

/// The T27L action of a bridge artifact: verified, else bridge_event_unverified.
pub fn lk_bridge_event(fact_state: u8) -> u8 {
    if (lk_provenance(fact_state) == LK_PV_VERIFIED) { return tl_action_id("artifact_verified"); }
    return tl_action_id("bridge_event_unverified");
}

/// The T27L action of an admission result; 0 when the event was applied.
pub fn lk_admit_event(code: u8) -> u8 {
    if (code == LK_OK) { return 0; }
    return tl_action_id("graph_event_rejected");
}

// ---- fixture and tests ----

/// The test oak: spawn 1->2, spawn 1->3, offer 1->2 (task 7, spec 9, seq 10), result 2->1 (task 7,
/// seq 11) -- 8 nodes, 7 edges -- then root, trunk, epic 12779, issue 7, and six BELONGS_TO edges.
fn lk_fixture(g: *WorkGraph) -> bool {
    var ok = lk_apply_event(g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == LK_OK;
    ok = ok && lk_apply_event(g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 3, task_no: 0, deliver: D_NONE, reason: 99, seq: 2, spec_id: 0 }) == LK_OK;
    ok = ok && lk_apply_event(g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 2, task_no: 7, deliver: D_OFFER, reason: 99, seq: 10, spec_id: 9 }) == LK_OK;
    ok = ok && lk_apply_event(g, Event { kind: EV_DELIVER, from_pid: 2, to_pid: 1, task_no: 7, deliver: D_RESULT, reason: 99, seq: 11, spec_id: 0 }) == LK_OK;
    var root = wx_ensure_node(g, NX_ROOT, 1, LABEL_EXACT);
    var trunk = wx_ensure_node(g, NX_TRUNK, 1, LABEL_EXACT);
    var epic = wx_ensure_node(g, NX_EPIC, 12779, LABEL_EXACT);
    var issue = wx_ensure_node(g, NX_ISSUE, 7, LABEL_EXACT);
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, trunk, root, LABEL_EXACT) == WG_OK;
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, epic, trunk, LABEL_EXACT) == WG_OK;
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, issue, epic, LABEL_EXACT) == WG_OK;
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, node_of(g, NK_SPEC, 9), root, LABEL_EXACT) == WG_OK;
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, node_of(g, NK_TASK, 7), issue, LABEL_EXACT) == WG_OK;
    ok = ok && wx_add_edge(g, EX_BELONGS_TO, node_of(g, NK_ARTIFACT, 7), issue, LABEL_EXACT) == WG_OK;
    return ok;
}

test "graph_is_tree_layout: every node gets one place and no edge is discarded" {
    var g = new_graph();
    assert(lk_fixture(&g));
    assert(nodes(&g) == 12);
    assert(edges(&g) == 13);
    var lay = lk_new_layout();
    assert(lk_layout(&g, &lay) == 12);
    var sum : u32 = 0;
    var l : u32 = 0;
    while (l < 6) {
        sum = sum + lay.per_layer[l];
        l = l + 1;
    }
    assert(sum == 12);
    assert(lay.tree_edges == 6);
    assert(lay.tree_edges + lay.cross_edges == edges(&g));
    assert(lay.per_layer[LK_L_ROOT] == 2);
    assert(lay.per_layer[LK_L_TRUNK] == 1);
    assert(lay.per_layer[LK_L_BRANCH] == 1);
    assert(lay.per_layer[LK_L_TWIG] == 2);
    assert(lay.per_layer[LK_L_LEAF] == 0);
    assert(lay.per_layer[LK_L_SPACE] == 6);
}

test "roots_to_crown: the growth order never goes down a layer and starts at the roots" {
    var g = new_graph();
    assert(lk_fixture(&g));
    var lay = lk_new_layout();
    var n = lk_layout(&g, &lay);
    assert(lk_act_of(lay.layer[lk_growth_at(&lay, 0)]) == 1);
    var k : u32 = 1;
    while (k < n) {
        assert(lay.layer[lk_growth_at(&lay, k - 1)] <= lay.layer[lk_growth_at(&lay, k)]);
        k = k + 1;
    }
    assert(lk_growth_at(&lay, n) == NODE_CAP);
    // the twig with a lower-layer parent comes before the bud whose parent is a twig
    var issue = node_of(&g, NX_ISSUE, 7);
    var art = node_of(&g, NK_ARTIFACT, 7);
    assert(lay.slot[issue] == 0);
    assert(lay.slot[art] == 1);
    assert(lay.x[issue] == 0 - LK_COL);
    assert(lay.x[art] == LK_COL);
    assert(lay.y[issue] == 3 * LK_ROW);
}

test "the layout is deterministic: the same graph lays out to the same places twice" {
    var g = new_graph();
    assert(lk_fixture(&g));
    var a = lk_new_layout();
    var b = lk_new_layout();
    var n = lk_layout(&g, &a);
    assert(lk_layout(&g, &b) == n);
    var i : u32 = 0;
    while (i < n) {
        assert(a.x[i] == b.x[i]);
        assert(a.y[i] == b.y[i]);
        assert(a.order[i] == b.order[i]);
        i = i + 1;
    }
}

test "leaf_requires_verified_artifact: unverified stays a bud, only a verified bridge makes a leaf" {
    var g = new_graph();
    assert(lk_fixture(&g));
    var issue = node_of(&g, NX_ISSUE, 7);
    var art = node_of(&g, NK_ARTIFACT, 7);
    var lay = lk_new_layout();
    var n = lk_layout(&g, &lay);
    assert(lay.bud[art] == 1);
    assert(lay.layer[art] == LK_L_TWIG);
    assert(lk_bridge_add_artifact(&g, issue, 7, NK_ARTIFACT, TR_E_UNVERIFIED) == LK_OK);
    assert(lk_bridge_add_artifact(&g, issue, 7, NK_ARTIFACT, TR_E_DISPUTED) == LK_OK);
    n = lk_layout(&g, &lay);
    assert(!wx_artifact_verified(&g, art));
    assert(lay.per_layer[LK_L_LEAF] == 0);
    assert(lk_bridge_add_artifact(&g, issue, 7, NK_ARTIFACT, TR_E_OK) == LK_OK);
    var before = edges(&g);
    assert(lk_bridge_add_artifact(&g, issue, 7, NK_ARTIFACT, TR_E_OK) == LK_OK);
    assert(edges(&g) == before);
    n = lk_layout(&g, &lay);
    assert(wx_artifact_verified(&g, art));
    assert(lay.layer[art] == LK_L_LEAF);
    assert(lay.bud[art] == 0);
    assert(lay.per_layer[LK_L_LEAF] == 1);
    assert(n == 12);
    // an unverified bridge MESH is a new node, never a leaf
    assert(lk_bridge_add_artifact(&g, issue, 900, NX_MESH, TR_E_UNVERIFIED) == LK_OK);
    var mesh = node_of(&g, NX_MESH, 900);
    assert(node_label_at(&g, mesh) == LABEL_UNKNOWN);
    n = lk_layout(&g, &lay);
    assert(lay.bud[mesh] == 1);
    assert(lk_bridge_add_artifact(&g, art, 1, NX_MESH, TR_E_OK) == LK_REFUSED_INVALID);
    assert(lk_bridge_add_artifact(&g, issue, 1, NX_EPIC, TR_E_OK) == LK_REFUSED_INVALID);
    assert(lk_bridge_add_artifact(&g, 4000, 1, NX_MESH, TR_E_OK) == LK_REFUSED_INVALID);
}

test "the bridge speaks LK codes only: every refusal maps to a dead-letter reason and class" {
    assert(lk_from_wx(WG_OK) == LK_OK);
    assert(lk_from_wx(WX_E_CAP) == LK_REFUSED_OVERFLOW);
    assert(lk_from_wx(WX_E_CAP - 1) == LK_REFUSED_INVALID);
    assert(lk_from_wx(WX_E_CAP - 4) == LK_REFUSED_INVALID);
    var g = new_graph();
    assert(lk_fixture(&g));
    var issue = node_of(&g, NX_ISSUE, 7);
    var r0 = lk_bridge_add_artifact(&g, issue, 31, NK_ARTIFACT, TR_E_OK);
    var r1 = lk_bridge_add_artifact(&g, 4000, 31, NK_ARTIFACT, TR_E_OK);
    var r2 = lk_bridge_add_artifact(&g, issue, 31, NX_EPIC, TR_E_OK);
    assert(r0 == LK_OK);
    assert(r1 == LK_REFUSED_INVALID && r2 == LK_REFUSED_INVALID);
    assert(lk_admit_event(r0) == 0);
    assert(lk_admit_event(r1) != 0);
    assert(lk_dl_reason(r1) == TM_DL_INVALID);
    assert(lk_dl_class(r1) == TM_FC_PERMANENT);
}

test "belongs_to is canonical: children are derived, a shared parent and a cycle stay as cross edges" {
    var g = new_graph();
    assert(lk_fixture(&g));
    var epic = node_of(&g, NX_EPIC, 12779);
    var issue = node_of(&g, NX_ISSUE, 7);
    assert(wx_child_count(&g, epic) == 1);
    assert(wx_child_count(&g, issue) == 2);
    var e2 = wx_ensure_node(&g, NX_EPIC, 11385, LABEL_EXACT);
    var i2 = wx_ensure_node(&g, NX_ISSUE, 8, LABEL_EXACT);
    assert(wx_add_edge(&g, EX_BELONGS_TO, e2, node_of(&g, NX_TRUNK, 1), LABEL_EXACT) == WG_OK);
    assert(wx_add_edge(&g, EX_BELONGS_TO, issue, e2, LABEL_EXACT) == WG_OK);
    assert(wx_add_edge(&g, EX_DEPENDS_ON, issue, i2, LABEL_EXACT) == WG_OK);
    assert(wx_add_edge(&g, EX_DEPENDS_ON, i2, issue, LABEL_EXACT) == WG_OK);
    var lay = lk_new_layout();
    var n = lk_layout(&g, &lay);
    assert(n == 14);
    assert(lay.parent[issue] == epic);
    assert(wx_child_count(&g, e2) == 1);
    assert(lay.tree_edges == 7);
    assert(lay.tree_edges + lay.cross_edges == edges(&g));
    assert(lk_degree(&g, i2) == 2);
}

test "graph backpressure: refuse the whole event at the budget, alert at 80 percent, never truncate" {
    assert(lk_node_high() == 800);
    assert(lk_edge_high() == 4000);
    assert(lk_admit(995, 0) == LK_OK);
    assert(lk_admit(996, 0) == LK_REFUSED_OVERFLOW);
    assert(lk_admit(0, 4996) == LK_OK);
    assert(lk_admit(0, 4997) == LK_REFUSED_OVERFLOW);
    assert(lk_alert(800, 0));
    assert(lk_alert(0, 4000));
    assert(!lk_alert(799, 3999));
    assert(lk_dl_reason(LK_REFUSED_OVERFLOW) == TM_DL_OVERFLOW);
    assert(lk_dl_class(LK_REFUSED_OVERFLOW) == TM_FC_TRANSIENT);
    assert(lk_dl_reason(LK_REFUSED_INVALID) == TM_DL_INVALID);
    var g = new_graph();
    var i : u64 = 0;
    while (i < 996) {
        assert(wx_ensure_node(&g, NX_ISSUE, i, LABEL_EXACT) < NODE_CAP);
        i = i + 1;
    }
    var r = lk_apply_event(&g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 2, task_no: 7, deliver: D_OFFER, reason: 99, seq: 10, spec_id: 9 });
    assert(r == LK_REFUSED_OVERFLOW);
    assert(nodes(&g) == 996);
    assert(edges(&g) == 0);
    assert(lk_admit_event(r) == tl_action_id("graph_event_rejected"));
    assert(lk_admit_event(LK_OK) == 0);
    assert(lk_apply_event(&g, Event { kind: EV_COUNT, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == LK_REFUSED_INVALID);
}

test "camera: six frames of one view fit the same box, and hysteresis holds small or early moves" {
    var g = new_graph();
    assert(lk_fixture(&g));
    var lay = lk_new_layout();
    var n = lk_layout(&g, &lay);
    assert(n == 12);
    var b = lk_bbox(&lay);
    assert(b.y0 == 0);
    assert(b.y1 == 5 * LK_ROW);
    var f : u8 = 0;
    var cx2 = lk_fit(b, LK_FR_GROUND, 1280, 800).cx2;
    while (f < LK_FR_COUNT) {
        var c = lk_fit(b, f, 1280, 800);
        assert(c.zoom_milli > 0);
        assert(c.cx2 == cx2);
        assert(c.frame == f);
        f = f + 1;
    }
    assert(lk_fit(b, LK_FR_PLAN, 1280, 800).zoom_milli >= lk_fit(b, LK_FR_GROUND, 1280, 800).zoom_milli);
    assert(lk_fit(lk_bbox(&lay), LK_FR_SIDE, 1280, 800).zoom_milli == lk_fit(b, LK_FR_SIDE, 1280, 800).zoom_milli);
    assert(!lk_cam_should_move(1000, 1040, 600, 2000, false));
    assert(lk_cam_should_move(1000, 1050, 600, 2000, false));
    assert(lk_cam_should_move(1000, 950, 600, 2000, false));
    assert(!lk_cam_should_move(1000, 1100, 400, 2000, false));
    assert(!lk_cam_should_move(1000, 1100, 600, 900, false));
    assert(lk_cam_should_move(1000, 1000, 0, 0, true));
}

test "no_view_switching and honesty: one view, fixture is never live, a missing feed is an empty state" {
    assert(LK_FR_COUNT == 6);
    assert(tl_action_id("view_switched") == 0);
    assert(!lk_live_badge(LK_SRC_FIXTURE));
    assert(!lk_live_badge(LK_SRC_REPLAY));
    assert(!lk_live_badge(LK_SRC_NONE));
    assert(lk_live_badge(LK_SRC_LIVE));
    assert(lk_empty_state(LK_SRC_NONE, 12));
    assert(lk_empty_state(LK_SRC_LIVE, 0));
    assert(!lk_empty_state(LK_SRC_REPLAY, 12));
    assert(lk_feed_event(LK_SRC_NONE) == tl_action_id("live_feed_missing"));
    assert(lk_feed_event(LK_SRC_NONE) != 0);
    assert(lk_feed_event(LK_SRC_LIVE) == tl_action_id("live_feed_connected"));
    assert(lk_feed_event(LK_SRC_FIXTURE) == tl_action_id("replay_started"));
    assert(lk_bridge_event(TR_E_OK) == tl_action_id("artifact_verified"));
    assert(lk_bridge_event(TR_E_DISPUTED) == tl_action_id("bridge_event_unverified"));
    assert(lk_pass_allowed(LK_PASS_INK, false));
    assert(!lk_pass_allowed(LK_PASS_COLOR, false));
    assert(lk_pass_allowed(LK_PASS_COLOR, true));
}

invariant layers_climb_roots_to_space {
    assert(LK_L_ROOT < LK_L_TRUNK);
    assert(LK_L_TRUNK < LK_L_BRANCH);
    assert(LK_L_BRANCH < LK_L_TWIG);
    assert(LK_L_TWIG < LK_L_LEAF);
    assert(LK_L_LEAF < LK_L_SPACE);
}
