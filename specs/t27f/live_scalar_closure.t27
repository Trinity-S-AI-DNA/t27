// specs/t27f/live_scalar_closure.t27 -- the /t27f/live/ scalar closure: the two laws of
// live_mode.t27 that the M-B emitter cut (parameter-carrying scalar exports, t27#11840,
// PR #11983) can lower today, written as the stack expressions they become, with the
// transcription pinned test by test against the law itself so this file can never
// silently drift from it. paints_due is NOT here: its body is a comparison (select over
// eqz), which the M-B cut does not lower; it lands with the select floor on the emitter
// branch and joins this closure in the same PR.
// The wasm built from this spec is what t27f_live.js instantiates on the page; the
// builder and branch are recorded in t27f.build beside it. ASCII only (L3).
// phi^2 + 1/phi^2 = 3 | TRINITY

use t27f::live_mode;

/// live_mode::arrival_frame as the emitter's stack: t / FRAME_MS + 1.
pub fn arrival_frame(t_ms: u32) -> u32 {
    return t_ms / live_mode::FRAME_MS + 1;
}

/// live_mode::paints_due verbatim -- the select pattern the emitter lowers
/// (eqz over the parameter, select of the two constants).
pub fn paints_due(pending: u32) -> u32 {
    if (pending == 0) { return 0; }
    return 1;
}

/// live_mode::latency_ms as the emitter's stack: (painted - emitted + 1) * FRAME_MS.
pub fn latency_ms(emitted_at: u32, painted_at: u32) -> u32 {
    return (painted_at - emitted_at + 1) * live_mode::FRAME_MS;
}

test transcription_arrival_frame_matches_the_law {
    var t : u32 = 0;
    while (t <= 1024) {
        assert arrival_frame(t) == live_mode::arrival_frame(t);
        t = t + 7;
    }
    // the boundaries the law names: [0,16) is frame 1, [16,32) frame 2
    assert arrival_frame(0) == 1 and arrival_frame(15) == 1;
    assert arrival_frame(16) == 2 and arrival_frame(31) == 2;
    assert arrival_frame(1024) == 65;
}

test transcription_latency_ms_matches_the_law {
    assert latency_ms(0, 0) == live_mode::latency_ms(0, 0);
    assert latency_ms(0, 15) == live_mode::latency_ms(0, 15);
    assert latency_ms(16, 16) == live_mode::latency_ms(16, 16);
    assert latency_ms(0, 16) == live_mode::latency_ms(0, 16);
    assert latency_ms(2, 7) == 96;
    var e : u32 = 0;
    while (e <= 256) {
        var p : u32 = e;
        while (p <= e + 64) {
            assert latency_ms(e, p) == live_mode::latency_ms(e, p);
            p = p + 5;
        }
        e = e + 13;
    }
}

test transcription_paints_due_matches_the_law {
    var p : u32 = 0;
    while (p <= 64) {
        assert paints_due(p) == live_mode::paints_due(p);
        p = p + 1;
    }
    assert paints_due(0) == 0 and paints_due(1) == 1 and paints_due(64) == 1;
}
