// SPDX-License-Identifier: Apache-2.0
; vf_uikit is the pure component geometry of the course HUD, built on vf_style: rectangles only, no pixels, no colour
; Refs Trinity-S-AI-DNA/t27#13251 (course v2, Style / UI Kit lane; the renderer lane imports this in a later PR)
; The view is 375 x 812 (the HUD frame); a header 56 px tall sits on top and cards are 108 px tall, so seven cards end exactly at y 812
; button_rect: height MIN_TOUCH (touch) or MIN_POINTER (pointer), width label_w + 2 * PAD_ROW, the label sits inside the horizontal padding
; card_rect: card i is the full given width, 108 px tall, at y = 56 + i * 108; card_inner insets it by PAD_CARD on all four sides
; caption_baseline: the caption box (TYPE_CAPT px tall) is centred in the rect, the baseline is y + (h + TYPE_CAPT) / 2
; bar_fill_w: the filled part of a bar w px wide at permille 0..1000, floor division, permille is clamped to 0..1000
; row_rect: row i of a list at y0 + i * h, inset by PAD_ROW on both sides; row_rects fills up to ROW_MAX of them
; fits_hud: a rect lies inside the view (x, y >= 0, w, h >= 0, x + w <= 375, y + h <= 812); a rect past the right edge fails it
; All values are i32 and read from vf_style; nothing here generates a scale. ASCII only (L3)

module VfUiKit;
use t27f::vf_style::PAD_CARD;
use t27f::vf_style::PAD_ROW;
use t27f::vf_style::MIN_TOUCH;
use t27f::vf_style::MIN_POINTER;
use t27f::vf_style::TYPE_CAPT;

; the HUD frame and the header, in px
pub const UK_VIEW_W : i32 = 375;
pub const UK_VIEW_H : i32 = 812;
pub const UK_HDR_H : i32 = 56;

; a card is 108 px tall and the next card starts where it ends
pub const UK_CARD_H : i32 = 108;

; the most rows row_rects fills
pub const ROW_MAX : u32 = 8;

pub struct UiRect {
    pub x : i32,
    pub y : i32,
    pub w : i32,
    pub h : i32,
}

pub struct UiRows {
    pub rects : [8]UiRect,
    pub count : u32,
}

pub fn ui_rect(x: i32, y: i32, w: i32, h: i32) -> UiRect {
    return UiRect { x: x, y: y, w: w, h: h };
}

; a button at x, y: touch height MIN_TOUCH or pointer height MIN_POINTER, width label_w plus PAD_ROW on both sides
pub fn button_rect(x: i32, y: i32, label_w: i32, touch: bool) -> UiRect {
    var h : i32 = MIN_POINTER;
    if touch {
        h = MIN_TOUCH;
    }
    return ui_rect(x, y, label_w + 2 * PAD_ROW, h);
}

; card i, w px wide, at y = 56 + i * 108
pub fn card_rect(i: i32, w: i32) -> UiRect {
    return ui_rect(0, UK_HDR_H + i * UK_CARD_H, w, UK_CARD_H);
}

; the content box of a card: the rect inset by PAD_CARD on all four sides, never negative
pub fn card_inner(r: UiRect) -> UiRect {
    var iw : i32 = r.w - 2 * PAD_CARD;
    var ih : i32 = r.h - 2 * PAD_CARD;
    if iw < 0 {
        iw = 0;
    }
    if ih < 0 {
        ih = 0;
    }
    return ui_rect(r.x + PAD_CARD, r.y + PAD_CARD, iw, ih);
}

; the baseline of a caption centred in the rect
pub fn caption_baseline(r: UiRect) -> i32 {
    return r.y + (r.h + TYPE_CAPT) / 2;
}

; the filled width of a bar w px wide at permille 0..1000
pub fn bar_fill_w(w: i32, permille: i32) -> i32 {
    var p : i32 = permille;
    if p < 0 {
        p = 0;
    }
    if p > 1000 {
        p = 1000;
    }
    if w <= 0 {
        return 0;
    }
    return w * p / 1000;
}

; row i of a list: full view width less PAD_ROW on both sides, h tall, at y0 + i * h
pub fn row_rect(i: i32, y0: i32, h: i32) -> UiRect {
    return ui_rect(PAD_ROW, y0 + i * h, UK_VIEW_W - 2 * PAD_ROW, h);
}

; the first n rows (at most ROW_MAX) of a list
pub fn row_rects(n: u32, y0: i32, h: i32) -> UiRows {
    var out : UiRows = UiRows { rects: [ui_rect(0, 0, 0, 0); ROW_MAX], count: 0 };
    var k : u32 = 0;
    while k < n and k < ROW_MAX {
        out.rects[k] = row_rect(k as i32, y0, h);
        k = k + 1;
    }
    out.count = k;
    return out;
}

; a rect lies inside the 375 x 812 view
pub fn fits_hud(r: UiRect) -> bool {
    if r.x < 0 or r.y < 0 or r.w < 0 or r.h < 0 {
        return false;
    }
    if r.x + r.w > UK_VIEW_W {
        return false;
    }
    if r.y + r.h > UK_VIEW_H {
        return false;
    }
    return true;
}

test uk_button_heights_follow_the_control_minimum {
    var t : UiRect = button_rect(16, 100, 80, true);
    var p : UiRect = button_rect(16, 100, 80, false);
    assert t.h == 44;
    assert p.h == 24;
    assert t.h >= MIN_TOUCH;
    assert p.h >= MIN_POINTER;
    assert t.w == 112;
    assert p.w == 112;
    assert t.x == 16;
    assert t.y == 100;
}

test uk_buttons_fit_the_view {
    assert fits_hud(button_rect(16, 100, 80, true));
    assert fits_hud(button_rect(16, 100, 80, false));
    assert fits_hud(button_rect(0, 0, 343, true));
    assert fits_hud(button_rect(331, 768, 0, true));
}

test uk_cards_stack_from_the_header {
    var c0 : UiRect = card_rect(0, 375);
    var c1 : UiRect = card_rect(1, 375);
    var c6 : UiRect = card_rect(6, 375);
    assert c0.y == 56;
    assert c1.y == 164;
    assert c6.y == 704;
    assert c0.h == 108;
    assert c0.w == 375;
    // the next card starts where the one before ends, and seven cards end at the bottom of the view
    assert c1.y == c0.y + c0.h;
    assert c6.y + c6.h == 812;
}

test uk_every_card_fits_the_view {
    var i : i32 = 0;
    while i < 7 {
        assert fits_hud(card_rect(i, 375));
        i = i + 1;
    }
}

test uk_card_inner_keeps_the_padding {
    var c : UiRect = card_rect(2, 375);
    var n : UiRect = card_inner(c);
    assert n.x == 20;
    assert n.y == c.y + 20;
    assert n.w == 335;
    assert n.h == 68;
    assert fits_hud(n);
    // the inner box sits inside the card
    assert n.x >= c.x;
    assert n.y >= c.y;
    assert n.x + n.w <= c.x + c.w;
    assert n.y + n.h <= c.y + c.h;
    // a card too small for its padding gives an empty inner box, never a negative one
    var s : UiRect = card_inner(ui_rect(0, 0, 30, 30));
    assert s.w == 0;
    assert s.h == 0;
}

test uk_caption_baseline_lies_inside_the_rect {
    var c : UiRect = card_rect(0, 375);
    assert caption_baseline(c) == 116;
    var t : UiRect = button_rect(16, 100, 80, true);
    assert caption_baseline(t) == 128;
    var p : UiRect = button_rect(16, 100, 80, false);
    assert caption_baseline(p) == 118;
    assert caption_baseline(c) >= c.y + TYPE_CAPT;
    assert caption_baseline(c) <= c.y + c.h;
    assert caption_baseline(t) >= t.y + TYPE_CAPT;
    assert caption_baseline(t) <= t.y + t.h;
    assert caption_baseline(p) >= p.y + TYPE_CAPT;
    assert caption_baseline(p) <= p.y + p.h;
}

test uk_bar_fill_w_is_a_clamped_fraction {
    assert bar_fill_w(375, 1000) == 375;
    assert bar_fill_w(375, 0) == 0;
    assert bar_fill_w(375, 500) == 187;
    assert bar_fill_w(200, 250) == 50;
    // out-of-range permille is clamped, an empty bar stays empty
    assert bar_fill_w(375, 2000) == 375;
    assert bar_fill_w(375, -5) == 0;
    assert bar_fill_w(0, 700) == 0;
    assert bar_fill_w(-10, 700) == 0;
}

test uk_rows_fill_and_fit {
    var rs : UiRows = row_rects(5, 100, 44);
    assert rs.count == 5;
    assert rs.rects[0].y == 100;
    assert rs.rects[1].y == 144;
    assert rs.rects[4].y == 276;
    assert rs.rects[0].x == 16;
    assert rs.rects[0].w == 343;
    var k : u32 = 0;
    while k < rs.count {
        assert fits_hud(rs.rects[k]);
        assert rs.rects[k].h >= MIN_TOUCH;
        k = k + 1;
    }
    // more rows than ROW_MAX are cut at ROW_MAX
    assert row_rects(20, 100, 44).count == 8;
    assert row_rects(0, 100, 44).count == 0;
}

test uk_negative_controls {
    // a rect pushed past the right edge fails fits_hud, one inside passes
    assert fits_hud(ui_rect(300, 100, 100, 44)) == false;
    assert fits_hud(ui_rect(300, 100, 75, 44)) == true;
    // past the bottom, left of the view, above the view, negative size
    assert fits_hud(ui_rect(0, 780, 100, 44)) == false;
    assert fits_hud(ui_rect(-1, 0, 10, 10)) == false;
    assert fits_hud(ui_rect(0, -1, 10, 10)) == false;
    assert fits_hud(ui_rect(0, 0, -10, 10)) == false;
    // a long label pushes a button past the right edge
    assert fits_hud(button_rect(300, 100, 100, true)) == false;
    // an eighth card falls off the bottom of the view
    assert fits_hud(card_rect(7, 375)) == false;
    // a pointer button is shorter than a touch button, a half bar is not a full bar
    assert button_rect(0, 0, 10, false).h != button_rect(0, 0, 10, true).h;
    assert bar_fill_w(375, 500) != bar_fill_w(375, 1000);
}
