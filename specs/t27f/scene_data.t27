// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_data.t27 -- scene A_DATA of reel_factory.t27: the lesson's code as a stack of glass
// blocks, one per line, as wide as the line is long, each stepping a little to the right of the one
// above it and casting a shadow, with the line's first word printed on its face.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: a struct or an enum is fields stacked in a record, and a field is a name and a width. The
// stack is the lesson's own: the number of blocks is its line count and the width of each its
// line's length, so a short record and a long one do not look alike.
//
// THE FUNCTION: data_px(t, acc, n, x, y) is the colour of canvas point (x, y). Blocks are 18 pixels
// tall every 22, from y = 88, at most 24; block r starts at x = 20 + 9 * (r mod 5).
//
// NOT CLAIMED: it does not read field types or layout; "glass" is a gradient and a highlight line.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_data;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::char_on;
use t27f::scene_raster::imin;
use t27f::scene_raster::clamp;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_n;
use t27f::scene_lex::lex_line;
use t27f::scene_lex::lex_llen;
use t27f::scene_lex::lex_ch;
use t27f::scene_lex::lex_first;

pub const BY0 : i32 = 88;
pub const BH : i32 = 18;
pub const BPITCH : i32 = 22;
pub const MAXB : i32 = 24;

pub fn block_n(t: usize) -> i32 {
    return imin(lex_n(t), MAXB);
}
pub fn block_x(r: i32) -> i32 {
    return 20 + 9 * fmod(r, 5);
}
pub fn blocks_end(t: usize) -> i32 {
    return block_n(t) * BPITCH;
}
pub fn block_w(t: usize, r: i32) -> i32 {
    return clamp(50 + lex_llen(lex_line(t, r)) * 5, 70, 300);
}

pub fn data_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(0, acc, seed_of(t, n, 6), x, y);
    if (y < BY0 || y - BY0 >= blocks_end(t)) { return c0; }
    const r = @divTrunc(y - BY0, BPITCH);
    if (r >= block_n(t)) { return c0; }
    const oy = BY0 + r * BPITCH;
    const x0 = block_x(r);
    const w = block_w(t, r);
    const l = lex_line(t, r);
    if (in_rect(x, y, x0, oy, x0 + w, oy + BH)) {
        // the first word on the face of the glass
        const ox = x0 + 6;
        const k = @divTrunc(x - ox, 8);
        if (x >= ox && k < 12 && y >= oy + 4 && y < oy + 14) {
            const ch = lex_ch(l, lex_first(l) + k);
            if (ch > 0 && char_on(ch, x, y, ox + k * 8, oy + 4, 2)) { return rgb(245, 247, 255); }
        }
        if (y - oy < 2) { return mix(acc, rgb(255, 255, 255), 120); }
        return mix(acc, rgb(18, 22, 60), @divTrunc((x - x0) * 200, w) + (y - oy) * 4);
    }
    if (in_rect(x, y, x0 + 4, oy + 4, x0 + w + 4, oy + BH + 4)) { return rgb(5, 6, 14); }
    return c0;
}

// ---- tests ----

test "a block per line, wider for a longer line" {
    var t : usize = 0;
    while (t < 27) {
        assert(block_n(t) >= 1 && block_n(t) <= MAXB);
        var r : i32 = 0;
        while (r < block_n(t)) {
            assert(block_w(t, r) >= 70 && block_w(t, r) <= 300);
            assert(block_x(r) + block_w(t, r) < 360);
            r = r + 1;
        }
        t = t + 1;
    }
    assert(block_x(0) == 20);
    assert(block_x(7) == 38);
}

test "the stack is the lesson's: another lesson draws another record" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = data_px(16, 0x22C55E, 4, x, y);
            const b = data_px(17, 0x22C55E, 4, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "the glass is lit at its top edge and shaded to the right" {
    const t : usize = 16;
    const x0 = block_x(0);
    const w = block_w(t, 0);
    const top = data_px(t, 0x22C55E, 4, x0 + w - 3, BY0);
    const body_l = data_px(t, 0x22C55E, 4, x0 + w - 3, BY0 + 16);
    assert(top != body_l);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (data_px(18, 0xF5B700, 3, x, y) != data_px(18, 0xF5B700, 3, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
