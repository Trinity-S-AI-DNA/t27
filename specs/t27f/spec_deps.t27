// SPDX-License-Identifier: Apache-2.0
; specs/t27f/spec_deps.t27 -- the T27F dependencies view: one spec's imports and importers, in layers
; (gHashTag/t27#10680; epic gHashTag/trinity#1648, RFC gHashTag/trinity#1649). T27F is the visual spec
; of .t27 (.claude/skills/t27f/SKILL.md, "What T27F is"). The RFC names a dependencies view beside the
; source, architecture, data-flow and test views. specs/t27f/spec_graph_view.t27 lays out one spec's
; own declarations; this file lays out the specs around it.
; --
; Input: the path-keyed edge list `t27c use-edges --specs-dir specs` prints, one `importer<TAB>imported`
; line per `use` line that resolves (bootstrap/src/use_resolve.rs). The same list feeds
; specs/ci/affected.t27 (every importer, transitively) and specs/claw/t27f_gate.t27 (one hop). The set
; helpers are affected.t27's, imported, not copied.
; --
; The rules, each with a test below:
;   - layer 0 is the focus. Layer +k holds the specs k imports away, layer -k the specs k importers
;     away. Each spec is in one layer per side, the layer of its shortest path, in edge-list order;
;   - every edge drawn is a line of the edge list between two drawn specs, drawn once however often
;     the list repeats it, and labelled exact: t27c resolved it, nothing here is inferred;
;   - the focus is flagged as on a cycle when it imports itself or a spec it imports imports it.
;     deps_cycles asks the same question of every importer and lists each spec flagged, once;
;   - a neighbourhood that does not fit the caller's room, or is deeper than the depth asked for, is
;     refused whole. Nothing is cut off.
; --
; The honest limits:
;   - a `use` line t27c does not resolve is not in the edge list, so it is not drawn (#7176 counted
;     119 such lines in 70 specs);
;   - the view flags only the focus. deps_cycles (#10693) lists every spec on a cycle, but nothing runs
;     it on every PR yet: no t27c subcommand runs a main (#10692). A spec on a cycle through the focus
;     is drawn on both sides;
;   - x and y are numbers for a host, in the spacing of spec_graph_view.t27. No host draws them yet.
; --
; Measured on the Railway lab, master e607228f7 plus this file: 2461 edge lines over 806 specs. Every
; spec walks inside DEPS_MAX_DEPTH: the deepest import walk is 6 (specs/t27f/lesson_reel.t27, 18
; specs) and the deepest importer walk is 6 (specs/verified/reuse.t27, 50 specs). The widest view is
; specs/base/types.t27, with 400 importers. Two specs are flagged on a cycle, and both flags are
; true: specs/igla/race/backend.t27 and specs/igla/race/rtl.t27 import each other. `tsort` reports
; the same loop on stderr.
; Measured again for deps_cycles, master f7efbc232 (2462 edge lines), with the list embedded in a
; scratch test that was not committed: it lists exactly those two specs. With #10689's rtl.t27,
; which drops its `use igla::race::backend;`, it lists none.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_spec_deps;

use policy::text_lines;
use ci::affected;
// lit_len, the length of a '$'-terminated literal, is reused from here, not copied (duplicate-bodies, #10685).
use claw::t27f_gate;

/// Which way a walk follows the edges: to what a spec imports, or to what imports it.
pub const DEPS_IMPORTS : u8 = 1;
pub const DEPS_IMPORTERS : u8 = 2;

/// What a walk says.
pub const DEPS_OK : u8 = 0;
pub const DEPS_ERR_FULL : u8 = 1;
pub const DEPS_ERR_DEEP : u8 = 2;

/// The deepest walk asked for; a deeper request is read as this one. A walk's bounds[] needs
/// DEPS_BOUNDS entries.
pub const DEPS_MAX_DEPTH : usize = 32;
pub const DEPS_BOUNDS : usize = 35;

/// Spacing, in the units of spec_graph_view.t27 (VIEW_MARGIN, VIEW_COL_STEP, VIEW_ROW_STEP).
pub const DEPS_MARGIN : usize = 40;
pub const DEPS_COL_STEP : usize = 260;
pub const DEPS_ROW_STEP : usize = 64;

pub const DEPS_DIGITS : str = "0123456789$";
pub const DEPS_HEAD : str = "deps\t$";
pub const DEPS_NODE : str = "node\t$";
pub const DEPS_EDGE : str = "edge\t$";
pub const DEPS_EXACT : str = "\texact\n$";
pub const DEPS_REFUSED : str = "refused\t$";
pub const DEPS_WHY_FULL : str = "full\t$";
pub const DEPS_WHY_DEEP : str = "deep\t$";

/// Is s[f..t] one of the newline-terminated lines of set[lo..hi]?
pub fn deps_in_range(set: []const u8, lo: usize, hi: usize, s: []const u8, f: usize, t: usize) -> bool {
    var i : usize = lo;
    while (i < hi) {
        const e : usize = line_end(set, i, hi);
        if (same(set, i, e, s, f, t)) { return true; }
        i = e + 1;
    }
    return false;
}

/// How many lines set[lo..hi] holds.
pub fn deps_count(set: []const u8, lo: usize, hi: usize) -> usize {
    var c : usize = 0;
    var i : usize = lo;
    while (i < hi) {
        if (set[i] == '\n') { c += 1; }
        i += 1;
    }
    return c;
}

/// Walk the edge list buf[0..n] from focus[ff..ft] in direction dir, breadth first, into set[0..scap]:
/// layer k is set[bounds[k]..bounds[k + 1]], one spec per line, layer 0 the focus. A spec already in the
/// set is not added again, so each spec lands in the layer of its shortest path. DEPS_ERR_FULL when
/// the set does not fit, DEPS_ERR_DEEP when layer depth + 1 is not empty.
pub fn deps_walk(buf: []const u8, n: usize, focus: []const u8, ff: usize, ft: usize, dir: u8, depth: usize, set: []u8, scap: usize, bounds: []usize) -> u8 {
    var d : usize = depth;
    if (d > DEPS_MAX_DEPTH) { d = DEPS_MAX_DEPTH; }
    bounds[0] = 0;
    var sn : usize = set_add(set, 0, scap, focus, ff, ft);
    if (sn > scap) { return DEPS_ERR_FULL; }
    bounds[1] = sn;
    var k : usize = 1;
    while (k <= d + 1) {
        const lo : usize = bounds[k - 1];
        const hi : usize = bounds[k];
        var s : usize = 0;
        while (s < n and sn <= scap) {
            const e : usize = line_end(buf, s, n);
            const t : usize = text_end(buf, s, e);
            const p : usize = first_tab(buf, s, t);
            if (p < t and p > s) {
                if (dir == DEPS_IMPORTS) {
                    if (deps_in_range(set, lo, hi, buf, s, p)) { sn = set_add(set, sn, scap, buf, p + 1, t); }
                } else {
                    if (deps_in_range(set, lo, hi, buf, p + 1, t)) { sn = set_add(set, sn, scap, buf, s, p); }
                }
            }
            s = e + 1;
        }
        if (sn > scap) { return DEPS_ERR_FULL; }
        bounds[k + 1] = sn;
        if (sn == hi) { return DEPS_OK; }
        if (k == d + 1) { return DEPS_ERR_DEEP; }
        k += 1;
    }
    return DEPS_OK;
}

/// The last layer that is not empty, after a walk that said DEPS_OK.
pub fn deps_depth(bounds: []const usize, depth: usize) -> usize {
    var d : usize = depth;
    if (d > DEPS_MAX_DEPTH) { d = DEPS_MAX_DEPTH; }
    var k : usize = 1;
    while (k <= d and bounds[k + 1] > bounds[k]) { k += 1; }
    return k - 1;
}

/// Is the focus on a cycle: does some line of the edge list run from a spec of its import set
/// imp[0..isn] (the focus included) back to the focus?
pub fn deps_on_cycle(buf: []const u8, n: usize, focus: []const u8, ff: usize, ft: usize, imp: []const u8, isn: usize) -> bool {
    var s : usize = 0;
    while (s < n) {
        const e : usize = line_end(buf, s, n);
        const t : usize = text_end(buf, s, e);
        const p : usize = first_tab(buf, s, t);
        if (p < t and p > s) {
            if (same(buf, p + 1, t, focus, ff, ft) and deps_in_range(imp, 0, isn, buf, s, p)) { return true; }
        }
        s = e + 1;
    }
    return false;
}

/// Every spec of the edge list buf[0..n] that is on a cycle, one per line, into out[0..cap], in the
/// order of its first line as an importer. A spec that imports nothing is on no cycle, so only
/// importers are walked, each once (done[0..dcap] holds the ones walked). Returns the bytes written,
/// or cap + 1 when the list, a walk's set or the done list does not fit, or a walk is deeper than
/// DEPS_MAX_DEPTH: refused whole, nothing is cut off.
pub fn deps_cycles(buf: []const u8, n: usize, set: []u8, scap: usize, bounds: []usize, done: []u8, dcap: usize, out: []u8, cap: usize) -> usize {
    var w : usize = 0;
    var dn : usize = 0;
    var s : usize = 0;
    while (s < n) {
        const e : usize = line_end(buf, s, n);
        const t : usize = text_end(buf, s, e);
        const p : usize = first_tab(buf, s, t);
        if (p < t and p > s and in_set(done, dn, buf, s, p) == false) {
            dn = set_add(done, dn, dcap, buf, s, p);
            if (dn > dcap) { return cap + 1; }
            if (deps_walk(buf, n, buf, s, p, DEPS_IMPORTS, DEPS_MAX_DEPTH, set, scap, bounds) != DEPS_OK) { return cap + 1; }
            if (deps_on_cycle(buf, n, buf, s, p, set, bounds[deps_depth(bounds, DEPS_MAX_DEPTH) + 1])) {
                w = set_add(out, w, cap, buf, s, p);
                if (w > cap) { return cap + 1; }
            }
        }
        s = e + 1;
    }
    return w;
}

/// Write buf[f..t].
pub fn deps_put_span(out: []u8, w: usize, cap: usize, buf: []const u8, f: usize, t: usize) -> usize {
    var p : usize = w;
    var i : usize = f;
    while (i < t) {
        p = put(out, p, cap, buf[i]);
        i += 1;
    }
    return p;
}

/// Write a '$'-terminated literal.
pub fn deps_put_lit(out: []u8, w: usize, cap: usize, lit: []const u8) -> usize {
    return deps_put_span(out, w, cap, lit, 0, lit_len(lit));
}

/// Write v in decimal.
pub fn deps_put_dec(out: []u8, w: usize, cap: usize, v: usize) -> usize {
    var d : usize = 1;
    while (v / d >= 10) { d = d * 10; }
    var p : usize = w;
    while (d > 0) {
        p = put(out, p, cap, DEPS_DIGITS[(v / d) % 10]);
        d = d / 10;
    }
    return p;
}

/// Write the node lines of one layer, set[lo..hi]: `node<TAB>layer<TAB>x<TAB>y<TAB>path`, the layer
/// with a '-' when neg, the column col, one row per spec.
pub fn deps_put_layer(out: []u8, w: usize, cap: usize, set: []const u8, lo: usize, hi: usize, layer: usize, neg: bool, col: usize) -> usize {
    var p : usize = w;
    var row : usize = 0;
    var i : usize = lo;
    while (i < hi) {
        const e : usize = line_end(set, i, hi);
        p = deps_put_lit(out, p, cap, DEPS_NODE);
        if (neg) { p = put(out, p, cap, '-'); }
        p = deps_put_dec(out, p, cap, layer);
        p = put(out, p, cap, '\t');
        p = deps_put_dec(out, p, cap, DEPS_MARGIN + col * DEPS_COL_STEP);
        p = put(out, p, cap, '\t');
        p = deps_put_dec(out, p, cap, DEPS_MARGIN + row * DEPS_ROW_STEP);
        p = put(out, p, cap, '\t');
        p = deps_put_span(out, p, cap, set, i, e);
        p = put(out, p, cap, '\n');
        row += 1;
        i = e + 1;
    }
    return p;
}

/// The dependencies view of focus[ff..ft] over the edge list buf[0..n], written to out[0..cap]:
///   deps<TAB>focus<TAB>cycle=0|1<TAB>imports=N<TAB>importers=N<TAB>depth=I/R
///   node lines, importer layers first (deepest left), then the focus, then the import layers;
///   edge<TAB>importer<TAB>imported<TAB>exact for each distinct line between two drawn specs.
/// A walk that is refused writes one line, refused<TAB>full|deep<TAB>focus. imp/ib and rev/rb hold the
/// two walks, eset the edges already written. Returns the length, or more than cap when the view does
/// not fit; the caller then refuses it.
pub fn deps_view(buf: []const u8, n: usize, focus: []const u8, ff: usize, ft: usize, depth: usize, imp: []u8, icap: usize, ib: []usize, rev: []u8, rcap: usize, rb: []usize, eset: []u8, ecap: usize, out: []u8, cap: usize) -> usize {
    const si : u8 = deps_walk(buf, n, focus, ff, ft, DEPS_IMPORTS, depth, imp, icap, ib);
    const sr : u8 = deps_walk(buf, n, focus, ff, ft, DEPS_IMPORTERS, depth, rev, rcap, rb);
    var w : usize = 0;
    if (si != DEPS_OK or sr != DEPS_OK) {
        w = deps_put_lit(out, w, cap, DEPS_REFUSED);
        if (si == DEPS_ERR_FULL or sr == DEPS_ERR_FULL) {
            w = deps_put_lit(out, w, cap, DEPS_WHY_FULL);
        } else {
            w = deps_put_lit(out, w, cap, DEPS_WHY_DEEP);
        }
        w = deps_put_span(out, w, cap, focus, ff, ft);
        return put(out, w, cap, '\n');
    }
    const di : usize = deps_depth(ib, depth);
    const dr : usize = deps_depth(rb, depth);
    const isn : usize = ib[di + 1];
    const rsn : usize = rb[dr + 1];
    w = deps_put_lit(out, w, cap, DEPS_HEAD);
    w = deps_put_span(out, w, cap, focus, ff, ft);
    w = put(out, w, cap, '\t');
    w = put(out, w, cap, 'c');
    w = put(out, w, cap, 'y');
    w = put(out, w, cap, 'c');
    w = put(out, w, cap, 'l');
    w = put(out, w, cap, 'e');
    w = put(out, w, cap, '=');
    if (deps_on_cycle(buf, n, focus, ff, ft, imp, isn)) { w = put(out, w, cap, '1'); } else { w = put(out, w, cap, '0'); }
    w = put(out, w, cap, '\t');
    w = deps_put_lit(out, w, cap, "imports=$");
    w = deps_put_dec(out, w, cap, deps_count(imp, 0, isn) - 1);
    w = put(out, w, cap, '\t');
    w = deps_put_lit(out, w, cap, "importers=$");
    w = deps_put_dec(out, w, cap, deps_count(rev, 0, rsn) - 1);
    w = put(out, w, cap, '\t');
    w = deps_put_lit(out, w, cap, "depth=$");
    w = deps_put_dec(out, w, cap, di);
    w = put(out, w, cap, '/');
    w = deps_put_dec(out, w, cap, dr);
    w = put(out, w, cap, '\n');
    var k : usize = dr;
    while (k >= 1) {
        w = deps_put_layer(out, w, cap, rev, rb[k], rb[k + 1], k, true, dr - k);
        k -= 1;
    }
    w = deps_put_layer(out, w, cap, imp, ib[0], ib[1], 0, false, dr);
    k = 1;
    while (k <= di) {
        w = deps_put_layer(out, w, cap, imp, ib[k], ib[k + 1], k, false, dr + k);
        k += 1;
    }
    var en : usize = 0;
    var s : usize = 0;
    while (s < n) {
        const e : usize = line_end(buf, s, n);
        const t : usize = text_end(buf, s, e);
        const p : usize = first_tab(buf, s, t);
        if (p < t and p > s) {
            const a_in : bool = deps_in_range(imp, 0, isn, buf, s, p) or deps_in_range(rev, 0, rsn, buf, s, p);
            const b_in : bool = deps_in_range(imp, 0, isn, buf, p + 1, t) or deps_in_range(rev, 0, rsn, buf, p + 1, t);
            if (a_in and b_in) {
                const before : usize = en;
                en = set_add(eset, en, ecap, buf, s, t);
                if (en > ecap) { return cap + 1; }
                if (en > before) {
                    w = deps_put_lit(out, w, cap, DEPS_EDGE);
                    w = deps_put_span(out, w, cap, buf, s, t);
                    w = deps_put_lit(out, w, cap, DEPS_EXACT);
                }
            }
        }
        s = e + 1;
    }
    return w;
}

// ---- tests ----

// A diamond under the focus a (a imports b and c, both import d), two importers above it (e imports
// a, f imports e), a pair the focus never reaches (x, y), and a repeated line (a imports b twice).
pub const DEPS_FIXTURE : str = "a\tb\na\tc\nb\td\nc\td\ne\ta\nf\te\nx\ty\na\tb\n$";

test the_import_layers_of_a_diamond_list_the_shared_spec_once {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_depth(&b, 8) == 2;
    assert deps_count(&set, b[1], b[2]) == 2;
    assert deps_count(&set, b[2], b[3]) == 1;
    assert deps_in_range(&set, b[2], b[3], "d", 0, 1) == true;
    assert b[3] == 8;
}

test the_importer_layers_walk_the_other_way {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTERS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_depth(&b, 8) == 2;
    assert deps_in_range(&set, b[1], b[2], "e", 0, 1) == true;
    assert deps_in_range(&set, b[2], b[3], "f", 0, 1) == true;
    assert deps_in_range(&set, 0, b[3], "b", 0, 1) == false;
    assert deps_in_range(&set, 0, b[3], "x", 0, 1) == false;
}

test negative_control_a_dag_does_not_flag_a_cycle {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "a", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == false;
}

test a_spec_that_imports_the_focus_back_flags_it {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = "a\tb\na\tc\nb\td\nc\td\nd\ta\n$";
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "a", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == true;
}

// The shape found on the corpus: two specs that import each other (igla::race backend and rtl).
test two_specs_that_import_each_other_are_both_flagged {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = "a\tt\na\tb\nb\tt\nb\ta\nc\tb\n$";
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "a", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == true;
    assert deps_walk(g, lit_len(g), "b", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "b", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == true;
    assert deps_walk(g, lit_len(g), "c", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "c", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == false;
}

test a_self_import_flags_the_focus {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = "a\ta\n$";
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_depth(&b, 8) == 0;
    assert deps_on_cycle(g, lit_len(g), "a", 0, 1, &set, b[1]) == true;
}

test negative_control_a_cycle_the_focus_is_not_on_does_not_flag_it {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = "a\tb\nb\tc\nc\tb\n$";
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "a", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == false;
    assert deps_walk(g, lit_len(g), "b", 0, 1, DEPS_IMPORTS, 8, &set, 64, &b) == DEPS_OK;
    assert deps_on_cycle(g, lit_len(g), "b", 0, 1, &set, b[deps_depth(&b, 8) + 1]) == true;
}

test negative_control_a_set_that_does_not_fit_is_refused {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 5, &b) == DEPS_ERR_FULL;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 8, &set, 8, &b) == DEPS_OK;
}

test negative_control_a_walk_deeper_than_asked_is_refused {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    const g : str = "a\tb\nb\tc\nc\td\n$";
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 2, &set, 64, &b) == DEPS_ERR_DEEP;
    assert deps_walk(g, lit_len(g), "a", 0, 1, DEPS_IMPORTS, 3, &set, 64, &b) == DEPS_OK;
    assert deps_depth(&b, 3) == 3;
}

test the_view_lays_out_importers_left_and_imports_right_with_exact_edges {
    var imp : [64]u8 = undefined;
    var ib : [35]usize = undefined;
    var rev : [64]u8 = undefined;
    var rb : [35]usize = undefined;
    var es : [128]u8 = undefined;
    var out : [512]u8 = undefined;
    const g : str = DEPS_FIXTURE;
    const w : usize = deps_view(g, lit_len(g), "a", 0, 1, 8, &imp, 64, &ib, &rev, 64, &rb, &es, 128, &out, 512);
    const want : str = "deps\ta\tcycle=0\timports=3\timporters=2\tdepth=2/2\nnode\t-2\t40\t40\tf\nnode\t-1\t300\t40\te\nnode\t0\t560\t40\ta\nnode\t1\t820\t40\tb\nnode\t1\t820\t104\tc\nnode\t2\t1080\t40\td\nedge\ta\tb\texact\nedge\ta\tc\texact\nedge\tb\td\texact\nedge\tc\td\texact\nedge\te\ta\texact\nedge\tf\te\texact\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
}

test negative_control_a_repeated_line_is_one_edge {
    var imp : [64]u8 = undefined;
    var ib : [35]usize = undefined;
    var rev : [64]u8 = undefined;
    var rb : [35]usize = undefined;
    var es : [128]u8 = undefined;
    var out : [256]u8 = undefined;
    const g : str = "a\tb\na\tb\na\tb\n$";
    const w : usize = deps_view(g, lit_len(g), "a", 0, 1, 8, &imp, 64, &ib, &rev, 64, &rb, &es, 128, &out, 256);
    assert w <= 256;
    assert deps_count(&out, 0, w) == 4;
}

test negative_control_a_refused_walk_writes_one_refusal_line {
    var imp : [64]u8 = undefined;
    var ib : [35]usize = undefined;
    var rev : [64]u8 = undefined;
    var rb : [35]usize = undefined;
    var es : [128]u8 = undefined;
    var out : [256]u8 = undefined;
    const g : str = DEPS_FIXTURE;
    const w : usize = deps_view(g, lit_len(g), "a", 0, 1, 8, &imp, 5, &ib, &rev, 64, &rb, &es, 128, &out, 256);
    const want : str = "refused\tfull\ta\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
    const w2 : usize = deps_view(g, lit_len(g), "a", 0, 1, 1, &imp, 64, &ib, &rev, 64, &rb, &es, 128, &out, 256);
    const want2 : str = "refused\tdeep\ta\n$";
    assert same(&out, 0, w2, want2, 0, lit_len(want2)) == true;
}

test negative_control_a_view_that_does_not_fit_returns_more_than_cap {
    var imp : [64]u8 = undefined;
    var ib : [35]usize = undefined;
    var rev : [64]u8 = undefined;
    var rb : [35]usize = undefined;
    var es : [128]u8 = undefined;
    var out : [32]u8 = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_view(g, lit_len(g), "a", 0, 1, 8, &imp, 64, &ib, &rev, 64, &rb, &es, 128, &out, 32) > 32;
    assert deps_view(g, lit_len(g), "a", 0, 1, 8, &imp, 64, &ib, &rev, 64, &rb, &es, 4, &out, 32) > 32;
}

// The corpus question #10682 asked one spec at a time: which specs are on a cycle?
test the_old_igla_pair_lists_both_specs_and_not_their_importer {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = "a\tt\na\tb\nb\tt\nb\ta\nc\tb\n$";
    const w : usize = deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 64);
    const want : str = "a\nb\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
}

test negative_control_a_dag_lists_no_spec {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = DEPS_FIXTURE;
    assert deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 64) == 0;
}

test a_cycle_the_first_spec_is_not_on_lists_only_the_cycle {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = "a\tb\nb\tc\nc\tb\n$";
    const w : usize = deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 64);
    const want : str = "b\nc\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
}

test a_self_import_is_a_cycle_of_one {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = "a\ta\n$";
    const w : usize = deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 64);
    const want : str = "a\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
}

test two_cycles_and_a_repeated_line_list_each_spec_once {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = "p\tq\nq\tp\nx\ty\ny\tz\nz\tx\np\tq\n$";
    const w : usize = deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 64);
    const want : str = "p\nq\nx\ny\nz\n$";
    assert w == lit_len(want);
    assert same(&out, 0, w, want, 0, lit_len(want)) == true;
}

test negative_control_a_list_that_does_not_fit_is_refused_whole {
    var set : [64]u8 = undefined;
    var b : [35]usize = undefined;
    var done : [64]u8 = undefined;
    var out : [64]u8 = undefined;
    const g : str = "p\tq\nq\tp\nx\ty\ny\tz\nz\tx\n$";
    assert deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 9) == 10;
    assert deps_cycles(g, lit_len(g), &set, 64, &b, &done, 64, &out, 10) == 10;
    assert deps_cycles(g, lit_len(g), &set, 64, &b, &done, 9, &out, 64) == 65;
    assert deps_cycles(g, lit_len(g), &set, 3, &b, &done, 64, &out, 64) == 65;
}
