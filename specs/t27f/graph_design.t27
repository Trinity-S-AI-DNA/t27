// SPDX-License-Identifier: Apache-2.0
; specs/t27f/graph_design.t27 -- the design system of the live mycelium graph
; (epic #12779). Two visual modes on the SAME event data:
;   MYCELIUM: organic golden-spiral layout, nodes as circles, overview.
;   MAP: structured layered layout with groups, task cards, inspector.
; --
; NODE SEMANTICS (what each visual element means):
;   NODE_TASK       a unit of work with a label and a state
;   NODE_AGENT      the executor of a task (badge inside/near the task card)
;   NODE_RESOURCE   an external resource (repo, server, file)
;   NODE_GROUP      a container for related tasks (group/lane/repo)
; PID is a technical detail for the inspector, not the main visual label.
; --
; EDGE SEMANTICS (what each connection means):
;   EDGE_ASSIGN     queen assigned this task to this agent
;   EDGE_DEPENDS    this task depends on that task
;   EDGE_PRODUCES   this task produced that artifact
;   EDGE_CONTAINS   this group contains this task
; Edges are drawn ONLY when the data source confirms the relation. No invented edges.
; --
; STATE COLORS (colour encodes state, text preserves meaning):
;   WORKING: calm accent (blue) + text "working"
;   BLOCKED: amber marker + reason
;   DONE:    neutral green, no glow
;   ERROR:   red accent in the problem area
;   STALE:   muted + explicit timestamp
;   UNKNOWN: neutral marker "?"
; --
; SELECTION: clicking a node highlights its immediate neighbourhood and dims
; the rest. The inspector shows: label, state, reason, pid, last event time.
; --
; NO FIXTURE DATA. The data source is the replay adapter (TAP_REPLAY through
; live_tap.t27) or the live tap. Both are named on the surface.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fGraphDesign;

// ---- node types -----------------------------------------------------------------

/// A unit of work with a label and a state.
pub const ND_TASK : u8 = 0;
/// The executor of a task (small badge near the task card).
pub const ND_AGENT : u8 = 1;
/// An external resource (repo, server, file).
pub const ND_RESOURCE : u8 = 2;
/// A container for related tasks (group/lane/repo).
pub const ND_GROUP : u8 = 3;
pub const ND_TYPE_COUNT : u8 = 4;

pub const ND_TYPE_NAMES : [4]str = ["task", "agent", "resource", "group"];

// ---- edge semantics ---------------------------------------------------------------

/// Queen assigned this task to this agent.
pub const EG_ASSIGN : u8 = 0;
/// This task depends on that task.
pub const EG_DEPENDS : u8 = 1;
/// This task produced that artifact.
pub const EG_PRODUCES : u8 = 2;
/// This group contains this task.
pub const EG_CONTAINS : u8 = 3;
pub const EG_TYPE_COUNT : u8 = 4;

// ---- states ------------------------------------------------------------------------

/// Calm accent (blue) + text "working".
pub const ST_WORKING : u8 = 0;
/// Amber marker + reason.
pub const ST_BLOCKED : u8 = 1;
/// Neutral green, no glow.
pub const ST_DONE : u8 = 2;
/// Red accent in the problem area.
pub const ST_ERROR : u8 = 3;
/// Muted + explicit timestamp.
pub const ST_STALE : u8 = 4;
/// Neutral marker "?".
pub const ST_UNKNOWN : u8 = 5;
pub const ST_COUNT : u8 = 6;

pub const ST_NAMES : [6]str = ["working", "blocked", "done", "error", "stale", "?"];

// ---- state colours (RGB 0..1) ------------------------------------------------------

/// WORKING: calm blue accent.
pub const SC_WORKING_R : f64 = 0.345;
pub const SC_WORKING_G : f64 = 0.651;
pub const SC_WORKING_B : f64 = 1.000;
/// BLOCKED: amber.
pub const SC_BLOCKED_R : f64 = 0.824;
pub const SC_BLOCKED_G : f64 = 0.600;
pub const SC_BLOCKED_B : f64 = 0.133;
/// DONE: neutral green.
pub const SC_DONE_R : f64 = 0.247;
pub const SC_DONE_G : f64 = 0.725;
pub const SC_DONE_B : f64 = 0.314;
/// ERROR: red.
pub const SC_ERROR_R : f64 = 0.973;
pub const SC_ERROR_G : f64 = 0.318;
pub const SC_ERROR_B : f64 = 0.286;
/// STALE: muted grey.
pub const SC_STALE_R : f64 = 0.545;
pub const SC_STALE_G : f64 = 0.573;
pub const SC_STALE_B : f64 = 0.620;
/// UNKNOWN: neutral.
pub const SC_UNKNOWN_R : f64 = 0.400;
pub const SC_UNKNOWN_G : f64 = 0.400;
pub const SC_UNKNOWN_B : f64 = 0.400;

// ---- visual modes ------------------------------------------------------------------

/// MYCELIUM: organic golden-spiral layout, nodes as circles, overview.
pub const MODE_MYCELIUM : u8 = 0;
/// MAP: structured layered layout with groups, task cards, inspector.
pub const MODE_MAP : u8 = 1;
pub const MODE_COUNT : u8 = 2;

pub const MODE_NAMES : [2]str = ["mycelium", "work map"];

// ---- node record --------------------------------------------------------------------

/// A graph node: identity, label, type, state, and optional pid for the inspector.
pub struct DesignNode {
    pub id : u32,
    pub label_len : u32,
    pub label : [48]u8,
    pub node_type : u8,
    pub state : u8,
    pub pid : u64,
    pub group_id : u32,
    pub selected : bool,
}

/// A graph edge: from node to node with a confirmed semantic.
pub struct DesignEdge {
    pub from : u32,
    pub to : u32,
    pub semantic : u8,
}

// ---- layout: MYCELIUM mode -----------------------------------------------------------

/// MYCELIUM: nodes on a golden spiral from centre. Pure arithmetic, no trig.
; Node i at angle = golden_angle * i, distance = radius * sqrt((i+1)/n).
pub fn gd_mycelium_pos(i : u32, n : u32, cx : f64, cy : f64, r : f64, ox : []f64, oy : []f64) -> void {
    if (n == 0) { ox[0] = cx; oy[0] = cy; return; }
    // golden angle: 137.507 degrees = 2.39996 rad
    const golden : f64 = 2.39996322973;
    const angle : f64 = golden * (@as(f64, @floatFromInt(i)) + 0.5);
    const dist : f64 = r * (@as(f64, @floatFromInt(i + 1)) / @as(f64, @floatFromInt(n)));
    // Taylor series cos/sin (3 terms, enough for layout)
    var c : f64 = 1.0;
    var s : f64 = 0.0;
    var tc : f64 = 1.0;
    var ts : f64 = angle;
    var sign : f64 = 1.0;
    var j : u32 = 0;
    while (j < 5) {
        c = c + sign * tc;
        s = s + sign * ts;
        tc = tc * angle * angle / @as(f64, @floatFromInt((j + 2) * (j + 3)));
        ts = ts * angle * angle / @as(f64, @floatFromInt((j + 3) * (j + 4)));
        sign = 0.0 - sign;
        j = j + 1;
    }
    ox[0] = cx + dist * c;
    oy[0] = cy + dist * s;
}

// ---- layout: MAP mode ----------------------------------------------------------------

/// MAP: nodes layered by group. Group g gets a horizontal band; nodes within
; a group are spread across the band width. Task cards are wider than badges.
pub fn gd_map_pos(i : u32, group_id : u32, group_count : u32, nodes_in_group : u32,
    x : f64, y : f64, w : f64, h : f64, ox : []f64, oy : []f64) -> void {
    if (group_count == 0) { ox[0] = x; oy[0] = y; return; }
    const band_h : f64 = h / @as(f64, @floatFromInt(group_count));
    const band_y : f64 = y + band_h * @as(f64, @floatFromInt(group_id));
    const band_w : f64 = w - 40.0;
    const node_w : f64 = band_w / @as(f64, @floatFromInt(nodes_in_group + 1));
    const node_x : f64 = x + 20.0 + node_w * @as(f64, @floatFromInt(i));
    ox[0] = node_x;
    oy[0] = band_y + band_h / 2.0;
}

// ---- selection ------------------------------------------------------------------------

/// Whether a node is in the highlighted neighbourhood of `selected`:
; the node itself, or connected by an edge to/from `selected`.
pub fn gd_in_neighbourhood(node_id : u32, selected : u32, edges : []const DesignEdge, edge_count : u32) -> bool {
    if (node_id == selected) { return true; }
    var e : u32 = 0;
    while (e < edge_count) {
        if (edges[e as usize].from == selected and edges[e as usize].to == node_id) { return true; }
        if (edges[e as usize].to == selected and edges[e as usize].from == node_id) { return true; }
        e = e + 1;
    }
    return false;
}

/// The dim factor for a node: 1.0 if in the highlighted neighbourhood, 0.15 otherwise.
pub fn gd_dim_factor(node_id : u32, selected : u32, edges : []const DesignEdge, edge_count : u32) -> f64 {
    if (selected == 0) { return 1.0; }   // 0 = no selection, all at full brightness
    if (gd_in_neighbourhood(node_id, selected, edges, edge_count)) { return 1.0; }
    return 0.15;
}

// ---- state colour accessor -------------------------------------------------------------

/// RGB of a state: three separate functions (t27 does not return tuples).
pub fn gd_state_r(state : u8) -> f64 {
    if (state == ST_WORKING) { return SC_WORKING_R; }
    if (state == ST_BLOCKED) { return SC_BLOCKED_R; }
    if (state == ST_DONE) { return SC_DONE_R; }
    if (state == ST_ERROR) { return SC_ERROR_R; }
    if (state == ST_STALE) { return SC_STALE_R; }
    return SC_UNKNOWN_R;
}
pub fn gd_state_g(state : u8) -> f64 {
    if (state == ST_WORKING) { return SC_WORKING_G; }
    if (state == ST_BLOCKED) { return SC_BLOCKED_G; }
    if (state == ST_DONE) { return SC_DONE_G; }
    if (state == ST_ERROR) { return SC_ERROR_G; }
    if (state == ST_STALE) { return SC_STALE_G; }
    return SC_UNKNOWN_G;
}
pub fn gd_state_b(state : u8) -> f64 {
    if (state == ST_WORKING) { return SC_WORKING_B; }
    if (state == ST_BLOCKED) { return SC_BLOCKED_B; }
    if (state == ST_DONE) { return SC_DONE_B; }
    if (state == ST_ERROR) { return SC_ERROR_B; }
    if (state == ST_STALE) { return SC_STALE_B; }
    return SC_UNKNOWN_B;
}

/// State name text.
pub fn gd_state_name(state : u8) -> []const u8 {
    if (state < ST_COUNT) { return ST_NAMES[state]; }
    return ST_NAMES[ST_UNKNOWN];
}

// ---- tests ----------------------------------------------------------------------

fn gdeq(a : []const u8, b : []const u8) -> bool {
    if (a.len != b.len) { return false; }
    var i : usize = 0;
    while (i < a.len) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

test node_types_are_sequential {
    assert(ND_TASK == 0 and ND_AGENT == 1 and ND_RESOURCE == 2 and ND_GROUP == 3);
    assert(ND_TYPE_COUNT == 4);
}

test edge_semantics_are_sequential {
    assert(EG_ASSIGN == 0 and EG_DEPENDS == 1 and EG_PRODUCES == 2 and EG_CONTAINS == 3);
    assert(EG_TYPE_COUNT == 4);
}

test states_are_sequential_with_names {
    assert(ST_WORKING == 0 and ST_BLOCKED == 1 and ST_DONE == 2);
    assert(ST_ERROR == 3 and ST_STALE == 4 and ST_UNKNOWN == 5);
    assert(ST_COUNT == 6);
    assert(gdeq(ST_NAMES[0], "working"));
    assert(gdeq(ST_NAMES[1], "blocked"));
    assert(gdeq(ST_NAMES[5], "?"));
}

test state_colours_are_distinct {
    // each state has a unique colour (compare R channel pairwise)
    var a : u8 = 0;
    while (a < ST_COUNT) {
        var b : u8 = a + 1;
        while (b < ST_COUNT) {
            assert(gd_state_r(a) != gd_state_r(b) or gd_state_g(a) != gd_state_g(b));
            b = b + 1;
        }
        a = a + 1;
    }
}

test visual_modes_are_sequential {
    assert(MODE_MYCELIUM == 0 and MODE_MAP == 1 and MODE_COUNT == 2);
    assert(gdeq(MODE_NAMES[0], "mycelium"));
    assert(gdeq(MODE_NAMES[1], "work map"));
}

test mycelium_layout_places_nodes_on_spiral {
    var ox : [2]f64 = undefined;
    var oy : [2]f64 = undefined;
    // single node at centre
    gd_mycelium_pos(0, 1, 100.0, 200.0, 50.0, ox[0..2], oy[0..2]);
    // first node is at distance r * 1/1 from centre, at golden angle 0.5 * golden
    assert(ox[0] > 100.0);  // cos(0.5 * golden) > 0 for golden ≈ 2.4 rad
    // multiple nodes spread outward
    var ox2 : [2]f64 = undefined;
    var oy2 : [2]f64 = undefined;
    gd_mycelium_pos(0, 5, 100.0, 200.0, 50.0, ox2[0..2], oy2[0..2]);
    gd_mycelium_pos(4, 5, 100.0, 200.0, 50.0, ox2[0..2], oy2[0..2]);
    // node 4 is farther from centre than node 0
    var d0 : f64 = (ox2[0] - 100.0) * (ox2[0] - 100.0) + (oy2[0] - 200.0) * (oy2[0] - 200.0);
    var d4 : f64 = (ox2[0] - 100.0) * (ox2[0] - 100.0) + (oy2[0] - 200.0) * (oy2[0] - 200.0);
    assert(d4 >= d0);
}

test map_layout_places_nodes_in_bands {
    var ox : [2]f64 = undefined;
    var oy : [2]f64 = undefined;
    // group 0, node 0 of 2: left half of top band
    gd_map_pos(0, 0, 3, 2, 0.0, 0.0, 600.0, 400.0, ox[0..2], oy[0..2]);
    assert(oy[0] < 400.0 / 3.0);   // in the top band
    assert(ox[0] < 300.0);          // left half
    // group 2, node 0 of 1: bottom band
    gd_map_pos(0, 2, 3, 1, 0.0, 0.0, 600.0, 400.0, ox[0..2], oy[0..2]);
    assert(oy[0] > 400.0 * 2.0 / 3.0);   // in the bottom band
}

test neighbourhood_detection_works {
    var edges : [3]DesignEdge = undefined;
    edges[0] = DesignEdge { from: 1, to: 2, semantic: EG_ASSIGN };
    edges[1] = DesignEdge { from: 2, to: 3, semantic: EG_DEPENDS };
    edges[2] = DesignEdge { from: 3, to: 4, semantic: EG_PRODUCES };
    // node 2 is 1 hop from node 1 (edge 1->2)
    assert(gd_in_neighbourhood(2, 1, edges[0..3], 3));
    // node 3 is 2 hops from node 1 (1->2->3): NOT in 1-hop neighbourhood
    assert(gd_in_neighbourhood(3, 1, edges[0..3], 3) == false);
    // node 4 is 3 hops from node 1: NOT in neighbourhood
    assert(gd_in_neighbourhood(4, 1, edges[0..3], 3) == false);
    // the node itself is always in its own neighbourhood
    assert(gd_in_neighbourhood(1, 1, edges[0..3], 3));
    // node 1 is 1 hop from node 2 (reverse direction)
    assert(gd_in_neighbourhood(1, 2, edges[0..3], 3));
}

test dim_factor_gives_full_brightness_for_neighbours {
    var edges : [1]DesignEdge = undefined;
    edges[0] = DesignEdge { from: 1, to: 2, semantic: EG_ASSIGN };
    // no selection: all bright
    assert(gd_dim_factor(3, 0, edges[0..1], 1) == 1.0);
    // selected node 1: neighbours bright
    assert(gd_dim_factor(1, 1, edges[0..1], 1) == 1.0);
    assert(gd_dim_factor(2, 1, edges[0..1], 1) == 1.0);
    // non-neighbour dimmed
    assert(gd_dim_factor(3, 1, edges[0..1], 1) < 0.5);
}

test state_name_returns_correct_text {
    assert(gdeq(gd_state_name(ST_WORKING), "working"));
    assert(gdeq(gd_state_name(ST_BLOCKED), "blocked"));
    assert(gdeq(gd_state_name(ST_DONE), "done"));
    assert(gdeq(gd_state_name(ST_ERROR), "error"));
    assert(gdeq(gd_state_name(ST_STALE), "stale"));
    assert(gdeq(gd_state_name(ST_UNKNOWN), "?"));
    assert(gdeq(gd_state_name(99), "?"));
}

invariant node_type_count_is_four {
    assert(ND_TYPE_COUNT == 4);
}

invariant edge_type_count_is_four {
    assert(EG_TYPE_COUNT == 4);
}

invariant state_count_is_six {
    assert(ST_COUNT == 6);
}
