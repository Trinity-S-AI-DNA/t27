// SPDX-License-Identifier: Apache-2.0
; specs/t27f/task_template.t27 -- the template of a typical T27F task. Refs #13665, epic #13650.
; Why. Every "show X through T27F" task walks the same road: pin the source, count it, give it a
; meaning by rule, name the tokens, plan the picture, write the picture, pass the lab, render,
; keep the evidence. Without one template each task invents its own order, and a task that only
; classifies is reported as one that draws.
; What this module is: the nine stages in order, which of them each task kind requires, what must
; be done before a stage may start, the next stage of a task, and which claim a task may make.
; A task is a kind plus a bit mask of finished stages; nothing else is stored.
; --
; The stages (one artifact each):
; - SOURCE     the input, external or in-repo, pinned by hash.
; - DATA       a spec that counts the source (census); every row exact.
; - MEANING    a spec that gives each row one class by rule; derived.
; - TOKENS     the token kinds and labels of the view, colours read from vf_theme.
; - STRUCTURE  a spec from class to picture plan, in token kinds only.
; - PICTURE    a spec that writes the artifact (SVG still, text outline, frame).
; - RECEIPT    a lab run of every spec above with blocked=0 and FAIL=0.
; - RENDER     the artifact made by the generated program, not by hand.
; - EVIDENCE   artifact, log and receipt linked from the issue.
; The task kinds:
; - STILL      a new view of a new source: all nine stages.
; - OUTLINE    a text view: no TOKENS stage.
; - DATA_ONLY  a census with no picture: SOURCE, DATA, RECEIPT, EVIDENCE.
; - RESTYLE    a new look over data that already has a receipt: TOKENS, PICTURE, RECEIPT, RENDER,
;              EVIDENCE.
; The claims: CLASSIFIES needs DATA, MEANING and RECEIPT (where the kind requires them); DRAWS needs
; PICTURE, RECEIPT and RENDER; DONE needs every required stage. A kind that has no picture can never
; claim DRAWS.
; --
; The worked example is the netlist constructor of epic #13650: kind STILL, stages SOURCE..RECEIPT
; done by specs/tools/t27o/spice_census_host.t27, specs/analog/netlist_meaning.t27,
; specs/t27f/netlist_tokens.t27, specs/analog/netlist_structure.t27 and
; specs/analog/netlist_block_svg.t27.
; --
; NOT claimed: the template does not check that an artifact exists or that a receipt is real (the
; caller sets the bits); it names no file, model or agent; it covers stills, outlines, census and
; restyle tasks, not reels or live surfaces.
; Every private helper carries the tt_ prefix. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_task_template;

pub const TT_SOURCE : u32 = 0;
pub const TT_DATA : u32 = 1;
pub const TT_MEANING : u32 = 2;
pub const TT_TOKENS : u32 = 3;
pub const TT_STRUCTURE : u32 = 4;
pub const TT_PICTURE : u32 = 5;
pub const TT_RECEIPT : u32 = 6;
pub const TT_RENDER : u32 = 7;
pub const TT_EVIDENCE : u32 = 8;
pub const TT_STAGES : u32 = 9;
pub const TT_NONE : u32 = 255;

pub const TT_STAGE_NAMES : str = "source,data,meaning,tokens,structure,picture,receipt,render,evidence";

pub const TT_STILL : u32 = 0;
pub const TT_OUTLINE : u32 = 1;
pub const TT_DATA_ONLY : u32 = 2;
pub const TT_RESTYLE : u32 = 3;
pub const TT_KINDS : u32 = 4;

pub const TT_KIND_NAMES : str = "still,outline,data_only,restyle";

pub const TT_CLASSIFIES : u32 = 0;
pub const TT_DRAWS : u32 = 1;
pub const TT_DONE : u32 = 2;
pub const TT_CLAIMS : u32 = 3;

; required stages of each kind, bit s = stage s: 511, 503, 323, 488
pub const TT_REQUIRED : [4]u32 = [511, 503, 323, 488];

pub fn tt_bit(stage: u32) -> u32 {
    if stage >= TT_STAGES {
        return 0;
    }
    var b : u32 = 1;
    var i : u32 = 0;
    while i < stage {
        b = b * 2;
        i = i + 1;
    }
    return b;
}

pub fn tt_has(mask: u32, stage: u32) -> bool {
    let b : u32 = tt_bit(stage);
    if b == 0 {
        return false;
    }
    return ((mask / b) % 2) == 1;
}

pub fn tt_required(kind: u32) -> u32 {
    if kind >= TT_KINDS {
        return 0;
    }
    return TT_REQUIRED[kind as usize];
}

pub fn tt_requires(kind: u32, stage: u32) -> bool {
    return tt_has(tt_required(kind), stage);
}

; a stage may start when every required earlier stage is finished
pub fn tt_ready(kind: u32, done: u32, stage: u32) -> bool {
    if !tt_requires(kind, stage) {
        return false;
    }
    var s : u32 = 0;
    while s < stage {
        if tt_requires(kind, s) {
            if !tt_has(done, s) {
                return false;
            }
        }
        s = s + 1;
    }
    return true;
}

; the first required stage that is not finished, TT_NONE when the task is complete or the kind unknown
pub fn tt_next(kind: u32, done: u32) -> u32 {
    if kind >= TT_KINDS {
        return TT_NONE;
    }
    var s : u32 = 0;
    while s < TT_STAGES {
        if tt_requires(kind, s) {
            if !tt_has(done, s) {
                return s;
            }
        }
        s = s + 1;
    }
    return TT_NONE;
}

pub fn tt_left(kind: u32, done: u32) -> u32 {
    var n : u32 = 0;
    var s : u32 = 0;
    while s < TT_STAGES {
        if tt_requires(kind, s) {
            if !tt_has(done, s) {
                n = n + 1;
            }
        }
        s = s + 1;
    }
    return n;
}

fn tt_need(kind: u32, done: u32, stage: u32) -> bool {
    if !tt_requires(kind, stage) {
        return true;
    }
    return tt_has(done, stage);
}

pub fn tt_claim_ok(kind: u32, done: u32, claim: u32) -> bool {
    if kind >= TT_KINDS {
        return false;
    }
    if claim == TT_CLASSIFIES {
        if !tt_requires(kind, TT_DATA) {
            return false;
        }
        if !tt_need(kind, done, TT_DATA) {
            return false;
        }
        if !tt_need(kind, done, TT_MEANING) {
            return false;
        }
        return tt_has(done, TT_RECEIPT);
    }
    if claim == TT_DRAWS {
        if !tt_requires(kind, TT_PICTURE) {
            return false;
        }
        if !tt_has(done, TT_PICTURE) {
            return false;
        }
        if !tt_has(done, TT_RECEIPT) {
            return false;
        }
        return tt_has(done, TT_RENDER);
    }
    if claim == TT_DONE {
        return tt_left(kind, done) == 0;
    }
    return false;
}

test the_masks_name_the_stages_of_each_kind {
    assert tt_required(TT_STILL) == 511;
    assert tt_left(TT_STILL, 0) == 9;
    assert tt_left(TT_OUTLINE, 0) == 8;
    assert !tt_requires(TT_OUTLINE, TT_TOKENS);
    assert tt_left(TT_DATA_ONLY, 0) == 4;
    assert tt_requires(TT_DATA_ONLY, TT_SOURCE);
    assert tt_requires(TT_DATA_ONLY, TT_DATA);
    assert tt_requires(TT_DATA_ONLY, TT_RECEIPT);
    assert tt_requires(TT_DATA_ONLY, TT_EVIDENCE);
    assert tt_left(TT_RESTYLE, 0) == 5;
    assert !tt_requires(TT_RESTYLE, TT_DATA);
    assert tt_required(TT_KINDS) == 0;
    assert tt_bit(TT_STAGES) == 0;
}

test the_next_stage_walks_in_order_and_skips_what_a_kind_does_not_need {
    assert tt_next(TT_STILL, 0) == TT_SOURCE;
    assert tt_next(TT_STILL, 1) == TT_DATA;
    assert tt_next(TT_STILL, 127) == TT_RENDER;
    assert tt_next(TT_STILL, 511) == TT_NONE;
    assert tt_next(TT_OUTLINE, 7) == TT_STRUCTURE;
    assert tt_next(TT_DATA_ONLY, 3) == TT_RECEIPT;
    assert tt_next(TT_RESTYLE, 0) == TT_TOKENS;
    assert tt_next(TT_KINDS, 0) == TT_NONE;
}

test a_stage_is_ready_only_after_the_required_stages_before_it {
    assert tt_ready(TT_STILL, 0, TT_SOURCE);
    assert !tt_ready(TT_STILL, 0, TT_DATA);
    assert tt_ready(TT_STILL, 63, TT_RECEIPT);
    assert !tt_ready(TT_STILL, 63, TT_RENDER);
    assert tt_ready(TT_STILL, 127, TT_RENDER);
    assert tt_ready(TT_RESTYLE, 0, TT_TOKENS);
    assert !tt_ready(TT_OUTLINE, 7, TT_TOKENS);
    assert !tt_ready(TT_STILL, 511, TT_STAGES);
}

; 127 = source..receipt, the netlist task before its render; 191 = a render with no receipt;
; 7 = classified with no receipt
test a_task_that_only_classifies_may_not_claim_that_it_draws {
    assert tt_claim_ok(TT_STILL, 127, TT_CLASSIFIES);
    assert !tt_claim_ok(TT_STILL, 127, TT_DRAWS);
    assert !tt_claim_ok(TT_STILL, 127, TT_DONE);
    assert tt_claim_ok(TT_STILL, 255, TT_DRAWS);
    assert !tt_claim_ok(TT_STILL, 255, TT_DONE);
    assert tt_claim_ok(TT_STILL, 511, TT_DONE);
    assert !tt_claim_ok(TT_STILL, 191, TT_DRAWS);
    assert !tt_claim_ok(TT_STILL, 7, TT_CLASSIFIES);
}

test a_kind_with_no_picture_never_draws_and_unknown_inputs_are_refused {
    assert !tt_claim_ok(TT_DATA_ONLY, 511, TT_DRAWS);
    assert tt_claim_ok(TT_DATA_ONLY, 323, TT_DONE);
    assert tt_claim_ok(TT_DATA_ONLY, 67, TT_CLASSIFIES);
    assert !tt_claim_ok(TT_RESTYLE, 511, TT_CLASSIFIES);
    assert tt_claim_ok(TT_RESTYLE, 488, TT_DONE);
    assert !tt_claim_ok(TT_KINDS, 511, TT_DONE);
    assert !tt_claim_ok(TT_STILL, 511, TT_CLAIMS);
}
