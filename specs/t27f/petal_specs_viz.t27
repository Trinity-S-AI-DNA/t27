; ---------------------------------------------------------------- constants

/// The fixture: 15 nodes, 16 edges, so 31 focusable items (nodes first, then edges).
pub const PSV_NODE_COUNT : u32 = 15;
pub const PSV_EDGE_COUNT : u32 = 16;
pub const PSV_MAX_NODES : u32 = 16;
pub const PSV_MAX_EDGES : u32 = 16;
/// Matrix cell (i, j) is the entity viz_ref(CELL, i * PSV_STRIDE + j).
pub const PSV_STRIDE : u32 = 16;
/// One bit per edge, bit j = edge j enabled: the 16 edges of the fixture.
pub const PSV_ALL_EDGES : u32 = 65535;

/// Message-passing rounds; a trace holds layers 0..PSV_LAYERS, so PSV_LAYERS + 1 rows of 16.
pub const PSV_LAYERS : u32 = 4;
pub const PSV_SEED : u64 = 1000000;
pub const PSV_AGG_SUM : u32 = 0;
pub const PSV_AGG_MEAN : u32 = 1;
pub const PSV_AGG_MAX : u32 = 2;
pub const PSV_AGG_COUNT : u32 = 3;

/// "No node": no seed, an edge index out of range. Not a valid node number.
pub const PSV_NO_SEED : u32 = 65535;
pub const PSV_NO_NODE : u32 = 65535;
/// Breadth-first distance of an unreachable node.
pub const PSV_FAR : u32 = 65535;

/// The one petal event. Above VIZ_EV_COUNT, so it cannot collide with a contract event.
pub const PSV_EV_TOGGLE_EDGE : u8 = 32;
/// A fourth highlight, after VIZ_HL_NONE/HOVER/SELECT: related to the selection, not the selection.
pub const PSV_HL_RELATED : u8 = 3;

/// Pixel geometry in frame coordinates.
pub const PSV_FRAME_W : u32 = 1900;
pub const PSV_FRAME_H : u32 = 1000;
pub const PSV_GRAPH_X : u32 = 20;
pub const PSV_GRAPH_Y : u32 = 60;
pub const PSV_GRAPH_W : u32 = 1860;
pub const PSV_GRAPH_H : u32 = 484;
pub const PSV_CELL : u32 = 24;
pub const PSV_MATRIX_N : u32 = 15;
pub const PSV_MATRIX_X : u32 = 20;
pub const PSV_MATRIX_Y : u32 = 580;
pub const PSV_LINE_H : u32 = 22;
pub const PSV_LIST_W : u32 = 440;
pub const PSV_LIST_X : u32 = 420;
pub const PSV_LIST_Y : u32 = 580;

/// Host slot numbers, in the depth-first order psv_host adds them (index order is focus order).
pub const PSV_SLOT_FRAME : u32 = 0;
pub const PSV_SLOT_BADGE : u32 = 1;
pub const PSV_SLOT_CHOICE : u32 = 2;
pub const PSV_SLOT_STEPPER : u32 = 3;
pub const PSV_SLOT_GRAPH : u32 = 4;
pub const PSV_SLOT_MATRIX : u32 = 5;
pub const PSV_SLOT_LIST : u32 = 6;
pub const PSV_SLOT_TRACE : u32 = 7;
pub const PSV_SLOT_INSPECTOR : u32 = 8;

/// Hand-read from tutorial_08_graph() and NOT computed: the oracle the tests check the code against.
/// Distinct neighbours of each node, all 16 edges on (the pairs are {0,1} {2,4} {3,4} {6,8} {7,9}
/// {8,10} {9,11} {4,12} {2,13}; the sum is 2 * 9 = 18).
pub const PSV_HAND_DEGREE : [15]u32 = [1, 1, 2, 1, 3, 0, 1, 1, 2, 2, 1, 1, 1, 1, 0];
/// Hand-read: how many of the 16 edges have each node as an end (the sum is 2 * 16 = 32).
pub const PSV_HAND_TOUCH : [15]u32 = [1, 1, 3, 2, 6, 0, 2, 2, 4, 4, 2, 2, 2, 1, 0];
/// Hand-read: how many nodes (itself included) each node reaches; the components are {0,1}
/// {2,3,4,12,13} {5} {6,8,10} {7,9,11} {14}, so the sum is 49.
pub const PSV_HAND_REACH : [15]u32 = [2, 2, 5, 5, 5, 1, 3, 3, 3, 3, 3, 3, 5, 5, 1];

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the set of enabled edges.
pub struct PsvState {
    viz: VizState,
    mask: u32,
}

/// 2^k, for k < 32.
pub fn psv_bit(k: u32) -> u32 {
    return (1 as u32) << k;
}

/// A petal ready to explore: LOAD, then LOADED with every node and edge focusable and the truth
/// VERIFIED (the fixture is the exporter's own output). Five steps (layers 0..4), three choices
/// (sum, mean, max), every edge on.
pub fn psv_open() -> PsvState {
    var v : VizState = viz_init(PSV_LAYERS + 1, PSV_AGG_COUNT);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, PSV_NODE_COUNT + PSV_EDGE_COUNT, VIZ_TRUTH_VERIFIED as u32);
    return PsvState { viz: v, mask: PSV_ALL_EDGES };
}

/// Flip edge j. Ignored unless the view is READY and j names an edge. The truth follows the mask:
/// DEMO while any edge is off, VERIFIED once all are on again. Any flip bumps the revision once.
pub fn psv_toggle(p: PsvState, j: u32) -> PsvState {
    if (p.viz.lifecycle != VIZ_LC_READY or j >= PSV_EDGE_COUNT) {
        return p;
    }
    var n : PsvState = p;
    var v : VizState = p.viz;
    let b : u32 = psv_bit(j);
    if ((p.mask & b) != 0) {
        n.mask = p.mask - b;
    } else {
        n.mask = p.mask + b;
    }
    if (n.mask == PSV_ALL_EDGES) {
        v.truth = VIZ_TRUTH_VERIFIED;
    } else {
        v.truth = VIZ_TRUTH_DEMO;
    }
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// The one reducer of the petal. Contract events go to viz_apply; PSV_EV_TOGGLE_EDGE (a = edge)
/// flips a mask bit. A reload that finishes while an edge is off reports DEMO instead of a truth
/// that may claim a result (LIVE or VERIFIED); a CACHED or UNKNOWN truth is kept as it is.
pub fn psv_apply(p: PsvState, ev: u8, a: u32, b: u32) -> PsvState {
    if (ev == PSV_EV_TOGGLE_EDGE) {
        return psv_toggle(p, a);
    }
    var n : PsvState = p;
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING and p.mask != PSV_ALL_EDGES and viz_may_claim(v.truth)) {
        v.truth = VIZ_TRUTH_DEMO;
    }
    n.viz = v;
    return n;
}

; ---------------------------------------------------------------- L2 entities

pub fn psv_node_ref(v: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, v);
}

pub fn psv_edge_ref(j: u32) -> u32 {
    return viz_ref(VIZ_ENT_EDGE, j);
}

pub fn psv_cell_ref(i: u32, j: u32) -> u32 {
    return viz_ref(VIZ_ENT_CELL, i * PSV_STRIDE + j);
}

/// The entity of focus index f: nodes 0..14 first, then edges 0..15. VIZ_REF_NONE past the end.
pub fn psv_focus_ref(p: PsvState, f: u32) -> u32 {
    if (f >= p.viz.focus_count) {
        return VIZ_REF_NONE;
    }
    if (f < PSV_NODE_COUNT) {
        return psv_node_ref(f);
    }
    if (f < PSV_NODE_COUNT + PSV_EDGE_COUNT) {
        return psv_edge_ref(f - PSV_NODE_COUNT);
    }
    return VIZ_REF_NONE;
}

/// ACTIVATE on the focused item: the same as clicking it. Nothing focused is a no-op.
pub fn psv_activate(p: PsvState) -> PsvState {
    let r : u32 = psv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    return psv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// The seed of the spread: the selected node, else PSV_NO_SEED (nothing, an edge or a cell).
pub fn psv_seed(p: PsvState) -> u32 {
    let s : u32 = p.viz.selected;
    if (viz_ref_kind(s) == VIZ_ENT_NODE and viz_ref_index(s) < PSV_NODE_COUNT) {
        return viz_ref_index(s);
    }
    return PSV_NO_SEED;
}

/// The node the inspector describes: the hovered node if there is one, else the seed.
pub fn psv_subject(p: PsvState) -> u32 {
    let h : u32 = p.viz.hover;
    if (viz_ref_kind(h) == VIZ_ENT_NODE and viz_ref_index(h) < PSV_NODE_COUNT) {
        return viz_ref_index(h);
    }
    return psv_seed(p);
}

; ---------------------------------------------------------------- the graph's edges

/// The graph the petal shows. Building it costs a whole SpecGraph, so a caller that asks many
/// questions builds it once and uses the functions that take g.
pub fn psv_graph() -> SpecGraph {
    return tutorial_08_graph();
}

/// Nodes read from g: at most PSV_MAX_NODES.
fn psv_nodes(g: SpecGraph) -> u32 {
    if (g.node_count > PSV_MAX_NODES) {
        return PSV_MAX_NODES;
    }
    return g.node_count;
}

/// The source node of edge j, PSV_NO_NODE when j is not an edge.
pub fn psv_edge_from(g: SpecGraph, j: u32) -> u32 {
    if (j >= g.edge_count or j >= PSV_MAX_EDGES) {
        return PSV_NO_NODE;
    }
    return g.edge_from[j as usize] as u32;
}

/// The target node of edge j, PSV_NO_NODE when j is not an edge.
pub fn psv_edge_to(g: SpecGraph, j: u32) -> u32 {
    if (j >= g.edge_count or j >= PSV_MAX_EDGES) {
        return PSV_NO_NODE;
    }
    return g.edge_to[j as usize] as u32;
}

; ---------------------------------------------------------------- L3 adjacency

/// Row bit sets of the undirected adjacency: bit u of row[v] is set when an enabled edge joins v
/// and u in either direction. The diagonal is set only by a real self edge.
pub struct PsvAdj {
    row: [16]u32,
}

/// The adjacency of g under a mask, built once so a caller does not scan the edges per pair.
pub fn psv_adj_table(g: SpecGraph, mask: u32) -> PsvAdj {
    var t : PsvAdj = PsvAdj { row: [0; 16] };
    let n : u32 = psv_nodes(g);
    var j : u32 = 0;
    while (j < g.edge_count and j < PSV_MAX_EDGES) {
        if ((mask & psv_bit(j)) != 0) {
            let f : u32 = g.edge_from[j as usize] as u32;
            let u : u32 = g.edge_to[j as usize] as u32;
            if (f < n and u < n) {
                t.row[f as usize] = t.row[f as usize] | psv_bit(u);
                t.row[u as usize] = t.row[u as usize] | psv_bit(f);
            }
        }
        j = j + 1;
    }
    return t;
}

/// True when any ENABLED edge joins i and j in either direction. psv_adj(i, i) reports only a real
/// self edge: in message passing a node is always its own neighbour, in the matrix it is not.
pub fn psv_adj(g: SpecGraph, mask: u32, i: u32, j: u32) -> bool {
    return psv_adj_has(psv_adj_table(g, mask), i, j);
}

/// The same answer from a table already built, so a view that asks for many pairs builds it once.
pub fn psv_adj_has(a: PsvAdj, i: u32, j: u32) -> bool {
    if (i >= PSV_MAX_NODES or j >= PSV_MAX_NODES) {
        return false;
    }
    return (a.row[i as usize] & psv_bit(j)) != 0;
}

/// How many distinct nodes are adjacent to v.
pub fn psv_degree(g: SpecGraph, mask: u32, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return 0;
    }
    let a : PsvAdj = psv_adj_table(g, mask);
    var d : u32 = 0;
    var u : u32 = 0;
    while (u < PSV_MAX_NODES) {
        if ((a.row[v as usize] & psv_bit(u)) != 0) {
            d = d + 1;
        }
        u = u + 1;
    }
    return d;
}

; ---------------------------------------------------------------- L4 message passing

/// Layers 0..PSV_LAYERS of 16 slots each, flat: slot (layer, v) is values[layer * 16 + v].
pub struct PsvTrace {
    values: [80]u64,
}

/// The spread of PSV_SEED from node `seed` under a mask and an aggregation. Layer 0: the seed holds
/// PSV_SEED, every other node 0. Layer k+1 of v: the aggregate of v's own layer-k value and the
/// layer-k values of its distinct neighbours: sum, floor mean (sum / count, the node counted once),
/// or max. An aggregation past PSV_AGG_MAX is clamped to it, like the contract's param. No seed
/// (seed is not a node of g) gives an all-zero trace.
pub fn psv_trace(g: SpecGraph, mask: u32, seed: u32, agg: u32) -> PsvTrace {
    var t : PsvTrace = PsvTrace { values: [0; 80] };
    let n : u32 = psv_nodes(g);
    if (seed >= n) {
        return t;
    }
    let a : PsvAdj = psv_adj_table(g, mask);
    let mode : u32 = viz_clamp(agg, PSV_AGG_COUNT);
    t.values[seed as usize] = PSV_SEED;
    var layer : u32 = 0;
    while (layer < PSV_LAYERS) {
        var v : u32 = 0;
        while (v < n) {
            let mine : u64 = t.values[(layer * 16 + v) as usize];
            var sum : u64 = mine;
            var best : u64 = mine;
            var cnt : u64 = 1;
            var u : u32 = 0;
            while (u < n) {
                if (u != v and (a.row[v as usize] & psv_bit(u)) != 0) {
                    let x : u64 = t.values[(layer * 16 + u) as usize];
                    sum = sum + x;
                    cnt = cnt + 1;
                    if (x > best) {
                        best = x;
                    }
                }
                u = u + 1;
            }
            var out : u64 = sum;
            if (mode == PSV_AGG_MEAN) {
                out = sum / cnt;
            }
            if (mode == PSV_AGG_MAX) {
                out = best;
            }
            t.values[((layer + 1) * 16 + v) as usize] = out;
            v = v + 1;
        }
        layer = layer + 1;
    }
    return t;
}

/// The value of node v after `layer` rounds; 0 outside the trace.
pub fn psv_value(t: PsvTrace, layer: u32, v: u32) -> u64 {
    if (layer > PSV_LAYERS or v >= PSV_MAX_NODES) {
        return 0;
    }
    return t.values[(layer * 16 + v) as usize];
}

/// The sum of all node values in one layer; 0 outside the trace.
pub fn psv_layer_sum(t: PsvTrace, layer: u32) -> u64 {
    var s : u64 = 0;
    var v : u32 = 0;
    while (v < PSV_MAX_NODES) {
        s = s + psv_value(t, layer, v);
        v = v + 1;
    }
    return s;
}

/// The trace the petal shows: the selected node as the seed, the chosen aggregation, the mask.
pub fn psv_trace_of(g: SpecGraph, p: PsvState) -> PsvTrace {
    return psv_trace(g, p.mask, psv_seed(p), p.viz.param);
}

; ---------------------------------------------------------------- L5 breadth-first oracle

/// Distances from one seed to every node, flat in 16 slots; PSV_FAR where unreachable.
pub struct PsvDist {
    d: [16]u32,
}

/// Breadth-first distance from `seed` to every node over the enabled edges, either direction.
/// PSV_FAR for an unreachable node, for a slot past the last node, and for every slot when the
/// seed is not a node. It reads the edge list and keeps its own queue: it shares no code with
/// psv_trace, so it can be the oracle that checks it.
pub fn psv_hops_row(g: SpecGraph, mask: u32, seed: u32) -> PsvDist {
    var r : PsvDist = PsvDist { d: [0; 16] };
    var i : u32 = 0;
    while (i < 16) {
        r.d[i as usize] = PSV_FAR;
        i = i + 1;
    }
    let n : u32 = psv_nodes(g);
    if (seed >= n) {
        return r;
    }
    var queue : [16]u32 = [0; 16];
    r.d[seed as usize] = 0;
    queue[0] = seed;
    var head : u32 = 0;
    var tail : u32 = 1;
    while (head < tail) {
        let x : u32 = queue[head as usize];
        head = head + 1;
        var j : u32 = 0;
        while (j < g.edge_count and j < PSV_MAX_EDGES) {
            if ((mask & psv_bit(j)) != 0) {
                let f : u32 = g.edge_from[j as usize] as u32;
                let u : u32 = g.edge_to[j as usize] as u32;
                var y : u32 = PSV_FAR;
                if (f == x) {
                    y = u;
                }
                if (u == x) {
                    y = f;
                }
                if (y < n) {
                    if (r.d[y as usize] == PSV_FAR) {
                        r.d[y as usize] = r.d[x as usize] + 1;
                        queue[tail as usize] = y;
                        tail = tail + 1;
                    }
                }
            }
            j = j + 1;
        }
    }
    return r;
}

/// Breadth-first distance from `seed` to v; PSV_FAR when v is unreachable or either number is not
/// a node of g.
pub fn psv_hops(g: SpecGraph, mask: u32, seed: u32, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return PSV_FAR;
    }
    let r : PsvDist = psv_hops_row(g, mask, seed);
    return r.d[v as usize];
}

; ---------------------------------------------------------------- L6 views: graph

/// Node boxes are spec_graph_view's, shifted to the graph's origin in the frame.
pub fn psv_node_x(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return 0;
    }
    return PSV_GRAPH_X + view_node_x(g, v);
}

pub fn psv_node_y(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return 0;
    }
    return PSV_GRAPH_Y + view_node_y(g, v);
}

pub fn psv_node_w(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return 0;
    }
    return view_node_w(g, v);
}

pub fn psv_node_h(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return 0;
    }
    return view_node_h(g, v);
}

pub fn psv_node_cx(g: SpecGraph, v: u32) -> u32 {
    return psv_node_x(g, v) + psv_node_w(g, v) / 2;
}

pub fn psv_node_cy(g: SpecGraph, v: u32) -> u32 {
    return psv_node_y(g, v) + psv_node_h(g, v) / 2;
}

/// An edge is drawn as a segment between the centres of its two boxes: (x0, y0) is the source's
/// centre and (x1, y1) the target's. All 0 when j is not an edge.
pub fn psv_edge_x0(g: SpecGraph, j: u32) -> u32 {
    return psv_node_cx(g, psv_edge_from(g, j));
}

pub fn psv_edge_y0(g: SpecGraph, j: u32) -> u32 {
    return psv_node_cy(g, psv_edge_from(g, j));
}

pub fn psv_edge_x1(g: SpecGraph, j: u32) -> u32 {
    return psv_node_cx(g, psv_edge_to(g, j));
}

pub fn psv_edge_y1(g: SpecGraph, j: u32) -> u32 {
    return psv_node_cy(g, psv_edge_to(g, j));
}

/// The node box under the point, as a node ref; VIZ_REF_NONE between boxes. Inverse of the box
/// layout: the centre of node v's box hits psv_node_ref(v).
pub fn psv_graph_hit(g: SpecGraph, px: u32, py: u32) -> u32 {
    let n : u32 = psv_nodes(g);
    var v : u32 = 0;
    while (v < n) {
        let x : u32 = PSV_GRAPH_X + view_node_x(g, v);
        let y : u32 = PSV_GRAPH_Y + view_node_y(g, v);
        if (px >= x and py >= y and px < x + view_node_w(g, v) and py < y + view_node_h(g, v)) {
            return psv_node_ref(v);
        }
        v = v + 1;
    }
    return VIZ_REF_NONE;
}

; ---------------------------------------------------------------- L6 views: matrix

/// Cell (i, j): row i, column j, so the cell's x follows the column and its y the row. The row i
/// does not move x, and the column j does not move y; both are in the signature so a caller holds
/// one pair of numbers for both coordinates.
pub fn psv_cell_x(i: u32, j: u32) -> u32 {
    return PSV_MATRIX_X + j * PSV_CELL;
}

pub fn psv_cell_y(i: u32, j: u32) -> u32 {
    return PSV_MATRIX_Y + i * PSV_CELL;
}

/// The cell under the point as a CELL ref; VIZ_REF_NONE outside the 15 x 15 grid. Inverse of
/// psv_cell_x / psv_cell_y: every pixel of cell (i, j) hits psv_cell_ref(i, j).
pub fn psv_matrix_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_MATRIX_X or py < PSV_MATRIX_Y) {
        return VIZ_REF_NONE;
    }
    let j : u32 = (px - PSV_MATRIX_X) / PSV_CELL;
    let i : u32 = (py - PSV_MATRIX_Y) / PSV_CELL;
    if (i >= PSV_MATRIX_N or j >= PSV_MATRIX_N) {
        return VIZ_REF_NONE;
    }
    return psv_cell_ref(i, j);
}

/// The cell's adjacency bit: an enabled edge joins i and j.
pub fn psv_cell_on(g: SpecGraph, mask: u32, i: u32, j: u32) -> bool {
    return psv_adj(g, mask, i, j);
}

; ---------------------------------------------------------------- L6 views: list

/// Line j of the list is edge j, PSV_LINE_H px tall.
pub fn psv_line_y(j: u32) -> u32 {
    return PSV_LIST_Y + j * PSV_LINE_H;
}

/// The line under the point as an EDGE ref; VIZ_REF_NONE outside the list. Inverse of psv_line_y.
pub fn psv_list_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_LIST_X or py < PSV_LIST_Y or px >= PSV_LIST_X + PSV_LIST_W) {
        return VIZ_REF_NONE;
    }
    let j : u32 = (py - PSV_LIST_Y) / PSV_LINE_H;
    if (j >= PSV_EDGE_COUNT) {
        return VIZ_REF_NONE;
    }
    return psv_edge_ref(j);
}

; ---------------------------------------------------------------- highlights (one state, three views)

/// The two ends (a, b) and (x, y) are the same unordered pair.
fn psv_pair(a: u32, b: u32, x: u32, y: u32) -> bool {
    return (a == x and b == y) or (a == y and b == x);
}

/// Entity r has node v as an end: the node itself, an endpoint of an edge, the row or the column
/// of a cell.
pub fn psv_ref_touches(g: SpecGraph, r: u32, v: u32) -> bool {
    if (r == VIZ_REF_NONE) {
        return false;
    }
    let k : u32 = viz_ref_kind(r);
    let x : u32 = viz_ref_index(r);
    if (k == VIZ_ENT_NODE) {
        return x == v;
    }
    if (k == VIZ_ENT_EDGE) {
        return psv_edge_from(g, x) == v or psv_edge_to(g, x) == v;
    }
    if (k == VIZ_ENT_CELL) {
        return (x / PSV_STRIDE) == v or (x % PSV_STRIDE) == v;
    }
    return false;
}

/// How node v is drawn, with g in hand. Its own selection or hover wins (viz_highlight); then HOVER
/// when the hovered edge or cell has v as an end; then RELATED when the selected edge or cell does.
/// A node next to the selected node stays NONE: the spread, not the highlight, shows it.
pub fn psv_node_hl_in(g: SpecGraph, p: PsvState, v: u32) -> u8 {
    if (v >= psv_nodes(g)) {
        return VIZ_HL_NONE;
    }
    let base : u8 = viz_highlight(p.viz, psv_node_ref(v));
    if (base != VIZ_HL_NONE) {
        return base;
    }
    if (psv_ref_touches(g, p.viz.hover, v)) {
        return VIZ_HL_HOVER;
    }
    if (psv_ref_touches(g, p.viz.selected, v)) {
        return PSV_HL_RELATED;
    }
    return VIZ_HL_NONE;
}

/// How edge j (a list line) is drawn: its own selection or hover, else RELATED when the selected
/// node is one of its ends or the selected cell is its pair (either orientation). The rule reads
/// the edge list, not the mask: a switched-off edge is still listed and still related.
pub fn psv_edge_hl_in(g: SpecGraph, p: PsvState, j: u32) -> u8 {
    if (j >= g.edge_count or j >= PSV_MAX_EDGES) {
        return VIZ_HL_NONE;
    }
    let base : u8 = viz_highlight(p.viz, psv_edge_ref(j));
    if (base != VIZ_HL_NONE) {
        return base;
    }
    let s : u32 = p.viz.selected;
    if (s == VIZ_REF_NONE) {
        return VIZ_HL_NONE;
    }
    let k : u32 = viz_ref_kind(s);
    let x : u32 = viz_ref_index(s);
    let f : u32 = psv_edge_from(g, j);
    let t : u32 = psv_edge_to(g, j);
    if (k == VIZ_ENT_NODE and (x == f or x == t)) {
        return PSV_HL_RELATED;
    }
    if (k == VIZ_ENT_CELL and psv_pair(x / PSV_STRIDE, x % PSV_STRIDE, f, t)) {
        return PSV_HL_RELATED;
    }
    return VIZ_HL_NONE;
}

/// How matrix cell (i, j) is drawn: its own selection or hover, else RELATED when it lies in the
/// row or column of the selected node, joins the same pair as the selected edge, or is the
/// transposed cell of the selected cell.
pub fn psv_cell_hl_in(g: SpecGraph, p: PsvState, i: u32, j: u32) -> u8 {
    if (i >= PSV_MATRIX_N or j >= PSV_MATRIX_N) {
        return VIZ_HL_NONE;
    }
    let base : u8 = viz_highlight(p.viz, psv_cell_ref(i, j));
    if (base != VIZ_HL_NONE) {
        return base;
    }
    let s : u32 = p.viz.selected;
    if (s == VIZ_REF_NONE) {
        return VIZ_HL_NONE;
    }
    let k : u32 = viz_ref_kind(s);
    let x : u32 = viz_ref_index(s);
    if (k == VIZ_ENT_NODE and (x == i or x == j)) {
        return PSV_HL_RELATED;
    }
    if (k == VIZ_ENT_EDGE and psv_pair(psv_edge_from(g, x), psv_edge_to(g, x), i, j)) {
        return PSV_HL_RELATED;
    }
    if (k == VIZ_ENT_CELL and psv_pair(x / PSV_STRIDE, x % PSV_STRIDE, i, j)) {
        return PSV_HL_RELATED;
    }
    return VIZ_HL_NONE;
}

/// The same three answers without a graph in hand: each builds the fixture once per call, so a
/// view that asks for many entities calls the _in form with its own g.
pub fn psv_node_hl(p: PsvState, v: u32) -> u8 {
    return psv_node_hl_in(psv_graph(), p, v);
}

pub fn psv_edge_hl(p: PsvState, j: u32) -> u8 {
    return psv_edge_hl_in(psv_graph(), p, j);
}

pub fn psv_cell_hl(p: PsvState, i: u32, j: u32) -> u8 {
    return psv_cell_hl_in(psv_graph(), p, i, j);
}

/// Every highlight of one frame in one call: node[v], edge[j] and cell[i * 16 + j] hold exactly what
/// the three _in functions answer. A host that draws all three views fills it once per frame
/// instead of passing the 60 KB graph by value for each of 15 + 16 + 225 entities.
pub struct PsvHl {
    node: [16]u8,
    edge: [16]u8,
    cell: [256]u8,
}

pub fn psv_hl_tables(g: SpecGraph, p: PsvState) -> PsvHl {
    var t : PsvHl = PsvHl { node: [0; 16], edge: [0; 16], cell: [0; 256] };
    var v : u32 = 0;
    while (v < PSV_MAX_NODES) {
        t.node[v as usize] = psv_node_hl_in(g, p, v);
        v = v + 1;
    }
    var j : u32 = 0;
    while (j < PSV_MAX_EDGES) {
        t.edge[j as usize] = psv_edge_hl_in(g, p, j);
        j = j + 1;
    }
    var i : u32 = 0;
    while (i < PSV_MATRIX_N) {
        var k : u32 = 0;
        while (k < PSV_MATRIX_N) {
            t.cell[(i * PSV_STRIDE + k) as usize] = psv_cell_hl_in(g, p, i, k);
            k = k + 1;
        }
        i = i + 1;
    }
    return t;
}

/// Every box and segment of the graph view in one call: node v's box is (nx, ny, nw, nh), edge j runs
/// from (ex0, ey0) to (ex1, ey1) between the centres of its boxes and joins efrom to eto. All in frame
/// pixels; slots past the last node or edge hold 0. Same reason as PsvHl: a host fills it once per
/// frame instead of passing the graph by value for every number.
pub struct PsvGeom {
    nx: [16]u32,
    ny: [16]u32,
    nw: [16]u32,
    nh: [16]u32,
    efrom: [16]u32,
    eto: [16]u32,
    ex0: [16]u32,
    ey0: [16]u32,
    ex1: [16]u32,
    ey1: [16]u32,
}

pub fn psv_geom(g: SpecGraph) -> PsvGeom {
    var t : PsvGeom = PsvGeom { nx: [0; 16], ny: [0; 16], nw: [0; 16], nh: [0; 16], efrom: [0; 16], eto: [0; 16], ex0: [0; 16], ey0: [0; 16], ex1: [0; 16], ey1: [0; 16] };
    var v : u32 = 0;
    while (v < PSV_MAX_NODES) {
        t.nx[v as usize] = psv_node_x(g, v);
        t.ny[v as usize] = psv_node_y(g, v);
        t.nw[v as usize] = psv_node_w(g, v);
        t.nh[v as usize] = psv_node_h(g, v);
        v = v + 1;
    }
    var j : u32 = 0;
    while (j < PSV_MAX_EDGES) {
        t.efrom[j as usize] = psv_edge_from(g, j);
        t.eto[j as usize] = psv_edge_to(g, j);
        t.ex0[j as usize] = psv_edge_x0(g, j);
        t.ey0[j as usize] = psv_edge_y0(g, j);
        t.ex1[j as usize] = psv_edge_x1(g, j);
        t.ey1[j as usize] = psv_edge_y1(g, j);
        j = j + 1;
    }
    return t;
}

; ---------------------------------------------------------------- L7 inspector

/// First and last line of node v in the real spec (1-based, inclusive); NO_LINE for a non-node.
pub fn psv_inspect_line_start(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return NO_LINE;
    }
    return g.line_start[v as usize];
}

pub fn psv_inspect_line_end(g: SpecGraph, v: u32) -> u32 {
    if (v >= psv_nodes(g)) {
        return NO_LINE;
    }
    return g.line_end[v as usize];
}

/// The value of node v at the petal's current step and aggregation, for the selected seed;
/// 0 when nothing is selected.
pub fn psv_inspect_value(g: SpecGraph, p: PsvState, v: u32) -> u64 {
    let t : PsvTrace = psv_trace_of(g, p);
    return psv_value(t, p.viz.step, v);
}

/// Hops from the selected seed to node v; PSV_FAR when unreachable or nothing is selected.
pub fn psv_inspect_hops(g: SpecGraph, p: PsvState, v: u32) -> u32 {
    return psv_hops(g, p.mask, psv_seed(p), v);
}

; ---------------------------------------------------------------- L8 host

/// The nested layout: one frame, and its eight children in focus order. Every rect is relative to
/// the frame, which sits at the host's origin, so the numbers are frame coordinates.
pub fn psv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, PSV_FRAME_W, PSV_FRAME_H);
    h = vh_add(h, VIZ_REP_BADGE, PSV_SLOT_FRAME, 20, 10, 300, 40);
    h = vh_add(h, VIZ_REP_CHOICE, PSV_SLOT_FRAME, 340, 10, 360, 40);
    h = vh_add(h, VIZ_REP_STEPPER, PSV_SLOT_FRAME, 720, 10, 560, 40);
    h = vh_add(h, VIZ_REP_GRAPH, PSV_SLOT_FRAME, PSV_GRAPH_X, PSV_GRAPH_Y, PSV_GRAPH_W, PSV_GRAPH_H);
    h = vh_add(h, VIZ_REP_MATRIX, PSV_SLOT_FRAME, PSV_MATRIX_X, PSV_MATRIX_Y, PSV_MATRIX_N * PSV_CELL, PSV_MATRIX_N * PSV_CELL);
    h = vh_add(h, VIZ_REP_LIST, PSV_SLOT_FRAME, PSV_LIST_X, PSV_LIST_Y, PSV_LIST_W, PSV_EDGE_COUNT * PSV_LINE_H);
    h = vh_add(h, VIZ_REP_TRACE, PSV_SLOT_FRAME, 900, 580, 460, 360);
    h = vh_add(h, VIZ_REP_INSPECTOR, PSV_SLOT_FRAME, 1400, 580, 480, 360);
    return h;
}

/// The reps a host uses, as a bit set.
pub fn psv_host_reps(h: VizHost) -> u32 {
    var bits : u32 = 0;
    var i : u32 = 0;
    while (i < h.count and i < 16) {
        bits = bits | viz_rep_bit(h.rep[i as usize]);
        i = i + 1;
    }
    return bits;
}

/// The reps of the petal: graph, matrix and list (the linked views), the step-by-step trace, the
/// inspector, the stepper and the aggregation choice, the truth badge, and the text frame.
pub fn psv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_MATRIX) | viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_TRACE) | viz_rep_bit(VIZ_REP_INSPECTOR) | viz_rep_bit(VIZ_REP_STEPPER) | viz_rep_bit(VIZ_REP_CHOICE) | viz_rep_bit(VIZ_REP_BADGE) | viz_rep_bit(VIZ_REP_TEXT);
}

; ---------------------------------------------------------------- L9 host mapping (issue #12199)
; A host draws what the layers above compute and maps its events to the one reducer; nothing in
; this section draws. Pointer positions come in as FRAME coordinates (psv_to_frame turns a page
; position into one), and every answer is a PsvAct, an event for psv_apply, or PSV_EV_NONE.

/// No event: the pointer or key did nothing. Past every contract event and the toggle.
pub const PSV_EV_NONE : u8 = 255;

/// "Nothing under the pointer" for the pickers (choice, stepper slot, trace layer, list gutter).
pub const PSV_NO_PICK : u32 = 65535;

/// The aggregation choice: three equal cells beside the badge. The stepper: a PREV cell, one
/// cell per layer, a NEXT cell. Both rows are PSV_CTRL_H tall.
pub const PSV_CTRL_Y : u32 = 10;
pub const PSV_CTRL_H : u32 = 40;
pub const PSV_CHOICE_X : u32 = 340;
pub const PSV_CHOICE_CELL : u32 = 120;
pub const PSV_STEP_X : u32 = 720;
pub const PSV_STEP_CELL : u32 = 80;
pub const PSV_STEP_SLOTS : u32 = 7;
pub const PSV_STEP_PREV_SLOT : u32 = 0;
pub const PSV_STEP_NEXT_SLOT : u32 = 6;

/// The trace panel: a head line, then one row per layer (a label, then one cell per node).
pub const PSV_TRACE_X : u32 = 900;
pub const PSV_TRACE_Y : u32 = 580;
pub const PSV_TRACE_W : u32 = 460;
pub const PSV_TRACE_HEAD : u32 = 30;
pub const PSV_TRACE_ROW : u32 = 64;
pub const PSV_TRACE_CELL_X : u32 = 960;
pub const PSV_TRACE_CELL : u32 = 26;

/// The checkbox gutter of a list line: a click there flips the edge, a click on the rest of the
/// line selects it.
pub const PSV_GUTTER : u32 = 28;

/// Names of the aggregation choices, in choice order.
pub const PSV_AGG_NAMES : [3]str = ["SUM", "MEAN", "MAX"];

/// Abstract keys. A host maps its own key codes to these; BACK, TOGGLE and ACTIVATE act on the state.
pub const PSV_KEY_NONE : u32 = 0;
pub const PSV_KEY_LEFT : u32 = 1;
pub const PSV_KEY_RIGHT : u32 = 2;
pub const PSV_KEY_UP : u32 = 3;
pub const PSV_KEY_DOWN : u32 = 4;
pub const PSV_KEY_ACTIVATE : u32 = 5;
pub const PSV_KEY_TOGGLE : u32 = 6;
pub const PSV_KEY_BACK : u32 = 7;
pub const PSV_KEY_SUM : u32 = 8;
pub const PSV_KEY_MEAN : u32 = 9;
pub const PSV_KEY_MAX : u32 = 10;

/// The first state word a host keeps, and how many: see psv_store.
pub const PSV_WORDS : u32 = 6;

; --- state words

/// Write the whole petal state into w[base .. base + 6]. Lossless: psv_load reads it back.
pub fn psv_store(w: []u64, base: u32, p: PsvState) -> void {
    let b : usize = base as usize;
    let v : VizState = p.viz;
    w[b] = (v.lifecycle as u64) + (v.error as u64) * 256 + (v.truth as u64) * 65536 + (v.reduced_motion as u64) * 16777216 + (p.mask as u64) * 4294967296;
    w[b + 1] = (v.item_count as u64) + (v.hover as u64) * 4294967296;
    w[b + 2] = (v.selected as u64) + (v.step as u64) * 4294967296;
    w[b + 3] = (v.step_count as u64) + (v.param as u64) * 4294967296;
    w[b + 4] = (v.param_count as u64) + (v.focus as u64) * 4294967296;
    w[b + 5] = (v.focus_count as u64) + (v.revision as u64) * 4294967296;
}

/// The state kept in w[base .. base + 6]. Words that were never written (all zero, so the lifecycle
/// is IDLE) mean "not opened yet": the answer is psv_open().
pub fn psv_load(w: []const u64, base: u32) -> PsvState {
    let b : usize = base as usize;
    if (w[b] == 0) {
        return psv_open();
    }
    var v : VizState = viz_init(PSV_LAYERS + 1, PSV_AGG_COUNT);
    v.lifecycle = (w[b] % 256) as u8;
    v.error = (w[b] / 256 % 256) as u8;
    v.truth = (w[b] / 65536 % 256) as u8;
    v.reduced_motion = (w[b] / 16777216 % 256) as u8;
    v.item_count = (w[b + 1] % 4294967296) as u32;
    v.hover = (w[b + 1] / 4294967296) as u32;
    v.selected = (w[b + 2] % 4294967296) as u32;
    v.step = (w[b + 2] / 4294967296) as u32;
    v.step_count = (w[b + 3] % 4294967296) as u32;
    v.param = (w[b + 3] / 4294967296) as u32;
    v.param_count = (w[b + 4] % 4294967296) as u32;
    v.focus = (w[b + 4] / 4294967296) as u32;
    v.focus_count = (w[b + 5] % 4294967296) as u32;
    v.revision = (w[b + 5] / 4294967296) as u32;
    return PsvState { viz: v, mask: (w[b] / 4294967296) as u32 };
}

; --- state bytes

/// A host whose words are all taken keeps the same six words as PSV_BYTES bytes, little-endian.
pub const PSV_BYTES : usize = 48;

/// Write the whole petal state into b[base .. base + 48]: psv_store, then each word as 8 bytes, low byte first.
pub fn psv_store_bytes(b: []u8, base: usize, p: PsvState) -> void {
    var w : [6]u64 = [0; 6];
    psv_store(w[0..6], 0, p);
    var i : usize = 0;
    while (i < 6) {
        var x : u64 = w[i];
        var k : usize = 0;
        while (k < 8) {
            b[base + i * 8 + k] = (x % 256) as u8;
            x = x / 256;
            k = k + 1;
        }
        i = i + 1;
    }
}

/// The state kept in b[base .. base + 48]. Bytes that were never written (all zero) mean "not opened
/// yet": the answer is psv_open().
pub fn psv_load_bytes(b: []const u8, base: usize) -> PsvState {
    var w : [6]u64 = [0; 6];
    var i : usize = 0;
    while (i < 6) {
        var x : u64 = 0;
        var k : usize = 8;
        while (k > 0) {
            k = k - 1;
            x = x * 256 + (b[base + i * 8 + k] as u64);
        }
        w[i] = x;
        i = i + 1;
    }
    return psv_load(w[0..6], 0);
}

/// How many of the 16 edges are switched off.
pub fn psv_edges_off(mask: u32) -> u32 {
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        if ((mask & psv_bit(j)) == 0) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

; --- fitting the frame into a page

/// The scale of the 1900 x 1000 frame in a page area pw x ph px, in thousandths (1000 is 1:1): the
/// whole frame fits and keeps its aspect. Never 0.
pub fn psv_fit_scale(pw: u32, ph: u32) -> u32 {
    var s : u32 = pw * 1000 / PSV_FRAME_W;
    let t : u32 = ph * 1000 / PSV_FRAME_H;
    if (t < s) {
        s = t;
    }
    if (s < 1) {
        s = 1;
    }
    return s;
}

/// Left and top margin that centre the scaled frame in the page area.
pub fn psv_fit_ox(pw: u32, ph: u32) -> u32 {
    let used : u32 = PSV_FRAME_W * psv_fit_scale(pw, ph) / 1000;
    if (used >= pw) {
        return 0;
    }
    return (pw - used) / 2;
}

pub fn psv_fit_oy(pw: u32, ph: u32) -> u32 {
    let used : u32 = PSV_FRAME_H * psv_fit_scale(pw, ph) / 1000;
    if (used >= ph) {
        return 0;
    }
    return (ph - used) / 2;
}

/// A frame length in page pixels at scale s (thousandths).
pub fn psv_to_px(f: u32, s: u32) -> u32 {
    return f * s / 1000;
}

/// A page position l (pixels from the page's edge) in frame coordinates, for margin o and scale s.
/// A position before the margin is PSV_NO_PICK, which no view claims.
pub fn psv_to_frame(l: u32, o: u32, s: u32) -> u32 {
    if (l < o) {
        return PSV_NO_PICK;
    }
    return (l - o) * 1000 / s;
}

; --- what is under the pointer

/// The aggregation cell under the point (0 sum, 1 mean, 2 max); PSV_NO_PICK elsewhere.
pub fn psv_choice_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_CHOICE_X or py < PSV_CTRL_Y or py >= PSV_CTRL_Y + PSV_CTRL_H) {
        return PSV_NO_PICK;
    }
    let c : u32 = (px - PSV_CHOICE_X) / PSV_CHOICE_CELL;
    if (c >= PSV_AGG_COUNT) {
        return PSV_NO_PICK;
    }
    return c;
}

/// The stepper slot under the point: 0 is PREV, 1..5 are layers 0..4, 6 is NEXT; PSV_NO_PICK elsewhere.
pub fn psv_step_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_STEP_X or py < PSV_CTRL_Y or py >= PSV_CTRL_Y + PSV_CTRL_H) {
        return PSV_NO_PICK;
    }
    let s : u32 = (px - PSV_STEP_X) / PSV_STEP_CELL;
    if (s >= PSV_STEP_SLOTS) {
        return PSV_NO_PICK;
    }
    return s;
}

/// Row k of the trace starts here.
pub fn psv_trace_row_y(k: u32) -> u32 {
    return PSV_TRACE_Y + PSV_TRACE_HEAD + k * PSV_TRACE_ROW;
}

/// The cell of node v in a trace row starts here.
pub fn psv_trace_cell_x(v: u32) -> u32 {
    return PSV_TRACE_CELL_X + v * PSV_TRACE_CELL;
}

/// The layer whose row is under the point (0..4); PSV_NO_PICK outside the rows.
pub fn psv_trace_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_TRACE_X or px >= PSV_TRACE_X + PSV_TRACE_W) {
        return PSV_NO_PICK;
    }
    if (py < PSV_TRACE_Y + PSV_TRACE_HEAD) {
        return PSV_NO_PICK;
    }
    let k : u32 = (py - PSV_TRACE_Y - PSV_TRACE_HEAD) / PSV_TRACE_ROW;
    if (k > PSV_LAYERS) {
        return PSV_NO_PICK;
    }
    return k;
}

/// The edge whose checkbox gutter is under the point; PSV_NO_PICK elsewhere.
pub fn psv_gutter_hit(px: u32, py: u32) -> u32 {
    if (px < PSV_LIST_X or px >= PSV_LIST_X + PSV_GUTTER) {
        return PSV_NO_PICK;
    }
    let r : u32 = psv_list_hit(px, py);
    if (r == VIZ_REF_NONE) {
        return PSV_NO_PICK;
    }
    return viz_ref_index(r);
}

/// The entity under the point in the three linked views (graph, then matrix, then list), as a ref;
/// VIZ_REF_NONE over nothing. The controls and the trace are not entities.
pub fn psv_ref_at(g: SpecGraph, px: u32, py: u32) -> u32 {
    let n : u32 = psv_graph_hit(g, px, py);
    if (n != VIZ_REF_NONE) {
        return n;
    }
    let c : u32 = psv_matrix_hit(px, py);
    if (c != VIZ_REF_NONE) {
        return c;
    }
    return psv_list_hit(px, py);
}

; --- events

/// One event for psv_apply: ev, and its a and b.
pub struct PsvAct {
    ev: u8,
    a: u32,
    b: u32,
}

pub fn psv_act(ev: u8, a: u32, b: u32) -> PsvAct {
    return PsvAct { ev: ev, a: a, b: b };
}

pub fn psv_act_none() -> PsvAct {
    return PsvAct { ev: PSV_EV_NONE, a: 0, b: 0 };
}

/// Apply an action through the one reducer; PSV_EV_NONE leaves the state as it is.
pub fn psv_do(p: PsvState, x: PsvAct) -> PsvState {
    if (x.ev == PSV_EV_NONE) {
        return p;
    }
    return psv_apply(p, x.ev, x.a, x.b);
}

/// The press at frame point (px, py). Controls first (aggregation, stepper, a trace row), then the
/// list gutter (flips an edge), then a view entity (selects it). A press on empty frame clears a
/// selection; outside the frame or with nothing selected it is no event.
pub fn psv_click_at(g: SpecGraph, p: PsvState, px: u32, py: u32) -> PsvAct {
    let c : u32 = psv_choice_hit(px, py);
    if (c != PSV_NO_PICK) {
        return psv_act(VIZ_EV_PARAM_SET, c, 0);
    }
    let s : u32 = psv_step_hit(px, py);
    if (s != PSV_NO_PICK) {
        if (s == PSV_STEP_PREV_SLOT) {
            return psv_act(VIZ_EV_STEP_PREV, 0, 0);
        }
        if (s == PSV_STEP_NEXT_SLOT) {
            return psv_act(VIZ_EV_STEP_NEXT, 0, 0);
        }
        return psv_act(VIZ_EV_STEP_SET, s - 1, 0);
    }
    let k : u32 = psv_trace_hit(px, py);
    if (k != PSV_NO_PICK) {
        return psv_act(VIZ_EV_STEP_SET, k, 0);
    }
    let j : u32 = psv_gutter_hit(px, py);
    if (j != PSV_NO_PICK) {
        return psv_act(PSV_EV_TOGGLE_EDGE, j, 0);
    }
    let r : u32 = psv_ref_at(g, px, py);
    if (r != VIZ_REF_NONE) {
        return psv_act(VIZ_EV_SELECT, r, 0);
    }
    if (p.viz.selected != VIZ_REF_NONE and px < PSV_FRAME_W and py < PSV_FRAME_H) {
        return psv_act(VIZ_EV_CLEAR, 0, 0);
    }
    return psv_act_none();
}

/// The pointer at frame point (px, py): HOVER over an entity, LEAVE off every entity, and no event
/// while the hover already is what the pointer is over (so a still pointer never bumps the revision).
pub fn psv_hover_at(g: SpecGraph, p: PsvState, px: u32, py: u32) -> PsvAct {
    let r : u32 = psv_ref_at(g, px, py);
    if (r == p.viz.hover) {
        return psv_act_none();
    }
    if (r == VIZ_REF_NONE) {
        return psv_act(VIZ_EV_LEAVE, 0, 0);
    }
    return psv_act(VIZ_EV_HOVER, r, 0);
}

/// The edge a TOGGLE key acts on: the selected edge, else the focused edge; PSV_NO_PICK for none.
pub fn psv_toggle_target(p: PsvState) -> u32 {
    if (viz_ref_kind(p.viz.selected) == VIZ_ENT_EDGE) {
        return viz_ref_index(p.viz.selected);
    }
    let f : u32 = psv_focus_ref(p, p.viz.focus);
    if (viz_ref_kind(f) == VIZ_ENT_EDGE) {
        return viz_ref_index(f);
    }
    return PSV_NO_PICK;
}

/// The abstract key k on state p. Keys that have nothing to act on (ACTIVATE with no focus, TOGGLE with
/// no edge, BACK with nothing selected, an unknown key) are PSV_EV_NONE, so the host lets them through.
pub fn psv_key_act(p: PsvState, k: u32) -> PsvAct {
    if (k == PSV_KEY_LEFT) {
        return psv_act(VIZ_EV_STEP_PREV, 0, 0);
    }
    if (k == PSV_KEY_RIGHT) {
        return psv_act(VIZ_EV_STEP_NEXT, 0, 0);
    }
    if (k == PSV_KEY_UP) {
        return psv_act(VIZ_EV_FOCUS_PREV, 0, 0);
    }
    if (k == PSV_KEY_DOWN) {
        return psv_act(VIZ_EV_FOCUS_NEXT, 0, 0);
    }
    if (k == PSV_KEY_ACTIVATE) {
        let r : u32 = psv_focus_ref(p, p.viz.focus);
        if (r == VIZ_REF_NONE) {
            return psv_act_none();
        }
        return psv_act(VIZ_EV_ACTIVATE, r, 0);
    }
    if (k == PSV_KEY_TOGGLE) {
        let j : u32 = psv_toggle_target(p);
        if (j == PSV_NO_PICK) {
            return psv_act_none();
        }
        return psv_act(PSV_EV_TOGGLE_EDGE, j, 0);
    }
    if (k == PSV_KEY_BACK) {
        if (p.viz.selected == VIZ_REF_NONE) {
            return psv_act_none();
        }
        return psv_act(VIZ_EV_BACK, 0, 0);
    }
    if (k == PSV_KEY_SUM) {
        return psv_act(VIZ_EV_PARAM_SET, PSV_AGG_SUM, 0);
    }
    if (k == PSV_KEY_MEAN) {
        return psv_act(VIZ_EV_PARAM_SET, PSV_AGG_MEAN, 0);
    }
    if (k == PSV_KEY_MAX) {
        return psv_act(VIZ_EV_PARAM_SET, PSV_AGG_MAX, 0);
    }
    return psv_act_none();
}

; --- trace shading

/// The largest value in one layer of the trace.
pub fn psv_layer_max(t: PsvTrace, layer: u32) -> u64 {
    var m : u64 = 0;
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        let x : u64 = psv_value(t, layer, v);
        if (x > m) {
            m = x;
        }
        v = v + 1;
    }
    return m;
}

/// How dark the cell of node v in one layer is, 0..255: 0 for a node holding nothing, at least 48 for a
/// node holding something (so a small value never vanishes), 255 for the layer's largest.
pub fn psv_shade(t: PsvTrace, layer: u32, v: u32) -> u32 {
    let x : u64 = psv_value(t, layer, v);
    if (x == 0) {
        return 0;
    }
    let m : u64 = psv_layer_max(t, layer);
    let s : u64 = 48 + x * 207 / m;
    if (s > 255) {
        return 255;
    }
    return s as u32;
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// A petal that has not loaded: idle, truth UNKNOWN, every edge on.
fn psv_idle() -> PsvState {
    return PsvState { viz: viz_init(PSV_LAYERS + 1, PSV_AGG_COUNT), mask: PSV_ALL_EDGES };
}

/// Seven masks the exhaustive tests walk: all on, node 4 isolated, node 2 isolated, 0x5555,
/// 0xAAAA, none on, and both parallel edges of the pair {2,4} off.
fn psv_sample_mask(k: u32) -> u32 {
    if (k == 0) {
        return 65535;
    }
    if (k == 1) {
        return 47001;
    }
    if (k == 2) {
        return 32733;
    }
    if (k == 3) {
        return 21845;
    }
    if (k == 4) {
        return 43690;
    }
    if (k == 5) {
        return 0;
    }
    return 65501;
}

/// The mask with every edge that has node v as an end switched off.
fn psv_off_mask(g: SpecGraph, v: u32) -> u32 {
    var m : u32 = PSV_ALL_EDGES;
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        if (psv_edge_from(g, j) == v or psv_edge_to(g, j) == v) {
            m = m & (PSV_ALL_EDGES - psv_bit(j));
        }
        j = j + 1;
    }
    return m;
}

/// How many nodes hold a non-zero value in one layer.
fn psv_nonzero(t: PsvTrace, layer: u32) -> u32 {
    var n : u32 = 0;
    var v : u32 = 0;
    while (v < PSV_MAX_NODES) {
        if (psv_value(t, layer, v) != 0) {
            n = n + 1;
        }
        v = v + 1;
    }
    return n;
}

/// Adjacency read straight off the enabled edges, apart from psv_adj_table.
fn psv_scan_adj(g: SpecGraph, mask: u32, i: u32, j: u32) -> bool {
    var e : u32 = 0;
    while (e < g.edge_count and e < PSV_MAX_EDGES) {
        if ((mask & psv_bit(e)) != 0) {
            let f : u32 = g.edge_from[e as usize] as u32;
            let t : u32 = g.edge_to[e as usize] as u32;
            if ((f == i and t == j) or (f == j and t == i)) {
                return true;
            }
        }
        e = e + 1;
    }
    return false;
}

/// How many (layer, node) slots disagree with the breadth-first oracle: a node must hold a value
/// at layer k exactly when it is within k hops of the seed.
fn psv_mismatches(g: SpecGraph, mask: u32, seed: u32, agg: u32) -> u32 {
    let t : PsvTrace = psv_trace(g, mask, seed, agg);
    let r : PsvDist = psv_hops_row(g, mask, seed);
    var bad : u32 = 0;
    var layer : u32 = 0;
    while (layer <= PSV_LAYERS) {
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            let live : bool = psv_value(t, layer, v) != 0;
            let near : bool = r.d[v as usize] <= layer;
            if (live) {
                if (near == false) {
                    bad = bad + 1;
                }
            } else {
                if (near) {
                    bad = bad + 1;
                }
            }
            v = v + 1;
        }
        layer = layer + 1;
    }
    return bad;
}

/// Box of node v in the frame is exactly (x, y, w, h).
fn psv_box_is(g: SpecGraph, v: u32, x: u32, y: u32, w: u32, h: u32) -> bool {
    return psv_node_x(g, v) == x and psv_node_y(g, v) == y and psv_node_w(g, v) == w and psv_node_h(g, v) == h;
}

/// Segment of edge j is exactly (x0, y0) -> (x1, y1).
fn psv_seg_is(g: SpecGraph, j: u32, x0: u32, y0: u32, x1: u32, y1: u32) -> bool {
    return psv_edge_x0(g, j) == x0 and psv_edge_y0(g, j) == y0 and psv_edge_x1(g, j) == x1 and psv_edge_y1(g, j) == y1;
}

/// How many of the 15 nodes are drawn with highlight hl.
fn psv_count_nodes(g: SpecGraph, p: PsvState, hl: u8) -> u32 {
    var n : u32 = 0;
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        if (psv_node_hl_in(g, p, v) == hl) {
            n = n + 1;
        }
        v = v + 1;
    }
    return n;
}

/// How many of the 16 edges are drawn with highlight hl.
fn psv_count_edges(g: SpecGraph, p: PsvState, hl: u8) -> u32 {
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        if (psv_edge_hl_in(g, p, j) == hl) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// How many of the 225 matrix cells are drawn with highlight hl.
fn psv_count_cells(g: SpecGraph, p: PsvState, hl: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < PSV_MATRIX_N) {
        var j : u32 = 0;
        while (j < PSV_MATRIX_N) {
            if (psv_cell_hl_in(g, p, i, j) == hl) {
                n = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return n;
}

; ---------------------------------------------------------------- tests: state

test a_fresh_petal_is_ready_verified_and_has_every_edge_on {
    let p : PsvState = psv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert viz_may_claim(p.viz.truth);
    assert p.viz.item_count == 31;
    assert p.viz.focus_count == 31;
    assert p.viz.step_count == 5;
    assert p.viz.param_count == 3;
    assert p.viz.step == 0;
    assert p.viz.param == 0;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.mask == PSV_ALL_EDGES;
    assert p.viz.revision == 2;
}

test the_fixture_has_the_counts_the_petal_assumes {
    let g : SpecGraph = tutorial_08_graph();
    assert g.node_count == PSV_NODE_COUNT;
    assert g.edge_count == PSV_EDGE_COUNT;
    assert PSV_EDGE_COUNT == 16;
    assert psv_bit(15) == 32768;
    assert PSV_ALL_EDGES == psv_bit(16) - 1;
    assert PSV_SEED == 1000000;
    let h : SpecGraph = psv_graph();
    assert h.node_count == 15;
    assert h.edge_count == 16;
}

test toggling_an_edge_flips_the_truth_to_demo_and_back {
    var p : PsvState = psv_open();
    let r0 : u32 = p.viz.revision;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert p.mask == 65527;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert viz_may_claim(p.viz.truth) == false;
    assert p.viz.revision == r0 + 1;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert p.mask == PSV_ALL_EDGES;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.viz.revision == r0 + 2;
}

test the_truth_stays_demo_until_every_edge_is_back_on {
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 0, 0);
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 5, 0);
    assert p.mask == 65502;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 0, 0);
    assert p.mask == 65503;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 5, 0);
    assert p.mask == PSV_ALL_EDGES;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
}

test every_edge_toggles_on_its_own_bit {
    let base : PsvState = psv_open();
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        let off : PsvState = psv_apply(base, PSV_EV_TOGGLE_EDGE, j, 0);
        assert off.mask == PSV_ALL_EDGES - psv_bit(j);
        assert off.viz.truth == VIZ_TRUTH_DEMO;
        assert off.viz.revision == base.viz.revision + 1;
        let on : PsvState = psv_apply(off, PSV_EV_TOGGLE_EDGE, j, 0);
        assert on.mask == PSV_ALL_EDGES;
        assert on.viz.truth == VIZ_TRUTH_VERIFIED;
        assert on.viz.revision == base.viz.revision + 2;
        j = j + 1;
    }
}

test toggle_ignores_an_unknown_edge_and_a_view_that_is_not_ready {
    let p : PsvState = psv_open();
    let a : PsvState = psv_apply(p, PSV_EV_TOGGLE_EDGE, 16, 0);
    assert a.mask == PSV_ALL_EDGES;
    assert a.viz.revision == p.viz.revision;
    assert a.viz.truth == VIZ_TRUTH_VERIFIED;
    let b : PsvState = psv_apply(p, PSV_EV_TOGGLE_EDGE, 65535, 0);
    assert b.mask == PSV_ALL_EDGES;
    assert b.viz.revision == p.viz.revision;
    let idle : PsvState = psv_idle();
    assert idle.viz.lifecycle == VIZ_LC_IDLE;
    let c : PsvState = psv_apply(idle, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert c.mask == PSV_ALL_EDGES;
    assert c.viz.revision == 0;
    assert c.viz.truth == VIZ_TRUTH_UNKNOWN;
    let l : PsvState = psv_apply(idle, VIZ_EV_LOAD, 0, 0);
    assert l.viz.lifecycle == VIZ_LC_LOADING;
    let d : PsvState = psv_apply(l, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert d.mask == PSV_ALL_EDGES;
    assert d.viz.revision == l.viz.revision;
}

test contract_events_pass_through_the_one_reducer {
    var p : PsvState = psv_open();
    let r0 : u32 = p.viz.revision;
    p = psv_apply(p, VIZ_EV_HOVER, psv_node_ref(4), 0);
    assert p.viz.hover == psv_node_ref(4);
    assert p.viz.revision == r0 + 1;
    p = psv_apply(p, VIZ_EV_SELECT, psv_edge_ref(3), 0);
    assert p.viz.selected == psv_edge_ref(3);
    assert p.viz.revision == r0 + 2;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 7, 0);
    assert p.viz.hover == psv_node_ref(4);
    assert p.viz.selected == psv_edge_ref(3);
    assert p.mask == PSV_ALL_EDGES - psv_bit(7);
    assert p.viz.revision == r0 + 3;
    p = psv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.revision == r0 + 4;
    // Selecting the selected ref clears it, as the contract says.
    p = psv_apply(p, VIZ_EV_SELECT, psv_edge_ref(3), 0);
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.revision == r0 + 5;
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    p = psv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    p = psv_apply(p, VIZ_EV_BACK, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    // No contract event touches the mask.
    assert p.mask == PSV_ALL_EDGES - psv_bit(7);
    assert PSV_EV_TOGGLE_EDGE >= VIZ_EV_COUNT;
}

test stepping_and_the_aggregation_choice_are_clamped_by_the_contract {
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_STEP_SET, 9, 0);
    assert p.viz.step == 4;
    let r : u32 = p.viz.revision;
    p = psv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert p.viz.step == 4;
    assert p.viz.revision == r;
    p = psv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 3;
    p = psv_apply(p, VIZ_EV_STEP_SET, 0, 0);
    p = psv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 0;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 7, 0);
    assert p.viz.param == 2;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 1, 0);
    assert p.viz.param == 1;
    assert p.mask == PSV_ALL_EDGES;
}

test a_reload_with_an_edge_off_stays_demo {
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert p.viz.revision == 3;
    p = psv_apply(p, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    p = psv_apply(p, VIZ_EV_LOADED, 31, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert viz_may_claim(p.viz.truth) == false;
    assert p.mask == 65527;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.revision == 5;
    // A what-if is not live either.
    var q : PsvState = psv_open();
    q = psv_apply(q, PSV_EV_TOGGLE_EDGE, 3, 0);
    q = psv_apply(q, VIZ_EV_LOAD, 0, 0);
    q = psv_apply(q, VIZ_EV_LOADED, 31, VIZ_TRUTH_LIVE as u32);
    assert q.viz.truth == VIZ_TRUTH_DEMO;
}

test a_reload_with_every_edge_on_is_verified_again {
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    assert p.mask == PSV_ALL_EDGES;
    p = psv_apply(p, VIZ_EV_LOAD, 0, 0);
    p = psv_apply(p, VIZ_EV_LOADED, 31, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert viz_may_claim(p.viz.truth);
    // With every edge on a LIVE report is not downgraded.
    var q : PsvState = psv_open();
    q = psv_apply(q, VIZ_EV_LOAD, 0, 0);
    q = psv_apply(q, VIZ_EV_LOADED, 31, VIZ_TRUTH_LIVE as u32);
    assert q.viz.truth == VIZ_TRUTH_LIVE;
}

test a_reload_keeps_a_truth_that_cannot_claim_anyway {
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 3, 0);
    p = psv_apply(p, VIZ_EV_LOAD, 0, 0);
    p = psv_apply(p, VIZ_EV_LOADED, 31, VIZ_TRUTH_CACHED as u32);
    assert p.viz.truth == VIZ_TRUTH_CACHED;
    var q : PsvState = psv_open();
    q = psv_apply(q, PSV_EV_TOGGLE_EDGE, 3, 0);
    q = psv_apply(q, VIZ_EV_LOAD, 0, 0);
    q = psv_apply(q, VIZ_EV_LOADED, 31, VIZ_TRUTH_UNKNOWN as u32);
    assert q.viz.truth == VIZ_TRUTH_UNKNOWN;
    // A stray LOADED on a READY view is ignored by the contract and not turned into a DEMO flip.
    var s : PsvState = psv_open();
    s = psv_apply(s, PSV_EV_TOGGLE_EDGE, 3, 0);
    let r : u32 = s.viz.revision;
    s = psv_apply(s, VIZ_EV_LOADED, 31, VIZ_TRUTH_VERIFIED as u32);
    assert s.viz.truth == VIZ_TRUTH_DEMO;
    assert s.viz.revision == r;
}

; ---------------------------------------------------------------- tests: entities

test entity_refs_are_distinct_per_kind_and_pack_the_index {
    assert psv_node_ref(4) == 65540;
    assert psv_edge_ref(4) == 131076;
    assert psv_cell_ref(4, 2) == 196674;
    assert psv_node_ref(4) != psv_edge_ref(4);
    assert psv_node_ref(0) != VIZ_REF_NONE;
    assert viz_ref_kind(psv_node_ref(4)) == VIZ_ENT_NODE;
    assert viz_ref_kind(psv_edge_ref(4)) == VIZ_ENT_EDGE;
    assert viz_ref_kind(psv_cell_ref(4, 2)) == VIZ_ENT_CELL;
    assert viz_ref_index(psv_cell_ref(4, 2)) == 66;
    assert viz_ref_index(psv_cell_ref(14, 14)) == 238;
    assert psv_cell_ref(2, 4) != psv_cell_ref(4, 2);
}

test focus_refs_cover_all_31_items_nodes_first_then_edges {
    let p : PsvState = psv_open();
    var f : u32 = 0;
    while (f < 31) {
        let r : u32 = psv_focus_ref(p, f);
        if (f < 15) {
            assert r == psv_node_ref(f);
        } else {
            assert r == psv_edge_ref(f - 15);
        }
        f = f + 1;
    }
    assert psv_focus_ref(p, 31) == VIZ_REF_NONE;
    assert psv_focus_ref(p, 65535) == VIZ_REF_NONE;
    let idle : PsvState = psv_idle();
    assert psv_focus_ref(idle, 0) == VIZ_REF_NONE;
}

test focus_walks_nodes_then_edges_and_activate_selects_the_focused_item {
    let p0 : PsvState = psv_open();
    assert p0.viz.focus == VIZ_NO_FOCUS;
    let quiet : PsvState = psv_activate(p0);
    assert quiet.viz.selected == VIZ_REF_NONE;
    assert quiet.viz.revision == p0.viz.revision;
    var p : PsvState = psv_apply(p0, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    p = psv_activate(p);
    assert p.viz.selected == psv_node_ref(0);
    assert psv_seed(p) == 0;
    var k : u32 = 0;
    while (k < 15) {
        p = psv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        k = k + 1;
    }
    assert p.viz.focus == 15;
    p = psv_activate(p);
    assert p.viz.selected == psv_edge_ref(0);
    assert psv_seed(p) == PSV_NO_SEED;
    var q : PsvState = psv_apply(p0, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == 30;
    q = psv_activate(q);
    assert q.viz.selected == psv_edge_ref(15);
    q = psv_activate(q);
    assert q.viz.selected == VIZ_REF_NONE;
}

; ---------------------------------------------------------------- tests: adjacency

test adjacency_is_undirected_and_matches_the_hand_read_edges {
    let g : SpecGraph = tutorial_08_graph();
    let m : u32 = PSV_ALL_EDGES;
    assert psv_adj(g, m, 0, 1);
    assert psv_adj(g, m, 1, 0);
    assert psv_adj(g, m, 2, 4);
    assert psv_adj(g, m, 4, 2);
    assert psv_adj(g, m, 3, 4);
    assert psv_adj(g, m, 4, 3);
    assert psv_adj(g, m, 6, 8);
    assert psv_adj(g, m, 8, 6);
    assert psv_adj(g, m, 7, 9);
    assert psv_adj(g, m, 9, 7);
    assert psv_adj(g, m, 8, 10);
    assert psv_adj(g, m, 10, 8);
    assert psv_adj(g, m, 9, 11);
    assert psv_adj(g, m, 11, 9);
    assert psv_adj(g, m, 4, 12);
    assert psv_adj(g, m, 12, 4);
    assert psv_adj(g, m, 2, 13);
    assert psv_adj(g, m, 13, 2);
    // Two hops away, siblings under one node, and nodes with no edge at all are not adjacent.
    assert psv_adj(g, m, 4, 13) == false;
    assert psv_adj(g, m, 2, 3) == false;
    assert psv_adj(g, m, 0, 2) == false;
    assert psv_adj(g, m, 5, 0) == false;
    assert psv_adj(g, m, 14, 4) == false;
    // The fixture has no self edge, so the diagonal is empty.
    assert psv_adj(g, m, 4, 4) == false;
    assert psv_adj(g, m, 0, 0) == false;
    assert psv_adj(g, m, 14, 14) == false;
    // Out of range is false, not a read past the table.
    assert psv_adj(g, m, 15, 0) == false;
    assert psv_adj(g, m, 0, 16) == false;
    // One edge of the pair {2,4} in either direction is enough: e1 is 4->2, e5 is 2->4.
    assert psv_adj(g, 2, 2, 4);
    assert psv_adj(g, 2, 4, 2);
    assert psv_adj(g, 32, 2, 4);
    assert psv_adj(g, 32, 4, 2);
    assert psv_adj(g, 2, 3, 4) == false;
    // A table built once answers every pair as psv_adj does, for every mask bit pattern in the sample.
    let masks : [4]u32 = [PSV_ALL_EDGES, 2, 65467, 0];
    var mi : u32 = 0;
    while (mi < 4) {
        let tab : PsvAdj = psv_adj_table(g, masks[mi as usize]);
        var ai : u32 = 0;
        while (ai < 17) {
            var aj : u32 = 0;
            while (aj < 17) {
                assert psv_adj_has(tab, ai, aj) == psv_adj(g, masks[mi as usize], ai, aj);
                aj = aj + 1;
            }
            ai = ai + 1;
        }
        mi = mi + 1;
    }
    // The cell view reads the same bit.
    assert psv_cell_on(g, m, 4, 2);
    assert psv_cell_on(g, m, 2, 4);
    assert psv_cell_on(g, m, 4, 13) == false;
}

test the_matrix_cells_equal_the_adjacency_table_for_every_pair {
    let g : SpecGraph = tutorial_08_graph();
    let a : PsvAdj = psv_adj_table(g, PSV_ALL_EDGES);
    var i : u32 = 0;
    while (i < PSV_NODE_COUNT) {
        var j : u32 = 0;
        while (j < PSV_NODE_COUNT) {
            let cell_bit : u32 = a.row[i as usize] & psv_bit(j);
            if (psv_cell_on(g, PSV_ALL_EDGES, i, j)) {
                assert cell_bit != 0;
            } else {
                assert cell_bit == 0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

test a_pair_with_two_parallel_edges_needs_both_off_to_disconnect {
    let g : SpecGraph = tutorial_08_graph();
    // {2,4}: e1 (bit 2) and e5 (bit 32).
    assert psv_adj(g, 65533, 2, 4);
    assert psv_adj(g, 65503, 2, 4);
    assert psv_adj(g, 65501, 2, 4) == false;
    assert psv_adj(g, 65501, 4, 2) == false;
    // {6,8}: e3 (bit 8) and e7 (bit 128).
    assert psv_adj(g, 65527, 6, 8);
    assert psv_adj(g, 65407, 6, 8);
    assert psv_adj(g, 65399, 6, 8) == false;
    // {0,1} has one edge only: e0 (bit 1).
    assert psv_adj(g, 65534, 0, 1) == false;
    assert psv_adj(g, 65534, 1, 0) == false;
    // {2,13} has one edge only: e15 (bit 32768); {2,4} stays.
    assert psv_adj(g, 32767, 2, 13) == false;
    assert psv_adj(g, 32767, 2, 4);
}

test the_empty_mask_has_no_neighbours_and_the_full_mask_has_the_hand_read_degrees {
    let g : SpecGraph = tutorial_08_graph();
    var v : u32 = 0;
    var total : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        assert psv_degree(g, 0, v) == 0;
        let d : u32 = psv_degree(g, PSV_ALL_EDGES, v);
        assert d == PSV_HAND_DEGREE[v as usize];
        total = total + d;
        v = v + 1;
    }
    assert total == 18;
    assert psv_adj(g, 0, 4, 2) == false;
    assert psv_degree(g, PSV_ALL_EDGES, 15) == 0;
    assert psv_degree(g, PSV_ALL_EDGES, 65535) == 0;
    // Switching off the edges of node 4 empties its row.
    assert psv_degree(g, 47001, 4) == 0;
    assert psv_degree(g, 47001, 2) == 1;
}

test the_hand_read_edge_counts_match_the_edge_list {
    let g : SpecGraph = tutorial_08_graph();
    var v : u32 = 0;
    var total : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        var n : u32 = 0;
        var j : u32 = 0;
        while (j < PSV_EDGE_COUNT) {
            if (psv_edge_from(g, j) == v or psv_edge_to(g, j) == v) {
                n = n + 1;
            }
            j = j + 1;
        }
        assert n == PSV_HAND_TOUCH[v as usize];
        total = total + n;
        v = v + 1;
    }
    assert total == 32;
    assert psv_edge_from(g, 1) == 4;
    assert psv_edge_to(g, 1) == 2;
    assert psv_edge_from(g, 5) == 2;
    assert psv_edge_to(g, 5) == 4;
    assert psv_edge_from(g, 15) == 13;
    assert psv_edge_to(g, 15) == 2;
    assert psv_edge_from(g, 16) == PSV_NO_NODE;
    assert psv_edge_to(g, 16) == PSV_NO_NODE;
}

; ---------------------------------------------------------------- tests: message passing

test no_seed_gives_an_all_zero_trace {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, PSV_NO_SEED, PSV_AGG_SUM);
    var layer : u32 = 0;
    while (layer <= PSV_LAYERS) {
        assert psv_nonzero(t, layer) == 0;
        assert psv_layer_sum(t, layer) == 0;
        layer = layer + 1;
    }
    // Node 15 does not exist either.
    let u : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 15, PSV_AGG_SUM);
    assert psv_layer_sum(u, 0) == 0;
    assert psv_layer_sum(u, 4) == 0;
    // A petal with nothing selected shows zeros at every step.
    let p : PsvState = psv_open();
    assert psv_inspect_value(g, p, 4) == 0;
    assert psv_value(t, 5, 4) == 0;
    assert psv_value(t, 0, 16) == 0;
}

test layer_zero_holds_the_seed_alone {
    let g : SpecGraph = tutorial_08_graph();
    var seed : u32 = 0;
    while (seed < PSV_NODE_COUNT) {
        let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, PSV_AGG_SUM);
        assert psv_value(t, 0, seed) == 1000000;
        assert psv_nonzero(t, 0) == 1;
        assert psv_layer_sum(t, 0) == 1000000;
        seed = seed + 1;
    }
}

test seed_4_layer_1_by_sum {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_SUM);
    // Node 4 has the neighbours 2, 3 and 12: each takes the seed's value, and so does node 4.
    assert psv_value(t, 1, 4) == 1000000;
    assert psv_value(t, 1, 2) == 1000000;
    assert psv_value(t, 1, 3) == 1000000;
    assert psv_value(t, 1, 12) == 1000000;
    assert psv_nonzero(t, 1) == 4;
    assert psv_layer_sum(t, 1) == 4000000;
}

test seed_4_layer_1_by_mean {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_MEAN);
    // Node 4 averages itself and 3 neighbours: 1000000 / 4. Node 2 averages itself and the
    // neighbours 4 and 13: 1000000 / 3 rounded down. Nodes 3 and 12 average themselves and node 4.
    assert psv_value(t, 1, 4) == 250000;
    assert psv_value(t, 1, 2) == 333333;
    assert psv_value(t, 1, 3) == 500000;
    assert psv_value(t, 1, 12) == 500000;
    assert psv_nonzero(t, 1) == 4;
}

test seed_4_layer_1_by_max {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_MAX);
    assert psv_value(t, 1, 4) == 1000000;
    assert psv_value(t, 1, 2) == 1000000;
    assert psv_value(t, 1, 3) == 1000000;
    assert psv_value(t, 1, 12) == 1000000;
    assert psv_nonzero(t, 1) == 4;
    assert psv_layer_sum(t, 1) == 4000000;
}

test seed_4_layer_2_by_sum {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_SUM);
    // Node 4: itself and the three neighbours, 4 * 1000000. Nodes 2, 3, 12: themselves and
    // node 4, 2 * 1000000. Node 13 is two hops away and takes node 2's layer-1 value.
    assert psv_value(t, 2, 4) == 4000000;
    assert psv_value(t, 2, 2) == 2000000;
    assert psv_value(t, 2, 3) == 2000000;
    assert psv_value(t, 2, 12) == 2000000;
    assert psv_value(t, 2, 13) == 1000000;
    assert psv_nonzero(t, 2) == 5;
}

test seed_4_layer_2_by_mean {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_MEAN);
    // Layer 1 was: node 4 250000, node 2 333333, nodes 3 and 12 500000.
    // Node 4: (250000 + 333333 + 500000 + 500000) / 4 = 1583333 / 4 = 395833.
    // Node 2: (333333 + 250000 + 0) / 3 = 583333 / 3 = 194444.
    // Nodes 3 and 12: (500000 + 250000) / 2 = 375000. Node 13: (0 + 333333) / 2 = 166666.
    assert psv_value(t, 2, 4) == 395833;
    assert psv_value(t, 2, 2) == 194444;
    assert psv_value(t, 2, 3) == 375000;
    assert psv_value(t, 2, 12) == 375000;
    assert psv_value(t, 2, 13) == 166666;
    assert psv_nonzero(t, 2) == 5;
}

test seed_4_layer_2_by_max {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_MAX);
    assert psv_value(t, 2, 4) == 1000000;
    assert psv_value(t, 2, 2) == 1000000;
    assert psv_value(t, 2, 3) == 1000000;
    assert psv_value(t, 2, 12) == 1000000;
    assert psv_value(t, 2, 13) == 1000000;
    assert psv_nonzero(t, 2) == 5;
}

test seed_13_spreads_one_hop_per_layer_by_sum {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 13, PSV_AGG_SUM);
    // Node 13 has one neighbour, node 2; node 2 has 4 and 13; node 4 has 2, 3, 12.
    assert psv_value(t, 1, 13) == 1000000;
    assert psv_value(t, 1, 2) == 1000000;
    assert psv_nonzero(t, 1) == 2;
    assert psv_value(t, 2, 13) == 2000000;
    assert psv_value(t, 2, 2) == 2000000;
    assert psv_value(t, 2, 4) == 1000000;
    assert psv_nonzero(t, 2) == 3;
    assert psv_value(t, 3, 13) == 4000000;
    assert psv_value(t, 3, 2) == 5000000;
    assert psv_value(t, 3, 4) == 3000000;
    assert psv_value(t, 3, 3) == 1000000;
    assert psv_value(t, 3, 12) == 1000000;
    assert psv_nonzero(t, 3) == 5;
    assert psv_value(t, 4, 13) == 9000000;
    assert psv_value(t, 4, 2) == 12000000;
    assert psv_value(t, 4, 4) == 10000000;
    assert psv_value(t, 4, 3) == 4000000;
    assert psv_value(t, 4, 12) == 4000000;
    assert psv_nonzero(t, 4) == 5;
}

test an_isolated_seed_keeps_its_value_and_spreads_nowhere {
    let g : SpecGraph = tutorial_08_graph();
    var s : u32 = 0;
    while (s < 2) {
        var seed : u32 = 5;
        if (s == 1) {
            seed = 14;
        }
        var agg : u32 = 0;
        while (agg < PSV_AGG_COUNT) {
            let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, agg);
            var layer : u32 = 0;
            while (layer <= PSV_LAYERS) {
                assert psv_value(t, layer, seed) == 1000000;
                assert psv_nonzero(t, layer) == 1;
                layer = layer + 1;
            }
            agg = agg + 1;
        }
        s = s + 1;
    }
}

test the_aggregation_choice_is_clamped_in_the_trace {
    let g : SpecGraph = tutorial_08_graph();
    let mx : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_MAX);
    let a : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, 3);
    let b : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, 7);
    let c : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, 65535);
    // Layer 2 of node 4 tells the three aggregations apart: sum 4000000, mean 395833, max 1000000.
    assert psv_value(mx, 2, 4) == 1000000;
    assert psv_value(a, 2, 4) == 1000000;
    assert psv_value(b, 2, 4) == 1000000;
    assert psv_value(c, 2, 4) == 1000000;
    assert psv_value(a, 4, 13) == psv_value(mx, 4, 13);
    assert psv_value(c, 4, 12) == psv_value(mx, 4, 12);
}

test layer_one_total_by_sum_is_the_seed_value_times_one_plus_its_degree {
    let g : SpecGraph = tutorial_08_graph();
    var seed : u32 = 0;
    while (seed < PSV_NODE_COUNT) {
        let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, PSV_AGG_SUM);
        let d : u64 = PSV_HAND_DEGREE[seed as usize] as u64;
        let want : u64 = (1 + d) * 1000000;
        assert psv_layer_sum(t, 1) == want;
        let deg : u64 = psv_degree(g, PSV_ALL_EDGES, seed) as u64;
        assert deg == d;
        seed = seed + 1;
    }
}

test max_never_invents_a_value_and_mean_never_exceeds_the_seed {
    let g : SpecGraph = tutorial_08_graph();
    var seed : u32 = 0;
    while (seed < PSV_NODE_COUNT) {
        let mx : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, PSV_AGG_MAX);
        let mn : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, PSV_AGG_MEAN);
        var layer : u32 = 0;
        while (layer <= PSV_LAYERS) {
            var v : u32 = 0;
            while (v < PSV_NODE_COUNT) {
                let a : u64 = psv_value(mx, layer, v);
                if (a != 0) {
                    assert a == 1000000;
                }
                assert psv_value(mn, layer, v) <= 1000000;
                v = v + 1;
            }
            layer = layer + 1;
        }
        seed = seed + 1;
    }
}

; ---------------------------------------------------------------- tests: breadth-first oracle

test hops_from_seed_4_are_the_hand_read_distances {
    let g : SpecGraph = tutorial_08_graph();
    let m : u32 = PSV_ALL_EDGES;
    assert psv_hops(g, m, 4, 4) == 0;
    assert psv_hops(g, m, 4, 2) == 1;
    assert psv_hops(g, m, 4, 3) == 1;
    assert psv_hops(g, m, 4, 12) == 1;
    assert psv_hops(g, m, 4, 13) == 2;
    assert psv_hops(g, m, 4, 0) == PSV_FAR;
    assert psv_hops(g, m, 4, 1) == PSV_FAR;
    assert psv_hops(g, m, 4, 5) == PSV_FAR;
    assert psv_hops(g, m, 4, 6) == PSV_FAR;
    assert psv_hops(g, m, 4, 8) == PSV_FAR;
    assert psv_hops(g, m, 4, 10) == PSV_FAR;
    assert psv_hops(g, m, 4, 14) == PSV_FAR;
}

test hops_from_seed_13_climb_three_steps {
    let g : SpecGraph = tutorial_08_graph();
    let m : u32 = PSV_ALL_EDGES;
    assert psv_hops(g, m, 13, 13) == 0;
    assert psv_hops(g, m, 13, 2) == 1;
    assert psv_hops(g, m, 13, 4) == 2;
    assert psv_hops(g, m, 13, 3) == 3;
    assert psv_hops(g, m, 13, 12) == 3;
    assert psv_hops(g, m, 13, 0) == PSV_FAR;
    assert psv_hops(g, m, 13, 1) == PSV_FAR;
    assert psv_hops(g, m, 13, 5) == PSV_FAR;
    assert psv_hops(g, m, 13, 6) == PSV_FAR;
    assert psv_hops(g, m, 13, 14) == PSV_FAR;
    // The row form agrees with the single-node form.
    let r : PsvDist = psv_hops_row(g, m, 13);
    assert r.d[13] == 0;
    assert r.d[2] == 1;
    assert r.d[4] == 2;
    assert r.d[12] == 3;
    assert r.d[15] == PSV_FAR;
}

test hops_are_symmetric_and_reach_counts_match_the_components {
    let g : SpecGraph = tutorial_08_graph();
    var all : [225]u32 = [0; 225];
    var s : u32 = 0;
    var reached : u32 = 0;
    while (s < PSV_NODE_COUNT) {
        let r : PsvDist = psv_hops_row(g, PSV_ALL_EDGES, s);
        var n : u32 = 0;
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            all[(s * 15 + v) as usize] = r.d[v as usize];
            if (r.d[v as usize] != PSV_FAR) {
                n = n + 1;
            }
            v = v + 1;
        }
        assert n == PSV_HAND_REACH[s as usize];
        assert r.d[s as usize] == 0;
        reached = reached + n;
        s = s + 1;
    }
    assert reached == 49;
    var i : u32 = 0;
    while (i < PSV_NODE_COUNT) {
        var j : u32 = 0;
        while (j < PSV_NODE_COUNT) {
            assert all[(i * 15 + j) as usize] == all[(j * 15 + i) as usize];
            j = j + 1;
        }
        i = i + 1;
    }
}

test hops_out_of_range_is_far_and_the_empty_mask_reaches_only_the_seed {
    let g : SpecGraph = tutorial_08_graph();
    assert psv_hops(g, PSV_ALL_EDGES, 15, 0) == PSV_FAR;
    assert psv_hops(g, PSV_ALL_EDGES, 0, 15) == PSV_FAR;
    assert psv_hops(g, PSV_ALL_EDGES, 65535, 0) == PSV_FAR;
    assert psv_hops(g, PSV_ALL_EDGES, PSV_NO_SEED, 4) == PSV_FAR;
    assert psv_hops(g, 0, 4, 4) == 0;
    assert psv_hops(g, 0, 4, 2) == PSV_FAR;
    var s : u32 = 0;
    while (s < PSV_NODE_COUNT) {
        let r : PsvDist = psv_hops_row(g, 0, s);
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            if (v == s) {
                assert r.d[v as usize] == 0;
            } else {
                assert r.d[v as usize] == PSV_FAR;
            }
            v = v + 1;
        }
        s = s + 1;
    }
}

; ---------------------------------------------------------------- tests: the spread equals the reach

test the_value_reaches_a_node_exactly_when_it_is_within_that_many_hops {
    let g : SpecGraph = tutorial_08_graph();
    var seed : u32 = 0;
    while (seed < PSV_NODE_COUNT) {
        let row : PsvDist = psv_hops_row(g, PSV_ALL_EDGES, seed);
        var agg : u32 = 0;
        while (agg < PSV_AGG_COUNT) {
            let t : PsvTrace = psv_trace(g, PSV_ALL_EDGES, seed, agg);
            var layer : u32 = 0;
            while (layer <= PSV_LAYERS) {
                var v : u32 = 0;
                while (v < PSV_NODE_COUNT) {
                    let val : u64 = psv_value(t, layer, v);
                    if (row.d[v as usize] <= layer) {
                        assert val != 0;
                    } else {
                        assert val == 0;
                    }
                    v = v + 1;
                }
                layer = layer + 1;
            }
            agg = agg + 1;
        }
        seed = seed + 1;
    }
}

test the_value_reaches_a_node_exactly_when_it_is_within_that_many_hops_under_other_edge_sets {
    let g : SpecGraph = tutorial_08_graph();
    var k : u32 = 0;
    while (k < 7) {
        let m : u32 = psv_sample_mask(k);
        var seed : u32 = 0;
        while (seed < PSV_NODE_COUNT) {
            var agg : u32 = 0;
            while (agg < PSV_AGG_COUNT) {
                assert psv_mismatches(g, m, seed, agg) == 0;
                agg = agg + 1;
            }
            seed = seed + 1;
        }
        k = k + 1;
    }
}

test psv_hops_agrees_with_the_row_it_is_read_from {
    let g : SpecGraph = tutorial_08_graph();
    var k : u32 = 0;
    while (k < 7) {
        let m : u32 = psv_sample_mask(k);
        let r : PsvDist = psv_hops_row(g, m, 4);
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            assert psv_hops(g, m, 4, v) == r.d[v as usize];
            v = v + 1;
        }
        k = k + 1;
    }
}

; ---------------------------------------------------------------- tests: what-if

test the_hand_derived_masks_equal_the_ones_the_helper_computes {
    let g : SpecGraph = tutorial_08_graph();
    // Edges of node 13: e15 (bit 32768). Of node 2: e1, e5, e15 (2 + 32 + 32768). Of node 4:
    // e1, e2, e5, e6, e11, e14 (2 + 4 + 32 + 64 + 2048 + 16384 = 18534). Node 5 has none.
    assert psv_off_mask(g, 13) == 32767;
    assert psv_off_mask(g, 2) == 32733;
    assert psv_off_mask(g, 4) == 47001;
    assert psv_off_mask(g, 5) == 65535;
    assert psv_off_mask(g, 14) == 65535;
    assert psv_off_mask(g, 0) == 65534;
}

test switching_off_every_edge_touching_node_13_makes_it_unreachable {
    let g : SpecGraph = tutorial_08_graph();
    let m : u32 = psv_off_mask(g, 13);
    assert m == 32767;
    assert psv_hops(g, PSV_ALL_EDGES, 4, 13) == 2;
    assert psv_hops(g, m, 4, 13) == PSV_FAR;
    assert psv_hops(g, m, 13, 13) == 0;
    assert psv_hops(g, m, 13, 2) == PSV_FAR;
    // With the edge on, node 13 gets a value at layer 2; with it off, never.
    let on : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, PSV_AGG_SUM);
    let off : PsvTrace = psv_trace(g, m, 4, PSV_AGG_SUM);
    assert psv_value(on, 2, 13) == 1000000;
    var layer : u32 = 0;
    while (layer <= PSV_LAYERS) {
        assert psv_value(off, layer, 13) == 0;
        layer = layer + 1;
    }
    // The rest of the spread is as before up to layer 2: node 13 added nothing to its neighbour.
    assert psv_value(off, 2, 4) == 4000000;
    assert psv_value(off, 2, 2) == 2000000;
    // Seeded at node 13 itself, the node holds its value and nothing leaves.
    let alone : PsvTrace = psv_trace(g, m, 13, PSV_AGG_SUM);
    layer = 0;
    while (layer <= PSV_LAYERS) {
        assert psv_value(alone, layer, 13) == 1000000;
        assert psv_nonzero(alone, layer) == 1;
        layer = layer + 1;
    }
}

test switching_off_every_edge_touching_node_4_isolates_it {
    let g : SpecGraph = tutorial_08_graph();
    let m : u32 = psv_off_mask(g, 4);
    assert m == 47001;
    assert psv_degree(g, m, 4) == 0;
    assert psv_hops(g, m, 4, 2) == PSV_FAR;
    assert psv_hops(g, m, 2, 4) == PSV_FAR;
    assert psv_hops(g, m, 2, 13) == 1;
    assert psv_hops(g, m, 2, 3) == PSV_FAR;
    assert psv_hops(g, m, 3, 12) == PSV_FAR;
    let t : PsvTrace = psv_trace(g, m, 4, PSV_AGG_SUM);
    var layer : u32 = 0;
    while (layer <= PSV_LAYERS) {
        assert psv_value(t, layer, 4) == 1000000;
        assert psv_nonzero(t, layer) == 1;
        layer = layer + 1;
    }
    // Seeded at node 2 the spread reaches node 13 and stops there.
    let u : PsvTrace = psv_trace(g, m, 2, PSV_AGG_MAX);
    assert psv_value(u, 4, 13) == 1000000;
    assert psv_value(u, 4, 4) == 0;
    assert psv_value(u, 4, 3) == 0;
    assert psv_nonzero(u, 4) == 2;
}

test one_of_two_parallel_edges_off_changes_nothing_but_the_truth {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 1, 0);
    assert p.mask == 65533;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    var agg : u32 = 0;
    while (agg < PSV_AGG_COUNT) {
        let full : PsvTrace = psv_trace(g, PSV_ALL_EDGES, 4, agg);
        let half : PsvTrace = psv_trace(g, p.mask, 4, agg);
        var layer : u32 = 0;
        while (layer <= PSV_LAYERS) {
            var v : u32 = 0;
            while (v < PSV_NODE_COUNT) {
                assert psv_value(full, layer, v) == psv_value(half, layer, v);
                v = v + 1;
            }
            layer = layer + 1;
        }
        agg = agg + 1;
    }
}

test the_trace_follows_the_petal_state {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    p = psv_apply(p, VIZ_EV_STEP_SET, 2, 0);
    assert psv_inspect_value(g, p, 4) == 4000000;
    assert psv_inspect_value(g, p, 13) == 1000000;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 1, 0);
    assert psv_inspect_value(g, p, 4) == 395833;
    assert psv_inspect_value(g, p, 2) == 194444;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert psv_inspect_value(g, p, 4) == 1000000;
    p = psv_apply(p, VIZ_EV_STEP_SET, 1, 0);
    p = psv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert psv_inspect_value(g, p, 3) == 1000000;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 1, 0);
    assert psv_inspect_value(g, p, 4) == 250000;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    // Switch off both edges between nodes 3 and 4 (e2 is 4->3, e6 is 3->4): 65535 - 4 - 64.
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 2, 0);
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 6, 0);
    assert p.mask == 65467;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert psv_inspect_value(g, p, 3) == 0;
    assert psv_inspect_value(g, p, 2) == 1000000;
    assert psv_inspect_hops(g, p, 3) == PSV_FAR;
    assert psv_inspect_hops(g, p, 12) == 1;
    // Deselecting the seed empties the trace.
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    assert psv_seed(p) == PSV_NO_SEED;
    assert psv_inspect_value(g, p, 4) == 0;
    assert psv_inspect_hops(g, p, 4) == PSV_FAR;
}

test a_selected_node_is_the_seed_and_other_selections_are_not {
    var p : PsvState = psv_open();
    assert psv_seed(p) == PSV_NO_SEED;
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    assert psv_seed(p) == 4;
    p = psv_apply(p, VIZ_EV_SELECT, psv_edge_ref(3), 0);
    assert psv_seed(p) == PSV_NO_SEED;
    p = psv_apply(p, VIZ_EV_SELECT, psv_cell_ref(4, 2), 0);
    assert psv_seed(p) == PSV_NO_SEED;
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(14), 0);
    assert psv_seed(p) == 14;
    p = psv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert psv_seed(p) == PSV_NO_SEED;
    // A node ref past the last node is no seed.
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(15), 0);
    assert psv_seed(p) == PSV_NO_SEED;
}

; ---------------------------------------------------------------- tests: views

test the_graph_boxes_are_the_real_spec_graph_view_boxes_in_the_frame {
    let g : SpecGraph = tutorial_08_graph();
    assert psv_box_is(g, 0, 60, 100, 220, 44);
    assert psv_box_is(g, 1, 320, 100, 220, 44);
    assert psv_box_is(g, 2, 580, 100, 220, 44);
    assert psv_box_is(g, 3, 580, 164, 220, 44);
    assert psv_box_is(g, 4, 840, 100, 220, 44);
    assert psv_box_is(g, 5, 580, 228, 220, 44);
    assert psv_box_is(g, 6, 580, 292, 220, 44);
    assert psv_box_is(g, 7, 580, 356, 220, 44);
    assert psv_box_is(g, 8, 840, 164, 220, 44);
    assert psv_box_is(g, 9, 840, 228, 220, 44);
    assert psv_box_is(g, 10, 1100, 100, 220, 44);
    assert psv_box_is(g, 11, 1100, 164, 220, 44);
    assert psv_box_is(g, 12, 1100, 228, 220, 44);
    assert psv_box_is(g, 13, 1360, 100, 220, 44);
    // The UNKNOWN node sits in the band below the known rows, narrower and lower.
    assert psv_box_is(g, 14, 1630, 468, 200, 36);
    // Each box is spec_graph_view's own, moved by the graph origin.
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        assert psv_node_x(g, v) == PSV_GRAPH_X + view_node_x(g, v);
        assert psv_node_y(g, v) == PSV_GRAPH_Y + view_node_y(g, v);
        assert psv_node_w(g, v) == view_node_w(g, v);
        assert psv_node_h(g, v) == view_node_h(g, v);
        v = v + 1;
    }
    // Not a node: no box.
    assert psv_node_x(g, 15) == 0;
    assert psv_node_w(g, 15) == 0;
    assert psv_node_h(g, 65535) == 0;
    // The canvas the layout fills is the graph slot.
    assert view_width(g) == PSV_GRAPH_W;
    assert view_height(g) == PSV_GRAPH_H;
}

test every_node_box_hits_back_at_itself {
    let g : SpecGraph = tutorial_08_graph();
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        let x : u32 = psv_node_x(g, v);
        let y : u32 = psv_node_y(g, v);
        let w : u32 = psv_node_w(g, v);
        let h : u32 = psv_node_h(g, v);
        assert psv_graph_hit(g, psv_node_cx(g, v), psv_node_cy(g, v)) == psv_node_ref(v);
        assert psv_graph_hit(g, x, y) == psv_node_ref(v);
        assert psv_graph_hit(g, x + w - 1, y + h - 1) == psv_node_ref(v);
        // One pixel outside: right of the box, below it, left of it, above it.
        assert psv_graph_hit(g, x + w, y) == VIZ_REF_NONE;
        assert psv_graph_hit(g, x, y + h) == VIZ_REF_NONE;
        assert psv_graph_hit(g, x - 1, y) == VIZ_REF_NONE;
        assert psv_graph_hit(g, x, y - 1) == VIZ_REF_NONE;
        v = v + 1;
    }
}

test a_point_between_boxes_or_outside_the_graph_hits_nothing {
    let g : SpecGraph = tutorial_08_graph();
    assert psv_graph_hit(g, 5, 5) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 0, 0) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 290, 110) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 170, 150) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 1900, 100) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 400, 700) == VIZ_REF_NONE;
}

test edge_segments_run_between_box_centres {
    let g : SpecGraph = tutorial_08_graph();
    // Box centres: node 0 (170,122), 1 (430,122), 2 (690,122), 4 (950,122), 6 (690,314),
    // 8 (950,186), 12 (1210,250), 13 (1470,122).
    assert psv_seg_is(g, 0, 170, 122, 430, 122);
    assert psv_seg_is(g, 1, 950, 122, 690, 122);
    assert psv_seg_is(g, 5, 690, 122, 950, 122);
    assert psv_seg_is(g, 3, 950, 186, 690, 314);
    assert psv_seg_is(g, 11, 1210, 250, 950, 122);
    assert psv_seg_is(g, 15, 1470, 122, 690, 122);
    // Not an edge: every coordinate is 0.
    assert psv_seg_is(g, 16, 0, 0, 0, 0);
    assert psv_seg_is(g, 65535, 0, 0, 0, 0);
    // The ends of every edge are the centres of the boxes the edge joins.
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        let f : u32 = psv_edge_from(g, j);
        let t : u32 = psv_edge_to(g, j);
        assert psv_edge_x0(g, j) == psv_node_cx(g, f);
        assert psv_edge_y0(g, j) == psv_node_cy(g, f);
        assert psv_edge_x1(g, j) == psv_node_cx(g, t);
        assert psv_edge_y1(g, j) == psv_node_cy(g, t);
        j = j + 1;
    }
}

test matrix_cells_tile_the_grid_and_hit_back_at_themselves {
    assert psv_cell_x(14, 14) == 356;
    assert psv_cell_y(14, 14) == 916;
    // Row 2, column 5: x follows the column, y the row.
    assert psv_cell_x(2, 5) == 140;
    assert psv_cell_y(2, 5) == 628;
    assert psv_cell_x(5, 2) == 68;
    assert psv_cell_y(5, 2) == 700;
    var i : u32 = 0;
    while (i < PSV_MATRIX_N) {
        var j : u32 = 0;
        while (j < PSV_MATRIX_N) {
            let x : u32 = psv_cell_x(i, j);
            let y : u32 = psv_cell_y(i, j);
            assert psv_matrix_hit(x, y) == psv_cell_ref(i, j);
            assert psv_matrix_hit(x + 12, y + 12) == psv_cell_ref(i, j);
            assert psv_matrix_hit(x + 23, y + 23) == psv_cell_ref(i, j);
            // The next pixel across is the next column, or outside the grid after the last one.
            if (j + 1 < PSV_MATRIX_N) {
                assert psv_matrix_hit(x + 24, y) == psv_cell_ref(i, j + 1);
            } else {
                assert psv_matrix_hit(x + 24, y) == VIZ_REF_NONE;
            }
            if (i + 1 < PSV_MATRIX_N) {
                assert psv_matrix_hit(x, y + 24) == psv_cell_ref(i + 1, j);
            } else {
                assert psv_matrix_hit(x, y + 24) == VIZ_REF_NONE;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert psv_matrix_hit(19, 590) == VIZ_REF_NONE;
    assert psv_matrix_hit(30, 579) == VIZ_REF_NONE;
    assert psv_matrix_hit(380, 600) == VIZ_REF_NONE;
    assert psv_matrix_hit(30, 940) == VIZ_REF_NONE;
    assert psv_matrix_hit(0, 0) == VIZ_REF_NONE;
}

test list_lines_stack_and_hit_back_at_themselves {
    assert psv_line_y(0) == 580;
    assert psv_line_y(15) == 910;
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        let y : u32 = psv_line_y(j);
        assert y == 580 + 22 * j;
        assert psv_list_hit(420, y) == psv_edge_ref(j);
        assert psv_list_hit(500, y + 10) == psv_edge_ref(j);
        assert psv_list_hit(859, y + 21) == psv_edge_ref(j);
        if (j + 1 < PSV_EDGE_COUNT) {
            assert psv_line_y(j + 1) - y == 22;
            assert psv_list_hit(500, y + 22) == psv_edge_ref(j + 1);
        } else {
            assert psv_list_hit(500, y + 22) == VIZ_REF_NONE;
        }
        j = j + 1;
    }
    assert psv_list_hit(420, 932) == VIZ_REF_NONE;
    assert psv_list_hit(419, 600) == VIZ_REF_NONE;
    assert psv_list_hit(860, 600) == VIZ_REF_NONE;
    assert psv_list_hit(500, 579) == VIZ_REF_NONE;
    assert psv_list_hit(0, 0) == VIZ_REF_NONE;
}

test a_point_in_no_view_hits_nothing {
    let g : SpecGraph = tutorial_08_graph();
    // Between the matrix (right edge 380) and the list (left edge 420), and right of the list.
    assert psv_graph_hit(g, 400, 700) == VIZ_REF_NONE;
    assert psv_matrix_hit(400, 700) == VIZ_REF_NONE;
    assert psv_list_hit(400, 700) == VIZ_REF_NONE;
    assert psv_graph_hit(g, 870, 700) == VIZ_REF_NONE;
    assert psv_matrix_hit(870, 700) == VIZ_REF_NONE;
    assert psv_list_hit(870, 700) == VIZ_REF_NONE;
    // The host agrees: only the frame lies under those points.
    let h : VizHost = psv_host();
    assert vh_hit(h, 400, 700) == PSV_SLOT_FRAME;
    assert vh_hit(h, 870, 700) == PSV_SLOT_FRAME;
}

; ---------------------------------------------------------------- tests: highlights

test selecting_a_node_marks_it_and_its_edges_and_cells_in_all_three_views {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    // Graph: the node is SELECT; its neighbours are not marked (the spread shows them).
    assert psv_node_hl_in(g, p, 4) == VIZ_HL_SELECT;
    assert psv_node_hl_in(g, p, 2) == VIZ_HL_NONE;
    assert psv_node_hl_in(g, p, 13) == VIZ_HL_NONE;
    assert psv_count_nodes(g, p, VIZ_HL_SELECT) == 1;
    assert psv_count_nodes(g, p, PSV_HL_RELATED) == 0;
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 0;
    // List: the six edges that touch node 4 (e1 e2 e5 e6 e11 e14) are RELATED, the rest are not.
    assert psv_edge_hl_in(g, p, 1) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 2) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 5) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 6) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 11) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 14) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 0) == VIZ_HL_NONE;
    assert psv_edge_hl_in(g, p, 3) == VIZ_HL_NONE;
    assert psv_edge_hl_in(g, p, 15) == VIZ_HL_NONE;
    assert psv_count_edges(g, p, PSV_HL_RELATED) == 6;
    assert psv_count_edges(g, p, VIZ_HL_NONE) == 10;
    // Matrix: row 4 and column 4, 15 + 15 - 1 = 29 cells.
    assert psv_cell_hl_in(g, p, 4, 2) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 2, 4) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 4, 4) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 0, 4) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 4, 0) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 0, 1) == VIZ_HL_NONE;
    assert psv_cell_hl_in(g, p, 2, 3) == VIZ_HL_NONE;
    assert psv_cell_hl_in(g, p, 5, 5) == VIZ_HL_NONE;
    assert psv_cell_hl_in(g, p, 14, 14) == VIZ_HL_NONE;
    assert psv_count_cells(g, p, PSV_HL_RELATED) == 29;
    assert psv_count_cells(g, p, VIZ_HL_SELECT) == 0;
}

test the_highlight_tables_equal_the_three_single_answers_in_every_state {
    let g : SpecGraph = tutorial_08_graph();
    var states : [6]PsvState = [psv_open(), psv_open(), psv_open(), psv_open(), psv_open(), psv_open()];
    states[1] = psv_apply(psv_open(), VIZ_EV_SELECT, psv_node_ref(4), 0);
    states[2] = psv_apply(psv_open(), VIZ_EV_SELECT, psv_edge_ref(3), 0);
    states[3] = psv_apply(psv_open(), VIZ_EV_SELECT, psv_cell_ref(4, 2), 0);
    states[4] = psv_apply(states[1], VIZ_EV_HOVER, psv_edge_ref(5), 0);
    states[5] = psv_toggle(psv_apply(psv_open(), VIZ_EV_HOVER, psv_node_ref(9), 0), 6);
    var s : u32 = 0;
    while (s < 6) {
        let p : PsvState = states[s as usize];
        let t : PsvHl = psv_hl_tables(g, p);
        var v : u32 = 0;
        while (v < PSV_MAX_NODES) {
            assert t.node[v as usize] == psv_node_hl_in(g, p, v);
            v = v + 1;
        }
        var j : u32 = 0;
        while (j < PSV_MAX_EDGES) {
            assert t.edge[j as usize] == psv_edge_hl_in(g, p, j);
            j = j + 1;
        }
        var i : u32 = 0;
        while (i < PSV_MATRIX_N) {
            var k : u32 = 0;
            while (k < PSV_MATRIX_N) {
                assert t.cell[(i * PSV_STRIDE + k) as usize] == psv_cell_hl_in(g, p, i, k);
                k = k + 1;
            }
            i = i + 1;
        }
        s = s + 1;
    }
    // Spot checks so the loop above cannot pass on all-zero tables.
    let a : PsvHl = psv_hl_tables(g, states[1]);
    assert a.node[4] == VIZ_HL_SELECT;
    assert a.edge[1] == PSV_HL_RELATED;
    assert a.cell[4 * 16 + 2] == PSV_HL_RELATED;
    assert a.cell[0 * 16 + 1] == VIZ_HL_NONE;
    let b : PsvHl = psv_hl_tables(g, states[4]);
    assert b.edge[5] == VIZ_HL_HOVER;
}

test the_geometry_table_equals_the_single_answers_and_every_box_is_inside_the_graph {
    let g : SpecGraph = tutorial_08_graph();
    let t : PsvGeom = psv_geom(g);
    var v : u32 = 0;
    while (v < PSV_MAX_NODES) {
        assert t.nx[v as usize] == psv_node_x(g, v);
        assert t.ny[v as usize] == psv_node_y(g, v);
        assert t.nw[v as usize] == psv_node_w(g, v);
        assert t.nh[v as usize] == psv_node_h(g, v);
        v = v + 1;
    }
    var j : u32 = 0;
    while (j < PSV_MAX_EDGES) {
        assert t.efrom[j as usize] == psv_edge_from(g, j);
        assert t.eto[j as usize] == psv_edge_to(g, j);
        assert t.ex0[j as usize] == psv_edge_x0(g, j);
        assert t.ey0[j as usize] == psv_edge_y0(g, j);
        assert t.ex1[j as usize] == psv_edge_x1(g, j);
        assert t.ey1[j as usize] == psv_edge_y1(g, j);
        j = j + 1;
    }
    // Not all zero: each of the 15 nodes has a box with a size, and an edge segment starts in its source's box.
    var n : u32 = 0;
    while (n < PSV_NODE_COUNT) {
        assert t.nw[n as usize] > 0;
        assert t.nh[n as usize] > 0;
        n = n + 1;
    }
    var e : u32 = 0;
    while (e < PSV_EDGE_COUNT) {
        let f : usize = t.efrom[e as usize] as usize;
        assert t.ex0[e as usize] == t.nx[f] + t.nw[f] / 2;
        assert t.ey0[e as usize] == t.ny[f] + t.nh[f] / 2;
        e = e + 1;
    }
}

test selecting_any_node_relates_every_edge_that_touches_it {
    let g : SpecGraph = tutorial_08_graph();
    let base : PsvState = psv_open();
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        let p : PsvState = psv_apply(base, VIZ_EV_SELECT, psv_node_ref(v), 0);
        assert psv_node_hl_in(g, p, v) == VIZ_HL_SELECT;
        var j : u32 = 0;
        while (j < PSV_EDGE_COUNT) {
            let f : u32 = psv_edge_from(g, j);
            let t : u32 = psv_edge_to(g, j);
            if (f == v or t == v) {
                assert psv_edge_hl_in(g, p, j) == PSV_HL_RELATED;
                assert psv_cell_hl_in(g, p, f, t) == PSV_HL_RELATED;
                assert psv_cell_hl_in(g, p, t, f) == PSV_HL_RELATED;
            } else {
                assert psv_edge_hl_in(g, p, j) == VIZ_HL_NONE;
            }
            j = j + 1;
        }
        assert psv_count_edges(g, p, PSV_HL_RELATED) == PSV_HAND_TOUCH[v as usize];
        v = v + 1;
    }
}

test selecting_an_edge_marks_its_ends_and_its_cells {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    // Edge 1 is 4->2.
    p = psv_apply(p, VIZ_EV_SELECT, psv_edge_ref(1), 0);
    assert psv_edge_hl_in(g, p, 1) == VIZ_HL_SELECT;
    assert psv_edge_hl_in(g, p, 0) == VIZ_HL_NONE;
    assert psv_node_hl_in(g, p, 4) == PSV_HL_RELATED;
    assert psv_node_hl_in(g, p, 2) == PSV_HL_RELATED;
    assert psv_node_hl_in(g, p, 3) == VIZ_HL_NONE;
    assert psv_node_hl_in(g, p, 13) == VIZ_HL_NONE;
    assert psv_count_nodes(g, p, PSV_HL_RELATED) == 2;
    assert psv_count_nodes(g, p, VIZ_HL_SELECT) == 0;
    assert psv_cell_hl_in(g, p, 4, 2) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 2, 4) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 4, 3) == VIZ_HL_NONE;
    assert psv_cell_hl_in(g, p, 2, 2) == VIZ_HL_NONE;
    assert psv_count_cells(g, p, PSV_HL_RELATED) == 2;
}

test selecting_a_cell_marks_its_transpose_its_ends_and_its_edges {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_cell_ref(4, 2), 0);
    assert psv_cell_hl_in(g, p, 4, 2) == VIZ_HL_SELECT;
    assert psv_cell_hl_in(g, p, 2, 4) == PSV_HL_RELATED;
    assert psv_cell_hl_in(g, p, 4, 3) == VIZ_HL_NONE;
    assert psv_count_cells(g, p, PSV_HL_RELATED) == 1;
    assert psv_node_hl_in(g, p, 4) == PSV_HL_RELATED;
    assert psv_node_hl_in(g, p, 2) == PSV_HL_RELATED;
    assert psv_count_nodes(g, p, PSV_HL_RELATED) == 2;
    // The pair {4,2} is joined by e1 (4->2) and e5 (2->4); e15 (13->2) only touches node 2.
    assert psv_edge_hl_in(g, p, 1) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 5) == PSV_HL_RELATED;
    assert psv_edge_hl_in(g, p, 15) == VIZ_HL_NONE;
    assert psv_edge_hl_in(g, p, 0) == VIZ_HL_NONE;
    assert psv_count_edges(g, p, PSV_HL_RELATED) == 2;
}

test hovering_a_cell_lights_its_row_and_column_nodes_as_hover {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_HOVER, psv_cell_ref(4, 2), 0);
    assert psv_cell_hl_in(g, p, 4, 2) == VIZ_HL_HOVER;
    assert psv_cell_hl_in(g, p, 2, 4) == VIZ_HL_NONE;
    assert psv_node_hl_in(g, p, 4) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, p, 2) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, p, 3) == VIZ_HL_NONE;
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 2;
    assert psv_count_edges(g, p, VIZ_HL_NONE) == 16;
    // A diagonal cell has one end.
    p = psv_apply(p, VIZ_EV_HOVER, psv_cell_ref(5, 5), 0);
    assert psv_node_hl_in(g, p, 5) == VIZ_HL_HOVER;
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 1;
    // Leaving clears the lot.
    p = psv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 0;
    assert psv_cell_hl_in(g, p, 5, 5) == VIZ_HL_NONE;
}

test hovering_a_node_or_an_edge_lights_it_in_every_view {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_HOVER, psv_node_ref(8), 0);
    assert psv_node_hl_in(g, p, 8) == VIZ_HL_HOVER;
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 1;
    assert psv_count_edges(g, p, VIZ_HL_NONE) == 16;
    assert psv_count_cells(g, p, VIZ_HL_NONE) == 225;
    // Edge 3 is 8->6: the edge and both of its nodes.
    p = psv_apply(p, VIZ_EV_HOVER, psv_edge_ref(3), 0);
    assert psv_edge_hl_in(g, p, 3) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, p, 8) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, p, 6) == VIZ_HL_HOVER;
    assert psv_count_nodes(g, p, VIZ_HL_HOVER) == 2;
    assert psv_count_edges(g, p, VIZ_HL_HOVER) == 1;
}

test selection_wins_over_hover_and_a_hovered_end_beats_a_related_one {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    p = psv_apply(p, VIZ_EV_HOVER, psv_node_ref(4), 0);
    assert psv_node_hl_in(g, p, 4) == VIZ_HL_SELECT;
    p = psv_apply(p, VIZ_EV_HOVER, psv_node_ref(8), 0);
    assert psv_node_hl_in(g, p, 4) == VIZ_HL_SELECT;
    assert psv_node_hl_in(g, p, 8) == VIZ_HL_HOVER;
    // Edge 1 selected: its ends are RELATED; hovering the cell (4,2) shows them as HOVER.
    var q : PsvState = psv_open();
    q = psv_apply(q, VIZ_EV_SELECT, psv_edge_ref(1), 0);
    assert psv_node_hl_in(g, q, 4) == PSV_HL_RELATED;
    q = psv_apply(q, VIZ_EV_HOVER, psv_cell_ref(4, 2), 0);
    assert psv_node_hl_in(g, q, 4) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, q, 2) == VIZ_HL_HOVER;
    assert psv_edge_hl_in(g, q, 1) == VIZ_HL_SELECT;
}

test the_no_g_wrappers_agree_with_the_in_variants {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    assert psv_node_hl(p, 4) == VIZ_HL_SELECT;
    assert psv_node_hl(p, 4) == psv_node_hl_in(g, p, 4);
    assert psv_node_hl(p, 2) == VIZ_HL_NONE;
    assert psv_edge_hl(p, 1) == PSV_HL_RELATED;
    assert psv_edge_hl(p, 1) == psv_edge_hl_in(g, p, 1);
    assert psv_edge_hl(p, 0) == VIZ_HL_NONE;
    assert psv_cell_hl(p, 4, 2) == PSV_HL_RELATED;
    assert psv_cell_hl(p, 4, 2) == psv_cell_hl_in(g, p, 4, 2);
    assert psv_cell_hl(p, 0, 1) == VIZ_HL_NONE;
}

test the_inspector_subject_is_the_hovered_node_else_the_seed {
    var p : PsvState = psv_open();
    assert psv_subject(p) == PSV_NO_SEED;
    p = psv_apply(p, VIZ_EV_HOVER, psv_node_ref(8), 0);
    assert psv_subject(p) == 8;
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    assert psv_subject(p) == 8;
    p = psv_apply(p, VIZ_EV_HOVER, psv_edge_ref(3), 0);
    assert psv_subject(p) == 4;
    p = psv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert psv_subject(p) == 4;
    p = psv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert psv_subject(p) == PSV_NO_SEED;
}

; ---------------------------------------------------------------- tests: inspector

test the_inspector_reads_the_real_spec_lines_degree_value_and_hops {
    let g : SpecGraph = tutorial_08_graph();
    // Lines in specs/tutorial/08_modules_and_arrays.t27, as the graph records them.
    assert psv_inspect_line_start(g, 4) == 37;
    assert psv_inspect_line_end(g, 4) == 39;
    assert psv_inspect_line_start(g, 0) == 1;
    assert psv_inspect_line_end(g, 0) == 93;
    assert psv_inspect_line_start(g, 14) == 79;
    assert psv_inspect_line_end(g, 14) == 89;
    assert psv_inspect_line_start(g, 13) == 92;
    assert psv_inspect_line_end(g, 13) == 93;
    assert psv_inspect_line_start(g, 12) == 88;
    assert psv_inspect_line_end(g, 12) == 90;
    assert psv_inspect_line_start(g, 15) == NO_LINE;
    assert psv_inspect_line_end(g, 15) == NO_LINE;
    assert NO_LINE == 0;
    // Node 4 selected, layer 2: the three aggregations of the same spread.
    var p : PsvState = psv_open();
    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(4), 0);
    p = psv_apply(p, VIZ_EV_STEP_SET, 2, 0);
    assert psv_degree(g, p.mask, 4) == 3;
    assert psv_inspect_value(g, p, 4) == 4000000;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 1, 0);
    assert psv_inspect_value(g, p, 4) == 395833;
    p = psv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert psv_inspect_value(g, p, 4) == 1000000;
    assert psv_inspect_hops(g, p, 4) == 0;
    assert psv_inspect_hops(g, p, 12) == 1;
    assert psv_inspect_hops(g, p, 13) == 2;
    assert psv_inspect_hops(g, p, 0) == PSV_FAR;
}

; ---------------------------------------------------------------- tests: host and plan

test the_host_validates_and_places_each_view_in_its_slot {
    let g : SpecGraph = tutorial_08_graph();
    let h : VizHost = psv_host();
    assert h.count == 9;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_TEXT;
    assert h.rep[1] == VIZ_REP_BADGE;
    assert h.rep[2] == VIZ_REP_CHOICE;
    assert h.rep[3] == VIZ_REP_STEPPER;
    assert h.rep[4] == VIZ_REP_GRAPH;
    assert h.rep[5] == VIZ_REP_MATRIX;
    assert h.rep[6] == VIZ_REP_LIST;
    assert h.rep[7] == VIZ_REP_TRACE;
    assert h.rep[8] == VIZ_REP_INSPECTOR;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[1] == PSV_SLOT_FRAME;
    assert h.parent[8] == PSV_SLOT_FRAME;
    // The slot rects are the layout constants: the graph slot, the 15 x 15 matrix, 16 list lines.
    assert h.x[4] == PSV_GRAPH_X;
    assert h.y[4] == PSV_GRAPH_Y;
    assert h.w[4] == PSV_GRAPH_W;
    assert h.h[4] == PSV_GRAPH_H;
    assert h.w[5] == 360;
    assert h.h[5] == 360;
    assert h.w[6] == PSV_LIST_W;
    assert h.h[6] == 352;
    // A point in each slot lands in that slot, the frame catches the rest, outside is nothing.
    assert vh_hit(h, 30, 20) == PSV_SLOT_BADGE;
    assert vh_hit(h, 400, 20) == PSV_SLOT_CHOICE;
    assert vh_hit(h, 800, 20) == PSV_SLOT_STEPPER;
    assert vh_hit(h, 170, 122) == PSV_SLOT_GRAPH;
    assert vh_hit(h, 30, 590) == PSV_SLOT_MATRIX;
    assert vh_hit(h, 430, 590) == PSV_SLOT_LIST;
    assert vh_hit(h, 1000, 600) == PSV_SLOT_TRACE;
    assert vh_hit(h, 1500, 600) == PSV_SLOT_INSPECTOR;
    assert vh_hit(h, 5, 5) == PSV_SLOT_FRAME;
    assert vh_hit(h, 1380, 600) == PSV_SLOT_FRAME;
    assert vh_hit(h, 1950, 5) == VH_NONE;
    // Every node box centre is in the graph slot; every cell and every line in its own slot.
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        assert vh_hit(h, psv_node_cx(g, v), psv_node_cy(g, v)) == PSV_SLOT_GRAPH;
        v = v + 1;
    }
    var i : u32 = 0;
    while (i < PSV_MATRIX_N) {
        var j : u32 = 0;
        while (j < PSV_MATRIX_N) {
            assert vh_hit(h, psv_cell_x(i, j) + 12, psv_cell_y(i, j) + 12) == PSV_SLOT_MATRIX;
            j = j + 1;
        }
        i = i + 1;
    }
    var e : u32 = 0;
    while (e < PSV_EDGE_COUNT) {
        assert vh_hit(h, PSV_LIST_X + 10, psv_line_y(e) + 10) == PSV_SLOT_LIST;
        e = e + 1;
    }
}

test the_host_and_the_plan_use_the_same_reps_and_pass_the_plan_check {
    let reps : u32 = psv_reps();
    // GRAPH 1 + MATRIX 2 + LIST 4 + TRACE 16 + INSPECTOR 32 + STEPPER 64 + CHOICE 128
    // + BADGE 256 + TEXT 4096.
    assert reps == 4599;
    assert psv_host_reps(psv_host()) == reps;
    assert viz_plan_ok(reps);
    assert viz_is_linked(reps);
    // Six entity views: graph, matrix, list, trace, inspector, text. The stepper, the choice and
    // the badge are controls and status, not views.
    assert viz_view_count(reps) == 6;
    assert (reps & viz_rep_bit(VIZ_REP_BADGE)) != 0;
}

; ---------------------------------------------------------------- tests: integration

test a_click_in_any_view_goes_through_the_one_reducer {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    let r0 : u32 = p.viz.revision;
    // Click node 4 in the graph.
    let a : u32 = psv_graph_hit(g, 950, 122);
    assert a == psv_node_ref(4);
    p = psv_apply(p, VIZ_EV_SELECT, a, 0);
    assert p.viz.selected == psv_node_ref(4);
    assert psv_seed(p) == 4;
    assert p.viz.revision == r0 + 1;
    // Click cell (4, 2) in the matrix: the selection moves, the seed goes.
    let b : u32 = psv_matrix_hit(psv_cell_x(4, 2) + 5, psv_cell_y(4, 2) + 5);
    assert b == psv_cell_ref(4, 2);
    p = psv_apply(p, VIZ_EV_SELECT, b, 0);
    assert p.viz.selected == psv_cell_ref(4, 2);
    assert psv_seed(p) == PSV_NO_SEED;
    assert p.viz.revision == r0 + 2;
    // Click line 3 in the list.
    let c : u32 = psv_list_hit(500, psv_line_y(3) + 3);
    assert c == psv_edge_ref(3);
    p = psv_apply(p, VIZ_EV_SELECT, c, 0);
    assert p.viz.selected == psv_edge_ref(3);
    assert p.viz.revision == r0 + 3;
    // Clicking the same line again clears the selection.
    p = psv_apply(p, VIZ_EV_SELECT, psv_list_hit(500, psv_line_y(3) + 9), 0);
    assert p.viz.selected == VIZ_REF_NONE;
    // Hover in the graph is the hover every view reads.
    p = psv_apply(p, VIZ_EV_HOVER, psv_graph_hit(g, 950, 186), 0);
    assert p.viz.hover == psv_node_ref(8);
    assert viz_highlight(p.viz, psv_node_ref(8)) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, p, 8) == VIZ_HL_HOVER;
    // A point in the gap hovers nothing: the view sends VIZ_REF_NONE and the hover is cleared.
    p = psv_apply(p, VIZ_EV_HOVER, psv_graph_hit(g, 290, 110), 0);
    assert p.viz.hover == VIZ_REF_NONE;
}

; ---------------------------------------------------------------- invariants

invariant the_budget_fits_the_flat_arrays {
    assert PSV_NODE_COUNT <= PSV_MAX_NODES;
    assert PSV_EDGE_COUNT <= PSV_MAX_EDGES;
    assert PSV_MAX_EDGES <= 32;
    assert PSV_ALL_EDGES == psv_bit(PSV_EDGE_COUNT) - 1;
    assert (PSV_LAYERS + 1) * PSV_MAX_NODES == 80;
    assert PSV_STRIDE >= PSV_MAX_NODES;
    assert PSV_MATRIX_N == PSV_NODE_COUNT;
    assert (PSV_MATRIX_N - 1) * PSV_STRIDE + PSV_MATRIX_N - 1 < 65536;
    assert PSV_EV_TOGGLE_EDGE >= VIZ_EV_COUNT;
    assert PSV_HL_RELATED > VIZ_HL_SELECT;
    assert PSV_AGG_COUNT == 3;
    assert PSV_AGG_MAX + 1 == PSV_AGG_COUNT;
    assert PSV_NODE_COUNT + PSV_EDGE_COUNT == 31;
}

// A test, not an invariant: the node geometry walks the kind order for every box, past the
// compile-time evaluator's branch budget.
test the_layout_fits_its_slots {
    let g : SpecGraph = tutorial_08_graph();
    assert view_width(g) == PSV_GRAPH_W;
    assert view_height(g) == PSV_GRAPH_H;
    // Graph above the matrix and the list; matrix, list, trace, inspector side by side.
    assert PSV_GRAPH_Y + PSV_GRAPH_H < PSV_MATRIX_Y;
    assert PSV_GRAPH_Y + PSV_GRAPH_H < PSV_LIST_Y;
    assert PSV_MATRIX_X + PSV_MATRIX_N * PSV_CELL <= PSV_LIST_X;
    assert PSV_LIST_X + PSV_LIST_W <= 900;
    assert PSV_GRAPH_X + PSV_GRAPH_W <= PSV_FRAME_W;
    assert PSV_MATRIX_Y + PSV_MATRIX_N * PSV_CELL <= PSV_FRAME_H;
    assert PSV_LIST_Y + PSV_EDGE_COUNT * PSV_LINE_H <= PSV_FRAME_H;
    // Every node box and every edge end lies inside the graph slot.
    var v : u32 = 0;
    while (v < PSV_NODE_COUNT) {
        assert psv_node_x(g, v) >= PSV_GRAPH_X;
        assert psv_node_y(g, v) >= PSV_GRAPH_Y;
        assert psv_node_x(g, v) + psv_node_w(g, v) <= PSV_GRAPH_X + PSV_GRAPH_W;
        assert psv_node_y(g, v) + psv_node_h(g, v) <= PSV_GRAPH_Y + PSV_GRAPH_H;
        v = v + 1;
    }
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        assert psv_edge_x0(g, j) >= PSV_GRAPH_X;
        assert psv_edge_x1(g, j) < PSV_GRAPH_X + PSV_GRAPH_W;
        assert psv_edge_y0(g, j) >= PSV_GRAPH_Y;
        assert psv_edge_y1(g, j) < PSV_GRAPH_Y + PSV_GRAPH_H;
        j = j + 1;
    }
}

// A test, not an invariant: invariants are evaluated at compile time, and 7 masks x 16 x 16 cells x
// 16 edges is past the evaluator's branch budget.
test the_adjacency_table_equals_a_direct_scan_of_the_enabled_edges {
    let g : SpecGraph = tutorial_08_graph();
    var k : u32 = 0;
    while (k < 7) {
        let m : u32 = psv_sample_mask(k);
        let a : PsvAdj = psv_adj_table(g, m);
        var i : u32 = 0;
        while (i < PSV_NODE_COUNT) {
            var j : u32 = 0;
            while (j < PSV_NODE_COUNT) {
                let cell_bit : u32 = a.row[i as usize] & psv_bit(j);
                let mirror : u32 = a.row[j as usize] & psv_bit(i);
                if (psv_scan_adj(g, m, i, j)) {
                    assert cell_bit != 0;
                    assert mirror != 0;
                } else {
                    assert cell_bit == 0;
                    assert mirror == 0;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

invariant a_demo_petal_never_claims_a_result {
    let base : PsvState = psv_open();
    assert viz_may_claim(base.viz.truth);
    var j : u32 = 0;
    while (j < PSV_EDGE_COUNT) {
        let off : PsvState = psv_apply(base, PSV_EV_TOGGLE_EDGE, j, 0);
        assert off.viz.truth == VIZ_TRUTH_DEMO;
        assert viz_may_claim(off.viz.truth) == false;
        let on : PsvState = psv_apply(off, PSV_EV_TOGGLE_EDGE, j, 0);
        assert on.viz.truth == VIZ_TRUTH_VERIFIED;
        assert viz_may_claim(on.viz.truth);
        j = j + 1;
    }
}

; ---------------------------------------------------------------- tests: L9 host mapping (issue #12199)

/// Two petal states are the same in every field, the revision and the mask included.
fn psv_eq(a: PsvState, b: PsvState) -> bool {
    return a.mask == b.mask and a.viz.lifecycle == b.viz.lifecycle and a.viz.error == b.viz.error and a.viz.truth == b.viz.truth and a.viz.item_count == b.viz.item_count and a.viz.hover == b.viz.hover and a.viz.selected == b.viz.selected and a.viz.step == b.viz.step and a.viz.step_count == b.viz.step_count and a.viz.param == b.viz.param and a.viz.param_count == b.viz.param_count and a.viz.focus == b.viz.focus and a.viz.focus_count == b.viz.focus_count and a.viz.reduced_motion == b.viz.reduced_motion and a.viz.revision == b.viz.revision;
}

/// The page-pixel position that lands on frame length f at scale s with margin o, and back: what a
/// host does to turn a pointer into a frame point.
fn psv_page_px(f: u32, o: u32, s: u32) -> u32 {
    return o + psv_to_px(f, s);
}

test the_state_words_round_trip_for_every_seed_step_choice_and_mask {
    let g : SpecGraph = tutorial_08_graph();
    var w : [8]u64 = [0; 8];
    var k : u32 = 0;
    while (k < 7) {
        var n : u32 = 0;
        while (n < PSV_NODE_COUNT) {
            var st : u32 = 0;
            while (st <= PSV_LAYERS) {
                var ag : u32 = 0;
                while (ag < PSV_AGG_COUNT) {
                    var p : PsvState = psv_open();
                    p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(n), 0);
                    p = psv_apply(p, VIZ_EV_STEP_SET, st, 0);
                    p = psv_apply(p, VIZ_EV_PARAM_SET, ag, 0);
                    p = psv_apply(p, VIZ_EV_HOVER, psv_edge_ref(n), 0);
                    p = psv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
                    p.mask = psv_sample_mask(k);
                    psv_store(w[0..8], 2, p);
                    let q : PsvState = psv_load(w[0..8], 2);
                    assert psv_eq(p, q);
                    assert psv_seed(q) == n;
                    ag = ag + 1;
                }
                st = st + 1;
            }
            n = n + 1;
        }
        k = k + 1;
    }
    // The six words are w[2 .. 8): the two before them are never written.
    assert w[0] == 0;
    assert w[1] == 0;
    assert PSV_WORDS == 6;
}

test an_unwritten_page_opens_the_petal_and_a_store_leaves_the_neighbours_alone {
    var w : [10]u64 = [7; 10];
    w[3] = 0;
    w[4] = 0;
    w[5] = 0;
    w[6] = 0;
    w[7] = 0;
    w[8] = 0;
    let first : PsvState = psv_load(w[0..10], 3);
    assert psv_eq(first, psv_open());
    assert first.viz.lifecycle == VIZ_LC_READY;
    assert first.viz.truth == VIZ_TRUTH_VERIFIED;
    assert first.mask == PSV_ALL_EDGES;
    var p : PsvState = psv_apply(first, PSV_EV_TOGGLE_EDGE, 5, 0);
    psv_store(w[0..10], 3, p);
    assert w[0] == 7;
    assert w[1] == 7;
    assert w[2] == 7;
    assert w[9] == 7;
    assert w[3] != 0;
    assert psv_eq(psv_load(w[0..10], 3), p);
    assert psv_load(w[0..10], 3).viz.truth == VIZ_TRUTH_DEMO;
}

test the_state_bytes_round_trip_and_agree_with_the_words {
    var b : [64]u8 = [0; 64];
    var k : u32 = 0;
    while (k < 7) {
        var n : u32 = 0;
        while (n < PSV_NODE_COUNT) {
            var p : PsvState = psv_open();
            p = psv_apply(p, VIZ_EV_SELECT, psv_node_ref(n), 0);
            p = psv_apply(p, VIZ_EV_STEP_SET, n % 5, 0);
            p = psv_apply(p, VIZ_EV_PARAM_SET, n % 3, 0);
            p = psv_apply(p, VIZ_EV_HOVER, psv_edge_ref(n), 0);
            p = psv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
            p.mask = psv_sample_mask(k);
            psv_store_bytes(b[0..64], 5, p);
            let q : PsvState = psv_load_bytes(b[0..64], 5);
            assert psv_eq(p, q);
            assert psv_seed(q) == n;
            // the bytes hold exactly the six words, low byte first
            var w : [6]u64 = [0; 6];
            psv_store(w[0..6], 0, p);
            assert (b[5] as u64) == w[0] % 256;
            assert (b[6] as u64) == w[0] / 256 % 256;
            assert (b[5 + 40] as u64) == w[5] % 256;
            assert (b[5 + 47] as u64) == w[5] / 72057594037927936;
            n = n + 1;
        }
        k = k + 1;
    }
    assert PSV_BYTES == 48;
}

test unwritten_state_bytes_open_the_petal_and_a_store_leaves_the_neighbours_alone {
    var b : [64]u8 = [9; 64];
    var i : usize = 4;
    while (i < 52) {
        b[i] = 0;
        i = i + 1;
    }
    let first : PsvState = psv_load_bytes(b[0..64], 4);
    assert psv_eq(first, psv_open());
    let p : PsvState = psv_apply(first, PSV_EV_TOGGLE_EDGE, 5, 0);
    psv_store_bytes(b[0..64], 4, p);
    var j : usize = 0;
    while (j < 4) {
        assert b[j] == 9;
        j = j + 1;
    }
    j = 52;
    while (j < 64) {
        assert b[j] == 9;
        j = j + 1;
    }
    assert b[4] != 0;
    assert psv_eq(psv_load_bytes(b[0..64], 4), p);
    assert psv_load_bytes(b[0..64], 4).viz.truth == VIZ_TRUTH_DEMO;
}

test the_edge_count_off_follows_the_mask {
    assert psv_edges_off(PSV_ALL_EDGES) == 0;
    assert psv_edges_off(0) == PSV_EDGE_COUNT;
    var p : PsvState = psv_open();
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 2, 0);
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 9, 0);
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 15, 0);
    assert psv_edges_off(p.mask) == 3;
    p = psv_apply(p, PSV_EV_TOGGLE_EDGE, 9, 0);
    assert psv_edges_off(p.mask) == 2;
}

test the_fit_keeps_the_whole_frame_in_the_page_and_the_aspect {
    var k : u32 = 0;
    while (k < 8) {
        var pw : u32 = 1900;
        var ph : u32 = 1000;
        if (k == 1) { pw = 950; ph = 500; }
        if (k == 2) { pw = 800; ph = 900; }
        if (k == 3) { pw = 3000; ph = 1200; }
        if (k == 4) { pw = 1280; ph = 720; }
        if (k == 5) { pw = 700; ph = 1400; }
        if (k == 6) { pw = 1440; ph = 800; }
        if (k == 7) { pw = 400; ph = 300; }
        let s : u32 = psv_fit_scale(pw, ph);
        let ox : u32 = psv_fit_ox(pw, ph);
        let oy : u32 = psv_fit_oy(pw, ph);
        assert s >= 1;
        assert PSV_FRAME_W * s <= pw * 1000;
        assert PSV_FRAME_H * s <= ph * 1000;
        // One more thousandth would overflow one of the two sides: the fit is tight.
        assert PSV_FRAME_W * (s + 1) > pw * 1000 or PSV_FRAME_H * (s + 1) > ph * 1000;
        // The scaled frame, with its margins, is inside the page and centred to within a pixel.
        assert ox + psv_to_px(PSV_FRAME_W, s) <= pw;
        assert oy + psv_to_px(PSV_FRAME_H, s) <= ph;
        assert ox * 2 + psv_to_px(PSV_FRAME_W, s) + 2 >= pw;
        assert oy * 2 + psv_to_px(PSV_FRAME_H, s) + 2 >= ph;
        k = k + 1;
    }
    // A page the frame fits into 1:1 keeps the scale at 1000 and the frame at the page origin.
    assert psv_fit_scale(1900, 1000) == 1000;
    assert psv_fit_ox(1900, 1000) == 0;
    assert psv_fit_oy(1900, 1000) == 0;
    // A page of 0 is still a scale, never a divide-by-zero in the inverse.
    assert psv_fit_scale(0, 0) == 1;
    assert psv_to_frame(5, 9, 1000) == PSV_NO_PICK;
    assert psv_to_frame(9, 9, 1000) == 0;
    assert psv_to_frame(509, 9, 500) == 1000;
}

test a_click_on_the_center_of_every_node_selects_that_seed_in_all_three_views {
    let g : SpecGraph = tutorial_08_graph();
    var k : u32 = 0;
    while (k < 5) {
        var pw : u32 = 1900;
        var ph : u32 = 1000;
        if (k == 1) { pw = 1280; ph = 720; }
        if (k == 2) { pw = 1440; ph = 800; }
        if (k == 3) { pw = 960; ph = 600; }
        if (k == 4) { pw = 2400; ph = 1300; }
        let s : u32 = psv_fit_scale(pw, ph);
        let ox : u32 = psv_fit_ox(pw, ph);
        let oy : u32 = psv_fit_oy(pw, ph);
        var n : u32 = 0;
        while (n < PSV_NODE_COUNT) {
            let lx : u32 = psv_page_px(psv_node_cx(g, n), ox, s);
            let ly : u32 = psv_page_px(psv_node_cy(g, n), oy, s);
            let fx : u32 = psv_to_frame(lx, ox, s);
            let fy : u32 = psv_to_frame(ly, oy, s);
            let open : PsvState = psv_open();
            let act : PsvAct = psv_click_at(g, open, fx, fy);
            assert act.ev == VIZ_EV_SELECT;
            assert act.a == psv_node_ref(n);
            let p : PsvState = psv_do(open, act);
            assert psv_seed(p) == n;
            assert p.viz.revision == open.viz.revision + 1;
            // The graph, the matrix and the list read the one state: the node is selected, every
            // edge that touches it and every cell in its row and column is related, nothing else is.
            assert psv_node_hl_in(g, p, n) == VIZ_HL_SELECT;
            var j : u32 = 0;
            while (j < PSV_EDGE_COUNT) {
                if (psv_edge_from(g, j) == n or psv_edge_to(g, j) == n) {
                    assert psv_edge_hl_in(g, p, j) == PSV_HL_RELATED;
                } else {
                    assert psv_edge_hl_in(g, p, j) == VIZ_HL_NONE;
                }
                j = j + 1;
            }
            var m : u32 = 0;
            while (m < PSV_NODE_COUNT) {
                assert psv_cell_hl_in(g, p, n, m) == PSV_HL_RELATED;
                assert psv_cell_hl_in(g, p, m, n) == PSV_HL_RELATED;
                m = m + 1;
            }
            let o1 : u32 = (n + 1) % PSV_NODE_COUNT;
            let o2 : u32 = (n + 2) % PSV_NODE_COUNT;
            assert psv_cell_hl_in(g, p, o1, o2) == VIZ_HL_NONE;
            n = n + 1;
        }
        k = k + 1;
    }
}

test a_click_on_a_matrix_cell_or_a_list_line_selects_it_and_empty_frame_clears {
    let g : SpecGraph = tutorial_08_graph();
    let open : PsvState = psv_open();
    let a : PsvAct = psv_click_at(g, open, psv_cell_x(4, 2) + 7, psv_cell_y(4, 2) + 7);
    assert a.ev == VIZ_EV_SELECT;
    assert a.a == psv_cell_ref(4, 2);
    let b : PsvAct = psv_click_at(g, open, PSV_LIST_X + 200, psv_line_y(6) + 4);
    assert b.ev == VIZ_EV_SELECT;
    assert b.a == psv_edge_ref(6);
    // Empty frame with a selection clears it; with nothing selected it is no event.
    let sel : PsvState = psv_do(open, a);
    assert sel.viz.selected == psv_cell_ref(4, 2);
    let c : PsvAct = psv_click_at(g, sel, 1500, 400);
    assert c.ev == VIZ_EV_CLEAR;
    assert psv_do(sel, c).viz.selected == VIZ_REF_NONE;
    assert psv_click_at(g, open, 1500, 400).ev == PSV_EV_NONE;
    // Outside the frame, and the "no pick" coordinate, hit nothing even with a selection.
    assert psv_click_at(g, sel, PSV_FRAME_W, 400).ev == PSV_EV_NONE;
    assert psv_click_at(g, sel, 400, PSV_FRAME_H).ev == PSV_EV_NONE;
    assert psv_click_at(g, sel, PSV_NO_PICK, PSV_NO_PICK).ev == PSV_EV_NONE;
    assert psv_click_at(g, sel, 500, PSV_NO_PICK).ev == PSV_EV_NONE;
    // Clicking the selected line again toggles the selection off (the reducer's SELECT rule).
    let d : PsvState = psv_do(open, b);
    let e : PsvAct = psv_click_at(g, d, PSV_LIST_X + 200, psv_line_y(6) + 4);
    assert psv_do(d, e).viz.selected == VIZ_REF_NONE;
}

test the_choice_and_stepper_cells_hit_where_the_host_slots_put_them {
    // The controls sit inside the rects psv_host declares for them.
    let h : VizHost = psv_host();
    assert h.x[PSV_SLOT_CHOICE as usize] == PSV_CHOICE_X;
    assert h.y[PSV_SLOT_CHOICE as usize] == PSV_CTRL_Y;
    assert h.w[PSV_SLOT_CHOICE as usize] == PSV_AGG_COUNT * PSV_CHOICE_CELL;
    assert h.h[PSV_SLOT_CHOICE as usize] == PSV_CTRL_H;
    assert h.x[PSV_SLOT_STEPPER as usize] == PSV_STEP_X;
    assert h.y[PSV_SLOT_STEPPER as usize] == PSV_CTRL_Y;
    assert h.w[PSV_SLOT_STEPPER as usize] == PSV_STEP_SLOTS * PSV_STEP_CELL;
    assert h.h[PSV_SLOT_STEPPER as usize] == PSV_CTRL_H;
    assert PSV_STEP_SLOTS == PSV_LAYERS + 3;
    assert PSV_STEP_NEXT_SLOT == PSV_LAYERS + 2;
    assert h.x[PSV_SLOT_TRACE as usize] == PSV_TRACE_X;
    assert h.y[PSV_SLOT_TRACE as usize] == PSV_TRACE_Y;
    assert h.w[PSV_SLOT_TRACE as usize] == PSV_TRACE_W;
    assert PSV_TRACE_HEAD + (PSV_LAYERS + 1) * PSV_TRACE_ROW <= h.h[PSV_SLOT_TRACE as usize];
    assert psv_trace_cell_x(PSV_NODE_COUNT) <= PSV_TRACE_X + PSV_TRACE_W;
    assert PSV_TRACE_CELL_X > PSV_TRACE_X;
    assert PSV_GUTTER < PSV_LIST_W;
    assert PSV_CHOICE_X + PSV_AGG_COUNT * PSV_CHOICE_CELL <= PSV_STEP_X;
    assert PSV_STEP_X + PSV_STEP_SLOTS * PSV_STEP_CELL <= PSV_FRAME_W;
    // The edges of each cell.
    assert psv_choice_hit(PSV_CHOICE_X - 1, 20) == PSV_NO_PICK;
    assert psv_choice_hit(PSV_CHOICE_X, 20) == 0;
    assert psv_choice_hit(PSV_CHOICE_X + PSV_CHOICE_CELL - 1, 20) == 0;
    assert psv_choice_hit(PSV_CHOICE_X + PSV_CHOICE_CELL, 20) == 1;
    assert psv_choice_hit(PSV_CHOICE_X + 3 * PSV_CHOICE_CELL - 1, PSV_CTRL_Y + PSV_CTRL_H - 1) == 2;
    assert psv_choice_hit(PSV_CHOICE_X + 3 * PSV_CHOICE_CELL, 20) == PSV_NO_PICK;
    assert psv_choice_hit(PSV_CHOICE_X, PSV_CTRL_Y - 1) == PSV_NO_PICK;
    assert psv_choice_hit(PSV_CHOICE_X, PSV_CTRL_Y + PSV_CTRL_H) == PSV_NO_PICK;
    assert psv_step_hit(PSV_STEP_X - 1, 20) == PSV_NO_PICK;
    assert psv_step_hit(PSV_STEP_X, 20) == 0;
    assert psv_step_hit(PSV_STEP_X + PSV_STEP_SLOTS * PSV_STEP_CELL - 1, 20) == PSV_STEP_NEXT_SLOT;
    assert psv_step_hit(PSV_STEP_X + PSV_STEP_SLOTS * PSV_STEP_CELL, 20) == PSV_NO_PICK;
    assert psv_step_hit(PSV_STEP_X, PSV_CTRL_Y + PSV_CTRL_H) == PSV_NO_PICK;
}

test the_aggregation_choice_and_the_stepper_change_the_trace {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_do(p, psv_click_at(g, p, psv_node_cx(g, 4), psv_node_cy(g, 4)));
    assert psv_seed(p) == 4;
    assert p.viz.param == PSV_AGG_SUM;
    assert p.viz.step == 0;
    // Pick max, then sum, then mean, by a click on each cell centre.
    let y : u32 = PSV_CTRL_Y + PSV_CTRL_H / 2;
    let cx : u32 = PSV_CHOICE_X + PSV_CHOICE_CELL / 2;
    let on_sum : PsvState = psv_do(p, psv_click_at(g, p, cx, y));
    let on_mean : PsvState = psv_do(p, psv_click_at(g, p, cx + PSV_CHOICE_CELL, y));
    let on_max : PsvState = psv_do(p, psv_click_at(g, p, cx + 2 * PSV_CHOICE_CELL, y));
    assert on_sum.viz.param == PSV_AGG_SUM;
    assert on_mean.viz.param == PSV_AGG_MEAN;
    assert on_max.viz.param == PSV_AGG_MAX;
    assert on_max.viz.revision == p.viz.revision + 1;
    // The choice changes the numbers. At layer 2 the seed has met itself and its 3 neighbours, each
    // holding PSV_SEED after one round: sum 4 x, max 1 x. The mean divides the seed's own round-1
    // value by itself plus 3 neighbours.
    let ts : PsvTrace = psv_trace_of(g, on_sum);
    let tm : PsvTrace = psv_trace_of(g, on_mean);
    let tx : PsvTrace = psv_trace_of(g, on_max);
    assert psv_value(ts, 0, 4) == PSV_SEED;
    assert psv_value(ts, 2, 4) == 4 * PSV_SEED;
    assert psv_value(tx, 2, 4) == PSV_SEED;
    assert psv_value(tm, 1, 4) == PSV_SEED / 4;
    assert psv_value(tm, 1, 4) != psv_value(ts, 1, 4) or psv_value(tm, 2, 4) != psv_value(ts, 2, 4);
    // The stepper: slot 3 is layer 2, slot 0 is previous, the last slot is next; the layer changes.
    let sy : u32 = PSV_CTRL_Y + PSV_CTRL_H / 2;
    let sx : u32 = PSV_STEP_X + PSV_STEP_CELL / 2;
    var q : PsvState = psv_do(p, psv_click_at(g, p, sx + 3 * PSV_STEP_CELL, sy));
    assert q.viz.step == 2;
    q = psv_do(q, psv_click_at(g, q, sx + PSV_STEP_NEXT_SLOT * PSV_STEP_CELL, sy));
    assert q.viz.step == 3;
    q = psv_do(q, psv_click_at(g, q, sx, sy));
    assert q.viz.step == 2;
    q = psv_do(q, psv_click_at(g, q, sx + 5 * PSV_STEP_CELL, sy));
    assert q.viz.step == 4;
    // A click on the trace row of layer 1 sets the layer too.
    let r : PsvAct = psv_click_at(g, q, PSV_TRACE_X + 20, psv_trace_row_y(1) + 10);
    assert r.ev == VIZ_EV_STEP_SET;
    assert psv_do(q, r).viz.step == 1;
    // The controls never change the seed or the mask.
    assert psv_seed(q) == 4;
    assert q.mask == PSV_ALL_EDGES;
}

test a_click_on_the_list_gutter_flips_the_edge_and_the_badge_says_demo {
    let g : SpecGraph = tutorial_08_graph();
    let open : PsvState = psv_open();
    assert open.viz.truth == VIZ_TRUTH_VERIFIED;
    let gy : u32 = psv_line_y(3) + 5;
    let off_act : PsvAct = psv_click_at(g, open, PSV_LIST_X + 10, gy);
    assert off_act.ev == PSV_EV_TOGGLE_EDGE;
    assert off_act.a == 3;
    let off : PsvState = psv_do(open, off_act);
    assert (off.mask & psv_bit(3)) == 0;
    assert psv_edges_off(off.mask) == 1;
    assert off.viz.truth == VIZ_TRUTH_DEMO;
    assert viz_may_claim(off.viz.truth) == false;
    // The next press on the same gutter brings the edge back and the truth with it.
    let on : PsvState = psv_do(off, psv_click_at(g, off, PSV_LIST_X + 10, gy));
    assert on.mask == PSV_ALL_EDGES;
    assert on.viz.truth == VIZ_TRUTH_VERIFIED;
    // The rest of the line selects the edge and does not touch the mask.
    let sel : PsvAct = psv_click_at(g, open, PSV_LIST_X + PSV_GUTTER, gy);
    assert sel.ev == VIZ_EV_SELECT;
    assert sel.a == psv_edge_ref(3);
    assert psv_do(open, sel).mask == PSV_ALL_EDGES;
    assert psv_gutter_hit(PSV_LIST_X + PSV_GUTTER - 1, gy) == 3;
    assert psv_gutter_hit(PSV_LIST_X + PSV_GUTTER, gy) == PSV_NO_PICK;
    assert psv_gutter_hit(PSV_LIST_X - 1, gy) == PSV_NO_PICK;
    assert psv_gutter_hit(PSV_LIST_X + 2, PSV_LIST_Y - 1) == PSV_NO_PICK;
    // An edge that is off still counts in the matrix by its pair: its cell loses the adjacency bit.
    let a : u32 = psv_edge_from(g, 3);
    let b : u32 = psv_edge_to(g, 3);
    assert psv_cell_on(g, open.mask, a, b);
}

test a_still_pointer_never_bumps_the_revision {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    let x : u32 = psv_node_cx(g, 8);
    let y : u32 = psv_node_cy(g, 8);
    let h1 : PsvAct = psv_hover_at(g, p, x, y);
    assert h1.ev == VIZ_EV_HOVER;
    assert h1.a == psv_node_ref(8);
    p = psv_do(p, h1);
    let r : u32 = p.viz.revision;
    assert p.viz.hover == psv_node_ref(8);
    // The same place again: no event, nothing to redraw.
    assert psv_hover_at(g, p, x, y).ev == PSV_EV_NONE;
    assert psv_do(p, psv_hover_at(g, p, x, y)).viz.revision == r;
    // A gap leaves; leaving twice is no event the second time.
    let lv : PsvAct = psv_hover_at(g, p, 1500, 400);
    assert lv.ev == VIZ_EV_LEAVE;
    p = psv_do(p, lv);
    assert p.viz.hover == VIZ_REF_NONE;
    assert psv_hover_at(g, p, 1500, 400).ev == PSV_EV_NONE;
    // The controls and the trace are not entities: they never hover.
    assert psv_hover_at(g, p, PSV_CHOICE_X + 10, 20).ev == PSV_EV_NONE;
    assert psv_hover_at(g, p, PSV_TRACE_X + 20, psv_trace_row_y(2) + 5).ev == PSV_EV_NONE;
    // A matrix cell hovers as a cell; its row and column nodes light up as HOVER in the graph.
    let hc : PsvAct = psv_hover_at(g, p, psv_cell_x(4, 2) + 3, psv_cell_y(4, 2) + 3);
    assert hc.ev == VIZ_EV_HOVER;
    assert hc.a == psv_cell_ref(4, 2);
    let pc : PsvState = psv_do(p, hc);
    assert psv_node_hl_in(g, pc, 4) == VIZ_HL_HOVER;
    assert psv_node_hl_in(g, pc, 2) == VIZ_HL_HOVER;
}

test the_keys_map_to_the_same_events_as_the_pointer {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    // Arrow keys: layers.
    assert psv_key_act(p, PSV_KEY_RIGHT).ev == VIZ_EV_STEP_NEXT;
    assert psv_key_act(p, PSV_KEY_LEFT).ev == VIZ_EV_STEP_PREV;
    p = psv_do(p, psv_key_act(p, PSV_KEY_RIGHT));
    p = psv_do(p, psv_key_act(p, PSV_KEY_RIGHT));
    assert p.viz.step == 2;
    p = psv_do(p, psv_key_act(p, PSV_KEY_LEFT));
    assert p.viz.step == 1;
    // Down and up: focus walks nodes 0..14 then edges 0..15; ACTIVATE selects the focused item.
    p = psv_do(p, psv_key_act(p, PSV_KEY_DOWN));
    assert p.viz.focus == 0;
    p = psv_do(p, psv_key_act(p, PSV_KEY_DOWN));
    assert p.viz.focus == 1;
    let act : PsvAct = psv_key_act(p, PSV_KEY_ACTIVATE);
    assert act.ev == VIZ_EV_ACTIVATE;
    assert act.a == psv_node_ref(1);
    let sel : PsvState = psv_do(p, act);
    assert psv_seed(sel) == 1;
    // ACTIVATE with nothing focused is no event.
    assert psv_key_act(psv_open(), PSV_KEY_ACTIVATE).ev == PSV_EV_NONE;
    // Aggregation keys.
    assert psv_do(p, psv_key_act(p, PSV_KEY_MEAN)).viz.param == PSV_AGG_MEAN;
    assert psv_do(p, psv_key_act(p, PSV_KEY_MAX)).viz.param == PSV_AGG_MAX;
    assert psv_do(p, psv_key_act(p, PSV_KEY_SUM)).viz.param == PSV_AGG_SUM;
    // TOGGLE: nothing to act on for a node or for no focus; the selected edge, else the focused edge.
    assert psv_key_act(psv_open(), PSV_KEY_TOGGLE).ev == PSV_EV_NONE;
    assert psv_key_act(sel, PSV_KEY_TOGGLE).ev == PSV_EV_NONE;
    let es : PsvState = psv_do(psv_open(), psv_act(VIZ_EV_SELECT, psv_edge_ref(7), 0));
    let t1 : PsvAct = psv_key_act(es, PSV_KEY_TOGGLE);
    assert t1.ev == PSV_EV_TOGGLE_EDGE;
    assert t1.a == 7;
    let off : PsvState = psv_do(es, t1);
    assert off.viz.truth == VIZ_TRUTH_DEMO;
    var f : PsvState = psv_open();
    var i : u32 = 0;
    while (i < PSV_NODE_COUNT + 1) {
        f = psv_do(f, psv_key_act(f, PSV_KEY_DOWN));
        i = i + 1;
    }
    assert f.viz.focus == PSV_NODE_COUNT;
    let t2 : PsvAct = psv_key_act(f, PSV_KEY_TOGGLE);
    assert t2.ev == PSV_EV_TOGGLE_EDGE;
    assert t2.a == 0;
    // BACK: no event with nothing selected (the host closes the page), BACK with one.
    assert psv_key_act(psv_open(), PSV_KEY_BACK).ev == PSV_EV_NONE;
    let b : PsvAct = psv_key_act(sel, PSV_KEY_BACK);
    assert b.ev == VIZ_EV_BACK;
    assert psv_do(sel, b).viz.selected == VIZ_REF_NONE;
    // An unknown key or none is no event.
    assert psv_key_act(p, PSV_KEY_NONE).ev == PSV_EV_NONE;
    assert psv_key_act(p, 99).ev == PSV_EV_NONE;
    // PSV_EV_NONE leaves the state as it is, revision included.
    assert psv_eq(psv_do(p, psv_act_none()), p);
    // The hit tests above and the key map go through the same reducer: the revision moved once each.
    let r0 : u32 = p.viz.revision;
    assert psv_do(p, psv_key_act(p, PSV_KEY_MAX)).viz.revision == r0 + 1;
    assert psv_click_at(g, p, 1500, 400).ev == PSV_EV_NONE;
}

test the_trace_shade_marks_what_a_layer_holds_and_the_largest_is_black {
    let g : SpecGraph = tutorial_08_graph();
    var p : PsvState = psv_open();
    p = psv_do(p, psv_act(VIZ_EV_SELECT, psv_node_ref(4), 0));
    let t : PsvTrace = psv_trace_of(g, p);
    var layer : u32 = 0;
    while (layer <= PSV_LAYERS) {
        let m : u64 = psv_layer_max(t, layer);
        assert m > 0;
        var seen_max : bool = false;
        var v : u32 = 0;
        while (v < PSV_NODE_COUNT) {
            let x : u64 = psv_value(t, layer, v);
            let sh : u32 = psv_shade(t, layer, v);
            if (x == 0) {
                assert sh == 0;
            } else {
                assert sh >= 48;
                assert sh <= 255;
            }
            if (x == m) {
                assert sh == 255;
                seen_max = true;
            }
            v = v + 1;
        }
        assert seen_max;
        layer = layer + 1;
    }
    // With no selection the trace holds nothing: every shade is 0 and the layer max is 0.
    let none : PsvTrace = psv_trace_of(g, psv_open());
    assert psv_layer_max(none, 0) == 0;
    assert psv_shade(none, 3, 4) == 0;
}
