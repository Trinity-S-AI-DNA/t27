// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_links.t27 -- scene A_LINKS of reel_factory.t27: a hub and its neighbours. The
// lesson's module is the box in the middle; round it stand as many boxes as the lesson has `use`
// edges (3 to 9), each joined to the hub by an edge and to the next box by a faint chord, each
// labelled with three letters of the lesson's own code.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: `use` is how one module reaches another. The picture is the edge count of the lesson, laid
// out on a circle so a lesson with more edges has a fuller wheel.
//
// THE FUNCTION: links_px(t, acc, n, x, y) is the colour of canvas point (x, y). Hub at (180, 320),
// neighbours on a circle of radius 138, the first at the angle the lesson's first byte picks.
//
// NOT CLAIMED: the neighbours' names are letters of the lesson's code, not the modules it imports
// (the lesson code is a snippet, not a module header).
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_links;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::near_seg;
use t27f::scene_raster::char_on;
use t27f::scene_raster::clamp;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_bg::cos24;
use t27f::scene_bg::sin24;
use t27f::scene_lex::lex_byte;

pub const HX : i32 = 180;
pub const HY : i32 = 320;
pub const WHEEL : i32 = 138;
pub const HALF_W : i32 = 27;
pub const HALF_H : i32 = 12;
pub const CHORD : i32 = 0x2C3354;

pub fn sats(n: i32) -> i32 {
    return clamp(n, 3, 9);
}
// The slot of the circle, of 24, that neighbour i of s stands at.
pub fn slot(t: usize, i: i32, s: i32) -> i32 {
    return @mod(lex_byte(t, 0), 24) + @divTrunc(i * 24, s);
}
pub fn sat_x(t: usize, i: i32, s: i32) -> i32 {
    return HX + @divTrunc(WHEEL * cos24(slot(t, i, s)), 1000);
}
pub fn sat_y(t: usize, i: i32, s: i32) -> i32 {
    return HY + @divTrunc(WHEEL * 14 * sin24(slot(t, i, s)), 10000);
}

pub fn links_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(1, acc, seed_of(t, n, 7), x, y);
    const s = sats(n);
    // the hub
    if (in_rect(x, y, HX - 40, HY - 16, HX + 40, HY + 16)) {
        if (!in_rect(x, y, HX - 38, HY - 14, HX + 38, HY + 14)) { return rgb(245, 245, 245); }
        const k = @divTrunc(x - (HX - 30), 10);
        if (k >= 0 && k < 6 && y >= HY - 6 && y < HY + 6) {
            if (char_on(lex_byte(t, k + 2), x, y, HX - 30 + k * 10, HY - 6, 2)) { return acc; }
        }
        return rgb(14, 18, 40);
    }
    var i : i32 = 0;
    var edge : i32 = 0;
    while (i < s) {
        const sx = sat_x(t, i, s);
        const sy = sat_y(t, i, s);
        if (in_rect(x, y, sx - HALF_W, sy - HALF_H, sx + HALF_W, sy + HALF_H)) {
            if (!in_rect(x, y, sx - HALF_W + 2, sy - HALF_H + 2, sx + HALF_W - 2, sy + HALF_H - 2)) { return acc; }
            const k = @divTrunc(x - (sx - 21), 14);
            if (k >= 0 && k < 3 && y >= sy - 5 && y < sy + 5) {
                if (char_on(lex_byte(t, i * 3 + k + 7), x, y, sx - 21 + k * 14, sy - 5, 2)) { return rgb(245, 247, 255); }
            }
            return mix(rgb(14, 18, 40), acc, 60);
        }
        if (near_seg(x, y, HX, HY, sx, sy, 1)) { edge = 1; }
        if (near_seg(x, y, sx, sy, sat_x(t, i + 1, s), sat_y(t, i + 1, s), 0)) {
            if (edge == 0) { edge = 2; }
        }
        i = i + 1;
    }
    if (edge == 1) { return acc; }
    if (edge == 2) { return CHORD; }
    return c0;
}

// ---- tests ----

test "three to nine neighbours, all on the canvas" {
    assert(sats(0) == 3);
    assert(sats(5) == 5);
    assert(sats(30) == 9);
    var t : usize = 0;
    while (t < 27) {
        var i : i32 = 0;
        while (i < 9) {
            assert(sat_x(t, i, 9) > 20 && sat_x(t, i, 9) < 340);
            assert(sat_y(t, i, 9) > 100 && sat_y(t, i, 9) < 560);
            i = i + 1;
        }
        t = t + 1;
    }
}

test "the wheel is the lesson's: another lesson draws another wheel" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = links_px(18, 0x3B82F6, 4, x, y);
            const b = links_px(24, 0x3B82F6, 4, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "more edges draw more boxes" {
    // count box-border pixels (the accent) along the wheel for 3 and 9 neighbours
    var few : i32 = 0;
    var many : i32 = 0;
    var y : i32 = 100;
    while (y < 560) {
        var x : i32 = 20;
        while (x < 340) {
            if (links_px(18, 0x3B82F6, 3, x, y) == 0x3B82F6) { few = few + 1; }
            if (links_px(18, 0x3B82F6, 9, x, y) == 0x3B82F6) { many = many + 1; }
            x = x + 2;
        }
        y = y + 2;
    }
    assert(many > few);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (links_px(10, 0xF5B700, 5, x, y) != links_px(10, 0xF5B700, 5, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
