// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_slice.t27 -- end-to-end vertical slice: graph IR -> validate -> layout -> hit -> source.
; Ring 2, Wave D1 of epic #13650.
; Pipeline exercised:
;   1. Build a NetlistGraph (inverter fixture = proxy for a real parsed deck).
;   2. validate_graph(g) == NGRAPH_OK.
;   3. nv_layout(g) -> NvPlan with pixel coords.
;   4. nv_hit(p, px, py) -> node index (element selection).
;   5. g.node_line[i] -> source location (traceability).
;   6. nv_text_r/g/b(g.node_label[i]) -> inference label color.
; This slice is renderer-neutral: numbers only, no host.
; Does not define a second graph model or new color constant.
; Refs #13650, #13711, #13716.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_slice;

use t27f::netlist_graph::{NetlistGraph, NGRAPH_OK, NG_LABEL_EXACT, validate_graph, inverter_graph};
use t27f::netlist_view::{NvPlan, NV_COL_STRIDE, NV_ROW_STRIDE, NV_NODE_W, NV_NODE_H, NV_COL_PAD, NV_ROW_PAD, nv_layout, nv_node_x, nv_node_y, nv_text_r, nv_text_g, nv_text_b};

; ── Hit test ─────────────────────────────────────────────────────────────────
; Returns the index of the first node whose bounding box contains (px, py).
; Returns node_count when no node is hit (sentinel = "no hit").
pub fn nv_hit(p: NvPlan, g: NetlistGraph, px: u32, py: u32) -> u32 {
    var i : u32 = 0;
    while (i < p.node_count) {
        let x : u32 = nv_node_x(p, i);
        let y : u32 = nv_node_y(p, i);
        if (px >= x and px < x + NV_NODE_W and py >= y and py < y + NV_NODE_H) {
            return i;
        }
        i = i + 1;
    }
    return p.node_count;
}

; ── Source location lookup ────────────────────────────────────────────────────
; Returns the 1-based source line of node i, or 0 when i is out of range.
pub fn nv_node_source_line(g: NetlistGraph, i: u32) -> u32 {
    if (i >= g.node_count) { return 0; }
    return g.node_line[i as usize];
}

; ── Full-pipeline helper: build -> validate -> layout ─────────────────────────
pub fn nv_inverter_plan() -> NvPlan {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    return p;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

; Step 1-2: IR is valid.
test inverter_graph_validates {
    let g : NetlistGraph = inverter_graph();
    assert validate_graph(g) == NGRAPH_OK;
}

; Step 3: layout maps the inverter's 5 nodes.
test inverter_plan_node_count {
    let p : NvPlan = nv_inverter_plan();
    assert p.node_count == 5;
}

; Step 3: BLOCK node (index 0) lands at pixel (NV_COL_PAD, NV_ROW_PAD).
test block_node_pixel_coords {
    let p : NvPlan = nv_inverter_plan();
    assert nv_node_x(p, 0) == NV_COL_PAD;
    assert nv_node_y(p, 0) == NV_ROW_PAD;
}

; Step 4: click inside the BLOCK node hits index 0.
test click_inside_block_hits_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let px : u32 = NV_COL_PAD + 4;
    let py : u32 = NV_ROW_PAD + 4;
    assert nv_hit(p, g, px, py) == 0;
}

; Step 4: click outside all nodes returns node_count (no hit).
test click_outside_returns_no_hit {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    assert nv_hit(p, g, 0, 0) == g.node_count;
}

; Step 5: source line of BLOCK node (inv, line 1 in fixture).
test block_node_source_line {
    let g : NetlistGraph = inverter_graph();
    assert nv_node_source_line(g, 0) == 1;
}

; Step 5: out-of-range index returns 0.
test out_of_range_source_line_zero {
    let g : NetlistGraph = inverter_graph();
    assert nv_node_source_line(g, 99) == 0;
}

; Step 6: label color pipeline -- EXACT node uses text color.
test exact_node_label_color {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let i : u32 = nv_hit(p, g, NV_COL_PAD + 4, NV_ROW_PAD + 4);
    assert i == 0;
    let lbl : u8 = g.node_label[i as usize];
    assert lbl == NG_LABEL_EXACT;
    assert nv_text_r(lbl) > 0.9;
    assert nv_text_g(lbl) > 0.9;
    assert nv_text_b(lbl) > 0.9;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant no_hit_sentinel_is_node_count {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    assert nv_hit(p, g, 0, 0) == p.node_count;
}

invariant node_w_fits_col_stride {
    assert NV_NODE_W < NV_COL_STRIDE;
}

invariant node_h_fits_row_stride {
    assert NV_NODE_H < NV_ROW_STRIDE;
}
