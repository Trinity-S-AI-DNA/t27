// SPDX-License-Identifier: Apache-2.0
; T27F UI history, the log of steps (Refs gHashTag/t27#13214, epic #13214)
; One line per step, in order. Append-only: a new step adds one case to ul_step and raises UL_COUNT, and no existing step is edited or
;   reordered. ul_log_ok checks that every step passes uh_validate, that seq runs 1, 2, 3 without a gap or a repeat, and that no step_id
;   repeats. The tests pin the id of step 1, so a rewrite of it shows up in the diff of this file as well as in the diff of its own spec
; ASCII only (L3)

module T27fUiHistoryLog;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::uh_next_seq_ok;
use t27f::ui_history::uh_list_ok;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_CAP;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;
use t27f::ui_history_s01::us1_step;
use t27f::ui_history_s01::US1_ID;
use t27f::ui_history_s02::us2_step;
use t27f::ui_history_s02::US2_ID;
use t27f::ui_history_s03::us3_step;
use t27f::ui_history_s03::US3_ID;
use t27f::ui_history_s04::us4_step;
use t27f::ui_history_s04::US4_ID;

pub const UL_COUNT : u32 = 4;

; step i, 0-based; an index past the log is a record that fails uh_validate (seq 0)
pub fn ul_step(i: u32) -> UiStep {
    if i == 0 {
        return us1_step();
    }
    if i == 1 {
        return us2_step();
    }
    if i == 2 {
        return us3_step();
    }
    if i == 3 {
        return us4_step();
    }
    var none : UiStep = us1_step();
    none.seq = 0;
    return none;
}

pub fn ul_ids() -> [12]str {
    var ids : [12]str = ["", "", "", "", "", "", "", "", "", "", "", ""];
    var i : u32 = 0;
    while i < UL_COUNT {
        let st : UiStep = ul_step(i);
        ids[i] = st.step_id;
        i = i + 1;
    }
    return ids;
}

; 0 when the log holds every rule, else 1 + the index of the first step that breaks one
pub fn ul_first_bad() -> u32 {
    if UL_COUNT > UH_CAP {
        return 1;
    }
    var prev : u32 = 0;
    var i : u32 = 0;
    while i < UL_COUNT {
        let st : UiStep = ul_step(i);
        if uh_validate(st) != UH_OK {
            return i + 1;
        }
        if uh_next_seq_ok(prev, st.seq) == false {
            return i + 1;
        }
        prev = st.seq;
        i = i + 1;
    }
    if uh_list_ok(ul_ids(), UL_COUNT) == false {
        return UL_COUNT;
    }
    return 0;
}

test the_log_holds_every_rule {
    assert ul_first_bad() == 0;
    assert UL_COUNT == 4;
}

test step_one_is_first_and_unreviewed {
    let st : UiStep = ul_step(0);
    assert st.seq == 1;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    let id : str = st.step_id;
    let want : str = US1_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-01";
}

test step_two_is_second_and_unreviewed {
    let st : UiStep = ul_step(1);
    assert st.seq == 2;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    let id : str = st.step_id;
    let want : str = US2_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-02";
}

test step_three_is_third_and_unreviewed {
    let st : UiStep = ul_step(2);
    assert st.seq == 3;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    let id : str = st.step_id;
    let want : str = US3_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-03";
}

test step_four_is_fourth_and_unreviewed {
    let st : UiStep = ul_step(3);
    assert st.seq == 4;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    let id : str = st.step_id;
    let want : str = US4_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-04";
}

test a_step_past_the_log_is_refused {
    let st : UiStep = ul_step(4);
    assert st.seq == 0;
    assert uh_validate(st) != UH_OK;
}

test the_ids_list_matches_the_log {
    var ids : [12]str = ul_ids();
    let first : str = ids[0];
    assert first == "ui-2026-11-07-step-01";
    let second : str = ids[1];
    assert second == "ui-2026-11-07-step-02";
    let third : str = ids[2];
    assert third == "ui-2026-11-07-step-03";
    let fourth : str = ids[3];
    assert fourth == "ui-2026-11-07-step-04";
    let fifth : str = ids[4];
    assert fifth == "";
}
