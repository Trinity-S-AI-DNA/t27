// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_guard.t27 -- scene A_GUARD of reel_factory.t27: a dial of 24 ticks round a big
// number. The number is the lesson's count of asserts and invariants; the ticks lit in the accent
// are three for each of them, up to 23, the rest stay dim.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: an assert is a guard, and a guard is a thing that is either holding or not. A dial with more
// lit ticks is a lesson with more guards, so a lesson that teaches three checks and one that
// teaches none do not draw the same dial.
//
// THE FUNCTION: guard_px(t, acc, n, x, y) is the colour of canvas point (x, y). Centre (180, 320),
// ticks on a circle of radius 138, the number in the middle at scale 10.
//
// NOT CLAIMED: the dial does not run the asserts; it counts them.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_guard;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_disc;
use t27f::scene_raster::in_ring;
use t27f::scene_raster::num_on;
use t27f::scene_raster::clamp;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_bg::cos24;
use t27f::scene_bg::sin24;

pub const GX : i32 = 180;
pub const GY : i32 = 320;
pub const DIAL : i32 = 138;
pub const TICKS : i32 = 24;
pub const DIM_TICK : i32 = 0x39426B;

// How many of the 24 ticks are lit for a lesson that counts n guards.
pub fn lit_ticks(n: i32) -> i32 {
    return clamp(n * 3, 3, 23);
}
pub fn digits_of(v: i32) -> i32 {
    var d : i32 = 1;
    var w = v;
    while (w >= 10) {
        w = @divTrunc(w, 10);
        d = d + 1;
    }
    return d;
}
pub fn tick_x(k: i32) -> i32 {
    return GX + @divTrunc(DIAL * cos24(k), 1000);
}
pub fn tick_y(k: i32) -> i32 {
    return GY + @divTrunc(DIAL * sin24(k), 1000);
}

pub fn guard_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(2, acc, seed_of(t, n, 8), x, y);
    // the number in the middle: white, on a dark plate
    const dg = digits_of(n);
    const ox = GX + 5 - dg * 20;
    if (num_on(n, x, y, ox, GY - 25, 10)) { return rgb(245, 245, 245); }
    if (in_disc(x, y, GX, GY, 96)) {
        if (in_ring(x, y, GX, GY, 94, 96)) { return acc; }
        return mix(rgb(8, 10, 22), acc, 18);
    }
    if (!in_ring(x, y, GX, GY, 126, 152)) { return c0; }
    const lit = lit_ticks(n);
    var k : i32 = 0;
    while (k < TICKS) {
        if (in_disc(x, y, tick_x(k), tick_y(k), 9)) {
            if (k < lit) { return acc; }
            return DIM_TICK;
        }
        k = k + 1;
    }
    return c0;
}

// ---- tests ----

test "three ticks a guard, between 3 and 23" {
    assert(lit_ticks(0) == 3);
    assert(lit_ticks(4) == 12);
    assert(lit_ticks(30) == 23);
    assert(digits_of(0) == 1);
    assert(digits_of(9) == 1);
    assert(digits_of(10) == 2);
    assert(digits_of(123) == 3);
}

test "the ticks stand on the canvas" {
    var k : i32 = 0;
    while (k < TICKS) {
        assert(tick_x(k) > 10 && tick_x(k) < 350);
        assert(tick_y(k) > 150 && tick_y(k) < 490);
        k = k + 1;
    }
}

test "more guards light more of the dial" {
    var few : i32 = 0;
    var many : i32 = 0;
    var y : i32 = 160;
    while (y < 480) {
        var x : i32 = 30;
        while (x < 330) {
            if (guard_px(13, 0x3B82F6, 2, x, y) == 0x3B82F6) { few = few + 1; }
            if (guard_px(13, 0x3B82F6, 7, x, y) == 0x3B82F6) { many = many + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(many > few);
    assert(few > 0);
}

test "the number is on the plate and another lesson draws another dial" {
    var white : i32 = 0;
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = guard_px(8, 0xF5B700, 5, x, y);
            const b = guard_px(21, 0xF5B700, 5, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a == 0xF5F5F5) { white = white + 1; }
            if (a != b) { diff = diff + 1; }
            x = x + 2;
        }
        y = y + 2;
    }
    assert(white > 50);
    assert(diff > 5000);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (guard_px(3, 0x22C55E, 3, x, y) != guard_px(3, 0x22C55E, 3, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
