// specs/t27f/ui_kit_header.t27 -- ui-kit: header cluster object, compose header
// from ui kit, add header button.
// Part of M7 milestone (milestone #11). Closes #13760, #13750, #13748.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::ui_kit_header;

pub const UI_KIT_HEADER_MAX_BUTTONS : u32 = 16;

pub struct HeaderButton { label: str, active: bool };

pub struct HeaderCluster { buttons: [16]HeaderButton, button_count: u32 };

pub fn header_button_active(b: HeaderButton) -> bool {
    return b.active;
}

pub fn header_cluster_button_count(c: HeaderCluster) -> u32 {
    return c.button_count;
}

test "header_button_active" {
    assert(header_button_active(HeaderButton { label: "Home", active: true }));
    assert(!header_button_active(HeaderButton { label: "Settings", active: false }));
}

test "header_cluster_button_count" {
    var c = HeaderCluster { buttons: [_]HeaderButton{ HeaderButton{ label: "", active: false } } ** 16, button_count: 3 };
    assert(header_cluster_button_count(c) == 3);
}

invariant ui_kit_header_max_buttons_positive {
    assert UI_KIT_HEADER_MAX_BUTTONS > 0;
}