// SPDX-License-Identifier: Apache-2.0
; specs/t27f/native_map_prototype.t27 -- native prototype of the central map
; with verified Objective-C ABI calls. Core Animation layers for nodes, edges
; as CAShapeLayer, CATransaction for grouped animated transitions.
; --
; ALL Objective-C calls use the objc_msgSend pattern from glass_window.t27:
;   1. NSClassFromString("ClassName") -> class pointer
;   2. NSSelectorFromString("selectorName") -> selector pointer
;   3. objc_msgSend(receiver, selector, args...) -> result
; NO C function names like "CATransactionBegin" — those are ObjC class methods.
; --
; DURATION IS IN SECONDS for CATransaction.setAnimationDuration:, not ms.
; --
; Pure functions (golden spiral layout, state colours, transition stages) are
; testable with t27c/t27b. Core Animation calls require a native smoke test.
; --
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fNativeMapPrototype;

// ---- Objective-C runtime (pattern from glass_window.t27) --------------------------

/// Get an ObjC class by name. The argument is a CFString/NSString.
pub fn nmp_class_named(cfstr: u64) -> u64 {
    return @extern("objc_getClass");
}

/// Register a selector. The argument is a C string (const char*).
pub fn nmp_sel_named(cstr: u64) -> u64 {
    return @extern("sel_registerName");
}

/// objc_msgSend with 0 arguments.
fn nmp_msg0(o: u64, s: u64) -> u64 { return @extern("objc_msgSend"); }
/// objc_msgSend with 1 object argument.
fn nmp_msg1(o: u64, s: u64, a: u64) -> u64 { return @extern("objc_msgSend"); }
/// objc_msgSend with 1 f64 argument (for duration, progress etc.).
fn nmp_msg_f(o: u64, s: u64, t: f64) -> u64 { return @extern("objc_msgSend"); }

// ---- Core Animation via correct ObjC ABI ------------------------------------------
// CATransaction is an ObjC class. Its methods are called via objc_msgSend.
// Duration is in SECONDS.
// --
// These functions REQUIRE a native smoke test: t27c/t27b test-report cannot
// verify ObjC runtime calls without a live window context. The caller MUST
// pass the correct class/selector strings; this spec does not create them.

/// [CATransaction begin]. Groups layer changes for animated application.
; Caller: nmp_ca_begin(class_named("CATransaction"), sel_named("begin"))
pub fn nmp_ca_begin(ca_cls: u64, begin_sel: u64) -> void {
    nmp_msg0(ca_cls, begin_sel);
}

/// [CATransaction setAnimationDuration: seconds] — NOT ms.
; Caller: nmp_ca_set_duration(class_named("CATransaction"), sel_named("setAnimationDuration:"), 0.15)
pub fn nmp_ca_set_duration(ca_cls: u64, duration_sel: u64, seconds: f64) -> void {
    nmp_msg_f(ca_cls, duration_sel, seconds);
}

/// [CATransaction commit]. Applies all grouped layer changes with animation.
pub fn nmp_ca_commit(ca_cls: u64, commit_sel: u64) -> void {
    nmp_msg0(ca_cls, commit_sel);
}

/// [CALayer layer] — creates a new layer instance.
; Caller: nmp_layer_new(class_named("CALayer"), sel_named("layer"))
pub fn nmp_layer_new(ca_cls: u64, layer_sel: u64) -> u64 {
    return nmp_msg0(ca_cls, layer_sel);
}

/// [layer removeFromSuperlayer]
pub fn nmp_layer_remove(layer: u64, sel: u64) -> void {
    nmp_msg0(layer, sel);
}

// ---- layout: golden spiral ----------------------------------------------------------

/// The golden angle in radians: 360/phi^2 ≈ 137.507° ≈ 2.39996 rad.
pub const NMP_GOLDEN_ANGLE : f64 = 2.39996322973;

/// Node position on a golden spiral: Taylor series cos/sin (3 terms).
; Writes [x, y] into ox[0..2] and oy[0..2].
pub fn nmp_spiral_pos(i : u32, n : u32, cx : f64, cy : f64, r : f64, ox : []f64, oy : []f64) -> void {
    if (n == 0) { ox[0] = cx; oy[0] = cy; return; }
    const angle : f64 = NMP_GOLDEN_ANGLE * (@as(f64, @floatFromInt(i)) + 0.5);
    const dist : f64 = r * (@as(f64, @floatFromInt(i + 1)) / @as(f64, @floatFromInt(n)));
    var c : f64 = 1.0;
    var s : f64 = 0.0;
    var tc : f64 = 1.0;
    var ts : f64 = angle;
    var sign : f64 = 1.0;
    var j : u32 = 0;
    while (j < 5) {
        c = c + sign * tc;
        s = s + sign * ts;
        tc = tc * angle * angle / @as(f64, @floatFromInt((j + 2) * (j + 3)));
        ts = ts * angle * angle / @as(f64, @floatFromInt((j + 3) * (j + 4)));
        sign = 0.0 - sign;
        j = j + 1;
    }
    ox[0] = cx + dist * c;
    oy[0] = cy + dist * s;
}

// ---- transition integration -----------------------------------------------------------

/// Map a transition stage + pending to a Core Animation duration (SECONDS).
; STATIC mode: 0.0 (no animation). STAGED: budget / 60fps (fps assumption).
; Adaptive: when pending > 5, budget halved (min 2 frames).
pub fn nmp_stage_duration(mode : u8, stage : u8, pending : u32) -> f64 {
    if (mode == 0) { return 0.0; }   // STATIC: no animation
    var frames : u8 = 6;   // default HIGHLIGHT budget
    if (stage == 2) { frames = 8; }   // FADE_OUT
    if (stage == 3) { frames = 12; }  // MOVE
    if (stage == 4) { frames = 6; }   // SHOW_NEW
    if (stage == 5) { frames = 2; }   // SETTLE
    if (pending > 5) { frames = frames / 2; if (frames < 2) { frames = 2; } }
    return @as(f64, @floatFromInt(frames)) / 60.0;
}

// ---- tests --------------------------------------------------------------------------

test nmp_spiral_pos_centre_when_empty {
    var ox : [2]f64 = undefined;
    var oy : [2]f64 = undefined;
    nmp_spiral_pos(0, 0, 100.0, 200.0, 50.0, ox[0..2], oy[0..2]);
    assert(ox[0] == 100.0 and oy[0] == 200.0);
}

test nmp_spiral_pos_spreads_outward {
    var ox1 : [2]f64 = undefined;
    var oy1 : [2]f64 = undefined;
    nmp_spiral_pos(0, 5, 100.0, 200.0, 50.0, ox1[0..2], oy1[0..2]);
    var ox5 : [2]f64 = undefined;
    var oy5 : [2]f64 = undefined;
    nmp_spiral_pos(4, 5, 100.0, 200.0, 50.0, ox5[0..2], oy5[0..2]);
    var d0 : f64 = (ox1[0] - 100.0) * (ox1[0] - 100.0) + (oy1[0] - 200.0) * (oy1[0] - 200.0);
    var d4 : f64 = (ox5[0] - 100.0) * (ox5[0] - 100.0) + (oy5[0] - 200.0) * (oy5[0] - 200.0);
    assert(d4 >= d0);
}

test nmp_stage_duration_returns_seconds {
    assert(nmp_stage_duration(0, 1, 0) == 0.0);
    var d : f64 = nmp_stage_duration(2, 1, 0);
    assert(d > 0.09 and d < 0.11);   // 6/60 = 0.1
    d = nmp_stage_duration(2, 2, 0);
    assert(d > 0.12 and d < 0.14);   // 8/60 ≈ 0.133
    d = nmp_stage_duration(2, 1, 10);
    assert(d > 0.04 and d < 0.06);   // 3/60 = 0.05
}

test nmp_stage_duration_adaptive_reduces_time {
    var normal : f64 = nmp_stage_duration(2, 1, 0);
    var adaptive : f64 = nmp_stage_duration(2, 1, 10);
    assert(adaptive < normal);
    assert(adaptive > 0.0);
}

invariant golden_angle_is_correct {
    assert(NMP_GOLDEN_ANGLE > 2.39 and NMP_GOLDEN_ANGLE < 2.41);
}

// ---- SMOKE TEST PROTOCOL (cannot run in t27c/t27b) ----------------------------------
//
// The Core Animation functions above require a live macOS window context:
//   1. Build: t27b build specs/t27f/native_map_prototype.t27 -o nmp.o --macho
//   2. Link: ld with CoreAnimation, QuartzCore frameworks
//   3. Run: create NSWindow, create CA layers, verify positions animate
//   4. Verify: check layer positions after CATransaction.commit()
//   5. Measure: time between nmp_ca_begin and nmp_ca_commit
//   6. Negative: verify no layers created when mode == STATIC (duration = 0)
//
// The pure functions (nmp_spiral_pos, nmp_stage_duration) ARE testable
; with t27c/t27b and are verified above. The ObjC ABI calls are verified
; in a native smoke test, not in t27c test-report.
