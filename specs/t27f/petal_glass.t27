// SPDX-License-Identifier: Apache-2.0
; T27F petal glass -- the T27 OS home drawn the way the trios app draws it, every pixel from this spec.
; What it draws, layer by layer, and where each number comes from:
;   G1 desktop  -- what sits behind the window. Unknown to trios, so a SUGGESTED blue-violet gradient.
;   G2 material -- trios TriosVisualTheme.blackGlass: backdrop blur + black tint 0.30 (EXACT). Over a
;                  smooth gradient a blur changes nothing, so only the tint is drawn.
;   G3 wash     -- UnifiedTriosGlassBackground darkWash: LinearGradient topLeading -> bottomTrailing,
;                  black at windowWashOpacity 0.42, clear, black at 0.42 x 0.7 (EXACT stops).
;   G4 blooms   -- ambientBloomOpacity 0.055; green / pink / blue circles, size max(360, 0.62 w),
;                  scale 1 / 0.82 / 0.72, opacity x1 / x0.8 / x0.45, blur 110 / 120 / 125, offsets
;                  (0.38w, 0.08h) / (0.68w, -0.12h) / (-0.16w, 0.64h) (EXACT). The blur edge profile is a
;                  logistic of width 0.3 x blur (DERIVED: a gaussian of sigma blur/2, approximated).
;   G5 border   -- 0.5 px white 0.14 at the window edge (EXACT).
;   P  petals   -- geometry, fit 0.63, fills (idle black 0.22, hover white, open = realm colour) and the
;                  1 px white outline all come from petal_menu.t27 (module T27fPetalMenu); none is copied.
;                  Edges are anti-aliased by a signed distance to the quad (DERIVED; the test
;                  the_distance_agrees_with_the_ray_cast checks it against petal_menu's own hit test).
;   A  assembly -- photon_trinity_canvas.zig LogoAnimation: every block starts 800 SVG units out along
;                  centre -> its centroid; phase 1 (progress < 0.7 of 2.5 s) off -= off * 4.5 dt and
;                  v = -0.4 off; phase 2 spring k 28, damping 0.86, off += v dt 60 (EXACT, at dt 1/30).
;   M  menu     -- g_wave_transition: alpha 0 -> 1 at dt x 3, so 10 frames at 30 fps (EXACT). The panel is
;                  blackGlass surfaceBlack 0.46, highlightWhite 0.08, border white 0.14 (EXACT values);
;                  its size, 24 px lift and the card look (white 0.06 fill, 0.10 edge) are SUGGESTED.
;                  It holds petal_menu's 3 x 3 card slots, empty in the MVP (card_count is 0).
;   S  scenario -- 9 s: assembly, a cursor sweep with hover, a tap on petal 13 (MATERIYA), the menu
;                  fades in, holds, back, the menu fades out, the cursor leaves.
; Output: main prints 270 raw RGB24 frames of 960 x 540 to stderr, nothing else, for
;   ffmpeg -f rawvideo -pix_fmt rgb24 -s 960x540 -r 30 -i - out.mp4
; Recipe as in why_card.t27: t27c gen this file into a .zig, zig build-exe -lc, run, pipe stderr.
; Epic gHashTag/t27#10782.

module T27fPetalGlass;

use t27f::petal_menu::QX;
use t27f::petal_menu::QY;
use t27f::petal_menu::BOX_CX;
use t27f::petal_menu::BOX_CY;
use t27f::petal_menu::PETAL_COUNT;
use t27f::petal_menu::PETAL_NONE;
use t27f::petal_menu::STATE_HOME;
use t27f::petal_menu::CARD_SLOTS;
use t27f::petal_menu::CARD_GAP_PX;
use t27f::petal_menu::OUTLINE_PX;
use t27f::petal_menu::IDLE_ALPHA;
use t27f::petal_menu::inside;
use t27f::petal_menu::fit_permille;
use t27f::petal_menu::to_box;
use t27f::petal_menu::hit_px;
use t27f::petal_menu::fill;
use t27f::petal_menu::outline;
use t27f::petal_menu::on_tap;
use t27f::petal_menu::on_back;
use t27f::petal_menu::card_count;
use t27f::petal_menu::card_x;
use t27f::petal_menu::card_y;
use t27f::reel_particles::quantize;

// ---- frame ----

pub const W_PX : u32 = 960;
pub const H_PX : u32 = 540;
pub const WF : f64 = 960.0;
pub const HF : f64 = 540.0;
pub const FPS : u32 = 30;
pub const DT : f64 = 0.0333333333333333;
pub const FRAMES : u32 = 270;

// ---- G1 desktop (suggested) ----

pub const DESK_TOP : [3]f64 = [0.16, 0.20, 0.36];
pub const DESK_BOT : [3]f64 = [0.32, 0.17, 0.32];

// ---- G2..G5 glass (trios TriosVisualTheme / UnifiedTriosGlassBackground) ----

pub const TINT_BLACK : f64 = 0.30;
pub const WASH : f64 = 0.42;
pub const WASH_END : f64 = 0.7;
pub const BLOOM_OP : f64 = 0.055;
pub const BLOOM_MIN : f64 = 360.0;
pub const BLOOM_W : f64 = 0.62;
pub const BLOOM_SOFT : f64 = 0.3;
pub const BLOOM_RGB : [9]f64 = [0.18, 0.68, 0.34, 0.75, 0.34, 0.48, 0.30, 0.46, 0.75];
pub const BLOOM_K : [3]f64 = [1.0, 0.8, 0.45];
pub const BLOOM_SIZE_K : [3]f64 = [1.0, 0.82, 0.72];
pub const BLOOM_BLUR : [3]f64 = [110.0, 120.0, 125.0];
pub const BORDER_WHITE : f64 = 0.14;
pub const BORDER_PX : f64 = 0.5;
pub const SURFACE_BLACK : f64 = 0.46;
pub const HIGHLIGHT_WHITE : f64 = 0.08;

// ---- A assembly (LogoAnimation) ----

pub const ANIM_DURATION : f64 = 2.5;
pub const START_OFF : f64 = 800.0;
pub const PHASE1_END : f64 = 0.7;
pub const PHASE1_RATE : f64 = 4.5;
pub const V_HANDOFF : f64 = 0.4;
pub const SPRING_K : f64 = 28.0;
pub const SPRING_DAMP : f64 = 0.86;
pub const TAU : f64 = 6.28318530717958647;

// ---- M menu ----

pub const WAVE_RATE : f64 = 3.0;
pub const PANEL_W_PX : i64 = 600;
pub const PANEL_H_PX : i64 = 360;
pub const PANEL_R : f64 = 18.0;
pub const PANEL_LIFT : f64 = 24.0;
pub const CARD_R : f64 = 12.0;
pub const CARD_FILL : f64 = 0.06;
pub const CARD_EDGE : f64 = 0.10;
pub const HEADER_PX : f64 = 3.0;

// ---- S scenario ----

pub const CURSOR_IN : u32 = 75;
pub const SWEEP_B : u32 = 100;
pub const SWEEP_C : u32 = 120;
pub const TAP_FRAME : u32 = 135;
pub const BACK_FRAME : u32 = 220;
pub const LEAVE_END : u32 = 260;
pub const TAP_PETAL : u32 = 13;

// ---- small math ----

pub fn clamp01(x: f64) -> f64 {
    if (x < 0.0) { return 0.0; }
    if (x > 1.0) { return 1.0; }
    return x;
}

pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t;
}

pub fn ease(t: f64) -> f64 {
    const u = clamp01(t);
    return u * u * (3.0 - 2.0 * u);
}

pub fn logistic(z: f64) -> f64 {
    if (z > 40.0) { return 0.0; }
    return 1.0 / (1.0 + @exp(z));
}

pub fn fmax(a: f64, b: f64) -> f64 {
    if (a > b) { return a; }
    return b;
}

pub fn fmin(a: f64, b: f64) -> f64 {
    if (a < b) { return a; }
    return b;
}

/// Channel k of a 0xAARRGGBB value in 0..1: 0 red, 1 green, 2 blue, 3 alpha.
pub fn chan(c: u32, k: u32) -> f64 {
    var v : u32 = c % 256;
    if (k == 3) { v = c / 16777216; }
    if (k == 0) { v = (c / 65536) % 256; }
    if (k == 1) { v = (c / 256) % 256; }
    return @as(f64, @floatFromInt(v)) / 255.0;
}

// ---- G glass background ----

/// G3. The darkWash opacity at gradient position t (0 top-left, 1 bottom-right).
pub fn wash(t: f64) -> f64 {
    if (t < 0.5) {
        return WASH * (1.0 - 2.0 * t);
    }
    return WASH * WASH_END * (2.0 * t - 1.0);
}

/// G3. SwiftUI's unit-space projection of a pixel on the topLeading -> bottomTrailing line.
pub fn wash_t(x: f64, y: f64) -> f64 {
    return clamp01((x * WF + y * HF) / (WF * WF + HF * HF));
}

pub fn bloom_size(w: f64) -> f64 {
    return fmax(BLOOM_MIN, BLOOM_W * w);
}

pub fn bloom_ox(k: u32) -> f64 {
    if (k == 0) { return 0.38; }
    if (k == 1) { return 0.68; }
    return 0.0 - 0.16;
}

pub fn bloom_oy(k: u32) -> f64 {
    if (k == 0) { return 0.08; }
    if (k == 1) { return 0.0 - 0.12; }
    return 0.64;
}

/// G1..G5. Channel ch of the glass window at pixel centre (x, y).
pub fn glass(ch: u32, x: f64, y: f64) -> f64 {
    var c : f64 = lerp(DESK_TOP[ch], DESK_BOT[ch], y / HF);
    c = c * (1.0 - TINT_BLACK);
    c = c * (1.0 - wash(wash_t(x, y)));
    const size = bloom_size(WF);
    var k : u32 = 0;
    while (k < 3) {
        const bx = 0.5 * WF + bloom_ox(k) * WF;
        const by = 0.5 * HF + bloom_oy(k) * HF;
        const d = @sqrt((x - bx) * (x - bx) + (y - by) * (y - by));
        const r = 0.5 * size * BLOOM_SIZE_K[k];
        const a = BLOOM_OP * BLOOM_K[k] * logistic((d - r) / (BLOOM_SOFT * BLOOM_BLUR[k]));
        c = c * (1.0 - a) + BLOOM_RGB[k * 3 + ch] * a;
        k = k + 1;
    }
    const e = fmin(fmin(x, WF - x), fmin(y, HF - y));
    const ba = BORDER_WHITE * clamp01(BORDER_PX - (e - 0.5));
    return c * (1.0 - ba) + ba;
}

// ---- P petal geometry in pixels ----

pub fn scale() -> f64 {
    return @as(f64, @floatFromInt(fit_permille(960, 540))) / 1000.0;
}

pub fn cen_x(p: u32) -> f64 {
    var s : i64 = 0;
    var v : u32 = 0;
    while (v < 4) { s = s + QX[p * 4 + v]; v = v + 1; }
    return @as(f64, @floatFromInt(s)) / 4.0;
}

pub fn cen_y(p: u32) -> f64 {
    var s : i64 = 0;
    var v : u32 = 0;
    while (v < 4) { s = s + QY[p * 4 + v]; v = v + 1; }
    return @as(f64, @floatFromInt(s)) / 4.0;
}

/// A. The unit direction a block flies in from: SVG centre -> its centroid, or i TAU / 27 when the
/// centroid sits on the centre (length <= 0.1 unit = 100 milli-units).
pub fn dir_x(p: u32) -> f64 {
    const dx = cen_x(p) - @as(f64, @floatFromInt(BOX_CX));
    const dy = cen_y(p) - @as(f64, @floatFromInt(BOX_CY));
    const len = @sqrt(dx * dx + dy * dy);
    if (len <= 100.0) {
        return @cos(@as(f64, @floatFromInt(p)) * TAU / 27.0);
    }
    return dx / len;
}

pub fn dir_y(p: u32) -> f64 {
    const dx = cen_x(p) - @as(f64, @floatFromInt(BOX_CX));
    const dy = cen_y(p) - @as(f64, @floatFromInt(BOX_CY));
    const len = @sqrt(dx * dx + dy * dy);
    if (len <= 100.0) {
        return @sin(@as(f64, @floatFromInt(p)) * TAU / 27.0);
    }
    return dy / len;
}

/// A box coordinate in milli-units to a viewport pixel, on the x or y axis.
pub fn to_px_x(mx: f64, s: f64) -> f64 {
    return 0.5 * WF + (mx - @as(f64, @floatFromInt(BOX_CX))) / 1000.0 * s;
}

pub fn to_px_y(my: f64, s: f64) -> f64 {
    return 0.5 * HF + (my - @as(f64, @floatFromInt(BOX_CY))) / 1000.0 * s;
}

/// Signed distance from (px, py) to the line a -> b, positive on the side away from (cx, cy).
pub fn edge_d(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, px: f64, py: f64) -> f64 {
    const ex = bx - ax;
    const ey = by - ay;
    const len = @sqrt(ex * ex + ey * ey);
    if (len < 0.000001) {
        return 0.0 - 1000000000.0;
    }
    const nx = ey / len;
    const ny = (0.0 - ex) / len;
    const d = (px - ax) * nx + (py - ay) * ny;
    if ((cx - ax) * nx + (cy - ay) * ny > 0.0) {
        return 0.0 - d;
    }
    return d;
}

/// Signed distance to a convex quad: negative inside, about one unit per unit outside an edge.
pub fn quad_sd(x0: f64, y0: f64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64, px: f64, py: f64) -> f64 {
    const cx = 0.25 * (x0 + x1 + x2 + x3);
    const cy = 0.25 * (y0 + y1 + y2 + y3);
    var d : f64 = edge_d(x0, y0, x1, y1, cx, cy, px, py);
    d = fmax(d, edge_d(x1, y1, x2, y2, cx, cy, px, py));
    d = fmax(d, edge_d(x2, y2, x3, y3, cx, cy, px, py));
    d = fmax(d, edge_d(x3, y3, x0, y0, cx, cy, px, py));
    return d;
}

/// Petal p's signed distance in box milli-units, unmoved -- the form the test compares with inside().
pub fn petal_sd_box(p: u32, mx: f64, my: f64) -> f64 {
    const i = p * 4;
    return quad_sd(@as(f64, @floatFromInt(QX[i])), @as(f64, @floatFromInt(QY[i])),
        @as(f64, @floatFromInt(QX[i + 1])), @as(f64, @floatFromInt(QY[i + 1])),
        @as(f64, @floatFromInt(QX[i + 2])), @as(f64, @floatFromInt(QY[i + 2])),
        @as(f64, @floatFromInt(QX[i + 3])), @as(f64, @floatFromInt(QY[i + 3])), mx, my);
}

// ---- A assembly ----

/// A. How far (SVG units) every block still is from home after `frame` updates at 30 fps.
pub fn anim_off(frame: u32) -> f64 {
    var off : f64 = START_OFF;
    var v : f64 = 0.0;
    var f : u32 = 0;
    while (f < frame) {
        const t = @as(f64, @floatFromInt(f)) * DT;
        if (t / ANIM_DURATION < PHASE1_END) {
            off = off - off * PHASE1_RATE * DT;
            v = 0.0 - off * V_HANDOFF;
        } else {
            v = v + (0.0 - off) * SPRING_K * DT;
            v = v * SPRING_DAMP;
            off = off + v * DT * 60.0;
        }
        f = f + 1;
    }
    return off;
}

// ---- S scenario ----

pub fn tap_x() -> f64 {
    return to_px_x(cen_x(TAP_PETAL), scale());
}

pub fn tap_y() -> f64 {
    return to_px_y(cen_y(TAP_PETAL), scale());
}

fn seg(f: u32, f0: u32, f1: u32) -> f64 {
    return ease(@as(f64, @floatFromInt(f - f0)) / @as(f64, @floatFromInt(f1 - f0)));
}

pub fn cursor_x(f: u32) -> f64 {
    if (f < CURSOR_IN) { return 0.28 * WF; }
    if (f < SWEEP_B) { return lerp(0.28 * WF, 0.50 * WF, seg(f, CURSOR_IN, SWEEP_B)); }
    if (f < SWEEP_C) { return lerp(0.50 * WF, 0.70 * WF, seg(f, SWEEP_B, SWEEP_C)); }
    if (f < TAP_FRAME) { return lerp(0.70 * WF, tap_x(), seg(f, SWEEP_C, TAP_FRAME)); }
    if (f < BACK_FRAME + 10) { return tap_x(); }
    if (f < LEAVE_END) { return lerp(tap_x(), 0.88 * WF, seg(f, BACK_FRAME + 10, LEAVE_END)); }
    return 0.88 * WF;
}

pub fn cursor_y(f: u32) -> f64 {
    if (f < CURSOR_IN) { return 0.80 * HF; }
    if (f < SWEEP_B) { return lerp(0.80 * HF, 0.22 * HF, seg(f, CURSOR_IN, SWEEP_B)); }
    if (f < SWEEP_C) { return lerp(0.22 * HF, 0.80 * HF, seg(f, SWEEP_B, SWEEP_C)); }
    if (f < TAP_FRAME) { return lerp(0.80 * HF, tap_y(), seg(f, SWEEP_C, TAP_FRAME)); }
    if (f < BACK_FRAME + 10) { return tap_y(); }
    if (f < LEAVE_END) { return lerp(tap_y(), 0.88 * HF, seg(f, BACK_FRAME + 10, LEAVE_END)); }
    return 0.88 * HF;
}

pub fn cursor_on(f: u32) -> bool {
    return f >= CURSOR_IN;
}

/// S + L6. The menu state at frame f: HOME, then whatever petal_menu.on_tap opens under the cursor,
/// then petal_menu.on_back.
pub fn state_at(f: u32) -> u32 {
    if (f < TAP_FRAME) {
        return STATE_HOME;
    }
    const s = fit_permille(960, 540);
    const cx = @as(i64, @intFromFloat(cursor_x(TAP_FRAME)));
    const cy = @as(i64, @intFromFloat(cursor_y(TAP_FRAME)));
    const opened = on_tap(STATE_HOME, to_box(cx, 480, BOX_CX, s), to_box(cy, 270, BOX_CY, s));
    if (f < BACK_FRAME) {
        return opened;
    }
    return on_back(opened);
}

/// M. g_wave_transition: up by dt x 3 a frame after the tap, down the same way after back.
pub fn menu_alpha(f: u32) -> f64 {
    if (f < TAP_FRAME) { return 0.0; }
    if (f < BACK_FRAME) {
        return clamp01(@as(f64, @floatFromInt(f - TAP_FRAME)) * WAVE_RATE / 30.0);
    }
    return clamp01(1.0 - @as(f64, @floatFromInt(f - BACK_FRAME)) * WAVE_RATE / 30.0);
}

/// S + L3. The hovered petal: the cursor's petal on HOME, none while a menu is up or fading.
pub fn hover_at(f: u32) -> u32 {
    if (cursor_on(f) == false or state_at(f) != STATE_HOME or menu_alpha(f) > 0.0) {
        return PETAL_NONE;
    }
    const cx = @as(i64, @intFromFloat(cursor_x(f)));
    const cy = @as(i64, @intFromFloat(cursor_y(f)));
    return hit_px(cx, cy, 960, 540);
}

// ---- M panel shape ----

pub fn rrect(x: f64, y: f64, hw: f64, hh: f64, r: f64) -> f64 {
    const qx = @abs(x) - hw + r;
    const qy = @abs(y) - hh + r;
    const mx = fmax(qx, 0.0);
    const my = fmax(qy, 0.0);
    return @sqrt(mx * mx + my * my) + fmin(fmax(qx, qy), 0.0) - r;
}

// ---- the render ----

pub fn main() -> void {
    var vxs : [108]f64 = undefined;
    var vys : [108]f64 = undefined;
    var bx0 : [27]f64 = undefined;
    var bx1 : [27]f64 = undefined;
    var by0 : [27]f64 = undefined;
    var by1 : [27]f64 = undefined;
    var roww : [2880]u8 = undefined;
    const s = scale();
    const ow = @as(f64, @floatFromInt(OUTLINE_PX));
    const pw = @as(f64, @floatFromInt(PANEL_W_PX));
    const ph = @as(f64, @floatFromInt(PANEL_H_PX));
    const gap = @as(f64, @floatFromInt(CARD_GAP_PX));
    const cw = (pw - 4.0 * gap) / 3.0;
    const chh = (ph - 4.0 * gap) / 3.0;
    const head = fill(TAP_PETAL, TAP_PETAL, PETAL_NONE);
    const oc = outline();
    var f : u32 = 0;
    while (f < FRAMES) {
        const off = anim_off(f) * 1000.0;
        const st = state_at(f);
        const hov = hover_at(f);
        const ma = menu_alpha(f);
        const curx = cursor_x(f);
        const cury = cursor_y(f);
        const pcx = 0.5 * WF;
        const pcy = 0.5 * HF + (1.0 - ma) * PANEL_LIFT;
        const left = pcx - 0.5 * pw;
        const top = pcy - 0.5 * ph;
        var p : u32 = 0;
        while (p < PETAL_COUNT) {
            const ddx = dir_x(p) * off;
            const ddy = dir_y(p) * off;
            var lx : f64 = 1000000000.0;
            var hx : f64 = 0.0 - 1000000000.0;
            var ly : f64 = 1000000000.0;
            var hy : f64 = 0.0 - 1000000000.0;
            var v : u32 = 0;
            while (v < 4) {
                const i = p * 4 + v;
                const X = to_px_x(@as(f64, @floatFromInt(QX[i])) + ddx, s);
                const Y = to_px_y(@as(f64, @floatFromInt(QY[i])) + ddy, s);
                vxs[i] = X;
                vys[i] = Y;
                lx = fmin(lx, X);
                hx = fmax(hx, X);
                ly = fmin(ly, Y);
                hy = fmax(hy, Y);
                v = v + 1;
            }
            bx0[p] = lx - 2.0;
            bx1[p] = hx + 2.0;
            by0[p] = ly - 2.0;
            by1[p] = hy + 2.0;
            p = p + 1;
        }
        var py : u32 = 0;
        while (py < H_PX) {
            const y = @as(f64, @floatFromInt(py)) + 0.5;
            var px : u32 = 0;
            while (px < W_PX) {
                const x = @as(f64, @floatFromInt(px)) + 0.5;
                var r : f64 = glass(0, x, y);
                var g : f64 = glass(1, x, y);
                var b : f64 = glass(2, x, y);
                // P: the 27 petals, fill then the 1 px outline
                p = 0;
                while (p < PETAL_COUNT) {
                    if (x >= bx0[p] and x <= bx1[p] and y >= by0[p] and y <= by1[p]) {
                        const i = p * 4;
                        const sd = quad_sd(vxs[i], vys[i], vxs[i + 1], vys[i + 1], vxs[i + 2], vys[i + 2], vxs[i + 3], vys[i + 3], x, y);
                        const cov = clamp01(0.5 - sd);
                        if (cov > 0.0) {
                            const fc = fill(p, st, hov);
                            const a = chan(fc, 3) * cov;
                            r = r * (1.0 - a) + chan(fc, 0) * a;
                            g = g * (1.0 - a) + chan(fc, 1) * a;
                            b = b * (1.0 - a) + chan(fc, 2) * a;
                        }
                        const ol = clamp01(ow - @abs(sd)) * chan(oc, 3);
                        if (ol > 0.0) {
                            r = r * (1.0 - ol) + chan(oc, 0) * ol;
                            g = g * (1.0 - ol) + chan(oc, 1) * ol;
                            b = b * (1.0 - ol) + chan(oc, 2) * ol;
                        }
                    }
                    p = p + 1;
                }
                // M: the menu, a blackGlass panel over a black 0.30 scrim, with the empty card slots
                if (ma > 0.0) {
                    const sc = 1.0 - TINT_BLACK * ma;
                    r = r * sc;
                    g = g * sc;
                    b = b * sc;
                    const sd = rrect(x - pcx, y - pcy, 0.5 * pw, 0.5 * ph, PANEL_R);
                    const pin = clamp01(0.5 - sd) * ma;
                    if (pin > 0.0) {
                        const dk = 1.0 - SURFACE_BLACK * pin;
                        const hl = HIGHLIGHT_WHITE * pin * clamp01(1.0 - (y - top) / ph);
                        r = r * dk + hl;
                        g = g * dk + hl;
                        b = b * dk + hl;
                        if (y - top < HEADER_PX + 0.5 and y - top > 0.0 and sd < 0.0 - PANEL_R * 0.5) {
                            const ha = pin;
                            r = r * (1.0 - ha) + chan(head, 0) * ha;
                            g = g * (1.0 - ha) + chan(head, 1) * ha;
                            b = b * (1.0 - ha) + chan(head, 2) * ha;
                        }
                        var k : u32 = 0;
                        while (k < CARD_SLOTS) {
                            const kx = left + @as(f64, @floatFromInt(card_x(k, PANEL_W_PX))) + 0.5 * cw;
                            const ky = top + @as(f64, @floatFromInt(card_y(k, PANEL_H_PX))) + 0.5 * chh;
                            const sdc = rrect(x - kx, y - ky, 0.5 * cw, 0.5 * chh, CARD_R);
                            const cf = clamp01(0.5 - sdc) * CARD_FILL * pin;
                            const ce = clamp01(1.0 - @abs(sdc)) * CARD_EDGE * pin;
                            const ca = cf + ce;
                            r = r * (1.0 - ca) + ca;
                            g = g * (1.0 - ca) + ca;
                            b = b * (1.0 - ca) + ca;
                            k = k + 1;
                        }
                    }
                    const bd = clamp01(1.0 - @abs(sd)) * BORDER_WHITE * ma;
                    r = r * (1.0 - bd) + bd;
                    g = g * (1.0 - bd) + bd;
                    b = b * (1.0 - bd) + bd;
                }
                // S: the cursor ring, and the tap ripple
                if (cursor_on(f)) {
                    const d = @sqrt((x - curx) * (x - curx) + (y - cury) * (y - cury));
                    const sh = clamp01(1.2 - @abs(d - 9.0)) * 0.45;
                    r = r * (1.0 - sh);
                    g = g * (1.0 - sh);
                    b = b * (1.0 - sh);
                    const ring = clamp01(1.4 - @abs(d - 7.0)) * 0.92;
                    r = r * (1.0 - ring) + ring;
                    g = g * (1.0 - ring) + ring;
                    b = b * (1.0 - ring) + ring;
                    if (f >= TAP_FRAME and f < TAP_FRAME + 10) {
                        const tt = @as(f64, @floatFromInt(f - TAP_FRAME));
                        const rip = clamp01(1.5 - @abs(d - (9.0 + 3.0 * tt))) * 0.6 * (1.0 - tt / 10.0);
                        r = r * (1.0 - rip) + rip;
                        g = g * (1.0 - rip) + rip;
                        b = b * (1.0 - rip) + rip;
                    }
                }
                roww[px * 3] = quantize(r * 255.0);
                roww[px * 3 + 1] = quantize(g * 255.0);
                roww[px * 3 + 2] = quantize(b * 255.0);
                px = px + 1;
            }
            std.debug.print("{s}", .{roww});
            py = py + 1;
        }
        f = f + 1;
    }
}

// ---- tests ----

test the_blocks_fly_in_from_800_units_and_settle_home {
    assert anim_off(0) == START_OFF;
    assert anim_off(15) > 50.0;
    assert anim_off(15) < 100.0;
    assert @abs(anim_off(53)) < 0.2;
    assert @abs(anim_off(75)) < 0.05;
    assert @abs(anim_off(FRAMES)) < 0.001;
}

test the_menu_fades_in_over_ten_frames_and_out_after_back {
    assert menu_alpha(TAP_FRAME - 1) == 0.0;
    assert menu_alpha(TAP_FRAME) == 0.0;
    assert @abs(menu_alpha(TAP_FRAME + 5) - 0.5) < 0.000001;
    assert menu_alpha(TAP_FRAME + 10) == 1.0;
    assert menu_alpha(BACK_FRAME - 1) == 1.0;
    assert @abs(menu_alpha(BACK_FRAME + 5) - 0.5) < 0.000001;
    assert menu_alpha(BACK_FRAME + 10) == 0.0;
}

test the_scenario_taps_petal_13_and_backs_home {
    assert state_at(TAP_FRAME - 1) == STATE_HOME;
    assert state_at(TAP_FRAME) == TAP_PETAL;
    assert state_at(BACK_FRAME - 1) == TAP_PETAL;
    assert state_at(BACK_FRAME) == STATE_HOME;
    assert card_count(TAP_PETAL) == 0;
    assert hover_at(CURSOR_IN - 1) == PETAL_NONE;
    assert hover_at(TAP_FRAME - 1) == TAP_PETAL;
    assert hover_at(TAP_FRAME + 20) == PETAL_NONE;
    assert hover_at(FRAMES - 1) == PETAL_NONE;
}

test the_distance_agrees_with_the_ray_cast {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        var lx : i64 = QX[p * 4];
        var hx : i64 = QX[p * 4];
        var ly : i64 = QY[p * 4];
        var hy : i64 = QY[p * 4];
        var v : u32 = 1;
        while (v < 4) {
            if (QX[p * 4 + v] < lx) { lx = QX[p * 4 + v]; }
            if (QX[p * 4 + v] > hx) { hx = QX[p * 4 + v]; }
            if (QY[p * 4 + v] < ly) { ly = QY[p * 4 + v]; }
            if (QY[p * 4 + v] > hy) { hy = QY[p * 4 + v]; }
            v = v + 1;
        }
        var a : i64 = 0;
        while (a <= 20) {
            var c : i64 = 0;
            while (c <= 20) {
                const mx = lx + @divTrunc((hx - lx) * a, 20) + 7;
                const my = ly + @divTrunc((hy - ly) * c, 20) + 3;
                const sd = petal_sd_box(p, @as(f64, @floatFromInt(mx)), @as(f64, @floatFromInt(my)));
                if (sd < 0.0 - 50.0) { assert inside(p, mx, my); }
                if (sd > 50.0) { assert inside(p, mx, my) == false; }
                c = c + 1;
            }
            a = a + 1;
        }
        assert petal_sd_box(p, cen_x(p), cen_y(p)) < 0.0;
        p = p + 1;
    }
}

test the_glass_carries_trios_numbers {
    assert wash(0.0) == WASH;
    assert wash(0.5) == 0.0;
    assert @abs(wash(1.0) - 0.294) < 0.000001;
    assert @abs(bloom_size(WF) - 595.2) < 0.000001;
    assert bloom_size(400.0) == BLOOM_MIN;
    assert @abs(chan(fill(0, STATE_HOME, PETAL_NONE), 3) - 0.2196) < 0.001;
    assert IDLE_ALPHA == 56;
    assert chan(fill(0, STATE_HOME, 0), 0) == 1.0;
}

test every_petal_flies_out_along_a_unit_direction {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        const dx = dir_x(p);
        const dy = dir_y(p);
        assert @abs(dx * dx + dy * dy - 1.0) < 0.000001;
        p = p + 1;
    }
}
