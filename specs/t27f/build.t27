// SPDX-License-Identifier: Apache-2.0
; specs/t27f/build.t27 -- when the T27F exporter wasm is built again, and what its build record holds.
; Issue gHashTag/t27#10229. T27F hot loop, step: the make-style, seal-gated rule for t27f.wasm.
; --
; Why. t27-mcp/wasm/t27f.wasm is the one artifact the graph page and the MCP tools t27f_graph, t27f_outline and
; t27f_view all run. It was rebuilt by ten hand-typed lab commands (wasm/BUILD), the only record of a build was
; a list of hand-pasted sha256 lines, and the copy under apps/website/public/t27f/graph/ in gHashTag/trinity
; drifted from it. The rest of the hot-reload loop (seal v2, `t27c frontier`, the gen-hash cache, frontier
; --watch) already says "reuse unless an input changed"; this spec says it for the wasm.
; --
; The rule. Build again only when an input changed, else REUSE and run nothing:
;   the closure   the source hash of every spec the wasm is generated from, and of the specs they import
;                 (constants are inlined across imports, so a changed import changes the Zig);
;   the zig       the version of the compiler that links the wasm;
;   the t27c      the sha256 of the binary that generates the Zig and the JavaScript;
;   the glue      export.zig, the one hand-written input (wasm/BUILD describes it).
; The reasons are ordered; the first that holds is the one printed.
; --
; Seals. A root whose seal is missing, or whose seal records another spec hash than the file now has, is
; refused: the build never turns an unsealed or unchecked spec into an artifact (`t27c seal --save` first).
; --
; The record. One text file, wasm/t27f.build, written next to the outputs. `#` lines are the inputs; every other
; line is `<sha256>  <name>`, the format `shasum -a 256 -c` reads, so a checker in any repository is
;   grep -v '^#' t27f.build | shasum -a 256 -c -
; with no code of ours. `tri t27f check <dir>` does the same in tri and says which file drifted.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27fBuild;

/// The record's file name, next to the outputs it describes.
pub const BUILD_RECORD : str = "t27f.build";

/// Bumped by hand when the record's keys or the build's composition change.
pub const BUILD_RECORD_VERSION : u32 = 1;

/// The specs the wasm is generated from: each gets a Zig file (t27c gen) and a JavaScript file (t27c gen-js).
pub const BUILD_ROOTS : str = "reel deck spec_graph_view spec_graph_export spec_graph_outline";

/// The specs the roots import, whose items t27c gen inlines. They are inputs, not generated files.
pub const BUILD_IMPORTED : str = "spec_graph ui_plan";

/// The directory of the specs, under the repository root.
pub const BUILD_SPEC_DIR : str = "specs/t27f/";

/// The hand glue, an input that sits next to the outputs.
pub const BUILD_GLUE : str = "export.zig";

/// The generated files, in the order the record lists them. The wasm is last: it is what the others build.
pub const BUILD_OUTPUTS : str = "reel.zig deck.zig spec_graph_view.zig spec_graph_export.zig spec_graph_outline.zig reel.mjs deck.mjs spec_graph_view.mjs spec_graph_export.mjs spec_graph_outline.mjs t27f.wasm";

/// The zig command that links the wasm (run in the output directory). -rdynamic is required: without it
/// a -fno-entry wasm exports nothing.
pub const BUILD_ZIG : str = "build-exe export.zig -target wasm32-freestanding -fno-entry -rdynamic -O ReleaseSmall -femit-bin=t27f.wasm";

/// The record's input keys, `# <key> <value>` lines.
pub const KEY_CLOSURE : str = "# closure ";
pub const KEY_ZIG : str = "# zig ";
pub const KEY_T27C : str = "# t27c ";

/// What `t27c seal --verify` says when there is no seal to verify (it exits 1 for that and for a stale seal).
pub const BUILD_NO_SEAL : str = "No saved seal found";

/// Why the build runs again, or REUSE.
pub const BUILD_REUSE : u32 = 0;
pub const BUILD_NO_RECORD : u32 = 1;
pub const BUILD_CLOSURE : u32 = 2;
pub const BUILD_ZIG_CHANGED : u32 = 3;
pub const BUILD_T27C_CHANGED : u32 = 4;
pub const BUILD_GLUE_CHANGED : u32 = 5;
pub const BUILD_OUTPUT_CHANGED : u32 = 6;

/// The words `tri t27f` prints for each code above, in code order (space separated).
pub const BUILD_REASON_WORDS : str = "REUSE no-record closure zig t27c glue output";
pub const SEAL_WORDS : str = "ok missing stale";
pub const FILE_WORDS : str = "ok missing changed";

/// A root's seal: usable, missing, or recording another spec hash than the file has.
pub const SEAL_OK : u32 = 0;
pub const SEAL_MISSING : u32 = 1;
pub const SEAL_STALE : u32 = 2;

/// One file of a record against the file now: the same bytes, no file, other bytes.
pub const FILE_OK : u32 = 0;
pub const FILE_MISSING : u32 = 1;
pub const FILE_DRIFT : u32 = 2;

/// REUSE, or the first reason to build again. Each flag says the record's value equals the value now;
/// `outputs_same` covers every generated file, `glue_same` export.zig.
pub fn build_reason(has_record: bool, closure_same: bool, zig_same: bool, t27c_same: bool, glue_same: bool, outputs_same: bool) -> u32 {
    if (has_record == false) { return BUILD_NO_RECORD; }
    if (closure_same == false) { return BUILD_CLOSURE; }
    if (zig_same == false) { return BUILD_ZIG_CHANGED; }
    if (t27c_same == false) { return BUILD_T27C_CHANGED; }
    if (glue_same == false) { return BUILD_GLUE_CHANGED; }
    if (outputs_same == false) { return BUILD_OUTPUT_CHANGED; }
    return BUILD_REUSE;
}

/// The seal of one root: `seal_found` is false when t27c said there is none, `hashes_match` is its exit code 0.
pub fn build_seal(seal_found: bool, hashes_match: bool) -> u32 {
    if (seal_found == false) { return SEAL_MISSING; }
    if (hashes_match == false) { return SEAL_STALE; }
    return SEAL_OK;
}

/// One record line against the file: `file_found`, and `sha_same` when the file's sha256 is the record's.
pub fn build_file(file_found: bool, sha_same: bool) -> u32 {
    if (file_found == false) { return FILE_MISSING; }
    if (sha_same == false) { return FILE_DRIFT; }
    return FILE_OK;
}

/// The exit code of `tri t27f check`: 1 as soon as one file drifted or is missing.
pub fn build_check_exit(files_off: u32) -> u32 {
    if (files_off > 0) { return 1; }
    return 0;
}

test build_reuses_only_when_every_input_is_the_same {
    assert build_reason(true, true, true, true, true, true) == 0;
    assert build_reason(false, true, true, true, true, true) == 1;
    assert build_reason(true, false, true, true, true, true) == 2;
    assert build_reason(true, true, false, true, true, true) == 3;
    assert build_reason(true, true, true, false, true, true) == 4;
    assert build_reason(true, true, true, true, false, true) == 5;
    assert build_reason(true, true, true, true, true, false) == 6;
}

test build_reason_names_the_first_change {
    // several inputs changed: the earlier reason wins, so the printed reason does not depend on the order checked
    assert build_reason(true, false, false, false, false, false) == 2;
    assert build_reason(true, true, false, false, true, true) == 3;
    assert build_reason(true, true, true, true, false, false) == 5;
    // no record: nothing else can be judged
    assert build_reason(false, false, false, false, false, false) == 1;
}

test build_refuses_a_root_without_a_current_seal {
    assert build_seal(true, true) == 0;
    assert build_seal(false, false) == 1;
    assert build_seal(true, false) == 2;
    // a missing seal stays missing even if the exit code looked like a match
    assert build_seal(false, true) == 1;
}

test build_check_names_the_drift {
    assert build_file(true, true) == 0;
    assert build_file(false, true) == 1;
    assert build_file(true, false) == 2;
    assert build_file(false, false) == 1;
}

test build_check_exit_is_one_on_any_drift {
    assert build_check_exit(0) == 0;
    assert build_check_exit(1) == 1;
    assert build_check_exit(11) == 1;
}

invariant the_record_shape_never_moves_silently {
    assert BUILD_RECORD_VERSION >= 1;
    assert BUILD_REUSE == 0;
    assert SEAL_OK == 0;
    assert FILE_OK == 0;
    assert BUILD_NO_RECORD != BUILD_CLOSURE;
    assert BUILD_ZIG_CHANGED != BUILD_T27C_CHANGED;
    assert BUILD_GLUE_CHANGED != BUILD_OUTPUT_CHANGED;
    assert SEAL_MISSING != SEAL_STALE;
    assert FILE_MISSING != FILE_DRIFT;
}
