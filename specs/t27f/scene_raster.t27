// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_raster.t27 -- the shared raster of the twelve scene renderers: colours, shapes, a
// 3x5 font and a seeded hash, all in integers. Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: reel_factory.t27 plans one of twelve scenes per lesson but draws none. A scene is a pure
// function from (lesson, pixel) to a colour, so that the same lesson always gives the same picture
// and the stills can be compared. Every scene needs the same few things -- a colour, a disc, a
// segment, a letter -- and the recorded defect of this codebase family is the hand-copied helper, so
// they live here once and the scenes `use` them.
//
// THE CANVAS: scenes draw on a virtual canvas of VW x VH = 360 x 640, the tall cut at one third of
// 1080 x 1920. scene_still.t27 maps a still of any size onto it, so a 108 x 192 gate image and a
// 1080 x 1920 cover are the same picture. Colours are 0xRRGGBB held in an i32 (it fits: < 2^24);
// every coordinate is an i32 too, so no scene needs a cast between its own numbers.
//
// THE FONT: 3 x 5 pixels a letter, one row a 3-bit number (bit 2 is the left pixel), ASCII 32..95
// plus { | } ~; a lowercase letter draws as its capital. It is small on purpose: a scene sets it at
// scale 2..8 and the blocks are the look.
//
// NOT CLAIMED: edges are hard (a point either is or is not inside a shape), so a still at 1080 x 1920
// shows 3 x 3 pixel steps on a diagonal. The hash is a linear congruential generator, enough to
// scatter positions and not a source of randomness.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_raster;

pub const VW : i32 = 360;
pub const VH : i32 = 640;

// ---- colour ----

pub fn rgb(r: i32, g: i32, b: i32) -> i32 {
    return r * 65536 + g * 256 + b;
}
pub fn red(c: i32) -> i32 {
    return @divTrunc(c, 65536);
}
pub fn green(c: i32) -> i32 {
    return @mod(@divTrunc(c, 256), 256);
}
pub fn blue(c: i32) -> i32 {
    return @mod(c, 256);
}
pub fn iabs(v: i32) -> i32 {
    if (v < 0) { return 0 - v; }
    return v;
}
pub fn imin(a: i32, b: i32) -> i32 {
    if (a < b) { return a; }
    return b;
}
pub fn imax(a: i32, b: i32) -> i32 {
    if (a > b) { return a; }
    return b;
}
pub fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
// Rec. 601 luma, 0..255, in integers.
pub fn luma(c: i32) -> i32 {
    return @divTrunc(red(c) * 77 + green(c) * 150 + blue(c) * 29, 256);
}
// c0 at a = 0, c1 at a = 255, linear between.
pub fn mix(c0: i32, c1: i32, a: i32) -> i32 {
    const k = clamp(a, 0, 255);
    const r = @divTrunc(red(c0) * (255 - k) + red(c1) * k, 255);
    const g = @divTrunc(green(c0) * (255 - k) + green(c1) * k, 255);
    const b = @divTrunc(blue(c0) * (255 - k) + blue(c1) * k, 255);
    return rgb(r, g, b);
}

// ---- hash ----

// The next state of a linear congruential generator, 31 bits.
pub fn lcg(s: i32) -> i32 {
    const v : i64 = @as(i64, s) * 1103515245 + 12345;
    return @as(i32, @intCast(@mod(v, 2147483648)));
}
// A number in 0..n-1 from seed s: two steps, then the high bits (the low bits of an LCG cycle).
pub fn rnd(s: i32, n: i32) -> i32 {
    const h = lcg(lcg(s + 7919));
    return @mod(@divTrunc(h, 4096), n);
}

// ---- shapes ----

pub fn in_rect(x: i32, y: i32, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    return x >= x0 && x < x1 && y >= y0 && y < y1;
}
pub fn in_disc(x: i32, y: i32, cx: i32, cy: i32, r: i32) -> bool {
    const dx : i64 = @as(i64, x - cx);
    const dy : i64 = @as(i64, y - cy);
    return dx * dx + dy * dy <= @as(i64, r) * @as(i64, r);
}
pub fn in_ring(x: i32, y: i32, cx: i32, cy: i32, r0: i32, r1: i32) -> bool {
    const dx : i64 = @as(i64, x - cx);
    const dy : i64 = @as(i64, y - cy);
    const d2 = dx * dx + dy * dy;
    return d2 >= @as(i64, r0) * @as(i64, r0) && d2 <= @as(i64, r1) * @as(i64, r1);
}
// Whether (x, y) is within hw of the segment from (x0, y0) to (x1, y1).
pub fn near_seg(x: i32, y: i32, x0: i32, y0: i32, x1: i32, y1: i32, hw: i32) -> bool {
    const ex : i64 = @as(i64, x1 - x0);
    const ey : i64 = @as(i64, y1 - y0);
    const px : i64 = @as(i64, x - x0);
    const py : i64 = @as(i64, y - y0);
    const len2 = ex * ex + ey * ey;
    const lim : i64 = @as(i64, hw) * @as(i64, hw);
    if (len2 == 0) { return px * px + py * py <= lim; }
    const dot = px * ex + py * ey;
    if (dot <= 0) { return px * px + py * py <= lim; }
    if (dot >= len2) {
        const qx : i64 = @as(i64, x - x1);
        const qy : i64 = @as(i64, y - y1);
        return qx * qx + qy * qy <= lim;
    }
    const cross = px * ey - py * ex;
    return cross * cross <= lim * len2;
}
// A triangle wave: 0 at phase 0, rising to amp - 1 at half a period, back to 0.
pub fn tri_wave(v: i32, period: i32, amp: i32) -> i32 {
    const m = @mod(v, period);
    const half = @divTrunc(period, 2);
    if (m < half) { return @divTrunc(m * amp, half); }
    return @divTrunc((period - m) * amp, half);
}

// ---- the 3 x 5 font ----

// 68 glyphs of five rows: ASCII 32..95, then { | } ~. Row bits: 4 = left, 2 = middle, 1 = right.
pub const FONT : [340]u8 = [
    0, 0, 0, 0, 0,   // space
    2, 2, 2, 0, 2,   // !
    5, 5, 0, 0, 0,   // "
    5, 7, 5, 7, 5,   // #
    3, 6, 2, 3, 6,   // $
    5, 1, 2, 4, 5,   // %
    2, 5, 2, 5, 3,   // &
    2, 2, 0, 0, 0,   // '
    1, 2, 2, 2, 1,   // (
    4, 2, 2, 2, 4,   // )
    5, 2, 7, 2, 5,   // *
    0, 2, 7, 2, 0,   // +
    0, 0, 0, 2, 4,   // ,
    0, 0, 7, 0, 0,   // -
    0, 0, 0, 0, 2,   // .
    1, 1, 2, 4, 4,   // /
    7, 5, 5, 5, 7,   // 0
    2, 6, 2, 2, 7,   // 1
    7, 1, 7, 4, 7,   // 2
    7, 1, 7, 1, 7,   // 3
    5, 5, 7, 1, 1,   // 4
    7, 4, 7, 1, 7,   // 5
    7, 4, 7, 5, 7,   // 6
    7, 1, 1, 2, 2,   // 7
    7, 5, 7, 5, 7,   // 8
    7, 5, 7, 1, 7,   // 9
    0, 2, 0, 2, 0,   // :
    0, 2, 0, 2, 4,   // ;
    1, 2, 4, 2, 1,   // <
    0, 7, 0, 7, 0,   // =
    4, 2, 1, 2, 4,   // >
    7, 1, 3, 0, 2,   // ?
    7, 5, 7, 4, 7,   // @
    2, 5, 7, 5, 5,   // A
    6, 5, 6, 5, 6,   // B
    3, 4, 4, 4, 3,   // C
    6, 5, 5, 5, 6,   // D
    7, 4, 6, 4, 7,   // E
    7, 4, 6, 4, 4,   // F
    3, 4, 5, 5, 3,   // G
    5, 5, 7, 5, 5,   // H
    7, 2, 2, 2, 7,   // I
    1, 1, 1, 5, 2,   // J
    5, 5, 6, 5, 5,   // K
    4, 4, 4, 4, 7,   // L
    5, 7, 7, 5, 5,   // M
    6, 5, 5, 5, 5,   // N
    2, 5, 5, 5, 2,   // O
    6, 5, 6, 4, 4,   // P
    2, 5, 5, 7, 3,   // Q
    6, 5, 6, 5, 5,   // R
    3, 4, 2, 1, 6,   // S
    7, 2, 2, 2, 2,   // T
    5, 5, 5, 5, 7,   // U
    5, 5, 5, 5, 2,   // V
    5, 5, 7, 7, 5,   // W
    5, 5, 2, 5, 5,   // X
    5, 5, 2, 2, 2,   // Y
    7, 1, 2, 4, 7,   // Z
    3, 2, 2, 2, 3,   // [
    4, 4, 2, 1, 1,   // backslash
    6, 2, 2, 2, 6,   // ]
    2, 5, 0, 0, 0,   // ^
    0, 0, 0, 0, 7,   // _
    3, 2, 6, 2, 3,   // {
    2, 2, 2, 2, 2,   // |
    6, 2, 3, 2, 6,   // }
    0, 3, 6, 0, 0,   // ~
];
pub const GLYPHS : i32 = 68;

// The glyph index of character c, or -1 for one the font does not draw.
pub fn glyph_of(c: i32) -> i32 {
    if (c >= 32 && c <= 95) { return c - 32; }
    if (c >= 97 && c <= 122) { return c - 64; }
    if (c >= 123 && c <= 126) { return c - 59; }
    return 0 - 1;
}
// Whether pixel (gx, gy), gx 0..2 and gy 0..4, of character c is set.
pub fn glyph_on(c: i32, gx: i32, gy: i32) -> bool {
    const g = glyph_of(c);
    if (g < 0) { return false; }
    if (gx < 0 || gx > 2 || gy < 0 || gy > 4) { return false; }
    const row = @as(i32, FONT[@as(usize, @intCast(g * 5 + gy))]);
    var pw : i32 = 4;
    if (gx == 1) { pw = 2; }
    if (gx == 2) { pw = 1; }
    return @mod(@divTrunc(row, pw), 2) == 1;
}
// Whether canvas point (x, y) is on character c drawn with its top left at (ox, oy), each font
// pixel s canvas pixels square.
pub fn char_on(c: i32, x: i32, y: i32, ox: i32, oy: i32, s: i32) -> bool {
    if (x < ox || y < oy) { return false; }
    return glyph_on(c, @divTrunc(x - ox, s), @divTrunc(y - oy, s));
}
// The advance of one character at scale s: three pixels of glyph and one of gap.
pub fn advance(s: i32) -> i32 {
    return 4 * s;
}
// Whether (x, y) is on the decimal number v (at most 5 digits) with its top left at (ox, oy).
pub fn num_on(v: i32, x: i32, y: i32, ox: i32, oy: i32, s: i32) -> bool {
    if (y < oy || y >= oy + 5 * s || x < ox) { return false; }
    var digits : i32 = 1;
    var w = v;
    while (w >= 10) {
        w = @divTrunc(w, 10);
        digits = digits + 1;
    }
    const k = @divTrunc(x - ox, advance(s));
    if (k >= digits) { return false; }
    var p : i32 = digits - 1 - k;
    var d = v;
    while (p > 0) {
        d = @divTrunc(d, 10);
        p = p - 1;
    }
    return char_on(48 + @mod(d, 10), x, y, ox + k * advance(s), oy, s);
}

// ---- tests ----

test "a colour packs and unpacks, and mixing keeps both ends" {
    const c = rgb(18, 200, 255);
    assert(red(c) == 18);
    assert(green(c) == 200);
    assert(blue(c) == 255);
    assert(mix(c, 0, 0) == c);
    assert(mix(c, 0, 255) == 0);
    assert(luma(rgb(255, 255, 255)) >= 254);
    assert(luma(0) == 0);
    assert(luma(rgb(0, 255, 0)) > luma(rgb(255, 0, 0)));
    assert(luma(rgb(255, 0, 0)) > luma(rgb(0, 0, 255)));
}

test "the hash is deterministic, in range, and not one number" {
    assert(rnd(5, 100) == rnd(5, 100));
    var seen : i32 = 0;
    var last : i32 = 0 - 1;
    var s : i32 = 0;
    while (s < 64) {
        const r = rnd(s, 50);
        assert(r >= 0 && r < 50);
        if (r != last) { seen = seen + 1; }
        last = r;
        s = s + 1;
    }
    assert(seen >= 40);
}

test "shapes contain their centre and not a far point" {
    assert(in_rect(5, 5, 0, 0, 10, 10));
    assert(!in_rect(10, 5, 0, 0, 10, 10));
    assert(in_disc(50, 50, 50, 50, 3));
    assert(!in_disc(60, 50, 50, 50, 3));
    assert(in_ring(53, 50, 50, 50, 2, 4));
    assert(!in_ring(50, 50, 50, 50, 2, 4));
    assert(near_seg(5, 6, 0, 0, 10, 10, 2));
    assert(!near_seg(5, 12, 0, 0, 10, 10, 2));
    assert(near_seg(0 - 1, 0, 0, 0, 10, 0, 2));
    assert(!near_seg(0 - 5, 0, 0, 0, 10, 0, 2));
    assert(tri_wave(0, 10, 100) == 0);
    assert(tri_wave(5, 10, 100) == 100);
    assert(tri_wave(10, 10, 100) == 0);
}

test "the font draws a capital A and folds a lowercase letter onto it" {
    var n : i32 = 0;
    var gy : i32 = 0;
    while (gy < 5) {
        var gx : i32 = 0;
        while (gx < 3) {
            if (glyph_on(65, gx, gy)) { n = n + 1; }
            assert(glyph_on(65, gx, gy) == glyph_on(97, gx, gy));
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    assert(n == 10);
    assert(!glyph_on(32, 1, 2));
    assert(!glyph_on(200, 1, 2));
    assert(glyph_on(124, 1, 0));
    assert(char_on(65, 22, 10, 20, 10, 2));
    assert(!char_on(65, 20, 10, 20, 10, 2));
    assert(!char_on(65, 19, 10, 20, 10, 2));
}

test "a number draws its digits left to right and nothing past them" {
    // 407 at scale 2 from (10, 10): '4' covers x 10..15, '0' 18..23, '7' 26..31
    assert(num_on(407, 10, 10, 10, 10, 2));
    assert(num_on(407, 26, 10, 10, 10, 2));
    assert(!num_on(407, 34, 10, 10, 10, 2));
    assert(!num_on(407, 10, 22, 10, 10, 2));
    // a different number is a different picture
    var diff : i32 = 0;
    var px : i32 = 10;
    while (px < 34) {
        var py : i32 = 10;
        while (py < 20) {
            if (num_on(407, px, py, 10, 10, 2) != num_on(408, px, py, 10, 10, 2)) { diff = diff + 1; }
            py = py + 1;
        }
        px = px + 1;
    }
    assert(diff > 0);
}

test "the font table holds sixty-eight glyphs of three-bit rows" {
    assert(GLYPHS * 5 == 340);
    var i : usize = 0;
    while (i < 340) {
        assert(@as(i32, FONT[i]) <= 7);
        i = i + 1;
    }
}
