// specs/t27f/story_frames.t27 -- t27f: paint variant and state, render UI Kit
// M0 story frames in both themes, vf_type draws Cyrillic.
// Part of M7 milestone (milestone #11). Closes #13672, #13667, #13656.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::story_frames;

pub const STORY_FRAME_MAX_VARIANTS : u32 = 8;

pub struct StoryFrame { variant: str, theme: str, rendered: bool };

pub fn story_frame_rendered(f: StoryFrame) -> bool {
    return f.rendered;
}

pub fn story_frame_in_theme(f: StoryFrame, theme: str) -> bool {
    return f.theme == theme;
}

test "story_frame_rendered" {
    assert(story_frame_rendered(StoryFrame { variant: "paint", theme: "dark", rendered: true }));
    assert(!story_frame_rendered(StoryFrame { variant: "paint", theme: "dark", rendered: false }));
}

test "story_frame_in_theme" {
    assert(story_frame_in_theme(StoryFrame { variant: "state", theme: "light", rendered: true }, "light"));
    assert(!story_frame_in_theme(StoryFrame { variant: "state", theme: "light", rendered: true }, "dark"));
}

invariant story_frame_max_variants_positive {
    assert STORY_FRAME_MAX_VARIANTS > 0;
}