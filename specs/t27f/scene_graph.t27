// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_graph.t27 -- scene A_GRAPH of reel_factory.t27: the lesson's code as a diagram, one
// node per line of source, in the order the lines stand, joined by the flow from each to the next.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: the T27F idea in one picture -- a spec as nodes and edges. A declaration (`pub`, `fn`, `const`,
// `test`, `struct`, `enum`, `use`) is a node filled in the accent, any other line a dark node, and
// each node carries the first characters of its own line. A longer lesson draws more nodes.
//
// THE FUNCTION: graph_px(t, acc, n, x, y) is the colour of canvas point (x, y). Three nodes to a row,
// at most 33 nodes; a lesson with more lines draws its first 33.
//
// NOT CLAIMED: the edges are the order of the lines, not a call graph; reading calls out of the text
// is the T27F graph IR, which this does not do.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_graph;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::near_seg;
use t27f::scene_raster::char_on;
use t27f::scene_raster::imin;
use t27f::scene_raster::imax;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_n;
use t27f::scene_lex::lex_line;
use t27f::scene_lex::lex_llen;
use t27f::scene_lex::lex_ch;
use t27f::scene_lex::lex_first;
use t27f::scene_lex::lex_has;
use t27f::scene_lex::KW_FN;
use t27f::scene_lex::KW_PUB;
use t27f::scene_lex::KW_CONST;
use t27f::scene_lex::KW_TEST;
use t27f::scene_lex::KW_STRUCT;
use t27f::scene_lex::KW_ENUM;
use t27f::scene_lex::KW_USE;

pub const NODE_W : i32 = 100;
pub const NODE_H : i32 = 22;
pub const GRAPH_COLS : i32 = 3;
pub const X0 : i32 = 14;
pub const DX : i32 = 116;
pub const Y0 : i32 = 92;
pub const DY : i32 = 42;
pub const MAXN : i32 = 33;
pub const GRAPH_INK : i32 = 0xE6EAF5;
pub const NODE_BG : i32 = 0x161B33;

pub fn node_n(t: usize) -> i32 {
    return imin(lex_n(t), MAXN);
}
pub fn node_cx(r: i32) -> i32 {
    return X0 + fmod(r, GRAPH_COLS) * DX + @divTrunc(NODE_W, 2);
}
pub fn node_cy(r: i32) -> i32 {
    return Y0 + @divTrunc(r, GRAPH_COLS) * DY + @divTrunc(NODE_H, 2);
}
// Whether line l declares something.
pub fn is_decl(l: usize) -> bool {
    return lex_has(l, KW_FN) || lex_has(l, KW_PUB) || lex_has(l, KW_CONST) || lex_has(l, KW_TEST) || lex_has(l, KW_STRUCT) || lex_has(l, KW_ENUM) || lex_has(l, KW_USE);
}

pub fn graph_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(1, acc, seed_of(t, n, 1), x, y);
    const cnt = node_n(t);
    const row = @divTrunc(y - Y0 + DY, DY) - 1;
    // the node under the pixel, if any
    if (y >= Y0 && x >= X0) {
        const col = @divTrunc(x - X0, DX);
        const r = row * GRAPH_COLS + col;
        if (col < GRAPH_COLS && r >= 0 && r < cnt && in_rect(x, y, X0 + col * DX, Y0 + row * DY, X0 + col * DX + NODE_W, Y0 + row * DY + NODE_H)) {
            const l = lex_line(t, r);
            const ox = X0 + col * DX + 4;
            const oy = Y0 + row * DY + 6;
            var fill = NODE_BG;
            if (is_decl(l)) { fill = mix(NODE_BG, acc, 200); }
            if (!in_rect(x, y, X0 + col * DX + 1, Y0 + row * DY + 1, X0 + col * DX + NODE_W - 1, Y0 + row * DY + NODE_H - 1)) { return acc; }
            const k = @divTrunc(x - ox, 8);
            if (x >= ox && y >= oy && k < 11) {
                const ch = lex_ch(l, lex_first(l) + k);
                if (ch > 0 && char_on(ch, x, y, ox + k * 8, oy, 2)) {
                    if (is_decl(l)) { return rgb(10, 12, 24); }
                    return GRAPH_INK;
                }
            }
            return fill;
        }
    }
    // the edges: line r to line r + 1, only those that can pass this row
    var r0 = imax(0, (row - 1) * GRAPH_COLS);
    const r1 = imin(cnt - 2, row * GRAPH_COLS + GRAPH_COLS);
    while (r0 <= r1) {
        if (near_seg(x, y, node_cx(r0), node_cy(r0), node_cx(r0 + 1), node_cy(r0 + 1), 1)) {
            return acc;
        }
        r0 = r0 + 1;
    }
    return c0;
}

// ---- tests ----

test "one node per line, three to a row" {
    var t : usize = 0;
    while (t < 27) {
        assert(node_n(t) >= 1 && node_n(t) <= MAXN);
        t = t + 1;
    }
    assert(node_cx(0) == X0 + 50);
    assert(node_cx(4) == X0 + DX + 50);
    assert(node_cy(3) == Y0 + DY + 11);
}

test "the nodes are the lesson's lines: another lesson draws another diagram" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = graph_px(2, 0xF5B700, 3, x, y);
            const b = graph_px(11, 0xF5B700, 3, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "a declaration node is filled in the accent and a plain one is not" {
    // count accent-tinted node pixels over a lesson that has declarations
    var decl : i32 = 0;
    var r : i32 = 0;
    const t : usize = 12;
    while (r < node_n(t)) {
        if (is_decl(lex_line(t, r))) { decl = decl + 1; }
        r = r + 1;
    }
    assert(decl >= 1);
    assert(decl <= node_n(t));
    // the node's border pixel is the accent whatever the line is
    assert(graph_px(t, 0x22C55E, 1, X0, Y0) == 0x22C55E);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (graph_px(5, 0x3B82F6, 2, x, y) != graph_px(5, 0x3B82F6, 2, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
