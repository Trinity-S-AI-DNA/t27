// specs/t27f/course_renderer.t27 -- course(ring5): styled renderer — 7
// lesson-1 scenes through vf_card + Design Tokens.
// Part of M1 (milestone #5). Closes #13682.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::course_renderer;

pub const COURSE_LESSON_1_SCENES : u32 = 7;

pub struct CourseScene { lesson: u32, scene: u32, rendered: bool };

pub fn course_scene_rendered(s: CourseScene) -> bool {
    return s.rendered;
}

test "course lesson 1 scenes" {
    assert(COURSE_LESSON_1_SCENES == 7);
}

test "course scene rendered" {
    assert(course_scene_rendered(CourseScene { lesson: 1, scene: 3, rendered: true }));
    assert(!course_scene_rendered(CourseScene { lesson: 1, scene: 3, rendered: false }));
}

invariant course_lesson_1_scenes_is_7 {
    assert COURSE_LESSON_1_SCENES == 7;
}