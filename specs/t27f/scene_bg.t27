// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_bg.t27 -- the cell texture behind every scene, and the 24-step circle table the
// round scenes use. Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: two stills are compared by SSIM, and a flat colour is the same structure in any picture: two
// dark frames with one small hero each score near 1000 permille whatever the heroes are. A scene
// therefore never leaves its backdrop flat. The backdrop is a field of cells whose brightness is a
// hash of the lesson's seed, so another lesson draws uncorrelated cells, and six cell shapes (grid,
// bricks, diamonds, bars, rings, bands) so another archetype draws another geometry.
//
// THE CALL: bg_px(st, acc, sd, x, y) is the colour of canvas point (x, y): st is the cell shape 0..5,
// acc the accent (a 14 % tint of it goes into every cell), sd the seed from seed_of(t, n, st).
//
// NOT CLAIMED: it is a texture, not a pattern with a meaning; the cell sizes are 12..24 canvas pixels.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_bg;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::rnd;
use t27f::scene_raster::luma;

pub const COS24 : [24]i32 = [1000, 966, 866, 707, 500, 259, 0, -259, -500, -707, -866, -966, -1000, -966, -866, -707, -500, -259, 0, 259, 500, 707, 866, 966];
pub const SIN24 : [24]i32 = [0, 259, 500, 707, 866, 966, 1000, 966, 866, 707, 500, 259, 0, -259, -500, -707, -866, -966, -1000, -966, -866, -707, -500, -259];

// cos and sin of 15 degrees times k, times 1000; k wraps.
pub fn cos24(k: i32) -> i32 {
    return COS24[@as(usize, @intCast(fmod(k, 24)))];
}
pub fn sin24(k: i32) -> i32 {
    return SIN24[@as(usize, @intCast(fmod(k, 24)))];
}

// The seed of lesson t's scene st with content count n.
pub fn seed_of(t: usize, n: i32, st: i32) -> i32 {
    return @as(i32, @intCast(t)) * 977 + n * 31 + st * 5 + 11;
}

pub fn cell_size(sd: i32) -> i32 {
    return 12 + rnd(sd, 4) * 4;
}

// The cell that canvas point (x, y) is in, as a number; two points of one cell share it.
pub fn cell_id(st: i32, sd: i32, x: i32, y: i32) -> i32 {
    const cs = cell_size(sd);
    const px = x + 1200;
    const py = y + 1200;
    var id : i32 = 0;
    if (st == 0) { id = @divTrunc(py, cs) * 256 + @divTrunc(px, cs); }
    if (st == 1) {
        const row = @divTrunc(py, cs);
        id = row * 256 + @divTrunc(px + fmod(row, 2) * cs, cs * 2);
    }
    if (st == 2) { id = @divTrunc(px + py, cs) * 256 + @divTrunc(px - py + 2400, cs); }
    if (st == 3) { id = @divTrunc(px, cs); }
    if (st == 4) {
        const dx = x - (120 + rnd(sd + 1, 120));
        const dy = y - (200 + rnd(sd + 2, 240));
        id = @divTrunc(dx * dx + dy * dy, cs * cs * 5);
    }
    if (st == 5) { id = @divTrunc(py, cs); }
    return id;
}

pub fn bg_px(st: i32, acc: i32, sd: i32, x: i32, y: i32) -> i32 {
    const cs = cell_size(sd);
    const id = cell_id(st, sd, x, y);
    var l : i32 = 14 + rnd(sd * 131 + id, 6) * 8;
    if (st == 0 && (fmod(x + 1200, cs) == 0 || fmod(y + 1200, cs) == 0)) { l = l - 8; }
    return mix(rgb(l, l + 2, l + 8), acc, 36);
}

// ---- tests ----

test "the circle table is a circle" {
    var k : i32 = 0;
    while (k < 24) {
        const r2 = cos24(k) * cos24(k) + sin24(k) * sin24(k);
        assert(r2 > 990000 && r2 < 1010000);
        k = k + 1;
    }
    assert(cos24(0) == 1000);
    assert(sin24(6) == 1000);
    assert(cos24(12) == 0 - 1000);
    assert(cos24(24) == cos24(0));
    assert(sin24(0 - 18) == sin24(6));
}

test "cells share a colour and neighbours mostly do not" {
    const sd = seed_of(3, 5, 0);
    const cs = cell_size(sd);
    assert(cs >= 12 && cs <= 24);
    // two points of one grid cell are one colour (clear of the cell's edge line)
    const x0 = (@divTrunc(100 + 1200, cs) + 1) * cs - 1200 + 2;
    const y0 = (@divTrunc(100 + 1200, cs) + 1) * cs - 1200 + 2;
    assert(bg_px(0, 0xF5B700, sd, x0, y0) == bg_px(0, 0xF5B700, sd, x0 + 1, y0 + 1));
    // across a sampled row, many distinct colours
    var distinct : i32 = 0;
    var last : i32 = 0 - 1;
    var x : i32 = 0;
    while (x < 360) {
        const c = bg_px(0, 0xF5B700, sd, x, 200);
        if (c != last) { distinct = distinct + 1; }
        last = c;
        x = x + 1;
    }
    assert(distinct > 15);
}

test "another lesson draws other cells: the textures are uncorrelated" {
    var st : i32 = 0;
    while (st < 6) {
        var same : i32 = 0;
        var seen : i32 = 0;
        var y : i32 = 0;
        while (y < 640) {
            var x : i32 = 0;
            while (x < 360) {
                const a = bg_px(st, 0x8B5CF6, seed_of(2, 4, st), x, y);
                const b = bg_px(st, 0x8B5CF6, seed_of(9, 4, st), x, y);
                assert(a >= 0 && a <= 0xFFFFFF);
                if (a == b) { same = same + 1; }
                seen = seen + 1;
                x = x + 7;
            }
            y = y + 9;
        }
        // 6 brightness levels: two unrelated fields agree on about one pixel in six
        assert(same * 100 < seen * 40);
        st = st + 1;
    }
}

test "negative control: the same seed gives the same texture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (bg_px(4, 0x22C55E, seed_of(5, 2, 4), x, y) != bg_px(4, 0x22C55E, seed_of(5, 2, 4), x, y)) { diff = diff + 1; }
            x = x + 13;
        }
        y = y + 11;
    }
    assert(diff == 0);
}

test "the backdrop is dark: no pixel is as bright as a hero" {
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            assert(luma(bg_px(1, 0xF5F5F5, seed_of(7, 1, 1), x, y)) < 110);
            x = x + 9;
        }
        y = y + 13;
    }
}
