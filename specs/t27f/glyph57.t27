    21, 21, 21, 21, 21, 31, 1,    // 78 Shcha
    24, 8, 8, 14, 9, 9, 14,       // 79 hard sign
    17, 17, 17, 29, 19, 19, 29,   // 80 Yeru
    16, 16, 16, 30, 17, 17, 30,   // 81 soft sign
    14, 17, 1, 7, 1, 17, 14,      // 82 E
    18, 21, 21, 29, 21, 21, 18,   // 83 Yu
    15, 17, 17, 15, 5, 9, 17,     // 84 Ya
];

// The glyph of Cyrillic capital U+0410 + k, A..Ya. Below 64 a Latin look-alike, else its own.
pub const CYR_MAP : [32]u8 = [
    33, 64, 34, 65, 66, 37, 67, 68,   // A Be Ve Ge De Ie Zhe Ze
    69, 70, 43, 71, 45, 40, 47, 72,   // I shortI Ka El Em En O Pe
    48, 35, 52, 73, 74, 56, 75, 76,   // Er Es Te U Ef Ha Tse Che
    77, 78, 79, 80, 81, 82, 83, 84,   // Sha Shcha hard Yeru soft E Yu Ya
];

// ---- decode ----

fn byte_at(t: []const u8, i: i32) -> i32 {
    return @as(i32, t[@as(usize, @intCast(i))]);
}
fn is_cont(b: i32) -> bool {
    return b >= 128 && b < 192;
}

// How many bytes the character at byte i takes: 1..4, or 1 for a malformed byte; 0 past the end.
pub fn cp_len(t: []const u8, i: i32) -> i32 {
    const n = @as(i32, @intCast(t.len));
    if (i < 0 || i >= n) { return 0; }
    const b = byte_at(t, i);
    var k : i32 = 1;
    if (b >= 248) {
        k = 1;
    } else if (b >= 240) {
        k = 4;
    } else if (b >= 224) {
        k = 3;
    } else if (b >= 192) {
        k = 2;
    }
    if (i + k > n) { return 1; }
    var j : i32 = 1;
    while (j < k) {
        if (!is_cont(byte_at(t, i + j))) { return 1; }
        j = j + 1;
    }
    return k;
}

// The code point at byte i; BAD for a malformed byte, 0 past the end.
pub fn cp_at(t: []const u8, i: i32) -> i32 {
    const k = cp_len(t, i);
    if (k == 0) { return 0; }
    const b = byte_at(t, i);
    if (k == 1) {
        if (b < 128) { return b; }
        return BAD;
    }
    const c1 = byte_at(t, i + 1) - 128;
    if (k == 2) { return (b - 192) * 64 + c1; }
    const c2 = byte_at(t, i + 2) - 128;
    if (k == 3) { return (b - 224) * 4096 + c1 * 64 + c2; }
    const c3 = byte_at(t, i + 3) - 128;
    return (b - 240) * 262144 + c1 * 4096 + c2 * 64 + c3;
}

// The number of characters in bytes a..b of t (a walk from a, by cp_len).
pub fn cp_count(t: []const u8, a: i32, b: i32) -> i32 {
    var i : i32 = a;
    var n : i32 = 0;
    while (i < b) {
        const k = cp_len(t, i);
        if (k == 0) { return n; }
        i = i + k;
        n = n + 1;
    }
    return n;
}

// ---- fold and glyph ----

// Upper case: Latin a..z, Cyrillic a..ya (U+0430..U+044F) and yo (U+0451).
pub fn fold(c: i32) -> i32 {
    if (c >= 97 && c <= 122) { return c - 32; }
    if (c >= 1072 && c <= 1103) { return c - 32; }
    if (c == 1105) { return CYR_YO; }
    return c;
}

// The glyph that draws code point c; '?' for one the font does not have.
pub fn glyph57_of(c: i32) -> i32 {
    const f = fold(c);
    if (f >= 32 && f <= 95) { return f - 32; }
    if (f >= CYR_A && f < CYR_A + 32) { return @as(i32, CYR_MAP[@as(usize, @intCast(f - CYR_A))]); }
    if (f == CYR_YO) { return 37; }
    return QMARK;
}

// Whether pixel (gx, gy) of glyph g is lit, gx 0..4 and gy 0..6.
pub fn glyph57_px(g: i32, gx: i32, gy: i32) -> bool {
    if (g < 0 || g >= GLYPHS57) { return false; }
    if (gx < 0 || gx >= GW || gy < 0 || gy >= GH) { return false; }
    const row = @as(i32, FONT57[@as(usize, @intCast(g * GH + gy))]);
    return fmod(@divTrunc(row, PW5[@as(usize, @intCast(gx))]), 2) == 1;
}

// Whether pixel (gx, gy) of code point c is lit.
pub fn glyph57_on(c: i32, gx: i32, gy: i32) -> bool {
    return glyph57_px(glyph57_of(c), gx, gy);
}

// The number of lit pixels of glyph g.
pub fn glyph57_lit(g: i32) -> i32 {
    var n : i32 = 0;
    var gy : i32 = 0;
    while (gy < GH) {
        var gx : i32 = 0;
        while (gx < GW) {
            if (glyph57_px(g, gx, gy)) { n = n + 1; }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    return n;
}

fn same_glyph(a: i32, b: i32) -> bool {
    var gy : i32 = 0;
    while (gy < GH) {
        if (FONT57[@as(usize, @intCast(a * GH + gy))] != FONT57[@as(usize, @intCast(b * GH + gy))]) { return false; }
        gy = gy + 1;
    }
    return true;
}

// ---- tests ----

// "A", Zhe (D0 96), the euro sign (E2 82 AC); a stray continuation, "A", a cut-off lead; a lead
// byte followed by "A".
pub const U8_MIX : [6]u8 = [65, 208, 150, 226, 130, 172];
pub const U8_BAD : [3]u8 = [150, 65, 208];
pub const U8_CUT : [2]u8 = [208, 65];

test "UTF-8 decodes one, two and three bytes, and a malformed byte reads as one BAD character" {
    const t = U8_MIX[0..6];
    assert(t.len == 6);
    assert(cp_len(t, 0) == 1);
    assert(cp_at(t, 0) == 65);
    assert(cp_len(t, 1) == 2);
    assert(cp_at(t, 1) == 1046);       // Zhe, U+0416
    assert(cp_len(t, 3) == 3);
    assert(cp_at(t, 3) == 8364);       // the euro sign, U+20AC
    assert(cp_count(t, 0, 6) == 3);
    assert(cp_len(t, 6) == 0);
    const s = U8_BAD[0..3];
    assert(cp_len(s, 0) == 1);
    assert(cp_at(s, 0) == BAD);
    assert(cp_at(s, 1) == 65);
    assert(cp_len(s, 2) == 1);         // a lead byte cut off by the end
    assert(cp_at(s, 2) == BAD);
    assert(cp_count(s, 0, 3) == 3);
    const e = U8_CUT[0..2];
    assert(cp_len(e, 0) == 1);         // a lead byte whose next byte is not a continuation
    assert(cp_count(e, 0, 2) == 2);
}

test "fold maps every lower-case letter to its capital and leaves the rest" {
    assert(fold(97) == 65);
    assert(fold(122) == 90);
    assert(fold(1072) == 1040);
    assert(fold(1103) == 1071);
    assert(fold(1105) == CYR_YO);
    assert(fold(1040) == 1040);
    assert(fold(48) == 48);
    assert(fold(124) == 124);
}

test "the font table: 85 glyphs of seven 5-bit rows, a blank space, every other glyph lit" {
    assert(GLYPHS57 * GH == 595);
    var i : usize = 0;
    while (i < 595) {
        assert(@as(i32, FONT57[i]) <= 31);
        i = i + 1;
    }
    assert(glyph57_lit(0) == 0);
    var g : i32 = 1;
    while (g < GLYPHS57) {
        assert(glyph57_lit(g) > 0);
        g = g + 1;
    }
    assert(glyph57_of(63) == QMARK);
}

test "no two glyphs share a bitmap" {
    var a : i32 = 0;
    while (a < GLYPHS57) {
        var b : i32 = a + 1;
        while (b < GLYPHS57) {
            assert(!same_glyph(a, b));
            b = b + 1;
        }
        a = a + 1;
    }
}

test "the Cyrillic map: 11 Latin look-alikes, and each of the 21 own glyphs used exactly once" {
    var latin : i32 = 0;
    var k : usize = 0;
    while (k < 32) {
        if (CYR_MAP[k] < 64) { latin = latin + 1; }
        k = k + 1;
    }
    assert(latin == 11);
    var g : i32 = 64;
    while (g < GLYPHS57) {
        var uses : i32 = 0;
        var m : usize = 0;
        while (m < 32) {
            if (@as(i32, CYR_MAP[m]) == g) { uses = uses + 1; }
            m = m + 1;
        }
        assert(uses == 1);
        g = g + 1;
    }
    assert(glyph57_of(1040) == glyph57_of(65));    // A
    assert(glyph57_of(1056) == glyph57_of(80));    // Er draws as P
    assert(glyph57_of(1061) == glyph57_of(88));    // Ha draws as X
    assert(glyph57_of(CYR_YO) == glyph57_of(69));  // Yo draws as E
}

test "a lower-case letter lights exactly the pixels of its capital, Latin and Cyrillic" {
    var c : i32 = 0;
    while (c < 32) {
        var gy : i32 = 0;
        while (gy < GH) {
            var gx : i32 = 0;
            while (gx < GW) {
                assert(glyph57_on(1072 + c, gx, gy) == glyph57_on(1040 + c, gx, gy));
                if (c < 26) {
                    assert(glyph57_on(97 + c, gx, gy) == glyph57_on(65 + c, gx, gy));
                }
                gx = gx + 1;
            }
            gy = gy + 1;
        }
        c = c + 1;
    }
}

test "an unknown code point draws as a question mark, and pixels outside the box are dark" {
    assert(glyph57_of(19968) == QMARK);            // U+4E00
    assert(glyph57_of(BAD) == QMARK);
    assert(glyph57_of(126) == QMARK);              // '~' is not in the font
    assert(!glyph57_on(65, 5, 0));
    assert(!glyph57_on(65, 0, 7));
    assert(!glyph57_on(65, 0 - 1, 0));
    assert(glyph57_on(65, 0, 6));                  // A's left leg reaches the base line
}
