// SPDX-License-Identifier: Apache-2.0
; T27F UI development history, the typed record and its validator (Refs gHashTag/t27#13214, epic #13214)
; Why: the owner asked that every visual step be filed as a history (BEFORE, tokens, AFTER, DIFF, what is left) and that the record be typed,
;   not hand-written prose and not YAML. This module is the schema (UiStep) and the rules a record must pass (uh_validate). A step lives in
;   its own spec (ui_history_s01, s02, ...) as a function returning a UiStep, and ui_history_log lists the steps in order
; Fields of a step: seq, step_id, date, commit, branch, theme, viewport, scale, before_paths, after_paths, diff_paths, changed tokens (name,
;   before, after, three parallel lists), intended_change, measured_effect (a list of measured facts, one per entry), limitations (a list),
;   status (DRAFT, REVIEW, APPROVED, BLOCKED) and visual_review (PENDING_OWNER, OWNER_ACCEPTED, OWNER_REJECTED)
; Rules, each with its own error code and a negative control in the tests:
;   every text field is non-blank; every list has 1 to 12 entries, none blank, none repeated; a path is never in two of the three lists
;   (a frame is never reused or overwritten, BEFORE and AFTER are different files); a changed token really changed (before differs from after);
;   a step names at least one measured fact and at least one limitation; seq starts at 1 and each step is the previous one plus 1
;   (append-only, no gaps, no reuse); a step is APPROVED exactly when the owner has accepted the frames, so nothing but the owner's review
;   turns a record into an approved one and an unreviewed record can never claim to look better
; Not checked here, because a spec cannot read a file or look inside a string: that a path exists, that it ends in .png, that a text is ASCII
;   or free of a home path. The scan and own-language gates check the file; a host job checks the paths. A passing record says the shape
;   and the honesty rules hold, not that a frame looks good
; All arithmetic is u32. ASCII only (L3)

module T27fUiHistory;

pub const UH_CAP : u32 = 12;

pub const UH_DRAFT : u32 = 0;
pub const UH_REVIEW : u32 = 1;
pub const UH_APPROVED : u32 = 2;
pub const UH_BLOCKED : u32 = 3;

pub const UH_PENDING_OWNER : u32 = 0;
pub const UH_OWNER_ACCEPTED : u32 = 1;
pub const UH_OWNER_REJECTED : u32 = 2;

pub const UH_OK : u32 = 0;
pub const UH_E_SEQ : u32 = 1;
pub const UH_E_ID : u32 = 2;
pub const UH_E_DATE : u32 = 3;
pub const UH_E_COMMIT : u32 = 4;
pub const UH_E_BRANCH : u32 = 5;
pub const UH_E_THEME : u32 = 6;
pub const UH_E_VIEWPORT : u32 = 7;
pub const UH_E_SCALE : u32 = 8;
pub const UH_E_BEFORE : u32 = 9;
pub const UH_E_AFTER : u32 = 10;
pub const UH_E_DIFF : u32 = 11;
pub const UH_E_SHARED : u32 = 12;
pub const UH_E_TOKENS : u32 = 13;
pub const UH_E_INTENT : u32 = 14;
pub const UH_E_MEASURED : u32 = 15;
pub const UH_E_LIMITS : u32 = 16;
pub const UH_E_STATUS : u32 = 17;
pub const UH_E_REVIEW : u32 = 18;
pub const UH_E_APPROVAL : u32 = 19;

pub struct UiStep {
    seq: u32,
    step_id: str,
    date: str,
    commit: str,
    branch: str,
    theme: str,
    viewport: str,
    scale: str,
    before_n: u32,
    before_paths: [12]str,
    after_n: u32,
    after_paths: [12]str,
    diff_n: u32,
    diff_paths: [12]str,
    token_n: u32,
    token_names: [12]str,
    token_before: [12]str,
    token_after: [12]str,
    intended_change: str,
    measured_n: u32,
    measured: [12]str,
    limit_n: u32,
    limits: [12]str,
    status: u32,
    visual_review: u32,
}

; a text field must say something
pub fn uh_blank(s: str) -> bool {
    let x : str = s;
    let b : bool = x == "";
    return b;
}

; a list of 1 to 12 entries, none blank, none repeated
pub fn uh_list_ok(items: [12]str, n: u32) -> bool {
    if n == 0 {
        return false;
    }
    if n > UH_CAP {
        return false;
    }
    var a : u32 = 0;
    while a < n {
        let ia : str = items[a];
        let blank : bool = ia == "";
        if blank == true {
            return false;
        }
        var b : u32 = a + 1;
        while b < n {
            let ib : str = items[b];
            let same : bool = ia == ib;
            if same == true {
                return false;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return true;
}

; no entry of the first list is an entry of the second (counts are already checked, a count over 12 refuses)
pub fn uh_disjoint(a: [12]str, an: u32, b: [12]str, bn: u32) -> bool {
    if an > UH_CAP {
        return false;
    }
    if bn > UH_CAP {
        return false;
    }
    var i : u32 = 0;
    while i < an {
        let ia : str = a[i];
        var j : u32 = 0;
        while j < bn {
            let jb : str = b[j];
            let same : bool = ia == jb;
            if same == true {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

; the changed tokens: names listed once, a before and an after for each, and the two differ
pub fn uh_tokens_ok(names: [12]str, before: [12]str, after: [12]str, n: u32) -> bool {
    let named : bool = uh_list_ok(names, n);
    if named == false {
        return false;
    }
    var i : u32 = 0;
    while i < n {
        let b : str = before[i];
        let a : str = after[i];
        let no_before : bool = b == "";
        let no_after : bool = a == "";
        let same : bool = b == a;
        if no_before == true {
            return false;
        }
        if no_after == true {
            return false;
        }
        if same == true {
            return false;
        }
        i = i + 1;
    }
    return true;
}

; append-only: the next step is exactly the previous seq plus 1
pub fn uh_next_seq_ok(prev_seq: u32, seq: u32) -> bool {
    return seq == prev_seq + 1;
}

; 0 when the record holds every rule, else the code of the first rule it breaks
pub fn uh_validate(st: UiStep) -> u32 {
    if st.seq == 0 {
        return UH_E_SEQ;
    }
    if uh_blank(st.step_id) == true {
        return UH_E_ID;
    }
    if uh_blank(st.date) == true {
        return UH_E_DATE;
    }
    if uh_blank(st.commit) == true {
        return UH_E_COMMIT;
    }
    if uh_blank(st.branch) == true {
        return UH_E_BRANCH;
    }
    if uh_blank(st.theme) == true {
        return UH_E_THEME;
    }
    if uh_blank(st.viewport) == true {
        return UH_E_VIEWPORT;
    }
    if uh_blank(st.scale) == true {
        return UH_E_SCALE;
    }
    if uh_list_ok(st.before_paths, st.before_n) == false {
        return UH_E_BEFORE;
    }
    if uh_list_ok(st.after_paths, st.after_n) == false {
        return UH_E_AFTER;
    }
    if uh_list_ok(st.diff_paths, st.diff_n) == false {
        return UH_E_DIFF;
    }
    if uh_disjoint(st.before_paths, st.before_n, st.after_paths, st.after_n) == false {
        return UH_E_SHARED;
    }
    if uh_disjoint(st.before_paths, st.before_n, st.diff_paths, st.diff_n) == false {
        return UH_E_SHARED;
    }
    if uh_disjoint(st.after_paths, st.after_n, st.diff_paths, st.diff_n) == false {
        return UH_E_SHARED;
    }
    if uh_tokens_ok(st.token_names, st.token_before, st.token_after, st.token_n) == false {
        return UH_E_TOKENS;
    }
    if uh_blank(st.intended_change) == true {
        return UH_E_INTENT;
    }
    if uh_list_ok(st.measured, st.measured_n) == false {
        return UH_E_MEASURED;
    }
    if uh_list_ok(st.limits, st.limit_n) == false {
        return UH_E_LIMITS;
    }
    if st.status > UH_BLOCKED {
        return UH_E_STATUS;
    }
    if st.visual_review > UH_OWNER_REJECTED {
        return UH_E_REVIEW;
    }
    if st.status == UH_APPROVED {
        if st.visual_review != UH_OWNER_ACCEPTED {
            return UH_E_APPROVAL;
        }
    }
    if st.visual_review == UH_OWNER_ACCEPTED {
        if st.status != UH_APPROVED {
            return UH_E_APPROVAL;
        }
    }
    return UH_OK;
}

; a small valid step, for the negative controls below and for other modules' tests
const UHS_BEFORE : [12]str = ["a/before_1.png", "a/before_2.png", "", "", "", "", "", "", "", "", "", ""];
const UHS_AFTER : [12]str = ["a/after_1.png", "a/after_2.png", "", "", "", "", "", "", "", "", "", ""];
const UHS_DIFF : [12]str = ["a/diff_1.png", "", "", "", "", "", "", "", "", "", "", ""];
const UHS_TOK_NAMES : [12]str = ["space.card.padding", "space.action.gap", "", "", "", "", "", "", "", "", "", ""];
const UHS_TOK_BEFORE : [12]str = ["8", "8", "", "", "", "", "", "", "", "", "", ""];
const UHS_TOK_AFTER : [12]str = ["16", "10", "", "", "", "", "", "", "", "", "", ""];
const UHS_MEASURED : [12]str = ["the card is 230 high", "", "", "", "", "", "", "", "", "", "", ""];
const UHS_LIMITS : [12]str = ["no person has looked at the frames", "", "", "", "", "", "", "", "", "", "", ""];

pub fn uh_sample() -> UiStep {
    var st : UiStep = UiStep {
        seq: 1,
        step_id: "ui-sample-step-01",
        date: "2026-11-07",
        commit: "0000000000",
        branch: "sample/branch",
        theme: "t0",
        viewport: "375",
        scale: "100",
        before_n: 2,
        before_paths: UHS_BEFORE,
        after_n: 2,
        after_paths: UHS_AFTER,
        diff_n: 1,
        diff_paths: UHS_DIFF,
        token_n: 2,
        token_names: UHS_TOK_NAMES,
        token_before: UHS_TOK_BEFORE,
        token_after: UHS_TOK_AFTER,
        intended_change: "more room around the content",
        measured_n: 1,
        measured: UHS_MEASURED,
        limit_n: 1,
        limits: UHS_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test the_sample_step_passes_every_rule {
    let st : UiStep = uh_sample();
    assert uh_validate(st) == UH_OK;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
}

test a_blank_text_field_is_refused_by_its_own_code {
    var st : UiStep = uh_sample();
    st.step_id = "";
    assert uh_validate(st) == UH_E_ID;
    st = uh_sample();
    st.date = "";
    assert uh_validate(st) == UH_E_DATE;
    st = uh_sample();
    st.commit = "";
    assert uh_validate(st) == UH_E_COMMIT;
    st = uh_sample();
    st.branch = "";
    assert uh_validate(st) == UH_E_BRANCH;
    st = uh_sample();
    st.theme = "";
    assert uh_validate(st) == UH_E_THEME;
    st = uh_sample();
    st.viewport = "";
    assert uh_validate(st) == UH_E_VIEWPORT;
    st = uh_sample();
    st.scale = "";
    assert uh_validate(st) == UH_E_SCALE;
    st = uh_sample();
    st.intended_change = "";
    assert uh_validate(st) == UH_E_INTENT;
}

test seq_zero_is_refused_and_the_chain_is_plus_one {
    var st : UiStep = uh_sample();
    st.seq = 0;
    assert uh_validate(st) == UH_E_SEQ;
    assert uh_next_seq_ok(1, 2) == true;
    assert uh_next_seq_ok(1, 1) == false;
    assert uh_next_seq_ok(1, 3) == false;
    assert uh_next_seq_ok(2, 1) == false;
}

test a_path_list_needs_one_to_twelve_distinct_entries {
    var st : UiStep = uh_sample();
    st.before_n = 0;
    assert uh_validate(st) == UH_E_BEFORE;
    st = uh_sample();
    st.after_n = 13;
    assert uh_validate(st) == UH_E_AFTER;
    st = uh_sample();
    st.diff_n = 2;
    assert uh_validate(st) == UH_E_DIFF;
    st = uh_sample();
    st.before_n = 3;
    assert uh_validate(st) == UH_E_BEFORE;
    st = uh_sample();
    st.before_paths[1] = "a/before_1.png";
    assert uh_validate(st) == UH_E_BEFORE;
}

test a_frame_cannot_be_reused_across_the_three_lists {
    var st : UiStep = uh_sample();
    st.after_paths[0] = "a/before_2.png";
    assert uh_validate(st) == UH_E_SHARED;
    st = uh_sample();
    st.diff_paths[0] = "a/before_1.png";
    assert uh_validate(st) == UH_E_SHARED;
    st = uh_sample();
    st.diff_paths[0] = "a/after_2.png";
    assert uh_validate(st) == UH_E_SHARED;
}

test a_changed_token_must_really_change {
    var st : UiStep = uh_sample();
    st.token_after[0] = "8";
    assert uh_validate(st) == UH_E_TOKENS;
    st = uh_sample();
    st.token_n = 0;
    assert uh_validate(st) == UH_E_TOKENS;
    st = uh_sample();
    st.token_names[1] = "space.card.padding";
    assert uh_validate(st) == UH_E_TOKENS;
    st = uh_sample();
    st.token_before[1] = "";
    assert uh_validate(st) == UH_E_TOKENS;
    st = uh_sample();
    st.token_after[1] = "";
    assert uh_validate(st) == UH_E_TOKENS;
}

test a_step_names_a_measured_fact_and_a_limitation {
    var st : UiStep = uh_sample();
    st.measured_n = 0;
    assert uh_validate(st) == UH_E_MEASURED;
    st = uh_sample();
    st.limit_n = 0;
    assert uh_validate(st) == UH_E_LIMITS;
    st = uh_sample();
    st.limits[0] = "";
    assert uh_validate(st) == UH_E_LIMITS;
}

test status_and_review_stay_in_range {
    var st : UiStep = uh_sample();
    st.status = 4;
    assert uh_validate(st) == UH_E_STATUS;
    st = uh_sample();
    st.visual_review = 3;
    assert uh_validate(st) == UH_E_REVIEW;
    st = uh_sample();
    st.status = UH_BLOCKED;
    assert uh_validate(st) == UH_OK;
    st = uh_sample();
    st.status = UH_REVIEW;
    assert uh_validate(st) == UH_OK;
}

test nothing_but_the_owners_acceptance_makes_a_step_approved {
    var st : UiStep = uh_sample();
    st.status = UH_APPROVED;
    assert uh_validate(st) == UH_E_APPROVAL;
    st.visual_review = UH_OWNER_REJECTED;
    assert uh_validate(st) == UH_E_APPROVAL;
    st.visual_review = UH_OWNER_ACCEPTED;
    assert uh_validate(st) == UH_OK;
    st = uh_sample();
    st.visual_review = UH_OWNER_ACCEPTED;
    assert uh_validate(st) == UH_E_APPROVAL;
    st = uh_sample();
    st.visual_review = UH_OWNER_REJECTED;
    assert uh_validate(st) == UH_OK;
}

test the_helpers_hold_their_own_edges {
    assert uh_blank("") == true;
    assert uh_blank("x") == false;
    var a : [12]str = UHS_BEFORE;
    var b : [12]str = UHS_AFTER;
    assert uh_list_ok(a, 2) == true;
    assert uh_list_ok(a, 3) == false;
    assert uh_disjoint(a, 2, b, 2) == true;
    assert uh_disjoint(a, 2, a, 1) == false;
    assert uh_disjoint(a, 13, b, 2) == false;
    assert uh_disjoint(a, 2, b, 13) == false;
}
