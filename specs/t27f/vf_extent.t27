// SPDX-License-Identifier: Apache-2.0
; T27F-006 vf_extent: where the content of a card ends, and whether a layout moves when the width changes
; Refs gHashTag/t27#13214, epic #13214
; vf_meaning says where each box sits next to its sibling; vf_extent says how much of the card the boxes use and compares two widths
; Per layout: the right and bottom edge of the content (every node but the root), the free space to the right and below, and that space as a rounded percent of the card
; Between two layouts: how many non-root nodes have a different rectangle, so "the layout is the same at 768 as at 375" is a count, not an impression
; It states facts only: no breakpoint, no "too empty" threshold. The reader decides whether 73 percent free is a fault
; It is NOT a pixel check and NOT a proof that the card looks good
; Reads VfLayout from specs/t27f/vf_layout.t27, edits nothing
; All arithmetic is u32 and non-negative: compare before subtracting

module t27f_vf_extent;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_px_card;

; right edge (x + w) of the content: the largest over every node except node 0, the card itself
pub fn vf_content_right(l: VfLayout) -> u32 {
    var best : u32 = 0;
    var i : u32 = 1;
    while i < l.node_count {
        var edge : u32 = l.x[i] + l.w[i];
        if edge > best {
            best = edge;
        }
        i = i + 1;
    }
    return best;
}

; bottom edge (y + h) of the content, same rule
pub fn vf_content_bottom(l: VfLayout) -> u32 {
    var best : u32 = 0;
    var i : u32 = 1;
    while i < l.node_count {
        var edge : u32 = l.y[i] + l.h[i];
        if edge > best {
            best = edge;
        }
        i = i + 1;
    }
    return best;
}

; pixels between the content and the right edge of the card; 0 when the content reaches or passes it
pub fn vf_free_right(l: VfLayout) -> u32 {
    var used : u32 = vf_content_right(l);
    if used >= l.w[0] {
        return 0;
    }
    return l.w[0] - used;
}

; pixels between the content and the bottom edge of the card; 0 when the content reaches or passes it
pub fn vf_free_bottom(l: VfLayout) -> u32 {
    var used : u32 = vf_content_bottom(l);
    if used >= l.h[0] {
        return 0;
    }
    return l.h[0] - used;
}

; the free width as a percent of the card width, rounded to the nearest whole percent; 0 for a card with no width
pub fn vf_free_right_pct(l: VfLayout) -> u32 {
    if l.w[0] == 0 {
        return 0;
    }
    return (vf_free_right(l) * 100 + l.w[0] / 2) / l.w[0];
}

; how many non-root nodes have a different x, y, w or h in b than in a (the two layouts must hold the same nodes)
pub fn vf_moved(a: VfLayout, b: VfLayout) -> u32 {
    var n : u32 = a.node_count;
    if b.node_count > n {
        n = b.node_count;
    }
    var moved : u32 = 0;
    var i : u32 = 1;
    while i < n {
        var same : bool = true;
        if a.x[i] != b.x[i] {
            same = false;
        }
        if a.y[i] != b.y[i] {
            same = false;
        }
        if a.w[i] != b.w[i] {
            same = false;
        }
        if a.h[i] != b.h[i] {
            same = false;
        }
        if same == false {
            moved = moved + 1;
        }
        i = i + 1;
    }
    return moved;
}

test content_edges {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    assert vf_content_right(l) == 208;
    assert vf_content_bottom(l) == 184;
    assert vf_free_bottom(l) == 8;
}

test free_width_at_each_viewport {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    assert vf_free_right(l1) == 167;
    assert vf_free_right_pct(l1) == 45;
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    assert vf_free_right(l2) == 560;
    assert vf_free_right_pct(l2) == 73;
    var g3 : VfGraph = vf_px_card(1280);
    var l3 : VfLayout = vf_layout(g3);
    assert vf_free_right(l3) == 1072;
    assert vf_free_right_pct(l3) == 84;
}

test the_layout_does_not_move_with_the_width {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    var g3 : VfGraph = vf_px_card(1280);
    var l3 : VfLayout = vf_layout(g3);
    assert vf_moved(l1, l2) == 0;
    assert vf_moved(l1, l3) == 0;
    assert vf_moved(l2, l3) == 0;
    assert vf_moved(l1, l1) == 0;
}

test negative_controls {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    var m : VfLayout = vf_layout(g);
    m.x[6] = 300;
    assert vf_moved(l, m) == 1;
    assert vf_content_right(m) == 396;
    assert vf_free_right(m) == 0;
    assert vf_free_right_pct(m) == 0;
    var n : VfLayout = vf_layout(g);
    n.y[7] = 190;
    assert vf_content_bottom(n) == 230;
    assert vf_free_bottom(n) == 0;
}
