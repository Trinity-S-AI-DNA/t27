module T27fDoctorWidget;

use t27f::doctor_menu_integration::doctor_panel_state;
use t27f::doctor_menu_integration::get_doctor_menu_items;
use t27f::doctor_menu_integration::get_doctor_status;

// Widget constants
pub const WIDGET_ID : u32 = 2001;
pub const WIDGET_NAME : str = "System Doctor";
pub const WIDGET_VERSION : str = "1.0.0";

// Widget layout constants
pub const WIDGET_WIDTH : u32 = 300;
pub const WIDGET_HEIGHT : u32 = 400;
pub const WIDGET_PADDING : u32 = 16;
pub const BUTTON_HEIGHT : u32 = 40;
pub const BUTTON_GAP : u32 = 12;
pub const STATUS_BAR_HEIGHT : u32 = 60;

// Widget state
pub var widget_state : struct {
    is_active: bool,
    selected_action: u32,
    last_update: str,
    error_message: str,
    is_processing: bool,
    progress: f64
} = struct {
    is_active: false,
    selected_action: 0,
    last_update: "",
    error_message: "",
    is_processing: false,
    progress: 0.0
};

// Initialize widget
pub fn init_widget() -> void {
    widget_state = struct {
        is_active: false,
        selected_action: 0,
        last_update: @concat("Initialized: ", timestamp()),
        error_message: "",
        is_processing: false,
        progress: 0.0
    };
}

// Render widget content
pub fn render_widget(x: i64, y: i64, w: i64, h: i64) -> []struct {
    type: str,
    x: i64,
    y: i64,
    width: i64,
    height: i64,
    content: str,
    action: str
} {
    var elements : []struct {
        type: str,
        x: i64,
        y: i64,
        width: i64,
        height: i64,
        content: str,
        action: str
    } = [];

    // Status bar
    elements = append(elements, struct {
        type: "status_bar",
        x: x,
        y: y,
        width: w,
        height: @as(i64, STATUS_BAR_HEIGHT),
        content: get_doctor_status(),
        action: "refresh_status"
    });

    // Doctor title
    elements = append(elements, struct {
        type: "title",
        x: x + WIDGET_PADDING,
        y: y + STATUS_BAR_HEIGHT + 10,
        width: w - 2 * WIDGET_PADDING,
        height: 30,
        content: "🏥 System Doctor",
        action: ""
    });

    // Menu items as buttons
    const menu_items : []struct {
        id: u32,
        name: str,
        description: str,
        icon: str
    } = get_doctor_menu_items();

    var button_y : i64 = y + STATUS_BAR_HEIGHT + 50;
    for (var i: u32 = 0; i < menu_items.len; i += 1) {
        elements = append(elements, struct {
            type: "button",
            x: x + WIDGET_PADDING,
            y: button_y,
            width: w - 2 * WIDGET_PADDING,
            height: @as(i64, BUTTON_HEIGHT),
            content: @concat(menu_items[i].icon, " ", menu_items[i].name),
            action: @concat("action_", @toString(menu_items[i].id))
        });
        button_y += BUTTON_HEIGHT + BUTTON_GAP;
    }

    // Progress indicator if processing
    if (widget_state.is_processing) {
        elements = append(elements, struct {
            type: "progress",
            x: x + WIDGET_PADDING,
            y: h - 40,
            width: w - 2 * WIDGET_PADDING,
            height: 20,
            content: @concat("Progress: ", @toString(@as(u32, @intFromFloat(widget_state.progress * 100))), "%"),
            action: ""
        });
    }

    // Error message if any
    if (widget_state.error_message.len > 0) {
        elements = append(elements, struct {
            type: "error",
            x: x + WIDGET_PADDING,
            y: h - 80,
            width: w - 2 * WIDGET_PADDING,
            height: 30,
            content: widget_state.error_message,
            action: "clear_error"
        });
    }

    return elements;
}

// Handle widget interaction
pub fn handle_widget_interaction(x: i64, y: i64, w: i64, h: i64) -> struct {
    action: str,
    params: []struct {
        key: str,
        value: str
    }
} {
    var result : struct {
        action: str,
        params: []struct {
            key: str,
            value: str
        }
    } = struct {
        action: "",
        params: []
    };

    // Check button clicks
    const menu_items : []struct {
        id: u32,
        name: str,
        description: str,
        icon: str
    } = get_doctor_menu_items();

    var button_y : i64 = STATUS_BAR_HEIGHT + 50;
    for (var i: u32 = 0; i < menu_items.len; i += 1) {
        if (x >= WIDGET_PADDING and x <= w - WIDGET_PADDING and
            y >= button_y and y <= button_y + BUTTON_HEIGHT) {
            result.action = @concat("execute_action_", @toString(menu_items[i].id));
            widget_state.selected_action = menu_items[i].id;
            break;
        }
        button_y += BUTTON_HEIGHT + BUTTON_GAP;
    }

    // Check refresh status click
    if (y <= STATUS_BAR_HEIGHT) {
        result.action = "refresh_status";
        widget_state.last_update = @concat("Updated: ", timestamp());
    }

    return result;
}

// Execute widget action
pub fn execute_widget_action(action: str) -> void {
    switch (action) {
        case "action_1001": // Open Doctor panel
            open_doctor_panel();
            break;

        case "action_1002": // Health Check
            run_widget_health_check();
            break;

        case "action_1003": // Clean Cache
            run_widget_clean_cache();
            break;

        case "action_1004": // Optimize
            run_widget_optimize();
            break;

        case "action_1005": // Repair
            run_widget_repair();
            break;

        case "refresh_status":
            refresh_status();
            break;

        case "clear_error":
            widget_state.error_message = "";
            break;
    }
}

// Open Doctor panel
fn open_doctor_panel() -> void {
    widget_state.is_active = true;
    widget_state.last_update = @concat("Panel opened: ", timestamp());
    log_message("🏥 Doctor panel opened");
}

// Run health check from widget
fn run_widget_health_check() -> void {
    widget_state.is_processing = true;
    widget_state.progress = 0.0;
    widget_state.error_message = "";

    log_message("🔍 Starting health check from widget...");

    // Simulate health check
    simulate_widget_progress();
}

// Run cache clean from widget
fn run_widget_clean_cache() -> void {
    widget_state.is_processing = true;
    widget_state.progress = 0.0;
    widget_state.error_message = "";

    log_message("🧹 Starting cache clean from widget...");

    // Simulate cache clean
    simulate_widget_progress();
}

// Run optimization from widget
fn run_widget_optimize() -> void {
    widget_state.is_processing = true;
    widget_state.progress = 0.0;
    widget_state.error_message = "";

    log_message("⚡ Starting optimization from widget...");

    // Simulate optimization
    simulate_widget_progress();
}

// Run repair from widget
fn run_widget_repair() -> void {
    widget_state.is_processing = true;
    widget_state.progress = 0.0;
    widget_state.error_message = "";

    log_message("🔧 Starting repair from widget...");

    // Simulate repair
    simulate_widget_progress();
}

// Simulate progress for widget actions
fn simulate_widget_progress() -> void {
    // In real implementation, this would be async
    // For now, simulate immediate completion
    widget_state.progress = 1.0;
    widget_state.is_processing = false;

    // Update based on action type
    if (widget_state.selected_action == 1002) {
        widget_state.last_update = "✅ Health check completed";
    } else if (widget_state.selected_action == 1003) {
        widget_state.last_update = "✅ Cache cleaned successfully";
    } else if (widget_state.selected_action == 1004) {
        widget_state.last_update = "✅ System optimized";
    } else if (widget_state.selected_action == 1005) {
        widget_state.last_update = "✅ System repaired";
    }
}

// Refresh status
fn refresh_status() -> void {
    widget_state.last_update = @concat("Status refreshed: ", timestamp());
    doctor_panel_state.last_check_time = timestamp();
}

// Get timestamp (simplified)
fn timestamp() -> str {
    return "2026-10-21 12:00:00"; // In real implementation, get actual time
}

// Log message
fn log_message(message: str) -> void {
    // In real implementation, this would write to a log file
    // For now, just output
    print(message);
}

// Test widget functionality
test widget_initialization {
    init_widget();

    assert widget_state.is_active == false;
    assert widget_state.selected_action == 0;
    assert widget_state.error_message == "";
    assert widget_state.is_processing == false;
    assert widget_state.progress == 0.0;

    record_experience("Doctor widget initialization test passed");
}

// Test widget rendering
test widget_rendering {
    init_widget();

    const elements : []struct {
        type: str,
        x: i64,
        y: i64,
        width: i64,
        height: i64,
        content: str,
        action: str
    } = render_widget(0, 0, 300, 400);

    assert elements.len > 0;

    // Check status bar exists
    var has_status_bar : bool = false;
    for (var i: u32 = 0; i < elements.len; i += 1) {
        if (elements[i].type == "status_bar") {
            has_status_bar = true;
            break;
        }
    }
    assert has_status_bar;

    record_experience("Doctor widget rendering test passed");
}

// Test widget interaction
test widget_interaction {
    init_widget();

    const result : struct {
        action: str,
        params: []struct {
            key: str,
            value: str
        }
    } = handle_widget_interaction(50, 100, 300, 400);

    assert result.action.len >= 0; // Action should be detected

    record_experience("Doctor widget interaction test passed");
}