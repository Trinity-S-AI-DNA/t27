// SPDX-License-Identifier: Apache-2.0
; T27F-007 ring 9: vf_brand is the brand book of the t27.ai look as a spec, the rules are functions and the examples are tests, so the book cannot drift from vf_theme
; Refs gHashTag/t27#13214
; Where each token comes from: vf_theme.t27, which copied them from the live CSS of https://t27.ai/#/course read on 2026-11-07
; Colour: black ground 0x000000, white text, accent green 0x00FF88, gold 0xFFD700, muted 0x888888, card border 0x333333
; Shape: card radius 12 px, card padding 20 px, card gap 10 px
; Type: Outfit 400 and 800 for display, JetBrains Mono 400 and 500 for code; the golden type scale is TH_FONT_REM
; This module holds no token of its own: a colour or size is read from vf_theme or vf_type, only the brand rules below are new
; The paper theme is our own light swap and is not on that page; its accent for small text is accent-dark 0x007A45
; Measured, not assumed: one step of the type scale is 1272 per mille (the square root of phi) from step 3 to step 7 and 1618 (phi) from step 7 to step 9
; so two steps of 1272 make one phi; the three steps below step 3 are small text sizes and are not claimed golden
; Contrast floor: a luma gap of 100 on the 0..255 scale (luma 299 587 114 over 1000, the W3C brightness difference formula)
; 100 sits below the weakest brand pair (gold on paper, gap 118) and above the two known mistakes (card border grey on black, gap 51; bright accent on paper, gap 90)
; NOT claimed: no logo drawing and no logo geometry beyond the clear space rule; contrast here is a luma floor, not WCAG relative luminance and not a ratio
; NOT claimed: no hover, focus or disabled state is checked, no font metrics beyond the vf_type size limits, no claim that the live page meets every rule
; Limits: all arithmetic is u32 and non-negative, compare before subtracting; an unknown theme or role is refused, never passed

module t27f_vf_brand;
use t27f::vf_theme::TH_T27;
use t27f::vf_theme::TH_PAPER;
use t27f::vf_theme::TH_THEMES;
use t27f::vf_theme::TH_BG;
use t27f::vf_theme::TH_TEXT;
use t27f::vf_theme::TH_MUTED;
use t27f::vf_theme::TH_ACCENT;
use t27f::vf_theme::TH_ACCENT_DARK;
use t27f::vf_theme::TH_GOLD;
use t27f::vf_theme::TH_BORDER;
use t27f::vf_theme::TH_CARD_BORDER;
use t27f::vf_theme::TH_CARD_BORDER_HOVER;
use t27f::vf_theme::TH_CARD_DESC;
use t27f::vf_theme::TH_CARD_FOOT;
use t27f::vf_theme::TH_ROLES;
use t27f::vf_theme::TH_FONT_REM;
use t27f::vf_theme::TH_FONT_STEPS;
use t27f::vf_theme::TH_RADIUS_CARD;
use t27f::vf_theme::TH_PAD_CARD;
use t27f::vf_theme::TH_GAP_CARD;
use t27f::vf_theme::TH_FONT_DISPLAY;
use t27f::vf_theme::TH_FONT_MONO;
use t27f::vf_theme::TH_FONT_W_LO;
use t27f::vf_theme::TH_FONT_W_HI;
use t27f::vf_theme::th_color;
use t27f::vf_theme::th_luma_gap;
use t27f::vf_theme::th_bp;
use t27f::vf_theme::th_font_px;
use t27f::vf_theme::th_font_name;
use t27f::vf_theme::th_body_milli_px;
use t27f::vf_type::VT_MIN_PX;
use t27f::vf_type::VT_MAX_PX;
use t27f::vf_type::VT_REGULAR;
use t27f::vf_type::VT_BOLD;
use t27f::vf_guard::gd_layer_name;
use t27f::vf_guard::GL_THEME;

; the luma gap a text colour must have against its ground
pub const BB_LUMA_FLOOR : u32 = 100;

; the five named text-on-ground pairs: text, muted, accent, gold and card description, each on the page ground
pub const BB_PAIRS : u32 = 5;
pub const BB_PAIR_FG : [5]u32 = [1, 2, 3, 5, 9];

; the type scale claim: a step ratio is golden when it is within 3 percent of 1272 or of 1618
pub const BB_NEAR_PCT : u32 = 3;
pub const BB_HALF_GOLD_MILLI : u32 = 1272;
pub const BB_GOLD_MILLI : u32 = 1618;
pub const BB_SCALE_FIRST : u32 = 3;

; steps per breakpoint (phone, tablet, desktop) into TH_FONT_REM: headline f2 f4 f5 = 26 42 68 px, body f0 = 16 px on all three
; step 9 (110 px) is not used because vf_type draws at most 80 px
pub const BB_HEAD_STEP : [3]u32 = [5, 7, 8];
pub const BB_BODY_STEP : [3]u32 = [3, 3, 3];
pub const BB_BODY_MIN_PX : u32 = 14;

pub const BB_LOGO_DIV : u32 = 4;

pub const BB_ROLE_NAMES : [11]str = ["bg", "text", "muted", "accent", "accent-dark", "gold", "border", "card-border", "card-border-hover", "card-desc", "card-foot"];

pub const BB_DONT_COUNT : u32 = 9;
pub const BB_DONTS : [9]str = [
    "no pixel font for brand text, Outfit is the display face and JetBrains Mono the code face",
    "no bright accent 0x00FF88 on paper, use accent-dark 0x007A45",
    "no text under 6 px",
    "no stretched logo, scale width and height together",
    "no second accent colour, green is the accent and gold marks badges only",
    "no gradient on text",
    "no Outfit weight other than 400 and 800",
    "no card radius other than 12 px",
    "no colour literal outside the theme layer"
];

pub fn bb_role_name(role: u32) -> str {
    if role >= TH_ROLES {
        return "";
    }
    return BB_ROLE_NAMES[role];
}

; the colour form of the rule: a text colour and its ground, both as rgb
pub fn bb_rgb_ok(fg: u32, bg: u32) -> bool {
    if th_luma_gap(fg, bg) >= BB_LUMA_FLOOR {
        return true;
    }
    return false;
}

; the theme form: an unknown theme or role is refused first, because the error colour magenta has luma 105 and would pass the floor against black
pub fn bb_pair_ok(theme: u32, fg_role: u32, bg_role: u32) -> bool {
    if theme >= TH_THEMES {
        return false;
    }
    if fg_role >= TH_ROLES {
        return false;
    }
    if bg_role >= TH_ROLES {
        return false;
    }
    return bb_rgb_ok(th_color(theme, fg_role), th_color(theme, bg_role));
}

; how many of the five named pairs pass on the page ground; on paper the accent pair uses accent-dark
pub fn bb_contrast_pairs_ok(theme: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < BB_PAIRS {
        var fg : u32 = BB_PAIR_FG[i];
        if fg == TH_ACCENT {
            if theme == TH_PAPER {
                fg = TH_ACCENT_DARK;
            }
        }
        let ok : bool = bb_pair_ok(theme, fg, TH_BG);
        if ok == true {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; the ratio of a step to the next one in per mille, 0 when there is no next step
pub fn bb_scale_ratio_milli(step: u32) -> u32 {
    if step >= TH_FONT_STEPS - 1 {
        return 0;
    }
    var next : u32 = step + 1;
    return TH_FONT_REM[next] * 1000 / TH_FONT_REM[step];
}

; x is within BB_NEAR_PCT percent of target; zero is never near
fn bb_near_milli(x: u32, target: u32) -> bool {
    if x == 0 {
        return false;
    }
    var d : u32 = 0;
    if x >= target {
        d = x - target;
    } else {
        d = target - x;
    }
    if d * 100 <= target * BB_NEAR_PCT {
        return true;
    }
    return false;
}

pub fn bb_ratio_golden(step: u32) -> bool {
    var r : u32 = bb_scale_ratio_milli(step);
    let half : bool = bb_near_milli(r, BB_HALF_GOLD_MILLI);
    if half == true {
        return true;
    }
    let full : bool = bb_near_milli(r, BB_GOLD_MILLI);
    if full == true {
        return true;
    }
    return false;
}

; every step ratio from step 3 up is a golden ratio, phi or its square root
pub fn bb_scale_is_golden() -> bool {
    var step : u32 = BB_SCALE_FIRST;
    while step < TH_FONT_STEPS - 1 {
        let g : bool = bb_ratio_golden(step);
        if g == false {
            return false;
        }
        step = step + 1;
    }
    return true;
}

; a size vf_type can draw: at least its minimum and at most its maximum
pub fn bb_min_px_ok(px: u32) -> bool {
    if px < VT_MIN_PX {
        return false;
    }
    if px > VT_MAX_PX {
        return false;
    }
    return true;
}

pub fn bb_headline_px(w: u32) -> u32 {
    var bp : u32 = th_bp(w);
    return th_font_px(BB_HEAD_STEP[bp]);
}

pub fn bb_body_px(w: u32) -> u32 {
    var bp : u32 = th_bp(w);
    return th_font_px(BB_BODY_STEP[bp]);
}

; clear space around a logo: a quarter of its size, rounded up, without overflow at the top of u32
pub fn bb_clearspace(logo_px: u32) -> u32 {
    var q : u32 = logo_px / BB_LOGO_DIV;
    if logo_px % BB_LOGO_DIV != 0 {
        q = q + 1;
    }
    return q;
}

pub fn bb_dont_count() -> u32 {
    return BB_DONT_COUNT;
}

pub fn bb_dont(i: u32) -> str {
    if i >= BB_DONT_COUNT {
        return "";
    }
    return BB_DONTS[i];
}

; the gap in milli-px between the brand body size and the live page body clamp at width w
fn bb_body_site_gap(w: u32) -> u32 {
    var site : u32 = th_body_milli_px(w);
    var mine : u32 = bb_body_px(w) * 1000;
    if mine >= site {
        return mine - site;
    }
    return site - mine;
}

; the tokens as the owner ordered them, read through vf_theme and vf_type: if the page moves, this test says so
test tokens_as_ordered {
    assert th_color(TH_T27, TH_BG) == 0x000000;
    assert th_color(TH_T27, TH_TEXT) == 0xFFFFFF;
    assert th_color(TH_T27, TH_ACCENT) == 0x00FF88;
    assert th_color(TH_T27, TH_GOLD) == 0xFFD700;
    assert th_color(TH_T27, TH_MUTED) == 0x888888;
    assert th_color(TH_T27, TH_CARD_BORDER) == 0x333333;
    assert TH_RADIUS_CARD == 12;
    assert TH_PAD_CARD == 20;
    assert TH_GAP_CARD == 10;
    let display : str = th_font_name(TH_FONT_DISPLAY);
    let mono : str = th_font_name(TH_FONT_MONO);
    assert display == "Outfit";
    assert mono == "JetBrains Mono";
    assert TH_FONT_W_LO[TH_FONT_DISPLAY] == 400;
    assert TH_FONT_W_HI[TH_FONT_DISPLAY] == 800;
    assert TH_FONT_W_LO[TH_FONT_MONO] == 400;
    assert TH_FONT_W_HI[TH_FONT_MONO] == 500;
    assert VT_REGULAR == TH_FONT_W_LO[TH_FONT_DISPLAY];
    assert VT_BOLD == TH_FONT_W_HI[TH_FONT_DISPLAY];
    assert VT_MIN_PX == 6;
    assert VT_MAX_PX == 80;
    let wrong : bool = mono == "Outfit";
    assert wrong == false;
}

test role_names_unique {
    var i : u32 = 0;
    while i < TH_ROLES {
        let a : str = bb_role_name(i);
        let e : str = "";
        let blank : bool = a == e;
        assert blank == false;
        var j : u32 = i + 1;
        while j < TH_ROLES {
            let b : str = bb_role_name(j);
            let same : bool = a == b;
            assert same == false;
            j = j + 1;
        }
        i = i + 1;
    }
    let n_bg : str = bb_role_name(TH_BG);
    let n_text : str = bb_role_name(TH_TEXT);
    let n_muted : str = bb_role_name(TH_MUTED);
    let n_accent : str = bb_role_name(TH_ACCENT);
    let n_dark : str = bb_role_name(TH_ACCENT_DARK);
    let n_gold : str = bb_role_name(TH_GOLD);
    let n_border : str = bb_role_name(TH_BORDER);
    let n_cb : str = bb_role_name(TH_CARD_BORDER);
    let n_cbh : str = bb_role_name(TH_CARD_BORDER_HOVER);
    let n_desc : str = bb_role_name(TH_CARD_DESC);
    let n_foot : str = bb_role_name(TH_CARD_FOOT);
    assert n_bg == "bg";
    assert n_text == "text";
    assert n_muted == "muted";
    assert n_accent == "accent";
    assert n_dark == "accent-dark";
    assert n_gold == "gold";
    assert n_border == "border";
    assert n_cb == "card-border";
    assert n_cbh == "card-border-hover";
    assert n_desc == "card-desc";
    assert n_foot == "card-foot";
}

; negative control for the name test: the comparison can be true, a blank is detected, an unknown role has no name
test role_names_control {
    let c1 : str = bb_role_name(3);
    let c2 : str = bb_role_name(3);
    let same : bool = c1 == c2;
    assert same == true;
    let past : str = bb_role_name(TH_ROLES);
    let far : str = bb_role_name(4000000000);
    let e : str = "";
    let past_blank : bool = past == e;
    let far_blank : bool = far == e;
    assert past_blank == true;
    assert far_blank == true;
    let gold : str = bb_role_name(TH_GOLD);
    let mixed : bool = gold == "accent";
    assert mixed == false;
}

test pairs_on_black {
    assert bb_pair_ok(TH_T27, TH_TEXT, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_MUTED, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_ACCENT, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_ACCENT_DARK, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_GOLD, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_CARD_DESC, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_CARD_FOOT, TH_BG) == true;
    assert bb_pair_ok(TH_T27, TH_BG, TH_TEXT) == true;
    assert bb_contrast_pairs_ok(TH_T27) == 5;
}

; negative control: the fails must fail, so the floor is not a constant true
test pairs_control {
    assert bb_pair_ok(TH_T27, TH_CARD_BORDER, TH_BG) == false;
    assert bb_pair_ok(TH_T27, TH_BORDER, TH_BG) == false;
    assert bb_pair_ok(TH_T27, TH_BG, TH_BG) == false;
    assert bb_pair_ok(TH_T27, TH_TEXT, TH_TEXT) == false;
    assert bb_pair_ok(TH_PAPER, TH_BORDER, TH_BG) == false;
    assert bb_pair_ok(TH_PAPER, TH_CARD_BORDER, TH_BG) == false;
    assert bb_pair_ok(TH_THEMES, TH_TEXT, TH_BG) == false;
    assert bb_pair_ok(7, TH_TEXT, TH_BG) == false;
    assert bb_pair_ok(TH_T27, TH_ROLES, TH_BG) == false;
    assert bb_pair_ok(TH_T27, TH_TEXT, TH_ROLES) == false;
    assert bb_pair_ok(TH_T27, 99, 99) == false;
    assert bb_contrast_pairs_ok(TH_THEMES) == 0;
    assert bb_contrast_pairs_ok(9) == 0;
}

test pairs_on_paper {
    assert bb_pair_ok(TH_PAPER, TH_TEXT, TH_BG) == true;
    assert bb_pair_ok(TH_PAPER, TH_MUTED, TH_BG) == true;
    assert bb_pair_ok(TH_PAPER, TH_ACCENT_DARK, TH_BG) == true;
    assert bb_pair_ok(TH_PAPER, TH_GOLD, TH_BG) == true;
    assert bb_pair_ok(TH_PAPER, TH_CARD_DESC, TH_BG) == true;
    assert bb_contrast_pairs_ok(TH_PAPER) == 5;
}

; the bright site colours do not carry over to paper, that is why paper has its own accent and gold
test paper_needs_its_own_colours {
    assert bb_rgb_ok(0x00FF88, 0xFFFFFF) == false;
    assert bb_rgb_ok(0xFFD700, 0xFFFFFF) == false;
    assert bb_rgb_ok(0x007A45, 0xFFFFFF) == true;
    assert bb_rgb_ok(0xB38F00, 0xFFFFFF) == true;
    assert th_luma_gap(0xB38F00, 0xFFFFFF) == 118;
    assert th_luma_gap(0x00FF88, 0xFFFFFF) == 90;
    assert th_luma_gap(0x333333, 0x000000) == 51;
}

; the floor is exact: luma 100 passes and luma 99 does not, because 299 587 114 sum to 1000
test floor_edge {
    assert BB_LUMA_FLOOR == 100;
    assert bb_rgb_ok(0x646464, 0x000000) == true;
    assert bb_rgb_ok(0x636363, 0x000000) == false;
    assert bb_rgb_ok(0x000000, 0x646464) == true;
    assert bb_rgb_ok(0x000000, 0x636363) == false;
}

test scale_ratios {
    assert bb_scale_ratio_milli(0) == 1082;
    assert bb_scale_ratio_milli(1) == 1077;
    assert bb_scale_ratio_milli(2) == 1142;
    assert bb_scale_ratio_milli(3) == 1272;
    assert bb_scale_ratio_milli(4) == 1272;
    assert bb_scale_ratio_milli(5) == 1271;
    assert bb_scale_ratio_milli(6) == 1272;
    assert bb_scale_ratio_milli(7) == 1618;
    assert bb_scale_ratio_milli(8) == 1618;
    assert bb_scale_ratio_milli(9) == 0;
    assert bb_scale_ratio_milli(10) == 0;
    assert bb_scale_ratio_milli(4294967295) == 0;
}

test scale_is_golden_from_step_3 {
    assert bb_scale_is_golden() == true;
    assert bb_ratio_golden(3) == true;
    assert bb_ratio_golden(4) == true;
    assert bb_ratio_golden(5) == true;
    assert bb_ratio_golden(6) == true;
    assert bb_ratio_golden(7) == true;
    assert bb_ratio_golden(8) == true;
    var step : u32 = 3;
    while step < 9 {
        let r : u32 = bb_scale_ratio_milli(step);
        let half : bool = bb_near_milli(r, 1272);
        let full : bool = bb_near_milli(r, 1618);
        var hit : u32 = 0;
        if half == true {
            hit = 1;
        }
        if full == true {
            hit = 1;
        }
        assert hit == 1;
        step = step + 1;
    }
    var two : u32 = bb_scale_ratio_milli(3) * bb_scale_ratio_milli(4) / 1000;
    assert bb_near_milli(two, BB_GOLD_MILLI) == true;
}

; negative control: the steps below step 3 are not claimed, and the near test has an exact edge
test scale_not_claimed_below {
    assert bb_ratio_golden(0) == false;
    assert bb_ratio_golden(1) == false;
    assert bb_ratio_golden(2) == false;
    assert bb_ratio_golden(9) == false;
    assert bb_ratio_golden(4294967295) == false;
    assert bb_near_milli(1272, 1272) == true;
    assert bb_near_milli(1310, 1272) == true;
    assert bb_near_milli(1311, 1272) == false;
    assert bb_near_milli(1234, 1272) == true;
    assert bb_near_milli(1233, 1272) == false;
    assert bb_near_milli(1618, 1272) == false;
    assert bb_near_milli(1272, 1618) == false;
    assert bb_near_milli(0, 1272) == false;
    var low : u32 = bb_scale_ratio_milli(0) * bb_scale_ratio_milli(1) / 1000;
    assert bb_near_milli(low, BB_GOLD_MILLI) == false;
}

test min_px {
    assert bb_min_px_ok(5) == false;
    assert bb_min_px_ok(6) == true;
    assert bb_min_px_ok(80) == true;
    assert bb_min_px_ok(81) == false;
    assert bb_min_px_ok(0) == false;
    assert bb_min_px_ok(4294967295) == false;
    assert bb_min_px_ok(16) == true;
    assert bb_min_px_ok(th_font_px(9)) == false;
}

test headline_and_body {
    assert bb_headline_px(375) == 26;
    assert bb_headline_px(600) == 26;
    assert bb_headline_px(601) == 42;
    assert bb_headline_px(768) == 42;
    assert bb_headline_px(1024) == 42;
    assert bb_headline_px(1025) == 68;
    assert bb_headline_px(1280) == 68;
    assert bb_headline_px(1920) == 68;
    assert bb_headline_px(375) < bb_headline_px(768);
    assert bb_headline_px(768) < bb_headline_px(1280);
    assert bb_min_px_ok(bb_headline_px(375)) == true;
    assert bb_min_px_ok(bb_headline_px(768)) == true;
    assert bb_min_px_ok(bb_headline_px(1280)) == true;
    assert bb_headline_px(375) > bb_body_px(375);
    assert bb_body_px(375) == 16;
    assert bb_body_px(768) == 16;
    assert bb_body_px(1280) == 16;
    assert bb_body_px(1920) == 16;
    assert bb_body_px(320) >= BB_BODY_MIN_PX;
    assert bb_body_px(375) >= BB_BODY_MIN_PX;
    assert bb_body_px(601) >= BB_BODY_MIN_PX;
    assert bb_body_px(1025) >= BB_BODY_MIN_PX;
    assert bb_body_px(3000) >= BB_BODY_MIN_PX;
    assert BB_BODY_MIN_PX == 14;
}

; each breakpoint step up in the headline is about one phi, and the body stays within one pixel of the live page clamp
test headline_golden_and_site_body {
    var r1 : u32 = bb_headline_px(768) * 1000 / bb_headline_px(375);
    var r2 : u32 = bb_headline_px(1280) * 1000 / bb_headline_px(768);
    assert r1 == 1615;
    assert r2 == 1619;
    assert bb_near_milli(r1, BB_GOLD_MILLI) == true;
    assert bb_near_milli(r2, BB_GOLD_MILLI) == true;
    assert bb_body_site_gap(375) == 800;
    assert bb_body_site_gap(1280) == 640;
    assert bb_body_site_gap(1400) == 800;
    assert bb_body_site_gap(1920) == 800;
    assert bb_body_site_gap(375) <= 1000;
    assert bb_body_site_gap(768) <= 1000;
    assert bb_body_site_gap(1280) <= 1000;
    assert bb_body_site_gap(1920) <= 1000;
}

; negative control: a body of f-2 (13 px) is under the floor, a phone-to-desktop jump is far from one phi, a headline is not a body
test headline_body_control {
    assert th_font_px(1) < BB_BODY_MIN_PX;
    assert th_font_px(2) >= BB_BODY_MIN_PX;
    var far : u32 = bb_headline_px(1280) * 1000 / bb_headline_px(375);
    assert far == 2615;
    assert bb_near_milli(far, BB_GOLD_MILLI) == false;
    assert bb_headline_px(1280) != bb_body_px(1280);
    assert bb_headline_px(375) != bb_body_px(375);
}

test clearspace {
    assert bb_clearspace(40) == 10;
    assert bb_clearspace(41) == 11;
    assert bb_clearspace(42) == 11;
    assert bb_clearspace(43) == 11;
    assert bb_clearspace(44) == 11;
    assert bb_clearspace(45) == 12;
    assert bb_clearspace(0) == 0;
    assert bb_clearspace(1) == 1;
    assert bb_clearspace(3) == 1;
    assert bb_clearspace(4) == 1;
    assert bb_clearspace(5) == 2;
    assert bb_clearspace(100) == 25;
    assert bb_clearspace(4294967295) == 1073741824;
    assert bb_clearspace(41) != 10;
    assert bb_clearspace(40) != 11;
}

test dont_list {
    assert bb_dont_count() >= 6;
    assert bb_dont_count() == 9;
    var i : u32 = 0;
    while i < bb_dont_count() {
        let d : str = bb_dont(i);
        let e : str = "";
        let blank : bool = d == e;
        assert blank == false;
        var j : u32 = i + 1;
        while j < bb_dont_count() {
            let d2 : str = bb_dont(j);
            let dup : bool = d == d2;
            assert dup == false;
            j = j + 1;
        }
        i = i + 1;
    }
}

; negative control for the dont list: past the end there is no rule, and the rules that carry a number agree with the tokens
test dont_control {
    let past : str = bb_dont(bb_dont_count());
    let far : str = bb_dont(4000000000);
    let e : str = "";
    let past_blank : bool = past == e;
    let far_blank : bool = far == e;
    assert past_blank == true;
    assert far_blank == true;
    let d2 : str = bb_dont(2);
    let d7 : str = bb_dont(7);
    let d8 : str = bb_dont(8);
    assert d2 == "no text under 6 px";
    assert d7 == "no card radius other than 12 px";
    assert d8 == "no colour literal outside the theme layer";
    assert VT_MIN_PX == 6;
    assert TH_RADIUS_CARD == 12;
    let layer : str = gd_layer_name(GL_THEME);
    let outside : str = gd_layer_name(GL_THEME + 1);
    assert layer == "theme";
    let same : bool = layer == outside;
    assert same == false;
    assert bb_rgb_ok(0x007A45, 0xFFFFFF) == true;
    assert bb_rgb_ok(0x00FF88, 0xFFFFFF) == false;
}
