// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_node_port.t27 -- Node/Port presentation for the NETLIST constructor.
; Ring 2, Wave H1 of epic #13650.
; NpPortList: direct edge endpoints for a focal node, populated from NetlistGraph.
; np_ports_for_node(g, idx): all edges touching node idx; each peer is a port.
; np_can_connect(src_kind, dst_kind): compatibility via NG_EDGE_FROM/TO_KINDS masks.
; np_typical_port_count(kind): nominal port count per node kind (not a hard limit).
; Depends on master (all prior netlist specs merged).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_node_port;

use t27f::netlist_graph::{NetlistGraph, NG_MAX_NODES, NG_NODE_BLOCK, NG_NODE_INSTANCE,
    NG_NODE_NET, NG_NODE_PIN, NG_NODE_DEVICE, NG_NODE_REFUSAL, NG_NODE_KINDS,
    NG_EDGE_KINDS, NG_EDGE_FROM_KINDS, NG_EDGE_TO_KINDS, ng_kind_bit, inverter_graph};

pub const NP_PORT_MAX : u32 = 64;

; ── NpPortList struct ────────────────────────────────────────────────────────
; Parallel arrays -- one entry per edge that touches the focal node.
pub struct NpPortList {
    port_count : u32,
    port_node  : [64]u32,
    port_edge  : [64]u32,
    port_ekind : [64]u8,
}

; ── Port compatibility ────────────────────────────────────────────────────────
; True when src_kind can be the FROM endpoint and dst_kind the TO endpoint of
; any valid edge kind, using the NG_EDGE_FROM_KINDS and NG_EDGE_TO_KINDS masks.
pub fn np_can_connect(src_kind: u8, dst_kind: u8) -> bool {
    if (src_kind >= NG_NODE_KINDS) { return false; }
    if (dst_kind >= NG_NODE_KINDS) { return false; }
    var e : u8 = 0;
    while (e < NG_EDGE_KINDS) {
        let idx : usize = e as usize;
        let from_ok : bool = (NG_EDGE_FROM_KINDS[idx] & ng_kind_bit(src_kind)) != 0;
        let to_ok   : bool = (NG_EDGE_TO_KINDS[idx]   & ng_kind_bit(dst_kind)) != 0;
        if (from_ok and to_ok) { return true; }
        e = e + 1;
    }
    return false;
}

; ── Typical port count ────────────────────────────────────────────────────────
; Nominal number of ports for each node kind (minimum expected; not a hard limit).
pub fn np_typical_port_count(kind: u8) -> u32 {
    if (kind == NG_NODE_BLOCK)    { return 2; }
    if (kind == NG_NODE_INSTANCE) { return 1; }
    if (kind == NG_NODE_NET)      { return 2; }
    if (kind == NG_NODE_PIN)      { return 1; }
    if (kind == NG_NODE_DEVICE)   { return 2; }
    return 0;
}

; ── Port enumeration ──────────────────────────────────────────────────────────
; Returns all direct edge endpoints for node idx.
; For each edge where edge_from==idx, port_node = edge_to; vice versa.
; Out-of-range idx returns an empty list.
; Self-loops are disallowed by validate_graph so both branches cannot trigger.
pub fn np_ports_for_node(g: NetlistGraph, idx: u32) -> NpPortList {
    var pl : NpPortList;
    pl.port_count = 0;
    if (idx >= g.node_count) { return pl; }
    var j : u32 = 0;
    while (j < g.edge_count) {
        let ej : usize = j as usize;
        if (g.edge_from[ej] == idx) {
            if (pl.port_count < NP_PORT_MAX) {
                let pi : usize = pl.port_count as usize;
                pl.port_node[pi]  = g.edge_to[ej];
                pl.port_edge[pi]  = j;
                pl.port_ekind[pi] = g.edge_kind[ej];
                pl.port_count = pl.port_count + 1;
            }
        }
        if (g.edge_to[ej] == idx) {
            if (pl.port_count < NP_PORT_MAX) {
                let pi : usize = pl.port_count as usize;
                pl.port_node[pi]  = g.edge_from[ej];
                pl.port_edge[pi]  = j;
                pl.port_ekind[pi] = g.edge_kind[ej];
                pl.port_count = pl.port_count + 1;
            }
        }
        j = j + 1;
    }
    return pl;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test block_in_inverter_has_four_contained_ports {
    let g : NetlistGraph = inverter_graph();
    let pl : NpPortList = np_ports_for_node(g, 0);
    assert pl.port_count == 4;
}

test pin_in_inverter_has_one_port_back_to_block {
    let g : NetlistGraph = inverter_graph();
    let pl : NpPortList = np_ports_for_node(g, 1);
    assert pl.port_count == 1;
    assert pl.port_node[0] == 0;
}

test device_in_inverter_has_one_port_back_to_block {
    let g : NetlistGraph = inverter_graph();
    let pl : NpPortList = np_ports_for_node(g, 3);
    assert pl.port_count == 1;
    assert pl.port_node[0] == 0;
}

test out_of_range_node_gives_empty_port_list {
    let g : NetlistGraph = inverter_graph();
    let pl : NpPortList = np_ports_for_node(g, g.node_count);
    assert pl.port_count == 0;
}

test net_can_connect_to_pin {
    assert np_can_connect(NG_NODE_NET, NG_NODE_PIN);
}

test net_can_connect_to_device {
    assert np_can_connect(NG_NODE_NET, NG_NODE_DEVICE);
}

test net_cannot_connect_to_block {
    assert np_can_connect(NG_NODE_NET, NG_NODE_BLOCK) == false;
}

test block_can_contain_pin {
    assert np_can_connect(NG_NODE_BLOCK, NG_NODE_PIN);
}

test refusal_cannot_connect_to_anything {
    assert np_can_connect(NG_NODE_REFUSAL, NG_NODE_PIN) == false;
    assert np_can_connect(NG_NODE_REFUSAL, NG_NODE_NET) == false;
}

test typical_port_count_block_is_at_least_two {
    assert np_typical_port_count(NG_NODE_BLOCK) >= 2;
}

test typical_port_count_refusal_is_zero {
    assert np_typical_port_count(NG_NODE_REFUSAL) == 0;
}

test instance_to_block_is_compatible {
    assert np_can_connect(NG_NODE_INSTANCE, NG_NODE_BLOCK);
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant port_max_exceeds_typical_block_count {
    assert NP_PORT_MAX > np_typical_port_count(NG_NODE_BLOCK);
}

invariant net_to_pin_is_compatible {
    assert np_can_connect(NG_NODE_NET, NG_NODE_PIN);
}

invariant unknown_kind_cannot_connect {
    assert np_can_connect(NG_NODE_KINDS, NG_NODE_PIN) == false;
}
