/// Where each petal stands: 0 REFERENCE, 1 PLANNED, 2 DEFERRED.
pub const PVP_STATUS : [27]u8 = [
    1, 1, 1, 1, 2, 1, 1, 1, 1,    // A B C D E F G H I
    1, 1, 1, 1, 1, 1, 1, 1, 2,    // J K L M N O P Q R
    0, 1, 1, 1, 1, 1, 2, 1, 1,    // S T U V W X Y Z Ti
];

/// Why a row is deferred; "" otherwise.
pub const PVP_REASON : [27]str = [
    "", "", "", "",
    "No tested spec models experience records: specs/tools/tri/experience.t27 is a tool card and specs/queen/brain_summaries.t27 has no tests.",
    "", "",
    "", "", "", "", "", "", "", "", "", "",
    "The roadmap is prose in docs/ROADMAP.md and no spec models it.",
    "", "", "", "", "", "",
    "The one source the tool table names, specs/depin/prove.t27, is marked superseded, and a credit view must not read as a value claim.",
    "", "",
];

/// The best truth the source backs today (viz_contract): 0 LIVE, 1 VERIFIED, 3 DEMO, 4 UNKNOWN.
pub const PVP_TRUTH : [27]u8 = [
    1, 0, 1, 1, 4, 1, 0, 0, 1,    // A B C D E F G H I
    1, 0, 0, 3, 1, 1, 1, 0, 4,    // J K L M N O P Q R
    1, 1, 1, 1, 1, 1, 4, 3, 1,    // S T U V W X Y Z Ti
];

/// 1 when glass_window already has a bespoke page for the petal (B bench, G agents, H hive, K kanban, L logs, Q queen); C opens chat, not a page.
pub const PVP_HOST_PAGE : [27]u8 = [
    0, 1, 0, 0, 0, 0, 1, 1, 0,    // A B C D E F G H I
    0, 1, 1, 0, 0, 0, 0, 1, 0,    // J K L M N O P Q R
    0, 0, 0, 0, 0, 0, 0, 0, 0,    // S T U V W X Y Z Ti
];

; --- L3. Reading the rows ---------------------------------------------------------------------------------

/// The question of petal p; "" out of range.
pub fn pvp_question(p: u32) -> []const u8 {
    if (p >= PVP_COUNT) { return ""; }
    return PVP_QUESTION[p];
}

/// The source spec path of petal p; "" for a deferred row or out of range.
pub fn pvp_source(p: u32) -> []const u8 {
    if (p >= PVP_COUNT) { return ""; }
    return PVP_SOURCE[p];
}

/// The reason petal p is deferred; "" otherwise.
pub fn pvp_reason(p: u32) -> []const u8 {
    if (p >= PVP_COUNT) { return ""; }
    return PVP_REASON[p];
}

/// The status of petal p; DEFERRED out of range, so a stray index never reads as finished.
pub fn pvp_status(p: u32) -> u8 {
    if (p >= PVP_COUNT) { return PVP_DEFERRED; }
    return PVP_STATUS[p];
}

/// The rep bit set of petal p; 0 out of range.
pub fn pvp_reps(p: u32) -> u32 {
    if (p >= PVP_COUNT) { return 0; }
    return PVP_REPS[p];
}

/// The truth of petal p; UNKNOWN out of range.
pub fn pvp_truth(p: u32) -> u8 {
    if (p >= PVP_COUNT) { return VIZ_TRUTH_UNKNOWN; }
    return PVP_TRUTH[p];
}

/// How many rows carry this status.
pub fn pvp_count(status: u8) -> u32 {
    var n : u32 = 0;
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        if (PVP_STATUS[p] == status) { n = n + 1; }
        p = p + 1;
    }
    return n;
}

/// Every row is tracked under the epic; a petal out of range is not a row.
pub fn pvp_is_tracked(p: u32) -> bool {
    return p < PVP_COUNT and PVP_TRACKING == 12173;
}

/// A source path names a spec: it is not empty and its last four bytes are ".t27".
pub fn pvp_is_spec_path(s: []const u8) -> bool {
    if (s.len < 5) { return false; }
    const n : usize = s.len;
    return s[n - 4] == 46 and s[n - 3] == 116 and s[n - 2] == 50 and s[n - 1] == 55;
}

; --- L4. Tests ---------------------------------------------------------------------------------------------

test the_plan_has_one_row_per_petal {
    assert PVP_COUNT == 27;
    assert PVP_COUNT == PETAL_COUNT;
    assert PVP_QUESTION.len == 27;
    assert PVP_SOURCE.len == 27;
    assert PVP_REPS.len == 27;
    assert PVP_STATUS.len == 27;
    assert PVP_REASON.len == 27;
    assert PVP_TRUTH.len == 27;
    assert PVP_HOST_PAGE.len == 27;
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        assert pvp_question(p).len >= 20;
        assert pvp_is_tracked(p);
        p = p + 1;
    }
    assert pvp_is_tracked(27) == false;
    assert PVP_TRACKING == 12173;
}

test exactly_one_row_is_the_reference_and_it_is_petal_18 {
    assert pvp_count(PVP_REFERENCE) == 1;
    assert pvp_status(PVP_REFERENCE_PETAL) == PVP_REFERENCE;
    assert PVP_REFERENCE_PETAL == 18;
    // petal 18 is letter S
    assert petal_letter_byte(PVP_REFERENCE_PETAL) == 83;
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        if (p != PVP_REFERENCE_PETAL) { assert pvp_status(p) != PVP_REFERENCE; }
        p = p + 1;
    }
}

test every_row_passes_the_contract_plan_check {
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        assert viz_plan_ok(pvp_reps(p));
        // the badge is in every row, spelled out and not only through viz_plan_ok
        assert (pvp_reps(p) & viz_rep_bit(VIZ_REP_BADGE)) != 0;
        p = p + 1;
    }
    // a stray index has no reps and so no plan
    assert viz_plan_ok(pvp_reps(27)) == false;
}

test the_reference_row_is_linked {
    assert viz_is_linked(pvp_reps(PVP_REFERENCE_PETAL));
    assert viz_is_linked(PVP_REPS[18]);
    // the row is the petal's own reps, not a copy of them
    assert PVP_REPS[18] == psv_reps();
    // graph, matrix and list are the reference's linked views
    assert (PVP_REPS[18] & viz_rep_bit(0)) != 0;
    assert (PVP_REPS[18] & viz_rep_bit(1)) != 0;
    assert (PVP_REPS[18] & viz_rep_bit(2)) != 0;
}

test not_every_petal_is_forced_into_a_graph {
    var graphs : u32 = 0;
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        if ((pvp_reps(p) & viz_rep_bit(0)) != 0) { graphs = graphs + 1; }
        p = p + 1;
    }
    assert graphs >= 1;
    assert graphs < 5;
}

test a_planned_or_reference_row_names_a_spec_and_has_no_reason {
    var p : u32 = 0;
    var seen : u32 = 0;
    while (p < PVP_COUNT) {
        if (pvp_status(p) != PVP_DEFERRED) {
            assert pvp_source(p).len > 0;
            assert pvp_is_spec_path(pvp_source(p));
            assert pvp_source(p)[0] == 115;
            assert pvp_reason(p).len == 0;
            seen = seen + 1;
        }
        p = p + 1;
    }
    assert seen == 24;
}

test a_deferred_row_has_a_reason_no_source_and_unknown_truth {
    var p : u32 = 0;
    var seen : u32 = 0;
    while (p < PVP_COUNT) {
        if (pvp_status(p) == PVP_DEFERRED) {
            assert pvp_reason(p).len > 0;
            assert pvp_source(p).len == 0;
            assert pvp_truth(p) == VIZ_TRUTH_UNKNOWN;
            seen = seen + 1;
        }
        p = p + 1;
    }
    assert seen == 3;
    // the deferred petals are E, R and Y; G left the list when agent_parts gave it the AGENTS page (t27os#3)
    assert pvp_status(4) == PVP_DEFERRED;
    assert pvp_status(6) == PVP_PLANNED;
    assert pvp_status(17) == PVP_DEFERRED;
    assert pvp_status(24) == PVP_DEFERRED;
}

test a_row_that_is_not_deferred_never_has_unknown_truth {
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        if (pvp_status(p) != PVP_DEFERRED) { assert pvp_truth(p) != VIZ_TRUTH_UNKNOWN; }
        p = p + 1;
    }
}

test no_row_claims_live_without_a_host_page {
    var p : u32 = 0;
    var live : u32 = 0;
    while (p < PVP_COUNT) {
        if (pvp_truth(p) == VIZ_TRUTH_LIVE) {
            assert PVP_HOST_PAGE[p] == 1;
            live = live + 1;
        }
        p = p + 1;
    }
    // B, G, H, K, L and Q are the six with a page, and each is LIVE
    assert live == 6;
}

test the_host_page_column_agrees_with_agent_parts_page_kind {
    // the rule lives in agent_parts.page_kind; this column is its copy and is held equal here
    var p : u32 = 0;
    var pages : u32 = 0;
    while (p < PVP_COUNT) {
        if (page_kind(p + 1) != PAGE_NONE) {
            assert PVP_HOST_PAGE[p] == 1;
            pages = pages + 1;
        } else {
            assert PVP_HOST_PAGE[p] == 0;
        }
        p = p + 1;
    }
    assert pages == 6;
}

test the_three_status_counts_add_up_to_27 {
    assert pvp_count(PVP_REFERENCE) + pvp_count(PVP_PLANNED) + pvp_count(PVP_DEFERRED) == 27;
    assert pvp_count(PVP_REFERENCE) == 1;
    assert pvp_count(PVP_PLANNED) == 23;
    assert pvp_count(PVP_DEFERRED) == 3;
    // a status that is none of the three counts nothing
    assert pvp_count(PVP_STATUS_COUNT) == 0;
}

test a_stray_index_reads_as_deferred_and_unknown {
    assert pvp_status(27) == PVP_DEFERRED;
    assert pvp_status(1000) == PVP_DEFERRED;
    assert pvp_truth(27) == VIZ_TRUTH_UNKNOWN;
    assert pvp_reps(27) == 0;
    assert pvp_source(27).len == 0;
    assert pvp_question(27).len == 0;
}

test only_live_and_verified_rows_may_be_drawn_as_a_result {
    var p : u32 = 0;
    var results : u32 = 0;
    while (p < PVP_COUNT) {
        if (viz_may_claim(pvp_truth(p))) { results = results + 1; }
        p = p + 1;
    }
    // 27 rows less the two DEMO rows (M, Z) and the three deferred ones
    assert results == 22;
    assert viz_may_claim(VIZ_TRUTH_DEMO) == false;
    assert viz_may_claim(VIZ_TRUTH_VERIFIED);
}

test the_spec_path_check_reads_the_last_four_bytes {
    assert pvp_is_spec_path("specs/t27f/x.t27");
    assert pvp_is_spec_path("specs/t27f/x.md") == false;
    assert pvp_is_spec_path("") == false;
    assert pvp_is_spec_path(".t27") == false;
    assert pvp_is_spec_path("specs/t27f/x.t27x") == false;
}

invariant a_deferred_petal_is_never_drawn_as_a_result {
    var p : u32 = 0;
    while (p < PVP_COUNT) {
        if (pvp_status(p) == PVP_DEFERRED) {
            assert viz_may_claim(pvp_truth(p)) == false;
            assert pvp_source(p).len == 0;
        }
        p = p + 1;
    }
}
