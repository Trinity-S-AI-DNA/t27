// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_viz_plan.t27 -- the plan for interactive visualizations on all 27 T27 OS petals.
; Issue t27#12174, epic t27#12173 (interactive visualizations across the petals).
; --
; One row per petal: the question its visualization answers, the existing spec that is the source of
; truth for it, the representation kinds it composes, and where it stands. The contract every row is
; drawn through is specs/t27f/viz_contract.t27 (one VizState, one reducer, linked views); the reference
; petal built on it is SPECS, petal 18 (specs/t27f/petal_specs_viz.t27). This file is the ledger of what
; follows, not a second contract: it holds no drawing rule and restates none of the source specs.
; --
; Petal p is agent letter p + 1 (specs/t27f/petal_menu.t27), in the order of its WORLD_NAMES:
;   realm RAZUM     0 A ISA        1 B BENCH      2 C CHAT       3 D HEALTH    4 E EXPERIENCE  5 F FRONTEND
;                   6 G AGENTS     7 H HIVE       8 I ISSUES
;   realm MATERIYA  9 J JOBS      10 K KANBAN    11 L LOGS      12 M MAP      13 N PULSE      14 O OUROBOROS
;                  15 P PULLS     16 Q QUEEN     17 R ROADMAP
;   realm DUKH     18 S SPECS     19 T TRAINER   20 U UNIVERSITY  21 V VERDICTS  22 W WIDGETS  23 X EXTERNAL
;                  24 Y YIELD     25 Z DOCS      26 Ti SECURITY
; --
; Status. REFERENCE is the one finished petal; every other row is PLANNED when a spec exists that can
; back its question, and DEFERRED when none does. A deferred row says why, in PVP_REASON, and keeps
; truth UNKNOWN: a petal with no honest source is not drawn from a demo and called a result.
; --
; Truth, the best a petal's source can back today (the vocabulary is viz_contract's, L2):
;   LIVE      a host already reads the runtime data: only the six petals glass_window has a bespoke
;             page for (B, G, H, K, L, Q), which agent_parts.t27 page_kind decides and a test below holds equal;
;   VERIFIED  the source spec's rules are tested over fixtures, so what the view shows is checked;
;   DEMO      only a recorded or invented sample exists to draw, so the view is labelled a demo;
;   UNKNOWN   deferred rows.
; A row rises from VERIFIED to LIVE when a host feeds it, never by edit alone.
; --
; Reps are a bit set of viz_contract VIZ_REP_* kinds (bit k = 1 << k): graph 0, matrix 1, list 2, source 3,
; trace 4, inspector 5, stepper 6, choice 7, badge 8, timeline 9, chart 10, map 11, text 12. Every row has
; the badge, and not every row has a graph: a petal composes the views its question needs.
; --
; Rules the views follow and the plan does not restate: the Queen's priority order (specs/queen/priority.t27),
; the lab job kinds (specs/lab/job_kind.t27) and the others named in PVP_SOURCE are read from there. No
; row displays a key, a token, a secret or a credit value: EXTERNAL and SECURITY show state and counts,
; and YIELD is deferred until the owner names a source that does not read as a value claim.
; ASCII only (L3), English only (LANG-EN), integer only.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_petal_viz_plan;

use t27f::viz_contract::viz_rep_bit;
use t27f::viz_contract::viz_plan_ok;
use t27f::viz_contract::viz_is_linked;
use t27f::viz_contract::viz_may_claim;
use t27f::viz_contract::VIZ_REP_BADGE;
use t27f::viz_contract::VIZ_TRUTH_LIVE;
use t27f::viz_contract::VIZ_TRUTH_VERIFIED;
use t27f::viz_contract::VIZ_TRUTH_DEMO;
use t27f::viz_contract::VIZ_TRUTH_UNKNOWN;
use t27f::petal_menu::PETAL_COUNT;
use t27f::petal_menu::petal_letter_byte;
use t27os::agent_parts::page_kind;
use t27os::agent_parts::PAGE_NONE;
use t27f::petal_specs_viz::psv_reps;

; --- L1. Status and tracking ---------------------------------------------------------------------------

pub const PVP_COUNT : u32 = 27;
pub const PVP_REFERENCE : u8 = 0;
pub const PVP_PLANNED : u8 = 1;
pub const PVP_DEFERRED : u8 = 2;
pub const PVP_STATUS_COUNT : u8 = 3;
/// The one reference petal: S, SPECS (the spec graph, the first petal drawn through the contract).
pub const PVP_REFERENCE_PETAL : u32 = 18;
/// The epic every row is tracked under.
pub const PVP_TRACKING : u32 = 12173;

; --- L2. The 27 rows (parallel arrays, index = petal) ---------------------------------------------------

