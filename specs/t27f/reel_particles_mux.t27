// SPDX-License-Identifier: Apache-2.0
// specs/t27f/reel_particles_mux.t27 -- the ffmpeg filter graph that lays the owner's voice, the
// site's music and the yellow word captions over the frames of specs/t27f/reel_particles.t27.
//
// WHY: the glass reel's filter graph was printed by lab-only JS (caps.mjs); the only-t27 rule keeps
// that out. Every number of this graph comes from specs/automation/owner_voice_reel.t27 (the
// recipe of gHashTag/t27#10279): word timings, the voice offset, the caption tail, the font rule,
// the loudness, the music fades and the limiter. This spec only prints them in ffmpeg's syntax.
//
// THE OUTPUT: `main` writes the graph to stderr, for `ffmpeg -filter_complex_script`. Inputs:
// 0 = the engine's video, 1 = the owner's voice (owner-vo.wav), 2 = the music (bgmusic.mp3).
// Caption k reads its word from WORD_DIR/wKK.txt: the words are Russian, so they stay out of this
// ASCII file, as in owner_voice_reel.t27; the files are data, one word each.
//
// THE CTA: the last CTA_HOLD_MS of the reel carry one quiet line, CTA_TEXT, in Inter Light, warm
// white #E8E2D6 rather than pure white, fading in over CTA_FADE_MS (premium-dark rules 1, 5, 6).
//
// NOT CLAIMED: the graph is not run by anything in CI; it is checked by the reel it makes.
// phi^2 + 1/phi^2 = 3 | TRINITY

module reel_particles_mux;

use automation::owner_voice_reel::REEL_MS;
use automation::owner_voice_reel::CTA_HOLD_MS;
use automation::owner_voice_reel::VOICE_OFFSET_MS;
use automation::owner_voice_reel::CAPTION_Y;
use automation::owner_voice_reel::CAPTION_BORDER_PX;
use automation::owner_voice_reel::CAPTION_SHADOW_Y_PX;
use automation::owner_voice_reel::CAPTION_TAIL_MS;
use automation::owner_voice_reel::CAPTION_FONT_MAX;
use automation::owner_voice_reel::CAPTION_WIDTH_PX;
use automation::owner_voice_reel::CHAR_WIDTH_PERMILLE;
use automation::owner_voice_reel::VOICE_LUFS;
use automation::owner_voice_reel::VOICE_LRA;
use automation::owner_voice_reel::MUSIC_VOLUME_PERMILLE;
use automation::owner_voice_reel::MUSIC_FADE_IN_MS;
use automation::owner_voice_reel::MUSIC_FADE_OUT_START_MS;
use automation::owner_voice_reel::LIMIT_PERMILLE;
use automation::owner_voice_reel::WORD_COUNT;
use automation::owner_voice_reel::WORD_START_MS;
use automation::owner_voice_reel::WORD_END_MS;
use automation::owner_voice_reel::WORD_CHARS;
use automation::owner_voice_reel::LAB_FIRST_SHOWN;
use automation::owner_voice_reel::LAB_LAST_SHOWN;
use automation::owner_voice_reel::font_size;
use automation::owner_voice_reel::shown_from_ms;
use automation::owner_voice_reel::shown_until_ms;
use automation::owner_voice_reel::cta_start_ms;

pub const ID : str = "reel-particles-mux";

pub const CAPTION_FONT : str = "/usr/share/fonts/opentype/inter/Inter-ExtraBold.otf";
pub const CTA_FONT : str = "/usr/share/fonts/opentype/inter/Inter-Light.otf";
pub const WORD_DIR : str = "/root/reel-pe/w";
pub const CTA_TEXT : str = "t27.ai/learn";
pub const CTA_SIZE : i32 = 58;
pub const CTA_Y : i32 = 1560;
pub const CTA_FADE_MS : i32 = 600;
pub const MUSIC_FADE_OUT_MS : i32 = 1400;

// When caption k goes, with the next word's start when there is one.
fn until_ms(k: usize) -> i32 {
    const last = @as(usize, @intCast(WORD_COUNT)) - 1;
    if (k < last) {
        return shown_until_ms(WORD_END_MS[k], true, WORD_START_MS[k + 1]);
    }
    return shown_until_ms(WORD_END_MS[k], false, 0);
}

pub fn secs(ms: i32) -> i32 {
    return @divTrunc(ms, 1000);
}

pub fn millis(ms: i32) -> u32 {
    // unsigned: zig prints a signed int under a width with a + sign
    return @as(u32, @intCast(@mod(ms, 1000)));
}

fn music_silent_at_ms() -> i32 {
    return MUSIC_FADE_OUT_START_MS + MUSIC_FADE_OUT_MS;
}

// The CTA line is fully lit this long before the reel ends.
fn cta_lit_ms() -> i32 {
    return REEL_MS - (cta_start_ms() + CTA_FADE_MS);
}

pub fn main() -> void {
    std.debug.print("[0:v]format=yuv420p", .{});
    var k : usize = 0;
    while (k < @as(usize, @intCast(WORD_COUNT))) {
        const a = shown_from_ms(WORD_START_MS[k]);
        const b = until_ms(k);
        std.debug.print(",drawtext=fontfile={s}:textfile={s}/w{d:0>2}.txt:fontsize={d}:fontcolor=0xFFFF00:borderw={d}:bordercolor=0x000000:shadowx=0:shadowy={d}:shadowcolor=0x000000@0.6:x=(w-text_w)/2:y={d}-text_h/2:enable='between(t,{d}.{d:0>3},{d}.{d:0>3})'", .{ CAPTION_FONT, WORD_DIR, k + 1, font_size(WORD_CHARS[k]), CAPTION_BORDER_PX, CAPTION_SHADOW_Y_PX, CAPTION_Y, secs(a), millis(a), secs(b), millis(b) });
        k = k + 1;
    }
    const c = cta_start_ms();
    std.debug.print(",drawtext=fontfile={s}:text='{s}':fontsize={d}:fontcolor=0xE8E2D6:x=(w-text_w)/2:y={d}-text_h/2:alpha='min(1,max(0,(t-{d}.{d:0>3})/{d}.{d:0>3}))':enable='gte(t,{d}.{d:0>3})'[v];", .{ CTA_FONT, CTA_TEXT, CTA_SIZE, CTA_Y, secs(c), millis(c), secs(CTA_FADE_MS), millis(CTA_FADE_MS), secs(c), millis(c) });
    std.debug.print("[1:a]aresample=48000,pan=stereo|c0=c0|c1=c0,loudnorm=I={d}:TP=-1.5:LRA={d},adelay={d}|{d},apad=whole_dur={d}[vo];", .{ VOICE_LUFS, VOICE_LRA, VOICE_OFFSET_MS, VOICE_OFFSET_MS, secs(REEL_MS) });
    std.debug.print("[2:a]atrim=0:{d},volume=0.{d:0>3},afade=t=in:d=0.{d:0>3},afade=t=out:st={d}.{d:0>3}:d={d}.{d:0>3}[mu];", .{ secs(REEL_MS), millis(MUSIC_VOLUME_PERMILLE), millis(MUSIC_FADE_IN_MS), secs(MUSIC_FADE_OUT_START_MS), millis(MUSIC_FADE_OUT_START_MS), secs(MUSIC_FADE_OUT_MS), millis(MUSIC_FADE_OUT_MS) });
    std.debug.print("[vo][mu]amix=inputs=2:normalize=0:duration=first,alimiter=limit=0.{d:0>3}[a]\n", .{millis(LIMIT_PERMILLE)});
}

// ---- tests ----

test "caption windows are the glass reel's: first, last" {
    assert(shown_from_ms(WORD_START_MS[0]) == LAB_FIRST_SHOWN[0]);
    assert(until_ms(0) == LAB_FIRST_SHOWN[1]);
    assert(shown_from_ms(WORD_START_MS[20]) == LAB_LAST_SHOWN[0]);
    assert(until_ms(20) == LAB_LAST_SHOWN[1]);
}

test "every caption is gone before the CTA line comes" {
    var k : usize = 0;
    while (k < 21) {
        assert(until_ms(k) <= cta_start_ms());
        k = k + 1;
    }
}

test "the music fade ends with the reel" {
    assert(music_silent_at_ms() == REEL_MS);
}

test "seconds and millis print a time exactly" {
    assert(secs(10750) == 10);
    assert(millis(10750) == 750);
    assert(millis(400) == 400);
    assert(secs(400) == 0);
}

test "the CTA sits above the caption line and fades in inside the hold" {
    assert(CTA_Y < CAPTION_Y);
    assert(cta_lit_ms() == 2400);
}

test "the widest caption still fits: 12 characters at 108 px" {
    assert(font_size(12) == 108);
    assert(font_size(6) == CAPTION_FONT_MAX);
}
