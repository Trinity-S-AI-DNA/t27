// specs/t27f/drop_text_container.t27 -- t27f: drop text and container from the
// ui kit.
// Part of M7 milestone (milestone #11). Closes #13513.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::drop_text_container;

pub const DROP_TEXT_CONTAINER_MAX_COMPONENTS : u32 = 32;

pub struct UiComponent { kind: str, dropped: bool };

pub fn ui_component_dropped(c: UiComponent) -> bool {
    return c.dropped;
}

test "ui_component_dropped" {
    assert(ui_component_dropped(UiComponent { kind: "text", dropped: true }));
    assert(!ui_component_dropped(UiComponent { kind: "container", dropped: false }));
}

invariant drop_text_container_max_components_positive {
    assert DROP_TEXT_CONTAINER_MAX_COMPONENTS > 0;
}