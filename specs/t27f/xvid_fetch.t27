// specs/t27f/xvid_fetch.t27 -- tools: xvid_fetch.t27, post-video fetch
// decisions as a tested spec.
// Part of M1 (milestone #5). Closes #13654.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::xvid_fetch;

pub const XVID_FETCH_TIMEOUT_S : u32 = 30;

pub struct XvidFetch { url: str, fetched: bool };

pub fn xvid_fetch_done(f: XvidFetch) -> bool {
    return f.fetched;
}

test "xvid fetch done" {
    assert(xvid_fetch_done(XvidFetch { url: "https://example.com/video", fetched: true }));
    assert(!xvid_fetch_done(XvidFetch { url: "https://example.com/video", fetched: false }));
}

invariant xvid_fetch_timeout_positive {
    assert XVID_FETCH_TIMEOUT_S > 0;
}