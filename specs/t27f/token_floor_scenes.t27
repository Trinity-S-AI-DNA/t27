// SPDX-License-Identifier: Apache-2.0
// specs/t27f/token_floor_scenes.t27 -- the token_floor reel cut into a story of shots: a camera per
// shot, the transitions between them, the glass spec cards that float over them, and the small
// mono scene tags, for the tall 1080x1920 frame and the wide 1920x1080 one.
//
// WHY: the owner, 2026-10-18: one scene is boring; the transitions between shots must tell a story
// of scenes. And: study the artist tetsuo (x.com/tetsuoai), who works in our direction, AI agents
// and AI interfaces made visible. What his reels do, and what this module does:
//
//     shots        2-3 s each, cut on the beats of the voice, never on a clock. Here every hard
//                  cut falls just before a narration event or a phrase, so the eye arrives first
//                  and the word lands on what it already sees.
//     one hero     a recurring object carries the continuity across cuts. Here it is the column:
//                  every shot looks at the same world, only the camera moves.
//     moves        a slow push inside a shot, and a fast move between two shots when the story
//                  travels: the camera follows the white ball down, then the dots it sheds left.
//     two levels   a small mono label over a big bold statement. The statements are the reel's own
//                  particle letters; the small labels are the scene tags, top left.
//     UI cards     a translucent card in screen space, over the scene, showing the machine's side
//                  of the story: here the t27 function that computes the number on screen, and a
//                  green PASS. A card stays up across a cut: the interface outlives the shot.
//
// THE CAMERA maps the stage of specs/t27f/token_floor.t27 (world px, 1 px = 1 mm, the 1080x1920
// layout) to the screen: screen = (world - c) z + (W / 2, H / 2). It is axis-aligned, so the
// stage's separable light stays separable. Inside a shot c moves linearly and z geometrically
// from pose 0 to pose 1. A shot that enters by a move (MOVE or DOLLY) first travels from the last
// pose of the shot before, on a smootherstep, over MOVE_F or DOLLY_F frames.
//
// NOT CLAIMED: the shot list, the framings, the card layout and the tags are editing choices.
// This module owns where the camera looks and when; what is there to see is token_floor's.
// phi^2 + 1/phi^2 = 3 | TRINITY

module token_floor_scenes;

use t27f::pbr_sphere::clamp01;

pub const ID : str = "token-floor-scenes";
pub const SCENE_FRAMES : i32 = 450;         // token_floor's FRAMES; a test there holds them equal
pub const SCENE_FPS : i32 = 30;

// ---- the two frames ----
pub const TALL : usize = 0;
pub const WIDE : usize = 1;

pub fn frame_w(o: usize) -> i32 {
    if (o == WIDE) { return 1920; }
    return 1080;
}

pub fn frame_h(o: usize) -> i32 {
    if (o == WIDE) { return 1080; }
    return 1920;
}

// ---- the shots ----
pub const SHOTS : usize = 8;
pub const CUT : i64 = 0;
pub const MOVE : i64 = 1;                   // a fast camera move from the last shot's pose
pub const DOLLY : i64 = 2;                  // a slow one
pub const MOVE_F : f64 = 10.0;
pub const DOLLY_F : f64 = 24.0;

// The first frame of each shot, and the reel's end.
pub const SHOT_START : [9]i32 = [0, 68, 88, 130, 200, 262, 326, 380, 450];
// How each shot enters.
pub const SHOT_KIND : [8]i64 = [0, 1, 1, 0, 0, 0, 0, 2];
// 0 the title, 1 the white ball strikes, 2 the floor's labels, 3 the counter, 4 up the column,
// 5 the bill at the top, 6 the verdict, 7 the whole infographic.
// Per frame and shot: pose 0 (cx, cy, z), then pose 1, world px and zoom.
pub const CAM : [96]f64 = [
    // tall
    340.0, 145.0, 1.55, 340.0, 150.0, 1.75,
    860.0, 1590.0, 3.2, 860.0, 1600.0, 3.5,
    308.5, 1658.5, 1.730, 308.5, 1647.2, 1.891,
    227.2, 828.2, 2.572, 227.2, 820.6, 2.812,
    880.0, 1300.0, 2.0, 880.0, 560.0, 2.0,
    355.6, 771.9, 1.455, 355.6, 758.4, 1.590,
    306.9, 1165.2, 1.742, 306.9, 1154.0, 1.904,
    534.0, 1305.0, 0.72, 534.0, 1410.4, 0.542,
    // wide
    528.1, 119.1, 1.801, 510.6, 121.3, 1.969,
    860.0, 1590.0, 2.6, 860.0, 1600.0, 2.9,
    520.0, 1500.0, 1.3, 530.0, 1490.0, 1.4,
    440.0, 720.0, 1.9, 450.0, 730.0, 2.2,
    860.0, 1300.0, 1.8, 860.0, 560.0, 1.8,
    655.6, 577.3, 1.233, 630.1, 580.4, 1.348,
    500.0, 1009.7, 1.916, 483.6, 1011.7, 2.094,
    1194.9, 905.3, 0.56, 1404.8, 879.8, 0.425
];

pub fn shot_of(f: i32) -> usize {
    var s : usize = 0;
    while (s + 1 < SHOTS && f >= SHOT_START[s + 1]) {
        s = s + 1;
    }
    return s;
}

pub fn shot_len(s: usize) -> i32 {
    return SHOT_START[s + 1] - SHOT_START[s];
}

fn cam_f(o: usize, s: usize, k: usize) -> f64 {
    return CAM[o * 48 + s * 6 + k];
}

// 6 t^5 - 15 t^4 + 10 t^3: starts and stops with no speed and no acceleration.
pub fn smoother(t: f64) -> f64 {
    const u = clamp01(t);
    return u * u * u * (u * (u * 6.0 - 15.0) + 10.0);
}

// Shot s's own pose at frame f (fractional), component k: 0 cx, 1 cy, 2 z.
fn drift(o: usize, s: usize, f: f64, k: usize) -> f64 {
    const u = clamp01((f - @as(f64, @floatFromInt(SHOT_START[s]))) / @as(f64, @floatFromInt(shot_len(s))));
    const a = cam_f(o, s, k);
    const b = cam_f(o, s, k + 3);
    if (k == 2) {
        return a * @exp(u * @log(b / a));
    }
    return a + (b - a) * u;
}

fn entry_frames(s: usize) -> f64 {
    if (SHOT_KIND[s] == MOVE) { return MOVE_F; }
    if (SHOT_KIND[s] == DOLLY) { return DOLLY_F; }
    return 0.0;
}

// The camera of shot s at frame f, component k. f may lie outside the shot: the pose is held at
// its ends, so the frame before a cut is seen through the new shot's camera and a cut carries no
// motion blur.
pub fn pose(o: usize, s: usize, f: f64, k: usize) -> f64 {
    const own = drift(o, s, f, k);
    const n = entry_frames(s);
    if (s == 0 || n == 0.0) {
        return own;
    }
    const st = @as(f64, @floatFromInt(SHOT_START[s]));
    const w = smoother((f - st) / n);
    const from = drift(o, s - 1, st, k);
    if (k == 2) {
        return from * @exp(w * @log(own / from));
    }
    return from + (own - from) * w;
}

pub fn cam(o: usize, f: i32, k: usize) -> f64 {
    return pose(o, shot_of(f), @as(f64, @floatFromInt(f)), k);
}

// World to screen and back, through shot s's camera at frame f.
pub fn to_screen_x(o: usize, s: usize, f: f64, x: f64) -> f64 {
    return (x - pose(o, s, f, 0)) * pose(o, s, f, 2) + 0.5 * @as(f64, @floatFromInt(frame_w(o)));
}

pub fn to_screen_y(o: usize, s: usize, f: f64, y: f64) -> f64 {
    return (y - pose(o, s, f, 1)) * pose(o, s, f, 2) + 0.5 * @as(f64, @floatFromInt(frame_h(o)));
}

// The world rectangle shot s sees at frame f: 0 left, 1 top, 2 right, 3 bottom.
pub fn visible(o: usize, s: usize, f: f64, k: usize) -> f64 {
    const z = pose(o, s, f, 2);
    const hw = 0.5 * @as(f64, @floatFromInt(frame_w(o))) / z;
    const hh = 0.5 * @as(f64, @floatFromInt(frame_h(o))) / z;
    if (k == 0) { return pose(o, s, f, 0) - hw; }
    if (k == 1) { return pose(o, s, f, 1) - hh; }
    if (k == 2) { return pose(o, s, f, 0) + hw; }
    return pose(o, s, f, 1) + hh;
}

// True when the world box (x0, y0)-(x1, y1) is on screen, with a margin of m screen px, for every
// frame of shot s after its entry move.
pub fn framed(o: usize, s: usize, x0: f64, y0: f64, x1: f64, y1: f64, m: f64) -> bool {
    var f : f64 = @as(f64, @floatFromInt(SHOT_START[s])) + entry_frames(s);
    const e = @as(f64, @floatFromInt(SHOT_START[s + 1]));
    var ok : bool = true;
    while (f < e) {
        const z = pose(o, s, f, 2);
        if (x0 < visible(o, s, f, 0) + m / z || x1 > visible(o, s, f, 2) - m / z) { ok = false; }
        if (y0 < visible(o, s, f, 1) + m / z || y1 > visible(o, s, f, 3) - m / z) { ok = false; }
        f = f + 1.0;
    }
    return ok;
}

// The largest distance, screen px, any point of the world box moves between two frames of a shot
// once its entry move is over: a slow push, not a pan.
pub fn drift_px(o: usize, s: usize) -> f64 {
    var f : f64 = @as(f64, @floatFromInt(SHOT_START[s])) + entry_frames(s) + 1.0;
    const e = @as(f64, @floatFromInt(SHOT_START[s + 1]));
    var m : f64 = 0.0;
    while (f < e) {
        var c : usize = 0;
        while (c < 4) {
            var x : f64 = visible(o, s, f, 0);
            if (c == 1 || c == 3) { x = visible(o, s, f, 2); }
            var y : f64 = visible(o, s, f, 1);
            if (c >= 2) { y = visible(o, s, f, 3); }
            const dx = to_screen_x(o, s, f, x) - to_screen_x(o, s, f - 1.0, x);
            const dy = to_screen_y(o, s, f, y) - to_screen_y(o, s, f - 1.0, y);
            const d = @sqrt(dx * dx + dy * dy);
            if (d > m) { m = d; }
            c = c + 1;
        }
        f = f + 1.0;
    }
    return m;
}

// ---- the scene tags: the small mono line over each shot ----
pub const TAG_X : [2]i32 = [60, 80];
pub const TAG_Y : [2]i32 = [96, 72];
pub const TAG_FONT : [2]i32 = [30, 28];

pub fn tag_text(s: usize) -> str {
    if (s == 0) { return "01 / ONE TOKEN"; }
    if (s == 1) { return "02 / THE FLOOR"; }
    if (s == 2) { return "03 / LANDAUER"; }
    if (s == 3) { return "04 / X10 A BALL"; }
    if (s == 4) { return "05 / 19 DECADES"; }
    if (s == 5) { return "06 / THE BILL"; }
    if (s == 6) { return "07 / ENGINEERING"; }
    return "08 / T27.AI";
}

// ---- the spec cards ----
// A card is a rounded glass panel in screen space with three lines of mono text and a PASS pill.
// Per card: the first and the last frame it is up.
pub const CARDS : usize = 3;
pub const CARD_ON : [6]i32 = [98, 176, 272, 344, 392, 450];
// Per frame: x, y, w, h, corner radius, font px of the code line.
pub const CARD_BOX : [12]f64 = [60.0, 1330.0, 960.0, 230.0, 22.0, 34.0, 1180.0, 96.0, 680.0, 200.0, 20.0, 27.0];
pub const CARD_IN : f64 = 8.0;              // frames to rise in
pub const CARD_OUT : f64 = 6.0;             // frames to go
pub const CARD_RISE : f64 = 36.0;           // px it rises as it comes in
pub const PILL_W : f64 = 132.0;
pub const PILL_H : f64 = 44.0;

pub fn card_f(o: usize, k: usize) -> f64 {
    return CARD_BOX[o * 6 + k];
}

pub fn card_line(c: usize, l: usize) -> str {
    if (l == 0) { return "specs/physics/physical_limits.t27"; }
    if (c == 0) {
        if (l == 1) { return "index_bits(128256) * landauer_j(300)"; }
        return "= 4.9E-20 J";
    }
    if (c == 1) {
        if (l == 1) { return "token_energy_j(0.24 Wh, 500)"; }
        return "= 1.7 J PER TOKEN";
    }
    if (l == 1) { return "gap(1.7 J, 17 bits, 300 K)"; }
    return "= 3.5E19, 19 DECADES";
}

// The card up at frame f, or -1.
pub fn card_of(f: i32) -> i64 {
    var c : usize = 0;
    while (c < CARDS) {
        if (f >= CARD_ON[2 * c] && f <= CARD_ON[2 * c + 1]) {
            return @as(i64, @intCast(c));
        }
        c = c + 1;
    }
    return 0 - 1;
}

// Card c's opacity at frame f (fractional): it comes in over CARD_IN and goes over CARD_OUT.
pub fn card_opacity(c: usize, f: f64) -> f64 {
    const a = (f - @as(f64, @floatFromInt(CARD_ON[2 * c]))) / CARD_IN;
    const b = (@as(f64, @floatFromInt(CARD_ON[2 * c + 1])) + 1.0 - f) / CARD_OUT;
    var v : f64 = clamp01(a);
    if (clamp01(b) < v) { v = clamp01(b); }
    return smoother(v);
}

// How far below its place card c still is at frame f: it rises on the critically damped path,
// x0 (1 + w t) e^(-w t), at CARD_W rad/s.
pub const CARD_W : f64 = 14.0;

pub fn card_drop(c: usize, f: f64) -> f64 {
    var t : f64 = (f - @as(f64, @floatFromInt(CARD_ON[2 * c]))) / @as(f64, @floatFromInt(SCENE_FPS));
    if (t < 0.0) { t = 0.0; }
    return CARD_RISE * (1.0 + CARD_W * t) * @exp(0.0 - CARD_W * t);
}

// Where card c's lines and pill sit, screen px. Line 0 (the spec's path) is set at 3/4 size, grey;
// line 1 is the call, white; line 2 the value, gold. Per frame: the three lines' tops below the
// card's top.
pub const CARD_LY : [6]f64 = [26.0, 86.0, 150.0, 22.0, 74.0, 128.0];
pub const CARD_PAD : f64 = 28.0;

pub fn card_top(o: usize, c: usize, f: f64) -> f64 {
    return card_f(o, 1) + card_drop(c, f);
}

pub fn pill_x(o: usize) -> f64 {
    return card_f(o, 0) + card_f(o, 2) - CARD_PAD - PILL_W;
}

pub fn pill_dy(o: usize) -> f64 {
    return CARD_LY[o * 3] - 4.0;
}

// ---- the interface: where the subject must stay, and where the captions go ----
// Per frame: the safe rect the scene's subject keeps inside (x0, y0, x1, y1), then the caption
// band (x, width, centre line y). Tall: the tags above, the card and the captions below. Wide:
// the scene on the left, an interface column on the right with the card at its top and the
// captions at its foot.
pub const SAFE : [14]f64 = [40.0, 150.0, 1040.0, 1310.0, 60.0, 960.0, 1700.0, 40.0, 130.0, 1140.0, 1040.0, 1180.0, 680.0, 960.0];

pub fn safe_f(o: usize, k: usize) -> f64 {
    return SAFE[o * 7 + k];
}

pub fn band_x(o: usize) -> i32 {
    return @as(i32, @intFromFloat(safe_f(o, 4)));
}

pub fn band_w(o: usize) -> i32 {
    return @as(i32, @intFromFloat(safe_f(o, 5)));
}

pub fn caption_y(o: usize) -> i32 {
    return @as(i32, @intFromFloat(safe_f(o, 6)));
}

// True when the world box (x0, y0)-(x1, y1) lies inside the safe rect for every frame of shot s
// after its entry move, from frame `from` on.
pub fn inside(o: usize, s: usize, from: f64, x0: f64, y0: f64, x1: f64, y1: f64) -> bool {
    var f : f64 = @as(f64, @floatFromInt(SHOT_START[s])) + entry_frames(s);
    if (from > f) { f = from; }
    const e = @as(f64, @floatFromInt(SHOT_START[s + 1]));
    var ok : bool = true;
    while (f < e) {
        if (to_screen_x(o, s, f, x0) < safe_f(o, 0) || to_screen_x(o, s, f, x1) > safe_f(o, 2)) { ok = false; }
        if (to_screen_y(o, s, f, y0) < safe_f(o, 1) || to_screen_y(o, s, f, y1) > safe_f(o, 3)) { ok = false; }
        f = f + 1.0;
    }
    return ok;
}

// The worst overshoot, screen px, of the box past the safe rect over the same frames: a probe for
// tuning a pose, 0 when the box is inside.
pub fn overshoot(o: usize, s: usize, from: f64, x0: f64, y0: f64, x1: f64, y1: f64) -> f64 {
    var f : f64 = @as(f64, @floatFromInt(SHOT_START[s])) + entry_frames(s);
    if (from > f) { f = from; }
    const e = @as(f64, @floatFromInt(SHOT_START[s + 1]));
    var m : f64 = 0.0;
    while (f < e) {
        const a = safe_f(o, 0) - to_screen_x(o, s, f, x0);
        const b = to_screen_x(o, s, f, x1) - safe_f(o, 2);
        const c = safe_f(o, 1) - to_screen_y(o, s, f, y0);
        const d = to_screen_y(o, s, f, y1) - safe_f(o, 3);
        if (a > m) { m = a; }
        if (b > m) { m = b; }
        if (c > m) { m = c; }
        if (d > m) { m = d; }
        f = f + 1.0;
    }
    return m;
}

// ---- tests ----

test "the shots tile the reel, in order, 0.6 to 2.5 s each" {
    assert(SHOT_START[0] == 0);
    assert(SHOT_START[SHOTS] == SCENE_FRAMES);
    var s : usize = 0;
    while (s < SHOTS) {
        assert(shot_len(s) >= 18);
        assert(shot_len(s) <= 75);
        s = s + 1;
    }
    assert(shot_of(0) == 0);
    assert(shot_of(67) == 0);
    assert(shot_of(68) == 1);
    assert(shot_of(449) == SHOTS - 1);
    // the first shot opens on a still frame; it does not enter by a move
    assert(SHOT_KIND[0] == CUT);
}

test "a shot pushes in slowly; only the crane up the column travels, under 30 px a frame" {
    var o : usize = 0;
    while (o < 2) {
        var s : usize = 0;
        while (s < SHOTS) {
            if (s == 4) {
                assert(drift_px(o, s) < 30.0);
                assert(drift_px(o, s) > 12.0);
            } else {
                assert(drift_px(o, s) < 12.0);
            }
            s = s + 1;
        }
        o = o + 1;
    }
}

test "a move starts where the last shot ended and arrives at the new shot's own pose" {
    var o : usize = 0;
    while (o < 2) {
        var s : usize = 1;
        while (s < SHOTS) {
            const st = @as(f64, @floatFromInt(SHOT_START[s]));
            if (SHOT_KIND[s] != CUT) {
                var k : usize = 0;
                while (k < 3) {
                    assert(@abs(pose(o, s, st, k) - pose(o, s - 1, st, k)) < 1e-9);
                    assert(@abs(pose(o, s, st + entry_frames(s), k) - drift(o, s, st + entry_frames(s), k)) < 1e-9);
                    k = k + 1;
                }
            }
            s = s + 1;
        }
        o = o + 1;
    }
    // a cut changes the picture at once: shot 3 does not look where shot 2 did
    assert(@abs(cam(0, 130, 1) - cam(0, 129, 1)) > 300.0);
}

test "smootherstep starts and stops at rest" {
    assert(smoother(0.0) == 0.0);
    assert(smoother(1.0) == 1.0);
    assert(@abs(smoother(0.5) - 0.5) < 1e-12);
    // its slope at the ends is under 1 percent of the mean after 2 percent of the way
    assert(smoother(0.02) < 0.0001);
    assert(smoother(2.0) == 1.0);
    assert(smoother(0.0 - 1.0) == 0.0);
}

test "the camera maps the world and back" {
    var o : usize = 0;
    while (o < 2) {
        const f = 300.0;
        const s = shot_of(300);
        const x = visible(o, s, f, 0);
        const y = visible(o, s, f, 3);
        assert(@abs(to_screen_x(o, s, f, x)) < 1e-9);
        assert(@abs(to_screen_y(o, s, f, y) - @as(f64, @floatFromInt(frame_h(o)))) < 1e-9);
        o = o + 1;
    }
    assert(frame_w(TALL) * frame_h(TALL) == frame_w(WIDE) * frame_h(WIDE));
}

test "the framing check bites: a box off the screen is refused" {
    assert(framed(0, 1, 840.0, 1580.0, 880.0, 1620.0, 20.0));
    assert(framed(0, 1, 60.0, 1580.0, 100.0, 1620.0, 20.0) == false);
    assert(framed(1, 7, -3000.0, 0.0, 3000.0, 10.0, 0.0) == false);
}

test "the cards come in, rise into place and go; one at a time" {
    var c : usize = 0;
    while (c < CARDS) {
        const a = @as(f64, @floatFromInt(CARD_ON[2 * c]));
        const b = @as(f64, @floatFromInt(CARD_ON[2 * c + 1]));
        assert(b - a >= 45.0);
        assert(card_opacity(c, a) == 0.0);
        assert(card_opacity(c, a + CARD_IN) == 1.0);
        assert(card_opacity(c, b + 1.0) == 0.0);
        assert(card_drop(c, a) == CARD_RISE);
        // after 0.4 s it is inside a pixel of its place
        assert(card_drop(c, a + 12.0) < 1.0);
        if (c > 0) {
            assert(CARD_ON[2 * c] > CARD_ON[2 * c - 1]);
        }
        c = c + 1;
    }
    assert(card_of(97) < 0);
    assert(card_of(98) == 0);
    assert(card_of(300) == 1);
    assert(card_of(449) == 2);
    assert(CARD_ON[2 * CARDS - 1] <= SCENE_FRAMES);
}

test "a card and its pill fit the frame, and a code line fits the card" {
    var o : usize = 0;
    while (o < 2) {
        assert(card_f(o, 0) + card_f(o, 2) <= @as(f64, @floatFromInt(frame_w(o))) - 40.0);
        assert(card_f(o, 1) + card_f(o, 3) <= @as(f64, @floatFromInt(frame_h(o))) - 40.0);
        assert(PILL_W + 56.0 < card_f(o, 2));
        // JetBrains Mono advances 600 per mille of the size; the longest line is the path
        var c : usize = 0;
        while (c < CARDS) {
            var l : usize = 0;
            while (l < 3) {
                const n = @as(f64, @floatFromInt(card_line(c, l).len));
                assert(n * 0.6 * card_f(o, 5) + 56.0 <= card_f(o, 2));
                l = l + 1;
            }
            c = c + 1;
        }
        o = o + 1;
    }
}

test "the card's lines, its pill and the caption band keep clear of each other and of the edges" {
    var o : usize = 0;
    while (o < 2) {
        const w = @as(f64, @floatFromInt(frame_w(o)));
        const h = @as(f64, @floatFromInt(frame_h(o)));
        // the value line, 1.2 em tall, ends 16 px above the card's foot
        assert(CARD_LY[o * 3 + 2] + 1.2 * card_f(o, 5) + 16.0 <= card_f(o, 3));
        // the path line, at 3/4 size, ends before the pill
        const path = @as(f64, @floatFromInt(card_line(0, 0).len)) * 0.6 * 0.75 * card_f(o, 5);
        assert(card_f(o, 0) + CARD_PAD + path + 16.0 < pill_x(o));
        // the caption band: inside the frame, and below the card or beside the scene
        assert(safe_f(o, 4) >= 40.0);
        assert(safe_f(o, 4) + safe_f(o, 5) <= w - 40.0);
        assert(safe_f(o, 6) + 124.0 / 2.0 + 9.0 + 6.0 < h);
        assert(safe_f(o, 6) - 124.0 / 2.0 - 9.0 > card_f(o, 1) + card_f(o, 3) + CARD_RISE);
        // the safe rect sits inside the frame
        assert(safe_f(o, 0) >= 0.0 && safe_f(o, 2) <= w && safe_f(o, 1) >= 0.0 && safe_f(o, 3) <= h);
        o = o + 1;
    }
    // tall: the subject stays above the card; wide: left of the interface column
    assert(safe_f(TALL, 3) <= card_f(TALL, 1));
    assert(safe_f(WIDE, 2) <= card_f(WIDE, 0));
    assert(safe_f(WIDE, 2) <= safe_f(WIDE, 4));
    assert(band_x(TALL) == 60 && band_w(WIDE) == 680 && caption_y(TALL) == 1700);
}

test "the safe-rect check bites" {
    // the white ball at rest is inside shot 1's safe rect; the title, at the top of the stage, is not
    assert(inside(TALL, 1, 0.0, 826.0, 1572.0, 894.0, 1640.0));
    assert(inside(TALL, 1, 0.0, 60.0, 70.0, 600.0, 133.0) == false);
    assert(overshoot(TALL, 1, 0.0, 826.0, 1572.0, 894.0, 1640.0) == 0.0);
    assert(overshoot(TALL, 1, 0.0, 60.0, 70.0, 600.0, 133.0) > 100.0);
}

test "every shot has its tag" {
    var s : usize = 0;
    while (s < SHOTS) {
        assert(tag_text(s).len > 6);
        assert(tag_text(s)[0] == 48);
        assert(tag_text(s)[1] == 49 + @as(u8, @intCast(s)));
        s = s + 1;
    }
}
