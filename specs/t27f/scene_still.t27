// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_still.t27 -- the still of a lesson: reel_factory.t27's plan in, one picture out.
// The plan names the scene, the accent, the camera motion and the layout; this module dresses the
// scene with the last three and calls the renderer the first one names. Issue
// gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: reel_still.t27 (PR #10548) takes the frame the reel shows at STILL_MS = 9000 ms, frame 270,
// and every lesson reel drew token_floor's physics world there. Here the frame is the lesson's own
// scene. The camera is fixed at that frame, so each motion is a constant move, not an animation:
//   push    the canvas is seen 8 % closer, about its centre
//   orbit   the canvas is turned about 5.7 degrees, about its centre
//   rise    the scene sits 36 canvas pixels higher
//   sweep   the scene sits 28 canvas pixels to the left
// and each layout moves the hero off the centre:
//   centre  nowhere     top  70 pixels up     side  50 pixels to the right
//
// THE CALL: pixel(t, a, ac, mo, ly, n, x, y, w, h) is the colour, 0xRRGGBB, of pixel (x, y) of a
// w x h still in the 9:16 tall cut. a, ac, mo and ly are reel_factory's arche, accent, motion and
// layout of lesson t, and n is the content count of the scene: reel_factory's content(t, a). They
// are arguments because arche plans the whole course and a still calls this once a pixel.
//
// NOT CLAIMED: the tall cut only (the wide cut and the other FMT_* sizes are not drawn here); the
// still is the scene, not the captions over it, which are the reel's drawtext overlays.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_still;

use t27f::scene_raster::VW;
use t27f::scene_raster::VH;
use t27f::scene_raster::rgb;
use t27f::scene_code::code_px;

pub const M_PUSH : usize = 0;
pub const M_ORBIT : usize = 1;
pub const M_RISE : usize = 2;
pub const M_SWEEP : usize = 3;
pub const L_CENTRE : usize = 0;
pub const L_TOP : usize = 1;
pub const L_SIDE : usize = 2;

pub const CX : i32 = 180;
pub const CY : i32 = 320;

// The accent colours of reel_factory.ACCENT_RGB: gold, violet, magenta, green, blue, white.
pub const ACCENT : [6]i32 = [0xF5B700, 0x8B5CF6, 0xE0409A, 0x22C55E, 0x3B82F6, 0xF5F5F5];

// Where canvas point (x, y) lands in the scene's own frame, once the camera and the layout have
// moved it.
pub fn scene_x(mo: usize, ly: usize, x: i32, y: i32) -> i32 {
    var sx : i32 = x;
    if (mo == M_PUSH) { sx = CX + @divTrunc((x - CX) * 100, 108); }
    if (mo == M_ORBIT) { sx = CX + @divTrunc((x - CX) * 995 + (y - CY) * 99, 1000); }
    if (mo == M_SWEEP) { sx = x + 28; }
    if (ly == L_SIDE) { sx = sx - 50; }
    return sx;
}
pub fn scene_y(mo: usize, ly: usize, x: i32, y: i32) -> i32 {
    var sy : i32 = y;
    if (mo == M_PUSH) { sy = CY + @divTrunc((y - CY) * 100, 108); }
    if (mo == M_ORBIT) { sy = CY + @divTrunc((y - CY) * 995 - (x - CX) * 99, 1000); }
    if (mo == M_RISE) { sy = y + 36; }
    if (ly == L_TOP) { sy = sy + 70; }
    return sy;
}

// The colour at canvas point (x, y) of the tall cut, scene a.
pub fn canvas_colour(t: usize, a: usize, ac: usize, mo: usize, ly: usize, n: i32, x: i32, y: i32) -> i32 {
    const sx = scene_x(mo, ly, x, y);
    const sy = scene_y(mo, ly, x, y);
    const acc = ACCENT[ac];
    if (a == 0) { return code_px(t, acc, n, sx, sy); }
    return rgb(0, 0, 0);
}

// The colour of pixel (x, y) of a w x h still.
pub fn pixel(t: usize, a: usize, ac: usize, mo: usize, ly: usize, n: i32, x: i32, y: i32, w: i32, h: i32) -> i32 {
    const cx = @divTrunc(x * VW + @divTrunc(VW, 2), w);
    const cy = @divTrunc(y * VH + @divTrunc(VH, 2), h);
    return canvas_colour(t, a, ac, mo, ly, n, cx, cy);
}

// ---- tests ----

test "the camera and the layout move the canvas as the header says" {
    assert(scene_x(M_PUSH, L_CENTRE, CX, CY) == CX);
    assert(scene_y(M_PUSH, L_CENTRE, CX, CY) == CY);
    assert(scene_x(M_PUSH, L_CENTRE, 0, CY) > 0);
    assert(scene_x(M_SWEEP, L_CENTRE, 100, 100) == 128);
    assert(scene_y(M_RISE, L_CENTRE, 100, 100) == 136);
    assert(scene_y(M_RISE, L_TOP, 100, 100) == 206);
    assert(scene_x(M_RISE, L_SIDE, 100, 100) == 50);
    assert(scene_x(M_ORBIT, L_CENTRE, CX + 100, CY) == CX + 99);
    assert(scene_y(M_ORBIT, L_CENTRE, CX + 100, CY) == CY - 9);
}

test "a still of the code scene is the code scene at that size, and is not a flat colour" {
    var seen : i32 = 0;
    var last : i32 = 0 - 1;
    var y : i32 = 0;
    while (y < 192) {
        var x : i32 = 0;
        while (x < 108) {
            const c = pixel(3, 0, 1, 0, 0, 0, x, y, 108, 192);
            assert(c >= 0 && c <= 0xFFFFFF);
            if (c != last) { seen = seen + 1; }
            last = c;
            x = x + 1;
        }
        y = y + 1;
    }
    assert(seen > 3000);
}

test "the dressing changes the picture: another motion or layout of one scene differs" {
    var d_motion : i32 = 0;
    var d_layout : i32 = 0;
    var y : i32 = 0;
    while (y < 192) {
        var x : i32 = 0;
        while (x < 108) {
            if (pixel(3, 0, 1, 0, 0, 0, x, y, 108, 192) != pixel(3, 0, 1, 3, 0, 0, x, y, 108, 192)) { d_motion = d_motion + 1; }
            if (pixel(3, 0, 1, 0, 0, 0, x, y, 108, 192) != pixel(3, 0, 1, 0, 1, 0, x, y, 108, 192)) { d_layout = d_layout + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(d_motion > 2000);
    assert(d_layout > 2000);
}
