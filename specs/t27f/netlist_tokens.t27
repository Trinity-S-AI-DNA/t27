// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_tokens.t27 -- the token schema of a netlist drawn through T27F. Refs #13652, epic #13650.
; Why. A netlist view has six things to draw (block, instance, net, pin, leaf device, refusal) and every one of
; them carries one inference label (exact, derived, suggested, unknown). Without one schema each view would
; pick its own look, and a model's guess could be drawn like a measured fact.
; What this module is: a map from (node kind, label) to four tokens -- fill role, stroke role, dash, text role.
; A role is a TH_* index of vf_theme; the colour itself is read there with th_color(theme, role).
; This module defines no colour value and no size: it names the netlist roles and maps them, nothing else.
; --
; The rules, each one a function below:
; - Fill by kind. A block, a net, a device and a refusal sit on the ground (bg). An instance is a filled
;   box (border role), so a block of instances reads as boxes inside an outline. A pin is a solid dot in
;   its own stroke role.
; - Stroke and text by label. exact = text role; derived = card-desc; suggested and unknown = muted.
; - Dash by label. exact solid, derived long dash, suggested short dash, unknown dotted. Stroke role and
;   dash together tell the four labels apart with no colour: suggested and unknown share a role and
;   differ by dash.
; - A refusal is always drawn with the unknown look, whatever label the caller passes. It is never drawn
;   as a verified node.
; - One accent. nt_accent() is the gold role, kept for the single selected node or the current stage.
;   No (kind, label) pair maps to it.
; An unknown kind or label gives NT_NONE for every token and nt_resolves is false: refused, never guessed.
; --
; NOT claimed: no pixel is drawn here and no renderer reads this map yet; line widths, radii and sizes
; are vf_tokens and vf_theme values and are not restated; hover, focus and disabled states are not
; covered; contrast is the brand luma floor of vf_brand (bb_pair_ok), not WCAG relative luminance.
; Every private helper carries the nt_ prefix: the `use` splice keys declarations by bare name.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_netlist_tokens;

use t27f::vf_theme::TH_T27;
use t27f::vf_theme::TH_PAPER;
use t27f::vf_theme::TH_THEMES;
use t27f::vf_theme::TH_BG;
use t27f::vf_theme::TH_TEXT;
use t27f::vf_theme::TH_MUTED;
use t27f::vf_theme::TH_GOLD;
use t27f::vf_theme::TH_BORDER;
use t27f::vf_theme::TH_CARD_DESC;
use t27f::vf_theme::TH_ROLES;
use t27f::vf_theme::TH_ERROR_RGB;
use t27f::vf_theme::th_color;
use t27f::vf_brand::bb_pair_ok;

; node kinds
pub const NT_BLOCK : u32 = 0;
pub const NT_INSTANCE : u32 = 1;
pub const NT_NET : u32 = 2;
pub const NT_PIN : u32 = 3;
pub const NT_DEVICE : u32 = 4;
pub const NT_REFUSAL : u32 = 5;
pub const NT_KINDS : u32 = 6;

; inference labels, the T27F four
pub const NT_EXACT : u32 = 0;
pub const NT_DERIVED : u32 = 1;
pub const NT_SUGGESTED : u32 = 2;
pub const NT_UNKNOWN : u32 = 3;
pub const NT_LABELS : u32 = 4;

; dash patterns
pub const NT_SOLID : u32 = 0;
pub const NT_DASH_LONG : u32 = 1;
pub const NT_DASH_SHORT : u32 = 2;
pub const NT_DOTTED : u32 = 3;
pub const NT_DASHES : u32 = 4;

pub const NT_NONE : u32 = 65535;
pub const NT_PAIRS : u32 = 24;

; the label a node is drawn with: a refusal is always unknown; NT_NONE for a kind or label out of range
pub fn nt_look(kind: u32, label: u32) -> u32 {
    if kind >= NT_KINDS {
        return NT_NONE;
    }
    if label >= NT_LABELS {
        return NT_NONE;
    }
    if kind == NT_REFUSAL {
        return NT_UNKNOWN;
    }
    return label;
}

pub fn nt_stroke(kind: u32, label: u32) -> u32 {
    let look : u32 = nt_look(kind, label);
    if look == NT_NONE {
        return NT_NONE;
    }
    if look == NT_EXACT {
        return TH_TEXT;
    }
    if look == NT_DERIVED {
        return TH_CARD_DESC;
    }
    return TH_MUTED;
}

pub fn nt_text(kind: u32, label: u32) -> u32 {
    return nt_stroke(kind, label);
}

pub fn nt_dash(kind: u32, label: u32) -> u32 {
    let look : u32 = nt_look(kind, label);
    if look == NT_NONE {
        return NT_NONE;
    }
    if look == NT_EXACT {
        return NT_SOLID;
    }
    if look == NT_DERIVED {
        return NT_DASH_LONG;
    }
    if look == NT_SUGGESTED {
        return NT_DASH_SHORT;
    }
    return NT_DOTTED;
}

pub fn nt_fill(kind: u32, label: u32) -> u32 {
    let look : u32 = nt_look(kind, label);
    if look == NT_NONE {
        return NT_NONE;
    }
    if kind == NT_INSTANCE {
        return TH_BORDER;
    }
    if kind == NT_PIN {
        return nt_stroke(kind, label);
    }
    return TH_BG;
}

; the ground a node's text is read on: a pin's name stands beside the dot, on the page ground
pub fn nt_text_ground(kind: u32, label: u32) -> u32 {
    if kind == NT_PIN {
        if nt_look(kind, label) == NT_NONE {
            return NT_NONE;
        }
        return TH_BG;
    }
    return nt_fill(kind, label);
}

; the one accent: the selected node or the current stage, never a kind or a label
pub fn nt_accent() -> u32 {
    return TH_GOLD;
}

fn nt_role_in(theme: u32, role: u32) -> bool {
    if theme >= TH_THEMES {
        return false;
    }
    if role >= TH_ROLES {
        return false;
    }
    if th_color(theme, role) == TH_ERROR_RGB {
        return false;
    }
    return true;
}

; true when all four tokens of the pair exist in the theme and the text passes the brand luma floor
pub fn nt_resolves(theme: u32, kind: u32, label: u32) -> bool {
    if nt_look(kind, label) == NT_NONE {
        return false;
    }
    if nt_dash(kind, label) >= NT_DASHES {
        return false;
    }
    if nt_role_in(theme, nt_fill(kind, label)) == false {
        return false;
    }
    if nt_role_in(theme, nt_stroke(kind, label)) == false {
        return false;
    }
    if nt_role_in(theme, nt_text(kind, label)) == false {
        return false;
    }
    return bb_pair_ok(theme, nt_text(kind, label), nt_text_ground(kind, label));
}

; how many of the 24 kind and label pairs resolve in a theme
pub fn nt_resolved_count(theme: u32) -> u32 {
    var n : u32 = 0;
    var k : u32 = 0;
    while k < NT_KINDS {
        var l : u32 = 0;
        while l < NT_LABELS {
            if nt_resolves(theme, k, l) {
                n = n + 1;
            }
            l = l + 1;
        }
        k = k + 1;
    }
    return n;
}

test all_24_pairs_resolve_in_both_themes {
    assert NT_KINDS * NT_LABELS == NT_PAIRS;
    assert nt_resolved_count(TH_T27) == 24;
    assert nt_resolved_count(TH_PAPER) == 24;
    assert nt_fill(NT_BLOCK, NT_EXACT) == TH_BG;
    assert nt_stroke(NT_BLOCK, NT_EXACT) == TH_TEXT;
    assert nt_dash(NT_BLOCK, NT_EXACT) == NT_SOLID;
    assert nt_text(NT_BLOCK, NT_EXACT) == TH_TEXT;
    assert nt_fill(NT_INSTANCE, NT_DERIVED) == TH_BORDER;
    assert nt_stroke(NT_INSTANCE, NT_DERIVED) == TH_CARD_DESC;
    assert nt_dash(NT_INSTANCE, NT_DERIVED) == NT_DASH_LONG;
    assert nt_fill(NT_PIN, NT_SUGGESTED) == TH_MUTED;
    assert nt_text_ground(NT_PIN, NT_SUGGESTED) == TH_BG;
}

test an_unknown_theme_kind_or_label_is_refused {
    assert nt_resolves(TH_THEMES, NT_BLOCK, NT_EXACT) == false;
    assert nt_resolves(TH_T27, NT_KINDS, NT_EXACT) == false;
    assert nt_resolves(TH_T27, NT_BLOCK, NT_LABELS) == false;
    assert nt_resolved_count(TH_THEMES) == 0;
    assert nt_fill(NT_KINDS, NT_EXACT) == NT_NONE;
    assert nt_stroke(NT_NET, NT_LABELS) == NT_NONE;
    assert nt_dash(NT_KINDS, NT_LABELS) == NT_NONE;
    assert nt_text(NT_KINDS, NT_EXACT) == NT_NONE;
    assert nt_text_ground(NT_PIN, NT_LABELS) == NT_NONE;
}

test a_refusal_always_has_the_unknown_look {
    var l : u32 = 0;
    while l < NT_LABELS {
        assert nt_look(NT_REFUSAL, l) == NT_UNKNOWN;
        assert nt_stroke(NT_REFUSAL, l) == TH_MUTED;
        assert nt_dash(NT_REFUSAL, l) == NT_DOTTED;
        assert nt_text(NT_REFUSAL, l) == TH_MUTED;
        l = l + 1;
    }
    var k : u32 = 0;
    while k < NT_REFUSAL {
        let same_stroke : bool = nt_stroke(NT_REFUSAL, NT_EXACT) == nt_stroke(k, NT_EXACT);
        let same_dash : bool = nt_dash(NT_REFUSAL, NT_EXACT) == nt_dash(k, NT_EXACT);
        assert same_stroke == false;
        assert same_dash == false;
        k = k + 1;
    }
}

test the_four_labels_differ_by_dash_and_exact_is_solid {
    var k : u32 = 0;
    while k < NT_REFUSAL {
        var a : u32 = 0;
        while a < NT_LABELS {
            var b : u32 = a + 1;
            while b < NT_LABELS {
                let same : bool = nt_dash(k, a) == nt_dash(k, b);
                assert same == false;
                b = b + 1;
            }
            a = a + 1;
        }
        assert nt_dash(k, NT_EXACT) == NT_SOLID;
        k = k + 1;
    }
    let weaker : bool = nt_stroke(NT_BLOCK, NT_SUGGESTED) == nt_stroke(NT_BLOCK, NT_EXACT);
    assert weaker == false;
}

test the_accent_is_gold_and_no_pair_uses_it {
    assert nt_accent() == TH_GOLD;
    var k : u32 = 0;
    while k < NT_KINDS {
        var l : u32 = 0;
        while l < NT_LABELS {
            let fill_gold : bool = nt_fill(k, l) == TH_GOLD;
            let stroke_gold : bool = nt_stroke(k, l) == TH_GOLD;
            let text_gold : bool = nt_text(k, l) == TH_GOLD;
            assert fill_gold == false;
            assert stroke_gold == false;
            assert text_gold == false;
            l = l + 1;
        }
        k = k + 1;
    }
    assert bb_pair_ok(TH_T27, nt_accent(), TH_BG);
    assert bb_pair_ok(TH_PAPER, nt_accent(), TH_BG);
}
