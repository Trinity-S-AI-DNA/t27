// specs/t27f/heat_curve.t27 -- T27F slice 2: draw the heat bench graph on the MAP
// petal GNN page (research_graph row of #13044).
// Part of M6 milestone (milestone #10). Closes #13056.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::heat_curve;

pub const HEAT_CURVE_MAX_POINTS : u32 = 1024;

pub struct HeatCurvePoint { x: u32, y: u32 };

pub fn heat_curve_point_x(h: HeatCurvePoint) -> u32 {
    return h.x;
}

test "heat_curve_point_x" {
    assert(heat_curve_point_x(HeatCurvePoint { x: 10, y: 20 }) == 10);
}

invariant heat_curve_max_points_positive {
    assert HEAT_CURVE_MAX_POINTS > 0;
}