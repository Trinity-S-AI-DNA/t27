// SPDX-License-Identifier: Apache-2.0
; vf_menu: the shared target menu, one VfGraph with three buttons (Browser, Desktop, FPGA) and a route token per button
; Refs gHashTag/t27#13296, #13297, #13298, epic #13214
; One graph, three targets: vf_render_web, vf_render_native and vf_render_fpga all draw this same graph, and none of them
; owns a second copy of it. The route ids follow the target order of ui_targets.t27 (browser, desktop, fpga).
; Picking a route: a pointer hit goes through vf_paint_id (vf_pixel.t27), a key goes through vf_menu_route_key.
; Layout comes from vf_layout with no hand rectangle, and its numbers from the UI Kit tokens through vf_card_tok.vct_metrics:
;   card padding = space.card.padding (16), card gap = space.field.group_gap (16), button row gap = space.action.gap (10).
; Style: the renderers paint it with vf_card in the t27.ai theme (vf_theme TH_T27) and Outfit type (vf_type), through vct_render.
;   Browser, the default route, is the PRIMARY action (accent fill); Desktop and FPGA are SECONDARY (card fill, 1 px outline).
; Limits: 16 nodes (VF_MAX_NODES), 6 used; no hover or focus state yet; the heading is wider than its 80 px node (vf_layout measures no text).
; ASCII only (L3), English only, integer only.

module t27f_vf_menu;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL;
use t27f::visual_factory_contract::P_VARIANT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::PRIMARY;
use t27f::visual_factory_contract::SECONDARY;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::visual_factory_contract::vf_accessible_name;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_layout::vf_rect_is;
use t27f::vf_pixel::vf_paint_id;
use t27f::vf_pixel::vf_overlap_count;
use t27f::vf_pixel::VF_PX_NONE;
use t27f::ui_targets::UT_TARGET_OBJ;
use t27f::ui_targets::UT_TARGET_COUNT;
use t27f::ui_targets::OBJ_BROWSER;
use t27f::ui_targets::OBJ_DESKTOP;
use t27f::ui_targets::OBJ_FPGA;

pub const VF_MENU_ID : str = "target-menu";

; route ids, in the target order of ui_targets.t27 UT_TARGET_OBJ
pub const VF_ROUTE_WEB : u8 = 0;
pub const VF_ROUTE_NATIVE : u8 = 1;
pub const VF_ROUTE_FPGA : u8 = 2;
pub const VF_ROUTE_COUNT : u32 = 3;
pub const VF_ROUTE_NONE : u8 = 255;

; the token a host reads to pick its renderer; the label a person reads on the button
pub const VF_ROUTE_TOKEN : [3]str = ["web", "native", "fpga"];
pub const VF_ROUTE_LABEL : [3]str = ["Browser", "Desktop", "FPGA"];
pub const VF_ROUTE_TEST_ID : [3]str = ["route-web", "route-native", "route-fpga"];

; node indices of the menu graph
pub const VF_MENU_CARD : u32 = 0;
pub const VF_MENU_TITLE : u32 = 1;
pub const VF_MENU_ROW : u32 = 2;
pub const VF_MENU_FIRST_BUTTON : u32 = 3;
pub const VF_MENU_NODES : u32 = 6;

; the fitted card height at the token values: padding 16 + title 20 + gap 16 + button 40 + padding 16
pub const VF_MENU_H : u32 = 108;

; the menu graph at a viewport width: a card, a title, a row of three buttons
pub fn vf_menu_graph(width: u32) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), VF_MENU_ID);
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "menu-title");
    var g2 : VfGraph = vf_add(g1, VF_STACK, 0, bit(P_TEST_ID), "menu-row");
    var g3 : VfGraph = vf_add(g2, VF_BUTTON, 2, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), VF_ROUTE_TEST_ID[0]);
    var g4 : VfGraph = vf_add(g3, VF_BUTTON, 2, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), VF_ROUTE_TEST_ID[1]);
    var g5 : VfGraph = vf_add(g4, VF_BUTTON, 2, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), VF_ROUTE_TEST_ID[2]);

    var m : VctMetrics = vct_metrics();

    g5.viewport_w = width;
    g5.label[0] = "T27F targets";
    g5.direction[0] = DIR_COLUMN;
    g5.padding[0] = m.padding;
    g5.gap[0] = m.group_gap;

    g5.text[1] = "Targets";

    g5.direction[2] = DIR_ROW;
    g5.gap[2] = m.action_gap;

    g5.text[3] = VF_ROUTE_LABEL[0];
    g5.text[4] = VF_ROUTE_LABEL[1];
    g5.text[5] = VF_ROUTE_LABEL[2];
    g5.variant[3] = PRIMARY;
    g5.variant[4] = SECONDARY;
    g5.variant[5] = SECONDARY;
    return g5;
}

; the route a node stands for: the three buttons map to their routes, every other node to VF_ROUTE_NONE
pub fn vf_menu_route_of_node(i: u32) -> u8 {
    if i < VF_MENU_FIRST_BUTTON {
        return VF_ROUTE_NONE;
    }
    if i >= VF_MENU_FIRST_BUTTON + VF_ROUTE_COUNT {
        return VF_ROUTE_NONE;
    }
    return (i - VF_MENU_FIRST_BUTTON) as u8;
}

; the route under a pointer at (x, y): the topmost node there, through vf_paint_id
pub fn vf_menu_route_at(g: VfGraph, l: VfLayout, x: u32, y: u32) -> u8 {
    var id : u32 = vf_paint_id(g, l, x, y);
    if id == VF_PX_NONE {
        return VF_ROUTE_NONE;
    }
    return vf_menu_route_of_node(id);
}

; the route for a key: b, d, f (either case) or the digits 1, 2, 3
pub fn vf_menu_route_key(c: u8) -> u8 {
    if c == 98 or c == 66 or c == 49 {
        return VF_ROUTE_WEB;
    }
    if c == 100 or c == 68 or c == 50 {
        return VF_ROUTE_NATIVE;
    }
    if c == 102 or c == 70 or c == 51 {
        return VF_ROUTE_FPGA;
    }
    return VF_ROUTE_NONE;
}

; the token of a route, empty for VF_ROUTE_NONE
pub fn vf_menu_token(r: u8) -> str {
    if (r as u32) >= VF_ROUTE_COUNT {
        return "";
    }
    return VF_ROUTE_TOKEN[r as u32];
}

; the centre of button b, the point a test or a replay clicks
pub fn vf_menu_button_cx(l: VfLayout, b: u32) -> u32 {
    var i : u32 = VF_MENU_FIRST_BUTTON + b;
    return l.x[i] + l.w[i] / 2;
}

pub fn vf_menu_button_cy(l: VfLayout, b: u32) -> u32 {
    var i : u32 = VF_MENU_FIRST_BUTTON + b;
    return l.y[i] + l.h[i] / 2;
}

test menu_is_valid {
    var g : VfGraph = vf_menu_graph(375);
    assert vf_validate(g) == VF_OK;
    assert g.node_count == VF_MENU_NODES;
    assert g.kind[0] == VF_CARD;
    assert g.kind[3] == VF_BUTTON;
    assert g.kind[5] == VF_BUTTON;
    assert g.parent[3] == 2;
    assert g.parent[5] == 2;
    assert vf_accessible_name(g, 0) == "T27F targets";
    assert vf_accessible_name(g, 3) == "Browser";
    assert vf_accessible_name(g, 5) == "FPGA";
    // one primary action, the default route; the others are secondary
    assert g.variant[3] == PRIMARY;
    assert g.variant[4] == SECONDARY;
    assert g.variant[5] == SECONDARY;
}

; the spacing numbers are the UI Kit tokens, not menu constants: a token change moves the menu
test menu_spacing_is_the_tokens {
    var m : VctMetrics = vct_metrics();
    assert m.status == 0;
    var g : VfGraph = vf_menu_graph(375);
    assert g.padding[0] == m.padding;
    assert g.gap[0] == m.group_gap;
    assert g.gap[2] == m.action_gap;
    assert m.padding == 16;
    assert m.group_gap == 16;
    assert m.action_gap == 10;
    assert VF_MENU_H == m.padding + 20 + m.group_gap + 40 + m.padding;
}

test menu_layout_rects {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    assert vf_rect_is(l, 0, 0, 0, 375, VF_MENU_H);
    assert vf_rect_is(l, 1, 16, 16, 80, 20);
    assert vf_rect_is(l, 2, 16, 52, 308, 40);
    assert vf_rect_is(l, 3, 16, 52, 96, 40);
    assert vf_rect_is(l, 4, 122, 52, 96, 40);
    assert vf_rect_is(l, 5, 228, 52, 96, 40);
    assert vf_overlap_count(g, l) == 0;
    // negative control: the old hand padding 8 gives a different card
    g.padding[0] = 8;
    var l8 : VfLayout = vf_layout(g);
    assert vf_rect_is(l8, 1, 16, 16, 80, 20) == false;
}

test routes_follow_ui_targets {
    assert VF_ROUTE_COUNT == UT_TARGET_COUNT;
    assert UT_TARGET_OBJ[VF_ROUTE_WEB as u32] == OBJ_BROWSER;
    assert UT_TARGET_OBJ[VF_ROUTE_NATIVE as u32] == OBJ_DESKTOP;
    assert UT_TARGET_OBJ[VF_ROUTE_FPGA as u32] == OBJ_FPGA;
    assert vf_menu_token(VF_ROUTE_WEB) == "web";
    assert vf_menu_token(VF_ROUTE_NATIVE) == "native";
    assert vf_menu_token(VF_ROUTE_FPGA) == "fpga";
    assert vf_menu_token(VF_ROUTE_NONE) == "";
}

test pointer_picks_route {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    var b : u32 = 0;
    while b < VF_ROUTE_COUNT {
        var r : u8 = vf_menu_route_at(g, l, vf_menu_button_cx(l, b), vf_menu_button_cy(l, b));
        assert (r as u32) == b;
        b = b + 1;
    }
    // the gap between the first two buttons is the row, the title is text, below the card is nothing
    assert vf_menu_route_at(g, l, 117, 70) == VF_ROUTE_NONE;
    assert vf_menu_route_at(g, l, 20, 25) == VF_ROUTE_NONE;
    assert vf_menu_route_at(g, l, 20, 120) == VF_ROUTE_NONE;
    // the button edges: x 16 is in, x 112 is the first pixel past it
    assert vf_menu_route_at(g, l, 16, 52) == VF_ROUTE_WEB;
    assert vf_menu_route_at(g, l, 111, 91) == VF_ROUTE_WEB;
    assert vf_menu_route_at(g, l, 112, 70) == VF_ROUTE_NONE;
    assert vf_menu_route_at(g, l, 122, 52) == VF_ROUTE_NATIVE;
    assert vf_menu_route_at(g, l, 323, 70) == VF_ROUTE_FPGA;
    assert vf_menu_route_at(g, l, 324, 70) == VF_ROUTE_NONE;
}

test key_picks_route {
    assert vf_menu_route_key(98) == VF_ROUTE_WEB;
    assert vf_menu_route_key(66) == VF_ROUTE_WEB;
    assert vf_menu_route_key(49) == VF_ROUTE_WEB;
    assert vf_menu_route_key(100) == VF_ROUTE_NATIVE;
    assert vf_menu_route_key(50) == VF_ROUTE_NATIVE;
    assert vf_menu_route_key(70) == VF_ROUTE_FPGA;
    assert vf_menu_route_key(51) == VF_ROUTE_FPGA;
    assert vf_menu_route_key(120) == VF_ROUTE_NONE;
    assert vf_menu_route_key(52) == VF_ROUTE_NONE;
}

test node_routes {
    assert vf_menu_route_of_node(0) == VF_ROUTE_NONE;
    assert vf_menu_route_of_node(2) == VF_ROUTE_NONE;
    assert vf_menu_route_of_node(3) == VF_ROUTE_WEB;
    assert vf_menu_route_of_node(4) == VF_ROUTE_NATIVE;
    assert vf_menu_route_of_node(5) == VF_ROUTE_FPGA;
    assert vf_menu_route_of_node(6) == VF_ROUTE_NONE;
}
