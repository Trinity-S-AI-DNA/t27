; ---------------------------------------------------------------- constants

/// This petal is row 8 of the plan (agent letter I, ISSUES).
pub const PIV_PETAL : u32 = 8;
/// The fixture: 7 open issues in listing order, 4 pool labels, so 28 label chips and 35 focusable items.
pub const PIV_ISSUES : u32 = 7;
pub const PIV_POOL : u32 = 4;
pub const PIV_CHIPS : u32 = 28;
pub const PIV_ITEMS : u32 = 35;
/// The fixture's labels, one bit per (issue, label): bit i * 4 + k = label k on issue i. Issues 0, 2, 3, 4
/// carry P0; issue 1 carries P3; issue 5 carries none; issue 6 carries P1 and P2.
pub const PIV_START : u32 = 100733313;
/// "No issue", "no label", "no rank": not a valid index.
pub const PIV_NO_PICK : u32 = 65535;
/// A label that means no level (not in the source's vocabulary). Above every real level.
pub const PIV_LEVEL_NONE : u8 = 255;
/// The comma that separates the entries of a vocabulary string.
pub const PIV_COMMA : u8 = 44;
/// The one petal event. Above VIZ_EV_COUNT, so it cannot collide with a contract event. a = chip index.
pub const PIV_EV_TOGGLE_LABEL : u8 = 32;
/// How long the list takes to re-sort, before the reduced-motion preference.
pub const PIV_RESORT_MS : u32 = 240;
/// The spec the answers come from; the plan row names the same path.
pub const PIV_SOURCE : str = "specs/queen/priority.t27";
pub const PIV_NONE_NAME : str = "-";

/// The pool labels, in urgency order: label k is the entry of the source vocabulary for level k.
pub const PIV_POOL_NAME : [4]str = ["P0", "P1", "P2", "P3"];
pub const PIV_LEVEL_NAME : [4]str = ["CRITICAL", "HIGH", "NORMAL", "LOW"];
pub const PIV_WHY_NAME : [5]str = ["listing", "label", "aged", "capped", "blocked"];
/// The 7 issues of the fixture, in GitHub's listing order (index = listing position).
pub const PIV_TITLE : [7]str = [
    "Seal drift on a worktree path",
    "Lab job kind table is stale",
    "Verdict record has no run id",
    "Kanban column order",
    "Glass window focus ring",
    "Widget gallery card crop",
    "Docs index misses a page",
];
/// Days each fixture issue has been open.
pub const PIV_AGE : [7]u32 = [3, 30, 5, 40, 9, 15, 30];
/// Open blockers of each fixture issue.
pub const PIV_BLOCKERS : [7]u32 = [0, 0, 0, 0, 0, 0, 2];

/// Geometry of the list, in its own coordinates: a row is 40 high, the title runs to x 300, then four chips.
pub const PIV_ROW_H : u32 = 40;
pub const PIV_LIST_W : u32 = 560;
pub const PIV_LIST_H : u32 = 280;
pub const PIV_CHIP_X : u32 = 300;
pub const PIV_CHIP_STRIDE : u32 = 60;
pub const PIV_CHIP_W : u32 = 52;
pub const PIV_CHIP_PAD : u32 = 6;
pub const PIV_CHIP_H : u32 = 28;

/// Host slot numbers, in the order piv_host adds them.
pub const PIV_SLOT_BADGE : u32 = 0;
pub const PIV_SLOT_LIST : u32 = 1;
pub const PIV_SLOT_INSPECTOR : u32 = 2;

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the label set.
pub struct PivState {
    viz: VizState,
    labels: u32,
}

/// The truth of a label set: VERIFIED on the fixture's own labels, DEMO once the reader has changed any.
pub fn piv_truth_for(labels: u32) -> u8 {
    if (labels == PIV_START) {
        return VIZ_TRUTH_VERIFIED;
    }
    return VIZ_TRUTH_DEMO;
}

/// A petal ready to use: LOAD, then LOADED with all 35 items focusable and truth VERIFIED. The view has no
/// stepper and no choice, so both counts are 0.
pub fn piv_open() -> PivState {
    var v : VizState = viz_init(0, 0);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    return PivState { viz: v, labels: PIV_START };
}

/// A repository with no open issue: LOAD, then LOADED with 0 items, which the contract reads as EMPTY.
pub fn piv_open_empty() -> PivState {
    var v : VizState = viz_init(0, 0);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, 0, VIZ_TRUTH_VERIFIED as u32);
    return PivState { viz: v, labels: PIV_START };
}

/// Flip label chip c (issue c / 4, label c % 4). Ignored unless the view is READY and c names a chip. The
/// truth follows the labels and the revision moves once per flip.
pub fn piv_toggle(p: PivState, c: u32) -> PivState {
    if (p.viz.lifecycle != VIZ_LC_READY or c >= PIV_CHIPS) {
        return p;
    }
    var n : PivState = p;
    var v : VizState = p.viz;
    let bit : u32 = (1 as u32) << c;
    if ((p.labels & bit) != 0) {
        n.labels = p.labels - bit;
    } else {
        n.labels = p.labels + bit;
    }
    v.truth = piv_truth_for(n.labels);
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// The one reducer of the petal. Contract events go to viz_apply; PIV_EV_TOGGLE_LABEL (a = chip) flips a
/// label. A reload that finishes while the labels differ from the fixture's reports DEMO instead of a truth
/// that may claim a result (LIVE or VERIFIED); a CACHED or UNKNOWN truth is kept as it is.
pub fn piv_apply(p: PivState, ev: u8, a: u32, b: u32) -> PivState {
    if (ev == PIV_EV_TOGGLE_LABEL) {
        return piv_toggle(p, a);
    }
    var n : PivState = p;
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING and p.labels != PIV_START and viz_may_claim(v.truth)) {
        v.truth = VIZ_TRUTH_DEMO;
    }
    n.viz = v;
    return n;
}

; ---------------------------------------------------------------- L2 entities

/// The chip index of label k on issue i.
pub fn piv_chip(i: u32, k: u32) -> u32 {
    return i * PIV_POOL + k;
}

/// The entity of issue i; VIZ_REF_NONE for a number that is not an issue.
pub fn piv_issue_ref(i: u32) -> u32 {
    if (i >= PIV_ISSUES) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_NODE, i);
}

/// The entity of label chip k on issue i; VIZ_REF_NONE when either is out of range.
pub fn piv_chip_ref(i: u32, k: u32) -> u32 {
    if (i >= PIV_ISSUES or k >= PIV_POOL) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_CELL, piv_chip(i, k));
}

/// The issue an entity belongs to: an issue itself, or the issue a chip sits on. PIV_NO_PICK for anything
/// else (no entity, an edge, an issue or chip number past the fixture).
pub fn piv_ref_issue(r: u32) -> u32 {
    let kind : u32 = viz_ref_kind(r);
    let idx : u32 = viz_ref_index(r);
    if (kind == VIZ_ENT_NODE and idx < PIV_ISSUES) {
        return idx;
    }
    if (kind == VIZ_ENT_CELL and idx < PIV_CHIPS) {
        return idx / PIV_POOL;
    }
    return PIV_NO_PICK;
}

/// The entity of focus index f: the 7 issues in listing order, then the 28 chips in listing order.
/// VIZ_REF_NONE past the end or while the view is not READY.
pub fn piv_focus_ref(p: PivState, f: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or f >= p.viz.focus_count) {
        return VIZ_REF_NONE;
    }
    if (f < PIV_ISSUES) {
        return piv_issue_ref(f);
    }
    if (f < PIV_ITEMS) {
        return viz_ref(VIZ_ENT_CELL, f - PIV_ISSUES);
    }
    return VIZ_REF_NONE;
}

/// A click or tap on entity r: a chip flips its label, an issue row selects the issue, anything else is
/// ignored.
pub fn piv_click(p: PivState, r: u32) -> PivState {
    let kind : u32 = viz_ref_kind(r);
    let idx : u32 = viz_ref_index(r);
    if (kind == VIZ_ENT_CELL and idx < PIV_CHIPS) {
        return piv_apply(p, PIV_EV_TOGGLE_LABEL, idx, 0);
    }
    if (kind == VIZ_ENT_NODE and idx < PIV_ISSUES) {
        return piv_apply(p, VIZ_EV_SELECT, r, 0);
    }
    return p;
}

/// The keyboard's Enter on the focused item: a chip flips its label, an issue is activated (selected, or
/// cleared when it already is). Nothing focused is a no-op.
pub fn piv_activate(p: PivState) -> PivState {
    let r : u32 = piv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    if (viz_ref_kind(r) == VIZ_ENT_CELL) {
        return piv_click(p, r);
    }
    return piv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

; ---------------------------------------------------------------- L3 vocabulary

/// True when `name` is one whole entry of the comma separated list `vocab`: "P0" is in
/// "P0,priority/critical,critical", while "P", "P00" and "crit" are not.
pub fn piv_vocab_has(vocab: str, name: str) -> bool {
    if (name.len == 0) {
        return false;
    }
    var start : usize = 0;
    var i : usize = 0;
    while (i <= vocab.len) {
        var edge : bool = i == vocab.len;
        if (edge == false) {
            edge = vocab[i] == PIV_COMMA;
        }
        if (edge) {
            if (i - start == name.len) {
                var k : usize = 0;
                while (k < name.len and vocab[start + k] == name[k]) {
                    k = k + 1;
                }
                if (k == name.len) {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

/// The level a label name means in priority.t27's vocabulary: the most urgent level whose list holds it;
/// PIV_LEVEL_NONE when it is in none of them ("bug" means nothing to the Queen).
pub fn piv_label_level(name: str) -> u8 {
    if (piv_vocab_has(CRITICAL_LABELS, name)) {
        return LEVEL_CRITICAL;
    }
    if (piv_vocab_has(HIGH_LABELS, name)) {
        return LEVEL_HIGH;
    }
    if (piv_vocab_has(NORMAL_LABELS, name)) {
        return LEVEL_NORMAL;
    }
    if (piv_vocab_has(LOW_LABELS, name)) {
        return LEVEL_LOW;
    }
    return PIV_LEVEL_NONE;
}

/// The name of pool label k; "-" past the pool.
pub fn piv_label_name(k: u32) -> str {
    if (k >= PIV_POOL) {
        return PIV_NONE_NAME;
    }
    return PIV_POOL_NAME[k as usize];
}

/// The name of a level code; "-" past LOW.
pub fn piv_level_name(lv: u8) -> str {
    if (lv > LEVEL_LOW) {
        return PIV_NONE_NAME;
    }
    return PIV_LEVEL_NAME[lv as usize];
}

/// The name of a reason code (WHY_LISTING .. WHY_BLOCKED); "-" past the table.
pub fn piv_reason_name(w: u8) -> str {
    if (w > WHY_BLOCKED) {
        return PIV_NONE_NAME;
    }
    return PIV_WHY_NAME[w as usize];
}

/// Whether issue i carries pool label k in the label set.
pub fn piv_has(labels: u32, i: u32, k: u32) -> bool {
    if (i >= PIV_ISSUES or k >= PIV_POOL) {
        return false;
    }
    return (labels & ((1 as u32) << piv_chip(i, k))) != 0;
}

/// The labels of issue i as a 4-bit set (bit k = pool label k); 0 for a number that is not an issue.
pub fn piv_nibble(labels: u32, i: u32) -> u32 {
    if (i >= PIV_ISSUES) {
        return 0;
    }
    return (labels >> (i * PIV_POOL)) & 15;
}

/// The pool label that decides issue i: among its labels the one with the most urgent level, the lower
/// pool number on a tie. PIV_NO_PICK for an issue with no label the Queen reads.
pub fn piv_deciding(labels: u32, i: u32) -> u32 {
    var best : u32 = PIV_NO_PICK;
    var best_level : u8 = PIV_LEVEL_NONE;
    var k : u32 = 0;
    while (k < PIV_POOL) {
        if (piv_has(labels, i, k)) {
            let lv : u8 = piv_label_level(PIV_POOL_NAME[k as usize]);
            if (lv < best_level) {
                best = k;
                best_level = lv;
            }
        }
        k = k + 1;
    }
    return best;
}

; ---------------------------------------------------------------- L4 rules (all of them priority.t27's)

/// What priority.t27 says about every issue of a label set, computed once in listing order. Arrays are
/// indexed by issue.
pub struct PivTable {
    base: [7]u8,
    level: [7]u8,
    eff: [7]u8,
    reason: [7]u8,
    deciding: [7]u32,
    crit: [7]u32,
}

/// Run the source's rules over the 7 issues in listing order. `crit` is the number of issues listed before
/// this one whose base level is CRITICAL (a capped one still counts, as in `tri priority`).
pub fn piv_table(labels: u32) -> PivTable {
    var t : PivTable = PivTable { base: [0; 7], level: [0; 7], eff: [0; 7], reason: [0; 7], deciding: [0; 7], crit: [0; 7] };
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < PIV_ISSUES) {
        let k : usize = i as usize;
        let d : u32 = piv_deciding(labels, i);
        var b : u8 = LEVEL_NORMAL;
        if (d != PIV_NO_PICK) {
            b = piv_label_level(PIV_POOL_NAME[d as usize]);
        }
        let lv : u8 = capped_level(b, seen);
        let ef : u8 = effective_level(lv, d != PIV_NO_PICK, PIV_AGE[k]);
        t.base[k] = b;
        t.level[k] = lv;
        t.eff[k] = ef;
        t.deciding[k] = d;
        t.crit[k] = seen;
        t.reason[k] = why(b, lv, ef, d != PIV_NO_PICK, PIV_BLOCKERS[k]);
        if (b == LEVEL_CRITICAL) {
            seen = seen + 1;
        }
        i = i + 1;
    }
    return t;
}

/// The level the labels of issue i give it, before the cap and aging; NORMAL for an unlabelled issue.
pub fn piv_base(labels: u32, i: u32) -> u8 {
    if (i >= PIV_ISSUES) {
        return LEVEL_NORMAL;
    }
    return piv_table(labels).base[i as usize];
}

/// The level of issue i after the critical cap.
pub fn piv_level(labels: u32, i: u32) -> u8 {
    if (i >= PIV_ISSUES) {
        return LEVEL_NORMAL;
    }
    return piv_table(labels).level[i as usize];
}

/// The level issue i runs at, after the cap and aging.
pub fn piv_eff(labels: u32, i: u32) -> u8 {
    if (i >= PIV_ISSUES) {
        return LEVEL_NORMAL;
    }
    return piv_table(labels).eff[i as usize];
}

/// The reason code of issue i (WHY_LISTING .. WHY_BLOCKED).
pub fn piv_reason(labels: u32, i: u32) -> u8 {
    if (i >= PIV_ISSUES) {
        return WHY_LISTING;
    }
    return piv_table(labels).reason[i as usize];
}

/// How many issues listed before issue i have a CRITICAL label; compare with CRITICAL_CAP.
pub fn piv_criticals_before(labels: u32, i: u32) -> u32 {
    if (i >= PIV_ISSUES) {
        return 0;
    }
    return piv_table(labels).crit[i as usize];
}

/// Whether the Queen may take issue i at all: it has no open blocker (priority.t27 eligible).
pub fn piv_can_run(i: u32) -> bool {
    if (i >= PIV_ISSUES) {
        return false;
    }
    return eligible(PIV_BLOCKERS[i as usize]);
}

/// How many issues the source's order puts ahead of issue i (0 = first); PIV_NO_PICK for a number that is
/// not an issue. `outranks` is a strict total order, so the ranks are a permutation of 0..6.
pub fn piv_rank_in(t: PivTable, i: u32) -> u32 {
    if (i >= PIV_ISSUES) {
        return PIV_NO_PICK;
    }
    var ahead : u32 = 0;
    var j : u32 = 0;
    while (j < PIV_ISSUES) {
        if (j != i and outranks(t.eff[j as usize], t.level[j as usize], j, t.eff[i as usize], t.level[i as usize], i)) {
            ahead = ahead + 1;
        }
        j = j + 1;
    }
    return ahead;
}

/// The issue at rank r of a table; PIV_NO_PICK past the last rank.
pub fn piv_at_rank_in(t: PivTable, r: u32) -> u32 {
    var i : u32 = 0;
    while (i < PIV_ISSUES) {
        if (piv_rank_in(t, i) == r) {
            return i;
        }
        i = i + 1;
    }
    return PIV_NO_PICK;
}

/// The rank of issue i under a label set.
pub fn piv_rank_of(labels: u32, i: u32) -> u32 {
    return piv_rank_in(piv_table(labels), i);
}

/// The issue at rank r under a label set.
pub fn piv_at_rank(labels: u32, r: u32) -> u32 {
    return piv_at_rank_in(piv_table(labels), r);
}

/// The issue the Queen takes next under a label set: the first in priority order that has no open blocker.
/// PIV_NO_PICK when every issue is blocked.
pub fn piv_pick_of(labels: u32) -> u32 {
    let t : PivTable = piv_table(labels);
    var r : u32 = 0;
    while (r < PIV_ISSUES) {
        let i : u32 = piv_at_rank_in(t, r);
        if (i != PIV_NO_PICK and piv_can_run(i)) {
            return i;
        }
        r = r + 1;
    }
    return PIV_NO_PICK;
}

/// The pick of a petal; PIV_NO_PICK while the view shows no list.
pub fn piv_pick(p: PivState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PIV_NO_PICK;
    }
    return piv_pick_of(p.labels);
}

/// The pool label that decided the pick: the answer to the second half of the question. PIV_NO_PICK when
/// nothing is picked.
pub fn piv_answer_label(p: PivState) -> u32 {
    let i : u32 = piv_pick(p);
    if (i == PIV_NO_PICK) {
        return PIV_NO_PICK;
    }
    return piv_deciding(p.labels, i);
}

; ---------------------------------------------------------------- L5 views: list

/// Rows of the list: one per issue while the view is READY, none in any other state.
pub fn piv_list_rows(p: PivState) -> u32 {
    if (p.viz.lifecycle == VIZ_LC_READY) {
        return PIV_ISSUES;
    }
    return 0;
}

/// The issue drawn on row r (priority order); PIV_NO_PICK past the last row.
pub fn piv_list_issue(p: PivState, r: u32) -> u32 {
    if (r >= piv_list_rows(p)) {
        return PIV_NO_PICK;
    }
    return piv_at_rank(p.labels, r);
}

/// The row issue i is drawn on, the inverse of piv_list_issue; PIV_NO_PICK when it is not drawn.
pub fn piv_list_row_of(p: PivState, i: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or i >= PIV_ISSUES) {
        return PIV_NO_PICK;
    }
    return piv_rank_of(p.labels, i);
}

/// The top edge of row r in list coordinates.
pub fn piv_row_y(r: u32) -> u32 {
    return r * PIV_ROW_H;
}

/// The left edge of chip k in a row.
pub fn piv_chip_x(k: u32) -> u32 {
    return PIV_CHIP_X + k * PIV_CHIP_STRIDE;
}

/// How row r is lit: the contract's highlight of the issue on it (selection wins over hover).
pub fn piv_row_hl(p: PivState, r: u32) -> u8 {
    let i : u32 = piv_list_issue(p, r);
    if (i == PIV_NO_PICK) {
        return VIZ_HL_NONE;
    }
    return viz_highlight(p.viz, piv_issue_ref(i));
}

/// How the chip of label k on issue i is lit.
pub fn piv_chip_hl(p: PivState, i: u32, k: u32) -> u8 {
    return viz_highlight(p.viz, piv_chip_ref(i, k));
}

/// Whether the chip of label k on issue i is on (the issue carries the label). False unless READY.
pub fn piv_chip_on(p: PivState, i: u32, k: u32) -> bool {
    return p.viz.lifecycle == VIZ_LC_READY and piv_has(p.labels, i, k);
}

/// Row r is an issue the Queen skips because of an open blocker.
pub fn piv_row_skipped(p: PivState, r: u32) -> bool {
    let i : u32 = piv_list_issue(p, r);
    return i != PIV_NO_PICK and piv_can_run(i) == false;
}

/// Row r is the issue the Queen takes next.
pub fn piv_row_taken(p: PivState, r: u32) -> bool {
    let i : u32 = piv_list_issue(p, r);
    return i != PIV_NO_PICK and i == piv_pick(p);
}

/// The entity under a point in list coordinates: a chip when the point is on one, else the row's issue,
/// else VIZ_REF_NONE (outside the list, or no list).
pub fn piv_list_hit(p: PivState, px: u32, py: u32) -> u32 {
    if (px >= PIV_LIST_W or py >= piv_list_rows(p) * PIV_ROW_H) {
        return VIZ_REF_NONE;
    }
    let r : u32 = py / PIV_ROW_H;
    let i : u32 = piv_list_issue(p, r);
    if (i == PIV_NO_PICK) {
        return VIZ_REF_NONE;
    }
    let cy : u32 = py - r * PIV_ROW_H;
    if (px >= PIV_CHIP_X and cy >= PIV_CHIP_PAD and cy < PIV_CHIP_PAD + PIV_CHIP_H) {
        let k : u32 = (px - PIV_CHIP_X) / PIV_CHIP_STRIDE;
        let within : u32 = (px - PIV_CHIP_X) % PIV_CHIP_STRIDE;
        if (k < PIV_POOL and within < PIV_CHIP_W) {
            return piv_chip_ref(i, k);
        }
    }
    return piv_issue_ref(i);
}

/// The pointer moved to a point of the list: hover the entity there, or leave when there is none.
pub fn piv_pointer(p: PivState, px: u32, py: u32) -> PivState {
    let r : u32 = piv_list_hit(p, px, py);
    if (r == VIZ_REF_NONE) {
        return piv_apply(p, VIZ_EV_LEAVE, 0, 0);
    }
    return piv_apply(p, VIZ_EV_HOVER, r, 0);
}

/// How long the re-sort animation runs: PIV_RESORT_MS, or 0 under the reduced-motion preference.
pub fn piv_resort_ms(p: PivState) -> u32 {
    return viz_motion_ms(p.viz, PIV_RESORT_MS);
}

/// How many issues change row between two states: the rows the re-sort animation has to move.
pub fn piv_rows_moved(a: PivState, b: PivState) -> u32 {
    let ta : PivTable = piv_table(a.labels);
    let tb : PivTable = piv_table(b.labels);
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < PIV_ISSUES) {
        if (piv_rank_in(ta, i) != piv_rank_in(tb, i)) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; ---------------------------------------------------------------- L5 views: inspector

/// Everything about one issue: where it sits and why, and which label decided it.
pub struct PivInspect {
    found: bool,
    issue: u32,
    rank: u32,
    labels: u32,
    deciding: u32,
    base: u8,
    level: u8,
    eff: u8,
    reason: u8,
    age: u32,
    blockers: u32,
    can_run: bool,
    criticals_before: u32,
    picked: bool,
}

/// The inspection of issue i. `found` is false (and every other field neutral) unless the view is READY and
/// i is an issue of the fixture.
pub fn piv_inspect_issue(p: PivState, i: u32) -> PivInspect {
    var v : PivInspect = PivInspect { found: false, issue: PIV_NO_PICK, rank: PIV_NO_PICK, labels: 0, deciding: PIV_NO_PICK, base: LEVEL_NORMAL, level: LEVEL_NORMAL, eff: LEVEL_NORMAL, reason: WHY_LISTING, age: 0, blockers: 0, can_run: false, criticals_before: 0, picked: false };
    if (p.viz.lifecycle != VIZ_LC_READY or i >= PIV_ISSUES) {
        return v;
    }
    let t : PivTable = piv_table(p.labels);
    let k : usize = i as usize;
    v.found = true;
    v.issue = i;
    v.rank = piv_rank_in(t, i);
    v.labels = piv_nibble(p.labels, i);
    v.deciding = t.deciding[k];
    v.base = t.base[k];
    v.level = t.level[k];
    v.eff = t.eff[k];
    v.reason = t.reason[k];
    v.age = PIV_AGE[k];
    v.blockers = PIV_BLOCKERS[k];
    v.can_run = piv_can_run(i);
    v.criticals_before = t.crit[k];
    v.picked = piv_pick_of(p.labels) == i;
    return v;
}

/// The issue the inspector describes: the hovered issue (or the issue of the hovered chip), else the
/// selected one, else the Queen's pick. PIV_NO_PICK while the view shows no list.
pub fn piv_subject(p: PivState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PIV_NO_PICK;
    }
    let over : u32 = piv_ref_issue(p.viz.hover);
    if (over != PIV_NO_PICK) {
        return over;
    }
    let chosen : u32 = piv_ref_issue(p.viz.selected);
    if (chosen != PIV_NO_PICK) {
        return chosen;
    }
    return piv_pick(p);
}

/// The inspection of the subject.
pub fn piv_inspect(p: PivState) -> PivInspect {
    return piv_inspect_issue(p, piv_subject(p));
}

; ---------------------------------------------------------------- L5 views: badge

/// The truth the badge shows. While a list is on screen (READY) or was loaded empty (EMPTY) it is the
/// state's truth; in every other state nothing real is shown, so it is UNKNOWN, even if an earlier load was
/// VERIFIED.
pub fn piv_badge(p: PivState) -> u8 {
    if (p.viz.lifecycle == VIZ_LC_READY or p.viz.lifecycle == VIZ_LC_EMPTY) {
        return viz_truth(p.viz.truth);
    }
    return VIZ_TRUTH_UNKNOWN;
}

/// Whether the view may present its order as a result: the badge is LIVE or VERIFIED.
pub fn piv_claims(p: PivState) -> bool {
    return viz_may_claim(piv_badge(p));
}

; ---------------------------------------------------------------- L6 host

/// The layout: badge, list and inspector as three root slots, in focus order. Rects are in host coordinates.
pub fn piv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, 20, 10, 260, 40);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, 20, 60, PIV_LIST_W, PIV_LIST_H);
    h = vh_add(h, VIZ_REP_INSPECTOR, VH_ROOT, 600, 60, 280, 280);
    return h;
}

/// The reps a host uses, as a bit set.
pub fn piv_host_reps(h: VizHost) -> u32 {
    var acc : u32 = 0;
    var s : u32 = 0;
    while (s < h.count and s < VH_MAX_SLOTS) {
        acc = acc | viz_rep_bit(h.rep[s as usize]);
        s = s + 1;
    }
    return acc;
}

/// The reps of the petal: list, inspector and badge. This is the plan's row 8 (292).
pub fn piv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_INSPECTOR) | viz_rep_bit(VIZ_REP_BADGE);
}

/// The entity under a point in host coordinates: when the deepest slot there is the list slot `slot`, the
/// list's own hit test at the point relative to that slot; else VIZ_REF_NONE.
pub fn piv_host_hit(p: PivState, h: VizHost, slot: u32, px: u32, py: u32) -> u32 {
    if (vh_hit(h, px, py) != slot) {
        return VIZ_REF_NONE;
    }
    return piv_list_hit(p, px - vh_abs_x(h, slot), py - vh_abs_y(h, slot));
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// A petal that has not loaded: idle, truth UNKNOWN, the fixture's labels.
fn piv_idle() -> PivState {
    return PivState { viz: viz_init(0, 0), labels: PIV_START };
}

/// Flip label k on issue i through the one reducer.
fn piv_flip(p: PivState, i: u32, k: u32) -> PivState {
    return piv_apply(p, PIV_EV_TOGGLE_LABEL, piv_chip(i, k), 0);
}

/// The seven ranks in order, written out: true when rank 0 is a, rank 1 is b, and so on.
fn piv_order_is(labels: u32, a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32) -> bool {
    return piv_at_rank(labels, 0) == a and piv_at_rank(labels, 1) == b and piv_at_rank(labels, 2) == c and piv_at_rank(labels, 3) == d and piv_at_rank(labels, 4) == e and piv_at_rank(labels, 5) == f and piv_at_rank(labels, 6) == g;
}

/// The pick found a second way, to check piv_pick_of against: one pass over the listing carrying the best
/// eligible issue so far, the levels from the source functions, the base level read straight from the pool
/// bits (pool label k is level k), no table and no rank.
fn piv_oracle_pick(labels: u32) -> u32 {
    var best : u32 = PIV_NO_PICK;
    var best_eff : u8 = LEVEL_LOW;
    var best_level : u8 = LEVEL_LOW;
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < PIV_ISSUES) {
        var base : u8 = LEVEL_NORMAL;
        var marked : bool = false;
        var k : u32 = PIV_POOL;
        while (k > 0) {
            k = k - 1;
            if (((labels >> (i * PIV_POOL + k)) % 2) == 1) {
                base = k as u8;
                marked = true;
            }
        }
        let lv : u8 = capped_level(base, seen);
        let ef : u8 = effective_level(lv, marked, PIV_AGE[i as usize]);
        if (base == LEVEL_CRITICAL) {
            seen = seen + 1;
        }
        if (eligible(PIV_BLOCKERS[i as usize])) {
            if (best == PIV_NO_PICK or outranks(ef, lv, i, best_eff, best_level, best)) {
                best = i;
                best_eff = ef;
                best_level = lv;
            }
        }
        i = i + 1;
    }
    return best;
}

; ---------------------------------------------------------------- tests: entities and the source's rules

test a_fresh_petal_shows_nothing_and_opening_loads_the_fixture {
    let q : PivState = piv_idle();
    assert q.viz.lifecycle == VIZ_LC_IDLE;
    assert q.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert piv_list_rows(q) == 0;
    assert piv_pick(q) == PIV_NO_PICK;
    assert piv_badge(q) == VIZ_TRUTH_UNKNOWN;
    let p : PivState = piv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == PIV_ITEMS;
    assert p.viz.focus_count == PIV_ITEMS;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.labels == PIV_START;
    assert piv_list_rows(p) == PIV_ISSUES;
    assert piv_badge(p) == VIZ_TRUTH_VERIFIED;
}

test the_vocabulary_matcher_takes_whole_entries_only {
    assert piv_vocab_has(CRITICAL_LABELS, "P0");
    assert piv_vocab_has(CRITICAL_LABELS, "priority/critical");
    assert piv_vocab_has(CRITICAL_LABELS, "critical");
    assert piv_vocab_has(HIGH_LABELS, "high-priority");
    assert piv_vocab_has(LOW_LABELS, "P4");
    assert piv_vocab_has(NORMAL_LABELS, "P0") == false;
    assert piv_vocab_has(CRITICAL_LABELS, "P") == false;
    assert piv_vocab_has(CRITICAL_LABELS, "P00") == false;
    assert piv_vocab_has(CRITICAL_LABELS, "crit") == false;
    assert piv_vocab_has(HIGH_LABELS, "high") == false;
    assert piv_vocab_has(CRITICAL_LABELS, "") == false;
    assert piv_label_level("P0") == LEVEL_CRITICAL;
    assert piv_label_level("priority/high") == LEVEL_HIGH;
    assert piv_label_level("priority/medium") == LEVEL_NORMAL;
    assert piv_label_level("P4") == LEVEL_LOW;
    assert piv_label_level("bug") == PIV_LEVEL_NONE;
    assert piv_label_level("") == PIV_LEVEL_NONE;
    var k : u32 = 0;
    while (k < PIV_POOL) {
        assert piv_label_level(PIV_POOL_NAME[k as usize]) == k as u8;
        k = k + 1;
    }
    assert piv_label_name(0) == "P0";
    assert piv_label_name(3) == "P3";
    assert piv_label_name(4) == "-";
    assert piv_level_name(LEVEL_HIGH) == "HIGH";
    assert piv_reason_name(WHY_AGED) == "aged";
    assert piv_reason_name(WHY_BLOCKED) == "blocked";
}

test the_fixture_has_the_shape_the_petal_assumes {
    assert PIV_ISSUES * PIV_POOL == PIV_CHIPS;
    assert PIV_ISSUES + PIV_CHIPS == PIV_ITEMS;
    assert PIV_START < 268435456;
    assert PIV_ROW_H * PIV_ISSUES == PIV_LIST_H;
    assert PIV_CHIP_X + 3 * PIV_CHIP_STRIDE + PIV_CHIP_W <= PIV_LIST_W;
    assert PIV_AGE[0] < AGING_DAYS;
    assert PIV_AGE[5] / AGING_DAYS == 1;
    assert PIV_AGE[1] / AGING_DAYS > MAX_AGING_STEPS;
    assert piv_can_run(0);
    assert piv_can_run(6) == false;
    assert eligible(PIV_BLOCKERS[6]) == false;
    var i : u32 = 0;
    var criticals : u32 = 0;
    while (i < PIV_ISSUES) {
        assert PIV_TITLE[i as usize].len > 0;
        if (piv_base(PIV_START, i) == LEVEL_CRITICAL) {
            criticals = criticals + 1;
        }
        i = i + 1;
    }
    assert criticals == CRITICAL_CAP + 1;
    assert piv_nibble(PIV_START, 0) == 1;
    assert piv_nibble(PIV_START, 1) == 8;
    assert piv_nibble(PIV_START, 5) == 0;
    assert piv_nibble(PIV_START, 6) == 6;
    assert piv_nibble(PIV_START, 7) == 0;
}

test the_levels_of_the_fixture_come_from_the_source_functions {
    let l : u32 = PIV_START;
    assert piv_base(l, 0) == LEVEL_CRITICAL;
    assert piv_level(l, 0) == capped_level(LEVEL_CRITICAL, 0);
    assert piv_reason(l, 0) == WHY_LABEL;
    assert piv_deciding(l, 0) == 0;
    assert piv_base(l, 1) == LEVEL_LOW;
    assert piv_eff(l, 1) == effective_level(LEVEL_LOW, true, 30);
    assert piv_eff(l, 1) == LEVEL_NORMAL;
    assert piv_reason(l, 1) == WHY_AGED;
    assert piv_deciding(l, 1) == 3;
    assert piv_base(l, 4) == LEVEL_CRITICAL;
    assert piv_level(l, 4) == capped_level(LEVEL_CRITICAL, 3);
    assert piv_level(l, 4) == LEVEL_HIGH;
    assert piv_reason(l, 4) == why(LEVEL_CRITICAL, LEVEL_HIGH, LEVEL_HIGH, true, 0);
    assert piv_reason(l, 4) == WHY_CAPPED;
    assert piv_base(l, 5) == LEVEL_NORMAL;
    assert piv_eff(l, 5) == effective_level(LEVEL_NORMAL, false, 15);
    assert piv_eff(l, 5) == LEVEL_NORMAL;
    assert piv_reason(l, 5) == WHY_LISTING;
    assert piv_deciding(l, 5) == PIV_NO_PICK;
    assert piv_base(l, 6) == LEVEL_HIGH;
    assert piv_deciding(l, 6) == 1;
    assert piv_reason(l, 6) == WHY_BLOCKED;
}

test the_cap_and_aging_adjust_the_label_level_by_the_source_rules {
    let l : u32 = PIV_START;
    assert piv_criticals_before(l, 3) == CRITICAL_CAP - 1;
    assert piv_criticals_before(l, 4) == CRITICAL_CAP;
    assert piv_level(l, 3) == LEVEL_CRITICAL;
    assert piv_level(l, 4) == LEVEL_HIGH;
    let freed : PivState = piv_flip(piv_open(), 0, 0);
    assert piv_criticals_before(freed.labels, 4) == CRITICAL_CAP - 1;
    assert piv_level(freed.labels, 4) == LEVEL_CRITICAL;
    assert piv_reason(freed.labels, 4) == WHY_LABEL;
    assert piv_eff(l, 1) > LEVEL_HIGH;
    assert piv_eff(l, 1) == LEVEL_NORMAL;
    let aged : PivState = piv_flip(piv_open(), 5, 2);
    assert piv_base(aged.labels, 5) == LEVEL_NORMAL;
    assert piv_eff(aged.labels, 5) == LEVEL_HIGH;
    assert piv_eff(aged.labels, 5) == effective_level(LEVEL_NORMAL, true, 15);
    assert piv_reason(aged.labels, 5) == WHY_AGED;
}

test the_priority_order_of_the_fixture_is_hand_checked {
    assert piv_order_is(PIV_START, 0, 2, 3, 4, 6, 5, 1);
    assert piv_rank_of(PIV_START, 0) == 0;
    assert piv_rank_of(PIV_START, 2) == 1;
    assert piv_rank_of(PIV_START, 3) == 2;
    assert piv_rank_of(PIV_START, 4) == 3;
    assert piv_rank_of(PIV_START, 6) == 4;
    assert piv_rank_of(PIV_START, 5) == 5;
    assert piv_rank_of(PIV_START, 1) == 6;
    assert piv_at_rank(PIV_START, 7) == PIV_NO_PICK;
    assert piv_rank_of(PIV_START, 7) == PIV_NO_PICK;
    assert piv_pick_of(PIV_START) == 0;
    assert piv_rank_of(PIV_START, 6) > piv_rank_of(PIV_START, 4);
}

test a_blocked_issue_leads_the_order_only_when_nothing_else_is_labelled {
    var p : PivState = piv_open();
    p = piv_flip(p, 0, 0);
    p = piv_flip(p, 2, 0);
    p = piv_flip(p, 3, 0);
    p = piv_flip(p, 4, 0);
    assert p.labels == 100663424;
    assert piv_order_is(p.labels, 6, 0, 2, 3, 4, 5, 1);
    assert piv_rank_of(p.labels, 6) == 0;
    assert piv_can_run(6) == false;
    assert piv_pick(p) == 0;
    assert piv_pick(p) != piv_at_rank(p.labels, 0);
    assert piv_list_issue(p, 0) == 6;
    assert piv_row_skipped(p, 0);
    assert piv_row_taken(p, 0) == false;
    assert piv_row_taken(p, 1);
    assert piv_row_skipped(p, 1) == false;
    assert piv_answer_label(p) == PIV_NO_PICK;
}

test the_ranks_are_a_permutation_after_every_single_toggle {
    var c : u32 = 0;
    while (c < PIV_CHIPS) {
        let p : PivState = piv_apply(piv_open(), PIV_EV_TOGGLE_LABEL, c, 0);
        let t : PivTable = piv_table(p.labels);
        var i : u32 = 0;
        while (i < PIV_ISSUES) {
            let r : u32 = piv_rank_in(t, i);
            assert r < PIV_ISSUES;
            assert piv_at_rank_in(t, r) == i;
            i = i + 1;
        }
        c = c + 1;
    }
}

test the_pick_and_the_label_that_decided_it_answer_the_question {
    let p : PivState = piv_open();
    assert piv_pick(p) == 0;
    assert piv_answer_label(p) == 0;
    assert piv_label_name(piv_answer_label(p)) == "P0";
    assert piv_row_taken(p, 0);
    assert piv_row_taken(p, 1) == false;
    assert piv_row_skipped(p, 4);
    assert piv_deciding(PIV_START, 6) == 1;
    let w : PivState = piv_flip(piv_open(), 6, 1);
    assert piv_deciding(w.labels, 6) == 2;
    assert piv_base(w.labels, 6) == LEVEL_NORMAL;
}

; ---------------------------------------------------------------- tests: the input change

test toggling_a_label_re_sorts_the_list_and_moves_the_pick {
    let p0 : PivState = piv_open();
    let p1 : PivState = piv_apply(p0, PIV_EV_TOGGLE_LABEL, piv_chip(0, 0), 0);
    assert p1.labels == PIV_START - 1;
    assert piv_has(p1.labels, 0, 0) == false;
    assert piv_order_is(p1.labels, 2, 3, 4, 6, 0, 5, 1);
    assert piv_pick(p1) == 2;
    assert piv_answer_label(p1) == 0;
    assert piv_reason(p0.labels, 4) == WHY_CAPPED;
    assert piv_reason(p1.labels, 4) == WHY_LABEL;
    assert piv_rows_moved(p0, p1) == 5;
    assert piv_rows_moved(p0, p0) == 0;
    assert p1.viz.truth == VIZ_TRUTH_DEMO;
    assert p1.viz.revision == p0.viz.revision + 1;
}

test the_toggle_matches_priority_t27_called_by_hand {
    let p : PivState = piv_apply(piv_open(), PIV_EV_TOGGLE_LABEL, 0, 0);
    let l2 : u8 = capped_level(LEVEL_CRITICAL, 0);
    let l3 : u8 = capped_level(LEVEL_CRITICAL, 1);
    let l4 : u8 = capped_level(LEVEL_CRITICAL, 2);
    assert l2 == LEVEL_CRITICAL;
    assert l3 == LEVEL_CRITICAL;
    assert l4 == LEVEL_CRITICAL;
    let l0 : u8 = capped_level(LEVEL_NORMAL, 0);
    let e0 : u8 = effective_level(l0, false, 3);
    let e1 : u8 = effective_level(LEVEL_LOW, true, 30);
    let e5 : u8 = effective_level(LEVEL_NORMAL, false, 15);
    let e6 : u8 = effective_level(LEVEL_HIGH, true, 30);
    assert eligible(0);
    assert eligible(2) == false;
    assert outranks(l2, l2, 2, l3, l3, 3);
    assert outranks(l2, l2, 2, l4, l4, 4);
    assert outranks(l2, l2, 2, e6, LEVEL_HIGH, 6);
    assert outranks(l2, l2, 2, e0, l0, 0);
    assert outranks(l2, l2, 2, e5, LEVEL_NORMAL, 5);
    assert outranks(l2, l2, 2, e1, LEVEL_LOW, 1);
    assert piv_pick(p) == 2;
    assert outranks(e6, LEVEL_HIGH, 6, e0, l0, 0);
    assert outranks(e0, l0, 0, e5, LEVEL_NORMAL, 5);
    assert outranks(e5, LEVEL_NORMAL, 5, e1, LEVEL_LOW, 1);
    assert piv_rank_of(p.labels, 6) == 3;
    assert piv_rank_of(p.labels, 0) == 4;
    assert piv_rank_of(p.labels, 5) == 5;
    assert piv_rank_of(p.labels, 1) == 6;
}

test the_pick_equals_an_independent_scan_for_the_fixture_and_every_toggle {
    assert piv_pick_of(PIV_START) == piv_oracle_pick(PIV_START);
    var c : u32 = 0;
    while (c < PIV_CHIPS) {
        let p : PivState = piv_apply(piv_open(), PIV_EV_TOGGLE_LABEL, c, 0);
        assert piv_pick(p) == piv_oracle_pick(p.labels);
        c = c + 1;
    }
    var m : u32 = 0;
    while (m < 2000) {
        let labels : u32 = m * 99991;
        assert piv_pick_of(labels) == piv_oracle_pick(labels);
        m = m + 1;
    }
}

test toggling_a_label_twice_restores_the_labels_the_truth_and_the_pick {
    let p0 : PivState = piv_open();
    var p : PivState = piv_apply(p0, PIV_EV_TOGGLE_LABEL, piv_chip(3, 0), 0);
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert piv_claims(p) == false;
    assert piv_pick(p) != piv_pick(p0) or piv_order_is(p.labels, 0, 2, 4, 6, 3, 5, 1);
    p = piv_apply(p, PIV_EV_TOGGLE_LABEL, piv_chip(3, 0), 0);
    assert p.labels == PIV_START;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.viz.revision == p0.viz.revision + 2;
    assert piv_pick(p) == piv_pick(p0);
    assert piv_order_is(p.labels, 0, 2, 3, 4, 6, 5, 1);
}

test more_criticals_are_capped_and_a_new_label_can_age_without_moving_anything {
    let fifth : PivState = piv_flip(piv_open(), 5, 0);
    assert piv_base(fifth.labels, 5) == LEVEL_CRITICAL;
    assert piv_level(fifth.labels, 5) == LEVEL_HIGH;
    assert piv_reason(fifth.labels, 5) == WHY_CAPPED;
    assert piv_criticals_before(fifth.labels, 5) == CRITICAL_CAP + 1;
    assert piv_order_is(fifth.labels, 0, 2, 3, 4, 5, 6, 1);
    let early : PivState = piv_flip(piv_open(), 1, 0);
    assert piv_deciding(early.labels, 1) == 0;
    assert piv_base(early.labels, 1) == LEVEL_CRITICAL;
    assert piv_reason(early.labels, 1) == WHY_LABEL;
    assert piv_reason(early.labels, 3) == WHY_CAPPED;
    assert piv_reason(early.labels, 4) == WHY_CAPPED;
    assert piv_order_is(early.labels, 0, 1, 2, 3, 4, 6, 5);
    assert piv_pick(early) == 0;
    let ageing : PivState = piv_flip(piv_open(), 5, 2);
    assert piv_reason(ageing.labels, 5) == WHY_AGED;
    assert piv_level(ageing.labels, 5) == LEVEL_NORMAL;
    assert piv_order_is(ageing.labels, 0, 2, 3, 4, 6, 5, 1);
    assert piv_rows_moved(piv_open(), ageing) == 0;
}

; ---------------------------------------------------------------- tests: truth

test the_badge_is_verified_on_the_fixture_and_demo_once_a_label_changes {
    let p : PivState = piv_open();
    assert piv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert piv_claims(p);
    assert piv_truth_for(PIV_START) == VIZ_TRUTH_VERIFIED;
    let q : PivState = piv_flip(p, 2, 0);
    assert piv_badge(q) == VIZ_TRUTH_DEMO;
    assert piv_claims(q) == false;
    assert viz_may_claim(piv_badge(q)) == false;
    var c : u32 = 0;
    while (c < PIV_CHIPS) {
        let one : PivState = piv_apply(p, PIV_EV_TOGGLE_LABEL, c, 0);
        assert one.labels != PIV_START;
        assert piv_badge(one) == VIZ_TRUTH_DEMO;
        let back : PivState = piv_apply(one, PIV_EV_TOGGLE_LABEL, c, 0);
        assert back.labels == PIV_START;
        assert piv_badge(back) == VIZ_TRUTH_VERIFIED;
        c = c + 1;
    }
}

test the_badge_is_unknown_when_no_list_is_on_screen {
    let idle : PivState = piv_idle();
    assert piv_badge(idle) == VIZ_TRUTH_UNKNOWN;
    let loading : PivState = piv_apply(idle, VIZ_EV_LOAD, 0, 0);
    assert loading.viz.lifecycle == VIZ_LC_LOADING;
    assert piv_badge(loading) == VIZ_TRUTH_UNKNOWN;
    let failed : PivState = piv_apply(piv_open(), VIZ_EV_FAILED, 9, 0);
    assert failed.viz.lifecycle == VIZ_LC_ERROR;
    assert failed.viz.truth == VIZ_TRUTH_VERIFIED;
    assert piv_badge(failed) == VIZ_TRUTH_UNKNOWN;
    assert piv_claims(failed) == false;
    assert piv_badge(piv_open_empty()) == VIZ_TRUTH_VERIFIED;
    var cached : PivState = piv_apply(idle, VIZ_EV_LOAD, 0, 0);
    cached = piv_apply(cached, VIZ_EV_LOADED, 0, VIZ_TRUTH_CACHED as u32);
    assert cached.viz.lifecycle == VIZ_LC_EMPTY;
    assert piv_badge(cached) == VIZ_TRUTH_CACHED;
}

test a_reload_keeps_the_demo_label_while_the_labels_differ_from_the_fixture {
    let edited : PivState = piv_flip(piv_open(), 6, 1);
    assert edited.viz.truth == VIZ_TRUTH_DEMO;
    var p : PivState = piv_apply(edited, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert p.labels == edited.labels;
    p = piv_apply(p, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.truth == VIZ_TRUTH_DEMO;
    assert piv_claims(p) == false;
    var c : PivState = piv_apply(edited, VIZ_EV_LOAD, 0, 0);
    c = piv_apply(c, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_CACHED as u32);
    assert c.viz.truth == VIZ_TRUTH_CACHED;
    var r : PivState = piv_flip(p, 6, 1);
    assert r.labels == PIV_START;
    assert r.viz.truth == VIZ_TRUTH_VERIFIED;
    r = piv_apply(r, VIZ_EV_LOAD, 0, 0);
    r = piv_apply(r, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert r.viz.truth == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- tests: lifecycle

test an_idle_or_loading_view_shows_nothing_and_ignores_input {
    var p : PivState = piv_idle();
    var round : u32 = 0;
    while (round < 2) {
        assert piv_list_rows(p) == 0;
        assert piv_pick(p) == PIV_NO_PICK;
        assert piv_subject(p) == PIV_NO_PICK;
        assert piv_inspect(p).found == false;
        assert piv_list_hit(p, 10, 10) == VIZ_REF_NONE;
        assert piv_focus_ref(p, 0) == VIZ_REF_NONE;
        let t : PivState = piv_apply(p, PIV_EV_TOGGLE_LABEL, 0, 0);
        assert t.labels == p.labels;
        assert t.viz.revision == p.viz.revision;
        assert piv_apply(p, VIZ_EV_HOVER, piv_issue_ref(0), 0).viz.hover == VIZ_REF_NONE;
        assert piv_apply(p, VIZ_EV_SELECT, piv_issue_ref(0), 0).viz.selected == VIZ_REF_NONE;
        assert piv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0).viz.focus == VIZ_NO_FOCUS;
        p = piv_apply(p, VIZ_EV_LOAD, 0, 0);
        round = round + 1;
    }
    assert piv_apply(piv_idle(), VIZ_EV_LOADED, PIV_ITEMS, 1).viz.lifecycle == VIZ_LC_IDLE;
}

test an_empty_listing_has_no_rows_no_pick_and_no_input {
    let e : PivState = piv_open_empty();
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert piv_list_rows(e) == 0;
    assert piv_list_issue(e, 0) == PIV_NO_PICK;
    assert piv_list_row_of(e, 0) == PIV_NO_PICK;
    assert piv_pick(e) == PIV_NO_PICK;
    assert piv_inspect(e).found == false;
    assert piv_list_hit(e, 10, 10) == VIZ_REF_NONE;
    let t : PivState = piv_apply(e, PIV_EV_TOGGLE_LABEL, 5, 0);
    assert t.labels == e.labels;
    assert t.viz.lifecycle == VIZ_LC_EMPTY;
    assert piv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz.focus == VIZ_NO_FOCUS;
    var r : PivState = piv_apply(e, VIZ_EV_LOAD, 0, 0);
    r = piv_apply(r, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert r.viz.lifecycle == VIZ_LC_READY;
    assert piv_pick(r) == 0;
}

test a_failed_load_is_an_error_that_a_retry_can_leave {
    var p : PivState = piv_flip(piv_open(), 0, 0);
    p = piv_apply(p, VIZ_EV_FAILED, 7, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 7;
    assert piv_list_rows(p) == 0;
    assert piv_pick(p) == PIV_NO_PICK;
    assert piv_inspect(p).found == false;
    assert piv_focus_ref(p, 0) == VIZ_REF_NONE;
    let t : PivState = piv_apply(p, PIV_EV_TOGGLE_LABEL, 3, 0);
    assert t.labels == p.labels;
    assert t.viz.revision == p.viz.revision;
    assert piv_apply(piv_open(), VIZ_EV_FAILED, 0, 0).viz.error == VIZ_ERR_UNSPECIFIED;
    assert piv_apply(piv_open(), VIZ_EV_FAILED, 256, 0).viz.error == VIZ_ERR_UNSPECIFIED;
    assert piv_apply(piv_open(), VIZ_EV_RETRY, 0, 0).viz.lifecycle == VIZ_LC_READY;
    var q : PivState = piv_apply(p, VIZ_EV_RETRY, 0, 0);
    assert q.viz.lifecycle == VIZ_LC_LOADING;
    assert q.viz.error == 0;
    q = piv_apply(q, VIZ_EV_LOADED, PIV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert q.viz.lifecycle == VIZ_LC_READY;
    assert q.labels == p.labels;
    assert q.viz.truth == VIZ_TRUTH_DEMO;
    assert piv_pick(q) == 2;
}

test a_reference_outside_the_fixture_names_no_issue {
    let p : PivState = piv_open();
    assert piv_issue_ref(7) == VIZ_REF_NONE;
    assert piv_chip_ref(7, 0) == VIZ_REF_NONE;
    assert piv_chip_ref(0, 4) == VIZ_REF_NONE;
    assert piv_ref_issue(viz_ref(VIZ_ENT_NODE, 7)) == PIV_NO_PICK;
    assert piv_ref_issue(viz_ref(VIZ_ENT_NODE, 99)) == PIV_NO_PICK;
    assert piv_ref_issue(viz_ref(VIZ_ENT_CELL, 28)) == PIV_NO_PICK;
    assert piv_ref_issue(viz_ref(VIZ_ENT_EDGE, 0)) == PIV_NO_PICK;
    assert piv_ref_issue(VIZ_REF_NONE) == PIV_NO_PICK;
    assert piv_ref_issue(piv_chip_ref(6, 3)) == 6;
    assert piv_ref_issue(piv_chip_ref(0, 0)) == 0;
    assert piv_inspect_issue(p, 7).found == false;
    assert piv_inspect_issue(p, 65535).found == false;
    assert piv_rank_of(p.labels, 7) == PIV_NO_PICK;
    assert piv_at_rank(p.labels, 7) == PIV_NO_PICK;
    assert piv_focus_ref(p, 35) == VIZ_REF_NONE;
    assert piv_focus_ref(p, 65535) == VIZ_REF_NONE;
    assert piv_click(p, viz_ref(VIZ_ENT_NODE, 7)).viz.selected == VIZ_REF_NONE;
    assert piv_click(p, viz_ref(VIZ_ENT_CELL, 28)).labels == PIV_START;
    assert piv_click(p, viz_ref(VIZ_ENT_EDGE, 0)).viz.revision == p.viz.revision;
    let t : PivState = piv_apply(p, PIV_EV_TOGGLE_LABEL, 28, 0);
    assert t.labels == PIV_START;
    assert t.viz.revision == p.viz.revision;
    let h : PivState = piv_apply(p, VIZ_EV_HOVER, viz_ref(VIZ_ENT_NODE, 40), 0);
    assert piv_subject(h) == piv_pick(p);
    var r : u32 = 0;
    while (r < PIV_ISSUES) {
        assert piv_row_hl(h, r) == VIZ_HL_NONE;
        r = r + 1;
    }
    assert piv_level(p.labels, 9) == LEVEL_NORMAL;
    assert piv_reason(p.labels, 9) == WHY_LISTING;
    assert piv_can_run(7) == false;
    assert piv_has(p.labels, 0, 4) == false;
}

; ---------------------------------------------------------------- tests: views

test the_list_has_one_row_per_issue_in_priority_order {
    let p : PivState = piv_open();
    assert piv_list_rows(p) == PIV_ISSUES;
    var r : u32 = 0;
    while (r < PIV_ISSUES) {
        let i : u32 = piv_list_issue(p, r);
        assert i < PIV_ISSUES;
        assert piv_list_row_of(p, i) == r;
        assert piv_row_y(r) == r * 40;
        r = r + 1;
    }
    assert piv_list_issue(p, 0) == 0;
    assert piv_list_issue(p, 4) == 6;
    assert piv_list_issue(p, 6) == 1;
    assert piv_list_issue(p, 7) == PIV_NO_PICK;
    assert piv_row_skipped(p, 4);
    assert piv_row_skipped(p, 0) == false;
    assert piv_chip_on(p, 0, 0);
    assert piv_chip_on(p, 0, 1) == false;
    assert piv_chip_on(p, 6, 1);
    assert piv_chip_on(p, 6, 2);
    assert piv_chip_on(piv_idle(), 0, 0) == false;
}

test the_list_hit_test_inverts_the_layout {
    let p : PivState = piv_open();
    assert piv_list_hit(p, 10, 5) == piv_issue_ref(0);
    assert piv_list_hit(p, 10, 45) == piv_issue_ref(2);
    assert piv_list_hit(p, 10, 279) == piv_issue_ref(1);
    assert piv_list_hit(p, 10, 280) == VIZ_REF_NONE;
    assert piv_list_hit(p, 560, 10) == VIZ_REF_NONE;
    assert piv_list_hit(p, 299, 46) == piv_issue_ref(2);
    assert piv_list_hit(p, 310, 46) == piv_chip_ref(2, 0);
    assert piv_list_hit(p, 310, 45) == piv_issue_ref(2);
    assert piv_list_hit(p, 310, 73) == piv_chip_ref(2, 0);
    assert piv_list_hit(p, 310, 74) == piv_issue_ref(2);
    assert piv_list_hit(p, 351, 46) == piv_chip_ref(2, 0);
    assert piv_list_hit(p, 352, 46) == piv_issue_ref(2);
    assert piv_list_hit(p, 365, 46) == piv_chip_ref(2, 1);
    assert piv_list_hit(p, 500, 46) == piv_chip_ref(2, 3);
    assert piv_list_hit(p, 539, 46) == piv_issue_ref(2);
    var r : u32 = 0;
    while (r < PIV_ISSUES) {
        let i : u32 = piv_list_issue(p, r);
        assert piv_list_hit(p, 20, piv_row_y(r) + 20) == piv_issue_ref(i);
        var k : u32 = 0;
        while (k < PIV_POOL) {
            assert piv_list_hit(p, piv_chip_x(k) + 10, piv_row_y(r) + 10) == piv_chip_ref(i, k);
            k = k + 1;
        }
        r = r + 1;
    }
}

test the_inspector_follows_hover_then_selection_then_the_pick {
    let p0 : PivState = piv_open();
    let a : PivInspect = piv_inspect(p0);
    assert a.found;
    assert a.issue == 0;
    assert a.picked;
    assert a.rank == 0;
    assert a.deciding == 0;
    assert a.base == LEVEL_CRITICAL;
    assert a.level == LEVEL_CRITICAL;
    assert a.eff == LEVEL_CRITICAL;
    assert a.reason == WHY_LABEL;
    assert a.age == 3;
    assert a.blockers == 0;
    assert a.can_run;
    assert a.criticals_before == 0;
    assert a.labels == 1;
    var p : PivState = piv_apply(p0, VIZ_EV_SELECT, piv_issue_ref(4), 0);
    let b : PivInspect = piv_inspect(p);
    assert b.issue == 4;
    assert b.picked == false;
    assert b.rank == 3;
    assert b.base == LEVEL_CRITICAL;
    assert b.level == LEVEL_HIGH;
    assert b.eff == LEVEL_HIGH;
    assert b.reason == WHY_CAPPED;
    assert b.criticals_before == CRITICAL_CAP;
    p = piv_apply(p, VIZ_EV_HOVER, piv_issue_ref(6), 0);
    let c : PivInspect = piv_inspect(p);
    assert c.issue == 6;
    assert c.rank == 4;
    assert c.base == LEVEL_HIGH;
    assert c.deciding == 1;
    assert c.labels == 6;
    assert c.blockers == 2;
    assert c.can_run == false;
    assert c.reason == WHY_BLOCKED;
    p = piv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert piv_inspect(p).issue == 4;
    p = piv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert piv_inspect(p).issue == 0;
}

test the_views_are_linked_through_the_one_state {
    var q : PivState = piv_pointer(piv_open(), 10, 165);
    assert q.viz.hover == piv_issue_ref(6);
    assert piv_row_hl(q, 4) == VIZ_HL_HOVER;
    assert piv_row_hl(q, 0) == VIZ_HL_NONE;
    assert piv_subject(q) == 6;
    assert piv_inspect(q).issue == 6;
    q = piv_click(q, piv_list_hit(q, 10, 45));
    assert q.viz.selected == piv_issue_ref(2);
    assert piv_row_hl(q, 1) == VIZ_HL_SELECT;
    assert piv_row_hl(q, 4) == VIZ_HL_HOVER;
    assert piv_inspect(q).issue == 6;
    q = piv_pointer(q, 700, 10);
    assert q.viz.hover == VIZ_REF_NONE;
    assert piv_row_hl(q, 4) == VIZ_HL_NONE;
    assert piv_inspect(q).issue == 2;
    q = piv_pointer(q, 310, 126);
    assert q.viz.hover == piv_chip_ref(4, 0);
    assert piv_chip_hl(q, 4, 0) == VIZ_HL_HOVER;
    assert piv_chip_hl(q, 4, 1) == VIZ_HL_NONE;
    assert piv_subject(q) == 4;
    var s : PivState = piv_apply(piv_open(), VIZ_EV_HOVER, piv_issue_ref(2), 0);
    s = piv_apply(s, VIZ_EV_SELECT, piv_issue_ref(2), 0);
    assert piv_row_hl(s, 1) == VIZ_HL_SELECT;
    s = piv_click(s, piv_issue_ref(2));
    assert s.viz.selected == VIZ_REF_NONE;
    assert piv_row_hl(s, 1) == VIZ_HL_HOVER;
}

test one_click_on_a_chip_changes_the_list_the_inspector_and_the_badge {
    let p0 : PivState = piv_open();
    assert piv_list_issue(p0, 0) == 0;
    assert piv_inspect(p0).issue == 0;
    assert piv_badge(p0) == VIZ_TRUTH_VERIFIED;
    assert piv_chip_on(p0, 0, 0);
    let p1 : PivState = piv_click(p0, piv_list_hit(p0, 310, 6));
    assert p1.labels == PIV_START - 1;
    assert piv_chip_on(p1, 0, 0) == false;
    assert piv_list_issue(p1, 0) == 2;
    assert piv_list_row_of(p1, 0) == 4;
    assert piv_inspect(p1).issue == 2;
    assert piv_inspect(p1).picked;
    assert piv_badge(p1) == VIZ_TRUTH_DEMO;
    assert piv_row_taken(p1, 0);
    assert piv_row_taken(p0, 0);
    assert p1.viz.selected == p0.viz.selected;
}

; ---------------------------------------------------------------- tests: state, keyboard, motion

test every_input_goes_through_the_one_reducer {
    let p : PivState = piv_open();
    var ev : u8 = 0;
    while (ev < VIZ_EV_COUNT) {
        let a : u32 = piv_issue_ref(1);
        let n : PivState = piv_apply(p, ev, a, 0);
        let m : VizState = viz_apply(p.viz, ev, a, 0);
        assert viz_same(n.viz, m);
        assert n.viz.revision == m.revision;
        assert n.labels == p.labels;
        ev = ev + 1;
    }
    let ignored : VizState = viz_apply(p.viz, PIV_EV_TOGGLE_LABEL, 0, 0);
    assert viz_same(ignored, p.viz);
    assert ignored.revision == p.viz.revision;
    assert PIV_EV_TOGGLE_LABEL >= VIZ_EV_COUNT;
    assert piv_apply(p, VIZ_EV_STEP_NEXT, 0, 0).viz.step == 0;
    assert piv_apply(p, VIZ_EV_STEP_NEXT, 0, 0).viz.revision == p.viz.revision;
    assert piv_apply(p, VIZ_EV_STEP_SET, 5, 0).viz.step == 0;
    assert piv_apply(p, VIZ_EV_PARAM_SET, 3, 0).viz.param == 0;
    assert piv_apply(p, VIZ_EV_PARAM_SET, 3, 0).viz.revision == p.viz.revision;
}

test keyboard_focus_walks_every_entity_forward_and_back_and_wraps {
    let p0 : PivState = piv_open();
    var p : PivState = p0;
    var f : u32 = 0;
    var issues : u32 = 0;
    var chips : u32 = 0;
    while (f < PIV_ITEMS) {
        p = piv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == f;
        assert viz_is_focused(p.viz, f);
        let r : u32 = piv_focus_ref(p, p.viz.focus);
        assert r != VIZ_REF_NONE;
        if (viz_ref_kind(r) == VIZ_ENT_NODE) {
            assert viz_ref_index(r) == f;
            issues = issues + 1;
        }
        if (viz_ref_kind(r) == VIZ_ENT_CELL) {
            assert viz_ref_index(r) == f - PIV_ISSUES;
            chips = chips + 1;
        }
        f = f + 1;
    }
    assert issues == PIV_ISSUES;
    assert chips == PIV_CHIPS;
    p = piv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    var q : PivState = piv_apply(p0, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == PIV_ITEMS - 1;
    f = PIV_ITEMS - 1;
    while (f > 0) {
        q = piv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
        f = f - 1;
        assert q.viz.focus == f;
    }
    q = piv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == PIV_ITEMS - 1;
}

test enter_selects_a_focused_issue_flips_a_focused_chip_and_back_clears_the_selection {
    let p0 : PivState = piv_open();
    assert piv_activate(p0).viz.selected == VIZ_REF_NONE;
    assert piv_activate(p0).viz.revision == p0.viz.revision;
    var p : PivState = piv_apply(p0, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = piv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = piv_activate(p);
    assert p.viz.selected == piv_issue_ref(1);
    assert viz_back_closes(p.viz) == false;
    assert piv_inspect(p).issue == 1;
    p = piv_apply(p, VIZ_EV_BACK, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    assert viz_back_closes(p.viz);
    p = piv_activate(p);
    p = piv_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    var c : PivState = p0;
    var n : u32 = 0;
    while (n < 8) {
        c = piv_apply(c, VIZ_EV_FOCUS_NEXT, 0, 0);
        n = n + 1;
    }
    assert c.viz.focus == 7;
    assert piv_focus_ref(c, 7) == piv_chip_ref(0, 0);
    c = piv_activate(c);
    assert c.labels == PIV_START - 1;
    assert piv_pick(c) == 2;
    assert c.viz.truth == VIZ_TRUTH_DEMO;
    assert c.viz.focus == 7;
}

test reduced_motion_turns_the_resort_animation_off_and_changes_nothing_else {
    let p : PivState = piv_open();
    assert piv_resort_ms(p) == PIV_RESORT_MS;
    let calm : PivState = piv_apply(p, VIZ_EV_MOTION, 1, 0);
    assert calm.viz.reduced_motion == 1;
    assert piv_resort_ms(calm) == 0;
    assert piv_pick(calm) == piv_pick(p);
    assert piv_order_is(calm.labels, 0, 2, 3, 4, 6, 5, 1);
    let flipped : PivState = piv_flip(calm, 0, 0);
    assert piv_resort_ms(flipped) == 0;
    assert piv_pick(flipped) == 2;
    let again : PivState = piv_apply(calm, VIZ_EV_MOTION, 0, 0);
    assert again.viz.reduced_motion == 0;
    assert piv_resort_ms(again) == PIV_RESORT_MS;
    assert piv_apply(piv_idle(), VIZ_EV_MOTION, 1, 0).viz.reduced_motion == 1;
}

; ---------------------------------------------------------------- tests: plan and host

test the_plan_row_for_this_petal_agrees {
    assert PIV_PETAL == 8;
    assert piv_reps() == pvp_reps(PIV_PETAL);
    assert pvp_reps(PIV_PETAL) == 292;
    assert viz_plan_ok(pvp_reps(PIV_PETAL));
    assert viz_plan_ok(piv_reps());
    assert viz_is_linked(piv_reps());
    assert viz_view_count(piv_reps()) == 2;
    assert (piv_reps() & viz_rep_bit(VIZ_REP_GRAPH)) == 0;
    assert pvp_truth(PIV_PETAL) == VIZ_TRUTH_VERIFIED;
    assert piv_badge(piv_open()) == pvp_truth(PIV_PETAL);
    assert pvp_question(PIV_PETAL).len > 0;
    let src : str = pvp_source(PIV_PETAL);
    assert src.len == PIV_SOURCE.len;
    var k : usize = 0;
    while (k < src.len) {
        assert src[k] == PIV_SOURCE[k];
        k = k + 1;
    }
}

test the_host_nests_the_three_views_and_its_hit_test_agrees_with_the_list {
    let h : VizHost = piv_host();
    assert h.count == 3;
    assert vh_validate(h) == VH_OK;
    assert piv_host_reps(h) == piv_reps();
    assert piv_host_reps(h) == pvp_reps(PIV_PETAL);
    assert piv_host_reps(vh_blank()) == 0;
    assert h.rep[PIV_SLOT_BADGE as usize] == VIZ_REP_BADGE;
    assert h.rep[PIV_SLOT_LIST as usize] == VIZ_REP_LIST;
    assert h.rep[PIV_SLOT_INSPECTOR as usize] == VIZ_REP_INSPECTOR;
    assert h.w[PIV_SLOT_LIST as usize] == PIV_LIST_W;
    assert h.h[PIV_SLOT_LIST as usize] == PIV_LIST_H;
    let p : PivState = piv_open();
    assert vh_hit(h, 50, 100) == PIV_SLOT_LIST;
    assert piv_host_hit(p, h, PIV_SLOT_LIST, 50, 100) == piv_issue_ref(2);
    assert piv_host_hit(p, h, PIV_SLOT_LIST, 330, 106) == piv_chip_ref(2, 0);
    assert vh_hit(h, 30, 20) == PIV_SLOT_BADGE;
    assert piv_host_hit(p, h, PIV_SLOT_LIST, 30, 20) == VIZ_REF_NONE;
    assert vh_hit(h, 700, 100) == PIV_SLOT_INSPECTOR;
    assert piv_host_hit(p, h, PIV_SLOT_LIST, 700, 100) == VIZ_REF_NONE;
    assert vh_hit(h, 5, 5) == VH_NONE;
}

test the_petal_embeds_in_another_host_with_its_hit_test_intact {
    var outer : VizHost = vh_blank();
    outer = vh_add(outer, VIZ_REP_LIST, VH_ROOT, 0, 0, 1000, 800);
    outer = vh_add(outer, VIZ_REP_LIST, 0, 50, 50, 940, 500);
    let e : VizHost = vh_embed(outer, piv_host(), 1, 10, 20);
    assert e.count == 5;
    assert vh_validate(e) == VH_OK;
    assert e.parent[2] == 1;
    assert e.parent[3] == 1;
    assert e.parent[4] == 1;
    assert vh_depth(e, 3) == 3;
    assert vh_abs_x(e, 3) == 80;
    assert vh_abs_y(e, 3) == 130;
    assert e.rep[3] == VIZ_REP_LIST;
    let p : PivState = piv_open();
    assert vh_hit(e, 85, 135) == 3;
    assert piv_host_hit(p, e, 3, 85, 135) == piv_issue_ref(0);
    assert piv_host_hit(p, e, 3, 85, 175) == piv_issue_ref(2);
    assert piv_host_hit(p, e, 1, 85, 135) == VIZ_REF_NONE;
    assert piv_host_reps(e) == viz_rep_bit(VIZ_REP_LIST) | piv_reps();
}

; ---------------------------------------------------------------- invariant (constants only, no loops)

invariant the_fixture_fits_the_flat_masks_and_the_events_do_not_collide {
    assert PIV_ISSUES == 7;
    assert PIV_ISSUES * PIV_POOL == PIV_CHIPS;
    assert PIV_CHIPS <= 32;
    assert PIV_ISSUES + PIV_CHIPS == PIV_ITEMS;
    assert PIV_START < 268435456;
    assert PIV_EV_TOGGLE_LABEL >= VIZ_EV_COUNT;
    assert CRITICAL_CAP > 0;
    assert LEVEL_CRITICAL < LEVEL_LOW;
}
