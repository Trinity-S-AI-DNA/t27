// SPDX-License-Identifier: Apache-2.0
; specs/t27f/viz_contract.t27 -- the visualization contract every T27 OS petal speaks.
; Epic: interactive visualizations across all 27 T27 OS petals (Distill-style: explore, change an
; input, watch intermediate steps, linked views that stay in step). This spec is the reusable
; contract; specs/t27f/petal_specs_viz.t27 is the reference petal built on it and
; specs/t27f/petal_viz_plan.t27 is the plan for all 27 petals.
; --
; Why a contract. A petal that keeps its own hover, its own selection and its own step counter in
; each of its views has three copies of one fact, and the recorded defect in this codebase family
; is the hand-copied rule that only two of its three homes knew about. Here every view of a petal
; reads ONE VizState and every input writes it through ONE reducer, viz_apply. Linked views are
; then in step by construction: there is nothing for them to disagree about.
; --
; Layers:
;   L1 lifecycle    IDLE -> LOADING -> READY | EMPTY | ERROR, and RETRY back to LOADING. A view
;                   that is not READY ignores interaction: a click on a half-loaded graph does
;                   nothing rather than something wrong.
;   L2 truth        LIVE, VERIFIED, CACHED, DEMO, UNKNOWN. Every petal shows its truth badge, and
;                   only LIVE and VERIFIED may be presented as a result (viz_may_claim). A demo
;                   fixture is drawn as a demo. This is the view-level twin of spec_graph's
;                   per-node inference labels (EXACT/DERIVED/SUGGESTED/UNKNOWN); it does not
;                   replace them.
;   L3 refs         an entity is (kind, index) packed in one u32; VIZ_REF_NONE is "nothing".
;   L4 state        VizState and the pure reducer viz_apply(s, event, a, b). Every change bumps
;                   revision, so a host folds revision into its frame key and redraws exactly
;                   when something changed (glass_window's fk rule).
;   L5 access       keyboard focus walks the focusable items in a fixed order and wraps; ACTIVATE
;                   on the focused item is the same as clicking it; BACK clears the selection
;                   before it closes the petal; reduced motion makes every animation 0 ms.
;   L6 reps         the representation kinds a petal composes (graph, matrix, list, ...). These
;                   are view kinds inside one petal, not ui_plan card widgets; folding them into
;                   the ui_plan catalog is a later catalog version, not a second catalog.
;   L7 host         VizHost: up to 16 nested slots, each a rep in a rect relative to its parent.
;                   Slots are listed depth-first, so index order is focus order; a whole host can
;                   be embedded into a slot of another host (vh_embed), which is how widgets nest
;                   and are reused without copying their logic.
; --
; The reducer and the host are integer-only (no floats, `/` and `%` only), like petal_menu.t27,
; so they can lower to the FPGA framebuffer later; the str name tables stay on the host side.
; --
; Not claimed: no host draws a VizState yet. The glass window (specs/t27os/glass_window.t27) is
; the first host; wiring it is a tracked follow-up of the epic.

module t27f_viz_contract;

; ---------------------------------------------------------------- L1 lifecycle

pub const VIZ_LC_IDLE : u8 = 0;
pub const VIZ_LC_LOADING : u8 = 1;
pub const VIZ_LC_READY : u8 = 2;
pub const VIZ_LC_EMPTY : u8 = 3;
pub const VIZ_LC_ERROR : u8 = 4;
pub const VIZ_LC_COUNT : u8 = 5;
pub const VIZ_LC_NAMES : [5]str = ["idle", "loading", "ready", "empty", "error"];

/// An error code of 0 means "no error"; a FAILED event with code 0 is stored as this.
pub const VIZ_ERR_UNSPECIFIED : u8 = 1;

; ---------------------------------------------------------------- L2 truth

pub const VIZ_TRUTH_LIVE : u8 = 0;
pub const VIZ_TRUTH_VERIFIED : u8 = 1;
pub const VIZ_TRUTH_CACHED : u8 = 2;
pub const VIZ_TRUTH_DEMO : u8 = 3;
pub const VIZ_TRUTH_UNKNOWN : u8 = 4;
pub const VIZ_TRUTH_COUNT : u8 = 5;
pub const VIZ_TRUTH_NAMES : [5]str = ["LIVE", "VERIFIED", "CACHED", "DEMO", "UNKNOWN"];
/// Badge colours, 0xRRGGBB, all distinct so the badge is readable without its text.
pub const VIZ_TRUTH_RGB : [5]u32 = [0x00FF88, 0xFFD700, 0x58A6FF, 0x8B9490, 0xFF6B6B];

/// A truth code outside the table is UNKNOWN, never silently LIVE.
pub fn viz_truth(t: u8) -> u8 {
    if (t < VIZ_TRUTH_COUNT) {
        return t;
    }
    return VIZ_TRUTH_UNKNOWN;
}

/// Only a live or verified view may present its numbers as a result.
pub fn viz_may_claim(t: u8) -> bool {
    return t == VIZ_TRUTH_LIVE or t == VIZ_TRUTH_VERIFIED;
}

pub fn viz_truth_rgb(t: u8) -> u32 {
    return VIZ_TRUTH_RGB[viz_truth(t) as usize];
}

pub fn viz_truth_name(t: u8) -> str {
    return VIZ_TRUTH_NAMES[viz_truth(t) as usize];
}

; ---------------------------------------------------------------- L2b palette

/// The one palette of every viz page (owner, 2026-10-25: "we have a black background everywhere", and the
/// same day, on all cards: no blue-black, it must be #000000). 0xRRGGBB. A host reads these and keeps no
/// second copy: the page is BG, a panel or a node plate is PANEL, text and lines are INK, secondary text
/// and quiet borders are MUTED, the selection and links are ACCENT, and a card is told from the page by its
/// BORDER, not by a fill. The truth badges keep VIZ_TRUTH_RGB above.
/// BG and PANEL are the same black on purpose: a card is not lighter than the page (the GitHub dark
/// blue-black 0x161B22 is gone). BORDER is a neutral grey, R = G = B, so it carries no blue tint.
pub const VIZ_BG_RGB : u32 = 0x000000;
pub const VIZ_PANEL_RGB : u32 = 0x000000;
pub const VIZ_BORDER_RGB : u32 = 0x333333;
pub const VIZ_INK_RGB : u32 = 0xE6EDF3;
pub const VIZ_MUTED_RGB : u32 = 0x8B949E;
pub const VIZ_ACCENT_RGB : u32 = 0x58A6FF;

/// Stated margins, in luma units (0..255, see viz_luma): the ink must lead the background by at least
/// VIZ_MARGIN_INK, and the muted ink, the accent and every truth colour by at least VIZ_MARGIN_QUIET.
/// The border is a quiet hairline: its luma is at least VIZ_BORDER_MIN_LUMA (it shows on black) and at most
/// VIZ_BORDER_MAX_LUMA (it stays below the muted ink).
pub const VIZ_MARGIN_INK : u32 = 160;
pub const VIZ_MARGIN_QUIET : u32 = 100;
pub const VIZ_BORDER_MIN_LUMA : u32 = 30;
pub const VIZ_BORDER_MAX_LUMA : u32 = 80;

pub fn viz_rgb_r(rgb: u32) -> u32 {
    return rgb / 65536 % 256;
}

pub fn viz_rgb_g(rgb: u32) -> u32 {
    return rgb / 256 % 256;
}

pub fn viz_rgb_b(rgb: u32) -> u32 {
    return rgb % 256;
}

/// Luma of an 0xRRGGBB colour, 0..255, from the encoded channels with the Rec. 709 weights
/// (0.2126, 0.7152, 0.0722). Integer only; it is a brightness measure for margins, not a WCAG ratio.
pub fn viz_luma(rgb: u32) -> u32 {
    return (2126 * viz_rgb_r(rgb) + 7152 * viz_rgb_g(rgb) + 722 * viz_rgb_b(rgb)) / 10000;
}

/// fg leads bg by at least `margin` luma units (fg lighter than bg).
pub fn viz_readable_on(fg: u32, bg: u32, margin: u32) -> bool {
    return viz_luma(fg) >= viz_luma(bg) + margin;
}

/// The six roles by number, for a host that picks a colour by role. Any other number is the ink.
/// BG and PANEL name the same black; they stay two roles so a card can still be asked for by its name.
pub const VIZ_ROLE_BG : u32 = 0;
pub const VIZ_ROLE_PANEL : u32 = 1;
pub const VIZ_ROLE_INK : u32 = 2;
pub const VIZ_ROLE_MUTED : u32 = 3;
pub const VIZ_ROLE_ACCENT : u32 = 4;
pub const VIZ_ROLE_BORDER : u32 = 5;
pub const VIZ_ROLE_COUNT : u32 = 6;

pub fn viz_role_rgb(role: u32) -> u32 {
    if (role == VIZ_ROLE_BG) { return VIZ_BG_RGB; }
    if (role == VIZ_ROLE_PANEL) { return VIZ_PANEL_RGB; }
    if (role == VIZ_ROLE_MUTED) { return VIZ_MUTED_RGB; }
    if (role == VIZ_ROLE_ACCENT) { return VIZ_ACCENT_RGB; }
    if (role == VIZ_ROLE_BORDER) { return VIZ_BORDER_RGB; }
    return VIZ_INK_RGB;
}

; ---------------------------------------------------------------- L3 refs

pub const VIZ_ENT_NONE : u32 = 0;
pub const VIZ_ENT_NODE : u32 = 1;
pub const VIZ_ENT_EDGE : u32 = 2;
pub const VIZ_ENT_CELL : u32 = 3;
pub const VIZ_ENT_COUNT : u32 = 4;
pub const VIZ_REF_SPAN : u32 = 65536;
pub const VIZ_REF_NONE : u32 = 0;
pub const VIZ_NO_INDEX : u32 = 65535;

/// One entity, packed: kind * 65536 + index. Kind NONE packs to VIZ_REF_NONE whatever the index.
pub fn viz_ref(kind: u32, index: u32) -> u32 {
    if (kind == VIZ_ENT_NONE or kind >= VIZ_ENT_COUNT or index >= VIZ_REF_SPAN) {
        return VIZ_REF_NONE;
    }
    return kind * VIZ_REF_SPAN + index;
}

pub fn viz_ref_kind(r: u32) -> u32 {
    return r / VIZ_REF_SPAN;
}

pub fn viz_ref_index(r: u32) -> u32 {
    if (r == VIZ_REF_NONE) {
        return VIZ_NO_INDEX;
    }
    return r % VIZ_REF_SPAN;
}

; ---------------------------------------------------------------- L4 state

pub struct VizState {
    lifecycle: u8,
    error: u8,
    truth: u8,
    item_count: u32,
    hover: u32,
    selected: u32,
    step: u32,
    step_count: u32,
    param: u32,
    param_count: u32,
    focus: u32,
    focus_count: u32,
    reduced_motion: u8,
    revision: u32,
}

/// Events. `a` and `b` are the event's arguments; unused ones are 0.
pub const VIZ_EV_LOAD : u8 = 0;          // start (or restart) loading
pub const VIZ_EV_LOADED : u8 = 1;        // a = item count, b = truth code
pub const VIZ_EV_FAILED : u8 = 2;        // a = error code
pub const VIZ_EV_RETRY : u8 = 3;         // ERROR -> LOADING
pub const VIZ_EV_HOVER : u8 = 4;         // a = ref under the pointer
pub const VIZ_EV_LEAVE : u8 = 5;         // pointer left every entity
pub const VIZ_EV_SELECT : u8 = 6;        // a = ref; selecting the selected ref clears it
pub const VIZ_EV_CLEAR : u8 = 7;         // clear the selection
pub const VIZ_EV_STEP_SET : u8 = 8;      // a = step, clamped
pub const VIZ_EV_STEP_NEXT : u8 = 9;
pub const VIZ_EV_STEP_PREV : u8 = 10;
pub const VIZ_EV_PARAM_SET : u8 = 11;    // a = choice, clamped
pub const VIZ_EV_FOCUS_NEXT : u8 = 12;
pub const VIZ_EV_FOCUS_PREV : u8 = 13;
pub const VIZ_EV_ACTIVATE : u8 = 14;     // a = ref of the focused item (the petal maps focus to a ref)
pub const VIZ_EV_BACK : u8 = 15;         // clear the selection; see viz_back_closes
pub const VIZ_EV_MOTION : u8 = 16;       // a = 1 reduce motion, 0 allow it
pub const VIZ_EV_COUNT : u8 = 17;

pub const VIZ_NO_FOCUS : u32 = 65535;

/// A fresh petal: idle, nothing hovered, selected or focused, truth UNKNOWN until it loads.
pub fn viz_init(step_count: u32, param_count: u32) -> VizState {
    return VizState { lifecycle: VIZ_LC_IDLE, error: 0, truth: VIZ_TRUTH_UNKNOWN, item_count: 0, hover: VIZ_REF_NONE, selected: VIZ_REF_NONE, step: 0, step_count: step_count, param: 0, param_count: param_count, focus: VIZ_NO_FOCUS, focus_count: 0, reduced_motion: 0, revision: 0 };
}

/// v limited to 0..n-1; with n == 0 the only value is 0.
pub fn viz_clamp(v: u32, n: u32) -> u32 {
    if (n == 0) {
        return 0;
    }
    if (v >= n) {
        return n - 1;
    }
    return v;
}

/// True for the events that only make sense on a READY view.
pub fn viz_is_interaction(ev: u8) -> bool {
    return ev >= VIZ_EV_HOVER and ev <= VIZ_EV_BACK;
}

/// The same fields, ignoring revision: the reducer bumps revision only when this is false.
pub fn viz_same(x: VizState, y: VizState) -> bool {
    return x.lifecycle == y.lifecycle and x.error == y.error and x.truth == y.truth and x.item_count == y.item_count and x.hover == y.hover and x.selected == y.selected and x.step == y.step and x.step_count == y.step_count and x.param == y.param and x.param_count == y.param_count and x.focus == y.focus and x.focus_count == y.focus_count and x.reduced_motion == y.reduced_motion;
}

/// The one reducer. Every input of every view of a petal goes through here.
pub fn viz_apply(s: VizState, ev: u8, a: u32, b: u32) -> VizState {
    var n : VizState = s;
    if (viz_is_interaction(ev) and s.lifecycle != VIZ_LC_READY) {
        return s;
    }
    if (ev == VIZ_EV_LOAD) {
        n.lifecycle = VIZ_LC_LOADING;
        n.error = 0;
    }
    if (ev == VIZ_EV_LOADED and s.lifecycle == VIZ_LC_LOADING) {
        n.item_count = a;
        n.truth = viz_truth(b as u8);
        n.hover = VIZ_REF_NONE;
        n.selected = VIZ_REF_NONE;
        n.focus = VIZ_NO_FOCUS;
        n.focus_count = a;
        n.step = viz_clamp(s.step, s.step_count);
        if (a == 0) {
            n.lifecycle = VIZ_LC_EMPTY;
        } else {
            n.lifecycle = VIZ_LC_READY;
        }
    }
    if (ev == VIZ_EV_FAILED and (s.lifecycle == VIZ_LC_LOADING or s.lifecycle == VIZ_LC_READY)) {
        n.lifecycle = VIZ_LC_ERROR;
        if (a == 0 or a > 255) {
            n.error = VIZ_ERR_UNSPECIFIED;
        } else {
            n.error = a as u8;
        }
        n.hover = VIZ_REF_NONE;
    }
    if (ev == VIZ_EV_RETRY and s.lifecycle == VIZ_LC_ERROR) {
        n.lifecycle = VIZ_LC_LOADING;
        n.error = 0;
    }
    if (ev == VIZ_EV_HOVER) {
        n.hover = a;
    }
    if (ev == VIZ_EV_LEAVE) {
        n.hover = VIZ_REF_NONE;
    }
    if (ev == VIZ_EV_SELECT or ev == VIZ_EV_ACTIVATE) {
        if (a == s.selected) {
            n.selected = VIZ_REF_NONE;
        } else {
            n.selected = a;
        }
    }
    if (ev == VIZ_EV_CLEAR or ev == VIZ_EV_BACK) {
        n.selected = VIZ_REF_NONE;
    }
    if (ev == VIZ_EV_STEP_SET) {
        n.step = viz_clamp(a, s.step_count);
    }
    if (ev == VIZ_EV_STEP_NEXT) {
        n.step = viz_clamp(s.step + 1, s.step_count);
    }
    if (ev == VIZ_EV_STEP_PREV and s.step > 0) {
        n.step = s.step - 1;
    }
    if (ev == VIZ_EV_PARAM_SET) {
        n.param = viz_clamp(a, s.param_count);
    }
    if (ev == VIZ_EV_FOCUS_NEXT and s.focus_count > 0) {
        if (s.focus == VIZ_NO_FOCUS or s.focus + 1 >= s.focus_count) {
            n.focus = 0;
        } else {
            n.focus = s.focus + 1;
        }
    }
    if (ev == VIZ_EV_FOCUS_PREV and s.focus_count > 0) {
        if (s.focus == VIZ_NO_FOCUS or s.focus == 0 or s.focus >= s.focus_count) {
            n.focus = s.focus_count - 1;
        } else {
            n.focus = s.focus - 1;
        }
    }
    if (ev == VIZ_EV_MOTION) {
        if (a == 0) {
            n.reduced_motion = 0;
        } else {
            n.reduced_motion = 1;
        }
    }
    if (viz_same(n, s) == false) {
        n.revision = s.revision + 1;
    }
    return n;
}

/// A host calls this BEFORE applying BACK: true means there is nothing left to clear, so BACK
/// closes the petal (petal_menu on_back) instead of clearing a selection.
pub fn viz_back_closes(s: VizState) -> bool {
    return s.selected == VIZ_REF_NONE;
}

/// An animation's duration under the user's motion preference.
pub fn viz_motion_ms(s: VizState, ms: u32) -> u32 {
    if (s.reduced_motion != 0) {
        return 0;
    }
    return ms;
}

; ---------------------------------------------------------------- highlight (what every view reads)

pub const VIZ_HL_NONE : u8 = 0;
pub const VIZ_HL_HOVER : u8 = 1;
pub const VIZ_HL_SELECT : u8 = 2;

/// How one entity is drawn in ANY view: selection wins over hover. Every view of a petal calls
/// this with the same VizState, so a node hovered in the graph lights its row in the matrix and
/// its line in the list in the same frame.
pub fn viz_highlight(s: VizState, r: u32) -> u8 {
    if (r == VIZ_REF_NONE) {
        return VIZ_HL_NONE;
    }
    if (r == s.selected) {
        return VIZ_HL_SELECT;
    }
    if (r == s.hover) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

pub fn viz_is_focused(s: VizState, i: u32) -> bool {
    return s.focus != VIZ_NO_FOCUS and s.focus == i;
}

; ---------------------------------------------------------------- L6 representation kinds

pub const VIZ_REP_GRAPH : u8 = 0;      // node-link diagram
pub const VIZ_REP_MATRIX : u8 = 1;     // adjacency or any 2-D table of cells
pub const VIZ_REP_LIST : u8 = 2;       // one line per entity
pub const VIZ_REP_SOURCE : u8 = 3;     // the spec text, with the selected entity's lines marked
pub const VIZ_REP_TRACE : u8 = 4;      // per-step values (intermediate state)
pub const VIZ_REP_INSPECTOR : u8 = 5;  // everything about the selected entity
pub const VIZ_REP_STEPPER : u8 = 6;    // control: the step
pub const VIZ_REP_CHOICE : u8 = 7;     // control: the param
pub const VIZ_REP_BADGE : u8 = 8;      // status: truth and lifecycle
pub const VIZ_REP_TIMELINE : u8 = 9;
pub const VIZ_REP_CHART : u8 = 10;
pub const VIZ_REP_MAP : u8 = 11;
pub const VIZ_REP_TEXT : u8 = 12;
pub const VIZ_REP_COUNT : u8 = 13;
pub const VIZ_REP_NAMES : [13]str = ["graph", "matrix", "list", "source", "trace", "inspector", "stepper", "choice", "badge", "timeline", "chart", "map", "text"];

pub fn viz_rep_bit(k: u8) -> u32 {
    if (k >= VIZ_REP_COUNT) {
        return 0;
    }
    var b : u32 = 1;
    var i : u8 = 0;
    while (i < k) {
        b = b * 2;
        i = i + 1;
    }
    return b;
}

/// Controls write the state; the badge reports it; everything else is a view of entities.
pub fn viz_rep_is_control(k: u8) -> bool {
    return k == VIZ_REP_STEPPER or k == VIZ_REP_CHOICE;
}

pub fn viz_rep_is_view(k: u8) -> bool {
    return k < VIZ_REP_COUNT and viz_rep_is_control(k) == false and k != VIZ_REP_BADGE;
}

/// How many entity views a set of reps (a bit set) holds.
pub fn viz_view_count(reps: u32) -> u32 {
    var n : u32 = 0;
    var k : u8 = 0;
    while (k < VIZ_REP_COUNT) {
        if (viz_rep_is_view(k) and (reps & viz_rep_bit(k)) != 0) {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

/// A petal plan is acceptable when it shows its truth badge and at least one view.
pub fn viz_plan_ok(reps: u32) -> bool {
    return (reps & viz_rep_bit(VIZ_REP_BADGE)) != 0 and viz_view_count(reps) >= 1;
}

/// Linked representations: two or more views of the same entities.
pub fn viz_is_linked(reps: u32) -> bool {
    return viz_view_count(reps) >= 2;
}

; ---------------------------------------------------------------- L7 host: nesting and embedding

pub const VH_MAX_SLOTS : u32 = 16;
; Four levels: a petal frame, its view, and a second petal's frame and view embedded in that view.
pub const VH_MAX_DEPTH : u32 = 4;
pub const VH_ROOT : u32 = 255;
pub const VH_NONE : u32 = 65535;

pub const VH_OK : u8 = 0;
pub const VH_ERR_CAPACITY : u8 = 1;
pub const VH_ERR_PARENT_ORDER : u8 = 2;
pub const VH_ERR_OUTSIDE_PARENT : u8 = 3;
pub const VH_ERR_DEPTH : u8 = 4;
pub const VH_ERR_REP : u8 = 5;
pub const VH_ERR_EMPTY_RECT : u8 = 6;
pub const VH_ERR_NOT_DEPTH_FIRST : u8 = 7;

/// Slots in depth-first order. A slot's rect is relative to its parent's top-left corner; a root
/// slot (parent VH_ROOT) is relative to the host's origin.
pub struct VizHost {
    count: u32,
    rep: [16]u8,
    parent: [16]u32,
    x: [16]u32,
    y: [16]u32,
    w: [16]u32,
    h: [16]u32,
}

pub fn vh_blank() -> VizHost {
    return VizHost { count: 0, rep: [0; 16], parent: [0; 16], x: [0; 16], y: [0; 16], w: [0; 16], h: [0; 16] };
}

/// h with one more slot. Past capacity the slot is dropped but count still grows, so
/// vh_validate reports the overflow instead of the host silently losing a widget.
pub fn vh_add(h: VizHost, rep: u8, parent: u32, x: u32, y: u32, w: u32, ht: u32) -> VizHost {
    var n : VizHost = h;
    if (n.count < VH_MAX_SLOTS) {
        let k : usize = n.count as usize;
        n.rep[k] = rep;
        n.parent[k] = parent;
        n.x[k] = x;
        n.y[k] = y;
        n.w[k] = w;
        n.h[k] = ht;
    }
    n.count = n.count + 1;
    return n;
}

/// Depth of slot i: a root slot is depth 1. A broken parent chain stops at VH_MAX_SLOTS steps.
pub fn vh_depth(h: VizHost, i: u32) -> u32 {
    var d : u32 = 0;
    var c : u32 = i;
    while (c < VH_MAX_SLOTS and c < h.count and d <= VH_MAX_SLOTS) {
        d = d + 1;
        c = h.parent[c as usize];
    }
    return d;
}

pub fn vh_abs_x(h: VizHost, i: u32) -> u32 {
    var s : u32 = 0;
    var c : u32 = i;
    var guard : u32 = 0;
    while (c < VH_MAX_SLOTS and c < h.count and guard <= VH_MAX_SLOTS) {
        s = s + h.x[c as usize];
        c = h.parent[c as usize];
        guard = guard + 1;
    }
    return s;
}

pub fn vh_abs_y(h: VizHost, i: u32) -> u32 {
    var s : u32 = 0;
    var c : u32 = i;
    var guard : u32 = 0;
    while (c < VH_MAX_SLOTS and c < h.count and guard <= VH_MAX_SLOTS) {
        s = s + h.y[c as usize];
        c = h.parent[c as usize];
        guard = guard + 1;
    }
    return s;
}

/// True when slot i's parent is slot p or one of p's ancestors (or the root): the rule that
/// keeps the list depth-first, so index order is focus order.
pub fn vh_on_chain(h: VizHost, p: u32, i: u32) -> bool {
    let want : u32 = h.parent[i as usize];
    if (want == VH_ROOT) {
        return true;
    }
    var c : u32 = p;
    var guard : u32 = 0;
    while (c < VH_MAX_SLOTS and guard <= VH_MAX_SLOTS) {
        if (c == want) {
            return true;
        }
        c = h.parent[c as usize];
        guard = guard + 1;
    }
    return false;
}

pub fn vh_validate(h: VizHost) -> u8 {
    if (h.count > VH_MAX_SLOTS) {
        return VH_ERR_CAPACITY;
    }
    var i : u32 = 0;
    while (i < h.count) {
        let k : usize = i as usize;
        if (h.rep[k] >= VIZ_REP_COUNT) {
            return VH_ERR_REP;
        }
        if (h.w[k] == 0 or h.h[k] == 0) {
            return VH_ERR_EMPTY_RECT;
        }
        let p : u32 = h.parent[k];
        if (p != VH_ROOT) {
            if (p >= i) {
                return VH_ERR_PARENT_ORDER;
            }
            let q : usize = p as usize;
            if (h.x[k] + h.w[k] > h.w[q] or h.y[k] + h.h[k] > h.h[q]) {
                return VH_ERR_OUTSIDE_PARENT;
            }
        }
        if (i > 0 and vh_on_chain(h, i - 1, i) == false) {
            return VH_ERR_NOT_DEPTH_FIRST;
        }
        if (vh_depth(h, i) > VH_MAX_DEPTH) {
            return VH_ERR_DEPTH;
        }
        i = i + 1;
    }
    return VH_OK;
}

/// The deepest slot under the point (host coordinates); on a tie the later slot, which is drawn
/// on top. VH_NONE when the point is in no slot.
pub fn vh_hit(h: VizHost, px: u32, py: u32) -> u32 {
    var best : u32 = VH_NONE;
    var best_d : u32 = 0;
    var i : u32 = 0;
    while (i < h.count and i < VH_MAX_SLOTS) {
        let x0 : u32 = vh_abs_x(h, i);
        let y0 : u32 = vh_abs_y(h, i);
        let k : usize = i as usize;
        if (px >= x0 and py >= y0 and px < x0 + h.w[k] and py < y0 + h.h[k]) {
            let d : u32 = vh_depth(h, i);
            if (d >= best_d) {
                best = i;
                best_d = d;
            }
        }
        i = i + 1;
    }
    return best;
}

/// Keyboard focus between slots: index order, wrapping. Valid because slots are depth-first.
pub fn vh_focus_next(h: VizHost, i: u32) -> u32 {
    if (h.count == 0) {
        return VH_NONE;
    }
    if (i == VH_NONE or i + 1 >= h.count) {
        return 0;
    }
    return i + 1;
}

/// Embed every slot of `c` under slot `at` of `h`, offset by (ox, oy): c's root slots become
/// children of `at`, the rest keep their shape with shifted parent indexes. This is the one way a
/// widget is reused inside another petal: its logic is not copied, its host is.
pub fn vh_embed(h: VizHost, c: VizHost, at: u32, ox: u32, oy: u32) -> VizHost {
    var n : VizHost = h;
    let base : u32 = h.count;
    var i : u32 = 0;
    while (i < c.count and i < VH_MAX_SLOTS) {
        let k : usize = i as usize;
        if (c.parent[k] == VH_ROOT) {
            n = vh_add(n, c.rep[k], at, c.x[k] + ox, c.y[k] + oy, c.w[k], c.h[k]);
        } else {
            n = vh_add(n, c.rep[k], c.parent[k] + base, c.x[k], c.y[k], c.w[k], c.h[k]);
        }
        i = i + 1;
    }
    return n;
}

; ---------------------------------------------------------------- tests

fn ready_state() -> VizState {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 5, VIZ_TRUTH_VERIFIED as u32);
    return s;
}

test a_fresh_petal_is_idle_unknown_and_unselected {
    const s : VizState = viz_init(4, 3);
    assert s.lifecycle == VIZ_LC_IDLE;
    assert s.truth == VIZ_TRUTH_UNKNOWN;
    assert s.selected == VIZ_REF_NONE;
    assert s.hover == VIZ_REF_NONE;
    assert s.focus == VIZ_NO_FOCUS;
    assert s.revision == 0;
}

test load_then_loaded_items_is_ready_with_its_truth {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    assert s.lifecycle == VIZ_LC_LOADING;
    s = viz_apply(s, VIZ_EV_LOADED, 5, VIZ_TRUTH_DEMO as u32);
    assert s.lifecycle == VIZ_LC_READY;
    assert s.truth == VIZ_TRUTH_DEMO;
    assert s.item_count == 5;
    assert s.focus_count == 5;
}

test loaded_with_no_items_is_empty_not_ready {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 0, VIZ_TRUTH_LIVE as u32);
    assert s.lifecycle == VIZ_LC_EMPTY;
}

test failed_is_error_and_retry_goes_back_to_loading {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_FAILED, 7, 0);
    assert s.lifecycle == VIZ_LC_ERROR;
    assert s.error == 7;
    s = viz_apply(s, VIZ_EV_RETRY, 0, 0);
    assert s.lifecycle == VIZ_LC_LOADING;
    assert s.error == 0;
}

test failed_with_code_zero_still_reports_an_error {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_FAILED, 0, 0);
    assert s.lifecycle == VIZ_LC_ERROR;
    assert s.error == VIZ_ERR_UNSPECIFIED;
}

test loaded_outside_loading_changes_nothing {
    const s : VizState = viz_init(4, 3);
    const t : VizState = viz_apply(s, VIZ_EV_LOADED, 5, 0);
    assert t.lifecycle == VIZ_LC_IDLE;
    assert t.revision == s.revision;
}

test retry_outside_error_changes_nothing {
    const s : VizState = ready_state();
    const t : VizState = viz_apply(s, VIZ_EV_RETRY, 0, 0);
    assert t.lifecycle == VIZ_LC_READY;
    assert t.revision == s.revision;
}

test interaction_is_ignored_unless_ready {
    var s : VizState = viz_init(4, 3);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    const r : u32 = viz_ref(VIZ_ENT_NODE, 2);
    const t : VizState = viz_apply(s, VIZ_EV_SELECT, r, 0);
    assert t.selected == VIZ_REF_NONE;
    assert t.revision == s.revision;
    const u : VizState = viz_apply(s, VIZ_EV_STEP_NEXT, 0, 0);
    assert u.step == 0;
}

test selecting_the_selected_entity_clears_it {
    var s : VizState = ready_state();
    const r : u32 = viz_ref(VIZ_ENT_NODE, 3);
    s = viz_apply(s, VIZ_EV_SELECT, r, 0);
    assert s.selected == r;
    s = viz_apply(s, VIZ_EV_SELECT, r, 0);
    assert s.selected == VIZ_REF_NONE;
}

test hover_and_leave_and_selection_wins_the_highlight {
    var s : VizState = ready_state();
    const a : u32 = viz_ref(VIZ_ENT_NODE, 1);
    const b : u32 = viz_ref(VIZ_ENT_EDGE, 1);
    s = viz_apply(s, VIZ_EV_HOVER, a, 0);
    assert viz_highlight(s, a) == VIZ_HL_HOVER;
    assert viz_highlight(s, b) == VIZ_HL_NONE;
    s = viz_apply(s, VIZ_EV_SELECT, a, 0);
    assert viz_highlight(s, a) == VIZ_HL_SELECT;
    s = viz_apply(s, VIZ_EV_LEAVE, 0, 0);
    assert s.hover == VIZ_REF_NONE;
    assert viz_highlight(s, a) == VIZ_HL_SELECT;
    assert viz_highlight(s, VIZ_REF_NONE) == VIZ_HL_NONE;
}

test node_one_and_edge_one_are_different_entities {
    const a : u32 = viz_ref(VIZ_ENT_NODE, 1);
    const b : u32 = viz_ref(VIZ_ENT_EDGE, 1);
    assert a != b;
    assert viz_ref_kind(a) == VIZ_ENT_NODE;
    assert viz_ref_kind(b) == VIZ_ENT_EDGE;
    assert viz_ref_index(a) == 1;
    assert viz_ref_index(b) == 1;
    assert viz_ref(VIZ_ENT_NONE, 9) == VIZ_REF_NONE;
    assert viz_ref(VIZ_ENT_COUNT, 9) == VIZ_REF_NONE;
    assert viz_ref_index(VIZ_REF_NONE) == VIZ_NO_INDEX;
}

test step_is_clamped_at_both_ends {
    var s : VizState = ready_state();
    s = viz_apply(s, VIZ_EV_STEP_PREV, 0, 0);
    assert s.step == 0;
    s = viz_apply(s, VIZ_EV_STEP_SET, 99, 0);
    assert s.step == 3;
    s = viz_apply(s, VIZ_EV_STEP_NEXT, 0, 0);
    assert s.step == 3;
    s = viz_apply(s, VIZ_EV_STEP_PREV, 0, 0);
    assert s.step == 2;
}

test a_petal_with_no_steps_stays_at_step_zero {
    var s : VizState = viz_init(0, 0);
    s = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    s = viz_apply(s, VIZ_EV_LOADED, 2, 0);
    s = viz_apply(s, VIZ_EV_STEP_NEXT, 0, 0);
    assert s.step == 0;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 5, 0);
    assert s.param == 0;
}

test param_is_clamped_to_its_choices {
    var s : VizState = ready_state();
    s = viz_apply(s, VIZ_EV_PARAM_SET, 2, 0);
    assert s.param == 2;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 9, 0);
    assert s.param == 2;
}

test focus_walks_forward_and_back_and_wraps {
    var s : VizState = ready_state();
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.focus == 0;
    assert viz_is_focused(s, 0);
    s = viz_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
    assert s.focus == 4;
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.focus == 0;
    var t : VizState = ready_state();
    t = viz_apply(t, VIZ_EV_FOCUS_PREV, 0, 0);
    assert t.focus == 4;
}

test activate_on_focus_is_the_same_as_a_click {
    const r : u32 = viz_ref(VIZ_ENT_NODE, 4);
    const a : VizState = viz_apply(ready_state(), VIZ_EV_ACTIVATE, r, 0);
    const b : VizState = viz_apply(ready_state(), VIZ_EV_SELECT, r, 0);
    assert a.selected == b.selected;
    assert viz_same(a, b);
}

test back_clears_the_selection_before_it_closes {
    var s : VizState = ready_state();
    s = viz_apply(s, VIZ_EV_SELECT, viz_ref(VIZ_ENT_NODE, 1), 0);
    assert viz_back_closes(s) == false;
    s = viz_apply(s, VIZ_EV_BACK, 0, 0);
    assert s.selected == VIZ_REF_NONE;
    assert viz_back_closes(s);
}

test reduced_motion_makes_every_animation_instant_in_any_lifecycle {
    var s : VizState = viz_init(4, 3);
    assert viz_motion_ms(s, 240) == 240;
    s = viz_apply(s, VIZ_EV_MOTION, 1, 0);
    assert s.reduced_motion == 1;
    assert viz_motion_ms(s, 240) == 0;
    s = viz_apply(s, VIZ_EV_MOTION, 0, 0);
    assert viz_motion_ms(s, 240) == 240;
}

test revision_moves_exactly_when_something_changed {
    var s : VizState = ready_state();
    const r0 : u32 = s.revision;
    const a : u32 = viz_ref(VIZ_ENT_NODE, 2);
    s = viz_apply(s, VIZ_EV_HOVER, a, 0);
    assert s.revision == r0 + 1;
    s = viz_apply(s, VIZ_EV_HOVER, a, 0);
    assert s.revision == r0 + 1;
    s = viz_apply(s, VIZ_EV_STEP_PREV, 0, 0);
    assert s.revision == r0 + 1;
}

test only_live_and_verified_may_claim_a_result {
    assert viz_may_claim(VIZ_TRUTH_LIVE);
    assert viz_may_claim(VIZ_TRUTH_VERIFIED);
    assert viz_may_claim(VIZ_TRUTH_CACHED) == false;
    assert viz_may_claim(VIZ_TRUTH_DEMO) == false;
    assert viz_may_claim(VIZ_TRUTH_UNKNOWN) == false;
    assert viz_truth(200) == VIZ_TRUTH_UNKNOWN;
    assert viz_may_claim(viz_truth(200)) == false;
}

test truth_badges_have_distinct_colours {
    var i : u32 = 0;
    while (i < 5) {
        var j : u32 = i + 1;
        while (j < 5) {
            assert VIZ_TRUTH_RGB[i as usize] != VIZ_TRUTH_RGB[j as usize];
            j = j + 1;
        }
        i = i + 1;
    }
    assert viz_truth_rgb(200) == VIZ_TRUTH_RGB[4];
}

test reps_split_into_views_controls_and_the_badge {
    assert viz_rep_is_view(VIZ_REP_GRAPH);
    assert viz_rep_is_view(VIZ_REP_MATRIX);
    assert viz_rep_is_control(VIZ_REP_STEPPER);
    assert viz_rep_is_view(VIZ_REP_STEPPER) == false;
    assert viz_rep_is_view(VIZ_REP_BADGE) == false;
    assert viz_rep_bit(VIZ_REP_GRAPH) == 1;
    assert viz_rep_bit(VIZ_REP_LIST) == 4;
    assert viz_rep_bit(VIZ_REP_COUNT) == 0;
    const linked : u32 = viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_MATRIX) | viz_rep_bit(VIZ_REP_BADGE);
    assert viz_plan_ok(linked);
    assert viz_is_linked(linked);
    const no_badge : u32 = viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_MATRIX);
    assert viz_plan_ok(no_badge) == false;
    const one_view : u32 = viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_STEPPER) | viz_rep_bit(VIZ_REP_BADGE);
    assert viz_plan_ok(one_view);
    assert viz_is_linked(one_view) == false;
}

fn nested_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 600, 400);
    h = vh_add(h, VIZ_REP_GRAPH, 0, 10, 10, 300, 300);
    h = vh_add(h, VIZ_REP_INSPECTOR, 1, 20, 20, 100, 50);
    h = vh_add(h, VIZ_REP_MATRIX, 0, 320, 10, 270, 300);
    return h;
}

test a_nested_host_validates_and_places_children_inside_parents {
    const h : VizHost = nested_host();
    assert vh_validate(h) == VH_OK;
    assert vh_depth(h, 0) == 1;
    assert vh_depth(h, 2) == 3;
    assert vh_abs_x(h, 2) == 30;
    assert vh_abs_y(h, 2) == 30;
    assert vh_abs_x(h, 3) == 320;
}

test the_hit_test_picks_the_deepest_slot {
    const h : VizHost = nested_host();
    assert vh_hit(h, 40, 40) == 2;
    assert vh_hit(h, 200, 200) == 1;
    assert vh_hit(h, 400, 100) == 3;
    assert vh_hit(h, 5, 390) == 0;
    assert vh_hit(h, 700, 700) == VH_NONE;
}

test a_child_outside_its_parent_is_refused {
    var h : VizHost = nested_host();
    h = vh_add(h, VIZ_REP_LIST, 3, 200, 10, 100, 50);
    assert vh_validate(h) == VH_ERR_OUTSIDE_PARENT;
}

test a_parent_listed_after_its_child_is_refused {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 600, 400);
    h = vh_add(h, VIZ_REP_GRAPH, 2, 0, 0, 10, 10);
    h = vh_add(h, VIZ_REP_TEXT, 0, 0, 0, 100, 100);
    assert vh_validate(h) == VH_ERR_PARENT_ORDER;
}

test slots_out_of_depth_first_order_are_refused {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 600, 400);
    h = vh_add(h, VIZ_REP_GRAPH, 0, 0, 0, 100, 100);
    h = vh_add(h, VIZ_REP_MATRIX, VH_ROOT, 0, 0, 100, 100);
    h = vh_add(h, VIZ_REP_LIST, 1, 0, 0, 10, 10);
    assert vh_validate(h) == VH_ERR_NOT_DEPTH_FIRST;
}

test nesting_deeper_than_the_limit_is_refused {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 600, 400);
    h = vh_add(h, VIZ_REP_TEXT, 0, 10, 10, 300, 300);
    h = vh_add(h, VIZ_REP_GRAPH, 1, 10, 10, 200, 200);
    h = vh_add(h, VIZ_REP_INSPECTOR, 2, 10, 10, 100, 100);
    assert vh_depth(h, 3) == VH_MAX_DEPTH;
    assert vh_validate(h) == VH_OK;
    h = vh_add(h, VIZ_REP_TEXT, 3, 0, 0, 10, 10);
    assert vh_depth(h, 4) == VH_MAX_DEPTH + 1;
    assert vh_validate(h) == VH_ERR_DEPTH;
}

test an_unknown_rep_and_an_empty_rect_are_refused {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_COUNT, VH_ROOT, 0, 0, 10, 10);
    assert vh_validate(h) == VH_ERR_REP;
    var g : VizHost = vh_blank();
    g = vh_add(g, VIZ_REP_TEXT, VH_ROOT, 0, 0, 0, 10);
    assert vh_validate(g) == VH_ERR_EMPTY_RECT;
}

test overflowing_the_slots_is_reported_not_dropped_silently {
    var h : VizHost = vh_blank();
    var i : u32 = 0;
    while (i < 17) {
        h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 10, 10);
        i = i + 1;
    }
    assert h.count == 17;
    assert vh_validate(h) == VH_ERR_CAPACITY;
}

test an_embedded_host_keeps_its_shape_under_the_new_parent {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, 800, 600);
    h = vh_add(h, VIZ_REP_TEXT, 0, 100, 100, 400, 300);
    var w : VizHost = vh_blank();
    w = vh_add(w, VIZ_REP_GRAPH, VH_ROOT, 0, 0, 200, 100);
    w = vh_add(w, VIZ_REP_INSPECTOR, 0, 10, 10, 50, 50);
    const e : VizHost = vh_embed(h, w, 1, 20, 30);
    assert e.count == 4;
    assert vh_validate(e) == VH_OK;
    assert e.parent[2] == 1;
    assert e.parent[3] == 2;
    assert vh_depth(e, 3) == 4;
    assert vh_abs_x(e, 2) == 120;
    assert vh_abs_y(e, 3) == 140;
    assert vh_hit(e, 135, 145) == 3;
}

test slot_focus_walks_in_index_order_and_wraps {
    const h : VizHost = nested_host();
    assert vh_focus_next(h, VH_NONE) == 0;
    assert vh_focus_next(h, 0) == 1;
    assert vh_focus_next(h, 3) == 0;
    assert vh_focus_next(vh_blank(), 0) == VH_NONE;
}

// ---- the palette: black page, light ink (owner, 2026-10-25)

test the_luma_of_each_palette_colour_is_the_hand_counted_one {
    // (2126 R + 7152 G + 722 B) / 10000 on the encoded channels, counted by hand.
    assert viz_luma(VIZ_BG_RGB) == 0;
    assert viz_luma(VIZ_PANEL_RGB) == 0;
    assert viz_luma(VIZ_BORDER_RGB) == 51;
    assert viz_luma(VIZ_INK_RGB) == 235;
    assert viz_luma(VIZ_MUTED_RGB) == 146;
    assert viz_luma(VIZ_ACCENT_RGB) == 155;
    assert viz_luma(0x000000) == 0;
    assert viz_luma(0xFFFFFF) == 255;
}

test the_background_is_darker_than_the_ink_by_the_stated_margin {
    assert viz_luma(VIZ_BG_RGB) + VIZ_MARGIN_INK <= viz_luma(VIZ_INK_RGB);
    assert viz_readable_on(VIZ_INK_RGB, VIZ_BG_RGB, VIZ_MARGIN_INK);
    assert viz_readable_on(VIZ_INK_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_INK);
    // The margin is real: the other way round fails, and so does a light page under the ink.
    assert viz_readable_on(VIZ_BG_RGB, VIZ_INK_RGB, VIZ_MARGIN_INK) == false;
    assert viz_readable_on(VIZ_INK_RGB, 0xFFFFFF, VIZ_MARGIN_INK) == false;
}

test the_page_and_every_panel_are_pure_black_with_no_blue_tint {
    // Owner, 2026-10-25: the background is black everywhere, on all cards; no blue-black. #000000.
    assert VIZ_BG_RGB == 0x000000;
    assert VIZ_PANEL_RGB == 0x000000;
    assert VIZ_PANEL_RGB == VIZ_BG_RGB;
    assert viz_role_rgb(VIZ_ROLE_PANEL) == 0x000000;
    assert viz_role_rgb(VIZ_ROLE_BG) == 0x000000;
    // Every channel of the card and the page is zero, so no blue (and no other) cast is left.
    assert viz_rgb_r(VIZ_PANEL_RGB) == 0;
    assert viz_rgb_g(VIZ_PANEL_RGB) == 0;
    assert viz_rgb_b(VIZ_PANEL_RGB) == 0;
    assert viz_luma(VIZ_PANEL_RGB) == viz_luma(VIZ_BG_RGB);
    // The old GitHub blue-black is not the panel any more, and it was blue-tinted (B above R).
    assert VIZ_PANEL_RGB != 0x161B22;
    assert viz_rgb_b(0x161B22) > viz_rgb_r(0x161B22);
}

test the_border_is_a_neutral_grey_that_shows_on_black_and_stays_quiet {
    // R = G = B: a grey with no tint of any colour.
    assert viz_rgb_r(VIZ_BORDER_RGB) == viz_rgb_g(VIZ_BORDER_RGB);
    assert viz_rgb_g(VIZ_BORDER_RGB) == viz_rgb_b(VIZ_BORDER_RGB);
    assert VIZ_BORDER_RGB == 0x333333;
    assert viz_rgb_r(VIZ_BORDER_RGB) == 51;
    // It is lighter than the card, so the card edge is visible on the black page, and darker than the muted ink.
    assert viz_luma(VIZ_BORDER_RGB) > viz_luma(VIZ_PANEL_RGB);
    assert viz_luma(VIZ_BORDER_RGB) >= VIZ_BORDER_MIN_LUMA;
    assert viz_luma(VIZ_BORDER_RGB) <= VIZ_BORDER_MAX_LUMA;
    assert viz_luma(VIZ_BORDER_RGB) < viz_luma(VIZ_MUTED_RGB);
    assert viz_role_rgb(VIZ_ROLE_BORDER) == VIZ_BORDER_RGB;
    // Over the roles at run time: exactly BG, PANEL and BORDER are neutral (R = G = B); the ink, the muted ink
    // and the accent carry a cast, so the test can tell a grey from a tint.
    var role : u32 = 0;
    var neutral : u32 = 0;
    while (role < VIZ_ROLE_COUNT) {
        const rgb : u32 = viz_role_rgb(role);
        if (viz_rgb_r(rgb) == viz_rgb_g(rgb) and viz_rgb_g(rgb) == viz_rgb_b(rgb)) {
            neutral = neutral + 1;
        }
        role = role + 1;
    }
    assert neutral == 3;
    // The bounds are real: the black page is below the minimum, the muted ink is above the maximum.
    assert viz_luma(VIZ_BG_RGB) < VIZ_BORDER_MIN_LUMA;
    assert viz_luma(VIZ_MUTED_RGB) > VIZ_BORDER_MAX_LUMA;
}

test the_ink_stays_readable_on_a_pure_black_card_by_the_stated_margins {
    assert viz_readable_on(VIZ_INK_RGB, 0x000000, VIZ_MARGIN_INK);
    assert viz_readable_on(VIZ_MUTED_RGB, 0x000000, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_ACCENT_RGB, 0x000000, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_INK_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_INK);
    // Hand-counted lead of the ink over the card: 235 - 0.
    assert viz_luma(VIZ_INK_RGB) - viz_luma(VIZ_PANEL_RGB) == 235;
    // The border grey is NOT text: it does not meet the quiet margin on black.
    assert viz_readable_on(VIZ_BORDER_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET) == false;
}

test every_truth_colour_is_readable_on_the_background_and_on_a_panel {
    var t : u8 = 0;
    while (t < VIZ_TRUTH_COUNT) {
        assert viz_readable_on(viz_truth_rgb(t), VIZ_BG_RGB, VIZ_MARGIN_QUIET);
        assert viz_readable_on(viz_truth_rgb(t), VIZ_PANEL_RGB, VIZ_MARGIN_QUIET - 10);
        t = t + 1;
    }
    // Hand-counted, so the loop above cannot pass by accident.
    assert viz_luma(viz_truth_rgb(VIZ_TRUTH_LIVE)) == 192;
    assert viz_luma(viz_truth_rgb(VIZ_TRUTH_VERIFIED)) == 207;
    assert viz_luma(viz_truth_rgb(VIZ_TRUTH_CACHED)) == 155;
    assert viz_luma(viz_truth_rgb(VIZ_TRUTH_DEMO)) == 145;
    assert viz_luma(viz_truth_rgb(VIZ_TRUTH_UNKNOWN)) == 138;
}

test the_muted_ink_and_the_accent_are_readable_on_the_page_and_on_a_panel {
    assert viz_readable_on(VIZ_MUTED_RGB, VIZ_BG_RGB, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_MUTED_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_ACCENT_RGB, VIZ_BG_RGB, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_ACCENT_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
    // The muted ink stays quieter than the ink.
    assert viz_luma(VIZ_MUTED_RGB) < viz_luma(VIZ_INK_RGB);
}

test the_palette_keeps_its_six_roles_distinct_except_that_a_card_is_the_page_black {
    // Every pair of roles differs, except BG and PANEL, which are the same black on purpose.
    var i : u32 = 0;
    var same : u32 = 0;
    while (i < VIZ_ROLE_COUNT) {
        var j : u32 = i + 1;
        while (j < VIZ_ROLE_COUNT) {
            if (viz_role_rgb(i) == viz_role_rgb(j)) {
                same = same + 1;
                assert i == VIZ_ROLE_BG;
                assert j == VIZ_ROLE_PANEL;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert same == 1;
    assert viz_role_rgb(VIZ_ROLE_BG) == 0x000000;
    assert viz_role_rgb(VIZ_ROLE_PANEL) == 0x000000;
    assert viz_role_rgb(VIZ_ROLE_INK) == 0xE6EDF3;
    assert viz_role_rgb(VIZ_ROLE_MUTED) == 0x8B949E;
    assert viz_role_rgb(VIZ_ROLE_ACCENT) == 0x58A6FF;
    assert viz_role_rgb(VIZ_ROLE_BORDER) == 0x333333;
    assert viz_role_rgb(99) == 0xE6EDF3;
    assert VIZ_ROLE_COUNT == 6;
}

test the_channel_split_reads_back_the_colour {
    assert viz_rgb_r(0x58A6FF) == 88;
    assert viz_rgb_g(0x58A6FF) == 166;
    assert viz_rgb_b(0x58A6FF) == 255;
    assert viz_rgb_r(VIZ_BG_RGB) * 65536 + viz_rgb_g(VIZ_BG_RGB) * 256 + viz_rgb_b(VIZ_BG_RGB) == VIZ_BG_RGB;
    assert viz_rgb_r(VIZ_INK_RGB) * 65536 + viz_rgb_g(VIZ_INK_RGB) * 256 + viz_rgb_b(VIZ_INK_RGB) == VIZ_INK_RGB;
}

invariant a_demo_view_never_claims_a_result {
    assert viz_may_claim(VIZ_TRUTH_DEMO) == false;
    assert viz_may_claim(VIZ_TRUTH_UNKNOWN) == false;
}

invariant every_rep_has_a_name {
    assert VIZ_REP_COUNT == 13;
    assert VIZ_TRUTH_COUNT == 5;
    assert VIZ_LC_COUNT == 5;
}
