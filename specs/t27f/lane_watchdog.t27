// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::lane_watchdog;

pub const LANE_WATCHDOG_MAX_LANES : u32 = 27;

pub struct LaneWatchdog { lane_id: str, active: bool };

pub fn lane_watchdog_active(w: LaneWatchdog) -> bool {
    return w.active;
}

test "lane_watchdog_active" {
    assert(lane_watchdog_active(LaneWatchdog { lane_id: "lane-1", active: true }));
    assert(!lane_watchdog_active(LaneWatchdog { lane_id: "lane-2", active: false }));
}

invariant lane_watchdog_max_lanes_positive {
    assert LIVE_FLEET_MAX_ACTORS > 0;
}