use t27f::frontend::I_HEALTH;
use t27f::frontend::I_LIVE_AGENT;
use t27f::frontend::I_SPEC_WORDS;
use t27f::frontend::I_COUNT;

; ---------------------------------------------------------------- marks and codes

/// How an object is drawn inside a rep. NONE means the rep does not draw that kind at all.
pub const WV_MARK_NONE : u8 = 0;
pub const WV_MARK_NODE : u8 = 1;     // a node of the node-link view
pub const WV_MARK_ROW : u8 = 2;      // one line of the list
pub const WV_MARK_LANE : u8 = 3;     // a horizontal lane of the timeline
pub const WV_MARK_TICK : u8 = 4;     // a tick on its performer's lane, at its bus seq
pub const WV_MARK_BAR : u8 = 5;      // a bar of the chart
pub const WV_MARK_COUNTED : u8 = 6;  // no mark of its own: summed into its performer's bar
pub const WV_MARK_DETAIL : u8 = 7;   // the inspector's detail of the selected object
pub const WV_MARK_COUNT : u8 = 8;
pub const WV_MARK_NAMES : [8]str = ["none", "node", "row", "lane", "tick", "bar", "counted", "detail"];

pub const WV_OK : u8 = 0;
pub const WV_REF_PICK : u8 = 1;      // viz_select refused the composition: nothing is placed
pub const WV_REF_INTENT : u8 = 2;    // not one of the three actor intents
pub const WV_REF_KIND : u8 = 3;      // kind >= NK_COUNT
pub const WV_UNPLACED : u8 = 4;      // no preferred rep of this kind is in the composition
pub const WV_CODE_COUNT : u8 = 5;
pub const WV_CODE_NAMES : [5]str = ["ok", "refused: the composition itself was refused", "refused: intent is not an actor intent", "refused: not a work-graph node kind", "unplaced: no rep of the composition fits this kind"];

/// Ranks per rule, and the actor intents in a fixed order (the closed-table test walks them).
pub const WV_RANKS : u32 = 3;
pub const WV_INTENTS : u32 = 3;

pub fn wv_intent_at(i: u32) -> u32 {
    if (i == 0) { return I_LIVE_AGENT; }
    if (i == 1) { return I_HEALTH; }
    if (i == 2) { return I_REPORT; }
    return I_COUNT;
}

pub fn wv_is_actor_intent(intent: u32) -> bool {
    return intent == I_LIVE_AGENT or intent == I_HEALTH or intent == I_REPORT;
}

; ---------------------------------------------------------------- the adapter: graph -> shape

/// The VizShape of a work graph, every field computed from the graph. The degree table is sized
/// by NODE_CAP (2048, pinned by test); an edge end at or past node_count is not counted.
pub fn wv_shape(g: *WorkGraph) -> VizShape {
    let n : u32 = nodes(g);
    let m : u32 = edges(g);
    var deg : [2048]u32 = [0] ** 2048;
    var fan : u32 = 0;
    var numeric : u8 = 0;
    var e : u32 = 0;
    while (e < m) {
        let f : u32 = edge_from_at(g, e);
        if (f < n) {
            deg[f as usize] = deg[f as usize] + 1;
            if (deg[f as usize] > fan) { fan = deg[f as usize]; }
        }
        if (edge_kind_at(g, e) == EK_PERFORMS) { numeric = 1; }
        e = e + 1;
    }
    var s : VizShape = vs_shape(n, m, fan);
    s.has_numeric = numeric;
    var i : u32 = 0;
    while (i < n) {
        if (node_kind_at_pub(g, i) == NK_ACTION) { s.has_time = 1; }
        if (node_label_at(g, i) == LABEL_UNKNOWN) { s.any_unknown = 1; }
        if (node_label_at(g, i) == LABEL_SUGGESTED) { s.any_suggested = 1; }
        i = i + 1;
    }
    return s;
}

/// The value of an agent's bar: the PERFORMS edges that leave node a.
pub fn wv_load(g: *WorkGraph, a: u32) -> u32 {
    var c : u32 = 0;
    var e : u32 = 0;
    while (e < edges(g)) {
        if (edge_kind_at(g, e) == EK_PERFORMS and edge_from_at(g, e) == a) { c = c + 1; }
        e = e + 1;
    }
    return c;
}

; ---------------------------------------------------------------- the rule table

fn wv_pick3(rank: u32, a: u8, b: u8, c: u8) -> u8 {
    if (rank == 0) { return a; }
    if (rank == 1) { return b; }
    if (rank == 2) { return c; }
    return VIZ_REP_COUNT;
}

/// Object kind x intent -> the rep at this rank, VIZ_REP_COUNT when the rule names none.
/// Live work: agents are lanes and actions ticks, the rest is the graph. Health: agents are bars
/// of load, actions are counted into them, tasks and their outputs are rows. Report: rows first,
/// actions keep their order on the timeline.
pub fn wv_rule(intent: u32, kind: u8, rank: u32) -> u8 {
    let no : u8 = VIZ_REP_COUNT;
    if (intent == I_LIVE_AGENT) {
        if (kind == NK_SPEC) { return wv_pick3(rank, VIZ_REP_GRAPH, VIZ_REP_LIST, no); }
        if (kind == NK_AGENT) { return wv_pick3(rank, VIZ_REP_TIMELINE, VIZ_REP_GRAPH, VIZ_REP_LIST); }
        if (kind == NK_TASK) { return wv_pick3(rank, VIZ_REP_GRAPH, VIZ_REP_LIST, no); }
        if (kind == NK_ACTION) { return wv_pick3(rank, VIZ_REP_TIMELINE, VIZ_REP_LIST, no); }
        if (kind == NK_ARTIFACT) { return wv_pick3(rank, VIZ_REP_GRAPH, VIZ_REP_LIST, no); }
        return no;
    }
    if (intent == I_HEALTH) {
        if (kind == NK_SPEC) { return wv_pick3(rank, VIZ_REP_LIST, no, no); }
        if (kind == NK_AGENT) { return wv_pick3(rank, VIZ_REP_CHART, VIZ_REP_LIST, no); }
        if (kind == NK_TASK) { return wv_pick3(rank, VIZ_REP_LIST, VIZ_REP_GRAPH, no); }
        if (kind == NK_ACTION) { return wv_pick3(rank, VIZ_REP_CHART, no, no); }
        if (kind == NK_ARTIFACT) { return wv_pick3(rank, VIZ_REP_LIST, no, no); }
        return no;
    }
    if (intent == I_REPORT) {
        if (kind == NK_SPEC) { return wv_pick3(rank, VIZ_REP_LIST, VIZ_REP_GRAPH, no); }
        if (kind == NK_AGENT) { return wv_pick3(rank, VIZ_REP_LIST, VIZ_REP_GRAPH, no); }
        if (kind == NK_TASK) { return wv_pick3(rank, VIZ_REP_LIST, VIZ_REP_GRAPH, no); }
        if (kind == NK_ACTION) { return wv_pick3(rank, VIZ_REP_TIMELINE, VIZ_REP_LIST, no); }
        if (kind == NK_ARTIFACT) { return wv_pick3(rank, VIZ_REP_LIST, VIZ_REP_GRAPH, no); }
        return no;
    }
    return no;
}

/// Object kind x rep -> mark. The graph, the list and the inspector draw every kind; the timeline
/// draws agents as lanes and actions as ticks; the chart draws agents as bars and counts actions.
pub fn wv_mark(kind: u8, rep: u8) -> u8 {
    if (kind >= NK_COUNT) { return WV_MARK_NONE; }
    if (rep == VIZ_REP_GRAPH) { return WV_MARK_NODE; }
    if (rep == VIZ_REP_LIST) { return WV_MARK_ROW; }
    if (rep == VIZ_REP_INSPECTOR) { return WV_MARK_DETAIL; }
    if (rep == VIZ_REP_TIMELINE) {
        if (kind == NK_AGENT) { return WV_MARK_LANE; }
        if (kind == NK_ACTION) { return WV_MARK_TICK; }
        return WV_MARK_NONE;
    }
    if (rep == VIZ_REP_CHART) {
        if (kind == NK_AGENT) { return WV_MARK_BAR; }
        if (kind == NK_ACTION) { return WV_MARK_COUNTED; }
        return WV_MARK_NONE;
    }
    return WV_MARK_NONE;
}

; ---------------------------------------------------------------- resolving against a pick

/// Where an object of a kind lives in one composition.
pub struct WvPlace {
    code: u8,
    rep: u8,
    mark: u8,
    rank: u32,
}

fn wv_holds(p: VizPick, rep: u8) -> bool {
    var i : u32 = 0;
    while (i < p.count) {
        if (p.reps[i as usize] == rep) { return true; }
        i = i + 1;
    }
    return false;
}

/// The home of a kind: the first rep of its rule that the composition holds.
pub fn wv_home(kind: u8, intent: u32, p: VizPick) -> WvPlace {
    var out : WvPlace = WvPlace { code: WV_OK, rep: VIZ_REP_COUNT, mark: WV_MARK_NONE, rank: WV_RANKS };
    if (p.code != VS_OK) { out.code = WV_REF_PICK; return out; }
    if (wv_is_actor_intent(intent) == false) { out.code = WV_REF_INTENT; return out; }
    if (kind >= NK_COUNT) { out.code = WV_REF_KIND; return out; }
    var r : u32 = 0;
    while (r < WV_RANKS) {
        let rep : u8 = wv_rule(intent, kind, r);
        if (rep < VIZ_REP_COUNT and wv_holds(p, rep)) {
            out.rep = rep;
            out.mark = wv_mark(kind, rep);
            out.rank = r;
            return out;
        }
        r = r + 1;
    }
    out.code = WV_UNPLACED;
    return out;
}

/// Every rep of the composition that draws the kind, as viz_rep_bit bits; 0 for a refused pick.
pub fn wv_members(kind: u8, p: VizPick) -> u32 {
    if (p.code != VS_OK) { return 0; }
    var bits : u32 = 0;
    var i : u32 = 0;
    while (i < p.count) {
        let rep : u8 = p.reps[i as usize];
        if (wv_mark(kind, rep) != WV_MARK_NONE) { bits = bits | viz_rep_bit(rep); }
        i = i + 1;
    }
    return bits;
}

; ---------------------------------------------------------------- tests

/// Four spawned agents; agent 1 offers three tasks (two read spec 100, one spec 101), agents 2 and
/// 3 return results, agent 1 cancels task 12. By hand: 17 nodes, 19 edges, agent 1 has the largest
/// fan-out (7: four PERFORMS, two VERIFIES, one BLOCKS), six actions, loads 4 / 1 / 1 / 0.
fn wv_fixture() -> WorkGraph {
    var g = new_graph();
    var r : u8 = WG_OK;
    r = apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 });
    r = apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 3, task_no: 0, deliver: D_NONE, reason: 99, seq: 2, spec_id: 0 });
    r = apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 4, task_no: 0, deliver: D_NONE, reason: 99, seq: 3, spec_id: 0 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 2, task_no: 10, deliver: D_OFFER, reason: 99, seq: 5, spec_id: 100 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 3, task_no: 11, deliver: D_OFFER, reason: 99, seq: 6, spec_id: 101 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 4, task_no: 12, deliver: D_OFFER, reason: 99, seq: 7, spec_id: 100 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 2, to_pid: 1, task_no: 10, deliver: D_RESULT, reason: 99, seq: 8, spec_id: 0 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 3, to_pid: 1, task_no: 11, deliver: D_RESULT, reason: 99, seq: 9, spec_id: 0 });
    r = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 1, to_pid: 4, task_no: 12, deliver: D_CANCEL, reason: 99, seq: 10, spec_id: 0 });
    return g;
}

test the_shape_is_computed_from_the_graph {
    var g = wv_fixture();
    const s : VizShape = wv_shape(&g);
    assert s.node_count == 17;
    assert s.edge_count == 19;
    assert s.max_fanout == 7;
    assert s.has_time == 1;
    assert s.has_numeric == 1;
    assert s.any_unknown == 0;
    assert s.any_suggested == 0;
    assert s.wants_path == 0;
    assert s.pairwise == 0;
    assert NODE_CAP == 2048;
}

test the_bars_count_every_action_once {
    var g = wv_fixture();
    const a1 : u32 = node_of(&g, NK_AGENT, 1);
    const a2 : u32 = node_of(&g, NK_AGENT, 2);
    const a3 : u32 = node_of(&g, NK_AGENT, 3);
    const a4 : u32 = node_of(&g, NK_AGENT, 4);
    assert wv_load(&g, a1) == 4;
    assert wv_load(&g, a2) == 1;
    assert wv_load(&g, a3) == 1;
    assert wv_load(&g, a4) == 0;
    var performs : u32 = 0;
    var e : u32 = 0;
    while (e < edges(&g)) {
        if (edge_kind_at(&g, e) == EK_PERFORMS) { performs = performs + 1; }
        e = e + 1;
    }
    assert performs == 6;
    assert wv_load(&g, a1) + wv_load(&g, a2) + wv_load(&g, a3) + wv_load(&g, a4) == performs;
}

test one_actor_model_three_representations {
    var g = wv_fixture();
    const p : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    assert p.code == VS_OK;
    assert p.primary == VIZ_REP_GRAPH;
    assert p.count == 5;
    assert p.reps[0] == VIZ_REP_GRAPH;
    assert p.reps[1] == VIZ_REP_CHART;
    assert p.reps[2] == VIZ_REP_TIMELINE;
    assert p.reps[3] == VIZ_REP_STEPPER;
    assert p.reps[4] == VIZ_REP_BADGE;
    // an agent is drawn in all three views: a node, a bar and a lane
    assert wv_members(NK_AGENT, p) == (viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_CHART) | viz_rep_bit(VIZ_REP_TIMELINE));
    assert wv_members(NK_ACTION, p) == (viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_CHART) | viz_rep_bit(VIZ_REP_TIMELINE));
    assert wv_members(NK_TASK, p) == viz_rep_bit(VIZ_REP_GRAPH);
    assert wv_members(NK_SPEC, p) == viz_rep_bit(VIZ_REP_GRAPH);
}

test live_work_puts_agents_on_lanes_and_the_rest_in_the_graph {
    var g = wv_fixture();
    const p : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    const ag : WvPlace = wv_home(NK_AGENT, I_LIVE_AGENT, p);
    assert ag.code == WV_OK;
    assert ag.rep == VIZ_REP_TIMELINE;
    assert ag.mark == WV_MARK_LANE;
    assert ag.rank == 0;
    const ac : WvPlace = wv_home(NK_ACTION, I_LIVE_AGENT, p);
    assert ac.rep == VIZ_REP_TIMELINE;
    assert ac.mark == WV_MARK_TICK;
    const tk : WvPlace = wv_home(NK_TASK, I_LIVE_AGENT, p);
    assert tk.rep == VIZ_REP_GRAPH;
    assert tk.mark == WV_MARK_NODE;
    const ar : WvPlace = wv_home(NK_ARTIFACT, I_LIVE_AGENT, p);
    assert ar.rep == VIZ_REP_GRAPH;
}

test health_leads_with_the_chart_and_leaves_tasks_unplaced {
    var g = wv_fixture();
    const p : VizPick = vs_select(I_HEALTH, wv_shape(&g));
    assert p.code == VS_OK;
    assert p.primary == VIZ_REP_CHART;
    const ag : WvPlace = wv_home(NK_AGENT, I_HEALTH, p);
    assert ag.rep == VIZ_REP_CHART;
    assert ag.mark == WV_MARK_BAR;
    const ac : WvPlace = wv_home(NK_ACTION, I_HEALTH, p);
    assert ac.mark == WV_MARK_COUNTED;
    // the health composition holds no list and no graph: a task is unplaced, not forced into a bar
    const tk : WvPlace = wv_home(NK_TASK, I_HEALTH, p);
    assert tk.code == WV_UNPLACED;
    assert tk.rep == VIZ_REP_COUNT;
    assert tk.mark == WV_MARK_NONE;
    assert wv_mark(NK_TASK, VIZ_REP_CHART) == WV_MARK_NONE;
}

test the_same_composition_with_another_intent_moves_the_home {
    var g = wv_fixture();
    const live : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    const rep : VizPick = vs_select(I_REPORT, wv_shape(&g));
    assert rep.primary == live.primary;
    assert rep.count == live.count;
    // report prefers a list, the composition has none: the agent falls to its rank-1 rep
    const a_rep : WvPlace = wv_home(NK_AGENT, I_REPORT, rep);
    assert a_rep.rep == VIZ_REP_GRAPH;
    assert a_rep.rank == 1;
    const a_live : WvPlace = wv_home(NK_AGENT, I_LIVE_AGENT, live);
    assert a_live.rep == VIZ_REP_TIMELINE;
    assert a_live.rep != a_rep.rep;
}

test the_rule_table_is_closed {
    var i : u32 = 0;
    while (i < WV_INTENTS) {
        const intent : u32 = wv_intent_at(i);
        assert wv_is_actor_intent(intent);
        var k : u8 = 0;
        while (k < NK_COUNT) {
            assert wv_rule(intent, k, 0) < VIZ_REP_COUNT;
            var r : u32 = 0;
            while (r < WV_RANKS) {
                const rep : u8 = wv_rule(intent, k, r);
                if (rep < VIZ_REP_COUNT) {
                    assert wv_mark(k, rep) != WV_MARK_NONE;
                }
                r = r + 1;
            }
            assert wv_rule(intent, k, WV_RANKS) == VIZ_REP_COUNT;
            k = k + 1;
        }
        i = i + 1;
    }
    assert wv_intent_at(WV_INTENTS) == I_COUNT;
    assert wv_rule(I_SPEC_WORDS, NK_AGENT, 0) == VIZ_REP_COUNT;
    assert wv_mark(NK_COUNT, VIZ_REP_GRAPH) == WV_MARK_NONE;
    assert wv_mark(NK_AGENT, VIZ_REP_MATRIX) == WV_MARK_NONE;
    assert wv_mark(NK_AGENT, VIZ_REP_BADGE) == WV_MARK_NONE;
}

test refusals_place_nothing {
    var e = new_graph();
    const pe : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&e));
    assert pe.code == VS_REF_EMPTY;
    const h : WvPlace = wv_home(NK_AGENT, I_LIVE_AGENT, pe);
    assert h.code == WV_REF_PICK;
    assert h.rep == VIZ_REP_COUNT;
    assert wv_members(NK_AGENT, pe) == 0;
    var g = wv_fixture();
    const p : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    assert wv_home(NK_AGENT, I_SPEC_WORDS, p).code == WV_REF_INTENT;
    assert wv_home(NK_COUNT, I_LIVE_AGENT, p).code == WV_REF_KIND;
}

test a_pid_never_spawned_marks_the_shape_unknown {
    var g = new_graph();
    const r : u8 = apply_event(&g, Event { kind: EV_DELIVER, from_pid: 10, to_pid: 20, task_no: 0, deliver: D_NONE, reason: 99, seq: 7, spec_id: 0 });
    assert r == WG_OK;
    const s : VizShape = wv_shape(&g);
    assert s.any_unknown == 1;
    assert s.node_count == 3;
    assert s.edge_count == 1;
    assert s.max_fanout == 1;
}

test the_same_graph_gives_the_same_places_twice {
    var g = wv_fixture();
    const a : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    const b : VizPick = vs_select(I_LIVE_AGENT, wv_shape(&g));
    var k : u8 = 0;
    while (k < NK_COUNT) {
        const x : WvPlace = wv_home(k, I_LIVE_AGENT, a);
        const y : WvPlace = wv_home(k, I_LIVE_AGENT, b);
        assert x.code == y.code;
        assert x.rep == y.rep;
        assert x.mark == y.mark;
        assert x.rank == y.rank;
        assert wv_members(k, a) == wv_members(k, b);
        k = k + 1;
    }
}
