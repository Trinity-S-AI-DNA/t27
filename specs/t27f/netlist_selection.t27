// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_selection.t27 -- selection state for a NETLIST view.
; Ring 2, Wave E1 of epic #13650.
; NvSelection holds the index of the selected node (NV_NO_SELECTION = no selection).
; Theme roles: selected node gets nt_accent() (TH_GOLD); others keep nt_fill/nt_stroke/nt_text.
; nv_select_at and nv_no_selection are the only mutators -- the host owns the state.
; Does not define any RGBA literal.  Graph IR not changed.
; Depends on lane/netlist-view-13716 (NvPlan, nv_hit) and netlist_tokens (roles).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_selection;

use t27f::netlist_graph::{NetlistGraph, NG_MAX_NODES, NG_NODE_KINDS, NG_LABEL_KINDS, inverter_graph};
use t27f::netlist_view::{NvPlan, nv_layout, nv_node_x, nv_node_y, NV_NODE_W, NV_NODE_H};
use t27f::netlist_tokens::{nt_fill, nt_stroke, nt_text, nt_accent, nt_look, NT_NONE};
use t27f::netlist_slice::{nv_hit};

; ── Sentinel ──────────────────────────────────────────────────────────────────
; NV_NO_SELECTION is outside any valid node index range (0..NG_MAX_NODES-1).
pub const NV_NO_SELECTION : u32 = NG_MAX_NODES;

; ── NvSelection struct ────────────────────────────────────────────────────────
pub struct NvSelection {
    idx : u32,
}

; ── State constructors ────────────────────────────────────────────────────────
pub fn nv_no_selection() -> NvSelection {
    var s : NvSelection;
    s.idx = NV_NO_SELECTION;
    return s;
}

pub fn nv_select_node(idx: u32) -> NvSelection {
    var s : NvSelection;
    s.idx = idx;
    return s;
}

; ── State query ───────────────────────────────────────────────────────────────
pub fn nv_is_selected(sel: NvSelection) -> bool {
    return sel.idx < NV_NO_SELECTION;
}

; ── Selection from a click ────────────────────────────────────────────────────
; Returns updated selection; if no node is hit, clears selection.
pub fn nv_select_at(p: NvPlan, g: NetlistGraph, px: u32, py: u32) -> NvSelection {
    let hit : u32 = nv_hit(p, g, px, py);
    if (hit < g.node_count) {
        return nv_select_node(hit);
    }
    return nv_no_selection();
}

; ── Theme-role accessors (selected = gold accent, others = token roles) ───────
pub fn nv_fill_role(g: NetlistGraph, sel: NvSelection, i: u32) -> u32 {
    if (sel.idx == i) { return nt_accent(); }
    let k : u32 = g.node_kind[i as usize] as u32;
    let l : u32 = g.node_label[i as usize] as u32;
    return nt_fill(k, l);
}

pub fn nv_stroke_role(g: NetlistGraph, sel: NvSelection, i: u32) -> u32 {
    if (sel.idx == i) { return nt_accent(); }
    let k : u32 = g.node_kind[i as usize] as u32;
    let l : u32 = g.node_label[i as usize] as u32;
    return nt_stroke(k, l);
}

pub fn nv_text_role(g: NetlistGraph, sel: NvSelection, i: u32) -> u32 {
    if (sel.idx == i) { return nt_accent(); }
    let k : u32 = g.node_kind[i as usize] as u32;
    let l : u32 = g.node_label[i as usize] as u32;
    return nt_text(k, l);
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_is_unselected {
    let s : NvSelection = nv_no_selection();
    assert nv_is_selected(s) == false;
    assert s.idx == NV_NO_SELECTION;
}

test click_on_block_selects_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s : NvSelection = nv_select_at(p, g, nv_node_x(p, 0) + 4, nv_node_y(p, 0) + 4);
    assert nv_is_selected(s);
    assert s.idx == 0;
}

test click_on_second_pin_selects_two {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s : NvSelection = nv_select_at(p, g, nv_node_x(p, 2) + 4, nv_node_y(p, 2) + 4);
    assert nv_is_selected(s);
    assert s.idx == 2;
}

test two_clicks_give_distinct_selection_ids {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s0 : NvSelection = nv_select_at(p, g, nv_node_x(p, 0) + 4, nv_node_y(p, 0) + 4);
    let s2 : NvSelection = nv_select_at(p, g, nv_node_x(p, 2) + 4, nv_node_y(p, 2) + 4);
    assert s0.idx != s2.idx;
}

test click_outside_clears_selection {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s : NvSelection = nv_select_at(p, g, 0, 0);
    assert nv_is_selected(s) == false;
}

test selected_node_gets_accent_fill_role {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s : NvSelection = nv_select_node(0);
    assert nv_fill_role(g, s, 0) == nt_accent();
}

test unselected_node_does_not_get_accent {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s : NvSelection = nv_select_node(0);
    let role : u32 = nv_fill_role(g, s, 1);
    assert role != nt_accent();
}

test switching_selection_moves_accent {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    let s0 : NvSelection = nv_select_node(0);
    let s2 : NvSelection = nv_select_node(2);
    assert nv_fill_role(g, s0, 0) == nt_accent();
    assert nv_fill_role(g, s0, 2) != nt_accent();
    assert nv_fill_role(g, s2, 2) == nt_accent();
    assert nv_fill_role(g, s2, 0) != nt_accent();
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant no_selection_sentinel_above_capacity {
    assert NV_NO_SELECTION == NG_MAX_NODES;
    assert NV_NO_SELECTION > 0;
}

invariant accent_role_is_defined {
    assert nt_accent() != NT_NONE;
}

invariant nv_no_selection_is_unselected {
    let s : NvSelection = nv_no_selection();
    assert nv_is_selected(s) == false;
}
