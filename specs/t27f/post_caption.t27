// SPDX-License-Identifier: Apache-2.0
// specs/t27f/post_caption.t27 -- whether a post's caption fits the channel it goes to. Issue
// gHashTag/t27#10916, epic #10915.
//
// WHY: the content factory can draw a reel and a cover for an idea, but nothing decides whether
// the post's caption fits the channel it goes to. Today that check is done by eye, and a caption
// a channel would cut reaches the owner. This spec writes the rule as pure functions with tests,
// so TRI CLAW can refuse a caption before it is packed.
//
// THE PIECES, all integer (compares and one multiply, no division):
//   limits    max_caption_len / max_hashtags name each channel's public limit and the house rule
//             for hashtags. X counts 280 characters and every link as 23, whatever the link's
//             length; a Telegram media caption holds 1024; an Instagram caption holds 2200. The
//             hashtag caps (X 2, Telegram 3, Instagram 5) are a house rule, not a platform limit.
//   weigh     weighted_len counts a link as 23 on X only; the other channels weigh the bytes as
//             they are.
//   verdict   caption_ok is true only when the weighted length is at most the channel's limit and
//             the hashtag count is at most its cap. An unknown channel is refused, never guessed.
//
// NOT CLAIMED: captions are ASCII byte counts, Cyrillic is out of scope for this task; the
// platform limits are the public ones of 2026-10, not scraped from a terms page; a caption whose
// link bytes exceed its total bytes is outside the contract (u16 subtraction does not wrap, and
// such a caption cannot exist as written).
// phi^2 + 1/phi^2 = 3 | TRINITY

module post_caption;

pub const ID : str = "post_caption";
pub const VERSION : u8 = 1;

pub const CH_X : u8 = 0;
pub const CH_TELEGRAM : u8 = 1;
pub const CH_INSTAGRAM : u8 = 2;

// X counts every link as 23 characters, whatever the link's length.
pub const LINK_COST : u16 = 23;

pub fn max_caption_len(ch: u8) -> u16 {
    if (ch == CH_X) { return 280; }
    if (ch == CH_TELEGRAM) { return 1024; }
    if (ch == CH_INSTAGRAM) { return 2200; }
    return 0;
}

pub fn max_hashtags(ch: u8) -> u8 {
    if (ch == CH_X) { return 2; }
    if (ch == CH_TELEGRAM) { return 3; }
    if (ch == CH_INSTAGRAM) { return 5; }
    return 0;
}

pub fn weighted_len(ch: u8, bytes: u16, links: u8, link_bytes: u16) -> u16 {
    if (ch == CH_X) { return bytes - link_bytes + @as(u16, links) * LINK_COST; }
    return bytes;
}

pub fn caption_ok(ch: u8, bytes: u16, links: u8, link_bytes: u16, hashtags: u8) -> bool {
    if (max_caption_len(ch) == 0) { return false; }
    if (weighted_len(ch, bytes, links, link_bytes) > max_caption_len(ch)) { return false; }
    return hashtags <= max_hashtags(ch);
}

// ---- tests ----

// Channel numbers no limit table knows: the first past Instagram, a probe, a big one, the max.
pub const UNKNOWN_CHANNELS : [5]u8 = [3, 9, 100, 200, 255];

test "the channel constants and limits: X 280 and 2 hashtags, Telegram 1024 and 3, Instagram 2200 and 5" {
    assert(CH_X == 0);
    assert(CH_TELEGRAM == 1);
    assert(CH_INSTAGRAM == 2);
    assert(max_caption_len(CH_X) == 280);
    assert(max_caption_len(CH_TELEGRAM) == 1024);
    assert(max_caption_len(CH_INSTAGRAM) == 2200);
    assert(max_hashtags(CH_X) == 2);
    assert(max_hashtags(CH_TELEGRAM) == 3);
    assert(max_hashtags(CH_INSTAGRAM) == 5);
}

test "a 270-byte caption with no link fits X" {
    assert(caption_ok(CH_X, 270, 0, 0, 0) == true);
}

test "a link counts as 23 on X, whatever its length: 260 bytes with one 40-byte link weighs 243" {
    assert(weighted_len(CH_X, 260, 1, 40) == 243);
    assert(caption_ok(CH_X, 260, 1, 40, 0) == true);
    assert(weighted_len(CH_X, 260, 1, 90) == 193);   // a longer link weighs the same 23
    assert(weighted_len(CH_X, 260, 2, 60) == 246);   // every link adds its own 23
}

test "the other channels weigh the bytes as they are, links are not discounted" {
    assert(weighted_len(CH_TELEGRAM, 260, 1, 40) == 260);
    assert(weighted_len(CH_INSTAGRAM, 260, 1, 40) == 260);
}

test "hashtags over the house cap refuse the channel: 3 on X is refused, 2 is not" {
    assert(caption_ok(CH_X, 100, 0, 0, 3) == false);
    assert(caption_ok(CH_X, 100, 0, 0, 2) == true);
    assert(caption_ok(CH_TELEGRAM, 100, 0, 0, 4) == false);
    assert(caption_ok(CH_INSTAGRAM, 100, 0, 0, 6) == false);
}

test "the boundary: 280 fits X and 281 does not, 2200 fits Instagram and 2201 does not" {
    assert(caption_ok(CH_X, 280, 0, 0, 0) == true);
    assert(caption_ok(CH_X, 281, 0, 0, 0) == false);
    assert(caption_ok(CH_INSTAGRAM, 2200, 0, 0, 0) == true);
    assert(caption_ok(CH_INSTAGRAM, 2201, 0, 0, 0) == false);
    assert(caption_ok(CH_INSTAGRAM, 2190, 1, 80, 0) == true);   // a link costs nothing there
    assert(caption_ok(CH_TELEGRAM, 1024, 0, 0, 0) == true);
    assert(caption_ok(CH_TELEGRAM, 1025, 0, 0, 0) == false);
}

test "an unknown channel answers 0 or false, never a guess" {
    var i : usize = 0;
    while (i < UNKNOWN_CHANNELS.len) {
        var ch : u8 = UNKNOWN_CHANNELS[i];
        assert(max_caption_len(ch) == 0);
        assert(max_hashtags(ch) == 0);
        assert(caption_ok(ch, 100, 1, 40, 1) == false);
        i = i + 1;
    }
}

invariant an_unknown_channel_is_refused {
    assert(max_caption_len(CH_INSTAGRAM + 1) == 0);
    assert(max_hashtags(CH_INSTAGRAM + 1) == 0);
    assert(caption_ok(CH_INSTAGRAM + 1, 100, 0, 0, 0) == false);
}
