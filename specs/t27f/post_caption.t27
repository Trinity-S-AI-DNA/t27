// SPDX-License-Identifier: Apache-2.0
// specs/t27f/post_caption.t27 -- a caption fits its channel. Issue gHashTag/t27#10916, epic #10915.
//
// WHY: the content factory can draw a reel and a cover for an idea, but nothing decides whether the
// post's caption fits the channel it goes to. Today a person checks it by eye. This is the rule as
// pure functions, so TRI CLAW can refuse a caption a channel would cut before anything is published.
//
// THE PUBLIC LIMITS IT ENCODES:
//   X         280 characters, and every link counts as 23 whatever its real length.
//   Telegram  a media caption holds 1024 characters.
//   Instagram a caption holds 2200.
// The hashtag caps are a HOUSE RULE, not a platform limit: X 2, Telegram 3, Instagram 5.
//
// SCOPE: captions here are ASCII byte counts. Cyrillic is out of scope for this task; a byte count
// and a character count differ there, so a Cyrillic caption is not judged by this spec yet.
//
// NOT CLAIMED: no URL parsing (the caller says how many links and their bytes), no emoji width, no
// per-channel line or mention rules.
// phi^2 + 1/phi^2 = 3 | TRINITY

module post_caption;

pub const ID : str = "post-caption";
pub const VERSION : u8 = 1;

// The channels this spec knows. Any other value is unknown and is refused, never guessed.
pub const CH_X : u8 = 0;
pub const CH_TELEGRAM : u8 = 1;
pub const CH_INSTAGRAM : u8 = 2;

// X counts every link as this many characters, whatever the link's real length.
pub const X_LINK_COST : u16 = 23;

// The channel's caption limit in ASCII bytes; 0 for a channel this spec does not know.
pub fn max_caption_len(ch: u8) -> u16 {
    if (ch == CH_X) { return 280; }
    if (ch == CH_TELEGRAM) { return 1024; }
    if (ch == CH_INSTAGRAM) { return 2200; }
    return 0;
}

// The house cap on hashtags; 0 for a channel this spec does not know.
pub fn max_hashtags(ch: u8) -> u8 {
    if (ch == CH_X) { return 2; }
    if (ch == CH_TELEGRAM) { return 3; }
    if (ch == CH_INSTAGRAM) { return 5; }
    return 0;
}

// The length a channel weighs: X swaps the link bytes it will rewrite for 23 each; every other
// channel weighs the bytes as they are.
pub fn weighted_len(ch: u8, bytes: u16, links: u8, link_bytes: u16) -> u16 {
    if (ch == CH_X) {
        return bytes - link_bytes + X_LINK_COST * @as(u16, links);
    }
    return bytes;
}

// Whether a caption fits: its weighted length within the channel's limit and its hashtags within the
// cap. An unknown channel is refused, so a caller that passes a channel number this spec lacks is
// told no rather than guessing.
pub fn caption_ok(ch: u8, bytes: u16, links: u8, link_bytes: u16, hashtags: u8) -> bool {
    const limit = max_caption_len(ch);
    const cap = max_hashtags(ch);
    if (limit == 0 || cap == 0) { return false; }
    return weighted_len(ch, bytes, links, link_bytes) <= limit && hashtags <= cap;
}

// ---- tests ----

test "a 270-byte caption with no link fits X" {
    assert(max_caption_len(CH_X) == 280);
    assert(caption_ok(CH_X, 270, 0, 0, 0) == true);
}

test "X weighs one 40-byte link as 23, so 260 bytes weigh 243 and fit" {
    assert(weighted_len(CH_X, 260, 1, 40) == 243);
    assert(caption_ok(CH_X, 260, 1, 40, 0) == true);
    assert(weighted_len(CH_X, 260, 0, 0) == 260);
}

test "three hashtags are refused on X, which allows two" {
    assert(max_hashtags(CH_X) == 2);
    assert(caption_ok(CH_X, 100, 0, 0, 2) == true);
    assert(caption_ok(CH_X, 100, 0, 0, 3) == false);
}

test "an unknown channel answers 0 or false, never a guess" {
    assert(max_caption_len(9) == 0);
    assert(max_hashtags(9) == 0);
    assert(weighted_len(9, 100, 0, 0) == 100);
    assert(caption_ok(9, 100, 0, 0, 0) == false);
    assert(caption_ok(9, 0, 0, 0, 0) == false);
}

test "the caption limits and hashtag caps are the published ones, and their boundaries" {
    assert(max_caption_len(CH_TELEGRAM) == 1024);
    assert(max_caption_len(CH_INSTAGRAM) == 2200);
    assert(max_hashtags(CH_TELEGRAM) == 3);
    assert(max_hashtags(CH_INSTAGRAM) == 5);
    assert(caption_ok(CH_X, 280, 0, 0, 0) == true);
    assert(caption_ok(CH_X, 281, 0, 0, 0) == false);
    assert(caption_ok(CH_INSTAGRAM, 2200, 0, 0, 0) == true);
    assert(caption_ok(CH_INSTAGRAM, 2201, 0, 0, 0) == false);
    assert(caption_ok(CH_TELEGRAM, 1024, 0, 0, 3) == true);
    assert(caption_ok(CH_TELEGRAM, 1025, 0, 0, 3) == false);
    assert(weighted_len(CH_TELEGRAM, 900, 2, 80) == 900);
    assert(weighted_len(CH_INSTAGRAM, 900, 2, 80) == 900);
}

invariant an_unknown_channel_is_refused {
    assert(max_caption_len(3) == 0);
    assert(max_hashtags(3) == 0);
    assert(caption_ok(3, 1, 0, 0, 0) == false);
    assert(caption_ok(255, 1, 0, 0, 0) == false);
}
