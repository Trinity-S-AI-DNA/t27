// SPDX-License-Identifier: Apache-2.0
// specs/t27f/reel_factory_plan.t27 -- prints the content factory's plan for course 0, one
// tab-separated row per lesson. Issue gHashTag/t27#10573, epic gHashTag/t27#10560.
//
// WHY: reel_factory.t27 decides every lesson's scene, but the plan lived only inside its tests.
// Its first version printed from a main, and t27b refused that main on std.debug.print, so the
// main was dropped. t27b now lowers print with a literal format of {d} and {s} (#10455), so the
// printer lives here, apart from the law it reads. reel_factory.t27 stays a module of decisions
// and nothing else, and this module only reads it out.
//
// HOW (main): t27c gen specs/t27f/reel_factory_plan.t27 > plan.zig, then run plan.zig with zig.
// It prints a header, 27 rows of
//   lesson  scene  accent  motion  layout  slides  title
// and one summary line: how many of the twelve scenes are used, and the most uses of any one.
// Every name is read out of the factory's own comma lists (ARCH_NAMES, ACCENT_NAMES,
// MOTION_NAMES, LAYOUT_NAMES), so a renamed scene cannot drift between the law and its printout.
//
// NOT CLAIMED:
// - A title byte outside printable ASCII prints as '?'. The English titles of course 0 are ASCII
//   today, and the tests check that, but the printer does not encode UTF-8.
// - The printout is a reading of arche(), not a second decision. Each row calls arche(t), which
//   plans the whole course again. That is 27 plans, cheap at 27 lessons, and a cost to revisit
//   if a course grows to hundreds of items.

module reel_factory_plan;

use t27f::reel_topics::TOPICS;
use t27f::reel_topics::item;
use t27f::reel_topics::item_len;
use t27f::reel_topics::cp;
use t27f::reel_factory::ARCHS;
use t27f::reel_factory::ARCH_CAP;
use t27f::reel_factory::ARCH_NAMES;
use t27f::reel_factory::ACCENTS;
use t27f::reel_factory::ACCENT_NAMES;
use t27f::reel_factory::MOTIONS;
use t27f::reel_factory::MOTION_NAMES;
use t27f::reel_factory::LAYOUTS;
use t27f::reel_factory::LAYOUT_NAMES;
use t27f::reel_factory::A_TRIT;
use t27f::reel_factory::arche;
use t27f::reel_factory::accent;
use t27f::reel_factory::motion;
use t27f::reel_factory::layout;
use t27f::reel_factory::carousel_slides;

pub const TITLE_MAX : usize = 48;
pub const COMMA : u8 = 44;
pub const UNPRINTABLE : u8 = 63;

// ---- names ----

// Where field k of a comma-separated list begins; names.len when the list has k fields or fewer.
pub fn field_start(names: []const u8, k: usize) -> usize {
    var p : usize = 0;
    var seen : usize = 0;
    while (p < names.len && seen < k) {
        if (names[p] == COMMA) {
            seen = seen + 1;
        }
        p = p + 1;
    }
    return p;
}

// One past the last byte of field k.
pub fn field_end(names: []const u8, k: usize) -> usize {
    var p = field_start(names, k);
    while (p < names.len && names[p] != COMMA) {
        p = p + 1;
    }
    return p;
}

// How many fields a comma-separated list has.
pub fn fields(names: []const u8) -> usize {
    var n : usize = 1;
    var p : usize = 0;
    while (p < names.len) {
        if (names[p] == COMMA) {
            n = n + 1;
        }
        p = p + 1;
    }
    return n;
}

// ---- titles ----

// How many bytes of lesson t's English title the printout shows.
pub fn title_n(t: usize) -> usize {
    const n = item_len(item(t, 0, 0));
    if (n > TITLE_MAX) {
        return TITLE_MAX;
    }
    return n;
}

// Byte k of lesson t's English title, or UNPRINTABLE for a code point outside printable ASCII.
pub fn title_byte(t: usize, k: usize) -> u8 {
    const c = cp(item(t, 0, 0), k);
    if (c < 32 || c > 126) {
        return UNPRINTABLE;
    }
    return @as(u8, @intCast(c));
}

// ---- main ----

pub fn main() -> void {
    var used : [12]usize = undefined;
    var a : usize = 0;
    while (a < ARCHS) {
        used[a] = 0;
        a = a + 1;
    }
    std.debug.print("lesson\tscene\taccent\tmotion\tlayout\tslides\ttitle\n", .{});
    var t : usize = 0;
    while (t < TOPICS) {
        const s = arche(t);
        used[s] = used[s] + 1;
        const c = accent(t);
        const m = motion(t);
        const y = layout(t);
        var buf : [48]u8 = undefined;
        const n = title_n(t);
        var k : usize = 0;
        while (k < n) {
            buf[k] = title_byte(t, k);
            k = k + 1;
        }
        std.debug.print("{d}\t{s}\t{s}\t{s}\t{s}\t{d}\t{s}\n", .{ t, ARCH_NAMES[field_start(ARCH_NAMES, s)..field_end(ARCH_NAMES, s)], ACCENT_NAMES[field_start(ACCENT_NAMES, c)..field_end(ACCENT_NAMES, c)], MOTION_NAMES[field_start(MOTION_NAMES, m)..field_end(MOTION_NAMES, m)], LAYOUT_NAMES[field_start(LAYOUT_NAMES, y)..field_end(LAYOUT_NAMES, y)], carousel_slides(t), buf[0..n] });
        t = t + 1;
    }
    var kinds : usize = 0;
    var most : usize = 0;
    a = 0;
    while (a < ARCHS) {
        if (used[a] > 0) {
            kinds = kinds + 1;
        }
        if (used[a] > most) {
            most = used[a];
        }
        a = a + 1;
    }
    std.debug.print("{d} of {d} scenes used, the most used one {d} times (cap {d})\n", .{ kinds, ARCHS, most, ARCH_CAP });
}

// ---- tests ----

test "a comma list reads field by field, first, middle and last" {
    assert(field_start(ARCH_NAMES, 0) == 0);
    assert(field_end(ARCH_NAMES, 0) == 4);
    assert(ARCH_NAMES[field_start(ARCH_NAMES, 3)] == 116);
    assert(field_end(ARCH_NAMES, 3) - field_start(ARCH_NAMES, 3) == 4);
    assert(field_end(ARCH_NAMES, ARCHS - 1) == ARCH_NAMES.len);
    assert(field_end(ARCH_NAMES, ARCHS - 1) - field_start(ARCH_NAMES, ARCHS - 1) == 3);
    assert(field_start(ARCH_NAMES, ARCHS) == ARCH_NAMES.len);
    assert(ACCENT_NAMES[field_start(ACCENT_NAMES, ACCENTS - 1)] == 119);
}

test "every list has exactly as many names as the factory has kinds" {
    assert(fields(ARCH_NAMES) == ARCHS);
    assert(fields(ACCENT_NAMES) == ACCENTS);
    assert(fields(MOTION_NAMES) == MOTIONS);
    assert(fields(LAYOUT_NAMES) == LAYOUTS);
    var k : usize = 0;
    while (k < ARCHS) {
        assert(field_end(ARCH_NAMES, k) > field_start(ARCH_NAMES, k));
        k = k + 1;
    }
}

test "every lesson's title prints, ASCII and within the width" {
    var t : usize = 0;
    while (t < TOPICS) {
        const n = title_n(t);
        assert(n > 0);
        assert(n <= TITLE_MAX);
        var k : usize = 0;
        while (k < n) {
            assert(title_byte(t, k) != UNPRINTABLE);
            k = k + 1;
        }
        t = t + 1;
    }
}

test "the printed scene of the trits lesson is the word trit" {
    const s = arche(7);
    assert(s == A_TRIT);
    const b = field_start(ARCH_NAMES, s);
    assert(field_end(ARCH_NAMES, s) - b == 4);
    assert(ARCH_NAMES[b] == 116);
    assert(ARCH_NAMES[b + 1] == 114);
    assert(ARCH_NAMES[b + 2] == 105);
    assert(ARCH_NAMES[b + 3] == 116);
}
