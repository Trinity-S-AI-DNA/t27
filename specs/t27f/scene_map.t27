// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_map.t27 -- scene A_MAP of reel_factory.t27: the course map. Nine modules of
// three lessons make 27 cells; the lesson's own cell is lit solid in the accent with its number,
// the cells before it are done (a quarter of the accent), the cells after it are dark and each a
// shade of its own.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: a map says where you are. Every lesson sits at a different cell and has a different amount
// of the course behind it, so the 27 maps differ in where the light is and how much of the grid is
// tinted.
//
// THE FUNCTION: map_px(t, acc, n, x, y) is the colour of canvas point (x, y). Cell (row, col)
// is 96 x 48 at x = 26 + 104 * col, y = 60 + 62 * row; its number is row * 3 + col + 1.
//
// NOT CLAIMED: the map is the course's shape, 9 x 3; it knows no module titles.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_map;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::num_on;
use t27f::scene_raster::rnd;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;

pub const MX0 : i32 = 26;
pub const MY0 : i32 = 60;
pub const MPX : i32 = 104;
pub const MPY : i32 = 62;
pub const MW : i32 = 96;
pub const MH : i32 = 48;
pub const MROWS : i32 = 9;
pub const MCOLS : i32 = 3;

// The cell, 0..26, that lesson t sits in.
pub fn cell_of(t: usize) -> i32 {
    return @as(i32, @intCast(t));
}
// The shade of an unlit cell: a dark grey that depends on the lesson and on the cell.
pub fn shade(t: usize, c: i32) -> i32 {
    return 18 + rnd(@as(i32, @intCast(t)) * 211 + c * 17 + 3, 10) * 5;
}

pub fn map_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(5, acc, seed_of(t, n, 11), x, y);
    if (x < MX0 || y < MY0) { return c0; }
    const col = @divTrunc(x - MX0, MPX);
    const row = @divTrunc(y - MY0, MPY);
    if (col >= MCOLS || row >= MROWS) { return c0; }
    const cx0 = MX0 + col * MPX;
    const cy0 = MY0 + row * MPY;
    if (!in_rect(x, y, cx0, cy0, cx0 + MW, cy0 + MH)) { return c0; }
    const c = row * MCOLS + col;
    const mine = cell_of(t);
    if (num_on(c + 1, x, y, cx0 + 8, cy0 + 8, 4)) {
        if (c == mine) { return rgb(10, 12, 24); }
        return rgb(200, 206, 226);
    }
    if (c == mine) { return acc; }
    if (c < mine) { return mix(rgb(10, 12, 24), acc, 70); }
    const g = shade(t, c);
    return rgb(g, g + 2, g + 10);
}

// ---- tests ----

test "the lesson's cell is its place on the 9 x 3 course map" {
    assert(cell_of(0) == 0);
    assert(cell_of(1) == 1);
    assert(cell_of(3) == 3);
    assert(cell_of(26) == 26);
    var t : usize = 0;
    while (t < 27) {
        assert(cell_of(t) == @as(i32, @intCast(t)));
        t = t + 1;
    }
}

test "the cell is lit, the cells before it are tinted, the cells after are dark" {
    const acc = 0x3B82F6;
    // lesson 13 is cell 13: row 4, column 1. Probe a plain corner of three cells.
    const lit = map_px(13, acc, 3, MX0 + 1 * MPX + 90, MY0 + 4 * MPY + 40);
    const done = map_px(13, acc, 3, MX0 + 0 * MPX + 90, MY0 + 4 * MPY + 40);
    const todo = map_px(13, acc, 3, MX0 + 2 * MPX + 90, MY0 + 4 * MPY + 40);
    assert(lit == acc);
    assert(done != acc);
    assert(todo != acc);
    assert(done != todo);
}

test "another lesson lights another cell" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = map_px(5, 0xF5B700, 2, x, y);
            const b = map_px(22, 0xF5B700, 2, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 2;
        }
        y = y + 2;
    }
    assert(diff > 20000);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (map_px(20, 0x8B5CF6, 4, x, y) != map_px(20, 0x8B5CF6, 4, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
