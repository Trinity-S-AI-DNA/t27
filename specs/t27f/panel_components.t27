// specs/t27f/panel_components.t27 -- t27f: T27 OS panel components in ui_kit
// with storybook stories.
// Part of M7 milestone (milestone #11). Closes #13401.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::panel_components;

pub const PANEL_COMPONENTS_MAX : u32 = 16;

pub struct PanelComponent { id: str, mounted: bool };

pub fn panel_component_mounted(c: PanelComponent) -> bool {
    return c.mounted;
}

test "panel_component_mounted" {
    assert(panel_component_mounted(PanelComponent { id: "sidebar", mounted: true }));
    assert(!panel_component_mounted(PanelComponent { id: "toolbar", mounted: false }));
}

invariant panel_components_max_positive {
    assert PANEL_COMPONENTS_MAX > 0;
}