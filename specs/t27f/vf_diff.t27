// SPDX-License-Identifier: Apache-2.0
; T27F-007 visual loop: vf_diff compares two RGB frames of one size and reports how they differ, as plain integers
; Refs gHashTag/t27#13214, epic #13214
; The visual loop shows before, after and diff on every iteration, and the diff is more than a raw pixel count:
; changed pixels, the share of them, mean absolute difference, PSNR, the grid cells that moved, the bounding box of the change and a perceptual hash
; These are MEASUREMENTS OF A DIFFERENCE, NOT a verdict of visual correctness: a human or a VLM still judges the frames
; A low number does not say the frame is right, a high number does not say it is wrong, and no function here decides pass or fail
; A frame is the buffer vf_render_rgb fills: []u8, row by row, top row first, 3 bytes per pixel in the order R, G, B, w * h * 3 bytes in all
; vf_render exposes no width or height constant (only the 216000-byte test raster VF_T_RGB), so a frame is a buffer plus w and h, as there
; Reads no spec and edits none; it reads two buffers and writes nothing, only the test buffers VD_A and VD_B below are written, by the tests
; Limits: w and h each in 1..4096 and w * h at most 4000000 so that every u32 sum below fits; a smaller buffer than w * h * 3 is refused
; A refused input makes every measure return 0 and read nothing: that is "not measured", not "no change", so a caller asks vd_valid first
; The hash is 8 x 8 blocks and needs w and h of at least 8, below that it is 0 and means "not hashed"
; The hash is two u32 halves (hi = block rows 0..3, lo = block rows 4..7) and vd_hamming takes both pairs: u64 would need shifts and xor
; The hash and popcount use only + * / % so they run the same on every backend
; PSNR uses f64 and @log only here: 10 * log10(r) = 10 * ln(r) / ln(10), the same form token_floor.t27 uses for log10
; All arithmetic is u32 and non-negative: compare before subtracting

module t27f_vf_diff;

; the limits of a frame: each side up to 4096, w * h up to 4000000
pub const VD_MAX_SIDE : u32 = 4096;
pub const VD_MAX_PIXELS : u32 = 4000000;

; PSNR of identical frames, and the cap for any frame that comes close to it (about 100 dB)
pub const VD_PSNR_SAME : u32 = 9999;

; test frames: 16 x 16 x 3 = 768 bytes holds the 16 x 16 frame and the first 192 bytes the 8 x 8 one
pub var VD_A : [768]u8 = [0] ** 768;
pub var VD_B : [768]u8 = [0] ** 768;

; |a - b| on u32: compare first, subtract the smaller
pub fn vd_abs_diff(a: u32, b: u32) -> u32 {
    if a >= b {
        return a - b;
    }
    return b - a;
}

; true when both buffers hold a w x h frame and w, h and w * h are inside the limits
pub fn vd_valid(a: []u8, b: []u8, w: u32, h: u32) -> bool {
    if w == 0 or h == 0 {
        return false;
    }
    if w > VD_MAX_SIDE or h > VD_MAX_SIDE {
        return false;
    }
    if w * h > VD_MAX_PIXELS {
        return false;
    }
    var need : u32 = w * h * 3;
    if need > (a.len as u32) {
        return false;
    }
    if need > (b.len as u32) {
        return false;
    }
    return true;
}

; true when the two frames have one size
pub fn vd_same_size(w1: u32, h1: u32, w2: u32, h2: u32) -> bool {
    return w1 == w2 and h1 == h2;
}

; the colour distance of pixel (x, y): |dR| + |dG| + |dB|, 0..765; x < w and y < h of a frame vd_valid accepted
pub fn vd_pixel_delta(a: []u8, b: []u8, w: u32, x: u32, y: u32) -> u32 {
    var at : usize = ((y * w + x) * 3) as usize;
    var dr : u32 = vd_abs_diff(a[at] as u32, b[at] as u32);
    var dg : u32 = vd_abs_diff(a[at + 1] as u32, b[at + 1] as u32);
    var db : u32 = vd_abs_diff(a[at + 2] as u32, b[at + 2] as u32);
    return dr + dg + db;
}

; how many pixels of x0 <= x < x1 and y0 <= y < y1 have a delta over threshold; the caller has checked vd_valid
fn vd_count_rect(a: []u8, b: []u8, w: u32, x0: u32, x1: u32, y0: u32, y1: u32, threshold: u32) -> u32 {
    var cnt : u32 = 0;
    var y : u32 = y0;
    while y < y1 {
        var x : u32 = x0;
        while x < x1 {
            if vd_pixel_delta(a, b, w, x, y) > threshold {
                cnt = cnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return cnt;
}

; pixels whose delta is over threshold; threshold 0 counts any change
pub fn vd_changed_pixels(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    return vd_count_rect(a, b, w, 0, w, 0, h, threshold);
}

; changed pixels per thousand, rounded down; an empty or refused frame gives 0
pub fn vd_changed_permille(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if w == 0 or h == 0 {
        return 0;
    }
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var n : u32 = w * h;
    var ch : u32 = vd_count_rect(a, b, w, 0, w, 0, h, threshold);
    return (ch / n) * 1000 + ((ch % n) * 1000) / n;
}

; the sum of |a - b| over every byte of the frame, 0..765 per pixel
pub fn vd_sad(a: []u8, b: []u8, w: u32, h: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var need : u32 = w * h * 3;
    var sum : u32 = 0;
    var i : u32 = 0;
    while i < need {
        sum = sum + vd_abs_diff(a[i as usize] as u32, b[i as usize] as u32);
        i = i + 1;
    }
    return sum;
}

; mean absolute difference per channel, times 100, rounded down: 0 for equal frames, 25500 for black against white
pub fn vd_mad_x100(a: []u8, b: []u8, w: u32, h: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var d : u32 = w * h * 3;
    var sum : u32 = vd_sad(a, b, w, h);
    return (sum / d) * 100 + ((sum % d) * 100) / d;
}

; PSNR in hundredths of a dB: 10 * log10(255 * 255 / mse) * 100 with mse the mean squared difference per channel
; equal frames give 9999, black against white gives 0, a refused input gives 0, and nothing is above 9999
pub fn vd_psnr_cdb(a: []u8, b: []u8, w: u32, h: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var need : u32 = w * h * 3;
    var sse : f64 = 0.0;
    var i : u32 = 0;
    while i < need {
        var d : u32 = vd_abs_diff(a[i as usize] as u32, b[i as usize] as u32);
        sse = sse + ((d * d) as f64);
        i = i + 1;
    }
    if sse == 0.0 {
        return VD_PSNR_SAME;
    }
    var ratio : f64 = 65025.0 * (need as f64) / sse;
    if ratio <= 1.0 {
        return 0;
    }
    var cdb : u32 = @as(u32, @intFromFloat(@floor(1000.0 * @log(ratio) / @log(10.0))));
    if cdb > VD_PSNR_SAME {
        return VD_PSNR_SAME;
    }
    return cdb;
}

; the first pixel index of cell k when n pixels are split into cols cells: x belongs to cell x * cols / n
fn vd_cell_lo(k: u32, n: u32, cols: u32) -> u32 {
    return (k * n + cols - 1) / cols;
}

; changed pixels inside grid cell (rx, ry) of a cols x rows grid laid over the frame; a cell outside the grid or a grid over 4096 gives 0
pub fn vd_region_changed(a: []u8, b: []u8, w: u32, h: u32, cols: u32, rows: u32, rx: u32, ry: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    if cols == 0 or rows == 0 {
        return 0;
    }
    if cols > VD_MAX_SIDE or rows > VD_MAX_SIDE {
        return 0;
    }
    if rx >= cols or ry >= rows {
        return 0;
    }
    var x0 : u32 = vd_cell_lo(rx, w, cols);
    var x1 : u32 = vd_cell_lo(rx + 1, w, cols);
    var y0 : u32 = vd_cell_lo(ry, h, rows);
    var y1 : u32 = vd_cell_lo(ry + 1, h, rows);
    return vd_count_rect(a, b, w, x0, x1, y0, y1, threshold);
}

; how many cells of the grid hold at least one changed pixel
pub fn vd_regions_touched(a: []u8, b: []u8, w: u32, h: u32, cols: u32, rows: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    if cols == 0 or rows == 0 {
        return 0;
    }
    if cols > VD_MAX_SIDE or rows > VD_MAX_SIDE {
        return 0;
    }
    var touched : u32 = 0;
    var ry : u32 = 0;
    while ry < rows {
        var rx : u32 = 0;
        while rx < cols {
            if vd_region_changed(a, b, w, h, cols, rows, rx, ry, threshold) > 0 {
                touched = touched + 1;
            }
            rx = rx + 1;
        }
        ry = ry + 1;
    }
    return touched;
}

; true when some pixel of column x has a delta over threshold
fn vd_col_changed(a: []u8, b: []u8, w: u32, h: u32, x: u32, threshold: u32) -> bool {
    var y : u32 = 0;
    while y < h {
        if vd_pixel_delta(a, b, w, x, y) > threshold {
            return true;
        }
        y = y + 1;
    }
    return false;
}

; true when some pixel of row y has a delta over threshold
fn vd_row_changed(a: []u8, b: []u8, w: u32, y: u32, threshold: u32) -> bool {
    var x : u32 = 0;
    while x < w {
        if vd_pixel_delta(a, b, w, x, y) > threshold {
            return true;
        }
        x = x + 1;
    }
    return false;
}

; the bounding box of every changed pixel: x0 and y0 are the first changed column and row, x1 and y1 one past the last; no change gives all four 0
pub fn vd_bbox_x0(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var x : u32 = 0;
    while x < w {
        if vd_col_changed(a, b, w, h, x, threshold) {
            return x;
        }
        x = x + 1;
    }
    return 0;
}

pub fn vd_bbox_x1(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var x : u32 = w;
    while x > 0 {
        if vd_col_changed(a, b, w, h, x - 1, threshold) {
            return x;
        }
        x = x - 1;
    }
    return 0;
}

pub fn vd_bbox_y0(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var y : u32 = 0;
    while y < h {
        if vd_row_changed(a, b, w, y, threshold) {
            return y;
        }
        y = y + 1;
    }
    return 0;
}

pub fn vd_bbox_y1(a: []u8, b: []u8, w: u32, h: u32, threshold: u32) -> u32 {
    if vd_valid(a, b, w, h) == false {
        return 0;
    }
    var y : u32 = h;
    while y > 0 {
        if vd_row_changed(a, b, w, y - 1, threshold) {
            return y;
        }
        y = y - 1;
    }
    return 0;
}

; luma of pixel (x, y), 0..255: (r * 299 + g * 587 + b * 114) / 1000
pub fn vd_luma(buf: []u8, w: u32, x: u32, y: u32) -> u32 {
    var at : usize = ((y * w + x) * 3) as usize;
    var r : u32 = buf[at] as u32;
    var gr : u32 = buf[at + 1] as u32;
    var b : u32 = buf[at + 2] as u32;
    return (r * 299 + gr * 587 + b * 114) / 1000;
}

; the sum of luma over x0 <= x < x1 and y0 <= y < y1
fn vd_luma_sum(buf: []u8, w: u32, x0: u32, x1: u32, y0: u32, y1: u32) -> u32 {
    var sum : u32 = 0;
    var y : u32 = y0;
    while y < y1 {
        var x : u32 = x0;
        while x < x1 {
            sum = sum + vd_luma(buf, w, x, y);
            x = x + 1;
        }
        y = y + 1;
    }
    return sum;
}

; sum / cnt in sixteenths, rounded down, without overflowing u32
pub fn vd_mean16(sum: u32, cnt: u32) -> u32 {
    if cnt == 0 {
        return 0;
    }
    return (sum / cnt) * 16 + ((sum % cnt) * 16) / cnt;
}

; 32 hash bits of the 8 x 8 average hash, block rows first_row .. first_row + 3, most significant bit first
; a block is 1 when its mean luma is at least the mean luma of the whole frame
fn vd_ahash_half(buf: []u8, w: u32, h: u32, first_row: u32) -> u32 {
    if w < 8 or h < 8 {
        return 0;
    }
    if w > VD_MAX_SIDE or h > VD_MAX_SIDE {
        return 0;
    }
    if w * h > VD_MAX_PIXELS {
        return 0;
    }
    if w * h * 3 > (buf.len as u32) {
        return 0;
    }
    var whole : u32 = vd_mean16(vd_luma_sum(buf, w, 0, w, 0, h), w * h);
    var acc : u32 = 0;
    var by : u32 = first_row;
    while by < first_row + 4 {
        var y0 : u32 = by * h / 8;
        var y1 : u32 = (by + 1) * h / 8;
        var bx : u32 = 0;
        while bx < 8 {
            var x0 : u32 = bx * w / 8;
            var x1 : u32 = (bx + 1) * w / 8;
            var m : u32 = vd_mean16(vd_luma_sum(buf, w, x0, x1, y0, y1), (x1 - x0) * (y1 - y0));
            var bit : u32 = 0;
            if m >= whole {
                bit = 1;
            }
            acc = acc * 2 + bit;
            bx = bx + 1;
        }
        by = by + 1;
    }
    return acc;
}

; the high 32 bits of the average hash: block rows 0..3
pub fn vd_ahash_hi(buf: []u8, w: u32, h: u32) -> u32 {
    return vd_ahash_half(buf, w, h, 0);
}

; the low 32 bits of the average hash: block rows 4..7
pub fn vd_ahash_lo(buf: []u8, w: u32, h: u32) -> u32 {
    return vd_ahash_half(buf, w, h, 4);
}

; how many of the 32 bits of a and b differ, by halving: no shift or xor needed
pub fn vd_popxor32(a: u32, b: u32) -> u32 {
    var x : u32 = a;
    var y : u32 = b;
    var n : u32 = 0;
    var i : u32 = 0;
    while i < 32 {
        if (x % 2) != (y % 2) {
            n = n + 1;
        }
        x = x / 2;
        y = y / 2;
        i = i + 1;
    }
    return n;
}

; the Hamming distance of two 64-bit hashes given as (hi, lo) pairs: 0 equal, 64 every bit apart
pub fn vd_hamming(a_hi: u32, a_lo: u32, b_hi: u32, b_lo: u32) -> u32 {
    return vd_popxor32(a_hi, b_hi) + vd_popxor32(a_lo, b_lo);
}

; test helper: set the first n bytes of buf to v
fn vd_t_fill(buf: []u8, n: u32, v: u32) -> void {
    var i : u32 = 0;
    while i < n {
        buf[i as usize] = v as u8;
        i = i + 1;
    }
}

; test helper: set pixel (x, y) of a frame w wide to (r, gr, b)
fn vd_t_put(buf: []u8, w: u32, x: u32, y: u32, r: u32, gr: u32, b: u32) -> void {
    var at : usize = ((y * w + x) * 3) as usize;
    buf[at] = r as u8;
    buf[at + 1] = gr as u8;
    buf[at + 2] = b as u8;
}

; test helper: grey v over x0 <= x < x1 and y0 <= y < y1 of a frame w wide
fn vd_t_rect(buf: []u8, w: u32, x0: u32, x1: u32, y0: u32, y1: u32, v: u32) -> void {
    var y : u32 = y0;
    while y < y1 {
        var x : u32 = x0;
        while x < x1 {
            vd_t_put(buf, w, x, y, v, v, v);
            x = x + 1;
        }
        y = y + 1;
    }
}

test identical_frames_measure_nothing {
    vd_t_fill(&VD_A, 192, 0);
    vd_t_fill(&VD_B, 192, 0);
    vd_t_put(&VD_A, 8, 2, 2, 200, 100, 50);
    vd_t_put(&VD_B, 8, 2, 2, 200, 100, 50);
    assert vd_valid(&VD_A, &VD_B, 8, 8);
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_changed_permille(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_sad(&VD_A, &VD_B, 8, 8) == 0;
    assert vd_mad_x100(&VD_A, &VD_B, 8, 8) == 0;
    assert vd_psnr_cdb(&VD_A, &VD_B, 8, 8) == 9999;
    assert vd_bbox_x0(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_bbox_x1(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_bbox_y0(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_bbox_y1(&VD_A, &VD_B, 8, 8, 0) == 0;
    assert vd_regions_touched(&VD_A, &VD_B, 8, 8, 2, 2, 0) == 0;
    var ha_hi : u32 = vd_ahash_hi(&VD_A, 8, 8);
    var ha_lo : u32 = vd_ahash_lo(&VD_A, 8, 8);
    var hb_hi : u32 = vd_ahash_hi(&VD_B, 8, 8);
    var hb_lo : u32 = vd_ahash_lo(&VD_B, 8, 8);
    assert vd_hamming(ha_hi, ha_lo, hb_hi, hb_lo) == 0;
}

test one_pixel_changed {
    vd_t_fill(&VD_A, 192, 0);
    vd_t_fill(&VD_B, 192, 0);
    vd_t_put(&VD_B, 8, 3, 5, 10, 20, 30);
    assert vd_pixel_delta(&VD_A, &VD_B, 8, 3, 5) == 60;
    assert vd_pixel_delta(&VD_B, &VD_A, 8, 3, 5) == 60;
    assert vd_pixel_delta(&VD_A, &VD_B, 8, 0, 0) == 0;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 0) == 1;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 59) == 1;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 60) == 0;
    assert vd_changed_permille(&VD_A, &VD_B, 8, 8, 0) == 15;
    assert vd_sad(&VD_A, &VD_B, 8, 8) == 60;
    assert vd_mad_x100(&VD_A, &VD_B, 8, 8) == 31;
    assert vd_bbox_x0(&VD_A, &VD_B, 8, 8, 0) == 3;
    assert vd_bbox_x1(&VD_A, &VD_B, 8, 8, 0) == 4;
    assert vd_bbox_y0(&VD_A, &VD_B, 8, 8, 0) == 5;
    assert vd_bbox_y1(&VD_A, &VD_B, 8, 8, 0) == 6;
    assert vd_regions_touched(&VD_A, &VD_B, 8, 8, 2, 2, 0) == 1;
    assert vd_region_changed(&VD_A, &VD_B, 8, 8, 2, 2, 0, 1, 0) == 1;
    assert vd_region_changed(&VD_A, &VD_B, 8, 8, 2, 2, 0, 0, 0) == 0;
    assert vd_region_changed(&VD_A, &VD_B, 8, 8, 2, 2, 1, 0, 0) == 0;
    assert vd_region_changed(&VD_A, &VD_B, 8, 8, 2, 2, 1, 1, 0) == 0;
}

test white_block_on_black {
    vd_t_fill(&VD_A, 768, 0);
    vd_t_fill(&VD_B, 768, 0);
    vd_t_rect(&VD_B, 16, 4, 8, 4, 8, 255);
    assert vd_pixel_delta(&VD_A, &VD_B, 16, 5, 5) == 765;
    assert vd_changed_pixels(&VD_A, &VD_B, 16, 16, 0) == 16;
    assert vd_changed_pixels(&VD_A, &VD_B, 16, 16, 764) == 16;
    assert vd_changed_pixels(&VD_A, &VD_B, 16, 16, 765) == 0;
    assert vd_changed_permille(&VD_A, &VD_B, 16, 16, 0) == 62;
    assert vd_bbox_x0(&VD_A, &VD_B, 16, 16, 0) == 4;
    assert vd_bbox_x1(&VD_A, &VD_B, 16, 16, 0) == 8;
    assert vd_bbox_y0(&VD_A, &VD_B, 16, 16, 0) == 4;
    assert vd_bbox_y1(&VD_A, &VD_B, 16, 16, 0) == 8;
    assert vd_regions_touched(&VD_A, &VD_B, 16, 16, 4, 4, 0) == 1;
    assert vd_regions_touched(&VD_A, &VD_B, 16, 16, 2, 2, 0) == 1;
    assert vd_region_changed(&VD_A, &VD_B, 16, 16, 4, 4, 1, 1, 0) == 16;
    assert vd_region_changed(&VD_A, &VD_B, 16, 16, 4, 4, 0, 0, 0) == 0;
}

test block_shifted_two_pixels {
    vd_t_fill(&VD_A, 768, 0);
    vd_t_fill(&VD_B, 768, 0);
    vd_t_rect(&VD_A, 16, 4, 8, 4, 8, 255);
    vd_t_rect(&VD_B, 16, 6, 10, 4, 8, 255);
    assert vd_changed_pixels(&VD_A, &VD_B, 16, 16, 0) == 16;
    assert vd_bbox_x0(&VD_A, &VD_B, 16, 16, 0) == 4;
    assert vd_bbox_x1(&VD_A, &VD_B, 16, 16, 0) == 10;
    assert vd_bbox_y0(&VD_A, &VD_B, 16, 16, 0) == 4;
    assert vd_bbox_y1(&VD_A, &VD_B, 16, 16, 0) == 8;
    assert vd_regions_touched(&VD_A, &VD_B, 16, 16, 4, 4, 0) == 2;
    assert vd_region_changed(&VD_A, &VD_B, 16, 16, 4, 4, 1, 1, 0) == 8;
    assert vd_region_changed(&VD_A, &VD_B, 16, 16, 4, 4, 2, 1, 0) == 8;
}

test average_hash {
    vd_t_fill(&VD_A, 768, 0);
    vd_t_rect(&VD_A, 16, 0, 8, 0, 16, 255);
    vd_t_fill(&VD_B, 768, 0);
    vd_t_rect(&VD_B, 16, 8, 16, 0, 16, 255);
    assert vd_ahash_hi(&VD_A, 16, 16) == 4042322160;
    assert vd_ahash_lo(&VD_A, 16, 16) == 4042322160;
    assert vd_ahash_hi(&VD_B, 16, 16) == 252645135;
    assert vd_ahash_lo(&VD_B, 16, 16) == 252645135;
    var a_hi : u32 = vd_ahash_hi(&VD_A, 16, 16);
    var a_lo : u32 = vd_ahash_lo(&VD_A, 16, 16);
    var b_hi : u32 = vd_ahash_hi(&VD_B, 16, 16);
    var b_lo : u32 = vd_ahash_lo(&VD_B, 16, 16);
    assert vd_hamming(a_hi, a_lo, b_hi, b_lo) == 64;
    assert vd_hamming(a_hi, a_lo, a_hi, a_lo) == 0;
    vd_t_fill(&VD_B, 768, 0);
    vd_t_rect(&VD_B, 16, 0, 8, 0, 16, 255);
    vd_t_put(&VD_B, 16, 3, 5, 0, 0, 0);
    var c_hi : u32 = vd_ahash_hi(&VD_B, 16, 16);
    var c_lo : u32 = vd_ahash_lo(&VD_B, 16, 16);
    assert vd_hamming(a_hi, a_lo, c_hi, c_lo) <= 1;
}

test mean_difference_and_psnr {
    vd_t_fill(&VD_A, 192, 0);
    vd_t_fill(&VD_B, 192, 1);
    assert vd_mad_x100(&VD_A, &VD_B, 8, 8) == 100;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 0) == 64;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 2) == 64;
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 3) == 0;
    assert vd_psnr_cdb(&VD_A, &VD_B, 8, 8) == 4813;
    vd_t_fill(&VD_B, 192, 255);
    assert vd_mad_x100(&VD_A, &VD_B, 8, 8) == 25500;
    assert vd_changed_permille(&VD_A, &VD_B, 8, 8, 0) == 1000;
    assert vd_psnr_cdb(&VD_A, &VD_B, 8, 8) == 0;
}

test changed_and_refused_frames_are_not_zero {
    vd_t_fill(&VD_A, 192, 0);
    vd_t_fill(&VD_B, 192, 0);
    vd_t_put(&VD_B, 8, 7, 7, 255, 255, 255);
    assert vd_changed_pixels(&VD_A, &VD_B, 8, 8, 0) != 0;
    assert vd_same_size(8, 8, 8, 9) == false;
    assert vd_same_size(8, 8, 9, 8) == false;
    assert vd_same_size(8, 8, 8, 8);
    var small : [10]u8 = [0; 10];
    assert vd_valid(&small, &VD_B, 8, 8) == false;
    assert vd_valid(&VD_A, &small, 8, 8) == false;
    assert vd_valid(&VD_A, &VD_B, 0, 8) == false;
    assert vd_valid(&VD_A, &VD_B, 8, 0) == false;
    assert vd_valid(&VD_A, &VD_B, 8, 8);
    assert vd_changed_pixels(&small, &VD_B, 8, 8, 0) == 0;
    assert vd_changed_permille(&VD_A, &VD_B, 0, 0, 0) == 0;
    assert vd_regions_touched(&VD_A, &VD_B, 8, 8, 0, 2, 0) == 0;
    assert vd_regions_touched(&VD_A, &VD_B, 8, 8, 2, 2, 0) == 1;
}
