// SPDX-License-Identifier: Apache-2.0
; specs/t27f/vf_diff.t27 -- pixel diff of two RGB frames (Refs gHashTag/t27#13251, the before/after/diff of the graph-first
; UI engine). Both frames are w x h, 3 bytes per pixel, rows top first, the RGB body of a P6 file without its header.
; vf_diff_count counts the pixels whose bytes differ in any channel; vf_diff_bbox gives the smallest box that holds all of
; them; vf_diff_frame paints a third frame in which a changed pixel is pure red 0xFF0000 and an unchanged pixel is a light
; grey of its own brightness, (299 R + 587 G + 114 B) / 1000 / 4 + 192 in all three channels, so the old picture stays
; readable underneath and every change stands out against it.
; --
; Pure: no file, no allocation. Every slice must hold at least w * h * 3 bytes and w, h must lie in 1..4096 (so the byte
; offsets stay inside u32); otherwise the count is 0, the box is empty and vf_diff_frame writes nothing and says VF_D_SMALL.
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM: a count of 0 says the bytes match, not that either frame looks right.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module VfDiff;

; the box of the differing pixels, edges inclusive; any == false and all four edges 0 when nothing differs
pub struct VfDiffBox {
    any: bool,
    x0: u32,
    y0: u32,
    x1: u32,
    y1: u32,
}

; results of vf_diff_frame: ok, or a slice is too short (or w or h is 0, or w or h is over 4096)
pub const VF_D_OK : u8 = 0;
pub const VF_D_SMALL : u8 = 1;
pub const VF_D_MAX_SIDE : u32 = 4096;

; the marker colour of a changed pixel, as bytes
pub const VF_D_RED_R : u8 = 255;
pub const VF_D_RED_G : u8 = 0;
pub const VF_D_RED_B : u8 = 0;

; the test frames: 4 x 3 pixels, 4 * 3 * 3 = 36 bytes each
pub var VF_D_A : [36]u8 = [0] ** 36;
pub var VF_D_B : [36]u8 = [0] ** 36;
pub var VF_D_OUT : [36]u8 = [0] ** 36;

; true when w and h are in 1..4096 and a, b each hold w * h * 3 bytes
fn vf_diff_fits(a: []const u8, b: []const u8, w: u32, h: u32) -> bool {
    if w == 0 or h == 0 {
        return false;
    }
    if w > VF_D_MAX_SIDE or h > VF_D_MAX_SIDE {
        return false;
    }
    var need : usize = (w * h * 3) as usize;
    if a.len < need or b.len < need {
        return false;
    }
    return true;
}

; true when pixel p (counted from the top left, row by row) differs between a and b in any of its 3 bytes
fn vf_diff_px(a: []const u8, b: []const u8, p: u32) -> bool {
    var at : usize = (p * 3) as usize;
    if a[at] != b[at] {
        return true;
    }
    if a[at + 1] != b[at + 1] {
        return true;
    }
    if a[at + 2] != b[at + 2] {
        return true;
    }
    return false;
}

; the light grey of pixel p of a: its brightness (299 R + 587 G + 114 B) / 1000, divided by 4, plus 192; 192..255
fn vf_diff_grey(a: []const u8, p: u32) -> u8 {
    var at : usize = (p * 3) as usize;
    var r : u32 = a[at] as u32;
    var g : u32 = a[at + 1] as u32;
    var b : u32 = a[at + 2] as u32;
    var y : u32 = (299 * r + 587 * g + 114 * b) / 1000;
    return (y / 4 + 192) as u8;
}

; how many pixels differ between a and b in any channel
pub fn vf_diff_count(a: []const u8, b: []const u8, w: u32, h: u32) -> u32 {
    if vf_diff_fits(a, b, w, h) == false {
        return 0;
    }
    var n : u32 = w * h;
    var cnt : u32 = 0;
    var p : u32 = 0;
    while p < n {
        if vf_diff_px(a, b, p) {
            cnt = cnt + 1;
        }
        p = p + 1;
    }
    return cnt;
}

; the smallest box holding every differing pixel; rows run top first, so the bottom edge is the row of the last one found
pub fn vf_diff_bbox(a: []const u8, b: []const u8, w: u32, h: u32) -> VfDiffBox {
    var bx : VfDiffBox = VfDiffBox {
        any: false,
        x0: 0,
        y0: 0,
        x1: 0,
        y1: 0,
    };
    if vf_diff_fits(a, b, w, h) == false {
        return bx;
    }
    var y : u32 = 0;
    while y < h {
        var x : u32 = 0;
        while x < w {
            if vf_diff_px(a, b, y * w + x) {
                if bx.any == false {
                    bx.any = true;
                    bx.x0 = x;
                    bx.y0 = y;
                    bx.x1 = x;
                    bx.y1 = y;
                } else {
                    if x < bx.x0 {
                        bx.x0 = x;
                    }
                    if x > bx.x1 {
                        bx.x1 = x;
                    }
                    bx.y1 = y;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return bx;
}

; paint the diff of a and b into out: a changed pixel is 0xFF0000, an unchanged one the light grey of its brightness
pub fn vf_diff_frame(a: []const u8, b: []const u8, out: []u8, w: u32, h: u32) -> u8 {
    if vf_diff_fits(a, b, w, h) == false {
        return VF_D_SMALL;
    }
    var n : u32 = w * h;
    if out.len < (n * 3) as usize {
        return VF_D_SMALL;
    }
    var p : u32 = 0;
    while p < n {
        var at : usize = (p * 3) as usize;
        if vf_diff_px(a, b, p) {
            out[at] = VF_D_RED_R;
            out[at + 1] = VF_D_RED_G;
            out[at + 2] = VF_D_RED_B;
        } else {
            var g : u8 = vf_diff_grey(a, p);
            out[at] = g;
            out[at + 1] = g;
            out[at + 2] = g;
        }
        p = p + 1;
    }
    return VF_D_OK;
}

; set every byte of both test frames to v
fn vf_d_fill(v: u8) -> void {
    var i : usize = 0;
    while i < 36 {
        VF_D_A[i] = v;
        VF_D_B[i] = v;
        i = i + 1;
    }
}

test identical_frames_differ_nowhere {
    vf_d_fill(128);
    assert vf_diff_count(&VF_D_A, &VF_D_B, 4, 3) == 0;
    let bx : VfDiffBox = vf_diff_bbox(&VF_D_A, &VF_D_B, 4, 3);
    assert bx.any == false;
    assert bx.x0 == 0;
    assert bx.y0 == 0;
    assert bx.x1 == 0;
    assert bx.y1 == 0;
}

test one_changed_pixel_is_counted_and_boxed {
    // pixel (2, 1) is byte (1 * 4 + 2) * 3 = 18; change only its green byte
    vf_d_fill(128);
    VF_D_B[19] = 7;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 4, 3) == 1;
    let bx : VfDiffBox = vf_diff_bbox(&VF_D_A, &VF_D_B, 4, 3);
    assert bx.any == true;
    assert bx.x0 == 2;
    assert bx.y0 == 1;
    assert bx.x1 == 2;
    assert bx.y1 == 1;
}

test nc_the_last_pixel_counts {
    // negative control: only byte 35, the blue byte of pixel (3, 2), changes; a loop that stops one pixel short gives 0
    vf_d_fill(128);
    VF_D_B[35] = 129;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 4, 3) == 1;
    let bx : VfDiffBox = vf_diff_bbox(&VF_D_A, &VF_D_B, 4, 3);
    assert bx.any == true;
    assert bx.x0 == 3;
    assert bx.y0 == 2;
    assert bx.x1 == 3;
    assert bx.y1 == 2;
}

test two_changes_span_one_box {
    // pixel (3, 0) is found first, then (0, 2): the left edge must move back to 0
    vf_d_fill(128);
    VF_D_B[9] = 0;
    VF_D_B[24] = 0;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 4, 3) == 2;
    let bx : VfDiffBox = vf_diff_bbox(&VF_D_A, &VF_D_B, 4, 3);
    assert bx.any == true;
    assert bx.x0 == 0;
    assert bx.y0 == 0;
    assert bx.x1 == 3;
    assert bx.y1 == 2;
}

test the_diff_frame_marks_red_and_greys_the_rest {
    // all white; pixel 0 changes to black in b, pixel 1 is black in both, pixel 3 is pure red in both
    vf_d_fill(255);
    VF_D_B[0] = 0;
    VF_D_B[1] = 0;
    VF_D_B[2] = 0;
    VF_D_A[3] = 0;
    VF_D_A[4] = 0;
    VF_D_A[5] = 0;
    VF_D_B[3] = 0;
    VF_D_B[4] = 0;
    VF_D_B[5] = 0;
    VF_D_A[10] = 0;
    VF_D_A[11] = 0;
    VF_D_B[10] = 0;
    VF_D_B[11] = 0;
    assert vf_diff_frame(&VF_D_A, &VF_D_B, &VF_D_OUT, 4, 3) == VF_D_OK;
    // the changed pixel is 0xFF0000
    assert VF_D_OUT[0] == 255;
    assert VF_D_OUT[1] == 0;
    assert VF_D_OUT[2] == 0;
    // unchanged black: 0 / 4 + 192
    assert VF_D_OUT[3] == 192;
    assert VF_D_OUT[4] == 192;
    assert VF_D_OUT[5] == 192;
    // unchanged white: 0xFF / 4 + 192 = 63 + 192 = 255
    assert VF_D_OUT[6] == 255 / 4 + 192;
    assert VF_D_OUT[7] == 255;
    assert VF_D_OUT[8] == 255;
    // unchanged pure red is not the marker: 299 * 255 / 1000 = 76, 76 / 4 + 192 = 211
    assert VF_D_OUT[9] == 211;
    assert VF_D_OUT[10] == 211;
    assert VF_D_OUT[11] == 211;
    // the last pixel, unchanged white
    assert VF_D_OUT[35] == 255;
}

test short_slices_and_zero_sides_are_refused {
    // a 5 x 3 frame needs 45 bytes, the test frames hold 36
    vf_d_fill(128);
    VF_D_B[0] = 0;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 5, 3) == 0;
    assert vf_diff_bbox(&VF_D_A, &VF_D_B, 5, 3).any == false;
    assert vf_diff_frame(&VF_D_A, &VF_D_B, &VF_D_OUT, 5, 3) == VF_D_SMALL;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 0, 3) == 0;
    assert vf_diff_frame(&VF_D_A, &VF_D_B, &VF_D_OUT, 4, 0) == VF_D_SMALL;
    assert vf_diff_count(&VF_D_A, &VF_D_B, 4, 3) == 1;
}
