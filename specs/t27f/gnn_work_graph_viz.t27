    6, 0, 65535, 65535,
    7, 3, 65535, 65535,
    9, 65535, 65535, 65535,
    10, 65535, 65535, 65535,
    11, 65535, 65535, 65535
];
pub const GNN_HAND_DEGREE : [17]u32 = [2, 2, 2, 1, 2, 2, 3, 3, 2, 2, 4, 2, 2, 2, 1, 1, 1];

/// The panel text when no node is the subject: the web page's hint, split to the panel's width.
pub const GNN_IDLE_COUNT : u32 = 7;
pub const GNN_IDLE_LINES : [7]str = [
    "hover a node -- its k-hop neighborhood",
    "lights up, and this panel lists exactly",
    "which embeddings a k-layer GNN would",
    "gather into it.",
    "solid outlines are EXACT provenance,",
    "dashed are weaker (DERIVED or UNKNOWN).",
    "click a node to pin it; the k cells set the depth."
];

/// The pieces of the gather text, as the web page words them. Line 0 is
///   gather for KIND "name id" at k = K:
/// then, for hop 1..K, `  hop H: name, name` (or `(none)`), then
///   after K message-passing layer(s), this node's embedding
///   aggregated information from every node listed above.
pub const GNN_T_GATHER : str = "gather for ";
pub const GNN_T_AT_K : str = " at k = ";
pub const GNN_T_HOP : str = "  hop ";
pub const GNN_T_NONE : str = "(none)";
pub const GNN_T_AFTER : str = "after ";
pub const GNN_T_LAYER : str = " message-passing layer";
pub const GNN_T_PLURAL : str = "s";
pub const GNN_T_EMBED : str = ", this node's embedding";
pub const GNN_T_AGG : str = "aggregated information from every node listed above.";

pub fn gnn_node_kind(v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return GNN_NK_COUNT;
    }
    return GNN_N_KIND[v as usize];
}

pub fn gnn_node_label(v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return LABEL_UNKNOWN as u32;
    }
    return GNN_N_LABEL[v as usize];
}

/// EXACT provenance: a solid outline. DERIVED and UNKNOWN: a dashed one.
pub fn gnn_node_exact(v: u32) -> bool {
    return v < GNN_NODE_COUNT and GNN_N_LABEL[v as usize] == (LABEL_EXACT as u32);
}

pub fn gnn_node_id(v: u32) -> str {
    if (v >= GNN_NODE_COUNT) {
        return "";
    }
    return GNN_N_ID[v as usize];
}

pub fn gnn_node_name(v: u32) -> str {
    if (v >= GNN_NODE_COUNT) {
        return "";
    }
    return GNN_N_NAME[v as usize];
}

pub fn gnn_node_kind_name(v: u32) -> str {
    if (v >= GNN_NODE_COUNT) {
        return "";
    }
    return GNN_NK_NAMES[GNN_N_KIND[v as usize] as usize];
}

/// The source node of edge j, GNN_NO_NODE when j is not an edge.
pub fn gnn_edge_from(j: u32) -> u32 {
    if (j >= GNN_EDGE_COUNT) {
        return GNN_NO_NODE;
    }
    return GNN_E_FROM[j as usize];
}

/// The target node of edge j, GNN_NO_NODE when j is not an edge.
pub fn gnn_edge_to(j: u32) -> u32 {
    if (j >= GNN_EDGE_COUNT) {
        return GNN_NO_NODE;
    }
    return GNN_E_TO[j as usize];
}

pub fn gnn_edge_kind(j: u32) -> u32 {
    if (j >= GNN_EDGE_COUNT) {
        return GNN_EK_COUNT;
    }
    return GNN_E_KIND[j as usize];
}

pub fn gnn_edge_label(j: u32) -> u32 {
    if (j >= GNN_EDGE_COUNT) {
        return LABEL_UNKNOWN as u32;
    }
    return GNN_E_LABEL[j as usize];
}

/// The colour of a node kind and of an edge kind. Any number past the table is the ink.
pub fn gnn_nk_rgb(k: u32) -> u32 {
    if (k >= GNN_NK_COUNT) {
        return VIZ_INK_RGB;
    }
    return GNN_NK_RGB[k as usize];
}

pub fn gnn_ek_rgb(k: u32) -> u32 {
    if (k >= GNN_EK_COUNT) {
        return VIZ_INK_RGB;
    }
    return GNN_EK_RGB[k as usize];
}

/// The line style of an edge kind (GNN_ST_*).
pub fn gnn_ek_style(k: u32) -> u32 {
    if (k >= GNN_EK_COUNT) {
        return GNN_ST_SOLID;
    }
    return GNN_EK_STYLE[k as usize];
}

/// The outline style of a node: solid when EXACT, the node dash otherwise.
pub fn gnn_node_style(v: u32) -> u32 {
    if (gnn_node_exact(v)) {
        return GNN_ST_SOLID;
    }
    return GNN_ST_OUTLINE;
}

pub fn gnn_dash_on(st: u32) -> u32 {
    if (st >= GNN_ST_COUNT) {
        return 0;
    }
    return GNN_DASH_ON[st as usize];
}

pub fn gnn_dash_off(st: u32) -> u32 {
    if (st >= GNN_ST_COUNT) {
        return 0;
    }
    return GNN_DASH_OFF[st as usize];
}

/// The other end of edge j seen from node v, GNN_NO_NODE when j does not touch v.
pub fn gnn_edge_other(j: u32, v: u32) -> u32 {
    let f : u32 = gnn_edge_from(j);
    let u : u32 = gnn_edge_to(j);
    if (f == v) {
        return u;
    }
    if (u == v) {
        return f;
    }
    return GNN_NO_NODE;
}

/// How many distinct edges touch v (the fixture has no repeated pair, so this is the degree).
pub fn gnn_degree(v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return 0;
    }
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        if (gnn_edge_other(j, v) != GNN_NO_NODE) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// The i-th neighbour of v in edge order; GNN_NO_NODE past the degree.
pub fn gnn_neighbour(v: u32, i: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return GNN_NO_NODE;
    }
    var seen : u32 = 0;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        let o : u32 = gnn_edge_other(j, v);
        if (o != GNN_NO_NODE) {
            if (seen == i) {
                return o;
            }
            seen = seen + 1;
        }
        j = j + 1;
    }
    return GNN_NO_NODE;
}

; ---------------------------------------------------------------- L2 layout

/// A node's box, top-left, in the frame: the web position times 8/5, in the graph rect.
pub fn gnn_node_x(v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return 0;
    }
    return GNN_GRAPH_X + GNN_N_X[v as usize] * 8 / 5;
}

pub fn gnn_node_y(v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return 0;
    }
    return GNN_GRAPH_Y + GNN_N_Y[v as usize] * 8 / 5;
}

pub fn gnn_node_cx(v: u32) -> u32 {
    return gnn_node_x(v) + GNN_BOX_W / 2;
}

pub fn gnn_node_cy(v: u32) -> u32 {
    return gnn_node_y(v) + GNN_BOX_H / 2;
}

/// Edge j runs from the centre of its source box (the boxes are drawn over it) to GNN_EDGE_GAP left of
/// the target box's left edge, at the target's mid height, as on the web page. Both ends are frame points.
pub fn gnn_edge_x0(j: u32) -> u32 {
    return gnn_node_x(gnn_edge_from(j)) + GNN_BOX_W / 2;
}

pub fn gnn_edge_y0(j: u32) -> u32 {
    return gnn_node_cy(gnn_edge_from(j));
}

pub fn gnn_edge_x1(j: u32) -> u32 {
    return gnn_node_x(gnn_edge_to(j)) - GNN_EDGE_GAP;
}

pub fn gnn_edge_y1(j: u32) -> u32 {
    return gnn_node_cy(gnn_edge_to(j));
}

; ---------------------------------------------------------------- L3 reach

/// The nodes within k hops of a start, in discovery order. order[0..count) is the queue of the search;
/// dist[v] is the hop count of node v, GNN_FAR if v is not reached. count == 0 means no subject.
pub struct GnnReach {
    order: [17]u32,
    dist: [17]u32,
    count: u32,
    start: u32,
    k: u32,
}

/// Breadth-first search from `start` out to k hops, either direction along every edge. A node is
/// expanded only while its distance is below k; its edges are scanned in index order, which is the
/// order the web page's khop() discovers nodes in. A start that is not a node gives an empty reach.
pub fn gnn_reach(start: u32, k: u32) -> GnnReach {
    var r : GnnReach = GnnReach { order: [0; 17], dist: [65535; 17], count: 0, start: start, k: k };
    if (start >= GNN_NODE_COUNT) {
        r.start = GNN_NO_NODE;
        return r;
    }
    r.order[0] = start;
    r.dist[start as usize] = 0;
    r.count = 1;
    var head : u32 = 0;
    while (head < r.count) {
        let x : u32 = r.order[head as usize];
        head = head + 1;
        if (r.dist[x as usize] < k) {
            var j : u32 = 0;
            while (j < GNN_EDGE_COUNT) {
                let y : u32 = gnn_edge_other(j, x);
                if (y < GNN_NODE_COUNT) {
                    if (r.dist[y as usize] == GNN_FAR) {
                        r.dist[y as usize] = r.dist[x as usize] + 1;
                        r.order[r.count as usize] = y;
                        r.count = r.count + 1;
                    }
                }
                j = j + 1;
            }
        }
    }
    return r;
}

/// How many nodes are at exactly h hops (hop 0 is the start).
pub fn gnn_hop_count(r: GnnReach, h: u32) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < r.count and i < GNN_NODE_COUNT) {
        if (r.dist[r.order[i as usize] as usize] == h) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The j-th node, in discovery order, at exactly h hops; GNN_NO_NODE past the last.
pub fn gnn_hop_node(r: GnnReach, h: u32, j: u32) -> u32 {
    var seen : u32 = 0;
    var i : u32 = 0;
    while (i < r.count and i < GNN_NODE_COUNT) {
        let v : u32 = r.order[i as usize];
        if (r.dist[v as usize] == h) {
            if (seen == j) {
                return v;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return GNN_NO_NODE;
}

/// True when v is in the reach (the start included).
pub fn gnn_in_reach(r: GnnReach, v: u32) -> bool {
    return r.count > 0 and v < GNN_NODE_COUNT and r.dist[v as usize] != GNN_FAR;
}

/// Hops from the start to v, GNN_FAR when v is not in the reach.
pub fn gnn_dist(r: GnnReach, v: u32) -> u32 {
    if (v >= GNN_NODE_COUNT) {
        return GNN_FAR;
    }
    return r.dist[v as usize];
}

/// How many edges have both ends in the reach: the edges the page lights.
pub fn gnn_lit_edges(r: GnnReach) -> u32 {
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        if (gnn_in_reach(r, gnn_edge_from(j)) and gnn_in_reach(r, gnn_edge_to(j))) {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

; ---------------------------------------------------------------- L4 oracle

/// Distances from one start to every node, flat in 17 slots; GNN_FAR where unreachable.
pub struct GnnDist {
    d: [17]u32,
}

/// Distance by repeated relaxation over the edge list, either direction: GNN_NODE_COUNT rounds over
/// all edges settle every distance. It keeps no queue and shares no code with gnn_reach, so it can be
/// the oracle that checks it. A start that is not a node leaves every slot GNN_FAR.
pub fn gnn_oracle_row(start: u32) -> GnnDist {
    var r : GnnDist = GnnDist { d: [65535; 17] };
    if (start >= GNN_NODE_COUNT) {
        return r;
    }
    r.d[start as usize] = 0;
    var round : u32 = 0;
    while (round < GNN_NODE_COUNT) {
        var j : u32 = 0;
        while (j < GNN_EDGE_COUNT) {
            let f : usize = GNN_E_FROM[j as usize] as usize;
            let u : usize = GNN_E_TO[j as usize] as usize;
            if (r.d[f] != GNN_FAR) {
                if (r.d[f] + 1 < r.d[u]) {
                    r.d[u] = r.d[f] + 1;
                }
            }
            if (r.d[u] != GNN_FAR) {
                if (r.d[u] + 1 < r.d[f]) {
                    r.d[f] = r.d[u] + 1;
                }
            }
            j = j + 1;
        }
        round = round + 1;
    }
    return r;
}

; ---------------------------------------------------------------- lit and opacity

/// A node is lit when it is in the reach, or when there is no subject (everything at rest is lit).
pub fn gnn_node_lit(r: GnnReach, v: u32) -> bool {
    if (r.count == 0) {
        return true;
    }
    return gnn_in_reach(r, v);
}

/// An edge is lit when both its ends are in the reach.
pub fn gnn_edge_lit(r: GnnReach, j: u32) -> bool {
    if (j >= GNN_EDGE_COUNT) {
        return false;
    }
    return gnn_in_reach(r, gnn_edge_from(j)) and gnn_in_reach(r, gnn_edge_to(j));
}

/// Node opacity, thousandths: 1000 when lit or at rest, 220 when dim.
pub fn gnn_node_opacity(r: GnnReach, v: u32) -> u32 {
    if (gnn_node_lit(r, v)) {
        return GNN_OP_NODE_LIT;
    }
    return GNN_OP_NODE_DIM;
}

/// Edge opacity, thousandths: 750 at rest, 950 when lit, 80 when dim.
pub fn gnn_edge_opacity(r: GnnReach, j: u32) -> u32 {
    if (r.count == 0) {
        return GNN_OP_EDGE_IDLE;
    }
    if (gnn_edge_lit(r, j)) {
        return GNN_OP_EDGE_LIT;
    }
    return GNN_OP_EDGE_DIM;
}

; ---------------------------------------------------------------- L5 state

/// A page ready to explore: LOAD, then LOADED with every node focusable and the truth DEMO (the
/// fixture is written into this file, not fetched). One step, three depths; k = 1 until the reader
/// chooses another.
pub fn gnn_open() -> VizState {
    var v : VizState = viz_init(GNN_STEPS, GNN_K_MAX);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, GNN_NODE_COUNT, VIZ_TRUTH_DEMO as u32);
    return v;
}

/// The depth k of a state: its param plus one, 1..3.
pub fn gnn_k(s: VizState) -> u32 {
    return s.param + GNN_K_MIN;
}

pub fn gnn_node_ref(v: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, v);
}

/// The node a ref names, GNN_NO_NODE for the empty ref, an edge or a node past the fixture.
pub fn gnn_ref_node(r: u32) -> u32 {
    if (viz_ref_kind(r) == VIZ_ENT_NODE and viz_ref_index(r) < GNN_NODE_COUNT) {
        return viz_ref_index(r);
    }
    return GNN_NO_NODE;
}

/// The node the page describes and lights: the hovered node if there is one, else the selected node,
/// else GNN_NO_NODE. Focus draws a ring only.
pub fn gnn_subject(s: VizState) -> u32 {
    let h : u32 = gnn_ref_node(s.hover);
    if (h != GNN_NO_NODE) {
        return h;
    }
    return gnn_ref_node(s.selected);
}

/// The reach the page shows for a state: the subject out to k hops (empty with no subject).
pub fn gnn_reach_of(s: VizState) -> GnnReach {
    return gnn_reach(gnn_subject(s), gnn_k(s));
}

/// The entity of focus index f: the nodes 0..16 in order. VIZ_REF_NONE past the end.
pub fn gnn_focus_ref(s: VizState, f: u32) -> u32 {
    if (f >= s.focus_count or f >= GNN_NODE_COUNT) {
        return VIZ_REF_NONE;
    }
    return gnn_node_ref(f);
}

/// ACTIVATE on the focused item: the same as clicking it. Nothing focused is a no-op.
pub fn gnn_activate(s: VizState) -> VizState {
    let r : u32 = gnn_focus_ref(s, s.focus);
    if (r == VIZ_REF_NONE) {
        return s;
    }
    return viz_apply(s, VIZ_EV_ACTIVATE, r, 0);
}

/// The highlight of node v in a state (select beats hover): VIZ_HL_NONE, VIZ_HL_HOVER or VIZ_HL_SELECT.
pub fn gnn_node_hl(s: VizState, v: u32) -> u8 {
    return viz_highlight(s, gnn_node_ref(v));
}

/// How many lines the side panel holds: the idle hint, or the header, one line per hop, and the two
/// closing lines.
pub fn gnn_panel_len(s: VizState) -> u32 {
    if (gnn_subject(s) == GNN_NO_NODE) {
        return GNN_IDLE_COUNT;
    }
    return gnn_k(s) + 3;
}

/// The baseline-top of panel line i, in the frame.
pub fn gnn_panel_line_y(i: u32) -> u32 {
    return GNN_PANEL_Y + GNN_PANEL_PAD + i * GNN_PANEL_LINE_H;
}

; ---------------------------------------------------------------- L6 host map
; A host draws what the layers above compute and maps its events to the one reducer; nothing in this
; section draws. Pointer positions come in as FRAME coordinates (psv_to_frame turns a page position into
; one), and every answer is a GnnAct, an event for viz_apply, or GNN_EV_NONE.

/// The node whose box holds the frame point (px, py); GNN_NO_NODE over empty space. Boxes are half-open
/// on the right and bottom; they never overlap, so at most one holds a point.
pub fn gnn_node_hit(px: u32, py: u32) -> u32 {
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let x : u32 = gnn_node_x(v);
        let y : u32 = gnn_node_y(v);
        if (px >= x and py >= y and px < x + GNN_BOX_W and py < y + GNN_BOX_H) {
            return v;
        }
        v = v + 1;
    }
    return GNN_NO_NODE;
}

/// The entity under the point as a ref; VIZ_REF_NONE over nothing. Only the nodes are entities.
pub fn gnn_ref_at(px: u32, py: u32) -> u32 {
    let v : u32 = gnn_node_hit(px, py);
    if (v == GNN_NO_NODE) {
        return VIZ_REF_NONE;
    }
    return gnn_node_ref(v);
}

/// The k cell under the point (0, 1, 2 for k = 1, 2, 3); GNN_NO_PICK elsewhere.
pub fn gnn_k_hit(px: u32, py: u32) -> u32 {
    if (px < GNN_CHOICE_X or py < GNN_CTRL_Y or py >= GNN_CTRL_Y + GNN_CTRL_H) {
        return GNN_NO_PICK;
    }
    let c : u32 = (px - GNN_CHOICE_X) / GNN_CHOICE_CELL;
    if (c >= GNN_K_MAX) {
        return GNN_NO_PICK;
    }
    return c;
}

/// One event for viz_apply: ev, and its a and b.
pub struct GnnAct {
    ev: u8,
    a: u32,
    b: u32,
}

pub fn gnn_act(ev: u8, a: u32, b: u32) -> GnnAct {
    return GnnAct { ev: ev, a: a, b: b };
}

pub fn gnn_act_none() -> GnnAct {
    return GnnAct { ev: GNN_EV_NONE, a: 0, b: 0 };
}

/// Apply an action through the one reducer; GNN_EV_NONE leaves the state as it is.
pub fn gnn_do(s: VizState, x: GnnAct) -> VizState {
    if (x.ev == GNN_EV_NONE) {
        return s;
    }
    return viz_apply(s, x.ev, x.a, x.b);
}

/// The press at frame point (px, py). The k control first (sets the depth), then a node (selects it;
/// a second press on the selected node clears it, the contract's toggle). A press on empty frame
/// clears a selection; outside the frame or with nothing selected it is no event.
pub fn gnn_click_at(s: VizState, px: u32, py: u32) -> GnnAct {
    let c : u32 = gnn_k_hit(px, py);
    if (c != GNN_NO_PICK) {
        return gnn_act(VIZ_EV_PARAM_SET, c, 0);
    }
    let r : u32 = gnn_ref_at(px, py);
    if (r != VIZ_REF_NONE) {
        return gnn_act(VIZ_EV_SELECT, r, 0);
    }
    if (s.selected != VIZ_REF_NONE and px < GNN_FRAME_W and py < GNN_FRAME_H) {
        return gnn_act(VIZ_EV_CLEAR, 0, 0);
    }
    return gnn_act_none();
}

/// The pointer at frame point (px, py): HOVER over a node, LEAVE off every node, and no event while the
/// hover already is what the pointer is over (so a still pointer never bumps the revision).
pub fn gnn_hover_at(s: VizState, px: u32, py: u32) -> GnnAct {
    let r : u32 = gnn_ref_at(px, py);
    if (r == s.hover) {
        return gnn_act_none();
    }
    if (r == VIZ_REF_NONE) {
        return gnn_act(VIZ_EV_LEAVE, 0, 0);
    }
    return gnn_act(VIZ_EV_HOVER, r, 0);
}

/// The abstract key k on state s. LEFT and RIGHT step the depth and stop at k = 1 and k = 3; UP and DOWN
/// walk the focus; ACTIVATE presses the focused node; BACK clears the selection; K1..K3 set the depth.
/// Keys with nothing to act on (ACTIVATE with no focus, BACK with nothing selected, a depth that is
/// already at its end, an unknown key) are GNN_EV_NONE, so the host lets them through.
pub fn gnn_key_act(s: VizState, k: u32) -> GnnAct {
    if (k == GNN_KEY_LEFT) {
        if (s.param == 0) {
            return gnn_act_none();
        }
        return gnn_act(VIZ_EV_PARAM_SET, s.param - 1, 0);
    }
    if (k == GNN_KEY_RIGHT) {
        if (s.param + 1 >= GNN_K_MAX) {
            return gnn_act_none();
        }
        return gnn_act(VIZ_EV_PARAM_SET, s.param + 1, 0);
    }
    if (k == GNN_KEY_UP) {
        return gnn_act(VIZ_EV_FOCUS_PREV, 0, 0);
    }
    if (k == GNN_KEY_DOWN) {
        return gnn_act(VIZ_EV_FOCUS_NEXT, 0, 0);
    }
    if (k == GNN_KEY_ACTIVATE) {
        let r : u32 = gnn_focus_ref(s, s.focus);
        if (r == VIZ_REF_NONE) {
            return gnn_act_none();
        }
        return gnn_act(VIZ_EV_ACTIVATE, r, 0);
    }
    if (k == GNN_KEY_BACK) {
        if (s.selected == VIZ_REF_NONE) {
            return gnn_act_none();
        }
        return gnn_act(VIZ_EV_BACK, 0, 0);
    }
    if (k == GNN_KEY_K1) {
        return gnn_act(VIZ_EV_PARAM_SET, 0, 0);
    }
    if (k == GNN_KEY_K2) {
        return gnn_act(VIZ_EV_PARAM_SET, 1, 0);
    }
    if (k == GNN_KEY_K3) {
        return gnn_act(VIZ_EV_PARAM_SET, 2, 0);
    }
    return gnn_act_none();
}

; --- state words

/// Write the whole page state into w[base .. base + 5]. Lossless: gnn_load reads it back (the step
/// count is not stored, the page always has GNN_STEPS).
pub fn gnn_store(w: []u64, base: u32, s: VizState) -> void {
    let b : usize = base as usize;
    w[b] = (s.lifecycle as u64) + (s.error as u64) * 256 + (s.truth as u64) * 65536 + (s.reduced_motion as u64) * 16777216 + (s.item_count as u64) * 4294967296;
    w[b + 1] = (s.hover as u64) + (s.selected as u64) * 4294967296;
    w[b + 2] = (s.step as u64) + (s.param as u64) * 4294967296;
    w[b + 3] = (s.focus as u64) + (s.revision as u64) * 4294967296;
    w[b + 4] = (s.focus_count as u64) + (s.param_count as u64) * 4294967296;
}

/// The state kept in w[base .. base + 5]. Words never written (all zero, so the lifecycle is IDLE)
/// mean "not opened yet": the answer is gnn_open(). That is exact because a state a host can store is
/// never IDLE: gnn_open leaves IDLE and no event returns to it (a test below holds this).
pub fn gnn_load(w: []const u64, base: u32) -> VizState {
    let b : usize = base as usize;
    if (w[b] == 0) {
        return gnn_open();
    }
    var s : VizState = viz_init(GNN_STEPS, GNN_K_MAX);
    s.lifecycle = (w[b] % 256) as u8;
    s.error = (w[b] / 256 % 256) as u8;
    s.truth = (w[b] / 65536 % 256) as u8;
    s.reduced_motion = (w[b] / 16777216 % 256) as u8;
    s.item_count = (w[b] / 4294967296) as u32;
    s.hover = (w[b + 1] % 4294967296) as u32;
    s.selected = (w[b + 1] / 4294967296) as u32;
    s.step = (w[b + 2] % 4294967296) as u32;
    s.param = (w[b + 2] / 4294967296) as u32;
    s.focus = (w[b + 3] % 4294967296) as u32;
    s.revision = (w[b + 3] / 4294967296) as u32;
    s.focus_count = (w[b + 4] % 4294967296) as u32;
    s.param_count = (w[b + 4] / 4294967296) as u32;
    return s;
}

; --- the host layout

/// The nested layout: one frame, and its five children in focus order. Every rect is relative to the
/// frame, which sits at the host's origin, so the numbers are frame coordinates.
pub fn gnn_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_TEXT, VH_ROOT, 0, 0, GNN_FRAME_W, GNN_FRAME_H);
    h = vh_add(h, VIZ_REP_BADGE, GNN_SLOT_FRAME, 20, GNN_CTRL_Y, 300, GNN_CTRL_H);
    h = vh_add(h, VIZ_REP_CHOICE, GNN_SLOT_FRAME, GNN_CHOICE_X, GNN_CTRL_Y, GNN_CHOICE_CELL * GNN_K_MAX, GNN_CTRL_H);
    h = vh_add(h, VIZ_REP_GRAPH, GNN_SLOT_FRAME, GNN_GRAPH_X, GNN_GRAPH_Y, GNN_GRAPH_W, GNN_GRAPH_H);
    h = vh_add(h, VIZ_REP_INSPECTOR, GNN_SLOT_FRAME, GNN_PANEL_X, GNN_PANEL_Y, GNN_PANEL_W, GNN_PANEL_H);
    h = vh_add(h, VIZ_REP_TEXT, GNN_SLOT_FRAME, GNN_LEGEND_X, GNN_LEGEND_Y, GNN_LEGEND_W, GNN_LEGEND_H);
    return h;
}

/// The reps the page uses, as a bit set: the graph, the side panel (inspector), the k control (choice),
/// the truth badge, and the text of the legend. It has one entity view besides the text, and the plan
/// of petal_viz_plan.t27 for the MAP row lists its own set; this one is what the host really draws.
pub fn gnn_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_GRAPH) | viz_rep_bit(VIZ_REP_INSPECTOR) | viz_rep_bit(VIZ_REP_CHOICE) | viz_rep_bit(VIZ_REP_BADGE) | viz_rep_bit(VIZ_REP_TEXT);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// The hop-h list of a reach is exactly (a, b, c, d), in discovery order; GNN_NO_NODE marks an unused slot.
fn gnn_hop_is(r: GnnReach, h: u32, a: u32, b: u32, c: u32, d: u32) -> bool {
    var want : [4]u32 = [0; 4];
    want[0] = a;
    want[1] = b;
    want[2] = c;
    want[3] = d;
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < 4) {
        if (want[i as usize] != GNN_NO_NODE) {
            n = n + 1;
        }
        i = i + 1;
    }
    if (gnn_hop_count(r, h) != n) {
        return false;
    }
    i = 0;
    while (i < n) {
        if (gnn_hop_node(r, h, i) != want[i as usize]) {
            return false;
        }
        i = i + 1;
    }
    return gnn_hop_node(r, h, n) == GNN_NO_NODE;
}

/// Two page states are the same in every field, the revision included.
fn gnn_eq(a: VizState, b: VizState) -> bool {
    return a.lifecycle == b.lifecycle and a.error == b.error and a.truth == b.truth and a.item_count == b.item_count and a.hover == b.hover and a.selected == b.selected and a.step == b.step and a.step_count == b.step_count and a.param == b.param and a.param_count == b.param_count and a.focus == b.focus and a.focus_count == b.focus_count and a.reduced_motion == b.reduced_motion and a.revision == b.revision;
}

/// A ready page with node v pinned and depth k.
fn gnn_pinned(v: u32, k: u32) -> VizState {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(v), 0);
    s = viz_apply(s, VIZ_EV_PARAM_SET, k - 1, 0);
    return s;
}

; ---------------------------------------------------------------- tests: fixture

test the_fixture_has_the_hand_counted_node_and_edge_kinds {
    var nk : [5]u32 = [0; 5];
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let k : u32 = gnn_node_kind(v);
        assert k < GNN_NK_COUNT;
        nk[k as usize] = nk[k as usize] + 1;
        v = v + 1;
    }
    // SPEC 3, AGENT 4, TASK 3, ACTION 5, ARTIFACT 2: the sum is 17
    assert nk[0] == 3;
    assert nk[1] == 4;
    assert nk[2] == 3;
    assert nk[3] == 5;
    assert nk[4] == 2;
    var ek : [6]u32 = [0; 6];
    var derived : u32 = 0;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        let k : u32 = gnn_edge_kind(j);
        assert k < GNN_EK_COUNT;
        ek[k as usize] = ek[k as usize] + 1;
        if (gnn_edge_label(j) == (LABEL_DERIVED as u32)) {
            derived = derived + 1;
        }
        j = j + 1;
    }
    // READS 3, ASSIGNED 4, PERFORMS 5, PRODUCES 2, VERIFIES 2, BLOCKS 1: the sum is 17
    assert ek[0] == 3;
    assert ek[1] == 4;
    assert ek[2] == 5;
    assert ek[3] == 2;
    assert ek[4] == 2;
    assert ek[5] == 1;
    // the five DERIVED edges are the three READS joins and the two VERIFIES
    assert derived == 5;
}

test only_the_bare_pid_is_unknown_and_every_other_node_is_exact {
    var unknown : u32 = 0;
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        if (gnn_node_exact(v)) {
            assert gnn_node_style(v) == GNN_ST_SOLID;
        } else {
            unknown = unknown + 1;
            assert gnn_node_label(v) == (LABEL_UNKNOWN as u32);
            assert gnn_node_style(v) == GNN_ST_OUTLINE;
            assert v == 3;
        }
        v = v + 1;
    }
    assert unknown == 1;
    assert gnn_node_exact(GNN_NODE_COUNT) == false;
    assert gnn_node_exact(65535) == false;
}

test every_edge_joins_two_distinct_nodes_and_no_pair_repeats {
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        let f : u32 = gnn_edge_from(j);
        let t : u32 = gnn_edge_to(j);
        assert f < GNN_NODE_COUNT;
        assert t < GNN_NODE_COUNT;
        assert f != t;
        var i : u32 = j + 1;
        while (i < GNN_EDGE_COUNT) {
            let sameway : bool = gnn_edge_from(i) == f and gnn_edge_to(i) == t;
            let backway : bool = gnn_edge_from(i) == t and gnn_edge_to(i) == f;
            assert sameway == false;
            assert backway == false;
            i = i + 1;
        }
        j = j + 1;
    }
    assert gnn_edge_from(GNN_EDGE_COUNT) == GNN_NO_NODE;
    assert gnn_edge_to(GNN_EDGE_COUNT) == GNN_NO_NODE;
    assert gnn_edge_kind(GNN_EDGE_COUNT) == GNN_EK_COUNT;
}

test the_hand_read_neighbours_equal_the_edge_scan {
    var v : u32 = 0;
    var total : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let d : u32 = gnn_degree(v);
        assert d == GNN_HAND_DEGREE[v as usize];
        assert d <= 4;
        total = total + d;
        var i : u32 = 0;
        while (i < 4) {
            assert gnn_neighbour(v, i) == GNN_HAND_NBR[(v * 4 + i) as usize];
            i = i + 1;
        }
        v = v + 1;
    }
    // every edge is counted at both ends
    assert total == 2 * GNN_EDGE_COUNT;
    assert gnn_degree(GNN_NODE_COUNT) == 0;
    assert gnn_neighbour(GNN_NODE_COUNT, 0) == GNN_NO_NODE;
}

test the_names_and_ids_read_back_as_the_web_page_shows_them {
    assert gnn_node_name(0) == "reviewer";
    assert gnn_node_id(0) == "pid 4127";
    assert gnn_node_kind_name(0) == "AGENT";
    assert gnn_node_name(9) == "port HUD paint";
    assert gnn_node_id(9) == "#6795";
    assert gnn_node_kind_name(9) == "TASK";
    assert gnn_node_kind_name(4) == "ACTION";
    assert gnn_node_name(13) == "receipt.json";
    assert gnn_node_kind_name(13) == "ARTIFACT";
    assert gnn_node_id(15) == "work_graph";
    assert gnn_node_kind_name(15) == "SPEC";
    assert gnn_node_name(GNN_NODE_COUNT) == "";
    assert gnn_node_id(GNN_NODE_COUNT) == "";
    assert gnn_node_kind_name(GNN_NODE_COUNT) == "";
}

; ---------------------------------------------------------------- tests: k-hop by hand

test k_hop_from_node_10_fix_seals_by_hand {
    // #6810 fix seals: hop 1 reaches 4 nodes, hop 2 three more, hop 3 two more
    let r1 : GnnReach = gnn_reach(10, 1);
    let r2 : GnnReach = gnn_reach(10, 2);
    let r3 : GnnReach = gnn_reach(10, 3);
    assert gnn_hop_is(r1, 1, 5, 15, 6, 8);
    assert gnn_hop_count(r1, 2) == 0;
    assert r1.count == 5;
    assert gnn_hop_is(r2, 1, 5, 15, 6, 8);
    assert gnn_hop_is(r2, 2, 2, 12, 1, GNN_NO_NODE);
    assert gnn_hop_count(r2, 3) == 0;
    assert r2.count == 8;
    assert gnn_hop_is(r3, 1, 5, 15, 6, 8);
    assert gnn_hop_is(r3, 2, 2, 12, 1, GNN_NO_NODE);
    assert gnn_hop_is(r3, 3, 0, 7, GNN_NO_NODE, GNN_NO_NODE);
    assert r3.count == 10;
    assert gnn_hop_is(r3, 0, 10, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    // nodes beyond hop 3 are not reached at k = 3
    assert gnn_in_reach(r3, 4) == false;
    assert gnn_in_reach(r3, 14) == false;
    assert gnn_in_reach(r3, 7);
    assert gnn_dist(r3, 7) == 3;
    assert gnn_dist(r3, 14) == GNN_FAR;
}

test k_hop_from_node_0_reviewer_by_hand {
    let r1 : GnnReach = gnn_reach(0, 1);
    let r2 : GnnReach = gnn_reach(0, 2);
    let r3 : GnnReach = gnn_reach(0, 3);
    assert gnn_hop_is(r1, 1, 4, 12, GNN_NO_NODE, GNN_NO_NODE);
    assert r1.count == 3;
    assert gnn_hop_is(r2, 2, 9, 6, GNN_NO_NODE, GNN_NO_NODE);
    assert r2.count == 5;
    assert gnn_hop_is(r3, 3, 14, 2, 10, GNN_NO_NODE);
    assert r3.count == 8;
    assert gnn_in_reach(r3, 14);
    assert gnn_in_reach(r3, 13) == false;
}

test k_hop_from_node_3_bare_pid_by_hand {
    let r1 : GnnReach = gnn_reach(3, 1);
    let r2 : GnnReach = gnn_reach(3, 2);
    let r3 : GnnReach = gnn_reach(3, 3);
    assert gnn_hop_is(r1, 1, 13, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r1.count == 2;
    assert gnn_hop_is(r2, 2, 7, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r2.count == 3;
    assert gnn_hop_is(r3, 3, 1, 11, GNN_NO_NODE, GNN_NO_NODE);
    assert r3.count == 5;
}

test k_hop_from_node_14_hud_spec_by_hand {
    let r1 : GnnReach = gnn_reach(14, 1);
    let r2 : GnnReach = gnn_reach(14, 2);
    let r3 : GnnReach = gnn_reach(14, 3);
    assert gnn_hop_is(r1, 1, 9, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r1.count == 2;
    assert gnn_hop_is(r2, 2, 4, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r2.count == 3;
    assert gnn_hop_is(r3, 3, 0, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r3.count == 4;
}

test k_hop_from_node_16_gf16_spec_by_hand {
    let r1 : GnnReach = gnn_reach(16, 1);
    let r2 : GnnReach = gnn_reach(16, 2);
    let r3 : GnnReach = gnn_reach(16, 3);
    assert gnn_hop_is(r1, 1, 11, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r1.count == 2;
    assert gnn_hop_is(r2, 2, 7, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r2.count == 3;
    assert gnn_hop_is(r3, 3, 1, 13, GNN_NO_NODE, GNN_NO_NODE);
    assert r3.count == 5;
}

test k_hop_from_node_7_result_d884_by_hand {
    let r1 : GnnReach = gnn_reach(7, 1);
    let r2 : GnnReach = gnn_reach(7, 2);
    let r3 : GnnReach = gnn_reach(7, 3);
    assert gnn_hop_is(r1, 1, 1, 11, 13, GNN_NO_NODE);
    assert r1.count == 4;
    assert gnn_hop_is(r2, 2, 8, 16, 3, GNN_NO_NODE);
    assert r2.count == 7;
    assert gnn_hop_is(r3, 3, 10, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
    assert r3.count == 8;
}

test a_reach_of_k_zero_is_the_start_alone_and_a_large_k_reaches_the_whole_graph {
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let r0 : GnnReach = gnn_reach(v, 0);
        assert r0.count == 1;
        assert gnn_in_reach(r0, v);
        assert gnn_dist(r0, v) == 0;
        // the graph is one connected component of 17 nodes, so k = 17 reaches all of them
        let rn : GnnReach = gnn_reach(v, GNN_NODE_COUNT);
        assert rn.count == GNN_NODE_COUNT;
        assert gnn_lit_edges(rn) == GNN_EDGE_COUNT;
        v = v + 1;
    }
    // from node 10 the farthest node is 6 hops away (hand-counted: 5, 3, 2, 3, 3, 1 nodes per hop 1..6)
    let r6 : GnnReach = gnn_reach(10, 6);
    let r5 : GnnReach = gnn_reach(10, 5);
    assert r6.count == GNN_NODE_COUNT;
    assert r5.count == 16;
    assert gnn_hop_is(r6, 6, 14, GNN_NO_NODE, GNN_NO_NODE, GNN_NO_NODE);
}

test a_start_that_is_not_a_node_reaches_nothing {
    let r : GnnReach = gnn_reach(GNN_NODE_COUNT, 3);
    assert r.count == 0;
    assert r.start == GNN_NO_NODE;
    assert gnn_in_reach(r, 0) == false;
    assert gnn_hop_count(r, 0) == 0;
    assert gnn_lit_edges(r) == 0;
    let q : GnnReach = gnn_reach(GNN_NO_NODE, 1);
    assert q.count == 0;
}

test the_reach_equals_the_relaxation_oracle_for_every_start_and_k {
    var s : u32 = 0;
    while (s < GNN_NODE_COUNT) {
        let o : GnnDist = gnn_oracle_row(s);
        var k : u32 = 0;
        while (k <= GNN_NODE_COUNT) {
            let r : GnnReach = gnn_reach(s, k);
            var within : u32 = 0;
            var v : u32 = 0;
            while (v < GNN_NODE_COUNT) {
                // a node is in the reach exactly when the oracle puts it within k hops
                let d : u32 = o.d[v as usize];
                if (d <= k) {
                    within = within + 1;
                    assert gnn_in_reach(r, v);
                    assert gnn_dist(r, v) == d;
                } else {
                    assert gnn_in_reach(r, v) == false;
                }
                v = v + 1;
            }
            assert r.count == within;
            k = k + 1;
        }
        s = s + 1;
    }
    let none : GnnDist = gnn_oracle_row(GNN_NODE_COUNT);
    assert none.d[0] == GNN_FAR;
    assert none.d[16] == GNN_FAR;
}

test hops_partition_the_reach_and_the_reach_only_grows_with_k {
    var s : u32 = 0;
    while (s < GNN_NODE_COUNT) {
        var prev : u32 = 0;
        var k : u32 = 1;
        while (k <= 6) {
            let r : GnnReach = gnn_reach(s, k);
            // the hop counts add up to the reach, and the discovery order has no repeats
            var sum : u32 = 0;
            var h : u32 = 0;
            while (h <= k) {
                sum = sum + gnn_hop_count(r, h);
                h = h + 1;
            }
            assert sum == r.count;
            assert r.count >= prev;
            prev = r.count;
            var i : u32 = 0;
            while (i < r.count) {
                var j : u32 = i + 1;
                while (j < r.count) {
                    assert r.order[i as usize] != r.order[j as usize];
                    j = j + 1;
                }
                i = i + 1;
            }
            k = k + 1;
        }
        s = s + 1;
    }
}

test the_lit_edges_are_the_edges_with_both_ends_in_the_reach {
    // node 10 at k = 1: e4 e5 e7 e16 (hand-counted)
    assert gnn_lit_edges(gnn_reach(10, 1)) == 4;
    // node 10 at k = 2: e3 e4 e5 e6 e7 e8 e15 e16
    assert gnn_lit_edges(gnn_reach(10, 2)) == 8;
    // node 3 at k = 1, 2, 3: e14; e12 e14; e10 e11 e12 e14
    assert gnn_lit_edges(gnn_reach(3, 1)) == 1;
    assert gnn_lit_edges(gnn_reach(3, 2)) == 2;
    assert gnn_lit_edges(gnn_reach(3, 3)) == 4;
    let r : GnnReach = gnn_reach(10, 2);
    var want : [17]u32 = [0; 17];
    want[3] = 1;
    want[4] = 1;
    want[5] = 1;
    want[6] = 1;
    want[7] = 1;
    want[8] = 1;
    want[15] = 1;
    want[16] = 1;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        assert gnn_edge_lit(r, j) == (want[j as usize] == 1);
        j = j + 1;
    }
    assert gnn_edge_lit(r, GNN_EDGE_COUNT) == false;
}

test opacity_follows_the_web_page_rules {
    let none : GnnReach = gnn_reach(GNN_NODE_COUNT, 2);
    let r : GnnReach = gnn_reach(3, 2);
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        // no subject: everything at rest is fully visible
        assert gnn_node_opacity(none, v) == 1000;
        // subject 3 at k = 2: nodes 3, 13, 7 lit
        if (v == 3 or v == 13 or v == 7) {
            assert gnn_node_opacity(r, v) == 1000;
        } else {
            assert gnn_node_opacity(r, v) == 220;
        }
        v = v + 1;
    }
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        assert gnn_edge_opacity(none, j) == 750;
        // lit edges are e12 (7-13) and e14 (3-13)
        if (j == 12 or j == 14) {
            assert gnn_edge_opacity(r, j) == 950;
        } else {
            assert gnn_edge_opacity(r, j) == 80;
        }
        j = j + 1;
    }
}

; ---------------------------------------------------------------- tests: layout and hit

test the_layout_is_the_web_position_scaled_by_8_over_5_into_the_graph_rect {
    // hand-computed: x = 20 + X * 8 / 5, y = 70 + Y * 8 / 5 (integer floor)
    assert gnn_node_x(0) == 144;
    assert gnn_node_y(0) == 175;
    assert gnn_node_x(4) == 480;
    assert gnn_node_y(4) == 159;
    assert gnn_node_x(16) == 1172;
    assert gnn_node_y(16) == 793;
    assert gnn_node_cx(0) == 227;
    assert gnn_node_cy(0) == 199;
    assert gnn_node_x(GNN_NODE_COUNT) == 0;
    // the layout is a pure function: asking twice gives the same answer
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        assert gnn_node_x(v) == GNN_GRAPH_X + GNN_N_X[v as usize] * 8 / 5;
        assert gnn_node_y(v) == GNN_GRAPH_Y + GNN_N_Y[v as usize] * 8 / 5;
        v = v + 1;
    }
}

test every_box_lies_in_the_graph_rect_and_no_two_boxes_overlap {
    var a : u32 = 0;
    while (a < GNN_NODE_COUNT) {
        assert gnn_node_x(a) >= GNN_GRAPH_X;
        assert gnn_node_y(a) >= GNN_GRAPH_Y;
        assert gnn_node_x(a) + GNN_BOX_W <= GNN_GRAPH_X + GNN_GRAPH_W;
        assert gnn_node_y(a) + GNN_BOX_H <= GNN_GRAPH_Y + GNN_GRAPH_H;
        var b : u32 = a + 1;
        while (b < GNN_NODE_COUNT) {
            let apart_x : bool = gnn_node_x(a) + GNN_BOX_W <= gnn_node_x(b) or gnn_node_x(b) + GNN_BOX_W <= gnn_node_x(a);
            let apart_y : bool = gnn_node_y(a) + GNN_BOX_H <= gnn_node_y(b) or gnn_node_y(b) + GNN_BOX_H <= gnn_node_y(a);
            assert apart_x or apart_y;
            b = b + 1;
        }
        a = a + 1;
    }
}

test an_edge_runs_from_the_source_middle_to_just_left_of_the_target_middle {
    // edge 0: node 0 (144,175) -> node 4 (480,159)
    assert gnn_edge_x0(0) == 227;
    assert gnn_edge_y0(0) == 199;
    assert gnn_edge_x1(0) == 474;
    assert gnn_edge_y1(0) == 183;
    var j : u32 = 0;
    while (j < GNN_EDGE_COUNT) {
        assert gnn_edge_x0(j) == gnn_node_cx(gnn_edge_from(j));
        assert gnn_edge_y0(j) == gnn_node_cy(gnn_edge_from(j));
        assert gnn_edge_x1(j) + GNN_EDGE_GAP == gnn_node_x(gnn_edge_to(j));
        assert gnn_edge_y1(j) == gnn_node_cy(gnn_edge_to(j));
        j = j + 1;
    }
}

test every_node_box_hits_back_at_itself_and_the_edges_are_half_open {
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let x : u32 = gnn_node_x(v);
        let y : u32 = gnn_node_y(v);
        assert gnn_node_hit(gnn_node_cx(v), gnn_node_cy(v)) == v;
        assert gnn_node_hit(x, y) == v;
        assert gnn_node_hit(x + GNN_BOX_W - 1, y + GNN_BOX_H - 1) == v;
        // one pixel past the right or bottom edge is not this node
        assert gnn_node_hit(x + GNN_BOX_W, y) != v;
        assert gnn_node_hit(x, y + GNN_BOX_H) != v;
        assert gnn_node_hit(x - 1, y) != v;
        assert gnn_ref_at(gnn_node_cx(v), gnn_node_cy(v)) == gnn_node_ref(v);
        assert gnn_ref_node(gnn_node_ref(v)) == v;
        v = v + 1;
    }
}

test a_point_between_boxes_or_outside_the_graph_hits_nothing {
    // the 3 px gap between node 8 and node 14 (hand-computed: 742 + 48 = 790, 793)
    assert gnn_node_hit(500, 791) == GNN_NO_NODE;
    assert gnn_node_hit(500, 792) == GNN_NO_NODE;
    assert gnn_node_hit(0, 0) == GNN_NO_NODE;
    assert gnn_node_hit(1899, 999) == GNN_NO_NODE;
    assert gnn_ref_at(0, 0) == VIZ_REF_NONE;
    // the side panel and the legend are not nodes
    assert gnn_node_hit(GNN_PANEL_X + 10, GNN_PANEL_Y + 10) == GNN_NO_NODE;
    assert gnn_node_hit(GNN_LEGEND_X + 10, GNN_LEGEND_Y + 10) == GNN_NO_NODE;
    assert gnn_ref_node(VIZ_REF_NONE) == GNN_NO_NODE;
    assert gnn_ref_node(viz_ref(VIZ_ENT_EDGE, 3)) == GNN_NO_NODE;
    assert gnn_ref_node(viz_ref(VIZ_ENT_NODE, GNN_NODE_COUNT)) == GNN_NO_NODE;
}

test the_k_cells_hit_where_the_host_draws_them {
    assert gnn_k_hit(GNN_CHOICE_X, GNN_CTRL_Y) == 0;
    assert gnn_k_hit(GNN_CHOICE_X + GNN_CHOICE_CELL - 1, GNN_CTRL_Y + GNN_CTRL_H - 1) == 0;
    assert gnn_k_hit(GNN_CHOICE_X + GNN_CHOICE_CELL, GNN_CTRL_Y) == 1;
    assert gnn_k_hit(GNN_CHOICE_X + 2 * GNN_CHOICE_CELL + 5, 30) == 2;
    assert gnn_k_hit(GNN_CHOICE_X + 3 * GNN_CHOICE_CELL, 30) == GNN_NO_PICK;
    assert gnn_k_hit(GNN_CHOICE_X - 1, 30) == GNN_NO_PICK;
    assert gnn_k_hit(GNN_CHOICE_X, GNN_CTRL_Y - 1) == GNN_NO_PICK;
    assert gnn_k_hit(GNN_CHOICE_X, GNN_CTRL_Y + GNN_CTRL_H) == GNN_NO_PICK;
    // the host's choice slot is exactly these cells
    let h : VizHost = gnn_host();
    var c : u32 = 0;
    while (c < GNN_K_MAX) {
        let px : u32 = GNN_CHOICE_X + c * GNN_CHOICE_CELL + 7;
        assert vh_hit(h, px, 30) == GNN_SLOT_CHOICE;
        assert gnn_k_hit(px, 30) == c;
        c = c + 1;
    }
}

; ---------------------------------------------------------------- tests: state

test a_fresh_page_is_ready_demo_with_17_items_and_k_1 {
    let s : VizState = gnn_open();
    assert s.lifecycle == VIZ_LC_READY;
    assert s.truth == VIZ_TRUTH_DEMO;
    assert s.item_count == GNN_NODE_COUNT;
    assert s.focus_count == GNN_NODE_COUNT;
    assert s.step_count == GNN_STEPS;
    assert s.param_count == GNN_K_MAX;
    assert gnn_k(s) == 1;
    assert s.hover == VIZ_REF_NONE;
    assert s.selected == VIZ_REF_NONE;
    assert s.focus == VIZ_NO_FOCUS;
    // LOAD and LOADED are the only two revisions
    assert s.revision == 2;
    // a demo may not be presented as a result
    assert viz_may_claim(s.truth) == false;
    assert gnn_subject(s) == GNN_NO_NODE;
    assert gnn_reach_of(s).count == 0;
}

test hover_lights_a_node_and_leave_restores_the_idle_page {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_HOVER, gnn_node_ref(10), 0);
    assert gnn_subject(s) == 10;
    assert gnn_reach_of(s).count == 5;
    assert gnn_node_hl(s, 10) == VIZ_HL_HOVER;
    assert gnn_node_hl(s, 5) == VIZ_HL_NONE;
    s = viz_apply(s, VIZ_EV_LEAVE, 0, 0);
    assert gnn_subject(s) == GNN_NO_NODE;
    assert gnn_reach_of(s).count == 0;
    assert gnn_node_hl(s, 10) == VIZ_HL_NONE;
}

test the_hovered_node_beats_the_selected_node_as_the_subject {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(3), 0);
    assert gnn_subject(s) == 3;
    assert gnn_node_hl(s, 3) == VIZ_HL_SELECT;
    s = viz_apply(s, VIZ_EV_HOVER, gnn_node_ref(14), 0);
    assert gnn_subject(s) == 14;
    // the pinned node keeps its select ring while another node is hovered
    assert gnn_node_hl(s, 3) == VIZ_HL_SELECT;
    assert gnn_node_hl(s, 14) == VIZ_HL_HOVER;
    // leaving the hover returns to the pinned node
    s = viz_apply(s, VIZ_EV_LEAVE, 0, 0);
    assert gnn_subject(s) == 3;
    assert gnn_reach_of(s).count == 2;
}

test selecting_a_node_twice_clears_it_and_clear_and_back_drop_the_selection {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(7), 0);
    assert gnn_subject(s) == 7;
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(7), 0);
    assert s.selected == VIZ_REF_NONE;
    assert gnn_subject(s) == GNN_NO_NODE;
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(7), 0);
    s = viz_apply(s, VIZ_EV_CLEAR, 0, 0);
    assert s.selected == VIZ_REF_NONE;
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(9), 0);
    s = viz_apply(s, VIZ_EV_BACK, 0, 0);
    assert s.selected == VIZ_REF_NONE;
    // an edge is not a subject: selecting one lights nothing
    s = viz_apply(s, VIZ_EV_SELECT, viz_ref(VIZ_ENT_EDGE, 3), 0);
    assert gnn_subject(s) == GNN_NO_NODE;
}

test the_k_control_is_clamped_to_one_through_three {
    var s : VizState = gnn_pinned(10, 1);
    assert gnn_k(s) == 1;
    assert gnn_reach_of(s).count == 5;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 1, 0);
    assert gnn_k(s) == 2;
    assert gnn_reach_of(s).count == 8;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 2, 0);
    assert gnn_k(s) == 3;
    assert gnn_reach_of(s).count == 10;
    // a depth past the last cell is clamped to k = 3
    s = viz_apply(s, VIZ_EV_PARAM_SET, 99, 0);
    assert gnn_k(s) == GNN_K_MAX;
    assert gnn_reach_of(s).count == 10;
    // the page has one step: STEP_SET is clamped to it
    s = viz_apply(s, VIZ_EV_STEP_SET, 5, 0);
    assert s.step == 0;
}

test interaction_events_are_ignored_unless_the_page_is_ready {
    let idle : VizState = viz_init(GNN_STEPS, GNN_K_MAX);
    assert idle.lifecycle == VIZ_LC_IDLE;
    var ev : u8 = 4;
    while (ev <= 15) {
        let t : VizState = viz_apply(idle, ev, gnn_node_ref(2), 1);
        assert gnn_eq(t, idle);
        ev = ev + 1;
    }
    assert gnn_subject(idle) == GNN_NO_NODE;
}

test a_still_pointer_and_a_repeated_k_never_bump_the_revision {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_HOVER, gnn_node_ref(4), 0);
    let r : u32 = s.revision;
    s = viz_apply(s, VIZ_EV_HOVER, gnn_node_ref(4), 0);
    assert s.revision == r;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 0, 0);
    assert s.revision == r;
    s = viz_apply(s, VIZ_EV_PARAM_SET, 1, 0);
    assert s.revision == r + 1;
    s = viz_apply(s, VIZ_EV_MOTION, 1, 0);
    assert s.reduced_motion == 1;
}

test focus_walks_the_17_nodes_and_activate_selects_the_focused_one {
    var s : VizState = gnn_open();
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.focus == 0;
    assert gnn_focus_ref(s, s.focus) == gnn_node_ref(0);
    var i : u32 = 0;
    while (i < 5) {
        s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
        i = i + 1;
    }
    assert s.focus == 5;
    s = gnn_activate(s);
    assert gnn_subject(s) == 5;
    // focus wraps past the last node and back before the first
    s = viz_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
    assert s.focus == 4;
    var n : u32 = 0;
    while (n < GNN_NODE_COUNT) {
        s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
        n = n + 1;
    }
    assert s.focus == 4;
    assert gnn_focus_ref(s, GNN_NODE_COUNT) == VIZ_REF_NONE;
    // nothing focused: activate is a no-op
    let fresh : VizState = gnn_open();
    assert gnn_eq(gnn_activate(fresh), fresh);
}

test the_panel_length_follows_the_subject_and_k {
    let idle : VizState = gnn_open();
    assert gnn_panel_len(idle) == GNN_IDLE_COUNT;
    var k : u32 = 1;
    while (k <= GNN_K_MAX) {
        let s : VizState = gnn_pinned(10, k);
        // the header, one line per hop, the "after" line and the closing line
        assert gnn_panel_len(s) == k + 3;
        assert gnn_panel_len(s) <= GNN_PANEL_MAX_LINES;
        k = k + 1;
    }
}

; ---------------------------------------------------------------- tests: click, hover, key

test a_click_maps_to_the_k_control_a_node_or_a_clear {
    var s : VizState = gnn_open();
    let k2 : GnnAct = gnn_click_at(s, GNN_CHOICE_X + GNN_CHOICE_CELL + 5, 30);
    assert k2.ev == VIZ_EV_PARAM_SET;
    assert k2.a == 1;
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let a : GnnAct = gnn_click_at(s, gnn_node_cx(v), gnn_node_cy(v));
        assert a.ev == VIZ_EV_SELECT;
        assert a.a == gnn_node_ref(v);
        v = v + 1;
    }
    // empty frame with nothing selected: no event
    assert gnn_click_at(s, 5, 500).ev == GNN_EV_NONE;
    s = gnn_do(s, gnn_click_at(s, gnn_node_cx(10), gnn_node_cy(10)));
    assert gnn_subject(s) == 10;
    // empty frame with a selection clears it; outside the frame it does nothing
    assert gnn_click_at(s, 5, 500).ev == VIZ_EV_CLEAR;
    assert gnn_click_at(s, GNN_FRAME_W, 500).ev == GNN_EV_NONE;
    s = gnn_do(s, gnn_click_at(s, 5, 500));
    assert s.selected == VIZ_REF_NONE;
    // a click on the k cell keeps the selection and changes the depth
    s = gnn_do(s, gnn_click_at(s, gnn_node_cx(10), gnn_node_cy(10)));
    s = gnn_do(s, gnn_click_at(s, GNN_CHOICE_X + 2 * GNN_CHOICE_CELL + 1, 20));
    assert gnn_subject(s) == 10;
    assert gnn_k(s) == 3;
}

test a_hover_maps_to_hover_leave_or_nothing {
    var s : VizState = gnn_open();
    // off every node with nothing hovered: the hover already is what the pointer is over, so no event
    assert gnn_hover_at(s, 5, 500).ev == GNN_EV_NONE;
    let h : GnnAct = gnn_hover_at(s, gnn_node_cx(4), gnn_node_cy(4));
    assert h.ev == VIZ_EV_HOVER;
    assert h.a == gnn_node_ref(4);
    s = gnn_do(s, h);
    // a still pointer: no event
    assert gnn_hover_at(s, gnn_node_cx(4) + 3, gnn_node_cy(4) - 3).ev == GNN_EV_NONE;
    // moving onto another node hovers it; moving off leaves; a second move off does nothing
    assert gnn_hover_at(s, gnn_node_cx(5), gnn_node_cy(5)).a == gnn_node_ref(5);
    assert gnn_hover_at(s, 5, 500).ev == VIZ_EV_LEAVE;
    s = gnn_do(s, gnn_hover_at(s, 5, 500));
    assert s.hover == VIZ_REF_NONE;
    assert gnn_hover_at(s, 5, 500).ev == GNN_EV_NONE;
}

test the_keys_map_to_the_same_events_as_the_pointer {
    var s : VizState = gnn_open();
    assert gnn_key_act(s, GNN_KEY_NONE).ev == GNN_EV_NONE;
    assert gnn_key_act(s, 99).ev == GNN_EV_NONE;
    // k = 1: LEFT has nowhere to go, RIGHT goes to k = 2
    assert gnn_key_act(s, GNN_KEY_LEFT).ev == GNN_EV_NONE;
    let r : GnnAct = gnn_key_act(s, GNN_KEY_RIGHT);
    assert r.ev == VIZ_EV_PARAM_SET;
    assert r.a == 1;
    s = gnn_do(s, r);
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_RIGHT));
    assert gnn_k(s) == 3;
    assert gnn_key_act(s, GNN_KEY_RIGHT).ev == GNN_EV_NONE;
    assert gnn_key_act(s, GNN_KEY_LEFT).a == 1;
    assert gnn_key_act(s, GNN_KEY_K1).a == 0;
    assert gnn_key_act(s, GNN_KEY_K2).a == 1;
    assert gnn_key_act(s, GNN_KEY_K3).a == 2;
    // focus, activate, back
    assert gnn_key_act(s, GNN_KEY_ACTIVATE).ev == GNN_EV_NONE;
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_DOWN));
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_DOWN));
    assert gnn_key_act(s, GNN_KEY_ACTIVATE).a == gnn_node_ref(1);
    assert gnn_key_act(s, GNN_KEY_BACK).ev == GNN_EV_NONE;
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_ACTIVATE));
    assert gnn_subject(s) == 1;
    assert gnn_key_act(s, GNN_KEY_BACK).ev == VIZ_EV_BACK;
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_BACK));
    assert gnn_subject(s) == GNN_NO_NODE;
    s = gnn_do(s, gnn_key_act(s, GNN_KEY_UP));
    assert s.focus == 0;
}

; ---------------------------------------------------------------- tests: state words

test the_state_words_round_trip_for_every_node_and_k {
    var w : [9]u64 = [0; 9];
    var n : u32 = 0;
    while (n < GNN_NODE_COUNT) {
        var k : u32 = 1;
        while (k <= GNN_K_MAX) {
            var s : VizState = gnn_pinned(n, k);
            s = viz_apply(s, VIZ_EV_HOVER, gnn_node_ref((n + 3) % GNN_NODE_COUNT), 0);
            s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
            s = viz_apply(s, VIZ_EV_MOTION, 1, 0);
            gnn_store(w[0..9], 2, s);
            let q : VizState = gnn_load(w[0..9], 2);
            assert gnn_eq(s, q);
            assert gnn_subject(q) == (n + 3) % GNN_NODE_COUNT;
            assert gnn_k(q) == k;
            k = k + 1;
        }
        n = n + 1;
    }
    // the five words are w[2 .. 7): the two before them and the two after are never written
    assert w[0] == 0;
    assert w[1] == 0;
    assert w[7] == 0;
    assert w[8] == 0;
    assert GNN_WORDS == 5;
}

test a_stored_state_is_never_idle_so_an_all_zero_first_word_means_never_opened {
    var w : [7]u64 = [0; 7];
    var ev : u8 = 0;
    while (ev < VIZ_EV_COUNT) {
        var a : u32 = 0;
        while (a < 4) {
            let s : VizState = viz_apply(gnn_open(), ev, a * 5, a);
            assert s.lifecycle != VIZ_LC_IDLE;
            gnn_store(w[0..7], 1, s);
            assert w[1] != 0;
            assert gnn_eq(gnn_load(w[0..7], 1), s);
            a = a + 1;
        }
        ev = ev + 1;
    }
}

test an_unwritten_page_opens_and_a_store_leaves_the_neighbours_alone {
    var w : [10]u64 = [7; 10];
    w[3] = 0;
    w[4] = 0;
    w[5] = 0;
    w[6] = 0;
    w[7] = 0;
    let first : VizState = gnn_load(w[0..10], 3);
    assert gnn_eq(first, gnn_open());
    assert first.lifecycle == VIZ_LC_READY;
    assert first.truth == VIZ_TRUTH_DEMO;
    let s : VizState = viz_apply(first, VIZ_EV_SELECT, gnn_node_ref(2), 0);
    gnn_store(w[0..10], 3, s);
    assert w[0] == 7;
    assert w[1] == 7;
    assert w[2] == 7;
    assert w[8] == 7;
    assert w[9] == 7;
    assert w[3] != 0;
    assert gnn_eq(gnn_load(w[0..10], 3), s);
    assert gnn_subject(gnn_load(w[0..10], 3)) == 2;
}

; ---------------------------------------------------------------- tests: fit, legend, host, caps

test the_frame_fits_a_page_and_a_click_through_the_fit_selects_the_node {
    // a 950 x 500 page area is half the frame: scale 500, no margin on the long side
    let s : u32 = psv_fit_scale(950, 500);
    let ox : u32 = psv_fit_ox(950, 500);
    let oy : u32 = psv_fit_oy(950, 500);
    assert s == 500;
    assert ox == 0;
    assert oy == 0;
    assert psv_to_px(GNN_FRAME_W, s) <= 950;
    assert psv_to_px(GNN_FRAME_H, s) <= 500;
    // a wide page leaves a margin and the click inverse still lands on the node centre
    let s2 : u32 = psv_fit_scale(1900, 500);
    let ox2 : u32 = psv_fit_ox(1900, 500);
    assert s2 == 500;
    assert ox2 == 475;
    var v : u32 = 0;
    while (v < GNN_NODE_COUNT) {
        let px : u32 = ox2 + psv_to_px(gnn_node_cx(v), s2);
        let py : u32 = psv_fit_oy(1900, 500) + psv_to_px(gnn_node_cy(v), s2);
        let fx : u32 = psv_to_frame(px, ox2, s2);
        let fy : u32 = psv_to_frame(py, psv_fit_oy(1900, 500), s2);
        assert gnn_node_hit(fx, fy) == v;
        v = v + 1;
    }
    // a point left of the margin is no frame point at all
    assert psv_to_frame(10, ox2, s2) == 65535;
    assert PSV_FRAME_W == GNN_FRAME_W + 0;
    assert PSV_FRAME_H == GNN_FRAME_H + 0;
}

test the_node_and_edge_kind_colours_are_the_web_colours_and_two_are_palette_roles {
    assert gnn_nk_rgb(GNN_NK_SPEC) == 0x58A6FF;
    assert gnn_nk_rgb(GNN_NK_AGENT) == 0x3FB950;
    assert gnn_nk_rgb(GNN_NK_TASK) == 0xD29922;
    assert gnn_nk_rgb(GNN_NK_ACTION) == 0xF85149;
    assert gnn_nk_rgb(GNN_NK_ARTIFACT) == 0xE6EDF3;
    assert gnn_ek_rgb(GNN_EK_READS) == 0x58A6FF;
    assert gnn_ek_rgb(GNN_EK_ASSIGNED) == 0xD29922;
    assert gnn_ek_rgb(GNN_EK_PERFORMS) == 0x3FB950;
    assert gnn_ek_rgb(GNN_EK_PRODUCES) == 0xE6EDF3;
    assert gnn_ek_rgb(GNN_EK_VERIFIES) == 0x58A6FF;
    assert gnn_ek_rgb(GNN_EK_BLOCKS) == 0xF85149;
    // SPEC is the palette accent and ARTIFACT is the palette ink: one source for those two colours
    assert gnn_nk_rgb(GNN_NK_SPEC) == viz_role_rgb(VIZ_ROLE_ACCENT);
    assert gnn_nk_rgb(GNN_NK_ARTIFACT) == viz_role_rgb(VIZ_ROLE_INK);
    assert gnn_nk_rgb(GNN_NK_COUNT) == viz_role_rgb(VIZ_ROLE_INK);
    assert gnn_ek_rgb(GNN_EK_COUNT) == viz_role_rgb(VIZ_ROLE_INK);
    assert viz_role_rgb(VIZ_ROLE_INK) == VIZ_INK_RGB;
}

test every_kind_colour_is_readable_on_the_black_ground_and_on_a_panel {
    var k : u32 = 0;
    while (k < GNN_NK_COUNT) {
        assert viz_readable_on(gnn_nk_rgb(k), VIZ_BG_RGB, VIZ_MARGIN_QUIET);
        assert viz_readable_on(gnn_nk_rgb(k), VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
        k = k + 1;
    }
    // the plate under a node is pure black, the same as the page (no blue-black)
    assert viz_luma(VIZ_PANEL_RGB) == 0;
    assert viz_luma(VIZ_PANEL_RGB) == viz_luma(VIZ_BG_RGB);
    assert viz_luma(gnn_nk_rgb(GNN_NK_ACTION)) == 115;
    var e : u32 = 0;
    while (e < GNN_EK_COUNT) {
        assert viz_readable_on(gnn_ek_rgb(e), VIZ_BG_RGB, VIZ_MARGIN_QUIET);
        e = e + 1;
    }
    // the id line is muted ink on the panel, the name is ink
    assert viz_readable_on(VIZ_MUTED_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_INK_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
    assert viz_readable_on(VIZ_ACCENT_RGB, VIZ_PANEL_RGB, VIZ_MARGIN_QUIET);
}

test the_line_styles_are_solid_for_most_dotted_for_produces_and_dashed_for_verifies_and_blocks {
    var e : u32 = 0;
    while (e < GNN_EK_COUNT) {
        let st : u32 = gnn_ek_style(e);
        if (e == GNN_EK_PRODUCES) {
            assert st == GNN_ST_DOT;
        } else if (e == GNN_EK_VERIFIES or e == GNN_EK_BLOCKS) {
            assert st == GNN_ST_DASH;
        } else {
            assert st == GNN_ST_SOLID;
        }
        // a dashed style has both an on and an off length; a solid one has neither
        if (st == GNN_ST_SOLID) {
            assert gnn_dash_on(st) == 0;
            assert gnn_dash_off(st) == 0;
        } else {
            assert gnn_dash_on(st) > 0;
            assert gnn_dash_off(st) > 0;
        }
        e = e + 1;
    }
    assert gnn_dash_on(GNN_ST_OUTLINE) > 0;
    assert gnn_dash_on(GNN_ST_COUNT) == 0;
    assert gnn_ek_style(GNN_EK_COUNT) == GNN_ST_SOLID;
}

test the_legend_rows_lie_inside_the_legend_rect {
    var row : u32 = 0;
    while (row < 3) {
        let y : u32 = GNN_LEG_ROW_Y[row as usize];
        assert y >= GNN_LEGEND_Y;
        assert y + GNN_LEG_ITEM_H <= GNN_LEGEND_Y + GNN_LEGEND_H;
        row = row + 1;
    }
    // the widest row holds the six edge kinds
    let last : u32 = GNN_LEG_X0 + GNN_EK_COUNT * GNN_LEG_STEP;
    assert last <= GNN_LEGEND_X + GNN_LEGEND_W;
    assert GNN_LEG_X0 + GNN_NK_COUNT * GNN_LEG_STEP <= last;
}

test the_host_validates_and_places_each_view_in_its_slot {
    let h : VizHost = gnn_host();
    assert vh_validate(h) == VH_OK;
    assert h.count == 6;
    assert vh_hit(h, gnn_node_cx(10), gnn_node_cy(10)) == GNN_SLOT_GRAPH;
    assert vh_hit(h, GNN_PANEL_X + 20, GNN_PANEL_Y + 20) == GNN_SLOT_INSPECTOR;
    assert vh_hit(h, GNN_LEGEND_X + 20, GNN_LEGEND_Y + 20) == GNN_SLOT_LEGEND;
    assert vh_hit(h, 30, 20) == GNN_SLOT_BADGE;
    assert vh_hit(h, GNN_CHOICE_X + 10, 20) == GNN_SLOT_CHOICE;
    assert vh_hit(h, 5, 5) == GNN_SLOT_FRAME;
    assert vh_hit(h, GNN_FRAME_W, 0) == VH_NONE;
    // the panel holds its longest text: the idle hint and a k = 3 gather
    assert gnn_panel_line_y(GNN_PANEL_MAX_LINES - 1) + GNN_PANEL_LINE_H <= GNN_PANEL_Y + GNN_PANEL_H;
    assert gnn_panel_line_y(0) == GNN_PANEL_Y + GNN_PANEL_PAD;
}

test the_reps_of_the_page_pass_the_plan_check_and_match_the_host {
    let reps : u32 = gnn_reps();
    assert viz_plan_ok(reps);
    let h : VizHost = gnn_host();
    var bits : u32 = 0;
    var i : u32 = 0;
    while (i < h.count) {
        bits = bits | viz_rep_bit(h.rep[i as usize]);
        i = i + 1;
    }
    assert bits == reps;
}

test the_caps_are_three_depths_seventeen_nodes_and_five_words {
    // a depth past the cap and a node past the fixture never reach the reach search
    var s : VizState = gnn_pinned(0, 3);
    s = viz_apply(s, VIZ_EV_PARAM_SET, 1000, 0);
    assert gnn_k(s) == 3;
    assert s.param < GNN_K_MAX;
    s = viz_apply(s, VIZ_EV_SELECT, gnn_node_ref(GNN_NODE_COUNT - 1), 0);
    assert gnn_subject(s) == GNN_NODE_COUNT - 1;
    s = viz_apply(s, VIZ_EV_SELECT, viz_ref(VIZ_ENT_NODE, 40), 0);
    assert gnn_subject(s) == GNN_NO_NODE;
    var w : [8]u64 = [9; 8];
    gnn_store(w[0..8], 0, s);
    assert w[5] == 9;
    assert w[6] == 9;
    assert w[7] == 9;
    // the gather text never needs more lines than the panel holds
    var k : u32 = GNN_K_MIN;
    while (k <= GNN_K_MAX) {
        assert gnn_panel_len(gnn_pinned(10, k)) <= GNN_PANEL_MAX_LINES;
        k = k + 1;
    }
    assert GNN_IDLE_COUNT <= GNN_PANEL_MAX_LINES;
}

test the_gather_text_pieces_read_as_the_web_page_words_them {
    assert GNN_T_GATHER == "gather for ";
    assert GNN_T_AT_K == " at k = ";
    assert GNN_T_HOP == "  hop ";
    assert GNN_T_NONE == "(none)";
    assert GNN_T_AFTER == "after ";
    assert GNN_T_LAYER == " message-passing layer";
    assert GNN_T_PLURAL == "s";
    assert GNN_T_EMBED == ", this node's embedding";
    assert GNN_T_AGG == "aggregated information from every node listed above.";
    // the header of node 10 at k = 2 names kind, name and id as the web page does:
    //   gather for TASK "fix seals #6810" at k = 2:
    assert gnn_node_kind_name(10) == "TASK";
    assert gnn_node_name(10) == "fix seals";
    assert gnn_node_id(10) == "#6810";
    assert GNN_K_NAMES[1] == "k = 2";
    assert GNN_IDLE_LINES[3] == "gather into it.";
}
