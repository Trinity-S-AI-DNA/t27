pub const GNN_N_NAME : [17]str = ["reviewer", "runner", "porter", "(bare pid)", "offer", "offer", "result", "result", "cancel", "port HUD paint", "fix seals", "verify receipt", "diff", "receipt.json", ".t27 spec", ".t27 spec", ".t27 spec"];

/// Per edge: source, target, kind (GNN_EK_*) and label (LABEL_*). Edge order is the web page's.
