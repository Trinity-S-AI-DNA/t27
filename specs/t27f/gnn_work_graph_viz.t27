pub const GNN_E_TO : [17]u32 = [4, 9, 14, 5, 10, 15, 6, 10, 12, 12, 7, 11, 13, 16, 13, 8, 10];
pub const GNN_E_KIND : [17]u32 = [2, 1, 0, 2, 1, 0, 2, 1, 3, 4, 2, 1, 3, 0, 4, 2, 5];
pub const GNN_E_LABEL : [17]u32 = [0, 0, 1, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0, 0];

/// Hand-read from the edge list and NOT computed: the oracle the tests check the code against.
/// The neighbours of node v, either direction, in edge order, four slots per node padded with
/// GNN_NO_NODE (the largest degree is 4, node 10); the degrees sum to 2 * 17 = 34.
pub const GNN_HAND_NBR : [68]u32 = [
    4, 12, 65535, 65535,
    7, 8, 65535, 65535,
    5, 6, 65535, 65535,
    13, 65535, 65535, 65535,
    0, 9, 65535, 65535,
    2, 10, 65535, 65535,
