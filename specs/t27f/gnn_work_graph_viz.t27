; ---------------------------------------------------------------- constants

/// The fixture: 17 nodes and 17 edges, so 17 focusable items (the nodes; edges are not entities here).
pub const GNN_NODE_COUNT : u32 = 17;
pub const GNN_EDGE_COUNT : u32 = 17;

/// The depth control: k = 1, 2 or 3 message-passing layers. The contract's param is k - 1, 0..2.
pub const GNN_K_MIN : u32 = 1;
pub const GNN_K_MAX : u32 = 3;
/// The page has no stepper: one step.
pub const GNN_STEPS : u32 = 1;

/// "No node", a distance that was never reached, "nothing under the pointer".
pub const GNN_NO_NODE : u32 = 65535;
pub const GNN_FAR : u32 = 65535;
pub const GNN_NO_PICK : u32 = 65535;
/// No event: the pointer or key did nothing. Past every contract event.
pub const GNN_EV_NONE : u8 = 255;

