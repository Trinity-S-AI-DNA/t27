// specs/t27f/theme_contract.t27 -- uikit: theme contract for design tokens.
// Part of M1 (milestone #5). Closes #14051.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::theme_contract;

pub const THEME_BACKGROUND : str = "#000000";
pub const THEME_TEXT : str = "#ffffff";

pub struct DesignToken { name: str, value: str };

pub fn design_token_value(t: DesignToken) -> str {
    return t.value;
}

test "theme background is black" {
    assert(THEME_BACKGROUND == "#000000");
}

test "theme text is white" {
    assert(THEME_TEXT == "#ffffff");
}

test "design token value" {
    assert(design_token_value(DesignToken { name: "bg", value: "#000000" }) == "#000000");
}

invariant theme_has_background {
    assert THEME_BACKGROUND == "#000000";
}