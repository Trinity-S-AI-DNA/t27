// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_tests.t27 -- scene A_TESTS of reel_factory.t27: the lesson's code as a test run.
// Each line of the lesson is a row; a row whose line holds an `assert` shows a ticked box, a bar as
// long as the line and PASS, a `test` header row shows a bar in the accent, any other line a dim bar.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: the lessons that teach by asserting (expressions, constants, trits) are mostly asserts, and
// the picture says so: a column of green PASS rows, as many as the lesson has asserts.
//
// THE FUNCTION: tests_px(t, acc, n, x, y) is the colour of canvas point (x, y). Rows are 22 pixels
// apart from y = 90, at most 24; a lesson with more lines draws its first 24.
//
// NOT CLAIMED: it runs nothing; the ticks are the lines that contain the word assert.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_tests;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::near_seg;
use t27f::scene_raster::char_on;
use t27f::scene_raster::imin;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_n;
use t27f::scene_lex::lex_line;
use t27f::scene_lex::lex_llen;
use t27f::scene_lex::lex_has;
use t27f::scene_lex::lex_lines_with;
use t27f::scene_lex::KW_ASSERT;
use t27f::scene_lex::KW_TEST;

pub const ROW_Y0 : i32 = 90;
pub const ROW_H : i32 = 22;
pub const MAXR : i32 = 24;
pub const PASS_GREEN : i32 = 0x4ADE80;
pub const DIM : i32 = 0x2A3050;

pub fn row_n(t: usize) -> i32 {
    return imin(lex_n(t), MAXR);
}

pub fn tests_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(2, acc, seed_of(t, n, 2), x, y);
    if (y < ROW_Y0) { return c0; }
    const r = @divTrunc(y - ROW_Y0, ROW_H);
    if (r >= row_n(t)) { return c0; }
    const oy = ROW_Y0 + r * ROW_H;
    if (y - oy < 3 || y - oy > 18) { return c0; }
    const l = lex_line(t, r);
    const ok = lex_has(l, KW_ASSERT);
    const head = lex_has(l, KW_TEST);
    // the box, with a tick in it for a passing row
    if (in_rect(x, y, 16, oy + 3, 36, oy + 19)) {
        if (!in_rect(x, y, 18, oy + 5, 34, oy + 17)) {
            if (ok) { return PASS_GREEN; }
            if (head) { return acc; }
            return DIM;
        }
        if (ok && (near_seg(x, y, 20, oy + 11, 25, oy + 15, 1) || near_seg(x, y, 25, oy + 15, 32, oy + 7, 1))) {
            return PASS_GREEN;
        }
        return rgb(8, 10, 20);
    }
    // the bar: as long as the line
    const blen = 8 + lex_llen(l) * 5;
    if (in_rect(x, y, 46, oy + 5, 46 + blen, oy + 17)) {
        if (ok) { return mix(rgb(10, 40, 24), PASS_GREEN, 150); }
        if (head) { return mix(rgb(20, 20, 40), acc, 220); }
        return DIM;
    }
    // PASS at the right
    if (ok && x >= 300) {
        const k = @divTrunc(x - 300, 14);
        if (k < 4 && y >= oy + 6) {
            var ch = 80;
            if (k == 1) { ch = 65; }
            if (k >= 2) { ch = 83; }
            if (char_on(ch, x, y, 300 + k * 14, oy + 6, 3)) { return PASS_GREEN; }
        }
    }
    return c0;
}

// ---- tests ----

test "a row per line and a green row per assert" {
    var t : usize = 0;
    while (t < 27) {
        assert(row_n(t) >= 1 && row_n(t) <= MAXR);
        t = t + 1;
    }
    // lesson 8, Expressions, is a column of asserts; lesson 3 has none
    assert(lex_lines_with(8, KW_ASSERT) >= 3);
    var green : i32 = 0;
    var y : i32 = ROW_Y0;
    while (y < ROW_Y0 + MAXR * ROW_H) {
        if (tests_px(8, 0xF5B700, 8, 26, y) == PASS_GREEN) { green = green + 1; }
        y = y + 1;
    }
    assert(green > 30);
}

test "the rows are the lesson's lines: another lesson draws another run" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = tests_px(8, 0x3B82F6, 8, x, y);
            const b = tests_px(21, 0x3B82F6, 8, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 4000);
}

test "negative control: a lesson without an assert shows no PASS" {
    var green : i32 = 0;
    var y : i32 = ROW_Y0;
    while (y < ROW_Y0 + MAXR * ROW_H) {
        var x : i32 = 300;
        while (x < 360) {
            if (tests_px(3, 0xF5B700, 1, x, y) == PASS_GREEN) { green = green + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(lex_lines_with(3, KW_ASSERT) == 0);
    assert(green == 0);
}
