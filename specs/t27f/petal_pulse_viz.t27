; ---------------------------------------------------------------- constants

/// The petal index of N in the plan and the menu.
pub const PNV_PETAL : u32 = 13;

/// The fixture: six domains, five ticks, seven choices (the recorded data, or one added commit in
/// one of the six domains).
pub const PNV_DOMAINS : u32 = 6;
pub const PNV_TICKS : u32 = 5;
pub const PNV_CHOICES : u32 = 7;
/// A timeline cell (d, t) is the entity viz_ref(CELL, d * PNV_STRIDE + t).
pub const PNV_STRIDE : u32 = 8;

/// The menu petal each fixture domain stands for: A, D, J, N, U and Ti.
pub const PNV_LETTERS : [6]u32 = [0, 3, 9, 13, 20, 26];

/// "No domain" is not a valid number; PNV_ST_NONE is the status and PNV_BUCKET_NONE the bucket of a
/// cell that is not drawn (the source's classes are 1..4).
pub const PNV_NO_DOMAIN : u32 = 65535;
pub const PNV_ST_NONE : u32 = 0;
pub const PNV_BUCKET_NONE : u32 = 99;

/// The recorded clock: tick 0 is PNV_T0 (unix seconds), every tick adds PNV_TICK_DAYS days.
pub const PNV_T0 : u64 = 1792000000;
pub const PNV_TICK_DAYS : u64 = 2;

/// The added commit: choice c (1..6) adds one commit to domain c - 1 at the time of tick
/// PNV_EVENT_TICK, seen from that tick on and never before it. Choice 0 is the recorded data.
pub const PNV_EVENT_TICK : u32 = 1;
pub const PNV_CHOICE_RECORDED : u32 = 0;

/// The feeds the loader reads: the recorded logs, no logs at all, and a log with a record that has
/// no commit time (domain PNV_BAD_DOMAIN), which the loader reports as error PNV_ERR_BAD_RECORD.
pub const PNV_FEED_FIXTURE : u8 = 0;
pub const PNV_FEED_EMPTY : u8 = 1;
pub const PNV_FEED_BAD_RECORD : u8 = 2;
pub const PNV_BAD_DOMAIN : u32 = 2;
pub const PNV_ERR_BAD_RECORD : u32 = 3;

/// The length of the sweep animation between two ticks, before the motion preference.
pub const PNV_SWEEP_MS : u32 = 240;

/// Pixel geometry in frame coordinates: the badge on top, the timeline left (a label column then a
/// column per tick) and the chart right (a column per class).
pub const PNV_FRAME_W : u32 = 640;
pub const PNV_BADGE_H : u32 = 40;
pub const PNV_ROW_H : u32 = 32;
pub const PNV_CELL_W : u32 = 64;
pub const PNV_LABEL_W : u32 = 56;
pub const PNV_TL_X : u32 = 8;
pub const PNV_TL_Y : u32 = 48;
pub const PNV_TL_W : u32 = 376;
pub const PNV_TL_H : u32 = 192;
pub const PNV_CH_X : u32 = 400;
pub const PNV_CH_Y : u32 = 48;
pub const PNV_CH_W : u32 = 224;
pub const PNV_CH_H : u32 = 192;
pub const PNV_BAR_COL : u32 = 56;
pub const PNV_BAR_W : u32 = 48;
pub const PNV_BAR_UNIT : u32 = 32;

/// Host slot numbers, in the order pnv_host adds them.
pub const PNV_SLOT_BADGE : u32 = 0;
pub const PNV_SLOT_TIMELINE : u32 = 1;
pub const PNV_SLOT_CHART : u32 = 2;

/// Hand-read from the logs of pnv_log and the lamp rule of the source spec, NOT computed: the oracle
/// the tests check the code against. Index domain * 5 + tick; 1 quiet, 2 warm, 3 active, 4 blocked.
pub const PNV_HAND_STATUS : [30]u32 = [
    3, 3, 3, 3, 3,    // domain 0 (A): a commit every day or so, always active
    3, 2, 2, 2, 1,    // domain 1 (D): active, then ages into warm, quiet at a full week
    1, 1, 1, 3, 2,    // domain 2 (J): quiet, then a commit lights it, then it cools
    3, 4, 2, 2, 2,    // domain 3 (N): red at tick 1, blocked wins over warm
    1, 1, 1, 1, 4,    // domain 4 (U): never committed, quiet, red at tick 4
    2, 2, 2, 2, 1     // domain 5 (Ti): warm, exactly one day at tick 1, exactly a week at tick 4
];

/// Hand-read age buckets of the same cells (0 = the last 24 hours, 7 = older than a week or never).
pub const PNV_HAND_BUCKET : [30]u32 = [
    0, 0, 0, 0, 0,
    0, 1, 3, 5, 7,
    7, 7, 7, 0, 2,
    0, 2, 1, 3, 5,
    7, 7, 7, 7, 7,
    6, 1, 3, 5, 7
];

/// Hand-read time of each domain's last commit at tick 1 (0 = never committed).
pub const PNV_HAND_LAST1 : [6]u64 = [1792144000, 1792072000, 1791316000, 1791928000, 0, 1792086400];

; ---------------------------------------------------------------- L2 entities

/// Domain d as an entity; VIZ_REF_NONE when d is not a domain.
pub fn pnv_domain_ref(d: u32) -> u32 {
    if (d >= PNV_DOMAINS) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_NODE, d);
}

/// The timeline cell (domain d, tick t) as an entity; VIZ_REF_NONE when either is out of range.
pub fn pnv_cell_ref(d: u32, t: u32) -> u32 {
    if (d >= PNV_DOMAINS or t >= PNV_TICKS) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_CELL, d * PNV_STRIDE + t);
}

/// The domain an entity belongs to: a domain itself, or the row of a timeline cell. PNV_NO_DOMAIN
/// for nothing, an edge, or an index past the fixture.
pub fn pnv_ref_domain(r: u32) -> u32 {
    let kind : u32 = viz_ref_kind(r);
    let idx : u32 = viz_ref_index(r);
    if (kind == VIZ_ENT_NODE and idx < PNV_DOMAINS) {
        return idx;
    }
    if (kind == VIZ_ENT_CELL and idx / PNV_STRIDE < PNV_DOMAINS and idx % PNV_STRIDE < PNV_TICKS) {
        return idx / PNV_STRIDE;
    }
    return PNV_NO_DOMAIN;
}

/// The entity of focus index f: the domains 0..5. VIZ_REF_NONE past the end or before any load.
pub fn pnv_focus_ref(s: VizState, f: u32) -> u32 {
    if (f >= s.focus_count or f >= PNV_DOMAINS) {
        return VIZ_REF_NONE;
    }
    return pnv_domain_ref(f);
}

/// How a domain is lit in EVERY view: the contract's highlight of the domain itself or of any of its
/// timeline cells, selection before hover. A row is lit when its domain is selected or hovered.
pub fn pnv_domain_hl(s: VizState, d: u32) -> u8 {
    if (d >= PNV_DOMAINS) {
        return VIZ_HL_NONE;
    }
    if (pnv_ref_domain(s.selected) == d) {
        return VIZ_HL_SELECT;
    }
    if (pnv_ref_domain(s.hover) == d) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

/// The letter byte of domain d, from the menu's petal letters; 0 for a number that is not a domain.
pub fn pnv_letter(d: u32) -> u32 {
    if (d >= PNV_DOMAINS) {
        return 0;
    }
    return petal_letter_byte(PNV_LETTERS[d as usize]) as u32;
}

; ---------------------------------------------------------------- L3 rules: the recorded logs asked of the source

/// The recorded commit log of domain d, in the source's record format: per commit a 0x1e byte, a
/// hash, a 0x1f byte, ten digits of unix time, a 0x1f byte, a subject, a blank line and a path (20
/// bytes). Domain 4 has never committed (empty). "" for a number that is not a domain.
pub fn pnv_log(d: u32) -> string {
    if (d == 0) {
        return "\x1eh0\x1f1791978400\x1fs\n\nf\n\x1eh0\x1f1792144000\x1fs\n\nf\n\x1eh0\x1f1792324000\x1fs\n\nf\n\x1eh0\x1f1792468000\x1fs\n\nf\n\x1eh0\x1f1792648000\x1fs\n\nf\n";
    }
    if (d == 1) {
        return "\x1eh0\x1f1791992800\x1fs\n\nf\n\x1eh0\x1f1792072000\x1fs\n\nf\n";
    }
    if (d == 2) {
        return "\x1eh0\x1f1791316000\x1fs\n\nf\n\x1eh0\x1f1792504000\x1fs\n\nf\n";
    }
    if (d == 3) {
        return "\x1eh0\x1f1791928000\x1fs\n\nf\n\x1eh0\x1f1792216000\x1fs\n\nf\n";
    }
    if (d == 5) {
        return "\x1eh0\x1f1791460000\x1fs\n\nf\n\x1eh0\x1f1792086400\x1fs\n\nf\n";
    }
    return "";
}

/// The unix time of tick t on the recorded clock: PNV_T0 plus PNV_TICK_DAYS days (the source's DAY)
/// per tick.
pub fn pnv_now(t: u32) -> u64 {
    return PNV_T0 + (t as u64) * PNV_TICK_DAYS * DAY;
}

/// The time of the added commit: the clock of the tick it is added at.
pub fn pnv_event_time() -> u64 {
    return pnv_now(PNV_EVENT_TICK);
}

/// The time of the newest commit in a log that is not after now; 0 when there is none. The records
/// are cut and timed by the source's rec_next and rec_time.
pub fn pnv_last(log: string, now: u64) -> u64 {
    var best : u64 = 0;
    var rs : u32 = 0;
    const n : u32 = log.len as u32;
    while (rs < n) {
        let nxt : u32 = rec_next(log, rs + 1);
        let ct : u64 = rec_time(log, rs, nxt);
        if (ct <= now and ct > best) {
            best = ct;
        }
        rs = nxt;
    }
    return best;
}

/// Whether every record of a log has a commit time (the source's rec_time answers 0 for a record it
/// cannot read). An empty log has no record, so it is fine.
pub fn pnv_log_ok(log: string) -> bool {
    var at : u32 = 0;
    const n : u32 = log.len as u32;
    while (at < n) {
        let nxt : u32 = rec_next(log, at + 1);
        if (rec_time(log, at, nxt) == 0) {
            return false;
        }
        at = nxt;
    }
    return true;
}

/// Whether the lamp of domain d is red at tick t. The source keeps no red list to read, so the two
/// recorded red ticks are petal-side: domain 3 at tick 1 and domain 4 at tick 4.
pub fn pnv_red(d: u32, t: u32) -> bool {
    if (d == 3 and t == 1) {
        return true;
    }
    if (d == 4 and t == 4) {
        return true;
    }
    return false;
}

/// The time of the last commit of domain d seen at tick t under choice c: the newest recorded commit
/// not after the tick's clock, or the added commit when choice c = d + 1 added one and it is newer.
/// 0 when never committed or when d or t is not in the fixture.
pub fn pnv_last_at(d: u32, t: u32, c: u32) -> u64 {
    if (d >= PNV_DOMAINS or t >= PNV_TICKS) {
        return 0;
    }
    let rec : u64 = pnv_last(pnv_log(d), pnv_now(t));
    if (c == d + 1 and t >= PNV_EVENT_TICK and pnv_event_time() > rec) {
        return pnv_event_time();
    }
    return rec;
}

/// The class of domain d at tick t under choice c, asked of the source's status_of (ST_QUIET,
/// ST_WARM, ST_ACTIVE or ST_BLOCKED); PNV_ST_NONE for a domain, tick or choice that is not.
pub fn pnv_status_at(d: u32, t: u32, c: u32) -> u32 {
    if (d >= PNV_DOMAINS or t >= PNV_TICKS or c >= PNV_CHOICES) {
        return PNV_ST_NONE;
    }
    return status_of(pnv_now(t), pnv_last_at(d, t, c), pnv_red(d, t));
}

/// The age bucket of domain d at tick t under choice c, asked of the source's bucket_of; BUCKETS for
/// a domain never committed (older than any week), PNV_BUCKET_NONE for a cell that is not in the fixture.
pub fn pnv_bucket_at(d: u32, t: u32, c: u32) -> u32 {
    if (d >= PNV_DOMAINS or t >= PNV_TICKS or c >= PNV_CHOICES) {
        return PNV_BUCKET_NONE;
    }
    let last : u64 = pnv_last_at(d, t, c);
    if (last == 0) {
        return BUCKETS;
    }
    return bucket_of(pnv_now(t) - last);
}

/// How many domains have class st at tick t under choice c.
pub fn pnv_count(t: u32, c: u32, st: u32) -> u32 {
    var n : u32 = 0;
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        if (pnv_status_at(d, t, c) == st) {
            n = n + 1;
        }
        d = d + 1;
    }
    return n;
}

; ---------------------------------------------------------------- L4 truth

/// The truth label for a stored truth and a choice: the recorded data keeps the stored label, an
/// added commit is a what-if on logs that were not recorded, so a label that may claim a result
/// (LIVE or VERIFIED, viz_may_claim) drops to DEMO. CACHED and UNKNOWN stay as they are, and a truth
/// code outside the table is UNKNOWN (viz_truth).
pub fn pnv_truth_for(t: u8, param: u32) -> u8 {
    let c : u8 = viz_truth(t);
    if (viz_may_claim(c) and param != PNV_CHOICE_RECORDED) {
        return VIZ_TRUTH_DEMO;
    }
    return c;
}

/// The truth the petal shows: derived from the one VizState, so a reload that keeps the choice keeps
/// the DEMO label with no second copy of the truth to forget.
pub fn pnv_truth(s: VizState) -> u8 {
    return pnv_truth_for(s.truth, s.param);
}

; ---------------------------------------------------------------- L1 state: load and open

/// A petal that has not loaded: idle, truth UNKNOWN, five ticks, seven choices.
pub fn pnv_idle() -> VizState {
    return viz_init(PNV_TICKS, PNV_CHOICES);
}

/// How many domains a feed holds.
pub fn pnv_feed_count(feed: u8) -> u32 {
    if (feed == PNV_FEED_EMPTY) {
        return 0;
    }
    return PNV_DOMAINS;
}

/// The log the feed holds for domain d; the bad-record feed has one record without a commit time.
pub fn pnv_feed_log(feed: u8, d: u32) -> string {
    if (feed == PNV_FEED_BAD_RECORD and d == PNV_BAD_DOMAIN) {
        return "\x1ebad\n";
    }
    return pnv_log(d);
}

/// The first domain of the feed whose log has a record without a commit time; PNV_NO_DOMAIN when
/// every log is readable.
pub fn pnv_feed_bad_domain(feed: u8) -> u32 {
    var d : u32 = 0;
    while (d < pnv_feed_count(feed)) {
        if (pnv_log_ok(pnv_feed_log(feed, d)) == false) {
            return d;
        }
        d = d + 1;
    }
    return PNV_NO_DOMAIN;
}

/// The truth a feed loads with: no logs prove nothing (UNKNOWN), the recorded ones are VERIFIED (the
/// source's rules over their own record format).
pub fn pnv_feed_truth(feed: u8) -> u8 {
    if (feed == PNV_FEED_EMPTY) {
        return VIZ_TRUTH_UNKNOWN;
    }
    return VIZ_TRUTH_VERIFIED;
}

/// Load a feed into a state: LOAD, then LOADED with its domain count and truth, or FAILED when a log
/// has an unreadable record. The tick, the choice and the motion preference stay as they were.
pub fn pnv_reload(s: VizState, feed: u8) -> VizState {
    let loading : VizState = viz_apply(s, VIZ_EV_LOAD, 0, 0);
    if (pnv_feed_bad_domain(feed) != PNV_NO_DOMAIN) {
        return viz_apply(loading, VIZ_EV_FAILED, PNV_ERR_BAD_RECORD, 0);
    }
    let truth : u32 = pnv_feed_truth(feed) as u32;
    return viz_apply(loading, VIZ_EV_LOADED, pnv_feed_count(feed), truth);
}

/// A fresh petal loaded from one feed.
pub fn pnv_load(feed: u8) -> VizState {
    return pnv_reload(pnv_idle(), feed);
}

/// A petal ready to explore: the recorded logs, READY, six domains focusable, revision 2.
pub fn pnv_open() -> VizState {
    return pnv_load(PNV_FEED_FIXTURE);
}

/// The input change: add one commit to domain d (PARAM_SET d + 1). A number that is not a domain
/// changes nothing.
pub fn pnv_add_event(s: VizState, d: u32) -> VizState {
    if (d >= PNV_DOMAINS) {
        return s;
    }
    return viz_apply(s, VIZ_EV_PARAM_SET, d + 1, 0);
}

/// Take the added commit away again: back to the recorded data.
pub fn pnv_clear_event(s: VizState) -> VizState {
    return viz_apply(s, VIZ_EV_PARAM_SET, PNV_CHOICE_RECORDED, 0);
}

; ---------------------------------------------------------------- L5 views

/// The label of one timeline row: the domain, its letter, its class at the tick the stepper is on and
/// how it is lit.
pub struct PnvRow {
    domain: u32,
    ent: u32,
    letter: u32,
    status: u32,
    hl: u8,
    focused: bool,
    y: u32,
}

/// One cell of the timeline: the class and age bucket of a domain at a tick, lit exactly (hl) and by
/// its row (row_hl), and whether it is the tick the stepper is on.
pub struct PnvCell {
    domain: u32,
    tick: u32,
    ent: u32,
    status: u32,
    bucket: u32,
    hl: u8,
    row_hl: u8,
    now: bool,
    x: u32,
    y: u32,
}

/// One bar of the chart: how many domains have the class at the tick the stepper is on, the bar
/// rectangle and how it is lit (by the selected or hovered domain being of that class).
pub struct PnvBar {
    status: u32,
    count: u32,
    hl: u8,
    x: u32,
    y: u32,
    w: u32,
    h: u32,
}

/// The badge: the lifecycle, the truth label, whether it may claim a result, the four counts and the
/// moving count at the tick and choice the state is on, the badge colour and the sweep time under
/// the motion preference.
pub struct PnvBadge {
    lifecycle: u8,
    truth: u8,
    may_claim: bool,
    active: u32,
    warm: u32,
    quiet: u32,
    blocked: u32,
    moving: u32,
    rgb: u32,
    motion_ms: u32,
}

/// The y of the timeline row of domain d.
pub fn pnv_row_y(d: u32) -> u32 {
    return PNV_TL_Y + d * PNV_ROW_H;
}

/// The x of the timeline column of tick t.
pub fn pnv_cell_x(t: u32) -> u32 {
    return PNV_TL_X + PNV_LABEL_W + t * PNV_CELL_W;
}

/// The x of the chart bar of class st (1..4, in the order quiet, warm, active, blocked); 0 for a
/// number that is not a class.
pub fn pnv_bar_x(st: u32) -> u32 {
    if (st < ST_QUIET or st > ST_BLOCKED) {
        return 0;
    }
    return PNV_CH_X + (st - ST_QUIET) * PNV_BAR_COL;
}

/// How a class bar is lit: SELECT when the selected domain is of that class at the tick the stepper
/// is on, else HOVER when the hovered domain is, else NONE. Nothing is lit until the view is READY.
pub fn pnv_bar_hl(s: VizState, st: u32) -> u8 {
    if (s.lifecycle != VIZ_LC_READY) {
        return VIZ_HL_NONE;
    }
    let sd : u32 = pnv_ref_domain(s.selected);
    if (sd != PNV_NO_DOMAIN and pnv_status_at(sd, s.step, s.param) == st) {
        return VIZ_HL_SELECT;
    }
    let hd : u32 = pnv_ref_domain(s.hover);
    if (hd != PNV_NO_DOMAIN and pnv_status_at(hd, s.step, s.param) == st) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

/// The timeline row of domain d in state s. Nothing is drawn (status NONE, no light) until the view
/// is READY.
pub fn pnv_timeline_row(s: VizState, d: u32) -> PnvRow {
    var st : u32 = PNV_ST_NONE;
    var hl : u8 = VIZ_HL_NONE;
    if (s.lifecycle == VIZ_LC_READY) {
        st = pnv_status_at(d, s.step, s.param);
        hl = pnv_domain_hl(s, d);
    }
    return PnvRow { domain: d, ent: pnv_domain_ref(d), letter: pnv_letter(d), status: st, hl: hl, focused: d < PNV_DOMAINS and viz_is_focused(s, d), y: pnv_row_y(d) };
}

/// The timeline cell (d, t) in state s. Nothing is drawn until the view is READY.
pub fn pnv_timeline_cell(s: VizState, d: u32, t: u32) -> PnvCell {
    let ent : u32 = pnv_cell_ref(d, t);
    var st : u32 = PNV_ST_NONE;
    var bk : u32 = PNV_BUCKET_NONE;
    var hl : u8 = VIZ_HL_NONE;
    var row : u8 = VIZ_HL_NONE;
    if (s.lifecycle == VIZ_LC_READY) {
        st = pnv_status_at(d, t, s.param);
        bk = pnv_bucket_at(d, t, s.param);
        hl = viz_highlight(s, ent);
        row = pnv_domain_hl(s, d);
    }
    return PnvCell { domain: d, tick: t, ent: ent, status: st, bucket: bk, hl: hl, row_hl: row, now: (t == s.step), x: pnv_cell_x(t), y: pnv_row_y(d) };
}

/// The chart bar of class st in state s: the count of domains of that class at the tick and choice
/// the state is on, drawn as a bar that grows up from the chart floor by PNV_BAR_UNIT per domain.
/// The count is 0 until the view is READY, and for a number that is not a class.
pub fn pnv_chart_bar(s: VizState, st: u32) -> PnvBar {
    var n : u32 = 0;
    var hl : u8 = VIZ_HL_NONE;
    if (s.lifecycle == VIZ_LC_READY) {
        n = pnv_count(s.step, s.param, st);
        hl = pnv_bar_hl(s, st);
    }
    return PnvBar { status: st, count: n, hl: hl, x: pnv_bar_x(st), y: PNV_CH_Y + PNV_CH_H - n * PNV_BAR_UNIT, w: PNV_BAR_W, h: n * PNV_BAR_UNIT };
}

/// The badge of state s. The counts are 0 until the view is READY.
pub fn pnv_badge(s: VizState) -> PnvBadge {
    let t : u8 = pnv_truth(s);
    var a : u32 = 0;
    var w : u32 = 0;
    var q : u32 = 0;
    var b : u32 = 0;
    if (s.lifecycle == VIZ_LC_READY) {
        a = pnv_count(s.step, s.param, ST_ACTIVE);
        w = pnv_count(s.step, s.param, ST_WARM);
        q = pnv_count(s.step, s.param, ST_QUIET);
        b = pnv_count(s.step, s.param, ST_BLOCKED);
    }
    return PnvBadge { lifecycle: s.lifecycle, truth: t, may_claim: viz_may_claim(t), active: a, warm: w, quiet: q, blocked: b, moving: a + w, rgb: viz_truth_rgb(t), motion_ms: viz_motion_ms(s, PNV_SWEEP_MS) };
}

; ---------------------------------------------------------------- L5 hit tests and inputs

/// The entity under a point of the timeline: the domain in the label column, the cell right of it;
/// VIZ_REF_NONE outside the rows and cells.
pub fn pnv_timeline_hit(px: u32, py: u32) -> u32 {
    if (px < PNV_TL_X or py < PNV_TL_Y) {
        return VIZ_REF_NONE;
    }
    let dx : u32 = px - PNV_TL_X;
    let row : u32 = (py - PNV_TL_Y) / PNV_ROW_H;
    if (dx < PNV_LABEL_W) {
        return pnv_domain_ref(row);
    }
    return pnv_cell_ref(row, (dx - PNV_LABEL_W) / PNV_CELL_W);
}

/// The entity under a point of the frame: the host decides which view lies under it, the timeline
/// answers. The badge, the chart (its bars are counts, not entities) and the gaps hold no entity.
pub fn pnv_pick(px: u32, py: u32) -> u32 {
    if (vh_hit(pnv_host(), px, py) == PNV_SLOT_TIMELINE) {
        return pnv_timeline_hit(px, py);
    }
    return VIZ_REF_NONE;
}

/// A click at a point: SELECT of the entity under it. Clicking the selected entity, or a gap while
/// something is selected, clears the selection (the contract's rule).
pub fn pnv_click(s: VizState, px: u32, py: u32) -> VizState {
    return viz_apply(s, VIZ_EV_SELECT, pnv_pick(px, py), 0);
}

/// The pointer at a point: HOVER of the entity under it, VIZ_REF_NONE over a gap.
pub fn pnv_hover(s: VizState, px: u32, py: u32) -> VizState {
    return viz_apply(s, VIZ_EV_HOVER, pnv_pick(px, py), 0);
}

/// ACTIVATE on the focused domain: the same as clicking it. Nothing focused is a no-op.
pub fn pnv_activate(s: VizState) -> VizState {
    let r : u32 = pnv_focus_ref(s, s.focus);
    if (r == VIZ_REF_NONE) {
        return s;
    }
    return viz_apply(s, VIZ_EV_ACTIVATE, r, 0);
}

; ---------------------------------------------------------------- L6 host

/// The layout: the badge across the top, the timeline below it on the left, the chart on the right.
/// Every rect is in frame coordinates, relative to the host's origin.
pub fn pnv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, 0, 0, PNV_FRAME_W, PNV_BADGE_H);
    h = vh_add(h, VIZ_REP_TIMELINE, VH_ROOT, PNV_TL_X, PNV_TL_Y, PNV_TL_W, PNV_TL_H);
    h = vh_add(h, VIZ_REP_CHART, VH_ROOT, PNV_CH_X, PNV_CH_Y, PNV_CH_W, PNV_CH_H);
    return h;
}

/// The reps of the petal: the timeline, the chart and the badge.
pub fn pnv_reps() -> u32 {
    let shown : u32 = viz_rep_bit(VIZ_REP_TIMELINE) + viz_rep_bit(VIZ_REP_CHART);
    return shown + viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// A ready petal on a given tick and choice.
fn pnv_at(step: u32, choice: u32) -> VizState {
    var s : VizState = pnv_open();
    s = viz_apply(s, VIZ_EV_STEP_SET, step, 0);
    s = viz_apply(s, VIZ_EV_PARAM_SET, choice, 0);
    return s;
}

/// Four selections the view tests walk: none; domain 3 selected; cell (2, 3) selected with domain 5
/// hovered; cell (4, 0) hovered.
fn pnv_pose(s: VizState, k: u32) -> VizState {
    if (k == 1) {
        return viz_apply(s, VIZ_EV_SELECT, pnv_domain_ref(3), 0);
    }
    if (k == 2) {
        let picked : VizState = viz_apply(s, VIZ_EV_SELECT, pnv_cell_ref(2, 3), 0);
        return viz_apply(picked, VIZ_EV_HOVER, pnv_domain_ref(5), 0);
    }
    if (k == 3) {
        return viz_apply(s, VIZ_EV_HOVER, pnv_cell_ref(4, 0), 0);
    }
    return s;
}

/// How many timeline rows of the state show class st.
fn pnv_rows_with(s: VizState, st: u32) -> u32 {
    var n : u32 = 0;
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        if (pnv_timeline_row(s, d).status == st) {
            n = n + 1;
        }
        d = d + 1;
    }
    return n;
}

; ---------------------------------------------------------------- tests: state and the one reducer

test a_fresh_petal_is_idle_unknown_draws_nothing_and_ignores_input {
    let s : VizState = pnv_idle();
    assert s.lifecycle == VIZ_LC_IDLE;
    assert s.truth == VIZ_TRUTH_UNKNOWN;
    assert s.revision == 0;
    assert s.step_count == PNV_TICKS;
    let b : PnvBadge = pnv_badge(s);
    assert b.truth == VIZ_TRUTH_UNKNOWN;
    assert b.may_claim == false;
    assert b.active + b.warm + b.quiet + b.blocked + b.moving == 0;
    assert pnv_timeline_row(s, 0).status == PNV_ST_NONE;
    assert pnv_timeline_cell(s, 0, 0).bucket == PNV_BUCKET_NONE;
    assert pnv_chart_bar(s, ST_ACTIVE).count == 0;
    assert pnv_bar_hl(s, ST_ACTIVE) == VIZ_HL_NONE;
    assert viz_apply(s, VIZ_EV_SELECT, pnv_domain_ref(1), 0).revision == 0;
    assert viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0).focus == VIZ_NO_FOCUS;
    assert pnv_click(s, 20, 60).revision == 0;
    assert pnv_add_event(s, 2).param == 0;
    assert viz_apply(s, VIZ_EV_MOTION, 1, 0).reduced_motion == 1;
}

test opening_gives_a_ready_view_and_a_reload_keeps_the_tick_and_the_choice {
    let s : VizState = pnv_open();
    assert s.lifecycle == VIZ_LC_READY;
    assert s.truth == VIZ_TRUTH_VERIFIED;
    assert s.error == 0;
    assert s.step == 0;
    assert s.param == 0;
    assert s.selected == VIZ_REF_NONE;
    assert s.focus == VIZ_NO_FOCUS;
    assert s.revision == 2;
    let moved : VizState = pnv_at(3, 4);
    let again : VizState = pnv_reload(moved, PNV_FEED_FIXTURE);
    assert again.lifecycle == VIZ_LC_READY;
    assert again.step == 3;
    assert again.param == 4;
    assert again.revision == moved.revision + 2;
}

test hover_select_and_clear_go_through_the_one_contract_reducer {
    let s0 : VizState = pnv_open();
    let r2 : u32 = pnv_domain_ref(2);
    let hovered : VizState = viz_apply(s0, VIZ_EV_HOVER, r2, 0);
    assert hovered.hover == r2;
    assert hovered.revision == 3;
    let left : VizState = viz_apply(hovered, VIZ_EV_LEAVE, 0, 0);
    assert left.hover == VIZ_REF_NONE;
    let picked : VizState = viz_apply(left, VIZ_EV_SELECT, r2, 0);
    assert picked.selected == r2;
    assert picked.revision == 5;
    let toggled : VizState = viz_apply(picked, VIZ_EV_SELECT, r2, 0);
    assert toggled.selected == VIZ_REF_NONE;
    let cell : VizState = viz_apply(toggled, VIZ_EV_SELECT, pnv_cell_ref(1, 3), 0);
    assert cell.selected == pnv_cell_ref(1, 3);
    let cleared : VizState = viz_apply(cell, VIZ_EV_CLEAR, 0, 0);
    assert cleared.selected == VIZ_REF_NONE;
    assert cleared.revision == 8;
}

test stepping_and_the_choice_are_clamped_by_the_contract {
    let s0 : VizState = pnv_open();
    let far : VizState = viz_apply(s0, VIZ_EV_STEP_SET, 99, 0);
    assert far.step == 4;
    assert far.revision == 3;
    assert viz_apply(far, VIZ_EV_STEP_NEXT, 0, 0).revision == 3;
    assert viz_apply(far, VIZ_EV_STEP_PREV, 0, 0).step == 3;
    assert viz_apply(s0, VIZ_EV_STEP_PREV, 0, 0).revision == s0.revision;
    assert viz_apply(s0, VIZ_EV_PARAM_SET, 99, 0).param == 6;
    assert viz_apply(s0, VIZ_EV_PARAM_SET, 1, 0).param == 1;
    assert pnv_add_event(s0, 5).param == 6;
    assert pnv_add_event(s0, 0).param == 1;
    assert pnv_add_event(s0, PNV_DOMAINS).param == 0;
    assert pnv_add_event(s0, PNV_DOMAINS).revision == s0.revision;
}

; ---------------------------------------------------------------- tests: the rules come from domain_pulse

test the_clock_and_the_logs_are_cut_and_timed_by_the_source_record_parsers {
    assert pnv_now(0) == 1792000000;
    assert pnv_now(1) == 1792172800;
    assert pnv_now(3) - pnv_now(2) == 2 * DAY;
    assert pnv_event_time() == pnv_now(PNV_EVENT_TICK);
    // Five records of 20 bytes for domain 0, two for 1, 2, 3 and 5, none for 4.
    assert pnv_log(0).len == 100;
    assert pnv_log(1).len == 40;
    assert pnv_log(4).len == 0;
    assert rec_next(pnv_log(1), 1) == 20;
    assert rec_next(pnv_log(1), 21) == 40;
    assert rec_time(pnv_log(1), 0, 20) == 1791992800;
    // pnv_last keeps the newest commit that is not after now.
    assert pnv_last(pnv_log(0), pnv_now(0)) == 1791978400;
    assert pnv_last(pnv_log(0), pnv_now(4)) == 1792648000;
    assert pnv_last("", pnv_now(4)) == 0;
    assert pnv_last(pnv_log(2), pnv_now(2)) == 1791316000;
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        assert pnv_last(pnv_log(d), pnv_now(1)) == PNV_HAND_LAST1[d as usize];
        assert pnv_last_at(d, 1, PNV_CHOICE_RECORDED) == PNV_HAND_LAST1[d as usize];
        d = d + 1;
    }
    assert pnv_last_at(PNV_DOMAINS, 1, 0) == 0;
    assert pnv_last_at(0, PNV_TICKS, 0) == 0;
}

test the_status_follows_status_of_at_the_day_and_week_boundaries {
    // Straight from the source at tick 1 (now = 1792172800).
    assert status_of(1792172800, 1792086401, false) == ST_ACTIVE;
    assert status_of(1792172800, 1792086400, false) == ST_WARM;
    assert status_of(1792172800, 1791568001, false) == ST_WARM;
    assert status_of(1792172800, 1791568000, false) == ST_QUIET;
    assert status_of(1792172800, 0, false) == ST_QUIET;
    assert status_of(1792172800, 0, true) == ST_BLOCKED;
    // The same boundaries in the petal's cells: domain 5 is exactly a day old at tick 1 and exactly
    // a week old at tick 4; domain 4 never committed and is red at tick 4.
    assert pnv_status_at(5, 1, 0) == ST_WARM;
    assert pnv_bucket_at(5, 1, 0) == 1;
    assert pnv_status_at(5, 4, 0) == ST_QUIET;
    assert pnv_bucket_at(5, 4, 0) == BUCKETS;
    assert pnv_status_at(4, 0, 0) == ST_QUIET;
    assert pnv_bucket_at(4, 0, 0) == BUCKETS;
    assert pnv_status_at(4, 4, 0) == ST_BLOCKED;
    // The source's words and day buckets.
    assert status_text(ST_ACTIVE).len == 6;
    assert status_text(ST_WARM)[0] == 87;
    assert status_text(ST_QUIET)[0] == 81;
    assert bucket_of(DAY - 1) == 0;
    assert bucket_of(DAY) == 1;
    assert bucket_of(WEEK - 1) == 6;
    assert bucket_of(WEEK) == BUCKETS;
}

test the_thirty_cell_tables_match_the_hand_read_status_and_bucket {
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        var t : u32 = 0;
        while (t < PNV_TICKS) {
            let k : usize = (d * PNV_TICKS + t) as usize;
            assert pnv_status_at(d, t, 0) == PNV_HAND_STATUS[k];
            assert pnv_bucket_at(d, t, 0) == PNV_HAND_BUCKET[k];
            t = t + 1;
        }
        d = d + 1;
    }
    // A domain, tick or choice that is not in the fixture has no class and no bucket.
    assert pnv_status_at(PNV_DOMAINS, 0, 0) == PNV_ST_NONE; assert pnv_status_at(0, PNV_TICKS, 0) == PNV_ST_NONE;
    assert pnv_status_at(0, 0, PNV_CHOICES) == PNV_ST_NONE; assert pnv_bucket_at(PNV_DOMAINS, 0, 0) == PNV_BUCKET_NONE;
    assert pnv_bucket_at(0, PNV_TICKS, 0) == PNV_BUCKET_NONE; assert pnv_bucket_at(0, 0, PNV_CHOICES) == PNV_BUCKET_NONE;
}

test the_counts_split_the_six_domains_into_the_four_classes_at_each_tick {
    // (active, warm, quiet, blocked) at ticks 0 and 1, read by hand from the status table.
    assert pnv_count(0, 0, ST_ACTIVE) == 3; assert pnv_count(0, 0, ST_WARM) == 1;
    assert pnv_count(0, 0, ST_QUIET) == 2; assert pnv_count(0, 0, ST_BLOCKED) == 0;
    assert pnv_count(1, 0, ST_ACTIVE) == 1; assert pnv_count(1, 0, ST_WARM) == 2;
    assert pnv_count(1, 0, ST_QUIET) == 2; assert pnv_count(1, 0, ST_BLOCKED) == 1;
    // Every domain is in exactly one class, under every tick and choice.
    var t : u32 = 0;
    while (t < PNV_TICKS) {
        var c : u32 = 0;
        while (c < PNV_CHOICES) {
            assert pnv_count(t, c, ST_ACTIVE) + pnv_count(t, c, ST_WARM) + pnv_count(t, c, ST_QUIET) + pnv_count(t, c, ST_BLOCKED) == PNV_DOMAINS;
            c = c + 1;
        }
        t = t + 1;
    }
    assert pnv_count(0, 0, PNV_ST_NONE) == 0;
    assert pnv_count(PNV_TICKS, 0, ST_ACTIVE) == 0;
}

test entity_refs_pack_the_domain_and_the_cell_and_the_letters_come_from_the_menu {
    assert pnv_domain_ref(0) == 65536;
    assert pnv_domain_ref(5) == 65541;
    assert pnv_domain_ref(6) == VIZ_REF_NONE;
    assert pnv_cell_ref(0, 0) == 196608;
    assert pnv_cell_ref(5, 4) == 196652;
    assert pnv_cell_ref(5, 5) == VIZ_REF_NONE;
    assert pnv_cell_ref(6, 0) == VIZ_REF_NONE;
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        assert pnv_ref_domain(pnv_domain_ref(d)) == d;
        var t : u32 = 0;
        while (t < PNV_TICKS) {
            assert pnv_ref_domain(pnv_cell_ref(d, t)) == d;
            t = t + 1;
        }
        d = d + 1;
    }
    assert pnv_ref_domain(VIZ_REF_NONE) == PNV_NO_DOMAIN;
    assert pnv_ref_domain(viz_ref(VIZ_ENT_EDGE, 1)) == PNV_NO_DOMAIN;
    assert pnv_ref_domain(viz_ref(VIZ_ENT_CELL, 5)) == PNV_NO_DOMAIN;
    // The letters A, D, J, N, U and Ti: the fixture is a sample of the source's 27 domains.
    assert pnv_letter(0) == 65;
    assert pnv_letter(2) == 74;
    assert pnv_letter(5) == 84;
    assert pnv_letter(PNV_DOMAINS) == 0;
}

; ---------------------------------------------------------------- tests: the three views

test the_timeline_rows_and_cells_carry_class_bucket_and_the_now_marker {
    let s : VizState = pnv_at(2, 0);
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        let row : PnvRow = pnv_timeline_row(s, d);
        assert row.domain == d;
        assert row.ent == pnv_domain_ref(d);
        assert row.letter == pnv_letter(d);
        assert row.status == PNV_HAND_STATUS[(d * PNV_TICKS + 2) as usize];
        assert row.y == PNV_TL_Y + d * PNV_ROW_H;
        assert row.focused == false;
        var t : u32 = 0;
        while (t < PNV_TICKS) {
            let cell : PnvCell = pnv_timeline_cell(s, d, t);
            let k : usize = (d * PNV_TICKS + t) as usize;
            assert cell.status == PNV_HAND_STATUS[k];
            assert cell.bucket == PNV_HAND_BUCKET[k];
            assert cell.ent == pnv_cell_ref(d, t);
            assert cell.now == (t == 2);
            t = t + 1;
        }
        d = d + 1;
    }
    assert pnv_timeline_cell(s, 3, 1).status == ST_BLOCKED;
    assert pnv_timeline_cell(s, 3, 2).status == ST_WARM;
    assert pnv_timeline_row(pnv_at(1, 0), 3).status == ST_BLOCKED;
}

test the_chart_bars_are_the_class_counts_drawn_up_from_the_floor {
    let s : VizState = pnv_at(1, 0);
    let q : PnvBar = pnv_chart_bar(s, ST_QUIET);
    let w : PnvBar = pnv_chart_bar(s, ST_WARM);
    let a : PnvBar = pnv_chart_bar(s, ST_ACTIVE);
    let b : PnvBar = pnv_chart_bar(s, ST_BLOCKED);
    assert q.count == 2; assert w.count == 2; assert a.count == 1; assert b.count == 1;
    assert q.x == 400;
    assert b.x == 568;
    assert q.h == 64;
    assert q.y == 176;
    assert a.h == 32;
    assert a.y == 208;
    assert a.y + a.h == PNV_CH_Y + PNV_CH_H;
    // The bars follow the stepper: at tick 3 there are two active and three warm, none blocked.
    let late : VizState = pnv_at(3, 0);
    assert pnv_chart_bar(late, ST_ACTIVE).count == 2;
    assert pnv_chart_bar(late, ST_WARM).count == 3;
    assert pnv_chart_bar(late, ST_WARM).h == 96;
    // A number that is not a class draws an empty bar in the origin column.
    assert pnv_chart_bar(s, PNV_ST_NONE).count == 0;
    assert pnv_bar_x(PNV_ST_NONE) == 0;
}

test the_badge_reports_the_counts_the_moving_total_and_the_truth_label {
    let b0 : PnvBadge = pnv_badge(pnv_open());
    assert b0.lifecycle == VIZ_LC_READY;
    assert b0.truth == VIZ_TRUTH_VERIFIED;
    assert b0.may_claim;
    assert b0.active == 3; assert b0.warm == 1; assert b0.quiet == 2; assert b0.blocked == 0;
    assert b0.moving == 4;
    assert b0.rgb == viz_truth_rgb(VIZ_TRUTH_VERIFIED);
    assert b0.motion_ms == 240;
    assert pnv_badge(pnv_at(1, 0)).moving == 3;
    assert pnv_badge(pnv_at(3, 0)).moving == 5;
    assert pnv_badge(pnv_at(4, 0)).moving == 3;
}

test timeline_chart_and_badge_agree_over_poses_choices_and_ticks {
    var k : u32 = 0;
    while (k < 4) {
        var c : u32 = 0;
        while (c < PNV_CHOICES) {
            var t : u32 = 0;
            while (t < PNV_TICKS) {
                let s : VizState = pnv_pose(pnv_at(t, c), k);
                let b : PnvBadge = pnv_badge(s);
                assert pnv_rows_with(s, ST_ACTIVE) == b.active;
                assert pnv_rows_with(s, ST_WARM) == b.warm;
                assert pnv_rows_with(s, ST_QUIET) == b.quiet;
                assert pnv_rows_with(s, ST_BLOCKED) == b.blocked;
                assert pnv_chart_bar(s, ST_ACTIVE).count == b.active;
                assert pnv_chart_bar(s, ST_WARM).count == b.warm;
                assert pnv_chart_bar(s, ST_QUIET).count == b.quiet;
                assert pnv_chart_bar(s, ST_BLOCKED).count == b.blocked;
                assert b.moving == b.active + b.warm;
                assert b.active + b.warm + b.quiet + b.blocked == PNV_DOMAINS;
                assert pnv_truth(s) == b.truth;
                var d : u32 = 0;
                while (d < PNV_DOMAINS) {
                    let row : PnvRow = pnv_timeline_row(s, d);
                    let cell : PnvCell = pnv_timeline_cell(s, d, s.step);
                    assert row.status == cell.status;
                    assert row.hl == cell.row_hl;
                    assert cell.now;
                    d = d + 1;
                }
                t = t + 1;
            }
            c = c + 1;
        }
        k = k + 1;
    }
}

test selecting_or_hovering_lights_the_row_the_cells_and_the_class_bar_and_a_stray_ref_lights_nothing {
    // Cell (2, 3) selected, domain 5 hovered, on tick 1: domain 2 is QUIET, domain 5 is WARM.
    let s : VizState = pnv_pose(pnv_at(1, 0), 2);
    assert pnv_timeline_row(s, 2).hl == VIZ_HL_SELECT;
    assert pnv_timeline_row(s, 5).hl == VIZ_HL_HOVER;
    assert pnv_timeline_row(s, 0).hl == VIZ_HL_NONE;
    assert pnv_timeline_cell(s, 2, 3).hl == VIZ_HL_SELECT;
    assert pnv_timeline_cell(s, 2, 2).hl == VIZ_HL_NONE;
    assert pnv_timeline_cell(s, 2, 2).row_hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(s, ST_QUIET).hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(s, ST_WARM).hl == VIZ_HL_HOVER;
    assert pnv_chart_bar(s, ST_ACTIVE).hl == VIZ_HL_NONE;
    assert pnv_chart_bar(s, ST_BLOCKED).hl == VIZ_HL_NONE;
    // A selected domain moves from bar to bar as the stepper walks: domain 3 is ACTIVE on tick 0,
    // BLOCKED on tick 1 and WARM on tick 2.
    let job : VizState = pnv_pose(pnv_at(0, 0), 1);
    assert pnv_timeline_cell(job, 3, 0).hl == VIZ_HL_NONE;
    assert pnv_timeline_cell(job, 3, 0).row_hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(job, ST_ACTIVE).hl == VIZ_HL_SELECT;
    let next : VizState = viz_apply(job, VIZ_EV_STEP_NEXT, 0, 0);
    assert pnv_chart_bar(next, ST_ACTIVE).hl == VIZ_HL_NONE;
    assert pnv_chart_bar(next, ST_BLOCKED).hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(viz_apply(next, VIZ_EV_STEP_NEXT, 0, 0), ST_WARM).hl == VIZ_HL_SELECT;
    let hot : VizState = pnv_pose(pnv_at(0, 0), 3);
    assert pnv_chart_bar(hot, ST_QUIET).hl == VIZ_HL_HOVER;
    let both : VizState = viz_apply(hot, VIZ_EV_SELECT, pnv_domain_ref(2), 0);
    assert pnv_chart_bar(both, ST_QUIET).hl == VIZ_HL_SELECT;
    assert pnv_timeline_row(both, 4).hl == VIZ_HL_HOVER;
    // A ref past the fixture is accepted by the reducer but lights nothing in any view.
    let strays : VizState = viz_apply(pnv_open(), VIZ_EV_SELECT, viz_ref(VIZ_ENT_NODE, 9), 0);
    assert strays.selected == viz_ref(VIZ_ENT_NODE, 9);
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        assert pnv_timeline_row(strays, d).hl == VIZ_HL_NONE;
        d = d + 1;
    }
    assert pnv_chart_bar(strays, ST_ACTIVE).hl == VIZ_HL_NONE;
    assert pnv_chart_bar(strays, ST_QUIET).hl == VIZ_HL_NONE;
}

; ---------------------------------------------------------------- tests: one input change, recomputed

test adding_a_commit_to_domain_two_lights_it_and_moves_the_tally_and_the_label {
    let before : VizState = pnv_at(1, PNV_CHOICE_RECORDED);
    let after : VizState = pnv_add_event(before, 2);
    let b0 : PnvBadge = pnv_badge(before);
    let b1 : PnvBadge = pnv_badge(after);
    assert b0.active == 1; assert b0.warm == 2; assert b0.quiet == 2; assert b0.blocked == 1;
    assert b1.active == 2; assert b1.warm == 2; assert b1.quiet == 1; assert b1.blocked == 1;
    assert b1.moving == b0.moving + 1;
    assert after.revision == before.revision + 1;
    // The label follows the input: the recorded logs are VERIFIED, the added commit is a what-if.
    assert b0.truth == VIZ_TRUTH_VERIFIED;
    assert b0.may_claim;
    assert b1.truth == VIZ_TRUTH_DEMO;
    assert b1.may_claim == false;
    assert b1.rgb == viz_truth_rgb(VIZ_TRUTH_DEMO);
    // Domain 2 goes from QUIET (older than a week) to ACTIVE (age 0, bucket 0); no other row moves.
    assert pnv_timeline_row(before, 2).status == ST_QUIET;
    assert pnv_timeline_row(after, 2).status == ST_ACTIVE;
    assert pnv_timeline_cell(before, 2, 1).bucket == 7;
    assert pnv_timeline_cell(after, 2, 1).bucket == 0;
    assert pnv_timeline_row(before, 0).status == pnv_timeline_row(after, 0).status;
    assert pnv_chart_bar(after, ST_ACTIVE).h == 64;
    // Taking the commit away restores the recorded answer exactly.
    let restored : VizState = pnv_clear_event(after);
    assert pnv_badge(restored).active == 1;
    assert pnv_badge(restored).quiet == 2;
    assert pnv_badge(restored).truth == VIZ_TRUTH_VERIFIED;
    let early : VizState = viz_apply(after, VIZ_EV_STEP_SET, 0, 0);
    assert pnv_badge(early).active == 3;
    assert pnv_badge(early).truth == VIZ_TRUTH_DEMO;
}

test an_added_commit_reaches_only_the_ticks_from_the_event_tick_and_never_unblocks {
    // Tick 0 is before the event: no choice changes any cell of it.
    var c : u32 = 1;
    while (c < PNV_CHOICES) {
        var d : u32 = 0;
        while (d < PNV_DOMAINS) {
            assert pnv_status_at(d, 0, c) == pnv_status_at(d, 0, 0);
            assert pnv_bucket_at(d, 0, c) == pnv_bucket_at(d, 0, 0);
            d = d + 1;
        }
        c = c + 1;
    }
    // At the event tick the domain added to is ACTIVE, unless its lamp is red: domain 3 stays BLOCKED.
    assert pnv_status_at(0, 1, 1) == ST_ACTIVE;
    assert pnv_status_at(1, 1, 2) == ST_ACTIVE;
    assert pnv_status_at(2, 1, 3) == ST_ACTIVE;
    assert pnv_status_at(3, 1, 4) == ST_BLOCKED;
    assert pnv_status_at(5, 1, 6) == ST_ACTIVE;
    // Then it ages two days a tick: warm at 2, 4 and 6 days (under a week).
    assert pnv_status_at(1, 2, 2) == ST_WARM;
    assert pnv_status_at(1, 4, 2) == ST_WARM;
    assert pnv_bucket_at(1, 2, 2) == 2;
    assert pnv_status_at(4, 4, 5) == ST_BLOCKED;
    // An older added commit does not replace a newer recorded one: domain 2 has its own commit 4
    // hours old on tick 3, newer than the added commit 4 days old.
    assert pnv_last_at(2, 3, 3) == 1792504000;
    assert pnv_last_at(2, 3, 0) == 1792504000;
    assert pnv_count(1, 3, ST_ACTIVE) == 2;
    assert pnv_count(2, 3, ST_WARM) == 4;
}

test the_changed_answer_equals_a_direct_call_of_the_source_functions {
    // Straight from the source at tick 1 (now = 1792172800) over the hand-read last commits, with
    // only domain 3 red: every cell is status_of's own answer.
    var a : u32 = 0;
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        let st : u32 = status_of(1792172800, PNV_HAND_LAST1[d as usize], d == 3);
        assert pnv_status_at(d, 1, 0) == st;
        assert pnv_timeline_cell(pnv_at(1, 0), d, 1).status == st;
        if (st == ST_ACTIVE) {
            a = a + 1;
        }
        d = d + 1;
    }
    let plain : PnvBadge = pnv_badge(pnv_at(1, 0));
    assert plain.active == a; assert plain.warm == 2; assert plain.quiet == 2; assert plain.blocked == 1;
    // A commit added to domain 2 at that very second makes its last commit now: status_of says ACTIVE.
    assert status_of(1792172800, 1792172800, false) == ST_ACTIVE;
    let moved : PnvBadge = pnv_badge(pnv_at(1, 3));
    assert moved.active == a + 1; assert moved.quiet == 1; assert moved.warm == 2; assert moved.blocked == 1;
    assert bucket_of(1792518400 - 1792072000) == 5;
    assert pnv_timeline_cell(pnv_at(3, 0), 1, 3).bucket == 5;
}

; ---------------------------------------------------------------- tests: truth, both sides

test the_truth_label_follows_viz_may_claim_over_the_added_commit {
    // The recorded data keeps every label as stored.
    assert pnv_truth_for(VIZ_TRUTH_VERIFIED, 0) == VIZ_TRUTH_VERIFIED;
    assert pnv_truth_for(VIZ_TRUTH_LIVE, 0) == VIZ_TRUTH_LIVE;
    assert pnv_truth_for(VIZ_TRUTH_CACHED, 0) == VIZ_TRUTH_CACHED;
    assert pnv_truth_for(VIZ_TRUTH_DEMO, 0) == VIZ_TRUTH_DEMO;
    // An added commit drops the labels that may claim a result to DEMO and leaves the others alone.
    assert pnv_truth_for(VIZ_TRUTH_VERIFIED, 1) == VIZ_TRUTH_DEMO;
    assert pnv_truth_for(VIZ_TRUTH_LIVE, 3) == VIZ_TRUTH_DEMO;
    assert pnv_truth_for(VIZ_TRUTH_CACHED, 1) == VIZ_TRUTH_CACHED;
    assert pnv_truth_for(9, 0) == VIZ_TRUTH_UNKNOWN;
    assert viz_may_claim(pnv_truth_for(VIZ_TRUTH_VERIFIED, 0));
    let open : VizState = pnv_open();
    let whatif : VizState = pnv_add_event(open, 3);
    assert pnv_truth(open) == VIZ_TRUTH_VERIFIED;
    assert pnv_truth(whatif) == VIZ_TRUTH_DEMO;
    assert whatif.truth == VIZ_TRUTH_VERIFIED;
    let reloaded : VizState = pnv_reload(whatif, PNV_FEED_FIXTURE);
    assert reloaded.param == 4;
    assert pnv_truth(reloaded) == VIZ_TRUTH_DEMO;
    assert pnv_badge(reloaded).may_claim == false;
    assert pnv_truth(pnv_clear_event(reloaded)) == VIZ_TRUTH_VERIFIED;
    assert pvp_truth(PNV_PETAL) == pnv_truth(open);
    assert pvp_truth(PNV_PETAL) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- tests: lifecycle

test an_empty_feed_is_empty_unknown_and_ignores_interaction {
    let e : VizState = pnv_load(PNV_FEED_EMPTY);
    assert e.lifecycle == VIZ_LC_EMPTY;
    assert e.item_count == 0;
    assert e.focus_count == 0;
    assert e.truth == VIZ_TRUTH_UNKNOWN;
    assert pnv_truth(e) == VIZ_TRUTH_UNKNOWN;
    assert e.revision == 2;
    assert pnv_click(e, 20, 60).revision == e.revision;
    assert viz_apply(e, VIZ_EV_STEP_NEXT, 0, 0).step == 0;
    assert viz_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).focus == VIZ_NO_FOCUS;
    assert pnv_activate(e).revision == e.revision;
    let b : PnvBadge = pnv_badge(e);
    assert b.lifecycle == VIZ_LC_EMPTY;
    assert b.may_claim == false;
    assert b.active + b.warm + b.quiet + b.blocked == 0;
    assert pnv_timeline_row(e, 0).status == PNV_ST_NONE;
}

test a_log_with_an_unreadable_record_is_an_error_and_retry_recovers {
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        assert pnv_log_ok(pnv_log(d));
        d = d + 1;
    }
    assert pnv_log_ok(pnv_feed_log(PNV_FEED_BAD_RECORD, 1));
    assert pnv_log_ok(pnv_feed_log(PNV_FEED_BAD_RECORD, 2)) == false;
    assert pnv_feed_bad_domain(PNV_FEED_FIXTURE) == PNV_NO_DOMAIN;
    assert pnv_feed_bad_domain(PNV_FEED_BAD_RECORD) == PNV_BAD_DOMAIN;
    // A good record after a bad one does not hide it.
    assert pnv_log_ok("\x1ebad\n\x1eh0\x1f1791978400\x1fs\n\nf\n") == false;
    let e : VizState = pnv_load(PNV_FEED_BAD_RECORD);
    assert e.lifecycle == VIZ_LC_ERROR;
    assert e.error == (PNV_ERR_BAD_RECORD as u8);
    assert pnv_badge(e).active == 0;
    assert pnv_timeline_row(e, 0).status == PNV_ST_NONE;
    assert pnv_chart_bar(e, ST_ACTIVE).count == 0;
    assert pnv_click(e, 20, 60).revision == e.revision;
    let retry : VizState = viz_apply(e, VIZ_EV_RETRY, 0, 0);
    assert retry.lifecycle == VIZ_LC_LOADING;
    assert retry.error == 0;
    let healed : VizState = viz_apply(retry, VIZ_EV_LOADED, pnv_feed_count(PNV_FEED_FIXTURE), pnv_feed_truth(PNV_FEED_FIXTURE) as u32);
    assert healed.lifecycle == VIZ_LC_READY;
    assert healed.item_count == PNV_DOMAINS;
    assert pnv_truth(healed) == VIZ_TRUTH_VERIFIED;
    assert pnv_badge(healed).active == 3;
}

test a_petal_that_is_loading_draws_nothing_but_keeps_its_label {
    let loading : VizState = viz_apply(pnv_idle(), VIZ_EV_LOAD, 0, 0);
    assert loading.lifecycle == VIZ_LC_LOADING;
    assert pnv_badge(loading).active == 0;
    assert pnv_timeline_cell(loading, 1, 1).status == PNV_ST_NONE;
    assert pnv_chart_bar(loading, ST_ACTIVE).count == 0;
    assert pnv_hover(loading, 20, 60).revision == loading.revision;
    let again : VizState = viz_apply(pnv_at(4, 2), VIZ_EV_LOAD, 0, 0);
    assert pnv_truth(again) == VIZ_TRUTH_DEMO;
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_every_domain_forward_and_back_and_wraps {
    var s : VizState = pnv_open();
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert s.focus == d;
        assert pnv_focus_ref(s, s.focus) == pnv_domain_ref(d);
        assert pnv_timeline_row(s, d).focused;
        assert pnv_timeline_row(s, (d + 1) % PNV_DOMAINS).focused == false;
        d = d + 1;
    }
    // One more wraps to the first domain, one back wraps to the last, then back down to the first.
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.focus == 0;
    s = viz_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
    assert s.focus == 5;
    var back : u32 = 5;
    while (back > 0) {
        s = viz_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
        back = back - 1;
        assert s.focus == back;
    }
    assert pnv_focus_ref(pnv_open(), VIZ_NO_FOCUS) == VIZ_REF_NONE;
    assert pnv_focus_ref(s, PNV_DOMAINS) == VIZ_REF_NONE;
}

test activate_selects_the_focused_domain_and_back_clears_it_before_it_closes_the_petal {
    let s0 : VizState = pnv_open();
    assert pnv_activate(s0).revision == s0.revision;
    var s : VizState = s0;
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    s = viz_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.focus == 2;
    let picked : VizState = pnv_activate(s);
    assert picked.selected == pnv_domain_ref(2);
    assert picked.revision == s.revision + 1;
    assert pnv_timeline_row(picked, 2).hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(picked, ST_QUIET).hl == VIZ_HL_SELECT;
    // BACK clears the selection first, and only then does it close the petal.
    assert viz_back_closes(s0);
    assert viz_back_closes(picked) == false;
    let cleared : VizState = viz_apply(picked, VIZ_EV_BACK, 0, 0);
    assert cleared.selected == VIZ_REF_NONE;
    assert viz_back_closes(cleared);
    assert cleared.revision == picked.revision + 1;
    assert viz_apply(cleared, VIZ_EV_BACK, 0, 0).revision == cleared.revision;
    // ACTIVATE on the selected domain again toggles it off.
    assert pnv_activate(picked).selected == VIZ_REF_NONE;
}

test reduced_motion_makes_the_sweep_zero_milliseconds_and_allowing_it_restores_it {
    let s0 : VizState = pnv_open();
    assert viz_motion_ms(s0, PNV_SWEEP_MS) == 240;
    assert pnv_badge(s0).motion_ms == 240;
    let calm : VizState = viz_apply(s0, VIZ_EV_MOTION, 1, 0);
    assert calm.reduced_motion == 1;
    assert viz_motion_ms(calm, PNV_SWEEP_MS) == 0;
    assert pnv_badge(calm).motion_ms == 0;
    assert calm.revision == s0.revision + 1;
    assert pnv_badge(viz_apply(calm, VIZ_EV_MOTION, 0, 0)).motion_ms == 240;
    // The preference survives a reload and a step.
    assert pnv_badge(pnv_reload(calm, PNV_FEED_FIXTURE)).motion_ms == 0;
    assert pnv_badge(viz_apply(calm, VIZ_EV_STEP_NEXT, 0, 0)).motion_ms == 0;
}

; ---------------------------------------------------------------- tests: host and hit testing

test the_host_nests_the_badge_the_timeline_and_the_chart_and_validates {
    let h : VizHost = pnv_host();
    assert vh_validate(h) == VH_OK;
    assert h.count == 3;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_TIMELINE;
    assert h.rep[2] == VIZ_REP_CHART;
    assert h.parent[1] == VH_ROOT;
    assert vh_depth(h, 2) == 1;
    assert h.h[1] == PNV_DOMAINS * PNV_ROW_H;
    assert h.w[1] == PNV_LABEL_W + PNV_TICKS * PNV_CELL_W;
    assert vh_abs_x(h, 1) == PNV_TL_X;
    assert vh_abs_y(h, 2) == PNV_CH_Y;
    assert vh_hit(h, 100, 10) == PNV_SLOT_BADGE;
    assert vh_hit(h, 20, 60) == PNV_SLOT_TIMELINE;
    assert vh_hit(h, 500, 100) == PNV_SLOT_CHART;
    // Gaps: left of the timeline, between timeline and chart, between badge and views, below.
    assert vh_hit(h, 5, 100) == VH_NONE;
    assert vh_hit(h, 390, 100) == VH_NONE;
    assert vh_hit(h, 100, 44) == VH_NONE;
    assert vh_hit(h, 100, 245) == VH_NONE;
}

test a_pick_is_the_host_hit_dispatched_to_the_timeline_and_every_row_and_cell_hits_itself {
    assert pnv_pick(10, 50) == pnv_domain_ref(0);
    assert pnv_pick(20, 124) == pnv_domain_ref(2);
    assert pnv_pick(63, 239) == pnv_domain_ref(5);
    assert pnv_pick(64, 239) == pnv_cell_ref(5, 0);
    assert pnv_pick(330, 181) == pnv_cell_ref(4, 4);
    assert pnv_pick(383, 239) == pnv_cell_ref(5, 4);
    // The badge, the chart, the gaps and the outside hold no entity.
    assert pnv_pick(100, 10) == VIZ_REF_NONE;
    assert pnv_pick(500, 100) == VIZ_REF_NONE;
    assert pnv_pick(384, 100) == VIZ_REF_NONE;
    assert pnv_pick(20, 240) == VIZ_REF_NONE;
    // The timeline answer alone agrees with the host-dispatched pick inside its own rect.
    assert pnv_timeline_hit(330, 181) == pnv_pick(330, 181);
    // Every row and cell hits back at itself, and stays inside the timeline slot.
    let h : VizHost = pnv_host();
    let ready : VizState = pnv_open();
    var d : u32 = 0;
    while (d < PNV_DOMAINS) {
        let row : PnvRow = pnv_timeline_row(ready, d);
        assert pnv_pick(PNV_TL_X + 10, row.y + 16) == pnv_domain_ref(d);
        var t : u32 = 0;
        while (t < PNV_TICKS) {
            let cell : PnvCell = pnv_timeline_cell(ready, d, t);
            assert pnv_pick(cell.x + 5, cell.y + 5) == pnv_cell_ref(d, t);
            assert vh_hit(h, cell.x + 5, cell.y + 5) == PNV_SLOT_TIMELINE;
            t = t + 1;
        }
        d = d + 1;
    }
}

test a_click_changes_the_one_state_and_the_rows_cells_and_bars_follow {
    let s0 : VizState = pnv_open();
    // A click on a row label selects the domain under the pointer; domain 2 is QUIET on tick 0.
    let s1 : VizState = pnv_click(s0, 20, 124);
    assert s1.selected == pnv_domain_ref(2);
    assert s1.revision == s0.revision + 1;
    assert pnv_timeline_row(s1, 2).hl == VIZ_HL_SELECT;
    assert pnv_timeline_cell(s1, 2, 0).row_hl == VIZ_HL_SELECT;
    assert pnv_chart_bar(s1, ST_QUIET).hl == VIZ_HL_SELECT;
    // A click on a timeline cell selects the cell and moves the selection to its row.
    let s2 : VizState = pnv_click(s1, 330, 181);
    assert s2.selected == pnv_cell_ref(4, 4);
    assert pnv_timeline_row(s2, 4).hl == VIZ_HL_SELECT;
    assert pnv_timeline_row(s2, 2).hl == VIZ_HL_NONE;
    assert pnv_timeline_cell(s2, 4, 4).hl == VIZ_HL_SELECT;
    let s3 : VizState = pnv_click(s2, 330, 181);
    assert s3.selected == VIZ_REF_NONE;
    let s5 : VizState = pnv_click(s1, 5, 100);
    assert s5.selected == VIZ_REF_NONE;
    assert s5.revision == s1.revision + 1;
    let s7 : VizState = pnv_hover(s3, 20, 60);
    assert s7.hover == pnv_domain_ref(0);
    assert pnv_timeline_row(s7, 0).hl == VIZ_HL_HOVER;
    assert pnv_chart_bar(s7, ST_ACTIVE).hl == VIZ_HL_HOVER;
    assert pnv_hover(s7, 100, 10).hover == VIZ_REF_NONE;
}

test the_whole_petal_embeds_in_a_larger_host_once {
    var outer : VizHost = vh_add(vh_blank(), VIZ_REP_TEXT, VH_ROOT, 0, 0, 700, 300);
    outer = vh_embed(outer, pnv_host(), 0, 20, 20);
    assert outer.count == 4;
    assert vh_validate(outer) == VH_OK;
    assert outer.rep[0] == VIZ_REP_TEXT;
    assert outer.rep[1] == VIZ_REP_BADGE;
    assert outer.rep[2] == VIZ_REP_TIMELINE;
    assert outer.rep[3] == VIZ_REP_CHART;
    assert outer.parent[2] == 0;
    assert vh_depth(outer, 2) == 2;
    assert vh_abs_x(outer, 2) == 28;
    assert vh_abs_y(outer, 2) == 68;
    assert vh_hit(outer, 40, 80) == 2;
    assert vh_hit(outer, 440, 100) == 3;
    assert viz_rep_bit(outer.rep[1]) + viz_rep_bit(outer.rep[2]) + viz_rep_bit(outer.rep[3]) == pnv_reps();
}

; ---------------------------------------------------------------- tests: agreement with the plan

test the_reps_equal_row_n_of_the_plan_and_the_set_is_a_linked_plan {
    let h : VizHost = pnv_host();
    assert PNV_PETAL == 13;
    assert petal_letter_byte(PNV_PETAL) == 78;
    assert pnv_reps() == pvp_reps(PNV_PETAL);
    assert viz_rep_bit(h.rep[0]) + viz_rep_bit(h.rep[1]) + viz_rep_bit(h.rep[2]) == pvp_reps(PNV_PETAL);
    assert pvp_reps(PNV_PETAL) == 1792;
    assert viz_plan_ok(pnv_reps());
    assert viz_is_linked(pnv_reps());
    // A host that leaves the badge out is not a plan.
    assert viz_plan_ok(viz_rep_bit(VIZ_REP_TIMELINE) + viz_rep_bit(VIZ_REP_CHART)) == false;
    assert pvp_is_spec_path(pvp_source(PNV_PETAL));
}

; ---------------------------------------------------------------- invariant

invariant the_fixture_and_the_layout_fit_their_tables_and_frames {
    assert PNV_TICKS <= PNV_STRIDE;
    assert PNV_DOMAINS * PNV_STRIDE < 65536;
    assert PNV_DOMAINS * PNV_TICKS == 30;
    assert PNV_CHOICES == PNV_DOMAINS + 1;
    assert PNV_TL_W == PNV_LABEL_W + PNV_TICKS * PNV_CELL_W;
    assert PNV_TL_H == PNV_DOMAINS * PNV_ROW_H;
    assert PNV_TL_X + PNV_TL_W <= PNV_CH_X;
    assert PNV_CH_X + PNV_CH_W <= PNV_FRAME_W;
    assert PNV_CH_W == 4 * PNV_BAR_COL;
    assert PNV_BAR_W <= PNV_BAR_COL;
    assert PNV_DOMAINS * PNV_BAR_UNIT == PNV_CH_H;
    assert PNV_TL_Y >= PNV_BADGE_H;
    assert PNV_TL_Y == PNV_CH_Y;
}
