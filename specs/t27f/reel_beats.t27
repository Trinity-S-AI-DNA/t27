// SPDX-License-Identifier: Apache-2.0
// specs/t27f/reel_beats.t27 -- every reel of a course as three beats, open, main and close, so
// that no two reels show the same scenes. Issue gHashTag/t27#10584, epic gHashTag/t27#10560.
//
// WHY: reel_factory.t27 gives each lesson one scene archetype, at most ARCH_CAP = 4 times a
// course, so up to four reels share their only scene and differ in accent, motion and layout
// alone. Its own NOT CLAIMED block says the signature test is weak by itself. Tools that fill one
// fixed structure with an item's text produce exactly the sameness the owner saw; the ones that
// look varied let the data choose the scene list (Motion Canvas and Revideo take a list of scenes
// per project). Here the data chooses three.
//
// THE BEATS, planned for the whole course at once, in course order:
//   main   the factory's scene, arche(t). Nothing here changes it.
//   open   the scene of the item's next construct: of the archetypes the item has content for,
//          other than main, the best by reel_factory's term-frequency score, where any construct
//          ranks above any generic scene. It may not repeat the previous reel's open, and the ordered
//          pair (open, main) may not be one an earlier reel already has.
//   close  a generic scene (code, title, task or map), rotating from t mod GENERICS, other than
//          main and open, and not the previous reel's close.
// A beat the plan cannot place reads ARCHS, which the tests refuse.
//
// The tests hold over every lesson of course 0: every beat placed; three distinct scenes a reel;
// no two reels open the same way into the same main, so no two show the same sequence; neighbours
// differ in every position; every beat shows content its item has, and every close is generic.
//
// NOT CLAIMED:
// - Not that an unordered pair of scenes is unique. Measured on course 0: 21 of 27 lessons have
//   content for graph and tests alone among the constructs, so their scenes come from six archetypes,
//   which make 15 unordered pairs for 27 reels. Ordered pairs (open, main) number 30, and the rule
//   holds on those. For the same reason open falls back to a generic scene when main took the only
//   construct the item has left, or the pair rule refused it.
// - The plan arrays are sized for course 0 (COURSE = 27, checked against TOPICS by a test). A
//   course of another length needs the size changed with it.
// - Beat lengths in frames, and the transitions between beats, are not here. The renderers are R3
//   (#10571) and the reel that reads this plan is R4.
// - "Shows content the item has" is the factory's content() count being positive. It does not say
//   the open is interesting; a lesson whose only second construct is one test block opens on it.
// phi^2 + 1/phi^2 = 3 | TRINITY

module reel_beats;

use t27f::reel_topics::TOPICS;
use t27f::reel_factory::A_CODE;
use t27f::reel_factory::A_TITLE;
use t27f::reel_factory::A_TASK;
use t27f::reel_factory::A_MAP;
use t27f::reel_factory::ARCHS;
use t27f::reel_factory::generic;
use t27f::reel_factory::content;
use t27f::reel_factory::course_content;
use t27f::reel_factory::score_with;
use t27f::reel_factory::arche;

pub const COURSE : usize = 27;
pub const BEATS : usize = 3;
pub const GENERICS : usize = 4;
// The generic archetypes in close rotation order: code, title, task, map.
pub const GENERIC_ARCH : [4]usize = [0, 9, 10, 11];

// ---- the pair rule ----

// Whether a reel before t already opens on a into the main m.
pub fn pair_used(mn: [27]usize, op: [27]usize, t: usize, m: usize, a: usize) -> bool {
    var s : usize = 0;
    while (s < t) {
        if (mn[s] == m && op[s] == a) {
            return true;
        }
        s = s + 1;
    }
    return false;
}

// How open ranks archetype a for lesson t: 0 when a is generic, otherwise one more than its
// factory score, so that any construct beats any generic scene.
pub fn open_rank(t: usize, a: usize, total: u32) -> u32 {
    if (generic(a)) {
        return 0;
    }
    return score_with(t, a, total) + 1;
}

// ---- plan ----

// The beats of every lesson: op the open, mn the main, cl the close.
pub fn plan_beats(op: *[27]usize, mn: *[27]usize, cl: *[27]usize) -> void {
    var total : [12]u32 = undefined;
    var a : usize = 0;
    while (a < ARCHS) {
        total[a] = course_content(a);
        a = a + 1;
    }
    var t : usize = 0;
    while (t < COURSE) {
        mn[t] = arche(t);
        op[t] = ARCHS;
        cl[t] = ARCHS;
        t = t + 1;
    }
    t = 0;
    while (t < COURSE) {
        var best : usize = ARCHS;
        var best_rank : u32 = 0;
        a = 0;
        while (a < ARCHS) {
            var ok = a != mn[t] && content(t, a) > 0;
            if (ok && t > 0 && a == op[t - 1]) {
                ok = false;
            }
            if (ok && pair_used(mn.*, op.*, t, mn[t], a)) {
                ok = false;
            }
            if (ok) {
                const r = open_rank(t, a, total[a]);
                if (best == ARCHS || r > best_rank) {
                    best = a;
                    best_rank = r;
                }
            }
            a = a + 1;
        }
        op[t] = best;
        var k : usize = 0;
        while (k < GENERICS && cl[t] == ARCHS) {
            const g = GENERIC_ARCH[(t + k) % GENERICS];
            var free = g != mn[t] && g != op[t] && content(t, g) > 0;
            if (free && t > 0 && g == cl[t - 1]) {
                free = false;
            }
            if (free) {
                cl[t] = g;
            }
            k = k + 1;
        }
        t = t + 1;
    }
}

// ---- tests ----

test "the plan is sized for this course and its generic list is the factory's" {
    assert(COURSE == TOPICS);
    assert(GENERIC_ARCH[0] == A_CODE);
    assert(GENERIC_ARCH[1] == A_TITLE);
    assert(GENERIC_ARCH[2] == A_TASK);
    assert(GENERIC_ARCH[3] == A_MAP);
    var k : usize = 0;
    while (k < GENERICS) {
        assert(generic(GENERIC_ARCH[k]));
        k = k + 1;
    }
}

test "the pair rule sees an earlier pair in its order and nothing at or after t" {
    var mn : [27]usize = undefined;
    var op : [27]usize = undefined;
    var t : usize = 0;
    while (t < 27) {
        mn[t] = 0;
        op[t] = 9;
        t = t + 1;
    }
    mn[3] = 4;
    op[3] = 2;
    assert(pair_used(mn, op, 4, 4, 2));
    assert(pair_used(mn, op, 4, 2, 4) == false);
    assert(pair_used(mn, op, 3, 4, 2) == false);
    assert(pair_used(mn, op, 27, 4, 5) == false);
    assert(open_rank(0, A_TITLE, 5) == 0);
}

test "every beat of every reel is placed" {
    var op : [27]usize = undefined;
    var mn : [27]usize = undefined;
    var cl : [27]usize = undefined;
    plan_beats(&op, &mn, &cl);
    var t : usize = 0;
    while (t < COURSE) {
        assert(op[t] < ARCHS);
        assert(mn[t] < ARCHS);
        assert(cl[t] < ARCHS);
        t = t + 1;
    }
}

test "every reel shows three different scenes" {
    var op : [27]usize = undefined;
    var mn : [27]usize = undefined;
    var cl : [27]usize = undefined;
    plan_beats(&op, &mn, &cl);
    var t : usize = 0;
    while (t < COURSE) {
        assert(op[t] != mn[t]);
        assert(cl[t] != mn[t]);
        assert(cl[t] != op[t]);
        t = t + 1;
    }
}

test "no two reels open the same way into the same main, so no two show the same sequence" {
    var op : [27]usize = undefined;
    var mn : [27]usize = undefined;
    var cl : [27]usize = undefined;
    plan_beats(&op, &mn, &cl);
    var s : usize = 0;
    while (s < COURSE) {
        var t : usize = s + 1;
        while (t < COURSE) {
            assert((mn[s] == mn[t] && op[s] == op[t]) == false);
            assert((op[s] == op[t] && mn[s] == mn[t] && cl[s] == cl[t]) == false);
            t = t + 1;
        }
        s = s + 1;
    }
}

test "two neighbouring reels differ in every beat" {
    var op : [27]usize = undefined;
    var mn : [27]usize = undefined;
    var cl : [27]usize = undefined;
    plan_beats(&op, &mn, &cl);
    var t : usize = 1;
    while (t < COURSE) {
        assert(op[t] != op[t - 1]);
        assert(mn[t] != mn[t - 1]);
        assert(cl[t] != cl[t - 1]);
        t = t + 1;
    }
}

test "every beat shows content its item has, and every close is generic" {
    var op : [27]usize = undefined;
    var mn : [27]usize = undefined;
    var cl : [27]usize = undefined;
    plan_beats(&op, &mn, &cl);
    var t : usize = 0;
    while (t < COURSE) {
        assert(content(t, op[t]) > 0);
        assert(content(t, mn[t]) > 0);
        assert(content(t, cl[t]) > 0);
        assert(generic(cl[t]));
        t = t + 1;
    }
}
