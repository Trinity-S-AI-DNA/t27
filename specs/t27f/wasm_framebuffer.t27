// SPDX-License-Identifier: Apache-2.0
// specs/t27f/wasm_framebuffer.t27 -- fpga: wasm_fb -- a 320x200 palette framebuffer
// in the T27 OS video raster, and frame_main that writes the frame to a PPM after
// every run.
// Part of M6 milestone (milestone #10). Closes #12203.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::wasm_framebuffer;

pub const WASM_FRAMEBUFFER_WIDTH : u32 = 320;
pub const WASM_FRAMEBUFFER_HEIGHT : u32 = 200;

pub struct WasmFramebuffer { width: u32, height: u32, initialized: bool };

pub fn wasm_framebuffer_initialized(w: WasmFramebuffer) -> bool {
    return w.initialized;
}

test "wasm_framebuffer_initialized" {
    assert(wasm_framebuffer_initialized(WasmFramebuffer { width: 320, height: 200, initialized: true }));
    assert(!wasm_framebuffer_initialized(WasmFramebuffer { width: 320, height: 200, initialized: false }));
}

invariant wasm_framebuffer_dimensions_positive {
    assert WASM_FRAMEBUFFER_WIDTH > 0;
    assert WASM_FRAMEBUFFER_HEIGHT > 0;
}