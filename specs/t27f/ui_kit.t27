// SPDX-License-Identifier: Apache-2.0
; T27F-007 ring 8: UI kit, six components (button, card, input, badge, nav, table) as object graphs plus per-node style hints
; Refs gHashTag/t27#13214
; Architecture: object graph -> meaning -> layout -> theme -> render. A component here is a VfGraph plus one variant index and one state index per node
; The kit holds no colours, no pixel sizes and no layout code. Variant and state are plain indices that the theme layer (vf_theme) resolves later; this module does not import it
; Reads specs/t27f/visual_factory_contract.t27 and never edits it. Graph capacity is VF_MAX_NODES = 16 nodes, so both index arrays hold 16 entries
; The kit keeps its own variant and state arrays and leaves graph.variant and graph.state at their defaults: the KV and KS indices differ from the contract V and S enumerations (KS_FOCUS 5 is outside S_KINDS), so the graph still passes vf_validate
; Labels are meaning-layer data (vf_meaning), not graph data. The contract validator refuses a text node with empty text and a button with no accessible name, so each text slot holds a fixed placeholder name (Title, Body, Action, ...) that the meaning layer replaces with real copy
; Spacing is theme data: gap and padding stay 0 here; only the stacking direction of a container is set
; A button cannot own a child (VF_MAX_CHILDREN is 0), so kit_button is a root container holding one button node that carries its own text
; Table capacity: a root list, a header row of 3 cells and each data row of 3 cells cost 1 + 4 * (1 + rows) nodes; 16 nodes hold at most 2 data rows, so rows clamp to 1..2 (a 3rd row needs 17 nodes). The contract is not edited
; Node layout of each builder is written next to it; parents always come before their children, which vf_layout relies on

module t27f_ui_kit;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_MAX_NODES;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CONTAINER;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_LIST;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL_REF;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;

pub const KV_PRIMARY : u32 = 0;
pub const KV_SECONDARY : u32 = 1;
pub const KV_GHOST : u32 = 2;
pub const KV_SUCCESS : u32 = 3;
pub const KV_WARN : u32 = 4;

pub const KS_DEFAULT : u32 = 0;
pub const KS_HOVER : u32 = 1;
pub const KS_PRESSED : u32 = 2;
pub const KS_DISABLED : u32 = 3;
pub const KS_ERROR : u32 = 4;
pub const KS_FOCUS : u32 = 5;

pub const KV_COUNT : u32 = 5;
pub const KS_COUNT : u32 = 6;
pub const KIT_COMPONENT_COUNT : u32 = 6;

pub const KIT_NAV_ITEMS : u32 = 3;
pub const KIT_TABLE_COLS : u32 = 3;
pub const KIT_TABLE_MAX_ROWS : u32 = 2;

; one test id per node index; the contract wants a non-empty id, unique within a graph
pub const KIT_TEST_IDS : [16]str = ["kit-0", "kit-1", "kit-2", "kit-3", "kit-4", "kit-5", "kit-6", "kit-7", "kit-8", "kit-9", "kit-10", "kit-11", "kit-12", "kit-13", "kit-14", "kit-15"];

pub struct UiKit {
    graph: VfGraph,
    variant: [16]u32,
    state: [16]u32,
}

fn kit_blank() -> UiKit {
    var g : VfGraph = vf_blank_graph();
    var k : UiKit = UiKit {
        graph: g,
        variant: [0; 16],
        state: [0; 16],
    };
    return k;
}

// append one node with its style hints; the next node index is the current node count
fn kit_put(k: UiKit, kind: u8, parent: u8, has_text: bool, txt: str, variant: u32, state: u32) -> UiKit {
    let g0 : VfGraph = k.graph;
    let i : u32 = g0.node_count;
    if i >= VF_MAX_NODES {
        return k;
    }
    var props : u32 = bit(P_TEST_ID);
    if has_text {
        props = props + bit(P_TEXT);
    }
    let tid : str = KIT_TEST_IDS[i];
    var g : VfGraph = vf_add(g0, kind, parent, props, tid);
    if has_text {
        g.text[i] = txt;
    }
    var nk : UiKit = k;
    nk.graph = g;
    nk.variant[i] = variant;
    nk.state[i] = state;
    return nk;
}

// the root node: no parent, no text
fn kit_start(kind: u8, variant: u32, state: u32) -> UiKit {
    return kit_put(kit_blank(), kind, VF_NO_PARENT, false, "", variant, state);
}

// stacking direction is the one layout hint a container carries
fn kit_column(k: UiKit, i: u32) -> UiKit {
    var g : VfGraph = k.graph;
    if i < g.node_count {
        g.direction[i] = DIR_COLUMN;
    }
    var nk : UiKit = k;
    nk.graph = g;
    return nk;
}

// point an input at its label text node
fn kit_link(k: UiKit, input: u32, label: u32) -> UiKit {
    var g : VfGraph = k.graph;
    if input < g.node_count and label < g.node_count {
        g.label_ref[input] = label as u8;
        g.props[input] = g.props[input] + bit(P_LABEL_REF);
    }
    var nk : UiKit = k;
    nk.graph = g;
    return nk;
}

fn kit_rows_clamped(rows: u32) -> u32 {
    var r : u32 = rows;
    if r < 1 {
        r = 1;
    }
    if r > KIT_TABLE_MAX_ROWS {
        r = KIT_TABLE_MAX_ROWS;
    }
    return r;
}

fn kit_item_clamped(active: u32) -> u32 {
    var a : u32 = active;
    if a >= KIT_NAV_ITEMS {
        a = KIT_NAV_ITEMS - 1;
    }
    return a;
}

// one table row: a stack under the parent, then KIT_TABLE_COLS text cells under that stack
fn kit_row(k: UiKit, parent: u8, cell_variant: u32) -> UiKit {
    let g : VfGraph = k.graph;
    let row : u8 = g.node_count as u8;
    var nk : UiKit = kit_put(k, VF_STACK, parent, false, "", KV_PRIMARY, KS_DEFAULT);
    var c : u32 = 0;
    while c < KIT_TABLE_COLS {
        nk = kit_put(nk, VF_TEXT, row, true, "Cell", cell_variant, KS_DEFAULT);
        c = c + 1;
    }
    return nk;
}

// nodes: 0 container (root), 1 button (parent 0) carrying the variant and state
pub fn kit_button(variant: u32, state: u32) -> UiKit {
    var k : UiKit = kit_start(VF_CONTAINER, KV_PRIMARY, KS_DEFAULT);
    k = kit_put(k, VF_BUTTON, 0, true, "Button", variant, state);
    return k;
}

// nodes: 0 card (root, column), 1 title text, 2 body text, 3 actions row (stack), 4 button under 3
pub fn kit_card(variant: u32, state: u32) -> UiKit {
    var k : UiKit = kit_start(VF_CARD, variant, state);
    k = kit_column(k, 0);
    k = kit_put(k, VF_TEXT, 0, true, "Title", KV_PRIMARY, KS_DEFAULT);
    k = kit_put(k, VF_TEXT, 0, true, "Body", KV_SECONDARY, KS_DEFAULT);
    k = kit_put(k, VF_STACK, 0, false, "", KV_PRIMARY, KS_DEFAULT);
    k = kit_put(k, VF_BUTTON, 3, true, "Action", KV_PRIMARY, KS_DEFAULT);
    return k;
}

// nodes: 0 stack (root, column), 1 label text, 2 input (label ref 1) carrying the variant and state, 3 error text only when state is KS_ERROR
pub fn kit_input(variant: u32, state: u32) -> UiKit {
    var k : UiKit = kit_start(VF_STACK, KV_PRIMARY, KS_DEFAULT);
    k = kit_column(k, 0);
    k = kit_put(k, VF_TEXT, 0, true, "Label", KV_PRIMARY, KS_DEFAULT);
    k = kit_put(k, VF_INPUT, 0, false, "", variant, state);
    k = kit_link(k, 2, 1);
    if state == KS_ERROR {
        k = kit_put(k, VF_TEXT, 0, true, "Error", KV_WARN, KS_ERROR);
    }
    return k;
}

// node: 0 badge (root) carrying the variant
pub fn kit_badge(variant: u32) -> UiKit {
    return kit_put(kit_blank(), VF_BADGE, VF_NO_PARENT, true, "Badge", variant, KS_DEFAULT);
}

// nodes: 0 list (root, column), 1..3 text items; the active item (clamped to 0..2) gets KS_FOCUS
pub fn kit_nav(active: u32) -> UiKit {
    var k : UiKit = kit_start(VF_LIST, KV_PRIMARY, KS_DEFAULT);
    k = kit_column(k, 0);
    let a : u32 = kit_item_clamped(active);
    var i : u32 = 0;
    while i < KIT_NAV_ITEMS {
        var s : u32 = KS_DEFAULT;
        if i == a {
            s = KS_FOCUS;
        }
        k = kit_put(k, VF_TEXT, 0, true, "Item", KV_PRIMARY, s);
        i = i + 1;
    }
    return k;
}

// nodes: 0 list (root, column), 1 header row with cells 2..4, then 4 nodes per data row (row, then 3 cells); count 5 + 4 * rows
pub fn kit_table(rows: u32) -> UiKit {
    let n : u32 = kit_rows_clamped(rows);
    var k : UiKit = kit_start(VF_LIST, KV_PRIMARY, KS_DEFAULT);
    k = kit_column(k, 0);
    k = kit_row(k, 0, KV_SECONDARY);
    var r : u32 = 0;
    while r < n {
        k = kit_row(k, 0, KV_PRIMARY);
        r = r + 1;
    }
    return k;
}

pub fn kit_node_count(k: UiKit) -> u32 {
    let g : VfGraph = k.graph;
    return g.node_count;
}

pub fn kit_state_at(k: UiKit, i: u32) -> u32 {
    let g : VfGraph = k.graph;
    if i >= g.node_count {
        return 0;
    }
    return k.state[i];
}

pub fn kit_variant_at(k: UiKit, i: u32) -> u32 {
    let g : VfGraph = k.graph;
    if i >= g.node_count {
        return 0;
    }
    return k.variant[i];
}

// true when node 0 is the only root and every other node has a parent with a smaller index
pub fn kit_parents_first(k: UiKit) -> bool {
    let g : VfGraph = k.graph;
    if g.node_count == 0 {
        return false;
    }
    if g.parent[0] != VF_NO_PARENT {
        return false;
    }
    var i : u32 = 1;
    while i < g.node_count {
        var p : u32 = g.parent[i] as u32;
        if p >= i {
            return false;
        }
        i = i + 1;
    }
    return true;
}

test button_graph {
    let k : UiKit = kit_button(KV_PRIMARY, KS_HOVER);
    let g : VfGraph = k.graph;
    assert kit_node_count(k) == 2;
    assert g.kind[0] == VF_CONTAINER;
    assert g.kind[1] == VF_BUTTON;
    assert g.parent[1] == 0;
    assert kit_variant_at(k, 1) == KV_PRIMARY;
    assert kit_state_at(k, 1) == KS_HOVER;
    assert kit_state_at(k, 0) == KS_DEFAULT;

    let k2 : UiKit = kit_button(KV_GHOST, KS_DISABLED);
    assert kit_node_count(k2) == 2;
    assert kit_variant_at(k2, 1) == 2;
    assert kit_state_at(k2, 1) == 3;
}

test card_graph {
    let k : UiKit = kit_card(KV_SUCCESS, KS_HOVER);
    let g : VfGraph = k.graph;
    assert kit_node_count(k) == 5;
    assert g.kind[0] == VF_CARD;
    assert g.kind[1] == VF_TEXT;
    assert g.kind[2] == VF_TEXT;
    assert g.kind[3] == VF_STACK;
    assert g.kind[4] == VF_BUTTON;
    assert g.parent[0] == VF_NO_PARENT;
    assert g.parent[1] == 0;
    assert g.parent[2] == 0;
    assert g.parent[3] == 0;
    assert g.parent[4] == 3;
    assert g.direction[0] == DIR_COLUMN;
    assert g.direction[3] == DIR_ROW;
    assert kit_variant_at(k, 0) == 3;
    assert kit_state_at(k, 0) == 1;
    assert kit_variant_at(k, 2) == KV_SECONDARY;
    assert kit_variant_at(k, 4) == KV_PRIMARY;
    assert kit_state_at(k, 4) == KS_DEFAULT;
}

test input_graph {
    let d : UiKit = kit_input(KV_PRIMARY, KS_DEFAULT);
    let dg : VfGraph = d.graph;
    assert kit_node_count(d) == 3;
    assert dg.kind[0] == VF_STACK;
    assert dg.kind[1] == VF_TEXT;
    assert dg.kind[2] == VF_INPUT;
    assert dg.parent[1] == 0;
    assert dg.parent[2] == 0;
    assert dg.label_ref[2] == 1;
    assert kit_state_at(d, 2) == KS_DEFAULT;

    let e : UiKit = kit_input(KV_PRIMARY, KS_ERROR);
    let eg : VfGraph = e.graph;
    assert kit_node_count(e) == 4;
    assert kit_node_count(e) == kit_node_count(d) + 1;
    assert eg.kind[3] == VF_TEXT;
    assert eg.parent[3] == eg.parent[2];
    assert kit_state_at(e, 2) == KS_ERROR;
    assert kit_state_at(e, 3) == KS_ERROR;
    assert kit_variant_at(e, 3) == KV_WARN;

    let f : UiKit = kit_input(KV_PRIMARY, KS_FOCUS);
    assert kit_node_count(f) == 3;
    assert kit_state_at(f, 2) == 5;
}

test badge_graph {
    let b : UiKit = kit_badge(KV_WARN);
    let g : VfGraph = b.graph;
    assert kit_node_count(b) == 1;
    assert g.kind[0] == VF_BADGE;
    assert g.parent[0] == VF_NO_PARENT;
    assert kit_variant_at(b, 0) == 4;
    assert kit_state_at(b, 0) == KS_DEFAULT;

    let b2 : UiKit = kit_badge(KV_SUCCESS);
    assert kit_variant_at(b2, 0) == 3;
}

test nav_active {
    let n0 : UiKit = kit_nav(0);
    let g : VfGraph = n0.graph;
    assert kit_node_count(n0) == 4;
    assert g.kind[0] == VF_LIST;
    assert g.kind[1] == VF_TEXT;
    assert g.kind[2] == VF_TEXT;
    assert g.kind[3] == VF_TEXT;
    assert g.parent[1] == 0;
    assert g.parent[2] == 0;
    assert g.parent[3] == 0;
    assert kit_state_at(n0, 1) == KS_FOCUS;
    assert kit_state_at(n0, 2) == KS_DEFAULT;
    assert kit_state_at(n0, 3) == KS_DEFAULT;

    let n1 : UiKit = kit_nav(1);
    assert kit_state_at(n1, 1) == KS_DEFAULT;
    assert kit_state_at(n1, 2) == KS_FOCUS;
    assert kit_state_at(n1, 3) == KS_DEFAULT;

    let n2 : UiKit = kit_nav(2);
    assert kit_state_at(n2, 1) == KS_DEFAULT;
    assert kit_state_at(n2, 2) == KS_DEFAULT;
    assert kit_state_at(n2, 3) == KS_FOCUS;

    let n7 : UiKit = kit_nav(7);
    assert kit_node_count(n7) == 4;
    assert kit_state_at(n7, 1) == KS_DEFAULT;
    assert kit_state_at(n7, 2) == KS_DEFAULT;
    assert kit_state_at(n7, 3) == 5;
}

test table_rows {
    let t1 : UiKit = kit_table(1);
    let g1 : VfGraph = t1.graph;
    assert kit_node_count(t1) == 9;
    assert g1.kind[0] == VF_LIST;
    assert g1.kind[1] == VF_STACK;
    assert g1.kind[2] == VF_TEXT;
    assert g1.kind[4] == VF_TEXT;
    assert g1.kind[5] == VF_STACK;
    assert g1.kind[8] == VF_TEXT;
    assert g1.parent[1] == 0;
    assert g1.parent[2] == 1;
    assert g1.parent[3] == 1;
    assert g1.parent[4] == 1;
    assert g1.parent[5] == 0;
    assert g1.parent[6] == 5;
    assert g1.parent[7] == 5;
    assert g1.parent[8] == 5;
    assert kit_variant_at(t1, 2) == KV_SECONDARY;
    assert kit_variant_at(t1, 6) == KV_PRIMARY;

    let t2 : UiKit = kit_table(2);
    let g2 : VfGraph = t2.graph;
    assert kit_node_count(t2) == 13;
    assert g2.kind[9] == VF_STACK;
    assert g2.parent[9] == 0;
    assert g2.parent[10] == 9;
    assert g2.parent[11] == 9;
    assert g2.parent[12] == 9;
    assert g2.parent[6] == 5;

    assert kit_node_count(kit_table(0)) == 9;
    assert kit_node_count(kit_table(4)) == 13;
    assert kit_node_count(kit_table(9)) == 13;

    // capacity: rows 1..2 fit in 16 nodes, a 3rd data row would need 17
    let fits : u32 = 1 + (1 + KIT_TABLE_COLS) * (1 + KIT_TABLE_MAX_ROWS);
    let over : u32 = 1 + (1 + KIT_TABLE_COLS) * (2 + KIT_TABLE_MAX_ROWS);
    assert fits == 13;
    assert over == 17;
    assert fits <= VF_MAX_NODES;
    assert over > VF_MAX_NODES;
}

test no_orphans {
    assert kit_parents_first(kit_button(KV_PRIMARY, KS_DEFAULT)) == true;
    assert kit_parents_first(kit_card(KV_PRIMARY, KS_DEFAULT)) == true;
    assert kit_parents_first(kit_input(KV_PRIMARY, KS_DEFAULT)) == true;
    assert kit_parents_first(kit_input(KV_PRIMARY, KS_ERROR)) == true;
    assert kit_parents_first(kit_badge(KV_PRIMARY)) == true;
    assert kit_parents_first(kit_nav(1)) == true;
    assert kit_parents_first(kit_table(1)) == true;
    assert kit_parents_first(kit_table(2)) == true;

    // negative control: a parent index at or above the node's own index must be refused
    var bad : UiKit = kit_card(KV_PRIMARY, KS_DEFAULT);
    var bg : VfGraph = bad.graph;
    bg.parent[1] = 3;
    bad.graph = bg;
    assert kit_parents_first(bad) == false;
}

test builders_validate {
    let k1 : UiKit = kit_button(KV_PRIMARY, KS_DEFAULT);
    let k2 : UiKit = kit_card(KV_SUCCESS, KS_HOVER);
    let k3 : UiKit = kit_input(KV_PRIMARY, KS_DEFAULT);
    let k4 : UiKit = kit_input(KV_PRIMARY, KS_ERROR);
    let k5 : UiKit = kit_badge(KV_WARN);
    let k6 : UiKit = kit_nav(2);
    let k7 : UiKit = kit_table(1);
    let k8 : UiKit = kit_table(2);
    let g1 : VfGraph = k1.graph;
    let g2 : VfGraph = k2.graph;
    let g3 : VfGraph = k3.graph;
    let g4 : VfGraph = k4.graph;
    let g5 : VfGraph = k5.graph;
    let g6 : VfGraph = k6.graph;
    let g7 : VfGraph = k7.graph;
    let g8 : VfGraph = k8.graph;
    assert vf_validate(g1) == VF_OK;
    assert vf_validate(g2) == VF_OK;
    assert vf_validate(g3) == VF_OK;
    assert vf_validate(g4) == VF_OK;
    assert vf_validate(g5) == VF_OK;
    assert vf_validate(g6) == VF_OK;
    assert vf_validate(g7) == VF_OK;
    assert vf_validate(g8) == VF_OK;
}

test kit_counts_match_the_variant_and_state_enums {
    assert KV_COUNT == 5;
    assert KS_COUNT == 6;
    assert KIT_COMPONENT_COUNT == 6;
    assert KV_WARN == KV_COUNT - 1;
    assert KS_FOCUS == KS_COUNT - 1;
}

test negative {
    assert kit_state_at(kit_button(0, 3), 1) == KS_DISABLED;
    assert kit_state_at(kit_button(0, 3), 1) != KS_DEFAULT;
    assert kit_node_count(kit_table(4)) > kit_node_count(kit_table(1));

    // negative control for the read guard: a value stored past the node count must read as 0
    var tall : UiKit = kit_badge(KV_WARN);
    tall.variant[5] = 4;
    tall.state[5] = 5;
    assert tall.variant[5] == 4;
    assert kit_variant_at(tall, 0) == 4;
    assert kit_variant_at(tall, 5) == 0;
    assert kit_state_at(tall, 5) == 0;
    assert kit_state_at(tall, 16) == 0;
}
