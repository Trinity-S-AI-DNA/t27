// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_connection.t27 -- Connection preview and validation for the NETLIST constructor.
; Ring 2, Wave I1 of epic #13650.
; NcPreview: drag state -- source port, hover target, active flag.
; NcResult: validation verdict (ok/refused) and reason code.
; nc_validate(src_kind, dst_kind): wraps np_can_connect with explicit reason codes.
; Depends on master (all prior netlist specs merged).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_connection;

use t27f::netlist_graph::{NG_NODE_KINDS, NG_NODE_NET, NG_NODE_PIN, NG_NODE_DEVICE,
    NG_NODE_BLOCK, NG_NODE_INSTANCE, NG_NODE_REFUSAL};
use t27f::netlist_node_port::{np_can_connect};

; ── Reason codes ──────────────────────────────────────────────────────────────
pub const NC_OK            : u8 = 0;
pub const NC_INCOMPATIBLE  : u8 = 1;
pub const NC_INVALID_KIND  : u8 = 2;
pub const NC_SELF_LOOP     : u8 = 3;

; ── NcResult ──────────────────────────────────────────────────────────────────
; Validation verdict returned by nc_validate.
pub struct NcResult {
    ok     : bool,
    reason : u8,
}

; ── NcPreview ─────────────────────────────────────────────────────────────────
; Drag state for a pending connection: source port -> hover target.
; active == false means no drag is in progress (all other fields ignored).
pub struct NcPreview {
    active    : bool,
    src_node  : u32,
    src_kind  : u8,
    dst_node  : u32,
    dst_kind  : u8,
}

; ── Validation ────────────────────────────────────────────────────────────────
; Returns NC_INVALID_KIND when either kind is out of range.
; Returns NC_SELF_LOOP when src_node == dst_node and both are valid.
; Returns NC_INCOMPATIBLE when np_can_connect is false.
; Returns NC_OK otherwise.
pub fn nc_validate_nodes(src_kind: u8, src_node: u32, dst_kind: u8, dst_node: u32) -> NcResult {
    var r : NcResult;
    r.ok     = false;
    r.reason = NC_INVALID_KIND;
    if (src_kind >= NG_NODE_KINDS) { return r; }
    if (dst_kind >= NG_NODE_KINDS) { return r; }
    if (src_node == dst_node) {
        r.reason = NC_SELF_LOOP;
        return r;
    }
    if (np_can_connect(src_kind, dst_kind) == false) {
        r.reason = NC_INCOMPATIBLE;
        return r;
    }
    r.ok     = true;
    r.reason = NC_OK;
    return r;
}

; Convenience: validate by kind only (no node index -- for hover preview without full graph).
pub fn nc_validate(src_kind: u8, dst_kind: u8) -> NcResult {
    var r : NcResult;
    r.ok     = false;
    r.reason = NC_INVALID_KIND;
    if (src_kind >= NG_NODE_KINDS) { return r; }
    if (dst_kind >= NG_NODE_KINDS) { return r; }
    if (np_can_connect(src_kind, dst_kind) == false) {
        r.reason = NC_INCOMPATIBLE;
        return r;
    }
    r.ok     = true;
    r.reason = NC_OK;
    return r;
}

; ── NcPreview helpers ─────────────────────────────────────────────────────────
pub fn nc_preview_result(p: NcPreview) -> NcResult {
    if (p.active == false) {
        var r : NcResult;
        r.ok     = false;
        r.reason = NC_INVALID_KIND;
        return r;
    }
    return nc_validate_nodes(p.src_kind, p.src_node, p.dst_kind, p.dst_node);
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test net_to_pin_is_ok {
    let r : NcResult = nc_validate(NG_NODE_NET, NG_NODE_PIN);
    assert r.ok == true;
    assert r.reason == NC_OK;
}

test net_to_device_is_ok {
    let r : NcResult = nc_validate(NG_NODE_NET, NG_NODE_DEVICE);
    assert r.ok == true;
    assert r.reason == NC_OK;
}

test net_to_block_is_incompatible {
    let r : NcResult = nc_validate(NG_NODE_NET, NG_NODE_BLOCK);
    assert r.ok == false;
    assert r.reason == NC_INCOMPATIBLE;
}

test refusal_as_src_is_incompatible {
    let r : NcResult = nc_validate(NG_NODE_REFUSAL, NG_NODE_PIN);
    assert r.ok == false;
    assert r.reason == NC_INCOMPATIBLE;
}

test invalid_src_kind_gives_invalid {
    let r : NcResult = nc_validate(NG_NODE_KINDS, NG_NODE_PIN);
    assert r.ok == false;
    assert r.reason == NC_INVALID_KIND;
}

test invalid_dst_kind_gives_invalid {
    let r : NcResult = nc_validate(NG_NODE_NET, NG_NODE_KINDS);
    assert r.ok == false;
    assert r.reason == NC_INVALID_KIND;
}

test self_loop_is_refused {
    let r : NcResult = nc_validate_nodes(NG_NODE_NET, 3, NG_NODE_NET, 3);
    assert r.ok == false;
    assert r.reason == NC_SELF_LOOP;
}

test self_loop_different_kinds_is_refused {
    let r : NcResult = nc_validate_nodes(NG_NODE_NET, 2, NG_NODE_PIN, 2);
    assert r.ok == false;
    assert r.reason == NC_SELF_LOOP;
}

test block_to_pin_is_ok {
    let r : NcResult = nc_validate(NG_NODE_BLOCK, NG_NODE_PIN);
    assert r.ok == true;
    assert r.reason == NC_OK;
}

test inactive_preview_gives_no_result {
    var p : NcPreview;
    p.active   = false;
    p.src_node = 0;
    p.src_kind = NG_NODE_NET;
    p.dst_node = 1;
    p.dst_kind = NG_NODE_PIN;
    let r : NcResult = nc_preview_result(p);
    assert r.ok == false;
}

test active_preview_net_to_pin_ok {
    var p : NcPreview;
    p.active   = true;
    p.src_node = 0;
    p.src_kind = NG_NODE_NET;
    p.dst_node = 1;
    p.dst_kind = NG_NODE_PIN;
    let r : NcResult = nc_preview_result(p);
    assert r.ok == true;
    assert r.reason == NC_OK;
}

test active_preview_self_loop_refused {
    var p : NcPreview;
    p.active   = true;
    p.src_node = 5;
    p.src_kind = NG_NODE_NET;
    p.dst_node = 5;
    p.dst_kind = NG_NODE_PIN;
    let r : NcResult = nc_preview_result(p);
    assert r.ok == false;
    assert r.reason == NC_SELF_LOOP;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant nc_ok_reason_is_zero { assert NC_OK == 0; }

invariant net_pin_always_ok {
    let r : NcResult = nc_validate(NG_NODE_NET, NG_NODE_PIN);
    assert r.ok == true;
}

invariant invalid_kind_always_refused {
    let r : NcResult = nc_validate(NG_NODE_KINDS, NG_NODE_KINDS);
    assert r.ok == false;
    assert r.reason == NC_INVALID_KIND;
}
