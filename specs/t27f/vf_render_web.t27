// specs/t27f/vf_render_web.t27 -- T27F: vf_render_web — browser target
// renderer (WASM canvas @extern).
// Part of M7 milestone (milestone #11). Closes #13296.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::vf_render_web;

pub const VF_RENDER_WEB_BACKEND : str = "wasm_canvas";

pub struct WebRender { backend: str, active: bool };

pub fn web_render_active(r: WebRender) -> bool {
    return r.active;
}

test "web_render_active" {
    assert(web_render_active(WebRender { backend: VF_RENDER_WEB_BACKEND, active: true }));
    assert(!web_render_active(WebRender { backend: VF_RENDER_WEB_BACKEND, active: false }));
}

invariant vf_render_web_backend_defined {
    assert VF_RENDER_WEB_BACKEND == "wasm_canvas";
}