// SPDX-License-Identifier: Apache-2.0
; T27F renderer, native target: one VfGraph frame blitted into a T27 OS window
; Refs gHashTag/t27#13298 gHashTag/t27#13214
; The frame is the UI Kit raster: vct_render (vf_card_tok) in theme TH_T27 with Outfit type, 24-bit, top row first,
;   handed whole to the host in one t27os_blit
; A refused frame blits nothing and returns vf_card's code (VC_BAD_RASTER for a bad viewport or a short buffer)
; The externs make this spec t27b-only; the tests call only the pure functions, never an extern
; NOT here: the host side of t27os_blit in the T27 OS window; no window has shown this frame yet

module t27f_vf_render_native;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_CARD;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_card::VC_OK;
use t27f::vf_card::VC_BAD_RASTER;
use t27f::vf_card_tok::vct_render;
use t27f::vf_theme::TH_T27;
use t27f::vf_theme::TH_ACCENT;
use t27f::vf_theme::TH_CARD_BORDER;
use t27f::vf_theme::th_color;
use t27f::vf_theme::th_kind_color;
use t27f::vf_render_web::vf_rgb_at;
use t27f::vf_menu::vf_menu_graph;
use t27f::vf_menu::VF_MENU_H;

; the host import
fn t27os_blit(pixels: []const u8, w: u32, h: u32) -> void { @extern("t27os_blit"); }

pub var VF_N_RGB : [121500]u8 = [0] ** 121500;

; how many bytes the blit hands over for a render code: w * h * 3 on success, 0 otherwise
pub fn vf_native_blit_len(code: u32, w: u32, h: u32) -> u32 {
    if code != VC_OK {
        return 0;
    }
    return w * h * 3;
}

; render into rgb and return the code; the pure half of vf_native_present
pub fn vf_native_plan(g: VfGraph, l: VfLayout, rgb: []u8, w: u32, h: u32) -> u32 {
    return vct_render(g, l, rgb, w, h, TH_T27);
}

; render, then blit only on success
pub fn vf_native_present(g: VfGraph, l: VfLayout, rgb: []u8, w: u32, h: u32) -> u32 {
    var code : u32 = vf_native_plan(g, l, rgb, w, h);
    var n : u32 = vf_native_blit_len(code, w, h);
    if n > 0 {
        t27os_blit(rgb[0..n], w, h);
    }
    return code;
}

test valid_graph_blits {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    var code : u32 = vf_native_plan(g, l, &VF_N_RGB, 375, VF_MENU_H);
    assert code == VC_OK;
    assert vf_native_blit_len(code, 375, VF_MENU_H) == 121500;
    // the theme, not a palette: card outline 0x333333, Browser accent 0x00FF88, card inside the theme's card fill
    assert vf_rgb_at(&VF_N_RGB, 375, 0, 0) == th_color(TH_T27, TH_CARD_BORDER);
    assert vf_rgb_at(&VF_N_RGB, 375, 0, 0) == 3355443;
    assert vf_rgb_at(&VF_N_RGB, 375, 17, 53) == th_color(TH_T27, TH_ACCENT);
    assert vf_rgb_at(&VF_N_RGB, 375, 360, 60) == th_kind_color(TH_T27, VF_CARD as u32);
}

test invalid_viewport_blits_nothing {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    var code : u32 = vf_native_plan(g, l, &VF_N_RGB, 0, VF_MENU_H);
    assert code == VC_BAD_RASTER;
    assert vf_native_blit_len(code, 0, VF_MENU_H) == 0;
    code = vf_native_plan(g, l, &VF_N_RGB, 375, 0);
    assert vf_native_blit_len(code, 375, 0) == 0;
    code = vf_native_plan(g, l, &VF_N_RGB, 5000, 10);
    assert code == VC_BAD_RASTER;
    // a buffer one row short is refused too: 121500 - 1125 = 120375
    code = vf_native_plan(g, l, VF_N_RGB[0..120375], 375, VF_MENU_H);
    assert code == VC_BAD_RASTER;
    assert vf_native_blit_len(code, 375, VF_MENU_H) == 0;
}
