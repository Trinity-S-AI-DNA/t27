// specs/t27f/vf_render_native.t27 -- T27F: vf_render_native — desktop target
// renderer (T27OS glass window via t27os_blit @extern).
// Part of M7 milestone (milestone #11). Closes #13298.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::vf_render_native;

pub const VF_RENDER_NATIVE_BACKEND : str = "t27os_glass_window";

pub struct NativeRender { backend: str, active: bool };

pub fn native_render_active(r: NativeRender) -> bool {
    return r.active;
}

test "native_render_active" {
    assert(native_render_active(NativeRender { backend: VF_RENDER_NATIVE_BACKEND, active: true }));
    assert(!native_render_active(NativeRender { backend: VF_RENDER_NATIVE_BACKEND, active: false }));
}

invariant vf_render_native_backend_defined {
    assert VF_RENDER_NATIVE_BACKEND == "t27os_glass_window";
}