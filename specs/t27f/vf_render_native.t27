// SPDX-License-Identifier: Apache-2.0
; T27F renderer, native target: one VfGraph frame blitted into a T27 OS window
; Refs gHashTag/t27#13298
; The frame is vf_render_rgb's 24-bit raster (FR-002), handed whole to the host in one t27os_blit (FR-001)
; A refused frame blits nothing and returns vf_render's code (FR-003)
; The externs make this spec t27b-only; the tests call only the pure functions, never an extern
; NOT here: the host side of t27os_blit in the T27 OS window; no window has shown this frame yet

module t27f_vf_render_native;
use t27f::visual_factory_contract::VfGraph;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_pixel_color;
use t27f::vf_pixel::vf_px_card;
use t27f::vf_render::vf_render_rgb;
use t27f::vf_render::VF_R_OK;
use t27f::vf_render::VF_R_SMALL;
use t27f::vf_render::VF_R_BORDER;
use t27f::vf_render_web::vf_rgb_at;
use t27f::vf_menu::vf_menu_graph;
use t27f::vf_menu::VF_MENU_H;

; the host import (FR-001)
fn t27os_blit(pixels: []const u8, w: u32, h: u32) -> void { @extern("t27os_blit"); }

pub var VF_N_RGB : [216000]u8 = [0] ** 216000;

; how many bytes the blit hands over for a render code: w * h * 3 on success, 0 otherwise
pub fn vf_native_blit_len(code: u8, w: u32, h: u32) -> u32 {
    if code != VF_R_OK {
        return 0;
    }
    return w * h * 3;
}

; render into rgb and return the code; the pure half of vf_native_present
pub fn vf_native_plan(g: VfGraph, l: VfLayout, rgb: []u8, w: u32, h: u32) -> u8 {
    return vf_render_rgb(g, l, rgb, w, h);
}

; render, then blit only on success (FR-003)
pub fn vf_native_present(g: VfGraph, l: VfLayout, rgb: []u8, w: u32, h: u32) -> u8 {
    var code : u8 = vf_native_plan(g, l, rgb, w, h);
    var n : u32 = vf_native_blit_len(code, w, h);
    if n > 0 {
        t27os_blit(rgb[0..n], w, h);
    }
    return code;
}

test valid_graph_blits {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    var code : u8 = vf_native_plan(g, l, &VF_N_RGB, 375, VF_MENU_H);
    assert code == VF_R_OK;
    assert vf_native_blit_len(code, 375, VF_MENU_H) == 94500;
    assert vf_rgb_at(&VF_N_RGB, 375, 0, 0) == VF_R_BORDER;
    assert vf_rgb_at(&VF_N_RGB, 375, 90, 40) == vf_pixel_color(g, l, 90, 40);
    assert vf_rgb_at(&VF_N_RGB, 375, 90, 40) == 1402304;
    // the 375 x 192 card fills the whole buffer
    var gc : VfGraph = vf_px_card(375);
    var lc : VfLayout = vf_layout(gc);
    code = vf_native_plan(gc, lc, &VF_N_RGB, 375, 192);
    assert vf_native_blit_len(code, 375, 192) == 216000;
}

test invalid_viewport_blits_nothing {
    var g : VfGraph = vf_menu_graph(375);
    var l : VfLayout = vf_layout(g);
    var code : u8 = vf_native_plan(g, l, &VF_N_RGB, 0, VF_MENU_H);
    assert code == VF_R_SMALL;
    assert vf_native_blit_len(code, 0, VF_MENU_H) == 0;
    code = vf_native_plan(g, l, &VF_N_RGB, 375, 0);
    assert vf_native_blit_len(code, 375, 0) == 0;
    code = vf_native_plan(g, l, &VF_N_RGB, 5000, 10);
    assert code == VF_R_SMALL;
    // a buffer one row short is refused too
    code = vf_native_plan(g, l, VF_N_RGB[0..93375], 375, VF_MENU_H);
    assert code == VF_R_SMALL;
    assert vf_native_blit_len(code, 375, VF_MENU_H) == 0;
}
