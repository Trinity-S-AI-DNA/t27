// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_view.t27 -- renderer-neutral layout of a NetlistGraph.
; Ring 2, Wave C1 of epic #13650.  Closes #13716.
; Maps each node to a column (= node_kind) and row (order within that kind).
; Style functions map inference labels to canonical UIKit brand tokens.
; Numbers only; a host (glass_window, Web) draws them.
; Does not define any RGBA literal: all colors come from uikit_native_tokens.
; Does not define a second graph model: imports the IR from t27f_netlist_graph.
; Refs #13650, #13711, #13716.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_view;

use t27f::netlist_graph::{NetlistGraph, NG_LABEL_EXACT, NG_LABEL_DERIVED, NG_LABEL_SUGGESTED, NG_LABEL_UNKNOWN, NG_NODE_KINDS, inverter_graph};
use uikit::native_tokens::{T27_TEXT_R, T27_TEXT_G, T27_TEXT_B, T27_ACCENT_R, T27_ACCENT_G, T27_ACCENT_B, T27_MUTED_R, T27_MUTED_G, T27_MUTED_B, T27_BG_R, T27_BG_G, T27_BG_B};

; ── Layout geometry ───────────────────────────────────────────────────────────
; Column for each node kind (0..NG_NODE_KINDS-1) is the kind value itself.
; Pixel x = node_col * NV_COL_STRIDE + NV_COL_PAD.
; Pixel y = node_row * NV_ROW_STRIDE + NV_ROW_PAD.
pub const NV_COL_STRIDE : u32 = 180;
pub const NV_ROW_STRIDE : u32 = 52;
pub const NV_COL_PAD    : u32 = 16;
pub const NV_ROW_PAD    : u32 = 16;
pub const NV_NODE_W     : u32 = 160;
pub const NV_NODE_H     : u32 = 44;

; ── NvPlan struct ─────────────────────────────────────────────────────────────
; node_col[i] = column (= node_kind of node i).
; node_row[i] = row within that column.
; Indexed 0..node_count-1.
pub struct NvPlan {
    node_count : u32,
    node_col   : [1024]u32,
    node_row   : [1024]u32,
}

; ── Layout function ───────────────────────────────────────────────────────────
pub fn nv_layout(g: NetlistGraph) -> NvPlan {
    var p : NvPlan;
    p.node_count = g.node_count;
    p.node_col   = [0; 1024];
    p.node_row   = [0; 1024];
    var col_next : [6]u32 = [0; 6];
    var n : u32 = 0;
    while (n < g.node_count) {
        let ki : usize = g.node_kind[n as usize] as usize;
        p.node_col[n as usize] = ki as u32;
        p.node_row[n as usize] = col_next[ki];
        col_next[ki] = col_next[ki] + 1;
        n = n + 1;
    }
    return p;
}

; ── Pixel accessors ───────────────────────────────────────────────────────────
pub fn nv_node_x(p: NvPlan, i: u32) -> u32 {
    return p.node_col[i as usize] * NV_COL_STRIDE + NV_COL_PAD;
}

pub fn nv_node_y(p: NvPlan, i: u32) -> u32 {
    return p.node_row[i as usize] * NV_ROW_STRIDE + NV_ROW_PAD;
}

; ── Style functions: canonical UIKit brand tokens, never hardcoded RGBA ───────
; EXACT/DERIVED: white text; SUGGESTED: accent green; UNKNOWN: muted grey.
pub fn nv_text_r(label: u8) -> f64 {
    if (label == NG_LABEL_UNKNOWN)   { return T27_MUTED_R; }
    if (label == NG_LABEL_SUGGESTED) { return T27_ACCENT_R; }
    return T27_TEXT_R;
}

pub fn nv_text_g(label: u8) -> f64 {
    if (label == NG_LABEL_UNKNOWN)   { return T27_MUTED_G; }
    if (label == NG_LABEL_SUGGESTED) { return T27_ACCENT_G; }
    return T27_TEXT_G;
}

pub fn nv_text_b(label: u8) -> f64 {
    if (label == NG_LABEL_UNKNOWN)   { return T27_MUTED_B; }
    if (label == NG_LABEL_SUGGESTED) { return T27_ACCENT_B; }
    return T27_TEXT_B;
}

; Background: always brand black from uikit_native_tokens.
pub fn nv_bg_r() -> f64 { return T27_BG_R; }
pub fn nv_bg_g() -> f64 { return T27_BG_G; }
pub fn nv_bg_b() -> f64 { return T27_BG_B; }

; ── Tests ─────────────────────────────────────────────────────────────────────
test inverter_layout_has_five_nodes {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    assert p.node_count == 5;
}

test block_node_at_col_zero_row_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    assert p.node_col[0] == 0;
    assert p.node_row[0] == 0;
    assert nv_node_x(p, 0) == NV_COL_PAD;
    assert nv_node_y(p, 0) == NV_ROW_PAD;
}

test pin_nodes_share_col_distinct_rows {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    assert p.node_col[1] == p.node_col[2];
    assert p.node_row[1] != p.node_row[2];
}

test exact_label_uses_text_color {
    assert nv_text_r(NG_LABEL_EXACT)   == T27_TEXT_R;
    assert nv_text_g(NG_LABEL_EXACT)   == T27_TEXT_G;
    assert nv_text_b(NG_LABEL_EXACT)   == T27_TEXT_B;
}

test derived_label_uses_text_color {
    assert nv_text_r(NG_LABEL_DERIVED) == T27_TEXT_R;
    assert nv_text_g(NG_LABEL_DERIVED) == T27_TEXT_G;
}

test suggested_label_uses_accent_color {
    assert nv_text_r(NG_LABEL_SUGGESTED) == T27_ACCENT_R;
    assert nv_text_g(NG_LABEL_SUGGESTED) == T27_ACCENT_G;
    assert nv_text_b(NG_LABEL_SUGGESTED) == T27_ACCENT_B;
}

test unknown_label_uses_muted_color {
    assert nv_text_r(NG_LABEL_UNKNOWN) == T27_MUTED_R;
    assert nv_text_g(NG_LABEL_UNKNOWN) == T27_MUTED_G;
    assert nv_text_b(NG_LABEL_UNKNOWN) == T27_MUTED_B;
}

test bg_uses_brand_black {
    assert nv_bg_r() == T27_BG_R;
    assert nv_bg_g() == T27_BG_G;
    assert nv_bg_b() == T27_BG_B;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant nv_col_stride_positive {
    assert NV_COL_STRIDE > 0;
}

invariant nv_row_stride_positive {
    assert NV_ROW_STRIDE > 0;
}

invariant nv_node_fits_in_column {
    assert NV_NODE_W < NV_COL_STRIDE;
}

invariant nv_node_fits_in_row {
    assert NV_NODE_H < NV_ROW_STRIDE;
}
