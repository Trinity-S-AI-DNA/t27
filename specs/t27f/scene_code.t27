// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_code.t27 -- scene A_CODE of reel_factory.t27: the lesson's own code, set as a card
// of source with a gutter of line numbers. Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: the scene every lesson can have. The card's height is the lesson's line count and each of
// its lines is the lesson's line, so a four-line lesson and a twenty-line lesson do not make one
// picture. The first word of every line is set in the accent (the keyword rhythm: `pub`, `fn`,
// `const`, `test`), digits in blue, a quoted string in green, the rest pale.
//
// THE FUNCTION: code_px(t, acc, n, x, y) is the colour of canvas point (x, y) in lesson t's code scene.
// acc is the accent colour of the plan, n is unused here (the code scene counts lines itself). The
// canvas is scene_raster's 360 x 640; scene_still.t27 moves and scales it for the camera and the
// layout before it calls this.
//
// NOT CLAIMED: lines longer than COLS characters are cut at the card's edge, not wrapped; no
// keyword table is read here (that is reel_factory's), only the first word of a line is coloured.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_code;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::in_disc;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_letter;
use t27f::scene_raster::char_on;
use t27f::scene_raster::num_on;
use t27f::reel_topics::code_line0;
use t27f::reel_topics::code_lines;
use t27f::reel_topics::line_len;
use t27f::reel_topics::code_byte;
use std::text::is_digit;

pub const PANEL_X : i32 = 14;
pub const PANEL_Y : i32 = 118;
pub const PANEL_W : i32 = 332;
pub const BAR : i32 = 24;
pub const LINE_H : i32 = 12;
pub const ADV : i32 = 8;
pub const PAD : i32 = 10;
pub const GUTTER : i32 = 3;      // columns taken by the line number and a space
pub const COLS : i32 = 38;       // columns the card shows, gutter included

pub const BG_CARD : i32 = 0x0E1222;
pub const INK : i32 = 0xDCE1F0;
pub const INK_DIM : i32 = 0x59607A;
pub const INK_NUM : i32 = 0x78BEFF;
pub const INK_STR : i32 = 0x4ADE80;

// The cell texture behind the card (scene_bg, grid cells), seeded by the lesson.
pub fn backdrop(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    return bg_px(0, acc, seed_of(t, n, 0), x, y);
}

// The height of the card for lesson t, bottom edge.
pub fn card_bottom(t: usize) -> i32 {
    return PANEL_Y + BAR + @as(i32, @intCast(code_lines(t))) * LINE_H + PAD;
}

fn is_letter(c: u8) -> bool {
    return lex_letter(@as(i32, @intCast(c)));
}
// The column of the first letter of line l and the column just past its first word.
fn first_word_start(l: usize) -> usize {
    var k : usize = 0;
    while (k < line_len(l) && !is_letter(code_byte(l, k))) { k = k + 1; }
    return k;
}
fn first_word_end(l: usize) -> usize {
    var k : usize = first_word_start(l);
    while (k < line_len(l) && (is_letter(code_byte(l, k)) || is_digit(code_byte(l, k)))) { k = k + 1; }
    return k;
}
// Whether column k of line l sits inside a quoted string (an odd number of quotes before it).
fn in_string(l: usize, k: usize) -> bool {
    var q : usize = 0;
    var j : usize = 0;
    while (j < k) {
        if (code_byte(l, j) == 34) { q = q + 1; }
        j = j + 1;
    }
    return q % 2 == 1 || code_byte(l, k) == 34;
}

// The colour of the character at column k of line l.
pub fn ink(l: usize, k: usize, acc: i32) -> i32 {
    const c = code_byte(l, k);
    if (in_string(l, k)) { return INK_STR; }
    if (k >= first_word_start(l) && k < first_word_end(l)) { return acc; }
    if (is_digit(c)) { return INK_NUM; }
    if (is_letter(c)) { return INK; }
    return INK_DIM;
}

pub fn code_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    var c = backdrop(t, acc, n, x, y);
    const bot = card_bottom(t);
    if (!in_rect(x, y, PANEL_X - 2, PANEL_Y - 2, PANEL_X + PANEL_W + 2, bot + 2)) { return c; }
    // the border, two canvas pixels in the accent
    if (!in_rect(x, y, PANEL_X, PANEL_Y, PANEL_X + PANEL_W, bot)) { return acc; }
    c = BG_CARD;
    // the title bar: three dots and the lesson's number
    if (y < PANEL_Y + BAR) {
        c = mix(BG_CARD, acc, 70);
        if (in_disc(x, y, PANEL_X + 12, PANEL_Y + 12, 4)) { c = INK_STR; }
        if (in_disc(x, y, PANEL_X + 26, PANEL_Y + 12, 4)) { c = acc; }
        if (in_disc(x, y, PANEL_X + 40, PANEL_Y + 12, 4)) { c = INK_NUM; }
        if (num_on(@as(i32, @intCast(t)) + 1, x, y, PANEL_X + PANEL_W - 28, PANEL_Y + 7, 2)) { c = INK; }
        return c;
    }
    // the code: line row, column col; glyph pixels are two canvas pixels square
    const px0 = x - PANEL_X - 6;
    const py0 = y - PANEL_Y - BAR - 4;
    if (px0 < 0 || py0 < 0) { return c; }
    const row = @divTrunc(py0, LINE_H);
    const col = @divTrunc(px0, ADV);
    if (row >= @as(i32, @intCast(code_lines(t))) || col >= COLS) { return c; }
    const l = code_line0(t) + @as(usize, @intCast(row));
    const ox = PANEL_X + 6 + col * ADV;
    const oy = PANEL_Y + BAR + 4 + row * LINE_H;
    if (col < GUTTER - 1) {
        if (num_on(row + 1, x, y, PANEL_X + 6, oy, 2)) { return INK_DIM; }
        return c;
    }
    if (col == GUTTER - 1) { return c; }
    const k = @as(usize, @intCast(col - GUTTER));
    if (k >= line_len(l)) { return c; }
    if (char_on(@as(i32, code_byte(l, k)), x, y, ox, oy, 2)) { return ink(l, k, acc); }
    return c;
}

// ---- tests ----

test "the card is as tall as the lesson's code" {
    var t : usize = 0;
    while (t < 27) {
        assert(card_bottom(t) == PANEL_Y + BAR + @as(i32, @intCast(code_lines(t))) * LINE_H + PAD);
        assert(card_bottom(t) < 640);
        t = t + 1;
    }
    assert(card_bottom(0) != card_bottom(14));
}

test "the scene reads the lesson's own code: lesson 0 and lesson 14 do not draw one picture" {
    var diff : i32 = 0;
    var inside : i32 = 0;
    var y : i32 = PANEL_Y;
    while (y < 560) {
        var x : i32 = PANEL_X;
        while (x < PANEL_X + PANEL_W) {
            const a = code_px(0, 0xF5B700, 0, x, y);
            const b = code_px(14, 0xF5B700, 0, x, y);
            if (a != b) { diff = diff + 1; }
            if (a == 0xF5B700) { inside = inside + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(diff > 4000);
    assert(inside > 100);
}

test "negative control: a card of the right height but another lesson's text is a different picture" {
    // lessons that have the same line count still draw their own bytes
    var found : bool = false;
    var a : usize = 0;
    while (a < 27 && !found) {
        var b : usize = a + 1;
        while (b < 27 && !found) {
            if (code_lines(a) == code_lines(b)) {
                var diff : i32 = 0;
                var y : i32 = PANEL_Y + BAR;
                while (y < card_bottom(a)) {
                    var x : i32 = PANEL_X;
                    while (x < PANEL_X + PANEL_W) {
                        if (code_px(a, 0xF5B700, 0, x, y) != code_px(b, 0xF5B700, 0, x, y)) { diff = diff + 1; }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                assert(diff > 500);
                found = true;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    assert(found);
}

test "every pixel is a colour and the scene draws inside the canvas" {
    var x : i32 = 0;
    while (x < 360) {
        var y : i32 = 0;
        while (y < 640) {
            const c = code_px(7, 0x8B5CF6, 0, x, y);
            assert(c >= 0 && c <= 0xFFFFFF);
            y = y + 17;
        }
        x = x + 11;
    }
}
