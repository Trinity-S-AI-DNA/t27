pub struct VctMetrics {
    status: u32,
    padding: u32,
    label_gap: u32,
    group_gap: u32,
    action_gap: u32,
    head_px: u32,
    label_px: u32,
    body_px: u32,
    max_inline: u32,
    min_target: u32,
    border: u32,
    control_inset: u32,
}

; the resolution of one token name: vtk_find then vtk_resolve; an unknown name is VTK_UNKNOWN, never a default value
pub fn vct_get(name: str) -> VtkResolved {
    return vtk_resolve(vtk_find(name));
}

; the refusal: the status that failed, every number 0
fn vct_refused(st: u32) -> VctMetrics {
    var m : VctMetrics = VctMetrics {
        status: st,
        padding: 0,
        label_gap: 0,
        group_gap: 0,
        action_gap: 0,
        head_px: 0,
        label_px: 0,
        body_px: 0,
        max_inline: 0,
        min_target: 0,
        border: 0,
        control_inset: 0,
    };
    return m;
}

; the eleven tokens of the card, resolved. Status 0 only when every one of them resolved VTK_OK; otherwise the first failing status, all numbers 0
pub fn vct_metrics() -> VctMetrics {
    var r_pad : VtkResolved = vct_get("space.card.padding");
    var r_lab : VtkResolved = vct_get("space.field.label_gap");
    var r_grp : VtkResolved = vct_get("space.field.group_gap");
    var r_act : VtkResolved = vct_get("space.action.gap");
    var r_head : VtkResolved = vct_get("type.heading");
    var r_label : VtkResolved = vct_get("type.label");
    var r_body : VtkResolved = vct_get("type.body");
    var r_max : VtkResolved = vct_get("layout.card.max_inline");
    var r_min : VtkResolved = vct_get("control.min_target");
    var r_bor : VtkResolved = vct_get("border.width");
    var r_ins : VtkResolved = vct_get("space.control.inset");
    var st : u32 = r_pad.status;
    if st == VTK_OK {
        st = r_lab.status;
    }
    if st == VTK_OK {
        st = r_grp.status;
    }
    if st == VTK_OK {
        st = r_act.status;
    }
    if st == VTK_OK {
        st = r_head.status;
    }
    if st == VTK_OK {
        st = r_label.status;
    }
    if st == VTK_OK {
        st = r_body.status;
    }
    if st == VTK_OK {
        st = r_max.status;
    }
    if st == VTK_OK {
        st = r_min.status;
    }
    if st == VTK_OK {
        st = r_bor.status;
    }
    if st == VTK_OK {
        st = r_ins.status;
    }
    if st != VTK_OK {
        return vct_refused(st);
    }
    var m : VctMetrics = VctMetrics {
        status: VTK_OK,
        padding: r_pad.value,
        label_gap: r_lab.value,
        group_gap: r_grp.value,
        action_gap: r_act.value,
        head_px: r_head.value,
        label_px: r_label.value,
        body_px: r_body.value,
        max_inline: r_max.value,
        min_target: r_min.value,
        border: r_bor.value,
        control_inset: r_ins.value,
    };
    return m;
}

; the task card with the numbers of m in its padding and gap fields. A metrics with a status other than 0 gives a blank graph (0 nodes)
pub fn vct_graph_with(m: VctMetrics, width: u32) -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    if m.status != 0 {
        return g;
    }
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "task-card");
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "title");
    var g2 : VfGraph = vf_add(g1, VF_BADGE, 0, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "status");
    var g3 : VfGraph = vf_add(g2, VF_STACK, 0, bit(P_TEST_ID), "field");
    var g4 : VfGraph = vf_add(g3, VF_TEXT, 3, bit(P_TEXT) + bit(P_TEST_ID), "owner-label");
    var g5 : VfGraph = vf_add(g4, VF_INPUT, 3, bit(P_LABEL_REF) + bit(P_TEST_ID), "owner-input");
    var g6 : VfGraph = vf_add(g5, VF_STACK, 0, bit(P_TEST_ID), "actions");
    var g7 : VfGraph = vf_add(g6, VF_BUTTON, 6, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "save");
    var g8 : VfGraph = vf_add(g7, VF_BUTTON, 6, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "cancel");

    g8.viewport_w = width;

    g8.label[0] = "Task card";
    g8.direction[0] = DIR_COLUMN;
    g8.padding[0] = m.padding;
    g8.gap[0] = m.group_gap;

    g8.text[1] = "Write the spec";

    g8.text[2] = "Open";
    g8.variant[2] = SUCCESS;

    g8.direction[3] = DIR_COLUMN;
    g8.gap[3] = m.label_gap;

    g8.text[4] = "Owner";

    g8.label_ref[5] = 4;

    g8.direction[6] = DIR_ROW;
    g8.gap[6] = m.action_gap;

    g8.text[7] = "Save";
    g8.variant[7] = PRIMARY;

    g8.text[8] = "Cancel";
    g8.variant[8] = SECONDARY;

    return g8;
}

; the task card at width design pixels, metrics from the tokens
pub fn vct_card_graph(width: u32) -> VfGraph {
    return vct_graph_with(vct_metrics(), width);
}

; ---- words for the host program's token lines ----

; the origin of a token as a word
pub fn vct_origin_word(origin: u32) -> str {
    if origin == VTK_ORG_FORMULA {
        return "formula";
    }
    if origin == VTK_ORG_ALIAS {
        return "alias";
    }
    if origin == VTK_ORG_EXPLICIT {
        return "explicit";
    }
    return "unknown";
}

; the name of the token this name is an alias of, "none" when it is not an alias or not a token
pub fn vct_alias_name(name: str) -> str {
    var id : u32 = vtk_find(name);
    if id == VTK_NONE {
        return "none";
    }
    var to : u32 = VTK_ALIAS_OF[id];
    if to >= VTK_COUNT {
        return "none";
    }
    let nm : str = VTK_NAMES[to];
    return nm;
}

; the id of the token at the end of the alias links of this name (the one that holds the value), VTK_NONE for an unknown name or a long chain
pub fn vct_root_id(name: str) -> u32 {
    var cur : u32 = vtk_find(name);
    var hops : u32 = 0;
    while cur < VTK_COUNT and hops <= VTK_HOP_LIMIT {
        var nx : u32 = VTK_ALIAS_OF[cur];
        if nx >= VTK_COUNT {
            return cur;
        }
        cur = nx;
        hops = hops + 1;
    }
    return VTK_NONE;
}

; the name of the root token
pub fn vct_root_name(name: str) -> str {
    var id : u32 = vct_root_id(name);
    if id >= VTK_COUNT {
        return "none";
    }
    let nm : str = VTK_NAMES[id];
    return nm;
}

; the origin of the root token as a word
pub fn vct_root_origin_word(name: str) -> str {
    var id : u32 = vct_root_id(name);
    if id >= VTK_COUNT {
        return "unknown";
    }
    return vct_origin_word(VTK_ORIGIN[id]);
}

; the proportion profile of a formula root ("spacing", "type", ...), the reason word of an explicit root ("WCAG_TARGET", ...), else "none"
pub fn vct_root_detail(name: str) -> str {
    var id : u32 = vct_root_id(name);
    if id >= VTK_COUNT {
        return "none";
    }
    if VTK_ORIGIN[id] == VTK_ORG_FORMULA {
        var p : u32 = VTK_PROFILE[id];
        if p == VP_SPACING {
            return "spacing";
        }
        if p == VP_TYPE {
            return "type";
        }
        if p == VP_COMPOSITION {
            return "composition";
        }
        if p == VP_DURATION {
            return "duration";
        }
        return "profile";
    }
    var why : u32 = VTK_WHY[id];
    if why == VTK_WHY_WCAG_TARGET {
        return "WCAG_TARGET";
    }
    if why == VTK_WHY_OWNER_FIXED {
        return "OWNER_FIXED";
    }
    if why == VTK_WHY_BASE_UNIT {
        return "BASE_UNIT";
    }
    return "none";
}

; the h2 (twice the exponent) of a formula root, 0 for any other root
pub fn vct_root_h2(name: str) -> u32 {
    var id : u32 = vct_root_id(name);
    if id >= VTK_COUNT {
        return 0;
    }
    if VTK_ORIGIN[id] != VTK_ORG_FORMULA {
        return 0;
    }
    return VTK_H2[id];
}

; ---- helpers for the tests below ----

; true when every rectangle but the card's width is the same in a and b (n nodes)
fn vct_same_rects(a: VfLayout, b: VfLayout, n: u32) -> bool {
    var i : u32 = 0;
    while i < n {
        if a.x[i] != b.x[i] {
            return false;
        }
        if a.y[i] != b.y[i] {
            return false;
        }
        if a.h[i] != b.h[i] {
            return false;
        }
        if i > 0 {
            if a.w[i] != b.w[i] {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

; the renderer's style record from the resolved metrics: padding is the text inset, max_inline the content width, head_px and body_px the
; type sizes, border the outline width, control_inset (pad_x) the text pen offset from a node edge. label_px and min_target are not painted: label text is drawn at body_px, and min_target is only checked
; against the layout. A refusal (all numbers 0) gives a style the renderer refuses with VC_BAD_METRICS
pub fn vct_style(m: VctMetrics) -> VcStyle {
    var st : VcStyle = VcStyle {
        inset: m.padding,
        max_w: m.max_inline,
        head_px: m.head_px,
        body_px: m.body_px,
        border: m.border,
        pad_x: m.control_inset,
    };
    return st;
}

; the raster of the renderer tests below: 375 x 230 x 3 bytes
var VCT_RGB : [258750]u8 = [0] ** 258750;

; colour 0xRRGGBB of the pixel (x, y) of VCT_RGB
fn vct_px(x: u32, y: u32) -> u32 {
    var at : usize = ((y * 375 + x) * 3) as usize;
    var pr : u32 = VCT_RGB[at] as u32;
    var pg : u32 = VCT_RGB[at + 1] as u32;
    var pb : u32 = VCT_RGB[at + 2] as u32;
    return pr * 65536 + pg * 256 + pb;
}

; how many pixels of VCT_RGB in columns x0..x1 and rows y0..y1 (end excluded) are not col
fn vct_count_not(x0: u32, x1: u32, y0: u32, y1: u32, col: u32) -> u32 {
    var n : u32 = 0;
    var y : u32 = y0;
    while y < y1 {
        var x : u32 = x0;
        while x < x1 {
            if vct_px(x, y) != col {
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

; leftmost column in [x0, x1) rows [y0, y1) of VCT_RGB where at least one pixel is not col; x1 when none
fn vct_first_ink_col(x0: u32, x1: u32, y0: u32, y1: u32, col: u32) -> u32 {
    var x : u32 = x0;
    var found : u32 = x1;
    while x < x1 {
        if vct_count_not(x, x + 1, y0, y1, col) > 0 {
            if found == x1 {
                found = x;
            }
        }
        x = x + 1;
    }
    return found;
}

; rightmost column in [x0, x1) rows [y0, y1) of VCT_RGB where at least one pixel is not col; x1 when none
fn vct_last_ink_col(x0: u32, x1: u32, y0: u32, y1: u32, col: u32) -> u32 {
    var x : u32 = x0;
    var found : u32 = x1;
    while x < x1 {
        if vct_count_not(x, x + 1, y0, y1, col) > 0 {
            found = x;
        }
        x = x + 1;
    }
    return found;
}

; ---- tests ----

test vct_style_carries_the_resolved_tokens {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    assert st.inset == 16;
    assert st.max_w == 560;
    assert st.head_px == 26;
    assert st.body_px == 16;
    assert st.border == 1;
    // the style follows the metrics, not constants: change one and the style changes
    m.head_px = 28;
    m.border = 2;
    var st2 : VcStyle = vct_style(m);
    assert st2.head_px == 28;
    assert st2.border == 2;
    assert st2.inset == st.inset;
    // a refusal gives an all-zero style
    var r : VcStyle = vct_style(vct_refused(VTK_UNKNOWN));
    assert r.inset == 0;
    assert r.max_w == 0;
    assert r.head_px == 0;
    assert r.body_px == 0;
    assert r.border == 0;
    assert r.pad_x == 0;
}

test vct_a_refused_style_is_refused_by_the_renderer {
    var g : VfGraph = vct_card_graph(375);
    var l : VfLayout = vf_layout(g);
    var st : VcStyle = vct_style(vct_refused(VTK_UNKNOWN));
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, st) == VC_BAD_METRICS;
    var good : VcStyle = vct_style(vct_metrics());
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, good) == VC_OK;
}

; the token card is drawn by the renderer from the token style: the edge, the Save fill, the Cancel and input outlines sit where the layout put
; them, and the resolved heading size and outline width change the picture (breaking inputs: head_px 20 and 33 against 26, border 2 against 1)
test vct_token_card_renders_from_the_token_style {
    var g : VfGraph = vct_card_graph(375);
    var l : VfLayout = vf_layout(g);
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var edge : u32 = th_color(TH_T27, TH_CARD_BORDER);
    var card : u32 = th_kind_color(TH_T27, VF_CARD as u32);
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, st) == VC_OK;
    assert vct_px(0, 0) == edge;
    assert vct_px(1, 96) == card;
    assert vct_px(18, 176) == th_color(TH_T27, TH_ACCENT);
    assert vct_px(122, 174) == edge;
    assert vct_px(16, 118) == edge;
    assert vct_px(18, 120) == th_kind_color(TH_T27, VF_INPUT as u32);
    var title26 : u32 = vct_count_not(1, 374, 1, 50, card);
    assert title26 > 0;
    m.head_px = 20;
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, vct_style(m)) == VC_OK;
    assert vct_count_not(1, 374, 1, 50, card) < title26;
    m.head_px = 33;
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, vct_style(m)) == VC_OK;
    assert vct_count_not(1, 374, 1, 50, card) > title26;
    m.head_px = 26;
    m.border = 2;
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, vct_style(m)) == VC_OK;
    assert vct_px(1, 96) == edge;
}

test vct_metrics_equal_the_manifest {
    var m : VctMetrics = vct_metrics();
    assert m.status == 0;
    assert m.padding == 16;
    assert m.label_gap == 6;
    assert m.group_gap == 16;
    assert m.action_gap == 10;
    assert m.head_px == 26;
    assert m.label_px == 16;
    assert m.body_px == 16;
    assert m.max_inline == 560;
    assert m.min_target == 24;
    assert m.border == 1;
    assert m.control_inset == 6;
    assert m.control_inset == VTK_MANIFEST[vtk_find("space.control.inset")];
    // the same numbers, read from the manifest by token id
    assert m.padding == VTK_MANIFEST[vtk_find("space.card.padding")];
    assert m.label_gap == VTK_MANIFEST[vtk_find("space.field.label_gap")];
    assert m.group_gap == VTK_MANIFEST[vtk_find("space.field.group_gap")];
    assert m.action_gap == VTK_MANIFEST[vtk_find("space.action.gap")];
    assert m.head_px == VTK_MANIFEST[vtk_find("type.heading")];
    assert m.label_px == VTK_MANIFEST[vtk_find("type.label")];
    assert m.body_px == VTK_MANIFEST[vtk_find("type.body")];
    assert m.max_inline == VTK_MANIFEST[vtk_find("layout.card.max_inline")];
    assert m.min_target == VTK_MANIFEST[vtk_find("control.min_target")];
    assert m.border == VTK_MANIFEST[vtk_find("border.width")];
    // negative controls: the old card's hard-coded 8 is no token value, and an unknown name is a refusal with no value, not a default
    assert m.label_gap != 8;
    assert m.action_gap != 8;
    assert m.group_gap != 8;
    var miss : VtkResolved = vct_get("space.card.nope");
    assert miss.status == VTK_UNKNOWN;
    assert miss.status != VTK_OK;
    assert miss.value == 0;
}

test vct_a_refused_metrics_gives_a_blank_graph {
    var m : VctMetrics = vct_metrics();
    var good : VfGraph = vct_graph_with(m, 375);
    assert good.node_count == 9;
    m.status = VTK_UNKNOWN;
    var blank : VfGraph = vct_graph_with(m, 375);
    assert blank.node_count == 0;
    // negative control: a refusal in one token of the table is a refusal of the whole set, with every number 0
    var r : VctMetrics = vct_refused(VTK_UNKNOWN);
    assert r.status == VTK_UNKNOWN;
    assert r.padding == 0;
    assert r.max_inline == 0;
    assert r.status != vct_metrics().status;
}

test vct_graph_has_the_card_structure {
    var g : VfGraph = vct_card_graph(768);
    assert g.node_count == 9;
    assert vf_validate(g) == VF_OK;
    assert g.viewport_w == 768;
    assert g.kind[0] == VF_CARD;
    assert g.kind[1] == VF_TEXT;
    assert g.kind[2] == VF_BADGE;
    assert g.kind[3] == VF_STACK;
    assert g.kind[4] == VF_TEXT;
    assert g.kind[5] == VF_INPUT;
    assert g.kind[6] == VF_STACK;
    assert g.kind[7] == VF_BUTTON;
    assert g.kind[8] == VF_BUTTON;
    assert g.parent[1] == 0;
    assert g.parent[2] == 0;
    assert g.parent[3] == 0;
    assert g.parent[4] == 3;
    assert g.parent[5] == 3;
    assert g.parent[6] == 0;
    assert g.parent[7] == 6;
    assert g.parent[8] == 6;
    assert g.label_ref[5] == 4;
    assert g.variant[7] == PRIMARY;
    assert g.variant[8] == SECONDARY;
    assert g.variant[2] == SUCCESS;
    assert g.direction[0] == DIR_COLUMN;
    assert g.direction[3] == DIR_COLUMN;
    assert g.direction[6] == DIR_ROW;
    let t1 : str = g.text[1];
    let t2 : str = g.text[2];
    let t4 : str = g.text[4];
    let t7 : str = g.text[7];
    let t8 : str = g.text[8];
    assert t1 == "Write the spec";
    assert t2 == "Open";
    assert t4 == "Owner";
    assert t7 == "Save";
    assert t8 == "Cancel";
    // the numbers come from the tokens
    var m : VctMetrics = vct_metrics();
    assert g.padding[0] == m.padding;
    assert g.gap[0] == m.group_gap;
    assert g.gap[3] == m.label_gap;
    assert g.gap[6] == m.action_gap;
    // negative controls: it is not the 8-node card of the story, and its padding and gaps are not the story's 8
    assert g.node_count != 8;
    assert g.padding[0] != 8;
    assert g.gap[6] != 8;
}

test vct_layout_follows_the_tokens {
    var m : VctMetrics = vct_metrics();
    var l : VfLayout = vf_layout(vct_card_graph(375));
    assert l.node_count == 9;
    // title top == padding, and every child sits padding in from the card's left edge
    assert l.y[1] == m.padding;
    assert l.y[1] == 16;
    assert l.x[1] == m.padding;
    // label to input: label_gap (6), inside the field stack
    assert l.y[4] + l.h[4] + m.label_gap == l.y[5];
    assert l.y[4] + l.h[4] + 6 == l.y[5];
    assert l.y[4] == l.y[3];
    assert l.x[4] == l.x[3];
    assert l.x[5] == l.x[3];
    // Save to Cancel: action gap (10), inside the actions stack
    assert l.x[7] + l.w[7] + m.action_gap == l.x[8];
    assert l.x[7] + l.w[7] + 10 == l.x[8];
    assert l.y[7] == l.y[8];
    // title, badge, field, actions: group_gap (16) between each pair
    assert l.y[1] + l.h[1] + m.group_gap == l.y[2];
    assert l.y[2] + l.h[2] + m.group_gap == l.y[3];
    assert l.y[3] + l.h[3] + m.group_gap == l.y[6];
    assert l.y[1] + l.h[1] + 16 == l.y[2];
    assert l.y[2] + l.h[2] + 16 == l.y[3];
    assert l.y[3] + l.h[3] + 16 == l.y[6];
    // the stacks are the sums of their children and gaps
    assert l.h[3] == l.h[4] + m.label_gap + l.h[5];
    assert l.w[6] == l.w[7] + m.action_gap + l.w[8];
    // the card is the sum of its padding, children and gaps
    assert l.h[0] == m.padding + l.h[1] + m.group_gap + l.h[2] + m.group_gap + l.h[3] + m.group_gap + l.h[6] + m.padding;
    assert l.h[0] == 230;
    // the expected rects of the header
    assert l.x[2] == 16;
    assert l.y[2] == 52;
    assert l.y[3] == 92;
    assert l.w[3] == 160;
    assert l.h[3] == 66;
    assert l.y[5] == 118;
    assert l.y[6] == 174;
    assert l.w[6] == 202;
    assert l.x[8] == 122;
    // negative controls: the story's gap 8 would give other numbers
    assert l.y[4] + l.h[4] + 8 != l.y[5];
    assert l.x[7] + l.w[7] + 8 != l.x[8];
    assert l.y[1] != 8;
    assert l.h[0] != 192;
}

test vct_rects_are_identical_at_375_768_and_1280 {
    var l3 : VfLayout = vf_layout(vct_card_graph(375));
    var l7 : VfLayout = vf_layout(vct_card_graph(768));
    var l12 : VfLayout = vf_layout(vct_card_graph(1280));
    assert l3.w[0] == 375;
    assert l7.w[0] == 768;
    assert l12.w[0] == 1280;
    assert vct_same_rects(l3, l7, 9) == true;
    assert vct_same_rects(l3, l12, 9) == true;
    assert vct_same_rects(l7, l12, 9) == true;
    assert l3.h[0] == 230;
    assert l7.h[0] == 230;
    assert l12.h[0] == 230;
    // negative controls: the card width does differ, and the comparison does see a moved rectangle
    assert l3.w[0] != l7.w[0];
    assert l7.w[0] != l12.w[0];
    l7.x[5] = l7.x[5] + 1;
    assert vct_same_rects(l3, l7, 9) == false;
}

test vct_every_child_sits_at_least_padding_inside_the_card {
    var m : VctMetrics = vct_metrics();
    var l3 : VfLayout = vf_layout(vct_card_graph(375));
    var l7 : VfLayout = vf_layout(vct_card_graph(768));
    var l12 : VfLayout = vf_layout(vct_card_graph(1280));
    var i : u32 = 1;
    while i < 9 {
        assert l3.x[i] >= m.padding;
        assert l7.x[i] >= m.padding;
        assert l12.x[i] >= m.padding;
        assert l3.y[i] >= m.padding;
        i = i + 1;
    }
    // negative control: the story's card (padding 8) puts its children nearer than 16 to the left edge, and the card itself starts at 0
    var old : VfLayout = vf_layout(vf_px_card(375));
    assert old.x[1] < m.padding;
    assert l3.x[0] == 0;
    assert l3.x[0] < m.padding;
}

test vct_narrow_widths_keep_the_card_padding {
    var m : VctMetrics = vct_metrics();
    var l3 : VfLayout = vf_layout(vct_card_graph(320));
    var l2 : VfLayout = vf_layout(vct_card_graph(280));
    assert l3.w[0] == 320;
    assert l2.w[0] == 280;
    // the numbers do not depend on the width: the input spans 16..176 and the actions row 16..218
    assert l3.x[5] + l3.w[5] == 176;
    assert l2.x[5] + l2.w[5] == 176;
    assert l3.x[6] + l3.w[6] == 218;
    assert l2.x[6] + l2.w[6] == 218;
    // input right edge plus padding fits at 320 (192 of 320) and at 280 (192 of 280); so does the wider actions row (234 of 320 and of 280)
    assert l3.x[5] + l3.w[5] + m.padding <= l3.w[0];
    assert l2.x[5] + l2.w[5] + m.padding <= l2.w[0];
    assert l3.x[6] + l3.w[6] + m.padding <= l3.w[0];
    assert l2.x[6] + l2.w[6] + m.padding <= l2.w[0];
    // the layout holds a column child to the inner extent (width - 2 * padding), so the right padding is kept below 234 px as well
    var l233 : VfLayout = vf_layout(vct_card_graph(233));
    var l234 : VfLayout = vf_layout(vct_card_graph(234));
    assert l233.w[6] == 201;
    assert l233.x[6] + l233.w[6] + m.padding == 233;
    assert l234.w[6] == 202;
    assert l234.x[6] + l234.w[6] + m.padding == 234;
    // the buttons give way: at 201 px the row is held to 169 and the two buttons are narrower together than the 192 they take at 234
    var l201 : VfLayout = vf_layout(vct_card_graph(201));
    assert l201.w[6] == 169;
    assert l201.w[7] + l201.w[8] < 192;
    assert l201.x[8] + l201.w[8] + m.padding <= l201.w[0];
    // the input alone is held below 192 px
    var l191 : VfLayout = vf_layout(vct_card_graph(191));
    var l192 : VfLayout = vf_layout(vct_card_graph(192));
    assert l191.w[5] == 159;
    assert l191.x[5] + l191.w[5] + m.padding == 191;
    assert l192.w[5] == 160;
    assert l192.x[5] + l192.w[5] + m.padding == 192;
    // negative control: at 234 and above nothing narrows (the Cancel button is 96 wide at 234 and at 320)
    assert l234.w[8] == 96;
    assert l3.w[8] == 96;
}

test vct_a_long_label_is_wider_than_its_node {
    var m : VctMetrics = vct_metrics();
    var g : VfGraph = vct_card_graph(375);
    var short_l : VfLayout = vf_layout(g);
    g.text[4] = "Responsible owner of this task";
    var long_l : VfLayout = vf_layout(g);
    // the plain vf_layout measures no text (vf_card_fit does): the label node is 80 x 20 for either text and nothing moves
    assert short_l.w[4] == 80;
    assert long_l.w[4] == 80;
    assert long_l.h[4] == short_l.h[4];
    assert long_l.y[5] == short_l.y[5];
    assert long_l.h[0] == short_l.h[0];
    // plain-layout fact: vf_type measures the long label wider than its node, and wider than the input under it
    let long_s : str = "Responsible owner of this task";
    let short_s : str = "Owner";
    var long_q8 : u32 = vt_text_width_q8(long_s, m.label_px, VT_REGULAR);
    var short_q8 : u32 = vt_text_width_q8(short_s, m.label_px, VT_REGULAR);
    assert long_q8 > long_l.w[4] * 256;
    assert long_q8 > long_l.w[5] * 256;
    // negative control: the short label fits its node at the same size, so the overflow is the length, not the size
    assert short_q8 <= short_l.w[4] * 256;
    assert short_q8 < long_q8;
    // the title at head_px is wider than its 80 px node as well
    let title_s : str = "Write the spec";
    var title_q8 : u32 = vt_text_width_q8(title_s, m.head_px, VT_BOLD);
    assert title_q8 > short_l.w[1] * 256;
}

test vct_controls_meet_the_min_target {
    var m : VctMetrics = vct_metrics();
    var l : VfLayout = vf_layout(vct_card_graph(375));
    assert m.min_target == 24;
    assert l.h[5] >= m.min_target;
    assert l.h[7] >= m.min_target;
    assert l.h[8] >= m.min_target;
    assert l.h[5] == 40;
    // negative controls: a text node is not a control and is shorter than the target, and the target is not simply the control height
    assert l.h[1] < m.min_target;
    assert l.h[4] < m.min_target;
    assert l.h[5] != m.min_target;
}

test vct_theme_defaults_equal_the_tokens {
    var m : VctMetrics = vct_metrics();
    // the theme defaults are the token values: a token or a theme constant that moves alone fails here
    assert m.padding == 16;
    assert m.max_inline == 560;
    assert TH_CARD_INSET == m.padding;
    assert TH_CARD_MAX_W == m.max_inline;
    // the whole style record agrees, field by field, so the default render path and the token path draw the same numbers
    var ts : VcStyle = vct_style(m);
    var ds : VcStyle = vc_style_theme();
    assert ds.inset == ts.inset;
    assert ds.max_w == ts.max_w;
    assert ds.head_px == ts.head_px;
    assert ds.body_px == ts.body_px;
    assert ds.border == ts.border;
    assert ds.pad_x == ts.pad_x;
    assert TH_CONTROL_INSET == m.control_inset;
    assert m.control_inset == 6;
    // negative controls: a token that moved alone is seen, and the equality is not a constant 16
    var moved : VctMetrics = m;
    moved.padding = 20;
    moved.max_inline = 600;
    moved.control_inset = 8;
    assert TH_CARD_INSET != moved.padding;
    assert TH_CARD_MAX_W != moved.max_inline;
    var ms : VcStyle = vct_style(moved);
    assert ms.inset != ds.inset;
    assert ms.max_w != ds.max_w;
    assert ms.pad_x != ds.pad_x;
}

test vct_theme_font_steps_give_the_token_sizes {
    var m : VctMetrics = vct_metrics();
    assert VC_HEAD_STEP == 5;
    assert VC_BODY_STEP == 3;
    assert th_font_px(VC_HEAD_STEP) == m.head_px;
    assert th_font_px(VC_BODY_STEP) == m.body_px;
    assert m.label_px == m.body_px;
    // negative control: the steps are not interchangeable
    assert th_font_px(VC_BODY_STEP) != m.head_px;
    assert th_font_px(VC_HEAD_STEP) != m.body_px;
}

test vct_words_name_the_origin_of_each_token {
    let w_alias : str = vct_origin_word(VTK_ORG_ALIAS);
    let w_formula : str = vct_origin_word(VTK_ORG_FORMULA);
    let w_explicit : str = vct_origin_word(VTK_ORG_EXPLICIT);
    let w_other : str = vct_origin_word(9);
    assert w_alias == "alias";
    assert w_formula == "formula";
    assert w_explicit == "explicit";
    assert w_other == "unknown";
    // space.card.padding is an alias of space.4, whose value is a spacing formula
    let a1 : str = vct_alias_name("space.card.padding");
    let r1 : str = vct_root_name("space.card.padding");
    let o1 : str = vct_root_origin_word("space.card.padding");
    let d1 : str = vct_root_detail("space.card.padding");
    assert a1 == "space.4";
    assert r1 == "space.4";
    assert o1 == "formula";
    assert d1 == "spacing";
    assert vct_root_h2("space.card.padding") == VTK_H2[3];
    // type.label is an alias of type.size.body, a type formula
    let a2 : str = vct_alias_name("type.label");
    let d2 : str = vct_root_detail("type.label");
    assert a2 == "type.size.body";
    assert d2 == "type";
    // an explicit token has no alias and carries its reason
    let a3 : str = vct_alias_name("layout.card.max_inline");
    let d3 : str = vct_root_detail("layout.card.max_inline");
    let d4 : str = vct_root_detail("control.min_target");
    let d5 : str = vct_root_detail("border.width");
    assert a3 == "none";
    assert d3 == "OWNER_FIXED";
    assert d4 == "WCAG_TARGET";
    assert d5 == "BASE_UNIT";
    assert vct_root_h2("layout.card.max_inline") == 0;
    // negative controls: an unknown name is none/unknown, and the explicit root is not a formula
    let a4 : str = vct_alias_name("space.card.nope");
    let o4 : str = vct_root_origin_word("space.card.nope");
    let o5 : str = vct_root_origin_word("control.min_target");
    assert a4 == "none";
    assert o4 == "unknown";
    assert o5 == "explicit";
    assert vct_root_id("space.card.nope") == VTK_NONE;
    assert VTK_ORIGIN[vct_root_id("control.min_target")] != VTK_ORG_FORMULA;
}

; button padding rule (owner, 2026-11-07): a button label is always centred horizontally in its box so left pad = right pad.
; The renderer applies pen = box_left + (box_width - text_width) / 2 (vc_render_s, VF_BUTTON branch).
; This test pins the symmetry on the token card at 375 px by checking doubled ink centers.
; Save button: layout 16,174 96x40, interior x in [17, 112), y in [175, 213), fill accent, doubled box centre = 128.
; Cancel button: layout 122,174 96x40, interior x in [123, 218), y in [175, 213), fill TH_BORDER, doubled box centre = 340.
; Tolerance 4 (allow 2 pixels for sub-pixel side-bearings). Negative: cleared labels leave no ink in either box.
test vct_button_labels_centred_in_token_card {
    var g : VfGraph = vct_card_graph(375);
    var l : VfLayout = vf_layout(g);
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, st) == VC_OK;
    var accent : u32 = th_color(TH_T27, TH_ACCENT);
    var secondary : u32 = th_color(TH_T27, TH_BORDER);
    // Save button: scan [17, 112) x [175, 213); doubled box centre = 128
    var sl : u32 = vct_first_ink_col(17, 112, 175, 213, accent);
    var sr : u32 = vct_last_ink_col(17, 112, 175, 213, accent);
    assert sl < 112;
    assert sr > sl;
    var sx2 : u32 = sl + sr + 1;
    assert sx2 + 4 >= 128;
    assert sx2 <= 128 + 4;
    // Cancel button: layout 122,174 96x40, 1px outlined, interior fill [123, 217) x [175, 213); doubled box centre = 340
    // x1=217 excludes the right border pixel (TH_CARD_BORDER != TH_BORDER); sentinel when no ink = 217
    var cl : u32 = vct_first_ink_col(123, 217, 175, 213, secondary);
    var cr : u32 = vct_last_ink_col(123, 217, 175, 213, secondary);
    assert cl < 217;
    assert cr > cl;
    var cx2 : u32 = cl + cr + 1;
    assert cx2 + 4 >= 340;
    assert cx2 <= 340 + 4;
    // negative: cleared labels leave no ink in either box
    g.text[7] = "";
    g.text[8] = "";
    assert vc_render_s(g, l, &VCT_RGB, 375, 230, 100, TH_T27, VC_NO_FOCUS, st) == VC_OK;
    assert vct_first_ink_col(17, 112, 175, 213, accent) == 112;
    assert vct_first_ink_col(123, 217, 175, 213, secondary) == 217;
}
