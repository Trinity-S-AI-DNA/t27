// SPDX-License-Identifier: Apache-2.0
; T27F-006: vf_wide renders the task card at the 768 and 1280 viewports and says what the extra width holds
; Refs gHashTag/t27#13214, epic #13214
; The 375 frame of T27F-005 is the base: the same card is laid out at 768 and 1280 and painted by vf_render, no new renderer
; Meaning: the layout does not reflow with the viewport, so the content stays 208 pixels wide and the card only stretches to the right
; vf_content_right, vf_slack_right and vf_fill_permille put that in numbers a person can check against the picture
; Reads VfGraph, VfLayout, vf_pixel, vf_render and vf_meaning, edits none of them
; Limits: one fixed height of 192, no reflow, no antialiasing, no text scaling; it is NOT a human-eye proof of the 768 or 1280 frame
; All arithmetic is u32 and non-negative: compare before subtracting

module t27f_vf_wide;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_px_card;
use t27f::vf_pixel::VF_PALETTE;
use t27f::vf_render::vf_render_rgb;
use t27f::vf_render::vf_render_ppm;
use t27f::vf_render::VF_R_OK;
use t27f::vf_render::VF_R_BORDER;
use t27f::vf_meaning::vf_relation;
use t27f::vf_meaning::vf_gap;
use t27f::vf_meaning::vf_depth;
use t27f::frame_render::ppm_len;

pub const VFW_BASE : u32 = 375;
pub const VFW_MID : u32 = 768;
pub const VFW_WIDE : u32 = 1280;
pub const VFW_H : u32 = 192;

; the widest raster, 1280 x 192 x 3 = 737280 RGB bytes, and its P6 file: 16 header bytes for "P6\n1280 192\n255\n"
pub var VFW_A : [216000]u8 = [0] ** 216000;
pub var VFW_B : [737280]u8 = [0] ** 737280;
pub var VFW_PPM : [737296]u8 = [0] ** 737296;

; the right edge of the content: the largest x + w over every node below the root, 0 for a graph with only a root
pub fn vf_content_right(l: VfLayout) -> u32 {
    var best : u32 = 0;
    var i : u32 = 1;
    while i < l.node_count {
        var r : u32 = l.x[i] + l.w[i];
        if r > best {
            best = r;
        }
        i = i + 1;
    }
    return best;
}

; pixels of the root to the right of the content, 0 when the content reaches or passes the root edge
pub fn vf_slack_right(l: VfLayout) -> u32 {
    if l.node_count == 0 {
        return 0;
    }
    var edge : u32 = vf_content_right(l);
    if edge >= l.w[0] {
        return 0;
    }
    return l.w[0] - edge;
}

; per mille of the root width that holds content, capped at 1000, 0 for an empty root
pub fn vf_fill_permille(l: VfLayout) -> u32 {
    if l.node_count == 0 {
        return 0;
    }
    if l.w[0] == 0 {
        return 0;
    }
    var p : u32 = vf_content_right(l) * 1000 / l.w[0];
    if p > 1000 {
        return 1000;
    }
    return p;
}

; colour 0xRRGGBB of pixel (x, y) in a raster that is w pixels wide
pub fn vf_px_at(rgb: []u8, w: u32, x: u32, y: u32) -> u32 {
    var at : usize = ((y * w + x) * 3) as usize;
    var r : u32 = rgb[at] as u32;
    var g : u32 = rgb[at + 1] as u32;
    var b : u32 = rgb[at + 2] as u32;
    return r * 65536 + g * 256 + b;
}

; how many bytes differ between two rasters in the columns x < x1, rows y < h: a is aw wide, b is bw wide
pub fn vf_cols_diff(a: []u8, aw: u32, b: []u8, bw: u32, h: u32, x1: u32) -> u32 {
    var cnt : u32 = 0;
    var y : u32 = 0;
    while y < h {
        var x : u32 = 0;
        while x < x1 {
            var ia : usize = ((y * aw + x) * 3) as usize;
            var ib : usize = ((y * bw + x) * 3) as usize;
            if a[ia] != b[ib] {
                cnt = cnt + 1;
            }
            if a[ia + 1] != b[ib + 1] {
                cnt = cnt + 1;
            }
            if a[ia + 2] != b[ib + 2] {
                cnt = cnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return cnt;
}

test content_edge_is_208_at_every_width {
    var g1 : VfGraph = vf_px_card(375);
    var g2 : VfGraph = vf_px_card(768);
    var g3 : VfGraph = vf_px_card(1280);
    assert vf_content_right(vf_layout(g1)) == 208;
    assert vf_content_right(vf_layout(g2)) == 208;
    assert vf_content_right(vf_layout(g3)) == 208;
}

test slack_and_fill_by_width {
    var g1 : VfGraph = vf_px_card(375);
    var g2 : VfGraph = vf_px_card(768);
    var g3 : VfGraph = vf_px_card(1280);
    assert vf_slack_right(vf_layout(g1)) == 167;
    assert vf_slack_right(vf_layout(g2)) == 560;
    assert vf_slack_right(vf_layout(g3)) == 1072;
    assert vf_fill_permille(vf_layout(g1)) == 554;
    assert vf_fill_permille(vf_layout(g2)) == 270;
    assert vf_fill_permille(vf_layout(g3)) == 162;
}

test slack_counts_the_buttons_not_just_the_stack {
    var g : VfGraph = vf_px_card(768);
    var l : VfLayout = vf_layout(g);
    assert vf_content_right(l) == 208;
    l.w[7] = 200;
    assert vf_content_right(l) == 312;
    assert vf_slack_right(l) == 456;
}

test slack_is_zero_when_the_content_passes_the_card {
    var g : VfGraph = vf_px_card(375);
    var l : VfLayout = vf_layout(g);
    l.w[0] = 100;
    assert vf_slack_right(l) == 0;
    assert vf_fill_permille(l) == 1000;
    l.w[0] = 0;
    assert vf_fill_permille(l) == 0;
}

test meaning_rows_do_not_change_with_the_width {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    var g3 : VfGraph = vf_px_card(1280);
    var l3 : VfLayout = vf_layout(g3);
    var i : u32 = 0;
    while i < 8 {
        assert vf_relation(g1, l1, i) == vf_relation(g2, l2, i);
        assert vf_relation(g1, l1, i) == vf_relation(g3, l3, i);
        assert vf_gap(g1, l1, i) == vf_gap(g2, l2, i);
        assert vf_gap(g1, l1, i) == vf_gap(g3, l3, i);
        assert vf_depth(g1, i) == vf_depth(g3, i);
        i = i + 1;
    }
}

test frame_768_pixels {
    var g : VfGraph = vf_px_card(768);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VFW_B, 768, 192) == VF_R_OK;
    assert vf_px_at(&VFW_B, 768, 0, 0) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 768, 767, 0) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 768, 0, 191) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 768, 767, 191) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 768, 767, 100) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 768, 700, 100) == VF_PALETTE[VF_CARD as u32];
    assert vf_px_at(&VFW_B, 768, 100, 150) == VF_PALETTE[VF_BUTTON as u32];
    assert vf_px_at(&VFW_B, 768, 100, 120) == VF_PALETTE[VF_INPUT as u32];
    assert vf_px_at(&VFW_B, 768, 52, 56) == VF_PALETTE[VF_BADGE as u32];
    assert vf_px_at(&VFW_B, 768, 106, 150) == VF_PALETTE[VF_STACK as u32];
}

test frame_1280_pixels {
    var g : VfGraph = vf_px_card(1280);
    var l : VfLayout = vf_layout(g);
    assert vf_render_rgb(g, l, &VFW_B, 1280, 192) == VF_R_OK;
    assert vf_px_at(&VFW_B, 1280, 0, 0) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 1280, 1279, 0) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 1280, 0, 191) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 1280, 1279, 191) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 1280, 1279, 100) == VF_R_BORDER;
    assert vf_px_at(&VFW_B, 1280, 1200, 100) == VF_PALETTE[VF_CARD as u32];
    assert vf_px_at(&VFW_B, 1280, 100, 150) == VF_PALETTE[VF_BUTTON as u32];
    assert vf_px_at(&VFW_B, 1280, 100, 120) == VF_PALETTE[VF_INPUT as u32];
    assert vf_px_at(&VFW_B, 1280, 52, 56) == VF_PALETTE[VF_BADGE as u32];
    assert vf_px_at(&VFW_B, 1280, 106, 150) == VF_PALETTE[VF_STACK as u32];
}

test wide_frames_do_not_reflow_the_left_part {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    assert vf_render_rgb(g1, l1, &VFW_A, 375, 192) == VF_R_OK;
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    assert vf_render_rgb(g2, l2, &VFW_B, 768, 192) == VF_R_OK;
    assert vf_cols_diff(&VFW_A, 375, &VFW_B, 768, 192, 374) == 0;
    var g3 : VfGraph = vf_px_card(1280);
    var l3 : VfLayout = vf_layout(g3);
    assert vf_render_rgb(g3, l3, &VFW_B, 1280, 192) == VF_R_OK;
    assert vf_cols_diff(&VFW_A, 375, &VFW_B, 1280, 192, 374) == 0;
}

test the_right_edge_column_is_what_moves {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    assert vf_render_rgb(g1, l1, &VFW_A, 375, 192) == VF_R_OK;
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    assert vf_render_rgb(g2, l2, &VFW_B, 768, 192) == VF_R_OK;
    assert vf_cols_diff(&VFW_A, 375, &VFW_B, 768, 192, 375) == 570;
}

test a_wider_title_breaks_the_comparison {
    var g1 : VfGraph = vf_px_card(375);
    var l1 : VfLayout = vf_layout(g1);
    assert vf_render_rgb(g1, l1, &VFW_A, 375, 192) == VF_R_OK;
    var g2 : VfGraph = vf_px_card(768);
    var l2 : VfLayout = vf_layout(g2);
    l2.w[1] = 400;
    assert vf_render_rgb(g2, l2, &VFW_B, 768, 192) == VF_R_OK;
    assert vf_cols_diff(&VFW_A, 375, &VFW_B, 768, 192, 374) > 0;
}

test ppm_of_the_wide_frames {
    assert ppm_len(768, 192) == 442383;
    assert ppm_len(1280, 192) == 737296;
    var g : VfGraph = vf_px_card(1280);
    var l : VfLayout = vf_layout(g);
    assert vf_render_ppm(g, l, &VFW_B, &VFW_PPM, 1280, 192) == VF_R_OK;
    assert VFW_PPM[0] == 80;
    assert VFW_PPM[1] == 54;
    assert VFW_PPM[2] == 10;
    assert VFW_PPM[3] == 49;
    assert VFW_PPM[4] == 50;
    assert VFW_PPM[5] == 56;
    assert VFW_PPM[6] == 48;
    assert VFW_PPM[7] == 32;
    assert VFW_PPM[8] == 49;
    assert VFW_PPM[9] == 57;
    assert VFW_PPM[10] == 50;
    assert VFW_PPM[11] == 10;
    assert VFW_PPM[12] == 50;
    assert VFW_PPM[13] == 53;
    assert VFW_PPM[14] == 53;
    assert VFW_PPM[15] == 10;
    assert VFW_PPM[16] == 68;
    assert VFW_PPM[737295] == 68;
}
