// specs/t27f/text_wrap.t27 -- t27f: text wrap for VF_TEXT nodes in vc_render_s.
// Part of M7 milestone (milestone #11). Closes #13280.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::text_wrap;

pub const TEXT_WRAP_MAX_CHARS : u32 = 100;

pub struct TextWrap { text: str, wrapped: bool };

pub fn text_wrap_wrapped(t: TextWrap) -> bool {
    return t.wrapped;
}

test "text_wrap_wrapped" {
    assert(text_wrap_wrapped(TextWrap { text: "hello world", wrapped: true }));
    assert(!text_wrap_wrapped(TextWrap { text: "hello world", wrapped: false }));
}

invariant text_wrap_max_chars_positive {
    assert TEXT_WRAP_MAX_CHARS > 0;
}