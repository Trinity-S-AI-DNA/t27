// specs/t27f/ui_kit_rebuild.t27 -- epic: T27OS UI Kit Rebuild V1.
// Part of M7 milestone (milestone #11). Closes #13426.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::ui_kit_rebuild;

pub const UI_KIT_REBUILD_VERSION : u32 = 1;

pub struct RebuildPhase { name: str, complete: bool };

pub fn rebuild_phase_complete(p: RebuildPhase) -> bool {
    return p.complete;
}

test "rebuild_phase_complete" {
    assert(rebuild_phase_complete(RebuildPhase { name: "phase-1", complete: true }));
    assert(!rebuild_phase_complete(RebuildPhase { name: "phase-2", complete: false }));
}

invariant ui_kit_rebuild_version_defined {
    assert UI_KIT_REBUILD_VERSION == 1;
}