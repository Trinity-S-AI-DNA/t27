// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_lex.t27 -- what the scene renderers read out of a lesson's code and text: its
// lines, its bytes, the keywords on each line. Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: reel_topics.t27 gives the code as usize-indexed bytes and reel_factory.t27 finds a keyword
// at a word boundary; the renderers want i32 numbers (scene_raster's coordinates are i32) and the
// same few questions -- how many lines, which line has an `assert`, what is byte i of the lesson --
// asked from twelve places. They are asked here once, in i32, so a renderer never casts a line
// index and never counts a keyword a second way.
//
// KEYWORDS: k is reel_factory's keyword index: 0 test, 1 fn, 2 struct, 3 enum, 4 trit, 5 while,
// 6 for, 7 if, 8 switch, 9 use, 10 invariant, 11 bench, 12 assert, 13 const, 14 var, 15 let,
// 16 pub. A line "has" k when reel_factory.word_at finds k at a word boundary anywhere on it.
//
// NOT CLAIMED: a keyword inside a string or a comment counts (the lesson code has its comments
// dropped; a string with `if` in it would count). The hash is for scattering, not for identity.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_lex;

use t27f::reel_topics::code_line0;
use t27f::reel_topics::code_lines;
use t27f::reel_topics::line_len;
use t27f::reel_topics::code_byte;
use t27f::reel_factory::word_at;

pub const KW_TEST : usize = 0;
pub const KW_FN : usize = 1;
pub const KW_STRUCT : usize = 2;
pub const KW_ENUM : usize = 3;
pub const KW_TRIT : usize = 4;
pub const KW_WHILE : usize = 5;
pub const KW_FOR : usize = 6;
pub const KW_IF : usize = 7;
pub const KW_SWITCH : usize = 8;
pub const KW_USE : usize = 9;
pub const KW_INVARIANT : usize = 10;
pub const KW_BENCH : usize = 11;
pub const KW_ASSERT : usize = 12;
pub const KW_CONST : usize = 13;
pub const KW_VAR : usize = 14;
pub const KW_LET : usize = 15;
pub const KW_PUB : usize = 16;

// How many lines lesson t has, and the absolute index of its row r.
pub fn lex_n(t: usize) -> i32 {
    return @as(i32, @intCast(code_lines(t)));
}
pub fn lex_line(t: usize, r: i32) -> usize {
    return code_line0(t) + @as(usize, @intCast(r));
}
// The length of line l, and its byte at column k (0 past the end).
pub fn lex_llen(l: usize) -> i32 {
    return @as(i32, @intCast(line_len(l)));
}
pub fn lex_ch(l: usize, k: i32) -> i32 {
    if (k < 0 || k >= lex_llen(l)) { return 0; }
    return @as(i32, code_byte(l, @as(usize, @intCast(k))));
}
pub fn lex_letter(c: i32) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}
pub fn lex_digit(c: i32) -> bool {
    return c >= 48 && c <= 57;
}

// Column of the first character on line l that is not a space, or its length.
pub fn lex_first(l: usize) -> i32 {
    var k : i32 = 0;
    while (k < lex_llen(l) && lex_ch(l, k) == 32) { k = k + 1; }
    return k;
}
// Column just past the word (letters, digits, underscore) that starts at column k.
pub fn lex_word_end(l: usize, k: i32) -> i32 {
    var e : i32 = k;
    while (e < lex_llen(l) && (lex_letter(lex_ch(l, e)) || lex_digit(lex_ch(l, e)))) { e = e + 1; }
    return e;
}

// How many times keyword k stands on line l.
pub fn lex_kw_count(l: usize, k: usize) -> i32 {
    var c : i32 = 0;
    var p : usize = 0;
    while (p < line_len(l)) {
        if (word_at(l, p, k)) { c = c + 1; }
        p = p + 1;
    }
    return c;
}
pub fn lex_has(l: usize, k: usize) -> bool {
    return lex_kw_count(l, k) > 0;
}
// How many of lesson t's lines have keyword k.
pub fn lex_lines_with(t: usize, k: usize) -> i32 {
    var c : i32 = 0;
    var r : i32 = 0;
    while (r < lex_n(t)) {
        if (lex_has(lex_line(t, r), k)) { c = c + 1; }
        r = r + 1;
    }
    return c;
}
// How many times keyword k stands in all of lesson t.
pub fn lex_kw_total(t: usize, k: usize) -> i32 {
    var c : i32 = 0;
    var r : i32 = 0;
    while (r < lex_n(t)) {
        c = c + lex_kw_count(lex_line(t, r), k);
        r = r + 1;
    }
    return c;
}

// The bytes of lesson t's code, all lines end to end.
pub fn lex_total(t: usize) -> i32 {
    var s : i32 = 0;
    var r : i32 = 0;
    while (r < lex_n(t)) {
        s = s + lex_llen(lex_line(t, r));
        r = r + 1;
    }
    return s;
}
// Byte i of lesson t's code, i counted from 0 and wrapped past the end; 0 for a lesson without code.
pub fn lex_byte(t: usize, i: i32) -> i32 {
    const total = lex_total(t);
    if (total == 0) { return 0; }
    var j = @mod(i, total);
    var r : i32 = 0;
    while (r < lex_n(t)) {
        const n = lex_llen(lex_line(t, r));
        if (j < n) { return lex_ch(lex_line(t, r), j); }
        j = j - n;
        r = r + 1;
    }
    return 0;
}
// A number from lesson t's code, for scattering: it changes when any byte changes.
pub fn lex_hash(t: usize) -> i32 {
    var h : i32 = 5381;
    var r : i32 = 0;
    while (r < lex_n(t)) {
        const l = lex_line(t, r);
        var k : i32 = 0;
        while (k < lex_llen(l)) {
            h = @mod(h * 33 + lex_ch(l, k), 1000003);
            k = k + 1;
        }
        r = r + 1;
    }
    return h;
}

// ---- tests ----

test "lines, bytes and totals agree with reel_topics" {
    var t : usize = 0;
    while (t < 27) {
        assert(lex_n(t) == @as(i32, @intCast(code_lines(t))));
        var sum : i32 = 0;
        var r : i32 = 0;
        while (r < lex_n(t)) {
            sum = sum + lex_llen(lex_line(t, r));
            r = r + 1;
        }
        assert(lex_total(t) == sum);
        assert(sum > 0);
        t = t + 1;
    }
    assert(lex_ch(lex_line(0, 0), 0 - 1) == 0);
    assert(lex_ch(lex_line(0, 0), 4000) == 0);
}

test "the keyword counts find the construct each lesson teaches" {
    // lesson 9 is "A test block", 13 is "Choices: if, else and switch", 14 is "Loops: while and for",
    // 16 is "Structs", 17 is "Enums", 18 is "Using other modules", 19 is "Invariants and benches"
    assert(lex_lines_with(9, KW_TEST) >= 1);
    assert(lex_kw_total(9, KW_ASSERT) >= 1);
    assert(lex_kw_total(13, KW_IF) + lex_kw_total(13, KW_SWITCH) >= 1);
    assert(lex_kw_total(14, KW_WHILE) + lex_kw_total(14, KW_FOR) >= 1);
    assert(lex_kw_total(16, KW_STRUCT) >= 1);
    assert(lex_kw_total(17, KW_ENUM) >= 1);
    assert(lex_kw_total(18, KW_USE) >= 1);
    assert(lex_kw_total(19, KW_INVARIANT) + lex_kw_total(19, KW_BENCH) >= 1);
    // and a lesson that does not teach it has none: lesson 3 is "Constants"
    assert(lex_kw_total(3, KW_WHILE) == 0);
    assert(lex_kw_total(3, KW_STRUCT) == 0);
}

test "byte i wraps and the hash tells lessons apart" {
    var t : usize = 0;
    while (t < 27) {
        const n = lex_total(t);
        assert(lex_byte(t, 0) == lex_byte(t, n));
        assert(lex_byte(t, 3) == lex_byte(t, 3 + 2 * n));
        assert(lex_byte(t, 0) > 0);
        t = t + 1;
    }
    var distinct : i32 = 0;
    t = 1;
    while (t < 27) {
        if (lex_hash(t) != lex_hash(t - 1)) { distinct = distinct + 1; }
        t = t + 1;
    }
    assert(distinct == 26);
}
