// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene.t27 -- the scene a live page renders, its allowlist, and the delta ops that
// change it. Milestone M2 of T27F Live (epic gHashTag/t27#10266), issue gHashTag/t27#10261.
// Design: docs/nona-02-organism/t27f/genui-research.md, sections 3 and 4.
//
// WHY AN ALLOWLIST. The scene is the one structure a model may write and a renderer will paint. A
// field or primitive the renderer does not know is not an extension point -- it is an injection
// surface. So the vocabulary here is closed: seven primitives, five style tokens, eight fields, and
// validate_scene refuses anything else by returning an error code, never by skipping or truncating.
//
// THE VOCABULARY EXTENDS ui_plan.t27's, it does not fork it: the six FORBIDDEN_NAMES there are
// forbidden here too, for every field and every primitive, and forbidden_in_vocabulary() holds that
// as an invariant the way ui_plan's forbidden_in_catalog holds it for widgets.
//
// SEQUENCED DELTAS. A scene does not get rewritten; it changes by ops carrying a sequence number
// that must strictly increase -- the same rule the live wire in live_stream.t27 runs on. An op with
// a seq the scene has already seen is refused, so a replayed batch cannot rewind state.
//
// NOT CLAIMED: no text-valued fields (a node's text comes from the spec corpus, not the model); no
// transforms or nesting beyond one parent per node; no z-order; the node cap is a refusal, and a
// scene that legitimately needs more nodes is a spec change here, not a silent truncation.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene;

use t27f::ui_plan::FORBIDDEN_NAMES;

pub const ID : str = "scene";
pub const VERSION : u8 = 1;

/// The fixed-point scale, one whole unit. The same Q8 the motion specs use; declared here rather
/// than imported so the scene's vocabulary has no dependency on how motion is integrated.
pub const Q8 : i32 = 256;

// ---- the closed vocabulary ---------------------------------------------------------------------------

/// The primitives a renderer implements. Nothing else can appear in a scene, ever.
pub const PRIM_NAMES : [7]str = ["group", "rect", "text", "path", "image_ref", "clip_ref", "face"];
pub const PRIM_KINDS : u8 = 7;
pub const PRIM_EMPTY : u8 = 255;           // a removed slot, not a primitive
pub const PRIM_GROUP : u8 = 0;
pub const PRIM_RECT : u8 = 1;
pub const PRIM_TEXT : u8 = 2;
pub const PRIM_PATH : u8 = 3;
pub const PRIM_IMAGE_REF : u8 = 4;
pub const PRIM_CLIP_REF : u8 = 5;
pub const PRIM_FACE : u8 = 6;

/// The style tokens a renderer may paint with.
pub const STYLE_NAMES : [5]str = ["fill", "stroke", "opacity", "radius", "font"];
pub const STYLE_KINDS : u8 = 5;

/// Every field a delta op may set. This is the allowlist the issue means by "every field": a name
/// outside it is refused, and the six ui_plan FORBIDDEN_NAMES are outside it by construction.
pub const FIELD_NAMES : [8]str = ["x", "y", "w", "h", "opacity", "radius", "fill", "stroke"];
pub const FIELD_KINDS : u8 = 8;

pub const F_X : u8 = 0;
pub const F_Y : u8 = 1;
pub const F_W : u8 = 2;
pub const F_H : u8 = 3;
pub const F_OPACITY : u8 = 4;
pub const F_RADIUS : u8 = 5;
pub const F_FILL : u8 = 6;
pub const F_STROKE : u8 = 7;

pub fn prim_id(name: str) -> u8 {
    var i : u8 = 0;
    while (i < PRIM_KINDS) {
        if (PRIM_NAMES[i as usize] == name) { return i; }
        i = i + 1;
    }
    return PRIM_EMPTY;
}

pub fn style_id(name: str) -> u8 {
    var i : u8 = 0;
    while (i < STYLE_KINDS) {
        if (STYLE_NAMES[i as usize] == name) { return i; }
        i = i + 1;
    }
    return STYLE_KINDS;                    // not a token
}

pub fn field_id(name: str) -> u8 {
    var i : u8 = 0;
    while (i < FIELD_KINDS) {
        if (FIELD_NAMES[i as usize] == name) { return i; }
        i = i + 1;
    }
    return FIELD_KINDS;                    // not a field
}

/// The vocabulary is closed AND clean: no ui_plan FORBIDDEN_NAMES may resolve to a primitive, a
/// style token or a field. Zero, by invariant -- the test sweeps all three lists.
pub fn forbidden_in_vocabulary() -> u32 {
    var n : u32 = 0;
    var j : u32 = 0;
    while (j < 6) {
        if (prim_id(FORBIDDEN_NAMES[j as usize]) != PRIM_EMPTY) { n = n + 1; }
        if (style_id(FORBIDDEN_NAMES[j as usize]) != STYLE_KINDS) { n = n + 1; }
        if (field_id(FORBIDDEN_NAMES[j as usize]) != FIELD_KINDS) { n = n + 1; }
        j = j + 1;
    }
    return n;
}

// ---- the scene ---------------------------------------------------------------------------------------

pub const MAX_NODES : u32 = 32;            // a HUD, not a canvas: over this is refused, not truncated
pub const NO_PARENT : u8 = 255;
pub const SEQ_FIRST : u32 = 1;

pub const Scene = struct {
    kind : [32]u8,
    parent : [32]u8,
    x : [32]i32,
    y : [32]i32,
    w : [32]i32,
    h : [32]i32,
    opacity : [32]i32,
    radius : [32]i32,
    fill : [32]u8,
    stroke : [32]u8,
    count : u32,
    last_seq : u32,
    kf_seq : u32,
};

pub fn scene_empty() -> Scene {
    var s : Scene = undefined;
    s.count = 0;
    s.last_seq = 0;
    s.kf_seq = 0;
    var i : u32 = 0;
    while (i < MAX_NODES) {
        s.kind[i as usize] = PRIM_EMPTY;
        s.parent[i as usize] = NO_PARENT;
        s.x[i as usize] = 0;
        s.y[i as usize] = 0;
        s.w[i as usize] = 0;
        s.h[i as usize] = 0;
        s.opacity[i as usize] = Q8;
        s.radius[i as usize] = 0;
        s.fill[i as usize] = STYLE_KINDS;
        s.stroke[i as usize] = STYLE_KINDS;
        i = i + 1;
    }
    return s;
}

// ---- the delta ops -----------------------------------------------------------------------------------

pub const OP_ADD : u8 = 0;
pub const OP_SET : u8 = 1;
pub const OP_REMOVE : u8 = 2;
pub const OP_KEYFRAME : u8 = 3;
pub const OP_KINDS : u8 = 4;
pub const OP_NAMES : [4]str = ["add", "set", "remove", "keyframe"];

pub const Op = struct {
    op : u8,
    seq : u32,
    prim : u8,                             // ADD: the primitive; else unused
    parent : u8,                           // ADD: the parent slot, or NO_PARENT
    node : u32,                            // SET / REMOVE: the slot addressed
    field : u8,                            // SET: the field id
    value : i32,                           // SET: the value
};

/// What apply_op can answer. Every refusal is a code the caller can name, never a silent skip.
pub const SCENE_OK : u8 = 0;
pub const E_SEQ : u8 = 1;                  // the op's seq was already seen: a replay, refused
pub const E_FIELD : u8 = 2;                // the field is outside the allowlist: refused
pub const E_PRIM : u8 = 3;                 // the primitive is outside the allowlist: refused
pub const E_NODE : u8 = 4;                 // no such live node, or a dangling parent: refused
pub const E_FULL : u8 = 5;                 // the node cap: refused, never truncated
pub const E_VALUE : u8 = 6;                // the value is out of range for the field: refused
pub const RESULT_NAMES : [7]str = ["ok", "seq", "field", "prim", "node", "full", "value"];

/// Apply one sequenced op. FR-001 lives in the two allowlist checks (E_PRIM, E_FIELD); the seq rule
/// lives in E_SEQ. A refused op changes nothing -- every refusal returns before any write.
pub fn apply_op(s: *Scene, op: Op) -> u8 {
    if (op.seq < SEQ_FIRST) { return E_SEQ; }
    if (op.seq <= s.last_seq) { return E_SEQ; }
    if (op.op == OP_KEYFRAME) {
        const v = validate_scene(s);
        if (v != SCENE_OK) { return v; }
        s.kf_seq = op.seq;
        s.last_seq = op.seq;
        return SCENE_OK;
    }
    if (op.op == OP_ADD) {
        if (s.count >= MAX_NODES) { return E_FULL; }
        if (op.prim >= PRIM_KINDS) { return E_PRIM; }
        if (op.parent != NO_PARENT and (op.parent >= (s.count as u8) or s.kind[op.parent as usize] == PRIM_EMPTY)) {
            return E_NODE;
        }
        const i = s.count;
        s.kind[i as usize] = op.prim;
        s.parent[i as usize] = op.parent;
        s.x[i as usize] = 0;
        s.y[i as usize] = 0;
        s.w[i as usize] = 0;
        s.h[i as usize] = 0;
        s.opacity[i as usize] = Q8;
        s.radius[i as usize] = 0;
        s.fill[i as usize] = STYLE_KINDS;
        s.stroke[i as usize] = STYLE_KINDS;
        s.count = i + 1;
        s.last_seq = op.seq;
        return SCENE_OK;
    }
    if (op.node >= s.count or s.kind[op.node as usize] == PRIM_EMPTY) { return E_NODE; }
    if (op.op == OP_REMOVE) {
        s.kind[op.node as usize] = PRIM_EMPTY;
        s.last_seq = op.seq;
        return SCENE_OK;
    }
    if (op.field >= FIELD_KINDS) { return E_FIELD; }
    if (op.field == F_OPACITY and (op.value < 0 or op.value > Q8)) { return E_VALUE; }
    if ((op.field == F_FILL or op.field == F_STROKE) and op.value >= (STYLE_KINDS as i32)) { return E_VALUE; }
    if (op.field == F_X) { s.x[op.node as usize] = op.value; }
    if (op.field == F_Y) { s.y[op.node as usize] = op.value; }
    if (op.field == F_W) { s.w[op.node as usize] = op.value; }
    if (op.field == F_H) { s.h[op.node as usize] = op.value; }
    if (op.field == F_OPACITY) { s.opacity[op.node as usize] = op.value; }
    if (op.field == F_RADIUS) { s.radius[op.node as usize] = op.value; }
    if (op.field == F_FILL) { s.fill[op.node as usize] = op.value as u8; }
    if (op.field == F_STROKE) { s.stroke[op.node as usize] = op.value as u8; }
    s.last_seq = op.seq;
    return SCENE_OK;
}

/// Walk the live nodes and refuse the first thing the allowlist does not name: an unknown primitive,
/// an opacity outside Q8, a token id outside STYLE_KINDS, or a live node whose parent slot is empty.
pub fn validate_scene(s: *Scene) -> u8 {
    var i : u32 = 0;
    while (i < s.count) {
        const k = s.kind[i as usize];
        if (k == PRIM_EMPTY) {
            i = i + 1;
            continue;
        }
        if (k >= PRIM_KINDS) { return E_PRIM; }
        if (s.opacity[i as usize] < 0 or s.opacity[i as usize] > Q8) { return E_VALUE; }
        // geometry is viewport geometry: non-negative, because the display-list encoding carries
        // unsigned payload bytes and a negative position is out-of-scene, not a legal value
        if (s.x[i as usize] < 0 or s.y[i as usize] < 0 or s.w[i as usize] < 0 or s.h[i as usize] < 0) { return E_VALUE; }
        if (s.fill[i as usize] > STYLE_KINDS or s.stroke[i as usize] > STYLE_KINDS) { return E_VALUE; }
        const p = s.parent[i as usize];
        if (p != NO_PARENT and (p >= (i as u8) or s.kind[p as usize] == PRIM_EMPTY)) { return E_NODE; }
        i = i + 1;
    }
    return SCENE_OK;
}

/// Live nodes: the slots a renderer would walk.
pub fn live_count(s: *Scene) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < s.count) {
        if (s.kind[i as usize] != PRIM_EMPTY) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// ---- tests -------------------------------------------------------------------------------------------

test the_vocabulary_is_closed_and_clean {
    assert(PRIM_KINDS == 7);
    assert(PRIM_NAMES.len == 7);
    assert(STYLE_NAMES.len == 5);
    assert(FIELD_NAMES.len == 8);
    assert(OP_NAMES.len == 4);
    // every name resolves to itself, and nothing else resolves at all
    assert(prim_id("group") == 0 and prim_id("rect") == 1 and prim_id("text") == 2);
    assert(prim_id("path") == 3 and prim_id("image_ref") == 4);
    assert(prim_id("clip_ref") == 5 and prim_id("face") == 6);
    assert(prim_id("canvas") == PRIM_EMPTY);
    assert(prim_id("") == PRIM_EMPTY);
    assert(field_id("x") == F_X and field_id("opacity") == F_OPACITY);
    assert(field_id("transform") == FIELD_KINDS);
    assert(style_id("fill") == 0 and style_id("font") == 4);
    assert(style_id("shadow") == STYLE_KINDS);
    // the six ui_plan forbidden names resolve to nothing here
    assert(forbidden_in_vocabulary() == 0);
}

test a_field_outside_the_allowlist_is_refused {                         // FR-001
    var s = scene_empty();
    const add = Op{ .op = OP_ADD, .seq = 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, add) == SCENE_OK);
    const set = Op{ .op = OP_SET, .seq = 2, .prim = 0, .parent = 0, .node = 0, .field = F_X, .value = 12 };
    assert(apply_op(&s, set) == SCENE_OK);
    assert(s.x[0] == 12);
    // one past the last field id is outside the allowlist, and so is anything further
    var bad : u8 = FIELD_KINDS;
    while (bad < 250) {
        const e = Op{ .op = OP_SET, .seq = bad as u32 + 10, .prim = 0, .parent = 0, .node = 0, .field = bad, .value = 1 };
        assert(apply_op(&s, e) == E_FIELD);
        bad = bad + 1;
    }
    // the refusal changed nothing
    assert(s.x[0] == 12);
    assert(s.last_seq == 2);
}

test delta_ops_apply_strictly_in_sequence {
    var s = scene_empty();
    const add = Op{ .op = OP_ADD, .seq = 1, .prim = 0, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    const child = Op{ .op = OP_ADD, .seq = 2, .prim = 1, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, add) == SCENE_OK);
    assert(apply_op(&s, child) == SCENE_OK);
    assert(s.count == 2 and live_count(&s) == 2);
    assert(s.parent[1] == 0);
    // a replayed seq is refused and changes nothing
    const replay = Op{ .op = OP_SET, .seq = 2, .prim = 0, .parent = 0, .node = 0, .field = F_X, .value = 99 };
    assert(apply_op(&s, replay) == E_SEQ);
    assert(s.x[0] == 0);
    // a seq before the first is refused
    const zero = Op{ .op = OP_SET, .seq = 0, .prim = 0, .parent = 0, .node = 0, .field = F_X, .value = 5 };
    assert(apply_op(&s, zero) == E_SEQ);
    // in order it applies
    const good = Op{ .op = OP_SET, .seq = 3, .prim = 0, .parent = 0, .node = 1, .field = F_Y, .value = 7 };
    assert(apply_op(&s, good) == SCENE_OK);
    assert(s.y[1] == 7);
    assert(s.last_seq == 3);
}

test validate_scene_refuses_what_the_allowlist_does_not_name {          // FR-001
    var s = scene_empty();
    const add = Op{ .op = OP_ADD, .seq = 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    const child = Op{ .op = OP_ADD, .seq = 2, .prim = 1, .parent = 0, .node = 0, .field = 0, .value = 0 };
    const opa = Op{ .op = OP_SET, .seq = 3, .prim = 0, .parent = 0, .node = 0, .field = F_OPACITY, .value = 128 };
    assert(apply_op(&s, add) == SCENE_OK);
    assert(apply_op(&s, child) == SCENE_OK);
    assert(apply_op(&s, opa) == SCENE_OK);
    assert(validate_scene(&s) == SCENE_OK);
    // an unknown primitive is refused
    s.kind[0] = PRIM_KINDS;
    assert(validate_scene(&s) == E_PRIM);
    s.kind[0] = 1;
    // an opacity outside Q8 is refused
    s.opacity[0] = Q8 + 1;
    assert(validate_scene(&s) == E_VALUE);
    s.opacity[0] = 0 - 1;
    assert(validate_scene(&s) == E_VALUE);
    s.opacity[0] = 128;
    // a style token id outside the token list is refused
    s.fill[0] = STYLE_KINDS + 1;
    assert(validate_scene(&s) == E_VALUE);
    s.fill[0] = 0;
    // negative geometry is refused: viewport geometry is non-negative, and the display-list
    // encoding carries unsigned payload bytes
    s.x[1] = 0 - 1;
    assert(validate_scene(&s) == E_VALUE);
    s.x[1] = 0;
    assert(validate_scene(&s) == SCENE_OK);
    // a live node over an empty parent slot is refused: no dangling children
    const rm = Op{ .op = OP_REMOVE, .seq = 4, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, rm) == SCENE_OK);
    assert(validate_scene(&s) == E_NODE);
    const rm2 = Op{ .op = OP_REMOVE, .seq = 5, .prim = 0, .parent = 0, .node = 1, .field = 0, .value = 0 };
    assert(apply_op(&s, rm2) == SCENE_OK);
    assert(validate_scene(&s) == SCENE_OK);
    assert(live_count(&s) == 0);
}

test a_scene_over_the_node_cap_is_refused_never_truncated {             // the budget rule
    var s = scene_empty();
    var i : u32 = 0;
    while (i < MAX_NODES) {
        const a = Op{ .op = OP_ADD, .seq = i + 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
        assert(apply_op(&s, a) == SCENE_OK);
        i = i + 1;
    }
    assert(s.count == MAX_NODES);
    const one_more = Op{ .op = OP_ADD, .seq = MAX_NODES + 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, one_more) == E_FULL);
    assert(s.count == MAX_NODES);          // refused, not truncated to fit
    assert(validate_scene(&s) == SCENE_OK);
}

test a_removed_slot_is_a_ghost_and_a_fresh_add_is_not {
    var s = scene_empty();
    const a0 = Op{ .op = OP_ADD, .seq = 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, a0) == SCENE_OK);
    const rm = Op{ .op = OP_REMOVE, .seq = 3, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, rm) == SCENE_OK);
    // the ghost slot is dead: set and remove on it are refused
    const set_ghost = Op{ .op = OP_SET, .seq = 4, .prim = 0, .parent = 0, .node = 0, .field = F_X, .value = 1 };
    assert(apply_op(&s, set_ghost) == E_NODE);
    const rm_ghost = Op{ .op = OP_REMOVE, .seq = 5, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, rm_ghost) == E_NODE);
    // a fresh add goes to a new slot, not into the ghost -- and it must carry a seq the scene has
    // not seen: the ghost ops above already advanced last_seq to 5
    const a1 = Op{ .op = OP_ADD, .seq = 6, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, a1) == SCENE_OK);
    assert(s.count == 2);
    assert(s.kind[0] == PRIM_EMPTY);
    assert(s.kind[1] == 1);
    assert(validate_scene(&s) == SCENE_OK);
}

test a_keyframe_is_a_validated_boundary {
    var s = scene_empty();
    const add = Op{ .op = OP_ADD, .seq = 1, .prim = 2, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, add) == SCENE_OK);
    const kf = Op{ .op = OP_KEYFRAME, .seq = 2, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, kf) == SCENE_OK);
    assert(s.kf_seq == 2);
    // a keyframe over a broken scene refuses with the validate error and records nothing
    s.opacity[0] = Q8 + 5;
    const kf2 = Op{ .op = OP_KEYFRAME, .seq = 3, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, kf2) == E_VALUE);
    assert(s.kf_seq == 2);
    // and a keyframe is sequenced like any op
    const kf3 = Op{ .op = OP_KEYFRAME, .seq = 2, .prim = 0, .parent = 0, .node = 0, .field = 0, .value = 0 };
    s.opacity[0] = Q8;
    assert(apply_op(&s, kf3) == E_SEQ);
}

test style_tokens_do_real_work_in_ops {
    var s = scene_empty();
    const add = Op{ .op = OP_ADD, .seq = 1, .prim = 1, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    assert(apply_op(&s, add) == SCENE_OK);
    const fill = Op{ .op = OP_SET, .seq = 2, .prim = 0, .parent = 0, .node = 0, .field = F_FILL, .value = 2 };
    assert(apply_op(&s, fill) == SCENE_OK);
    assert(s.fill[0] == 2);
    // a token id outside STYLE_KINDS is refused
    const bad_fill = Op{ .op = OP_SET, .seq = 3, .prim = 0, .parent = 0, .node = 0, .field = F_FILL, .value = STYLE_KINDS };
    assert(apply_op(&s, bad_fill) == E_VALUE);
    const bad_stroke = Op{ .op = OP_SET, .seq = 4, .prim = 0, .parent = 0, .node = 0, .field = F_STROKE, .value = 99 };
    assert(apply_op(&s, bad_stroke) == E_VALUE);
    assert(s.stroke[0] == STYLE_KINDS);    // unset means "no token", itself a legal value
    // opacity is Q8-ranged
    const opa = Op{ .op = OP_SET, .seq = 5, .prim = 0, .parent = 0, .node = 0, .field = F_OPACITY, .value = Q8 };
    assert(apply_op(&s, opa) == SCENE_OK);
    const opa_bad = Op{ .op = OP_SET, .seq = 6, .prim = 0, .parent = 0, .node = 0, .field = F_OPACITY, .value = Q8 + 1 };
    assert(apply_op(&s, opa_bad) == E_VALUE);
}

invariant the_vocabulary_extends_ui_plan_never_forks_it {
    assert(FORBIDDEN_NAMES.len == 6);
    assert(forbidden_in_vocabulary() == 0);
    assert(PRIM_KINDS == PRIM_NAMES.len);
    assert(STYLE_KINDS == STYLE_NAMES.len);
    assert(FIELD_KINDS == FIELD_NAMES.len);
    assert(OP_KINDS == OP_NAMES.len);
    assert(RESULT_NAMES.len == 7);
    assert(MAX_NODES > 0);
    assert(SEQ_FIRST == 1);
}
