// SPDX-License-Identifier: Apache-2.0
; T27F-007 text measurement for the task card: the seam between vf_type (which measures) and vf_layout (which places) (Refs gHashTag/t27#13214)
; vf_layout measures no text and stays font-agnostic: a text node is 80 x 20 whatever it says. It does take measured leaf widths through
;   vf_layout_m. This module is the caller that measures: for every VF_TEXT node with a non-empty text it asks vf_type for the advance width at
;   the size and weight the painter will use, adds the text pen offset (st.pad_x), and hands the result to vf_layout_m. It edits no spec
; The painter's choice, mirrored here and held by a test: the heading (vc_is_heading) is st.head_px and bold, every other text node is st.body_px and
;   regular. At 100 percent the painter size is the design size, so a width measured here is a width in design pixels (rounded up)
; The extent of a text node is st.pad_x + the rounded-up advance width: from the node's left edge to the end of the last glyph's advance. The node
;   is not clipped by the painter, so an extent larger than the allocated width is an overflow that is reported, not hidden
; What it does not measure: text height (there is no line-height token, the 20 px node height stays), buttons, badges and inputs (their boxes keep
;   the intrinsic sizes), wrapping and ellipsis (a text that does not fit is reported by vcf_overflow_count, it is not broken into lines)
; vcf_layout(g, st): the layout with measured text widths. vcf_overflow_count(g, l, st): text nodes whose extent is wider than their rectangle
; All arithmetic is u32 and non-negative: compare before subtracting. ASCII only (L3)

module T27fVfCardFit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_layout::vf_layout_m;
use t27f::vf_card::VcStyle;
use t27f::vf_card::vc_is_heading;
use t27f::vf_type::vt_text_width_q8;
use t27f::vf_type::VT_REGULAR;
use t27f::vf_type::VT_BOLD;
use t27f::vf_type::VT_MIN_PX;
use t27f::vf_type::VT_MAX_PX;
use t27f::vf_card_tok::VctMetrics;
use t27f::vf_card_tok::vct_metrics;
use t27f::vf_card_tok::vct_card_graph;
use t27f::vf_card_tok::vct_graph_with;
use t27f::vf_card_tok::vct_style;

; the design-pixel type size of node i as the painter picks it at 100 percent: heading size for the heading, body size for the rest, clamped
pub fn vcf_text_px(g: VfGraph, i: u32, st: VcStyle) -> u32 {
    var dpx : u32 = st.body_px;
    if vc_is_heading(g, i) {
        dpx = st.head_px;
    }
    if dpx < VT_MIN_PX {
        dpx = VT_MIN_PX;
    }
    if dpx > VT_MAX_PX {
        dpx = VT_MAX_PX;
    }
    return dpx;
}

; the weight of node i as the painter picks it: bold for the heading, regular for the rest
pub fn vcf_text_weight(g: VfGraph, i: u32) -> u32 {
    if vc_is_heading(g, i) {
        return VT_BOLD;
    }
    return VT_REGULAR;
}

; advance width of the text of node i in design pixels, rounded up; 0 for a node that is not VF_TEXT or whose text is empty
pub fn vcf_text_w(g: VfGraph, i: u32, st: VcStyle) -> u32 {
    if g.kind[i] != VF_TEXT {
        return 0;
    }
    let s : str = g.text[i];
    if s == "" {
        return 0;
    }
    var q8 : u32 = vt_text_width_q8(s, vcf_text_px(g, i, st), vcf_text_weight(g, i));
    return (q8 + 255) / 256;
}

; extent of node i: the pen offset plus the advance width; 0 when there is no text to measure
pub fn vcf_extent(g: VfGraph, i: u32, st: VcStyle) -> u32 {
    var w : u32 = vcf_text_w(g, i, st);
    if w == 0 {
        return 0;
    }
    return st.pad_x + w;
}

; the width overrides for vf_layout_m: the extent of each text node, 0 (no override) for every other node and for empty text
pub fn vcf_overrides_w(g: VfGraph, st: VcStyle) -> [16]u32 {
    var ow : [16]u32 = [0; 16];
    var i : u32 = 0;
    while i < g.node_count and i < 16 {
        ow[i] = vcf_extent(g, i, st);
        i = i + 1;
    }
    return ow;
}

; the layout of g with the measured text widths; heights stay intrinsic
pub fn vcf_layout(g: VfGraph, st: VcStyle) -> VfLayout {
    var ow : [16]u32 = vcf_overrides_w(g, st);
    var oh : [16]u32 = [0; 16];
    return vf_layout_m(g, ow, oh);
}

; how many text nodes are wider (by extent) than the rectangle the layout gave them
pub fn vcf_overflow_count(g: VfGraph, l: VfLayout, st: VcStyle) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count and i < 16 {
        if vcf_extent(g, i, st) > l.w[i] {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

; how many of the nodes 1..n-1 end less than pad before the right edge of node 0
fn vcf_past_edge(l: VfLayout, n: u32, pad: u32) -> u32 {
    var k : u32 = 0;
    var i : u32 = 1;
    while i < n {
        if l.x[i] + l.w[i] + pad > l.w[0] {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

; true when node i has the same rectangle in a and b
fn vcf_same_rect(a: VfLayout, b: VfLayout, i: u32) -> bool {
    if a.x[i] != b.x[i] {
        return false;
    }
    if a.y[i] != b.y[i] {
        return false;
    }
    if a.w[i] != b.w[i] {
        return false;
    }
    return a.h[i] == b.h[i];
}

test fit_size_and_weight_follow_the_painter {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var g : VfGraph = vct_card_graph(375);
    assert m.head_px == 26;
    assert m.body_px == 16;
    // node 1 is the heading, node 4 is the label caption
    assert vcf_text_px(g, 1, st) == m.head_px;
    assert vcf_text_px(g, 4, st) == m.body_px;
    assert vcf_text_weight(g, 1) == VT_BOLD;
    assert vcf_text_weight(g, 4) == VT_REGULAR;
    // the width is the vf_type advance at that size and weight, rounded up
    let title_s : str = "Write the spec";
    let label_s : str = "Owner";
    var tq : u32 = vt_text_width_q8(title_s, m.head_px, VT_BOLD);
    var lq : u32 = vt_text_width_q8(label_s, m.body_px, VT_REGULAR);
    assert vcf_text_w(g, 1, st) == (tq + 255) / 256;
    assert vcf_text_w(g, 4, st) == (lq + 255) / 256;
    assert vcf_extent(g, 1, st) == st.pad_x + (tq + 255) / 256;
    assert vcf_extent(g, 4, st) == st.pad_x + (lq + 255) / 256;
    // negative controls: the title is not measured as body text, and a node that is not text has no width
    var wrong : u32 = vt_text_width_q8(title_s, m.body_px, VT_REGULAR);
    assert wrong != tq;
    assert vcf_text_w(g, 2, st) == 0;
    assert vcf_text_w(g, 7, st) == 0;
    assert vcf_extent(g, 0, st) == 0;
}

test fit_overrides_cover_only_text_with_text {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var g : VfGraph = vct_card_graph(375);
    var ow : [16]u32 = vcf_overrides_w(g, st);
    assert ow[1] > 0;
    assert ow[4] > 0;
    assert ow[0] == 0;
    assert ow[2] == 0;
    assert ow[3] == 0;
    assert ow[5] == 0;
    assert ow[6] == 0;
    assert ow[7] == 0;
    assert ow[8] == 0;
    assert ow[9] == 0;
    // negative controls: empty text gets no override, and a graph with no nodes gets none at all
    g.text[4] = "";
    var ow2 : [16]u32 = vcf_overrides_w(g, st);
    assert ow2[4] == 0;
    assert ow2[1] == ow[1];
    var mb : VctMetrics = vct_metrics();
    mb.status = 1;
    var gb : VfGraph = vct_graph_with(mb, 375);
    assert gb.node_count == 0;
    var ow3 : [16]u32 = vcf_overrides_w(gb, st);
    assert ow3[0] == 0;
    assert ow3[1] == 0;
    assert ow3[4] == 0;
}

test fit_card_at_375_changes_only_the_text_widths {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var g : VfGraph = vct_card_graph(375);
    var plain : VfLayout = vf_layout(g);
    var fit : VfLayout = vcf_layout(g, st);
    // the title is wider than the intrinsic 80, the label narrower, each equal to its measured extent
    assert plain.w[1] == 80;
    assert plain.w[4] == 80;
    assert fit.w[1] == vcf_extent(g, 1, st);
    assert fit.w[4] == vcf_extent(g, 4, st);
    assert fit.w[1] > 80;
    assert fit.w[4] < 80;
    assert fit.w[4] > st.pad_x;
    // positions and heights of the text nodes are unchanged
    assert fit.x[1] == plain.x[1];
    assert fit.y[1] == plain.y[1];
    assert fit.h[1] == plain.h[1];
    assert fit.x[4] == plain.x[4];
    assert fit.y[4] == plain.y[4];
    assert fit.h[4] == plain.h[4];
    // every other rectangle is identical: the field stays 160 wide, the card 230 high
    assert vcf_same_rect(plain, fit, 0) == true;
    assert vcf_same_rect(plain, fit, 2) == true;
    assert vcf_same_rect(plain, fit, 3) == true;
    assert vcf_same_rect(plain, fit, 5) == true;
    assert vcf_same_rect(plain, fit, 6) == true;
    assert vcf_same_rect(plain, fit, 7) == true;
    assert vcf_same_rect(plain, fit, 8) == true;
    assert fit.h[0] == 230;
    // the overflow count sees the old limitation and the fix: the 80 px title node is too narrow, the measured one is not
    assert vcf_overflow_count(g, plain, st) >= 1;
    assert vcf_overflow_count(g, fit, st) == 0;
    // negative control: the comparison does see a moved rectangle
    fit.x[5] = fit.x[5] + 1;
    assert vcf_same_rect(plain, fit, 5) == false;
}

test fit_a_long_label_widens_its_node_and_the_field {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var g : VfGraph = vct_card_graph(375);
    var short_l : VfLayout = vcf_layout(g, st);
    g.text[4] = "Responsible owner of this task";
    var long_l : VfLayout = vcf_layout(g, st);
    assert long_l.w[4] == vcf_extent(g, 4, st);
    assert long_l.w[4] > short_l.w[4];
    // the label is now wider than the input under it, and the field stack follows the widest child
    assert long_l.w[4] > long_l.w[5];
    assert long_l.w[3] == long_l.w[4];
    assert long_l.w[5] == 160;
    // nothing moves vertically and the card still fits at 375: nothing overflows
    assert long_l.y[5] == short_l.y[5];
    assert long_l.x[5] == short_l.x[5];
    assert long_l.h[0] == short_l.h[0];
    assert long_l.x[4] + long_l.w[4] + m.padding <= long_l.w[0];
    assert vcf_overflow_count(g, long_l, st) == 0;
}

test fit_a_narrow_card_keeps_its_padding_and_reports_overflow {
    var m : VctMetrics = vct_metrics();
    var st : VcStyle = vct_style(m);
    var g : VfGraph = vct_card_graph(120);
    var l : VfLayout = vcf_layout(g, st);
    assert l.w[0] == 120;
    // the inner extent is 120 - 2 * 16 = 88: the title is held to it, nothing ends past the right padding
    assert l.w[1] == 88;
    assert l.x[1] + l.w[1] + m.padding == 120;
    assert vcf_past_edge(l, 9, m.padding) == 0;
    // the text is not broken into lines: the overflow is reported, not hidden
    assert vcf_overflow_count(g, l, st) >= 1;
    assert vcf_extent(g, 1, st) > l.w[1];
    // negative controls: the edge check does see a rectangle past the padding, and a wide card reports no overflow
    var bad : VfLayout = l;
    bad.w[5] = 160;
    assert vcf_past_edge(bad, 9, m.padding) >= 1;
    var gw : VfGraph = vct_card_graph(375);
    var lw : VfLayout = vcf_layout(gw, st);
    assert vcf_overflow_count(gw, lw, st) == 0;
    assert vcf_past_edge(lw, 9, m.padding) == 0;
}
