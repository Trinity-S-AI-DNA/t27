// SPDX-License-Identifier: Apache-2.0
; T27F UI history, step 05: button horizontal padding is symmetric -- rule and test pinned on the token card (Refs gHashTag/t27#13214, epic #13214)
; The typed record of docs/reports/ui-history/2026-11-07/step-05-button-padding-symmetric/ (the frames live there; MANIFEST.md there is a reading
;   copy of this file and holds no field of its own). Shape and rules: ui_history. The log (ui_history_log) lists this step after step 04
;   (ui_history_s04), which stays as filed: this step is a new record, never an edit of an earlier one
; Owner rule, 2026-11-07: button horizontal padding is always symmetric -- left margin = right margin = (button_w - text_w) / 2.
;   The renderer already applied this formula (vc_render_s, VF_BUTTON branch, pen = x0 + (bw - tw) / 2 when tw < bw).
;   This step adds the test that pins the rule on the token card (vct_button_labels_centred_in_token_card in vf_card_tok.t27):
;   doubled ink centres 128 (Save) and 340 (Cancel) at 375 px, tolerance 4; negative: cleared labels leave no ink.
;   No rendering code changed, so BEFORE and AFTER are the same behaviour, one binary run twice. The DIFF is empty (black)
; Paths are relative to the step folder. The measured facts are the ones a test or the formula backs; nothing here says
;   the card looks better, and visual_review is PENDING_OWNER until the owner has opened the frames and said so in chat
; ASCII only (L3)

module T27fUiHistoryS05;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;

pub const US5_SEQ : u32 = 5;
pub const US5_ID : str = "ui-2026-11-07-step-05";
pub const US5_FOLDER : str = "docs/reports/ui-history/2026-11-07/step-05-button-padding-symmetric";

const US5_BEFORE : [12]str = [
    "01-before/before_375_p100_t0.png",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_AFTER : [12]str = [
    "02-after/after_375_p100_t0.png",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_DIFF : [12]str = [
    "03-diff/cmp_375_p100_t0.png",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_TOK_NAMES : [12]str = [
    "button.padding_symmetry",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_TOK_BEFORE : [12]str = [
    "renderer centred button labels (pen = x0 + (bw - tw) / 2) but no test on the token card pinned this for the resolved-token style",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_TOK_AFTER : [12]str = [
    "vct_button_labels_centred_in_token_card in vf_card_tok.t27 pins the symmetry: doubled ink centres 128 (Save) and 340 (Cancel) at 375 px t0 100 pct, tolerance 4; negative asserts no ink when labels are cleared",
    "", "", "", "", "", "", "", "", "", "", "",
];

const US5_MEASURED : [12]str = [
    "formula: pen = x0 + (bw - tw) / 2 (vc_render_s, VF_BUTTON branch) gives left_margin = right_margin = (bw - tw) / 2 exactly; the integer division causes at most 1 px asymmetry, inside the 2 px tolerance of the test",
    "measured by the new test on the token card at 375 px t0 100 pct: Save doubled ink centre 128 and Cancel doubled ink centre 340, both within tolerance 4 (2 pixel side-bearing allowance); negative: cleared labels leave no ink in either button box",
    "", "", "", "", "", "", "", "", "", "",
];

const US5_LIMITS : [12]str = [
    "no person has looked at any frame in this step; nothing here claims the card looks better, and byte-identical rasters are not evidence of visual quality",
    "BEFORE and AFTER are one binary run twice: the step pins an existing rule, it does not change a pixel",
    "the test covers only 375 px t0 100 pct and normal-width labels; buttons narrowed below their text width are not stress-tested here",
    "", "", "", "", "", "", "", "", "",
];

pub fn us5_step() -> UiStep {
    var st : UiStep = UiStep {
        seq: US5_SEQ,
        step_id: US5_ID,
        date: "2026-11-07",
        commit: "the commit that adds this record (BEFORE and AFTER are the same behaviour, one binary run twice)",
        branch: "claude/t27f-007-outfit-type",
        theme: "t0 black",
        viewport: "375 (the width the new centering test uses)",
        scale: "100 percent",
        before_n: 1,
        before_paths: US5_BEFORE,
        after_n: 1,
        after_paths: US5_AFTER,
        diff_n: 1,
        diff_paths: US5_DIFF,
        token_n: 1,
        token_names: US5_TOK_NAMES,
        token_before: US5_TOK_BEFORE,
        token_after: US5_TOK_AFTER,
        intended_change: "No rendering value changes. The owner rule that button horizontal padding is symmetric (left = right = (button_w - text_w) / 2) was already in the renderer. This step adds the test that explicitly pins it on the token card and records it as a named law. BEFORE and AFTER are the same behaviour on purpose, so the DIFF is empty. The test passes on the binary before and after this commit.",
        measured_n: 2,
        measured: US5_MEASURED,
        limit_n: 3,
        limits: US5_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test step_five_holds_every_rule_of_the_schema {
    let st : UiStep = us5_step();
    assert uh_validate(st) == UH_OK;
}

test step_five_is_pinned_as_filed {
    let st : UiStep = us5_step();
    assert st.seq == 5;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    assert st.before_n == 1;
    assert st.after_n == 1;
    assert st.diff_n == 1;
    assert st.token_n == 1;
    assert st.measured_n == 2;
    assert st.limit_n == 3;
}

test step_five_names_its_folder_branch_and_rule {
    let st : UiStep = us5_step();
    let id : str = st.step_id;
    let want : str = US5_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-05";
    let folder : str = US5_FOLDER;
    assert folder == "docs/reports/ui-history/2026-11-07/step-05-button-padding-symmetric";
    let br : str = st.branch;
    assert br == "claude/t27f-007-outfit-type";
    let names : [12]str = st.token_names;
    let rule : str = names[0];
    assert rule == "button.padding_symmetry";
}
