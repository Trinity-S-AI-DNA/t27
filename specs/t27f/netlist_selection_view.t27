// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_selection_view.t27 -- Renderer-neutral badge plan for the selected node.
; Ring 2, Wave L2 of epic #13650.
; NsvBadge: shows kind label and gold accent when a node is selected; invisible otherwise.
; Derives from NvSelection (sentinel) + NetlistGraph (node_kind) + NvPlan (layout x/y).
; Gold accent constants match TH_GOLD = 0xFFD700 (vf_theme.t27) -- no RGBA literal.
; Numbers only; a host (glass_window, Web) draws them.
; Depends on: netlist_selection, netlist_graph, netlist_view.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_selection_view;

use t27f::netlist_graph::{NetlistGraph, NG_NODE_BLOCK, NG_NODE_PIN, NG_NODE_DEVICE, inverter_graph};
use t27f::netlist_selection::{NvSelection, NV_NO_SELECTION, nv_no_selection, nv_select_node};
use t27f::netlist_view::{NvPlan, nv_layout, nv_node_x, nv_node_y};

; ── Gold accent constants -- TH_GOLD = 0xFFD700 ──────────────────────────────
; 0xFF/0xFF = 1.0, 0xD7/0xFF = 215/255 ~ 0.843, 0x00/0xFF = 0.0
pub const NSV_GOLD_R : f64 = 1.0;
pub const NSV_GOLD_G : f64 = 0.843;
pub const NSV_GOLD_B : f64 = 0.0;

; ── Accent alpha: 1.0 when selected, 0.0 otherwise ────────────────────────────
pub const NSV_ACCENT_ALPHA_ON  : f64 = 1.0;
pub const NSV_ACCENT_ALPHA_OFF : f64 = 0.0;

; ── NsvBadge: render plan for the selection badge ─────────────────────────────
pub struct NsvBadge {
    visible      : bool,
    kind_label   : u32,
    x            : u32,
    y            : u32,
    accent_alpha : f64,
}

; ── selection badge view ─────────────────────────────────────────────────────
; Returns badge with visible=false when no selection; otherwise derives from sel+g+p.
pub fn nsv_badge_view(sel: NvSelection, g: NetlistGraph, p: NvPlan) -> NsvBadge {
    var b : NsvBadge;
    if (sel.idx == NV_NO_SELECTION) {
        b.visible      = false;
        b.kind_label   = 0;
        b.x            = 0;
        b.y            = 0;
        b.accent_alpha = NSV_ACCENT_ALPHA_OFF;
        return b;
    }
    let ii : usize = sel.idx as usize;
    b.visible      = true;
    b.kind_label   = g.node_kind[ii] as u32;
    b.x            = nv_node_x(p, sel.idx);
    b.y            = nv_node_y(p, sel.idx);
    b.accent_alpha = NSV_ACCENT_ALPHA_ON;
    return b;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_not_visible {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.visible == false;
}

test block_selection_visible {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.visible == true;
}

test block_selection_kind_block {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.kind_label == NG_NODE_BLOCK as u32;
}

test pin_selection_kind_pin {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(1);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.kind_label == NG_NODE_PIN as u32;
}

test device_selection_kind_device {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(3);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.kind_label == NG_NODE_DEVICE as u32;
}

test no_selection_accent_off {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.accent_alpha == NSV_ACCENT_ALPHA_OFF;
}

test block_selection_accent_on {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.accent_alpha == NSV_ACCENT_ALPHA_ON;
}

test no_selection_x_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.x == 0;
}

test no_selection_y_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.y == 0;
}

test selection_x_from_layout {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.x == nv_node_x(p, 0);
}

test selection_y_from_layout {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan       = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    let b : NsvBadge = nsv_badge_view(sel, g, p);
    assert b.y == nv_node_y(p, 0);
}

test gold_r_is_one {
    assert NSV_GOLD_R == 1.0;
}

test gold_b_is_zero {
    assert NSV_GOLD_B == 0.0;
}

test accent_on_is_one {
    assert NSV_ACCENT_ALPHA_ON == 1.0;
}

test accent_off_is_zero {
    assert NSV_ACCENT_ALPHA_OFF == 0.0;
}

test gold_g_above_half {
    assert NSV_GOLD_G > 0.5;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant accent_on_exceeds_off {
    assert NSV_ACCENT_ALPHA_ON > NSV_ACCENT_ALPHA_OFF;
}

invariant gold_r_positive {
    assert NSV_GOLD_R > 0.0;
}

invariant gold_b_zero {
    assert NSV_GOLD_B == 0.0;
}
