const US3_DIFF : [12]str = [
    "03-diff/cmp_375_p100_t0.png",
    "03-diff/cmp_375_p100_t1.png",
    "03-diff/cmp_375_p200_t0.png",
    "03-diff/cmp_233_p100_t0.png",
