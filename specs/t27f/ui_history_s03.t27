// SPDX-License-Identifier: Apache-2.0
; T27F UI history, step 03: cross-axis narrowing in vf_layout and text measurement for the task card (Refs gHashTag/t27#13214, epic #13214)
; The typed record of docs/reports/ui-history/2026-11-07/step-03-cross-axis-narrowing/ (the frames live there; MANIFEST.md there is a reading
;   copy of this file and holds no field of its own). Shape and rules: ui_history. The log (ui_history_log) lists this step after step 02
;   (ui_history_s02), which stays as filed: this step is a new record, never an edit of an earlier one
; BEFORE here is the card as the previous commit (e2b087c5de) drew it, rendered by that commit's own binary; AFTER is the same scene drawn by
;   the commit with the layout rule (853db3e75b). No token value changed in this step: the change is a layout rule, so the changed list
;   below names rules, not token values, and says so
; Paths are relative to the step folder. The measured facts are the ones a byte comparison or a test backs; nothing here says the card
;   looks better, and visual_review is PENDING_OWNER until the owner has opened the frames and said so in chat
; ASCII only (L3)

module T27fUiHistoryS03;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;

pub const US3_SEQ : u32 = 3;
pub const US3_ID : str = "ui-2026-11-07-step-03";
pub const US3_FOLDER : str = "docs/reports/ui-history/2026-11-07/step-03-cross-axis-narrowing";

