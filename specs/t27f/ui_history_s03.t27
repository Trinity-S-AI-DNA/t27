const US3_TOK_NAMES : [12]str = [
    "layout.cross_axis_narrowing",
    "layout.leaf_measure",
    "", "", "", "", "", "", "", "", "", "",
];

const US3_TOK_BEFORE : [12]str = [
    "none (a column child kept its intrinsic cross size: the actions row stayed 202 wide in a 233 wide card and lost its right padding)",
    "none (no text measurement: every text node was 80 x 20 whatever it said)",
    "", "", "", "", "", "", "", "", "", "",
];

const US3_TOK_AFTER : [12]str = [
    "a child is held to the inner cross extent of its parent minus its margins, so the right padding is kept; an explicit min_w or min_h still wins",
    "vf_layout_m takes per-leaf width and height overrides; vf_card_fit supplies measured text widths (not wired to the painter or the host main)",
    "", "", "", "", "", "", "", "", "", "",
];

const US3_MEASURED : [12]str = [
    "at 375 wide the AFTER raster is byte-identical to the BEFORE raster in all three frames (t0 100 percent, t1 100 percent, t0 200 percent; md5 equal, 0 differing pixels): at a width where nothing was squeezed the rule changes no pixel",
    "differing pixels per narrow frame (magick compare, AE): 383 at 233 wide, 1624 at 201, 1889 at 191, 2809 at 160 (100 percent, t0); the largest per-channel difference is 118 of 255 at 233 and 255 of 255 at the other three",
    "rectangles at 233 wide: the actions stack 202 to 201 and Cancel 96 to 95 wide, so the stack ends at 217 and the right padding is 16",
    "rectangles at 201 wide: the stack 202 to 169, Save 96 to 80, Cancel 96 to 79 wide at x 106 (was 122), so the stack ends at 185 and the right padding is 16",
    "rectangles at 191 and 160 wide: field stack, input and actions stack are held to 159 (191) and 128 (160) wide, Save and Cancel to 75 and 74 (191) and 59 and 59 (160), so every one of them ends 16 px inside the card",
    "tests behind the numbers, T27 OS pane 15, t27c and t27b, 0 failed, 0 vacuous: vf_layout 19 (5 new), vf_card_fit 5 (new), vf_card_tok 15, vf_card 21, vf_storybook 13, vf_ring1 5, vf_pixel 7, vf_snapshot 9, vf_meaning 7, vf_render 6, vf_guard 14, vf_extent 4, vf_scale 10, ui_kit 9, vf_tokens 21, vf_theme 11, ui_history 10, ui_history_s01 3, ui_history_s02 3, ui_history_log 5; vf_card_main 6 and vf_frame_main 7 (t27c)",
    "", "", "", "", "", "",
];

const US3_LIMITS : [12]str = [
    "no person has looked at any frame in this step; nothing here claims the card looks better, and byte-identical rasters at 375 are not evidence of visual quality",
    "the painter neither wraps nor clips text, so in the narrow frames a title or a label may run past its box; that was not checked by eye and is not claimed either way",
    "the host main draws with vf_layout, which narrows but measures no text; vcf_layout in vf_card_fit measures text widths and is pinned by its own tests, but is not wired to the painter or the host main",
    "buttons, badges, inputs and text height are not measured; text is measured at the painter size and weight only",
    "type.label and control.min_target resolve but do not drive the painter; there is no radius, line height or row gap token",
    "vf_theme keeps a second spacing and type scale (TH_PAD_CARD 20 against space.card.padding 16, TH_TITLE_PX 22 against type.heading 26) and the breakpoint is 600 in vf_theme against 640 in vf_layout, both unchanged",
    "error and disabled input states are not drawn; the focus ring on the filled Save button is accent on accent; the cap height ratio 700 milli is assumed, not measured",
    "when filed, the commits after bd1b9ece89 were local only, and PR 13254 carried three inherited master reds that PR 13225 is meant to clear",
    "", "", "", "",
];

pub fn us3_step() -> UiStep {
    var st : UiStep = UiStep {
        seq: US3_SEQ,
        step_id: US3_ID,
        date: "2026-11-07",
        commit: "the commit that adds this record (BEFORE frames are the e2b087c5de behaviour, AFTER frames the 853db3e75b behaviour)",
        branch: "claude/t27f-007-outfit-type",
        theme: "t0 black (main set), t1 paper at 375",
        viewport: "375 (design width, unchanged), and 233, 201, 191, 160 (narrow widths where the rule acts)",
        scale: "100 percent (main set), 200 percent at 375",
        before_n: 7,
        before_paths: US3_BEFORE,
        after_n: 7,
        after_paths: US3_AFTER,
        diff_n: 7,
        diff_paths: US3_DIFF,
        token_n: 2,
        token_names: US3_TOK_NAMES,
        token_before: US3_TOK_BEFORE,
        token_after: US3_TOK_AFTER,
        intended_change: "No token value changes. A child of a column or a row is held to the inner cross extent of its parent minus its margins, so a narrow card keeps its padding instead of letting the actions row run out of the card, and a text node can take a measured width instead of 80. At 375 nothing is meant to change; at 233 wide and below the actions row and the fields give way. Whether the narrow frames read as better is the owner's call.",
        measured_n: 6,
        measured: US3_MEASURED,
        limit_n: 8,
        limits: US3_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test step_three_holds_every_rule_of_the_schema {
    let st : UiStep = us3_step();
    assert uh_validate(st) == UH_OK;
}

test step_three_is_pinned_as_filed {
    let st : UiStep = us3_step();
    assert st.seq == 3;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    assert st.before_n == 7;
    assert st.after_n == 7;
    assert st.diff_n == 7;
    assert st.token_n == 2;
    assert st.measured_n == 6;
    assert st.limit_n == 8;
}

test step_three_names_its_folder_branch_and_rules {
    let st : UiStep = us3_step();
    let id : str = st.step_id;
    let want : str = US3_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-03";
    let folder : str = US3_FOLDER;
    assert folder == "docs/reports/ui-history/2026-11-07/step-03-cross-axis-narrowing";
    let br : str = st.branch;
    assert br == "claude/t27f-007-outfit-type";
    let names : [12]str = st.token_names;
    let rule : str = names[0];
    assert rule == "layout.cross_axis_narrowing";
}
