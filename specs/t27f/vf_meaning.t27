// SPDX-License-Identifier: Apache-2.0
; T27F-005: vf_meaning says what is on screen in words a person can check against a picture
; Refs gHashTag/t27#13214, epic #13214
; Per node it gives the kind word, the relation to the previous sibling (first, below, right-of, overlapping), the gap in pixels, the depth and the child count
; It is NOT a pixel check and NOT a proof that the card looks good: it reads rectangles and says where each box sits, nothing more
; Reads VfGraph from specs/t27f/visual_factory_contract.t27 and VfLayout from specs/t27f/vf_layout.t27, edits neither
; Limits: no sentence builder (t27b rejects string +), so a row is fields plus the two word functions; the previous sibling is the nearest lower index with the same parent
; All arithmetic is u32 and non-negative: compare before subtracting

module t27f_vf_meaning;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::PRIMARY;
use t27f::visual_factory_contract::SECONDARY;
use t27f::visual_factory_contract::vf_child_count;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::stories::task_card::task_card_graph;

pub const REL_ROOT : u32 = 0;
pub const REL_FIRST : u32 = 1;
pub const REL_BELOW : u32 = 2;
pub const REL_RIGHT_OF : u32 = 3;
pub const REL_OVERLAP : u32 = 4;
pub const REL_OTHER : u32 = 5;
pub const NONE : u32 = 255;

; the nearest lower index with the same parent, or NONE for the root, a first child and an index past the graph
pub fn vf_prev_sibling(g: VfGraph, i: u32) -> u32 {
    if i >= g.node_count {
        return NONE;
    }
    if g.parent[i] == VF_NO_PARENT {
        return NONE;
    }
    var j : u32 = i;
    while j > 0 {
        j = j - 1;
        if g.parent[j] == g.parent[i] {
            return j;
        }
    }
    return NONE;
}

; where node i sits relative to its previous sibling: overlap is tested first, then below, then right-of
pub fn vf_relation(g: VfGraph, l: VfLayout, i: u32) -> u32 {
    if i >= g.node_count {
        return REL_OTHER;
    }
    if g.parent[i] == VF_NO_PARENT {
        return REL_ROOT;
    }
    var p : u32 = vf_prev_sibling(g, i);
    if p == NONE {
        return REL_FIRST;
    }
    var ax : bool = l.x[i] < l.x[p] + l.w[p] and l.x[p] < l.x[i] + l.w[i];
    var ay : bool = l.y[i] < l.y[p] + l.h[p] and l.y[p] < l.y[i] + l.h[i];
    if ax and ay {
        return REL_OVERLAP;
    }
    if l.y[i] >= l.y[p] + l.h[p] {
        return REL_BELOW;
    }
    if l.x[i] >= l.x[p] + l.w[p] {
        return REL_RIGHT_OF;
    }
    return REL_OTHER;
}

; pixels between node i and its previous sibling along the axis of the relation: 0 for every other relation
pub fn vf_gap(g: VfGraph, l: VfLayout, i: u32) -> u32 {
    var r : u32 = vf_relation(g, l, i);
    if r == REL_BELOW {
        var pb : u32 = vf_prev_sibling(g, i);
        return l.y[i] - (l.y[pb] + l.h[pb]);
    }
    if r == REL_RIGHT_OF {
        var pr : u32 = vf_prev_sibling(g, i);
        return l.x[i] - (l.x[pr] + l.w[pr]);
    }
    return 0;
}

; steps up the parent chain to the root, root is 0: the walk is capped at 16 because a graph holds 16 nodes
pub fn vf_depth(g: VfGraph, i: u32) -> u32 {
    var d : u32 = 0;
    var cur : u32 = i;
    while d < 16 {
        if cur >= g.node_count {
            return d;
        }
        if g.parent[cur] == VF_NO_PARENT {
            return d;
        }
        cur = g.parent[cur] as u32;
        d = d + 1;
    }
    return d;
}

; how many nodes of one kind id the graph holds, counted among the first node_count
pub fn vf_count_kind(g: VfGraph, kind: u32) -> u32 {
    var cnt : u32 = 0;
    var i : u32 = 0;
    while i < g.node_count {
        var k : u32 = g.kind[i] as u32;
        if k == kind {
            cnt = cnt + 1;
        }
        i = i + 1;
    }
    return cnt;
}

; the first button whose variant is PRIMARY, or NONE when the screen has no primary action
pub fn vf_primary_action(g: VfGraph) -> u32 {
    var i : u32 = 0;
    while i < g.node_count {
        if g.kind[i] == VF_BUTTON and g.variant[i] == PRIMARY {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

; the node an input is labelled by, or NONE when node i is not an input or names no label
pub fn vf_labelled_by(g: VfGraph, i: u32) -> u32 {
    if i >= g.node_count {
        return NONE;
    }
    if g.kind[i] == VF_INPUT {
        return g.label_ref[i] as u32;
    }
    return NONE;
}

pub fn vf_kind_word(g: VfGraph, i: u32) -> str {
    if i >= g.node_count {
        return "node";
    }
    if g.kind[i] == VF_CARD {
        return "card";
    }
    if g.kind[i] == VF_TEXT {
        return "text";
    }
    if g.kind[i] == VF_BADGE {
        return "badge";
    }
    if g.kind[i] == VF_INPUT {
        return "input";
    }
    if g.kind[i] == VF_STACK {
        return "stack";
    }
    if g.kind[i] == VF_BUTTON {
        return "button";
    }
    return "node";
}

pub fn vf_relation_word(r: u32) -> str {
    if r == REL_ROOT {
        return "root";
    }
    if r == REL_FIRST {
        return "first";
    }
    if r == REL_BELOW {
        return "below";
    }
    if r == REL_RIGHT_OF {
        return "right-of";
    }
    if r == REL_OVERLAP {
        return "overlapping";
    }
    return "other";
}

; hand-computed task card rows by node 0..7, four tables of 8 in one array
; relation: root first below below below below first right-of
; gap: title 8..28, badge 36..60, label 68..88, input 96..136, actions 144.., save x 8..104, cancel x 112..
; depth: the card 0, its five children 1, the two buttons 2
; children: the card holds 5, the action stack holds 2
pub const VM_WANT : [32]u32 = [
    0, 1, 2, 2, 2, 2, 1, 3,
    0, 0, 8, 8, 8, 8, 0, 8,
    0, 1, 1, 1, 1, 1, 2, 2,
    5, 0, 0, 0, 0, 2, 0, 0
];

; fixtures: the task card at one viewport width
fn vm_card(width: u32) -> VfGraph {
    var g : VfGraph = task_card_graph();
    g.viewport_w = width;
    return g;
}

; the table value the code computes for node i: which 0 relation, 1 gap, 2 depth, 3 child count
fn vm_got(g: VfGraph, l: VfLayout, which: u32, i: u32) -> u32 {
    if which == 0 {
        return vf_relation(g, l, i);
    }
    if which == 1 {
        return vf_gap(g, l, i);
    }
    if which == 2 {
        return vf_depth(g, i);
    }
    return vf_child_count(g, i);
}

; 0 when all eight rows of one table match the hand-computed values, else the first wrong node index plus one
fn vm_table_bad(g: VfGraph, l: VfLayout, which: u32) -> u32 {
    var i : u32 = 0;
    while i < 8 {
        if vm_got(g, l, which, i) != VM_WANT[which * 8 + i] {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

; 0 when the kind counts, the primary action and the label link are right, else the first wrong check number
fn vm_counts_bad(g: VfGraph) -> u32 {
    if vf_count_kind(g, VF_BUTTON as u32) != 2 {
        return 1;
    }
    if vf_count_kind(g, VF_TEXT as u32) != 2 {
        return 2;
    }
    if vf_count_kind(g, VF_INPUT as u32) != 1 {
        return 3;
    }
    if vf_count_kind(g, VF_BADGE as u32) != 1 {
        return 4;
    }
    if vf_count_kind(g, VF_CARD as u32) != 1 {
        return 5;
    }
    if vf_count_kind(g, VF_STACK as u32) != 1 {
        return 6;
    }
    if vf_primary_action(g) != 6 {
        return 7;
    }
    if vf_labelled_by(g, 4) != 3 {
        return 8;
    }
    if vf_labelled_by(g, 1) != NONE {
        return 9;
    }
    return 0;
}

; 0 when every negative control turns red as it must and every restore turns green again, else the first wrong check number
fn vm_neg_bad(width: u32) -> u32 {
    var g : VfGraph = vm_card(width);
    var l : VfLayout = vf_layout(g);
    l.y[2] = 20;
    if vf_relation(g, l, 2) != REL_OVERLAP {
        return 1;
    }
    if vf_gap(g, l, 2) != 0 {
        return 2;
    }
    l = vf_layout(g);
    l.x[7] = 100;
    if vf_relation(g, l, 7) != REL_OVERLAP {
        return 3;
    }
    if vf_gap(g, l, 7) != 0 {
        return 4;
    }
    l = vf_layout(g);
    if vm_table_bad(g, l, 0) != 0 {
        return 5;
    }
    if vm_table_bad(g, l, 1) != 0 {
        return 6;
    }
    l.y[3] = 80;
    if vf_gap(g, l, 3) != 20 {
        return 7;
    }
    if vf_relation(g, l, 3) != REL_BELOW {
        return 8;
    }
    l = vf_layout(g);
    g.variant[6] = SECONDARY;
    if vf_primary_action(g) != NONE {
        return 9;
    }
    return 0;
}

test relations {
    var a : VfGraph = vm_card(375);
    var la : VfLayout = vf_layout(a);
    assert vm_table_bad(a, la, 0) == 0;
    var b : VfGraph = vm_card(1280);
    var lb : VfLayout = vf_layout(b);
    assert vm_table_bad(b, lb, 0) == 0;
}

test gaps {
    var a : VfGraph = vm_card(375);
    var la : VfLayout = vf_layout(a);
    assert vm_table_bad(a, la, 1) == 0;
    var b : VfGraph = vm_card(1280);
    var lb : VfLayout = vf_layout(b);
    assert vm_table_bad(b, lb, 1) == 0;
}

test child_counts_and_depths {
    var a : VfGraph = vm_card(375);
    var la : VfLayout = vf_layout(a);
    assert vm_table_bad(a, la, 2) == 0;
    assert vm_table_bad(a, la, 3) == 0;
    assert vf_child_count(a, 0) == 5;
    assert vf_child_count(a, 5) == 2;
    assert vf_child_count(a, 1) == 0;
    var b : VfGraph = vm_card(1280);
    var lb : VfLayout = vf_layout(b);
    assert vm_table_bad(b, lb, 2) == 0;
    assert vm_table_bad(b, lb, 3) == 0;
}

test counts_primary_and_label {
    var a : VfGraph = vm_card(375);
    assert vm_counts_bad(a) == 0;
    var b : VfGraph = vm_card(1280);
    assert vm_counts_bad(b) == 0;
    assert vf_primary_action(a) == 6;
    assert vf_labelled_by(a, 4) == 3;
    assert vf_labelled_by(a, 1) == NONE;
}

test previous_sibling {
    var g : VfGraph = vm_card(375);
    assert vf_prev_sibling(g, 0) == NONE;
    assert vf_prev_sibling(g, 1) == NONE;
    assert vf_prev_sibling(g, 2) == 1;
    assert vf_prev_sibling(g, 3) == 2;
    assert vf_prev_sibling(g, 5) == 4;
    assert vf_prev_sibling(g, 6) == NONE;
    assert vf_prev_sibling(g, 7) == 6;
    assert vf_prev_sibling(g, 8) == NONE;
}

test words {
    var g : VfGraph = vm_card(375);
    let k0 : str = vf_kind_word(g, 0);
    let k1 : str = vf_kind_word(g, 1);
    let k2 : str = vf_kind_word(g, 2);
    let k4 : str = vf_kind_word(g, 4);
    let k5 : str = vf_kind_word(g, 5);
    let k6 : str = vf_kind_word(g, 6);
    let k9 : str = vf_kind_word(g, 9);
    assert k0 == "card";
    assert k1 == "text";
    assert k2 == "badge";
    assert k4 == "input";
    assert k5 == "stack";
    assert k6 == "button";
    assert k9 == "node";
    let r0 : str = vf_relation_word(REL_ROOT);
    let r1 : str = vf_relation_word(REL_FIRST);
    let r2 : str = vf_relation_word(REL_BELOW);
    let r3 : str = vf_relation_word(REL_RIGHT_OF);
    let r4 : str = vf_relation_word(REL_OVERLAP);
    let r5 : str = vf_relation_word(REL_OTHER);
    assert r0 == "root";
    assert r1 == "first";
    assert r2 == "below";
    assert r3 == "right-of";
    assert r4 == "overlapping";
    assert r5 == "other";
}

test negative_controls {
    assert vm_neg_bad(375) == 0;
    assert vm_neg_bad(1280) == 0;
}
