; ---------------------------------------------------------------- constants

/// This petal's index in the T27 OS menu and its row in the plan: F, FRONTEND.
pub const PFV_PETAL : u32 = 5;
/// Matrix cell (i, k) is the entity viz_ref(CELL, i * PFV_STRIDE + k); the stride holds every intent.
pub const PFV_STRIDE : u32 = 16;
/// The comma that separates the entries of a name string.
pub const PFV_COMMA : u8 = 44;

/// Petal events, numbered above the contract's VIZ_EV_COUNT: a = host, and a = surface to suppose
/// makeable (a number that is not a surface clears the wish).
pub const PFV_EV_HOST : u8 = 32;
pub const PFV_EV_WISH : u8 = 33;

/// Cell states: what a surface is to an intent. ANSWERS and STAND_IN are shown, WANTED is not.
pub const PFV_CELL_ANSWERS : u8 = 0;
pub const PFV_CELL_STAND_IN : u8 = 1;
pub const PFV_CELL_WANTED : u8 = 2;
pub const PFV_CELL_QUIET : u8 = 3;
/// No such cell, or nothing is shown yet (the view is not READY).
pub const PFV_CELL_NONE : u8 = 4;
pub const PFV_CELL_STATES : u8 = 5;

/// A status that no surface has: the line of a surface that does not exist.
pub const PFV_ST_NONE : u8 = 5;

/// Milliseconds the answer light takes to move to another surface; 0 under reduced motion.
pub const PFV_LIGHT_MS : u32 = 160;

/// The four root slots of the host, in focus order.
pub const PFV_SLOTS : u32 = 4;
pub const PFV_SLOT_BADGE : u32 = 0;
pub const PFV_SLOT_CHOICE : u32 = 1;
pub const PFV_SLOT_MATRIX : u32 = 2;
pub const PFV_SLOT_LIST : u32 = 3;

/// Layout, host coordinates. A matrix cell and a list line share one height, so row i of the matrix
/// and line i of the list sit at the same y, and choice option k sits right above matrix column k.
pub const PFV_CELL_W : u32 = 30;
pub const PFV_CELL_H : u32 = 24;
pub const PFV_CHOICE_X : u32 = 20;
pub const PFV_CHOICE_Y : u32 = 10;
pub const PFV_CHOICE_H : u32 = 40;
pub const PFV_BADGE_X : u32 = 430;
pub const PFV_BADGE_Y : u32 = 10;
pub const PFV_BADGE_W : u32 = 200;
pub const PFV_BADGE_H : u32 = 40;
pub const PFV_MATRIX_X : u32 = 20;
pub const PFV_MATRIX_Y : u32 = 70;
pub const PFV_LIST_X : u32 = 430;
pub const PFV_LIST_Y : u32 = 70;
pub const PFV_LIST_W : u32 = 400;

/// Recorded petal-side fixture, labels only: one short label per intent in the source's order, then
/// "other", the choice the source does not list. The source keeps no intent names.
pub const PFV_INTENT_LABELS : str = "shape,words,topic,lesson,report,pr,edit,health,agent,app,home,widget,other";

; ---------------------------------------------------------------- L1 fixture sizes and state

/// How many surfaces the source lists.
pub fn pfv_surfaces() -> u32 {
    return SF_COUNT;
}

/// How many choices the intent control has: the source's intents, then the unlisted "other".
pub fn pfv_intents() -> u32 {
    return I_COUNT + 1;
}

/// How many hosts route knows: reel.t27 numbers them 0 to HOST_SITE.
pub fn pfv_hosts() -> u32 {
    return (HOST_SITE as u32) + 1;
}

/// How many focusable entities: every surface, then every intent choice.
pub fn pfv_items() -> u32 {
    return SF_COUNT + I_COUNT + 1;
}

/// The petal state: the contract's one VizState, the host the question is asked on, and the what-if
/// wish (a surface supposed makeable, SF_NONE for none).
pub struct PfvState {
    viz: VizState,
    host: u8,
    wish: u32,
}

/// A petal loaded with n entities and the truth t: LOAD, then LOADED. n = 0 gives the EMPTY view. The
/// choice starts on the first intent, the host on Claude Code desktop, and no wish. The view has no
/// stepper, so the step count is 0; the choice has pfv_intents() options.
pub fn pfv_open_with(n: u32, t: u8) -> PfvState {
    var v : VizState = viz_init(0, pfv_intents());
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, n, t as u32);
    return PfvState { viz: v, host: HOST_CLAUDE_CODE_DESKTOP, wish: SF_NONE };
}

/// A petal ready to explore: every surface and intent focusable, the plan row's truth VERIFIED.
pub fn pfv_open() -> PfvState {
    return pfv_open_with(pfv_items(), VIZ_TRUTH_VERIFIED);
}

/// Change the host. Ignored unless READY; a number past the last host clamps to it, as PARAM_SET does.
/// The revision moves once, and not at all when the host is already that one.
pub fn pfv_set_host(p: PfvState, h: u32) -> PfvState {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return p;
    }
    let nh : u32 = viz_clamp(h, pfv_hosts());
    if (nh == (p.host as u32)) {
        return p;
    }
    var n : PfvState = p;
    var v : VizState = p.viz;
    n.host = nh as u8;
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// Suppose surface a could be made this turn. A number that is not a surface clears the wish. Ignored
/// unless READY; the revision moves once, and not at all when the wish does not change.
pub fn pfv_set_wish(p: PfvState, a: u32) -> PfvState {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return p;
    }
    var w : u32 = SF_NONE;
    if (a < SF_COUNT) {
        w = a;
    }
    if (w == p.wish) {
        return p;
    }
    var n : PfvState = p;
    var v : VizState = p.viz;
    n.wish = w;
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// The one reducer of the petal. PFV_EV_HOST (a = host) and PFV_EV_WISH (a = surface) are the petal's
/// own; every other event goes to the contract's viz_apply.
pub fn pfv_apply(p: PfvState, ev: u8, a: u32, b: u32) -> PfvState {
    if (ev == PFV_EV_HOST) {
        return pfv_set_host(p, a);
    }
    if (ev == PFV_EV_WISH) {
        return pfv_set_wish(p, a);
    }
    var n : PfvState = p;
    n.viz = viz_apply(p.viz, ev, a, b);
    return n;
}

/// The user's change: ask about intent k. A number past the last choice clamps to "other".
pub fn pfv_choose(p: PfvState, k: u32) -> PfvState {
    return pfv_apply(p, VIZ_EV_PARAM_SET, k, 0);
}

; ---------------------------------------------------------------- L2 entities

/// The entity of surface i; VIZ_REF_NONE for a number that is not a surface.
pub fn pfv_surface_ref(i: u32) -> u32 {
    if (i >= SF_COUNT) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_NODE, i);
}

/// The entity of intent choice k (the contract's EDGE kind); VIZ_REF_NONE past the last choice.
pub fn pfv_intent_ref(k: u32) -> u32 {
    if (k >= pfv_intents()) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_EDGE, k);
}

/// The entity of the matrix cell of surface i and intent k; VIZ_REF_NONE when either is out of range.
pub fn pfv_cell_ref(i: u32, k: u32) -> u32 {
    if (i >= SF_COUNT or k >= pfv_intents()) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_CELL, i * PFV_STRIDE + k);
}

/// True when a cell index names a surface row and an intent column inside the fixture.
fn pfv_cell_in(x: u32) -> bool {
    return x / PFV_STRIDE < SF_COUNT and x % PFV_STRIDE < pfv_intents();
}

/// The surface a ref names: a surface ref, or a cell ref's row; VIZ_NO_INDEX for anything else.
pub fn pfv_ref_surface(r: u32) -> u32 {
    let kind : u32 = viz_ref_kind(r);
    let idx : u32 = viz_ref_index(r);
    if (kind == VIZ_ENT_NODE and idx < SF_COUNT) {
        return idx;
    }
    if (kind == VIZ_ENT_CELL and pfv_cell_in(idx)) {
        return idx / PFV_STRIDE;
    }
    return VIZ_NO_INDEX;
}

/// The intent a ref names: an intent ref, or a cell ref's column; VIZ_NO_INDEX for anything else.
pub fn pfv_ref_intent(r: u32) -> u32 {
    let kind : u32 = viz_ref_kind(r);
    let idx : u32 = viz_ref_index(r);
    if (kind == VIZ_ENT_EDGE and idx < pfv_intents()) {
        return idx;
    }
    if (kind == VIZ_ENT_CELL and pfv_cell_in(idx)) {
        return idx % PFV_STRIDE;
    }
    return VIZ_NO_INDEX;
}

/// The entity of focus index f: the surfaces in listing order, then the intent choices. VIZ_REF_NONE
/// past the end or while the view is not READY.
pub fn pfv_focus_ref(p: PfvState, f: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or f >= p.viz.focus_count) {
        return VIZ_REF_NONE;
    }
    if (f < SF_COUNT) {
        return pfv_surface_ref(f);
    }
    if (f < pfv_items()) {
        return pfv_intent_ref(f - SF_COUNT);
    }
    return VIZ_REF_NONE;
}

/// A click or tap on entity r: an intent choice asks that intent, a surface line or a matrix cell
/// selects it, anything else is ignored.
pub fn pfv_click(p: PfvState, r: u32) -> PfvState {
    if (pfv_ref_intent(r) != VIZ_NO_INDEX and viz_ref_kind(r) == VIZ_ENT_EDGE) {
        return pfv_choose(p, pfv_ref_intent(r));
    }
    if (pfv_ref_surface(r) != VIZ_NO_INDEX) {
        return pfv_apply(p, VIZ_EV_SELECT, r, 0);
    }
    return p;
}

/// The keyboard's Enter on the focused item: an intent choice asks that intent, a surface is activated
/// (selected, or cleared when it already is). Nothing focused is a no-op.
pub fn pfv_activate(p: PfvState) -> PfvState {
    let r : u32 = pfv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    if (viz_ref_kind(r) == VIZ_ENT_EDGE) {
        return pfv_choose(p, viz_ref_index(r));
    }
    return pfv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

; ---------------------------------------------------------------- L3 names

/// Where entry k of the comma separated list `names` starts; the list's length when there is no entry k.
pub fn pfv_seg_start(names: str, k: u32) -> u32 {
    var seen : u32 = 0;
    var i : usize = 0;
    while (i < names.len and seen < k) {
        if (names[i] == PFV_COMMA) {
            seen = seen + 1;
        }
        i = i + 1;
    }
    return i as u32;
}

/// How many bytes entry k of the comma separated list `names` has; 0 when there is no entry k.
pub fn pfv_seg_len(names: str, k: u32) -> u32 {
    var i : usize = pfv_seg_start(names, k) as usize;
    var n : u32 = 0;
    while (i < names.len and names[i] != PFV_COMMA) {
        n = n + 1;
        i = i + 1;
    }
    return n;
}

/// True when entry k of the comma separated list `names` is exactly `word` (a whole entry, never a prefix).
pub fn pfv_seg_is(names: str, k: u32, word: str) -> bool {
    if (word.len == 0 or pfv_seg_len(names, k) != (word.len as u32)) {
        return false;
    }
    let st : usize = pfv_seg_start(names, k) as usize;
    var j : usize = 0;
    while (j < word.len and names[st + j] == word[j]) {
        j = j + 1;
    }
    return j == word.len;
}

/// How many bytes the name of surface i has, read from the source's SURFACE_NAMES; 0 out of range.
pub fn pfv_surface_name_len(i: u32) -> u32 {
    if (i >= SF_COUNT) {
        return 0;
    }
    return pfv_seg_len(SURFACE_NAMES, i);
}

/// True when the source's name of surface i is exactly `word`.
pub fn pfv_surface_name_is(i: u32, word: str) -> bool {
    if (i >= SF_COUNT) {
        return false;
    }
    return pfv_seg_is(SURFACE_NAMES, i, word);
}

/// How many bytes the label of intent choice k has, read from the fixture; 0 out of range.
pub fn pfv_intent_label_len(k: u32) -> u32 {
    if (k >= pfv_intents()) {
        return 0;
    }
    return pfv_seg_len(PFV_INTENT_LABELS, k);
}

/// True when the fixture's label of intent choice k is exactly `word`.
pub fn pfv_intent_label_is(k: u32, word: str) -> bool {
    if (k >= pfv_intents()) {
        return false;
    }
    return pfv_seg_is(PFV_INTENT_LABELS, k, word);
}

; ---------------------------------------------------------------- L4 and L5 answer and cells

/// The surface intent k wants on the state's host: the source's route. SF_NONE past the last choice.
pub fn pfv_want(p: PfvState, k: u32) -> u32 {
    if (k >= pfv_intents()) {
        return SF_NONE;
    }
    return route(k, p.host);
}

/// The surface shown for intent k on the state's host: the source's pick (the stand-in applied). The
/// wish makes its surface makeable, so where an intent wants the wished surface it is shown as it is.
pub fn pfv_shown(p: PfvState, k: u32) -> u32 {
    let want : u32 = pfv_want(p, k);
    if (want == SF_NONE) {
        return SF_NONE;
    }
    if (want == p.wish) {
        return want;
    }
    return pick(k, p.host);
}

/// What surface i is to intent k under the state: ANSWERS when it is both wanted and shown, STAND_IN when
/// it is shown in place of the wanted one, WANTED when it is wanted but not shown, QUIET otherwise. NONE
/// for a surface or intent that does not exist, and for every cell until the view is READY.
pub fn pfv_cell(p: PfvState, i: u32, k: u32) -> u8 {
    if (p.viz.lifecycle != VIZ_LC_READY or i >= SF_COUNT or k >= pfv_intents()) {
        return PFV_CELL_NONE;
    }
    let want : u32 = pfv_want(p, k);
    let shown : u32 = pfv_shown(p, k);
    if (i == shown and i == want) {
        return PFV_CELL_ANSWERS;
    }
    if (i == shown) {
        return PFV_CELL_STAND_IN;
    }
    if (i == want) {
        return PFV_CELL_WANTED;
    }
    return PFV_CELL_QUIET;
}

/// How many matrix cells are in state st under the state.
pub fn pfv_count_cells(p: PfvState, st: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < SF_COUNT) {
        var k : u32 = 0;
        while (k < pfv_intents()) {
            if (pfv_cell(p, i, k) == st) {
                n = n + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The surface the chosen intent wants; SF_NONE until the view is READY.
pub fn pfv_wanted(p: PfvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return SF_NONE;
    }
    return pfv_want(p, p.viz.param);
}

/// The answer on screen: the surface shown for the chosen intent; SF_NONE until the view is READY, and
/// when the source has nothing to show for it.
pub fn pfv_answer(p: PfvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return SF_NONE;
    }
    return pfv_shown(p, p.viz.param);
}

/// True when the answer is a stand-in: something is shown, and it is not the surface that was wanted.
pub fn pfv_is_stand_in(p: PfvState) -> bool {
    return pfv_answer(p) != SF_NONE and pfv_answer(p) != pfv_wanted(p);
}

/// How many surfaces have status st in the source's table.
pub fn pfv_count_status(st: u8) -> u32 {
    var n : u32 = 0;
    var s : u32 = 0;
    while (s < SF_COUNT) {
        if (SURFACE_STATUS[s as usize] == st) {
            n = n + 1;
        }
        s = s + 1;
    }
    return n;
}

; ---------------------------------------------------------------- L5 list lines

/// The status of surface s (the source's ST_*); PFV_ST_NONE out of range.
pub fn pfv_line_status(s: u32) -> u8 {
    if (s >= SF_COUNT) {
        return PFV_ST_NONE;
    }
    return SURFACE_STATUS[s as usize];
}

/// The maker of surface s (the source's MK_*); MK_NONE out of range.
pub fn pfv_line_maker(s: u32) -> u8 {
    if (s >= SF_COUNT) {
        return MK_NONE;
    }
    return SURFACE_MAKER[s as usize];
}

/// True when surface s can be made this turn (the source's makeable: LIVE or LAB).
pub fn pfv_line_made(s: u32) -> bool {
    return makeable(s);
}

/// True when an answer may say it made surface s (the source's claim_ok with a made claim).
pub fn pfv_line_may_say_made(s: u32) -> bool {
    return claim_ok(s, true);
}

/// True when an MCP tool draws surface s.
pub fn pfv_line_has_tool(s: u32) -> bool {
    return surface_tool(s) < TOOL_COUNT;
}

/// The name of the MCP tool that draws surface s, read from the tool table; "" when none does.
pub fn pfv_line_tool_name(s: u32) -> str {
    let t : u32 = surface_tool(s);
    if (t >= TOOL_COUNT) {
        return "";
    }
    return TOOLS[t as usize].name;
}

/// True when TRI CLAW serves surface s (the source's claw_serves).
pub fn pfv_line_serves(s: u32) -> bool {
    return claw_serves(s);
}

; ---------------------------------------------------------------- L6 badge

/// True while the shown value is the source's own rule over its own data: the choice is one of the
/// source's intents and no wish is on.
pub fn pfv_in_source(p: PfvState) -> bool {
    return p.viz.param < I_COUNT and p.wish == SF_NONE;
}

/// The truth the badge shows. UNKNOWN until the view is READY. A stored truth that cannot claim a
/// result (CACHED, DEMO, UNKNOWN) is kept. Otherwise VERIFIED, because no host feeds this petal so
/// LIVE is never shown, and DEMO as soon as the input leaves the source's data.
pub fn pfv_badge(p: PfvState) -> u8 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return VIZ_TRUTH_UNKNOWN;
    }
    if (viz_may_claim(p.viz.truth) == false) {
        return viz_truth(p.viz.truth);
    }
    if (pfv_in_source(p)) {
        return VIZ_TRUTH_VERIFIED;
    }
    return VIZ_TRUTH_DEMO;
}

/// Whether the view may present its answer as a result: the badge is LIVE or VERIFIED.
pub fn pfv_claims(p: PfvState) -> bool {
    return viz_may_claim(pfv_badge(p));
}

; ---------------------------------------------------------------- L7 views: highlight, layout, hits

/// SELECT when the selection hits, else HOVER when the hover hits, else NONE.
fn pfv_strongest(sel_hit: bool, hov_hit: bool) -> u8 {
    if (sel_hit) {
        return VIZ_HL_SELECT;
    }
    if (hov_hit) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

/// How row i is drawn in the matrix and line i in the list: SELECT when the selected entity is that
/// surface or one of its cells, else HOVER the same way, else NONE.
pub fn pfv_row_hl(s: VizState, i: u32) -> u8 {
    if (i >= SF_COUNT) {
        return VIZ_HL_NONE;
    }
    return pfv_strongest(pfv_ref_surface(s.selected) == i, pfv_ref_surface(s.hover) == i);
}

/// How column k is drawn in the matrix and option k on the choice: the same rule over intents.
pub fn pfv_col_hl(s: VizState, k: u32) -> u8 {
    if (k >= pfv_intents()) {
        return VIZ_HL_NONE;
    }
    return pfv_strongest(pfv_ref_intent(s.selected) == k, pfv_ref_intent(s.hover) == k);
}

/// How cell (i, k) is drawn: the stronger of its row and its column.
pub fn pfv_cell_hl(s: VizState, i: u32, k: u32) -> u8 {
    if (i >= SF_COUNT or k >= pfv_intents()) {
        return VIZ_HL_NONE;
    }
    let sel : bool = pfv_ref_surface(s.selected) == i or pfv_ref_intent(s.selected) == k;
    let hov : bool = pfv_ref_surface(s.hover) == i or pfv_ref_intent(s.hover) == k;
    return pfv_strongest(sel, hov);
}

/// True when surface i is the answer, so its matrix row and its list line carry the answer light.
pub fn pfv_row_lit(p: PfvState, i: u32) -> bool {
    return i < SF_COUNT and pfv_answer(p) == i;
}

/// True when intent choice k is the one asked, so its option and its matrix column carry the light.
pub fn pfv_col_lit(p: PfvState, k: u32) -> bool {
    return p.viz.lifecycle == VIZ_LC_READY and k < pfv_intents() and p.viz.param == k;
}

/// Left edge of matrix column k.
pub fn pfv_cell_x(k: u32) -> u32 {
    return PFV_MATRIX_X + k * PFV_CELL_W;
}

/// Top edge of matrix row i.
pub fn pfv_cell_y(i: u32) -> u32 {
    return PFV_MATRIX_Y + i * PFV_CELL_H;
}

/// Top edge of list line i.
pub fn pfv_line_y(i: u32) -> u32 {
    return PFV_LIST_Y + i * PFV_CELL_H;
}

/// Left edge of choice option k.
pub fn pfv_choice_x(k: u32) -> u32 {
    return PFV_CHOICE_X + k * PFV_CELL_W;
}

/// The cell ref under the point (host coordinates); VIZ_REF_NONE outside the matrix.
pub fn pfv_matrix_hit(px: u32, py: u32) -> u32 {
    if (px < PFV_MATRIX_X or py < PFV_MATRIX_Y) {
        return VIZ_REF_NONE;
    }
    let k : u32 = (px - PFV_MATRIX_X) / PFV_CELL_W;
    let i : u32 = (py - PFV_MATRIX_Y) / PFV_CELL_H;
    if (k >= pfv_intents() or i >= SF_COUNT) {
        return VIZ_REF_NONE;
    }
    return pfv_cell_ref(i, k);
}

/// The surface ref of the list line under the point; VIZ_REF_NONE outside the list.
pub fn pfv_list_hit(px: u32, py: u32) -> u32 {
    if (px < PFV_LIST_X or px >= PFV_LIST_X + PFV_LIST_W or py < PFV_LIST_Y) {
        return VIZ_REF_NONE;
    }
    let i : u32 = (py - PFV_LIST_Y) / PFV_CELL_H;
    if (i >= SF_COUNT) {
        return VIZ_REF_NONE;
    }
    return pfv_surface_ref(i);
}

/// The intent ref of the choice option under the point; VIZ_REF_NONE outside the choice.
pub fn pfv_choice_hit(px: u32, py: u32) -> u32 {
    if (px < PFV_CHOICE_X or py < PFV_CHOICE_Y or py >= PFV_CHOICE_Y + PFV_CHOICE_H) {
        return VIZ_REF_NONE;
    }
    let k : u32 = (px - PFV_CHOICE_X) / PFV_CELL_W;
    if (k >= pfv_intents()) {
        return VIZ_REF_NONE;
    }
    return pfv_intent_ref(k);
}

/// How long the answer light takes to move from the answer of `before` to the answer of `after`: 0 when
/// the answer did not change, and 0 when the user asked for reduced motion.
pub fn pfv_relight_ms(before: PfvState, after: PfvState) -> u32 {
    if (pfv_answer(before) == pfv_answer(after)) {
        return 0;
    }
    return viz_motion_ms(after.viz, PFV_LIGHT_MS);
}

; ---------------------------------------------------------------- L8 host

/// The layout: the badge, the choice, the matrix and the list, four root slots in focus order.
pub fn pfv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PFV_BADGE_X, PFV_BADGE_Y, PFV_BADGE_W, PFV_BADGE_H);
    h = vh_add(h, VIZ_REP_CHOICE, VH_ROOT, PFV_CHOICE_X, PFV_CHOICE_Y, pfv_intents() * PFV_CELL_W, PFV_CHOICE_H);
    h = vh_add(h, VIZ_REP_MATRIX, VH_ROOT, PFV_MATRIX_X, PFV_MATRIX_Y, pfv_intents() * PFV_CELL_W, SF_COUNT * PFV_CELL_H);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, PFV_LIST_X, PFV_LIST_Y, PFV_LIST_W, SF_COUNT * PFV_CELL_H);
    return h;
}

/// The petal's slots placed under slot `at` of a larger host, offset by (ox, oy): the petal is reused
/// by embedding its host, not by copying its logic.
pub fn pfv_in_frame(frame: VizHost, at: u32, ox: u32, oy: u32) -> VizHost {
    return vh_embed(frame, pfv_host(), at, ox, oy);
}

/// The reps of the petal as a bit set: matrix, list, choice, badge (the plan row's 390).
pub fn pfv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_MATRIX) | viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_CHOICE) | viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// Hand-read for the tests from the source's route comments, not from pfv_want: the surface intent k
/// wants on a host other than the site (the site wants the graph page for intent 0 instead).
pub const PFV_HAND_WANT : [13]u32 = [0, 1, 9, 7, 8, 5, 4, 12, 10, 11, 13, 14, 255];
/// Hand-read: the surface shown for intent k on the same hosts (255 is nothing).
pub const PFV_HAND_SHOWN : [13]u32 = [0, 1, 2, 7, 8, 0, 0, 12, 7, 255, 255, 255, 255];
/// Hand-read: the first byte of each surface name in SURFACE_NAMES, as ASCII.
pub const PFV_HAND_FIRST : [15]u8 = [103, 111, 109, 103, 104, 99, 112, 112, 115, 109, 112, 117, 100, 112, 119];

/// A petal that has not loaded: idle, truth UNKNOWN.
fn pfv_idle() -> PfvState {
    return PfvState { viz: viz_init(0, pfv_intents()), host: HOST_CLAUDE_CODE_DESKTOP, wish: SF_NONE };
}

/// An open petal on host h.
fn pfv_on(h: u8) -> PfvState {
    return pfv_apply(pfv_open(), PFV_EV_HOST, h as u32, 0);
}

/// An open petal on the default host with intent k asked.
fn pfv_ask(k: u32) -> PfvState {
    return pfv_choose(pfv_open(), k);
}

/// An open petal on host h with intent k asked.
fn pfv_ask_on(h: u8, k: u32) -> PfvState {
    return pfv_choose(pfv_on(h), k);
}

; ---------------------------------------------------------------- tests: state and lifecycle

test a_fresh_petal_is_idle_unknown_and_shows_nothing {
    let p : PfvState = pfv_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert p.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert p.viz.param_count == 13;
    assert p.viz.step_count == 0;
    assert pfv_badge(p) == VIZ_TRUTH_UNKNOWN;
    assert pfv_claims(p) == false;
    assert pfv_cell(p, 0, 0) == PFV_CELL_NONE;
    assert pfv_answer(p) == SF_NONE;
    assert pfv_wanted(p) == SF_NONE;
    assert pfv_row_lit(p, 0) == false;
    assert pfv_col_lit(p, 0) == false;
    assert pfv_focus_ref(p, 0) == VIZ_REF_NONE;
    // The petal's own events wait for READY, like the contract's interaction events.
    assert pfv_apply(p, PFV_EV_HOST, HOST_SITE as u32, 0).host == p.host;
    assert pfv_apply(p, PFV_EV_WISH, SF_CHECK, 0).wish == SF_NONE;
    assert pfv_apply(p, PFV_EV_WISH, SF_CHECK, 0).viz.revision == 0;
}

test opening_loads_every_surface_and_intent_and_claims_verified {
    let p : PfvState = pfv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == pfv_items();
    assert p.viz.focus_count == p.viz.item_count;
    assert p.viz.step_count == 0;
    assert p.viz.param_count == pfv_intents();
    assert p.viz.param == I_SPEC_SHAPE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.host == HOST_CLAUDE_CODE_DESKTOP;
    assert p.wish == SF_NONE;
    assert pfv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert viz_may_claim(pfv_badge(p));
    assert pfv_claims(p);
}

test the_fixture_sizes_come_from_the_source_and_the_petal_adds_one_other_intent {
    assert pfv_surfaces() == SF_COUNT;
    assert pfv_surfaces() == 15;
    assert pfv_intents() == I_COUNT + 1;
    assert pfv_intents() == 13;
    assert pfv_hosts() == 4;
    assert pfv_items() == pfv_surfaces() + pfv_intents();
    assert PFV_STRIDE >= pfv_intents();
    // The extra choice is the one number the source does not list: it routes it nowhere.
    assert route(I_COUNT, HOST_SITE) == SF_NONE;
    assert pick(I_COUNT, HOST_CLAUDE_CODE_CLI) == SF_NONE;
    // The four hosts the petal asks about are the four route knows.
    assert HOST_CLAUDE_CODE_CLI == 0;
    assert HOST_CLAUDE_CODE_DESKTOP == 1;
    assert HOST_MCP_APPS == 2;
    assert HOST_SITE == 3;
}

test an_empty_fixture_is_empty_shows_nothing_and_ignores_every_input {
    let e : PfvState = pfv_open_with(0, VIZ_TRUTH_VERIFIED);
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert e.viz.focus_count == 0;
    assert pfv_badge(e) == VIZ_TRUTH_UNKNOWN;
    assert pfv_cell(e, 0, 0) == PFV_CELL_NONE;
    assert pfv_answer(e) == SF_NONE;
    assert pfv_count_cells(e, PFV_CELL_NONE) == pfv_surfaces() * pfv_intents();
    assert pfv_count_cells(e, PFV_CELL_QUIET) == 0;
    assert pfv_focus_ref(e, 0) == VIZ_REF_NONE;
    assert viz_same(pfv_apply(e, VIZ_EV_SELECT, pfv_surface_ref(0), 0).viz, e.viz);
    assert pfv_choose(e, 3).viz.param == 0;
    assert pfv_apply(e, PFV_EV_HOST, HOST_SITE as u32, 0).host == e.host;
    assert pfv_apply(e, PFV_EV_WISH, SF_CHECK, 0).wish == SF_NONE;
    let focused : PfvState = pfv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert focused.viz.focus == VIZ_NO_FOCUS;
    assert viz_same(pfv_activate(e).viz, e.viz);
    // A reload that finds the data makes it READY again.
    let again : PfvState = pfv_apply(pfv_apply(e, VIZ_EV_LOAD, 0, 0), VIZ_EV_LOADED, pfv_items(), VIZ_TRUTH_VERIFIED as u32);
    assert again.viz.lifecycle == VIZ_LC_READY;
    assert pfv_badge(again) == VIZ_TRUTH_VERIFIED;
}

test a_failed_load_is_an_error_that_ignores_input_until_a_retry_succeeds {
    var p : PfvState = pfv_apply(pfv_open(), VIZ_EV_FAILED, 7, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 7;
    assert pfv_badge(p) == VIZ_TRUTH_UNKNOWN;
    assert pfv_cell(p, 0, 0) == PFV_CELL_NONE;
    assert pfv_answer(p) == SF_NONE;
    assert viz_same(pfv_choose(p, 4).viz, p.viz);
    assert pfv_apply(p, PFV_EV_HOST, HOST_SITE as u32, 0).host == p.host;
    p = pfv_apply(p, VIZ_EV_RETRY, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert pfv_badge(p) == VIZ_TRUTH_UNKNOWN;
    p = pfv_apply(p, VIZ_EV_LOADED, pfv_items(), VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.error == 0;
    assert pfv_badge(p) == VIZ_TRUTH_VERIFIED;
    // Error code 0 reads as the unspecified error, never as "no error".
    assert pfv_apply(pfv_open(), VIZ_EV_FAILED, 0, 0).viz.error == VIZ_ERR_UNSPECIFIED;
}

test a_reload_keeps_the_choice_the_host_and_the_wish_and_reads_unknown_while_loading {
    var p : PfvState = pfv_apply(pfv_ask_on(HOST_SITE, I_REPORT), PFV_EV_WISH, SF_CHECK, 0);
    assert p.viz.param == I_REPORT;
    assert pfv_badge(p) == VIZ_TRUTH_DEMO;
    p = pfv_apply(p, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert pfv_badge(p) == VIZ_TRUTH_UNKNOWN;
    p = pfv_apply(p, VIZ_EV_LOADED, pfv_items(), VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.param == I_REPORT;
    assert p.host == HOST_SITE;
    assert p.wish == SF_CHECK;
    assert pfv_badge(p) == VIZ_TRUTH_DEMO;
}

test petal_events_are_numbered_above_the_contract_and_the_rest_go_to_the_one_reducer {
    assert PFV_EV_HOST >= VIZ_EV_COUNT;
    assert PFV_EV_WISH >= VIZ_EV_COUNT;
    assert PFV_EV_HOST != PFV_EV_WISH;
    // The contract's reducer does not know them: handed to it, they change nothing.
    let p : PfvState = pfv_open();
    assert viz_same(viz_apply(p.viz, PFV_EV_HOST, HOST_SITE as u32, 0), p.viz);
    assert viz_same(viz_apply(p.viz, PFV_EV_WISH, SF_CHECK, 0), p.viz);
    // A contract event through pfv_apply is exactly viz_apply on the state's VizState.
    assert viz_same(pfv_apply(p, VIZ_EV_PARAM_SET, 4, 0).viz, viz_apply(p.viz, VIZ_EV_PARAM_SET, 4, 0));
    assert pfv_apply(p, VIZ_EV_PARAM_SET, 4, 0).viz.revision == viz_apply(p.viz, VIZ_EV_PARAM_SET, 4, 0).revision;
    assert viz_same(pfv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0).viz, viz_apply(p.viz, VIZ_EV_FOCUS_NEXT, 0, 0));
    // A petal event moves the revision once and leaves the contract's other fields alone.
    var q : PfvState = pfv_apply(pfv_ask(4), VIZ_EV_SELECT, pfv_surface_ref(2), 0);
    q = pfv_apply(q, VIZ_EV_FOCUS_NEXT, 0, 0);
    let r : PfvState = pfv_apply(q, PFV_EV_HOST, HOST_SITE as u32, 0);
    assert r.host == HOST_SITE;
    assert r.viz.revision == q.viz.revision + 1;
    assert r.viz.param == 4;
    assert r.viz.selected == pfv_surface_ref(2);
    assert r.viz.focus == q.viz.focus;
    // The same host again, and the same wish again, are not changes.
    assert pfv_apply(r, PFV_EV_HOST, HOST_SITE as u32, 0).viz.revision == r.viz.revision;
    let w : PfvState = pfv_apply(r, PFV_EV_WISH, SF_PREVIEW, 0);
    assert w.viz.revision == r.viz.revision + 1;
    assert pfv_apply(w, PFV_EV_WISH, SF_PREVIEW, 0).viz.revision == w.viz.revision;
}

; ---------------------------------------------------------------- tests: names, labels, status, lines

test surface_names_are_read_from_the_sources_comma_list_by_entry {
    var k : u32 = 0;
    var total : u32 = 0;
    while (k < pfv_surfaces()) {
        total = total + pfv_surface_name_len(k);
        assert pfv_surface_name_len(k) > 0;
        assert SURFACE_NAMES[pfv_seg_start(SURFACE_NAMES, k) as usize] == PFV_HAND_FIRST[k as usize];
        k = k + 1;
    }
    // Fifteen entries and fourteen commas make up the whole string, so no entry is cut or doubled.
    assert total + pfv_surfaces() - 1 == (SURFACE_NAMES.len as u32);
    assert (SURFACE_NAMES.len as u32) == 140;
    assert pfv_seg_start(SURFACE_NAMES, 0) == 0;
    assert pfv_seg_start(SURFACE_NAMES, 1) == 6;
    assert pfv_seg_start(SURFACE_NAMES, 14) == 126;
    assert pfv_surface_name_len(SF_GRAPH) == 5;
    assert pfv_surface_name_len(SF_PARTICLE_REEL) == 13;
    assert pfv_surface_name_len(SF_WIDGET_FACTORY) == 14;
    assert pfv_surface_name_is(SF_CHECK, "check");
    assert pfv_surface_name_is(SF_GRAPH, "graph");
    assert pfv_surface_name_is(SF_WIDGET_FACTORY, "widget_factory");
    assert pfv_surface_name_is(SF_DASHBOARD, "dashboard");
    // A whole entry only: a prefix, an extension, the empty word and a neighbour are not the name.
    assert pfv_surface_name_is(SF_CHECK, "chec") == false;
    assert pfv_surface_name_is(SF_CHECK, "checks") == false;
    assert pfv_surface_name_is(SF_CHECK, "") == false;
    assert pfv_surface_name_is(SF_GRAPH_PAGE, "graph") == false;
    assert pfv_surface_name_is(SF_GRAPH_PAGE, "graph_page");
    assert pfv_surface_name_is(SF_STILL, "particle_reel") == false;
    // Past the last entry there is no name.
    assert pfv_surface_name_len(SF_COUNT) == 0;
    assert pfv_surface_name_is(SF_COUNT, "graph") == false;
    assert pfv_seg_len(SURFACE_NAMES, SF_COUNT) == 0;
}

test intent_labels_are_a_petal_side_fixture_tied_to_the_sources_numbers {
    assert pfv_intent_label_is(I_SPEC_SHAPE, "shape");
    assert pfv_intent_label_is(I_SPEC_WORDS, "words");
    assert pfv_intent_label_is(I_TOPIC_MAP, "topic");
    assert pfv_intent_label_is(I_LESSON, "lesson");
    assert pfv_intent_label_is(I_REPORT, "report");
    assert pfv_intent_label_is(I_PR, "pr");
    assert pfv_intent_label_is(I_EDITING, "edit");
    assert pfv_intent_label_is(I_HEALTH, "health");
    assert pfv_intent_label_is(I_LIVE_AGENT, "agent");
    assert pfv_intent_label_is(I_APP, "app");
    assert pfv_intent_label_is(I_OS_HOME, "home");
    assert pfv_intent_label_is(I_WIDGET, "widget");
    assert pfv_intent_label_is(I_COUNT, "other");
    assert pfv_intent_label_is(I_PR, "report") == false;
    assert pfv_intent_label_is(I_PR, "p") == false;
    // Exactly one non-empty label per choice, and nothing after the last.
    var k : u32 = 0;
    var total : u32 = 0;
    while (k < pfv_intents()) {
        assert pfv_intent_label_len(k) > 0;
        total = total + pfv_intent_label_len(k);
        k = k + 1;
    }
    assert total + pfv_intents() - 1 == (PFV_INTENT_LABELS.len as u32);
    assert pfv_intent_label_len(pfv_intents()) == 0;
    assert pfv_intent_label_is(pfv_intents(), "other") == false;
}

test the_status_counts_come_from_the_source_table_and_match_what_is_makeable {
    assert pfv_count_status(ST_LIVE) == 5;
    assert pfv_count_status(ST_LAB) == 2;
    assert pfv_count_status(ST_PARTIAL) == 1;
    assert pfv_count_status(ST_BLOCKED) == 1;
    assert pfv_count_status(ST_SPEC) == 6;
    assert pfv_count_status(PFV_ST_NONE) == 0;
    assert pfv_count_status(ST_LIVE) + pfv_count_status(ST_LAB) + pfv_count_status(ST_PARTIAL) + pfv_count_status(ST_BLOCKED) + pfv_count_status(ST_SPEC) == pfv_surfaces();
    assert pfv_line_status(SF_GRAPH) == ST_LIVE;
    assert pfv_line_status(SF_STILL) == ST_LAB;
    assert pfv_line_status(SF_HOT) == ST_PARTIAL;
    assert pfv_line_status(SF_CHECK) == ST_BLOCKED;
    assert pfv_line_status(SF_PETAL_MENU) == ST_SPEC;
    assert pfv_line_status(SF_COUNT) == PFV_ST_NONE;
    // A surface is made this turn exactly when it is LIVE or LAB.
    var s : u32 = 0;
    var made : u32 = 0;
    while (s < pfv_surfaces()) {
        if (pfv_line_made(s)) {
            made = made + 1;
            assert pfv_line_status(s) == ST_LIVE or pfv_line_status(s) == ST_LAB;
        } else {
            assert pfv_line_status(s) != ST_LIVE;
            assert pfv_line_status(s) != ST_LAB;
        }
        assert pfv_line_may_say_made(s) == pfv_line_made(s);
        s = s + 1;
    }
    assert made == pfv_count_status(ST_LIVE) + pfv_count_status(ST_LAB);
    assert made == 7;
    assert pfv_line_made(SF_NONE) == false;
    assert pfv_line_may_say_made(SF_NONE) == false;
}

test list_lines_read_maker_tool_and_service_from_the_source {
    var s : u32 = 0;
    var tools : u32 = 0;
    var served : u32 = 0;
    while (s < pfv_surfaces()) {
        assert pfv_line_maker(s) == SURFACE_MAKER[s as usize];
        if (pfv_line_has_tool(s)) {
            tools = tools + 1;
            assert pfv_line_maker(s) == MK_MCP;
            assert pfv_line_serves(s);
            assert pfv_line_tool_name(s) != "";
        } else {
            assert pfv_line_serves(s) == false;
            assert pfv_line_tool_name(s) == "";
        }
        if (pfv_line_serves(s)) {
            served = served + 1;
        }
        s = s + 1;
    }
    assert tools == 4;
    assert served == CLAW_VISUAL_COUNT;
    assert pfv_line_tool_name(SF_GRAPH) == "t27f_graph";
    assert pfv_line_tool_name(SF_OUTLINE) == "t27f_outline";
    assert pfv_line_tool_name(SF_MAP_STILL) == "t27f_view";
    assert pfv_line_tool_name(SF_DASHBOARD) == "t27_dashboard";
    // The four tools TRI CLAW carries are the tools of those four surfaces, in the same order.
    assert surface_tool(SF_GRAPH) == claw_visual_tool(0);
    assert surface_tool(SF_OUTLINE) == claw_visual_tool(1);
    assert surface_tool(SF_MAP_STILL) == claw_visual_tool(2);
    assert surface_tool(SF_DASHBOARD) == claw_visual_tool(3);
    // Nothing draws a particle reel by tool, and a surface past the list has no line at all.
    assert pfv_line_has_tool(SF_PARTICLE_REEL) == false;
    assert pfv_line_maker(SF_COUNT) == MK_NONE;
    assert pfv_line_has_tool(SF_NONE) == false;
    assert pfv_line_serves(SF_NONE) == false;
}

; ---------------------------------------------------------------- tests: the answer and the input change

test an_intent_maps_to_the_surface_the_source_routes_and_picks_on_every_host {
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        let p : PfvState = pfv_on(h as u8);
        assert (p.host as u32) == h;
        var k : u32 = 0;
        while (k < pfv_intents()) {
            assert pfv_want(p, k) == route(k, h as u8);
            assert pfv_shown(p, k) == pick(k, h as u8);
            if (h != (HOST_SITE as u32) or k != I_SPEC_SHAPE) {
                assert pfv_want(p, k) == PFV_HAND_WANT[k as usize];
                assert pfv_shown(p, k) == PFV_HAND_SHOWN[k as usize];
            }
            k = k + 1;
        }
        h = h + 1;
    }
    assert pfv_want(pfv_open(), pfv_intents()) == SF_NONE;
    assert pfv_shown(pfv_open(), pfv_intents()) == SF_NONE;
}

test the_answer_is_always_a_surface_the_source_can_make_or_nothing {
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        let p : PfvState = pfv_on(h as u8);
        var k : u32 = 0;
        while (k < pfv_intents()) {
            let a : u32 = pfv_shown(p, k);
            let w : u32 = pfv_want(p, k);
            if (a != SF_NONE) {
                assert makeable(a);
                assert claim_ok(a, true);
            }
            if (w != SF_NONE and makeable(w)) {
                assert a == w;
            }
            if (w != SF_NONE and makeable(w) == false) {
                assert a == stand_in(w);
                assert a != w;
            }
            k = k + 1;
        }
        h = h + 1;
    }
    // The stand-ins the source names.
    assert stand_in(SF_MAP_VIDEO) == SF_MAP_STILL;
    assert stand_in(SF_CHECK) == SF_GRAPH;
    assert stand_in(SF_PREVIEW) == SF_GRAPH;
    assert stand_in(SF_HOT) == SF_GRAPH;
    assert stand_in(SF_PARTICLE_LIVE) == SF_PARTICLE_REEL;
    assert stand_in(SF_UI_PLAN) == SF_NONE;
    assert stand_in(SF_PETAL_MENU) == SF_NONE;
    assert stand_in(SF_WIDGET_FACTORY) == SF_NONE;
    assert stand_in(SF_STILL) == SF_STILL;
}

test choosing_an_intent_recomputes_the_answer_straight_from_the_source {
    let p0 : PfvState = pfv_open();
    assert p0.viz.param == I_SPEC_SHAPE;
    assert pfv_answer(p0) == pick(I_SPEC_SHAPE, HOST_CLAUDE_CODE_DESKTOP);
    let p3 : PfvState = pfv_choose(p0, I_LESSON);
    assert p3.viz.param == I_LESSON;
    assert p3.viz.revision == p0.viz.revision + 1;
    assert pfv_answer(p3) == pick(I_LESSON, HOST_CLAUDE_CODE_DESKTOP);
    assert pfv_answer(p3) == SF_PARTICLE_REEL;
    // Choosing the same intent again changes nothing, not even the revision.
    assert pfv_choose(p3, I_LESSON).viz.revision == p3.viz.revision;
    // Every intent on every host: the petal's answer is the source's pick.
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        var k : u32 = 0;
        while (k < pfv_intents()) {
            let p : PfvState = pfv_ask_on(h as u8, k);
            assert p.viz.param == k;
            assert pfv_answer(p) == pick(k, h as u8);
            assert pfv_wanted(p) == route(k, h as u8);
            k = k + 1;
        }
        h = h + 1;
    }
    // The hand-read table agrees on the default host.
    var m : u32 = 0;
    while (m < pfv_intents()) {
        assert pfv_answer(pfv_ask(m)) == PFV_HAND_SHOWN[m as usize];
        m = m + 1;
    }
    // A choice past the last clamps to "other", which the source answers with nothing.
    assert pfv_choose(p0, 99).viz.param == I_COUNT;
    assert pfv_answer(pfv_choose(p0, 99)) == SF_NONE;
    // A stand-in is told apart from an answer, and from nothing.
    assert pfv_wanted(pfv_ask(I_TOPIC_MAP)) == SF_MAP_VIDEO;
    assert pfv_answer(pfv_ask(I_TOPIC_MAP)) == SF_MAP_STILL;
    assert pfv_is_stand_in(pfv_ask(I_TOPIC_MAP));
    assert pfv_is_stand_in(pfv_ask(I_LESSON)) == false;
    assert pfv_is_stand_in(pfv_ask(I_APP)) == false;
    assert pfv_is_stand_in(pfv_ask(I_COUNT)) == false;
    // The intents are unordered, so the view has no stepper: STEP events change nothing.
    assert viz_same(pfv_apply(p0, VIZ_EV_STEP_NEXT, 0, 0).viz, p0.viz);
}

test the_site_swaps_the_graph_for_its_page_and_no_other_answer_moves {
    let site : PfvState = pfv_on(HOST_SITE);
    assert site.host == HOST_SITE;
    assert site.viz.revision == pfv_open().viz.revision + 1;
    assert pfv_answer(pfv_choose(site, I_SPEC_SHAPE)) == SF_GRAPH_PAGE;
    assert pfv_answer(pfv_ask(I_SPEC_SHAPE)) == SF_GRAPH;
    assert pfv_answer(pfv_ask_on(HOST_CLAUDE_CODE_CLI, I_SPEC_SHAPE)) == SF_GRAPH;
    assert pfv_answer(pfv_ask_on(HOST_MCP_APPS, I_SPEC_SHAPE)) == SF_GRAPH;
    var k : u32 = 1;
    while (k < pfv_intents()) {
        assert pfv_answer(pfv_choose(site, k)) == pfv_answer(pfv_ask(k));
        k = k + 1;
    }
    // The page and the tool are different surfaces with different makers.
    assert pfv_line_maker(SF_GRAPH_PAGE) != pfv_line_maker(SF_GRAPH);
    assert pfv_line_has_tool(SF_GRAPH_PAGE) == false;
    // A host past the last clamps to the site; the same host again is not a change.
    assert pfv_apply(pfv_open(), PFV_EV_HOST, 99, 0).host == HOST_SITE;
    assert pfv_apply(site, PFV_EV_HOST, HOST_SITE as u32, 0).viz.revision == site.viz.revision;
    // Moving the host never leaves the source's data.
    assert pfv_badge(site) == VIZ_TRUTH_VERIFIED;
    assert pfv_badge(pfv_ask_on(HOST_MCP_APPS, I_HEALTH)) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- tests: the what-if and the badge

test a_wish_makes_a_surface_makeable_and_drops_the_badge_to_demo_and_comes_back {
    let base : PfvState = pfv_ask(I_TOPIC_MAP);
    let w : PfvState = pfv_apply(base, PFV_EV_WISH, SF_MAP_VIDEO, 0);
    assert w.wish == SF_MAP_VIDEO;
    assert w.viz.revision == base.viz.revision + 1;
    assert pfv_answer(base) == SF_MAP_STILL;
    assert pfv_answer(w) == SF_MAP_VIDEO;
    assert pfv_is_stand_in(w) == false;
    assert pfv_badge(base) == VIZ_TRUTH_VERIFIED;
    assert pfv_badge(w) == VIZ_TRUTH_DEMO;
    assert viz_may_claim(pfv_badge(w)) == false;
    // The wish moves one column only: the wanted surface is shown, its stand-in goes quiet.
    assert pfv_cell(base, SF_MAP_VIDEO, I_TOPIC_MAP) == PFV_CELL_WANTED;
    assert pfv_cell(w, SF_MAP_VIDEO, I_TOPIC_MAP) == PFV_CELL_ANSWERS;
    assert pfv_cell(base, SF_MAP_STILL, I_TOPIC_MAP) == PFV_CELL_STAND_IN;
    assert pfv_cell(w, SF_MAP_STILL, I_TOPIC_MAP) == PFV_CELL_QUIET;
    var k : u32 = 0;
    while (k < pfv_intents()) {
        if (k != I_TOPIC_MAP) {
            assert pfv_shown(w, k) == pfv_shown(base, k);
        }
        k = k + 1;
    }
    assert pfv_count_cells(base, PFV_CELL_ANSWERS) == 5;
    assert pfv_count_cells(w, PFV_CELL_ANSWERS) == 6;
    assert pfv_count_cells(w, PFV_CELL_STAND_IN) == 3;
    assert pfv_count_cells(w, PFV_CELL_WANTED) == 6;
    assert pfv_count_cells(w, PFV_CELL_QUIET) == 180;
    // Clearing the wish returns the source's answer and the badge with it; so does any non-surface.
    let c : PfvState = pfv_apply(w, PFV_EV_WISH, SF_NONE, 0);
    assert c.wish == SF_NONE;
    assert pfv_answer(c) == SF_MAP_STILL;
    assert pfv_badge(c) == VIZ_TRUTH_VERIFIED;
    assert pfv_apply(w, PFV_EV_WISH, 99, 0).wish == SF_NONE;
    // A wish on a surface that is already makeable changes no answer, and is still not the source's data.
    let same : PfvState = pfv_apply(pfv_open(), PFV_EV_WISH, SF_GRAPH, 0);
    var j : u32 = 0;
    while (j < pfv_intents()) {
        assert pfv_shown(same, j) == pfv_shown(pfv_open(), j);
        j = j + 1;
    }
    assert pfv_badge(same) == VIZ_TRUTH_DEMO;
    // A wish on a surface no intent wants changes no answer either.
    assert pfv_answer(pfv_apply(pfv_ask(I_SPEC_WORDS), PFV_EV_WISH, SF_PREVIEW, 0)) == SF_OUTLINE;
}

test the_other_intent_is_outside_the_source_so_it_answers_nothing_and_reads_demo {
    let o : PfvState = pfv_ask(I_COUNT);
    assert o.viz.param == I_COUNT;
    assert pfv_want(o, I_COUNT) == SF_NONE;
    assert pfv_answer(o) == SF_NONE;
    assert pfv_wanted(o) == SF_NONE;
    assert pfv_in_source(o) == false;
    assert pfv_badge(o) == VIZ_TRUTH_DEMO;
    assert viz_may_claim(pfv_badge(o)) == false;
    assert pfv_claims(o) == false;
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_cell(o, i, I_COUNT) == PFV_CELL_QUIET;
        assert pfv_row_lit(o, i) == false;
        i = i + 1;
    }
    assert pfv_col_lit(o, I_COUNT);
    // Asking a listed intent again returns to the source's data.
    assert pfv_in_source(pfv_choose(o, I_HEALTH));
    assert pfv_badge(pfv_choose(o, I_HEALTH)) == VIZ_TRUTH_VERIFIED;
    assert pfv_answer(pfv_choose(o, I_HEALTH)) == SF_DASHBOARD;
}

test the_badge_is_verified_on_the_sources_data_and_demo_once_the_input_leaves_it {
    let p0 : PfvState = pfv_open();
    assert pfv_badge(p0) == VIZ_TRUTH_VERIFIED;
    assert pfv_claims(p0);
    // Every listed intent on every host is the source's own rule over its own data.
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        var k : u32 = 0;
        while (k < I_COUNT) {
            assert pfv_badge(pfv_ask_on(h as u8, k)) == VIZ_TRUTH_VERIFIED;
            k = k + 1;
        }
        h = h + 1;
    }
    // Leaving it: the unlisted intent, or a wish.
    let w : PfvState = pfv_apply(p0, PFV_EV_WISH, SF_PETAL_MENU, 0);
    assert pfv_badge(w) == VIZ_TRUTH_DEMO;
    assert pfv_claims(w) == false;
    // Hovering, selecting and a host change stay on the data, so they never touch the badge.
    var q : PfvState = pfv_on(HOST_SITE);
    q = pfv_apply(q, VIZ_EV_SELECT, pfv_surface_ref(4), 0);
    q = pfv_apply(q, VIZ_EV_HOVER, pfv_cell_ref(2, 3), 0);
    assert pfv_badge(q) == VIZ_TRUTH_VERIFIED;
    // Both at once: clearing one does not clear the other.
    let both : PfvState = pfv_apply(pfv_ask(I_COUNT), PFV_EV_WISH, SF_CHECK, 0);
    assert pfv_badge(both) == VIZ_TRUTH_DEMO;
    assert pfv_badge(pfv_choose(both, I_PR)) == VIZ_TRUTH_DEMO;
    assert pfv_badge(pfv_apply(both, PFV_EV_WISH, SF_NONE, 0)) == VIZ_TRUTH_DEMO;
    assert pfv_badge(pfv_apply(pfv_choose(both, I_PR), PFV_EV_WISH, SF_NONE, 0)) == VIZ_TRUTH_VERIFIED;
}

test the_badge_keeps_a_truth_that_cannot_claim_and_never_goes_above_verified {
    assert pfv_badge(pfv_open_with(pfv_items(), VIZ_TRUTH_CACHED)) == VIZ_TRUTH_CACHED;
    assert pfv_badge(pfv_open_with(pfv_items(), VIZ_TRUTH_DEMO)) == VIZ_TRUTH_DEMO;
    assert pfv_badge(pfv_open_with(pfv_items(), VIZ_TRUTH_UNKNOWN)) == VIZ_TRUTH_UNKNOWN;
    // A cached view is not relabelled DEMO by the wish or by the unlisted intent either.
    let c : PfvState = pfv_apply(pfv_open_with(pfv_items(), VIZ_TRUTH_CACHED), PFV_EV_WISH, SF_CHECK, 0);
    assert pfv_badge(c) == VIZ_TRUTH_CACHED;
    assert pfv_badge(pfv_choose(pfv_open_with(pfv_items(), VIZ_TRUTH_CACHED), I_COUNT)) == VIZ_TRUTH_CACHED;
    // No host feeds the petal, so a stored LIVE is shown as VERIFIED, never above it.
    assert pfv_badge(pfv_open_with(pfv_items(), VIZ_TRUTH_LIVE)) == VIZ_TRUTH_VERIFIED;
    // A truth code outside the table reads as UNKNOWN, not as LIVE.
    assert pfv_badge(pfv_open_with(pfv_items(), 9)) == VIZ_TRUTH_UNKNOWN;
}

; ---------------------------------------------------------------- tests: cells

test cells_follow_the_hand_table_for_every_surface_and_intent {
    let p : PfvState = pfv_open();
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        var k : u32 = 0;
        while (k < pfv_intents()) {
            let want : u32 = PFV_HAND_WANT[k as usize];
            let shown : u32 = PFV_HAND_SHOWN[k as usize];
            var e : u8 = PFV_CELL_QUIET;
            if (i == want) {
                e = PFV_CELL_WANTED;
            }
            if (i == shown) {
                e = PFV_CELL_STAND_IN;
            }
            if (i == shown and i == want) {
                e = PFV_CELL_ANSWERS;
            }
            assert pfv_cell(p, i, k) == e;
            k = k + 1;
        }
        i = i + 1;
    }
    // The cells a reader will look for first.
    assert pfv_cell(p, SF_GRAPH, I_SPEC_SHAPE) == PFV_CELL_ANSWERS;
    assert pfv_cell(p, SF_MAP_VIDEO, I_TOPIC_MAP) == PFV_CELL_WANTED;
    assert pfv_cell(p, SF_MAP_STILL, I_TOPIC_MAP) == PFV_CELL_STAND_IN;
    assert pfv_cell(p, SF_GRAPH, I_PR) == PFV_CELL_STAND_IN;
    assert pfv_cell(p, SF_CHECK, I_PR) == PFV_CELL_WANTED;
    assert pfv_cell(p, SF_UI_PLAN, I_APP) == PFV_CELL_WANTED;
    assert pfv_cell(p, SF_STILL, I_SPEC_SHAPE) == PFV_CELL_QUIET;
    // On the site the graph page is the answer to the shape of a spec and the graph goes quiet.
    let site : PfvState = pfv_on(HOST_SITE);
    assert pfv_cell(site, SF_GRAPH_PAGE, I_SPEC_SHAPE) == PFV_CELL_ANSWERS;
    assert pfv_cell(site, SF_GRAPH, I_SPEC_SHAPE) == PFV_CELL_QUIET;
    assert pfv_cell(site, SF_GRAPH, I_PR) == PFV_CELL_STAND_IN;
}

test the_cell_counts_are_the_same_on_every_host_and_cover_the_whole_matrix {
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        let p : PfvState = pfv_on(h as u8);
        assert pfv_count_cells(p, PFV_CELL_ANSWERS) == 5;
        assert pfv_count_cells(p, PFV_CELL_STAND_IN) == 4;
        assert pfv_count_cells(p, PFV_CELL_WANTED) == 7;
        assert pfv_count_cells(p, PFV_CELL_QUIET) == 179;
        assert pfv_count_cells(p, PFV_CELL_NONE) == 0;
        h = h + 1;
    }
    // Off the shape column, the site's matrix is the desktop's.
    let site : PfvState = pfv_on(HOST_SITE);
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        var k : u32 = 1;
        while (k < pfv_intents()) {
            assert pfv_cell(site, i, k) == pfv_cell(pfv_open(), i, k);
            k = k + 1;
        }
        i = i + 1;
    }
    // The matrix has 15 x 13 cells, no more.
    assert pfv_surfaces() * pfv_intents() == 195;
    assert pfv_cell(pfv_open(), SF_COUNT, 0) == PFV_CELL_NONE;
    assert pfv_cell(pfv_open(), 0, pfv_intents()) == PFV_CELL_NONE;
}

test the_matrix_the_list_and_the_choice_agree_on_the_answer_for_every_host_and_intent {
    var h : u32 = 0;
    while (h < pfv_hosts()) {
        var k : u32 = 0;
        while (k < pfv_intents()) {
            let p : PfvState = pfv_ask_on(h as u8, k);
            let a : u32 = pfv_answer(p);
            var lit : u32 = 0;
            var shown_cells : u32 = 0;
            var wanted_cells : u32 = 0;
            var s : u32 = 0;
            while (s < pfv_surfaces()) {
                if (pfv_row_lit(p, s)) {
                    lit = lit + 1;
                    assert s == a;
                }
                let c : u8 = pfv_cell(p, s, k);
                if (c == PFV_CELL_ANSWERS or c == PFV_CELL_STAND_IN) {
                    shown_cells = shown_cells + 1;
                    assert s == a;
                    assert pfv_line_made(s);
                }
                if (c == PFV_CELL_WANTED) {
                    wanted_cells = wanted_cells + 1;
                    assert s == pfv_wanted(p);
                    assert pfv_line_made(s) == false;
                }
                s = s + 1;
            }
            // The light, the shown cell and the answer are one surface, or all nothing.
            if (a == SF_NONE) {
                assert lit == 0;
                assert shown_cells == 0;
            } else {
                assert lit == 1;
                assert shown_cells == 1;
            }
            // A wanted-only cell exists exactly when the intent wants a surface that is not shown.
            if (pfv_wanted(p) != SF_NONE and pfv_wanted(p) != a) {
                assert wanted_cells == 1;
            } else {
                assert wanted_cells == 0;
            }
            assert pfv_col_lit(p, k);
            k = k + 1;
        }
        h = h + 1;
    }
}

; ---------------------------------------------------------------- tests: refs, focus, motion

test a_ref_outside_the_fixture_names_no_surface_intent_or_cell {
    assert pfv_ref_surface(VIZ_REF_NONE) == VIZ_NO_INDEX;
    assert pfv_ref_intent(VIZ_REF_NONE) == VIZ_NO_INDEX;
    assert pfv_ref_surface(viz_ref(VIZ_ENT_NODE, pfv_surfaces())) == VIZ_NO_INDEX;
    assert pfv_ref_intent(viz_ref(VIZ_ENT_EDGE, pfv_intents())) == VIZ_NO_INDEX;
    // A cell in the stride but past the last intent, and a cell past the last surface.
    assert pfv_ref_surface(viz_ref(VIZ_ENT_CELL, pfv_intents())) == VIZ_NO_INDEX;
    assert pfv_ref_intent(viz_ref(VIZ_ENT_CELL, pfv_intents())) == VIZ_NO_INDEX;
    assert pfv_ref_surface(viz_ref(VIZ_ENT_CELL, pfv_surfaces() * PFV_STRIDE)) == VIZ_NO_INDEX;
    // A surface ref is no intent, an intent ref is no surface.
    assert pfv_ref_intent(pfv_surface_ref(0)) == VIZ_NO_INDEX;
    assert pfv_ref_surface(pfv_intent_ref(0)) == VIZ_NO_INDEX;
    // The constructors refuse numbers past the fixture.
    assert pfv_surface_ref(pfv_surfaces()) == VIZ_REF_NONE;
    assert pfv_intent_ref(pfv_intents()) == VIZ_REF_NONE;
    assert pfv_cell_ref(pfv_surfaces(), 0) == VIZ_REF_NONE;
    assert pfv_cell_ref(0, pfv_intents()) == VIZ_REF_NONE;
    // Selecting such a ref is stored by the reducer but lights nothing in any view.
    let bad : u32 = viz_ref(VIZ_ENT_NODE, pfv_surfaces());
    let s : PfvState = pfv_apply(pfv_open(), VIZ_EV_SELECT, bad, 0);
    assert s.viz.selected == bad;
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_row_hl(s.viz, i) == VIZ_HL_NONE;
        i = i + 1;
    }
    var k : u32 = 0;
    while (k < pfv_intents()) {
        assert pfv_col_hl(s.viz, k) == VIZ_HL_NONE;
        k = k + 1;
    }
    assert pfv_cell_hl(s.viz, pfv_surfaces(), 0) == VIZ_HL_NONE;
    assert pfv_cell_hl(s.viz, 0, pfv_intents()) == VIZ_HL_NONE;
    assert pfv_row_hl(pfv_apply(pfv_open(), VIZ_EV_SELECT, pfv_surface_ref(1), 0).viz, pfv_surfaces()) == VIZ_HL_NONE;
    // Clicking nothing, or a ref that is no entity, is ignored.
    assert viz_same(pfv_click(pfv_open(), VIZ_REF_NONE).viz, pfv_open().viz);
    assert viz_same(pfv_click(pfv_open(), bad).viz, pfv_open().viz);
}

test refs_pack_and_unpack_surface_intent_and_cell {
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_ref_surface(pfv_surface_ref(i)) == i;
        assert viz_ref_kind(pfv_surface_ref(i)) == VIZ_ENT_NODE;
        assert pfv_ref_intent(pfv_surface_ref(i)) == VIZ_NO_INDEX;
        var k : u32 = 0;
        while (k < pfv_intents()) {
            assert pfv_ref_surface(pfv_cell_ref(i, k)) == i;
            assert pfv_ref_intent(pfv_cell_ref(i, k)) == k;
            assert viz_ref_kind(pfv_cell_ref(i, k)) == VIZ_ENT_CELL;
            k = k + 1;
        }
        i = i + 1;
    }
    var m : u32 = 0;
    while (m < pfv_intents()) {
        assert pfv_ref_intent(pfv_intent_ref(m)) == m;
        assert viz_ref_kind(pfv_intent_ref(m)) == VIZ_ENT_EDGE;
        assert pfv_ref_surface(pfv_intent_ref(m)) == VIZ_NO_INDEX;
        m = m + 1;
    }
    assert pfv_cell_ref(1, 0) == pfv_cell_ref(0, 0) + PFV_STRIDE;
    assert pfv_cell_ref(0, 1) == pfv_cell_ref(0, 0) + 1;
}

test focus_walks_every_surface_then_every_intent_forward_and_wraps {
    var p : PfvState = pfv_open();
    var f : u32 = 0;
    while (f < pfv_items()) {
        p = pfv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == f;
        assert viz_is_focused(p.viz, f);
        if (f < pfv_surfaces()) {
            assert pfv_focus_ref(p, p.viz.focus) == pfv_surface_ref(f);
        } else {
            assert pfv_focus_ref(p, p.viz.focus) == pfv_intent_ref(f - pfv_surfaces());
        }
        f = f + 1;
    }
    p = pfv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    assert pfv_focus_ref(p, 0) == pfv_surface_ref(0);
    assert pfv_focus_ref(p, pfv_items()) == VIZ_REF_NONE;
}

test focus_walks_backwards_from_the_last_intent_and_wraps {
    var p : PfvState = pfv_apply(pfv_open(), VIZ_EV_FOCUS_PREV, 0, 0);
    assert p.viz.focus == pfv_items() - 1;
    assert pfv_focus_ref(p, p.viz.focus) == pfv_intent_ref(pfv_intents() - 1);
    var n : u32 = 1;
    while (n < pfv_items()) {
        p = pfv_apply(p, VIZ_EV_FOCUS_PREV, 0, 0);
        n = n + 1;
    }
    assert p.viz.focus == 0;
    assert pfv_focus_ref(p, 0) == pfv_surface_ref(0);
    p = pfv_apply(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert p.viz.focus == pfv_items() - 1;
}

test activate_selects_a_surface_and_asks_an_intent {
    var p : PfvState = pfv_open();
    var k : u32 = 0;
    while (k < 4) {
        p = pfv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        k = k + 1;
    }
    p = pfv_activate(p);
    assert p.viz.selected == pfv_surface_ref(3);
    assert pfv_row_hl(p.viz, 3) == VIZ_HL_SELECT;
    p = pfv_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    assert pfv_row_hl(p.viz, 3) == VIZ_HL_NONE;
    // Focus on the intent for a pull request: Enter asks it, and does not select anything.
    while (p.viz.focus < pfv_surfaces() + I_PR) {
        p = pfv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    }
    assert pfv_focus_ref(p, p.viz.focus) == pfv_intent_ref(I_PR);
    p = pfv_activate(p);
    assert p.viz.param == I_PR;
    assert p.viz.selected == VIZ_REF_NONE;
    assert pfv_answer(p) == pick(I_PR, HOST_CLAUDE_CODE_DESKTOP);
    assert pfv_answer(p) == SF_GRAPH;
    assert pfv_badge(p) == VIZ_TRUTH_VERIFIED;
    // Nothing focused: activating changes nothing, not even the revision.
    assert viz_same(pfv_activate(pfv_open()).viz, pfv_open().viz);
    assert pfv_activate(pfv_open()).viz.revision == pfv_open().viz.revision;
}

test reduced_motion_makes_the_answer_light_hold_still {
    // Intent 0 shows the graph, intent 3 the particle reel: the light has to move.
    let a : PfvState = pfv_ask(I_SPEC_SHAPE);
    let b : PfvState = pfv_choose(a, I_LESSON);
    assert pfv_relight_ms(a, b) == PFV_LIGHT_MS;
    // Intents 5 and 6 both show the graph on the desktop: the light stays where it is.
    let x : PfvState = pfv_ask(I_PR);
    let y : PfvState = pfv_choose(x, I_EDITING);
    assert pfv_answer(x) == pfv_answer(y);
    assert pfv_relight_ms(x, y) == 0;
    // Under reduced motion the move takes no time.
    let r : PfvState = pfv_apply(a, VIZ_EV_MOTION, 1, 0);
    let rb : PfvState = pfv_choose(r, I_LESSON);
    assert rb.viz.reduced_motion == 1;
    assert pfv_relight_ms(r, rb) == 0;
    // Turning the preference off brings the animation back.
    let back : PfvState = pfv_apply(rb, VIZ_EV_MOTION, 0, 0);
    assert back.viz.reduced_motion == 0;
    assert pfv_relight_ms(r, back) == PFV_LIGHT_MS;
    // The preference applies before the petal has loaded, and a reload does not forget it.
    let early : PfvState = pfv_apply(pfv_idle(), VIZ_EV_MOTION, 1, 0);
    assert early.viz.reduced_motion == 1;
    let reloaded : PfvState = pfv_apply(pfv_apply(early, VIZ_EV_LOAD, 0, 0), VIZ_EV_LOADED, pfv_items(), VIZ_TRUTH_VERIFIED as u32);
    assert reloaded.viz.reduced_motion == 1;
    assert pfv_relight_ms(reloaded, pfv_choose(reloaded, I_LESSON)) == 0;
}

; ---------------------------------------------------------------- tests: linked views

test hovering_or_selecting_a_surface_lights_its_row_and_its_list_line_alike {
    var p : PfvState = pfv_apply(pfv_open(), VIZ_EV_HOVER, pfv_surface_ref(5), 0);
    p = pfv_apply(p, VIZ_EV_SELECT, pfv_surface_ref(9), 0);
    assert pfv_row_hl(p.viz, 5) == VIZ_HL_HOVER;
    assert pfv_row_hl(p.viz, 9) == VIZ_HL_SELECT;
    // The matrix and the list read the same state: every cell of a row carries the row's highlight,
    // and the row agrees with the contract's own highlight of that surface.
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_row_hl(p.viz, i) == viz_highlight(p.viz, pfv_surface_ref(i));
        var k : u32 = 0;
        while (k < pfv_intents()) {
            assert pfv_cell_hl(p.viz, i, k) == pfv_row_hl(p.viz, i);
            k = k + 1;
        }
        i = i + 1;
    }
    assert pfv_row_hl(p.viz, 6) == VIZ_HL_NONE;
    // Selecting the selected surface again clears it, the pointer leaving clears the hover, and BACK clears
    // a selection.
    p = pfv_apply(p, VIZ_EV_SELECT, pfv_surface_ref(9), 0);
    assert pfv_row_hl(p.viz, 9) == VIZ_HL_NONE;
    p = pfv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert pfv_row_hl(p.viz, 5) == VIZ_HL_NONE;
    p = pfv_apply(p, VIZ_EV_SELECT, pfv_surface_ref(2), 0);
    assert pfv_row_hl(p.viz, 2) == VIZ_HL_SELECT;
    p = pfv_apply(p, VIZ_EV_BACK, 0, 0);
    assert pfv_row_hl(p.viz, 2) == VIZ_HL_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
}

test an_intent_lights_its_column_only_and_a_cell_lights_its_row_and_its_column {
    let st : PfvState = pfv_apply(pfv_open(), VIZ_EV_SELECT, pfv_intent_ref(2), 0);
    assert pfv_col_hl(st.viz, 2) == VIZ_HL_SELECT;
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_cell_hl(st.viz, i, 2) == VIZ_HL_SELECT;
        assert pfv_cell_hl(st.viz, i, 3) == VIZ_HL_NONE;
        assert pfv_row_hl(st.viz, i) == VIZ_HL_NONE;
        i = i + 1;
    }
    // Selecting an intent lights its column; it does not ask it. Asking is the choice's job.
    assert st.viz.param == I_SPEC_SHAPE;
    // A selected cell lights its whole row, its whole column and its list line.
    var s : PfvState = pfv_apply(pfv_open(), VIZ_EV_SELECT, pfv_cell_ref(7, 3), 0);
    assert pfv_row_hl(s.viz, 7) == VIZ_HL_SELECT;
    assert pfv_col_hl(s.viz, 3) == VIZ_HL_SELECT;
    assert pfv_cell_hl(s.viz, 7, 0) == VIZ_HL_SELECT;
    assert pfv_cell_hl(s.viz, 0, 3) == VIZ_HL_SELECT;
    assert pfv_cell_hl(s.viz, 6, 2) == VIZ_HL_NONE;
    // A hovered cell elsewhere adds a hover cross; where the two crosses meet, selection wins.
    s = pfv_apply(s, VIZ_EV_HOVER, pfv_cell_ref(1, 4), 0);
    assert pfv_cell_hl(s.viz, 1, 4) == VIZ_HL_HOVER;
    assert pfv_cell_hl(s.viz, 1, 3) == VIZ_HL_SELECT;
    assert pfv_cell_hl(s.viz, 7, 4) == VIZ_HL_SELECT;
    assert pfv_cell_hl(s.viz, 1, 0) == VIZ_HL_HOVER;
    assert pfv_cell_hl(s.viz, 0, 0) == VIZ_HL_NONE;
}

test the_answer_light_follows_the_choice_in_the_matrix_the_list_and_the_choice {
    var p : PfvState = pfv_open();
    // Intent 0: the graph answers. Its row and the intent's column carry the light.
    assert pfv_row_lit(p, SF_GRAPH);
    assert pfv_row_lit(p, SF_OUTLINE) == false;
    assert pfv_col_lit(p, I_SPEC_SHAPE);
    assert pfv_col_lit(p, I_SPEC_WORDS) == false;
    // Ask the health of the corpus: the light moves to the dashboard row and the health column.
    p = pfv_choose(p, I_HEALTH);
    assert pfv_row_lit(p, SF_DASHBOARD);
    assert pfv_row_lit(p, SF_GRAPH) == false;
    assert pfv_col_lit(p, I_HEALTH);
    assert pfv_col_lit(p, I_SPEC_SHAPE) == false;
    // The OS home: the petal menu is wanted, nothing can be made, so no row is lit but the column is.
    p = pfv_choose(p, I_OS_HOME);
    assert pfv_cell(p, SF_PETAL_MENU, I_OS_HOME) == PFV_CELL_WANTED;
    assert pfv_row_lit(p, SF_PETAL_MENU) == false;
    assert pfv_count_cells(p, PFV_CELL_ANSWERS) == 5;
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_row_lit(p, i) == false;
        i = i + 1;
    }
    assert pfv_col_lit(p, I_OS_HOME);
    // Out of range rows and columns are never lit.
    assert pfv_row_lit(p, pfv_surfaces()) == false;
    assert pfv_row_lit(p, SF_NONE) == false;
    assert pfv_col_lit(p, pfv_intents()) == false;
}

; ---------------------------------------------------------------- tests: layout, hit tests, host

test matrix_list_and_choice_hit_back_at_the_entities_they_draw {
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert pfv_cell_y(i) == pfv_line_y(i);
        assert pfv_list_hit(PFV_LIST_X + 10, pfv_line_y(i) + 5) == pfv_surface_ref(i);
        assert pfv_list_hit(PFV_LIST_X + PFV_LIST_W - 1, pfv_line_y(i) + PFV_CELL_H - 1) == pfv_surface_ref(i);
        var k : u32 = 0;
        while (k < pfv_intents()) {
            assert pfv_matrix_hit(pfv_cell_x(k) + PFV_CELL_W / 2, pfv_cell_y(i) + PFV_CELL_H / 2) == pfv_cell_ref(i, k);
            assert pfv_matrix_hit(pfv_cell_x(k), pfv_cell_y(i)) == pfv_cell_ref(i, k);
            assert pfv_matrix_hit(pfv_cell_x(k) + PFV_CELL_W - 1, pfv_cell_y(i) + PFV_CELL_H - 1) == pfv_cell_ref(i, k);
            k = k + 1;
        }
        i = i + 1;
    }
    var m : u32 = 0;
    while (m < pfv_intents()) {
        assert pfv_choice_x(m) == pfv_cell_x(m);
        assert pfv_choice_hit(pfv_choice_x(m) + PFV_CELL_W / 2, PFV_CHOICE_Y + 20) == pfv_intent_ref(m);
        assert pfv_choice_hit(pfv_choice_x(m), PFV_CHOICE_Y) == pfv_intent_ref(m);
        assert pfv_choice_hit(pfv_choice_x(m) + PFV_CELL_W - 1, PFV_CHOICE_Y + PFV_CHOICE_H - 1) == pfv_intent_ref(m);
        m = m + 1;
    }
    // Just outside each view is nothing.
    assert pfv_matrix_hit(PFV_MATRIX_X - 1, PFV_MATRIX_Y) == VIZ_REF_NONE;
    assert pfv_matrix_hit(PFV_MATRIX_X, PFV_MATRIX_Y - 1) == VIZ_REF_NONE;
    assert pfv_matrix_hit(pfv_cell_x(pfv_intents()), pfv_cell_y(0)) == VIZ_REF_NONE;
    assert pfv_matrix_hit(pfv_cell_x(0), pfv_cell_y(pfv_surfaces())) == VIZ_REF_NONE;
    assert pfv_list_hit(PFV_LIST_X - 1, PFV_LIST_Y) == VIZ_REF_NONE;
    assert pfv_list_hit(PFV_LIST_X + PFV_LIST_W, PFV_LIST_Y) == VIZ_REF_NONE;
    assert pfv_list_hit(PFV_LIST_X, pfv_line_y(pfv_surfaces())) == VIZ_REF_NONE;
    assert pfv_choice_hit(PFV_CHOICE_X - 1, PFV_CHOICE_Y) == VIZ_REF_NONE;
    assert pfv_choice_hit(pfv_choice_x(pfv_intents()), PFV_CHOICE_Y) == VIZ_REF_NONE;
    assert pfv_choice_hit(PFV_CHOICE_X, PFV_CHOICE_Y - 1) == VIZ_REF_NONE;
    assert pfv_choice_hit(PFV_CHOICE_X, PFV_CHOICE_Y + PFV_CHOICE_H) == VIZ_REF_NONE;
    // A point in the matrix is not in the list or on the choice, and a point in the list is not in the matrix.
    assert pfv_list_hit(PFV_MATRIX_X + 5, PFV_MATRIX_Y + 5) == VIZ_REF_NONE;
    assert pfv_choice_hit(PFV_MATRIX_X + 5, PFV_MATRIX_Y + 5) == VIZ_REF_NONE;
    assert pfv_matrix_hit(PFV_LIST_X + 5, PFV_LIST_Y + 5) == VIZ_REF_NONE;
}

test a_click_in_any_view_goes_through_the_one_reducer {
    var p : PfvState = pfv_open();
    let r0 : u32 = p.viz.revision;
    // Click the health option on the choice, then a cell in the matrix, then a line in the list.
    p = pfv_click(p, pfv_choice_hit(pfv_choice_x(I_HEALTH) + 5, PFV_CHOICE_Y + 5));
    assert p.viz.param == I_HEALTH;
    assert p.viz.selected == VIZ_REF_NONE;
    assert pfv_answer(p) == SF_DASHBOARD;
    p = pfv_click(p, pfv_matrix_hit(pfv_cell_x(2) + 5, pfv_cell_y(9) + 5));
    assert p.viz.selected == pfv_cell_ref(9, 2);
    assert pfv_row_hl(p.viz, 9) == VIZ_HL_SELECT;
    assert pfv_col_hl(p.viz, 2) == VIZ_HL_SELECT;
    p = pfv_click(p, pfv_list_hit(PFV_LIST_X + 5, pfv_line_y(11) + 5));
    assert p.viz.selected == pfv_surface_ref(11);
    assert pfv_row_hl(p.viz, 9) == VIZ_HL_NONE;
    assert pfv_row_hl(p.viz, 11) == VIZ_HL_SELECT;
    // Three accepted inputs, three revisions, and the answer follows the choice alone.
    assert p.viz.revision == r0 + 3;
    assert pfv_answer(p) == SF_DASHBOARD;
    // Clicking the same line again clears it; clicking the same option again changes nothing.
    p = pfv_click(p, pfv_list_hit(PFV_LIST_X + 5, pfv_line_y(11) + 5));
    assert p.viz.selected == VIZ_REF_NONE;
    let again : PfvState = pfv_click(p, pfv_intent_ref(I_HEALTH));
    assert again.viz.revision == p.viz.revision;
}

test the_host_validates_and_places_the_badge_the_choice_the_matrix_and_the_list {
    let h : VizHost = pfv_host();
    assert h.count == PFV_SLOTS;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_CHOICE;
    assert h.rep[2] == VIZ_REP_MATRIX;
    assert h.rep[3] == VIZ_REP_LIST;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[1] == VH_ROOT;
    assert h.parent[2] == VH_ROOT;
    assert h.parent[3] == VH_ROOT;
    // The slot rects are the layout: one option per intent, a 13 x 15 grid, one line per surface.
    assert h.x[1] == PFV_CHOICE_X;
    assert h.w[1] == pfv_intents() * PFV_CELL_W;
    assert h.x[2] == PFV_MATRIX_X;
    assert h.y[2] == PFV_MATRIX_Y;
    assert h.w[2] == h.w[1];
    assert h.h[2] == pfv_surfaces() * PFV_CELL_H;
    assert h.h[3] == h.h[2];
    assert h.y[3] == h.y[2];
    // A point in each slot lands in that slot. The gaps and the outside are nothing.
    assert vh_hit(h, PFV_BADGE_X + 5, PFV_BADGE_Y + 5) == PFV_SLOT_BADGE;
    assert vh_hit(h, PFV_CHOICE_X + 5, PFV_CHOICE_Y + 5) == PFV_SLOT_CHOICE;
    assert vh_hit(h, PFV_MATRIX_X + 5, PFV_MATRIX_Y + 5) == PFV_SLOT_MATRIX;
    assert vh_hit(h, PFV_LIST_X + 5, PFV_LIST_Y + 5) == PFV_SLOT_LIST;
    assert vh_hit(h, 5, 5) == VH_NONE;
    assert vh_hit(h, PFV_BADGE_X + PFV_BADGE_W, PFV_BADGE_Y) == VH_NONE;
    assert vh_hit(h, PFV_CHOICE_X + h.w[1], PFV_CHOICE_Y) == VH_NONE;
    assert vh_hit(h, PFV_MATRIX_X + 5, PFV_CHOICE_Y + PFV_CHOICE_H) == VH_NONE;
    assert vh_hit(h, PFV_LIST_X + PFV_LIST_W, PFV_LIST_Y) == VH_NONE;
    // Every cell centre is in the matrix slot, every list line in the list slot, every option in the choice.
    var i : u32 = 0;
    while (i < pfv_surfaces()) {
        assert vh_hit(h, PFV_LIST_X + 10, pfv_line_y(i) + 5) == PFV_SLOT_LIST;
        var k : u32 = 0;
        while (k < pfv_intents()) {
            assert vh_hit(h, pfv_cell_x(k) + 15, pfv_cell_y(i) + 12) == PFV_SLOT_MATRIX;
            k = k + 1;
        }
        i = i + 1;
    }
    var m : u32 = 0;
    while (m < pfv_intents()) {
        assert vh_hit(h, pfv_choice_x(m) + 15, PFV_CHOICE_Y + 20) == PFV_SLOT_CHOICE;
        m = m + 1;
    }
}

test the_host_focus_visits_each_slot_in_order_and_wraps {
    let h : VizHost = pfv_host();
    var f : u32 = vh_focus_next(h, VH_NONE);
    assert f == PFV_SLOT_BADGE;
    f = vh_focus_next(h, f);
    assert f == PFV_SLOT_CHOICE;
    f = vh_focus_next(h, f);
    assert f == PFV_SLOT_MATRIX;
    f = vh_focus_next(h, f);
    assert f == PFV_SLOT_LIST;
    f = vh_focus_next(h, f);
    assert f == PFV_SLOT_BADGE;
    assert vh_focus_next(vh_blank(), 0) == VH_NONE;
}

test the_petal_embeds_in_a_larger_host_and_keeps_its_slots {
    var frame : VizHost = vh_blank();
    frame = vh_add(frame, VIZ_REP_TEXT, VH_ROOT, 5, 5, 1000, 800);
    let e : VizHost = pfv_in_frame(frame, 0, 10, 20);
    assert e.count == 1 + PFV_SLOTS;
    assert vh_validate(e) == VH_OK;
    assert e.rep[0] == VIZ_REP_TEXT;
    assert e.rep[1] == VIZ_REP_BADGE;
    assert e.rep[2] == VIZ_REP_CHOICE;
    assert e.rep[3] == VIZ_REP_MATRIX;
    assert e.rep[4] == VIZ_REP_LIST;
    assert e.parent[1] == 0;
    assert e.parent[4] == 0;
    // The petal's slots moved by the offset, and by the frame's own corner in absolute terms.
    assert e.x[3] == PFV_MATRIX_X + 10;
    assert e.y[3] == PFV_MATRIX_Y + 20;
    assert vh_abs_x(e, 3) == 5 + PFV_MATRIX_X + 10;
    assert vh_abs_y(e, 3) == 5 + PFV_MATRIX_Y + 20;
    assert vh_depth(e, 0) == 1;
    assert vh_depth(e, 3) == 2;
    assert vh_hit(e, vh_abs_x(e, 3) + 5, vh_abs_y(e, 3) + 5) == 3;
    assert vh_hit(e, vh_abs_x(e, 2) + 5, vh_abs_y(e, 2) + 5) == 2;
    // The petal's own host is unchanged by being embedded.
    assert pfv_host().count == PFV_SLOTS;
    assert pfv_host().x[2] == PFV_MATRIX_X;
}

; ---------------------------------------------------------------- tests: agreement with the plan

test the_petal_reps_equal_the_plan_row_and_pass_the_plan_check {
    let reps : u32 = pfv_reps();
    // MATRIX 2 + LIST 4 + CHOICE 128 + BADGE 256.
    assert reps == 390;
    assert reps == pvp_reps(PFV_PETAL);
    assert viz_plan_ok(reps);
    assert viz_is_linked(reps);
    assert viz_view_count(reps) == 2;
    assert (reps & viz_rep_bit(VIZ_REP_BADGE)) != 0;
    assert (reps & viz_rep_bit(VIZ_REP_CHOICE)) != 0;
    assert (reps & viz_rep_bit(VIZ_REP_GRAPH)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_TRACE)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_INSPECTOR)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_STEPPER)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_TEXT)) == 0;
    // The host uses exactly these reps and no others.
    let h : VizHost = pfv_host();
    assert (viz_rep_bit(h.rep[0]) | viz_rep_bit(h.rep[1]) | viz_rep_bit(h.rep[2]) | viz_rep_bit(h.rep[3])) == reps;
    // The truth the plan row names is the truth the petal opens with, and the row is a live one.
    assert pvp_truth(PFV_PETAL) == VIZ_TRUTH_VERIFIED;
    assert pfv_badge(pfv_open()) == pvp_truth(PFV_PETAL);
    assert pvp_status(PFV_PETAL) != PVP_DEFERRED;
    assert pvp_question(PFV_PETAL).len >= 20;
    assert pvp_question(PFV_PETAL)[0] == 87;
    // The source the row names is the frontend law.
    assert pvp_is_spec_path(pvp_source(PFV_PETAL));
    assert pvp_source(PFV_PETAL).len == 23;
    assert pvp_source(PFV_PETAL)[11] == 102;
    assert pvp_source(PFV_PETAL)[12] == 114;
    assert pvp_source(PFV_PETAL)[13] == 111;
}

; ---------------------------------------------------------------- invariants

invariant the_petal_budget_fits_the_contract {
    assert PFV_STRIDE >= pfv_intents();
    assert (pfv_surfaces() - 1) * PFV_STRIDE + pfv_intents() - 1 < VIZ_REF_SPAN;
    assert pfv_items() < VIZ_NO_FOCUS;
    assert pfv_items() == pfv_surfaces() + pfv_intents();
    assert pfv_intents() == I_COUNT + 1;
    assert SF_NONE >= SF_COUNT;
    assert PFV_SLOTS <= VH_MAX_SLOTS;
    assert PFV_CELL_NONE + 1 == PFV_CELL_STATES;
    assert PFV_CELL_ANSWERS < PFV_CELL_STAND_IN;
    assert PFV_CELL_STAND_IN < PFV_CELL_WANTED;
    assert PFV_CELL_WANTED < PFV_CELL_QUIET;
    assert PFV_CELL_QUIET < PFV_CELL_NONE;
    assert PFV_ST_NONE > ST_SPEC;
    assert VIZ_HL_NONE < VIZ_HL_HOVER;
    assert VIZ_HL_HOVER < VIZ_HL_SELECT;
    assert PFV_EV_HOST >= VIZ_EV_COUNT;
    assert PFV_EV_WISH > PFV_EV_HOST;
    assert PFV_CHOICE_X + 13 * PFV_CELL_W <= PFV_BADGE_X;
    assert PFV_MATRIX_X + 13 * PFV_CELL_W <= PFV_LIST_X;
    assert PFV_CHOICE_Y + PFV_CHOICE_H <= PFV_MATRIX_Y;
}
