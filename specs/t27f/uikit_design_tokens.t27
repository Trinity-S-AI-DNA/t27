// specs/t27f/uikit_design_tokens.t27 -- uikit design tokens for theme
// contract.
// Part of M1 (milestone #5). Closes #14081.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::uikit_design_tokens;

pub const UIKIT_DESIGN_TOKEN_BACKGROUND : str = "#000000";
pub const UIKIT_DESIGN_TOKEN_TEXT : str = "#ffffff";

pub struct DesignToken { name: str, value: str };

pub fn design_token_value(t: DesignToken) -> str {
    return t.value;
}

test "uikit design token background" {
    assert(UIKIT_DESIGN_TOKEN_BACKGROUND == "#000000");
}

test "uikit design token text" {
    assert(UIKIT_DESIGN_TOKEN_TEXT == "#ffffff");
}

test "design token value" {
    assert(design_token_value(DesignToken { name: "bg", value: "#000000" }) == "#000000");
}

invariant uikit_design_token_background_defined {
    assert UIKIT_DESIGN_TOKEN_BACKGROUND == "#000000";
}