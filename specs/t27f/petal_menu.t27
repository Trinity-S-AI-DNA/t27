// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_menu.t27 -- the 27-petal triangle menu as one spec: the home screen of T27 OS.
; Owner, 2026-10-19: the 27 petals are the visual core of the menu; pressing a petal opens that
; petal's menu; the menu is, for now, an empty frame of cards drawn from the existing widgets; the
; MVP is called T27 OS and its goal is to run on an FPGA. This spec is the T27F surface
; SF_PETAL_MENU of specs/t27f/frontend.t27.
; --
; Where it comes from. The triangle is drawn today in Swift, in gHashTag/trinity
; apps/queen/QueenUI/Widgets/TriangleLogo.swift, which copied its coordinates from
; photon_trinity_canvas.zig. Three tables there each carry a piece of the same rule:
;   TriangleLogo.rawBlocks      the 27 quads
;   TriangleLogo.worlds         the 27 world names shown in the tooltip
;   Screen.screenForBlock       the screen a petal opens
; and they disagree: screenForBlock lists 28 screens for 27 petals (its DUKH row has 10), so its
; last entry (settings) is never reached, and its screens are not the worlds the tooltip names.
; This spec is the one home of the geometry, the names, the hit test, the fills and the open/close
; rule. Hosts (Swift today, the FPGA framebuffer later) draw from it; none keeps its own copy.
; --
; Layers, outermost first:
;   L1 geometry   27 quads, 4 vertices each, in a 596 x 526 box, as integer milli-units.
;   L2 meaning    realm = petal / 9: RAZUM (outer ring, 0-8), MATERIYA (middle, 9-17),
;                 DUKH (inner, 18-26); each ring runs clockwise from the bottom tip.
;   L3 look       idle petals share one translucent black fill (0.22); hover is white; the open petal
;                 takes its realm colour; every outline is white, 1 px. No realm labels.
;   L4 fit        the triangle is fitted to the viewport at 63 percent of the limiting side.
;   L5 input      a ray-cast point-in-quad test turns a tap into a petal, in integers only.
;   L6 state      HOME, or one petal's menu open. A tap on a petal opens it; back returns home.
;   L7 menu       a frame of card slots; a card names a widget of the WIDGETS gallery
;                 (gHashTag/trinity apps/website/specs/widgets/gallery.t27). MVP: every menu empty.
; --
; Integer-only on purpose: no float, no division in the hit test, so the same spec can lower to
; Verilog for the board (gen-verilog) as well as to the desktop hosts. The fit and the card grid
; and the petal centres divide with `/`, never `@divTrunc`: `t27c icarus-lowerable` rejects the builtin call, and `/`
; on i64 truncates towards zero the same way (#10782, M4).
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27fPetalMenu;

pub const PETAL_COUNT : u32 = 27;
pub const PETALS_PER_REALM : u32 = 9;
pub const REALM_COUNT : u32 = 3;
pub const PETAL_NONE : u32 = 255;

pub const REALM_RAZUM : u32 = 0;
pub const REALM_MATERIYA : u32 = 1;
pub const REALM_DUKH : u32 = 2;

/// L1. The box the quads live in, in milli-units (1 unit = 1000).
pub const BOX_W : i64 = 596000;
pub const BOX_H : i64 = 526000;
pub const BOX_CX : i64 = 298000;
pub const BOX_CY : i64 = 263000;

