// SPDX-License-Identifier: Apache-2.0
// specs/t27f/hud.t27 -- T27F Live M3: the HUD as a pure function of the work graph.
// Issue gHashTag/t27#10262 (epic #10266). Design:
// docs/nona-02-organism/t27f/genui-research.md sections 4.4 and 5.
//
// WHY: the live page needs a status bar (agent state, task count, clock),
// task cards, a log ticker, a metric chart and a work-graph inset, all
// derived from the work graph and the frame number. No layout, colour or
// state logic in the loader (FR-004); the HUD is the single source of the
// scene.
//
// HOW: hud_scene_of builds a HudScene from the work graph: one task card per
// active node, carrying that node's kind and provenance label, plus a status
// bar exactly when the graph has work to report, naming the node count and
// the frame. hud_scene is the element count of that scene -- the number the
// loader budgets against. Every text node and every focusable node carries a
// mirror line (FR-002); the mirror's construction lands in the next spec.
// State changes are rate-limited (FR-003).
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module hud;

use t27f::work_graph::WorkGraph;
use t27f::ui_plan::UiPlan;
use t27f::work_graph::NODE_CAP;
use t27f::work_graph::nodes;
use t27f::work_graph::node_kind_at_pub;
use t27f::work_graph::node_label_at;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::Event;
use t27f::work_graph::EV_SPAWN;
use t27f::work_graph::EV_DELIVER;
use t27f::work_graph::D_NONE;
use t27f::work_graph::D_OFFER;
use t27f::work_graph::WG_OK;
use t27f::work_graph::NK_AGENT;
use t27f::spec_graph::LABEL_EXACT;
use t27f::spec_graph::LABEL_UNKNOWN;

// --- kinds ---------------------------------------------------------------

pub const HUD_STATUS_BAR : u8 = 0;
pub const HUD_TASK_CARD : u8 = 1;
pub const HUD_LOG_TICKER : u8 = 2;
pub const HUD_METRIC_CHART : u8 = 3;
pub const HUD_WORK_GRAPH_INSET : u8 = 4;
pub const HUD_KINDS : u8 = 5;

// The status-bar slot of a scene built from an empty graph: a kind no
// renderer draws. Above every real kind, so a scene can never confuse it.
pub const HUD_ABSENT : u8 = 255;

// --- rate limit ----------------------------------------------------------

pub const HUD_MAX_ANNOUNCEMENTS_PER_SEC : u32 = 4;

// --- the scene -----------------------------------------------------------

// The HUD scene for one frame: the minimal record of what the HUD shows. The
// full UiPlan (ui_plan.t27) lands with the renderer milestone; this record is
// what hud_scene counts and what the tests hold. The card columns are indexed
// by card number; entries at or past card_count are not read.
pub struct HudScene {
    element_count: u32,
    status_bar: u8,          // HUD_STATUS_BAR when present, HUD_ABSENT when not
    status_node_count: u32,  // the node count the status bar names
    status_frame: u64,       // the frame number the status bar names
    card_count: u32,         // one task card per active node
    card_kind: [2048]u8,     // the work-graph node kind each card renders
    card_label: [2048]u8,    // the node's provenance label each card carries
}

pub fn hud_new_scene() -> HudScene {
    return HudScene {
        element_count: 0,
        status_bar: HUD_ABSENT,
        status_node_count: 0,
        status_frame: 0,
        card_count: 0,
        card_kind: [0] ** 2048,
        card_label: [0] ** 2048,
    };
}

// --- pure construction (FR-001) ------------------------------------------

// The task cards: one per active node. A node is active when its number is
// below node_count -- work_graph reads no entry at or past it.
pub fn hud_task_card_count(wg: *WorkGraph) -> u32 {
    return nodes(wg);
}

// The status bar exists exactly when the graph has work to report: an empty
// graph paints an empty HUD (the foundation's zero rule, kept).
pub fn hud_status_bar_count(wg: *WorkGraph) -> u32 {
    if (nodes(wg) > 0) { return 1; }
    return 0;
}

// hud_scene_of(wg, frame): build the HUD scene for the given work graph and
// frame. Pure: same inputs -> same scene. No clock, no I/O, no state. The
// frame enters the status bar's content and never the element count. Defined
// up to NODE_CAP cards (asserted, never truncated) -- work_graph itself
// refuses a graph past that cap, so no scene can ask for one.
pub fn hud_scene_of(wg: *WorkGraph, frame: u64) -> HudScene {
    var s = hud_new_scene();
    const n = nodes(wg);
    assert(n <= NODE_CAP);
    var i : u32 = 0;
    while (i < n) {
        s.card_kind[i as usize] = node_kind_at_pub(wg, i);
        s.card_label[i as usize] = node_label_at(wg, i);
        i = i + 1;
    }
    s.card_count = n;
    s.status_node_count = n;
    s.status_frame = frame;
    s.status_bar = HUD_ABSENT;
    if (n > 0) { s.status_bar = HUD_STATUS_BAR; }
    s.element_count = s.card_count + hud_status_bar_count(wg);
    return s;
}

// hud_scene(wg, frame): the number of HUD elements the scene holds -- the
// task cards plus the status bar. The count is a function of the graph alone;
// it is read off the built scene, so it can never disagree with one.
pub fn hud_scene(wg: *WorkGraph, frame: u64) -> u32 {
    var s = hud_scene_of(wg, frame);
    return s.element_count;
}

// --- mirror (a11y) -------------------------------------------------------

// hud_mirror(wg, frame): one text line per text/focusable node, in order.
// The lines are built from hud_scene_of's cards in the next spec (FR-002);
// the entry point is here so the loader has one mirror to call.
pub fn hud_mirror(wg: *WorkGraph, frame: u64) -> usize {
    _ = wg;
    _ = frame;
    return 0;
}

// --- tests ---------------------------------------------------------------

test hud_scene_is_pure {
    // same inputs -> same scene (no clock, no I/O), on a graph with work in it
    var g = new_graph();
    assert(apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == WG_OK);
    const a = hud_scene(&g, 3);
    const b = hud_scene(&g, 3);
    assert(a == b);
    var sa = hud_scene_of(&g, 3);
    var sb = hud_scene_of(&g, 3);
    assert(sa.element_count == sb.element_count);
    assert(sa.card_count == sb.card_count);
    assert(sa.status_frame == sb.status_frame);
    // and on the empty graph, where the scene is empty
    var empty = new_graph();
    assert(hud_scene(&empty, 0) == 0);
}

test hud_scene_zero_for_empty_graph {
    var empty = new_graph();
    assert(hud_scene(&empty, 0) == 0);
    assert(hud_scene(&empty, 999) == 0);
    var s = hud_scene_of(&empty, 999);
    assert(s.element_count == 0);
    assert(s.card_count == 0);
    assert(s.status_bar == HUD_ABSENT);
}

test hud_scene_counts_one_card_per_node_plus_the_status_bar {
    var g = new_graph();
    assert(apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == WG_OK);
    assert(apply_event(&g, Event { kind: EV_DELIVER, from_pid: 2, to_pid: 3, task_no: 7, deliver: D_OFFER, reason: 99, seq: 2, spec_id: 11 }) == WG_OK);
    // the graph holds: agents 1, 2, 3, the action of seq 2, task 7, spec 11
    assert(nodes(&g) == 6);
    assert(hud_scene(&g, 5) == 7);   // six cards + one status bar
    var s = hud_scene_of(&g, 5);
    assert(s.element_count == 7);
    assert(s.card_count == 6);
    assert(s.status_bar == HUD_STATUS_BAR);
    assert(s.status_node_count == 6);
    assert(s.status_frame == 5);
}

test hud_cards_carry_each_nodes_kind_and_label_in_order {
    var g = new_graph();
    // the spawn names its two agents EXACT...
    assert(apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == WG_OK);
    // ...and the deliver's receiver is only a bare pid: UNKNOWN
    assert(apply_event(&g, Event { kind: EV_DELIVER, from_pid: 2, to_pid: 3, task_no: 0, deliver: D_NONE, reason: 99, seq: 9, spec_id: 0 }) == WG_OK);
    var s = hud_scene_of(&g, 0);
    assert(s.card_count == nodes(&g));
    var i : u32 = 0;
    while (i < s.card_count) {
        assert(s.card_kind[i as usize] == node_kind_at_pub(&g, i));
        assert(s.card_label[i as usize] == node_label_at(&g, i));
        i = i + 1;
    }
    assert(s.card_kind[2 as usize] == NK_AGENT);
    assert(s.card_label[0 as usize] == LABEL_EXACT);
    assert(s.card_label[1 as usize] == LABEL_EXACT);
    assert(s.card_label[2 as usize] == LABEL_UNKNOWN);
    assert(s.card_label[3 as usize] == LABEL_EXACT);   // the action node
}

test hud_frame_enters_the_status_bar_and_never_the_count {
    var g = new_graph();
    assert(apply_event(&g, Event { kind: EV_SPAWN, from_pid: 1, to_pid: 2, task_no: 0, deliver: D_NONE, reason: 99, seq: 1, spec_id: 0 }) == WG_OK);
    assert(hud_scene(&g, 0) == 3);
    assert(hud_scene(&g, 4242) == 3);   // the count is a function of the graph alone
    var a = hud_scene_of(&g, 0);
    var b = hud_scene_of(&g, 4242);
    assert(a.status_frame == 0);
    assert(b.status_frame == 4242);
    assert(a.element_count == b.element_count);
    assert(a.card_count == b.card_count);
    assert(a.status_node_count == b.status_node_count);
}

pub fn hud_announcement_limit() -> u32 {
    return HUD_MAX_ANNOUNCEMENTS_PER_SEC;
}

test hud_max_announcements_bounded {
    const limit = hud_announcement_limit();
    assert(limit > 0);
    assert(limit <= 10);
}

invariant hud_kinds_are_distinct {
    assert HUD_STATUS_BAR < HUD_TASK_CARD;
    assert HUD_TASK_CARD < HUD_LOG_TICKER;
    assert HUD_LOG_TICKER < HUD_METRIC_CHART;
    assert HUD_METRIC_CHART < HUD_WORK_GRAPH_INSET;
    assert HUD_WORK_GRAPH_INSET < HUD_KINDS;
    assert HUD_ABSENT > HUD_WORK_GRAPH_INSET;
    assert HUD_MAX_ANNOUNCEMENTS_PER_SEC == 4;
}
