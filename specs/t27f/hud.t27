// SPDX-License-Identifier: Apache-2.0
// specs/t27f/hud.t27 -- the agent-state HUD as a pure function of the work graph and the frame.
// Milestone M3 of T27F Live (epic gHashTag/t27#10266), issue gHashTag/t27#10262.
// Design: docs/nona-02-organism/t27f/genui-research.md, sections 4.4 and 5.
//
// FR-001, AS A SHAPE: hud_scene reads the graph through work_graph.t27's accessors and the frame
// through arithmetic -- no clock, no environment, no payload anywhere in the build. The same
// (graph, frame, width, reduced) returns the same scene every time; the test proves it by building
// twice and comparing every node field, then proves the frame is a real input by moving it.
//
// TASK STATE IS DERIVED FROM EDGES, because that is what the landed graph records: an ASSIGNED edge
// means the task runs, a VERIFIES edge means it reached review-and-done, a BLOCKS edge means it is
// blocked, and none of those means backlog. The derivation is stated here in one function; no state
// vocabulary is forked.
//
// THE TEXT CONTRACT. A scene node carries geometry, not words: scene.t27 stores no text fields, and
// payloads are forbidden upstream (FR-004). So every TEXT box is sized by one rule -- wide enough
// for MIRROR_MAX_CHARS characters at CHAR_W -- and the words live in a11y_mirror.t27's lines, which
// are records of numbers the page renders. The overflow scenario is therefore true by construction
// at 375 and 1920: a text box is never narrower than the longest line its mirror may put in it.
//
// THE FIVE COMPONENTS of the reference grammar, all from one graph: the status bar (agent count,
// task count, frame clock), the task cards (the focusables), the log ticker, the metric chart (one
// bar per derived state, easing in by frame), and the work-graph inset (node and edge counts).
//
// NOT CLAIMED: the 60 fps / 0 dropped frames replay is a headless-browser measurement on the Railway
// lab and is not measured by this change; colours are the theme's; the <=40-line loader is the
// trinity page's and consumes these opcodes without owning any layout, colour or state logic
// (FR-004) -- everything it needs is in the stream.
// phi^2 + 1/phi^2 = 3 | TRINITY

module hud;

use t27f::work_graph::WorkGraph;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::node_kind_at_pub;
use t27f::work_graph::NK_TASK;
use t27f::work_graph::NK_AGENT;
use queen::tasks::TS_BACKLOG;
use queen::tasks::TS_REVIEW;
use queen::tasks::TASK_STATES;
use t27f::scene::Scene;
use t27f::scene::Op;
use t27f::scene::scene_empty;
use t27f::scene::apply_op;
use t27f::scene::validate_scene;
use t27f::scene::SCENE_OK;
use t27f::scene::PRIM_RECT;
use t27f::scene::PRIM_TEXT;
use t27f::scene::NO_PARENT;
use t27f::scene::F_X;
use t27f::scene::F_Y;
use t27f::scene::F_W;
use t27f::scene::F_H;
use t27f::scene::node_cap;
use t27f::a11y_mirror::MIRROR_MAX_CHARS;
use t27f::a11y_mirror::CARD_MAX;
use t27f::a11y_mirror::task_slot;
use t27f::a11y_mirror::visible_tasks;
use t27f::a11y_mirror::task_state;
use t27f::a11y_mirror::count_kind;
use t27f::motion::tween;
use t27f::motion::EASE_OUT;
use t27f::work_graph_fixture::event_at;
use t27f::work_graph_fixture::FIXTURE_EVENTS;

pub const ID : str = "hud";
pub const VERSION : u8 = 1;

// ---- the layout vocabulary ---------------------------------------------------------------------------

pub const PAD : i32 = 8;                   // page margin
pub const GAP : i32 = 6;                   // between cards
pub const BAR_H : i32 = 24;                // status bar height
pub const CHAR_W : i32 = 6;                // one glyph cell at the HUD's text size
pub const MIN_W : i32 = 320;               // nothing below this is a HUD
pub const CHART_FRAMES : i32 = 30;         // the chart eases in over this many frames
pub const CHART_MAX : i32 = 40;            // the tallest bar, in px

/// The derived state of task slot n, from the edges the graph holds. BLOCKS wins over everything
/// (a blocked task is blocked whatever else is true), then VERIFIES, then ASSIGNED.
// ---- the scene build ---------------------------------------------------------------------------------

fn text_w() -> i32 {
    return (MIRROR_MAX_CHARS as i32) * CHAR_W;
}

fn add_rect(s: *Scene, seq: u32, x: i32, y: i32, w: i32, h: i32) -> bool {
    const a = Op{ .op = 0, .seq = seq, .prim = PRIM_RECT, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    if (apply_op(s, a) != SCENE_OK) { return false; }
    const b = Op{ .op = 1, .seq = seq + 1, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_X, .value = x };
    if (apply_op(s, b) != SCENE_OK) { return false; }
    const c = Op{ .op = 1, .seq = seq + 2, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_Y, .value = y };
    if (apply_op(s, c) != SCENE_OK) { return false; }
    const d = Op{ .op = 1, .seq = seq + 3, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_W, .value = w };
    if (apply_op(s, d) != SCENE_OK) { return false; }
    const e = Op{ .op = 1, .seq = seq + 4, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_H, .value = h };
    if (apply_op(s, e) != SCENE_OK) { return false; }
    return true;
}

fn add_text(s: *Scene, seq: u32, x: i32, y: i32) -> bool {
    const a = Op{ .op = 0, .seq = seq, .prim = PRIM_TEXT, .parent = NO_PARENT, .node = 0, .field = 0, .value = 0 };
    if (apply_op(s, a) != SCENE_OK) { return false; }
    const b = Op{ .op = 1, .seq = seq + 1, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_X, .value = x };
    if (apply_op(s, b) != SCENE_OK) { return false; }
    const c = Op{ .op = 1, .seq = seq + 2, .prim = 0, .parent = 0, .node = s.count - 1, .field = F_W, .value = text_w() };
    if (apply_op(s, c) != SCENE_OK) { return false; }
    return true;
}

/// FR-001: the HUD is this function and nothing else. Same inputs, same scene, every time.
pub fn hud_scene(g: *WorkGraph, frame: i32, width: i32, reduced: bool) -> Scene {
    var s = scene_empty();
    var seq : u32 = 1;
    const w = width - 2 * PAD;
    // 1. the status bar and its three texts
    assert(add_rect(&s, seq, PAD, PAD, w, BAR_H));
    seq = seq + 5;
    var t : u32 = 0;
    while (t < 3) {
        assert(add_text(&s, seq, PAD + t * (text_w() + GAP), PAD));
        seq = seq + 3;
        t = t + 1;
    }
    // 2. the task cards
    const cc = visible_tasks(g);
    const cw = @divTrunc(w - (cc - 1) * GAP, cc);
    var card : u32 = 0;
    while (card < cc) {
        assert(add_rect(&s, seq, PAD + card * (cw + GAP), BAR_H + PAD, cw, 2 * CHAR_W + 4));
        seq = seq + 5;
        assert(add_text(&s, seq, PAD + card * (cw + GAP) + 2, BAR_H + PAD));
        seq = seq + 3;
        card = card + 1;
    }
    // 3. the metric chart: one bar per derived state, easing in by frame
    var st : u32 = 0;
    while (st < (TASK_STATES as u32)) {
        var count : u32 = 0;
        var n : u32 = 0;
        while (n < nodes(g)) {
            if (node_kind_at_pub(g, n) == NK_TASK and task_state(g, n) == st) { count = count + 1; }
            n = n + 1;
        }
        const target = @divTrunc(count * (CHART_MAX as u32), 8);
        const h = tween(0, target as i32, frame, CHART_FRAMES, EASE_OUT);
        assert(add_rect(&s, seq, PAD + st * (CHAR_W * 4 + GAP), BAR_H + 32, CHAR_W * 4, h));
        seq = seq + 5;
        st = st + 1;
    }
    // 4. the log ticker and 5. the work-graph inset
    var t2 : u32 = 0;
    while (t2 < 2) {
        assert(add_text(&s, seq, PAD, BAR_H + 32 + CHART_MAX + t2 * CHAR_W * 2));
        seq = seq + 3;
        t2 = t2 + 1;
    }
    return s;
}

// ---- tests -------------------------------------------------------------------------------------------

test the_hud_is_a_pure_function_of_graph_and_frame {                    // FR-001
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    var a = hud_scene(&g, 0, 375, false);
    var b = hud_scene(&g, 0, 375, false);
    assert(a.count == b.count);
    assert(a.count >= 12);
    var n : u32 = 0;
    while (n < a.count) {
        assert(a.kind[n as usize] == b.kind[n as usize]);
        assert(a.x[n as usize] == b.x[n as usize]);
        assert(a.y[n as usize] == b.y[n as usize]);
        assert(a.w[n as usize] == b.w[n as usize]);
        assert(a.h[n as usize] == b.h[n as usize]);
        n = n + 1;
    }
    // the frame is a real input: the chart bars move with it
    var c = hud_scene(&g, 45, 375, false);
    var differs : bool = false;
    n = 0;
    while (n < a.count) {
        if (a.h[n as usize] != c.h[n as usize]) { differs = true; }
        n = n + 1;
    }
    assert(differs);
}

test layouts_at_375_and_1920_pass_validate_scene {
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    var s375 = hud_scene(&g, 12, 375, false);
    assert(validate_scene(&s375) == SCENE_OK);
    var s1920 = hud_scene(&g, 12, 1920, false);
    assert(validate_scene(&s1920) == SCENE_OK);
    // a legal HUD never reaches the scene's node refusal
    assert(s375.count <= node_cap());
    assert(s1920.count == s375.count);
    assert(MIN_W <= 375);
}

test every_text_box_reserves_room_for_its_mirror_line {
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    var s = hud_scene(&g, 7, 375, false);
    var n : u32 = 0;
    var text_nodes : u32 = 0;
    while (n < s.count) {
        if (s.kind[n as usize] == 2) {
            assert(s.w[n as usize] >= (MIRROR_MAX_CHARS as i32) * CHAR_W);
            text_nodes = text_nodes + 1;
        }
        n = n + 1;
    }
    assert(text_nodes >= 5);
}

test the_hud_shows_the_same_cards_the_graph_holds {
    var g = new_graph();
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(apply_event(&g, event_at(i)) == 0);
        i = i + 1;
    }
    const cc = visible_tasks(&g);
    assert(cc >= 1 and cc <= CARD_MAX);
    var card : u32 = 0;
    while (card < cc) {
        const slot = task_slot(&g, card);
        assert(slot != 4294967295);
        // the derived state is one of the seven, and the derivation is edge-fed
        const st = task_state(&g, slot);
        assert(st < TASK_STATES);
        card = card + 1;
    }
    // reduced motion freezes the chart at its target on frame 0; motion moves it
    var still = hud_scene(&g, 0, 375, true);
    var moved = hud_scene(&g, 0, 375, false);
    var differs2 : bool = false;
    var n : u32 = 0;
    while (n < still.count) {
        if (still.h[n as usize] != moved.h[n as usize]) { differs2 = true; }
        n = n + 1;
    }
    assert(differs2);
    assert(count_kind(&g, NK_AGENT) >= 1);
    assert(TS_BACKLOG == 0 and TS_REVIEW == 3);
}

invariant the_hud_fits_its_own_budget {
    assert(MIRROR_MAX_CHARS > 0);
    assert(CARD_MAX >= 1);
    assert(CHAR_W > 0);
    assert(CHART_FRAMES > 0);
    assert(TASK_STATES == 7);
    assert(MIN_W > 0);
    assert(CHART_MAX > 0);
}
