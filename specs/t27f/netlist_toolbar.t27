// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_toolbar.t27 -- Toolbar/Status for the NETLIST constructor.
; Ring 2, Wave J1 of epic #13650.
; NtToolbar: action availability derived from NvSelection and NetlistGraph.
; nt_toolbar(sel, g): can_add/delete/connect/inspect + sel_count.
; nt_can_start_connection(kind): derived from nc_validate -- consistent with I1 contract.
; Depends on master (H1 merged: netlist_node_port) + lane/netlist-connection-i1 (I1: nc_validate).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_toolbar;

use t27f::netlist_graph::{NetlistGraph, NG_NODE_KINDS, NG_NODE_BLOCK, NG_NODE_INSTANCE,
    NG_NODE_NET, NG_NODE_PIN, NG_NODE_DEVICE, NG_NODE_REFUSAL, inverter_graph};
use t27f::netlist_selection::{NvSelection, NV_NO_SELECTION, nv_no_selection, nv_select_node,
    nv_is_selected};
use t27f::netlist_connection::{nc_validate, NC_OK};

; ── NtToolbar struct ──────────────────────────────────────────────────────────
; Action availability for the current selection state.
; can_add  : always true (host can always add a node from the palette).
; can_delete  : true when at least one node is selected.
; can_connect : true when selected node kind can be a FROM endpoint of any edge.
; can_inspect : true when exactly one node is selected.
pub struct NtToolbar {
    can_add     : bool,
    can_delete  : bool,
    can_connect : bool,
    can_inspect : bool,
    sel_count   : u32,
}

; ── Connection initiability ───────────────────────────────────────────────────
; Returns true when src_kind can be the FROM endpoint of at least one edge type.
; Derived from nc_validate so it stays consistent with I1 connection contract.
; Scan all destination kinds; return true if any nc_validate(src,dst) is ok.
; Consistent with I1 connection contract (nc_validate in netlist_connection).
pub fn nt_can_start_connection(src_kind: u8) -> bool {
    if (src_kind >= NG_NODE_KINDS) { return false; }
    var k : u8 = 0;
    while (k < NG_NODE_KINDS) {
        if (nc_validate(src_kind, k).ok) { return true; }
        k = k + 1;
    }
    return false;
}

; ── Toolbar derivation ────────────────────────────────────────────────────────
; Derives toolbar state from selection.  No RGBA, no host code.
pub fn nt_toolbar(sel: NvSelection, g: NetlistGraph) -> NtToolbar {
    var t : NtToolbar;
    t.can_add     = true;
    t.can_delete  = false;
    t.can_connect = false;
    t.can_inspect = false;
    t.sel_count   = 0;
    if (nv_is_selected(sel)) {
        t.sel_count   = 1;
        t.can_delete  = true;
        t.can_inspect = true;
        let ki   : usize = sel.idx as usize;
        let kind : u8    = g.node_kind[ki];
        t.can_connect = nt_can_start_connection(kind);
    }
    return t;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_can_add {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_add == true;
}

test no_selection_cannot_delete {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_delete == false;
}

test no_selection_cannot_connect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_connect == false;
}

test no_selection_cannot_inspect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_inspect == false;
}

test no_selection_count_is_zero {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.sel_count == 0;
}

test block_selection_can_delete {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(0);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_delete == true;
}

test block_selection_can_inspect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(0);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_inspect == true;
}

test block_selection_can_connect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(0);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_connect == true;
}

test pin_selection_cannot_connect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(1);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_connect == false;
}

test device_selection_cannot_connect {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(3);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_connect == false;
}

test selection_count_one_when_selected {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_select_node(0);
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.sel_count == 1;
}

test can_start_connection_net_true {
    assert nt_can_start_connection(NG_NODE_NET) == true;
}

test can_start_connection_pin_false {
    assert nt_can_start_connection(NG_NODE_PIN) == false;
}

test can_start_connection_refusal_false {
    assert nt_can_start_connection(NG_NODE_REFUSAL) == false;
}

test can_start_connection_block_true {
    assert nt_can_start_connection(NG_NODE_BLOCK) == true;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant no_selection_always_can_add {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    assert t.can_add == true;
}

invariant pin_cannot_initiate_connection {
    assert nt_can_start_connection(NG_NODE_PIN) == false;
}

invariant invalid_kind_cannot_initiate_connection {
    assert nt_can_start_connection(NG_NODE_KINDS) == false;
}
