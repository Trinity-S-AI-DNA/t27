// SPDX-License-Identifier: Apache-2.0
; T27F-004 story: the task card drawn as a visual-factory graph
; Refs gHashTag/t27#13218, epic #13214
; Reads the contract in specs/t27f/visual_factory_contract.t27 and never edits it
; One card, one title, one status badge, one owner label plus its input, one action row with two buttons

module t27f_task_card;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CARD;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BADGE;
use t27f::visual_factory_contract::VF_INPUT;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL;
use t27f::visual_factory_contract::P_LABEL_REF;
use t27f::visual_factory_contract::P_VARIANT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::PRIMARY;
use t27f::visual_factory_contract::SECONDARY;
use t27f::visual_factory_contract::SUCCESS;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::visual_factory_contract::vf_accessible_name;

pub const STORY_ID : str = "task-card";

pub fn task_card_graph() -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_CARD, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "task-card");
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "title");
    var g2 : VfGraph = vf_add(g1, VF_BADGE, 0, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "status");
    var g3 : VfGraph = vf_add(g2, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "owner-label");
    var g4 : VfGraph = vf_add(g3, VF_INPUT, 0, bit(P_LABEL_REF) + bit(P_TEST_ID), "owner-input");
    var g5 : VfGraph = vf_add(g4, VF_STACK, 0, bit(P_TEST_ID), "actions");
    var g6 : VfGraph = vf_add(g5, VF_BUTTON, 5, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "save");
    var g7 : VfGraph = vf_add(g6, VF_BUTTON, 5, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "cancel");

    g7.label[0] = "Task card";
    g7.direction[0] = DIR_COLUMN;
    g7.padding[0] = 8;
    g7.gap[0] = 8;

    g7.text[1] = "Write the spec";

    g7.text[2] = "Open";
    g7.variant[2] = SUCCESS;

    g7.text[3] = "Owner";

    g7.label_ref[4] = 3;

    g7.direction[5] = DIR_ROW;
    g7.gap[5] = 8;

    g7.text[6] = "Save";
    g7.variant[6] = PRIMARY;

    g7.text[7] = "Cancel";
    g7.variant[7] = SECONDARY;

    return g7;
}

test task_card_is_valid {
    let g : VfGraph = task_card_graph();
    assert vf_validate(g) == VF_OK;
    assert g.node_count == 8;
}

test task_card_kinds_and_parents {
    let g : VfGraph = task_card_graph();
    assert g.kind[0] == VF_CARD;
    assert g.kind[4] == VF_INPUT;
    assert g.kind[6] == VF_BUTTON;
    assert g.kind[7] == VF_BUTTON;
    assert g.parent[6] == 5;
    assert g.parent[7] == 5;
}

test task_card_accessible_names {
    let g : VfGraph = task_card_graph();
    assert vf_accessible_name(g, 0) == "Task card";
    assert vf_accessible_name(g, 1) == "Write the spec";
    assert vf_accessible_name(g, 4) == "Owner";
    assert vf_accessible_name(g, 5) == "";
    assert vf_accessible_name(g, 6) == "Save";
    assert vf_accessible_name(g, 7) == "Cancel";
}
