// SPDX-License-Identifier: Apache-2.0
; Container story for SIEVE DESIGN LAW component 0 (C_CONTAINER).
; Refs Trinity-S-AI-DNA/t27#13491, law specs/t27f/sieve_design_law.t27
; The graph is a column container with a label and two text children. The kit's empty
; container row stays in vf_storybook; this story is the sieve evidence for that component.
; Screenshot: vf_pixel_sum of the laid-out graph. It is a checksum of flat fills, not a PNG.
; VR: vf_diff_count on a 2x1 RGB pair. A count of 0 means the bytes match, not that the
; frame looks right (the same limit as specs/t27f/vf_diff.t27).
; T27L: one screenshot_captured line on the visual surface. The spec does not write a file.
; NOT claimed: F3 hierarchy, F5 accessibility and F9 craft stay MISSING. Gap and padding
; stay 0, there is no contrast ratio and no 44 pt target, and there is no easing.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_container_story;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_CONTAINER;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL;
use t27f::visual_factory_contract::P_VARIANT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::DIR_COLUMN;
use t27f::visual_factory_contract::DIR_ROW;
use t27f::visual_factory_contract::SECONDARY;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::visual_factory_contract::vf_accessible_name;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_pixel_sum;
use t27f::vf_diff::vf_diff_count;
use t27os::t27l::tl_event_line;
use t27os::t27l::tl_validate_line;
use t27os::t27l::TL_OK;
use t27f::sieve_design_law::C_CONTAINER;
use t27f::sieve_design_law::F_HIERARCHY;
use t27f::sieve_design_law::F_ACCESSIBILITY;
use t27f::sieve_design_law::F_CRAFT;
use t27f::sieve_design_law::F_CLARITY;
use t27f::sieve_design_law::MISSING;
use t27f::sieve_design_law::CONTAINER_STORY_ISSUE;
use t27f::sieve_design_law::value;
use t27f::sieve_design_law::fix_issue;

pub const STORY_ID : str = "container-sieve";
pub const SHOT_STEP : u32 = 8;
pub const STORY_EVENT : str = "c0ffee00-0001-4000-8000-000000000001";
pub const STORY_TS : str = "2026-11-09T16:00:00Z";

pub fn container_story_graph() -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_CONTAINER, VF_NO_PARENT, bit(P_LABEL) + bit(P_TEST_ID), "container");
    var g1 : VfGraph = vf_add(g0, VF_TEXT, 0, bit(P_TEXT) + bit(P_VARIANT) + bit(P_TEST_ID), "title");
    var g2 : VfGraph = vf_add(g1, VF_TEXT, 0, bit(P_TEXT) + bit(P_TEST_ID), "body");
    g2.label[0] = "Container";
    g2.direction[0] = DIR_COLUMN;
    g2.text[1] = "Title";
    g2.variant[1] = SECONDARY;
    g2.text[2] = "Body";
    return g2;
}

pub fn container_shot_sum(width: u32, step: u32, row: bool) -> u32 {
    var g : VfGraph = container_story_graph();
    g.viewport_w = width;
    if row {
        g.direction[0] = DIR_ROW;
    }
    let l : VfLayout = vf_layout(g);
    return vf_pixel_sum(g, l, step);
}

pub fn container_t27l_line(out: []u8) -> usize {
    return tl_event_line(out, STORY_EVENT, STORY_TS, "t27os", "container", 3, 18, 22, 2, "", "", "", "container sieve", "");
}

test container_story_graph_is_a_labelled_column {
    let g : VfGraph = container_story_graph();
    assert vf_validate(g) == VF_OK;
    assert g.node_count == 3;
    assert g.kind[0] == VF_CONTAINER;
    assert g.kind[1] == VF_TEXT;
    assert g.kind[2] == VF_TEXT;
    assert g.parent[1] == 0;
    assert g.parent[2] == 0;
    assert g.direction[0] == DIR_COLUMN;
    assert g.gap[0] == 0;
    assert g.padding[0] == 0;
    assert g.variant[1] == SECONDARY;
    assert g.variant[2] == 0;
    assert vf_accessible_name(g, 0) == "Container";
    assert vf_accessible_name(g, 1) == "Title";
    assert vf_accessible_name(g, 2) == "Body";
    let l : VfLayout = vf_layout(g);
    assert l.node_count == 3;
    assert l.w[0] == 375;
    assert l.h[0] == 40;
}

test container_screenshot_is_stable_and_the_row_differs {
    let col : u32 = container_shot_sum(375, SHOT_STEP, false);
    assert col != 0;
    assert col == container_shot_sum(375, SHOT_STEP, false);
    assert container_shot_sum(375, 0, false) == 0;
    assert container_shot_sum(375, SHOT_STEP, true) != col;
}

test container_vr_counts_one_changed_byte {
    var a : [6]u8 = [250, 250, 250, 21, 21, 21];
    var b : [6]u8 = [250, 250, 250, 21, 21, 21];
    assert vf_diff_count(a[0..6], b[0..6], 2, 1) == 0;
    b[3] = 9;
    assert vf_diff_count(a[0..6], b[0..6], 2, 1) == 1;
}

test container_t27l_line_validates {
    var line : [512]u8 = undefined;
    let n : usize = container_t27l_line(line[0..512]);
    assert n > 0;
    assert n < 512;
    assert tl_validate_line(line[0..n]) == TL_OK;
    assert tl_validate_line(line[0..0]) != TL_OK;
    let n2 : usize = container_t27l_line(line[0..512]);
    assert n2 == n;
}

test container_sieve_cells_stay_missing_and_point_at_the_issue {
    assert value(C_CONTAINER, F_HIERARCHY) == MISSING;
    assert value(C_CONTAINER, F_ACCESSIBILITY) == MISSING;
    assert value(C_CONTAINER, F_CRAFT) == MISSING;
    assert value(C_CONTAINER, F_CLARITY) != MISSING;
    assert fix_issue(C_CONTAINER, F_HIERARCHY) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_ACCESSIBILITY) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_CRAFT) == CONTAINER_STORY_ISSUE;
    assert fix_issue(C_CONTAINER, F_CLARITY) == 0;
    assert CONTAINER_STORY_ISSUE == 13491;
}
