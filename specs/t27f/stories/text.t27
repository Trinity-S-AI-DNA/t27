// SPDX-License-Identifier: Apache-2.0
; Text story for SIEVE DESIGN LAW component 1 (C_TEXT).
; Refs Trinity-S-AI-DNA/t27#13521, law specs/t27f/sieve_design_law.t27
; The graph is one labelled heading. The kit heading and body rows stay in vf_storybook;
; this story is the sieve evidence for that component.
; Screenshot: vf_pixel_sum of the laid-out graph. It is a checksum of flat fills, not a PNG.
; A wrapped string changes the height, so the checksum changes. The fill ignores the glyphs.
; VR: vf_diff_count on a 2x1 RGB pair. A count of 0 means the bytes match, not that the
; frame looks right (the same limit as specs/t27f/vf_diff.t27).
; T27L: one screenshot_captured line on the visual surface. The spec does not write a file.
; NOT claimed: F3 hierarchy, F5 accessibility and F9 craft stay MISSING. Gap and padding
; stay 0, the box is 20 px tall (one line), there is no contrast ratio and no 44 pt target,
; and there is no easing. The label is an accessible name, not an accessibility proof.
; phi^2 + 1/phi^2 = 3 | TRINITY

module t27f_text_story;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_OK;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_LABEL;
use t27f::visual_factory_contract::P_VARIANT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::V_DEFAULT;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::visual_factory_contract::vf_accessible_name;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_pixel::vf_pixel_sum;
use t27f::vf_diff::vf_diff_count;
use t27f::vf_text_measure::vf_text_height;
use t27f::vf_text_measure::vf_text_lines;
use t27os::t27l::tl_event_line;
use t27os::t27l::tl_validate_line;
use t27os::t27l::TL_OK;
use t27f::sieve_design_law::C_TEXT;
use t27f::sieve_design_law::F_HIERARCHY;
use t27f::sieve_design_law::F_ACCESSIBILITY;
use t27f::sieve_design_law::F_CRAFT;
use t27f::sieve_design_law::F_CLARITY;
use t27f::sieve_design_law::MISSING;
use t27f::sieve_design_law::TEXT_STORY_ISSUE;
use t27f::sieve_design_law::value;
use t27f::sieve_design_law::fix_issue;

pub const STORY_ID : str = "text-sieve";
pub const SHOT_STEP : u32 = 8;
pub const STORY_EVENT : str = "c0ffee00-0001-4000-8000-000000000002";
pub const STORY_TS : str = "2026-11-10T00:00:00Z";
; 62 chars: one past the 61-char capacity of a 375 px text box (content width 367).
pub const TEXT_WRAP : str = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz0123456789";

pub fn text_story_graph() -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_TEXT, VF_NO_PARENT, bit(P_TEXT) + bit(P_LABEL) + bit(P_VARIANT) + bit(P_TEST_ID), "text");
    g0.label[0] = "Text";
    g0.text[0] = "Heading";
    g0.variant[0] = V_DEFAULT;
    return g0;
}

pub fn text_shot_sum(width: u32, step: u32, wrap: bool) -> u32 {
    var g : VfGraph = text_story_graph();
    g.viewport_w = width;
    if wrap {
        g.text[0] = TEXT_WRAP;
    }
    let l : VfLayout = vf_layout(g);
    return vf_pixel_sum(g, l, step);
}

pub fn text_t27l_line(out: []u8) -> usize {
    return tl_event_line(out, STORY_EVENT, STORY_TS, "t27os", "text", 3, 18, 22, 2, "", "", "", "text sieve", "");
}

test text_story_graph_is_a_labelled_heading {
    let g : VfGraph = text_story_graph();
    assert vf_validate(g) == VF_OK;
    assert g.node_count == 1;
    assert g.kind[0] == VF_TEXT;
    assert g.parent[0] == VF_NO_PARENT;
    assert g.text[0] == "Heading";
    assert g.variant[0] == V_DEFAULT;
    assert g.gap[0] == 0;
    assert g.padding[0] == 0;
    assert g.min_h[0] == 0;
    assert vf_accessible_name(g, 0) == "Text";
    let l : VfLayout = vf_layout(g);
    assert l.node_count == 1;
    assert l.w[0] == 375;
    assert l.h[0] == 20;
    assert l.h[0] == vf_text_height(g.text[0], 375);
    var w : VfGraph = g;
    w.text[0] = TEXT_WRAP;
    let lw : VfLayout = vf_layout(w);
    assert vf_text_lines(TEXT_WRAP, 375) == 2;
    assert lw.h[0] == 30;
    assert lw.h[0] == vf_text_height(TEXT_WRAP, 375);
}

test text_screenshot_is_stable_and_the_wrap_differs {
    let head : u32 = text_shot_sum(375, SHOT_STEP, false);
    assert head != 0;
    assert head == text_shot_sum(375, SHOT_STEP, false);
    assert text_shot_sum(375, 0, false) == 0;
    assert text_shot_sum(375, SHOT_STEP, true) != head;
}

test text_vr_counts_one_changed_byte {
    var a : [6]u8 = [250, 250, 250, 21, 21, 21];
    var b : [6]u8 = [250, 250, 250, 21, 21, 21];
    assert vf_diff_count(a[0..6], b[0..6], 2, 1) == 0;
    b[3] = 9;
    assert vf_diff_count(a[0..6], b[0..6], 2, 1) == 1;
}

; tl_join returns 0 unless the buffer holds 520 bytes plus the payload.
; 2048 bytes covers that floor for the text sieve payload.
test text_t27l_line_validates {
    var line : [2048]u8 = undefined;
    let n : usize = text_t27l_line(line[0..2048]);
    assert n > 0;
    assert n < 2048;
    assert tl_validate_line(line[0..n]) == TL_OK;
    assert tl_validate_line(line[0..0]) != TL_OK;
    let n2 : usize = text_t27l_line(line[0..2048]);
    assert n2 == n;
}

test text_sieve_cells_stay_missing_and_point_at_the_issue {
    assert value(C_TEXT, F_HIERARCHY) == MISSING;
    assert value(C_TEXT, F_ACCESSIBILITY) == MISSING;
    assert value(C_TEXT, F_CRAFT) == MISSING;
    assert value(C_TEXT, F_CLARITY) != MISSING;
    assert fix_issue(C_TEXT, F_HIERARCHY) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_ACCESSIBILITY) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_CRAFT) == TEXT_STORY_ISSUE;
    assert fix_issue(C_TEXT, F_CLARITY) == 0;
    assert TEXT_STORY_ISSUE == 13521;
}
