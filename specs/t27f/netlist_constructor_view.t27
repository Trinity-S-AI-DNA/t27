    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 0;
    prev.dst_kind = NG_NODE_BLOCK;
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
