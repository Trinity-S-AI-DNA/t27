}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant toolbar_always_has_actions {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.toolbar_view.btn_count == NTV_ACTION_COUNT;
}

invariant inactive_conn_line_alpha_zero {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.conn_line.alpha == 0.0;
}

invariant no_selection_badge_invisible {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.badge.visible == false;
}
