; specs/t27f/netlist_constructor_view.t27 -- Renderer-neutral root screen plan for NETLIST constructor.
; Ring 2, Wave L4 of epic #13650.
; NcvConstructorView: combines toolbar plan (L1), selection badge plan (L2), connection line plan (L3).
; Derives from NnetlistConstructor (K1) + NvSelection + NetlistGraph + NcPreview + NvPlan.
; Numbers only; a host (glass_window, Web) draws them.
; Depends on: netlist_constructor, netlist_connection_view, netlist_selection_view, netlist_toolbar_view, netlist_view.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_constructor_view;

use t27f::netlist_constructor::{NnetlistConstructor, nc_constructor_state, nc_no_preview};
use t27f::netlist_connection::{NcPreview};
use t27f::netlist_connection_view::{NcvLine, ncv_line_view, NCW_ALPHA_DEFAULT, NCW_ALPHA_INACTIVE};
use t27f::netlist_graph::{NetlistGraph, NG_NODE_BLOCK, NG_NODE_PIN, NG_NODE_DEVICE, inverter_graph};
use t27f::netlist_selection::{NvSelection, nv_no_selection, nv_select_node};
use t27f::netlist_selection_view::{NsvBadge, nsv_badge_view};
use t27f::netlist_toolbar_view::{NtvToolbarView, ntv_toolbar_view, NTV_ACTION_COUNT};
use t27f::netlist_view::{NvPlan, nv_layout};

; ── NcvConstructorView: root render plan ─────────────────────────────────────
pub struct NcvConstructorView {
    toolbar_view : NtvToolbarView,
    badge        : NsvBadge,
    conn_line    : NcvLine,
}

; ── constructor root view ─────────────────────────────────────────────────────
; Stub: delegates to sub-view functions when active, stubs inactive paths.
pub fn ncv_constructor_view(state: NnetlistConstructor, sel: NvSelection, g: NetlistGraph, preview: NcPreview, p: NvPlan, tx: f64, ty: f64) -> NcvConstructorView {
    var v : NcvConstructorView;
    v.toolbar_view = ntv_toolbar_view(state.toolbar, tx, ty);
    v.badge        = nsv_badge_view(sel, g, p);
    v.conn_line    = ncv_line_view(preview, g, p);
    return v;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_badge_not_visible {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.badge.visible == false;
}

test no_preview_conn_not_visible {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.conn_line.visible == false;
}

test toolbar_btn_count {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.toolbar_view.btn_count == NTV_ACTION_COUNT;
}

test selection_badge_visible {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.badge.visible == true;
}

test selection_badge_kind_block {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.badge.kind_label == NG_NODE_BLOCK as u32;
}

test active_preview_conn_visible {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.conn_line.visible == true;
}

test active_ok_preview_conn_ok {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.conn_line.ok == true;
}

test toolbar_add_always_enabled {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.toolbar_view.btn[0].enabled == true;
}

test toolbar_delete_requires_selection {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
    assert v.toolbar_view.btn[1].enabled == false;
}

test toolbar_delete_enabled_with_selection {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan = nv_layout(g);
    let sel : NvSelection = nv_select_node(0);
    var prev : NcPreview = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    let v : NcvConstructorView = ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
