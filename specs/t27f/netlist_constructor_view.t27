    let sel : NvSelection = nv_no_selection();
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
