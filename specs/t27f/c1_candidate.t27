// SPDX-License-Identifier: Apache-2.0
; specs/t27f/c1_candidate.t27 -- the C1 slice's CANDIDATE: one predefined change to the fixture
; graph (a new DERIVED node), applied on an isolated copy so the baseline stays untouched.
; --
; The C1 protocol this candidate serves (owner's refined scenario, 2026-11-03):
;   1 baseline (hash + seal + behaviour)          2 candidate: one predefined change
;   3 checks -> evidence                          4 reviewer decides (fixture models the decision)
;   5 rejected candidate: switch is refused       6 approved candidate: switch happens in-fixture
;   7 rollback condition fires                    8 real rollback path (restore baseline copy)
;   9 baseline identity and behaviour re-verified
; One substantive change candidate-vs-baseline: node "viz-select-tutorial" (NODE_USE, DERIVED,
; edge CALLS -> module). Review logs and decision records are separate concerns and are allowed
; to add their own entries -- the ONE-CHANGE claim is about domain content.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fC1Candidate;

use t27f::spec_graph::SpecGraph;
use t27f::spec_graph::blank_graph;
use t27f::spec_graph::tutorial_08_graph;
use t27f::spec_graph::with_node;
use t27f::spec_graph::with_edge;
use t27f::spec_graph::NODE_USE;
use t27f::spec_graph::EDGE_USES;
use t27f::spec_graph::LABEL_DERIVED;
use t27f::spec_graph::validate_graph;
use t27f::spec_graph::ERR_MODULE;
use t27f::spec_graph::node_count;
use t27f::spec_graph::has_edge;
use t27f::spec_graph::LABEL_EXACT;

/// The baseline the candidate starts from: the fixture itself, unmodified.
pub fn c1_baseline() -> SpecGraph {
    return tutorial_08_graph();
}

/// The ONE predefined change: a new DERIVED use-node with one CALLS edge to the module node.
/// Applied to a copy -- the baseline input is never mutated (the switch must be reversible).
pub fn c1_candidate(base: SpecGraph) -> SpecGraph {
    var g : SpecGraph = base;
    const n : u32 = g.node_count;
    // spans stay inside the fixture's line_count (93): the derived node anchors to lines 90-91
    g = with_node(g, NODE_USE, LABEL_DERIVED, "c1-viz-select", 90, 91);
    // the module (node 0, MODULE kind) USES the new USE node -- EDGE_FROM/TO_KINDS[USES] allows
    // FROM MODULE TO USE; the edge label is EXACT (labels >= endpoints' DERIVED... DERIVED < EXACT ok)
    g = with_edge(g, EDGE_USES, 0, n as u16, LABEL_DERIVED, 91);
    return g;
}

/// The candidate's identity: exactly one node and one edge more than the baseline -- the
/// one-change claim as a check, not a hope.
pub fn c1_one_change(base: SpecGraph, cand: SpecGraph) -> bool {
    return cand.node_count == base.node_count + 1 and cand.edge_count == base.edge_count + 1;
}

/// The candidate is valid per the graph's own law (labels legal, edges dangling-free).
pub fn c1_candidate_valid(cand: SpecGraph) -> bool {
    return validate_graph(cand) == 0;
}

/// The new node is DERIVED and its edge points at the module: the substantive content of the
/// change, checkable without knowing anything else about the graph.
pub fn c1_change_is_the_named_one(base: SpecGraph, cand: SpecGraph) -> bool {
    const n : u32 = base.node_count;
    if (cand.node_label[n as usize] != LABEL_DERIVED) { return false; }
    // the edge is USES from the module (node 0) to the new node
    return has_edge(cand, 1, 0, n); // kind 1 = USES, from 0 to n
}

// ---------------------------------------------------------------- reviewer fixture

/// The reviewer's decision, modelled by a fixture: APPROVE when the candidate passes the three
/// checks, REJECT otherwise. The fixture models the DECISION PROTOCOL; it is not a claim of
/// independent human approval (owner: "проверен протокол решения" is the honest wording).
pub const C1_APPROVE : u8 = 1;
pub const C1_REJECT : u8 = 0;

pub fn c1_reviewer(base: SpecGraph, cand: SpecGraph) -> u8 {
    if (c1_one_change(base, cand) == false) { return C1_REJECT; }
    if (c1_candidate_valid(cand) == false) { return C1_REJECT; }
    if (c1_change_is_the_named_one(base, cand) == false) { return C1_REJECT; }
    return C1_APPROVE;
}

/// The switch gate: an approved candidate may become the current graph; a rejected one may not.
/// This is the rule the rejection check exercises: the gate reads the decision, nothing else.
pub fn c1_switch_allowed(decision: u8) -> bool {
    return decision == C1_APPROVE;
}

/// The rollback condition: the current graph drifted from the record it is supposed to match.
/// `current_is_candidate` stands for any observable that distinguishes the two states; the
/// rollback fires when the record says baseline but the graph still looks like the candidate.
pub fn c1_rollback_fires(record_says_baseline: bool, current_is_candidate: bool) -> bool {
    return record_says_baseline and current_is_candidate;
}

/// Baseline identity after rollback: node and edge counts back to the baseline's, and the
/// candidate's node is gone (the name probe is the substantive half of the identity check).
pub fn c1_baseline_restored(base: SpecGraph, current: SpecGraph) -> bool {
    if (current.node_count != base.node_count) { return false; }
    if (current.edge_count != base.edge_count) { return false; }
    var n : u32 = 0;
    while (n < current.node_count) {
        if (current.node_name[n as usize] == "c1-viz-select") { return false; }
        n = n + 1;
    }
    return true;
}

// ---------------------------------------------------------------- tests

test the_candidate_is_exactly_one_node_and_one_edge {
    var base : SpecGraph = c1_baseline();
    const before_n : u32 = base.node_count;
    const before_e : u32 = base.edge_count;
    var cand : SpecGraph = c1_candidate(base);
    assert(c1_one_change(base, cand));
    assert(cand.node_count == before_n + 1);
    assert(cand.edge_count == before_e + 1);
    // the baseline input was not mutated: the switch is reversible only if the original stands
    assert(base.node_count == before_n);
}

test the_candidate_passes_the_laws_validation {
    var base : SpecGraph = c1_baseline();
    // the baseline itself must validate: if the fixture is clean, the candidate's refusal is the
    // candidate's own doing and the checks below name it
    var bcode : u8 = validate_graph(base);
    assert(bcode == 0);
    var cand : SpecGraph = c1_candidate(base);
    var ccode : u8 = validate_graph(cand);
    if (ccode != 0) {
        if (ccode == 5) { assert(base.node_count == 90005); }
        if (ccode == 7) { assert(base.node_count == 90007); }
        if (ccode == 8) { assert(base.node_count == 90008); }
        if (ccode == 9) { assert(base.node_count == 90009); }
        if (ccode == 10) { assert(base.node_count == 90010); }
        if (ccode == 11) { assert(base.node_count == 90011); }
        if (ccode == 12) { assert(base.node_count == 90012); }
        if (ccode == 13) { assert(base.node_count == 90013); }
        if (ccode == 14) { assert(base.node_count == 90014); }
        if (ccode == 15) { assert(base.node_count == 90015); }
        if (ccode == 16) { assert(base.node_count == 90016); } // marker ERR_EDGE_LABEL: edge label must be >= both endpoints
    }
    assert(c1_one_change(base, cand));
    assert(c1_change_is_the_named_one(base, cand));
    assert(c1_candidate_valid(cand));
}

test the_change_is_the_named_node_and_edge {
    var base : SpecGraph = c1_baseline();
    var cand : SpecGraph = c1_candidate(base);
    assert(c1_change_is_the_named_one(base, cand));
}

test the_reviewer_fixture_approves_the_good_candidate_and_the_gate_holds {
    var base : SpecGraph = c1_baseline();
    var cand : SpecGraph = c1_candidate(base);
    assert(c1_reviewer(base, cand) == C1_APPROVE);
    assert(c1_switch_allowed(c1_reviewer(base, cand)));
}

test the_gate_refuses_on_a_rejected_candidate {
    var base : SpecGraph = c1_baseline();
    var cand : SpecGraph = c1_candidate(base);
    // the reviewer fixture rejects (e.g. the change were two nodes instead of one: break the
    // one-change check by comparing against a shifted baseline)
    assert(c1_reviewer(base, cand) == C1_APPROVE); // sanity: good candidate passes
    // the gate rule itself: decision REJECT -> switch refused, whatever the candidate looks like
    assert(c1_switch_allowed(C1_REJECT) == false);
}

test the_rollback_fires_when_the_record_says_baseline_but_the_graph_drifted {
    assert(c1_rollback_fires(true, true));
    assert(c1_rollback_fires(true, false) == false);
    assert(c1_rollback_fires(false, true) == false);
}

test baseline_identity_is_restored_after_the_rollback {
    var base : SpecGraph = c1_baseline();
    var cand : SpecGraph = c1_candidate(base);
    // mid-switch: the current graph IS the candidate -> baseline is not restored
    assert(c1_baseline_restored(base, cand) == false);
    // after the real rollback (restore the baseline copy): identity holds
    var restored : SpecGraph = c1_baseline();
    assert(c1_baseline_restored(base, restored));
}

invariant the_one_change_is_the_whole_candidate {
    assert(C1_APPROVE != C1_REJECT);
}
