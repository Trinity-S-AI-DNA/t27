// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_health_viz.t27 -- petal 3 (D HEALTH) of the interactive visualization epic.
; Refs epic t27#12173 (issue t27#12322; plan row 3: specs/t27f/petal_viz_plan.t27). Built on
; specs/t27f/viz_contract.t27.
; --
; Question: "Which project checks pass now, and which one should I open first?"
; Source:   specs/t27mcp/dashboard.t27, the session dashboard of the t27 MCP server. The grades (health_tone,
;           calls_tone, reply_tone), the severity join (worst), the next-step rule (next_step) and its
;           answers (N_ERRORS .. N_READY, NEXT_TEXT) are called, never copied. Titles come from PANEL_TITLES,
;           the checks the page cannot know from UNKNOWN_TEXT, the grade names from TONE_NAME.
; Truth:    VERIFIED while every shown grade is the source's own rule over the recorded readings below.
; Reps:     matrix + list + badge = 262 (the plan row; a test holds the two equal).
; --
; The fixture is petal-side and recorded. dashboard.t27 keeps NO data: it grades numbers the server counts
; at run time and picks one next step. So the six checks below, and the two readings of each measured check,
; are numbers this petal records. They are the numbers the source's own tests grade: the 2026-10-18 manifest
; (2402 specs, 113 failing, 257 warning), a session of 7 calls and no error, and the 57,084 byte t27_status
; reply of that day; the second reading of each check is the what-if the source's tests also grade (121
; failing, 4 calls with 1 error, a reply of exactly REPLY_WARN_BYTES). Nothing here is read from a running
; server.
; --
; What the reader does: reads a matrix of six checks (rows) by four statuses (ok, unknown, warn, bad) where
; one cell per row is lit; reads the same checks as a list ordered by what to open first; and flips one
; check's reading with its chip. Flip the session chip and the session reads 4 calls with 1 error: the grade
; falls to bad, the source's next_step now answers "a tool call failed", the session moves to the top of the
; list and the badge falls to DEMO.
; --
; Layers of this spec:
;   L1 state       PdvState = the contract's one VizState + the flip set (one bit per measured check).
;                  pdv_apply forwards every contract event to the one reducer viz_apply and adds ONE petal
;                  event, the flip, numbered above VIZ_EV_COUNT so it cannot collide with a contract event.
;   L2 entities    check c = viz_ref(NODE, c); the flip chip of measured check c = viz_ref(EDGE, c); the
;                  matrix cell (check c, status t) = viz_ref(CELL, c * 4 + t). Focus order: checks 0..5,
;                  then chips 0..2. It does not change when the list re-sorts.
;   L3 grades      pdv_tone grades a check by the source's tone function over the check's current reading.
;                  The three checks the page cannot know (seal frontier, test receipts, CI state) are always
;                  UNKNOWN, and UNKNOWN is not passing: the source's own rule that worst(OK, UNKNOWN) is
;                  UNKNOWN.
;   L4 order       pdv_pick answers "which one first" with next_step over the three measured grades, mapped
;                  to the check each answer sends you to. The list is made by asking again: take the pick,
;                  treat that check as fixed, ask again, up to three times; the checks left follow by
;                  severity (bad, warn, unknown, ok), ties in listing order.
;   L5 views       matrix, list and badge each have a layout and an inverse hit test, and all read the
;                  one VizState and the one flip set: a hover or a selection lights the same check in
;                  both views.
;   L6 badge       pdv_badge: UNKNOWN until READY; a truth that cannot claim is kept as it is; otherwise
;                  VERIFIED, and DEMO the moment any reading is flipped away from the recorded one.
;   L7 host        pdv_host: three root slots (badge, matrix, list); pdv_in_frame embeds them in a larger
;                  host (vh_embed).
; --
; Integer only: no floats. Pixel geometry is in host coordinates (the origin is the host's top-left
; corner), so a hit test and pdv_host agree without an offset.
; --
; Not used from the source, and why: the HTML templates (PAGE_TEXT, PANEL_TEXT, KV_TEXT, LINE_TEXT,
; TABLE_HEAD, ROW_TEXT, TABLE_TAIL, AGENT_TEXT) are what the server fills in for its own page; this petal
; draws its own views, so it has no use for them. The per-tool call table is not in the source either.
; Not claimed: no host draws this petal yet, and no number here comes from a live server. A plan edit must
; not import this module's pdv_reps (this module imports the plan, so that would be a cycle); the plan holds
; the number 262 itself.

module t27f_petal_health_viz;

use t27mcp::dashboard::T_OK;
use t27mcp::dashboard::T_UNKNOWN;
use t27mcp::dashboard::T_WARN;
use t27mcp::dashboard::T_BAD;
use t27mcp::dashboard::TONE_NAME;
use t27mcp::dashboard::REPLY_WARN_BYTES;
use t27mcp::dashboard::REPLY_BAD_BYTES;
use t27mcp::dashboard::N_ERRORS;
use t27mcp::dashboard::N_BIG;
use t27mcp::dashboard::N_FAILING;
use t27mcp::dashboard::N_START;
use t27mcp::dashboard::N_READY;
use t27mcp::dashboard::NEXT_TEXT;
use t27mcp::dashboard::PANEL_TITLES;
use t27mcp::dashboard::UNKNOWN_TEXT;
use t27mcp::dashboard::worst;
use t27mcp::dashboard::health_tone;
use t27mcp::dashboard::calls_tone;
use t27mcp::dashboard::reply_tone;
use t27mcp::dashboard::next_step;
use t27f::petal_viz_plan::pvp_reps;
use t27f::petal_viz_plan::pvp_truth;
use t27f::petal_viz_plan::pvp_status;
use t27f::petal_viz_plan::pvp_source;
use t27f::petal_viz_plan::pvp_question;
use t27f::petal_viz_plan::pvp_is_spec_path;
use t27f::petal_viz_plan::PVP_DEFERRED;
use t27f::viz_contract;

; ---------------------------------------------------------------- constants

/// This petal's index in the T27 OS menu and its row in the plan: D, HEALTH.
pub const PDV_PETAL : u32 = 3;
/// The checks of the fixture: three the page measures, three it cannot know.
pub const PDV_CHECKS : u32 = 6;
/// The measured checks, the ones that have a flip chip: corpus, session, largest reply.
pub const PDV_MEASURED : u32 = 3;
/// The statuses a check can show, the columns of the matrix: the source's four grades.
pub const PDV_TONES : u32 = 4;
/// Matrix cell (c, t) is the entity viz_ref(CELL, c * PDV_STRIDE + t).
pub const PDV_STRIDE : u32 = 4;
/// The focusable entities: every check, then every flip chip.
pub const PDV_ITEMS : u32 = 9;

/// The ids of the checks, in listing order.
pub const PDV_C_CORPUS : u32 = 0;
pub const PDV_C_SESSION : u32 = 1;
pub const PDV_C_REPLY : u32 = 2;
pub const PDV_C_SEAL : u32 = 3;
pub const PDV_C_RECEIPT : u32 = 4;
pub const PDV_C_CI : u32 = 5;

/// "No check", and "no next step": not a valid index.
pub const PDV_NO_CHECK : u32 = 65535;
pub const PDV_NO_NEXT : u32 = 99;
/// The grade of a check that does not exist, or of any check before the view is READY. Above every grade.
pub const PDV_TONE_NONE : u32 = 99;

/// The one petal event. Above VIZ_EV_COUNT, so it cannot collide with a contract event. a = measured check.
pub const PDV_EV_FLIP : u8 = 32;

/// Cell states: lit, not lit, or nothing shown (no such cell, or the view is not READY).
pub const PDV_CELL_OFF : u8 = 0;
pub const PDV_CELL_ON : u8 = 1;
pub const PDV_CELL_NONE : u8 = 2;

/// The name of the largest-reply check. The source has the grade of a reply, not a title for it, so this
/// name is the petal's own (the source's table header calls the column "largest reply, bytes").
pub const PDV_REPLY_NAME : str = "Largest reply";

/// Recorded readings, petal-side. Corpus: [total, fail, warn] of reading 0, then of reading 1.
/// Reading 0 is the 2026-10-18 manifest the source's own test grades (113 failing is warn); reading 1
/// is the same manifest with 121 failing (bad).
pub const PDV_CORPUS : [6]u32 = [2402, 113, 257, 2402, 121, 257];
/// Session readings: [calls, errors] of reading 0 (7 calls, none failed), then of reading 1 (4 calls, 1 failed).
pub const PDV_SESSION : [4]u32 = [7, 0, 4, 1];
/// The largest reply of reading 0, in bytes: the 57,084 byte t27_status reply of 2026-10-18. Reading 1 is
/// REPLY_WARN_BYTES, read from the source (pdv_reply_bytes).
pub const PDV_BIG_REPLY : u32 = 57084;

/// Milliseconds one list line takes to slide to its new place; 0 under reduced motion.
pub const PDV_ROW_MS : u32 = 40;

/// The three root slots of the host, in focus order.
pub const PDV_SLOTS : u32 = 3;
pub const PDV_SLOT_BADGE : u32 = 0;
pub const PDV_SLOT_MATRIX : u32 = 1;
pub const PDV_SLOT_LIST : u32 = 2;

/// Layout, host coordinates. A matrix row and a list line share one height and one top, so row c of the
/// matrix and line r of the list are the same y for c == r.
pub const PDV_BADGE_X : u32 = 20;
pub const PDV_BADGE_Y : u32 = 10;
pub const PDV_BADGE_W : u32 = 300;
pub const PDV_BADGE_H : u32 = 40;
pub const PDV_MATRIX_X : u32 = 20;
pub const PDV_MATRIX_Y : u32 = 70;
pub const PDV_CELL_W : u32 = 80;
pub const PDV_ROW_H : u32 = 28;
pub const PDV_LIST_X : u32 = 380;
pub const PDV_LIST_Y : u32 = 70;
pub const PDV_LIST_W : u32 = 520;
/// The flip chip sits at the right end of a list line: this far from the list's left edge, this wide.
pub const PDV_CHIP_DX : u32 = 440;
pub const PDV_CHIP_W : u32 = 60;

/// Hand-read, for the tests: for the flip set f (bit c set: check c shows its second reading) the order of
/// the checks is entries f * 6 .. f * 6 + 5. Written from the source's next_step rule by hand, not from pdv_at.
pub const PDV_HAND_ORDER : [48]u32 = [
    2, 0, 3, 4, 5, 1,
    2, 0, 3, 4, 5, 1,
    1, 2, 0, 3, 4, 5,
    1, 2, 0, 3, 4, 5,
    0, 3, 4, 5, 1, 2,
    0, 3, 4, 5, 1, 2,
    1, 0, 3, 4, 5, 2,
    1, 0, 3, 4, 5, 2,
];
/// Hand-read: the check to open first for each flip set; 65535 when the source says nothing needs action.
pub const PDV_HAND_PICK : [8]u32 = [2, 2, 1, 1, 65535, 0, 1, 1];
/// Hand-read: how many checks the source asks for, for each flip set.
pub const PDV_HAND_ACTIONABLE : [8]u32 = [1, 2, 2, 3, 0, 1, 1, 2];
/// Hand-read: how many checks pass (grade ok) for each flip set.
pub const PDV_HAND_PASS : [8]u32 = [1, 1, 0, 0, 2, 2, 1, 1];

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the flip set.
pub struct PdvState {
    viz: VizState,
    flips: u32,
}

/// A petal loaded with n entities and the truth t: LOAD, then LOADED. n = 0 gives the EMPTY view. The view
/// has no stepper and no choice, so both counts are 0.
pub fn pdv_open_with(n: u32, t: u8) -> PdvState {
    var v : VizState = viz_init(0, 0);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, n, t as u32);
    return PdvState { viz: v, flips: 0 };
}

/// A petal ready to explore: every check and chip focusable, the plan row's truth VERIFIED.
pub fn pdv_open() -> PdvState {
    return pdv_open_with(PDV_ITEMS, VIZ_TRUTH_VERIFIED);
}

/// Flip the reading of measured check c. Ignored unless the view is READY and c is a measured check.
/// The revision moves once per flip.
pub fn pdv_toggle(p: PdvState, c: u32) -> PdvState {
    if (p.viz.lifecycle != VIZ_LC_READY or c >= PDV_MEASURED) {
        return p;
    }
    var n : PdvState = p;
    var v : VizState = p.viz;
    let bit : u32 = (1 as u32) << c;
    if ((p.flips & bit) != 0) {
        n.flips = p.flips - bit;
    } else {
        n.flips = p.flips + bit;
    }
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// The one reducer of the petal. Contract events go to viz_apply; PDV_EV_FLIP (a = measured check) flips a
/// reading. The flip set lives outside the VizState, so a reload keeps it.
pub fn pdv_apply(p: PdvState, ev: u8, a: u32, b: u32) -> PdvState {
    if (ev == PDV_EV_FLIP) {
        return pdv_toggle(p, a);
    }
    var n : PdvState = p;
    n.viz = viz_apply(p.viz, ev, a, b);
    return n;
}

; ---------------------------------------------------------------- L2 entities

/// The entity of check c; VIZ_REF_NONE for a number that is not a check.
pub fn pdv_check_ref(c: u32) -> u32 {
    if (c >= PDV_CHECKS) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_NODE, c);
}

/// The entity of the flip chip of measured check c (the contract's EDGE kind); VIZ_REF_NONE past the measured.
pub fn pdv_chip_ref(c: u32) -> u32 {
    if (c >= PDV_MEASURED) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_EDGE, c);
}

/// The entity of the matrix cell of check c at status t; VIZ_REF_NONE when either is out of range.
pub fn pdv_cell_ref(c: u32, t: u32) -> u32 {
    if (c >= PDV_CHECKS or t >= PDV_TONES) {
        return VIZ_REF_NONE;
    }
    return viz_ref(VIZ_ENT_CELL, c * PDV_STRIDE + t);
}

/// The check an entity belongs to: a check itself, the check a chip flips, or the row of a cell.
/// PDV_NO_CHECK for anything else (no entity, a number past the fixture).
pub fn pdv_ref_check(r: u32) -> u32 {
    let k : u32 = viz_ref_kind(r);
    let x : u32 = viz_ref_index(r);
    if (k == VIZ_ENT_NODE and x < PDV_CHECKS) {
        return x;
    }
    if (k == VIZ_ENT_EDGE and x < PDV_MEASURED) {
        return x;
    }
    if (k == VIZ_ENT_CELL and x / PDV_STRIDE < PDV_CHECKS and x % PDV_STRIDE < PDV_TONES) {
        return x / PDV_STRIDE;
    }
    return PDV_NO_CHECK;
}

/// The entity of focus index f: the checks in listing order, then the chips. VIZ_REF_NONE past the end or
/// while the view is not READY.
pub fn pdv_focus_ref(p: PdvState, f: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or f >= p.viz.focus_count) {
        return VIZ_REF_NONE;
    }
    if (f < PDV_CHECKS) {
        return pdv_check_ref(f);
    }
    if (f < PDV_ITEMS) {
        return pdv_chip_ref(f - PDV_CHECKS);
    }
    return VIZ_REF_NONE;
}

/// A click or tap on entity r: a chip flips its check's reading; a check or a matrix cell selects its check;
/// anything else is ignored.
pub fn pdv_click(p: PdvState, r: u32) -> PdvState {
    let k : u32 = viz_ref_kind(r);
    let x : u32 = viz_ref_index(r);
    if (k == VIZ_ENT_EDGE and x < PDV_MEASURED) {
        return pdv_apply(p, PDV_EV_FLIP, x, 0);
    }
    if (pdv_ref_check(r) != PDV_NO_CHECK) {
        return pdv_apply(p, VIZ_EV_SELECT, r, 0);
    }
    return p;
}

/// The keyboard's Enter on the focused item: a chip flips its reading, a check is activated (selected, or
/// cleared when it already is). Nothing focused is a no-op.
pub fn pdv_activate(p: PdvState) -> PdvState {
    let r : u32 = pdv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    if (viz_ref_kind(r) == VIZ_ENT_EDGE) {
        return pdv_click(p, r);
    }
    return pdv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// The name of check c: the source's panel titles for the first two, the petal's own for the reply, and the
/// source's own sentence for each check the page cannot know; "" out of range.
pub fn pdv_check_name(c: u32) -> str {
    if (c < 2) {
        return PANEL_TITLES[c as usize];
    }
    if (c == PDV_C_REPLY) {
        return PDV_REPLY_NAME;
    }
    if (c < PDV_CHECKS) {
        return UNKNOWN_TEXT[(c - PDV_MEASURED) as usize];
    }
    return "";
}

/// The name of status t (the source's grade name); "" out of range.
pub fn pdv_tone_name(t: u32) -> str {
    if (t >= PDV_TONES) {
        return "";
    }
    return TONE_NAME[t as usize];
}

; ---------------------------------------------------------------- L3 readings and grades

/// Which of its two readings measured check c shows under the flip set: 0 the recorded one, 1 the what-if.
/// 0 for a check that is not measured.
pub fn pdv_reading(flips: u32, c: u32) -> u32 {
    if (c >= PDV_MEASURED) {
        return 0;
    }
    if ((flips & ((1 as u32) << c)) != 0) {
        return 1;
    }
    return 0;
}

/// The largest reply of reading `rd` in bytes: the recorded 57,084 for reading 0, the source's own warn
/// threshold for reading 1 (exactly on it, which the source grades ok because the threshold is exclusive).
pub fn pdv_reply_bytes(rd: u32) -> u32 {
    if (rd == 0) {
        return PDV_BIG_REPLY;
    }
    return REPLY_WARN_BYTES;
}

/// The grade of check c under the flip set: the source's tone function over the check's reading. The checks
/// the page cannot know are UNKNOWN; PDV_TONE_NONE for a check that does not exist.
pub fn pdv_tone_at(flips: u32, c: u32) -> u32 {
    if (c >= PDV_CHECKS) {
        return PDV_TONE_NONE;
    }
    if (c >= PDV_MEASURED) {
        return T_UNKNOWN;
    }
    let rd : u32 = pdv_reading(flips, c);
    if (c == PDV_C_CORPUS) {
        return health_tone(PDV_CORPUS[(rd * 3) as usize], PDV_CORPUS[(rd * 3 + 1) as usize], PDV_CORPUS[(rd * 3 + 2) as usize]);
    }
    if (c == PDV_C_SESSION) {
        return calls_tone(PDV_SESSION[(rd * 2) as usize], PDV_SESSION[(rd * 2 + 1) as usize]);
    }
    return reply_tone(pdv_reply_bytes(rd));
}

/// The grade of check c under the state; PDV_TONE_NONE until the view is READY.
pub fn pdv_tone(p: PdvState, c: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PDV_TONE_NONE;
    }
    return pdv_tone_at(p.flips, c);
}

/// The most severe grade among the three measured checks (the source's worst, joined twice).
pub fn pdv_worst_tone(p: PdvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PDV_TONE_NONE;
    }
    return worst(worst(pdv_tone(p, PDV_C_CORPUS), pdv_tone(p, PDV_C_SESSION)), pdv_tone(p, PDV_C_REPLY));
}

/// How many checks show status t under the state.
pub fn pdv_count_tone(p: PdvState, t: u32) -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    while (c < PDV_CHECKS) {
        if (pdv_tone(p, c) == t) {
            n = n + 1;
        }
        c = c + 1;
    }
    return n;
}

/// How many checks pass: the ones graded ok. A check graded unknown does not pass.
pub fn pdv_passing(p: PdvState) -> u32 {
    return pdv_count_tone(p, T_OK);
}

; ---------------------------------------------------------------- L4 which first, and the order

/// The check each answer of the source's next_step sends you to, for three measured grades: a failed call
/// and "no call yet" send you to the session, an oversized reply to the reply, a failing corpus to the
/// corpus. PDV_NO_CHECK when the source says nothing needs action.
pub fn pdv_pick_of(h: u32, k: u32, y: u32) -> u32 {
    let n : u32 = next_step(h, k, y);
    if (n == N_ERRORS or n == N_START) {
        return PDV_C_SESSION;
    }
    if (n == N_BIG) {
        return PDV_C_REPLY;
    }
    if (n == N_FAILING) {
        return PDV_C_CORPUS;
    }
    return PDV_NO_CHECK;
}

/// The source's answer for the state: an index into NEXT_TEXT; PDV_NO_NEXT until the view is READY.
pub fn pdv_next(p: PdvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PDV_NO_NEXT;
    }
    return next_step(pdv_tone(p, PDV_C_CORPUS), pdv_tone(p, PDV_C_SESSION), pdv_tone(p, PDV_C_REPLY));
}

/// The sentence of the source's answer, as the page prints it; "" until the view is READY.
pub fn pdv_next_text(p: PdvState) -> str {
    let n : u32 = pdv_next(p);
    if (n > N_READY) {
        return "";
    }
    return NEXT_TEXT[n as usize];
}

/// The check to open first: the source's pick; PDV_NO_CHECK when nothing needs action or the view is not READY.
pub fn pdv_pick(p: PdvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return PDV_NO_CHECK;
    }
    return pdv_pick_of(pdv_tone(p, PDV_C_CORPUS), pdv_tone(p, PDV_C_SESSION), pdv_tone(p, PDV_C_REPLY));
}

/// The check the source asks for in round `round` of asking again: pick, treat that check as fixed (ok),
/// ask again. PDV_NO_CHECK once nothing is left, in every later round too.
pub fn pdv_peel(p: PdvState, round: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or round >= PDV_MEASURED) {
        return PDV_NO_CHECK;
    }
    var h : u32 = pdv_tone(p, PDV_C_CORPUS);
    var k : u32 = pdv_tone(p, PDV_C_SESSION);
    var y : u32 = pdv_tone(p, PDV_C_REPLY);
    var w : u32 = PDV_NO_CHECK;
    var i : u32 = 0;
    while (i <= round) {
        w = pdv_pick_of(h, k, y);
        if (w == PDV_C_CORPUS) {
            h = T_OK;
        }
        if (w == PDV_C_SESSION) {
            k = T_OK;
        }
        if (w == PDV_C_REPLY) {
            y = T_OK;
        }
        i = i + 1;
    }
    return w;
}

/// How many checks the source asks for: the rounds of asking again that still name a check.
pub fn pdv_actionable(p: PdvState) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < PDV_MEASURED) {
        if (pdv_peel(p, i) != PDV_NO_CHECK) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The checks the source asks for, as a bit set (bit c is check c).
pub fn pdv_placed(p: PdvState) -> u32 {
    var m : u32 = 0;
    var i : u32 = 0;
    while (i < PDV_MEASURED) {
        let w : u32 = pdv_peel(p, i);
        if (w != PDV_NO_CHECK) {
            m = m | ((1 as u32) << w);
        }
        i = i + 1;
    }
    return m;
}

/// The check at line r of the list. The checks the source asks for come first, in the order it asks; the
/// rest follow by grade, most severe first, ties in listing order. PDV_NO_CHECK past the last line or
/// while the view is not READY.
pub fn pdv_at(p: PdvState, r: u32) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY or r >= PDV_CHECKS) {
        return PDV_NO_CHECK;
    }
    let m : u32 = pdv_actionable(p);
    if (r < m) {
        return pdv_peel(p, r);
    }
    var placed : u32 = pdv_placed(p);
    var n : u32 = m;
    while (n <= r) {
        var best : u32 = PDV_NO_CHECK;
        var c : u32 = 0;
        while (c < PDV_CHECKS) {
            if ((placed & ((1 as u32) << c)) == 0) {
                if (best == PDV_NO_CHECK or pdv_tone(p, c) > pdv_tone(p, best)) {
                    best = c;
                }
            }
            c = c + 1;
        }
        if (n == r) {
            return best;
        }
        placed = placed | ((1 as u32) << best);
        n = n + 1;
    }
    return PDV_NO_CHECK;
}

/// The line of the list that holds check c; PDV_NO_CHECK when the check is not listed.
pub fn pdv_row_of(p: PdvState, c: u32) -> u32 {
    var r : u32 = 0;
    while (r < PDV_CHECKS) {
        if (pdv_at(p, r) == c) {
            return r;
        }
        r = r + 1;
    }
    return PDV_NO_CHECK;
}

/// How many lines of the list hold a different check in state b than in state a.
pub fn pdv_rows_moved(a: PdvState, b: PdvState) -> u32 {
    var n : u32 = 0;
    var r : u32 = 0;
    while (r < PDV_CHECKS) {
        if (pdv_at(a, r) != pdv_at(b, r)) {
            n = n + 1;
        }
        r = r + 1;
    }
    return n;
}

/// How long the list takes to re-sort from state a to state b: PDV_ROW_MS per line that moved, and 0 when
/// the user asked for reduced motion (b's preference).
pub fn pdv_resort_ms(a: PdvState, b: PdvState) -> u32 {
    return viz_motion_ms(b.viz, pdv_rows_moved(a, b) * PDV_ROW_MS);
}

; ---------------------------------------------------------------- L5 views: cells, lines, highlight

/// The matrix cell of check c at status t: lit when the check shows that status, NONE until READY.
pub fn pdv_cell(p: PdvState, c: u32, t: u32) -> u8 {
    if (p.viz.lifecycle != VIZ_LC_READY or c >= PDV_CHECKS or t >= PDV_TONES) {
        return PDV_CELL_NONE;
    }
    if (pdv_tone(p, c) == t) {
        return PDV_CELL_ON;
    }
    return PDV_CELL_OFF;
}

/// The status printed on line r of the list.
pub fn pdv_line_tone(p: PdvState, r: u32) -> u32 {
    return pdv_tone(p, pdv_at(p, r));
}

/// The name printed on line r of the list; "" past the last line.
pub fn pdv_line_name(p: PdvState, r: u32) -> str {
    return pdv_check_name(pdv_at(p, r));
}

/// True when measured check c shows its second reading, the what-if. False for any other check.
pub fn pdv_chip_on(p: PdvState, c: u32) -> bool {
    return pdv_reading(p.flips, c) == 1;
}

/// How check c is drawn in the matrix row and on the list line: SELECT when the selected entity belongs to
/// it, else HOVER the same way, else NONE. A chip and a cell belong to their check.
pub fn pdv_check_hl(p: PdvState, c: u32) -> u8 {
    if (c >= PDV_CHECKS) {
        return VIZ_HL_NONE;
    }
    if (pdv_ref_check(p.viz.selected) == c) {
        return VIZ_HL_SELECT;
    }
    if (pdv_ref_check(p.viz.hover) == c) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

/// How list line r is drawn: the highlight of the check that stands on it.
pub fn pdv_row_hl(p: PdvState, r: u32) -> u8 {
    return pdv_check_hl(p, pdv_at(p, r));
}

/// How the matrix cell of check c at status t is drawn: the highlight of its row.
pub fn pdv_cell_hl(p: PdvState, c: u32, t: u32) -> u8 {
    if (t >= PDV_TONES) {
        return VIZ_HL_NONE;
    }
    return pdv_check_hl(p, c);
}

/// How the flip chip of measured check c is drawn: the highlight of its check; NONE past the measured.
pub fn pdv_chip_hl(p: PdvState, c: u32) -> u8 {
    if (c >= PDV_MEASURED) {
        return VIZ_HL_NONE;
    }
    return pdv_check_hl(p, c);
}

/// Left edge of matrix column t.
pub fn pdv_cell_x(t: u32) -> u32 {
    return PDV_MATRIX_X + t * PDV_CELL_W;
}

/// Top edge of matrix row i and of list line i (they share one top).
pub fn pdv_row_y(i: u32) -> u32 {
    return PDV_MATRIX_Y + i * PDV_ROW_H;
}

/// Left edge of the flip chip on a list line.
pub fn pdv_chip_x() -> u32 {
    return PDV_LIST_X + PDV_CHIP_DX;
}

/// The cell ref under the point (host coordinates); VIZ_REF_NONE outside the matrix.
pub fn pdv_matrix_hit(px: u32, py: u32) -> u32 {
    if (px < PDV_MATRIX_X or py < PDV_MATRIX_Y) {
        return VIZ_REF_NONE;
    }
    return pdv_cell_ref((py - PDV_MATRIX_Y) / PDV_ROW_H, (px - PDV_MATRIX_X) / PDV_CELL_W);
}

/// The ref of what is under the point on the list: the chip of a measured check when the point is on the
/// chip, else the check. The line is read through the current order, so the same pixel names another check
/// once the list has re-sorted. VIZ_REF_NONE outside the list, and while the view is not READY.
pub fn pdv_list_hit(p: PdvState, px: u32, py: u32) -> u32 {
    if (px < PDV_LIST_X or px >= PDV_LIST_X + PDV_LIST_W or py < PDV_LIST_Y) {
        return VIZ_REF_NONE;
    }
    let c : u32 = pdv_at(p, (py - PDV_LIST_Y) / PDV_ROW_H);
    if (c == PDV_NO_CHECK) {
        return VIZ_REF_NONE;
    }
    if (c < PDV_MEASURED and px >= pdv_chip_x() and px < pdv_chip_x() + PDV_CHIP_W) {
        return pdv_chip_ref(c);
    }
    return pdv_check_ref(c);
}

/// The pointer at (px, py) over the list: hover what is under it, or leave when it is over nothing.
pub fn pdv_pointer_list(p: PdvState, px: u32, py: u32) -> PdvState {
    let r : u32 = pdv_list_hit(p, px, py);
    if (r == VIZ_REF_NONE) {
        return pdv_apply(p, VIZ_EV_LEAVE, 0, 0);
    }
    return pdv_apply(p, VIZ_EV_HOVER, r, 0);
}

; ---------------------------------------------------------------- L6 badge

/// The truth the badge shows. UNKNOWN until the view is READY. A stored truth that cannot claim a result
/// (CACHED, DEMO, UNKNOWN) is kept. Otherwise VERIFIED, because no host feeds this petal so LIVE is never
/// shown, and DEMO as soon as any reading is flipped away from the recorded one.
pub fn pdv_badge(p: PdvState) -> u8 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return VIZ_TRUTH_UNKNOWN;
    }
    if (viz_may_claim(p.viz.truth) == false) {
        return viz_truth(p.viz.truth);
    }
    if (p.flips != 0) {
        return VIZ_TRUTH_DEMO;
    }
    return VIZ_TRUTH_VERIFIED;
}

/// True when the badge lets the view present its order as a result.
pub fn pdv_claims(p: PdvState) -> bool {
    return viz_may_claim(pdv_badge(p));
}

; ---------------------------------------------------------------- L7 host

/// The layout: the badge, the matrix and the list, three root slots in focus order.
pub fn pdv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PDV_BADGE_X, PDV_BADGE_Y, PDV_BADGE_W, PDV_BADGE_H);
    h = vh_add(h, VIZ_REP_MATRIX, VH_ROOT, PDV_MATRIX_X, PDV_MATRIX_Y, PDV_TONES * PDV_CELL_W, PDV_CHECKS * PDV_ROW_H);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, PDV_LIST_X, PDV_LIST_Y, PDV_LIST_W, PDV_CHECKS * PDV_ROW_H);
    return h;
}

/// The petal's slots placed under slot `at` of a larger host, offset by (ox, oy): the petal is reused by
/// embedding its host, not by copying its logic.
pub fn pdv_in_frame(frame: VizHost, at: u32, ox: u32, oy: u32) -> VizHost {
    return vh_embed(frame, pdv_host(), at, ox, oy);
}

/// The reps of the petal as a bit set: matrix, list, badge (the plan row's 262).
pub fn pdv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_MATRIX) | viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// A petal that has not loaded: idle, truth UNKNOWN, no reading flipped.
fn pdv_idle() -> PdvState {
    return PdvState { viz: viz_init(0, 0), flips: 0 };
}

/// An open petal with the flip set f: bit c set means check c shows its second reading.
fn pdv_with(f: u32) -> PdvState {
    var p : PdvState = pdv_open();
    var c : u32 = 0;
    while (c < PDV_MEASURED) {
        if ((f & ((1 as u32) << c)) != 0) {
            p = pdv_apply(p, PDV_EV_FLIP, c, 0);
        }
        c = c + 1;
    }
    return p;
}

/// Test oracle: the source's own next_step over the recorded numbers of flip set f, graded by the source's
/// own tone functions and written out by hand. It reads no pdv_ table and calls no pdv_ function.
fn pdv_oracle_next(f: u32) -> u32 {
    var h : u32 = health_tone(2402, 113, 257);
    if ((f & 1) != 0) {
        h = health_tone(2402, 121, 257);
    }
    var k : u32 = calls_tone(7, 0);
    if ((f & 2) != 0) {
        k = calls_tone(4, 1);
    }
    var y : u32 = reply_tone(57084);
    if ((f & 4) != 0) {
        y = reply_tone(REPLY_WARN_BYTES);
    }
    return next_step(h, k, y);
}

; ---------------------------------------------------------------- tests: state and lifecycle

test a_fresh_petal_is_idle_unknown_and_shows_nothing {
    let p : PdvState = pdv_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert p.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert pdv_badge(p) == VIZ_TRUTH_UNKNOWN;
    assert pdv_claims(p) == false;
    assert pdv_tone(p, 0) == PDV_TONE_NONE;
    assert pdv_worst_tone(p) == PDV_TONE_NONE;
    assert pdv_cell(p, 0, 0) == PDV_CELL_NONE;
    assert pdv_pick(p) == PDV_NO_CHECK;
    assert pdv_at(p, 0) == PDV_NO_CHECK;
    assert pdv_next(p) == PDV_NO_NEXT;
    assert pdv_next_text(p) == "";
    assert pdv_passing(p) == 0;
    assert pdv_focus_ref(p, 0) == VIZ_REF_NONE;
    // A flip before the view is READY is ignored, and so is a click on a check.
    assert pdv_apply(p, PDV_EV_FLIP, 1, 0).flips == 0;
    assert viz_same(pdv_click(p, pdv_check_ref(0)).viz, p.viz);
}

test opening_loads_nine_items_and_claims_verified {
    let p : PdvState = pdv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == PDV_ITEMS;
    assert p.viz.focus_count == p.viz.item_count;
    assert p.viz.step_count == 0;
    assert p.viz.param_count == 0;
    assert p.viz.step == 0;
    assert p.viz.param == 0;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.flips == 0;
    assert pdv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert pdv_claims(p);
    assert viz_may_claim(pdv_badge(p));
}

test an_empty_fixture_is_empty_shows_nothing_and_ignores_input {
    let e : PdvState = pdv_open_with(0, VIZ_TRUTH_VERIFIED);
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert e.viz.focus_count == 0;
    assert pdv_badge(e) == VIZ_TRUTH_UNKNOWN;
    assert pdv_cell(e, 0, 0) == PDV_CELL_NONE;
    assert pdv_at(e, 0) == PDV_NO_CHECK;
    assert pdv_pick(e) == PDV_NO_CHECK;
    assert pdv_focus_ref(e, 0) == VIZ_REF_NONE;
    let picked : PdvState = pdv_apply(e, VIZ_EV_SELECT, pdv_check_ref(0), 0);
    assert viz_same(picked.viz, e.viz);
    assert pdv_row_hl(picked, 0) == VIZ_HL_NONE;
    let flipped : PdvState = pdv_apply(e, PDV_EV_FLIP, 0, 0);
    assert flipped.flips == 0;
    assert flipped.viz.revision == e.viz.revision;
    let focused : PdvState = pdv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert focused.viz.focus == VIZ_NO_FOCUS;
    assert viz_same(pdv_activate(e).viz, e.viz);
    // A reload that finds the data makes it READY again.
    let again : PdvState = pdv_apply(pdv_apply(e, VIZ_EV_LOAD, 0, 0), VIZ_EV_LOADED, PDV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert again.viz.lifecycle == VIZ_LC_READY;
    assert pdv_badge(again) == VIZ_TRUTH_VERIFIED;
    assert pdv_at(again, 0) == PDV_C_REPLY;
}

test a_failed_load_is_an_error_that_ignores_input_until_a_retry_succeeds {
    var s : PdvState = pdv_apply(pdv_open(), VIZ_EV_FAILED, 7, 0);
    assert s.viz.lifecycle == VIZ_LC_ERROR;
    assert s.viz.error == 7;
    assert pdv_badge(s) == VIZ_TRUTH_UNKNOWN;
    assert pdv_cell(s, 0, 0) == PDV_CELL_NONE;
    assert pdv_at(s, 0) == PDV_NO_CHECK;
    assert viz_same(pdv_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0).viz, s.viz);
    assert pdv_apply(s, PDV_EV_FLIP, 2, 0).flips == 0;
    s = pdv_apply(s, VIZ_EV_RETRY, 0, 0);
    assert s.viz.lifecycle == VIZ_LC_LOADING;
    assert pdv_badge(s) == VIZ_TRUTH_UNKNOWN;
    s = pdv_apply(s, VIZ_EV_LOADED, PDV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert s.viz.lifecycle == VIZ_LC_READY;
    assert s.viz.error == 0;
    assert pdv_badge(s) == VIZ_TRUTH_VERIFIED;
    // Error code 0 reads as the unspecified error, never as "no error".
    assert pdv_apply(pdv_open(), VIZ_EV_FAILED, 0, 0).viz.error == VIZ_ERR_UNSPECIFIED;
}

test the_stepper_and_the_choice_have_nothing_to_do_in_this_row {
    // The plan row is matrix + list + badge: no stepper and no choice, so those events are inert.
    let p : PdvState = pdv_open();
    let a : PdvState = pdv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    let b : PdvState = pdv_apply(p, VIZ_EV_STEP_SET, 3, 0);
    let c : PdvState = pdv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    let d : PdvState = pdv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert viz_same(a.viz, p.viz);
    assert viz_same(b.viz, p.viz);
    assert viz_same(c.viz, p.viz);
    assert viz_same(d.viz, p.viz);
    assert a.viz.revision == p.viz.revision;
    assert d.viz.revision == p.viz.revision;
    // What the view shows depends on the flip set alone.
    assert pdv_at(d, 0) == pdv_at(p, 0);
    assert pdv_tone(b, 2) == pdv_tone(p, 2);
    assert pdv_badge(d) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- tests: the fixture and its names

test the_fixture_sizes_and_names_come_from_the_source_spec {
    // The shape of the source's tables: four grades, three things the page cannot know.
    assert TONE_NAME.len == 4;
    assert UNKNOWN_TEXT.len == 3;
    assert PDV_TONES == 4;
    assert PDV_CHECKS - PDV_MEASURED == 3;
    assert PDV_ITEMS == PDV_CHECKS + PDV_MEASURED;
    // The matrix columns are the source's grades in the source's order of severity.
    assert T_OK == 0;
    assert T_BAD == PDV_TONES - 1;
    assert pdv_tone_name(T_OK) == TONE_NAME[0];
    assert pdv_tone_name(T_UNKNOWN) == TONE_NAME[1];
    assert pdv_tone_name(T_WARN) == TONE_NAME[2];
    assert pdv_tone_name(T_BAD) == TONE_NAME[3];
    assert pdv_tone_name(PDV_TONES) == "";
    // The titles of the first two checks are the source's panel titles; the last three are its own
    // sentences about what the page cannot know.
    assert pdv_check_name(PDV_C_CORPUS) == PANEL_TITLES[0];
    assert pdv_check_name(PDV_C_SESSION) == PANEL_TITLES[1];
    assert pdv_check_name(PDV_C_REPLY) == PDV_REPLY_NAME;
    assert pdv_check_name(PDV_C_SEAL) == UNKNOWN_TEXT[0];
    assert pdv_check_name(PDV_C_RECEIPT) == UNKNOWN_TEXT[1];
    assert pdv_check_name(PDV_C_CI) == UNKNOWN_TEXT[2];
    assert pdv_check_name(PDV_CHECKS) == "";
    // The recorded readings, written down once: guard them against an edit that moves the grades.
    assert PDV_CORPUS[0] == 2402;
    assert PDV_CORPUS[1] == 113;
    assert PDV_CORPUS[4] == 121;
    assert PDV_SESSION[0] == 7;
    assert PDV_SESSION[2] == 4;
    assert PDV_SESSION[3] == 1;
    assert PDV_BIG_REPLY == 57084;
    assert pdv_reply_bytes(0) == 57084;
    assert pdv_reply_bytes(1) == REPLY_WARN_BYTES;
}

test refs_pack_unpack_and_a_ref_outside_the_fixture_names_no_check {
    var c : u32 = 0;
    while (c < PDV_CHECKS) {
        assert pdv_ref_check(pdv_check_ref(c)) == c;
        assert viz_ref_kind(pdv_check_ref(c)) == VIZ_ENT_NODE;
        var t : u32 = 0;
        while (t < PDV_TONES) {
            assert pdv_ref_check(pdv_cell_ref(c, t)) == c;
            assert viz_ref_kind(pdv_cell_ref(c, t)) == VIZ_ENT_CELL;
            t = t + 1;
        }
        c = c + 1;
    }
    var m : u32 = 0;
    while (m < PDV_MEASURED) {
        assert pdv_ref_check(pdv_chip_ref(m)) == m;
        assert viz_ref_kind(pdv_chip_ref(m)) == VIZ_ENT_EDGE;
        m = m + 1;
    }
    assert pdv_cell_ref(1, 0) == pdv_cell_ref(0, 0) + PDV_STRIDE;
    // Outside the fixture: no ref is made, and a ref made by hand names no check.
    assert pdv_check_ref(PDV_CHECKS) == VIZ_REF_NONE;
    assert pdv_chip_ref(PDV_MEASURED) == VIZ_REF_NONE;
    assert pdv_cell_ref(PDV_CHECKS, 0) == VIZ_REF_NONE;
    assert pdv_cell_ref(0, PDV_TONES) == VIZ_REF_NONE;
    assert pdv_ref_check(VIZ_REF_NONE) == PDV_NO_CHECK;
    assert pdv_ref_check(viz_ref(VIZ_ENT_NODE, PDV_CHECKS)) == PDV_NO_CHECK;
    assert pdv_ref_check(viz_ref(VIZ_ENT_EDGE, PDV_MEASURED)) == PDV_NO_CHECK;
    assert pdv_ref_check(viz_ref(VIZ_ENT_CELL, PDV_CHECKS * PDV_STRIDE)) == PDV_NO_CHECK;
    // Selecting such a ref is stored by the reducer but lights nothing in any view.
    let bad : u32 = viz_ref(VIZ_ENT_NODE, PDV_CHECKS);
    let s : PdvState = pdv_apply(pdv_open(), VIZ_EV_SELECT, bad, 0);
    assert s.viz.selected == bad;
    var k : u32 = 0;
    while (k < PDV_CHECKS) {
        assert pdv_check_hl(s, k) == VIZ_HL_NONE;
        assert pdv_row_hl(s, k) == VIZ_HL_NONE;
        k = k + 1;
    }
    assert pdv_check_hl(s, PDV_CHECKS) == VIZ_HL_NONE;
    assert pdv_cell_hl(s, 0, PDV_TONES) == VIZ_HL_NONE;
}

; ---------------------------------------------------------------- tests: the source's grades and its pick

test the_recorded_readings_are_graded_by_the_sources_own_functions {
    let p : PdvState = pdv_open();
    assert pdv_tone(p, PDV_C_CORPUS) == health_tone(2402, 113, 257);
    assert pdv_tone(p, PDV_C_CORPUS) == T_WARN;
    assert pdv_tone(p, PDV_C_SESSION) == calls_tone(7, 0);
    assert pdv_tone(p, PDV_C_SESSION) == T_OK;
    assert pdv_tone(p, PDV_C_REPLY) == reply_tone(57084);
    assert pdv_tone(p, PDV_C_REPLY) == T_BAD;
    // The second readings are the what-ifs the source's own tests grade.
    let q : PdvState = pdv_with(7);
    assert pdv_tone(q, PDV_C_CORPUS) == health_tone(2402, 121, 257);
    assert pdv_tone(q, PDV_C_CORPUS) == T_BAD;
    assert pdv_tone(q, PDV_C_SESSION) == calls_tone(4, 1);
    assert pdv_tone(q, PDV_C_SESSION) == T_BAD;
    assert pdv_tone(q, PDV_C_REPLY) == reply_tone(REPLY_WARN_BYTES);
    assert pdv_tone(q, PDV_C_REPLY) == T_OK;
    // The three checks the page cannot know are unknown under every flip set, and unknown is not ok.
    var f : u32 = 0;
    while (f < 8) {
        assert pdv_tone_at(f, PDV_C_SEAL) == T_UNKNOWN;
        assert pdv_tone_at(f, PDV_C_RECEIPT) == T_UNKNOWN;
        assert pdv_tone_at(f, PDV_C_CI) == T_UNKNOWN;
        f = f + 1;
    }
    assert worst(T_OK, pdv_tone(p, PDV_C_SEAL)) == T_UNKNOWN;
    assert worst(T_OK, pdv_tone(p, PDV_C_SEAL)) != T_OK;
    assert pdv_tone(p, PDV_CHECKS) == PDV_TONE_NONE;
    assert pdv_tone_at(0, PDV_CHECKS) == PDV_TONE_NONE;
}

test the_pick_maps_each_next_step_answer_to_the_check_that_answers_it {
    // A failed call comes before everything: the session.
    assert next_step(T_BAD, T_WARN, T_BAD) == N_ERRORS;
    assert pdv_pick_of(T_BAD, T_WARN, T_BAD) == PDV_C_SESSION;
    // Then an oversized reply: the reply.
    assert next_step(T_BAD, T_OK, T_BAD) == N_BIG;
    assert pdv_pick_of(T_BAD, T_OK, T_BAD) == PDV_C_REPLY;
    // Then a failing corpus: the corpus.
    assert next_step(T_BAD, T_OK, T_WARN) == N_FAILING;
    assert pdv_pick_of(T_BAD, T_OK, T_WARN) == PDV_C_CORPUS;
    // No call yet: make the first one, in the session.
    assert next_step(T_OK, T_UNKNOWN, T_UNKNOWN) == N_START;
    assert pdv_pick_of(T_OK, T_UNKNOWN, T_UNKNOWN) == PDV_C_SESSION;
    // Nothing to fix: no check.
    assert next_step(T_OK, T_OK, T_OK) == N_READY;
    assert pdv_pick_of(T_OK, T_OK, T_OK) == PDV_NO_CHECK;
    // A warning is not an instruction: a warning-sized reply on a warning corpus needs no action.
    assert next_step(T_WARN, T_OK, T_WARN) == N_READY;
    assert pdv_pick_of(T_WARN, T_OK, T_WARN) == PDV_NO_CHECK;
    assert pdv_pick_of(T_WARN, T_OK, reply_tone(REPLY_WARN_BYTES + 1)) == PDV_NO_CHECK;
    // One byte past the bad threshold is an instruction.
    assert pdv_pick_of(T_OK, T_OK, reply_tone(REPLY_BAD_BYTES + 1)) == PDV_C_REPLY;
    assert pdv_pick_of(T_OK, T_OK, reply_tone(REPLY_BAD_BYTES)) == PDV_NO_CHECK;
}

test the_recorded_snapshot_asks_for_the_reply_check_first {
    let p : PdvState = pdv_open();
    let want : u32 = next_step(health_tone(2402, 113, 257), calls_tone(7, 0), reply_tone(57084));
    assert want == N_BIG;
    assert pdv_next(p) == want;
    assert pdv_next_text(p) == NEXT_TEXT[want as usize];
    assert pdv_pick(p) == PDV_C_REPLY;
    assert pdv_at(p, 0) == PDV_C_REPLY;
    // One check passes (the session), one warns (the corpus), one is bad (the reply), three are unknown.
    assert pdv_passing(p) == 1;
    assert pdv_count_tone(p, T_WARN) == 1;
    assert pdv_count_tone(p, T_BAD) == 1;
    assert pdv_count_tone(p, T_UNKNOWN) == 3;
    assert pdv_worst_tone(p) == T_BAD;
    assert pdv_worst_tone(p) == worst(worst(T_WARN, T_OK), T_BAD);
    assert pdv_chip_on(p, 0) == false;
    assert pdv_chip_on(p, 1) == false;
    assert pdv_chip_on(p, 2) == false;
}

; ---------------------------------------------------------------- tests: the input change

test flipping_the_session_chip_makes_it_the_first_check_to_open {
    let s0 : PdvState = pdv_open();
    let s1 : PdvState = pdv_click(s0, pdv_chip_ref(1));
    assert s1.flips == 2;
    assert s1.viz.revision == s0.viz.revision + 1;
    assert pdv_chip_on(s1, 1);
    // The session now reads 4 calls with 1 error, graded by the source straight.
    assert pdv_tone(s1, PDV_C_SESSION) == calls_tone(4, 1);
    assert pdv_tone(s1, PDV_C_SESSION) == T_BAD;
    // The source's answer changes from "a reply is too big" to "a tool call failed".
    let want : u32 = next_step(health_tone(2402, 113, 257), calls_tone(4, 1), reply_tone(57084));
    assert want == N_ERRORS;
    assert pdv_next(s1) == want;
    assert pdv_next_text(s1) == NEXT_TEXT[N_ERRORS as usize];
    assert pdv_pick(s1) == PDV_C_SESSION;
    // The list recomputes: session, then the reply the source still asks for, then the corpus.
    assert pdv_at(s1, 0) == PDV_C_SESSION;
    assert pdv_at(s1, 1) == PDV_C_REPLY;
    assert pdv_at(s1, 2) == PDV_C_CORPUS;
    assert pdv_actionable(s1) == 2;
    assert pdv_rows_moved(s0, s1) == 6;
    // The session no longer passes, and the other two readings did not move.
    assert pdv_passing(s0) == 1;
    assert pdv_passing(s1) == 0;
    assert pdv_tone(s1, PDV_C_CORPUS) == pdv_tone(s0, PDV_C_CORPUS);
    assert pdv_tone(s1, PDV_C_REPLY) == pdv_tone(s0, PDV_C_REPLY);
    // The badge recomputes too: the readings left the recorded data.
    assert pdv_badge(s0) == VIZ_TRUTH_VERIFIED;
    assert pdv_badge(s1) == VIZ_TRUTH_DEMO;
}

test every_flip_set_agrees_with_the_source_and_the_hand_tables {
    var f : u32 = 0;
    while (f < 8) {
        let p : PdvState = pdv_with(f);
        assert p.flips == f;
        // The answer, straight from the source over the recorded numbers.
        assert pdv_next(p) == pdv_oracle_next(f);
        assert pdv_next_text(p) == NEXT_TEXT[pdv_oracle_next(f) as usize];
        // The pick, the count of checks the source asks for and the passes, from the hand tables.
        assert pdv_pick(p) == PDV_HAND_PICK[f as usize];
        assert pdv_actionable(p) == PDV_HAND_ACTIONABLE[f as usize];
        assert pdv_passing(p) == PDV_HAND_PASS[f as usize];
        var r : u32 = 0;
        while (r < PDV_CHECKS) {
            assert pdv_at(p, r) == PDV_HAND_ORDER[(f * PDV_CHECKS + r) as usize];
            r = r + 1;
        }
        // The first line is the pick whenever the source names one.
        if (pdv_pick(p) != PDV_NO_CHECK) {
            assert pdv_at(p, 0) == pdv_pick(p);
        }
        f = f + 1;
    }
}

test a_flip_outside_the_chips_or_before_ready_is_ignored {
    let p : PdvState = pdv_open();
    // Only the three measured checks have a chip.
    assert viz_same(pdv_apply(p, PDV_EV_FLIP, 3, 0).viz, p.viz);
    assert pdv_apply(p, PDV_EV_FLIP, 3, 0).flips == 0;
    assert pdv_apply(p, PDV_EV_FLIP, 99, 0).flips == 0;
    assert pdv_apply(p, PDV_EV_FLIP, 99, 0).viz.revision == p.viz.revision;
    assert pdv_apply(p, PDV_EV_FLIP, PDV_NO_CHECK, 0).flips == 0;
    // A click on a check or a cell selects it and does not flip anything.
    let sel : PdvState = pdv_click(p, pdv_check_ref(3));
    assert sel.flips == 0;
    assert sel.viz.selected == pdv_check_ref(3);
    let cell : PdvState = pdv_click(p, pdv_cell_ref(0, 2));
    assert cell.flips == 0;
    assert cell.viz.selected == pdv_cell_ref(0, 2);
    // A click on nothing, on a number past the fixture or on a chip that does not exist is ignored.
    assert viz_same(pdv_click(p, VIZ_REF_NONE).viz, p.viz);
    assert viz_same(pdv_click(p, viz_ref(VIZ_ENT_NODE, PDV_CHECKS)).viz, p.viz);
    assert pdv_click(p, viz_ref(VIZ_ENT_EDGE, PDV_MEASURED)).flips == 0;
    assert pdv_click(p, viz_ref(VIZ_ENT_EDGE, PDV_MEASURED)).viz.revision == p.viz.revision;
}

test a_big_reply_stays_ahead_of_a_failing_corpus_until_it_is_fixed {
    // Flip the corpus to 121 failing: the corpus is now bad too, and the reply is still bad.
    let p : PdvState = pdv_click(pdv_open(), pdv_chip_ref(0));
    assert pdv_tone(p, PDV_C_CORPUS) == T_BAD;
    assert pdv_tone(p, PDV_C_REPLY) == T_BAD;
    // The source puts size before health, so the pick does not move.
    assert next_step(health_tone(2402, 121, 257), calls_tone(7, 0), reply_tone(57084)) == N_BIG;
    assert pdv_pick(p) == PDV_C_REPLY;
    assert pdv_at(p, 0) == PDV_C_REPLY;
    assert pdv_at(p, 1) == PDV_C_CORPUS;
    assert pdv_actionable(p) == 2;
    // Fix the reply (flip it to the warn threshold): now the failing corpus is the one to open.
    let q : PdvState = pdv_click(p, pdv_chip_ref(2));
    assert pdv_tone(q, PDV_C_REPLY) == T_OK;
    assert next_step(health_tone(2402, 121, 257), calls_tone(7, 0), reply_tone(REPLY_WARN_BYTES)) == N_FAILING;
    assert pdv_next(q) == N_FAILING;
    assert pdv_pick(q) == PDV_C_CORPUS;
    assert pdv_at(q, 0) == PDV_C_CORPUS;
    assert pdv_actionable(q) == 1;
}

test when_nothing_needs_action_there_is_no_pick_and_the_text_says_so {
    // Flip the reply to the warn threshold: the source grades it ok, and the corpus only warns.
    let p : PdvState = pdv_click(pdv_open(), pdv_chip_ref(2));
    assert pdv_tone(p, PDV_C_REPLY) == T_OK;
    let want : u32 = next_step(health_tone(2402, 113, 257), calls_tone(7, 0), reply_tone(REPLY_WARN_BYTES));
    assert want == N_READY;
    assert pdv_next(p) == want;
    assert pdv_next_text(p) == NEXT_TEXT[N_READY as usize];
    assert pdv_pick(p) == PDV_NO_CHECK;
    assert pdv_actionable(p) == 0;
    assert pdv_placed(p) == 0;
    // The list still ranks: the warning corpus leads, the unknowns follow, the passing checks come last.
    assert pdv_at(p, 0) == PDV_C_CORPUS;
    assert pdv_line_tone(p, 0) == T_WARN;
    assert pdv_line_tone(p, 1) == T_UNKNOWN;
    assert pdv_line_tone(p, 4) == T_OK;
    assert pdv_line_tone(p, 5) == T_OK;
    assert pdv_passing(p) == 2;
    assert pdv_worst_tone(p) == T_WARN;
}

; ---------------------------------------------------------------- tests: the order

test the_order_is_a_permutation_with_the_source_picks_first {
    var f : u32 = 0;
    while (f < 8) {
        let p : PdvState = pdv_with(f);
        var seen : u32 = 0;
        var r : u32 = 0;
        while (r < PDV_CHECKS) {
            let c : u32 = pdv_at(p, r);
            assert c < PDV_CHECKS;
            let bit : u32 = (1 as u32) << c;
            assert (seen & bit) == 0;
            seen = seen | bit;
            assert pdv_row_of(p, c) == r;
            r = r + 1;
        }
        assert seen == ((1 as u32) << PDV_CHECKS) - 1;
        assert pdv_at(p, PDV_CHECKS) == PDV_NO_CHECK;
        assert pdv_row_of(p, PDV_CHECKS) == PDV_NO_CHECK;
        // The checks the source asks for are exactly the first lines, as a set.
        var asked : u32 = 0;
        var j : u32 = 0;
        while (j < pdv_actionable(p)) {
            asked = asked | ((1 as u32) << pdv_at(p, j));
            j = j + 1;
        }
        assert asked == pdv_placed(p);
        f = f + 1;
    }
}

test after_the_picks_the_order_runs_by_severity_then_by_listing {
    var f : u32 = 0;
    while (f < 8) {
        let p : PdvState = pdv_with(f);
        let m : u32 = pdv_actionable(p);
        var r : u32 = 0;
        while (r < m) {
            // Every check the source asks for is bad in this fixture, and it is asked in the peel order.
            assert pdv_at(p, r) == pdv_peel(p, r);
            assert pdv_tone(p, pdv_at(p, r)) == T_BAD;
            r = r + 1;
        }
        // The rest: never less severe than the line after it; equal grades keep the listing order.
        r = m;
        while (r + 1 < PDV_CHECKS) {
            let a : u32 = pdv_at(p, r);
            let b : u32 = pdv_at(p, r + 1);
            assert pdv_tone(p, a) >= pdv_tone(p, b);
            if (pdv_tone(p, a) == pdv_tone(p, b)) {
                assert a < b;
            }
            r = r + 1;
        }
        // Asking again past the last pick finds nothing, and so does every later round.
        assert pdv_peel(p, m) == PDV_NO_CHECK;
        assert pdv_peel(p, PDV_MEASURED) == PDV_NO_CHECK;
        f = f + 1;
    }
}

; ---------------------------------------------------------------- tests: the views

test the_matrix_marks_one_status_per_check_and_the_list_agrees {
    var f : u32 = 0;
    while (f < 8) {
        let p : PdvState = pdv_with(f);
        var c : u32 = 0;
        while (c < PDV_CHECKS) {
            var lit : u32 = 0;
            var t : u32 = 0;
            while (t < PDV_TONES) {
                if (pdv_cell(p, c, t) == PDV_CELL_ON) {
                    lit = lit + 1;
                    assert t == pdv_tone(p, c);
                } else {
                    assert pdv_cell(p, c, t) == PDV_CELL_OFF;
                }
                t = t + 1;
            }
            assert lit == 1;
            c = c + 1;
        }
        // Every status column counts its lit cells, and the columns add up to the checks.
        assert pdv_count_tone(p, T_OK) + pdv_count_tone(p, T_UNKNOWN) + pdv_count_tone(p, T_WARN) + pdv_count_tone(p, T_BAD) == PDV_CHECKS;
        // The list prints, on each line, the status the matrix lights for that check.
        var r : u32 = 0;
        while (r < PDV_CHECKS) {
            assert pdv_cell(p, pdv_at(p, r), pdv_line_tone(p, r)) == PDV_CELL_ON;
            assert pdv_line_name(p, r) == pdv_check_name(pdv_at(p, r));
            r = r + 1;
        }
        f = f + 1;
    }
    // No such cell: past the last check or past the last status.
    assert pdv_cell(pdv_open(), PDV_CHECKS, 0) == PDV_CELL_NONE;
    assert pdv_cell(pdv_open(), 0, PDV_TONES) == PDV_CELL_NONE;
    assert pdv_line_name(pdv_open(), PDV_CHECKS) == "";
    // The page-level grade is the most severe of the measured three: fixing the reply leaves the warn.
    assert pdv_worst_tone(pdv_with(0)) == T_BAD;
    assert pdv_worst_tone(pdv_with(4)) == T_WARN;
    assert pdv_worst_tone(pdv_with(2)) == T_BAD;
}

test hovering_or_selecting_a_check_lights_its_row_and_its_line_alike {
    var p : PdvState = pdv_apply(pdv_open(), VIZ_EV_HOVER, pdv_check_ref(2), 0);
    p = pdv_apply(p, VIZ_EV_SELECT, pdv_check_ref(0), 0);
    // The matrix row, the list line and the contract's own highlight of the check all agree.
    var c : u32 = 0;
    while (c < PDV_CHECKS) {
        assert pdv_check_hl(p, c) == viz_highlight(p.viz, pdv_check_ref(c));
        assert pdv_row_hl(p, pdv_row_of(p, c)) == pdv_check_hl(p, c);
        var t : u32 = 0;
        while (t < PDV_TONES) {
            assert pdv_cell_hl(p, c, t) == pdv_check_hl(p, c);
            t = t + 1;
        }
        c = c + 1;
    }
    assert pdv_check_hl(p, 2) == VIZ_HL_HOVER;
    assert pdv_check_hl(p, 0) == VIZ_HL_SELECT;
    assert pdv_check_hl(p, 1) == VIZ_HL_NONE;
    // The list line of the hovered check is line 0 (the pick); the selected corpus is on line 1.
    assert pdv_row_hl(p, 0) == VIZ_HL_HOVER;
    assert pdv_row_hl(p, 1) == VIZ_HL_SELECT;
    // Selecting the selected check again clears it; leaving clears the hover.
    p = pdv_apply(p, VIZ_EV_SELECT, pdv_check_ref(0), 0);
    assert pdv_check_hl(p, 0) == VIZ_HL_NONE;
    p = pdv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert pdv_check_hl(p, 2) == VIZ_HL_NONE;
    // BACK clears a selection first, and only then would the host close the petal.
    var q : PdvState = pdv_apply(pdv_open(), VIZ_EV_SELECT, pdv_check_ref(4), 0);
    assert viz_back_closes(q.viz) == false;
    q = pdv_apply(q, VIZ_EV_BACK, 0, 0);
    assert q.viz.selected == VIZ_REF_NONE;
    assert pdv_check_hl(q, 4) == VIZ_HL_NONE;
    assert viz_back_closes(q.viz);
}

test a_chip_lights_its_check_and_a_cell_lights_its_row {
    // A hovered chip is its check: the matrix row and the list line light with the chip.
    let h : PdvState = pdv_apply(pdv_open(), VIZ_EV_HOVER, pdv_chip_ref(1), 0);
    assert pdv_chip_hl(h, 1) == VIZ_HL_HOVER;
    assert pdv_chip_hl(h, 0) == VIZ_HL_NONE;
    assert pdv_check_hl(h, PDV_C_SESSION) == VIZ_HL_HOVER;
    assert pdv_cell_hl(h, PDV_C_SESSION, T_OK) == VIZ_HL_HOVER;
    assert pdv_row_hl(h, pdv_row_of(h, PDV_C_SESSION)) == VIZ_HL_HOVER;
    assert pdv_chip_hl(h, PDV_MEASURED) == VIZ_HL_NONE;
    // A selected cell lights its whole row and nothing else: not its column.
    var s : PdvState = pdv_apply(pdv_open(), VIZ_EV_SELECT, pdv_cell_ref(4, 1), 0);
    assert pdv_check_hl(s, 4) == VIZ_HL_SELECT;
    assert pdv_cell_hl(s, 4, 0) == VIZ_HL_SELECT;
    assert pdv_cell_hl(s, 4, 3) == VIZ_HL_SELECT;
    assert pdv_cell_hl(s, 3, 1) == VIZ_HL_NONE;
    assert pdv_row_hl(s, pdv_row_of(s, 4)) == VIZ_HL_SELECT;
    // Selection wins over hover where both name the same check.
    s = pdv_apply(s, VIZ_EV_HOVER, pdv_check_ref(4), 0);
    assert pdv_check_hl(s, 4) == VIZ_HL_SELECT;
    // The highlight follows the check when the list re-sorts: flipping the session moves its line.
    var g : PdvState = pdv_apply(pdv_open(), VIZ_EV_SELECT, pdv_check_ref(PDV_C_SESSION), 0);
    assert pdv_row_hl(g, 5) == VIZ_HL_SELECT;
    g = pdv_click(g, pdv_chip_ref(1));
    assert pdv_row_hl(g, 5) == VIZ_HL_NONE;
    assert pdv_row_hl(g, 0) == VIZ_HL_SELECT;
}

; ---------------------------------------------------------------- tests: the badge

test a_flip_leaves_the_recorded_data_so_the_badge_drops_to_demo_and_comes_back {
    let s0 : PdvState = pdv_open();
    assert pdv_badge(s0) == VIZ_TRUTH_VERIFIED;
    assert pdv_claims(s0);
    let s1 : PdvState = pdv_click(s0, pdv_chip_ref(0));
    assert pdv_badge(s1) == VIZ_TRUTH_DEMO;
    assert pdv_claims(s1) == false;
    assert viz_may_claim(pdv_badge(s1)) == false;
    // Hovering, selecting and focusing stay on the data, so they never touch the badge.
    var s2 : PdvState = pdv_apply(s0, VIZ_EV_HOVER, pdv_check_ref(1), 0);
    s2 = pdv_apply(s2, VIZ_EV_SELECT, pdv_check_ref(2), 0);
    s2 = pdv_apply(s2, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert pdv_badge(s2) == VIZ_TRUTH_VERIFIED;
    // Flip the same chip again: the recorded reading returns, and so do the badge, the order and the state.
    let s3 : PdvState = pdv_click(s1, pdv_chip_ref(0));
    assert s3.flips == 0;
    assert pdv_badge(s3) == VIZ_TRUTH_VERIFIED;
    assert viz_same(s3.viz, s0.viz);
    assert s3.viz.revision == s0.viz.revision + 2;
    assert pdv_rows_moved(s0, s3) == 0;
    // With two chips flipped the badge stays DEMO until the last one is flipped back.
    let s4 : PdvState = pdv_click(s1, pdv_chip_ref(1));
    assert s4.flips == 3;
    assert pdv_badge(s4) == VIZ_TRUTH_DEMO;
    let s5 : PdvState = pdv_click(s4, pdv_chip_ref(0));
    assert s5.flips == 2;
    assert pdv_badge(s5) == VIZ_TRUTH_DEMO;
    assert pdv_badge(pdv_click(s5, pdv_chip_ref(1))) == VIZ_TRUTH_VERIFIED;
}

test the_badge_keeps_a_truth_that_cannot_claim_and_never_goes_above_verified {
    assert pdv_badge(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_CACHED)) == VIZ_TRUTH_CACHED;
    assert pdv_badge(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_DEMO)) == VIZ_TRUTH_DEMO;
    assert pdv_badge(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_UNKNOWN)) == VIZ_TRUTH_UNKNOWN;
    // A cached view is not relabelled DEMO by a flip either.
    let c : PdvState = pdv_click(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_CACHED), pdv_chip_ref(0));
    assert c.flips == 1;
    assert pdv_badge(c) == VIZ_TRUTH_CACHED;
    assert pdv_claims(c) == false;
    // No host feeds the petal, so a stored LIVE is shown as VERIFIED, never above it.
    assert pdv_badge(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_LIVE)) == VIZ_TRUTH_VERIFIED;
    assert pdv_badge(pdv_click(pdv_open_with(PDV_ITEMS, VIZ_TRUTH_LIVE), pdv_chip_ref(2))) == VIZ_TRUTH_DEMO;
    // A truth code outside the table reads as UNKNOWN, not as LIVE.
    assert pdv_badge(pdv_open_with(PDV_ITEMS, 9)) == VIZ_TRUTH_UNKNOWN;
}

test a_reload_keeps_the_demo_label_and_shows_unknown_while_loading {
    var p : PdvState = pdv_click(pdv_open(), pdv_chip_ref(0));
    assert pdv_badge(p) == VIZ_TRUTH_DEMO;
    p = pdv_apply(p, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert pdv_badge(p) == VIZ_TRUTH_UNKNOWN;
    assert pdv_pick(p) == PDV_NO_CHECK;
    assert pdv_cell(p, 0, 0) == PDV_CELL_NONE;
    // Interaction is ignored while loading, and so is a flip.
    assert pdv_apply(p, PDV_EV_FLIP, 1, 0).flips == 1;
    assert viz_same(pdv_apply(p, VIZ_EV_SELECT, pdv_check_ref(0), 0).viz, p.viz);
    p = pdv_apply(p, VIZ_EV_LOADED, PDV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.flips == 1;
    assert pdv_badge(p) == VIZ_TRUTH_DEMO;
    assert pdv_tone(p, PDV_C_CORPUS) == T_BAD;
    // A reload that reports a truth that cannot claim keeps that label over the flip.
    let q : PdvState = pdv_apply(pdv_apply(p, VIZ_EV_LOAD, 0, 0), VIZ_EV_LOADED, PDV_ITEMS, VIZ_TRUTH_CACHED as u32);
    assert pdv_badge(q) == VIZ_TRUTH_CACHED;
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_every_check_then_every_chip_forward_and_wraps {
    var s : PdvState = pdv_open();
    var f : u32 = 0;
    while (f < PDV_ITEMS) {
        s = pdv_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert s.viz.focus == f;
        assert viz_is_focused(s.viz, f);
        if (f < PDV_CHECKS) {
            assert pdv_focus_ref(s, s.viz.focus) == pdv_check_ref(f);
        } else {
            assert pdv_focus_ref(s, s.viz.focus) == pdv_chip_ref(f - PDV_CHECKS);
        }
        f = f + 1;
    }
    s = pdv_apply(s, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert s.viz.focus == 0;
    assert pdv_focus_ref(s, 0) == pdv_check_ref(0);
    assert pdv_focus_ref(s, PDV_ITEMS) == VIZ_REF_NONE;
    // The focus order is the listing order and does not follow the list when it re-sorts.
    let t : PdvState = pdv_click(s, pdv_chip_ref(1));
    assert pdv_focus_ref(t, 1) == pdv_check_ref(1);
    assert pdv_at(t, 1) != pdv_at(s, 1);
}

test focus_walks_backwards_and_activate_flips_a_chip_or_selects_a_check {
    var s : PdvState = pdv_apply(pdv_open(), VIZ_EV_FOCUS_PREV, 0, 0);
    assert s.viz.focus == PDV_ITEMS - 1;
    assert pdv_focus_ref(s, s.viz.focus) == pdv_chip_ref(PDV_MEASURED - 1);
    var n : u32 = 1;
    while (n < PDV_ITEMS) {
        s = pdv_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
        n = n + 1;
    }
    assert s.viz.focus == 0;
    assert pdv_focus_ref(s, 0) == pdv_check_ref(0);
    s = pdv_apply(s, VIZ_EV_FOCUS_PREV, 0, 0);
    assert s.viz.focus == PDV_ITEMS - 1;
    // Enter on a check selects it, a second Enter clears it, and neither flips a reading.
    var p : PdvState = pdv_apply(pdv_open(), VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pdv_activate(p);
    assert p.viz.selected == pdv_check_ref(0);
    assert p.flips == 0;
    p = pdv_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    // Enter on a chip flips that check's reading and selects nothing.
    var q : PdvState = pdv_open();
    var k : u32 = 0;
    while (k < 8) {
        q = pdv_apply(q, VIZ_EV_FOCUS_NEXT, 0, 0);
        k = k + 1;
    }
    assert q.viz.focus == 7;
    assert pdv_focus_ref(q, q.viz.focus) == pdv_chip_ref(1);
    q = pdv_activate(q);
    assert q.flips == 2;
    assert q.viz.selected == VIZ_REF_NONE;
    assert pdv_badge(q) == VIZ_TRUTH_DEMO;
    assert pdv_at(q, 0) == PDV_C_SESSION;
    q = pdv_activate(q);
    assert q.flips == 0;
    assert pdv_badge(q) == VIZ_TRUTH_VERIFIED;
    // Nothing focused: activating changes nothing, not even the revision.
    assert viz_same(pdv_activate(pdv_open()).viz, pdv_open().viz);
    assert pdv_activate(pdv_open()).viz.revision == pdv_open().viz.revision;
}

test reduced_motion_zeroes_the_resort_animation {
    let a : PdvState = pdv_open();
    // Flipping the session moves all six lines; flipping the corpus moves none (it only turns bad).
    let b : PdvState = pdv_click(a, pdv_chip_ref(1));
    let c : PdvState = pdv_click(a, pdv_chip_ref(0));
    assert pdv_rows_moved(a, b) == 6;
    assert pdv_resort_ms(a, b) == 6 * PDV_ROW_MS;
    assert pdv_rows_moved(a, c) == 0;
    assert pdv_resort_ms(a, c) == 0;
    // Reduced motion turns the slide off.
    let r : PdvState = pdv_apply(b, VIZ_EV_MOTION, 1, 0);
    assert r.viz.reduced_motion == 1;
    assert pdv_resort_ms(a, r) == 0;
    assert pdv_rows_moved(a, r) == 6;
    assert pdv_resort_ms(a, pdv_apply(r, VIZ_EV_MOTION, 0, 0)) == 6 * PDV_ROW_MS;
    // The preference applies before the petal has loaded, and a reload does not forget it.
    let early : PdvState = pdv_apply(pdv_idle(), VIZ_EV_MOTION, 1, 0);
    assert early.viz.reduced_motion == 1;
    let loaded : PdvState = pdv_apply(pdv_apply(early, VIZ_EV_LOAD, 0, 0), VIZ_EV_LOADED, PDV_ITEMS, VIZ_TRUTH_VERIFIED as u32);
    assert loaded.viz.reduced_motion == 1;
    assert pdv_resort_ms(a, pdv_click(loaded, pdv_chip_ref(1))) == 0;
}

; ---------------------------------------------------------------- tests: layout, hit tests, one reducer

test matrix_and_list_hit_back_at_the_entities_they_draw {
    var f : u32 = 0;
    while (f < 8) {
        let p : PdvState = pdv_with(f);
        var r : u32 = 0;
        while (r < PDV_CHECKS) {
            let c : u32 = pdv_at(p, r);
            // Anywhere on the line but the chip is the check; on the chip of a measured check it is the chip.
            assert pdv_list_hit(p, PDV_LIST_X + 10, pdv_row_y(r) + 5) == pdv_check_ref(c);
            assert pdv_list_hit(p, PDV_LIST_X + PDV_LIST_W - 1, pdv_row_y(r) + PDV_ROW_H - 1) == pdv_check_ref(c);
            assert pdv_list_hit(p, pdv_chip_x() - 1, pdv_row_y(r) + 5) == pdv_check_ref(c);
            if (c < PDV_MEASURED) {
                assert pdv_list_hit(p, pdv_chip_x() + 5, pdv_row_y(r) + 5) == pdv_chip_ref(c);
                assert pdv_list_hit(p, pdv_chip_x() + PDV_CHIP_W - 1, pdv_row_y(r) + 5) == pdv_chip_ref(c);
                assert pdv_list_hit(p, pdv_chip_x() + PDV_CHIP_W, pdv_row_y(r) + 5) == pdv_check_ref(c);
            } else {
                assert pdv_list_hit(p, pdv_chip_x() + 5, pdv_row_y(r) + 5) == pdv_check_ref(c);
            }
            r = r + 1;
        }
        f = f + 1;
    }
    // The matrix keeps the listing order: row c holds check c, column t holds status t.
    var c : u32 = 0;
    while (c < PDV_CHECKS) {
        var t : u32 = 0;
        while (t < PDV_TONES) {
            assert pdv_matrix_hit(pdv_cell_x(t), pdv_row_y(c)) == pdv_cell_ref(c, t);
            assert pdv_matrix_hit(pdv_cell_x(t) + PDV_CELL_W / 2, pdv_row_y(c) + PDV_ROW_H / 2) == pdv_cell_ref(c, t);
            assert pdv_matrix_hit(pdv_cell_x(t) + PDV_CELL_W - 1, pdv_row_y(c) + PDV_ROW_H - 1) == pdv_cell_ref(c, t);
            t = t + 1;
        }
        c = c + 1;
    }
    // Just outside each view is nothing.
    let p0 : PdvState = pdv_open();
    assert pdv_matrix_hit(PDV_MATRIX_X - 1, PDV_MATRIX_Y) == VIZ_REF_NONE;
    assert pdv_matrix_hit(PDV_MATRIX_X, PDV_MATRIX_Y - 1) == VIZ_REF_NONE;
    assert pdv_matrix_hit(pdv_cell_x(PDV_TONES), pdv_row_y(0)) == VIZ_REF_NONE;
    assert pdv_matrix_hit(pdv_cell_x(0), pdv_row_y(PDV_CHECKS)) == VIZ_REF_NONE;
    assert pdv_list_hit(p0, PDV_LIST_X - 1, PDV_LIST_Y) == VIZ_REF_NONE;
    assert pdv_list_hit(p0, PDV_LIST_X + PDV_LIST_W, PDV_LIST_Y) == VIZ_REF_NONE;
    assert pdv_list_hit(p0, PDV_LIST_X, PDV_LIST_Y - 1) == VIZ_REF_NONE;
    assert pdv_list_hit(p0, PDV_LIST_X, pdv_row_y(PDV_CHECKS)) == VIZ_REF_NONE;
    // A point in the matrix is not in the list and the other way round; the idle petal lists nothing.
    assert pdv_list_hit(p0, PDV_MATRIX_X + 5, PDV_MATRIX_Y + 5) == VIZ_REF_NONE;
    assert pdv_matrix_hit(PDV_LIST_X + 5, PDV_LIST_Y + 5) == VIZ_REF_NONE;
    assert pdv_list_hit(pdv_idle(), PDV_LIST_X + 10, PDV_LIST_Y + 5) == VIZ_REF_NONE;
}

test a_click_in_any_view_goes_through_the_one_reducer {
    let s0 : PdvState = pdv_open();
    // Move the pointer over the first line of the list: that is the reply, and its matrix row lights too.
    var s : PdvState = pdv_pointer_list(s0, PDV_LIST_X + 10, pdv_row_y(0) + 5);
    assert s.viz.hover == pdv_check_ref(PDV_C_REPLY);
    assert pdv_row_hl(s, 0) == VIZ_HL_HOVER;
    assert pdv_cell_hl(s, PDV_C_REPLY, T_BAD) == VIZ_HL_HOVER;
    // Click a matrix cell: it selects the corpus row.
    s = pdv_click(s, pdv_matrix_hit(pdv_cell_x(T_WARN) + 5, pdv_row_y(PDV_C_CORPUS) + 5));
    assert s.viz.selected == pdv_cell_ref(PDV_C_CORPUS, T_WARN);
    assert pdv_check_hl(s, PDV_C_CORPUS) == VIZ_HL_SELECT;
    assert pdv_row_hl(s, 1) == VIZ_HL_SELECT;
    // Click the chip on the session line (the last line today): the session reading flips, the list
    // re-sorts, and the same pixel now names another check.
    let chip_px : u32 = pdv_chip_x() + 5;
    let old_py : u32 = pdv_row_y(5) + 5;
    assert pdv_list_hit(s, chip_px, old_py) == pdv_chip_ref(PDV_C_SESSION);
    s = pdv_click(s, pdv_list_hit(s, chip_px, old_py));
    assert s.flips == 2;
    assert pdv_list_hit(s, chip_px, old_py) == pdv_check_ref(PDV_C_CI);
    assert pdv_list_hit(s, chip_px, pdv_row_y(0) + 5) == pdv_chip_ref(PDV_C_SESSION);
    // The hover and the selection follow their checks, not their pixels.
    assert pdv_row_hl(s, pdv_row_of(s, PDV_C_REPLY)) == VIZ_HL_HOVER;
    assert pdv_row_hl(s, pdv_row_of(s, PDV_C_CORPUS)) == VIZ_HL_SELECT;
    // Three accepted inputs, three revisions; the pointer leaving is a fourth.
    assert s.viz.revision == s0.viz.revision + 3;
    s = pdv_pointer_list(s, PDV_LIST_X - 5, PDV_LIST_Y + 5);
    assert s.viz.hover == VIZ_REF_NONE;
    assert s.viz.revision == s0.viz.revision + 4;
    // The answer on screen after the click is the source's, for the flipped session.
    assert pdv_next(s) == pdv_oracle_next(2);
    assert pdv_pick(s) == PDV_C_SESSION;
}

; ---------------------------------------------------------------- tests: host and plan

test the_host_validates_places_and_focuses_badge_matrix_and_list {
    let h : VizHost = pdv_host();
    assert h.count == PDV_SLOTS;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_MATRIX;
    assert h.rep[2] == VIZ_REP_LIST;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[1] == VH_ROOT;
    assert h.parent[2] == VH_ROOT;
    // The slot rects are the layout: a status column per grade, a line per check, the list as tall as the matrix.
    assert h.x[1] == PDV_MATRIX_X;
    assert h.y[1] == PDV_MATRIX_Y;
    assert h.w[1] == PDV_TONES * PDV_CELL_W;
    assert h.h[1] == PDV_CHECKS * PDV_ROW_H;
    assert h.h[2] == h.h[1];
    assert h.y[2] == h.y[1];
    // A point in each slot lands in that slot. The gaps and the outside are nothing: no frame slot.
    assert vh_hit(h, PDV_BADGE_X + 5, PDV_BADGE_Y + 5) == PDV_SLOT_BADGE;
    assert vh_hit(h, PDV_MATRIX_X + 5, PDV_MATRIX_Y + 5) == PDV_SLOT_MATRIX;
    assert vh_hit(h, PDV_LIST_X + 5, PDV_LIST_Y + 5) == PDV_SLOT_LIST;
    assert vh_hit(h, 5, 5) == VH_NONE;
    assert vh_hit(h, PDV_BADGE_X + PDV_BADGE_W, PDV_BADGE_Y) == VH_NONE;
    assert vh_hit(h, PDV_LIST_X + PDV_LIST_W, PDV_LIST_Y) == VH_NONE;
    assert vh_hit(h, pdv_cell_x(PDV_TONES), pdv_row_y(0)) == VH_NONE;
    // Every cell centre is in the matrix slot, every list line in the list slot.
    var i : u32 = 0;
    while (i < PDV_CHECKS) {
        assert vh_hit(h, PDV_LIST_X + 10, pdv_row_y(i) + 5) == PDV_SLOT_LIST;
        var t : u32 = 0;
        while (t < PDV_TONES) {
            assert vh_hit(h, pdv_cell_x(t) + 40, pdv_row_y(i) + 14) == PDV_SLOT_MATRIX;
            t = t + 1;
        }
        i = i + 1;
    }
    // The host focus visits each slot in order and wraps.
    var f : u32 = vh_focus_next(h, VH_NONE);
    assert f == PDV_SLOT_BADGE;
    f = vh_focus_next(h, f);
    assert f == PDV_SLOT_MATRIX;
    f = vh_focus_next(h, f);
    assert f == PDV_SLOT_LIST;
    f = vh_focus_next(h, f);
    assert f == PDV_SLOT_BADGE;
    assert vh_focus_next(vh_blank(), 0) == VH_NONE;
}

test the_petal_embeds_in_a_larger_host_and_keeps_its_slots {
    var frame : VizHost = vh_blank();
    frame = vh_add(frame, VIZ_REP_TEXT, VH_ROOT, 5, 5, 1000, 800);
    let e : VizHost = pdv_in_frame(frame, 0, 10, 20);
    assert e.count == 1 + PDV_SLOTS;
    assert vh_validate(e) == VH_OK;
    assert e.rep[0] == VIZ_REP_TEXT;
    assert e.rep[1] == VIZ_REP_BADGE;
    assert e.rep[2] == VIZ_REP_MATRIX;
    assert e.rep[3] == VIZ_REP_LIST;
    assert e.parent[1] == 0;
    assert e.parent[3] == 0;
    // The petal's slots moved by the offset, and by the frame's own corner in absolute terms.
    assert e.x[2] == PDV_MATRIX_X + 10;
    assert e.y[2] == PDV_MATRIX_Y + 20;
    assert vh_abs_x(e, 2) == 5 + PDV_MATRIX_X + 10;
    assert vh_abs_y(e, 2) == 5 + PDV_MATRIX_Y + 20;
    assert vh_depth(e, 0) == 1;
    assert vh_depth(e, 2) == 2;
    assert vh_hit(e, vh_abs_x(e, 2) + 5, vh_abs_y(e, 2) + 5) == 2;
    assert vh_hit(e, vh_abs_x(e, 3) + 5, vh_abs_y(e, 3) + 5) == 3;
    assert vh_hit(e, vh_abs_x(e, 1) + 5, vh_abs_y(e, 1) + 5) == 1;
    // The petal's own host is unchanged by being embedded.
    assert pdv_host().count == PDV_SLOTS;
    assert pdv_host().x[1] == PDV_MATRIX_X;
}

test the_petal_reps_equal_the_plan_row_and_pass_the_plan_check {
    let reps : u32 = pdv_reps();
    // MATRIX 2 + LIST 4 + BADGE 256.
    assert reps == 262;
    assert reps == pvp_reps(PDV_PETAL);
    assert viz_plan_ok(reps);
    assert viz_is_linked(reps);
    assert viz_view_count(reps) == 2;
    assert (reps & viz_rep_bit(VIZ_REP_BADGE)) != 0;
    assert (reps & viz_rep_bit(VIZ_REP_GRAPH)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_TRACE)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_INSPECTOR)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_STEPPER)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_CHOICE)) == 0;
    assert (reps & viz_rep_bit(VIZ_REP_TEXT)) == 0;
    // The host uses exactly these reps and no others.
    let h : VizHost = pdv_host();
    assert (viz_rep_bit(h.rep[0]) | viz_rep_bit(h.rep[1]) | viz_rep_bit(h.rep[2])) == reps;
    // The truth the plan row names is the truth the petal opens with, and the row is a live one.
    assert pvp_truth(PDV_PETAL) == VIZ_TRUTH_VERIFIED;
    assert pdv_badge(pdv_open()) == pvp_truth(PDV_PETAL);
    assert pvp_status(PDV_PETAL) != PVP_DEFERRED;
    assert pvp_question(PDV_PETAL).len >= 20;
    // The source the row names is the dashboard: "specs/t27mcp/dashboard.t27".
    assert pvp_is_spec_path(pvp_source(PDV_PETAL));
    assert pvp_source(PDV_PETAL).len == 26;
    assert pvp_source(PDV_PETAL)[6] == 116;
    assert pvp_source(PDV_PETAL)[7] == 50;
    assert pvp_source(PDV_PETAL)[8] == 55;
    assert pvp_source(PDV_PETAL)[9] == 109;
    assert pvp_source(PDV_PETAL)[10] == 99;
    assert pvp_source(PDV_PETAL)[11] == 112;
}

; ---------------------------------------------------------------- invariants

invariant the_petal_budget_fits_the_contract {
    assert PDV_STRIDE >= PDV_TONES;
    assert (PDV_CHECKS - 1) * PDV_STRIDE + PDV_TONES - 1 < VIZ_REF_SPAN;
    assert PDV_ITEMS < VIZ_NO_FOCUS;
    assert PDV_ITEMS == PDV_CHECKS + PDV_MEASURED;
    assert PDV_MEASURED <= PDV_CHECKS;
    assert PDV_CHECKS < 32;
    assert PDV_SLOTS <= VH_MAX_SLOTS;
    assert PDV_EV_FLIP >= VIZ_EV_COUNT;
    assert PDV_CELL_OFF < PDV_CELL_ON;
    assert PDV_CELL_ON < PDV_CELL_NONE;
    assert VIZ_HL_NONE < VIZ_HL_HOVER;
    assert VIZ_HL_HOVER < VIZ_HL_SELECT;
    assert T_OK < T_UNKNOWN;
    assert T_UNKNOWN < T_WARN;
    assert T_WARN < T_BAD;
    assert PDV_TONE_NONE > T_BAD;
    assert PDV_MATRIX_Y == PDV_LIST_Y;
    assert PDV_BADGE_X + PDV_BADGE_W <= PDV_LIST_X;
    assert PDV_MATRIX_X + PDV_TONES * PDV_CELL_W <= PDV_LIST_X;
    assert PDV_CHIP_DX + PDV_CHIP_W <= PDV_LIST_W;
}
