// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_parts.t27 -- PartPalette catalog for the NETLIST constructor.
; Ring 2, Wave G1 of epic #13650.
; NpPalette is a typed list of draggable node kinds: BLOCK, INSTANCE, NET, PIN, DEVICE.
; REFUSAL is never in the palette -- refusals appear during validation, not from user picks.
; np_default_palette() returns the full 5-entry catalog.
; np_find_kind(p, kind) locates a part by its NT_* kind index.
; No RGBA, no host code, no size constants -- token roles and kind indices only.
; Depends on lane/netlist-view-13716 (netlist_tokens kind constants).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_parts;

use t27f::netlist_tokens::{NT_BLOCK, NT_INSTANCE, NT_NET, NT_PIN, NT_DEVICE, NT_REFUSAL, NT_KINDS, NT_EXACT};

pub const NP_MAX_PARTS : u32 = 8;

; ── NpPalette struct ─────────────────────────────────────────────────────────
; Parallel arrays -- same pattern as NetlistGraph.
pub struct NpPalette {
    part_count : u32,
    part_kind  : [8]u32,
    part_label : [8]u32,
    part_name  : [8]str,
}

; ── Accessors (bounds-safe) ──────────────────────────────────────────────────
pub fn np_part_kind(p: NpPalette, i: u32) -> u32 {
    if (i >= p.part_count) { return NT_KINDS; }
    let idx : usize = i as usize;
    return p.part_kind[idx];
}

pub fn np_part_label(p: NpPalette, i: u32) -> u32 {
    if (i >= p.part_count) { return NT_KINDS; }
    let idx : usize = i as usize;
    return p.part_label[idx];
}

pub fn np_part_name(p: NpPalette, i: u32) -> str {
    if (i >= p.part_count) { return ""; }
    let idx : usize = i as usize;
    return p.part_name[idx];
}

; ── Lookup ────────────────────────────────────────────────────────────────────
; Returns the first index where part_kind == kind, or NP_MAX_PARTS if not found.
pub fn np_find_kind(p: NpPalette, kind: u32) -> u32 {
    var i : u32 = 0;
    while (i < p.part_count) {
        let idx : usize = i as usize;
        if (p.part_kind[idx] == kind) { return i; }
        i = i + 1;
    }
    return NP_MAX_PARTS;
}

; ── Default palette ───────────────────────────────────────────────────────────
; Five constructible kinds in layout order (column order of netlist_view):
;   BLOCK, INSTANCE, NET, PIN, DEVICE.  REFUSAL is omitted.
pub fn np_default_palette() -> NpPalette {
    var p : NpPalette;
    p.part_count = 5;

    p.part_kind[0]  = NT_BLOCK;    p.part_label[0] = NT_EXACT; p.part_name[0] = "Block";
    p.part_kind[1]  = NT_INSTANCE; p.part_label[1] = NT_EXACT; p.part_name[1] = "Instance";
    p.part_kind[2]  = NT_NET;      p.part_label[2] = NT_EXACT; p.part_name[2] = "Net";
    p.part_kind[3]  = NT_PIN;      p.part_label[3] = NT_EXACT; p.part_name[3] = "Pin";
    p.part_kind[4]  = NT_DEVICE;   p.part_label[4] = NT_EXACT; p.part_name[4] = "Device";

    return p;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test default_palette_has_five_parts {
    let p : NpPalette = np_default_palette();
    assert p.part_count == 5;
}

test default_palette_kinds_are_in_order {
    let p : NpPalette = np_default_palette();
    assert np_part_kind(p, 0) == NT_BLOCK;
    assert np_part_kind(p, 1) == NT_INSTANCE;
    assert np_part_kind(p, 2) == NT_NET;
    assert np_part_kind(p, 3) == NT_PIN;
    assert np_part_kind(p, 4) == NT_DEVICE;
}

test refusal_is_not_in_default_palette {
    let p : NpPalette = np_default_palette();
    let idx : u32 = np_find_kind(p, NT_REFUSAL);
    assert idx == NP_MAX_PARTS;
}

test find_kind_returns_correct_index {
    let p : NpPalette = np_default_palette();
    assert np_find_kind(p, NT_BLOCK)    == 0;
    assert np_find_kind(p, NT_INSTANCE) == 1;
    assert np_find_kind(p, NT_NET)      == 2;
    assert np_find_kind(p, NT_PIN)      == 3;
    assert np_find_kind(p, NT_DEVICE)   == 4;
}

test out_of_range_index_gives_sentinel {
    let p : NpPalette = np_default_palette();
    assert np_part_kind(p, 5) == NT_KINDS;
    assert np_part_label(p, 5) == NT_KINDS;
    assert np_part_name(p, 5) == "";
}

test unknown_kind_not_found {
    let p : NpPalette = np_default_palette();
    assert np_find_kind(p, NT_KINDS) == NP_MAX_PARTS;
}

test all_part_names_non_empty {
    let p : NpPalette = np_default_palette();
    assert np_part_name(p, 0) == "Block";
    assert np_part_name(p, 1) == "Instance";
    assert np_part_name(p, 2) == "Net";
    assert np_part_name(p, 3) == "Pin";
    assert np_part_name(p, 4) == "Device";
}

test all_default_labels_are_exact {
    let p : NpPalette = np_default_palette();
    var i : u32 = 0;
    while (i < p.part_count) {
        assert np_part_label(p, i) == NT_EXACT;
        i = i + 1;
    }
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant default_palette_count_is_five {
    let p : NpPalette = np_default_palette();
    assert p.part_count == 5;
}

invariant refusal_absent_from_default_palette {
    let p : NpPalette = np_default_palette();
    assert np_find_kind(p, NT_REFUSAL) == NP_MAX_PARTS;
}

invariant max_parts_capacity_exceeds_default_count {
    let p : NpPalette = np_default_palette();
    assert NP_MAX_PARTS > p.part_count;
}
