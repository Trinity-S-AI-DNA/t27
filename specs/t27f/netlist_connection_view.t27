test self_loop_not_ok {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 0;
    prev.dst_kind = NG_NODE_BLOCK;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.ok == false;
}

test self_loop_reason_self_loop {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 0;
    prev.dst_kind = NG_NODE_BLOCK;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.reason == NC_SELF_LOOP;
}

test active_self_loop_still_visible {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 0;
    prev.dst_kind = NG_NODE_BLOCK;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.visible == true;
}

test ncw_alpha_inactive_is_zero {
    assert NCW_ALPHA_INACTIVE == 0.0;
}

test ncw_alpha_default_positive {
    assert NCW_ALPHA_DEFAULT > 0.0;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant alpha_default_exceeds_inactive {
    assert NCW_ALPHA_DEFAULT > NCW_ALPHA_INACTIVE;
}

invariant alpha_inactive_zero {
    assert NCW_ALPHA_INACTIVE == 0.0;
}

invariant alpha_default_at_most_one {
    assert NCW_ALPHA_DEFAULT <= 1.0;
}
