; specs/t27f/netlist_connection_view.t27 -- Renderer-neutral line plan for NETLIST connection preview.
; Ring 2, Wave L3 of epic #13650.
; NcvLine: shows src/dst endpoint positions and ok/reason when preview is active; invisible otherwise.
; Derives from NcPreview (active flag, nodes) + NcResult (ok, reason) + NvPlan (layout x/y).
; Alpha from uikit::native_tokens BTN_ALPHA_DEFAULT -- no RGBA literal.
; Numbers only; a host (glass_window, Web) draws them.
; Depends on: netlist_connection, netlist_view.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_connection_view;

use t27f::netlist_connection::{NcPreview, NcResult, NC_OK, NC_INCOMPATIBLE, NC_INVALID_KIND, NC_SELF_LOOP, nc_preview_result};
use t27f::netlist_graph::{NetlistGraph, NG_NODE_BLOCK, NG_NODE_PIN, NG_NODE_DEVICE, NG_NODE_NET, inverter_graph};
use t27f::netlist_view::{NvPlan, nv_layout, nv_node_x, nv_node_y};
use uikit::native_tokens::{BTN_ALPHA_DEFAULT};

; ── Alpha constants ───────────────────────────────────────────────────────────
pub const NCW_ALPHA_DEFAULT  : f64 = BTN_ALPHA_DEFAULT;
pub const NCW_ALPHA_INACTIVE : f64 = 0.0;

; ── NcvLine: render plan for a connection preview line ────────────────────────
pub struct NcvLine {
    visible : bool,
    ok      : bool,
    reason  : u8,
    x0      : u32,
    y0      : u32,
    x1      : u32,
    y1      : u32,
    alpha   : f64,
}

; ── connection line view ──────────────────────────────────────────────────────
; Returns invisible line when no preview is active.
; When active, derives ok/reason from nc_preview_result and x/y from nv_node layout.
pub fn ncv_line_view(preview: NcPreview, g: NetlistGraph, p: NvPlan) -> NcvLine {
    var l : NcvLine;
    if (preview.active == false) {
        l.visible = false;
        l.ok      = false;
        l.reason  = NC_OK;
        l.x0      = 0;
        l.y0      = 0;
        l.x1      = 0;
        l.y1      = 0;
        l.alpha   = NCW_ALPHA_INACTIVE;
        return l;
    }
    let result : NcResult = nc_preview_result(preview);
    l.visible = true;
    l.ok      = result.ok;
    l.reason  = result.reason;
    l.x0      = nv_node_x(p, preview.src_node);
    l.y0      = nv_node_y(p, preview.src_node);
    l.x1      = nv_node_x(p, preview.dst_node);
    l.y1      = nv_node_y(p, preview.dst_node);
    l.alpha   = NCW_ALPHA_DEFAULT;
    return l;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test inactive_preview_not_visible {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active = false;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.visible == false;
}

test inactive_preview_alpha_zero {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active = false;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.alpha == NCW_ALPHA_INACTIVE;
}

test inactive_preview_ok_false {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active = false;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.ok == false;
}

test active_ok_preview_visible {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.visible == true;
}

test active_ok_preview_ok_true {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.ok == true;
}

test active_ok_preview_reason_nc_ok {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.reason == NC_OK;
}

test active_ok_preview_alpha_default {
    let g : NetlistGraph = inverter_graph();
    let p : NvPlan = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    let l : NcvLine = ncv_line_view(prev, g, p);
    assert l.alpha == NCW_ALPHA_DEFAULT;
}

