// SPDX-License-Identifier: Apache-2.0
; specs/t27f/frame_shard.t27 -- which frames of a reel one process renders, so N processes render
; it in parallel and their outputs, concatenated, are the one-process output byte for byte.
; --
; Why: specs/t27f/token_floor.t27 renders 450 frames in 52 s on one of the lab's 48 cores. Shard k
; of N renders the frames [shard_a(k, N, F), shard_b(k, N, F)) of a reel of F frames, and the shards
; of one N tile [0, F) in order. 48 shards render token_floor in 3.43 s, same frames sha256.
; --
; The contract for a renderer whose frame f is the integral of its physics from frame 0 (most are):
; step the physics from frame 0 up to the shard's last frame, and skip only the drawing of the
; frames before its first one. A renderer opts in with three lines in its main:
;   const fa = env_first(FRAMES);
;   const fb = env_end(FRAMES);
;   while (frame < fb) { ...physics...; if (frame < fa) { frame = frame + 1; continue; } ...draw... }
; --
; The shard is read from the environment: TF_SHARD (k) and TF_SHARDS (N). Unset, or a k or N that
; names no shard, renders the whole reel, never an empty or a partial one. Only main may call
; env_first and env_end: they reach getenv, so the binary links libc (`-lc`) and the tests, which
; never link libc, do not reach them.
; --
; The frames themselves are cached by specs/t27f/frame_cache.t27, keyed by the renderer's seal.

module frame_shard;

; The first frame of shard k of n, for 0 <= k <= n; shard_a(n, n, frames) is frames. Shard k renders
; [shard_a(k, n, frames), shard_a(k + 1, n, frames)), so shard k + 1 starts where shard k stops.
pub fn shard_a(k: i32, n: i32, frames: i32) -> i32 {
    return @divTrunc(k * frames, n);
}

pub fn shard_b(k: i32, n: i32, frames: i32) -> i32 {
    return shard_a(k + 1, n, frames);
}

; The decimal number at the head of s, or dflt when s has no digit first. At most four digits are
; read, so no input overflows.
pub fn count_or(s: [*:0]const u8, dflt: i32) -> i32 {
    var v : i32 = 0;
    var i : usize = 0;
    while (i < 4 && s[i] >= 48 && s[i] <= 57) {
        v = v * 10 + @as(i32, @intCast(s[i] - 48));
        i = i + 1;
    }
    if (i == 0) {
        return dflt;
    }
    return v;
}

; The shard a renderer draws, from k and n as read: an n out of 1..frames, or a k out of 0..n - 1,
; is the whole reel.
pub fn shard_n(k: i32, n: i32, frames: i32) -> i32 {
    if (n < 1 || n > frames || k < 0 || k >= n) {
        return 1;
    }
    return n;
}

pub fn shard_k(k: i32, n: i32, frames: i32) -> i32 {
    if (shard_n(k, n, frames) == 1) {
        return 0;
    }
    return k;
}

; The first and the end frame of the shard (k, n) as read, checked.
pub fn first_of(k: i32, n: i32, frames: i32) -> i32 {
    return shard_a(shard_k(k, n, frames), shard_n(k, n, frames), frames);
}

pub fn end_of(k: i32, n: i32, frames: i32) -> i32 {
    return shard_b(shard_k(k, n, frames), shard_n(k, n, frames), frames);
}

; The environment variable `name` as a count; dflt when it is unset. main only (getenv, libc).
pub fn env_count(name: [*:0]const u8, dflt: i32) -> i32 {
    const p = std.c.getenv(name);
    if (p == null) {
        return dflt;
    }
    return count_or(p.?, dflt);
}

pub fn env_first(frames: i32) -> i32 {
    return first_of(env_count("TF_SHARD", 0), env_count("TF_SHARDS", 1), frames);
}

pub fn env_end(frames: i32) -> i32 {
    return end_of(env_count("TF_SHARD", 0), env_count("TF_SHARDS", 1), frames);
}

test "the shards of every n from 1 to 64 tile a 450-frame reel in order, with no gap and no overlap" {
    var n : i32 = 1;
    while (n <= 64) {
        assert(shard_a(0, n, 450) == 0);
        assert(shard_b(n - 1, n, 450) == 450);
        var total : i32 = 0;
        var k : i32 = 0;
        while (k < n) {
            assert(shard_b(k, n, 450) > shard_a(k, n, 450));
            if (k > 0) {
                assert(shard_a(k, n, 450) == shard_b(k - 1, n, 450));
            }
            total = total + shard_b(k, n, 450) - shard_a(k, n, 450);
            k = k + 1;
        }
        assert(total == 450);
        n = n + 1;
    }
}

test "48 shards of 450 frames are 9 or 10 frames each, and 450 shards are one frame each" {
    assert(shard_b(0, 48, 450) - shard_a(0, 48, 450) == 9);
    assert(shard_b(47, 48, 450) - shard_a(47, 48, 450) == 10);
    var k : i32 = 0;
    while (k < 450) {
        assert(shard_a(k, 450, 450) == k);
        assert(shard_b(k, 450, 450) == k + 1);
        k = k + 1;
    }
}

test "the tiling holds for reel lengths that n does not divide" {
    assert(shard_a(1, 7, 100) == 14);
    assert(shard_b(6, 7, 100) == 100);
    assert(shard_a(2, 3, 10) == 6);
    assert(shard_b(2, 3, 10) - shard_a(2, 3, 10) == 4);
    assert(shard_n(0, 11, 10) == 1);
    assert(shard_n(9, 10, 10) == 10);
}

test "a count is read from its leading digits, and anything else falls back" {
    assert(count_or("", 7) == 7);
    assert(count_or("x3", 7) == 7);
    assert(count_or("12", 7) == 12);
    assert(count_or("48\n", 7) == 48);
    assert(count_or("0", 7) == 0);
    assert(count_or("123456", 7) == 1234);
}

test "a shard that cannot be rendered as asked renders the whole reel" {
    assert(shard_n(0, 1, 450) == 1);
    assert(shard_n(48, 48, 450) == 1);
    assert(shard_n(0, 0, 450) == 1);
    assert(shard_n(0 - 1, 4, 450) == 1);
    assert(shard_n(0, 451, 450) == 1);
    assert(shard_k(48, 48, 450) == 0);
    assert(shard_n(3, 48, 450) == 48);
    assert(shard_k(3, 48, 450) == 3);
    assert(first_of(9, 4, 450) == 0);
    assert(end_of(9, 4, 450) == 450);
    assert(first_of(3, 48, 450) == 28);
    assert(end_of(3, 48, 450) == 37);
}
