// SPDX-License-Identifier: Apache-2.0
; specs/t27f/work_graph_fixture.t27 -- the recorded feed work_graph.t27 replays. Issue
; gHashTag/t27#10260, milestone M1 of genui-research.md section 5.5.
; --- the columns ---
; The first 24 events are specs/queen/actor_events.t27 REPLAY_* columns (a test below pins
; them byte for byte), the remaining 1000 extend the same shape on a stated cycle: a crash
; exit every 97nd tick, a DOWN every 53rd, a restart every 40th, a spawn every 31st, a
; counted window every 29th, and a deliver otherwise -- an offer on even ticks, a result on
; odd ones, and every 7th a cancel. The join is checked in here too: task t names the spec
; SPEC_NAMES[task_spec(t)] -- the spec the task Boundary names, resolved by the feed, because
; work_graph.t27 never reads a payload (FR-004 of its issue).
; The columns are data, one row per event, exactly like actor_events.t27 REPLAY_*.
; NOT CLAIMED: this is not a recording of a live Queen yet; when the runtime publishes its
; own feed, it replaces these columns the way mvp.t27 replaces actor_events.t27 REPLAY_*.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27fWorkGraphFixture;

use t27f::work_graph::Event;
use t27f::work_graph::EV_SPAWN;
use t27f::work_graph::EV_EXIT;
use t27f::work_graph::EV_DOWN;
use t27f::work_graph::EV_RESTART;
use t27f::work_graph::EV_DELIVER;
use t27f::work_graph::EV_DELIVERS;
use t27f::work_graph::D_NONE;
use queen::actors::pid_of;

pub const FIXTURE_EVENTS : u32 = 1024;

// The specs the feed joins tasks to, by id; task_spec(t) maps a task number to one.
pub const SPEC_COUNT : u32 = 8;
pub const SPEC_NAMES : [8]str = ["specs/t27os/release.t27", "specs/t27os/access_scan.t27", "specs/queen/api_fleet.t27", "specs/tri/t27b/wasm.t27", "specs/t27os/release_verify.t27", "specs/t27os/lab_legs.t27", "specs/t27os/keys_fleet.t27", "specs/t27os/queen_live_actors.t27"];
pub fn task_spec(t: u32) -> u32 {
    if (t == 0) { return 0; }
    return ((t - 1) % 8) + 1;
}

