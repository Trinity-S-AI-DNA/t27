pub fn event_at(i: u32) -> Event {
    return Event {
        kind: KIND[i],
        from_pid: pid_of(F_SLOT[i] as u64, F_GEN[i] as u64),
        to_pid: pid_of(T_SLOT[i] as u64, T_GEN[i] as u64),
        task_no: TASK[i] as u32,
        deliver: DELIVER[i],
        reason: REASON[i],
        seq: SEQ[i],
        spec_id: SPEC[i],
    };
}

test "the fixture holds 1024 events and the first 24 are actor_events' replay, byte for byte" {
    assert(FIXTURE_EVENTS == 1024);
    assert(KIND.len == 1024);
    var i : u32 = 0;
    while (i < 24) {
        assert(KIND[i] == REPLAY_KIND_REF[i]);
        assert(F_SLOT[i] == REPLAY_FROM_SLOT_REF[i]);
        assert(T_SLOT[i] == REPLAY_TO_SLOT_REF[i]);
        assert(TASK[i] == REPLAY_TASK_REF[i]);
        i = i + 1;
    }
}

test "every kind, deliver kind and spec id is in range, and every task with a deliver resolves" {
    var i : u32 = 0;
    while (i < FIXTURE_EVENTS) {
        assert(KIND[i] <= 5);
        assert(DELIVER[i] <= 3);
        if (KIND[i] == 4) { assert(DELIVER[i] >= 1); }
        if (TASK[i] != 0) { assert(SPEC[i] == task_spec(TASK[i])); assert(SPEC[i] >= 1); assert(SPEC[i] <= SPEC_COUNT); }
        else { assert(SPEC[i] == 0); }
        i = i + 1;
    }
}

// Literals pinned to actor_events.t27: the test above compares against these, and a
// regenerated feed that drifts from the replay fails here first.
pub const REPLAY_KIND_REF : [24]u8 = [0, 0, 0, 0, 0, 0, 0, 4, 4, 4, 4, 3, 1, 4, 4, 4, 4, 4, 2, 4, 3, 1, 4, 4];
pub const REPLAY_FROM_SLOT_REF : [24]u8 = [0, 1, 1, 1, 1, 1, 1, 2, 3, 2, 4, 4, 1, 2, 4, 2, 6, 2, 5, 2, 3, 1, 2, 3];
pub const REPLAY_TO_SLOT_REF : [24]u8 = [1, 2, 3, 4, 5, 6, 7, 3, 1, 4, 7, 1, 4, 4, 1, 6, 1, 7, 1, 1, 1, 3, 3, 1];
pub const REPLAY_TASK_REF : [24]u8 = [0, 0, 0, 0, 0, 0, 0, 5, 5, 1, 1, 3, 3, 3, 3, 2, 2, 1, 1, 1, 3, 3, 3, 3];
