}

pub const DCARD_N58 : str = "abcdefghij/abcdefghij/abcdefghij/abcdefghij/abcdefghij/abc$";
pub const DCARD_LSEG : str = "port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_arrival_autocorrelation_guard$";
pub const DCARD_LSEG_DRAWN : str = "port/.../cover_traffic_inter_arrival_autocorrelation_guard$";
pub const DCARD_LMID : str = "port/trios/crates/trios-chat/rings/CR-CHAT-03/src/external_commit$";
pub const DCARD_LMID_DRAWN : str = "port/.../trios-chat/rings/CR-CHAT-03/src/external_commit$";
pub const DCARD_LDOTS : str = "port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_destination_timing_uniformity_guard$";
pub const DCARD_LDOTS_DRAWN : str = "...cover_traffic_inter_destination_timing_uniformity_guard$";
pub const DCARD_LONG : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_arrival_autocorrelation_guard.t27\tspecs/port/trios/crates/trios-chat/common/helpers.t27\nspecs/port/trios/crates/trios-chat/rings/CR-CHAT-03/src/external_commit.t27\tspecs/port/trios/crates/trios-chat/common/helpers.t27\n$";

test dcard_a_name_that_fits_is_drawn_byte_for_byte {
    var out : [256]u8 = undefined;
    const s : str = DCARD_N58;
    assert lit_len(s) == CARD_NAME_MAX;
    assert dcard_drawn_len(s, 0, lit_len(s)) == CARD_NAME_MAX;
    const w : usize = dcard_put_name(&out, 0, 256, s, 0, lit_len(s));
    assert w == CARD_NAME_MAX;
    assert card_count(&out, w, s) == 1;
    assert card_count(&out, w, "...$") == 0;
    const p : str = "specs/a/b.t27$";
    const wp : usize = dcard_put_name(&out, 0, 256, p, 0, lit_len(p));
    assert wp == 3;
    assert card_count(&out, wp, "a/b$") == 1;
}

test dcard_a_long_name_keeps_its_head_and_the_longest_whole_tail_that_fits {
    var out : [256]u8 = undefined;
    const s : str = DCARD_LSEG;
    assert lit_len(s) == 99;
    const w : usize = dcard_put_name(&out, 0, 256, s, 0, lit_len(s));
    assert w == lit_len(DCARD_LSEG_DRAWN);
    assert w == CARD_NAME_MAX;
    assert card_count(&out, w, DCARD_LSEG_DRAWN) == 1;
    assert dcard_drawn_len(s, 0, lit_len(s)) == w;
    const m : str = DCARD_LMID;
    const wm : usize = dcard_put_name(&out, 0, 256, m, 0, lit_len(m));
    assert wm == lit_len(DCARD_LMID_DRAWN);
    assert wm == 56;
    assert card_count(&out, wm, DCARD_LMID_DRAWN) == 1;
    assert dcard_drawn_len(m, 0, lit_len(m)) == wm;
}

test dcard_a_long_name_with_no_whole_tail_that_fits_keeps_its_last_bytes {
    var out : [256]u8 = undefined;
    const s : str = DCARD_LDOTS;
    assert lit_len(s) == 105;
    assert dcard_seg_from(s, 0, lit_len(s)) == lit_len(s);
    const w : usize = dcard_put_name(&out, 0, 256, s, 0, lit_len(s));
    assert w == CARD_NAME_MAX;
    assert card_count(&out, w, DCARD_LDOTS_DRAWN) == 1;
    assert dcard_drawn_len(s, 0, lit_len(s)) == w;
    const flat : str = "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijXYZ$";
    const wf : usize = dcard_put_name(&out, 0, 256, flat, 0, lit_len(flat));
    assert wf == CARD_NAME_MAX;
    assert card_count(&out, wf, "...ijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijXYZ$") == 1;
}

test dcard_a_long_name_is_checked_only_where_it_is_drawn {
    const hid : str = "port/tr:os/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_arrival_autocorrelation_guard$";
    assert dcard_name_ok(hid, 0, lit_len(hid));
    const hd : str = "po:t/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_arrival_autocorrelation_guard$";
    assert dcard_name_ok(hd, 0, lit_len(hd)) == false;
    const tl : str = "port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter:arrival_autocorrelation_guard$";
    assert dcard_name_ok(tl, 0, lit_len(tl)) == false;
    const dh : str = "port/tr:os/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_destination_timing_uniformity_guard$";
    assert dcard_name_ok(dh, 0, lit_len(dh));
    const dt : str = "port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_destination:timing_uniformity_guard$";
    assert dcard_name_ok(dt, 0, lit_len(dt)) == false;
    assert dcard_name_ok(DCARD_LSEG, 0, lit_len(DCARD_LSEG));
    assert dcard_name_ok(DCARD_LDOTS, 0, lit_len(DCARD_LDOTS));
    const n58 : str = "abcdefghij/abcd:fghij/abcdefghij/abcdefghij/abcdefghij/abc$";
    assert lit_len(n58) == CARD_NAME_MAX;
    assert dcard_name_ok(n58, 0, lit_len(n58)) == false;
}

test dcard_draws_a_card_with_long_names_abbreviated_at_their_drawn_size {
    var imp : [512]u8 = undefined;
    var rev : [512]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const g : str = DCARD_LONG;
    const hp : str = "specs/port/trios/crates/trios-chat/common/helpers.t27$";
    const w : usize = dcard_graph(g, lit_len(g), hp, 0, lit_len(hp), CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 512, &ib, &rev, 512, &rb, &out, 8192);
    assert w > 0;
    assert w <= 8192;
    assert card_count(&out, w, "fontsize=32:text='port/trios/crates/trios-chat/common/helpers'$") == 1;
    assert card_count(&out, w, "fontsize=24:text='port/.../cover_traffic_inter_arrival_autocorrelation_guard'$") == 1;
    assert card_count(&out, w, "fontsize=25:text='port/.../trios-chat/rings/CR-CHAT-03/src/external_commit'$") == 1;
    assert card_count(&out, w, "/.../$") == 2;
    assert card_count(&out, w, "text='IMPORTED BY 2'$") == 1;
    const fp : str = "specs/port/trios/crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_arrival_autocorrelation_guard.t27$";
    const wf : usize = dcard_graph(g, lit_len(g), fp, 0, lit_len(fp), CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 512, &ib, &rev, 512, &rb, &out, 8192);
    assert wf > 0;
    assert card_count(&out, wf, "fontsize=24:text='port/.../cover_traffic_inter_arrival_autocorrelation_guard'$") == 1;
    assert card_count(&out, wf, "text='port/trios/crates/trios-chat/common/helpers'$") == 1;
    assert card_count(&out, wf, "text='IMPORTS 1'$") == 1;
}

