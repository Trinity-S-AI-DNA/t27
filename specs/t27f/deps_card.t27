test dcard_every_band_fits_the_card_without_overlap {
    const half : usize = DCARD_BAND_FONT / 2;
    assert CARD_SUB_Y + CARD_SUB_FONT / 2 < DCARD_UP_LABEL_Y - half;
    assert DCARD_UP_LABEL_Y + half < DCARD_UP_ROW_Y;
    assert dcard_band_bottom(DCARD_UP_ROW_Y, DCARD_ROWS) < DCARD_UP_MORE_Y - half;
    assert DCARD_UP_MORE_Y + half < DCARD_FOCUS_Y;
    assert DCARD_FOCUS_Y + DCARD_FOCUS_H < DCARD_DOWN_LABEL_Y - half;
    assert DCARD_DOWN_LABEL_Y + half < DCARD_DOWN_ROW_Y;
    assert dcard_band_bottom(DCARD_DOWN_ROW_Y, DCARD_ROWS) < DCARD_DOWN_MORE_Y - half;
    assert DCARD_DOWN_MORE_Y + half < CARD_FOOT_Y - CARD_FOOT_FONT / 2;
    var shown : usize = 1;
    while (shown <= DCARD_ROWS) {
        assert dcard_band_bottom(DCARD_UP_ROW_Y, shown) + CARD_GAP_MIN <= DCARD_FOCUS_Y;
        shown += 1;
    }
    assert DCARD_FOCUS_Y + DCARD_FOCUS_H + CARD_GAP_MIN <= DCARD_DOWN_ROW_Y;
    assert dcard_band_bottom(DCARD_UP_ROW_Y, 0) == DCARD_UP_ROW_Y;
    var len : usize = 1;
    while (len <= CARD_NAME_MAX) {
        const fs : usize = dcard_name_font(len);
        assert fs >= CARD_FONT_MIN;
        assert fs * len * 3 <= (CARD_BOX_W - 2 * CARD_PAD) * 5;
        assert fs + 2 * CARD_BORDER < DCARD_ROW_H;
        len += 1;
    }
    const foot : usize = lit_len(DCARD_REACHES) + 4 + lit_len(DCARD_REACHED) + 4 + lit_len(DCARD_FOOT);
    assert foot * CARD_FOOT_FONT * 3 <= CARD_W * 5;
    assert lit_len(DCARD_SUB) * CARD_SUB_FONT * 3 <= CARD_BOX_W * 5;
    assert lit_len(DCARD_CYCLE) * CARD_SUB_FONT * 3 <= CARD_BOX_W * 5;
}

