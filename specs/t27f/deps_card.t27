test negative_control_a_shown_name_the_graph_cannot_draw_is_not_drawn {
    var imp : [256]u8 = undefined;
    var rev : [256]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const up : str = "a\tb\nx:y\ta\n$";
    assert dcard_graph(up, lit_len(up), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192) == 0;
    const down : str = "a\tb'\n$";
    assert dcard_graph(down, lit_len(down), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192) == 0;
    const hidden : str = "h\tm1\nh\tm2\nh\tm3\nh\tm:4\n$";
    const w : usize = dcard_graph(hidden, lit_len(hidden), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert w > 0;
    assert card_count(&out, w, "text='+1 more'$") == 1;
    const shown : str = "h\tm1\nh\tm:2\nh\tm3\nh\tm4\n$";
    assert dcard_graph(shown, lit_len(shown), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192) == 0;
    const focus : str = "a:b\tc\n$";
    assert dcard_graph(focus, lit_len(focus), "a:b$", 0, 3, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192) == 0;
}

test negative_control_a_card_that_does_not_fit_is_refused_whole {
    var imp : [256]u8 = undefined;
    var rev : [256]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const g : str = DEPS_FIXTURE;
    const full : usize = dcard_graph(g, lit_len(g), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert full > 0;
    assert dcard_graph(g, lit_len(g), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, full) == full;
    assert dcard_graph(g, lit_len(g), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, full - 1) == full;
    assert dcard_graph(g, lit_len(g), "a$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, full - 3) == full - 2;
}

