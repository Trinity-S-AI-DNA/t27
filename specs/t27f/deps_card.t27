}

pub const DCARD_RANK : str = "h\tm1\nh\tm2\nh\tm3\nh\tm4\nx\tm4\ny\tm4\nx\tm3\nu1\th\nu2\th\nk\tu2\n$";

test dcard_a_band_shows_its_most_imported_specs_first {
    var imp : [256]u8 = undefined;
    var rev : [256]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const g : str = DCARD_RANK;
    const w : usize = dcard_graph(g, lit_len(g), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert w > 0;
    assert card_count(&out, w, "text='m4':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=852-text_h/2$") == 1;
    assert card_count(&out, w, "text='m3':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=928-text_h/2$") == 1;
    assert card_count(&out, w, "text='m1':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=1004-text_h/2$") == 1;
    assert card_count(&out, w, "text='m2'$") == 0;
    assert card_count(&out, w, "text='+1 more'$") == 1;
    assert card_count(&out, w, "text='IMPORTS 4'$") == 1;
    assert card_count(&out, w, "text='u2':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=312-text_h/2$") == 1;
    assert card_count(&out, w, "text='u1':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=388-text_h/2$") == 1;
    assert card_count(&out, w, "text='IMPORTED BY 2'$") == 1;
    assert card_count(&out, w, "text='reaches 4 / reached by 3 / every edge exact'$") == 1;
}

test dcard_a_repeated_edge_line_counts_one_importer {
    const g : str = "h\tq\nh\tp\nz\tq\na\tp\na\tp\na\tp\r\n$";
    const n : usize = lit_len(g);
    assert dcard_used_by(g, n, "p$", 0, 1) == 2;
    assert dcard_used_by(g, n, "q$", 0, 1) == 2;
    assert dcard_used_by(g, n, "h$", 0, 1) == 0;
    assert dcard_used_by(g, n, "zz$", 0, 2) == 0;
    assert dcard_used_by(g, 0, "p$", 0, 1) == 0;
    var imp : [256]u8 = undefined;
    var rev : [256]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const w : usize = dcard_graph(g, n, "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert w > 0;
    assert card_count(&out, w, "text='q':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=852-text_h/2$") == 1;
    assert card_count(&out, w, "text='p':fontcolor=0xFFFFFF:x=(w-text_w)/2:y=928-text_h/2$") == 1;
}

test negative_control_the_name_check_follows_the_ranking {
    var imp : [256]u8 = undefined;
    var rev : [256]u8 = undefined;
    var ib : [35]usize = undefined;
    var rb : [35]usize = undefined;
    var out : [8192]u8 = undefined;
    const up : str = "h\tm1\nh\tm2\nh\tm3\nh\tm:4\nx\tm:4\n$";
    assert dcard_graph(up, lit_len(up), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192) == 0;
    const down : str = "h\tm1\nh\tm:2\nh\tm3\nh\tm4\nx\tm1\nx\tm3\nx\tm4\n$";
    const w : usize = dcard_graph(down, lit_len(down), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert w > 0;
    assert card_count(&out, w, "text='+1 more'$") == 1;
    assert card_count(&out, w, "m:2$") == 0;
}
