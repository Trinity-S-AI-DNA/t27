    assert w > 0;
    assert card_count(&out, w, "text='m1'$") == 1;
    assert card_count(&out, w, "text='m3'$") == 1;
    assert card_count(&out, w, "text='m4'$") == 0;
    assert card_count(&out, w, "text='m5'$") == 0;
    assert card_count(&out, w, "text='u3'$") == 1;
    assert card_count(&out, w, "text='u4'$") == 0;
    assert card_count(&out, w, "text='+2 more'$") == 1;
    assert card_count(&out, w, "text='+1 more'$") == 1;
    assert card_count(&out, w, "text='IMPORTED BY 4'$") == 1;
    assert card_count(&out, w, "text='IMPORTS 5'$") == 1;
    assert card_count(&out, w, "text='reaches 5 / reached by 4 / every edge exact'$") == 1;
    assert card_count(&out, w, ":color=0x00FF88:t=4$") == 6;
    const t : str = DCARD_THREE;
    const w3 : usize = dcard_graph(t, lit_len(t), "h$", 0, 1, CARD_TEST_FONT, lit_len(CARD_TEST_FONT), &imp, 256, &ib, &rev, 256, &rb, &out, 8192);
    assert w3 > 0;
    assert card_count(&out, w3, " more'$") == 0;
    assert card_count(&out, w3, ":color=0x00FF88:t=4$") == 6;
}

