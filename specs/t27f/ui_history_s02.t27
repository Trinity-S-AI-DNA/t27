// SPDX-License-Identifier: Apache-2.0
; T27F UI history, step 02: the text inset of a node comes from the space.control.inset token (Refs gHashTag/t27#13214, epic #13214)
; The typed record of docs/reports/ui-history/2026-11-07/step-02-control-inset-token/ (the frames live there; MANIFEST.md there is a reading
;   copy of this file and holds no field of its own). Shape and rules: ui_history. The log (ui_history_log) lists this step after step 01
;   (ui_history_s01), which stays as filed: this step is a new record, never an edit of the first
; BEFORE here is the AFTER of step 01: the seven rasters are byte-identical to the step 01 AFTER set (zero differing pixels in each pair).
;   The pen offset of the painter used to be the raw smallest step of the theme scale, 6112 milli-px; it is now a token, 6 px
; Paths are relative to the step folder. The measured facts are the ones a byte comparison or a test backs; nothing here says the card
;   looks better, and visual_review is PENDING_OWNER until the owner has opened the frames and said so in chat
; ASCII only (L3)

module T27fUiHistoryS02;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;

pub const US2_SEQ : u32 = 2;
pub const US2_ID : str = "ui-2026-11-07-step-02";
pub const US2_FOLDER : str = "docs/reports/ui-history/2026-11-07/step-02-control-inset-token";

const US2_BEFORE : [12]str = [
    "01-before/before_375_p100_t0.png",
    "01-before/before_768_p100_t0.png",
    "01-before/before_1280_p100_t0.png",
    "01-before/before_375_p100_t1.png",
    "01-before/before_1280_p100_t1.png",
    "01-before/before_375_p200_t0.png",
    "01-before/before_1280_p200_t0.png",
    "", "", "", "", "",
];

const US2_AFTER : [12]str = [
    "02-after/after_375_p100_t0.png",
    "02-after/after_768_p100_t0.png",
    "02-after/after_1280_p100_t0.png",
    "02-after/after_375_p100_t1.png",
    "02-after/after_1280_p100_t1.png",
    "02-after/after_375_p200_t0.png",
    "02-after/after_1280_p200_t0.png",
    "", "", "", "", "",
];

const US2_DIFF : [12]str = [
    "03-diff/cmp_375_p100_t0.png",
    "03-diff/cmp_768_p100_t0.png",
    "03-diff/cmp_1280_p100_t0.png",
    "03-diff/cmp_375_p100_t1.png",
    "03-diff/cmp_1280_p100_t1.png",
    "03-diff/cmp_375_p200_t0.png",
    "03-diff/cmp_1280_p200_t0.png",
    "", "", "", "", "",
];

const US2_TOK_NAMES : [12]str = [
    "space.control.inset",
    "painter.text_pen_offset",
    "", "", "", "", "", "", "", "", "", "",
];

const US2_TOK_BEFORE : [12]str = [
    "none (the painter read the raw smallest step of the theme scale)",
    "6.112 px (th_space_milli_px(0) = 6112 milli-px, 1564 q8 at 100 percent)",
    "", "", "", "", "", "", "", "", "", "",
];

const US2_TOK_AFTER : [12]str = [
    "6 px (alias of space.2, id 31 in vf_tokens)",
    "6 px (VcStyle.pad_x from the resolved token, 1536 q8 at 100 percent)",
    "", "", "", "", "", "", "", "", "", "",
];

const US2_MEASURED : [12]str = [
    "all seven AFTER rasters differ from their BEFORE rasters (md5), and each BEFORE raster equals the step 01 AFTER raster of the same name",
    "differing pixels per frame (magick compare, AE): 1565 at 375, 1565 at 768, 1566 at 1280 (100 percent, t0), 1565 and 1566 in the paper theme at 375 and 1280, 3272 at 200 percent for both 375 and 1280",
    "at 375 wide, 100 percent, t0 the changed pixels sit in one box, 176 x 132 at +22,+16, and the largest per-channel difference is 28 of 255",
    "at 375 wide, 100 percent, t0 the differing pixels per node rectangle: title 349, badge 208, label 242, input 327; Save 0 and Cancel 0, because a button centres its label and the pen offset does not move it",
    "the text starts 0.112 px closer to the node edge (6.112 px before, 6 px after), so the change is an anti-aliasing shift of text, not a move of any box; the layout rectangles are the same",
    "tests before this record was added, in T27 OS pane 15, 0 failed, 0 vacuous: vf_tokens 21, vf_theme 11, vf_card_tok 15, vf_card 21, vf_storybook 13, ui_history 10, ui_history_s01 3 (t27c and t27b), vf_card_main 6 (t27c)",
    "the +18 pin in vf_card (title ink inside the card) holds with the 6 px offset; the guard refuses a pen offset above 64 px with VC_BAD_METRICS",
    "", "", "", "", "",
];

const US2_LIMITS : [12]str = [
    "no person has looked at any frame in this step; nothing here claims the card looks better, and a 0.112 px shift of text is not expected to read as a visible change",
    "vf_theme keeps a second spacing and type scale: TH_PAD_CARD is 20 where space.card.padding is 16, and TH_TITLE_PX is 22 where type.heading is 26; the choice between them is the owner's",
    "the breakpoint is 600 in vf_theme and 640 in vf_layout, unchanged and pinned in vf_ring1",
    "vf_layout narrows no column and measures no text; the 560 clamp and the centring live in the renderer, not in vf_layout",
    "type.label and control.min_target resolve but do not drive the painter; there is no radius, line height or row gap token",
    "error and disabled input states are not drawn; the focus ring on the filled Save button is accent on accent; the cap height ratio 700 milli is assumed, not measured",
    "the card is not yet drawn at 768 and 1280 beyond the centred 560 wide column; no wide layout is claimed",
    "when filed, the commits after bd1b9ece89 were local only, and PR 13254 carried three inherited master reds that PR 13225 is meant to clear",
    "", "", "", "",
];

pub fn us2_step() -> UiStep {
    var st : UiStep = UiStep {
        seq: US2_SEQ,
        step_id: US2_ID,
        date: "2026-11-07",
        commit: "the commit that adds this record (BEFORE frames are the AFTER frames of 70cf34dc61, step 01)",
        branch: "claude/t27f-007-outfit-type",
        theme: "t0 black (main set), t1 paper at 375 and 1280",
        viewport: "375, 768, 1280 (design width of the card scene)",
        scale: "100 percent (main set), 200 percent at 375 and 1280",
        before_n: 7,
        before_paths: US2_BEFORE,
        after_n: 7,
        after_paths: US2_AFTER,
        diff_n: 7,
        diff_paths: US2_DIFF,
        token_n: 2,
        token_names: US2_TOK_NAMES,
        token_before: US2_TOK_BEFORE,
        token_after: US2_TOK_AFTER,
        intended_change: "The text inset of a node is a token, space.control.inset (6 px, an alias of space.2), read through the resolved style instead of the raw smallest step of the theme scale. The text moves 0.112 px; nothing else is meant to change. Whether this reads as any different is the owner's call.",
        measured_n: 7,
        measured: US2_MEASURED,
        limit_n: 8,
        limits: US2_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test step_two_holds_every_rule_of_the_schema {
    let st : UiStep = us2_step();
    assert uh_validate(st) == UH_OK;
}

test step_two_is_pinned_as_filed {
    let st : UiStep = us2_step();
    assert st.seq == 2;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    assert st.before_n == 7;
    assert st.after_n == 7;
    assert st.diff_n == 7;
    assert st.token_n == 2;
    assert st.measured_n == 7;
    assert st.limit_n == 8;
}

test step_two_names_its_folder_branch_and_token {
    let st : UiStep = us2_step();
    let id : str = st.step_id;
    let want : str = US2_ID;
    assert id == want;
    assert id == "ui-2026-11-07-step-02";
    let folder : str = US2_FOLDER;
    assert folder == "docs/reports/ui-history/2026-11-07/step-02-control-inset-token";
    let br : str = st.branch;
    assert br == "claude/t27f-007-outfit-type";
    let names : [12]str = st.token_names;
    let tok : str = names[0];
    assert tok == "space.control.inset";
}
