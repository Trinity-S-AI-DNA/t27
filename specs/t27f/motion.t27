// SPDX-License-Identifier: Apache-2.0
// specs/t27f/motion.t27 -- tweens and springs indexed by frame number. Milestone M2 of T27F Live
// (epic gHashTag/t27#10266), issue gHashTag/t27#10263. Design: docs/nona-02-organism/t27f/genui-research.md, section 5.
//
// WHY: a live page that samples a clock animates differently on every machine, and two clients looking
// at the same scene then disagree. Here every animated value is a function of the frame number alone.
// There is no wall clock anywhere in this file: FR-002 is a property of the shape of these functions,
// not a promise chained to discipline.
//
// WHAT IT IS. Fixed point, Q8 (Q is one whole unit). Four easings in EASE_KINDS, a tween that walks a
// value from a to b over d frames, and a spring that reaches its target by integration from a fixed
// start -- pure in (target, frame), so frame 500 costs 500 steps and gives the same answer every time.
//
// REDUCED MOTION is a switch, not a slower animation: with it on, every motion value is its end state
// on frame 0. That is FR-003, and value_at is the one place a caller asks for a value, so no caller
// can forget it.
//
// NOT CLAIMED: no overshoot, bounce or anticipation curves; the spring is a discrete critically-damped
// integrator, not a physical simulation with units; no per-property delays or chains; the frame rate is
// the caller's and is not assumed here.
// phi^2 + 1/phi^2 = 3 | TRINITY

module motion;

use t27f::scene_raster::clamp;
use t27f::scene_raster::imin;
use t27f::scene_raster::imax;
use t27f::scene_raster::iabs;

pub const ID : str = "motion";
pub const VERSION : u8 = 1;

pub const Q : i32 = 256;                   // one whole unit in Q8
pub const NO_FRAMES : i32 = 0;              // a tween of no frames is its end state

// ---- easings -----------------------------------------------------------------------------------------

pub const EASE_LINEAR : u8 = 0;
pub const EASE_IN : u8 = 1;
pub const EASE_OUT : u8 = 2;
pub const EASE_IN_OUT : u8 = 3;
pub const EASE_KINDS : u8 = 4;
pub const EASE_NAMES : [4]str = ["linear", "in", "out", "in-out"];

/// The eased progress of u in 0..Q, still in 0..Q. Every easing is pinned at both ends, so a tween
/// always starts where it was asked to and always ends where it was asked to.
pub fn ease(kind: u8, u: i32) -> i32 {
    const x = clamp(u, 0, Q);
    if (kind == EASE_IN) { return @divTrunc(x * x, Q); }
    if (kind == EASE_OUT) { return Q - @divTrunc((Q - x) * (Q - x), Q); }
    if (kind == EASE_IN_OUT) {
        const half = @divTrunc(Q, 2);
        if (x < half) { return @divTrunc(2 * x * x, Q); }
        const r = Q - x;
        return Q - @divTrunc(2 * r * r, Q);
    }
    return x;
}

pub fn ease_kind_of(name: str) -> u8 {
    var i : u8 = 0;
    while (i < EASE_KINDS) {
        if (EASE_NAMES[i as usize] == name) { return i; }
        i = i + 1;
    }
    return EASE_LINEAR;
}

// ---- tweens ------------------------------------------------------------------------------------------

pub const MAX_FRAMES : i32 = 240;          // 8 s at 30 fps: longer than any transition here

/// The progress of a d-frame tween at frame f, in 0..Q. Before frame 0 it is 0; at or past d it is Q.
pub fn progress(frame: i32, frames: i32) -> i32 {
    if (frames <= NO_FRAMES) { return Q; }
    if (frame <= 0) { return 0; }
    if (frame >= frames) { return Q; }
    return clamp(@divTrunc(frame * Q, frames), 0, Q);
}

/// The value of a tween from a to b over d frames, at frame f, eased by kind.
pub fn tween(a: i32, b: i32, frame: i32, frames: i32, kind: u8) -> i32 {
    const p = ease(kind, progress(frame, frames));
    return a + @divTrunc((b - a) * p, Q);
}

// ---- springs -----------------------------------------------------------------------------------------

/// A discrete, heavily damped integrator: vel gains stiffness * the remaining distance and loses
/// damping * itself each step, and the position gains vel. Chosen so a step never overshoots (the
/// test walks it), because an overshoot in a HUD reads as a bug.
pub const SPRING_STIFF : i32 = 64;         // Q8, 0.25 of the remaining distance a step
pub const SPRING_DAMP : i32 = 192;         // Q8, 0.75 of the velocity a step
pub const SPRING_SETTLE : i32 = 120;       // frames to within a Q8 of the target, measured below
pub const SPRING_NEAR : i32 = 16;          // "settled" is this close, in Q8

/// The spring's value at frame f, from rest at 0 toward target. Pure: the same (target, f) walks the
/// same integration every time, and past SPRING_SETTLE the answer stops moving.
///
/// A step that would reach or cross the target lands on it and stops. Without that rule the
/// fixed-point floor breaks the decay: once vel is 1, damping subtracts @divTrunc(1 * SPRING_DAMP, Q)
/// which is 0, so vel never falls below 1 and the position would march past the target one unit a
/// frame forever. Measured, not hypothetical -- the first version of this spec failed its own
/// overshoot test at exactly that step.
pub fn spring_at(target: i32, frame: i32) -> i32 {
    var v : i32 = 0;
    var vel : i32 = 0;
    const n = imin(imax(frame, 0), SPRING_SETTLE);
    var i : i32 = 0;
    while (i < n) {
        vel = vel + @divTrunc((target - v) * SPRING_STIFF, Q) - @divTrunc(vel * SPRING_DAMP, Q);
        const next = v + vel;
        if ((vel > 0 and next >= target) or (vel < 0 and next <= target)) {
            return target;
        }
        v = next;
        i = i + 1;
    }
    return v;
}

// ---- the one place a caller asks for a value: reduced motion lives here -------------------------------

pub fn reduced_motion(on: bool) -> bool {
    return on;
}

/// FR-003: with reduced motion on, every motion value IS its end state, on every frame -- not a faster
/// animation, not a shorter one. The test walks every easing and a range of frames.
pub fn value_at(reduced: bool, a: i32, b: i32, frame: i32, frames: i32, kind: u8) -> i32 {
    if (reduced) { return b; }
    return tween(a, b, frame, frames, kind);
}

/// The spring with reduced motion respected: the end state is the target.
pub fn spring_value_at(reduced: bool, target: i32, frame: i32) -> i32 {
    if (reduced) { return target; }
    return spring_at(target, frame);
}

/// Whether a motion is still moving at frame f: the frame budget has not run out and the value has not
/// arrived. A caller that keeps animating a settled value burns frames for nothing.
pub fn still_moving(a: i32, b: i32, frame: i32, frames: i32, kind: u8) -> bool {
    if (frame >= frames) { return false; }
    return tween(a, b, frame, frames, kind) != b;
}

// ---- tests -------------------------------------------------------------------------------------------

test every_easing_is_pinned_and_bounded {
    assert(EASE_NAMES.len == 4);
    assert(EASE_KINDS == 4);
    var k : u8 = 0;
    while (k < EASE_KINDS) {
        assert(ease(k, 0) == 0);
        assert(ease(k, Q) == Q);
        var u : i32 = 0;
        while (u <= Q) {
            const e = ease(k, u);
            assert(e >= 0 and e <= Q);
            u = u + 1;
        }
        // outside the domain it is pinned, never extrapolated
        assert(ease(k, 0 - 50) == 0);
        assert(ease(k, Q + 50) == Q);
        k = k + 1;
    }
    assert(ease(EASE_IN, Q / 2) < Q / 2);
    assert(ease(EASE_OUT, Q / 2) > Q / 2);
    assert(ease(EASE_LINEAR, 100) == 100);
    assert(ease_kind_of("in-out") == EASE_IN_OUT);
    assert(ease_kind_of("nope") == EASE_LINEAR);
}

test easings_never_go_backwards {
    var k : u8 = 0;
    while (k < EASE_KINDS) {
        var u : i32 = 0;
        var last : i32 = 0 - 1;
        while (u <= Q) {
            const e = ease(k, u);
            assert(e >= last);
            last = e;
            u = u + 4;
        }
        k = k + 1;
    }
}

test a_tween_starts_and_ends_where_it_was_asked_to {                    // FR-002, first half
    assert(progress(0, 10) == 0);
    assert(progress(10, 10) == Q);
    assert(progress(999, 10) == Q);
    assert(progress(0 - 3, 10) == 0);
    assert(progress(5, 0) == Q);
    var k : u8 = 0;
    while (k < EASE_KINDS) {
        assert(tween(100, 900, 0, 30, k) == 100);
        assert(tween(100, 900, 30, 30, k) == 900);
        assert(tween(100, 900, 1000, 30, k) == 900);
        // and it stays inside the interval it was given: no overshoot on any easing
        var f : i32 = 0;
        var last : i32 = 0 - 1;
        while (f <= 60) {
            const v = tween(100, 900, f, 30, k);
            assert(v >= 100 and v <= 900);
            assert(v >= last);
            last = v;
            f = f + 1;
        }
        // a downward tween is bounded too
        assert(tween(900, 100, 0, 30, k) == 900);
        assert(tween(900, 100, 30, 30, k) == 100);
        k = k + 1;
    }
}

test reduced_motion_jumps_to_the_end_state {                           // FR-003
    var k : u8 = 0;
    while (k < EASE_KINDS) {
        var f : i32 = 0;
        while (f <= 60) {
            assert(value_at(true, 100, 900, f, 30, k) == 900);
            assert(value_at(true, 900, 100, f, 30, k) == 100);
            f = f + 5;
        }
        k = k + 1;
    }
    assert(reduced_motion(true));
    assert(!reduced_motion(false));
    // a spring with reduced motion is the target, not an integrated approach
    assert(spring_value_at(true, 700, 0) == 700);
    assert(spring_value_at(true, 700, 1) == 700);
    assert(spring_value_at(false, 700, 0) == 0);
}

test the_spring_reaches_its_target_without_overshooting {              // FR-002, second half
    assert(spring_at(1000, 0) == 0);
    var last : i32 = 0;
    var f : i32 = 0;
    while (f <= SPRING_SETTLE) {
        const v = spring_at(1000, f);
        assert(v >= last);                 // monotone: a spring that overshoots would dip here
        assert(v <= 1000);                 // and never passes the target
        last = v;
        f = f + 1;
    }
    assert(iabs(spring_at(1000, SPRING_SETTLE) - 1000) <= SPRING_NEAR);
    assert(spring_at(1000, SPRING_SETTLE) == spring_at(1000, SPRING_SETTLE + 500));
    assert(spring_at(0, 40) == 0);
    assert(spring_at(1000, 0 - 5) == 0);
}

test the_spring_is_pure_in_the_frame_number {
    var target : i32 = 16;
    while (target <= 4096) {
        var f : i32 = 0;
        while (f <= SPRING_SETTLE) {
            assert(spring_at(target, f) == spring_at(target, f));
            f = f + 17;
        }
        target = target * 4;
    }
    // the same frame asked twice from different call sites is the same number
    assert(spring_at(500, 77) == spring_at(500, 77));
}

test a_settled_motion_says_so_instead_of_burning_frames {
    var k : u8 = 0;
    while (k < EASE_KINDS) {
        assert(still_moving(100, 900, 0, 30, k));
        assert(!still_moving(100, 900, 30, 30, k));
        assert(!still_moving(100, 900, 31, 30, k));
        k = k + 1;
    }
    assert(!still_moving(100, 900, 0, 0, EASE_LINEAR));
}

invariant no_motion_value_reads_a_clock {
    assert(Q == 256);
    assert(NO_FRAMES == 0);
    assert(MAX_FRAMES > 0);
    assert(SPRING_STIFF > 0 and SPRING_DAMP > SPRING_STIFF);
    assert(SPRING_SETTLE > 0 and SPRING_NEAR > 0);
    assert(EASE_KINDS == EASE_NAMES.len);
}
