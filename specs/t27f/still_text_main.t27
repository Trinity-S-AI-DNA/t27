// SPDX-License-Identifier: Apache-2.0
// specs/t27f/still_text_main.t27 -- a text view of a P6 still, one character per cell.
// Issue gHashTag/t27#13248.
//
// WHY: an agent whose session cannot carry an image still has to check a still. The view
// reads a binary P6, refuses a header that is not a plain 255 maxval P6, and maps each
// scale-by-scale block to one character. A mixed block is a question mark. This is a byte
// check. It is not a picture, and it does not say how a browser would paint the file.
//
// HOW (main): FRAME_IN is a P6 path, or target/course_bench_board.ppm. STILL_SCALE is the
// cell size in pixels (default 1, one character per pixel; 3 for the bench-board still).
// The view prints one row of characters per cell row. A light block is '#', a dark block is
// a space, a mixed block is '?'. A refused header exits 1. This main does not post the file.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module still_text_main;

pub const P6_OK : u8 = 0;
pub const P6_MAGIC : u8 = 1;
pub const P6_MAXVAL : u8 = 2;
pub const P6_COMMENT : u8 = 3;
pub const P6_TRUNC : u8 = 4;
pub const P6_SHORT : u8 = 5;

pub const CELL_LIGHT : u8 = 35;
pub const CELL_DARK : u8 = 32;
pub const CELL_MIXED : u8 = 63;
pub const LUMA_LIGHT : u32 = 384;

pub struct P6View {
    code: u8,
    w: u32,
    h: u32,
    at: u32,
}

fn blank() -> P6View {
    return P6View { code: P6_TRUNC, w: 0, h: 0, at: 0 };
}

fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

// Read one decimal at `at`. A '#' is a comment. Running out of bytes is a truncated header.
fn read_num(src: []const u8, at: usize) -> P6View {
    var info = blank();
    info.at = at as u32;
    if (at >= src.len) {
        info.code = P6_TRUNC;
        return info;
    }
    if (src[at] == 35) {
        info.code = P6_COMMENT;
        return info;
    }
    if (!is_digit(src[at])) {
        info.code = P6_MAGIC;
        return info;
    }
    var i : usize = at;
    var n : u32 = 0;
    while (i < src.len && is_digit(src[i])) {
        n = n * 10 + (src[i] - 48) as u32;
        i = i + 1;
    }
    info.code = P6_OK;
    info.w = n;
    info.at = i as u32;
    return info;
}

fn need_sep(src: []const u8, at: usize) -> P6View {
    var info = blank();
    info.at = at as u32;
    if (at >= src.len) {
        info.code = P6_TRUNC;
        return info;
    }
    if (src[at] == 35) {
        info.code = P6_COMMENT;
        return info;
    }
    if (src[at] != 32 && src[at] != 10) {
        info.code = P6_MAGIC;
        return info;
    }
    info.code = P6_OK;
    info.at = (at + 1) as u32;
    return info;
}

// Open a P6 whose header is "P6\n", then width, height and maxval 255, with no comment.
// The body must hold 3*w*h bytes. Anything else is a named refusal, and w/h/at stay 0.
pub fn p6_open(src: []const u8) -> P6View {
    var info = blank();
    if (src.len < 3) {
        return info;
    }
    if (src[0] != 80 || src[1] != 54 || src[2] != 10) {
        info.code = P6_MAGIC;
        return info;
    }
    const width = read_num(src, 3);
    if (width.code != P6_OK) {
        return width;
    }
    const sep_h = need_sep(src, width.at as usize);
    if (sep_h.code != P6_OK) {
        return sep_h;
    }
    const height = read_num(src, sep_h.at as usize);
    if (height.code != P6_OK) {
        return height;
    }
    const sep_m = need_sep(src, height.at as usize);
    if (sep_m.code != P6_OK) {
        return sep_m;
    }
    const maxv = read_num(src, sep_m.at as usize);
    if (maxv.code != P6_OK) {
        return maxv;
    }
    if ((maxv.at as usize) >= src.len) {
        info.code = P6_TRUNC;
        return info;
    }
    if (src[maxv.at as usize] != 10) {
        info.code = P6_MAGIC;
        return info;
    }
    if (maxv.w != 255) {
        info.code = P6_MAXVAL;
        return info;
    }
    if (width.w == 0 || height.w == 0 || width.w > 4096 || height.w > 4096) {
        info.code = P6_MAGIC;
        return info;
    }
    const at = maxv.at + 1;
    const need = width.w * height.w * 3;
    if ((src.len as u32) < at + need) {
        info.code = P6_SHORT;
        return info;
    }
    return P6View { code: P6_OK, w: width.w, h: height.w, at: at };
}

// 0 dark, 1 light, 2 mixed, 3 outside the cell grid, 4 the header was refused.
pub fn cell_kind(src: []const u8, info: P6View, scale: u32, cx: u32, cy: u32) -> u8 {
    if (info.code != P6_OK || scale == 0 || info.w == 0 || info.h == 0) {
        return 4;
    }
    if (cx >= info.w / scale || cy >= info.h / scale) {
        return 3;
    }
    const x0 = cx * scale;
    const y0 = cy * scale;
    var r0 : u8 = 0;
    var g0 : u8 = 0;
    var b0 : u8 = 0;
    var seen = false;
    var dy : u32 = 0;
    while (dy < scale) {
        var dx : u32 = 0;
        while (dx < scale) {
            const x = x0 + dx;
            const y = y0 + dy;
            const o = (info.at as usize) + ((y * info.w + x) * 3) as usize;
            if (o + 2 >= src.len) {
                return 4;
            }
            if (!seen) {
                r0 = src[o];
                g0 = src[o + 1];
                b0 = src[o + 2];
                seen = true;
            } else if (src[o] != r0 || src[o + 1] != g0 || src[o + 2] != b0) {
                return 2;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    const luma = (r0 as u32) + (g0 as u32) + (b0 as u32);
    if (luma >= LUMA_LIGHT) {
        return 1;
    }
    return 0;
}

pub fn cell_char(src: []const u8, info: P6View, scale: u32, cx: u32, cy: u32) -> u8 {
    const k = cell_kind(src, info, scale, cx, cy);
    if (k == 1) {
        return CELL_LIGHT;
    }
    if (k == 0) {
        return CELL_DARK;
    }
    if (k == 2) {
        return CELL_MIXED;
    }
    return 0;
}

pub fn mixed_cells(src: []const u8, info: P6View, scale: u32) -> u32 {
    if (info.code != P6_OK || scale == 0) {
        return 0;
    }
    var n : u32 = 0;
    var cy : u32 = 0;
    while (cy < info.h / scale) {
        var cx : u32 = 0;
        while (cx < info.w / scale) {
            if (cell_kind(src, info, scale, cx, cy) == 2) {
                n = n + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    return n;
}

pub fn main() void {
    var path : [*:0]const u8 = "target/course_bench_board.ppm";
    const q = std.c.getenv("FRAME_IN");
    if (q != null) {
        path = q.?;
    }
    var scale : u32 = 1;
    const qs = std.c.getenv("STILL_SCALE");
    if (qs != null) {
        const s = qs.?;
        if (s[0] >= 48 && s[0] <= 57) {
            scale = (s[0] - 48) as u32;
            if (s[1] >= 48 && s[1] <= 57) {
                scale = scale * 10 + (s[1] - 48) as u32;
            }
        }
    }
    if (scale == 0) {
        scale = 1;
    }
    const fp = std.c.fopen(path, "rb");
    if (fp == null) {
        std.debug.print("still_text: cannot open {s}\n", .{path});
        std.c.exit(1);
    }
    var buf : [404475]u8 = [0] ** 404475;
    const n : usize = std.c.fread(@ptrCast(&buf), 1, buf.len, fp.?);
    _ = std.c.fclose(fp.?);
    const info = p6_open(buf[0..n]);
    if (info.code != P6_OK) {
        std.debug.print("still_text: refused {d}\n", .{info.code});
        std.c.exit(1);
    }
    var cols = info.w / scale;
    if (cols > 4096) {
        cols = 4096;
    }
    var y : u32 = 0;
    while (y < info.h / scale) {
        var line : [4096]u8 = [32] ** 4096;
        var x : u32 = 0;
        while (x < cols) {
            line[x as usize] = cell_char(buf[0..n], info, scale, x, y);
            x = x + 1;
        }
        std.debug.print("{s}\n", .{ line[0..(cols as usize)] });
        y = y + 1;
    }
}

test "a one-cell P6 opens and the white cell is light" {
    var b : [14]u8 = [80, 54, 10, 49, 32, 49, 10, 50, 53, 53, 10, 255, 255, 255];
    const info = p6_open(b[0..14]);
    assert(info.code == P6_OK);
    assert(info.w == 1);
    assert(info.h == 1);
    assert(info.at == 11);
    assert(cell_char(b[0..14], info, 1, 0, 0) == CELL_LIGHT);
    assert(mixed_cells(b[0..14], info, 1) == 0);
}

test "a header that is not P6 is refused" {
    var b : [8]u8 = [80, 51, 10, 49, 32, 49, 10, 0];
    const info = p6_open(b[0..7]);
    assert(info.code == P6_MAGIC);
    assert(info.w == 0);
}

test "a maxval other than 255 is refused" {
    var b : [10]u8 = [80, 54, 10, 49, 32, 49, 10, 49, 53, 10];
    const info = p6_open(b[0..10]);
    assert(info.code == P6_MAXVAL);
}

test "a comment in the header is refused" {
    var b : [14]u8 = [80, 54, 10, 35, 120, 10, 49, 32, 49, 10, 50, 53, 53, 10];
    const info = p6_open(b[0..14]);
    assert(info.code == P6_COMMENT);
}

test "a truncated header is refused" {
    var b : [6]u8 = [80, 54, 10, 49, 32, 49];
    const info = p6_open(b[0..6]);
    assert(info.code == P6_TRUNC);
    var short : [2]u8 = [80, 54];
    assert(p6_open(short[0..2]).code == P6_TRUNC);
}
