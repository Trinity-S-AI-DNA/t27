// SPDX-License-Identifier: Apache-2.0
; T27F text measurement: the one line-break rule for visual-factory text, used by vf_layout now and by the renderer next
; Refs Trinity-S-AI-DNA/t27#13251 (course v2, ring 3: text measurement)
; Font: the frame_render 5x7 glyphs, FONT_W 5 columns, FONT_ADVANCE 6 per char, so n chars are text_width(n) = 5 + 6 (n - 1) px
; A text box of width w keeps a 4 px inset on each side: content width cw = w - 8 (0 when w <= 8)
; Capacity: the most chars whose text_width fits cw, (cw + 1) / 6, and 0 when cw < 5
; Wrap: greedy at spaces; a word longer than a line is broken mid-word at capacity, a line is never widened
; A wrapped line drops its leading spaces; trailing spaces never open a new line; the first line keeps its leading spaces
; Height: 20 px for one line (or for empty text, or for no room), plus 10 px per extra line
; Capacity 0 with a non-empty text measures as 0 lines and height 20: that text does not fit, and vf_pixel counts it
; It is NOT a human-eye proof: it measures chars and pixels of the 5x7 font, it draws nothing
; All arithmetic is u32 and non-negative: compare before subtracting. ASCII only (L3)

module VfTextMeasure;
use t27f::frame_render::text_width;
use t27f::frame_render::FONT_W;
use t27f::frame_render::FONT_ADVANCE;

; the label inset on both sides together, the one-line height, the height of each extra line, the break char
pub const VF_TM_PAD : u32 = 8;
pub const VF_TM_LINE1_H : u32 = 20;
pub const VF_TM_LINE_H : u32 = 10;
pub const VF_TM_SPACE : u8 = 32;

; the content width of a text box w px wide
pub fn vf_text_content_w(w: u32) -> u32 {
    if w <= VF_TM_PAD {
        return 0;
    }
    return w - VF_TM_PAD;
}

; how many chars of the 5x7 font fit cw px: the last glyph needs FONT_W, every earlier one FONT_ADVANCE
pub fn vf_text_capacity(cw: u32) -> u32 {
    if cw < FONT_W {
        return 0;
    }
    return (cw + FONT_ADVANCE - FONT_W) / FONT_ADVANCE;
}

; the char count of s (bytes: the font is ASCII)
pub fn vf_text_chars(s: str) -> u32 {
    return s.len as u32;
}

; the one-line width of a button or badge label: its text width plus the inset
pub fn vf_label_width(s: str) -> u32 {
    return text_width(vf_text_chars(s)) + VF_TM_PAD;
}

; the first index at or after pos that is not a space, or the length of s
fn vf_tm_skip(s: str, pos: u32) -> u32 {
    var n : u32 = s.len as u32;
    var p : u32 = pos;
    var going : bool = true;
    while going and p < n {
        if s[p] == VF_TM_SPACE {
            p = p + 1;
        } else {
            going = false;
        }
    }
    return p;
}

; the end (exclusive) of the line that starts at pos < len(s) with capacity c >= 1:
; the rest when it fits, else the last space at or before pos + c, else pos + c (a mid-word break)
fn vf_tm_line_end(s: str, pos: u32, c: u32) -> u32 {
    var n : u32 = s.len as u32;
    if n - pos <= c {
        return n;
    }
    var b : u32 = pos + c;
    while b > pos {
        if s[b] == VF_TM_SPACE {
            return b;
        }
        b = b - 1;
    }
    return pos + c;
}

; how many lines s takes in a text box w px wide: 0 for empty text and for capacity 0
pub fn vf_text_lines(s: str, w: u32) -> u32 {
    var n : u32 = s.len as u32;
    var c : u32 = vf_text_capacity(vf_text_content_w(w));
    if n == 0 or c == 0 {
        return 0;
    }
    var k : u32 = 0;
    var pos : u32 = 0;
    var going : bool = true;
    while going {
        if k > 0 {
            pos = vf_tm_skip(s, pos);
        }
        if pos >= n {
            going = false;
        } else {
            pos = vf_tm_line_end(s, pos, c);
            k = k + 1;
        }
    }
    return k;
}

; walk to line k of s at width w: its start index, or its length when want_len; past the last line, start len(s) and length 0
fn vf_tm_walk(s: str, w: u32, k: u32, want_len: bool) -> u32 {
    var n : u32 = s.len as u32;
    var c : u32 = vf_text_capacity(vf_text_content_w(w));
    var at : u32 = n;
    var len : u32 = 0;
    if c > 0 {
        var i : u32 = 0;
        var pos : u32 = 0;
        var going : bool = true;
        while going {
            if i > 0 {
                pos = vf_tm_skip(s, pos);
            }
            if pos >= n {
                going = false;
            } else {
                var e : u32 = vf_tm_line_end(s, pos, c);
                if i == k {
                    at = pos;
                    len = e - pos;
                    going = false;
                } else {
                    pos = e;
                    i = i + 1;
                }
            }
        }
    }
    if want_len {
        return len;
    }
    return at;
}

; the index in s where line k starts
pub fn vf_text_line_start(s: str, w: u32, k: u32) -> u32 {
    return vf_tm_walk(s, w, k, false);
}

; the char count of line k, the spaces before its break point included
pub fn vf_text_line_len(s: str, w: u32, k: u32) -> u32 {
    return vf_tm_walk(s, w, k, true);
}

; the height of a text box w px wide holding s: 20 for 0 or 1 line, 20 + 10 (lines - 1) otherwise
pub fn vf_text_height(s: str, w: u32) -> u32 {
    var lines : u32 = vf_text_lines(s, w);
    if lines <= 1 {
        return VF_TM_LINE1_H;
    }
    return VF_TM_LINE1_H + VF_TM_LINE_H * (lines - 1);
}

test tm_capacity_follows_the_5x7_font {
    assert vf_text_capacity(367) == 61;
    assert vf_text_capacity(5) == 1;
    assert vf_text_capacity(4) == 0;
    assert vf_text_capacity(10) == 1;
    assert vf_text_capacity(11) == 2;
    assert vf_text_capacity(0) == 0;
    // 61 chars are 365 px and fit 367, 62 chars are 371 px and do not
    assert text_width(61) == 365;
    assert text_width(62) == 371;
    assert vf_text_content_w(375) == 367;
    assert vf_text_content_w(80) == 72;
    assert vf_text_content_w(8) == 0;
    assert vf_text_content_w(0) == 0;
}

test tm_exact_capacity_is_one_line {
    // w 80: content 72, capacity 12
    assert vf_text_capacity(vf_text_content_w(80)) == 12;
    assert vf_text_lines("abcdefghijkl", 80) == 1;
    assert vf_text_height("abcdefghijkl", 80) == 20;
    assert vf_text_line_len("abcdefghijkl", 80, 0) == 12;
    assert vf_text_lines("abcdefghijklm", 80) == 2;
    assert vf_text_height("abcdefghijklm", 80) == 30;
}

test tm_a_long_word_breaks_mid_word {
    assert vf_text_line_start("abcdefghijklm", 80, 0) == 0;
    assert vf_text_line_len("abcdefghijklm", 80, 0) == 12;
    assert vf_text_line_start("abcdefghijklm", 80, 1) == 12;
    assert vf_text_line_len("abcdefghijklm", 80, 1) == 1;
    // a 30-char word at capacity 12 is 12 + 12 + 6 chars, never one wider line
    assert vf_text_lines("abcdefghijklmnopqrstuvwxyz0123", 80) == 3;
    assert vf_text_line_start("abcdefghijklmnopqrstuvwxyz0123", 80, 2) == 24;
    assert vf_text_line_len("abcdefghijklmnopqrstuvwxyz0123", 80, 2) == 6;
    assert vf_text_height("abcdefghijklmnopqrstuvwxyz0123", 80) == 40;
}

test tm_two_lines_break_at_the_space {
    // the task-card title is 14 chars, 83 px: it does not fit the 80 px title box, so it takes two lines
    assert text_width(14) == 83;
    assert vf_text_lines("Write the spec", 80) == 2;
    assert vf_text_line_start("Write the spec", 80, 0) == 0;
    assert vf_text_line_len("Write the spec", 80, 0) == 9;
    assert vf_text_line_start("Write the spec", 80, 1) == 10;
    assert vf_text_line_len("Write the spec", 80, 1) == 4;
    assert vf_text_height("Write the spec", 80) == 30;
}

test tm_three_lines_drop_leading_spaces {
    // w 40: content 32, capacity 5
    assert vf_text_capacity(vf_text_content_w(40)) == 5;
    assert vf_text_lines("one two three", 40) == 3;
    assert vf_text_line_start("one two three", 40, 0) == 0;
    assert vf_text_line_len("one two three", 40, 0) == 3;
    assert vf_text_line_start("one two three", 40, 1) == 4;
    assert vf_text_line_len("one two three", 40, 1) == 3;
    assert vf_text_line_start("one two three", 40, 2) == 8;
    assert vf_text_line_len("one two three", 40, 2) == 5;
    assert vf_text_line_start("one two three", 40, 3) == 13;
    assert vf_text_line_len("one two three", 40, 3) == 0;
    assert vf_text_height("one two three", 40) == 40;
}

test tm_a_line_can_end_at_capacity {
    // w 44: content 36, capacity 6; "ab cde" is exactly 6 chars and stays on line 0
    assert vf_text_lines("ab cde fgh", 44) == 2;
    assert vf_text_line_len("ab cde fgh", 44, 0) == 6;
    assert vf_text_line_start("ab cde fgh", 44, 1) == 7;
    assert vf_text_line_len("ab cde fgh", 44, 1) == 3;
    // trailing spaces past capacity open no line
    assert vf_text_lines("abcdef  ", 44) == 1;
    assert vf_text_height("abcdef  ", 44) == 20;
}

test tm_empty_text_and_no_room {
    assert vf_text_lines("", 80) == 0;
    assert vf_text_height("", 80) == 20;
    assert vf_text_line_start("", 80, 0) == 0;
    assert vf_text_line_len("", 80, 0) == 0;
    // w 12: content 4, capacity 0, so nothing fits and nothing is counted as a line
    assert vf_text_lines("x", 12) == 0;
    assert vf_text_height("x", 12) == 20;
    assert vf_text_line_len("x", 12, 0) == 0;
    // button and badge labels: "Save" is 23 px plus the inset, an empty label is the inset alone
    assert vf_label_width("Save") == 31;
    assert vf_label_width("Open") == 31;
    assert vf_label_width("") == 8;
}

test tm_negative_controls {
    // the same title at w 92 (capacity 14) is one line: the wrap comes from the width, not from the text
    assert vf_text_lines("Write the spec", 92) == 1;
    assert vf_text_height("Write the spec", 92) == 20;
    // one char past capacity is never one line, and a break never makes a line wider than capacity
    assert vf_text_lines("abcdefghijklm", 80) != 1;
    assert vf_text_line_len("abcdefghijklm", 80, 0) <= 12;
    // the height follows the width: 3 lines at 40, 1 line at 375
    assert vf_text_height("one two three", 40) != vf_text_height("one two three", 375);
    assert vf_text_height("one two three", 375) == 20;
}
