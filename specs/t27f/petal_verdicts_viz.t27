// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_verdicts_viz.t27 -- petal 21 (V VERDICTS), the interactive visualization of the
; run-level verdict. Epic gHashTag/t27#12173, plan row 21 of specs/t27f/petal_viz_plan.t27. Built on
; the shared contract specs/t27f/viz_contract.t27, in the pattern of the reference petal
; specs/t27f/petal_specs_viz.t27.
; --
; What it answers: "Which verdict does this spec carry, and which rule gave it?" The reader opens a
; small set of machine-readable run records, picks one, steps through the rules the source applies to
; it in the order it applies them, and switches ONE fact off for every record at once (the run id,
; the artifact id, the evidence id, the change binding, the tests, the seal, or the hardware field) to
; watch which verdict and which rule change.
; --
; Source of truth: specs/verified/verdict.t27 (record_status, run_verdict, hw_field_honest) over
; specs/verified/evidence_chain.t27 (chain and its codes) and specs/verified/reuse.t27 (the hardware
; states). This petal holds the INPUTS of seven records (which ids are named, which links are bound)
; and nothing that decides: every verdict, chain code and honesty flag below is a call of those pub
; functions. A rule is never copied here, so the petal cannot drift from the source.
; --
; Layers of this spec:
;   L1 state       PvvState = one VizState (the contract's) + the truth the last load reported;
;                  pvv_apply forwards every event to the one reducer viz_apply and recomputes ONLY the
;                  truth (the what-if turns VERIFIED into DEMO and back).
;   L2 entities    record i = viz_ref(NODE, i); the focus order is records 0..6. The trace step is the
;                  contract's own step (VizState.step); a rule is a row of the trace, not an entity.
;   L3 fixture     seven records: pass, no references, no artifact (and a broken seal), no evidence,
;                  another change's run, no tests, and a PASS whose hardware field lies.
;   L4 rules       pvv_probe(r, k): k = 0..2 isolate one reference (run, artifact, evidence), k = 3 is
;                  the chain verdict alone, k = 4 is the whole verdict. pvv_rule(r) is the first rule
;                  that fires, PVV_RULE_NONE (4) when none does and the record passes.
;   L5 what-if     the contract's param (0..7): 0 changes nothing; 1..7 break one fact in EVERY record.
;   L6 views       list (one verdict per record), trace (the probes of the record under the pointer,
;                  revealed up to the current step), inspector (verdict, rule, chain code and hardware
;                  honesty of that record) and badge (the truth): all four read the ONE VizState.
;   L7 truth       VERIFIED while every shown value is the source's rule over its own fixture; DEMO
;                  while a what-if is on (viz_may_claim false); CACHED and UNKNOWN are kept as loaded.
;   L8 host        pvv_host: nested VizHost slots for the badge, list, trace and inspector; pvv_reps is
;                  the set of reps it uses and equals the plan's row 21 (308).
; --
; Integer only: no floats. Pixel geometry is in frame coordinates (the origin is the frame's top-left
; corner), so a hit test and pvv_host agree without an offset; embedded in another host the whole
; petal moves by the slot offset and nothing else.
; --
; Not claimed: no host draws this petal yet (wiring it into specs/t27os/glass_window.t27 is the next
; child issue of #12173). The records are a fixture of seven cases, not the live run ledger, so a host
; that feeds real records must report LIVE itself. The plan (petal_viz_plan.t27) imports psv_reps from
; the reference petal, so it must not import pvv_reps from here without a module cycle.

module t27f_petal_verdicts_viz;

use verified::verdict::PASS;
use verified::verdict::FAIL;
use verified::verdict::INVALID_NO_RUN;
use verified::verdict::INVALID_NO_ARTIFACT;
use verified::verdict::INVALID_NO_EVIDENCE;
use verified::verdict::run_verdict;
use verified::verdict::record_status;
use verified::verdict::hw_field_honest;
use verified::evidence_chain::chain;
use verified::evidence_chain::SEAL_NOT_RUN;
use verified::evidence_chain::SEAL_MATCH;
use verified::evidence_chain::SEAL_MISMATCH;
use verified::evidence_chain::LINKED;
use verified::evidence_chain::NO_CHANGE;
use verified::evidence_chain::RUN_UNBOUND;
use verified::evidence_chain::RUN_OTHER_CHANGE;
use verified::evidence_chain::EVIDENCE_UNBOUND;
use verified::evidence_chain::NO_TESTS;
use verified::evidence_chain::SEAL_NOT_VERIFIED;
use verified::reuse::HW_UNPROVEN;
use verified::reuse::HW_VERIFIED;
use t27f::viz_contract;
use t27f::petal_viz_plan::pvp_reps;
use t27f::petal_viz_plan::pvp_truth;
use t27f::petal_specs_viz::psv_host_reps;

; ---------------------------------------------------------------- constants

/// The fixture: seven records, so seven focusable items.
pub const PVV_RECORD_COUNT : u32 = 7;
/// Trace rows (steps 0..4): the three reference probes, the chain probe and the whole verdict.
pub const PVV_STEPS : u32 = 5;
/// What-if choices: 0 changes nothing, 1..7 each break one fact.
pub const PVV_WHATIFS : u32 = 8;
/// The petal's row in the plan (agent letter V, index 21).
pub const PVV_PETAL : u32 = 21;
/// "No record": nothing is hovered or selected, or the ref is not one of the seven.
pub const PVV_NO_RECORD : u32 = 65535;
/// "No code": a hidden trace row, a row past the fixture, no record under the pointer. Not a verdict.
pub const PVV_NO_VERDICT : u8 = 255;
/// The rule index of "no rule fired": the record passes.
pub const PVV_RULE_NONE : u32 = 4;
/// No rule to name (no record under the pointer).
pub const PVV_NO_RULE : u32 = 255;

/// Pixel geometry in frame coordinates.
pub const PVV_BADGE_X : u32 = 20;
pub const PVV_BADGE_Y : u32 = 10;
pub const PVV_BADGE_W : u32 = 300;
pub const PVV_BADGE_H : u32 = 40;
pub const PVV_LINE_H : u32 = 22;
pub const PVV_LIST_X : u32 = 20;
pub const PVV_LIST_Y : u32 = 60;
pub const PVV_LIST_W : u32 = 440;
pub const PVV_TRACE_X : u32 = 480;
pub const PVV_TRACE_Y : u32 = 60;
pub const PVV_TRACE_W : u32 = 400;
pub const PVV_INSPECT_X : u32 = 900;
pub const PVV_INSPECT_Y : u32 = 60;
pub const PVV_INSPECT_W : u32 = 400;
pub const PVV_INSPECT_H : u32 = 154;

/// Host slot numbers, in the depth-first order pvv_host adds them (index order is focus order).
pub const PVV_SLOT_BADGE : u32 = 0;
pub const PVV_SLOT_LIST : u32 = 1;
pub const PVV_SLOT_TRACE : u32 = 2;
pub const PVV_SLOT_INSPECTOR : u32 = 3;

; ---------------------------------------------------------------- L3 fixture (inputs only)

/// One machine-readable run record, as the inputs the source rules read. Nothing here decides.
pub struct PvvRecord {
    has_run: bool,
    has_artifact: bool,
    has_evidence: bool,
    change: u64,
    run_change: u64,
    run: u64,
    ev_run: u64,
    has_outputs: bool,
    has_tests: bool,
    has_logs: bool,
    seal: u8,
    reported_hw: u8,
    evidence_hw: u8,
}

/// A record that names nothing and binds nothing: the stand-in for a row past the fixture.
pub fn pvv_blank() -> PvvRecord {
    return PvvRecord { has_run: false, has_artifact: false, has_evidence: false, change: 0, run_change: 0, run: 0, ev_run: 0, has_outputs: false, has_tests: false, has_logs: false, seal: SEAL_NOT_RUN, reported_hw: HW_UNPROVEN, evidence_hw: HW_UNPROVEN };
}

/// The whole record: three references, run and evidence bound to the same change, outputs, tests
/// and logs referenced, the seal matching, and an honest UNPROVEN hardware field.
pub fn pvv_whole() -> PvvRecord {
    return PvvRecord { has_run: true, has_artifact: true, has_evidence: true, change: 0xaaaa, run_change: 0xaaaa, run: 7, ev_run: 7, has_outputs: true, has_tests: true, has_logs: true, seal: SEAL_MATCH, reported_hw: HW_UNPROVEN, evidence_hw: HW_UNPROVEN };
}

/// Record i of the fixture: 0 whole, 1 names no reference, 2 has no artifact and a broken seal,
/// 3 has no evidence, 4 ran for another change, 5 lists no tests, 6 passes but reports VERIFIED
/// hardware the evidence does not back. Past the fixture: the blank record.
pub fn pvv_record(i: u32) -> PvvRecord {
    if (i >= PVV_RECORD_COUNT) {
        return pvv_blank();
    }
    var r : PvvRecord = pvv_whole();
    if (i == 1) {
        r.has_run = false;
        r.has_artifact = false;
        r.has_evidence = false;
        r.run = 0;
    }
    if (i == 2) {
        r.has_artifact = false;
        r.seal = SEAL_MISMATCH;
    }
    if (i == 3) {
        r.has_evidence = false;
        r.ev_run = 0;
    }
    if (i == 4) {
        r.run_change = 0xbbbb;
    }
    if (i == 5) {
        r.has_tests = false;
    }
    if (i == 6) {
        r.reported_hw = HW_VERIFIED;
    }
    return r;
}

; ---------------------------------------------------------------- L4 rules (every answer is the source's)

/// The evidence-chain code of a record: the first broken link, or LINKED.
pub fn pvv_chain_of(r: PvvRecord) -> u8 {
    return chain(r.change, r.run_change, r.run, r.ev_run, r.has_outputs, r.has_tests, r.has_logs, r.seal);
}

/// The verdict of a record: the source's record_status over the record's references and chain.
pub fn pvv_verdict_of(r: PvvRecord) -> u8 {
    return record_status(r.has_run, r.has_artifact, r.has_evidence, pvv_chain_of(r));
}

/// Whether the record's hardware field is the evidence's own (the source's verbatim rule).
pub fn pvv_hw_honest(r: PvvRecord) -> bool {
    return hw_field_honest(r.reported_hw, r.evidence_hw);
}

/// One row of the trace. k = 0, 1, 2: the verdict if ONLY the run, the artifact, the evidence
/// reference mattered; k = 3: the chain verdict alone; k = 4: the whole verdict.
/// PVV_NO_VERDICT for any other k.
pub fn pvv_probe(r: PvvRecord, k: u32) -> u8 {
    if (k == 0) { return record_status(r.has_run, true, true, LINKED); }
    if (k == 1) { return record_status(true, r.has_artifact, true, LINKED); }
    if (k == 2) { return record_status(true, true, r.has_evidence, LINKED); }
    if (k == 3) { return run_verdict(pvv_chain_of(r)); }
    if (k == 4) { return pvv_verdict_of(r); }
    return PVV_NO_VERDICT;
}

/// The rule that gave the verdict: the first probe 0..3 that is not PASS, in the order the source
/// judges them; PVV_RULE_NONE when none fires and the record passes.
pub fn pvv_rule(r: PvvRecord) -> u32 {
    var k : u32 = 0;
    while (k < 4) {
        if (pvv_probe(r, k) != PASS) {
            return k;
        }
        k = k + 1;
    }
    return PVV_RULE_NONE;
}

; ---------------------------------------------------------------- L5 what-if

/// The what-if k applied to a record: 0 nothing, 1 no run id, 2 no artifact id, 3 no evidence id,
/// 4 the run belongs to another change, 5 no tests listed, 6 the seal does not match, 7 the hardware
/// field reports VERIFIED. Any other k changes nothing.
pub fn pvv_break(r: PvvRecord, k: u32) -> PvvRecord {
    var n : PvvRecord = r;
    if (k == 1) {
        n.has_run = false;
        n.run = 0;
    }
    if (k == 2) {
        n.has_artifact = false;
    }
    if (k == 3) {
        n.has_evidence = false;
        n.ev_run = 0;
    }
    if (k == 4) {
        n.run_change = r.change + 1;
    }
    if (k == 5) {
        n.has_tests = false;
    }
    if (k == 6) {
        n.seal = SEAL_MISMATCH;
    }
    if (k == 7) {
        n.reported_hw = HW_VERIFIED;
    }
    return n;
}

/// Record i with what-if k switched on.
pub fn pvv_record_under(i: u32, k: u32) -> PvvRecord {
    return pvv_break(pvv_record(i), k);
}

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the truth the last load reported.
pub struct PvvState {
    viz: VizState,
    base: u8,
}

/// The truth shown for a loaded truth and a what-if: a claimable truth (LIVE or VERIFIED) becomes
/// DEMO while a what-if is on; CACHED, DEMO and UNKNOWN are kept as loaded.
pub fn pvv_truth_for(base: u8, param: u32) -> u8 {
    if (param != 0 and viz_may_claim(base)) {
        return VIZ_TRUTH_DEMO;
    }
    return base;
}

/// The one reducer of the petal. Every event goes to viz_apply; only the truth is recomputed
/// afterwards, when a load finishes (the new base) or the what-if moves. A reload that finishes
/// while a what-if is on reports DEMO instead of a truth that may claim a result.
pub fn pvv_apply(p: PvvState, ev: u8, a: u32, b: u32) -> PvvState {
    var n : PvvState = p;
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING) {
        n.base = v.truth;
    }
    if (ev == VIZ_EV_LOADED or ev == VIZ_EV_PARAM_SET) {
        v.truth = pvv_truth_for(n.base, v.param);
    }
    n.viz = v;
    return n;
}

/// Whether the shown truth is the one the rule gives for the loaded truth and the what-if.
pub fn pvv_truth_holds(p: PvvState) -> bool {
    return p.viz.truth == pvv_truth_for(p.base, p.viz.param);
}

/// A petal that has not loaded: idle, truth UNKNOWN, no what-if.
pub fn pvv_idle() -> PvvState {
    return PvvState { viz: viz_init(PVV_STEPS, PVV_WHATIFS), base: VIZ_TRUTH_UNKNOWN };
}

/// A petal opened on the first n records (at most all seven): LOAD, then LOADED. Seven records
/// load VERIFIED; an empty fixture loads UNKNOWN, because nothing was read.
pub fn pvv_open_n(n: u32) -> PvvState {
    var count : u32 = n;
    var truth : u8 = VIZ_TRUTH_VERIFIED;
    if (count > PVV_RECORD_COUNT) {
        count = PVV_RECORD_COUNT;
    }
    if (count == 0) {
        truth = VIZ_TRUTH_UNKNOWN;
    }
    var p : PvvState = pvv_apply(pvv_idle(), VIZ_EV_LOAD, 0, 0);
    p = pvv_apply(p, VIZ_EV_LOADED, count, truth as u32);
    return p;
}

/// A petal ready to explore: all seven records, truth VERIFIED, five steps, eight what-ifs.
pub fn pvv_open() -> PvvState {
    return pvv_open_n(PVV_RECORD_COUNT);
}

; ---------------------------------------------------------------- L2 entities

/// Record i as an entity: viz_ref(NODE, i).
pub fn pvv_record_ref(i: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, i);
}

/// The record a ref names when it is a node below `rows`, else PVV_NO_RECORD.
pub fn pvv_record_at(r: u32, rows: u32) -> u32 {
    if (viz_ref_kind(r) == VIZ_ENT_NODE and viz_ref_index(r) < rows) {
        return viz_ref_index(r);
    }
    return PVV_NO_RECORD;
}

/// The records the views show: all loaded ones while READY, none while loading, empty or failed.
pub fn pvv_rows(p: PvvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return 0;
    }
    if (p.viz.item_count > PVV_RECORD_COUNT) {
        return PVV_RECORD_COUNT;
    }
    return p.viz.item_count;
}

/// The entity of focus index f: records 0..6. VIZ_REF_NONE past the end.
pub fn pvv_focus_ref(p: PvvState, f: u32) -> u32 {
    if (f >= p.viz.focus_count or f >= PVV_RECORD_COUNT) {
        return VIZ_REF_NONE;
    }
    return pvv_record_ref(f);
}

/// ACTIVATE on the focused item: the same as clicking it. Nothing focused is a no-op.
pub fn pvv_activate(p: PvvState) -> PvvState {
    let r : u32 = pvv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    return pvv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// The record the trace and the inspector describe: the hovered record if there is one, else the
/// selected one, else PVV_NO_RECORD.
pub fn pvv_subject(p: PvvState) -> u32 {
    let rows : u32 = pvv_rows(p);
    let h : u32 = pvv_record_at(p.viz.hover, rows);
    if (h != PVV_NO_RECORD) {
        return h;
    }
    return pvv_record_at(p.viz.selected, rows);
}

; ---------------------------------------------------------------- L6 views: list

/// The list line of record i: its verdict under the current what-if; PVV_NO_VERDICT past the rows.
pub fn pvv_list_verdict(p: PvvState, i: u32) -> u8 {
    if (i >= pvv_rows(p)) {
        return PVV_NO_VERDICT;
    }
    return pvv_verdict_of(pvv_record_under(i, p.viz.param));
}

/// How the list draws record i: the contract's one highlight rule; none past the rows.
pub fn pvv_list_hl(p: PvvState, i: u32) -> u8 {
    if (i >= pvv_rows(p)) {
        return VIZ_HL_NONE;
    }
    return viz_highlight(p.viz, pvv_record_ref(i));
}

/// The inverse of the list layout: the record under a pixel (frame coordinates), else VIZ_REF_NONE.
pub fn pvv_list_hit(p: PvvState, px: u32, py: u32) -> u32 {
    if (px < PVV_LIST_X or px >= PVV_LIST_X + PVV_LIST_W or py < PVV_LIST_Y) {
        return VIZ_REF_NONE;
    }
    let i : u32 = (py - PVV_LIST_Y) / PVV_LINE_H;
    if (i >= pvv_rows(p)) {
        return VIZ_REF_NONE;
    }
    return pvv_record_ref(i);
}

; ---------------------------------------------------------------- L6 views: trace

/// How many trace rows are revealed: none without a subject, else the steps up to the current one.
pub fn pvv_trace_shown(p: PvvState) -> u32 {
    if (pvv_subject(p) == PVV_NO_RECORD) {
        return 0;
    }
    return viz_clamp(p.viz.step, PVV_STEPS) + 1;
}

/// Trace row k of the subject under the current what-if; PVV_NO_VERDICT while the row is hidden
/// (past the current step) or there is no subject.
pub fn pvv_trace_value(p: PvvState, k: u32) -> u8 {
    let s : u32 = pvv_subject(p);
    if (s == PVV_NO_RECORD or k >= pvv_trace_shown(p)) {
        return PVV_NO_VERDICT;
    }
    return pvv_probe(pvv_record_under(s, p.viz.param), k);
}

; ---------------------------------------------------------------- L6 views: inspector

/// The verdict of the subject under the current what-if; PVV_NO_VERDICT without a subject.
pub fn pvv_inspect_verdict(p: PvvState) -> u8 {
    let s : u32 = pvv_subject(p);
    if (s == PVV_NO_RECORD) {
        return PVV_NO_VERDICT;
    }
    return pvv_verdict_of(pvv_record_under(s, p.viz.param));
}

/// The rule that gave the subject's verdict; PVV_NO_RULE without a subject.
pub fn pvv_inspect_rule(p: PvvState) -> u32 {
    let s : u32 = pvv_subject(p);
    if (s == PVV_NO_RECORD) {
        return PVV_NO_RULE;
    }
    return pvv_rule(pvv_record_under(s, p.viz.param));
}

/// The evidence-chain code of the subject under the current what-if; PVV_NO_VERDICT without one.
pub fn pvv_inspect_chain(p: PvvState) -> u8 {
    let s : u32 = pvv_subject(p);
    if (s == PVV_NO_RECORD) {
        return PVV_NO_VERDICT;
    }
    return pvv_chain_of(pvv_record_under(s, p.viz.param));
}

/// Whether the subject's hardware field is honest; false without a subject.
pub fn pvv_inspect_hw_honest(p: PvvState) -> bool {
    let s : u32 = pvv_subject(p);
    if (s == PVV_NO_RECORD) {
        return false;
    }
    return pvv_hw_honest(pvv_record_under(s, p.viz.param));
}

; ---------------------------------------------------------------- L7 truth: the badge

/// The truth the badge shows: the state's truth, an unknown code read as UNKNOWN.
pub fn pvv_badge(p: PvvState) -> u8 {
    return viz_truth(p.viz.truth);
}

/// The badge colour, 0xRRGGBB, from the contract's table.
pub fn pvv_badge_rgb(p: PvvState) -> u32 {
    return viz_truth_rgb(pvv_badge(p));
}

/// Whether the petal may present its numbers as a result: true only for LIVE or VERIFIED.
pub fn pvv_badge_claims(p: PvvState) -> bool {
    return viz_may_claim(pvv_badge(p));
}

; ---------------------------------------------------------------- L8 host

/// The layout: the badge, then the list, the trace and the inspector, all root slots (the petal is
/// not wrapped in a frame, so it embeds under any slot of another host). Frame coordinates.
pub fn pvv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PVV_BADGE_X, PVV_BADGE_Y, PVV_BADGE_W, PVV_BADGE_H);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, PVV_LIST_X, PVV_LIST_Y, PVV_LIST_W, PVV_RECORD_COUNT * PVV_LINE_H);
    h = vh_add(h, VIZ_REP_TRACE, VH_ROOT, PVV_TRACE_X, PVV_TRACE_Y, PVV_TRACE_W, PVV_STEPS * PVV_LINE_H);
    h = vh_add(h, VIZ_REP_INSPECTOR, VH_ROOT, PVV_INSPECT_X, PVV_INSPECT_Y, PVV_INSPECT_W, PVV_INSPECT_H);
    return h;
}

/// The reps of the petal: list, trace, inspector and the truth badge. The plan's row 21 holds 308.
pub fn pvv_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_LIST) | viz_rep_bit(VIZ_REP_TRACE) | viz_rep_bit(VIZ_REP_INSPECTOR) | viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// The petal's reducer and the contract's agree on the event, and the event changed the state.
fn pvv_t_routes(p: PvvState, ev: u8, a: u32, b: u32) -> bool {
    let mine : PvvState = pvv_apply(p, ev, a, b);
    let theirs : VizState = viz_apply(p.viz, ev, a, b);
    return viz_same(mine.viz, theirs) and mine.viz.revision == theirs.revision and viz_same(mine.viz, p.viz) == false;
}

/// An open petal with what-if k switched on, through the reducer.
fn pvv_t_param(k: u32) -> PvvState {
    return pvv_apply(pvv_open(), VIZ_EV_PARAM_SET, k, 0);
}

/// Record i selected in p, through the reducer.
fn pvv_t_select(p: PvvState, i: u32) -> PvvState {
    return pvv_apply(p, VIZ_EV_SELECT, pvv_record_ref(i), 0);
}

/// Reload p: LOAD, then LOADED with n items and the truth t.
fn pvv_t_reload(p: PvvState, n: u32, t: u8) -> PvvState {
    let loading : PvvState = pvv_apply(p, VIZ_EV_LOAD, 0, 0);
    return pvv_apply(loading, VIZ_EV_LOADED, n, t as u32);
}

; ---------------------------------------------------------------- tests: state (one VizState, one reducer)

test a_fresh_petal_is_idle_and_unknown {
    let p : PvvState = pvv_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert p.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert p.base == VIZ_TRUTH_UNKNOWN;
    assert p.viz.revision == 0;
    assert p.viz.step_count == PVV_STEPS;
    assert p.viz.param_count == PVV_WHATIFS;
    assert pvv_rows(p) == 0;
    assert pvv_badge_claims(p) == false;
    assert pvv_truth_holds(p);
}

test open_loads_the_seven_records_with_the_truth_verified {
    let p : PvvState = pvv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == 7;
    assert p.viz.focus_count == 7;
    assert pvv_rows(p) == PVV_RECORD_COUNT;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.base == VIZ_TRUTH_VERIFIED;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.viz.step == 0;
    assert p.viz.param == 0;
    assert p.viz.revision == 2;
    assert pvv_truth_holds(p);
}

test every_event_goes_through_the_one_reducer {
    let p : PvvState = pvv_open();
    assert pvv_t_routes(p, VIZ_EV_HOVER, pvv_record_ref(2), 0);
    assert pvv_t_routes(p, VIZ_EV_SELECT, pvv_record_ref(3), 0);
    assert pvv_t_routes(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert pvv_t_routes(p, VIZ_EV_STEP_SET, 3, 0);
    assert pvv_t_routes(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert pvv_t_routes(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert pvv_t_routes(p, VIZ_EV_MOTION, 1, 0);
    // The what-if event: the contract's parameter and revision, plus the recomputed truth.
    let q : PvvState = pvv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    let r : VizState = viz_apply(p.viz, VIZ_EV_PARAM_SET, 5, 0);
    assert q.viz.param == r.param;
    assert q.viz.revision == r.revision;
    assert q.viz.revision == p.viz.revision + 1;
    assert r.truth == VIZ_TRUTH_VERIFIED;
    assert q.viz.truth == VIZ_TRUTH_DEMO;
}

test hover_select_back_and_clear_edit_the_one_state {
    var p : PvvState = pvv_open();
    p = pvv_apply(p, VIZ_EV_HOVER, pvv_record_ref(2), 0);
    assert p.viz.hover == pvv_record_ref(2);
    p = pvv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert p.viz.hover == VIZ_REF_NONE;
    p = pvv_t_select(p, 4);
    assert p.viz.selected == pvv_record_ref(4);
    assert viz_back_closes(p.viz) == false;
    // Selecting the selected record clears it; selecting another switches.
    p = pvv_t_select(p, 4);
    assert p.viz.selected == VIZ_REF_NONE;
    p = pvv_t_select(p, 4);
    p = pvv_t_select(p, 5);
    assert p.viz.selected == pvv_record_ref(5);
    p = pvv_apply(p, VIZ_EV_BACK, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    assert viz_back_closes(p.viz);
    p = pvv_t_select(p, 1);
    p = pvv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
}

test step_and_param_are_clamped_to_their_ranges {
    var p : PvvState = pvv_open();
    p = pvv_apply(p, VIZ_EV_STEP_SET, 99, 0);
    assert p.viz.step == 4;
    let r : u32 = p.viz.revision;
    p = pvv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert p.viz.step == 4;
    assert p.viz.revision == r;
    p = pvv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 3;
    p = pvv_apply(p, VIZ_EV_STEP_SET, 0, 0);
    p = pvv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 0;
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 99, 0);
    assert p.viz.param == 7;
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert p.viz.param == 5;
}

; ---------------------------------------------------------------- tests: entities and lifecycle edges

test a_record_is_a_node_ref_and_an_out_of_range_ref_names_no_record {
    assert pvv_record_ref(3) == viz_ref(VIZ_ENT_NODE, 3);
    assert pvv_record_ref(3) == 65539;
    assert viz_ref_kind(pvv_record_ref(3)) == VIZ_ENT_NODE;
    assert viz_ref_index(pvv_record_ref(3)) == 3;
    assert pvv_record_at(pvv_record_ref(3), 7) == 3;
    assert pvv_record_at(pvv_record_ref(3), 3) == PVV_NO_RECORD;
    assert pvv_record_at(pvv_record_ref(7), 7) == PVV_NO_RECORD;
    assert pvv_record_at(pvv_record_ref(9), 7) == PVV_NO_RECORD;
    assert pvv_record_at(viz_ref(VIZ_ENT_EDGE, 3), 7) == PVV_NO_RECORD;
    assert pvv_record_at(viz_ref(VIZ_ENT_CELL, 3), 7) == PVV_NO_RECORD;
    assert pvv_record_at(VIZ_REF_NONE, 7) == PVV_NO_RECORD;
    // A hovered or selected ref outside the seven names no subject, so no view shows anything for it.
    var p : PvvState = pvv_apply(pvv_open(), VIZ_EV_HOVER, pvv_record_ref(9), 0);
    p = pvv_t_select(p, 7);
    assert p.viz.hover == pvv_record_ref(9);
    assert pvv_subject(p) == PVV_NO_RECORD;
    assert pvv_inspect_verdict(p) == PVV_NO_VERDICT;
    assert pvv_inspect_chain(p) == PVV_NO_VERDICT;
    assert pvv_inspect_rule(p) == PVV_NO_RULE;
    assert pvv_inspect_hw_honest(p) == false;
    assert pvv_trace_shown(p) == 0;
    assert pvv_trace_value(p, 0) == PVV_NO_VERDICT;
    assert pvv_list_verdict(p, 7) == PVV_NO_VERDICT;
    assert pvv_list_hl(p, 9) == VIZ_HL_NONE;
    assert pvv_list_hl(p, 6) == VIZ_HL_NONE;
    assert pvv_focus_ref(p, 6) == pvv_record_ref(6);
    assert pvv_focus_ref(p, 7) == VIZ_REF_NONE;
    // The blank record stands in for a row past the fixture and names no reference at all.
    assert pvv_chain_of(pvv_record(9)) == NO_CHANGE;
    assert pvv_verdict_of(pvv_record(9)) == INVALID_NO_RUN;
}

test loading_ignores_interaction_and_shows_no_rows {
    let ready : PvvState = pvv_open();
    let p : PvvState = pvv_apply(ready, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert pvv_rows(p) == 0;
    assert viz_same(pvv_apply(p, VIZ_EV_HOVER, pvv_record_ref(2), 0).viz, p.viz);
    assert viz_same(pvv_apply(p, VIZ_EV_SELECT, pvv_record_ref(2), 0).viz, p.viz);
    assert viz_same(pvv_apply(p, VIZ_EV_STEP_NEXT, 0, 0).viz, p.viz);
    assert viz_same(pvv_apply(p, VIZ_EV_PARAM_SET, 3, 0).viz, p.viz);
    assert pvv_list_verdict(p, 0) == PVV_NO_VERDICT;
    assert pvv_list_hl(p, 0) == VIZ_HL_NONE;
    assert pvv_list_hit(p, 30, 70) == VIZ_REF_NONE;
    assert pvv_subject(p) == PVV_NO_RECORD;
    assert pvv_trace_value(p, 0) == PVV_NO_VERDICT;
    assert pvv_inspect_verdict(p) == PVV_NO_VERDICT;
    // The load finishing brings the rows back, with the selection and hover cleared.
    let done : PvvState = pvv_apply(p, VIZ_EV_LOADED, 7, VIZ_TRUTH_VERIFIED as u32);
    assert done.viz.lifecycle == VIZ_LC_READY;
    assert pvv_rows(done) == 7;
    assert pvv_list_verdict(done, 0) == PASS;
}

test an_empty_fixture_is_empty_and_every_view_says_nothing {
    let e : PvvState = pvv_open_n(0);
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert e.viz.focus_count == 0;
    assert e.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert pvv_badge_claims(e) == false;
    assert pvv_rows(e) == 0;
    assert pvv_list_verdict(e, 0) == PVV_NO_VERDICT;
    assert pvv_list_hit(e, 30, 70) == VIZ_REF_NONE;
    assert pvv_trace_shown(e) == 0;
    assert viz_same(pvv_apply(e, VIZ_EV_HOVER, pvv_record_ref(0), 0).viz, e.viz);
    assert viz_same(pvv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz, e.viz);
    assert pvv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz.focus == VIZ_NO_FOCUS;
    // More records than the fixture holds are clamped; fewer shorten every view and the focus ring.
    assert pvv_open_n(99).viz.item_count == 7;
    var p : PvvState = pvv_open_n(3);
    assert pvv_rows(p) == 3;
    assert pvv_list_verdict(p, 2) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(p, 3) == PVV_NO_VERDICT;
    assert pvv_list_hit(p, 30, 60 + 3 * 22) == VIZ_REF_NONE;
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 2;
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
}

test a_failed_load_is_an_error_and_retry_loads_again {
    var p : PvvState = pvv_apply(pvv_open(), VIZ_EV_FAILED, 5, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 5;
    assert pvv_rows(p) == 0;
    assert pvv_list_verdict(p, 0) == PVV_NO_VERDICT;
    assert pvv_inspect_verdict(p) == PVV_NO_VERDICT;
    assert viz_same(pvv_apply(p, VIZ_EV_SELECT, pvv_record_ref(1), 0).viz, p.viz);
    p = pvv_apply(p, VIZ_EV_RETRY, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert p.viz.error == 0;
    p = pvv_apply(p, VIZ_EV_LOADED, 7, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert pvv_rows(p) == 7;
    assert pvv_list_verdict(p, 1) == INVALID_NO_RUN;
}

; ---------------------------------------------------------------- tests: entities are the source's calls

test the_fixture_verdicts_are_the_sources_verdicts {
    assert pvv_verdict_of(pvv_record(0)) == PASS;
    assert pvv_verdict_of(pvv_record(1)) == INVALID_NO_RUN;
    assert pvv_verdict_of(pvv_record(2)) == INVALID_NO_ARTIFACT;
    assert pvv_verdict_of(pvv_record(3)) == INVALID_NO_EVIDENCE;
    assert pvv_verdict_of(pvv_record(4)) == FAIL;
    assert pvv_verdict_of(pvv_record(5)) == FAIL;
    assert pvv_verdict_of(pvv_record(6)) == PASS;
    // The same answers, pinned as the literal codes the source documents.
    assert pvv_verdict_of(pvv_record(0)) == 0;
    assert pvv_verdict_of(pvv_record(1)) == 2;
    assert pvv_verdict_of(pvv_record(2)) == 3;
    assert pvv_verdict_of(pvv_record(3)) == 4;
    assert pvv_verdict_of(pvv_record(4)) == 1;
    // And equal to a direct call of the source with the same facts.
    assert pvv_verdict_of(pvv_record(0)) == record_status(true, true, true, LINKED);
    assert pvv_verdict_of(pvv_record(1)) == record_status(false, false, false, RUN_UNBOUND);
    assert pvv_verdict_of(pvv_record(3)) == record_status(true, true, false, EVIDENCE_UNBOUND);
    assert pvv_verdict_of(pvv_record(4)) == record_status(true, true, true, RUN_OTHER_CHANGE);
    assert pvv_verdict_of(pvv_record(5)) == record_status(true, true, true, NO_TESTS);
    // The list view shows the same verdicts.
    let p : PvvState = pvv_open();
    assert pvv_list_verdict(p, 0) == PASS;
    assert pvv_list_verdict(p, 1) == INVALID_NO_RUN;
    assert pvv_list_verdict(p, 2) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(p, 3) == INVALID_NO_EVIDENCE;
    assert pvv_list_verdict(p, 4) == FAIL;
    assert pvv_list_verdict(p, 5) == FAIL;
    assert pvv_list_verdict(p, 6) == PASS;
}

test the_fixture_chains_are_the_sources_first_broken_link {
    assert pvv_chain_of(pvv_record(0)) == LINKED;
    assert pvv_chain_of(pvv_record(1)) == RUN_UNBOUND;
    assert pvv_chain_of(pvv_record(2)) == SEAL_NOT_VERIFIED;
    assert pvv_chain_of(pvv_record(3)) == EVIDENCE_UNBOUND;
    assert pvv_chain_of(pvv_record(4)) == RUN_OTHER_CHANGE;
    assert pvv_chain_of(pvv_record(5)) == NO_TESTS;
    assert pvv_chain_of(pvv_record(6)) == LINKED;
    // The whole record is the source's own whole chain, the one its tests pin.
    assert pvv_chain_of(pvv_whole()) == chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, SEAL_MATCH);
    assert chain(0xaaaa, 0xaaaa, 7, 7, true, true, true, SEAL_MATCH) == LINKED;
    assert pvv_chain_of(pvv_blank()) == NO_CHANGE;
}

; ---------------------------------------------------------------- tests: which rule gave the verdict

test references_are_judged_before_the_chain {
    // Record 2 has no artifact AND a broken seal: the source names the missing reference.
    let r2 : PvvRecord = pvv_record(2);
    assert pvv_chain_of(r2) == SEAL_NOT_VERIFIED;
    assert pvv_verdict_of(r2) == INVALID_NO_ARTIFACT;
    assert pvv_verdict_of(r2) == record_status(true, false, true, SEAL_NOT_VERIFIED);
    // Record 1 names nothing: the first reference in the fixed order is the one reported.
    let r1 : PvvRecord = pvv_record(1);
    assert r1.has_run == false;
    assert r1.has_artifact == false;
    assert r1.has_evidence == false;
    assert pvv_verdict_of(r1) == INVALID_NO_RUN;
    assert pvv_verdict_of(r1) == pvv_probe(r1, 0);
    assert record_status(true, false, false, RUN_UNBOUND) == INVALID_NO_ARTIFACT;
    assert record_status(true, true, false, RUN_UNBOUND) == INVALID_NO_EVIDENCE;
    // The chain alone is a different answer for the same record: FAIL, not INVALID.
    assert pvv_probe(r1, 3) == FAIL;
    assert pvv_probe(r1, 3) != pvv_verdict_of(r1);
}

test each_probe_isolates_one_rule {
    let whole : PvvRecord = pvv_record(0);
    var k : u32 = 0;
    while (k < 5) {
        assert pvv_probe(whole, k) == PASS;
        k = k + 1;
    }
    let none : PvvRecord = pvv_record(1);
    assert pvv_probe(none, 0) == INVALID_NO_RUN;
    assert pvv_probe(none, 1) == INVALID_NO_ARTIFACT;
    assert pvv_probe(none, 2) == INVALID_NO_EVIDENCE;
    assert pvv_probe(none, 3) == FAIL;
    assert pvv_probe(none, 4) == INVALID_NO_RUN;
    let other : PvvRecord = pvv_record(4);
    assert pvv_probe(other, 0) == PASS;
    assert pvv_probe(other, 1) == PASS;
    assert pvv_probe(other, 2) == PASS;
    assert pvv_probe(other, 3) == FAIL;
    assert pvv_probe(other, 4) == FAIL;
    // Past the last row there is no probe: not a verdict.
    assert pvv_probe(whole, 5) == PVV_NO_VERDICT;
    assert pvv_probe(none, 99) == PVV_NO_VERDICT;
    // The chain probe is the source's run_verdict of the chain code.
    assert pvv_probe(other, 3) == run_verdict(RUN_OTHER_CHANGE);
    assert pvv_probe(whole, 3) == run_verdict(LINKED);
}

test the_rule_is_the_first_one_that_fires {
    assert pvv_rule(pvv_record(0)) == PVV_RULE_NONE;
    assert pvv_rule(pvv_record(1)) == 0;
    assert pvv_rule(pvv_record(2)) == 1;
    assert pvv_rule(pvv_record(3)) == 2;
    assert pvv_rule(pvv_record(4)) == 3;
    assert pvv_rule(pvv_record(5)) == 3;
    assert pvv_rule(pvv_record(6)) == PVV_RULE_NONE;
    assert PVV_RULE_NONE == 4;
}

test the_verdict_is_what_the_first_firing_rule_says {
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        var k : u32 = 0;
        while (k < PVV_WHATIFS) {
            let r : PvvRecord = pvv_record_under(i, k);
            let rule : u32 = pvv_rule(r);
            let v : u8 = pvv_verdict_of(r);
            assert v == pvv_probe(r, 4);
            if (rule < PVV_RULE_NONE) {
                assert v == pvv_probe(r, rule);
                assert v != PASS;
            } else {
                assert v == PASS;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    // The loop saw both sides: a record that passes and a record that a rule stops.
    assert pvv_rule(pvv_record_under(0, 0)) == PVV_RULE_NONE;
    assert pvv_rule(pvv_record_under(0, 3)) == 2;
}

test pass_never_upgrades_hardware {
    let honest : PvvRecord = pvv_record(0);
    let lie : PvvRecord = pvv_record(6);
    assert pvv_verdict_of(honest) == PASS;
    assert pvv_verdict_of(lie) == PASS;
    assert honest.reported_hw == HW_UNPROVEN;
    assert lie.reported_hw == HW_VERIFIED;
    assert lie.evidence_hw == HW_UNPROVEN;
    assert pvv_hw_honest(honest);
    assert pvv_hw_honest(lie) == false;
    assert hw_field_honest(lie.reported_hw, lie.evidence_hw) == false;
    // The software verdict is the same PASS whatever the hardware field says.
    assert pvv_verdict_of(honest) == pvv_verdict_of(lie);
    assert run_verdict(pvv_chain_of(lie)) == PASS;
}

; ---------------------------------------------------------------- tests: one input change, recomputed

test dropping_the_evidence_reference_recomputes_every_verdict {
    let before : PvvState = pvv_open();
    let p : PvvState = pvv_t_param(3);
    assert p.viz.param == 3;
    assert p.viz.revision == before.viz.revision + 1;
    // Before: the record that passes. After: it names no evidence, and the source says so.
    assert pvv_list_verdict(before, 0) == PASS;
    assert pvv_list_verdict(p, 0) == INVALID_NO_EVIDENCE;
    assert pvv_list_verdict(before, 4) == FAIL;
    assert pvv_list_verdict(p, 4) == INVALID_NO_EVIDENCE;
    // Every row equals a direct call of the source with the facts that row has under the change.
    assert pvv_list_verdict(p, 0) == record_status(true, true, false, LINKED);
    assert pvv_list_verdict(p, 1) == record_status(false, false, false, RUN_UNBOUND);
    assert pvv_list_verdict(p, 2) == record_status(true, false, false, SEAL_NOT_VERIFIED);
    assert pvv_list_verdict(p, 3) == record_status(true, true, false, EVIDENCE_UNBOUND);
    assert pvv_list_verdict(p, 4) == record_status(true, true, false, RUN_OTHER_CHANGE);
    assert pvv_list_verdict(p, 5) == record_status(true, true, false, NO_TESTS);
    assert pvv_list_verdict(p, 6) == record_status(true, true, false, LINKED);
    // The pinned codes: earlier references still win (no run stays 2, no artifact stays 3).
    assert pvv_list_verdict(p, 0) == 4;
    assert pvv_list_verdict(p, 1) == 2;
    assert pvv_list_verdict(p, 2) == 3;
    assert pvv_list_verdict(p, 6) == 4;
}

test dropping_the_run_or_the_artifact_keeps_the_rule_order {
    let no_run : PvvState = pvv_t_param(1);
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        assert pvv_list_verdict(no_run, i) == INVALID_NO_RUN;
        i = i + 1;
    }
    let no_art : PvvState = pvv_t_param(2);
    assert pvv_list_verdict(no_art, 0) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 1) == INVALID_NO_RUN;
    assert pvv_list_verdict(no_art, 2) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 3) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 4) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 5) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 6) == INVALID_NO_ARTIFACT;
    assert pvv_list_verdict(no_art, 1) == record_status(false, false, false, RUN_UNBOUND);
    assert pvv_list_verdict(no_art, 6) == record_status(true, false, true, LINKED);
}

test three_chain_breaks_give_three_codes_and_one_verdict {
    // The same whole record broken three different ways: the chain names three links, the verdict
    // is one FAIL, and the other records keep their references first.
    assert pvv_chain_of(pvv_record_under(0, 4)) == RUN_OTHER_CHANGE;
    assert pvv_chain_of(pvv_record_under(0, 5)) == NO_TESTS;
    assert pvv_chain_of(pvv_record_under(0, 6)) == SEAL_NOT_VERIFIED;
    var k : u32 = 4;
    while (k < 7) {
        let p : PvvState = pvv_t_param(k);
        assert pvv_list_verdict(p, 0) == FAIL;
        assert pvv_list_verdict(p, 1) == INVALID_NO_RUN;
        assert pvv_list_verdict(p, 2) == INVALID_NO_ARTIFACT;
        assert pvv_list_verdict(p, 3) == INVALID_NO_EVIDENCE;
        assert pvv_list_verdict(p, 4) == FAIL;
        assert pvv_list_verdict(p, 5) == FAIL;
        assert pvv_list_verdict(p, 6) == FAIL;
        // The inspector names the chain link and the rule for the whole record.
        let s : PvvState = pvv_t_select(p, 0);
        assert pvv_inspect_verdict(s) == FAIL;
        assert pvv_inspect_rule(s) == 3;
        assert pvv_inspect_chain(s) == pvv_chain_of(pvv_record_under(0, k));
        k = k + 1;
    }
}

test a_hardware_what_if_changes_honesty_and_no_verdict {
    let open : PvvState = pvv_open();
    let p : PvvState = pvv_t_param(7);
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        // Not one verdict moves ...
        assert pvv_list_verdict(p, i) == pvv_list_verdict(open, i);
        // ... and the hardware field of every record now reports VERIFIED against UNPROVEN evidence.
        assert pvv_inspect_hw_honest(pvv_t_select(p, i)) == false;
        i = i + 1;
    }
    assert pvv_inspect_hw_honest(pvv_t_select(open, 0));
    assert pvv_inspect_hw_honest(pvv_t_select(open, 4));
    assert pvv_inspect_hw_honest(pvv_t_select(open, 6)) == false;
    assert pvv_badge(p) == VIZ_TRUTH_DEMO;
}

; ---------------------------------------------------------------- tests: truth

test an_untouched_petal_is_verified_and_the_badge_may_claim {
    let p : PvvState = pvv_open();
    assert pvv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert pvv_badge_claims(p);
    assert pvv_badge_rgb(p) == viz_truth_rgb(VIZ_TRUTH_VERIFIED);
    assert pvv_badge_rgb(p) != viz_truth_rgb(VIZ_TRUTH_DEMO);
    // Looking is not leaving the data: hover, select, step and focus keep the claim.
    var q : PvvState = pvv_apply(p, VIZ_EV_HOVER, pvv_record_ref(1), 0);
    q = pvv_t_select(q, 4);
    q = pvv_apply(q, VIZ_EV_STEP_SET, 4, 0);
    q = pvv_apply(q, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert pvv_badge_claims(q);
    assert pvv_truth_holds(q);
    // An unknown truth code reads as UNKNOWN, never as a claim.
    var u : PvvState = p;
    u.viz.truth = 77;
    assert pvv_badge(u) == VIZ_TRUTH_UNKNOWN;
    assert pvv_badge_claims(u) == false;
}

test leaving_the_data_shows_demo_and_returning_restores_the_claim {
    let open : PvvState = pvv_open();
    var p : PvvState = pvv_apply(open, VIZ_EV_PARAM_SET, 3, 0);
    assert pvv_badge(p) == VIZ_TRUTH_DEMO;
    assert pvv_badge_claims(p) == false;
    assert p.base == VIZ_TRUTH_VERIFIED;
    assert pvv_truth_holds(p);
    // Another what-if is still a demo.
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert pvv_badge(p) == VIZ_TRUTH_DEMO;
    assert p.viz.revision == open.viz.revision + 2;
    // A reload that finishes while a what-if is on keeps the DEMO label.
    let again : PvvState = pvv_t_reload(p, 7, VIZ_TRUTH_VERIFIED);
    assert again.viz.lifecycle == VIZ_LC_READY;
    assert again.viz.param == 5;
    assert again.base == VIZ_TRUTH_VERIFIED;
    assert pvv_badge(again) == VIZ_TRUTH_DEMO;
    // Back to the data: VERIFIED again, and the state is the opened one.
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert pvv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert pvv_badge_claims(p);
    assert viz_same(p.viz, open.viz);
    assert p.viz.revision == open.viz.revision + 3;
}

test a_reload_keeps_cached_and_unknown_and_follows_live {
    var p : PvvState = pvv_t_reload(pvv_open(), 7, VIZ_TRUTH_CACHED);
    assert pvv_badge(p) == VIZ_TRUTH_CACHED;
    assert p.base == VIZ_TRUTH_CACHED;
    assert pvv_badge_claims(p) == false;
    // A what-if on cached data stays cached: it never claimed a result to begin with.
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 3, 0);
    assert pvv_badge(p) == VIZ_TRUTH_CACHED;
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert pvv_badge(p) == VIZ_TRUTH_CACHED;
    // A host that feeds real records reports LIVE; the what-if still turns it into a demo.
    p = pvv_t_reload(p, 7, VIZ_TRUTH_LIVE);
    assert pvv_badge(p) == VIZ_TRUTH_LIVE;
    assert pvv_badge_claims(p);
    p = pvv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert pvv_badge(p) == VIZ_TRUTH_DEMO;
    // A truth code outside the table reloads as UNKNOWN and never claims.
    let odd : PvvState = pvv_t_reload(pvv_open(), 7, 77);
    assert pvv_badge(odd) == VIZ_TRUTH_UNKNOWN;
    assert odd.base == VIZ_TRUTH_UNKNOWN;
    assert pvv_badge_claims(odd) == false;
    assert pvv_truth_holds(odd);
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_every_record_forward_and_back_and_wraps {
    var p : PvvState = pvv_open();
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == i;
        assert viz_is_focused(p.viz, i);
        assert pvv_focus_ref(p, p.viz.focus) == pvv_record_ref(i);
        i = i + 1;
    }
    // The eighth press wraps to the first record.
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    // Backward from nothing focused starts at the last record, walks down and wraps.
    var q : PvvState = pvv_open();
    var j : u32 = PVV_RECORD_COUNT;
    while (j > 0) {
        q = pvv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
        j = j - 1;
        assert q.viz.focus == j;
        assert pvv_focus_ref(q, q.viz.focus) == pvv_record_ref(j);
    }
    q = pvv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == 6;
}

test activate_selects_the_focused_record_and_activating_again_clears_it {
    var p : PvvState = pvv_open();
    // Nothing focused: activate is a no-op.
    assert viz_same(pvv_activate(p).viz, p.viz);
    assert pvv_activate(p).viz.revision == p.viz.revision;
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pvv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pvv_activate(p);
    assert p.viz.selected == pvv_record_ref(2);
    assert pvv_subject(p) == 2;
    assert pvv_inspect_verdict(p) == INVALID_NO_ARTIFACT;
    p = pvv_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    assert pvv_subject(p) == PVV_NO_RECORD;
}

test reduced_motion_gives_zero_milliseconds {
    var p : PvvState = pvv_open();
    assert viz_motion_ms(p.viz, 250) == 250;
    p = pvv_apply(p, VIZ_EV_MOTION, 1, 0);
    assert p.viz.reduced_motion == 1;
    assert viz_motion_ms(p.viz, 250) == 0;
    assert viz_motion_ms(p.viz, 0) == 0;
    p = pvv_apply(p, VIZ_EV_MOTION, 0, 0);
    assert viz_motion_ms(p.viz, 250) == 250;
    // The preference is not an interaction: it is honoured before the petal has loaded.
    let idle : PvvState = pvv_apply(pvv_idle(), VIZ_EV_MOTION, 1, 0);
    assert idle.viz.reduced_motion == 1;
    assert viz_motion_ms(idle.viz, 250) == 0;
}

; ---------------------------------------------------------------- tests: views against views

test the_views_read_one_state_and_agree {
    var p : PvvState = pvv_t_select(pvv_open(), 4);
    p = pvv_apply(p, VIZ_EV_STEP_SET, 4, 0);
    // One selection lights one list line, and every view describes that record.
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        if (i == 4) {
            assert pvv_list_hl(p, i) == VIZ_HL_SELECT;
        } else {
            assert pvv_list_hl(p, i) == VIZ_HL_NONE;
        }
        i = i + 1;
    }
    assert pvv_subject(p) == 4;
    assert pvv_inspect_verdict(p) == pvv_list_verdict(p, 4);
    assert pvv_trace_value(p, 4) == pvv_list_verdict(p, 4);
    assert pvv_list_verdict(p, 4) == FAIL;
    // Hover another record: it takes the inspector and the trace, the selection keeps its line.
    p = pvv_apply(p, VIZ_EV_HOVER, pvv_record_ref(2), 0);
    assert pvv_subject(p) == 2;
    assert pvv_list_hl(p, 2) == VIZ_HL_HOVER;
    assert pvv_list_hl(p, 4) == VIZ_HL_SELECT;
    assert pvv_inspect_verdict(p) == pvv_list_verdict(p, 2);
    assert pvv_trace_value(p, 4) == pvv_list_verdict(p, 2);
    assert pvv_inspect_verdict(p) == INVALID_NO_ARTIFACT;
    assert pvv_inspect_rule(p) == 1;
    // Leave: the selected record is the subject again. Back: nothing is.
    p = pvv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert pvv_subject(p) == 4;
    assert pvv_inspect_verdict(p) == FAIL;
    p = pvv_apply(p, VIZ_EV_BACK, 0, 0);
    assert pvv_subject(p) == PVV_NO_RECORD;
    assert pvv_list_hl(p, 4) == VIZ_HL_NONE;
    assert pvv_inspect_verdict(p) == PVV_NO_VERDICT;
}

test the_trace_reveals_steps_up_to_the_current_step {
    // No subject: nothing revealed.
    var p : PvvState = pvv_open();
    assert pvv_trace_shown(p) == 0;
    assert pvv_trace_value(p, 0) == PVV_NO_VERDICT;
    // Record 1 selected at step 0: only the first rule is shown.
    p = pvv_t_select(p, 1);
    assert pvv_trace_shown(p) == 1;
    assert pvv_trace_value(p, 0) == INVALID_NO_RUN;
    assert pvv_trace_value(p, 1) == PVV_NO_VERDICT;
    p = pvv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert pvv_trace_shown(p) == 2;
    assert pvv_trace_value(p, 1) == INVALID_NO_ARTIFACT;
    assert pvv_trace_value(p, 2) == PVV_NO_VERDICT;
    p = pvv_apply(p, VIZ_EV_STEP_SET, 4, 0);
    assert pvv_trace_shown(p) == 5;
    assert pvv_trace_value(p, 0) == INVALID_NO_RUN;
    assert pvv_trace_value(p, 1) == INVALID_NO_ARTIFACT;
    assert pvv_trace_value(p, 2) == INVALID_NO_EVIDENCE;
    assert pvv_trace_value(p, 3) == FAIL;
    assert pvv_trace_value(p, 4) == INVALID_NO_RUN;
    assert pvv_trace_value(p, 5) == PVV_NO_VERDICT;
    // Stepping back hides the last row again.
    p = pvv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert pvv_trace_shown(p) == 4;
    assert pvv_trace_value(p, 4) == PVV_NO_VERDICT;
    assert pvv_trace_value(p, 3) == FAIL;
}

test the_trace_and_inspector_follow_the_what_if {
    var p : PvvState = pvv_t_select(pvv_open(), 0);
    p = pvv_apply(p, VIZ_EV_STEP_SET, 4, 0);
    // Record 0 passes every rule.
    var k : u32 = 0;
    while (k < PVV_STEPS) {
        assert pvv_trace_value(p, k) == PASS;
        k = k + 1;
    }
    assert pvv_inspect_rule(p) == PVV_RULE_NONE;
    // No tests listed (what-if 5): the first three rules still pass, the chain rule fires.
    let q : PvvState = pvv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert pvv_trace_value(q, 0) == PASS;
    assert pvv_trace_value(q, 1) == PASS;
    assert pvv_trace_value(q, 2) == PASS;
    assert pvv_trace_value(q, 3) == FAIL;
    assert pvv_trace_value(q, 4) == FAIL;
    assert pvv_inspect_rule(q) == 3;
    assert pvv_inspect_chain(q) == NO_TESTS;
    assert pvv_list_verdict(q, 0) == FAIL;
    assert pvv_badge(q) == VIZ_TRUTH_DEMO;
    // No artifact (what-if 2): only the artifact rule fires; the chain is judged on its own.
    let r : PvvState = pvv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert pvv_trace_value(r, 0) == PASS;
    assert pvv_trace_value(r, 1) == INVALID_NO_ARTIFACT;
    assert pvv_trace_value(r, 2) == PASS;
    assert pvv_trace_value(r, 3) == PASS;
    assert pvv_trace_value(r, 4) == INVALID_NO_ARTIFACT;
    assert pvv_inspect_rule(r) == 1;
    assert pvv_inspect_chain(r) == LINKED;
}

test the_inspector_shows_the_verdict_the_rule_the_chain_and_the_hardware_field {
    let open : PvvState = pvv_open();
    let a : PvvState = pvv_t_select(open, 6);
    assert pvv_inspect_verdict(a) == PASS;
    assert pvv_inspect_rule(a) == PVV_RULE_NONE;
    assert pvv_inspect_chain(a) == LINKED;
    assert pvv_inspect_hw_honest(a) == false;
    let b : PvvState = pvv_t_select(open, 4);
    assert pvv_inspect_verdict(b) == FAIL;
    assert pvv_inspect_rule(b) == 3;
    assert pvv_inspect_chain(b) == RUN_OTHER_CHANGE;
    assert pvv_inspect_hw_honest(b);
    let c : PvvState = pvv_t_select(open, 5);
    assert pvv_inspect_chain(c) == NO_TESTS;
    let d : PvvState = pvv_t_select(open, 2);
    assert pvv_inspect_verdict(d) == INVALID_NO_ARTIFACT;
    assert pvv_inspect_rule(d) == 1;
    assert pvv_inspect_chain(d) == SEAL_NOT_VERIFIED;
    let e : PvvState = pvv_t_select(open, 1);
    assert pvv_inspect_rule(e) == 0;
    assert pvv_inspect_chain(e) == RUN_UNBOUND;
    // Nothing selected: the inspector has nothing to say.
    assert pvv_inspect_verdict(open) == PVV_NO_VERDICT;
    assert pvv_inspect_rule(open) == PVV_NO_RULE;
    assert pvv_inspect_hw_honest(open) == false;
}

; ---------------------------------------------------------------- tests: host and plan

test the_host_validates_and_places_each_view_in_its_slot {
    let h : VizHost = pvv_host();
    assert h.count == 4;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_LIST;
    assert h.rep[2] == VIZ_REP_TRACE;
    assert h.rep[3] == VIZ_REP_INSPECTOR;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[3] == VH_ROOT;
    // The slot rects are the layout constants: seven list lines, five trace lines.
    assert h.x[1] == PVV_LIST_X;
    assert h.y[1] == PVV_LIST_Y;
    assert h.w[1] == PVV_LIST_W;
    assert h.h[1] == 154;
    assert h.h[2] == 110;
    assert h.h[3] == PVV_INSPECT_H;
    // A point in each slot lands in that slot; gaps and the outside are nothing.
    assert vh_hit(h, 30, 20) == PVV_SLOT_BADGE;
    assert vh_hit(h, 40, 100) == PVV_SLOT_LIST;
    assert vh_hit(h, 500, 100) == PVV_SLOT_TRACE;
    assert vh_hit(h, 920, 100) == PVV_SLOT_INSPECTOR;
    assert vh_hit(h, 470, 100) == VH_NONE;
    assert vh_hit(h, 40, 214) == VH_NONE;
    assert vh_hit(h, 500, 200) == VH_NONE;
    assert vh_hit(h, 5, 5) == VH_NONE;
}

test a_list_hit_agrees_with_the_host_hit {
    let p : PvvState = pvv_open();
    let h : VizHost = pvv_host();
    var i : u32 = 0;
    while (i < PVV_RECORD_COUNT) {
        let py : u32 = PVV_LIST_Y + i * PVV_LINE_H + 3;
        assert pvv_list_hit(p, 30, py) == pvv_record_ref(i);
        assert vh_hit(h, 30, py) == PVV_SLOT_LIST;
        i = i + 1;
    }
    // The edges of the list: one line past the seventh, left of it and right of it are nothing.
    assert pvv_list_hit(p, 30, 214) == VIZ_REF_NONE;
    assert pvv_list_hit(p, 30, 59) == VIZ_REF_NONE;
    assert pvv_list_hit(p, 19, 70) == VIZ_REF_NONE;
    assert pvv_list_hit(p, 460, 70) == VIZ_REF_NONE;
    assert vh_hit(h, 19, 70) == VH_NONE;
    assert vh_hit(h, 460, 70) == VH_NONE;
    // The badge is a slot of the host but not a list line.
    assert pvv_list_hit(p, 30, 20) == VIZ_REF_NONE;
    assert vh_hit(h, 30, 20) == PVV_SLOT_BADGE;
    // A click on a line goes through the one reducer and selects that record.
    let q : PvvState = pvv_apply(p, VIZ_EV_SELECT, pvv_list_hit(p, 30, 60 + 4 * 22 + 5), 0);
    assert q.viz.selected == pvv_record_ref(4);
    assert pvv_inspect_verdict(q) == FAIL;
}

test the_petal_embeds_in_the_contract_host {
    var outer : VizHost = vh_blank();
    outer = vh_add(outer, VIZ_REP_TEXT, VH_ROOT, 0, 0, 1400, 300);
    let e : VizHost = vh_embed(outer, pvv_host(), 0, 10, 10);
    assert e.count == 5;
    assert vh_validate(e) == VH_OK;
    assert e.rep[1] == VIZ_REP_BADGE;
    assert e.rep[2] == VIZ_REP_LIST;
    assert e.rep[3] == VIZ_REP_TRACE;
    assert e.rep[4] == VIZ_REP_INSPECTOR;
    assert e.parent[1] == 0;
    assert e.parent[4] == 0;
    // The petal moved by the slot offset and nothing else.
    assert vh_depth(e, 2) == 2;
    assert vh_abs_x(e, 2) == 30;
    assert vh_abs_y(e, 2) == 70;
    assert vh_hit(e, 40, 80) == 2;
    assert vh_hit(e, 1300, 290) == 0;
    assert vh_hit(e, 1500, 100) == VH_NONE;
    // The list hit test, shifted by the same offset, names the same record.
    let p : PvvState = pvv_open();
    assert pvv_list_hit(p, 40 - 10, 80 + 22 - 10) == pvv_record_ref(1);
    assert vh_hit(e, 40, 80 + 22) == 2;
    // The embedded host still holds exactly the petal's reps plus the frame's text.
    assert psv_host_reps(e) == pvv_reps() + viz_rep_bit(VIZ_REP_TEXT);
}

test the_plan_row_for_verdicts_matches_this_petal {
    assert PVV_PETAL == 21;
    assert pvp_reps(PVV_PETAL) == 308;
    assert pvv_reps() == 308;
    assert pvv_reps() == pvp_reps(PVV_PETAL);
    // 308 = list 4 + trace 16 + inspector 32 + badge 256.
    assert pvv_reps() == 4 + 16 + 32 + 256;
    assert psv_host_reps(pvv_host()) == pvv_reps();
    assert viz_plan_ok(pvv_reps());
    assert viz_plan_ok(pvp_reps(PVV_PETAL));
    assert viz_is_linked(pvv_reps());
    assert viz_view_count(pvv_reps()) == 3;
    // The truth the plan promises for this row is the truth the opened petal shows.
    assert pvp_truth(PVV_PETAL) == pvv_badge(pvv_open());
    assert pvp_truth(PVV_PETAL) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- invariant

invariant the_layout_does_not_overlap_and_fits_the_fixture {
    assert PVV_LIST_X + PVV_LIST_W <= PVV_TRACE_X;
    assert PVV_TRACE_X + PVV_TRACE_W <= PVV_INSPECT_X;
    assert PVV_BADGE_Y + PVV_BADGE_H <= PVV_LIST_Y;
    assert PVV_INSPECT_H == PVV_RECORD_COUNT * PVV_LINE_H;
    assert PVV_RECORD_COUNT <= 16;
    assert PVV_STEPS == 5;
    assert PVV_WHATIFS == 8;
    assert PVV_RULE_NONE == PVV_STEPS - 1;
}
