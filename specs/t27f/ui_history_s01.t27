// SPDX-License-Identifier: Apache-2.0
; T27F UI history, step 01: the task card takes its numbers from the design tokens (Refs gHashTag/t27#13214, epic #13214)
; The typed record of docs/reports/ui-history/2026-11-07/step-01-task-card-tokens/ (the frames live there; MANIFEST.md there is a pointer to
;   this file and holds no field of its own). Shape and rules: ui_history. This record is append-only: a later correction is a new step
;   (ui_history_s02), never an edit of this one, and the tests below pin the fields a rewrite would have to touch
; Paths are relative to the step folder. The measured facts are the ones a test or a byte comparison backs; nothing here says the card looks
;   better, and visual_review is PENDING_OWNER until the owner has opened the frames and said so in chat
; ASCII only (L3)

module T27fUiHistoryS01;
use t27f::ui_history::UiStep;
use t27f::ui_history::uh_validate;
use t27f::ui_history::UH_OK;
use t27f::ui_history::UH_DRAFT;
use t27f::ui_history::UH_PENDING_OWNER;

pub const US1_SEQ : u32 = 1;
pub const US1_ID : str = "ui-2026-11-07-step-01";
pub const US1_FOLDER : str = "docs/reports/ui-history/2026-11-07/step-01-task-card-tokens";

const US1_BEFORE : [12]str = [
    "01-before-token-integration/base_375_p100_t0.png",
    "01-before-token-integration/base_768_p100_t0.png",
    "01-before-token-integration/base_1280_p100_t0.png",
    "04-scale-check/base_375_p200_t0.png",
    "04-scale-check/base_1280_p200_t0.png",
    "", "", "", "", "", "", "",
];

const US1_AFTER : [12]str = [
    "02-after-token-integration/after_375_p100_t0.png",
    "02-after-token-integration/after_768_p100_t0.png",
    "02-after-token-integration/after_1280_p100_t0.png",
    "03-paper-theme/after_375_p100_t1.png",
    "03-paper-theme/after_1280_p100_t1.png",
    "04-scale-check/after_375_p200_t0.png",
    "04-scale-check/after_1280_p200_t0.png",
    "", "", "", "", "",
];

const US1_DIFF : [12]str = [
    "05-diff/cmp_375_p100.png",
    "05-diff/cmp_768_p100.png",
    "05-diff/cmp_1280_p100.png",
    "05-diff/cmp_375_p200.png",
    "05-diff/cmp_1280_p200.png",
    "", "", "", "", "", "", "",
];

const US1_TOK_NAMES : [12]str = [
    "space.card.padding",
    "space.field.label_gap",
    "space.field.group_gap",
    "space.action.gap",
    "layout.card.max_inline",
    "card.height (derived by vf_layout)",
    "painter.text_inset",
    "", "", "", "", "",
];

const US1_TOK_BEFORE : [12]str = ["8", "8", "8", "8", "none", "192", "none", "", "", "", "", ""];

const US1_TOK_AFTER : [12]str = ["16", "6", "16", "10", "560", "230", "16", "", "", "", "", ""];

const US1_MEASURED : [12]str = [
    "the card is 192 design px high before and 230 after (the vf_layout result, pinned in the vf_card_tok tests)",
    "heading 26, body 16 and outline 1 are the same numbers before and after; they now come from the token style, and tests that change them change the picture",
    "the seven AFTER rasters rendered before and after the style refactor are byte-identical (md5), so the refactor itself moved no pixel",
    "at 768 and 1280 the card is drawn 560 wide and centred, at x offsets 104 and 360; the layout rectangles are identical at every width",
    "tests at head 70cf34dc61 in T27 OS pane 15, 0 failed, 0 vacuous: vf_card_tok 15, vf_card 20, vf_theme 11, vf_storybook 13, vf_proportion 25, vf_tokens 21 (t27c and t27b), vf_card_main 6 (t27c)",
    "", "", "", "", "", "", "",
];

const US1_LIMITS : [12]str = [
    "no person has looked at any frame in this step; nothing here claims the card looks better",
    "the theme defaults (inset 12, width 480) differ from the tokens (16, 560); the default vc_render_state path keeps the theme values and a test pins the gap",
    "type.label and control.min_target resolve but do not drive the painter",
    "vf_theme keeps a second spacing and type scale; the painter pen offset still comes from it",
    "vf_layout narrows no column and measures no text; the 560 clamp and the centring live in the renderer, not in vf_layout",
    "the breakpoint is 600 in vf_theme and 640 in vf_layout, unchanged and pinned in vf_ring1",
    "error and disabled input states are not drawn; the focus ring on the filled Save button is accent on accent; the cap height ratio 700 milli is assumed, not measured",
    "when filed, the commits after bd1b9ece89 were local only, and PR 13254 carried three inherited master reds that PR 13225 is meant to clear",
    "", "", "", "",
];

pub fn us1_step() -> UiStep {
    var st : UiStep = UiStep {
        seq: US1_SEQ,
        step_id: US1_ID,
        date: "2026-11-07",
        commit: "70cf34dc61 (AFTER frames and code of this step), bd1b9ece89 (BEFORE frames)",
        branch: "claude/t27f-007-outfit-type",
        theme: "t0 black (main set), t1 paper (03-paper-theme)",
        viewport: "375, 768, 1280 (design width of the card scene)",
        scale: "100 percent (main set), 200 percent (04-scale-check)",
        before_n: 5,
        before_paths: US1_BEFORE,
        after_n: 7,
        after_paths: US1_AFTER,
        diff_n: 5,
        diff_paths: US1_DIFF,
        token_n: 7,
        token_names: US1_TOK_NAMES,
        token_before: US1_TOK_BEFORE,
        token_after: US1_TOK_AFTER,
        intended_change: "More room and a steadier rhythm for the task card: 16 px padding and group gap, 6 px label gap, 10 px action gap and a 560 px maximum width centred on wide rasters, all read from the design tokens instead of renderer constants. Whether it looks better is the owner's call.",
        measured_n: 5,
        measured: US1_MEASURED,
        limit_n: 8,
        limits: US1_LIMITS,
        status: UH_DRAFT,
        visual_review: UH_PENDING_OWNER,
    };
    return st;
}

test step_one_holds_every_rule_of_the_schema {
    let st : UiStep = us1_step();
    assert uh_validate(st) == UH_OK;
}

test step_one_is_pinned_as_filed {
    let st : UiStep = us1_step();
    assert st.seq == 1;
    assert st.status == UH_DRAFT;
    assert st.visual_review == UH_PENDING_OWNER;
    assert st.before_n == 5;
    assert st.after_n == 7;
    assert st.diff_n == 5;
    assert st.token_n == 7;
    assert st.measured_n == 5;
    assert st.limit_n == 8;
}

test step_one_names_its_folder_and_branch {
    let st : UiStep = us1_step();
    let id : str = st.step_id;
    let want : str = US1_ID;
    assert id == want;
    let folder : str = US1_FOLDER;
    assert folder == "docs/reports/ui-history/2026-11-07/step-01-task-card-tokens";
    let br : str = st.branch;
    assert br == "claude/t27f-007-outfit-type";
}
