pub const ID : str = "lesson-reel";
// JetBrains Mono ExtraBold with both scripts and the digits, so one face sets every line.
pub const FONT : str = "/root/tf/fonts/jbm-all-800.ttf";
pub const FILE_DIR : str = "/root/lr/f";

pub fn lang_dir(lang: usize) -> str {
    if (lang == 0) {
        return "en";
    }
    return "ru";
}

// ---- the voice: three phrases, sped up a little or cut to two when they will not fit ----
pub const PHRASES : usize = 3;
pub const PHRASE_GAP_MS : i32 = 250;
pub const TEMPO_MAX_PERMILLE : i32 = 1200;

pub fn ms_of(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    if (p == 0) {
        return m0;
    }
    if (p == 1) {
        return m1;
    }
    return m2;
}

// The time n phrases may take as spoken: from the voice offset to the last caption's tail before
// the call to action's hold, less the gaps between them.
pub fn voice_room_ms(n: usize) -> i32 {
    return REEL_MS - REEL_CTA_MIN_MS - CAPTION_TAIL_MS - VOICE_OFFSET_MS - @as(i32, @intCast(n - 1)) * PHRASE_GAP_MS;
}

fn raw_total(m0: i32, m1: i32, m2: i32, n: usize) -> i32 {
    var s : i32 = 0;
    var p : usize = 0;
    while (p < n) {
        s = s + ms_of(m0, m1, m2, p);
        p = p + 1;
    }
    return s;
}

// The tempo, per mille, at which n phrases fit their room: 1000 when they fit as spoken.
pub fn tempo_for(m0: i32, m1: i32, m2: i32, n: usize) -> i32 {
    const room = voice_room_ms(n);
    const raw = raw_total(m0, m1, m2, n);
    if (raw <= room) {
        return 1000;
    }
    return @divTrunc(raw * 1000 + room - 1, room);
}

// How many phrases the reel speaks: the three when they fit at TEMPO_MAX, else the title and goal.
pub fn phrases_for(m0: i32, m1: i32, m2: i32) -> usize {
    if (tempo_for(m0, m1, m2, PHRASES) <= TEMPO_MAX_PERMILLE) {
        return PHRASES;
    }
    return 2;
}

pub fn tempo(m0: i32, m1: i32, m2: i32) -> i32 {
    return tempo_for(m0, m1, m2, phrases_for(m0, m1, m2));
}

// Whether the reel can be made at all: its phrases fit at a tempo the ear still takes.
pub fn voice_fits(m0: i32, m1: i32, m2: i32) -> bool {
    return m0 > 0 && m1 > 0 && m2 > 0 && tempo(m0, m1, m2) <= TEMPO_MAX_PERMILLE;
}

// How long phrase p plays after the tempo (rounded down, so the sum stays inside the room).
pub fn played(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    return @divTrunc(ms_of(m0, m1, m2, p) * 1000, tempo(m0, m1, m2));
}

pub fn phrase_start(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    var t : i32 = VOICE_OFFSET_MS;
    var q : usize = 0;
    while (q < p) {
        t = t + played(m0, m1, m2, q) + PHRASE_GAP_MS;
        q = q + 1;
    }
    return t;
}

// ---- the caption chunks: whole words up to CHUNK_CHARS letters; a longer word is cut ----
pub const CHUNK_CHARS : usize = 14;
pub const SPACE : u32 = 32;

fn word_end(i: usize, s: usize) -> usize {
    var k : usize = s;
    while (k < item_len(i) && cp(i, k) != SPACE) {
        k = k + 1;
    }
    return k;
}

// The end (exclusive) of the chunk of item i that starts at s.
pub fn chunk_end(i: usize, s: usize) -> usize {
    const n = item_len(i);
    var e : usize = word_end(i, s);
    if (e - s > CHUNK_CHARS) {
        return s + CHUNK_CHARS;
    }
    var going : bool = true;
    while (going && e < n) {
        const e2 = word_end(i, e + 1);
        if (e2 - s > CHUNK_CHARS) {
            going = false;
        } else {
            e = e2;
        }
    }
    return e;
}

// Where the next chunk starts after one ending at e: past the space, if there is one.
pub fn after(i: usize, e: usize) -> usize {
    if (e < item_len(i) && cp(i, e) == SPACE) {
        return e + 1;
    }
    return e;
}

pub fn chunks(i: usize) -> usize {
    var s : usize = 0;
    var n : usize = 0;
    while (s < item_len(i)) {
        s = after(i, chunk_end(i, s));
        n = n + 1;
    }
    return n;
}

pub fn chunk_start(i: usize, c: usize) -> usize {
    var s : usize = 0;
    var n : usize = 0;
    while (n < c) {
        s = after(i, chunk_end(i, s));
        n = n + 1;
    }
    return s;
}

pub fn chunk_chars(i: usize, c: usize) -> usize {
    const s = chunk_start(i, c);
    return chunk_end(i, s) - s;
}

fn phrase_item(t: usize, lang: usize, p: usize) -> usize {
    return item(t, lang, p);
}

// When chunk c of phrase p comes: its phrase's start plus its share of the phrase's letters.
pub fn chunk_from(t: usize, lang: usize, m0: i32, m1: i32, m2: i32, p: usize, c: usize) -> i32 {
    const i = phrase_item(t, lang, p);
    const share = @as(i32, @intCast(chunk_start(i, c))) * played(m0, m1, m2, p);
    return phrase_start(m0, m1, m2, p) + @divTrunc(share, @as(i32, @intCast(item_len(i))));
}

// It goes when the next chunk comes; the phrase's last one stays the tail after the voice, but
// never into the next phrase.
pub fn chunk_until(t: usize, lang: usize, m0: i32, m1: i32, m2: i32, p: usize, c: usize) -> i32 {
    const i = phrase_item(t, lang, p);
    if (c + 1 < chunks(i)) {
        return chunk_from(t, lang, m0, m1, m2, p, c + 1);
    }
    var u : i32 = phrase_start(m0, m1, m2, p) + played(m0, m1, m2, p) + CAPTION_TAIL_MS;
    if (p + 1 < phrases_for(m0, m1, m2)) {
        const nx = phrase_start(m0, m1, m2, p + 1);
        if (nx < u) {
            u = nx;
        }
    }
    return u;
}

pub fn cta_from(t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> i32 {
    const n = phrases_for(m0, m1, m2);
    return chunk_until(t, lang, m0, m1, m2, n - 1, chunks(phrase_item(t, lang, n - 1)) - 1);
}

// ---- the text files ----
// 0 the lesson tag, 1 the course tag, 2 the cards' label, 3..8 the cards' code lines (card c's two
// at 3 + 2c), 9 the page under the address, then the caption chunks, phrase by phrase.
pub const F_TAG_LESSON : usize = 0;
pub const F_TAG_COURSE : usize = 1;
pub const F_CARD_LABEL : usize = 2;
pub const F_CARD0 : usize = 3;
pub const F_PAGE : usize = 9;
pub const F_CHUNK0 : usize = 10;

pub fn chunk_file(t: usize, lang: usize, p: usize, c: usize) -> usize {
    var f : usize = F_CHUNK0;
    var q : usize = 0;
    while (q < p) {
        f = f + chunks(phrase_item(t, lang, q));
        q = q + 1;
    }
    return f + c;
}

pub fn files(t: usize, lang: usize) -> usize {
    return chunk_file(t, lang, PHRASES, 0);
}

// The lines the cards may show: the lesson's code less a closing brace alone on its last line.
pub fn shown_lines(t: usize) -> usize {
    const n = code_lines(t);
    const last = code_line0(t) + n - 1;
    if (line_len(last) == 1 && code_byte(last, 0) == 125) {
        return n - 1;
    }
    return n;
}

// The cards walk down the lesson's spec: card c shows two lines from c (n - 2) / 2 on.
pub fn card_code_line(t: usize, c: usize, j: usize) -> usize {
    const n = shown_lines(t);
    return code_line0(t) + @divTrunc(c * (n - 2), 2) + j;
}

// The upper case the tags are set in: Latin, Cyrillic a..ya, and yo.
pub fn up(c: u32) -> u32 {
    if (c >= 97 && c <= 122) {
        return c - 32;
    }
    if (c >= 1072 && c <= 1103) {
        return c - 32;
    }
    if (c == 1105) {
        return 1025;
    }
    return c;
}

// One code point as UTF-8: every letter here is below U+0800, so one or two bytes.
fn print_cp(c: u32) -> void {
    if (c < 128) {
        std.debug.print("{c}", .{@as(u8, @intCast(c))});
    } else {
        std.debug.print("{c}{c}", .{ @as(u8, @intCast(192 + @divTrunc(c, 64))), @as(u8, @intCast(128 + @mod(c, 64))) });
    }
}

fn print_span(i: usize, s: usize, e: usize, upper: bool) -> void {
    var k : usize = s;
    while (k < e) {
        if (upper) {
            print_cp(up(cp(i, k)));
        } else {
            print_cp(cp(i, k));
        }
        k = k + 1;
    }
}

// The length a hole "{0}" or "{1}" fills with in "Lesson {0} of {1}", and the letters as written.
fn hole_value(t: usize, h: u32) -> usize {
    if (h == 48) {
        return lesson_n(t);
    }
    return TOPICS;
}

fn digits(v: usize) -> usize {
    if (v >= 10) {
        return 2;
    }
    return 1;
}

fn is_hole(i: usize, k: usize) -> bool {
    return k + 2 < item_len(i) && cp(i, k) == 123 && cp(i, k + 2) == 125;
}

pub fn lesson_tag_chars(t: usize, lang: usize) -> usize {
    const i = lesson_of_item(lang);
    var n : usize = 0;
    var k : usize = 0;
    while (k < item_len(i)) {
        if (is_hole(i, k)) {
            n = n + digits(hole_value(t, cp(i, k + 1)));
            k = k + 3;
        } else {
            n = n + 1;
            k = k + 1;
        }
    }
    return n;
}

fn print_lesson_tag(t: usize, lang: usize) -> void {
    const i = lesson_of_item(lang);
    var k : usize = 0;
    while (k < item_len(i)) {
        if (is_hole(i, k)) {
            std.debug.print("{d}", .{hole_value(t, cp(i, k + 1))});
            k = k + 3;
        } else {
            print_cp(up(cp(i, k)));
            k = k + 1;
        }
    }
}

fn print_code_line(l: usize) -> void {
    var k : usize = 0;
    while (k < line_len(l)) {
        std.debug.print("{c}", .{code_byte(l, k)});
        k = k + 1;
    }
}

pub fn print_file(t: usize, lang: usize, f: usize) -> void {
    if (f == F_TAG_LESSON) {
        print_lesson_tag(t, lang);
    } else if (f == F_TAG_COURSE) {
        const i = course_title_item(lang);
        print_span(i, 0, item_len(i), true);
    } else if (f == F_CARD_LABEL) {
        print_span(id_item(t), 0, item_len(id_item(t)), false);
        std.debug.print(".t27", .{});
    } else if (f < F_PAGE) {
        print_code_line(card_code_line(t, @divTrunc(f - F_CARD0, 2), @mod(f - F_CARD0, 2)));
    } else if (f == F_PAGE) {
        std.debug.print("/learn/", .{});
        print_span(id_item(t), 0, item_len(id_item(t)), false);
        std.debug.print("/", .{});
    } else {
        var p : usize = 0;
        var c : usize = f - F_CHUNK0;
        while (p + 1 < PHRASES && c >= chunks(phrase_item(t, lang, p))) {
            c = c - chunks(phrase_item(t, lang, p));
            p = p + 1;
        }
        const i = phrase_item(t, lang, p);
        const s = chunk_start(i, c);
        print_span(i, s, chunk_end(i, s), false);
    }
}

// ---- the layout ----

// The px a run of n letters takes at a font size, at the mono face's advance.
pub fn run_px(n: usize, font: i32) -> i32 {
    return @divTrunc(@as(i32, @intCast(n)) * font * MONO_ADVANCE_PERMILLE, 1000);
}

// The tags: the gold shot number, a grey slash, then the text, which starts five letters in.
pub const TAG_TEXT_AT : usize = 5;

pub fn tag_file(s: usize) -> usize {
    return @mod(s, 2);
}

pub fn tag_chars(t: usize, lang: usize, f: usize) -> usize {
    if (f == F_TAG_LESSON) {
        return lesson_tag_chars(t, lang);
    }
    return item_len(course_title_item(lang));
}

// The cards: the label at 3/4 of the card's code size, the two code lines fitted to the card.
pub fn label_font(o: usize) -> i32 {
    return @as(i32, @intFromFloat(@floor(0.75 * card_f(o, 5) + 0.5)));
}

pub fn code_font(o: usize, n: usize) -> i32 {
    const room = @as(i32, @intFromFloat(card_f(o, 2) - 2.0 * CARD_PAD));
    const fit = @divTrunc(room * 1000, @as(i32, @intCast(n)) * MONO_ADVANCE_PERMILLE);
    const most = @as(i32, @intFromFloat(card_f(o, 5)));
    if (fit < most) {
        return fit;
    }
    return most;
}

pub const CODE_FONT_MIN : i32 = 12;

// The call to action: "t27.ai" in gold, lifted a little in the band, and the lesson's page under
// it in grey.
pub const CTA_TEXT : str = "t27.ai";
pub const CTA_CHARS : usize = 6;
pub const CTA_FONT : i32 = 100;
pub const CTA_LIFT : i32 = 20;
pub const PAGE_FONT : i32 = 40;
pub const PAGE_GAP : i32 = 8;

pub fn cta_y(o: usize) -> i32 {
    return caption_y(o) - CTA_LIFT;
}

pub fn page_top(o: usize) -> i32 {
    return cta_y(o) + @divTrunc(CTA_FONT, 2) + PAGE_GAP;
}

pub fn page_chars(t: usize) -> usize {
    return item_len(id_item(t)) + 8;
}

// ---- the graph ----

fn print_tag(o: usize, s: usize, dx: i32, row: usize, f: usize, lang: usize) -> void {
    const a = SHOT_START[s];
    const b = SHOT_START[s + 1] - 1;
    if (f == 99) {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:text='{d:0>2}':fontsize={d}:fontcolor=", .{ FONT, s + 1, TAG_FONT[o] });
    } else if (f == 98) {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:text='/':fontsize={d}:fontcolor=", .{ FONT, TAG_FONT[o] });
    } else {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), f, TAG_FONT[o] });
    }
    print_col(row);
    std.debug.print(":x='{d}+{d}*pow(1-clip((n-{d})/{d},0,1),3)':y={d}:alpha='clip((n-{d})/{d},0,1)':enable='between(n,{d},{d})'", .{ TAG_X[o] + dx, TAG_SLIDE_PX, a, TAG_SLIDE_F, TAG_Y[o], a, TAG_SLIDE_F, a, b });
}

fn print_card_text(o: usize, c: usize, lang: usize, f: usize, font: i32, row: usize, dy: f64) -> void {
    std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), f, font });
    print_col(row);
    std.debug.print(":x={d:.1}", .{card_f(o, 0) + CARD_PAD});
    print_rise(o, c, dy);
    std.debug.print("'", .{});
    print_fade(c);
}

fn print_card(o: usize, c: usize, t: usize, lang: usize) -> void {
    print_card_text(o, c, lang, F_CARD_LABEL, label_font(o), GREY_ROW, CARD_LY[o * 3]);
    var j : usize = 0;
    while (j < 2) {
        const font = code_font(o, line_len(card_code_line(t, c, j)));
        var row : usize = WHITE_ROW;
        if (j == 1) {
            row = GOLD_ROW;
        }
        print_card_text(o, c, lang, F_CARD0 + 2 * c + j, font, row, CARD_LY[o * 3 + 1 + j]);
        j = j + 1;
    }
    std.debug.print(",drawtext=fontfile={s}:text='PASS':fontsize={d}:fontcolor=0x000000:x={d:.1}", .{ FONT, PASS_FONT[o], pill_x(o) + PASS_DX });
    print_rise(o, c, pill_dy(o) + 0.5 * PILL_H);
    std.debug.print("-text_h/2'", .{});
    print_fade(c);
}

fn print_cta(o: usize, t: usize, lang: usize, a: i32) -> void {
    std.debug.print(",drawtext=fontfile={s}:text='{s}':fontsize={d}:fontcolor=", .{ FONT, CTA_TEXT, CTA_FONT });
    print_col(GOLD_ROW);
    std.debug.print(":borderw={d}:bordercolor=0x000000:shadowx=0:shadowy={d}:shadowcolor=0x000000@0.6:x={d}+({d}-text_w)/2:y={d}-text_h/2:alpha='clip((t-{d}.{d:0>3})/0.{d:0>3},0,1)':enable='gte(t,{d}.{d:0>3})'", .{ CAPTION_BORDER_PX, CAPTION_SHADOW_Y_PX, band_x(o), band_w(o), cta_y(o), secs(a), millis(a), millis(TF_CTA_FADE_MS), secs(a), millis(a) });
    std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), F_PAGE, PAGE_FONT });
    print_col(GREY_ROW);
    std.debug.print(":x={d}+({d}-text_w)/2:y={d}:alpha='clip((t-{d}.{d:0>3})/0.{d:0>3},0,1)':enable='gte(t,{d}.{d:0>3})'", .{ band_x(o), band_w(o), page_top(o), secs(a), millis(a), millis(TF_CTA_FADE_MS), secs(a), millis(a) });
}

pub fn graph(o: usize, t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> void {
    std.debug.print("[0:v]format=yuv420p", .{});
    const adv = @divTrunc(TAG_FONT[o] * MONO_ADVANCE_PERMILLE, 1000);
    var s : usize = 0;
    while (s < SHOTS) {
        print_tag(o, s, 0, GOLD_ROW, 99, lang);
        print_tag(o, s, 3 * adv, GREY_ROW, 98, lang);
        print_tag(o, s, @as(i32, @intCast(TAG_TEXT_AT)) * adv, GREY_ROW, tag_file(s), lang);
        s = s + 1;
    }
    var c : usize = 0;
    while (c < CARDS) {
        print_card(o, c, t, lang);
        c = c + 1;
    }
    const n = phrases_for(m0, m1, m2);
    var p : usize = 0;
    while (p < n) {
        const i = phrase_item(t, lang, p);
        var k : usize = 0;
        while (k < chunks(i)) {
            const a = chunk_from(t, lang, m0, m1, m2, p, k);
            const b = chunk_until(t, lang, m0, m1, m2, p, k);
            std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), chunk_file(t, lang, p, k), band_font(o, @as(i32, @intCast(chunk_chars(i, k)))) });
            print_col(GOLD_ROW);
            std.debug.print(":borderw={d}:bordercolor=0x000000:shadowx=0:shadowy={d}:shadowcolor=0x000000@0.6:x={d}:y={d}-text_h/2:enable='between(t,{d}.{d:0>3},{d}.{d:0>3})'", .{ CAPTION_BORDER_PX, CAPTION_SHADOW_Y_PX, band_x(o), caption_y(o), secs(a), millis(a), secs(b), millis(b) });
            k = k + 1;
        }
        p = p + 1;
    }
    print_cta(o, t, lang, cta_from(t, lang, m0, m1, m2));
    std.debug.print("[v];", .{});
    const tp = tempo(m0, m1, m2);
    p = 0;
    while (p < n) {
        const at = phrase_start(m0, m1, m2, p);
        std.debug.print("[{d}:a]aresample=48000,atempo={d}.{d:0>3},pan=stereo|c0=c0|c1=c0,adelay={d}|{d}[p{d}];", .{ p + 1, secs(tp), millis(tp), at, at, p });
        p = p + 1;
    }
    p = 0;
    while (p < n) {
        std.debug.print("[p{d}]", .{p});
        p = p + 1;
    }
    std.debug.print("amix=inputs={d}:normalize=0:duration=longest,loudnorm=I={d}:TP=-1.5:LRA={d},aresample=48000,apad=whole_dur={d}[vo];", .{ n, VOICE_LUFS, VOICE_LRA, secs(REEL_MS) });
    std.debug.print("[4:a]atrim=0:{d},volume=0.{d:0>3},afade=t=in:d=0.{d:0>3},afade=t=out:st={d}.{d:0>3}:d={d}.{d:0>3}[mu];", .{ secs(REEL_MS), millis(MUSIC_VOLUME_PERMILLE), millis(MUSIC_FADE_IN_MS), secs(MUSIC_FADE_OUT_START_MS), millis(MUSIC_FADE_OUT_START_MS), secs(MUSIC_FADE_OUT_MS), millis(MUSIC_FADE_OUT_MS) });
    std.debug.print("[vo][mu]amix=inputs=2:normalize=0:duration=first,alimiter=limit=0.{d:0>3}[a]\n", .{millis(LIMIT_PERMILLE)});
}

// ---- main ----

// The environment variable `name` as a number of up to six digits; dflt when unset. Only main
// calls this, so the tests, which never link libc, do not reach getenv.
fn env_num(name: [*:0]const u8, dflt: i32) -> i32 {
    const p = std.c.getenv(name);
    if (p == null) {
        return dflt;
    }
    const s = p.?;
    var v : i32 = 0;
    var i : usize = 0;
    while (i < 6 && s[i] >= 48 && s[i] <= 57) {
        v = v * 10 + @as(i32, @intCast(s[i] - 48));
        i = i + 1;
    }
    if (i == 0) {
        return dflt;
    }
    return v;
}

pub fn main() -> void {
    var t : usize = @as(usize, @intCast(env_num("LR_T", 0)));
    if (t >= TOPICS) {
        t = 0;
    }
    var lang : usize = @as(usize, @intCast(env_num("LR_LANG", 0)));
    if (lang > 1) {
        lang = 0;
    }
    const mode = env_num("LR_MODE", 2);
    const k = @as(usize, @intCast(env_num("LR_K", 0)));
    if (mode == 0) {
        var p : usize = k;
        if (p >= PHRASES) {
            p = 0;
        }
        const i = phrase_item(t, lang, p);
        print_span(i, 0, item_len(i), false);
    } else if (mode == 1) {
        if (k < files(t, lang)) {
            print_file(t, lang, k);
        }
    } else if (mode == 3) {
        const m0 = env_num("LR_MS0", 0);
        const m1 = env_num("LR_MS1", 0);
        const m2 = env_num("LR_MS2", 0);
        if (voice_fits(m0, m1, m2)) {
            graph(TALL, t, lang, m0, m1, m2);
            graph(WIDE, t, lang, m0, m1, m2);
        } else {
            std.debug.print("lesson_reel: the voice does not fit the reel\n", .{});
        }
    } else {
        std.debug.print("{d}\n", .{files(t, lang)});
    }
}

// ---- tests ----

// Phrase lengths as the voice service gave them for lesson 1 (2026-10-18 shape, rounded): short,
// a tight fit, and one that only fits without the task.
pub const M_EN0 : i32 = 1300;
pub const M_EN1 : i32 = 4200;
pub const M_EN2 : i32 = 6800;

test "the chunks tile every phrase of every lesson, at spaces, and none is too long to read" {
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var p : usize = 0;
            while (p < PHRASES) {
                const i = phrase_item(t, lang, p);
                var s : usize = 0;
                var c : usize = 0;
                while (s < item_len(i)) {
                    assert(chunk_start(i, c) == s);
                    const e = chunk_end(i, s);
                    assert(e > s);
                    assert(e - s <= CHUNK_CHARS);
                    assert(cp(i, s) != SPACE);
                    s = after(i, e);
                    c = c + 1;
                }
                assert(c == chunks(i));
                assert(s == item_len(i));
                p = p + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
}

test "every caption, tag, card line and page fits its place at a size that reads" {
    var o : usize = 0;
    while (o < 2) {
        const right = @as(i32, @intFromFloat(safe_f(o, 2)));
        assert(band_font(o, @as(i32, @intCast(CHUNK_CHARS))) >= @as(i32, @intFromFloat(REEL_TEXT_MIN_PX)));
        assert(run_px(CHUNK_CHARS, band_font(o, @as(i32, @intCast(CHUNK_CHARS)))) <= band_w(o));
        var t : usize = 0;
        while (t < TOPICS) {
            var lang : usize = 0;
            while (lang < 2) {
                var f : usize = 0;
                while (f < 2) {
                    const end = TAG_X[o] + run_px(TAG_TEXT_AT + tag_chars(t, lang, f), TAG_FONT[o]);
                    if (o == TALL) {
                        assert(end <= right);
                    } else {
                        assert(end <= band_x(o) - 40);
                    }
                    f = f + 1;
                }
                lang = lang + 1;
            }
            const label_end = card_f(o, 0) + CARD_PAD + @as(f64, @floatFromInt(run_px(item_len(id_item(t)) + 4, label_font(o))));
            assert(label_end + 12.0 <= pill_x(o));
            var c : usize = 0;
            while (c < 3) {
                var j : usize = 0;
                while (j < 2) {
                    const l = card_code_line(t, c, j);
                    assert(l < code_line0(t) + code_lines(t));
                    assert(code_font(o, line_len(l)) >= CODE_FONT_MIN);
                    assert(run_px(line_len(l), code_font(o, line_len(l))) <= @as(i32, @intFromFloat(card_f(o, 2) - 2.0 * CARD_PAD)));
                    j = j + 1;
                }
                c = c + 1;
            }
            assert(run_px(page_chars(t), PAGE_FONT) <= band_w(o));
            t = t + 1;
        }
        o = o + 1;
    }
}

test "the address is big enough and the page under it stays on the frame, tall inside the safe rect" {
    assert(@as(f64, @floatFromInt(CTA_FONT)) >= REEL_CTA_MIN_PX);
    assert(@as(f64, @floatFromInt(PAGE_FONT)) >= REEL_TEXT_MIN_PX);
    assert(run_px(CTA_CHARS, CTA_FONT) <= band_w(TALL));
    const x0 = @as(f64, @floatFromInt(band_x(TALL)));
    const y0 = @as(f64, @floatFromInt(cta_y(TALL) - @divTrunc(CTA_FONT, 2)));
    const x1 = x0 + @as(f64, @floatFromInt(band_w(TALL)));
    const y1 = @as(f64, @floatFromInt(page_top(TALL) + PAGE_FONT));
    assert(reel_shows(x0, y0, x1, y1));
    assert(page_top(WIDE) + PAGE_FONT <= frame_h(WIDE));
    // and the address clears the last card, which stays up to the end
    assert(@as(f64, @floatFromInt(cta_y(TALL) - @divTrunc(CTA_FONT, 2))) > card_f(TALL, 1) + card_f(TALL, 3));
}

test "a voice that fits is left as spoken, and one that does not is sped up within the cap" {
    assert(voice_room_ms(3) == 12250);
    assert(tempo_for(1300, 4200, 6000, 3) == 1000);
    assert(phrases_for(1300, 4200, 6000) == 3);
    assert(tempo(M_EN0, M_EN1, M_EN2) == 1005);
    assert(voice_fits(M_EN0, M_EN1, M_EN2));
    // too long for three even at the cap: the task goes, and the title and goal play as spoken
    assert(phrases_for(1500, 5000, 9000) == 2);
    assert(tempo(1500, 5000, 9000) == 1000);
    // two at exactly the cap still play; a little more is refused
    assert(voice_fits(3000, 12000, 1000));
    assert(voice_fits(3000, 13000, 1000) == false);
    assert(voice_fits(0, 4000, 4000) == false);
}

test "the hook clock and the call to action's hold hold for every lesson in both languages" {
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            assert(phrase_start(M_EN0, M_EN1, M_EN2, 0) <= REEL_FIRST_WORD_MS);
            assert(chunk_from(t, lang, M_EN0, M_EN1, M_EN2, 0, 0) <= REEL_HOOK_TEXT_MS);
            assert(cta_from(t, lang, M_EN0, M_EN1, M_EN2) <= REEL_MS - REEL_CTA_MIN_MS);
            assert(cta_from(t, lang, 1500, 5000, 9000) <= REEL_MS - REEL_CTA_MIN_MS);
            // the captions come in order and never overlap
            var p : usize = 0;
            var last : i32 = 0;
            while (p < PHRASES) {
                var c : usize = 0;
                while (c < chunks(phrase_item(t, lang, p))) {
                    const a = chunk_from(t, lang, M_EN0, M_EN1, M_EN2, p, c);
                    const b = chunk_until(t, lang, M_EN0, M_EN1, M_EN2, p, c);
                    assert(a >= last);
                    assert(b > a);
                    last = b;
                    c = c + 1;
                }
                p = p + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
}

test "the files are numbered in order, and the tags read in upper case" {
    assert(F_CARD0 + 2 * CARDS == F_PAGE);
    assert(F_PAGE + 1 == F_CHUNK0);
    assert(files(0, 0) == F_CHUNK0 + chunks(item(0, 0, 0)) + chunks(item(0, 0, 1)) + chunks(item(0, 0, 2)));
    assert(up(97) == 65);
    assert(up(1072) == 1040);
    assert(up(1103) == 1071);
    assert(up(1105) == 1025);
    assert(up(46) == 46);
    // "LESSON 1 OF 27" and "URok 1 iz 27" are 14 and 12 letters
    assert(lesson_tag_chars(0, 0) == 14);
    assert(lesson_tag_chars(0, 1) == 12);
    assert(lesson_tag_chars(26, 0) == 15);
    // lesson 1's cards: lines 0, 2 and 4 of the six it shows (its seventh is the closing brace)
    assert(code_lines(0) == 7);
    assert(shown_lines(0) == 6);
    assert(card_code_line(0, 0, 0) == 0);
    assert(card_code_line(0, 1, 0) == 2);
    assert(card_code_line(0, 2, 1) == 5);
    var t : usize = 0;
    while (t < TOPICS) {
        assert(shown_lines(t) >= 2);
        t = t + 1;
    }
}
