pub const ID : str = "lesson-reel";
// JetBrains Mono ExtraBold with both scripts and the digits, so one face sets every line.
pub const FONT : str = "/root/tf/fonts/jbm-all-800.ttf";
pub const FILE_DIR : str = "/root/lr/f";

pub fn lang_dir(lang: usize) -> str {
    if (lang == 0) {
        return "en";
    }
    return "ru";
}

// ---- the voice: three phrases, sped up a little or cut to two when they will not fit ----
pub const PHRASES : usize = 3;
pub const PHRASE_GAP_MS : i32 = 250;
pub const TEMPO_MAX_PERMILLE : i32 = 1200;

pub fn ms_of(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    if (p == 0) {
        return m0;
    }
    if (p == 1) {
        return m1;
    }
    return m2;
}

// The time n phrases may take as spoken: from the voice offset to the last caption's tail before
// the call to action's hold, less the gaps between them.
pub fn voice_room_ms(n: usize) -> i32 {
    return REEL_MS - REEL_CTA_MIN_MS - CAPTION_TAIL_MS - VOICE_OFFSET_MS - @as(i32, @intCast(n - 1)) * PHRASE_GAP_MS;
}

fn raw_total(m0: i32, m1: i32, m2: i32, n: usize) -> i32 {
    var s : i32 = 0;
    var p : usize = 0;
    while (p < n) {
        s = s + ms_of(m0, m1, m2, p);
        p = p + 1;
    }
    return s;
}

// The tempo, per mille, at which n phrases fit their room: 1000 when they fit as spoken.
pub fn tempo_for(m0: i32, m1: i32, m2: i32, n: usize) -> i32 {
    const room = voice_room_ms(n);
    const raw = raw_total(m0, m1, m2, n);
    if (raw <= room) {
        return 1000;
    }
    return @divTrunc(raw * 1000 + room - 1, room);
}

// How many phrases the reel speaks: the three when they fit at TEMPO_MAX, else the title and goal.
pub fn phrases_for(m0: i32, m1: i32, m2: i32) -> usize {
    if (tempo_for(m0, m1, m2, PHRASES) <= TEMPO_MAX_PERMILLE) {
        return PHRASES;
    }
    return 2;
}

pub fn tempo(m0: i32, m1: i32, m2: i32) -> i32 {
    return tempo_for(m0, m1, m2, phrases_for(m0, m1, m2));
}

// Whether the reel can be made at all: its phrases fit at a tempo the ear still takes.
pub fn voice_fits(m0: i32, m1: i32, m2: i32) -> bool {
    return m0 > 0 && m1 > 0 && m2 > 0 && tempo(m0, m1, m2) <= TEMPO_MAX_PERMILLE;
}

// How long phrase p plays after the tempo (rounded down, so the sum stays inside the room).
pub fn played(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    return @divTrunc(ms_of(m0, m1, m2, p) * 1000, tempo(m0, m1, m2));
}

pub fn phrase_start(m0: i32, m1: i32, m2: i32, p: usize) -> i32 {
    var t : i32 = VOICE_OFFSET_MS;
    var q : usize = 0;
    while (q < p) {
        t = t + played(m0, m1, m2, q) + PHRASE_GAP_MS;
        q = q + 1;
    }
    return t;
}

// ---- the caption chunks: whole words up to CHUNK_CHARS letters; a longer word is cut ----
pub const CHUNK_CHARS : usize = 14;
pub const SPACE : u32 = 32;

fn word_end(i: usize, s: usize) -> usize {
    var k : usize = s;
    while (k < item_len(i) && cp(i, k) != SPACE) {
        k = k + 1;
    }
    return k;
}

// The end (exclusive) of the chunk of item i that starts at s.
pub fn chunk_end(i: usize, s: usize) -> usize {
    const n = item_len(i);
    var e : usize = word_end(i, s);
    if (e - s > CHUNK_CHARS) {
        return s + CHUNK_CHARS;
    }
    var going : bool = true;
    while (going && e < n) {
        const e2 = word_end(i, e + 1);
        if (e2 - s > CHUNK_CHARS) {
            going = false;
        } else {
            e = e2;
        }
    }
    return e;
}

// Where the next chunk starts after one ending at e: past the space, if there is one.
pub fn after(i: usize, e: usize) -> usize {
    if (e < item_len(i) && cp(i, e) == SPACE) {
        return e + 1;
    }
    return e;
}

pub fn chunks(i: usize) -> usize {
    var s : usize = 0;
    var n : usize = 0;
    while (s < item_len(i)) {
        s = after(i, chunk_end(i, s));
        n = n + 1;
    }
    return n;
}

pub fn chunk_start(i: usize, c: usize) -> usize {
    var s : usize = 0;
    var n : usize = 0;
    while (n < c) {
        s = after(i, chunk_end(i, s));
        n = n + 1;
    }
    return s;
}

pub fn chunk_chars(i: usize, c: usize) -> usize {
    const s = chunk_start(i, c);
    return chunk_end(i, s) - s;
}

fn phrase_item(t: usize, lang: usize, p: usize) -> usize {
    return item(t, lang, p);
}

// When chunk c of phrase p comes: its phrase's start plus its share of the phrase's letters.
pub fn chunk_from(t: usize, lang: usize, m0: i32, m1: i32, m2: i32, p: usize, c: usize) -> i32 {
    const i = phrase_item(t, lang, p);
    const share = @as(i32, @intCast(chunk_start(i, c))) * played(m0, m1, m2, p);
    return phrase_start(m0, m1, m2, p) + @divTrunc(share, @as(i32, @intCast(item_len(i))));
}

// It goes when the next chunk comes; the phrase's last one stays the tail after the voice, but
// never into the next phrase.
pub fn chunk_until(t: usize, lang: usize, m0: i32, m1: i32, m2: i32, p: usize, c: usize) -> i32 {
    const i = phrase_item(t, lang, p);
    if (c + 1 < chunks(i)) {
        return chunk_from(t, lang, m0, m1, m2, p, c + 1);
    }
    var u : i32 = phrase_start(m0, m1, m2, p) + played(m0, m1, m2, p) + CAPTION_TAIL_MS;
    if (p + 1 < phrases_for(m0, m1, m2)) {
        const nx = phrase_start(m0, m1, m2, p + 1);
        if (nx < u) {
            u = nx;
        }
    }
    return u;
}

pub fn cta_from(t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> i32 {
    const n = phrases_for(m0, m1, m2);
    return chunk_until(t, lang, m0, m1, m2, n - 1, chunks(phrase_item(t, lang, n - 1)) - 1);
}

// ---- the text files ----
// 0 the lesson tag, 1 the course tag, 2 the cards' label, 3..8 the cards' code lines (card c's two
// at 3 + 2c), 9 the page under the address, then the caption chunks, phrase by phrase.
pub const F_TAG_LESSON : usize = 0;
pub const F_TAG_COURSE : usize = 1;
pub const F_CARD_LABEL : usize = 2;
pub const F_CARD0 : usize = 3;
pub const F_PAGE : usize = 9;
pub const F_CHUNK0 : usize = 10;

pub fn chunk_file(t: usize, lang: usize, p: usize, c: usize) -> usize {
    var f : usize = F_CHUNK0;
    var q : usize = 0;
    while (q < p) {
        f = f + chunks(phrase_item(t, lang, q));
        q = q + 1;
    }
    return f + c;
}

pub fn files(t: usize, lang: usize) -> usize {
    return chunk_file(t, lang, PHRASES, 0);
}

// The lines the cards may show: the lesson's code less a closing brace alone on its last line.
pub fn shown_lines(t: usize) -> usize {
    const n = code_lines(t);
    const last = code_line0(t) + n - 1;
    if (line_len(last) == 1 && code_byte(last, 0) == 125) {
        return n - 1;
    }
    return n;
}

// The cards walk down the lesson's spec: card c shows two lines from c (n - 2) / 2 on.
pub fn card_code_line(t: usize, c: usize, j: usize) -> usize {
    const n = shown_lines(t);
    return code_line0(t) + @divTrunc(c * (n - 2), 2) + j;
}

// The upper case the tags are set in: Latin, Cyrillic a..ya, and yo.
pub fn up(c: u32) -> u32 {
    if (c >= 97 && c <= 122) {
        return c - 32;
    }
    if (c >= 1072 && c <= 1103) {
        return c - 32;
    }
    if (c == 1105) {
        return 1025;
    }
    return c;
}

// One code point as UTF-8: every letter here is below U+0800, so one or two bytes.
fn print_cp(c: u32) -> void {
    if (c < 128) {
        std.debug.print("{c}", .{@as(u8, @intCast(c))});
    } else {
        std.debug.print("{c}{c}", .{ @as(u8, @intCast(192 + @divTrunc(c, 64))), @as(u8, @intCast(128 + @mod(c, 64))) });
    }
}

fn print_span(i: usize, s: usize, e: usize, upper: bool) -> void {
    var k : usize = s;
    while (k < e) {
        if (upper) {
            print_cp(up(cp(i, k)));
        } else {
            print_cp(cp(i, k));
        }
        k = k + 1;
    }
}

// The length a hole "{0}" or "{1}" fills with in "Lesson {0} of {1}", and the letters as written.
fn hole_value(t: usize, h: u32) -> usize {
    if (h == 48) {
        return lesson_n(t);
    }
    return TOPICS;
}

fn digits(v: usize) -> usize {
    if (v >= 10) {
        return 2;
    }
    return 1;
}

fn is_hole(i: usize, k: usize) -> bool {
    return k + 2 < item_len(i) && cp(i, k) == 123 && cp(i, k + 2) == 125;
}

pub fn lesson_tag_chars(t: usize, lang: usize) -> usize {
    const i = lesson_of_item(lang);
    var n : usize = 0;
    var k : usize = 0;
    while (k < item_len(i)) {
        if (is_hole(i, k)) {
            n = n + digits(hole_value(t, cp(i, k + 1)));
            k = k + 3;
        } else {
            n = n + 1;
            k = k + 1;
        }
    }
    return n;
}

fn print_lesson_tag(t: usize, lang: usize) -> void {
    const i = lesson_of_item(lang);
    var k : usize = 0;
    while (k < item_len(i)) {
        if (is_hole(i, k)) {
            std.debug.print("{d}", .{hole_value(t, cp(i, k + 1))});
            k = k + 3;
        } else {
            print_cp(up(cp(i, k)));
            k = k + 1;
        }
    }
}

fn print_code_line(l: usize) -> void {
    var k : usize = 0;
    while (k < line_len(l)) {
        std.debug.print("{c}", .{code_byte(l, k)});
        k = k + 1;
    }
}

pub fn print_file(t: usize, lang: usize, f: usize) -> void {
    if (f == F_TAG_LESSON) {
        print_lesson_tag(t, lang);
    } else if (f == F_TAG_COURSE) {
        const i = course_title_item(lang);
        print_span(i, 0, item_len(i), true);
    } else if (f == F_CARD_LABEL) {
        print_span(id_item(t), 0, item_len(id_item(t)), false);
        std.debug.print(".t27", .{});
    } else if (f < F_PAGE) {
        print_code_line(card_code_line(t, @divTrunc(f - F_CARD0, 2), @mod(f - F_CARD0, 2)));
    } else if (f == F_PAGE) {
        std.debug.print("/learn/", .{});
        print_span(id_item(t), 0, item_len(id_item(t)), false);
        std.debug.print("/", .{});
    } else {
        var p : usize = 0;
        var c : usize = f - F_CHUNK0;
        while (p + 1 < PHRASES && c >= chunks(phrase_item(t, lang, p))) {
            c = c - chunks(phrase_item(t, lang, p));
            p = p + 1;
        }
        const i = phrase_item(t, lang, p);
        const s = chunk_start(i, c);
        print_span(i, s, chunk_end(i, s), false);
    }
}

// ---- the layout ----

// The px a run of n letters takes at a font size, at the mono face's advance.
pub fn run_px(n: usize, font: i32) -> i32 {
    return @divTrunc(@as(i32, @intCast(n)) * font * MONO_ADVANCE_PERMILLE, 1000);
}

// The tags: the gold shot number, a grey slash, then the text, which starts five letters in.
pub const TAG_TEXT_AT : usize = 5;

pub fn tag_file(s: usize) -> usize {
    return @mod(s, 2);
}

pub fn tag_chars(t: usize, lang: usize, f: usize) -> usize {
    if (f == F_TAG_LESSON) {
        return lesson_tag_chars(t, lang);
    }
    return item_len(course_title_item(lang));
}

// The cards: the label at 3/4 of the card's code size, the two code lines fitted to the card.
pub fn label_font(o: usize) -> i32 {
    return @as(i32, @intFromFloat(@floor(0.75 * card_f(o, 5) + 0.5)));
}

pub fn code_font(o: usize, n: usize) -> i32 {
    const room = @as(i32, @intFromFloat(card_f(o, 2) - 2.0 * CARD_PAD));
    const fit = @divTrunc(room * 1000, @as(i32, @intCast(n)) * MONO_ADVANCE_PERMILLE);
    const most = @as(i32, @intFromFloat(card_f(o, 5)));
    if (fit < most) {
        return fit;
    }
    return most;
}

pub const CODE_FONT_MIN : i32 = 12;

// The call to action: "t27.ai" in gold, lifted a little in the band, and the lesson's page under
// it in grey.
pub const CTA_TEXT : str = "t27.ai";
pub const CTA_CHARS : usize = 6;
pub const CTA_FONT : i32 = 100;
pub const CTA_LIFT : i32 = 20;
pub const PAGE_FONT : i32 = 40;
pub const PAGE_GAP : i32 = 8;

pub fn cta_y(o: usize) -> i32 {
    return caption_y(o) - CTA_LIFT;
}

pub fn page_top(o: usize) -> i32 {
    return cta_y(o) + @divTrunc(CTA_FONT, 2) + PAGE_GAP;
}

pub fn page_chars(t: usize) -> usize {
    return item_len(id_item(t)) + 8;
}

// ---- the graph ----

// With beats (f0, f1 the crossfades' first frames) a tag is shown on its kept pieces and slides in
// from the first of them; one with no piece is not printed.
fn print_tag(o: usize, s: usize, dx: i32, row: usize, f: usize, lang: usize, beats: bool, f0: i32, f1: i32) -> void {
    var a : i32 = SHOT_START[s];
    const b = SHOT_START[s + 1] - 1;
    if (beats) {
        if (beat_pieces(a, b, f0, f1) == 0) {
            return;
        }
        a = beat_first_lo(a, b, f0, f1);
    }
    if (f == 99) {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:text='{d:0>2}':fontsize={d}:fontcolor=", .{ FONT, s + 1, TAG_FONT[o] });
    } else if (f == 98) {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:text='/':fontsize={d}:fontcolor=", .{ FONT, TAG_FONT[o] });
    } else {
        std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), f, TAG_FONT[o] });
    }
    print_col(row);
    std.debug.print(":x='{d}+{d}*pow(1-clip((n-{d})/{d},0,1),3)':y={d}:alpha='clip((n-{d})/{d},0,1)'", .{ TAG_X[o] + dx, TAG_SLIDE_PX, a, TAG_SLIDE_F, TAG_Y[o], a, TAG_SLIDE_F });
    if (beats) {
        print_pieces(SHOT_START[s], b, f0, f1);
    } else {
        std.debug.print(":enable='between(n,{d},{d})'", .{ a, b });
    }
}

// Card c's window on the reel's frames: token_floor_mux's CARD_ON, its last frame inside the reel.
pub fn card_lo(c: usize) -> i32 {
    return CARD_ON[2 * c];
}

pub fn card_hi(c: usize) -> i32 {
    return beat_min(CARD_ON[2 * c + 1], beat_frames() - 1);
}

// A card text's rise and fade. Without beats, token_floor_mux's own (print_rise, print_fade). With
// beats the card rises from the first frame of its first kept piece, fades out on the last frame
// of its last, and is on only on its pieces (t27#10628).
fn print_card_on(o: usize, c: usize, dy: f64, beats: bool, f0: i32, f1: i32) -> void {
    if (beats) {
        const lo = card_lo(c);
        const hi = card_hi(c);
        print_rise_from(o, beat_first_lo(lo, hi, f0, f1), dy);
    } else {
        print_rise(o, c, dy);
    }
}

fn print_card_off(c: usize, beats: bool, f0: i32, f1: i32) -> void {
    if (beats) {
        const lo = card_lo(c);
        const hi = card_hi(c);
        print_alpha(beat_first_lo(lo, hi, f0, f1), beat_last_hi(lo, hi, f0, f1));
        print_pieces(lo, hi, f0, f1);
    } else {
        print_fade(c);
    }
}

fn print_card_text(o: usize, c: usize, lang: usize, f: usize, font: i32, row: usize, dy: f64, beats: bool, f0: i32, f1: i32) -> void {
    std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), f, font });
    print_col(row);
    std.debug.print(":x={d:.1}", .{card_f(o, 0) + CARD_PAD});
    print_card_on(o, c, dy, beats, f0, f1);
    std.debug.print("'", .{});
    print_card_off(c, beats, f0, f1);
}

// With beats a card with no kept piece is not printed, as a tag or a caption is not.
fn print_card(o: usize, c: usize, t: usize, lang: usize, beats: bool, f0: i32, f1: i32) -> void {
    if (beats && beat_pieces(card_lo(c), card_hi(c), f0, f1) == 0) {
        return;
    }
    print_card_text(o, c, lang, F_CARD_LABEL, label_font(o), GREY_ROW, CARD_LY[o * 3], beats, f0, f1);
    var j : usize = 0;
    while (j < 2) {
        const font = code_font(o, line_len(card_code_line(t, c, j)));
        var row : usize = WHITE_ROW;
        if (j == 1) {
            row = GOLD_ROW;
        }
        print_card_text(o, c, lang, F_CARD0 + 2 * c + j, font, row, CARD_LY[o * 3 + 1 + j], beats, f0, f1);
        j = j + 1;
    }
    std.debug.print(",drawtext=fontfile={s}:text='PASS':fontsize={d}:fontcolor=0x000000:x={d:.1}", .{ FONT, PASS_FONT[o], pill_x(o) + PASS_DX });
    print_card_on(o, c, pill_dy(o) + 0.5 * PILL_H, beats, f0, f1);
    std.debug.print("-text_h/2'", .{});
    print_card_off(c, beats, f0, f1);
}

// The address and its page from ms a to the end. With beats they fade in from the first frame of
// their first kept piece and are on only on the pieces.
fn print_cta(o: usize, t: usize, lang: usize, a: i32, beats: bool, f0: i32, f1: i32) -> void {
    const lo = beat_frame_from(a);
    const hi = beat_frames() - 1;
    var at : i32 = a;
    if (beats) {
        if (beat_pieces(lo, hi, f0, f1) == 0) {
            return;
        }
        at = beat_frame_ms(beat_first_lo(lo, hi, f0, f1));
    }
    std.debug.print(",drawtext=fontfile={s}:text='{s}':fontsize={d}:fontcolor=", .{ FONT, CTA_TEXT, CTA_FONT });
    print_col(GOLD_ROW);
    std.debug.print(":borderw={d}:bordercolor=0x000000:shadowx=0:shadowy={d}:shadowcolor=0x000000@0.6:x={d}+({d}-text_w)/2:y={d}-text_h/2:alpha='clip((t-{d}.{d:0>3})/0.{d:0>3},0,1)'", .{ CAPTION_BORDER_PX, CAPTION_SHADOW_Y_PX, band_x(o), band_w(o), cta_y(o), secs(at), millis(at), millis(TF_CTA_FADE_MS) });
    print_cta_enable(a, beats, lo, hi, f0, f1);
    std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), F_PAGE, PAGE_FONT });
    print_col(GREY_ROW);
    std.debug.print(":x={d}+({d}-text_w)/2:y={d}:alpha='clip((t-{d}.{d:0>3})/0.{d:0>3},0,1)'", .{ band_x(o), band_w(o), page_top(o), secs(at), millis(at), millis(TF_CTA_FADE_MS) });
    print_cta_enable(a, beats, lo, hi, f0, f1);
}

fn print_cta_enable(a: i32, beats: bool, lo: i32, hi: i32, f0: i32, f1: i32) -> void {
    if (beats) {
        print_pieces(lo, hi, f0, f1);
    } else {
        std.debug.print(":enable='gte(t,{d}.{d:0>3})'", .{ secs(a), millis(a) });
    }
}

// With beats the picture is the beat chain over inputs 0..2 instead of input 0, and the voice and
// music inputs follow the three clips (beat_voice_input, beat_music_input).
pub fn graph(o: usize, t: usize, lang: usize, m0: i32, m1: i32, m2: i32, beats: bool) -> void {
    if (beats) {
        beat_chain(t, lang, m0, m1, m2);
        std.debug.print(",format=yuv420p", .{});
    } else {
        std.debug.print("[0:v]format=yuv420p", .{});
    }
    const adv = @divTrunc(TAG_FONT[o] * MONO_ADVANCE_PERMILLE, 1000);
    var f0 : i32 = 0;
    var f1 : i32 = 0;
    if (beats) {
        f0 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 0));
        f1 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 1));
    }
    var s : usize = 0;
    while (s < SHOTS) {
        print_tag(o, s, 0, GOLD_ROW, 99, lang, beats, f0, f1);
        print_tag(o, s, 3 * adv, GREY_ROW, 98, lang, beats, f0, f1);
        print_tag(o, s, @as(i32, @intCast(TAG_TEXT_AT)) * adv, GREY_ROW, tag_file(s), lang, beats, f0, f1);
        s = s + 1;
    }
    var c : usize = 0;
    while (c < CARDS) {
        print_card(o, c, t, lang, beats, f0, f1);
        c = c + 1;
    }
    const n = phrases_for(m0, m1, m2);
    var p : usize = 0;
    while (p < n) {
        const i = phrase_item(t, lang, p);
        var k : usize = 0;
        while (k < chunks(i)) {
            const a = chunk_from(t, lang, m0, m1, m2, p, k);
            const b = chunk_until(t, lang, m0, m1, m2, p, k);
            const fa = beat_frame_from(a);
            const fb = beat_frame_until(b);
            if (beats == false || beat_pieces(fa, fb, f0, f1) > 0) {
                std.debug.print(",drawtext=fontfile={s}:expansion=none:textfile={s}/{s}/f{d:0>2}.txt:fontsize={d}:fontcolor=", .{ FONT, FILE_DIR, lang_dir(lang), chunk_file(t, lang, p, k), band_font(o, @as(i32, @intCast(chunk_chars(i, k)))) });
                print_col(GOLD_ROW);
                std.debug.print(":borderw={d}:bordercolor=0x000000:shadowx=0:shadowy={d}:shadowcolor=0x000000@0.6:x={d}:y={d}-text_h/2", .{ CAPTION_BORDER_PX, CAPTION_SHADOW_Y_PX, band_x(o), caption_y(o) });
                if (beats) {
                    print_pieces(fa, fb, f0, f1);
                } else {
                    std.debug.print(":enable='between(t,{d}.{d:0>3},{d}.{d:0>3})'", .{ secs(a), millis(a), secs(b), millis(b) });
                }
            }
            k = k + 1;
        }
        p = p + 1;
    }
    print_cta(o, t, lang, cta_from(t, lang, m0, m1, m2), beats, f0, f1);
    std.debug.print("[v];", .{});
    const tp = tempo(m0, m1, m2);
    p = 0;
    while (p < n) {
        const at = phrase_start(m0, m1, m2, p);
        std.debug.print("[{d}:a]aresample=48000,atempo={d}.{d:0>3},pan=stereo|c0=c0|c1=c0,adelay={d}|{d}[p{d}];", .{ beat_voice_input(beats, p), secs(tp), millis(tp), at, at, p });
        p = p + 1;
    }
    p = 0;
    while (p < n) {
        std.debug.print("[p{d}]", .{p});
        p = p + 1;
    }
    std.debug.print("amix=inputs={d}:normalize=0:duration=longest,loudnorm=I={d}:TP=-1.5:LRA={d},aresample=48000,apad=whole_dur={d}[vo];", .{ n, VOICE_LUFS, VOICE_LRA, secs(REEL_MS) });
    std.debug.print("[{d}:a]atrim=0:{d},volume=0.{d:0>3},afade=t=in:d=0.{d:0>3},afade=t=out:st={d}.{d:0>3}:d={d}.{d:0>3}[mu];", .{ beat_music_input(beats), secs(REEL_MS), millis(MUSIC_VOLUME_PERMILLE), millis(MUSIC_FADE_IN_MS), secs(MUSIC_FADE_OUT_START_MS), millis(MUSIC_FADE_OUT_START_MS), secs(MUSIC_FADE_OUT_MS), millis(MUSIC_FADE_OUT_MS) });
    std.debug.print("[vo][mu]amix=inputs=2:normalize=0:duration=first,alimiter=limit=0.{d:0>3}[a]\n", .{millis(LIMIT_PERMILLE)});
}

// ---- the beat clock ----
// Which of the reel's three beats is on screen at ms x, and how much of each when two crossfade.
// The middle beat's weight is computed on its own, not as the rest of 1000, so the test that the
// three sum to 1000 can fail: it fails when two crossfades overlap.

pub const BEAT_OPEN : usize = 0;
pub const BEAT_MAIN : usize = 1;
pub const BEAT_CLOSE : usize = 2;

// The crossfade and the shortest time a beat is alone on screen, in ms: reel.t27's frame counts
// at its frame rate, which the first beat test checks.
pub const BEAT_XFADE_MS : i32 = 500;
pub const BEAT_HALF_MS : i32 = 250;
pub const BEAT_MIN_SOLO_MS : i32 = 1000;
// The earliest cut 0 may fall: the open beat alone for BEAT_MIN_SOLO_MS, then half the crossfade.
pub const BEAT_OPEN_FLOOR_MS : i32 = 1250;

// The time of base frame f, and how many base frames the reel has.
pub fn beat_frame_ms(f: i32) -> i32 {
    return @divTrunc(f * 1000, BASE_FPS);
}

pub fn beat_frames() -> i32 {
    return @divTrunc(REEL_MS * BASE_FPS, 1000);
}

// The shortest time from the reel's start to the address that leaves every beat a scene of its own:
// the open floor, a crossfade, and the main beat alone for BEAT_MIN_SOLO_MS.
pub const BEAT_SPOKEN_MIN_MS : i32 = 2750;

// The latest cut 1 that still leaves the close beat's own frames REEL_CTA_MIN_MS to the reel's end
// (t27#10629): its crossfade starts on frame 389, so the close beat owns frames 405..449, 45 frames,
// 1500 ms. Mode 5 shows the address on those frames only, so a later cut holds it for less.
pub const BEAT_CUT1_LAST_MS : i32 = 13249;

// Cut k of lesson t's reel in language lang: 0 open to main, 1 main to close. Cut 0 is the goal's
// start, held to the open floor, but never so late that the main beat loses its scene: when the
// voice reaches the address before BEAT_SPOKEN_MIN_MS the open beat gives way, not the main one.
// Cut 1 is where the address takes over, but never after BEAT_CUT1_LAST_MS: on a voice the reel
// had to speed up the close beat comes in early, so the address keeps its hold in mode 5.
pub fn beat_cut_ms(t: usize, lang: usize, m0: i32, m1: i32, m2: i32, k: usize) -> i32 {
    var c1 : i32 = cta_from(t, lang, m0, m1, m2);
    if (c1 > BEAT_CUT1_LAST_MS) {
        c1 = BEAT_CUT1_LAST_MS;
    }
    if (k == 0) {
        var s : i32 = phrase_start(m0, m1, m2, 1);
        if (s < BEAT_OPEN_FLOOR_MS) {
            s = BEAT_OPEN_FLOOR_MS;
        }
        const last = c1 - BEAT_XFADE_MS - BEAT_MIN_SOLO_MS;
        if (s > last) {
            s = last;
        }
        return s;
    }
    return c1;
}

// How far the incoming beat has faded in at ms x for a cut at c, per mille.
pub fn beat_ramp(x: i32, c: i32) -> i32 {
    const a = c - BEAT_HALF_MS;
    if (x <= a) {
        return 0;
    }
    if (x >= a + BEAT_XFADE_MS) {
        return 1000;
    }
    return @divTrunc((x - a) * 1000, BEAT_XFADE_MS);
}

fn beat_min(a: i32, b: i32) -> i32 {
    if (a < b) {
        return a;
    }
    return b;
}

// Beat b's weight at ms x, per mille, for cuts c0 and c1.
pub fn beat_weight(b: usize, x: i32, c0: i32, c1: i32) -> i32 {
    if (b == BEAT_OPEN) {
        return 1000 - beat_ramp(x, c0);
    }
    if (b == BEAT_MAIN) {
        return beat_min(beat_ramp(x, c0), 1000 - beat_ramp(x, c1));
    }
    return beat_ramp(x, c1);
}

// The beat a still at ms x shows: the one after the last cut reached. At a cut both weigh 500 and
// the incoming beat wins.
pub fn beat_at(x: i32, c0: i32, c1: i32) -> usize {
    if (x < c0) {
        return BEAT_OPEN;
    }
    if (x < c1) {
        return BEAT_MAIN;
    }
    return BEAT_CLOSE;
}

// How long beat b is alone on screen (weight 1000), in ms.
pub fn beat_solo_ms(b: usize, c0: i32, c1: i32) -> i32 {
    if (b == BEAT_OPEN) {
        return c0 - BEAT_HALF_MS;
    }
    if (b == BEAT_MAIN) {
        return c1 - c0 - BEAT_XFADE_MS;
    }
    return REEL_MS - c1 - BEAT_HALF_MS;
}

// ---- the beat graph ----
// The clock's cuts are in ms and fall between frames. A crossfade starts on a frame, so each cut
// takes the last base frame at or before c - BEAT_HALF_MS; both cuts move the same way, so neither
// can take a frame from the other's beat.

// The base frame where the crossfade for a cut at ms c starts.
pub fn beat_xfade_frame(c: i32) -> i32 {
    return @divTrunc((c - BEAT_HALF_MS) * BASE_FPS, 1000);
}

// How many base frames beat b shows alone, for crossfades starting at frames f0 and f1. The frame a
// crossfade starts on is still the outgoing beat whole; it is counted to neither, so this is a floor.
pub fn beat_solo_frames(b: usize, f0: i32, f1: i32) -> i32 {
    if (b == BEAT_OPEN) {
        return f0;
    }
    if (b == BEAT_MAIN) {
        return f1 - f0 - TRANSITION_FRAMES;
    }
    return beat_frames() - f1 - TRANSITION_FRAMES;
}

// The ffmpeg graph that crossfades the three scene clips, inputs 0 open, 1 main, 2 close, at the
// clock's cuts and trims the result to the reel. Each clip starts at its own frame 0 when its beat
// comes in. xfade starts on the first frame whose time is at or after its offset, so the offset is
// beat_frame_ms(f), which never runs past frame f (the offset test); the timebase is AV_TIME_BASE
// so the offset is not rounded again.
pub fn beat_graph(t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> void {
    beat_chain(t, lang, m0, m1, m2);
    std.debug.print("[v]\n", .{});
}

// The beat graph without its output label, so mode 5 can go on filtering the same stream.
pub fn beat_chain(t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> void {
    var b : usize = 0;
    while (b < 3) {
        std.debug.print("[{d}:v]fps={d},settb=AVTB,format=yuv420p[b{d}];", .{ b, BASE_FPS, b });
        b = b + 1;
    }
    const d = beat_frame_ms(TRANSITION_FRAMES);
    const a0 = beat_frame_ms(beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 0)));
    const a1 = beat_frame_ms(beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 1)));
    std.debug.print("[b0][b1]xfade=transition=fade:duration={d}.{d:0>3}:offset={d}.{d:0>3}[x0];", .{ secs(d), millis(d), secs(a0), millis(a0) });
    std.debug.print("[x0][b2]xfade=transition=fade:duration={d}.{d:0>3}:offset={d}.{d:0>3},trim=end_frame={d},setpts=PTS-STARTPTS", .{ secs(d), millis(d), secs(a1), millis(a1), beat_frames() });
}

// The graph's inputs: the picture first (one frame stream, or with beats the three scene clips),
// then one wav per phrase, then the music.
pub fn beat_video_inputs(beats: bool) -> usize {
    if (beats) {
        return 3;
    }
    return 1;
}

pub fn beat_voice_input(beats: bool, p: usize) -> usize {
    return beat_video_inputs(beats) + p;
}

pub fn beat_music_input(beats: bool) -> usize {
    return beat_video_inputs(beats) + PHRASES;
}

// ---- the overlay's windows (t27#10614) ----
// Crossfade k covers base frames f_k .. f_k + TRANSITION_FRAMES, f_k = beat_xfade_frame(cut k).
// Its first and last frames are the outgoing and the incoming beat whole but for under a ms of
// fade, and both count as crossfade. Beat b's own frames are the rest. In mode 5 an overlay over
// frames lo..hi is on only where that window meets a beat's own frames, one piece per beat. A
// piece shorter than BEAT_OVERLAY_MIN_FRAMES is dropped, not squeezed, unless it is the whole
// overlay: text on for less than a crossfade reads as a flash, and an overlay that was that short
// in mode 3 stays as it was.
pub const BEAT_OVERLAY_MIN_FRAMES : i32 = 15;

// The first and the last frame of beat b's own frames, for crossfades starting at f0 and f1.
pub fn beat_scene_lo(b: usize, f0: i32, f1: i32) -> i32 {
    if (b == BEAT_OPEN) {
        return 0;
    }
    if (b == BEAT_MAIN) {
        return f0 + TRANSITION_FRAMES + 1;
    }
    return f1 + TRANSITION_FRAMES + 1;
}

pub fn beat_scene_hi(b: usize, f0: i32, f1: i32) -> i32 {
    if (b == BEAT_OPEN) {
        return f0 - 1;
    }
    if (b == BEAT_MAIN) {
        return f1 - 1;
    }
    return beat_frames() - 1;
}

// The frames between(t, a, b) shows, a and b in ms: the first at or after a, the last at or before b.
pub fn beat_frame_from(a: i32) -> i32 {
    return @divTrunc(a * BASE_FPS + 999, 1000);
}

pub fn beat_frame_until(b: i32) -> i32 {
    return @divTrunc(b * BASE_FPS, 1000);
}

fn beat_max(a: i32, b: i32) -> i32 {
    if (a > b) {
        return a;
    }
    return b;
}

// Overlay lo..hi's piece in beat b, and whether it is kept.
pub fn beat_piece_lo(lo: i32, b: usize, f0: i32, f1: i32) -> i32 {
    return beat_max(lo, beat_scene_lo(b, f0, f1));
}

pub fn beat_piece_hi(hi: i32, b: usize, f0: i32, f1: i32) -> i32 {
    return beat_min(hi, beat_scene_hi(b, f0, f1));
}

pub fn beat_piece_kept(lo: i32, hi: i32, b: usize, f0: i32, f1: i32) -> bool {
    const n = beat_piece_hi(hi, b, f0, f1) - beat_piece_lo(lo, b, f0, f1) + 1;
    if (n <= 0) {
        return false;
    }
    return n >= BEAT_OVERLAY_MIN_FRAMES || n == hi - lo + 1;
}

// How many pieces of overlay lo..hi are kept; none means mode 5 drops it.
pub fn beat_pieces(lo: i32, hi: i32, f0: i32, f1: i32) -> usize {
    var k : usize = 0;
    var b : usize = 0;
    while (b < 3) {
        if (beat_piece_kept(lo, hi, b, f0, f1)) {
            k = k + 1;
        }
        b = b + 1;
    }
    return k;
}

// The first frame of the first kept piece, where an overlay's own fade or slide starts in mode 5;
// lo when none is kept.
pub fn beat_first_lo(lo: i32, hi: i32, f0: i32, f1: i32) -> i32 {
    var b : usize = 0;
    while (b < 3) {
        if (beat_piece_kept(lo, hi, b, f0, f1)) {
            return beat_piece_lo(lo, b, f0, f1);
        }
        b = b + 1;
    }
    return lo;
}

// The last frame of the last kept piece, where a card's fade out ends in mode 5; hi when none is
// kept.
pub fn beat_last_hi(lo: i32, hi: i32, f0: i32, f1: i32) -> i32 {
    var b : usize = 3;
    while (b > 0) {
        b = b - 1;
        if (beat_piece_kept(lo, hi, b, f0, f1)) {
            return beat_piece_hi(hi, b, f0, f1);
        }
    }
    return hi;
}

// Mode 5's enable= for overlay lo..hi: exactly its kept pieces' frames.
fn print_pieces(lo: i32, hi: i32, f0: i32, f1: i32) -> void {
    std.debug.print(":enable='", .{});
    var first : bool = true;
    var b : usize = 0;
    while (b < 3) {
        if (beat_piece_kept(lo, hi, b, f0, f1)) {
            if (first == false) {
                std.debug.print("+", .{});
            }
            std.debug.print("between(n,{d},{d})", .{ beat_piece_lo(lo, b, f0, f1), beat_piece_hi(hi, b, f0, f1) });
            first = false;
        }
        b = b + 1;
    }
    std.debug.print("'", .{});
}

// ---- main ----

// The environment variable `name` as a number of up to six digits; dflt when unset. Only main
// calls this, so the tests, which never link libc, do not reach getenv.
fn env_num(name: [*:0]const u8, dflt: i32) -> i32 {
    const p = std.c.getenv(name);
    if (p == null) {
        return dflt;
    }
    const s = p.?;
    var v : i32 = 0;
    var i : usize = 0;
    while (i < 6 && s[i] >= 48 && s[i] <= 57) {
        v = v * 10 + @as(i32, @intCast(s[i] - 48));
        i = i + 1;
    }
    if (i == 0) {
        return dflt;
    }
    return v;
}

pub fn main() -> void {
    var t : usize = @as(usize, @intCast(env_num("LR_T", 0)));
    if (t >= TOPICS) {
        t = 0;
    }
    var lang : usize = @as(usize, @intCast(env_num("LR_LANG", 0)));
    if (lang > 1) {
        lang = 0;
    }
    const mode = env_num("LR_MODE", 2);
    const k = @as(usize, @intCast(env_num("LR_K", 0)));
    if (mode == 0) {
        var p : usize = k;
        if (p >= PHRASES) {
            p = 0;
        }
        const i = phrase_item(t, lang, p);
        print_span(i, 0, item_len(i), false);
    } else if (mode == 1) {
        if (k < files(t, lang)) {
            print_file(t, lang, k);
        }
    } else if (mode == 3) {
        const m0 = env_num("LR_MS0", 0);
        const m1 = env_num("LR_MS1", 0);
        const m2 = env_num("LR_MS2", 0);
        if (voice_fits(m0, m1, m2)) {
            graph(TALL, t, lang, m0, m1, m2, false);
            graph(WIDE, t, lang, m0, m1, m2, false);
        } else {
            std.debug.print("lesson_reel: the voice does not fit the reel\n", .{});
        }
    } else if (mode == 4) {
        const m0 = env_num("LR_MS0", 0);
        const m1 = env_num("LR_MS1", 0);
        const m2 = env_num("LR_MS2", 0);
        if (voice_fits(m0, m1, m2)) {
            beat_graph(t, lang, m0, m1, m2);
        } else {
            std.debug.print("lesson_reel: the voice does not fit the reel\n", .{});
        }
    } else if (mode == 5) {
        const m0 = env_num("LR_MS0", 0);
        const m1 = env_num("LR_MS1", 0);
        const m2 = env_num("LR_MS2", 0);
        if (voice_fits(m0, m1, m2)) {
            graph(TALL, t, lang, m0, m1, m2, true);
            graph(WIDE, t, lang, m0, m1, m2, true);
        } else {
            std.debug.print("lesson_reel: the voice does not fit the reel\n", .{});
        }
    } else {
        std.debug.print("{d}\n", .{files(t, lang)});
    }
}

// ---- tests ----

// Phrase lengths as the voice service gave them for lesson 1 (2026-10-18 shape, rounded): short,
// a tight fit, and one that only fits without the task.
pub const M_EN0 : i32 = 1300;
pub const M_EN1 : i32 = 4200;
pub const M_EN2 : i32 = 6800;

test "the chunks tile every phrase of every lesson, at spaces, and none is too long to read" {
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var p : usize = 0;
            while (p < PHRASES) {
                const i = phrase_item(t, lang, p);
                var s : usize = 0;
                var c : usize = 0;
                while (s < item_len(i)) {
                    assert(chunk_start(i, c) == s);
                    const e = chunk_end(i, s);
                    assert(e > s);
                    assert(e - s <= CHUNK_CHARS);
                    assert(cp(i, s) != SPACE);
                    s = after(i, e);
                    c = c + 1;
                }
                assert(c == chunks(i));
                assert(s == item_len(i));
                p = p + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
}

test "every caption, tag, card line and page fits its place at a size that reads" {
    var o : usize = 0;
    while (o < 2) {
        const right = @as(i32, @intFromFloat(safe_f(o, 2)));
        assert(band_font(o, @as(i32, @intCast(CHUNK_CHARS))) >= @as(i32, @intFromFloat(REEL_TEXT_MIN_PX)));
        assert(run_px(CHUNK_CHARS, band_font(o, @as(i32, @intCast(CHUNK_CHARS)))) <= band_w(o));
        var t : usize = 0;
        while (t < TOPICS) {
            var lang : usize = 0;
            while (lang < 2) {
                var f : usize = 0;
                while (f < 2) {
                    const end = TAG_X[o] + run_px(TAG_TEXT_AT + tag_chars(t, lang, f), TAG_FONT[o]);
                    if (o == TALL) {
                        assert(end <= right);
                    } else {
                        assert(end <= band_x(o) - 40);
                    }
                    f = f + 1;
                }
                lang = lang + 1;
            }
            const label_end = card_f(o, 0) + CARD_PAD + @as(f64, @floatFromInt(run_px(item_len(id_item(t)) + 4, label_font(o))));
            assert(label_end + 12.0 <= pill_x(o));
            var c : usize = 0;
            while (c < 3) {
                var j : usize = 0;
                while (j < 2) {
                    const l = card_code_line(t, c, j);
                    assert(l < code_line0(t) + code_lines(t));
                    assert(code_font(o, line_len(l)) >= CODE_FONT_MIN);
                    assert(run_px(line_len(l), code_font(o, line_len(l))) <= @as(i32, @intFromFloat(card_f(o, 2) - 2.0 * CARD_PAD)));
                    j = j + 1;
                }
                c = c + 1;
            }
            assert(run_px(page_chars(t), PAGE_FONT) <= band_w(o));
            t = t + 1;
        }
        o = o + 1;
    }
}

test "the address is big enough and the page under it stays on the frame, tall inside the safe rect" {
    assert(@as(f64, @floatFromInt(CTA_FONT)) >= REEL_CTA_MIN_PX);
    assert(@as(f64, @floatFromInt(PAGE_FONT)) >= REEL_TEXT_MIN_PX);
    assert(run_px(CTA_CHARS, CTA_FONT) <= band_w(TALL));
    const x0 = @as(f64, @floatFromInt(band_x(TALL)));
    const y0 = @as(f64, @floatFromInt(cta_y(TALL) - @divTrunc(CTA_FONT, 2)));
    const x1 = x0 + @as(f64, @floatFromInt(band_w(TALL)));
    const y1 = @as(f64, @floatFromInt(page_top(TALL) + PAGE_FONT));
    assert(reel_shows(x0, y0, x1, y1));
    assert(page_top(WIDE) + PAGE_FONT <= frame_h(WIDE));
    // and the address clears the last card, which stays up to the end
    assert(@as(f64, @floatFromInt(cta_y(TALL) - @divTrunc(CTA_FONT, 2))) > card_f(TALL, 1) + card_f(TALL, 3));
}

test "a voice that fits is left as spoken, and one that does not is sped up within the cap" {
    assert(voice_room_ms(3) == 12250);
    assert(tempo_for(1300, 4200, 6000, 3) == 1000);
    assert(phrases_for(1300, 4200, 6000) == 3);
    assert(tempo(M_EN0, M_EN1, M_EN2) == 1005);
    assert(voice_fits(M_EN0, M_EN1, M_EN2));
    // too long for three even at the cap: the task goes, and the title and goal play as spoken
    assert(phrases_for(1500, 5000, 9000) == 2);
    assert(tempo(1500, 5000, 9000) == 1000);
    // two at exactly the cap still play; a little more is refused
    assert(voice_fits(3000, 12000, 1000));
    assert(voice_fits(3000, 13000, 1000) == false);
    assert(voice_fits(0, 4000, 4000) == false);
}

test "the hook clock and the call to action's hold hold for every lesson in both languages" {
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            assert(phrase_start(M_EN0, M_EN1, M_EN2, 0) <= REEL_FIRST_WORD_MS);
            assert(chunk_from(t, lang, M_EN0, M_EN1, M_EN2, 0, 0) <= REEL_HOOK_TEXT_MS);
            assert(cta_from(t, lang, M_EN0, M_EN1, M_EN2) <= REEL_MS - REEL_CTA_MIN_MS);
            assert(cta_from(t, lang, 1500, 5000, 9000) <= REEL_MS - REEL_CTA_MIN_MS);
            // the captions come in order and never overlap
            var p : usize = 0;
            var last : i32 = 0;
            while (p < PHRASES) {
                var c : usize = 0;
                while (c < chunks(phrase_item(t, lang, p))) {
                    const a = chunk_from(t, lang, M_EN0, M_EN1, M_EN2, p, c);
                    const b = chunk_until(t, lang, M_EN0, M_EN1, M_EN2, p, c);
                    assert(a >= last);
                    assert(b > a);
                    last = b;
                    c = c + 1;
                }
                p = p + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
}

test "the files are numbered in order, and the tags read in upper case" {
    assert(F_CARD0 + 2 * CARDS == F_PAGE);
    assert(F_PAGE + 1 == F_CHUNK0);
    assert(files(0, 0) == F_CHUNK0 + chunks(item(0, 0, 0)) + chunks(item(0, 0, 1)) + chunks(item(0, 0, 2)));
    assert(up(97) == 65);
    assert(up(1072) == 1040);
    assert(up(1103) == 1071);
    assert(up(1105) == 1025);
    assert(up(46) == 46);
    // "LESSON 1 OF 27" and "URok 1 iz 27" are 14 and 12 letters
    assert(lesson_tag_chars(0, 0) == 14);
    assert(lesson_tag_chars(0, 1) == 12);
    assert(lesson_tag_chars(26, 0) == 15);
    // lesson 1's cards: lines 0, 2 and 4 of the six it shows (its seventh is the closing brace)
    assert(code_lines(0) == 7);
    assert(shown_lines(0) == 6);
    assert(card_code_line(0, 0, 0) == 0);
    assert(card_code_line(0, 1, 0) == 2);
    assert(card_code_line(0, 2, 1) == 5);
    var t : usize = 0;
    while (t < TOPICS) {
        assert(shown_lines(t) >= 2);
        t = t + 1;
    }
}

// ---- the beat clock's tests ----

// Phrase lengths the grid test sweeps: a title from barely a word to long, a goal from short to
// one the voice rule refuses after a long title (14000), a task from short to one the reel drops
// (13100 after a 200 ms title and a 1500 ms goal leaves the voice at the address by 2700 ms).
pub const BEAT_GRID_M0 : [4]i32 = [200, 700, 1300, 2500];
pub const BEAT_GRID_M1 : [4]i32 = [1500, 4200, 8000, 14000];
pub const BEAT_GRID_M2 : [5]i32 = [800, 4000, 6800, 9000, 13100];

test "the crossfade and the floor are the reel's own frame counts" {
    assert(BEAT_XFADE_MS == beat_frame_ms(TRANSITION_FRAMES));
    assert(BEAT_MIN_SOLO_MS == beat_frame_ms(MIN_SCENE_FRAMES));
    assert(2 * BEAT_HALF_MS == BEAT_XFADE_MS);
    assert(BEAT_OPEN_FLOOR_MS == BEAT_MIN_SOLO_MS + BEAT_HALF_MS);
    assert(beat_frames() == 450);
}

test "on lesson 1's measured voice the cuts fall where the sentence changes" {
    const c0 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 0);
    const c1 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1);
    assert(c0 == phrase_start(M_EN0, M_EN1, M_EN2, 1));
    assert(c0 > BEAT_OPEN_FLOOR_MS);
    // the reel speeds this voice up to the address's floor, so cut 1 is capped (t27#10629)
    assert(cta_from(0, 0, M_EN0, M_EN1, M_EN2) > BEAT_CUT1_LAST_MS);
    assert(c1 == BEAT_CUT1_LAST_MS);
    // the open beat ends after the title is spoken, and the close is at least half in after the task is
    assert(c0 > phrase_start(M_EN0, M_EN1, M_EN2, 0) + played(M_EN0, M_EN1, M_EN2, 0));
    assert(c1 >= phrase_start(M_EN0, M_EN1, M_EN2, 2) + played(M_EN0, M_EN1, M_EN2, 2));
}

test "a title too short to read holds the open beat to the floor" {
    assert(voice_fits(200, 4200, 6800));
    assert(phrase_start(200, 4200, 6800, 1) < BEAT_OPEN_FLOOR_MS);
    const c0 = beat_cut_ms(0, 0, 200, 4200, 6800, 0);
    const c1 = beat_cut_ms(0, 0, 200, 4200, 6800, 1);
    assert(c0 == BEAT_OPEN_FLOOR_MS);
    assert(beat_solo_ms(BEAT_OPEN, c0, c1) == BEAT_MIN_SOLO_MS);
}

test "every beat is alone on screen for a scene's length, every lesson, both languages, every voice on the grid" {
    var checked : usize = 0;
    var early : usize = 0;
    var refused : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            const c0 = beat_cut_ms(t, lang, m0, m1, m2, 0);
                            const c1 = beat_cut_ms(t, lang, m0, m1, m2, 1);
                            // the main and close beats keep their scene on every voice the rule takes
                            assert(beat_solo_ms(BEAT_MAIN, c0, c1) >= BEAT_MIN_SOLO_MS);
                            assert(beat_solo_ms(BEAT_CLOSE, c0, c1) >= BEAT_MIN_SOLO_MS);
                            assert(c0 >= phrase_start(m0, m1, m2, 1) || c1 < BEAT_SPOKEN_MIN_MS);
                            if (c1 >= BEAT_SPOKEN_MIN_MS) {
                                assert(beat_solo_ms(BEAT_OPEN, c0, c1) >= BEAT_MIN_SOLO_MS);
                                checked = checked + 1;
                            } else {
                                // a voice at the address this early cannot give the open beat a scene too
                                assert(beat_solo_ms(BEAT_OPEN, c0, c1) < BEAT_MIN_SOLO_MS);
                                early = early + 1;
                            }
                        } else {
                            refused = refused + 1;
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    // the grid reaches all three outcomes: a full clock, a voice too short for an open scene, and
    // a voice the rule refuses; the short case is one grid point, 200/1500/13100, per lesson
    assert(checked > 0);
    assert(refused > 0);
    assert(early == TOPICS * 2);
    assert(checked + early + refused == TOPICS * 2 * 80);
}

test "the three weights sum to a whole at every 10 ms and each beat fades one way" {
    var sel : usize = 0;
    var seen : [3]usize = [0, 0, 0];
    while (sel < 2) {
        var m0 : i32 = M_EN0;
        if (sel == 1) {
            m0 = 200;
        }
        const c0 = beat_cut_ms(0, 0, m0, M_EN1, M_EN2, 0);
        const c1 = beat_cut_ms(0, 0, m0, M_EN1, M_EN2, 1);
        assert(beat_weight(BEAT_OPEN, c0, c0, c1) == 500);
        assert(beat_weight(BEAT_MAIN, c0, c0, c1) == 500);
        assert(beat_weight(BEAT_MAIN, c1, c0, c1) == 500);
        assert(beat_weight(BEAT_CLOSE, c1, c0, c1) == 500);
        var last0 : i32 = 1000;
        var last2 : i32 = 0;
        var lastb : usize = BEAT_OPEN;
        var x : i32 = 0;
        while (x <= REEL_MS) {
            const w0 = beat_weight(BEAT_OPEN, x, c0, c1);
            const w1 = beat_weight(BEAT_MAIN, x, c0, c1);
            const w2 = beat_weight(BEAT_CLOSE, x, c0, c1);
            assert(w0 + w1 + w2 == 1000);
            assert(w0 <= last0);
            assert(w2 >= last2);
            const b = beat_at(x, c0, c1);
            assert(b >= lastb);
            // the beat a still shows is never the one that has faded out
            assert(beat_weight(b, x, c0, c1) >= 500);
            seen[b] = seen[b] + 1;
            last0 = w0;
            last2 = w2;
            lastb = b;
            x = x + 10;
        }
        sel = sel + 1;
    }
    assert(seen[0] > 0);
    assert(seen[1] > 0);
    assert(seen[2] > 0);
}

test "over the reel's 450 frames the picture changes beat exactly twice" {
    const c0 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 0);
    const c1 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1);
    var changes : usize = 0;
    var last : usize = BEAT_OPEN;
    var f : i32 = 0;
    while (f < beat_frames()) {
        const b = beat_at(beat_frame_ms(f), c0, c1);
        if (b != last) {
            changes = changes + 1;
        }
        last = b;
        f = f + 1;
    }
    assert(changes == 2);
    assert(last == BEAT_CLOSE);
}

test "control: a cut at fixed thirds of the reel lands inside a spoken phrase" {
    const third = @divTrunc(REEL_MS, 3);
    const g0 = phrase_start(M_EN0, M_EN1, M_EN2, 1);
    const g1 = g0 + played(M_EN0, M_EN1, M_EN2, 1);
    const k0 = phrase_start(M_EN0, M_EN1, M_EN2, 2);
    const k1 = k0 + played(M_EN0, M_EN1, M_EN2, 2);
    // the first third falls inside the goal, the second inside the task
    assert(third > g0 && third < g1);
    assert(2 * third > k0 && 2 * third < k1);
    // the voice clock's cuts fall on no spoken word
    const c0 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 0);
    const c1 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1);
    assert(c0 <= g0);
    assert(c1 >= k1);
}

// ---- the beat graph's tests ----

test "a crossfade starts on the last frame at or before half a crossfade ahead of its cut" {
    var c : i32 = BEAT_OPEN_FLOOR_MS;
    var n : usize = 0;
    while (c <= REEL_MS - REEL_CTA_MIN_MS) {
        const f = beat_xfade_frame(c);
        // frame f's time, f * 1000 / BASE_FPS, is at or before c - BEAT_HALF_MS; frame f + 1's is after
        assert(f * 1000 <= (c - BEAT_HALF_MS) * BASE_FPS);
        assert((f + 1) * 1000 > (c - BEAT_HALF_MS) * BASE_FPS);
        n = n + 1;
        c = c + 1;
    }
    assert(n == 12251);
    assert(beat_xfade_frame(BEAT_OPEN_FLOOR_MS) == MIN_SCENE_FRAMES);
}

test "the offset printed for frame f selects frame f and no earlier frame" {
    var f : i32 = 0;
    while (f <= beat_frames()) {
        const a = beat_frame_ms(f) * BASE_FPS;
        assert(a <= f * 1000);
        assert(a > (f - 1) * 1000);
        if (f > 0) {
            assert(beat_frame_ms(f) > beat_frame_ms(f - 1));
        }
        f = f + 1;
    }
}

test "control: an offset rounded up to the next ms misses its frame on two frames in three" {
    var missed : usize = 0;
    var f : i32 = 0;
    while (f <= beat_frames()) {
        const up = @divTrunc(f * 1000 + BASE_FPS - 1, BASE_FPS);
        if (up * BASE_FPS > f * 1000) {
            missed = missed + 1;
        }
        f = f + 1;
    }
    // frames 0..450: the 151 multiples of 3 are on a whole ms, the other 300 are not
    assert(missed == 300);
}

test "on whole frames every beat keeps a scene on every voice the clock gives three" {
    var checked : usize = 0;
    var early : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            const c0 = beat_cut_ms(t, lang, m0, m1, m2, 0);
                            const c1 = beat_cut_ms(t, lang, m0, m1, m2, 1);
                            const f0 = beat_xfade_frame(c0);
                            const f1 = beat_xfade_frame(c1);
                            assert(f0 >= 0);
                            assert(f1 + TRANSITION_FRAMES <= beat_frames());
                            assert(beat_solo_frames(BEAT_MAIN, f0, f1) >= MIN_SCENE_FRAMES);
                            assert(beat_solo_frames(BEAT_CLOSE, f0, f1) >= MIN_SCENE_FRAMES);
                            if (c1 >= BEAT_SPOKEN_MIN_MS) {
                                assert(beat_solo_frames(BEAT_OPEN, f0, f1) >= MIN_SCENE_FRAMES);
                                checked = checked + 1;
                            } else {
                                assert(beat_solo_frames(BEAT_OPEN, f0, f1) < MIN_SCENE_FRAMES);
                                early = early + 1;
                            }
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    assert(checked > 0);
    assert(early == TOPICS * 2);
}

// ---- the overlay's tests ----

test "with and without beats every input from the picture to the music is used exactly once" {
    var layout : usize = 0;
    while (layout < 2) {
        const beats = layout == 1;
        var used : [8]usize = undefined;
        var z : usize = 0;
        while (z < 8) {
            used[z] = 0;
            z = z + 1;
        }
        var v : usize = 0;
        while (v < beat_video_inputs(beats)) {
            used[v] = used[v] + 1;
            v = v + 1;
        }
        var p : usize = 0;
        while (p < PHRASES) {
            used[beat_voice_input(beats, p)] = used[beat_voice_input(beats, p)] + 1;
            p = p + 1;
        }
        used[beat_music_input(beats)] = used[beat_music_input(beats)] + 1;
        var i : usize = 0;
        while (i <= beat_music_input(beats)) {
            assert(used[i] == 1);
            i = i + 1;
        }
        while (i < 8) {
            assert(used[i] == 0);
            i = i + 1;
        }
        layout = layout + 1;
    }
}

test "control: without beats the inputs are mode 3's, the frames at 0, the wavs at 1..3, the music at 4" {
    assert(beat_video_inputs(false) == 1);
    assert(beat_voice_input(false, 0) == 1);
    assert(beat_voice_input(false, PHRASES - 1) == 3);
    assert(beat_music_input(false) == 4);
    assert(beat_voice_input(true, 0) == 3);
    assert(beat_music_input(true) == 6);
}

// ---- the overlay windows' tests (t27#10614) ----

// Whether frames lo..hi meet crossfade 0 or 1.
fn on_xfade(lo: i32, hi: i32, f0: i32, f1: i32) -> bool {
    if (hi >= f0 && lo <= f0 + TRANSITION_FRAMES) {
        return true;
    }
    return hi >= f1 && lo <= f1 + TRANSITION_FRAMES;
}

// Every kept piece of lo..hi is inside the window and the reel, off both crossfades, and as long as
// the rule asks; checked against the crossfades themselves, not against beat_scene_*.
fn pieces_clear(lo: i32, hi: i32, f0: i32, f1: i32) -> bool {
    var b : usize = 0;
    while (b < 3) {
        if (beat_piece_kept(lo, hi, b, f0, f1)) {
            const a = beat_piece_lo(lo, b, f0, f1);
            const z = beat_piece_hi(hi, b, f0, f1);
            if (a < lo || z > hi || a < 0 || z >= beat_frames() || z < a) {
                return false;
            }
            if (on_xfade(a, z, f0, f1)) {
                return false;
            }
            if (z - a + 1 < BEAT_OVERLAY_MIN_FRAMES && z - a + 1 != hi - lo + 1) {
                return false;
            }
        }
        b = b + 1;
    }
    return true;
}

test "the frames mode 5 enables are the frames between(t, a, b) shows" {
    // frame f is at f / 30 s: 1000 ms is frame 30, and 1001 ms falls between 30 and 31
    assert(beat_frame_from(0) == 0);
    assert(beat_frame_from(1000) == 30);
    assert(beat_frame_until(1000) == 30);
    assert(beat_frame_from(1001) == 31);
    assert(beat_frame_until(1001) == 30);
    assert(beat_frame_from(34) == 2);
    assert(beat_frame_until(33) == 0);
    var f : i32 = 0;
    while (f < beat_frames()) {
        // frame f's time in us, against an edge a ms: shown from a exactly when the frame is not early
        var a : i32 = 0;
        while (a <= 100) {
            const ms = 100 * @divTrunc(f, 3) + a;
            const shown = f * 1000000 >= ms * 1000 * BASE_FPS;
            assert(shown == (f >= beat_frame_from(ms)));
            a = a + 17;
        }
        f = f + 1;
    }
}

test "an overlay with no room in its scene is dropped, not squeezed" {
    const f0 : i32 = 100;
    const f1 : i32 = 300;
    // the beats' own frames: 0..99, 116..299, 316..449
    assert(beat_scene_hi(BEAT_OPEN, f0, f1) == 99);
    assert(beat_scene_lo(BEAT_MAIN, f0, f1) == 116);
    assert(beat_scene_hi(BEAT_MAIN, f0, f1) == 299);
    assert(beat_scene_lo(BEAT_CLOSE, f0, f1) == 316);
    assert(beat_scene_hi(BEAT_CLOSE, f0, f1) == 449);
    // wholly inside a crossfade: dropped
    assert(beat_pieces(102, 110, f0, f1) == 0);
    // across a crossfade with five frames on each side: both pieces are too short, so dropped
    assert(beat_pieces(95, 120, f0, f1) == 0);
    // five frames clear of every crossfade: left as it was
    assert(beat_pieces(95, 99, f0, f1) == 1);
    assert(beat_piece_lo(95, BEAT_OPEN, f0, f1) == 95);
    // across a crossfade with room on both sides: two pieces, each cut at the crossfade
    assert(beat_pieces(80, 140, f0, f1) == 2);
    assert(beat_piece_hi(140, BEAT_OPEN, f0, f1) == 99);
    assert(beat_first_lo(80, 140, f0, f1) == 80);
    assert(beat_piece_lo(80, BEAT_MAIN, f0, f1) == 116);
    // the short side alone is dropped and the long one starts the overlay
    assert(beat_pieces(95, 160, f0, f1) == 1);
    assert(beat_first_lo(95, 160, f0, f1) == 116);
    assert(pieces_clear(95, 160, f0, f1));
}

test "control: mode 3's windows over mode 4's cuts put the goal's first caption on a crossfade" {
    const c0 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 0);
    const f0 = beat_xfade_frame(c0);
    const f1 = beat_xfade_frame(beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1));
    const lo = beat_frame_from(chunk_from(0, 0, M_EN0, M_EN1, M_EN2, 1, 0));
    const hi = beat_frame_until(chunk_until(0, 0, M_EN0, M_EN1, M_EN2, 1, 0));
    // the goal is spoken from cut 0, the middle of crossfade 0
    assert(on_xfade(lo, hi, f0, f1));
    assert(lo > f0);
    assert(lo < f0 + TRANSITION_FRAMES);
    // mode 5 shows it from the main beat's first own frame
    assert(beat_pieces(lo, hi, f0, f1) == 1);
    assert(beat_first_lo(lo, hi, f0, f1) == f0 + TRANSITION_FRAMES + 1);
}

test "in mode 5 no caption, tag or address is on a crossfade, every lesson, both languages, every voice the clock accepts" {
    var voices : usize = 0;
    var windows : usize = 0;
    var crossing : usize = 0;
    var dropped : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            voices = voices + 1;
                            const f0 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 0));
                            const f1 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 1));
                            var s : usize = 0;
                            while (s < SHOTS) {
                                const lo = SHOT_START[s];
                                const hi = SHOT_START[s + 1] - 1;
                                assert(pieces_clear(lo, hi, f0, f1));
                                windows = windows + 1;
                                if (on_xfade(lo, hi, f0, f1)) {
                                    crossing = crossing + 1;
                                }
                                if (beat_pieces(lo, hi, f0, f1) == 0) {
                                    dropped = dropped + 1;
                                }
                                s = s + 1;
                            }
                            var p : usize = 0;
                            while (p < phrases_for(m0, m1, m2)) {
                                var c : usize = 0;
                                while (c < chunks(phrase_item(t, lang, p))) {
                                    const lo = beat_frame_from(chunk_from(t, lang, m0, m1, m2, p, c));
                                    const hi = beat_frame_until(chunk_until(t, lang, m0, m1, m2, p, c));
                                    assert(pieces_clear(lo, hi, f0, f1));
                                    windows = windows + 1;
                                    if (on_xfade(lo, hi, f0, f1)) {
                                        crossing = crossing + 1;
                                    }
                                    if (beat_pieces(lo, hi, f0, f1) == 0) {
                                        dropped = dropped + 1;
                                    }
                                    c = c + 1;
                                }
                                p = p + 1;
                            }
                            const lo = beat_frame_from(cta_from(t, lang, m0, m1, m2));
                            assert(pieces_clear(lo, beat_frames() - 1, f0, f1));
                            // the address is on in the close beat alone, to the reel's last frame
                            assert(beat_pieces(lo, beat_frames() - 1, f0, f1) == 1);
                            assert(beat_first_lo(lo, beat_frames() - 1, f0, f1) == beat_scene_lo(BEAT_CLOSE, f0, f1));
                            windows = windows + 1;
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    assert(voices > 0);
    assert(windows > voices * SHOTS);
    // mode 3's windows do meet the crossfades: the rule has work to do
    assert(crossing > voices);
    assert(dropped < windows);
}

test "a card's window is token_floor_mux's, inside the reel, and its last kept piece ends where it should" {
    assert(card_lo(0) == 98);
    assert(card_hi(0) == 176);
    assert(card_lo(2) == 392);
    // CARD_ON says 450, a frame past the reel's last
    assert(CARD_ON[5] == beat_frames());
    assert(card_hi(2) == beat_frames() - 1);
    const f0 : i32 = 100;
    const f1 : i32 = 300;
    // one kept piece: first and last are its own ends
    assert(beat_last_hi(95, 160, f0, f1) == 160);
    assert(beat_first_lo(95, 160, f0, f1) == 116);
    // two kept pieces: the last ends with the window, the first starts with it
    assert(beat_last_hi(80, 140, f0, f1) == 140);
    assert(beat_last_hi(80, 108, f0, f1) == 99);
    // none kept: the window's own end
    assert(beat_pieces(102, 110, f0, f1) == 0);
    assert(beat_last_hi(102, 110, f0, f1) == 110);
}

test "in mode 5 no card is on a crossfade, every lesson, both languages, every voice the clock accepts" {
    var voices : usize = 0;
    var crossing : usize = 0;
    var kept : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            voices = voices + 1;
                            const f0 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 0));
                            const f1 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 1));
                            var c : usize = 0;
                            while (c < CARDS) {
                                const lo = card_lo(c);
                                const hi = card_hi(c);
                                assert(pieces_clear(lo, hi, f0, f1));
                                if (on_xfade(lo, hi, f0, f1)) {
                                    crossing = crossing + 1;
                                }
                                if (beat_pieces(lo, hi, f0, f1) > 0) {
                                    kept = kept + 1;
                                    // the rise starts and the fade ends on frames the card is on
                                    const a = beat_first_lo(lo, hi, f0, f1);
                                    const z = beat_last_hi(lo, hi, f0, f1);
                                    assert(a >= lo);
                                    assert(z <= hi);
                                    assert(z >= a);
                                    assert(on_xfade(a, a, f0, f1) == false);
                                    assert(on_xfade(z, z, f0, f1) == false);
                                }
                                c = c + 1;
                            }
                            // the last card is on in the close beat, which owns 45 frames
                            assert(beat_pieces(card_lo(2), card_hi(2), f0, f1) == 1);
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    assert(voices > 0);
    assert(kept >= voices);
    // control: token_floor_mux's own card windows do meet the crossfades, so the rule has work to do
    assert(crossing > 0);
    // on lesson 1's measured voice cut 1 is capped, crossfade 1 starts on frame 389, and mode 3's
    // last card, on from frame 392, rises under it; mode 5 starts it on the close beat's first frame
    const f0 = beat_xfade_frame(beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 0));
    const f1 = beat_xfade_frame(beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1));
    assert(f1 == 389);
    assert(on_xfade(card_lo(2), card_hi(2), f0, f1));
    assert(beat_first_lo(card_lo(2), card_hi(2), f0, f1) == 405);
    assert(beat_last_hi(card_lo(2), card_hi(2), f0, f1) == 449);
}

test "the cost on lesson 1's measured voice: a caption across a crossfade with no room is dropped, and every phrase keeps one" {
    var dropped : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            const f0 = beat_xfade_frame(beat_cut_ms(t, lang, M_EN0, M_EN1, M_EN2, 0));
            const f1 = beat_xfade_frame(beat_cut_ms(t, lang, M_EN0, M_EN1, M_EN2, 1));
            var p : usize = 0;
            while (p < phrases_for(M_EN0, M_EN1, M_EN2)) {
                var kept : usize = 0;
                var c : usize = 0;
                while (c < chunks(phrase_item(t, lang, p))) {
                    const lo = beat_frame_from(chunk_from(t, lang, M_EN0, M_EN1, M_EN2, p, c));
                    const hi = beat_frame_until(chunk_until(t, lang, M_EN0, M_EN1, M_EN2, p, c));
                    if (beat_pieces(lo, hi, f0, f1) == 0) {
                        // only a caption a crossfade cuts is ever dropped
                        assert(on_xfade(lo, hi, f0, f1));
                        dropped = dropped + 1;
                    } else {
                        kept = kept + 1;
                    }
                    c = c + 1;
                }
                assert(kept >= 1);
                p = p + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    // crossfade 0 is centred on the goal's start, so it begins under the title's last words
    assert(dropped > 0);
}

// ---- the address hold's tests (t27#10629) ----

// The voice's last spoken ms: the end of the last phrase, before its caption's tail.
fn spoken_end(m0: i32, m1: i32, m2: i32) -> i32 {
    const n = phrases_for(m0, m1, m2);
    return phrase_start(m0, m1, m2, n - 1) + played(m0, m1, m2, n - 1);
}

// How many frames mode 5 shows the address: from its first kept frame to the reel's last.
fn cta_held(t: usize, lang: usize, m0: i32, m1: i32, m2: i32) -> i32 {
    const f0 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 0));
    const f1 = beat_xfade_frame(beat_cut_ms(t, lang, m0, m1, m2, 1));
    const lo = beat_frame_from(cta_from(t, lang, m0, m1, m2));
    return beat_frames() - beat_first_lo(lo, beat_frames() - 1, f0, f1);
}

test "BEAT_CUT1_LAST_MS is the latest cut 1 whose close beat owns REEL_CTA_MIN_MS" {
    const f1 = beat_xfade_frame(BEAT_CUT1_LAST_MS);
    assert(f1 == 389);
    const own = beat_frames() - beat_scene_lo(BEAT_CLOSE, 0, f1);
    assert(own == 45);
    assert(own * 1000 >= REEL_CTA_MIN_MS * BASE_FPS);
    // one ms later the crossfade starts a frame later and the close beat owns 44 frames
    const g1 = beat_xfade_frame(BEAT_CUT1_LAST_MS + 1);
    assert(g1 == 390);
    assert((beat_frames() - beat_scene_lo(BEAT_CLOSE, 0, g1)) * 1000 < REEL_CTA_MIN_MS * BASE_FPS);
    // the reel's address starts no later than the close beat could
    assert(BEAT_CUT1_LAST_MS < REEL_MS - REEL_CTA_MIN_MS);
}

test "mode 5 holds the address for REEL_CTA_MIN_MS, every lesson, both languages, every voice the clock accepts" {
    var voices : usize = 0;
    var moved : usize = 0;
    var short_before : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            voices = voices + 1;
                            const cta = cta_from(t, lang, m0, m1, m2);
                            const c1 = beat_cut_ms(t, lang, m0, m1, m2, 1);
                            assert(cta_held(t, lang, m0, m1, m2) * 1000 >= REEL_CTA_MIN_MS * BASE_FPS);
                            if (c1 < cta) {
                                moved = moved + 1;
                                assert(c1 == BEAT_CUT1_LAST_MS);
                            } else {
                                assert(c1 == cta);
                            }
                            // control: the cut centred on the address, as before t27#10629
                            const lo = beat_frame_from(cta);
                            var old_lo : i32 = beat_scene_lo(BEAT_CLOSE, 0, beat_xfade_frame(cta));
                            if (lo > old_lo) {
                                old_lo = lo;
                            }
                            if ((beat_frames() - old_lo) * 1000 < REEL_CTA_MIN_MS * BASE_FPS) {
                                short_before = short_before + 1;
                                // every voice the old cut held short is one the cap moves
                                assert(c1 < cta);
                            }
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    assert(voices > 0);
    assert(short_before > 0);
    assert(moved >= short_before);
    // most voices end early enough that the cut stays on the address
    assert(moved < voices);
}

test "the cost: on a voice the cap moves, crossfade 1 starts under the task's last words, by at most 184 ms" {
    const bound = REEL_MS - REEL_CTA_MIN_MS - CAPTION_TAIL_MS - beat_frame_ms(beat_xfade_frame(BEAT_CUT1_LAST_MS));
    assert(bound == 184);
    var under : usize = 0;
    var t : usize = 0;
    while (t < TOPICS) {
        var lang : usize = 0;
        while (lang < 2) {
            var i : usize = 0;
            while (i < 4) {
                var j : usize = 0;
                while (j < 4) {
                    var k : usize = 0;
                    while (k < 5) {
                        const m0 = BEAT_GRID_M0[i];
                        const m1 = BEAT_GRID_M1[j];
                        const m2 = BEAT_GRID_M2[k];
                        if (voice_fits(m0, m1, m2)) {
                            const c1 = beat_cut_ms(t, lang, m0, m1, m2, 1);
                            const x1 = beat_frame_ms(beat_xfade_frame(c1));
                            const e = spoken_end(m0, m1, m2);
                            if (x1 < e) {
                                under = under + 1;
                                // only a moved cut starts under the voice, and never by more than the bound
                                assert(c1 < cta_from(t, lang, m0, m1, m2));
                                assert(e - x1 <= bound);
                            }
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            lang = lang + 1;
        }
        t = t + 1;
    }
    assert(under > 0);
    // lesson 1's measured voice is one of them: the reel speeds it up to the address's floor
    const c1 = beat_cut_ms(0, 0, M_EN0, M_EN1, M_EN2, 1);
    assert(c1 == BEAT_CUT1_LAST_MS);
    assert(cta_from(0, 0, M_EN0, M_EN1, M_EN2) > BEAT_CUT1_LAST_MS);
    assert(spoken_end(M_EN0, M_EN1, M_EN2) > beat_frame_ms(beat_xfade_frame(c1)));
}
