// SPDX-License-Identifier: Apache-2.0
; specs/t27f/viz_theme.t27 -- the ONE theme of the T27F viz surfaces: every semantic colour role
; mapped onto its concrete value in one place.
; Epic: interactive visualizations across the 27 T27 OS petals (specs/t27f/viz_contract.t27 is the
; contract and keeps the role constants untouched; this spec consumes them). Four parallel palettes
; grew up beside the contract, one per surface, and this file is where they meet:
; --
; THE CATALOGUE (every colour constant of the four palettes, its meaning, its home here)
;   A. specs/t27f/spec_graph_view.t27 -- provenance label styles, indexed by inference label:
;      VIEW_LABEL_FILL   fill per label: EXACT 0x0C2A1B (dark green tint), DERIVED 0x2B2508
;                        (dark gold tint), SUGGESTED 0x0E2236 (dark blue tint), UNKNOWN 0x1A1E1C
;                        (dark grey tint); each fill is a dark tint of its stroke, so white text
;                        clears 4.5:1 on every box.
;      VIEW_LABEL_STROKE stroke per label: EXACT 0x00FF88 (accent green), DERIVED 0xFFD700 (gold),
;                        SUGGESTED 0x58A6FF (blue), UNKNOWN 0x8B9490 (muted grey).
;      VIEW_LABEL_DASH   dash per label in px: 0 solid (only a fact is solid), 6 derived, 3
;                        suggested, 2 unknown; the label survives a colour-blind reader.
;      VIEW_TEXT         0xFFFFFF, the node text; VIEW_BACKDROP 0x000000, the brand black (it is
;                        the background role, VIZ_ROLE_BG).
;   B. specs/t27f/gnn_work_graph_viz.t27 -- work-graph kinds, the GitHub dark palette:
;      GNN_NK_RGB per node kind: SPEC 0x58A6FF (the accent role), AGENT 0x3FB950 (green), TASK
;                 0xD29922 (amber), ACTION 0xF85149 (red), ARTIFACT 0xE6EDF3 (the ink role).
;      GNN_EK_RGB per edge kind: READS 0x58A6FF, ASSIGNED 0xD29922, PERFORMS 0x3FB950, PRODUCES
;                 0xE6EDF3, VERIFIES 0x58A6FF, BLOCKS 0xF85149 -- the same five colours again.
;   C. specs/t27f/graph_design.t27 -- live mycelium state colours, RGB 0..1 (SC_*_R/G/B through
;      gd_state_r/g/b): WORKING (0.345, 0.651, 1.000) calm blue, BLOCKED (0.824, 0.600, 0.133)
;      amber, DONE (0.247, 0.725, 0.314) green, ERROR (0.973, 0.318, 0.286) red, STALE
;      (0.545, 0.573, 0.620) muted grey, UNKNOWN (0.400, 0.400, 0.400) neutral.
;   D. specs/t27os/queen_live_graph.t27 -- the live lifecycle palette (QLG_C_* through qlg_cr/cg/cb):
;      NEW (0.247, 0.725, 0.314) green, ACTIVE (0.345, 0.651, 1.000) blue, DOWN (0.973, 0.318,
;      0.286) red, RESTART (0.824, 0.600, 0.133) amber, EXIT (0.545, 0.573, 0.620) grey.
;      C and D are the SAME five colours -- C's WORKING/BLOCKED/DONE/ERROR/STALE are D's
;      ACTIVE/RESTART/NEW/DOWN/EXIT -- and C adds the sixth neutral for its UNKNOWN state.
; --
; What this file owns: the label style rows (TH_LBL_*), the shared web set of five byte colours
; (TH_WEB_*) the graph pages draw kinds with, the lifecycle colours as f64 triples (TH_LC_*), and
; f64 channel views over the contract's role constants (th_role_*). What it does NOT own: the role
; BYTES stay in viz_contract (L2b, untouched), the truth-badge colours stay VIZ_TRUTH_RGB there,
; and the GNN dash/style and opacity tables (GNN_DASH_ON, GNN_EK_STYLE, GNN_OP_*) are line styles,
; not colours, so they stay in gnn_work_graph_viz.t27.
; --
; The refactor-with-proof rule: every value here is PINNED by a test to the exact constant of the
; palette it replaces, so migrating a call site to the theme changes no pixel. One recorded quirk
; is kept on purpose: the live band's EXIT grey is f64 (0.545, 0.573, 0.620), which rounds to
; 0x8B929E, while the muted role is the byte colour 0x8B949E -- the G channel differs by 2/255.
; Both stay as they are; a test holds the difference so nobody "fixes" it silently.
; Not claimed: no call site is migrated yet; the lists of what SHOULD migrate are the report of the
; lane that landed this file. ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module T27fVizTheme;

use t27f::viz_contract::VIZ_BG_RGB;
use t27f::viz_contract::VIZ_PANEL_RGB;
use t27f::viz_contract::VIZ_BORDER_RGB;
use t27f::viz_contract::VIZ_INK_RGB;
use t27f::viz_contract::VIZ_MUTED_RGB;
use t27f::viz_contract::VIZ_ACCENT_RGB;
use t27f::viz_contract::VIZ_ROLE_BG;
use t27f::viz_contract::VIZ_ROLE_PANEL;
use t27f::viz_contract::VIZ_ROLE_INK;
use t27f::viz_contract::VIZ_ROLE_MUTED;
use t27f::viz_contract::VIZ_ROLE_ACCENT;
use t27f::viz_contract::VIZ_ROLE_BORDER;
use t27f::viz_contract::VIZ_ROLE_COUNT;
use t27f::viz_contract::viz_role_rgb;
use t27f::viz_contract::viz_rgb_r;
use t27f::viz_contract::viz_rgb_g;
use t27f::viz_contract::viz_rgb_b;
use t27f::spec_graph::LABEL_EXACT;
use t27f::spec_graph::LABEL_DERIVED;
use t27f::spec_graph::LABEL_SUGGESTED;
use t27f::spec_graph::LABEL_UNKNOWN;
use t27f::spec_graph::LABEL_KINDS;
use t27f::spec_graph::valid_label;
use t27f::work_graph::NK_COUNT;
use t27f::work_graph::EK_COUNT;

; ---------------------------------------------------------------- f64 channel views

/// The red channel of any 0xRRGGBB colour as f64 in 0..1 (byte / 255). Every f64 draw path reads
/// its colours through these three, so a byte palette and an f64 palette can never drift apart.
pub fn th_rgb_r(rgb: u32) -> f64 {
    return (viz_rgb_r(rgb) as f64) / 255.0;
}

pub fn th_rgb_g(rgb: u32) -> f64 {
    return (viz_rgb_g(rgb) as f64) / 255.0;
}

pub fn th_rgb_b(rgb: u32) -> f64 {
    return (viz_rgb_b(rgb) as f64) / 255.0;
}

; ---------------------------------------------------------------- roles (viz_contract consumes)

/// The background role as f64 channels: the page black, byte-exact from viz_contract's VIZ_BG_RGB.
pub fn th_role_r(role: u32) -> f64 {
    return th_rgb_r(viz_role_rgb(role));
}

pub fn th_role_g(role: u32) -> f64 {
    return th_rgb_g(viz_role_rgb(role));
}

pub fn th_role_b(role: u32) -> f64 {
    return th_rgb_b(viz_role_rgb(role));
}

/// Pure white, the graph view's node text (spec_graph_view's VIEW_TEXT). Not a role of its own:
/// the ink role is 0xE6EDF3, and text that must be full white asks for TH_WHITE.
pub const TH_WHITE : u32 = 0xFFFFFF;

; ---------------------------------------------------------------- the web set (byte colours)

/// The five byte colours the graph pages draw their kinds with (the GitHub dark palette): the
/// accent and the ink are the contract's own roles; green, amber and red are theme colours.
pub const TH_WEB_ACCENT : u32 = 0;
pub const TH_WEB_GREEN : u32 = 1;
pub const TH_WEB_AMBER : u32 = 2;
pub const TH_WEB_RED : u32 = 3;
pub const TH_WEB_INK : u32 = 4;
pub const TH_WEB_COUNT : u32 = 5;
pub const TH_WEB_RGB : [5]u32 = [0x58A6FF, 0x3FB950, 0xD29922, 0xF85149, 0xE6EDF3];

/// The web colour of code k; a code past the table is the ink role's byte colour (the rule
/// gnn_nk_rgb and gnn_ek_rgb already hold).
pub fn th_web_rgb(k: u32) -> u32 {
    if (k >= TH_WEB_COUNT) {
        return VIZ_INK_RGB;
    }
    return TH_WEB_RGB[k as usize];
}

; ---------------------------------------------------------------- work-graph kinds

/// Node kind k as a web-set code, in work_graph's NK_* order: SPEC accent, AGENT green, TASK amber,
/// ACTION red, ARTIFACT ink. A kind past NK_COUNT is the ink (gnn_nk_rgb's rule).
pub const TH_NK_WEB : [5]u32 = [0, 1, 2, 3, 4];

/// Edge kind k as a web-set code, in work_graph's EK_* order: READS accent, ASSIGNED amber,
/// PERFORMS green, PRODUCES ink, VERIFIES accent, BLOCKS red. Past EK_COUNT is the ink.
pub const TH_EK_WEB : [6]u32 = [0, 2, 1, 4, 0, 3];

pub fn th_nk_rgb(k: u32) -> u32 {
    if (k >= (NK_COUNT as u32)) {
        return VIZ_INK_RGB;
    }
    return th_web_rgb(TH_NK_WEB[k as usize]);
}

pub fn th_ek_rgb(k: u32) -> u32 {
    if (k >= (EK_COUNT as u32)) {
        return VIZ_INK_RGB;
    }
    return th_web_rgb(TH_EK_WEB[k as usize]);
}

; ---------------------------------------------------------------- provenance label styles

/// The style row of an inference label: fill, stroke and dash, byte-exact from spec_graph_view's
/// VIEW_LABEL_FILL / VIEW_LABEL_STROKE / VIEW_LABEL_DASH, indexed by spec_graph's LABEL_* codes.
pub const TH_LBL_KINDS : u32 = 4;
pub const TH_LBL_FILL : [4]u32 = [0x0C2A1B, 0x2B2508, 0x0E2236, 0x1A1E1C];
pub const TH_LBL_STROKE : [4]u32 = [0x00FF88, 0xFFD700, 0x58A6FF, 0x8B9490];
pub const TH_LBL_DASH : [4]u32 = [0, 6, 3, 2];

/// The row a label is drawn with: a label this file cannot read is the UNKNOWN row, never a fact
/// (the rule spec_graph_view's view_style holds).
pub fn th_label_style(label: u8) -> u8 {
    if (valid_label(label) == false) {
        return LABEL_UNKNOWN;
    }
    return label;
}

pub fn th_label_fill(label: u8) -> u32 {
    return TH_LBL_FILL[th_label_style(label) as usize];
}

pub fn th_label_stroke(label: u8) -> u32 {
    return TH_LBL_STROKE[th_label_style(label) as usize];
}

pub fn th_label_dash(label: u8) -> u32 {
    return TH_LBL_DASH[th_label_style(label) as usize];
}

; ---------------------------------------------------------------- lifecycle colours

/// The live lifecycle, f64 0..1 (the live band's own resolution): NEW green, ACTIVE blue, DOWN
/// red, RESTART amber, EXIT grey, plus the neutral UNKNOWN a state table needs (graph_design's
/// ST_UNKNOWN). Codes 0..4 are the queen_live_graph palette in its own QLG_C_* order; a code past
/// the palette falls back to EXIT, the fallback every current caller holds.
pub const TH_LC_NEW : u32 = 0;
pub const TH_LC_ACTIVE : u32 = 1;
pub const TH_LC_DOWN : u32 = 2;
pub const TH_LC_RESTART : u32 = 3;
pub const TH_LC_EXIT : u32 = 4;
pub const TH_LC_UNKNOWN : u32 = 5;
pub const TH_LC_COUNT : u32 = 6;

/// The palette code of a caller's code: 0..4 pass through, anything at or past the UNKNOWN code is
/// EXIT. UNKNOWN is chosen explicitly (by the state mapping of the caller), never by a fallback.
pub fn th_lc_code(c: u32) -> u32 {
    if (c < TH_LC_UNKNOWN) {
        return c;
    }
    return TH_LC_EXIT;
}

pub fn th_lc_r(c: u32) -> f64 {
    if (c == TH_LC_UNKNOWN) {
        return 0.400;
    }
    let k : u32 = th_lc_code(c);
    if (k == TH_LC_NEW) { return 0.247; }
    if (k == TH_LC_ACTIVE) { return 0.345; }
    if (k == TH_LC_DOWN) { return 0.973; }
    if (k == TH_LC_RESTART) { return 0.824; }
    return 0.545;
}

pub fn th_lc_g(c: u32) -> f64 {
    if (c == TH_LC_UNKNOWN) {
        return 0.400;
    }
    let k : u32 = th_lc_code(c);
    if (k == TH_LC_NEW) { return 0.725; }
    if (k == TH_LC_ACTIVE) { return 0.651; }
    if (k == TH_LC_DOWN) { return 0.318; }
    if (k == TH_LC_RESTART) { return 0.600; }
    return 0.573;
}

pub fn th_lc_b(c: u32) -> f64 {
    if (c == TH_LC_UNKNOWN) {
        return 0.400;
    }
    let k : u32 = th_lc_code(c);
    if (k == TH_LC_NEW) { return 0.314; }
    if (k == TH_LC_ACTIVE) { return 1.000; }
    if (k == TH_LC_DOWN) { return 0.286; }
    if (k == TH_LC_RESTART) { return 0.133; }
    return 0.620;
}

; ---------------------------------------------------------------- test helper

/// x, scaled to bytes, lands within half a byte of `b`: the round-trip an f64 colour needs to
/// reproduce a byte palette.
fn th_near_byte(x: f64, b: u32) -> bool {
    let bf : f64 = b as f64;
    var d : f64 = x - bf;
    if (d < 0.0) {
        d = 0.0 - d;
    }
    return d <= 0.5;
}

; ---------------------------------------------------------------- tests

test th_channel_views_split_and_read_back_the_bytes {
    assert th_rgb_r(0x58A6FF) == th_role_r(VIZ_ROLE_ACCENT);
    assert th_near_byte(th_rgb_r(0x58A6FF) * 255.0, 88);
    assert th_near_byte(th_rgb_g(0x58A6FF) * 255.0, 166);
    assert th_near_byte(th_rgb_b(0x58A6FF) * 255.0, 255);
    // the extremes: black is 0.0 in every channel, white 1.0
    assert th_rgb_r(0x000000) == 0.0;
    assert th_rgb_b(0x000000) == 0.0;
    assert th_rgb_r(TH_WHITE) == 1.0;
    assert th_rgb_g(TH_WHITE) == 1.0;
    assert th_rgb_b(TH_WHITE) == 1.0;
}

test each_role_maps_onto_the_contract_bytes {
    // hand-counted bytes of the six contract roles: BG, PANEL, INK, MUTED, ACCENT, BORDER
    assert VIZ_BG_RGB == 0x000000;
    assert VIZ_PANEL_RGB == 0x000000;
    assert VIZ_INK_RGB == 0xE6EDF3;
    assert VIZ_MUTED_RGB == 0x8B949E;
    assert VIZ_ACCENT_RGB == 0x58A6FF;
    assert VIZ_BORDER_RGB == 0x333333;
    assert th_near_byte(th_role_r(VIZ_ROLE_INK) * 255.0, 230);
    assert th_near_byte(th_role_g(VIZ_ROLE_INK) * 255.0, 237);
    assert th_near_byte(th_role_b(VIZ_ROLE_INK) * 255.0, 243);
    assert th_near_byte(th_role_r(VIZ_ROLE_MUTED) * 255.0, 139);
    assert th_near_byte(th_role_g(VIZ_ROLE_MUTED) * 255.0, 148);
    assert th_near_byte(th_role_b(VIZ_ROLE_MUTED) * 255.0, 158);
    assert th_near_byte(th_role_r(VIZ_ROLE_ACCENT) * 255.0, 88);
    assert th_near_byte(th_role_g(VIZ_ROLE_ACCENT) * 255.0, 166);
    assert th_near_byte(th_role_b(VIZ_ROLE_ACCENT) * 255.0, 255);
    assert th_near_byte(th_role_r(VIZ_ROLE_BORDER) * 255.0, 51);
    assert th_near_byte(th_role_g(VIZ_ROLE_BORDER) * 255.0, 51);
    assert th_near_byte(th_role_b(VIZ_ROLE_BORDER) * 255.0, 51);
    // BG and PANEL are the same black on purpose; the graph view's backdrop is the background role
    assert th_role_r(VIZ_ROLE_BG) == th_role_r(VIZ_ROLE_PANEL);
    assert th_role_g(VIZ_ROLE_BG) == 0.0;
    assert th_role_b(VIZ_ROLE_BG) == 0.0;
}

test no_role_is_unmapped {
    // every role code the contract names answers with channels in 0..1 that round back onto the
    // very bytes viz_role_rgb hands out
    var role : u32 = 0;
    while (role < VIZ_ROLE_COUNT) {
        let rgb : u32 = viz_role_rgb(role);
        assert th_role_r(role) >= 0.0 and th_role_r(role) <= 1.0;
        assert th_role_g(role) >= 0.0 and th_role_g(role) <= 1.0;
        assert th_role_b(role) >= 0.0 and th_role_b(role) <= 1.0;
        assert th_near_byte(th_role_r(role) * 255.0, viz_rgb_r(rgb));
        assert th_near_byte(th_role_g(role) * 255.0, viz_rgb_g(rgb));
        assert th_near_byte(th_role_b(role) * 255.0, viz_rgb_b(rgb));
        role = role + 1;
    }
    // a code past the roles is the ink, never an unmapped answer
    assert th_role_r(99) == th_role_r(VIZ_ROLE_INK);
    assert th_near_byte(th_role_r(99) * 255.0, 230);
}

test the_label_rows_reproduce_the_view_literals {
    // spec_graph_view's VIEW_LABEL_FILL, byte for byte
    assert th_label_fill(LABEL_EXACT) == 0x0C2A1B;
    assert th_label_fill(LABEL_DERIVED) == 0x2B2508;
    assert th_label_fill(LABEL_SUGGESTED) == 0x0E2236;
    assert th_label_fill(LABEL_UNKNOWN) == 0x1A1E1C;
    // VIEW_LABEL_STROKE
    assert th_label_stroke(LABEL_EXACT) == 0x00FF88;
    assert th_label_stroke(LABEL_DERIVED) == 0xFFD700;
    assert th_label_stroke(LABEL_SUGGESTED) == 0x58A6FF;
    assert th_label_stroke(LABEL_UNKNOWN) == 0x8B9490;
    // VIEW_LABEL_DASH: only a fact is solid
    assert th_label_dash(LABEL_EXACT) == 0;
    assert th_label_dash(LABEL_DERIVED) == 6;
    assert th_label_dash(LABEL_SUGGESTED) == 3;
    assert th_label_dash(LABEL_UNKNOWN) == 2;
}

test an_unreadable_label_is_the_unknown_row {
    // past the vocabulary, and an arbitrary high byte: all three channels take the UNKNOWN row
    assert th_label_style(LABEL_KINDS) == LABEL_UNKNOWN;
    assert th_label_style(200) == LABEL_UNKNOWN;
    assert th_label_fill(LABEL_KINDS) == th_label_fill(LABEL_UNKNOWN);
    assert th_label_stroke(200) == th_label_stroke(LABEL_UNKNOWN);
    assert th_label_dash(200) == th_label_dash(LABEL_UNKNOWN);
    // every real label passes through unchanged
    assert th_label_style(LABEL_EXACT) == LABEL_EXACT;
    assert th_label_style(LABEL_DERIVED) == LABEL_DERIVED;
    assert th_label_style(LABEL_SUGGESTED) == LABEL_SUGGESTED;
}

test the_node_kinds_reproduce_the_gnn_table {
    // gnn_work_graph_viz's GNN_NK_RGB, byte for byte in NK_* order
    assert th_nk_rgb(0) == 0x58A6FF;
    assert th_nk_rgb(1) == 0x3FB950;
    assert th_nk_rgb(2) == 0xD29922;
    assert th_nk_rgb(3) == 0xF85149;
    assert th_nk_rgb(4) == 0xE6EDF3;
    // the mapping is by web-set code, and the codes hold the palette's own roles
    assert TH_NK_WEB[0] == TH_WEB_ACCENT;
    assert TH_NK_WEB[1] == TH_WEB_GREEN;
    assert TH_NK_WEB[2] == TH_WEB_AMBER;
    assert TH_NK_WEB[3] == TH_WEB_RED;
    assert TH_NK_WEB[4] == TH_WEB_INK;
    assert TH_WEB_RGB[TH_WEB_ACCENT as usize] == VIZ_ACCENT_RGB;
    assert TH_WEB_RGB[TH_WEB_INK as usize] == VIZ_INK_RGB;
}

test the_edge_kinds_reproduce_the_gnn_table {
    // gnn_work_graph_viz's GNN_EK_RGB, byte for byte in EK_* order
    assert th_ek_rgb(0) == 0x58A6FF;
    assert th_ek_rgb(1) == 0xD29922;
    assert th_ek_rgb(2) == 0x3FB950;
    assert th_ek_rgb(3) == 0xE6EDF3;
    assert th_ek_rgb(4) == 0x58A6FF;
    assert th_ek_rgb(5) == 0xF85149;
    assert TH_EK_WEB[0] == TH_WEB_ACCENT;
    assert TH_EK_WEB[1] == TH_WEB_AMBER;
    assert TH_EK_WEB[2] == TH_WEB_GREEN;
    assert TH_EK_WEB[3] == TH_WEB_INK;
    assert TH_EK_WEB[5] == TH_WEB_RED;
}

test a_kind_past_the_table_is_the_ink {
    assert th_nk_rgb(5) == VIZ_INK_RGB;
    assert th_nk_rgb(99) == VIZ_INK_RGB;
    assert th_ek_rgb(6) == VIZ_INK_RGB;
    assert th_ek_rgb(99) == VIZ_INK_RGB;
    assert th_web_rgb(TH_WEB_COUNT) == VIZ_INK_RGB;
    // the f64 view of that fallback is the ink's own channels
    assert th_near_byte(th_rgb_r(th_nk_rgb(99)) * 255.0, 230);
}

test the_lifecycle_reproduces_the_live_band_f64 {
    // queen_live_graph's qlg_cr / qlg_cg / qlg_cb, literal for literal
    assert th_lc_r(TH_LC_NEW) == 0.247;
    assert th_lc_g(TH_LC_NEW) == 0.725;
    assert th_lc_b(TH_LC_NEW) == 0.314;
    assert th_lc_r(TH_LC_ACTIVE) == 0.345;
    assert th_lc_g(TH_LC_ACTIVE) == 0.651;
    assert th_lc_b(TH_LC_ACTIVE) == 1.000;
    assert th_lc_r(TH_LC_DOWN) == 0.973;
    assert th_lc_g(TH_LC_DOWN) == 0.318;
    assert th_lc_b(TH_LC_DOWN) == 0.286;
    assert th_lc_r(TH_LC_RESTART) == 0.824;
    assert th_lc_g(TH_LC_RESTART) == 0.600;
    assert th_lc_b(TH_LC_RESTART) == 0.133;
    assert th_lc_r(TH_LC_EXIT) == 0.545;
    assert th_lc_g(TH_LC_EXIT) == 0.573;
    assert th_lc_b(TH_LC_EXIT) == 0.620;
    // the neutral sixth row is graph_design's ST_UNKNOWN, reachable only explicitly
    assert th_lc_r(TH_LC_UNKNOWN) == 0.400;
    assert th_lc_g(TH_LC_UNKNOWN) == 0.400;
    assert th_lc_b(TH_LC_UNKNOWN) == 0.400;
}

test the_lifecycle_codes_fall_back_to_exit {
    // codes 0..4 pass through; a code the five-colour band could pass falls to EXIT grey
    assert th_lc_code(TH_LC_NEW) == TH_LC_NEW;
    assert th_lc_code(TH_LC_ACTIVE) == TH_LC_ACTIVE;
    assert th_lc_code(TH_LC_DOWN) == TH_LC_DOWN;
    assert th_lc_code(TH_LC_RESTART) == TH_LC_RESTART;
    assert th_lc_code(TH_LC_EXIT) == TH_LC_EXIT;
    assert th_lc_code(TH_LC_UNKNOWN) == TH_LC_EXIT;
    assert th_lc_code(6) == TH_LC_EXIT;
    assert th_lc_code(99) == TH_LC_EXIT;
    assert th_lc_r(99) == 0.545;
    assert th_lc_g(99) == 0.573;
    assert th_lc_b(99) == 0.620;
}

test the_lifecycle_colours_are_pairwise_distinct {
    var a : u32 = 0;
    while (a < TH_LC_COUNT) {
        var b : u32 = a + 1;
        while (b < TH_LC_COUNT) {
            let same : bool = th_lc_r(a) == th_lc_r(b) and th_lc_g(a) == th_lc_g(b) and th_lc_b(a) == th_lc_b(b);
            assert same == false;
            b = b + 1;
        }
        a = a + 1;
    }
}

test the_graph_design_states_reproduce_from_the_lifecycle {
    // graph_design's state order: 0 working, 1 blocked, 2 done, 3 error, 4 stale, 5 unknown.
    // The first five ARE the lifecycle (WORKING=ACTIVE, BLOCKED=RESTART, DONE=NEW, ERROR=DOWN,
    // STALE=EXIT); unknown takes the neutral row.
    const st_lc : [6]u32 = [TH_LC_ACTIVE, TH_LC_RESTART, TH_LC_NEW, TH_LC_DOWN, TH_LC_EXIT, TH_LC_UNKNOWN];
    const want_r : [6]f64 = [0.345, 0.824, 0.247, 0.973, 0.545, 0.400];
    const want_g : [6]f64 = [0.651, 0.600, 0.725, 0.318, 0.573, 0.400];
    const want_b : [6]f64 = [1.000, 0.133, 0.314, 0.286, 0.620, 0.400];
    var i : u32 = 0;
    while (i < 6) {
        let k : usize = i as usize;
        assert th_lc_r(st_lc[k]) == want_r[k];
        assert th_lc_g(st_lc[k]) == want_g[k];
        assert th_lc_b(st_lc[k]) == want_b[k];
        i = i + 1;
    }
}

test the_lifecycle_rounds_onto_the_web_bytes_except_the_recorded_exit_quirk {
    // green, blue, red and amber round back onto the web set byte for byte
    assert th_near_byte(th_lc_r(TH_LC_NEW) * 255.0, 63);
    assert th_near_byte(th_lc_g(TH_LC_NEW) * 255.0, 185);
    assert th_near_byte(th_lc_b(TH_LC_NEW) * 255.0, 80);
    assert TH_WEB_RGB[TH_WEB_GREEN as usize] == 0x3FB950;
    assert th_near_byte(th_lc_r(TH_LC_ACTIVE) * 255.0, 88);
    assert th_near_byte(th_lc_g(TH_LC_ACTIVE) * 255.0, 166);
    assert th_near_byte(th_lc_b(TH_LC_ACTIVE) * 255.0, 255);
    assert th_near_byte(th_lc_r(TH_LC_DOWN) * 255.0, 248);
    assert th_near_byte(th_lc_g(TH_LC_DOWN) * 255.0, 81);
    assert th_near_byte(th_lc_b(TH_LC_DOWN) * 255.0, 73);
    assert th_near_byte(th_lc_r(TH_LC_RESTART) * 255.0, 210);
    assert th_near_byte(th_lc_g(TH_LC_RESTART) * 255.0, 153);
    assert th_near_byte(th_lc_b(TH_LC_RESTART) * 255.0, 34);
    // the recorded quirk: EXIT is f64 (0.545, 0.573, 0.620) = 0x8B929E, while the muted role is
    // the byte colour 0x8B949E -- the G channel differs by 2/255. Both stay as they are.
    assert th_near_byte(th_lc_r(TH_LC_EXIT) * 255.0, 139);
    assert th_near_byte(th_lc_g(TH_LC_EXIT) * 255.0, 146);
    assert th_near_byte(th_lc_g(TH_LC_EXIT) * 255.0, 148) == false;
    assert th_near_byte(th_lc_b(TH_LC_EXIT) * 255.0, 158);
    assert viz_rgb_g(VIZ_MUTED_RGB) == 148;
}

; ---------------------------------------------------------------- invariants

invariant th_roles_are_the_contract_roles {
    var role : u32 = 0;
    while (role < VIZ_ROLE_COUNT) {
        let rgb : u32 = viz_role_rgb(role);
        assert th_role_r(role) == th_rgb_r(rgb);
        assert th_role_g(role) == th_rgb_g(rgb);
        assert th_role_b(role) == th_rgb_b(rgb);
        role = role + 1;
    }
    assert VIZ_ROLE_COUNT == 6;
    // the label rows are indexed by spec_graph's own label codes, in its own order
    assert TH_LBL_KINDS == (LABEL_KINDS as u32);
    assert LABEL_EXACT == 0;
    assert LABEL_DERIVED == 1;
    assert LABEL_SUGGESTED == 2;
    assert LABEL_UNKNOWN == 3;
    // the lifecycle codes keep the live band's order, plus one neutral row
    assert TH_LC_NEW == 0;
    assert TH_LC_ACTIVE == 1;
    assert TH_LC_DOWN == 2;
    assert TH_LC_RESTART == 3;
    assert TH_LC_EXIT == 4;
    assert TH_LC_COUNT == 6;
    assert TH_WEB_COUNT == 5;
}

invariant th_label_rows_are_distinct {
    var l : u32 = 0;
    while (l < TH_LBL_KINDS) {
        var m : u32 = l + 1;
        while (m < TH_LBL_KINDS) {
            assert TH_LBL_FILL[l as usize] != TH_LBL_FILL[m as usize];
            assert TH_LBL_STROKE[l as usize] != TH_LBL_STROKE[m as usize];
            assert TH_LBL_DASH[l as usize] != TH_LBL_DASH[m as usize];
            m = m + 1;
        }
        assert TH_LBL_STROKE[l as usize] != TH_LBL_FILL[l as usize];
        l = l + 1;
    }
}

invariant th_lifecycle_channels_stay_in_unit_range {
    var c : u32 = 0;
    while (c < TH_LC_COUNT) {
        assert th_lc_r(c) >= 0.0 and th_lc_r(c) <= 1.0;
        assert th_lc_g(c) >= 0.0 and th_lc_g(c) <= 1.0;
        assert th_lc_b(c) >= 0.0 and th_lc_b(c) <= 1.0;
        c = c + 1;
    }
    // a code past the palette still answers inside the range
    assert th_lc_r(99) >= 0.0 and th_lc_r(99) <= 1.0;
    assert th_lc_g(99) >= 0.0 and th_lc_b(99) <= 1.0;
}
