; ---------------------------------------------------------------- constants

/// The six field slots of a t27a word, in focus order. A form uses some of them.
pub const PAV_FIELD_COUNT : u32 = 6;
pub const PAV_F_OPCODE : u32 = 0;
pub const PAV_F_DST : u32 = 1;
pub const PAV_F_SRC1 : u32 = 2;
pub const PAV_F_SRC2 : u32 = 3;
pub const PAV_F_V3 : u32 = 4;
pub const PAV_F_IMM : u32 = 5;
/// "No field", "no bit", "no character": not valid numbers of their kind.
pub const PAV_NO_FIELD : u32 = 65535;
pub const PAV_NO_BIT : u32 = 65535;
pub const PAV_NO_CHAR : u32 = 65535;

/// The fixtures: one word per form (three operands, immediate, two operands, four operands). The
/// text is the source's own assembler syntax; the word is whatever assemble makes of it.
pub const PAV_FIXTURE_COUNT : u32 = 4;
pub const PAV_FIXTURE_TEXT : [4]str = ["ADD t3, t1, t2", "LDI t3, t0, -5", "MOV t3, t1", "BUNDLE3 t3, t1, t2, t4"];
/// One step (no stepper is drawn) and the fixture choice as the param.
pub const PAV_STEPS : u32 = 1;

/// The one petal event, above VIZ_EV_COUNT so it cannot collide with a contract event: flip bit a.
pub const PAV_EV_FLIP : u8 = 32;
/// A fourth highlight: not the hovered or selected entity itself, but part of the same field.
pub const PAV_HL_RELATED : u8 = 3;
/// Error codes the petal gives VIZ_EV_FAILED (the contract reserves 1 for "unspecified").
pub const PAV_ERR_NO_FIXTURE : u8 = 2;
pub const PAV_ERR_BAD_REF : u8 = 3;

/// What a word is, by the layout: an instruction, or the first reason it is not one.
pub const PAV_ST_INSTRUCTION : u32 = 0;
pub const PAV_ST_UNDEFINED : u32 = 1;
pub const PAV_ST_REGISTER : u32 = 2;
pub const PAV_ST_STRAY : u32 = 3;

/// Matrix: 4 rows of 8 cells, the most significant bit first.
pub const PAV_COLS : u32 = 8;
pub const PAV_ROWS : u32 = 4;
/// How long a flip flashes, in ms, before the user's motion preference.
pub const PAV_FLASH_MS : u32 = 160;

/// Pixel geometry in frame coordinates.
pub const PAV_FRAME_W : u32 = 960;
pub const PAV_FRAME_H : u32 = 360;
pub const PAV_BADGE_X : u32 = 20;
pub const PAV_BADGE_Y : u32 = 10;
pub const PAV_BADGE_W : u32 = 300;
pub const PAV_BADGE_H : u32 = 40;
pub const PAV_CELL : u32 = 40;
pub const PAV_MATRIX_X : u32 = 20;
pub const PAV_MATRIX_Y : u32 = 70;
pub const PAV_CHAR_W : u32 = 14;
pub const PAV_SOURCE_X : u32 = 380;
pub const PAV_SOURCE_Y : u32 = 70;
pub const PAV_SOURCE_W : u32 = 560;
pub const PAV_SOURCE_H : u32 = 40;
pub const PAV_INSPECT_X : u32 = 380;
pub const PAV_INSPECT_Y : u32 = 130;
pub const PAV_INSPECT_W : u32 = 560;
pub const PAV_INSPECT_H : u32 = 200;

/// Host slot numbers, in the order pav_host adds them.
pub const PAV_SLOT_BADGE : u32 = 0;
pub const PAV_SLOT_MATRIX : u32 = 1;
pub const PAV_SLOT_SOURCE : u32 = 2;
pub const PAV_SLOT_INSPECTOR : u32 = 3;

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState, the fixture word, and the shown word (the fixture
/// with the reader's flips).
pub struct PavState {
    viz: VizState,
    base: u32,
    word: u32,
}

/// 2^k for k < 32.
pub fn pav_bit(k: u32) -> u32 {
    return (1 as u32) << k;
}

/// The word of fixture i: the source's assemble over the fixture text. 0 past the last fixture.
pub fn pav_fixture_word(i: u32) -> u32 {
    if (i >= PAV_FIXTURE_COUNT) {
        return 0;
    }
    return assemble(PAV_FIXTURE_TEXT[i as usize]);
}

/// A petal ready to explore fixture i: LOAD, then LOADED with the six fields focusable and the truth
/// VERIFIED. A fixture that does not exist fails the load with PAV_ERR_NO_FIXTURE.
pub fn pav_open(i: u32) -> PavState {
    var v : VizState = viz_init(PAV_STEPS, PAV_FIXTURE_COUNT);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    if (i >= PAV_FIXTURE_COUNT) {
        v = viz_apply(v, VIZ_EV_FAILED, PAV_ERR_NO_FIXTURE as u32, 0);
        return PavState { viz: v, base: 0, word: 0 };
    }
    v.param = i;
    v = viz_apply(v, VIZ_EV_LOADED, PAV_FIELD_COUNT, VIZ_TRUTH_VERIFIED as u32);
    let w : u32 = pav_fixture_word(i);
    return PavState { viz: v, base: w, word: w };
}

/// The empty fixture: no word at all. The load finishes with zero items, so the lifecycle is EMPTY.
pub fn pav_open_empty() -> PavState {
    var v : VizState = viz_init(PAV_STEPS, PAV_FIXTURE_COUNT);
    v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
    v = viz_apply(v, VIZ_EV_LOADED, 0, VIZ_TRUTH_UNKNOWN as u32);
    return PavState { viz: v, base: 0, word: 0 };
}

/// True while the view is READY: only then are there entities to hover, select or flip.
pub fn pav_ready(p: PavState) -> bool {
    return p.viz.lifecycle == VIZ_LC_READY;
}

/// w with bit `bit` inverted; w itself when bit is past the word.
pub fn pav_flipped(w: u32, bit: u32) -> u32 {
    if (bit >= WORD_BITS) {
        return w;
    }
    if (pav_cell_value(w, bit) != 0) {
        return w - pav_bit(bit);
    }
    return w + pav_bit(bit);
}

/// Flip one bit of the shown word. Ignored unless the view is READY and bit names a bit. The truth
/// follows the word: DEMO while it differs from the fixture, VERIFIED once it equals it again. A flip
/// bumps the revision once.
pub fn pav_flip(p: PavState, bit: u32) -> PavState {
    if (pav_ready(p) == false or bit >= WORD_BITS) {
        return p;
    }
    var n : PavState = p;
    var v : VizState = p.viz;
    n.word = pav_flipped(p.word, bit);
    if (n.word == p.base) {
        v.truth = VIZ_TRUTH_VERIFIED;
    } else {
        v.truth = VIZ_TRUTH_DEMO;
    }
    v.revision = p.viz.revision + 1;
    n.viz = v;
    return n;
}

/// True when r names an entity of this petal (or nothing): a field slot or a bit of the word.
pub fn pav_ref_ok(r: u32) -> bool {
    if (r == VIZ_REF_NONE) {
        return true;
    }
    if (viz_ref_kind(r) == VIZ_ENT_NODE) {
        return viz_ref_index(r) < PAV_FIELD_COUNT;
    }
    if (viz_ref_kind(r) == VIZ_ENT_CELL) {
        return viz_ref_index(r) < WORD_BITS;
    }
    return false;
}

/// The one reducer of the petal. PAV_EV_FLIP (a = bit) flips a bit; a hover, select or activate of a
/// ref that is no entity of this petal fails the view with PAV_ERR_BAD_REF; PARAM_SET (a = fixture)
/// reloads the chosen fixture; every other event goes to viz_apply. A reload that finishes while the
/// word is flipped reports DEMO, not a truth that may claim a result.
pub fn pav_apply(p: PavState, ev: u8, a: u32, b: u32) -> PavState {
    if (ev == PAV_EV_FLIP) {
        return pav_flip(p, a);
    }
    var n : PavState = p;
    if (pav_ready(p) and (ev == VIZ_EV_HOVER or ev == VIZ_EV_SELECT or ev == VIZ_EV_ACTIVATE) and pav_ref_ok(a) == false) {
        n.viz = viz_apply(p.viz, VIZ_EV_FAILED, PAV_ERR_BAD_REF as u32, 0);
        return n;
    }
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_PARAM_SET and pav_ready(p) and (v.param != p.viz.param or p.word != p.base)) {
        n.base = pav_fixture_word(v.param);
        n.word = n.base;
        v = viz_apply(v, VIZ_EV_LOAD, 0, 0);
        v = viz_apply(v, VIZ_EV_LOADED, PAV_FIELD_COUNT, VIZ_TRUTH_VERIFIED as u32);
    }
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING and p.word != p.base and viz_may_claim(v.truth)) {
        v.truth = VIZ_TRUTH_DEMO;
    }
    n.viz = v;
    return n;
}

; ---------------------------------------------------------------- L3 layout (from the source's shifts)

/// Lowest bit of field f, from the source's own shift constants. WORD_BITS for no such field.
pub fn pav_lo(f: u32) -> u32 {
    if (f == PAV_F_OPCODE) {
        return OPCODE_SHIFT;
    }
    if (f == PAV_F_DST) {
        return DST_SHIFT;
    }
    if (f == PAV_F_SRC1) {
        return SRC1_SHIFT;
    }
    if (f == PAV_F_SRC2) {
        return SRC2_SHIFT;
    }
    if (f == PAV_F_V3) {
        return V3_SHIFT;
    }
    if (f == PAV_F_IMM) {
        return IMM_SHIFT;
    }
    return WORD_BITS;
}

/// Width of field f in the form of opcode op: gaps between the source's shifts. src1 is one bit
/// narrower in the immediate form, where the immediate starts at bit 17.
pub fn pav_width(op: u32, f: u32) -> u32 {
    if (f == PAV_F_OPCODE) {
        return DST_SHIFT - OPCODE_SHIFT;
    }
    if (f == PAV_F_DST) {
        return SRC1_SHIFT - DST_SHIFT;
    }
    if (f == PAV_F_SRC1) {
        if (t27a_imm_form(op)) {
            return IMM_SHIFT - SRC1_SHIFT;
        }
        return SRC2_SHIFT - SRC1_SHIFT;
    }
    if (f == PAV_F_SRC2) {
        return V3_SHIFT - SRC2_SHIFT;
    }
    if (f == PAV_F_V3) {
        return V3_SHIFT - SRC2_SHIFT;
    }
    if (f == PAV_F_IMM) {
        return IMM_BITS;
    }
    return 0;
}

/// Does the form of opcode op carry field f? Opcode, dst and src1 always; the others by form.
pub fn pav_present(op: u32, f: u32) -> bool {
    if (f <= PAV_F_SRC1) {
        return true;
    }
    if (f == PAV_F_SRC2) {
        return t27a_src2_form(op);
    }
    if (f == PAV_F_V3) {
        return op == OP_BUNDLE3;
    }
    if (f == PAV_F_IMM) {
        return t27a_imm_form(op);
    }
    return false;
}

/// The field that owns bit `bit` in the form of opcode op, else PAV_NO_FIELD (an unused bit).
pub fn pav_owner(op: u32, bit: u32) -> u32 {
    var f : u32 = 0;
    while (f < PAV_FIELD_COUNT) {
        if (pav_present(op, f) and bit >= pav_lo(f) and bit < pav_lo(f) + pav_width(op, f)) {
            return f;
        }
        f = f + 1;
    }
    return PAV_NO_FIELD;
}

/// The bits the form of opcode op uses, as a mask.
pub fn pav_owned_mask(op: u32) -> u32 {
    var m : u32 = 0;
    var f : u32 = 0;
    while (f < PAV_FIELD_COUNT) {
        if (pav_present(op, f)) {
            m = m | ((pav_bit(pav_width(op, f)) - 1) << pav_lo(f));
        }
        f = f + 1;
    }
    return m;
}

/// Bit `bit` of w: 0 or 1; 0 past the word.
pub fn pav_cell_value(w: u32, bit: u32) -> u32 {
    if (bit >= WORD_BITS) {
        return 0;
    }
    return (w >> bit) & 1;
}

/// The value of field f in w, read by the layout. 0 for a field the form does not carry.
pub fn pav_field_value(w: u32, f: u32) -> u32 {
    let op : u32 = opcode_of(w);
    if (pav_present(op, f) == false) {
        return 0;
    }
    return (w >> pav_lo(f)) & (pav_bit(pav_width(op, f)) - 1);
}

/// The same value as the source's own reader says it: opcode_of, dst_of, t27a_src1, t27a_src2,
/// v3_of, and the immediate as the source's t27a_imm turned back into its 15 raw bits.
pub fn pav_source_reads(w: u32, f: u32) -> u32 {
    let op : u32 = opcode_of(w);
    if (f == PAV_F_OPCODE) {
        return op;
    }
    if (f == PAV_F_DST) {
        return dst_of(w);
    }
    if (f == PAV_F_SRC1) {
        return t27a_src1(w, op);
    }
    if (f == PAV_F_SRC2) {
        return t27a_src2(w, op);
    }
    if (f == PAV_F_V3) {
        return v3_of(w, op);
    }
    if (f == PAV_F_IMM) {
        return imm_field(t27a_imm(w, op));
    }
    return 0;
}

/// A 15-bit raw immediate as the signed value it stands for (two's complement).
pub fn pav_imm_signed(raw: u32) -> i32 {
    if (raw >= pav_bit(IMM_BITS - 1)) {
        return (raw as i32) - (pav_bit(IMM_BITS) as i32);
    }
    return raw as i32;
}

/// Set bits of w outside every field the form carries: they make a word no instruction.
pub fn pav_stray_count(w: u32) -> u32 {
    let owned : u32 = pav_owned_mask(opcode_of(w));
    var n : u32 = 0;
    var b : u32 = 0;
    while (b < WORD_BITS) {
        if (pav_cell_value(w, b) != 0 and pav_cell_value(owned, b) == 0) {
            n = n + 1;
        }
        b = b + 1;
    }
    return n;
}

/// What w is, by the layout: PAV_ST_INSTRUCTION, or the first reason it is not one (undefined opcode
/// byte, a register field of 27 or more, bits outside the fields). Equal to the source's is_canonical.
pub fn pav_status(w: u32) -> u32 {
    let op : u32 = opcode_of(w);
    if (is_defined_opcode(op) == false) {
        return PAV_ST_UNDEFINED;
    }
    var f : u32 = PAV_F_DST;
    while (f <= PAV_F_V3) {
        if (pav_present(op, f) and pav_field_value(w, f) >= REGISTERS) {
            return PAV_ST_REGISTER;
        }
        f = f + 1;
    }
    if (pav_stray_count(w) != 0) {
        return PAV_ST_STRAY;
    }
    return PAV_ST_INSTRUCTION;
}

/// Does w decode back to w? The source's reassemble reads the listing of w again; it must succeed and
/// give w. It holds for every word: a non-instruction lists as `.word N`.
pub fn pav_round_trips(w: u32) -> bool {
    return reassemble_status(w) == ASM_OK and reassemble(w) == w;
}

; ---------------------------------------------------------------- L2 entities

/// Field slot f as an entity.
pub fn pav_node_ref(f: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, f);
}

/// Bit `bit` of the word as an entity (a matrix cell).
pub fn pav_cell_ref(bit: u32) -> u32 {
    return viz_ref(VIZ_ENT_CELL, bit);
}

/// The field an entity stands for: a field slot is itself, a bit is its owner in the shown word.
/// PAV_NO_FIELD for nothing, an unused bit, another kind of entity, or a view that is not READY.
pub fn pav_field_of(p: PavState, r: u32) -> u32 {
    if (pav_ready(p) == false) {
        return PAV_NO_FIELD;
    }
    if (viz_ref_kind(r) == VIZ_ENT_NODE and viz_ref_index(r) < PAV_FIELD_COUNT) {
        return viz_ref_index(r);
    }
    if (viz_ref_kind(r) == VIZ_ENT_CELL and viz_ref_index(r) < WORD_BITS) {
        return pav_owner(opcode_of(p.word), viz_ref_index(r));
    }
    return PAV_NO_FIELD;
}

/// The field the inspector describes: that of the hovered entity, else that of the selection.
pub fn pav_subject(p: PavState) -> u32 {
    let h : u32 = pav_field_of(p, p.viz.hover);
    if (h != PAV_NO_FIELD) {
        return h;
    }
    return pav_field_of(p, p.viz.selected);
}

/// The entity of focus index f: the field slots in order. VIZ_REF_NONE past the end.
pub fn pav_focus_ref(p: PavState, f: u32) -> u32 {
    if (f >= p.viz.focus_count or f >= PAV_FIELD_COUNT) {
        return VIZ_REF_NONE;
    }
    return pav_node_ref(f);
}

/// ACTIVATE on the focused field: the same as clicking it. Nothing focused is a no-op.
pub fn pav_activate(p: PavState) -> PavState {
    let r : u32 = pav_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    return pav_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// Flip the selected bit. Nothing happens unless the selection is a bit of the word.
pub fn pav_flip_selected(p: PavState) -> PavState {
    let r : u32 = p.viz.selected;
    if (viz_ref_kind(r) == VIZ_ENT_CELL and viz_ref_index(r) < WORD_BITS) {
        return pav_apply(p, PAV_EV_FLIP, viz_ref_index(r), 0);
    }
    return p;
}

; ---------------------------------------------------------------- highlight (what every view reads)

/// How field f is drawn in ANY view: selected, hovered, or neither, whether the pointer or the
/// selection is on the field itself or on one of its bits.
pub fn pav_field_hl(p: PavState, f: u32) -> u8 {
    if (f >= PAV_FIELD_COUNT) {
        return VIZ_HL_NONE;
    }
    if (pav_field_of(p, p.viz.selected) == f) {
        return VIZ_HL_SELECT;
    }
    if (pav_field_of(p, p.viz.hover) == f) {
        return VIZ_HL_HOVER;
    }
    return VIZ_HL_NONE;
}

/// How matrix cell `bit` is drawn: the contract's highlight when the cell itself is hovered or
/// selected, else PAV_HL_RELATED when another bit of its field, or the field, is.
pub fn pav_cell_hl(p: PavState, bit: u32) -> u8 {
    if (pav_ready(p) == false or bit >= WORD_BITS) {
        return VIZ_HL_NONE;
    }
    let h : u8 = viz_highlight(p.viz, pav_cell_ref(bit));
    if (h != VIZ_HL_NONE) {
        return h;
    }
    let f : u32 = pav_owner(opcode_of(p.word), bit);
    if (f != PAV_NO_FIELD and pav_field_hl(p, f) != VIZ_HL_NONE) {
        return PAV_HL_RELATED;
    }
    return VIZ_HL_NONE;
}

; ---------------------------------------------------------------- L4 matrix

/// The bit in row r, column c (row 0 holds bits 31..24). PAV_NO_BIT outside the 4 x 8 matrix.
pub fn pav_cell_bit(r: u32, c: u32) -> u32 {
    if (r >= PAV_ROWS or c >= PAV_COLS) {
        return PAV_NO_BIT;
    }
    return WORD_BITS - 1 - (r * PAV_COLS + c);
}

/// The row of bit `bit`.
pub fn pav_cell_row(bit: u32) -> u32 {
    return (WORD_BITS - 1 - bit) / PAV_COLS;
}

/// The column of bit `bit`.
pub fn pav_cell_col(bit: u32) -> u32 {
    return (WORD_BITS - 1 - bit) % PAV_COLS;
}

/// The bit under the point (frame coordinates); PAV_NO_BIT outside the matrix.
pub fn pav_matrix_bit_at(px: u32, py: u32) -> u32 {
    if (px < PAV_MATRIX_X or py < PAV_MATRIX_Y) {
        return PAV_NO_BIT;
    }
    return pav_cell_bit((py - PAV_MATRIX_Y) / PAV_CELL, (px - PAV_MATRIX_X) / PAV_CELL);
}

/// The entity under the point in the matrix, VIZ_REF_NONE outside it.
pub fn pav_matrix_ref_at(px: u32, py: u32) -> u32 {
    let bit : u32 = pav_matrix_bit_at(px, py);
    if (bit == PAV_NO_BIT) {
        return VIZ_REF_NONE;
    }
    return pav_cell_ref(bit);
}

; ---------------------------------------------------------------- L5 source (the listing)

/// Character k of the shown word's listing, the source's own listing_char; CH_END past its end.
pub fn pav_listing_char(p: PavState, k: u32) -> u32 {
    return listing_char(p.word, k);
}

/// Length of the shown word's listing.
pub fn pav_listing_len(p: PavState) -> u32 {
    return listing_len(p.word);
}

/// Length of the mnemonic in the listing of w: the characters before the first space.
pub fn pav_mnemonic_len(w: u32) -> u32 {
    var k : u32 = 0;
    while (k < LISTING_MAX) {
        let c : u32 = listing_char(w, k);
        if (c == CH_SPACE or c == CH_END) {
            return k;
        }
        k = k + 1;
    }
    return LISTING_MAX;
}

/// The field of operand j of opcode op in the listing: 0 is the mnemonic, 1 dst, 2 src1, 3 the
/// immediate (immediate form) or src2, 4 v3.
pub fn pav_operand_field(op: u32, j: u32) -> u32 {
    if (j == 0) {
        return PAV_F_OPCODE;
    }
    if (j == 1) {
        return PAV_F_DST;
    }
    if (j == 2) {
        return PAV_F_SRC1;
    }
    if (j == 3) {
        if (t27a_imm_form(op)) {
            return PAV_F_IMM;
        }
        return PAV_F_SRC2;
    }
    if (j == 4) {
        return PAV_F_V3;
    }
    return PAV_NO_FIELD;
}

/// The field that character k of the listing of w belongs to, found by reading the listing: the
/// mnemonic, then one operand per comma. PAV_NO_FIELD for a separator, past the end, and for a word
/// that is not an instruction (its `.word N` listing belongs to no single field).
pub fn pav_char_field(w: u32, k: u32) -> u32 {
    if (is_canonical(w) == false or k >= listing_len(w)) {
        return PAV_NO_FIELD;
    }
    let c : u32 = listing_char(w, k);
    if (c == CH_SPACE or c == CH_COMMA) {
        return PAV_NO_FIELD;
    }
    var j : u32 = 0;
    var q : u32 = 0;
    while (q < k) {
        let d : u32 = listing_char(w, q);
        if (d == CH_COMMA or (d == CH_SPACE and j == 0)) {
            j = j + 1;
        }
        q = q + 1;
    }
    return pav_operand_field(opcode_of(w), j);
}

/// How character k of the listing is drawn: as its field is.
pub fn pav_char_hl(p: PavState, k: u32) -> u8 {
    let f : u32 = pav_char_field(p.word, k);
    if (f == PAV_NO_FIELD) {
        return VIZ_HL_NONE;
    }
    return pav_field_hl(p, f);
}

/// The character index under the point in the listing (frame coordinates), PAV_NO_CHAR outside it.
pub fn pav_source_char_at(p: PavState, px: u32, py: u32) -> u32 {
    if (pav_ready(p) == false or px < PAV_SOURCE_X or py < PAV_SOURCE_Y or py >= PAV_SOURCE_Y + PAV_SOURCE_H) {
        return PAV_NO_CHAR;
    }
    let k : u32 = (px - PAV_SOURCE_X) / PAV_CHAR_W;
    if (k >= listing_len(p.word)) {
        return PAV_NO_CHAR;
    }
    return k;
}

/// The entity under the point in the listing: the field slot of the character, else VIZ_REF_NONE.
pub fn pav_source_ref_at(p: PavState, px: u32, py: u32) -> u32 {
    let k : u32 = pav_source_char_at(p, px, py);
    if (k == PAV_NO_CHAR) {
        return VIZ_REF_NONE;
    }
    let f : u32 = pav_char_field(p.word, k);
    if (f == PAV_NO_FIELD) {
        return VIZ_REF_NONE;
    }
    return pav_node_ref(f);
}

; ---------------------------------------------------------------- L6 inspector

/// Does the subject field exist in the shown word's form?
pub fn pav_ins_present(p: PavState) -> bool {
    let f : u32 = pav_subject(p);
    return f != PAV_NO_FIELD and pav_present(opcode_of(p.word), f);
}

/// Lowest bit of the subject field; PAV_NO_BIT when it is absent.
pub fn pav_ins_lo(p: PavState) -> u32 {
    if (pav_ins_present(p) == false) {
        return PAV_NO_BIT;
    }
    return pav_lo(pav_subject(p));
}

/// Width of the subject field in bits; 0 when it is absent.
pub fn pav_ins_width(p: PavState) -> u32 {
    if (pav_ins_present(p) == false) {
        return 0;
    }
    return pav_width(opcode_of(p.word), pav_subject(p));
}

/// Raw value of the subject field; 0 when it is absent.
pub fn pav_ins_value(p: PavState) -> u32 {
    if (pav_ins_present(p) == false) {
        return 0;
    }
    return pav_field_value(p.word, pav_subject(p));
}

/// The subject's value as a signed number: the immediate in two's complement, any other field as it is.
pub fn pav_ins_signed(p: PavState) -> i32 {
    if (pav_ins_present(p) and pav_subject(p) == PAV_F_IMM) {
        return pav_imm_signed(pav_ins_value(p));
    }
    return pav_ins_value(p) as i32;
}

/// The check the inspector shows: the layout's value equals the source's own reader's.
pub fn pav_ins_agrees(p: PavState) -> bool {
    if (pav_ins_present(p) == false) {
        return true;
    }
    return pav_ins_value(p) == pav_source_reads(p.word, pav_subject(p));
}

; ---------------------------------------------------------------- L7 badge

/// The truth the badge shows: the view's own truth while READY, UNKNOWN in every other lifecycle
/// (a view that is empty, loading or failed claims nothing).
pub fn pav_badge(p: PavState) -> u8 {
    if (pav_ready(p) == false) {
        return VIZ_TRUTH_UNKNOWN;
    }
    return p.viz.truth;
}

/// May the view present its numbers as a result? Only LIVE or VERIFIED may.
pub fn pav_may_claim(p: PavState) -> bool {
    return viz_may_claim(pav_badge(p));
}

/// The flash duration of a flip under the user's motion preference: 0 when motion is reduced.
pub fn pav_flash_ms(p: PavState) -> u32 {
    return viz_motion_ms(p.viz, PAV_FLASH_MS);
}

; ---------------------------------------------------------------- L8 host

/// The layout: four views side by side in the frame, each a root slot in focus order.
pub fn pav_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PAV_BADGE_X, PAV_BADGE_Y, PAV_BADGE_W, PAV_BADGE_H);
    h = vh_add(h, VIZ_REP_MATRIX, VH_ROOT, PAV_MATRIX_X, PAV_MATRIX_Y, PAV_COLS * PAV_CELL, PAV_ROWS * PAV_CELL);
    h = vh_add(h, VIZ_REP_SOURCE, VH_ROOT, PAV_SOURCE_X, PAV_SOURCE_Y, PAV_SOURCE_W, PAV_SOURCE_H);
    h = vh_add(h, VIZ_REP_INSPECTOR, VH_ROOT, PAV_INSPECT_X, PAV_INSPECT_Y, PAV_INSPECT_W, PAV_INSPECT_H);
    return h;
}

/// The reps a host uses, as a bit set.
pub fn pav_host_reps(h: VizHost) -> u32 {
    var acc : u32 = 0;
    var left : u32 = h.count;
    if (left > VH_MAX_SLOTS) {
        left = VH_MAX_SLOTS;
    }
    while (left > 0) {
        left = left - 1;
        acc = acc | viz_rep_bit(h.rep[left as usize]);
    }
    return acc;
}

/// The reps of the petal, the plan's row 0: matrix, source, inspector and the truth badge.
pub fn pav_reps() -> u32 {
    return viz_rep_bit(VIZ_REP_MATRIX) | viz_rep_bit(VIZ_REP_SOURCE) | viz_rep_bit(VIZ_REP_INSPECTOR) | viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- the one invariant (no loops: comptime)

invariant the_matrix_covers_the_word_and_the_frame_holds_the_views {
    assert PAV_ROWS * PAV_COLS == WORD_BITS;
    assert LISTING_MAX * PAV_CHAR_W == PAV_SOURCE_W;
    assert PAV_MATRIX_X + PAV_COLS * PAV_CELL <= PAV_SOURCE_X;
    assert PAV_SOURCE_X + PAV_SOURCE_W <= PAV_FRAME_W;
    assert PAV_INSPECT_X + PAV_INSPECT_W <= PAV_FRAME_W;
    assert PAV_INSPECT_Y + PAV_INSPECT_H <= PAV_FRAME_H;
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// A petal that has not loaded: idle, truth UNKNOWN.
fn pav_idle() -> PavState {
    return PavState { viz: viz_init(PAV_STEPS, PAV_FIXTURE_COUNT), base: 0, word: 0 };
}

/// Does the petal's reducer give the contract reducer's answer for this event?
fn pav_matches_reducer(p: PavState, ev: u8, a: u32, b: u32) -> bool {
    let q : PavState = pav_apply(p, ev, a, b);
    let v : VizState = viz_apply(p.viz, ev, a, b);
    return viz_same(q.viz, v) and q.viz.revision == v.revision and q.word == p.word and q.base == p.base;
}

; ---------------------------------------------------------------- tests: state and fixture

test opening_a_fixture_gives_a_ready_view_with_the_fixtures_word {
    const p : PavState = pav_open(0);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.viz.item_count == PAV_FIELD_COUNT;
    assert p.viz.focus_count == PAV_FIELD_COUNT;
    assert p.viz.step_count == PAV_STEPS;
    assert p.viz.param_count == PAV_FIXTURE_COUNT;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.word == p.base;
    assert p.word == t27a_encode(OP_ADD, 3, 1, 2, 0, 0);
}

test the_fixture_words_come_from_the_assembler_and_read_back_as_their_text {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        let w : u32 = pav_fixture_word(i);
        assert assemble_status(PAV_FIXTURE_TEXT[i as usize]) == ASM_OK;
        assert is_canonical(w);
        assert listing_is(w, PAV_FIXTURE_TEXT[i as usize]);
        assert pav_status(w) == PAV_ST_INSTRUCTION;
        i = i + 1;
    }
    assert pav_fixture_word(0) == t27a_encode(OP_ADD, 3, 1, 2, 0, 0);
    assert pav_fixture_word(1) == t27a_encode(OP_LDI, 3, 0, 0, 0, -5);
    assert pav_fixture_word(2) == t27a_encode(OP_MOV, 3, 1, 0, 0, 0);
    assert pav_fixture_word(3) == bundle3_word(3, 1, 2, 4);
    assert pav_fixture_word(PAV_FIXTURE_COUNT) == 0;
}

test every_contract_event_goes_through_the_one_reducer {
    var p : PavState = pav_open(0);
    p = pav_apply(p, VIZ_EV_HOVER, pav_node_ref(PAV_F_DST), 0);
    p = pav_apply(p, VIZ_EV_SELECT, pav_cell_ref(14), 0);
    p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_HOVER, pav_node_ref(PAV_F_SRC2), 0);
    assert pav_matches_reducer(p, VIZ_EV_LEAVE, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_SELECT, pav_cell_ref(14), 0);
    assert pav_matches_reducer(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_OPCODE), 0);
    assert pav_matches_reducer(p, VIZ_EV_CLEAR, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_STEP_SET, 3, 0);
    assert pav_matches_reducer(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_STEP_PREV, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_ACTIVATE, pav_node_ref(PAV_F_V3), 0);
    assert pav_matches_reducer(p, VIZ_EV_BACK, 0, 0);
    assert pav_matches_reducer(p, VIZ_EV_MOTION, 1, 0);
    assert pav_matches_reducer(pav_idle(), VIZ_EV_HOVER, pav_node_ref(PAV_F_DST), 0);
}

; ---------------------------------------------------------------- tests: the layout against the source

test the_matrix_has_four_rows_of_eight_bits_with_the_opcode_in_the_last_row {
    assert pav_cell_bit(0, 0) == 31;
    assert pav_cell_bit(0, 7) == 24;
    assert pav_cell_bit(3, 0) == 7;
    assert pav_cell_bit(3, 7) == 0;
    assert pav_cell_bit(4, 0) == PAV_NO_BIT;
    assert pav_cell_bit(0, 8) == PAV_NO_BIT;
    var b : u32 = 0;
    while (b < WORD_BITS) {
        assert pav_cell_bit(pav_cell_row(b), pav_cell_col(b)) == b;
        b = b + 1;
    }
    var o : u32 = 0;
    while (o < OPCODE_COUNT) {
        let op : u32 = opcode_at(o);
        var k : u32 = 0;
        while (k < PAV_COLS) {
            assert pav_owner(op, pav_cell_bit(3, k)) == PAV_F_OPCODE;
            k = k + 1;
        }
        o = o + 1;
    }
}

test the_matrix_hit_test_is_the_inverse_of_the_cell_layout {
    var r : u32 = 0;
    while (r < PAV_ROWS) {
        var c : u32 = 0;
        while (c < PAV_COLS) {
            let px : u32 = PAV_MATRIX_X + c * PAV_CELL + PAV_CELL / 2;
            let py : u32 = PAV_MATRIX_Y + r * PAV_CELL + PAV_CELL / 2;
            assert pav_matrix_bit_at(px, py) == pav_cell_bit(r, c);
            assert pav_matrix_ref_at(px, py) == pav_cell_ref(pav_cell_bit(r, c));
            c = c + 1;
        }
        r = r + 1;
    }
    assert pav_matrix_bit_at(PAV_MATRIX_X - 1, PAV_MATRIX_Y) == PAV_NO_BIT;
    assert pav_matrix_bit_at(PAV_MATRIX_X, PAV_MATRIX_Y - 1) == PAV_NO_BIT;
    assert pav_matrix_bit_at(PAV_MATRIX_X + PAV_COLS * PAV_CELL, PAV_MATRIX_Y) == PAV_NO_BIT;
    assert pav_matrix_bit_at(PAV_MATRIX_X, PAV_MATRIX_Y + PAV_ROWS * PAV_CELL) == PAV_NO_BIT;
    assert pav_matrix_ref_at(0, 0) == VIZ_REF_NONE;
}

test the_drawn_layout_covers_exactly_the_bits_the_encoder_sets_for_all_47_opcodes {
    var i : u32 = 0;
    while (i < OPCODE_COUNT) {
        let op : u32 = opcode_at(i);
        let all : u32 = t27a_encode(op, REG_MASK, REG_MASK, REG_MASK, REG_MASK, -1);
        assert (all | OPCODE_MASK) == (pav_owned_mask(op) | OPCODE_MASK);
        assert pav_present(op, PAV_F_IMM) == t27a_imm_form(op);
        i = i + 1;
    }
    assert pav_width(OP_ADD, PAV_F_SRC1) == 5;
    assert pav_width(OP_LDI, PAV_F_SRC1) == 4;
    assert pav_width(OP_LDI, PAV_F_IMM) == 15;
    assert pav_present(OP_ADD, PAV_F_V3) == false;
    assert pav_present(OP_BUNDLE3, PAV_F_V3);
    assert pav_present(OP_MOV, PAV_F_SRC2) == false;
}

test every_field_value_equals_the_sources_reader_for_every_one_bit_flip {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        let base : u32 = pav_fixture_word(i);
        var b : u32 = 0;
        while (b <= WORD_BITS) {
            let w : u32 = pav_flipped(base, b);
            var f : u32 = 0;
            while (f < PAV_FIELD_COUNT) {
                assert pav_field_value(w, f) == pav_source_reads(w, f);
                f = f + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
}

test the_status_agrees_with_the_sources_canonical_check_for_every_one_bit_flip {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        let base : u32 = pav_fixture_word(i);
        var b : u32 = 0;
        while (b <= WORD_BITS) {
            let w : u32 = pav_flipped(base, b);
            assert (pav_status(w) == PAV_ST_INSTRUCTION) == is_canonical(w);
            b = b + 1;
        }
        i = i + 1;
    }
    assert pav_flipped(pav_fixture_word(0), WORD_BITS) == pav_fixture_word(0);
    assert pav_flipped(pav_flipped(pav_fixture_word(1), 20), 20) == pav_fixture_word(1);
    let far : u32 = t27a_encode(OP_ADD, 31, 1, 2, 0, 0);
    assert pav_status(far) == PAV_ST_REGISTER;
    assert is_canonical(far) == false;
    assert pav_status(pav_fixture_word(0)) == PAV_ST_INSTRUCTION;
}

; ---------------------------------------------------------------- tests: the source view

test the_source_view_maps_each_character_to_its_field {
    let w : u32 = pav_fixture_word(1);
    assert listing_len(w) == 14;
    assert pav_mnemonic_len(w) == 3;
    assert pav_char_field(w, 0) == PAV_F_OPCODE;
    assert pav_char_field(w, 2) == PAV_F_OPCODE;
    assert pav_char_field(w, 3) == PAV_NO_FIELD;
    assert pav_char_field(w, 4) == PAV_F_DST;
    assert pav_char_field(w, 5) == PAV_F_DST;
    assert pav_char_field(w, 6) == PAV_NO_FIELD;
    assert pav_char_field(w, 7) == PAV_NO_FIELD;
    assert pav_char_field(w, 8) == PAV_F_SRC1;
    assert pav_char_field(w, 9) == PAV_F_SRC1;
    assert pav_char_field(w, 10) == PAV_NO_FIELD;
    assert pav_char_field(w, 12) == PAV_F_IMM;
    assert pav_char_field(w, 13) == PAV_F_IMM;
    assert pav_char_field(w, 14) == PAV_NO_FIELD;
    assert pav_char_field(pav_fixture_word(3), 16) == PAV_F_SRC2;
    assert pav_char_field(pav_fixture_word(3), 18) == PAV_NO_FIELD;
    assert pav_char_field(pav_fixture_word(3), 21) == PAV_F_V3;
}

test the_character_fields_agree_with_the_sources_operand_lengths {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        let w : u32 = pav_fixture_word(i);
        let op : u32 = opcode_of(w);
        var pos : u32 = pav_mnemonic_len(w);
        var k : u32 = 0;
        while (k < pos) {
            assert pav_char_field(w, k) == PAV_F_OPCODE;
            k = k + 1;
        }
        var j : u32 = 1;
        while (j <= operand_count(op)) {
            if (j == 1) {
                pos = pos + 1;
            } else {
                pos = pos + 2;
            }
            let len : u32 = operand_len(w, op, j);
            var q : u32 = 0;
            while (q < len) {
                assert pav_char_field(w, pos + q) == pav_operand_field(op, j);
                q = q + 1;
            }
            pos = pos + len;
            j = j + 1;
        }
        assert pos == listing_len(w);
        i = i + 1;
    }
}

; ---------------------------------------------------------------- tests: linked views

test hovering_a_bit_lights_its_field_in_the_source_and_the_inspector {
    var p : PavState = pav_open(0);
    p = pav_apply(p, VIZ_EV_HOVER, pav_matrix_ref_at(PAV_MATRIX_X + 5 * PAV_CELL + 3, PAV_MATRIX_Y + PAV_CELL + 3), 0);
    assert p.viz.hover == pav_cell_ref(18);
    assert pav_subject(p) == PAV_F_SRC2;
    assert pav_cell_hl(p, 18) == VIZ_HL_HOVER;
    assert pav_cell_hl(p, 22) == PAV_HL_RELATED;
    assert pav_cell_hl(p, 17) == VIZ_HL_NONE;
    assert pav_cell_hl(p, 23) == VIZ_HL_NONE;
    assert pav_char_hl(p, 12) == VIZ_HL_HOVER;
    assert pav_char_hl(p, 13) == VIZ_HL_HOVER;
    assert pav_char_hl(p, 4) == VIZ_HL_NONE;
    assert pav_char_hl(p, 8) == VIZ_HL_NONE;
    assert pav_field_hl(p, PAV_F_SRC2) == VIZ_HL_HOVER;
    assert pav_field_hl(p, PAV_F_DST) == VIZ_HL_NONE;
    assert pav_ins_present(p);
    assert pav_ins_lo(p) == 18;
    assert pav_ins_value(p) == 2;
}

test selecting_in_the_source_lights_the_matrix_and_selection_wins_over_hover {
    var p : PavState = pav_open(0);
    let r : u32 = pav_source_ref_at(p, PAV_SOURCE_X + 8 * PAV_CHAR_W + 2, PAV_SOURCE_Y + 5);
    assert r == pav_node_ref(PAV_F_SRC1);
    p = pav_apply(p, VIZ_EV_SELECT, r, 0);
    assert pav_subject(p) == PAV_F_SRC1;
    var b : u32 = 0;
    while (b < WORD_BITS) {
        if (b >= 13 and b <= 17) {
            assert pav_cell_hl(p, b) == PAV_HL_RELATED;
        } else {
            assert pav_cell_hl(p, b) == VIZ_HL_NONE;
        }
        b = b + 1;
    }
    assert pav_char_hl(p, 8) == VIZ_HL_SELECT;
    assert pav_char_hl(p, 9) == VIZ_HL_SELECT;
    assert pav_char_hl(p, 12) == VIZ_HL_NONE;
    p = pav_apply(p, VIZ_EV_HOVER, pav_node_ref(PAV_F_DST), 0);
    assert pav_field_hl(p, PAV_F_SRC1) == VIZ_HL_SELECT;
    assert pav_field_hl(p, PAV_F_DST) == VIZ_HL_HOVER;
    assert pav_subject(p) == PAV_F_DST;
    p = pav_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert pav_subject(p) == PAV_F_SRC1;
    assert viz_back_closes(p.viz) == false;
    p = pav_apply(p, VIZ_EV_BACK, 0, 0);
    assert viz_back_closes(p.viz);
    assert pav_subject(p) == PAV_NO_FIELD;
}

test the_inspector_reads_the_selected_field_of_an_immediate_word {
    var p : PavState = pav_open(1);
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_IMM), 0);
    assert pav_ins_present(p);
    assert pav_ins_lo(p) == IMM_SHIFT;
    assert pav_ins_width(p) == IMM_BITS;
    assert pav_ins_value(p) == imm_field(-5);
    assert pav_ins_signed(p) == -5;
    assert pav_ins_signed(p) == t27a_imm(p.word, OP_LDI);
    assert pav_ins_agrees(p);
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_SRC1), 0);
    assert pav_ins_width(p) == 4;
    assert pav_ins_value(p) == 0;
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_DST), 0);
    assert pav_ins_value(p) == dst_of(p.word);
    assert pav_ins_signed(p) == 3;
}

test an_absent_field_is_reported_absent_and_lights_nothing {
    var p : PavState = pav_open(0);
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_V3), 0);
    assert pav_subject(p) == PAV_F_V3;
    assert pav_ins_present(p) == false;
    assert pav_ins_width(p) == 0;
    assert pav_ins_lo(p) == PAV_NO_BIT;
    assert pav_ins_value(p) == 0;
    assert pav_field_hl(p, PAV_F_V3) == VIZ_HL_SELECT;
    var b : u32 = 0;
    while (b < WORD_BITS) {
        assert pav_cell_hl(p, b) == VIZ_HL_NONE;
        b = b + 1;
    }
    var k : u32 = 0;
    while (k < pav_listing_len(p)) {
        assert pav_char_hl(p, k) == VIZ_HL_NONE;
        k = k + 1;
    }
}

test the_matrix_cells_add_up_to_the_inspector_value {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        var p : PavState = pav_open(i);
        var f : u32 = 0;
        while (f < PAV_FIELD_COUNT) {
            p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(f), 0);
            var sum : u32 = 0;
            var b : u32 = 0;
            while (b < WORD_BITS) {
                if (pav_cell_hl(p, b) == PAV_HL_RELATED or pav_cell_hl(p, b) == VIZ_HL_SELECT) {
                    sum = sum + pav_cell_value(p.word, b) * pav_bit(b - pav_ins_lo(p));
                }
                b = b + 1;
            }
            assert sum == pav_ins_value(p);
            p = pav_apply(p, VIZ_EV_CLEAR, 0, 0);
            f = f + 1;
        }
        i = i + 1;
    }
}

; ---------------------------------------------------------------- tests: the input change

test flipping_a_dst_bit_recomputes_the_listing_and_matches_the_encoder {
    var p : PavState = pav_open(0);
    let rev : u32 = p.viz.revision;
    p = pav_apply(p, PAV_EV_FLIP, DST_SHIFT, 0);
    let want : u32 = t27a_encode(OP_ADD, 2, 1, 2, 0, 0);
    assert p.word == want;
    assert p.word == assemble("ADD t2, t1, t2");
    assert listing_is(p.word, "ADD t2, t1, t2");
    assert pav_field_value(p.word, PAV_F_DST) == 2;
    assert dst_of(p.word) == 2;
    assert pav_status(p.word) == PAV_ST_INSTRUCTION;
    assert is_canonical(p.word);
    assert pav_round_trips(p.word);
    assert p.viz.revision == rev + 1;
    assert pav_badge(p) == VIZ_TRUTH_DEMO;
    var k : u32 = 0;
    while (k < 15) {
        assert pav_listing_char(p, k) == listing_char(want, k);
        k = k + 1;
    }
    assert pav_listing_len(p) == 14;
    p = pav_apply(p, PAV_EV_FLIP, DST_SHIFT, 0);
    assert p.word == p.base;
    assert p.word == pav_fixture_word(0);
    assert pav_badge(p) == VIZ_TRUTH_VERIFIED;
    assert p.viz.revision == rev + 2;
}

test a_stray_bit_turns_the_listing_into_a_word_directive_that_still_round_trips {
    var p : PavState = pav_open(0);
    p = pav_apply(p, PAV_EV_FLIP, 28, 0);
    assert p.word == p.base + pav_bit(28);
    assert pav_stray_count(p.word) == 1;
    assert pav_stray_count(p.base) == 0;
    assert pav_status(p.word) == PAV_ST_STRAY;
    assert is_canonical(p.word) == false;
    assert pav_listing_char(p, 0) == CH_DOT;
    assert pav_char_field(p.word, 7) == PAV_NO_FIELD;
    assert pav_round_trips(p.word);
    assert reassemble(p.word) == p.word;
    assert pav_round_trips(p.base);
    p = pav_apply(p, VIZ_EV_SELECT, pav_cell_ref(28), 0);
    assert pav_subject(p) == PAV_NO_FIELD;
    assert pav_cell_hl(p, 28) == VIZ_HL_SELECT;
    assert pav_cell_hl(p, 27) == VIZ_HL_NONE;
}

test flipping_opcode_bits_agrees_with_the_source_and_can_reach_an_undefined_opcode {
    let base : u32 = pav_fixture_word(0);
    var b : u32 = OPCODE_SHIFT;
    while (b < DST_SHIFT) {
        let w : u32 = pav_flipped(base, b);
        assert (pav_status(w) == PAV_ST_INSTRUCTION) == is_canonical(w);
        assert pav_round_trips(w);
        assert (pav_status(w) == PAV_ST_UNDEFINED) == (is_defined_opcode(opcode_of(w)) == false);
        b = b + 1;
    }
    let w5 : u32 = pav_flipped(base, 5);
    assert opcode_of(w5) == 48;
    assert pav_status(w5) == PAV_ST_UNDEFINED;
    assert is_canonical(w5) == false;
    let w255 : u32 = base - opcode_of(base) + 255;
    assert pav_status(w255) == PAV_ST_UNDEFINED;
    assert pav_round_trips(w255);
    assert listing_char(w255, 0) == CH_DOT;
}

test every_word_round_trips_for_every_one_bit_flip_of_every_fixture {
    var i : u32 = 0;
    while (i < PAV_FIXTURE_COUNT) {
        let base : u32 = pav_fixture_word(i);
        var b : u32 = 0;
        while (b <= WORD_BITS) {
            assert pav_round_trips(pav_flipped(base, b));
            b = b + 1;
        }
        i = i + 1;
    }
}

test clicking_a_bit_and_flipping_it_changes_that_bit_only {
    var p : PavState = pav_open(2);
    assert pav_flip_selected(p).word == p.word;
    p = pav_apply(p, VIZ_EV_SELECT, pav_cell_ref(9), 0);
    let q : PavState = pav_flip_selected(p);
    assert q.word == pav_flipped(p.word, 9);
    assert q.viz.selected == p.viz.selected;
    assert q.base == p.base;
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_DST), 0);
    assert pav_flip_selected(p).word == p.word;
    assert pav_apply(p, PAV_EV_FLIP, WORD_BITS, 0).word == p.word;
    assert pav_apply(p, PAV_EV_FLIP, WORD_BITS, 0).viz.revision == p.viz.revision;
}

; ---------------------------------------------------------------- tests: truth and lifecycle

test the_badge_is_unknown_until_the_view_is_ready_and_verified_when_it_is {
    var p : PavState = pav_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert pav_badge(p) == VIZ_TRUTH_UNKNOWN;
    p.viz = viz_apply(p.viz, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert pav_badge(p) == VIZ_TRUTH_UNKNOWN;
    assert pav_may_claim(p) == false;
    assert pav_badge(pav_open(0)) == VIZ_TRUTH_VERIFIED;
    assert pav_may_claim(pav_open(0));
    assert pav_badge(pav_open_empty()) == VIZ_TRUTH_UNKNOWN;
    assert pav_badge(pav_open(PAV_FIXTURE_COUNT)) == VIZ_TRUTH_UNKNOWN;
}

test a_flipped_word_may_not_claim_a_result_until_it_is_the_fixture_again {
    var p : PavState = pav_open(3);
    assert pav_may_claim(p);
    p = pav_apply(p, PAV_EV_FLIP, 20, 0);
    assert pav_badge(p) == VIZ_TRUTH_DEMO;
    assert pav_may_claim(p) == false;
    p = pav_apply(p, VIZ_EV_FAILED, 7, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 7;
    assert pav_badge(p) == VIZ_TRUTH_UNKNOWN;
    p = pav_apply(p, VIZ_EV_RETRY, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    p = pav_apply(p, VIZ_EV_LOADED, PAV_FIELD_COUNT, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert pav_badge(p) == VIZ_TRUTH_DEMO;
    assert pav_may_claim(p) == false;
    p = pav_apply(p, PAV_EV_FLIP, 20, 0);
    assert pav_badge(p) == VIZ_TRUTH_VERIFIED;
    assert pav_may_claim(p);
}

test the_empty_fixture_is_empty_and_ignores_input {
    const p : PavState = pav_open_empty();
    assert p.viz.lifecycle == VIZ_LC_EMPTY;
    assert p.viz.item_count == 0;
    assert p.viz.focus_count == 0;
    assert pav_pick_ignored(p, VIZ_EV_HOVER, pav_node_ref(PAV_F_DST));
    assert pav_pick_ignored(p, VIZ_EV_SELECT, pav_cell_ref(3));
    assert pav_pick_ignored(p, VIZ_EV_FOCUS_NEXT, 0);
    assert pav_pick_ignored(p, PAV_EV_FLIP, 4);
    assert pav_source_char_at(p, PAV_SOURCE_X, PAV_SOURCE_Y) == PAV_NO_CHAR;
    assert pav_subject(p) == PAV_NO_FIELD;
    assert pav_cell_hl(p, 0) == VIZ_HL_NONE;
}

test an_out_of_range_ref_fails_the_view_and_a_retry_recovers_it {
    var p : PavState = pav_open(0);
    assert pav_ref_ok(viz_ref(VIZ_ENT_NODE, PAV_FIELD_COUNT - 1));
    assert pav_ref_ok(viz_ref(VIZ_ENT_CELL, WORD_BITS - 1));
    assert pav_ref_ok(viz_ref(VIZ_ENT_NODE, PAV_FIELD_COUNT)) == false;
    assert pav_ref_ok(viz_ref(VIZ_ENT_CELL, WORD_BITS)) == false;
    assert pav_ref_ok(viz_ref(VIZ_ENT_EDGE, 0)) == false;
    assert pav_ref_ok(7) == false;
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_DST), 0);
    let e : PavState = pav_apply(p, VIZ_EV_HOVER, viz_ref(VIZ_ENT_CELL, WORD_BITS), 0);
    assert e.viz.lifecycle == VIZ_LC_ERROR;
    assert e.viz.error == PAV_ERR_BAD_REF;
    assert e.viz.hover == VIZ_REF_NONE;
    assert pav_badge(e) == VIZ_TRUTH_UNKNOWN;
    assert pav_subject(e) == PAV_NO_FIELD;
    assert pav_field_hl(e, PAV_F_DST) == VIZ_HL_NONE;
    assert pav_pick_ignored(e, VIZ_EV_HOVER, pav_node_ref(PAV_F_DST));
    assert pav_apply(p, VIZ_EV_SELECT, viz_ref(VIZ_ENT_NODE, PAV_FIELD_COUNT), 0).viz.error == PAV_ERR_BAD_REF;
    assert pav_apply(p, VIZ_EV_ACTIVATE, viz_ref(VIZ_ENT_EDGE, 1), 0).viz.lifecycle == VIZ_LC_ERROR;
    assert pav_apply(p, VIZ_EV_HOVER, VIZ_REF_NONE, 0).viz.lifecycle == VIZ_LC_READY;
    var r : PavState = pav_apply(e, VIZ_EV_RETRY, 0, 0);
    assert r.viz.lifecycle == VIZ_LC_LOADING;
    r = pav_apply(r, VIZ_EV_LOADED, PAV_FIELD_COUNT, VIZ_TRUTH_VERIFIED as u32);
    assert r.viz.lifecycle == VIZ_LC_READY;
    assert r.word == p.word;
    assert pav_badge(r) == VIZ_TRUTH_VERIFIED;
}

test a_missing_fixture_is_an_error_not_a_blank_word {
    const p : PavState = pav_open(PAV_FIXTURE_COUNT);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == PAV_ERR_NO_FIXTURE;
    assert pav_open(PAV_FIXTURE_COUNT + 5).viz.error == PAV_ERR_NO_FIXTURE;
    assert pav_pick_ignored(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_DST));
    assert pav_open(PAV_FIXTURE_COUNT - 1).viz.lifecycle == VIZ_LC_READY;
}

/// Is the event ignored by the petal: same viz state, same revision, same words?
fn pav_pick_ignored(p: PavState, ev: u8, a: u32) -> bool {
    let q : PavState = pav_apply(p, ev, a, 0);
    return viz_same(q.viz, p.viz) and q.viz.revision == p.viz.revision and q.word == p.word and q.base == p.base;
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_all_six_fields_forward_and_back_and_wraps {
    var p : PavState = pav_open(3);
    assert p.viz.focus == VIZ_NO_FOCUS;
    var i : u32 = 0;
    while (i < PAV_FIELD_COUNT) {
        p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == i;
        assert viz_is_focused(p.viz, i);
        assert pav_focus_ref(p, i) == pav_node_ref(i);
        i = i + 1;
    }
    p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    p = pav_apply(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert p.viz.focus == PAV_FIELD_COUNT - 1;
    var n : u32 = PAV_FIELD_COUNT - 1;
    while (n > 0) {
        p = pav_apply(p, VIZ_EV_FOCUS_PREV, 0, 0);
        n = n - 1;
        assert p.viz.focus == n;
    }
    assert pav_focus_ref(p, PAV_FIELD_COUNT) == VIZ_REF_NONE;
    assert pav_focus_ref(pav_open(0), VIZ_NO_FOCUS) == VIZ_REF_NONE;
}

test activate_selects_the_focused_field_and_again_clears_it {
    var p : PavState = pav_open(0);
    assert pav_activate(p).viz.selected == VIZ_REF_NONE;
    p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pav_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = pav_activate(p);
    assert p.viz.selected == pav_node_ref(PAV_F_SRC1);
    assert pav_subject(p) == PAV_F_SRC1;
    assert pav_field_hl(p, PAV_F_SRC1) == VIZ_HL_SELECT;
    p = pav_activate(p);
    assert p.viz.selected == VIZ_REF_NONE;
    assert pav_subject(p) == PAV_NO_FIELD;
}

test reduced_motion_turns_the_flash_off_and_the_one_step_stays_put {
    var p : PavState = pav_open(0);
    assert pav_flash_ms(p) == PAV_FLASH_MS;
    p = pav_apply(p, VIZ_EV_MOTION, 1, 0);
    assert p.viz.reduced_motion == 1;
    assert pav_flash_ms(p) == 0;
    p = pav_apply(p, VIZ_EV_MOTION, 0, 0);
    assert pav_flash_ms(p) == PAV_FLASH_MS;
    let rev : u32 = p.viz.revision;
    p = pav_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    p = pav_apply(p, VIZ_EV_STEP_SET, 5, 0);
    p = pav_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 0;
    assert p.viz.revision == rev;
}

test param_set_chooses_the_fixture_and_choosing_again_resets_the_flips {
    var p : PavState = pav_open(0);
    p = pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_DST), 0);
    p = pav_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert p.viz.param == 2;
    assert p.word == t27a_encode(OP_MOV, 3, 1, 0, 0, 0);
    assert p.base == p.word;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.item_count == PAV_FIELD_COUNT;
    assert pav_badge(p) == VIZ_TRUTH_VERIFIED;
    assert pav_present(opcode_of(p.word), PAV_F_SRC2) == false;
    assert pav_stray_count(p.word) == 0;
    p = pav_apply(p, PAV_EV_FLIP, 3, 0);
    assert pav_badge(p) == VIZ_TRUTH_DEMO;
    p = pav_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert p.word == p.base;
    assert pav_badge(p) == VIZ_TRUTH_VERIFIED;
    p = pav_apply(p, VIZ_EV_PARAM_SET, 99, 0);
    assert p.viz.param == PAV_FIXTURE_COUNT - 1;
    assert p.word == bundle3_word(3, 1, 2, 4);
    assert pav_ins_agrees(pav_apply(p, VIZ_EV_SELECT, pav_node_ref(PAV_F_V3), 0));
    assert pav_pick_ignored(pav_open_empty(), VIZ_EV_PARAM_SET, 1);
}

; ---------------------------------------------------------------- tests: plan and host

test the_petal_agrees_with_row_zero_of_the_plan {
    assert pav_reps() == pvp_reps(0);
    assert pav_reps() == 298;
    assert viz_plan_ok(pav_reps());
    assert viz_is_linked(pav_reps());
    assert viz_view_count(pav_reps()) == 3;
    assert pvp_truth(0) == pav_badge(pav_open(0));
    assert pvp_is_spec_path(pvp_source(0));
    assert pvp_question(0).len > 0;
}

test the_host_nests_the_four_views_and_hit_testing_agrees_with_the_matrix {
    const h : VizHost = pav_host();
    assert vh_validate(h) == VH_OK;
    assert h.count == 4;
    assert pav_host_reps(h) == pav_reps();
    assert pav_host_reps(h) == pvp_reps(0);
    let px : u32 = PAV_MATRIX_X + 2 * PAV_CELL + 5;
    let py : u32 = PAV_MATRIX_Y + PAV_CELL + 5;
    assert vh_hit(h, px, py) == PAV_SLOT_MATRIX;
    assert pav_matrix_bit_at(px, py) == pav_cell_bit(1, 2);
    assert vh_hit(h, PAV_BADGE_X + 1, PAV_BADGE_Y + 1) == PAV_SLOT_BADGE;
    assert vh_hit(h, PAV_SOURCE_X + 3, PAV_SOURCE_Y + 3) == PAV_SLOT_SOURCE;
    assert vh_hit(h, PAV_INSPECT_X + 1, PAV_INSPECT_Y + 1) == PAV_SLOT_INSPECTOR;
    assert vh_hit(h, 0, 0) == VH_NONE;
    assert vh_hit(h, PAV_FRAME_W, PAV_FRAME_H) == VH_NONE;
}

test the_petal_embeds_in_a_frame_through_the_contracts_host {
    var outer : VizHost = vh_blank();
    outer = vh_add(outer, VIZ_REP_TEXT, VH_ROOT, 0, 0, PAV_FRAME_W + 40, PAV_FRAME_H + 40);
    outer = vh_embed(outer, pav_host(), 0, 20, 20);
    assert vh_validate(outer) == VH_OK;
    assert outer.count == 5;
    assert pav_host_reps(outer) == pav_reps() | viz_rep_bit(VIZ_REP_TEXT);
    assert vh_hit(outer, 20 + PAV_MATRIX_X + 5, 20 + PAV_MATRIX_Y + 5) == 1 + PAV_SLOT_MATRIX;
    assert vh_hit(outer, 5, 5) == 0;
}
