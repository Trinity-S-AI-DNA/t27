// specs/t27f/live_actors_map.t27 -- T27F Live Actors Map improvement loop.
// Part of M7 milestone (milestone #11). Closes #12988.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::live_actors_map;

pub const LIVE_ACTORS_MAP_MAX_ACTORS : u32 = 27;

pub struct ActorMapEntry { actor_id: str, on_map: bool };

pub fn actor_map_entry_on_map(e: ActorMapEntry) -> bool {
    return e.on_map;
}

test "actor_map_entry_on_map" {
    assert(actor_map_entry_on_map(ActorMapEntry { actor_id: "actor-a", on_map: true }));
    assert(!actor_map_entry_on_map(ActorMapEntry { actor_id: "actor-b", on_map: false }));
}

invariant live_actors_map_max_actors_positive {
    assert LIVE_ACTORS_MAP_MAX_ACTORS > 0;
}