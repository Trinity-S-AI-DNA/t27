// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_pulls_viz.t27 -- petal 15 (P PULLS), the interactive visualization of the merge
; judge. Refs epic t27#12173 (issue t27#12340), plan row 15 of specs/t27f/petal_viz_plan.t27.
; Built on the shared contract specs/t27f/viz_contract.t27, in the pattern of the reference petal
; specs/t27f/petal_specs_viz.t27.
; --
; What it answers: "Which pull request may merge now, and which check blocks the others?" The reader
; opens nine fixture pull requests, sees the judge's verdict on each, picks one, steps through the
; rules the judge applies to it in the order it applies them, reads that pull request's facts and the
; check that blocks it, and flips ONE check in every pull request at once (validate, check-linked-issue,
; parse-ratchet, own-language, claw-sarif or spec-guards) to watch the verdicts, the trace and the top
; blocker recompute.
; --
; Source of truth: specs/claw/merge_judge.t27 -- mj_judge (the decision for one pull request),
; merge_plan (the decision for a whole fleet, as text), mj_name_end (where a check name ends) and its
; decision codes J_*, J_CLASS, T_NAMES and T_NLENS -- over specs/claw/queue_cost.t27 (qc_split,
; qc_line_end, qc_range_is, the line splitter). The judge reads a text stream of P, K and B lines. The
; petal writes that stream with the source's own test writers t_p and t_row (private functions of
; merge_judge, imported by name) and hands it to the judge; a rename there breaks this spec at
; typecheck, loudly. No rule is copied: every verdict, blocker and plan line below is a call of those
; functions.
; --
; Recorded petal-side fixture (the source keeps no pull request data, only rules): the nine pull
; requests 101..109 are INPUTS only -- which label, which head branch, whether the pull request
; conflicts, how old its head commit is, and the result of six checks each. They are not live GitHub
; data. 101 and 109 are clean; 102 carries the label no-auto-merge; 103 is a draft; 104 has the head
; branch queen-77; 105 conflicts; 106 has spec-guards still running; 107 has check-linked-issue red;
; 108 pushed 180 seconds ago. claw-sarif is red on every pull request, as the judge treats it:
; informational, never a reason. Master's own result for spec-guards is one more recorded input.
; --
; Layers of this spec:
;   L1 state       PpvState = one VizState (the contract's) + the truth the last load reported;
;                  ppv_apply forwards every event to the one reducer viz_apply and recomputes ONLY the
;                  truth (the flip turns VERIFIED into DEMO and back).
;   L2 entities    pull request i = viz_ref(NODE, i); the focus order is pulls 0..8 (numbers 101..109).
;                  The trace step is the contract's own step (VizState.step).
;   L3 fixture     ppv_put_pr writes one pull request as the judge's text; ppv_stream writes several.
;   L4 judge       ppv_run hands one pull request's text to mj_judge and names the blocking check with
;                  mj_name_end and T_NAMES; ppv_plan hands the whole fleet to merge_plan.
;   L5 flip        the contract's param (0..6): 0 changes nothing; p in 1..6 flips check p-1 in EVERY
;                  pull request (a pass becomes a failure, a non-pass becomes a pass).
;   L6 views       list (one verdict per pull), trace (the 13 rules of the ladder, revealed up to the
;                  current step, the fired one marked), inspector (facts, rule, blocker, top blocker)
;                  and badge (the truth): all four read the ONE VizState.
;   L7 truth       VERIFIED while every shown value is the source's rule over the recorded fixture;
;                  DEMO while a flip is on (viz_may_claim false); CACHED and UNKNOWN are kept as loaded.
;   L8 host        ppv_host: nested VizHost slots for the badge, list, trace and inspector; ppv_reps is
;                  the set of reps it uses and equals the plan's row 15 (308).
; --
; Integer only: no floats. Pixel geometry is in frame coordinates (the origin is the frame's top-left
; corner), so a hit test and ppv_host agree without an offset.
; --
; Not claimed: no host draws this petal yet (wiring it into specs/t27os/glass_window.t27 is the next
; child issue of #12173). The pull requests are a recorded fixture, not the live queue, so a host
; that feeds real ones must report LIVE itself. The BAD check of the judge (an unreadable record,
; checked before the ladder) is not a trace row; it shows as a verdict with every row skipped. No source
; function names the blocker of a PENDING or QUIET pull, so the petal shows none. The cap on merges
; per run (MERGE_CAP) is read, not drawn: the fixture never merges more than two. The plan
; (petal_viz_plan.t27) imports psv_reps from the reference petal, so it does not import ppv_reps from
; here without a module cycle.

module t27f_petal_pulls_viz;

; ---- imports: the judge and its line splitter, then the shared contract, then the plan
use claw::merge_judge::{J_MERGE, J_CAPPED, J_HELD, J_DRAFT, J_BASE, J_BEE, J_CONFLICT, J_UNKNOWN, J_NO_CLOSE};
use claw::merge_judge::{J_UNREAD, J_PENDING, J_REQ_RED, J_REQ_MISSING, J_LOG, J_RED, J_QUIET, J_BAD};
use claw::merge_judge::{J_COUNT, J_CLASS, MJ_PF, MERGE_CAP, QUIET_SECS, T_NAMES, T_NLENS};
use claw::merge_judge::{mj_judge, mj_name_end, merge_plan};
use claw::merge_judge::{t_p, t_row, t_v, t_one, t_g, t_has, t_has_named, t_summary, t_has_log};
use claw::queue_cost::{qc_split, qc_line_end, qc_range_is};
use t27f::viz_contract::{VizState, VizHost, viz_init, viz_apply, viz_same, viz_clamp, viz_ref, viz_ref_kind, viz_ref_index};
use t27f::viz_contract::{viz_highlight, viz_is_focused, viz_truth, viz_may_claim, viz_truth_rgb, viz_motion_ms, viz_back_closes};
use t27f::viz_contract::{viz_rep_bit, viz_plan_ok, viz_is_linked, viz_view_count};
use t27f::viz_contract::{vh_blank, vh_add, vh_embed, vh_validate, vh_hit, vh_depth, vh_abs_x, vh_abs_y};
use t27f::viz_contract::{VIZ_LC_IDLE, VIZ_LC_LOADING, VIZ_LC_READY, VIZ_LC_EMPTY, VIZ_LC_ERROR};
use t27f::viz_contract::{VIZ_TRUTH_LIVE, VIZ_TRUTH_VERIFIED, VIZ_TRUTH_CACHED, VIZ_TRUTH_DEMO, VIZ_TRUTH_UNKNOWN};
use t27f::viz_contract::{VIZ_ENT_NODE, VIZ_ENT_EDGE, VIZ_ENT_CELL, VIZ_REF_NONE, VIZ_NO_FOCUS};
use t27f::viz_contract::{VIZ_HL_NONE, VIZ_HL_HOVER, VIZ_HL_SELECT};
use t27f::viz_contract::{VIZ_EV_LOAD, VIZ_EV_LOADED, VIZ_EV_FAILED, VIZ_EV_RETRY, VIZ_EV_HOVER, VIZ_EV_LEAVE, VIZ_EV_SELECT};
use t27f::viz_contract::{VIZ_EV_CLEAR, VIZ_EV_STEP_SET, VIZ_EV_STEP_NEXT, VIZ_EV_STEP_PREV, VIZ_EV_PARAM_SET};
use t27f::viz_contract::{VIZ_EV_FOCUS_NEXT, VIZ_EV_FOCUS_PREV, VIZ_EV_ACTIVATE, VIZ_EV_BACK, VIZ_EV_MOTION};
use t27f::viz_contract::{VIZ_REP_LIST, VIZ_REP_TRACE, VIZ_REP_INSPECTOR, VIZ_REP_BADGE, VIZ_REP_TEXT};
use t27f::viz_contract::{VH_OK, VH_ROOT, VH_NONE};
use t27f::petal_viz_plan::{pvp_reps, pvp_truth};
use t27f::petal_specs_viz::{psv_host_reps};

; ---------------------------------------------------------------- constants

/// The fixture: nine pull requests (101..109), so nine focusable items.
pub const PPV_RECORD_COUNT : u32 = 9;
/// Trace rows (steps 0..12): the 13 rules of the judge's ladder, in the order it applies them.
pub const PPV_STEPS : u32 = 13;
/// Flip choices: 0 changes nothing, 1..6 each flip one check in every pull request.
pub const PPV_WHATIFS : u32 = 7;
/// The petal's row in the plan (agent letter P, index 15).
pub const PPV_PETAL : u32 = 15;
/// The number of the first fixture pull request; slot i is the pull request PPV_PR_BASE + i.
pub const PPV_PR_BASE : u32 = 101;
/// Checks per pull request, and changed files per pull request (what the judge's P line states).
pub const PPV_CHECKS : u32 = 6;
pub const PPV_FILES : u32 = 2;
/// How many check names the source's table holds (the codes a blocker can have are 0..8).
pub const PPV_CODES : u32 = 9;
/// How many rules the ladder has, and the rule number given to an unreadable record (past the ladder).
pub const PPV_RULES : u32 = 13;
pub const PPV_RULE_BAD : u32 = 13;
/// "No pull request": nothing is hovered or selected, or the ref is not one of the nine.
pub const PPV_NO_RECORD : u32 = 65535;
/// "No decision": a row past the fixture, no pull request under the pointer. Not a verdict.
pub const PPV_NO_VERDICT : u8 = 255;
/// No rule to name (no pull request under the pointer, or a code the ladder does not know).
pub const PPV_NO_RULE : u32 = 255;
/// No blocking check: the pull request is not blocked by a check, or there is no pull request.
pub const PPV_NO_CHECK : u8 = 255;
/// A trace row that is not revealed yet, or has no pull request to describe.
pub const PPV_ROW_HIDDEN : u8 = 255;
/// A trace row the judge passed through, the one that gave the verdict, and one it never reached.
pub const PPV_ROW_PASS : u8 = 0;
pub const PPV_ROW_FIRED : u8 = 1;
pub const PPV_ROW_SKIPPED : u8 = 2;
/// Master's recorded result for spec-guards: no word, green, or red.
pub const PPV_MASTER_NONE : u32 = 0;
pub const PPV_MASTER_GREEN : u32 = 1;
pub const PPV_MASTER_RED : u32 = 2;

/// Pixel geometry in frame coordinates.
pub const PPV_BADGE_X : u32 = 20;
pub const PPV_BADGE_Y : u32 = 10;
pub const PPV_BADGE_W : u32 = 300;
pub const PPV_BADGE_H : u32 = 40;
pub const PPV_LINE_H : u32 = 22;
pub const PPV_LIST_X : u32 = 20;
pub const PPV_LIST_Y : u32 = 60;
pub const PPV_LIST_W : u32 = 440;
pub const PPV_TRACE_X : u32 = 480;
pub const PPV_TRACE_Y : u32 = 60;
pub const PPV_TRACE_W : u32 = 400;
pub const PPV_INSPECT_X : u32 = 900;
pub const PPV_INSPECT_Y : u32 = 60;
pub const PPV_INSPECT_W : u32 = 400;
/// The inspector holds eight lines: number, decision, class, rule, blocker, blocked, age, top blocker.
pub const PPV_INSPECT_LINES : u32 = 8;
pub const PPV_INSPECT_H : u32 = 176;

/// Host slot numbers, in the depth-first order ppv_host adds them (index order is focus order).
pub const PPV_SLOT_BADGE : u32 = 0;
pub const PPV_SLOT_LIST : u32 = 1;
pub const PPV_SLOT_TRACE : u32 = 2;
pub const PPV_SLOT_INSPECTOR : u32 = 3;

; ---------------------------------------------------------------- L3 fixture (inputs only)

/// Whether pull request slot is a draft (slot 2, number 103).
pub fn ppv_is_draft(slot: u32) -> bool {
    return slot == 2;
}

/// The label code the judge's writer takes: 1 is no-auto-merge (slot 1, number 102), 0 is none.
pub fn ppv_labels(slot: u32) -> u32 {
    if (slot == 1) { return 1; }
    return 0;
}

/// The head-branch code: 1 is queen-77, a bee's branch (slot 3, number 104), 0 is feature-x.
pub fn ppv_head(slot: u32) -> u32 {
    if (slot == 3) { return 1; }
    return 0;
}

/// The mergeable code: 1 is CONFLICTING (slot 4, number 105), 0 is MERGEABLE.
pub fn ppv_mergeable(slot: u32) -> u32 {
    if (slot == 4) { return 1; }
    return 0;
}

/// The merge-state code: 1 is DIRTY (slot 4, number 105), 0 is CLEAN.
pub fn ppv_state(slot: u32) -> u32 {
    if (slot == 4) { return 1; }
    return 0;
}

/// Age of the head commit in seconds: 180 for slot 7 (number 108), an hour for every other.
pub fn ppv_age(slot: u32) -> u32 {
    if (slot == 7) { return 180; }
    return 3600;
}

/// The name code of check position k (0..5): validate, check-linked-issue, parse-ratchet,
/// own-language, claw-sarif, spec-guards. These are rows of the source's T_NAMES table.
pub fn ppv_check_code(k: u32) -> u32 {
    if (k < 4) { return k; }
    if (k == 4) { return 5; }
    return 7;
}

/// The recorded result of check position k of pull request slot, before any flip, as the judge's
/// writer codes it (0 success, 1 failure, 3 still running): claw-sarif fails everywhere, slot 5 is
/// still running spec-guards, slot 6 has check-linked-issue red.
pub fn ppv_base_status(slot: u32, k: u32) -> u32 {
    if (k == 4) { return 1; }
    if (slot == 5 and k == 5) { return 3; }
    if (slot == 6 and k == 1) { return 1; }
    return 0;
}

/// The result of check position k of pull request slot under the flip param: param p flips position
/// p-1 (a success becomes a failure, anything else becomes a success); 0 flips nothing.
pub fn ppv_status(slot: u32, k: u32, param: u32) -> u32 {
    let was : u32 = ppv_base_status(slot, k);
    if (param == k + 1) {
        if (was == 0) { return 1; }
        return 0;
    }
    return was;
}

/// Pull request slot written as the judge's text into dst at w: its P line, then its six check rows.
/// Returns the new cursor.
pub fn ppv_put_pr(dst: []u8, cap: usize, w: usize, slot: u32, param: u32) -> usize {
    let num : u32 = PPV_PR_BASE + slot;
    var x : usize = t_p(dst, cap, w, num, ppv_is_draft(slot), ppv_labels(slot), ppv_head(slot), 0, ppv_mergeable(slot), ppv_state(slot), 1, num, ppv_age(slot), PPV_CHECKS, PPV_FILES);
    var k : u32 = 0;
    while (k < PPV_CHECKS) {
        x = t_row(dst, cap, x, 'K', ppv_check_code(k), 1000 + slot * 10 + k, ppv_status(slot, k, param));
        k = k + 1;
    }
    return x;
}

/// The text of pull requests first..last-1 under the flip param, then master's recorded word on
/// spec-guards (a B row, run 9000) unless master is PPV_MASTER_NONE. Returns the bytes written.
pub fn ppv_stream(buf: []u8, cap: usize, first: u32, last: u32, param: u32, master: u32) -> usize {
    var w : usize = 0;
    var s : u32 = first;
    while (s < last) {
        w = ppv_put_pr(buf, cap, w, s, param);
        s = s + 1;
    }
    if (master == PPV_MASTER_GREEN) { w = t_row(buf, cap, w, 'B', 7, 9000, 0); }
    if (master == PPV_MASTER_RED) { w = t_row(buf, cap, w, 'B', 7, 9000, 1); }
    return w;
}

; ---------------------------------------------------------------- L4 judge (every answer is the source's)

/// The decision for the first block of raw[0..n): split its P line as the source does, then mj_judge.
/// det[0] gets the start of the check row a reason names, as the source documents. J_BAD when the
/// P line cannot be split.
pub fn ppv_judge(raw: []const u8, n: usize, det: []usize) -> u8 {
    var fld : [28]usize = undefined;
    if (qc_split(raw, 0, qc_line_end(raw, n, 0), &fld, MJ_PF) == false) {
        return J_BAD;
    }
    return mj_judge(raw, n, 0, n, &fld, det);
}

/// The name code of the check a reason names, found by comparing the row's name with the source's
/// T_NAMES; PPV_NO_CHECK when the decision names no check (only J_REQ_RED, J_LOG and J_RED do).
pub fn ppv_blocker_in(raw: []const u8, d: u8, det: []usize) -> u8 {
    if (d != J_REQ_RED and d != J_LOG and d != J_RED) { return PPV_NO_CHECK; }
    if (det[0] == 0) { return PPV_NO_CHECK; }
    let nend : usize = mj_name_end(raw, det[0]);
    var c : u32 = 0;
    while (c < PPV_CODES) {
        if (qc_range_is(raw, det[0] + 2, nend, T_NAMES[c as usize], T_NLENS[c as usize])) {
            return c as u8;
        }
        c = c + 1;
    }
    return PPV_NO_CHECK;
}

/// Judge pull request slot alone under the flip param and master's word. Returns the decision, or
/// PPV_NO_VERDICT past the fixture; res[0] gets the blocking check's name code or PPV_NO_CHECK.
pub fn ppv_run(slot: u32, param: u32, master: u32, res: []u8) -> u8 {
    res[0] = PPV_NO_CHECK;
    if (slot >= PPV_RECORD_COUNT) {
        return PPV_NO_VERDICT;
    }
    var buf : [2048]u8 = undefined;
    var det : [2]usize = undefined;
    det[0] = 0;
    det[1] = 0;
    let w : usize = ppv_stream(&buf, 2048, slot, slot + 1, param, master);
    let d : u8 = ppv_judge(&buf, w, &det);
    res[0] = ppv_blocker_in(&buf, d, &det);
    return d;
}

/// The decision for pull request slot under the flip param and master's word.
pub fn ppv_decision_with(slot: u32, param: u32, master: u32) -> u8 {
    var res : [1]u8 = undefined;
    return ppv_run(slot, param, master, &res);
}

/// The blocking check of pull request slot under the flip param and master's word.
pub fn ppv_blocker_with(slot: u32, param: u32, master: u32) -> u8 {
    var res : [1]u8 = undefined;
    let d : u8 = ppv_run(slot, param, master, &res);
    if (d == PPV_NO_VERDICT) { return PPV_NO_CHECK; }
    return res[0];
}

/// The decision for pull request slot under the flip param, master green on spec-guards.
pub fn ppv_decision(slot: u32, param: u32) -> u8 {
    return ppv_decision_with(slot, param, PPV_MASTER_GREEN);
}

/// The blocking check of pull request slot under the flip param, master green on spec-guards.
pub fn ppv_blocker(slot: u32, param: u32) -> u8 {
    return ppv_blocker_with(slot, param, PPV_MASTER_GREEN);
}

/// The whole fleet as the judge's text: all nine pull requests, then master's word.
pub fn ppv_fleet(buf: []u8, cap: usize, param: u32, master: u32) -> usize {
    return ppv_stream(buf, cap, 0, PPV_RECORD_COUNT, param, master);
}

/// The source's plan for the whole fleet (G, H, W, N lines, L lines and the summary) into out.
/// Returns the bytes merge_plan needs; larger than cap means the answer is clipped.
pub fn ppv_plan(param: u32, master: u32, out: []u8, cap: usize) -> usize {
    var raw : [8192]u8 = undefined;
    let n : usize = ppv_fleet(&raw, 8192, param, master);
    return merge_plan(&raw, n, out, cap);
}

/// How many pull requests the judge lets merge under the flip param.
pub fn ppv_merge_total(param: u32) -> u32 {
    var cnt : u32 = 0;
    var s : u32 = 0;
    while (s < PPV_RECORD_COUNT) {
        if (ppv_decision(s, param) == J_MERGE) {
            cnt = cnt + 1;
        }
        s = s + 1;
    }
    return cnt;
}

/// How many pull requests are blocked by the check with name code `code` under the flip param.
pub fn ppv_blocked_by(code: u8, param: u32) -> u32 {
    var cnt : u32 = 0;
    var s : u32 = 0;
    while (s < PPV_RECORD_COUNT) {
        if (ppv_blocker(s, param) == code) {
            cnt = cnt + 1;
        }
        s = s + 1;
    }
    return cnt;
}

/// The check that blocks the most pull requests under the flip param (a tie goes to the lowest
/// name code); PPV_NO_CHECK when no check blocks any.
pub fn ppv_top_blocker(param: u32) -> u8 {
    var tally : [9]u32 = undefined;
    var c : u32 = 0;
    while (c < PPV_CODES) {
        tally[c as usize] = 0;
        c = c + 1;
    }
    var s : u32 = 0;
    while (s < PPV_RECORD_COUNT) {
        let b : u8 = ppv_blocker(s, param);
        if (b != PPV_NO_CHECK) {
            tally[b as usize] = tally[b as usize] + 1;
        }
        s = s + 1;
    }
    var best : u8 = PPV_NO_CHECK;
    var most : u32 = 0;
    c = 0;
    while (c < PPV_CODES) {
        if (tally[c as usize] > most) {
            most = tally[c as usize];
            best = c as u8;
        }
        c = c + 1;
    }
    return best;
}

/// The position of a decision on the judge's ladder (0..12): held, draft, base, bee, conflict or
/// unknown, no closing reference, unread, pending, required red, required missing, log or red,
/// quiet, merge or capped. PPV_RULE_BAD for J_BAD, PPV_NO_RULE for any other code.
pub fn ppv_rule_of(d: u8) -> u32 {
    if (d == J_HELD) { return 0; }
    if (d == J_DRAFT) { return 1; }
    if (d == J_BASE) { return 2; }
    if (d == J_BEE) { return 3; }
    if (d == J_CONFLICT or d == J_UNKNOWN) { return 4; }
    if (d == J_NO_CLOSE) { return 5; }
    if (d == J_UNREAD) { return 6; }
    if (d == J_PENDING) { return 7; }
    if (d == J_REQ_RED) { return 8; }
    if (d == J_REQ_MISSING) { return 9; }
    if (d == J_LOG or d == J_RED) { return 10; }
    if (d == J_QUIET) { return 11; }
    if (d == J_MERGE or d == J_CAPPED) { return 12; }
    if (d == J_BAD) { return PPV_RULE_BAD; }
    return PPV_NO_RULE;
}

/// Trace row k when the fired rule is r: rows before it passed, row r fired, rows after it were
/// never reached. A rule outside the ladder (unreadable, unknown) leaves every row skipped.
pub fn ppv_trace_row(r: u32, k: u32) -> u8 {
    if (r >= PPV_RULES) { return PPV_ROW_SKIPPED; }
    if (k < r) { return PPV_ROW_PASS; }
    if (k == r) { return PPV_ROW_FIRED; }
    return PPV_ROW_SKIPPED;
}

/// The source's class letter of a decision (G merge, W waiting, H held, N not mine); 0 for a code
/// outside the table.
pub fn ppv_class_of(d: u8) -> u8 {
    let di : usize = d as usize;
    if (di >= J_COUNT) { return 0; }
    return J_CLASS[di];
}

; ---------------------------------------------------------------- L1 state

/// The petal state: the contract's one VizState and the truth the last load reported.
pub struct PpvState {
    viz: VizState,
    base: u8,
}

/// The truth shown for a loaded truth and a flip: a claimable truth (LIVE or VERIFIED) becomes
/// DEMO while a flip is on; CACHED, DEMO and UNKNOWN are kept as loaded.
pub fn ppv_truth_for(base: u8, flip: u32) -> u8 {
    if (flip > 0 and viz_may_claim(base)) {
        return VIZ_TRUTH_DEMO;
    }
    return base;
}

/// The one reducer of the petal. Every event goes to viz_apply; only the truth is recomputed
/// afterwards, when a load finishes (the new base) or the flip moves. A reload that finishes
/// while a flip is on reports DEMO instead of a truth that may claim a result.
pub fn ppv_apply(p: PpvState, ev: u8, a: u32, b: u32) -> PpvState {
    var n : PpvState = p;
    var v : VizState = viz_apply(p.viz, ev, a, b);
    if (ev == VIZ_EV_LOADED and p.viz.lifecycle == VIZ_LC_LOADING) {
        n.base = v.truth;
    }
    if (ev == VIZ_EV_LOADED or ev == VIZ_EV_PARAM_SET) {
        v.truth = ppv_truth_for(n.base, v.param);
    }
    n.viz = v;
    return n;
}

/// Whether the shown truth is the one the rule gives for the loaded truth and the flip.
pub fn ppv_truth_holds(p: PpvState) -> bool {
    return p.viz.truth == ppv_truth_for(p.base, p.viz.param);
}

/// A petal that has not loaded: idle, truth UNKNOWN, no flip.
pub fn ppv_idle() -> PpvState {
    return PpvState { viz: viz_init(PPV_STEPS, PPV_WHATIFS), base: VIZ_TRUTH_UNKNOWN };
}

/// A petal opened on the first n pull requests (at most all nine): LOAD, then LOADED. Nine load
/// VERIFIED; an empty fixture loads UNKNOWN, because nothing was read.
pub fn ppv_open_n(n: u32) -> PpvState {
    var count : u32 = n;
    var truth : u8 = VIZ_TRUTH_VERIFIED;
    if (count > PPV_RECORD_COUNT) {
        count = PPV_RECORD_COUNT;
    }
    if (count == 0) {
        truth = VIZ_TRUTH_UNKNOWN;
    }
    var p : PpvState = ppv_apply(ppv_idle(), VIZ_EV_LOAD, 0, 0);
    p = ppv_apply(p, VIZ_EV_LOADED, count, truth as u32);
    return p;
}

/// A petal ready to explore: all nine pull requests, truth VERIFIED, 13 steps, 7 flips.
pub fn ppv_open() -> PpvState {
    return ppv_open_n(PPV_RECORD_COUNT);
}

; ---------------------------------------------------------------- L2 entities

/// Pull request i as an entity: viz_ref(NODE, i).
pub fn ppv_pr_ref(i: u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, i);
}

/// The pull request a ref names when it is a node below `rows`, else PPV_NO_RECORD.
pub fn ppv_pr_at(r: u32, rows: u32) -> u32 {
    if (viz_ref_kind(r) == VIZ_ENT_NODE and viz_ref_index(r) < rows) {
        return viz_ref_index(r);
    }
    return PPV_NO_RECORD;
}

/// The pull requests the views show: all loaded ones while READY, none while loading, empty or failed.
pub fn ppv_rows(p: PpvState) -> u32 {
    if (p.viz.lifecycle != VIZ_LC_READY) {
        return 0;
    }
    if (p.viz.item_count > PPV_RECORD_COUNT) {
        return PPV_RECORD_COUNT;
    }
    return p.viz.item_count;
}

/// The entity of focus index f: pulls 0..8. VIZ_REF_NONE past the end.
pub fn ppv_focus_ref(p: PpvState, f: u32) -> u32 {
    if (f >= p.viz.focus_count or f >= PPV_RECORD_COUNT) {
        return VIZ_REF_NONE;
    }
    return ppv_pr_ref(f);
}

/// ACTIVATE on the focused item: the same as clicking it. Nothing focused is a no-op.
pub fn ppv_activate(p: PpvState) -> PpvState {
    let r : u32 = ppv_focus_ref(p, p.viz.focus);
    if (r == VIZ_REF_NONE) {
        return p;
    }
    return ppv_apply(p, VIZ_EV_ACTIVATE, r, 0);
}

/// The pull request the trace and the inspector describe: the hovered one if there is one, else the
/// selected one, else PPV_NO_RECORD.
pub fn ppv_subject(p: PpvState) -> u32 {
    let rows : u32 = ppv_rows(p);
    let h : u32 = ppv_pr_at(p.viz.hover, rows);
    if (h != PPV_NO_RECORD) {
        return h;
    }
    return ppv_pr_at(p.viz.selected, rows);
}

; ---------------------------------------------------------------- L6 views: list

/// The list line of pull i: the judge's decision under the current flip; PPV_NO_VERDICT past the rows.
pub fn ppv_list_verdict(p: PpvState, i: u32) -> u8 {
    if (i >= ppv_rows(p)) {
        return PPV_NO_VERDICT;
    }
    return ppv_decision(i, p.viz.param);
}

/// The class letter of the list line of pull i (G, W, H or N); 0 past the rows.
pub fn ppv_list_class(p: PpvState, i: u32) -> u8 {
    if (i >= ppv_rows(p)) {
        return 0;
    }
    return ppv_class_of(ppv_decision(i, p.viz.param));
}

/// How the list draws pull i: the contract's one highlight rule; none past the rows.
pub fn ppv_list_hl(p: PpvState, i: u32) -> u8 {
    if (i >= ppv_rows(p)) {
        return VIZ_HL_NONE;
    }
    return viz_highlight(p.viz, ppv_pr_ref(i));
}

/// The inverse of the list layout: the pull under a pixel (frame coordinates), else VIZ_REF_NONE.
pub fn ppv_list_hit(p: PpvState, px: u32, py: u32) -> u32 {
    if (px < PPV_LIST_X or px >= PPV_LIST_X + PPV_LIST_W or py < PPV_LIST_Y) {
        return VIZ_REF_NONE;
    }
    let i : u32 = (py - PPV_LIST_Y) / PPV_LINE_H;
    if (i >= ppv_rows(p)) {
        return VIZ_REF_NONE;
    }
    return ppv_pr_ref(i);
}

; ---------------------------------------------------------------- L6 views: trace

/// How many trace rows are revealed: none without a subject, else the steps up to the current one.
pub fn ppv_trace_shown(p: PpvState) -> u32 {
    if (ppv_subject(p) == PPV_NO_RECORD) {
        return 0;
    }
    return viz_clamp(p.viz.step, PPV_STEPS) + 1;
}

/// Trace row k of the subject under the current flip: PPV_ROW_PASS, PPV_ROW_FIRED or
/// PPV_ROW_SKIPPED; PPV_ROW_HIDDEN while the row is past the current step or there is no subject.
pub fn ppv_trace_value(p: PpvState, k: u32) -> u8 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD or k >= ppv_trace_shown(p)) {
        return PPV_ROW_HIDDEN;
    }
    return ppv_trace_row(ppv_rule_of(ppv_decision(s, p.viz.param)), k);
}

; ---------------------------------------------------------------- L6 views: inspector

/// The number of the subject (101..109); PPV_NO_RECORD without a subject.
pub fn ppv_inspect_number(p: PpvState) -> u32 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD) {
        return PPV_NO_RECORD;
    }
    return PPV_PR_BASE + s;
}

/// The judge's decision on the subject under the current flip; PPV_NO_VERDICT without a subject.
pub fn ppv_inspect_decision(p: PpvState) -> u8 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD) {
        return PPV_NO_VERDICT;
    }
    return ppv_decision(s, p.viz.param);
}

/// The class letter of the subject's decision; 0 without a subject.
pub fn ppv_inspect_class(p: PpvState) -> u8 {
    return ppv_class_of(ppv_inspect_decision(p));
}

/// The rule that gave the subject's decision (0..12); PPV_NO_RULE without a subject.
pub fn ppv_inspect_rule(p: PpvState) -> u32 {
    if (ppv_subject(p) == PPV_NO_RECORD) {
        return PPV_NO_RULE;
    }
    return ppv_rule_of(ppv_inspect_decision(p));
}

/// The check that blocks the subject (a name code of the source's table); PPV_NO_CHECK when no check
/// does or there is no subject.
pub fn ppv_inspect_blocker(p: PpvState) -> u8 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD) {
        return PPV_NO_CHECK;
    }
    return ppv_blocker(s, p.viz.param);
}

/// How many pull requests the subject's blocking check blocks (itself included); 0 when no check
/// blocks the subject.
pub fn ppv_inspect_blocked(p: PpvState) -> u32 {
    let b : u8 = ppv_inspect_blocker(p);
    if (b == PPV_NO_CHECK) {
        return 0;
    }
    return ppv_blocked_by(b, p.viz.param);
}

/// The age of the subject's head commit in seconds; PPV_NO_RECORD without a subject.
pub fn ppv_inspect_age(p: PpvState) -> u32 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD) {
        return PPV_NO_RECORD;
    }
    return ppv_age(s);
}

/// The result of check position k of the subject under the current flip (0 success, 1 failure,
/// 3 running); PPV_NO_RECORD without a subject or for k past the six checks.
pub fn ppv_inspect_check_status(p: PpvState, k: u32) -> u32 {
    let s : u32 = ppv_subject(p);
    if (s == PPV_NO_RECORD or k >= PPV_CHECKS) {
        return PPV_NO_RECORD;
    }
    return ppv_status(s, k, p.viz.param);
}

/// The check that blocks the most pull requests of the whole fleet under the current flip;
/// PPV_NO_CHECK unless the petal is READY with at least one pull request.
pub fn ppv_inspect_top(p: PpvState) -> u8 {
    if (ppv_rows(p) == 0) {
        return PPV_NO_CHECK;
    }
    return ppv_top_blocker(p.viz.param);
}

; ---------------------------------------------------------------- L7 truth: the badge

/// The truth the badge shows: the state's truth, an unknown code read as UNKNOWN.
pub fn ppv_badge(p: PpvState) -> u8 {
    return viz_truth(p.viz.truth);
}

/// The badge colour, 0xRRGGBB, from the contract's table.
pub fn ppv_badge_rgb(p: PpvState) -> u32 {
    return viz_truth_rgb(ppv_badge(p));
}

/// Whether the petal may present its numbers as a result: true only for LIVE or VERIFIED.
pub fn ppv_badge_claims(p: PpvState) -> bool {
    return viz_may_claim(ppv_badge(p));
}

; ---------------------------------------------------------------- L8 host

/// The layout: the badge, then the list, the trace and the inspector, all root slots (the petal is
/// not wrapped in a frame, so it embeds under any slot of another host). Frame coordinates.
pub fn ppv_host() -> VizHost {
    var h : VizHost = vh_blank();
    h = vh_add(h, VIZ_REP_BADGE, VH_ROOT, PPV_BADGE_X, PPV_BADGE_Y, PPV_BADGE_W, PPV_BADGE_H);
    h = vh_add(h, VIZ_REP_LIST, VH_ROOT, PPV_LIST_X, PPV_LIST_Y, PPV_LIST_W, PPV_RECORD_COUNT * PPV_LINE_H);
    h = vh_add(h, VIZ_REP_TRACE, VH_ROOT, PPV_TRACE_X, PPV_TRACE_Y, PPV_TRACE_W, PPV_STEPS * PPV_LINE_H);
    h = vh_add(h, VIZ_REP_INSPECTOR, VH_ROOT, PPV_INSPECT_X, PPV_INSPECT_Y, PPV_INSPECT_W, PPV_INSPECT_H);
    return h;
}

/// The reps of the petal: list, trace, inspector and the truth badge. The plan's row 15 holds 308.
pub fn ppv_reps() -> u32 {
    let views : u32 = viz_rep_bit(VIZ_REP_LIST) + viz_rep_bit(VIZ_REP_TRACE) + viz_rep_bit(VIZ_REP_INSPECTOR);
    return views + viz_rep_bit(VIZ_REP_BADGE);
}

; ---------------------------------------------------------------- test helpers (not part of the API)

/// The petal's reducer and the contract's agree on the event, and the event changed the state.
fn ppv_t_routes(p: PpvState, ev: u8, a: u32, b: u32) -> bool {
    let mine : PpvState = ppv_apply(p, ev, a, b);
    let theirs : VizState = viz_apply(p.viz, ev, a, b);
    return viz_same(mine.viz, theirs) and mine.viz.revision == theirs.revision and viz_same(mine.viz, p.viz) == false;
}

/// An open petal with flip k switched on, through the reducer.
fn ppv_t_param(k: u32) -> PpvState {
    return ppv_apply(ppv_open(), VIZ_EV_PARAM_SET, k, 0);
}

/// Pull i selected in p, through the reducer.
fn ppv_t_select(p: PpvState, i: u32) -> PpvState {
    return ppv_apply(p, VIZ_EV_SELECT, ppv_pr_ref(i), 0);
}

/// Reload p: LOAD, then LOADED with n items and the truth t.
fn ppv_t_reload(p: PpvState, n: u32, t: u8) -> PpvState {
    let loading : PpvState = ppv_apply(p, VIZ_EV_LOAD, 0, 0);
    return ppv_apply(loading, VIZ_EV_LOADED, n, t as u32);
}

/// The judge's decision for one pull request written by the source's own writer t_v (five good
/// checks, number 5) with the given facts.
fn ppv_t_rule(draft: bool, labels: u32, head: u32, base: u32, mg: u32, sc: u32, closing: u32, age: u32) -> u8 {
    var raw : [4096]u8 = undefined;
    let n : usize = t_v(&raw, 4096, draft, labels, head, base, mg, sc, closing, age);
    return t_one(&raw, n);
}

/// The decision for a pull request with five check rows, the last still running, and a P line that
/// states `total` rows: 5 reads as pending, any other count as an unreadable rollup.
fn ppv_t_pending(total: u32) -> u8 {
    var raw : [2048]u8 = undefined;
    var x : usize = t_p(&raw, 2048, 0, 5, false, 0, 0, 0, 0, 0, 1, 5, 3600, total, 2);
    var k : u32 = 0;
    while (k < 5) {
        var code : u32 = 7;
        var st : u32 = 0;
        if (k < 4) { code = k; }
        if (k == 4) { st = 3; }
        x = t_row(&raw, 2048, x, 'K', code, 100 + k, st);
        k = k + 1;
    }
    return t_one(&raw, x);
}

/// Pull request 101 written by hand, row by row, with the literal run ids and codes, not through the
/// petal's own fixture functions. first_status is the result of the validate row.
fn ppv_t_literal_raw(raw: []u8, cap: usize, first_status: u32) -> usize {
    var x : usize = t_p(raw, cap, 0, 101, false, 0, 0, 0, 0, 0, 1, 101, 3600, 6, 2);
    x = t_row(raw, cap, x, 'K', 0, 1000, first_status);
    x = t_row(raw, cap, x, 'K', 1, 1001, 0);
    x = t_row(raw, cap, x, 'K', 2, 1002, 0);
    x = t_row(raw, cap, x, 'K', 3, 1003, 0);
    x = t_row(raw, cap, x, 'K', 5, 1004, 1);
    return t_row(raw, cap, x, 'K', 7, 1005, 0);
}

/// The source's decision for the hand-written pull request 101.
fn ppv_t_literal(first_status: u32) -> u8 {
    var raw : [2048]u8 = undefined;
    let n : usize = ppv_t_literal_raw(&raw, 2048, first_status);
    return t_one(&raw, n);
}

/// Whether the fleet plan under (param, master) holds the line of class c, pull num and decision d.
fn ppv_t_fleet_has(param: u32, master: u32, c: u8, num: u32, d: u8) -> bool {
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(param, master, &out, 4096);
    return t_has(&out, m, c, num, d);
}

; ---------------------------------------------------------------- tests: state (one VizState, one reducer)

test a_fresh_petal_is_idle_and_unknown {
    let p : PpvState = ppv_idle();
    assert p.viz.lifecycle == VIZ_LC_IDLE;
    assert p.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert p.base == VIZ_TRUTH_UNKNOWN;
    assert p.viz.revision == 0;
    assert p.viz.step_count == PPV_STEPS;
    assert p.viz.param_count == PPV_WHATIFS;
    assert ppv_rows(p) == 0;
    assert ppv_badge_claims(p) == false;
    assert ppv_truth_holds(p);
}

test open_loads_the_nine_pulls_with_the_truth_verified {
    let p : PpvState = ppv_open();
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert p.viz.item_count == 9;
    assert p.viz.focus_count == 9;
    assert ppv_rows(p) == PPV_RECORD_COUNT;
    assert p.viz.truth == VIZ_TRUTH_VERIFIED;
    assert p.base == VIZ_TRUTH_VERIFIED;
    assert p.viz.hover == VIZ_REF_NONE;
    assert p.viz.selected == VIZ_REF_NONE;
    assert p.viz.focus == VIZ_NO_FOCUS;
    assert p.viz.step == 0;
    assert p.viz.param == 0;
    assert p.viz.revision == 2;
    assert ppv_truth_holds(p);
}

test every_event_goes_through_the_one_reducer {
    let p : PpvState = ppv_open();
    assert ppv_t_routes(p, VIZ_EV_HOVER, ppv_pr_ref(2), 0);
    assert ppv_t_routes(p, VIZ_EV_SELECT, ppv_pr_ref(3), 0);
    assert ppv_t_routes(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert ppv_t_routes(p, VIZ_EV_STEP_SET, 3, 0);
    assert ppv_t_routes(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert ppv_t_routes(p, VIZ_EV_FOCUS_PREV, 0, 0);
    assert ppv_t_routes(p, VIZ_EV_MOTION, 1, 0);
    // The flip event: the contract's parameter and revision, plus the recomputed truth.
    let q : PpvState = ppv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    let r : VizState = viz_apply(p.viz, VIZ_EV_PARAM_SET, 5, 0);
    assert q.viz.param == r.param;
    assert q.viz.revision == r.revision;
    assert q.viz.revision == p.viz.revision + 1;
    assert r.truth == VIZ_TRUTH_VERIFIED;
    assert q.viz.truth == VIZ_TRUTH_DEMO;
}

test hover_select_back_and_clear_edit_the_one_state {
    var p : PpvState = ppv_open();
    p = ppv_apply(p, VIZ_EV_HOVER, ppv_pr_ref(2), 0);
    assert p.viz.hover == ppv_pr_ref(2);
    p = ppv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert p.viz.hover == VIZ_REF_NONE;
    p = ppv_t_select(p, 4);
    assert p.viz.selected == ppv_pr_ref(4);
    assert viz_back_closes(p.viz) == false;
    // Selecting the selected pull clears it; selecting another switches.
    p = ppv_t_select(p, 4);
    assert p.viz.selected == VIZ_REF_NONE;
    p = ppv_t_select(p, 4);
    p = ppv_t_select(p, 5);
    assert p.viz.selected == ppv_pr_ref(5);
    p = ppv_apply(p, VIZ_EV_BACK, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
    assert viz_back_closes(p.viz);
    p = ppv_t_select(p, 1);
    p = ppv_apply(p, VIZ_EV_CLEAR, 0, 0);
    assert p.viz.selected == VIZ_REF_NONE;
}

test step_and_param_are_clamped_to_their_ranges {
    var p : PpvState = ppv_open();
    p = ppv_apply(p, VIZ_EV_STEP_SET, 99, 0);
    assert p.viz.step == 12;
    let r : u32 = p.viz.revision;
    p = ppv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert p.viz.step == 12;
    assert p.viz.revision == r;
    p = ppv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 11;
    p = ppv_apply(p, VIZ_EV_STEP_SET, 0, 0);
    p = ppv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert p.viz.step == 0;
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 99, 0);
    assert p.viz.param == 6;
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert p.viz.param == 5;
}

; ---------------------------------------------------------------- tests: entities and lifecycle edges

test a_pull_is_a_node_ref_and_an_out_of_range_ref_names_no_pull {
    assert ppv_pr_ref(3) == viz_ref(VIZ_ENT_NODE, 3);
    assert ppv_pr_ref(3) == 65539;
    assert viz_ref_kind(ppv_pr_ref(3)) == VIZ_ENT_NODE;
    assert viz_ref_index(ppv_pr_ref(3)) == 3;
    assert ppv_pr_at(ppv_pr_ref(3), 9) == 3;
    assert ppv_pr_at(ppv_pr_ref(3), 3) == PPV_NO_RECORD;
    assert ppv_pr_at(ppv_pr_ref(9), 9) == PPV_NO_RECORD;
    assert ppv_pr_at(ppv_pr_ref(12), 9) == PPV_NO_RECORD;
    assert ppv_pr_at(viz_ref(VIZ_ENT_EDGE, 3), 9) == PPV_NO_RECORD;
    assert ppv_pr_at(viz_ref(VIZ_ENT_CELL, 3), 9) == PPV_NO_RECORD;
    assert ppv_pr_at(VIZ_REF_NONE, 9) == PPV_NO_RECORD;
    // A hovered or selected ref outside the nine names no subject, so no view shows anything for it.
    var p : PpvState = ppv_apply(ppv_open(), VIZ_EV_HOVER, ppv_pr_ref(12), 0);
    p = ppv_t_select(p, 9);
    assert p.viz.hover == ppv_pr_ref(12);
    assert ppv_subject(p) == PPV_NO_RECORD;
    assert ppv_inspect_number(p) == PPV_NO_RECORD;
    assert ppv_inspect_decision(p) == PPV_NO_VERDICT;
    assert ppv_inspect_class(p) == 0;
    assert ppv_inspect_rule(p) == PPV_NO_RULE;
    assert ppv_inspect_blocker(p) == PPV_NO_CHECK;
    assert ppv_inspect_blocked(p) == 0;
    assert ppv_inspect_age(p) == PPV_NO_RECORD;
    assert ppv_inspect_check_status(p, 0) == PPV_NO_RECORD;
    assert ppv_trace_shown(p) == 0;
    assert ppv_trace_value(p, 0) == PPV_ROW_HIDDEN;
    assert ppv_list_verdict(p, 9) == PPV_NO_VERDICT;
    assert ppv_list_class(p, 9) == 0;
    assert ppv_list_hl(p, 12) == VIZ_HL_NONE;
    assert ppv_list_hl(p, 8) == VIZ_HL_NONE;
    assert ppv_focus_ref(p, 8) == ppv_pr_ref(8);
    assert ppv_focus_ref(p, 9) == VIZ_REF_NONE;
    // The judge is never called for a slot past the fixture.
    assert ppv_decision(9, 0) == PPV_NO_VERDICT;
    assert ppv_blocker(9, 0) == PPV_NO_CHECK;
    assert ppv_decision_with(40, 0, PPV_MASTER_RED) == PPV_NO_VERDICT;
}

test loading_ignores_interaction_and_shows_no_rows {
    let ready : PpvState = ppv_open();
    let p : PpvState = ppv_apply(ready, VIZ_EV_LOAD, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert ppv_rows(p) == 0;
    assert viz_same(ppv_apply(p, VIZ_EV_HOVER, ppv_pr_ref(2), 0).viz, p.viz);
    assert viz_same(ppv_apply(p, VIZ_EV_SELECT, ppv_pr_ref(2), 0).viz, p.viz);
    assert viz_same(ppv_apply(p, VIZ_EV_STEP_NEXT, 0, 0).viz, p.viz);
    assert viz_same(ppv_apply(p, VIZ_EV_PARAM_SET, 3, 0).viz, p.viz);
    assert ppv_list_verdict(p, 0) == PPV_NO_VERDICT;
    assert ppv_list_hl(p, 0) == VIZ_HL_NONE;
    assert ppv_list_hit(p, 30, 70) == VIZ_REF_NONE;
    assert ppv_subject(p) == PPV_NO_RECORD;
    assert ppv_trace_value(p, 0) == PPV_ROW_HIDDEN;
    assert ppv_inspect_decision(p) == PPV_NO_VERDICT;
    assert ppv_inspect_top(p) == PPV_NO_CHECK;
    // The load finishing brings the rows back, with the selection and hover cleared.
    let done : PpvState = ppv_apply(p, VIZ_EV_LOADED, 9, VIZ_TRUTH_VERIFIED as u32);
    assert done.viz.lifecycle == VIZ_LC_READY;
    assert ppv_rows(done) == 9;
    assert ppv_list_verdict(done, 0) == J_MERGE;
}

test an_empty_fixture_is_empty_and_every_view_says_nothing {
    let e : PpvState = ppv_open_n(0);
    assert e.viz.lifecycle == VIZ_LC_EMPTY;
    assert e.viz.item_count == 0;
    assert e.viz.focus_count == 0;
    assert e.viz.truth == VIZ_TRUTH_UNKNOWN;
    assert ppv_badge_claims(e) == false;
    assert ppv_rows(e) == 0;
    assert ppv_list_verdict(e, 0) == PPV_NO_VERDICT;
    assert ppv_list_hit(e, 30, 70) == VIZ_REF_NONE;
    assert ppv_trace_shown(e) == 0;
    assert ppv_inspect_top(e) == PPV_NO_CHECK;
    assert viz_same(ppv_apply(e, VIZ_EV_HOVER, ppv_pr_ref(0), 0).viz, e.viz);
    assert viz_same(ppv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz, e.viz);
    assert ppv_apply(e, VIZ_EV_FOCUS_NEXT, 0, 0).viz.focus == VIZ_NO_FOCUS;
    // More pulls than the fixture holds are clamped; fewer shorten every view and the focus ring.
    assert ppv_open_n(99).viz.item_count == 9;
    var p : PpvState = ppv_open_n(3);
    assert ppv_rows(p) == 3;
    assert ppv_list_verdict(p, 2) == J_DRAFT;
    assert ppv_list_verdict(p, 3) == PPV_NO_VERDICT;
    assert ppv_list_hit(p, 30, 60 + 3 * 22) == VIZ_REF_NONE;
    p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 2;
    p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
}

test a_failed_load_is_an_error_and_retry_loads_again {
    var p : PpvState = ppv_apply(ppv_open(), VIZ_EV_FAILED, 5, 0);
    assert p.viz.lifecycle == VIZ_LC_ERROR;
    assert p.viz.error == 5;
    assert ppv_rows(p) == 0;
    assert ppv_list_verdict(p, 0) == PPV_NO_VERDICT;
    assert ppv_inspect_decision(p) == PPV_NO_VERDICT;
    assert viz_same(ppv_apply(p, VIZ_EV_SELECT, ppv_pr_ref(1), 0).viz, p.viz);
    p = ppv_apply(p, VIZ_EV_RETRY, 0, 0);
    assert p.viz.lifecycle == VIZ_LC_LOADING;
    assert p.viz.error == 0;
    p = ppv_apply(p, VIZ_EV_LOADED, 9, VIZ_TRUTH_VERIFIED as u32);
    assert p.viz.lifecycle == VIZ_LC_READY;
    assert ppv_rows(p) == 9;
    assert ppv_list_verdict(p, 1) == J_HELD;
}

; ---------------------------------------------------------------- tests: entities are the judge's calls

test the_fixture_verdicts_are_the_judges_verdicts {
    assert ppv_decision(0, 0) == J_MERGE;
    assert ppv_decision(1, 0) == J_HELD;
    assert ppv_decision(2, 0) == J_DRAFT;
    assert ppv_decision(3, 0) == J_BEE;
    assert ppv_decision(4, 0) == J_CONFLICT;
    assert ppv_decision(5, 0) == J_PENDING;
    assert ppv_decision(6, 0) == J_REQ_RED;
    assert ppv_decision(7, 0) == J_QUIET;
    assert ppv_decision(8, 0) == J_MERGE;
    // The same answers, pinned as the literal codes the source documents.
    assert ppv_decision(1, 0) == 2;
    assert ppv_decision(2, 0) == 3;
    assert ppv_decision(3, 0) == 5;
    assert ppv_decision(4, 0) == 6;
    assert ppv_decision(5, 0) == 10;
    assert ppv_decision(6, 0) == 11;
    assert ppv_decision(7, 0) == 15;
    // The list view shows the same decisions, with the source's class letters.
    let p : PpvState = ppv_open();
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        assert ppv_list_verdict(p, i) == ppv_decision(i, 0);
        assert ppv_list_class(p, i) == J_CLASS[ppv_decision(i, 0) as usize];
        i = i + 1;
    }
    assert ppv_list_class(p, 0) == 'G';
    assert ppv_list_class(p, 1) == 'H';
    assert ppv_list_class(p, 3) == 'N';
    assert ppv_list_class(p, 5) == 'W';
    assert ppv_merge_total(0) == 2;
    assert ppv_merge_total(0) <= MERGE_CAP;
}

test the_fleet_plan_agrees_with_the_one_by_one_verdicts {
    // The flat fleet, judged by merge_plan as one stream, says the same as nine single streams, for
    // every flip.
    var k : u32 = 0;
    while (k < PPV_WHATIFS) {
        var out : [4096]u8 = undefined;
        let m : usize = ppv_plan(k, PPV_MASTER_GREEN, &out, 4096);
        assert m < 4096;
        var i : u32 = 0;
        while (i < PPV_RECORD_COUNT) {
            let d : u8 = ppv_decision(i, k);
            if (d == J_MERGE) {
                assert t_g(&out, m, PPV_PR_BASE + i);
            } else {
                assert t_has(&out, m, ppv_class_of(d), PPV_PR_BASE + i, d);
            }
            i = i + 1;
        }
        k = k + 1;
    }
    // And the pinned plan for the recorded data.
    var plan : [4096]u8 = undefined;
    let n : usize = ppv_plan(0, PPV_MASTER_GREEN, &plan, 4096);
    assert t_g(&plan, n, 101);
    assert t_g(&plan, n, 109);
    assert t_g(&plan, n, 102) == false;
    assert t_has(&plan, n, 'H', 102, J_HELD);
    assert t_has(&plan, n, 'H', 103, J_DRAFT);
    assert t_has(&plan, n, 'N', 104, J_BEE);
    assert t_has(&plan, n, 'W', 105, J_CONFLICT);
    assert t_has(&plan, n, 'W', 106, J_PENDING);
    assert t_has_named(&plan, n, 'W', 107, J_REQ_RED, 1);
    assert t_has(&plan, n, 'W', 108, J_QUIET);
    assert t_summary(&plan, n, 2, 0, 4, 2, 1, 0, 9);
}

test the_blocker_is_the_check_the_judge_names {
    assert ppv_blocker(6, 0) == 1;
    assert ppv_blocker_with(6, 0, PPV_MASTER_NONE) == 1;
    // Held, draft, base, bee, conflict, pending, quiet and merge name no check.
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        if (i != 6) {
            assert ppv_blocker(i, 0) == PPV_NO_CHECK;
        }
        i = i + 1;
    }
    // The fleet plan names the same check, by the source's own name table.
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(0, PPV_MASTER_GREEN, &out, 4096);
    assert t_has_named(&out, m, 'W', 107, J_REQ_RED, ppv_blocker(6, 0) as u32);
    assert t_has_named(&out, m, 'W', 107, J_REQ_RED, 0) == false;
    // The name codes are rows of the source's table: code 1 is check-linked-issue, 7 is spec-guards.
    assert T_NLENS[1] == 29;
    assert T_NLENS[7] == 23;
    assert ppv_blocked_by(1, 0) == 1;
    assert ppv_blocked_by(0, 0) == 0;
    assert ppv_blocked_by(PPV_NO_CHECK, 0) == 8;
    assert ppv_top_blocker(0) == 1;
    assert ppv_inspect_top(ppv_open()) == 1;
}

test the_rules_fire_in_the_order_of_the_ladder {
    // Each case breaks its own rule and every rule after it, and the earliest one wins.
    assert ppv_t_rule(true, 1, 1, 1, 1, 1, 0, 10) == J_HELD;
    assert ppv_t_rule(true, 0, 1, 1, 1, 1, 0, 10) == J_DRAFT;
    assert ppv_t_rule(false, 0, 1, 1, 1, 1, 0, 10) == J_BASE;
    assert ppv_t_rule(false, 0, 1, 0, 1, 1, 0, 10) == J_BEE;
    assert ppv_t_rule(false, 0, 0, 0, 1, 1, 0, 10) == J_CONFLICT;
    assert ppv_t_rule(false, 0, 0, 0, 2, 2, 1, 3600) == J_UNKNOWN;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 0, 10) == J_NO_CLOSE;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 1, 10) == J_QUIET;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 1, 3600) == J_MERGE;
    // The ladder positions along that chain never go down (conflict and unknown share one).
    assert ppv_rule_of(J_HELD) < ppv_rule_of(J_DRAFT);
    assert ppv_rule_of(J_DRAFT) < ppv_rule_of(J_BASE);
    assert ppv_rule_of(J_BASE) < ppv_rule_of(J_BEE);
    assert ppv_rule_of(J_BEE) < ppv_rule_of(J_CONFLICT);
    assert ppv_rule_of(J_CONFLICT) == ppv_rule_of(J_UNKNOWN);
    assert ppv_rule_of(J_UNKNOWN) < ppv_rule_of(J_NO_CLOSE);
    assert ppv_rule_of(J_NO_CLOSE) < ppv_rule_of(J_QUIET);
    assert ppv_rule_of(J_QUIET) < ppv_rule_of(J_MERGE);
    // The quiet boundary is the source's constant: one second short is quiet, the minute itself merges.
    let edge : u32 = QUIET_SECS as u32;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 1, edge - 1) == J_QUIET;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 1, edge) == J_MERGE;
    assert ppv_t_rule(false, 0, 0, 0, 0, 0, 1, edge + 1) == J_MERGE;
    assert edge == 600;
}

test waiting_beats_red_and_a_required_red_beats_a_quiet_head {
    // The rollup that does not add up is unread, and that is judged before anything is pending.
    assert ppv_t_pending(5) == J_PENDING;
    assert ppv_t_pending(7) == J_UNREAD;
    assert ppv_rule_of(J_UNREAD) < ppv_rule_of(J_PENDING);
    // A pull request still waiting on spec-guards stays pending whichever required check is red.
    var k : u32 = 1;
    while (k < 5) {
        assert ppv_decision(5, k) == J_PENDING;
        assert ppv_blocker(5, k) == PPV_NO_CHECK;
        k = k + 1;
    }
    assert ppv_rule_of(J_PENDING) < ppv_rule_of(J_REQ_RED);
    // A required red is judged before a non-required one and before the quiet head.
    assert ppv_decision(6, 6) == J_REQ_RED;
    assert ppv_blocker(6, 6) == 1;
    assert ppv_decision(7, 0) == J_QUIET;
    assert ppv_decision(7, 1) == J_REQ_RED;
    assert ppv_decision(7, 6) == J_RED;
    assert ppv_rule_of(J_REQ_RED) < ppv_rule_of(J_RED);
    assert ppv_rule_of(J_RED) < ppv_rule_of(J_QUIET);
}

test the_rule_trace_and_class_maps_cover_the_whole_ladder {
    assert ppv_rule_of(J_HELD) == 0;
    assert ppv_rule_of(J_DRAFT) == 1;
    assert ppv_rule_of(J_BASE) == 2;
    assert ppv_rule_of(J_BEE) == 3;
    assert ppv_rule_of(J_CONFLICT) == 4;
    assert ppv_rule_of(J_NO_CLOSE) == 5;
    assert ppv_rule_of(J_UNREAD) == 6;
    assert ppv_rule_of(J_PENDING) == 7;
    assert ppv_rule_of(J_REQ_RED) == 8;
    assert ppv_rule_of(J_REQ_MISSING) == 9;
    assert ppv_rule_of(J_LOG) == 10;
    assert ppv_rule_of(J_RED) == 10;
    assert ppv_rule_of(J_QUIET) == 11;
    assert ppv_rule_of(J_MERGE) == 12;
    assert ppv_rule_of(J_CAPPED) == 12;
    assert ppv_rule_of(J_BAD) == PPV_RULE_BAD;
    assert ppv_rule_of(PPV_NO_VERDICT) == PPV_NO_RULE;
    assert PPV_RULES == PPV_STEPS;
    // A trace row: before the fired rule passes, the fired rule fires, after it is never reached.
    assert ppv_trace_row(12, 0) == PPV_ROW_PASS;
    assert ppv_trace_row(12, 11) == PPV_ROW_PASS;
    assert ppv_trace_row(12, 12) == PPV_ROW_FIRED;
    assert ppv_trace_row(3, 2) == PPV_ROW_PASS;
    assert ppv_trace_row(3, 3) == PPV_ROW_FIRED;
    assert ppv_trace_row(3, 4) == PPV_ROW_SKIPPED;
    assert ppv_trace_row(0, 0) == PPV_ROW_FIRED;
    // An unreadable record fires no row of the ladder.
    assert ppv_trace_row(PPV_RULE_BAD, 0) == PPV_ROW_SKIPPED;
    assert ppv_trace_row(PPV_NO_RULE, 12) == PPV_ROW_SKIPPED;
    // The class letters are the source's table.
    assert ppv_class_of(J_MERGE) == 'G';
    assert ppv_class_of(J_HELD) == 'H';
    assert ppv_class_of(J_RED) == 'H';
    assert ppv_class_of(J_BEE) == 'N';
    assert ppv_class_of(J_QUIET) == 'W';
    assert ppv_class_of(J_LOG) == 'W';
    assert ppv_class_of(PPV_NO_VERDICT) == 0;
    assert J_COUNT == 17;
}

test a_red_that_master_also_has_waits_for_its_log {
    // spec-guards red on 101 and master's own word decide who owns the red.
    assert ppv_decision_with(0, 6, PPV_MASTER_NONE) == J_RED;
    assert ppv_decision_with(0, 6, PPV_MASTER_GREEN) == J_RED;
    assert ppv_decision_with(0, 6, PPV_MASTER_RED) == J_LOG;
    assert ppv_class_of(J_RED) == 'H';
    assert ppv_class_of(J_LOG) == 'W';
    assert ppv_blocker_with(0, 6, PPV_MASTER_NONE) == 7;
    assert ppv_blocker_with(0, 6, PPV_MASTER_RED) == 7;
    // Without a flip master's word changes nothing: spec-guards is green there.
    assert ppv_decision_with(0, 0, PPV_MASTER_RED) == J_MERGE;
    // The fleet: the three reds that master shares wait for a log, with the run ids of the checks.
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(6, PPV_MASTER_RED, &out, 4096);
    assert t_has_named(&out, m, 'W', 101, J_LOG, 7);
    assert t_has_named(&out, m, 'W', 108, J_LOG, 7);
    assert t_has_named(&out, m, 'W', 109, J_LOG, 7);
    assert t_has_log(&out, m, 101, 7, 1005);
    assert t_has_log(&out, m, 108, 7, 1075);
    assert t_has_log(&out, m, 109, 7, 1085);
    assert t_g(&out, m, 106);
    assert t_has_named(&out, m, 'W', 107, J_REQ_RED, 1);
    assert t_summary(&out, m, 1, 0, 5, 2, 1, 0, 9);
}

; ---------------------------------------------------------------- tests: one input change, recomputed

test flipping_validate_blocks_every_clean_pull_on_the_same_check {
    let before : PpvState = ppv_open();
    let p : PpvState = ppv_t_param(1);
    assert p.viz.param == 1;
    assert p.viz.revision == before.viz.revision + 1;
    // Before: the two clean pulls merge. After: validate is red, and the source says so.
    assert ppv_list_verdict(before, 0) == J_MERGE;
    assert ppv_list_verdict(before, 8) == J_MERGE;
    assert ppv_list_verdict(p, 0) == J_REQ_RED;
    assert ppv_list_verdict(p, 8) == J_REQ_RED;
    assert ppv_list_verdict(p, 7) == J_REQ_RED;
    assert ppv_list_verdict(p, 6) == J_REQ_RED;
    // The early rules do not move.
    assert ppv_list_verdict(p, 1) == J_HELD;
    assert ppv_list_verdict(p, 2) == J_DRAFT;
    assert ppv_list_verdict(p, 3) == J_BEE;
    assert ppv_list_verdict(p, 4) == J_CONFLICT;
    assert ppv_list_verdict(p, 5) == J_PENDING;
    // One check blocks four of them: the first red row wins, so 107 now names validate too.
    assert ppv_blocker(0, 1) == 0;
    assert ppv_blocker(6, 1) == 0;
    assert ppv_blocker(7, 1) == 0;
    assert ppv_blocker(8, 1) == 0;
    assert ppv_inspect_blocked(ppv_t_select(p, 8)) == 4;
    assert ppv_merge_total(1) == 0;
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(1, PPV_MASTER_GREEN, &out, 4096);
    assert t_has_named(&out, m, 'W', 101, J_REQ_RED, 0);
    assert t_has_named(&out, m, 'W', 107, J_REQ_RED, 0);
    assert t_summary(&out, m, 0, 0, 6, 2, 1, 0, 9);
}

test flipping_check_linked_issue_unblocks_one_pull_and_blocks_three {
    let p : PpvState = ppv_t_param(2);
    // 107 had this check red; the flip makes it pass and the pull request merges.
    assert ppv_list_verdict(p, 6) == J_MERGE;
    assert ppv_blocker(6, 2) == PPV_NO_CHECK;
    // The three that passed it now fail it.
    assert ppv_list_verdict(p, 0) == J_REQ_RED;
    assert ppv_list_verdict(p, 7) == J_REQ_RED;
    assert ppv_list_verdict(p, 8) == J_REQ_RED;
    assert ppv_blocker(0, 2) == 1;
    assert ppv_blocker(7, 2) == 1;
    assert ppv_blocker(8, 2) == 1;
    assert ppv_merge_total(2) == 1;
    assert ppv_top_blocker(2) == 1;
    assert ppv_blocked_by(1, 2) == 3;
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(2, PPV_MASTER_GREEN, &out, 4096);
    assert t_g(&out, m, 107);
    assert t_g(&out, m, 101) == false;
    assert t_summary(&out, m, 1, 0, 5, 2, 1, 0, 9);
}

test flipping_spec_guards_unblocks_the_pending_pull_and_reds_the_clean_ones {
    let p : PpvState = ppv_t_param(6);
    // 106 was waiting on spec-guards; the flip finishes it green and it merges.
    assert ppv_list_verdict(p, 5) == J_MERGE;
    // The pulls that passed it now carry a red that is not required: the head is held, not queued.
    assert ppv_list_verdict(p, 0) == J_RED;
    assert ppv_list_verdict(p, 7) == J_RED;
    assert ppv_list_verdict(p, 8) == J_RED;
    assert ppv_list_class(p, 0) == 'H';
    // 107 keeps its required red, which is judged first.
    assert ppv_list_verdict(p, 6) == J_REQ_RED;
    assert ppv_blocker(0, 6) == 7;
    assert ppv_blocker(6, 6) == 1;
    assert ppv_merge_total(6) == 1;
    assert ppv_top_blocker(6) == 7;
    assert ppv_blocked_by(7, 6) == 3;
    assert ppv_t_fleet_has(6, PPV_MASTER_GREEN, 'H', 101, J_RED);
    assert ppv_t_fleet_has(6, PPV_MASTER_GREEN, 'H', 108, J_RED);
    assert ppv_t_fleet_has(6, PPV_MASTER_GREEN, 'H', 109, J_RED);
    var out : [4096]u8 = undefined;
    let m : usize = ppv_plan(6, PPV_MASTER_GREEN, &out, 4096);
    assert t_g(&out, m, 106);
    assert t_summary(&out, m, 1, 0, 2, 5, 1, 0, 9);
}

test the_other_flips_name_their_own_check_or_change_nothing {
    // parse-ratchet and own-language: the three clean-or-quiet pulls name the flipped check, and 107
    // keeps naming its own earlier red.
    var k : u32 = 3;
    while (k < 5) {
        let code : u8 = (k - 1) as u8;
        assert ppv_blocker(0, k) == code;
        assert ppv_blocker(7, k) == code;
        assert ppv_blocker(8, k) == code;
        assert ppv_blocker(6, k) == 1;
        assert ppv_top_blocker(k) == code;
        assert ppv_blocked_by(code, k) == 3;
        assert ppv_merge_total(k) == 0;
        k = k + 1;
    }
    // claw-sarif is red everywhere and the judge ignores it as a reason: flipping it moves no verdict.
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        assert ppv_decision(i, 5) == ppv_decision(i, 0);
        assert ppv_blocker(i, 5) == ppv_blocker(i, 0);
        i = i + 1;
    }
    assert ppv_merge_total(5) == 2;
    // Yet the petal says DEMO: the input left the recorded data, whether or not a verdict moved.
    assert ppv_badge(ppv_t_param(5)) == VIZ_TRUTH_DEMO;
}

test the_recomputed_verdict_equals_a_direct_call_of_the_source {
    // Pull request 101 written by hand, not through the petal's fixture functions.
    assert ppv_t_literal(0) == J_MERGE;
    assert ppv_t_literal(1) == J_REQ_RED;
    assert ppv_list_verdict(ppv_open(), 0) == ppv_t_literal(0);
    assert ppv_list_verdict(ppv_t_param(1), 0) == ppv_t_literal(1);
    assert ppv_list_verdict(ppv_t_param(1), 0) != ppv_list_verdict(ppv_open(), 0);
    // The source's plan over the hand-written text names the same decision and the same check.
    var raw : [2048]u8 = undefined;
    var out : [2048]u8 = undefined;
    let n : usize = ppv_t_literal_raw(&raw, 2048, 1);
    let m : usize = merge_plan(&raw, n, &out, 2048);
    assert t_has_named(&out, m, 'W', 101, J_REQ_RED, 0);
    assert t_g(&out, m, 101) == false;
    assert ppv_blocker(0, 1) == 0;
    let n0 : usize = ppv_t_literal_raw(&raw, 2048, 0);
    let m0 : usize = merge_plan(&raw, n0, &out, 2048);
    assert t_g(&out, m0, 101);
    assert ppv_decision(0, 0) == J_MERGE;
}

test the_top_blocker_follows_the_flip {
    assert ppv_top_blocker(0) == 1;
    assert ppv_top_blocker(1) == 0;
    assert ppv_top_blocker(2) == 1;
    assert ppv_top_blocker(3) == 2;
    assert ppv_top_blocker(4) == 3;
    assert ppv_top_blocker(5) == 1;
    assert ppv_top_blocker(6) == 7;
    assert ppv_blocked_by(0, 1) == 4;
    assert ppv_blocked_by(1, 2) == 3;
    assert ppv_blocked_by(2, 3) == 3;
    assert ppv_blocked_by(3, 4) == 3;
    assert ppv_blocked_by(7, 6) == 3;
    // The inspector's top blocker follows the state's flip.
    assert ppv_inspect_top(ppv_open()) == 1;
    assert ppv_inspect_top(ppv_t_param(1)) == 0;
    assert ppv_inspect_top(ppv_t_param(6)) == 7;
}

; ---------------------------------------------------------------- tests: truth

test an_untouched_petal_is_verified_and_the_badge_may_claim {
    let p : PpvState = ppv_open();
    assert ppv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert ppv_badge_claims(p);
    assert ppv_badge_rgb(p) == viz_truth_rgb(VIZ_TRUTH_VERIFIED);
    assert ppv_badge_rgb(p) != viz_truth_rgb(VIZ_TRUTH_DEMO);
    // Looking is not leaving the data: hover, select, step and focus keep the claim.
    var q : PpvState = ppv_apply(p, VIZ_EV_HOVER, ppv_pr_ref(1), 0);
    q = ppv_t_select(q, 4);
    q = ppv_apply(q, VIZ_EV_STEP_SET, 4, 0);
    q = ppv_apply(q, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert ppv_badge_claims(q);
    assert ppv_truth_holds(q);
    // An unknown truth code reads as UNKNOWN, never as a claim.
    var u : PpvState = p;
    u.viz.truth = 77;
    assert ppv_badge(u) == VIZ_TRUTH_UNKNOWN;
    assert ppv_badge_claims(u) == false;
}

test leaving_the_data_shows_demo_and_returning_restores_the_claim {
    let open : PpvState = ppv_open();
    var p : PpvState = ppv_apply(open, VIZ_EV_PARAM_SET, 3, 0);
    assert ppv_badge(p) == VIZ_TRUTH_DEMO;
    assert ppv_badge_claims(p) == false;
    assert p.base == VIZ_TRUTH_VERIFIED;
    assert ppv_truth_holds(p);
    // Another flip is still a demo.
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 5, 0);
    assert ppv_badge(p) == VIZ_TRUTH_DEMO;
    assert p.viz.revision == open.viz.revision + 2;
    // A reload that finishes while a flip is on keeps the DEMO label.
    let again : PpvState = ppv_t_reload(p, 9, VIZ_TRUTH_VERIFIED);
    assert again.viz.lifecycle == VIZ_LC_READY;
    assert again.viz.param == 5;
    assert again.base == VIZ_TRUTH_VERIFIED;
    assert ppv_badge(again) == VIZ_TRUTH_DEMO;
    // Back to the data: VERIFIED again, and the state is the opened one.
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert ppv_badge(p) == VIZ_TRUTH_VERIFIED;
    assert ppv_badge_claims(p);
    assert viz_same(p.viz, open.viz);
    assert p.viz.revision == open.viz.revision + 3;
}

test a_reload_keeps_cached_and_unknown_and_follows_live {
    var p : PpvState = ppv_t_reload(ppv_open(), 9, VIZ_TRUTH_CACHED);
    assert ppv_badge(p) == VIZ_TRUTH_CACHED;
    assert p.base == VIZ_TRUTH_CACHED;
    assert ppv_badge_claims(p) == false;
    // A flip on cached data stays cached: it never claimed a result to begin with.
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 3, 0);
    assert ppv_badge(p) == VIZ_TRUTH_CACHED;
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 0, 0);
    assert ppv_badge(p) == VIZ_TRUTH_CACHED;
    // A host that feeds the live queue reports LIVE; the flip still turns it into a demo.
    p = ppv_t_reload(p, 9, VIZ_TRUTH_LIVE);
    assert ppv_badge(p) == VIZ_TRUTH_LIVE;
    assert ppv_badge_claims(p);
    p = ppv_apply(p, VIZ_EV_PARAM_SET, 2, 0);
    assert ppv_badge(p) == VIZ_TRUTH_DEMO;
    // A truth code outside the table reloads as UNKNOWN and never claims.
    let odd : PpvState = ppv_t_reload(ppv_open(), 9, 77);
    assert ppv_badge(odd) == VIZ_TRUTH_UNKNOWN;
    assert odd.base == VIZ_TRUTH_UNKNOWN;
    assert ppv_badge_claims(odd) == false;
    assert ppv_truth_holds(odd);
}

; ---------------------------------------------------------------- tests: keyboard and motion

test focus_walks_every_pull_forward_and_back_wraps_and_activates {
    var p : PpvState = ppv_open();
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
        assert p.viz.focus == i;
        assert viz_is_focused(p.viz, i);
        assert ppv_focus_ref(p, p.viz.focus) == ppv_pr_ref(i);
        i = i + 1;
    }
    // The tenth press wraps to the first pull.
    p = ppv_apply(p, VIZ_EV_FOCUS_NEXT, 0, 0);
    assert p.viz.focus == 0;
    // Backward from nothing focused starts at the last pull, walks down and wraps.
    var q : PpvState = ppv_open();
    var j : u32 = PPV_RECORD_COUNT;
    while (j > 0) {
        q = ppv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
        j = j - 1;
        assert q.viz.focus == j;
        assert ppv_focus_ref(q, q.viz.focus) == ppv_pr_ref(j);
    }
    q = ppv_apply(q, VIZ_EV_FOCUS_PREV, 0, 0);
    assert q.viz.focus == 8;
    // Activate: nothing focused is a no-op; the focused pull is selected; again clears it.
    var a : PpvState = ppv_open();
    assert viz_same(ppv_activate(a).viz, a.viz);
    assert ppv_activate(a).viz.revision == a.viz.revision;
    a = ppv_apply(a, VIZ_EV_FOCUS_NEXT, 0, 0);
    a = ppv_apply(a, VIZ_EV_FOCUS_NEXT, 0, 0);
    a = ppv_apply(a, VIZ_EV_FOCUS_NEXT, 0, 0);
    a = ppv_activate(a);
    assert a.viz.selected == ppv_pr_ref(2);
    assert ppv_subject(a) == 2;
    assert ppv_inspect_decision(a) == J_DRAFT;
    a = ppv_activate(a);
    assert a.viz.selected == VIZ_REF_NONE;
    assert ppv_subject(a) == PPV_NO_RECORD;
}

test reduced_motion_gives_zero_milliseconds {
    var p : PpvState = ppv_open();
    assert viz_motion_ms(p.viz, 250) == 250;
    p = ppv_apply(p, VIZ_EV_MOTION, 1, 0);
    assert p.viz.reduced_motion == 1;
    assert viz_motion_ms(p.viz, 250) == 0;
    assert viz_motion_ms(p.viz, 0) == 0;
    p = ppv_apply(p, VIZ_EV_MOTION, 0, 0);
    assert viz_motion_ms(p.viz, 250) == 250;
    // The preference is not an interaction: it is honoured before the petal has loaded.
    let idle : PpvState = ppv_apply(ppv_idle(), VIZ_EV_MOTION, 1, 0);
    assert idle.viz.reduced_motion == 1;
    assert viz_motion_ms(idle.viz, 250) == 0;
}

; ---------------------------------------------------------------- tests: views against views

test the_views_read_one_state_and_agree {
    var p : PpvState = ppv_t_select(ppv_open(), 4);
    p = ppv_apply(p, VIZ_EV_STEP_SET, 12, 0);
    // One selection lights one list line, and every view describes that pull request.
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        if (i == 4) {
            assert ppv_list_hl(p, i) == VIZ_HL_SELECT;
        } else {
            assert ppv_list_hl(p, i) == VIZ_HL_NONE;
        }
        i = i + 1;
    }
    assert ppv_subject(p) == 4;
    assert ppv_inspect_number(p) == 105;
    assert ppv_inspect_decision(p) == ppv_list_verdict(p, 4);
    assert ppv_inspect_class(p) == ppv_list_class(p, 4);
    assert ppv_list_verdict(p, 4) == J_CONFLICT;
    assert ppv_trace_value(p, ppv_inspect_rule(p)) == PPV_ROW_FIRED;
    // Hover another pull: it takes the inspector and the trace, the selection keeps its line.
    p = ppv_apply(p, VIZ_EV_HOVER, ppv_pr_ref(2), 0);
    assert ppv_subject(p) == 2;
    assert ppv_list_hl(p, 2) == VIZ_HL_HOVER;
    assert ppv_list_hl(p, 4) == VIZ_HL_SELECT;
    assert ppv_inspect_decision(p) == ppv_list_verdict(p, 2);
    assert ppv_inspect_decision(p) == J_DRAFT;
    assert ppv_inspect_rule(p) == 1;
    assert ppv_trace_value(p, 1) == PPV_ROW_FIRED;
    assert ppv_trace_value(p, 0) == PPV_ROW_PASS;
    assert ppv_trace_value(p, 2) == PPV_ROW_SKIPPED;
    // Leave: the selected pull is the subject again. Back: nothing is.
    p = ppv_apply(p, VIZ_EV_LEAVE, 0, 0);
    assert ppv_subject(p) == 4;
    assert ppv_inspect_decision(p) == J_CONFLICT;
    p = ppv_apply(p, VIZ_EV_BACK, 0, 0);
    assert ppv_subject(p) == PPV_NO_RECORD;
    assert ppv_list_hl(p, 4) == VIZ_HL_NONE;
    assert ppv_inspect_decision(p) == PPV_NO_VERDICT;
}

test the_trace_reveals_rules_up_to_the_current_step {
    // No subject: nothing revealed.
    var p : PpvState = ppv_open();
    assert ppv_trace_shown(p) == 0;
    assert ppv_trace_value(p, 0) == PPV_ROW_HIDDEN;
    // 107 selected at step 0: only the first rule is shown, and it passed.
    p = ppv_t_select(p, 6);
    assert ppv_trace_shown(p) == 1;
    assert ppv_trace_value(p, 0) == PPV_ROW_PASS;
    assert ppv_trace_value(p, 1) == PPV_ROW_HIDDEN;
    p = ppv_apply(p, VIZ_EV_STEP_NEXT, 0, 0);
    assert ppv_trace_shown(p) == 2;
    assert ppv_trace_value(p, 1) == PPV_ROW_PASS;
    assert ppv_trace_value(p, 2) == PPV_ROW_HIDDEN;
    // At the rule that fired (the required red, rule 8) the fired row shows, and the rest stay hidden.
    p = ppv_apply(p, VIZ_EV_STEP_SET, 8, 0);
    assert ppv_trace_shown(p) == 9;
    assert ppv_trace_value(p, 7) == PPV_ROW_PASS;
    assert ppv_trace_value(p, 8) == PPV_ROW_FIRED;
    assert ppv_trace_value(p, 9) == PPV_ROW_HIDDEN;
    // At the last step the rules after it show as never reached.
    p = ppv_apply(p, VIZ_EV_STEP_SET, 12, 0);
    assert ppv_trace_shown(p) == 13;
    assert ppv_trace_value(p, 9) == PPV_ROW_SKIPPED;
    assert ppv_trace_value(p, 11) == PPV_ROW_SKIPPED;
    assert ppv_trace_value(p, 12) == PPV_ROW_SKIPPED;
    assert ppv_trace_value(p, 13) == PPV_ROW_HIDDEN;
    // Stepping back hides the last row again.
    p = ppv_apply(p, VIZ_EV_STEP_PREV, 0, 0);
    assert ppv_trace_shown(p) == 12;
    assert ppv_trace_value(p, 12) == PPV_ROW_HIDDEN;
    assert ppv_trace_value(p, 8) == PPV_ROW_FIRED;
}

test the_trace_and_inspector_follow_the_flip {
    var p : PpvState = ppv_t_select(ppv_open(), 0);
    p = ppv_apply(p, VIZ_EV_STEP_SET, 12, 0);
    // 101 passes every rule up to merge: twelve passes, then the fired merge row.
    var k : u32 = 0;
    while (k < 12) {
        assert ppv_trace_value(p, k) == PPV_ROW_PASS;
        k = k + 1;
    }
    assert ppv_trace_value(p, 12) == PPV_ROW_FIRED;
    assert ppv_inspect_rule(p) == 12;
    assert ppv_inspect_blocker(p) == PPV_NO_CHECK;
    // validate flipped: the required-red rule fires, validate is the blocker, four pulls share it.
    let q : PpvState = ppv_apply(p, VIZ_EV_PARAM_SET, 1, 0);
    assert ppv_trace_value(q, 7) == PPV_ROW_PASS;
    assert ppv_trace_value(q, 8) == PPV_ROW_FIRED;
    assert ppv_trace_value(q, 9) == PPV_ROW_SKIPPED;
    assert ppv_trace_value(q, 12) == PPV_ROW_SKIPPED;
    assert ppv_inspect_rule(q) == 8;
    assert ppv_inspect_decision(q) == J_REQ_RED;
    assert ppv_inspect_blocker(q) == 0;
    assert ppv_inspect_blocked(q) == 4;
    assert ppv_badge(q) == VIZ_TRUTH_DEMO;
    // spec-guards flipped: a red that is not required, judged later, and the blocker changes.
    let r : PpvState = ppv_apply(p, VIZ_EV_PARAM_SET, 6, 0);
    assert ppv_trace_value(r, 9) == PPV_ROW_PASS;
    assert ppv_trace_value(r, 10) == PPV_ROW_FIRED;
    assert ppv_trace_value(r, 11) == PPV_ROW_SKIPPED;
    assert ppv_inspect_rule(r) == 10;
    assert ppv_inspect_decision(r) == J_RED;
    assert ppv_inspect_blocker(r) == 7;
    assert ppv_inspect_blocked(r) == 3;
}

test the_inspector_shows_the_facts_the_rule_and_the_blocker {
    let open : PpvState = ppv_open();
    let a : PpvState = ppv_t_select(open, 6);
    assert ppv_inspect_number(a) == 107;
    assert ppv_inspect_decision(a) == J_REQ_RED;
    assert ppv_inspect_class(a) == 'W';
    assert ppv_inspect_rule(a) == 8;
    assert ppv_inspect_blocker(a) == 1;
    assert ppv_inspect_blocked(a) == 1;
    assert ppv_inspect_age(a) == 3600;
    assert ppv_inspect_check_status(a, 1) == 1;
    assert ppv_inspect_check_status(a, 0) == 0;
    assert ppv_inspect_check_status(a, 4) == 1;
    assert ppv_inspect_check_status(a, 6) == PPV_NO_RECORD;
    assert ppv_inspect_top(a) == 1;
    let b : PpvState = ppv_t_select(open, 7);
    assert ppv_inspect_number(b) == 108;
    assert ppv_inspect_decision(b) == J_QUIET;
    assert ppv_inspect_rule(b) == 11;
    assert ppv_inspect_age(b) == 180;
    assert ppv_inspect_blocker(b) == PPV_NO_CHECK;
    assert ppv_inspect_blocked(b) == 0;
    let c : PpvState = ppv_t_select(open, 5);
    assert ppv_inspect_decision(c) == J_PENDING;
    assert ppv_inspect_rule(c) == 7;
    assert ppv_inspect_check_status(c, 5) == 3;
    let d : PpvState = ppv_t_select(open, 0);
    assert ppv_inspect_decision(d) == J_MERGE;
    assert ppv_inspect_class(d) == 'G';
    assert ppv_inspect_rule(d) == 12;
    // Nothing selected: the inspector has no pull to describe, but the fleet's top blocker stands.
    assert ppv_inspect_number(open) == PPV_NO_RECORD;
    assert ppv_inspect_decision(open) == PPV_NO_VERDICT;
    assert ppv_inspect_class(open) == 0;
    assert ppv_inspect_rule(open) == PPV_NO_RULE;
    assert ppv_inspect_blocker(open) == PPV_NO_CHECK;
    assert ppv_inspect_age(open) == PPV_NO_RECORD;
    assert ppv_inspect_check_status(open, 0) == PPV_NO_RECORD;
    assert ppv_inspect_top(open) == 1;
}

; ---------------------------------------------------------------- tests: host and plan

test the_host_validates_and_a_list_hit_agrees_with_the_host_hit {
    let h : VizHost = ppv_host();
    assert h.count == 4;
    assert vh_validate(h) == VH_OK;
    assert h.rep[0] == VIZ_REP_BADGE;
    assert h.rep[1] == VIZ_REP_LIST;
    assert h.rep[2] == VIZ_REP_TRACE;
    assert h.rep[3] == VIZ_REP_INSPECTOR;
    assert h.parent[0] == VH_ROOT;
    assert h.parent[3] == VH_ROOT;
    // The slot rects are the layout constants: nine list lines, thirteen trace lines, eight inspector lines.
    assert h.x[1] == PPV_LIST_X;
    assert h.y[1] == PPV_LIST_Y;
    assert h.w[1] == PPV_LIST_W;
    assert h.h[1] == 198;
    assert h.h[2] == 286;
    assert h.h[3] == PPV_INSPECT_H;
    // A point in each slot lands in that slot; gaps and the outside are nothing.
    assert vh_hit(h, 30, 20) == PPV_SLOT_BADGE;
    assert vh_hit(h, 40, 100) == PPV_SLOT_LIST;
    assert vh_hit(h, 500, 100) == PPV_SLOT_TRACE;
    assert vh_hit(h, 920, 100) == PPV_SLOT_INSPECTOR;
    assert vh_hit(h, 470, 100) == VH_NONE;
    assert vh_hit(h, 40, 258) == VH_NONE;
    assert vh_hit(h, 500, 346) == VH_NONE;
    assert vh_hit(h, 920, 236) == VH_NONE;
    assert vh_hit(h, 40, 55) == VH_NONE;
    assert vh_hit(h, 5, 5) == VH_NONE;
    // The list hit test and the host agree on every line, and on the edges of the list.
    let p : PpvState = ppv_open();
    var i : u32 = 0;
    while (i < PPV_RECORD_COUNT) {
        let py : u32 = PPV_LIST_Y + i * PPV_LINE_H + 3;
        assert ppv_list_hit(p, 30, py) == ppv_pr_ref(i);
        assert vh_hit(h, 30, py) == PPV_SLOT_LIST;
        i = i + 1;
    }
    assert ppv_list_hit(p, 30, 258) == VIZ_REF_NONE;
    assert ppv_list_hit(p, 30, 59) == VIZ_REF_NONE;
    assert ppv_list_hit(p, 19, 70) == VIZ_REF_NONE;
    assert ppv_list_hit(p, 460, 70) == VIZ_REF_NONE;
    assert vh_hit(h, 19, 70) == VH_NONE;
    assert vh_hit(h, 460, 70) == VH_NONE;
    // The badge is a slot of the host but not a list line.
    assert ppv_list_hit(p, 30, 20) == VIZ_REF_NONE;
    // A click on a line goes through the one reducer and selects that pull.
    let q : PpvState = ppv_apply(p, VIZ_EV_SELECT, ppv_list_hit(p, 30, 60 + 6 * 22 + 5), 0);
    assert q.viz.selected == ppv_pr_ref(6);
    assert ppv_inspect_decision(q) == J_REQ_RED;
}

test the_petal_embeds_in_the_contract_host {
    var outer : VizHost = vh_blank();
    outer = vh_add(outer, VIZ_REP_TEXT, VH_ROOT, 0, 0, 1400, 400);
    let e : VizHost = vh_embed(outer, ppv_host(), 0, 10, 10);
    assert e.count == 5;
    assert vh_validate(e) == VH_OK;
    assert e.rep[1] == VIZ_REP_BADGE;
    assert e.rep[2] == VIZ_REP_LIST;
    assert e.rep[3] == VIZ_REP_TRACE;
    assert e.rep[4] == VIZ_REP_INSPECTOR;
    assert e.parent[1] == 0;
    assert e.parent[4] == 0;
    // The petal moved by the slot offset and nothing else.
    assert vh_depth(e, 2) == 2;
    assert vh_abs_x(e, 2) == 30;
    assert vh_abs_y(e, 2) == 70;
    assert vh_hit(e, 40, 80) == 2;
    assert vh_hit(e, 1350, 390) == 0;
    assert vh_hit(e, 1500, 100) == VH_NONE;
    // The list hit test, shifted by the same offset, names the same pull.
    let p : PpvState = ppv_open();
    assert ppv_list_hit(p, 40 - 10, 80 + 22 - 10) == ppv_pr_ref(1);
    assert vh_hit(e, 40, 80 + 22) == 2;
    // The embedded host still holds exactly the petal's reps plus the frame's text.
    assert psv_host_reps(e) == ppv_reps() + viz_rep_bit(VIZ_REP_TEXT);
}

test the_plan_row_for_pulls_matches_this_petal {
    assert PPV_PETAL == 15;
    assert pvp_reps(PPV_PETAL) == 308;
    assert ppv_reps() == 308;
    assert ppv_reps() == pvp_reps(PPV_PETAL);
    // 308 = list 4 + trace 16 + inspector 32 + badge 256.
    assert ppv_reps() == 4 + 16 + 32 + 256;
    assert psv_host_reps(ppv_host()) == ppv_reps();
    assert viz_plan_ok(ppv_reps());
    assert viz_plan_ok(pvp_reps(PPV_PETAL));
    assert viz_is_linked(ppv_reps());
    assert viz_view_count(ppv_reps()) == 3;
    // The truth the plan promises for this row is the truth the opened petal shows.
    assert pvp_truth(PPV_PETAL) == ppv_badge(ppv_open());
    assert pvp_truth(PPV_PETAL) == VIZ_TRUTH_VERIFIED;
}

; ---------------------------------------------------------------- invariant

invariant the_layout_does_not_overlap_and_fits_the_fixture {
    assert PPV_LIST_X + PPV_LIST_W <= PPV_TRACE_X;
    assert PPV_TRACE_X + PPV_TRACE_W <= PPV_INSPECT_X;
    assert PPV_BADGE_Y + PPV_BADGE_H <= PPV_LIST_Y;
    assert PPV_INSPECT_H == PPV_INSPECT_LINES * PPV_LINE_H;
    assert PPV_RECORD_COUNT <= 16;
    assert PPV_STEPS == PPV_RULES;
    assert PPV_RULE_BAD == PPV_RULES;
    assert PPV_WHATIFS == PPV_CHECKS + 1;
    assert PPV_CODES == 9;
}
