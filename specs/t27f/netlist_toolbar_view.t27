// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_toolbar_view.t27 -- Renderer-neutral layout plan for the NETLIST toolbar.
; Ring 2, Wave L1 of epic #13650.
; NtvToolbarView: 4 buttons (Add/Delete/Connect/Inspect) with positions and state.
; Derives enabled/disabled from NtToolbar (J1 contract).
; All alpha/state values from uikit::native_tokens -- no RGBA literals.
; Numbers only; a host (glass_window, Web) draws them.
; Depends on: netlist_toolbar (J1), netlist_selection, netlist_graph, uikit::native_tokens.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_toolbar_view;

use t27f::netlist_graph::{NetlistGraph, inverter_graph};
use t27f::netlist_selection::{NvSelection, nv_no_selection, nv_select_node};
use t27f::netlist_toolbar::{NtToolbar, nt_toolbar};
use uikit::native_tokens::{BTN_ALPHA_DEFAULT, BTN_ALPHA_DISABLED, BTN_HEIGHT, BTN_PAD_H, BTN_RADIUS};

; ── Button action codes ───────────────────────────────────────────────────────
pub const NTV_ACTION_ADD     : u8 = 0;
pub const NTV_ACTION_DELETE  : u8 = 1;
pub const NTV_ACTION_CONNECT : u8 = 2;
pub const NTV_ACTION_INSPECT : u8 = 3;
pub const NTV_ACTION_COUNT   : u8 = 4;

; ── Toolbar geometry ──────────────────────────────────────────────────────────
; Buttons laid out left-to-right at a fixed stride (host uses BTN_HEIGHT for height).
pub const NTV_BTN_STRIDE : f64 = 110.0;
pub const NTV_BTN_Y_OFF  : f64 = 0.0;

; ── NtvButton: render plan for one toolbar button ────────────────────────────
pub struct NtvButton {
    action  : u8,
    x       : f64,
    y       : f64,
    enabled : bool,
    alpha   : f64,
}

; ── NtvToolbarView: render plan for the full toolbar ─────────────────────────
pub struct NtvToolbarView {
    btn       : [4]NtvButton,
    btn_count : u8,
}

; ── alpha derivation ──────────────────────────────────────────────────────────
; Returns BTN_ALPHA_DEFAULT when enabled, BTN_ALPHA_DISABLED otherwise.
; All values from uikit::native_tokens -- no literal here.
pub fn ntv_btn_alpha(enabled: bool) -> f64 {
    if (enabled) { return BTN_ALPHA_DEFAULT; }
    return BTN_ALPHA_DISABLED;
}

; ── toolbar view derivation ───────────────────────────────────────────────────
; Derives enabled/alpha for each of the 4 toolbar buttons from NtToolbar fields.
pub fn ntv_toolbar_view(t: NtToolbar, x0: f64, y0: f64) -> NtvToolbarView {
    var v : NtvToolbarView;
    v.btn_count = NTV_ACTION_COUNT;
    v.btn[0].action  = NTV_ACTION_ADD;
    v.btn[0].x       = x0;
    v.btn[0].y       = y0 + NTV_BTN_Y_OFF;
    v.btn[0].enabled = t.can_add;
    v.btn[0].alpha   = ntv_btn_alpha(t.can_add);
    v.btn[1].action  = NTV_ACTION_DELETE;
    v.btn[1].x       = x0 + NTV_BTN_STRIDE;
    v.btn[1].y       = y0 + NTV_BTN_Y_OFF;
    v.btn[1].enabled = t.can_delete;
    v.btn[1].alpha   = ntv_btn_alpha(t.can_delete);
    v.btn[2].action  = NTV_ACTION_CONNECT;
    v.btn[2].x       = x0 + NTV_BTN_STRIDE * 2.0;
    v.btn[2].y       = y0 + NTV_BTN_Y_OFF;
    v.btn[2].enabled = t.can_connect;
    v.btn[2].alpha   = ntv_btn_alpha(t.can_connect);
    v.btn[3].action  = NTV_ACTION_INSPECT;
    v.btn[3].x       = x0 + NTV_BTN_STRIDE * 3.0;
    v.btn[3].y       = y0 + NTV_BTN_Y_OFF;
    v.btn[3].enabled = t.can_inspect;
    v.btn[3].alpha   = ntv_btn_alpha(t.can_inspect);
    return v;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_add_enabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[0].enabled == true;
}

test no_selection_delete_disabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[1].enabled == false;
}

test no_selection_connect_disabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[2].enabled == false;
}

test no_selection_inspect_disabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[3].enabled == false;
}

test no_selection_add_alpha_default {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[0].alpha == BTN_ALPHA_DEFAULT;
}

test no_selection_delete_alpha_disabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[1].alpha == BTN_ALPHA_DISABLED;
}

test block_selection_delete_enabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_select_node(0);
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[1].enabled == true;
}

test block_selection_connect_enabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_select_node(0);
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[2].enabled == true;
}

test pin_selection_connect_disabled {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_select_node(1);
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[2].enabled == false;
}

test alpha_enabled_is_default {
    assert ntv_btn_alpha(true) == BTN_ALPHA_DEFAULT;
}

test alpha_disabled_is_disabled_token {
    assert ntv_btn_alpha(false) == BTN_ALPHA_DISABLED;
}

test btn_count_is_four {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn_count == 4;
}

test btn_x_increases_left_to_right {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[1].x > v.btn[0].x;
    assert v.btn[2].x > v.btn[1].x;
    assert v.btn[3].x > v.btn[2].x;
}

test action_codes_match_positions {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 0.0, 0.0);
    assert v.btn[0].action == NTV_ACTION_ADD;
    assert v.btn[1].action == NTV_ACTION_DELETE;
    assert v.btn[2].action == NTV_ACTION_CONNECT;
    assert v.btn[3].action == NTV_ACTION_INSPECT;
}

test x_offset_applied {
    let g   : NetlistGraph   = inverter_graph();
    let sel : NvSelection    = nv_no_selection();
    let t   : NtToolbar      = nt_toolbar(sel, g);
    let v   : NtvToolbarView = ntv_toolbar_view(t, 50.0, 0.0);
    assert v.btn[0].x == 50.0;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant add_action_code_zero {
    assert NTV_ACTION_ADD == 0;
}

invariant btn_count_constant_four {
    assert NTV_ACTION_COUNT == 4;
}

invariant alpha_tokens_distinct {
    assert BTN_ALPHA_DEFAULT != BTN_ALPHA_DISABLED;
}
