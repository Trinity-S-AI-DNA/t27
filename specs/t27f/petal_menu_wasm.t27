// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_menu_wasm.t27 -- WASM card for T27 OS in the browser.
; Exports petal_menu.t27 logic so the browser canvas is the renderer and this module is the
; logic. The browser calls WASM functions; zero JS is written by hand.
; Pattern: use-lines = WASM exports (same as live_gx_wasm.t27 / floor-17 rule).
; The browser loop:
;   1. on load:  for each petal p, call vx/vy(p, 0..3) to build Path2D quads.
;   2. on frame: for each petal, call fill(p, state, hovered) -> 0xAARRGGBB; paint.
;   3. on hover: call hit_px(x, y, w, h) -> hovered; redraw.
;   4. on tap:   call on_tap_px(state, x, y, w, h) -> new_state; redraw menu panel.
;   5. on back:  call on_back(state) -> STATE_HOME; close panel.
; Refs epic t27#13214. Advances SF_PETAL_MENU (specs/t27f/frontend.t27) toward PARTIAL.
; phi^2 + 1/phi^2 = 3 | TRINITY

module petal_menu_wasm;

; --- geometry: vertex accessors (p in 0..26, v in 0..3), coordinates in milli-units ---
use t27f::petal_menu::vx;
use t27f::petal_menu::vy;
use t27f::petal_menu::centre_x;
use t27f::petal_menu::centre_y;
use t27f::petal_menu::petal_letter_byte;
use t27f::petal_menu::realm;
use t27f::petal_menu::petal_ok;

; --- box dimensions and counts (scalar constants, safe as WASM i64/u32 exports) ---
use t27f::petal_menu::BOX_W;
use t27f::petal_menu::BOX_H;
use t27f::petal_menu::BOX_CX;
use t27f::petal_menu::BOX_CY;
use t27f::petal_menu::PETAL_COUNT;
use t27f::petal_menu::PETAL_NONE;
use t27f::petal_menu::STATE_HOME;
use t27f::petal_menu::REALM_COUNT;
use t27f::petal_menu::PETALS_PER_REALM;
use t27f::petal_menu::FIT_PERMILLE;
use t27f::petal_menu::HOME_SCALE_PERMILLE;

; --- scale: the browser caller fits the triangle to its canvas ---
use t27f::petal_menu::fit_permille;
use t27f::petal_menu::to_box;

; --- hit test: viewport pixels in, petal index out ---
use t27f::petal_menu::hit_px;
use t27f::petal_menu::centre_hit;

; --- colors as 0xAARRGGBB (browser caller decomposes to RGBA) ---
use t27f::petal_menu::fill;
use t27f::petal_menu::outline_for;
use t27f::petal_menu::outline;
use t27f::petal_menu::IDLE_ALPHA;
use t27f::petal_menu::HOVER_ALPHA;
use t27f::petal_menu::OPEN_ALPHA;
use t27f::petal_menu::RGB_WHITE;
use t27f::petal_menu::OUTLINE_PX;

; --- state machine ---
use t27f::petal_menu::on_tap;
use t27f::petal_menu::on_back;
use t27f::petal_menu::menu_open;

; --- card slots (MVP: empty; card_count always 0) ---
use t27f::petal_menu::card_count;
use t27f::petal_menu::card_x;
use t27f::petal_menu::card_y;
use t27f::petal_menu::CARD_SLOTS;
use t27f::petal_menu::CARD_COLS;
use t27f::petal_menu::CARD_ROWS;
use t27f::petal_menu::CARD_GAP_PX;

; --- convenience wrapper: on_tap from viewport pixels (avoids a to_box call in JS) ---
pub fn on_tap_px(state: u32, x: i64, y: i64, w: i64, h: i64) -> u32 {
    const s : i64 = fit_permille(w, h);
    if (s <= 0) { return STATE_HOME; }
    const bx : i64 = to_box(x, w / 2, BOX_CX, s);
    const by : i64 = to_box(y, h / 2, BOX_CY, s);
    return on_tap(state, bx, by);
}

; --- convenience wrapper: realm_color(r) -> 0xAARRGGBB open-petal fill for realm r ---
pub fn realm_color(r: u32) -> u32 {
    if (r == 0) { return OPEN_ALPHA * 16777216 + 16766720; } // RAZUM gold
    if (r == 1) { return OPEN_ALPHA * 16777216 + 5307130; }  // MATERIYA cyan
    if (r == 2) { return OPEN_ALPHA * 16777216 + 12424185; } // DUKH purple
    return 0;
}

; --- tests: pin the exported surface and the two new wrappers ---

test constants_match_the_law {
    assert BOX_W == 596000;
    assert BOX_H == 526000;
    assert BOX_CX == 298000;
    assert BOX_CY == 263000;
    assert PETAL_COUNT == 27;
    assert PETAL_NONE == 255;
    assert STATE_HOME == 255;
    assert REALM_COUNT == 3;
    assert PETALS_PER_REALM == 9;
    assert CARD_SLOTS == CARD_COLS * CARD_ROWS;
    assert CARD_SLOTS == 9;
}

test fit_permille_doubles_with_viewport {
    const f1 : i64 = fit_permille(596, 526);
    const f2 : i64 = fit_permille(1192, 1052);
    assert f1 > 0;
    assert f2 == f1 * 2;
}

test hit_px_centre_is_no_petal {
    assert hit_px(298, 263, 596, 526) == PETAL_NONE;
}

test fill_idle_hover_open {
    const idle : u32 = fill(0, STATE_HOME, PETAL_NONE);
    assert idle == IDLE_ALPHA * 16777216;
    const hov : u32 = fill(0, STATE_HOME, 0);
    assert hov == HOVER_ALPHA * 16777216 + RGB_WHITE;
    const opn : u32 = fill(0, 0, PETAL_NONE);
    assert opn == OPEN_ALPHA * 16777216 + 16766720;
}

test on_tap_px_centre_stays_home {
    const st : u32 = on_tap_px(STATE_HOME, 298, 263, 596, 526);
    assert st == STATE_HOME;
}

test on_back_always_home {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert on_back(p) == STATE_HOME;
        p = p + 1;
    }
}

test realm_color_three_realms {
    assert realm_color(0) == OPEN_ALPHA * 16777216 + 16766720;
    assert realm_color(1) == OPEN_ALPHA * 16777216 + 5307130;
    assert realm_color(2) == OPEN_ALPHA * 16777216 + 12424185;
    assert realm_color(3) == 0;
}

test card_slots_are_empty_mvp {
    var p : u32 = 0;
    while (p < PETAL_COUNT) {
        assert card_count(p) == 0;
        p = p + 1;
    }
}

test petal_letter_a_and_ti {
    assert petal_letter_byte(0) == 65;
    assert petal_letter_byte(25) == 90;
    assert petal_letter_byte(26) == 84;
    assert petal_letter_byte(27) == 0;
}
