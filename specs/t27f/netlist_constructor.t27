; specs/t27f/netlist_constructor.t27 -- NETLIST constructor root state container.
; Ring 2, Wave K1 of epic #13650.
; NnetlistConstructor: unified state integrating graph, selection, toolbar, connection preview.
; nc_constructor_state(sel, g, preview): one call, all action flags.
; nc_no_preview(): inactive NcPreview sentinel.
; Depends on: netlist_graph, netlist_selection, netlist_toolbar, netlist_connection.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_constructor;

use t27f::netlist_graph::{NetlistGraph, inverter_graph};
use t27f::netlist_selection::{NvSelection, nv_no_selection, nv_select_node, nv_is_selected};
use t27f::netlist_toolbar::{NtToolbar, nt_toolbar};
use t27f::netlist_connection::{NcPreview, NcResult, nc_preview_result};

; ── NnetlistConstructor struct ────────────────────────────────────────────────
; Unified constructor state: toolbar availability + connection preview verdict.
pub struct NnetlistConstructor {
    toolbar      : NtToolbar,
    preview_ok   : bool,
    preview_reason : u8,
}

; ── Inactive preview sentinel ─────────────────────────────────────────────────
; Returns an NcPreview with active == false (no drag in progress).
pub fn nc_no_preview() -> NcPreview {
    var p : NcPreview;
    p.active   = false;
    p.src_node = 0;
    p.src_kind = 0;
    p.dst_node = 0;
    p.dst_kind = 0;
    return p;
}

; ── Constructor root state ────────────────────────────────────────────────────
; Derives all action availability from selection, graph, and connection preview.
pub fn nc_constructor_state(sel: NvSelection, g: NetlistGraph, preview: NcPreview) -> NnetlistConstructor {
    var c : NnetlistConstructor;
    var r : NcResult = nc_preview_result(preview);
    c.toolbar        = nt_toolbar(sel, g);
    c.preview_ok     = r.ok;
    c.preview_reason = r.reason;
    return c;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test no_selection_can_add {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.can_add == true;
}

test no_selection_cannot_connect {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.can_connect == false;
}

test block_selection_can_delete {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_select_node(0);
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.can_delete == true;
}

test block_selection_can_connect {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_select_node(0);
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.can_connect == true;
}

test no_preview_ok_false {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.preview_ok == false;
}

test active_preview_net_pin_ok {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    var p   : NcPreview;
    p.active   = true;
    p.src_node = 2;
    p.src_kind = 2;
    p.dst_node = 1;
    p.dst_kind = 3;
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.preview_ok == true;
}

test sel_count_no_selection {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.sel_count == 0;
}

test sel_count_one_when_selected {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_select_node(0);
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.sel_count == 1;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant no_preview_always_inactive {
    let p : NcPreview = nc_no_preview();
    assert p.active == false;
}

invariant no_selection_always_can_add {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.toolbar.can_add == true;
}

invariant inactive_preview_ok_false {
    let g   : NetlistGraph  = inverter_graph();
    let sel : NvSelection   = nv_no_selection();
    let p   : NcPreview     = nc_no_preview();
    let c   : NnetlistConstructor = nc_constructor_state(sel, g, p);
    assert c.preview_ok == false;
}
