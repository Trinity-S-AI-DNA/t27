// SPDX-License-Identifier: Apache-2.0
; vf_style is the style guide of the course HUD as named, read-only values: colours, radius, stroke, padding seams, control minimums, type and spacing scales
; Refs Trinity-S-AI-DNA/t27#13251 (course v2, Style / UI Kit lane, kept apart from the renderer lane by owner order 2026-11-08)
; Owner rule 2026-11-07: phi generates the spacing AND type scales, but use sites READ these values and never generate them
; Colour, radius, stroke and the control minimums are style-guide values, not phi values
; The two seams are the owner's picks and stay two named tokens: padding 20 (PAD_CARD) vs 16 (PAD_ROW), control minimum 44 touch (MIN_TOUCH) vs 24 pointer (MIN_POINTER)
; Palette is black and white: background 0x000000, text 0xFFFFFF, muted 0x808080, one accent read from petal_menu REALM_RGB (the RAZUM realm, 0xFFD700)
; Corner radius 12 and stroke width 1 are first picks (no earlier value existed in specs/course or specs/t27f), stroke 1 equals petal_menu OUTLINE_PX
; scale_step is the ONE place phi is used: base * (1618 / 1000)^n in permille integer arithmetic, rounded half up at every step
; scale_step(16, 1) = 26 is HEAD over BODY; scale_step(8, 1..3) = 13, 21, 34 is the spacing scale
; TYPE_CAPT 13 is not a phi step of 16 (that would be 10): it is the token value, and equals scale_step(8, 1) only by coincidence
; Token aliases when t27f::vf_tokens (PR #13254, not merged) lands: TYPE_HEAD = VTK HEAD 26, TYPE_BODY = VTK BODY 16, TYPE_CAPT = VTK CAPT 13, PAD_ROW = VTK PAD 16
; Then these consts become equality pins against the tokens instead of definitions
; No two consts collide: inside each family (colours, type scale, spacing scale, seams, control minimums) every value differs, a test pins it
; All values are i32 (colours u32) and non-negative. ASCII only (L3)
; Radius has a scale sm/md/lg (style-guide first picks, md is STYLE_RADIUS) plus full = half the shorter side
; Density is a step shift on the phi spacing scale (compact -1, default 0, comfortable +1), so it adds no new number
; DPR 1..3 sizes the physical backing store (css px * dpr), which is what the course HUD lacks today (its raster is 375 x 812 x 3 = 913500 bytes at 1x); dpr * 100 is the vf_scale percent and stays inside its 25..400 range
; No shadow token: no painter draws one, so a token would claim nothing

module VfStyle;
use t27f::petal_menu::REALM_RGB;
use t27f::petal_menu::REALM_RAZUM;

; phi in permille, the only phi constant
pub const PHI_PERMILLE : i32 = 1618;

; colours 0xRRGGBB, black and white
pub const STYLE_BG : u32 = 0x000000;
pub const STYLE_TEXT : u32 = 0xFFFFFF;
pub const STYLE_MUTED : u32 = 0x808080;

; shape, in px
pub const STYLE_RADIUS : i32 = 12;
pub const STYLE_STROKE : i32 = 1;

; radius scale in px: sm and lg are first picks, md is STYLE_RADIUS
pub const RADIUS_SM : i32 = 6;
pub const RADIUS_MD : i32 = 12;
pub const RADIUS_LG : i32 = 24;

; density ids: a step shift on the spacing scale
pub const DENSITY_COMPACT : u32 = 0;
pub const DENSITY_DEFAULT : u32 = 1;
pub const DENSITY_COMFORTABLE : u32 = 2;
pub const DENSITY_COUNT : u32 = 3;

; device pixel ratio bounds
pub const DPR_MIN : i32 = 1;
pub const DPR_MAX : i32 = 3;

; the two padding seams: card inner padding and row padding
pub const PAD_CARD : i32 = 20;
pub const PAD_ROW : i32 = 16;

; the two control minimums: a touch control and a pointer control, in px
pub const MIN_TOUCH : i32 = 44;
pub const MIN_POINTER : i32 = 24;

; type scale in px: caption, body, heading (heading = scale_step(body, 1))
pub const TYPE_CAPT : i32 = 13;
pub const TYPE_BODY : i32 = 16;
pub const TYPE_HEAD : i32 = 26;

; spacing scale in px: scale_step(8, 0..3)
pub const SPACE_1 : i32 = 8;
pub const SPACE_2 : i32 = 13;
pub const SPACE_3 : i32 = 21;
pub const SPACE_4 : i32 = 34;

; line height in permille of the font size: heading and body
pub const LINE_HEAD_PERMILLE : i32 = 1150;
pub const LINE_BODY_PERMILLE : i32 = 1500;

; the accent colour: the RAZUM realm colour of the petal menu
pub fn style_accent() -> u32 {
    return REALM_RGB[REALM_RAZUM];
}

; base * phi^n in permille, rounded half up at every step; n < 0 walks down, n = 0 is base
pub fn scale_step(base: i32, n: i32) -> i32 {
    var v : i32 = base;
    var k : i32 = 0;
    if n >= 0 {
        while k < n {
            v = (v * PHI_PERMILLE + 500) / 1000;
            k = k + 1;
        }
    } else {
        while k > n {
            v = (v * 1000 + 809) / PHI_PERMILLE;
            k = k - 1;
        }
    }
    return v;
}

; a line height in px: size * permille / 1000 rounded half up
pub fn line_height(size: i32, permille: i32) -> i32 {
    return (size * permille + 500) / 1000;
}

pub fn line_height_head() -> i32 {
    return line_height(TYPE_HEAD, LINE_HEAD_PERMILLE);
}

pub fn line_height_body() -> i32 {
    return line_height(TYPE_BODY, LINE_BODY_PERMILLE);
}

; full radius: the shorter of w and h, divided by 2
pub fn radius_full(w: i32, h: i32) -> i32 {
    if w < h {
        return w / 2;
    }
    return h / 2;
}

; r, but never more than the full radius of a w by h box
pub fn radius_fit(r: i32, w: i32, h: i32) -> i32 {
    var f : i32 = radius_full(w, h);
    if r > f {
        return f;
    }
    return r;
}

; density as a step shift: compact -1, default 0, comfortable +1, anything else 0
pub fn density_shift(d: u32) -> i32 {
    if d == DENSITY_COMPACT {
        return -1;
    }
    if d == DENSITY_COMFORTABLE {
        return 1;
    }
    return 0;
}

; spacing at step 1..4 under a density: scale_step(SPACE_1, step - 1 + shift)
pub fn space_at(step: i32, d: u32) -> i32 {
    return scale_step(SPACE_1, step - 1 + density_shift(d));
}

; a device pixel ratio clamped into DPR_MIN..DPR_MAX
pub fn dpr_clamp(d: i32) -> i32 {
    if d < DPR_MIN {
        return DPR_MIN;
    }
    if d > DPR_MAX {
        return DPR_MAX;
    }
    return d;
}

; physical pixels of a css length at a clamped dpr
pub fn backing_px(css: i32, dpr: i32) -> i32 {
    return css * dpr_clamp(dpr);
}

; the vf_scale percent of a dpr: clamped dpr * 100
pub fn dpr_pct(dpr: i32) -> i32 {
    return dpr_clamp(dpr) * 100;
}

; bytes of an RGB backing store for a w by h css box at a dpr
pub fn backing_rgb_bytes(w: i32, h: i32, dpr: i32) -> i32 {
    return backing_px(w, dpr) * backing_px(h, dpr) * 3;
}

test st_colours_are_black_and_white_and_distinct {
    assert STYLE_BG == 0x000000;
    assert STYLE_TEXT == 0xFFFFFF;
    assert STYLE_MUTED == 0x808080;
    assert STYLE_BG != STYLE_TEXT;
    assert STYLE_BG != STYLE_MUTED;
    assert STYLE_TEXT != STYLE_MUTED;
}

test st_accent_is_the_razum_realm_colour {
    assert style_accent() == 0xFFD700;
    assert style_accent() == REALM_RGB[0];
    assert style_accent() != STYLE_BG;
    assert style_accent() != STYLE_TEXT;
    assert style_accent() != STYLE_MUTED;
}

test st_scale_step_pins_head_over_body {
    assert scale_step(16, 1) == 26;
    assert scale_step(16, 1) == TYPE_HEAD;
    assert scale_step(TYPE_BODY, 1) == TYPE_HEAD;
    assert scale_step(16, 2) == 42;
    assert scale_step(16, 3) == 68;
}

test st_scale_step_walks_both_ways {
    assert scale_step(16, 0) == 16;
    assert scale_step(16, -1) == 10;
    assert scale_step(16, -2) == 6;
    assert scale_step(0, 5) == 0;
    assert scale_step(1000, 1) == 1618;
    assert scale_step(1000, -1) == 618;
}

test st_spacing_scale_is_the_phi_steps_of_8 {
    assert scale_step(8, 0) == SPACE_1;
    assert scale_step(8, 1) == SPACE_2;
    assert scale_step(8, 2) == SPACE_3;
    assert scale_step(8, 3) == SPACE_4;
    assert SPACE_1 < SPACE_2;
    assert SPACE_2 < SPACE_3;
    assert SPACE_3 < SPACE_4;
}

test st_type_scale_is_read_not_generated {
    assert TYPE_CAPT == 13;
    assert TYPE_BODY == 16;
    assert TYPE_HEAD == 26;
    assert TYPE_CAPT < TYPE_BODY;
    assert TYPE_BODY < TYPE_HEAD;
    assert TYPE_CAPT != scale_step(TYPE_BODY, -1);
}

test st_seams_stay_two_named_tokens {
    assert PAD_CARD == 20;
    assert PAD_ROW == 16;
    assert MIN_TOUCH == 44;
    assert MIN_POINTER == 24;
    assert PAD_CARD != PAD_ROW;
    assert MIN_TOUCH != MIN_POINTER;
    assert PAD_ROW == TYPE_BODY;
    assert STYLE_RADIUS == 12;
    assert STYLE_STROKE == 1;
}

test st_no_two_consts_collide {
    assert TYPE_CAPT != TYPE_BODY;
    assert TYPE_CAPT != TYPE_HEAD;
    assert TYPE_BODY != TYPE_HEAD;
    assert SPACE_1 != SPACE_2;
    assert SPACE_1 != SPACE_3;
    assert SPACE_1 != SPACE_4;
    assert SPACE_2 != SPACE_3;
    assert SPACE_2 != SPACE_4;
    assert SPACE_3 != SPACE_4;
    assert LINE_HEAD_PERMILLE != LINE_BODY_PERMILLE;
    assert PAD_CARD != MIN_POINTER;
    assert PAD_ROW != MIN_POINTER;
    assert RADIUS_SM != RADIUS_MD;
    assert RADIUS_SM != RADIUS_LG;
    assert RADIUS_MD != RADIUS_LG;
}

test st_line_heights {
    assert line_height_head() == 30;
    assert line_height_body() == 24;
    assert line_height(16, 1000) == 16;
    assert line_height(13, 1500) == 20;
    assert line_height_head() > TYPE_HEAD;
    assert line_height_body() > TYPE_BODY;
}

test st_radius_scale {
    assert RADIUS_MD == STYLE_RADIUS;
    assert RADIUS_SM < RADIUS_MD;
    assert RADIUS_MD < RADIUS_LG;
    assert radius_full(375, 44) == 22;
    assert radius_full(44, 375) == 22;
    assert radius_fit(RADIUS_LG, 375, 44) == 22;
    assert radius_fit(RADIUS_MD, 375, 44) == 12;
    assert radius_fit(RADIUS_SM, 0, 0) == 0;
}

test st_density_shifts_the_phi_scale {
    assert space_at(1, DENSITY_DEFAULT) == SPACE_1;
    assert space_at(2, DENSITY_DEFAULT) == SPACE_2;
    assert space_at(3, DENSITY_DEFAULT) == SPACE_3;
    assert space_at(4, DENSITY_DEFAULT) == SPACE_4;
    assert space_at(1, DENSITY_COMPACT) == 5;
    assert space_at(2, DENSITY_COMPACT) == 8;
    assert space_at(3, DENSITY_COMPACT) == 13;
    assert space_at(4, DENSITY_COMPACT) == 21;
    assert space_at(1, DENSITY_COMFORTABLE) == 13;
    assert space_at(2, DENSITY_COMFORTABLE) == 21;
    assert space_at(3, DENSITY_COMFORTABLE) == 34;
    assert space_at(4, DENSITY_COMFORTABLE) == 55;
    assert density_shift(DENSITY_COUNT) == 0;
    assert density_shift(7) == 0;
}

test st_dpr_sizes_the_backing_store {
    assert dpr_clamp(0) == 1;
    assert dpr_clamp(1) == 1;
    assert dpr_clamp(2) == 2;
    assert dpr_clamp(3) == 3;
    assert dpr_clamp(4) == 3;
    assert backing_px(375, 2) == 750;
    assert backing_px(812, 2) == 1624;
    assert backing_px(375, 3) == 1125;
    assert backing_rgb_bytes(375, 812, 1) == 913500;
    assert backing_rgb_bytes(375, 812, 2) == 3654000;
    assert backing_rgb_bytes(375, 812, 3) == 8221500;
    assert dpr_pct(1) == 100;
    assert dpr_pct(2) == 200;
    assert dpr_pct(3) == 300;
    assert dpr_pct(9) == 300;
    assert dpr_pct(DPR_MAX) <= 400;
    assert dpr_pct(DPR_MIN) >= 25;
}

test st_negative_controls {
    // a truncating step would give 25, the guide rounds half up to 26
    assert scale_step(16, 1) != 25;
    // a step is a step: n + 1 is strictly larger than n for a positive base
    assert scale_step(16, 2) > scale_step(16, 1);
    assert scale_step(16, 1) > scale_step(16, 0);
    // the touch minimum is not the pointer minimum, and the two paddings differ
    assert MIN_TOUCH > MIN_POINTER;
    assert PAD_CARD > PAD_ROW;
    // the accent is not the muted grey
    assert style_accent() != 0x808080;
    // compact is not default
    assert space_at(1, DENSITY_COMPACT) != space_at(1, DENSITY_DEFAULT);
    // a 2x store is not the 1x store
    assert backing_rgb_bytes(375, 812, 2) != 913500;
    // dpr 0 never gives an empty store
    assert backing_px(375, 0) == 375;
    // full radius never exceeds half the shorter side
    assert radius_fit(1000, 10, 40) == 5;
}
