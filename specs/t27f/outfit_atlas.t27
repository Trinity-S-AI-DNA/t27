pub fn cov(col: usize, row: usize) -> i64 {
    return @as(i64, @intCast(ATLAS[row * ATLAS_W + col]));
}

fn col_ink(col: usize) -> bool {
    var r : usize = 0;
    while (r < ATLAS_H) {
        if (cov(col, r) > 0) {
            return true;
        }
        r = r + 1;
    }
    return false;
}

// Where the g-th run of inked columns starts: glyph g's ink, the glyphs drawn left to right.
// ATLAS_W when there is no such run.
pub fn run_start(g: usize) -> usize {
    var k : usize = 0;
    var c : usize = 0;
    while (c < ATLAS_W) {
        if (col_ink(c) && (c == 0 || col_ink(c - 1) == false)) {
            if (k == g) {
                return c;
            }
            k = k + 1;
        }
        c = c + 1;
    }
    return ATLAS_W;
}

// One past the last inked column of glyph g.
pub fn run_end(g: usize) -> usize {
    var c = run_start(g);
    while (c < ATLAS_W && col_ink(c)) {
        c = c + 1;
    }
    return c;
}

fn runs() -> usize {
    var g : usize = 0;
    while (run_start(g) < ATLAS_W) {
        g = g + 1;
    }
    return g;
}

pub fn em_dots() -> f64 {
    return FONT_PX / SS;
}

// The widest coverage of glyph g on row r.
fn row_max(g: usize, r: usize) -> i64 {
    var m : i64 = 0;
    var c = run_start(g);
    const e = run_end(g);
    while (c < e) {
        if (cov(c, r) > m) {
            m = cov(c, r);
        }
        c = c + 1;
    }
    return m;
}

fn width(g: usize) -> f64 {
    return @as(f64, @floatFromInt(run_end(g) - run_start(g)));
}

// ---- tests ----

test "one run of ink a glyph: 39 glyphs, the space has none" {
    assert(runs() == GLYPHS);
    assert(ADV[GLYPHS] == 185);
    assert(LSB[GLYPHS] == 0);
}

test "the cap height is 12 dots: 135 px to the em at 8 px a dot" {
    assert(@abs(CAP_UNITS * em_dots() / UPM - CAP_ROWS) < 0.05);
}

test "the raster agrees with the outlines: ink widths are glyf's bounding boxes" {
    // H 63..676, O 27..785, comma 47..248, period 53..252, hyphen 51..412 (ttx -t glyf)
    assert(@abs(width(17) - 613.0 * em_dots() / UPM) < 1.5);
    assert(@abs(width(24) - 758.0 * em_dots() / UPM) < 1.5);
    assert(@abs(width(38) - 201.0 * em_dots() / UPM) < 1.5);
    assert(@abs(width(36) - 199.0 * em_dots() / UPM) < 1.5);
    assert(@abs(width(37) - 361.0 * em_dots() / UPM) < 1.5);
    assert(width(18) < width(32));
    assert(width(1) < width(0));
}

test "an H stands on rows 1 to 12, with nothing above and only a fringe below" {
    assert(row_max(17, 0) == 0);
    assert(row_max(17, 1) > 200);
    assert(row_max(17, 12) > 200);
    assert(row_max(17, 13) < 64);
    assert(row_max(17, 14) == 0);
}

test "the comma descends, the period sits on the baseline, the hyphen floats" {
    assert(row_max(38, 14) > 96);
    assert(row_max(36, 14) < 64);
    assert(row_max(36, 12) > 200);
    assert(row_max(37, 1) == 0);
    assert(row_max(37, 12) == 0);
    assert(row_max(37, 9) > 200);
}
