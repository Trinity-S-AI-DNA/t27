// SPDX-License-Identifier: Apache-2.0
// specs/t27f/outfit_atlas.t27 -- t27.ai's display face, Outfit ExtraBold, as a coverage grid: the
// 39 characters specs/t27f/token_floor.t27 writes with particles, drawn 12 dots to the cap height.
//
// WHY: token_floor's letters were a 5x7 dot-matrix font, seven dots to the cap height and every
// glyph five dots wide. The owner asked for the site's own fonts and better quality. t27.ai sets its
// headings in Outfit (apps/website, `outfit-latin.woff2`); this module is that face at weight 800,
// sampled on a grid fine enough that a label of particles reads as Outfit, with proportional widths
// and the outline's antialiasing kept as a dot's light.
//
// WHAT IS HERE: ATLAS is tool-written data, not hand-typed. ADV and LSB are the font's own hmtx
// table. The functions only index them; token_floor places the dots.
//
// PROVENANCE (Railway lab, 2026-10-18; every step is a stock tool, no script):
//   outfit-latin.woff2 from t27.ai, sha256 92684e4acde79ef07758cd09380b7e01e9824d8b061eddeda046f78c166d7b12
//   fonttools varLib.instancer -q outfit-latin.woff2 wght=800 -o outfit-800.ttf
//     sha256 6254f38359c3af8a7f4f0a2fd40278ec50ae96d2db15c3c20b0b28e77b9fee48 (static: ffmpeg 5.1's
//     drawtext ignores a variable font's named instances and draws the default, Outfit Thin)
//   ttx -t hmtx -t glyf outfit-800.ttf   -> ADV, LSB; cap height 709 units (H: yMin 0, yMax 709)
//   textfile = the 39 characters in glyph order, three spaces between them, one line
//   ffmpeg -f lavfi -i color=black:s=6400x128:d=1 -frames:v 1 -filter_script:v F -f rawvideo
//     -pix_fmt gray atlas.raw, with F = drawtext=fontfile=outfit-800.ttf:textfile=T:fontsize=135:
//     fontcolor=white:x=16:y=6,format=gray,scale=800:16:flags=area
//     sha256 cecf12f7c145acee7f022e4a2792258a7c946f4f0c7cc5af545fa67e9474db4e, 12800 bytes
//   od -An -v -tu1 -w32 atlas.raw        -> the rows of ATLAS below
// One string, not one drawtext a glyph, so every glyph shares the baseline (ffmpeg 5.1 aligns a
// lone glyph by its top). 135 px to the em at 8 px a dot puts the cap height at 11.96 dots.
//
// NOT CLAIMED: the dots are not hinted, and pairs are not kerned (Outfit kerns in GPOS, which
// drawtext does not read); token_floor spaces glyphs by advance alone.
// phi^2 + 1/phi^2 = 3 | TRINITY

module outfit_atlas;

pub const ATLAS_W : usize = 800;
pub const ATLAS_H : usize = 16;
pub const CAP_TOP : i64 = 1;                // the first row of a capital
pub const CAP_ROWS : f64 = 12.0;            // rows from the cap top to the baseline
pub const FONT_PX : f64 = 135.0;            // the em the atlas was drawn at, px
pub const SS : f64 = 8.0;                   // drawn px to one dot
pub const UPM : f64 = 1000.0;
pub const CAP_UNITS : f64 = 709.0;
pub const GLYPHS : usize = 39;              // 0-9, A-Z, '.', '-', ','; the space has no ink

// hmtx, font units, in glyph order 0-9, A-Z, '.', '-', ',' and last the space.
pub const ADV : [40]i64 = [671, 390, 576, 569, 613, 568, 579, 530, 569, 579, 742, 650, 692, 761, 627, 602, 791, 739, 305, 550, 721, 567, 866, 748, 812, 640, 819, 663, 596, 649, 708, 722, 1012, 724, 694, 617, 304, 463, 287, 185];
