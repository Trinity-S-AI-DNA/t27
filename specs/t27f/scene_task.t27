// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_task.t27 -- scene A_TASK of reel_factory.t27: the lesson's task as a checklist.
// The English task text is wrapped at 34 letters a row at scale 2; every row gets a box, and the
// first two thirds of the rows are ticked in the accent.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: the task is what the learner is asked to do. A checklist of its own words, partly done, is
// a picture nothing else in the factory draws, and its length is the lesson's.
//
// THE FUNCTION: task_px(t, acc, n, x, y) is the colour of canvas point (x, y). Row r starts at
// y = 100 + 22 * r (at most 24 rows); the box is at x = 20, the text at x = 46.
//
// NOT CLAIMED: it wraps on letters, not words, and the tick is a layout rule, not progress.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_task;

use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::near_seg;
use t27f::scene_raster::char_on;
use t27f::scene_raster::imin;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::reel_topics::item;
use t27f::reel_topics::item_len;
use t27f::reel_topics::cp;

pub const WRAP : i32 = 34;
pub const TY0 : i32 = 100;
pub const TPITCH : i32 = 22;
pub const TMAX : i32 = 24;
pub const TX_BOX : i32 = 20;
pub const TX_TEXT : i32 = 46;

pub fn task_len(t: usize) -> i32 {
    return @as(i32, @intCast(item_len(item(t, 0, 2))));
}
pub fn task_rows(t: usize) -> i32 {
    return imin(@divTrunc(task_len(t) + WRAP - 1, WRAP), TMAX);
}
pub fn task_ch(t: usize, i: i32) -> i32 {
    if (i < 0 || i >= task_len(t)) { return 0; }
    return @as(i32, @intCast(cp(item(t, 0, 2), @as(usize, @intCast(i)))));
}
// Rows ticked: two thirds, rounded up, of the rows.
pub fn ticked(rows: i32) -> i32 {
    return @divTrunc(rows * 2 + 2, 3);
}

pub fn task_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(4, acc, seed_of(t, n, 10), x, y);
    if (y < TY0) { return c0; }
    const rows = task_rows(t);
    const r = @divTrunc(y - TY0, TPITCH);
    if (r >= rows) { return c0; }
    const oy = TY0 + r * TPITCH;
    // the box, with a tick for the done rows
    if (in_rect(x, y, TX_BOX, oy, TX_BOX + 18, oy + 18)) {
        if (r < ticked(rows)) {
            if (near_seg(x, y, TX_BOX + 4, oy + 9, TX_BOX + 8, oy + 14, 1)) { return rgb(10, 12, 24); }
            if (near_seg(x, y, TX_BOX + 8, oy + 14, TX_BOX + 15, oy + 4, 1)) { return rgb(10, 12, 24); }
            return acc;
        }
        if (!in_rect(x, y, TX_BOX + 2, oy + 2, TX_BOX + 16, oy + 16)) { return acc; }
        return rgb(10, 12, 24);
    }
    if (x >= TX_TEXT && y >= oy + 4 && y < oy + 14) {
        const k = @divTrunc(x - TX_TEXT, 8);
        if (k < WRAP) {
            if (char_on(task_ch(t, r * WRAP + k), x, y, TX_TEXT + k * 8, oy + 4, 2)) {
                if (r < ticked(rows)) { return rgb(160, 168, 196); }
                return rgb(245, 247, 255);
            }
        }
    }
    return c0;
}

// ---- tests ----

test "every lesson has a task, a few rows long" {
    var t : usize = 0;
    while (t < 27) {
        assert(task_len(t) > 10);
        assert(task_rows(t) >= 1 && task_rows(t) <= TMAX);
        assert(ticked(task_rows(t)) >= 1 && ticked(task_rows(t)) <= task_rows(t) + 1);
        t = t + 1;
    }
    assert(ticked(3) == 2);
    assert(ticked(6) == 4);
}

test "the task text is drawn: white pixels on the unticked rows" {
    var white : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (task_px(6, 0x22C55E, 3, x, y) == 0xF5F7FF) { white = white + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    assert(white > 30);
}

test "another lesson draws another checklist" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = task_px(2, 0x22C55E, 3, x, y);
            const b = task_px(19, 0x22C55E, 3, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 2;
        }
        y = y + 2;
    }
    assert(diff > 5000);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (task_px(12, 0xE0409A, 5, x, y) != task_px(12, 0xE0409A, 5, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
