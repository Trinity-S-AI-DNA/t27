// SPDX-License-Identifier: Apache-2.0
; specs/t27f/vf_regress.t27 -- visual regression verdict for UI Kit stories (Closes gHashTag/t27#13757, epic #13426).
; Compares a before frame with an after frame and names the verdict: pass (no pixel differs), accepted_diff (pixels
; differ and an issue number accepts them) or reject (pixels differ without an issue, or the issue is 0).
; vf_snapshot.t27 carries no pixel data, so this spec defines its OWN small frame type VrFrame: w, h in 1..8 and a
; bounded array of 64 pixels, one u8 per pixel, row by row, top first. Different sizes are a refusal, not a verdict.
; The verdict carries the count of differing pixels and their bounding box (edges inclusive).
; THIS IS NOT A VISUAL-CORRECTNESS CLAIM: pass says the bytes match, not that either frame looks right.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module VfRegress;

pub const VR_MAX_PX : u32 = 64;
pub const VR_MAX_SIDE : u32 = 8;

; verdict kinds
pub const VR_PASS : u8 = 0;
pub const VR_ACCEPTED : u8 = 1;
pub const VR_REJECT : u8 = 2;
pub const VR_REFUSED : u8 = 3;

pub struct VrFrame {
    w: u32,
    h: u32,
    px: [64]u8,
}

pub struct VrVerdict {
    kind: u8,
    count: u32,
    any: bool,
    x0: u32,
    y0: u32,
    x1: u32,
    y1: u32,
    issue: u32,
}

pub fn vr_frame(w: u32, h: u32, fill: u8) -> VrFrame {
    var f : VrFrame = VrFrame { w: w, h: h, px: [0] ** 64 };
    var i : u32 = 0;
    while i < 64 {
        f.px[i] = fill;
        i = i + 1;
    }
    return f;
}

pub fn vr_valid(f: VrFrame) -> bool {
    if f.w == 0 or f.h == 0 {
        return false;
    }
    if f.w > VR_MAX_SIDE or f.h > VR_MAX_SIDE {
        return false;
    }
    return true;
}

pub fn vr_kind_name(k: u8) -> str {
    if k == VR_PASS {
        return "pass";
    }
    if k == VR_ACCEPTED {
        return "accepted_diff";
    }
    if k == VR_REJECT {
        return "reject";
    }
    return "refused";
}

; the verdict of before vs after; budget is the count of differing pixels allowed without an issue (0 = none);
; issue is the issue number that accepts the diff (0 = none)
pub fn vr_verdict(before: VrFrame, after: VrFrame, budget: u32, issue: u32) -> VrVerdict {
    var v : VrVerdict = VrVerdict { kind: VR_REFUSED, count: 0, any: false, x0: 0, y0: 0, x1: 0, y1: 0, issue: issue };
    if !vr_valid(before) or !vr_valid(after) {
        return v;
    }
    if before.w != after.w or before.h != after.h {
        return v;
    }
    var y : u32 = 0;
    while y < before.h {
        var x : u32 = 0;
        while x < before.w {
            let p : u32 = y * before.w + x;
            if before.px[p] != after.px[p] {
                v.count = v.count + 1;
                if !v.any {
                    v.any = true;
                    v.x0 = x;
                    v.x1 = x;
                    v.y0 = y;
                    v.y1 = y;
                } else {
                    if x < v.x0 {
                        v.x0 = x;
                    }
                    if x > v.x1 {
                        v.x1 = x;
                    }
                    if y < v.y0 {
                        v.y0 = y;
                    }
                    if y > v.y1 {
                        v.y1 = y;
                    }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if v.count == 0 {
        v.kind = VR_PASS;
        return v;
    }
    if issue != 0 {
        v.kind = VR_ACCEPTED;
        return v;
    }
    v.kind = VR_REJECT;
    if v.count <= budget {
        v.kind = VR_PASS;
    }
    return v;
}

test identical_snapshots_pass {
    let a : VrFrame = vr_frame(4, 3, 7);
    let b : VrFrame = vr_frame(4, 3, 7);
    let v : VrVerdict = vr_verdict(a, b, 0, 0);
    assert v.kind == VR_PASS;
    assert v.count == 0;
    assert v.any == false;
}

test one_pixel_change_is_found_with_box {
    let a : VrFrame = vr_frame(4, 3, 7);
    var b : VrFrame = vr_frame(4, 3, 7);
    b.px[1 * 4 + 2] = 200;
    let v : VrVerdict = vr_verdict(a, b, 0, 0);
    assert v.count == 1;
    assert v.any == true;
    assert v.x0 == 2;
    assert v.x1 == 2;
    assert v.y0 == 1;
    assert v.y1 == 1;
    assert v.kind == VR_REJECT;
}

test size_mismatch_refuses {
    let a : VrFrame = vr_frame(4, 3, 7);
    let b : VrFrame = vr_frame(3, 4, 7);
    let v : VrVerdict = vr_verdict(a, b, 100, 5);
    assert v.kind == VR_REFUSED;
    assert v.count == 0;
}

test over_budget_without_issue_is_reject {
    let a : VrFrame = vr_frame(4, 3, 7);
    var b : VrFrame = vr_frame(4, 3, 7);
    b.px[0] = 1;
    b.px[11] = 2;
    b.px[5] = 3;
    let v : VrVerdict = vr_verdict(a, b, 2, 0);
    assert v.kind == VR_REJECT;
    assert v.count == 3;
    assert v.x0 == 0;
    assert v.y0 == 0;
    assert v.x1 == 3;
    assert v.y1 == 2;
}

test accepted_diff_carries_issue {
    let a : VrFrame = vr_frame(4, 3, 7);
    var b : VrFrame = vr_frame(4, 3, 7);
    b.px[6] = 9;
    let v : VrVerdict = vr_verdict(a, b, 0, 13757);
    assert v.kind == VR_ACCEPTED;
    assert v.issue == 13757;
    assert vr_kind_name(v.kind) == "accepted_diff";
}

test accepted_with_issue_zero_is_reject {
    let a : VrFrame = vr_frame(4, 3, 7);
    var b : VrFrame = vr_frame(4, 3, 7);
    b.px[6] = 9;
    let v : VrVerdict = vr_verdict(a, b, 0, 0);
    assert v.kind == VR_REJECT;
    assert vr_kind_name(v.kind) == "reject";
}

test within_budget_passes {
    let a : VrFrame = vr_frame(4, 3, 7);
    var b : VrFrame = vr_frame(4, 3, 7);
    b.px[6] = 9;
    let v : VrVerdict = vr_verdict(a, b, 1, 0);
    assert v.kind == VR_PASS;
    assert v.count == 1;
}
