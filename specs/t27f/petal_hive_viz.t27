; specs/t27f/petal_hive_viz.t27 -- petal 8 (H HIVE) of the interactive visualization epic.
; Refs epic t27#12173; built on specs/t27f/viz_contract.t27 (the landed drill law).
; --
; Question: "Which bee works which issue, and where does its ship fly right now?"
; Source:   specs/queen/hive.t27 -- ship_mode, ship_kept, ship_alpha over DEPART_MS, cell_effect
;           over the source's own FX_OF_KIND table. Called, never copied.
; Fixture:  the source's own sample table (FX_OF_KIND) is the fixture for effects. hive.t27 keeps
;           no bee data -- it grades what the host feeds -- so the five bee rows below are this
;           petal's recorded reading of those laws, pinned FIXTURE, never publishable as live.
; Identity: the SOURCE CELL KIND (CELL_PLACED/PENDING/NONE), packed as the contract cell ref -- a
;           batch that re-places a cell does not change the kind, so the drill survives refresh.
; Flags:    view = ship row + detail card; source = specs/queen/hive.t27; live = NO (fixture-fed;
;           the live feed is the host route, still the named missing link).
; Layers:
;   L1 state    the one VizState. hav_apply forwards every contract event (VIZ_EV_DRILL included)
;               to the one reducer viz_apply and adds ONE petal event (the tick).
;   L2 refs     bee b = viz_ref(ENT_NODE, b); its cell identity = viz_ref(ENT_CELL, source kind).
;   L3 words    mode/effect WORDS from the source's own functions -- text tags, never colour-only.
;   L4 honest   an unmeasured age is "not measured" (the ship is not drawn working on no data);
;               a departing ship past DEPART_MS is gone; a gone bee refuses the drill.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module PetalHiveViz;

use t27f::viz_contract::VizState;
use t27f::viz_contract::viz_apply;
use t27f::viz_contract::viz_init;
use t27f::viz_contract::viz_ref;
use t27f::viz_contract::viz_ref_kind;
use t27f::viz_contract::VIZ_REF_NONE;
use t27f::viz_contract::VIZ_ENT_NODE;
use t27f::viz_contract::VIZ_ENT_CELL;
use t27f::viz_contract::VIZ_EV_COUNT;
use t27f::viz_contract::VIZ_EV_LOAD;
use t27f::viz_contract::VIZ_EV_LOADED;
use t27f::viz_contract::VIZ_EV_DRILL;
use t27f::viz_contract::VIZ_EV_BACK;
use t27f::viz_contract::VIZ_LC_READY;
use t27f::viz_contract::VIZ_LV_OVERVIEW;
use t27f::viz_contract::VIZ_LV_DETAIL;
use t27f::viz_contract::VIZ_ZOOM_NONE;
use t27f::viz_contract::VIZ_ZOOM_LIVE;
use t27f::viz_contract::VIZ_TRUTH_DEMO;
use queen::hive::CELL_PLACED;
use queen::hive::CELL_PENDING;
use queen::hive::CELL_NONE;
use queen::hive::SM_PARK;
use queen::hive::SM_ORBIT;
use queen::hive::SM_HOVER;
use queen::hive::ship_mode;
use queen::hive::ship_kept;
use queen::hive::ship_alpha;
use queen::hive::cell_effect;
use queen::hive::FX_OF_KIND;
use queen::hive::FX_NONE;
use queen::hive::DEPART_MS;

; --- 1. The fixture bees -----------------------------------------------------------------------------

/// The petal's recorded bees: queue flag, working flag, source cell kind, departing flag, age ms.
pub const HB_COUNT : u32 = 5;
pub const HB_QUEUED : [5]u8 = [0, 0, 1, 0, 0];
pub const HB_WORKING : [5]u8 = [1, 1, 0, 1, 0];
pub const HB_CELL : [5]u8 = [CELL_PLACED, CELL_PENDING, CELL_NONE, CELL_PLACED, CELL_PLACED];
pub const HB_DEPARTING : [5]u8 = [0, 0, 0, 0, 1];
pub const HB_AGE_MS : [5]u32 = [1200, 0, 0, 600, 2400];

/// An age the host never measured: the honest mark, never a guessed number.
pub const HB_AGE_NOT_MEASURED : u32 = 4294967295;

; --- 2. The state door -------------------------------------------------------------------------------

/// The petal event: one wall-clock tick (a = now_ms), above VIZ_EV_COUNT.
pub const PHV_EV_TICK : u8 = VIZ_EV_COUNT;

pub fn hav_init() -> VizState {
    return viz_init(2, HB_COUNT);
}

/// The one input door: every contract event forwards to viz_apply (VIZ_EV_DRILL included), the
/// tick re-grades the fixture at the given time. Nothing bypasses the reducer.
pub fn hav_apply(s : VizState, ev : u8, a : u32, b : u32) -> VizState {
    var n : VizState = viz_apply(s, ev, a, b);
    if (ev == PHV_EV_TICK) { n.revision = n.revision + 1; }
    return n;
}

; --- 3. The words and the honest marks ---------------------------------------------------------------

pub fn phv_mode(b : u32) -> u8 {
    return ship_mode(HB_QUEUED[b] != 0, HB_WORKING[b] != 0, HB_CELL[b], HB_DEPARTING[b] != 0);
}

pub fn phv_kept(b : u32, now_ms : u32) -> bool {
    if (HB_AGE_MS[b] == HB_AGE_NOT_MEASURED) { return false; }
    return ship_kept(now_ms - HB_AGE_MS[b]);
}

pub fn phv_gone(b : u32, now_ms : u32) -> bool {
    return HB_DEPARTING[b] != 0 and now_ms - HB_AGE_MS[b] >= DEPART_MS;
}

pub fn phv_alpha(b : u32, now_ms : u32) -> u32 {
    return ship_alpha(HB_DEPARTING[b] != 0, now_ms - HB_AGE_MS[b]);
}

/// The effect word of bee b's cell, read from the source's own FX_OF_KIND table.
pub fn phv_effect(b : u32, accepted : bool) -> u8 {
    return cell_effect(HB_CELL[b], accepted);
}

; --- 4. Identity and the drill -----------------------------------------------------------------------

/// Bee b's entity ref.
pub fn phv_bee_ref(b : u32) -> u32 {
    return viz_ref(VIZ_ENT_NODE, b);
}

/// The drill identity of bee b: its SOURCE CELL KIND packed as a cell ref. Never zero, so the
/// contract's drill accepts it; the same kind packs the same identity after any batch.
pub fn phv_cell_identity(b : u32) -> u32 {
    return viz_ref(VIZ_ENT_CELL, HB_CELL[b] as u32);
}

/// Feed the drill through the one door: select a bee -> zoom to its cell identity. A gone bee
/// drills with the NONE word, which the contract refuses -- an explicit no-op, not a ghost.
pub fn phv_drill(s : VizState, b : u32, now_ms : u32) -> VizState {
    if (phv_gone(b, now_ms)) { return hav_apply(s, VIZ_EV_DRILL, VIZ_ZOOM_NONE, 0); }
    return hav_apply(s, VIZ_EV_DRILL, phv_cell_identity(b), 0);
}

; --- 5. The badge ------------------------------------------------------------------------------------

/// The badge truth: the bees are recorded fixture rows, so the page reads DEMO, never LIVE.
pub fn phv_badge_truth() -> u8 {
    return VIZ_TRUTH_DEMO;
}

// ---------------------------------------------------------------- tests

test the_fixture_bees_grade_through_the_source_laws {
    var s : VizState = hav_init();
    s = hav_apply(s, VIZ_EV_LOAD, 0, 0);
    s = hav_apply(s, VIZ_EV_LOADED, HB_COUNT, VIZ_TRUTH_DEMO as u32);
    assert(s.lifecycle == VIZ_LC_READY and s.item_count == HB_COUNT);
    // placed+working -> ORBIT on its cell; queued+no cell -> PARK at the entrance;
    // pending cell -> PORTAL at its repository
    assert(phv_mode(0) == SM_ORBIT);
    assert(phv_mode(2) == SM_PARK);
    assert(phv_mode(1) == SM_PORTAL);
    assert(phv_mode(3) == SM_ORBIT);
    // a departing ship flies HOME by the source's mode law
    assert(phv_mode(4) == SM_HOME);
    var b : u32 = 0;
    while (b < HB_COUNT) {
        assert(phv_mode(b) <= SM_HOME);
        b = b + 1;
    }
}

test every_input_goes_through_hav_apply_to_viz_apply {
    var s : VizState = hav_init();
    const r0 : u32 = s.revision;
    s = hav_apply(s, VIZ_EV_LOAD, 0, 0);
    assert(s.revision == r0 + 1);
    s = hav_apply(s, VIZ_EV_LOADED, HB_COUNT, VIZ_TRUTH_DEMO as u32);
    s = hav_apply(s, PHV_EV_TICK, 1200, 0);
    assert(s.revision == r0 + 3);
}

test the_state_is_a_word_not_a_colour {
    // the effect word is read from the source's own table, not restated
    assert(phv_effect(0, true) == FX_OF_KIND[CELL_PLACED]);
    assert(cell_effect(CELL_NONE, true) == FX_NONE and FX_OF_KIND[CELL_NONE] == FX_NONE);
    // a kept ship has full alpha (thousandths); the departing ship fades by the source's own law
    assert(phv_alpha(0, 1200) == 1000);
    assert(phv_alpha(4, 3600) == 500);
    assert(phv_alpha(4, 2400 + DEPART_MS) == 0);
}

test gone_and_not_measured_are_honest {
    // bee 4 left at 2400: kept until 2400+DEPART_MS, gone from exactly that wall clock
    assert(phv_gone(4, 4799) == false and phv_gone(4, 4800));
    // an unmeasured age is never drawn as kept -- "not measured", not a guess
    assert(HB_AGE_NOT_MEASURED == 4294967295);
    assert(phv_kept(0, 1200) and phv_kept(4, 4800) == false);
    // the drill refuses a gone bee: the zoom id stays NONE, the level stays overview
    var s : VizState = hav_init();
    s = hav_apply(s, VIZ_EV_LOAD, 0, 0);
    s = hav_apply(s, VIZ_EV_LOADED, HB_COUNT, VIZ_TRUTH_DEMO as u32);
    s = phv_drill(s, 4, 4800);
    assert(s.zoom_id == VIZ_ZOOM_NONE and s.level == VIZ_LV_OVERVIEW and s.zoom_gone == VIZ_ZOOM_LIVE);
}

test the_drill_identity_is_the_source_cell_kind {
    var s : VizState = hav_init();
    s = hav_apply(s, VIZ_EV_LOAD, 0, 0);
    s = hav_apply(s, VIZ_EV_LOADED, HB_COUNT, VIZ_TRUTH_DEMO as u32);
    // drill bee 0: the zoom id is its PLACED cell identity, the level moves to detail
    s = phv_drill(s, 0, 1200);
    assert(s.level == VIZ_LV_DETAIL and s.zoom_id == phv_cell_identity(0));
    assert(s.zoom_id != VIZ_ZOOM_NONE and viz_ref_kind(s.zoom_id) == VIZ_ENT_CELL);
    // bees 0 and 3 sit on the same source cell kind: the same drill identity
    assert(phv_cell_identity(0) == phv_cell_identity(3));
    // a different kind drills elsewhere
    assert(phv_cell_identity(1) != phv_cell_identity(2));
    // BACK from detail clears the zoom and returns to overview (the contract's drill law)
    s = hav_apply(s, VIZ_EV_BACK, 0, 0);
    assert(s.level == VIZ_LV_OVERVIEW and s.zoom_id == VIZ_ZOOM_NONE and s.zoom_gone == VIZ_ZOOM_LIVE);
}

test the_fixture_is_never_live {
    // the bees are recorded rows: the badge reads DEMO and stays DEMO however the clock ticks
    assert(phv_badge_truth() == VIZ_TRUTH_DEMO);
    var s : VizState = hav_init();
    s = hav_apply(s, VIZ_EV_LOAD, 0, 0);
    s = hav_apply(s, VIZ_EV_LOADED, HB_COUNT, VIZ_TRUTH_DEMO as u32);
    s = hav_apply(s, PHV_EV_TICK, 9999, 0);
    assert(s.truth == VIZ_TRUTH_DEMO);
}

invariant the_hive_petal_sends_every_input_through_one_reducer {
    assert(HB_COUNT == 5 and PHV_EV_TICK == VIZ_EV_COUNT);
    assert(CELL_PLACED == 0 and CELL_PENDING == 1 and CELL_NONE == 2);
    assert(DEPART_MS == 2400);
}
