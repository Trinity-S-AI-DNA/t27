use t27f::export_video::MAX_EXPORT_FRAMES;
use t27f::export_video::PRESET_LANDSCAPE;
use t27f::export_video::PRESET_PORTRAIT;
use t27f::export_video::PRESET_KINDS;
use t27f::export_video::preset_ok;
use t27f::export_video::preset_width;
use t27f::export_video::preset_height;
use t27f::export_video::frame_stream;
use t27f::export_video::fixture_scene;
use t27f::scene_raster::fmod;
use t27f::scene_raster::imax;
use t27f::scene_raster::red;
use t27f::scene_raster::green;
use t27f::scene_raster::blue;
use t27os::editors::same_bytes;
use tri::crypto::sha256;

pub const ID : str = "frame-render";
/// 1 was the rect/alpha/group raster that merged as #11816; 2 adds the off-stream text draw.
pub const VERSION : u8 = 2;

// ---- the raster --------------------------------------------------------------------------------------

/// Both presets paint this many pixels (1920 x 1080 == 1080 x 1920); the buffer belongs to the
/// caller, so nothing here allocates one.
pub const FRAME_PIXELS : u32 = 2073600;
pub const FRAME_RGB_LEN : u32 = 3 * FRAME_PIXELS;

/// display_list flattens containers with an open[32] stack; the raster side mirrors that bound.
pub const GROUP_STACK_MAX : u32 = 32;

/// The clear colour every frame_bytes starts from, and the colour of a rect before any DL_FILL
/// record arrives. Colours are 0xRRGGBB in an i32, as scene_raster.t27 states.
pub const R_BG : i32 = 0x101418;
pub const R_DEFAULT_FILL : i32 = 0xC8C8C8;

/// Token id -> RGB, indexed by the style token the display list carries (0..STYLE_KINDS). The
/// display list names a token, not a colour; this table is the harness's one mapping, pinned by
/// test so a change moves loudly.
pub const PALETTE : [5]i32 = [0x3A6EA5, 0xC8C8C8, 0x50FA7B, 0xC8A032, 0x903838];

// ---- what the functions answer -----------------------------------------------------------------------

pub const FRAME_OK : u8 = 0;
pub const E_PRESET : u8 = 1;               // the preset is not one of the two export sizes
pub const E_RANGE : u8 = 2;                // a frame outside the schedule, or a buffer too small
pub const E_BUDGET : u8 = 3;               // display_list refused the flatten (its frame budget)
pub const E_UNSUPPORTED : u8 = 4;          // the stream carries an op this harness does not render
pub const E_TRUNC : u8 = 5;                // the stream ends mid-record or mid-rect
pub const E_DEPTH : u8 = 6;                // group stack overflow, an unbalanced open or close
pub const E_VALUE : u8 = 7;                // a payload outside its legal range
pub const RESULT_NAMES : [8]str = ["ok", "preset", "range", "budget", "unsupported", "trunc", "depth", "value"];

fn raster_ok(w: u32, h: u32) -> bool {
    if (w == 0 or h == 0) { return false; }
    if (w > 4096 or h > 4096) { return false; }
    return w * h <= FRAME_PIXELS;
}

// ---- bytes --------------------------------------------------------------------------------------------

/// The little-endian payload decode: the exact inverse of display_list's division-and-remainder
/// emit, walking the four bytes back to front so no factor overflows.
fn decode4(b: []const u8, at: usize) -> u32 {
    var v : u32 = 0;
    var k : usize = 4;
    while (k > 0) {
        k = k - 1;
        v = v * 256 + (b[at + k] as u32);
    }
    return v;
}

// ---- the PPM writer -----------------------------------------------------------------------------------

pub fn digits10(v: u32) -> u32 {
    if (v < 10) { return 1; }
    var n : u32 = 0;
    var x = v;
    while (x > 0) {
        n = n + 1;
        x = @divTrunc(x, 10);
    }
    return n;
}

/// "P6\n<w> <h>\n255\n": 3 bytes, the width, a space, the height, a newline, and "255\n".
pub fn ppm_header_len(w: u32, h: u32) -> u32 {
    return 3 + digits10(w) + 1 + digits10(h) + 1 + 4;
}

/// The whole file's size: header plus 3*w*h RGB bytes. Both presets: 17 + 6220800. A raster this
/// card refuses answers 0 -- no bytes, not a wrong number.
pub fn ppm_len(w: u32, h: u32) -> u32 {
    if (!raster_ok(w, h)) { return 0; }
    return ppm_header_len(w, h) + 3 * w * h;
}

fn write_dec(dst: []u8, at: usize, v: u32) -> usize {
    const n = digits10(v);
    var x = v;
    var i : usize = n as usize;
    while (i > 0) {
        dst[at + i - 1] = ((x - @divTrunc(x, 10) * 10) as u8) + 48;
        x = @divTrunc(x, 10);
        i = i - 1;
    }
    return at + (n as usize);
}

/// Lay the P6 header down at dst[0..]. FRAME_OK, or E_RANGE for a refused raster or a short dst.
pub fn ppm_header_into(dst: []u8, w: u32, h: u32) -> u8 {
    if (!raster_ok(w, h)) { return E_RANGE; }
    const need = ppm_header_len(w, h);
    if ((dst.len as u32) < need) { return E_RANGE; }
    dst[0] = 80;                           // 'P'
    dst[1] = 54;                           // '6'
    dst[2] = 10;                           // '\n'
    var at : usize = write_dec(dst, 3, w);
    dst[at] = 32;                          // ' '
    at = at + 1;
    at = write_dec(dst, at, h);
    dst[at] = 10;                          // '\n'
    at = at + 1;
    dst[at] = 50;                          // '2'
    dst[at + 1] = 53;                      // '5'
    dst[at + 2] = 53;                      // '5'
    dst[at + 3] = 10;                      // '\n'
    return FRAME_OK;
}

/// The whole PPM: header, then the RGB rows verbatim. ffmpeg consumes the result directly.
pub fn ppm_write_into(dst: []u8, rgb: []const u8, w: u32, h: u32) -> u8 {
    if (!raster_ok(w, h)) { return E_RANGE; }
    const need = 3 * w * h;
    const total = ppm_len(w, h);
    if (rgb.len < (need as usize)) { return E_RANGE; }
    if ((dst.len as u32) < total) { return E_RANGE; }
    const hr = ppm_header_into(dst, w, h);
    if (hr != FRAME_OK) { return hr; }
    const hl = ppm_header_len(w, h) as usize;
    var j : u32 = 0;
    while (j < need) {
        dst[hl + (j as usize)] = rgb[j as usize];
        j = j + 1;
    }
    return FRAME_OK;
}

// ---- the rasterizer -----------------------------------------------------------------------------------

/// The dry pass: walk every record and refuse the first thing this harness does not render, before
/// any byte of the buffer can move. st.ops is display_list's budget counter and means nothing here;
/// the rasterizer reads st.n and st.bytes only. Since VERSION 2 this pass still refuses DL_TEXT:
/// its four records carry only the node's x, y, w, h -- display_list's encoding has no string
/// carrier, and scene.t27 gives a node no text-valued field -- so text reaches pixels through
/// draw_text, with the string the caller holds, never through this walk.
pub fn validate_stream(st: *Stream) -> u8 {
    var i : u32 = 0;
    var rect_phase : u32 = 0;
    var depth : u32 = 0;
    while (i < st.n) {
        const op = st.bytes[i as usize];
        if (op >= DL_KINDS) { return E_UNSUPPORTED; }
        const pl = payload_len(op) as u32;
        if (i + 1 + pl > st.n) { return E_TRUNC; }
        // DL_TEXT stays refused here (see THE TEXT in the header): no string rides the stream.
        if (op == DL_TEXT or op == DL_PATH or op == DL_IMAGE or op == DL_FACE or op == DL_CLIP_PUSH or op == DL_CLIP_POP or op == DL_STROKE) {
            return E_UNSUPPORTED;
        }
        if (op == DL_OPACITY) {
            if (decode4(st.bytes[0..st.n], (i + 1) as usize) > (Q8 as u32)) { return E_VALUE; }
        }
        if (op == DL_FILL) {
            if ((st.bytes[(i + 1) as usize] as u32) >= (STYLE_KINDS as u32)) { return E_VALUE; }
        }
        if (op == DL_GROUP) {
            if (decode4(st.bytes[0..st.n], (i + 1) as usize) >= 2147483648) { return E_VALUE; }
            depth = depth + 1;
            if (depth > GROUP_STACK_MAX) { return E_DEPTH; }
        }
        if (op == DL_GROUP_END) {
            if (depth == 0) { return E_DEPTH; }
            depth = depth - 1;
        }
        if (op == DL_RECT) {
            if (decode4(st.bytes[0..st.n], (i + 1) as usize) >= 2147483648) { return E_VALUE; }
            rect_phase = rect_phase + 1;
            if (rect_phase == 4) { rect_phase = 0; }
        }
        if (op == DL_END) {
            if (rect_phase != 0) { return E_TRUNC; }
            if (depth != 0) { return E_DEPTH; }
            return FRAME_OK;
        }
        i = i + 1 + pl;
    }
    if (rect_phase != 0) { return E_TRUNC; }
    if (depth != 0) { return E_DEPTH; }
    return FRAME_OK;
}

/// One channel of the Q8 alpha rule, pinned by test: (fg*a + dst*(Q8-a)) div Q8, floored.
fn blend_q8(dst: i32, fg: i32, a: i32) -> i32 {
    return @divTrunc(fg * a + dst * (Q8 - a), Q8);
}

/// fill_rect with alpha, clipped to the raster: rows ys..ye, columns xs..xe, one blend per channel.
/// A rect reaching past the raster is clipped, not refused -- that is what fill_rect means.
fn fill_rect(rgb: []u8, w: u32, h: u32, x0: i32, y0: i32, rw: u32, rh: u32, color: i32, alpha: i32) -> void {
    if (rw == 0 or rh == 0) { return; }
    if (alpha == 0) { return; }
    if (x0 < 0 or y0 < 0) { return; }
    if ((x0 as i64) >= (w as i64) or (y0 as i64) >= (h as i64)) { return; }
    var xs : i64 = x0 as i64;
    var ys : i64 = y0 as i64;
    var xe : i64 = xs + (rw as i64);
    var ye : i64 = ys + (rh as i64);
    if (xe > (w as i64)) { xe = w as i64; }
    if (ye > (h as i64)) { ye = h as i64; }
    const fr = red(color);
    const fgc = green(color);
    const fb = blue(color);
    var yy : u32 = ys as u32;
    while ((yy as i64) < ye) {
        var xx : u32 = xs as u32;
        while ((xx as i64) < xe) {
            const p : usize = ((yy * w + xx) * 3) as usize;
            rgb[p] = blend_q8(rgb[p] as i32, fr, alpha) as u8;
            rgb[p + 1] = blend_q8(rgb[p + 1] as i32, fgc, alpha) as u8;
            rgb[p + 2] = blend_q8(rgb[p + 2] as i32, fb, alpha) as u8;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

/// The paint pass. Runs only after validate_stream answered FRAME_OK, so every record here is one
/// this harness renders: rect, fill, opacity, group, end -- nothing else can reach this walk.
fn paint_stream(rgb: []u8, w: u32, h: u32, st: *Stream) -> u8 {
    var fill = R_DEFAULT_FILL;
    var alpha = Q8;
    var ox : [33]i32 = undefined;
    var oy : [33]i32 = undefined;
    ox[0] = 0;
    oy[0] = 0;
    var depth : u32 = 0;
    var rx : u32 = 0;
    var ry : u32 = 0;
    var rw : u32 = 0;
    var rh : u32 = 0;
    var rect_phase : u32 = 0;
    var i : u32 = 0;
    while (i < st.n) {
        const op = st.bytes[i as usize];
        const pl = payload_len(op) as u32;
        if (op == DL_END) { return FRAME_OK; }
        if (op == DL_OPACITY) { alpha = (decode4(st.bytes[0..st.n], (i + 1) as usize)) as i32; }
        if (op == DL_FILL) { fill = PALETTE[st.bytes[(i + 1) as usize] as usize]; }
        if (op == DL_GROUP) {
            depth = depth + 1;
            ox[depth as usize] = ox[(depth - 1) as usize] + (decode4(st.bytes[0..st.n], (i + 1) as usize) as i32);
            oy[depth as usize] = oy[(depth - 1) as usize];
        }
        if (op == DL_GROUP_END) { depth = depth - 1; }
        if (op == DL_RECT) {
            const v = decode4(st.bytes[0..st.n], (i + 1) as usize);
            if (rect_phase == 0) { rx = v; }
            if (rect_phase == 1) { ry = v; }
            if (rect_phase == 2) { rw = v; }
            if (rect_phase == 3) {
                rh = v;
                fill_rect(rgb, w, h, ox[depth as usize] + (rx as i32), oy[depth as usize] + (ry as i32), rw, rh, fill, alpha);
            }
            rect_phase = rect_phase + 1;
            if (rect_phase == 4) { rect_phase = 0; }
        }
        i = i + 1 + pl;
    }
    return FRAME_OK;
}

/// Clear the raster to R_BG. The clear is opaque by definition: alpha belongs to the ops.
pub fn clear_rgb(rgb: []u8, w: u32, h: u32) -> u8 {
    if (!raster_ok(w, h)) { return E_RANGE; }
    const need = 3 * w * h;
    if (rgb.len < (need as usize)) { return E_RANGE; }
    const r = red(R_BG) as u8;
    const g = green(R_BG) as u8;
    const b = blue(R_BG) as u8;
    var p : u32 = 0;
    while (p < w * h) {
        rgb[(p * 3) as usize] = r;
        rgb[(p * 3 + 1) as usize] = g;
        rgb[(p * 3 + 2) as usize] = b;
        p = p + 1;
    }
    return FRAME_OK;
}

/// Render one display list into an RGB buffer the caller owns. The whole stream is validated
/// first, so a refused frame leaves the buffer byte-identical to what the caller passed in.
pub fn render_stream_into(rgb: []u8, w: u32, h: u32, st: *Stream) -> u8 {
    if (!raster_ok(w, h)) { return E_RANGE; }
    const need = 3 * w * h;
    if (rgb.len < (need as usize)) { return E_RANGE; }
    const v = validate_stream(st);
    if (v != FRAME_OK) { return v; }
    return paint_stream(rgb, w, h, st);
}

// ---- the 5x7 font and its draw ------------------------------------------------------------------------

/// The built-in font: the printable ASCII subset 32..126, one glyph per code. 95 glyphs, 7 rows a
/// glyph, 5 pixels a row; the bytes run top to bottom, bit 4 is the leftmost pixel of a row, bits
/// 3..0 walk right. The shapes are the classic public-domain 5x7 GLCD font set, transposed from its
/// column-per-byte source table to these rows; the source table is kept beside this one (CLASSIC_
/// COLS, below) and a test re-derives every row from it, so a transposition slip cannot ship. A, B,
/// 0, 1, space and period are pinned bit-exactly in row form too, and every row byte is < 32 for
/// the whole table, so an error cannot hide in a high bit.
pub const FONT : [95][7]u8 = [
    [0, 0, 0, 0, 0, 0, 0],          // 32 space
    [4, 4, 4, 4, 4, 0, 4],          // 33 !
    [10, 10, 10, 0, 0, 0, 0],       // 34 "
    [10, 10, 31, 10, 31, 10, 10],   // 35 #
    [4, 15, 20, 14, 5, 30, 4],      // 36 $
    [24, 25, 2, 4, 8, 19, 3],       // 37 %
    [12, 18, 20, 8, 21, 18, 13],    // 38 &
    [12, 4, 8, 0, 0, 0, 0],         // 39 '
    [2, 4, 8, 8, 8, 4, 2],          // 40 (
    [8, 4, 2, 2, 2, 4, 8],          // 41 )
    [0, 10, 4, 31, 4, 10, 0],       // 42 *
    [0, 4, 4, 31, 4, 4, 0],         // 43 +
    [0, 0, 0, 0, 12, 4, 8],         // 44 ,
    [0, 0, 0, 31, 0, 0, 0],         // 45 -
    [0, 0, 0, 0, 0, 12, 12],        // 46 .
    [0, 1, 2, 4, 8, 16, 0],         // 47 /
    [14, 17, 19, 21, 25, 17, 14],   // 48 0
    [4, 12, 4, 4, 4, 4, 14],        // 49 1
    [14, 17, 1, 2, 4, 8, 31],       // 50 2
    [31, 2, 4, 2, 1, 17, 14],       // 51 3
    [2, 6, 10, 18, 31, 2, 2],       // 52 4
    [31, 16, 30, 1, 1, 17, 14],     // 53 5
    [6, 8, 16, 30, 17, 17, 14],     // 54 6
    [31, 1, 2, 4, 8, 8, 8],         // 55 7
    [14, 17, 17, 14, 17, 17, 14],   // 56 8
    [14, 17, 17, 15, 1, 2, 12],     // 57 9
    [0, 12, 12, 0, 12, 12, 0],      // 58 :
    [0, 12, 12, 0, 12, 4, 8],       // 59 ;
    [1, 2, 4, 8, 4, 2, 1],          // 60 <
    [0, 0, 31, 0, 31, 0, 0],        // 61 =
    [16, 8, 4, 2, 4, 8, 16],        // 62 >
    [14, 17, 1, 2, 4, 0, 4],        // 63 ?
    [14, 17, 1, 13, 21, 21, 14],    // 64 @
    [14, 17, 17, 17, 31, 17, 17],   // 65 A
