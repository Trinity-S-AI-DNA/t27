; --- L5. The style law of the menu ---------------------------------------------------------------------

pub const UT_BG_RGB : u32 = 0;
pub const UT_FG_RGB : u32 = 16777215;
pub const UT_FONT : str = "Outfit";
/// 27 letters, 26 commas and the second byte of Ti: 54 bytes.
pub const UT_LETTERS_LEN : u32 = 54;
/// Contrast in thousandths of a ratio: a tinted frost over black keeps at least 7.6:1.
pub const UT_FROST_MIN_CONTRAST_MILLI : u32 = 7600;
/// White on black is 21:1, the ceiling of the WCAG ratio.
pub const UT_WHITE_ON_BLACK_MILLI : u32 = 21000;
/// A white frost is drawn at full alpha, so it reads white, not grey.
pub const UT_FROST_WHITE_ALPHA : u32 = 255;

; --- L6. Budgets (suggested: estimates from the counts, not measurements) ------------------------------

/// Graph nodes the menu needs: a root, the centre and 27 petals.
pub const UT_MENU_NODES : u32 = 29;
/// Display list ops the menu needs: 4 per petal (fill, quad, stroke, glyph), 3 for the centre, 1 END.
/// This assumes the missing ops of arrows A1 and A6: a quad op and a glyph op that each carry all
/// their coordinates in one record.
pub const UT_MENU_OPS : u32 = 112;
/// Today's encoding spends one op per int (flatten_into emits x, y, w, h as four ops) plus one per
/// state value, so a petal as a shape node and a label node costs at least 13 ops (opacity, fill,
/// stroke and 4 ints for the shape; opacity, fill and 4 ints for the label), and 4 ints cannot hold
/// a quad's 8. The menu at 27 * 13 = 351 is over the 128-op frame budget.
pub const UT_MIN_OPS_PER_PETAL_TODAY : u32 = 13;

; --- L7. Accessors -------------------------------------------------------------------------------------

pub fn ut_obj_name(i: u32) -> []const u8 {
    if (i >= UT_OBJ_COUNT) { return ""; }
    return UT_OBJ_NAME[i];
}

pub fn ut_obj_owner(i: u32) -> []const u8 {
    if (i >= UT_OBJ_COUNT) { return ""; }
    return UT_OBJ_OWNER[i];
}

pub fn ut_obj_gap(i: u32) -> []const u8 {
    if (i >= UT_OBJ_COUNT) { return ""; }
    return UT_OBJ_GAP[i];
}

pub fn ut_obj_scope(i: u32) -> u8 {
    if (i >= UT_OBJ_COUNT) { return UT_PER_TARGET; }
    return UT_OBJ_SCOPE[i];
}

pub fn ut_obj_label(i: u32) -> u8 {
    if (i >= UT_OBJ_COUNT) { return UT_MISSING; }
    return UT_OBJ_LABEL[i];
}

pub fn ut_obj_pr(i: u32) -> u32 {
    if (i >= UT_OBJ_COUNT) { return UT_PR_NONE; }
    return UT_OBJ_PR[i];
}

pub fn ut_arr_from(a: u32) -> u8 {
    if (a >= UT_ARR_COUNT) { return 255; }
    return UT_ARR_FROM[a];
}

pub fn ut_arr_to(a: u32) -> u8 {
    if (a >= UT_ARR_COUNT) { return 255; }
    return UT_ARR_TO[a];
}

pub fn ut_arr_spec(a: u32) -> []const u8 {
    if (a >= UT_ARR_COUNT) { return ""; }
    return UT_ARR_SPEC[a];
}

pub fn ut_arr_gap(a: u32) -> []const u8 {
    if (a >= UT_ARR_COUNT) { return ""; }
    return UT_ARR_GAP[a];
}

pub fn ut_arr_label(a: u32) -> u8 {
    if (a >= UT_ARR_COUNT) { return UT_MISSING; }
    return UT_ARR_LABEL[a];
}

pub fn ut_arr_pr(a: u32) -> u32 {
    if (a >= UT_ARR_COUNT) { return UT_PR_NONE; }
    return UT_ARR_PR[a];
}

/// How many objects carry a label.
pub fn ut_obj_count(label: u8) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < UT_OBJ_COUNT) {
        if (UT_OBJ_LABEL[i] == label) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// How many arrows carry a label.
pub fn ut_arr_count(label: u8) -> u32 {
    var n : u32 = 0;
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (UT_ARR_LABEL[a] == label) { n = n + 1; }
        a = a + 1;
    }
    return n;
}

/// How many arrows end at an object.
pub fn ut_arrows_into(obj: u8) -> u32 {
    var n : u32 = 0;
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (UT_ARR_TO[a] == obj) { n = n + 1; }
        a = a + 1;
    }
    return n;
}

/// How many arrows start at an object.
pub fn ut_arrows_from(obj: u8) -> u32 {
    var n : u32 = 0;
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (UT_ARR_FROM[a] == obj) { n = n + 1; }
        a = a + 1;
    }
    return n;
}

/// A target reads the display list and nothing else.
pub fn ut_target_reads_only_the_list(obj: u8) -> bool {
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (UT_ARR_TO[a] == obj and UT_ARR_FROM[a] != OBJ_DISPLAY_LIST) { return false; }
        a = a + 1;
    }
    return ut_arrows_into(obj) == 1;
}

; --- Tests ---------------------------------------------------------------------------------------------

test the_object_table_is_complete {
    assert UT_OBJ_COUNT == 13;
    assert UT_OBJ_NAME.len == 13;
    assert UT_OBJ_OWNER.len == 13;
    assert UT_OBJ_SCOPE.len == 13;
    assert UT_OBJ_LABEL.len == 13;
    assert UT_OBJ_PR.len == 13;
    assert UT_OBJ_GAP.len == 13;
    var i : u32 = 0;
    while (i < UT_OBJ_COUNT) {
        assert ut_obj_name(i).len > 0;
        assert pvp_is_spec_path(ut_obj_owner(i));
        assert ut_obj_label(i) < UT_LABEL_COUNT;
        i = i + 1;
    }
    assert ut_obj_name(13).len == 0;
    assert ut_obj_owner(13).len == 0;
}

test the_arrow_table_is_complete {
    assert UT_ARR_COUNT == 11;
    assert UT_ARR_FROM.len == 11;
    assert UT_ARR_TO.len == 11;
    assert UT_ARR_SPEC.len == 11;
    assert UT_ARR_LABEL.len == 11;
    assert UT_ARR_PR.len == 11;
    assert UT_ARR_GAP.len == 11;
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        assert ut_arr_from(a) < 13;
        assert ut_arr_to(a) < 13;
        assert ut_arr_from(a) != ut_arr_to(a);
        assert pvp_is_spec_path(ut_arr_spec(a));
        assert ut_arr_label(a) < UT_LABEL_COUNT;
        a = a + 1;
    }
    assert ut_arr_spec(11).len == 0;
    assert ut_arr_from(11) == 255;
}

test objects_0_to_9_are_shared_and_the_three_targets_are_per_target {
    var i : u32 = 0;
    while (i < UT_OBJ_COUNT) {
        if (i <= 9) { assert ut_obj_scope(i) == UT_SHARED; }
        if (i > 9) { assert ut_obj_scope(i) == UT_PER_TARGET; }
        i = i + 1;
    }
    assert UT_TARGET_COUNT == 3;
    assert UT_TARGET_OBJ.len == 3;
    assert UT_TARGET_DEVICE.len == 3;
}

test every_target_reads_only_the_display_list {
    var t : u32 = 0;
    while (t < UT_TARGET_COUNT) {
        assert ut_target_reads_only_the_list(UT_TARGET_OBJ[t]);
        assert ut_arrows_from(UT_TARGET_OBJ[t]) == 0;
        assert UT_TARGET_DEVICE[t].len >= 20;
        t = t + 1;
    }
    // a shared object is never fed only by the list: the list is the one fan-out point
    assert ut_target_reads_only_the_list(OBJ_LAYOUT) == false;
    assert ut_arrows_from(OBJ_DISPLAY_LIST) == 3;
}

test the_menu_reaches_the_display_list_through_graph_and_layout {
    assert ut_arr_from(0) == OBJ_MENU;
    assert ut_arr_to(0) == OBJ_GRAPH;
    assert ut_arr_from(2) == OBJ_GRAPH;
    assert ut_arr_to(2) == OBJ_LAYOUT;
    assert ut_arr_from(6) == OBJ_LAYOUT;
    assert ut_arr_to(6) == OBJ_DISPLAY_LIST;
    // label, layout and style each feed the one list
    assert ut_arrows_into(OBJ_DISPLAY_LIST) == 3;
    assert ut_arrows_into(OBJ_MENU) == 0;
    // the petal is part of the menu, not a node of its own in the flow
    assert ut_arrows_into(OBJ_PETAL) == 0;
    assert ut_arrows_from(OBJ_PETAL) == 0;
}

test an_exact_row_has_no_gap_and_any_other_row_names_it {
    var i : u32 = 0;
    while (i < UT_OBJ_COUNT) {
        if (ut_obj_label(i) == UT_EXACT) { assert ut_obj_gap(i).len == 0; }
        if (ut_obj_label(i) != UT_EXACT) { assert ut_obj_gap(i).len >= 20; }
        i = i + 1;
    }
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (ut_arr_label(a) == UT_EXACT) { assert ut_arr_gap(a).len == 0; }
        if (ut_arr_label(a) != UT_EXACT) { assert ut_arr_gap(a).len >= 20; }
        a = a + 1;
    }
}

test a_row_held_by_an_open_pr_is_never_exact {
    var i : u32 = 0;
    while (i < UT_OBJ_COUNT) {
        if (ut_obj_pr(i) != UT_PR_NONE) { assert ut_obj_label(i) != UT_EXACT; }
        i = i + 1;
    }
    var a : u32 = 0;
    while (a < UT_ARR_COUNT) {
        if (ut_arr_pr(a) != UT_PR_NONE) { assert ut_arr_label(a) != UT_EXACT; }
        a = a + 1;
    }
    // the style object is the missing heart of the plan, and PR 13254 holds it
    assert ut_obj_label(OBJ_STYLE) == UT_MISSING;
    assert ut_obj_pr(OBJ_STYLE) == UT_PR_OUTFIT_TYPE;
}

test the_label_counts_are_pinned {
    assert ut_obj_count(UT_EXACT) == 5;
    assert ut_obj_count(UT_DERIVED) == 6;
    assert ut_obj_count(UT_MISSING) == 2;
    assert ut_obj_count(UT_EXACT) + ut_obj_count(UT_DERIVED) + ut_obj_count(UT_MISSING) == UT_OBJ_COUNT;
    assert ut_arr_count(UT_EXACT) == 0;
    assert ut_arr_count(UT_DERIVED) == 2;
    assert ut_arr_count(UT_MISSING) == 9;
    assert ut_arr_count(UT_EXACT) + ut_arr_count(UT_DERIVED) + ut_arr_count(UT_MISSING) == UT_ARR_COUNT;
}

test the_order_is_desktop_browser_fpga_then_the_ui_kit {
    assert UT_STEP_COUNT == 4;
    assert UT_STEP_TARGET.len == 4;
    assert UT_STEP_WHAT.len == 4;
    assert UT_STEP_REASON.len == 4;
    assert UT_STEP_PR.len == 4;
    assert UT_STEP_TARGET[0] == OBJ_DESKTOP;
    assert UT_STEP_TARGET[1] == OBJ_BROWSER;
    assert UT_STEP_TARGET[2] == OBJ_FPGA;
    assert UT_STEP_TARGET[3] == UT_ALL_TARGETS;
    // the first step waits on no open PR, so it may start now
    assert UT_STEP_PR[0] == UT_PR_NONE;
    assert ut_arr_pr(9) == UT_PR_NONE;
    assert ut_arr_to(9) == OBJ_DESKTOP;
    var s : u32 = 0;
    while (s < UT_STEP_COUNT) {
        assert UT_STEP_WHAT[s].len >= 20;
        assert UT_STEP_REASON[s].len >= 20;
        s = s + 1;
    }
}

test the_style_law_reads_from_petal_menu {
    assert UT_BG_RGB == 0;
    assert UT_FG_RGB == RGB_WHITE;
    assert UT_FONT.len == 6;
    assert PETAL_LETTERS.len == 54;
    assert UT_LETTERS_LEN == 54;
    assert PETAL_COUNT == 27;
    // A, Z and the T of Ti, the same bytes on every target
    assert petal_letter_byte(0) == 65;
    assert petal_letter_byte(25) == 90;
    assert petal_letter_byte(26) == 84;
    // a white frost is drawn opaque, so it reads white, not grey
    assert UT_FROST_WHITE_ALPHA == HOVER_ALPHA;
    assert UT_FROST_MIN_CONTRAST_MILLI <= UT_WHITE_ON_BLACK_MILLI;
    assert UT_FROST_MIN_CONTRAST_MILLI == 7600;
}

test the_budgets_record_the_gaps {
    // the menu fits one display list frame only with packed quad and glyph ops
    assert UT_MENU_OPS == 4 * PETAL_COUNT + 3 + 1;
    assert UT_MENU_OPS <= MAX_OPS_PER_FRAME;
    // with today's one-int-per-op encoding it does not
    assert UT_MIN_OPS_PER_PETAL_TODAY * PETAL_COUNT > MAX_OPS_PER_FRAME;
    // the menu does not fit a VfGraph today (arrow A0), but would fit a scene
    assert UT_MENU_NODES == PETAL_COUNT + 2;
    assert UT_MENU_NODES > VF_MAX_NODES;
    assert UT_MENU_NODES <= MAX_NODES;
    assert ut_arr_label(0) == UT_MISSING;
}

test the_plan_is_tracked_under_its_issue_and_epics {
    assert UT_ISSUE == 13294;
    assert UT_EPIC == 11037;
    assert UT_MENU_EPIC == 10782;
}

invariant every_label_is_one_of_three {
    assert UT_EXACT < UT_LABEL_COUNT;
    assert UT_DERIVED < UT_LABEL_COUNT;
    assert UT_MISSING < UT_LABEL_COUNT;
    assert UT_LABEL_COUNT == 3;
}
