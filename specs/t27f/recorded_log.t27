// specs/t27f/recorded_log.t27 -- THE RECORDED LOG as law. The /t27f/live/ page replays
// logs/recorded_log.json (format t27f-live-recorded-log-v1); this card is where those 24
// events come from: KIND[0..23] of the work-graph fixture, named through KIND_NAMES, ticks
// on the law's own grid. Nothing about the day is written twice: the fixture is the only
// data source, the names are actor_events', and the emitter under gen-js is a translation.
// Refs Trinity-S-AI-DNA/trinity#1717, the queen-feed seed (specs/crons/t27os-queen-feed.t27).

module recorded_log;

use t27f::work_graph_fixture::REPLAY_KIND_REF;
use queen::actor_events::KIND_NAMES;

pub const FORMAT : str = "t27f-live-recorded-log-v1";
pub const EVENT_COUNT : u32 = 24;

/// seq[i] = i+1 and tick[i] = i: the log's own grid, one tick per recorded event.
pub fn event_seq(i : u32) -> u32 { return i + 1; }
pub fn event_tick(_i : u32) -> u32 { return _i; }

/// The kind NAME of event i: the fixture's kind number read through the vocabulary.
pub fn event_kind(i : u32) -> u8 {
    return REPLAY_KIND_REF[i];
}

test the_log_holds_24_events_on_the_fixture {
    assert EVENT_COUNT == 24;
    var i : u32 = 0;
    while (i < EVENT_COUNT) {
        assert REPLAY_KIND_REF[i] <= 5;
        assert event_seq(i) == i + 1;
        assert event_tick(i) == i;
        i = i + 1;
    }
}

test the_first_events_are_the_seven_spawns {
    var i : u32 = 0;
    while (i < 7) {
        assert event_kind(i) == 0;
        i = i + 1;
    }
    assert event_kind(11) == 3;
    assert event_kind(12) == 1;
    assert event_kind(13) == 4;
}
