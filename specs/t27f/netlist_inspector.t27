// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_inspector.t27 -- Inspector data for a selected NETLIST node.
; Ring 2, Wave F1 of epic #13650.
; NiData carries what the Inspector panel shows for a single selected node:
;   node_idx, kind_name, node_name, netlist_path, source_line, label_text, has_refusal.
; ni_inspect(g, idx) fills NiData from a NetlistGraph; ni_empty() covers no-selection.
; Inference label is exposed as a human-readable string, not only as a color.
; Does not define any RGBA literal.  Graph IR not changed.
; Depends on lane/netlist-view-13716 (netlist_graph, netlist_tokens).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_inspector;

use t27f::netlist_graph::{NetlistGraph, NG_MAX_NODES, NG_NODE_BLOCK, NG_NODE_INSTANCE, NG_NODE_NET, NG_NODE_PIN, NG_NODE_DEVICE, NG_NODE_REFUSAL, NG_LABEL_EXACT, NG_LABEL_DERIVED, NG_LABEL_SUGGESTED, NG_LABEL_UNKNOWN, inverter_graph};
use t27f::netlist_tokens::{NT_BLOCK, NT_INSTANCE, NT_NET, NT_PIN, NT_DEVICE, NT_REFUSAL};

; ── NiData struct ─────────────────────────────────────────────────────────────
; All fields are populated by ni_inspect; zero/empty when ni_empty() or out of range.
pub struct NiData {
    node_idx     : u32,
    kind_name    : str,
    node_name    : str,
    netlist_path : str,
    source_line  : u32,
    label_text   : str,
    has_refusal  : bool,
}

; ── String helpers ────────────────────────────────────────────────────────────
pub fn ni_kind_name(kind: u8) -> str {
    if (kind == NG_NODE_BLOCK)    { return "BLOCK"; }
    if (kind == NG_NODE_INSTANCE) { return "INSTANCE"; }
    if (kind == NG_NODE_NET)      { return "NET"; }
    if (kind == NG_NODE_PIN)      { return "PIN"; }
    if (kind == NG_NODE_DEVICE)   { return "DEVICE"; }
    if (kind == NG_NODE_REFUSAL)  { return "REFUSAL"; }
    return "";
}

pub fn ni_label_text(label: u8) -> str {
    if (label == NG_LABEL_EXACT)     { return "EXACT"; }
    if (label == NG_LABEL_DERIVED)   { return "DERIVED"; }
    if (label == NG_LABEL_SUGGESTED) { return "SUGGESTED"; }
    if (label == NG_LABEL_UNKNOWN)   { return "UNKNOWN"; }
    return "";
}

; ── Empty inspector (no selection) ───────────────────────────────────────────
pub fn ni_empty() -> NiData {
    var d : NiData;
    d.node_idx     = NG_MAX_NODES;
    d.kind_name    = "";
    d.node_name    = "";
    d.netlist_path = "";
    d.source_line  = 0;
    d.label_text   = "";
    d.has_refusal  = false;
    return d;
}

pub fn ni_is_empty(d: NiData) -> bool {
    return d.node_idx >= NG_MAX_NODES;
}

; ── Inspector fill ────────────────────────────────────────────────────────────
pub fn ni_inspect(g: NetlistGraph, idx: u32) -> NiData {
    if (idx >= g.node_count) { return ni_empty(); }
    var d : NiData;
    let ki : usize = idx as usize;
    d.node_idx     = idx;
    d.kind_name    = ni_kind_name(g.node_kind[ki]);
    d.node_name    = g.node_name[ki];
    d.netlist_path = g.netlist_path;
    d.source_line  = g.node_line[ki];
    d.label_text   = ni_label_text(g.node_label[ki]);
    d.has_refusal  = (g.node_kind[ki] == NG_NODE_REFUSAL);
    return d;
}

; ── Tests ─────────────────────────────────────────────────────────────────────

test empty_inspector_is_empty {
    let d : NiData = ni_empty();
    assert ni_is_empty(d);
    assert d.kind_name == "";
    assert d.label_text == "";
    assert d.source_line == 0;
}

test inspect_block_node_zero {
    let g : NetlistGraph = inverter_graph();
    let d : NiData = ni_inspect(g, 0);
    assert d.node_idx == 0;
    assert d.kind_name == "BLOCK";
    assert d.node_name == "inv";
    assert d.source_line == 1;
    assert d.label_text == "EXACT";
    assert d.has_refusal == false;
    assert d.netlist_path == "test/fixtures/inverter.sp";
}

test inspect_pin_node_one {
    let g : NetlistGraph = inverter_graph();
    let d : NiData = ni_inspect(g, 1);
    assert d.node_idx == 1;
    assert d.kind_name == "PIN";
    assert d.node_name == "in";
    assert d.source_line == 2;
    assert d.label_text == "EXACT";
}

test two_different_nodes_give_different_ids {
    let g : NetlistGraph = inverter_graph();
    let d0 : NiData = ni_inspect(g, 0);
    let d1 : NiData = ni_inspect(g, 1);
    assert d0.node_idx != d1.node_idx;
    assert d0.kind_name != d1.kind_name;
}

test inspect_device_node {
    let g : NetlistGraph = inverter_graph();
    let d : NiData = ni_inspect(g, 3);
    assert d.kind_name == "DEVICE";
    assert d.node_name == "mn";
}

test out_of_range_gives_empty {
    let g : NetlistGraph = inverter_graph();
    let d : NiData = ni_inspect(g, g.node_count);
    assert ni_is_empty(d);
}

test refusal_node_has_refusal_flag {
    let g : NetlistGraph = inverter_graph();
    var h : NetlistGraph = g;
    h.node_kind[0] = NG_NODE_REFUSAL;
    let d : NiData = ni_inspect(h, 0);
    assert d.has_refusal == true;
    assert d.kind_name == "REFUSAL";
}

test all_kind_names_non_empty {
    assert ni_kind_name(NG_NODE_BLOCK)    == "BLOCK";
    assert ni_kind_name(NG_NODE_INSTANCE) == "INSTANCE";
    assert ni_kind_name(NG_NODE_NET)      == "NET";
    assert ni_kind_name(NG_NODE_PIN)      == "PIN";
    assert ni_kind_name(NG_NODE_DEVICE)   == "DEVICE";
    assert ni_kind_name(NG_NODE_REFUSAL)  == "REFUSAL";
}

test all_label_texts_non_empty {
    assert ni_label_text(NG_LABEL_EXACT)     == "EXACT";
    assert ni_label_text(NG_LABEL_DERIVED)   == "DERIVED";
    assert ni_label_text(NG_LABEL_SUGGESTED) == "SUGGESTED";
    assert ni_label_text(NG_LABEL_UNKNOWN)   == "UNKNOWN";
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant empty_node_idx_is_max_nodes {
    let d : NiData = ni_empty();
    assert d.node_idx == NG_MAX_NODES;
}

invariant block_kind_name_is_block {
    assert ni_kind_name(NG_NODE_BLOCK) == "BLOCK";
}

invariant exact_label_text_is_exact {
    assert ni_label_text(NG_LABEL_EXACT) == "EXACT";
}
