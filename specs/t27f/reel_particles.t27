// SPDX-License-Identifier: Apache-2.0
// specs/t27f/reel_particles.t27 -- the t27-basics reel drawn by a particle engine: every pixel of
// the picture is a sum this spec computes, and every motion is a step of an integrator.
//
// WHY: the owner, 2026-10-18, on the glass reel: black looks more expensive and glossy, the
// honeycomb looks cheap, and the visual has to come out of a physical particle engine. The hex
// cells of the deck look are gone; the 27 lessons are 27 particles.
//
// THE SCENE, top to bottom:
//   - a near-black field, #0A0A0A, never flat #000 (the research note of 2026-10-18, rule 1);
//   - one warm key light behind the lesson grid, a soft lift of at most KEY_LIFT levels;
//   - 27 lesson particles in a 9 x 3 grid. Status comes from reel_t27_basics.STATUS: a published
//     lesson is a lit gold sphere (core, halo and one specular point), a draft lesson is a thin
//     gold ring. Each lesson is launched from deep in the scene and falls into its cell on a damped
//     3D spring, so the grid assembles itself; its light fades in as it settles (rule 6);
//   - DUST_COUNT dust particles on Kepler orbits around the grid's centre, in a plane tilted by
//     TILT, so they pass in front of and behind it; velocity Verlet keeps their energy;
//     their hues are the event hues of specs/t27f/particle_field.t27 (gold 45, violet 275,
//     green 140, cyan 190), desaturated so gold stays the one accent (rule 2);
//   - a glossy floor at FLOOR_Y: a thin horizon glint, the key light mirrored at FLOOR_KEY, and
//     every particle mirrored below it at REFLECT, fading over REFLECT_FADE pixels (rule 4);
//   - a slow camera push of ZOOM_END over the reel, a vignette, and fine temporal grain (rule 8).
// The rules are in the T27F gen-UI notes folder, premium-dark-visual-rules.md, with sources.
//
// THE NUMERICS: DT = 1/60 s, STEPS_PER_FRAME = 2 at 30 fps, so frame n is state 2n and a replay is
// bit-identical; jitter is a fixed LCG, never a clock. Springs: semi-implicit Euler, symplectic.
// Orbits: velocity Verlet (L. Verlet, Phys. Rev. 159, 98, 1967). Softened gravity (eps = SOFT_PX).
//
// THE OUTPUT: `main` writes FRAMES frames of FRAME_W x FRAME_H raw RGB24 to stderr, row by row
// (std.debug.print is the one byte sink t27c gen passes through). ffmpeg reads them as
// `-f rawvideo -pix_fmt rgb24 -s 1080x1920 -r 30 -i -`; the voice, music and yellow captions are
// added by the recipe of specs/automation/owner_voice_reel.t27 (gHashTag/t27#10279).
//
// NOT CLAIMED: the constants of the field (spring rates, GM, light levels) are design choices,
// labelled as such; none comes from the V = n * 3^k * pi^m * phi^p * e^q lattice. The engine draws
// the course's state; it does not model anything physical about the course.
// phi^2 + 1/phi^2 = 3 | TRINITY

module reel_particles;

use t27f::reel_t27_basics::STATUS;
use t27f::topic_engine::STATUS_PUBLISHED;

pub const ID : str = "reel-particles";
pub const VERSION : u8 = 1;

// ---- frame and clock ----
pub const FRAME_W : i32 = 1080;
pub const FRAME_H : i32 = 1920;
pub const FPS : i32 = 30;
pub const FRAMES : i32 = 450;              // 15.000 s
pub const STEPS_PER_FRAME : i32 = 2;
pub const DT : f64 = 0.016666666666666666;  // 1/60 s

// ---- light and floor (design choices) ----
pub const BASE : f64 = 10.0;               // #0A0A0A
pub const FLOOR_BASE : f64 = 7.0;           // the floor is a shade darker than the wall
pub const KEY_LIFT : f64 = 16.0;
pub const KEY_R : f64 = 640.0;
pub const KEY_R_LUM : f64 = 255.0;
pub const KEY_G_LUM : f64 = 241.0;
pub const KEY_B_LUM : f64 = 220.0;          // warm white, #fff1dc
pub const FLOOR_Y : f64 = 1090.0;            // just under the bottom row, so its mirror reads (rule 4)
pub const FLOOR_KEY : f64 = 0.35;
pub const GLINT : f64 = 10.0;
pub const GLINT_W : f64 = 420.0;
pub const REFLECT : f64 = 0.18;
pub const REFLECT_FADE : f64 = 300.0;
pub const VIGNETTE : f64 = 0.30;
pub const GRAIN : f64 = 3.0;               // levels, peak to peak
pub const ZOOM_END : f64 = 0.05;

// ---- the lesson grid ----
pub const LESSONS : usize = 27;
pub const COLS : usize = 9;
pub const CX : f64 = 540.0;
pub const CY : f64 = 900.0;
pub const PITCH : f64 = 98.0;
pub const LAUNCH0 : i32 = 6;               // first launch frame
pub const LAUNCH_GAP : i32 = 2;            // frames between launches
pub const START_Z : f64 = 3.0;             // launched from 1 / (1 + 3) = a quarter scale
pub const SPRING_K : f64 = 14.2;           // (2 pi 0.6 Hz)^2
pub const DAMP_XY : f64 = 2.64;            // zeta 0.35: one visible overshoot
pub const DAMP_Z : f64 = 5.65;             // zeta 0.75: never reaches the lens
pub const CORE_R : f64 = 7.0;
pub const HALO_R : f64 = 17.0;
pub const HALO_A : f64 = 0.24;
pub const SPEC_R : f64 = 1.9;
pub const SPEC_A : f64 = 0.75;
pub const RING_W : f64 = 1.15;
pub const RING_A : f64 = 0.62;
pub const SETTLE_PX : f64 = 26.0;
pub const LESSON_HUE : f64 = 45.0;
pub const LESSON_SAT : f64 = 0.60;
pub const LESSON_VAL : f64 = 0.89;

// ---- dust ----
pub const DUST_COUNT : usize = 72;
pub const GM : f64 = 6300000.0;            // px^3 / s^2: a 20 s period at r = 400 px
pub const SOFT_PX : f64 = 60.0;
pub const TILT_COS : f64 = 0.34;           // the orbit plane tilted about 70 degrees
pub const TILT_SIN : f64 = 0.94;
pub const DEPTH_PX : f64 = 1400.0;
pub const DUST_R_MIN : f64 = 220.0;
pub const DUST_R_SPAN : f64 = 340.0;
pub const DUST_SAT : f64 = 0.45;
pub const DUST_CORE_R : f64 = 1.7;
pub const DUST_HALO_R : f64 = 6.5;
pub const DUST_A : f64 = 0.55;
pub const DUST_HALO_A : f64 = 0.10;

pub const MAX_SPLATS : usize = 640;
pub const ROW_BYTES : usize = 3240;        // 1080 * 3

// Splat kinds.
pub const K_DISC : u8 = 0;
pub const K_RING : u8 = 1;

// ---- pure pieces, each tested ----

pub fn lcg(seed: i64) -> i64 {
    return @mod(seed * 1103515245 + 12345, 2147483648);
}

pub fn unit(seed: i64) -> f64 {
    return @as(f64, @floatFromInt(seed)) / 2147483648.0;
}

fn dust_hue(i: usize) -> f64 {
    const k = i % 4;
    if (k == 0) { return 45.0; }
    if (k == 1) { return 275.0; }
    if (k == 2) { return 140.0; }
    return 190.0;
}

// HSV to one RGB channel in 0..255; ch 0 red, 1 green, 2 blue.
fn hsv(h: f64, s: f64, v: f64, ch: i32) -> f64 {
    const hp = h / 60.0;
    const c = v * s;
    const m = v - c;
    const r6 = hp - 2.0 * @floor(hp / 2.0);
    const x = c * (1.0 - @abs(r6 - 1.0));
    var r : f64 = 0.0;
    var g : f64 = 0.0;
    var b : f64 = 0.0;
    if (hp < 1.0) { r = c; g = x; }
    else if (hp < 2.0) { r = x; g = c; }
    else if (hp < 3.0) { g = c; b = x; }
    else if (hp < 4.0) { g = x; b = c; }
    else if (hp < 5.0) { r = x; b = c; }
    else { r = c; b = x; }
    if (ch == 0) { return 255.0 * (r + m); }
    if (ch == 1) { return 255.0 * (g + m); }
    return 255.0 * (b + m);
}

// A soft point spread: 1 at the centre, 1/4 at d = r, under 1/289 beyond 4 r.
fn disc(d2: f64, r: f64) -> f64 {
    const q = 1.0 + d2 / (r * r);
    return 1.0 / (q * q);
}

// A thin ring of radius r and width w.
fn ring(d2: f64, r: f64, w: f64) -> f64 {
    const e = (@sqrt(d2) - r) / w;
    const q = 1.0 + e * e;
    return 1.0 / (q * q);
}

fn cutoff(kind: u8, r: f64, w: f64) -> f64 {
    if (kind == K_RING) {
        return r + 8.0 * w;
    }
    return 4.0 * r;
}

// Highlights roll off instead of clipping: the identity up to 200, then toward 255.
fn tone(x: f64) -> f64 {
    if (x <= 200.0) {
        return x;
    }
    const e = x - 200.0;
    return 200.0 + 55.0 * e / (e + 55.0);
}

fn zoom(frame: i32) -> f64 {
    return 1.0 + ZOOM_END * @as(f64, @floatFromInt(frame)) / @as(f64, @floatFromInt(FRAMES));
}

// The light that falls on the wall and the floor, before particles, vignette and grain.
fn backdrop(x: f64, y: f64) -> f64 {
    const dx = x - CX;
    if (y < FLOOR_Y) {
        const dy = y - CY;
        return BASE + KEY_LIFT * disc(dx * dx + dy * dy, KEY_R);
    }
    const my = 2.0 * FLOOR_Y - y;
    const dm = my - CY;
    const g = (y - FLOOR_Y) / 2.5;
    const glint = GLINT / (1.0 + g * g) / (1.0 + (dx / GLINT_W) * (dx / GLINT_W));
    return FLOOR_BASE + FLOOR_KEY * KEY_LIFT * disc(dx * dx + dm * dm, KEY_R) + glint;
}

fn key_tint(ch: i32) -> f64 {
    if (ch == 0) { return KEY_R_LUM / 255.0; }
    if (ch == 1) { return KEY_G_LUM / 255.0; }
    return KEY_B_LUM / 255.0;
}

fn vignette(x: f64, y: f64) -> f64 {
    const dx = (x - 540.0) / 1100.0;
    const dy = (y - 960.0) / 1100.0;
    return 1.0 - VIGNETTE * (dx * dx + dy * dy);
}

fn lesson_lit(i: usize) -> bool {
    return STATUS[i] == STATUS_PUBLISHED;
}

fn lit_count() -> i32 {
    var n : i32 = 0;
    var i : usize = 0;
    while (i < LESSONS) {
        if (lesson_lit(i)) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn reel_ms() -> i32 {
    return FRAMES * 1000 / FPS;
}

fn frame_bytes() -> i32 {
    return FRAME_W * FRAME_H * 3;
}

// Splats a frame can hold: a lit lesson 3, a draft 2, a dust grain 2, and each one reflection.
fn splat_budget() -> i32 {
    const lit = lit_count();
    const drafts = @as(i32, @intCast(LESSONS)) - lit;
    return (lit * 3 + drafts * 2 + @as(i32, @intCast(DUST_COUNT)) * 2) * 2;
}

fn anchor_x(i: usize) -> f64 {
    const c = @as(f64, @floatFromInt(i % COLS));
    return CX + (c - 4.0) * PITCH;
}

fn anchor_y(i: usize) -> f64 {
    const r = @as(f64, @floatFromInt(i / COLS));
    return CY + (r - 1.0) * PITCH;
}

fn launch_frame(i: usize) -> i32 {
    const c = @as(i32, @intCast(i % COLS));
    const r = @as(i32, @intCast(i / COLS));
    return LAUNCH0 + (c * 3 + r) * LAUNCH_GAP;
}

// Offset of a damped spring after `steps` semi-implicit Euler steps from rest at x0.
fn spring_after(steps: i32, x0: f64, k: f64, c: f64) -> f64 {
    var x : f64 = x0;
    var v : f64 = 0.0;
    var n : i32 = 0;
    while (n < steps) {
        v = v + (0.0 - k * x - c * v) * DT;
        x = x + v * DT;
        n = n + 1;
    }
    return x;
}

// Most negative z the depth spring reaches from START_Z: the lens is at z = -1.
fn spring_min_z() -> f64 {
    var x : f64 = START_Z;
    var v : f64 = 0.0;
    var lo : f64 = START_Z;
    var n : i32 = 0;
    while (n < 900) {
        v = v + (0.0 - SPRING_K * x - DAMP_Z * v) * DT;
        x = x + v * DT;
        if (x < lo) {
            lo = x;
        }
        n = n + 1;
    }
    return lo;
}

fn grav(p: f64, r2: f64) -> f64 {
    const s = r2 + SOFT_PX * SOFT_PX;
    return 0.0 - GM * p / (s * @sqrt(s));
}

fn orbit_energy(u: f64, v: f64, vu: f64, vv: f64) -> f64 {
    return 0.5 * (vu * vu + vv * vv) - GM / @sqrt(u * u + v * v + SOFT_PX * SOFT_PX);
}

// Relative energy drift of a circular orbit of radius r after `steps` Verlet steps.
fn orbit_drift(r: f64, steps: i32) -> f64 {
    var u : f64 = r;
    var v : f64 = 0.0;
    const s = r * r + SOFT_PX * SOFT_PX;
    var vu : f64 = 0.0;
    var vv : f64 = r * @sqrt(GM / (s * @sqrt(s)));
    const e0 = orbit_energy(u, v, vu, vv);
    var au : f64 = grav(u, u * u);
    var av : f64 = 0.0;
    var worst : f64 = 0.0;
    var n : i32 = 0;
    while (n < steps) {
        u = u + vu * DT + 0.5 * au * DT * DT;
        v = v + vv * DT + 0.5 * av * DT * DT;
        const r2 = u * u + v * v;
        const nu = grav(u, r2);
        const nv = grav(v, r2);
        vu = vu + 0.5 * (au + nu) * DT;
        vv = vv + 0.5 * (av + nv) * DT;
        au = nu;
        av = nv;
        const d = @abs((orbit_energy(u, v, vu, vv) - e0) / e0);
        if (d > worst) {
            worst = d;
        }
        n = n + 1;
    }
    return worst;
}

fn dust_period(r: f64) -> f64 {
    return 2.0 * 3.141592653589793 * @sqrt(r * r * r / GM);
}

fn grain_level(seed: i64) -> f64 {
    return GRAIN * (unit(seed) - 0.5);
}

pub fn quantize(x: f64) -> u8 {
    var y : f64 = @round(x);
    if (y < 0.0) { y = 0.0; }
    if (y > 255.0) { y = 255.0; }
    return @as(u8, @intFromFloat(y));
}

// ---- the engine ----

pub fn main() -> void {
    // lesson state
    var lx : [27]f64 = undefined;
    var ly : [27]f64 = undefined;
    var lz : [27]f64 = undefined;
    var lvx : [27]f64 = undefined;
    var lvy : [27]f64 = undefined;
    var lvz : [27]f64 = undefined;
    // dust state, in the orbit plane
    var du : [72]f64 = undefined;
    var dv : [72]f64 = undefined;
    var dvu : [72]f64 = undefined;
    var dvv : [72]f64 = undefined;
    var dau : [72]f64 = undefined;
    var dav : [72]f64 = undefined;
    // this frame's splats
    var sx : [640]f64 = undefined;
    var sy : [640]f64 = undefined;
    var sr : [640]f64 = undefined;
    var sw : [640]f64 = undefined;
    var sa : [640]f64 = undefined;
    var sc : [640]f64 = undefined;
    var sk : [640]u8 = undefined;
    var scr : [640]f64 = undefined;
    var scg : [640]f64 = undefined;
    var scb : [640]f64 = undefined;
    var accr : [1080]f64 = undefined;
    var accg : [1080]f64 = undefined;
    var accb : [1080]f64 = undefined;
    var row : [3240]u8 = undefined;

    var seed : i64 = 27;
    var i : usize = 0;
    while (i < LESSONS) {
        seed = lcg(seed);
        lx[i] = anchor_x(i) + (unit(seed) - 0.5) * 900.0;
        seed = lcg(seed);
        ly[i] = anchor_y(i) + (unit(seed) - 0.5) * 1100.0;
        lz[i] = START_Z;
        lvx[i] = 0.0;
        lvy[i] = 0.0;
        lvz[i] = 0.0;
        i = i + 1;
    }
    i = 0;
    while (i < DUST_COUNT) {
        seed = lcg(seed);
        const rr = DUST_R_MIN + DUST_R_SPAN * unit(seed);
        seed = lcg(seed);
        const ph = 6.283185307179586 * unit(seed);
        seed = lcg(seed);
        const fac = 0.92 + 0.12 * unit(seed);
        du[i] = rr * @cos(ph);
        dv[i] = rr * @sin(ph);
        const s = rr * rr + SOFT_PX * SOFT_PX;
        const vc = rr * @sqrt(GM / (s * @sqrt(s))) * fac;
        dvu[i] = 0.0 - vc * @sin(ph);
        dvv[i] = vc * @cos(ph);
        const r2 = du[i] * du[i] + dv[i] * dv[i];
        dau[i] = grav(du[i], r2);
        dav[i] = grav(dv[i], r2);
        i = i + 1;
    }

    var frame : i32 = 0;
    while (frame < FRAMES) {
        // ---- physics: two steps per frame ----
        var st : i32 = 0;
        while (st < STEPS_PER_FRAME) {
            i = 0;
            while (i < LESSONS) {
                if (frame >= launch_frame(i)) {
                    lvx[i] = lvx[i] + (0.0 - SPRING_K * (lx[i] - anchor_x(i)) - DAMP_XY * lvx[i]) * DT;
                    lvy[i] = lvy[i] + (0.0 - SPRING_K * (ly[i] - anchor_y(i)) - DAMP_XY * lvy[i]) * DT;
                    lvz[i] = lvz[i] + (0.0 - SPRING_K * lz[i] - DAMP_Z * lvz[i]) * DT;
                    lx[i] = lx[i] + lvx[i] * DT;
                    ly[i] = ly[i] + lvy[i] * DT;
                    lz[i] = lz[i] + lvz[i] * DT;
                }
                i = i + 1;
            }
            i = 0;
            while (i < DUST_COUNT) {
                du[i] = du[i] + dvu[i] * DT + 0.5 * dau[i] * DT * DT;
                dv[i] = dv[i] + dvv[i] * DT + 0.5 * dav[i] * DT * DT;
                const r2 = du[i] * du[i] + dv[i] * dv[i];
                const nu = grav(du[i], r2);
                const nv = grav(dv[i], r2);
                dvu[i] = dvu[i] + 0.5 * (dau[i] + nu) * DT;
                dvv[i] = dvv[i] + 0.5 * (dav[i] + nv) * DT;
                dau[i] = nu;
                dav[i] = nv;
                i = i + 1;
            }
            st = st + 1;
        }

        // ---- splats: the scene as a list of soft discs and rings ----
        const zm = zoom(frame);
        var n : usize = 0;
        i = 0;
        while (i < LESSONS) {
            const p = 1.0 / (1.0 + lz[i]);
            const x = CX + (CX + (lx[i] - CX) * p - CX) * zm;
            const y = CY + (CY + (ly[i] - CY) * p - CY) * zm;
            const ex = lx[i] - anchor_x(i);
            const ey = ly[i] - anchor_y(i);
            const settle = 1.0 / (1.0 + (ex * ex + ey * ey + 40000.0 * lz[i] * lz[i]) / (SETTLE_PX * SETTLE_PX));
            var live : f64 = 0.0;
            if (frame >= launch_frame(i)) {
                live = 1.0;
            }
            const a = (0.18 + 0.82 * settle) * (0.25 + 0.75 * live);
            const s = p * zm;
            const gr = hsv(LESSON_HUE, LESSON_SAT, LESSON_VAL, 0);
            const gg = hsv(LESSON_HUE, LESSON_SAT, LESSON_VAL, 1);
            const gb = hsv(LESSON_HUE, LESSON_SAT, LESSON_VAL, 2);
            if (lesson_lit(i)) {
                sx[n] = x; sy[n] = y; sr[n] = HALO_R * s; sw[n] = 0.0; sa[n] = HALO_A * a; sk[n] = K_DISC;
                scr[n] = gr; scg[n] = gg; scb[n] = gb; n = n + 1;
                sx[n] = x; sy[n] = y; sr[n] = CORE_R * s; sw[n] = 0.0; sa[n] = a; sk[n] = K_DISC;
                scr[n] = gr; scg[n] = gg; scb[n] = gb; n = n + 1;
                sx[n] = x - 0.32 * CORE_R * s; sy[n] = y - 0.38 * CORE_R * s; sr[n] = SPEC_R * s; sw[n] = 0.0;
                sa[n] = SPEC_A * a; sk[n] = K_DISC; scr[n] = 255.0; scg[n] = 250.0; scb[n] = 240.0; n = n + 1;
            } else {
                sx[n] = x; sy[n] = y; sr[n] = HALO_R * s; sw[n] = 0.0; sa[n] = 0.07 * a; sk[n] = K_DISC;
                scr[n] = gr; scg[n] = gg; scb[n] = gb; n = n + 1;
                sx[n] = x; sy[n] = y; sr[n] = CORE_R * s; sw[n] = RING_W * s; sa[n] = RING_A * a; sk[n] = K_RING;
                scr[n] = gr; scg[n] = gg; scb[n] = gb; n = n + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < DUST_COUNT) {
            const z = dv[i] * TILT_SIN / DEPTH_PX;
            const p = 1.0 / (1.0 + z);
            const x = CX + du[i] * p * zm;
            const y = CY + dv[i] * TILT_COS * p * zm;
            const s = p * zm;
            const depth = 0.55 + 0.45 * (1.0 - z) / 1.4;
            const h = dust_hue(i);
            const cr = hsv(h, DUST_SAT, 0.95, 0);
            const cg = hsv(h, DUST_SAT, 0.95, 1);
            const cb = hsv(h, DUST_SAT, 0.95, 2);
            sx[n] = x; sy[n] = y; sr[n] = DUST_HALO_R * s; sw[n] = 0.0; sa[n] = DUST_HALO_A * depth; sk[n] = K_DISC;
            scr[n] = cr; scg[n] = cg; scb[n] = cb; n = n + 1;
            sx[n] = x; sy[n] = y; sr[n] = DUST_CORE_R * s; sw[n] = 0.0; sa[n] = DUST_A * depth; sk[n] = K_DISC;
            scr[n] = cr; scg[n] = cg; scb[n] = cb; n = n + 1;
            i = i + 1;
        }
        // reflections in the glossy floor
        const m = n;
        var j : usize = 0;
        while (j < m) {
            if (sy[j] < FLOOR_Y) {
                const ry = 2.0 * FLOOR_Y - sy[j];
                const fade = 1.0 - (ry - FLOOR_Y) / REFLECT_FADE;
                if (fade > 0.0) {
                    sx[n] = sx[j]; sy[n] = ry; sr[n] = sr[j] * 1.35; sw[n] = sw[j] * 1.6;
                    sa[n] = sa[j] * REFLECT * fade; sk[n] = sk[j];
                    scr[n] = scr[j]; scg[n] = scg[j]; scb[n] = scb[j]; n = n + 1;
                }
            }
            j = j + 1;
        }
        j = 0;
        while (j < n) {
            sc[j] = cutoff(sk[j], sr[j], sw[j]);
            j = j + 1;
        }

        // ---- raster: one row at a time ----
        var gseed : i64 = 1000003 + @as(i64, @intCast(frame)) * 7919;
        var py : i32 = 0;
        while (py < FRAME_H) {
            const y = @as(f64, @floatFromInt(py)) + 0.5;
            var px : usize = 0;
            while (px < 1080) {
                const x = @as(f64, @floatFromInt(px)) + 0.5;
                const b = backdrop(x, y);
                accr[px] = b * key_tint(0);
                accg[px] = b * key_tint(1);
                accb[px] = b * key_tint(2);
                px = px + 1;
            }
            j = 0;
            while (j < n) {
                const dy = y - sy[j];
                if (@abs(dy) <= sc[j]) {
                    var x0 : f64 = @floor(sx[j] - sc[j]);
                    var x1 : f64 = @ceil(sx[j] + sc[j]);
                    if (x0 < 0.0) { x0 = 0.0; }
                    if (x1 > 1079.0) { x1 = 1079.0; }
                    var q : i32 = @as(i32, @intFromFloat(x0));
                    const qe = @as(i32, @intFromFloat(x1));
                    while (q <= qe) {
                        const dx = @as(f64, @floatFromInt(q)) + 0.5 - sx[j];
                        const d2 = dx * dx + dy * dy;
                        var w : f64 = 0.0;
                        if (sk[j] == K_RING) {
                            w = ring(d2, sr[j], sw[j]);
                        } else {
                            w = disc(d2, sr[j]);
                        }
                        const k = @as(usize, @intCast(q));
                        accr[k] = accr[k] + w * sa[j] * scr[j];
                        accg[k] = accg[k] + w * sa[j] * scg[j];
                        accb[k] = accb[k] + w * sa[j] * scb[j];
                        q = q + 1;
                    }
                }
                j = j + 1;
            }
            px = 0;
            while (px < 1080) {
                const x = @as(f64, @floatFromInt(px)) + 0.5;
                const vg = vignette(x, y);
                gseed = lcg(gseed);
                const gn = grain_level(gseed);
                row[px * 3] = quantize(tone(accr[px] * vg) + gn);
                row[px * 3 + 1] = quantize(tone(accg[px] * vg) + gn);
                row[px * 3 + 2] = quantize(tone(accb[px] * vg) + gn);
                px = px + 1;
            }
            std.debug.print("{s}", .{row});
            py = py + 1;
        }
        frame = frame + 1;
    }
}

// ---- tests ----

test "the reel is 15.000 s of 1080x1920 at 30 fps, 6220800 bytes a frame" {
    assert(reel_ms() == 15000);
    assert(frame_bytes() == 6220800);
}

test "18 of the 27 lessons are published, as reel_t27_basics says" {
    assert(lit_count() == 18);
    assert(lesson_lit(0));
    assert(!lesson_lit(6));
}

test "the splat budget holds every particle and its reflection" {
    assert(splat_budget() <= 640);
    assert(splat_budget() == 432);
}

test "the field is near-black: #0A0A0A on the wall, the key light lifts it at most 16 levels" {
    // the key light still reaches the corner, by about one level
    assert(backdrop(0.5, 0.5) < 11.5);
    assert(backdrop(0.5, 0.5) >= 10.0);
    assert(backdrop(540.0, 900.0) <= BASE + KEY_LIFT);
    assert(backdrop(540.0, 900.0) > 25.0);
    // the floor's own mirror of the key light, a shade under the wall's peak
    assert(backdrop(540.0, 1900.0) < 11.5);
    assert(backdrop(540.0, 1900.0) < backdrop(540.0, 900.0));
}

test "the floor has a glint on its horizon and nowhere far from it" {
    assert(backdrop(540.0, FLOOR_Y + 0.5) > backdrop(540.0, FLOOR_Y + 40.0) + 8.0);
}

test "hues are the particle_field event hues: gold, violet, green, cyan" {
    assert(dust_hue(0) == 45.0);
    assert(dust_hue(1) == 275.0);
    assert(dust_hue(2) == 140.0);
    assert(dust_hue(3) == 190.0);
    assert(dust_hue(4) == 45.0);
}

test "gold is red over green over blue; violet is blue over red over green" {
    assert(hsv(45.0, 0.6, 0.89, 0) > hsv(45.0, 0.6, 0.89, 1));
    assert(hsv(45.0, 0.6, 0.89, 1) > hsv(45.0, 0.6, 0.89, 2));
    assert(@abs(hsv(45.0, 0.6, 0.89, 0) - 226.95) < 0.01);
    assert(hsv(275.0, 0.45, 0.95, 2) > hsv(275.0, 0.45, 0.95, 0));
    assert(hsv(275.0, 0.45, 0.95, 0) > hsv(275.0, 0.45, 0.95, 1));
}

test "a disc is 1 at its centre, 1/4 at its radius, gone beyond its cutoff" {
    assert(disc(0.0, 7.0) == 1.0);
    assert(@abs(disc(49.0, 7.0) - 0.25) < 1e-12);
    assert(disc(28.0 * 28.0, 7.0) < 0.0035);
    assert(ring(49.0, 7.0, 1.0) == 1.0);
    assert(ring(81.0 * 1.0, 7.0, 1.0) < 0.05);
}

test "highlights roll off and never pass 255" {
    assert(tone(100.0) == 100.0);
    assert(tone(255.0) < 255.0);
    assert(tone(100000.0) < 255.0);
    assert(tone(300.0) > tone(250.0));
}

test "a lesson spring settles inside a pixel within 6 s" {
    assert(@abs(spring_after(360, 450.0, SPRING_K, DAMP_XY)) < 1.0);
    // and overshoots once on the way, so the grid visibly lands
    assert(spring_after(50, 450.0, SPRING_K, DAMP_XY) < 0.0);
}

test "the depth spring never reaches the lens" {
    assert(spring_min_z() > 0.0 - 0.5);
}

test "Verlet holds a dust orbit's energy over the whole reel" {
    assert(orbit_drift(400.0, 900) < 1e-3);
}

test "a dust orbit at 400 px takes about 20 s" {
    assert(@abs(dust_period(400.0) - 20.0) < 0.1);
}

test "grain stays within its 3 levels; the LCG replays bit for bit" {
    assert(@abs(grain_level(lcg(5))) <= 1.5);
    assert(lcg(27) == lcg(27));
    assert(lcg(27) != lcg(28));
}

test "the camera push ends 5% in" {
    assert(zoom(0) == 1.0);
    assert(@abs(zoom(FRAMES) - 1.05) < 1e-12);
}

test "the vignette darkens the corners by at most a third" {
    assert(vignette(540.0, 960.0) == 1.0);
    assert(vignette(0.0, 0.0) > 0.66);
}

test "lessons launch in column order inside the first two seconds" {
    assert(launch_frame(0) == LAUNCH0);
    assert(launch_frame(26) < 60);
}

test "a replay is bit-identical: same seed, same steps, same state" {
    assert(spring_after(137, 450.0, SPRING_K, DAMP_XY) == spring_after(137, 450.0, SPRING_K, DAMP_XY));
    assert(orbit_drift(300.0, 200) == orbit_drift(300.0, 200));
}
