// SPDX-License-Identifier: Apache-2.0
// specs/t27f/export_video.t27 -- T27F Live M6: export the display list to MP4.
// Issue gHashTag/t27#10265 (epic #10266). Design:
// docs/nona-02-organism/t27f/genui-research.md section 5.3.
//
// WHY: the posted clip and the live page must be the same frames. The exporter
// consumes the same display list the browser paints, renders frame by frame to
// images, and encodes an MP4 with ffmpeg as plumbing. The spec fixes frame
// rate, size presets and the per-frame hash record so the export is reproducible.
//
// HOW: frame rate, size presets and hash record are constants here. The
// encoder runs on T27 OS core (not a remote lab), using the T27 OS process
// primitives. ffmpeg is plumbing, not logic.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module export_video;

// --- frame rate ----------------------------------------------------------

pub const EXPORT_FPS : u32 = 30;

// --- size presets --------------------------------------------------------

pub const SIZE_LANDSCAPE_W : u32 = 1920;
pub const SIZE_LANDSCAPE_H : u32 = 1080;
pub const SIZE_PORTRAIT_W : u32 = 1080;
pub const SIZE_PORTRAIT_H : u32 = 1920;

pub const SIZE_PRESETS : u8 = 2;

// --- per-frame hash record ----------------------------------------------

// A frame record: frame number + op-stream hash.
pub struct FrameRecord {
    frame: u64,
    hash: u64,
}

// --- pure functions ------------------------------------------------------

// frames_for_duration(seconds): how many frames a clip of `seconds` seconds
// produces at EXPORT_FPS.
pub fn frames_for_duration(seconds: u32) -> u32 {
    return seconds * EXPORT_FPS;
}

// is_landscape(w, h): true when width > height.
pub fn is_landscape(w: u32, h: u32) -> bool {
    return w > h;
}

// --- tests --------------------------------------------------------------

test frames_for_30s_is_900 {
    assert frames_for_duration(30) == 900;
    assert frames_for_duration(1) == 30;
    assert frames_for_duration(0) == 0;
}

test landscape_preset_is_landscape {
    assert is_landscape(SIZE_LANDSCAPE_W, SIZE_LANDSCAPE_H) == true;
    assert is_landscape(SIZE_PORTRAIT_W, SIZE_PORTRAIT_H) == false;
}

pub fn export_fps() -> u32 {
    return EXPORT_FPS;
}

pub fn size_presets() -> u8 {
    return SIZE_PRESETS;
}

test fps_is_30 {
    assert export_fps() == 30;
}

test presets_are_two {
    assert size_presets() == 2;
}
