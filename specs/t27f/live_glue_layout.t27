// SPDX-License-Identifier: Apache-2.0
// specs/t27f/live_glue_layout.t27 -- the LAYOUT PLANE of the struct-path export glue: the 23
// CONSTANT exports of live_struct_glue's 33-name surface, the subset the wasm32 emitter's M-A
// cut (a pub fn with no parameters whose body is a single `return <const>;`, gHashTag/t27#11840
// M-B, PR #11983) can lower today, written as transcription -- every fn returns the contract
// card's own constant, so this plane can never drift from the card. Refs gHashTag/t27#10262
// (the full HUD replay), gHashTag/t27#11781, the contract card #12005
// (specs/t27f/live_struct_glue.t27); the page and its PROVENANCE are
// Trinity-S-AI-DNA/trinity#1717 and #1731.
//
// WHY A LAYOUT PLANE. The struct path of /t27f/live/ waits on emitter floors the M-B cut does
// not have (memory, locals, calls, u64 carriers, multi-statement bodies), so no gx_ export that
// touches state can emit yet. The ptr/len/cap pairs are different: each answers one constant of
// the card's fixed memory layout, and a constant is exactly what the M-A cut lowers. Emitted as
// a module they are the page's DISCOVERY surface -- the loader reads the layout off the artifact
// instead of hardcoding 23 numbers, so a layout change in the card breaks the module (an old
// page refuses a module whose pairs disagree with what it wrote) instead of silently shifting
// every region. The card itself asks for exactly this kind of version answer
// (live_struct_glue.t27, the gx_layout_version QUESTION); this plane is the const half of it.
//
// THE 23. The card's EXPORT_NAMES table holds 33 names; this card carries the 23 that answer a
// layout constant: 2 record-region pairs (ev, batch), the image pair (graph), the digest pair,
// the stream ptr, and the ten column pairs (node kind/label/id, edge kind/from/to/label). The
// other 10 names -- gx_ev_set_len, gx_batch_set_len (commits), gx_replay, gx_live, gx_reset
// (actions), gx_node_count, gx_edge_count, gx_stream_n, gx_stream_ops, gx_stream_len (state
// getters) -- answer module state, and the M-B cut refuses every shape that could carry state
// (wasm32_emitter.rs lowers `return <const>;`, a + - * / tree over i32 parameters, and the
// select pattern; locals, loops, calls and void fns are refused by name). They land with the
// stateful emitter floors; the precise gap is filed on the self-host epic gHashTag/t27#5980.
//
// NOT CLAIMED: no state, no memory and no action is exported here (23 of 33 names; the page
// cannot replay one event through this module -- the scalar plane stays the live surface until
// the struct floors land); the numbers are the card's own layout for ONE module instance, not a
// negotiated ABI version; no build was run on the owner's Mac as the artifact's build (the
// bytes were emitted locally from this spec and verified against these very constants in a wasm
// runtime; the closure-build law of specs/t27f/build.t27 governs the page artifact's own
// rebuild); no perf claim of any kind. The transcription direction is one-way: this card reads
// live_struct_glue, never the reverse.
// phi^2 + 1/phi^2 = 3 | TRINITY

module live_glue_layout;

use t27f::live_struct_glue;
use t27f::display_list::STREAM_CAP;

/// The record region: one 32-byte Event record, at EV_OFF.
pub fn gx_ev_ptr() -> u32 {
    return live_struct_glue::EV_OFF;
}

pub fn gx_ev_cap() -> u32 {
    return live_struct_glue::EVENT_BYTES;
}

/// The batch region: count column + BATCH_ROWS rows of ROW_BYTES, at BATCH_OFF.
pub fn gx_batch_ptr() -> u32 {
    return live_struct_glue::BATCH_OFF;
}

pub fn gx_batch_cap() -> u32 {
    return live_struct_glue::BATCH_BYTES;
}

/// The image region: work_graph's digest_bytes output verbatim, RECORD-major, at GRAPH_OFF.
pub fn gx_graph_ptr() -> u32 {
    return live_struct_glue::GRAPH_OFF;
}

pub fn gx_graph_len() -> u32 {
    return live_struct_glue::GRAPH_LEN;
}

/// The module graph's 32-byte graph_digest, at DIGEST_OFF. The width is the card's own tiling
/// identity (EV_OFF == DIGEST_OFF + 32), stated as the offsets it derives from -- every body
/// here answers the card's constants, and no two bodies in the corpus are restated literals
/// (the duplicate-bodies gate grows only downward).
pub fn gx_digest_ptr() -> u32 {
    return live_struct_glue::DIGEST_OFF;
}

pub fn gx_digest_len() -> u32 {
    return live_struct_glue::EV_OFF - live_struct_glue::DIGEST_OFF;
}

/// The law's own Stream bytes, STREAM_CAP wide, at STREAM_OFF. (The live LENGTH is module
/// state -- gx_stream_len is one of the 10 that wait for the stateful floors.)
pub fn gx_stream_ptr() -> u32 {
    return live_struct_glue::STREAM_OFF;
}

/// The column region: the WorkGraph declaration's own arrays, one contiguous column per field.
/// Each width is the card's own tiling identity (the next region's offset minus this one's),
/// stated as the offsets it derives from -- the card's invariant pins every one of these
/// identities, so a derived width can never disagree with the layout it answers.
pub fn gx_node_kind_ptr() -> u32 {
    return live_struct_glue::NODE_KIND_OFF;
}

pub fn gx_node_kind_len() -> u32 {
    return live_struct_glue::NODE_LABEL_OFF - live_struct_glue::NODE_KIND_OFF;
}

pub fn gx_node_label_ptr() -> u32 {
    return live_struct_glue::NODE_LABEL_OFF;
}

pub fn gx_node_label_len() -> u32 {
    return live_struct_glue::NODE_ID_OFF - live_struct_glue::NODE_LABEL_OFF;
}

pub fn gx_node_id_ptr() -> u32 {
    return live_struct_glue::NODE_ID_OFF;
}

pub fn gx_node_id_len() -> u32 {
    return live_struct_glue::EDGE_KIND_OFF - live_struct_glue::NODE_ID_OFF;
}

pub fn gx_edge_kind_ptr() -> u32 {
    return live_struct_glue::EDGE_KIND_OFF;
}

pub fn gx_edge_kind_len() -> u32 {
    return live_struct_glue::EDGE_FROM_OFF - live_struct_glue::EDGE_KIND_OFF;
}

pub fn gx_edge_from_ptr() -> u32 {
    return live_struct_glue::EDGE_FROM_OFF;
}

pub fn gx_edge_from_len() -> u32 {
    return live_struct_glue::EDGE_TO_OFF - live_struct_glue::EDGE_FROM_OFF;
}

pub fn gx_edge_to_ptr() -> u32 {
    return live_struct_glue::EDGE_TO_OFF;
}

pub fn gx_edge_to_len() -> u32 {
    return live_struct_glue::EDGE_LABEL_OFF - live_struct_glue::EDGE_TO_OFF;
}

pub fn gx_edge_label_ptr() -> u32 {
    return live_struct_glue::EDGE_LABEL_OFF;
}

pub fn gx_edge_label_len() -> u32 {
    return live_struct_glue::DIGEST_OFF - live_struct_glue::EDGE_LABEL_OFF;
}

// ---- tests ------------------------------------------------------------------------------------------

test transcription_every_pair_answers_the_contract_constant {
    // the record and batch regions
    assert gx_ev_ptr() == live_struct_glue::EV_OFF;
    assert gx_ev_cap() == live_struct_glue::EVENT_BYTES;
    assert gx_batch_ptr() == live_struct_glue::BATCH_OFF;
    assert gx_batch_cap() == live_struct_glue::BATCH_BYTES;
    // the image, the digest and the stream
    assert gx_graph_ptr() == live_struct_glue::GRAPH_OFF;
    assert gx_graph_len() == live_struct_glue::GRAPH_LEN;
    assert gx_digest_ptr() == live_struct_glue::DIGEST_OFF;
    assert gx_digest_len() == 32;
    assert gx_stream_ptr() == live_struct_glue::STREAM_OFF;
    // the ten column pairs, in the card's declaration order
    assert gx_node_kind_ptr() == live_struct_glue::NODE_KIND_OFF;
    assert gx_node_kind_len() == 2048;
    assert gx_node_label_ptr() == live_struct_glue::NODE_LABEL_OFF;
    assert gx_node_label_len() == 2048;
    assert gx_node_id_ptr() == live_struct_glue::NODE_ID_OFF;
    assert gx_node_id_len() == 16384;
    assert gx_edge_kind_ptr() == live_struct_glue::EDGE_KIND_OFF;
    assert gx_edge_kind_len() == 8192;
    assert gx_edge_from_ptr() == live_struct_glue::EDGE_FROM_OFF;
    assert gx_edge_from_len() == 16384;
    assert gx_edge_to_ptr() == live_struct_glue::EDGE_TO_OFF;
    assert gx_edge_to_len() == 16384;
    assert gx_edge_label_ptr() == live_struct_glue::EDGE_LABEL_OFF;
    assert gx_edge_label_len() == 8192;
}

test the_pairs_tile_the_memory_in_the_card_order_with_no_gaps {
    // the card's layout law (the_layout_fits_the_memory_and_walks_the_law_order), walked
    // through THIS plane's own exports: each region's end is the next region's start, so a
    // page that reads the pairs off the module sees the same tiling the card pins.
    assert gx_graph_ptr() == live_struct_glue::GRAPH_OFF;
    assert gx_graph_ptr() + gx_graph_len() == gx_node_kind_ptr();
    assert gx_node_kind_ptr() + gx_node_kind_len() == gx_node_label_ptr();
    assert gx_node_label_ptr() + gx_node_label_len() == gx_node_id_ptr();
    assert gx_node_id_ptr() + gx_node_id_len() == gx_edge_kind_ptr();
    assert gx_edge_kind_ptr() + gx_edge_kind_len() == gx_edge_from_ptr();
    assert gx_edge_from_ptr() + gx_edge_from_len() == gx_edge_to_ptr();
    assert gx_edge_to_ptr() + gx_edge_to_len() == gx_edge_label_ptr();
    assert gx_edge_label_ptr() + gx_edge_label_len() == gx_digest_ptr();
    assert gx_digest_ptr() + gx_digest_len() == gx_ev_ptr();
    assert gx_ev_ptr() + gx_ev_cap() == gx_batch_ptr();
    assert gx_batch_ptr() + gx_batch_cap() == gx_stream_ptr();
    // the memory ends where the card's MEM_CAP says, and every pair fits inside it
    assert gx_stream_ptr() + STREAM_CAP == live_struct_glue::MEM_CAP;
    assert gx_node_kind_ptr() + gx_node_kind_len() <= live_struct_glue::MEM_CAP;
    assert gx_node_label_ptr() + gx_node_label_len() <= live_struct_glue::MEM_CAP;
    assert gx_node_id_ptr() + gx_node_id_len() <= live_struct_glue::MEM_CAP;
    assert gx_edge_kind_ptr() + gx_edge_kind_len() <= live_struct_glue::MEM_CAP;
    assert gx_edge_from_ptr() + gx_edge_from_len() <= live_struct_glue::MEM_CAP;
    assert gx_edge_to_ptr() + gx_edge_to_len() <= live_struct_glue::MEM_CAP;
    assert gx_edge_label_ptr() + gx_edge_label_len() <= live_struct_glue::MEM_CAP;
    assert gx_batch_ptr() + gx_batch_cap() <= live_struct_glue::MEM_CAP;
}

test the_widths_restated_are_the_law_widths {
    // the widths this plane answers are the card's own numbers, which the card's own invariant
    // (the_widths_transcribe_the_law) chains to work_graph and live_mode; quoted here so a
    // drift in ANY of the three layers fails this test in the same breath as the card's.
    // GRAPH_LEN is tied through the card's pub constant, NOT through a second import of
    // work_graph's digest_len: an imported fn lowers to an extra pub export on this module,
    // and every export here must be one of the contract's 33 names.
    assert gx_ev_cap() == 32;
    assert gx_batch_cap() == 4 + live_struct_glue::BATCH_ROWS * (32 + 4);
    assert gx_graph_len() == live_struct_glue::GRAPH_LEN;
    assert gx_node_id_len() == 2048 * 8;
    assert gx_edge_from_len() == 8192 * 2;
}
