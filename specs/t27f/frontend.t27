// SPDX-License-Identifier: Apache-2.0
; specs/t27f/frontend.t27 -- T27F as t27's frontend: the one tool through which t27 shows anything
; visual, and the catalog of the surfaces it draws on. Issue gHashTag/t27#10537.
; Owner, 2026-10-18: T27F is t27's native visualization, made through several tools; everything
; visual is gathered into it as one tool, the t27 frontend; and T27F goes into TRI CLAW.
; The definition lives in .claude/skills/t27f/SKILL.md, "What T27F is". This spec is its law: which
; surfaces exist, what draws each today, which surface answers an intent, and which TRI CLAW serves.
; --
; What this spec does not restate:
; - The rules of each surface. They stay in the spec that decides it (spec_graph*.t27, reel.t27,
;   deck.t27, token_floor*.t27, lesson_reel.t27, hot.t27, claw/t27f_gate.t27, claw/preview.t27,
;   particle_field.t27, ui_plan.t27, t27mcp/dashboard.t27, petal_menu.t27). This spec names the
;   surface only.
; - The T27 OS home (SF_PETAL_MENU, 2026-10-19): the 27-petal triangle, its hit test and its
;   open/close rule live in petal_menu.t27; its hosts are the trios app today and an FPGA later.
; - Tool names. A surface drawn by an MCP tool points at its row of specs/t27mcp/tool_schema.t27.
; - Which tool belongs to TRI CLAW. specs/t27mcp/service.t27 decides that by prefix (t27_ and t27f_
;   are the t27 module's, mounted into TRI CLAW's /mcp). This spec checks that every T27F tool is
;   mounted there, and names the drawing set TRI CLAW's chat agent carries.
; - Where a file reaches the user, by host: channel_for in specs/t27f/reel.t27.
; --
; Status, as measured on 2026-10-18 (inventory of gHashTag/t27, t27-mcp and trinity at master):
; - LIVE: a host draws it on request (an MCP tool or a t27.ai page).
; - LAB: made by hand on the Railway lab from its spec; no host makes it on request.
; - PARTIAL: a host runs and answers, but nothing shows what it answers.
; - BLOCKED: wired, but waiting on a permission only the owner can grant.
; - SPEC: a spec with tests; nothing draws it.
; A surface that is not LIVE or LAB cannot be made this turn. route() names the surface an intent
; wants, pick() gives the stand-in that can be made, and claim_ok() refuses a claim to have made one.
; Not measured: whether TRI CLAW's deployed /mcp mounts the t27 tools today. service.t27 is the law;
; the mount itself is code in gHashTag/999-multibots-telegraf.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27fFrontend;

use t27f::reel;
use t27mcp::tool_schema;
use t27mcp::service::home_of;
use t27mcp::service::has_prefix;
use t27mcp::service::T27_PREFIXES;
use t27mcp::service::H_T27;

/// The surfaces T27F draws on.
pub const SF_GRAPH : u32 = 0;          // spec graph as SVG: spec_graph_export / _view, tool t27f_graph
pub const SF_OUTLINE : u32 = 1;        // spec graph as compact text: spec_graph_outline, tool t27f_outline
pub const SF_MAP_STILL : u32 = 2;      // honeycomb map still, deck look: reel.t27 + deck.t27, tool t27f_view
pub const SF_GRAPH_PAGE : u32 = 3;     // t27.ai/t27f/graph/ and the Spec Explorer graph layer
pub const SF_HOT : u32 = 4;            // hot-reload stream, hot.t27 + build.t27 (t27-mcp --watch)
pub const SF_CHECK : u32 = 5;          // claw/t27f check-run, claw/t27f_gate.t27, posted by the TRI CLAW App
pub const SF_PREVIEW : u32 = 6;        // PR preview deployment, claw/preview.t27
pub const SF_PARTICLE_REEL : u32 = 7;  // token_floor*.t27, lesson_reel.t27, reel_particles*.t27
pub const SF_STILL : u32 = 8;          // one frame of a particle reel
pub const SF_MAP_VIDEO : u32 = 9;      // honeycomb reel as video and live player, reel.t27
pub const SF_PARTICLE_LIVE : u32 = 10; // T27F Live, particle_field.t27 + particle_engine.t27
pub const SF_UI_PLAN : u32 = 11;       // trusted-widget UI plan, ui_plan.t27
pub const SF_DASHBOARD : u32 = 12;     // corpus and session health, t27mcp/dashboard.t27, tool t27_dashboard
pub const SF_PETAL_MENU : u32 = 13;    // T27 OS home: the 27-petal triangle menu, petal_menu.t27
pub const SF_WIDGET_FACTORY : u32 = 14; // widgets as specs: logic, plan, page, data, card -- widget_factory.t27, catalogue widgets/catalog.t27
pub const SF_COUNT : u32 = 15;
pub const SF_NONE : u32 = 255;

pub const SURFACE_NAMES : str = "graph,outline,map_still,graph_page,hot,check,preview,particle_reel,still,map_video,particle_live,ui_plan,dashboard,petal_menu,widget_factory";

/// What draws a surface today.
pub const ST_LIVE : u8 = 0;
pub const ST_LAB : u8 = 1;
pub const ST_PARTIAL : u8 = 2;
pub const ST_BLOCKED : u8 = 3;
pub const ST_SPEC : u8 = 4;

pub const SURFACE_STATUS : [15]u8 = [0, 0, 0, 0, 2, 3, 4, 1, 1, 4, 4, 4, 0, 4, 4];

/// Where a surface is made: an MCP tool, a t27.ai page, the Railway lab, the TRI CLAW App, nowhere.
pub const MK_MCP : u8 = 0;
pub const MK_SITE : u8 = 1;
pub const MK_LAB : u8 = 2;
pub const MK_APP : u8 = 3;
pub const MK_NONE : u8 = 4;

pub const SURFACE_MAKER : [15]u8 = [0, 0, 0, 1, 0, 3, 3, 2, 2, 4, 4, 4, 0, 4, 4];

/// What a caller wants shown.
pub const I_SPEC_SHAPE : u32 = 0;  // the structure of one spec
pub const I_SPEC_WORDS : u32 = 1;  // a spec's decisions in a few lines
pub const I_TOPIC_MAP : u32 = 2;   // a topic or a course as the 27-cell map
pub const I_LESSON : u32 = 3;      // a lesson or a topic as a video
pub const I_REPORT : u32 = 4;      // a report of a piece of work
pub const I_PR : u32 = 5;          // a pull request that touches .t27 files
pub const I_EDITING : u32 = 6;     // a spec redrawn while it is edited
pub const I_HEALTH : u32 = 7;      // the state of the corpus and the session
pub const I_LIVE_AGENT : u32 = 8;  // an agent's work as a live particle field
pub const I_APP : u32 = 9;         // an application screen built from trusted widgets
pub const I_OS_HOME : u32 = 10;    // the T27 OS home screen: 27 petals, a petal opens its menu
pub const I_WIDGET : u32 = 11;     // a shareable widget made from a spec, and the census of the ones that exist
pub const I_COUNT : u32 = 12;

/// The drawing tools TRI CLAW's chat agent carries. service.t27 gives its coder persona CODER_TOOLS
/// for writing a spec; these are for showing one.
pub const CLAW_VISUAL_COUNT : u32 = 4;

pub fn claw_visual_tool(k: u32) -> u32 {
    if (k == 0) {
        return T_GRAPH;
    }
    if (k == 1) {
        return T_OUTLINE;
    }
    if (k == 2) {
        return T_VIEW;
    }
    if (k == 3) {
        return T_DASHBOARD;
    }
    return TOOL_COUNT;
}

pub fn surface_ok(s: u32) -> bool {
    return s < SF_COUNT;
}

/// A surface can be made this turn when a host draws it or the lab recipe makes it.
pub fn makeable(s: u32) -> bool {
    if (surface_ok(s) == false) {
        return false;
    }
    return SURFACE_STATUS[s] == ST_LIVE or SURFACE_STATUS[s] == ST_LAB;
}

/// The tool_schema.t27 row of the MCP tool that draws a surface, or TOOL_COUNT when no tool does.
pub fn surface_tool(s: u32) -> u32 {
    if (s == SF_GRAPH) {
        return T_GRAPH;
    }
    if (s == SF_OUTLINE) {
        return T_OUTLINE;
    }
    if (s == SF_MAP_STILL) {
        return T_VIEW;
    }
    if (s == SF_DASHBOARD) {
        return T_DASHBOARD;
    }
    return TOOL_COUNT;
}

/// The surface an intent wants. On t27.ai the graph is the live page, elsewhere the MCP tool's SVG.
pub fn route(intent: u32, host: u8) -> u32 {
    if (intent == I_SPEC_SHAPE) {
        if (host == HOST_SITE) {
            return SF_GRAPH_PAGE;
        }
        return SF_GRAPH;
    }
    if (intent == I_SPEC_WORDS) {
        return SF_OUTLINE;
    }
    if (intent == I_TOPIC_MAP) {
        return SF_MAP_VIDEO;
    }
    if (intent == I_LESSON) {
        return SF_PARTICLE_REEL;
    }
    if (intent == I_REPORT) {
        return SF_STILL;
    }
    if (intent == I_PR) {
        return SF_CHECK;
    }
    if (intent == I_EDITING) {
        return SF_HOT;
    }
    if (intent == I_HEALTH) {
        return SF_DASHBOARD;
    }
    if (intent == I_LIVE_AGENT) {
        return SF_PARTICLE_LIVE;
    }
    if (intent == I_APP) {
        return SF_UI_PLAN;
    }
    if (intent == I_OS_HOME) {
        return SF_PETAL_MENU;
    }
    if (intent == I_WIDGET) {
        return SF_WIDGET_FACTORY;
    }
    return SF_NONE;
}

/// The surface that stands in for one that cannot be made this turn, or SF_NONE.
pub fn stand_in(s: u32) -> u32 {
    if (makeable(s)) {
        return s;
    }
    if (s == SF_MAP_VIDEO) {
        return SF_MAP_STILL;
    }
    if (s == SF_CHECK or s == SF_PREVIEW or s == SF_HOT) {
        return SF_GRAPH;
    }
    if (s == SF_PARTICLE_LIVE) {
        return SF_PARTICLE_REEL;
    }
    return SF_NONE;
}

/// What T27F shows for an intent on a host this turn.
pub fn pick(intent: u32, host: u8) -> u32 {
    let want : u32 = route(intent, host);
    if (want == SF_NONE) {
        return SF_NONE;
    }
    return stand_in(want);
}

/// An answer may say it made a surface only if that surface can be made.
pub fn claim_ok(s: u32, claimed_made: bool) -> bool {
    if (claimed_made == false) {
        return true;
    }
    return makeable(s);
}

/// TRI CLAW serves a surface when an MCP tool draws it under a name service.t27 gives the t27 home:
/// admit() mounts every t27 tool the t27 side offers. admit() is not called here: its helper name_ok
/// shares a name with tool_schema.t27 name_ok, and the splicer refuses an ambiguous name.
pub fn claw_serves(s: u32) -> bool {
    let t : u32 = surface_tool(s);
    if (t >= TOOL_COUNT) {
        return false;
    }
    return home_of(TOOLS[t].name) == H_T27;
}

test every_intent_routes_to_a_known_surface {
    var i : u32 = 0;
    while (i < I_COUNT) {
        assert surface_ok(route(i, HOST_CLAUDE_CODE_DESKTOP));
        assert surface_ok(route(i, HOST_SITE));
        i = i + 1;
    }
    assert route(I_COUNT, HOST_CLAUDE_CODE_DESKTOP) == SF_NONE;
    assert pick(I_COUNT, HOST_CLAUDE_CODE_DESKTOP) == SF_NONE;
}

test the_graph_is_the_page_on_the_site_and_the_tool_elsewhere {
    assert route(I_SPEC_SHAPE, HOST_SITE) == SF_GRAPH_PAGE;
    assert route(I_SPEC_SHAPE, HOST_CLAUDE_CODE_DESKTOP) == SF_GRAPH;
    assert route(I_SPEC_SHAPE, HOST_CLAUDE_CODE_CLI) == SF_GRAPH;
    assert route(I_SPEC_SHAPE, HOST_MCP_APPS) == SF_GRAPH;
}

test a_report_is_a_particle_still_and_a_lesson_a_particle_reel {
    assert pick(I_REPORT, HOST_CLAUDE_CODE_DESKTOP) == SF_STILL;
    assert pick(I_LESSON, HOST_CLAUDE_CODE_DESKTOP) == SF_PARTICLE_REEL;
    assert SURFACE_MAKER[SF_STILL] == MK_LAB;
    assert SURFACE_MAKER[SF_PARTICLE_REEL] == MK_LAB;
}

test the_os_home_is_the_petal_menu_and_nothing_draws_it_yet {
    assert route(I_OS_HOME, HOST_CLAUDE_CODE_DESKTOP) == SF_PETAL_MENU;
    assert route(I_OS_HOME, HOST_SITE) == SF_PETAL_MENU;
    assert pick(I_OS_HOME, HOST_CLAUDE_CODE_DESKTOP) == SF_NONE;
    assert claim_ok(SF_PETAL_MENU, true) == false;
}

test what_cannot_be_made_has_a_stand_in_or_none {
    assert pick(I_TOPIC_MAP, HOST_CLAUDE_CODE_DESKTOP) == SF_MAP_STILL;
    assert pick(I_PR, HOST_CLAUDE_CODE_DESKTOP) == SF_GRAPH;
    assert pick(I_EDITING, HOST_CLAUDE_CODE_DESKTOP) == SF_GRAPH;
    assert pick(I_LIVE_AGENT, HOST_CLAUDE_CODE_DESKTOP) == SF_PARTICLE_REEL;
    assert pick(I_APP, HOST_CLAUDE_CODE_DESKTOP) == SF_NONE;
    var i : u32 = 0;
    while (i < I_COUNT) {
        let s : u32 = pick(i, HOST_CLAUDE_CODE_DESKTOP);
        if (s != SF_NONE) {
            assert makeable(s);
        }
        i = i + 1;
    }
}

test a_surface_nothing_draws_is_never_claimed_made {
    assert claim_ok(SF_GRAPH, true);
    assert claim_ok(SF_STILL, true);
    assert claim_ok(SF_MAP_VIDEO, true) == false;
    assert claim_ok(SF_CHECK, true) == false;
    assert claim_ok(SF_UI_PLAN, true) == false;
    assert claim_ok(SF_UI_PLAN, false);
    assert claim_ok(SF_NONE, true) == false;
}

test every_tool_surface_is_a_t27_name_tri_claw_mounts {
    var s : u32 = 0;
    var tools : u32 = 0;
    while (s < SF_COUNT) {
        let t : u32 = surface_tool(s);
        if (t < TOOL_COUNT) {
            assert SURFACE_MAKER[s] == MK_MCP;
            assert has_prefix(TOOLS[t].name, "t27");
            assert home_of(TOOLS[t].name) == H_T27;
            assert claw_serves(s);
            tools = tools + 1;
        }
        s = s + 1;
    }
    assert tools == 4;
    assert claw_serves(SF_STILL) == false;
    assert claw_serves(SF_GRAPH_PAGE) == false;
}

test tri_claw_carries_every_drawing_tool {
    var k : u32 = 0;
    var found : u32 = 0;
    while (k < CLAW_VISUAL_COUNT) {
        var s : u32 = 0;
        while (s < SF_COUNT) {
            if (surface_tool(s) == claw_visual_tool(k)) {
                assert claw_serves(s);
                found = found + 1;
            }
            s = s + 1;
        }
        k = k + 1;
    }
    assert found == CLAW_VISUAL_COUNT;
    assert claw_visual_tool(CLAW_VISUAL_COUNT) == TOOL_COUNT;
    assert TOOLS[claw_visual_tool(0)].name == "t27f_graph";
}


test the_widget_factory_is_a_spec_and_nothing_makes_it_yet {
    assert route(I_WIDGET, HOST_CLAUDE_CODE_DESKTOP) == SF_WIDGET_FACTORY;
    assert route(I_WIDGET, HOST_SITE) == SF_WIDGET_FACTORY;
    assert SURFACE_STATUS[SF_WIDGET_FACTORY] == ST_SPEC;
    assert pick(I_WIDGET, HOST_CLAUDE_CODE_DESKTOP) == SF_NONE;
    assert claim_ok(SF_WIDGET_FACTORY, true) == false;
    assert surface_tool(SF_WIDGET_FACTORY) == TOOL_COUNT;
}
