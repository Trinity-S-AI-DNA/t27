// SPDX-License-Identifier: Apache-2.0
// specs/t27f/scene_trit.t27 -- scene A_TRIT of reel_factory.t27: the lesson's own bytes as a field of
// trits. Each cell of a 9 x 14 grid is one trit, -1, 0 or +1, read from the next byte of the
// lesson's code: a minus bar on red, a ring on grey, a plus on the accent.
// Issue gHashTag/t27#10571 (R3), epic #10560.
//
// WHY: t27 is a ternary language, and the lessons that teach trits (and every other lesson, for
// that matter) are text that a trit field can show: the bytes of the source taken mod 3. The grid
// is the lesson, one byte a cell, so no two lessons draw one field.
//
// THE FUNCTION: trit_px(t, acc, n, x, y) is the colour of canvas point (x, y). The cell of index i
// holds trit (byte i of the lesson + i) mod 3 - 1.
//
// NOT CLAIMED: the mod-3 reading is a picture of the bytes, not the lesson's trit values.
// phi^2 + 1/phi^2 = 3 | TRINITY

module scene_trit;

use t27f::scene_raster::fmod;
use t27f::scene_raster::rgb;
use t27f::scene_raster::mix;
use t27f::scene_raster::in_rect;
use t27f::scene_raster::in_disc;
use t27f::scene_raster::in_ring;
use t27f::scene_bg::bg_px;
use t27f::scene_bg::seed_of;
use t27f::scene_lex::lex_byte;

pub const GCOLS : i32 = 9;
pub const GROWS : i32 = 14;
pub const CELL : i32 = 40;
pub const GY0 : i32 = 40;
pub const NEG : i32 = 0xE5484D;
pub const ZERO : i32 = 0x7C8499;

// The trit, -1, 0 or +1, of cell i of lesson t.
pub fn trit_of(t: usize, i: i32) -> i32 {
    return fmod(lex_byte(t, i) + i, 3) - 1;
}

pub fn trit_px(t: usize, acc: i32, n: i32, x: i32, y: i32) -> i32 {
    const c0 = bg_px(3, acc, seed_of(t, n, 3), x, y);
    if (y < GY0 || x < 0) { return c0; }
    const col = @divTrunc(x, CELL);
    const row = @divTrunc(y - GY0, CELL);
    if (col >= GCOLS || row >= GROWS) { return c0; }
    const v = trit_of(t, row * GCOLS + col);
    const cx = col * CELL + 20;
    const cy = GY0 + row * CELL + 20;
    var hue = ZERO;
    if (v < 0) { hue = NEG; }
    if (v > 0) { hue = acc; }
    if (!in_disc(x, y, cx, cy, 17)) { return c0; }
    if (in_ring(x, y, cx, cy, 15, 17)) { return hue; }
    const body = mix(rgb(10, 12, 24), hue, 70);
    if (v < 0 && in_rect(x, y, cx - 8, cy - 2, cx + 8, cy + 2)) { return hue; }
    if (v > 0 && (in_rect(x, y, cx - 8, cy - 2, cx + 8, cy + 2) || in_rect(x, y, cx - 2, cy - 8, cx + 2, cy + 8))) { return hue; }
    if (v == 0 && in_ring(x, y, cx, cy, 4, 7)) { return hue; }
    return body;
}

// ---- tests ----

test "the trit of a cell is -1, 0 or +1 and all three occur" {
    var neg : i32 = 0;
    var zero : i32 = 0;
    var pos : i32 = 0;
    var i : i32 = 0;
    while (i < GCOLS * GROWS) {
        const v = trit_of(7, i);
        assert(v >= 0 - 1 && v <= 1);
        if (v < 0) { neg = neg + 1; }
        if (v == 0) { zero = zero + 1; }
        if (v > 0) { pos = pos + 1; }
        i = i + 1;
    }
    assert(neg > 10 && zero > 10 && pos > 10);
}

test "the field is the lesson's bytes: another lesson draws another field" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            const a = trit_px(4, 0x22C55E, 6, x, y);
            const b = trit_px(19, 0x22C55E, 6, x, y);
            assert(a >= 0 && a <= 0xFFFFFF);
            if (a != b) { diff = diff + 1; }
            x = x + 3;
        }
        y = y + 3;
    }
    assert(diff > 5000);
}

test "each of the three trits has its own look" {
    // find one cell of each sign in lesson 4 and compare the middle pixel of each
    var cn : i32 = 0 - 1;
    var cz : i32 = 0 - 1;
    var cp : i32 = 0 - 1;
    var i : i32 = 0;
    while (i < GCOLS * GROWS) {
        const v = trit_of(4, i);
        if (v < 0 && cn < 0) { cn = i; }
        if (v == 0 && cz < 0) { cz = i; }
        if (v > 0 && cp < 0) { cp = i; }
        i = i + 1;
    }
    assert(cn >= 0 && cz >= 0 && cp >= 0);
    const rn = trit_px(4, 0x22C55E, 6, fmod(cn, GCOLS) * CELL + 20 + 5, GY0 + @divTrunc(cn, GCOLS) * CELL + 20);
    const rp = trit_px(4, 0x22C55E, 6, fmod(cp, GCOLS) * CELL + 20 + 5, GY0 + @divTrunc(cp, GCOLS) * CELL + 20);
    assert(rn == NEG);
    assert(rp == 0x22C55E);
    assert(rn != rp);
}

test "negative control: the same lesson twice is one picture" {
    var diff : i32 = 0;
    var y : i32 = 0;
    while (y < 640) {
        var x : i32 = 0;
        while (x < 360) {
            if (trit_px(9, 0xE0409A, 2, x, y) != trit_px(9, 0xE0409A, 2, x, y)) { diff = diff + 1; }
            x = x + 5;
        }
        y = y + 5;
    }
    assert(diff == 0);
}
