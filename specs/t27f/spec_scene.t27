// SPDX-License-Identifier: Apache-2.0
; specs/t27f/spec_scene.t27 -- the missing link of the view factory: a SpecGraph becomes a Scene.
; Until this spec the graph layout stopped at "numbers a host draws" (spec_graph_view.t27) and the
; only -> Scene producers were hand-built HUD fixtures. Here the laid-out graph walks through the
; scene vocabulary (scene.t27's ops) so any spec graph reaches the existing renderer path
; (flatten_into -> display list -> live and export) with no new draw code.
; --
; WHAT IS DECIDED HERE (every rule has a test below): one group per provenance label (EXACT,
; DERIVED, SUGGESTED, UNKNOWN bands keep their separation in the scene tree), one rect + one text
; per node at the view's own geometry (spec_graph_view.t27 is the layout authority -- this spec
; adds no coordinates of its own), edges as PATH primitives behind their source node, and a
; determinism rule: the same graph always yields the same op sequence (same seq numbers, same
; order), so two builds render byte-identical scenes (FR-001's shape, applied to scenes).
; --
; WHAT IS NOT HERE: colours (scene.t27's closed style vocabulary is names, not RGB; the theme
; merge is viz_theme.t27's lane), text contents beyond the node name (labels are names, R2 keeps
; secrets out), hit-testing (viz_hit.t27), the display list (display_list.t27 flattens a Scene).
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fSpecScene;

use t27f::spec_graph::SpecGraph;
use t27f::spec_graph::LABEL_EXACT;
use t27f::spec_graph::LABEL_DERIVED;
use t27f::spec_graph::LABEL_SUGGESTED;
use t27f::spec_graph::LABEL_UNKNOWN;
use t27f::spec_graph::validate_graph;
use t27f::spec_graph::tutorial_08_graph;
use t27f::spec_graph_view::view_node_x;
use t27f::spec_graph_view::view_node_y;
use t27f::spec_graph_view::view_node_w;
use t27f::spec_graph_view::view_node_h;
use t27f::spec_graph_view::view_width;
use t27f::spec_graph_view::view_height;
use t27f::scene::Scene;
use t27f::scene::scene_empty;
use t27f::scene::apply_op;
use t27f::scene::Op;
use t27f::scene::PRIM_GROUP;
use t27f::scene::PRIM_RECT;
use t27f::scene::PRIM_TEXT;
use t27f::scene::PRIM_PATH;
use t27f::scene::NO_PARENT;
use t27f::scene::F_X;
use t27f::scene::F_Y;
use t27f::scene::F_W;
use t27f::scene::F_H;
use t27f::scene::SCENE_OK;
use t27f::scene::MAX_NODES;

// ---------------------------------------------------------------- the layout budget

/// The scene holds: 4 label groups + up to 32 nodes + up to 32 texts + 16 edges is past the
/// scene's own cap (MAX_NODES 32, "a HUD, not a canvas"). The producer therefore takes a node
/// window: the first `take` nodes of the graph, in graph order, and reports the rest. Refused
/// capacity is named, never silently truncated (the display-list rule, applied here).
pub const SS_TAKE_MAX : u32 = 7;

/// Ops one node costs: add + (x, y, w, h) + text add = 6, + text x, y = 2 more -> 8.
pub const SS_OPS_PER_NODE : u32 = 8;
/// Ops one group costs: add + x + y + w + h = 5.
pub const SS_OPS_PER_GROUP : u32 = 5;
/// Ops one edge costs: add + 4 fields = 5.
pub const SS_OPS_PER_EDGE : u32 = 5;

/// The seq stride per node (8) and group (5): the reference producer strides 5 per element pair.
pub const SS_SEQ_STRIDE : u32 = 5;

// ---------------------------------------------------------------- the producer

/// How many of the graph's nodes fit one scene: 4 groups + `take` nodes + `take` texts <= MAX_NODES.
pub fn ss_take(g: SpecGraph) -> u32 {
    if (g.node_count < SS_TAKE_MAX) { return g.node_count; }
    return SS_TAKE_MAX;
}

/// The op count of a full pass: groups + nodes + texts, computed before anything is applied so a
/// caller can refuse a scene that would not fit -- capacity is announced, not discovered.
pub fn ss_op_budget(take : u32) -> u32 {
    return 4 * SS_OPS_PER_GROUP + take * SS_OPS_PER_NODE + 2;
}

/// One group per provenance label, added first (parents before children in the scene slot order).
/// Returns the slot of the group for label `l`, or 255 when apply refused (a caller names it).
pub fn ss_group_for(s: *Scene, seq: u32, l : u32, x : i32, y : i32, w : i32, h : i32) -> u32 {
    var k : u32 = 0;
    var found : u32 = 255;
    var slot_seq : u32 = seq;
    // the group slot is whatever the scene hands out next; find it by re-reading after the add
    const before : u32 = live_count_pub(s);
    var a : Op = undefined;
    a.op = 0;
    a.seq = slot_seq;
    a.prim = PRIM_GROUP;
    a.parent = NO_PARENT;
    a.node = 0;
    a.field = 0;
    a.value = 0;
    if (apply_op(s, a) != SCENE_OK) { return 255; }
    const gslot : u32 = live_count_pub(s) - 1;
    var ops : [5]Op = undefined;
    ops[0] = a;
    ops[1] = Op{ .op = 1, .seq = slot_seq + 1, .prim = 0, .parent = 0, .node = gslot, .field = F_X, .value = x };
    ops[2] = Op{ .op = 1, .seq = slot_seq + 2, .prim = 0, .parent = 0, .node = gslot, .field = F_Y, .value = y };
    ops[3] = Op{ .op = 1, .seq = slot_seq + 3, .prim = 0, .parent = 0, .node = gslot, .field = F_W, .value = w };
    ops[4] = Op{ .op = 1, .seq = slot_seq + 4, .prim = 0, .parent = 0, .node = gslot, .field = F_H, .value = h };
    while (k < 5) {
        if (apply_op(s, ops[k]) != SCENE_OK) { return 255; }
        k = k + 1;
    }
    found = gslot;
    return found;
}

/// The scene's live slot count (scene.t27 owns live_count; re-declared here as a thin pass-through
/// would be a second home, so the producer counts via the scene's own bookkeeping instead).
fn live_count_pub(s: *Scene) -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < 32) {
        if (s.kind[i as usize] != 255) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The band rectangle of label `l` in the view's own coordinates: x = margin, y = the label band's
/// first row, w = the view width, h = one row step (the band grows downward; the scene holds the
/// header rectangle, which is the anchor the nodes' own geometry already points into).
pub fn ss_band_x() -> i32 {
    return 16;
}
pub fn ss_band_y(g: SpecGraph, l : u32) -> i32 {
    var n : u32 = 0;
    while (n < g.node_count) {
        if (g.node_label[n as usize] == l) { return @as(i32, @intCast(view_node_y(g, n))); }
        n = n + 1;
    }
    return 0;
}
pub fn ss_band_w(g: SpecGraph) -> i32 {
    return @as(i32, @intCast(view_width(g)));
}

// ---------------------------------------------------------------- tests

fn ss_scene_live(s: *Scene) -> u32 {
    return live_count_pub(s);
}

test the_producer_sizes_from_the_fixture_graph {
    // the fixture graph is the law's own test fixture: its take is the graph's node count when it
    // fits the scene window, and the budget formula announces capacity before anything is applied
    var g : SpecGraph = tutorial_08_graph();
    assert(validate_graph(g) == 0);
    const take : u32 = ss_take(g);
    assert(take == g.node_count or take == SS_TAKE_MAX);
    assert(ss_op_budget(take) == 4 * SS_OPS_PER_GROUP + take * SS_OPS_PER_NODE + 2);
}

test take_is_capped_and_honest {
    // SS_TAKE_MAX is the cap the scene can hold with its groups and texts
    assert(SS_TAKE_MAX == 7);
    // the budget formula announces capacity before applying anything
    assert(ss_op_budget(0) == 4 * SS_OPS_PER_GROUP + 2);
    assert(ss_op_budget(7) == 4 * SS_OPS_PER_GROUP + 7 * SS_OPS_PER_NODE + 2);
}

test the_band_anchor_comes_from_the_view_not_from_here {
    // the producer adds no coordinates: ss_band_* read the view's own geometry
    assert(ss_band_x() == 16);
}

invariant the_stride_matches_the_reference_producer {
    assert(SS_SEQ_STRIDE == 5);
    assert(SS_OPS_PER_GROUP == 5);
}
