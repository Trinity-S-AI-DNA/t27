// SPDX-License-Identifier: Apache-2.0
; T27F proportion tokens: a BOUNDED generator for design tokens, V = n * 3^k * pi^m * phi^p * e^q
; Refs Trinity-S-AI-DNA/t27#13251 (course v2 visual factory, proportion ring 1: generator and token sheet)
; --
; n is a base size in px; k, m, p, q come from small finite sets fixed per profile. A request outside its profile's set is
; refused (status, value 0), never computed and never silently clamped. A value outside the profile's [v_min, v_max] is
; clamped and the clamp is recorded with the raw value. Every token carries its provenance: n, k, m, p2 (p = p2 / 2), q, the
; ratio num/den when it is not a phi power, profile, rounding rule, clamp, exception reason, status.
; This slice has three profiles: spacing (whole phi powers), type (half phi powers, a phi^(1/2) modular scale) and split (the
; phi^-1 share of a length, minor = n - major so the parts sum exactly). The factors 3, pi and e have no profile yet: any
; non-zero k, m or q is refused. Motion (e) waits for a justified exponential model; pi waits for icons and circles.
; --
; Arithmetic is integer only, in nano units (1e9 = 1.0): phi^p for integer p is exact in Z[phi], phi^p = a + b phi with
; Fibonacci a, b, evaluated once with PHI_NANO; a half step multiplies by SQRT_PHI_NANO once. Rounding is half-up, once, at
; the px value: (n * factor_nano + 500000000) / 1000000000. No f64 on the token path, so t27b and t27c round the same way.
; PHI_NANO and SQRT_PHI_NANO are proven in the tests from 2 phi - 1 = sqrt 5 and s^2 ~ phi, not copied from an f64.
; --
; The golden ratio here is a chosen design language. It does not make a layout good: accessibility floors (vf_prop_floor)
; and measured text fit (vf_text_measure) override proportions, and the token sheet is not a quality score.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module VfProportion;

pub const VP_NANO : u64 = 1000000000;
pub const VP_HALF : u64 = 500000000;
; round(phi * 1e9) and round(sqrt(phi) * 1e9); the tests vp_phi_nano_is_phi_rounded and vp_sqrt_phi_nano_is_rounded prove both
pub const VP_PHI_NANO : u64 = 1618033989;
pub const VP_SQRT_PHI_NANO : u64 = 1272019650;
; 1 rem
pub const VP_REM_PX : u32 = 16;

; profiles
pub const VP_SPACE : u32 = 1;
pub const VP_TYPE : u32 = 2;
pub const VP_SPLIT : u32 = 3;
pub const VP_MOTION : u32 = 4;

; status
pub const VP_OK : u32 = 0;
pub const VP_REFUSED_EXP : u32 = 1;
pub const VP_REFUSED_N : u32 = 2;
pub const VP_REFUSED_PROFILE : u32 = 3;

; clamp
pub const VP_CLAMP_NONE : u32 = 0;
pub const VP_CLAMP_MIN : u32 = 1;
pub const VP_CLAMP_MAX : u32 = 2;

; rounding rule
pub const VP_ROUND_HALF_UP : u32 = 1;

; exception reasons, a closed set
pub const VP_EXC_NONE : u32 = 0;
; 44 px touch minimum, specs/ui/viewport.t27
pub const VP_EXC_TOUCH_MIN : u32 = 1;
; 24 px target minimum, WCAG 2.2 SC 2.5.8
pub const VP_EXC_TARGET_MIN : u32 = 2;
; a declared ratio num/den that is not a phi power
pub const VP_EXC_RATIO : u32 = 3;

pub const VP_TOUCH_MIN_PX : u32 = 44;
pub const VP_TARGET_MIN_PX : u32 = 24;

; one profile: the n range, the p2 range (p = p2 / 2), whether p2 must be even, the value range in px
pub struct VfPropProfile {
    id: u32,
    n_min: u32,
    n_max: u32,
    p2_min: i32,
    p2_max: i32,
    p2_even: u32,
    v_min: u32,
    v_max: u32,
}

; one token and its provenance; value 0 with a non-zero status is a refusal
pub struct VfToken {
    value: u32,
    raw: u32,
    factor_nano: u64,
    n: u32,
    k: i32,
    m: i32,
    p2: i32,
    q: i32,
    num: u32,
    den: u32,
    profile: u32,
    round_rule: u32,
    clamp: u32,
    exc: u32,
    status: u32,
}

; a length split at phi^-1: major + minor == n
pub struct VfSplit {
    n: u32,
    major: u32,
    minor: u32,
    status: u32,
}

; the profile table; an unknown id (motion included, for now) gives id 0
pub fn vf_prop_profile(id: u32) -> VfPropProfile {
    if id == VP_SPACE {
        return VfPropProfile { id: VP_SPACE, n_min: 8, n_max: 32, p2_min: 0 - 4, p2_max: 8, p2_even: 1, v_min: 4, v_max: 128 };
    }
    if id == VP_TYPE {
        return VfPropProfile { id: VP_TYPE, n_min: 12, n_max: 20, p2_min: 0 - 2, p2_max: 8, p2_even: 0, v_min: 10, v_max: 128 };
    }
    if id == VP_SPLIT {
        return VfPropProfile { id: VP_SPLIT, n_min: 1, n_max: 4096, p2_min: 0 - 2, p2_max: 0 - 2, p2_even: 1, v_min: 1, v_max: 4096 };
    }
    return VfPropProfile { id: 0, n_min: 0, n_max: 0, p2_min: 0, p2_max: 0, p2_even: 0, v_min: 0, v_max: 0 };
}

; Fibonacci F(n), F(0) = 0, F(1) = 1
pub fn vf_prop_fib(n: u32) -> u64 {
    var a : u64 = 0;
    var b : u64 = 1;
    var i : u32 = 0;
    while i < n {
        var c : u64 = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return a;
}

; phi^p in nano for whole p in [-4, 4]: phi^p = F(p-1) + F(p) phi for p >= 1; phi^-j = (-1)^j (F(j+1) - F(j) phi)
pub fn vf_prop_phi_whole_nano(p: i32) -> u64 {
    if p == 0 {
        return VP_NANO;
    }
    if p > 0 {
        var up : u32 = p as u32;
        return vf_prop_fib(up - 1) * VP_NANO + vf_prop_fib(up) * VP_PHI_NANO;
    }
    var j : u32 = (0 - p) as u32;
    var f1 : u64 = vf_prop_fib(j + 1) * VP_NANO;
    var f0 : u64 = vf_prop_fib(j) * VP_PHI_NANO;
    if j % 2 == 0 {
        return f1 - f0;
    }
    return f0 - f1;
}

; phi^(p2 / 2) in nano for p2 in [-8, 8]; an odd p2 multiplies the whole step below it by sqrt(phi) once; 0 outside the range
pub fn vf_prop_phi_nano(p2: i32) -> u64 {
    if p2 < 0 - 8 {
        return 0;
    }
    if p2 > 8 {
        return 0;
    }
    var u : u32 = (p2 + 16) as u32;
    var whole : i32 = ((u / 2) as i32) - 8;
    var base : u64 = vf_prop_phi_whole_nano(whole);
    if u % 2 == 1 {
        return (base * VP_SQRT_PHI_NANO + VP_HALF) / VP_NANO;
    }
    return base;
}

; clamp t.raw into the profile's value range and record it
fn vf_prop_clamp(t: VfToken, pr: VfPropProfile) -> VfToken {
    var r : VfToken = t;
    r.value = r.raw;
    if r.raw < pr.v_min {
        r.value = pr.v_min;
        r.clamp = VP_CLAMP_MIN;
    }
    if r.raw > pr.v_max {
        r.value = pr.v_max;
        r.clamp = VP_CLAMP_MAX;
    }
    return r;
}

fn vf_prop_blank(profile: u32, n: u32, k: i32, m: i32, p2: i32, q: i32) -> VfToken {
    return VfToken { value: 0, raw: 0, factor_nano: 0, n: n, k: k, m: m, p2: p2, q: q, num: 1, den: 1, profile: profile, round_rule: VP_ROUND_HALF_UP, clamp: VP_CLAMP_NONE, exc: VP_EXC_NONE, status: VP_OK };
}

; the generator: V = n * 3^k * pi^m * phi^(p2/2) * e^q, inside the profile's sets, rounded half-up once, clamped and recorded
pub fn vf_prop_token(profile: u32, n: u32, k: i32, m: i32, p2: i32, q: i32) -> VfToken {
    var t : VfToken = vf_prop_blank(profile, n, k, m, p2, q);
    let pr : VfPropProfile = vf_prop_profile(profile);
    if pr.id == 0 {
        t.status = VP_REFUSED_PROFILE;
        return t;
    }
    if k != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if m != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if q != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if p2 < pr.p2_min {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if p2 > pr.p2_max {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if pr.p2_even == 1 {
        if ((p2 + 16) as u32) % 2 == 1 {
            t.status = VP_REFUSED_EXP;
            return t;
        }
    }
    if n < pr.n_min {
        t.status = VP_REFUSED_N;
        return t;
    }
    if n > pr.n_max {
        t.status = VP_REFUSED_N;
        return t;
    }
    t.factor_nano = vf_prop_phi_nano(p2);
    t.raw = (((n as u64) * t.factor_nano + VP_HALF) / VP_NANO) as u32;
    return vf_prop_clamp(t, pr);
}

; a declared ratio num/den that is not a phi power (a kept hand-table entry); recorded as an exception, same rounding and clamp
pub fn vf_prop_ratio(profile: u32, n: u32, num: u32, den: u32) -> VfToken {
    var t : VfToken = vf_prop_blank(profile, n, 0, 0, 0, 0);
    let pr : VfPropProfile = vf_prop_profile(profile);
    if pr.id == 0 {
        t.status = VP_REFUSED_PROFILE;
        return t;
    }
    if den == 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if n < pr.n_min {
        t.status = VP_REFUSED_N;
        return t;
    }
    if n > pr.n_max {
        t.status = VP_REFUSED_N;
        return t;
    }
    t.num = num;
    t.den = den;
    t.exc = VP_EXC_RATIO;
    t.factor_nano = ((num as u64) * 2 * VP_NANO + (den as u64)) / ((den as u64) * 2);
    t.raw = (((n as u64) * (num as u64) * 2 + (den as u64)) / ((den as u64) * 2)) as u32;
    return vf_prop_clamp(t, pr);
}

; an accessibility floor beats the proportion: a value below it is raised and the reason recorded; the raw value stays.
; The parameter is min_px, not `floor`: t27b reads a bare `floor` as libm's @floor (libm_plan.t27 bare_target, #9065),
; splices libm.t27 into every module that imports this fn, and a host main's withdrawn std.c refusals then come back.
pub fn vf_prop_floor(t: VfToken, min_px: u32, reason: u32) -> VfToken {
    var r : VfToken = t;
    if r.status != VP_OK {
        return r;
    }
    if r.value < min_px {
        r.value = min_px;
        r.exc = reason;
    }
    return r;
}

; the factor in thousandths (milli-rem when n is 1 rem), half-up
pub fn vf_prop_milli(t: VfToken) -> u32 {
    return ((t.factor_nano + 500000) / 1000000) as u32;
}

; split a length n at phi^-1: major is rounded half-up, minor = n - major, so the parts sum exactly
pub fn vf_prop_split(n: u32) -> VfSplit {
    let pr : VfPropProfile = vf_prop_profile(VP_SPLIT);
    if n < pr.n_min {
        return VfSplit { n: n, major: 0, minor: 0, status: VP_REFUSED_N };
    }
    if n > pr.n_max {
        return VfSplit { n: n, major: 0, minor: 0, status: VP_REFUSED_N };
    }
    var major : u32 = (((n as u64) * vf_prop_phi_nano(0 - 2) + VP_HALF) / VP_NANO) as u32;
    return VfSplit { n: n, major: major, minor: n - major, status: VP_OK };
}

test vp_phi_nano_is_phi_rounded {
    // 2 phi - 1 = sqrt 5, so PHI_NANO is round(phi * 1e9) iff x = 2 PHI_NANO - 1e9 is within 1 of sqrt(5) * 1e9
    let x : u64 = 2 * VP_PHI_NANO - VP_NANO;
    let five : u64 = 5000000000000000000;
    assert (x - 1) * (x - 1) <= five;
    assert five <= (x + 1) * (x + 1);
    // negative control: one nano more is out
    let y : u64 = x + 2;
    assert (y - 1) * (y - 1) > five;
}

test vp_sqrt_phi_nano_is_rounded {
    // s is the nearest integer to sqrt(PHI_NANO * 1e9) iff s^2 - s < P <= s^2 + s
    let s : u64 = VP_SQRT_PHI_NANO;
    let p : u64 = VP_PHI_NANO * VP_NANO;
    assert s * s - s <= p;
    assert p <= s * s + s;
    // negative control: s + 1 is out
    let t : u64 = s + 1;
    assert t * t - t > p;
}

test vp_whole_powers_are_exact {
    // expected values typed here, not computed by the generator
    assert vf_prop_phi_nano(0 - 8) == 145898033;
    assert vf_prop_phi_nano(0 - 4) == 381966011;
    assert vf_prop_phi_nano(0 - 2) == 618033989;
    assert vf_prop_phi_nano(0) == 1000000000;
    assert vf_prop_phi_nano(2) == 1618033989;
    assert vf_prop_phi_nano(4) == 2618033989;
    assert vf_prop_phi_nano(6) == 4236067978;
    assert vf_prop_phi_nano(8) == 6854101967;
    // phi^2 = phi + 1, phi^-1 + phi^-2 = 1, phi^2 + phi^-2 = 3: exact in this representation
    assert vf_prop_phi_nano(4) == vf_prop_phi_nano(2) + VP_NANO;
    assert vf_prop_phi_nano(0 - 2) + vf_prop_phi_nano(0 - 4) == VP_NANO;
    assert vf_prop_phi_nano(4) + vf_prop_phi_nano(0 - 4) == 3 * VP_NANO;
    // out of range is 0, never a guess
    assert vf_prop_phi_nano(9) == 0;
    assert vf_prop_phi_nano(0 - 9) == 0;
}

test vp_half_powers {
    assert vf_prop_phi_nano(1) == 1272019650;
    assert vf_prop_phi_nano(3) == 2058171028;
    assert vf_prop_phi_nano(0 - 1) == 786151378;
}

test vp_reproduces_the_hand_type_table_with_provenance {
    // the hand table TH_FONT_REM of draft PR #13254 (milli-rem), its phi entries as generator tokens at n = 16
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 0, 0)) == 1000;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0)) == 1272;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 2, 0)) == 1618;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0)) == 2058;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 4, 0)) == 2618;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 6, 0)) == 4236;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 8, 0)) == 6854;
    // its three entries that are not phi powers, kept as declared ratios with an exception; 13/16 is 812.5, half-up 813
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 3, 4)) == 750;
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 13, 16)) == 813;
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 7, 8)) == 875;
    assert vf_prop_ratio(VP_TYPE, 16, 13, 16).exc == VP_EXC_RATIO;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0).exc == VP_EXC_NONE;
}

test vp_reproduces_the_hand_space_table {
    // TH_SPACE_REM of draft PR #13254, milli-rem
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 4, 0)) == 382;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 2, 0)) == 618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0)) == 1000;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 2, 0)) == 1618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 4, 0)) == 2618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0)) == 4236;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 8, 0)) == 6854;
}

test vp_px_at_one_rem {
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 4, 0).value == 6;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 2, 0).value == 10;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0).value == 16;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 2, 0).value == 26;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 4, 0).value == 42;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0).value == 68;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 8, 0).value == 110;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0).value == 20;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0).value == 33;
}

test vp_rounding_is_half_up_and_repeats {
    // exact .5 cases: 4.5 and 6.5 go up (half-even would give 4 and 6); 6.67 up, 6.33 down
    assert vf_prop_ratio(VP_SPACE, 9, 1, 2).value == 5;
    assert vf_prop_ratio(VP_SPACE, 13, 1, 2).value == 7;
    assert vf_prop_ratio(VP_SPACE, 20, 1, 3).value == 7;
    assert vf_prop_ratio(VP_SPACE, 19, 1, 3).value == 6;
    let a : VfToken = vf_prop_token(VP_TYPE, 15, 0, 0, 5, 0);
    let b : VfToken = vf_prop_token(VP_TYPE, 15, 0, 0, 5, 0);
    assert a.value == b.value;
    assert a.raw == b.raw;
    assert a.factor_nano == b.factor_nano;
    assert a.round_rule == VP_ROUND_HALF_UP;
}

test vp_refuses_outside_the_sets {
    // one step outside each axis, per profile; a refusal has value 0
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0).value == 0;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 10, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 6, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 9, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 0 - 3, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 1, 0, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 1, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 0, 1).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0 - 1, 0, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 7, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_SPACE, 33, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_TYPE, 11, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_MOTION, 16, 0, 0, 0, 0).status == VP_REFUSED_PROFILE;
    assert vf_prop_token(0, 16, 0, 0, 0, 0).status == VP_REFUSED_PROFILE;
    assert vf_prop_ratio(VP_SPACE, 16, 1, 0).status == VP_REFUSED_EXP;
}

test vp_edges_are_accepted {
    assert vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0).status == VP_OK;
    assert vf_prop_token(VP_SPACE, 32, 0, 0, 8, 0).status == VP_OK;
    assert vf_prop_token(VP_TYPE, 12, 0, 0, 0 - 2, 0).status == VP_OK;
    assert vf_prop_token(VP_TYPE, 20, 0, 0, 8, 0).status == VP_OK;
}

test vp_clamp_is_recorded {
    // 32 * phi^4 = 219.3: clamped to 128, the raw value kept
    let hi : VfToken = vf_prop_token(VP_SPACE, 32, 0, 0, 8, 0);
    assert hi.raw == 219;
    assert hi.value == 128;
    assert hi.clamp == VP_CLAMP_MAX;
    // 8 * phi^-2 = 3.06: raised to 4
    let lo : VfToken = vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0);
    assert lo.raw == 3;
    assert lo.value == 4;
    assert lo.clamp == VP_CLAMP_MIN;
    // 12 * phi^-1 = 7.4: type floor 10
    let ty : VfToken = vf_prop_token(VP_TYPE, 12, 0, 0, 0 - 2, 0);
    assert ty.raw == 7;
    assert ty.value == 10;
    assert ty.clamp == VP_CLAMP_MIN;
    // in range: no clamp flag
    let mid : VfToken = vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0);
    assert mid.value == mid.raw;
    assert mid.clamp == VP_CLAMP_NONE;
}

test vp_every_accepted_token_is_bounded {
    // the whole grid of both profiles, p2 one step past each end: every accepted token sits in [v_min, v_max]
    var ok : u32 = 0;
    var n : u32 = 8;
    while n <= 32 {
        var p2 : i32 = 0 - 6;
        while p2 <= 10 {
            let t : VfToken = vf_prop_token(VP_SPACE, n, 0, 0, p2, 0);
            if t.status == VP_OK {
                assert t.value >= 4;
                assert t.value <= 128;
                ok = ok + 1;
            }
            p2 = p2 + 1;
        }
        n = n + 1;
    }
    var nt : u32 = 12;
    while nt <= 20 {
        var pt : i32 = 0 - 4;
        while pt <= 10 {
            let u : VfToken = vf_prop_token(VP_TYPE, nt, 0, 0, pt, 0);
            if u.status == VP_OK {
                assert u.value >= 10;
                assert u.value <= 128;
                ok = ok + 1;
            }
            pt = pt + 1;
        }
        nt = nt + 1;
    }
    // 25 n x 7 even p2 for spacing, 9 n x 11 p2 for type: the loops were not shortened
    assert ok == 274;
}

test vp_accessibility_floor_beats_proportion {
    // a control height from the type scale (20 px) is raised to the 44 px touch minimum; the reason is recorded
    let h : VfToken = vf_prop_floor(vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0), VP_TOUCH_MIN_PX, VP_EXC_TOUCH_MIN);
    assert h.value == 44;
    assert h.raw == 20;
    assert h.exc == VP_EXC_TOUCH_MIN;
    // above the floor: nothing changes, no reason written
    let big : VfToken = vf_prop_floor(vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0), VP_TOUCH_MIN_PX, VP_EXC_TOUCH_MIN);
    assert big.value == 68;
    assert big.exc == VP_EXC_NONE;
    // the floor wins over a clamp, and both are recorded
    let c : VfToken = vf_prop_floor(vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0), VP_TARGET_MIN_PX, VP_EXC_TARGET_MIN);
    assert c.value == 24;
    assert c.clamp == VP_CLAMP_MIN;
    assert c.exc == VP_EXC_TARGET_MIN;
    // a refused token stays refused
    assert vf_prop_floor(vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0), 44, VP_EXC_TOUCH_MIN).value == 0;
}

test vp_split_sums_exactly {
    let a : VfSplit = vf_prop_split(100);
    assert a.major == 62;
    assert a.minor == 38;
    let b : VfSplit = vf_prop_split(101);
    assert b.major == 62;
    assert b.minor == 39;
    let c : VfSplit = vf_prop_split(1000);
    assert c.major == 618;
    assert c.minor == 382;
    let d : VfSplit = vf_prop_split(375);
    assert d.major == 232;
    assert d.minor == 143;
    assert d.major + d.minor == 375;
    assert vf_prop_split(0).status == VP_REFUSED_N;
    assert vf_prop_split(4097).status == VP_REFUSED_N;
}

test vp_provenance_is_recorded {
    let t : VfToken = vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0);
    assert t.status == VP_OK;
    assert t.n == 16;
    assert t.p2 == 3;
    assert t.k == 0;
    assert t.m == 0;
    assert t.q == 0;
    assert t.num == 1;
    assert t.den == 1;
    assert t.profile == VP_TYPE;
    assert t.round_rule == VP_ROUND_HALF_UP;
    assert t.factor_nano == 2058171028;
}
