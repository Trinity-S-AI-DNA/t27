// SPDX-License-Identifier: Apache-2.0
; T27F proportion tokens: a BOUNDED generator for design tokens, V = n * 3^k * pi^m * phi^p * e^q
; Refs Trinity-S-AI-DNA/t27#13251 (course v2 visual factory, proportion ring 1: generator and token sheet)
; --
; n is a base size in px; k, m, p, q come from small finite sets fixed per profile. A request outside its profile's set is
; refused (status, value 0), never computed and never silently clamped. A value outside the profile's [v_min, v_max] is
; clamped and the clamp is recorded with the raw value. Every token carries its provenance: n, k, m, p2 (p = p2 / 2), q, the
; ratio num/den when it is not a phi power, profile, rounding rule, clamp, exception reason, status.
; This slice has three profiles: spacing (whole phi powers), type (half phi powers, a phi^(1/2) modular scale) and split (the
; phi^-1 share of a length, minor = n - major so the parts sum exactly). The factors 3, pi and e have no profile yet: any
; non-zero k, m or q is refused. Motion (e) waits for a justified exponential model; pi waits for icons and circles.
; --
; Arithmetic is integer only, in nano units (1e9 = 1.0): phi^p for integer p is exact in Z[phi], phi^p = a + b phi with
; Fibonacci a, b, evaluated once with PHI_NANO; a half step multiplies by SQRT_PHI_NANO once. Rounding is half-up, once, at
; the px value: (n * factor_nano + 500000000) / 1000000000. No f64 on the token path, so t27b and t27c round the same way.
; PHI_NANO and SQRT_PHI_NANO are proven in the tests from 2 phi - 1 = sqrt 5 and s^2 ~ phi, not copied from an f64.
; --
; The golden ratio here is a chosen design language. It does not make a layout good: accessibility floors (vf_prop_floor)
; and measured text fit (vf_text_measure) override proportions, and the token sheet is not a quality score.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module VfProportion;


pub const VP_NANO : u64 = 1000000000;
pub const VP_HALF : u64 = 500000000;
; round(phi * 1e9) and round(sqrt(phi) * 1e9); the tests vp_phi_nano_is_phi_rounded and vp_sqrt_phi_nano_is_rounded prove both
pub const VP_PHI_NANO : u64 = 1618033989;
pub const VP_SQRT_PHI_NANO : u64 = 1272019650;
; 1 rem
pub const VP_REM_PX : u32 = 16;

; profiles
pub const VP_SPACE : u32 = 1;
pub const VP_TYPE : u32 = 2;
pub const VP_SPLIT : u32 = 3;
pub const VP_MOTION : u32 = 4;

; status
pub const VP_OK : u32 = 0;
pub const VP_REFUSED_EXP : u32 = 1;
pub const VP_REFUSED_N : u32 = 2;
pub const VP_REFUSED_PROFILE : u32 = 3;

; clamp
pub const VP_CLAMP_NONE : u32 = 0;
pub const VP_CLAMP_MIN : u32 = 1;
pub const VP_CLAMP_MAX : u32 = 2;

; rounding rule
pub const VP_ROUND_HALF_UP : u32 = 1;

; exception reasons, a closed set
pub const VP_EXC_NONE : u32 = 0;
; 44 px touch minimum, specs/ui/viewport.t27
pub const VP_EXC_TOUCH_MIN : u32 = 1;
; 24 px target minimum, WCAG 2.2 SC 2.5.8
pub const VP_EXC_TARGET_MIN : u32 = 2;
; a declared ratio num/den that is not a phi power
pub const VP_EXC_RATIO : u32 = 3;

pub const VP_TOUCH_MIN_PX : u32 = 44;
pub const VP_TARGET_MIN_PX : u32 = 24;

; one profile: the n range, the p2 range (p = p2 / 2), whether p2 must be even, the value range in px
pub struct VfPropProfile {
    id: u32,
    n_min: u32,
    n_max: u32,
    p2_min: i32,
    p2_max: i32,
    p2_even: u32,
    v_min: u32,
    v_max: u32,
}

; one token and its provenance; value 0 with a non-zero status is a refusal
pub struct VfToken {
    value: u32,
    raw: u32,
    factor_nano: u64,
    n: u32,
    k: i32,
    m: i32,
    p2: i32,
    q: i32,
    num: u32,
    den: u32,
    profile: u32,
    round_rule: u32,
    clamp: u32,
    exc: u32,
    status: u32,
}

; a length split at phi^-1: major + minor == n
pub struct VfSplit {
    n: u32,
    major: u32,
    minor: u32,
    status: u32,
}

; the profile table; an unknown id (motion included, for now) gives id 0
pub fn vf_prop_profile(id: u32) -> VfPropProfile {
    if id == VP_SPACE {
        return VfPropProfile { id: VP_SPACE, n_min: 8, n_max: 32, p2_min: 0 - 4, p2_max: 8, p2_even: 1, v_min: 4, v_max: 128 };
    }
    if id == VP_TYPE {
        return VfPropProfile { id: VP_TYPE, n_min: 12, n_max: 20, p2_min: 0 - 2, p2_max: 8, p2_even: 0, v_min: 10, v_max: 128 };
    }
    if id == VP_SPLIT {
        return VfPropProfile { id: VP_SPLIT, n_min: 1, n_max: 4096, p2_min: 0 - 2, p2_max: 0 - 2, p2_even: 1, v_min: 1, v_max: 4096 };
    }
    return VfPropProfile { id: 0, n_min: 0, n_max: 0, p2_min: 0, p2_max: 0, p2_even: 0, v_min: 0, v_max: 0 };
}

; Fibonacci F(n), F(0) = 0, F(1) = 1
pub fn vf_prop_fib(n: u32) -> u64 {
    var a : u64 = 0;
    var b : u64 = 1;
    var i : u32 = 0;
    while i < n {
        var c : u64 = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return a;
}

; phi^p in nano for whole p in [-4, 4]: phi^p = F(p-1) + F(p) phi for p >= 1; phi^-j = (-1)^j (F(j+1) - F(j) phi)
pub fn vf_prop_phi_whole_nano(p: i32) -> u64 {
    if p == 0 {
        return VP_NANO;
    }
    if p > 0 {
        var up : u32 = p as u32;
        return vf_prop_fib(up - 1) * VP_NANO + vf_prop_fib(up) * VP_PHI_NANO;
    }
    var j : u32 = (0 - p) as u32;
    var f1 : u64 = vf_prop_fib(j + 1) * VP_NANO;
    var f0 : u64 = vf_prop_fib(j) * VP_PHI_NANO;
    if j % 2 == 0 {
        return f1 - f0;
    }
    return f0 - f1;
}

; phi^(p2 / 2) in nano for p2 in [-8, 8]; an odd p2 multiplies the whole step below it by sqrt(phi) once; 0 outside the range
pub fn vf_prop_phi_nano(p2: i32) -> u64 {
    if p2 < 0 - 8 {
        return 0;
    }
    if p2 > 8 {
        return 0;
    }
    var u : u32 = (p2 + 16) as u32;
    var whole : i32 = ((u / 2) as i32) - 8;
    var base : u64 = vf_prop_phi_whole_nano(whole);
    if u % 2 == 1 {
        return (base * VP_SQRT_PHI_NANO + VP_HALF) / VP_NANO;
    }
    return base;
}

; clamp t.raw into the profile's value range and record it
fn vf_prop_clamp(t: VfToken, pr: VfPropProfile) -> VfToken {
    var r : VfToken = t;
    r.value = r.raw;
    if r.raw < pr.v_min {
        r.value = pr.v_min;
        r.clamp = VP_CLAMP_MIN;
    }
    if r.raw > pr.v_max {
        r.value = pr.v_max;
        r.clamp = VP_CLAMP_MAX;
    }
    return r;
}

fn vf_prop_blank(profile: u32, n: u32, k: i32, m: i32, p2: i32, q: i32) -> VfToken {
    return VfToken { value: 0, raw: 0, factor_nano: 0, n: n, k: k, m: m, p2: p2, q: q, num: 1, den: 1, profile: profile, round_rule: VP_ROUND_HALF_UP, clamp: VP_CLAMP_NONE, exc: VP_EXC_NONE, status: VP_OK };
}

; the generator: V = n * 3^k * pi^m * phi^(p2/2) * e^q, inside the profile's sets, rounded half-up once, clamped and recorded
pub fn vf_prop_token(profile: u32, n: u32, k: i32, m: i32, p2: i32, q: i32) -> VfToken {
    var t : VfToken = vf_prop_blank(profile, n, k, m, p2, q);
    let pr : VfPropProfile = vf_prop_profile(profile);
    if pr.id == 0 {
        t.status = VP_REFUSED_PROFILE;
        return t;
    }
    if k != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if m != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if q != 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if p2 < pr.p2_min {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if p2 > pr.p2_max {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if pr.p2_even == 1 {
        if ((p2 + 16) as u32) % 2 == 1 {
            t.status = VP_REFUSED_EXP;
            return t;
        }
    }
    if n < pr.n_min {
        t.status = VP_REFUSED_N;
        return t;
    }
    if n > pr.n_max {
        t.status = VP_REFUSED_N;
        return t;
    }
    t.factor_nano = vf_prop_phi_nano(p2);
    t.raw = (((n as u64) * t.factor_nano + VP_HALF) / VP_NANO) as u32;
    return vf_prop_clamp(t, pr);
}

; a declared ratio num/den that is not a phi power (a kept hand-table entry); recorded as an exception, same rounding and clamp
pub fn vf_prop_ratio(profile: u32, n: u32, num: u32, den: u32) -> VfToken {
    var t : VfToken = vf_prop_blank(profile, n, 0, 0, 0, 0);
    let pr : VfPropProfile = vf_prop_profile(profile);
    if pr.id == 0 {
        t.status = VP_REFUSED_PROFILE;
        return t;
    }
    if den == 0 {
        t.status = VP_REFUSED_EXP;
        return t;
    }
    if n < pr.n_min {
        t.status = VP_REFUSED_N;
        return t;
    }
    if n > pr.n_max {
        t.status = VP_REFUSED_N;
        return t;
    }
    t.num = num;
    t.den = den;
    t.exc = VP_EXC_RATIO;
    t.factor_nano = ((num as u64) * 2 * VP_NANO + (den as u64)) / ((den as u64) * 2);
    t.raw = (((n as u64) * (num as u64) * 2 + (den as u64)) / ((den as u64) * 2)) as u32;
    return vf_prop_clamp(t, pr);
}

; an accessibility floor beats the proportion: a value below it is raised and the reason recorded; the raw value stays.
; The parameter is min_px, not `floor`: t27b reads a bare `floor` as libm's @floor (libm_plan.t27 bare_target, #9065),
; splices libm.t27 into every module that imports this fn, and a host main's withdrawn std.c refusals then come back.
pub fn vf_prop_floor(t: VfToken, min_px: u32, reason: u32) -> VfToken {
    var r : VfToken = t;
    if r.status != VP_OK {
        return r;
    }
    if r.value < min_px {
        r.value = min_px;
        r.exc = reason;
    }
    return r;
}

; the factor in thousandths (milli-rem when n is 1 rem), half-up
pub fn vf_prop_milli(t: VfToken) -> u32 {
    return ((t.factor_nano + 500000) / 1000000) as u32;
}

; split a length n at phi^-1: major is rounded half-up, minor = n - major, so the parts sum exactly
pub fn vf_prop_split(n: u32) -> VfSplit {
    let pr : VfPropProfile = vf_prop_profile(VP_SPLIT);
    if n < pr.n_min {
        return VfSplit { n: n, major: 0, minor: 0, status: VP_REFUSED_N };
    }
    if n > pr.n_max {
        return VfSplit { n: n, major: 0, minor: 0, status: VP_REFUSED_N };
    }
    var major : u32 = (((n as u64) * vf_prop_phi_nano(0 - 2) + VP_HALF) / VP_NANO) as u32;
    return VfSplit { n: n, major: major, minor: n - major, status: VP_OK };
}

test vp_phi_nano_is_phi_rounded {
    // 2 phi - 1 = sqrt 5, so PHI_NANO is round(phi * 1e9) iff x = 2 PHI_NANO - 1e9 is within 1 of sqrt(5) * 1e9
    let x : u64 = 2 * VP_PHI_NANO - VP_NANO;
    let five : u64 = 5000000000000000000;
    assert (x - 1) * (x - 1) <= five;
    assert five <= (x + 1) * (x + 1);
    // negative control: one nano more is out
    let y : u64 = x + 2;
    assert (y - 1) * (y - 1) > five;
}

test vp_sqrt_phi_nano_is_rounded {
    // s is the nearest integer to sqrt(PHI_NANO * 1e9) iff s^2 - s < P <= s^2 + s
    let s : u64 = VP_SQRT_PHI_NANO;
    let p : u64 = VP_PHI_NANO * VP_NANO;
    assert s * s - s <= p;
    assert p <= s * s + s;
    // negative control: s + 1 is out
    let t : u64 = s + 1;
    assert t * t - t > p;
}

test vp_whole_powers_are_exact {
    // expected values typed here, not computed by the generator
    assert vf_prop_phi_nano(0 - 8) == 145898033;
    assert vf_prop_phi_nano(0 - 4) == 381966011;
    assert vf_prop_phi_nano(0 - 2) == 618033989;
    assert vf_prop_phi_nano(0) == 1000000000;
    assert vf_prop_phi_nano(2) == 1618033989;
    assert vf_prop_phi_nano(4) == 2618033989;
    assert vf_prop_phi_nano(6) == 4236067978;
    assert vf_prop_phi_nano(8) == 6854101967;
    // phi^2 = phi + 1, phi^-1 + phi^-2 = 1, phi^2 + phi^-2 = 3: exact in this representation
    assert vf_prop_phi_nano(4) == vf_prop_phi_nano(2) + VP_NANO;
    assert vf_prop_phi_nano(0 - 2) + vf_prop_phi_nano(0 - 4) == VP_NANO;
    assert vf_prop_phi_nano(4) + vf_prop_phi_nano(0 - 4) == 3 * VP_NANO;
    // out of range is 0, never a guess
    assert vf_prop_phi_nano(9) == 0;
    assert vf_prop_phi_nano(0 - 9) == 0;
}

test vp_half_powers {
    assert vf_prop_phi_nano(1) == 1272019650;
    assert vf_prop_phi_nano(3) == 2058171028;
    assert vf_prop_phi_nano(0 - 1) == 786151378;
}

test vp_reproduces_the_hand_type_table_with_provenance {
    // the hand table TH_FONT_REM of draft PR #13254 (milli-rem), its phi entries as generator tokens at n = 16
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 0, 0)) == 1000;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0)) == 1272;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 2, 0)) == 1618;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0)) == 2058;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 4, 0)) == 2618;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 6, 0)) == 4236;
    assert vf_prop_milli(vf_prop_token(VP_TYPE, 16, 0, 0, 8, 0)) == 6854;
    // its three entries that are not phi powers, kept as declared ratios with an exception; 13/16 is 812.5, half-up 813
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 3, 4)) == 750;
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 13, 16)) == 813;
    assert vf_prop_milli(vf_prop_ratio(VP_TYPE, 16, 7, 8)) == 875;
    assert vf_prop_ratio(VP_TYPE, 16, 13, 16).exc == VP_EXC_RATIO;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0).exc == VP_EXC_NONE;
}

test vp_reproduces_the_hand_space_table {
    // TH_SPACE_REM of draft PR #13254, milli-rem
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 4, 0)) == 382;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 2, 0)) == 618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0)) == 1000;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 2, 0)) == 1618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 4, 0)) == 2618;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0)) == 4236;
    assert vf_prop_milli(vf_prop_token(VP_SPACE, 16, 0, 0, 8, 0)) == 6854;
}

test vp_px_at_one_rem {
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 4, 0).value == 6;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 2, 0).value == 10;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0).value == 16;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 2, 0).value == 26;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 4, 0).value == 42;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0).value == 68;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 8, 0).value == 110;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0).value == 20;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0).value == 33;
}

test vp_rounding_is_half_up_and_repeats {
    // exact .5 cases: 4.5 and 6.5 go up (half-even would give 4 and 6); 6.67 up, 6.33 down
    assert vf_prop_ratio(VP_SPACE, 9, 1, 2).value == 5;
    assert vf_prop_ratio(VP_SPACE, 13, 1, 2).value == 7;
    assert vf_prop_ratio(VP_SPACE, 20, 1, 3).value == 7;
    assert vf_prop_ratio(VP_SPACE, 19, 1, 3).value == 6;
    let a : VfToken = vf_prop_token(VP_TYPE, 15, 0, 0, 5, 0);
    let b : VfToken = vf_prop_token(VP_TYPE, 15, 0, 0, 5, 0);
    assert a.value == b.value;
    assert a.raw == b.raw;
    assert a.factor_nano == b.factor_nano;
    assert a.round_rule == VP_ROUND_HALF_UP;
}

test vp_refuses_outside_the_sets {
    // one step outside each axis, per profile; a refusal has value 0
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0).value == 0;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 10, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0, 0, 0 - 6, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 9, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 0 - 3, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 1, 0, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 1, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_TYPE, 16, 0, 0, 0, 1).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 16, 0 - 1, 0, 0, 0).status == VP_REFUSED_EXP;
    assert vf_prop_token(VP_SPACE, 7, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_SPACE, 33, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_TYPE, 11, 0, 0, 0, 0).status == VP_REFUSED_N;
    assert vf_prop_token(VP_MOTION, 16, 0, 0, 0, 0).status == VP_REFUSED_PROFILE;
    assert vf_prop_token(0, 16, 0, 0, 0, 0).status == VP_REFUSED_PROFILE;
    assert vf_prop_ratio(VP_SPACE, 16, 1, 0).status == VP_REFUSED_EXP;
}

test vp_edges_are_accepted {
    assert vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0).status == VP_OK;
    assert vf_prop_token(VP_SPACE, 32, 0, 0, 8, 0).status == VP_OK;
    assert vf_prop_token(VP_TYPE, 12, 0, 0, 0 - 2, 0).status == VP_OK;
    assert vf_prop_token(VP_TYPE, 20, 0, 0, 8, 0).status == VP_OK;
}

test vp_clamp_is_recorded {
    // 32 * phi^4 = 219.3: clamped to 128, the raw value kept
    let hi : VfToken = vf_prop_token(VP_SPACE, 32, 0, 0, 8, 0);
    assert hi.raw == 219;
    assert hi.value == 128;
    assert hi.clamp == VP_CLAMP_MAX;
    // 8 * phi^-2 = 3.06: raised to 4
    let lo : VfToken = vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0);
    assert lo.raw == 3;
    assert lo.value == 4;
    assert lo.clamp == VP_CLAMP_MIN;
    // 12 * phi^-1 = 7.4: type floor 10
    let ty : VfToken = vf_prop_token(VP_TYPE, 12, 0, 0, 0 - 2, 0);
    assert ty.raw == 7;
    assert ty.value == 10;
    assert ty.clamp == VP_CLAMP_MIN;
    // in range: no clamp flag
    let mid : VfToken = vf_prop_token(VP_SPACE, 16, 0, 0, 0, 0);
    assert mid.value == mid.raw;
    assert mid.clamp == VP_CLAMP_NONE;
}

test vp_every_accepted_token_is_bounded {
    // the whole grid of both profiles, p2 one step past each end: every accepted token sits in [v_min, v_max]
    var ok : u32 = 0;
    var n : u32 = 8;
    while n <= 32 {
        var p2 : i32 = 0 - 6;
        while p2 <= 10 {
            let t : VfToken = vf_prop_token(VP_SPACE, n, 0, 0, p2, 0);
            if t.status == VP_OK {
                assert t.value >= 4;
                assert t.value <= 128;
                ok = ok + 1;
            }
            p2 = p2 + 1;
        }
        n = n + 1;
    }
    var nt : u32 = 12;
    while nt <= 20 {
        var pt : i32 = 0 - 4;
        while pt <= 10 {
            let u : VfToken = vf_prop_token(VP_TYPE, nt, 0, 0, pt, 0);
            if u.status == VP_OK {
                assert u.value >= 10;
                assert u.value <= 128;
                ok = ok + 1;
            }
            pt = pt + 1;
        }
        nt = nt + 1;
    }
    // 25 n x 7 even p2 for spacing, 9 n x 11 p2 for type: the loops were not shortened
    assert ok == 274;
}

test vp_accessibility_floor_beats_proportion {
    // a control height from the type scale (20 px) is raised to the 44 px touch minimum; the reason is recorded
    let h : VfToken = vf_prop_floor(vf_prop_token(VP_TYPE, 16, 0, 0, 1, 0), VP_TOUCH_MIN_PX, VP_EXC_TOUCH_MIN);
    assert h.value == 44;
    assert h.raw == 20;
    assert h.exc == VP_EXC_TOUCH_MIN;
    // above the floor: nothing changes, no reason written
    let big : VfToken = vf_prop_floor(vf_prop_token(VP_SPACE, 16, 0, 0, 6, 0), VP_TOUCH_MIN_PX, VP_EXC_TOUCH_MIN);
    assert big.value == 68;
    assert big.exc == VP_EXC_NONE;
    // the floor wins over a clamp, and both are recorded
    let c : VfToken = vf_prop_floor(vf_prop_token(VP_SPACE, 8, 0, 0, 0 - 4, 0), VP_TARGET_MIN_PX, VP_EXC_TARGET_MIN);
    assert c.value == 24;
    assert c.clamp == VP_CLAMP_MIN;
    assert c.exc == VP_EXC_TARGET_MIN;
    // a refused token stays refused
    assert vf_prop_floor(vf_prop_token(VP_SPACE, 16, 0, 0, 1, 0), 44, VP_EXC_TOUCH_MIN).value == 0;
}

test vp_split_sums_exactly {
    let a : VfSplit = vf_prop_split(100);
    assert a.major == 62;
    assert a.minor == 38;
    let b : VfSplit = vf_prop_split(101);
    assert b.major == 62;
    assert b.minor == 39;
    let c : VfSplit = vf_prop_split(1000);
    assert c.major == 618;
    assert c.minor == 382;
    let d : VfSplit = vf_prop_split(375);
    assert d.major == 232;
    assert d.minor == 143;
    assert d.major + d.minor == 375;
    assert vf_prop_split(0).status == VP_REFUSED_N;
    assert vf_prop_split(4097).status == VP_REFUSED_N;
}

test vp_provenance_is_recorded {
    let t : VfToken = vf_prop_token(VP_TYPE, 16, 0, 0, 3, 0);
    assert t.status == VP_OK;
    assert t.n == 16;
    assert t.p2 == 3;
    assert t.k == 0;
    assert t.m == 0;
    assert t.q == 0;
    assert t.num == 1;
    assert t.den == 1;
    assert t.profile == VP_TYPE;
    assert t.round_rule == VP_ROUND_HALF_UP;
    assert t.factor_nano == 2058171028;
}

; ==== T27F-007 part (Refs gHashTag/t27#13214), merged with the course v2 part above ====
; T27F-007 Design Tokens v0.1, part 1: vf_proportion is a bounded generator of golden proportions in integer fixed point (ppm = 1e-6)
; Refs gHashTag/t27#13214
; The formula is V = n * 3^k * pi^m * phi^p * e^q, but this module is NOT a free formula evaluator
; A profile fixes n, k, m and q and lists the finite set of p it allows: k, m and q are 0 for every profile, so V = n * phi^p, and any other p is refused
; The exponent p is rational with denominator 1 or 2, so it is stored as the half-step count h2 = 2p, and h2 is kept non-negative by a bias of 8
;   the stored value is x = 2p + 8, so p = -2 is x = 4, p = -0.5 is x = 7, p = 0 is x = 8, p = 0.5 is x = 9, p = 5 is x = 18; the bias is even, so x has the parity of 2p
;   the denominator of p in lowest terms is 1 when x is even and 2 when x is odd (vp_den), and vp_h2_from_ratio reduces a numerator over a denominator first
; Processing order of vp_gen: validate (profile, enabled, exponent), raw value in ppm, raw range, quantize, quantized range
; Rounding is nearest, half up: floor(value / quantum + 0.5) * quantum, in integers, with no float
; Silent clamping is forbidden: a value outside the range is a refusal with a status code and the value 0, it is never moved to the nearest edge
; The raw window is the profile range widened by one quantum on each side, because rounding can bring a raw value back inside; the final value must sit inside lo..hi exactly
; Units: a lu or ms profile has raw_ppm = value * 1e6 and value in lu or ms; the ratio profile has value = raw_ppm, a ratio in ppm
; The phi table is typed by hand and decided by tests that do not read it: exact Fibonacci sums, the phi^2 step, and the half-step squared
; Hand value changed on 2026-11-07: phi^4.5 is 8.71855238, so 8718552 and not 8718553 (the integer sums above and below it round the other way by 1 ppm, which the tests allow)
; NOT claimed: no free exponent, no pi, e or 3 terms, no negative values, no tolerance in the manifest (the manifest numbers are exact integers)
; NOT claimed: the bounds of the profiles are design choices of Design Tokens v0.1, this module does not derive them
; Limits: all arithmetic is u32 except products that can pass 2^32, which are u64; compare before subtracting; an unknown profile or exponent is refused, never passed
; Merge note (2026-11-08): this part and the course v2 part above were written apart under one file name; both stay, each at the path its
;   consumers import. VP_OK (0) is shared with the part above. This part's type profile was VP_TYPE (1) and is VP_TYPOGRAPHY, because VP_TYPE
;   above is 2. The two generators answer the same question and are not unified yet: unifying them is a follow-up, not this merge.

; status codes (VP_OK = 0 is above)
pub const VP_BAD_PROFILE : u32 = 1;
pub const VP_BAD_EXPONENT : u32 = 2;
pub const VP_RAW_RANGE : u32 = 3;
pub const VP_QUANT_RANGE : u32 = 4;
pub const VP_DISABLED : u32 = 5;

; profile ids
pub const VP_SPACING : u32 = 0;
pub const VP_TYPOGRAPHY : u32 = 1;
pub const VP_COMPOSITION : u32 = 2;
pub const VP_DURATION : u32 = 3;
pub const VP_EXPERIMENTAL : u32 = 4;
pub const VP_PROFILES : u32 = 5;

; units of a profile value
pub const VP_UNIT_LU : u32 = 0;
pub const VP_UNIT_MS : u32 = 1;
pub const VP_UNIT_RATIO_PPM : u32 = 2;

pub const VP_PPM : u32 = 1000000;
pub const VP_CAP : u32 = 4000000000;
pub const VP_NO_EXP : u32 = 4294967295;
pub const VP_RATIO_MAX : u32 = 1000;

; the stored exponent x = 2p + VP_BIAS, the table covers p = -2 .. 5 in half steps
pub const VP_BIAS : u32 = 8;
pub const VP_X_LO : u32 = 4;
pub const VP_X_HI : u32 = 18;
pub const VP_TABLE_LEN : u32 = 15;

; the named exponents: M is minus, H is a half, so M0H is -0.5, 0H is +0.5 and 2H is 2.5
pub const VP_P_M2 : u32 = 4;
pub const VP_P_M1H : u32 = 5;
pub const VP_P_M1 : u32 = 6;
pub const VP_P_M0H : u32 = 7;
pub const VP_P_0 : u32 = 8;
pub const VP_P_0H : u32 = 9;
pub const VP_P_1 : u32 = 10;
pub const VP_P_1H : u32 = 11;
pub const VP_P_2 : u32 = 12;
pub const VP_P_2H : u32 = 13;
pub const VP_P_3 : u32 = 14;
pub const VP_P_3H : u32 = 15;
pub const VP_P_4 : u32 = 16;
pub const VP_P_4H : u32 = 17;
pub const VP_P_5 : u32 = 18;

; phi^(p) in ppm for x = 4 .. 18, index x - 4
pub const VP_PHI_PPM : [15]u32 = [381966, 485868, 618034, 786151, 1000000, 1272020, 1618034, 2058171, 2618034, 3330191, 4236068, 5388362, 6854102, 8718552, 11090170];

; the profile table, index = profile id: base n, unit, quantum (0 = none), range lo..hi in value units, enabled
pub const VP_N : [5]u32 = [4, 16, 1, 100, 1];
pub const VP_UNIT : [5]u32 = [0, 0, 2, 1, 0];
pub const VP_QUANTUM : [5]u32 = [2, 1, 0, 10, 0];
pub const VP_LO : [5]u32 = [4, 12, 300000, 100, 0];
pub const VP_HI : [5]u32 = [48, 48, 1700000, 500, 0];
pub const VP_ENABLED : [5]u32 = [1, 1, 1, 1, 0];

; the allowed exponents per profile, in ascending order, as one flat list with a start offset and a count per profile
pub const VP_ALLOW_COUNT : [5]u32 = [6, 6, 4, 4, 0];
pub const VP_ALLOW_START : [5]u32 = [0, 6, 12, 16, 20];
pub const VP_ALLOW_TOTAL : u32 = 20;
pub const VP_ALLOW : [20]u32 = [8, 10, 12, 14, 16, 18, 7, 8, 9, 10, 11, 12, 4, 6, 8, 10, 8, 10, 12, 14];

pub struct VpProfile {
    id: u32,
    n: u32,
    unit: u32,
    quantum: u32,
    lo: u32,
    hi: u32,
    k3: u32,
    mpi: u32,
    qe: u32,
    enabled: u32,
    allow_count: u32,
}

pub struct VpValue {
    status: u32,
    profile: u32,
    h2: u32,
    raw_ppm: u32,
    quantum: u32,
    value: u32,
}

; a profile record: k3, mpi and qe are the exponents of 3, pi and e and are 0 for every profile; an unknown id has no id, no range and is not enabled
pub fn vp_profile(id: u32) -> VpProfile {
    if id >= VP_PROFILES {
        var blank : VpProfile = VpProfile {
            id: VP_NO_EXP,
            n: 0,
            unit: 0,
            quantum: 0,
            lo: 0,
            hi: 0,
            k3: 0,
            mpi: 0,
            qe: 0,
            enabled: 0,
            allow_count: 0,
        };
        return blank;
    }
    var p : VpProfile = VpProfile {
        id: id,
        n: VP_N[id],
        unit: VP_UNIT[id],
        quantum: VP_QUANTUM[id],
        lo: VP_LO[id],
        hi: VP_HI[id],
        k3: 0,
        mpi: 0,
        qe: 0,
        enabled: VP_ENABLED[id],
        allow_count: VP_ALLOW_COUNT[id],
    };
    return p;
}

; phi^p in ppm for the stored exponent x, 0 when x is outside the table
pub fn vp_phi_ppm(h2: u32) -> u32 {
    if h2 < VP_X_LO {
        return 0;
    }
    if h2 > VP_X_HI {
        return 0;
    }
    return VP_PHI_PPM[h2 - VP_X_LO];
}

; the denominator of p in lowest terms: 1 for a whole p, 2 for a half
pub fn vp_den(h2: u32) -> u32 {
    if h2 % 2 == 0 {
        return 1;
    }
    return 2;
}

fn vp_gcd(a: u32, b: u32) -> u32 {
    var x : u32 = a;
    var y : u32 = b;
    while y != 0 {
        var t : u32 = x % y;
        x = y;
        y = t;
    }
    return x;
}

; the stored exponent of the fraction num/den (negative when neg), reduced to lowest terms first; VP_NO_EXP when the reduced denominator is not 1 or 2 or the exponent is outside the table
pub fn vp_h2_from_ratio(neg: bool, num: u32, den: u32) -> u32 {
    if den == 0 {
        return VP_NO_EXP;
    }
    if den > VP_RATIO_MAX {
        return VP_NO_EXP;
    }
    if num > VP_RATIO_MAX {
        return VP_NO_EXP;
    }
    var g : u32 = vp_gcd(num, den);
    var n1 : u32 = num / g;
    var d1 : u32 = den / g;
    if d1 > 2 {
        return VP_NO_EXP;
    }
    var steps : u32 = n1 * 2 / d1;
    if neg == true {
        if steps > VP_BIAS - VP_X_LO {
            return VP_NO_EXP;
        }
        return VP_BIAS - steps;
    }
    if steps > VP_X_HI - VP_BIAS {
        return VP_NO_EXP;
    }
    return VP_BIAS + steps;
}

pub fn vp_allow_count(profile: u32) -> u32 {
    if profile >= VP_PROFILES {
        return 0;
    }
    return VP_ALLOW_COUNT[profile];
}

; the i-th allowed exponent of a profile, VP_NO_EXP past the end
pub fn vp_allow_at(profile: u32, i: u32) -> u32 {
    if profile >= VP_PROFILES {
        return VP_NO_EXP;
    }
    if i >= VP_ALLOW_COUNT[profile] {
        return VP_NO_EXP;
    }
    return VP_ALLOW[VP_ALLOW_START[profile] + i];
}

pub fn vp_exp_ok(profile: u32, h2: u32) -> bool {
    var n : u32 = vp_allow_count(profile);
    var i : u32 = 0;
    while i < n {
        if vp_allow_at(profile, i) == h2 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

; nearest, half up: floor(raw / (quantum * 1e6) + 0.5) * quantum; quantum 0 means no quantization and returns raw_ppm
pub fn vp_round_half_up(raw_ppm: u32, quantum: u32) -> u32 {
    if quantum == 0 {
        return raw_ppm;
    }
    var q : u64 = quantum as u64;
    var num : u64 = (raw_ppm as u64) + q * 500000;
    var units : u64 = num / (q * 1000000);
    var out : u64 = units * q;
    return out as u32;
}

; a product of two u32 that saturates at VP_CAP, so a range check can never be fooled by a wrap
fn vp_mul_cap(a: u32, b: u32) -> u32 {
    var r : u64 = (a as u64) * (b as u64);
    if r > (VP_CAP as u64) {
        return VP_CAP;
    }
    return r as u32;
}

; ppm per value unit: a ratio profile already holds ppm, a lu or ms profile holds whole units
fn vp_scale(unit: u32) -> u32 {
    if unit == VP_UNIT_RATIO_PPM {
        return 1;
    }
    return VP_PPM;
}

fn vp_raw_lo(p: VpProfile) -> u32 {
    var s : u32 = vp_scale(p.unit);
    var lo : u32 = vp_mul_cap(p.lo, s);
    var slack : u32 = vp_mul_cap(p.quantum, s);
    if lo > slack {
        return lo - slack;
    }
    return 0;
}

fn vp_raw_hi(p: VpProfile) -> u32 {
    var s : u32 = vp_scale(p.unit);
    var hi : u32 = vp_mul_cap(p.hi, s);
    var slack : u32 = vp_mul_cap(p.quantum, s);
    if hi > VP_CAP - slack {
        return VP_CAP;
    }
    return hi + slack;
}

fn vp_blank(profile: u32, h2: u32, status: u32) -> VpValue {
    var q : u32 = 0;
    if profile < VP_PROFILES {
        q = VP_QUANTUM[profile];
    }
    var r : VpValue = VpValue {
        status: status,
        profile: profile,
        h2: h2,
        raw_ppm: 0,
        quantum: q,
        value: 0,
    };
    return r;
}

; stages 3 to 5 of vp_gen on a given raw value: raw range, quantize, quantized range
; it does NOT check the exponent, so a caller outside vp_gen must never use it to mint a token; it exists so a test can feed a raw value the exponent gate would never let through
pub fn vp_check_raw(profile: u32, h2: u32, raw_ppm: u32) -> VpValue {
    if profile >= VP_PROFILES {
        return vp_blank(profile, h2, VP_BAD_PROFILE);
    }
    var p : VpProfile = vp_profile(profile);
    if p.enabled == 0 {
        return vp_blank(profile, h2, VP_DISABLED);
    }
    var r : VpValue = vp_blank(profile, h2, VP_OK);
    r.raw_ppm = raw_ppm;
    if raw_ppm < vp_raw_lo(p) {
        r.status = VP_RAW_RANGE;
        return r;
    }
    if raw_ppm > vp_raw_hi(p) {
        r.status = VP_RAW_RANGE;
        return r;
    }
    var v : u32 = vp_round_half_up(raw_ppm, p.quantum);
    if v < p.lo {
        r.status = VP_QUANT_RANGE;
        return r;
    }
    if v > p.hi {
        r.status = VP_QUANT_RANGE;
        return r;
    }
    r.value = v;
    return r;
}

; the generator: validate, then raw = n * phi^p in ppm, then vp_check_raw
pub fn vp_gen(profile: u32, h2: u32) -> VpValue {
    if profile >= VP_PROFILES {
        return vp_blank(profile, h2, VP_BAD_PROFILE);
    }
    var p : VpProfile = vp_profile(profile);
    if p.enabled == 0 {
        return vp_blank(profile, h2, VP_DISABLED);
    }
    if vp_exp_ok(profile, h2) == false {
        return vp_blank(profile, h2, VP_BAD_EXPONENT);
    }
    var raw : u32 = vp_mul_cap(p.n, vp_phi_ppm(h2));
    return vp_check_raw(profile, h2, raw);
}

pub fn vp_value(profile: u32, h2: u32) -> u32 {
    var v : VpValue = vp_gen(profile, h2);
    return v.value;
}

pub fn vp_status(profile: u32, h2: u32) -> u32 {
    var v : VpValue = vp_gen(profile, h2);
    return v.status;
}

pub fn vp_same(a: VpValue, b: VpValue) -> bool {
    if a.status != b.status {
        return false;
    }
    if a.profile != b.profile {
        return false;
    }
    if a.h2 != b.h2 {
        return false;
    }
    if a.raw_ppm != b.raw_ppm {
        return false;
    }
    if a.quantum != b.quantum {
        return false;
    }
    if a.value != b.value {
        return false;
    }
    return true;
}

; is |a * b - c * 1e6| at most tol, all in ppm squared units: a and b are ppm values and c is their product in ppm
pub fn vp_near_product(a: u32, b: u32, c: u32, tol: u32) -> bool {
    var lhs : u64 = (a as u64) * (b as u64);
    var rhs : u64 = (c as u64) * 1000000;
    var d : u64 = 0;
    if lhs >= rhs {
        d = lhs - rhs;
    } else {
        d = rhs - lhs;
    }
    if d <= (tol as u64) {
        return true;
    }
    return false;
}

; the sum of every generated value over every profile and every allowed exponent
pub fn vp_sweep_sum() -> u32 {
    var total : u32 = 0;
    var pr : u32 = 0;
    while pr < VP_PROFILES {
        var i : u32 = 0;
        while i < vp_allow_count(pr) {
            total = total + vp_value(pr, vp_allow_at(pr, i));
            i = i + 1;
        }
        pr = pr + 1;
    }
    return total;
}

; how many (profile, exponent) pairs the generator accepts over profile ids 0..6 and stored exponents 0..24: it must be exactly the allow list
pub fn vp_accept_count() -> u32 {
    var n : u32 = 0;
    var pr : u32 = 0;
    while pr < 7 {
        var x : u32 = 0;
        while x < 25 {
            if vp_status(pr, x) == VP_OK {
                n = n + 1;
            }
            x = x + 1;
        }
        pr = pr + 1;
    }
    return n;
}

; the manifest of Design Tokens v0.1, each value is an exact integer
test manifest_spacing {
    assert vp_status(VP_SPACING, VP_P_0) == VP_OK;
    assert vp_value(VP_SPACING, VP_P_0) == 4;
    assert vp_value(VP_SPACING, VP_P_1) == 6;
    assert vp_value(VP_SPACING, VP_P_2) == 10;
    assert vp_value(VP_SPACING, VP_P_3) == 16;
    assert vp_value(VP_SPACING, VP_P_4) == 28;
    assert vp_value(VP_SPACING, VP_P_5) == 44;
    var v : VpValue = vp_gen(VP_SPACING, VP_P_3);
    assert v.raw_ppm == 16944272;
    assert v.quantum == 2;
    assert v.profile == VP_SPACING;
    assert v.h2 == VP_P_3;
    // negative control: the manifest can fail, 16.9 does not round to 17 on a quantum of 2
    assert vp_value(VP_SPACING, VP_P_3) != 17;
    assert vp_value(VP_SPACING, VP_P_4) != 27;
}

test manifest_type {
    assert vp_status(VP_TYPOGRAPHY, VP_P_M0H) == VP_OK;
    assert vp_value(VP_TYPOGRAPHY, VP_P_M0H) == 13;
    assert vp_value(VP_TYPOGRAPHY, VP_P_0) == 16;
    assert vp_value(VP_TYPOGRAPHY, VP_P_0H) == 20;
    assert vp_value(VP_TYPOGRAPHY, VP_P_1) == 26;
    assert vp_value(VP_TYPOGRAPHY, VP_P_1H) == 33;
    assert vp_value(VP_TYPOGRAPHY, VP_P_2) == 42;
    var v : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_1H);
    assert v.raw_ppm == 32930736;
    assert v.quantum == 1;
    // negative control: 12.58 rounds up to 13 and not down to 12, 25.89 rounds up to 26
    assert vp_value(VP_TYPOGRAPHY, VP_P_M0H) != 12;
    assert vp_value(VP_TYPOGRAPHY, VP_P_1) != 25;
}

test manifest_duration {
    assert vp_status(VP_DURATION, VP_P_0) == VP_OK;
    assert vp_value(VP_DURATION, VP_P_0) == 100;
    assert vp_value(VP_DURATION, VP_P_1) == 160;
    assert vp_value(VP_DURATION, VP_P_2) == 260;
    assert vp_value(VP_DURATION, VP_P_3) == 420;
    var v : VpValue = vp_gen(VP_DURATION, VP_P_1);
    assert v.raw_ppm == 161803400;
    assert v.quantum == 10;
    // negative control: 161.8 ms snaps to the 10 ms grid at 160 and not at 170
    assert vp_value(VP_DURATION, VP_P_1) != 170;
}

test manifest_composition {
    assert vp_status(VP_COMPOSITION, VP_P_M1) == VP_OK;
    assert vp_value(VP_COMPOSITION, VP_P_M1) == 618034;
    assert vp_value(VP_COMPOSITION, VP_P_M2) == 381966;
    assert vp_value(VP_COMPOSITION, VP_P_0) == 1000000;
    assert vp_value(VP_COMPOSITION, VP_P_1) == 1618034;
    var v : VpValue = vp_gen(VP_COMPOSITION, VP_P_M1);
    assert v.raw_ppm == 618034;
    assert v.quantum == 0;
    assert v.value == v.raw_ppm;
    // the two shares of a split add to the whole, exactly
    assert vp_value(VP_COMPOSITION, VP_P_M1) + vp_value(VP_COMPOSITION, VP_P_M2) == 1000000;
    assert vp_value(VP_COMPOSITION, VP_P_M1) != vp_value(VP_COMPOSITION, VP_P_M2);
}

test phi_identities_in_ppm {
    assert vp_phi_ppm(VP_P_2) + vp_phi_ppm(VP_P_M2) == 3000000;
    assert vp_phi_ppm(VP_P_M1) + vp_phi_ppm(VP_P_M2) == 1000000;
    assert vp_phi_ppm(VP_P_1) - vp_phi_ppm(VP_P_M1) == 1000000;
    assert vp_phi_ppm(VP_P_1) + vp_phi_ppm(VP_P_M1) == 2236068;
    assert vp_phi_ppm(VP_P_2) - vp_phi_ppm(VP_P_1) == 1000000;
    assert vp_phi_ppm(VP_P_0) == 1000000;
    // negative control: a near miss is not an identity
    assert vp_phi_ppm(VP_P_2) + vp_phi_ppm(VP_P_M1) != 3000000;
    assert vp_phi_ppm(VP_P_1) + vp_phi_ppm(VP_P_M1) != 2000000;
}

; Fibonacci in the table: whole steps add up exactly, half steps within 1 ppm
test phi_table_recurrence {
    var x : u32 = VP_X_LO;
    var exact : u32 = 0;
    while x + 4 <= VP_X_HI {
        var s : u32 = vp_phi_ppm(x) + vp_phi_ppm(x + 2);
        var c : u32 = vp_phi_ppm(x + 4);
        var d : u32 = 0;
        if s >= c {
            d = s - c;
        } else {
            d = c - s;
        }
        if x % 2 == 0 {
            assert d == 0;
            exact = exact + 1;
        } else {
            assert d <= 1;
        }
        x = x + 1;
    }
    assert exact == 6;
    // negative control: the sum is not the table entry one step off
    assert vp_phi_ppm(VP_P_M2) + vp_phi_ppm(VP_P_M1) != vp_phi_ppm(VP_P_1);
}

; the phi^2 step: table[x + 4] is table[x] * phi^2, for x = 4 .. 14 (11 pairs)
; the tolerance is derived, not tuned: each of the three operands is rounded to the nearest ppm (error at most 0.5), so in ppm^2 units
;   |table[x + 4] * 1e6 - table[x] * phi2| <= 500000 + table[x] / 2 + phi2 / 2 * 1e6 / 1e6 = 500000 + table[x] / 2 + 1309017
test phi_table_step {
    var phi2 : u32 = vp_phi_ppm(VP_P_2);
    assert phi2 == 2618034;
    var x : u32 = VP_X_LO;
    var pairs : u32 = 0;
    while x + 4 <= VP_X_HI {
        var tol : u32 = 500000 + vp_phi_ppm(x) / 2 + 1309017;
        assert vp_near_product(vp_phi_ppm(x), phi2, vp_phi_ppm(x + 4), tol);
        pairs = pairs + 1;
        x = x + 1;
    }
    assert pairs == 11;
    // the sharpest pair is phi^2.5 * phi^2 against phi^4.5: 1264494 ppm^2 off, 3474112 allowed; the old hand value 8718553 is inside it too, so this test cannot tell them apart
    assert vp_near_product(vp_phi_ppm(VP_P_2H), phi2, 8718552, 1264494);
    assert vp_near_product(vp_phi_ppm(VP_P_2H), phi2, 8718552, 1264493) == false;
    assert vp_near_product(vp_phi_ppm(VP_P_2H), phi2, 8718553, 3474112);
    // negative controls: an entry off by 10 ppm fails the tolerance, in either direction
    assert vp_near_product(vp_phi_ppm(VP_P_0), phi2, 2618044, 2309017) == false;
    assert vp_near_product(vp_phi_ppm(VP_P_0), phi2, 2618024, 2309017) == false;
    assert vp_near_product(vp_phi_ppm(VP_P_2H), phi2, 8718560, 3474112) == false;
}

; the half step squared is the whole step: table[x]^2 is table[2x - 8], for x = 6 .. 13 (8 pairs), because (phi^p)^2 = phi^(2p)
; the tolerance is derived: a rounding error of at most 0.5 ppm in table[x] moves its square by at most table[x] (ppm^2), the target adds 500000
test phi_table_square {
    var x : u32 = 6;
    var pairs : u32 = 0;
    while x <= 13 {
        var tol : u32 = vp_phi_ppm(x) + 500001;
        assert vp_near_product(vp_phi_ppm(x), vp_phi_ppm(x), vp_phi_ppm(2 * x - 8), tol);
        pairs = pairs + 1;
        x = x + 1;
    }
    assert pairs == 8;
    // the sharpest pair is phi^2.5 squared against phi^5: 2096481 ppm^2 off, 3830192 allowed
    assert vp_near_product(3330191, 3330191, 11090170, 2100000);
    assert vp_near_product(3330191, 3330191, 11090170, 2000000) == false;
    // negative controls
    assert vp_near_product(vp_phi_ppm(VP_P_0), vp_phi_ppm(VP_P_0), 1000010, 3000000) == false;
    assert vp_near_product(3330191, 3330191, 11090180, 3830192) == false;
    assert vp_near_product(vp_phi_ppm(VP_P_0H), vp_phi_ppm(VP_P_0H), vp_phi_ppm(VP_P_0H), 3000000) == false;
}

test deterministic {
    var a : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_1H);
    var b : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_1H);
    assert vp_same(a, b);
    var c : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_1);
    assert vp_same(a, c) == false;
    var bad1 : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_3);
    var bad2 : VpValue = vp_gen(VP_TYPOGRAPHY, VP_P_3);
    assert vp_same(bad1, bad2);
    var s1 : u32 = vp_sweep_sum();
    var s2 : u32 = vp_sweep_sum();
    assert s1 == s2;
    // spacing 108 + type 150 + duration 940 + composition 3618034
    assert s1 == 3619232;
}

test refusal_unknown_profile {
    var v : VpValue = vp_gen(9, VP_P_0);
    assert v.status == VP_BAD_PROFILE;
    assert v.value == 0;
    assert v.profile == 9;
    assert v.quantum == 0;
    assert vp_status(VP_PROFILES, VP_P_0) == VP_BAD_PROFILE;
    assert vp_status(4000000000, VP_P_0) == VP_BAD_PROFILE;
    assert vp_check_raw(9, VP_P_0, 5000000).status == VP_BAD_PROFILE;
    // negative control: a known profile with the same exponent is fine
    assert vp_status(VP_SPACING, VP_P_0) == VP_OK;
}

test refusal_unlisted_exponent {
    assert vp_status(VP_SPACING, 20) == VP_BAD_EXPONENT;
    assert vp_status(VP_SPACING, VP_P_0H) == VP_BAD_EXPONENT;
    assert vp_status(VP_SPACING, VP_P_M1) == VP_BAD_EXPONENT;
    assert vp_status(VP_TYPOGRAPHY, VP_P_3) == VP_BAD_EXPONENT;
    assert vp_status(VP_TYPOGRAPHY, VP_P_2H) == VP_BAD_EXPONENT;
    assert vp_status(VP_TYPOGRAPHY, VP_P_M1) == VP_BAD_EXPONENT;
    assert vp_status(VP_DURATION, VP_P_4) == VP_BAD_EXPONENT;
    assert vp_status(VP_DURATION, VP_P_M1) == VP_BAD_EXPONENT;
    assert vp_status(VP_COMPOSITION, VP_P_2) == VP_BAD_EXPONENT;
    assert vp_status(VP_COMPOSITION, VP_P_M0H) == VP_BAD_EXPONENT;
    assert vp_status(VP_SPACING, 3) == VP_BAD_EXPONENT;
    assert vp_status(VP_SPACING, 0) == VP_BAD_EXPONENT;
    assert vp_status(VP_SPACING, VP_NO_EXP) == VP_BAD_EXPONENT;
    var v : VpValue = vp_gen(VP_DURATION, VP_P_4);
    assert v.value == 0;
    assert v.raw_ppm == 0;
    assert v.h2 == VP_P_4;
    // negative control: the next listed exponent is accepted
    assert vp_status(VP_DURATION, VP_P_3) == VP_OK;
    assert vp_status(VP_SPACING, VP_P_5) == VP_OK;
    assert vp_status(VP_TYPOGRAPHY, VP_P_2) == VP_OK;
}

test refusal_disabled_experimental {
    var i : u32 = 0;
    while i < 25 {
        assert vp_status(VP_EXPERIMENTAL, i) == VP_DISABLED;
        assert vp_value(VP_EXPERIMENTAL, i) == 0;
        i = i + 1;
    }
    assert vp_check_raw(VP_EXPERIMENTAL, VP_P_0, 5000000).status == VP_DISABLED;
    assert vp_profile(VP_EXPERIMENTAL).enabled == 0;
    // negative control: an enabled profile is not disabled
    assert vp_status(VP_COMPOSITION, VP_P_0) != VP_DISABLED;
}

; the raw window is the profile range plus or minus one quantum, in ppm
test raw_window {
    assert vp_raw_lo(vp_profile(VP_SPACING)) == 2000000;
    assert vp_raw_hi(vp_profile(VP_SPACING)) == 50000000;
    assert vp_raw_lo(vp_profile(VP_TYPOGRAPHY)) == 11000000;
    assert vp_raw_hi(vp_profile(VP_TYPOGRAPHY)) == 49000000;
    assert vp_raw_lo(vp_profile(VP_COMPOSITION)) == 300000;
    assert vp_raw_hi(vp_profile(VP_COMPOSITION)) == 1700000;
    assert vp_raw_lo(vp_profile(VP_DURATION)) == 90000000;
    assert vp_raw_hi(vp_profile(VP_DURATION)) == 510000000;
    // the saturating product never wraps
    assert vp_mul_cap(4294967295, 4294967295) == VP_CAP;
    assert vp_mul_cap(100, 11090170) == 1109017000;
    assert vp_mul_cap(0, 4294967295) == 0;
}

test refusal_raw_above_max {
    // type p = 2.5 never reaches the range check, the exponent gate refuses it first
    assert vp_status(VP_TYPOGRAPHY, VP_P_2H) == VP_BAD_EXPONENT;
    // the raw value it would have made is 16 * 3.330191 = 53.28, above 48 and above the window top 49
    assert vp_mul_cap(16, vp_phi_ppm(VP_P_2H)) == 53283056;
    var v : VpValue = vp_check_raw(VP_TYPOGRAPHY, VP_P_2H, 53283056);
    assert v.status == VP_RAW_RANGE;
    assert v.value == 0;
    assert v.raw_ppm == 53283056;
    assert vp_check_raw(VP_SPACING, VP_P_5, 50000001).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_2, 49000001).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_COMPOSITION, VP_P_1, 1700001).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_DURATION, VP_P_3, 510000001).status == VP_RAW_RANGE;
    // negative control: one ppm lower is inside the window, and the value is then refused by the second range check, not the first
    assert vp_check_raw(VP_SPACING, VP_P_5, 50000000).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_COMPOSITION, VP_P_1, 1700000).status == VP_OK;
}

test refusal_raw_below_min {
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_0, 10999999).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_SPACING, VP_P_0, 1999999).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_SPACING, VP_P_0, 0).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_COMPOSITION, VP_P_M2, 299999).status == VP_RAW_RANGE;
    assert vp_check_raw(VP_DURATION, VP_P_0, 89999999).status == VP_RAW_RANGE;
    var v : VpValue = vp_check_raw(VP_COMPOSITION, VP_P_M2, 299999);
    assert v.value == 0;
    assert v.raw_ppm == 299999;
    // negative control: the lowest raw value inside the window is not a raw-range refusal
    assert vp_check_raw(VP_COMPOSITION, VP_P_M2, 300000).status == VP_OK;
    assert vp_check_raw(VP_COMPOSITION, VP_P_M2, 300000).value == 300000;
    assert vp_check_raw(VP_SPACING, VP_P_0, 2000000).status != VP_RAW_RANGE;
}

; a raw value inside the window can still quantize to a value outside lo..hi: that is a refusal, never a clamp
test refusal_quantized_out_of_range {
    // spacing, quantum 2, range 4..48
    assert vp_check_raw(VP_SPACING, VP_P_0, 2000000).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_SPACING, VP_P_0, 2999999).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_SPACING, VP_P_0, 3000000).status == VP_OK;
    assert vp_check_raw(VP_SPACING, VP_P_0, 3000000).value == 4;
    assert vp_check_raw(VP_SPACING, VP_P_5, 49000000).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_SPACING, VP_P_5, 48999999).status == VP_OK;
    assert vp_check_raw(VP_SPACING, VP_P_5, 48999999).value == 48;
    // type, quantum 1, range 12..48
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_0, 11000000).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_0, 11499999).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_0, 11500000).status == VP_OK;
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_0, 11500000).value == 12;
    assert vp_check_raw(VP_TYPOGRAPHY, VP_P_2, 48500000).status == VP_QUANT_RANGE;
    // duration, quantum 10, range 100..500
    assert vp_check_raw(VP_DURATION, VP_P_0, 90000000).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_DURATION, VP_P_0, 94999999).status == VP_QUANT_RANGE;
    assert vp_check_raw(VP_DURATION, VP_P_0, 95000000).status == VP_OK;
    assert vp_check_raw(VP_DURATION, VP_P_0, 95000000).value == 100;
    var v : VpValue = vp_check_raw(VP_SPACING, VP_P_0, 2999999);
    assert v.value == 0;
    assert v.raw_ppm == 2999999;
    assert v.quantum == 2;
}

; no refusal carries a clamped value: the value is 0, never lo and never hi
test no_silent_clamp {
    var v1 : VpValue = vp_check_raw(VP_SPACING, VP_P_5, 60000000);
    assert v1.status == VP_RAW_RANGE;
    assert v1.value == 0;
    assert v1.value != 48;
    var v2 : VpValue = vp_check_raw(VP_SPACING, VP_P_0, 1000000);
    assert v2.status == VP_RAW_RANGE;
    assert v2.value != 4;
    var v3 : VpValue = vp_check_raw(VP_SPACING, VP_P_0, 2999999);
    assert v3.status == VP_QUANT_RANGE;
    assert v3.value != 4;
    assert v3.value != 2;
    var v4 : VpValue = vp_check_raw(VP_DURATION, VP_P_3, 600000000);
    assert v4.value != 500;
    assert v4.value == 0;
    // every refusal in a sweep of raw values 0 .. 60 lu has value 0, and every acceptance has a value inside 4..48
    var raw : u32 = 0;
    var refused : u32 = 0;
    var accepted : u32 = 0;
    while raw <= 60000000 {
        var r : VpValue = vp_check_raw(VP_SPACING, VP_P_0, raw);
        if r.status == VP_OK {
            assert r.value >= 4;
            assert r.value <= 48;
            accepted = accepted + 1;
        } else {
            assert r.value == 0;
            refused = refused + 1;
        }
        raw = raw + 500000;
    }
    assert accepted > 0;
    assert refused > 0;
    assert accepted + refused == 121;
}

test half_up_exact_halves {
    assert vp_round_half_up(5000000, 2) == 6;
    assert vp_round_half_up(3000000, 2) == 4;
    assert vp_round_half_up(2500000, 1) == 3;
    assert vp_round_half_up(1500000, 1) == 2;
    assert vp_round_half_up(500000, 1) == 1;
    assert vp_round_half_up(1000000, 2) == 2;
    assert vp_round_half_up(165000000, 10) == 170;
    // one ppm under a half goes down
    assert vp_round_half_up(4999999, 2) == 4;
    assert vp_round_half_up(2999999, 2) == 2;
    assert vp_round_half_up(499999, 1) == 0;
    assert vp_round_half_up(999999, 2) == 0;
    assert vp_round_half_up(164999999, 10) == 160;
    assert vp_round_half_up(0, 2) == 0;
    // quantum 0 is no quantization
    assert vp_round_half_up(7777777, 0) == 7777777;
    // negative controls: truncation would give 4, 2 and 160
    assert vp_round_half_up(5000000, 2) != 4;
    assert vp_round_half_up(2500000, 1) != 2;
    assert vp_round_half_up(165000000, 10) != 160;
    // a huge quantum does not wrap
    assert vp_round_half_up(4294967295, 4294967295) == 0;
}

test monotone_in_p {
    var pr : u32 = 0;
    var pairs : u32 = 0;
    while pr < VP_PROFILES {
        var i : u32 = 1;
        while i < vp_allow_count(pr) {
            var lo_x : u32 = vp_allow_at(pr, i - 1);
            var hi_x : u32 = vp_allow_at(pr, i);
            assert hi_x > lo_x;
            assert vp_value(pr, hi_x) >= vp_value(pr, lo_x);
            pairs = pairs + 1;
            i = i + 1;
        }
        pr = pr + 1;
    }
    assert pairs == 16;
    // negative control: the direction is real, the top of a profile is above its bottom
    assert vp_value(VP_SPACING, VP_P_0) < vp_value(VP_SPACING, VP_P_5);
    assert vp_value(VP_SPACING, VP_P_5) > vp_value(VP_SPACING, VP_P_0);
    assert vp_value(VP_TYPOGRAPHY, VP_P_M0H) < vp_value(VP_TYPOGRAPHY, VP_P_2);
    assert vp_value(VP_DURATION, VP_P_0) < vp_value(VP_DURATION, VP_P_3);
    assert vp_value(VP_COMPOSITION, VP_P_M2) < vp_value(VP_COMPOSITION, VP_P_1);
}

test values_inside_range {
    var pr : u32 = 0;
    var seen : u32 = 0;
    while pr < VP_PROFILES {
        var p : VpProfile = vp_profile(pr);
        var i : u32 = 0;
        while i < vp_allow_count(pr) {
            var v : VpValue = vp_gen(pr, vp_allow_at(pr, i));
            assert v.status == VP_OK;
            assert v.value >= p.lo;
            assert v.value <= p.hi;
            assert v.value > 0;
            if p.quantum != 0 {
                assert v.value % p.quantum == 0;
            }
            seen = seen + 1;
            i = i + 1;
        }
        pr = pr + 1;
    }
    assert seen == 20;
}

test fixed_k_m_q {
    var pr : u32 = 0;
    while pr < VP_PROFILES {
        var p : VpProfile = vp_profile(pr);
        assert p.k3 == 0;
        assert p.mpi == 0;
        assert p.qe == 0;
        assert p.id == pr;
        pr = pr + 1;
    }
    // an unknown profile has no id and is not enabled
    var u : VpProfile = vp_profile(9);
    assert u.id == VP_NO_EXP;
    assert u.enabled == 0;
    assert u.allow_count == 0;
    assert u.k3 == 0;
    // with k, m and q at 0 the value is n * phi^p: the raw value of every enabled profile at p = 0 is n in ppm
    assert vp_gen(VP_SPACING, VP_P_0).raw_ppm == 4000000;
    assert vp_gen(VP_TYPOGRAPHY, VP_P_0).raw_ppm == 16000000;
    assert vp_gen(VP_COMPOSITION, VP_P_0).raw_ppm == 1000000;
    assert vp_gen(VP_DURATION, VP_P_0).raw_ppm == 100000000;
}

test profile_table {
    assert VP_PROFILES == 5;
    var s : VpProfile = vp_profile(VP_SPACING);
    assert s.n == 4;
    assert s.unit == VP_UNIT_LU;
    assert s.quantum == 2;
    assert s.lo == 4;
    assert s.hi == 48;
    assert s.enabled == 1;
    var t : VpProfile = vp_profile(VP_TYPOGRAPHY);
    assert t.n == 16;
    assert t.unit == VP_UNIT_LU;
    assert t.quantum == 1;
    assert t.lo == 12;
    assert t.hi == 48;
    var c : VpProfile = vp_profile(VP_COMPOSITION);
    assert c.n == 1;
    assert c.unit == VP_UNIT_RATIO_PPM;
    assert c.quantum == 0;
    assert c.lo == 300000;
    assert c.hi == 1700000;
    var d : VpProfile = vp_profile(VP_DURATION);
    assert d.n == 100;
    assert d.unit == VP_UNIT_MS;
    assert d.quantum == 10;
    assert d.lo == 100;
    assert d.hi == 500;
    var x : VpProfile = vp_profile(VP_EXPERIMENTAL);
    assert x.enabled == 0;
    assert x.allow_count == 0;
    // the range is a multiple of the quantum, so a raw value inside the range always rounds inside it
    assert s.lo % s.quantum == 0;
    assert s.hi % s.quantum == 0;
    assert t.lo % t.quantum == 0;
    assert d.lo % d.quantum == 0;
    assert d.hi % d.quantum == 0;
    assert s.lo < s.hi;
    assert t.lo < t.hi;
    assert c.lo < c.hi;
    assert d.lo < d.hi;
}

test allow_lists {
    assert vp_allow_count(VP_SPACING) == 6;
    assert vp_allow_count(VP_TYPOGRAPHY) == 6;
    assert vp_allow_count(VP_COMPOSITION) == 4;
    assert vp_allow_count(VP_DURATION) == 4;
    assert vp_allow_count(VP_EXPERIMENTAL) == 0;
    assert vp_allow_count(5) == 0;
    assert vp_allow_count(4000000000) == 0;
    assert vp_allow_at(VP_SPACING, 0) == VP_P_0;
    assert vp_allow_at(VP_SPACING, 5) == VP_P_5;
    assert vp_allow_at(VP_SPACING, 6) == VP_NO_EXP;
    assert vp_allow_at(VP_TYPOGRAPHY, 0) == VP_P_M0H;
    assert vp_allow_at(VP_TYPOGRAPHY, 1) == VP_P_0;
    assert vp_allow_at(VP_TYPOGRAPHY, 2) == VP_P_0H;
    assert vp_allow_at(VP_TYPOGRAPHY, 3) == VP_P_1;
    assert vp_allow_at(VP_TYPOGRAPHY, 4) == VP_P_1H;
    assert vp_allow_at(VP_TYPOGRAPHY, 5) == VP_P_2;
    assert vp_allow_at(VP_COMPOSITION, 0) == VP_P_M2;
    assert vp_allow_at(VP_COMPOSITION, 1) == VP_P_M1;
    assert vp_allow_at(VP_COMPOSITION, 2) == VP_P_0;
    assert vp_allow_at(VP_COMPOSITION, 3) == VP_P_1;
    assert vp_allow_at(VP_COMPOSITION, 4) == VP_NO_EXP;
    assert vp_allow_at(VP_DURATION, 0) == VP_P_0;
    assert vp_allow_at(VP_DURATION, 3) == VP_P_3;
    assert vp_allow_at(VP_EXPERIMENTAL, 0) == VP_NO_EXP;
    assert vp_allow_at(9, 0) == VP_NO_EXP;
    // the flat list is consistent: offsets follow counts, the total is 20, every entry is in the phi table
    var pr : u32 = 0;
    var total : u32 = 0;
    while pr < VP_PROFILES {
        assert VP_ALLOW_START[pr] == total;
        total = total + VP_ALLOW_COUNT[pr];
        pr = pr + 1;
    }
    assert total == VP_ALLOW_TOTAL;
    var k : u32 = 0;
    while k < VP_ALLOW_TOTAL {
        assert vp_phi_ppm(VP_ALLOW[k]) > 0;
        k = k + 1;
    }
    // the generator accepts exactly the allow list and nothing else
    assert vp_accept_count() == 20;
    assert vp_exp_ok(VP_SPACING, VP_P_3);
    assert vp_exp_ok(VP_SPACING, VP_P_0H) == false;
    assert vp_exp_ok(VP_TYPOGRAPHY, VP_P_2H) == false;
    assert vp_exp_ok(9, VP_P_0) == false;
    assert vp_exp_ok(VP_EXPERIMENTAL, VP_P_0) == false;
}

test table_range {
    assert VP_TABLE_LEN == 15;
    assert VP_X_HI - VP_X_LO + 1 == VP_TABLE_LEN;
    assert vp_phi_ppm(3) == 0;
    assert vp_phi_ppm(0) == 0;
    assert vp_phi_ppm(19) == 0;
    assert vp_phi_ppm(4294967295) == 0;
    assert vp_phi_ppm(4) == 381966;
    assert vp_phi_ppm(18) == 11090170;
    assert vp_phi_ppm(VP_P_M1H) == 485868;
    assert vp_phi_ppm(VP_P_M0H) == 786151;
    assert vp_phi_ppm(VP_P_0H) == 1272020;
    assert vp_phi_ppm(VP_P_1H) == 2058171;
    assert vp_phi_ppm(VP_P_2H) == 3330191;
    assert vp_phi_ppm(VP_P_3H) == 5388362;
    assert vp_phi_ppm(VP_P_4H) == 8718552;
    assert vp_phi_ppm(VP_P_3) == 4236068;
    assert vp_phi_ppm(VP_P_4) == 6854102;
    // the table rises with the exponent
    var x : u32 = VP_X_LO + 1;
    while x <= VP_X_HI {
        assert vp_phi_ppm(x) > vp_phi_ppm(x - 1);
        x = x + 1;
    }
}

test exponent_lowest_terms {
    // the stored exponent of a fraction, reduced first
    assert vp_h2_from_ratio(true, 4, 2) == VP_P_M2;
    assert vp_h2_from_ratio(true, 1, 1) == VP_P_M1;
    assert vp_h2_from_ratio(true, 1, 2) == VP_P_M0H;
    assert vp_h2_from_ratio(true, 3, 2) == VP_P_M1H;
    assert vp_h2_from_ratio(true, 0, 1) == VP_P_0;
    assert vp_h2_from_ratio(false, 0, 7) == VP_P_0;
    assert vp_h2_from_ratio(false, 1, 2) == VP_P_0H;
    assert vp_h2_from_ratio(false, 2, 4) == VP_P_0H;
    assert vp_h2_from_ratio(false, 50, 100) == VP_P_0H;
    assert vp_h2_from_ratio(false, 3, 2) == VP_P_1H;
    assert vp_h2_from_ratio(false, 6, 3) == VP_P_2;
    assert vp_h2_from_ratio(false, 5, 1) == VP_P_5;
    assert vp_h2_from_ratio(false, 9, 2) == VP_P_4H;
    // a denominator that does not reduce to 1 or 2, a zero denominator, and exponents off the table are refused
    assert vp_h2_from_ratio(false, 1, 3) == VP_NO_EXP;
    assert vp_h2_from_ratio(false, 1, 4) == VP_NO_EXP;
    assert vp_h2_from_ratio(false, 1, 0) == VP_NO_EXP;
    assert vp_h2_from_ratio(false, 6, 1) == VP_NO_EXP;
    assert vp_h2_from_ratio(true, 5, 2) == VP_NO_EXP;
    assert vp_h2_from_ratio(true, 3, 1) == VP_NO_EXP;
    assert vp_h2_from_ratio(false, 2000, 1) == VP_NO_EXP;
    assert vp_h2_from_ratio(false, 1, 2000) == VP_NO_EXP;
    // the denominator in lowest terms, from the parity of the stored exponent
    assert vp_den(VP_P_0) == 1;
    assert vp_den(VP_P_M2) == 1;
    assert vp_den(VP_P_5) == 1;
    assert vp_den(VP_P_0H) == 2;
    assert vp_den(VP_P_M0H) == 2;
    assert vp_den(VP_P_4H) == 2;
    // only the type profile uses halves
    var pr : u32 = 0;
    var halves : u32 = 0;
    while pr < VP_PROFILES {
        var i : u32 = 0;
        while i < vp_allow_count(pr) {
            if vp_den(vp_allow_at(pr, i)) == 2 {
                assert pr == VP_TYPOGRAPHY;
                halves = halves + 1;
            }
            i = i + 1;
        }
        pr = pr + 1;
    }
    assert halves == 3;
}
