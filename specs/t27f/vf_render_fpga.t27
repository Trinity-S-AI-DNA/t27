// SPDX-License-Identifier: Apache-2.0
// specs/t27f/vf_render_fpga.t27 -- T27F: vf_render_fpga — FPGA target renderer
// (AX7203 framebuffer via AXI4 @extern).
// Part of M6 milestone (milestone #10). Closes #13297.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::vf_render_fpga;

pub const AX7203_FRAMEBUFFER_ADDR : u32 = 0x4000_0000;

pub struct FpgaRenderTarget { framebuffer_addr: u32, ax4_ready: bool };

pub fn fpga_render_target_ready(t: FpgaRenderTarget) -> bool {
    return t.ax4_ready;
}

test "fpga_render_target_ready" {
    assert(fpga_render_target_ready(FpgaRenderTarget { framebuffer_addr: AX7203_FRAMEBUFFER_ADDR, ax4_ready: true }));
    assert(!fpga_render_target_ready(FpgaRenderTarget { framebuffer_addr: AX7203_FRAMEBUFFER_ADDR, ax4_ready: false }));
}

invariant ax7203_framebuffer_addr_defined {
    assert AX7203_FRAMEBUFFER_ADDR == 0x4000_0000;
}