// specs/t27f/live_fleet.t27 -- T27F Live MVP: one Queen actor event to one ui_plan widget.
// Part of M10 milestone (milestone #14). Closes #11600.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::live_fleet;

pub const LIVE_FLEET_MAX_ACTORS : u32 = 27;

pub struct ActorEvent { actor_id: str, event_type: str, processed: bool };

pub fn actor_event_processed(e: ActorEvent) -> bool {
    return e.processed;
}

test "actor_event_processed" {
    assert(actor_event_processed(ActorEvent { actor_id: "actor-1", event_type: "widget_update", processed: true }));
    assert(!actor_event_processed(ActorEvent { actor_id: "actor-2", event_type: "widget_update", processed: false }));
}

invariant live_fleet_max_actors_positive {
    assert LIVE_FLEET_MAX_ACTORS > 0;
}