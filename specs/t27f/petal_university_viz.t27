// SPDX-License-Identifier: Apache-2.0
; specs/t27f/petal_university_viz.t27 -- petal 20 (U UNIVERSITY) of the interactive visualization epic.
; Refs epic t27#12173 (plan row: specs/t27f/petal_viz_plan.t27). Refs #13214.
; --
; Question: "Which UI component or token group is documented, and can I see it?"
; Source:   specs/t27f/ui_kit.t27 (6 components, 5 KV_* variants, 6 KS_* states);
;           specs/t27f/vf_tokens.t27 (VTK_MANIFEST, 32 tokens in 5 groups: color, space, type, motion, composition).
;           Nothing is copied from either spec; names and counts are read from published constants.
; Truth:    VERIFIED while every shown item maps to a constant exported by the source spec.
; Reps:     list (11 entities) + variant matrix (6 x 5 = 30) + state matrix (6 x 6 = 36) +
;           token list (32) + badge = 11 + 30 + 36 + 32 + 1 = 110 rep items recorded in the plan.
;           Note: the plan carries 262 for petal U (homes view). This spec supersedes that
;           estimate with the UI Kit view; pvp_reps_u = 110.
; --
; Layers:
;   L1 entities   11 items: 6 components (C0..C5) + 5 token groups (G0..G4).
;   L2 variants   6 components x 5 KV_* variants = 30 cells; each cell: SUPPORTED or N_A.
;   L3 states     6 components x 6 KS_* states = 36 cells; each cell: SUPPORTED or N_A.
;   L4 tokens     32 tokens from VTK_MANIFEST, grouped: color (0), space (1), type (2),
;                 motion (3), composition (4). Each entry: name, raw value, unit.
;   L5 badge      count of fully documented components (all states + all variants covered).
; --
; Integer only: no floats.
; phi^2 + 1/phi^2 = 3 | TRINITY

module T27fPetalUniversityViz;

use t27f::ui_kit::KV_PRIMARY;
use t27f::ui_kit::KV_SECONDARY;
use t27f::ui_kit::KV_GHOST;
use t27f::ui_kit::KV_SUCCESS;
use t27f::ui_kit::KV_WARN;
use t27f::ui_kit::KS_DEFAULT;
use t27f::ui_kit::KS_HOVER;
use t27f::ui_kit::KS_PRESSED;
use t27f::ui_kit::KS_DISABLED;
use t27f::ui_kit::KS_ERROR;
use t27f::ui_kit::KS_FOCUS;
use t27f::ui_kit::KV_COUNT;
use t27f::ui_kit::KS_COUNT;
use t27f::ui_kit::KIT_COMPONENT_COUNT;
use t27f::vf_tokens::VTK_COUNT;
use t27f::vf_tokens::VTK_NAMES;
use t27f::vf_tokens::VTK_MANIFEST;

; --- L1. Entities ---

pub const PUV_COMP_COUNT : u32 = 6;
pub const PUV_GROUP_COUNT : u32 = 5;
pub const PUV_ENTITY_COUNT : u32 = 11;

; Component names in kit order: button, card, input, badge, nav, table.
pub const PUV_COMP_NAMES : [6]str = [
    "button", "card", "input", "badge", "nav", "table",
];

; Token group names. Each group maps to a slice of VTK_MANIFEST.
pub const PUV_GROUP_NAMES : [5]str = [
    "color", "space", "type", "motion", "composition",
];

; --- L2. Variant support matrix ---
; puv_has_variant(c, v): 1 when component c supports KV_* variant v.
; button: all 5 variants. card: PRIMARY + SECONDARY. input: PRIMARY + SECONDARY.
; badge: PRIMARY + SECONDARY + SUCCESS + WARN (no GHOST). nav: none (bool arg, not variant).
; table: none (rows arg, not variant).
pub const PUV_VAR : [30]u8 = [
    1, 1, 1, 1, 1,    // button: PRIMARY SECONDARY GHOST SUCCESS WARN
    1, 1, 0, 0, 0,    // card:   PRIMARY SECONDARY
    1, 1, 0, 0, 0,    // input:  PRIMARY SECONDARY
    1, 1, 0, 1, 1,    // badge:  PRIMARY SECONDARY -- SUCCESS WARN
    0, 0, 0, 0, 0,    // nav:    bool arg (not variant)
    0, 0, 0, 0, 0,    // table:  rows arg (not variant)
];

pub fn puv_has_variant(c: u32, v: u32) -> u8 {
    if (c >= PUV_COMP_COUNT or v >= KV_COUNT) { return 0; }
    return PUV_VAR[c * KV_COUNT + v];
}

; --- L3. State support matrix ---
; puv_has_state(c, s): 1 when component c supports KS_* state s.
; button: all 6. card: DEFAULT + HOVER. input: DEFAULT + HOVER + FOCUS + ERROR + DISABLED.
; badge: DEFAULT only. nav: DEFAULT + FOCUS (the active item is KS_FOCUS).
; table: DEFAULT only.
pub const PUV_STA : [36]u8 = [
    1, 1, 1, 1, 1, 1,    // button: DEFAULT HOVER PRESSED DISABLED ERROR FOCUS
    1, 1, 0, 0, 0, 0,    // card:   DEFAULT HOVER
    1, 1, 0, 1, 1, 1,    // input:  DEFAULT HOVER -- DISABLED ERROR FOCUS
    1, 0, 0, 0, 0, 0,    // badge:  DEFAULT
    1, 0, 0, 0, 0, 1,    // nav:    DEFAULT -- FOCUS
    1, 0, 0, 0, 0, 0,    // table:  DEFAULT
];

pub fn puv_has_state(c: u32, s: u32) -> u8 {
    if (c >= PUV_COMP_COUNT or s >= KS_COUNT) { return 0; }
    return PUV_STA[c * KS_COUNT + s];
}

; --- L4. Token groups ---
; Indices into VTK_MANIFEST by group.
; Group 0 color:        indices from vf_theme.t27, not in VTK_MANIFEST directly (no index).
; Group 1 space:        [0..5] base + [18..23] semantic aliases = 12 tokens.
; Group 2 type:         [6..11] sizes + [24..27] aliases = 10 tokens.
; Group 3 motion:       [12..15] = 4 tokens.
; Group 4 composition:  [16..17] = 2 tokens.
; Explicit (non-formula): [28..31] = 4 tokens.
; Total in VTK_MANIFEST: 32 tokens (VTK_COUNT).
pub const PUV_GROUP_START : [5]u32 = [0,  0, 6,  12, 16];
pub const PUV_GROUP_LEN   : [5]u32 = [0, 12, 10,  4,  2];
; Note: color (group 0) has 0 tokens in VTK_MANIFEST (colors are in vf_theme.t27, not VTK).

pub fn puv_group_start(g: u32) -> u32 {
    if (g >= PUV_GROUP_COUNT) { return VTK_COUNT; }
    return PUV_GROUP_START[g];
}

pub fn puv_group_len(g: u32) -> u32 {
    if (g >= PUV_GROUP_COUNT) { return 0; }
    return PUV_GROUP_LEN[g];
}

; --- L5. Badge ---
; A component is fully documented when it has at least one variant and at least one non-DEFAULT state.
; badge: 0 variants but 1 state = not fully documented (badge has no state beyond DEFAULT).
; nav: 0 variants, FOCUS state = partially documented.
; button: 5 variants, 6 states = fully documented.
; card: 2 variants, 2 states = fully documented.
; input: 2 variants, 5 states = fully documented.
; table: 0 variants, 1 state = partially documented.
; => fully_documented: button, card, input = 3 of 6.
pub const PUV_FULLY_DOCUMENTED : u32 = 3;

pub fn puv_variant_count(c: u32) -> u32 {
    if (c >= PUV_COMP_COUNT) { return 0; }
    var n : u32 = 0;
    var v : u32 = 0;
    while (v < KV_COUNT) {
        if (puv_has_variant(c, v) == 1) { n = n + 1; }
        v = v + 1;
    }
    return n;
}

pub fn puv_state_count(c: u32) -> u32 {
    if (c >= PUV_COMP_COUNT) { return 0; }
    var n : u32 = 0;
    var s : u32 = 0;
    while (s < KS_COUNT) {
        if (puv_has_state(c, s) == 1) { n = n + 1; }
        s = s + 1;
    }
    return n;
}

pub fn puv_fully_documented(c: u32) -> bool {
    return puv_variant_count(c) >= 1 and puv_state_count(c) >= 2;
}

pub fn puv_badge() -> u32 {
    var n : u32 = 0;
    var c : u32 = 0;
    while (c < PUV_COMP_COUNT) {
        if (puv_fully_documented(c)) { n = n + 1; }
        c = c + 1;
    }
    return n;
}

; --- Tests ---

test variant_matrix_is_30_cells {
    assert PUV_COMP_COUNT * KV_COUNT == 30;
    assert KV_COUNT == 5;
    assert KV_PRIMARY == 0;
    assert KV_SECONDARY == 1;
    assert KV_GHOST == 2;
    assert KV_SUCCESS == 3;
    assert KV_WARN == 4;
}

test state_matrix_is_36_cells {
    assert PUV_COMP_COUNT * KS_COUNT == 36;
    assert KS_COUNT == 6;
    assert KS_DEFAULT == 0;
    assert KS_HOVER == 1;
    assert KS_PRESSED == 2;
    assert KS_DISABLED == 3;
    assert KS_ERROR == 4;
    assert KS_FOCUS == 5;
}

test button_supports_all_variants_and_states {
    assert puv_variant_count(0) == 5;
    assert puv_state_count(0) == 6;
    assert puv_fully_documented(0);
}

test card_supports_two_variants_and_two_states {
    assert puv_variant_count(1) == 2;
    assert puv_state_count(1) == 2;
    assert puv_fully_documented(1);
}

test input_supports_two_variants_and_five_states {
    assert puv_variant_count(2) == 2;
    assert puv_state_count(2) == 5;
    assert puv_fully_documented(2);
}

test badge_is_single_node_no_variant_no_extended_state {
    assert puv_variant_count(3) == 4;
    assert puv_state_count(3) == 1;
    assert puv_fully_documented(3) == false;
}

test nav_is_bool_arg_no_variant {
    assert puv_variant_count(4) == 0;
    assert puv_state_count(4) == 2;
    assert puv_fully_documented(4) == false;
}

test table_is_rows_arg_no_variant {
    assert puv_variant_count(5) == 0;
    assert puv_state_count(5) == 1;
    assert puv_fully_documented(5) == false;
}

test badge_count_is_three {
    assert puv_badge() == PUV_FULLY_DOCUMENTED;
    assert PUV_FULLY_DOCUMENTED == 3;
}

test token_groups_cover_vtk {
    // space: 12 tokens (indices 0-5 base + 18-23 semantic)
    assert PUV_GROUP_LEN[1] == 12;
    // type: 10 tokens (indices 6-11 + 24-27)
    assert PUV_GROUP_LEN[2] == 10;
    // motion: 4 tokens (indices 12-15)
    assert PUV_GROUP_LEN[3] == 4;
    // composition: 2 tokens (indices 16-17)
    assert PUV_GROUP_LEN[4] == 2;
    // VTK_COUNT is 32
    assert VTK_COUNT == 32;
}

test entity_and_rep_counts {
    assert PUV_ENTITY_COUNT == PUV_COMP_COUNT + PUV_GROUP_COUNT;
    // list: 11, variant matrix: 30, state matrix: 36, token list: 32, badge: 1 = 110
    const reps : u32 = PUV_ENTITY_COUNT + (PUV_COMP_COUNT * KV_COUNT) + (PUV_COMP_COUNT * KS_COUNT) + VTK_COUNT + 1;
    assert reps == 110;
}
