// SPDX-License-Identifier: Apache-2.0
; specs/t27f/live_preview.t27 -- the preview adapter of the live mycelium graph
; (epic #12779). Serves the recorded replay vector (specs/t27os/live_tap.t27
; TAP_REPLAY) through the existing graph core (work_graph's apply_event) so the
; renderer can show three visual modes (STATIC, SMOOTH, STAGED from
; specs/t27os/graph_transition.t27) on the SAME event stream.
; --
; WHAT IS DECIDED HERE (every rule has a test below): the step-by-step replay
; (one event at a time), the snapshot diff between before and after states,
; the integration with the transition engine, and the honest naming: this is a
; REPLAY, never a live source. The recorded log is never drawn as live.
; --
; WHAT IS NOT HERE: the rendering (window), the live tap (live_tap.t27 reads
; real PTY pane states), the graph state (work_graph.t27). This module only
; replays the recorded log and produces snapshots for the renderer.
; ASCII only (L3). phi^2 + phi^-2 = 3 | TRINITY

module T27fLivePreview;

use std::mem::bytes_eq;
use t27f::work_graph::WorkGraph;
use t27f::work_graph::Event;
use t27f::work_graph::new_graph;
use t27f::work_graph::apply_event;
use t27f::work_graph::nodes;
use t27f::work_graph::edges;
use t27f::work_graph::graph_digest;
use t27f::work_graph::WG_OK;
use t27os::live_tap::TAP_REPLAY;
use t27os::live_tap::tap_replay_step;
use t27os::live_tap::tap_fold;
use t27os::graph_transition::TrState;
use t27os::graph_transition::trs_new;
use t27os::graph_transition::trs_enqueue;
use t27os::graph_transition::trs_tick;
use t27os::graph_transition::trs_pause;
use t27os::graph_transition::trs_resume;
use t27os::graph_transition::trs_set_static;
use t27os::graph_transition::TRS_NONE;

/// The replay length (the recorded log's event count).
pub const LVP_REPLAY_LEN : u32 = 24;

/// A fresh replay graph with the full recorded log folded.
pub fn lvp_new_graph() -> WorkGraph {
    var g : WorkGraph = new_graph();
    var r : u8 = tap_fold(&g, TAP_REPLAY[0..24]);
    if (r != 0) { /* fold error; return empty graph */ }
    return g;
}

/// Advance the replay by one event: apply TAP_REPLAY[e] via tap_replay_step.
; Returns WG_OK or the work_graph error code. The caller tracks `e`.
pub fn lvp_step(g : *WorkGraph, e : u32) -> u8 {
    if (e >= LVP_REPLAY_LEN) { return 255; }   // past the replay end
    return tap_replay_step(g, e, TAP_REPLAY[e as usize]);
}

/// The digest of the graph at step e (0 events applied = empty graph digest).
; Used for snapshot comparison: same digest = same graph bytes.
pub fn lvp_digest(g : *WorkGraph) -> [32]u8 {
    return graph_digest(g);
}

/// The transition engine for this preview, in `mode`.
pub fn lvp_transition(mode : u8) -> TrState {
    return trs_new(mode);
}

/// Whether the replay has more events after index e.
pub fn lvp_has_more(e : u32) -> bool { return e < LVP_REPLAY_LEN; }

/// A snapshot comparison between two graph states: whether the digests match.
pub fn lvp_same(a : [32]u8, b : [32]u8) -> bool {
    return bytes_eq(a[0..32], b[0..32]);
}

// ---- tests ----------------------------------------------------------------------

test the_replay_vector_has_24_events {
    assert(LVP_REPLAY_LEN == 24);
    assert(TAP_REPLAY.len == 24);
}

test lvp_step_advances_one_event {
    var g : WorkGraph = new_graph();
    var r : u8 = lvp_step(&g, 0);
    assert(r == 0);   // WG_OK, spawn event applied
    assert(nodes(&g) == 2);   // from_pid + queen node
}

test lvp_step_refuses_past_the_replay_end {
    var g : WorkGraph = new_graph();
    var r : u8 = lvp_step(&g, LVP_REPLAY_LEN);
    assert(r == 255);   // past the end
}

test lvp_full_replay_matches_the_direct_fold {
    var a : WorkGraph = new_graph();
    var b : WorkGraph = new_graph();
    var e : u32 = 0;
    while (e < LVP_REPLAY_LEN) {
        lvp_step(&a, e);
        e = e + 1;
    }
    tap_fold(&b, TAP_REPLAY[0..24]);
    var da : [32]u8 = graph_digest(&a);
    var db : [32]u8 = graph_digest(&b);
    assert(lvp_same(da, db));
}

test lvp_same_detects_different_digests {
    var a : [32]u8 = undefined;
    var b : [32]u8 = undefined;
    var i : u32 = 0;
    while (i < 32) { a[i as usize] = 0; b[i as usize] = 0; i = i + 1; }
    assert(lvp_same(a, b));
    a[0] = 1;
    assert(lvp_same(a, b) == false);
}

test lvp_transition_engine_integrates_with_replay {
    var g : WorkGraph = new_graph();
    var s : TrState = lvp_transition(2);   // STAGED mode
    var e : u32 = 0;
    while (e < LVP_REPLAY_LEN) {
        lvp_step(&g, e);
        trs_enqueue(&s, 1);   // one event per replay step
        // advance a few frames per event to exercise the staged transition
        var tick : u32 = 0;
        while (tick < 4) { trs_tick(&s, false); tick = tick + 1; }
        e = e + 1;
    }
    assert(nodes(&g) == 20);   // the recorded log's expected node count
    assert(edges(&g) == 12);
}

test lvp_transition_pause_stops_progress {
    var s : TrState = lvp_transition(2);
    trs_enqueue(&s, 1);
    assert(s.stage != TRS_NONE);
    trs_pause(&s);
    trs_tick(&s, false);
    assert(s.frame == 0);   // paused: no advance
    trs_resume(&s);
    trs_tick(&s, false);
    assert(s.frame == 1);   // resumed: advances
}

test lvp_static_mode_skips_staging {
    var g : WorkGraph = new_graph();
    var s : TrState = lvp_transition(0);   // STATIC mode
    trs_set_static(&s);
    var e : u32 = 0;
    while (e < LVP_REPLAY_LEN) {
        lvp_step(&g, e);
        trs_enqueue(&s, 1);   // no-op in STATIC mode
        e = e + 1;
    }
    assert(s.stage == TRS_NONE and s.pending == 0);
    assert(nodes(&g) == 20);   // events applied directly
}

invariant the_replay_is_not_live {
    // the preview adapter's name and its honest naming rule
    assert(LVP_REPLAY_LEN == 24);
    // the recorded log's own vector is the input; no live PTY pane states here
    assert(TAP_REPLAY.len == LVP_REPLAY_LEN);
}
