// SPDX-License-Identifier: Apache-2.0
; T27F-004: preview manifest, a11y tree and a normalized snapshot of a valid visual-factory graph at its viewport
; Refs gHashTag/t27#13218, epic #13214
; Reads specs/t27f/visual_factory_contract.t27 and specs/t27f/vf_layout.t27, edits neither
; The snapshot is rows of fields, not one joined text: a text join needs string `+`, which t27b
; rejects ("unsupported construct ExprBinary(+) on a string"), so a text rendering is deferred
; (a generator job). Limits: no pixels, no contrast (needs gamma-correct luminance, deferred)

module t27f_vf_snapshot;
use t27f::ui_plan::bit;
use t27f::visual_factory_contract::VfGraph;
use t27f::visual_factory_contract::VF_CONTRACT_VERSION;
use t27f::visual_factory_contract::VF_NAMES;
use t27f::visual_factory_contract::ROLE_NAMES;
use t27f::visual_factory_contract::BUTTON;
use t27f::visual_factory_contract::VF_TEXT;
use t27f::visual_factory_contract::VF_BUTTON;
use t27f::visual_factory_contract::VF_STACK;
use t27f::visual_factory_contract::VF_NO_PARENT;
use t27f::visual_factory_contract::P_TEXT;
use t27f::visual_factory_contract::P_TEST_ID;
use t27f::visual_factory_contract::vf_add;
use t27f::visual_factory_contract::vf_blank_graph;
use t27f::visual_factory_contract::vf_validate;
use t27f::visual_factory_contract::vf_role;
use t27f::visual_factory_contract::vf_is_interactive;
use t27f::visual_factory_contract::vf_accessible_name;
use t27f::vf_layout::VfLayout;
use t27f::vf_layout::vf_layout;
use t27f::vf_layout::vf_rect_is;
use t27f::stories::task_card::task_card_graph;

pub const VF_THEME_NAMES : [3]str = ["light", "dark", "high-contrast"];
pub const VF_PREVIEW_VIEWPORTS : [3]u32 = [375, 768, 1280];
pub const VF_PREVIEW_THEMES : [3]u8 = [0, 1, 2];

pub const A11Y_OK : u8 = 0;
pub const A11Y_NAME : u8 = 1;
pub const A11Y_BUTTON_ROLE : u8 = 2;
pub const A11Y_TEXT : u8 = 3;
pub const A11Y_FOCUS : u8 = 4;
pub const A11Y_INVALID : u8 = 5;

pub const VF_NO_FOCUS : u8 = 255;

pub struct VfManifest {
    story: str,
    entry: str,
    contract_version: u32,
    viewports: [3]u32,
    themes: [3]u8,
}

pub struct VfSnapshot {
    code: u8,
    node_count: u32,
    theme: u8,
    viewport_w: u32,
    viewport_h: u32,
    contract_version: u32,
    kind: [16]u8,
    x: [16]u32,
    y: [16]u32,
    w: [16]u32,
    h: [16]u32,
    role: [16]u8,
    name: [16]str,
    focus: [16]u8,
    test_id: [16]str,
}

pub fn vf_blank_snapshot() -> VfSnapshot {
    var s : VfSnapshot = VfSnapshot {
        code: 0,
        node_count: 0,
        theme: 0,
        viewport_w: 0,
        viewport_h: 0,
        contract_version: 0,
        kind: [0; 16],
        x: [0; 16],
        y: [0; 16],
        w: [0; 16],
        h: [0; 16],
        role: [0; 16],
        name: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        focus: [255; 16],
        test_id: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
    };
    return s;
}

pub fn vf_manifest(story: str, entry: str) -> VfManifest {
    var m : VfManifest = VfManifest {
        story: "",
        entry: "",
        contract_version: VF_CONTRACT_VERSION,
        viewports: [0; 3],
        themes: [0; 3],
    };

    m.story = story;
    m.entry = entry;

    m.viewports[0] = VF_PREVIEW_VIEWPORTS[0];
    m.viewports[1] = VF_PREVIEW_VIEWPORTS[1];
    m.viewports[2] = VF_PREVIEW_VIEWPORTS[2];

    m.themes[0] = VF_PREVIEW_THEMES[0];
    m.themes[1] = VF_PREVIEW_THEMES[1];
    m.themes[2] = VF_PREVIEW_THEMES[2];

    return m;
}

; the k-th node id of the preorder walk, 255 when past the end or the graph is invalid
pub fn vf_preorder_at(g: VfGraph, k: u32) -> u8 {
    if vf_validate(g) != 0 {
        return VF_NO_FOCUS;
    }
    if k >= g.node_count {
        return VF_NO_FOCUS;
    }

    var stack : [16]u8 = [0; 16];
    var sp : u32 = 0;
    stack[0] = 0;
    sp = 1;

    var seen : u32 = 0;
    while sp > 0 {
        sp = sp - 1;
        let n : u32 = stack[sp] as u32;
        if seen == k {
            return n as u8;
        }
        seen = seen + 1;

        var j : u32 = g.node_count;
        while j > 0 {
            j = j - 1;
            if g.parent[j] == n as u8 {
                stack[sp] = j as u8;
                sp = sp + 1;
            }
        }
    }

    return VF_NO_FOCUS;
}

; focus order is child order: the number of interactive nodes before node i
pub fn vf_focus_of(g: VfGraph, i: u32) -> u8 {
    if i >= g.node_count {
        return VF_NO_FOCUS;
    }

    let live : bool = vf_is_interactive(g.kind[i]);
    if live {
        var count : u32 = 0;
        var k : u32 = 0;
        while k < g.node_count {
            let n : u32 = vf_preorder_at(g, k) as u32;
            if n == i {
                return count as u8;
            }
            if vf_is_interactive(g.kind[n]) {
                count = count + 1;
            }
            k = k + 1;
        }
    }

    return VF_NO_FOCUS;
}

pub fn vf_snapshot(g: VfGraph) -> VfSnapshot {
    var s : VfSnapshot = vf_blank_snapshot();
    s.code = vf_validate(g);
    if s.code != 0 {
        return s;
    }

    let l : VfLayout = vf_layout(g);
    s.node_count = g.node_count;
    s.theme = g.theme;
    s.viewport_w = g.viewport_w;
    s.viewport_h = g.viewport_h;
    s.contract_version = g.contract_version;

    var i : u32 = 0;
    while i < g.node_count {
        s.kind[i] = g.kind[i];
        s.x[i] = l.x[i];
        s.y[i] = l.y[i];
        s.w[i] = l.w[i];
        s.h[i] = l.h[i];
        s.role[i] = vf_role(g.kind[i]);
        s.name[i] = vf_accessible_name(g, i);
        s.focus[i] = vf_focus_of(g, i);
        s.test_id[i] = g.test_id[i];
        i = i + 1;
    }

    return s;
}

pub fn vf_snapshot_equal(a: VfSnapshot, b: VfSnapshot) -> bool {
    if a.code != b.code {
        return false;
    }
    if a.node_count != b.node_count {
        return false;
    }
    if a.theme != b.theme {
        return false;
    }
    if a.viewport_w != b.viewport_w {
        return false;
    }
    if a.viewport_h != b.viewport_h {
        return false;
    }
    if a.contract_version != b.contract_version {
        return false;
    }

    var i : u32 = 0;
    while i < 16 {
        if a.kind[i] != b.kind[i] {
            return false;
        }
        if a.x[i] != b.x[i] {
            return false;
        }
        if a.y[i] != b.y[i] {
            return false;
        }
        if a.w[i] != b.w[i] {
            return false;
        }
        if a.h[i] != b.h[i] {
            return false;
        }
        if a.role[i] != b.role[i] {
            return false;
        }
        let name_a : str = a.name[i];
        let name_b : str = b.name[i];
        let same_name : bool = name_a == name_b;
        if same_name == false {
            return false;
        }
        if a.focus[i] != b.focus[i] {
            return false;
        }
        let tid_a : str = a.test_id[i];
        let tid_b : str = b.test_id[i];
        let same_test_id : bool = tid_a == tid_b;
        if same_test_id == false {
            return false;
        }
        i = i + 1;
    }

    return true;
}

; theme name of a valid snapshot; an invalid snapshot carries theme 0
pub fn vf_snapshot_theme_name(s: VfSnapshot) -> str {
    return VF_THEME_NAMES[s.theme as u32];
}

; kind name of row i, "" when past the end
pub fn vf_snapshot_kind_name(s: VfSnapshot, i: u32) -> str {
    if i >= s.node_count {
        return "";
    }
    return VF_NAMES[s.kind[i] as u32];
}

; role name of row i, "" when past the end
pub fn vf_snapshot_role_name(s: VfSnapshot, i: u32) -> str {
    if i >= s.node_count {
        return "";
    }
    return ROLE_NAMES[s.role[i] as u32];
}

pub fn vf_a11y_check(s: VfSnapshot) -> u8 {
    if s.code != 0 {
        return A11Y_INVALID;
    }

    var i : u32 = 0;
    while i < s.node_count {
        if vf_is_interactive(s.kind[i]) {
            if s.name[i] == "" {
                return A11Y_NAME;
            }
        }
        i = i + 1;
    }

    i = 0;
    while i < s.node_count {
        if s.kind[i] == VF_BUTTON {
            if s.role[i] != BUTTON {
                return A11Y_BUTTON_ROLE;
            }
        }
        i = i + 1;
    }

    i = 0;
    while i < s.node_count {
        if s.kind[i] == VF_TEXT {
            if s.name[i] == "" {
                return A11Y_TEXT;
            }
        }
        i = i + 1;
    }

    var n : u32 = 0;
    i = 0;
    while i < s.node_count {
        if vf_is_interactive(s.kind[i]) {
            if s.focus[i] == VF_NO_FOCUS {
                return A11Y_FOCUS;
            }
            n = n + 1;
        } else {
            if s.focus[i] != VF_NO_FOCUS {
                return A11Y_FOCUS;
            }
        }
        i = i + 1;
    }

    var v : u32 = 0;
    while v < n {
        var hits : u32 = 0;
        i = 0;
        while i < s.node_count {
            if s.focus[i] == v as u8 {
                hits = hits + 1;
            }
            i = i + 1;
        }
        if hits != 1 {
            return A11Y_FOCUS;
        }
        v = v + 1;
    }

    return A11Y_OK;
}

; test fixture: child order differs from index order
pub fn vf_fix_focus() -> VfGraph {
    var g : VfGraph = vf_blank_graph();
    var g0 : VfGraph = vf_add(g, VF_STACK, VF_NO_PARENT, bit(P_TEST_ID), "root");
    var g1 : VfGraph = vf_add(g0, VF_STACK, 0, bit(P_TEST_ID), "a");
    var g2 : VfGraph = vf_add(g1, VF_STACK, 0, bit(P_TEST_ID), "b");
    var g3 : VfGraph = vf_add(g2, VF_BUTTON, 2, bit(P_TEST_ID) + bit(P_TEXT), "b1");
    var g4 : VfGraph = vf_add(g3, VF_BUTTON, 1, bit(P_TEST_ID) + bit(P_TEXT), "a1");

    g4.text[3] = "B1";
    g4.text[4] = "A1";

    return g4;
}

test manifest_copies_preview_consts {
    let m : VfManifest = vf_manifest("task-card", "task-card");
    assert m.story == "task-card";
    assert m.entry == "task-card";
    assert m.contract_version == 1;
    assert m.viewports[0] == 375;
    assert m.viewports[1] == 768;
    assert m.viewports[2] == 1280;
    assert m.themes[0] == 0;
    assert m.themes[1] == 1;
    assert m.themes[2] == 2;
}

test task_card_rects_at_375 {
    let g : VfGraph = task_card_graph();
    let s : VfSnapshot = vf_snapshot(g);
    let l : VfLayout = vf_layout(g);
    assert s.code == 0;
    assert s.node_count == 8;
    // the 83 px title wraps to 2 lines in its 80 px box (vf_text_measure), so it is 30 tall and the card is 202
    assert vf_rect_is(l, 0, 0, 0, 375, 202);
    assert vf_rect_is(l, 1, 8, 8, 80, 30);
    assert vf_rect_is(l, 2, 8, 46, 48, 24);
    assert vf_rect_is(l, 3, 8, 78, 80, 20);
    assert vf_rect_is(l, 4, 8, 106, 160, 40);
    assert vf_rect_is(l, 5, 8, 154, 200, 40);
    assert vf_rect_is(l, 6, 8, 154, 96, 40);
    assert vf_rect_is(l, 7, 112, 154, 96, 40);
}

test task_card_wide_viewports {
    var g : VfGraph = task_card_graph();

    g.viewport_w = 768;
    var l : VfLayout = vf_layout(g);
    assert vf_rect_is(l, 0, 0, 0, 768, 202);
    assert vf_rect_is(l, 4, 8, 106, 160, 40);
    assert vf_rect_is(l, 7, 112, 154, 96, 40);

    g.viewport_w = 1280;
    l = vf_layout(g);
    assert vf_rect_is(l, 0, 0, 0, 1280, 202);
    assert vf_rect_is(l, 4, 8, 106, 160, 40);
    assert vf_rect_is(l, 7, 112, 154, 96, 40);
}

test task_card_roles_and_names {
    let s : VfSnapshot = vf_snapshot(task_card_graph());
    assert s.role[0] == 7;
    assert s.role[1] == 2;
    assert s.role[2] == 5;
    assert s.role[3] == 2;
    assert s.role[4] == 4;
    assert s.role[5] == 1;
    assert s.role[6] == 3;
    assert s.role[7] == 3;

    assert s.name[0] == "Task card";
    assert s.name[1] == "Write the spec";
    assert s.name[2] == "Open";
    assert s.name[3] == "Owner";
    assert s.name[4] == "Owner";
    assert s.name[5] == "";
    assert s.name[6] == "Save";
    assert s.name[7] == "Cancel";
}

test task_card_focus_order {
    let s : VfSnapshot = vf_snapshot(task_card_graph());
    assert s.focus[0] == 255;
    assert s.focus[1] == 255;
    assert s.focus[2] == 255;
    assert s.focus[3] == 255;
    assert s.focus[4] == 0;
    assert s.focus[5] == 255;
    assert s.focus[6] == 1;
    assert s.focus[7] == 2;
}

test child_order_fixture {
    let g : VfGraph = vf_fix_focus();
    assert vf_validate(g) == 0;
    assert vf_preorder_at(g, 0) == 0;
    assert vf_preorder_at(g, 1) == 1;
    assert vf_preorder_at(g, 2) == 4;
    assert vf_preorder_at(g, 3) == 2;
    assert vf_preorder_at(g, 4) == 3;
    assert vf_preorder_at(g, 5) == 255;
    assert vf_focus_of(g, 3) == 1;
    assert vf_focus_of(g, 4) == 0;
    assert vf_focus_of(g, 0) == 255;
}

test task_card_rows {
    let s : VfSnapshot = vf_snapshot(task_card_graph());
    assert s.contract_version == 1;
    assert vf_snapshot_theme_name(s) == "light";
    assert s.viewport_w == 375;
    assert s.viewport_h == 812;
    assert s.node_count == 8;

    assert vf_snapshot_kind_name(s, 0) == "card";
    assert vf_snapshot_kind_name(s, 1) == "text";
    assert vf_snapshot_kind_name(s, 2) == "badge";
    assert vf_snapshot_kind_name(s, 3) == "text";
    assert vf_snapshot_kind_name(s, 4) == "input";
    assert vf_snapshot_kind_name(s, 5) == "stack";
    assert vf_snapshot_kind_name(s, 6) == "button";
    assert vf_snapshot_kind_name(s, 7) == "button";

    assert vf_snapshot_role_name(s, 0) == "article";
    assert vf_snapshot_role_name(s, 1) == "text";
    assert vf_snapshot_role_name(s, 2) == "status";
    assert vf_snapshot_role_name(s, 3) == "text";
    assert vf_snapshot_role_name(s, 4) == "textbox";
    assert vf_snapshot_role_name(s, 5) == "group";
    assert vf_snapshot_role_name(s, 6) == "button";
    assert vf_snapshot_role_name(s, 7) == "button";

    assert s.test_id[0] == "task-card";
    assert s.test_id[1] == "title";
    assert s.test_id[2] == "status";
    assert s.test_id[3] == "owner-label";
    assert s.test_id[4] == "owner-input";
    assert s.test_id[5] == "actions";
    assert s.test_id[6] == "save";
    assert s.test_id[7] == "cancel";

    assert vf_snapshot_kind_name(s, 8) == "";
    assert vf_snapshot_role_name(s, 8) == "";
}

test determinism_and_invalid {
    let g : VfGraph = task_card_graph();
    assert vf_snapshot_equal(vf_snapshot(g), vf_snapshot(g)) == true;

    let b : VfSnapshot = vf_snapshot(vf_blank_graph());
    assert b.code == 4;
    assert b.node_count == 0;
    assert b.viewport_w == 0;
    assert b.contract_version == 0;
    assert vf_snapshot_kind_name(b, 0) == "";
}

test a11y_rules {
    var good : VfSnapshot = vf_snapshot(task_card_graph());
    assert vf_a11y_check(good) == A11Y_OK;

    var wide : VfGraph = task_card_graph();
    wide.viewport_w = 1280;
    assert vf_a11y_check(vf_snapshot(wide)) == A11Y_OK;

    var no_name : VfSnapshot = vf_snapshot(task_card_graph());
    no_name.name[6] = "";
    assert vf_a11y_check(no_name) == A11Y_NAME;

    var bad_role : VfSnapshot = vf_snapshot(task_card_graph());
    bad_role.role[7] = 2;
    assert vf_a11y_check(bad_role) == A11Y_BUTTON_ROLE;

    var no_text : VfSnapshot = vf_snapshot(task_card_graph());
    no_text.name[1] = "";
    assert vf_a11y_check(no_text) == A11Y_TEXT;

    var bad_focus : VfSnapshot = vf_snapshot(task_card_graph());
    bad_focus.focus[6] = 0;
    assert vf_a11y_check(bad_focus) == A11Y_FOCUS;

    assert vf_a11y_check(vf_snapshot(vf_blank_graph())) == A11Y_INVALID;
}
