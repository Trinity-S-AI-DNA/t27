// specs/t27f/netlist_graph.t27 -- t27f: netlist_graph, a SPICE deck drawn as
// the T27F graph (SVG and seal pending).
// Part of M7 milestone (milestone #11). Closes #13221.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27f::netlist_graph;

pub const NETLIST_GRAPH_MAX_NODES : u32 = 256;

pub struct NetlistNode { id: str, drawn: bool };

pub fn netlist_node_drawn(n: NetlistNode) -> bool {
    return n.drawn;
}

test "netlist_node_drawn" {
    assert(netlist_node_drawn(NetlistNode { id: "n1", drawn: true }));
    assert(!netlist_node_drawn(NetlistNode { id: "n2", drawn: false }));
}

invariant netlist_graph_max_nodes_positive {
    assert NETLIST_GRAPH_MAX_NODES > 0;
}