// SPDX-License-Identifier: Apache-2.0
; specs/t27f/netlist_graph.t27 -- typed netlist graph IR for the T27F visual constructor.
; Ring 2, Wave B1 of epic #13650.  Closes #13711.
; Nodes: BLOCK INSTANCE NET PIN DEVICE REFUSAL.
; Edges: CONTAINS CONNECTS INSTANTIATES.
; Inference labels: EXACT DERIVED SUGGESTED UNKNOWN (shared convention with spec_graph).
; No colour, size or coordinate is defined here.  Refs #13650.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module t27f_netlist_graph;

; ── IR version ───────────────────────────────────────────────────────────────
pub const NG_IR_VERSION : u32 = 1;

; ── Capacity ─────────────────────────────────────────────────────────────────
pub const NG_MAX_NODES : u32 = 1024;
pub const NG_MAX_EDGES : u32 = 4096;

; ── Node kinds ───────────────────────────────────────────────────────────────
pub const NG_NODE_BLOCK    : u8 = 0;
pub const NG_NODE_INSTANCE : u8 = 1;
pub const NG_NODE_NET      : u8 = 2;
pub const NG_NODE_PIN      : u8 = 3;
pub const NG_NODE_DEVICE   : u8 = 4;
pub const NG_NODE_REFUSAL  : u8 = 5;
pub const NG_NODE_KINDS    : u8 = 6;

; ── Edge kinds ───────────────────────────────────────────────────────────────
pub const NG_EDGE_CONTAINS     : u8 = 0;
pub const NG_EDGE_CONNECTS     : u8 = 1;
pub const NG_EDGE_INSTANTIATES : u8 = 2;
pub const NG_EDGE_KINDS        : u8 = 3;

; ── Inference labels ─────────────────────────────────────────────────────────
pub const NG_LABEL_EXACT     : u8 = 0;
pub const NG_LABEL_DERIVED   : u8 = 1;
pub const NG_LABEL_SUGGESTED : u8 = 2;
pub const NG_LABEL_UNKNOWN   : u8 = 3;
pub const NG_LABEL_KINDS     : u8 = 4;

; ── Validation verdicts ──────────────────────────────────────────────────────
pub const NGRAPH_OK                 : u32 = 0;
pub const ERR_NG_VERSION            : u32 = 1;
pub const ERR_NG_PATH               : u32 = 2;
pub const ERR_NG_TOO_MANY_NODES     : u32 = 3;
pub const ERR_NG_TOO_MANY_EDGES     : u32 = 4;
pub const ERR_NG_NODE_KIND          : u32 = 5;
pub const ERR_NG_LABEL              : u32 = 6;
pub const ERR_NG_NODE_NAME          : u32 = 7;
pub const ERR_NG_EDGE_KIND          : u32 = 8;
pub const ERR_NG_EDGE_DANGLING      : u32 = 9;
pub const ERR_NG_EDGE_ENDPOINT_KIND : u32 = 10;
pub const ERR_NG_EDGE_UNKNOWN_NODE  : u32 = 11;
pub const ERR_NG_DUPLICATE_EDGE     : u32 = 12;

; ── Edge endpoint kind masks ─────────────────────────────────────────────────
; NG_EDGE_FROM_KINDS[e] = bit-mask of allowed from-node kinds for edge kind e.
; NG_EDGE_TO_KINDS[e]   = bit-mask of allowed to-node kinds for edge kind e.
; Bit k corresponds to node kind k.
;   CONTAINS(0):     from BLOCK(bit0=1)      to INSTANCE|NET|PIN|DEVICE (2|4|8|16=30)
;   CONNECTS(1):     from NET(bit2=4)         to PIN|DEVICE (8|16=24)
;   INSTANTIATES(2): from INSTANCE(bit1=2)    to BLOCK(bit0=1)
pub const NG_EDGE_FROM_KINDS : [3]u32 = [1, 4, 2];
pub const NG_EDGE_TO_KINDS   : [3]u32 = [30, 24, 1];

; ── NetlistGraph struct ───────────────────────────────────────────────────────
; Node arrays are indexed 0..node_count-1; edge arrays 0..edge_count-1.
; node_line is a 1-based source line of the netlist file at netlist_path.
pub struct NetlistGraph {
    ir_version   : u32,
    netlist_path : str,
    line_count   : u32,
    node_count   : u32,
    node_kind    : [1024]u8,
    node_label   : [1024]u8,
    node_name    : [1024]str,
    node_line    : [1024]u32,
    edge_count   : u32,
    edge_kind    : [4096]u8,
    edge_from    : [4096]u32,
    edge_to      : [4096]u32,
    edge_line    : [4096]u32,
}

; ── Helpers ───────────────────────────────────────────────────────────────────
pub fn ng_kind_bit(k: u8) -> u32 {
    return (1 as u32) << (k as u32);
}

pub fn ng_valid_node_kind(k: u8) -> bool {
    return k < NG_NODE_KINDS;
}

pub fn ng_valid_edge_kind(k: u8) -> bool {
    return k < NG_EDGE_KINDS;
}

pub fn ng_valid_label(l: u8) -> bool {
    return l < NG_LABEL_KINDS;
}

; ── Node validator ───────────────────────────────────────────────────────────
; Checks: known kind, known label, non-empty name.
pub fn validate_node(g: NetlistGraph, n: u32) -> u32 {
    let k : usize = n as usize;
    if (ng_valid_node_kind(g.node_kind[k]) == false) { return ERR_NG_NODE_KIND; }
    if (ng_valid_label(g.node_label[k]) == false)    { return ERR_NG_LABEL; }
    if (g.node_name[k] == "")                        { return ERR_NG_NODE_NAME; }
    return NGRAPH_OK;
}

; ── Edge validator ────────────────────────────────────────────────────────────
; Checks (in order): known kind, both endpoints exist and are distinct (dangling
; guard), neither endpoint carries LABEL_UNKNOWN (refusal guard), from-node kind
; in FROM_KINDS mask, to-node kind in TO_KINDS mask, no earlier duplicate edge.
pub fn validate_edge(g: NetlistGraph, j: u32) -> u32 {
    let k  : usize = j as usize;
    let ek : u8    = g.edge_kind[k];
    if (ng_valid_edge_kind(ek) == false) { return ERR_NG_EDGE_KIND; }
    let f : u32 = g.edge_from[k];
    let t : u32 = g.edge_to[k];
    if (f >= g.node_count or t >= g.node_count or f == t) { return ERR_NG_EDGE_DANGLING; }
    let fl : u8 = g.node_label[f as usize];
    let tl : u8 = g.node_label[t as usize];
    if (fl == NG_LABEL_UNKNOWN or tl == NG_LABEL_UNKNOWN) { return ERR_NG_EDGE_UNKNOWN_NODE; }
    let fk : u8 = g.node_kind[f as usize];
    let tk : u8 = g.node_kind[t as usize];
    if ((NG_EDGE_FROM_KINDS[ek as usize] & ng_kind_bit(fk)) == 0) { return ERR_NG_EDGE_ENDPOINT_KIND; }
    if ((NG_EDGE_TO_KINDS[ek as usize]   & ng_kind_bit(tk)) == 0) { return ERR_NG_EDGE_ENDPOINT_KIND; }
    var i : u32 = 0;
    while (i < j) {
        let m : usize = i as usize;
        if (g.edge_kind[m] == ek and g.edge_from[m] == f and g.edge_to[m] == t) { return ERR_NG_DUPLICATE_EDGE; }
        i = i + 1;
    }
    return NGRAPH_OK;
}

; ── Header validator ─────────────────────────────────────────────────────────
pub fn validate_graph_header(g: NetlistGraph) -> u32 {
    if (g.ir_version != NG_IR_VERSION) { return ERR_NG_VERSION; }
    if (g.netlist_path == "")          { return ERR_NG_PATH; }
    if (g.node_count > NG_MAX_NODES)   { return ERR_NG_TOO_MANY_NODES; }
    if (g.edge_count > NG_MAX_EDGES)   { return ERR_NG_TOO_MANY_EDGES; }
    return NGRAPH_OK;
}

; ── Full graph validator ──────────────────────────────────────────────────────
pub fn validate_graph(g: NetlistGraph) -> u32 {
    let h : u32 = validate_graph_header(g);
    if (h != NGRAPH_OK) { return h; }
    var n : u32 = 0;
    while (n < g.node_count) {
        let v : u32 = validate_node(g, n);
        if (v != NGRAPH_OK) { return v; }
        n = n + 1;
    }
    var j : u32 = 0;
    while (j < g.edge_count) {
        let w : u32 = validate_edge(g, j);
        if (w != NGRAPH_OK) { return w; }
        j = j + 1;
    }
    return NGRAPH_OK;
}

; ── Builder helpers ───────────────────────────────────────────────────────────
pub fn blank_graph() -> NetlistGraph {
    var h : NetlistGraph;
    h.ir_version   = NG_IR_VERSION;
    h.netlist_path = "";
    h.line_count   = 0;
    h.node_count   = 0;
    h.node_kind    = [0; 1024];
    h.node_label   = [0; 1024];
    h.node_line    = [0; 1024];
    h.edge_count   = 0;
    h.edge_kind    = [0; 4096];
    h.edge_from    = [0; 4096];
    h.edge_to      = [0; 4096];
    h.edge_line    = [0; 4096];
    var i : u32 = 0;
    while (i < NG_MAX_NODES) {
        h.node_name[i as usize] = "";
        i = i + 1;
    }
    return h;
}

pub fn with_node(g: NetlistGraph, kind: u8, label: u8, name: str, line: u32) -> NetlistGraph {
    var h : NetlistGraph = g;
    if (h.node_count < NG_MAX_NODES) {
        let k : usize = h.node_count as usize;
        h.node_kind[k]  = kind;
        h.node_label[k] = label;
        h.node_name[k]  = name;
        h.node_line[k]  = line;
    }
    h.node_count = h.node_count + 1;
    return h;
}

pub fn with_edge(g: NetlistGraph, kind: u8, f: u32, t: u32, line: u32) -> NetlistGraph {
    var h : NetlistGraph = g;
    if (h.edge_count < NG_MAX_EDGES) {
        let k : usize = h.edge_count as usize;
        h.edge_kind[k] = kind;
        h.edge_from[k] = f;
        h.edge_to[k]   = t;
        h.edge_line[k] = line;
    }
    h.edge_count = h.edge_count + 1;
    return h;
}

; ── Fixture: minimal SPICE inverter subcircuit ────────────────────────────────
; Line map (1-based):
;   1  .subckt inv in out
;   2  mp out in vdd pmos W=1u L=90n
;   3  mn out in vss nmos W=1u L=90n
;   4  .ends inv
; Nodes: 0=BLOCK(inv) 1=PIN(in) 2=PIN(out) 3=DEVICE(mn) 4=DEVICE(mp).
; Edges: 4 x CONTAINS from BLOCK(0) to each child.
pub fn inverter_graph() -> NetlistGraph {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test/fixtures/inverter.sp";
    g.line_count = 4;
    g = with_node(g, NG_NODE_BLOCK,  NG_LABEL_EXACT, "inv", 1);
    g = with_node(g, NG_NODE_PIN,    NG_LABEL_EXACT, "in",  2);
    g = with_node(g, NG_NODE_PIN,    NG_LABEL_EXACT, "out", 2);
    g = with_node(g, NG_NODE_DEVICE, NG_LABEL_EXACT, "mn",  3);
    g = with_node(g, NG_NODE_DEVICE, NG_LABEL_EXACT, "mp",  4);
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 1, 2);
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 2, 2);
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 3, 3);
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 4, 4);
    return g;
}

; ── Tests ─────────────────────────────────────────────────────────────────────
test valid_inverter {
    let g : NetlistGraph = inverter_graph();
    assert validate_graph(g) == NGRAPH_OK;
    assert g.node_count == 5;
    assert g.edge_count == 4;
}

test self_loop_refused {
    var g : NetlistGraph = inverter_graph();
    g = with_edge(g, NG_EDGE_CONTAINS, 1, 1, 2);
    assert validate_graph(g) == ERR_NG_EDGE_DANGLING;
}

test bad_node_kind_refused {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.line_count = 1;
    g.node_count = 1;
    g.node_kind[0] = NG_NODE_KINDS;
    g.node_label[0] = NG_LABEL_EXACT;
    g.node_name[0] = "bad";
    assert validate_graph(g) == ERR_NG_NODE_KIND;
}

test bad_version_refused {
    var g : NetlistGraph = inverter_graph();
    g.ir_version = 0;
    assert validate_graph(g) == ERR_NG_VERSION;
}

test empty_path_refused {
    var g : NetlistGraph = inverter_graph();
    g.netlist_path = "";
    assert validate_graph(g) == ERR_NG_PATH;
}

test too_many_nodes_refused {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.node_count = NG_MAX_NODES + 1;
    assert validate_graph(g) == ERR_NG_TOO_MANY_NODES;
}

test too_many_edges_refused {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.edge_count = NG_MAX_EDGES + 1;
    assert validate_graph(g) == ERR_NG_TOO_MANY_EDGES;
}

test bad_label_refused {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.line_count = 1;
    g.node_count = 1;
    g.node_kind[0] = NG_NODE_BLOCK;
    g.node_label[0] = NG_LABEL_KINDS;
    g.node_name[0] = "bad";
    assert validate_graph(g) == ERR_NG_LABEL;
}

test empty_node_name_refused {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.line_count = 1;
    g.node_count = 1;
    g.node_kind[0] = NG_NODE_BLOCK;
    g.node_label[0] = NG_LABEL_EXACT;
    assert validate_graph(g) == ERR_NG_NODE_NAME;
}

test bad_edge_kind_refused {
    var g : NetlistGraph = inverter_graph();
    g = with_edge(g, NG_EDGE_KINDS, 0, 1, 2);
    assert validate_graph(g) == ERR_NG_EDGE_KIND;
}

test dangling_edge_refused {
    var g : NetlistGraph = inverter_graph();
    g = with_edge(g, NG_EDGE_CONTAINS, 100, 1, 2);
    assert validate_graph(g) == ERR_NG_EDGE_DANGLING;
}

test endpoint_kind_mismatch_refused {
    var g : NetlistGraph = inverter_graph();
    g = with_edge(g, NG_EDGE_CONNECTS, 1, 2, 2);
    assert validate_graph(g) == ERR_NG_EDGE_ENDPOINT_KIND;
}

test duplicate_edge_refused {
    var g : NetlistGraph = inverter_graph();
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 1, 2);
    assert validate_graph(g) == ERR_NG_DUPLICATE_EDGE;
}

test unknown_node_blocks_edge {
    var g : NetlistGraph = blank_graph();
    g.netlist_path = "test.sp";
    g.line_count = 2;
    g = with_node(g, NG_NODE_BLOCK,   NG_LABEL_EXACT,   "blk",  1);
    g = with_node(g, NG_NODE_REFUSAL, NG_LABEL_UNKNOWN, "ref1", 2);
    g = with_edge(g, NG_EDGE_CONTAINS, 0, 1, 2);
    assert validate_graph(g) == ERR_NG_EDGE_UNKNOWN_NODE;
}

; ── Invariants ────────────────────────────────────────────────────────────────
invariant ng_ok_is_zero {
    assert NGRAPH_OK == 0;
}

invariant ng_capacity_set {
    assert NG_MAX_NODES == 1024;
    assert NG_MAX_EDGES == 4096;
}

invariant contains_allows_device_child {
    assert (NG_EDGE_TO_KINDS[0] & 16) != 0;
}
