// SPDX-License-Identifier: Apache-2.0
; improved_error_messages.t27 -- demonstrate improved error messages
; This spec shows how t27c can provide better error messages
; phi^2 + 1/phi^2 = 3 | TRINITY

module error_demo;

// This spec contains intentional errors to demonstrate improved messaging

// Error 1: Missing type annotation (should show helpful error)
pub fn missing_type_annotation(param) {
    return param + 1;  // Missing type for param and return
}

// Error 2: Unused variable (should show warning)
pub fn unused_variable(x: i8) i8 {
    const y = 42;  // y is never used
    return x;
}

// Error 3: Type mismatch (should show expected vs actual)
pub fn type_mismatch(a: i8, b: u8) i8 {
    return a + b;  // i8 + u8 is invalid
}

// Error 4: Infinite loop (should show warning)
pub fn infinite_loop() i8 {
    while (true) {
        // No break condition
    }
    return 0;
}

// Error 5: Invalid struct field (should show available fields)
pub const InvalidStruct = struct {
    valid_field: i8,
    invalid_field: bool,  // This field doesn't exist in actual usage
};

pub fn use_invalid_struct() InvalidStruct {
    return InvalidStruct{
        .valid_field = 42,
        .invalid_field = true,  // Error: field doesn't exist
    };
}

// Valid function for comparison
pub fn valid_function(x: i8) i8 {
    if (x > 0) {
        return x * 2;
    } else {
        return x;
    }
}

test "valid function test" {
    try std.testing.expectEqual(@as(i8, 4), valid_function(2));
    try std.testing.expectEqual(@as(i8, -2), valid_function(-1));
}

invariant valid_function_returns_zero_for_zero
    assert valid_function(0) == 0