pub const LICENSE : str = "apache-2.0";
pub const MODEL_URL : str = "https://huggingface.co/playra/hslm-t27-2m";
pub const SOURCE_URL : str = "https://github.com/gHashTag/t27";
pub const STATUS : str = "published";

