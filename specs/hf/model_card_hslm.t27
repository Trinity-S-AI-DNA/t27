// SPDX-License-Identifier: Apache-2.0
// specs/hf/model_card_hslm.t27 -- source of truth for the Hugging Face model
// card of HSLM (playra/hslm-t27-2m), the 2.13M-parameter ternary language model
// trained end to end by a t27 program. Issue: gHashTag/t27#10372 (epic #10024,
// own_model cell 25).
//
// Every number below is read from /tmp/hslm/run.log of run 2 (train_hslm,
// 8000 steps, Railway lab), from eval_8000_w19683.txt (eval_hslm, 19683
// held-out windows), from ngram.txt (ngram_hslm, the count baselines on the same
// tokens and windows), from sha256sum and wc -c of the released files on the
// lab, derived from the shapes by the tests, or is the string "not measured".
// Zero is never used to mean unknown. Same structure as the IGLA-Coder cards
// (gHashTag/igla-coder-gpu specs/hf/model_card_500m.t27). ASCII only (L3),
// English only (LANG-EN).
// phi^2 + 1/phi^2 = 3 | TRINITY

module hf_model_card_hslm;

pub const KIND : str = "hf-model-card";
pub const ID : str = "hf/hslm_t27_2m";
