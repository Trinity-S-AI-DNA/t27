// -- The package -------------------------------------------------------------
pub const FILES : [8]str = ["README.md", "model_card.t27", "LICENSE", "ckpt_8000.state", "ckpt_8000.bin", "run.log", "eval_8000_w19683.txt", "ngram.txt"];


// Comparison helpers. t27c folds an assert over constants at compile time and
// counts it as a vacuous pass (#6509, T730); routing the comparison through a
// function makes every assert below a runtime assert.
fn eq(a : u64, b : u64) -> bool { return a == b; }
fn le(a : u64, b : u64) -> bool { return a <= b; }
fn lt(a : u64, b : u64) -> bool { return a < b; }
fn ge(a : u64, b : u64) -> bool { return a >= b; }
fn gt(a : u64, b : u64) -> bool { return a > b; }

// Bits per byte times 10000 from a loss in nats times 10000:
// loss / ln 2 * tokens / bytes, ln 2 = 0.693147. True when bpb_e4 is within 1.
fn bpb_within_one(loss_e4 : u64, tokens : u64, bytes : u64, bpb_e4 : u64) -> bool {
    var num : u64 = loss_e4 * 1000000 * tokens;
    var den : u64 = 693147 * bytes;
    return (bpb_e4 - 1) * den <= num and num <= (bpb_e4 + 1) * den;
}

// True when every curve value is below the one before it.
fn curve_falls() -> bool {
    var i : usize = 1;
    while (i < 17) {
        if (CURVE_VALID_FULL_E4[i] >= CURVE_VALID_FULL_E4[i - 1]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// -- Invariants. The card may not render unless these hold. -----------------
test config_is_powers_of_three {
    assert eq(CTX, 3 * 3 * 3);
    assert eq(EMBED, 3 * 3 * 3 * 3 * 3);
    assert eq(VOCAB, 3 * EMBED);
    assert eq(FF, VOCAB);
    assert eq(HEAD_DIM, 3 * CTX);
    assert eq(N_HEAD * HEAD_DIM, EMBED);
    assert eq(N_BLOCK, 3);
}

test parameter_accounting {
    // per block: Q, K, V, O are 243 x 243; up 243 x 729; down 729 x 243; plus the head 243 x 729
    assert eq(PARAMS_TERNARY, N_BLOCK * (4 * EMBED * EMBED + 2 * EMBED * FF) + EMBED * VOCAB);
    assert eq(TERNARY_MATRICES, N_BLOCK * 6 + 1);
    assert eq(PARAMS_EMBED, VOCAB * EMBED);
    // per block floats: RMSNorm gain 243, bias_up 729, bias_down 243
    assert eq(BLOCK_FLOAT_PARAMS, EMBED + FF + EMBED);
    assert eq(PARAMS_TOTAL, PARAMS_TERNARY + PARAMS_EMBED + N_BLOCK * BLOCK_FLOAT_PARAMS + OUT_BIAS);
    assert eq(PARAMS_TOTAL, 2130138);
    // segments: the embedding, 9 per block, the head matrix and its bias
    assert eq(SEGMENTS, 1 + N_BLOCK * 9 + 2);
}

test tokenizer_fills_the_vocabulary {
    assert eq(TOK_SPECIALS + TOK_BYTES + TOK_MERGES, VOCAB);
}

test token_files_match_their_counts {
    // HTOK: "HTOK", u32 version, u32 N, then N u16 ids
    assert eq(TRAIN_TOK_BYTES, 12 + 2 * TRAIN_TOKENS);
    assert eq(VALID_TOK_BYTES, 12 + 2 * VALID_TOKENS);
    assert le(TRAIN_TXT_BYTES, TRAIN_RAW_BYTES);
    assert gt(TRAIN_TXT_BYTES + 1000, TRAIN_RAW_BYTES);
    // about 2.9 bytes per token on both files
    assert gt(VALID_TXT_BYTES * 10, VALID_TOKENS * 29);
    assert lt(VALID_TXT_BYTES * 10, VALID_TOKENS * 30);
    assert gt(TRAIN_TXT_BYTES * 10, TRAIN_TOKENS * 29);
    assert lt(TRAIN_TXT_BYTES * 10, TRAIN_TOKENS * 30);
}

test training_arithmetic {
    assert eq(TRAIN_TOKENS_SEEN, TRAIN_BATCH * CTX * TRAIN_STEPS);
    assert eq(TRAIN_STEPS, TRAIN_TOTAL);
    assert eq(4 * TRAIN_STEPS, DEFAULT_STEPS);
    assert lt(TRAIN_WARMUP, TRAIN_STEPS);
    assert eq(LOSS_POSITIONS, CTX);
    // 1.67 passes over the train tokens
    assert gt(TRAIN_TOKENS_SEEN * 100, TRAIN_TOKENS * 166);
    assert lt(TRAIN_TOKENS_SEEN * 100, TRAIN_TOKENS * 167);
    assert eq(TRAIN_SEED, 1729);
}

test speed_follows_from_the_done_line {
    // tokens / train_s = 306.69 tokens/s, printed 306.7 (within half a unit of the last digit)
    assert ge(TRAIN_TOKENS_SEEN * 2000, (TOK_PER_S_E1 * 2 - 1) * TRAIN_S_E2);
    assert lt(TRAIN_TOKENS_SEEN * 2000, (TOK_PER_S_E1 * 2 + 1) * TRAIN_S_E2);
    // train_s / steps = 5.8104 s per step, the same way
    assert ge(TRAIN_S_E2 * 200, (S_PER_STEP_E4 * 2 - 1) * TRAIN_STEPS);
    assert lt(TRAIN_S_E2 * 200, (S_PER_STEP_E4 * 2 + 1) * TRAIN_STEPS);
    assert le(TRAIN_S_E2, WALL_S_E2);
    assert eq(IO_FAIL, 0);
    assert TRAIN_COST == "not measured";
}

test the_curve_starts_at_a_uniform_guess_and_falls {
    assert eq(CURVE_STEPS[16], TRAIN_STEPS);
    assert eq(CURVE_STEPS[1] - CURVE_STEPS[0], 500);
    assert curve_falls();
    // step 0 is within 0.02 nats of ln 729
    assert lt(CURVE_VALID_FULL_E4[0], LN_VOCAB_E4 + 200);
    assert gt(CURVE_VALID_FULL_E4[0], LN_VOCAB_E4 - 200);
    // the monitor's last-position loss at 8000 is run.log valid_loss 3.2332
    assert eq(MONITOR_LAST_E4, 32332);
    // the held-out measure is higher than the 243-window monitor
    assert gt(EVAL_FULL_LOSS_E4, CURVE_VALID_FULL_E4[16]);
    // train and held-out loss are within 0.02 nats: no sign of overfitting
    assert lt(EVAL_FULL_LOSS_E4, TRAIN_LOSS_LAST_E4 + 200);
    assert gt(EVAL_FULL_LOSS_E4 + 200, TRAIN_LOSS_LAST_E4);
}

test the_held_out_measure_is_stated_honestly {
    assert eq(EVAL_POSITIONS, EVAL_WINDOWS * CTX);
    // 3^12 positions
    assert eq(EVAL_POSITIONS, 531441);
    // about 7 percent of the held-out tokens, not a third
    assert gt(EVAL_POSITIONS * 100, VALID_TOKENS * 6);
    assert lt(EVAL_POSITIONS * 100, VALID_TOKENS * 7);
    // windows 390 tokens apart: (N - 28) / 19683
    assert eq((VALID_TOKENS - 28) / EVAL_WINDOWS, 390);
    assert bpb_within_one(EVAL_FULL_LOSS_E4, STREAM_PREDICTED, VALID_TXT_BYTES, EVAL_BPB_E4);
    assert EVAL_BPB == "about 1.595";
    assert EVAL_CHECK == "check tr_valid_loss 3.229189 last_loss 3.229189 same_bits 1";
}

test baselines_order_the_result {
    // trigram < HSLM < bigram < unigram < uniform, on full-window loss and perplexity
    assert lt(BASE_FULL_LOSS_E4[2], EVAL_FULL_LOSS_E4);
    assert lt(EVAL_FULL_LOSS_E4, BASE_FULL_LOSS_E4[1]);
    assert lt(BASE_FULL_LOSS_E4[1], BASE_FULL_LOSS_E4[0]);
    assert lt(BASE_FULL_LOSS_E4[0], LN_VOCAB_E4);
    assert lt(BASE_FULL_PPL_E2[2], EVAL_FULL_PPL_E2);
    assert lt(EVAL_FULL_PPL_E2, BASE_FULL_PPL_E2[1]);
    assert lt(BASE_FULL_PPL_E2[1], BASE_FULL_PPL_E2[0]);
    assert lt(BASE_FULL_PPL_E2[0], VOCAB * 100);
    // the same order at the last position
    assert lt(BASE_LAST_PPL_E2[2], EVAL_LAST_PPL_E2);
    assert lt(EVAL_LAST_PPL_E2, BASE_LAST_PPL_E2[1]);
    // and in bits per byte
    assert lt(BASE_STREAM_BPB_E4[2], EVAL_BPB_E4);
    assert lt(EVAL_BPB_E4, BASE_STREAM_BPB_E4[1]);
    assert BASE_ORDERS[2] == "trigram";
}

test baseline_bits_per_byte_follow_from_their_loss {
    assert bpb_within_one(BASE_STREAM_LOSS_E4[0], STREAM_PREDICTED, VALID_TXT_BYTES, BASE_STREAM_BPB_E4[0]);
    assert bpb_within_one(BASE_STREAM_LOSS_E4[1], STREAM_PREDICTED, VALID_TXT_BYTES, BASE_STREAM_BPB_E4[1]);
    assert bpb_within_one(BASE_STREAM_LOSS_E4[2], STREAM_PREDICTED, VALID_TXT_BYTES, BASE_STREAM_BPB_E4[2]);
    assert eq(STREAM_PREDICTED + 1, VALID_TOKENS);
    // uniform over 729: ln 729 / ln 2 * tokens / bytes = 3.25 bits per byte
    assert bpb_within_one(LN_VOCAB_E4, STREAM_PREDICTED, VALID_TXT_BYTES, 32496);
}

test checkpoint_sizes_follow_from_the_shapes {
    // the state: header, then parameters, LAMB m and LAMB v, 8 bytes each
    assert eq(STATE_BYTES, STATE_HEADER + 3 * 8 * PARAMS_TOTAL);
    // MSLH: header, then f32 output shadow and per block up, down, bias_up, bias_down
    assert eq(BIN_BYTES, BIN_HEADER + 4 * (EMBED * VOCAB + N_BLOCK * (2 * EMBED * FF + FF + EMBED)));
    // MSLH holds less than the ternary weights: no attention matrices
    assert lt(BIN_BYTES, 4 * PARAMS_TERNARY);
}

test measured_facts_are_the_recorded_ones {
    assert STATUS == "published";
    assert NO_QUALITY_CLAIM == true;
    assert LICENSE == "apache-2.0";
    assert DATA_LICENSE == "CDLA-Sharing-1.0";
    assert MODEL_URL == "https://huggingface.co/playra/hslm-t27-2m";
}

test files_are_pinned {
    assert STATE_SHA256 == "9034e049c61bb237a083bec7bcaccd0ab0a3c7e3bf0b3ef2cd9f1c0eb9e9761b";
    assert BIN_SHA256 == "ae9050f968922d5436dab34a8aa7d1dfa4f01660cefd270c2430cb082c3eec5e";
    assert RUN_LOG_SHA256 == "0180ab209fda0b7c811e1f7df4237d75bebee49162119690de72bf0b5375894e";
    assert EVAL_TXT_SHA256 == "0539cd8207f7fc8cc450c2e53d7f246d5526c970be91c35b2dc290fe15bf345f";
    assert NGRAM_TXT_SHA256 == "6902ba4c3464c4f492cb62167e31bbb17c1d6f8f6c6def8607580f2cc6db8567";
    assert SPEC_SHA256[6] == "fa8490d815bde2815fe9bfa89cb9badab241f580977e59be52fc5902f6f8bb03";
    assert SPECS[6] == "specs/ml/train_hslm.t27";
    assert eq(SPEC_BYTES[6], 88119);
}

test package_layout {
    assert FILES[0] == "README.md";
    assert FILES[1] == "model_card.t27";
    assert FILES[3] == "ckpt_8000.state";
    assert FILES[6] == "eval_8000_w19683.txt";
    assert SPECS[7] == "specs/ml/eval_hslm.t27";
    assert SPECS[8] == "specs/ml/ngram_hslm.t27";
}
