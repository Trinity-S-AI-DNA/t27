}

test collaboration_models_comprehensive {
    const models: CollaborationModels = generate_collaboration_models();

    assert models.strategic_partnership_model.collaboration_potential >= 0.8;
    assert models.technical_collaboration_model.collaboration_potential >= 0.8;
