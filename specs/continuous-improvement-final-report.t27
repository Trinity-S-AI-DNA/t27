test self_critical_analysis {
    const analysis: SelfCriticalAnalysis = generate_self_critical_analysis();

    assert analysis.overall_self_rating >= 0.8;
    assert analysis.strengths.len > 0;
    assert analysis.weaknesses.len > 0;
    assert analysis.improvements_needed.len > 0;
    assert analysis.risk_assessment.len > 0;
    assert analysis.learning_points.len > 0;
