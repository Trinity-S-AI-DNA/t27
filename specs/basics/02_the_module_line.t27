// SPDX-License-Identifier: Apache-2.0
; t27 basics, lesson 2: The module line.
; Every spec names its module once, with module, a name and a semicolon.

module basics_02_the_module_line;

pub const LESSON : u8 = 2;

test the_module_line_names_this_file {
    assert LESSON == 2;
}

fn the_next_lesson(x: u8) -> u8 {
    return x + 1;
}

test the_next_lesson_follows_this_one {
    var lesson : u8 = LESSON;
    assert lesson == 2;
    assert the_next_lesson(lesson) == 3;
}
