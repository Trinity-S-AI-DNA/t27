; t27 basics, lesson 15: Loops: while and for.
; while repeats while a condition holds; for walks a range of numbers.
; The variable of a for over a range is a usize, so sum_to converts it to the sum's type before adding.

module basics_15_loops;

pub fn sum_to(n: u8) -> u16 {
    var s : u16 = 0;
    for i in 0..n {
        s = s + (i as u16);
    }
    return s;
}

pub fn count_up(n: u8) -> u8 {
    var i : u8 = 0;
    while (i < n) {
        i = i + 1;
    }
    return i;
}

pub const SUM_BELOW_5 : u16 = 10;

test zero_to_four_add_up_to_ten {
    assert SUM_BELOW_5 == 0 + 1 + 2 + 3 + 4;
    assert sum_to(5) == SUM_BELOW_5;
}

test both_loops_run_their_bodies {
    assert sum_to(0) == 0;
    assert sum_to(1) == 0;
    assert sum_to(10) == 45;
    assert count_up(0) == 0;
    assert count_up(7) == 7;
}
