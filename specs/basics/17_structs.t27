; t27 basics, lesson 17: Structs.
; A struct groups named fields, each with its own type.

module basics_17_structs;

pub struct Point {
    x: i32,
    y: i32,
}

pub const Flags = packed struct {
    ready: bool,
    error: bool,
};

pub const FIELDS_IN_POINT : u8 = 2;

test a_point_has_two_fields {
    assert FIELDS_IN_POINT == 2;
}

fn point_sum(a: Point, b: Point) -> Point {
    return Point{ .x = a.x + b.x, .y = a.y + b.y };
}

test point_sum_adds_the_fields {
    var p : Point = Point{ .x = 1, .y = 2 };
    var q : Point = Point{ .x = 10, .y = 20 };
    var s : Point = point_sum(p, q);
    assert s.x == 11;
    assert s.y == 22;
}
