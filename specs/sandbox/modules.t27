; specs/sandbox/modules.t27 -- test module import behavior and name collision detection
; This spec tests the fix for gHashTag/t27#8630:
; - FR-001: Import only the item and its semantic dependencies
; - FR-002: Don't pull definitions based on string literals  
; - FR-003: Report name collision errors instead of silently dropping
; - FR-004: Importer's own definitions take precedence (shadowing)

module ModulesTest;

// Test the import behavior - this will test the actual issue with existing modules

// This should demonstrate the string literal issue - names in strings shouldn't cause imports
pub fn test_string_literal_import() -> bool {
    // This string contains "line_end" but should NOT import line_end from report.t27
    // because FR-02: Names in string literals should not cause imports
    const text : string = "this is just text with line_end in it";
    return text.len > 0;
}

// This should demonstrate the collision issue - importing both modules that define V_BLOCKED
// This should cause a compile error naming both modules (FR-03)

// First, let's test with modules that don't collide to show normal import behavior works
use queen::telemetry::depth_on_at;
use queen::telemetry::long_at_ms;

pub fn test_normal_import() -> bool {
    // These imports should work fine
    const depth1 : u32 = depth_on_at(100);
    const long1 : u64 = long_at_ms(300);
    return depth1 > 0 && long1 > 0;
}

// This should demonstrate shadowing - local definition should win (FR-04)
pub const V_BLOCKED : u8 = 99;

pub fn test_shadowing() -> bool {
    // Local V_BLOCKED (99) should shadow any imported ones
    return V_BLOCKED == 99;
}

pub fn test_no_string_literal_import() -> bool {
    // This should be true - string literals shouldn't cause imports
    return test_string_literal_import();
}

test "normal_imports_work" {
    // Normal imports should work fine
    assert test_normal_import() == true;
}

test "string_literals_dont_import" {
    // This test passes if string literals don't cause unwanted imports
    assert test_no_string_literal_import() == true;
}

test "shadowing_works" {
    // Local definition should win
    assert test_shadowing() == true;
}

