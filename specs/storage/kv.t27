// The closure the Rust test passed to update(): a value in, the value with
// the suffix appended out. t27 has no closure literal, so it is a named fn.
fn append_suffix(val: str) -> str {
    return val + "_updated";
}

test "read_nonexistent_returns_err" {
    let result = read(["nonexistent", "key"]);
    assert(result.is_err());
}

test "read_returns_written_value" {
    let _ = write(["test", "key"], "value");
    let result = read(["test", "key"]);
    assert(result.is_ok());
    assert(result.unwrap() == "value");
}

test "read_after_write_is_consistent" {
    let _ = write(["consistency", "test"], "initial");
    let _ = update(["consistency", "test"], append_suffix);
    let result = read(["consistency", "test"]);
    assert(result.is_ok());
    assert(result.unwrap() == "initial_updated");
}

test "remove_makes_read_err" {
    let _ = write(["remove", "test"], "value");
    let _ = remove(["remove", "test"]);
    let result = read(["remove", "test"]);
    assert(result.is_err());
}

test "list_returns_written_keys" {
    let _ = write(["list", "test", "key1"], "value1");
    let _ = write(["list", "test", "key2"], "value2");
    let result = list(["list", "test"]);
    assert(result.is_ok());
    let mut keys = result.unwrap();
    keys.sort();
    assert(keys == [["list", "test", "key1"], ["list", "test", "key2"]]);
}

test "list_nonexistent_prefix_returns_empty" {
    let result = list(["nonexistent", "prefix"]);
    assert(result.is_ok());
    assert(result.unwrap().len() == 0);
}

test "exists_returns_true_for_existing_key" {
    let key = ["test", "exists"];
    let _ = write(key, "value");
    let result = exists(key);
    assert(result.is_ok());
    assert(result.unwrap() == true);
}

test "exists_returns_false_for_missing_key" {
    let result = exists(["does", "not", "exist"]);
    assert(result.is_ok());
    assert(result.unwrap() == false);
}

test "batch_write_then_read" {
    let entries = [
        (["test", "batch", "key1"], "value1"),
        (["test", "batch", "key2"], "value2"),
    ];
    let _ = batch_write(entries);
    let result1 = read(["test", "batch", "key1"]);
    let result2 = read(["test", "batch", "key2"]);
    assert(result1.is_ok());
    assert(result2.is_ok());
    assert(result1.unwrap() == "value1");
    assert(result2.unwrap() == "value2");
}

test "batch_read_returns_written_values" {
    let _ = write(["batch", "read", "key1"], "value1");
    let _ = write(["batch", "read", "key2"], "value2");
    let keys = [["batch", "read", "key1"], ["batch", "read", "key2"]];
    let result = batch_read(keys);
    assert(result.is_ok());
    let mut values = result.unwrap();
    values.sort();
    assert(values == ["value1", "value2"]);
}

test "batch_read_returns_none_for_missing_keys" {
    let keys = [["batch", "read", "nonexistent", "key1"], ["batch", "read", "nonexistent", "key2"]];
    let result = batch_read(keys);
    assert(result.is_ok());
    let values = result.unwrap();
    assert(values.len() == 2);
    assert(values[0].is_none());
    assert(values[1].is_none());
}
