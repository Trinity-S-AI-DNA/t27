// specs/storage/kv.t27 -- simple key-value storage, ported from the Rust
// sketch this branch started from: the fn names, the argument lists and the
// twelve tests are unchanged; the syntax is t27's (no <T> on a fn, no macros,
// no #[test] attribute -- a test is a `test` block).
// phi^2 + 1/phi^2 = 3 | TRINITY

module StorageKv;

//! Simple key-value storage.
//!
//! # Example
//!
//! kv::write(["hello", "world"], "foo");
//! assert(kv::read(["hello", "world"]).unwrap() == "foo");
//! kv::update(["hello", "world"], append_suffix);
//! assert(kv::read(["hello", "world"]).unwrap() == "FOO");
//! kv::remove(["hello", "world"]);
//! assert(kv::read(["hello", "world"]).is_err());

