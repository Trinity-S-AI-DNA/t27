// SPDX-License-Identifier: Apache-2.0
// specs/port/tools/published_figures.t27 -- Port of tools/published_figures.py
//
// The counting core of the published-figures table: take only the code lines
// of a spec (a line whose first non-blank text is `//` or `#` is a comment and
// is not counted), and count the call-site figures `NAME(` where NAME is not
// preceded by a word character, `.` or `@` (the regex `(?<![\w.@])NAME\s*\(`).
// The directory walk, the regex-only figures and the git base comparison stay
// with the tool; everything here is pure and works on caller-supplied lines.

module specs::port::tools::published_figures;

pub const SPACE: u8 = 32;
pub const TAB: u8 = 9;

// Number of call-site figures in the table below.
pub const CALL_FIGURES: usize = 4;

pub fn starts_with(s: []const u8, prefix: []const u8) -> bool {
    if (s.len < prefix.len) {
        return false;
    }
    return std.mem.eql(u8, s[0..prefix.len], prefix);
}

pub fn ends_with(s: []const u8, suffix: []const u8) -> bool {
    if (s.len < suffix.len) {
        return false;
    }
    return std.mem.eql(u8, s[s.len - suffix.len..s.len], suffix);
}

pub fn is_blank_char(c: u8) -> bool {
    return c == SPACE or c == TAB or c == 13 or c == 10;
}

pub fn is_word_char(c: u8) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_';
}

// Index of the first character that is not a space or a tab.
pub fn lstrip_at(s: []const u8) -> usize {
    var i: usize = 0;
    while (i < s.len and (s[i] == SPACE or s[i] == TAB)) {
        i += 1;
    }
    return i;
}

// The one genuine miscount this file exists for: a comment line is not code.
pub fn is_code(line: []const u8) -> bool {
    var i: usize = lstrip_at(line);
    var rest: []const u8 = line[i..line.len];
    return !(starts_with(rest, "//") or starts_with(rest, "#"));
}

// True when `name` starts at `i`, is not preceded by a word character, `.` or
// `@`, and is followed by optional blanks and an opening parenthesis.
pub fn call_at(line: []const u8, i: usize, name: []const u8) -> bool {
    if (i + name.len > line.len) {
        return false;
    }
    if (!std.mem.eql(u8, line[i..i + name.len], name)) {
        return false;
    }
    if (i > 0) {
        var p: u8 = line[i - 1];
        if (is_word_char(p) or p == '.' or p == '@') {
            return false;
        }
    }
    var j: usize = i + name.len;
    while (j < line.len and is_blank_char(line[j])) {
        j += 1;
    }
    return j < line.len and line[j] == '(';
}

// Number of call sites of `name` in one line.
pub fn count_calls(line: []const u8, name: []const u8) -> u32 {
    var n: u32 = 0;
    var i: usize = 0;
    while (i < line.len) {
        if (call_at(line, i, name)) {
            n += 1;
            i += name.len;
        } else {
            i += 1;
        }
    }
    return n;
}

// Count over a list of lines, comment lines excluded.
pub fn count_in(lines: []str, name: []const u8) -> u32 {
    var total: u32 = 0;
    var k: usize = 0;
    while (k < lines.len) {
        if (is_code(lines[k])) {
            total += count_calls(lines[k], name);
        }
        k += 1;
    }
    return total;
}

// The call-site rows of the pinned table (name, pinned value).
pub fn figure_call(row: usize) -> []const u8 {
    if (row == 0) {
        return "cast_i8";
    }
    if (row == 1) {
        return "cast_i16";
    }
    if (row == 2) {
        return "len";
    }
    return "abs";
}

pub fn figure_pinned(row: usize) -> u32 {
    if (row == 0) {
        return 1081;
    }
    if (row == 1) {
        return 38;
    }
    if (row == 2) {
        return 332;
    }
    return 475;
}

// Number of rows whose derived count differs from the pin.
pub fn drift_count(lines: []str, counts: [4]u32) -> u32 {
    var drift: u32 = 0;
    var r: usize = 0;
    while (r < CALL_FIGURES) {
        if (counts[r] != figure_pinned(r)) {
            drift += 1;
        }
        r += 1;
    }
    return drift;
}

// Negative control: one call in code and one in a comment count as one.
pub fn self_check() -> i32 {
    var lines: [2][]const u8 = [ "// cast_i8(1) in a comment", "var a = cast_i8(2);" ];
    var seen: u32 = count_in(&lines, "cast_i8");
    if (seen == 1) {
        return 0;
    }
    return 2;
}

pub fn main() -> i32 {
    return self_check();
}

test "code_lines" {
    assert(is_code("var a = 1;"));
    assert(is_code("    cast_i8(2)"));
    assert(!is_code("// cast_i8(1)"));
    assert(!is_code("   \t// indented comment"));
    assert(!is_code("# hash comment"));
    assert(is_code(""));
    assert(lstrip_at("  \tx") == 3);
    assert(starts_with("specs/a.t27", "specs"));
    assert(!starts_with("sp", "specs"));
    assert(ends_with("specs/a.t27", ".t27"));
    assert(!ends_with("a.zig", ".t27"));
}

test "derive" {
    var lines: [6][]const u8 = [
        "var a = cast_i8(1) + cast_i8 (2);",
        "// cast_i8(3) is a comment",
        "var b = x.cast_i8(4);",
        "var c = my_cast_i8(5);",
        "var d = @cast_i8(6);",
        "var e = abs(3) + len(x) + x.len(y);"
    ];
    assert(count_in(&lines, "cast_i8") == 2);
    assert(count_in(&lines, "cast_i16") == 0);
    assert(count_in(&lines, "abs") == 1);
    assert(count_in(&lines, "len") == 1);
    assert(count_calls("cast_i8(1)cast_i8(2)", "cast_i8") == 2);
    assert(call_at("x = len(", 4, "len"));
    assert(!call_at("x = len", 4, "len"));
    assert(!call_at("x = xlen(1)", 5, "len"));
}

test "table" {
    assert(std.mem.eql(u8, figure_call(0), "cast_i8"));
    assert(std.mem.eql(u8, figure_call(1), "cast_i16"));
    assert(std.mem.eql(u8, figure_call(2), "len"));
    assert(std.mem.eql(u8, figure_call(3), "abs"));
    assert(figure_pinned(0) == 1081);
    assert(figure_pinned(1) == 38);
    assert(figure_pinned(2) == 332);
    assert(figure_pinned(3) == 475);
    var lines: [1][]const u8 = [ "x" ];
    var same: [4]u32 = [ 1081, 38, 332, 475 ];
    var moved: [4]u32 = [ 1081, 39, 332, 470 ];
    assert(drift_count(&lines, same) == 0);
    assert(drift_count(&lines, moved) == 2);
}

test "self_check" {
    assert(self_check() == 0);
}

test "main" {
    assert(main() == 0);
}
