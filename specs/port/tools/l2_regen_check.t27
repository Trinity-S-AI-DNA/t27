// Part of M1 (milestone #5). Closes #12309.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::tools::l2_regen_check;

pub const MAX_REGEN_DEPTH : u32 = 5;

pub struct RegenResult {
    changed : bool,
    depth : u32,
};

// l2_regen_check.py: check_regen(file) -- check if a file needs regeneration.
pub fn check_regen(source_hash: str, cached_hash: str) -> bool {
    return source_hash != cached_hash;
}

// l2_regen_check.py: regen_once(file) -- regenerate one level.
pub fn regen_once(depth: u32) -> RegenResult {
    return RegenResult {
        changed: true,
        depth: depth + 1,
    };
}

// l2_regen_check.py: regen_bounded(file, max_depth) -- regenerate up to max_depth.
pub fn regen_bounded(start_depth: u32, max_depth: u32) -> RegenResult {
    var d : u32 = start_depth;
    var changed : bool = false;
    while (d < max_depth) {
        var r : RegenResult = regen_once(d);
        changed = changed || r.changed;
        d = r.depth;
    }
    return RegenResult { changed: changed, depth: d };
}

// l2_regen_check.py: verify_regen(result) -- verify regen completed.
pub fn verify_regen(r: RegenResult) -> bool {
    return r.depth <= MAX_REGEN_DEPTH;
}

// ---- Tests ----------------------------------------------------------------
test "check_regen detects changed files" {
    assert(check_regen("abc", "abc") == false);
    assert(check_regen("abc", "def") == true);
}

test "regen_once increments depth" {
    var r = regen_once(0);
    assert(r.depth == 1);
    assert(r.changed == true);
}

test "regen_bounded stops at max_depth" {
    var r = regen_bounded(0, 3);
    assert(r.depth == 3);
    assert(verify_regen(r));
}

test "regen_bounded does not exceed max_depth" {
    var r = regen_bounded(0, 1);
    assert(r.depth == 1);
    assert(!verify_regen(r) || r.depth <= MAX_REGEN_DEPTH);
}

invariant max_regen_depth_is_five {
    assert MAX_REGEN_DEPTH == 5;
}