// (was `module specs.port.tools.builtin_parity_table` with no `;`: a t27
// module path is `::`-separated and the header ends in `;`)
module specs::port::tools::builtin_parity_table;

// The Python original probed the file system for the binary
// (target/release/t27c, then bootstrap/target/release/t27c, then $TRI_T27C).
// The generated Zig has no optional capture, so the probe is split in two:
// the caller supplies what it found, and this function does the choosing.
pub fn t27c(has_release: bool, has_bootstrap: bool, env: []const u8) -> []const u8 {
    if (has_release) {
        return "target/release/t27c";
    }
    if (has_bootstrap) {
        return "bootstrap/target/release/t27c";
    }
    return env;
}

// Spawning a process is outside the spec dialect: stays a stub that returns
// empty stdout, which `cell` reads as "(no output)".
pub fn emit(binary: []const u8, sub: []const u8, call: []const u8, d: []const u8) -> []const u8 {
    _ = binary;
    _ = sub;
    _ = call;
    _ = d;
    return "";
}

// True when `out[i..]` starts with `prefix`.
pub fn starts_at(out: []const u8, i: usize, prefix: []const u8) -> bool {
    if (i + prefix.len > out.len) {
        return false;
    }
    return std.mem.eql(u8, out[i..i + prefix.len], prefix);
}

// True when the text just before `i` is `prefix`.
pub fn ends_at(out: []const u8, i: usize, prefix: []const u8) -> bool {
    if (i < prefix.len) {
        return false;
    }
    return std.mem.eql(u8, out[i - prefix.len..i], prefix);
}

// Does the emitted file DEFINE this name itself? A header include declares
// the math names; `#define name(` declares a C macro; `fn name(` declares a
// Zig or Rust function. A name that only appears as a call does not count.
pub fn declares(out: []const u8, name: []const u8) -> bool {
    const math_name = (name == "sqrt") or (name == "floor") or (name == "round") or (name == "ceil") or (name == "fabs") or (name == "pow") or (name == "log") or (name == "exp");
    if (math_name and std.mem.indexOf(u8, out, "#include <math.h>") != null) {
        return true;
    }
    var i: usize = 0;
    while (i + name.len < out.len) {
        if (starts_at(out, i, name) and out[i + name.len] == '(') {
            if (ends_at(out, i, "#define ") or ends_at(out, i, "fn ")) {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

// What the backend did with a call, in one short phrase. No output at all and
// no assignment line are the two failure shapes of a broken probe.
pub fn cell(out: []const u8, call: []const u8) -> []const u8 {
    _ = call;
    if (out.len == 0) {
        return "(no output)";
    }
    if (std.mem.indexOf(u8, out, " a = ") == null and std.mem.indexOf(u8, out, " a: ") == null) {
        return "(no assignment)";
    }
    return "assigned";
}

// The population column counts CODE only: a comment line is not a call.
pub fn is_comment_line(line: []const u8) -> bool {
    var i: usize = 0;
    while (i < line.len and (line[i] == ' ' or line[i] == '\t')) {
        i += 1;
    }
    return starts_at(line, i, "//") or starts_at(line, i, "#");
}

pub fn corpus_counts() -> void {
    // Walking the spec tree needs the file system; see is_comment_line for the
    // counting rule that this would apply to each line.
    const sample_is_prose = is_comment_line("// see round(x)");
    _ = sample_is_prose;
}

// Negative controls on canned output: a name the output declares is a helper,
// a name that only appears as a call is not.
pub fn self_check(binary: []const u8) -> i32 {
    _ = binary;
    if (!declares("#define assert_eq(a, b) ((a) == (b))\n", "assert_eq")) {
        return 2;
    }
    if (!declares("fn assert_eq(a: anytype, b: anytype) void {}\n", "assert_eq")) {
        return 2;
    }
    if (!declares("#include <math.h>\n", "sqrt")) {
        return 2;
    }
    if (declares("var a = zzz_not_a_builtin(v);\n", "zzz_not_a_builtin")) {
        return 2;
    }
    return 0;
}

pub fn main() -> i32 {
    return self_check("");
}

test "t27c returns a path when binary exists" {
    assert(t27c(true, true, "") == "target/release/t27c");
    assert(t27c(false, true, "") == "bootstrap/target/release/t27c");
    assert(t27c(false, false, "/opt/t27c") == "/opt/t27c");
}

test "emit runs binary and returns stdout" {
    // Process spawning is out of the dialect: the stub returns no stdout.
    assert(emit("t27c", "gen", "abs(v)", "/tmp").len == 0);
}

test "declares checks if output declares name" {
    assert(declares("#define assert_eq(a, b) ((a) == (b))\n", "assert_eq"));
    assert(declares("pub fn assert_eq(a: anytype) void {}", "assert_eq"));
    assert(declares("#include <math.h>\nint x;", "sqrt"));
    assert(!declares("var a = sqrt(v);", "sqrt"));
    assert(!declares("var a = zzz(v);", "zzz"));
}

test "cell returns short phrase" {
    assert(cell("", "abs(v)") == "(no output)");
    assert(cell("int main(void);", "abs(v)") == "(no assignment)");
    assert(cell("int x; int a = abs(v);", "abs(v)") == "assigned");
}

test "corpus_counts builds maps" {
    corpus_counts();
    assert(is_comment_line("  // round the mantissa (see round(x))"));
    assert(is_comment_line("# sign(x)"));
    assert(!is_comment_line("    var a = sign(v);"));
}

test "self_check returns 0 for good binary" {
    assert(self_check("target/release/t27c") == 0);
}

test "main returns exit code" {
    assert(main() == 0);
}
