// specs/port/tools/dedupe_identical_tests.t27 -- Port of tools/dedupe_identical_tests.py
//
// The line-level core of the dedupe tool: recognise a top-level item line,
// recognise a `test NAME` head, find where a test block ends (brace form or
// gherkin form), and decide whether two blocks have identical bodies. The
// file walk and the rewrite stay with the tool; everything here is pure.

module specs::port::tools::dedupe_identical_tests;

pub const SPACE: u8 = 32;
pub const TAB: u8 = 9;

pub fn is_blank_char(c: u8) -> bool {
    return c == SPACE or c == TAB or c == 13;
}

pub fn is_word_char(c: u8) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_';
}

pub fn is_blank_line(line: []const u8) -> bool {
    var i: usize = 0;
    while (i < line.len) {
        if (!is_blank_char(line[i])) {
            return false;
        }
        i += 1;
    }
    return true;
}

pub fn skip_blanks(line: []const u8, from: usize) -> usize {
    var i: usize = from;
    while (i < line.len and is_blank_char(line[i])) {
        i += 1;
    }
    return i;
}

// True when `line[i..]` starts with `word` and the next character is not a
// word character (the regex `\b` after a keyword).
pub fn keyword_at(line: []const u8, i: usize, word: []const u8) -> bool {
    if (i + word.len > line.len) {
        return false;
    }
    if (!std.mem.eql(u8, line[i..i + word.len], word)) {
        return false;
    }
    if (i + word.len == line.len) {
        return true;
    }
    return !is_word_char(line[i + word.len]);
}

// A top-level item starts a new region: optional `pub`, then a keyword.
pub fn is_item_line(line: []const u8) -> bool {
    var i: usize = skip_blanks(line, 0);
    if (keyword_at(line, i, "pub") and i + 3 < line.len and is_blank_char(line[i + 3])) {
        i = skip_blanks(line, i + 3);
    }
    return keyword_at(line, i, "test") or keyword_at(line, i, "bench") or keyword_at(line, i, "invariant") or keyword_at(line, i, "fn") or keyword_at(line, i, "struct") or keyword_at(line, i, "enum") or keyword_at(line, i, "module") or keyword_at(line, i, "const") or keyword_at(line, i, "impl") or keyword_at(line, i, "use") or keyword_at(line, i, "type");
}

// The head of a `test NAME` block: where the name sits in the line and
// whether the line opens a brace.
pub const TestHead = struct {
    is_test: bool,
    name_start: usize,
    name_end: usize,
    has_brace: bool,
};

pub const NOT_A_TEST: TestHead = TestHead{ .is_test = false, .name_start = 0, .name_end = 0, .has_brace = false };

// Matches ^\s*test\s+("name"|identifier)\s*({)?\s*$
pub fn parse_test_line(line: []const u8) -> TestHead {
    var i: usize = skip_blanks(line, 0);
    if (!keyword_at(line, i, "test")) {
        return NOT_A_TEST;
    }
    i += 4;
    if (i >= line.len or !is_blank_char(line[i])) {
        return NOT_A_TEST;
    }
    i = skip_blanks(line, i);
    if (i >= line.len) {
        return NOT_A_TEST;
    }
    var name_start: usize = i;
    var name_end: usize = i;
    if (line[i] == '"') {
        i += 1;
        name_start = i;
        while (i < line.len and line[i] != '"') {
            i += 1;
        }
        if (i >= line.len) {
            return NOT_A_TEST;
        }
        name_end = i;
        i += 1;
    } else {
        const c = line[i];
        if (!((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_')) {
            return NOT_A_TEST;
        }
        i += 1;
        while (i < line.len and (is_word_char(line[i]) or line[i] == '-')) {
            i += 1;
        }
        name_end = i;
    }
    i = skip_blanks(line, i);
    var has_brace: bool = false;
    if (i < line.len and line[i] == '{') {
        has_brace = true;
        i += 1;
    }
    i = skip_blanks(line, i);
    if (i < line.len) {
        return NOT_A_TEST;
    }
    return TestHead{ .is_test = true, .name_start = name_start, .name_end = name_end, .has_brace = has_brace };
}

// `{` count minus `}` count on one line.
pub fn brace_delta(line: []const u8) -> i32 {
    var d: i32 = 0;
    var i: usize = 0;
    while (i < line.len) {
        if (line[i] == '{') {
            d += 1;
        }
        if (line[i] == '}') {
            d -= 1;
        }
        i += 1;
    }
    return d;
}

// Exclusive end line of the block whose head is `lines[head]`.
pub fn block_end(lines: []str, head: usize, has_brace: bool) -> usize {
    var j: usize = head + 1;
    if (has_brace) {
        var depth: i32 = brace_delta(lines[head]);
        while (j < lines.len and depth > 0) {
            depth += brace_delta(lines[j]);
            j += 1;
        }
        return j;
    }
    while (j < lines.len and !is_item_line(lines[j])) {
        j += 1;
    }
    // trailing blank lines belong to the block, so deleting it leaves no double gap
    while (j - 1 > head and is_blank_line(lines[j - 1])) {
        j -= 1;
    }
    return j;
}

// How many `test` blocks the lines hold.
pub fn count_blocks(lines: []str) -> usize {
    var n: usize = 0;
    var i: usize = 0;
    while (i < lines.len) {
        const h = parse_test_line(lines[i]);
        if (!h.is_test) {
            i += 1;
        } else {
            n += 1;
            i = block_end(lines, i, h.has_brace);
        }
    }
    return n;
}

// Line equality with trailing blanks ignored.
pub fn lines_equal(a: []const u8, b: []const u8) -> bool {
    var ea: usize = a.len;
    while (ea > 0 and is_blank_char(a[ea - 1])) {
        ea -= 1;
    }
    var eb: usize = b.len;
    while (eb > 0 and is_blank_char(b[eb - 1])) {
        eb -= 1;
    }
    return std.mem.eql(u8, a[0..ea], b[0..eb]);
}

// Are the bodies (head line excluded, outer blank lines ignored) of the
// blocks [s1, e1) and [s2, e2) identical?
pub fn bodies_equal(lines: []str, s1: usize, e1: usize, s2: usize, e2: usize) -> bool {
    var a: usize = s1 + 1;
    var ae: usize = e1;
    var b: usize = s2 + 1;
    var be: usize = e2;
    while (a < ae and is_blank_line(lines[a])) {
        a += 1;
    }
    while (ae > a and is_blank_line(lines[ae - 1])) {
        ae -= 1;
    }
    while (b < be and is_blank_line(lines[b])) {
        b += 1;
    }
    while (be > b and is_blank_line(lines[be - 1])) {
        be -= 1;
    }
    if (ae - a != be - b) {
        return false;
    }
    var k: usize = 0;
    while (k < ae - a) {
        if (!lines_equal(lines[a + k], lines[b + k])) {
            return false;
        }
        k += 1;
    }
    return true;
}

test "is_item_line recognises top-level keywords" {
    assert(is_item_line("fn main() {"));
    assert(is_item_line("  pub fn helper()"));
    assert(is_item_line("test \"x\" {"));
    assert(is_item_line("invariant"));
    assert(is_item_line("use std::mem;"));
}

test "is_item_line needs a word boundary" {
    assert(!is_item_line("testing the thing"));
    assert(!is_item_line("function_call();"));
    assert(!is_item_line("    assert(x);"));
    assert(!is_item_line(""));
}

test "parse_test_line reads a quoted name with a brace" {
    const line = "test \"adds two\" {";
    const h = parse_test_line(line);
    assert(h.is_test);
    assert(h.has_brace);
    assert(std.mem.eql(u8, line[h.name_start..h.name_end], "adds two"));
}

test "parse_test_line reads a bare identifier without a brace" {
    const line = "  test my-case_1";
    const h = parse_test_line(line);
    assert(h.is_test);
    assert(!h.has_brace);
    assert(std.mem.eql(u8, line[h.name_start..h.name_end], "my-case_1"));
}

test "parse_test_line rejects non-test lines" {
    assert(!parse_test_line("fn test() {").is_test);
    assert(!parse_test_line("test\"x\" {").is_test);
    assert(!parse_test_line("test \"unterminated {").is_test);
    assert(!parse_test_line("test \"x\" { trailing").is_test);
    assert(!parse_test_line("testing \"x\"").is_test);
}

test "brace_delta counts opens minus closes" {
    assert(brace_delta("test \"a\" {") == 1);
    assert(brace_delta("}") == -1);
    assert(brace_delta("if (x) { y(); }") == 0);
    assert(brace_delta("no braces") == 0);
}

test "block_end balances braces in the brace form" {
    var lines: [6]str = [
        "test \"a\" {",
        "    if (x) {",
        "        y();",
        "    }",
        "}",
        "fn next() {}"
    ];
    assert(block_end(&lines, 0, true) == 5);
}

test "block_end runs to the next item in the gherkin form" {
    var lines: [6]str = [
        "test a",
        "    given something",
        "    then it holds",
        "",
        "",
        "fn next() {}"
    ];
    // the two trailing blank lines are part of the block's gap, not its end
    assert(block_end(&lines, 0, false) == 3);
}

test "count_blocks finds both forms" {
    var lines: [8]str = [
        "test \"a\" {",
        "    assert(1 == 1);",
        "}",
        "test b",
        "    then ok",
        "fn f() {}",
        "test \"c\" {",
        "}"
    ];
    assert(count_blocks(&lines) == 3);
}

test "bodies_equal ignores outer blanks and trailing spaces" {
    var lines: [11]str = [
        "test \"a\" {",
        "    assert(1 == 1);  ",
        "}",
        "",
        "test \"a\" {",
        "",
        "    assert(1 == 1);",
        "}",
        "test \"a\" {",
        "    assert(1 == 2);",
        "}"
    ];
    assert(bodies_equal(&lines, 0, 3, 4, 8));
    assert(!bodies_equal(&lines, 0, 3, 8, 11));
}
