module port::tools::queen::needs_boundary;

// Port of tools/queen/needs_boundary.py (issue #4989): label the open issues
// no bee can take, because they declare no `## Boundary` section.
//
// The decisions are pure code: the Queen's heading rule, the label/unlabel
// verdict, the readiness routing. Everything that only moves data in or out
// (the gh subprocess, the issues API, argv) keeps its name with an undefined
// body that no test calls.
//
// The original returns None from ensure_label; the port leaves its body
// undefined like the other plumbing. Python's growing lists become fixed
// capacity (64 issues, 8 labels a row): the swarm's real issue counts fit.

const NB_LABEL: []const u8 = "needs-boundary";

// The Russian heading the Queen's parser also accepts, as UTF-8 bytes, so
// this file stays ASCII (law L3).
const RU_HEAD: [14]u8 = [0xD0, 0x93, 0xD1, 0x80, 0xD0, 0xB0, 0xD0, 0xBD, 0xD0, 0xB8, 0xD1, 0x86, 0xD1, 0x8B];

// Only the facts decide() reads: number, body, label names.
pub struct NbIssueRow {
    number: i64,
    body: []const u8,
    labels: [8][]const u8,
    label_count: usize,
}

// (to label, to unlabel). Python returns two growing lists; here both are
// arrays with a length, because no list library in specs/ compiles today.
pub struct NbVerdict {
    add: [64]i64,
    add_len: usize,
    drop: [64]i64,
    drop_len: usize,
}

pub enum NbAction { Skip, WriteBody, DraftComment, }

// The Queen's rule, matched exactly and nothing wider: a line beginning
// `## ` (spaces or a tab after the hashes) whose heading starts with
// Boundary or its Russian twin. A level-three heading, a lowercase b, or
// prose never matches -- if it did, the label would say "dispatchable"
// about an issue she will keep skipping.
pub fn has_boundary(body: []const u8) -> bool {
    var i: usize = 0;
    const n = body.len();
    while (i < n) {
        var j: usize = i;
        while (j < n and body[j] != '\n') {
            j += 1;
        }
        if (line_is_boundary(body, i, j)) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

// One line of the body, from start up to end (the newline excluded).
fn line_is_boundary(line: []const u8, start: usize, end: usize) -> bool {
    var k: usize = start;
    if (k + 2 > end) {
        return false;
    }
    if (line[k] != '#' or line[k + 1] != '#') {
        return false;
    }
    k += 2;
    // At least one space or tab, and the heading follows them.
    var saw_space: bool = false;
    while (k < end and (line[k] == ' ' or line[k] == '\t')) {
        saw_space = true;
        k += 1;
    }
    if (!saw_space) {
        return false;
    }
    if (head_is_boundary(line, k, end)) {
        return true;
    }
    return head_is_russian(line, k, end);
}

// "Boundary" with the capital B, as a prefix: a trailing colon still matches.
fn head_is_boundary(line: []const u8, k: usize, end: usize) -> bool {
    if (k + 8 > end) {
        return false;
    }
    if (line[k] != 'B') { return false; }
    if (line[k + 1] != 'o') { return false; }
    if (line[k + 2] != 'u') { return false; }
    if (line[k + 3] != 'n') { return false; }
    if (line[k + 4] != 'd') { return false; }
    if (line[k + 5] != 'a') { return false; }
    if (line[k + 6] != 'r') { return false; }
    if (line[k + 7] != 'y') { return false; }
    return true;
}

// The Russian heading, compared byte for byte against RU_HEAD.
fn head_is_russian(line: []const u8, k: usize, end: usize) -> bool {
    if (k + 14 > end) {
        return false;
    }
    var m: usize = 0;
    while (m < 14) {
        if (line[k + m] != RU_HEAD[m]) {
            return false;
        }
        m += 1;
    }
    return true;
}

// Original: subprocess.run(["gh", *args]) -> stdout, RuntimeError on failure.
pub fn gh(args: []str) -> []const u8 {
    undefined;
}

// The jq select inside the query: .pull_request == null. A PR is not
// dispatchable work, so it never becomes a row.
fn row_is_issue(is_pull_request: bool) -> bool {
    return !is_pull_request;
}

// Original: every open issue via `gh api --paginate`, pull requests excluded.
pub fn open_issues() -> []NbIssueRow {
    undefined;
}

fn has_label(row: NbIssueRow, label: []const u8) -> bool {
    var i: usize = 0;
    while (i < row.label_count) {
        if (row.labels[i] == label) {
            return true;
        }
        i += 1;
    }
    return false;
}

// NOT_TASKS = {"roadmap", "epic"}: a goal is not a task. Labelling the
// roadmap stages and the epics would put eight permanent entries at the top
// of a list whose whole value is that everything on it is worth fixing.
fn is_not_task(row: NbIssueRow) -> bool {
    return has_label(row, "roadmap") or has_label(row, "epic");
}

// (to label, to unlabel). Pure, so self_test can drive it.
pub fn decide(issues: []NbIssueRow) -> NbVerdict {
    var v: NbVerdict = NbVerdict {
        add = [_]i64{0} ** 64,
        add_len = 0,
        drop = [_]i64{0} ** 64,
        drop_len = 0,
    };
    for issue in issues {
        const labelled = has_label(issue, NB_LABEL);
        if (is_not_task(issue)) {
            // A goal that somehow carries the label still gets it removed.
            if (labelled and v.drop_len < 64) {
                v.drop[v.drop_len] = issue.number;
                v.drop_len += 1;
            }
            continue;
        }
        if (has_boundary(issue.body)) {
            if (labelled and v.drop_len < 64) {
                v.drop[v.drop_len] = issue.number;
                v.drop_len += 1;
            }
        } else if (!labelled and v.add_len < 64) {
            v.add[v.add_len] = issue.number;
            v.add_len += 1;
        }
    }
    return v;
}

// Original: gh label create, swallowed when it already exists.
pub fn ensure_label() {
    undefined;
}

// The one failure the original swallows: "already exists" is the normal case
// after the first run. Anything else re-raises.
fn error_is_already_there(text: []const u8) -> bool {
    const n = text.len();
    if (n < 14) {
        return false;
    }
    var i: usize = 0;
    while (i + 14 <= n) {
        if (text[i] == 'a' and text[i + 1] == 'l' and text[i + 2] == 'r' and text[i + 3] == 'e' and text[i + 4] == 'a' and text[i + 5] == 'd' and text[i + 6] == 'y' and text[i + 7] == ' ' and text[i + 8] == 'e' and text[i + 9] == 'x' and text[i + 10] == 'i' and text[i + 11] == 's' and text[i + 12] == 't' and text[i + 13] == 's') {
            return true;
        }
        i += 1;
    }
    return false;
}

// The original's own cases, driving the two pure decisions.
pub fn self_test() -> i32 {
    var failures: i32 = 0;

    // has_boundary: the heading the Queen accepts, and the near misses.
    if (!has_boundary("## Boundary\n- a.py\n")) { failures += 1; }
    if (!has_boundary("## Boundary: files\n")) { failures += 1; }
    if (has_boundary("### Boundary\n")) { failures += 1; }
    if (has_boundary("## boundary\n")) { failures += 1; }
    if (has_boundary("Boundary: src/\n")) { failures += 1; }
    if (!has_boundary("text\n\n## Boundary\n- a\n")) { failures += 1; }
    if (has_boundary("")) { failures += 1; }
    // The Russian heading, as bytes: "## " + RU_HEAD + newline.
    var ru: [18]u8 = [0x23, 0x23, 0x20, 0xD0, 0x93, 0xD1, 0x80, 0xD0, 0xB0, 0xD0, 0xBD, 0xD0, 0xB8, 0xD1, 0x86, 0xD1, 0x8B, 0x0A];
    if (!has_boundary(&ru)) { failures += 1; }

    // decide over the original's six rows: add=[1], drop=[2, 6].
    var rows: [6]NbIssueRow = [
        NbIssueRow { number = 1, body = "nothing", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 2, body = "## Boundary\n- a", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 3, body = "## Boundary\n- a", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 4, body = "nothing", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 5, body = "nothing", labels = ["roadmap", "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 6, body = "nothing", labels = ["epic", NB_LABEL, "", "", "", "", "", ""], label_count = 2 },
    ];
    const v = decide(&rows);
    if (v.add_len != 1 or v.add[0] != 1) { failures += 1; }
    if (v.drop_len != 2 or v.drop[0] != 2 or v.drop[1] != 6) { failures += 1; }

    if (failures == 0) {
        return 0;
    }
    return 1;
}

// make_ready gives a freshly-labelled issue its boundary the same day. The
// gh edits are plumbing; the routing is the decision, ported as ready_action.
// The rules for WHICH paths are proposable belong to propose_boundary, which
// the original imports rather than repeats.
pub fn make_ready(issues: []NbIssueRow, labelled: []const i64) -> i32 {
    undefined;
}

fn ready_action(boundary_now: bool, has_paths: bool, writable: bool, drafted: bool) -> NbAction {
    if (boundary_now) {
        return .Skip;
    }
    if (!has_paths) {
        return .Skip;
    }
    if (writable) {
        return .WriteBody;
    }
    if (drafted) {
        return .Skip;
    }
    return .DraftComment;
}

pub fn main() -> i32 {
    undefined;
}

// main's summary counts, pure: the goals held back, the issues the Queen
// will skip. The print itself is the caller's job.
fn count_goals(issues: []NbIssueRow) -> usize {
    var n: usize = 0;
    for issue in issues {
        if (is_not_task(issue)) {
            n += 1;
        }
    }
    return n;
}

fn count_without_boundary(issues: []NbIssueRow) -> usize {
    var n: usize = 0;
    for issue in issues {
        if (!has_boundary(issue.body)) {
            n += 1;
        }
    }
    return n;
}

// "if add and not args.no_draft: make_ready(...)" -- label only skips drafting.
fn should_draft(to_label: usize, no_draft: bool) -> bool {
    return to_label > 0 and !no_draft;
}

test has_boundary_accepts_the_queens_heading {
    assert(has_boundary("## Boundary\n- a.py\n"));
    assert(has_boundary("## Boundary: files\n"));
    assert(has_boundary("##\tBoundary\n- a\n"));
    assert(has_boundary("##   Boundary\n"));
    assert(has_boundary("## Boundary"));
}

test has_boundary_accepts_the_russian_heading {
    // "## " + the Russian heading + newline, as UTF-8 bytes (ASCII file, L3).
    var ru: [18]u8 = [0x23, 0x23, 0x20, 0xD0, 0x93, 0xD1, 0x80, 0xD0, 0xB0, 0xD0, 0xBD, 0xD0, 0xB8, 0xD1, 0x86, 0xD1, 0x8B, 0x0A];
    assert(has_boundary(&ru));
    // The heading with text after it still matches, like the English twin.
    var ru2: [21]u8 = [0x23, 0x23, 0x20, 0xD0, 0x93, 0xD1, 0x80, 0xD0, 0xB0, 0xD0, 0xBD, 0xD0, 0xB8, 0xD1, 0x86, 0xD1, 0x8B, 0x3A, 0x20, 0x61, 0x0A];
    assert(has_boundary(&ru2));
}

test has_boundary_rejects_wider_matches {
    assert(!has_boundary("### Boundary\n"));
    assert(!has_boundary("## boundary\n"));
    assert(!has_boundary("Boundary: src/\n"));
    assert(!has_boundary("##Boundary\n"));
    assert(!has_boundary("  ## Boundary\n"));
    assert(!has_boundary("text ## Boundary\n"));
    assert(!has_boundary(""));
}

test has_boundary_anywhere_in_the_body {
    assert(has_boundary("text\n\n## Boundary\n- a\n"));
    assert(has_boundary("\n## Boundary\n"));
    assert(has_boundary("one\n## Boundary: x\ntwo\n"));
}

test row_is_issue_excludes_pull_requests {
    assert(row_is_issue(false));
    assert(!row_is_issue(true));
}

test decide_labels_and_clears {
    var rows: [6]NbIssueRow = [
        NbIssueRow { number = 1, body = "nothing", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 2, body = "## Boundary\n- a", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 3, body = "## Boundary\n- a", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 4, body = "nothing", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 5, body = "nothing", labels = ["roadmap", "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 6, body = "nothing", labels = ["epic", NB_LABEL, "", "", "", "", "", ""], label_count = 2 },
    ];
    const v = decide(&rows);
    assert(v.add_len == 1);
    assert(v.add[0] == 1);
    assert(v.drop_len == 2);
    assert(v.drop[0] == 2);
    assert(v.drop[1] == 6);
}

test decide_leaves_settled_issues_alone {
    // An unlabelled issue with a boundary is never added; a labelled issue
    // without a boundary keeps its label; an unlabelled goal is skipped:
    // three directions of "no change".
    var rows: [3]NbIssueRow = [
        NbIssueRow { number = 7, body = "## Boundary\n- a", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 8, body = "nothing", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 9, body = "nothing", labels = ["roadmap", "", "", "", "", "", "", ""], label_count = 1 },
    ];
    const v = decide(&rows);
    assert(v.add_len == 0);
    assert(v.drop_len == 0);
}

test error_is_already_there {
    assert(error_is_already_there("gh: Label already exists"));
    assert(!error_is_already_there("gh: Not Found (HTTP 404)"));
    assert(!error_is_already_there(""));
    assert(!error_is_already_there("already exist"));
}

test ready_action_routes_each_case {
    assert(ready_action(true, true, true, false) == .Skip);
    assert(ready_action(false, false, true, false) == .Skip);
    assert(ready_action(false, true, true, false) == .WriteBody);
    assert(ready_action(false, true, false, true) == .Skip);
    assert(ready_action(false, true, false, false) == .DraftComment);
}

test counts_match_mains_summary_line {
    var rows: [6]NbIssueRow = [
        NbIssueRow { number = 1, body = "nothing", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 2, body = "## Boundary\n- a", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 3, body = "## Boundary\n- a", labels = ["", "", "", "", "", "", "", ""], label_count = 0 },
        NbIssueRow { number = 4, body = "nothing", labels = [NB_LABEL, "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 5, body = "nothing", labels = ["roadmap", "", "", "", "", "", "", ""], label_count = 1 },
        NbIssueRow { number = 6, body = "nothing", labels = ["epic", NB_LABEL, "", "", "", "", "", ""], label_count = 2 },
    ];
    assert(count_goals(&rows) == 2);
    assert(count_without_boundary(&rows) == 4);
}

test should_draft_follows_the_flags {
    assert(should_draft(1, false));
    assert(!should_draft(1, true));
    assert(!should_draft(0, false));
}

test self_test_passes {
    assert(self_test() == 0);
}
