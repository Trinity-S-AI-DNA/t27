// specs/port/tools/queen/feed_untested.t27 -- port of tools/queen/feed_untested.py:
// the host parses `t27c coverage` output, checks signatures and feeds the
// untested population into the Queen queue. The port keeps the pure
// validators (coverage bounds, signature presence, digit-only shell counts,
// non-empty status) in the supported subset; the host parse/build parts are
// stubbed.

module port-feed-untested;

const MAX_UNTESTED: u32 = 8;

struct CoverageResult {
    functions: u32,
    untested: u32,
    names: []str,
}

struct SignatureResult {
    name: str,
    found: bool,
    signature: str,
}

/// Validate coverage for the build: 1..=MAX_UNTESTED untested, names match.
pub fn validate_coverage_for_build(coverage: CoverageResult) -> bool {
    if (!(1 <= coverage.untested && coverage.untested <= MAX_UNTESTED)) return false;
    if (coverage.names.len != coverage.untested) return false;
    return true;
}

/// Validate that all signatures were found.
pub fn validate_signatures(sigs: []SignatureResult) -> bool {
    var i: u32 = 0;
    while (i < sigs.len) {
        if (!sigs[i].found) return false;
        i += 1;
    }
    return true;
}

/// Check if the shell command outputs are valid digits.
pub fn validate_shell_counts(fn_now: str, test_now: str) -> bool {
    return is_all_digits(fn_now) && is_all_digits(test_now);
}

fn is_digit(c: u8) -> bool {
    return c >= '0' and c <= '9';
}

fn is_all_digits(s: str) -> bool {
    if (s.len == 0) return false;
    var i: u32 = 0;
    while (i < s.len) {
        if (!is_digit(s[i])) return false;
        i += 1;
    }
    return true;
}

/// Check if status_now is non-empty.
pub fn validate_status(status_now: str) -> bool {
    return status_now.len > 0;
}

// The host parses the coverage output and finds each function's signature
// text; both parts stay with the tool (they need `t27c coverage` output).

/// True when `text` contains the declaration `fn NAME(`.
pub fn signature_present(text: str, name: str) -> bool {
    var i: usize = 0;
    while (i + 3 + name.len + 1 <= text.len) {
        if (std.mem.eql(u8, text[i..i + 3], "fn ") and std.mem.eql(u8, text[i + 3..i + 3 + name.len], name) and text[i + 3 + name.len] == '(') {
            return true;
        }
        i += 1;
    }
    return false;
}

// Stub: the host formats the issue title and body.
pub fn build_title(untested: u32, rel: str) -> str {
    return rel;
}

pub fn build_body(input: str) -> str {
    return input;
}

// Stub: the host feeds the Queen queue.
pub fn main() -> i32 {
    return 2;
}

test coverage_bounds {
    var names: [3]str = [ "a", "b", "c" ];
    var c: CoverageResult = CoverageResult{ .functions = 10, .untested = 3, .names = &names };
    assert(validate_coverage_for_build(c));
    c.untested = 0;
    assert(!validate_coverage_for_build(c));
    c.untested = 9;
    assert(!validate_coverage_for_build(c));
}

test names_must_match_the_count {
    var names: [1]str = [ "a" ];
    var c: CoverageResult = CoverageResult{ .functions = 5, .untested = 2, .names = &names };
    assert(!validate_coverage_for_build(c));
}

test digit_only_counts {
    assert(validate_shell_counts("12", "7"));
    assert(!validate_shell_counts("12", ""));
    assert(!validate_shell_counts("12", "7a"));
}

test status_must_be_nonempty {
    assert(validate_status("ok"));
    assert(!validate_status(""));
}

test signatures_must_all_be_found {
    var sigs: [2]SignatureResult = [
        SignatureResult{ .name = "f", .found = true, .signature = "fn f()" },
        SignatureResult{ .name = "g", .found = true, .signature = "fn g()" }
    ];
    assert(validate_signatures(&sigs));
    sigs[1].found = false;
    assert(!validate_signatures(&sigs));
}

test signature_lookup {
    assert(signature_present("pub fn alpha(x: u32) -> u32 {", "alpha"));
    assert(!signature_present("pub fn alpha(x: u32) -> u32 {", "beta"));
    assert(!signature_present("fn alphabet(x)", "alpha"));
}
