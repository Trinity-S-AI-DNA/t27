// specs/port/tools/trinity_fpga_adapter.t27 -- port of tools/trinity_fpga_adapter.py:
// the receipt verifier that reads a fpga-receipt against the constants a spec
// declares and reports one finding per violated contract. The verdict rules
// (wrong_version, hash_mismatch, bitstream_absent/empty, placeholder_command,
// idcode_mismatch, transcript_missing, dry_run_as_device) are kept; the host
// parts (utcnow, sha256_file, the receipt file read) are stubbed.

module trinity-fpga-adapter;

pub const SCHEMA : str = "trinity.fpga-receipt.v1";
pub const CONTRACT_VERSION : str = "1";
pub const ERRORS : [8]str = ["wrong_version", "hash_mismatch", "bitstream_absent",
    "bitstream_empty", "placeholder_command", "idcode_mismatch", "transcript_missing",
    "dry_run_as_device"];
pub const IDCODE_FULL : str = "0x13636093";
pub const IDCODE_PRINTED : str = "0x3636093";

pub struct Consts {
    schema: str,
    contract_version: str,
    idcode_full: str,
    idcode_printed: str,
}

pub struct Bitstream {
    sha256: str,
    path_resolved: bool,
    bytes: u64,
}

pub struct Provenance {
    bitstream_sha256: str,
}

pub struct Config {
    flasher: str,
}

pub struct Board {
    idcode_full: str,
}

pub struct Receipt {
    schema: str,
    contract_version: str,
    kind: str,
    bitstream: Bitstream,
    provenance: Provenance,
    config: Config,
    board: Board,
    transcript_sha256: str,
    result_line: str,
    hardware: bool,
}

pub struct CheckResult {
    errors: [8]str,
    len: u32,
}

// Stub: the host reads the system clock.
pub fn utcnow() -> str {
    return "";
}

// Stub: the host reads and hashes the file.
pub fn sha256_file(path: str) -> str {
    return "";
}

fn starts_with(s: str, prefix: str) -> bool {
    if (s.len < prefix.len) {
        return false;
    }
    return std.mem.eql(u8, s[0..prefix.len], prefix);
}

fn contains_byte(s: str, c: u8) -> bool {
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == c) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn is_hex_char(c: u8) -> bool {
    return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f');
}

// 64 lowercase hex digits.
fn is_hex64(s: str) -> bool {
    if (s.len != 64) {
        return false;
    }
    var i: usize = 0;
    while (i < s.len) {
        if (!is_hex_char(s[i])) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn empty_findings() -> CheckResult {
    return CheckResult{ .errors = [ "", "", "", "", "", "", "", "" ], .len = 0 };
}

fn add_finding(findings: CheckResult, name: str) -> CheckResult {
    var f: CheckResult = findings;
    if (f.len < 8) {
        f.errors[f.len] = name;
        f.len += 1;
    }
    return f;
}

// The verdict rules, kept from the original check_receipt().
pub fn check_receipt(r: Receipt, consts: Consts) -> CheckResult {
    var findings: CheckResult = empty_findings();

    if (r.schema != consts.schema or r.contract_version != consts.contract_version) {
        findings = add_finding(findings, "wrong_version");
    }

    let kind: str = r.kind;
    if (!(kind == "dry_run" or kind == "device")) {
        findings = add_finding(findings, "wrong_version");
        return findings;
    }

    let bs: Bitstream = r.bitstream;
    let sha: str = bs.sha256;
    let prov_sha: str = r.provenance.bitstream_sha256;
    if (sha.len == 0 or !is_hex64(sha) or (prov_sha.len > 0 and prov_sha != sha)) {
        findings = add_finding(findings, "hash_mismatch");
    }

    if (!bs.path_resolved) {
        findings = add_finding(findings, "bitstream_absent");
    }
    if (bs.bytes == 0) {
        findings = add_finding(findings, "bitstream_empty");
    }

    let flasher: str = r.config.flasher;
    var is_placeholder: bool = false;
    if (flasher.len == 0) {
        is_placeholder = true;
    }
    if (flasher == "TBD" or flasher == "PLACEHOLDER" or contains_byte(flasher, '<')) {
        is_placeholder = true;
    }
    if (is_placeholder) {
        findings = add_finding(findings, "placeholder_command");
    }

    if (kind == "device") {
        if (r.board.idcode_full != consts.idcode_full) {
            findings = add_finding(findings, "idcode_mismatch");
        }
        let tr: str = r.transcript_sha256;
        let result_line: str = r.result_line;
        if (tr.len == 0 or !is_hex64(tr) or !starts_with(result_line, "HW RESULT: ")) {
            findings = add_finding(findings, "transcript_missing");
        }
    } else {
        if (r.result_line.len > 0 or r.hardware) {
            findings = add_finding(findings, "dry_run_as_device");
        }
    }
    return findings;
}

// The host reads the receipt file and prints the findings; the planted
// defects of the original self-check need a growable list and stay there.
// This negative control plants one defect and checks it is the only finding.
pub fn self_check() -> i32 {
    var c: Consts = good_consts();
    var r: Receipt = clean_receipt();
    if (check_receipt(r, c).len != 0) {
        return 2;
    }
    r.bitstream.bytes = 0;
    var f: CheckResult = check_receipt(r, c);
    if (f.len != 1 or f.errors[0] != "bitstream_empty") {
        return 2;
    }
    return 0;
}

pub fn good_consts() -> Consts {
    return Consts{ .schema = SCHEMA, .contract_version = CONTRACT_VERSION, .idcode_full = IDCODE_FULL, .idcode_printed = IDCODE_PRINTED };
}

pub fn clean_receipt() -> Receipt {
    return Receipt{
        .schema = SCHEMA,
        .contract_version = CONTRACT_VERSION,
        .kind = "dry_run",
        .bitstream = Bitstream{ .sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", .path_resolved = true, .bytes = 123 },
        .provenance = Provenance{ .bitstream_sha256 = "" },
        .config = Config{ .flasher = "t27c" },
        .board = Board{ .idcode_full = IDCODE_FULL },
        .transcript_sha256 = "",
        .result_line = "",
        .hardware = false,
    };
}

pub fn main() -> i32 {
    return self_check();
}

test is_hex64_accepts_and_rejects {
    assert(is_hex64("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"));
    assert(!is_hex64("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdeg"));
    assert(!is_hex64("abc"));
}

test clean_receipt_has_no_findings {
    var f: CheckResult = check_receipt(clean_receipt(), good_consts());
    assert(f.len == 0);
}

test wrong_version_and_placeholder_are_found {
    var r: Receipt = clean_receipt();
    r.schema = "other";
    r.kind = "device";
    r.config.flasher = "TBD";
    r.transcript_sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    r.result_line = "HW RESULT: ok";
    var f: CheckResult = check_receipt(r, good_consts());
    assert(f.len == 2);
    assert(f.errors[0] == "wrong_version");
    assert(f.errors[1] == "placeholder_command");
}

test dry_run_claiming_hardware_is_found {
    var r: Receipt = clean_receipt();
    r.hardware = true;
    var f: CheckResult = check_receipt(r, good_consts());
    assert(f.len == 1);
    assert(f.errors[0] == "dry_run_as_device");
}

test device_needs_idcode_and_transcript {
    var r: Receipt = clean_receipt();
    r.kind = "device";
    r.board.idcode_full = "0x0";
    var f: CheckResult = check_receipt(r, good_consts());
    assert(f.len == 2);
    assert(f.errors[0] == "idcode_mismatch");
    assert(f.errors[1] == "transcript_missing");
}

test self_check_passes {
    assert(self_check() == 0);
}
