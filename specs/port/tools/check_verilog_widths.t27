// specs/port/tools/check_verilog_widths.t27.
// Part of M2 milestone (milestone #6). Closes #12313.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::tools::check_verilog_widths;

pub const CHECK_VERILOG_WIDTHS_MAX_BITS : u32 = 64;

pub struct VerilogWidth { name: str, width: u32 };

pub fn verilog_width_within_limit(v: VerilogWidth) -> bool {
    return v.width <= CHECK_VERILOG_WIDTHS_MAX_BITS;
}

test "verilog_width_within_limit" {
    assert(verilog_width_within_limit(VerilogWidth { name: "a", width: 32 }));
    assert(!verilog_width_within_limit(VerilogWidth { name: "b", width: 128 }));
}

invariant check_verilog_widths_max_bits_positive {
    assert CHECK_VERILOG_WIDTHS_MAX_BITS > 0;
}