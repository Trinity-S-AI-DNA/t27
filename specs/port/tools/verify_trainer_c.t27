// SPDX-License-Identifier: Apache-2.0
// specs/port/tools/verify_trainer_c.t27 -- Port of tools/verify_trainer_c.py
//
// The tool emits the GF-T microsequencer as a C program, builds it, runs an
// 80-step training sequence and compares every output with the Python GF-T
// model. The build, the subprocess and the model run stay with the tool. What
// is pure, and what both sides must agree on bit for bit, is ported here:
//   - modf: the operand modifier the C interpreter applies to a register read,
//   - the classification rule and one-hot targets of the training sequence,
//   - the register lookup by name used to load inputs and read outputs,
//   - the exit-status reading (a crash is a signal, not an arithmetic diff).

module specs::port::tools::verify_trainer_c;

pub const STEPS: u32 = 80;
pub const SIGN_BIT: u32 = 65536;
pub const MODF_ONE: u32 = 20480;

pub struct RegPair {
    name: str,
    index: i32,
}

// The operand modifier of the C interpreter, `modf_` in the emitted program.
//   0 identity            1 relu          2 relu derivative (fixed 1.0)
//   3 negate (flip sign)  4 halve magnitude (exponent offset - 3, sign flipped)
pub fn modf(v: u32, m: i32) -> u32 {
    var sgn: u32 = (v >> 16) & 1;
    if (m == 0) {
        return v;
    }
    if (m == 1) {
        if (v == 0 or sgn == 1) {
            return 0;
        }
        return v;
    }
    if (m == 2) {
        if (v == 0 or sgn == 1) {
            return 0;
        }
        return MODF_ONE;
    }
    if (m == 3) {
        if (v == 0) {
            return 0;
        }
        return v ^ SIGN_BIT;
    }
    if (m == 4) {
        if (v == 0) {
            return 0;
        }
        var off: u32 = (v >> 9) & 127;
        var mant: u32 = v & 511;
        if (off < 4) {
            return 0;
        }
        return ((v & SIGN_BIT) ^ SIGN_BIT) | (((off - 3) << 9) | mant);
    }
    return v;
}

// cls = int((xs[0] > 0) != (xs[-1] > 0))
pub fn class_of(first_positive: bool, last_positive: bool) -> u32 {
    if (first_positive != last_positive) {
        return 1;
    }
    return 0;
}

// ts[o] = 1.0 if o == cls % n_out else 0.0, as the one-hot flag.
pub fn target_hot(o: u32, cls: u32, n_out: u32) -> bool {
    return o == cls % n_out;
}

// Index of the register called `name`, or -1 when there is none.
pub fn reg_find(regs: []RegPair, name: str) -> i32 {
    var i: usize = 0;
    while (i < regs.len) {
        if (std.mem.eql(u8, regs[i].name, name)) {
            return regs[i].index;
        }
        i += 1;
    }
    return -1;
}

// A negative exit status is a signal number; zero is success.
pub fn signal_of(exit_code: i32) -> i32 {
    if (exit_code < 0) {
        return -exit_code;
    }
    return 0;
}

// The result of a run is only trusted when the program exited cleanly.
pub fn run_trusted(exit_code: i32) -> bool {
    return exit_code == 0;
}

// Output words are masked to 32 bits before comparison.
pub fn mask32(v: u64) -> u32 {
    return @intCast(v & 4294967295);
}

pub fn self_check() -> i32 {
    if (modf(5, 0) != 5) {
        return 2;
    }
    if (modf(SIGN_BIT + 5, 1) != 0) {
        return 2;
    }
    if (modf(0, 3) != 0) {
        return 2;
    }
    return 0;
}

pub fn main() -> i32 {
    return self_check();
}

test "modf_identity_and_unknown_mode" {
    assert(modf(0, 0) == 0);
    assert(modf(5, 0) == 5);
    assert(modf(65541, 0) == 65541);
    assert(modf(77, 9) == 77);
}

test "modf_relu" {
    assert(modf(0, 1) == 0);
    assert(modf(5, 1) == 5);
    assert(modf(65541, 1) == 0);
}

test "modf_relu_derivative" {
    assert(modf(0, 2) == 0);
    assert(modf(5, 2) == 20480);
    assert(modf(65541, 2) == 0);
}

test "modf_negate" {
    assert(modf(0, 3) == 0);
    assert(modf(5, 3) == 65541);
    assert(modf(65541, 3) == 5);
}

test "modf_halve_exponent" {
    assert(modf(0, 4) == 0);
    assert(modf(1541, 4) == 0);
    assert(modf(5127, 4) == 69127);
    assert(modf(70663, 4) == 3591);
}

test "class_and_targets" {
    assert(class_of(true, false) == 1);
    assert(class_of(false, true) == 1);
    assert(class_of(true, true) == 0);
    assert(class_of(false, false) == 0);
    assert(target_hot(0, 0, 2));
    assert(!target_hot(1, 0, 2));
    assert(target_hot(1, 1, 2));
    assert(target_hot(0, 1, 1));
    assert(STEPS == 80);
}

test "register_lookup" {
    var regs: [3]RegPair = [
        RegPair{ .name = "x0", .index = 0 },
        RegPair{ .name = "t0", .index = 1 },
        RegPair{ .name = "y0", .index = 2 }
    ];
    assert(reg_find(&regs, "x0") == 0);
    assert(reg_find(&regs, "y0") == 2);
    assert(reg_find(&regs, "y1") == -1);
}

test "exit_status_reading" {
    assert(signal_of(0) == 0);
    assert(signal_of(1) == 0);
    assert(signal_of(-11) == 11);
    assert(run_trusted(0));
    assert(!run_trusted(-11));
    assert(!run_trusted(2));
    assert(mask32(4294967296 + 7) == 7);
    assert(mask32(4294967295) == 4294967295);
}

test "self_check" {
    assert(self_check() == 0);
}
