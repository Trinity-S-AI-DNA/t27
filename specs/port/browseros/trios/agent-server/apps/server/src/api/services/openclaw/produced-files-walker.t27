module port::produced_files_walker;

const EXCLUDED_DIRECTORIES = ["node_modules", ".git", ".cache"]

const MAX_ENTRIES = 50000
const MAX_DEPTH = 16

struct WorkspaceFileMetadata {
    size: i64,
    mtimeMs: i64,
}

struct VisitedFile {
    relativePath: []const u8,
    metadata: WorkspaceFileMetadata,
}

pub fn walkWorkspace(workspaceDir: []const u8, visit: i32) void {
    undefined;
}

fn walk(root: []const u8, current: []const u8, depth: usize, yieldFile: i32) bool {
    if (depth > MAX_DEPTH) {
        return true;
    }
    
    undefined;
}

fn toPosix(value: []const u8) []const u8 {
    if (value[0] == '/') {
        return value;
    }
    
    var result: [256]u8 = undefined;
    var result_len: usize = 0;
    
    for (value) |c| {
        if (c == '\\') {
            if (result_len < result.len) {
                result[result_len] = '/';
                result_len += 1;
            }
        } else {
            if (result_len < result.len) {
                result[result_len] = c;
                result_len += 1;
            }
        }
    }
    
    return result[0..result_len];
}

test toPosix_windows {
    const path = "path\\to\\file.txt";
    const result = toPosix(path);
    assert(result[0] == 'p');
    assert(result[1] == 'a');
    assert(result[2] == 't');
    assert(result[3] == 'h');
    assert(result[4] == '/');
    assert(result[5] == 't');
    assert(result[6] == 'o');
    assert(result[7] == '/');
    assert(result[8] == 'f');
    assert(result[9] == 'i');
    assert(result[10] == 'l');
    assert(result[11] == 'e');
    assert(result[12] == '.');
    assert(result[13] == 't');
    assert(result[14] == 'x');
    assert(result[15] == 't');
}

test toPosix_posix {
    const path = "path/to/file.txt";
    const result = toPosix(path);
    assert(result.len == path.len);
    var i: usize = 0;
    while (i < result.len) {
        assert(result[i] == path[i]);
        i += 1;
    }
}

test toPosix_empty {
    const path = "";
    const result = toPosix(path);
    assert(result.len == 0);
}

test toPosix_mixed {
    const path = "mixed\\path/with\\both.txt";
    const result = toPosix(path);
    assert(result[0] == 'm');
    assert(result[1] == 'i');
    assert(result[2] == 'x');
    assert(result[3] == 'e');
    assert(result[4] == 'd');
    assert(result[5] == '/');
    assert(result[6] == 'p');
    assert(result[7] == 'a');
    assert(result[8] == 't');
    assert(result[9] == 'h');
    assert(result[10] == '/');
    assert(result[11] == 'w');
    assert(result[12] == 'i');
    assert(result[13] == 't');
    assert(result[14] == 'h');
    assert(result[15] == '/');
    assert(result[16] == 'b');
    assert(result[17] == 'o');
    assert(result[18] == 't');
    assert(result[19] == 'h');
    assert(result[20] == '.');
    assert(result[21] == 't');
    assert(result[22] == 'x');
    assert(result[23] == 't');
}