module port::browseros::trios::agent_server::apps::server::src::browser::elements;

// Port of trios/agent-server/apps/server/src/browser/elements.ts
// (gHashTag/BrowserOS, rev 879799a8bfb2) for issue gHashTag/t27#9393.
//
// Ported decisions, not plumbing: every CDP call (DOM.getContentQuads,
// DOM.getBoxModel, Runtime evaluate of getBoundingClientRect,
// DOM.scrollIntoViewIfNeeded, DOM.pushNodesByBackendIdsToFrontend, DOM.focus,
// DOM.resolveNode, Runtime.callFunctionOn) becomes a declared function with an
// `undefined;` body. Those stubs are never called from tests; the pure decision
// logic around them (quads math, fallback tiers, argument mapping, error
// mapping) is ported and tested below.
//
// Follows the sibling ports in this directory (bookmarks.t27, history.t27):
// `str` strings, camelCase helpers, an opaque `*CdpSession` handle for CDP
// plumbing, `undefined;` stub bodies, enums for closed decision sets, and
// optionals for "absent".

struct Point {
    x: f64,
    y: f64,
}

// Opaque handle for the CDP ProtocolApi session — plumbing, not representable
// in this spec. Same pattern as CdpBackend in bookmarks.t27.
struct CdpSession {
    _opaque: u8,
}

// The call payload built by jsClick / getInputValue / callOnElement before it
// is handed to Runtime.callFunctionOn (original lines 80-84, 101-104, 115-121).
struct CallRequest {
    fnDeclaration: str,
    returnByValue: bool,
    includeArguments: bool,
    argumentCount: usize,
}

// resolveObjectId outcome: the original throws when objectId is missing
// (line 92); here that decision returns an explicit outcome instead.
struct ResolveOutcome {
    ok: bool,
    objectId: str,
    err: str,
}

// Failure tiers of getElementCenter (original lines 36 and 40).
enum CenterError {
    None,
    Unresolved,
    NoBounds,
}

struct CenterOutcome {
    ok: bool,
    x: f64,
    y: f64,
    err: CenterError,
}

// --- quadCenter (original lines 3-8) ---

// `q[i] ?? 0` (line 7): missing quad coordinates count as zero.
pub fn quadAt(q: []const f64, i: usize) -> f64 {
    if (i < q.len) {
        return q[i];
    }
    return 0.0;
}

// Average of the 4 quad points; entries beyond the array default to 0
// (lines 3-8).
pub fn quadCenter(q: []const f64) -> Point {
    const x = (quadAt(q, 0) + quadAt(q, 2) + quadAt(q, 4) + quadAt(q, 6)) / 4.0;
    const y = (quadAt(q, 1) + quadAt(q, 3) + quadAt(q, 5) + quadAt(q, 7)) / 4.0;
    return Point { x: x, y: y };
}

// --- getElementCenter (original lines 10-52) ---

// The three fallback tiers that decide (x, y); the CDP calls themselves stay
// behind the getElementCenter stub below. Tier 1: content quads (lines 12-18).
// Tier 2: box model content (lines 19-25). Tier 3: getBoundingClientRect via
// Runtime (lines 26-52); without an objectId the original throws at line 36
// before even trying, and without bounds it throws at line 40.
pub fn decideCenter(quads: []const f64, content: []const f64, haveObjectId: bool, haveRect: bool, rx: f64, ry: f64, rw: f64, rh: f64) -> CenterOutcome {
    if (quads.len >= 8) {
        const c = quadCenter(quads);
        return CenterOutcome { ok: true, x: c.x, y: c.y, err: .None };
    }
    if (content.len >= 8) {
        const c = quadCenter(content);
        return CenterOutcome { ok: true, x: c.x, y: c.y, err: .None };
    }
    if (!haveObjectId) {
        return CenterOutcome { ok: false, x: 0.0, y: 0.0, err: .Unresolved };
    }
    if (!haveRect) {
        return CenterOutcome { ok: false, x: 0.0, y: 0.0, err: .NoBounds };
    }
    return CenterOutcome { ok: true, x: rx + rw / 2.0, y: ry + rh / 2.0, err: .None };
}

// Error messages thrown by the original (lines 36 and 40), kept verbatim.
pub fn centerErrorMessage(kind: CenterError) -> str {
    if (kind == .Unresolved) {
        return "Could not resolve element — it may have been removed from the page.";
    }
    if (kind == .NoBounds) {
        return "Could not get element bounds.";
    }
    return "";
}

// External: DOM.getContentQuads (line 12), DOM.getBoxModel (line 19) and
// Runtime evaluate of getBoundingClientRect (line 45) — plumbing only; the
// decisions live in decideCenter.
pub fn getElementCenter(session: *CdpSession, backendNodeId: i64) -> Point {
    undefined;
}

// --- scrollIntoView (original lines 54-63) ---

// Lines 59-62: whether or not the CDP scroll call fails, scrollIntoView
// completes without reporting a failure ("not critical"). Returns whether the
// caller should treat the scroll as done — it always should.
pub fn scrollVerdict(scrollFailed: bool) -> bool {
    if (scrollFailed) {
        return true;
    }
    return true;
}

// External: DOM.scrollIntoViewIfNeeded (line 56); errors are swallowed.
pub fn scrollIntoView(session: *CdpSession, backendNodeId: i64) -> void {
    undefined;
}

// --- focusElement (original lines 65-73) ---

// Line 72: focus the first node pushed back to the frontend.
pub fn focusTarget(nodeIds: []const i64) -> i64 {
    return nodeIds[0];
}

// External: DOM.pushNodesByBackendIdsToFrontend (line 70) + DOM.focus (line 74).
pub fn focusElement(session: *CdpSession, backendNodeId: i64) -> void {
    undefined;
}

// --- jsClick (original lines 75-84) ---

// The payload handed to Runtime.callFunctionOn for the JS click (lines 80-84).
pub fn jsClickRequest() -> CallRequest {
    return CallRequest {
        fnDeclaration: "function(){this.click()}",
        returnByValue: false,
        includeArguments: false,
        argumentCount: 0,
    };
}

// External: DOM.resolveNode (line 78) + Runtime.callFunctionOn (line 83).
pub fn jsClick(session: *CdpSession, backendNodeId: i64) -> void {
    undefined;
}

// --- resolveObjectId (original lines 86-96) ---

// Line 92: a missing objectId throws "Element not found in DOM. Take a new
// snapshot."; a present objectId is returned. Expressed as an outcome.
pub fn objectIdVerdict(resolved: ?str) -> ResolveOutcome {
    if (resolved == null) {
        return ResolveOutcome { ok: false, objectId: "", err: "Element not found in DOM. Take a new snapshot." };
    }
    return ResolveOutcome { ok: true, objectId: resolved.?, err: "" };
}

// External: DOM.resolveNode (line 89); failure throws per objectIdVerdict.
pub fn resolveObjectId(session: *CdpSession, backendNodeId: i64) -> str {
    undefined;
}

// --- getInputValue (original lines 98-112) ---

// Lines 107-111: `value ?? textContent ?? ''`, with the catch on line 111
// folding into the null case — an empty string is always returned on failure.
pub fn inputValueOrEmpty(rawValue: ?str) -> str {
    if (rawValue == null) {
        return "";
    }
    return rawValue.?;
}

// The payload handed to Runtime.callFunctionOn (lines 101-104).
pub fn inputValueRequest() -> CallRequest {
    return CallRequest {
        fnDeclaration: "function(){return this.value??this.textContent??\"\"}",
        returnByValue: true,
        includeArguments: false,
        argumentCount: 0,
    };
}

// External: callOnElement (line 104); the raw remote value comes back as a
// string, normalized by inputValueOrEmpty.
pub fn getInputValue(session: *CdpSession, backendNodeId: i64) -> str {
    undefined;
}

// --- callOnElement (original lines 114-125) ---

// Lines 118-121: no args -> no arguments array at all; args -> one entry per
// element.
pub fn argumentEntries(haveArgs: bool, argCount: usize) -> usize {
    if (!haveArgs) {
        return 0;
    }
    return argCount;
}

// Lines 115-121: returnByValue is always true and arguments are mapped by
// argumentEntries. The original `args: unknown[]` is not expressible here, so
// only the presence and count of arguments shape the request.
pub fn callOnElementRequest(fnDeclaration: str, haveArgs: bool, argCount: usize) -> CallRequest {
    return CallRequest {
        fnDeclaration: fnDeclaration,
        returnByValue: true,
        includeArguments: haveArgs,
        argumentCount: argumentEntries(haveArgs, argCount),
    };
}

// External: DOM.resolveNode (line 117) + Runtime.callFunctionOn (line 120);
// the `args` array and the raw return value are plumbing.
pub fn callOnElement(session: *CdpSession, backendNodeId: i64, fnDeclaration: str) -> ?str {
    undefined;
}

// --- tests ---

test quadCenter_full_quad {
    var q: [8]f64 = [2.0, 4.0, 8.0, 4.0, 8.0, 12.0, 2.0, 12.0];
    const c = quadCenter(&q);
    assert(c.x == 5.0);
    assert(c.y == 8.0);
}

test quadCenter_short_entries_default_to_zero {
    var q: [2]f64 = [4.0, 8.0];
    const c = quadCenter(&q);
    assert(c.x == 1.0);
    assert(c.y == 2.0);
}

test quadCenter_five_entries_mixed {
    var q: [5]f64 = [2.0, 6.0, 4.0, 8.0, 6.0];
    const c = quadCenter(&q);
    assert(c.x == 3.0);
    assert(c.y == 3.5);
}

test quadAt_missing_entries_default_to_zero {
    var q: [2]f64 = [4.0, 8.0];
    assert(quadAt(&q, 0) == 4.0);
    assert(quadAt(&q, 2) == 0.0);
}

test decideCenter_prefers_content_quads {
    var quads: [8]f64 = [0.0, 0.0, 4.0, 0.0, 4.0, 4.0, 0.0, 4.0];
    var content: [8]f64 = [100.0, 100.0, 108.0, 100.0, 108.0, 108.0, 100.0, 108.0];
    const o = decideCenter(&quads, &content, true, true, 10.0, 20.0, 30.0, 40.0);
    assert(o.ok == true);
    assert(o.x == 2.0);
    assert(o.y == 2.0);
}

test decideCenter_falls_back_to_box_model {
    var quads: [4]f64 = [1.0, 2.0, 3.0, 4.0];
    var content: [8]f64 = [100.0, 100.0, 108.0, 100.0, 108.0, 108.0, 100.0, 108.0];
    const o = decideCenter(&quads, &content, true, true, 10.0, 20.0, 30.0, 40.0);
    assert(o.ok == true);
    assert(o.x == 104.0);
    assert(o.y == 104.0);
}

test decideCenter_rect_tier_centers_the_rect {
    var quads: [2]f64 = [1.0, 2.0];
    var content: [2]f64 = [1.0, 2.0];
    const o = decideCenter(&quads, &content, true, true, 10.0, 20.0, 30.0, 40.0);
    assert(o.ok == true);
    assert(o.x == 25.0);
    assert(o.y == 40.0);
}

test decideCenter_unresolved_without_objectId {
    var quads: [2]f64 = [1.0, 2.0];
    var content: [2]f64 = [1.0, 2.0];
    const o = decideCenter(&quads, &content, false, true, 10.0, 20.0, 30.0, 40.0);
    assert(o.ok == false);
    assert(centerErrorMessage(o.err) == "Could not resolve element — it may have been removed from the page.");
}

test decideCenter_noBounds_without_rect {
    var quads: [2]f64 = [1.0, 2.0];
    var content: [2]f64 = [1.0, 2.0];
    const o = decideCenter(&quads, &content, true, false, 10.0, 20.0, 30.0, 40.0);
    assert(o.ok == false);
    assert(centerErrorMessage(o.err) == "Could not get element bounds.");
}

test centerErrorMessage_maps_kinds_to_original_messages {
    assert(centerErrorMessage(.Unresolved) == "Could not resolve element — it may have been removed from the page.");
    assert(centerErrorMessage(.NoBounds) == "Could not get element bounds.");
    assert(centerErrorMessage(.None) == "");
}

test scrollVerdict_swallows_every_failure {
    const failed = scrollVerdict(true);
    const clean = scrollVerdict(false);
    assert(failed == true);
    assert(clean == true);
}

test focusTarget_picks_first_pushed_node {
    var ids: [2]i64 = [42, 7];
    assert(focusTarget(&ids) == 42);
}

test jsClickRequest_shape {
    const r = jsClickRequest();
    assert(r.fnDeclaration == "function(){this.click()}");
    assert(r.returnByValue == false);
    assert(r.includeArguments == false);
    assert(r.argumentCount == 0);
}

test objectIdVerdict_present_returns_objectId {
    const ok = objectIdVerdict("123.45");
    assert(ok.ok == true);
    assert(ok.objectId == "123.45");
    assert(ok.err == "");
}

test objectIdVerdict_missing_throws_message {
    const bad = objectIdVerdict(null);
    assert(bad.ok == false);
    assert(bad.err == "Element not found in DOM. Take a new snapshot.");
}

test inputValueOrEmpty_passes_through_or_empties {
    assert(inputValueOrEmpty("hello") == "hello");
    assert(inputValueOrEmpty(null) == "");
}

test inputValueRequest_shape {
    const r = inputValueRequest();
    assert(r.fnDeclaration == "function(){return this.value??this.textContent??\"\"}");
    assert(r.returnByValue == true);
    assert(r.includeArguments == false);
}

test argumentEntries_onePerArg {
    const with = argumentEntries(true, 3);
    const without = argumentEntries(false, 3);
    assert(with == 3);
    assert(without == 0);
}

test callOnElementRequest_with_and_without_args {
    const with = callOnElementRequest("function(){return 1}", true, 2);
    assert(with.fnDeclaration == "function(){return 1}");
    assert(with.returnByValue == true);
    assert(with.includeArguments == true);
    assert(with.argumentCount == 2);
    const without = callOnElementRequest("function(){return 1}", false, 0);
    assert(without.includeArguments == false);
    assert(without.argumentCount == 0);
}
