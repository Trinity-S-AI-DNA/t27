// SPDX-License-Identifier: Apache-2.0
; Port of the image-loader's ENSURE decision as a law. The TS loader pulls a
; container image only when it is missing and reports the pull's error; the
; mocks and the I/O stay host plumbing. The law works on FACTS the host
; measures (did the image exist before, what code did the pull return, did it
; exist after) and answers one code:
;   0  the image is present, nothing to do
;   1  the pull succeeded but the image is still missing (the detect path)
;   N>1 the pull itself failed with that code
; A zero-length image ref refuses up front: there is nothing to ensure.

module port::image_loader;

/// The ensure decision: present -> 0; the pull failed -> that code; the pull
/// succeeded but the image is still missing -> 1; the pull surfaced it -> 0.
pub fn ensure_image_loaded(exists_before: bool, pull_err: u32, exists_after: bool, ref_len: u32) -> u32 {
    if (ref_len == 0) { return 1; }
    if (exists_before) { return 0; }
    if (pull_err != 0) { return pull_err; }
    if (!exists_after) { return 1; }
    return 0;
}

/// The agent-image selection: an unknown agent name refuses (code 1), a pull
/// error passes through, a known agent ensures its own image.
pub fn ensure_agent_image_loaded(known: bool, pull_err: u32) -> u32 {
    if (!known) { return 1; }
    if (pull_err != 0) { return pull_err; }
    return 0;
}

test present_image_is_zero_work {
    assert ensure_image_loaded(true, 0, true, 9) == 0;
    assert ensure_image_loaded(true, 99, true, 9) == 0;
}

test pull_error_passes_through {
    assert ensure_image_loaded(false, 42, false, 9) == 42;
}

test pull_success_but_still_missing_is_the_detect_path {
    assert ensure_image_loaded(false, 0, false, 9) == 1;
}

test pull_success_and_present_is_zero_work {
    assert ensure_image_loaded(false, 0, true, 9) == 0;
}

test an_empty_ref_refuses_up_front {
    assert ensure_image_loaded(true, 0, true, 0) == 1;
    assert ensure_image_loaded(false, 0, false, 0) == 1;
}

test the_agent_gate_refuses_unknown_names {
    assert ensure_agent_image_loaded(false, 0) == 1;
    assert ensure_agent_image_loaded(false, 42) == 1;
}

test the_agent_pull_error_passes_through {
    assert ensure_agent_image_loaded(true, 42) == 42;
    assert ensure_agent_image_loaded(true, 0) == 0;
}
