module port::queen_public_leaderboard;

const MAX_DAYS: i32 = 3650;

pub fn processDays(raw: ?[]const u8) -> ?i32 {
    if (raw == null) {
        return null;
    }
    const s = raw.?;
    if (s.len == 0) {
        return null;
    }
    var i: usize = 0;
    var sign: i32 = 1;
    if (s[i] == '+') {
        i = i + 1;
    } else if (s[i] == '-') {
        sign = -1;
        i = i + 1;
    }
    if (i >= s.len) {
        return null;
    }
    const start: usize = i;
    while (i < s.len and s[i] >= '0' and s[i] <= '9') {
        i = i + 1;
    }
    if (i == start) {
        return null;
    }
    if (i < s.len) {
        return null;
    }
    var num: i32 = 0;
    var pos: usize = start;
    while (pos < i) {
        // Once num is past MAX_DAYS the result is clamped anyway; stop
        // multiplying so a long digit string cannot overflow i32.
        if (num <= MAX_DAYS) {
            num = num * 10 + ((s[pos] - '0') as i32);
        }
        pos = pos + 1;
    }
    num = num * sign;
    if (num < 1) {
        return 1;
    }
    if (num > MAX_DAYS) {
        return MAX_DAYS;
    }
    return num;
}

pub fn isDatabaseConfigured(url: ?[]const u8) -> bool {
    if (url == null) {
        return false;
    }
    return url.?.len > 0;
}

pub fn createQueenPublicLeaderboardRoute() {
    // Route registration is not modelled in t27.
}

test processDays_nullInput {
    assert(processDays(null) == null);
}

test processDays_emptyString {
    var empty: []const u8 = "";
    assert(processDays(empty) == null);
}

test processDays_validNumber {
    var numStr: []const u8 = "123";
    assert(processDays(numStr) == 123);
}

test processDays_negativeNumber {
    var numStr: []const u8 = "-5";
    assert(processDays(numStr) == 1);
}

test processDays_aboveMax {
    var numStr: []const u8 = "4000";
    assert(processDays(numStr) == MAX_DAYS);
}

test processDays_belowOne {
    var numStr: []const u8 = "0";
    assert(processDays(numStr) == 1);
}

test processDays_nonNumeric {
    var numStr: []const u8 = "abc";
    assert(processDays(numStr) == null);
}

test processDays_trailingGarbage {
    var numStr: []const u8 = "123abc";
    assert(processDays(numStr) == null);
}

test isDatabaseConfigured_null {
    assert(!isDatabaseConfigured(null));
}

test isDatabaseConfigured_emptyString {
    var empty: []const u8 = "";
    assert(!isDatabaseConfigured(empty));
}

test isDatabaseConfigured_nonEmptyString {
    var str: []const u8 = "hello";
    assert(isDatabaseConfigured(str));
}