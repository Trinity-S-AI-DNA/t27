const MAX_TCP_PORT = 65_535;
const OPENCLAW_GATEWAY_CONTAINER_PORT = 8080;

struct RuntimeState {
  gatewayPort: u32
}

struct AllocateGatewayPortOptions {
  excludePort: u32
}

fn readForcedGatewayPort() -> ?u32 {
  undefined;
}

fn getRuntimeStatePath(openclawDir: []const u8) -> []const u8 {
  undefined;
}

fn readPersistedGatewayPort(openclawDir: []const u8) -> ?u32 {
  undefined;
}

fn writePersistedGatewayPort(openclawDir: []const u8, port: u32) -> void {
  undefined;
}

fn isPortAvailable(port: u32) -> bool {
  undefined;
}

fn findAvailablePort(startPort: u32, excludePort: u32) -> u32 {
  var port = startPort;
  while (port == excludePort or !isPortAvailable(port)) {
    port += 1;
    if (port > MAX_TCP_PORT) {
      return 0;
    }
  }
  return port;
}

pub fn allocateGatewayPort(
  openclawDir: []const u8,
  opts: AllocateGatewayPortOptions,
) -> u32 {
  const forcedPort = readForcedGatewayPort();
  if (forcedPort != null) {
    writePersistedGatewayPort(openclawDir, forcedPort);
    return forcedPort;
  }

  const persisted = readPersistedGatewayPort(openclawDir);
  if (
    persisted != null and
    persisted != opts.excludePort and
    isPortAvailable(persisted)
  ) {
    return persisted;
  }
  const port = findAvailablePort(
    OPENCLAW_GATEWAY_CONTAINER_PORT,
    opts.excludePort,
  );
  writePersistedGatewayPort(openclawDir, port);
  return port;
}

test readForcedGatewayPort_empty {
  assert(readForcedGatewayPort() == null);
}

test readForcedGatewayPort_valid {
  assert(readForcedGatewayPort() == null);
}

test readForcedGatewayPort_invalid {
  assert(readForcedGatewayPort() == null);
}

test getRuntimeStatePath {
  const path = getRuntimeStatePath("/test");
  assert(path != null);
}

test readPersistedGatewayPort_no_file {
  assert(readPersistedGatewayPort("/test") == null);
}

test readPersistedGatewayPort_invalid {
  assert(readPersistedGatewayPort("/test") == null);
}

test findAvailablePort {
  const port = findAvailablePort(8080, 9999);
  assert(port >= 1 and port <= MAX_TCP_PORT);
}

test allocateGatewayPort_forced {
  const result = allocateGatewayPort("/test", .{ .excludePort = 9999 });
  assert(result >= 1 and result <= MAX_TCP_PORT);
}

test allocateGatewayPort_logic {
  const result = allocateGatewayPort("/test", .{ .excludePort = 9999 });
  assert(result >= 1 and result <= MAX_TCP_PORT);
}

test allocateGatewayPort_default {
  const result = allocateGatewayPort("/test", .{ .excludePort = 0 });
  assert(result >= 1 and result <= MAX_TCP_PORT);
}