module port::queen-pool;

// Port of trios/agent-server apps/server/src/lib/db/queen-pool.ts. The
// original is the one place a PostgreSQL pool is built and the one place
// the Queen's schema is named; building the Pool and pinning search_path
// on connect is plumbing. The decisions this module owns are three: which
// connection URLs are Neon (TLS the driver cannot verify, so ssl comes on
// with rejectUnauthorized false), which QUEEN_DB_SCHEMA value is safe to
// interpolate into SET search_path (a plain identifier, or the original
// throws), and the 'trios' default that makes an invisible role setting
// visible without changing a single resolution.

struct SslResult {
    enabled: bool,
    rejectUnauthorized: bool,
}

// The original's databaseUrl.includes('neon.tech'): a substring scan for
// the host marker, at any position in the URL -- not a whole-string
// compare and not the word 'neon' alone.
fn contains_neon_tech(url: str) -> bool {
    var i: usize = 0;
    while (i + 9 <= url.len) {
        if (url[i] == 'n') {
            if (url[i + 1] == 'e') {
                if (url[i + 2] == 'o') {
                    if (url[i + 3] == 'n') {
                        if (url[i + 4] == '.') {
                            if (url[i + 5] == 't') {
                                if (url[i + 6] == 'e') {
                                    if (url[i + 7] == 'c') {
                                        if (url[i + 8] == 'h') {
                                            return true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Neon terminates TLS with a certificate this driver will not verify, so
// those URLs get ssl with rejectUnauthorized false; every other URL gets
// no ssl at all (the original returns undefined there).
fn sslFor(databaseUrl: str) -> SslResult {
    if (contains_neon_tech(databaseUrl)) {
        return SslResult { enabled: true, rejectUnauthorized: false };
    }
    return SslResult { enabled: false, rejectUnauthorized: false };
}

// The original trims QUEEN_DB_SCHEMA before the gate, so ' trios ' is the
// default in disguise, not a refusal.
fn trim_spaces(raw: str) -> str {
    var start: usize = 0;
    var end: usize = raw.len;
    while (start < end) {
        if (raw[start] == ' ') {
            start = start + 1;
        } else {
            break;
        }
    }
    while (end > start) {
        if (raw[end - 1] == ' ') {
            end = end - 1;
        } else {
            break;
        }
    }
    return raw[start..end];
}

// ^[A-Za-z_][A-Za-z0-9_]*$ -- the identifier gate. This string is
// interpolated into SQL, and an identifier read from the environment is
// an injection site if it is not checked.
fn is_plain_identifier(raw: str) -> bool {
    if (raw.len == 0) {
        return false;
    }
    var c: u8 = raw[0];
    var ok: bool = false;
    if (c == '_') { ok = true; }
    if (c >= 'A' and c <= 'Z') { ok = true; }
    if (c >= 'a' and c <= 'z') { ok = true; }
    if (ok == false) { return false; }
    var i: usize = 1;
    while (i < raw.len) {
        c = raw[i];
        ok = false;
        if (c == '_') { ok = true; }
        if (c >= '0' and c <= '9') { ok = true; }
        if (c >= 'A' and c <= 'Z') { ok = true; }
        if (c >= 'a' and c <= 'z') { ok = true; }
        if (ok == false) { return false; }
        i = i + 1;
    }
    return true;
}

// The schema every Queen table is in. Reading the environment is plumbing;
// the decisions -- the 'trios' default, the trim, the gate -- are the
// helpers above. null is the original's throw: the value is not a plain
// identifier and must never reach SET search_path.
pub fn queenSchema(envValue: ?str) -> ?str {
    var raw: str = 'trios';
    if (envValue != null) {
        raw = envValue.?;
    }
    const trimmedRaw = trim_spaces(raw);
    if (is_plain_identifier(trimmedRaw) == false) {
        return null;
    }
    return trimmedRaw;
}

// Building the Pool and pinning SET search_path TO <schema> on every new
// connection is plumbing; no test calls this.
pub fn createQueenPool(databaseUrl: str, extra: str) -> i32 {
    _ = databaseUrl;
    _ = extra;
    undefined;
}

test neon_urls_get_ssl_the_driver_can_not_verify {
    const result = sslFor('postgresql://user@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb');
    assert(result.enabled == true);
    assert(result.rejectUnauthorized == false);
}

test the_marker_is_a_substring_not_the_whole_url {
    // the URL may end on the marker, with no path behind it
    const bare = sslFor('postgres://ep-xyz-98765.eu-central-1.aws.neon.tech');
    assert(bare.enabled == true);
    // the word 'neon' alone is not the marker
    const lookalike = sslFor('postgres://neon.example.com/queen');
    assert(lookalike.enabled == false);
}

test plain_urls_get_no_ssl_at_all {
    const local = sslFor('postgres://localhost:5432/queen');
    assert(local.enabled == false);
    assert(local.rejectUnauthorized == false);
    const missing = sslFor('');
    assert(missing.enabled == false);
}

test queenSchema_defaults_to_trios_and_trims {
    assert(queenSchema(null).? == 'trios');
    assert(queenSchema(' trios ').? == 'trios');
}

test queenSchema_accepts_plain_identifier_overrides {
    assert(queenSchema('queen_test_v2').? == 'queen_test_v2');
    assert(queenSchema('_underscore_leads').? == '_underscore_leads');
}

test queenSchema_refuses_anything_it_would_interpolate {
    // the SQL injection shapes: punctuation, a hyphen, a leading digit,
    // emptiness -- none of these may reach SET search_path
    assert(queenSchema('queen; DROP TABLE x') == null);
    assert(queenSchema('trios-test') == null);
    assert(queenSchema('123schema') == null);
    assert(queenSchema('') == null);
    assert(queenSchema('   ') == null);
}
