// SPDX-License-Identifier: Apache-2.0
; Port of the soul-update tool's TEXT DECISION as a law. The TS tool decides
; how to report a SOUL.md write: truncated writes report the dropped line
; count and the dropped content; clean writes report none. The file content
; itself is host plumbing (strings of any length cannot be a t27 value); the
; DECISION below is the law the host consults with the write's facts.

module port::update_soul;

/// The write report caps the preview at this many lines.
pub const SOUL_MAX_LINES : i32 = 100;

/// Kind codes for the write report: 1 truncated, 2 not truncated.
pub const SOUL_KIND_TRUNCATED : u32 = 1;
pub const SOUL_KIND_NOT_TRUNCATED : u32 = 2;

/// The report's kind: a write that hit the cap is TRUNCATED, anything else
/// is NOT_TRUNCATED.
pub fn soul_update_kind(truncated: bool) -> u32 {
    if (truncated) { return SOUL_KIND_TRUNCATED; }
    return SOUL_KIND_NOT_TRUNCATED;
}

/// The report's dropped-line count: only a truncated write drops lines.
pub fn soul_dropped_lines(truncated: bool, dropped: i32) -> i32 {
    if (truncated) { return dropped; }
    return 0;
}

test the_kind_follows_the_cap {
    assert soul_update_kind(true) == SOUL_KIND_TRUNCATED;
    assert soul_update_kind(false) == SOUL_KIND_NOT_TRUNCATED;
}

test only_a_truncated_write_drops_lines {
    assert soul_dropped_lines(true, 7) == 7;
    assert soul_dropped_lines(true, 0) == 0;
    assert soul_dropped_lines(false, 7) == 0;
}

test the_cap_is_one_hundred_lines {
    assert SOUL_MAX_LINES == 100;
}
