// SPDX-License-Identifier: Apache-2.0
; Port of the credits routes' DEPENDENCY GATE as a law. The TS route mounts
; a Hono app only when both dependency identifiers are present; this spec
; holds that decision. The Hono handle itself is host plumbing (it cannot be
; a t27 value), so the law answers the question the host asks before
; mounting: are the deps usable?

module port::credits;

/// Both dependency identifiers must be non-empty for the credits routes to
/// mount. Lengths are parameters (the affected.t27 idiom: gen-c carries no
/// .len on str), the host passes the measured lengths.
pub fn credits_deps_ok(browseros_id_len: u32, gateway_base_url_len: u32) -> bool {
    return browseros_id_len > 0 and gateway_base_url_len > 0;
}

test credits_deps_both_present_mount {
    assert credits_deps_ok(1, 1) == true;
    assert credits_deps_ok(7, 40) == true;
}

test credits_deps_any_empty_refuses {
    assert credits_deps_ok(0, 40) == false;
    assert credits_deps_ok(7, 0) == false;
    assert credits_deps_ok(0, 0) == false;
}
