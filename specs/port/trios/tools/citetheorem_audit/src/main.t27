module port::trios::tools::citetheorem_audit::src::main;

// Port of gHashTag/trios tools/citetheorem_audit/src/main.rs (111 lines).
//
// The binary's world access (clap parsing, reading chapters, reading the
// assertions JSON, printing) is plumbing. What main decides is the exit path:
// --print-anchors always succeeds, --report keeps a healthy-I/O run at 0 even
// when the R14 verdict is negative, and strict mode maps the error variant to
// its reserved 80..=83 code through fail(). Those two functions are ported
// purely; no test reads a file or parses argv.

// Lines 60-68 and 107-111: the four rejection classes and the admit code.
enum CiteAuditError {
    Admitted,
    AssertionsLoadError,
    ChaptersDirError,
    UnknownInvCited,
    BelowMinCitations,
}

// Lines 107-111: exit code per error variant. The Rust function reads the code
// from CiteAuditError::exit_code(); the same mapping is stated by the anchors
// document at lines 62-68 (admit 0, load 80, chapters 81, unknown INV 82,
// below-min 83).
pub fn fail(kind: CiteAuditError) -> u8 {
    if (kind == .AssertionsLoadError) {
        return 80;
    }
    if (kind == .ChaptersDirError) {
        return 81;
    }
    if (kind == .UnknownInvCited) {
        return 82;
    }
    if (kind == .BelowMinCitations) {
        return 83;
    }
    return 0;
}

// Lines 53-105. The two branches are the decision:
//   * `--print-anchors` returns SUCCESS before any audit (lines 56-76);
//   * `--report` renders the verdict into JSON and returns SUCCESS for a healthy
//     I/O run (lines 78-92), so a negative R14 verdict is not a failure there;
//   * strict mode (default) returns fail(e) for any rejection (lines 94-104).
// A load/chapters-dir error is an I/O failure in both modes, so it still goes
// through fail(). `kind` is the outcome the audit library would have returned.
pub fn main(print_anchors: bool, report: bool, kind: CiteAuditError) -> u8 {
    if (print_anchors) {
        return 0;
    }
    if (report) {
        if (kind == .UnknownInvCited || kind == .BelowMinCitations) {
            return 0;
        }
        return fail(kind);
    }
    return fail(kind);
}

// Lines 56-76: anchors mode short-circuits with success.
test main_print_anchors_is_success {
    assert(main(true, false, .BelowMinCitations) == 0);
    assert(main(true, true, .AssertionsLoadError) == 0);
}

// Lines 78-92: a negative verdict in report mode is still a healthy run.
test main_report_mode_ignores_verdict {
    assert(main(false, true, .UnknownInvCited) == 0);
    assert(main(false, true, .BelowMinCitations) == 0);
}

// Lines 78-92: an I/O-class failure is not swallowed by report mode.
test main_report_mode_keeps_io_failure {
    assert(main(false, true, .AssertionsLoadError) == 80);
    assert(main(false, true, .ChaptersDirError) == 81);
}

// Lines 94-104: strict mode rejects with the variant's code.
test main_strict_mode_rejects {
    assert(main(false, false, .UnknownInvCited) == 82);
    assert(main(false, false, .BelowMinCitations) == 83);
}

// Lines 94-104: a clean audit is exit 0.
test main_strict_mode_admits {
    assert(main(false, false, .Admitted) == 0);
}

// Lines 107-111: the full code table, including the four distinct rejection
// codes and the reserved namespace 80..=83.
test fail_exit_codes {
    assert(fail(.Admitted) == 0);
    assert(fail(.AssertionsLoadError) == 80);
    assert(fail(.ChaptersDirError) == 81);
    assert(fail(.UnknownInvCited) == 82);
    assert(fail(.BelowMinCitations) == 83);
}
