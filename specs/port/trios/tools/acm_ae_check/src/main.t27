module port::trios::tools::acm_ae_check;

// Port of gHashTag/trios tools/acm_ae_check/src/main.rs. The original is a
// clap CLI whose whole main() is a match over the parsed subcommand: Print
// and Anchors print and succeed; Run creates artifact/ and writes
// output.txt (an IO failure rejects with exit::IO before the witness even
// runs) and then admits on exit 0 or maps the AcmAeError kind to its
// exit code. The fingerprint itself and run_all live in lib.rs, not here;
// the decisions main actually owns -- the subcommand words, the --no-write
// flag, the IO gate and the error-to-code mapping -- are the helpers
// below, tested against the constants lib.rs pins.

// lib.rs's `exit` module, verbatim: admit 0, rejects 70..=74, disjoint
// from the L-h4 50..=53 and LT 60..=63 ranges.
const EXIT_ADMIT: i32 = 0;
const EXIT_FUNCTIONAL: i32 = 70;
const EXIT_REUSABLE: i32 = 71;
const EXIT_AVAILABLE: i32 = 72;
const EXIT_IO: i32 = 73;
const EXIT_MISMATCH: i32 = 74;

// clap's derive: three subcommands, Run carrying the --no-write long flag
// (default false).
enum Cmd {
    Print,
    Anchors,
    Run,
}

// lib.rs's AcmAeError, reduced to the five kinds main's Err arm matches on.
enum AcmAeError {
    Functional,
    Reusable,
    Available,
    Io,
    Mismatch,
}

// The clap subcommand words, matched exactly and case-sensitively. An
// unknown word is no command: the original's clap exits with usage before
// main's match ever runs.
fn is_print(arg: []const u8) -> bool {
    if (arg.len != 5) { return false; }
    if (arg[0] != 'p') { return false; }
    if (arg[1] != 'r') { return false; }
    if (arg[2] != 'i') { return false; }
    if (arg[3] != 'n') { return false; }
    if (arg[4] != 't') { return false; }
    return true;
}

fn is_anchors(arg: []const u8) -> bool {
    if (arg.len != 7) { return false; }
    if (arg[0] != 'a') { return false; }
    if (arg[1] != 'n') { return false; }
    if (arg[2] != 'c') { return false; }
    if (arg[3] != 'h') { return false; }
    if (arg[4] != 'o') { return false; }
    if (arg[5] != 'r') { return false; }
    if (arg[6] != 's') { return false; }
    return true;
}

fn is_run(arg: []const u8) -> bool {
    if (arg.len != 3) { return false; }
    if (arg[0] != 'r') { return false; }
    if (arg[1] != 'u') { return false; }
    if (arg[2] != 'n') { return false; }
    return true;
}

fn parse_cmd(arg: []const u8) -> ?Cmd {
    if (is_run(arg)) { return Cmd::Run; }
    if (is_print(arg)) { return Cmd::Print; }
    if (is_anchors(arg)) { return Cmd::Anchors; }
    return null;
}

// Run's --no-write long flag: exactly "--no-write", default false.
fn is_no_write(flag: []const u8) -> bool {
    if (flag.len != 10) { return false; }
    if (flag[0] != '-') { return false; }
    if (flag[1] != '-') { return false; }
    if (flag[2] != 'n') { return false; }
    if (flag[3] != 'o') { return false; }
    if (flag[4] != '-') { return false; }
    if (flag[5] != 'w') { return false; }
    if (flag[6] != 'r') { return false; }
    if (flag[7] != 'i') { return false; }
    if (flag[8] != 't') { return false; }
    if (flag[9] != 'e') { return false; }
    return true;
}

// The Err arm of Run's run_all match: each AcmAeError kind carries its own
// exit code, the one eprintln'd REJECT line is printed with.
fn error_exit_code(e: AcmAeError) -> i32 {
    if (e == AcmAeError::Functional) { return EXIT_FUNCTIONAL; }
    if (e == AcmAeError::Reusable) { return EXIT_REUSABLE; }
    if (e == AcmAeError::Available) { return EXIT_AVAILABLE; }
    if (e == AcmAeError::Io) { return EXIT_IO; }
    return EXIT_MISMATCH;
}

// Run's whole control flow with the filesystem lifted out: when the write
// is on, an unwritable artifact rejects with IO before the witness runs;
// otherwise the witness's verdict decides, null being ADMIT.
fn run_exit_code(no_write: bool, artifact_writable: bool, run_err: ?AcmAeError) -> i32 {
    if (no_write == false) {
        if (artifact_writable == false) {
            // create_dir_all / write failed: "REJECT: io error ..."
            return EXIT_IO;
        }
    }
    if (run_err == null) {
        return EXIT_ADMIT;
    }
    return error_exit_code(run_err.?);
}

// main itself: the match over the parsed command. Print and Anchors print
// and succeed without touching the filesystem or the witness; Run is
// run_exit_code above.
pub fn main(cmd: Cmd, no_write: bool, artifact_writable: bool, run_err: ?AcmAeError) -> i32 {
    if (cmd == Cmd::Print) {
        return EXIT_ADMIT;
    }
    if (cmd == Cmd::Anchors) {
        return EXIT_ADMIT;
    }
    return run_exit_code(no_write, artifact_writable, run_err);
}

test subcommand_words_parse_to_their_cmd {
    assert(parse_cmd("print").? == Cmd::Print);
    assert(parse_cmd("run").? == Cmd::Run);
    assert(parse_cmd("anchors").? == Cmd::Anchors);
}

test unknown_or_wrong_case_words_are_no_command {
    assert(parse_cmd("Run") == null);
    assert(parse_cmd("PRINT") == null);
    assert(parse_cmd("prints") == null);
    assert(parse_cmd("verify") == null);
    assert(parse_cmd("") == null);
    assert(parse_cmd("--no-write") == null);
}

test no_write_flag_is_exactly_the_long_flag {
    assert(is_no_write("--no-write") == true);
    assert(is_no_write("--write") == false);
    assert(is_no_write("") == false);
    assert(is_no_write("--no-write=1") == false);
    assert(is_no_write("-no-write") == false);
}

test each_reject_kind_carries_its_own_exit_code {
    assert(error_exit_code(AcmAeError::Functional) == 70);
    assert(error_exit_code(AcmAeError::Reusable) == 71);
    assert(error_exit_code(AcmAeError::Available) == 72);
    assert(error_exit_code(AcmAeError::Io) == 73);
    assert(error_exit_code(AcmAeError::Mismatch) == 74);
}

test print_and_anchors_succeed_without_the_witness {
    // neither subcommand creates artifact/, writes output.txt or runs
    // run_all, so no flag or error can move them off exit 0
    assert(main(Cmd::Print, false, false, null) == 0);
    assert(main(Cmd::Anchors, false, false, null) == 0);
}

test run_admits_only_when_the_witness_passes {
    assert(run_exit_code(false, true, null) == 0);
    // --no-write skips the artifact write entirely, so an unwritable tree
    // cannot reject an audit-only run
    assert(run_exit_code(true, false, null) == 0);
    // with the write on, the IO failure rejects before the witness runs
    assert(run_exit_code(false, false, null) == 73);
    assert(main(Cmd::Run, false, false, null) == 73);
}

test run_rejects_with_the_errors_own_code {
    assert(run_exit_code(true, true, AcmAeError::Functional) == 70);
    assert(run_exit_code(true, true, AcmAeError::Reusable) == 71);
    assert(run_exit_code(true, true, AcmAeError::Available) == 72);
    assert(run_exit_code(true, true, AcmAeError::Io) == 73);
    assert(run_exit_code(true, true, AcmAeError::Mismatch) == 74);
    assert(main(Cmd::Run, true, true, AcmAeError::Mismatch) == 74);
}
