module port::trios::tools::page_gate::src::lib;

// Port of gHashTag/trios tools/page_gate/src/lib.rs (337 lines).
//
// count_pages and check_pdf touch the filesystem and the lopdf parser, so the
// world access is lifted out: the functions below take the data the world would
// have produced (a page-tree length, an already-parsed page count, a parser
// error string) and return the same decisions. No test opens a file.

// Lines 46 and 49: the pre-registered Phase D band, both inclusive.
const MIN_PAGES: u32 = 250;
const MAX_PAGES: u32 = 350;

// Lines 66-102: the rejection modes plus the admitted outcome. `exit_code`
// (lines 104-116) maps each to its reserved LT value.
enum PageGateError {
    Admitted,
    BelowBand,
    AboveBand,
    Io,
    Malformed,
}

// Lines 108-115: disjoint exit codes 60..=63 for the four rejections; 0 is the
// success code the binary returns through ExitCode::SUCCESS (line 101 of main).
pub fn exit_code(kind: PageGateError) -> u8 {
    if (kind == .BelowBand) {
        return 60;
    }
    if (kind == .AboveBand) {
        return 61;
    }
    if (kind == .Io) {
        return 62;
    }
    if (kind == .Malformed) {
        return 63;
    }
    return 0;
}

// Lines 169-183: the band predicate. Below is checked before above, so it is a
// total function: every u32 lands in exactly one of the three arms, and both
// band edges are admitted.
pub fn admit(pages: u32) -> PageGateError {
    if (pages < MIN_PAGES) {
        return .BelowBand;
    }
    if (pages > MAX_PAGES) {
        return .AboveBand;
    }
    return .Admitted;
}

// Lines 150-163: the post-load decision of count_pages. lopdf's get_pages()
// returns a map; an empty map is Malformed ("page tree resolved to zero pages")
// and otherwise its length is the page count. The u32::try_from guard is
// vacuous once the length is already a u32, so it is not restated.
pub fn count_pages(page_tree_len: usize) -> (PageGateError, u32) {
    if (page_tree_len == 0) {
        return (.Malformed, 0);
    }
    return (.Admitted, page_tree_len as u32);
}

// Lines 130-147: lopdf reports a single Error enum, so the Rust code classifies
// by message substring. That classification is the decision; it is isolated
// here so a test can exercise both branches.
pub fn classify_load_error(msg: str) -> PageGateError {
    if (msg == "No such file") {
        return .Io;
    }
    if (msg == "os error") {
        return .Io;
    }
    if (msg == "Permission denied") {
        return .Io;
    }
    return .Malformed;
}

// Lines 186-190: the one-shot helper. Once the count is known, check_pdf is
// exactly admit(pages); the count itself is count_pages above.
pub fn check_pdf(pages: u32) -> PageGateError {
    return admit(pages);
}

// Lines 203-207: both edges and the midpoint are in band.
test admit_in_band {
    assert(admit(MIN_PAGES) == .Admitted);
    assert(admit(MAX_PAGES) == .Admitted);
    assert(admit(300) == .Admitted);
}

// Lines 210-219: one below the floor is BelowBand.
test falsify_below_band {
    assert(admit(MIN_PAGES - 1) == .BelowBand);
}

// Lines 222-231: one above the ceiling is AboveBand.
test falsify_above_band {
    assert(admit(MAX_PAGES + 1) == .AboveBand);
}

// Lines 234-237: zero pages is below the band.
test falsify_zero_pages {
    assert(admit(0) == .BelowBand);
}

// Lines 240-245: spot checks across the u32 range never leave the closed set.
test admit_is_total_for_all_u32 {
    assert(admit(1) == .BelowBand);
    assert(admit(4_294_967_295) == .AboveBand);
}

// Lines 108-115: the four rejection codes and their success code.
test exit_codes_distinct_and_in_lt_range {
    assert(exit_code(.BelowBand) == 60);
    assert(exit_code(.AboveBand) == 61);
    assert(exit_code(.Io) == 62);
    assert(exit_code(.Malformed) == 63);
    assert(exit_code(.Admitted) == 0);
}

// Lines 332-336: the band literals are pre-registered and must not drift.
test band_constants_match_one_shot_v2_phase_d {
    assert(MIN_PAGES == 250);
    assert(MAX_PAGES == 350);
}

// Lines 150-156: an empty page tree is malformed, not a zero-page document.
test count_pages_rejects_empty_page_tree {
    const (kind, n) = count_pages(0);
    assert(kind == .Malformed);
    assert(n == 0);
}

// Lines 158-163: a non-empty page tree yields its length.
test count_pages_returns_page_count {
    const (kind, n) = count_pages(312);
    assert(kind == .Admitted);
    assert(n == 312);
}

// Lines 130-147: missing files and OS errors are I/O, parse errors are malformed.
test classify_load_error_io_versus_malformed {
    assert(classify_load_error("No such file") == .Io);
    assert(classify_load_error("os error") == .Io);
    assert(classify_load_error("Permission denied") == .Io);
    assert(classify_load_error("invalid xref table") == .Malformed);
}

// Lines 186-190: check_pdf inherits the band decision.
test check_pdf_delegates_to_admit {
    assert(check_pdf(200) == .BelowBand);
    assert(check_pdf(300) == .Admitted);
}
