module port::trios::common::newton_sqrt;

// SPDX-License-Identifier: Apache-2.0
// The f32 Newton square root the trios-phi-schedule, trios-ternary and trios-trinity-init ports share.
//
// Each of the three crates opens with the same primitive under its own name (sched_sqrt,
// ternary_sqrt_newton, sqrt_newton32): x <- (x + v / x) / 2, forty rounds, quadratic convergence far
// beyond the f32 tolerance the callers test against. The duplicate-bodies gate listed them as one
// group; the ports now `use` this module and keep only the helpers built on the root.

/// Newton's iteration for the square root of v: forty rounds of x <- (x + v / x) / 2, seeded at v.
pub fn newton_sqrt(v: f32) -> f32 {
    var s: f32 = v;
    var i: usize = 0;
    while (i < 40) {
        s = (s + v / s) / 2.0;
        i += 1;
    }
    return s;
}

test newton_sqrt_answers {
    const r4 = newton_sqrt(4.0);
    assert(r4 > 1.9999 && r4 < 2.0001);
    const r2 = newton_sqrt(2.0);
    assert(r2 > 1.4141 && r2 < 1.4143);
    const r9 = newton_sqrt(9.0);
    assert(r9 > 2.9999 && r9 < 3.0001);
}
