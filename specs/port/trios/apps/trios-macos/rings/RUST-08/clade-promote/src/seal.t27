module port::trios::apps::trios-macos::rings::RUST-08::clade-promote::seal;

pub const EXIT_OK: i32 = 0;
pub const EXIT_FAIL: i32 = 1;

pub const SEAL_WRITE_SAVED: i32 = 0;
pub const SEAL_STATE_DIR_FAILED: i32 = 1;
pub const SEAL_SERIALIZE_FAILED: i32 = 2;
pub const SEAL_WRITE_FAILED: i32 = 3;

pub struct AuditFinding {
    file: []const u8,
    line: u32,
    message: []const u8,
    fingerprint: []const u8,
}

pub struct BuildCheckResult {
    passed: bool,
}

pub struct SecurityCheckResult {
    passed: bool,
    findings: []const AuditFinding,
}

pub struct AuditReport {
    build_check: BuildCheckResult,
    security_check: SecurityCheckResult,
    shell_safety_check: SecurityCheckResult,
    error_handling_check: SecurityCheckResult,
    concurrency_check: SecurityCheckResult,
    todo_check: SecurityCheckResult,
    unused_code_check: SecurityCheckResult,
    retain_cycle_check: SecurityCheckResult,
}

pub struct SealCell {
    name: []const u8,
    passed: bool,
    detail: []const u8,
}

pub struct SealArtifact {
    generated_at: []const u8,
    git_head: ?[]const u8,
    passed: bool,
    cells: []const SealCell,
}

pub struct SealRun {
    dry_run: bool,
    verbose: bool,
    write_artifact: bool,
    print_cells: bool,
    all_passed: bool,
    exit_code: i32,
}

pub struct AuditVerdict {
    passed: bool,
    failed_gates: usize,
    disallowed_todos: usize,
}

pub var ALLOWED_TODO_FINGERPRINTS: [0][]const u8 = [];

pub fn project_dir() -> []const u8 { undefined; }

pub fn main(args: []str, cells: []const SealCell) -> SealRun {
    const dry_run = has_flag(args, "--dry-run");
    const verbose = has_flag(args, "--verbose") or has_flag(args, "-v");
    const all_passed = all_cells_passed(cells);
    return SealRun {
        dry_run: dry_run,
        verbose: verbose,
        write_artifact: should_write_seal(dry_run),
        print_cells: should_print_cells(verbose, all_passed),
        all_passed: all_passed,
        exit_code: seal_exit_code(all_passed),
    };
}

pub fn run_audit_cell(verbose: bool) -> SealCell { undefined; }

pub fn run_cargo_cell(command: []const u8, name: []const u8, verbose: bool) -> SealCell { undefined; }

pub fn write_seal(seal: SealArtifact) { undefined; }

pub fn current_git_head() -> ?[]const u8 { undefined; }

pub fn has_flag(args: []str, flag: []const u8) -> bool {
    for a in args {
        if (a == flag) { return true; }
    }
    return false;
}

pub fn is_verbose(args: []str) -> bool {
    return has_flag(args, "--verbose") or has_flag(args, "-v");
}

pub fn all_cells_passed(cells: []const SealCell) -> bool {
    for c in cells {
        if (!c.passed) { return false; }
    }
    return true;
}

pub fn seal_exit_code(all_passed: bool) -> i32 {
    if (all_passed) { return EXIT_OK; }
    return EXIT_FAIL;
}

pub fn should_write_seal(dry_run: bool) -> bool {
    return !dry_run;
}

pub fn should_print_cells(verbose: bool, all_passed: bool) -> bool {
    return verbose or !all_passed;
}

pub fn audit_verdict(report: AuditReport) -> AuditVerdict {
    var failed: usize = 0;
    if (!report.build_check.passed) { failed += 1; }
    if (!report.security_check.passed) { failed += 1; }
    if (!report.shell_safety_check.passed) { failed += 1; }
    if (!report.error_handling_check.passed) { failed += 1; }
    if (!report.concurrency_check.passed) { failed += 1; }
    if (!report.unused_code_check.passed) { failed += 1; }
    if (!report.retain_cycle_check.passed) { failed += 1; }
    const todos = count_disallowed_todos(report.todo_check.findings, &ALLOWED_TODO_FINGERPRINTS);
    return AuditVerdict {
        passed: (failed == 0 and todos == 0),
        failed_gates: failed,
        disallowed_todos: todos,
    };
}

pub fn is_todo_allowed(fingerprint: []const u8, allowed: []str) -> bool {
    for a in allowed {
        if (a == fingerprint) { return true; }
    }
    return false;
}

pub fn count_disallowed_todos(findings: []const AuditFinding, allowed: []str) -> usize {
    var n: usize = 0;
    for f in findings {
        if (!is_todo_allowed(f.fingerprint, allowed)) { n += 1; }
    }
    return n;
}

pub fn command_has_program(command: []const u8) -> bool {
    for c in command {
        if (c != ' ' and c != '\t' and c != '\r' and c != '\n') { return true; }
    }
    return false;
}

pub fn cargo_cell_passed(spawn_ok: bool, exit_ok: bool) -> bool {
    return spawn_ok and exit_ok;
}

pub fn write_seal_status(create_dir_ok: bool, serialize_ok: bool, write_ok: bool) -> i32 {
    if (!create_dir_ok) { return SEAL_STATE_DIR_FAILED; }
    if (!serialize_ok) { return SEAL_SERIALIZE_FAILED; }
    if (!write_ok) { return SEAL_WRITE_FAILED; }
    return SEAL_WRITE_SAVED;
}

pub fn trim_ascii(s: []const u8) -> []const u8 {
    var start: usize = 0;
    var end: usize = s.len;
    while (start < end and is_ascii_ws(s[start])) { start += 1; }
    while (end > start and is_ascii_ws(s[end - 1])) { end -= 1; }
    return s[start..end];
}

fn is_ascii_ws(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r' or c == '\n';
}

pub fn git_head_from_output(spawn_ok: bool, exit_ok: bool, stdout: []const u8) -> ?[]const u8 {
    if (!spawn_ok or !exit_ok) { return null; }
    return trim_ascii(stdout);
}

test has_flag_matches_whole_flag_only {
    var args: [3][]const u8 = ["--dry-run", "--verbose", "extra"];
    assert(has_flag(&args, "--dry-run"));
    assert(has_flag(&args, "--verbose"));
    assert(!has_flag(&args, "-v"));
    assert(!has_flag(&args, "--dry"));
    assert(!has_flag(&args, ""));
}

test is_verbose_accepts_long_and_short {
    var long: [1][]const u8 = ["--verbose"];
    var short: [1][]const u8 = ["-v"];
    var neither: [2][]const u8 = ["--dry-run", "extra"];
    assert(is_verbose(&long));
    assert(is_verbose(&short));
    assert(!is_verbose(&neither));
}

test all_cells_passed_vacuous_and_strict {
    var none: [0]SealCell = [];
    var green: [2]SealCell = [SealCell { name: "Test", passed: true, detail: "12ms" }, SealCell { name: "Clippy", passed: true, detail: "30ms" }];
    var mixed: [2]SealCell = [SealCell { name: "Test", passed: true, detail: "12ms" }, SealCell { name: "Clippy", passed: false, detail: "30ms" }];
    assert(all_cells_passed(&none));
    assert(all_cells_passed(&green));
    assert(!all_cells_passed(&mixed));
}

test seal_exit_code_zero_only_on_full_pass {
    assert(seal_exit_code(true) == EXIT_OK);
    assert(seal_exit_code(false) == EXIT_FAIL);
}

test main_green_run_writes_quietly_and_exits_ok {
    var args: [0][]const u8 = [];
    var cells: [3]SealCell = [SealCell { name: "Audit", passed: true, detail: "5ms, all hard gates green, 0 allowed TODO" }, SealCell { name: "Test", passed: true, detail: "120ms" }, SealCell { name: "Clippy", passed: true, detail: "80ms" }];
    const run = main(&args, &cells);
    assert(!run.dry_run);
    assert(!run.verbose);
    assert(run.write_artifact);
    assert(!run.print_cells);
    assert(run.all_passed);
    assert(run.exit_code == EXIT_OK);
}

test main_failed_cell_prints_and_exits_fail {
    var args: [0][]const u8 = [];
    var cells: [3]SealCell = [SealCell { name: "Audit", passed: true, detail: "5ms, all hard gates green, 0 allowed TODO" }, SealCell { name: "Test", passed: false, detail: "9ms" }, SealCell { name: "Clippy", passed: true, detail: "80ms" }];
    const run = main(&args, &cells);
    assert(!run.all_passed);
    assert(run.print_cells);
    assert(run.exit_code == EXIT_FAIL);
}

test main_dry_run_skips_the_artifact_write {
    var args: [1][]const u8 = ["--dry-run"];
    var cells: [1]SealCell = [SealCell { name: "Audit", passed: true, detail: "5ms" }];
    const run = main(&args, &cells);
    assert(run.dry_run);
    assert(!run.write_artifact);
    assert(run.exit_code == EXIT_OK);
}

test main_verbose_lists_cells_even_when_green {
    var args: [1][]const u8 = ["-v"];
    var cells: [1]SealCell = [SealCell { name: "Audit", passed: true, detail: "5ms" }];
    const run = main(&args, &cells);
    assert(run.verbose);
    assert(run.print_cells);
}

test main_long_verbose_and_dry_run_together {
    var args: [2][]const u8 = ["--verbose", "--dry-run"];
    var cells: [1]SealCell = [SealCell { name: "Audit", passed: true, detail: "5ms" }];
    const run = main(&args, &cells);
    assert(run.verbose);
    assert(run.dry_run);
    assert(!run.write_artifact);
    assert(run.print_cells);
}

test audit_verdict_all_green_passes {
    var none: [0]AuditFinding = [];
    const report = AuditReport {
        build_check: BuildCheckResult { passed: true },
        security_check: SecurityCheckResult { passed: true, findings: &none },
        shell_safety_check: SecurityCheckResult { passed: true, findings: &none },
        error_handling_check: SecurityCheckResult { passed: true, findings: &none },
        concurrency_check: SecurityCheckResult { passed: true, findings: &none },
        todo_check: SecurityCheckResult { passed: true, findings: &none },
        unused_code_check: SecurityCheckResult { passed: true, findings: &none },
        retain_cycle_check: SecurityCheckResult { passed: true, findings: &none },
    };
    const v = audit_verdict(report);
    assert(v.passed);
    assert(v.failed_gates == 0);
    assert(v.disallowed_todos == 0);
}

test audit_verdict_counts_failed_gates {
    var none: [0]AuditFinding = [];
    const build_red = AuditReport {
        build_check: BuildCheckResult { passed: false },
        security_check: SecurityCheckResult { passed: true, findings: &none },
        shell_safety_check: SecurityCheckResult { passed: true, findings: &none },
        error_handling_check: SecurityCheckResult { passed: true, findings: &none },
        concurrency_check: SecurityCheckResult { passed: true, findings: &none },
        todo_check: SecurityCheckResult { passed: true, findings: &none },
        unused_code_check: SecurityCheckResult { passed: true, findings: &none },
        retain_cycle_check: SecurityCheckResult { passed: true, findings: &none },
    };
    const two_red = AuditReport {
        build_check: BuildCheckResult { passed: false },
        security_check: SecurityCheckResult { passed: true, findings: &none },
        shell_safety_check: SecurityCheckResult { passed: true, findings: &none },
        error_handling_check: SecurityCheckResult { passed: true, findings: &none },
        concurrency_check: SecurityCheckResult { passed: false, findings: &none },
        todo_check: SecurityCheckResult { passed: true, findings: &none },
        unused_code_check: SecurityCheckResult { passed: true, findings: &none },
        retain_cycle_check: SecurityCheckResult { passed: false, findings: &none },
    };
    const v1 = audit_verdict(build_red);
    assert(!v1.passed);
    assert(v1.failed_gates == 1);
    assert(v1.disallowed_todos == 0);
    const v2 = audit_verdict(two_red);
    assert(!v2.passed);
    assert(v2.failed_gates == 3);
}

test audit_verdict_rejects_disallowed_todos {
    var findings: [1]AuditFinding = [AuditFinding { file: "src/hud.rs", line: 42, message: "TODO: wire the menu", fingerprint: "fp-unowned" }];
    var none: [0]AuditFinding = [];
    const report = AuditReport {
        build_check: BuildCheckResult { passed: true },
        security_check: SecurityCheckResult { passed: true, findings: &none },
        shell_safety_check: SecurityCheckResult { passed: true, findings: &none },
        error_handling_check: SecurityCheckResult { passed: true, findings: &none },
        concurrency_check: SecurityCheckResult { passed: true, findings: &none },
        todo_check: SecurityCheckResult { passed: true, findings: &findings },
        unused_code_check: SecurityCheckResult { passed: true, findings: &none },
        retain_cycle_check: SecurityCheckResult { passed: true, findings: &none },
    };
    const v = audit_verdict(report);
    assert(!v.passed);
    assert(v.failed_gates == 0);
    assert(v.disallowed_todos == 1);
}

test todo_allow_list_filters_by_fingerprint {
    var allowed: [2][]const u8 = ["fp-tracked-dependency", "fp-reviewed-this-cycle"];
    var findings: [3]AuditFinding = [
        AuditFinding { file: "a.rs", line: 1, message: "m", fingerprint: "fp-tracked-dependency" },
        AuditFinding { file: "b.rs", line: 2, message: "m", fingerprint: "fp-unowned" },
        AuditFinding { file: "c.rs", line: 3, message: "m", fingerprint: "fp-reviewed-this-cycle" },
    ];
    var none: [0]AuditFinding = [];
    assert(is_todo_allowed("fp-tracked-dependency", &allowed));
    assert(!is_todo_allowed("fp-unowned", &allowed));
    assert(count_disallowed_todos(&findings, &allowed) == 1);
    assert(count_disallowed_todos(&none, &allowed) == 0);
}

test command_has_program_rejects_blank_commands {
    assert(command_has_program("cargo test --workspace"));
    assert(command_has_program("x"));
    assert(!command_has_program(""));
    assert(!command_has_program(" \t\n "));
}

test cargo_cell_passed_spawn_failure_fails_cell {
    assert(cargo_cell_passed(true, true));
    assert(!cargo_cell_passed(false, true));
    assert(!cargo_cell_passed(true, false));
    assert(!cargo_cell_passed(false, false));
}

test write_seal_status_follows_branch_order {
    assert(write_seal_status(true, true, true) == SEAL_WRITE_SAVED);
    assert(write_seal_status(false, true, true) == SEAL_STATE_DIR_FAILED);
    assert(write_seal_status(true, false, true) == SEAL_SERIALIZE_FAILED);
    assert(write_seal_status(true, true, false) == SEAL_WRITE_FAILED);
    assert(write_seal_status(false, false, false) == SEAL_STATE_DIR_FAILED);
}

test trim_ascii_strips_surrounding_whitespace {
    const head = trim_ascii("  8b229e9489ee\n");
    assert(head == "8b229e9489ee");
    assert(trim_ascii("abc") == "abc");
    const blank = trim_ascii(" \n\t ");
    assert(blank == "");
}

test git_head_from_output_keeps_success_only {
    const head = git_head_from_output(true, true, "  8b229e9489ee\n");
    assert(head != null);
    assert(head.? == "8b229e9489ee");
    assert(git_head_from_output(false, true, "8b229e9489ee") == null);
    assert(git_head_from_output(true, false, "8b229e9489ee") == null);
}
