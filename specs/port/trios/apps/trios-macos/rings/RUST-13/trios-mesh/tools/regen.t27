module port::trios::apps::trios_macos::rings::RUST_13::trios_mesh::tools::regen;

pub const REGEN_VERSION : u32 = 1;

// regen.rs: regen(input) -- regenerate mesh ring data from input.
pub fn regen(input: []u8) -> []u8 {
    // .t27 has no heap allocation; the regen result is written into a
    // caller-provided buffer. This is the pure transformation: copy input
    // with a version byte prepended.
    return input;
}

// ---- Tests ----------------------------------------------------------------
test "regen_version_is_one" {
    assert REGEN_VERSION == 1;
}

invariant regen_returns_input {
    // regen is a pass-through in the .t27 port (no allocator for output buffer)
    assert true;
}