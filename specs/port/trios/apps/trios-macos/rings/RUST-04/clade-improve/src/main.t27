// Port of gHashTag/trios:apps/trios-macos/rings/RUST-04/clade-improve/src/main.rs
// (319 lines) to .t27, roadmap stage 6 (t27c gen-rust; issue #9579).
//
// The file is the CLI entry point of the self-improvement pipeline. Its
// decisions are:
//   - `parse_command` (lines 38-49): no args -> Help; the four known verbs map
//     to their commands; anything else is Unknown. `improve` takes an optional
//     second argument as the description.
//   - `main` (lines 51-63): the same dispatch, one arm per command.
//   - `run_improve` (lines 65-198): the seven phases in a fixed order. The
//     production variant is refused before anything runs (75-81); a Reject at
//     the pre-check stops (102-107); a sandbox failure stops (113-124); any
//     failing test stops (136-142); a final Reject stops (149-156); ShadowMode
//     approves but does NOT deploy (157-160, 168); only Approve reaches
//     `atomic_deploy` (168-185).
//   - `check_status` (lines 200-212): reports the variant, its port, whether
//     self-modification is allowed, and the 9-principle constitution.
//   - `emergency_rollback` (lines 214-241): a missing rollback dir, an
//     unreadable dir, and zero `v_`-prefixed versions are the three early
//     exits; otherwise the latest is rolled back.
//   - `show_constitution` (lines 243-256): each principle is marked
//     `[ENFORCED]` or `[ advisory ]` from its `enforced` flag.
//
// File/process/env/clock plumbing (env::args, println!, std::process::exit,
// fs::read_dir, chrono) stays outside the port: every function takes the facts
// the original would read and returns the decision it would take.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trios::apps::trios_macos::rings::RUST_04::clade_improve::src::main;

// Lines 29-36.
pub enum CliCommand {
    Help,
    Improve,
    Check,
    Rollback,
    Constitution,
    Unknown,
}

// The three variants named in HELP (lines 20-22): prod=9105, staging=9205,
// dev=9305.
pub enum Variant {
    Prod,
    Staging,
    Dev,
}

// The constitution's three verdicts (lines 102-109, 149-164).
pub enum Decision {
    Reject,
    ShadowMode,
    Approve,
}

pub struct ParsedCommand {
    kind: CliCommand,
    has_description: bool,
    description: str,
}

// Lines 38-49: empty args are Help; `args.get(1).cloned()` is the optional
// description of `improve`; every other verb is a unit command; an unrecognised
// verb is Unknown.
pub fn parse_command(argc: usize, first: str, second: str) -> ParsedCommand {
    if (argc == 0) {
        return ParsedCommand { kind: .Help, has_description: false, description: "" };
    }
    if (first == "improve") {
        return ParsedCommand { kind: .Improve, has_description: argc > 1, description: second };
    }
    if (first == "check") {
        return ParsedCommand { kind: .Check, has_description: false, description: "" };
    }
    if (first == "rollback") {
        return ParsedCommand { kind: .Rollback, has_description: false, description: "" };
    }
    if (first == "constitution") {
        return ParsedCommand { kind: .Constitution, has_description: false, description: "" };
    }
    return ParsedCommand { kind: .Unknown, has_description: false, description: "" };
}

// Lines 51-63: `main` dispatches the parsed command. The variant is read from
// the environment and handed to the selected arm; the arm names are the
// decision this function carries.
pub fn main(argc: usize, first: str, second: str) -> str {
    const cmd = parse_command(argc, first, second);
    if (cmd.kind == .Help) {
        return "help";
    }
    if (cmd.kind == .Improve) {
        return "improve";
    }
    if (cmd.kind == .Check) {
        return "check";
    }
    if (cmd.kind == .Rollback) {
        return "rollback";
    }
    if (cmd.kind == .Constitution) {
        return "constitution";
    }
    return "unknown";
}

pub struct ImproveOutcome {
    verdict: str,
    rationale: str,
}

// Lines 65-198: the phase order. Production is refused first, whatever the
// other facts say (lines 75-81). Then the pre-check (102-107), the sandbox
// (113-124), the tests (136-142), the final decision (149-164) and finally the
// deploy, which only an Approve reaches (168-185). ShadowMode stops before
// deploy. The change's rationale defaults to "self-improvement" (line 88).
pub fn run_improve(description_present: bool, description: str, variant: Variant, precheck: Decision, sandbox_ok: bool, all_tests_passed: bool, final_decision: Decision, deploy_ok: bool) -> ImproveOutcome {
    const rationale: str = if (description_present) description else "self-improvement";
    if (variant == .Prod) {
        return ImproveOutcome { verdict: "refused_production", rationale: rationale };
    }
    if (precheck == .Reject) {
        return ImproveOutcome { verdict: "rejected_precheck", rationale: rationale };
    }
    if (!sandbox_ok) {
        return ImproveOutcome { verdict: "sandbox_failed", rationale: rationale };
    }
    if (!all_tests_passed) {
        return ImproveOutcome { verdict: "tests_failed", rationale: rationale };
    }
    if (final_decision == .Reject) {
        return ImproveOutcome { verdict: "rejected_final", rationale: rationale };
    }
    if (final_decision == .ShadowMode) {
        return ImproveOutcome { verdict: "shadow_mode", rationale: rationale };
    }
    if (!deploy_ok) {
        return ImproveOutcome { verdict: "deploy_failed", rationale: rationale };
    }
    return ImproveOutcome { verdict: "complete", rationale: rationale };
}

pub struct StatusReport {
    is_production: bool,
    can_self_modify: bool,
    principles: usize,
}

// Lines 200-212: the check command reports the variant, whether it is
// production, whether self-modification is allowed, and the 9 safety
// principles. Production cannot self-modify (P8, line 209).
pub fn check_status(variant: Variant) -> StatusReport {
    const is_prod: bool = variant == .Prod;
    return StatusReport { is_production: is_prod, can_self_modify: !is_prod, principles: 9 };
}

// Lines 225-231: only entries whose name starts with `v_` are rollback
// versions; everything else in the directory is ignored.
pub fn is_rollback_version(name: str) -> bool {
    if (name.len < 2) {
        return false;
    }
    return name[0] == 'v' && name[1] == '_';
}

// Lines 214-241: the directory is created if missing (its disappearance is
// then a failure), an unreadable directory is a failure, and an empty
// `v_`-filtered list is a failure; only then is the latest version restored.
pub fn emergency_rollback(dir_exists: bool, read_ok: bool, version_count: usize) -> str {
    if (!dir_exists) {
        return "no_dir";
    }
    if (!read_ok) {
        return "read_failed";
    }
    if (version_count == 0) {
        return "no_versions";
    }
    return "rolled_back";
}

pub struct ConstitutionView {
    principle_count: usize,
    marker: str,
}

// Lines 243-256: the version and each principle are printed; the one decision
// is the enforced marker, `[ENFORCED]` when `p.enforced`, `[ advisory ]`
// otherwise.
pub fn show_constitution(principle_count: usize, enforced: bool) -> ConstitutionView {
    const marker: str = if (enforced) "[ENFORCED]" else "[ advisory ]";
    return ConstitutionView { principle_count: principle_count, marker: marker };
}

// ---------------------------------------------------------------------------
// Tests: each asserts a behaviour read in the original (lines refer to
// apps/trios-macos/rings/RUST-04/clade-improve/src/main.rs).
// ---------------------------------------------------------------------------

test parse_empty_args_is_help {
    // Lines 39-41 and the original's parse_empty_args_is_help.
    assert(parse_command(0, "", "").kind == .Help);
}

test parse_improve_without_description {
    // Lines 42-43 / parse_improve_without_description.
    const c = parse_command(1, "improve", "");
    assert(c.kind == .Improve);
    assert(!c.has_description);
}

test parse_improve_with_description {
    // Line 43 / parse_improve_with_description.
    const c = parse_command(2, "improve", "optimize latency");
    assert(c.kind == .Improve);
    assert(c.has_description);
    assert(c.description == "optimize latency");
}

test parse_unit_verbs_and_unknown {
    // Lines 44-47 / parse_check, parse_rollback, parse_constitution,
    // parse_unknown_command.
    assert(parse_command(1, "check", "").kind == .Check);
    assert(parse_command(1, "rollback", "").kind == .Rollback);
    assert(parse_command(1, "constitution", "").kind == .Constitution);
    assert(parse_command(1, "foobar", "").kind == .Unknown);
}

test main_dispatches_each_command {
    // Lines 55-62.
    assert(main(0, "", "") == "help");
    assert(main(1, "improve", "") == "improve");
    assert(main(1, "check", "") == "check");
    assert(main(1, "rollback", "") == "rollback");
    assert(main(1, "constitution", "") == "constitution");
    assert(main(1, "foobar", "") == "unknown");
    // The description argument does not change the dispatch.
    assert(main(2, "improve", "x") == "improve");
}

test run_improve_refuses_production_first {
    // Lines 75-81: production is refused before the pre-check is even read.
    const out = run_improve(false, "", .Prod, .Approve, true, true, .Approve, true);
    assert(out.verdict == "refused_production");
    assert(out.rationale == "self-improvement");
    // Rationale is the description when one was given (line 88).
    const with_desc = run_improve(true, "optimize latency", .Staging, .Approve, true, true, .Approve, true);
    assert(with_desc.verdict == "complete");
    assert(with_desc.rationale == "optimize latency");
}

test run_improve_precheck_and_sandbox {
    // Lines 102-124: Reject at the pre-check stops; a sandbox failure stops.
    const rejected = run_improve(false, "", .Staging, .Reject, true, true, .Approve, true);
    assert(rejected.verdict == "rejected_precheck");
    const no_sandbox = run_improve(false, "", .Staging, .Approve, false, true, .Approve, true);
    assert(no_sandbox.verdict == "sandbox_failed");
    // The sandbox failure is only reached after the pre-check passes.
    const both = run_improve(false, "", .Staging, .Reject, false, true, .Approve, true);
    assert(both.verdict == "rejected_precheck");
}

test run_improve_tests_and_final_decisions {
    // Lines 136-164.
    const failed = run_improve(false, "", .Dev, .Approve, true, false, .Approve, true);
    assert(failed.verdict == "tests_failed");
    const rejected = run_improve(false, "", .Dev, .Approve, true, true, .Reject, true);
    assert(rejected.verdict == "rejected_final");
    const shadow = run_improve(false, "", .Dev, .Approve, true, true, .ShadowMode, true);
    assert(shadow.verdict == "shadow_mode");
    // ShadowMode never deploys, so a failing deploy cannot be observed.
    const shadow_after_deploy = run_improve(false, "", .Dev, .Approve, true, true, .ShadowMode, false);
    assert(shadow_after_deploy.verdict == "shadow_mode");
}

test run_improve_approve_deploys {
    // Lines 168-185 and 195-197: only Approve reaches atomic_deploy.
    const ok = run_improve(false, "", .Dev, .Approve, true, true, .Approve, true);
    assert(ok.verdict == "complete");
    const failed = run_improve(false, "", .Dev, .Approve, true, true, .Approve, false);
    assert(failed.verdict == "deploy_failed");
}

test check_status_per_variant {
    // Lines 200-212: prod is production and cannot self-modify; staging and
    // dev are not production and can. The constitution has 9 principles.
    const prod = check_status(.Prod);
    assert(prod.is_production);
    assert(!prod.can_self_modify);
    assert(prod.principles == 9);
    const staging = check_status(.Staging);
    assert(!staging.is_production);
    assert(staging.can_self_modify);
    const dev = check_status(.Dev);
    assert(!dev.is_production);
    assert(dev.can_self_modify);
}

test emergency_rollback_order_and_filter {
    // Lines 220-236: the three early exits, in order.
    assert(emergency_rollback(false, false, 0) == "no_dir");
    assert(emergency_rollback(true, false, 0) == "read_failed");
    assert(emergency_rollback(true, true, 0) == "no_versions");
    assert(emergency_rollback(true, true, 3) == "rolled_back");
    // Line 230: only names starting with `v_` count.
    assert(is_rollback_version("v_0001"));
    assert(is_rollback_version("v_"));
    assert(!is_rollback_version("latest"));
    assert(!is_rollback_version("x_0001"));
    assert(!is_rollback_version("v"));
    assert(!is_rollback_version(""));
}

test show_constitution_marker {
    // Lines 249-254: enforced principles get the ENFORCED marker, the rest the
    // advisory marker.
    const enforced = show_constitution(9, true);
    assert(enforced.marker == "[ENFORCED]");
    assert(enforced.principle_count == 9);
    const advisory = show_constitution(9, false);
    assert(advisory.marker == "[ advisory ]");
}
