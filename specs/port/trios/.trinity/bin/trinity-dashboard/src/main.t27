// Port of gHashTag/trios .trinity/bin/trinity-dashboard/src/main.rs (222 lines)
// to .t27, roadmap stage 6. Issue #9240.
//
// The original is a LEAD dashboard: it walks a 26-codename roster, polls each
// node's but-server over the tailnet, merges GitHub notifications and prints a
// board every 5 minutes. Everything that decides is ported here as a pure
// function a test can call; everything that touches the world keeps the name
// the issue lists and carries an `undefined;` body.
//
// Path note: the source directory is named `.trinity` (a leading dot is not a
// valid .t27 identifier), so the module segment is written `_trinity`.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trios::_trinity::bin::trinity_dashboard::src::main;

// main.rs lines 19-25: the roster. Nine + nine + eight lowercase Coptic names,
// 26 in total; the comment says omega is LEAD itself and is not in the list.
const CODENAME_COUNT: u32 = 26;

// main.rs line 198: the printed summary says `total=26 (÷ OMEGA self)` even
// though the doc comment calls the grid "27-Coptic". The grid is 26 names plus
// the one LEAD node polled separately.
const GRID_TOTAL: u32 = 27;

// main.rs line 97: every poll is bounded by a 3 second timeout.
const POLL_TIMEOUT_SECS: u32 = 3;

// main.rs lines 43-45: the default interval is 300 s (5 min).
const DEFAULT_INTERVAL_SECS: u64 = 300;

// main.rs lines 39-41: the default EPIC is #446.
const DEFAULT_EPIC: u32 = 446;

// main.rs line 176: at most 15 notifications are printed.
const NOTIFICATION_CAP: u32 = 15;

// main.rs line 151: a commit title is cut at 48 characters.
const COMMIT_TITLE_CHARS: u32 = 48;

// main.rs line 181: a notification title is cut at 70 characters.
const NOTE_TITLE_CHARS: u32 = 70;

// main.rs lines 150 and 162: a sha / branch head shows its first 7 bytes.
const SHORT_SHA_CHARS: u32 = 7;

// main.rs lines 122-133: exactly three println! calls -- separator, title,
// separator.
const HEADER_LINES: u32 = 3;

// What print_node_state decides, without the stdout write. `upper` is the
// `codename.to_uppercase()` of line 137, `sha_len`/`title_len`/`head_len` are
// the `[..7.min(len)]` and `.chars().take(48)` cuts, and
// `trailer_placeholder` is the `unwrap_or("?")` of line 147.
struct NodePlan {
    upper: bool,
    vbranches: u32,
    wip_files: u32,
    has_commit: bool,
    sha_len: u32,
    title_len: u32,
    trailer_placeholder: bool,
    branch_lines: u32,
    head_len: u32,
}

// The one node state the dashboard needs from `GET /api/state` (main.rs lines
// 52-76). The Vec<AppliedBranch> is reduced to its length and the optional
// commit to the four facts the printer reads.
struct NodeState {
    applied_branches: u32,
    wip_files: u32,
    has_commit: bool,
    sha_len: u32,
    title_len: u32,
    has_trailer: bool,
}

// What print_header decides: three lines, two of them separators, the title
// carrying epic and repo (main.rs lines 122-133).
struct HeaderPlan {
    lines: u32,
    separators: u32,
    epic: u32,
    repo_len: u32,
}

// What print_notifications decides (main.rs lines 169-184): when the list is
// empty it prints the placeholder and returns; otherwise the first 15 rows,
// each title cut at 70 characters.
struct NotePlan {
    shown: u32,
    empty_placeholder: bool,
    title_len: u32,
}

pub fn min_u32(a: u32, b: u32) -> u32 {
    if (a < b) {
        return a;
    }
    return b;
}

// main.rs lines 97-100: `Ok(resp) => Ok(Some(..))` and both error arms
// (Status, Transport) map to `Ok(None)`. A poll that succeeds is an online
// node; a poll that fails for any reason is an offline node -- never an error
// that aborts the sweep.
pub fn node_online(poll_succeeded: bool) -> bool {
    return poll_succeeded;
}

// main.rs line 97: the 3 second timeout is attached to every request, so no
// single dead node can hold the whole board for longer than that.
pub fn node_poll_timeout_secs() -> u32 {
    return POLL_TIMEOUT_SECS;
}

// main.rs lines 116-118: the notifications list keeps a row only when
// `n.repository.full_name == repo`. The comparison is exact and
// case-sensitive.
pub fn notification_matches_repo(full_name: str, repo: str) -> bool {
    return full_name == repo;
}

// main.rs line 114: `serde_json::from_slice(&out.stdout).unwrap_or_default()`
// -- an unparseable `gh` payload becomes the empty list, not an error.
pub fn notifications_on_parse_failure() -> u32 {
    return 0;
}

// main.rs line 176: `notes.iter().take(15)`.
pub fn notifications_shown(total: u32) -> u32 {
    return min_u32(total, NOTIFICATION_CAP);
}

// main.rs lines 169-175: an empty notification list prints one placeholder
// line and returns before the loop.
pub fn notifications_empty_placeholder(total: u32) -> bool {
    return total == 0;
}

// main.rs line 151: `c.title.chars().take(48)`.
pub fn commit_title_len(len: u32) -> u32 {
    return min_u32(len, COMMIT_TITLE_CHARS);
}

// main.rs line 181: `n.subject.title.chars().take(70)`.
pub fn notification_title_len(len: u32) -> u32 {
    return min_u32(len, NOTE_TITLE_CHARS);
}

// main.rs lines 150, 162: `&c.sha[..7.min(c.sha.len())]` -- a short sha is
// shown whole, a long one is cut at seven bytes.
pub fn short_sha_len(len: u32) -> u32 {
    return min_u32(len, SHORT_SHA_CHARS);
}

// main.rs line 147: `c.trailer_agent.as_deref().unwrap_or("?")` -- a commit
// without an Agent trailer still prints, with `?` in that column.
pub fn trailer_placeholder(has_trailer: bool) -> bool {
    return !has_trailer;
}

// main.rs lines 193-198: the sweep counts one node per codename and prints
// online + offline == 26. A caller that hands in more online nodes than the
// roster has cannot make offline wrap around.
pub fn offline_count(online: u32) -> u32 {
    if (online >= CODENAME_COUNT) {
        return 0;
    }
    return CODENAME_COUNT - online;
}

// main.rs line 198: total=26, omega excluded.
pub fn roster_total() -> u32 {
    return CODENAME_COUNT;
}

// main.rs line 190: the doc comment calls the grid 27-Coptic; 26 names plus
// the LEAD node.
pub fn grid_total() -> u32 {
    return GRID_TOTAL;
}

// main.rs lines 211-215: `if cli.once { return run_one(&cli); }` -- one cycle
// and exit.
pub fn cycles_when_once() -> u32 {
    return 1;
}

// main.rs lines 216-221: without `--once` the loop never ends; a failed cycle
// is printed to stderr and the next cycle still runs.
pub fn runs_forever(once: bool) -> bool {
    return !once;
}

// main.rs lines 122-133: the header is separator, title, separator.
pub fn print_header(epic: u32, repo: str) -> HeaderPlan {
    return HeaderPlan {
        lines: HEADER_LINES,
        separators: 2,
        epic: epic,
        repo_len: repo.len as u32,
    };
}

// main.rs lines 136-167: the per-node block. Printing is plumbing; the shape
// is decided here -- uppercase name, vbranches/wip counts, then the optional
// commit line and one line per applied branch.
pub fn print_node_state(state: NodeState) -> NodePlan {
    return NodePlan {
        upper: true,
        vbranches: state.applied_branches,
        wip_files: state.wip_files,
        has_commit: state.has_commit,
        sha_len: short_sha_len(state.sha_len),
        title_len: commit_title_len(state.title_len),
        trailer_placeholder: trailer_placeholder(state.has_trailer),
        branch_lines: state.applied_branches,
        head_len: SHORT_SHA_CHARS,
    };
}

// main.rs lines 169-184: empty list -> placeholder and return; otherwise the
// first 15 rows with 70-character titles.
pub fn print_notifications(total: u32) -> NotePlan {
    return NotePlan {
        shown: notifications_shown(total),
        empty_placeholder: notifications_empty_placeholder(total),
        title_len: NOTE_TITLE_CHARS,
    };
}

// main.rs lines 95-101: the function itself. Building the URL, calling ureq
// with the timeout and deserializing the body are the network side of the
// boundary -- no pure .t27 function can reach them and no test calls this.
// The decision it makes is node_online().
pub fn poll_node(tailnet: str, codename: str) -> bool {
    undefined;
}

// main.rs lines 103-119: the function itself. Spawning `gh`, reading its
// stdout/stderr and the JSON decode are the subprocess side of the boundary.
// The decisions are notification_matches_repo() and
// notifications_on_parse_failure(); the count it returns feeds
// notifications_shown().
pub fn poll_notifications(repo: str) -> u32 {
    undefined;
}

// main.rs lines 186-209: one full cycle -- clock read, 26 HTTP polls and all
// stdout writes. Plumbing; every decision inside is one of the pure functions
// above.
pub fn run_one(epic: u32, repo: str, interval_secs: u64) -> u8 {
    undefined;
}

// main.rs lines 211-222: argument parsing, the sleep between cycles and the
// process exit. Plumbing; the loop/once decision is cycles_when_once() and
// runs_forever().
pub fn main(once: bool, interval_secs: u64) -> u8 {
    undefined;
}

test node_is_online_only_when_the_poll_succeeds {
    assert(node_online(true));
    assert(!node_online(false));
    assert(node_poll_timeout_secs() == 3);
}

test notifications_are_filtered_by_exact_repo_name {
    assert(notification_matches_repo("gHashTag/trios", "gHashTag/trios"));
    assert(!notification_matches_repo("gHashTag/trios-other", "gHashTag/trios"));
    assert(!notification_matches_repo("ghashtag/trios", "gHashTag/trios"));
    assert(notifications_on_parse_failure() == 0);
}

test header_is_separator_title_separator {
    const h = print_header(446, "gHashTag/trios");
    assert(h.lines == 3);
    assert(h.separators == 2);
    assert(h.epic == 446);
    assert(h.repo_len == 14);
}

test node_block_uppercases_and_truncates {
    const s = NodeState {
        applied_branches: 2,
        wip_files: 5,
        has_commit: true,
        sha_len: 40,
        title_len: 60,
        has_trailer: false,
    };
    const p = print_node_state(s);
    assert(p.upper);
    assert(p.vbranches == 2);
    assert(p.wip_files == 5);
    assert(p.has_commit);
    assert(p.sha_len == 7);
    assert(p.title_len == 48);
    assert(p.trailer_placeholder);
    assert(p.branch_lines == 2);
    assert(p.head_len == 7);
}

test short_sha_shows_a_short_sha_whole {
    assert(short_sha_len(4) == 4);
    assert(short_sha_len(7) == 7);
    assert(short_sha_len(0) == 0);
    assert(!trailer_placeholder(true));
    assert(trailer_placeholder(false));
}

test notifications_cap_at_fifteen_and_keep_an_empty_placeholder {
    assert(notifications_shown(0) == 0);
    assert(notifications_shown(15) == 15);
    assert(notifications_shown(16) == 15);
    assert(notifications_shown(200) == 15);
    const empty = print_notifications(0);
    assert(empty.shown == 0);
    assert(empty.empty_placeholder);
    const busy = print_notifications(40);
    assert(busy.shown == 15);
    assert(!busy.empty_placeholder);
    assert(busy.title_len == 70);
    assert(commit_title_len(60) == 48);
    assert(notification_title_len(10) == 10);
}

test summary_counts_add_up_over_the_26_name_roster {
    assert(roster_total() == 26);
    assert(grid_total() == 27);
    assert(offline_count(0) == 26);
    assert(offline_count(20) == 6);
    assert(offline_count(26) == 0);
    assert(offline_count(30) == 0);
    assert(offline_count(3) + 3 == roster_total());
}

test once_runs_one_cycle_and_the_default_loop_never_ends {
    assert(cycles_when_once() == 1);
    assert(!runs_forever(true));
    assert(runs_forever(false));
    assert(DEFAULT_INTERVAL_SECS == 300);
    assert(DEFAULT_EPIC == 446);
}
