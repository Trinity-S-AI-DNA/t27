// Port of gHashTag/trios crates/trios-bridge/src/github.rs
// (189 lines at 8b229e9489ee) to .t27.
//
// Split of concerns, per the port brief: every decision in the original
// is a pure .t27 function here and is covered by tests. The one thing
// that touches the world, the octocrab HTTP fetch inside
// get_issue_comments, is plumbing: that function keeps its name with an
// `undefined;` body that no test calls, and its three decisions live in
// the tested helpers below (builder choice, owner/repo split, body
// default).
//
// Mechanical deviations:
// - Option<String> token stays optional: ?[]const u8.
// - Result<Vec<IssueComment>> from the fetch becomes a caller-provided
//   output slice plus a returned count (no Result, no growable lists).
// - Vec<BridgeMessage> becomes a caller-provided output slice plus count.
// - BridgeMessage (a Rust enum with payloads in crate::protocol) becomes
//   a kind tag plus flat fields: SendCommand reads target/command/ack,
//   UpdateStatus reads target (the agent id)/status/message.
// - Rust's str::trim and split_whitespace trim Unicode whitespace; the
//   helpers here trim the ASCII set (' ', '\t', '\r', '\n') only.

module port::trios_bridge_github;

// crate::protocol::AgentStatus, as parsed from [STATUS: ...] markers
// (github.rs lines 89-96; unknown words fall back to Idle).
enum AgentStatus { Idle, Claiming, Working, Blocked, Done, }

// Which variant a BridgeMessage carries.
enum BridgeMessageKind { SendCommand, UpdateStatus, }

// crate::protocol::BridgeMessage as a tagged record.
struct BridgeMessage {
    kind: BridgeMessageKind,
    // SendCommand target, or the agent id of an UpdateStatus.
    target: []const u8,
    // SendCommand command text; empty for UpdateStatus.
    command: []const u8,
    // SendCommand ack flag; the original always passes false.
    ack: bool,
    // UpdateStatus status; Idle for SendCommand.
    status: AgentStatus,
    // UpdateStatus note; empty when the marker carries none.
    message: []const u8,
}

// github.rs lines 112-119.
struct IssueComment {
    id: u64,
    issue_number: u64,
    author: []const u8,
    body: []const u8,
}

// github.rs lines 7-10.
struct GitHubClient {
    repo: []const u8,
    token: ?[]const u8,
}

// ---- GitHubClient::new (line 15) ----------------------------------------

pub fn GitHubClient_new(repo: []const u8, token: ?[]const u8) -> GitHubClient {
    return GitHubClient { repo: repo, token: token };
}

// ---- get_issue_comments (lines 23-55) ------------------------------------

// The fetch itself is plumbing: building the octocrab client (personal
// token when one is present, anonymous otherwise), splitting self.repo
// into owner and name, the HTTP request and pagination. The function
// keeps its name with an undefined body that no test calls; the caller
// passes the output buffer and reads the count.
pub fn GitHubClient_get_issue_comments(client: GitHubClient, issue_number: u64, out: []IssueComment) -> usize {
    undefined;
}

// Lines 24-29: a personal token present in the client decides for the
// personal-token octocrab builder; the anonymous builder otherwise.
pub fn GitHubClient_uses_personal_token(token: ?[]const u8) -> bool {
    if (token == null) {
        return false;
    }
    return true;
}

// Lines 31-33: split self.repo into (owner, name), falling back to
// ("gHashTag", "trios") when there is no '/'.
struct RepoRef {
    owner: []const u8,
    name: []const u8,
}

pub fn GitHubClient_split_repo(repo: []const u8) -> RepoRef {
    var i: usize = 0;
    while (i < repo.len) {
        if (repo[i] == '/') {
            const after: usize = i + 1;
            const owner_part: []const u8 = repo[0..i];
            const name_part: []const u8 = repo[after..repo.len];
            return RepoRef { owner: owner_part, name: name_part };
        }
        i += 1;
    }
    return RepoRef { owner: "gHashTag", name: "trios" };
}

// Line 52: c.body.unwrap_or_default() when mapping octocrab comments
// into IssueComment values.
pub fn issue_comment_body_or_default(raw_body: ?[]const u8) -> []const u8 {
    if (raw_body == null) {
        return "";
    }
    return raw_body.?;
}

// ---- shared helpers for parse_agent_commands ------------------------------

fn is_ws(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r' or c == '\n';
}

fn starts_with(s: []const u8, prefix: []const u8) -> bool {
    if (prefix.len > s.len) {
        return false;
    }
    var i: usize = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Index of c at or after `from`, or s.len when there is none.
fn find_char_from(s: []const u8, c: u8, from: usize) -> usize {
    var i: usize = from;
    while (i < s.len) {
        if (s[i] == c) {
            return i;
        }
        i += 1;
    }
    return s.len;
}

// Bounds of s.trim() over ASCII whitespace.
struct Bounds {
    lo: usize,
    hi: usize,
}

fn trim_bounds(s: []const u8) -> Bounds {
    var lo: usize = 0;
    var hi: usize = s.len;
    while (lo < hi and is_ws(s[lo])) {
        lo += 1;
    }
    while (hi > lo and is_ws(s[hi - 1])) {
        hi -= 1;
    }
    return Bounds { lo: lo, hi: hi };
}

// Bounds of the index-th whitespace-separated word of s, counted the way
// split_whitespace counts words; found: false when there is none.
struct WordSpan {
    found: bool,
    wstart: usize,
    wend: usize,
}

fn find_word(s: []const u8, index: usize) -> WordSpan {
    var i: usize = 0;
    var k: usize = 0;
    while (i < s.len) {
        while (i < s.len and is_ws(s[i])) {
            i += 1;
        }
        if (i >= s.len) {
            break;
        }
        const wstart: usize = i;
        while (i < s.len and !is_ws(s[i])) {
            i += 1;
        }
        if (k == index) {
            const wend: usize = i;
            return WordSpan { found: true, wstart: wstart, wend: wend };
        }
        k += 1;
    }
    return WordSpan { found: false, wstart: 0, wend: 0 };
}

// Lines 89-96: the status word decides the AgentStatus; unknown -> Idle.
fn parse_agent_status(word: []const u8) -> AgentStatus {
    if (word == "IDLE") {
        return .Idle;
    }
    if (word == "CLAIMING") {
        return .Claiming;
    }
    if (word == "WORKING") {
        return .Working;
    }
    if (word == "BLOCKED") {
        return .Blocked;
    }
    if (word == "DONE") {
        return .Done;
    }
    return .Idle;
}

// BridgeMessage::send_command(target, command, ack) (crate::protocol).
fn send_command_message(target: []const u8, command: []const u8, ack: bool) -> BridgeMessage {
    return BridgeMessage {
        kind: .SendCommand,
        target: target,
        command: command,
        ack: ack,
        status: .Idle,
        message: "",
    };
}

// BridgeMessage::update_status(agent_id, status, message) (crate::protocol).
fn update_status_message(agent_id: []const u8, st: AgentStatus, note: []const u8) -> BridgeMessage {
    return BridgeMessage {
        kind: .UpdateStatus,
        target: agent_id,
        command: "",
        ack: false,
        status: st,
        message: note,
    };
}

// Lines 84-104, the [STATUS: ...] branch, for one trimmed line. Writes at
// most one UpdateStatus at out[base] and returns 1, or returns 0.
fn parse_status_line(t: []const u8, out: []BridgeMessage, base: usize) -> usize {
    if (base >= out.len) {
        return 0;
    }
    // trim_start_matches("[STATUS:") - repeated, as in the original.
    var inner: []const u8 = t;
    while (starts_with(inner, "[STATUS:")) {
        const skip: []const u8 = inner[8..inner.len];
        inner = skip;
    }
    // trim_end_matches(']') - repeated.
    while (inner.len > 0 and inner[inner.len - 1] == ']') {
        const keep: usize = inner.len - 1;
        const cut: []const u8 = inner[0..keep];
        inner = cut;
    }
    const first = find_word(inner, 0);
    const second = find_word(inner, 1);
    const third = find_word(inner, 2);
    if (!first.found or !second.found) {
        return 0;
    }
    const agent_word: []const u8 = inner[first.wstart..first.wend];
    const status_word: []const u8 = inner[second.wstart..second.wend];
    const parsed_status: AgentStatus = parse_agent_status(status_word);
    var status_note: []const u8 = "";
    if (third.found) {
        const note_part: []const u8 = inner[third.wstart..third.wend];
        status_note = note_part;
    }
    const msg: BridgeMessage = update_status_message(agent_word, parsed_status, status_note);
    out[base] = msg;
    return 1;
}

// Lines 62-105 for one trimmed line. The @-branch and the [STATUS:
// branch are mutually exclusive on the first character, so a line emits
// at most one message; writes it at out[base] and returns 1, or 0.
fn parse_line_messages(line: []const u8, out: []BridgeMessage, base: usize) -> usize {
    if (base >= out.len) {
        return 0;
    }
    const tb = trim_bounds(line);
    const t: []const u8 = line[tb.lo..tb.hi];
    if (t.len == 0) {
        return 0;
    }

    // "@all rest" -> SendCommand to "broadcast" (lines 67-72).
    if (starts_with(t, "@all ")) {
        const rest: []const u8 = t[5..t.len];
        const msg: BridgeMessage = send_command_message("broadcast", rest, false);
        out[base] = msg;
        return 1;
    }
    // "@agent-id cmd" -> SendCommand to the agent (lines 73-81).
    if (t[0] == '@') {
        const sp: usize = find_char_from(t, ' ', 1);
        if (sp < t.len) {
            const after: usize = sp + 1;
            const agent_part: []const u8 = t[1..sp];
            const cmd_part: []const u8 = t[after..t.len];
            const msg: BridgeMessage = send_command_message(agent_part, cmd_part, false);
            out[base] = msg;
            return 1;
        }
        return 0;
    }
    // "[STATUS: ...]" -> UpdateStatus (lines 84-104).
    if (starts_with(t, "[STATUS:")) {
        return parse_status_line(t, out, base);
    }
    return 0;
}

// Line 59: parse agent commands from issue comments. Writes into the
// caller's buffer (the Vec of the original) and returns the count.
pub fn GitHubClient_parse_agent_commands(comments: []IssueComment, out: []BridgeMessage) -> usize {
    var count: usize = 0;
    for comment in comments {
        const text: []const u8 = comment.body;
        var line_start: usize = 0;
        var i: usize = 0;
        while (i < text.len) {
            if (text[i] == '\n') {
                const line: []const u8 = text[line_start..i];
                if (count < out.len) {
                    const added: usize = parse_line_messages(line, out, count);
                    count += added;
                }
                line_start = i + 1;
            }
            i += 1;
        }
        // The final line: after the last newline, or the whole body when
        // there is no newline at all.
        const last: []const u8 = text[line_start..text.len];
        if (count < out.len) {
            const added: usize = parse_line_messages(last, out, count);
            count += added;
        }
    }
    return count;
}

// ---- tests ----------------------------------------------------------------

test new_stores_repo_and_token {
    const client = GitHubClient_new("gHashTag/trios", null);
    assert(client.repo == "gHashTag/trios");
    assert(!GitHubClient_uses_personal_token(client.token));

    const with_token = GitHubClient_new("gHashTag/trios", "ghp_example");
    assert(GitHubClient_uses_personal_token(with_token.token));
}

test split_repo_uses_first_slash {
    const parts = GitHubClient_split_repo("gHashTag/trios");
    assert(parts.owner == "gHashTag");
    assert(parts.name == "trios");
}

test split_repo_falls_back_without_slash {
    const parts = GitHubClient_split_repo("just-a-name");
    assert(parts.owner == "gHashTag");
    assert(parts.name == "trios");
}

test uses_personal_token_follows_option {
    assert(!GitHubClient_uses_personal_token(null));
    assert(GitHubClient_uses_personal_token("ghp_example"));
}

test body_defaults_to_empty {
    assert(issue_comment_body_or_default(null) == "");
    assert(issue_comment_body_or_default("hello") == "hello");
}

test parse_broadcast_command {
    var comments: [1]IssueComment = [IssueComment {
        id: 1,
        issue_number: 30,
        author: "general",
        body: "@all STOP asking questions, just push",
    }];
    var out: [4]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 1);
    assert(out[0].kind == .SendCommand);
    assert(out[0].target == "broadcast");
    assert(out[0].command == "STOP asking questions, just push");
    assert(!out[0].ack);
}

test parse_send_command {
    var comments: [1]IssueComment = [IssueComment {
        id: 2,
        issue_number: 30,
        author: "general",
        body: "@agent-1 deploy to production",
    }];
    var out: [4]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 1);
    assert(out[0].kind == .SendCommand);
    assert(out[0].target == "agent-1");
    assert(out[0].command == "deploy to production");
}

test parse_status_marker {
    var comments: [1]IssueComment = [IssueComment {
        id: 3,
        issue_number: 30,
        author: "agent-1",
        body: "[STATUS: agent-1 WORKING training]",
    }];
    var out: [4]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 1);
    assert(out[0].kind == .UpdateStatus);
    assert(out[0].target == "agent-1");
    assert(out[0].status == .Working);
    assert(out[0].message == "training");
}

test parse_multiple_lines_and_comments {
    var comments: [2]IssueComment = [
        IssueComment {
            id: 4,
            issue_number: 30,
            author: "general",
            body: "not a command\n@all pause\n[STATUS: agent-2 DONE]\n",
        },
        IssueComment {
            id: 5,
            issue_number: 30,
            author: "agent-3",
            body: "@agent-3 test everything",
        },
    ];
    var out: [8]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 3);
    assert(out[0].kind == .SendCommand);
    assert(out[0].target == "broadcast");
    assert(out[0].command == "pause");
    assert(out[1].kind == .UpdateStatus);
    assert(out[1].target == "agent-2");
    assert(out[1].status == .Done);
    assert(out[1].message == "");
    assert(out[2].target == "agent-3");
    assert(out[2].command == "test everything");
}

test parse_status_unknown_word_defaults_to_idle {
    var comments: [1]IssueComment = [IssueComment {
        id: 6,
        issue_number: 30,
        author: "agent-9",
        body: "[STATUS: agent-9 DEPLOYING]",
    }];
    var out: [4]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 1);
    assert(out[0].status == .Idle);
    assert(out[0].message == "");
}

test parse_ignores_non_commands {
    var comments: [1]IssueComment = [IssueComment {
        id: 7,
        issue_number: 30,
        author: "general",
        body: "just chatting\n@all\n@nospace\n[STATUS: only-one-word]\n   \n",
    }];
    var out: [4]BridgeMessage = undefined;
    const n = GitHubClient_parse_agent_commands(&comments, &out);
    assert(n == 0);
}
