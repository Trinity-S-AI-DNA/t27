// Port of gHashTag/trios crates/trios-git/src/diff.rs (84 lines, at 8b229e9489ee)
// to .t27, roadmap stage 6 (t27c gen-rust; issue #5540).
//
// The original is one function that opens a git repository, asks libgit2 for the
// index-to-workdir diff (optionally filtered by a pathspec), prints it as a patch
// and collects the paths of the touched files. libgit2, the filesystem and the
// Result plumbing are the caller's side of the boundary; the decisions inside
// get_diff are pure and are ported here as functions a test can call:
//
//   - a pathspec is applied exactly when the caller named a file (lines 9-15);
//   - the patch keeps only the three line origins '+', '-' and ' ' (lines 20-23),
//     every other origin -- the '\\' of "\ No newline at end of file" among them --
//     is dropped, and its content is still appended;
//   - content is appended only when it is valid UTF-8 (lines 24-26), so an
//     undecodable line contributes its origin and nothing else;
//   - a delta is labelled with the NEW path when it has one, else the OLD path
//     (lines 32-36), and a delta with neither is not listed at all.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trios::crates::trios_git::src::diff;

// diff.rs lines 9-15: `if let Some(path) = file` -- the DiffOptions with
// `pathspec(path)` exist only in the Some arm. The None arm asks for the whole
// workdir diff.
pub fn diff_uses_pathspec(file_named: bool) -> bool {
    return file_named;
}

// diff.rs lines 20-23: the match keeps '+' (an added line), '-' (a removed line)
// and ' ' (a context line). Everything else falls into `_ => {}`: the '\\' origin
// of "\ No newline at end of file", and the 'H'/'F' origins libgit2 uses for hunk
// and file headers, never reach the patch buffer.
pub fn diff_keeps_origin(origin: u8) -> bool {
    return origin == '+' || origin == '-' || origin == ' ';
}

// diff.rs lines 24-26: `if let Ok(content) = std::str::from_utf8(...)` -- a line
// whose bytes are not UTF-8 is not appended. The origin, pushed on the line above,
// stays: a bad line still marks that something changed there.
pub fn diff_keeps_content(content_is_utf8: bool) -> bool {
    return content_is_utf8;
}

// diff.rs lines 32-33: `if let Some(p) = delta.new_file().path()` -- the new path
// is preferred. It is the path of the file as it exists in the working directory.
pub fn diff_prefers_new_path(has_new_path: bool) -> bool {
    return has_new_path;
}

// diff.rs lines 32-36: the old path is used only when the new one is absent (a
// deletion, where the delta has no new file). A delta with neither path appends
// nothing.
pub fn diff_lists_file(has_new_path: bool, has_old_path: bool) -> bool {
    return has_new_path || has_old_path;
}

// diff.rs line 6: the function itself. Opening the repository, running
// diff_index_to_workdir, iterating libgit2's callbacks and building the two
// strings are all the caller's side of the boundary -- no pure .t27 function can
// reach them, and no test calls this one. The decisions it makes are the five
// functions above, each asserted below.
pub fn get_diff(repo_path: str, file: str, file_named: bool) -> bool {
    undefined;
}

test pathspec_only_when_a_file_is_named {
    assert(diff_uses_pathspec(true));
    assert(!diff_uses_pathspec(false));
}

test patch_keeps_the_three_line_origins {
    assert(diff_keeps_origin('+'));
    assert(diff_keeps_origin('-'));
    assert(diff_keeps_origin(' '));
}

test patch_drops_every_other_origin {
    assert(!diff_keeps_origin('\\'));
    assert(!diff_keeps_origin('H'));
    assert(!diff_keeps_origin('F'));
    assert(!diff_keeps_origin('@'));
}

test content_append_needs_valid_utf8 {
    assert(diff_keeps_content(true));
    assert(!diff_keeps_content(false));
}

test new_path_is_preferred_old_path_is_the_fallback {
    assert(diff_prefers_new_path(true));
    assert(!diff_prefers_new_path(false));
    assert(diff_lists_file(true, true));
    assert(diff_lists_file(true, false));
    assert(diff_lists_file(false, true));
    assert(!diff_lists_file(false, false));
}
