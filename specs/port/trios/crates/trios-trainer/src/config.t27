// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-trainer/src/config.t27
// Port of gHashTag/trios crates/trios-trainer/src/config.rs @ 8b229e9489ee
// (150 lines, 5 functions), roadmap stage 6, goal #4548, issue #9394.
//
// The original loads a TOML file, validates INV-8 (lr in the phi-band
// [0.001, 0.01]) and then overrides training.seed and training.steps from
// the TRIOS_SEED / TRIOS_STEPS environment variables.
//
// WHAT THIS SPEC DELIBERATELY DOES NOT CONTAIN
//
// The plumbing: reading the file, parsing the TOML and reading the
// environment are not expressible in .t27. They stay in Config_load as an
// undefined stub that no test calls. The decision inside load -- reject an
// lr outside the band, then apply the env overrides in the original's
// order, rejecting a non-numeric env value -- is ported as the pure
// Config_decide, which the tests exercise directly. The env answers arrive
// as (present, text) pairs, the shape an env::var caller hands over;
// parsing the text is ported in parse_u64 so the invalid-env-value path is
// a real decision and not a duck.
//
// The original's Result<Config, LoadConfigError> is narrowed to
// LoadDecision: the verdict plus the TrainingConfig after overrides, which
// is every field the decision reads or moves. The model, jepa and ledger
// sections are untouched pass-through data in load and carry no decision.

module port::trios::crates::trios_trainer::src;

// alpha_phi / phi^3 (INV-8)
fn default_lr() -> f32 {
    return 0.004;
}

fn default_checkpoint_interval() -> usize {
    return 1000;
}

fn default_eval_interval() -> usize {
    return 500;
}

// INV-8: the learning rate lives in the phi-band [0.001, 0.01]
// (proven by lr_convergence.v).
pub fn validate_lr_phi_band(lr: f32) -> bool {
    return lr >= 0.001 and lr <= 0.01;
}

// The facts of TrainingConfig the load decision reads or moves. The
// original struct carries these six fields; the model, jepa and ledger
// sections are never read by load's decision and are not modelled.
struct TrainingConfig {
    seed: u64,
    steps: usize,
    batch_size: usize,
    lr: f32,
    checkpoint_interval: usize,
    eval_interval: usize,
}

// LoadConfigError from the original, plus NoError so the success verdict
// has something honest to carry in err.
enum LoadConfigError {
    NoError,
    ReadError,
    ParseError,
    InvalidLr,
    InvalidEnvVar,
}

// u64::from_str's answer for one env value.
struct ParsedU64 {
    ok: bool,
    value: u64,
}

// The Result of load, narrowed to what the decision produces: the verdict
// and the training config after the env overrides.
struct LoadDecision {
    ok: bool,
    err: LoadConfigError,
    training: TrainingConfig,
}

// u64::from_str as load uses it on the env values: ASCII digits only; the
// empty string and anything else are errors.
pub fn parse_u64(text: []const u8) -> ParsedU64 {
    var value: u64 = 0;
    var n: usize = 0;
    for c in text {
        if (c < '0' or c > '9') {
            return ParsedU64 { ok: false, value: 0 };
        }
        const d: u64 = (c - '0') as u64;
        value = value * 10 + d;
        n += 1;
    }
    if (n == 0) {
        return ParsedU64 { ok: false, value: 0 };
    }
    return ParsedU64 { ok: true, value: value };
}

// The decision inside Config::load. Validate INV-8 on the parsed config
// first; then override seed and steps from the env answers, in the
// original's order, so a bad TRIOS_SEED is reported even when TRIOS_STEPS
// is also bad.
pub fn Config_decide(training: TrainingConfig, env_seed_present: bool, env_seed: []const u8, env_steps_present: bool, env_steps: []const u8) -> LoadDecision {
    if (!validate_lr_phi_band(training.lr)) {
        return LoadDecision { ok: false, err: .InvalidLr, training: training };
    }
    var seed: u64 = training.seed;
    var steps: usize = training.steps;
    if (env_seed_present) {
        const parsed = parse_u64(env_seed);
        if (!parsed.ok) {
            return LoadDecision { ok: false, err: .InvalidEnvVar, training: training };
        }
        seed = parsed.value;
    }
    if (env_steps_present) {
        const parsed = parse_u64(env_steps);
        if (!parsed.ok) {
            return LoadDecision { ok: false, err: .InvalidEnvVar, training: training };
        }
        steps = parsed.value;
    }
    const out = TrainingConfig {
        seed: seed,
        steps: steps,
        batch_size: training.batch_size,
        lr: training.lr,
        checkpoint_interval: training.checkpoint_interval,
        eval_interval: training.eval_interval,
    };
    return LoadDecision { ok: true, err: .NoError, training: out };
}

// Plumbing only in the original: std::fs::read_to_string, toml::from_str
// and std::env::var are not expressible in .t27. The stub would read the
// file, parse the TOML into a TrainingConfig and hand it to Config_decide
// with the env answers. No test calls it.
pub fn Config_load(path: str) -> LoadDecision {
    undefined;
}

// A fixture the tests build their configs from, with the three fields the
// decision does not touch at their defaults.
fn make_training(lr: f32, seed: u64, steps: usize) -> TrainingConfig {
    return TrainingConfig {
        seed: seed,
        steps: steps,
        batch_size: 8,
        lr: lr,
        checkpoint_interval: default_checkpoint_interval(),
        eval_interval: default_eval_interval(),
    };
}

// ==================================================================
// Tests
// ==================================================================

test validate_lr_phi_band_matches_original_cases {
    // The original's own #[test] cases for validate_lr_phi_band.
    assert(validate_lr_phi_band(0.004));
    assert(validate_lr_phi_band(0.001));
    assert(validate_lr_phi_band(0.01));
    assert(!validate_lr_phi_band(0.0009));
    assert(!validate_lr_phi_band(0.011));
}

test defaults_match_original_constants {
    assert(default_lr() == 0.004);
    assert(default_checkpoint_interval() == 1000);
    assert(default_eval_interval() == 500);
}

test load_decision_accepts_in_band_without_env {
    const d = Config_decide(make_training(0.004, 42, 10_000), false, "", false, "");
    assert(d.ok);
    assert(d.err == .NoError);
    assert(d.training.seed == 42);
    assert(d.training.steps == 10_000);
    assert(d.training.lr == 0.004);
    assert(d.training.batch_size == 8);
    assert(d.training.checkpoint_interval == 1000);
    assert(d.training.eval_interval == 500);
}

test load_decision_rejects_lr_outside_phi_band {
    const low = Config_decide(make_training(0.0009, 1, 100), false, "", false, "");
    assert(!low.ok);
    assert(low.err == .InvalidLr);
    const high = Config_decide(make_training(0.011, 1, 100), false, "", false, "");
    assert(!high.ok);
    assert(high.err == .InvalidLr);
    // INV-8 is inclusive at both edges, so the edges themselves load.
    assert(Config_decide(make_training(0.001, 1, 100), false, "", false, "").ok);
    assert(Config_decide(make_training(0.01, 1, 100), false, "", false, "").ok);
}

test load_decision_env_overrides_apply {
    const d = Config_decide(make_training(0.004, 42, 10_000), true, "7", true, "250");
    assert(d.ok);
    assert(d.training.seed == 7);
    assert(d.training.steps == 250);
    // lr is never overridden by the environment.
    assert(d.training.lr == 0.004);
}

test load_decision_rejects_non_numeric_env {
    const bad_seed = Config_decide(make_training(0.004, 42, 100), true, "abc", false, "");
    assert(!bad_seed.ok);
    assert(bad_seed.err == .InvalidEnvVar);
    // An empty env value is not a number in Rust's parse either.
    const empty_steps = Config_decide(make_training(0.004, 42, 100), false, "", true, "");
    assert(!empty_steps.ok);
    assert(empty_steps.err == .InvalidEnvVar);
    // Seed is checked first, so a good TRIOS_STEPS does not rescue it, and
    // the returned config still carries the un-overridden input values.
    const both = Config_decide(make_training(0.004, 42, 100), true, "abc", true, "50");
    assert(!both.ok);
    assert(both.err == .InvalidEnvVar);
    assert(both.training.steps == 100);
}

test parse_u64_mirrors_rust_from_str {
    const zero = parse_u64("0");
    assert(zero.ok);
    assert(zero.value == 0);
    const thousand = parse_u64("1000");
    assert(thousand.ok);
    assert(thousand.value == 1000);
    assert(!parse_u64("12x").ok);
    assert(!parse_u64("").ok);
    assert(!parse_u64("-5").ok);
    assert(!parse_u64(" 7").ok);
}
