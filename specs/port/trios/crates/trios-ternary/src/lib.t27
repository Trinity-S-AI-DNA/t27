module port::trios::crates::trios_ternary;

// Ternary value: {-1, 0, +1}
pub enum Ternary {
    /// Negative weight (-1)
    NegOne = -1,

    /// Zero weight (0) - enables pruning
    Zero = 0,

    /// Positive weight (+1)
    PosOne = 1,
}

/// Convert f32 to ternary with thresholding
pub fn Ternary_from_f32(value: f32) -> Ternary {
    if (value > 0.5) {
        return Ternary.PosOne;
    } else if (value < -0.5) {
        return Ternary.NegOne;
    } else {
        return Ternary.Zero;
    }
}

/// Convert ternary back to f32
pub fn Ternary_to_f32(self: Ternary) -> f32 {
    switch (self) {
        .NegOne => -1.0,
        .Zero => 0.0,
        .PosOne => 1.0,
    }
}

/// Get bit-width per parameter (log2(3) ≈ 1.585)
pub fn Ternary_bits_per_param() -> f32 {
    1.5849625007211561814537389439478165087595864355105 // log2(3)
}

/// Quantize f32 weights to ternary
pub fn quantize(weights: []const f32, scale: f32) -> []Ternary {
    // TODO: Implement actual quantization logic
    // For now, return empty array
    return &[_]Ternary{};
}

/// Dequantize ternary weights back to f32
pub fn dequantize(ternary_weights: []const Ternary, scale: f32) -> []f32 {
    // TODO: Implement actual dequantization logic
    // For now, return empty array
    return &[_]f32{};
}

/// Compute optimal scaling factor for ternary quantization
pub fn compute_scale(weights: []const f32) -> f32 {
    if (weights.len == 0) {
        return 1.0;
    }

    var max_abs: f32 = 0.0;
    for (weights) |w| {
        const abs_w = if (w < 0) -w else w;
        if (abs_w > max_abs) {
            max_abs = abs_w;
        }
    }

    if (max_abs > 0.0) {
        return 1.0 / max_abs;
    } else {
        return 1.0;
    }
}

/// Calculate sparsity after ternary quantization
pub fn compute_sparsity(ternary_weights: []const Ternary) -> f32 {
    if (ternary_weights.len == 0) {
        return 0.0;
    }

    var zero_count: usize = 0;
    for (ternary_weights) |t| {
        if (t == Ternary.Zero) {
            zero_count += 1;
        }
    }

    return zero_count as f32 / ternary_weights.len as f32;
}

// Tests for Ternary_from_f32
test Ternary_from_f32_positive {
    const result = Ternary_from_f32(1.0);
    assert(result == Ternary.PosOne);
}

test Ternary_from_f32_negative {
    const result = Ternary_from_f32(-1.0);
    assert(result == Ternary.NegOne);
}

test Ternary_from_f32_zero {
    const result = Ternary_from_f32(0.0);
    assert(result == Ternary.Zero);
}

test Ternary_from_f32_thresholds {
    const result1 = Ternary_from_f32(0.6);
    assert(result1 == Ternary.PosOne);
    
    const result2 = Ternary_from_f32(-0.6);
    assert(result2 == Ternary.NegOne);
    
    const result3 = Ternary_from_f32(0.3);
    assert(result3 == Ternary.Zero);
    
    const result4 = Ternary_from_f32(-0.3);
    assert(result4 == Ternary.Zero);
}

// Tests for Ternary_to_f32
test Ternary_to_f32_conversion {
    assert(Ternary_to_f32(Ternary.PosOne) == 1.0);
    assert(Ternary_to_f32(Ternary.NegOne) == -1.0);
    assert(Ternary_to_f32(Ternary.Zero) == 0.0);
}

// Test for Ternary_bits_per_param
test Ternary_bits_per_param_value {
    const bits = Ternary_bits_per_param();
    // log2(3) ≈ 1.58496
    const diff = if (bits >= 1.585) bits - 1.585 else 1.585 - bits;
    assert(diff < 0.01);
}

// Test for compute_scale
test compute_scale_empty {
    const empty_weights: []const f32 = &[_]f32{};
    const scale = compute_scale(empty_weights);
    assert(scale == 1.0);
}

test compute_scale_normal {
    const weights = [_]f32{0.1, 0.5, 1.0, 1.5};
    const scale = compute_scale(&weights);
    // max_abs = 1.5, so scale = 1.0 / 1.5 = 0.666...
    const expected = 1.0 / 1.5;
    const diff = if (scale >= expected) scale - expected else expected - scale;
    assert(diff < 0.001);
}

test compute_scale_all_zeros {
    const weights = [_]f32{0.0, 0.0, 0.0};
    const scale = compute_scale(&weights);
    assert(scale == 1.0);
}

// Test for compute_sparsity
test compute_sparsity_empty {
    const empty_ternary: []const Ternary = &[_]Ternary{};
    const sparsity = compute_sparsity(empty_ternary);
    // This would be 0/0, but our function should handle it
    assert(sparsity == 0.0);
}

test compute_sparsity_all_zero {
    const ternary = [_]Ternary{Ternary.Zero, Ternary.Zero, Ternary.Zero};
    const sparsity = compute_sparsity(&ternary);
    assert(sparsity == 1.0);
}

test compute_sparsity_mixed {
    const ternary = [_]Ternary{Ternary.PosOne, Ternary.Zero, Ternary.NegOne, Ternary.Zero};
    const sparsity = compute_sparsity(&ternary);
    // 2 zeros out of 4 = 0.5
    assert(sparsity == 0.5);
}

test compute_sparsity_none_zero {
    const ternary = [_]Ternary{Ternary.PosOne, Ternary.NegOne, Ternary.PosOne};
    const sparsity = compute_sparsity(&ternary);
    assert(sparsity == 0.0);
}