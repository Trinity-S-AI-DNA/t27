// Trinity weight initialization — the √3-modulated Xavier-like bound.
// Port of gHashTag/trios:crates/trios-trinity-init/src/lib.rs
// (at 8b229e9489ee, 70+ lines) — Roadmap Stage 6, goal #4548, target t27c
// gen-rust.
//
// The original initializes a weight tensor for the given shape with
// sacred-geometry scaling: the element count is the product of the
// dimensions, an empty shape or a zero dimension yields no elements, and
// the sampling bound is √3 / √n — Xavier-like, with the Trinity √3
// factor. Every sampled weight lives in the symmetric range [-bound,
// bound], as the original's own doc test asserts.
//
// The language has no sqrt builtin, so both roots are computed by
// Newton's iteration (forty halving rounds, far past f32 precision), the
// same honest device the invariants port uses. The RNG and the growable
// Vec are plumbing; the decisions — the count rule with its two empty
// guards, the bound formula, and the symmetric range every sample must
// respect — are ported here as pure functions and tested. The required
// name returns the plan: the element count the caller allocates and the
// bound it samples within (issue #9594, "Port the decision, not the
// plumbing").

module port::trios_trinity_init;

// Newton's iteration for the square root: x <- (x + v/x) / 2, forty
// rounds — quadratic convergence, far beyond the f32 tolerance below.
pub fn sqrt_newton32(v: f32) -> f32 {
    var s: f32 = v;
    var i: usize = 0;
    while (i < 40) {
        s = (s + v / s) / 2.0;
        i += 1;
    }
    return s;
}

// Original line 53: `let size = shape.iter().product::<usize>();` — the
// element count is the product of the dimensions.
pub fn shape_product(shape: []const usize) -> usize {
    var size: usize = 1;
    var i: usize = 0;
    while (i < shape.len) {
        size = size * shape[i];
        i += 1;
    }
    return size;
}

// Original lines 47-70: `pub fn trinity_init(shape) -> Vec<f32>`. The
// plan this function decides: an empty shape (line 49) or a zero product
// (line 54) yields no elements and no bound; otherwise the count is the
// shape product and the bound is √3 / √n (lines 61-64), the Xavier-like
// bound with the Trinity √3 factor. The RNG sampling of n values inside
// [-bound, bound] is the caller's plumbing.
pub struct TrinityInitPlan {
    element_count: usize,
    bound: f32,
}

pub fn trinity_init(shape: []const usize) -> TrinityInitPlan {
    if (shape.len == 0) {
        return TrinityInitPlan { element_count: 0, bound: 0.0 };
    }
    const size: usize = shape_product(shape);
    if (size == 0) {
        return TrinityInitPlan { element_count: 0, bound: 0.0 };
    }
    const sqrt_3: f32 = sqrt_newton32(3.0);
    const n_f: f32 = size as f32;
    const sqrt_n: f32 = sqrt_newton32(n_f);
    return TrinityInitPlan { element_count: size, bound: sqrt_3 / sqrt_n };
}

// The symmetric range every sample must respect — the original's own doc
// test asserts x >= -bound && x <= bound for every generated weight.
pub fn sample_within_bound(x: f32, bound: f32) -> bool {
    if (x < 0.0 - bound) {
        return false;
    }
    if (x > bound) {
        return false;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Tests: every decision above asserted against values read from the
// original's own doc tests (lines 36-46). No transport exists in this
// port.
// ---------------------------------------------------------------------------

test newton_roots_converge {
    const r3 = sqrt_newton32(3.0);
    assert(r3 > 1.7320);
    assert(r3 < 1.7321);
    const r12 = sqrt_newton32(12.0);
    assert(r12 > 3.4641);
    assert(r12 < 3.4642);
}

test empty_shape_yields_no_elements {
    var empty: [0]usize = [];
    const plan = trinity_init(&empty);
    assert(plan.element_count == 0);
    assert(plan.bound == 0.0);
}

test zero_dim_yields_no_elements {
    var with_zero: [2]usize = [3, 0];
    const plan = trinity_init(&with_zero);
    assert(plan.element_count == 0);
}

test product_of_shape_dimensions {
    var s34: [2]usize = [3, 4];
    assert(shape_product(&s34) == 12);
    var deep: [3]usize = [256, 128, 64];
    assert(shape_product(&deep) == 2097152);
}

test bound_is_sqrt3_over_sqrtn {
    var s34: [2]usize = [3, 4];
    const plan = trinity_init(&s34);
    assert(plan.bound > 0.49);
    assert(plan.bound < 0.51);
    var one: [1]usize = [1];
    const single = trinity_init(&one);
    assert(single.bound > 1.73);
    assert(single.bound < 1.74);
}

test plan_composes_count_and_bound {
    var s34: [2]usize = [3, 4];
    const plan = trinity_init(&s34);
    assert(plan.element_count == 12);
    assert(sample_within_bound(0.0, plan.bound));
    assert(sample_within_bound(plan.bound, plan.bound));
    assert(sample_within_bound(0.0 - plan.bound, plan.bound));
}

test samples_live_in_the_symmetric_range {
    assert(sample_within_bound(0.25, 0.5));
    assert(sample_within_bound(-0.25, 0.5));
    assert(!sample_within_bound(0.51, 0.5));
    assert(!sample_within_bound(-0.51, 0.5));
    assert(sample_within_bound(0.5, 0.5));
}
