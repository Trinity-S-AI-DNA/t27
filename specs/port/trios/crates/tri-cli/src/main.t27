// main.rs line 133. Honours TRIOS_ARTICLE_RUNNER, walks up from
// CARGO_MANIFEST_DIR looking for docs/articles/_runner/src/main.mjs,
// falls back to the cwd, else bails. Decisions ported: first_true and
// locate_runner_source. Returns the runner path; null is the bail branch.
pub fn locate_article_runner() -> ?str {
    undefined;
}

// main.rs line 164. Runs `node <runner> <args...>` and bails when the
// runner fails. Decision ported: article_outcome.
