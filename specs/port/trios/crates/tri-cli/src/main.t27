// Port of gHashTag/trios crates/tri-cli/src/main.rs at 8b229e9489ee --
// `tri`, the unified CLI that runs trios-server behind a Tailscale Funnel
// and forwards article runs to the repo-native Node runner.
//
// Ported as pure, tested decisions (each helper names the main.rs lines it
// comes from):
//   - the Funnel "already running" verdict (lines 60-61)   -> funnel_running
//     and its String::contains basis                       -> contains
//   - the pkill -f target test (lines 104-105)             -> is_server_process
//   - the walk-up scan for the article runner (144-152)    -> first_true
//   - the full locate_article_runner search order, incl.
//     the set-but-missing TRIOS_ARTICLE_RUNNER override
//     falling through (135-161)                            -> locate_runner_source
//   - the runner exit verdict, code vs signal (172-177)    -> article_outcome
//   - the clap default: bare `tri` means Start on port
//     9005 (line 194)                                      -> resolve_command
//   - the select! exit codes: Ctrl+C and success exit 0,
//     a failed command exits 1 (188-205)                   -> exit_code_for
//
// Kept as plumbing stubs with the original names and shapes, `undefined;`
// bodies, never called by tests (each one only moves data in or out:
// process spawn and wait, env vars, cwd, filesystem probes):
//   - start_server_and_tunnel, stop_all, show_status, wait_for_server,
//     locate_article_runner, run_article, main
// The string-building plumbing (format! banners, port.to_string(), the
// bail! messages) has no t27 equivalent and is noted in the stub comments.

module port::trios::crates::tri_cli::src::main;

// main.rs lines 39-40: the cargo package names the CLI drives. The tunnel
// CLI ("tri-tunnel") is what stop_all stops and show_status probes; the
// server binary is what stop_all's `pkill -f` matches.
pub const TRIOS_SERVER: str = "trios-server";

// main.rs line 19: `#[arg(long, default_value = "9005")] port: u16` on the
// Start subcommand.
pub const DEFAULT_PORT: u16 = 9005;

// main.rs line 144: the walk-up from CARGO_MANIFEST_DIR tries six levels.
pub const MAX_WALK_UP: usize = 6;

// main.rs lines 191 and 203: exit(0) on Ctrl+C and on success, exit(1)
// after printing an error.
pub const EXIT_OK: i32 = 0;
pub const EXIT_FAIL: i32 = 1;

// ---------------------------------------------------------------------------
// The seven named functions of main.rs. Each one only moves data in or out
// (spawn, wait, env, cwd, filesystem probe), so its body stays `undefined;`
// and no test calls it; the decision inside it is the pure helper named in
// its comment, and that helper is tested.
// ---------------------------------------------------------------------------

