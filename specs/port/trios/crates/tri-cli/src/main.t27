    undefined;
}

// main.rs line 182. Parses argv, races Ctrl+C against the chosen
// subcommand, maps a failed command to exit 1. Decisions ported:
// resolve_command and exit_code_for.
pub fn main() -> i32 {
    undefined;
}

// ---------------------------------------------------------------------------
// Pure decisions ported from main.rs, each tested below.
// ---------------------------------------------------------------------------

// Rust's `String::contains` (main.rs line 61 probes the Funnel status
// output for "ACTIVE"; `pkill -f` applies the same test to command lines).
pub fn contains(s: []const u8, needle: []const u8) -> bool {
    const n: usize = needle.len;
    if (n == 0) {
        return true;
    }
    if (s.len < n) {
        return false;
    }
    var i: usize = 0;
    while (i + n <= s.len) {
        var j: usize = 0;
        var hit: bool = true;
        while (j < n) {
            if (s[i + j] != needle[j]) {
                hit = false;
            }
            j += 1;
        }
        if (hit) {
            return true;
        }
        i += 1;
    }
    return false;
}

// start_server_and_tunnel, main.rs lines 60-61: the Funnel counts as
// already running exactly when the `tri-tunnel status` child succeeded AND
// its stdout contains "ACTIVE".
pub fn funnel_running(status_success: bool, stdout: []const u8) -> bool {
    if (!status_success) {
        return false;
    }
    return contains(stdout, "ACTIVE");
}

// stop_all, main.rs lines 104-105: `pkill -f trios-server` matches every
// process whose command line names the server binary.
pub fn is_server_process(cmdline: []const u8) -> bool {
    return contains(cmdline, TRIOS_SERVER);
}

// locate_article_runner, main.rs lines 144-152: scan the walk-up levels in
// order and return the index of the first level that holds the runner.
// flags.len is how far the walk got before `here.pop()` failed at the root
// (line 149); flags.len with no true level means the walk found nothing.
pub fn first_true(flags: []bool) -> usize {
    var i: usize = 0;
    while (i < flags.len) {
        if (flags[i]) {
            return i;
        }
        i += 1;
    }
    return flags.len;
}

// Which candidate locate_article_runner settles on (main.rs lines 135-161).
enum RunnerSource { Override, WalkUp, Cwd, NotFound, }

// The search order: an existing TRIOS_ARTICLE_RUNNER wins immediately; a
// set-but-missing override falls through (lines 136-139 return only when
// the path exists); then the walk-up levels, nearest first; then the cwd
// fallback (lines 154-158); then the bail on line 159.
pub fn locate_runner_source(override_set: bool, override_exists: bool, levels: []bool, cwd_exists: bool) -> RunnerSource {
    if (override_set and override_exists) {
        return .Override;
    }
    if (first_true(levels) < levels.len) {
        return .WalkUp;
    }
    if (cwd_exists) {
        return .Cwd;
    }
    return .NotFound;
}

// run_article, main.rs lines 172-177: a failing runner is an error, and the
// message names the exit code -- or "signal" when the child had none
// (`status.code().map(|c| c.to_string()).unwrap_or_else(|| "signal".into())`).
enum ArticleOutcome { Ran, ExitedWithCode, Signalled, }

pub fn article_outcome(success: bool, code_present: bool) -> ArticleOutcome {
    if (success) {
        return .Ran;
    }
    if (code_present) {
        return .ExitedWithCode;
    }
    return .Signalled;
}

// The clap subcommands (main.rs lines 16-37); Start carries DEFAULT_PORT.
enum Command { Start, Stop, Status, Article, }

// main, main.rs line 194: `cli.command.unwrap_or(Commands::Start
// { port: 9005 })` -- a bare `tri` means Start on DEFAULT_PORT.
pub fn resolve_command(has_command: bool, cmd: Command) -> Command {
    if (!has_command) {
        return .Start;
    }
    return cmd;
}

// The select! arms of main (main.rs lines 188-205): Ctrl+C stops everything
// and exits 0; a failed command prints the error and exits 1; success
// falls through to Ok(()).
enum RunEnd { Done, Interrupted, Failed, }

pub fn exit_code_for(end: RunEnd) -> i32 {
    if (end == .Failed) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// ---------------------------------------------------------------------------
// Tests, one per ported decision.
// ---------------------------------------------------------------------------

test contains_matches_rust_str_contains {
    assert(contains("funnel: ACTIVE https://trio.tailnet.ts.net", "ACTIVE"));
    assert(!contains("funnel: status inactive", "ACTIVE"));
    assert(contains("ACTIVE", "ACTIVE"));
    assert(!contains("ACT", "ACTIVE"));
    assert(contains("any status line", ""));
}

test funnel_running_needs_success_and_active {
    assert(funnel_running(true, "Status: ACTIVE"));
    assert(!funnel_running(false, "Status: ACTIVE"));
    assert(!funnel_running(true, "Status: STOPPED"));
}

test is_server_process_matches_pkill_pattern {
    assert(is_server_process("target/debug/trios-server --port 9005"));
    assert(!is_server_process("target/debug/tri-tunnel status"));
    assert(!is_server_process(""));
}

test first_true_scans_walk_up_levels_nearest_first {
    var found_at_2: [4]bool = [false, false, true, false];
    assert(first_true(&found_at_2) == 2);
    var two_hits: [4]bool = [false, false, true, true];
    assert(first_true(&two_hits) == 2);
    var none_of_3: [3]bool = [false, false, false];
    assert(first_true(&none_of_3) == 3);
}

test locate_runner_prefers_existing_override {
    var no_levels: [2]bool = [false, false];
    assert(locate_runner_source(true, true, &no_levels, true) == .Override);
}

test locate_runner_missing_override_falls_through {
    // A set-but-absent TRIOS_ARTICLE_RUNNER does not win: main.rs lines
    // 136-139 return the override only when the path exists.
    var levels: [3]bool = [false, true, false];
    assert(locate_runner_source(true, false, &levels, false) == .WalkUp);
    var none: [3]bool = [false, false, false];
    assert(locate_runner_source(true, false, &none, true) == .Cwd);
    assert(locate_runner_source(true, false, &none, false) == .NotFound);
}

test locate_runner_cwd_fallback_then_bail {
    var none: [2]bool = [false, false];
    assert(locate_runner_source(false, false, &none, true) == .Cwd);
    assert(locate_runner_source(false, false, &none, false) == .NotFound);
    assert(MAX_WALK_UP == 6);
}

test article_outcome_names_code_or_signal {
    assert(article_outcome(true, true) == .Ran);
    assert(article_outcome(false, true) == .ExitedWithCode);
    assert(article_outcome(false, false) == .Signalled);
}

test resolve_command_bare_tri_means_start {
    assert(DEFAULT_PORT == 9005);
    assert(resolve_command(false, .Stop) == .Start);
    assert(resolve_command(true, .Start) == .Start);
    assert(resolve_command(true, .Stop) == .Stop);
    assert(resolve_command(true, .Status) == .Status);
    assert(resolve_command(true, .Article) == .Article);
}

test exit_code_for_select_arms {
    assert(exit_code_for(.Done) == 0);
    assert(exit_code_for(.Interrupted) == 0);
    assert(exit_code_for(.Failed) == 1);
}
