// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-crypto/src/lib.t27
// Port of gHashTag/trios crates/trios-crypto/src/lib.rs (8b229e9489ee, 211 lines)

// The original is a thin safe wrapper around the zig-crypto-mining FFI. Every
// public function does the same two things: hand arguments to the FFI, and
// judge the return code the call produced. The hand-off is plumbing (pointers,
// lengths, out-params, unsafe); the judgment is the decision, and it is what
// this file keeps as code. The FFI return code arrives here as a parameter --
// the caller supplies what the call produced -- and the payload bytes (the
// digest, the mining result, the proof) stay on the far side of that boundary:
// they are data the FFI moves, not decisions, so the port does not model them.
//
//   lib.rs:29-33   FfiNotAvailable Display: the formatter is plumbing, the
//                  message text is the decision (FfiNotAvailable_fmt)
//   lib.rs:42-50   sha256: rc == 0 means the digest in the out-param is good
//   lib.rs:52-66   double_sha256: the first failure returns at once, before
//                  the second call is ever made; the two failures carry
//                  different texts ("first ...", "second ...")
//   lib.rs:69-95   mine_sha256d: rc verdict over a MiningResult the FFI fills
//   lib.rs:98-118  depin_prove: rc verdict over a DepinProof the FFI fills
//   lib.rs:124-147 stub mode (feature "ffi" off): every call fails with
//                  exactly the FfiNotAvailable message; the port gives that
//                  state its own code, FFI_UNAVAILABLE_RC, so the one body
//                  each name has carries both cfg branches
//
// The original's errors are Result<_, String> built with format!. format! is
// not a construct in .t27, so a verdict carries the fixed prefix of the
// message and the code separately (CryptoResult), and failure_message maps
// the stub code back to the FfiNotAvailable text -- the caller appends the
// code, as format! did. impl std::error::Error for FfiNotAvailable
// (lib.rs:35) is a marker with no behavior; .t27 has no traits.
//
// Sha256Hash, MiningResult and DepinProof are re-exported from the ffi module
// in the original (lib.rs:23). Cross-module use does not resolve in .t27 yet
// (#4298), so they are declared here. Sha256Hash is [u8; 32]; .t27 has no
// type alias, so [32]u8 is used directly.

module port::trios::crates::trios_crypto::src::lib;

// The sizes the FFI boundary expects; asserted in the tests.
pub const SHA256_HASH_LEN: usize = 32;
pub const DEPIN_PROOF_LEN: usize = 64;
pub const MINING_HEADER_LEN: usize = 80;

// lib.rs:124-147: in stub mode there is no FFI to return a real code. This
// code stands for "the ffi feature is off"; failure_message maps it to the
// FfiNotAvailable message.
pub const FFI_UNAVAILABLE_RC: i32 = -1;

// lib.rs:23, via mod ffi: the mining result the FFI fills in. The zero values
// are the ones the wrapper initializes it to before the call (lib.rs:75-80).
pub struct MiningResult { nonce: u64, hash: [32]u8, hashes_computed: u64, found: bool, }

// lib.rs:23, via mod ffi: the proof the FFI fills in; zero values as in
// lib.rs:99-104.
pub struct DepinProof { proof: [64]u8, challenge: u64, validator_hash: [32]u8, valid: bool, }

// Result<T, String> for every wrapper function, flattened: ok, the FFI return
// code, and the fixed part of the error text ("" on success and for the stub
// code, whose text comes from failure_message instead).
pub struct CryptoResult { ok: bool, error_code: i32, error_prefix: []const u8, }

// lib.rs:29-33 - impl fmt::Display for FfiNotAvailable. The formatter
// parameter is plumbing (it is where the text is written); the decision is
// the text itself. The caller writes it wherever the original wrote it into
// the formatter.
pub fn FfiNotAvailable_fmt() -> []const u8 {
    return "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.";
}

// lib.rs:126 (and 131, 141, 146) against lib.rs:46 (and 58, 62, 91, 114):
// the text a failed call produces. The stub code maps to exactly the
// FfiNotAvailable message; any real FFI code maps to the call's own prefix,
// with the code appended by the caller, as format! did.
pub fn failure_message(rc: i32, prefix: []const u8) -> []const u8 {
    if (rc == FFI_UNAVAILABLE_RC) {
        return FfiNotAvailable_fmt();
    }
    return prefix;
}

// lib.rs:42-50 (ffi cfg) and 125-127 (stub cfg) - sha256. data goes to the
// FFI as a pointer and length (plumbing); rc is what the call returned. Zero
// means the digest in the out-param is good; the stub code means no call
// happened at all, and the error is exactly the FfiNotAvailable message.
pub fn sha256(data: []const u8, rc: i32) -> CryptoResult {
    _ = data;
    if (rc == FFI_UNAVAILABLE_RC) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "" };
    }
    if (rc != 0) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "sha256 failed with code" };
    }
    return CryptoResult { ok: true, error_code: 0, error_prefix: "" };
}

// lib.rs:52-66 (ffi cfg) and 130-132 (stub cfg) - double_sha256: two chained
// FFI hashes, the first over data, the second over the first digest. The
// order of the judgment is the original's: a first failure returns at once
// (the second call is never made), a second failure is only reachable after
// a good first call, and the two carry different texts. In stub mode the
// caller passes FFI_UNAVAILABLE_RC as rc1; rc2 is never reached, as in the
// original.
pub fn double_sha256(data: []const u8, rc1: i32, rc2: i32) -> CryptoResult {
    _ = data;
    if (rc1 == FFI_UNAVAILABLE_RC) {
        return CryptoResult { ok: false, error_code: rc1, error_prefix: "" };
    }
    if (rc1 != 0) {
        return CryptoResult { ok: false, error_code: rc1, error_prefix: "first sha256 failed with code" };
    }
    if (rc2 != 0) {
        return CryptoResult { ok: false, error_code: rc2, error_prefix: "second sha256 failed with code" };
    }
    return CryptoResult { ok: true, error_code: 0, error_prefix: "" };
}

// lib.rs:69-95 (ffi cfg) and 135-142 (stub cfg) - mine_sha256d. header (80
// bytes), target (32 bytes) and the nonce range go to the FFI as pointers
// and scalars (plumbing); rc is what the call returned. The MiningResult the
// FFI fills starts at the wrapper's defaults (default_mining_result).
pub fn mine_sha256d(header: []const u8, target: []const u8, start_nonce: u64, max_nonce: u64, rc: i32) -> CryptoResult {
    _ = header;
    _ = target;
    _ = start_nonce;
    _ = max_nonce;
    if (rc == FFI_UNAVAILABLE_RC) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "" };
    }
    if (rc != 0) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "mining failed with code" };
    }
    return CryptoResult { ok: true, error_code: 0, error_prefix: "" };
}

// lib.rs:98-118 (ffi cfg) and 145-147 (stub cfg) - depin_prove. challenge
// and worker_id go to the FFI (plumbing); rc is what the call returned. The
// DepinProof the FFI fills starts at the wrapper's defaults
// (default_depin_proof).
pub fn depin_prove(challenge: u64, worker_id: []const u8, rc: i32) -> CryptoResult {
    _ = challenge;
    _ = worker_id;
    if (rc == FFI_UNAVAILABLE_RC) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "" };
    }
    if (rc != 0) {
        return CryptoResult { ok: false, error_code: rc, error_prefix: "depin_prove failed with code" };
    }
    return CryptoResult { ok: true, error_code: 0, error_prefix: "" };
}

// lib.rs:75-80 - the MiningResult the wrapper hands to the FFI, initialized.
pub fn default_mining_result() -> MiningResult {
    return MiningResult { nonce: 0, hash: [_]u8{0} ** 32, hashes_computed: 0, found: false };
}

// lib.rs:99-104 - the DepinProof the wrapper hands to the FFI, initialized.
pub fn default_depin_proof() -> DepinProof {
    return DepinProof { proof: [_]u8{0} ** 64, challenge: 0, validator_hash: [_]u8{0} ** 32, valid: false };
}

// lib.rs:31 and 188-191 (test ffi_not_available_has_message): the message
// the Display writes. The original's test looks for the "FFI not available"
// prefix; the port asserts the full text.
test ffi_not_available_has_message {
    const msg = FfiNotAvailable_fmt();
    assert(msg == "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.");
}

// lib.rs:45-49: rc 0 is success - ok, no code, no error text. The digest
// bytes themselves are the FFI out-param, plumbing.
test sha256_success_on_zero_rc {
    const r = sha256("hello world", 0);
    assert(r.ok);
    assert(r.error_code == 0);
    assert(r.error_prefix == "");
}

// lib.rs:46: any other code fails, carrying the code and the call's own
// text.
test sha256_failure_carries_code {
    const r = sha256("hello world", 7);
    assert(!r.ok);
    assert(r.error_code == 7);
    assert(r.error_prefix == "sha256 failed with code");
}

// lib.rs:159-162 (test sha256_returns_error_in_stub_mode) and 126: stub mode
// fails, and the text is exactly the FfiNotAvailable message.
test sha256_returns_error_in_stub_mode {
    const r = sha256("hello world", FFI_UNAVAILABLE_RC);
    assert(!r.ok);
    assert(failure_message(r.error_code, r.error_prefix) == "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.");
}

// lib.rs:57-59: the first failure wins - its code and the "first" text -
// and the second call is never made (rc2 is ignored here, exactly as the
// original never reaches it).
test double_sha256_first_failure_wins {
    const r = double_sha256("test data", 3, 0);
    assert(!r.ok);
    assert(r.error_code == 3);
    assert(r.error_prefix == "first sha256 failed with code");
}

// lib.rs:61-62: a second failure after a good first call carries the
// "second" text.
test double_sha256_second_failure {
    const r = double_sha256("test data", 0, 9);
    assert(!r.ok);
    assert(r.error_code == 9);
    assert(r.error_prefix == "second sha256 failed with code");
}

// lib.rs:63-65: both calls good - success.
test double_sha256_success {
    const r = double_sha256("test data", 0, 0);
    assert(r.ok);
    assert(r.error_code == 0);
    assert(r.error_prefix == "");
}

// lib.rs:90-93: mining fails with its own text on a bad code and succeeds
// on zero.
test mine_sha256d_verdict {
    const bad = mine_sha256d("header", "target", 0, 1000, 5);
    assert(!bad.ok);
    assert(bad.error_code == 5);
    assert(bad.error_prefix == "mining failed with code");
    const good = mine_sha256d("header", "target", 0, 1000, 0);
    assert(good.ok);
}

// lib.rs:113-116: depin_prove fails with its own text on a bad code and
// succeeds on zero.
test depin_prove_verdict {
    const bad = depin_prove(12345, "worker-1", 2);
    assert(!bad.ok);
    assert(bad.error_code == 2);
    assert(bad.error_prefix == "depin_prove failed with code");
    const good = depin_prove(12345, "worker-1", 0);
    assert(good.ok);
}

// lib.rs:163-169, 173-178, 181-185 (the stub-mode tests for the other three
// functions) and 126: in stub mode every call fails with exactly the
// FfiNotAvailable text.
test stub_mode_errors_for_double_mine_and_depin {
    const d = double_sha256("test data", FFI_UNAVAILABLE_RC, 0);
    assert(!d.ok);
    assert(failure_message(d.error_code, d.error_prefix) == "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.");
    const m = mine_sha256d("header", "target", 0, 1000, FFI_UNAVAILABLE_RC);
    assert(!m.ok);
    const p = depin_prove(12345, "worker-1", FFI_UNAVAILABLE_RC);
    assert(!p.ok);
    assert(failure_message(p.error_code, p.error_prefix) == "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.");
}

// lib.rs:194-197 (test sha256_hash_is_32_bytes): the digest type is 32
// bytes - MiningResult carries the same [32]u8 the FFI writes into, and the
// other two constants name the buffers the FFI boundary expects. sha256's
// success verdict closes the loop: rc == 0 means the FFI filled a [32]u8.
test sha256_hash_is_32_bytes {
    const m = default_mining_result();
    assert(m.hash.len == 32);
    assert(m.hash.len == SHA256_HASH_LEN);
    assert(DEPIN_PROOF_LEN == 64);
    assert(MINING_HEADER_LEN == 80);
    const r = sha256("abc", 0);
    assert(r.ok);
}

// lib.rs:75-80: the MiningResult starts zeroed - not found, nothing counted.
test default_mining_result_is_zeroed {
    const m = default_mining_result();
    assert(!m.found);
    assert(m.nonce == 0);
    assert(m.hashes_computed == 0);
}

// lib.rs:200-209 (test depin_proof_default_is_invalid): the default proof is
// invalid, with challenge 0.
test depin_proof_default_is_invalid {
    const p = default_depin_proof();
    assert(!p.valid);
    assert(p.challenge == 0);
}

// lib.rs:46 against 126: the text mapping - a real FFI code keeps the call's
// prefix, the stub code maps to the FfiNotAvailable message.
test failure_message_mapping {
    assert(failure_message(7, "sha256 failed with code") == "sha256 failed with code");
    assert(failure_message(FFI_UNAVAILABLE_RC, "sha256 failed with code") == "FFI not available. Build with --features ffi and ensure zig-crypto-mining vendor is present.");
}
