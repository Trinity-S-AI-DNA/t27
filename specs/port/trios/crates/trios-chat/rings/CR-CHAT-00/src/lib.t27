module port::trios::crates::trios-chat::rings::CR-CHAT-00::src::lib;

// CR-CHAT-00: chat wire-format primitives.
// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-00/src/lib.rs at
// 8b229e9489ee (T-SPLIT: the data and decision part of a mixed lib.rs).
// Tracker: gHashTag/t27 issue 8880. Epic: gHashTag/trios issue 1812.
//
// In this spec: the eight error kinds in declaration order, the id and
// counter records, the counter successor with an overflow verdict (the
// original panics), lowercase hex of a session id into [64]u8, and the
// 12-row R-CHAT law table as flat bytes plus offsets.
//
// Stays Rust (facade, not ported): the thiserror Error enum with its
// &'static str / String payloads and Display strings, the Result alias,
// serde derives and the serde_json round trip, tuple newtypes with .0,
// the panic message "counter overflow", and the const fn chat_laws()
// returning &'static [ChatLaw].
//
// Not reconciled on purpose (changes only by ADR): the titles here differ
// from CR-CHAT-LAWS, and the original Error docs map Capability to R-CHAT-7
// and Injection to R-CHAT-8, swapped versus the law table.

pub const CHAT_U64_MAX: u64 = 0xFFFFFFFFFFFFFFFF;

/// Bytes in a session id.
pub const SESSION_ID_LEN: usize = 32;

/// Characters in the lowercase hex form of a session id.
pub const SESSION_ID_HEX_LEN: usize = 64;

/// Bytes in a destination hash (routing hint).
pub const DEST_HASH_LEN: usize = 16;

/// Rows in the R-CHAT law table.
pub const CHAT_LAW_COUNT: usize = 12;

/// Fields per law row: id, title, summary.
pub const CHAT_LAW_FIELDS: usize = 3;
pub const CHAT_LAW_FIELD_ID: usize = 0;
pub const CHAT_LAW_FIELD_TITLE: usize = 1;
pub const CHAT_LAW_FIELD_SUMMARY: usize = 2;

/// Total bytes of all law fields, concatenated without separators.
pub const CHAT_LAWS_TEXT_LEN: usize = 1088;

/// The crate-wide error kinds, payload-free, in the declaration order of the
/// original Error enum.
pub enum ErrorKind {
    Invariant,
    Aead,
    Crypto,
    Capability,
    Injection,
    Persist,
    Wire,
    Encoding,
}

/// Opaque 32-byte session identity (original: tuple struct SessionId).
pub struct SessionId {
    bytes: [32]u8,
}

/// Strictly monotone ratchet counter (original: tuple struct Counter). Named
/// ChatCounter because the type name Counter is already defined by another
/// spec (specs/port/trinity/fpga/openxc7-synth/d_e21_test.t27) and the types
/// ratchet refuses a second definition.
pub struct ChatCounter {
    value: u64,
}

/// 16-byte routing hint (original: tuple struct DestHash).
pub struct DestHash {
    bytes: [16]u8,
}

/// Non-secret header travelling alongside ciphertext. No sender identity.
pub struct EnvelopeMeta {
    session: SessionId,
    counter: ChatCounter,
    dest: DestHash,
    padded_len: u32,
}

/// Verdict of counter_next: Ok first, then Overflow (the original panics with
/// "counter overflow"; the adapter keeps that panic).
pub enum CounterCode {
    Ok,
    Overflow,
}

/// On Ok, value is the successor. On Overflow, value is the input, unchanged.
pub struct CounterNext {
    code: CounterCode,
    value: u64,
}

