//! CR-CHAT-00 — Trinity Secure Chat error handling (Wave-1 Lane A).
//!
//! [VERIFIED] Common error types and utilities for the entire chat stack.
//! This ring provides shared error handling infrastructure used by all
//! other CR-CHAT-* rings. Error codes are standardized across the system.
//!
//! Sibling rings: CR-CHAT-01 (sealed/identity), CR-CHAT-02 (ratchet),
//! CR-CHAT-03 (group), CR-CHAT-04 (padding), CR-CHAT-06 (capability + injection).
//!
//! [CITED] design §3.0 — Twelve Laws of Trinity Secure Chat.

/// Chat error severity levels for system monitoring and debugging.
pub const ERROR_SEVERITY_LEVELS: [6][]const u8 = [
    "INFO",      // 0: Operational information
    "WARN",      // 1: Non-critical issues  
    "ERROR",     // 2: Recoverable errors
    "CRITICAL",  // 3: System-threatening errors
    "FATAL",     // 4: Unrecoverable errors
    "UNKNOWN",   // 5: Unknown severity
];

/// Standard error codes for the chat system.
/// [DERIVED] Common across all CR-CHAT-* rings for consistent error handling.
pub const ERROR_CODES: [32]i32 = [
    0x0000, // SUCCESS: No error
    0x0001, // CHAT_EINVAL: Invalid argument
    0x0002, // CHAT_ENOMEM: Out of memory
    0x0003, // CHAT_ESTATE: Invalid state
    0x0004, // CHAT_ECRYPTO: Cryptographic error
    0x0005, // CHAT_ENETWORK: Network error
    0x0006, // CHAT_EAUTH: Authentication error
    0x0007, // CHAT_EPERM: Permission denied
    0x0008, // CHATETIME: Timeout error
    0x0009, // CHAT_ELIMIT: Rate limit exceeded
    0x000A, // CHAT_EPROTO: Protocol error
    0x000B, // CHAT_EFORMAT: Format error
    0x000C, // CHAT_EVERSION: Version mismatch
    0x000D, // CHAT_ECONFIG: Configuration error
    0x000E, // CHAT_ESECURITY: Security violation
    0x000F, // CHAT_EINTERNAL: Internal error
    0x0010, // CHAT_EBUSY: Resource busy
    0x0011, // CHAT_EAGAIN: Try again
    0x0012, // CHAT_ENOSPC: No space left
    0x0013, // CHAT_EROFS: Read-only filesystem
    0x0014, // CHAT_EISDIR: Is a directory
    0x0015, // CHAT_ENOTDIR: Not a directory
    0x0016, // CHAT_ENOENT: No such file or directory
    0x0017, // CHAT_EEXIST: File already exists
    0x0018, // CHAT_EACCESS: Access denied
    0x0019, // CHAT_EINTR: Interrupted system call
    0x001A, // CHAT_EIO: I/O error
    0x001B, // CHAT_EINVAL_SIZE: Invalid size parameter
    0x001C, // CHAT_EINVAL_RANGE: Value out of range
    0x001D, // CHAT_EINVAL_FORMAT: Invalid format
    0x001E, // CHAT_ESTATE_TRANSITION: Invalid state transition
    0x001F, // CHAT_EUNKNOWN: Unknown error
];

/// Convert error code to human-readable string.
/// [DERIVED] Maps standardized error codes to descriptive messages.
pub fn error_code_to_string(code: i32) -> []const u8 {
    if (code == 0) {
        return "SUCCESS";
    }
    
    // Fast path for common error codes
    if (code == 0x0001) {
        return "INVALID_ARGUMENT";
    } else if (code == 0x0002) {
        return "OUT_OF_MEMORY"; 
    } else if (code == 0x0003) {
        return "INVALID_STATE";
    } else if (code == 0x0004) {
        return "CRYPTOGRAPHIC_ERROR";
    } else if (code == 0x0005) {
        return "NETWORK_ERROR";
    } else if (code == 0x0006) {
        return "AUTHENTICATION_ERROR";
    } else if (code == 0x0007) {
        return "PERMISSION_DENIED";
    } else if (code == 0x0008) {
        return "TIMEOUT_ERROR";
    } else if (code == 0x0009) {
        return "RATE_LIMIT_EXCEEDED";
    } else if (code == 0x000A) {
        return "PROTOCOL_ERROR";
    } else if (code == 0x000B) {
        return "FORMAT_ERROR";
    } else if (code == 0x000C) {
        return "VERSION_MISMATCH";
    } else if (code == 0x000D) {
        return "CONFIGURATION_ERROR";
    } else if (code == 0x000E) {
        return "SECURITY_VIOLATION";
    } else if (code == 0x000F) {
        return "INTERNAL_ERROR";
    } else if (code == 0x0010) {
        return "RESOURCE_BUSY";
    } else if (code == 0x0011) {
        return "TRY_AGAIN";
    } else if (code == 0x0012) {
        return "NO_SPACE_LEFT";
    } else if (code == 0x0013) {
        return "READ_ONLY_FILESYSTEM";
    } else if (code == 0x0014) {
        return "IS_A_DIRECTORY";
    } else if (code == 0x0015) {
        return "NOT_A_DIRECTORY";
    } else if (code == 0x0016) {
        return "NO_SUCH_FILE_OR_DIRECTORY";
    } else if (code == 0x0017) {
        return "FILE_ALREADY_EXISTS";
    } else if (code == 0x0018) {
        return "ACCESS_DENIED";
    } else if (code == 0x0019) {
        return "INTERRUPTED_SYSTEM_CALL";
    } else if (code == 0x001A) {
        return "IO_ERROR";
    } else if (code == 0x001B) {
        return "INVALID_SIZE_PARAMETER";
    } else if (code == 0x001C) {
        return "VALUE_OUT_OF_RANGE";
    } else if (code == 0x001D) {
        return "INVALID_FORMAT";
    } else if (code == 0x001E) {
        return "INVALID_STATE_TRANSITION";
    } else if (code == 0x001F) {
        return "UNKNOWN_ERROR";
    } else {
        return "UNKNOWN_ERROR_CODE";
    }
}

/// Validate error code is within expected range.
/// [DERIVED] Ensures error codes are properly formatted and valid.
pub fn validate_error_code(code: i32) -> ?i32 {
    if (code < 0 or code > 0x001F) {
        return null; // Invalid error code
    }
    return code;
}

/// Get error severity level from error code.
/// [DERIVED] Classifies errors by severity for system monitoring.
pub fn error_code_to_severity(code: i32) -> usize {
    if (code == 0) {
        return 0; // INFO for success
    } else if (code <= 0x0005) {
        return 2; // ERROR for system errors
    } else if (code <= 0x000A) {
        return 3; // CRITICAL for auth/security errors
    } else if (code <= 0x0015) {
        return 1; // WARN for resource/IO errors
    } else {
        return 4; // FATAL for unknown/internal errors
    }
}

/// Check if error code indicates a recoverable error.
/// [DERIVED] Helps determine if operation can be retried.
pub fn is_recoverable_error(code: i32) -> bool {
    if (code == 0x0002) {  // OUT_OF_MEMORY
        return true;
    } else if (code == 0x0008) {  // TIMEOUT_ERROR
        return true;
    } else if (code == 0x0009) {  // RATE_LIMIT_EXCEEDED
        return true;
    } else if (code == 0x0010) {  // RESOURCE_BUSY
        return true;
    } else if (code == 0x0011) {  // TRY_AGAIN
        return true;
    } else {
        return false;
    }
}

/// Check if error code indicates a security-related error.
/// [DERIVED] Important for security monitoring and alerting.
pub fn is_security_error(code: i32) -> bool {
    if (code == 0x0006) {  // AUTHENTICATION_ERROR
        return true;
    } else if (code == 0x0007) {  // PERMISSION_DENIED
        return true;
    } else if (code == 0x000E) {  // SECURITY_VIOLATION
        return true;
    } else if (code == 0x000F) {  // INTERNAL_ERROR (may indicate security breach)
        return true;
    } else {
        return false;
    }
}

/// Error logging utility with severity levels.
/// [DERIVED] Provides standardized error logging across the chat system.
pub fn log_error(severity: usize, code: i32, message: []const u8) {
    const severity_str = if (severity < ERROR_SEVERITY_LEVELS.len) {
        ERROR_SEVERITY_LEVELS[severity]
    } else {
        ERROR_SEVERITY_LEVELS[5] // UNKNOWN
    };
    
    const error_str = error_code_to_string(code);
    // In a real implementation, this would write to a log system
    // For now, we'll just validate the parameters
    assert(severity < ERROR_SEVERITY_LEVELS.len);
    assert(code >= 0);
}

// Error code validation tests
test error_code_validation {
    // Valid error codes
    assert(validate_error_code(0) == 0);
    assert(validate_error_code(0x0001) == 0x0001);
    assert(validate_error_code(0x001F) == 0x001F);
    
    // Invalid error codes
    assert(validate_error_code(-1) == null);
    assert(validate_error_code(0x0020) == null);
    assert(validate_error_code(1000) == null);
}

// Error severity mapping tests
test error_severity_mapping {
    assert(error_code_to_severity(0) == 0); // INFO for success
    assert(error_code_to_severity(0x0001) == 2); // ERROR
    assert(error_code_to_severity(0x0006) == 3); // CRITICAL
    assert(error_code_to_severity(0x0010) == 1); // WARN
    assert(error_code_to_severity(0x001F) == 4); // FATAL
}

// Error string conversion tests
test error_string_conversion {
    assert(error_code_to_string(0) == "SUCCESS");
    assert(error_code_to_string(0x0001) == "INVALID_ARGUMENT");
    assert(error_code_to_string(0x0006) == "AUTHENTICATION_ERROR");
    assert(error_code_to_string(0x001F) == "UNKNOWN_ERROR");
    assert(error_code_to_string(999) == "UNKNOWN_ERROR_CODE");
}

// Recoverable error detection tests
test recoverable_error_detection {
    assert(is_recoverable_error(0x0002) == true);  // OUT_OF_MEMORY
    assert(is_recoverable_error(0x0008) == true);  // TIMEOUT_ERROR
    assert(is_recoverable_error(0x0009) == true);  // RATE_LIMIT_EXCEEDED
    assert(is_recoverable_error(0x0010) == true);  // RESOURCE_BUSY
    assert(is_recoverable_error(0x0011) == true);  // TRY_AGAIN
    assert(is_recoverable_error(0x0001) == false); // INVALID_ARGUMENT (not recoverable)
    assert(is_recoverable_error(0x0006) == false); // AUTHENTICATION_ERROR (not recoverable)
}

// Security error detection tests
test security_error_detection {
    assert(is_security_error(0x0006) == true);  // AUTHENTICATION_ERROR
    assert(is_security_error(0x0007) == true);  // PERMISSION_DENIED
    assert(is_security_error(0x000E) == true);  // SECURITY_VIOLATION
    assert(is_security_error(0x000F) == true);  // INTERNAL_ERROR
    assert(is_security_error(0x0001) == false); // INVALID_ARGUMENT (not security error)
    assert(is_security_error(0x0002) == false); // OUT_OF_MEMORY (not security error)
}

// Error severity levels validation
test severity_levels_valid {
    assert(ERROR_SEVERITY_LEVELS.len == 6);
    assert(ERROR_SEVERITY_LEVELS[0] == "INFO");
    assert(ERROR_SEVERITY_LEVELS[1] == "WARN");
    assert(ERROR_SEVERITY_LEVELS[2] == "ERROR");
    assert(ERROR_SEVERITY_LEVELS[3] == "CRITICAL");
    assert(ERROR_SEVERITY_LEVELS[4] == "FATAL");
    assert(ERROR_SEVERITY_LEVELS[5] == "UNKNOWN");
}

// Error codes validation
test error_codes_valid {
    assert(ERROR_CODES.len == 32);
    assert(ERROR_CODES[0] == 0x0000); // SUCCESS
    assert(ERROR_CODES[1] == 0x0001); // CHAT_EINVAL
    assert(ERROR_CODES[31] == 0x001F); // CHAT_EUNKNOWN
}