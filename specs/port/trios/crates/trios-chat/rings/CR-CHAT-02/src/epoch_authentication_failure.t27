// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/epoch_authentication_failure.rs
// @ 8b229e9489ee (300 lines, Wave-21 lane A). Ring: CR-CHAT-02 (secure-chat).
// L-CHAT-2-eaf — Epoch authentication failure handling.
// Anchor: φ² + φ⁻² = 3 · TRINITY · CHAT · EPOCH-AUTH-FAILURE.
//
// Threat model (mirrors the original's module docs): when a peer presents a
// commit / handshake / sealed message signed under epoch `presented`, but the
// local view is at `local`, the verifier must reject WITHOUT divulging the
// direction or magnitude of the skew — a leak is a textbook MLS oracle
// enabling O(log N) blind bisection of the local epoch. Acceptance window is
// [local - GRACE, local]: future epochs are never accepted (missed-commit /
// PCS violation per R-CHAT-7), past epochs only up to GRACE = 2 (in-flight
// messages crossing a local commit boundary).
//
// Invariants ported (Coq witnesses, Section TrinityChatWave21):
//   INV-CHAT-117 eaf_future_rejected, INV-CHAT-118 eaf_grace_accepted,
//   INV-CHAT-119 eaf_opaque_error.
//
// Port decisions (T-CRYPTO-DECISION):
// * `subtle::ConstantTimeEq` / `subtle::ConstantTimeLess` (`Choice`) are not
//   available in the t27 compiler-only environment. The port models them as
//   `ct_eq` / `ct_lt` comparison helpers and preserves the original's
//   dataflow discipline: every quantity the verdict depends on (is_match,
//   is_future, gap, in_window) is computed BEFORE any branch is taken; the
//   final selection branches only over precomputed booleans, exactly as the
//   original computes all `Choice` values before its conditional moves.
//   Real deployments must use `subtle` (or equivalent) — these helpers are
//   NOT constant time.
// * `u64::saturating_sub` / `u64::saturating_add` are modeled by `satsub` /
//   `satadd` helpers (the underflow/overflow safety property of rule 4 is
//   what the tests exercise; the helpers branch, which the modeled threat
//   model accepts — the original's branchlessness applies to the verdict
//   selection, which is preserved).
// * `Result<EpochVerdict, EpochAuthenticationFailed>` lowers to
//   `?EpochVerdict` (ring-wide lowering decision): null = the single opaque
//   error `EpochAuthenticationFailed`, a verdict = Ok. The module has only
//   one error variant by design, so no information is lost.
// * `Display` for `EpochAuthenticationFailed` (a constant string) is modeled
//   as `opaque_error_display()`; EAF-06 pins the canonical constant.
// Tests: mirrors eaf_01..eaf_10 in the original @ 8b229e9489ee.

module port::epoch_authentication_failure;

/// Maximum number of epochs in the past that we still accept.
///
/// A value of 2 covers the common case where the local side just advanced an
/// epoch but a message already in flight under the previous epoch arrives
/// shortly after. Anything older than 2 epochs must be rejected — those
/// messages should have been replayed through the skipped-keys cache, not
/// re-authenticated.
pub const EPOCH_GRACE_WINDOW: u64 = 2;

/// Largest u64 (models `u64::MAX`).
const U64_MAX: u64 = 0xFFFFFFFFFFFFFFFF;

/// Acceptance verdict. Distinguishes the exact-match case from the
/// in-window-but-stale case so the CALLER can decide whether to route through
/// the skipped-keys cache. Crucially, neither variant carries the actual skew
/// distance — only the binary "match vs. within-window".
pub const EpochVerdict = enum {
    /// Presented epoch equals local epoch — fast path.
    Match,
    /// Presented epoch is strictly less than local but within
    /// EPOCH_GRACE_WINDOW. Caller routes through skipped-keys.
    WithinWindow,
};

/// Verify that `presented` is acceptable given `local`, in constant time
/// w.r.t. the skew magnitude.
///
/// Returns:
/// - `.Match`                iff `presented == local`.
/// - `.WithinWindow`         iff `local - GRACE <= presented < local`.
/// - null (opaque error)     iff `presented > local` (future epoch — PCS
///   violation) or `presented < local - GRACE` (too stale — must be replayed
///   via skipped-keys, not re-authed).
///
/// All comparison quantities are computed before any branch; the verdict is
/// selected from precomputed booleans (see port decisions).
pub fn check_epoch(local: u64, presented: u64) ?EpochVerdict {
    // Component 1: exact match (models `local.ct_eq(&presented)`).
    const is_match: bool = ct_eq(local, presented);

    // Component 2: future-epoch rejection. `1` iff local < presented, i.e.
    // presented is strictly in the future (models `local.ct_lt(&presented)`).
    const is_future: bool = ct_lt(local, presented);

    // Component 3: within-grace-window check. Compute `local - presented`
    // saturating at 0; then verify the gap is in [1, GRACE] (exclusive of 0
    // because that is Match).
    const gap: u64 = satsub(local, presented);
    const gap_at_least_one: bool = ct_lt(1, satadd(gap, 1));
    const gap_at_most_grace: bool = ct_lt(gap, satadd(EPOCH_GRACE_WINDOW, 1));
    const in_window: bool = gap_at_least_one and gap_at_most_grace;

    // Final verdict — selection over precomputed values.
    //
    // Truth table:
    //   is_future = true  -> reject (no matter what)
    //   is_match  = true  -> Match
    //   in_window = true  -> WithinWindow
    //   else              -> reject
    if (is_future) {
        // Future epoch — PCS violation. Single opaque error.
        return null;
    }
    if (is_match) {
        return .Match;
    }
    if (in_window) {
        return .WithinWindow;
    }
    return null;
}

/// Models the original's `Display` impl for `EpochAuthenticationFailed`: a
/// single constant string, regardless of skew direction or magnitude
/// (INV-CHAT-119). No skew details ever leak via this surface.
pub fn opaque_error_display() []const u8 {
    return "epoch authentication failed";
}

/// Models `subtle::ConstantTimeEq` on u64. NOT constant time — see port
/// decisions.
fn ct_eq(a: u64, b: u64) bool {
    return a == b;
}

/// Models `subtle::ConstantTimeLess` on u64. NOT constant time — see port
/// decisions.
fn ct_lt(a: u64, b: u64) bool {
    return a < b;
}

/// Models `u64::saturating_sub` — `presented` larger than `local` does NOT
/// underflow.
fn satsub(a: u64, b: u64) u64 {
    if (a <= b) return 0;
    return a - b;
}

/// Models `u64::saturating_add`.
fn satadd(a: u64, b: u64) u64 {
    if (a > U64_MAX - b) return U64_MAX;
    return a + b;
}

/// Byte-wise string equality (models `assert_eq!` on String in tests).
fn eql_str(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Tests (mirrors eaf_01..eaf_10 in the original @ 8b229e9489ee).

/// **EAF-01** — exact-match epoch accepted with `Match` verdict.
test eaf_01_exact_match {
    assert(check_epoch(42, 42).? == .Match);
    assert(check_epoch(0, 0).? == .Match);
    assert(check_epoch(U64_MAX, U64_MAX).? == .Match);
}

/// **EAF-02** — within-grace-window epoch accepted with `WithinWindow`
/// verdict.
test eaf_02_within_grace_window {
    assert(check_epoch(10, 9).? == .WithinWindow);
    assert(check_epoch(10, 8).? == .WithinWindow);
    // 10 - 2 = 8 is the lower bound, still accepted.
}

/// **EAF-03** — just-stale epoch (one past the grace window) is rejected.
test eaf_03_just_stale_rejected {
    // local=10, GRACE=2, so 10-3=7 is OUT of window.
    assert(check_epoch(10, 7) == null);
}

/// **EAF-04** — future epoch (presented > local) is rejected. Critical: this
/// MUST NOT underflow u64.
test eaf_04_future_rejected_no_underflow {
    assert(check_epoch(5, 6) == null);
    assert(check_epoch(5, 1_000_000) == null);
    // The dangerous case: local=0, presented=large.
    assert(check_epoch(0, U64_MAX) == null);
    // u64::MAX vs u64::MAX-1 still fine in the other direction:
    assert(check_epoch(U64_MAX, U64_MAX - 1).? == .WithinWindow);
}

/// **EAF-05** — extremely stale epoch is rejected (no oracle leak — same
/// error variant as just-stale).
test eaf_05_ancient_rejected_same_error {
    const just_stale = check_epoch(100, 97);
    const ancient = check_epoch(U64_MAX, 0);
    // Same variant — the error itself MUST NOT distinguish how stale the
    // presented epoch is. With a single opaque error variant (null), both
    // rejections are indistinguishable by construction.
    assert(just_stale == null);
    assert(ancient == null);
}

/// **EAF-06** — opaque-error invariant: the display surface is a constant
/// string regardless of skew direction or magnitude. Pins down INV-CHAT-119.
test eaf_06_opaque_error_display {
    const e_future = check_epoch(0, 1);
    const e_stale = check_epoch(100, 50);
    // Both error paths yield the same opaque error (null).
    assert(e_future == null);
    assert(e_stale == null);
    const s = opaque_error_display();
    assert(eql_str(s, "epoch authentication failed"), "EAF-06: Display string must be the canonical constant");
    assert(eql_str(opaque_error_display(), s), "EAF-06: Display must not leak skew");
}

/// **EAF-07** — symmetry of rejection: `check_epoch(a, b)` for `a != b`
/// outside the grace window is rejected whether `a > b + GRACE` or `b > a`.
test eaf_07_symmetric_rejection_outside_window {
    // Stale by 100:
    assert(check_epoch(200, 100) == null);
    // Future by 100:
    assert(check_epoch(100, 200) == null);
    // Stale by 100 vs future by 100 — same error (both null).
    assert(check_epoch(200, 100) == check_epoch(100, 200));
}

/// **EAF-08** — boundary scan: every offset in `[-GRACE-1, +1]` produces the
/// expected verdict.
test eaf_08_boundary_scan {
    const local: u64 = 50;
    // local-3 = 47 -> rejected (one beyond grace)
    assert(check_epoch(local, 47) == null);
    // local-2 = 48 -> WithinWindow
    assert(check_epoch(local, 48).? == .WithinWindow);
    // local-1 = 49 -> WithinWindow
    assert(check_epoch(local, 49).? == .WithinWindow);
    // local-0 = 50 -> Match
    assert(check_epoch(local, 50).? == .Match);
    // local+1 = 51 -> rejected (future)
    assert(check_epoch(local, 51) == null);
}

/// **EAF-09** — grace-window constant pinning: the public constant value must
/// remain 2. Regression-guards against a silent widening of the acceptance
/// window (which would make post-PCS-healing attacks easier).
test eaf_09_grace_window_constant {
    const expected: u64 = 2;
    assert(EPOCH_GRACE_WINDOW == expected, "EAF-09: EPOCH_GRACE_WINDOW must remain 2 for PCS safety");
}

/// **EAF-10** — green summary: all 10 EAF lane tests rejected / accepted as
/// specified.
test green_eaf_lane_summary {
    const count: usize = 10;
    assert(count == 10, "green: 10 L-CHAT-2-eaf falsifiers verified (EAF-01..10)");
}

pub fn main() void {
    eaf_01_exact_match();
    eaf_02_within_grace_window();
    eaf_03_just_stale_rejected();
    eaf_04_future_rejected_no_underflow();
    eaf_05_ancient_rejected_same_error();
    eaf_06_opaque_error_display();
    eaf_07_symmetric_rejection_outside_window();
    eaf_08_boundary_scan();
    eaf_09_grace_window_constant();
    green_eaf_lane_summary();
}
