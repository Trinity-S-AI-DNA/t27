// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/double_ratchet_chain_key_rotation_bound_guard.rs @ 8b229e9489ee (232 lines).
// Ring: CR-CHAT-02 (Wave-36 L-CHAT-2-drcb). Issue: gHashTag/t27#8882.
// Domain: RATCHET — chain key rotations without an intervening DH step are
// bounded (DRCB_MAX_ROTATIONS); batch size, session id sanity, and rotation
// counts are validated per record.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * ROTATION-BOUNDED`.
//
// Port decisions:
// * Error payloads (idx/got/max) lowered to bare variants
//   (?RotationBoundError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet duplicate-session tracking replaced by an O(n^2) scan over
//   earlier records (insertion order preserved, decision order unchanged:
//   batch size, zero session, zero rotations, duplicate, missing DH, bound).

module port::double_ratchet_chain_key_rotation_bound_guard;

/// Maximum chain key rotations without an intervening DH step.
pub const DRCB_MAX_ROTATIONS: u64 = 1000;
/// Maximum records per validation batch.
pub const DRCB_MAX_BATCH: usize = 1024;
/// Session id length.
pub const DRCB_SESSION_ID_LEN: usize = 32;

/// One per-session rotation record.
pub struct RotationRecord {
    session_id: [32]u8,
    rotations_since_dh: u64,
    dh_step_occurred: bool,
}

/// All ways rotation-bound validation can fail.
pub enum RotationBoundError {
    TooManyRotations,
    ZeroSessionId,
    DuplicateSessionId,
    ZeroRotations,
    FirstMissingDh,
    TooLarge,
}

fn zero32() [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) { out[i] = 0; i += 1; }
    return out;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn sid(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < DRCB_SESSION_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn rec(session: u8, rotations: u64, dh: bool) RotationRecord {
    return .{
        .session_id = sid(session),
        .rotations_since_dh = rotations,
        .dh_step_occurred = dh,
    };
}

/// `[VERIFIED]` Validate the chain-key rotation bound over a batch.
pub fn validate_rotation_bound(records: []RotationRecord) -> ?RotationBoundError {
    if (records.len > DRCB_MAX_BATCH) {
        return .TooLarge;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        // 1. zero session id
        if (eq32(r.session_id, zero32())) {
            return .ZeroSessionId;
        }
        // 2. zero rotations
        if (r.rotations_since_dh == 0) {
            return .ZeroRotations;
        }
        // 3. duplicate session id
        var j: usize = 0;
        while (j < i) {
            if (eq32(records[j].session_id, r.session_id)) {
                return .DuplicateSessionId;
            }
            j += 1;
        }
        // 4. first rotation must carry a DH step
        if (!r.dh_step_occurred) {
            return .FirstMissingDh;
        }
        // 5. rotation bound
        if (r.rotations_since_dh > DRCB_MAX_ROTATIONS) {
            return .TooManyRotations;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors drcb_01..drcb_10 in the Rust source)
// ---------------------------------------------------------------------------

test drcb_01_too_many_rejected {
    var rs: [1]RotationRecord = undefined;
    rs[0] = rec(0x01, DRCB_MAX_ROTATIONS + 1, true);
    const result = validate_rotation_bound(&rs);
    assert(result == .TooManyRotations);
}

test drcb_02_zero_session_rejected {
    var rs: [1]RotationRecord = undefined;
    rs[0] = .{ .session_id = sid(0), .rotations_since_dh = 10, .dh_step_occurred = true };
    const result = validate_rotation_bound(&rs);
    assert(result == .ZeroSessionId);
}

test drcb_03_duplicate_rejected {
    var rs: [2]RotationRecord = undefined;
    rs[0] = rec(0x01, 10, true);
    rs[1] = rec(0x01, 20, true);
    const result = validate_rotation_bound(&rs);
    assert(result == .DuplicateSessionId);
}

test drcb_04_zero_rotations_rejected {
    var rs: [1]RotationRecord = undefined;
    rs[0] = .{ .session_id = sid(0x01), .rotations_since_dh = 0, .dh_step_occurred = true };
    const result = validate_rotation_bound(&rs);
    assert(result == .ZeroRotations);
}

test drcb_05_missing_dh_rejected {
    var rs: [1]RotationRecord = undefined;
    rs[0] = .{ .session_id = sid(0x01), .rotations_since_dh = 10, .dh_step_occurred = false };
    const result = validate_rotation_bound(&rs);
    assert(result == .FirstMissingDh);
}

test drcb_06_too_large_rejected {
    var rs: [DRCB_MAX_BATCH + 1]RotationRecord = undefined;
    var i: usize = 0;
    while (i <= DRCB_MAX_BATCH) {
        const val: u64 = @intCast(i + 1);
        var s: [32]u8 = sid(0);
        s[0] = @intCast((val / 256) % 256);
        s[1] = @intCast(val % 256);
        rs[i] = .{ .session_id = s, .rotations_since_dh = 1, .dh_step_occurred = true };
        i += 1;
    }
    const result = validate_rotation_bound(&rs);
    assert(result == .TooLarge);
}

test drcb_07_valid_accepted {
    var rs: [3]RotationRecord = undefined;
    rs[0] = rec(0x01, 50, true);
    rs[1] = rec(0x02, 100, true);
    rs[2] = rec(0x03, 200, true);
    const result = validate_rotation_bound(&rs);
    assert(result == null);
}

test drcb_08_empty_accepted {
    var rs: [0]RotationRecord = undefined;
    const result = validate_rotation_bound(&rs);
    assert(result == null);
}

test drcb_09_boundary_accepted {
    var rs: [1]RotationRecord = undefined;
    rs[0] = rec(0x01, DRCB_MAX_ROTATIONS, true);
    const result = validate_rotation_bound(&rs);
    assert(result == null);
}

test drcb_10_many_sessions_accepted {
    var rs: [20]RotationRecord = undefined;
    var i: usize = 0;
    while (i < 20) {
        const idx: u8 = @intCast(i);
        rs[i] = rec(idx + 1, @as(u64, @intCast(i)) * 10 + 1, true);
        i += 1;
    }
    const result = validate_rotation_bound(&rs);
    assert(result == null);
}

pub fn main() void {
    drcb_01_too_many_rejected();
    drcb_02_zero_session_rejected();
    drcb_03_duplicate_rejected();
    drcb_04_zero_rotations_rejected();
    drcb_05_missing_dh_rejected();
    drcb_06_too_large_rejected();
    drcb_07_valid_accepted();
    drcb_08_empty_accepted();
    drcb_09_boundary_accepted();
    drcb_10_many_sessions_accepted();
}
