// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_derivation_context_label_guard.rs @ 8b229e9489ee (280 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — root-key derivation context labels must be unique,
// bounded (4..=64 bytes), and tied to non-zero, unique context ids.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * LABEL-UNIQUE`.
//
// Port decisions:
// * ContextLabelError payloads (idx, got, min, max) lowered to bare variants
//   (?ContextLabelError; null = Ok(())), per the ring-wide lowering decision.
// * Vec<u8> labels modeled as fixed (RKDL_MAX_LABEL_LEN + 1)-byte buffers +
//   label_len so the TooLong case (len == MAX + 1) is representable.
// * BTreeSet<[u8;16]> context ids and BTreeSet<&[u8]> labels replaced by
//   O(n^2) scans over earlier records; decision order preserved: batch bound,
//   zero context id, duplicate context id, too short, too long,
//   duplicate label.

module port::root_key_derivation_context_label_guard;

/// Minimum derivation context label length.
pub const RKDL_MIN_LABEL_LEN: usize = 4;

/// Maximum derivation context label length.
pub const RKDL_MAX_LABEL_LEN: usize = 64;

/// Maximum derivations per batch.
pub const RKDL_MAX_DERIVATIONS: usize = 256;

/// Context id length.
pub const RKDL_CONTEXT_ID_LEN: usize = 16;

/// One derivation context record.
pub struct DerivationContextRecord {
    context_id: [RKDL_CONTEXT_ID_LEN]u8,
    label: [RKDL_MAX_LABEL_LEN + 1]u8,
    label_len: usize,
}

/// All ways context-label validation can fail.
pub enum ContextLabelError {
    DuplicateLabel,
    TooShort,
    TooLong,
    ZeroContextId,
    DuplicateContextId,
    TooLarge,
}

pub fn cid(byte: u8) [RKDL_CONTEXT_ID_LEN]u8 {
    var out: [RKDL_CONTEXT_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKDL_CONTEXT_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn rec(id: u8, label: []const u8) DerivationContextRecord {
    var out: DerivationContextRecord = undefined;
    out.context_id = cid(id);
    out.label_len = label.len;
    var i: usize = 0;
    while (i < label.len) { out.label[i] = label[i]; i += 1; }
    return out;
}

pub fn valid_records() [3]DerivationContextRecord {
    var rs: [3]DerivationContextRecord = undefined;
    rs[0] = rec(0x01, "initial-root");
    rs[1] = rec(0x02, "dh-step");
    rs[2] = rec(0x03, "application");
    return rs;
}

fn eq_label(a: DerivationContextRecord, b: DerivationContextRecord) bool {
    if (a.label_len != b.label_len) { return false; }
    var i: usize = 0;
    while (i < a.label_len) {
        if (a.label[i] != b.label[i]) { return false; }
        i += 1;
    }
    return true;
}

fn eq_context(a: [RKDL_CONTEXT_ID_LEN]u8, b: [RKDL_CONTEXT_ID_LEN]u8) bool {
    var i: usize = 0;
    while (i < RKDL_CONTEXT_ID_LEN) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn zero_context() [RKDL_CONTEXT_ID_LEN]u8 {
    var out: [RKDL_CONTEXT_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKDL_CONTEXT_ID_LEN) { out[i] = 0; i += 1; }
    return out;
}

/// `[VERIFIED]` Validate derivation context labels.
pub fn validate_context_labels(records: []DerivationContextRecord) -> ?ContextLabelError {
    if (records.len > RKDL_MAX_DERIVATIONS) {
        return .TooLarge;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        // 1. non-zero context id
        if (eq_context(r.context_id, zero_context())) {
            return .ZeroContextId;
        }
        // 2. unique context id
        var j: usize = 0;
        while (j < i) {
            if (eq_context(records[j].context_id, r.context_id)) {
                return .DuplicateContextId;
            }
            j += 1;
        }
        // 3. label length bounds
        if (r.label_len < RKDL_MIN_LABEL_LEN) {
            return .TooShort;
        }
        if (r.label_len > RKDL_MAX_LABEL_LEN) {
            return .TooLong;
        }
        // 4. unique label
        j = 0;
        while (j < i) {
            if (eq_label(records[j], r)) {
                return .DuplicateLabel;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rkdl_01..rkdl_10 in the Rust source)
// ---------------------------------------------------------------------------

test rkdl_01_duplicate_label_rejected {
    var rs: [2]DerivationContextRecord = undefined;
    rs[0] = rec(0x01, "initial-root");
    rs[1] = rec(0x02, "initial-root");
    const result = validate_context_labels(&rs);
    assert(result == .DuplicateLabel);
}

test rkdl_02_too_short_rejected {
    var rs: [1]DerivationContextRecord = undefined;
    rs[0] = rec(0x01, "ab");
    const result = validate_context_labels(&rs);
    assert(result == .TooShort);
}

test rkdl_03_too_long_rejected {
    var r: DerivationContextRecord = rec(0x01, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
    const result = validate_context_labels(&[r]);
    assert(result == .TooLong);
}

test rkdl_04_zero_context_rejected {
    var r: DerivationContextRecord = rec(0x00, "test-label");
    r.context_id = cid(0);
    const result = validate_context_labels(&[r]);
    assert(result == .ZeroContextId);
}

test rkdl_05_duplicate_context_rejected {
    var rs: [2]DerivationContextRecord = undefined;
    rs[0] = rec(0x01, "label-a");
    rs[1] = rec(0x01, "label-b");
    const result = validate_context_labels(&rs);
    assert(result == .DuplicateContextId);
}

test rkdl_06_too_large_rejected {
    var rs: [RKDL_MAX_DERIVATIONS + 1]DerivationContextRecord = undefined;
    var i: usize = 0;
    while (i <= RKDL_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var id: [RKDL_CONTEXT_ID_LEN]u8 = cid(0);
        id[6] = @intCast((val / 256) % 256);
        id[7] = @intCast(val % 256);
        var label: [RKDL_MAX_LABEL_LEN + 1]u8 = undefined;
        label[0] = 'l';
        label[1] = 'b';
        label[2] = 'l';
        label[3] = '-';
        label[4] = 0;
        label[5] = 0;
        label[6] = @intCast((val / 256) % 256);
        label[7] = @intCast(val % 256);
        rs[i] = .{ .context_id = id, .label = label, .label_len = 8 };
        i += 1;
    }
    const result = validate_context_labels(&rs);
    assert(result == .TooLarge);
}

test rkdl_07_valid_accepted {
    var rs = valid_records();
    const result = validate_context_labels(&rs);
    assert(result == null);
}

test rkdl_08_empty_accepted {
    var rs: [0]DerivationContextRecord = undefined;
    const result = validate_context_labels(&rs);
    assert(result == null);
}

test rkdl_09_boundary_label_accepted {
    var rs: [1]DerivationContextRecord = undefined;
    rs[0] = rec(0x01, "xxxx");
    const result = validate_context_labels(&rs);
    assert(result == null);
}

test rkdl_10_many_unique_accepted {
    var rs: [20]DerivationContextRecord = undefined;
    var i: usize = 0;
    while (i < 20) {
        const val: u8 = @intCast(i);
        var label: [RKDL_MAX_LABEL_LEN + 1]u8 = undefined;
        label[0] = 'l';
        label[1] = 'x';
        label[2] = val;
        label[3] = val + 0x20;
        rs[i] = rec(@intCast(i + 1), "prefix");
        rs[i].label = label;
        rs[i].label_len = 4;
        i += 1;
    }
    const result = validate_context_labels(&rs);
    assert(result == null);
}

pub fn main() void {
    rkdl_01_duplicate_label_rejected();
    rkdl_02_too_short_rejected();
    rkdl_03_too_long_rejected();
    rkdl_04_zero_context_rejected();
    rkdl_05_duplicate_context_rejected();
    rkdl_06_too_large_rejected();
    rkdl_07_valid_accepted();
    rkdl_08_empty_accepted();
    rkdl_09_boundary_label_accepted();
    rkdl_10_many_unique_accepted();
}
