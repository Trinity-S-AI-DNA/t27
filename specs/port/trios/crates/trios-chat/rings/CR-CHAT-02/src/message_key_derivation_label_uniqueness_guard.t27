// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/message_key_derivation_label_uniqueness_guard.rs @ 8b229e9489ee (236 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — derivation labels must be unique per chain and
// within length bounds; chains, labels, and key hashes must be non-zero.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * LABEL-UNIQUE`.
//
// Port decisions:
// * LabelUniquenessError payloads (idx, got, max) lowered to bare variants
//   (?LabelUniquenessError; null = Ok(())), per the ring-wide lowering
//   decision. Indices are reconstructable from the failing input prefix.
// * String labels modeled as fixed (MKDL_MAX_LABEL_LEN + 1)-byte buffers +
//   label_len, so the too-long error (len == MAX + 1) stays representable.
// * BTreeSet<(chain_id, label)> duplicate tracking replaced by an O(n^2)
//   scan over earlier records; decision order preserved: batch bound, zero
//   chain id, empty label, label length, zero key hash, duplicate label.

module port::message_key_derivation_label_uniqueness_guard;

/// Maximum label length.
pub const MKDL_MAX_LABEL_LEN: usize = 128;

/// Maximum derivations per validation batch.
pub const MKDL_MAX_DERIVATIONS: usize = 1024;

/// Chain id length.
pub const MKDL_CHAIN_ID_LEN: usize = 32;

/// Key hash length.
pub const MKDL_HASH_LEN: usize = 32;

/// One labeled key derivation.
pub struct DerivationLabel {
    chain_id: [MKDL_CHAIN_ID_LEN]u8,
    label: [MKDL_MAX_LABEL_LEN + 1]u8,
    label_len: usize,
    key_hash: [MKDL_HASH_LEN]u8,
}

/// All ways label validation can fail.
pub enum LabelUniquenessError {
    DuplicateLabel,
    EmptyLabel,
    ZeroChainId,
    ZeroKeyHash,
    LabelTooLong,
    TooMany,
}

fn eq_n(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) { return false; }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn cid(byte: u8) [MKDL_CHAIN_ID_LEN]u8 {
    var out: [MKDL_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < MKDL_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn khash(byte: u8) [MKDL_HASH_LEN]u8 {
    var out: [MKDL_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < MKDL_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

fn repeat_label(byte: u8, len: usize) [MKDL_MAX_LABEL_LEN + 1]u8 {
    var out: [MKDL_MAX_LABEL_LEN + 1]u8 = undefined;
    var i: usize = 0;
    while (i < len) { out[i] = byte; i += 1; }
    return out;
}

pub fn deriv(chain: u8, label: []const u8, key: u8) DerivationLabel {
    var buf: [MKDL_MAX_LABEL_LEN + 1]u8 = repeat_label(0, 0);
    var i: usize = 0;
    while (i < label.len and i <= MKDL_MAX_LABEL_LEN) {
        buf[i] = label[i];
        i += 1;
    }
    return .{ .chain_id = cid(chain), .label = buf, .label_len = label.len, .key_hash = khash(key) };
}

/// `[VERIFIED]` Validate derivation labels.
pub fn validate_label_uniqueness(derivations: []DerivationLabel) -> ?LabelUniquenessError {
    if (derivations.len > MKDL_MAX_DERIVATIONS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < derivations.len) {
        const d = derivations[i];
        // 1. zero chain id
        if (eq_n(&d.chain_id, &cid(0))) {
            return .ZeroChainId;
        }
        // 2. empty label
        if (d.label_len == 0) {
            return .EmptyLabel;
        }
        // 3. label length bound
        if (d.label_len > MKDL_MAX_LABEL_LEN) {
            return .LabelTooLong;
        }
        // 4. zero key hash
        if (eq_n(&d.key_hash, &khash(0))) {
            return .ZeroKeyHash;
        }
        // 5. duplicate (chain_id, label) pair
        var j: usize = 0;
        while (j < i) {
            if (eq_n(&derivations[j].chain_id, &d.chain_id) and
                derivations[j].label_len == d.label_len and
                eq_n(derivations[j].label[0..d.label_len], d.label[0..d.label_len]))
            {
                return .DuplicateLabel;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors mkdl_01..mkdl_10 in the Rust source)
// ---------------------------------------------------------------------------

test mkdl_01_duplicate_rejected {
    var ds: [2]DerivationLabel = undefined;
    ds[0] = deriv(0x01, "msg-0", 0xA1);
    ds[1] = deriv(0x01, "msg-0", 0xA2);
    const result = validate_label_uniqueness(&ds);
    assert(result == .DuplicateLabel);
}

test mkdl_02_empty_label_rejected {
    var ds: [1]DerivationLabel = undefined;
    ds[0] = deriv(0x01, "", 0xAA);
    const result = validate_label_uniqueness(&ds);
    assert(result == .EmptyLabel);
}

test mkdl_03_zero_chain_rejected {
    var ds: [1]DerivationLabel = undefined;
    ds[0] = deriv(0x00, "msg", 0xAA);
    const result = validate_label_uniqueness(&ds);
    assert(result == .ZeroChainId);
}

test mkdl_04_zero_hash_rejected {
    var ds: [1]DerivationLabel = undefined;
    ds[0] = deriv(0x01, "msg", 0x00);
    const result = validate_label_uniqueness(&ds);
    assert(result == .ZeroKeyHash);
}

test mkdl_05_label_too_long_rejected {
    var ds: [1]DerivationLabel = undefined;
    ds[0] = deriv(0x01, repeat_label('x', MKDL_MAX_LABEL_LEN + 1)[0..MKDL_MAX_LABEL_LEN + 1], 0xAA);
    const result = validate_label_uniqueness(&ds);
    assert(result == .LabelTooLong);
}

test mkdl_06_too_many_rejected {
    var ds: [MKDL_MAX_DERIVATIONS + 1]DerivationLabel = undefined;
    var i: usize = 0;
    while (i <= MKDL_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var c = cid(0);
        c[0] = @intCast((val / 256) % 256);
        c[1] = @intCast(val % 256);
        var label: [MKDL_MAX_LABEL_LEN + 1]u8 = repeat_label(0, 0);
        label[0] = @intCast(i % 256);
        label[1] = @intCast((i / 256) % 256);
        label[2] = 'm';
        label[3] = 'g';
        ds[i] = .{ .chain_id = c, .label = label, .label_len = 4, .key_hash = khash(@intCast((i % 255) + 1)) };
        i += 1;
    }
    const result = validate_label_uniqueness(&ds);
    assert(result == .TooMany);
}

test mkdl_07_valid_accepted {
    var ds: [4]DerivationLabel = undefined;
    ds[0] = deriv(0x01, "msg-0", 0xA1);
    ds[1] = deriv(0x01, "msg-1", 0xA2);
    ds[2] = deriv(0x01, "msg-2", 0xA3);
    ds[3] = deriv(0x02, "msg-0", 0xA4);
    const result = validate_label_uniqueness(&ds);
    assert(result == null);
}

test mkdl_08_empty_accepted {
    var ds: [0]DerivationLabel = undefined;
    const result = validate_label_uniqueness(&ds);
    assert(result == null);
}

test mkdl_09_same_label_diff_chain_accepted {
    var ds: [2]DerivationLabel = undefined;
    ds[0] = deriv(0x01, "msg-0", 0xA1);
    ds[1] = deriv(0x02, "msg-0", 0xA2);
    const result = validate_label_uniqueness(&ds);
    assert(result == null);
}

test mkdl_10_boundary_label_accepted {
    var ds: [1]DerivationLabel = undefined;
    ds[0] = deriv(0x01, repeat_label('x', MKDL_MAX_LABEL_LEN)[0..MKDL_MAX_LABEL_LEN], 0xAA);
    const result = validate_label_uniqueness(&ds);
    assert(result == null);
}

pub fn main() void {
    mkdl_01_duplicate_rejected();
    mkdl_02_empty_label_rejected();
    mkdl_03_zero_chain_rejected();
    mkdl_04_zero_hash_rejected();
    mkdl_05_label_too_long_rejected();
    mkdl_06_too_many_rejected();
    mkdl_07_valid_accepted();
    mkdl_08_empty_accepted();
    mkdl_09_same_label_diff_chain_accepted();
    mkdl_10_boundary_label_accepted();
}
