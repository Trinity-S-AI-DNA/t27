// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/sending_chain_advancement_limit_guard.rs @ 8b229e9489ee (237 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — sending-chain advancement counts must be bounded
// (<= 1000), strictly monotonic across records, unique per chain, and the
// batch is capped at 10_000 advances.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * CHAIN-LIMIT`.
//
// Port decisions:
// * ChainAdvanceError payloads (idx, steps, prev, current, got, max) lowered
//   to bare variants (?ChainAdvanceError; null = Ok(())), per the ring-wide
//   lowering decision.
// * BTreeSet<[u8; 16]> replaced by an O(n^2) scan over earlier records,
//   per the ring-wide seen-set decision.
// * Decision order preserved: batch bound, zero chain id, zero steps, steps
//   bound, monotonicity, duplicate chain.

module port::sending_chain_advancement_limit_guard;

/// Maximum number of sending-chain steps in one record.
pub const SCAL_MAX_STEPS: u64 = 1000;

/// Maximum advances per batch.
pub const SCAL_MAX_ADVANCES: usize = 10_000;

/// Length of a chain id.
pub const SCAL_CHAIN_ID_LEN: usize = 16;

/// One chain-advance record.
pub struct ChainAdvance {
    chain_id: [SCAL_CHAIN_ID_LEN]u8,
    steps_since_dh: u64,
}

/// All ways chain-advance validation can fail.
pub enum ChainAdvanceError {
    TooManySteps,
    NotMonotonic,
    TooManyAdvances,
    ZeroChainId,
    DuplicateChain,
    ZeroSteps,
}

pub fn cid(byte: u8) [SCAL_CHAIN_ID_LEN]u8 {
    var out: [SCAL_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCAL_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn advance(chain_byte: u8, steps: u64) ChainAdvance {
    return .{ .chain_id = cid(chain_byte), .steps_since_dh = steps };
}

pub fn valid_advances() [3]ChainAdvance {
    var ads: [3]ChainAdvance = undefined;
    ads[0] = advance(0x01, 10);
    ads[1] = advance(0x02, 50);
    ads[2] = advance(0x03, 100);
    return ads;
}

fn is_zero(buf: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (buf[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

fn eq16(a: [16]u8, b: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate a batch of sending-chain advances.
pub fn validate_chain_advances(advances: []ChainAdvance) -> ?ChainAdvanceError {
    if (advances.len > SCAL_MAX_ADVANCES) {
        return .TooManyAdvances;
    }
    var prev_steps: u64 = 0;
    var i: usize = 0;
    while (i < advances.len) {
        const a = advances[i];
        if (is_zero(a.chain_id)) {
            return .ZeroChainId;
        }
        if (a.steps_since_dh == 0) {
            return .ZeroSteps;
        }
        if (a.steps_since_dh > SCAL_MAX_STEPS) {
            return .TooManySteps;
        }
        if (i > 0 and a.steps_since_dh <= prev_steps) {
            return .NotMonotonic;
        }
        var j: usize = 0;
        while (j < i) {
            if (eq16(advances[j].chain_id, a.chain_id)) {
                return .DuplicateChain;
            }
            j += 1;
        }
        prev_steps = a.steps_since_dh;
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors scal_01..scal_10 in the Rust source)
// ---------------------------------------------------------------------------

test scal_01_too_many_steps_rejected {
    var ads: [1]ChainAdvance = undefined;
    ads[0] = advance(0x01, SCAL_MAX_STEPS + 1);
    const result = validate_chain_advances(&ads);
    assert(result == .TooManySteps);
}

test scal_02_not_monotonic_rejected {
    var ads: [2]ChainAdvance = undefined;
    ads[0] = advance(0x01, 50);
    ads[1] = advance(0x02, 30);
    const result = validate_chain_advances(&ads);
    assert(result == .NotMonotonic);
}

test scal_03_too_many_rejected {
    var ads: [SCAL_MAX_ADVANCES + 1]ChainAdvance = undefined;
    var i: usize = 0;
    while (i <= SCAL_MAX_ADVANCES) {
        const b: u8 = @intCast((i % 254) + 1);
        ads[i] = advance(b, @intCast(i + 1));
        i += 1;
    }
    const result = validate_chain_advances(&ads);
    assert(result == .TooManyAdvances);
}

test scal_04_zero_chain_rejected {
    var ads: [1]ChainAdvance = undefined;
    ads[0] = .{ .chain_id = cid(0), .steps_since_dh = 5 };
    const result = validate_chain_advances(&ads);
    assert(result == .ZeroChainId);
}

test scal_05_duplicate_rejected {
    var ads: [2]ChainAdvance = undefined;
    ads[0] = advance(0x01, 10);
    ads[1] = advance(0x01, 20);
    const result = validate_chain_advances(&ads);
    assert(result == .DuplicateChain);
}

test scal_06_zero_steps_rejected {
    var ads: [1]ChainAdvance = undefined;
    ads[0] = advance(0x01, 0);
    const result = validate_chain_advances(&ads);
    assert(result == .ZeroSteps);
}

test scal_07_valid_accepted {
    var ads = valid_advances();
    const result = validate_chain_advances(&ads);
    assert(result == null);
}

test scal_08_empty_accepted {
    var ads: [0]ChainAdvance = undefined;
    const result = validate_chain_advances(&ads);
    assert(result == null);
}

test scal_09_max_steps_accepted {
    var ads: [1]ChainAdvance = undefined;
    ads[0] = advance(0x01, SCAL_MAX_STEPS);
    const result = validate_chain_advances(&ads);
    assert(result == null);
}

test scal_10_equal_steps_rejected {
    var ads: [2]ChainAdvance = undefined;
    ads[0] = advance(0x01, 50);
    ads[1] = advance(0x02, 50);
    const result = validate_chain_advances(&ads);
    assert(result == .NotMonotonic);
}

pub fn main() void {
    scal_01_too_many_steps_rejected();
    scal_02_not_monotonic_rejected();
    scal_03_too_many_rejected();
    scal_04_zero_chain_rejected();
    scal_05_duplicate_rejected();
    scal_06_zero_steps_rejected();
    scal_07_valid_accepted();
    scal_08_empty_accepted();
    scal_09_max_steps_accepted();
    scal_10_equal_steps_rejected();
}
