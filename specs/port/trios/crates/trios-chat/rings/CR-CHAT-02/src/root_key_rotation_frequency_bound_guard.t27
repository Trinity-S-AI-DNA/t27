// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_rotation_frequency_bound_guard.rs @ 8b229e9489ee (262 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — root-key rotations must be unique, non-zero,
// epoch-monotonic, and at most one per RKRF_MAX_INTERVAL_MS window.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * ROTATION-FREQ`.
//
// Port decisions:
// * RotationFrequencyError payloads (idx, gap_ms, max_ms, prev, got)
//   lowered to bare variants (?RotationFrequencyError; null = Ok(())), per
//   the ring-wide lowering decision.
// * Option<u64> prev_epoch / prev_ts tracking modeled as has_prev flags
//   plus u64 slots, per the ring-wide Option lowering decision.
// * BTreeSet<[u8; 16]> rotation ids replaced by an O(n^2) scan over earlier
//   records; decision order preserved: batch bound, zero rotation id,
//   duplicate id, zero timestamp, non-monotonic epoch, interval bound.
// * saturating_sub on timestamps modeled as an explicit > test before
//   subtraction.

module port::root_key_rotation_frequency_bound_guard;

/// Maximum milliseconds between root-key rotations.
pub const RKRF_MAX_INTERVAL_MS: u64 = 3_600_000;

/// Maximum rotations per batch.
pub const RKRF_MAX_ROTATIONS: usize = 512;

/// Rotation id length.
pub const RKRF_ROTATION_ID_LEN: usize = 16;

/// One root-key rotation record.
pub struct RotationRecord {
    rotation_id: [RKRF_ROTATION_ID_LEN]u8,
    epoch: u64,
    timestamp_ms: u64,
}

/// All ways rotation-frequency validation can fail.
pub enum RotationFrequencyError {
    IntervalTooLarge,
    NonMonotonicEpoch,
    ZeroRotationId,
    DuplicateRotationId,
    ZeroTimestamp,
    TooMany,
}

pub fn rid(byte: u8) [RKRF_ROTATION_ID_LEN]u8 {
    var out: [RKRF_ROTATION_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKRF_ROTATION_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn rot(id: u8, epoch: u64, ts: u64) RotationRecord {
    return .{ .rotation_id = rid(id), .epoch = epoch, .timestamp_ms = ts };
}

pub fn valid_rotations() [3]RotationRecord {
    var rs: [3]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 1_000_000);
    rs[1] = rot(0x02, 2, 1_600_000);
    rs[2] = rot(0x03, 3, 2_200_000);
    return rs;
}

fn zero_id() [RKRF_ROTATION_ID_LEN]u8 {
    var out: [RKRF_ROTATION_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKRF_ROTATION_ID_LEN) { out[i] = 0; i += 1; }
    return out;
}

fn eq16(a: [16]u8, b: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate root-key rotation frequency.
pub fn validate_rotation_frequency(rotations: []RotationRecord) -> ?RotationFrequencyError {
    if (rotations.len > RKRF_MAX_ROTATIONS) {
        return .TooMany;
    }
    var has_prev_epoch = false;
    var prev_epoch: u64 = 0;
    var has_prev_ts = false;
    var prev_ts: u64 = 0;
    var i: usize = 0;
    while (i < rotations.len) {
        const r = rotations[i];
        // 1. non-zero rotation id
        if (eq16(r.rotation_id, zero_id())) {
            return .ZeroRotationId;
        }
        // 2. unique rotation id
        var j: usize = 0;
        while (j < i) {
            if (eq16(rotations[j].rotation_id, r.rotation_id)) {
                return .DuplicateRotationId;
            }
            j += 1;
        }
        // 3. non-zero timestamp
        if (r.timestamp_ms == 0) {
            return .ZeroTimestamp;
        }
        // 4. strictly increasing epoch
        if (has_prev_epoch) {
            if (r.epoch <= prev_epoch) {
                return .NonMonotonicEpoch;
            }
        }
        // 5. bounded rotation interval
        if (has_prev_ts) {
            if (r.timestamp_ms > prev_ts and r.timestamp_ms - prev_ts > RKRF_MAX_INTERVAL_MS) {
                return .IntervalTooLarge;
            }
        }
        has_prev_epoch = true;
        prev_epoch = r.epoch;
        has_prev_ts = true;
        prev_ts = r.timestamp_ms;
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rkrf_01..rkrf_10 in the Rust source)
// ---------------------------------------------------------------------------

test rkrf_01_interval_too_large_rejected {
    var rs: [2]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 1_000_000);
    rs[1] = rot(0x02, 2, 5_000_000);
    const result = validate_rotation_frequency(&rs);
    assert(result == .IntervalTooLarge);
}

test rkrf_02_non_monotonic_rejected {
    var rs: [2]RotationRecord = undefined;
    rs[0] = rot(0x01, 2, 1_000_000);
    rs[1] = rot(0x02, 1, 1_600_000);
    const result = validate_rotation_frequency(&rs);
    assert(result == .NonMonotonicEpoch);
}

test rkrf_03_zero_id_rejected {
    var r: RotationRecord = rot(0x01, 1, 1_000_000);
    r.rotation_id = rid(0);
    const result = validate_rotation_frequency(&[r]);
    assert(result == .ZeroRotationId);
}

test rkrf_04_duplicate_rejected {
    var rs: [2]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 1_000_000);
    rs[1] = rot(0x01, 2, 1_600_000);
    const result = validate_rotation_frequency(&rs);
    assert(result == .DuplicateRotationId);
}

test rkrf_05_zero_ts_rejected {
    var rs: [1]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 0);
    const result = validate_rotation_frequency(&rs);
    assert(result == .ZeroTimestamp);
}

test rkrf_06_too_many_rejected {
    var rs: [RKRF_MAX_ROTATIONS + 1]RotationRecord = undefined;
    var i: usize = 0;
    while (i <= RKRF_MAX_ROTATIONS) {
        const val: u64 = @intCast(i + 1);
        var id: [RKRF_ROTATION_ID_LEN]u8 = rid(0);
        id[6] = @intCast((val / 256) % 256);
        id[7] = @intCast(val % 256);
        rs[i] = .{ .rotation_id = id, .epoch = val, .timestamp_ms = val * 600_000 };
        i += 1;
    }
    const result = validate_rotation_frequency(&rs);
    assert(result == .TooMany);
}

test rkrf_07_valid_accepted {
    var rs = valid_rotations();
    const result = validate_rotation_frequency(&rs);
    assert(result == null);
}

test rkrf_08_empty_accepted {
    var rs: [0]RotationRecord = undefined;
    const result = validate_rotation_frequency(&rs);
    assert(result == null);
}

test rkrf_09_single_accepted {
    var rs: [1]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 1_000_000);
    const result = validate_rotation_frequency(&rs);
    assert(result == null);
}

test rkrf_10_boundary_interval_accepted {
    var rs: [2]RotationRecord = undefined;
    rs[0] = rot(0x01, 1, 1_000_000);
    rs[1] = rot(0x02, 2, 1_000_000 + RKRF_MAX_INTERVAL_MS);
    const result = validate_rotation_frequency(&rs);
    assert(result == null);
}

pub fn main() void {
    rkrf_01_interval_too_large_rejected();
    rkrf_02_non_monotonic_rejected();
    rkrf_03_zero_id_rejected();
    rkrf_04_duplicate_rejected();
    rkrf_05_zero_ts_rejected();
    rkrf_06_too_many_rejected();
    rkrf_07_valid_accepted();
    rkrf_08_empty_accepted();
    rkrf_09_single_accepted();
    rkrf_10_boundary_interval_accepted();
}
