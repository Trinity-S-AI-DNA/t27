// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/message_key_commitment_binding_guard.rs @ 8b229e9489ee (225 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane A). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — message-key commitments must bind the chain index
// to the derived root hash; hashes must match, be non-zero, indices must
// strictly increase, and (hash, index) pairs must be unique.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * MSG-KEY-COMMIT`.
//
// Port decisions:
// * CommitmentError payloads (chain_index, expected/got) lowered to bare
//   variants (?CommitmentError; null = Ok(())), per the ring-wide lowering
//   decision. Indices are reconstructable from the failing input prefix.
// * BTreeSet<(hash, index)> duplicate tracking replaced by an O(n^2) scan
//   over earlier records; decision order preserved: batch bound, zero hash,
//   hash mismatch, duplicate, index monotonicity.

module port::message_key_commitment_binding_guard;

/// Maximum commitments per validation batch.
pub const MKCB_MAX_COMMITMENTS: usize = 4096;
/// Hash length.
pub const MKCB_HASH_LEN: usize = 32;

/// One message-key commitment.
pub struct MsgKeyCommitment {
    root_key_hash: [32]u8,
    chain_index: u64,
    computed_root_hash: [32]u8,
}

/// All ways commitment validation can fail.
pub enum CommitmentError {
    HashMismatch,
    IndexMismatch,
    Duplicate,
    TooManyCommitments,
    IndexNotIncreasing,
    ZeroHash,
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn zero32() [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) { out[i] = 0; i += 1; }
    return out;
}

pub fn hash(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < MKCB_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn commitment(index: u64, hash_byte: u8) MsgKeyCommitment {
    const h = hash(hash_byte);
    return .{ .root_key_hash = h, .chain_index = index, .computed_root_hash = h };
}

/// `[VERIFIED]` Validate message-key commitments.
pub fn validate_msg_key_commitments(commitments: []MsgKeyCommitment) -> ?CommitmentError {
    if (commitments.len > MKCB_MAX_COMMITMENTS) {
        return .TooManyCommitments;
    }
    var i: usize = 0;
    while (i < commitments.len) {
        const c = commitments[i];
        // 1. zero hash
        if (eq32(c.root_key_hash, zero32())) {
            return .ZeroHash;
        }
        // 2. hash mismatch
        if (!eq32(c.root_key_hash, c.computed_root_hash)) {
            return .HashMismatch;
        }
        // 3. duplicate (hash, index) pair
        var j: usize = 0;
        while (j < i) {
            if (commitments[j].chain_index == c.chain_index and
                eq32(commitments[j].root_key_hash, c.root_key_hash))
            {
                return .Duplicate;
            }
            j += 1;
        }
        // 4. strictly increasing chain index
        if (i > 0 and c.chain_index <= commitments[i - 1].chain_index) {
            return .IndexNotIncreasing;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors mkcb_01..mkcb_10 in the Rust source)
// ---------------------------------------------------------------------------

test mkcb_01_hash_mismatch_rejected {
    var cs: [1]MsgKeyCommitment = undefined;
    cs[0] = .{ .root_key_hash = hash(0xAA), .chain_index = 1, .computed_root_hash = hash(0xBB) };
    const result = validate_msg_key_commitments(&cs);
    assert(result == .HashMismatch);
}

test mkcb_02_duplicate_rejected {
    const h = hash(0xAA);
    var cs: [3]MsgKeyCommitment = undefined;
    cs[0] = .{ .root_key_hash = h, .chain_index = 1, .computed_root_hash = h };
    cs[1] = .{ .root_key_hash = h, .chain_index = 2, .computed_root_hash = h };
    cs[2] = .{ .root_key_hash = h, .chain_index = 2, .computed_root_hash = h };
    const result = validate_msg_key_commitments(&cs);
    assert(result == .Duplicate);
}

test mkcb_03_too_many_rejected {
    var cs: [MKCB_MAX_COMMITMENTS + 1]MsgKeyCommitment = undefined;
    var i: usize = 0;
    while (i <= MKCB_MAX_COMMITMENTS) {
        const val: u64 = @intCast(i);
        var h = hash(0);
        h[0] = @intCast(val % 256);
        h[1] = @intCast((val / 256) % 256);
        h[8] = 0x01;
        cs[i] = .{ .root_key_hash = h, .chain_index = val, .computed_root_hash = h };
        i += 1;
    }
    const result = validate_msg_key_commitments(&cs);
    assert(result == .TooManyCommitments);
}

test mkcb_04_index_not_increasing_rejected {
    var cs: [2]MsgKeyCommitment = undefined;
    cs[0] = commitment(3, 0xAA);
    cs[1] = commitment(2, 0xBB);
    const result = validate_msg_key_commitments(&cs);
    assert(result == .IndexNotIncreasing);
}

test mkcb_05_zero_hash_rejected {
    var cs: [1]MsgKeyCommitment = undefined;
    cs[0] = .{ .root_key_hash = zero32(), .chain_index = 1, .computed_root_hash = zero32() };
    const result = validate_msg_key_commitments(&cs);
    assert(result == .ZeroHash);
}

test mkcb_06_index_mismatch_rejected {
    var cs: [3]MsgKeyCommitment = undefined;
    cs[0] = commitment(1, 0xAA);
    cs[1] = commitment(2, 0xAA);
    cs[2] = commitment(3, 0xBB);
    const result = validate_msg_key_commitments(&cs);
    assert(result == null);
}

test mkcb_07_valid_accepted {
    var cs: [3]MsgKeyCommitment = undefined;
    cs[0] = commitment(1, 0xAA);
    cs[1] = commitment(2, 0xAA);
    cs[2] = commitment(3, 0xBB);
    const result = validate_msg_key_commitments(&cs);
    assert(result == null);
}

test mkcb_08_empty_accepted {
    var cs: [0]MsgKeyCommitment = undefined;
    const result = validate_msg_key_commitments(&cs);
    assert(result == null);
}

test mkcb_09_single_accepted {
    var cs: [1]MsgKeyCommitment = undefined;
    cs[0] = commitment(1, 0xFF);
    const result = validate_msg_key_commitments(&cs);
    assert(result == null);
}

test mkcb_10_same_root_diff_index_accepted {
    var cs: [2]MsgKeyCommitment = undefined;
    cs[0] = commitment(1, 0xAA);
    cs[1] = commitment(2, 0xAA);
    const result = validate_msg_key_commitments(&cs);
    assert(result == null);
}

pub fn main() void {
    mkcb_01_hash_mismatch_rejected();
    mkcb_02_duplicate_rejected();
    mkcb_03_too_many_rejected();
    mkcb_04_index_not_increasing_rejected();
    mkcb_05_zero_hash_rejected();
    mkcb_06_index_mismatch_rejected();
    mkcb_07_valid_accepted();
    mkcb_08_empty_accepted();
    mkcb_09_single_accepted();
    mkcb_10_same_root_diff_index_accepted();
}
