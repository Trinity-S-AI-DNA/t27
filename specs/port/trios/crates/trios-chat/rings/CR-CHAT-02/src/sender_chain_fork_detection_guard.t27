// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/sender_chain_fork_detection_guard.rs @ 8b229e9489ee (209 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — per-(epoch, sender) chain keys must be unique:
// two different keys for one sender in one epoch is a chain fork.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * SENDER-CHAIN-FORK`.
//
// Port decisions:
// * ChainForkError payloads (idx, epoch, sender, got, max, len) lowered to
//   bare variants (?ChainForkError; null = Ok(())), per the ring-wide
//   lowering decision.
// * Entry tuples (u64, u32, &[u8]) modeled as a fixed struct: 32-byte key
//   buffer plus key_len so the wrong-length case (16-byte key) stays
//   representable, per the ring-wide fixed-buffer decision.
// * BTreeMap<(u64, u32), Vec<u8>> replaced by an O(n^2) scan over earlier
//   entries; decision order preserved: batch bound, zero epoch, sender
//   bounds, key length, zero key, fork detection on conflicting keys.

module port::sender_chain_fork_detection_guard;

/// Maximum number of senders tracked per epoch.
pub const SCFD_MAX_SENDERS: u32 = 256;

/// Length of a sender chain key.
pub const SCFD_KEY_LEN: usize = 32;

/// Maximum entries per batch.
pub const SCFD_MAX_ENTRIES: usize = 1024;

/// One (epoch, sender, chain key) entry.
pub struct SenderChainEntry {
    epoch: u64,
    sender: u32,
    key: [SCFD_KEY_LEN]u8,
    key_len: usize,
}

/// All ways chain-fork detection can fail.
pub enum ChainForkError {
    ForkDetected,
    ZeroEpoch,
    SenderOutOfBounds,
    KeyLengthWrong,
    ZeroKey,
    TooManyEntries,
}

pub fn key(byte: u8) [SCFD_KEY_LEN]u8 {
    var out: [SCFD_KEY_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCFD_KEY_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn entry(epoch: u64, sender: u32, k: [SCFD_KEY_LEN]u8) SenderChainEntry {
    return .{ .epoch = epoch, .sender = sender, .key = k, .key_len = SCFD_KEY_LEN };
}

pub fn valid_entries() [3]SenderChainEntry {
    var es: [3]SenderChainEntry = undefined;
    es[0] = entry(1, 0, key(0x01));
    es[1] = entry(1, 1, key(0x02));
    es[2] = entry(2, 0, key(0x03));
    return es;
}

fn eq_key(e: SenderChainEntry, k: [SCFD_KEY_LEN]u8, k_len: usize) bool {
    if (e.key_len != k_len) { return false; }
    var i: usize = 0;
    while (i < k_len) {
        if (e.key[i] != k[i]) { return false; }
        i += 1;
    }
    return true;
}

fn is_zero_key(e: SenderChainEntry) bool {
    var i: usize = 0;
    while (i < e.key_len) {
        if (e.key[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Detect sender chain forks.
pub fn detect_chain_fork(entries: []SenderChainEntry) -> ?ChainForkError {
    if (entries.len > SCFD_MAX_ENTRIES) {
        return .TooManyEntries;
    }
    var i: usize = 0;
    while (i < entries.len) {
        const e = entries[i];
        // 1. non-zero epoch
        if (e.epoch == 0) {
            return .ZeroEpoch;
        }
        // 2. sender in bounds
        if (e.sender >= SCFD_MAX_SENDERS) {
            return .SenderOutOfBounds;
        }
        // 3. canonical key length
        if (e.key_len != SCFD_KEY_LEN) {
            return .KeyLengthWrong;
        }
        // 4. non-zero key
        if (is_zero_key(e)) {
            return .ZeroKey;
        }
        // 5. fork detection: same (epoch, sender) with a different key
        var j: usize = 0;
        while (j < i) {
            if (entries[j].epoch == e.epoch and entries[j].sender == e.sender) {
                if (!eq_key(entries[j], e.key, e.key_len)) {
                    return .ForkDetected;
                }
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors scfd_01..scfd_10 in the Rust source)
// ---------------------------------------------------------------------------

test scfd_01_fork_detected {
    var es: [2]SenderChainEntry = undefined;
    es[0] = entry(1, 0, key(0x01));
    es[1] = entry(1, 0, key(0x02));
    const result = detect_chain_fork(&es);
    assert(result == .ForkDetected);
}

test scfd_02_zero_epoch_rejected {
    var es: [1]SenderChainEntry = undefined;
    es[0] = entry(0, 0, key(0x01));
    const result = detect_chain_fork(&es);
    assert(result == .ZeroEpoch);
}

test scfd_03_sender_oob_rejected {
    var es: [1]SenderChainEntry = undefined;
    es[0] = entry(1, SCFD_MAX_SENDERS, key(0x01));
    const result = detect_chain_fork(&es);
    assert(result == .SenderOutOfBounds);
}

test scfd_04_key_len_rejected {
    var short: SenderChainEntry = entry(1, 0, key(0x01));
    short.key_len = 16;
    const result = detect_chain_fork(&[short]);
    assert(result == .KeyLengthWrong);
}

test scfd_05_zero_key_rejected {
    var es: [1]SenderChainEntry = undefined;
    es[0] = entry(1, 0, key(0));
    const result = detect_chain_fork(&es);
    assert(result == .ZeroKey);
}

test scfd_06_too_many_rejected {
    var es: [SCFD_MAX_ENTRIES + 1]SenderChainEntry = undefined;
    var i: usize = 0;
    while (i <= SCFD_MAX_ENTRIES) {
        var k = key(0x01);
        k[0] = @intCast(i % 256);
        const epoch: u64 = @intCast(i / 256 + 1);
        const sender: u32 = @intCast(i % 256);
        es[i] = entry(epoch, sender, k);
        i += 1;
    }
    const result = detect_chain_fork(&es);
    assert(result == .TooManyEntries);
}

test scfd_07_valid_accepted {
    var es = valid_entries();
    const result = detect_chain_fork(&es);
    assert(result == null);
}

test scfd_08_same_key_accepted {
    var es: [2]SenderChainEntry = undefined;
    es[0] = entry(1, 0, key(0xAA));
    es[1] = entry(1, 0, key(0xAA));
    const result = detect_chain_fork(&es);
    assert(result == null);
}

test scfd_09_diff_senders_accepted {
    var es: [2]SenderChainEntry = undefined;
    es[0] = entry(1, 0, key(0x01));
    es[1] = entry(1, 1, key(0x02));
    const result = detect_chain_fork(&es);
    assert(result == null);
}

test scfd_10_empty_accepted {
    var es: [0]SenderChainEntry = undefined;
    const result = detect_chain_fork(&es);
    assert(result == null);
}

pub fn main() void {
    scfd_01_fork_detected();
    scfd_02_zero_epoch_rejected();
    scfd_03_sender_oob_rejected();
    scfd_04_key_len_rejected();
    scfd_05_zero_key_rejected();
    scfd_06_too_many_rejected();
    scfd_07_valid_accepted();
    scfd_08_same_key_accepted();
    scfd_09_diff_senders_accepted();
    scfd_10_empty_accepted();
}
