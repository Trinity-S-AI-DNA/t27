// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/sending_chain_advancement_bound_guard.rs @ 8b229e9489ee (238 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — per-chain advancement since the last DH ratchet
// step is bounded (<= 1000) to keep the double-ratchet sending chain from
// drifting too far without new entropy.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * CHAIN-BOUNDED`.
//
// Port decisions:
// * ChainBoundError payloads (idx, got, max) lowered to bare variants
//   (?ChainBoundError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet<[u8; 32]> replaced by an O(n^2) scan over earlier records,
//   per the ring-wide seen-set decision.
// * Decision order preserved: batch bound, zero chain id, zero steps, zero
//   key hash, duplicate chain id, then the steps bound.

module port::sending_chain_advancement_bound_guard;

/// Maximum number of sending-chain steps between DH ratchet updates.
pub const SCAB_MAX_STEPS: u64 = 1000;

/// Maximum records per batch.
pub const SCAB_MAX_RECORDS: usize = 1024;

/// Length of a chain id.
pub const SCAB_CHAIN_ID_LEN: usize = 32;

/// Length of a chain key hash.
pub const SCAB_HASH_LEN: usize = 32;

/// One chain-advancement record.
pub struct ChainAdvanceRecord {
    chain_id: [SCAB_CHAIN_ID_LEN]u8,
    steps_since_dh: u64,
    chain_key_hash: [SCAB_HASH_LEN]u8,
}

/// All ways chain-advancement validation can fail.
pub enum ChainBoundError {
    TooManySteps,
    ZeroChainId,
    ZeroSteps,
    DuplicateChainId,
    ZeroKeyHash,
    TooMany,
}

pub fn cid(byte: u8) [SCAB_CHAIN_ID_LEN]u8 {
    var out: [SCAB_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCAB_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn khash(byte: u8) [SCAB_HASH_LEN]u8 {
    var out: [SCAB_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCAB_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn record(chain: u8, steps: u64, key: u8) ChainAdvanceRecord {
    return .{ .chain_id = cid(chain), .steps_since_dh = steps, .chain_key_hash = khash(key) };
}

pub fn valid_records() [3]ChainAdvanceRecord {
    var rs: [3]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, 10, 0xA1);
    rs[1] = record(0x02, 500, 0xA2);
    rs[2] = record(0x03, SCAB_MAX_STEPS, 0xA3);
    return rs;
}

fn is_zero(buf: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (buf[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate sending-chain advancement bounds.
pub fn validate_chain_bound(records: []ChainAdvanceRecord) -> ?ChainBoundError {
    if (records.len > SCAB_MAX_RECORDS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        if (is_zero(r.chain_id)) {
            return .ZeroChainId;
        }
        if (r.steps_since_dh == 0) {
            return .ZeroSteps;
        }
        if (is_zero(r.chain_key_hash)) {
            return .ZeroKeyHash;
        }
        var j: usize = 0;
        while (j < i) {
            if (eq32(records[j].chain_id, r.chain_id)) {
                return .DuplicateChainId;
            }
            j += 1;
        }
        if (r.steps_since_dh > SCAB_MAX_STEPS) {
            return .TooManySteps;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors scab_01..scab_10 in the Rust source)
// ---------------------------------------------------------------------------

test scab_01_too_many_steps_rejected {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, SCAB_MAX_STEPS + 1, 0xAA);
    const result = validate_chain_bound(&rs);
    assert(result == .TooManySteps);
}

test scab_02_zero_chain_rejected {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = .{ .chain_id = cid(0), .steps_since_dh = 10, .chain_key_hash = khash(0xAA) };
    const result = validate_chain_bound(&rs);
    assert(result == .ZeroChainId);
}

test scab_03_zero_steps_rejected {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, 0, 0xAA);
    const result = validate_chain_bound(&rs);
    assert(result == .ZeroSteps);
}

test scab_04_duplicate_chain_rejected {
    var rs: [2]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, 10, 0xA1);
    rs[1] = record(0x01, 20, 0xA2);
    const result = validate_chain_bound(&rs);
    assert(result == .DuplicateChainId);
}

test scab_05_zero_key_rejected {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = .{ .chain_id = cid(0x01), .steps_since_dh = 10, .chain_key_hash = khash(0) };
    const result = validate_chain_bound(&rs);
    assert(result == .ZeroKeyHash);
}

test scab_06_too_many_rejected {
    var rs: [SCAB_MAX_RECORDS + 1]ChainAdvanceRecord = undefined;
    var i: usize = 0;
    while (i <= SCAB_MAX_RECORDS) {
        var c: [SCAB_CHAIN_ID_LEN]u8 = undefined;
        var z: usize = 0;
        while (z < SCAB_CHAIN_ID_LEN) { c[z] = 0; z += 1; }
        const val: u64 = @intCast(i + 1);
        c[6] = @intCast((val / 256) % 256);
        c[7] = @intCast(val % 256);
        var k = khash(0);
        k[0] = @intCast((i % 255) + 1);
        rs[i] = .{ .chain_id = c, .steps_since_dh = 10, .chain_key_hash = k };
        i += 1;
    }
    const result = validate_chain_bound(&rs);
    assert(result == .TooMany);
}

test scab_07_valid_accepted {
    var rs = valid_records();
    const result = validate_chain_bound(&rs);
    assert(result == null);
}

test scab_08_empty_accepted {
    var rs: [0]ChainAdvanceRecord = undefined;
    const result = validate_chain_bound(&rs);
    assert(result == null);
}

test scab_09_single_step_accepted {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, 1, 0xAA);
    const result = validate_chain_bound(&rs);
    assert(result == null);
}

test scab_10_boundary_accepted {
    var rs: [1]ChainAdvanceRecord = undefined;
    rs[0] = record(0x01, SCAB_MAX_STEPS, 0xAA);
    const result = validate_chain_bound(&rs);
    assert(result == null);
}

pub fn main() void {
    scab_01_too_many_steps_rejected();
    scab_02_zero_chain_rejected();
    scab_03_zero_steps_rejected();
    scab_04_duplicate_chain_rejected();
    scab_05_zero_key_rejected();
    scab_06_too_many_rejected();
    scab_07_valid_accepted();
    scab_08_empty_accepted();
    scab_09_single_step_accepted();
    scab_10_boundary_accepted();
}
