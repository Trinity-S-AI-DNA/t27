// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/sending_chain_key_seed_diversity_guard.rs @ 8b229e9489ee (283 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — sending-chain seeds must be long enough (>= 32
// bytes), carry enough entropy (>= 16 unique bytes), and be unique per
// chain id.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * SEED-DIVERSE`.
//
// Port decisions:
// * SeedDiversityError payloads (idx, unique_bytes, min_unique, got, max)
//   lowered to bare variants (?SeedDiversityError; null = Ok(())), per the
//   ring-wide lowering decision.
// * The two BTreeSets (chain ids, seeds) are replaced by O(n^2) scans over
//   earlier records, per the ring-wide seen-set decision.
// * Per-seed unique-byte counting (a BTreeSet<u8> in Rust) is an O(n^2)
//   scan over the 32 seed bytes.
// * Decision order preserved: batch bound, zero chain id, duplicate chain
//   id, duplicate seed, entropy floor.

module port::sending_chain_key_seed_diversity_guard;

/// Minimum seed entropy in bits.
pub const SCKS_MIN_ENTROPY_BITS: usize = 128;

/// Minimum seed length in bytes.
pub const SCKS_MIN_SEED_LEN: usize = 32;

/// Maximum records per batch.
pub const SCKS_MAX_SEEDS: usize = 256;

/// Length of a chain id.
pub const SCKS_CHAIN_ID_LEN: usize = 32;

/// Length of a seed.
pub const SCKS_SEED_LEN: usize = 32;

/// One chain-seed record.
pub struct SeedDiversityRecord {
    chain_id: [SCKS_CHAIN_ID_LEN]u8,
    seed: [SCKS_SEED_LEN]u8,
}

/// All ways seed-diversity validation can fail.
pub enum SeedDiversityError {
    LowEntropy,
    DuplicateSeed,
    ZeroChainId,
    DuplicateChainId,
    InvalidSeedLen,
    TooMany,
}

pub fn cid(byte: u8) [SCKS_CHAIN_ID_LEN]u8 {
    var out: [SCKS_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCKS_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

/// `diverse_seed` from the Rust tests: byte i is
/// `(base + i) * 7 + 1` (wrapping), which yields >= 16 distinct bytes.
pub fn diverse_seed(base: u8) [SCKS_SEED_LEN]u8 {
    var s: [SCKS_SEED_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCKS_SEED_LEN) {
        const sum: u64 = (@as(u64, base) + (i % 256)) % 256;
        s[i] = @intCast(((sum * 7) + 1) % 256);
        i += 1;
    }
    return s;
}

pub fn rec(chain: u8, seed: [SCKS_SEED_LEN]u8) SeedDiversityRecord {
    return .{ .chain_id = cid(chain), .seed = seed };
}

pub fn valid_records() [2]SeedDiversityRecord {
    var rs: [2]SeedDiversityRecord = undefined;
    rs[0] = rec(0x01, diverse_seed(0x10));
    rs[1] = rec(0x02, diverse_seed(0x20));
    return rs;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn is_zero(buf: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (buf[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

/// Number of distinct bytes in a seed (the BTreeSet<u8> length from Rust).
fn unique_byte_count(seed: [SCKS_SEED_LEN]u8) usize {
    var count: usize = 0;
    var i: usize = 0;
    while (i < SCKS_SEED_LEN) {
        var seen_before = false;
        var j: usize = 0;
        while (j < i) {
            if (seed[j] == seed[i]) { seen_before = true; }
            j += 1;
        }
        if (!seen_before) { count += 1; }
        i += 1;
    }
    return count;
}

/// `[VERIFIED]` Validate sending-chain seed diversity.
pub fn validate_seed_diversity(records: []SeedDiversityRecord) -> ?SeedDiversityError {
    if (records.len > SCKS_MAX_SEEDS) {
        return .TooMany;
    }
    const min_unique: usize = SCKS_MIN_ENTROPY_BITS / 8;
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        if (is_zero(r.chain_id)) {
            return .ZeroChainId;
        }
        var j: usize = 0;
        while (j < i) {
            if (eq32(records[j].chain_id, r.chain_id)) {
                return .DuplicateChainId;
            }
            j += 1;
        }
        var k: usize = 0;
        while (k < i) {
            if (eq32(records[k].seed, r.seed)) {
                return .DuplicateSeed;
            }
            k += 1;
        }
        const unique_bytes: usize = unique_byte_count(r.seed);
        if (unique_bytes < min_unique) {
            return .LowEntropy;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors scks_01..scks_10 in the Rust source)
// ---------------------------------------------------------------------------

test scks_01_low_entropy_rejected {
    var rs: [1]SeedDiversityRecord = undefined;
    rs[0] = rec(0x01, cid(0xAA));
    const result = validate_seed_diversity(&rs);
    assert(result == .LowEntropy);
}

test scks_02_duplicate_seed_rejected {
    var rs: [2]SeedDiversityRecord = undefined;
    const s = diverse_seed(0x10);
    rs[0] = rec(0x01, s);
    rs[1] = rec(0x02, s);
    const result = validate_seed_diversity(&rs);
    assert(result == .DuplicateSeed);
}

test scks_03_zero_chain_rejected {
    var rs: [1]SeedDiversityRecord = undefined;
    rs[0] = .{ .chain_id = cid(0), .seed = diverse_seed(0x10) };
    const result = validate_seed_diversity(&rs);
    assert(result == .ZeroChainId);
}

test scks_04_duplicate_chain_rejected {
    var rs: [2]SeedDiversityRecord = undefined;
    rs[0] = rec(0x01, diverse_seed(0x10));
    rs[1] = rec(0x01, diverse_seed(0x20));
    const result = validate_seed_diversity(&rs);
    assert(result == .DuplicateChainId);
}

test scks_05_zero_seed_rejected {
    var rs: [1]SeedDiversityRecord = undefined;
    rs[0] = rec(0x01, cid(0));
    const result = validate_seed_diversity(&rs);
    assert(result == .LowEntropy);
}

test scks_06_too_many_rejected {
    var rs: [SCKS_MAX_SEEDS + 1]SeedDiversityRecord = undefined;
    var i: usize = 0;
    while (i <= SCKS_MAX_SEEDS) {
        var id: [SCKS_CHAIN_ID_LEN]u8 = undefined;
        var z: usize = 0;
        while (z < SCKS_CHAIN_ID_LEN) { id[z] = 0; z += 1; }
        const val: u64 = @intCast(i + 1);
        id[6] = @intCast((val / 256) % 256);
        id[7] = @intCast(val % 256);
        var seed: [SCKS_SEED_LEN]u8 = undefined;
        var j: usize = 0;
        while (j < SCKS_SEED_LEN) {
            seed[j] = @intCast((((i % 256) + (j % 256)) % 256) + 1);
            j += 1;
        }
        rs[i] = .{ .chain_id = id, .seed = seed };
        i += 1;
    }
    const result = validate_seed_diversity(&rs);
    assert(result == .TooMany);
}

test scks_07_valid_accepted {
    var rs = valid_records();
    const result = validate_seed_diversity(&rs);
    assert(result == null);
}

test scks_08_empty_accepted {
    var rs: [0]SeedDiversityRecord = undefined;
    const result = validate_seed_diversity(&rs);
    assert(result == null);
}

test scks_09_boundary_entropy_accepted {
    const min_unique: usize = SCKS_MIN_ENTROPY_BITS / 8;
    var seed: [SCKS_SEED_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SCKS_SEED_LEN) {
        if (i < min_unique) {
            seed[i] = @intCast(i + 1);
        } else {
            seed[i] = 1;
        }
        i += 1;
    }
    var rs: [1]SeedDiversityRecord = undefined;
    rs[0] = rec(0x01, seed);
    const result = validate_seed_diversity(&rs);
    assert(result == null);
}

test scks_10_many_diverse_accepted {
    var rs: [20]SeedDiversityRecord = undefined;
    var i: usize = 0;
    while (i < 20) {
        rs[i] = rec(@intCast(i + 1), diverse_seed(@intCast((i * 13) % 256)));
        i += 1;
    }
    const result = validate_seed_diversity(&rs);
    assert(result == null);
}

pub fn main() void {
    scks_01_low_entropy_rejected();
    scks_02_duplicate_seed_rejected();
    scks_03_zero_chain_rejected();
    scks_04_duplicate_chain_rejected();
    scks_05_zero_seed_rejected();
    scks_06_too_many_rejected();
    scks_07_valid_accepted();
    scks_08_empty_accepted();
    scks_09_boundary_entropy_accepted();
    scks_10_many_diverse_accepted();
}
