// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/header_key_derivation_epoch_separation_guard.rs @ 8b229e9489ee (247 lines).
// Ring: CR-CHAT-02 (Wave-97 Lane A). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — header key derivations must separate epochs: an
// (epoch, label) pair and a header id may each be derived at most once.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * EPOCH-SEPARATE`.
//
// Port decisions:
// * EpochSeparationError payloads (idx, got/max) lowered to bare variants
//   (?EpochSeparationError; null = Ok(())), per the ring-wide lowering
//   decision. Indices are reconstructable from the failing input prefix.
// * BTreeSet seen-ids / seen-(epoch,label)-pairs replaced by O(n^2) scans
//   over earlier records with identical decision order: batch bound, zero
//   header id, duplicate header id, zero epoch, zero label, duplicate pair.

module port::header_key_derivation_epoch_separation_guard;

/// Maximum headers per validation batch.
pub const HKDE_MAX_HEADERS: usize = 512;
/// Header id length.
pub const HKDE_HEADER_ID_LEN: usize = 16;
/// Label length.
pub const HKDE_LABEL_LEN: usize = 32;

/// One header key derivation record.
pub struct HeaderDerivationRecord {
    header_id: [16]u8,
    epoch: u64,
    label: [32]u8,
}

/// All ways epoch-separation validation can fail.
pub enum EpochSeparationError {
    DuplicateEpochLabel,
    ZeroEpoch,
    ZeroLabel,
    ZeroHeaderId,
    DuplicateHeaderId,
    TooMany,
}

fn eq16(a: [16]u8, b: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn hid(byte: u8) [16]u8 {
    var out: [16]u8 = undefined;
    var i: usize = 0;
    while (i < HKDE_HEADER_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn lbl(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < HKDE_LABEL_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn hdr(id: u8, epoch: u64, label: u8) HeaderDerivationRecord {
    return .{ .header_id = hid(id), .epoch = epoch, .label = lbl(label) };
}

/// `[VERIFIED]` Validate epoch separation across header derivations.
pub fn validate_epoch_separation(headers: []HeaderDerivationRecord) -> ?EpochSeparationError {
    if (headers.len > HKDE_MAX_HEADERS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < headers.len) {
        const h = headers[i];
        // 1. zero header id
        if (eq16(h.header_id, hid(0))) {
            return .ZeroHeaderId;
        }
        // 2. duplicate header id
        var j: usize = 0;
        while (j < i) {
            if (eq16(headers[j].header_id, h.header_id)) {
                return .DuplicateHeaderId;
            }
            j += 1;
        }
        // 3. zero epoch
        if (h.epoch == 0) {
            return .ZeroEpoch;
        }
        // 4. zero label
        if (eq32(h.label, lbl(0))) {
            return .ZeroLabel;
        }
        // 5. duplicate (epoch, label) pair
        j = 0;
        while (j < i) {
            if (headers[j].epoch == h.epoch and eq32(headers[j].label, h.label)) {
                return .DuplicateEpochLabel;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors hkde_01..hkde_10 in the Rust source)
// ---------------------------------------------------------------------------

test hkde_01_duplicate_pair_rejected {
    var hs: [2]HeaderDerivationRecord = undefined;
    hs[0] = hdr(0x01, 1, 0xA1);
    hs[1] = hdr(0x02, 1, 0xA1);
    const result = validate_epoch_separation(&hs);
    assert(result == .DuplicateEpochLabel);
}

test hkde_02_zero_epoch_rejected {
    var hs: [1]HeaderDerivationRecord = undefined;
    hs[0] = .{ .header_id = hid(0x01), .epoch = 0, .label = lbl(0xA1) };
    const result = validate_epoch_separation(&hs);
    assert(result == .ZeroEpoch);
}

test hkde_03_zero_label_rejected {
    var hs: [1]HeaderDerivationRecord = undefined;
    hs[0] = .{ .header_id = hid(0x01), .epoch = 1, .label = lbl(0) };
    const result = validate_epoch_separation(&hs);
    assert(result == .ZeroLabel);
}

test hkde_04_zero_header_rejected {
    var hs: [1]HeaderDerivationRecord = undefined;
    hs[0] = .{ .header_id = hid(0), .epoch = 1, .label = lbl(0xA1) };
    const result = validate_epoch_separation(&hs);
    assert(result == .ZeroHeaderId);
}

test hkde_05_duplicate_header_rejected {
    var hs: [2]HeaderDerivationRecord = undefined;
    hs[0] = hdr(0x01, 1, 0xA1);
    hs[1] = hdr(0x01, 2, 0xA2);
    const result = validate_epoch_separation(&hs);
    assert(result == .DuplicateHeaderId);
}

test hkde_06_too_many_rejected {
    var hs: [HKDE_MAX_HEADERS + 1]HeaderDerivationRecord = undefined;
    var i: usize = 0;
    while (i <= HKDE_MAX_HEADERS) {
        const val: u64 = @intCast(i + 1);
        var id: [16]u8 = hid(0);
        var lb: [32]u8 = lbl(0);
        id[0] = @intCast((val / 256) % 256);
        id[1] = @intCast(val % 256);
        lb[0] = @intCast((val / 256) % 256);
        lb[1] = @intCast(val % 256);
        hs[i] = .{ .header_id = id, .epoch = val, .label = lb };
        i += 1;
    }
    const result = validate_epoch_separation(&hs);
    assert(result == .TooMany);
}

test hkde_07_valid_accepted {
    var hs: [3]HeaderDerivationRecord = undefined;
    hs[0] = hdr(0x01, 1, 0xA1);
    hs[1] = hdr(0x02, 1, 0xA2);
    hs[2] = hdr(0x03, 2, 0xA1);
    const result = validate_epoch_separation(&hs);
    assert(result == null);
}

test hkde_08_empty_accepted {
    var hs: [0]HeaderDerivationRecord = undefined;
    const result = validate_epoch_separation(&hs);
    assert(result == null);
}

test hkde_09_same_label_diff_epoch {
    var hs: [2]HeaderDerivationRecord = undefined;
    hs[0] = hdr(0x01, 1, 0xA1);
    hs[1] = hdr(0x02, 2, 0xA1);
    const result = validate_epoch_separation(&hs);
    assert(result == null);
}

test hkde_10_many_unique_accepted {
    var hs: [30]HeaderDerivationRecord = undefined;
    var i: usize = 0;
    while (i < 30) {
        const idx: u8 = @intCast(i);
        hs[i] = hdr(idx + 1, @as(u64, @intCast(i / 10)) + 1, @intCast(0xA0 + (i % 10)));
        i += 1;
    }
    const result = validate_epoch_separation(&hs);
    assert(result == null);
}

pub fn main() void {
    hkde_01_duplicate_pair_rejected();
    hkde_02_zero_epoch_rejected();
    hkde_03_zero_label_rejected();
    hkde_04_zero_header_rejected();
    hkde_05_duplicate_header_rejected();
    hkde_06_too_many_rejected();
    hkde_07_valid_accepted();
    hkde_08_empty_accepted();
    hkde_09_same_label_diff_epoch();
    hkde_10_many_unique_accepted();
}
