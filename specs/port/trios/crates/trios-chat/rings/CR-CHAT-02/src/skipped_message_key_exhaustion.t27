// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/skipped_message_key_exhaustion.rs @ 8b229e9489ee (185 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — skipped-message-key exhaustion: at most 32
// skipped keys per chain, no gap larger than 64 past the received counter,
// counters unique and nonzero, and at most 256 total skipped keys across
// all chains.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * SKIPPED-KEY-EXHAUSTION`.
//
// Port decisions:
// * SkippedKeyError variants carry no payloads in Rust, so the bare-variant
//   lowering (?SkippedKeyError; null = Ok(())) is a direct match.
// * BTreeSet<u64> (seen counters) is an O(n^2) scan over earlier counters,
//   per the ring-wide seen-set decision.
// * Gap arithmetic keeps Rust's guard shape: the subtraction only runs
//   when counter > received, so it never underflows.

module port::skipped_message_key_exhaustion;

/// Maximum skipped keys per chain.
pub const SMKE_MAX_SKIPPED: usize = 32;

/// Maximum forward gap past the received counter.
pub const SMKE_MAX_GAP: u64 = 64;

/// Maximum total skipped keys across all chains.
pub const SMKE_MAX_TOTAL: usize = 256;

/// All ways skipped-key validation can fail.
pub enum SkippedKeyError {
    TooManySkipped,
    GapTooLarge,
    DuplicateCounter,
    TotalExceeded,
    ZeroCounter,
    EmptyRange,
}

/// `[VERIFIED]` Validate skipped counters for one chain.
pub fn validate_chain_skipped(received: u64, skipped: []u64) -> ?SkippedKeyError {
    if (skipped.len > SMKE_MAX_SKIPPED) {
        return .TooManySkipped;
    }
    var i: usize = 0;
    while (i < skipped.len) {
        const counter = skipped[i];
        if (counter == 0) {
            return .ZeroCounter;
        }
        var j: usize = 0;
        while (j < i) {
            if (skipped[j] == counter) {
                return .DuplicateCounter;
            }
            j += 1;
        }
        if (counter > received) {
            if (counter - received > SMKE_MAX_GAP) {
                return .GapTooLarge;
            }
        }
        i += 1;
    }
    return null;
}

/// `[VERIFIED]` Validate total skipped keys across chains.
pub fn validate_total_skipped(per_chain_counts: []usize) -> ?SkippedKeyError {
    var total: usize = 0;
    var i: usize = 0;
    while (i < per_chain_counts.len) {
        total += per_chain_counts[i];
        i += 1;
    }
    if (total > SMKE_MAX_TOTAL) {
        return .TotalExceeded;
    }
    i = 0;
    while (i < per_chain_counts.len) {
        if (per_chain_counts[i] > SMKE_MAX_SKIPPED) {
            return .TooManySkipped;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors smke_01..smke_10 in the Rust source)
// ---------------------------------------------------------------------------

test smke_01_too_many_rejected {
    var sk: [SMKE_MAX_SKIPPED + 1]u64 = undefined;
    var i: usize = 0;
    while (i <= SMKE_MAX_SKIPPED) {
        sk[i] = @intCast(i + 1);
        i += 1;
    }
    const result = validate_chain_skipped(@intCast(SMKE_MAX_SKIPPED + 2), &sk);
    assert(result == .TooManySkipped);
}

test smke_02_gap_too_large_rejected {
    var sk: [1]u64 = undefined;
    sk[0] = 1 + SMKE_MAX_GAP + 1;
    const result = validate_chain_skipped(1, &sk);
    assert(result == .GapTooLarge);
}

test smke_03_duplicate_rejected {
    var sk: [2]u64 = undefined;
    sk[0] = 3;
    sk[1] = 3;
    const result = validate_chain_skipped(5, &sk);
    assert(result == .DuplicateCounter);
}

test smke_04_total_exceeded_rejected {
    var counts: [SMKE_MAX_TOTAL / SMKE_MAX_SKIPPED + 1]usize = undefined;
    var i: usize = 0;
    while (i < SMKE_MAX_TOTAL / SMKE_MAX_SKIPPED + 1) {
        counts[i] = SMKE_MAX_SKIPPED;
        i += 1;
    }
    const result = validate_total_skipped(&counts);
    assert(result == .TotalExceeded);
}

test smke_05_zero_counter_rejected {
    var sk: [1]u64 = undefined;
    sk[0] = 0;
    const result = validate_chain_skipped(5, &sk);
    assert(result == .ZeroCounter);
}

test smke_06_valid_accepted {
    var sk: [2]u64 = undefined;
    sk[0] = 3;
    sk[1] = 4;
    const result = validate_chain_skipped(5, &sk);
    assert(result == null);
}

test smke_07_empty_accepted {
    var sk: [0]u64 = undefined;
    const result = validate_chain_skipped(1, &sk);
    assert(result == null);
}

test smke_08_exact_max_accepted {
    var sk: [SMKE_MAX_SKIPPED]u64 = undefined;
    var i: usize = 0;
    while (i < SMKE_MAX_SKIPPED) {
        sk[i] = @intCast(i + 1);
        i += 1;
    }
    const result = validate_chain_skipped(@intCast(SMKE_MAX_SKIPPED + 1), &sk);
    assert(result == null);
}

test smke_09_total_within_accepted {
    var counts: [SMKE_MAX_TOTAL / SMKE_MAX_SKIPPED]usize = undefined;
    var i: usize = 0;
    while (i < SMKE_MAX_TOTAL / SMKE_MAX_SKIPPED) {
        counts[i] = SMKE_MAX_SKIPPED;
        i += 1;
    }
    const result = validate_total_skipped(&counts);
    assert(result == null);
}

test smke_10_single_chain_overflow_rejected {
    var counts: [1]usize = undefined;
    counts[0] = SMKE_MAX_SKIPPED + 1;
    const result = validate_total_skipped(&counts);
    assert(result == .TooManySkipped);
}

pub fn main() void {
    smke_01_too_many_rejected();
    smke_02_gap_too_large_rejected();
    smke_03_duplicate_rejected();
    smke_04_total_exceeded_rejected();
    smke_05_zero_counter_rejected();
    smke_06_valid_accepted();
    smke_07_empty_accepted();
    smke_08_exact_max_accepted();
    smke_09_total_within_accepted();
    smke_10_single_chain_overflow_rejected();
}
