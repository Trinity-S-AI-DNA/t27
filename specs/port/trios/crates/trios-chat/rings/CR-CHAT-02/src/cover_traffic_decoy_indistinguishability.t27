// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/cover_traffic_decoy_indistinguishability.rs @ 8b229e9489ee (314 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — cover-traffic decoy indistinguishability: cover
// and real packets must validate identically against the shared length
// classes, canonical AEAD nonce/AAD/tag sizes, and per-class wire digest.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * COVER`.
//
// Port decisions:
// * CoverPacketError payloads lowered to bare variants
//   (?CoverPacketError; null = Ok(())), per the ring-wide lowering
//   decision.
// * Variable-length Vec<u8> fields are fixed buffers with explicit length
//   fields, per the ring-wide Vec<u8> decision: ciphertext is capped at
//   the largest declared length class (4096); nonce/AAD/tag use one small
//   buffer cap with length fields so the 8/12/16/24-byte cases all fit.
// * CoverPacketView.length_classes is a fixed-cap array of
//   (id, len, digest) records; the `any` bin-match scan and `find` class
//   lookup become O(n) loops in source order.

module port::cover_traffic_decoy_indistinguishability;

/// Canonical AEAD nonce length for cover packets.
pub const COVER_AEAD_NONCE_LEN: usize = 12;

/// Canonical AAD length for cover packets.
pub const COVER_AAD_LEN: usize = 16;

/// Canonical AEAD tag length for cover packets.
pub const COVER_AEAD_TAG_LEN: usize = 16;

/// Ciphertext buffer cap: the largest declared length class.
pub const COVER_CIPHERTEXT_CAP: usize = 4096;

/// Buffer cap for nonce/AAD/tag fields (longest tested nonce is 24).
pub const COVER_SMALL_BUF_CAP: usize = 32;

/// Wire digest length in bytes.
pub const COVER_DIGEST_LEN: usize = 32;

/// Maximum length classes declared by a view.
pub const COVER_MAX_CLASSES: usize = 2;

/// One declared cover-traffic length class with its wire digest.
pub struct CoverLengthClass {
    id: u64,
    len: usize,
    digest: [COVER_DIGEST_LEN]u8,
}

/// A cover or real packet as submitted for validation.
pub struct CoverPacket {
    length_class_id: u64,
    ciphertext: [COVER_CIPHERTEXT_CAP]u8,
    ciphertext_len: usize,
    aead_nonce: [COVER_SMALL_BUF_CAP]u8,
    aead_nonce_len: usize,
    aead_aad: [COVER_SMALL_BUF_CAP]u8,
    aead_aad_len: usize,
    aead_tag: [COVER_SMALL_BUF_CAP]u8,
    aead_tag_len: usize,
    is_cover: bool,
    wire_digest: [COVER_DIGEST_LEN]u8,
}

/// The validator's view of the declared length classes.
pub struct CoverPacketView {
    length_classes: [COVER_MAX_CLASSES]CoverLengthClass,
    length_classes_len: usize,
}

/// All ways a cover packet can fail validation.
pub enum CoverPacketError {
    /// Ciphertext length matches no declared length class.
    NonCanonicalPacketLengthClass,
    /// Packet's length class id is not declared in the view.
    UnknownLengthClassId,
    /// Ciphertext length differs from the packet's declared class.
    LengthClassMismatch,
    /// Nonce length is not the canonical 12 bytes.
    NonCanonicalNonceLength,
    /// AAD length is not the canonical 16 bytes.
    NonCanonicalAadLength,
    /// Tag length is not the canonical 16 bytes.
    NonCanonicalTagLength,
    /// Wire digest does not match the declared class digest.
    CoverFlagShapeMismatch,
}

pub fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate a cover/real packet against the view's length classes.
pub fn validate_cover_packet(packet: CoverPacket, view: CoverPacketView) -> ?CoverPacketError {
    var bin_matches_len = false;
    var k: usize = 0;
    while (k < view.length_classes_len) {
        if (view.length_classes[k].len == packet.ciphertext_len) {
            bin_matches_len = true;
        }
        k += 1;
    }
    if (!bin_matches_len) {
        return .NonCanonicalPacketLengthClass;
    }
    var found = false;
    var expected_len: usize = 0;
    var expected_digest: [COVER_DIGEST_LEN]u8 = undefined;
    k = 0;
    while (k < view.length_classes_len) {
        if (view.length_classes[k].id == packet.length_class_id) {
            found = true;
            expected_len = view.length_classes[k].len;
            expected_digest = view.length_classes[k].digest;
        }
        k += 1;
    }
    if (!found) {
        return .UnknownLengthClassId;
    }
    if (expected_len != packet.ciphertext_len) {
        return .LengthClassMismatch;
    }
    if (packet.aead_nonce_len != COVER_AEAD_NONCE_LEN) {
        return .NonCanonicalNonceLength;
    }
    if (packet.aead_aad_len != COVER_AAD_LEN) {
        return .NonCanonicalAadLength;
    }
    if (packet.aead_tag_len != COVER_AEAD_TAG_LEN) {
        return .NonCanonicalTagLength;
    }
    if (!eq32(packet.wire_digest, expected_digest)) {
        return .CoverFlagShapeMismatch;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors ctdi_01..ctdi_10 in the Rust source)
// ---------------------------------------------------------------------------

const CLASS_1024: u64 = 1024;
const CLASS_4096: u64 = 4096;

fn fill_digest(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) {
        out[i] = byte;
        i += 1;
    }
    return out;
}

fn ok_view() CoverPacketView {
    var view: CoverPacketView = undefined;
    view.length_classes[0] = .{ .id = CLASS_1024, .len = 1024, .digest = fill_digest(0xC1) };
    view.length_classes[1] = .{ .id = CLASS_4096, .len = 4096, .digest = fill_digest(0xC4) };
    view.length_classes_len = 2;
    return view;
}

fn ok_packet() CoverPacket {
    var p: CoverPacket = undefined;
    p.length_class_id = CLASS_1024;
    var i: usize = 0;
    while (i < COVER_CIPHERTEXT_CAP) {
        if (i < 1024) { p.ciphertext[i] = 0xAA; } else { p.ciphertext[i] = 0; }
        i += 1;
    }
    p.ciphertext_len = 1024;
    i = 0;
    while (i < COVER_SMALL_BUF_CAP) {
        if (i < 12) { p.aead_nonce[i] = 0x11; } else { p.aead_nonce[i] = 0; }
        if (i < 16) { p.aead_aad[i] = 0x22; } else { p.aead_aad[i] = 0; }
        if (i < 16) { p.aead_tag[i] = 0x33; } else { p.aead_tag[i] = 0; }
        i += 1;
    }
    p.aead_nonce_len = COVER_AEAD_NONCE_LEN;
    p.aead_aad_len = COVER_AAD_LEN;
    p.aead_tag_len = COVER_AEAD_TAG_LEN;
    p.is_cover = false;
    p.wire_digest = fill_digest(0xC1);
    return p;
}

test ctdi_01_off_bin_length_rejected {
    var p = ok_packet();
    p.ciphertext_len = 1023;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .NonCanonicalPacketLengthClass);
}

test ctdi_02_unknown_class_id_rejected {
    var p = ok_packet();
    p.length_class_id = 9999;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .UnknownLengthClassId);
}

test ctdi_03_class_id_mismatch_rejected {
    var p = ok_packet();
    p.length_class_id = CLASS_4096;
    p.wire_digest = fill_digest(0xC4);
    const result = validate_cover_packet(p, ok_view());
    assert(result == .LengthClassMismatch);
}

test ctdi_04_short_nonce_rejected {
    var p = ok_packet();
    p.aead_nonce_len = 8;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .NonCanonicalNonceLength);
}

test ctdi_05_over_long_nonce_rejected {
    var p = ok_packet();
    p.aead_nonce_len = 24;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .NonCanonicalNonceLength);
}

test ctdi_06_aad_length_drift_rejected {
    var p = ok_packet();
    p.aead_aad_len = 12;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .NonCanonicalAadLength);
}

test ctdi_07_truncated_tag_rejected {
    var p = ok_packet();
    p.aead_tag_len = 8;
    const result = validate_cover_packet(p, ok_view());
    assert(result == .NonCanonicalTagLength);
}

test ctdi_08_wire_digest_drift_rejected {
    var p = ok_packet();
    p.wire_digest = fill_digest(0xFF);
    const result = validate_cover_packet(p, ok_view());
    assert(result == .CoverFlagShapeMismatch);
}

test ctdi_09_canonical_cover_packet_accepted {
    var p = ok_packet();
    p.is_cover = true;
    const result = validate_cover_packet(p, ok_view());
    assert(result == null);
}

test ctdi_10_canonical_real_packet_accepted {
    const result = validate_cover_packet(ok_packet(), ok_view());
    assert(result == null);
}

pub fn main() void {
    ctdi_01_off_bin_length_rejected();
    ctdi_02_unknown_class_id_rejected();
    ctdi_03_class_id_mismatch_rejected();
    ctdi_04_short_nonce_rejected();
    ctdi_05_over_long_nonce_rejected();
    ctdi_06_aad_length_drift_rejected();
    ctdi_07_truncated_tag_rejected();
    ctdi_08_wire_digest_drift_rejected();
    ctdi_09_canonical_cover_packet_accepted();
    ctdi_10_canonical_real_packet_accepted();
}
