// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_derivation_chain.rs
// @ 8b229e9489ee (239 lines, Wave-42 Lane B). Ring: CR-CHAT-02 (secure-chat).
// R-CHAT-2 — Forward-secret root key chain validation.
// Anchor: φ² + φ⁻² = 3 · TRINITY · CHAT · ROOT-KEY-CHAIN
//
// The root key in the Triple Ratchet is the top of the key hierarchy.
// Every DH step derives a new root key from the previous root + shared
// secret. If an attacker can force root key reuse or regression, they
// break forward secrecy — old messages become decryptable with a
// compromised current key. trios-chat enforces 6 rules on a root key
// derivation chain:
//
// 1. Root key length is canonical (32 bytes).
// 2. Epoch numbers are strictly increasing.
// 3. No root key is reused across epochs.
// 4. Chain key is derived (non-zero, 32 bytes).
// 5. DH shared secret is not the identity point (all-zero).
// 6. Output chain key differs from the input root key.
//
// Port decisions:
// * `Result<(), RootKeyChainError>` lowers to `?RootKeyChainError`
//   (ring-wide lowering decision; null = Ok(())) — error payload of
//   CR-CHAT-00's `Error::Invariant` is not carried.
// * `Vec<u8>` key material becomes `[]const u8` slices; the canonical
//   32-byte length of rule 1 is therefore still runtime-checked exactly
//   as in the original (needed for RKDC-01).
// * The original accumulates seen `root_key_in` values in a BTreeSet.
//   The port scans every earlier step and compares byte-wise — same
//   accept/reject behavior, stateless, and unbounded like the original
//   (O(n²) instead of O(n log n), irrelevant at validation scale).
// * `#![forbid(unsafe_code)]` — the port subset is safe by construction.
// Tests: mirrors rkdc_01..rkdc_10 in the original @ 8b229e9489ee.

module port::root_key_derivation_chain;

/// Canonical root key and chain key length.
pub const RKDC_KEY_LEN: usize = 32;

/// One step in the root key derivation chain.
pub const RootKeyStep = struct {
    /// Epoch after this derivation step.
    epoch: u64,
    /// Root key input (32 bytes).
    root_key_in: []const u8,
    /// Root key output after derivation (32 bytes).
    root_key_out: []const u8,
    /// Chain key derived from this step (32 bytes).
    chain_key: []const u8,
    /// DH shared secret used in this step (32 bytes).
    dh_shared_secret: []const u8,
};

/// All ways a root key chain can be invalid.
///
/// The Rust enum is `#[non_exhaustive]`; the port models the six
/// shipped variants (the port subset has no open-enum facility).
pub const RootKeyChainError = enum {
    /// Root key length is not 32 bytes.
    NonCanonicalRootKeyLength,
    /// Epoch is not strictly increasing.
    EpochNotMonotonic,
    /// Root key reused across epochs.
    RootKeyReuse,
    /// Chain key is zero (derivation failed).
    ZeroChainKey,
    /// DH shared secret is the identity point (all zeros).
    IdentityDhSecret,
    /// Chain key equals root key input (trivial derivation).
    TrivialDerivation,
};

/// `[VERIFIED]` Validate a root key derivation chain against forward
/// secrecy rules. Returns null if all rules pass.
///
/// Rules enforced in fixed order:
///
/// 1. All root keys (in/out) are 32 bytes.
/// 2. Epochs are strictly increasing.
/// 3. No root key value appears in more than one step.
/// 4. Chain keys are non-zero.
/// 5. DH shared secrets are non-zero.
/// 6. Chain key != root_key_in for each step.
pub fn validate_root_key_chain(steps: []const RootKeyStep) ?RootKeyChainError {
    var prev_epoch: u64 = 0;
    var first: bool = true;

    var i: usize = 0;
    while (i < steps.len) : (i += 1) {
        const step = steps[i];
        if (step.root_key_in.len != RKDC_KEY_LEN or step.root_key_out.len != RKDC_KEY_LEN) {
            return .NonCanonicalRootKeyLength;
        }
        if (!first and step.epoch <= prev_epoch) {
            return .EpochNotMonotonic;
        }
        prev_epoch = step.epoch;
        first = false;
        var j: usize = 0;
        while (j < i) : (j += 1) {
            if (eql_slices(step.root_key_in, steps[j].root_key_in)) {
                return .RootKeyReuse;
            }
        }
        if (is_zero(step.chain_key)) {
            return .ZeroChainKey;
        }
        if (is_zero(step.dh_shared_secret)) {
            return .IdentityDhSecret;
        }
        if (eql_slices(step.chain_key, step.root_key_in)) {
            return .TrivialDerivation;
        }
    }
    return null;
}

/// Byte-wise slice equality (models Rust's `Vec<u8>` `PartialEq`).
fn eql_slices(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// True iff every byte of `s` is zero (models `.iter().all(|&b| b == 0)`).
fn is_zero(s: []const u8) bool {
    for (s) |b| {
        if (b != 0) return false;
    }
    return true;
}

// Tests (mirrors rkdc_01..rkdc_10 in the original @ 8b229e9489ee).

/// Backing storage for one step's byte fields (the original returns
/// owned `Vec<u8>`s; the port keeps per-test pools on the stack).
const StepBufs = struct {
    rk_in: [32]u8 = undefined,
    rk_out: [32]u8 = undefined,
    ck: [32]u8 = undefined,
    dh: [32]u8 = undefined,
};

fn fill32(buf: []u8, b: u8) void {
    var i: usize = 0;
    while (i < 32) : (i += 1) {
        buf[i] = b;
    }
}

/// Build a step pointing into `buf`, mirroring the original's `step()`
/// test helper (every field is `vec![byte; 32]`).
fn mk_step(epoch: u64, rk_in: []const u8, rk_out: []const u8, ck: []const u8, dh: []const u8) RootKeyStep {
    return .{
        .epoch = epoch,
        .root_key_in = rk_in,
        .root_key_out = rk_out,
        .chain_key = ck,
        .dh_shared_secret = dh,
    };
}

/// Byte-filled pool mirroring `good_chain()`:
///   (1, 0x01, 0x02, 0x03, 0x04), (2, 0x02, 0x05, 0x06, 0x07),
///   (3, 0x05, 0x08, 0x09, 0x0A).
fn good_pool() [3]StepBufs {
    var pool: [3]StepBufs = undefined;
    fill32(&pool[0].rk_in, 0x01);
    fill32(&pool[0].rk_out, 0x02);
    fill32(&pool[0].ck, 0x03);
    fill32(&pool[0].dh, 0x04);
    fill32(&pool[1].rk_in, 0x02);
    fill32(&pool[1].rk_out, 0x05);
    fill32(&pool[1].ck, 0x06);
    fill32(&pool[1].dh, 0x07);
    fill32(&pool[2].rk_in, 0x05);
    fill32(&pool[2].rk_out, 0x08);
    fill32(&pool[2].ck, 0x09);
    fill32(&pool[2].dh, 0x0A);
    return pool;
}

/// The `good_chain()` step list, referencing `pool` (which must stay
/// alive in the caller's scope for the slices to remain valid).
fn good_chain(pool: []StepBufs) [3]RootKeyStep {
    return .{
        mk_step(1, &pool[0].rk_in, &pool[0].rk_out, &pool[0].ck, &pool[0].dh),
        mk_step(2, &pool[1].rk_in, &pool[1].rk_out, &pool[1].ck, &pool[1].dh),
        mk_step(3, &pool[2].rk_in, &pool[2].rk_out, &pool[2].ck, &pool[2].dh),
    };
}

/// **RKDC-01** — non-canonical root key length rejected.
test rkdc_01_non_canonical_length_rejected {
    var pool = good_pool();
    var short: [16]u8 = undefined;
    fill32(&short, 0x01);
    var steps = good_chain(&pool);
    steps[0].root_key_in = &short;
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .NonCanonicalRootKeyLength);
}

/// **RKDC-02** — non-monotonic epoch rejected.
test rkdc_02_epoch_not_monotonic_rejected {
    var p0: StepBufs = .{};
    var p1: StepBufs = .{};
    fill32(&p0.rk_in, 0x01);
    fill32(&p0.rk_out, 0x02);
    fill32(&p0.ck, 0x03);
    fill32(&p0.dh, 0x04);
    fill32(&p1.rk_in, 0x02);
    fill32(&p1.rk_out, 0x05);
    fill32(&p1.ck, 0x06);
    fill32(&p1.dh, 0x07);
    const steps = [2]RootKeyStep{
        mk_step(2, &p0.rk_in, &p0.rk_out, &p0.ck, &p0.dh),
        mk_step(1, &p1.rk_in, &p1.rk_out, &p1.ck, &p1.dh),
    };
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .EpochNotMonotonic);
}

/// **RKDC-03** — root key reuse rejected (same root_key_in).
test rkdc_03_root_key_reuse_rejected {
    var pool = good_pool();
    const steps = [2]RootKeyStep{
        mk_step(1, &pool[0].rk_in, &pool[0].rk_out, &pool[0].ck, &pool[0].dh),
        mk_step(2, &pool[0].rk_in, &pool[1].rk_out, &pool[1].ck, &pool[1].dh),
    };
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .RootKeyReuse);
}

/// **RKDC-04** — zero chain key rejected.
test rkdc_04_zero_chain_key_rejected {
    var p0: StepBufs = .{};
    fill32(&p0.rk_in, 0x01);
    fill32(&p0.rk_out, 0x02);
    fill32(&p0.dh, 0x04);
    // chain_key stays all-zero.
    const steps = [1]RootKeyStep{mk_step(1, &p0.rk_in, &p0.rk_out, &p0.ck, &p0.dh)};
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .ZeroChainKey);
}

/// **RKDC-05** — identity DH secret rejected.
test rkdc_05_identity_dh_rejected {
    var p0: StepBufs = .{};
    fill32(&p0.rk_in, 0x01);
    fill32(&p0.rk_out, 0x02);
    fill32(&p0.ck, 0x03);
    // dh stays all-zero (identity point).
    const steps = [1]RootKeyStep{mk_step(1, &p0.rk_in, &p0.rk_out, &p0.ck, &p0.dh)};
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .IdentityDhSecret);
}

/// **RKDC-06** — trivial derivation (chain key == root key in) rejected.
test rkdc_06_trivial_derivation_rejected {
    var p0: StepBufs = .{};
    fill32(&p0.rk_in, 0x01);
    fill32(&p0.rk_out, 0x02);
    fill32(&p0.ck, 0x01); // == root_key_in
    fill32(&p0.dh, 0x04);
    const steps = [1]RootKeyStep{mk_step(1, &p0.rk_in, &p0.rk_out, &p0.ck, &p0.dh)};
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .TrivialDerivation);
}

/// **RKDC-07** — valid chain accepted.
test rkdc_07_valid_chain_accepted {
    var pool = good_pool();
    const steps = good_chain(&pool);
    assert(validate_root_key_chain(&steps) == null);
}

/// **RKDC-08** — single step accepted.
test rkdc_08_single_step_accepted {
    var pool = good_pool();
    const steps = [1]RootKeyStep{
        mk_step(1, &pool[0].rk_in, &pool[0].rk_out, &pool[0].ck, &pool[0].dh),
    };
    assert(validate_root_key_chain(&steps) == null);
}

/// **RKDC-09** — empty chain accepted (nothing to validate).
test rkdc_09_empty_chain_accepted {
    var none: [1]RootKeyStep = undefined;
    assert(validate_root_key_chain(none[0..0]) == null);
}

/// **RKDC-10** — equal epoch rejected (duplicate).
test rkdc_10_equal_epoch_rejected {
    var p0: StepBufs = .{};
    var p1: StepBufs = .{};
    fill32(&p0.rk_in, 0x01);
    fill32(&p0.rk_out, 0x02);
    fill32(&p0.ck, 0x03);
    fill32(&p0.dh, 0x04);
    fill32(&p1.rk_in, 0x05);
    fill32(&p1.rk_out, 0x06);
    fill32(&p1.ck, 0x07);
    fill32(&p1.dh, 0x08);
    const steps = [2]RootKeyStep{
        mk_step(1, &p0.rk_in, &p0.rk_out, &p0.ck, &p0.dh),
        mk_step(1, &p1.rk_in, &p1.rk_out, &p1.ck, &p1.dh),
    };
    const err = validate_root_key_chain(&steps);
    assert(err != null and err.? == .EpochNotMonotonic);
}

pub fn main() void {
    rkdc_01_non_canonical_length_rejected();
    rkdc_02_epoch_not_monotonic_rejected();
    rkdc_03_root_key_reuse_rejected();
    rkdc_04_zero_chain_key_rejected();
    rkdc_05_identity_dh_rejected();
    rkdc_06_trivial_derivation_rejected();
    rkdc_07_valid_chain_accepted();
    rkdc_08_single_step_accepted();
    rkdc_09_empty_chain_accepted();
    rkdc_10_equal_epoch_rejected();
}
