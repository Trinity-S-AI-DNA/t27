// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/welcome_init_secret_kdf_label_confusion.rs @ 8b229e9489ee (228 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — Welcome init-secret KDF label confusion guard:
// the KDF label must be exactly b"init" (4 printable ASCII bytes), the
// epoch secret exactly 32 bytes, the context empty, and the output
// length exactly the 32-byte hash size.
// Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · WISKLC`.
//
// Port decisions:
// * InitSecretKdfLabelError payloads lowered to bare variants
//   (?InitSecretKdfLabelError; null = Ok(())), per the ring-wide
//   lowering decision.
// * Variable-length Vec<u8> fields are fixed buffers with explicit
//   length fields, per the ring-wide Vec<u8> decision:
//   - label: [8]u8 + len (every tested label fits; too-short and
//     too-long cases exercise the length check)
//   - epoch_secret: [32]u8 + len
//   - context: [8]u8 + len (canonical form is len 0)
// * Decision order preserved: label length, label printability, label
//   equality, epoch-secret length, empty context, output length.

module port::welcome_init_secret_kdf_label_confusion;

/// Canonical KDF label byte length.
pub const WISKLC_INIT_LABEL_LEN: usize = 4;

/// KDF hash output size in bytes.
pub const WISKLC_KDF_NH: usize = 32;

/// Epoch secret length in bytes.
pub const WISKLC_EPOCH_SECRET_LEN: usize = 32;

/// Fixed-buffer capacity for the label (MAX+1 model).
pub const WISKLC_LABEL_CAP: usize = 8;

/// Fixed-buffer capacity for the context.
pub const WISKLC_CONTEXT_CAP: usize = 8;

/// KDF input parameters under validation.
pub struct InitSecretKdfParams {
    label: [WISKLC_LABEL_CAP]u8,
    label_len: usize,
    epoch_secret: [WISKLC_EPOCH_SECRET_LEN]u8,
    epoch_secret_len: usize,
    context: [WISKLC_CONTEXT_CAP]u8,
    context_len: usize,
    output_len: usize,
}

/// All ways init-secret KDF label validation can fail.
pub enum InitSecretKdfLabelError {
    NonCanonicalLabelLength,
    NonPrintableLabelByte,
    LabelMismatch,
    NonCanonicalEpochSecretLength,
    NonEmptyContext,
    NonCanonicalOutputLength,
}

/// Canonical label bytes: b"init".
pub fn init_label() [WISKLC_INIT_LABEL_LEN]u8 {
    return .{ 'i', 'n', 'i', 't' };
}

fn params(label_bytes: []u8, secret_len: usize, secret_byte: u8, context_len: usize, output_len: usize) InitSecretKdfParams {
    var p: InitSecretKdfParams = undefined;
    var i: usize = 0;
    while (i < WISKLC_LABEL_CAP) { p.label[i] = 0; i += 1; }
    i = 0;
    while (i < label_bytes.len) {
        p.label[i] = label_bytes[i];
        i += 1;
    }
    p.label_len = label_bytes.len;
    i = 0;
    while (i < WISKLC_EPOCH_SECRET_LEN) {
        if (i < secret_len) { p.epoch_secret[i] = secret_byte; } else { p.epoch_secret[i] = 0; }
        i += 1;
    }
    p.epoch_secret_len = secret_len;
    i = 0;
    while (i < WISKLC_CONTEXT_CAP) { p.context[i] = 0; i += 1; }
    p.context_len = context_len;
    p.output_len = output_len;
    return p;
}

pub fn good_params() InitSecretKdfParams {
    return params(init_label(), WISKLC_EPOCH_SECRET_LEN, 0xAA, 0, WISKLC_KDF_NH);
}

/// `[VERIFIED]` Validate Welcome init-secret KDF label parameters.
pub fn validate_init_secret_kdf_label(p: InitSecretKdfParams) -> ?InitSecretKdfLabelError {
    if (p.label_len != WISKLC_INIT_LABEL_LEN) {
        return .NonCanonicalLabelLength;
    }
    var i: usize = 0;
    while (i < p.label_len) {
        if (p.label[i] < 0x20 or p.label[i] > 0x7e) {
            return .NonPrintableLabelByte;
        }
        i += 1;
    }
    const canonical = init_label();
    i = 0;
    while (i < WISKLC_INIT_LABEL_LEN) {
        if (p.label[i] != canonical[i]) {
            return .LabelMismatch;
        }
        i += 1;
    }
    if (p.epoch_secret_len != WISKLC_EPOCH_SECRET_LEN) {
        return .NonCanonicalEpochSecretLength;
    }
    if (p.context_len != 0) {
        return .NonEmptyContext;
    }
    if (p.output_len != WISKLC_KDF_NH) {
        return .NonCanonicalOutputLength;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors wisklc_01..wisklc_10 in the Rust source)
// ---------------------------------------------------------------------------

test wisklc_01_short_label_rejected {
    var p = good_params();
    p.label_len = 3;
    p.label[0] = 'i';
    p.label[1] = 'n';
    p.label[2] = 'i';
    p.label[3] = 0;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonCanonicalLabelLength);
}

test wisklc_02_long_label_rejected {
    var p = good_params();
    p.label[4] = 'x';
    p.label_len = 5;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonCanonicalLabelLength);
}

test wisklc_03_non_printable_label_byte_rejected {
    var p = good_params();
    p.label[0] = 0x01;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonPrintableLabelByte);
}

test wisklc_04_label_mismatch_uppercase_rejected {
    var p = good_params();
    p.label[0] = 'I';
    const result = validate_init_secret_kdf_label(p);
    assert(result == .LabelMismatch);
}

test wisklc_05_label_mismatch_mixed_case_rejected {
    var p = good_params();
    p.label[0] = 'I';
    p.label[3] = 'T';
    const result = validate_init_secret_kdf_label(p);
    assert(result == .LabelMismatch);
}

test wisklc_06_short_epoch_secret_rejected {
    var p = good_params();
    p.epoch_secret_len = 16;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonCanonicalEpochSecretLength);
}

test wisklc_07_non_empty_context_rejected {
    var p = good_params();
    p.context_len = 1;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonEmptyContext);
}

test wisklc_08_wrong_output_len_rejected {
    var p = good_params();
    p.output_len = 64;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonCanonicalOutputLength);
}

test wisklc_09_null_terminated_label_rejected {
    var p = good_params();
    p.label[4] = 0;
    p.label_len = 5;
    const result = validate_init_secret_kdf_label(p);
    assert(result == .NonCanonicalLabelLength);
}

test wisklc_10_canonical_params_accepted {
    var p = good_params();
    const result = validate_init_secret_kdf_label(p);
    assert(result == null);
}

pub fn main() void {
    wisklc_01_short_label_rejected();
    wisklc_02_long_label_rejected();
    wisklc_03_non_printable_label_byte_rejected();
    wisklc_04_label_mismatch_uppercase_rejected();
    wisklc_05_label_mismatch_mixed_case_rejected();
    wisklc_06_short_epoch_secret_rejected();
    wisklc_07_non_empty_context_rejected();
    wisklc_08_wrong_output_len_rejected();
    wisklc_09_null_terminated_label_rejected();
    wisklc_10_canonical_params_accepted();
}
