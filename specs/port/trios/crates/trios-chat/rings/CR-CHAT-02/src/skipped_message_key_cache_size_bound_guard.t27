// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/skipped_message_key_cache_size_bound_guard.rs @ 8b229e9489ee (234 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — the skipped-message-key cache is bounded: at most
// 1024 cached keys total, at most 64 per chain, entries unique, chain ids
// and steps nonzero, and the batch is capped at 2048 entries.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * CACHE-BOUND`.
//
// Port decisions:
// * CacheBoundError payloads (total, max, chain_idx, count, idx, got)
//   lowered to bare variants (?CacheBoundError; null = Ok(())), per the
//   ring-wide lowering decision.
// * BTreeSet<([u8; 16], u64)> (seen entries) is an O(n^2) scan over
//   earlier entries; BTreeMap<[u8; 16], usize> (per-chain counts) is an
//   O(n^2) count of prior entries sharing the chain id, per the ring-wide
//   seen-set decision.
// * Decision order preserved: batch bound, cache total bound, zero chain,
//   zero step, duplicate entry, per-chain bound.

module port::skipped_message_key_cache_size_bound_guard;

/// Maximum total cached skipped keys.
pub const SMKB_MAX_CACHE_SIZE: usize = 1024;

/// Maximum cached keys per chain.
pub const SMKB_MAX_PER_CHAIN: usize = 64;

/// Maximum entries per batch.
pub const SMKB_MAX_ENTRIES: usize = 2048;

/// Length of a chain id.
pub const SMKB_CHAIN_ID_LEN: usize = 16;

/// One skipped-message-key cache entry.
pub struct CacheEntry {
    chain_id: [SMKB_CHAIN_ID_LEN]u8,
    step: u64,
}

/// All ways cache-bound validation can fail.
pub enum CacheBoundError {
    CacheExceeded,
    PerChainExceeded,
    ZeroChain,
    DuplicateEntry,
    ZeroStep,
    TooMany,
}

pub fn cid(byte: u8) [SMKB_CHAIN_ID_LEN]u8 {
    var out: [SMKB_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SMKB_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn entry(chain: u8, step: u64) CacheEntry {
    return .{ .chain_id = cid(chain), .step = step };
}

pub fn valid_entries() [5]CacheEntry {
    var es: [5]CacheEntry = undefined;
    es[0] = entry(0x01, 1);
    es[1] = entry(0x01, 2);
    es[2] = entry(0x01, 3);
    es[3] = entry(0x02, 1);
    es[4] = entry(0x02, 2);
    return es;
}

fn eq16(a: [16]u8, b: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn is_zero(buf: [16]u8) bool {
    var i: usize = 0;
    while (i < 16) {
        if (buf[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate skipped-message-key cache bounds.
pub fn validate_cache_bounds(entries: []CacheEntry) -> ?CacheBoundError {
    if (entries.len > SMKB_MAX_ENTRIES) {
        return .TooMany;
    }
    if (entries.len > SMKB_MAX_CACHE_SIZE) {
        return .CacheExceeded;
    }
    var i: usize = 0;
    while (i < entries.len) {
        const e = entries[i];
        if (is_zero(e.chain_id)) {
            return .ZeroChain;
        }
        if (e.step == 0) {
            return .ZeroStep;
        }
        var j: usize = 0;
        while (j < i) {
            if (eq16(entries[j].chain_id, e.chain_id) and entries[j].step == e.step) {
                return .DuplicateEntry;
            }
            j += 1;
        }
        var count: usize = 1;
        var k: usize = 0;
        while (k < i) {
            if (eq16(entries[k].chain_id, e.chain_id)) {
                count += 1;
            }
            k += 1;
        }
        if (count > SMKB_MAX_PER_CHAIN) {
            return .PerChainExceeded;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors smkb_01..smkb_10 in the Rust source)
// ---------------------------------------------------------------------------

test smkb_01_cache_exceeded_rejected {
    var es: [SMKB_MAX_CACHE_SIZE + 1]CacheEntry = undefined;
    var i: usize = 0;
    while (i <= SMKB_MAX_CACHE_SIZE) {
        const b: u8 = @intCast((i % 255) + 1);
        es[i] = entry(b, @intCast(i + 1));
        i += 1;
    }
    const result = validate_cache_bounds(&es);
    assert(result == .CacheExceeded);
}

test smkb_02_per_chain_rejected {
    var es: [SMKB_MAX_PER_CHAIN + 1]CacheEntry = undefined;
    var i: usize = 0;
    while (i <= SMKB_MAX_PER_CHAIN) {
        es[i] = entry(0x01, @intCast(i + 1));
        i += 1;
    }
    const result = validate_cache_bounds(&es);
    assert(result == .PerChainExceeded);
}

test smkb_03_zero_chain_rejected {
    var es: [1]CacheEntry = undefined;
    es[0] = .{ .chain_id = cid(0), .step = 1 };
    const result = validate_cache_bounds(&es);
    assert(result == .ZeroChain);
}

test smkb_04_duplicate_rejected {
    var es: [2]CacheEntry = undefined;
    es[0] = entry(0x01, 5);
    es[1] = entry(0x01, 5);
    const result = validate_cache_bounds(&es);
    assert(result == .DuplicateEntry);
}

test smkb_05_zero_step_rejected {
    var es: [1]CacheEntry = undefined;
    es[0] = entry(0x01, 0);
    const result = validate_cache_bounds(&es);
    assert(result == .ZeroStep);
}

test smkb_06_too_many_rejected {
    var es: [SMKB_MAX_ENTRIES + 1]CacheEntry = undefined;
    var i: usize = 0;
    while (i <= SMKB_MAX_ENTRIES) {
        const b: u8 = @intCast((i % 255) + 1);
        es[i] = entry(b, @intCast(i + 1));
        i += 1;
    }
    const result = validate_cache_bounds(&es);
    assert(result == .TooMany);
}

test smkb_07_valid_accepted {
    var es = valid_entries();
    const result = validate_cache_bounds(&es);
    assert(result == null);
}

test smkb_08_empty_accepted {
    var es: [0]CacheEntry = undefined;
    const result = validate_cache_bounds(&es);
    assert(result == null);
}

test smkb_09_single_accepted {
    var es: [1]CacheEntry = undefined;
    es[0] = entry(0x01, 1);
    const result = validate_cache_bounds(&es);
    assert(result == null);
}

test smkb_10_per_chain_boundary_accepted {
    var es: [SMKB_MAX_PER_CHAIN]CacheEntry = undefined;
    var i: usize = 0;
    while (i < SMKB_MAX_PER_CHAIN) {
        es[i] = entry(0x01, @intCast(i + 1));
        i += 1;
    }
    const result = validate_cache_bounds(&es);
    assert(result == null);
}

pub fn main() void {
    smkb_01_cache_exceeded_rejected();
    smkb_02_per_chain_rejected();
    smkb_03_zero_chain_rejected();
    smkb_04_duplicate_rejected();
    smkb_05_zero_step_rejected();
    smkb_06_too_many_rejected();
    smkb_07_valid_accepted();
    smkb_08_empty_accepted();
    smkb_09_single_accepted();
    smkb_10_per_chain_boundary_accepted();
}
