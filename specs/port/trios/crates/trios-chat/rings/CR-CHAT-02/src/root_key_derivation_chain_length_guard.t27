// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_derivation_chain_length_guard.rs @ 8b229e9489ee (197 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — root-key derivation chains are bounded in length;
// epochs must be non-zero, strictly increasing, unique, and each link must
// bind a non-zero root-key hash.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * ROOT-KEY-CHAIN-LEN`.
//
// Port decisions:
// * ChainLengthError payloads (epoch) lowered to bare variants
//   (?ChainLengthError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet<u64> duplicate tracking replaced by an O(n^2) scan over
//   earlier links; decision order preserved: length bound, zero epoch,
//   zero hash, duplicate epoch, epoch monotonicity.

module port::root_key_derivation_chain_length_guard;

/// Maximum root-key chain length.
pub const RKCL_MAX_CHAIN_LEN: usize = 512;

/// Root-key hash length.
pub const RKCL_HASH_LEN: usize = 32;

/// One root-key derivation chain link.
pub struct RootKeyLink {
    epoch: u64,
    root_key_hash: [RKCL_HASH_LEN]u8,
}

/// All ways chain-length validation can fail.
pub enum ChainLengthError {
    ChainTooLong,
    ZeroEpoch,
    EpochNotIncreasing,
    DuplicateEpoch,
    ZeroHash,
}

fn hash(byte: u8) [RKCL_HASH_LEN]u8 {
    var out: [RKCL_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKCL_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn link(epoch: u64, hash_byte: u8) RootKeyLink {
    return .{ .epoch = epoch, .root_key_hash = hash(hash_byte) };
}

pub fn valid_chain() [3]RootKeyLink {
    var chain: [3]RootKeyLink = undefined;
    chain[0] = link(1, 0xAA);
    chain[1] = link(2, 0xBB);
    chain[2] = link(3, 0xCC);
    return chain;
}

/// `[VERIFIED]` Validate root-key chain length and link invariants.
pub fn validate_root_key_chain_length(chain: []RootKeyLink) -> ?ChainLengthError {
    if (chain.len > RKCL_MAX_CHAIN_LEN) {
        return .ChainTooLong;
    }
    var i: usize = 0;
    while (i < chain.len) {
        const l = chain[i];
        // 1. non-zero epoch
        if (l.epoch == 0) {
            return .ZeroEpoch;
        }
        // 2. non-zero root-key hash
        if (eq_n(&l.root_key_hash, &hash(0))) {
            return .ZeroHash;
        }
        // 3. duplicate epoch
        var j: usize = 0;
        while (j < i) {
            if (chain[j].epoch == l.epoch) {
                return .DuplicateEpoch;
            }
            j += 1;
        }
        // 4. epochs strictly increasing
        if (i > 0 and l.epoch <= chain[i - 1].epoch) {
            return .EpochNotIncreasing;
        }
        i += 1;
    }
    return null;
}

fn eq_n(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) { return false; }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rkcl_01..rkcl_10 in the Rust source)
// ---------------------------------------------------------------------------

test rkcl_01_too_long_rejected {
    var chain: [RKCL_MAX_CHAIN_LEN + 1]RootKeyLink = undefined;
    var i: usize = 0;
    while (i <= RKCL_MAX_CHAIN_LEN) {
        const val: u64 = @intCast(i + 1);
        chain[i] = link(val, @intCast(val % 254 + 1));
        i += 1;
    }
    const result = validate_root_key_chain_length(&chain);
    assert(result == .ChainTooLong);
}

test rkcl_02_zero_epoch_rejected {
    var chain: [1]RootKeyLink = undefined;
    chain[0] = .{ .epoch = 0, .root_key_hash = hash(0xAA) };
    const result = validate_root_key_chain_length(&chain);
    assert(result == .ZeroEpoch);
}

test rkcl_03_epoch_not_increasing_rejected {
    var chain: [2]RootKeyLink = undefined;
    chain[0] = link(2, 0xAA);
    chain[1] = link(1, 0xBB);
    const result = validate_root_key_chain_length(&chain);
    assert(result == .EpochNotIncreasing);
}

test rkcl_04_duplicate_epoch_rejected {
    var chain: [3]RootKeyLink = undefined;
    chain[0] = link(1, 0xAA);
    chain[1] = link(2, 0xBB);
    chain[2] = link(1, 0xCC);
    const result = validate_root_key_chain_length(&chain);
    assert(result == .DuplicateEpoch);
}

test rkcl_05_zero_hash_rejected {
    var chain: [1]RootKeyLink = undefined;
    chain[0] = .{ .epoch = 1, .root_key_hash = hash(0) };
    const result = validate_root_key_chain_length(&chain);
    assert(result == .ZeroHash);
}

test rkcl_06_valid_accepted {
    var chain = valid_chain();
    const result = validate_root_key_chain_length(&chain);
    assert(result == null);
}

test rkcl_07_empty_accepted {
    var chain: [0]RootKeyLink = undefined;
    const result = validate_root_key_chain_length(&chain);
    assert(result == null);
}

test rkcl_08_single_accepted {
    var chain: [1]RootKeyLink = undefined;
    chain[0] = link(1, 0xFF);
    const result = validate_root_key_chain_length(&chain);
    assert(result == null);
}

test rkcl_09_max_boundary_accepted {
    var chain: [RKCL_MAX_CHAIN_LEN]RootKeyLink = undefined;
    var i: usize = 0;
    while (i < RKCL_MAX_CHAIN_LEN) {
        const val: u64 = @intCast(i + 1);
        var h: [RKCL_HASH_LEN]u8 = hash(0);
        h[0] = @intCast(val % 256);
        h[1] = @intCast((val / 256) % 256);
        h[8] = 0x01;
        chain[i] = .{ .epoch = val, .root_key_hash = h };
        i += 1;
    }
    const result = validate_root_key_chain_length(&chain);
    assert(result == null);
}

test rkcl_10_long_monotone_accepted {
    var chain: [100]RootKeyLink = undefined;
    var i: usize = 0;
    while (i < 100) {
        const val: u64 = @intCast(i + 1);
        chain[i] = link(val, @intCast(val % 254 + 1));
        i += 1;
    }
    const result = validate_root_key_chain_length(&chain);
    assert(result == null);
}

pub fn main() void {
    rkcl_01_too_long_rejected();
    rkcl_02_zero_epoch_rejected();
    rkcl_03_epoch_not_increasing_rejected();
    rkcl_04_duplicate_epoch_rejected();
    rkcl_05_zero_hash_rejected();
    rkcl_06_valid_accepted();
    rkcl_07_empty_accepted();
    rkcl_08_single_accepted();
    rkcl_09_max_boundary_accepted();
    rkcl_10_long_monotone_accepted();
}
