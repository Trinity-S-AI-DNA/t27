module port::trios::crates::trios-chat::rings::CR-CHAT-02::src::skipped_message_key_gap_bound_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/
// skipped_message_key_gap_bound_guard.rs @ 8b229e9489ee (1 function,
// 4 constants, 1 error enum, 10 tests SMKG-01..10).
//
// CR-CHAT-02 -- Skipped message key gap bound guard (Wave-80 Lane A).
//
// RATCHET -- skipped message key gaps must be bounded, R-CHAT-2. In the
// double ratchet, out-of-order messages cause skipped message keys to be
// stored for later use. If the gap between two consecutive skipped keys is
// unbounded: memory exhaustion (keys for every chain index from 0 to N),
// DoS via gap (one message at chain index 1_000_000 forces 1M skipped keys)
// and a timing signal that reveals which messages are out of order.
//
// Repair of the first port (t27 PR 8500), which did not compile in Zig
// (payload enum variants and a ?SkippedGapError return) and indexed a
// [256]bool bitmap by the key index, which goes up to SMKG_MAX_INDEX =
// 1_000_000. This version:
// - returns a verdict struct (owner decision D5 of the Trinity Secure Chat
//   rewrite): a payload-free code with Ok first, then the original variants
//   in declaration order, plus `value`, the u32 payload of the variant;
// - detects a duplicate by scanning the earlier inputs, which is what the
//   original's BTreeSet of seen indices answers, without a value-indexed
//   array;
// - keeps the original's order of checks: count, then per index: too large,
//   duplicate, not increasing, gap;
// - adds no check the original does not make: the original never returns
//   IndexBelowMin (SMKG_MIN_INDEX is 0 and indices are u32), so the variant
//   is kept for the adapter and is unreachable here, as in the original.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * SKIPPED-KEY-GAP

// Maximum gap between consecutive skipped keys.
pub const SMKG_MAX_GAP: u32 = 32;

// Minimum key index.
pub const SMKG_MIN_INDEX: u32 = 0;

// Maximum total skipped keys.
pub const SMKG_MAX_SKIPPED: usize = 256;

// Maximum key index.
pub const SMKG_MAX_INDEX: u32 = 1000000;

// Ok, then the variants of the original SkippedGapError in declaration order.
pub enum SkippedGapCode {
    Ok,
    GapTooLarge,
    IndexBelowMin,
    TooManySkipped,
    NotIncreasing,
    DuplicateIndex,
    IndexTooLarge,
}

// The verdict. `value` is the u32 payload of the variant: the gap for
// GapTooLarge, the index for IndexBelowMin, DuplicateIndex and
// IndexTooLarge; 0 for Ok, TooManySkipped and NotIncreasing.
pub struct SkippedGapVerdict {
    code: SkippedGapCode,
    value: u32,
}

fn smkg_verdict(code: SkippedGapCode, value: u32) -> SkippedGapVerdict {
    return SkippedGapVerdict { code: code, value: value, };
}

// True when indices[0..i] already holds the value indices[i].
fn smkg_seen_before(indices: []const u32, i: usize) -> bool {
    for (j in 0..i) {
        if (indices[j] == indices[i]) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate that skipped message key gaps are bounded.
pub fn validate_skipped_key_gaps(indices: []const u32) -> SkippedGapVerdict {
    if (indices.len > SMKG_MAX_SKIPPED) {
        return smkg_verdict(SkippedGapCode.TooManySkipped, 0);
    }
    for (i in 0..indices.len) {
        const idx: u32 = indices[i];
        if (idx > SMKG_MAX_INDEX) {
            return smkg_verdict(SkippedGapCode.IndexTooLarge, idx);
        }
        if (smkg_seen_before(indices, i)) {
            return smkg_verdict(SkippedGapCode.DuplicateIndex, idx);
        }
        if (i > 0) {
            const prev: u32 = indices[i - 1];
            if (idx <= prev) {
                return smkg_verdict(SkippedGapCode.NotIncreasing, 0);
            }
            const gap: u32 = idx - prev;
            if (gap > SMKG_MAX_GAP) {
                return smkg_verdict(SkippedGapCode.GapTooLarge, gap);
            }
        }
    }
    return smkg_verdict(SkippedGapCode.Ok, 0);
}

// ---------------------------------------------------------------------
// Tests. SMKG-01..10 transcribed from the original with exact verdicts,
// then the boundaries the first port broke and the original's order of
// checks.
// ---------------------------------------------------------------------

// SMKG-01 -- gap too large rejected.
test smkg_01_gap_large_rejected {
    var indices: [3]u32 = [3]u32{0, 1, 100};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.GapTooLarge);
    assert(v.value == 99);
}

// SMKG-02 -- too many skipped rejected (SMKG_MAX_SKIPPED + 1 indices).
test smkg_02_too_many_rejected {
    var indices: [257]u32 = undefined;
    var n: u32 = 0;
    for (i in 0..257) {
        indices[i] = n;
        n += 1;
    }
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.TooManySkipped);
    assert(v.value == 0);
}

// SMKG-03 -- not increasing rejected.
test smkg_03_not_increasing_rejected {
    var indices: [3]u32 = [3]u32{1, 3, 2};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.NotIncreasing);
    assert(v.value == 0);
}

// SMKG-04 -- duplicate index rejected.
test smkg_04_duplicate_rejected {
    var indices: [3]u32 = [3]u32{1, 2, 2};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.DuplicateIndex);
    assert(v.value == 2);
}

// SMKG-05 -- index too large rejected.
test smkg_05_index_large_rejected {
    var indices: [1]u32 = [1]u32{1000001};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.IndexTooLarge);
    assert(v.value == SMKG_MAX_INDEX + 1);
}

// SMKG-06 -- valid indices accepted.
test smkg_06_valid_accepted {
    var indices: [8]u32 = [8]u32{0, 1, 2, 3, 5, 6, 8, 9};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
    assert(v.value == 0);
}

// SMKG-07 -- empty accepted.
test smkg_07_empty_accepted {
    var indices: [0]u32 = [0]u32{};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
}

// SMKG-08 -- single index accepted.
test smkg_08_single_accepted {
    var indices: [1]u32 = [1]u32{0};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
}

// SMKG-09 -- max gap accepted.
test smkg_09_max_gap_accepted {
    var indices: [2]u32 = [2]u32{0, 32};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
    assert(SMKG_MAX_GAP == 32);
}

// SMKG-10 -- max skipped accepted (exactly SMKG_MAX_SKIPPED indices).
test smkg_10_max_skipped_accepted {
    var indices: [256]u32 = undefined;
    var n: u32 = 0;
    for (i in 0..256) {
        indices[i] = n;
        n += 1;
    }
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
    assert(SMKG_MAX_SKIPPED == 256);
}

// The first port indexed a [256]bool by the key index. Indices up to
// SMKG_MAX_INDEX are legal; the last one is accepted, one past it is not.
test smkg_11_max_index_accepted_without_bitmap {
    var indices: [2]u32 = [2]u32{999990, 1000000};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.Ok);
    assert(v.value == 0);
}

// Duplicate is checked before order: in [5, 6, 5] the last 5 is both a
// duplicate and not increasing; the original's BTreeSet insert reports the
// duplicate first. ([5, 3, 5] stops earlier, at 3, with NotIncreasing.)
test smkg_12_duplicate_checked_before_order {
    var indices: [3]u32 = [3]u32{5, 6, 5};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.DuplicateIndex);
    assert(v.value == 5);
    var early: [3]u32 = [3]u32{5, 3, 5};
    const w = validate_skipped_key_gaps(&early);
    assert(w.code == SkippedGapCode.NotIncreasing);
}

// Too large is checked before order and gap: [4, 2000000] reports the
// index, not a gap of 1999996.
test smkg_13_too_large_checked_before_gap {
    var indices: [2]u32 = [2]u32{4, 2000000};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.IndexTooLarge);
    assert(v.value == 2000000);
}

// The count is checked before any index: 257 indices, the first too large.
test smkg_14_count_checked_before_indices {
    var indices: [257]u32 = undefined;
    for (i in 0..257) {
        indices[i] = 2000000;
    }
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.TooManySkipped);
}

// Gap of 33 rejected with the gap as the value.
test smkg_15_gap_one_past_max {
    var indices: [2]u32 = [2]u32{10, 43};
    const v = validate_skipped_key_gaps(&indices);
    assert(v.code == SkippedGapCode.GapTooLarge);
    assert(v.value == 33);
}

test smkg_16_verdict_helper {
    const v = smkg_verdict(SkippedGapCode.IndexBelowMin, 7);
    assert(v.code == SkippedGapCode.IndexBelowMin);
    assert(v.value == 7);
}

test smkg_17_seen_before_helper {
    var indices: [4]u32 = [4]u32{9, 8, 9, 7};
    assert(smkg_seen_before(&indices, 0) == false);
    assert(smkg_seen_before(&indices, 1) == false);
    assert(smkg_seen_before(&indices, 2) == true);
    assert(smkg_seen_before(&indices, 3) == false);
}
