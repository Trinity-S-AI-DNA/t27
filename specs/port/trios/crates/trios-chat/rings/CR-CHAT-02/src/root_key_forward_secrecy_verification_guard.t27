// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_forward_secrecy_verification_guard.rs @ 8b229e9489ee (245 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — ratchet steps must be forward-secret: root keys
// never reused, epochs strictly increasing and unique, no zero hashes.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * FORWARD-SECRET`.
//
// Port decisions:
// * ForwardSecrecyError payloads (idx, epoch, prev, current, got, max)
//   lowered to bare variants (?ForwardSecrecyError; null = Ok(())), per the
//   ring-wide lowering decision.
// * BTreeSet<[u8; 32]> root hashes and BTreeSet<u64> epochs replaced by
//   O(n^2) scans over earlier steps; decision order preserved: batch bound,
//   zero root key, zero dh output, duplicate epoch, non-monotonic epoch,
//   root-key reuse.

module port::root_key_forward_secrecy_verification_guard;

/// Maximum ratchet steps per batch.
pub const RKFS_MAX_STEPS: usize = 1024;

/// Hash length.
pub const RKFS_HASH_LEN: usize = 32;

/// Epoch length in bytes.
pub const RKFS_EPOCH_LEN: usize = 8;

/// One ratchet step.
pub struct RatchetStep {
    epoch: u64,
    root_key_hash: [RKFS_HASH_LEN]u8,
    dh_output_hash: [RKFS_HASH_LEN]u8,
}

/// All ways forward-secrecy validation can fail.
pub enum ForwardSecrecyError {
    RootKeyReused,
    ZeroRootKey,
    NonMonotonicEpoch,
    ZeroDhOutput,
    DuplicateEpoch,
    TooMany,
}

pub fn hash(byte: u8) [RKFS_HASH_LEN]u8 {
    var out: [RKFS_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKFS_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn step(epoch: u64, rk: u8, dh: u8) RatchetStep {
    return .{ .epoch = epoch, .root_key_hash = hash(rk), .dh_output_hash = hash(dh) };
}

pub fn valid_steps() [3]RatchetStep {
    var ss: [3]RatchetStep = undefined;
    ss[0] = step(1, 0xA1, 0xD1);
    ss[1] = step(2, 0xA2, 0xD2);
    ss[2] = step(3, 0xA3, 0xD3);
    return ss;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn zero_hash() [RKFS_HASH_LEN]u8 {
    var out: [RKFS_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKFS_HASH_LEN) { out[i] = 0; i += 1; }
    return out;
}

/// `[VERIFIED]` Validate forward secrecy of ratchet steps.
pub fn validate_forward_secrecy(steps: []RatchetStep) -> ?ForwardSecrecyError {
    if (steps.len > RKFS_MAX_STEPS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < steps.len) {
        const s = steps[i];
        // 1. non-zero root key hash
        if (eq32(s.root_key_hash, zero_hash())) {
            return .ZeroRootKey;
        }
        // 2. non-zero dh output hash
        if (eq32(s.dh_output_hash, zero_hash())) {
            return .ZeroDhOutput;
        }
        // 3. unique epoch
        var j: usize = 0;
        while (j < i) {
            if (steps[j].epoch == s.epoch) {
                return .DuplicateEpoch;
            }
            j += 1;
        }
        // 4. strictly increasing epoch
        if (i > 0 and s.epoch <= steps[i - 1].epoch) {
            return .NonMonotonicEpoch;
        }
        // 5. unique root key hash
        j = 0;
        while (j < i) {
            if (eq32(steps[j].root_key_hash, s.root_key_hash)) {
                return .RootKeyReused;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rkfs_01..rkfs_10 in the Rust source)
// ---------------------------------------------------------------------------

test rkfs_01_root_key_reused_rejected {
    var ss: [2]RatchetStep = undefined;
    ss[0] = step(1, 0xAA, 0xD1);
    ss[1] = step(2, 0xAA, 0xD2);
    const result = validate_forward_secrecy(&ss);
    assert(result == .RootKeyReused);
}

test rkfs_02_zero_root_key_rejected {
    var s: RatchetStep = step(1, 0xAA, 0xDD);
    s.root_key_hash = hash(0);
    const result = validate_forward_secrecy(&[s]);
    assert(result == .ZeroRootKey);
}

test rkfs_03_non_monotonic_rejected {
    var ss: [2]RatchetStep = undefined;
    ss[0] = step(5, 0xA1, 0xD1);
    ss[1] = step(3, 0xA2, 0xD2);
    const result = validate_forward_secrecy(&ss);
    assert(result == .NonMonotonicEpoch);
}

test rkfs_04_zero_dh_rejected {
    var s: RatchetStep = step(1, 0xAA, 0xDD);
    s.dh_output_hash = hash(0);
    const result = validate_forward_secrecy(&[s]);
    assert(result == .ZeroDhOutput);
}

test rkfs_05_duplicate_epoch_rejected {
    var ss: [2]RatchetStep = undefined;
    ss[0] = step(1, 0xA1, 0xD1);
    ss[1] = step(1, 0xA2, 0xD2);
    const result = validate_forward_secrecy(&ss);
    assert(result == .DuplicateEpoch);
}

test rkfs_06_too_many_rejected {
    var ss: [RKFS_MAX_STEPS + 1]RatchetStep = undefined;
    var i: usize = 0;
    while (i <= RKFS_MAX_STEPS) {
        const val: u64 = @intCast(i + 1);
        var rk: [RKFS_HASH_LEN]u8 = hash(0);
        rk[6] = @intCast((val / 256) % 256);
        rk[7] = @intCast(val % 256);
        var dh: [RKFS_HASH_LEN]u8 = hash(0);
        dh[6] = @intCast(((val + 10000) / 256) % 256);
        dh[7] = @intCast((val + 10000) % 256);
        ss[i] = .{ .epoch = val, .root_key_hash = rk, .dh_output_hash = dh };
        i += 1;
    }
    const result = validate_forward_secrecy(&ss);
    assert(result == .TooMany);
}

test rkfs_07_valid_accepted {
    var ss = valid_steps();
    const result = validate_forward_secrecy(&ss);
    assert(result == null);
}

test rkfs_08_empty_accepted {
    var ss: [0]RatchetStep = undefined;
    const result = validate_forward_secrecy(&ss);
    assert(result == null);
}

test rkfs_09_single_accepted {
    var ss: [1]RatchetStep = undefined;
    ss[0] = step(1, 0xAA, 0xDD);
    const result = validate_forward_secrecy(&ss);
    assert(result == null);
}

test rkfs_10_max_boundary_accepted {
    var ss: [RKFS_MAX_STEPS]RatchetStep = undefined;
    var i: usize = 0;
    while (i < RKFS_MAX_STEPS) {
        const val: u64 = @intCast(i + 1);
        var rk: [RKFS_HASH_LEN]u8 = hash(0);
        rk[6] = @intCast((val / 256) % 256);
        rk[7] = @intCast(val % 256);
        var dh: [RKFS_HASH_LEN]u8 = hash(0);
        dh[6] = @intCast(((val + 50000) / 256) % 256);
        dh[7] = @intCast((val + 50000) % 256);
        ss[i] = .{ .epoch = val, .root_key_hash = rk, .dh_output_hash = dh };
        i += 1;
    }
    const result = validate_forward_secrecy(&ss);
    assert(result == null);
}

pub fn main() void {
    rkfs_01_root_key_reused_rejected();
    rkfs_02_zero_root_key_rejected();
    rkfs_03_non_monotonic_rejected();
    rkfs_04_zero_dh_rejected();
    rkfs_05_duplicate_epoch_rejected();
    rkfs_06_too_many_rejected();
    rkfs_07_valid_accepted();
    rkfs_08_empty_accepted();
    rkfs_09_single_accepted();
    rkfs_10_max_boundary_accepted();
}
