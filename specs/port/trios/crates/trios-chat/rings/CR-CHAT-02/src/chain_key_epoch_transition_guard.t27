// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/chain_key_epoch_transition_guard.rs @ 8b229e9489ee (222 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — epoch transition guard: chain keys must never
// repeat across epochs, epochs must strictly increase, consecutive root
// key hashes must differ, and chain keys must be non-zero.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * EPOCH-TRANSITION`.
//
// Port decisions:
// * EpochTransitionError payloads (epoch values, from/to pair) are lowered
//   to bare variants (?EpochTransitionError; null = Ok(())), per the
//   ring-wide lowering decision — tests assert variant identity only.
// * The seen-chain-key BTreeSet<[u8; 32]> is modeled by the ring-wide
//   O(n^2) prior-entry scan (each key is checked against all earlier
//   transitions), preserving the set-insert order after the zero /
//   monotonicity / same-root checks.

module port::chain_key_epoch_transition_guard;

/// Maximum epochs permitted in one transition list.
pub const CKET_MAX_EPOCHS: usize = 256;

/// Chain key / root key hash length in bytes.
pub const CKET_KEY_LEN: usize = 32;

/// One epoch transition record.
pub struct EpochTransition {
    epoch: u64,
    root_key_hash: [CKET_KEY_LEN]u8,
    chain_key: [CKET_KEY_LEN]u8,
}

/// All ways an epoch transition list can fail validation.
pub enum EpochTransitionError {
    /// The same chain key was already used in an earlier epoch.
    DuplicateChainKey,
    /// Epoch numbers must strictly increase.
    EpochNotIncreasing,
    /// A chain key of all zero bytes.
    ZeroChainKey,
    /// Consecutive transitions share the same root key hash.
    SameRootKey,
    /// Too many epochs in one transition list.
    TooManyEpochs,
}

pub fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn is_zero32(b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (b[i] != 0) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate a list of epoch transitions.
pub fn validate_epoch_transitions(transitions: []EpochTransition) -> ?EpochTransitionError {
    if (transitions.len > CKET_MAX_EPOCHS) {
        return .TooManyEpochs;
    }
    var i: usize = 0;
    while (i < transitions.len) {
        const t = transitions[i];
        if (is_zero32(t.chain_key)) {
            return .ZeroChainKey;
        }
        if (i > 0) {
            if (t.epoch <= transitions[i - 1].epoch) {
                return .EpochNotIncreasing;
            }
            if (eq32(t.root_key_hash, transitions[i - 1].root_key_hash)) {
                return .SameRootKey;
            }
        }
        var j: usize = 0;
        while (j < i) {
            if (eq32(transitions[j].chain_key, t.chain_key)) {
                return .DuplicateChainKey;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors cket_01..cket_10 in the Rust source)
// ---------------------------------------------------------------------------

fn hash(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) {
        out[i] = byte;
        i += 1;
    }
    return out;
}

fn transition(epoch: u64, root: u8, chain: u8) EpochTransition {
    return .{ .epoch = epoch, .root_key_hash = hash(root), .chain_key = hash(chain) };
}

fn valid_transitions_buf() [3]EpochTransition {
    return .{
        transition(1, 0xAA, 0x11),
        transition(2, 0xBB, 0x22),
        transition(3, 0xCC, 0x33),
    };
}

test cket_01_duplicate_chain_key_rejected {
    var ts: [2]EpochTransition = .{ transition(1, 0xAA, 0x11), transition(2, 0xBB, 0x11) };
    const result = validate_epoch_transitions(&ts);
    assert(result == .DuplicateChainKey);
}

test cket_02_epoch_not_increasing_rejected {
    var ts: [2]EpochTransition = .{ transition(2, 0xAA, 0x11), transition(1, 0xBB, 0x22) };
    const result = validate_epoch_transitions(&ts);
    assert(result == .EpochNotIncreasing);
}

test cket_03_zero_chain_key_rejected {
    var zero_key: [CKET_KEY_LEN]u8 = .{0} ** CKET_KEY_LEN;
    var ts: [1]EpochTransition = undefined;
    ts[0] = .{ .epoch = 1, .root_key_hash = hash(0xAA), .chain_key = zero_key };
    const result = validate_epoch_transitions(&ts);
    assert(result == .ZeroChainKey);
}

test cket_04_same_root_key_rejected {
    var ts: [2]EpochTransition = .{ transition(1, 0xAA, 0x11), transition(2, 0xAA, 0x22) };
    const result = validate_epoch_transitions(&ts);
    assert(result == .SameRootKey);
}

test cket_05_too_many_rejected {
    var ts: [CKET_MAX_EPOCHS + 1]EpochTransition = undefined;
    var i: u64 = 0;
    while (i <= CKET_MAX_EPOCHS) {
        var r: [32]u8 = .{0} ** CKET_KEY_LEN;
        var c: [32]u8 = .{0} ** CKET_KEY_LEN;
        r[0] = @intCast(i % 200);
        r[1] = @intCast((i / 200) % 200);
        c[0] = @intCast(i % 200);
        c[1] = @intCast((i / 200 + 1) % 200);
        ts[i] = .{ .epoch = i, .root_key_hash = r, .chain_key = c };
        i += 1;
    }
    const result = validate_epoch_transitions(&ts);
    assert(result == .TooManyEpochs);
}

test cket_06_valid_accepted {
    var ts = valid_transitions_buf();
    const result = validate_epoch_transitions(&ts);
    assert(result == null);
}

test cket_07_empty_accepted {
    var ts: [0]EpochTransition = .{};
    const result = validate_epoch_transitions(&ts);
    assert(result == null);
}

test cket_08_single_accepted {
    var ts: [1]EpochTransition = .{transition(1, 0xAA, 0xBB)};
    const result = validate_epoch_transitions(&ts);
    assert(result == null);
}

test cket_09_max_boundary_accepted {
    var ts: [CKET_MAX_EPOCHS]EpochTransition = undefined;
    var i: u64 = 0;
    while (i < CKET_MAX_EPOCHS) {
        var r: [32]u8 = .{0} ** CKET_KEY_LEN;
        var c: [32]u8 = .{0} ** CKET_KEY_LEN;
        r[0] = @intCast(i & 0xFF);
        r[1] = @intCast((i >> 8) & 0xFF);
        c[0] = r[0];
        c[1] = r[1];
        c[8] = 0x01;
        ts[i] = .{ .epoch = i, .root_key_hash = r, .chain_key = c };
        i += 1;
    }
    const result = validate_epoch_transitions(&ts);
    assert(result == null);
}

test cket_10_distinct_roots_accepted {
    var ts: [4]EpochTransition = .{
        transition(1, 0x01, 0x11),
        transition(2, 0x02, 0x12),
        transition(3, 0x03, 0x13),
        transition(4, 0x04, 0x14),
    };
    const result = validate_epoch_transitions(&ts);
    assert(result == null);
}

pub fn main() void {
    cket_01_duplicate_chain_key_rejected();
    cket_02_epoch_not_increasing_rejected();
    cket_03_zero_chain_key_rejected();
    cket_04_same_root_key_rejected();
    cket_05_too_many_rejected();
    cket_06_valid_accepted();
    cket_07_empty_accepted();
    cket_08_single_accepted();
    cket_09_max_boundary_accepted();
    cket_10_distinct_roots_accepted();
}
