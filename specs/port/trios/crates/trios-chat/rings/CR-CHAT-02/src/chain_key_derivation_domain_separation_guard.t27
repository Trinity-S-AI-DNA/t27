// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/chain_key_derivation_domain_separation_guard.rs @ 8b229e9489ee (265 lines).
// Ring: CR-CHAT-02 (Wave-97 Lane A). Issue: gHashTag/t27#8882.
// Domain: RATCHET — chain key derivations must be domain-separated: only
// approved domains, no zero chain ids / key hashes, no cross-domain reuse of
// a chain id, no duplicate (chain_id, domain) pairs, bounded batch size.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * DOMAIN-SEPARATED`.
//
// Port decisions:
// * Domain names (Rust String) modeled as fixed 16-byte buffers + explicit
//   domain_len; approval is checked against the four approved literals
//   ("sending", "receiving", "skipped", "header") preserving
//   CKDS_APPROVED_DOMAINS semantics.
// * Error payloads (idx, domain, chain_id, got/max) lowered to bare variants
//   (?DomainSepError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeMap/BTreeSet cross-domain and duplicate tracking replaced by an
//   O(n^2) scan over prior records with identical decision order.

module port::chain_key_derivation_domain_separation_guard;

/// Domains approved for chain key derivation.
pub const CKDS_APPROVED_DOMAINS: usize = 4;
/// Maximum derivations per batch.
pub const CKDS_MAX_DERIVATIONS: usize = 1024;
/// Chain id length.
pub const CKDS_CHAIN_ID_LEN: usize = 32;
/// Key hash length.
pub const CKDS_HASH_LEN: usize = 32;

/// One chain key derivation record.
pub struct DerivationRecord {
    domain: [16]u8,
    domain_len: usize,
    chain_id: [32]u8,
    key_hash: [32]u8,
}

/// All ways domain separation validation can fail.
pub enum DomainSepError {
    UnapprovedDomain,
    ZeroChainId,
    ZeroKeyHash,
    CrossDomainReuse,
    DuplicateChainId,
    TooMany,
}

fn dom_buf(text: []const u8) [16]u8 {
    var out: [16]u8 = undefined;
    var i: usize = 0;
    while (i < 16) {
        if (i < text.len) { out[i] = text[i]; } else { out[i] = 0; }
        i += 1;
    }
    return out;
}

fn cid(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < CKDS_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

fn khash(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < CKDS_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

fn eq_arr32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn str_eq_lit(s: []const u8, lit: []const u8) bool {
    if (s.len != lit.len) { return false; }
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] != lit[i]) { return false; }
        i += 1;
    }
    return true;
}

fn dom_is_approved(text: []const u8) bool {
    if (str_eq_lit(text, "sending")) { return true; }
    if (str_eq_lit(text, "receiving")) { return true; }
    if (str_eq_lit(text, "skipped")) { return true; }
    if (str_eq_lit(text, "header")) { return true; }
    return false;
}

pub fn derivation(chain: u8, domain: []const u8, key: u8) DerivationRecord {
    return .{
        .domain = dom_buf(domain),
        .domain_len = domain.len,
        .chain_id = cid(chain),
        .key_hash = khash(key),
    };
}

/// `[VERIFIED]` Validate domain separation over a batch of derivations.
pub fn validate_domain_separation(records: []DerivationRecord) -> ?DomainSepError {
    if (records.len > CKDS_MAX_DERIVATIONS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        // 1. approved domain
        if (!dom_is_approved(r.domain[0..r.domain_len])) {
            return .UnapprovedDomain;
        }
        // 2. zero chain id
        if (eq_arr32(r.chain_id, cid(0))) {
            return .ZeroChainId;
        }
        // 3. zero key hash
        if (eq_arr32(r.key_hash, khash(0))) {
            return .ZeroKeyHash;
        }
        // 4. cross-domain reuse: same chain id, different domain
        var j: usize = 0;
        while (j < i) {
            if (eq_arr32(records[j].chain_id, r.chain_id)) {
                var same_domain = records[j].domain_len == r.domain_len;
                var d: usize = 0;
                while (same_domain and d < r.domain_len) {
                    if (records[j].domain[d] != r.domain[d]) { same_domain = false; }
                    d += 1;
                }
                if (!same_domain) {
                    return .CrossDomainReuse;
                }
            }
            j += 1;
        }
        // 5. duplicate (chain_id, domain) pair
        j = 0;
        while (j < i) {
            if (eq_arr32(records[j].chain_id, r.chain_id) and
                records[j].domain_len == r.domain_len)
            {
                var same_domain = true;
                var d: usize = 0;
                while (d < r.domain_len) {
                    if (records[j].domain[d] != r.domain[d]) { same_domain = false; }
                    d += 1;
                }
                if (same_domain) {
                    return .DuplicateChainId;
                }
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors ckds_01..ckds_10 in the Rust source)
// ---------------------------------------------------------------------------

test ckds_01_unapproved_domain_rejected {
    var rs: [1]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "unknown", 0xAA);
    const result = validate_domain_separation(&rs);
    assert(result == .UnapprovedDomain);
}

test ckds_02_zero_chain_rejected {
    var rs: [1]DerivationRecord = undefined;
    rs[0] = .{ .domain = dom_buf("sending"), .domain_len = 7, .chain_id = cid(0), .key_hash = khash(0xAA) };
    const result = validate_domain_separation(&rs);
    assert(result == .ZeroChainId);
}

test ckds_03_zero_key_rejected {
    var rs: [1]DerivationRecord = undefined;
    rs[0] = .{ .domain = dom_buf("sending"), .domain_len = 7, .chain_id = cid(0x01), .key_hash = khash(0) };
    const result = validate_domain_separation(&rs);
    assert(result == .ZeroKeyHash);
}

test ckds_04_cross_domain_rejected {
    var rs: [2]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "sending", 0xA1);
    rs[1] = derivation(0x01, "receiving", 0xA2);
    const result = validate_domain_separation(&rs);
    assert(result == .CrossDomainReuse);
}

test ckds_05_duplicate_chain_rejected {
    var rs: [2]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "sending", 0xA1);
    rs[1] = derivation(0x01, "sending", 0xA2);
    const result = validate_domain_separation(&rs);
    assert(result == .DuplicateChainId);
}

test ckds_06_too_many_rejected {
    var rs: [CKDS_MAX_DERIVATIONS + 1]DerivationRecord = undefined;
    var i: usize = 0;
    while (i <= CKDS_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var c: [32]u8 = cid(0);
        c[0] = @intCast((val / 256) % 256);
        c[1] = @intCast(val % 256);
        var k: [32]u8 = khash(0);
        k[0] = @intCast(((val + 50000) / 256) % 256);
        k[1] = @intCast((val + 50000) % 256);
        rs[i] = .{ .domain = dom_buf("sending"), .domain_len = 7, .chain_id = c, .key_hash = k };
        i += 1;
    }
    const result = validate_domain_separation(&rs);
    assert(result == .TooMany);
}

test ckds_07_valid_accepted {
    var rs: [3]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "sending", 0xA1);
    rs[1] = derivation(0x02, "receiving", 0xA2);
    rs[2] = derivation(0x03, "skipped", 0xA3);
    const result = validate_domain_separation(&rs);
    assert(result == null);
}

test ckds_08_empty_accepted {
    var rs: [0]DerivationRecord = undefined;
    const result = validate_domain_separation(&rs);
    assert(result == null);
}

test ckds_09_all_domains_accepted {
    var rs: [4]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "sending", 0xA1);
    rs[1] = derivation(0x02, "receiving", 0xA2);
    rs[2] = derivation(0x03, "skipped", 0xA3);
    rs[3] = derivation(0x04, "header", 0xA4);
    const result = validate_domain_separation(&rs);
    assert(result == null);
}

test ckds_10_same_chain_different_key_rejected {
    var rs: [2]DerivationRecord = undefined;
    rs[0] = derivation(0x01, "sending", 0xA1);
    rs[1] = derivation(0x01, "sending", 0xA2);
    const result = validate_domain_separation(&rs);
    assert(result == .DuplicateChainId);
}

pub fn main() void {
    ckds_01_unapproved_domain_rejected();
    ckds_02_zero_chain_rejected();
    ckds_03_zero_key_rejected();
    ckds_04_cross_domain_rejected();
    ckds_05_duplicate_chain_rejected();
    ckds_06_too_many_rejected();
    ckds_07_valid_accepted();
    ckds_08_empty_accepted();
    ckds_09_all_domains_accepted();
    ckds_10_same_chain_different_key_rejected();
}
