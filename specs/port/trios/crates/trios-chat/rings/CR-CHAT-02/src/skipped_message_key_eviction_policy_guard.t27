// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/skipped_message_key_eviction_policy_guard.rs @ 8b229e9489ee (266 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — skipped-key cache eviction policy bounds: at most
// 100 total keys, at most 10 per chain, no key older than 60 s, no zero
// chain ids/hashes, and the batch is capped at 512 records.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * EVICT-PROMPT`.
//
// Port decisions:
// * EvictionPolicyError payloads (chain_id, count, max, got, idx, age_ms)
//   lowered to bare variants (?EvictionPolicyError; null = Ok(())), per
//   the ring-wide lowering decision.
// * BTreeMap<[u8; 32], usize> (chain counts) is an O(n^2) second pass that
//   counts records sharing a chain id, per the ring-wide seen-set
//   decision. The per-chain check runs AFTER all per-record checks,
//   matching the Rust two-phase order (a later record error such as
//   TooOld wins over an earlier chain-count violation).
// * Decision order preserved: batch bound, total bound, then per record
//   (zero chain id, zero key hash, age bound), then per-chain bound.

module port::skipped_message_key_eviction_policy_guard;

/// Maximum skipped keys per chain.
pub const SMEP_MAX_PER_CHAIN: usize = 10;

/// Maximum total skipped keys.
pub const SMEP_MAX_TOTAL: usize = 100;

/// Maximum key age in milliseconds.
pub const SMEP_MAX_AGE_MS: u64 = 60_000;

/// Maximum records per batch.
pub const SMEP_MAX_RECORDS: usize = 512;

/// Length of a chain id.
pub const SMEP_CHAIN_ID_LEN: usize = 32;

/// Length of a key hash.
pub const SMEP_HASH_LEN: usize = 32;

/// One skipped-key record.
pub struct SkippedKeyRecord {
    chain_id: [SMEP_CHAIN_ID_LEN]u8,
    key_hash: [SMEP_HASH_LEN]u8,
    age_ms: u64,
}

/// All ways eviction-policy validation can fail.
pub enum EvictionPolicyError {
    TooManyPerChain,
    TotalExceeded,
    TooOld,
    ZeroKeyHash,
    ZeroChainId,
    TooMany,
}

pub fn cid(byte: u8) [SMEP_CHAIN_ID_LEN]u8 {
    var out: [SMEP_CHAIN_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SMEP_CHAIN_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn khash(byte: u8) [SMEP_HASH_LEN]u8 {
    var out: [SMEP_HASH_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < SMEP_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn skipped(chain: u8, key: u8, age: u64) SkippedKeyRecord {
    return .{ .chain_id = cid(chain), .key_hash = khash(key), .age_ms = age };
}

pub fn valid_records() [4]SkippedKeyRecord {
    var rs: [4]SkippedKeyRecord = undefined;
    rs[0] = skipped(0x01, 0xA1, 1000);
    rs[1] = skipped(0x01, 0xA2, 2000);
    rs[2] = skipped(0x02, 0xA3, 1500);
    rs[3] = skipped(0x03, 0xA4, 3000);
    return rs;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

fn is_zero(buf: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (buf[i] != 0) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate skipped-key cache eviction policy.
pub fn validate_eviction_policy(records: []SkippedKeyRecord) -> ?EvictionPolicyError {
    if (records.len > SMEP_MAX_RECORDS) {
        return .TooMany;
    }
    if (records.len > SMEP_MAX_TOTAL) {
        return .TotalExceeded;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        if (is_zero(r.chain_id)) {
            return .ZeroChainId;
        }
        if (is_zero(r.key_hash)) {
            return .ZeroKeyHash;
        }
        if (r.age_ms > SMEP_MAX_AGE_MS) {
            return .TooOld;
        }
        i += 1;
    }
    i = 0;
    while (i < records.len) {
        var count: usize = 0;
        var j: usize = 0;
        while (j < records.len) {
            if (eq32(records[j].chain_id, records[i].chain_id)) {
                count += 1;
            }
            j += 1;
        }
        if (count > SMEP_MAX_PER_CHAIN) {
            return .TooManyPerChain;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors smep_01..smep_10 in the Rust source)
// ---------------------------------------------------------------------------

test smep_01_too_many_per_chain_rejected {
    var rs: [SMEP_MAX_PER_CHAIN + 1]SkippedKeyRecord = undefined;
    var i: usize = 0;
    while (i <= SMEP_MAX_PER_CHAIN) {
        const b: u8 = @intCast((i % 255) + 1);
        rs[i] = skipped(0x01, b, @intCast(i * 100));
        i += 1;
    }
    const result = validate_eviction_policy(&rs);
    assert(result == .TooManyPerChain);
}

test smep_02_total_exceeded_rejected {
    var rs: [SMEP_MAX_TOTAL + 1]SkippedKeyRecord = undefined;
    var i: usize = 0;
    while (i <= SMEP_MAX_TOTAL) {
        const chain: u8 = @intCast((i % 20) + 1);
        const key: u8 = @intCast((i % 255) + 1);
        rs[i] = skipped(chain, key, @intCast(i * 100));
        i += 1;
    }
    const result = validate_eviction_policy(&rs);
    assert(result == .TotalExceeded);
}

test smep_03_too_old_rejected {
    var rs: [1]SkippedKeyRecord = undefined;
    rs[0] = .{ .chain_id = cid(0x01), .key_hash = khash(0xAA), .age_ms = SMEP_MAX_AGE_MS + 1 };
    const result = validate_eviction_policy(&rs);
    assert(result == .TooOld);
}

test smep_04_zero_key_rejected {
    var rs: [1]SkippedKeyRecord = undefined;
    rs[0] = .{ .chain_id = cid(0x01), .key_hash = khash(0), .age_ms = 1000 };
    const result = validate_eviction_policy(&rs);
    assert(result == .ZeroKeyHash);
}

test smep_05_zero_chain_rejected {
    var rs: [1]SkippedKeyRecord = undefined;
    rs[0] = .{ .chain_id = cid(0), .key_hash = khash(0xAA), .age_ms = 1000 };
    const result = validate_eviction_policy(&rs);
    assert(result == .ZeroChainId);
}

test smep_06_too_many_rejected {
    var rs: [SMEP_MAX_RECORDS + 1]SkippedKeyRecord = undefined;
    var i: usize = 0;
    while (i <= SMEP_MAX_RECORDS) {
        const chain: u8 = @intCast((i % 20) + 1);
        const key: u8 = @intCast((i % 255) + 1);
        rs[i] = skipped(chain, key, @intCast(i * 100));
        i += 1;
    }
    const result = validate_eviction_policy(&rs);
    assert(result == .TooMany);
}

test smep_07_valid_accepted {
    var rs = valid_records();
    const result = validate_eviction_policy(&rs);
    assert(result == null);
}

test smep_08_empty_accepted {
    var rs: [0]SkippedKeyRecord = undefined;
    const result = validate_eviction_policy(&rs);
    assert(result == null);
}

test smep_09_boundary_age_accepted {
    var rs: [1]SkippedKeyRecord = undefined;
    rs[0] = .{ .chain_id = cid(0x01), .key_hash = khash(0xAA), .age_ms = SMEP_MAX_AGE_MS };
    const result = validate_eviction_policy(&rs);
    assert(result == null);
}

test smep_10_max_per_chain_accepted {
    var rs: [SMEP_MAX_PER_CHAIN]SkippedKeyRecord = undefined;
    var i: usize = 0;
    while (i < SMEP_MAX_PER_CHAIN) {
        const b: u8 = @intCast((i % 255) + 1);
        rs[i] = skipped(0x01, b, @intCast(i * 100));
        i += 1;
    }
    const result = validate_eviction_policy(&rs);
    assert(result == null);
}

pub fn main() void {
    smep_01_too_many_per_chain_rejected();
    smep_02_total_exceeded_rejected();
    smep_03_too_old_rejected();
    smep_04_zero_key_rejected();
    smep_05_zero_chain_rejected();
    smep_06_too_many_rejected();
    smep_07_valid_accepted();
    smep_08_empty_accepted();
    smep_09_boundary_age_accepted();
    smep_10_max_per_chain_accepted();
}
