// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/key_package_hash_pinning.rs @ 8b229e9489ee (243 lines).
// Ring: CR-CHAT-02 (Wave-34 L-CHAT-1-kphp). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — key packages are pinned by content hash; the pin
// table refuses collisions, duplicate pins of one package under two hashes,
// and overflows past KPHP_MAX_PINS.
// Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · KEY-PACKAGE-HASH-PIN`.
//
// Port decisions:
// * KeyPackagePinError payloads lowered to bare variants (?KeyPackagePinError;
//   null = Ok(())), per the ring-wide lowering decision.
// * BTreeMap<[u8;32], Vec<u8>> replaced by a fixed-capacity pin array
//   (KPHP_MAX_PINS entries) with linear scans; decision order preserved:
//   empty package, empty hash, hash length, table-full (unless the hash is
//   already pinned), collision/idempotent re-pin, same-package-different-hash.
// * Vec<u8> packages modeled as fixed 32-byte buffers + pkg_len (all test
//   packages fit; longer inputs are truncated to the buffer with the full
//   length kept in pkg_len for equality checks against slices up to 32 bytes).

module port::key_package_hash_pinning;

/// Hash length.
pub const KPHP_HASH_LEN: usize = 32;
/// Maximum pins per table.
pub const KPHP_MAX_PINS: usize = 512;

/// One pinned key package.
pub struct KeyPackagePin {
    hash: [32]u8,
    pkg: [32]u8,
    pkg_len: usize,
}

/// All ways pinning can fail.
pub enum KeyPackagePinError {
    EmptyHash,
    WrongHashLength,
    HashCollision,
    AlreadyPinnedDifferently,
    PinTableFull,
    EmptyKeyPackage,
}

/// Content-hash pin table.
pub struct PinTable {
    pins: [KPHP_MAX_PINS]KeyPackagePin,
    pin_count: usize,
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn hash(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < KPHP_HASH_LEN) { out[i] = byte; i += 1; }
    return out;
}

fn to32(bytes: []const u8) [32]u8 {
    var out: [32]u8 = zero32();
    var i: usize = 0;
    while (i < bytes.len and i < KPHP_HASH_LEN) {
        out[i] = bytes[i];
        i += 1;
    }
    return out;
}

fn zero32() [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) { out[i] = 0; i += 1; }
    return out;
}

fn to_pkg(bytes: []const u8) [32]u8 {
    var out: [32]u8 = zero32();
    var i: usize = 0;
    while (i < bytes.len and i < 32) {
        out[i] = bytes[i];
        i += 1;
    }
    return out;
}

fn pkg_eq(p: KeyPackagePin, bytes: []const u8) bool {
    if (p.pkg_len != bytes.len) { return false; }
    var i: usize = 0;
    while (i < bytes.len) {
        if (p.pkg[i] != bytes[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn new() PinTable {
    return .{ .pins = undefined, .pin_count = 0 };
}

pub fn count(self: *const PinTable) usize {
    return self.pin_count;
}

pub fn is_empty(self: *const PinTable) bool {
    return self.pin_count == 0;
}

/// `[VERIFIED]` Pin a key package under its content hash.
pub fn pin(self: *PinTable, kp_bytes: []const u8, hash_bytes: []const u8) -> ?KeyPackagePinError {
    // 1. empty package / hash, wrong hash length
    if (kp_bytes.len == 0) {
        return .EmptyKeyPackage;
    }
    if (hash_bytes.len == 0) {
        return .EmptyHash;
    }
    if (hash_bytes.len != KPHP_HASH_LEN) {
        return .WrongHashLength;
    }
    const h = to32(hash_bytes);
    // locate an existing pin for this hash (single scan shared by the
    // table-full and collision/idempotence decisions)
    var existing_idx: usize = 0;
    var has_existing = false;
    var i: usize = 0;
    while (i < self.pin_count) {
        if (eq32(self.pins[i].hash, h)) {
            existing_idx = i;
            has_existing = true;
        }
        i += 1;
    }
    // 2. table full (unless this hash is already pinned)
    if (self.pin_count >= KPHP_MAX_PINS and !has_existing) {
        return .PinTableFull;
    }
    // 3. hash collision or idempotent re-pin
    if (has_existing) {
        if (!pkg_eq(self.pins[existing_idx], kp_bytes)) {
            return .HashCollision;
        }
        return null;
    }
    // 4. same package already pinned under a different hash
    var j: usize = 0;
    while (j < self.pin_count) {
        if (pkg_eq(self.pins[j], kp_bytes)) {
            return .AlreadyPinnedDifferently;
        }
        j += 1;
    }
    self.pins[self.pin_count] = .{ .hash = h, .pkg = to_pkg(kp_bytes), .pkg_len = kp_bytes.len };
    self.pin_count += 1;
    return null;
}

/// `[VERIFIED]` Look up a pinned package by hash (None when unpinned or the
/// hash length is wrong).
pub fn lookup(self: *const PinTable, hash_bytes: []const u8) ?KeyPackagePin {
    if (hash_bytes.len != KPHP_HASH_LEN) {
        return null;
    }
    const arr = to32(hash_bytes);
    var i: usize = 0;
    while (i < self.pin_count) {
        if (eq32(self.pins[i].hash, arr)) {
            return self.pins[i];
        }
        i += 1;
    }
    return null;
}

/// Spec-model helper mirroring `get(..) == Some(pkg)` payload comparison
/// (avoids optional unwrapping in tests).
pub fn lookup_matches(self: *const PinTable, hash_bytes: []const u8, expected: []const u8) bool {
    if (hash_bytes.len != KPHP_HASH_LEN) {
        return false;
    }
    const arr = to32(hash_bytes);
    var i: usize = 0;
    while (i < self.pin_count) {
        if (eq32(self.pins[i].hash, arr)) {
            return pkg_eq(self.pins[i], expected);
        }
        i += 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Tests (mirrors kphp_01..kphp_10 in the Rust source)
// ---------------------------------------------------------------------------

test kphp_01_empty_hash_rejected {
    var t = new();
    const result = t.pin("kp", &zero32()[0..0]);
    assert(result == .EmptyHash);
}

test kphp_02_wrong_length_rejected {
    var t = new();
    var h16: [16]u8 = undefined;
    var i: usize = 0;
    while (i < 16) { h16[i] = 0x33; i += 1; }
    const result = t.pin("kp", &h16);
    assert(result == .WrongHashLength);
}

test kphp_03_hash_collision_rejected {
    var t = new();
    const h = hash(0xAA);
    const first = t.pin("kp-a", &h);
    assert(first == null);
    const result = t.pin("kp-b", &h);
    assert(result == .HashCollision);
}

test kphp_04_already_pinned_rejected {
    var t = new();
    const h1 = hash(0x01);
    const first = t.pin("same-kp", &h1);
    assert(first == null);
    const h2 = hash(0x02);
    const result = t.pin("same-kp", &h2);
    assert(result == .AlreadyPinnedDifferently);
}

test kphp_05_table_full_rejected {
    var t = new();
    var i: usize = 0;
    while (i < KPHP_MAX_PINS) {
        const hi: u8 = @intCast((i >> 8) % 256);
        const lo: u8 = @intCast(i % 256);
        var h = hash(0);
        h[0] = hi;
        h[1] = lo;
        var kp: [32]u8 = zero32();
        kp[0] = hi;
        kp[1] = lo;
        const r = t.pin(&kp, &h);
        assert(r == null);
        i += 1;
    }
    assert(count(&t) == KPHP_MAX_PINS);
    var kp2: [4]u8 = undefined;
    kp2[0] = 0xDE; kp2[1] = 0xAD; kp2[2] = 0xBE; kp2[3] = 0xEF;
    const hf = hash(0xFF);
    const result = t.pin(&kp2, &hf);
    assert(result == .PinTableFull);
}

test kphp_06_empty_kp_rejected {
    var t = new();
    const h = hash(0x00);
    const result = t.pin(&zero32()[0..0], &h);
    assert(result == .EmptyKeyPackage);
}

test kphp_07_valid_pin_accepted {
    var t = new();
    const h = hash(0x01);
    const result = t.pin("valid-kp", &h);
    assert(result == null);
}

test kphp_08_idempotent_accepted {
    var t = new();
    const h = hash(0x01);
    const first = t.pin("same-kp", &h);
    assert(first == null);
    const result = t.pin("same-kp", &h);
    assert(result == null);
}

test kphp_09_lookup_correct {
    var t = new();
    const h = hash(0x42);
    const pinned = t.pin("my-kp", &h);
    assert(pinned == null);
    assert(t.lookup(&h) != null);
    assert(lookup_matches(&t, &h, "my-kp"));
}

test kphp_10_lookup_missing {
    var t = new();
    const h = hash(0x00);
    assert(t.lookup(&h) == null);
}

pub fn main() void {
    kphp_01_empty_hash_rejected();
    kphp_02_wrong_length_rejected();
    kphp_03_hash_collision_rejected();
    kphp_04_already_pinned_rejected();
    kphp_05_table_full_rejected();
    kphp_06_empty_kp_rejected();
    kphp_07_valid_pin_accepted();
    kphp_08_idempotent_accepted();
    kphp_09_lookup_correct();
    kphp_10_lookup_missing();
}
