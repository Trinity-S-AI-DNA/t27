// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/ephemeral_public_key_reuse_detection_guard.rs @ 8b229e9489ee (245 lines).
// Ring: CR-CHAT-02 (Wave-97 Lane A). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — ephemeral public keys must never repeat across
// sessions; zero keys/sessions and duplicate sessions are rejected.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * EPHEMERAL-UNIQUE`.
//
// Port decisions:
// * Error payloads (idx, owner_session, got/max) lowered to bare variants
//   (?EphemeralReuseError; null = Ok(())), per the ring-wide lowering
//   decision. CrossSessionReuse carries the owner's session id implicitly
//   (reconstructable from the first record owning the key).
// * BTreeSet keys/sessions + BTreeMap key_to_session replaced by O(n^2)
//   scans over earlier records with identical decision order: zero session,
//   zero key, duplicate session, cross-session key reuse, duplicate key
//   (unreachable after cross-session), batch bound.

module port::ephemeral_public_key_reuse_detection_guard;

/// Ephemeral key length.
pub const EPKR_KEY_LEN: usize = 32;
/// Session id length.
pub const EPKR_SESSION_LEN: usize = 32;
/// Maximum records per validation batch.
pub const EPKR_MAX_RECORDS: usize = 1024;

/// One ephemeral key usage record.
pub struct EphemeralKeyRecord {
    session_id: [32]u8,
    ephemeral_key: [32]u8,
}

/// All ways ephemeral key reuse validation can fail.
pub enum EphemeralReuseError {
    DuplicateKey,
    ZeroKey,
    ZeroSession,
    DuplicateSession,
    CrossSessionReuse,
    TooMany,
}

fn zero32() [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) { out[i] = 0; i += 1; }
    return out;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn sid(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < EPKR_SESSION_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn key_of(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < EPKR_KEY_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn record(session: u8, epk: u8) EphemeralKeyRecord {
    return .{ .session_id = sid(session), .ephemeral_key = key_of(epk) };
}

/// `[VERIFIED]` Validate that ephemeral keys are never reused across sessions.
pub fn validate_ephemeral_key_reuse(records: []EphemeralKeyRecord) -> ?EphemeralReuseError {
    if (records.len > EPKR_MAX_RECORDS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < records.len) {
        const r = records[i];
        // 1. zero session id
        if (eq32(r.session_id, zero32())) {
            return .ZeroSession;
        }
        // 2. zero ephemeral key
        if (eq32(r.ephemeral_key, zero32())) {
            return .ZeroKey;
        }
        // 3. duplicate session id
        var j: usize = 0;
        while (j < i) {
            if (eq32(records[j].session_id, r.session_id)) {
                return .DuplicateSession;
            }
            j += 1;
        }
        // 4. ephemeral key already owned by any (other) session
        j = 0;
        while (j < i) {
            if (eq32(records[j].ephemeral_key, r.ephemeral_key)) {
                return .CrossSessionReuse;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors epkr_01..epkr_10 in the Rust source)
// ---------------------------------------------------------------------------

test epkr_01_cross_session_rejected {
    var rs: [2]EphemeralKeyRecord = undefined;
    rs[0] = record(0x01, 0xAA);
    rs[1] = record(0x02, 0xAA);
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == .CrossSessionReuse);
}

test epkr_02_zero_key_rejected {
    var rs: [1]EphemeralKeyRecord = undefined;
    rs[0] = .{ .session_id = sid(0x01), .ephemeral_key = key_of(0) };
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == .ZeroKey);
}

test epkr_03_zero_session_rejected {
    var rs: [1]EphemeralKeyRecord = undefined;
    rs[0] = .{ .session_id = sid(0), .ephemeral_key = key_of(0xAA) };
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == .ZeroSession);
}

test epkr_04_duplicate_session_rejected {
    var rs: [2]EphemeralKeyRecord = undefined;
    rs[0] = record(0x01, 0xA1);
    rs[1] = record(0x01, 0xA2);
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == .DuplicateSession);
}

test epkr_05_too_many_rejected {
    var rs: [EPKR_MAX_RECORDS + 1]EphemeralKeyRecord = undefined;
    var i: usize = 0;
    while (i <= EPKR_MAX_RECORDS) {
        const val: u64 = @intCast(i + 1);
        var session: [32]u8 = sid(0);
        var epk: [32]u8 = key_of(0);
        session[0] = @intCast((val / 256) % 256);
        session[1] = @intCast(val % 256);
        epk[0] = @intCast((val / 256) % 256);
        epk[1] = @intCast(val % 256);
        rs[i] = .{ .session_id = session, .ephemeral_key = epk };
        i += 1;
    }
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == .TooMany);
}

test epkr_06_valid_accepted {
    var rs: [3]EphemeralKeyRecord = undefined;
    rs[0] = record(0x01, 0xA1);
    rs[1] = record(0x02, 0xA2);
    rs[2] = record(0x03, 0xA3);
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == null);
}

test epkr_07_empty_accepted {
    var rs: [0]EphemeralKeyRecord = undefined;
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == null);
}

test epkr_08_single_accepted {
    var rs: [1]EphemeralKeyRecord = undefined;
    rs[0] = record(0x01, 0xAA);
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == null);
}

test epkr_09_many_unique_accepted {
    var rs: [100]EphemeralKeyRecord = undefined;
    var i: usize = 0;
    while (i < 100) {
        const val: u64 = @intCast(i + 1);
        var session: [32]u8 = sid(0);
        var epk: [32]u8 = key_of(0);
        session[0] = @intCast((val / 256) % 256);
        session[1] = @intCast(val % 256);
        epk[0] = @intCast(((val + 1000) / 256) % 256);
        epk[1] = @intCast((val + 1000) % 256);
        rs[i] = .{ .session_id = session, .ephemeral_key = epk };
        i += 1;
    }
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == null);
}

test epkr_10_max_boundary_accepted {
    var rs: [EPKR_MAX_RECORDS]EphemeralKeyRecord = undefined;
    var i: usize = 0;
    while (i < EPKR_MAX_RECORDS) {
        const val: u64 = @intCast(i + 1);
        var session: [32]u8 = sid(0);
        var epk: [32]u8 = key_of(0);
        session[0] = @intCast((val / 256) % 256);
        session[1] = @intCast(val % 256);
        epk[0] = @intCast(((val + 5000) / 256) % 256);
        epk[1] = @intCast((val + 5000) % 256);
        rs[i] = .{ .session_id = session, .ephemeral_key = epk };
        i += 1;
    }
    const result = validate_ephemeral_key_reuse(&rs);
    assert(result == null);
}

pub fn main() void {
    epkr_01_cross_session_rejected();
    epkr_02_zero_key_rejected();
    epkr_03_zero_session_rejected();
    epkr_04_duplicate_session_rejected();
    epkr_05_too_many_rejected();
    epkr_06_valid_accepted();
    epkr_07_empty_accepted();
    epkr_08_single_accepted();
    epkr_09_many_unique_accepted();
    epkr_10_max_boundary_accepted();
}
