module port::double_ratchet_sending_chain_rotation_guard;
// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/double_ratchet_sending_chain_rotation_guard.rs @ 8b229e9489ee (182 lines: 1 function, 2 constants, 1 struct, 1 enum, 10 tests DSCR-01..10).
// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/double_ratchet_sending_chain_rotation_guard.rs @ 8b229e9489ee (182 lines: 1 function, 2 constants, 1 struct, 1 enum, 10 tests DSCR-01..10).
// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/double_ratchet_sending_chain_rotation_guard.rs @ 8b229e9489ee (182 lines: 1 function, 2 constants, 1 struct, 1 enum, 10 tests DSCR-01..10).
// Ring: CR-CHAT-02 (Wave-97 Lane B).
// Domain: RATCHET — sending chain rotation validation.
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * SENDING-CHAIN-ROTATION
//
// Toolchain note (t27c 0.5.2): payload-carrying enum variants cannot be
// lowered to Zig yet, so ChainRotationError uses bare variants (as the
// sibling epoch_rollover_wraparound_guard does) and does not carry the
// offending chain id or message count.

/// Maximum number of message keys a single sending chain may hold.
pub const DSCR_MAX_MESSAGES: u64 = 1000;

/// Maximum number of sending chains a rotation history may contain.
pub const DSCR_MAX_CHAINS: usize = 256;

/// One Double Ratchet sending chain in a rotation history.
pub struct SendingChain {
    chain_id: u64,
    message_count: u64,
}

/// Rejections for a sending chain rotation history (bare variants).
pub enum ChainRotationError {
    /// A chain id is zero; ids must start at 1.
    ZeroChainId,
    /// A chain id repeats an earlier chain's id.
    DuplicateChainId,
    /// The history holds more chains than DSCR_MAX_CHAINS.
    TooManyChains,
    /// A chain holds more than DSCR_MAX_MESSAGES message keys.
    TooManyMessages,
}

/// `[VERIFIED]` Validate a Double Ratchet sending chain rotation history.
///
/// Returns `null` when `chains` is a valid rotation history: at most
/// `DSCR_MAX_CHAINS` chains, every chain id non-zero and unique, and every
/// message count at most `DSCR_MAX_MESSAGES`. Otherwise returns the first
/// violation found, in scan order: total chain count, then per chain —
/// zero id, duplicate id, message count.
pub fn validate_sending_chain_rotation(chains: []SendingChain) -> ?ChainRotationError {
    if (chains.len > DSCR_MAX_CHAINS) {
        return .TooManyChains;
    }
    var i: usize = 0;
    for (chains) |chain| {
        if (chain.chain_id == 0) {
            return .ZeroChainId;
        }
        var j: usize = 0;
        for (chains) |earlier| {
            if ((j < i) and (earlier.chain_id == chain.chain_id)) {
                return .DuplicateChainId;
            }
            j += 1;
        }
        if (chain.message_count > DSCR_MAX_MESSAGES) {
            return .TooManyMessages;
        }
        i += 1;
    }
    return null;
}

// --- tests ---------------------------------------------------------------

// **DSCR-01** — a single fresh sending chain is accepted.
test dscr_01_single_chain_accepted {
    var chains: [1]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 1, .message_count = 5 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == null);
}

// **DSCR-02** — an empty rotation history is accepted.
test dscr_02_empty_history_accepted {
    var chains: [0]SendingChain = undefined;
    const result = validate_sending_chain_rotation(&chains);
    assert(result == null);
}

// **DSCR-03** — a chain with id 0 is rejected wherever it appears.
test dscr_03_zero_chain_id_rejected {
    var chains: [2]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 4, .message_count = 10 };
    chains[1] = SendingChain { .chain_id = 0, .message_count = 10 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == .ZeroChainId);
}

// **DSCR-04** — a chain exceeding DSCR_MAX_MESSAGES is rejected.
test dscr_04_too_many_messages_rejected {
    var chains: [1]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 7, .message_count = 1001 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == .TooManyMessages);
}

// **DSCR-05** — a chain at exactly DSCR_MAX_MESSAGES is accepted; the
// message bound is exclusive.
test dscr_05_max_messages_accepted {
    var chains: [1]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 7, .message_count = 1000 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == null);
}

// **DSCR-06** — a repeated chain id is rejected.
test dscr_06_duplicate_chain_id_rejected {
    var chains: [2]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 3, .message_count = 5 };
    chains[1] = SendingChain { .chain_id = 3, .message_count = 9 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == .DuplicateChainId);
}

// **DSCR-07** — a multi-chain history with distinct ids and bounded
// counts is accepted.
test dscr_07_rotation_history_accepted {
    var chains: [3]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 1, .message_count = 100 };
    chains[1] = SendingChain { .chain_id = 2, .message_count = 200 };
    chains[2] = SendingChain { .chain_id = 3, .message_count = 300 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == null);
}

// **DSCR-08** — a history of exactly DSCR_MAX_CHAINS chains is accepted;
// the chain-count bound is exclusive.
test dscr_08_max_chains_accepted {
    var chains: [DSCR_MAX_CHAINS]SendingChain = undefined;
    var i: usize = 0;
    while (i < DSCR_MAX_CHAINS) {
        const id: u64 = @intCast(i);
        chains[i] = SendingChain { .chain_id = id + 1, .message_count = 10 };
        i += 1;
    }
    const result = validate_sending_chain_rotation(&chains);
    assert(result == null);
}

// **DSCR-09** — a history of DSCR_MAX_CHAINS + 1 chains is rejected
// before any per-chain checks run.
test dscr_09_too_many_chains_rejected {
    var chains: [DSCR_MAX_CHAINS + 1]SendingChain = undefined;
    var i: usize = 0;
    while (i < DSCR_MAX_CHAINS + 1) {
        const id: u64 = @intCast(i);
        chains[i] = SendingChain { .chain_id = id + 1, .message_count = 10 };
        i += 1;
    }
    const result = validate_sending_chain_rotation(&chains);
    assert(result == .TooManyChains);
}

// **DSCR-10** — the first violation wins: a zero id on the earliest chain
// is reported even though a later chain repeats an id and counts overflow.
test dscr_10_first_error_wins {
    var chains: [3]SendingChain = undefined;
    chains[0] = SendingChain { .chain_id = 0, .message_count = 5001 };
    chains[1] = SendingChain { .chain_id = 5, .message_count = 10 };
    chains[2] = SendingChain { .chain_id = 5, .message_count = 20 };
    const result = validate_sending_chain_rotation(&chains);
    assert(result == .ZeroChainId);
}
