// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/root_key_derivation_salt_uniqueness_guard.rs @ 8b229e9489ee (224 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — root-key derivation salts must be unique,
// non-zero, differ from the previous root key, and sessions must be non-zero.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * SALT-UNIQUE`.
//
// Port decisions:
// * SaltUniquenessError payloads (idx, got, max) lowered to bare variants
//   (?SaltUniquenessError; null = Ok(())), per the ring-wide lowering
//   decision.
// * BTreeSet<[u8; 32]> salt tracking replaced by an O(n^2) scan over earlier
//   derivations; decision order preserved: batch bound, zero session,
//   zero salt, salt == previous root key, duplicate salt.

module port::root_key_derivation_salt_uniqueness_guard;

/// Salt length.
pub const RKDS_SALT_LEN: usize = 32;

/// Session id length.
pub const RKDS_SESSION_ID_LEN: usize = 32;

/// Maximum derivations per batch.
pub const RKDS_MAX_DERIVATIONS: usize = 1024;

/// One root-key salt derivation.
pub struct SaltDerivation {
    session_id: [RKDS_SESSION_ID_LEN]u8,
    salt: [RKDS_SALT_LEN]u8,
    prev_root_key: [RKDS_SALT_LEN]u8,
}

/// All ways salt-uniqueness validation can fail.
pub enum SaltUniquenessError {
    DuplicateSalt,
    ZeroSalt,
    ZeroSession,
    SaltEqualsRootKey,
    TooMany,
}

fn sid(byte: u8) [RKDS_SESSION_ID_LEN]u8 {
    var out: [RKDS_SESSION_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKDS_SESSION_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

fn arr(byte: u8) [RKDS_SALT_LEN]u8 {
    var out: [RKDS_SALT_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < RKDS_SALT_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn derivation(session: u8, salt: u8, prev: u8) SaltDerivation {
    return .{ .session_id = sid(session), .salt = arr(salt), .prev_root_key = arr(prev) };
}

pub fn valid_derivations() [3]SaltDerivation {
    var ds: [3]SaltDerivation = undefined;
    ds[0] = derivation(0x01, 0xAA, 0x10);
    ds[1] = derivation(0x01, 0xBB, 0x20);
    ds[2] = derivation(0x02, 0xCC, 0x30);
    return ds;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate root-key derivation salt uniqueness.
pub fn validate_salt_uniqueness(derivations: []SaltDerivation) -> ?SaltUniquenessError {
    if (derivations.len > RKDS_MAX_DERIVATIONS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < derivations.len) {
        const d = derivations[i];
        // 1. non-zero session id
        if (eq32(d.session_id, sid(0))) {
            return .ZeroSession;
        }
        // 2. non-zero salt
        if (eq32(d.salt, arr(0))) {
            return .ZeroSalt;
        }
        // 3. salt differs from previous root key
        if (eq32(d.salt, d.prev_root_key)) {
            return .SaltEqualsRootKey;
        }
        // 4. unique salt
        var j: usize = 0;
        while (j < i) {
            if (eq32(derivations[j].salt, d.salt)) {
                return .DuplicateSalt;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rkds_01..rkds_10 in the Rust source)
// ---------------------------------------------------------------------------

test rkds_01_duplicate_rejected {
    var ds: [2]SaltDerivation = undefined;
    ds[0] = derivation(0x01, 0xAA, 0x10);
    ds[1] = derivation(0x01, 0xAA, 0x20);
    const result = validate_salt_uniqueness(&ds);
    assert(result == .DuplicateSalt);
}

test rkds_02_zero_salt_rejected {
    var d: SaltDerivation = derivation(0x01, 0x01, 0x10);
    d.salt = arr(0);
    const result = validate_salt_uniqueness(&[d]);
    assert(result == .ZeroSalt);
}

test rkds_03_zero_session_rejected {
    var d: SaltDerivation = derivation(0x01, 0xAA, 0x10);
    d.session_id = sid(0);
    const result = validate_salt_uniqueness(&[d]);
    assert(result == .ZeroSession);
}

test rkds_04_salt_equals_root_rejected {
    var ds: [1]SaltDerivation = undefined;
    ds[0] = derivation(0x01, 0xAA, 0xAA);
    const result = validate_salt_uniqueness(&ds);
    assert(result == .SaltEqualsRootKey);
}

test rkds_05_too_many_rejected {
    var ds: [RKDS_MAX_DERIVATIONS + 1]SaltDerivation = undefined;
    var i: usize = 0;
    while (i <= RKDS_MAX_DERIVATIONS) {
        const b: u8 = @intCast((i % 254) + 1);
        ds[i] = derivation(b, b, 0xFF);
        i += 1;
    }
    const result = validate_salt_uniqueness(&ds);
    assert(result == .TooMany);
}

test rkds_06_same_salt_diff_session_rejected {
    var ds: [2]SaltDerivation = undefined;
    ds[0] = derivation(0x01, 0xAA, 0x10);
    ds[1] = derivation(0x02, 0xAA, 0x20);
    const result = validate_salt_uniqueness(&ds);
    assert(result == .DuplicateSalt);
}

test rkds_07_valid_accepted {
    var ds = valid_derivations();
    const result = validate_salt_uniqueness(&ds);
    assert(result == null);
}

test rkds_08_empty_accepted {
    var ds: [0]SaltDerivation = undefined;
    const result = validate_salt_uniqueness(&ds);
    assert(result == null);
}

test rkds_09_single_accepted {
    var ds: [1]SaltDerivation = undefined;
    ds[0] = derivation(0x01, 0xAA, 0x10);
    const result = validate_salt_uniqueness(&ds);
    assert(result == null);
}

test rkds_10_max_boundary_accepted {
    var ds: [RKDS_MAX_DERIVATIONS]SaltDerivation = undefined;
    var i: usize = 0;
    while (i < RKDS_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var session: [RKDS_SESSION_ID_LEN]u8 = sid(0);
        var salt: [RKDS_SALT_LEN]u8 = arr(0);
        var prev: [RKDS_SALT_LEN]u8 = arr(0);
        session[6] = @intCast((val / 256) % 256);
        session[7] = @intCast(val % 256);
        salt[6] = session[6];
        salt[7] = session[7];
        prev[0] = 0xFF;
        ds[i] = .{ .session_id = session, .salt = salt, .prev_root_key = prev };
        i += 1;
    }
    const result = validate_salt_uniqueness(&ds);
    assert(result == null);
}

pub fn main() void {
    rkds_01_duplicate_rejected();
    rkds_02_zero_salt_rejected();
    rkds_03_zero_session_rejected();
    rkds_04_salt_equals_root_rejected();
    rkds_05_too_many_rejected();
    rkds_06_same_salt_diff_session_rejected();
    rkds_07_valid_accepted();
    rkds_08_empty_accepted();
    rkds_09_single_accepted();
    rkds_10_max_boundary_accepted();
}
