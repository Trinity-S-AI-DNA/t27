// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/receiving_chain_gap_bound_guard.rs @ 8b229e9489ee (234 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — receiving-chain message gaps are bounded per gap
// and in total; counters must be non-zero, ranges unique, and batches ordered.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * GAP-BOUNDED`.
//
// Port decisions:
// * GapBoundError payloads (idx, gap, max, prev, current, total) lowered to
//   bare variants (?GapBoundError; null = Ok(())), per the ring-wide
//   lowering decision.
// * BTreeSet<(u64, u64)> duplicate tracking replaced by an O(n^2) scan over
//   earlier records; decision order preserved: batch bound, zero counter,
//   gap size, duplicate range, ordering, total bound.
// * u64::saturating_sub modeled explicitly (before < after yields gap 0).

module port::receiving_chain_gap_bound_guard;

/// Maximum size of a single chain gap.
pub const RCGB_MAX_GAP: u64 = 1024;

/// Maximum total gap counters per batch.
pub const RCGB_MAX_TOTAL_GAPS: u64 = 8192;

/// Maximum gaps per validation batch.
pub const RCGB_MAX_BATCH: usize = 256;

/// A gap in the receiving chain message counters.
pub struct ChainGap {
    after: u64,
    before: u64,
}

/// All ways gap-bound validation can fail.
pub enum GapBoundError {
    GapTooLarge,
    TotalExceeded,
    ZeroCounter,
    NotOrdered,
    DuplicateRange,
    BatchTooLarge,
}

pub fn gap(after: u64, before: u64) ChainGap {
    return .{ .after = after, .before = before };
}

pub fn valid_gaps() [3]ChainGap {
    var gs: [3]ChainGap = undefined;
    gs[0] = gap(10, 15);
    gs[1] = gap(20, 25);
    gs[2] = gap(30, 35);
    return gs;
}

/// `[VERIFIED]` Validate receiving-chain gaps.
pub fn validate_chain_gaps(gaps: []ChainGap) -> ?GapBoundError {
    if (gaps.len > RCGB_MAX_BATCH) {
        return .BatchTooLarge;
    }
    var prev_end: u64 = 0;
    var total_gaps: u64 = 0;
    var i: usize = 0;
    while (i < gaps.len) {
        const g = gaps[i];
        // 1. non-zero counters
        if (g.after == 0 or g.before == 0) {
            return .ZeroCounter;
        }
        // 2. per-gap bound (saturating subtraction)
        var gap_size: u64 = 0;
        if (g.before > g.after) {
            gap_size = g.before - g.after;
        }
        if (gap_size > RCGB_MAX_GAP) {
            return .GapTooLarge;
        }
        // 3. duplicate range
        var j: usize = 0;
        while (j < i) {
            if (gaps[j].after == g.after and gaps[j].before == g.before) {
                return .DuplicateRange;
            }
            j += 1;
        }
        // 4. ordering
        if (i > 0 and g.after < prev_end) {
            return .NotOrdered;
        }
        // 5. running total bound
        total_gaps += gap_size;
        if (total_gaps > RCGB_MAX_TOTAL_GAPS) {
            return .TotalExceeded;
        }
        prev_end = g.before;
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rcgb_01..rcgb_10 in the Rust source)
// ---------------------------------------------------------------------------

test rcgb_01_gap_too_large_rejected {
    var gs: [1]ChainGap = undefined;
    gs[0] = gap(1, RCGB_MAX_GAP + 2);
    const result = validate_chain_gaps(&gs);
    assert(result == .GapTooLarge);
}

test rcgb_02_total_exceeded_rejected {
    var gs: [RCGB_MAX_TOTAL_GAPS / 100 + 1]ChainGap = undefined;
    var i: usize = 0;
    while (i <= RCGB_MAX_TOTAL_GAPS / 100) {
        const base: u64 = @intCast(i * 200);
        gs[i] = gap(base + 1, base + 101);
        i += 1;
    }
    const result = validate_chain_gaps(&gs);
    assert(result == .TotalExceeded);
}

test rcgb_03_zero_counter_rejected {
    var gs: [1]ChainGap = undefined;
    gs[0] = gap(0, 10);
    const result = validate_chain_gaps(&gs);
    assert(result == .ZeroCounter);
}

test rcgb_04_not_ordered_rejected {
    var gs: [2]ChainGap = undefined;
    gs[0] = gap(50, 60);
    gs[1] = gap(30, 40);
    const result = validate_chain_gaps(&gs);
    assert(result == .NotOrdered);
}

test rcgb_05_duplicate_rejected {
    var gs: [2]ChainGap = undefined;
    gs[0] = gap(10, 20);
    gs[1] = gap(10, 20);
    const result = validate_chain_gaps(&gs);
    assert(result == .DuplicateRange);
}

test rcgb_06_batch_too_large_rejected {
    var gs: [RCGB_MAX_BATCH + 1]ChainGap = undefined;
    var i: usize = 0;
    while (i <= RCGB_MAX_BATCH) {
        const base: u64 = @intCast(i * 2000);
        gs[i] = gap(base + 1, base + 10);
        i += 1;
    }
    const result = validate_chain_gaps(&gs);
    assert(result == .BatchTooLarge);
}

test rcgb_07_valid_accepted {
    var gs = valid_gaps();
    const result = validate_chain_gaps(&gs);
    assert(result == null);
}

test rcgb_08_empty_accepted {
    var gs: [0]ChainGap = undefined;
    const result = validate_chain_gaps(&gs);
    assert(result == null);
}

test rcgb_09_max_gap_accepted {
    var gs: [1]ChainGap = undefined;
    gs[0] = gap(1, RCGB_MAX_GAP + 1);
    const result = validate_chain_gaps(&gs);
    assert(result == null);
}

test rcgb_10_zero_before_rejected {
    var gs: [1]ChainGap = undefined;
    gs[0] = gap(10, 0);
    const result = validate_chain_gaps(&gs);
    assert(result == .ZeroCounter);
}

pub fn main() void {
    rcgb_01_gap_too_large_rejected();
    rcgb_02_total_exceeded_rejected();
    rcgb_03_zero_counter_rejected();
    rcgb_04_not_ordered_rejected();
    rcgb_05_duplicate_rejected();
    rcgb_06_batch_too_large_rejected();
    rcgb_07_valid_accepted();
    rcgb_08_empty_accepted();
    rcgb_09_max_gap_accepted();
    rcgb_10_zero_before_rejected();
}
