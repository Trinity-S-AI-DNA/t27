// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/chain_key_forward_seed_uniqueness_guard.rs @ 8b229e9489ee (204 lines).
// Ring: CR-CHAT-02 (Wave-66 Lane B). Issue: gHashTag/t27#8882.
// Domain: RATCHET — each chain step must produce a unique forward seed,
// R-CHAT-2. Duplicate, zero, or badly sized seeds break forward secrecy
// (seed collision across epochs, all-zeros default, short-seed collisions).
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * CHAIN-SEED-UNIQUE`.
//
// Port decisions (t27):
// * ChainSeedError is a bare-variant enum; the validator returns
//   ?ChainSeedError with null meaning Ok(()).
// * Rust `&[&[u8]]` seeds are modeled as fixed-capacity Seed buffers with an
//   explicit `len` field (cap = CKFU_MAX_SEED_LEN). A Seed whose `len` exceeds
//   the cap represents an oversized seed: only `len` drives the checks, so the
//   SeedTooLong rejection is preserved without a larger buffer.
// * The BTreeSet duplicate tracker is replaced by an O(n^2) prefix scan.

module port::chain_key_forward_seed_uniqueness_guard;

/// Minimum seed length (bytes).
pub const CKFU_MIN_SEED_LEN: usize = 16;
/// Maximum seed length (bytes).
pub const CKFU_MAX_SEED_LEN: usize = 64;
/// Maximum chain length.
pub const CKFU_MAX_CHAIN_LEN: usize = 1024;

/// A chain seed: fixed-capacity byte buffer with explicit length.
pub struct Seed {
    len: usize,
    bytes: [64]u8,
}

/// All ways chain seed uniqueness can fail.
pub enum ChainSeedError {
    /// Duplicate seed in chain.
    DuplicateSeed,
    /// Zero seed found.
    ZeroSeed,
    /// Seed too short.
    SeedTooShort,
    /// Seed too long.
    SeedTooLong,
    /// Chain too long.
    ChainTooLong,
    /// Chain too short (need >= 2 seeds to compare).
    ChainTooShort,
}

/// `[VERIFIED]` Validate that all seeds in a ratchet chain are unique,
/// non-zero, and within the length bounds.
pub fn validate_chain_seed_uniqueness(seeds: []Seed) -> ?ChainSeedError {
    if (seeds.len < 2) {
        return .ChainTooShort;
    }
    if (seeds.len > CKFU_MAX_CHAIN_LEN) {
        return .ChainTooLong;
    }
    var i: usize = 0;
    while (i < seeds.len) {
        if (seeds[i].len < CKFU_MIN_SEED_LEN) {
            return .SeedTooShort;
        }
        if (seeds[i].len > CKFU_MAX_SEED_LEN) {
            return .SeedTooLong;
        }
        var all_zero = true;
        var b: usize = 0;
        while (b < seeds[i].len) {
            if (seeds[i].bytes[b] != 0) {
                all_zero = false;
            }
            b += 1;
        }
        if (all_zero) {
            return .ZeroSeed;
        }
        var j: usize = 0;
        while (j < i) {
            if (seeds_equal(seeds[i], seeds[j])) {
                return .DuplicateSeed;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

fn seeds_equal(a: Seed, b: Seed) bool {
    if (a.len != b.len) {
        return false;
    }
    var k: usize = 0;
    while (k < a.len) {
        if (a.bytes[k] != b.bytes[k]) {
            return false;
        }
        k += 1;
    }
    return true;
}

// ---- Tests CKFU-01..10 (ported from mod tests) ----

fn seed(byte: u8) Seed {
    var s: Seed = undefined;
    s.len = CKFU_MIN_SEED_LEN;
    var i: usize = 0;
    while (i < CKFU_MAX_SEED_LEN) {
        s.bytes[i] = byte;
        i += 1;
    }
    return s;
}

fn seed_of_len(byte: u8, len: usize) Seed {
    var s: Seed = undefined;
    s.len = len;
    var i: usize = 0;
    while (i < CKFU_MAX_SEED_LEN) {
        s.bytes[i] = byte;
        i += 1;
    }
    return s;
}

/// **CKFU-01** — duplicate seed rejected.
test ckfu_01_duplicate_rejected {
    var pair: [2]Seed = undefined;
    pair[0] = seed(0xAA);
    pair[1] = seed(0xAA);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == .DuplicateSeed);
}

/// **CKFU-02** — zero seed rejected.
test ckfu_02_zero_seed_rejected {
    var pair: [2]Seed = undefined;
    pair[0] = seed(0x00);
    pair[1] = seed(0x01);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == .ZeroSeed);
}

/// **CKFU-03** — seed too short rejected.
test ckfu_03_too_short_rejected {
    var pair: [2]Seed = undefined;
    pair[0] = seed_of_len(0x01, 8);
    pair[1] = seed(0x02);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == .SeedTooShort);
}

/// **CKFU-04** — seed too long rejected.
test ckfu_04_too_long_rejected {
    var pair: [2]Seed = undefined;
    pair[0] = seed_of_len(0x01, CKFU_MAX_SEED_LEN + 1);
    pair[1] = seed(0x02);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == .SeedTooLong);
}

/// **CKFU-05** — chain too long rejected.
test ckfu_05_too_long_rejected {
    var ss: [CKFU_MAX_CHAIN_LEN + 1]Seed = undefined;
    var i: usize = 0;
    while (i <= CKFU_MAX_CHAIN_LEN) {
        var s: Seed = undefined;
        s.len = CKFU_MIN_SEED_LEN;
        var k: usize = 0;
        while (k < CKFU_MAX_SEED_LEN) {
            s.bytes[k] = 0;
            k += 1;
        }
        s.bytes[0] = @intCast(i % 256);
        s.bytes[1] = @intCast((i / 256) % 256);
        ss[i] = s;
        i += 1;
    }
    const result = validate_chain_seed_uniqueness(&ss);
    assert(result == .ChainTooLong);
}

/// **CKFU-06** — chain too short rejected (need >= 2 seeds).
test ckfu_06_too_short_rejected {
    var single: [1]Seed = undefined;
    single[0] = seed(0x01);
    const result = validate_chain_seed_uniqueness(&single);
    assert(result == .ChainTooShort);
}

/// **CKFU-07** — good chain accepted.
test ckfu_07_good_accepted {
    var ss: [3]Seed = undefined;
    ss[0] = seed(0x01);
    ss[1] = seed(0x02);
    ss[2] = seed(0x03);
    const result = validate_chain_seed_uniqueness(&ss);
    assert(result == null);
}

/// **CKFU-08** — two distinct seeds accepted.
test ckfu_08_two_seeds_accepted {
    var pair: [2]Seed = undefined;
    pair[0] = seed(0x01);
    pair[1] = seed(0x02);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == null);
}

/// **CKFU-09** — minimum seed length accepted.
test ckfu_09_min_len_accepted {
    var pair: [2]Seed = undefined;
    pair[0] = seed_of_len(0x01, CKFU_MIN_SEED_LEN);
    pair[1] = seed_of_len(0x02, CKFU_MIN_SEED_LEN);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == null);
}

/// **CKFU-10** — maximum seed length accepted.
test ckfu_10_max_len_accepted {
    var pair: [2]Seed = undefined;
    pair[0] = seed_of_len(0x01, CKFU_MAX_SEED_LEN);
    pair[1] = seed_of_len(0x02, CKFU_MAX_SEED_LEN);
    const result = validate_chain_seed_uniqueness(&pair);
    assert(result == null);
}

pub fn main() void {
    ckfu_01_duplicate_rejected();
    ckfu_02_zero_seed_rejected();
    ckfu_03_too_short_rejected();
    ckfu_04_too_long_rejected();
    ckfu_05_too_long_rejected();
    ckfu_06_too_short_rejected();
    ckfu_07_good_accepted();
    ckfu_08_two_seeds_accepted();
    ckfu_09_min_len_accepted();
    ckfu_10_max_len_accepted();
}
