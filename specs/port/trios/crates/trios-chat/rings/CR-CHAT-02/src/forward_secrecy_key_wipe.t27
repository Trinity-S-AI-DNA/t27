// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/forward_secrecy_key_wipe.rs @ 8b229e9489ee (217 lines).
// Ring: CR-CHAT-02 (Wave-36 L-CHAT-2-fskw). Issue: gHashTag/t27#8882.
// Domain: RATCHET — every derivation must advance the epoch and rotate both
// keys; roots and chains must never repeat across the derivation history.
// Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · FORWARD-SECRECY`.
//
// Port decisions:
// * KeyWipeError payloads lowered to bare variants (?KeyWipeError;
//   null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet seen-root/seen-chain tracking replaced by O(n^2) scans over
//   earlier records; decision order preserved: batch bound, zero keys,
//   epoch monotonicity, rotation vs previous record, global uniqueness.

module port::forward_secrecy_key_wipe;

/// Key length.
pub const FSKW_KEY_LEN: usize = 32;
/// Maximum derivations per validation batch.
pub const FSKW_MAX_DERIVATIONS: usize = 1024;

/// One key derivation step.
pub struct KeyDerivation {
    epoch: u64,
    root_key: [32]u8,
    chain_key: [32]u8,
}

/// All ways key-wipe validation can fail.
pub enum KeyWipeError {
    KeyNotRotated,
    WrongKeyLength,
    KeyReused,
    EpochNotMonotonic,
    TooManyDerivations,
    ZeroKey,
}

fn zero32() [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < 32) { out[i] = 0; i += 1; }
    return out;
}

fn eq32(a: [32]u8, b: [32]u8) bool {
    var i: usize = 0;
    while (i < 32) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

pub fn key(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < FSKW_KEY_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn deriv(epoch: u64, rk: u8, ck: u8) KeyDerivation {
    return .{ .epoch = epoch, .root_key = key(rk), .chain_key = key(ck) };
}

/// `[VERIFIED]` Validate the derivation history for forward secrecy.
pub fn validate_key_derivations(derivations: []KeyDerivation) -> ?KeyWipeError {
    if (derivations.len > FSKW_MAX_DERIVATIONS) {
        return .TooManyDerivations;
    }
    var i: usize = 0;
    while (i < derivations.len) {
        const d = derivations[i];
        // 1. zero keys
        if (eq32(d.root_key, zero32())) {
            return .ZeroKey;
        }
        if (eq32(d.chain_key, zero32())) {
            return .ZeroKey;
        }
        if (i > 0) {
            const prev = derivations[i - 1];
            // 2. epoch monotonicity
            if (d.epoch <= prev.epoch) {
                return .EpochNotMonotonic;
            }
            // 3. rotation vs previous record
            if (eq32(d.root_key, prev.root_key)) {
                return .KeyNotRotated;
            }
            if (eq32(d.chain_key, prev.chain_key)) {
                return .KeyNotRotated;
            }
        }
        // 4. global uniqueness of roots and chains
        var j: usize = 0;
        while (j < i) {
            if (eq32(derivations[j].root_key, d.root_key)) {
                return .KeyReused;
            }
            if (eq32(derivations[j].chain_key, d.chain_key)) {
                return .KeyReused;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors fskw_01..fskw_10 in the Rust source)
// ---------------------------------------------------------------------------

test fskw_01_not_rotated_rejected {
    var d: [2]KeyDerivation = undefined;
    d[0] = deriv(1, 0x01, 0x11);
    d[1] = deriv(2, 0x01, 0x12);
    const result = validate_key_derivations(&d);
    assert(result == .KeyNotRotated);
}

test fskw_02_key_reused_rejected {
    var d: [3]KeyDerivation = undefined;
    d[0] = deriv(1, 0x01, 0x11);
    d[1] = deriv(2, 0x02, 0x12);
    d[2] = deriv(3, 0x01, 0x13);
    const result = validate_key_derivations(&d);
    assert(result == .KeyReused);
}

test fskw_03_epoch_not_monotonic_rejected {
    var d: [2]KeyDerivation = undefined;
    d[0] = deriv(2, 0x01, 0x11);
    d[1] = deriv(1, 0x02, 0x12);
    const result = validate_key_derivations(&d);
    assert(result == .EpochNotMonotonic);
}

test fskw_04_too_many_rejected {
    var d: [FSKW_MAX_DERIVATIONS + 1]KeyDerivation = undefined;
    var i: usize = 0;
    while (i <= FSKW_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var rk: [32]u8 = key(0);
        var ck: [32]u8 = key(0);
        rk[0] = @intCast(val % 256);
        rk[1] = @intCast((val / 256) % 256);
        ck[0] = @intCast(val % 256);
        ck[1] = @intCast((val / 256) % 256);
        ck[8] = 1;
        d[i] = .{ .epoch = val, .root_key = rk, .chain_key = ck };
        i += 1;
    }
    const result = validate_key_derivations(&d);
    assert(result == .TooManyDerivations);
}

test fskw_05_zero_key_rejected {
    var d: [1]KeyDerivation = undefined;
    d[0] = .{ .epoch = 1, .root_key = key(0x01), .chain_key = key(0) };
    const result = validate_key_derivations(&d);
    assert(result == .ZeroKey);
}

test fskw_06_good_accepted {
    var d: [3]KeyDerivation = undefined;
    d[0] = deriv(1, 0x01, 0x11);
    d[1] = deriv(2, 0x02, 0x12);
    d[2] = deriv(3, 0x03, 0x13);
    const result = validate_key_derivations(&d);
    assert(result == null);
}

test fskw_07_empty_accepted {
    var d: [0]KeyDerivation = undefined;
    const result = validate_key_derivations(&d);
    assert(result == null);
}

test fskw_08_single_accepted {
    var d: [1]KeyDerivation = undefined;
    d[0] = deriv(1, 0xAA, 0xBB);
    const result = validate_key_derivations(&d);
    assert(result == null);
}

test fskw_09_chain_not_rotated_rejected {
    var d: [2]KeyDerivation = undefined;
    d[0] = deriv(1, 0x01, 0x11);
    d[1] = deriv(2, 0x02, 0x11);
    const result = validate_key_derivations(&d);
    assert(result == .KeyNotRotated);
}

test fskw_10_max_accepted {
    var d: [FSKW_MAX_DERIVATIONS]KeyDerivation = undefined;
    var i: usize = 0;
    while (i < FSKW_MAX_DERIVATIONS) {
        const val: u64 = @intCast(i + 1);
        var rk: [32]u8 = key(0);
        var ck: [32]u8 = key(0);
        rk[0] = @intCast(val % 256);
        rk[1] = @intCast((val / 256) % 256);
        ck[0] = @intCast(val % 256);
        ck[1] = @intCast((val / 256) % 256);
        ck[8] = 1;
        d[i] = .{ .epoch = val, .root_key = rk, .chain_key = ck };
        i += 1;
    }
    const result = validate_key_derivations(&d);
    assert(result == null);
}

pub fn main() void {
    fskw_01_not_rotated_rejected();
    fskw_02_key_reused_rejected();
    fskw_03_epoch_not_monotonic_rejected();
    fskw_04_too_many_rejected();
    fskw_05_zero_key_rejected();
    fskw_06_good_accepted();
    fskw_07_empty_accepted();
    fskw_08_single_accepted();
    fskw_09_chain_not_rotated_rejected();
    fskw_10_max_accepted();
}
