// Port of crates/trios-chat/rings/CR-CHAT-02/src/kdf_label_domain_separation.rs
// issue #11527. Decisions ported: the six KDF label rules of R-CHAT-2
// (unique labels, min/max length, non-empty, ASCII-printable, label count).
// The Rust type `Result<(), KdfLabelError>` does not exist in .t27, so the
// verdict is returned as `KdfLabelError` with an extra `Ok` variant; that is
// the only signature deviation. `&[&str]` becomes a fixed array plus a count
// because .t27 has no growable slices of slices.
module port::trios::crates::trios_chat::rings::CR_CHAT_02::src::kdf_label_domain_separation;

// Source lines 33-39.
pub const KLDL_MIN_LEN: usize = 4;
pub const KLDL_MAX_LEN: usize = 64;
pub const KLDL_MAX_LABELS: usize = 32;
const MAX_SLOTS: usize = 40;

// Source lines 42-57, plus `Ok` because .t27 has no Result.
pub enum KdfLabelError {
    Ok,
    DuplicateLabel,
    TooShort,
    TooLong,
    EmptyLabel,
    NonAscii,
    TooManyLabels,
}

// Byte-for-byte equality; .t27 only guarantees == when one side is a literal.
fn str_eq(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Source line 75: every byte in 0x20..=0x7E. Rule 5.
fn ascii_printable(label: []const u8) -> bool {
    var i: usize = 0;
    while (i < label.len) {
        const b = label[i];
        if (b < 0x20 || b > 0x7E) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Source lines 60-83. Check order is preserved exactly as written:
// count, then per label empty / too short / too long / non-ascii / duplicate.
pub fn validate_kdf_labels(labels: [MAX_SLOTS][]const u8, count: usize) -> KdfLabelError {
    if (count > KLDL_MAX_LABELS) {
        return KdfLabelError::TooManyLabels;
    }
    var i: usize = 0;
    while (i < count) {
        const label = labels[i];
        if (label.len == 0) {
            return KdfLabelError::EmptyLabel;
        }
        if (label.len < KLDL_MIN_LEN) {
            return KdfLabelError::TooShort;
        }
        if (label.len > KLDL_MAX_LEN) {
            return KdfLabelError::TooLong;
        }
        if (!ascii_printable(label)) {
            return KdfLabelError::NonAscii;
        }
        var j: usize = 0;
        while (j < i) {
            if (str_eq(labels[j], label)) {
                return KdfLabelError::DuplicateLabel;
            }
            j += 1;
        }
        i += 1;
    }
    return KdfLabelError::Ok;
}

// Test scaffolding only: a zeroed label set, mirroring an empty Vec<&str>.
fn blank_labels() -> [MAX_SLOTS][]const u8 {
    var items: [MAX_SLOTS][]const u8 = undefined;
    var i: usize = 0;
    while (i < MAX_SLOTS) {
        items[i] = "";
        i += 1;
    }
    return items;
}

// KLDL-01 (source lines 97-103): a duplicate label is rejected.
test kldl_01_duplicate_rejected {
    var ls = blank_labels();
    ls[0] = "root-key";
    ls[1] = "root-key";
    assert(validate_kdf_labels(ls, 2) == KdfLabelError::DuplicateLabel);
}

// KLDL-02 (source lines 105-112): shorter than KLDL_MIN_LEN.
test kldl_02_too_short_rejected {
    var ls = blank_labels();
    ls[0] = "abc";
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::TooShort);
}

// KLDL-03 (source lines 114-122): longer than KLDL_MAX_LEN.
test kldl_03_too_long_rejected {
    var buf: [65]u8 = undefined;
    var i: usize = 0;
    while (i < 65) {
        buf[i] = 'x';
        i += 1;
    }
    var ls = blank_labels();
    ls[0] = buf[0..65];
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::TooLong);
}

// KLDL-04 (source lines 124-131): the empty label is its own error, not TooShort.
test kldl_04_empty_rejected {
    var ls = blank_labels();
    ls[0] = "";
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::EmptyLabel);
}

// KLDL-05 (source lines 133-140): the Rust test feeds "key\x00v1"; .t27 string
// escapes do not include \x, so the same six byte label is built in a buffer.
test kldl_05_non_ascii_rejected {
    var buf: [6]u8 = undefined;
    buf[0] = 'k';
    buf[1] = 'e';
    buf[2] = 'y';
    buf[3] = 0x00;
    buf[4] = 'v';
    buf[5] = '1';
    var ls = blank_labels();
    ls[0] = buf[0..6];
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::NonAscii);
}

// KLDL-06 (source lines 142-153): 33 labels exceed KLDL_MAX_LABELS.
test kldl_06_too_many_rejected {
    var ls = blank_labels();
    var i: usize = 0;
    while (i < 33) {
        ls[i] = "label-000";
        i += 1;
    }
    assert(validate_kdf_labels(ls, 33) == KdfLabelError::TooManyLabels);
}

// KLDL-07 (source lines 155-159): the four production labels are accepted.
test kldl_07_good_accepted {
    var ls = blank_labels();
    ls[0] = "trios-chat-root-key-v1";
    ls[1] = "trios-chat-chain-key-v1";
    ls[2] = "trios-chat-message-key-v1";
    ls[3] = "trios-chat-handshake-v1";
    assert(validate_kdf_labels(ls, 4) == KdfLabelError::Ok);
}

// KLDL-08 (source lines 161-165): exactly KLDL_MIN_LEN is accepted.
test kldl_08_min_len_accepted {
    var ls = blank_labels();
    ls[0] = "root";
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::Ok);
}

// KLDL-09 (source lines 167-172): exactly KLDL_MAX_LEN is accepted.
test kldl_09_max_len_accepted {
    var buf: [64]u8 = undefined;
    var i: usize = 0;
    while (i < 64) {
        buf[i] = 'x';
        i += 1;
    }
    var ls = blank_labels();
    ls[0] = buf[0..64];
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::Ok);
}

// KLDL-10 (source lines 174-178): one well-formed label is accepted.
test kldl_10_single_accepted {
    var ls = blank_labels();
    ls[0] = "trios-chat-root-v1";
    assert(validate_kdf_labels(ls, 1) == KdfLabelError::Ok);
}

// The non-ascii rule is a byte test, not a UTF-8 test: 0x7E passes, 0x7F fails.
test ascii_printable_boundaries {
    assert(ascii_printable("~"));
    var buf: [1]u8 = undefined;
    buf[0] = 0x7F;
    assert(!ascii_printable(buf[0..1]));
    assert(str_eq("abc", "abc"));
    assert(!str_eq("abc", "abd"));
    assert(!str_eq("ab", "abc"));
}
