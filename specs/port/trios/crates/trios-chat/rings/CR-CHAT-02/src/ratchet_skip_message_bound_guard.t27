// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/ratchet_skip_message_bound_guard.rs @ 8b229e9489ee (197 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — skipped ratchet messages are bounded per epoch
// and in total; epochs must be unique, non-zero, and within count bounds.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * RATCHET-SKIP-BOUND`.
//
// Port decisions:
// * SkipBoundError payloads (epoch) lowered to bare variants
//   (?SkipBoundError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet<u64> duplicate tracking replaced by an O(n^2) scan over
//   earlier entries; decision order preserved: batch bound, zero epoch,
//   zero skips, per-epoch bound, duplicate epoch, total bound.

module port::ratchet_skip_message_bound_guard;

/// Maximum total skipped messages.
pub const RSMB_MAX_TOTAL_SKIPPED: usize = 1024;

/// Maximum skipped messages per epoch.
pub const RSMB_MAX_PER_EPOCH: usize = 256;

/// Maximum epochs per validation batch.
pub const RSMB_MAX_EPOCHS: usize = 128;

/// Skipped-message count for one epoch.
pub struct EpochSkipCount {
    epoch: u64,
    skipped: usize,
}

/// All ways skip-bound validation can fail.
pub enum SkipBoundError {
    TotalExceeded,
    PerEpochExceeded,
    ZeroEpoch,
    TooManyEpochs,
    DuplicateEpoch,
    ZeroSkips,
}

pub fn epoch(epoch: u64, skipped: usize) EpochSkipCount {
    return .{ .epoch = epoch, .skipped = skipped };
}

/// `[VERIFIED]` Validate skip bounds.
pub fn validate_skip_bounds(entries: []EpochSkipCount) -> ?SkipBoundError {
    if (entries.len > RSMB_MAX_EPOCHS) {
        return .TooManyEpochs;
    }
    var total: usize = 0;
    var i: usize = 0;
    while (i < entries.len) {
        const entry = entries[i];
        // 1. zero epoch
        if (entry.epoch == 0) {
            return .ZeroEpoch;
        }
        // 2. zero skips
        if (entry.skipped == 0) {
            return .ZeroSkips;
        }
        // 3. per-epoch bound
        if (entry.skipped > RSMB_MAX_PER_EPOCH) {
            return .PerEpochExceeded;
        }
        // 4. duplicate epoch
        var j: usize = 0;
        while (j < i) {
            if (entries[j].epoch == entry.epoch) {
                return .DuplicateEpoch;
            }
            j += 1;
        }
        // 5. running total bound
        total += entry.skipped;
        if (total > RSMB_MAX_TOTAL_SKIPPED) {
            return .TotalExceeded;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors rsmb_01..rsmb_10 in the Rust source)
// ---------------------------------------------------------------------------

test rsmb_01_total_exceeded_rejected {
    // Note: the Rust source labels this "total exceeded" but the per-epoch
    // bound fires first (1025 > 256); the assertion matches PerEpochExceeded.
    var entries: [1]EpochSkipCount = undefined;
    entries[0] = epoch(1, RSMB_MAX_TOTAL_SKIPPED + 1);
    const result = validate_skip_bounds(&entries);
    assert(result == .PerEpochExceeded);
}

test rsmb_02_per_epoch_rejected {
    var entries: [1]EpochSkipCount = undefined;
    entries[0] = epoch(1, RSMB_MAX_PER_EPOCH + 1);
    const result = validate_skip_bounds(&entries);
    assert(result == .PerEpochExceeded);
}

test rsmb_03_zero_epoch_rejected {
    var entries: [1]EpochSkipCount = undefined;
    entries[0] = epoch(0, 10);
    const result = validate_skip_bounds(&entries);
    assert(result == .ZeroEpoch);
}

test rsmb_04_too_many_rejected {
    var entries: [RSMB_MAX_EPOCHS + 1]EpochSkipCount = undefined;
    var i: usize = 0;
    while (i <= RSMB_MAX_EPOCHS) {
        entries[i] = epoch(@intCast(i + 1), 1);
        i += 1;
    }
    const result = validate_skip_bounds(&entries);
    assert(result == .TooManyEpochs);
}

test rsmb_05_duplicate_rejected {
    var entries: [3]EpochSkipCount = undefined;
    entries[0] = epoch(1, 10);
    entries[1] = epoch(2, 20);
    entries[2] = epoch(1, 5);
    const result = validate_skip_bounds(&entries);
    assert(result == .DuplicateEpoch);
}

test rsmb_06_zero_skips_rejected {
    var entries: [1]EpochSkipCount = undefined;
    entries[0] = epoch(1, 0);
    const result = validate_skip_bounds(&entries);
    assert(result == .ZeroSkips);
}

test rsmb_07_valid_accepted {
    var entries: [3]EpochSkipCount = undefined;
    entries[0] = epoch(1, 10);
    entries[1] = epoch(2, 20);
    entries[2] = epoch(3, 5);
    const result = validate_skip_bounds(&entries);
    assert(result == null);
}

test rsmb_08_empty_accepted {
    var entries: [0]EpochSkipCount = undefined;
    const result = validate_skip_bounds(&entries);
    assert(result == null);
}

test rsmb_09_total_boundary_accepted {
    var entries: [4]EpochSkipCount = undefined;
    entries[0] = epoch(1, 256);
    entries[1] = epoch(2, 256);
    entries[2] = epoch(3, 256);
    entries[3] = epoch(4, 256);
    const result = validate_skip_bounds(&entries);
    assert(result == null);
}

test rsmb_10_max_per_epoch_accepted {
    var entries: [1]EpochSkipCount = undefined;
    entries[0] = epoch(1, RSMB_MAX_PER_EPOCH);
    const result = validate_skip_bounds(&entries);
    assert(result == null);
}

pub fn main() void {
    rsmb_01_total_exceeded_rejected();
    rsmb_02_per_epoch_rejected();
    rsmb_03_zero_epoch_rejected();
    rsmb_04_too_many_rejected();
    rsmb_05_duplicate_rejected();
    rsmb_06_zero_skips_rejected();
    rsmb_07_valid_accepted();
    rsmb_08_empty_accepted();
    rsmb_09_total_boundary_accepted();
    rsmb_10_max_per_epoch_accepted();
}
