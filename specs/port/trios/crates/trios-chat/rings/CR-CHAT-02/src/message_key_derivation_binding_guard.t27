// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/message_key_derivation_binding_guard.rs @ 8b229e9489ee (211 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — message-key bindings must bind epoch+chain-index
// slots to 32-byte keys; slots must be unique and keys must be non-zero,
// exactly 32 bytes, and globally unique.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * MSG-KEY-BINDING`.
//
// Port decisions:
// * MsgKeyBindError payloads lowered to bare variants (?MsgKeyBindError;
//   null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet<(epoch, chain_index)> and BTreeSet<Vec<u8>> replaced by O(n^2)
//   scans over earlier records; decision order preserved: zero epoch, chain
//   index bound, key length, zero key, slot collision, duplicate key.
// * Vec<u8> keys modeled as fixed 32-byte buffers + key_len (the length
//   error at 16 bytes stays representable).

module port::message_key_derivation_binding_guard;

/// Exclusive upper bound for chain indices.
pub const MKDB_MAX_CHAIN_INDEX: u32 = 1024;

/// Key length.
pub const MKDB_KEY_LEN: usize = 32;

/// One message-key binding.
pub struct MsgKeyBinding {
    epoch: u64,
    chain_index: u32,
    key: [32]u8,
    key_len: usize,
}

/// All ways binding validation can fail.
pub enum MsgKeyBindError {
    BindingCollision,
    ZeroEpoch,
    ChainIndexOutOfBounds,
    KeyLengthWrong,
    ZeroKey,
    DuplicateKey,
}

fn key(byte: u8) [32]u8 {
    var out: [32]u8 = undefined;
    var i: usize = 0;
    while (i < MKDB_KEY_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn binding(epoch: u64, chain_index: u32, byte: u8) MsgKeyBinding {
    return .{ .epoch = epoch, .chain_index = chain_index, .key = key(byte), .key_len = MKDB_KEY_LEN };
}

fn key_eq(a_key: [32]u8, a_len: usize, b_key: [32]u8, b_len: usize) bool {
    if (a_len != b_len) { return false; }
    var i: usize = 0;
    while (i < a_len) {
        if (a_key[i] != b_key[i]) { return false; }
        i += 1;
    }
    return true;
}

/// `[VERIFIED]` Validate message-key bindings.
pub fn validate_msg_key_binding(bindings: []MsgKeyBinding) -> ?MsgKeyBindError {
    var i: usize = 0;
    while (i < bindings.len) {
        const b = bindings[i];
        // 1. zero epoch
        if (b.epoch == 0) {
            return .ZeroEpoch;
        }
        // 2. chain index in bounds
        if (b.chain_index >= MKDB_MAX_CHAIN_INDEX) {
            return .ChainIndexOutOfBounds;
        }
        // 3. key length
        if (b.key_len != MKDB_KEY_LEN) {
            return .KeyLengthWrong;
        }
        // 4. non-zero key
        var all_zero = true;
        var k: usize = 0;
        while (k < b.key_len) {
            if (b.key[k] != 0) { all_zero = false; }
            k += 1;
        }
        if (all_zero) {
            return .ZeroKey;
        }
        // 5. unique (epoch, chain_index) slot
        var j: usize = 0;
        while (j < i) {
            if (bindings[j].epoch == b.epoch and bindings[j].chain_index == b.chain_index) {
                return .BindingCollision;
            }
            j += 1;
        }
        // 6. globally unique key
        j = 0;
        while (j < i) {
            if (key_eq(bindings[j].key, bindings[j].key_len, b.key, b.key_len)) {
                return .DuplicateKey;
            }
            j += 1;
        }
        i += 1;
    }
    return null;
}

// ---------------------------------------------------------------------------
// Tests (mirrors mkdb_01..mkdb_10 in the Rust source)
// ---------------------------------------------------------------------------

test mkdb_01_collision_rejected {
    var bs: [2]MsgKeyBinding = undefined;
    bs[0] = binding(1, 0, 0x01);
    bs[1] = binding(1, 0, 0x02);
    const result = validate_msg_key_binding(&bs);
    assert(result == .BindingCollision);
}

test mkdb_02_zero_epoch_rejected {
    var bs: [1]MsgKeyBinding = undefined;
    bs[0] = binding(0, 0, 0x01);
    const result = validate_msg_key_binding(&bs);
    assert(result == .ZeroEpoch);
}

test mkdb_03_chain_oob_rejected {
    var bs: [1]MsgKeyBinding = undefined;
    bs[0] = binding(1, MKDB_MAX_CHAIN_INDEX, 0x01);
    const result = validate_msg_key_binding(&bs);
    assert(result == .ChainIndexOutOfBounds);
}

test mkdb_04_key_len_rejected {
    var short_key: [32]u8 = key(0x01);
    var bs: [1]MsgKeyBinding = undefined;
    bs[0] = .{ .epoch = 1, .chain_index = 0, .key = short_key, .key_len = 16 };
    const result = validate_msg_key_binding(&bs);
    assert(result == .KeyLengthWrong);
}

test mkdb_05_zero_key_rejected {
    var bs: [1]MsgKeyBinding = undefined;
    bs[0] = binding(1, 0, 0x00);
    const result = validate_msg_key_binding(&bs);
    assert(result == .ZeroKey);
}

test mkdb_06_dup_key_rejected {
    var bs: [2]MsgKeyBinding = undefined;
    bs[0] = binding(1, 0, 0xAA);
    bs[1] = binding(2, 0, 0xAA);
    const result = validate_msg_key_binding(&bs);
    assert(result == .DuplicateKey);
}

test mkdb_07_valid_accepted {
    var bs: [3]MsgKeyBinding = undefined;
    bs[0] = binding(1, 0, 0x01);
    bs[1] = binding(1, 1, 0x02);
    bs[2] = binding(2, 0, 0x03);
    const result = validate_msg_key_binding(&bs);
    assert(result == null);
}

test mkdb_08_empty_accepted {
    var bs: [0]MsgKeyBinding = undefined;
    const result = validate_msg_key_binding(&bs);
    assert(result == null);
}

test mkdb_09_max_chain_accepted {
    var bs: [1]MsgKeyBinding = undefined;
    bs[0] = binding(1, MKDB_MAX_CHAIN_INDEX - 1, 0x01);
    const result = validate_msg_key_binding(&bs);
    assert(result == null);
}

test mkdb_10_same_epoch_diff_chains_accepted {
    var bs: [3]MsgKeyBinding = undefined;
    bs[0] = binding(1, 0, 0x01);
    bs[1] = binding(1, 1, 0x02);
    bs[2] = binding(1, 2, 0x03);
    const result = validate_msg_key_binding(&bs);
    assert(result == null);
}

pub fn main() void {
    mkdb_01_collision_rejected();
    mkdb_02_zero_epoch_rejected();
    mkdb_03_chain_oob_rejected();
    mkdb_04_key_len_rejected();
    mkdb_05_zero_key_rejected();
    mkdb_06_dup_key_rejected();
    mkdb_07_valid_accepted();
    mkdb_08_empty_accepted();
    mkdb_09_max_chain_accepted();
    mkdb_10_same_epoch_diff_chains_accepted();
}
