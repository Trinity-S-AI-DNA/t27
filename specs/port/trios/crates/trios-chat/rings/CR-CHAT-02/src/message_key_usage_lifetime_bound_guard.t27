// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-02/src/message_key_usage_lifetime_bound_guard.rs @ 8b229e9489ee (247 lines).
// Ring: CR-CHAT-02 (Wave-72 Lane B). Issue: gHashTag/t27#8882.
// Domain: MLS HANDSHAKE — message keys must expire (bounded age), stay
// within usage limits, carry unique non-zero ids, and have well-formed
// creation timestamps.
// Anchor: `phi^2 + phi^-2 = 3 * TRINITY * CHAT * KEY-EXPIRED`.
//
// Port decisions:
// * KeyLifetimeError payloads (idx, got, max) lowered to bare variants
//   (?KeyLifetimeError; null = Ok(())), per the ring-wide lowering decision.
// * BTreeSet<[u8; 32]> duplicate tracking replaced by an O(n^2) scan over
//   earlier records; decision order preserved: batch bound, zero key id,
//   duplicate id, zero created, usage bound, created > now (reported as
//   ZeroCreated, mirroring the Rust source), age bound.

module port::message_key_usage_lifetime_bound_guard;

/// Maximum key age.
pub const MKUL_MAX_AGE_MS: u64 = 3600000;

/// Maximum usages per key.
pub const MKUL_MAX_USAGES: u64 = 100;

/// Maximum keys per validation batch.
pub const MKUL_MAX_KEYS: usize = 512;

/// Key id length.
pub const MKUL_KEY_ID_LEN: usize = 32;

/// One key lifetime record.
pub struct KeyLifetimeRecord {
    key_id: [MKUL_KEY_ID_LEN]u8,
    created_ms: u64,
    usage_count: u64,
}

/// All ways lifetime validation can fail.
pub enum KeyLifetimeError {
    TooOld,
    ZeroKeyId,
    DuplicateKeyId,
    ZeroCreated,
    TooManyUsages,
    TooMany,
}

fn kid(byte: u8) [MKUL_KEY_ID_LEN]u8 {
    var out: [MKUL_KEY_ID_LEN]u8 = undefined;
    var i: usize = 0;
    while (i < MKUL_KEY_ID_LEN) { out[i] = byte; i += 1; }
    return out;
}

pub fn keyrec(id: u8, created: u64, usages: u64) KeyLifetimeRecord {
    return .{ .key_id = kid(id), .created_ms = created, .usage_count = usages };
}

pub const MKUL_TEST_NOW: u64 = 10000000000;

/// `[VERIFIED]` Validate key lifetimes.
pub fn validate_key_lifetime(keys: []KeyLifetimeRecord, now_ms: u64) -> ?KeyLifetimeError {
    if (keys.len > MKUL_MAX_KEYS) {
        return .TooMany;
    }
    var i: usize = 0;
    while (i < keys.len) {
        const k = keys[i];
        // 1. zero key id
        if (eq_n(&k.key_id, &kid(0))) {
            return .ZeroKeyId;
        }
        // 2. duplicate key id
        var j: usize = 0;
        while (j < i) {
            if (eq_n(&keys[j].key_id, &k.key_id)) {
                return .DuplicateKeyId;
            }
            j += 1;
        }
        // 3. non-zero created
        if (k.created_ms == 0) {
            return .ZeroCreated;
        }
        // 4. usage bound
        if (k.usage_count > MKUL_MAX_USAGES) {
            return .TooManyUsages;
        }
        // 5. created in the past (reported as ZeroCreated, as in Rust)
        if (k.created_ms > now_ms) {
            return .ZeroCreated;
        }
        // 6. age bound
        const age = now_ms - k.created_ms;
        if (age > MKUL_MAX_AGE_MS) {
            return .TooOld;
        }
        i += 1;
    }
    return null;
}

fn eq_n(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) { return false; }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i += 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Tests (mirrors mkul_01..mkul_10 in the Rust source)
// ---------------------------------------------------------------------------

test mkul_01_too_old_rejected {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - MKUL_MAX_AGE_MS - 1, 5);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .TooOld);
}

test mkul_02_zero_key_rejected {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = .{ .key_id = kid(0), .created_ms = MKUL_TEST_NOW - 1000, .usage_count = 5 };
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .ZeroKeyId);
}

test mkul_03_duplicate_rejected {
    var ks: [2]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - 1000, 5);
    ks[1] = keyrec(0x01, MKUL_TEST_NOW - 2000, 10);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .DuplicateKeyId);
}

test mkul_04_zero_created_rejected {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = .{ .key_id = kid(0x01), .created_ms = 0, .usage_count = 5 };
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .ZeroCreated);
}

test mkul_05_too_many_usages_rejected {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - 1000, MKUL_MAX_USAGES + 1);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .TooManyUsages);
}

test mkul_06_too_many_rejected {
    var ks: [MKUL_MAX_KEYS + 1]KeyLifetimeRecord = undefined;
    var i: usize = 0;
    while (i <= MKUL_MAX_KEYS) {
        const val: u64 = @intCast(i + 1);
        var id: [MKUL_KEY_ID_LEN]u8 = kid(0);
        id[6] = @intCast((val / 256) % 256);
        id[7] = @intCast(val % 256);
        ks[i] = .{ .key_id = id, .created_ms = MKUL_TEST_NOW - 1000, .usage_count = 1 };
        i += 1;
    }
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == .TooMany);
}

test mkul_07_valid_accepted {
    var ks: [2]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - 1000, 10);
    ks[1] = keyrec(0x02, MKUL_TEST_NOW - 5000, 50);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == null);
}

test mkul_08_empty_accepted {
    var ks: [0]KeyLifetimeRecord = undefined;
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == null);
}

test mkul_09_boundary_age_accepted {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - MKUL_MAX_AGE_MS, 1);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == null);
}

test mkul_10_boundary_usages_accepted {
    var ks: [1]KeyLifetimeRecord = undefined;
    ks[0] = keyrec(0x01, MKUL_TEST_NOW - 1000, MKUL_MAX_USAGES);
    const result = validate_key_lifetime(&ks, MKUL_TEST_NOW);
    assert(result == null);
}

pub fn main() void {
    mkul_01_too_old_rejected();
    mkul_02_zero_key_rejected();
    mkul_03_duplicate_rejected();
    mkul_04_zero_created_rejected();
    mkul_05_too_many_usages_rejected();
    mkul_06_too_many_rejected();
    mkul_07_valid_accepted();
    mkul_08_empty_accepted();
    mkul_09_boundary_age_accepted();
    mkul_10_boundary_usages_accepted();
}
