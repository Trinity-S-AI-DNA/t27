module port::padding_key_derivation_domain_separation_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_key_derivation_domain_separation_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// KEY DERIVATION DOMAIN SEPARATION — padding keys are properly separated (P-CHAT-4.17).
// Keys derived for padding operations must be properly separated from other
 cryptographic keys to prevent cross-domain attacks. This guard ensures
 that padding key derivation maintains proper domain separation.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * KEY-DOMAIN-SEPARATION

/// Size of domain separation tag.
const PKDS_DOMAIN_TAG_SIZE: usize = 8;

/// Maximum allowed key reuse across domains.
const PKDS_MAX_KEY_REUSE: usize = 1; // No reuse allowed

/// All ways domain separation validation can fail.
pub enum DomainSeparationError {
    Ok,
    DomainCollision,
    KeyReuseDetected,
    InvalidDomainTag,
    InsufficientDomainSeparation,
};

/// Represents a cryptographic key with domain information.
pub struct DomainKey {
    key: []const u8,
    domain_tag: [PKDS_DOMAIN_TAG_SIZE]u8,
    key_id: u64,
    derivation_context: []const u8,
};

// [VERIFIED] Generate domain separation tag.
pub fn generate_domain_tag(
    domain_name: []const u8,
    context: []const u8,
    version: u32
) -> [PKDS_DOMAIN_TAG_SIZE]u8 {
    var tag: [PKDS_DOMAIN_TAG_SIZE]u8 = [0; PKDS_DOMAIN_TAG_SIZE];
    
    // Combine domain name, context, and version
    var combined: [32]u8 = undefined;
    var i: usize = 0;
    
    // Add domain name (first 8 bytes)
    var j: usize = 0;
    while (j < domain_name.len and j < 8) {
        combined[i] = domain_name[j];
        i += 1;
        j += 1;
    }
    
    // Add context (next 8 bytes)
    j = 0;
    while (j < context.len and j < 8) {
        combined[i] = context[j];
        i += 1;
        j += 1;
    }
    
    // Add version (last 4 bytes of the 16-byte buffer)
    combined[12] = version as u8;
    combined[13] = (version >> 8) as u8;
    combined[14] = (version >> 16) as u8;
    combined[15] = (version >> 24) as u8;
    
    // Generate tag using simple hash
    var k: usize = 0;
    while (k < PKDS_DOMAIN_TAG_SIZE) {
        tag[k] = combined[k % combined.len] ^ combined[(k + 1) % combined.len];
        k += 1;
    }
    
    return tag;
}

// [VERIFIED] Check if two keys have proper domain separation.
pub fn check_domain_separation(
    key1: DomainKey,
    key2: DomainKey
) -> bool {
    // Domain tags must be different
    var i: usize = 0;
    while (i < PKDS_DOMAIN_TAG_SIZE) {
        if (key1.domain_tag[i] != key2.domain_tag[i]) {
            return true; // Different domains
        }
        i += 1;
    }
    
    // If domain tags are the same, check if keys are different
    if (key1.key_id != key2.key_id) {
        return true; // Different keys in same domain
    }
    
    // Check if derivation contexts are different
    if (key1.derivation_context.len != key2.derivation_context.len) {
        return true;
    }
    
    var j: usize = 0;
    while (j < key1.derivation_context.len) {
        if (key1.derivation_context[j] != key2.derivation_context[j]) {
            return true;
        }
        j += 1;
    }
    
    return false; // No domain separation
}

// [VERIFIED] Validate domain separation for padding keys.
// Returns .Ok when all keys are properly separated; error variant otherwise.
pub fn validate_domain_separation(
    keys: []const DomainKey
) -> DomainSeparationError {
    if (keys.len == 0) {
        return .Ok;
    }
    
    // Check for domain collisions
    var domain_collisions: usize = 0;
    var key_reuses: usize = 0;
    var invalid_tags: usize = 0;
    
    var i: usize = 0;
    while (i < keys.len) {
        // Check domain tag validity
        if (keys[i].domain_tag.len != PKDS_DOMAIN_TAG_SIZE) {
            invalid_tags += 1;
        }
        
        // Check for collisions with previous keys
        var j: usize = 0;
        while (j < i) {
            if (!check_domain_separation(keys[i], keys[j])) {
                domain_collisions += 1;
                break;
            }
            j += 1;
        }
        
        i += 1;
    }
    
    if (invalid_tags > 0) {
        return .InvalidDomainTag;
    }
    
    if (domain_collisions > 0) {
        return .DomainCollision;
    }
    
    // Check for key reuse across domains (more thorough check)
    var key_usage: std.AutoHashMap(u64, usize) = std.AutoHashMap(u64, usize).init(std.heap.page_allocator);
    defer key_usage.deinit();
    
    var k: usize = 0;
    while (k < keys.len) {
        const key_id = keys[k].key_id;
        if (key_usage.get(key_id)) |count| {
            if (count > PKDS_MAX_KEY_REUSE) {
                key_reuses += 1;
            }
            key_usage.put(key_id, count + 1);
        } else {
            key_usage.put(key_id, 1);
        }
        k += 1;
    }
    
    if (key_reuses > 0) {
        return .KeyReuseDetected;
    }
    
    return .Ok;
}

// **PKDS-01** — domain tag generation consistency.
test pkds_01_domain_tag_generation {
    const domain_name: []const u8 = "padding";
    const context: []const u8 = "chat";
    const version: u32 = 1;
    
    const tag1 = generate_domain_tag(domain_name, context, version);
    const tag2 = generate_domain_tag(domain_name, context, version);
    
    // Same inputs should produce same tag
    var i: usize = 0;
    while (i < PKDS_DOMAIN_TAG_SIZE) {
        assert(tag1[i] == tag2[i]);
        i += 1;
    }
}

// **PKDS-02** — different domains produce different tags.
test pkds_02_different_domains {
    const tag1 = generate_domain_tag("padding", "chat", 1);
    const tag2 = generate_domain_tag("message", "chat", 1);
    const tag3 = generate_domain_tag("padding", "stream", 1);
    const tag4 = generate_domain_tag("padding", "chat", 2);
    
    // Different domains should produce different tags
    assert(tag1 != tag2);
    assert(tag1 != tag3);
    assert(tag1 != tag4);
}

// **PKDS-03** — domain separation check works.
test pkds_03_domain_separation {
    const key1 = DomainKey{
        .key = [1; 32],
        .domain_tag = generate_domain_tag("padding", "chat", 1),
        .key_id = 1000,
        .derivation_context = [1; 16],
    };
    
    const key2 = DomainKey{
        .key = [2; 32],
        .domain_tag = generate_domain_tag("padding", "chat", 2), // Different domain
        .key_id = 1000,
        .derivation_context = [1; 16],
    };
    
    const key3 = DomainKey{
        .key = [3; 32],
        .domain_tag = generate_domain_tag("padding", "chat", 1), // Same domain
        .key_id = 2000, // Different key
        .derivation_context = [1; 16],
    };
    
    assert(check_domain_separation(key1, key2) == true);
    assert(check_domain_separation(key1, key3) == true);
    
    // Test collision
    const key4 = DomainKey{
        .key = [4; 32],
        .domain_tag = generate_domain_tag("padding", "chat", 1), // Same domain
        .key_id = 1000, // Same key ID
        .derivation_context = [1; 16], // Same context
    };
    assert(check_domain_separation(key1, key4) == false);
}

// **PKDS-04** — domain separation validation.
test pkds_04_domain_separation_validation {
    const keys: [3]DomainKey = [
        .{
            .key = [1; 32],
            .domain_tag = generate_domain_tag("padding", "chat", 1),
            .key_id = 1000,
            .derivation_context = [1; 16],
        },
        .{
            .key = [2; 32],
            .domain_tag = generate_domain_tag("padding", "stream", 1),
            .key_id = 1001,
            .derivation_context = [2; 16],
        },
        .{
            .key = [3; 32],
            .domain_tag = generate_domain_tag("message", "chat", 1),
            .key_id = 1002,
            .derivation_context = [3; 16],
        },
    ];
    
    assert(validate_domain_separation(keys) == .Ok);
}

// **PKDS-05** — domain collision detection.
test pkds_05_domain_collision {
    const keys: [2]DomainKey = [
        .{
            .key = [1; 32],
            .domain_tag = generate_domain_tag("padding", "chat", 1),
            .key_id = 1000,
            .derivation_context = [1; 16],
        },
        .{
            .key = [2; 32],
            .domain_tag = generate_domain_tag("padding", "chat", 1), // Same domain
            .key_id = 1000, // Same key ID
            .derivation_context = [1; 16], // Same context
        },
    ];
    
    assert(validate_domain_separation(keys) == .DomainCollision);
}

// **PKDS-06** — validation is deterministic.
test pkds_06_deterministic {
    const keys: [2]DomainKey = [
        .{
            .key = [1; 32],
            .domain_tag = generate_domain_tag("padding", "chat", 1),
            .key_id = 1000,
            .derivation_context = [1; 16],
        },
        .{
            .key = [2; 32],
            .domain_tag = generate_domain_tag("padding", "chat", 2),
            .key_id = 1001,
            .derivation_context = [2; 16],
        },
    ];
    
    const result1 = validate_domain_separation(keys);
    const result2 = validate_domain_separation(keys);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PKDS-07** — edge cases.
test pkds_07_edge_cases {
    const empty_keys: [0]DomainKey = [];
    assert(validate_domain_separation(empty_keys) == .Ok);
    
    const single_key: [1]DomainKey = [.{ .key = [1; 32], .domain_tag = [0; 8], .key_id = 1000, .derivation_context = [1; 16] }];
    assert(validate_domain_separation(single_key) == .Ok);
}

// **PKDS-08** — invalid domain tag detection.
test pkds_08_invalid_domain_tag {
    const invalid_key: [1]DomainKey = [.{ .key = [1; 32], .domain_tag = [0; 4], .key_id = 1000, .derivation_context = [1; 16] }];
    assert(validate_domain_separation(invalid_key) == .InvalidDomainTag);
}