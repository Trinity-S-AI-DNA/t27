module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_length_distribution_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_length_distribution_guard.rs
// (CR-CHAT-04 - Padding length distribution guard, Wave-80 Lane B,
// requirement R-CHAT-4).
//
// Padding lengths must spread over classes: lengths clustered
// around a few values let an observer read payload sizes off the
// envelope, fingerprint the device off consistent choices, and
// separate payloads statistically. The rules, in the original's
// order: the empty probe, the sample floor, the sample ceiling, the
// zero-length scan, the distinct-class floor, and the dominance
// ceiling - no single length may exceed the ratio of three tenths
// of the batch.
//
// The original returns Result<(), PadLenDistError>. This port
// carries the verdict as a named struct (owner decision D5): Ok
// first, then the six error variants in the original's declaration
// order - TooFewClasses, LengthTooDominant, TooFewSamples,
// TooManySamples, InvalidLength, Empty - with every payload field:
// the distinct-class count for TooFewClasses and the offending
// length for InvalidLength; the other four variants carry none.
//
// The original's BTreeMap frequency table becomes first-occurrence
// scans (conventions section 4): a distinct value is one whose
// earlier slots hold nothing equal, its count a full-batch scan -
// the classes count and the maximum count fall out of the same
// pass. The dominance rule stays the original's integer
// cross-multiplication, max times ten against total times three -
// no division, no casts.
//
// The original's prose names alignment and bounds as rule five,
// but its code scans only for the zero length; the port follows the
// code, exactly as every original test exercises it.

// Minimum distinct length classes.
pub const PLDG_MIN_CLASSES: usize = 4;

// Maximum frequency ratio (max count / total), numerator.
pub const PLDG_MAX_FREQ_RATIO_NUM: usize = 3;

// Maximum frequency ratio (max count / total), denominator.
pub const PLDG_MAX_FREQ_RATIO_DEN: usize = 10;

// Minimum sample size.
pub const PLDG_MIN_SAMPLES: usize = 8;

// Maximum sample size.
pub const PLDG_MAX_SAMPLES: usize = 1024;

// Verdict codes: Ok(()) and PadLenDistError's variants, in declaration order.
pub enum PadLenDistCode {
    Ok,
    TooFewClasses,
    LengthTooDominant,
    TooFewSamples,
    TooManySamples,
    InvalidLength,
    Empty,
}

// The verdict of the distribution validation, with every error
// payload field.
pub struct PadLenDistVerdict {
    code: PadLenDistCode,
    classes: usize,
    length: usize,
}

// Whether slot i holds a value an earlier slot already holds - the
// original's BTreeMap key probe, answered by a scan.
pub fn value_seen_before(lengths: []const usize, i: usize) -> bool {
    for j in 0..i {
        if (lengths[j] == lengths[i]) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate padding length distribution uniformity.
// Returns Ok only when every rule holds, checked in the original's
// order: the empty probe, the sample floor, the sample ceiling, the
// zero-length scan, then over the first-occurrence scans the
// distinct-class floor and the dominance ceiling.
pub fn validate_padding_length_distribution(lengths: []const usize) -> PadLenDistVerdict {
    if (lengths.len == 0) {
        return PadLenDistVerdict { code: PadLenDistCode.Empty, classes: 0, length: 0, };
    }
    if (lengths.len < PLDG_MIN_SAMPLES) {
        return PadLenDistVerdict { code: PadLenDistCode.TooFewSamples, classes: 0, length: 0, };
    }
    if (lengths.len > PLDG_MAX_SAMPLES) {
        return PadLenDistVerdict { code: PadLenDistCode.TooManySamples, classes: 0, length: 0, };
    }
    for i in 0..lengths.len {
        if (lengths[i] == 0) {
            return PadLenDistVerdict { code: PadLenDistCode.InvalidLength, classes: 0, length: 0, };
        }
    }
    var distinct: usize = 0;
    var max_count: usize = 0;
    for i in 0..lengths.len {
        if (!value_seen_before(lengths, i)) {
            distinct = distinct + 1;
            var count: usize = 0;
            for j in 0..lengths.len {
                if (lengths[j] == lengths[i]) {
                    count = count + 1;
                }
            }
            if (count > max_count) {
                max_count = count;
            }
        }
    }
    if (distinct < PLDG_MIN_CLASSES) {
        return PadLenDistVerdict { code: PadLenDistCode.TooFewClasses, classes: distinct, length: 0, };
    }
    if (max_count * PLDG_MAX_FREQ_RATIO_DEN > lengths.len * PLDG_MAX_FREQ_RATIO_NUM) {
        return PadLenDistVerdict { code: PadLenDistCode.LengthTooDominant, classes: distinct, length: 0, };
    }
    return PadLenDistVerdict { code: PadLenDistCode.Ok, classes: distinct, length: 0, };
}

// The cycle tables of the accepted fixtures: the four classes of
// the uniform batch, the five of the maximum batch, and the eight
// of the many-classes batch - the original's class arrays, entry
// by entry.
pub const PLDG_CLASSES_4: [4]usize = [4]usize{64, 128, 256, 512,};
pub const PLDG_CLASSES_5: [5]usize = [5]usize{64, 128, 256, 512, 1024,};
pub const PLDG_CLASSES_8: [8]usize = [8]usize{64, 128, 192, 256, 320, 384, 448, 512,};

// **PLDG-01** - too few classes rejected: sixteen samples, all
// sixty-four - one class of a required four, and the count also
// over the dominance line, so the class floor answers first.
test pldg_01_too_few_classes_rejected {
    const lengths: [16]usize = [16]usize{64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64,};
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.TooFewClasses);
    assert(v.classes == 1);
}

// **PLDG-02** - dominant length rejected: twelve of sixteen
// samples in one class, twelve tenths of the batch over the three
// tenths ceiling.
test pldg_02_dominant_rejected {
    const lengths: [16]usize = [16]usize{
        64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 128, 256, 512, 1024,
    };
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.LengthTooDominant);
}

// **PLDG-03** - too few samples rejected: two of a required eight.
test pldg_03_too_few_samples_rejected {
    const lengths: [2]usize = [2]usize{64, 128,};
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.TooFewSamples);
}

// **PLDG-04** - too many rejected: 1025 samples of a maximum 1024,
// built in a loop like the original's. The ceiling fires before
// any length is examined, so every sample carries the same length.
test pldg_04_too_many_rejected {
    var lengths: [1025]usize;
    for i in 0..1025 {
        lengths[i] = 64;
    }
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.TooManySamples);
}

// **PLDG-05** - invalid length rejected: the zero length appended
// to the uniform batch.
test pldg_05_invalid_length_rejected {
    const lengths: [9]usize = [9]usize{
        64, 128, 256, 512, 64, 128, 256, 512, 0,
    };
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.InvalidLength);
    assert(v.length == 0);
}

// **PLDG-06** - an empty batch rejected.
test pldg_06_empty_rejected {
    const lengths: [0]usize = [0]usize{};
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.Empty);
}

// **PLDG-07** - the uniform batch accepted: two rounds over the
// four classes, every class at a quarter of the batch.
test pldg_07_uniform_accepted {
    const lengths: [8]usize = [8]usize{
        64, 128, 256, 512, 64, 128, 256, 512,
    };
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.Ok);
}

// **PLDG-08** - exactly the minimum accepted: eight samples cycling
// the four classes.
test pldg_08_min_samples_accepted {
    const lengths: [8]usize = [8]usize{
        64, 128, 256, 512, 64, 128, 256, 512,
    };
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.Ok);
}

// **PLDG-09** - the maximum batch accepted: 1024 samples cycling
// five classes, each at a fifth of the batch.
test pldg_09_max_samples_accepted {
    var lengths: [1024]usize;
    for i in 0..1024 {
        lengths[i] = PLDG_CLASSES_5[i % 5];
    }
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.Ok);
}

// **PLDG-10** - many classes accepted: thirty-two samples cycling
// the eight multiples of sixty-four, each class at an eighth of
// the batch.
test pldg_10_many_classes_accepted {
    var lengths: [32]usize;
    for i in 0..32 {
        lengths[i] = PLDG_CLASSES_8[i % 8];
    }
    const v = validate_padding_length_distribution(&lengths);
    assert(v.code == PadLenDistCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test value_seen_before_answers {
    const lengths: [3]usize = [3]usize{64, 128, 64,};
    assert(!value_seen_before(&lengths, 0));
    assert(!value_seen_before(&lengths, 1));
    assert(value_seen_before(&lengths, 2));
}

// Rule order is the original's: the empty probe before the sample
// floor, the sample floor before the zero scan, the zero scan
// before the class floor, and the sample ceiling before the zero
// scan.
test rule_order_matches_original {
    const short_with_zero: [7]usize = [7]usize{64, 128, 0, 64, 64, 64, 64,};
    const v1 = validate_padding_length_distribution(&short_with_zero);
    assert(v1.code == PadLenDistCode.TooFewSamples);

    const zero_before_classes: [8]usize = [8]usize{64, 64, 64, 64, 0, 64, 64, 64,};
    const v2 = validate_padding_length_distribution(&zero_before_classes);
    assert(v2.code == PadLenDistCode.InvalidLength);
    assert(v2.length == 0);

    const classes_first: [16]usize = [16]usize{64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64, 64,};
    const v3 = validate_padding_length_distribution(&classes_first);
    assert(v3.code == PadLenDistCode.TooFewClasses);

    var ceiling_first: [1025]usize;
    for i in 0..1025 {
        ceiling_first[i] = 0;
    }
    const v4 = validate_padding_length_distribution(&ceiling_first);
    assert(v4.code == PadLenDistCode.TooManySamples);
}
