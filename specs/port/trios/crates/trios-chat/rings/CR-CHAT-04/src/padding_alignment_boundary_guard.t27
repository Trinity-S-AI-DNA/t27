module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_alignment_boundary_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_alignment_boundary_guard.rs
// (CR-CHAT-04 - Padding alignment boundary guard, Wave-92 Lane A, requirement R-CHAT-9).
//
// Padded messages must align to class boundaries. Six rules, in the
// original's order: payload non-empty, padded >= smallest class, padded
// <= largest class, padded is a class, padding actually added, payload
// fits under the length prefix.
//
// The original returns Result<(), AlignmentError>. This port carries the
// verdict as a named struct (owner decision D5): Ok first, then the six
// error variants in the original's declaration order - NotAClass,
// NoPadding, EmptyPayload, BelowMinClass, AboveMaxClass, PayloadOverflow.
// Every payload field of every variant is carried: padded_len (NotAClass,
// BelowMinClass, AboveMaxClass), payload_len (NoPadding, PayloadOverflow),
// max_payload (PayloadOverflow). Fields a variant does not carry read 0.

// Padding classes.
pub const PALB_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384};

// Length prefix size.
pub const PALB_PREFIX_LEN: usize = 4;

// A padded message record.
pub struct PaddedMessage {
    payload_len: usize,
    padded_len: usize,
}

// Verdict codes: Ok(()) and AlignmentError's variants, in declaration order.
pub enum AlignmentCode {
    Ok,
    NotAClass,
    NoPadding,
    EmptyPayload,
    BelowMinClass,
    AboveMaxClass,
    PayloadOverflow,
}

// The verdict of the alignment validation, with every error payload field.
pub struct AlignmentVerdict {
    code: AlignmentCode,
    padded_len: usize,
    payload_len: usize,
    max_payload: usize,
}

// The smallest canonical class.
pub fn smallest_class() -> usize {
    return PALB_CLASSES[0];
}

// The largest canonical class.
pub fn largest_class() -> usize {
    return PALB_CLASSES[PALB_CLASSES.len - 1];
}

// The original asks PALB_CLASSES.contains(&len); there is no contains() in
// this language, so the decision is a loop over the four classes.
pub fn is_class(len: usize) -> bool {
    for c in PALB_CLASSES {
        if (c == len) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate padding alignment boundaries. Returns Ok for every
// message that satisfies all six rules, otherwise the first violated rule's
// code, checked in the original's order: empty payload, below min class,
// above max class, not a class, no padding, payload overflow.
pub fn validate_padding_alignment(msgs: []const PaddedMessage) -> AlignmentVerdict {
    for m in msgs {
        if (m.payload_len == 0) {
            return AlignmentVerdict { code: AlignmentCode.EmptyPayload, padded_len: 0, payload_len: 0, max_payload: 0, };
        }
        if (m.padded_len < smallest_class()) {
            return AlignmentVerdict { code: AlignmentCode.BelowMinClass, padded_len: m.padded_len, payload_len: 0, max_payload: 0, };
        }
        if (m.padded_len > largest_class()) {
            return AlignmentVerdict { code: AlignmentCode.AboveMaxClass, padded_len: m.padded_len, payload_len: 0, max_payload: 0, };
        }
        if (!is_class(m.padded_len)) {
            return AlignmentVerdict { code: AlignmentCode.NotAClass, padded_len: m.padded_len, payload_len: 0, max_payload: 0, };
        }
        if (m.padded_len == m.payload_len) {
            return AlignmentVerdict { code: AlignmentCode.NoPadding, padded_len: m.padded_len, payload_len: m.payload_len, max_payload: 0, };
        }
        const max_payload: usize = m.padded_len - PALB_PREFIX_LEN;
        if (m.payload_len > max_payload) {
            return AlignmentVerdict { code: AlignmentCode.PayloadOverflow, padded_len: 0, payload_len: m.payload_len, max_payload: max_payload, };
        }
    }
    return AlignmentVerdict { code: AlignmentCode.Ok, padded_len: 0, payload_len: 0, max_payload: 0, };
}

// **PALB-01** - not a class rejected: 300 is not one of the four classes.
test palb_01_not_a_class_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 100, padded_len: 300, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.NotAClass);
    assert(v.padded_len == 300);
}

// **PALB-02** - no padding rejected: padded equals payload.
test palb_02_no_padding_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 256, padded_len: 256, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.NoPadding);
    assert(v.payload_len == 256);
    assert(v.padded_len == 256);
}

// **PALB-03** - empty payload rejected.
test palb_03_empty_payload_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 0, padded_len: 256, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.EmptyPayload);
}

// **PALB-04** - below min class rejected: 128 < 256.
test palb_04_below_min_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 10, padded_len: 128, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.BelowMinClass);
    assert(v.padded_len == 128);
}

// **PALB-05** - above max class rejected: 32768 > 16384.
test palb_05_above_max_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 100, padded_len: 32768, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.AboveMaxClass);
    assert(v.padded_len == 32768);
}

// **PALB-06** - payload overflow rejected: 253 > 256 - 4.
test palb_06_overflow_rejected {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 253, padded_len: 256, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.PayloadOverflow);
    assert(v.payload_len == 253);
    assert(v.max_payload == 252);
}

// **PALB-07** - valid messages accepted: one per class, all rules pass.
test palb_07_valid_accepted {
    const msgs = [3]PaddedMessage{
        PaddedMessage { payload_len: 100, padded_len: 256, },
        PaddedMessage { payload_len: 500, padded_len: 1024, },
        PaddedMessage { payload_len: 2000, padded_len: 4096, },
    };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.Ok);
}

// **PALB-08** - empty slice accepted.
test palb_08_empty_accepted {
    const msgs = [0]PaddedMessage{};
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.Ok);
}

// **PALB-09** - exact max payload accepted: 252 == 256 - 4.
test palb_09_exact_max_payload_accepted {
    const msgs = [1]PaddedMessage{ PaddedMessage { payload_len: 252, padded_len: 256, }, };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.Ok);
}

// **PALB-10** - all four classes accepted in one batch.
test palb_10_all_classes_accepted {
    const msgs = [4]PaddedMessage{
        PaddedMessage { payload_len: 10, padded_len: 256, },
        PaddedMessage { payload_len: 500, padded_len: 1024, },
        PaddedMessage { payload_len: 2000, padded_len: 4096, },
        PaddedMessage { payload_len: 10000, padded_len: 16384, },
    };
    const v = validate_padding_alignment(&msgs);
    assert(v.code == AlignmentCode.Ok);
}

// The three helpers have direct tests (coverage: Untested 0).
test smallest_class_answers_first_class {
    assert(smallest_class() == 256);
}

test largest_class_answers_last_class {
    assert(largest_class() == 16384);
}

test is_class_answers_canonical_classes {
    assert(is_class(256));
    assert(is_class(1024));
    assert(is_class(4096));
    assert(is_class(16384));
    assert(!is_class(300));
    assert(!is_class(128));
    assert(!is_class(0));
}

// Rule order is the original's: empty payload before min class, min class
// before class membership.
test rule_order_matches_original {
    const a = [1]PaddedMessage{ PaddedMessage { payload_len: 0, padded_len: 128, }, };
    const b = [1]PaddedMessage{ PaddedMessage { payload_len: 100, padded_len: 128, }, };
    const va = validate_padding_alignment(&a);
    const vb = validate_padding_alignment(&b);
    assert(va.code == AlignmentCode.EmptyPayload);
    assert(vb.code == AlignmentCode.BelowMinClass);
}
