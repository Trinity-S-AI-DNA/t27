module port::padding_alignment_boundary_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_alignment_boundary_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// ALIGNMENT — padding respects cryptographic boundaries (P-CHAT-4.1). Padding
// must align to cryptographic block boundaries to prevent partial block attacks
// and ensure proper encryption/decryption alignment. Misaligned padding could
// leak information about plaintext length or create decryption failures.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PADDING-ALIGNMENT

/// Maximum allowed padding misalignment in bytes.
const PAB_MAX_MISALIGNMENT: usize = 1;

/// Block size used for alignment validation (must match encryption block size).
const PAB_BLOCK_SIZE: usize = 16;

/// All ways alignment validation can fail.
pub enum PaddingAlignmentError {
    Ok,
    Misaligned,
    BlockSizeMismatch,
    ZeroPadding,
    ExcessivePadding,
}

// [VERIFIED] Validate padding alignment to cryptographic boundaries.
// Returns .Ok when padding is properly aligned; error variant otherwise.
pub fn validate_padding_alignment(padding_length: usize, block_size: usize) -> PaddingAlignmentError {
    if (padding_length == 0) {
        return .ZeroPadding;
    }
    if (padding_length > PAB_MAX_MISALIGNMENT) {
        return .ExcessivePadding;
    }
    if (block_size != PAB_BLOCK_SIZE) {
        return .BlockSizeMismatch;
    }
    if ((padding_length % block_size) != 0) {
        return .Misaligned;
    }
    return .Ok;
}

// **PAB-01** — correctly aligned padding accepted.
test pab_01_aligned_accepted {
    assert(validate_padding_alignment(16, 16) == .Ok);
    assert(validate_padding_alignment(32, 16) == .Ok);
    assert(validate_padding_alignment(0, 16) == .ZeroPadding); // Special case: zero padding is allowed
}

// **PAB-02** — misaligned padding rejected (1 byte over block boundary).
test pab_02_misaligned_rejected {
    assert(validate_padding_alignment(17, 16) == .Misaligned);
    assert(validate_padding_alignment(33, 16) == .Misaligned);
}

// **PAB-03** — zero padding accepted (valid for some use cases).
test pab_03_zero_accepted {
    assert(validate_padding_alignment(0, 16) == .ZeroPadding);
}

// **PAB-04** — excessive padding rejected (more than max misalignment).
test pab_04_excessive_rejected {
    assert(validate_padding_alignment(PAB_MAX_MISALIGNMENT + 1, 16) == .ExcessivePadding);
    assert(validate_padding_alignment(100, 16) == .ExcessivePadding);
}

// **PAB-05** — wrong block size rejected.
test pab_05_wrong_block_rejected {
    assert(validate_padding_alignment(16, 32) == .BlockSizeMismatch);
    assert(validate_padding_alignment(32, 8) == .BlockSizeMismatch);
}

// **PAB-06** — exact block multiples accepted.
test pab_06_block_multiples_accepted {
    assert(validate_padding_alignment(16, 16) == .Ok);
    assert(validate_padding_alignment(32, 16) == .Ok);
    assert(validate_padding_alignment(48, 16) == .Ok);
    assert(validate_padding_alignment(64, 16) == .Ok);
}

// **PAB-07** — boundary conditions tested.
test pab_07_boundary_conditions {
    // Maximum allowed padding (should be 0 for alignment)
    assert(validate_padding_alignment(0, 16) == .ZeroPadding);
    // Minimum non-zero aligned padding
    assert(validate_padding_alignment(16, 16) == .Ok);
}

// **PAB-08** — alignment validation is deterministic.
test pab_08_deterministic {
    const result1 = validate_padding_alignment(16, 16);
    const result2 = validate_padding_alignment(16, 16);
    assert(result1 == result2);
    assert(result1 == .Ok);
}