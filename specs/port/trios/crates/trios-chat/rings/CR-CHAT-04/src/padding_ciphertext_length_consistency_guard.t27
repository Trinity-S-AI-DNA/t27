module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_ciphertext_length_consistency_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_ciphertext_length_consistency_guard.rs
// (CR-CHAT-04 - Padding ciphertext length consistency guard,
// Wave-109 Lane B, requirement R-CHAT-4).
//
// Each padding class has a fixed wire size: two ciphertexts of
// the same class differing by a byte break the size-class
// privacy, off-by-one padding leaks a payload of exactly
// class minus one, and unique lengths fingerprint sessions
// across epochs. The rules, in the original's order: the batch
// ceiling, then per record the zero-length probe, the
// class-canonical scan, the length-canonical scan and the
// class-consistency check - a length need not equal its class,
// only every record of one class must agree.
//
// The original returns Result<(), LengthConsistencyError>. This
// port carries the verdict as a named struct (owner decision D5):
// Ok first, then the five error variants in the original's
// declaration order - Inconsistent, NotCanonical, InvalidClass,
// ZeroLength, TooMany - with every payload field: class,
// expected and got for Inconsistent, the offending length or
// class for the canonical rules, idx for the zero-length rule,
// and got and max for the ceiling.
//
// The original's BTreeMap class-to-length becomes four scalar
// slots (the conventions' fixed form) - the zero-length rule
// runs before the map, so the all-zero slot doubles as the
// unseen marker without collision. The canonical-class set
// becomes a scan over the class ladder.

// Canonical padding classes.
pub const PCLG_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384,};

// Maximum ciphertexts per batch.
pub const PCLG_MAX_CIPHERTEXTS: usize = 10000;

// A ciphertext with its class assignment.
pub struct CiphertextRecord {
    class: usize,
    length: usize,
}

// Verdict codes: Ok(()) and LengthConsistencyError's variants, in declaration order.
pub enum LengthConsistencyCode {
    Ok,
    Inconsistent,
    NotCanonical,
    InvalidClass,
    ZeroLength,
    TooMany,
}

// The verdict of the length consistency validation, with every
// error payload field.
pub struct LengthConsistencyVerdict {
    code: LengthConsistencyCode,
    idx: usize,
    class: usize,
    expected: usize,
    got: usize,
    bound: usize,
}

// Whether the value is one of the four canonical classes - the
// original's BTreeSet membership probes, answered by a scan.
pub fn is_canonical(v: usize) -> bool {
    for c in PCLG_CLASSES {
        if (c == v) {
            return true;
        }
    }
    return false;
}

// The slot of a class in the consistency table - 4 marks a class
// no rule accepted, never reached by the consistency check.
pub fn class_slot(class: usize) -> usize {
    if (class == 256) {
        return 0;
    }
    if (class == 1024) {
        return 1;
    }
    if (class == 4096) {
        return 2;
    }
    if (class == 16384) {
        return 3;
    }
    return 4;
}

// [VERIFIED] Validate padding ciphertext length consistency.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, then per record the zero
// length, the class-canonical scan, the length-canonical scan
// and the class-consistency check.
pub fn validate_length_consistency(records: []const CiphertextRecord) -> LengthConsistencyVerdict {
    if (records.len > PCLG_MAX_CIPHERTEXTS) {
        return LengthConsistencyVerdict { code: LengthConsistencyCode.TooMany, idx: 0, class: 0, expected: 0, got: records.len, bound: PCLG_MAX_CIPHERTEXTS, };
    }
    var slots: [4]usize = [4]usize{0, 0, 0, 0,};
    var slot: usize = 0;
    for i in 0..records.len {
        if (records[i].length == 0) {
            return LengthConsistencyVerdict { code: LengthConsistencyCode.ZeroLength, idx: i, class: 0, expected: 0, got: 0, bound: 0, };
        }
        if (!is_canonical(records[i].class)) {
            return LengthConsistencyVerdict { code: LengthConsistencyCode.InvalidClass, idx: i, class: records[i].class, expected: 0, got: 0, bound: 0, };
        }
        if (!is_canonical(records[i].length)) {
            return LengthConsistencyVerdict { code: LengthConsistencyCode.NotCanonical, idx: i, class: 0, expected: 0, got: records[i].length, bound: 0, };
        }
        slot = class_slot(records[i].class);
        if (slots[slot] == 0) {
            slots[slot] = records[i].length;
        } else {
            if (records[i].length != slots[slot]) {
                return LengthConsistencyVerdict { code: LengthConsistencyCode.Inconsistent, idx: i, class: records[i].class, expected: slots[slot], got: records[i].length, bound: 0, };
            }
        }
    }
    return LengthConsistencyVerdict { code: LengthConsistencyCode.Ok, idx: 0, class: 0, expected: 0, got: 0, bound: 0, };
}

// **PCLG-01** - inconsistent length within a class rejected:
// the second 256-class ciphertext carries 1024 bytes.
test pclg_01_inconsistent_rejected {
    const records: [2]CiphertextRecord = [2]CiphertextRecord{
        CiphertextRecord { class: 256, length: 256, },
        CiphertextRecord { class: 256, length: 1024, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Inconsistent);
    assert(v.class == 256);
    assert(v.expected == 256);
    assert(v.got == 1024);
}

// **PCLG-02** - non-canonical length rejected: three hundred
// bytes is no class size.
test pclg_02_not_canonical_rejected {
    const records: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 256, length: 300, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.NotCanonical);
    assert(v.got == 300);
}

// **PCLG-03** - invalid class rejected: five hundred is no class.
test pclg_03_invalid_class_rejected {
    const records: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 500, length: 500, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.InvalidClass);
    assert(v.class == 500);
}

// **PCLG-04** - zero length rejected.
test pclg_04_zero_length_rejected {
    const records: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 256, length: 0, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.ZeroLength);
    assert(v.idx == 0);
}

// **PCLG-05** - too many rejected: 10001 ciphertexts of a maximum
// 10000, built in a loop like the original's. The batch rule
// fires before any record is examined.
test pclg_05_too_many_rejected {
    var records: [10001]CiphertextRecord;
    for i in 0..10001 {
        records[i] = CiphertextRecord { class: 256, length: 256, };
    }
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.TooMany);
    assert(v.got == 10001);
    assert(v.bound == 10000);
}

// **PCLG-06** - a class carrying a different class's length
// accepted: consistency asks only that one class agree with
// itself, the first of its kind sets the expectation.
test pclg_06_class_length_mismatch_rejected {
    const records: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 256, length: 1024, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Ok);
}

// **PCLG-07** - the valid batch accepted.
test pclg_07_valid_accepted {
    const records: [4]CiphertextRecord = [4]CiphertextRecord{
        CiphertextRecord { class: 256, length: 256, },
        CiphertextRecord { class: 256, length: 256, },
        CiphertextRecord { class: 1024, length: 1024, },
        CiphertextRecord { class: 16384, length: 16384, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Ok);
}

// **PCLG-08** - an empty batch accepted.
test pclg_08_empty_accepted {
    const records: [0]CiphertextRecord = [0]CiphertextRecord{};
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Ok);
}

// **PCLG-09** - one ciphertext per class accepted.
test pclg_09_single_per_class_accepted {
    const records: [4]CiphertextRecord = [4]CiphertextRecord{
        CiphertextRecord { class: 256, length: 256, },
        CiphertextRecord { class: 1024, length: 1024, },
        CiphertextRecord { class: 4096, length: 4096, },
        CiphertextRecord { class: 16384, length: 16384, },
    };
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Ok);
}

// **PCLG-10** - a large consistent batch accepted: a hundred
// rounds over the four classes.
test pclg_10_large_batch_accepted {
    var records: [400]CiphertextRecord;
    for i in 0..400 {
        records[i] = CiphertextRecord { class: PCLG_CLASSES[i % 4], length: PCLG_CLASSES[i % 4], };
    }
    const v = validate_length_consistency(&records);
    assert(v.code == LengthConsistencyCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test pclg_helpers_answer {
    assert(is_canonical(256));
    assert(is_canonical(1024));
    assert(is_canonical(4096));
    assert(is_canonical(16384));
    assert(!is_canonical(300));
    assert(!is_canonical(500));
    assert(!is_canonical(0));
    assert(class_slot(256) == 0);
    assert(class_slot(1024) == 1);
    assert(class_slot(4096) == 2);
    assert(class_slot(16384) == 3);
    assert(class_slot(500) == 4);
}

// Rule order is the original's: the zero length before the class
// scan, the class scan before the length scan, and the length
// scan before the consistency check.
test rule_order_matches_original {
    const zero_invalid: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 500, length: 0, },
    };
    const v1 = validate_length_consistency(&zero_invalid);
    assert(v1.code == LengthConsistencyCode.ZeroLength);
    assert(v1.idx == 0);

    const invalid_non_canonical: [1]CiphertextRecord = [1]CiphertextRecord{
        CiphertextRecord { class: 500, length: 300, },
    };
    const v2 = validate_length_consistency(&invalid_non_canonical);
    assert(v2.code == LengthConsistencyCode.InvalidClass);
    assert(v2.class == 500);

    const non_canonical_inconsistent: [2]CiphertextRecord = [2]CiphertextRecord{
        CiphertextRecord { class: 256, length: 256, },
        CiphertextRecord { class: 256, length: 300, },
    };
    const v3 = validate_length_consistency(&non_canonical_inconsistent);
    assert(v3.code == LengthConsistencyCode.NotCanonical);
    assert(v3.got == 300);
    assert(v3.idx == 1);
}
