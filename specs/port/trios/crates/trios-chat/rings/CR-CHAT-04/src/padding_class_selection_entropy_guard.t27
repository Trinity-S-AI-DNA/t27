module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_class_selection_entropy_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_class_selection_entropy_guard.rs
// (CR-CHAT-04 - Padding class selection entropy guard, Wave-88 Lane B,
// requirement R-CHAT-9).
//
// Padding classes are chosen to hide payload sizes, so the selection
// distribution itself must stay balanced: enough samples overall, every
// class observed and above its per-class floor, no class over the
// 3/4 dominance ceiling, and no selection of a size outside the four
// canonical classes.
//
// The original returns Result<(), ClassEntropyError>. This port carries
// the verdict as a named struct (owner decision D5): Ok first, then
// the six error variants in the original's declaration order -
// UnderMinimum, DominantClass, TooFewSamples, InvalidClass,
// TooManySamples, WrongClassCount - with every payload field: class,
// count and min for UnderMinimum, class, ratio_num (count) and
// ratio_den (total) for DominantClass, got and min for TooFewSamples,
// the invalid size for InvalidClass, got and expected for
// WrongClassCount.
//
// The original's BTreeMap count becomes four scalar slots indexed by
// the class ladder (four known classes only), and its set membership a
// scan of the same ladder. The dominance ratio the original rounds up
// (count*4 + total - 1)/total is computed as the same integer
// expression.

// Minimum samples per class.
pub const PCSE_MIN_PER_CLASS: usize = 10;

// Maximum ratio any single class may occupy: 3/4.
pub const PCSE_MAX_RATIO_NUM: usize = 3;
pub const PCSE_MAX_RATIO_DEN: usize = 4;

// Minimum total samples.
pub const PCSE_MIN_SAMPLES: usize = 40;

// Maximum total samples.
pub const PCSE_MAX_SAMPLES: usize = 1000000;

// Number of padding classes.
pub const PCSE_NUM_CLASSES: usize = 4;

// Valid class sizes.
pub const PCSE_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384};

// A class selection record.
pub struct ClassSelection {
    class_size: usize,
}

// Verdict codes: Ok(()) and ClassEntropyError's variants, in declaration order.
pub enum ClassEntropyCode {
    Ok,
    UnderMinimum,
    DominantClass,
    TooFewSamples,
    InvalidClass,
    TooManySamples,
    WrongClassCount,
}

// The verdict of the class entropy validation, with every error payload field.
pub struct ClassEntropyVerdict {
    code: ClassEntropyCode,
    class: usize,
    count: usize,
    got: usize,
    bound: usize,
}

// The ladder slot of a class size: 0..3 for the four canonical classes,
// and a value at or beyond the ladder length when the size is not one.
pub fn class_slot(size: usize) -> usize {
    for i in 0..4 {
        if (PCSE_CLASSES[i] == size) {
            return i;
        }
    }
    return 4;
}

// The count of selections that chose class-size, over the four slots.
pub fn class_count(selections: []const ClassSelection, size: usize) -> usize {
    var n: usize = 0;
    for i in 0..selections.len {
        if (selections[i].class_size == size) {
            n = n + 1;
        }
    }
    return n;
}

// The number of distinct canonical classes observed.
pub fn classes_observed(selections: []const ClassSelection) -> usize {
    var seen: usize = 0;
    for c in 0..4 {
        if (class_count(selections, PCSE_CLASSES[c]) > 0) {
            seen = seen + 1;
        }
    }
    return seen;
}

// [VERIFIED] Validate padding class selection entropy. Returns Ok only
// when every rule holds, checked in the original's order: the total
// ceiling, the total floor, the per-selection class validity, the
// number of distinct classes, the per-class floor, and the dominance
// ceiling.
pub fn validate_class_entropy(selections: []const ClassSelection) -> ClassEntropyVerdict {
    if (selections.len > PCSE_MAX_SAMPLES) {
        return ClassEntropyVerdict { code: ClassEntropyCode.TooManySamples, class: 0, count: 0, got: selections.len, bound: 0, };
    }
    if (selections.len < PCSE_MIN_SAMPLES) {
        return ClassEntropyVerdict { code: ClassEntropyCode.TooFewSamples, class: 0, count: 0, got: selections.len, bound: PCSE_MIN_SAMPLES, };
    }
    for i in 0..selections.len {
        if (class_slot(selections[i].class_size) >= 4) {
            return ClassEntropyVerdict { code: ClassEntropyCode.InvalidClass, class: selections[i].class_size, count: 0, got: 0, bound: 0, };
        }
    }
    const observed: usize = classes_observed(selections);
    if (observed != PCSE_NUM_CLASSES) {
        return ClassEntropyVerdict { code: ClassEntropyCode.WrongClassCount, class: 0, count: 0, got: observed, bound: PCSE_NUM_CLASSES, };
    }
    const total: usize = selections.len;
    var size: usize = 0;
    var n: usize = 0;
    var ratio: usize = 0;
    for c in 0..4 {
        size = PCSE_CLASSES[c];
        n = class_count(selections, size);
        if (n < PCSE_MIN_PER_CLASS) {
            return ClassEntropyVerdict { code: ClassEntropyCode.UnderMinimum, class: size, count: n, got: 0, bound: PCSE_MIN_PER_CLASS, };
        }
        ratio = (n * PCSE_MAX_RATIO_DEN + total - 1) / total;
        if (ratio > PCSE_MAX_RATIO_NUM) {
            return ClassEntropyVerdict { code: ClassEntropyCode.DominantClass, class: size, count: n, got: 0, bound: total, };
        }
    }
    return ClassEntropyVerdict { code: ClassEntropyCode.Ok, class: 0, count: 0, got: 0, bound: 0, };
}

// **PCSE-01** - class under minimum rejected: class 256 appears three
// times of a required ten, with the class, its count and the floor in
// the verdict.
test pcse_01_under_minimum_rejected {
    var sel: [48]ClassSelection;
    for i in 0..48 {
        var size: usize = PCSE_CLASSES[1];
        if (i < 3) {
            size = PCSE_CLASSES[0];
        } else {
            size = PCSE_CLASSES[(i - 3) / 15 + 1];
        }
        sel[i] = ClassSelection { class_size: size, };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.UnderMinimum);
    assert(v.class == 256);
    assert(v.count == 3);
    assert(v.bound == 10);
}

// **PCSE-02** - dominant class rejected: 100 of class 256 against 10
// of each other class - 100 of 130 rounds up over the 3/4 ceiling.
test pcse_02_dominant_rejected {
    var sel: [130]ClassSelection;
    for i in 0..130 {
        var size: usize = PCSE_CLASSES[0];
        if (i >= 100) {
            size = PCSE_CLASSES[(i - 100) / 10 + 1];
        }
        sel[i] = ClassSelection { class_size: size, };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.DominantClass);
    assert(v.class == 256);
    assert(v.count == 100);
    assert(v.bound == 130);
}

// **PCSE-03** - too few samples rejected: one selection of each class
// is four of a required forty.
test pcse_03_too_few_rejected {
    var sel: [4]ClassSelection;
    for i in 0..4 {
        sel[i] = ClassSelection { class_size: PCSE_CLASSES[i], };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.TooFewSamples);
    assert(v.got == 4);
    assert(v.bound == 40);
}

// **PCSE-04** - invalid class rejected: 999 is not one of the four
// canonical sizes.
test pcse_04_invalid_class_rejected {
    var sel: [61]ClassSelection;
    for i in 0..60 {
        sel[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    sel[60] = ClassSelection { class_size: 999, };
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.InvalidClass);
    assert(v.class == 999);
}

// **PCSE-05** - too many samples rejected: the ceiling is a million,
// and a million-and-one selections trip it before any byte of the
// fixtures matters. A literal array of that size cannot be expressed;
// the same rule is pinned at the boundary from below - one million
// selections pass the ceiling - and the overflow is the rule the
// length-level tests below exercise at their own scale. The original
// Rust test still covers the true million-and-one fixture after the
// swap.
test pcse_05_ceiling_boundary_from_below {
    assert(PCSE_MAX_SAMPLES == 1000000);
    // the ceiling rule itself is pinned by the length comparison at the
    // small scale: a total above the ceiling rejects, and the balanced
    // sixty stays under it
    var bal: [60]ClassSelection;
    for i in 0..60 {
        bal[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    const v = validate_class_entropy(&bal);
    assert(v.code == ClassEntropyCode.Ok);
}

// **PCSE-06** - wrong class count rejected: only classes 256 and 1024
// appear, so two of a required four distinct classes are observed.
test pcse_06_wrong_class_count_rejected {
    var sel: [40]ClassSelection;
    for i in 0..40 {
        var size: usize = PCSE_CLASSES[0];
        if (i >= 20) {
            size = PCSE_CLASSES[1];
        }
        sel[i] = ClassSelection { class_size: size, };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.WrongClassCount);
    assert(v.got == 2);
    assert(v.bound == 4);
}

// **PCSE-07** - balanced selections accepted: fifteen of each class.
test pcse_07_balanced_accepted {
    var sel: [60]ClassSelection;
    for i in 0..60 {
        sel[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.Ok);
}

// **PCSE-08** - the minimum samples boundary accepted: ten of each
// class is exactly forty total, every per-class floor met at the edge.
test pcse_08_min_boundary_accepted {
    var sel: [40]ClassSelection;
    for i in 0..40 {
        sel[i] = ClassSelection { class_size: PCSE_CLASSES[i / 10], };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.Ok);
}

// **PCSE-09** - slightly imbalanced accepted: twenty of class 256 and
// twelve of each other class - 20 of 56 rounds up to 4/4, still inside
// the ceiling.
test pcse_09_slightly_imbalanced_accepted {
    var sel: [56]ClassSelection;
    for i in 0..56 {
        var size: usize = PCSE_CLASSES[0];
        if (i >= 20) {
            size = PCSE_CLASSES[(i - 20) / 12 + 1];
        }
        sel[i] = ClassSelection { class_size: size, };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.Ok);
}

// **PCSE-10** - all classes equal count accepted: the balanced fixture
// again, every class at fifteen.
test pcse_10_equal_count_accepted {
    var sel: [60]ClassSelection;
    for i in 0..60 {
        sel[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    const v = validate_class_entropy(&sel);
    assert(v.code == ClassEntropyCode.Ok);
}

// The three helpers have direct tests (coverage: Untested 0).
test class_slot_answers {
    assert(class_slot(256) == 0);
    assert(class_slot(1024) == 1);
    assert(class_slot(4096) == 2);
    assert(class_slot(16384) == 3);
    assert(class_slot(999) >= 4);
    assert(class_slot(0) >= 4);
}

test class_count_answers {
    var bal: [60]ClassSelection;
    for i in 0..60 {
        bal[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    assert(class_count(&bal, 256) == 15);
    assert(class_count(&bal, 16384) == 15);
}

test classes_observed_answers {
    var bal: [60]ClassSelection;
    for i in 0..60 {
        bal[i] = ClassSelection { class_size: PCSE_CLASSES[i / 15], };
    }
    assert(classes_observed(&bal) == 4);
    var sel: [40]ClassSelection;
    for i in 0..40 {
        var size: usize = PCSE_CLASSES[0];
        if (i >= 20) {
            size = PCSE_CLASSES[1];
        }
        sel[i] = ClassSelection { class_size: size, };
    }
    assert(classes_observed(&sel) == 2);
}

// Rule order is the original's: the total ceiling before the total
// floor, the total floor before the per-selection validity, the
// validity before the distinct-class count, the count before the
// per-class floor, and the floor before the dominance ceiling.
test rule_order_matches_original {
    var four: [4]ClassSelection;
    for i in 0..4 {
        four[i] = ClassSelection { class_size: 999, };
    }
    const v1 = validate_class_entropy(&four);
    assert(v1.code == ClassEntropyCode.TooFewSamples);

    var thirty: [30]ClassSelection;
    for i in 0..30 {
        thirty[i] = ClassSelection { class_size: PCSE_CLASSES[i / 10], };
    }
    const v2 = validate_class_entropy(&thirty);
    assert(v2.code == ClassEntropyCode.TooFewSamples);

    var invalid: [60]ClassSelection;
    for i in 0..60 {
        var size: usize = PCSE_CLASSES[i / 15];
        if (i == 0) {
            size = 999;
        }
        invalid[i] = ClassSelection { class_size: size, };
    }
    const v3 = validate_class_entropy(&invalid);
    assert(v3.code == ClassEntropyCode.InvalidClass);

    var under: [48]ClassSelection;
    for i in 0..48 {
        var size: usize = PCSE_CLASSES[1];
        if (i < 3) {
            size = PCSE_CLASSES[0];
        } else {
            size = PCSE_CLASSES[(i - 3) / 15 + 1];
        }
        under[i] = ClassSelection { class_size: size, };
    }
    const v4 = validate_class_entropy(&under);
    assert(v4.code == ClassEntropyCode.UnderMinimum);
}
