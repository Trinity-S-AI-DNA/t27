module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_class_collision_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_class_collision_guard.rs
// (CR-CHAT-04 - Padding class collision guard, Wave-46 Lane B,
// requirement R-CHAT-9).
//
// Padding collapses plaintext lengths into a finite set of classes, so
// two distinct lengths can land in one bucket. The class table keeps
// that narrowing bounded: non-empty, boundaries strictly increasing and
// no more than MAX_CLASS_SIZE, adjacent boundaries at least
// MIN_CLASS_SPAN apart and aligned to CLASS_ALIGNMENT, and no class
// spanning more than MAX_COLLISION_SPAN - the first class by its own
// boundary, each later one by its distance to the boundary before it.
//
// The original returns Result<(), PadClassError>. This port carries the
// verdict as a named struct (owner decision D5): Ok first, then the
// six error variants in the original's declaration order -
// EmptyClasses, NotStrictlyIncreasing, ExceedsMaxClassSize,
// SpanTooSmall, NotAligned, CollisionSpanTooLarge. No variant carries a
// payload, so the verdict is the code alone.
//
// The original's windows(2) scans become index loops over the fixed
// table the caller fills; the table holds the padding classes of the
// tests (five), and one entry beyond holds the sentinel 4294967295,
// which trips the size rule, so an empty table is expressed by the
// length alone.

// Maximum size of any single padding class.
pub const MAX_CLASS_SIZE: usize = 4096;

// Minimum span between adjacent class boundaries.
pub const MIN_CLASS_SPAN: usize = 32;

// Class boundary alignment (must be power of 2).
pub const CLASS_ALIGNMENT: usize = 32;

// Maximum collision span within a single class.
pub const MAX_COLLISION_SPAN: usize = 512;

// The fixed capacity of the class table.
pub const CLASS_TABLE_LEN: usize = 6;

// The sentinel slot: above MAX_CLASS_SIZE, so a length that reaches it
// would trip the size rule rather than read as a class.
pub const CLASS_SENTINEL: usize = 4294967295;

// Verdict codes: Ok(()) and PadClassError's variants, in declaration order.
pub enum PadClassCode {
    Ok,
    EmptyClasses,
    NotStrictlyIncreasing,
    ExceedsMaxClassSize,
    SpanTooSmall,
    NotAligned,
    CollisionSpanTooLarge,
}

// The verdict of the class table validation. No variant of the
// original's error carries a payload, so the code is the whole verdict.
pub struct PadClassVerdict {
    code: PadClassCode,
}

// [VERIFIED] Validate a padding class table. Returns Ok only when
// every rule holds, checked in the original's order: non-empty, the
// per-entry size ceiling and alignment, the strictly-increasing and
// minimum-span scans over adjacent pairs, the first class's own
// collision span, and the adjacent-span collision ceiling.
pub fn validate_padding_classes(classes: []const usize) -> PadClassVerdict {
    if (classes.len == 0) {
        return PadClassVerdict { code: PadClassCode.EmptyClasses, };
    }
    for i in 0..classes.len {
        if (classes[i] > MAX_CLASS_SIZE) {
            return PadClassVerdict { code: PadClassCode.ExceedsMaxClassSize, };
        }
        if (classes[i] % CLASS_ALIGNMENT != 0) {
            return PadClassVerdict { code: PadClassCode.NotAligned, };
        }
    }
    if (classes.len >= 2) {
        for i in 0..classes.len - 1 {
            if (classes[i + 1] <= classes[i]) {
                return PadClassVerdict { code: PadClassCode.NotStrictlyIncreasing, };
            }
            if (classes[i + 1] - classes[i] < MIN_CLASS_SPAN) {
                return PadClassVerdict { code: PadClassCode.SpanTooSmall, };
            }
        }
    }
    if (classes.len >= 2) {
        const first: usize = classes[0];
        if (first > MAX_COLLISION_SPAN) {
            return PadClassVerdict { code: PadClassCode.CollisionSpanTooLarge, };
        }
    }
    if (classes.len >= 2) {
        for i in 0..classes.len - 1 {
            const span: usize = classes[i + 1] - classes[i];
            if (span > MAX_COLLISION_SPAN) {
                return PadClassVerdict { code: PadClassCode.CollisionSpanTooLarge, };
            }
        }
    }
    return PadClassVerdict { code: PadClassCode.Ok, };
}

// The good fixture of the tests: five classes, each aligned, each pair
// at least 32 apart, no pair more than 512 apart.
fn good_classes() [5]usize {
    const classes: [5]usize = [5]usize{64, 128, 256, 512, 1024,};
    return classes;
}

// **PCLC-01** - empty class table rejected.
test pclc_01_empty_rejected {
    const classes: [0]usize = [0]usize{};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.EmptyClasses);
}

// **PCLC-02** - not strictly increasing rejected: 128 after 128.
test pclc_02_not_increasing_rejected {
    const classes: [2]usize = [2]usize{128, 128,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.NotStrictlyIncreasing);
}

// **PCLC-03** - a boundary over the size ceiling rejected: 4096 + 64.
test pclc_03_exceeds_max_rejected {
    const classes: [1]usize = [1]usize{4096 + 64,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.ExceedsMaxClassSize);
}

// **PCLC-04** - equal boundaries rejected (span zero): 64 twice.
test pclc_04_equal_boundaries_rejected {
    const classes: [2]usize = [2]usize{64, 64,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.NotStrictlyIncreasing);
}

// **PCLC-05** - a boundary off the alignment grid rejected: 50 is not
// a multiple of 32.
test pclc_05_not_aligned_rejected {
    const classes: [1]usize = [1]usize{50,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.NotAligned);
}

// **PCLC-06** - collision span too large rejected: 64 to 640 is 576
// over the 512 ceiling. The original's rule order runs the
// strictly-increasing and span scans first (both pass), then the first
// class's own boundary (64, inside), then the adjacent-span ceiling.
test pclc_06_collision_span_rejected {
    const classes: [2]usize = [2]usize{64, 640,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.CollisionSpanTooLarge);
}

// **PCLC-07** - the good five-class table accepted.
test pclc_07_good_accepted {
    const classes = good_classes();
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.Ok);
}

// **PCLC-08** - a single class accepted: one aligned boundary, no
// pairs to check.
test pclc_08_single_class_accepted {
    const classes: [1]usize = [1]usize{64,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.Ok);
}

// **PCLC-09** - the two-class exact boundary accepted: 64 to 128 is
// 64 apart, aligned, inside every ceiling.
test pclc_09_two_class_boundary_accepted {
    const classes: [2]usize = [2]usize{64, 128,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.Ok);
}

// **PCLC-10** - descending table rejected: 128 then 64.
test pclc_10_descending_rejected {
    const classes: [2]usize = [2]usize{128, 64,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.NotStrictlyIncreasing);
}

// Rule order is the original's: the size ceiling before the alignment,
// the alignment before the increasing scan, the increasing scan before
// the minimum span, the minimum span before the collision ceilings,
// and the first class's own boundary before the adjacent spans.
test rule_order_matches_original {
    const bad_size: [2]usize = [2]usize{50, 8192,};
    const v1 = validate_padding_classes(&bad_size);
    assert(v1.code == PadClassCode.NotAligned);

    const bad_align: [2]usize = [2]usize{50, 128,};
    const v2 = validate_padding_classes(&bad_align);
    assert(v2.code == PadClassCode.NotAligned);

    // SpanTooSmall is unreachable behind the alignment rule: every
    // aligned pair spans at least CLASS_ALIGNMENT 32, which is
    // MIN_CLASS_SPAN itself - the original's order hides this variant
    // the same way (noted in the PR).
    const aligned_min_span: [2]usize = [2]usize{64, 96,};
    const v3 = validate_padding_classes(&aligned_min_span);
    assert(v3.code == PadClassCode.Ok);

    const big_first: [2]usize = [2]usize{640, 1024,};
    const v4 = validate_padding_classes(&big_first);
    assert(v4.code == PadClassCode.CollisionSpanTooLarge);
}

// The boundary the original leaves unmeasured: a first class at exactly
// the collision ceiling accepts (512), and one past it rejects.
test collision_span_boundary {
    const at_edge: [2]usize = [2]usize{512, 1024,};
    const v1 = validate_padding_classes(&at_edge);
    assert(v1.code == PadClassCode.Ok);

    const over_edge: [2]usize = [2]usize{544, 1024,};
    const v2 = validate_padding_classes(&over_edge);
    assert(v2.code == PadClassCode.CollisionSpanTooLarge);
}

// A minimum-span pair at exactly 32 accepts.
test min_span_boundary_accepted {
    const classes: [2]usize = [2]usize{64, 96,};
    const v = validate_padding_classes(&classes);
    assert(v.code == PadClassCode.Ok);
}
