module port::padding_class_collision_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_class_collision_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// CLASS COLLISION — padding classes don't collide or interfere (P-CHAT-4.9).
// Different padding classes should be distinct and non-interfering.
// This guard ensures that padding schemes don't create collisions or
// unexpected interactions that could be exploited for side-channel attacks.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * CLASS-COLLISION

/// Padding classes for collision detection.
pub enum PaddingClass {
    Fixed,        // Fixed-length padding
    Variable,     // Variable-length padding
    Random,       // Random-length padding
    Adaptive,     // Context-adaptive padding
    Hybrid,      // Mixed-mode padding
}

/// Maximum allowed collision probability between classes.
const PCC_MAX_COLLISION_PROB: f64 = 0.01; // 1% tolerance

/// Number of test samples for collision detection.
const PCC_SAMPLE_COUNT: usize = 1000;

/// All ways class collision validation can fail.
pub enum CollisionError {
    Ok,
    ClassCollision,
    ExcessiveInterference,
    BoundaryViolation,
    MixedModeConflict,
};

// [VERIFIED] Generate padding class identifier for given parameters.
pub fn get_class_id(class: PaddingClass, params: []const u8) -> u64 {
    var hash: u64 = 0;
    var i: usize = 0;
    while (i < params.len) {
        hash = hash * 31 + u64(params[i]);
        i += 1;
    }
    
    // Add class-specific prefix
    switch (class) {
        .Fixed => hash += 0x1000000000000000,
        .Variable => hash += 0x2000000000000000,
        .Random => hash += 0x3000000000000000,
        .Adaptive => hash += 0x4000000000000000,
        .Hybrid => hash += 0x5000000000000000,
    }
    
    return hash;
}

// [VERIFIED] Check if two padding classes can collide.
pub fn check_class_collision(
    class1: PaddingClass,
    params1: []const u8,
    class2: PaddingClass,
    params2: []const u8
) -> bool {
    const id1 = get_class_id(class1, params1);
    const id2 = get_class_id(class2, params2);
    
    return id1 == id2;
}

// [VERIFIED] Validate no collisions between different padding classes.
// Returns .Ok when no collisions detected; error variant otherwise.
pub fn validate_class_collisions(
    test_cases: []const PaddingClass,
    test_params: []const []const u8
) -> CollisionError {
    if (test_cases.len != test_params.len) {
        return .ClassCollision;
    }
    
    if (test_cases.len < 2) {
        return .Ok;
    }
    
    var collision_count: usize = 0;
    var i: usize = 0;
    while (i < test_cases.len) {
        var j: usize = i + 1;
        while (j < test_cases.len) {
            if (check_class_collision(test_cases[i], test_params[i], test_cases[j], test_params[j])) {
                collision_count += 1;
            }
            j += 1;
        }
        i += 1;
    }
    
    // Check collision probability
    const total_pairs = test_cases.len * (test_cases.len - 1) / 2;
    const collision_prob = f64(collision_count) / f64(total_pairs);
    
    if (collision_prob > PCC_MAX_COLLISION_PROB) {
        return .ClassCollision;
    }
    
    // Check for boundary violations between different classes
    var boundary_violations: usize = 0;
    var k: usize = 0;
    while (k < test_cases.len) {
        const class = test_cases[k];
        const params = test_params[k];
        
        // Check if parameters are valid for the class
        switch (class) {
            .Fixed => {
                if (params.len == 0) {
                    boundary_violations += 1;
                }
            },
            .Variable => {
                if (params.len < 2) {
                    boundary_violations += 1;
                }
            },
            .Random => {
                if (params.len < 1) {
                    boundary_violations += 1;
                }
            },
            .Adaptive => {
                if (params.len < 3) {
                    boundary_violations += 1;
                }
            },
            .Hybrid => {
                if (params.len < 4) {
                    boundary_violations += 1;
                }
            },
        }
        k += 1;
    }
    
    if (boundary_violations > 0) {
        return .BoundaryViolation;
    }
    
    return .Ok;
}

// **PCC-01** — no collisions between different classes.
test pcc_01_no_collisions {
    const test_classes: [5]PaddingClass = [.Fixed, .Variable, .Random, .Adaptive, .Hybrid];
    const test_params: [5][]const u8 = [
        [16, 0, 0], // Fixed: 16 bytes
        [32, 1, 0], // Variable: min 32, max 64
        [8, 0xFF],  // Random: 8 bytes max
        [16, 32, 1], // Adaptive: base 16, max 32
        [8, 16, 2, 1], // Hybrid: multiple modes
    ];
    assert(validate_class_collisions(test_classes, test_params) == .Ok);
}

// **PCC-02** — collision detection works.
test pcc_02_collision_detection {
    const same_class: [2]PaddingClass = [.Fixed, .Fixed];
    const same_params: [2][]const u8 = [[16, 0, 0], [16, 0, 0]];
    assert(check_class_collision(same_class[0], same_params[0], same_class[1], same_params[1]) == true);
    
    const different_params: [2][]const u8 = [[16, 0, 0], [32, 0, 0]];
    assert(check_class_collision(same_class[0], same_params[0], same_class[1], different_params[1]) == false);
}

// **PCC-03** — different classes don't collide.
test pcc_03_different_classes_no_collision {
    const different_classes: [2]PaddingClass = [.Fixed, .Variable];
    const test_params: [2][]const u8 = [[16, 0, 0], [32, 1, 0]];
    assert(check_class_collision(different_classes[0], test_params[0], different_classes[1], test_params[1]) == false);
}

// **PCC-04** — boundary validation.
test pcc_04_boundary_validation {
    const invalid_cases: [5]PaddingClass = [.Fixed, .Variable, .Random, .Adaptive, .Hybrid];
    const invalid_params: [5][]const u8 = [
        [],           // Fixed needs length
        [1],          // Variable needs min/max
        [],           // Random needs max length
        [1],          // Adaptive needs base/max/threshold
        [1],          // Hybrid needs multiple parameters
    ];
    assert(validate_class_collisions(invalid_cases, invalid_params) == .BoundaryViolation);
}

// **PCC-05** — ID generation uniqueness.
test pcc_05_id_uniqueness {
    const unique_ids: [10]u64 = undefined;
    var i: usize = 0;
    while (i < 10) {
        const params: [3]u8 = [i as u8, (i + 1) as u8, (i + 2) as u8];
        unique_ids[i] = get_class_id(.Fixed, params);
        i += 1;
    }
    
    // Check all IDs are unique
    var j: usize = 0;
    while (j < 10) {
        var k: usize = j + 1;
        while (k < 10) {
            assert(unique_ids[j] != unique_ids[k]);
            k += 1;
        }
        j += 1;
    }
}

// **PCC-06** — validation is deterministic.
test pcc_06_deterministic {
    const test_classes: [3]PaddingClass = [.Fixed, .Variable, .Random];
    const test_params: [3][]const u8 = [[16, 0, 0], [32, 1, 0], [8, 0xFF]];
    const result1 = validate_class_collisions(test_classes, test_params);
    const result2 = validate_class_collisions(test_classes, test_params);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PCC-07** — hybrid class conflict detection.
test pcc_07_hybrid_conflict {
    const hybrid_cases: [3]PaddingClass = [.Hybrid, .Hybrid, .Hybrid];
    const hybrid_params: [3][]const u8 = [
        [8, 16, 2, 1],   // Mode 1: Fixed + Variable
        [8, 16, 2, 2],   // Mode 2: Fixed + Random
        [8, 16, 2, 3],   // Mode 3: Variable + Random
    ];
    assert(validate_class_collisions(hybrid_cases, hybrid_params) == .Ok);
}

// **PCC-08** — adaptive class behavior.
test pcc_08_adaptive_behavior {
    const adaptive_cases: [3]PaddingClass = [.Adaptive, .Adaptive, .Adaptive];
    const adaptive_params: [3][]const u8 = [
        [16, 32, 1],    // Base 16, max 32, threshold 1
        [16, 32, 2],    // Base 16, max 32, threshold 2
        [16, 64, 1],    // Base 16, max 64, threshold 1
    ];
    assert(validate_class_collisions(adaptive_cases, adaptive_params) == .Ok);
}