module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_class_transition_audit;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_class_transition_audit.rs
// (CR-CHAT-04 - Padding class transition audit, Wave-43 Lane B,
// requirement R-CHAT-9).
//
// Crossing a padding class boundary is visible on the wire, so a
// sequence of class choices must not leak message-size metadata: every
// class canonical, non-decreasing within any window of
// PCTA_WINDOW_SIZE, no more than window_size/2 class changes inside a
// window, and every class run (except possibly the last) at least
// PCTA_MIN_CLASS messages long.
//
// The original returns Result<(), PaddingTransitionError>. This port
// carries the verdict as a named struct (owner decision D5): Ok first,
// then the five error variants in the original's declaration order -
// NonCanonicalClass, ClassDecreased, RapidOscillation,
// InsufficientPerClass, ZeroWindowSize. No variant carries a payload,
// so the verdict is the code alone.
//
// The original's windows(PCTA_WINDOW_SIZE) sliding scan becomes a
// window loop over the fixed capacity the caller fills (the sentinel
// 4294967295 is not a canonical class, so a length that reaches it
// would trip the canonical rule rather than read as a choice).

// Sliding window size for transition audit.
pub const PCTA_WINDOW_SIZE: usize = 10;

// Minimum messages per class before transitioning.
pub const PCTA_MIN_PER_CLASS: usize = 2;

// All canonical padding classes.
pub const PCTA_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384};

// The fixed capacity of the choice table.
pub const PCTA_TABLE_LEN: usize = 100;

// The sentinel slot: not a canonical class.
pub const PCTA_SENTINEL: usize = 4294967295;

// One padding class choice in sequence.
pub struct PaddingChoice {
    class: usize,
}

// Verdict codes: Ok(()) and PaddingTransitionError's variants, in declaration order.
pub enum PaddingTransitionCode {
    Ok,
    NonCanonicalClass,
    ClassDecreased,
    RapidOscillation,
    InsufficientPerClass,
    ZeroWindowSize,
}

// The verdict of the transition audit. No variant of the original's
// error carries a payload, so the code is the whole verdict.
pub struct PaddingTransitionVerdict {
    code: PaddingTransitionCode,
}

// Whether the class is one of the four canonical classes - the
// original's PCTA_CLASSES.contains, answered by a scan.
pub fn is_canonical(class: usize) -> bool {
    for c in PCTA_CLASSES {
        if (c == class) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Audit a sequence of padding class choices for metadata
// leaks. Returns Ok when every rule holds, checked in the original's
// order: the window size (a constant, answered once), the empty
// sequence, the per-choice canonical scan, then per window the change
// count and the non-decreasing scan, then the per-class run lengths.
pub fn audit_padding_transitions(choices: []const PaddingChoice) -> PaddingTransitionVerdict {
    if (PCTA_WINDOW_SIZE == 0) {
        return PaddingTransitionVerdict { code: PaddingTransitionCode.ZeroWindowSize, };
    }
    if (choices.len == 0) {
        return PaddingTransitionVerdict { code: PaddingTransitionCode.Ok, };
    }
    for i in 0..choices.len {
        if (!is_canonical(choices[i].class)) {
            return PaddingTransitionVerdict { code: PaddingTransitionCode.NonCanonicalClass, };
        }
    }
    if (choices.len >= PCTA_WINDOW_SIZE) {
        var w: usize = 0;
        while (w + PCTA_WINDOW_SIZE <= choices.len) {
            var changes: usize = 0;
            var k: usize = 1;
            while (k < PCTA_WINDOW_SIZE) {
                if (choices[w + k].class != choices[w + k - 1].class) {
                    changes = changes + 1;
                }
                k = k + 1;
            }
            if (changes > PCTA_WINDOW_SIZE / 2) {
                return PaddingTransitionVerdict { code: PaddingTransitionCode.RapidOscillation, };
            }
            var d: usize = 1;
            while (d < PCTA_WINDOW_SIZE) {
                if (choices[w + d].class < choices[w + d - 1].class) {
                    return PaddingTransitionVerdict { code: PaddingTransitionCode.ClassDecreased, };
                }
                d = d + 1;
            }
            w = w + 1;
        }
    }
    var run_start: usize = 0;
    var i: usize = 1;
    while (i < choices.len) {
        if (choices[i].class != choices[run_start].class) {
            const run_len: usize = i - run_start;
            if (run_len < PCTA_MIN_PER_CLASS) {
                return PaddingTransitionVerdict { code: PaddingTransitionCode.InsufficientPerClass, };
            }
            run_start = i;
        }
        i = i + 1;
    }
    return PaddingTransitionVerdict { code: PaddingTransitionCode.Ok, };
}

// **PCTA-01** - non-canonical class rejected: 512 is not one of the
// four canonical classes.
test pcta_01_non_canonical_class_rejected {
    const choices: [2]PaddingChoice = [2]PaddingChoice{ PaddingChoice { class: 512, }, PaddingChoice { class: 512, },};
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.NonCanonicalClass);
}

// **PCTA-02** - class decreased rejected: five of 1024 then five of
// 256, and the window that spans the boundary sees the decrease.
test pcta_02_class_decreased_rejected {
    const choices: [10]PaddingChoice = [10]PaddingChoice{
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
    };
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.ClassDecreased);
}

// **PCTA-03** - one choice of each class in a row: each run is one
// message of a required two, so the run-length rule rejects (the
// change count of a four-long sequence never reaches a window of
// ten, so the oscillation rule never fires first).
test pcta_03_rapid_changes_insufficient_rejected {
    const choices: [4]PaddingChoice = [4]PaddingChoice{
        PaddingChoice { class: 256, },
        PaddingChoice { class: 1024, },
        PaddingChoice { class: 4096, },
        PaddingChoice { class: 16384, },
    };
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.InsufficientPerClass);
}

// **PCTA-04** - insufficient per-class messages rejected: one of 256
// then three of 1024 - the 256 run is a single message.
test pcta_04_insufficient_per_class_rejected {
    const choices: [4]PaddingChoice = [4]PaddingChoice{
        PaddingChoice { class: 256, },
        PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, },
    };
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.InsufficientPerClass);
}

// **PCTA-05** - a uniform twenty-message sequence accepted.
test pcta_05_uniform_accepted {
    var choices: [20]PaddingChoice;
    for i in 0..20 {
        choices[i] = PaddingChoice { class: 1024, };
    }
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// **PCTA-06** - an empty sequence accepted.
test pcta_06_empty_accepted {
    const choices: [0]PaddingChoice = [0]PaddingChoice{};
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// **PCTA-07** - a monotonic transition accepted: four messages of each
// of the first three classes in ascending order - every run above
// the floor, every window non-decreasing, and the change count inside
// the two windows of twelve at most two, under the ceiling of five.
test pcta_07_monotonic_transition_accepted {
    const choices: [12]PaddingChoice = [12]PaddingChoice{
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 4096, }, PaddingChoice { class: 4096, },
        PaddingChoice { class: 4096, }, PaddingChoice { class: 4096, },
    };
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// **PCTA-08** - a single message accepted: no transitions, no window.
test pcta_08_single_message_accepted {
    const choices: [1]PaddingChoice = [1]PaddingChoice{ PaddingChoice { class: 256, },};
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// **PCTA-09** - a long uniform sequence accepted: a hundred of 4096.
test pcta_09_long_uniform_accepted {
    var choices: [100]PaddingChoice;
    for i in 0..100 {
        choices[i] = PaddingChoice { class: 4096, };
    }
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// **PCTA-10** - the minimal valid transition accepted: exactly
// PCTA_MIN_PER_CLASS of each of the first two classes.
test pcta_10_min_per_class_transition_accepted {
    const choices: [4]PaddingChoice = [4]PaddingChoice{
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
    };
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test is_canonical_answers {
    assert(is_canonical(256));
    assert(is_canonical(1024));
    assert(is_canonical(4096));
    assert(is_canonical(16384));
    assert(!is_canonical(512));
    assert(!is_canonical(0));
}

// Rule order is the original's: the canonical scan before the window
// scans, the change count before the decrease scan inside a window,
// the window scans before the run lengths, and a sequence under the
// window size skips both window rules.
test rule_order_matches_original {
    const bad_class: [4]PaddingChoice = [4]PaddingChoice{
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 512, }, PaddingChoice { class: 256, },
    };
    const v1 = audit_padding_transitions(&bad_class);
    assert(v1.code == PaddingTransitionCode.NonCanonicalClass);

    // a decrease inside the first full window of ten
    const decreased: [10]PaddingChoice = [10]PaddingChoice{
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 256, }, PaddingChoice { class: 256, },
        PaddingChoice { class: 256, }, PaddingChoice { class: 4096, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
        PaddingChoice { class: 1024, }, PaddingChoice { class: 1024, },
    };
    const v2 = audit_padding_transitions(&decreased);
    assert(v2.code == PaddingTransitionCode.ClassDecreased);

    // an alternating ten trips the change-count ceiling first: nine
    // changes in the one window of ten, over the window_size/2 = 5
    // ceiling - the oscillation rule fires before the run rule
    var oscillating: [10]PaddingChoice;
    for i in 0..10 {
        var cls: usize = PCTA_CLASSES[0];
        if (i % 2 == 1) {
            cls = PCTA_CLASSES[1];
        }
        oscillating[i] = PaddingChoice { class: cls, };
    }
    const v3 = audit_padding_transitions(&oscillating);
    assert(v3.code == PaddingTransitionCode.RapidOscillation);
}

// The window rules leave the scene under the window size: a sequence of
// nine choices never opens a window of ten, so only the canonical and
// run-length rules apply.
test under_window_skips_window_rules {
    var choices: [9]PaddingChoice;
    for i in 0..9 {
        choices[i] = PaddingChoice { class: 256, };
    }
    const v = audit_padding_transitions(&choices);
    assert(v.code == PaddingTransitionCode.Ok);
}
