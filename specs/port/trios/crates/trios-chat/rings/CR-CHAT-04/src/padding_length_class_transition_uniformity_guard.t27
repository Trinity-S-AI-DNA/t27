module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_length_class_transition_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_length_class_transition_uniformity_guard.rs
// (CR-CHAT-04 - Padding length class transition uniformity guard,
// Wave-128 Lane A, requirement R-CHAT-4).
//
// Transitions between padding length classes must be uniform: a
// class the real messages favor shows up as a transition
// fingerprint, a Markov observer can predict the next class off a
// transition matrix, and the bias names the padding algorithm's
// preferred classes. The rules, in the original's order: the batch
// ceiling, the minimum floor, then per record the two class-index
// ceilings, the strictly-increasing timestamp, the no-self-transition
// probe, and after the whole batch the chi-squared ceiling over the
// destination-class counts.
//
// The original returns Result<(), TransitionUniformityError>. This
// port carries the verdict as a named struct (owner decision D5):
// Ok first, then the six error variants in the original's
// declaration order - NonUniform, TooFew, InvalidClass,
// DuplicateConsecutive, NonMonotonic, TooMany - with every payload
// field: chi and max for NonUniform, got and min for TooFew, idx,
// class and max for InvalidClass, idx and class for
// DuplicateConsecutive, idx, prev and current for NonMonotonic, and
// got and max for TooMany.
//
// The original accumulates destination counts in usize and casts
// them to f64 inside chi_squared_flat; t27b rejects the
// int-to-float cast, so the counts accumulate in f64 from the start
// - integers far below f64's exact range, arithmetic identical to
// the original's cast-then-sum. The batch passes as a slice
// ([]const), the conventions' fixed form, and the timestamps stay
// u64 as declared.

// Number of padding length classes.
pub const PLCT_NUM_CLASSES: usize = 4;

// Maximum chi-squared statistic.
pub const PLCT_MAX_CHI_SQUARED: f64 = 15.0;

// Minimum transitions for chi-squared validity.
pub const PLCT_MIN_TRANSITIONS: usize = 8;

// Maximum transitions per batch.
pub const PLCT_MAX_TRANSITIONS: usize = 4096;

// A padding length class transition.
pub struct TransitionObservation {
    from_class: usize,
    to_class: usize,
    timestamp_ms: u64,
}

// Verdict codes: Ok(()) and TransitionUniformityError's variants, in declaration order.
pub enum TransitionUniformityCode {
    Ok,
    NonUniform,
    TooFew,
    InvalidClass,
    DuplicateConsecutive,
    NonMonotonic,
    TooMany,
}

// The verdict of the transition uniformity validation, with every
// error payload field.
pub struct TransitionUniformityVerdict {
    code: TransitionUniformityCode,
    idx: usize,
    got: usize,
    bound: usize,
    class: usize,
    got_f: f64,
    bound_f: f64,
    prev: u64,
    current: u64,
}

// The chi-squared distance of the observed class counts from a flat
// distribution - the original's chi_squared_flat over the f64 count
// table. A zero total answers zero, and so does a zero expectation.
pub fn chi_squared_flat(observed: [4]f64) -> f64 {
    var total: f64 = 0.0;
    for i in 0..4 {
        total = total + observed[i];
    }
    if (total == 0.0) {
        return 0.0;
    }
    const expected: f64 = total / 4.0;
    if (expected == 0.0) {
        return 0.0;
    }
    var chi: f64 = 0.0;
    var diff: f64 = 0.0;
    for i in 0..4 {
        diff = observed[i] - expected;
        chi = chi + diff * diff / expected;
    }
    return chi;
}

// [VERIFIED] Validate padding length class transition uniformity.
// Returns Ok only when every rule holds, checked in the original's
// order: the batch ceiling, the minimum floor, then per record the
// two class-index ceilings, the strictly-increasing timestamp and
// the no-self-transition probe, then the chi-squared ceiling over
// the destination-class counts of the whole batch.
pub fn validate_transition_uniformity(transitions: []const TransitionObservation) -> TransitionUniformityVerdict {
    if (transitions.len > PLCT_MAX_TRANSITIONS) {
        return TransitionUniformityVerdict { code: TransitionUniformityCode.TooMany, idx: 0, got: transitions.len, bound: PLCT_MAX_TRANSITIONS, class: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
    }
    if (transitions.len < PLCT_MIN_TRANSITIONS) {
        return TransitionUniformityVerdict { code: TransitionUniformityCode.TooFew, idx: 0, got: transitions.len, bound: PLCT_MIN_TRANSITIONS, class: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
    }
    var prev_ts: u64 = 0;
    var counts: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0,};
    for i in 0..transitions.len {
        if (transitions[i].from_class >= PLCT_NUM_CLASSES) {
            return TransitionUniformityVerdict { code: TransitionUniformityCode.InvalidClass, idx: i, got: 0, bound: PLCT_NUM_CLASSES - 1, class: transitions[i].from_class, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        if (transitions[i].to_class >= PLCT_NUM_CLASSES) {
            return TransitionUniformityVerdict { code: TransitionUniformityCode.InvalidClass, idx: i, got: 0, bound: PLCT_NUM_CLASSES - 1, class: transitions[i].to_class, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        if (i > 0) {
            if (transitions[i].timestamp_ms <= prev_ts) {
                return TransitionUniformityVerdict { code: TransitionUniformityCode.NonMonotonic, idx: i, got: 0, bound: 0, class: 0, got_f: 0.0, bound_f: 0.0, prev: prev_ts, current: transitions[i].timestamp_ms, };
            }
        }
        if (transitions[i].from_class == transitions[i].to_class) {
            return TransitionUniformityVerdict { code: TransitionUniformityCode.DuplicateConsecutive, idx: i, got: 0, bound: 0, class: transitions[i].from_class, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        counts[transitions[i].to_class] = counts[transitions[i].to_class] + 1.0;
        prev_ts = transitions[i].timestamp_ms;
    }
    const chi: f64 = chi_squared_flat(counts);
    if (chi > PLCT_MAX_CHI_SQUARED) {
        return TransitionUniformityVerdict { code: TransitionUniformityCode.NonUniform, idx: 0, got: 0, bound: 0, class: 0, got_f: chi, bound_f: PLCT_MAX_CHI_SQUARED, prev: 0, current: 0, };
    }
    return TransitionUniformityVerdict { code: TransitionUniformityCode.Ok, idx: 0, got: 0, bound: 0, class: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
}

// The uniform fixture: four rounds over the four classes, each
// transition to the next class, timestamps stepping by one - the
// original's uniform_batch(), entry by entry.
pub const UNIFORM_16: [16]TransitionObservation = [16]TransitionObservation{
    TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
    TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 2, },
    TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 3, },
    TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 4, },
    TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
    TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 6, },
    TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 7, },
    TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 8, },
    TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 9, },
    TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 10, },
    TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 11, },
    TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 12, },
    TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 13, },
    TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 14, },
    TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 15, },
    TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 16, },
};

// **PLCT-01** - non-uniform rejected: eight transitions all landing
// in class zero, chi-squared 24 over the ceiling of 15.
test plct_01_non_uniform_rejected {
    const records: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 1, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 2, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 3, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 4, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 5, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 6, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 7, },
        TransitionObservation { from_class: 1, to_class: 0, timestamp_ms: 8, },
    };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.NonUniform);
    assert(v.got_f == 24.0);
    assert(v.bound_f == 15.0);
}

// **PLCT-02** - too few rejected: seven transitions of a required
// eight.
test plct_02_too_few_rejected {
    const records: [7]TransitionObservation = [7]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 2, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 3, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 7, },
    };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.TooFew);
    assert(v.got == 7);
    assert(v.bound == 8);
}

// **PLCT-03** - invalid class rejected: the appended transition aims
// at class four of a zero-indexed maximum three.
test plct_03_invalid_class_rejected {
    var records: [17]TransitionObservation;
    for i in 0..16 {
        records[i] = UNIFORM_16[i];
    }
    records[16] = TransitionObservation { from_class: 0, to_class: 4, timestamp_ms: 9999, };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.InvalidClass);
    assert(v.idx == 16);
    assert(v.class == 4);
    assert(v.bound == 3);
}

// **PLCT-04** - duplicate consecutive rejected: the appended
// transition stays in class zero.
test plct_04_duplicate_consecutive_rejected {
    var records: [17]TransitionObservation;
    for i in 0..16 {
        records[i] = UNIFORM_16[i];
    }
    records[16] = TransitionObservation { from_class: 0, to_class: 0, timestamp_ms: 9999, };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.DuplicateConsecutive);
    assert(v.idx == 16);
    assert(v.class == 0);
}

// **PLCT-05** - non-monotonic rejected: the appended transition's
// timestamp goes back to one after sixteen.
test plct_05_non_monotonic_rejected {
    var records: [17]TransitionObservation;
    for i in 0..16 {
        records[i] = UNIFORM_16[i];
    }
    records[16] = TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.NonMonotonic);
    assert(v.idx == 16);
    assert(v.prev == 16);
    assert(v.current == 1);
}

// **PLCT-06** - too many rejected: 4097 transitions of a maximum
// 4096, built in a loop like the original's. The batch rule fires
// before any record is examined, so every record carries the same
// minimal transition.
test plct_06_too_many_rejected {
    var records: [4097]TransitionObservation;
    for i in 0..4097 {
        records[i] = TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, };
    }
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.TooMany);
    assert(v.got == 4097);
    assert(v.bound == 4096);
}

// **PLCT-07** - the uniform batch accepted.
test plct_07_uniform_accepted {
    const v = validate_transition_uniformity(&UNIFORM_16);
    assert(v.code == TransitionUniformityCode.Ok);
}

// **PLCT-08** - exactly the minimum accepted: eight transitions
// cycling the four classes.
test plct_08_exact_minimum_accepted {
    const records: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
        TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 2, },
        TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 3, },
        TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 6, },
        TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 7, },
        TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 8, },
    };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.Ok);
}

// **PLCT-09** - mixed transitions accepted: eight transitions
// spreading over all destination classes, two each.
test plct_09_mixed_accepted {
    const records: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
        TransitionObservation { from_class: 1, to_class: 2, timestamp_ms: 2, },
        TransitionObservation { from_class: 2, to_class: 3, timestamp_ms: 3, },
        TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 2, timestamp_ms: 5, },
        TransitionObservation { from_class: 2, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 1, to_class: 3, timestamp_ms: 7, },
        TransitionObservation { from_class: 3, to_class: 0, timestamp_ms: 8, },
    };
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.Ok);
}

// **PLCT-10** - a large uniform batch accepted: one hundred
// transitions cycling the classes, timestamps stepping by one from
// a u64 counter - the original's (i as u64) + 1 without the cast.
test plct_10_large_batch_accepted {
    var records: [100]TransitionObservation;
    var ts: u64 = 1;
    for i in 0..100 {
        var from: usize = i % 4;
        var to: usize = (from + 1) % 4;
        records[i] = TransitionObservation { from_class: from, to_class: to, timestamp_ms: ts, };
        ts = ts + 1;
    }
    const v = validate_transition_uniformity(&records);
    assert(v.code == TransitionUniformityCode.Ok);
}

// The chi-squared helper has a direct test (coverage: Untested 0).
test chi_squared_flat_answers {
    const flat: [4]f64 = [4]f64{2.0, 2.0, 2.0, 2.0,};
    assert(chi_squared_flat(flat) == 0.0);
    const skewed: [4]f64 = [4]f64{8.0, 0.0, 0.0, 0.0,};
    assert(chi_squared_flat(skewed) == 24.0);
    const zeros: [4]f64 = [4]f64{0.0, 0.0, 0.0, 0.0,};
    assert(chi_squared_flat(zeros) == 0.0);
}

// Rule order is the original's: the minimum floor before any record
// (even an invalid one), the source class before the destination,
// the class ceilings before the timestamp, and the timestamp before
// the self-transition probe.
test rule_order_matches_original {
    const short_invalid: [7]TransitionObservation = [7]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 9, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 2, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 3, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 7, },
    };
    const v1 = validate_transition_uniformity(&short_invalid);
    assert(v1.code == TransitionUniformityCode.TooFew);
    assert(v1.got == 7);

    const from_first: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 9, to_class: 8, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 2, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 3, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 7, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 8, },
    };
    const v2 = validate_transition_uniformity(&from_first);
    assert(v2.code == TransitionUniformityCode.InvalidClass);
    assert(v2.idx == 0);
    assert(v2.class == 9);

    const class_before_ts: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
        TransitionObservation { from_class: 9, to_class: 0, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 2, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 3, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 7, },
    };
    const v3 = validate_transition_uniformity(&class_before_ts);
    assert(v3.code == TransitionUniformityCode.InvalidClass);
    assert(v3.idx == 1);
    assert(v3.class == 9);

    const ts_before_self: [8]TransitionObservation = [8]TransitionObservation{
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 0, timestamp_ms: 1, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 2, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 3, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 4, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 5, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 6, },
        TransitionObservation { from_class: 0, to_class: 1, timestamp_ms: 7, },
    };
    const v4 = validate_transition_uniformity(&ts_before_self);
    assert(v4.code == TransitionUniformityCode.NonMonotonic);
    assert(v4.idx == 1);
    assert(v4.prev == 1);
    assert(v4.current == 1);
}
