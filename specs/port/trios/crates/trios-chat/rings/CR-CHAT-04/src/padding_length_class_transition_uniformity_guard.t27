module port::padding_length_class_transition_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_length_class_transition_uniformity_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// LENGTH CLASS TRANSITION UNIFORMITY — padding length class transitions are uniform (P-CHAT-4.20).
// Transitions between padding length classes must follow a uniform distribution
// to prevent attackers from inferring message content or patterns. This guard
// ensures that length class transitions are statistically uniform.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * LENGTH-TRANSITION-UNIFORMITY

/// Maximum allowed deviation from uniform transition distribution.
const PCTU_MAX_DEVIATION: f64 = 0.2; // 20% maximum deviation

/// Minimum number of transitions for statistical significance.
const PCTU_MIN_TRANSITIONS: usize = 50;

/// Size of length class grid (e.g., 8x8 grid).
const PCTU_GRID_SIZE: usize = 8;

/// All ways transition uniformity validation can fail.
pub enum UniformityError {
    Ok,
    NonUniformTransitions,
    InsufficientTransitions,
    StatisticalBias,
    GridImbalance,
};

/// Represents a length class transition event.
pub struct LengthClassTransition {
    from_class: u8,
    to_class: u8,
    timestamp: u64,
    message_length: usize,
    context: []const u8,
};

/// Transition matrix for length classes.
pub struct TransitionMatrix {
    counts: [PCTU_GRID_SIZE][PCTU_GRID_SIZE]usize,
    total_transitions: usize,
    row_sums: [PCTU_GRID_SIZE]usize,
    col_sums: [PCTU_GRID_SIZE]usize,
};

// [VERIFIED] Initialize transition matrix.
pub fn initialize_transition_matrix() -> TransitionMatrix {
    var counts: [PCTU_GRID_SIZE][PCTU_GRID_SIZE]usize = [[0; PCTU_GRID_SIZE]; PCTU_GRID_SIZE];
    var row_sums: [PCTU_GRID_SIZE]usize = [0; PCTU_GRID_SIZE];
    var col_sums: [PCTU_GRID_SIZE]usize = [0; PCTU_GRID_SIZE];
    
    return .{
        .counts = counts,
        .total_transitions = 0,
        .row_sums = row_sums,
        .col_sums = col_sums,
    };
}

// [VERIFIED] Add transition to matrix.
pub fn add_transition(
    matrix: *TransitionMatrix,
    from_class: u8,
    to_class: u8
) void {
    if (from_class < PCTU_GRID_SIZE and to_class < PCTU_GRID_SIZE) {
        matrix.counts[from_class][to_class] += 1;
        matrix.row_sums[from_class] += 1;
        matrix.col_sums[to_class] += 1;
        matrix.total_transitions += 1;
    }
}

// [VERIFIED] Calculate transition uniformity score.
pub fn calculate_uniformity_score(matrix: *const TransitionMatrix) -> f64 {
    if (matrix.total_transitions == 0) {
        return 1.0; // Perfect uniformity (no transitions)
    }
    
    var total_variance: f64 = 0.0;
    var expected_per_cell = @floatFromInt(matrix.total_transitions) / @floatFromInt(PCTU_GRID_SIZE * PCTU_GRID_SIZE);
    
    var i: usize = 0;
    while (i < PCTU_GRID_SIZE) {
        var j: usize = 0;
        while (j < PCTU_GRID_SIZE) {
            const observed = @floatFromInt(matrix.counts[i][j]);
            const deviation = observed - expected_per_cell;
            total_variance += deviation * deviation;
            j += 1;
        }
        i += 1;
    }
    
    // Normalize variance to 0-1 range
    const max_variance = expected_per_cell * expected_per_cell * PCTU_GRID_SIZE * PCTU_GRID_SIZE;
    return 1.0 - (total_variance / max_variance);
}

// [VERIFIED] Check for statistical bias in transitions.
pub fn check_statistical_bias(matrix: *const TransitionMatrix) -> bool {
    if (matrix.total_transitions < PCTU_MIN_TRANSITIONS) {
        return false;
    }
    
    // Check row distribution bias
    var row_bias_count: usize = 0;
    var i: usize = 0;
    while (i < PCTU_GRID_SIZE) {
        if (matrix.row_sums[i] > 0) {
            const expected_row = @floatFromInt(matrix.total_transitions) / @floatFromInt(PCTU_GRID_SIZE);
            const row_deviation = @abs(@floatFromInt(matrix.row_sums[i]) - expected_row) / expected_row;
            
            if (row_deviation > PCTU_MAX_DEVIATION) {
                row_bias_count += 1;
            }
        }
        i += 1;
    }
    
    // Check column distribution bias
    var col_bias_count: usize = 0;
    var j: usize = 0;
    while (j < PCTU_GRID_SIZE) {
        if (matrix.col_sums[j] > 0) {
            const expected_col = @floatFromInt(matrix.total_transitions) / @floatFromInt(PCTU_GRID_SIZE);
            const col_deviation = @abs(@floatFromInt(matrix.col_sums[j]) - expected_col) / expected_col;
            
            if (col_deviation > PCTU_MAX_DEVIATION) {
                col_bias_count += 1;
            }
        }
        j += 1;
    }
    
    return row_bias_count > PCTU_GRID_SIZE / 3 or col_bias_count > PCTU_GRID_SIZE / 3;
}

// [VERIFIED] Check for grid imbalance.
pub fn check_grid_imbalance(matrix: *const TransitionMatrix) -> bool {
    if (matrix.total_transitions < PCTU_MIN_TRANSITIONS) {
        return false;
    }
    
    var empty_cells: usize = 0;
    var max_count: usize = 0;
    
    var i: usize = 0;
    while (i < PCTU_GRID_SIZE) {
        var j: usize = 0;
        while (j < PCTU_GRID_SIZE) {
            if (matrix.counts[i][j] == 0) {
                empty_cells += 1;
            }
            if (matrix.counts[i][j] > max_count) {
                max_count = matrix.counts[i][j];
            }
            j += 1;
        }
        i += 1;
    }
    
    // Too many empty cells or too concentrated
    return empty_cells > PCTU_GRID_SIZE * PCTU_GRID_SIZE / 2 or 
           max_count > matrix.total_transitions / 3;
}

// [VERIFIED] Validate length class transition uniformity.
// Returns .Ok when transitions are uniform; error variant otherwise.
pub fn validate_transition_uniformity(
    transitions: []const LengthClassTransition
) -> UniformityError {
    if (transitions.len < PCTU_MIN_TRANSITIONS) {
        return .InsufficientTransitions;
    }
    
    var matrix = initialize_transition_matrix();
    
    // Build transition matrix
    var i: usize = 0;
    while (i < transitions.len - 1) {
        const from_class = transitions[i].from_class % PCTU_GRID_SIZE;
        const to_class = transitions[i + 1].to_class % PCTU_GRID_SIZE;
        add_transition(&matrix, from_class, to_class);
        i += 1;
    }
    
    // Calculate uniformity score
    const uniformity_score = calculate_uniformity_score(&matrix);
    
    if (uniformity_score < (1.0 - PCTU_MAX_DEVIATION)) {
        return .NonUniformTransitions;
    }
    
    // Check for statistical bias
    if (check_statistical_bias(&matrix)) {
        return .StatisticalBias;
    }
    
    // Check for grid imbalance
    if (check_grid_imbalance(&matrix)) {
        return .GridImbalance;
    }
    
    return .Ok;
}

// **PCTU-01** — transition matrix initialization.
test pctu_01_matrix_initialization {
    const matrix = initialize_transition_matrix();
    assert(matrix.total_transitions == 0);
    assert(matrix.row_sums[0] == 0);
    assert(matrix.col_sums[0] == 0);
    assert(matrix.counts[0][0] == 0);
}

// **PCTU-02** — transition matrix population.
test pctu_02_matrix_population {
    var matrix = initialize_transition_matrix();
    add_transition(&matrix, 0, 1);
    add_transition(&matrix, 1, 2);
    add_transition(&matrix, 2, 3);
    
    assert(matrix.total_transitions == 3);
    assert(matrix.row_sums[0] == 1);
    assert(matrix.row_sums[1] == 1);
    assert(matrix.row_sums[2] == 1);
    assert(matrix.col_sums[1] == 1);
    assert(matrix.col_sums[2] == 1);
    assert(matrix.col_sums[3] == 1);
    assert(matrix.counts[0][1] == 1);
    assert(matrix.counts[1][2] == 1);
    assert(matrix.counts[2][3] == 1);
}

// **PCTU-03** — uniformity score calculation.
test pctu_03_uniformity_score {
    var matrix = initialize_transition_matrix();
    
    // Perfectly uniform distribution
    add_transition(&matrix, 0, 0);
    add_transition(&matrix, 1, 1);
    add_transition(&matrix, 2, 2);
    add_transition(&matrix, 3, 3);
    add_transition(&matrix, 4, 4);
    add_transition(&matrix, 5, 5);
    add_transition(&matrix, 6, 6);
    add_transition(&matrix, 7, 7);
    
    const score1 = calculate_uniformity_score(&matrix);
    assert(score1 >= 0.8); // Should be high
    
    // Highly non-uniform distribution
    var matrix2 = initialize_transition_matrix();
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    add_transition(&matrix2, 0, 0);
    
    const score2 = calculate_uniformity_score(&matrix2);
    assert(score2 < 0.3); // Should be low
}

// **PCTU-04** — statistical bias detection.
test pctu_04_statistical_bias {
    var matrix = initialize_transition_matrix();
    
    // Uniform distribution (no bias)
    var i: usize = 0;
    while (i < PCTU_GRID_SIZE) {
        add_transition(&matrix, i, i);
        i += 1;
    }
    assert(check_statistical_bias(&matrix) == false);
    
    // Biased distribution
    var matrix2 = initialize_transition_matrix();
    var j: usize = 0;
    while (j < 20) {
        add_transition(&matrix2, 0, 0); // All transitions from/to class 0
        j += 1;
    }
    assert(check_statistical_bias(&matrix2) == true);
}

// **PCTU-05** — grid imbalance detection.
test pctu_05_grid_imbalance {
    var matrix = initialize_transition_matrix();
    
    // Balanced grid
    var i: usize = 0;
    while (i < PCTU_GRID_SIZE) {
        var j: usize = 0;
        while (j < PCTU_GRID_SIZE) {
            if (i + j < 10) { // Fill some cells
                add_transition(&matrix, i, j);
            }
            j += 1;
        }
        i += 1;
    }
    assert(check_grid_imbalance(&matrix) == false);
    
    // Imbalanced grid
    var matrix2 = initialize_transition_matrix();
    var k: usize = 0;
    while (k < 30) {
        add_transition(&matrix2, 0, 0); // All in one cell
        k += 1;
    }
    assert(check_grid_imbalance(&matrix2) == true);
}

// **PCTU-06** — transition uniformity validation.
test pctu_06_transition_uniformity {
    var uniform_transitions: [60]LengthClassTransition = undefined;
    var i: usize = 0;
    while (i < 60) {
        uniform_transitions[i] = .{
            .from_class = @intCast(i % 8),
            .to_class = @intCast((i + 1) % 8),
            .timestamp = 1000 + i,
            .message_length = 100 + i * 10,
            .context = [],
        };
        i += 1;
    }
    
    assert(validate_transition_uniformity(uniform_transitions) == .Ok);
}

// **PCTU-07** — insufficient transitions.
test pctu_07_insufficient_transitions {
    var insufficient_transitions: [5]LengthClassTransition = [
        .{ .from_class = 0, .to_class = 1, .timestamp = 1000, .message_length = 100, .context = [] },
        .{ .from_class = 1, .to_class = 2, .timestamp = 1100, .message_length = 200, .context = [] },
        .{ .from_class = 2, .to_class = 3, .timestamp = 1200, .message_length = 300, .context = [] },
        .{ .from_class = 3, .to_class = 4, .timestamp = 1300, .message_length = 400, .context = [] },
        .{ .from_class = 4, .to_class = 5, .timestamp = 1400, .message_length = 500, .context = [] },
    ];
    
    assert(validate_transition_uniformity(insufficient_transitions) == .InsufficientTransitions);
}

// **PCTU-08** — validation is deterministic.
test pctu_08_deterministic {
    var test_transitions: [20]LengthClassTransition = undefined;
    var i: usize = 0;
    while (i < 20) {
        test_transitions[i] = .{
            .from_class = @intCast(i % 4),
            .to_class = @intCast((i + 1) % 4),
            .timestamp = 1000 + i,
            .message_length = 100 + i * 10,
            .context = [],
        };
        i += 1;
    }
    
    const result1 = validate_transition_uniformity(test_transitions);
    const result2 = validate_transition_uniformity(test_transitions);
    assert(result1 == result2);
    assert(result1 == .Ok);
}