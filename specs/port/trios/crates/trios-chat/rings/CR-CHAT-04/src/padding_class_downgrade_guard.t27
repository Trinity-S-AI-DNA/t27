module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_class_downgrade_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_class_downgrade_guard.rs
// (CR-CHAT-04 - Padding class downgrade guard, Wave-53 Lane B,
// requirement R-CHAT-9).
//
// Within a session the padding class may only grow: a shrink
// from 4096 to 256 tells an observer the plaintext became
// shorter and leaks its content. The rules, in the original's
// order: the batch ceiling, the empty log (accepted), then per
// entry the canonical-class probe and the non-decreasing check
// over the class ladder, and after the whole log the
// first-is-smallest and final-is-largest checks.
//
// The original returns Result<(), PadDowngradeError>. No
// variant carries a payload, so the verdict is the code alone
// (owner decision D5): Ok first, then the six variants in the
// original's declaration order - ClassDowngraded,
// NonCanonicalClass, DuplicateEntry, TooManyTransitions,
// FirstNotSmallest, FinalNotLargest.
//
// The original's DuplicateEntry is declared but never answered:
// its BTreeSet inserts (index, class) pairs and the index is
// unique per entry, so the insert never collides - repeated
// classes pass (PCDG-08 exercises exactly that). The variant
// stays in the enum, declared and unreachable exactly as in the
// original, and the dead insert drops out of the port. The
// original's Option<usize> class index becomes the sentinel
// four: the canonical check runs before any index use.

// Canonical padding classes.
pub const PCDG_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384,};

// Maximum transitions in a log.
pub const PCDG_MAX_TRANSITIONS: usize = 1024;

// The sentinel class index for a non-canonical class.
pub const PCDG_NON_CANONICAL: usize = 4;

// Verdict codes: Ok(()) and PadDowngradeError's variants, in declaration order.
pub enum PadDowngradeCode {
    Ok,
    ClassDowngraded,
    NonCanonicalClass,
    DuplicateEntry,
    TooManyTransitions,
    FirstNotSmallest,
    FinalNotLargest,
}

// The verdict of the downgrade validation. No variant of the
// original's error carries a payload, so the code is the whole
// verdict.
pub struct PadDowngradeVerdict {
    code: PadDowngradeCode,
}

// The ladder position of a class - the original's Option<usize>
// class_index, four marking a class the ladder does not hold.
pub fn class_index(cls: usize) -> usize {
    if (cls == 256) {
        return 0;
    }
    if (cls == 1024) {
        return 1;
    }
    if (cls == 4096) {
        return 2;
    }
    if (cls == 16384) {
        return 3;
    }
    return PCDG_NON_CANONICAL;
}

// [VERIFIED] Validate a sequence of padding class transitions.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the empty log, then per
// entry the canonical class and the non-decreasing ladder walk,
// then the first-is-smallest and final-is-largest checks.
pub fn validate_padding_downgrade(transitions: []const usize) -> PadDowngradeVerdict {
    if (transitions.len > PCDG_MAX_TRANSITIONS) {
        return PadDowngradeVerdict { code: PadDowngradeCode.TooManyTransitions, };
    }
    if (transitions.len == 0) {
        return PadDowngradeVerdict { code: PadDowngradeCode.Ok, };
    }
    var idx: usize = 0;
    var prev_idx: usize = 0;
    var first_idx: usize = 0;
    for i in 0..transitions.len {
        idx = class_index(transitions[i]);
        if (idx == PCDG_NON_CANONICAL) {
            return PadDowngradeVerdict { code: PadDowngradeCode.NonCanonicalClass, };
        }
        if (i == 0) {
            first_idx = idx;
        } else {
            if (idx < prev_idx) {
                return PadDowngradeVerdict { code: PadDowngradeCode.ClassDowngraded, };
            }
        }
        prev_idx = idx;
    }
    if (first_idx != 0) {
        return PadDowngradeVerdict { code: PadDowngradeCode.FirstNotSmallest, };
    }
    if (idx != 3) {
        return PadDowngradeVerdict { code: PadDowngradeCode.FinalNotLargest, };
    }
    return PadDowngradeVerdict { code: PadDowngradeCode.Ok, };
}

// **PCDG-01** - a downgrade rejected: 256 after 1024.
test pcdg_01_downgrade_rejected {
    const transitions: [3]usize = [3]usize{256, 1024, 256,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.ClassDowngraded);
}

// **PCDG-02** - a non-canonical class rejected: 512 is on no
// ladder rung.
test pcdg_02_non_canonical_rejected {
    const transitions: [1]usize = [1]usize{512,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.NonCanonicalClass);
}

// **PCDG-03** - too many rejected: 1025 transitions of a maximum
// 1024, built in a loop like the original's. The batch rule
// fires before any entry is examined.
test pcdg_03_too_many_rejected {
    var transitions: [1025]usize;
    for i in 0..1025 {
        transitions[i] = 256;
    }
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.TooManyTransitions);
}

// **PCDG-04** - first not smallest rejected: the log opens on
// 1024.
test pcdg_04_first_not_smallest_rejected {
    const transitions: [3]usize = [3]usize{1024, 4096, 16384,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.FirstNotSmallest);
}

// **PCDG-05** - final not largest rejected: the log ends on
// 1024.
test pcdg_05_final_not_largest_rejected {
    const transitions: [2]usize = [2]usize{256, 1024,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.FinalNotLargest);
}

// **PCDG-06** - the full progression accepted: every rung once,
// ascending.
test pcdg_06_full_progression_accepted {
    const transitions: [4]usize = [4]usize{256, 1024, 4096, 16384,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.Ok);
}

// **PCDG-07** - an empty log accepted.
test pcdg_07_empty_accepted {
    const transitions: [0]usize = [0]usize{};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.Ok);
}

// **PCDG-08** - repeated classes accepted: the original's dedup
// keys on the entry index, so a repeated class never collides -
// the unreachable-duplicate property this port keeps.
test pcdg_08_same_class_accepted {
    const transitions: [4]usize = [4]usize{256, 256, 256, 16384,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.Ok);
}

// **PCDG-09** - a skipped rung accepted: 256 straight to 16384.
test pcdg_09_skip_class_accepted {
    const transitions: [2]usize = [2]usize{256, 16384,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.Ok);
}

// **PCDG-10** - the canonical ladder itself accepted.
test pcdg_10_minimal_accepted {
    const transitions: [4]usize = [4]usize{256, 1024, 4096, 16384,};
    const v = validate_padding_downgrade(&transitions);
    assert(v.code == PadDowngradeCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test class_index_answers {
    assert(class_index(256) == 0);
    assert(class_index(1024) == 1);
    assert(class_index(4096) == 2);
    assert(class_index(16384) == 3);
    assert(class_index(512) == 4);
    assert(class_index(0) == 4);
    assert(class_index(16385) == 4);
}

// Rule order is the original's: the batch ceiling before any
// entry, the canonical probe before the ladder walk, the ladder
// walk before the post-loop checks, and the first check before
// the final check.
test rule_order_matches_original {
    var flooded: [1025]usize;
    for i in 0..1025 {
        flooded[i] = 512;
    }
    const v1 = validate_padding_downgrade(&flooded);
    assert(v1.code == PadDowngradeCode.TooManyTransitions);

    const non_canonical: [2]usize = [2]usize{512, 256,};
    const v2 = validate_padding_downgrade(&non_canonical);
    assert(v2.code == PadDowngradeCode.NonCanonicalClass);

    const downgraded_first_bad: [3]usize = [3]usize{1024, 4096, 256,};
    const v3 = validate_padding_downgrade(&downgraded_first_bad);
    assert(v3.code == PadDowngradeCode.ClassDowngraded);

    const both_post_bad: [2]usize = [2]usize{1024, 1024,};
    const v4 = validate_padding_downgrade(&both_post_bad);
    assert(v4.code == PadDowngradeCode.FirstNotSmallest);
}
