module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_class_transition_monotonicity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_class_transition_monotonicity_guard.rs
// (CR-CHAT-04 - Padding class transition monotonicity guard, Wave-96
// Lane A, requirement R-CHAT-9).
//
// Rapid oscillation between padding classes reveals the user's
// behaviour, so the transition sequence is audited: every class valid,
// the batch within PCTM_MAX_TRANSITIONS, each same-class streak at
// least PCTM_MIN_STREAK messages before a switch, and at most
// PCTM_MAX_OSCILLATIONS direction reversals across the sequence.
//
// The original returns Result<(), OscillationError>. This port carries
// the verdict as a named struct (owner decision D5): Ok first, then
// the four error variants in the original's declaration order -
// TooManyOscillations, StreakTooShort, TooManyTransitions,
// InvalidClass - with every payload field: count and max for
// TooManyOscillations, class, streak and min for StreakTooShort, the
// invalid size for InvalidClass.
//
// The original's Option<i8> direction state becomes a has_dir flag
// plus the value; its Option<usize> rank answer becomes the sentinel
// 255 for an invalid class (checked before any rank use, exactly the
// original's contains scan). A seq field is carried for fidelity and
// never read by the decision.

// Maximum oscillations allowed.
pub const PCTM_MAX_OSCILLATIONS: usize = 4;

// Minimum consecutive same-class messages before switching.
pub const PCTM_MIN_STREAK: usize = 2;

// Maximum transitions to track.
pub const PCTM_MAX_TRANSITIONS: usize = 1024;

// Valid padding classes.
pub const PCTM_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384};

// The rank of a class that is not one of the four.
pub const PCTM_INVALID_RANK: usize = 255;

// A padding class selection record.
pub struct ClassTransition {
    seq: u64,
    class: usize,
}

// Verdict codes: Ok(()) and OscillationError's variants, in declaration order.
pub enum OscillationCode {
    Ok,
    TooManyOscillations,
    StreakTooShort,
    TooManyTransitions,
    InvalidClass,
}

// The verdict of the monotonicity validation, with every error payload field.
pub struct OscillationVerdict {
    code: OscillationCode,
    class: usize,
    got: usize,
    bound: usize,
}

// The ladder rank of a class: 0..3 for the four canonical classes,
// PCTM_INVALID_RANK for anything else - the original's
// PCTA/CLASS position probe.
pub fn class_rank(class: usize) -> usize {
    for i in 0..4 {
        if (PCTM_CLASSES[i] == class) {
            return i;
        }
    }
    return PCTM_INVALID_RANK;
}

// Whether the class is one of the four canonical classes - the
// original's PCTM_CLASSES.contains, answered by the rank.
pub fn class_valid(class: usize) -> bool {
    return class_rank(class) != PCTM_INVALID_RANK;
}

// [VERIFIED] Validate padding class transition monotonicity. Returns
// Ok only when every rule holds, checked in the original's order: the
// batch ceiling, the per-record class validity, the short-sequence
// pass-through, then per adjacent pair the streak floor at every class
// switch and the direction-reversal count, and finally the
// oscillation ceiling.
pub fn validate_class_transitions(transitions: []const ClassTransition) -> OscillationVerdict {
    if (transitions.len > PCTM_MAX_TRANSITIONS) {
        return OscillationVerdict { code: OscillationCode.TooManyTransitions, class: 0, got: 0, bound: 0, };
    }
    for i in 0..transitions.len {
        if (!class_valid(transitions[i].class)) {
            return OscillationVerdict { code: OscillationCode.InvalidClass, class: transitions[i].class, got: 0, bound: 0, };
        }
    }
    if (transitions.len < 2) {
        return OscillationVerdict { code: OscillationCode.Ok, class: 0, got: 0, bound: 0, };
    }
    var oscillations: usize = 0;
    var has_prev_dir: bool = false;
    var prev_dir: i8 = 0;
    var streak: usize = 1;
    for i in 1..transitions.len {
        const prev_rank: usize = class_rank(transitions[i - 1].class);
        const curr_rank: usize = class_rank(transitions[i].class);
        if (prev_rank == curr_rank) {
            streak = streak + 1;
        } else {
            if (streak < PCTM_MIN_STREAK) {
                return OscillationVerdict { code: OscillationCode.StreakTooShort, class: transitions[i - 1].class, got: streak, bound: PCTM_MIN_STREAK, };
            }
            var dir: i8 = 0;
            if (curr_rank > prev_rank) {
                dir = 1;
            } else {
                dir = -1;
            }
            if (has_prev_dir) {
                if (prev_dir != dir) {
                    oscillations = oscillations + 1;
                }
            }
            has_prev_dir = true;
            prev_dir = dir;
            streak = 1;
        }
    }
    if (oscillations > PCTM_MAX_OSCILLATIONS) {
        return OscillationVerdict { code: OscillationCode.TooManyOscillations, class: 0, got: oscillations, bound: PCTM_MAX_OSCILLATIONS, };
    }
    return OscillationVerdict { code: OscillationCode.Ok, class: 0, got: 0, bound: 0, };
}

// **PCTM-01** - too many oscillations rejected: four reversals of a
// ceiling of four - 256, 4096 alternating twice each, five direction
// changes in total.
test pctm_01_too_many_oscillations_rejected {
    const ts: [14]ClassTransition = [14]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 256, },
        ClassTransition { seq: 3, class: 4096, },
        ClassTransition { seq: 4, class: 4096, },
        ClassTransition { seq: 5, class: 256, },
        ClassTransition { seq: 6, class: 256, },
        ClassTransition { seq: 7, class: 4096, },
        ClassTransition { seq: 8, class: 4096, },
        ClassTransition { seq: 9, class: 256, },
        ClassTransition { seq: 10, class: 256, },
        ClassTransition { seq: 11, class: 4096, },
        ClassTransition { seq: 12, class: 4096, },
        ClassTransition { seq: 13, class: 256, },
        ClassTransition { seq: 14, class: 256, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.TooManyOscillations);
    assert(v.got == 5);
    assert(v.bound == 4);
}

// **PCTM-02** - streak too short rejected: one message of 256 before
// the switch to 1024, of a required two.
test pctm_02_streak_too_short_rejected {
    const ts: [3]ClassTransition = [3]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 1024, },
        ClassTransition { seq: 3, class: 1024, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.StreakTooShort);
    assert(v.class == 256);
    assert(v.got == 1);
    assert(v.bound == 2);
}

// **PCTM-03** - too many transitions rejected: PCTM_MAX_TRANSITIONS
// + 1 records, built in a loop like the original's; the batch rule
// fires before any class is examined.
test pctm_03_too_many_rejected {
    var ts: [1025]ClassTransition;
    for i in 0..1025 {
        ts[i] = ClassTransition { seq: @as(u64, i), class: 256, };
    }
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.TooManyTransitions);
}

// **PCTM-04** - invalid class rejected: 999 is not one of the four.
test pctm_04_invalid_class_rejected {
    const ts: [2]ClassTransition = [2]ClassTransition{
        ClassTransition { seq: 1, class: 999, },
        ClassTransition { seq: 2, class: 999, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.InvalidClass);
    assert(v.class == 999);
}

// **PCTM-05** - valid monotonic transitions accepted: two messages of
// each of the first three classes, ascending.
test pctm_05_valid_accepted {
    const ts: [6]ClassTransition = [6]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 256, },
        ClassTransition { seq: 3, class: 1024, },
        ClassTransition { seq: 4, class: 1024, },
        ClassTransition { seq: 5, class: 4096, },
        ClassTransition { seq: 6, class: 4096, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// **PCTM-06** - a single entry accepted: no transitions to measure.
test pctm_06_single_accepted {
    const ts: [1]ClassTransition = [1]ClassTransition{ ClassTransition { seq: 1, class: 256, },};
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// **PCTM-07** - an empty sequence accepted.
test pctm_07_empty_accepted {
    const ts: [0]ClassTransition = [0]ClassTransition{};
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// **PCTM-08** - twenty of one class accepted: no switches, no
// oscillations.
test pctm_08_same_class_accepted {
    var ts: [20]ClassTransition;
    for i in 0..20 {
        ts[i] = ClassTransition { seq: @as(u64, i), class: 1024, };
    }
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// **PCTM-09** - two transitions accepted: one direction reversal of a
// ceiling of four (256, 1024, back to 256, each streak two).
test pctm_09_two_transitions_accepted {
    const ts: [6]ClassTransition = [6]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 256, },
        ClassTransition { seq: 3, class: 1024, },
        ClassTransition { seq: 4, class: 1024, },
        ClassTransition { seq: 5, class: 256, },
        ClassTransition { seq: 6, class: 256, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// **PCTM-10** - a monotonic climb accepted: two of each class, all four
// ascending - three same-direction switches, no reversals.
test pctm_10_monotonic_accepted {
    const ts: [8]ClassTransition = [8]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 256, },
        ClassTransition { seq: 3, class: 1024, },
        ClassTransition { seq: 4, class: 1024, },
        ClassTransition { seq: 5, class: 4096, },
        ClassTransition { seq: 6, class: 4096, },
        ClassTransition { seq: 7, class: 16384, },
        ClassTransition { seq: 8, class: 16384, },
    };
    const v = validate_class_transitions(&ts);
    assert(v.code == OscillationCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test class_rank_answers {
    assert(class_rank(256) == 0);
    assert(class_rank(1024) == 1);
    assert(class_rank(4096) == 2);
    assert(class_rank(16384) == 3);
    assert(class_rank(999) == PCTM_INVALID_RANK);
    assert(class_rank(0) == PCTM_INVALID_RANK);
}

test class_valid_answers {
    assert(class_valid(256));
    assert(class_valid(16384));
    assert(!class_valid(999));
    assert(!class_valid(0));
}

// Rule order is the original's: the batch ceiling before the class
// validity, the validity before the short-sequence pass-through, the
// streak floor at a switch before the direction bookkeeping, and the
// oscillation ceiling last of all. A sequence under two entries
// answers Ok before any pair scan runs.
test rule_order_matches_original {
    var over: [1025]ClassTransition;
    for i in 0..1025 {
        over[i] = ClassTransition { seq: @as(u64, i), class: 999, };
    }
    const v1 = validate_class_transitions(&over);
    assert(v1.code == OscillationCode.TooManyTransitions);

    const invalid: [3]ClassTransition = [3]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 999, },
        ClassTransition { seq: 3, class: 999, },
    };
    const v2 = validate_class_transitions(&invalid);
    assert(v2.code == OscillationCode.InvalidClass);

    const short_streak: [4]ClassTransition = [4]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 1024, },
        ClassTransition { seq: 3, class: 256, },
        ClassTransition { seq: 4, class: 256, },
    };
    const v3 = validate_class_transitions(&short_streak);
    assert(v3.code == OscillationCode.StreakTooShort);
    assert(v3.class == 256);
}

// The oscillation ceiling boundary: four reversals accept, five reject
// - the fixture of PCTM-01 answers five, and the same shape with one
// reversal fewer sits at the ceiling.
test oscillation_ceiling_boundary {
    const at_edge: [12]ClassTransition = [12]ClassTransition{
        ClassTransition { seq: 1, class: 256, },
        ClassTransition { seq: 2, class: 256, },
        ClassTransition { seq: 3, class: 4096, },
        ClassTransition { seq: 4, class: 4096, },
        ClassTransition { seq: 5, class: 256, },
        ClassTransition { seq: 6, class: 256, },
        ClassTransition { seq: 7, class: 4096, },
        ClassTransition { seq: 8, class: 4096, },
        ClassTransition { seq: 9, class: 256, },
        ClassTransition { seq: 10, class: 256, },
        ClassTransition { seq: 11, class: 4096, },
        ClassTransition { seq: 12, class: 4096, },
    };
    const v = validate_class_transitions(&at_edge);
    assert(v.code == OscillationCode.Ok);
}
