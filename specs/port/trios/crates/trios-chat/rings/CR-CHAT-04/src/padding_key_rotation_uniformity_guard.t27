module port::padding_key_rotation_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_key_rotation_uniformity_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// KEY ROTATION UNIFORMITY — padding key rotation is uniform (P-CHAT-4.19).
// Key rotation for padding operations must follow a uniform distribution
// to prevent predictability and ensure that keys are rotated consistently
// according to the intended schedule. This guard validates key rotation
// uniformity.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * KEY-ROTATION-UNIFORMITY

/// Maximum allowed deviation from uniform distribution.
const PKRU_MAX_DEVIATION: f64 = 0.15; // 15% maximum deviation

/// Minimum number of observations for statistical significance.
const PKRU_MIN_OBSERVATIONS: usize = 100;

/// All ways key rotation uniformity validation can fail.
pub enum UniformityError {
    Ok,
    NonUniformDistribution,
    InsufficientObservations,
    PredictablePattern,
    RotationFrequencyViolation,
};

/// Represents a key rotation event.
pub struct KeyRotationEvent {
    key_id: u64,
    rotation_counter: u64,
    timestamp: u64,
    rotation_interval: u64,
    context: []const u8,
};

/// Statistical analysis of rotation patterns.
pub struct RotationStatistics {
    average_interval: f64,
    variance: f64,
    min_interval: u64,
    max_interval: u64,
    standard_deviation: f64,
    coefficient_of_variation: f64,
};

// [VERIFIED] Calculate rotation statistics from rotation events.
pub fn calculate_rotation_statistics(
    rotations: []const KeyRotationEvent
) -> RotationStatistics {
    if (rotations.len == 0) {
        return .{
            .average_interval = 0.0,
            .variance = 0.0,
            .min_interval = 0,
            .max_interval = 0,
            .standard_deviation = 0.0,
            .coefficient_of_variation = 0.0,
        };
    }
    
    var sum: f64 = 0.0;
    var min_interval: u64 = std.math.maxInt(u64);
    var max_interval: u64 = 0;
    
    var i: usize = 0;
    while (i < rotations.len) {
        const interval = rotations[i].rotation_interval;
        sum += @floatFromInt(interval);
        
        if (interval < min_interval) {
            min_interval = interval;
        }
        if (interval > max_interval) {
            max_interval = interval;
        }
        
        i += 1;
    }
    
    const average_interval = sum / @floatFromInt(rotations.len);
    
    // Calculate variance
    var variance_sum: f64 = 0.0;
    var j: usize = 0;
    while (j < rotations.len) {
        const deviation = @floatFromInt(rotations[j].rotation_interval) - average_interval;
        variance_sum += deviation * deviation;
        j += 1;
    }
    
    const variance = variance_sum / @floatFromInt(rotations.len);
    const standard_deviation = std.math.sqrt(variance);
    const coefficient_of_variation = if (average_interval > 0) {
        standard_deviation / average_interval
    } else {
        0.0
    };
    
    return .{
        .average_interval = average_interval,
        .variance = variance,
        .min_interval = min_interval,
        .max_interval = max_interval,
        .standard_deviation = standard_deviation,
        .coefficient_of_variation = coefficient_of_variation,
    };
}

// [VERIFIED] Check for uniform distribution of rotation intervals.
pub fn check_uniform_distribution(
    stats: RotationStatistics
) -> bool {
    if (stats.min_interval == 0 or stats.max_interval == 0) {
        return false;
    }
    
    // Calculate expected range (min to max should be within reasonable bounds)
    const range = @floatFromInt(stats.max_interval - stats.min_interval);
    const average_range = stats.average_interval * 2.0; // Allow ±100% variation
    
    if (range > average_range * 2.0) { // More than 200% variation
        return false;
    }
    
    // Check coefficient of variation (should be low for uniform distribution)
    if (stats.coefficient_of_variation > PKRU_MAX_DEVIATION) {
        return false;
    }
    
    return true;
}

// [VERIFIED] Check for predictable patterns in rotation.
pub fn detect_predictable_patterns(
    rotations: []const KeyRotationEvent
) -> bool {
    if (rotations.len < 10) {
        return false; // Not enough data to detect patterns
    }
    
    // Check for arithmetic progression
    var arithmetic_count: usize = 0;
    var i: usize = 2;
    while (i < rotations.len) {
        const diff1 = rotations[i].rotation_interval - rotations[i-1].rotation_interval;
        const diff2 = rotations[i-1].rotation_interval - rotations[i-2].rotation_interval;
        
        if (diff1 == diff2) {
            arithmetic_count += 1;
        }
        i += 1;
    }
    
    // If more than 50% of intervals follow arithmetic progression, flag as predictable
    if (arithmetic_count > rotations.len / 2) {
        return true;
    }
    
    // Check for geometric progression (simplified check)
    var geometric_count: usize = 0;
    var j: usize = 2;
    while (j < rotations.len) {
        const ratio1 = @floatFromInt(rotations[j].rotation_interval) / @floatFromInt(rotations[j-1].rotation_interval);
        const ratio2 = @floatFromInt(rotations[j-1].rotation_interval) / @floatFromInt(rotations[j-2].rotation_interval);
        
        if (@abs(ratio1 - ratio2) < 0.1) { // Within 10% of each other
            geometric_count += 1;
        }
        j += 1;
    }
    
    if (geometric_count > rotations.len / 3) {
        return true;
    }
    
    return false;
}

// [VERIFIED] Validate key rotation uniformity.
// Returns .Ok when rotations are uniform; error variant otherwise.
pub fn validate_key_rotation_uniformity(
    rotations: []const KeyRotationEvent
) -> UniformityError {
    if (rotations.len < PKRU_MIN_OBSERVATIONS) {
        return .InsufficientObservations;
    }
    
    const stats = calculate_rotation_statistics(rotations);
    
    // Check for uniform distribution
    if (!check_uniform_distribution(stats)) {
        return .NonUniformDistribution;
    }
    
    // Check for predictable patterns
    if (detect_predictable_patterns(rotations)) {
        return .PredictablePattern;
    }
    
    // Check rotation frequency (should be consistent with expected intervals)
    var frequency_violations: usize = 0;
    var k: usize = 0;
    while (k < rotations.len) {
        const expected_interval = @intFromFloat(stats.average_interval);
        const deviation = @abs(@intFromFloat(rotations[k].rotation_interval) - expected_interval);
        const max_deviation = @intFromFloat(expected_interval * PKRU_MAX_DEVIATION);
        
        if (deviation > max_deviation) {
            frequency_violations += 1;
        }
        k += 1;
    }
    
    if (frequency_violations > rotations.len / 10) { // More than 10% violations
        return .RotationFrequencyViolation;
    }
    
    return .Ok;
}

// **PKRU-01** — statistics calculation accuracy.
test pkru_01_statistics_calculation {
    const rotations: [5]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1200, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1400, .rotation_interval = 100, .context = [] },
    ];
    
    const stats = calculate_rotation_statistics(rotations);
    assert(stats.average_interval == 100.0);
    assert(stats.min_interval == 100);
    assert(stats.max_interval == 100);
    assert(stats.variance == 0.0);
    assert(stats.standard_deviation == 0.0);
    assert(stats.coefficient_of_variation == 0.0);
}

// **PKRU-02** — uniform distribution check.
test pkru_02_uniform_distribution {
    const uniform_rotations: [10]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 95, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1195, .rotation_interval = 105, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 98, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1398, .rotation_interval = 102, .context = [] },
        .{ .key_id = 1, .rotation_counter = 6, .timestamp = 1500, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 7, .timestamp = 1600, .rotation_interval = 96, .context = [] },
        .{ .key_id = 1, .rotation_counter = 8, .timestamp = 1696, .rotation_interval = 104, .context = [] },
        .{ .key_id = 1, .rotation_counter = 9, .timestamp = 1800, .rotation_interval = 99, .context = [] },
        .{ .key_id = 1, .rotation_counter = 10, .timestamp = 1899, .rotation_interval = 101, .context = [] },
    ];
    
    const stats = calculate_rotation_statistics(uniform_rotations);
    assert(check_uniform_distribution(stats) == true);
}

// **PKRU-03** — non-uniform distribution detection.
test pkru_03_non_uniform_distribution {
    const non_uniform_rotations: [10]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1200, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1400, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 6, .timestamp = 1600, .rotation_interval = 200, .context = [] },
        .{ .key_id = 1, .rotation_counter = 7, .timestamp = 1800, .rotation_interval = 200, .context = [] },
        .{ .key_id = 1, .rotation_counter = 8, .timestamp = 2000, .rotation_interval = 200, .context = [] },
        .{ .key_id = 1, .rotation_counter = 9, .timestamp = 2200, .rotation_interval = 200, .context = [] },
        .{ .key_id = 1, .rotation_counter = 10, .timestamp = 2400, .rotation_interval = 200, .context = [] },
    ];
    
    const stats = calculate_rotation_statistics(non_uniform_rotations);
    assert(check_uniform_distribution(stats) == false);
}

// **PKRU-04** — pattern detection.
test pkru_04_pattern_detection {
    const pattern_rotations: [10]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1200, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1400, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 6, .timestamp = 1500, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 7, .timestamp = 1600, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 8, .timestamp = 1700, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 9, .timestamp = 1800, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 10, .timestamp = 1900, .rotation_interval = 100, .context = [] },
    ];
    
    assert(detect_predictable_patterns(pattern_rotations) == true);
}

// **PKRU-05** — uniformity validation.
test pkru_05_uniformity_validation {
    const uniform_rotations: [100]KeyRotationEvent = undefined;
    var i: usize = 0;
    while (i < 100) {
        uniform_rotations[i] = .{
            .key_id = 1,
            .rotation_counter = i + 1,
            .timestamp = 1000 + i * 100,
            .rotation_interval = 95 + (i % 10), // Small variations around 100
            .context = [],
        };
        i += 1;
    }
    
    assert(validate_key_rotation_uniformity(uniform_rotations) == .Ok);
}

// **PKRU-06** — insufficient observations.
test pkru_06_insufficient_observations {
    const insufficient_rotations: [5]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1200, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1400, .rotation_interval = 100, .context = [] },
    ];
    
    assert(validate_key_rotation_uniformity(insufficient_rotations) == .InsufficientObservations);
}

// **PKRU-07** — validation is deterministic.
test pkru_07_deterministic {
    const rotations: [10]KeyRotationEvent = [
        .{ .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 2, .timestamp = 1100, .rotation_interval = 95, .context = [] },
        .{ .key_id = 1, .rotation_counter = 3, .timestamp = 1195, .rotation_interval = 105, .context = [] },
        .{ .key_id = 1, .rotation_counter = 4, .timestamp = 1300, .rotation_interval = 98, .context = [] },
        .{ .key_id = 1, .rotation_counter = 5, .timestamp = 1398, .rotation_interval = 102, .context = [] },
        .{ .key_id = 1, .rotation_counter = 6, .timestamp = 1500, .rotation_interval = 100, .context = [] },
        .{ .key_id = 1, .rotation_counter = 7, .timestamp = 1600, .rotation_interval = 96, .context = [] },
        .{ .key_id = 1, .rotation_counter = 8, .timestamp = 1696, .rotation_interval = 104, .context = [] },
        .{ .key_id = 1, .rotation_counter = 9, .timestamp = 1800, .rotation_interval = 99, .context = [] },
        .{ .key_id = 1, .rotation_counter = 10, .timestamp = 1899, .rotation_interval = 101, .context = [] },
    ];
    
    const result1 = validate_key_rotation_uniformity(rotations);
    const result2 = validate_key_rotation_uniformity(rotations);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PKRU-08** — edge cases.
test pkru_08_edge_cases {
    const empty_rotations: [0]KeyRotationEvent = [];
    assert(validate_key_rotation_uniformity(empty_rotations) == .InsufficientObservations);
    
    const single_rotation: [1]KeyRotationEvent = [.{ 
        .key_id = 1, .rotation_counter = 1, .timestamp = 1000, .rotation_interval = 100, .context = [] 
    }];
    assert(validate_key_rotation_uniformity(single_rotation) == .InsufficientObservations);
}