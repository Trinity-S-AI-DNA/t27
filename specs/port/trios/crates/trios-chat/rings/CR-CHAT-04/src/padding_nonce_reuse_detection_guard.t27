module port::padding_nonce_reuse_detection_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_nonce_reuse_detection_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// NONCE REUSE DETECTION — padding nonces are never reused (P-CHAT-4.22).
// Nonces used in padding operations must never be reused to prevent
 cryptographic attacks. This guard detects nonce reuse and validates
 that each nonce is unique across all padding operations.
//
// The original's ##![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * NONCE-REUSE-DETECTION

/// Maximum allowed nonce reuse attempts.
const PNRD_MAX_REUSE_ATTEMPTS: usize = 0; // No reuse allowed

/// Size of nonce in bytes.
const PNRD_NONCE_SIZE: usize = 12;

/// All ways nonce reuse validation can fail.
pub enum NonceReuseError {
    Ok,
    NonceReuseDetected,
    DuplicateNonce,
    InsufficientEntropy,
    NonceCollision,
};

/// Represents a nonce usage event.
pub struct NonceUsage {
    nonce: [PNRD_NONCE_SIZE]u8,
    timestamp: u64,
    operation_id: u64,
    context: []const u8,
};

/// Nonce usage tracking and validation.
pub struct NonceTracker {
    used_nonces: std.AutoHashMap([PNRD_NONCE_SIZE]u8, u64),
    total_usages: usize,
    collision_count: usize,
    reuse_attempts: usize,
};

// [VERIFIED] Initialize nonce tracker.
pub fn initialize_nonce_tracker() -> NonceTracker {
    return .{
        .used_nonces = std.AutoHashMap([PNRD_NONCE_SIZE]u8, u64).init(std.heap.page_allocator),
        .total_usages = 0,
        .collision_count = 0,
        .reuse_attempts = 0,
    };
}

// [VERIFIED] Check if nonce has been used before.
pub fn check_nonce_reuse(
    tracker: *NonceTracker,
    nonce: [PNRD_NONCE_SIZE]u8,
    timestamp: u64,
    operation_id: u64
) -> bool {
    if (tracker.used_nonces.get(nonce)) |last_usage| {
        tracker.collision_count += 1;
        tracker.reuse_attempts += 1;
        return true; // Nonce reuse detected
    }
    
    // Add to used nonces
    tracker.used_nonces.put(nonce, timestamp) catch return false;
    tracker.total_usages += 1;
    return false; // No reuse
}

// [VERIFIED] Detect nonce collisions in a batch.
pub fn detect_nonce_collisions(
    nonces: []const [PNRD_NONCE_SIZE]u8
) -> bool {
    var seen_nonces: std.AutoHashMap([PNRD_NONCE_SIZE]u8, bool) = std.AutoHashMap([PNRD_NONCE_SIZE]u8, bool).init(std.heap.page_allocator);
    defer seen_nonces.deinit();
    
    var i: usize = 0;
    while (i < nonces.len) {
        if (seen_nonces.contains(nonces[i])) {
            return true; // Collision detected
        }
        seen_nonces.put(nonces[i], true) catch return false;
        i += 1;
    }
    
    return false; // No collisions
}

// [VERIFIED] Validate nonce uniqueness across operations.
// Returns .Ok when all nonces are unique; error variant otherwise.
pub fn validate_nonce_uniqueness(
    nonce_usages: []const NonceUsage
) -> NonceReuseError {
    if (nonce_usages.len == 0) {
        return .Ok;
    }
    
    var tracker = initialize_nonce_tracker();
    defer tracker.used_nonces.deinit();
    
    var i: usize = 0;
    while (i < nonce_usages.len) {
        const nonce = nonce_usages[i].nonce;
        
        if (check_nonce_reuse(&tracker, nonce, nonce_usages[i].timestamp, nonce_usages[i].operation_id)) {
            return .NonceReuseDetected;
        }
        
        i += 1;
    }
    
    // Check for excessive collisions
    if (tracker.collision_count > PNRD_MAX_REUSE_ATTEMPTS) {
        return .NonceCollision;
    }
    
    // Check for insufficient diversity
    if (tracker.total_usages > 0 and tracker.collision_count > tracker.total_usages / 1000) {
        return .InsufficientEntropy;
    }
    
    return .Ok;
}

// **PNRD-01** — nonce tracker initialization.
test pnrd_01_nonce_tracker_initialization {
    const tracker = initialize_nonce_tracker();
    assert(tracker.total_usages == 0);
    assert(tracker.collision_count == 0);
    assert(tracker.reuse_attempts == 0);
}

// **PNRD-02** — nonce reuse detection.
test pnrd_02_nonce_reuse_detection {
    var tracker = initialize_nonce_tracker();
    defer tracker.used_nonces.deinit();
    
    const nonce1: [12]u8 = [1; 12];
    const nonce2: [12]u8 = [2; 12];
    const nonce1_duplicate: [12]u8 = [1; 12];
    
    // First usage should not be detected as reuse
    assert(check_nonce_reuse(&tracker, nonce1, 1000, 1) == false);
    
    // Different nonce should not be detected as reuse
    assert(check_nonce_reuse(&tracker, nonce2, 1100, 2) == false);
    
    // Duplicate nonce should be detected as reuse
    assert(check_nonce_reuse(&tracker, nonce1_duplicate, 1200, 3) == true);
    
    assert(tracker.total_usages == 2);
    assert(tracker.collision_count == 1);
    assert(tracker.reuse_attempts == 1);
}

// **PNRD-03** — nonce collision detection.
test pnrd_03_nonce_collision_detection {
    const nonces: [3][12]u8 = [
        [1; 12],
        [2; 12],
        [1; 12], // Duplicate
    ];
    
    assert(detect_nonce_collisions(nonces) == true);
    
    const unique_nonces: [3][12]u8 = [
        [1; 12],
        [2; 12],
        [3; 12],
    ];
    
    assert(detect_nonce_collisions(unique_nonces) == false);
}

// **PNRD-04** — nonce uniqueness validation.
test pnrd_04_nonce_uniqueness_validation {
    const unique_usages: [5]NonceUsage = [
        .{ .nonce = [1; 12], .timestamp = 1000, .operation_id = 1, .context = [] },
        .{ .nonce = [2; 12], .timestamp = 1100, .operation_id = 2, .context = [] },
        .{ .nonce = [3; 12], .timestamp = 1200, .operation_id = 3, .context = [] },
        .{ .nonce = [4; 12], .timestamp = 1300, .operation_id = 4, .context = [] },
        .{ .nonce = [5; 12], .timestamp = 1400, .operation_id = 5, .context = [] },
    ];
    
    assert(validate_nonce_uniqueness(unique_usages) == .Ok);
}

// **PNRD-05** — nonce reuse detection.
test pnrd_05_nonce_reuse_detection {
    const reused_usages: [3]NonceUsage = [
        .{ .nonce = [1; 12], .timestamp = 1000, .operation_id = 1, .context = [] },
        .{ .nonce = [2; 12], .timestamp = 1100, .operation_id = 2, .context = [] },
        .{ .nonce = [1; 12], .timestamp = 1200, .operation_id = 3, .context = [] }, // Reused nonce
    ];
    
    assert(validate_nonce_uniqueness(reused_usages) == .NonceReuseDetected);
}

// **PNRD-06** — validation is deterministic.
test pnrd_06_deterministic {
    const test_usages: [3]NonceUsage = [
        .{ .nonce = [1; 12], .timestamp = 1000, .operation_id = 1, .context = [] },
        .{ .nonce = [2; 12], .timestamp = 1100, .operation_id = 2, .context = [] },
        .{ .nonce = [3; 12], .timestamp = 1200, .operation_id = 3, .context = [] },
    ];
    
    const result1 = validate_nonce_uniqueness(test_usages);
    const result2 = validate_nonce_uniqueness(test_usages);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PNRD-07** — edge cases.
test pnrd_07_edge_cases {
    const empty_usages: [0]NonceUsage = [];
    assert(validate_nonce_uniqueness(empty_usages) == .Ok);
    
    const single_usage: [1]NonceUsage = [.{ .nonce = [1; 12], .timestamp = 1000, .operation_id = 1, .context = [] }];
    assert(validate_nonce_uniqueness(single_usage) == .Ok);
}

// **PNRD-08** — large scale uniqueness.
test pnrd_08_large_scale {
    var large_usages: [1000]NonceUsage = undefined;
    var i: usize = 0;
    while (i < 1000) {
        var nonce: [12]u8 = undefined;
        var j: usize = 0;
        while (j < 12) {
            nonce[j] = @intCast(i % 256);
            j += 1;
        }
        large_usages[i] = .{
            .nonce = nonce,
            .timestamp = 1000 + i,
            .operation_id = i + 1,
            .context = [],
        };
        i += 1;
    }
    
    assert(validate_nonce_uniqueness(large_usages) == .Ok);
}