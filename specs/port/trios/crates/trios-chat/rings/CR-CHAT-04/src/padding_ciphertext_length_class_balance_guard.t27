module port::padding_ciphertext_length_class_balance_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_ciphertext_length_class_balance_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// LENGTH CLASS BALANCE — ciphertext length classes are properly balanced (P-CHAT-4.7).
// Ciphertext lengths should follow a balanced distribution to prevent
// attackers from inferring message length or content type. This guard
// ensures that padding doesn't create imbalances in length distributions
// that could be exploited for traffic analysis attacks.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * LENGTH-BALANCE

/// Length classes for ciphertext analysis.
pub enum LengthClass {
    Tiny,     // < 64 bytes
    Small,    // 64-255 bytes
    Medium,   // 256-1023 bytes
    Large,    // 1024-4095 bytes
    Huge,     // > 4095 bytes
}

/// Maximum allowed imbalance between length classes.
const PCLB_MAX_IMBALANCE: f64 = 0.3; // 30% tolerance

/// Minimum samples required per length class.
const PCLB_MIN_SAMPLES: usize = 10;

/// All ways length class balance validation can fail.
pub enum LengthBalanceError {
    Ok,
    ImbalancedDistribution,
    InsufficientSamples,
    ExtremeOutlier,
    ClassMissing,
};

// [VERIFIED] Categorize ciphertext length into length class.
pub fn get_length_class(length: usize) -> LengthClass {
    if (length < 64) {
        return .Tiny;
    } else if (length < 256) {
        return .Small;
    } else if (length < 1024) {
        return .Medium;
    } else if (length < 4096) {
        return .Large;
    } else {
        return .Huge;
    }
}

// [VERIFIED] Calculate distribution balance across length classes.
// Returns a score from 0.0 (perfectly balanced) to 1.0 (completely imbalanced).
pub fn calculate_balance_score(
    length_counts: [LengthClass]usize
) -> f64 {
    var total_samples: usize = 0;
    var i: usize = 0;
    while (i < 5) {
        total_samples += length_counts[i];
        i += 1;
    }
    
    if (total_samples == 0) {
        return 1.0; // Completely imbalanced
    }
    
    // Calculate expected samples per class (assuming uniform distribution)
    const expected_per_class = total_samples / 5;
    
    // Calculate imbalance using coefficient of variation
    var variance: f64 = 0.0;
    var j: usize = 0;
    while (j < 5) {
        const deviation = f64(length_counts[j]) - f64(expected_per_class);
        variance += deviation * deviation;
        j += 1;
    }
    
    const std_dev = sqrt(variance / 5.0);
    const mean = f64(total_samples) / 5.0;
    
    // Coefficient of variation (std_dev / mean)
    if (mean == 0.0) {
        return 1.0;
    }
    
    return std_dev / mean;
}

// [VERIFIED] Validate length class balance across ciphertext samples.
// Returns .Ok when distribution is balanced; error variant otherwise.
pub fn validate_length_class_balance(
    ciphertext_lengths: []const usize
) -> LengthBalanceError {
    if (ciphertext_lengths.len < PCLB_MIN_SAMPLES * 5) {
        return .InsufficientSamples;
    }
    
    var length_counts: [LengthClass]usize = [0; 5];
    var i: usize = 0;
    while (i < ciphertext_lengths.len) {
        const length_class = get_length_class(ciphertext_lengths[i]);
        length_counts[length_class] += 1;
        i += 1;
    }
    
    // Check for missing classes
    var j: usize = 0;
    while (j < 5) {
        if (length_counts[j] < PCLB_MIN_SAMPLES) {
            return .ClassMissing;
        }
        j += 1;
    }
    
    // Check for extreme outliers
    var max_count: usize = 0;
    var min_count: usize = ciphertext_lengths.len;
    var k: usize = 0;
    while (k < 5) {
        if (length_counts[k] > max_count) {
            max_count = length_counts[k];
        }
        if (length_counts[k] < min_count) {
            min_count = length_counts[k];
        }
        k += 1;
    }
    
    // Check for extreme imbalance
    if (max_count > min_count * 3) {
        return .ExtremeOutlier;
    }
    
    // Check overall balance score
    const balance_score = calculate_balance_score(length_counts);
    if (balance_score > PCLB_MAX_IMBALANCE) {
        return .ImbalancedDistribution;
    }
    
    return .Ok;
}

// **PCLB-01** — balanced distribution accepted.
test pclb_01_balanced_accepted {
    const balanced_lengths: [50]usize = [
        32, 48, 56, 60, 62,  // Tiny
        128, 192, 224, 240, 252, // Small
        512, 768, 896, 960, 992, // Medium
        2048, 3072, 3584, 3840, 3968, // Large
        8192, 12288, 14336, 15360, 15872, // Huge
        16, 24, 28, 30, 31, // Tiny
        64, 96, 112, 120, 126, // Small
        256, 384, 448, 480, 496, // Medium
        1024, 1536, 1792, 1920, 1984, // Large
        4096, 6144, 7168, 7680, 7936, // Huge
    ];
    assert(validate_length_class_balance(balanced_lengths) == .Ok);
}

// **PCLB-02** — imbalanced distribution rejected.
test pclb_02_imbalanced_rejected {
    const imbalanced_lengths: [50]usize = [
        32, 32, 32, 32, 32, 32, 32, 32, 32, 32, // Too many Tiny
        128, 128, 128, 128, 128, // Too few Small
        512, 512, 512, 512, 512, // Too few Medium
        2048, 2048, 2048, 2048, 2048, // Too few Large
        8192, 8192, 8192, 8192, 8192, // Too few Huge
    ];
    assert(validate_length_class_balance(imbalanced_lengths) == .ImbalancedDistribution);
}

// **PCLB-03** — insufficient samples rejected.
test pclb_03_insufficient_samples {
    const small_sample: [40]usize = [32; 40]; // Only Tiny class
    assert(validate_length_class_balance(small_sample) == .InsufficientSamples);
}

// **PCLB-04** — missing class rejected.
test pclb_04_missing_class {
    const missing_huge: [45]usize = [
        32, 48, 56, 60, 62,  // Tiny
        128, 192, 224, 240, 252, // Small
        512, 768, 896, 960, 992, // Medium
        2048, 3072, 3584, 3840, 3968, // Large
        16, 24, 28, 30, 31, // Tiny
        64, 96, 112, 120, 126, // Small
        256, 384, 448, 480, 496, // Medium
        1024, 1536, 1792, 1920, 1984, // Large
    ];
    assert(validate_length_class_balance(missing_huge) == .ClassMissing);
}

// **PCLB-05** — length classification accuracy.
test pclb_05_classification_accuracy {
    assert(get_length_class(32) == .Tiny);
    assert(get_length_class(128) == .Small);
    assert(get_length_class(512) == .Medium);
    assert(get_length_class(2048) == .Large);
    assert(get_length_class(8192) == .Huge);
}

// **PCLB-06** — validation is deterministic.
test pclb_06_deterministic {
    const test_lengths: [50]usize = [128; 50];
    const result1 = validate_length_class_balance(test_lengths);
    const result2 = validate_length_class_balance(test_lengths);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PCLB-07** — balance score calculation.
test pclb_07_balance_score {
    const perfect_counts: [LengthClass]usize = [10; 5]; // Perfectly balanced
    const score1 = calculate_balance_score(perfect_counts);
    assert(score1 < 0.1); // Should be very close to 0
    
    const imbalanced_counts: [LengthClass]usize = [50, 1, 1, 1, 1]; // Very imbalanced
    const score2 = calculate_balance_score(imbalanced_counts);
    assert(score2 > 0.8); // Should be very high
}

// **PCLB-08** — extreme outlier detection.
test pclb_08_outlier_detection {
    const outlier_lengths: [50]usize = [
        32, 32, 32, 32, 32, 32, 32, 32, 32, 32, // Many Tiny
        128, 128, 128, 128, 128, // Some Small
        512, 512, 512, 512, 512, // Some Medium
        2048, 2048, 2048, 2048, 2048, // Some Large
        8192, 8192, 8192, 8192, 8192, // Some Huge
        32, 32, 32, 32, 32, // More Tiny
    ];
    assert(validate_length_class_balance(outlier_lengths) == .ExtremeOutlier);
}