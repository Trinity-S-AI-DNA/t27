module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::mls_plaintext_framing_integrity;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/mls_plaintext_framing_integrity.rs
// (CR-CHAT-04 - MLS plaintext authenticated-data tampering guard,
// Wave-39 Lane B, RFC 9420 section 6).
//
// Every MLS message carries an authenticated-data context binding the
// ciphertext to the group context. Tampering with its fields enables
// cross-group splice, epoch rollback, content-type forgery, sender
// impersonation and wire-version confusion, so the frame is checked
// against nine rules in the original's fixed order: the wire version,
// a non-empty group id, a non-zero epoch, a known content type, the
// sender leaf within the group bounds, the authenticated data within
// its ceiling, an untruncated ciphertext for encrypted content, and
// the group id and epoch matching the receiver's view.
//
// The original returns Result<(), MlsFramingError>. This port carries
// the verdict as a named struct (owner decision D5): Ok first, then
// the nine error variants in the original's declaration order. No
// variant carries a payload, so the verdict is the code alone.
//
// The original's Vec<u8> fields are read only by length and equality,
// so the records carry lengths and one fixed-size id for the equality
// probe; no AAD or ciphertext byte reaches the spec.

// Wire version byte for MLS 1.0 (RFC 9420 section 3).
pub const MLF_WIRE_VERSION_MLS10: u8 = 1;

// Maximum authenticated data length (u16 max).
pub const MLF_MAX_AAD_LEN: usize = 65535;

// Minimum AEAD ciphertext length (tag only, no plaintext).
pub const MLF_MIN_AEAD_CT_LEN: usize = 16;

// Maximum number of leaves in a group.
pub const MLF_MAX_LEAF_INDEX: u32 = 1073741823;

// Fixed group-id length the port's equality probe uses. The original
// compares Vec<u8> ids of any length; a fixed port covers the decision
// at one length and the tests exercise both equal and unequal ids.
pub const MLF_GROUP_ID_LEN: usize = 32;

// Content type codes for MLS messages.
pub const MLF_CONTENT_APPLICATION: u8 = 1;
pub const MLF_CONTENT_PROPOSAL: u8 = 2;
pub const MLF_CONTENT_COMMIT: u8 = 3;

// MLS message framing envelope for validation.
pub struct MlsFrame {
    wire_version: u8,
    group_id_len: usize,
    group_id: [32]u8,
    epoch: u64,
    content_type: u8,
    sender_leaf: u32,
    authenticated_data_len: usize,
    ciphertext_len: usize,
}

// Receiver's view of the group for validation.
pub struct MlsGroupView {
    group_id: [32]u8,
    epoch: u64,
    leaf_count: u32,
}

// Verdict codes: Ok(()) and MlsFramingError's variants, in declaration order.
pub enum MlsFramingCode {
    Ok,
    InvalidWireVersion,
    EmptyGroupId,
    ZeroEpoch,
    InvalidContentType,
    SenderOutOfBounds,
    AadTooLong,
    TruncatedCiphertext,
    GroupIdMismatch,
    EpochMismatch,
}

// The verdict of the MLS frame validation. No variant of the original's
// error carries a payload, so the code is the whole verdict.
pub struct MlsFramingVerdict {
    code: MlsFramingCode,
}

// The original asks MlsContentType::from_byte(b).is_none(); there is no
// Option here, so the decision is a three-way match on the codes.
pub fn content_type_known(b: u8) -> bool {
    if (b == MLF_CONTENT_APPLICATION) {
        return true;
    }
    if (b == MLF_CONTENT_PROPOSAL) {
        return true;
    }
    if (b == MLF_CONTENT_COMMIT) {
        return true;
    }
    return false;
}

// [VERIFIED] Validate an MLS message frame against the original's nine
// rules. Returns Ok only when every rule holds, checked in the
// original's fixed order: wire version, non-empty group id, non-zero
// epoch, known content type, sender leaf within bounds, authenticated
// data within its ceiling, untruncated ciphertext for Application
// content, group id matching the view, epoch matching the view.
pub fn validate_mls_frame(frame: MlsFrame, view: MlsGroupView) -> MlsFramingVerdict {
    if (frame.wire_version != MLF_WIRE_VERSION_MLS10) {
        return MlsFramingVerdict { code: MlsFramingCode.InvalidWireVersion, };
    }
    if (frame.group_id_len == 0) {
        return MlsFramingVerdict { code: MlsFramingCode.EmptyGroupId, };
    }
    if (frame.epoch == 0) {
        return MlsFramingVerdict { code: MlsFramingCode.ZeroEpoch, };
    }
    if (!content_type_known(frame.content_type)) {
        return MlsFramingVerdict { code: MlsFramingCode.InvalidContentType, };
    }
    if (frame.sender_leaf >= view.leaf_count) {
        return MlsFramingVerdict { code: MlsFramingCode.SenderOutOfBounds, };
    }
    if (frame.authenticated_data_len > MLF_MAX_AAD_LEN) {
        return MlsFramingVerdict { code: MlsFramingCode.AadTooLong, };
    }
    if (frame.content_type == MLF_CONTENT_APPLICATION) {
        if (frame.ciphertext_len < MLF_MIN_AEAD_CT_LEN) {
            return MlsFramingVerdict { code: MlsFramingCode.TruncatedCiphertext, };
        }
    }
    if (!ids32_equal(frame.group_id, view.group_id)) {
        return MlsFramingVerdict { code: MlsFramingCode.GroupIdMismatch, };
    }
    if (frame.epoch != view.epoch) {
        return MlsFramingVerdict { code: MlsFramingCode.EpochMismatch, };
    }
    return MlsFramingVerdict { code: MlsFramingCode.Ok, };
}

// The fixtures' group id, one byte repeated 32 times.
pub const MLF_GOOD_ID: [32]u8 = [32]u8{0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA,};
pub const MLF_OTHER_ID: [32]u8 = [32]u8{0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB, 0xBB,};

// The canonical view fixture of the tests.
fn good_view() -> MlsGroupView {
    return MlsGroupView { group_id: MLF_GOOD_ID, epoch: 7, leaf_count: 10, };
}

// The canonical frame fixture of the tests: Application content, 32
// bytes of AAD, 32 bytes of ciphertext.
fn good_frame() -> MlsFrame {
    return MlsFrame {
        wire_version: MLF_WIRE_VERSION_MLS10,
        group_id_len: 32,
        group_id: MLF_GOOD_ID,
        epoch: 7,
        content_type: MLF_CONTENT_APPLICATION,
        sender_leaf: 3,
        authenticated_data_len: 64,
        ciphertext_len: 32,
    };
}

// **MLF-01** - invalid wire version (0x02) rejected.
test mlf_01_invalid_wire_version_rejected {
    var f = good_frame();
    f.wire_version = 2;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.InvalidWireVersion);
}

// **MLF-02** - empty group id rejected.
test mlf_02_empty_group_id_rejected {
    var f = good_frame();
    f.group_id_len = 0;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.EmptyGroupId);
}

// **MLF-03** - zero epoch rejected: epoch 0 is pre-group.
test mlf_03_zero_epoch_rejected {
    var f = good_frame();
    f.epoch = 0;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.ZeroEpoch);
}

// **MLF-04** - invalid content type (0xFF) rejected.
test mlf_04_invalid_content_type_rejected {
    var f = good_frame();
    f.content_type = 255;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.InvalidContentType);
}

// **MLF-05** - sender leaf out of bounds rejected: 99 against 10 leaves.
test mlf_05_sender_out_of_bounds_rejected {
    var f = good_frame();
    f.sender_leaf = 99;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.SenderOutOfBounds);
}

// **MLF-06** - oversized AAD rejected: 65536 of a maximum 65535.
test mlf_06_oversized_aad_rejected {
    var f = good_frame();
    f.authenticated_data_len = 65536;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.AadTooLong);
}

// **MLF-07** - truncated ciphertext for Application content rejected:
// 8 bytes against the 16-byte AEAD tag minimum.
test mlf_07_truncated_ciphertext_rejected {
    var f = good_frame();
    f.content_type = MLF_CONTENT_APPLICATION;
    f.ciphertext_len = 8;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.TruncatedCiphertext);
}

// **MLF-08** - group id mismatch rejected: the frame names another group.
test mlf_08_group_id_mismatch_rejected {
    var f = good_frame();
    f.group_id = MLF_OTHER_ID;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.GroupIdMismatch);
}

// **MLF-09** - epoch mismatch rejected: the frame claims 99 against 7.
test mlf_09_epoch_mismatch_rejected {
    var f = good_frame();
    f.epoch = 99;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.EpochMismatch);
}

// **MLF-10** - a valid Proposal frame with no ciphertext accepted: the
// AEAD minimum applies only to Application content.
test mlf_10_valid_proposal_frame_accepted {
    var f = good_frame();
    f.content_type = MLF_CONTENT_PROPOSAL;
    f.ciphertext_len = 0;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test content_type_known_answers {
    assert(content_type_known(MLF_CONTENT_APPLICATION));
    assert(content_type_known(MLF_CONTENT_PROPOSAL));
    assert(content_type_known(MLF_CONTENT_COMMIT));
    assert(!content_type_known(0));
    assert(!content_type_known(255));
}

test ids_equal_answers {
    assert(ids32_equal(MLF_GOOD_ID, MLF_GOOD_ID));
    assert(!ids32_equal(MLF_GOOD_ID, MLF_OTHER_ID));
}

// Rule order is the original's: wire version before group id emptiness,
// emptiness before epoch, content type before sender bounds, the AEAD
// minimum only for Application content, and the group binding before
// the epoch binding.
test rule_order_matches_original {
    var f = good_frame();
    f.wire_version = 2;
    f.group_id_len = 0;
    var view = good_view();
    const va = validate_mls_frame(f, view);
    assert(va.code == MlsFramingCode.InvalidWireVersion);

    var g = good_frame();
    g.content_type = MLF_CONTENT_PROPOSAL;
    g.ciphertext_len = 0;
    g.sender_leaf = 99;
    var w = good_view();
    const vb = validate_mls_frame(g, w);
    assert(vb.code == MlsFramingCode.SenderOutOfBounds);

    var h = good_frame();
    h.group_id = MLF_OTHER_ID;
    h.epoch = 99;
    var u = good_view();
    const vc = validate_mls_frame(h, u);
    assert(vc.code == MlsFramingCode.GroupIdMismatch);
}

// The AEAD minimum does not bind Commit content either, and a Commit
// frame with no ciphertext passes exactly as the Proposal one does.
test commit_content_needs_no_ciphertext {
    var f = good_frame();
    f.content_type = MLF_CONTENT_COMMIT;
    f.ciphertext_len = 0;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.Ok);
}

// The largest in-bounds leaf is one below the count, and the AAD at
// exactly its ceiling passes.
test boundary_leaves_and_aad_accepted {
    var f = good_frame();
    f.sender_leaf = 9;
    f.authenticated_data_len = MLF_MAX_AAD_LEN;
    var view = good_view();
    const v = validate_mls_frame(f, view);
    assert(v.code == MlsFramingCode.Ok);
}
