module port::padding_payload_entropy_minimum_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_payload_entropy_minimum_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// PAYLOAD ENTROPY MINIMUM — padding payloads have sufficient entropy (P-CHAT-4.25).
// Padding payloads must contain sufficient entropy to prevent statistical
// attacks and ensure cryptographic strength. This guard validates that
// padding payloads meet minimum entropy requirements.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PAYLOAD-ENTROPY-MINIMUM

/// Minimum entropy threshold (in bits per byte).
const PPEM_MIN_ENTROPY_PER_BYTE: f64 = 7.5; // High entropy requirement

/// Minimum payload size for entropy calculation.
const PPEM_MIN_PAYLOAD_SIZE: usize = 32;

/// Maximum allowed deviation from uniform distribution.
const PPEM_MAX_DEVIATION: f64 = 0.1; // 10% maximum deviation

/// All ways entropy validation can fail.
pub enum EntropyError {
    Ok,
    InsufficientEntropy,
    NonUniformDistribution,
    PredictablePattern,
    LowVariance,
};

/// Represents a byte frequency distribution.
pub struct ByteDistribution {
    frequencies: [256]usize,
    total_bytes: usize,
    entropy: f64,
    uniformity_score: f64,
};

/// Payload entropy analysis results.
pub struct EntropyAnalysis {
    distribution: ByteDistribution,
    total_entropy: f64,
    normalized_entropy: f64,
    shannon_entropy: f64,
    min_entropy: f64,
    uniformity_score: f64,
};

// [VERIFIED] Initialize byte distribution.
pub fn initialize_byte_distribution() -> ByteDistribution {
    var frequencies: [256]usize = [0; 256];
    return .{
        .frequencies = frequencies,
        .total_bytes = 0,
        .entropy = 0.0,
        .uniformity_score = 0.0,
    };
}

// [VERIFIED] Add byte to distribution.
pub fn add_byte_to_distribution(
    distribution: *ByteDistribution,
    byte: u8
) void {
    distribution.frequencies[byte] += 1;
    distribution.total_bytes += 1;
}

// [VERIFIED] Calculate entropy from byte frequencies.
pub fn calculate_entropy(distribution: *const ByteDistribution) -> f64 {
    if (distribution.total_bytes == 0) {
        return 0.0;
    }
    
    var entropy: f64 = 0.0;
    var i: usize = 0;
    while (i < 256) {
        if (distribution.frequencies[i] > 0) {
            const probability = @floatFromInt(distribution.frequencies[i]) / @floatFromInt(distribution.total_bytes);
            entropy -= probability * @log2(probability);
        }
        i += 1;
    }
    
    return entropy;
}

// [VERIFIED] Calculate uniformity score.
pub fn calculate_uniformity_score(distribution: *const ByteDistribution) -> f64 {
    if (distribution.total_bytes == 0) {
        return 0.0;
    }
    
    const expected_frequency = @floatFromInt(distribution.total_bytes) / 256.0;
    var total_variance: f64 = 0.0;
    
    var i: usize = 0;
    while (i < 256) {
        const deviation = @abs(@floatFromInt(distribution.frequencies[i]) - expected_frequency);
        total_variance += deviation * deviation;
        i += 1;
    }
    
    const max_variance = expected_frequency * expected_frequency * 256.0;
    return 1.0 - (total_variance / max_variance);
}

// [VERIFIED] Check for predictable patterns.
pub fn check_predictable_patterns(
    distribution: *const ByteDistribution
) -> bool {
    if (distribution.total_bytes < PPEM_MIN_PAYLOAD_SIZE) {
        return false; // Not enough data to detect patterns
    }
    
    // Check for repeated sequences
    var repeated_sequences: usize = 0;
    var i: usize = 0;
    while (i < 256) {
        if (distribution.frequencies[i] > distribution.total_bytes / 10) {
            repeated_sequences += 1;
        }
        i += 1;
    }
    
    // If more than 5% of bytes appear too frequently, flag as predictable
    if (repeated_sequences > 256 / 20) {
        return true;
    }
    
    // Check for consecutive patterns
    var consecutive_count: usize = 0;
    var j: usize = 0;
    while (j < 255) {
        if (distribution.frequencies[j] > 0 and distribution.frequencies[j + 1] > 0) {
            consecutive_count += 1;
        }
        j += 1;
    }
    
    // If too many consecutive bytes are used, flag as pattern
    if (consecutive_count > 200) {
        return true;
    }
    
    return false;
}

// [VERIFIED] Check for low variance.
pub fn check_low_variance(distribution: *const ByteDistribution) -> bool {
    if (distribution.total_bytes < PPEM_MIN_PAYLOAD_SIZE) {
        return false; // Not enough data to judge
    }
    
    var non_zero_count: usize = 0;
    var i: usize = 0;
    while (i < 256) {
        if (distribution.frequencies[i] > 0) {
            non_zero_count += 1;
        }
        i += 1;
    }
    
    // If less than 50% of possible byte values are used, flag as low variance
    return non_zero_count < 128;
}

// [VERIFIED] Initialize entropy analysis.
pub fn initialize_entropy_analysis() -> EntropyAnalysis {
    return .{
        .distribution = initialize_byte_distribution(),
        .total_entropy = 0.0,
        .normalized_entropy = 0.0,
        .shannon_entropy = 0.0,
        .min_entropy = 0.0,
        .uniformity_score = 0.0,
    };
}

// [VERIFIED] Add payload to entropy analysis.
pub fn add_payload_to_entropy_analysis(
    analysis: *EntropyAnalysis,
    payload: []const u8
) void {
    var i: usize = 0;
    while (i < payload.len) {
        add_byte_to_distribution(&analysis.distribution, payload[i]);
        i += 1;
    }
    
    // Update entropy metrics
    analysis.total_entropy = calculate_entropy(&analysis.distribution);
    analysis.uniformity_score = calculate_uniformity_score(&analysis.distribution);
    
    // Calculate normalized entropy (0-1 scale)
    analysis.normalized_entropy = analysis.total_entropy / 8.0;
    
    // Calculate min entropy (worst-case entropy)
    if (analysis.distribution.total_bytes > 0) {
        var max_probability: f64 = 0.0;
        var j: usize = 0;
        while (j < 256) {
            const probability = @floatFromInt(analysis.distribution.frequencies[j]) / @floatFromInt(analysis.distribution.total_bytes);
            if (probability > max_probability) {
                max_probability = probability;
            }
            j += 1;
        }
        analysis.min_entropy = -@log2(max_probability);
    }
}

// [VERIFIED] Validate payload entropy requirements.
// Returns .Ok when payload meets entropy requirements; error variant otherwise.
pub fn validate_payload_entropy(
    analysis: *const EntropyAnalysis
) -> EntropyError {
    if (analysis.distribution.total_bytes < PPEM_MIN_PAYLOAD_SIZE) {
        return .Ok; // Not enough data to judge
    }
    
    // Check for sufficient entropy
    if (analysis.total_entropy < @floatFromInt(PPEM_MIN_ENTROPY_PER_BYTE * analysis.distribution.total_bytes)) {
        return .InsufficientEntropy;
    }
    
    // Check for uniform distribution
    if (analysis.uniformity_score < (1.0 - PPEM_MAX_DEVIATION)) {
        return .NonUniformDistribution;
    }
    
    // Check for predictable patterns
    if (check_predictable_patterns(&analysis.distribution)) {
        return .PredictablePattern;
    }
    
    // Check for low variance
    if (check_low_variance(&analysis.distribution)) {
        return .LowVariance;
    }
    
    return .Ok;
}

// **PPEM-01** — byte distribution initialization.
test ppem_01_byte_distribution_initialization {
    const distribution = initialize_byte_distribution();
    assert(distribution.total_bytes == 0);
    assert(distribution.entropy == 0.0);
    assert(distribution.uniformity_score == 0.0);
}

// **PPEM-02** — byte addition to distribution.
test ppem_02_byte_addition {
    var distribution = initialize_byte_distribution();
    
    add_byte_to_distribution(&distribution, 0x41);
    add_byte_to_distribution(&distribution, 0x42);
    add_byte_to_distribution(&distribution, 0x41);
    
    assert(distribution.total_bytes == 3);
    assert(distribution.frequencies[0x41] == 2);
    assert(distribution.frequencies[0x42] == 1);
}

// **PPEM-03** — entropy calculation.
test ppem_03_entropy_calculation {
    var distribution = initialize_byte_distribution();
    
    // Add uniform distribution
    var i: usize = 0;
    while (i < 256) {
        add_byte_to_distribution(&distribution, @intCast(i));
        i += 1;
    }
    
    const entropy = calculate_entropy(&distribution);
    assert(entropy > 7.9); // Should be close to 8 bits per byte
}

// **PPEM-04** — uniformity score calculation.
test ppem_04_uniformity_score {
    var distribution = initialize_byte_distribution();
    
    // Add uniform distribution
    var i: usize = 0;
    while (i < 256) {
        add_byte_to_distribution(&distribution, @intCast(i));
        i += 1;
    }
    
    const uniformity = calculate_uniformity_score(&distribution);
    assert(uniformity > 0.9); // Should be high for uniform distribution
}

// **PPEM-05** — predictable pattern detection.
test ppem_05_predictable_patterns {
    var distribution = initialize_byte_distribution();
    
    // Add predictable pattern (repeated bytes)
    var i: usize = 0;
    while (i < 100) {
        add_byte_to_distribution(&distribution, 0x41);
        i += 1;
    }
    
    assert(check_predictable_patterns(&distribution) == true);
}

// **PPEM-06** — low variance detection.
test ppem_06_low_variance {
    var distribution = initialize_byte_distribution();
    
    // Add limited range of bytes
    var i: usize = 0;
    while (i < 100) {
        add_byte_to_distribution(&distribution, @intCast(i % 10));
        i += 1;
    }
    
    assert(check_low_variance(&distribution) == true);
}

// **PPEM-07** — entropy analysis initialization.
test ppem_07_entropy_analysis_initialization {
    const analysis = initialize_entropy_analysis();
    assert(analysis.total_entropy == 0.0);
    assert(analysis.normalized_entropy == 0.0);
    assert(analysis.shannon_entropy == 0.0);
    assert(analysis.min_entropy == 0.0);
    assert(analysis.uniformity_score == 0.0);
}

// **PPEM-08** — payload addition to analysis.
test ppem_08_payload_addition {
    var analysis = initialize_entropy_analysis();
    
    const payload = &[_]u8{ 0x41, 0x42, 0x43, 0x44, 0x45 };
    add_payload_to_entropy_analysis(&analysis, payload);
    
    assert(analysis.distribution.total_bytes == 5);
    assert(analysis.total_entropy > 0.0);
    assert(analysis.uniformity_score > 0.0);
}

// **PPEM-09** — payload entropy validation.
test ppem_09_payload_entropy_validation {
    var analysis = initialize_entropy_analysis();
    
    // Add high-entropy payload
    var i: usize = 0;
    while (i < 100) {
        const payload = &[_]u8{ @intCast(i % 256) };
        add_payload_to_entropy_analysis(&analysis, payload);
        i += 1;
    }
    
    assert(validate_payload_entropy(&analysis) == .Ok);
}

// **PPEM-10** — validation is deterministic.
test ppem_10_deterministic {
    var analysis1 = initialize_entropy_analysis();
    var analysis2 = initialize_entropy_analysis();
    
    const payload = &[_]u8{ 0x41, 0x42, 0x43, 0x44, 0x45 };
    
    add_payload_to_entropy_analysis(&analysis1, payload);
    add_payload_to_entropy_analysis(&analysis2, payload);
    
    const result1 = validate_payload_entropy(&analysis1);
    const result2 = validate_payload_entropy(&analysis2);
    assert(result1 == result2);
    assert(result1 == .Ok);
}