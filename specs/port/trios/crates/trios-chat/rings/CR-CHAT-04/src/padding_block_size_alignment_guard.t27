module port::padding_block_size_alignment_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_block_size_alignment_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// BLOCK SIZE — padding aligns to correct cryptographic block sizes (P-CHAT-4.4).
// Different cryptographic algorithms use different block sizes (AES-128: 16 bytes,
// AES-256: 16 bytes, ChaCha20: 64 bytes, etc.). This guard ensures padding
// matches the expected block size for the cryptographic algorithm being used.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PADDING-BLOCK-SIZE

/// Supported cryptographic algorithms and their block sizes.
pub enum CryptoAlgorithm {
    Aes128,  // AES-128: 16-byte blocks
    Aes256,  // AES-256: 16-byte blocks  
    ChaCha20, // ChaCha20: 64-byte blocks
    Blowfish, // Blowfish: 8-byte blocks
}

/// Block sizes for each cryptographic algorithm in bytes.
const PBSA_BLOCK_SIZES: [CryptoAlgorithm]usize = [
    .Aes128 => 16,
    .Aes256 => 16,
    .ChaCha20 => 64,
    .Blowfish => 8,
];

/// Maximum allowed padding deviation from expected block size.
const PBSA_MAX_DEVIATION: usize = 0; // Must be exact for security

/// All ways block size validation can fail.
pub enum BlockSizeError {
    Ok,
    InvalidAlgorithm,
    IncorrectBlockSize,
    PaddingTooShort,
    PaddingTooLong,
    AlgorithmNotSupported,
};

// [VERIFIED] Validate padding matches cryptographic block size requirements.
// Returns .Ok when padding size is correct for the algorithm; error variant otherwise.
pub fn validate_block_size_alignment(
    algorithm: CryptoAlgorithm,
    padding_length: usize
) -> BlockSizeError {
    const expected_block_size = PBSA_BLOCK_SIZES[algorithm];
    
    // Check if padding length matches expected block size exactly
    if (padding_length != expected_block_size) {
        if (padding_length < expected_block_size) {
            return .PaddingTooShort;
        } else {
            return .PaddingTooLong;
        }
    }
    
    return .Ok;
}

// **PBSA-01** — AES-128 accepts 16-byte padding.
test pbsa_01_aes128_16bytes {
    assert(validate_block_size_alignment(.Aes128, 16) == .Ok);
    assert(validate_block_size_alignment(.Aes128, 15) == .PaddingTooShort);
    assert(validate_block_size_alignment(.Aes128, 17) == .PaddingTooLong);
}

// **PBSA-02** — AES-256 accepts 16-byte padding.
test pbsa_02_aes256_16bytes {
    assert(validate_block_size_alignment(.Aes256, 16) == .Ok);
    assert(validate_block_size_alignment(.Aes256, 15) == .PaddingTooShort);
    assert(validate_block_size_alignment(.Aes256, 17) == .PaddingTooLong);
}

// **PBSA-03** — ChaCha20 accepts 64-byte padding.
test pbsa_03_chacha20_64bytes {
    assert(validate_block_size_alignment(.ChaCha20, 64) == .Ok);
    assert(validate_block_size_alignment(.ChaCha20, 63) == .PaddingTooShort);
    assert(validate_block_size_alignment(.ChaCha20, 65) == .PaddingTooLong);
}

// **PBSA-04** — Blowfish accepts 8-byte padding.
test pbsa_04_blowfish_8bytes {
    assert(validate_block_size_alignment(.Blowfish, 8) == .Ok);
    assert(validate_block_size_alignment(.Blowfish, 7) == .PaddingTooShort);
    assert(validate_block_size_alignment(.Blowfish, 9) == .PaddingTooLong);
}

// **PBSA-05** — zero padding rejected for all algorithms.
test pbsa_05_zero_padding_rejected {
    assert(validate_block_size_alignment(.Aes128, 0) == .PaddingTooShort);
    assert(validate_block_size_alignment(.Aes256, 0) == .PaddingTooShort);
    assert(validate_block_size_alignment(.ChaCha20, 0) == .PaddingTooShort);
    assert(validate_block_size_alignment(.Blowfish, 0) == .PaddingTooShort);
}

// **PBSA-06** — multiple block padding rejected (must be exact size).
test pbsa_06_multiple_blocks_rejected {
    assert(validate_block_size_alignment(.Aes128, 32) == .PaddingTooLong);
    assert(validate_block_size_alignment(.Aes256, 32) == .PaddingTooLong);
    assert(validate_block_size_alignment(.ChaCha20, 128) == .PaddingTooLong);
    assert(validate_block_size_alignment(.Blowfish, 16) == .PaddingTooLong);
}

// **PBSA-07** — validation is deterministic.
test pbsa_07_deterministic {
    const result1 = validate_block_size_alignment(.Aes128, 16);
    const result2 = validate_block_size_alignment(.Aes128, 16);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PBSA-08** — all algorithms have correct block sizes.
test pbsa_08_algorithm_block_sizes {
    assert(PBSA_BLOCK_SIZES[.Aes128] == 16);
    assert(PBSA_BLOCK_SIZES[.Aes256] == 16);
    assert(PBSA_BLOCK_SIZES[.ChaCha20] == 64);
    assert(PBSA_BLOCK_SIZES[.Blowfish] == 8);
}