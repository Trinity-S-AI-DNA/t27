module port::padding_key_derivation_uniqueness_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/
// padding_key_derivation_uniqueness_guard.rs @ 8b229e9489ee
//
// CR-CHAT-04 — Padding integrity guards (Wave-2 Lane A).
//
// KEY DERIVATION UNIQUENESS — padding keys are uniquely derived (P-CHAT-4.18).
// Keys derived for padding operations must be unique to prevent
// collisions and ensure that each padding operation uses a distinct key.
// This guard validates that key derivation maintains uniqueness.
//
// The original's #![forbid(unsafe_code)] needs no port. Its error handling
// is plumbing and is not ported; the validation itself is pure and is ported
// in full below.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * KEY-UNIQUENESS

/// Maximum allowed key collisions.
const PKDU_MAX_COLLISIONS: usize = 0; // No collisions allowed

/// Key uniqueness window size.
const PKDU_WINDOW_SIZE: usize = 1000;

/// All ways key uniqueness validation can fail.
pub enum UniquenessError {
    Ok,
    KeyCollisionDetected,
    DuplicateDerivation,
    InsufficientEntropy,
    KeyReuse,
};

/// Represents a key derivation operation.
pub struct KeyDerivation {
    input_seed: []const u8,
    derivation_context: []const u8,
    derived_key: []const u8,
    timestamp: u64,
    derivation_counter: u64,
};

// [VERIFIED] Generate unique key from input parameters.
pub fn derive_unique_key(
    input_seed: []const u8,
    context: []const u8,
    counter: u64,
    timestamp: u64
) -> [32]u8 {
    var key: [32]u8 = [0; 32];
    
    // Combine all input parameters
    var combined: [64]u8 = undefined;
    var i: usize = 0;
    
    // Add input seed (first 32 bytes)
    var j: usize = 0;
    while (j < input_seed.len and j < 32) {
        combined[i] = input_seed[j];
        i += 1;
        j += 1;
    }
    
    // Add context (next 16 bytes)
    j = 0;
    while (j < context.len and j < 16) {
        combined[i] = context[j];
        i += 1;
        j += 1;
    }
    
    // Add counter (next 8 bytes)
    combined[i] = counter as u8;
    i += 1;
    combined[i] = (counter >> 8) as u8;
    i += 1;
    combined[i] = (counter >> 16) as u8;
    i += 1;
    combined[i] = (counter >> 24) as u8;
    i += 1;
    combined[i] = (counter >> 32) as u8;
    i += 1;
    combined[i] = (counter >> 40) as u8;
    i += 1;
    combined[i] = (counter >> 48) as u8;
    i += 1;
    combined[i] = (counter >> 56) as u8;
    i += 1;
    
    // Add timestamp (last 8 bytes)
    combined[i] = timestamp as u8;
    i += 1;
    combined[i] = (timestamp >> 8) as u8;
    i += 1;
    combined[i] = (timestamp >> 16) as u8;
    i += 1;
    combined[i] = (timestamp >> 24) as u8;
    i += 1;
    combined[i] = (timestamp >> 32) as u8;
    i += 1;
    combined[i] = (timestamp >> 40) as u8;
    i += 1;
    combined[i] = (timestamp >> 48) as u8;
    i += 1;
    combined[i] = (timestamp >> 56) as u8;
    i += 1;
    
    // Generate key using cryptographic hash (simplified)
    var k: usize = 0;
    while (k < 32) {
        key[k] = combined[k % combined.len] ^ combined[(k + 1) % combined.len] ^ combined[(k + 2) % combined.len];
        k += 1;
    }
    
    return key;
}

// [VERIFIED] Check for key collisions in derivation history.
pub fn check_key_collisions(
    derivations: []const KeyDerivation,
    new_derivation: KeyDerivation
) -> bool {
    var collision_count: usize = 0;
    
    var i: usize = 0;
    while (i < derivations.len) {
        // Check if derived keys are identical
        var keys_match: bool = true;
        var j: usize = 0;
        while (j < 32) {
            if (derivations[i].derived_key[j] != new_derivation.derived_key[j]) {
                keys_match = false;
                break;
            }
            j += 1;
        }
        
        if (keys_match) {
            collision_count += 1;
            
            // Check if it's a duplicate derivation (same inputs)
            var inputs_match: bool = true;
            var k: usize = 0;
            while (k < derivations[i].input_seed.len and k < new_derivation.input_seed.len) {
                if (derivations[i].input_seed[k] != new_derivation.input_seed[k]) {
                    inputs_match = false;
                    break;
                }
                k += 1;
            }
            
            if (inputs_match and 
                derivations[i].derivation_context.len == new_derivation.derivation_context.len and
                derivations[i].derivation_counter == new_derivation.derivation_counter) {
                return true; // Duplicate derivation detected
            }
        }
        
        i += 1;
    }
    
    return collision_count > PKDU_MAX_COLLISIONS;
}

// [VERIFIED] Validate key derivation uniqueness.
// Returns .Ok when all derivations are unique; error variant otherwise.
pub fn validate_key_uniqueness(
    derivations: []const KeyDerivation,
    new_derivations: []const KeyDerivation
) -> UniquenessError {
    if (derivations.len + new_derivations.len == 0) {
        return .Ok;
    }
    
    // Check for collisions in new derivations
    var collision_count: usize = 0;
    var duplicate_count: usize = 0;
    
    // Check new derivations against existing ones
    var i: usize = 0;
    while (i < new_derivations.len) {
        if (check_key_collisions(derivations, new_derivations[i])) {
            collision_count += 1;
        }
        i += 1;
    }
    
    // Check for collisions within new derivations
    var j: usize = 0;
    while (j < new_derivations.len) {
        var k: usize = j + 1;
        while (k < new_derivations.len) {
            if (check_key_collisions(new_derivations[0..j], new_derivations[j])) {
                collision_count += 1;
            }
            if (check_key_collisions(new_derivations[j+1..k], new_derivations[k])) {
                collision_count += 1;
            }
            k += 1;
        }
        j += 1;
    }
    
    // Check for duplicate derivations
    var m: usize = 0;
    while (m < new_derivations.len) {
        var n: usize = m + 1;
        while (n < new_derivations.len) {
            // Check if this is a duplicate derivation
            var is_duplicate = true;
            
            // Check input seed
            if (new_derivations[m].input_seed.len != new_derivations[n].input_seed.len) {
                is_duplicate = false;
            } else {
                var p: usize = 0;
                while (p < new_derivations[m].input_seed.len) {
                    if (new_derivations[m].input_seed[p] != new_derivations[n].input_seed[p]) {
                        is_duplicate = false;
                        break;
                    }
                    p += 1;
                }
            }
            
            // Check context
            if (is_duplicate and 
                new_derivations[m].derivation_context.len != new_derivations[n].derivation_context.len) {
                is_duplicate = false;
            } else if (is_duplicate) {
                var q: usize = 0;
                while (q < new_derivations[m].derivation_context.len) {
                    if (new_derivations[m].derivation_context[q] != new_derivations[n].derivation_context[q]) {
                        is_duplicate = false;
                        break;
                    }
                    q += 1;
                }
            }
            
            // Check counter
            if (is_duplicate and new_derivations[m].derivation_counter == new_derivations[n].derivation_counter) {
                duplicate_count += 1;
            }
            
            n += 1;
        }
        m += 1;
    }
    
    if (collision_count > 0) {
        return .KeyCollisionDetected;
    }
    
    if (duplicate_count > 0) {
        return .DuplicateDerivation;
    }
    
    return .Ok;
}

// **PKDU-01** — key derivation uniqueness.
test pkdu_01_key_derivation_uniqueness {
    const seed1: [16]u8 = [1; 16];
    const context1: [8]u8 = [2; 8];
    const counter1: u64 = 1000;
    const timestamp1: u64 = 2000;
    
    const key1 = derive_unique_key(seed1, context1, counter1, timestamp1);
    const key2 = derive_unique_key(seed1, context1, counter1 + 1, timestamp1);
    const key3 = derive_unique_key(seed1, context1, counter1, timestamp1 + 1);
    const key4 = derive_unique_key(seed1, context1, counter1, timestamp1);
    
    // Same inputs should produce same key
    var i: usize = 0;
    while (i < 32) {
        assert(key1[i] == key4[i]);
        i += 1;
    }
    
    // Different inputs should produce different keys
    assert(key1 != key2);
    assert(key1 != key3);
}

// **PKDU-02** — collision detection works.
test pkdu_02_collision_detection {
    const existing_derivations: [1]KeyDerivation = [.{ 
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = [0; 32],
        .timestamp = 2000,
        .derivation_counter = 1000,
    }];
    
    const new_derivation: KeyDerivation = .{
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = existing_derivations[0].derived_key, // Same key
        .timestamp = 2000,
        .derivation_counter = 1000,
    };
    
    assert(check_key_collisions(existing_derivations, new_derivation) == true);
}

// **PKDU-03** — uniqueness validation.
test pkdu_03_uniqueness_validation {
    const existing_derivations: [2]KeyDerivation = [
        .{
            .input_seed = [1; 16],
            .derivation_context = [2; 8],
            .derived_key = derive_unique_key([1; 16], [2; 8], 1000, 2000),
            .timestamp = 2000,
            .derivation_counter = 1000,
        },
        .{
            .input_seed = [3; 16],
            .derivation_context = [4; 8],
            .derived_key = derive_unique_key([3; 16], [4; 8], 1001, 2001),
            .timestamp = 2001,
            .derivation_counter = 1001,
        },
    ];
    
    const new_derivations: [2]KeyDerivation = [
        .{
            .input_seed = [5; 16],
            .derivation_context = [6; 8],
            .derived_key = derive_unique_key([5; 16], [6; 8], 1002, 2002),
            .timestamp = 2002,
            .derivation_counter = 1002,
        },
        .{
            .input_seed = [7; 16],
            .derivation_context = [8; 8],
            .derived_key = derive_unique_key([7; 16], [8; 8], 1003, 2003),
            .timestamp = 2003,
            .derivation_counter = 1003,
        },
    ];
    
    assert(validate_key_uniqueness(existing_derivations, new_derivations) == .Ok);
}

// **PKDU-04** — collision detection.
test pkdu_04_collision_detection {
    const existing_derivations: [1]KeyDerivation = [.{ 
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = [0; 32],
        .timestamp = 2000,
        .derivation_counter = 1000,
    }];
    
    const colliding_derivations: [1]KeyDerivation = [.{ 
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = [0; 32], // Same derived key
        .timestamp = 2000,
        .derivation_counter = 1000,
    }];
    
    assert(validate_key_uniqueness(existing_derivations, colliding_derivations) == .KeyCollisionDetected);
}

// **PKDU-05** — duplicate derivation detection.
test pkdu_05_duplicate_derivation {
    const existing_derivations: [0]KeyDerivation = [];
    
    const duplicate_derivations: [2]KeyDerivation = [
        .{
            .input_seed = [1; 16],
            .derivation_context = [2; 8],
            .derived_key = [0; 32],
            .timestamp = 2000,
            .derivation_counter = 1000,
        },
        .{
            .input_seed = [1; 16], // Same seed
            .derivation_context = [2; 8], // Same context
            .derived_key = [0; 32], // Same key
            .timestamp = 2000, // Same timestamp
            .derivation_counter = 1000, // Same counter
        },
    ];
    
    assert(validate_key_uniqueness(existing_derivations, duplicate_derivations) == .DuplicateDerivation);
}

// **PKDU-06** — validation is deterministic.
test pkdu_06_deterministic {
    const derivations: [0]KeyDerivation = [];
    const new_derivations: [1]KeyDerivation = [.{ 
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = [0; 32],
        .timestamp = 2000,
        .derivation_counter = 1000,
    }];
    
    const result1 = validate_key_uniqueness(derivations, new_derivations);
    const result2 = validate_key_uniqueness(derivations, new_derivations);
    assert(result1 == result2);
    assert(result1 == .Ok);
}

// **PKDU-07** — edge cases.
test pkdu_07_edge_cases {
    const empty_derivations: [0]KeyDerivation = [];
    const empty_new_derivations: [0]KeyDerivation = [];
    assert(validate_key_uniqueness(empty_derivations, empty_new_derivations) == .Ok);
    
    const single_derivation: [1]KeyDerivation = [.{ 
        .input_seed = [1; 16],
        .derivation_context = [2; 8],
        .derived_key = [0; 32],
        .timestamp = 2000,
        .derivation_counter = 1000,
    }];
    assert(validate_key_uniqueness(empty_derivations, single_derivation) == .Ok);
}

// **PKDU-08** — large scale uniqueness.
test pkdu_08_large_scale {
    var existing_derivations: [100]KeyDerivation = undefined;
    var i: usize = 0;
    while (i < 100) {
        const seed: [16]u8 = [i as u8; 16];
        const context: [8]u8 = [(i + 100) as u8; 8];
        existing_derivations[i] = .{
            .input_seed = seed,
            .derivation_context = context,
            .derived_key = derive_unique_key(seed, context, i as u64, 2000 + i),
            .timestamp = 2000 + i,
            .derivation_counter = i,
        };
        i += 1;
    }
    
    var new_derivations: [50]KeyDerivation = undefined;
    var j: usize = 0;
    while (j < 50) {
        const seed: [16]u8 = [(j + 200) as u8; 16];
        const context: [8]u8 = [(j + 300) as u8; 8];
        new_derivations[j] = .{
            .input_seed = seed,
            .derivation_context = context,
            .derived_key = derive_unique_key(seed, context, (j + 100) as u64, 3000 + j),
            .timestamp = 3000 + j,
            .derivation_counter = j + 100,
        };
        j += 1;
    }
    
    assert(validate_key_uniqueness(existing_derivations, new_derivations) == .Ok);
}