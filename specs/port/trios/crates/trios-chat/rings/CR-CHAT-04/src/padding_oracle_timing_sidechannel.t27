module port::trios::crates::trios-chat::rings::CR-CHAT-04::src::padding_oracle_timing_sidechannel;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-04/src/padding_oracle_timing_sidechannel.rs
// (CR-CHAT-04 - Padding oracle timing side-channel guard, Wave-51
// Lane A, requirement R-CHAT-9).
//
// Unpadding must cost time independent of the plaintext length:
// an adversary measuring unpad latency reads the original message
// size off the envelope and the padding class collapses back into
// a size oracle. The guard therefore walks the whole class every
// time - the wire length must equal the class size exactly, the
// payload prefix must fit the class bounds, and the padding region
// must be zeros to the end of the class. The rules, in the
// original's order: the wire-length floor, the wire-length ceiling,
// the class-size floor, the zero-payload probe, the payload ceiling
// and the zero-padding scan.
//
// The original returns Result<&[u8], PaddingTimingError> - the
// payload slice on accept. The port's verdict carries the code and
// the payload length; the bytes themselves live in the caller's
// wire and never reach the spec (owner decision D5). The codes
// keep the original's declaration order: Ok first, then
// WireDataTooShort, PayloadTooLong, LengthPrefixOverflow,
// NonZeroPadding, ZeroPayload and WireDataTooLong.
//
// The original declares LengthPrefixOverflow but never answers it:
// on the target the u32 length lands in usize without wrapping, so
// an oversized prefix always trips the payload ceiling first. The
// variant stays in the enum, declared and unreachable exactly as in
// the original. The length prefix folds from the first four wire
// bytes through the int-widening cast - no shift-and-truncate
// anywhere.

// Length of the u32 BE payload-length prefix.
pub const POTC_LEN_PREFIX: usize = 4;

// The class size of the standard fixtures.
pub const POTC_CLASS_64: usize = 64;

// The class size of the larger fixture.
pub const POTC_CLASS_128: usize = 128;

// Verdict codes: Ok(&[u8]) and PaddingTimingError's variants, in declaration order.
pub enum PaddingTimingCode {
    Ok,
    WireDataTooShort,
    PayloadTooLong,
    LengthPrefixOverflow,
    NonZeroPadding,
    ZeroPayload,
    WireDataTooLong,
}

// The verdict of one padded envelope: the code and, on accept, the
// payload length the wire carries.
pub struct PaddingTimingVerdict {
    code: PaddingTimingCode,
    payload_len: usize,
}

// The big-endian u32 of the first four bytes - the original's
// u32::from_be_bytes, folded byte by byte through the
// int-widening cast.
pub fn read_be32(b: []const u8) -> u32 {
    var v: u32 = 0;
    var wide: u32 = 0;
    for i in 0..4 {
        wide = @as(u32, b[i]);
        v = v * 256 + wide;
    }
    return v;
}

// [VERIFIED] Validate a padded envelope against a class size.
// Returns Ok with the payload length only when every rule holds,
// checked in the original's order: the wire-length floor and
// ceiling, the class-size floor, the zero-payload probe, the
// payload ceiling, then the zero scan over the whole padding
// region to the end of the class.
pub fn validate_padded_envelope(wire: []const u8, class_size: usize) -> PaddingTimingVerdict {
    if (wire.len < class_size) {
        return PaddingTimingVerdict { code: PaddingTimingCode.WireDataTooShort, payload_len: 0, };
    }
    if (wire.len > class_size) {
        return PaddingTimingVerdict { code: PaddingTimingCode.WireDataTooLong, payload_len: 0, };
    }
    if (class_size < POTC_LEN_PREFIX) {
        return PaddingTimingVerdict { code: PaddingTimingCode.WireDataTooShort, payload_len: 0, };
    }
    const payload_len32: u32 = read_be32(wire);
    const payload_len: usize = @as(usize, payload_len32);
    if (payload_len == 0) {
        return PaddingTimingVerdict { code: PaddingTimingCode.ZeroPayload, payload_len: 0, };
    }
    const max_payload: usize = class_size - POTC_LEN_PREFIX;
    if (payload_len > max_payload) {
        return PaddingTimingVerdict { code: PaddingTimingCode.PayloadTooLong, payload_len: 0, };
    }
    const padding_start: usize = POTC_LEN_PREFIX + payload_len;
    for j in padding_start..class_size {
        if (wire[j] != 0) {
            return PaddingTimingVerdict { code: PaddingTimingCode.NonZeroPadding, payload_len: 0, };
        }
    }
    return PaddingTimingVerdict { code: PaddingTimingCode.Ok, payload_len: payload_len, };
}

// **POTC-01** - a wire shorter than the class rejected before any
// byte is read.
test potc_01_wire_short_rejected {
    var wire: [32]u8;
    for j in 0..32 {
        wire[j] = 0;
    }
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.WireDataTooShort);
}

// **POTC-02** - a wire longer than the class rejected.
test potc_02_wire_long_rejected {
    var wire: [65]u8;
    for j in 0..65 {
        wire[j] = 0;
    }
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.WireDataTooLong);
}

// **POTC-03** - a payload prefix claiming the whole class
// rejected: sixty-four of a maximum sixty.
test potc_03_payload_long_rejected {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[3] = 64;
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.PayloadTooLong);
}

// **POTC-04** - a non-zero byte in the padding region rejected:
// the two-byte payload leaves the region starting at six, and its
// first byte carries 0x42.
test potc_04_nonzero_padding_rejected {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[3] = 2;
    wire[4] = 104;
    wire[5] = 105;
    wire[6] = 66;
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.NonZeroPadding);
}

// **POTC-05** - a zero payload prefix rejected: the whole wire is
// zeros, the declared length is zero.
test potc_05_zero_payload_rejected {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.ZeroPayload);
}

// **POTC-06** - the valid envelope accepted: "hello world", eleven
// bytes, padded to the class.
test potc_06_valid_accepted {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[3] = 11;
    wire[4] = 104;
    wire[5] = 101;
    wire[6] = 108;
    wire[7] = 108;
    wire[8] = 111;
    wire[9] = 32;
    wire[10] = 119;
    wire[11] = 111;
    wire[12] = 114;
    wire[13] = 108;
    wire[14] = 100;
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.Ok);
    assert(r.payload_len == 11);
}

// **POTC-07** - the exact maximum payload accepted: sixty bytes of
// 0xAA filling the whole payload region of the sixty-four class.
test potc_07_exact_max_payload_accepted {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[3] = 60;
    for j in 4..64 {
        wire[j] = 170;
    }
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.Ok);
    assert(r.payload_len == 60);
}

// **POTC-08** - a single-byte payload accepted.
test potc_08_single_byte_accepted {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[3] = 1;
    wire[4] = 88;
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.Ok);
    assert(r.payload_len == 1);
}

// **POTC-09** - the larger class accepted: "test payload", twelve
// bytes, padded to the hundred-twenty-eight class.
test potc_09_larger_class_accepted {
    var wire: [128]u8;
    for j in 0..128 {
        wire[j] = 0;
    }
    wire[3] = 12;
    wire[4] = 116;
    wire[5] = 101;
    wire[6] = 115;
    wire[7] = 116;
    wire[8] = 32;
    wire[9] = 112;
    wire[10] = 97;
    wire[11] = 121;
    wire[12] = 108;
    wire[13] = 111;
    wire[14] = 97;
    wire[15] = 100;
    const r = validate_padded_envelope(&wire, POTC_CLASS_128);
    assert(r.code == PaddingTimingCode.Ok);
    assert(r.payload_len == 12);
}

// **POTC-10** - the all-ones length prefix rejected: the u32
// maximum as a payload length is far over the sixty-byte ceiling.
test potc_10_len_overflow_rejected {
    var wire: [64]u8;
    for j in 0..64 {
        wire[j] = 0;
    }
    wire[0] = 255;
    wire[1] = 255;
    wire[2] = 255;
    wire[3] = 255;
    const r = validate_padded_envelope(&wire, POTC_CLASS_64);
    assert(r.code == PaddingTimingCode.PayloadTooLong);
}

// The helper has a direct test (coverage: Untested 0).
test read_be32_answers {
    var four: [4]u8 = [4]u8{0, 0, 0, 60,};
    assert(read_be32(&four) == 60);
    var ones: [4]u8 = [4]u8{255, 255, 255, 255,};
    assert(read_be32(&ones) == 4294967295);
    var span: [4]u8 = [4]u8{0, 0, 15, 160,};
    assert(read_be32(&span) == 4000);
}

// Rule order is the original's: the wire-length floor before the
// prefix is read, the class-size floor before the payload probe,
// and the payload ceiling before the padding scan.
test rule_order_matches_original {
    var short_hot: [32]u8;
    for j in 0..32 {
        short_hot[j] = 255;
    }
    const v1 = validate_padded_envelope(&short_hot, POTC_CLASS_64);
    assert(v1.code == PaddingTimingCode.WireDataTooShort);

    var tiny: [2]u8;
    for j in 0..2 {
        tiny[j] = 0;
    }
    const v2 = validate_padded_envelope(&tiny, 2);
    assert(v2.code == PaddingTimingCode.WireDataTooShort);

    var long_claim_garbage: [64]u8;
    for j in 0..64 {
        long_claim_garbage[j] = 255;
    }
    long_claim_garbage[0] = 0;
    long_claim_garbage[1] = 0;
    long_claim_garbage[2] = 0;
    long_claim_garbage[3] = 61;
    const v3 = validate_padded_envelope(&long_claim_garbage, POTC_CLASS_64);
    assert(v3.code == PaddingTimingCode.PayloadTooLong);
}
