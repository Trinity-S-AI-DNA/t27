module port::trios::crates::trios_chat::rings::CR_CHAT_01::src::signature_algorithm_pinning_guard;

// Port of gHashTag/trios
// crates/trios-chat/rings/CR-CHAT-01/src/signature_algorithm_pinning_guard.rs
// (176 lines).
//
// The Rust function returns Result<(), SigAlgoPinError>; .t27 has no Result, so
// the function returns a closed enum whose `.Accepted` variant is the Ok case.
// The pin list is a slice, which is what the Rust signature uses (line 59).

// Line 35: maximum pinning list size.
const SAPN_MAX_PINS: usize = 8;

// Lines 37-38: allowed algorithm ids, and the two that matter for the guard.
const SAPN_ALLOWED_ED25519: u16 = 1;
const SAPN_ALLOWED_ED448: u16 = 2;
const SAPN_ALLOWED_ECDSA_P256: u16 = 3;

// Lines 43-56: the six rejection modes, plus the accepted outcome.
enum SigAlgoPinError {
    Accepted,
    AlgoMismatch,
    WireAlgoMismatch,
    AlgoNotAllowed,
    ZeroAlgoId,
    EmptyPins,
    TooManyPins,
}

// Line 75-77: membership in SAPN_ALLOWED_ALGOS = [1, 2, 3]. Written out rather
// than held in an array so the check is a pure scalar decision.
fn algo_is_allowed(algo: u16) -> bool {
    if (algo == SAPN_ALLOWED_ED25519) {
        return true;
    }
    if (algo == SAPN_ALLOWED_ED448) {
        return true;
    }
    if (algo == SAPN_ALLOWED_ECDSA_P256) {
        return true;
    }
    return false;
}

// Lines 59-85. The order of the guards is the decision: empty list first, then
// the size cap, then every zero element, then the allowed set, then credential
// membership, then the wire agreement. Keeping that order matters: `[0,1]` with
// algo 1 reports ZeroAlgoId (IKUC-style first-failure), not Accepted.
pub fn validate_sig_algo_pinning(
    pins: []const u16,
    credential_algo: u16,
    wire_algo: u16,
) -> SigAlgoPinError {
    if (pins.len == 0) {
        return .EmptyPins;
    }
    if (pins.len > SAPN_MAX_PINS) {
        return .TooManyPins;
    }
    var i: usize = 0;
    while (i < pins.len) {
        if (pins[i] == 0) {
            return .ZeroAlgoId;
        }
        i += 1;
    }
    if (!algo_is_allowed(credential_algo)) {
        return .AlgoNotAllowed;
    }
    var found: bool = false;
    i = 0;
    while (i < pins.len) {
        if (pins[i] == credential_algo) {
            found = true;
        }
        i += 1;
    }
    if (!found) {
        return .AlgoMismatch;
    }
    if (wire_algo != credential_algo) {
        return .WireAlgoMismatch;
    }
    return .Accepted;
}

// SAPN-01 (lines 95-102): credential algo 3 is allowed but not pinned.
test sapn_01_mismatch_rejected {
    const pins: [2]u16 = [1, 2];
    assert(validate_sig_algo_pinning(&pins, 3, 3) == .AlgoMismatch);
}

// SAPN-02 (lines 105-111): credential is pinned, but the wire uses another algo.
test sapn_02_wire_mismatch_rejected {
    const pins: [2]u16 = [1, 2];
    assert(validate_sig_algo_pinning(&pins, 1, 2) == .WireAlgoMismatch);
}

// SAPN-03 (lines 114-120): 99 is outside the allowed set.
test sapn_03_not_allowed_rejected {
    const pins: [1]u16 = [1];
    assert(validate_sig_algo_pinning(&pins, 99, 99) == .AlgoNotAllowed);
}

// SAPN-04 (lines 123-129): a zero pin id is reserved.
test sapn_04_zero_rejected {
    const pins: [2]u16 = [0, 1];
    assert(validate_sig_algo_pinning(&pins, 1, 1) == .ZeroAlgoId);
}

// SAPN-05 (lines 132-138): an empty pinning list is rejected.
test sapn_05_empty_rejected {
    const pins: [0]u16 = [];
    assert(validate_sig_algo_pinning(&pins, 1, 1) == .EmptyPins);
}

// SAPN-06 (lines 141-148): nine pins is one past SAPN_MAX_PINS = 8.
test sapn_06_too_many_rejected {
    const pins: [9]u16 = [1, 2, 3, 1, 2, 3, 1, 2, 3];
    assert(validate_sig_algo_pinning(&pins, 1, 1) == .TooManyPins);
}

// SAPN-07 (lines 151-154): the canonical valid pinning.
test sapn_07_valid_accepted {
    const pins: [2]u16 = [1, 2];
    assert(validate_sig_algo_pinning(&pins, 1, 1) == .Accepted);
}

// SAPN-08 (lines 157-160): the second allowed pin is also valid.
test sapn_08_second_pin_accepted {
    const pins: [2]u16 = [1, 2];
    assert(validate_sig_algo_pinning(&pins, 2, 2) == .Accepted);
}

// SAPN-09 (lines 163-166): a one-element pin list is valid.
test sapn_09_single_pin_accepted {
    const pins: [1]u16 = [1];
    assert(validate_sig_algo_pinning(&pins, 1, 1) == .Accepted);
}

// SAPN-10 (lines 169-175): all three allowed algorithms pinned at once.
test sapn_10_all_allowed_accepted {
    const pins: [3]u16 = [1, 2, 3];
    assert(validate_sig_algo_pinning(&pins, 3, 3) == .Accepted);
}
