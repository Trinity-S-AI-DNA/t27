module port::trios::crates::trios_chat::rings::CR_CHAT_06::src::tool_response_timeout_guard;

// Port of gHashTag/trios
// crates/trios-chat/rings/CR-CHAT-06/src/tool_response_timeout_guard.rs (180 lines).
//
// Rust returns Result<(), ToolTimeoutError>; .t27 has no Result, so the decision
// is expressed as a closed enum with an `.Accepted` variant. Every arithmetic
// step is the original one: latency is computed only after the response is known
// not to precede the start, so the u64 subtraction cannot underflow.

// Lines 33 and 36: the latency floor and the timeout ceiling.
const TRTO_MIN_TIMEOUT_MS: u64 = 10;
const TRTO_MAX_TIMEOUT_MS: u64 = 30_000;

// Lines 41-54: the six failure modes, plus the accepted outcome.
enum ToolTimeoutError {
    Accepted,
    TimeoutExceeded,
    TooFast,
    ZeroTimeout,
    TimeoutTooLarge,
    NoTimeoutSet,
    ResponseAfterTimeout,
}

// Lines 57-79. Guard order is the decision:
//   1. timeout 0 -> ZeroTimeout (rule 3; an unset timeout is rejected, which is
//      also how rule 6 "timeout must be set before any tool call" surfaces);
//   2. timeout above the ceiling -> TimeoutTooLarge;
//   3. response before start -> ResponseAfterTimeout (this is checked BEFORE the
//      subtraction, line 68, so no underflow);
//   4. latency over the timeout -> TimeoutExceeded;
//   5. latency under the floor -> TooFast (cached/stub response).
// `NoTimeoutSet` is declared by the Rust enum (line 51) but validate_tool_timeout
// never constructs it: a missing timeout arrives as 0 and is reported as
// ZeroTimeout (see TRTO-06). The variant is documented, not invented.
pub fn validate_tool_timeout(timeout_ms: u64, start_ms: u64, response_ms: u64) -> ToolTimeoutError {
    if (timeout_ms == 0) {
        return .ZeroTimeout;
    }
    if (timeout_ms > TRTO_MAX_TIMEOUT_MS) {
        return .TimeoutTooLarge;
    }
    if (response_ms < start_ms) {
        return .ResponseAfterTimeout;
    }
    const latency = response_ms - start_ms;
    if (latency > timeout_ms) {
        return .TimeoutExceeded;
    }
    if (latency < TRTO_MIN_TIMEOUT_MS) {
        return .TooFast;
    }
    return .Accepted;
}

const START: u64 = 1_000_000;

// TRTO-01 (lines 92-98): one millisecond past the timeout is rejected.
test trto_01_timeout_exceeded_rejected {
    assert(validate_tool_timeout(10_000, START, START + 10_001) == .TimeoutExceeded);
}

// TRTO-02 (lines 101-107): a 1 ms response is below the 10 ms floor.
test trto_02_too_fast_rejected {
    assert(validate_tool_timeout(10_000, START, START + 1) == .TooFast);
}

// TRTO-03 (lines 110-116): a zero timeout is rejected before anything else.
test trto_03_zero_timeout_rejected {
    assert(validate_tool_timeout(0, START, START + 100) == .ZeroTimeout);
}

// TRTO-04 (lines 119-125): 30_001 exceeds the 30_000 ceiling.
test trto_04_timeout_large_rejected {
    assert(validate_tool_timeout(TRTO_MAX_TIMEOUT_MS + 1, START, START + 100) == .TimeoutTooLarge);
}

// TRTO-05 (lines 128-134): a response stamped before the call started.
test trto_05_response_before_start_rejected {
    assert(validate_tool_timeout(10_000, START, START - 1) == .ResponseAfterTimeout);
}

// TRTO-06 (lines 137-143): an unset timeout arrives as zero.
test trto_06_no_timeout_scenario {
    assert(validate_tool_timeout(0, START, START + 100) == .ZeroTimeout);
}

// TRTO-07 (lines 146-152): a 1000 ms latency inside a 10 s timeout is fine.
test trto_07_valid_accepted {
    assert(validate_tool_timeout(10_000, START, START + 1000) == .Accepted);
}

// TRTO-08 (lines 155-161): the inclusive latency floor is accepted.
test trto_08_min_latency_accepted {
    assert(validate_tool_timeout(10_000, START, START + TRTO_MIN_TIMEOUT_MS) == .Accepted);
}

// TRTO-09 (lines 164-170): the inclusive timeout boundary is accepted.
test trto_09_exact_timeout_accepted {
    assert(validate_tool_timeout(10_000, START, START + 10_000) == .Accepted);
}

// TRTO-10 (lines 173-179): the maximum timeout setting is itself legal.
test trto_10_max_timeout_accepted {
    assert(validate_tool_timeout(TRTO_MAX_TIMEOUT_MS, START, START + 1000) == .Accepted);
}
