module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::wire_timing_anomaly_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/wire_timing_anomaly_guard.rs
// (CR-CHAT-07 - Wire timing anomaly guard, Wave-48 Lane A,
// R-CHAT-10).
//
// Even with canonical gaps and cadence uniformity, an
// observer applying statistical tests over many envelopes
// reads deviations from uniform emission; the guard holds
// the distribution of observed inter-envelope gaps inside
// its expected bounds. The rules, in the original's order:
// the empty batch accepts, the observation ceiling (one
// thousand twenty-four), then per gap the zero probe and
// the canonical-set probe, then over batches of eight or
// more the class census with its dominance ceiling (no
// class over three quarters of the total, the original's
// cross-multiplied fraction) and the standard-deviation
// ceiling over the gap class indices.
//
// The original returns Result<(), TimingAnomalyError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the six variants in the original's
// declaration order - InsufficientSamples, NonCanonicalGap,
// ClassDominance, StdDevTooHigh, ZeroGap,
// TooManyObservations. Every original variant carries no
// payload, so the code is the whole verdict.
//
// Two variants are declared and never answered, kept in the
// enum exactly as the original keeps them. InsufficientSamples:
// the prose lists a sample floor, but the code gates the
// statistical block at eight and accepts smaller batches
// (the original's first and eighth tests pin the
// acceptance). StdDevTooHigh: the original's float ceiling is
// a standard deviation of one point five over indices that
// span exactly three rungs, and a spread over a range never
// strictly exceeds half the range - the variance never
// strictly exceeds a quarter of the squared range, exactly
// the cut of nine quarters - so no input ever fires it.
//
// That float ceiling is re-based to the exact rational form
// in pure usize: with S the index sum, n the batch length
// and W the fold of squared deviations |i*n - S| squared,
// the index variance is W/n^3 exactly and the ceiling fires
// exactly when 4*W > 9*n^3, because 1.5^2 is 9/4. The
// original's Option<usize> position probe becomes the
// one-past-the-set sentinel index four; the class census
// becomes a zero-initialized four-slot table walked with the
// sentinel guard, the original's if-let None arm.

// Canonical gap classes (milliseconds), matching CR-CHAT-07.
pub const WTAG_CANONICAL_GAPS_MS: [4]u64 = [4]u64{1000, 5000, 30000, 300000,};

// Minimum samples required for analysis.
pub const WTAG_MIN_SAMPLES: usize = 8;

// Maximum fraction of any single gap class: numerator over
// denominator, three quarters.
pub const WTAG_MAX_CLASS_FRAC_NUM: usize = 3;
pub const WTAG_MAX_CLASS_FRAC_DEN: usize = 4;

// The exact-rational standard-deviation ceiling: the squared
// cut of nine quarters - 1.5^2 = 9/4.
pub const WTAG_STDDEV_CUT_NUM: usize = 9;
pub const WTAG_STDDEV_CUT_SCALE: usize = 4;

// Maximum number of gap observations.
pub const WTAG_MAX_OBSERVATIONS: usize = 1024;

// Verdict codes: Ok(()) and TimingAnomalyError's variants, in declaration order.
pub enum WtagCode {
    Ok,
    InsufficientSamples,
    NonCanonicalGap,
    ClassDominance,
    StdDevTooHigh,
    ZeroGap,
    TooManyObservations,
}

// The verdict of the timing distribution validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct WtagVerdict {
    code: WtagCode,
}

// The class index of a canonical gap - the original's
// Option<usize> position probe as the one-past-the-set
// sentinel: four answers a gap outside the canonical set.
pub fn canonical_gap_index(gap_ms: u64) -> usize {
    for i in 0..4 {
        if (WTAG_CANONICAL_GAPS_MS[i] == gap_ms) {
            return i;
        }
    }
    return 4;
}

// Whether the standard deviation of the gap class indices
// exceeds the ceiling - the original's f64 fold re-based to
// the exact rational form: the variance is W/n^3 and the
// ceiling fires exactly when 4*W > 9*n^3.
pub fn indices_stddev_over_cut(gaps: []const u64) -> bool {
    const n: usize = gaps.len;
    var sum: usize = 0;
    for i in 0..gaps.len {
        sum = sum + canonical_gap_index(gaps[i]);
    }
    var w: usize = 0;
    for i in 0..gaps.len {
        const idx: usize = canonical_gap_index(gaps[i]);
        var term: usize = 0;
        if (idx * n > sum) {
            term = idx * n - sum;
        } else {
            term = sum - idx * n;
        }
        w = w + term * term;
    }
    if (WTAG_STDDEV_CUT_SCALE * w > WTAG_STDDEV_CUT_NUM * n * n * n) {
        return true;
    }
    return false;
}

// [VERIFIED] Validate observed inter-envelope gaps for
// timing anomalies. Returns Ok only when every rule holds,
// checked in the original's order: the empty batch, the
// observation ceiling, the per-gap probes, then over batches
// of eight or more the dominance ceiling and the
// standard-deviation ceiling.
pub fn validate_timing_distribution(gaps: []const u64) -> WtagVerdict {
    if (gaps.len == 0) {
        return WtagVerdict { code: WtagCode.Ok, };
    }
    if (gaps.len > WTAG_MAX_OBSERVATIONS) {
        return WtagVerdict { code: WtagCode.TooManyObservations, };
    }
    for i in 0..gaps.len {
        if (gaps[i] == 0) {
            return WtagVerdict { code: WtagCode.ZeroGap, };
        }
        if (canonical_gap_index(gaps[i]) == 4) {
            return WtagVerdict { code: WtagCode.NonCanonicalGap, };
        }
    }
    if (gaps.len >= WTAG_MIN_SAMPLES) {
        var class_counts: [4]usize = [4]usize{0, 0, 0, 0,};
        for i in 0..gaps.len {
            const idx: usize = canonical_gap_index(gaps[i]);
            if (idx < 4) {
                class_counts[idx] = class_counts[idx] + 1;
            }
        }
        const total: usize = gaps.len;
        for c in 0..4 {
            if (class_counts[c] * WTAG_MAX_CLASS_FRAC_DEN > total * WTAG_MAX_CLASS_FRAC_NUM) {
                return WtagVerdict { code: WtagCode.ClassDominance, };
            }
        }
        if (indices_stddev_over_cut(gaps)) {
            return WtagVerdict { code: WtagCode.StdDevTooHigh, };
        }
    }
    return WtagVerdict { code: WtagCode.Ok, };
}

// **WTAG-01** - an insufficient sample accepted: two gaps
// carry no statistics to run.
test wtag_01_few_samples_accepted {
    const gaps: [2]u64 = [2]u64{1000, 5000,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.Ok);
}

// **WTAG-02** - the non-canonical gap rejected: nine hundred
// ninety-nine sits outside the set.
test wtag_02_non_canonical_rejected {
    const gaps: [2]u64 = [2]u64{1000, 999,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.NonCanonicalGap);
}

// **WTAG-03** - the zero gap rejected.
test wtag_03_zero_gap_rejected {
    const gaps: [2]u64 = [2]u64{1000, 0,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.ZeroGap);
}

// **WTAG-04** - too many observations rejected: one thousand
// twenty-five of a ceiling of one thousand twenty-four,
// built in a loop like the original's; the ceiling fires
// before any gap is examined.
test wtag_04_too_many_rejected {
    var gaps: [1025]u64;
    for i in 0..1025 {
        gaps[i] = 1000;
    }
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.TooManyObservations);
}

// **WTAG-05** - class dominance rejected: seven of eight
// gaps in the first class, cross-multiplied over the
// three-quarter ceiling.
test wtag_05_class_dominance_rejected {
    var gaps: [8]u64;
    for i in 0..7 {
        gaps[i] = 1000;
    }
    gaps[7] = 5000;
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.ClassDominance);
}

// **WTAG-06** - the uniform gaps accepted: the first two
// classes alternating, four each.
test wtag_06_uniform_accepted {
    const gaps: [8]u64 = [8]u64{1000, 5000, 1000, 5000, 1000, 5000, 1000, 5000,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.Ok);
}

// **WTAG-07** - an empty batch accepted.
test wtag_07_empty_accepted {
    const gaps: [0]u64 = [0]u64{};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.Ok);
}

// **WTAG-08** - few of one class accepted: four gaps below
// the statistical gate, the census never runs.
test wtag_08_few_same_class_accepted {
    const gaps: [4]u64 = [4]u64{1000, 1000, 1000, 1000,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.Ok);
}

// **WTAG-09** - class dominance by the thousand-millisecond
// class rejected: seven of eight again.
test wtag_09_class_dominance_skewed_rejected {
    const gaps: [8]u64 = [8]u64{1000, 300000, 1000, 1000, 1000, 1000, 1000, 1000,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.ClassDominance);
}

// **WTAG-10** - the balanced three-class batch accepted.
test wtag_10_balanced_accepted {
    const gaps: [8]u64 = [8]u64{1000, 5000, 30000, 1000, 5000, 30000, 1000, 5000,};
    const v = validate_timing_distribution(&gaps);
    assert(v.code == WtagCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test canonical_gap_index_answers {
    assert(canonical_gap_index(1000) == 0);
    assert(canonical_gap_index(5000) == 1);
    assert(canonical_gap_index(30000) == 2);
    assert(canonical_gap_index(300000) == 3);
    assert(canonical_gap_index(999) == 4);
    assert(canonical_gap_index(0) == 4);
}

// The exact-rational ceiling answers at its mathematical
// maximum: the first and last classes split evenly spread
// the indices widest - a standard deviation of exactly one
// point five, the cut itself, not over it (Popoviciu: a
// spread over three rungs never strictly exceeds half the
// range).
test indices_stddev_over_cut_answers {
    const widest: [8]u64 = [8]u64{1000, 300000, 1000, 300000, 1000, 300000, 1000, 300000,};
    assert(!indices_stddev_over_cut(&widest));
    const mixed: [8]u64 = [8]u64{1000, 5000, 30000, 300000, 1000, 5000, 30000, 300000,};
    assert(!indices_stddev_over_cut(&mixed));
}

// Rule order is the original's: the empty batch accepts
// before anything; the observation ceiling answers over a
// flooded batch of zero gaps; the zero probe answers before
// the canonical probe on the same gap (zero sits outside the
// set too); the canonical probe answers before the
// statistical block (a would-be-dominant batch answers its
// non-canonical member first); the statistical gate keeps
// short batches out (four of one class would dominate if the
// census ran); and the dominance ceiling answers over the
// standard-deviation ceiling - after a passing census no
// index spread ever reaches the deviation cut, so the two
// can never co-fire.
test rule_order_matches_original {
    const empty: [0]u64 = [0]u64{};
    const v0 = validate_timing_distribution(&empty);
    assert(v0.code == WtagCode.Ok);

    var flooded: [1025]u64;
    for i in 0..1025 {
        flooded[i] = 0;
    }
    const v1 = validate_timing_distribution(&flooded);
    assert(v1.code == WtagCode.TooManyObservations);

    const stacked: [2]u64 = [2]u64{0, 1000,};
    const v2 = validate_timing_distribution(&stacked);
    assert(v2.code == WtagCode.ZeroGap);

    var would_dominate: [8]u64;
    for i in 0..7 {
        would_dominate[i] = 1000;
    }
    would_dominate[7] = 999;
    const v3 = validate_timing_distribution(&would_dominate);
    assert(v3.code == WtagCode.NonCanonicalGap);

    const short_skewed: [4]u64 = [4]u64{1000, 1000, 1000, 1000,};
    const v4 = validate_timing_distribution(&short_skewed);
    assert(v4.code == WtagCode.Ok);
}
