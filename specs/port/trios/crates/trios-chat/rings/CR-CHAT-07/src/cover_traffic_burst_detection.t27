module port::cover_traffic_burst_detection;

// CR-CHAT-07 - Cover traffic burst detection (Wave-2 Lane A).
//
// BURST DETECTION - identify and prevent traffic bursts, R-CHAT-07.
//
// The cover traffic system must avoid sending messages in bursts that could
// reveal patterns or timing information about real communication. Burst detection
// monitors the timing and volume of cover traffic to identify and prevent
// suspicious patterns.
//
// Key detection criteria:
//
// 1. Message rate within time windows
// 2. Inter-arrival time distribution
// 3. Volume consistency across periods
// 4. Sudden changes in emission patterns
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_burst_detection.rs
// (gHashTag/trios at 8b229e9489ee).

// Maximum time window size in milliseconds.
pub const CTD_MAX_WINDOW: usize = 10000;

// Minimum time window size in milliseconds.
pub const CTD_MIN_WINDOW: usize = 1000;

// Maximum burst threshold (messages per window).
pub const CTD_MAX_BURST_THRESHOLD: usize = 50;

// Minimum burst threshold (messages per window).
pub const CTD_MIN_BURST_THRESHOLD: usize = 5;

// Burst detection result codes.
pub enum BurstResult {
    Normal,
    BurstDetected,
    WindowTooSmall,
    WindowTooLarge,
    ThresholdInvalid,
}

// Verdict codes for burst detection.
pub const CTD_OK: i32 = 0;
pub const CTD_ERR_BURST_DETECTED: i32 = 1;
pub const CTD_ERR_WINDOW_TOO_SMALL: i32 = 2;
pub const CTD_ERR_WINDOW_TOO_LARGE: i32 = 3;
pub const CTD_ERR_THRESHOLD_INVALID: i32 = 4;

// Detect traffic bursts in a time window.
pub fn detect_burst(messages: &[usize], window_size_ms: usize, threshold: usize) -> i32 {
    // Validate input parameters
    if (window_size_ms < CTD_MIN_WINDOW) {
        return CTD_ERR_WINDOW_TOO_SMALL;
    }
    if (window_size_ms > CTD_MAX_WINDOW) {
        return CTD_ERR_WINDOW_TOO_LARGE;
    }
    if (threshold < CTD_MIN_BURST_THRESHOLD || threshold > CTD_MAX_BURST_THRESHOLD) {
        return CTD_ERR_THRESHOLD_INVALID;
    }
    
    // Simple burst detection: count messages in the window
    let message_count = messages.len();
    if (message_count > threshold) {
        return CTD_ERR_BURST_DETECTED;
    }
    
    CTD_OK
}

// Analyze inter-arrival times for burst patterns.
pub fn analyze_inter_arrival(times: &[usize]) -> i32 {
    if (times.len() < 2) {
        return CTD_OK; // Not enough data for analysis
    }
    
    // Calculate inter-arrival times
    let mut inter_arrivals = [0usize; 100];
    let mut i: usize = 0;
    while (i < times.len() - 1 && i < 100) {
        inter_arrivals[i] = times[i + 1] - times[i];
        i = i + 1;
    }
    
    // Check for unusually short intervals (potential bursts)
    let mut short_intervals = 0;
    let mut j: usize = 0;
    while (j < i) {
        if (inter_arrivals[j] < 100) { // Less than 100ms apart
            short_intervals = short_intervals + 1;
        }
        j = j + 1;
    }
    
    // If more than 20% of intervals are very short, flag as potential burst
    if (short_intervals > i / 5) {
        return CTD_ERR_BURST_DETECTED;
    }
    
    CTD_OK
}

// CTD-01 - normal traffic accepted.
test ctd_01_normal_traffic {
    let messages = [100, 200, 300, 400, 500];
    let result = detect_burst(&messages, 1000, 10);
    assert(result == CTD_OK);
}

// CTD-02 - burst detected and rejected.
test ctd_02_burst_detected {
    let messages = [100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110];
    let result = detect_burst(&messages, 1000, 5);
    assert(result == CTD_ERR_BURST_DETECTED);
}

// CTD-03 - window too small rejected.
test ctd_03_window_small {
    let messages = [100, 200, 300];
    let result = detect_burst(&messages, 500, 5);
    assert(result == CTD_ERR_WINDOW_TOO_SMALL);
}

// CTD-04 - inter-arrival analysis normal.
test ctd_04_inter_arrival_normal {
    let times = [1000, 1100, 1200, 1300, 1400];
    let result = analyze_inter_arrival(&times);
    assert(result == CTD_OK);
}

// CTD-05 - inter-arrival burst detected.
test ctd_05_inter_arrival_burst {
    let times = [1000, 1001, 1002, 1003, 2000];
    let result = analyze_inter_arrival(&times);
    assert(result == CTD_ERR_BURST_DETECTED);
}