module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_burst_detection;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_burst_detection.rs
// (CR-CHAT-07 - Cover-traffic burst pattern detection, Wave-41
// Lane B, R-CHAT-10).
//
// Fixed-size padding hides sizes and canonical gaps hide pacing,
// but bursts still read through: a cluster of emissions closer
// than the minimum canonical gap says the user is actively
// typing, and a long silence says idle - together they break
// the always-online, indistinguishable promise. The rules, in
// the original's fixed order: fewer than two records pass
// outright, then per consecutive gap the minimum floor, the
// canonical-gap membership and the silence ceiling, then per
// record the forward thirty-second window with its emission
// ceiling and its cover-ratio floor (the covers over the total
// at least one third, compared as the original's integer
// cross-multiplication).
//
// The original returns Result<(), BurstError> with five variants
// carrying no payloads; the verdict is the code alone (owner
// decision D5), Ok first, the variants in the original's
// declaration order. The original's super::CANONICAL_GAPS_MS
// becomes the ported ladder [1000, 5000, 30000, 300000] with
// the same membership-plus-open-top rule: a gap above the last
// rung counts as canonical, exactly as the original reads. The
// take_while window walk becomes a scanning flag that stops at
// the first record past the window's end; the saturating gap
// subtraction guards explicitly.

// Minimum gap between consecutive emissions (ms).
pub const BURST_MIN_GAP_MS: u64 = 1000;

// Maximum emissions in a burst window before flagging.
pub const BURST_MAX_EMISSIONS: usize = 10;

// Burst window duration (ms).
pub const BURST_WINDOW_MS: u64 = 30000;

// Maximum silence gap allowed (ms).
pub const BURST_MAX_SILENCE_MS: u64 = 300000;

// Minimum cover-to-total ratio, numerator.
pub const BURST_MIN_COVER_NUM: u64 = 1;

// Minimum cover-to-total ratio, denominator.
pub const BURST_MIN_COVER_DEN: u64 = 3;

// The canonical gap ladder of the ring's scheduler, with its
// open top: a gap above the last rung counts as canonical.
pub const BURST_CANONICAL_GAPS_MS: [4]u64 = [4]u64{1000, 5000, 30000, 300000,};

// The kind of one emission on the wire.
pub enum EmissionKind {
    Real,
    Cover,
}

// One recorded emission with its timestamp.
pub struct EmissionRecord {
    timestamp_ms: u64,
    kind: EmissionKind,
}

// Verdict codes: Ok(()) and BurstError's variants, in declaration order.
pub enum BurstCode {
    Ok,
    GapBelowMinimum,
    TooManyEmissions,
    SilenceTooLong,
    CoverRatioTooLow,
    NonCanonicalGap,
}

// The verdict of the burst-pattern validation. No variant of the
// original's error carries a payload, so the code is the whole
// verdict.
pub struct BurstVerdict {
    code: BurstCode,
}

// Whether the gap sits on the canonical ladder or above its
// last rung - the original's contains-or-over-the-top probe.
pub fn is_canonical_gap(gap: u64) -> bool {
    if (gap == 1000) {
        return true;
    }
    if (gap == 5000) {
        return true;
    }
    if (gap == 30000) {
        return true;
    }
    if (gap == 300000) {
        return true;
    }
    if (gap > 300000) {
        return true;
    }
    return false;
}

// [VERIFIED] Validate a sequence of emission records against the
// burst-pattern rules. Returns Ok only when every rule holds,
// checked in the original's fixed order: fewer than two records
// pass, then per gap the floor, the canonical membership and the
// silence ceiling, then per record the forward window with its
// emission ceiling and cover-ratio floor.
pub fn validate_burst_pattern(records: []const EmissionRecord) -> BurstVerdict {
    if (records.len < 2) {
        return BurstVerdict { code: BurstCode.Ok, };
    }
    var gap: u64 = 0;
    for i in 1..records.len {
        if (records[i].timestamp_ms >= records[i - 1].timestamp_ms) {
            gap = records[i].timestamp_ms - records[i - 1].timestamp_ms;
        } else {
            gap = 0;
        }
        if (gap < BURST_MIN_GAP_MS) {
            return BurstVerdict { code: BurstCode.GapBelowMinimum, };
        }
        if (!is_canonical_gap(gap)) {
            return BurstVerdict { code: BurstCode.NonCanonicalGap, };
        }
        if (gap > BURST_MAX_SILENCE_MS) {
            return BurstVerdict { code: BurstCode.SilenceTooLong, };
        }
    }
    for i in 0..records.len {
        const window_end: u64 = records[i].timestamp_ms + BURST_WINDOW_MS;
        var count: usize = 1;
        var covers: usize = 0;
        if (records[i].kind == EmissionKind.Cover) {
            covers = 1;
        }
        var scanning: bool = true;
        for j in 0..records.len {
            if (j > i) {
                if (scanning) {
                    if (records[j].timestamp_ms <= window_end) {
                        count = count + 1;
                        if (records[j].kind == EmissionKind.Cover) {
                            covers = covers + 1;
                        }
                    } else {
                        scanning = false;
                    }
                }
            }
        }
        if (count > BURST_MAX_EMISSIONS) {
            return BurstVerdict { code: BurstCode.TooManyEmissions, };
        }
        if (count >= 2) {
            const ratio_num: u64 = @as(u64, covers) * BURST_MIN_COVER_DEN;
            const ratio_den: u64 = @as(u64, count) * BURST_MIN_COVER_NUM;
            if (ratio_num < ratio_den) {
                return BurstVerdict { code: BurstCode.CoverRatioTooLow, };
            }
        }
    }
    return BurstVerdict { code: BurstCode.Ok, };
}

// **BURST-01** - a five-hundred-millisecond gap rejected.
test burst_01_gap_below_minimum_rejected {
    const records: [2]EmissionRecord = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 500, kind: EmissionKind.Cover, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.GapBelowMinimum);
}

// **BURST-02** - a four-hundred-second silence rejected.
test burst_02_silence_too_long_rejected {
    const records: [2]EmissionRecord = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 400000, kind: EmissionKind.Cover, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.SilenceTooLong);
}

// **BURST-03** - fifteen emissions inside one window rejected:
// built on one-second gaps, alternating kinds.
test burst_03_too_many_emissions_rejected {
    var records: [15]EmissionRecord;
    for i in 0..15 {
        var kind: EmissionKind = EmissionKind.Real;
        if (i % 2 == 1) {
            kind = EmissionKind.Cover;
        }
        records[i] = EmissionRecord { timestamp_ms: @as(u64, i) * 1000, kind: kind, };
    }
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.TooManyEmissions);
}

// **BURST-04** - a fifteen-hundred-millisecond gap rejected: off
// every canonical rung.
test burst_04_non_canonical_gap_rejected {
    const records: [2]EmissionRecord = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 1500, kind: EmissionKind.Cover, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.NonCanonicalGap);
}

// **BURST-05** - three real emissions in a window rejected: no
// covers at all.
test burst_05_cover_ratio_too_low_rejected {
    const records: [3]EmissionRecord = [3]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 5000, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 10000, kind: EmissionKind.Real, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.CoverRatioTooLow);
}

// **BURST-06** - a single record accepted without any check.
test burst_06_single_record_accepted {
    const records: [1]EmissionRecord = [1]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.Ok);
}

// **BURST-07** - an empty record set accepted.
test burst_07_empty_records_accepted {
    const records: [0]EmissionRecord = [0]EmissionRecord{};
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.Ok);
}

// **BURST-08** - the valid alternating pattern accepted: covers
// and reals on five-second gaps, every window holding at least a
// third of covers.
test burst_08_valid_alternating_accepted {
    const records: [4]EmissionRecord = [4]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Cover, },
        EmissionRecord { timestamp_ms: 5000, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 10000, kind: EmissionKind.Cover, },
        EmissionRecord { timestamp_ms: 15000, kind: EmissionKind.Real, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.Ok);
}

// **BURST-09** - the top canonical rung accepted: a gap of
// exactly three hundred seconds.
test burst_09_largest_canonical_gap_accepted {
    const records: [2]EmissionRecord = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 300000, kind: EmissionKind.Cover, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.Ok);
}

// **BURST-10** - the exact minimum gap accepted: one second.
test burst_10_exact_min_gap_accepted {
    const records: [2]EmissionRecord = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Cover, },
        EmissionRecord { timestamp_ms: 1000, kind: EmissionKind.Real, },
    };
    const v = validate_burst_pattern(&records);
    assert(v.code == BurstCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test is_canonical_gap_answers {
    assert(is_canonical_gap(1000));
    assert(is_canonical_gap(5000));
    assert(is_canonical_gap(30000));
    assert(is_canonical_gap(300000));
    assert(is_canonical_gap(400000));
    assert(!is_canonical_gap(999));
    assert(!is_canonical_gap(1500));
    assert(!is_canonical_gap(0));
}

// Rule order is the original's: the gap floor before the
// canonical membership, the canonical membership before the
// silence ceiling, and inside a window the emission ceiling
// before the cover-ratio floor.
test rule_order_matches_original {
    const tight = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 500, kind: EmissionKind.Cover, },
    };
    const v1 = validate_burst_pattern(&tight);
    assert(v1.code == BurstCode.GapBelowMinimum);

    const off_rung = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 1500, kind: EmissionKind.Cover, },
    };
    const v2 = validate_burst_pattern(&off_rung);
    assert(v2.code == BurstCode.NonCanonicalGap);

    const over_top = [2]EmissionRecord{
        EmissionRecord { timestamp_ms: 0, kind: EmissionKind.Real, },
        EmissionRecord { timestamp_ms: 350000, kind: EmissionKind.Cover, },
    };
    const v3 = validate_burst_pattern(&over_top);
    assert(v3.code == BurstCode.SilenceTooLong);

    var crowded: [15]EmissionRecord;
    for i in 0..15 {
        crowded[i] = EmissionRecord { timestamp_ms: @as(u64, i) * 1000, kind: EmissionKind.Real, };
    }
    const v4 = validate_burst_pattern(&crowded);
    assert(v4.code == BurstCode.TooManyEmissions);
}
