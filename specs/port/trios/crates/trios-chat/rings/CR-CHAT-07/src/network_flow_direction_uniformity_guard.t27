module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::network_flow_direction_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/network_flow_direction_uniformity_guard.rs
// (CR-CHAT-07 - Network flow direction uniformity guard,
// Wave-95 Lane B, R-CHAT-10).
//
// A mesh node both sends and receives, and the mix must stay
// balanced: mostly-outbound marks a producer, mostly-inbound a
// consumer, and the in/out ratio fingerprints the node. The
// rules, in the original's order: the batch ceiling, the
// strictly-increasing timestamps, then - over a non-empty
// batch - the inbound floor (ten), the outbound floor (ten)
// and the ratio ceiling (the larger over the smaller, ceiling
// three, the original's rounded integer division).
//
// The original returns Result<(), FlowError>. This port
// carries the verdict as a named struct (owner decision D5):
// Ok first, then the five variants in the original's
// declaration order - TooFewInbound, TooFewOutbound,
// RatioExceeded, TooManyObservations, TimestampsNotIncreasing
// - with every payload field: the count and min for the
// floors, the inbound and outbound counts for the ratio.
//
// The original's ratio is the rounded integer fold
// (larger * den + smaller - 1) / smaller - pure usize
// arithmetic and ports whole. The direction enum is the
// emission-kind form.

// Minimum observations per direction.
pub const NFDU_MIN_PER_DIRECTION: usize = 10;

// Maximum ratio between directions, numerator.
pub const NFDU_MAX_RATIO_NUM: usize = 3;

// Maximum ratio between directions, denominator.
pub const NFDU_MAX_RATIO_DEN: usize = 1;

// Maximum observations.
pub const NFDU_MAX_OBSERVATIONS: usize = 65536;

// Flow direction.
pub enum FlowDirection {
    Inbound,
    Outbound,
}

// A flow observation.
pub struct FlowObservation {
    direction: FlowDirection,
    timestamp_ms: u64,
}

// Verdict codes: Ok(()) and FlowError's variants, in declaration order.
pub enum FlowCode {
    Ok,
    TooFewInbound,
    TooFewOutbound,
    RatioExceeded,
    TooManyObservations,
    TimestampsNotIncreasing,
}

// The verdict of the flow uniformity validation, with every
// error payload field.
pub struct FlowVerdict {
    code: FlowCode,
    count: usize,
    bound: usize,
    inbound: usize,
    outbound: usize,
}

// The rounded ratio larger-over-smaller - the original's
// integer fold; a zero smaller answers the ceiling so callers
// never divide by zero.
pub fn rounded_ratio(larger: usize, smaller: usize) -> usize {
    if (smaller == 0) {
        return NFDU_MAX_RATIO_NUM + 1;
    }
    return (larger * NFDU_MAX_RATIO_DEN + smaller - 1) / smaller;
}

// [VERIFIED] Validate network flow direction uniformity.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the strictly-increasing
// timestamps, then over a non-empty batch the inbound floor,
// the outbound floor and the ratio ceiling.
pub fn validate_flow_uniformity(observations: []const FlowObservation) -> FlowVerdict {
    if (observations.len > NFDU_MAX_OBSERVATIONS) {
        return FlowVerdict { code: FlowCode.TooManyObservations, count: 0, bound: 0, inbound: 0, outbound: 0, };
    }
    if (observations.len > 1) {
        for i in 1..observations.len {
            if (observations[i].timestamp_ms <= observations[i - 1].timestamp_ms) {
                return FlowVerdict { code: FlowCode.TimestampsNotIncreasing, count: 0, bound: 0, inbound: 0, outbound: 0, };
            }
        }
    }
    if (observations.len == 0) {
        return FlowVerdict { code: FlowCode.Ok, count: 0, bound: 0, inbound: 0, outbound: 0, };
    }
    var inbound: usize = 0;
    for i in 0..observations.len {
        if (observations[i].direction == FlowDirection.Inbound) {
            inbound = inbound + 1;
        }
    }
    var outbound: usize = observations.len - inbound;
    if (inbound < NFDU_MIN_PER_DIRECTION) {
        return FlowVerdict { code: FlowCode.TooFewInbound, count: inbound, bound: NFDU_MIN_PER_DIRECTION, inbound: inbound, outbound: outbound, };
    }
    if (outbound < NFDU_MIN_PER_DIRECTION) {
        return FlowVerdict { code: FlowCode.TooFewOutbound, count: outbound, bound: NFDU_MIN_PER_DIRECTION, inbound: inbound, outbound: outbound, };
    }
    var larger: usize = inbound;
    var smaller: usize = outbound;
    if (outbound > inbound) {
        larger = outbound;
        smaller = inbound;
    }
    const ratio: usize = rounded_ratio(larger, smaller);
    if (ratio > NFDU_MAX_RATIO_NUM) {
        return FlowVerdict { code: FlowCode.RatioExceeded, count: 0, bound: 0, inbound: inbound, outbound: outbound, };
    }
    return FlowVerdict { code: FlowCode.Ok, count: 0, bound: 0, inbound: inbound, outbound: outbound, };
}

// The alternating fixture: fifteen inbound-outbound rounds,
// timestamps stepping by one from zero - the original's
// balanced_flow, entry by entry.
pub fn build_balanced(observations: []FlowObservation) -> void {
    for i in 0..15 {
        observations[2 * i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i) * 2, };
        observations[2 * i + 1] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: @as(u64, i) * 2 + 1, };
    }
}

// **NFDU-01** - too few inbound rejected: fifteen outbound and
// one inbound of a floor ten.
test nfdu_01_too_few_inbound_rejected {
    var obs_vec: [16]FlowObservation;
    for i in 0..15 {
        obs_vec[i] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: @as(u64, i) * 100, };
    }
    obs_vec[15] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: 1500, };
    const v = validate_flow_uniformity(&obs_vec);
    assert(v.code == FlowCode.TooFewInbound);
    assert(v.count == 1);
    assert(v.bound == 10);
}

// **NFDU02** - too few outbound rejected: fifteen inbound and
// one outbound.
test nfdu_02_too_few_outbound_rejected {
    var obs_vec: [16]FlowObservation;
    for i in 0..15 {
        obs_vec[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i) * 100, };
    }
    obs_vec[15] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 1500, };
    const v = validate_flow_uniformity(&obs_vec);
    assert(v.code == FlowCode.TooFewOutbound);
    assert(v.count == 1);
    assert(v.bound == 10);
}

// **NFDU-03** - the ratio ceiling rejected: fifty inbound
// against ten outbound - a ratio of five over the ceiling of
// three.
test nfdu_03_ratio_exceeded_rejected {
    var obs_vec: [60]FlowObservation;
    for i in 0..50 {
        obs_vec[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i) * 10, };
    }
    for j in 0..10 {
        obs_vec[50 + j] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 500 + @as(u64, j) * 10, };
    }
    const v = validate_flow_uniformity(&obs_vec);
    assert(v.code == FlowCode.RatioExceeded);
    assert(v.inbound == 50);
    assert(v.outbound == 10);
}

// **NFDU-04** - too many rejected: 65537 observations of a
// maximum 65536, built in a loop like the original's, the
// timestamps stepping by one. The batch rule fires before any
// observation is examined.
test nfdu_04_too_many_rejected {
    var obs_vec: [65537]FlowObservation;
    for i in 0..65537 {
        obs_vec[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i), };
    }
    const v = validate_flow_uniformity(&obs_vec);
    assert(v.code == FlowCode.TooManyObservations);
}

// **NFDU-05** - a non-increasing timestamp rejected: 100 after
// 200.
test nfdu_05_timestamps_rejected {
    const obs_vec: [2]FlowObservation = [2]FlowObservation{
        FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: 200, },
        FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 100, },
    };
    const v = validate_flow_uniformity(&obs_vec);
    assert(v.code == FlowCode.TimestampsNotIncreasing);
}

// **NFDU-06** - the balanced flow accepted: twenty
// inbound-outbound rounds, timestamps stepping by hundreds.
test nfdu_06_balanced_accepted {
    var flow: [40]FlowObservation;
    for i in 0..20 {
        const base: u64 = @as(u64, i) * 100;
        flow[2 * i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: base, };
        flow[2 * i + 1] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: base + 1, };
    }
    const v = validate_flow_uniformity(&flow);
    assert(v.code == FlowCode.Ok);
}

// **NFDU-07** - the original's balanced fixture accepted.
test nfdu_07_valid_accepted {
    var flow: [30]FlowObservation;
    build_balanced(&flow);
    const v = validate_flow_uniformity(&flow);
    assert(v.code == FlowCode.Ok);
}

// **NFDU-08** - an empty batch accepted.
test nfdu_08_empty_accepted {
    const flow: [0]FlowObservation = [0]FlowObservation{};
    const v = validate_flow_uniformity(&flow);
    assert(v.code == FlowCode.Ok);
}

// **NFDU-09** - the minimum boundary accepted: ten rounds,
// both counts exactly ten.
test nfdu_09_min_boundary_accepted {
    var flow: [20]FlowObservation;
    for i in 0..10 {
        const base: u64 = @as(u64, i) * 100;
        flow[2 * i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: base, };
        flow[2 * i + 1] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: base + 1, };
    }
    const v = validate_flow_uniformity(&flow);
    assert(v.code == FlowCode.Ok);
}

// **NFDU-10** - a two-to-one ratio accepted: twenty inbound
// against ten outbound, exactly under the ceiling of three.
test nfdu_10_ratio_2_1_accepted {
    var flow: [30]FlowObservation;
    for i in 0..20 {
        flow[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i) * 10, };
    }
    for j in 0..10 {
        flow[20 + j] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 200 + @as(u64, j) * 10, };
    }
    const v = validate_flow_uniformity(&flow);
    assert(v.code == FlowCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test rounded_ratio_answers {
    assert(rounded_ratio(10, 10) == 1);
    assert(rounded_ratio(20, 10) == 2);
    assert(rounded_ratio(21, 10) == 3);
    assert(rounded_ratio(30, 10) == 3);
    assert(rounded_ratio(31, 10) == 4);
    assert(rounded_ratio(50, 10) == 5);
    assert(rounded_ratio(10, 0) == 4);
}

// Rule order is the original's: the batch ceiling before
// anything, the timestamps before the counts, the inbound
// floor before the outbound floor, and the floors before the
// ratio ceiling.
test rule_order_matches_original {
    var flooded: [65537]FlowObservation;
    for i in 0..65537 {
        flooded[i] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 0, };
    }
    const v1 = validate_flow_uniformity(&flooded);
    assert(v1.code == FlowCode.TooManyObservations);

    const backstep_tiny: [2]FlowObservation = [2]FlowObservation{
        FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 200, },
        FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: 100, },
    };
    const v2 = validate_flow_uniformity(&backstep_tiny);
    assert(v2.code == FlowCode.TimestampsNotIncreasing);

    var tiny_inbound: [15]FlowObservation;
    for i in 0..15 {
        tiny_inbound[i] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: @as(u64, i), };
    }
    const v3 = validate_flow_uniformity(&tiny_inbound);
    assert(v3.code == FlowCode.TooFewInbound);
    assert(v3.count == 0);

    var tiny_outbound: [15]FlowObservation;
    for i in 0..15 {
        tiny_outbound[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i), };
    }
    const v4 = validate_flow_uniformity(&tiny_outbound);
    assert(v4.code == FlowCode.TooFewOutbound);
    assert(v4.count == 0);

    var lopsided: [50]FlowObservation;
    for i in 0..40 {
        lopsided[i] = FlowObservation { direction: FlowDirection.Inbound, timestamp_ms: @as(u64, i) * 10, };
    }
    for j in 0..10 {
        lopsided[40 + j] = FlowObservation { direction: FlowDirection.Outbound, timestamp_ms: 400 + @as(u64, j) * 10, };
    }
    const v5 = validate_flow_uniformity(&lopsided);
    assert(v5.code == FlowCode.RatioExceeded);
    assert(v5.inbound == 40);
    assert(v5.outbound == 10);
}
