module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::message_size_class_distribution_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/message_size_class_distribution_guard.rs
// (CR-CHAT-07 - Message size class distribution guard, Wave-99
// Lane A, R-CHAT-10).
//
// Messages pad to four size classes (256, 1024, 4096, 16384),
// and the wire must not read the mix: eighty percent of class
// 256 says chat texts with rare file transfers, the
// distribution fingerprints the user across sessions, and ML
// classifiers read message types straight off it. The rules,
// in the original's order: the batch ceiling, the observation
// floor (forty), then per observation the valid-class scan,
// then the presence of all four classes, then per class (in
// class order, the original's BTreeMap walk being sorted by
// key) the per-class floor (ten) and the dominance ceiling
// (three quarters of the total, the integer
// cross-multiplication against a truncated quarter).
//
// The original returns Result<(), SizeDistError>. This port
// carries the verdict as a named struct (owner decision D5):
// Ok first, then the six variants in the original's
// declaration order - UnderMinimum, DominantClass, TooFew,
// MissingClass, InvalidClass, TooMany - with every payload
// field: the class, its count and the minimum for
// UnderMinimum, the class, its count and the total for
// DominantClass, got and min for TooFew, the class for the
// missing and invalid rules (TooMany carries none).
//
// The original's BTreeMap count table and HashSet membership
// become scans over the fixed class ladder: a class's count
// is the per-observation count scan, its presence the same
// scan against zero, the per-class walk runs in ladder order
// exactly as the sorted-key BTreeMap iteration does. The
// too-many fixture builds its million-and-one observations in
// a loop; every record is the minimal observation and the
// batch rule fires before any record is examined.

// Minimum observations per class.
pub const MSCD_MIN_PER_CLASS: usize = 10;

// Maximum ratio numerator for any single class.
pub const MSCD_MAX_RATIO_NUM: usize = 3;

// Maximum ratio denominator.
pub const MSCD_MAX_RATIO_DEN: usize = 4;

// Minimum total observations.
pub const MSCD_MIN_OBSERVATIONS: usize = 40;

// Maximum observations.
pub const MSCD_MAX_OBSERVATIONS: usize = 1000000;

// Valid size classes.
pub const MSCD_CLASSES: [4]usize = [4]usize{256, 1024, 4096, 16384,};

// A size class observation.
pub struct SizeObservation {
    size: usize,
}

// Verdict codes: Ok(()) and SizeDistError's variants, in declaration order.
pub enum SizeDistCode {
    Ok,
    UnderMinimum,
    DominantClass,
    TooFew,
    MissingClass,
    InvalidClass,
    TooMany,
}

// The verdict of the size distribution validation, with every
// error payload field.
pub struct SizeDistVerdict {
    code: SizeDistCode,
    class: usize,
    count: usize,
    bound: usize,
}

// Whether the size is one of the four valid classes - the
// original's HashSet membership, answered by a scan.
pub fn is_valid_class(size: usize) -> bool {
    for c in MSCD_CLASSES {
        if (c == size) {
            return true;
        }
    }
    return false;
}

// How many observations carry this class - the original's
// BTreeMap count, answered by a scan.
pub fn class_count(observations: []const SizeObservation, size: usize) -> usize {
    var count: usize = 0;
    for i in 0..observations.len {
        if (observations[i].size == size) {
            count = count + 1;
        }
    }
    return count;
}

// [VERIFIED] Validate message size class distribution. Returns
// Ok only when every rule holds, checked in the original's
// order: the batch ceiling, the observation floor, then per
// observation the valid class, then the presence of all four
// classes, then per class in ladder order the per-class floor
// and the dominance ceiling.
pub fn validate_size_distribution(observations: []const SizeObservation) -> SizeDistVerdict {
    if (observations.len > MSCD_MAX_OBSERVATIONS) {
        return SizeDistVerdict { code: SizeDistCode.TooMany, class: 0, count: 0, bound: 0, };
    }
    if (observations.len < MSCD_MIN_OBSERVATIONS) {
        return SizeDistVerdict { code: SizeDistCode.TooFew, class: 0, count: 0, bound: MSCD_MIN_OBSERVATIONS, };
    }
    for i in 0..observations.len {
        if (!is_valid_class(observations[i].size)) {
            return SizeDistVerdict { code: SizeDistCode.InvalidClass, class: observations[i].size, count: 0, bound: 0, };
        }
    }
    for c in MSCD_CLASSES {
        if (class_count(observations, c) == 0) {
            return SizeDistVerdict { code: SizeDistCode.MissingClass, class: c, count: 0, bound: 0, };
        }
    }
    const total: usize = observations.len;
    const threshold: usize = total / MSCD_MAX_RATIO_DEN;
    for c in MSCD_CLASSES {
        const count: usize = class_count(observations, c);
        if (count < MSCD_MIN_PER_CLASS) {
            return SizeDistVerdict { code: SizeDistCode.UnderMinimum, class: c, count: count, bound: MSCD_MIN_PER_CLASS, };
        }
        if (count > threshold * MSCD_MAX_RATIO_NUM) {
            return SizeDistVerdict { code: SizeDistCode.DominantClass, class: c, count: count, bound: total, };
        }
    }
    return SizeDistVerdict { code: SizeDistCode.Ok, class: 0, count: 0, bound: 0, };
}

// The class walks of the loop fixtures, precomputed: the
// balanced batch of fifteen rounds over the four classes, and
// the equal batch of twenty.
pub const MSCD_SEQ_BALANCED: [60]usize = [60]usize{256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384, 256, 1024, 4096, 16384};

// **MSCD-01** - a class under the minimum rejected: three of
// class 256 against the floor of ten (forty-eight others
// spread evenly, the small class answering first in ladder
// order).
test mscd_01_under_minimum_rejected {
    var v: [48]SizeObservation;
    var slot: usize = 0;
    var i: usize = 0;
    while (i < 3) {
        v[slot] = SizeObservation { size: 256, };
        slot = slot + 1;
        i = i + 1;
    }
    i = 0;
    while (i < 15) {
        v[slot] = SizeObservation { size: 1024, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 4096, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 16384, };
        slot = slot + 1;
        i = i + 1;
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.UnderMinimum);
    assert(verdict.class == 256);
    assert(verdict.count == 3);
    assert(verdict.bound == 10);
}

// **MSCD-02** - a dominant class rejected: one hundred of
// class 256 against thirty others - one hundred of a
// truncated quarter of thirty-two, over the three-quarters
// ceiling.
test mscd_02_dominant_rejected {
    var v: [130]SizeObservation;
    var slot: usize = 0;
    var i: usize = 0;
    while (i < 100) {
        v[slot] = SizeObservation { size: 256, };
        slot = slot + 1;
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        v[slot] = SizeObservation { size: 1024, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 4096, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 16384, };
        slot = slot + 1;
        i = i + 1;
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.DominantClass);
    assert(verdict.class == 256);
    assert(verdict.count == 100);
    assert(verdict.bound == 130);
}

// **MSCD-03** - too few rejected: four observations of a
// required forty.
test mscd_03_too_few_rejected {
    const v: [4]SizeObservation = [4]SizeObservation{
        SizeObservation { size: 256, },
        SizeObservation { size: 1024, },
        SizeObservation { size: 4096, },
        SizeObservation { size: 16384, },
    };
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.TooFew);
    assert(verdict.bound == 40);
}

// **MSCD-04** - a missing class rejected: the three smaller
// classes present, 16384 absent.
test mscd_04_missing_rejected {
    var v: [45]SizeObservation;
    var slot: usize = 0;
    var i: usize = 0;
    while (i < 15) {
        v[slot] = SizeObservation { size: 256, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 1024, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 4096, };
        slot = slot + 1;
        i = i + 1;
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.MissingClass);
    assert(verdict.class == 16384);
}

// **MSCD-05** - an invalid class rejected: 999 appended to the
// balanced batch.
test mscd_05_invalid_rejected {
    var v: [61]SizeObservation;
    for i in 0..60 {
        v[i] = SizeObservation { size: MSCD_SEQ_BALANCED[i], };
    }
    v[60] = SizeObservation { size: 999, };
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.InvalidClass);
    assert(verdict.class == 999);
}

// **MSCD-06** - too many rejected: 1000001 observations of a
// maximum million, built in a loop like the original's, the
// classes cycling the ladder. The batch rule fires before any
// observation is examined.
test mscd_06_too_many_rejected {
    var v: [1000001]SizeObservation;
    for i in 0..1000001 {
        v[i] = SizeObservation { size: MSCD_CLASSES[i % 4], };
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.TooMany);
}

// **MSCD-07** - the balanced batch accepted: fifteen rounds
// over the four classes.
test mscd_07_balanced_accepted {
    var v: [60]SizeObservation;
    for i in 0..60 {
        v[i] = SizeObservation { size: MSCD_SEQ_BALANCED[i], };
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.Ok);
}

// **MSCD-08** - the minimum boundary accepted: ten rounds over
// the four classes, every count exactly ten.
test mscd_08_min_boundary_accepted {
    var v: [40]SizeObservation;
    for i in 0..40 {
        v[i] = SizeObservation { size: MSCD_CLASSES[i % 4], };
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.Ok);
}

// **MSCD-09** - a slight imbalance accepted: twenty of class
// 256, twelve of each of the others - fifty-six total, the
// truncated quarter at fourteen, twenty under the
// three-quarters ceiling of forty-two.
test mscd_09_slightly_imbalanced_accepted {
    var v: [56]SizeObservation;
    var slot: usize = 0;
    var i: usize = 0;
    while (i < 20) {
        v[slot] = SizeObservation { size: 256, };
        slot = slot + 1;
        i = i + 1;
    }
    i = 0;
    while (i < 12) {
        v[slot] = SizeObservation { size: 1024, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 4096, };
        slot = slot + 1;
        v[slot] = SizeObservation { size: 16384, };
        slot = slot + 1;
        i = i + 1;
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.Ok);
}

// **MSCD-10** - the equal batch accepted: twenty rounds over
// the four classes.
test mscd_10_equal_accepted {
    var v: [80]SizeObservation;
    for i in 0..80 {
        v[i] = SizeObservation { size: MSCD_CLASSES[i % 4], };
    }
    const verdict = validate_size_distribution(&v);
    assert(verdict.code == SizeDistCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test mscd_helpers_answer {
    assert(is_valid_class(256));
    assert(is_valid_class(1024));
    assert(is_valid_class(4096));
    assert(is_valid_class(16384));
    assert(!is_valid_class(999));
    assert(!is_valid_class(0));
    const v: [4]SizeObservation = [4]SizeObservation{
        SizeObservation { size: 256, },
        SizeObservation { size: 256, },
        SizeObservation { size: 1024, },
        SizeObservation { size: 4096, },
    };
    assert(class_count(&v, 256) == 2);
    assert(class_count(&v, 1024) == 1);
    assert(class_count(&v, 16384) == 0);
}

// Rule order is the original's: the observation floor before
// any record, the valid-class scan before the presence scan,
// the presence scan before the per-class floors, and the
// per-class floor before the dominance ceiling - with the
// smallest class answering first in ladder order.
test rule_order_matches_original {
    var short_bad: [3]SizeObservation;
    short_bad[0] = SizeObservation { size: 999, };
    short_bad[1] = SizeObservation { size: 999, };
    short_bad[2] = SizeObservation { size: 999, };
    const v1 = validate_size_distribution(&short_bad);
    assert(v1.code == SizeDistCode.TooFew);

    var bad_then_missing: [40]SizeObservation;
    for i in 0..40 {
        var size: usize = MSCD_CLASSES[i % 4];
        if (i == 39) {
            size = 999;
        }
        bad_then_missing[i] = SizeObservation { size: size, };
    }
    const v2 = validate_size_distribution(&bad_then_missing);
    assert(v2.code == SizeDistCode.InvalidClass);
    assert(v2.class == 999);

    var sparse: [40]SizeObservation;
    for i in 0..40 {
        var size: usize = MSCD_CLASSES[i % 3];
        sparse[i] = SizeObservation { size: size, };
    }
    const v3 = validate_size_distribution(&sparse);
    assert(v3.code == SizeDistCode.MissingClass);
    assert(v3.class == 16384);

    var thin_dominant: [40]SizeObservation;
    for i in 0..40 {
        var size: usize = MSCD_CLASSES[i % 4];
        if (i < 10) {
            size = 256;
        }
        thin_dominant[i] = SizeObservation { size: size, };
    }
    const v4 = validate_size_distribution(&thin_dominant);
    assert(v4.code == SizeDistCode.UnderMinimum);
    assert(v4.class == 1024);
    assert(v4.count == 7);
}
