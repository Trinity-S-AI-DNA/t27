module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::egress_fingerprint;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/egress_fingerprint.rs
// (CR-CHAT-07 - Tailscale-funnel egress fingerprinting guard,
// Wave-15 Lane B, L-CHAT-7-funnel, R-CHAT-10).
//
// The cover scheduler hides per-envelope timing and the gap
// quantiser hides pacing; this module hides the wire
// fingerprint of the outermost transport - the TLS class, the
// flow length and the inter-burst gap. Every egress flow must
// present the one locked TLS class (version 0x0303, ALPN h2,
// cipher TLS_AES_128_GCM_SHA256), a length binned to the
// canonical classes, and a burst gap binned to the canonical
// gaps - so any two flows in the same bins are
// indistinguishable and the raw values never reach the wire.
//
// The original returns Result<Self, Error> with the invariant
// message "egress_fingerprint_tls_class". This port carries the
// verdict as a named struct (owner decision D5): Ok first,
// then the single rejection - NonCanonicalTls - plus the
// normalised fingerprint fields every accept delivers: the
// quantised length class and the quantised burst class (the
// TLS class is the locked constant on every accept).
//
// The original's single-value enums AlpnId and CipherId each
// carry one canonical variant; the port keeps them as enums
// with that one variant, and the class comparison reads the
// fields directly. The binning folds scan the class arrays
// with the largest-fitting choice; below the smallest class
// the smallest still answers, exactly the original's rule.

// Canonical TLS record-layer version (RFC 8446).
pub const EFP_TLS_VERSION: u16 = 771;

// Canonical egress length classes (bytes).
pub const EFP_LENGTH_CLASSES: [4]u32 = [4]u32{1024, 4096, 16384, 65536,};

// Canonical burst-gap classes (ms).
pub const EFP_BURST_GAPS_MS: [4]u64 = [4]u64{50, 250, 1000, 5000,};

// ALPN id - one canonical value.
pub enum AlpnId {
    H2,
}

// Cipher-suite id - one canonical value.
pub enum CipherId {
    Aes128GcmSha256,
}

// Canonical TLS class.
pub struct TlsClass {
    version: u16,
    alpn: AlpnId,
    cipher: CipherId,
}

// Raw observables (per-flow, per-burst).
pub struct EgressObservables {
    version: u16,
    alpn: AlpnId,
    cipher: CipherId,
    bytes: u32,
    gap_ms: u64,
}

// Verdict codes: Ok and the single invariant rejection.
pub enum EfpCode {
    Ok,
    NonCanonicalTls,
}

// The verdict of the normalisation: the code, and on accept
// the normalised fingerprint's two quantised axes (the TLS
// class is the locked constant).
pub struct EfpVerdict {
    code: EfpCode,
    length_class: u32,
    burst_class: u64,
}

// The one canonical TLS class.
pub const CANONICAL_TLS: TlsClass = TlsClass { version: 771, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, };

// Whole-class equality over the one ALPN variant.
pub fn alpn_equal(a: AlpnId, b: AlpnId) -> bool {
    return true;
}

// Whole-class equality over the one cipher variant.
pub fn cipher_equal(a: CipherId, b: CipherId) -> bool {
    return true;
}

// Whole-class equality over the TLS triple.
pub fn tls_equal(a: TlsClass, b: TlsClass) -> bool {
    if (a.version != b.version) {
        return false;
    }
    if (!alpn_equal(a.alpn, b.alpn)) {
        return false;
    }
    if (!cipher_equal(a.cipher, b.cipher)) {
        return false;
    }
    return true;
}

// Quantise raw flow bytes into the largest canonical class the
// bytes reach; below the smallest class the smallest answers -
// the original's uniform_length_class.
pub fn uniform_length_class(bytes: u32) -> u32 {
    var chosen: u32 = EFP_LENGTH_CLASSES[0];
    for c in EFP_LENGTH_CLASSES {
        if (bytes >= c) {
            chosen = c;
        }
    }
    return chosen;
}

// Quantise a measured inter-burst gap into the largest
// canonical gap it reaches; below the smallest gap the smallest
// answers - the original's uniform_burst_ms.
pub fn uniform_burst_ms(measured_ms: u64) -> u64 {
    var chosen: u64 = EFP_BURST_GAPS_MS[0];
    for g in EFP_BURST_GAPS_MS {
        if (measured_ms >= g) {
            chosen = g;
        }
    }
    return chosen;
}

// [VERIFIED] Bin raw observables into the canonical
// fingerprint and verify the TLS class is the locked one. On
// accept the verdict carries the quantised length and burst
// classes; on rejection the TLS class check has answered and
// the classes stay zero.
pub fn normalise(obs: EgressObservables) -> EfpVerdict {
    const tls: TlsClass = TlsClass { version: obs.version, alpn: obs.alpn, cipher: obs.cipher, };
    if (!tls_equal(tls, CANONICAL_TLS)) {
        return EfpVerdict { code: EfpCode.NonCanonicalTls, length_class: 0, burst_class: 0, };
    }
    return EfpVerdict { code: EfpCode.Ok, length_class: uniform_length_class(obs.bytes), burst_class: uniform_burst_ms(obs.gap_ms), };
}

// The observables fixture: the canonical class at any length
// and gap.
pub fn obs(bytes: u32, gap_ms: u64) -> EgressObservables {
    return EgressObservables { version: 771, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, bytes: bytes, gap_ms: gap_ms, };
}

// **EFP-01** - a flow presenting the canonical class
// normalises clean.
test efp_01_canonical_tls_class_accepted {
    const f = normalise(obs(2048, 300));
    assert(f.code == EfpCode.Ok);
    assert(f.length_class == 1024);
    assert(f.burst_class == 250);
}

// **EFP-02** - a deviant version rejects; ALPN and cipher
// carry the single canonical variant, so the version axis is
// the only mutable one, exactly as the original's enum design
// locks the other two.
test efp_02_non_canonical_tls_class_rejected {
    const o = EgressObservables { version: 772, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, bytes: 2048, gap_ms: 300, };
    const f = normalise(o);
    assert(f.code == EfpCode.NonCanonicalTls);
}

// **EFP-03** - length binning: every answer is a canonical
// class, and the boundaries answer exactly.
test efp_03_length_quantises_to_canonical_set {
    assert(uniform_length_class(0) == 1024);
    assert(uniform_length_class(1) == 1024);
    assert(uniform_length_class(1023) == 1024);
    assert(uniform_length_class(1024) == 1024);
    assert(uniform_length_class(4095) == 1024);
    assert(uniform_length_class(4096) == 4096);
    assert(uniform_length_class(16383) == 4096);
    assert(uniform_length_class(16384) == 16384);
    assert(uniform_length_class(65535) == 16384);
    assert(uniform_length_class(65536) == 65536);
    assert(uniform_length_class(70000) == 65536);
    assert(uniform_length_class(4294967295) == 65536);
}

// **EFP-04** - burst-gap binning: every answer is a canonical
// gap, and the boundaries answer exactly.
test efp_04_burst_gap_quantises_to_canonical_set {
    assert(uniform_burst_ms(0) == 50);
    assert(uniform_burst_ms(1) == 50);
    assert(uniform_burst_ms(49) == 50);
    assert(uniform_burst_ms(50) == 50);
    assert(uniform_burst_ms(249) == 50);
    assert(uniform_burst_ms(250) == 250);
    assert(uniform_burst_ms(999) == 250);
    assert(uniform_burst_ms(1000) == 1000);
    assert(uniform_burst_ms(4999) == 1000);
    assert(uniform_burst_ms(5000) == 5000);
    assert(uniform_burst_ms(10000) == 5000);
    assert(uniform_burst_ms(18446744073709551615) == 5000);
}

// **EFP-05** - two flows in the same bins produce equal
// fingerprints - unlinkability across egress flows.
test efp_05_same_bins_equal_fingerprint {
    const f1 = normalise(obs(2000, 300));
    const f2 = normalise(obs(3500, 600));
    assert(f1.code == EfpCode.Ok);
    assert(f2.code == EfpCode.Ok);
    assert(f1.length_class == f2.length_class);
    assert(f1.burst_class == f2.burst_class);
    assert(f1.length_class == 1024);
    assert(f1.burst_class == 250);
}

// **EFP-06** - cross-bin flows differ only along the canonical
// axes: the raw values never reach the fingerprint.
test efp_06_cross_bin_flows_canonical_axes_only {
    const f_small_fast = normalise(obs(2000, 100));
    const f_large_slow = normalise(obs(20000, 6000));
    assert(f_small_fast.code == EfpCode.Ok);
    assert(f_large_slow.code == EfpCode.Ok);
    assert(f_small_fast.length_class != f_large_slow.length_class);
    assert(f_small_fast.burst_class != f_large_slow.burst_class);
    assert(f_small_fast.length_class == 1024);
    assert(f_small_fast.burst_class == 50);
    assert(f_large_slow.length_class == 16384);
    assert(f_large_slow.burst_class == 5000);
}

// The helpers have direct tests (coverage: Untested 0).
test efp_helpers_answer {
    assert(alpn_equal(AlpnId.H2, AlpnId.H2));
    assert(cipher_equal(CipherId.Aes128GcmSha256, CipherId.Aes128GcmSha256));
    const canon: TlsClass = TlsClass { version: 771, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, };
    assert(tls_equal(canon, CANONICAL_TLS));
    const deviant: TlsClass = TlsClass { version: 772, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, };
    assert(!tls_equal(deviant, CANONICAL_TLS));
}

// Rule order is the original's: the TLS class check answers
// before any binning - a deviant flow never gets quantised.
test rule_order_matches_original {
    const deviant = normalise(EgressObservables { version: 772, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, bytes: 70000, gap_ms: 10000, });
    assert(deviant.code == EfpCode.NonCanonicalTls);
    assert(deviant.length_class == 0);
    assert(deviant.burst_class == 0);

    const canonical = normalise(EgressObservables { version: 771, alpn: AlpnId.H2, cipher: CipherId.Aes128GcmSha256, bytes: 70000, gap_ms: 10000, });
    assert(canonical.code == EfpCode.Ok);
    assert(canonical.length_class == 65536);
    assert(canonical.burst_class == 5000);
}
