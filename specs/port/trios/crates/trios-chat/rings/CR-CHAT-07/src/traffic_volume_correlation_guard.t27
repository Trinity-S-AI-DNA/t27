module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::traffic_volume_correlation_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/traffic_volume_correlation_guard.rs
// (CR-CHAT-07 - Traffic volume correlation guard, Wave-58
// Lane A, R-CHAT-10).
//
// An attacker watching wire volume per unit of time reads an
// active user off an idle one whenever the active user sends
// more; the defense holds the real-plus-cover volume of every
// window near a constant. The rules, in the original's order:
// the window ceiling (one hundred twenty-eight), the emission
// floor (four), then per emission the zero probe, the
// single-emission ceiling (sixteen thousand three hundred
// eighty-four) and the narrow volume band (seven hundred
// sixty-eight to twelve hundred eighty around the expected
// thousand twenty-four, the original's saturating low bound
// never saturating at these constants), and finally the
// standard-deviation ceiling over the window.
//
// The original returns Result<(), VolumeCorrelationError>.
// This port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order - TooFewEmissions,
// WindowTooLarge, ZeroVolume, SingleTooLarge, VolumeOutOfRange,
// VarianceTooHigh. Every original variant carries no payload,
// so the code is the whole verdict.
//
// The original's standard-deviation ceiling is float
// arithmetic - the f64 mean, the f64 variance, the sqrt,
// against 256 * 0.9. t27 has no int-to-float cast, so the
// check is re-based to the exact rational form in pure u64:
// with S the volume sum, n the window length and W the fold
// of squared deviations |v*n - S| squared, the variance is
// W/n^3 exactly, and the ceiling fires exactly when
// 25*W > 1327104*n^3 - because (256*0.9)^2 is 1327104/25.
// The f64 original rounds only within a band of relative
// width about 1e-16 around that boundary; no original test
// sits in the band (the accepted boundary fixture answers a
// standard deviation of one hundred eighty-one, the rejected
// one two hundred fifty-six, against the cut of two hundred
// thirty point four).

// Minimum emissions per window.
pub const TVCG_MIN_EMISSIONS: usize = 4;

// Maximum window size.
pub const TVCG_MAX_WINDOW: usize = 128;

// Maximum single emission size (bytes).
pub const TVCG_MAX_SINGLE: u64 = 16384;

// Expected volume per emission (bytes).
pub const TVCG_EXPECTED_PER_EMISSION: u64 = 1024;

// Allowed deviation from expected (bytes).
pub const TVCG_DEVIATION: u64 = 256;

// The narrow volume band: the original's
// expected-minus-deviation low bound (its saturating
// subtraction never saturates at these constants) and the
// expected-plus-deviation high bound.
pub const TVCG_VOLUME_LO: u64 = 768;
pub const TVCG_VOLUME_HI: u64 = 1280;

// The exact-rational standard-deviation ceiling: the squared
// cut scaled by twenty-five - (256*0.9)^2 = 1327104/25.
pub const TVCG_VAR_CUT_NUM: u64 = 1327104;
pub const TVCG_VAR_CUT_SCALE: u64 = 25;

// Verdict codes: Ok(()) and VolumeCorrelationError's variants, in declaration order.
pub enum TvcgCode {
    Ok,
    TooFewEmissions,
    WindowTooLarge,
    ZeroVolume,
    SingleTooLarge,
    VolumeOutOfRange,
    VarianceTooHigh,
}

// The verdict of the volume correlation validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct TvcgVerdict {
    code: TvcgCode,
}

// [VERIFIED] Validate traffic volume over a window for
// correlation resistance. Returns Ok only when every rule
// holds, checked in the original's order: the window
// ceiling, the emission floor, the per-emission probes, then
// the standard-deviation ceiling in its exact rational form.
pub fn validate_volume_correlation(volumes: []const u64) -> TvcgVerdict {
    if (volumes.len > TVCG_MAX_WINDOW) {
        return TvcgVerdict { code: TvcgCode.WindowTooLarge, };
    }
    if (volumes.len < TVCG_MIN_EMISSIONS) {
        return TvcgVerdict { code: TvcgCode.TooFewEmissions, };
    }
    for i in 0..volumes.len {
        if (volumes[i] == 0) {
            return TvcgVerdict { code: TvcgCode.ZeroVolume, };
        }
        if (volumes[i] > TVCG_MAX_SINGLE) {
            return TvcgVerdict { code: TvcgCode.SingleTooLarge, };
        }
        if (volumes[i] < TVCG_VOLUME_LO) {
            return TvcgVerdict { code: TvcgCode.VolumeOutOfRange, };
        }
        if (volumes[i] > TVCG_VOLUME_HI) {
            return TvcgVerdict { code: TvcgCode.VolumeOutOfRange, };
        }
    }
    const n: u64 = @as(u64, volumes.len);
    var sum: u64 = 0;
    for i in 0..volumes.len {
        sum = sum + volumes[i];
    }
    var w: u64 = 0;
    for i in 0..volumes.len {
        var term: u64 = 0;
        if (volumes[i] * n > sum) {
            term = volumes[i] * n - sum;
        } else {
            term = sum - volumes[i] * n;
        }
        w = w + term * term;
    }
    if (TVCG_VAR_CUT_SCALE * w > TVCG_VAR_CUT_NUM * n * n * n) {
        return TvcgVerdict { code: TvcgCode.VarianceTooHigh, };
    }
    return TvcgVerdict { code: TvcgCode.Ok, };
}

// **TVCG-01** - too few emissions rejected: three of a floor
// of four.
test tvcg_01_too_few_rejected {
    const volumes: [3]u64 = [3]u64{1024, 1024, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.TooFewEmissions);
}

// **TVCG-02** - the window too large rejected: one hundred
// twenty-nine of a ceiling of one hundred twenty-eight,
// built in a loop like the original's; the window rule fires
// before any volume is examined.
test tvcg_02_window_large_rejected {
    var volumes: [129]u64;
    for i in 0..129 {
        volumes[i] = 1024;
    }
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.WindowTooLarge);
}

// **TVCG-03** - the zero volume rejected.
test tvcg_03_zero_rejected {
    const volumes: [4]u64 = [4]u64{0, 1024, 1024, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.ZeroVolume);
}

// **TVCG-04** - the single emission too large rejected: one
// byte over the ceiling.
test tvcg_04_single_large_rejected {
    const volumes: [4]u64 = [4]u64{16385, 1024, 1024, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.SingleTooLarge);
}

// **TVCG-05** - the volume out of the band rejected: one
// hundred bytes under the low bound.
test tvcg_05_out_of_range_rejected {
    const volumes: [4]u64 = [4]u64{100, 1024, 1024, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.VolumeOutOfRange);
}

// **TVCG-06** - the variance too high rejected: the band
// edges alternating, a standard deviation of two hundred
// fifty-six over the cut of two hundred thirty point four.
test tvcg_06_variance_high_rejected {
    const volumes: [8]u64 = [8]u64{768, 1280, 768, 1280, 768, 1280, 768, 1280,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.VarianceTooHigh);
}

// **TVCG-07** - the uniform window accepted: eight emissions
// of exactly the expected volume.
test tvcg_07_uniform_accepted {
    const volumes: [8]u64 = [8]u64{1024, 1024, 1024, 1024, 1024, 1024, 1024, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.Ok);
}

// **TVCG-08** - the slight variation accepted: ten bytes
// around the expected volume.
test tvcg_08_slight_var_accepted {
    const volumes: [4]u64 = [4]u64{1014, 1034, 1014, 1034,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.Ok);
}

// **TVCG-09** - the exact band boundary accepted: the edges
// and the center, a standard deviation of one hundred
// eighty-one under the cut.
test tvcg_09_boundary_accepted {
    const volumes: [4]u64 = [4]u64{768, 1024, 1280, 1024,};
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.Ok);
}

// **TVCG-10** - the maximum window accepted: one hundred
// twenty-eight uniform emissions.
test tvcg_10_large_accepted {
    var volumes: [128]u64;
    for i in 0..128 {
        volumes[i] = 1024;
    }
    const v = validate_volume_correlation(&volumes);
    assert(v.code == TvcgCode.Ok);
}

// Rule order is the original's: the window ceiling answers
// before the per-emission probes - a flooded window of zero
// volumes answers WindowTooLarge, not ZeroVolume - the
// per-emission probes answer in the original's order on one
// emission - zero over the band, the single ceiling over the
// band - and the per-emission probes answer before the
// variance ceiling is ever read.
test rule_order_matches_original {
    var flooded: [129]u64;
    for i in 0..129 {
        flooded[i] = 0;
    }
    const v1 = validate_volume_correlation(&flooded);
    assert(v1.code == TvcgCode.WindowTooLarge);

    const all_zero: [4]u64 = [4]u64{0, 0, 0, 0,};
    const v2 = validate_volume_correlation(&all_zero);
    assert(v2.code == TvcgCode.ZeroVolume);

    const all_huge: [4]u64 = [4]u64{16385, 16385, 16385, 16385,};
    const v3 = validate_volume_correlation(&all_huge);
    assert(v3.code == TvcgCode.SingleTooLarge);

    const all_low: [4]u64 = [4]u64{100, 100, 100, 100,};
    const v4 = validate_volume_correlation(&all_low);
    assert(v4.code == TvcgCode.VolumeOutOfRange);
}
