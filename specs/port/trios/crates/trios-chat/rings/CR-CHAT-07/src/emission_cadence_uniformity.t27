module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::emission_cadence_uniformity;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/emission_cadence_uniformity.rs
// (CR-CHAT-07 - Emission cadence uniformity guard, Wave-45
// Lane A, R-CHAT-10).
//
// The cadence - the ratio of real to cover emissions over a
// window - must stay in a narrow band: a chi-squared test on
// the interval distribution separates the two trains the
// moment it drifts. The rules, in the original's order: the
// window floor (two), the cover-fraction floor (a quarter,
// compared in percent by the original's integer division),
// the real-over-cover ceiling (never twice the covers), then
// per emission the consecutive-real ceiling (three) and the
// consecutive-cover ceiling (eight).
//
// The original returns Result<(), CadenceError> with seven
// variants carrying no payloads. This port carries the
// verdict as the code alone (owner decision D5): Ok first,
// then the variants in the original's declaration order -
// WindowTooSmall, CoverFractionTooLow, CoverFractionTooHigh,
// TooManyConsecutiveReal, TooManyConsecutiveCover,
// RealExceedsCoverRatio. CoverFractionTooHigh is declared and
// unreachable in the original too: no rule compares against
// the maximum cover fraction (an all-cover window passes),
// and the variant stays in the enum, declared and unreachable
// exactly as in the original.
//
// The original's percent fold is u64 integer arithmetic -
// counts times a hundred over the total, against the
// quarter's percent - and ports whole with the count widening
// by the int cast. The EmissionKind enum is the burst guard's
// kind, ported the same way.

// Minimum cover fraction, numerator.
pub const ECAD_MIN_COVER_FRAC_NUM: u64 = 1;

// Minimum cover fraction, denominator.
pub const ECAD_MIN_COVER_FRAC_DEN: u64 = 4;

// Maximum cover fraction, numerator.
pub const ECAD_MAX_COVER_FRAC_NUM: u64 = 2;

// Maximum cover fraction, denominator.
pub const ECAD_MAX_COVER_FRAC_DEN: u64 = 3;

// Maximum consecutive real emissions.
pub const ECAD_MAX_CONSECUTIVE_REAL: usize = 3;

// Maximum consecutive cover emissions.
pub const ECAD_MAX_CONSECUTIVE_COVER: usize = 8;

// Minimum window size.
pub const ECAD_MIN_WINDOW: usize = 2;

// Maximum window size.
pub const ECAD_MAX_WINDOW: usize = 100;

// Emission kind.
pub enum EmissionKind {
    Real,
    Cover,
}

// Verdict codes: Ok(()) and CadenceError's variants, in declaration order.
pub enum CadenceCode {
    Ok,
    WindowTooSmall,
    CoverFractionTooLow,
    CoverFractionTooHigh,
    TooManyConsecutiveReal,
    TooManyConsecutiveCover,
    RealExceedsCoverRatio,
}

// The verdict of the cadence validation. No variant of the
// original's error carries a payload, so the code is the
// whole verdict.
pub struct CadenceVerdict {
    code: CadenceCode,
}

// [VERIFIED] Validate emission cadence over a window. Returns
// Ok only when every rule holds, checked in the original's
// order: the window floor, the cover-fraction floor, the
// real-over-cover ceiling, then per emission the
// consecutive-real and consecutive-cover ceilings.
pub fn validate_emission_cadence(emissions: []const EmissionKind) -> CadenceVerdict {
    if (emissions.len < ECAD_MIN_WINDOW) {
        return CadenceVerdict { code: CadenceCode.WindowTooSmall, };
    }
    var covers: usize = 0;
    for i in 0..emissions.len {
        if (emissions[i] == EmissionKind.Cover) {
            covers = covers + 1;
        }
    }
    const total: usize = emissions.len;
    const covers64: u64 = @as(u64, covers);
    const total64: u64 = @as(u64, total);
    const cover_frac: u64 = covers64 * 100 / total64;
    const min_pct: u64 = ECAD_MIN_COVER_FRAC_NUM * 100 / ECAD_MIN_COVER_FRAC_DEN;
    if (cover_frac < min_pct) {
        return CadenceVerdict { code: CadenceCode.CoverFractionTooLow, };
    }
    const real_count: usize = total - covers;
    const real64: u64 = @as(u64, real_count);
    if (real64 > 2 * covers64) {
        return CadenceVerdict { code: CadenceCode.RealExceedsCoverRatio, };
    }
    var consec_real: usize = 0;
    var consec_cover: usize = 0;
    for i in 0..emissions.len {
        if (emissions[i] == EmissionKind.Real) {
            consec_real = consec_real + 1;
            consec_cover = 0;
            if (consec_real > ECAD_MAX_CONSECUTIVE_REAL) {
                return CadenceVerdict { code: CadenceCode.TooManyConsecutiveReal, };
            }
        } else {
            consec_cover = consec_cover + 1;
            consec_real = 0;
            if (consec_cover > ECAD_MAX_CONSECUTIVE_COVER) {
                return CadenceVerdict { code: CadenceCode.TooManyConsecutiveCover, };
            }
        }
    }
    return CadenceVerdict { code: CadenceCode.Ok, };
}

// The alternating fixture: cover on even slots, real on odd,
// built by a loop.
pub fn build_alternating(emissions: []EmissionKind, n: usize) -> void {
    for i in 0..n {
        if (i % 2 == 0) {
            emissions[i] = EmissionKind.Cover;
        } else {
            emissions[i] = EmissionKind.Real;
        }
    }
}

// **ECAD-01** - a one-emission window rejected: no cadence to
// read.
test ecad_01_window_too_small_rejected {
    const emissions: [1]EmissionKind = [1]EmissionKind{
        EmissionKind.Real,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.WindowTooSmall);
}

// **ECAD-02** - a cover fraction too low rejected: one cover
// of six - sixteen percent under the quarter.
test ecad_02_cover_fraction_low_rejected {
    const emissions: [6]EmissionKind = [6]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.CoverFractionTooLow);
}

// **ECAD-03** - too many consecutive reals rejected: four in
// a row over the ceiling of three.
test ecad_03_too_many_consecutive_real_rejected {
    const emissions: [6]EmissionKind = [6]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.TooManyConsecutiveReal);
}

// **ECAD-04** - too many consecutive covers rejected: nine in
// a row over the ceiling of eight.
test ecad_04_too_many_consecutive_cover_rejected {
    const emissions: [10]EmissionKind = [10]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.TooManyConsecutiveCover);
}

// **ECAD-05** - reals exceeding twice the covers rejected:
// five reals against two covers.
test ecad_05_real_exceeds_cover_ratio_rejected {
    const emissions: [7]EmissionKind = [7]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.RealExceedsCoverRatio);
}

// **ECAD-06** - the alternating pattern accepted: ten
// emissions alternating cover and real.
test ecad_06_alternating_accepted {
    var emissions: [10]EmissionKind;
    build_alternating(&emissions, 10);
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.Ok);
}

// **ECAD-07** - an all-cover window accepted: eight covers,
// exactly the consecutive ceiling - and the
// CoverFractionTooHigh rule the original declares is the one
// no code path reaches.
test ecad_07_all_cover_accepted {
    var emissions: [8]EmissionKind;
    for i in 0..8 {
        emissions[i] = EmissionKind.Cover;
    }
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.Ok);
}

// **ECAD-08** - the balanced window accepted: three reals,
// three covers, alternating from the real side.
test ecad_08_balanced_accepted {
    const emissions: [6]EmissionKind = [6]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.Ok);
}

// **ECAD-09** - the exact consecutive-real ceiling accepted:
// three in a row between covers.
test ecad_09_exact_max_consecutive_real_accepted {
    const emissions: [5]EmissionKind = [5]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.Ok);
}

// **ECAD-10** - a large alternating window accepted: fifty
// emissions.
test ecad_10_large_window_accepted {
    var emissions: [50]EmissionKind;
    build_alternating(&emissions, 50);
    const v = validate_emission_cadence(&emissions);
    assert(v.code == CadenceCode.Ok);
}

// Rule order is the original's: the window floor before any
// count, the cover-fraction floor before the real-over-cover
// ceiling, the ratio ceiling before the consecutive scans,
// and the consecutive-real scan before the consecutive-cover
// scan - with the all-cover window passing the fraction floor
// and reaching no maximum-fraction rule, exactly the
// unreachable CoverFractionTooHigh.
test rule_order_matches_original {
    const window_real_only: [1]EmissionKind = [1]EmissionKind{
        EmissionKind.Real,
    };
    const v1 = validate_emission_cadence(&window_real_only);
    assert(v1.code == CadenceCode.WindowTooSmall);

    const sparse: [6]EmissionKind = [6]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const v2 = validate_emission_cadence(&sparse);
    assert(v2.code == CadenceCode.CoverFractionTooLow);

    const ratio_run: [14]EmissionKind = [14]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const v3 = validate_emission_cadence(&ratio_run);
    assert(v3.code == CadenceCode.TooManyConsecutiveReal);

    const cover_run: [10]EmissionKind = [10]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const v4 = validate_emission_cadence(&cover_run);
    assert(v4.code == CadenceCode.TooManyConsecutiveCover);
}
