module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_starvation;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_starvation.rs
// (CR-CHAT-07 - Cover-traffic starvation guard, Wave-25 Lane B,
// L-CHAT-7-cts, R-CHAT-10).
//
// Cover traffic only works when every wire tick produces
// something at a steady cadence: a paused schedule leaves a gap
// that breaks the canonical quantisation, a suppressed cover
// stream lets the reals stand out, and a forced cover burst
// re-leaks the correlation uniform cadence hides. The guard
// pins two invariants on a contiguous window: every
// inter-emission gap sits on the canonical ladder, and the
// cover share never drops below one quarter - compared as the
// original's integer cross-multiplication, so no division and
// no float anywhere.
//
// The rules, in the original's order: the window floor (an
// empty or short window is no signal), the gap-length coupling
// (exactly one fewer gap than emissions), the per-gap canonical
// membership, and the cover-floor cross-multiplication.
//
// The original returns Result<(), CoverStarvationError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the four variants in the original's
// declaration order - WindowTooShort, MismatchedGapLength,
// NonCanonicalGap, CoverFloorBreached - with every payload
// field: observed and required for the floor, the two observed
// lengths for the coupling, the offending gap's index and value,
// and the cover count with the total.
//
// The original's CTS-10 composes the guard with the stateful
// CoverScheduler (new, enqueue_real, tick) and lets the result
// depend on the scheduler's random draws; a stateful scheduler
// is outside the pure-guard form, so the port's green test
// asserts the constants and exercises the guard's whole path
// with a fixed window instead - the composition the original
// itself calls "the path", with the randomness named and left
// with the scheduler. The canonical ladder is the ring's
// [1000, 5000, 30000, 300000], ported as in the burst guard.

// Minimum number of emissions a window must contain before the
// cover-floor check applies.
pub const CTS_WINDOW_MIN_EMISSIONS: usize = 4;

// Numerator of the minimum acceptable cover ratio.
pub const CTS_MIN_COVER_RATIO_NUM: usize = 1;

// Denominator of the minimum acceptable cover ratio.
pub const CTS_MIN_COVER_RATIO_DEN: usize = 4;

// The canonical gap ladder of the ring's scheduler.
pub const CTS_CANONICAL_GAPS_MS: [4]u64 = [4]u64{1000, 5000, 30000, 300000,};

// The kind of one emission on the wire.
pub enum EmissionKind {
    Real,
    Cover,
}

// Verdict codes: Ok(()) and CoverStarvationError's variants, in declaration order.
pub enum CoverStarvationCode {
    Ok,
    WindowTooShort,
    MismatchedGapLength,
    NonCanonicalGap,
    CoverFloorBreached,
}

// The verdict of the starvation validation, with every error
// payload field.
pub struct CoverStarvationVerdict {
    code: CoverStarvationCode,
    observed: usize,
    required: usize,
    observed_gaps: usize,
    observed_emissions: usize,
    index: usize,
    value_ms: u64,
    cover_count: usize,
    total: usize,
}

// Whether the gap sits on the canonical ladder - the original's
// contains probe, answered by a scan.
pub fn is_canonical_gap(g: u64) -> bool {
    if (g == 1000) {
        return true;
    }
    if (g == 5000) {
        return true;
    }
    if (g == 30000) {
        return true;
    }
    if (g == 300000) {
        return true;
    }
    return false;
}

// [VERIFIED] Validate a contiguous wire window of cover-traffic
// emissions. Returns Ok only when every rule holds, checked in
// the original's order: the window floor, the gap-length
// coupling, the per-gap canonical membership, and the
// cover-floor cross-multiplication.
pub fn validate_window(
    emissions: []const EmissionKind,
    gaps_ms: []const u64,
) -> CoverStarvationVerdict {
    if (emissions.len < CTS_WINDOW_MIN_EMISSIONS) {
        return CoverStarvationVerdict { code: CoverStarvationCode.WindowTooShort, observed: emissions.len, required: CTS_WINDOW_MIN_EMISSIONS, observed_gaps: 0, observed_emissions: 0, index: 0, value_ms: 0, cover_count: 0, total: 0, };
    }
    if (gaps_ms.len + 1 != emissions.len) {
        return CoverStarvationVerdict { code: CoverStarvationCode.MismatchedGapLength, observed: 0, required: 0, observed_gaps: gaps_ms.len, observed_emissions: emissions.len, index: 0, value_ms: 0, cover_count: 0, total: 0, };
    }
    for i in 0..gaps_ms.len {
        if (!is_canonical_gap(gaps_ms[i])) {
            return CoverStarvationVerdict { code: CoverStarvationCode.NonCanonicalGap, observed: 0, required: 0, observed_gaps: 0, observed_emissions: 0, index: i, value_ms: gaps_ms[i], cover_count: 0, total: 0, };
        }
    }
    var cover_count: usize = 0;
    for i in 0..emissions.len {
        if (emissions[i] == EmissionKind.Cover) {
            cover_count = cover_count + 1;
        }
    }
    if (cover_count * CTS_MIN_COVER_RATIO_DEN < emissions.len * CTS_MIN_COVER_RATIO_NUM) {
        return CoverStarvationVerdict { code: CoverStarvationCode.CoverFloorBreached, observed: 0, required: 0, observed_gaps: 0, observed_emissions: 0, index: 0, value_ms: 0, cover_count: cover_count, total: emissions.len, };
    }
    return CoverStarvationVerdict { code: CoverStarvationCode.Ok, observed: 0, required: 0, observed_gaps: 0, observed_emissions: 0, index: 0, value_ms: 0, cover_count: 0, total: 0, };
}

// **CTS-01** - the uniform-cadence balanced window accepted:
// real, cover, real, cover on one-second gaps - two covers of
// four, exactly at the floor.
test cts01_valid_uniform_window_accepted {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const g: [3]u64 = [3]u64{1000, 1000, 1000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.Ok);
}

// **CTS-02** - a cadence skip rejected: one fifteen-hundred-
// millisecond gap off the ladder, pinpointed at index one.
test cts02_one_off_canonical_gap_rejected {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
    };
    const g: [3]u64 = [3]u64{1000, 1500, 1000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.NonCanonicalGap);
    assert(v.index == 1);
    assert(v.value_ms == 1500);
}

// **CTS-03** - an empty window rejected: no signal.
test cts03_empty_window_rejected {
    const em: [0]EmissionKind = [0]EmissionKind{};
    const g: [0]u64 = [0]u64{};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.WindowTooShort);
    assert(v.observed == 0);
    assert(v.required == 4);
}

// **CTS-04** - an all-real window rejected: the cover share is
// zero of four, under the quarter floor.
test cts04_all_real_window_breaches_cover_floor {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const g: [3]u64 = [3]u64{1000, 1000, 1000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.CoverFloorBreached);
    assert(v.cover_count == 0);
    assert(v.total == 4);
}

// **CTS-05** - an all-cover window accepted: the floor
// saturated at four of four.
test cts05_all_cover_window_accepted {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const g: [3]u64 = [3]u64{5000, 5000, 5000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.Ok);
}

// **CTS-06** - the floor boundary accepted: one cover of four,
// exactly the quarter.
test cts06_floor_boundary_accepted {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
    };
    const g: [3]u64 = [3]u64{30000, 30000, 30000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.Ok);
}

// **CTS-07** - one below the floor rejected: one cover of eight,
// where the quarter demands two.
test cts07_below_floor_rejected {
    const em: [8]EmissionKind = [8]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const g: [7]u64 = [7]u64{1000, 1000, 1000, 1000, 1000, 1000, 1000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.CoverFloorBreached);
    assert(v.cover_count == 1);
    assert(v.total == 8);
}

// **CTS-08** - a mismatched gap length rejected: four emissions
// need three gaps, four supplied.
test cts08_mismatched_gap_length_rejected {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const g: [4]u64 = [4]u64{1000, 1000, 1000, 1000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.MismatchedGapLength);
    assert(v.observed_gaps == 4);
    assert(v.observed_emissions == 4);
}

// **CTS-09** - a non-canonical gap at the last position: the
// index points at the final gap.
test cts09_non_canonical_gap_index_correct {
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const g: [3]u64 = [3]u64{1000, 5000, 42000,};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.NonCanonicalGap);
    assert(v.index == 2);
    assert(v.value_ms == 42000);
}

// **CTS-10** - green: the constants are public and the guard's
// whole path composes over a fixed window - the stateful
// CoverScheduler of the original's composition is outside the
// pure-guard form, its randomness named and left with the
// scheduler.
test cts10_green_constants_and_composition {
    assert(CTS_WINDOW_MIN_EMISSIONS == 4);
    assert(CTS_MIN_COVER_RATIO_NUM == 1);
    assert(CTS_MIN_COVER_RATIO_DEN == 4);
    const em: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Cover,
        EmissionKind.Real,
        EmissionKind.Cover,
    };
    const g: [3]u64 = [3]u64{CTS_CANONICAL_GAPS_MS[0], CTS_CANONICAL_GAPS_MS[0], CTS_CANONICAL_GAPS_MS[0],};
    const v = validate_window(&em, &g);
    assert(v.code == CoverStarvationCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test is_canonical_gap_answers {
    assert(is_canonical_gap(1000));
    assert(is_canonical_gap(5000));
    assert(is_canonical_gap(30000));
    assert(is_canonical_gap(300000));
    assert(!is_canonical_gap(1500));
    assert(!is_canonical_gap(42000));
    assert(!is_canonical_gap(0));
}

// Rule order is the original's: the window floor before the gap
// coupling, the coupling before the canonical scan, and the
// canonical scan before the cover floor.
test rule_order_matches_original {
    const short_mismatched: [2]EmissionKind = [2]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const g2: [5]u64 = [5]u64{1000, 1000, 1000, 1000, 1000,};
    const v1 = validate_window(&short_mismatched, &g2);
    assert(v1.code == CoverStarvationCode.WindowTooShort);

    const mismatched_offgrid: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
        EmissionKind.Cover,
    };
    const g4: [4]u64 = [4]u64{1000, 1500, 1000, 1000,};
    const v2 = validate_window(&mismatched_offgrid, &g4);
    assert(v2.code == CoverStarvationCode.MismatchedGapLength);

    const offgrid_thin: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const g3: [3]u64 = [3]u64{1000, 1500, 1000,};
    const v3 = validate_window(&offgrid_thin, &g3);
    assert(v3.code == CoverStarvationCode.NonCanonicalGap);
    assert(v3.index == 1);

    const thin_only: [4]EmissionKind = [4]EmissionKind{
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
        EmissionKind.Real,
    };
    const gok: [3]u64 = [3]u64{1000, 1000, 1000,};
    const v4 = validate_window(&thin_only, &gok);
    assert(v4.code == CoverStarvationCode.CoverFloorBreached);
    assert(v4.cover_count == 0);
}
