// four destinations, every count ten.
test cdug_07_balanced_accepted {
    var v: [40]DestCoverEmission;
    for i in 0..40 {
        var d: [16]u8 = DEST_1;
        const slot: usize = i % 4;
        if (slot == 1) {
            d = DEST_2;
