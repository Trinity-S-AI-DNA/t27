// **CDUG-09** - slight imbalance accepted: twelve to the first
// destination, eight to each of the rest - twelve of
// thirty-six, at exactly the three-quarters threshold.
test cdug_09_slightly_imbalanced_accepted {
    var v: [36]DestCoverEmission;
    for i in 0..36 {
        var d: [16]u8 = DEST_1;
        if (i >= 12) {
            if (i < 20) {
                d = DEST_2;
            }
            if (i >= 20) {
                if (i < 28) {
                    d = DEST_3;
                }
            }
            if (i >= 28) {
                d = DEST_4;
            }
        }
        v[i] = DestCoverEmission { dest: d, };
    }
    const verdict = validate_dest_uniformity(&DECLARED_4, &v);
    assert(verdict.code == DestUniformityCode.Ok);
}

// **CDUG-10** - the uniform batch accepted: twenty-five rounds
// over the four destinations.
test cdug_10_uniform_accepted {
    var v: [100]DestCoverEmission;
    for i in 0..100 {
        var d: [16]u8 = DEST_1;
        const slot: usize = i % 4;
        if (slot == 1) {
            d = DEST_2;
        }
        if (slot == 2) {
            d = DEST_3;
        }
        if (slot == 3) {
            d = DEST_4;
        }
        v[i] = DestCoverEmission { dest: d, };
    }
    const verdict = validate_dest_uniformity(&DECLARED_4, &v);
    assert(verdict.code == DestUniformityCode.Ok);
}

// The five helpers have direct tests (coverage: Untested 0).
test cdug_helpers_answer {
    assert(ids16_equal(DEST_1, DEST_1));
    assert(!ids16_equal(DEST_1, DEST_2));
    assert(zero_id16(ZERO_DEST16));
    assert(!zero_id16(DEST_1));
    assert(dest_position(&DECLARED_4, DEST_1) == 0);
    assert(dest_position(&DECLARED_4, DEST_4) == 3);
    assert(dest_position(&DECLARED_4, DEST_99) == 4);
    assert(dest_declared(&DECLARED_4, DEST_2));
    assert(!dest_declared(&DECLARED_4, DEST_99));
    const four: [4]DestCoverEmission = [4]DestCoverEmission{
        DestCoverEmission { dest: DEST_1, },
        DestCoverEmission { dest: DEST_1, },
        DestCoverEmission { dest: DEST_2, },
        DestCoverEmission { dest: DEST_3, },
    };
    assert(dest_count(&four, DEST_1) == 2);
    assert(dest_count(&four, DEST_2) == 1);
    assert(dest_count(&four, DEST_4) == 0);
}

// Rule order is the original's: the emission floor before any
// record, the zero destination before the declared-set
// membership, the per-record rules before the per-destination
// floors, and the floor before the dominance ceiling - with the
// twelve-of-thirty-six batch sitting exactly at the ceiling and
// passing.
test rule_order_matches_original {
    var short_zero: [4]DestCoverEmission;
    for i in 0..4 {
        short_zero[i] = DestCoverEmission { dest: ZERO_DEST16, };
    }
    const v1 = validate_dest_uniformity(&DECLARED_4, &short_zero);
    assert(v1.code == DestUniformityCode.TooFew);

    var zero_unknown: [20]DestCoverEmission;
    for i in 0..20 {
        var d: [16]u8 = DEST_1;
        const slot: usize = i % 4;
        if (slot == 1) {
            d = DEST_2;
        }
        if (slot == 2) {
            d = DEST_3;
        }
        if (slot == 3) {
            d = DEST_4;
        }
        zero_unknown[i] = DestCoverEmission { dest: d, };
    }
    zero_unknown[10] = DestCoverEmission { dest: ZERO_DEST16, };
    zero_unknown[11] = DestCoverEmission { dest: DEST_99, };
    const v2 = validate_dest_uniformity(&DECLARED_4, &zero_unknown);
    assert(v2.code == DestUniformityCode.ZeroDest);
    assert(v2.idx == 10);

    var zero_and_unknown: [20]DestCoverEmission;
    for i in 0..20 {
        var d: [16]u8 = DEST_1;
        const slot: usize = i % 4;
        if (slot == 1) {
            d = DEST_2;
        }
        if (slot == 2) {
            d = DEST_3;
        }
        if (slot == 3) {
            d = DEST_4;
        }
        zero_and_unknown[i] = DestCoverEmission { dest: d, };
    }
    zero_and_unknown[10] = DestCoverEmission { dest: DEST_99, };
    const v3 = validate_dest_uniformity(&DECLARED_4, &zero_and_unknown);
    assert(v3.code == DestUniformityCode.UnknownDest);
    assert(v3.idx == 10);

    var sparse_dominant: [20]DestCoverEmission;
    for i in 0..20 {
        var d: [16]u8 = DEST_2;
        if (i < 4) {
            d = DEST_1;
        }
        sparse_dominant[i] = DestCoverEmission { dest: d, };
    }
    const v4 = validate_dest_uniformity(&DECLARED_4, &sparse_dominant);
    assert(v4.code == DestUniformityCode.BelowMin);
    assert(v4.idx == 0);
    assert(v4.got == 4);
}
