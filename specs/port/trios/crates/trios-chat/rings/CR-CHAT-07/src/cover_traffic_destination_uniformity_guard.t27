        if (slot == 2) {
            d = DEST_3;
        }
        if (slot == 3) {
            d = DEST_4;
        }
        v[i] = DestCoverEmission { dest: d, };
    }
    const verdict = validate_dest_uniformity(&DECLARED_4, &v);
    assert(verdict.code == DestUniformityCode.Ok);
}

