module port::cover_traffic_destination_uniformity_guard;

// CR-CHAT-07 - Cover traffic destination uniformity guard (Wave-2 Lane A).
//
// DESTINATION UNIFORMITY GUARD - monitor uniform distribution of traffic across destinations, R-CHAT-07.
//
// The cover traffic system must distribute traffic uniformly across all available
// destinations to avoid creating patterns that could reveal the true destination.
// This guard monitors the distribution to ensure uniformity.
//
// Key monitoring criteria:
//
// 1. Uniform distribution of traffic across destinations
// 2. Avoidance of destination-specific traffic patterns
// 3. Balanced usage of all available destinations
// 4. Prevention of destination bias
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_destination_uniformity_guard.rs
// (gHashTag/trios at 8b229e9489ee).

// Maximum allowed deviation from uniform distribution.
pub const DUG_MAX_DEVIATION: f64 = 0.2;

// Minimum number of destinations for meaningful analysis.
pub const DUG_MIN_DESTINATIONS: usize = 5;

// Minimum traffic samples for analysis.
pub const DUG_MIN_SAMPLES: usize = 100;

// Guard result codes.
pub enum GuardResult {
    Pass,
    Fail,
    InvalidInput,
}

// Verdict codes for destination uniformity.
pub const DUG_OK: i32 = 0;
pub const DUG_ERR_NON_UNIFORM_DISTRIBUTION: i32 = 1;
pub const DUG_ERR_INSUFFICIENT_DATA: i32 = 2;
pub const DUG_ERR_INVALID_INPUT: i32 = 3;

// Track destination usage statistics.
pub struct DestinationStats {
    destinations: Vec<String>,
    usage_counts: Vec<usize>,
    total_samples: usize,
}

// Initialize destination statistics.
pub fn stats_init() -> DestinationStats {
    DestinationStats {
        destinations: Vec::new(),
        usage_counts: Vec::new(),
        total_samples: 0,
    }
}

// Add destination to tracking.
pub fn stats_add_destination(stats: &mut DestinationStats, dest: &str) -> i32 {
    if (dest.len() == 0) {
        return DUG_ERR_INVALID_INPUT;
    }
    
    // Check if destination already exists
    let mut i: usize = 0;
    while (i < stats.destinations.len()) {
        if (stats.destinations[i] == dest) {
            return DUG_OK;
        }
        i = i + 1;
    }
    
    // Add new destination
    stats.destinations.push(dest.to_string());
    stats.usage_counts.push(0);
    DUG_OK
}

// Record traffic to a destination.
pub fn stats_record_traffic(stats: &mut DestinationStats, dest: &str) -> i32 {
    if (dest.len() == 0) {
        return DUG_ERR_INVALID_INPUT;
    }
    
    let mut i: usize = 0;
    while (i < stats.destinations.len()) {
        if (stats.destinations[i] == dest) {
            stats.usage_counts[i] = stats.usage_counts[i] + 1;
            stats.total_samples = stats.total_samples + 1;
            return DUG_OK;
        }
        i = i + 1;
    }
    
    DUG_ERR_INVALID_INPUT
}

// Calculate expected usage for uniform distribution.
pub fn calculate_expected_usage(stats: &DestinationStats) -> f64 {
    if (stats.destinations.len() == 0) {
        return 0.0;
    }
    
    stats.total_samples as f64 / stats.destinations.len() as f64
}

// Calculate actual usage for a destination.
pub fn calculate_actual_usage(stats: &DestinationStats, dest_index: usize) -> f64 {
    if (dest_index >= stats.usage_counts.len()) {
        return 0.0;
    }
    
    stats.usage_counts[dest_index] as f64
}

// Calculate deviation from uniform distribution.
pub fn calculate_deviation(stats: &DestinationStats, dest_index: usize) -> f64 {
    if (stats.destinations.len() == 0) {
        return 0.0;
    }
    
    let expected = calculate_expected_usage(stats);
    let actual = calculate_actual_usage(stats, dest_index);
    
    if (expected > 0.0) {
        return (actual - expected) / expected;
    }
    return 0.0;
}

// Check if distribution is uniform.
pub fn is_distribution_uniform(stats: &DestinationStats) -> bool {
    if (stats.destinations.len() < DUG_MIN_DESTINATIONS || stats.total_samples < DUG_MIN_SAMPLES) {
        return true; // Not enough data to determine
    }
    
    let mut i: usize = 0;
    while (i < stats.destinations.len()) {
        let deviation = calculate_deviation(stats, i);
        if (deviation.abs() > DUG_MAX_DEVIATION) {
            return false;
        }
        i = i + 1;
    }
    
    true
}

// Validate destination uniformity.
pub fn validate_destination_uniformity(stats: &DestinationStats) -> i32 {
    if (stats.destinations.len() == 0) {
        return DUG_ERR_INVALID_INPUT;
    }
    
    if (stats.destinations.len() < DUG_MIN_DESTINATIONS) {
        return DUG_ERR_INSUFFICIENT_DATA;
    }
    
    if (stats.total_samples < DUG_MIN_SAMPLES) {
        return DUG_ERR_INSUFFICIENT_DATA;
    }
    
    if (!is_distribution_uniform(stats)) {
        return DUG_ERR_NON_UNIFORM_DISTRIBUTION;
    }
    
    DUG_OK
}

// Get the most used destination.
pub fn get_most_used_destination(stats: &DestinationStats) -> Option<String> {
    if (stats.usage_counts.len() == 0) {
        return None;
    }
    
    let mut max_index: usize = 0;
    let mut max_count: usize = 0;
    let mut i: usize = 0;
    while (i < stats.usage_counts.len()) {
        if (stats.usage_counts[i] > max_count) {
            max_count = stats.usage_counts[i];
            max_index = i;
        }
        i = i + 1;
    }
    
    Some(stats.destinations[max_index].to_string())
}

// Get the least used destination.
pub fn get_least_used_destination(stats: &DestinationStats) -> Option<String> {
    if (stats.usage_counts.len() == 0) {
        return None;
    }
    
    let mut min_index: usize = 0;
    let mut min_count: usize = stats.usage_counts[0];
    let mut i: usize = 1;
    while (i < stats.usage_counts.len()) {
        if (stats.usage_counts[i] < min_count) {
            min_count = stats.usage_counts[i];
            min_index = i;
        }
        i = i + 1;
    }
    
    Some(stats.destinations[min_index].to_string())
}

// DUG-01 - uniform distribution accepted.
test dug_01_uniform_distribution {
    let mut stats = stats_init();
    stats_add_destination(&mut stats, "dest1");
    stats_add_destination(&mut stats, "dest2");
    stats_add_destination(&mut stats, "dest3");
    
    // Simulate uniform usage
    stats_record_traffic(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest2");
    stats_record_traffic(&mut stats, "dest3");
    stats_record_traffic(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest2");
    stats_record_traffic(&mut stats, "dest3");
    
    let result = validate_destination_uniformity(&stats);
    assert(result == DUG_OK);
}

// DUG-02 - non-uniform distribution rejected.
test dug_02_non_uniform_distribution {
    let mut stats = stats_init();
    stats_add_destination(&mut stats, "dest1");
    stats_add_destination(&mut stats, "dest2");
    
    // Simulate non-uniform usage
    let mut i: usize = 0;
    while (i < 90) {
        stats_record_traffic(&mut stats, "dest1");
        i = i + 1;
    }
    let mut j: usize = 0;
    while (j < 10) {
        stats_record_traffic(&mut stats, "dest2");
        j = j + 1;
    }
    
    let result = validate_destination_uniformity(&stats);
    assert(result == DUG_ERR_NON_UNIFORM_DISTRIBUTION);
}

// DUG-03 - insufficient data accepted.
test dug_03_insufficient_data {
    let mut stats = stats_init();
    stats_add_destination(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest1");
    
    let result = validate_destination_uniformity(&stats);
    assert(result == DUG_ERR_INSUFFICIENT_DATA);
}

// DUG-04 - extreme values detection.
test dug_04_extreme_values {
    let mut stats = stats_init();
    stats_add_destination(&mut stats, "dest1");
    stats_add_destination(&mut stats, "dest2");
    stats_add_destination(&mut stats, "dest3");
    
    // Record traffic
    stats_record_traffic(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest1");
    stats_record_traffic(&mut stats, "dest2");
    stats_record_traffic(&mut stats, "dest3");
    
    let most_used = get_most_used_destination(&stats);
    let least_used = get_least_used_destination(&stats);
    
    assert(most_used == Some("dest1".to_string()));
    assert(least_used == Some("dest2".to_string()) || least_used == Some("dest3".to_string()));
}