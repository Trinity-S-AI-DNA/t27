module port::cover_traffic_generation_rate_stability_guard;

// CR-CHAT-07 - Cover traffic generation rate stability guard (Wave-2 Lane A).
//
// GENERATION RATE STABILITY GUARD - monitor stability of traffic generation rates.
//
// The cover traffic system must maintain stable generation rates to avoid
// creating detectable patterns. This guard monitors the stability of traffic
// generation rates over time.
//
// Key monitoring criteria:
//
// 1. Stability of generation rates over time
// 2. Avoidance of rate spikes or drops
// 3. Consistent traffic generation patterns
// 4. Prevention of rate-based detection
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_generation_rate_stability_guard.rs
// (gHashTag/trios at 8b229e9489ee).

// Maximum allowed rate deviation.
pub const CTGRG_MAX_DEVIATION: f64 = 0.2;

// Minimum generation rate per second.
pub const CTGRG_MIN_RATE: f64 = 1.0;

// Maximum generation rate per second.
pub const CTGRG_MAX_RATE: f64 = 10.0;

// Minimum samples for rate analysis.
pub const CTGRG_MIN_SAMPLES: usize = 50;

// Guard result codes.
pub enum GuardResult {
    Pass,
    Fail,
    InvalidInput,
}

// Verdict codes for generation rate stability.
pub const CTGRG_OK: i32 = 0;
pub const CTGRG_ERR_RATE_TOO_HIGH: i32 = 1;
pub const CTGRG_ERR_RATE_TOO_LOW: i32 = 2;
pub const CTGRG_ERR_UNSTABLE_RATE: i32 = 3;
pub const CTGRG_ERR_INSUFFICIENT_DATA: i32 = 4;
pub const CTGRG_ERR_INVALID_INPUT: i32 = 5;

// Track generation rate statistics.
pub struct RateStats {
    timestamps: Vec<usize>,
    rates: Vec<f64>,
    avg_rate: f64,
    min_rate: f64,
    max_rate: f64,
    variance: f64,
}

// Initialize rate statistics.
pub fn stats_init() -> RateStats {
    RateStats {
        timestamps: Vec::new(),
        rates: Vec::new(),
        avg_rate: 0.0,
        min_rate: f64::MAX,
        max_rate: 0.0,
        variance: 0.0,
    }
}

// Add timestamp for rate calculation.
pub fn add_timestamp(stats: &mut RateStats, timestamp: usize) -> i32 {
    if (timestamp == 0) {
        return CTGRG_ERR_INVALID_INPUT;
    }
    
    stats.timestamps.push(timestamp);
    update_rate_statistics(stats);
    CTGRG_OK
}

// Update rate statistics.
pub fn update_rate_statistics(stats: &mut RateStats) {
    if (stats.timestamps.len() < 2) {
        return;
    }
    
    // Calculate rates between consecutive timestamps
    stats.rates.clear();
    let mut i: usize = 1;
    while (i < stats.timestamps.len()) {
        let time_diff = stats.timestamps[i] - stats.timestamps[i - 1];
        if (time_diff > 0) {
            let rate = 1.0 / time_diff as f64; // Messages per time unit
            stats.rates.push(rate);
        }
        i = i + 1;
    }
    
    // Update statistics
    if (stats.rates.len() > 0) {
        let mut sum: f64 = 0.0;
        stats.min_rate = stats.rates[0];
        stats.max_rate = stats.rates[0];
        
        let mut j: usize = 0;
        while (j < stats.rates.len()) {
            sum = sum + stats.rates[j];
            if (stats.rates[j] < stats.min_rate) {
                stats.min_rate = stats.rates[j];
            }
            if (stats.rates[j] > stats.max_rate) {
                stats.max_rate = stats.rates[j];
            }
            j = j + 1;
        }
        
        stats.avg_rate = sum / stats.rates.len() as f64;
        
        // Calculate variance
        let mut variance: f64 = 0.0;
        let mut k: usize = 0;
        while (k < stats.rates.len()) {
            let diff = stats.rates[k] - stats.avg_rate;
            variance = variance + diff * diff;
            k = k + 1;
        }
        
        stats.variance = variance / stats.rates.len() as f64;
    }
}

// Check if rate is within bounds.
pub fn is_rate_within_bounds(stats: &RateStats) -> bool {
    stats.avg_rate >= CTGRG_MIN_RATE && stats.avg_rate <= CTGRG_MAX_RATE
}

// Check rate stability.
pub fn is_rate_stable(stats: &RateStats) -> bool {
    if (stats.rates.len() < CTGRG_MIN_SAMPLES) {
        return false;
    }
    
    let std_dev = stats.variance.sqrt();
    let deviation_ratio = std_dev / stats.avg_rate;
    deviation_ratio <= CTGRG_MAX_DEVIATION
}

// Check for rate spikes.
pub fn has_rate_spikes(stats: &RateStats) -> bool {
    if (stats.rates.len() < 10) {
        return false;
    }
    
    let threshold = stats.avg_rate * 2.0; // 2x average rate
    let spike_count = 0;
    let mut i: usize = 0;
    while (i < stats.rates.len()) {
        if (stats.rates[i] > threshold) {
            spike_count = spike_count + 1;
        }
        i = i + 1;
    }
    
    spike_count > stats.rates.len() / 10 // More than 10% spikes
}

// Check for rate drops.
pub fn has_rate_drops(stats: &RateStats) -> bool {
    if (stats.rates.len() < 10) {
        return false;
    }
    
    let threshold = stats.avg_rate * 0.5; // 50% of average rate
    let drop_count = 0;
    let mut i: usize = 0;
    while (i < stats.rates.len()) {
        if (stats.rates[i] < threshold) {
            drop_count = drop_count + 1;
        }
        i = i + 1;
    }
    
    drop_count > stats.rates.len() / 10 // More than 10% drops
}

// Validate generation rate stability.
pub fn validate_generation_rate_stability(stats: &RateStats) -> i32 {
    if (stats.timestamps.len() == 0) {
        return CTGRG_ERR_INVALID_INPUT;
    }
    
    if (stats.rates.len() < CTGRG_MIN_SAMPLES) {
        return CTGRG_ERR_INSUFFICIENT_DATA;
    }
    
    if (!is_rate_within_bounds(stats)) {
        if (stats.avg_rate < CTGRG_MIN_RATE) {
            return CTGRG_ERR_RATE_TOO_LOW;
        } else {
            return CTGRG_ERR_RATE_TOO_HIGH;
        }
    }
    
    if (!is_rate_stable(stats)) {
        return CTGRG_ERR_UNSTABLE_RATE;
    }
    
    CTGRG_OK
}

// Get rate summary statistics.
pub fn get_rate_summary(stats: &RateStats) -> (f64, f64, f64) {
    (stats.avg_rate, stats.min_rate, stats.max_rate)
}

// Calculate rate trend.
pub fn calculate_rate_trend(stats: &RateStats) -> f64 {
    if (stats.rates.len() < 2) {
        return 0.0;
    }
    
    // Simple linear regression for trend
    let n = stats.rates.len();
    let mut sum_x: f64 = 0.0;
    let mut sum_y: f64 = 0.0;
    let mut sum_xy: f64 = 0.0;
    let mut sum_x2: f64 = 0.0;
    
    let mut i: usize = 0;
    while (i < n) {
        let x = i as f64;
        let y = stats.rates[i];
        sum_x = sum_x + x;
        sum_y = sum_y + y;
        sum_xy = sum_xy + x * y;
        sum_x2 = sum_x2 + x * x;
        i = i + 1;
    }
    
    let numerator = n as f64 * sum_xy - sum_x * sum_y;
    let denominator = n as f64 * sum_x2 - sum_x * sum_x;
    
    if (denominator != 0.0) {
        numerator / denominator
    } else {
        0.0
    }
}

// Check for systematic trends.
pub fn has_systematic_trend(stats: &RateStats) -> bool {
    let trend = calculate_rate_trend(stats);
    trend.abs() > 0.1 // Significant trend indicates systematic behavior
}

// CTGRG-01 - stable rates accepted.
test ctgrg_01_stable_rates {
    let mut stats = stats_init();
    
    // Add timestamps with stable intervals
    let timestamps = [100, 110, 120, 130, 140, 150, 160, 170, 180, 190];
    let mut i: usize = 0;
    while (i < timestamps.len()) {
        add_timestamp(&mut stats, timestamps[i]);
        i = i + 1;
    }
    
    let result = validate_generation_rate_stability(&stats);
    assert(result == CTGRG_OK);
}

// CTGRG-02 - rate too high rejected.
test ctgrg_02_rate_too_high {
    let mut stats = stats_init();
    
    // Add timestamps with very short intervals (high rate)
    let timestamps = [100, 101, 102, 103, 104, 105, 106, 107, 108, 109];
    let mut i: usize = 0;
    while (i < timestamps.len()) {
        add_timestamp(&mut stats, timestamps[i]);
        i = i + 1;
    }
    
    let result = validate_generation_rate_stability(&stats);
    assert(result == CTGRG_ERR_RATE_TOO_HIGH);
}

// CTGRG-03 - rate too low rejected.
test ctgrg_03_rate_too_low {
    let mut stats = stats_init();
    
    // Add timestamps with long intervals (low rate)
    let timestamps = [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000];
    let mut i: usize = 0;
    while (i < timestamps.len()) {
        add_timestamp(&mut stats, timestamps[i]);
        i = i + 1;
    }
    
    let result = validate_generation_rate_stability(&stats);
    assert(result == CTGRG_ERR_RATE_TOO_LOW);
}

// CTGRG-04 - unstable rates rejected.
test ctgrg_04_unstable_rates {
    let mut stats = stats_init();
    
    // Add timestamps with unstable intervals
    let timestamps = [100, 110, 120, 130, 140, 150, 160, 170, 180, 300];
    let mut i: usize = 0;
    while (i < timestamps.len()) {
        add_timestamp(&mut stats, timestamps[i]);
        i = i + 1;
    }
    
    let result = validate_generation_rate_stability(&stats);
    assert(result == CTGRG_ERR_UNSTABLE_RATE);
}

// CTGRG-05 - rate trend analysis.
test ctgrg_05_rate_trend {
    let mut stats = stats_init();
    
    // Add timestamps showing increasing trend
    let timestamps = [100, 120, 140, 160, 180, 200, 220, 240, 260, 280];
    let mut i: usize = 0;
    while (i < timestamps.len()) {
        add_timestamp(&mut stats, timestamps[i]);
        i = i + 1;
    }
    
    let trend = calculate_rate_trend(&stats);
    assert(trend > 0.0); // Increasing trend
}