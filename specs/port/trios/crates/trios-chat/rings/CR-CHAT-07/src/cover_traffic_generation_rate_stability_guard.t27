module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_generation_rate_stability_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_generation_rate_stability_guard.rs
// (CR-CHAT-07 - Cover traffic generation rate stability guard,
// Wave-125 Lane B, R-CHAT-10).
//
// The generation rate must hold steady across epochs: a rate
// that drops when the user idles and rises when active tells
// presence, a unique per-epoch rate profile follows the user
// across boundaries, and a network observer reads the
// coefficient of variation straight off the wire. The rules,
// in the original's order: the batch ceiling, the epoch floor,
// then per epoch the rate floor, the rate ceiling and the
// strictly-increasing epoch number, then over the whole batch
// the CV ceiling of three tenths.
//
// The original returns Result<(), RateStabilityError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the six variants in the original's
// declaration order - HighCV, TooLow, TooHigh,
// NonMonotonicEpoch, TooFewEpochs, TooMany - with every payload
// field: the measured and ceiling CV, idx with got and min or
// max for the rate bounds, idx with prev and current for the
// monotonic break, and got with min or max for the batch
// bounds.
//
// The original's compute_cv takes a float mean and a square
// root - the int-to-float casts do not lower under the
// backends - so the coefficient of variation arrives as a
// number the caller computed, the lane convention for
// statistics over buffers (fill-byte randomness #9698, payload
// entropy #9747, pattern randomness #9811). The structural
// rules - the rate bounds, the epoch monotonicity, the batch
// bounds - stay fully in the spec, and every fixture's CV is
// Python-verified exact: the stable and boundary batches
// measure zero, the slight batch 0.0632, the unstable
// 1.4100.

// Maximum coefficient of variation in generation rate.
pub const CGRS_MAX_CV: f64 = 0.3;

// Minimum cover traffic rate (emissions per epoch).
pub const CGRS_MIN_RATE: u64 = 1;

// Maximum cover traffic rate.
pub const CGRS_MAX_RATE: u64 = 1000;

// Minimum epochs for CV check.
pub const CGRS_MIN_EPOCHS: usize = 3;

// Maximum epochs per batch.
pub const CGRS_MAX_EPOCHS: usize = 512;

// A cover traffic generation rate observation per epoch.
pub struct EpochRateObservation {
    epoch: u64,
    rate: u64,
}

// Verdict codes: Ok(()) and RateStabilityError's variants, in declaration order.
pub enum RateStabilityCode {
    Ok,
    HighCV,
    TooLow,
    TooHigh,
    NonMonotonicEpoch,
    TooFewEpochs,
    TooMany,
}

// The verdict of the rate stability validation, with every
// error payload field.
pub struct RateStabilityVerdict {
    code: RateStabilityCode,
    idx: usize,
    got: usize,
    bound: usize,
    got_f: f64,
    bound_f: f64,
    prev: u64,
    current: u64,
}

// [VERIFIED] Validate cover traffic generation rate stability.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the epoch floor, then
// per epoch the rate floor, the rate ceiling and the
// strictly-increasing epoch, then the CV ceiling over the
// caller's measurement.
pub fn validate_rate_stability(
    epochs: []const EpochRateObservation,
    cv: f64,
) -> RateStabilityVerdict {
    if (epochs.len > CGRS_MAX_EPOCHS) {
        return RateStabilityVerdict { code: RateStabilityCode.TooMany, idx: 0, got: epochs.len, bound: CGRS_MAX_EPOCHS, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
    }
    if (epochs.len < CGRS_MIN_EPOCHS) {
        return RateStabilityVerdict { code: RateStabilityCode.TooFewEpochs, idx: 0, got: epochs.len, bound: CGRS_MIN_EPOCHS, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
    }
    var prev_epoch: u64 = 0;
    for i in 0..epochs.len {
        if (epochs[i].rate < CGRS_MIN_RATE) {
            return RateStabilityVerdict { code: RateStabilityCode.TooLow, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: epochs[i].rate, };
        }
        if (epochs[i].rate > CGRS_MAX_RATE) {
            return RateStabilityVerdict { code: RateStabilityCode.TooHigh, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: epochs[i].rate, };
        }
        if (i > 0) {
            if (epochs[i].epoch <= prev_epoch) {
                return RateStabilityVerdict { code: RateStabilityCode.NonMonotonicEpoch, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: prev_epoch, current: epochs[i].epoch, };
            }
        }
        prev_epoch = epochs[i].epoch;
    }
    if (cv > CGRS_MAX_CV) {
        return RateStabilityVerdict { code: RateStabilityCode.HighCV, idx: 0, got: 0, bound: 0, got_f: cv, bound_f: CGRS_MAX_CV, prev: 0, current: 0, };
    }
    return RateStabilityVerdict { code: RateStabilityCode.Ok, idx: 0, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
}

// **CGRS-01** - high CV rejected: rates one, a thousand, one -
// a CV of 1.4100 over the ceiling of three tenths.
test cgrs_01_high_cv_rejected {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 1, },
        EpochRateObservation { epoch: 2, rate: 1000, },
        EpochRateObservation { epoch: 3, rate: 1, },
    };
    const v = validate_rate_stability(&es, 1.4099793900306605);
    assert(v.code == RateStabilityCode.HighCV);
    assert(v.got_f == 1.4099793900306605);
    assert(v.bound_f == 0.3);
}

// **CGRS-02** - a rate below the minimum rejected: zero
// emissions in the second epoch.
test cgrs_02_too_low_rejected {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 0, },
        EpochRateObservation { epoch: 3, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.TooLow);
    assert(v.idx == 1);
    assert(v.current == 0);
}

// **CGRS-03** - a rate above the maximum rejected: 1001
// emissions of a ceiling thousand.
test cgrs_03_too_high_rejected {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 1001, },
        EpochRateObservation { epoch: 3, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.TooHigh);
    assert(v.idx == 1);
    assert(v.current == 1001);
}

// **CGRS-04** - a non-monotonic epoch rejected: epoch three
// after epoch five.
test cgrs_04_non_monotonic_rejected {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 5, rate: 10, },
        EpochRateObservation { epoch: 3, rate: 10, },
        EpochRateObservation { epoch: 4, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.NonMonotonicEpoch);
    assert(v.idx == 1);
    assert(v.prev == 5);
    assert(v.current == 3);
}

// **CGRS-05** - too few epochs rejected: two of a required
// three.
test cgrs_05_too_few_rejected {
    const es: [2]EpochRateObservation = [2]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.TooFewEpochs);
    assert(v.got == 2);
    assert(v.bound == 3);
}

// **CGRS-06** - too many rejected: 513 epochs of a maximum 512,
// built in a loop like the original's, the epochs walking one
// upward. The batch rule fires before any epoch is examined.
test cgrs_06_too_many_rejected {
    var es: [513]EpochRateObservation;
    for i in 0..513 {
        es[i] = EpochRateObservation { epoch: @as(u64, i) + 1, rate: 10, };
    }
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.TooMany);
    assert(v.got == 513);
    assert(v.bound == 512);
}

// **CGRS-07** - the stable batch accepted: five epochs at ten
// emissions - a CV of zero.
test cgrs_07_stable_accepted {
    const es: [5]EpochRateObservation = [5]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 10, },
        EpochRateObservation { epoch: 3, rate: 10, },
        EpochRateObservation { epoch: 4, rate: 10, },
        EpochRateObservation { epoch: 5, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.Ok);
}

// **CGRS-08** - exactly the minimum epochs accepted: three at
// ten.
test cgrs_08_exact_minimum_accepted {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 10, },
        EpochRateObservation { epoch: 3, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.Ok);
}

// **CGRS-09** - slight variation accepted: ten, eleven, nine,
// ten, ten - a CV of 0.0632 under the ceiling.
test cgrs_09_slight_variation_accepted {
    const es: [5]EpochRateObservation = [5]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 11, },
        EpochRateObservation { epoch: 3, rate: 9, },
        EpochRateObservation { epoch: 4, rate: 10, },
        EpochRateObservation { epoch: 5, rate: 10, },
    };
    const v = validate_rate_stability(&es, 0.06324555320336758);
    assert(v.code == RateStabilityCode.Ok);
}

// **CGRS-10** - the boundary rate accepted: one emission per
// epoch, exactly the floor, a CV of zero.
test cgrs_10_boundary_rate_accepted {
    const es: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 1, },
        EpochRateObservation { epoch: 2, rate: 1, },
        EpochRateObservation { epoch: 3, rate: 1, },
    };
    const v = validate_rate_stability(&es, 0.0);
    assert(v.code == RateStabilityCode.Ok);
}

// Rule order is the original's: the epoch floor before any
// record, the rate floor before the rate ceiling, the rate
// bounds before the epoch monotonicity, and the per-epoch rules
// before the batch CV - with the boundary-rate batch passing
// and the unstable one caught by the CV last.
test rule_order_matches_original {
    const short_low: [2]EpochRateObservation = [2]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 0, },
        EpochRateObservation { epoch: 2, rate: 10, },
    };
    const v1 = validate_rate_stability(&short_low, 0.0);
    assert(v1.code == RateStabilityCode.TooFewEpochs);

    const zero_backstep: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 10, },
        EpochRateObservation { epoch: 2, rate: 0, },
        EpochRateObservation { epoch: 1, rate: 10, },
    };
    const v2 = validate_rate_stability(&zero_backstep, 0.0);
    assert(v2.code == RateStabilityCode.TooLow);
    assert(v2.idx == 1);

    const backstep_low: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 5, rate: 10, },
        EpochRateObservation { epoch: 3, rate: 10, },
        EpochRateObservation { epoch: 1, rate: 0, },
    };
    const v3 = validate_rate_stability(&backstep_low, 0.0);
    assert(v3.code == RateStabilityCode.NonMonotonicEpoch);
    assert(v3.idx == 1);

    const unstable_low_cv: [3]EpochRateObservation = [3]EpochRateObservation{
        EpochRateObservation { epoch: 1, rate: 1, },
        EpochRateObservation { epoch: 2, rate: 1000, },
        EpochRateObservation { epoch: 3, rate: 1, },
    };
    const v4 = validate_rate_stability(&unstable_low_cv, 0.2);
    assert(v4.code == RateStabilityCode.Ok);
}
