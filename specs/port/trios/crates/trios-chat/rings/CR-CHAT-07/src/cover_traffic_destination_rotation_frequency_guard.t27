module port::cover_traffic_destination_rotation_frequency_guard;

// CR-CHAT-07 - Cover traffic destination rotation frequency guard (Wave-2 Lane A).
//
// DESTINATION ROTATION FREQUENCY GUARD - monitor rotation of destination addresses, R-CHAT-07.
//
// The cover traffic system must rotate destination addresses at appropriate
// frequencies to avoid creating patterns in network traffic. This guard monitors
// how frequently destinations are rotated to ensure proper mixing.
//
// Key monitoring criteria:
//
// 1. Rotation frequency between destinations
// 2. Avoidance of predictable rotation patterns
// 3. Sufficient diversity in destination selection
// 4. Prevention of destination clustering
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_destination_rotation_frequency_guard.rs
// (gHashTag/trios at 8b229e9489ee).

// Minimum number of destinations before rotation.
pub const DRFG_MIN_DESTINATIONS: usize = 10;

// Maximum time between rotations in seconds.
pub const DRFG_MAX_ROTATION_INTERVAL: usize = 300;

// Minimum time between rotations in seconds.
pub const DRFG_MIN_ROTATION_INTERVAL: usize = 30;

// Maximum allowed predictability score.
pub const DRFG_MAX_PREDICTABILITY_SCORE: f64 = 0.7;

// Guard result codes.
pub enum GuardResult {
    Pass,
    Fail,
    InvalidInput,
}

// Verdict codes for destination rotation frequency.
pub const DRFG_OK: i32 = 0;
pub const DRFG_ERR_ROTATION_TOO_PREDICTABLE: i32 = 1;
pub const DRFG_ERR_ROTATION_TOO_INFREQUENT: i32 = 2;
pub const DRFG_ERR_INSUFFICIENT_DESTINATIONS: i32 = 3;
pub const DRFG_ERR_INVALID_INPUT: i32 = 4;

// Track destination usage and rotation.
pub struct DestinationTracker {
    destinations: Vec<String>,
    last_rotation_time: usize,
    rotation_intervals: Vec<usize>,
    usage_counts: Vec<usize>,
}

// Initialize destination tracker.
pub fn tracker_init() -> DestinationTracker {
    DestinationTracker {
        destinations: Vec::new(),
        last_rotation_time: 0,
        rotation_intervals: Vec::new(),
        usage_counts: Vec::new(),
    }
}

// Add a destination to the tracker.
pub fn tracker_add_destination(tracker: &mut DestinationTracker, dest: &str) -> i32 {
    if (dest.len() == 0) {
        return DRFG_ERR_INVALID_INPUT;
    }
    
    // Check if destination already exists
    let mut i: usize = 0;
    while (i < tracker.destinations.len()) {
        if (tracker.destinations[i] == dest) {
            // Increment usage count
            tracker.usage_counts[i] = tracker.usage_counts[i] + 1;
            return DRFG_OK;
        }
        i = i + 1;
    }
    
    // Add new destination
    tracker.destinations.push(dest.to_string());
    tracker.usage_counts.push(1);
    DRFG_OK
}

// Check if rotation is needed.
pub fn should_rotate(tracker: &DestinationTracker, current_time: usize) -> bool {
    if (tracker.destinations.len() < DRFG_MIN_DESTINATIONS) {
        return false;
    }
    
    let time_since_rotation = current_time - tracker.last_rotation_time;
    time_since_rotation >= DRFG_MAX_ROTATION_INTERVAL
}

// Perform destination rotation.
pub fn rotate_destinations(tracker: &mut DestinationTracker, current_time: usize) -> i32 {
    if (tracker.destinations.len() < DRFG_MIN_DESTINATIONS) {
        return DRFG_ERR_INSUFFICIENT_DESTINATIONS;
    }
    
    // Calculate rotation interval
    if (tracker.last_rotation_time > 0) {
        let interval = current_time - tracker.last_rotation_time;
        tracker.rotation_intervals.push(interval);
    }
    
    // Reset usage counts
    let mut i: usize = 0;
    while (i < tracker.usage_counts.len()) {
        tracker.usage_counts[i] = 0;
        i = i + 1;
    }
    
    tracker.last_rotation_time = current_time;
    DRFG_OK
}

// Calculate predictability score for destination selection.
pub fn calculate_predictability(tracker: &DestinationTracker) -> f64 {
    if (tracker.destinations.len() == 0) {
        return 0.0;
    }
    
    // Simple predictability: if one destination is used much more than others
    let mut max_usage: usize = 0;
    let mut total_usage: usize = 0;
    let mut i: usize = 0;
    while (i < tracker.usage_counts.len()) {
        if (tracker.usage_counts[i] > max_usage) {
            max_usage = tracker.usage_counts[i];
        }
        total_usage = total_usage + tracker.usage_counts[i];
        i = i + 1;
    }
    
    if (total_usage > 0) {
        return max_usage as f64 / total_usage as f64;
    }
    return 0.0;
}

// Validate destination rotation frequency.
pub fn validate_rotation_frequency(tracker: &DestinationTracker, current_time: usize) -> i32 {
    // Check if rotation intervals are valid
    if (tracker.rotation_intervals.len() > 0) {
        let mut i: usize = 0;
        while (i < tracker.rotation_intervals.len()) {
            let interval = tracker.rotation_intervals[i];
            if (interval < DRFG_MIN_ROTATION_INTERVAL || interval > DRFG_MAX_ROTATION_INTERVAL) {
                return DRFG_ERR_ROTATION_TOO_INFREQUENT;
            }
            i = i + 1;
        }
    }
    
    // Check predictability score
    let predictability = calculate_predictability(tracker);
    if (predictability > DRFG_MAX_PREDICTABILITY_SCORE) {
        return DRFG_ERR_ROTATION_TOO_PREDICTABLE;
    }
    
    DRFG_OK
}

// DRFG-01 - normal rotation accepted.
test drfg_01_normal_rotation {
    let mut tracker = tracker_init();
    let result1 = tracker_add_destination(&mut tracker, "dest1");
    let result2 = tracker_add_destination(&mut tracker, "dest2");
    let result3 = tracker_add_destination(&mut tracker, "dest3");
    assert(result1 == DRFG_OK && result2 == DRFG_OK && result3 == DRFG_OK);
    
    let validation_result = validate_rotation_frequency(&tracker, 100);
    assert(validation_result == DRFG_OK);
}

// DRFG-02 - insufficient destinations rejected.
test drfg_02_insufficient_destinations {
    let mut tracker = tracker_init();
    let result = tracker_add_destination(&mut tracker, "dest1");
    assert(result == DRFG_OK);
    
    let rotation_result = rotate_destinations(&mut tracker, 100);
    assert(rotation_result == DRFG_ERR_INSUFFICIENT_DESTINATIONS);
}

// DRFG-03 - predictability score calculation.
test drfg_03_predictability_score {
    let mut tracker = tracker_init();
    tracker_add_destination(&mut tracker, "dest1");
    tracker_add_destination(&mut tracker, "dest2");
    tracker_add_destination(&mut tracker, "dest3");
    
    // Simulate usage: dest1 used 5 times, dest2 used 1 time, dest3 used 1 time
    tracker.usage_counts[0] = 5;
    tracker.usage_counts[1] = 1;
    tracker.usage_counts[2] = 1;
    
    let score = calculate_predictability(&tracker);
    assert(score >= 0.0 && score <= 1.0);
}

// DRFG-04 - rotation interval validation.
test drfg_04_rotation_interval {
    let mut tracker = tracker_init();
    tracker.destinations.push("dest1".to_string());
    tracker.destinations.push("dest2".to_string());
    tracker.usage_counts.push(0);
    tracker.usage_counts.push(0);
    tracker.last_rotation_time = 50;
    tracker.rotation_intervals.push(25); // Too short
    tracker.rotation_intervals.push(350); // Too long
    
    let result = validate_rotation_frequency(&tracker, 100);
    assert(result == DRFG_ERR_ROTATION_TOO_INFREQUENT);
}