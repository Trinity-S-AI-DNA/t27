module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_payload_size_variance_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_payload_size_variance_guard.rs
// (CR-CHAT-07 - Cover traffic payload size variance guard,
// Wave-121 Lane B, R-CHAT-10).
//
// Cover payload sizes must hold a narrow band: a wide variance
// fingerprints the generator, sizes moving in sync with real
// messages match cover to real, and a high coefficient of
// variation separates the two trains trivially. The rules, in
// the original's order: the batch ceiling, then per observation
// the zero-timestamp probe, the strictly-increasing timestamps,
// the size floor (256) and the size ceiling (4096), then over
// at least two observations the coefficient-of-variation
// ceiling of two tenths.
//
// The original returns Result<(), SizeVarianceError>. This port
// carries the verdict as a named struct (owner decision D5): Ok
// first, then the six variants in the original's declaration
// order - HighCV, TooSmall, TooLarge, ZeroTimestamp, NonMonotonic,
// TooMany - with every payload field: the measured and ceiling
// CV, idx with got and min or max for the size bounds, idx for
// the zero timestamp, idx with prev and current for the
// monotonic break, and got with max for the batch bounds.
//
// The original's compute_cv takes a float mean and a square
// root of usize sums - the int-to-float casts do not lower
// under the backends - so the coefficient of variation arrives
// as a number the caller computed, the lane convention for
// statistics over buffers (fill-byte randomness #9698, payload
// entropy #9747, pattern randomness #9811, rate stability
// #9814). The structural rules stay fully in the spec. Every
// fixture's CV is Python-verified exact: the band-edge pair
// 0.8824 over the ceiling, the uniform batch zero, the slight
// batch 0.0148.

// Maximum coefficient of variation (stddev / mean).
pub const CPSV_MAX_CV: f64 = 0.2;

// Minimum cover payload size.
pub const CPSV_MIN_SIZE: usize = 256;

// Maximum cover payload size.
pub const CPSV_MAX_SIZE: usize = 4096;

// Maximum emissions per batch.
pub const CPSV_MAX_EMISSIONS: usize = 1024;

// A cover traffic size observation.
pub struct CoverSizeObservation {
    size: usize,
    timestamp_ms: u64,
}

// Verdict codes: Ok(()) and SizeVarianceError's variants, in declaration order.
pub enum SizeVarianceCode {
    Ok,
    HighCV,
    TooSmall,
    TooLarge,
    ZeroTimestamp,
    NonMonotonic,
    TooMany,
}

// The verdict of the size variance validation, with every error
// payload field.
pub struct SizeVarianceVerdict {
    code: SizeVarianceCode,
    idx: usize,
    got: usize,
    bound: usize,
    got_f: f64,
    bound_f: f64,
    prev: u64,
    current: u64,
}

// [VERIFIED] Validate cover traffic payload size variance.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, then per observation the
// zero timestamp, the strictly-increasing timestamps, the size
// floor and the size ceiling, then over at least two
// observations the caller's CV against the ceiling.
pub fn validate_size_variance(
    observations: []const CoverSizeObservation,
    cv: f64,
) -> SizeVarianceVerdict {
    if (observations.len > CPSV_MAX_EMISSIONS) {
        return SizeVarianceVerdict { code: SizeVarianceCode.TooMany, idx: 0, got: observations.len, bound: CPSV_MAX_EMISSIONS, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
    }
    var prev_ts: u64 = 0;
    for i in 0..observations.len {
        if (observations[i].timestamp_ms == 0) {
            return SizeVarianceVerdict { code: SizeVarianceCode.ZeroTimestamp, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        if (i > 0) {
            if (observations[i].timestamp_ms <= prev_ts) {
                return SizeVarianceVerdict { code: SizeVarianceCode.NonMonotonic, idx: i, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: prev_ts, current: observations[i].timestamp_ms, };
            }
        }
        if (observations[i].size < CPSV_MIN_SIZE) {
            return SizeVarianceVerdict { code: SizeVarianceCode.TooSmall, idx: i, got: observations[i].size, bound: CPSV_MIN_SIZE, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        if (observations[i].size > CPSV_MAX_SIZE) {
            return SizeVarianceVerdict { code: SizeVarianceCode.TooLarge, idx: i, got: observations[i].size, bound: CPSV_MAX_SIZE, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
        }
        prev_ts = observations[i].timestamp_ms;
    }
    if (observations.len >= 2) {
        if (cv > CPSV_MAX_CV) {
            return SizeVarianceVerdict { code: SizeVarianceCode.HighCV, idx: 0, got: 0, bound: 0, got_f: cv, bound_f: CPSV_MAX_CV, prev: 0, current: 0, };
        }
    }
    return SizeVarianceVerdict { code: SizeVarianceCode.Ok, idx: 0, got: 0, bound: 0, got_f: 0.0, bound_f: 0.0, prev: 0, current: 0, };
}

// **CPSV-01** - high CV rejected: the band-edge pair, 256 and
// 4096 - a CV of 0.8824 over the ceiling of two tenths.
test cpsv_01_high_cv_rejected {
    const os: [2]CoverSizeObservation = [2]CoverSizeObservation{
        CoverSizeObservation { size: 256, timestamp_ms: 1000, },
        CoverSizeObservation { size: 4096, timestamp_ms: 2000, },
    };
    const v = validate_size_variance(&os, 0.8823529411764706);
    assert(v.code == SizeVarianceCode.HighCV);
    assert(v.got_f == 0.8823529411764706);
    assert(v.bound_f == 0.2);
}

// **CPSV-02** - a size below the minimum rejected: 100 bytes of
// a floor 256.
test cpsv_02_too_small_rejected {
    const os: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 100, timestamp_ms: 1000, },
    };
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.TooSmall);
    assert(v.idx == 0);
    assert(v.got == 100);
    assert(v.bound == 256);
}

// **CPSV-03** - a size above the maximum rejected: 4097 bytes of
// a ceiling 4096.
test cpsv_03_too_large_rejected {
    const os: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 4097, timestamp_ms: 1000, },
    };
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.TooLarge);
    assert(v.idx == 0);
    assert(v.got == 4097);
    assert(v.bound == 4096);
}

// **CPSV-04** - the zero timestamp rejected.
test cpsv_04_zero_timestamp_rejected {
    const os: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 0, },
    };
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.ZeroTimestamp);
    assert(v.idx == 0);
}

// **CPSV-05** - a non-monotonic timestamp rejected: 1000 after
// 2000.
test cpsv_05_non_monotonic_rejected {
    const os: [2]CoverSizeObservation = [2]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 2000, },
        CoverSizeObservation { size: 1024, timestamp_ms: 1000, },
    };
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.NonMonotonic);
    assert(v.idx == 1);
    assert(v.prev == 2000);
    assert(v.current == 1000);
}

// **CPSV-06** - too many rejected: 1025 observations of a
// maximum 1024, built in a loop like the original's, the
// timestamps stepping by one. The batch rule fires before any
// observation is examined.
test cpsv_06_too_many_rejected {
    var os: [1025]CoverSizeObservation;
    for i in 0..1025 {
        os[i] = CoverSizeObservation { size: 1024, timestamp_ms: @as(u64, i) + 1, };
    }
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.TooMany);
    assert(v.got == 1025);
    assert(v.bound == 1024);
}

// **CPSV-07** - the uniform batch accepted: four observations at
// 1024 bytes - a CV of zero.
test cpsv_07_uniform_accepted {
    const os: [4]CoverSizeObservation = [4]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 1000, },
        CoverSizeObservation { size: 1024, timestamp_ms: 2000, },
        CoverSizeObservation { size: 1024, timestamp_ms: 3000, },
        CoverSizeObservation { size: 1024, timestamp_ms: 4000, },
    };
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.Ok);
}

// **CPSV-08** - an empty batch accepted.
test cpsv_08_empty_accepted {
    const os: [0]CoverSizeObservation = [0]CoverSizeObservation{};
    const v = validate_size_variance(&os, 0.0);
    assert(v.code == SizeVarianceCode.Ok);
}

// **CPSV-09** - a single observation accepted: the CV check
// needs two.
test cpsv_09_single_accepted {
    const os: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 1000, },
    };
    const v = validate_size_variance(&os, 0.9);
    assert(v.code == SizeVarianceCode.Ok);
}

// **CPSV-10** - slight variance accepted: 1000, 1020, 980, 1010
// - a CV of 0.0148 under the ceiling.
test cpsv_10_slight_variance_accepted {
    const os: [4]CoverSizeObservation = [4]CoverSizeObservation{
        CoverSizeObservation { size: 1000, timestamp_ms: 1000, },
        CoverSizeObservation { size: 1020, timestamp_ms: 2000, },
        CoverSizeObservation { size: 980, timestamp_ms: 3000, },
        CoverSizeObservation { size: 1010, timestamp_ms: 4000, },
    };
    const v = validate_size_variance(&os, 0.014753316167330712);
    assert(v.code == SizeVarianceCode.Ok);
}

// Rule order is the original's: the zero timestamp before the
// monotonicity, the monotonicity before the size floor, the
// size floor before the size ceiling, and the per-observation
// rules before the batch CV - with both violations on one
// observation.
test rule_order_matches_original {
    const zero_backstep: [2]CoverSizeObservation = [2]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 2000, },
        CoverSizeObservation { size: 1024, timestamp_ms: 0, },
    };
    const v1 = validate_size_variance(&zero_backstep, 0.0);
    assert(v1.code == SizeVarianceCode.ZeroTimestamp);
    assert(v1.idx == 1);

    const backstep_tiny: [2]CoverSizeObservation = [2]CoverSizeObservation{
        CoverSizeObservation { size: 1024, timestamp_ms: 2000, },
        CoverSizeObservation { size: 100, timestamp_ms: 1000, },
    };
    const v2 = validate_size_variance(&backstep_tiny, 0.0);
    assert(v2.code == SizeVarianceCode.NonMonotonic);
    assert(v2.idx == 1);

    const tiny_band: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 100, timestamp_ms: 1000, },
    };
    const v3 = validate_size_variance(&tiny_band, 0.0);
    assert(v3.code == SizeVarianceCode.TooSmall);

    const huge_only: [1]CoverSizeObservation = [1]CoverSizeObservation{
        CoverSizeObservation { size: 4097, timestamp_ms: 1000, },
    };
    const v4 = validate_size_variance(&huge_only, 0.0);
    assert(v4.code == SizeVarianceCode.TooLarge);

    const band_high_cv: [2]CoverSizeObservation = [2]CoverSizeObservation{
        CoverSizeObservation { size: 256, timestamp_ms: 1000, },
        CoverSizeObservation { size: 4096, timestamp_ms: 2000, },
    };
    const v5 = validate_size_variance(&band_high_cv, 0.8823529411764706);
    assert(v5.code == SizeVarianceCode.HighCV);
}
