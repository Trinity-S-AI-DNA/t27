module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_inter_epoch_continuity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_inter_epoch_continuity_guard.rs
// (CR-CHAT-07 - Cover traffic inter-epoch continuity guard,
// Wave-103 Lane A, R-CHAT-10).
//
// The cover rate must hold across epoch boundaries: a rate drop
// at epoch N names the key-rotation point, rate changes
// correlated with membership changes reveal who joined or left,
// and the epoch where the rate moves is the epoch where the
// content moved. The rules, in the original's order: the batch
// ceiling, then per epoch the zero-epoch probe, the rate floor,
// the rate ceiling, the strictly-increasing epoch number and
// the consecutive-rate deviation ceiling (a tenth, measured
// against the previous rate).
//
// The original returns Result<(), ContinuityError>. This port
// carries the verdict as a named struct (owner decision D5): Ok
// first, then the six variants in the original's declaration
// order - DeviationExceeded, NotIncreasing, ZeroEpoch, BelowMin,
// AboveMax, TooMany - with every payload field: idx with prev
// and current rates and the ceiling deviation for
// DeviationExceeded, idx with prev and current epochs for
// NotIncreasing, idx with the rate and its bound for the rate
// rules, and got with max for the ceiling.
//
// The original's arithmetic is f64 throughout - the rates live
// in the records as f64, the deviation is the absolute
// difference over the previous rate - so the port needs no
// casts and no caller-computed statistics: the absolute
// difference is the guarded if, and every fixture value is
// exact in f64. The boundary fixture measures a deviation of
// 0.099 against the ceiling of 0.1.

// Maximum rate deviation between consecutive epochs (msgs/sec).
pub const CTIC_MAX_RATE_DEV: f64 = 0.1;

// Minimum emission rate (msgs/sec).
pub const CTIC_MIN_RATE: f64 = 0.5;

// Maximum emission rate (msgs/sec).
pub const CTIC_MAX_RATE: f64 = 10.0;

// Maximum epochs per batch.
pub const CTIC_MAX_EPOCHS: usize = 256;

// An epoch's cover traffic rate record.
pub struct EpochRate {
    epoch: u64,
    rate: f64,
}

// Verdict codes: Ok(()) and ContinuityError's variants, in declaration order.
pub enum ContinuityCode {
    Ok,
    DeviationExceeded,
    NotIncreasing,
    ZeroEpoch,
    BelowMin,
    AboveMax,
    TooMany,
}

// The verdict of the inter-epoch continuity validation, with
// every error payload field.
pub struct ContinuityVerdict {
    code: ContinuityCode,
    idx: usize,
    got: usize,
    bound: usize,
    prev_epoch: u64,
    current_epoch: u64,
    prev_rate: f64,
    current_rate: f64,
    bound_f: f64,
}

// The absolute difference of two rates - the original's .abs()
// on the deviation numerator, the guarded if.
pub fn rate_abs_diff(a: f64, b: f64) -> f64 {
    if (a > b) {
        return a - b;
    }
    return b - a;
}

// [VERIFIED] Validate cover traffic inter-epoch continuity.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, then per epoch the zero
// epoch, the rate floor, the rate ceiling, the strictly-
// increasing epoch and the consecutive-rate deviation ceiling.
pub fn validate_inter_epoch_continuity(epochs: []const EpochRate) -> ContinuityVerdict {
    if (epochs.len > CTIC_MAX_EPOCHS) {
        return ContinuityVerdict { code: ContinuityCode.TooMany, idx: 0, got: epochs.len, bound: CTIC_MAX_EPOCHS, prev_epoch: 0, current_epoch: 0, prev_rate: 0.0, current_rate: 0.0, bound_f: 0.0, };
    }
    var prev_epoch: u64 = 0;
    var prev_rate: f64 = 0.0;
    for i in 0..epochs.len {
        if (epochs[i].epoch == 0) {
            return ContinuityVerdict { code: ContinuityCode.ZeroEpoch, idx: i, got: 0, bound: 0, prev_epoch: 0, current_epoch: 0, prev_rate: 0.0, current_rate: 0.0, bound_f: 0.0, };
        }
        if (epochs[i].rate < CTIC_MIN_RATE) {
            return ContinuityVerdict { code: ContinuityCode.BelowMin, idx: i, got: 0, bound: 0, prev_epoch: 0, current_epoch: 0, prev_rate: 0.0, current_rate: epochs[i].rate, bound_f: CTIC_MIN_RATE, };
        }
        if (epochs[i].rate > CTIC_MAX_RATE) {
            return ContinuityVerdict { code: ContinuityCode.AboveMax, idx: i, got: 0, bound: 0, prev_epoch: 0, current_epoch: 0, prev_rate: 0.0, current_rate: epochs[i].rate, bound_f: CTIC_MAX_RATE, };
        }
        if (i > 0) {
            if (epochs[i].epoch <= prev_epoch) {
                return ContinuityVerdict { code: ContinuityCode.NotIncreasing, idx: i, got: 0, bound: 0, prev_epoch: prev_epoch, current_epoch: epochs[i].epoch, prev_rate: 0.0, current_rate: 0.0, bound_f: 0.0, };
            }
            const dev: f64 = rate_abs_diff(epochs[i].rate, prev_rate) / prev_rate;
            if (dev > CTIC_MAX_RATE_DEV) {
                return ContinuityVerdict { code: ContinuityCode.DeviationExceeded, idx: i, got: 0, bound: 0, prev_epoch: 0, current_epoch: 0, prev_rate: prev_rate, current_rate: epochs[i].rate, bound_f: CTIC_MAX_RATE_DEV, };
            }
        }
        prev_epoch = epochs[i].epoch;
        prev_rate = epochs[i].rate;
    }
    return ContinuityVerdict { code: ContinuityCode.Ok, idx: 0, got: 0, bound: 0, prev_epoch: 0, current_epoch: 0, prev_rate: 0.0, current_rate: 0.0, bound_f: 0.0, };
}

// **CTIC-01** - the deviation ceiling rejected: 3.0 after 2.0 -
// a deviation of 0.5 over the ceiling of 0.1.
test ctic_01_deviation_exceeded_rejected {
    const es: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 1, rate: 2.0, },
        EpochRate { epoch: 2, rate: 3.0, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.DeviationExceeded);
    assert(v.idx == 1);
    assert(v.prev_rate == 2.0);
    assert(v.current_rate == 3.0);
    assert(v.bound_f == 0.1);
}

// **CTIC-02** - a non-increasing epoch rejected: epoch three
// after epoch five.
test ctic_02_not_increasing_rejected {
    const es: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 5, rate: 2.0, },
        EpochRate { epoch: 3, rate: 2.0, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.NotIncreasing);
    assert(v.idx == 1);
    assert(v.prev_epoch == 5);
    assert(v.current_epoch == 3);
}

// **CTIC-03** - the zero epoch rejected.
test ctic_03_zero_epoch_rejected {
    const es: [1]EpochRate = [1]EpochRate{
        EpochRate { epoch: 0, rate: 2.0, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.ZeroEpoch);
    assert(v.idx == 0);
}

// **CTIC-04** - a rate below the minimum rejected: 0.1 of a
// floor 0.5.
test ctic_04_below_min_rejected {
    const es: [1]EpochRate = [1]EpochRate{
        EpochRate { epoch: 1, rate: 0.1, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.BelowMin);
    assert(v.idx == 0);
    assert(v.current_rate == 0.1);
    assert(v.bound_f == 0.5);
}

// **CTIC-05** - a rate above the maximum rejected: 15.0 of a
// ceiling 10.0.
test ctic_05_above_max_rejected {
    const es: [1]EpochRate = [1]EpochRate{
        EpochRate { epoch: 1, rate: 15.0, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.AboveMax);
    assert(v.idx == 0);
    assert(v.current_rate == 15.0);
    assert(v.bound_f == 10.0);
}

// **CTIC-06** - too many rejected: 257 epochs of a maximum 256,
// built in a loop like the original's, the epochs walking one
// upward. The batch rule fires before any epoch is examined.
test ctic_06_too_many_rejected {
    var es: [257]EpochRate;
    for i in 0..257 {
        es[i] = EpochRate { epoch: @as(u64, i) + 1, rate: 2.0, };
    }
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.TooMany);
    assert(v.got == 257);
    assert(v.bound == 256);
}

// **CTIC-07** - the valid batch accepted: 2.0, 2.05, 1.95 -
// deviations 0.025 and 0.049, both under the ceiling.
test ctic_07_valid_accepted {
    const es: [3]EpochRate = [3]EpochRate{
        EpochRate { epoch: 1, rate: 2.0, },
        EpochRate { epoch: 2, rate: 2.05, },
        EpochRate { epoch: 3, rate: 1.95, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.Ok);
}

// **CTIC-08** - an empty batch accepted.
test ctic_08_empty_accepted {
    const es: [0]EpochRate = [0]EpochRate{};
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.Ok);
}

// **CTIC-09** - a single epoch accepted: the deviation check
// needs a predecessor.
test ctic_09_single_accepted {
    const es: [1]EpochRate = [1]EpochRate{
        EpochRate { epoch: 1, rate: 2.0, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.Ok);
}

// **CTIC-10** - the deviation boundary accepted: 2.198 after
// 2.0 - a deviation of 0.099 against the ceiling of 0.1.
test ctic_10_boundary_accepted {
    const es: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 1, rate: 2.0, },
        EpochRate { epoch: 2, rate: 2.198, },
    };
    const v = validate_inter_epoch_continuity(&es);
    assert(v.code == ContinuityCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test rate_abs_diff_answers {
    assert(rate_abs_diff(3.0, 2.0) == 1.0);
    assert(rate_abs_diff(2.0, 3.0) == 1.0);
    assert(rate_abs_diff(2.0, 2.0) == 0.0);
    assert(rate_abs_diff(0.1, 0.0) == 0.1);
}

// Rule order is the original's: the zero epoch before the rate
// floor, the rate floor before the rate ceiling, the rate
// bounds before the epoch monotonicity, and the monotonicity
// before the deviation - with both violations on one epoch.
test rule_order_matches_original {
    const zero_low: [1]EpochRate = [1]EpochRate{
        EpochRate { epoch: 0, rate: 0.1, },
    };
    const v1 = validate_inter_epoch_continuity(&zero_low);
    assert(v1.code == ContinuityCode.ZeroEpoch);

    const low_backstep: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 5, rate: 2.0, },
        EpochRate { epoch: 3, rate: 0.1, },
    };
    const v2 = validate_inter_epoch_continuity(&low_backstep);
    assert(v2.code == ContinuityCode.BelowMin);
    assert(v2.idx == 1);

    const backstep_deviant: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 5, rate: 2.0, },
        EpochRate { epoch: 3, rate: 9.0, },
    };
    const v3 = validate_inter_epoch_continuity(&backstep_deviant);
    assert(v3.code == ContinuityCode.NotIncreasing);
    assert(v3.idx == 1);

    const deviant_pair: [2]EpochRate = [2]EpochRate{
        EpochRate { epoch: 1, rate: 2.0, },
        EpochRate { epoch: 2, rate: 8.0, },
    };
    const v4 = validate_inter_epoch_continuity(&deviant_pair);
    assert(v4.code == ContinuityCode.DeviationExceeded);
    assert(v4.idx == 1);
    assert(v4.prev_rate == 2.0);
    assert(v4.current_rate == 8.0);
}
