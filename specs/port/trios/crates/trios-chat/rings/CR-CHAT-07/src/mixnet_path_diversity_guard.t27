module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::mixnet_path_diversity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/mixnet_path_diversity_guard.rs
// (CR-CHAT-07 - Mixnet path diversity guard, Wave-73 Lane B,
// R-CHAT-10).
//
// Consecutive messages must not share their hop-sets: shared
// relays let an observer link the pair, repeated entries
// reveal the entry node, and small overlaps across many
// messages narrow the sender down. The rules, in the
// original's order: the path-pair floor (two), then per path
// the length floor (three), the length ceiling (eight), and
// per relay the zero probe and the in-path duplicate scan,
// then per consecutive pair the overlap ceiling (one shared
// relay).
//
// The original returns Result<(), PathDiversityError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the six variants in the original's
// declaration order - TooMuchOverlap, PathTooShort,
// PathTooLong, DuplicateRelay, ZeroRelayId, TooFewPaths -
// with the one payload field: the measured overlap rides the
// verdict for TooMuchOverlap.
//
// The original's slice-of-slices parameter becomes a record
// with a fixed eight-relay capacity plus its length (t27 has
// no slice fields); every fixture path fits. The BTreeSet
// probes become scans: an in-path duplicate is a relay equal
// to an earlier one, the consecutive-pair overlap a count of
// relays of one path equal to relays of the other. The max
// path length is the record capacity itself.

// Maximum shared relays between consecutive paths.
pub const MPDG_MAX_OVERLAP: usize = 1;

// Minimum path length.
pub const MPDG_MIN_PATH_LEN: usize = 3;

// Maximum path length (and the record capacity).
pub const MPDG_MAX_PATH_LEN: usize = 8;

// A mixnet path: up to eight relays plus its length.
pub struct MixPath {
    relays: [8]u64,
    path_len: usize,
}

// Verdict codes: Ok(()) and PathDiversityError's variants, in declaration order.
pub enum PathDiversityCode {
    Ok,
    TooMuchOverlap,
    PathTooShort,
    PathTooLong,
    DuplicateRelay,
    ZeroRelayId,
    TooFewPaths,
}

// The verdict of the path diversity validation, with the one
// error payload field.
pub struct PathDiversityVerdict {
    code: PathDiversityCode,
    overlap: usize,
}

// Whether slot i of a path repeats an earlier relay - the
// original's in-path BTreeSet insert probe, answered by a
// scan.
pub fn relay_seen_before(path: []const u64, i: usize) -> bool {
    for j in 0..i {
        if (path[j] == path[i]) {
            return true;
        }
    }
    return false;
}

// How many relays of path a equal relays of path b - the
// original's set intersection, answered by a double scan.
pub fn path_overlap(a: []const u64, b: []const u64, a_len: usize, b_len: usize) -> usize {
    var overlap: usize = 0;
    for i in 0..a_len {
        for j in 0..b_len {
            if (a[i] == b[j]) {
                overlap = overlap + 1;
            }
        }
    }
    return overlap;
}

// [VERIFIED] Validate that consecutive mixnet paths have
// sufficient diversity. Returns Ok only when every rule holds,
// checked in the original's order: the path-pair floor, then
// per path the length floor, the length ceiling and the per-
// relay zero and duplicate scans, then per consecutive pair
// the overlap ceiling.
pub fn validate_path_diversity(paths: []const MixPath) -> PathDiversityVerdict {
    if (paths.len < 2) {
        return PathDiversityVerdict { code: PathDiversityCode.TooFewPaths, overlap: 0, };
    }
    for p in 0..paths.len {
        if (paths[p].path_len < MPDG_MIN_PATH_LEN) {
            return PathDiversityVerdict { code: PathDiversityCode.PathTooShort, overlap: 0, };
        }
        if (paths[p].path_len > MPDG_MAX_PATH_LEN) {
            return PathDiversityVerdict { code: PathDiversityCode.PathTooLong, overlap: 0, };
        }
        for r in 0..paths[p].path_len {
            if (paths[p].relays[r] == 0) {
                return PathDiversityVerdict { code: PathDiversityCode.ZeroRelayId, overlap: 0, };
            }
            if (relay_seen_before(&paths[p].relays, r)) {
                return PathDiversityVerdict { code: PathDiversityCode.DuplicateRelay, overlap: 0, };
            }
        }
    }
    for w in 0..paths.len - 1 {
        var a_sliced: [8]u64 = paths[w].relays;
        var b_sliced: [8]u64 = paths[w + 1].relays;
        const overlap: usize = path_overlap(&a_sliced, &b_sliced, paths[w].path_len, paths[w + 1].path_len);
        if (overlap > MPDG_MAX_OVERLAP) {
            return PathDiversityVerdict { code: PathDiversityCode.TooMuchOverlap, overlap: overlap, };
        }
    }
    return PathDiversityVerdict { code: PathDiversityCode.Ok, overlap: 0, };
}

// The three diverse fixture paths: 10-20-30, 40-50-60,
// 70-80-90.
pub const PATH_A: MixPath = MixPath { relays: [8]u64{10, 20, 30, 0, 0, 0, 0, 0,}, path_len: 3, };
pub const PATH_B: MixPath = MixPath { relays: [8]u64{40, 50, 60, 0, 0, 0, 0, 0,}, path_len: 3, };
pub const PATH_C: MixPath = MixPath { relays: [8]u64{70, 80, 90, 0, 0, 0, 0, 0,}, path_len: 3, };

// **MPDG-01** - too much overlap rejected: 10-20-30 against
// 10-20-40 - two shared relays over the ceiling of one.
test mpdg_01_overlap_rejected {
    const p1: MixPath = MixPath { relays: [8]u64{10, 20, 30, 0, 0, 0, 0, 0,}, path_len: 3, };
    const p2: MixPath = MixPath { relays: [8]u64{10, 20, 40, 0, 0, 0, 0, 0,}, path_len: 3, };
    const paths: [2]MixPath = [2]MixPath{ p1, p2, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.TooMuchOverlap);
    assert(v.overlap == 2);
}

// **MPDG-02** - a two-relay path rejected: too short of the
// three floor.
test mpdg_02_too_short_rejected {
    const p1: MixPath = MixPath { relays: [8]u64{10, 20, 0, 0, 0, 0, 0, 0,}, path_len: 2, };
    const p2: MixPath = MixPath { relays: [8]u64{30, 40, 0, 0, 0, 0, 0, 0,}, path_len: 2, };
    const paths: [2]MixPath = [2]MixPath{ p1, p2, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.PathTooShort);
}

// **MPDG-03** - a nine-relay path rejected: over the ceiling
// of eight.
test mpdg_03_too_long_rejected {
    const p1: MixPath = MixPath { relays: [8]u64{10, 20, 30, 40, 50, 60, 70, 80,}, path_len: 9, };
    const paths: [2]MixPath = [2]MixPath{ p1, PATH_B, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.PathTooLong);
}

// **MPDG-04** - a duplicate relay in one path rejected:
// 10-10-30.
test mpdg_04_duplicate_rejected {
    const p1: MixPath = MixPath { relays: [8]u64{10, 10, 30, 0, 0, 0, 0, 0,}, path_len: 3, };
    const paths: [2]MixPath = [2]MixPath{ p1, PATH_B, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.DuplicateRelay);
}

// **MPDG-05** - a zero relay rejected: 10-0-30.
test mpdg_05_zero_relay_rejected {
    const p1: MixPath = MixPath { relays: [8]u64{10, 0, 30, 0, 0, 0, 0, 0,}, path_len: 3, };
    const paths: [2]MixPath = [2]MixPath{ p1, PATH_B, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.ZeroRelayId);
}

// **MPDG-06** - a single path rejected: the pair floor of two.
test mpdg_06_too_few_rejected {
    const paths: [1]MixPath = [1]MixPath{ PATH_A, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.TooFewPaths);
}

// **MPDG-07** - two diverse paths accepted.
test mpdg_07_diverse_accepted {
    const paths: [2]MixPath = [2]MixPath{ PATH_A, PATH_B, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.Ok);
}

// **MPDG-08** - a single shared relay accepted: 10-20-30
// against 30-40-50, exactly the ceiling.
test mpdg_08_single_overlap_accepted {
    const p1: MixPath = MixPath { relays: [8]u64{10, 20, 30, 0, 0, 0, 0, 0,}, path_len: 3, };
    const p2: MixPath = MixPath { relays: [8]u64{30, 40, 50, 0, 0, 0, 0, 0,}, path_len: 3, };
    const paths: [2]MixPath = [2]MixPath{ p1, p2, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.Ok);
}

// **MPDG-09** - three diverse paths accepted.
test mpdg_09_three_paths_accepted {
    const paths: [3]MixPath = [3]MixPath{ PATH_A, PATH_B, PATH_C, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.Ok);
}

// **MPDG-10** - the maximum path length accepted: two
// eight-relay paths, disjoint relays.
test mpdg_10_max_len_accepted {
    const p1: MixPath = MixPath { relays: [8]u64{10, 20, 30, 40, 50, 60, 70, 80,}, path_len: 8, };
    const p2: MixPath = MixPath { relays: [8]u64{1000, 1010, 1020, 1030, 1040, 1050, 1060, 1070,}, path_len: 8, };
    const paths: [2]MixPath = [2]MixPath{ p1, p2, };
    const v = validate_path_diversity(&paths);
    assert(v.code == PathDiversityCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test mpdg_helpers_answer {
    const p: [3]u64 = [3]u64{10, 20, 10,};
    assert(!relay_seen_before(&p, 0));
    assert(!relay_seen_before(&p, 1));
    assert(relay_seen_before(&p, 2));
    const a: [3]u64 = [3]u64{10, 20, 30,};
    const b: [3]u64 = [3]u64{30, 40, 50,};
    assert(path_overlap(&a, &b, 3, 3) == 1);
    const c: [3]u64 = [3]u64{10, 20, 30,};
    const d: [3]u64 = [3]u64{10, 20, 40,};
    assert(path_overlap(&c, &d, 3, 3) == 2);
    const e: [3]u64 = [3]u64{10, 20, 30,};
    const f: [3]u64 = [3]u64{40, 50, 60,};
    assert(path_overlap(&e, &f, 3, 3) == 0);
}

// Rule order is the original's: the pair floor before any
// path, the length floor before the length ceiling, the length
// bounds before the per-relay scans, the zero probe before
// the duplicate, the per-path rules before the pair overlap,
// and the overlap answer rides the verdict.
test rule_order_matches_original {
    const single_short: [1]MixPath = [1]MixPath{
        MixPath { relays: [8]u64{10, 10, 0, 0, 0, 0, 0, 0,}, path_len: 2, },
    };
    const v1 = validate_path_diversity(&single_short);
    assert(v1.code == PathDiversityCode.TooFewPaths);

    const short_zero: [2]MixPath = [2]MixPath{
        MixPath { relays: [8]u64{10, 0, 0, 0, 0, 0, 0, 0,}, path_len: 2, },
        MixPath { relays: [8]u64{40, 50, 60, 0, 0, 0, 0, 0,}, path_len: 3, },
    };
    const v2 = validate_path_diversity(&short_zero);
    assert(v2.code == PathDiversityCode.PathTooShort);

    const long_zero: [2]MixPath = [2]MixPath{
        MixPath { relays: [8]u64{10, 20, 30, 40, 50, 60, 70, 80,}, path_len: 9, },
        MixPath { relays: [8]u64{40, 50, 60, 0, 0, 0, 0, 0,}, path_len: 3, },
    };
    const v3 = validate_path_diversity(&long_zero);
    assert(v3.code == PathDiversityCode.PathTooLong);

    const zero_dup: [2]MixPath = [2]MixPath{
        MixPath { relays: [8]u64{10, 0, 0, 0, 0, 0, 0, 0,}, path_len: 3, },
        MixPath { relays: [8]u64{40, 50, 60, 0, 0, 0, 0, 0,}, path_len: 3, },
    };
    const v4 = validate_path_diversity(&zero_dup);
    assert(v4.code == PathDiversityCode.ZeroRelayId);

    const dup_zero: [2]MixPath = [2]MixPath{
        MixPath { relays: [8]u64{10, 10, 0, 0, 0, 0, 0, 0,}, path_len: 3, },
        MixPath { relays: [8]u64{40, 50, 60, 0, 0, 0, 0, 0,}, path_len: 3, },
    };
    const v5 = validate_path_diversity(&dup_zero);
    assert(v5.code == PathDiversityCode.DuplicateRelay);

    const clean_overlap: [2]MixPath = [2]MixPath{
        MixPath { relays: [8]u64{10, 20, 30, 0, 0, 0, 0, 0,}, path_len: 3, },
        MixPath { relays: [8]u64{10, 20, 40, 0, 0, 0, 0, 0,}, path_len: 3, },
    };
    const v6 = validate_path_diversity(&clean_overlap);
    assert(v6.code == PathDiversityCode.TooMuchOverlap);
    assert(v6.overlap == 2);
}
