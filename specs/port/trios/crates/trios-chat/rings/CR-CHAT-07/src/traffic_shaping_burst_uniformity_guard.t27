module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::traffic_shaping_burst_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/traffic_shaping_burst_uniformity_guard.rs
// (CR-CHAT-07 - Traffic shaping burst uniformity guard, Wave-65
// Lane B, R-CHAT-7).
//
// Traffic shaping hides message sizes by batching into uniform
// bursts; a non-uniform batch lets an observer tell padding
// from real traffic, fingerprint the user by timing and count
// messages by size. The rules, in the original's order: the
// count floor (two), the count ceiling (two hundred
// fifty-six), the first burst's size floor (sixty-four) and
// ceiling (sixty-five thousand five hundred thirty-six), then
// the per-burst walk (a size differing from the first answers
// before that burst's own floor and ceiling), and the
// interval uniformity walk over batches of three or more
// (every inter-burst gap must equal the first).
//
// The original returns Result<(), BurstUniformityError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the six variants in the original's
// declaration order - NonUniformSize, BurstTooSmall,
// BurstTooLarge, TooFewBursts, TooManyBursts,
// NonUniformInterval. Every original variant carries no
// payload, so the code is the whole verdict.
//
// The original casts the timestamps to i64 to subtract the
// gaps; t27 rejects the i64 cast, so the gap equality is
// re-based additively - gap(i) equals gap(0) exactly when
// ts[i+1] + ts[0] equals ts[1] + ts[i], pure u64 addition
// with no subtraction to underflow. The re-basing keeps the
// original's edge semantics: a uniformly decreasing batch has
// equal negative gaps and stays accepted, pinned by a test
// below. Batches of two skip the interval walk exactly as the
// original's len >= 3 gate.

// Minimum burst size (bytes).
pub const TSBU_MIN_BURST: usize = 64;

// Maximum burst size (bytes).
pub const TSBU_MAX_BURST: usize = 65536;

// Minimum number of bursts in a batch.
pub const TSBU_MIN_COUNT: usize = 2;

// Maximum number of bursts in a batch.
pub const TSBU_MAX_COUNT: usize = 256;

// A shaped burst.
pub struct ShapedBurst {
    size: usize,
    timestamp_ms: u64,
}

// Verdict codes: Ok(()) and BurstUniformityError's variants, in declaration order.
pub enum TsbuCode {
    Ok,
    NonUniformSize,
    BurstTooSmall,
    BurstTooLarge,
    TooFewBursts,
    TooManyBursts,
    NonUniformInterval,
}

// The verdict of the burst uniformity validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct TsbuVerdict {
    code: TsbuCode,
}

// [VERIFIED] Validate that a batch of shaped bursts is
// uniform. Returns Ok only when every rule holds, checked in
// the original's order: the count floor and ceiling, the
// first burst's size floor and ceiling, the per-burst size
// walk, then the interval uniformity walk over batches of
// three or more.
pub fn validate_burst_uniformity(bursts: []const ShapedBurst) -> TsbuVerdict {
    if (bursts.len < TSBU_MIN_COUNT) {
        return TsbuVerdict { code: TsbuCode.TooFewBursts, };
    }
    if (bursts.len > TSBU_MAX_COUNT) {
        return TsbuVerdict { code: TsbuCode.TooManyBursts, };
    }
    const first_size: usize = bursts[0].size;
    if (first_size < TSBU_MIN_BURST) {
        return TsbuVerdict { code: TsbuCode.BurstTooSmall, };
    }
    if (first_size > TSBU_MAX_BURST) {
        return TsbuVerdict { code: TsbuCode.BurstTooLarge, };
    }
    for i in 1..bursts.len {
        if (bursts[i].size != first_size) {
            return TsbuVerdict { code: TsbuCode.NonUniformSize, };
        }
        if (bursts[i].size < TSBU_MIN_BURST) {
            return TsbuVerdict { code: TsbuCode.BurstTooSmall, };
        }
        if (bursts[i].size > TSBU_MAX_BURST) {
            return TsbuVerdict { code: TsbuCode.BurstTooLarge, };
        }
    }
    if (bursts.len >= 3) {
        for i in 1..(bursts.len - 1) {
            if (bursts[i + 1].timestamp_ms + bursts[0].timestamp_ms != bursts[1].timestamp_ms + bursts[i].timestamp_ms) {
                return TsbuVerdict { code: TsbuCode.NonUniformInterval, };
            }
        }
    }
    return TsbuVerdict { code: TsbuCode.Ok, };
}

// **TSBU-01** - the non-uniform size rejected: the second
// burst doubles the first.
test tsbu_01_non_uniform_size_rejected {
    const bursts: [3]ShapedBurst = [3]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
        ShapedBurst { size: 2048, timestamp_ms: 2000, },
        ShapedBurst { size: 1024, timestamp_ms: 3000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.NonUniformSize);
}

// **TSBU-02** - the burst too small rejected: thirty-two
// bytes of a floor of sixty-four.
test tsbu_02_too_small_rejected {
    const bursts: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 32, timestamp_ms: 1000, },
        ShapedBurst { size: 32, timestamp_ms: 2000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.BurstTooSmall);
}

// **TSBU-03** - the burst too large rejected: one byte over
// the ceiling.
test tsbu_03_too_large_rejected {
    const bursts: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 65537, timestamp_ms: 1000, },
        ShapedBurst { size: 65537, timestamp_ms: 2000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.BurstTooLarge);
}

// **TSBU-04** - too few bursts rejected: one burst of the
// floor of two.
test tsbu_04_too_few_rejected {
    const bursts: [1]ShapedBurst = [1]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.TooFewBursts);
}

// **TSBU-05** - too many bursts rejected: two hundred
// fifty-seven of a ceiling of two hundred fifty-six, built in
// a loop like the original's; the count rule fires before any
// size is examined.
test tsbu_05_too_many_rejected {
    var bursts: [257]ShapedBurst;
    for i in 0..257 {
        bursts[i] = ShapedBurst { size: 1024, timestamp_ms: @as(u64, i) * 1000, };
    }
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.TooManyBursts);
}

// **TSBU-06** - the non-uniform interval rejected: gaps of
// one thousand then two thousand.
test tsbu_06_non_uniform_interval_rejected {
    const bursts: [3]ShapedBurst = [3]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
        ShapedBurst { size: 1024, timestamp_ms: 2000, },
        ShapedBurst { size: 1024, timestamp_ms: 4000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.NonUniformInterval);
}

// **TSBU-07** - the uniform batch accepted: four bursts of
// one thousand twenty-four bytes, gaps of one thousand.
test tsbu_07_uniform_accepted {
    const bursts: [4]ShapedBurst = [4]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
        ShapedBurst { size: 1024, timestamp_ms: 2000, },
        ShapedBurst { size: 1024, timestamp_ms: 3000, },
        ShapedBurst { size: 1024, timestamp_ms: 4000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.Ok);
}

// **TSBU-08** - two bursts accepted: the interval walk never
// runs under the length-three gate.
test tsbu_08_two_bursts_accepted {
    const bursts: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 512, timestamp_ms: 1000, },
        ShapedBurst { size: 512, timestamp_ms: 9999, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.Ok);
}

// **TSBU-09** - the minimum burst size accepted: exactly
// sixty-four bytes.
test tsbu_09_min_burst_accepted {
    const bursts: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 64, timestamp_ms: 1000, },
        ShapedBurst { size: 64, timestamp_ms: 2000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.Ok);
}

// **TSBU-10** - the maximum burst size accepted: exactly
// sixty-five thousand five hundred thirty-six bytes.
test tsbu_10_max_burst_accepted {
    const bursts: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 65536, timestamp_ms: 1000, },
        ShapedBurst { size: 65536, timestamp_ms: 2000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.Ok);
}

// The additive re-basing keeps the original's i64 edge: a
// uniformly decreasing batch has equal negative gaps and
// stays accepted.
test additive_interval_rebase_answers {
    const bursts: [3]ShapedBurst = [3]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 5000, },
        ShapedBurst { size: 1024, timestamp_ms: 4000, },
        ShapedBurst { size: 1024, timestamp_ms: 3000, },
    };
    const v = validate_burst_uniformity(&bursts);
    assert(v.code == TsbuCode.Ok);
}

// Rule order is the original's: the count floor answers
// before any size rule - a single tiny burst answers
// TooFewBursts - the count ceiling answers over a flooded
// batch of tiny bursts, the first burst's size rules answer
// before the per-burst walk - a tiny first burst over a
// normal second answers BurstTooSmall, not NonUniformSize -
// and the per-burst non-uniform probe answers before that
// burst's own floor - a second burst both differing and tiny
// answers NonUniformSize - and the size walk answers before
// the interval walk ever reads a timestamp.
test rule_order_matches_original {
    const single_tiny: [1]ShapedBurst = [1]ShapedBurst{
        ShapedBurst { size: 32, timestamp_ms: 1000, },
    };
    const v1 = validate_burst_uniformity(&single_tiny);
    assert(v1.code == TsbuCode.TooFewBursts);

    var flooded: [257]ShapedBurst;
    for i in 0..257 {
        flooded[i] = ShapedBurst { size: 32, timestamp_ms: @as(u64, i) * 1000, };
    }
    const v2 = validate_burst_uniformity(&flooded);
    assert(v2.code == TsbuCode.TooManyBursts);

    const tiny_first: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 32, timestamp_ms: 1000, },
        ShapedBurst { size: 1024, timestamp_ms: 2000, },
    };
    const v3 = validate_burst_uniformity(&tiny_first);
    assert(v3.code == TsbuCode.BurstTooSmall);

    const tiny_diff_second: [2]ShapedBurst = [2]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
        ShapedBurst { size: 32, timestamp_ms: 2000, },
    };
    const v4 = validate_burst_uniformity(&tiny_diff_second);
    assert(v4.code == TsbuCode.NonUniformSize);

    const sizes_first: [3]ShapedBurst = [3]ShapedBurst{
        ShapedBurst { size: 1024, timestamp_ms: 1000, },
        ShapedBurst { size: 2048, timestamp_ms: 2000, },
        ShapedBurst { size: 1024, timestamp_ms: 5000, },
    };
    const v5 = validate_burst_uniformity(&sizes_first);
    assert(v5.code == TsbuCode.NonUniformSize);
}
