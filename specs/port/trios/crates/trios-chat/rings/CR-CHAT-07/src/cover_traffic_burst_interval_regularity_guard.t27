module port::cover_traffic_burst_interval_regularity_guard;

// CR-CHAT-07 - Cover traffic burst interval regularity guard (Wave-2 Lane A).
//
// BURST INTERVAL REGULARITY GUARD - ensure consistent spacing between bursts, R-CHAT-07.
//
// The cover traffic system must maintain regular intervals between burst periods
// to avoid creating predictable patterns. This guard monitors the timing and
// regularity of burst intervals to ensure they don't reveal timing information.
//
// Key monitoring criteria:
//
// 1. Interval consistency between burst periods
// 2. Avoidance of regular patterns in burst timing
// 3. Random distribution of burst intervals
// 4. Prevention of burst clustering in time
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_burst_interval_regularity_guard.rs
// (gHashTag/trios at 8b229e9489ee).

// Minimum interval between bursts in milliseconds.
pub const CBRG_MIN_INTERVAL: usize = 5000;

// Maximum interval between bursts in milliseconds.
pub const CBRG_MAX_INTERVAL: usize = 30000;

// Maximum allowed regularity score (higher = more regular).
pub const CBRG_MAX_REGULARITY_SCORE: f64 = 0.8;

// Minimum allowed randomness score.
pub const CBRG_MIN_RANDOMNESS_SCORE: f64 = 0.3;

// Guard result codes.
pub enum GuardResult {
    Pass,
    Fail,
    InvalidInput,
}

// Verdict codes for burst interval regularity.
pub const CBRG_OK: i32 = 0;
pub const CBRG_ERR_REGULARITY_TOO_HIGH: i32 = 1;
pub const CBRG_ERR_RANDOMNESS_TOO_LOW: i32 = 2;
pub const CBRG_ERR_INVALID_INPUT: i32 = 3;

// Calculate regularity score for burst intervals.
pub fn calculate_regularity_score(intervals: &[usize]) -> f64 {
    if (intervals.len() < 3) {
        return 0.0; // Not enough data for analysis
    }
    
    // Calculate mean interval
    let mut sum: usize = 0;
    let mut i: usize = 0;
    while (i < intervals.len()) {
        sum = sum + intervals[i];
        i = i + 1;
    }
    let mean = sum as f64 / intervals.len() as f64;
    
    // Calculate variance
    let mut variance: f64 = 0.0;
    let mut j: usize = 0;
    while (j < intervals.len()) {
        let diff = intervals[j] as f64 - mean;
        variance = variance + (diff * diff);
        j = j + 1;
    }
    variance = variance / intervals.len() as f64;
    
    // Calculate standard deviation
    let std_dev = variance.sqrt();
    
    // Regularity score: lower std_dev relative to mean = more regular
    if (mean > 0.0) {
        return 1.0 - (std_dev / mean);
    }
    return 0.0;
}

// Check if burst intervals are sufficiently random.
pub fn check_randomness(intervals: &[usize]) -> i32 {
    if (intervals.len() < 5) {
        return CBRG_OK; // Not enough data
    }
    
    // Simple randomness check: intervals should vary significantly
    let mut min_interval: usize = intervals[0];
    let mut max_interval: usize = intervals[0];
    let mut i: usize = 1;
    while (i < intervals.len()) {
        if (intervals[i] < min_interval) {
            min_interval = intervals[i];
        }
        if (intervals[i] > max_interval) {
            max_interval = intervals[i];
        }
        i = i + 1;
    }
    
    // If range is too small, intervals are not random enough
    let range_ratio = (max_interval - min_interval) as f64 / max_interval as f64;
    if (range_ratio < CBRG_MIN_RANDOMNESS_SCORE) {
        return CBRG_ERR_RANDOMNESS_TOO_LOW;
    }
    
    CBRG_OK
}

// Validate burst interval regularity.
pub fn validate_burst_intervals(intervals: &[usize]) -> i32 {
    // Validate input
    if (intervals.len() == 0) {
        return CBRG_ERR_INVALID_INPUT;
    }
    
    // Check each interval is within valid range
    let mut i: usize = 0;
    while (i < intervals.len()) {
        if (intervals[i] < CBRG_MIN_INTERVAL || intervals[i] > CBRG_MAX_INTERVAL) {
            return CBRG_ERR_INVALID_INPUT;
        }
        i = i + 1;
    }
    
    // Calculate regularity score
    let regularity_score = calculate_regularity_score(intervals);
    if (regularity_score > CBRG_MAX_REGULARITY_SCORE) {
        return CBRG_ERR_REGULARITY_TOO_HIGH;
    }
    
    // Check randomness
    let randomness_result = check_randomness(intervals);
    if (randomness_result != CBRG_OK) {
        return randomness_result;
    }
    
    CBRG_OK
}

// CBRG-01 - normal intervals accepted.
test cbrg_01_normal_intervals {
    let intervals = [6000, 7000, 6500, 8000, 7500];
    let result = validate_burst_intervals(&intervals);
    assert(result == CBRG_OK);
}

// CBRG-02 - too regular intervals rejected.
test cbrg_02_too_regular {
    let intervals = [6000, 6000, 6000, 6000, 6000];
    let result = validate_burst_intervals(&intervals);
    assert(result == CBRG_ERR_REGULARITY_TOO_HIGH);
}

// CBRG-03 - insufficient randomness rejected.
test cbrg_03_insufficient_randomness {
    let intervals = [6000, 6010, 6020, 6030, 6040];
    let result = validate_burst_intervals(&intervals);
    assert(result == CBRG_ERR_RANDOMNESS_TOO_LOW);
}

// CBRG-04 - interval range validation.
test cbrg_04_interval_range {
    let intervals = [1000, 7000, 8000]; // First interval too small
    let result = validate_burst_intervals(&intervals);
    assert(result == CBRG_ERR_INVALID_INPUT);
}

// CBRG-05 - calculate regularity score test.
test cbrg_05_regularity_score {
    let intervals = [6000, 7000, 8000, 6000, 7000];
    let score = calculate_regularity_score(&intervals);
    assert(score >= 0.0 && score <= 1.0);
}