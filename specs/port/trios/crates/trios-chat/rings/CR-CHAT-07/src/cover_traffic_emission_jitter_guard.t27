module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_emission_jitter_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_emission_jitter_guard.rs
// (CR-CHAT-07 - Cover traffic emission jitter guard, Wave-89
// Lane A, R-CHAT-10).
//
// Cover emissions follow a cadence, but without jitter the
// cadence reads as a clock signal, the observer predicts the
// next emission exactly and any deviation is a real message,
// and the scheduler itself becomes identifiable. The rules, in
// the original's order: the batch ceiling, then per emission
// the strictly-increasing actual timestamps, the zero-jitter
// probe, the jitter floor and the jitter ceiling, then over
// the whole batch the constant-jitter rejection - two or more
// emissions must not share one jitter value.
//
// The original returns Result<(), JitterError>. This port
// carries the verdict as a named struct (owner decision D5): Ok
// first, then the six variants in the original's declaration
// order - JitterTooLow, JitterTooHigh, ZeroJitter,
// TooManyEmissions, ConstantJitter, TimestampsNotIncreasing -
// with every payload field: got and min or max for the bound
// rules, idx for the zero rule, and the shared value for the
// constant rule.
//
// The original's BTreeSet distinct-jitter probe becomes the
// scan: an emission's jitter is distinct when no earlier
// emission shares it; the constant rule fires when the batch
// holds at least two emissions and every jitter equals the
// first. The jitter is the absolute difference of the actual
// and scheduled times, guarded explicitly.

// Minimum jitter (ms).
pub const CTEJ_MIN_JITTER_MS: u64 = 10;

// Maximum jitter (ms).
pub const CTEJ_MAX_JITTER_MS: u64 = 5000;

// Maximum emissions to validate.
pub const CTEJ_MAX_EMISSIONS: usize = 4096;

// A cover traffic emission record.
pub struct CoverEmission {
    scheduled_ms: u64,
    actual_ms: u64,
}

// Verdict codes: Ok(()) and JitterError's variants, in declaration order.
pub enum JitterCode {
    Ok,
    JitterTooLow,
    JitterTooHigh,
    ZeroJitter,
    TooManyEmissions,
    ConstantJitter,
    TimestampsNotIncreasing,
}

// The verdict of the jitter validation, with every error payload
// field.
pub struct JitterVerdict {
    code: JitterCode,
    idx: usize,
    got: usize,
    bound: usize,
    got64: u64,
    bound64: u64,
}

// The absolute jitter of an emission - the original's
// jitter_ms method, the subtraction guarded explicitly.
pub fn jitter_ms(e: CoverEmission) -> u64 {
    if (e.actual_ms >= e.scheduled_ms) {
        return e.actual_ms - e.scheduled_ms;
    }
    return e.scheduled_ms - e.actual_ms;
}

// Whether emission i shares its jitter with an earlier one - one
// half of the original's BTreeSet probe, answered by a scan.
pub fn jitter_seen_before(emissions: []const CoverEmission, i: usize) -> bool {
    for j in 0..i {
        if (jitter_ms(emissions[j]) == jitter_ms(emissions[i])) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate cover traffic emission jitter. Returns Ok
// only when every rule holds, checked in the original's order:
// the batch ceiling, then per emission the increasing
// timestamps, the zero jitter, the floor and the ceiling, then
// the constant-jitter rejection over the whole batch.
pub fn validate_cover_jitter(emissions: []const CoverEmission) -> JitterVerdict {
    if (emissions.len > CTEJ_MAX_EMISSIONS) {
        return JitterVerdict { code: JitterCode.TooManyEmissions, idx: 0, got: emissions.len, bound: CTEJ_MAX_EMISSIONS, got64: 0, bound64: 0, };
    }
    for i in 0..emissions.len {
        if (i > 0) {
            if (emissions[i].actual_ms <= emissions[i - 1].actual_ms) {
                return JitterVerdict { code: JitterCode.TimestampsNotIncreasing, idx: i, got: 0, bound: 0, got64: 0, bound64: 0, };
            }
        }
        const j: u64 = jitter_ms(emissions[i]);
        if (j == 0) {
            return JitterVerdict { code: JitterCode.ZeroJitter, idx: i, got: 0, bound: 0, got64: 0, bound64: 0, };
        }
        if (j < CTEJ_MIN_JITTER_MS) {
            return JitterVerdict { code: JitterCode.JitterTooLow, idx: i, got: 0, bound: 0, got64: j, bound64: CTEJ_MIN_JITTER_MS, };
        }
        if (j > CTEJ_MAX_JITTER_MS) {
            return JitterVerdict { code: JitterCode.JitterTooHigh, idx: i, got: 0, bound: 0, got64: j, bound64: CTEJ_MAX_JITTER_MS, };
        }
    }
    if (emissions.len >= 2) {
        var all_same: bool = true;
        const first: u64 = jitter_ms(emissions[0]);
        for i in 1..emissions.len {
            if (jitter_ms(emissions[i]) != first) {
                all_same = false;
            }
        }
        if (all_same) {
            return JitterVerdict { code: JitterCode.ConstantJitter, idx: 0, got: 0, bound: 0, got64: first, bound64: 0, };
        }
    }
    return JitterVerdict { code: JitterCode.Ok, idx: 0, got: 0, bound: 0, got64: 0, bound64: 0, };
}

// The scheduled-vs-actual jitters of the too-many fixture, read
// by the loop instead of a computed expression: the jitter of
// record i is 100 + (i mod 50).
