module port::cover_traffic_emission_jitter_guard;

// CR-CHAT-07 - Cover traffic emission jitter guard (Wave-2 Lane A).
//
// EMISSION JITTER GUARD - monitor jitter in traffic emission timing, R-CHAT-07.
//
// The cover traffic system must emit traffic with appropriate jitter to avoid
// creating predictable timing patterns. This guard monitors the jitter in
// emission timing to ensure it meets randomness requirements.
//
// Key monitoring criteria:
//
// 1. Random distribution of emission intervals
// 2. Avoidance of periodic patterns
// 3. Appropriate jitter magnitude
// 4. Prevention of timing predictability
//
// Ported from crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_emission_jitter_guard.rs
// (gHashTag/trios at 8b229e9489ee).

// Maximum allowed correlation between consecutive intervals.
pub const EJG_MAX_CORRELATION: f64 = 0.1;

// Minimum jitter as fraction of mean interval.
pub const EJG_MIN_JITTER_RATIO: f64 = 0.1;

// Maximum jitter as fraction of mean interval.
pub const EJG_MAX_JITTER_RATIO: f64 = 1.0;

// Minimum number of intervals for analysis.
pub const EJG_MIN_INTERVALS: usize = 50;

// Guard result codes.
pub enum GuardResult {
    Pass,
    Fail,
    InvalidInput,
}

// Verdict codes for emission jitter.
pub const EJG_OK: i32 = 0;
pub const EJG_ERR_LOW_JITTER: i32 = 1;
pub const EJG_ERR_HIGH_JITTER: i32 = 2;
pub const EJG_ERR_CORRELATED_TIMING: i32 = 3;
pub const EJG_ERR_INSUFFICIENT_DATA: i32 = 4;
pub const EJG_ERR_INVALID_INPUT: i32 = 5;

// Track emission timing statistics.
pub struct TimingStats {
    intervals: Vec<f64>,
    mean_interval: f64,
    variance: f64,
    min_interval: f64,
    max_interval: f64,
}

// Initialize timing statistics.
pub fn stats_init() -> TimingStats {
    TimingStats {
        intervals: Vec::new(),
        mean_interval: 0.0,
        variance: 0.0,
        min_interval: 0.0,
        max_interval: 0.0,
    }
}

// Add interval to timing statistics.
pub fn stats_add_interval(stats: &mut TimingStats, interval: f64) -> i32 {
    if (interval <= 0.0) {
        return EJG_ERR_INVALID_INPUT;
    }
    
    stats.intervals.push(interval);
    
    // Update statistics
    if (stats.intervals.len() == 1) {
        stats.mean_interval = interval;
        stats.min_interval = interval;
        stats.max_interval = interval;
    } else {
        let old_mean = stats.mean_interval;
        let n = stats.intervals.len();
        stats.mean_interval = old_mean + (interval - old_mean) / n as f64;
        
        if (interval < stats.min_interval) {
            stats.min_interval = interval;
        }
        if (interval > stats.max_interval) {
            stats.max_interval = interval;
        }
    }
    
    EJG_OK
}

// Calculate variance of intervals.
pub fn calculate_variance(stats: &TimingStats) -> f64 {
    if (stats.intervals.len() < 2) {
        return 0.0;
    }
    
    let mut sum: f64 = 0.0;
    let mut i: usize = 0;
    while (i < stats.intervals.len()) {
        let diff = stats.intervals[i] - stats.mean_interval;
        sum = sum + (diff * diff);
        i = i + 1;
    }
    
    sum / stats.intervals.len() as f64
}

// Calculate jitter ratio.
pub fn calculate_jitter_ratio(stats: &TimingStats) -> f64 {
    if (stats.mean_interval == 0.0) {
        return 0.0;
    }
    
    let std_dev = calculate_variance(stats).sqrt();
    std_dev / stats.mean_interval
}

// Calculate correlation between consecutive intervals.
pub fn calculate_correlation(stats: &TimingStats) -> f64 {
    if (stats.intervals.len() < 3) {
        return 0.0;
    }
    
    let n = stats.intervals.len() - 1;
    let mut sum_xy: f64 = 0.0;
    let mut sum_x: f64 = 0.0;
    let mut sum_y: f64 = 0.0;
    let mut sum_x2: f64 = 0.0;
    let mut sum_y2: f64 = 0.0;
    
    let mut i: usize = 0;
    while (i < n) {
        let x = stats.intervals[i];
        let y = stats.intervals[i + 1];
        sum_xy = sum_xy + (x * y);
        sum_x = sum_x + x;
        sum_y = sum_y + y;
        sum_x2 = sum_x2 + (x * x);
        sum_y2 = sum_y2 + (y * y);
        i = i + 1;
    }
    
    let numerator = n as f64 * sum_xy - sum_x * sum_y;
    let denominator = ((n as f64 * sum_x2 - sum_x * sum_x) * (n as f64 * sum_y2 - sum_y * sum_y)).sqrt();
    
    if (denominator > 0.0) {
        numerator / denominator
    } else {
        0.0
    }
}

// Check if jitter is appropriate.
pub fn is_jitter_appropriate(stats: &TimingStats) -> bool {
    let jitter_ratio = calculate_jitter_ratio(stats);
    jitter_ratio >= EJG_MIN_JITTER_RATIO && jitter_ratio <= EJG_MAX_JITTER_RATIO
}

// Check if intervals are uncorrelated.
pub fn are_intervals_uncorrelated(stats: &TimingStats) -> bool {
    let correlation = calculate_correlation(stats);
    correlation.abs() <= EJG_MAX_CORRELATION
}

// Validate emission jitter.
pub fn validate_emission_jitter(stats: &TimingStats) -> i32 {
    if (stats.intervals.len() == 0) {
        return EJG_ERR_INVALID_INPUT;
    }
    
    if (stats.intervals.len() < EJG_MIN_INTERVALS) {
        return EJG_ERR_INSUFFICIENT_DATA;
    }
    
    if (!is_jitter_appropriate(stats)) {
        let jitter_ratio = calculate_jitter_ratio(stats);
        if (jitter_ratio < EJG_MIN_JITTER_RATIO) {
            return EJG_ERR_LOW_JITTER;
        } else {
            return EJG_ERR_HIGH_JITTER;
        }
    }
    
    if (!are_intervals_uncorrelated(stats)) {
        return EJG_ERR_CORRELATED_TIMING;
    }
    
    EJG_OK
}

// Get interval statistics summary.
pub fn get_interval_summary(stats: &TimingStats) -> (f64, f64, f64) {
    (stats.mean_interval, stats.min_interval, stats.max_interval)
}

// Check for periodic patterns.
pub fn has_periodic_patterns(stats: &TimingStats) -> bool {
    if (stats.intervals.len() < 10) {
        return false;
    }
    
    // Simple periodicity check - look for regular intervals
    let n = stats.intervals.len();
    let threshold = 0.1; // 10% tolerance
    
    // Check for 2-interval periodicity
    let mut i: usize = 2;
    while (i < n) {
        let expected = stats.intervals[i - 2];
        let actual = stats.intervals[i];
        let diff = (actual - expected).abs() / expected;
        if (diff < threshold) {
            return true;
        }
        i = i + 2;
    }
    
    false
}

// EJG-01 - appropriate jitter accepted.
test ejg_01_appropriate_jitter {
    let mut stats = stats_init();
    
    // Add intervals with appropriate jitter
    let intervals = [1.0, 1.2, 0.9, 1.1, 1.3, 0.8, 1.0, 1.2];
    let mut i: usize = 0;
    while (i < intervals.len()) {
        stats_add_interval(&mut stats, intervals[i]);
        i = i + 1;
    }
    
    let result = validate_emission_jitter(&stats);
    assert(result == EJG_OK);
}

// EJG-02 - low jitter rejected.
test ejg_02_low_jitter {
    let mut stats = stats_init();
    
    // Add intervals with very low jitter (almost periodic)
    let intervals = [1.0, 1.01, 0.99, 1.02, 0.98, 1.0, 1.01, 0.99];
    let mut i: usize = 0;
    while (i < intervals.len()) {
        stats_add_interval(&mut stats, intervals[i]);
        i = i + 1;
    }
    
    let result = validate_emission_jitter(&stats);
    assert(result == EJG_ERR_LOW_JITTER);
}

// EJG-03 - high jitter rejected.
test ejg_03_high_jitter {
    let mut stats = stats_init();
    
    // Add intervals with very high jitter
    let intervals = [1.0, 3.0, 0.5, 4.0, 0.2, 5.0, 0.1, 6.0];
    let mut i: usize = 0;
    while (i < intervals.len()) {
        stats_add_interval(&mut stats, intervals[i]);
        i = i + 1;
    }
    
    let result = validate_emission_jitter(&stats);
    assert(result == EJG_ERR_HIGH_JITTER);
}

// EJG-04 - correlated timing rejected.
test ejg_04_correlated_timing {
    let mut stats = stats_init();
    
    // Add intervals with strong correlation
    let intervals = [1.0, 2.0, 1.1, 2.2, 0.9, 1.8, 1.2, 2.4];
    let mut i: usize = 0;
    while (i < intervals.len()) {
        stats_add_interval(&mut stats, intervals[i]);
        i = i + 1;
    }
    
    let result = validate_emission_jitter(&stats);
    assert(result == EJG_ERR_CORRELATED_TIMING);
}

// EJG-05 - periodic patterns detected.
test ejg_05_periodic_patterns {
    let mut stats = stats_init();
    
    // Add intervals with periodic patterns
    let intervals = [1.0, 2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0];
    let mut i: usize = 0;
    while (i < intervals.len()) {
        stats_add_interval(&mut stats, intervals[i]);
        i = i + 1;
    }
    
    let has_patterns = has_periodic_patterns(&stats);
    assert(has_patterns == true);
}