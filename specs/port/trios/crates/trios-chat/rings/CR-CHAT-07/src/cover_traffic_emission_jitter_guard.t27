// **CTEJ-01** - jitter below the minimum rejected: five
// milliseconds of a required ten.
test ctej_01_jitter_too_low_rejected {
    const es: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1005, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.JitterTooLow);
    assert(v.got64 == 5);
    assert(v.bound64 == 10);
}

// **CTEJ-02** - jitter above the maximum rejected: nine thousand
// milliseconds of a ceiling five thousand.
test ctej_02_jitter_too_high_rejected {
    const es: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 10000, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.JitterTooHigh);
    assert(v.got64 == 9000);
    assert(v.bound64 == 5000);
}

// **CTEJ-03** - zero jitter rejected: the actual emission equals
// the schedule exactly.
test ctej_03_zero_jitter_rejected {
    const es: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1000, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.ZeroJitter);
    assert(v.idx == 0);
}

// **CTEJ-04** - too many rejected: 4097 emissions of a maximum
// 4096, built in a loop like the original's, the scheduled times
// stepping by a second and the jitters walking 100 + (i mod 50).
// The batch rule fires before any emission is examined.
test ctej_04_too_many_rejected {
    var es: [4097]CoverEmission;
    for i in 0..4097 {
        const sched: u64 = @as(u64, i) * 1000;
        es[i] = CoverEmission { scheduled_ms: sched, actual_ms: sched + CTEJ_JITTERS_4097[i], };
    }
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.TooManyEmissions);
    assert(v.got == 4097);
    assert(v.bound == 4096);
}

// **CTEJ-05** - constant jitter rejected: three emissions all
// carrying twenty milliseconds - the shared value rides the
// verdict.
test ctej_05_constant_jitter_rejected {
    const es: [3]CoverEmission = [3]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1020, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 2020, },
        CoverEmission { scheduled_ms: 3000, actual_ms: 3020, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.ConstantJitter);
    assert(v.got64 == 20);
}

// **CTEJ-06** - timestamps not increasing rejected: the second
// emission lands before the first.
test ctej_06_timestamps_not_increasing_rejected {
    const es: [2]CoverEmission = [2]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1050, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 1040, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.TimestampsNotIncreasing);
    assert(v.idx == 1);
}

// **CTEJ-07** - the valid batch accepted: jitters fifteen,
// thirty, twelve, fifty - all inside the band, all distinct.
test ctej_07_valid_accepted {
    const es: [4]CoverEmission = [4]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1015, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 2030, },
        CoverEmission { scheduled_ms: 3000, actual_ms: 3012, },
        CoverEmission { scheduled_ms: 4000, actual_ms: 4050, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.Ok);
}

// **CTEJ-08** - an empty batch accepted.
test ctej_08_empty_accepted {
    const es: [0]CoverEmission = [0]CoverEmission{};
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.Ok);
}

// **CTEJ-09** - a single emission accepted: the constant check
// needs two.
test ctej_09_single_accepted {
    const es: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1020, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.Ok);
}

// **CTEJ-10** - a negative jitter accepted: the actual emission
// falls a hundred milliseconds short of the schedule, the next
// seventy short - the absolute difference is what the band
// bounds.
test ctej_10_negative_jitter_accepted {
    const es: [2]CoverEmission = [2]CoverEmission{
        CoverEmission { scheduled_ms: 1100, actual_ms: 1000, },
        CoverEmission { scheduled_ms: 2100, actual_ms: 2030, },
    };
    const v = validate_cover_jitter(&es);
    assert(v.code == JitterCode.Ok);
}

// The two helpers have direct tests (coverage: Untested 0).
test ctej_helpers_answer {
    const early = CoverEmission { scheduled_ms: 1100, actual_ms: 1000, };
    const late = CoverEmission { scheduled_ms: 1000, actual_ms: 1050, };
    const on_time = CoverEmission { scheduled_ms: 1000, actual_ms: 1000, };
    assert(jitter_ms(late) == 50);
    assert(jitter_ms(early) == 100);
    assert(jitter_ms(on_time) == 0);
    const pair: [2]CoverEmission = [2]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1020, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 2020, },
    };
    assert(!jitter_seen_before(&pair, 0));
    assert(jitter_seen_before(&pair, 1));
}

// Rule order is the original's: the timestamps before the zero
// probe, the zero probe before the floor, the floor before the
// ceiling, and the per-emission rules before the batch
// constant-jitter rejection.
test rule_order_matches_original {
    const backstep_zero: [2]CoverEmission = [2]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1020, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 1020, },
    };
    const v1 = validate_cover_jitter(&backstep_zero);
    assert(v1.code == JitterCode.TimestampsNotIncreasing);
    assert(v1.idx == 1);

    const zero_low: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1000, },
    };
    const v2 = validate_cover_jitter(&zero_low);
    assert(v2.code == JitterCode.ZeroJitter);

    const low_high: [1]CoverEmission = [1]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 20000, },
    };
    const v3 = validate_cover_jitter(&low_high);
    assert(v3.code == JitterCode.JitterTooHigh);

    const twins_constant: [2]CoverEmission = [2]CoverEmission{
        CoverEmission { scheduled_ms: 1000, actual_ms: 1020, },
        CoverEmission { scheduled_ms: 2000, actual_ms: 2020, },
    };
    const v4 = validate_cover_jitter(&twins_constant);
    assert(v4.code == JitterCode.ConstantJitter);
    assert(v4.got64 == 20);
}
