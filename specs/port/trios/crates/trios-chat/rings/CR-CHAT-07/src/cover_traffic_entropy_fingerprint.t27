module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::cover_traffic_entropy_fingerprint;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/cover_traffic_entropy_fingerprint.rs
// (CR-CHAT-07 - Cover traffic entropy fingerprint guard, Wave-50
// Lane B, R-CHAT-10).
//
// Cover traffic must be indistinguishable from real AEAD
// ciphertext at the byte level: a statistical filter on
// entropy, byte frequency or zero runs strips the cover and
// collapses the anonymity set. The rules, in the original's
// order: the empty probe, the length floor, the alignment grid,
// the expected length class, the zero-run ceiling, and the
// entropy floor.
//
// The original returns Result<(), CoverEntropyError>. No
// variant carries a payload, so the verdict is the code alone
// (owner decision D5), Ok first, then the six variants in the
// original's declaration order - EmptyCover, NotAligned,
// TooShort, ZeroRunTooLong, LowEntropy, LengthClassMismatch.
//
// The original's shannon_entropy folds a log2 over a
// frequency table - the int-to-float casts and the log fold do
// not lower under the backends - so the entropy arrives as a
// number the caller computed, the lane convention for
// statistics over byte buffers (fill-byte randomness #9698,
// payload entropy #9747, cipher-mode entropy #9752, pattern
// randomness #9811). The max_zero_run walk needs no cast and
// ports whole. Every fixture's statistics are Python-verified
// exact: the good cover carries sixty-four distinct bytes (an
// entropy of six bits), the 0x42 cover measures zero, the
// nine-zero cover 0.586 with its run of nine, the exact
// eight-zero boundary 5.625 with its run of eight.

// Alignment requirement for cover length.
pub const CTEF_ALIGNMENT: usize = 64;

// Minimum cover length.
pub const CTEF_MIN_COVER_LEN: usize = 64;

// Maximum consecutive zero bytes allowed.
pub const CTEF_MAX_ZERO_RUN: usize = 8;

// Minimum Shannon entropy per 256-byte block (bits).
pub const CTEF_MIN_ENTROPY: f64 = 3.0;

// The cover length of the fixtures.
pub const CTEF_COVER_LEN: usize = 64;

// Verdict codes: Ok(()) and CoverEntropyError's variants, in declaration order.
pub enum CoverEntropyCode {
    Ok,
    EmptyCover,
    NotAligned,
    TooShort,
    ZeroRunTooLong,
    LowEntropy,
    LengthClassMismatch,
}

// The verdict of the cover entropy validation. No variant of the
// original's error carries a payload, so the code is the whole
// verdict.
pub struct CoverEntropyVerdict {
    code: CoverEntropyCode,
}

// The longest run of zero bytes - the original's max_zero_run,
// ports whole: the walk counts consecutive zeros and keeps the
// maximum.
pub fn max_zero_run(cover: []const u8) -> usize {
    var max_run: usize = 0;
    var current: usize = 0;
    for i in 0..cover.len {
        if (cover[i] == 0) {
            current = current + 1;
            if (current > max_run) {
                max_run = current;
            }
        } else {
            current = 0;
        }
    }
    return max_run;
}

// [VERIFIED] Validate a cover traffic sample for entropy and
// structural properties. Returns Ok only when every rule holds,
// checked in the original's order: the empty probe, the length
// floor, the alignment grid, the expected length class, the
// zero-run ceiling, and the entropy floor over the caller's
// measurement.
pub fn validate_cover_entropy(
    cover: []const u8,
    expected_len: usize,
    entropy: f64,
) -> CoverEntropyVerdict {
    if (cover.len == 0) {
        return CoverEntropyVerdict { code: CoverEntropyCode.EmptyCover, };
    }
    if (cover.len < CTEF_MIN_COVER_LEN) {
        return CoverEntropyVerdict { code: CoverEntropyCode.TooShort, };
    }
    if (cover.len % CTEF_ALIGNMENT != 0) {
        return CoverEntropyVerdict { code: CoverEntropyCode.NotAligned, };
    }
    if (cover.len != expected_len) {
        return CoverEntropyVerdict { code: CoverEntropyCode.LengthClassMismatch, };
    }
    if (max_zero_run(cover) > CTEF_MAX_ZERO_RUN) {
        return CoverEntropyVerdict { code: CoverEntropyCode.ZeroRunTooLong, };
    }
    if (entropy < CTEF_MIN_ENTROPY) {
        return CoverEntropyVerdict { code: CoverEntropyCode.LowEntropy, };
    }
    return CoverEntropyVerdict { code: CoverEntropyCode.Ok, };
}

// The good cover of the fixtures: sixty-four distinct bytes,
// (i * 131) ^ 0x55 walking the index - an entropy of six bits
// and no zero run.
pub const GOOD_COVER: [64]u8 = [64]u8{85, 214, 83, 220, 89, 218, 71, 192, 77, 206, 75, 244, 113, 242, 127, 248, 101, 230, 99, 236, 105, 234, 23, 144, 29, 158, 27, 132, 1, 130, 15, 136, 53, 182, 51, 188, 57, 186, 39, 160, 45, 174, 43, 84, 209, 82, 223, 88, 197, 70, 195, 76, 201, 74, 247, 112, 253, 126, 251, 100, 225, 98, 239, 104};

// The low-entropy cover: sixty-four copies of 0x42 - an entropy
// of zero.
pub const LOW_COVER: [64]u8 = [64]u8{66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66, 66};

// The good cover with its first nine bytes zeroed - a run of
// nine over the ceiling of eight.
pub const ZERO_RUN_COVER: [64]u8 = [64]u8{0, 0, 0, 0, 0, 0, 0, 0, 0, 206, 75, 244, 113, 242, 127, 248, 101, 230, 99, 236, 105, 234, 23, 144, 29, 158, 27, 132, 1, 130, 15, 136, 53, 182, 51, 188, 57, 186, 39, 160, 45, 174, 43, 84, 209, 82, 223, 88, 197, 70, 195, 76, 201, 74, 247, 112, 253, 126, 251, 100, 225, 98, 239, 104};

// The good cover with its first eight bytes zeroed - a run of
// exactly eight, the boundary that passes.
pub const EXACT_RUN_COVER: [64]u8 = [64]u8{0, 0, 0, 0, 0, 0, 0, 0, 77, 206, 75, 244, 113, 242, 127, 248, 101, 230, 99, 236, 105, 234, 23, 144, 29, 158, 27, 132, 1, 130, 15, 136, 53, 182, 51, 188, 57, 186, 39, 160, 45, 174, 43, 84, 209, 82, 223, 88, 197, 70, 195, 76, 201, 74, 247, 112, 253, 126, 251, 100, 225, 98, 239, 104};

// The minimum-length cover: sixty-four distinct bytes walking
// (i * 173) - an entropy of six bits and one zero byte.
pub const MIN_LEN_COVER: [64]u8 = [64]u8{0, 173, 90, 7, 180, 97, 14, 187, 104, 21, 194, 111, 28, 201, 118, 35, 208, 125, 42, 215, 132, 49, 222, 139, 56, 229, 146, 63, 236, 153, 70, 243, 160, 77, 250, 167, 84, 1, 174, 91, 8, 181, 98, 15, 188, 105, 22, 195, 112, 29, 202, 119, 36, 209, 126, 43, 216, 133, 50, 223, 140, 57, 230, 147};

// The high-entropy cover: sixty-four distinct bytes walking
// (i * 251 + 17).
pub const HIGH_COVER: [64]u8 = [64]u8{17, 12, 7, 2, 253, 248, 243, 238, 233, 228, 223, 218, 213, 208, 203, 198, 193, 188, 183, 178, 173, 168, 163, 158, 153, 148, 143, 138, 133, 128, 123, 118, 113, 108, 103, 98, 93, 88, 83, 78, 73, 68, 63, 58, 53, 48, 43, 38, 33, 28, 23, 18, 13, 8, 3, 254, 249, 244, 239, 234, 229, 224, 219, 214};

// **CTEF-01** - an empty cover rejected.
test ctef_01_empty_rejected {
    const cover: [0]u8 = [0]u8{};
    const v = validate_cover_entropy(&cover, 0, 0.0);
    assert(v.code == CoverEntropyCode.EmptyCover);
}

// **CTEF-02** - a sixteen-byte cover rejected: too short of the
// sixty-four floor.
test ctef_02_too_short_rejected {
    const cover: [16]u8 = [16]u8{170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170,};
    const v = validate_cover_entropy(&cover, 16, 0.0);
    assert(v.code == CoverEntropyCode.TooShort);
}

// **CTEF-03** - a misaligned cover rejected: sixty-five bytes,
// one past the alignment grid.
test ctef_03_not_aligned_rejected {
    var cover: [129]u8;
    for i in 0..129 {
        cover[i] = 85;
    }
    const v = validate_cover_entropy(&cover, 129, 6.0);
    assert(v.code == CoverEntropyCode.NotAligned);
}

// **CTEF-04** - a nine-zero run rejected: the ceiling is eight.
test ctef_04_zero_run_rejected {
    const v = validate_cover_entropy(&ZERO_RUN_COVER, 64, 0.5858732928619205);
    assert(v.code == CoverEntropyCode.ZeroRunTooLong);
}

// **CTEF-05** - low entropy rejected: a single repeated byte
// measures zero bits against the floor of three.
test ctef_05_low_entropy_rejected {
    const v = validate_cover_entropy(&LOW_COVER, 64, 0.0);
    assert(v.code == CoverEntropyCode.LowEntropy);
}

// **CTEF-06** - the length class mismatch rejected: the cover
// carries sixty-four bytes, the envelope expects one
// twenty-eight.
test ctef_06_length_mismatch_rejected {
    const v = validate_cover_entropy(&GOOD_COVER, 128, 6.0);
    assert(v.code == CoverEntropyCode.LengthClassMismatch);
}

// **CTEF-07** - the good cover accepted: six bits of entropy,
// no zero run.
test ctef_07_good_accepted {
    const v = validate_cover_entropy(&GOOD_COVER, 64, 6.0);
    assert(v.code == CoverEntropyCode.Ok);
}

// **CTEF-08** - the exact eight-zero boundary accepted: 5.625
// bits of entropy over the floor, the run at the ceiling.
test ctef_08_exact_zero_run_accepted {
    const v = validate_cover_entropy(&EXACT_RUN_COVER, 64, 5.625);
    assert(v.code == CoverEntropyCode.Ok);
}

// **CTEF-09** - the minimum length accepted: sixty-four bytes
// aligned on the grid, six bits of entropy.
test ctef_09_min_len_accepted {
    const v = validate_cover_entropy(&MIN_LEN_COVER, 64, 6.0);
    assert(v.code == CoverEntropyCode.Ok);
}

// **CTEF-10** - the high-entropy cover accepted.
test ctef_10_high_entropy_accepted {
    const v = validate_cover_entropy(&HIGH_COVER, 64, 6.0);
    assert(v.code == CoverEntropyCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test max_zero_run_answers {
    assert(max_zero_run(&GOOD_COVER) == 0);
    assert(max_zero_run(&ZERO_RUN_COVER) == 9);
    assert(max_zero_run(&EXACT_RUN_COVER) == 8);
    var deep_zero: [20]u8;
    for i in 0..20 {
        deep_zero[i] = 7;
    }
    deep_zero[10] = 0;
    deep_zero[11] = 0;
    assert(max_zero_run(&deep_zero) == 2);
}

// Rule order is the original's: the empty probe first, the
// length floor before the alignment, the alignment before the
// class check, the class check before the zero-run ceiling,
// and the zero-run ceiling before the entropy floor.
test rule_order_matches_original {
    const empty_misaligned: [0]u8 = [0]u8{};
    const v1 = validate_cover_entropy(&empty_misaligned, 65, 0.0);
    assert(v1.code == CoverEntropyCode.EmptyCover);

    var short_misaligned: [16]u8;
    for i in 0..16 {
        short_misaligned[i] = 85;
    }
    const v2 = validate_cover_entropy(&short_misaligned, 16, 0.0);
    assert(v2.code == CoverEntropyCode.TooShort);

    var misaligned_mismatch: [129]u8;
    for i in 0..129 {
        misaligned_mismatch[i] = 85;
    }
    const v3 = validate_cover_entropy(&misaligned_mismatch, 64, 6.0);
    assert(v3.code == CoverEntropyCode.NotAligned);

    const mismatch_zero_run = validate_cover_entropy(&ZERO_RUN_COVER, 128, 0.5858732928619205);
    assert(mismatch_zero_run.code == CoverEntropyCode.LengthClassMismatch);

    const zero_run_low = validate_cover_entropy(&ZERO_RUN_COVER, 64, 0.0);
    assert(zero_run_low.code == CoverEntropyCode.ZeroRunTooLong);

    const low_aligned = validate_cover_entropy(&LOW_COVER, 64, 0.0);
    assert(low_aligned.code == CoverEntropyCode.LowEntropy);
}
