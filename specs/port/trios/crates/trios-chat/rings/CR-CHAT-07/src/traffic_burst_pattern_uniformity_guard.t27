module port::trios::crates::trios-chat::rings::CR-CHAT-07::src::traffic_burst_pattern_uniformity_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-07/src/traffic_burst_pattern_uniformity_guard.rs
// (CR-CHAT-07 - Traffic burst pattern uniformity guard, Wave-85
// Lane B, R-CHAT-7).
//
// Users send messages in bursts; non-uniform inter-burst timing
// lets an observer fingerprint a typing rhythm, infer online
// versus idle periods and re-identify the user across
// anonymization layers. The rules, in the original's order:
// the batch ceiling (1024), the empty-burst scan over the
// whole batch (a burst with zero messages answers with its
// timestamp), the short-batch acceptance (under two bursts
// carries no interval), then the interval walk - a timestamp
// not strictly increasing answers first, then the interval
// floor (500 ms), then the interval ceiling (300000 ms) -
// and finally the variance ceiling (60000 ms) over the
// collected intervals: the floored mean, the largest
// deviation from it.
//
// The original returns Result<(), BurstPatternError>. This
// port carries the verdict as a named struct (owner decision
// D5): Ok first, then the six variants in the original's
// declaration order - IntervalTooShort, IntervalTooLong,
// VarianceExceeded, TooManyBursts, EmptyBurst,
// TimestampNotIncreasing - with every payload field: got and
// min for the short rule, got and max for the long rule,
// variance and max for the variance ceiling, the timestamp
// for the empty burst.
//
// The original's Vec<u64> of collected intervals becomes two
// walks that re-derive each interval from the strictly
// increasing timestamps - the first walk sums them, the
// second finds the largest deviation from the floored mean
// (t27 has no interval array to keep; the timestamps are
// proven increasing before either walk runs, so the
// subtraction is safe). The mean is the original's integer
// division of the interval sum by the interval count.

// Minimum inter-burst interval (ms).
pub const TBPU_MIN_INTERVAL_MS: u64 = 500;

// Maximum inter-burst interval (ms).
pub const TBPU_MAX_INTERVAL_MS: u64 = 300000;

// Maximum allowed variance from mean interval (ms).
pub const TBPU_MAX_VARIANCE_MS: u64 = 60000;

// Maximum bursts to track.
pub const TBPU_MAX_BURSTS: usize = 1024;

// A burst of messages at a specific time.
pub struct MessageBurst {
    timestamp_ms: u64,
    message_count: usize,
}

// Verdict codes: Ok(()) and BurstPatternError's variants, in declaration order.
pub enum TbpuCode {
    Ok,
    IntervalTooShort,
    IntervalTooLong,
    VarianceExceeded,
    TooManyBursts,
    EmptyBurst,
    TimestampNotIncreasing,
}

// The verdict of the burst pattern validation, with every
// error payload field: the measured interval or variance in
// got, the rule bound in bound, the empty burst's timestamp
// in ts.
pub struct TbpuVerdict {
    code: TbpuCode,
    got: u64,
    bound: u64,
    ts: u64,
}

// [VERIFIED] Validate traffic burst pattern uniformity.
// Returns Ok only when every rule holds, checked in the
// original's order: the batch ceiling, the empty-burst scan,
// the short-batch acceptance, the interval walk and the
// variance ceiling over the floored mean.
pub fn validate_burst_patterns(bursts: []const MessageBurst) -> TbpuVerdict {
    if (bursts.len > TBPU_MAX_BURSTS) {
        return TbpuVerdict { code: TbpuCode.TooManyBursts, got: 0, bound: 0, ts: 0, };
    }
    for i in 0..bursts.len {
        if (bursts[i].message_count == 0) {
            return TbpuVerdict { code: TbpuCode.EmptyBurst, got: 0, bound: 0, ts: bursts[i].timestamp_ms, };
        }
    }
    if (bursts.len < 2) {
        return TbpuVerdict { code: TbpuCode.Ok, got: 0, bound: 0, ts: 0, };
    }
    var interval_sum: u64 = 0;
    for i in 1..bursts.len {
        if (bursts[i].timestamp_ms <= bursts[i - 1].timestamp_ms) {
            return TbpuVerdict { code: TbpuCode.TimestampNotIncreasing, got: 0, bound: 0, ts: 0, };
        }
        const interval: u64 = bursts[i].timestamp_ms - bursts[i - 1].timestamp_ms;
        if (interval < TBPU_MIN_INTERVAL_MS) {
            return TbpuVerdict { code: TbpuCode.IntervalTooShort, got: interval, bound: TBPU_MIN_INTERVAL_MS, ts: 0, };
        }
        if (interval > TBPU_MAX_INTERVAL_MS) {
            return TbpuVerdict { code: TbpuCode.IntervalTooLong, got: interval, bound: TBPU_MAX_INTERVAL_MS, ts: 0, };
        }
        interval_sum = interval_sum + interval;
    }
    const interval_count: u64 = @as(u64, bursts.len - 1);
    const mean: u64 = interval_sum / interval_count;
    var max_dev: u64 = 0;
    for i in 1..bursts.len {
        const interval: u64 = bursts[i].timestamp_ms - bursts[i - 1].timestamp_ms;
        var dev: u64 = 0;
        if (interval > mean) {
            dev = interval - mean;
        } else {
            dev = mean - interval;
        }
        if (dev > max_dev) {
            max_dev = dev;
        }
    }
    if (max_dev > TBPU_MAX_VARIANCE_MS) {
        return TbpuVerdict { code: TbpuCode.VarianceExceeded, got: max_dev, bound: TBPU_MAX_VARIANCE_MS, ts: 0, };
    }
    return TbpuVerdict { code: TbpuCode.Ok, got: 0, bound: 0, ts: 0, };
}

// **TBPU-01** - the interval too short rejected: two hundred
// of a floor of five hundred.
test tbpu_01_interval_too_short_rejected {
    const bursts: [2]MessageBurst = [2]MessageBurst{
        MessageBurst { timestamp_ms: 1000, message_count: 2, },
        MessageBurst { timestamp_ms: 1200, message_count: 3, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.IntervalTooShort);
    assert(v.got == 200);
    assert(v.bound == 500);
}

// **TBPU-02** - the interval too long rejected: four hundred
// ninety-nine thousand of a ceiling of three hundred
// thousand.
test tbpu_02_interval_too_long_rejected {
    const bursts: [2]MessageBurst = [2]MessageBurst{
        MessageBurst { timestamp_ms: 1000, message_count: 2, },
        MessageBurst { timestamp_ms: 500000, message_count: 3, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.IntervalTooLong);
    assert(v.got == 499000);
    assert(v.bound == 300000);
}

// **TBPU-03** - the variance exceeded rejected: intervals of
// ten and one hundred eighty thousand around a floored mean
// of ninety-five thousand answer the deviation eighty-five
// thousand of a ceiling of sixty thousand.
test tbpu_03_variance_exceeded_rejected {
    const bursts: [3]MessageBurst = [3]MessageBurst{
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
        MessageBurst { timestamp_ms: 20000, message_count: 2, },
        MessageBurst { timestamp_ms: 200000, message_count: 2, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.VarianceExceeded);
    assert(v.got == 85000);
    assert(v.bound == 60000);
}

// **TBPU-04** - too many bursts rejected: ten hundred
// twenty-five of a maximum ten hundred twenty-four, built in
// a loop like the original's; the batch rule fires before
// any burst is examined.
test tbpu_04_too_many_rejected {
    var bursts: [1025]MessageBurst;
    for i in 0..1025 {
        bursts[i] = MessageBurst { timestamp_ms: @as(u64, i) * 1000, message_count: 1, };
    }
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.TooManyBursts);
}

// **TBPU-05** - the empty burst rejected: zero messages answer
// with the burst's timestamp.
test tbpu_05_empty_burst_rejected {
    const bursts: [1]MessageBurst = [1]MessageBurst{
        MessageBurst { timestamp_ms: 1000, message_count: 0, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.EmptyBurst);
    assert(v.ts == 1000);
}

// **TBPU-06** - timestamps not increasing rejected: the
// second burst starts before the first.
test tbpu_06_timestamp_not_increasing_rejected {
    const bursts: [2]MessageBurst = [2]MessageBurst{
        MessageBurst { timestamp_ms: 20000, message_count: 2, },
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.TimestampNotIncreasing);
}

// **TBPU-07** - the valid bursts accepted: two even
// intervals of twenty thousand.
test tbpu_07_valid_accepted {
    const bursts: [3]MessageBurst = [3]MessageBurst{
        MessageBurst { timestamp_ms: 10000, message_count: 3, },
        MessageBurst { timestamp_ms: 30000, message_count: 2, },
        MessageBurst { timestamp_ms: 50000, message_count: 4, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.Ok);
}

// **TBPU-08** - an empty batch accepted.
test tbpu_08_empty_accepted {
    const bursts: [0]MessageBurst = [0]MessageBurst{};
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.Ok);
}

// **TBPU-09** - a single burst accepted: no interval to
// measure.
test tbpu_09_single_accepted {
    const bursts: [1]MessageBurst = [1]MessageBurst{
        MessageBurst { timestamp_ms: 1000, message_count: 5, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.Ok);
}

// **TBPU-10** - uniform intervals accepted: three even
// intervals of twenty thousand, no deviation from the mean.
test tbpu_10_uniform_accepted {
    const bursts: [4]MessageBurst = [4]MessageBurst{
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
        MessageBurst { timestamp_ms: 30000, message_count: 2, },
        MessageBurst { timestamp_ms: 50000, message_count: 2, },
        MessageBurst { timestamp_ms: 70000, message_count: 2, },
    };
    const v = validate_burst_patterns(&bursts);
    assert(v.code == TbpuCode.Ok);
}

// Rule order is the original's: the batch ceiling answers
// before the empty-burst scan - a flooded batch of empty
// bursts answers TooManyBursts - the empty-burst scan
// answers before the short-batch acceptance and before the
// interval walk - an empty burst in a single-burst batch
// rejects, and an empty burst answers over a reversed pair -
// the not-increasing probe answers before the interval floor
// on the same pair, and the interval rules answer before the
// variance ceiling is ever read.
test rule_order_matches_original {
    var flooded: [1025]MessageBurst;
    for i in 0..1025 {
        flooded[i] = MessageBurst { timestamp_ms: @as(u64, i) * 1000, message_count: 0, };
    }
    const v1 = validate_burst_patterns(&flooded);
    assert(v1.code == TbpuCode.TooManyBursts);

    const reversed_empty: [2]MessageBurst = [2]MessageBurst{
        MessageBurst { timestamp_ms: 20000, message_count: 0, },
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
    };
    const v2 = validate_burst_patterns(&reversed_empty);
    assert(v2.code == TbpuCode.EmptyBurst);
    assert(v2.ts == 20000);

    const stacked: [2]MessageBurst = [2]MessageBurst{
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
        MessageBurst { timestamp_ms: 10000, message_count: 2, },
    };
    const v3 = validate_burst_patterns(&stacked);
    assert(v3.code == TbpuCode.TimestampNotIncreasing);

    const short_before_variance: [3]MessageBurst = [3]MessageBurst{
        MessageBurst { timestamp_ms: 10000, message_count: 1, },
        MessageBurst { timestamp_ms: 10400, message_count: 1, },
        MessageBurst { timestamp_ms: 200000, message_count: 1, },
    };
    const v4 = validate_burst_patterns(&short_before_variance);
    assert(v4.code == TbpuCode.IntervalTooShort);
    assert(v4.got == 400);
}
