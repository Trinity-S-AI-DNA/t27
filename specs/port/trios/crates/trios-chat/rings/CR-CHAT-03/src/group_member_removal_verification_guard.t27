module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::group_member_removal_verification_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/group_member_removal_verification_guard.rs
// (CR-CHAT-03 - Group member removal verification guard,
// Wave-95 Lane A, R-CHAT-3).
//
// A removed member must be fully evicted: the leaf
// blanked, the key cleared, the ancestor path secrets
// rotated, and none of it at epoch zero. An incomplete
// eviction leaves the removed member deriving group keys
// from cached path secrets or receiving future commits.
// The rules, in the original's fixed order: the batch
// ceiling (two hundred fifty-six), the count agreement
// with the expected removals, then per removal the
// zero-epoch probe, the blanked-leaf probe, the
// cleared-key probe and the updated-ancestors probe.
//
// The original returns Result<(), RemovalError>. This
// port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order - LeafNotBlanked,
// AncestorsNotUpdated, CountMismatch, KeyNotCleared,
// ZeroEpoch, TooManyRemovals - with every payload field:
// the leaf the per-record rules name, and the expected
// and got counts of the count rule.
//
// The leaf index widens from u32 to usize - t27's loop
// counters are usize and every fixture value fits both.

// Maximum removals per batch.
pub const GMRV_MAX_REMOVALS: usize = 256;

// A member removal record.
pub struct MemberRemoval {
    leaf_index: usize,
    leaf_blanked: bool,
    key_cleared: bool,
    ancestors_updated: bool,
    epoch: u64,
}

// Verdict codes: Ok(()) and RemovalError's variants, in declaration order.
pub enum GmrvCode {
    Ok,
    LeafNotBlanked,
    AncestorsNotUpdated,
    CountMismatch,
    KeyNotCleared,
    ZeroEpoch,
    TooManyRemovals,
}

// The verdict of the removal validation, with every
// payload field: the leaf of the per-record rules, the
// expected and got counts of the count rule.
pub struct GmrvVerdict {
    code: GmrvCode,
    leaf: usize,
    expected: usize,
    got: usize,
}

// [VERIFIED] Validate group member removals. Returns Ok
// only when every rule holds, checked in the original's
// fixed order: the batch ceiling, the count agreement,
// then per removal the epoch, the leaf, the key and the
// ancestors.
pub fn validate_member_removals(removals: []const MemberRemoval, expected_count: usize) -> GmrvVerdict {
    if (removals.len > GMRV_MAX_REMOVALS) {
        return GmrvVerdict { code: GmrvCode.TooManyRemovals, leaf: 0, expected: 0, got: 0, };
    }
    if (removals.len != expected_count) {
        return GmrvVerdict { code: GmrvCode.CountMismatch, leaf: 0, expected: expected_count, got: removals.len, };
    }
    for i in 0..removals.len {
        if (removals[i].epoch == 0) {
            return GmrvVerdict { code: GmrvCode.ZeroEpoch, leaf: removals[i].leaf_index, expected: 0, got: 0, };
        }
        if (!removals[i].leaf_blanked) {
            return GmrvVerdict { code: GmrvCode.LeafNotBlanked, leaf: removals[i].leaf_index, expected: 0, got: 0, };
        }
        if (!removals[i].key_cleared) {
            return GmrvVerdict { code: GmrvCode.KeyNotCleared, leaf: removals[i].leaf_index, expected: 0, got: 0, };
        }
        if (!removals[i].ancestors_updated) {
            return GmrvVerdict { code: GmrvCode.AncestorsNotUpdated, leaf: removals[i].leaf_index, expected: 0, got: 0, };
        }
    }
    return GmrvVerdict { code: GmrvCode.Ok, leaf: 0, expected: 0, got: 0, };
}

// **GMRV-01** - the leaf not blanked rejected, the verdict
// naming it.
test gmrv_01_leaf_not_blanked_rejected {
    const removals: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: false, key_cleared: true, ancestors_updated: true, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 1);
    assert(v.code == GmrvCode.LeafNotBlanked);
    assert(v.leaf == 1);
}

// **GMRV-02** - the ancestors not updated rejected.
test gmrv_02_ancestors_not_updated_rejected {
    const removals: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: false, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 1);
    assert(v.code == GmrvCode.AncestorsNotUpdated);
    assert(v.leaf == 1);
}

// **GMRV-03** - the count mismatch rejected: two removals
// of an expected three, the verdict carrying both counts.
test gmrv_03_count_mismatch_rejected {
    const removals: [2]MemberRemoval = [2]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, },
        MemberRemoval { leaf_index: 2, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 3);
    assert(v.code == GmrvCode.CountMismatch);
    assert(v.expected == 3);
    assert(v.got == 2);
}

// **GMRV-04** - the key not cleared rejected.
test gmrv_04_key_not_cleared_rejected {
    const removals: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: false, ancestors_updated: true, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 1);
    assert(v.code == GmrvCode.KeyNotCleared);
    assert(v.leaf == 1);
}

// **GMRV-05** - the zero epoch rejected.
test gmrv_05_zero_epoch_rejected {
    const removals: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 0, },
    };
    const v = validate_member_removals(&removals, 1);
    assert(v.code == GmrvCode.ZeroEpoch);
    assert(v.leaf == 1);
}

// **GMRV-06** - too many removals rejected: two hundred
// fifty-seven of a ceiling of two hundred fifty-six, built
// in a loop like the original's; the ceiling fires before
// any removal is examined.
test gmrv_06_too_many_rejected {
    var removals: [257]MemberRemoval;
    for i in 0..257 {
        removals[i] = MemberRemoval { leaf_index: i, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, };
    }
    const v = validate_member_removals(&removals, 257);
    assert(v.code == GmrvCode.TooManyRemovals);
}

// **GMRV-07** - the valid removals accepted.
test gmrv_07_valid_accepted {
    const removals: [2]MemberRemoval = [2]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, },
        MemberRemoval { leaf_index: 2, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 2);
    assert(v.code == GmrvCode.Ok);
}

// **GMRV-08** - the empty batch accepted against an
// expected zero.
test gmrv_08_empty_accepted {
    const removals: [0]MemberRemoval = [0]MemberRemoval{};
    const v = validate_member_removals(&removals, 0);
    assert(v.code == GmrvCode.Ok);
}

// **GMRV-09** - a single valid removal accepted.
test gmrv_09_single_accepted {
    const removals: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, },
    };
    const v = validate_member_removals(&removals, 1);
    assert(v.code == GmrvCode.Ok);
}

// **GMRV-10** - the maximum boundary accepted: exactly two
// hundred fifty-six removals.
test gmrv_10_max_boundary_accepted {
    var removals: [256]MemberRemoval;
    for i in 0..256 {
        removals[i] = MemberRemoval { leaf_index: i, leaf_blanked: true, key_cleared: true, ancestors_updated: true, epoch: 1, };
    }
    const v = validate_member_removals(&removals, 256);
    assert(v.code == GmrvCode.Ok);
}

// Rule order is the original's fixed ladder: the ceiling
// over a flooded batch with a wrong count, the count
// agreement over the per-record probes, and per record the
// zero epoch over the blanked leaf over the cleared key
// over the updated ancestors - one fully-violating record
// answering the epoch rule, then each single violation in
// turn.
test rule_order_matches_original {
    var flooded: [257]MemberRemoval;
    for i in 0..257 {
        flooded[i] = MemberRemoval { leaf_index: i, leaf_blanked: false, key_cleared: false, ancestors_updated: false, epoch: 0, };
    }
    const v1 = validate_member_removals(&flooded, 999);
    assert(v1.code == GmrvCode.TooManyRemovals);

    const all_bad: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: false, key_cleared: false, ancestors_updated: false, epoch: 0, },
    };
    const v2 = validate_member_removals(&all_bad, 999);
    assert(v2.code == GmrvCode.CountMismatch);

    const v3 = validate_member_removals(&all_bad, 1);
    assert(v3.code == GmrvCode.ZeroEpoch);
    assert(v3.leaf == 1);

    const not_blanked: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: false, key_cleared: false, ancestors_updated: false, epoch: 1, },
    };
    const v4 = validate_member_removals(&not_blanked, 1);
    assert(v4.code == GmrvCode.LeafNotBlanked);

    const key_held: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: false, ancestors_updated: false, epoch: 1, },
    };
    const v5 = validate_member_removals(&key_held, 1);
    assert(v5.code == GmrvCode.KeyNotCleared);

    const stale_ancestors: [1]MemberRemoval = [1]MemberRemoval{
        MemberRemoval { leaf_index: 1, leaf_blanked: true, key_cleared: true, ancestors_updated: false, epoch: 1, },
    };
    const v6 = validate_member_removals(&stale_ancestors, 1);
    assert(v6.code == GmrvCode.AncestorsNotUpdated);
}
