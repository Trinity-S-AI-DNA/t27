// **PREF-01** - the sixteen-byte reference rejected.
test pref_01_short_proposal_ref_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    var short_ref: [16]u8;
    for j in 0..16 {
        short_ref[j] = 51;
    }
    const v = validate_proposal_ref(&PROP_A, &short_ref, &GOOD_GID, 11, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.NonCanonicalProposalRefLength);
}

// **PREF-02** - the sixty-four-byte reference rejected.
test pref_02_over_long_proposal_ref_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    var long_ref: [64]u8;
    for j in 0..64 {
        long_ref[j] = 51;
    }
    const v = validate_proposal_ref(&PROP_A, &long_ref, &GOOD_GID, 11, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.NonCanonicalProposalRefLength);
}

// **PREF-03** - the empty identifier rejected.
test pref_03_empty_proposal_id_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    const empty_id: [0]u8 = [0]u8{};
    const v = validate_proposal_ref(&empty_id, &REF_33, &GOOD_GID, 11, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.EmptyProposalId);
}

// **PREF-04** - the phantom identifier rejected: never
// observed by the store.
test pref_04_unknown_proposal_id_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    const v = validate_proposal_ref(&PHANTOM, &REF_33, &GOOD_GID, 11, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.UnknownProposalRef);
}

// **PREF-05** - the cross-group reference rejected.
test pref_05_cross_group_proposal_ref_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    const v = validate_proposal_ref(&PROP_A, &REF_33, &OTHER_GID, 11, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.CrossGroupProposalRef);
}

// **PREF-06** - the stale-epoch reference rejected: ten of
// a current eleven.
test pref_06_stale_epoch_proposal_ref_rejected {
    const none: [0]UsedRef = [0]UsedRef{};
    const v = validate_proposal_ref(&PROP_A, &REF_33, &GOOD_GID, 10, &GOOD_GID, 11, &KNOWN_IDS, &none);
    assert(v.code == PrefCode.StaleEpochProposalRef);
}

// **PREF-07** - the replayed (identifier, reference) pair
// rejected.
