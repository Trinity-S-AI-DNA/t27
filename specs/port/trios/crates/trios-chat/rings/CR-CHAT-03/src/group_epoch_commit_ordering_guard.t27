module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::group_epoch_commit_ordering_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/group_epoch_commit_ordering_guard.rs
// (CR-CHAT-03 - Group epoch commit ordering guard, Wave-81
// Lane A, R-CHAT-2).
//
// Only one commit per epoch is valid; two independent
// commits at one epoch fork the group into divergent
// histories and stale commits become indistinguishable
// from concurrent ones. The gate, in the original's code
// order: the batch ceiling (two hundred fifty-six), the
// empty batch accepted, then per commit the minimum-epoch
// branch, the duplicate-epoch probe, and against the
// predecessor the strictly-increasing probe and the gap
// ceiling (one). The prose lists a sender-membership rule
// and the enum declares DuplicateSender, but no code path
// ever reads the sender - the variant stays in the enum,
// declared and unreachable exactly as in the original; the
// sender field rides along unread by every rule. The
// minimum-epoch branch is live code with the minimum at
// zero over an unsigned epoch - it never fires at these
// constants, in the original exactly as here.
//
// The original returns Result<(), CommitOrderError>. This
// port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order - DuplicateEpoch,
// NotIncreasing, EpochGapTooLarge, TooManyCommits,
// EpochBelowMinimum, DuplicateSender - with every payload
// field: the epoch a duplicate or below-minimum names, the
// gap the ceiling rule measured, the sender the unreachable
// variant would carry.
//
// The original's BTreeSet of seen epochs becomes a scan
// over the commits already visited (conventions section
// 4). The sender widens from u32 to usize - t27's loop
// counters are usize and every fixture value fits both.

// Maximum allowed epoch gap.
pub const GECO_MAX_EPOCH_GAP: u64 = 1;

// Maximum commits in a batch.
pub const GECO_MAX_COMMITS: usize = 256;

// Minimum epoch number.
pub const GECO_MIN_EPOCH: u64 = 0;

// A commit record.
pub struct CommitRecord {
    epoch: u64,
    sender: usize,
}

// Verdict codes: Ok(()) and CommitOrderError's variants, in declaration order.
pub enum GecoCode {
    Ok,
    DuplicateEpoch,
    NotIncreasing,
    EpochGapTooLarge,
    TooManyCommits,
    EpochBelowMinimum,
    DuplicateSender,
}

// The verdict of the commit ordering validation, with every
// payload field: the epoch of the duplicate and
// below-minimum rules, the measured gap of the ceiling, the
// sender of the unreachable variant.
pub struct GecoVerdict {
    code: GecoCode,
    epoch: u64,
    gap: u64,
    sender: usize,
}

// Whether a commit before position upto already claimed
// this epoch - the original's BTreeSet insert probe,
// answered by a scan.
pub fn epoch_seen_before(commits: []const CommitRecord, upto: usize, epoch: u64) -> bool {
    for j in 0..upto {
        if (commits[j].epoch == epoch) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate that commits are strictly ordered
// by epoch. Returns Ok only when every rule holds, checked
// in the original's code order: the batch ceiling, the
// empty batch, then per commit the minimum-epoch branch,
// the duplicate probe, the increasing probe and the gap
// ceiling against the predecessor.
pub fn validate_commit_ordering(commits: []const CommitRecord) -> GecoVerdict {
    if (commits.len > GECO_MAX_COMMITS) {
        return GecoVerdict { code: GecoCode.TooManyCommits, epoch: 0, gap: 0, sender: 0, };
    }
    if (commits.len == 0) {
        return GecoVerdict { code: GecoCode.Ok, epoch: 0, gap: 0, sender: 0, };
    }
    for i in 0..commits.len {
        if (commits[i].epoch < GECO_MIN_EPOCH) {
            return GecoVerdict { code: GecoCode.EpochBelowMinimum, epoch: commits[i].epoch, gap: 0, sender: 0, };
        }
        if (epoch_seen_before(commits, i, commits[i].epoch)) {
            return GecoVerdict { code: GecoCode.DuplicateEpoch, epoch: commits[i].epoch, gap: 0, sender: 0, };
        }
        if (i > 0) {
            const prev: u64 = commits[i - 1].epoch;
            if (commits[i].epoch <= prev) {
                return GecoVerdict { code: GecoCode.NotIncreasing, epoch: 0, gap: 0, sender: 0, };
            }
            const gap: u64 = commits[i].epoch - prev;
            if (gap > GECO_MAX_EPOCH_GAP) {
                return GecoVerdict { code: GecoCode.EpochGapTooLarge, epoch: 0, gap: gap, sender: 0, };
            }
        }
    }
    return GecoVerdict { code: GecoCode.Ok, epoch: 0, gap: 0, sender: 0, };
}

// **GECO-01** - the duplicate epoch rejected: epoch one
// committed twice, the verdict naming it.
test geco_01_duplicate_rejected {
    const commits: [3]CommitRecord = [3]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 1, sender: 1, },
        CommitRecord { epoch: 1, sender: 2, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.DuplicateEpoch);
    assert(v.epoch == 1);
}

// **GECO-02** - the not-increasing batch rejected: two
// then one.
test geco_02_not_increasing_rejected {
    const commits: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 2, sender: 0, },
        CommitRecord { epoch: 1, sender: 1, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.NotIncreasing);
}

// **GECO-03** - the epoch gap too large rejected: a jump of
// five over the ceiling of one, the verdict carrying the
// measured gap.
test geco_03_gap_rejected {
    const commits: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 5, sender: 1, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.EpochGapTooLarge);
    assert(v.gap == 5);
}

// **GECO-04** - too many commits rejected: two hundred
// fifty-seven of a ceiling of two hundred fifty-six, built
// in a loop like the original's; the ceiling fires before
// any epoch is examined.
test geco_04_too_many_rejected {
    var commits: [257]CommitRecord;
    for i in 0..257 {
        commits[i] = CommitRecord { epoch: @as(u64, i), sender: 0, };
    }
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.TooManyCommits);
}

// **GECO-05** - the minimum-epoch boundary: the original's
// fifth test pins epoch zero accepted - the minimum-epoch
// branch never fires at the zero minimum over unsigned
// epochs.
test geco_05_below_min_rejected {
    const commits: [1]CommitRecord = [1]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// **GECO-06** - the valid commits accepted: zero, one,
// two.
test geco_06_valid_accepted {
    const commits: [3]CommitRecord = [3]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 1, sender: 1, },
        CommitRecord { epoch: 2, sender: 0, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// **GECO-07** - the empty batch accepted.
test geco_07_empty_accepted {
    const commits: [0]CommitRecord = [0]CommitRecord{};
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// **GECO-08** - a single commit accepted.
test geco_08_single_accepted {
    const commits: [1]CommitRecord = [1]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// **GECO-09** - the maximum gap accepted: exactly one
// between neighbours.
test geco_09_max_gap_accepted {
    const commits: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 1, sender: 1, },
    };
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// **GECO-10** - many sequential commits accepted: a
// hundred, the senders cycling through five leaves, built
// in a loop like the original's.
test geco_10_many_accepted {
    var commits: [100]CommitRecord;
    for i in 0..100 {
        commits[i] = CommitRecord { epoch: @as(u64, i), sender: i % 5, };
    }
    const v = validate_commit_ordering(&commits);
    assert(v.code == GecoCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test epoch_seen_before_answers {
    const commits: [3]CommitRecord = [3]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 1, sender: 1, },
        CommitRecord { epoch: 0, sender: 2, },
    };
    assert(!epoch_seen_before(&commits, 0, 0));
    assert(!epoch_seen_before(&commits, 1, 1));
    assert(epoch_seen_before(&commits, 2, 0));
    assert(!epoch_seen_before(&commits, 2, 2));
}

// Rule order is the original's code order: the batch
// ceiling over a flooded batch of duplicates, the duplicate
// probe over the increasing probe on one pair (an equal
// epoch is both a duplicate and not increasing - the
// duplicate answers), and the increasing probe over the gap
// ceiling.
test rule_order_matches_original {
    var flooded: [257]CommitRecord;
    for i in 0..257 {
        flooded[i] = CommitRecord { epoch: 0, sender: 0, };
    }
    const v1 = validate_commit_ordering(&flooded);
    assert(v1.code == GecoCode.TooManyCommits);

    const equal_pair: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 2, sender: 0, },
        CommitRecord { epoch: 2, sender: 1, },
    };
    const v2 = validate_commit_ordering(&equal_pair);
    assert(v2.code == GecoCode.DuplicateEpoch);
    assert(v2.epoch == 2);

    const descending: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 5, sender: 0, },
        CommitRecord { epoch: 2, sender: 1, },
    };
    const v3 = validate_commit_ordering(&descending);
    assert(v3.code == GecoCode.NotIncreasing);

    const jumping: [2]CommitRecord = [2]CommitRecord{
        CommitRecord { epoch: 0, sender: 0, },
        CommitRecord { epoch: 5, sender: 1, },
    };
    const v4 = validate_commit_ordering(&jumping);
    assert(v4.code == GecoCode.EpochGapTooLarge);
}
