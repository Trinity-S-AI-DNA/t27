module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::leaf_node_signature_validation;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/leaf_node_signature_validation.rs
// (CR-CHAT-03 - MLS LeafNode signature validation, Wave-29
// Lane A, L-CHAT-3-leafsig, RFC 9420 7.1/7.3/7.6).
//
// The per-leaf signature binds a LeafNode to its group, its
// epoch, its signing key and its credential. The gate, in
// the original's fixed order: the canonical signature
// length (sixty-four), the group agreement, the epoch not
// strictly behind the receiver's, the advertised signing
// key equal to the credential's key at the canonical
// length (thirty-two), no reserved capability bit set
// outside the RFC-assigned mask, and the (group, epoch,
// key, signature) quadruple fresh against the ledger of
// accepted leaves.
//
// The original returns Result<(), LeafNodeSignatureError>.
// This port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order -
// NonCanonicalSignatureLength, CrossGroupBinding,
// StaleEpoch, SignatureKeyCredentialMismatch,
// ReservedCapabilityBitForge, SignatureReplay. Every
// original variant carries no payload, so the code is the
// whole verdict.
//
// The original's packet and view structs become flat
// parameters, the byte vectors arriving as plain slices.
// The ledger of used quadruples becomes a slice of records
// holding the group identifier at the fixture's canonical
// length with its own length, the epoch, and the canonical
// signing key and signature - the BTreeSet contains
// answered by a scan. The original's reserved-bit probe is
// bitwise; t27 has no bitwise arithmetic, so the probe
// re-bases over a table of powers of two - bit k of x is
// (x / P2[k]) mod 2, and a reserved bit is a set bit of
// the packet whose mask bit reads zero.

// Canonical length of an MLS LeafNode signature (64 bytes).
pub const LEAF_NODE_SIGNATURE_LEN: usize = 64;

// Canonical length of a LeafNode signing public key (32 bytes).
pub const LEAF_NODE_SIGNATURE_KEY_LEN: usize = 32;

// The powers of two, as a table - the bit probe reads
// (x / P2[k]) mod 2.
pub const P2: [64]u64 = [64]u64{1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648, 4294967296, 8589934592, 17179869184, 34359738368, 68719476736, 137438953472, 274877906944, 549755813888, 1099511627776, 2199023255552, 4398046511104, 8796093022208, 17592186044416, 35184372088832, 70368744177664, 140737488355328, 281474976710656, 562949953421312, 1125899906842624, 2251799813685248, 4503599627370496, 9007199254740992, 18014398509481984, 36028797018963968, 72057594037927936, 144115188075855872, 288230376151711744, 576460752303423488, 1152921504606846976, 2305843009213693952, 4611686018427387904, 9223372036854775808,}

// An accepted leaf-signature quadruple: the group
// identifier with its length, the epoch, and the canonical
// signing key and signature.
pub struct UsedLeafSig {
    group_id: [17]u8,
    gid_len: usize,
    epoch: u64,
    sig_key: [32]u8,
    signature: [64]u8,
}

// Verdict codes: Ok(()) and LeafNodeSignatureError's variants, in declaration order.
pub enum LnsCode {
    Ok,
    NonCanonicalSignatureLength,
    CrossGroupBinding,
    StaleEpoch,
    SignatureKeyCredentialMismatch,
    ReservedCapabilityBitForge,
    SignatureReplay,
}

// The verdict of the leaf signature validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct LnsVerdict {
    code: LnsCode,
}

// Content equality over two byte slices - the original's
// Vec equality on the group identifiers.
pub fn bytes_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for i in 0..a.len {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// Whether some set bit of the packet's capabilities sits
// outside the assigned mask - the original's bitwise probe
// (bits & !mask), re-based over the power table.
pub fn has_reserved_bit(bits: u64, mask: u64) -> bool {
    for k in 0..64 {
        if ((bits / P2[k]) % 2 == 1) {
            if ((mask / P2[k]) % 2 == 0) {
                return true;
            }
        }
    }
    return false;
}

// Whether this (group, epoch, key, signature) quadruple was
// already accepted - the original's BTreeSet contains,
// answered by a scan over the ledger records.
pub fn leaf_sig_used(used: []const UsedLeafSig, group_id: []const u8, epoch: u64, sig_key: []const u8, signature: []const u8) -> bool {
    for i in 0..used.len {
        if (used[i].epoch == epoch) {
            if (used[i].gid_len == group_id.len) {
                if (sig_key.len == 32) {
                    if (signature.len == 64) {
                        var same: bool = true;
                        for j in 0..group_id.len {
                            if (used[i].group_id[j] != group_id[j]) {
                                same = false;
                            }
                        }
                        for j in 0..32 {
                            if (used[i].sig_key[j] != sig_key[j]) {
                                same = false;
                            }
                        }
                        for j in 0..64 {
                            if (used[i].signature[j] != signature[j]) {
                                same = false;
                            }
                        }
                        if (same) {
                            return true;
                        }
                    }
                }
            }
        }
    }
    return false;
}

// [VERIFIED] Validate one LeafNode against the receiver's
// view. Returns Ok only when every rule holds, checked in
// the original's fixed order: the canonical signature
// length, the group, the epoch, the key agreement, the
// reserved-bit probe and the fresh quadruple.
pub fn validate_leaf_node_signature(group_id: []const u8, epoch: u64, signature_key: []const u8, credential_public_key: []const u8, signature: []const u8, capability_bits: u64, local_group_id: []const u8, current_epoch: u64, assigned_capability_mask: u64, used_leaf_signatures: []const UsedLeafSig) -> LnsVerdict {
    if (signature.len != LEAF_NODE_SIGNATURE_LEN) {
        return LnsVerdict { code: LnsCode.NonCanonicalSignatureLength, };
    }
    if (!bytes_equal(group_id, local_group_id)) {
        return LnsVerdict { code: LnsCode.CrossGroupBinding, };
    }
    if (epoch < current_epoch) {
        return LnsVerdict { code: LnsCode.StaleEpoch, };
    }
    if (signature_key.len != LEAF_NODE_SIGNATURE_KEY_LEN) {
        return LnsVerdict { code: LnsCode.SignatureKeyCredentialMismatch, };
    }
    if (credential_public_key.len != LEAF_NODE_SIGNATURE_KEY_LEN) {
        return LnsVerdict { code: LnsCode.SignatureKeyCredentialMismatch, };
    }
    if (!bytes_equal(signature_key, credential_public_key)) {
        return LnsVerdict { code: LnsCode.SignatureKeyCredentialMismatch, };
    }
    if (has_reserved_bit(capability_bits, assigned_capability_mask)) {
        return LnsVerdict { code: LnsCode.ReservedCapabilityBitForge, };
    }
    if (leaf_sig_used(used_leaf_signatures, group_id, epoch, signature_key, signature)) {
        return LnsVerdict { code: LnsCode.SignatureReplay, };
    }
    return LnsVerdict { code: LnsCode.Ok, };
}

// The fixture bytes: the local group, the stranger's group,
// the signing key of double-A-one-hex, the credential key
// of ninety-nine-hex, and the canonical signature of
// fifty-five-hex.
pub const GOOD_GID: [17]u8 = [17]u8{116, 114, 105, 110, 105, 116, 121, 45, 99, 104, 97, 116, 45, 114, 111, 111, 109,}
pub const OTHER_GID: [10]u8 = [10]u8{111, 116, 104, 101, 114, 45, 114, 111, 111, 109,}
pub const SIG_KEY: [32]u8 = [32]u8{161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161, 161,}
pub const CRED_KEY: [32]u8 = [32]u8{153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153,}
pub const SIGNATURE: [64]u8 = [64]u8{85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85, 85,}

// The capability fixtures: the RFC-assigned low sixteen
// bits as the mask, the good packet's low byte, and the
// forged forty-ninth bit.
pub const CAP_MASK: u64 = 65535;
pub const CAP_GOOD: u64 = 255;
pub const CAP_FORGED: u64 = 281474976710656;

// **LNS-01** - the thirty-two-byte signature rejected.
test lns_01_signature_too_short_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    var short_sig: [32]u8;
    for j in 0..32 {
        short_sig[j] = 85;
    }
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &short_sig, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.NonCanonicalSignatureLength);
}

// **LNS-02** - the ninety-six-byte signature rejected.
test lns_02_signature_too_long_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    var long_sig: [96]u8;
    for j in 0..96 {
        long_sig[j] = 85;
    }
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &long_sig, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.NonCanonicalSignatureLength);
}

// **LNS-03** - the cross-group LeafNode rejected.
test lns_03_cross_group_binding_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&OTHER_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.CrossGroupBinding);
}

// **LNS-04** - the stale-epoch LeafNode rejected: five of
// a current twelve.
test lns_04_stale_epoch_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&GOOD_GID, 5, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.StaleEpoch);
}

// **LNS-05** - the credential key mismatch rejected: the
// credential carries the stranger's key.
test lns_05_credential_key_mismatch_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &CRED_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.SignatureKeyCredentialMismatch);
}

// **LNS-06** - the non-canonical signature key length
// rejected: sixteen bytes on both sides, equal but short.
test lns_06_wrong_signature_key_len_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    var short_key: [16]u8;
    for j in 0..16 {
        short_key[j] = 161;
    }
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &short_key, &short_key, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.SignatureKeyCredentialMismatch);
}

// **LNS-07** - the reserved capability bit forge rejected:
// the forty-ninth bit outside the sixteen-bit mask.
test lns_07_reserved_capability_bit_rejected {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.ReservedCapabilityBitForge);
}

// **LNS-08** - the replayed quadruple rejected: this very
// (group, epoch, key, signature) was accepted before.
test lns_08_signature_replay_rejected {
    const used: [1]UsedLeafSig = [1]UsedLeafSig{
        UsedLeafSig { group_id: GOOD_GID, gid_len: 17, epoch: 12, sig_key: SIG_KEY, signature: SIGNATURE, },
    };
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v.code == LnsCode.SignatureReplay);
}

// **LNS-09** - the valid LeafNode at the current epoch
// accepted.
test lns_09_valid_current_epoch_accepted {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.Ok);
}

// **LNS-10** - the valid LeafNode at the next epoch
// accepted: the Commit source binds to current plus one.
test lns_10_valid_next_epoch_accepted {
    const none: [0]UsedLeafSig = [0]UsedLeafSig{};
    const v = validate_leaf_node_signature(&GOOD_GID, 13, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &none);
    assert(v.code == LnsCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test bytes_equal_answers {
    assert(bytes_equal(&GOOD_GID, &GOOD_GID));
    assert(!bytes_equal(&GOOD_GID, &OTHER_GID));
    assert(!bytes_equal(&SIG_KEY, &CRED_KEY));
}

test has_reserved_bit_answers {
    assert(!has_reserved_bit(CAP_GOOD, CAP_MASK));
    assert(has_reserved_bit(CAP_FORGED, CAP_MASK));
    assert(!has_reserved_bit(CAP_FORGED, 281474976710657));
    assert(has_reserved_bit(1, 0));
    assert(!has_reserved_bit(0, 0));
}

test leaf_sig_used_answers {
    const used: [1]UsedLeafSig = [1]UsedLeafSig{
        UsedLeafSig { group_id: GOOD_GID, gid_len: 17, epoch: 12, sig_key: SIG_KEY, signature: SIGNATURE, },
    };
    assert(leaf_sig_used(&used, &GOOD_GID, 12, &SIG_KEY, &SIGNATURE));
    assert(!leaf_sig_used(&used, &GOOD_GID, 13, &SIG_KEY, &SIGNATURE));
    assert(!leaf_sig_used(&used, &OTHER_GID, 12, &SIG_KEY, &SIGNATURE));
    assert(!leaf_sig_used(&used, &GOOD_GID, 12, &CRED_KEY, &SIGNATURE));
}

// Rule order is the original's fixed ladder, each probe
// stacking the earlier rule's violation on the later ones
// - the replayed quadruple riding under every earlier
// rule.
test rule_order_matches_original {
    const used: [1]UsedLeafSig = [1]UsedLeafSig{
        UsedLeafSig { group_id: GOOD_GID, gid_len: 17, epoch: 12, sig_key: SIG_KEY, signature: SIGNATURE, },
    };
    var short_sig: [32]u8;
    for j in 0..32 {
        short_sig[j] = 85;
    }

    const v1 = validate_leaf_node_signature(&OTHER_GID, 5, &SIG_KEY, &CRED_KEY, &short_sig, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v1.code == LnsCode.NonCanonicalSignatureLength);

    const v2 = validate_leaf_node_signature(&OTHER_GID, 5, &SIG_KEY, &CRED_KEY, &SIGNATURE, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v2.code == LnsCode.CrossGroupBinding);

    const v3 = validate_leaf_node_signature(&GOOD_GID, 5, &SIG_KEY, &CRED_KEY, &SIGNATURE, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v3.code == LnsCode.StaleEpoch);

    const v4 = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &CRED_KEY, &SIGNATURE, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v4.code == LnsCode.SignatureKeyCredentialMismatch);

    const v5 = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_FORGED, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v5.code == LnsCode.ReservedCapabilityBitForge);

    const v6 = validate_leaf_node_signature(&GOOD_GID, 12, &SIG_KEY, &SIG_KEY, &SIGNATURE, CAP_GOOD, &GOOD_GID, 12, CAP_MASK, &used);
    assert(v6.code == LnsCode.SignatureReplay);
}
