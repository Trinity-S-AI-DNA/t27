// The helpers have direct tests (coverage: Untested 0).
test tlnv_pair_seen_before_answers {
    const rs: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
    };
    assert(!tlnv_pair_seen_before(&rs, 0));
    assert(tlnv_pair_seen_before(&rs, 1));
}

test tlnv_prev_version_answers {
    const rs: [3]LeafVersionRecord = [3]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L02, version: 7, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 3, },
    };
    assert(tlnv_prev_version(&rs, 0) == 0);
    assert(tlnv_prev_version(&rs, 1) == 0);
    assert(tlnv_prev_version(&rs, 2) == 1);
}

// Rule order is the original's ladder: the batch ceiling over every
// per-record rule, the group id over the other identity rules, the leaf
// id over the version rules, the zero version over the duplicate, and
// the duplicate over the decrease.
test rule_order_matches_original {
    const group_first: [1]LeafVersionRecord = [1]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_GZERO32, leaf_id: TLNV_LZERO16, version: 0, },
    };
    assert(check_leaf_version_monotonicity(&group_first).code == TlnvCode.ZeroGroupId);

    const leaf_first: [1]LeafVersionRecord = [1]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_LZERO16, version: 0, },
    };
    assert(check_leaf_version_monotonicity(&leaf_first).code == TlnvCode.ZeroLeafId);

    const version_first: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 0, },
    };
    assert(check_leaf_version_monotonicity(&version_first).code == TlnvCode.ZeroVersion);

    const duplicate_first: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 5, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 5, },
    };
    assert(check_leaf_version_monotonicity(&duplicate_first).code == TlnvCode.DuplicateLeafVersion);
}
