// **TLNV-01** - a decreased version rejected.
test tlnv_01_version_decreased_rejected {
    const rs: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 5, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 3, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.VersionDecreased);
    assert(v.idx == 1);
    assert(v.got == 3);
    assert(v.prev == 5);
}

// **TLNV-02** - a zero leaf id rejected.
test tlnv_02_zero_leaf_rejected {
    const rs: [1]LeafVersionRecord = [1]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_LZERO16, version: 1, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.ZeroLeafId);
    assert(v.idx == 0);
}

// **TLNV-03** - a duplicate leaf-and-version pair rejected.
test tlnv_03_duplicate_rejected {
    const rs: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.DuplicateLeafVersion);
    assert(v.idx == 1);
}

// **TLNV-04** - a zero version rejected.
test tlnv_04_zero_version_rejected {
    const rs: [1]LeafVersionRecord = [1]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 0, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.ZeroVersion);
    assert(v.idx == 0);
}

// **TLNV-05** - a zero group id rejected.
test tlnv_05_zero_group_rejected {
    const rs: [1]LeafVersionRecord = [1]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_GZERO32, leaf_id: TLNV_L01, version: 1, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.ZeroGroupId);
    assert(v.idx == 0);
}

// **TLNV-06** - the batch of 1025 records rejected by the ceiling,
// before the per-record violations its records also carry.
test tlnv_06_too_many_rejected {
    const v = check_leaf_version_monotonicity(&TLNV_1025);
    assert(v.code == TlnvCode.TooMany);
    assert(v.got_count == TLNV_MAX_RECORDS + 1);
    assert(v.max == TLNV_MAX_RECORDS);
}

// **TLNV-07** - a valid batch accepted.
test tlnv_07_valid_accepted {
    const rs: [4]LeafVersionRecord = [4]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 2, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L02, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L02, version: 3, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.Ok);
}

// **TLNV-08** - an empty batch accepted.
test tlnv_08_empty_accepted {
    const rs: [0]LeafVersionRecord = [0]LeafVersionRecord{};
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.Ok);
}

// **TLNV-09** - the same version on a different leaf accepted.
test tlnv_09_same_version_diff_leaf {
    const rs: [2]LeafVersionRecord = [2]LeafVersionRecord{
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L01, version: 1, },
        LeafVersionRecord { group_id: TLNV_G01, leaf_id: TLNV_L02, version: 1, },
    };
    const v = check_leaf_version_monotonicity(&rs);
    assert(v.code == TlnvCode.Ok);
}

