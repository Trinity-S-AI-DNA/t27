module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_epoch_transition_integrity_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_epoch_transition_integrity_guard.rs
// (CR-CHAT-03 - TreeKEM epoch transition integrity guard, Wave-102 Lane A,
// RATCHET TREE).
//
// Each epoch transition rekeys the tree. A corrupted or incomplete
// transition derives different secrets on different nodes, forks the
// group with two tree hashes for one epoch, or silently weakens the
// tree. The gate holds six failure modes closed, in the code's fixed
// order: the batch ceiling, then per transition the non-zero epoch, the
// depth ceiling, the strictly increasing epoch, the changed tree hash,
// and the fresh tree hash.
//
// The original returns Result<(), EpochTransitionError>. This port
// carries the verdict as a named struct (owner decision D5): Ok first,
// then the six variants in the original's declaration order -
// NotIncreasing, HashUnchanged, ZeroEpoch, DepthExceeded, DuplicateHash,
// TooMany - with every payload field: the index, the previous and the
// current epochs, the depth and its ceiling, and the got and max counts.
//
// The BTreeSet of tree hashes becomes a scan over the transitions
// already visited; the fixed thirty-two-byte hash compares through the
// shared ids32_equal.

// The maximum tree depth.
pub const TETI_MAX_DEPTH: u32 = 32;

// The maximum transitions per batch.
pub const TETI_MAX_TRANSITIONS: usize = 1024;

// The tree hash length.
pub const TETI_HASH_LEN: usize = 32;

// An epoch transition: the epoch, the tree hash after it, and the tree
// depth after it.
pub struct EpochTransition {
    epoch: u64,
    tree_hash: [32]u8,
    tree_depth: u32,
}

// Verdict codes: Ok(()) and EpochTransitionError's variants, in
// declaration order.
pub enum TetiCode {
    Ok,
    NotIncreasing,
    HashUnchanged,
    ZeroEpoch,
    DepthExceeded,
    DuplicateHash,
    TooMany,
}

// The verdict of the epoch transition gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct TetiVerdict {
    code: TetiCode,
    idx: usize,
    prev: u64,
    current: u64,
    depth: u32,
    max: u32,
    max_count: usize,
    got: usize,
}

// Whether the tree hash of transition i was already seen in an earlier
// transition - the original's seen.insert failure.
pub fn teti_hash_seen_before(transitions: []const EpochTransition, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(transitions[j].tree_hash, transitions[i].tree_hash)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM epoch transition integrity. Returns Ok
// only when the batch size and every transition pass, checked in the
// original's fixed order.
pub fn check_epoch_transitions(transitions: []const EpochTransition) -> TetiVerdict {
    if (transitions.len > TETI_MAX_TRANSITIONS) {
        return TetiVerdict { code: TetiCode.TooMany, idx: 0, prev: 0, current: 0, depth: 0, max: 0, max_count: TETI_MAX_TRANSITIONS, got: transitions.len, };
    }
    var prev_epoch: u64 = 0;
    for i in 0..transitions.len {
        if (transitions[i].epoch == 0) {
            return TetiVerdict { code: TetiCode.ZeroEpoch, idx: i, prev: 0, current: 0, depth: 0, max: 0, max_count: 0, got: 0, };
        }
        if (transitions[i].tree_depth > TETI_MAX_DEPTH) {
            return TetiVerdict { code: TetiCode.DepthExceeded, idx: i, prev: 0, current: 0, depth: transitions[i].tree_depth, max: TETI_MAX_DEPTH, max_count: 0, got: 0, };
        }
        if (i > 0) {
            if (transitions[i].epoch <= prev_epoch) {
                return TetiVerdict { code: TetiCode.NotIncreasing, idx: i, prev: prev_epoch, current: transitions[i].epoch, depth: 0, max: 0, max_count: 0, got: 0, };
            }
            if (ids32_equal(transitions[i].tree_hash, transitions[i - 1].tree_hash)) {
                return TetiVerdict { code: TetiCode.HashUnchanged, idx: i, prev: 0, current: 0, depth: 0, max: 0, max_count: 0, got: 0, };
            }
        }
        if (teti_hash_seen_before(transitions, i)) {
            return TetiVerdict { code: TetiCode.DuplicateHash, idx: i, prev: 0, current: 0, depth: 0, max: 0, max_count: 0, got: 0, };
        }
        prev_epoch = transitions[i].epoch;
    }
    return TetiVerdict { code: TetiCode.Ok, idx: 0, prev: 0, current: 0, depth: 0, max: 0, max_count: 0, got: 0, };
}

