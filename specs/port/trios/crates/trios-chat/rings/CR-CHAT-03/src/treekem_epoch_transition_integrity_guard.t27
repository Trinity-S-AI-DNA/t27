        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
        EpochTransition { epoch: 1, tree_hash: TETI_ZERO32, tree_depth: 4, },
    };

// **TETI-01** - an epoch that does not increase is rejected.
test teti_01_not_increasing_rejected {
    const ts: [2]EpochTransition = [2]EpochTransition{
        EpochTransition { epoch: 5, tree_hash: TETI_H01, tree_depth: 4, },
        EpochTransition { epoch: 3, tree_hash: TETI_H02, tree_depth: 4, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.NotIncreasing);
    assert(v.idx == 1);
    assert(v.prev == 5);
    assert(v.current == 3);
}

// **TETI-02** - an unchanged tree hash is rejected.
test teti_02_hash_unchanged_rejected {
    const ts: [2]EpochTransition = [2]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 2, tree_hash: TETI_HAA, tree_depth: 4, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.HashUnchanged);
    assert(v.idx == 1);
}

// **TETI-03** - a zero epoch is rejected.
test teti_03_zero_epoch_rejected {
    const ts: [1]EpochTransition = [1]EpochTransition{
        EpochTransition { epoch: 0, tree_hash: TETI_H01, tree_depth: 4, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.ZeroEpoch);
    assert(v.idx == 0);
}

// **TETI-04** - a depth beyond the ceiling is rejected.
test teti_04_depth_exceeded_rejected {
    const ts: [1]EpochTransition = [1]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_H01, tree_depth: TETI_MAX_DEPTH + 1, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.DepthExceeded);
    assert(v.idx == 0);
    assert(v.depth == TETI_MAX_DEPTH + 1);
    assert(v.max == TETI_MAX_DEPTH);
}

// **TETI-05** - a duplicate tree hash is rejected.
test teti_05_duplicate_hash_rejected {
    const ts: [3]EpochTransition = [3]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 2, tree_hash: TETI_HBB, tree_depth: 4, },
        EpochTransition { epoch: 3, tree_hash: TETI_HAA, tree_depth: 5, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.DuplicateHash);
    assert(v.idx == 2);
}

// **TETI-06** - the batch of 1025 transitions rejected by the ceiling.
test teti_06_too_many_rejected {
    const v = check_epoch_transitions(&TETI_1025);
    assert(v.code == TetiCode.TooMany);
    assert(v.got == TETI_MAX_TRANSITIONS + 1);
    assert(v.max_count == TETI_MAX_TRANSITIONS);
}

// **TETI-07** - a valid batch accepted.
test teti_07_valid_accepted {
    const ts: [3]EpochTransition = [3]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_H01, tree_depth: 4, },
        EpochTransition { epoch: 2, tree_hash: TETI_H02, tree_depth: 4, },
        EpochTransition { epoch: 3, tree_hash: TETI_H03, tree_depth: 5, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.Ok);
}

// **TETI-08** - an empty batch accepted.
test teti_08_empty_accepted {
    const ts: [0]EpochTransition = [0]EpochTransition{};
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.Ok);
}

// **TETI-09** - a single transition accepted.
test teti_09_single_accepted {
    const ts: [1]EpochTransition = [1]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_H01, tree_depth: 4, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.Ok);
}

// **TETI-10** - the maximum depth boundary accepted.
test teti_10_max_depth_accepted {
    const ts: [1]EpochTransition = [1]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_H01, tree_depth: TETI_MAX_DEPTH, },
    };
    const v = check_epoch_transitions(&ts);
    assert(v.code == TetiCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test teti_hash_seen_before_answers {
    const ts: [3]EpochTransition = [3]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 2, tree_hash: TETI_HBB, tree_depth: 4, },
        EpochTransition { epoch: 3, tree_hash: TETI_HAA, tree_depth: 5, },
    };
    assert(!teti_hash_seen_before(&ts, 0));
    assert(!teti_hash_seen_before(&ts, 1));
    assert(teti_hash_seen_before(&ts, 2));
}

// Rule order is the original's ladder: the batch ceiling over every
// per-transition rule, the zero epoch over the depth and epoch rules,
// the depth over the epoch rules, the increasing epoch over the hash
// rules, and the unchanged hash over the duplicate.
test rule_order_matches_original {
    const zero_and_deep: [2]EpochTransition = [2]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 0, tree_hash: TETI_HBB, tree_depth: 33, },
    };
    assert(check_epoch_transitions(&zero_and_deep).code == TetiCode.ZeroEpoch);

    const deep: [1]EpochTransition = [1]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_H01, tree_depth: 33, },
    };
    assert(check_epoch_transitions(&deep).code == TetiCode.DepthExceeded);

    const regress_and_same: [2]EpochTransition = [2]EpochTransition{
        EpochTransition { epoch: 5, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 4, tree_hash: TETI_HAA, tree_depth: 4, },
    };
    assert(check_epoch_transitions(&regress_and_same).code == TetiCode.NotIncreasing);

    const same_and_dup: [2]EpochTransition = [2]EpochTransition{
        EpochTransition { epoch: 1, tree_hash: TETI_HAA, tree_depth: 4, },
        EpochTransition { epoch: 2, tree_hash: TETI_HAA, tree_depth: 4, },
    };
    assert(check_epoch_transitions(&same_and_dup).code == TetiCode.HashUnchanged);
}
