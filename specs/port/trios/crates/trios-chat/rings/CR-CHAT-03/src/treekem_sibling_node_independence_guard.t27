    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.Ok);
}

// The four probes have direct tests (coverage: Untested 0).
test tsni_helpers_answer {
    const ns: [3]TreeNode = [3]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KAA, },
        TreeNode { node_index: 1, level: 0, key_hash: TSNI_KA1, },
        TreeNode { node_index: 0, level: 1, key_hash: TSNI_KAA, },
    };
    assert(!tsni_key_all_zero(&ns, 0));
    assert(tsni_index_seen_before(&ns, 2));
    assert(!tsni_index_seen_before(&ns, 1));
    assert(tsni_key_seen_before(&ns, 2));
    assert(!tsni_key_seen_before(&ns, 1));
    assert(tsni_key_dup_first(&ns, 2) == 0);
    assert(tsni_key_dup_first(&ns, 1) == 1);
    const zeroed: [1]TreeNode = [1]TreeNode{
        TreeNode { node_index: 9, level: 0, key_hash: TSNI_ZERO32, },
    };
    assert(tsni_key_all_zero(&zeroed, 0));
    assert(tsni_key_dup_first(&zeroed, 0) == 9);
}

// Rule order is the original code's: the batch ceiling before any
// per-node rule, the zero key before the level ceiling, the level
// ceiling before the repeated index, and the whole first pass
// before the shared key scan.
test rule_order_matches_original {
    const zero_and_level: [1]TreeNode = [1]TreeNode{
        TreeNode { node_index: 0, level: TSNI_MAX_LEVEL + 1, key_hash: TSNI_ZERO32, },
    };
    const v1 = validate_sibling_independence(&zero_and_level);
    assert(v1.code == TsniCode.ZeroKey);

    const level_and_dup: [2]TreeNode = [2]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KA1, },
        TreeNode { node_index: 0, level: TSNI_MAX_LEVEL + 1, key_hash: TSNI_KA2, },
    };
    const v2 = validate_sibling_independence(&level_and_dup);
    assert(v2.code == TsniCode.LevelTooHigh);

    const dup_index_hides_shared_key: [2]TreeNode = [2]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KAA, },
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KAA, },
    };
    const v3 = validate_sibling_independence(&dup_index_hides_shared_key);
    assert(v3.code == TsniCode.DuplicateIndex);

    const shared_key_after_clean_pass: [2]TreeNode = [2]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KA1, },
        TreeNode { node_index: 1, level: 0, key_hash: TSNI_KA1, },
    };
    const v4 = validate_sibling_independence(&shared_key_after_clean_pass);
    assert(v4.code == TsniCode.SharedKey);
    assert(v4.node_a == 0);
    assert(v4.node_b == 1);
}
