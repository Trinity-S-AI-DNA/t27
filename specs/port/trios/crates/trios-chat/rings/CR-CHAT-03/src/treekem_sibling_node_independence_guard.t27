    };
    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.TooMany);
    assert(v.got == TSNI_MAX_NODES + 1);
    assert(v.max_count == TSNI_MAX_NODES);
}

// **TSNI-06** - valid accepted.
test tsni_06_valid_accepted {
    const ns: [6]TreeNode = [6]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KA1, },
        TreeNode { node_index: 1, level: 0, key_hash: TSNI_KA2, },
        TreeNode { node_index: 2, level: 0, key_hash: TSNI_KA3, },
        TreeNode { node_index: 3, level: 0, key_hash: TSNI_KA4, },
        TreeNode { node_index: 4, level: 1, key_hash: TSNI_KB1, },
        TreeNode { node_index: 5, level: 1, key_hash: TSNI_KB2, },
    };
    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.Ok);
}

// **TSNI-07** - empty accepted.
test tsni_07_empty_accepted {
    const ns: [0]TreeNode = [0]TreeNode{};
    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.Ok);
}

// **TSNI-08** - single node accepted.
test tsni_08_single_accepted {
    const ns: [1]TreeNode = [1]TreeNode{
        TreeNode { node_index: 0, level: 0, key_hash: TSNI_KAA, },
    };
    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.Ok);
}

// **TSNI-09** - max level boundary accepted.
test tsni_09_max_level_accepted {
    const ns: [1]TreeNode = [1]TreeNode{
        TreeNode { node_index: 0, level: TSNI_MAX_LEVEL, key_hash: TSNI_KAA, },
    };
    const v = validate_sibling_independence(&ns);
    assert(v.code == TsniCode.Ok);
}

