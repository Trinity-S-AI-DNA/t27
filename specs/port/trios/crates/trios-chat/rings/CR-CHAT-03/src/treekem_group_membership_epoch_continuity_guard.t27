module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_group_membership_epoch_continuity_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_group_membership_epoch_continuity_guard.rs
// (CR-CHAT-03 - TreeKEM group membership epoch continuity guard, Wave-156 Lane A,
// RATCHET TREE).
//
// Every membership change advances the epoch by exactly one. A gap lets
// an attacker inject members during the gap, desynchronizes members with
// different epoch views, and reopens replay. The gate holds six failure
// modes closed, in the code's fixed order: the batch ceiling, then per
// operation the non-zero id, the fresh id, the non-zero epoch, the
// epoch-continuity rule, and the operation-type vocabulary.
//
// The original returns Result<(), EpochContinuityError>. This port
// carries the verdict as a named struct (owner decision D5): Ok first,
// then the six variants in the original's declaration order -
// NonContinuous, ZeroEpoch, ZeroOpId, DuplicateOpId, InvalidOpType,
// TooMany - with every payload field: the index, the previous and the
// got epoch, the offending type, and the got and max counts.
//
// The BTreeSet of operation ids becomes a scan over the operations
// already visited; the sixteen-byte id compares through the shared
// ids16_equal and probes zero through the shared zero_id16. The
// Option<u64> previous epoch becomes a flag plus a value, and the two
// different got payloads (a u64 epoch and a u8 type, plus a usize count)
// are kept apart, since t27 forbids narrowing across them.

// The maximum operations per batch.
pub const TGMC_MAX_OPS: usize = 512;

// The operation id length.
pub const TGMC_OP_ID_LEN: usize = 16;

// The valid operation types, smallest first.
const TGMC_VALID_OP_TYPES: [3]u8 = [3]u8{1, 2, 3,};

// A membership operation: the sixteen-byte id, the epoch, the type.
pub struct MembershipOp {
    op_id: [16]u8,
    epoch: u64,
    op_type: u8,
}

// Verdict codes: Ok(()) and EpochContinuityError's variants, in
// declaration order.
pub enum TgmcCode {
    Ok,
    NonContinuous,
    ZeroEpoch,
    ZeroOpId,
    DuplicateOpId,
    InvalidOpType,
    TooMany,
}

// The verdict of the epoch continuity gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct TgmcVerdict {
    code: TgmcCode,
    idx: usize,
    prev: u64,
    got_epoch: u64,
    got_type: u8,
    got_count: usize,
    max: usize,
}

// Whether the operation id of op i was already seen in an earlier
// operation - the original's seen.insert failure.
pub fn tgmc_seen_before(ops: []const MembershipOp, i: usize) -> bool {
    for j in 0..i {
        if (ids16_equal(ops[j].op_id, ops[i].op_id)) {
            return true;
        }
    }
    return false;
}

// Whether the operation type is in the vocabulary - the original's
// TGMC_VALID_OP_TYPES.contains.
pub fn tgmc_valid_op_type(t: u8) -> bool {
    for i in 0..TGMC_VALID_OP_TYPES.len {
        if (TGMC_VALID_OP_TYPES[i] == t) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate group membership epoch continuity. Returns Ok only
// when the batch size and every operation pass, checked in the original's
// fixed order.
pub fn check_epoch_continuity(ops: []const MembershipOp) -> TgmcVerdict {
    if (ops.len > TGMC_MAX_OPS) {
        return TgmcVerdict { code: TgmcCode.TooMany, idx: 0, prev: 0, got_epoch: 0, got_type: 0, got_count: ops.len, max: TGMC_MAX_OPS, };
    }
    var prev_epoch: u64 = 0;
    var has_prev: bool = false;
    for i in 0..ops.len {
        if (zero_id16(ops[i].op_id)) {
            return TgmcVerdict { code: TgmcCode.ZeroOpId, idx: i, prev: 0, got_epoch: 0, got_type: 0, got_count: 0, max: 0, };
        }
        if (tgmc_seen_before(ops, i)) {
            return TgmcVerdict { code: TgmcCode.DuplicateOpId, idx: i, prev: 0, got_epoch: 0, got_type: 0, got_count: 0, max: 0, };
        }
        if (ops[i].epoch == 0) {
            return TgmcVerdict { code: TgmcCode.ZeroEpoch, idx: i, prev: 0, got_epoch: 0, got_type: 0, got_count: 0, max: 0, };
        }
        if (has_prev) {
            if (ops[i].epoch != prev_epoch + 1) {
                return TgmcVerdict { code: TgmcCode.NonContinuous, idx: i, prev: prev_epoch, got_epoch: ops[i].epoch, got_type: 0, got_count: 0, max: 0, };
            }
        }
        if (!tgmc_valid_op_type(ops[i].op_type)) {
            return TgmcVerdict { code: TgmcCode.InvalidOpType, idx: i, prev: 0, got_epoch: 0, got_type: ops[i].op_type, got_count: 0, max: 0, };
        }
        prev_epoch = ops[i].epoch;
        has_prev = true;
    }
    return TgmcVerdict { code: TgmcCode.Ok, idx: 0, prev: 0, got_epoch: 0, got_type: 0, got_count: 0, max: 0, };
}

