// **TGMC-01** - a non-continuous epoch rejected.
test tgmc_01_non_continuous_rejected {
    const ops: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID02, epoch: 3, op_type: 1, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.NonContinuous);
    assert(v.idx == 1);
    assert(v.prev == 1);
    assert(v.got_epoch == 3);
}

// **TGMC-02** - a zero epoch rejected.
test tgmc_02_zero_epoch_rejected {
    const ops: [1]MembershipOp = [1]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 0, op_type: 1, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.ZeroEpoch);
    assert(v.idx == 0);
}

// **TGMC-03** - a zero operation id rejected.
test tgmc_03_zero_op_id_rejected {
    const ops: [1]MembershipOp = [1]MembershipOp{
        MembershipOp { op_id: TGMC_ZERO16, epoch: 1, op_type: 1, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.ZeroOpId);
    assert(v.idx == 0);
}

// **TGMC-04** - a duplicate operation id rejected.
test tgmc_04_duplicate_rejected {
    const ops: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID01, epoch: 2, op_type: 1, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.DuplicateOpId);
    assert(v.idx == 1);
}

// **TGMC-05** - an invalid operation type rejected.
test tgmc_05_invalid_op_type_rejected {
    const ops: [1]MembershipOp = [1]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 99, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.InvalidOpType);
    assert(v.idx == 0);
    assert(v.got_type == 99);
}

// **TGMC-06** - the batch of 513 operations rejected by the ceiling,
// before the per-operation violations its records also carry.
test tgmc_06_too_many_rejected {
    const v = check_epoch_continuity(&TGMC_513);
    assert(v.code == TgmcCode.TooMany);
    assert(v.got_count == TGMC_MAX_OPS + 1);
    assert(v.max == TGMC_MAX_OPS);
}

// **TGMC-07** - a valid batch accepted.
test tgmc_07_valid_accepted {
    const ops: [4]MembershipOp = [4]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID02, epoch: 2, op_type: 3, },
        MembershipOp { op_id: TGMC_ID03, epoch: 3, op_type: 2, },
        MembershipOp { op_id: TGMC_ID04, epoch: 4, op_type: 1, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.Ok);
}

// **TGMC-08** - an empty batch accepted.
test tgmc_08_empty_accepted {
    const ops: [0]MembershipOp = [0]MembershipOp{};
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.Ok);
}

// **TGMC-09** - a single operation accepted: the first epoch is not
// checked against a predecessor.
test tgmc_09_single_accepted {
    const ops: [1]MembershipOp = [1]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 5, op_type: 2, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.Ok);
}

// **TGMC-10** - a long continuous chain accepted.
test tgmc_10_long_chain_accepted {
    const ops: [20]MembershipOp = [20]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID02, epoch: 2, op_type: 2, },
        MembershipOp { op_id: TGMC_ID03, epoch: 3, op_type: 3, },
        MembershipOp { op_id: TGMC_ID04, epoch: 4, op_type: 1, },
        MembershipOp { op_id: TGMC_ID05, epoch: 5, op_type: 2, },
        MembershipOp { op_id: TGMC_ID06, epoch: 6, op_type: 3, },
        MembershipOp { op_id: TGMC_ID07, epoch: 7, op_type: 1, },
        MembershipOp { op_id: TGMC_ID08, epoch: 8, op_type: 2, },
        MembershipOp { op_id: TGMC_ID09, epoch: 9, op_type: 3, },
        MembershipOp { op_id: TGMC_ID10, epoch: 10, op_type: 1, },
        MembershipOp { op_id: TGMC_ID11, epoch: 11, op_type: 2, },
        MembershipOp { op_id: TGMC_ID12, epoch: 12, op_type: 3, },
        MembershipOp { op_id: TGMC_ID13, epoch: 13, op_type: 1, },
        MembershipOp { op_id: TGMC_ID14, epoch: 14, op_type: 2, },
        MembershipOp { op_id: TGMC_ID15, epoch: 15, op_type: 3, },
        MembershipOp { op_id: TGMC_ID16, epoch: 16, op_type: 1, },
        MembershipOp { op_id: TGMC_ID17, epoch: 17, op_type: 2, },
        MembershipOp { op_id: TGMC_ID18, epoch: 18, op_type: 3, },
        MembershipOp { op_id: TGMC_ID19, epoch: 19, op_type: 1, },
        MembershipOp { op_id: TGMC_ID20, epoch: 20, op_type: 2, },
    };
    const v = check_epoch_continuity(&ops);
    assert(v.code == TgmcCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test tgmc_seen_before_answers {
    const ops: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID01, epoch: 2, op_type: 1, },
    };
    assert(!tgmc_seen_before(&ops, 0));
    assert(tgmc_seen_before(&ops, 1));
}

test tgmc_valid_op_type_answers {
    assert(tgmc_valid_op_type(1));
    assert(tgmc_valid_op_type(2));
    assert(tgmc_valid_op_type(3));
    assert(!tgmc_valid_op_type(0));
    assert(!tgmc_valid_op_type(99));
}

// Rule order is the original's ladder: the batch ceiling over every
// per-operation rule, the zero id over the duplicate, epoch and type
// rules, the duplicate over the epoch rules, the zero epoch over the
// continuity rule, and the continuity over the type vocabulary.
test rule_order_matches_original {
    const zero_id_first: [1]MembershipOp = [1]MembershipOp{
        MembershipOp { op_id: TGMC_ZERO16, epoch: 0, op_type: 99, },
    };
    assert(check_epoch_continuity(&zero_id_first).code == TgmcCode.ZeroOpId);

    const duplicate_first: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID01, epoch: 0, op_type: 99, },
    };
    assert(check_epoch_continuity(&duplicate_first).code == TgmcCode.DuplicateOpId);

    const zero_epoch_first: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 5, op_type: 1, },
        MembershipOp { op_id: TGMC_ID02, epoch: 0, op_type: 1, },
    };
    assert(check_epoch_continuity(&zero_epoch_first).code == TgmcCode.ZeroEpoch);

    const continuity_first: [2]MembershipOp = [2]MembershipOp{
        MembershipOp { op_id: TGMC_ID01, epoch: 1, op_type: 1, },
        MembershipOp { op_id: TGMC_ID02, epoch: 3, op_type: 99, },
    };
    assert(check_epoch_continuity(&continuity_first).code == TgmcCode.NonContinuous);
}
