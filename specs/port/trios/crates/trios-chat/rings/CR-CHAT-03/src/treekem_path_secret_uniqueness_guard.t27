// **TPSU-10** - unique secrets unique indices accepted.
test tpsu_10_unique_accepted {
    const ns: [4]PathSecretNode = [4]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_S01, },
        PathSecretNode { node_index: 1, secret: TPSU_S02, },
        PathSecretNode { node_index: 2, secret: TPSU_S03, },
        PathSecretNode { node_index: 3, secret: TPSU_S04, },
    };
    const v = validate_path_secret_uniqueness(&ns);
    assert(v.code == TpsuCode.Ok);
}

// The four probes have direct tests (coverage: Untested 0).
test tpsu_helpers_answer {
    const ns: [3]PathSecretNode = [3]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_SAA, },
        PathSecretNode { node_index: 1, secret: TPSU_SBB, },
        PathSecretNode { node_index: 0, secret: TPSU_SAA, },
    };
    assert(!tpsu_secret_all_zero(&ns, 0));
    assert(tpsu_index_seen_before(&ns, 2));
    assert(!tpsu_index_seen_before(&ns, 1));
    assert(tpsu_secret_seen_before(&ns, 2));
    assert(!tpsu_secret_seen_before(&ns, 1));
    assert(tpsu_secret_dup_first(&ns, 2) == 0);
    assert(tpsu_secret_dup_first(&ns, 1) == 1);
    const zeroed: [1]PathSecretNode = [1]PathSecretNode{
        PathSecretNode { node_index: 7, secret: TPSU_ZERO32, },
    };
    assert(tpsu_secret_all_zero(&zeroed, 0));
    assert(tpsu_secret_dup_first(&zeroed, 0) == 7);
}

// Rule order is the original code's: the batch ceiling before any
// per-node rule, the index ceiling before the zero secret, the zero
// secret before the repeated index, and the repeated index before
// the repeated secret.
test rule_order_matches_original {
    const zero_and_range: [1]PathSecretNode = [1]PathSecretNode{
        PathSecretNode { node_index: TPSU_MAX_NODES, secret: TPSU_ZERO32, },
    };
    const v1 = validate_path_secret_uniqueness(&zero_and_range);
    assert(v1.code == TpsuCode.IndexOutOfRange);

    const twin_zero: [2]PathSecretNode = [2]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_ZERO32, },
        PathSecretNode { node_index: 0, secret: TPSU_ZERO32, },
    };
    const v2 = validate_path_secret_uniqueness(&twin_zero);
    assert(v2.code == TpsuCode.ZeroSecret);

    const twin_index_secret: [2]PathSecretNode = [2]PathSecretNode{
        PathSecretNode { node_index: 5, secret: TPSU_SAA, },
        PathSecretNode { node_index: 5, secret: TPSU_SAA, },
    };
    const v3 = validate_path_secret_uniqueness(&twin_index_secret);
    assert(v3.code == TpsuCode.DuplicateIndex);

    const dup_secret_first_owner: [3]PathSecretNode = [3]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_SAA, },
        PathSecretNode { node_index: 1, secret: TPSU_SBB, },
        PathSecretNode { node_index: 2, secret: TPSU_SAA, },
    };
    const v4 = validate_path_secret_uniqueness(&dup_secret_first_owner);
    assert(v4.code == TpsuCode.DuplicateSecret);
    assert(v4.node_a == 0);
    assert(v4.node_b == 2);
}
