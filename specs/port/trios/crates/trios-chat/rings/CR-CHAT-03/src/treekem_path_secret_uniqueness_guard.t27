// **TPSU-05** - index out of range rejected.
test tpsu_05_index_out_of_range_rejected {
    const ns: [1]PathSecretNode = [1]PathSecretNode{
        PathSecretNode { node_index: TPSU_MAX_NODES, secret: TPSU_SAA, },
    };
    const v = validate_path_secret_uniqueness(&ns);
    assert(v.code == TpsuCode.IndexOutOfRange);
    assert(v.node == TPSU_MAX_NODES);
}

// **TPSU-06** - valid nodes accepted.
test tpsu_06_valid_accepted {
    const ns: [3]PathSecretNode = [3]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_SAA, },
        PathSecretNode { node_index: 1, secret: TPSU_SBB, },
        PathSecretNode { node_index: 2, secret: TPSU_SCC, },
    };
    const v = validate_path_secret_uniqueness(&ns);
    assert(v.code == TpsuCode.Ok);
}

// **TPSU-07** - empty accepted.
test tpsu_07_empty_accepted {
    const ns: [0]PathSecretNode = [0]PathSecretNode{};
    const v = validate_path_secret_uniqueness(&ns);
    assert(v.code == TpsuCode.Ok);
}

// **TPSU-08** - single node accepted.
test tpsu_08_single_accepted {
    const ns: [1]PathSecretNode = [1]PathSecretNode{
        PathSecretNode { node_index: 0, secret: TPSU_SFF, },
    };
    const v = validate_path_secret_uniqueness(&ns);
    assert(v.code == TpsuCode.Ok);
}

