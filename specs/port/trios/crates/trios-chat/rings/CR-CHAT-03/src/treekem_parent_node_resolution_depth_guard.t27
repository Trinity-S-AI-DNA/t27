module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_parent_node_resolution_depth_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_parent_node_resolution_depth_guard.rs
// (CR-CHAT-03 - TreeKEM parent node resolution depth guard, Wave-106
// Lane A).
//
// The original's Vec<u64> path becomes a fixed [32]u64 record field with
// the live length in path_len; the longest test path is the depth
// ceiling itself (TPNR-10 walks 32 nodes). The original's BTreeSet
// insert probe becomes a seen-before scan over the path prefix. The
// verdict is a named struct (owner decision D5): Ok first, the
// variants in the original's declaration order, every payload field
// of every variant kept. The three same-named max payloads differ in
// type (u32 depth, usize batch, u64 node) and land in three verdict
// fields: max, max_count and max64. Rule order is the original code's,
// not the prose header's: the batch ceiling, then per resolution the
// zero node, the node ceiling, the depth ceiling, then per path node
// the duplicate and the strictly-increasing probe.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * RESOLUTION-DEPTH

// Maximum resolution depth.
pub const TPNR_MAX_DEPTH: u32 = 32;

// Maximum nodes in tree.
pub const TPNR_MAX_NODES: u64 = 1000000;

// Maximum resolutions per batch.
pub const TPNR_MAX_RESOLUTIONS: usize = 1024;

// A node resolution record. The original's Vec<u64> path becomes a
// fixed-capacity array with the live length in path_len; the unread
// padding entries are never touched.
pub struct NodeResolution {
    node_index: u64,
    depth: u32,
    path: [32]u64,
    path_len: usize,
}

// All ways node resolution validation can fail, in the original's
// declaration order, with Ok first.
pub enum TpnrCode {
    Ok,
    DepthExceeded,
    ZeroNode,
    NotIncreasing,
    DuplicateInPath,
    TooMany,
    NodeExceedsMax,
}

// The verdict of the node resolution validation, carrying every
// payload field of every error variant.
pub struct TpnrVerdict {
    code: TpnrCode,
    idx: usize,
    depth: u32,
    max: u32,
    pos: usize,
    prev: u64,
    current: u64,
    node: u64,
    got: usize,
    max_count: usize,
    max64: u64,
}

// Whether the path node at pos repeats an earlier path node of the
// same resolution - the original's BTreeSet insert probe, answered
// by a scan over the prefix.
pub fn tpnr_path_seen_before(resolutions: []const NodeResolution, i: usize, pos: usize) -> bool {
    for j in 0..pos {
        if (resolutions[i].path[j] == resolutions[i].path[pos]) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM parent node resolution depth.
// Returns Ok only when every rule holds, checked in the original's
// code order: the batch ceiling, then per resolution the zero node,
// the node ceiling, the depth ceiling, then per path node the
// duplicate and the strictly-increasing probe.
pub fn validate_node_resolutions(resolutions: []const NodeResolution) -> TpnrVerdict {
    if (resolutions.len > TPNR_MAX_RESOLUTIONS) {
        return TpnrVerdict { code: TpnrCode.TooMany, idx: 0, depth: 0, max: 0, pos: 0, prev: 0, current: 0, node: 0, got: resolutions.len, max_count: TPNR_MAX_RESOLUTIONS, max64: 0, };
    }
    for i in 0..resolutions.len {
        if (resolutions[i].node_index == 0) {
            return TpnrVerdict { code: TpnrCode.ZeroNode, idx: i, depth: 0, max: 0, pos: 0, prev: 0, current: 0, node: 0, got: 0, max_count: 0, max64: 0, };
        }
        if (resolutions[i].node_index >= TPNR_MAX_NODES) {
            return TpnrVerdict { code: TpnrCode.NodeExceedsMax, idx: i, depth: 0, max: 0, pos: 0, prev: 0, current: 0, node: resolutions[i].node_index, got: 0, max_count: 0, max64: TPNR_MAX_NODES, };
        }
        if (resolutions[i].depth > TPNR_MAX_DEPTH) {
            return TpnrVerdict { code: TpnrCode.DepthExceeded, idx: i, depth: resolutions[i].depth, max: TPNR_MAX_DEPTH, pos: 0, prev: 0, current: 0, node: 0, got: 0, max_count: 0, max64: 0, };
        }
        for pos in 0..resolutions[i].path_len {
            if (tpnr_path_seen_before(resolutions, i, pos)) {
                return TpnrVerdict { code: TpnrCode.DuplicateInPath, idx: i, depth: 0, max: 0, pos: 0, prev: 0, current: 0, node: resolutions[i].path[pos], got: 0, max_count: 0, max64: 0, };
            }
            if (pos > 0) {
                if (resolutions[i].path[pos] <= resolutions[i].path[pos - 1]) {
                    return TpnrVerdict { code: TpnrCode.NotIncreasing, idx: i, depth: 0, max: 0, pos: pos, prev: resolutions[i].path[pos - 1], current: resolutions[i].path[pos], node: 0, got: 0, max_count: 0, max64: 0, };
                }
            }
        }
    }
    return TpnrVerdict { code: TpnrCode.Ok, idx: 0, depth: 0, max: 0, pos: 0, prev: 0, current: 0, node: 0, got: 0, max_count: 0, max64: 0, };
}

