// **TPNR-01** - depth exceeded rejected.
test tpnr_01_depth_exceeded_rejected {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: TPNR_MAX_DEPTH + 1, path: TPNR_PATH_ONE, path_len: 1, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.DepthExceeded);
    assert(v.idx == 0);
    assert(v.depth == TPNR_MAX_DEPTH + 1);
    assert(v.max == TPNR_MAX_DEPTH);
}

// **TPNR-02** - zero node rejected.
test tpnr_02_zero_node_rejected {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 0, depth: 1, path: TPNR_PATH_ONE, path_len: 1, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.ZeroNode);
    assert(v.idx == 0);
}

// **TPNR-03** - not increasing rejected.
test tpnr_03_not_increasing_rejected {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: 2, path: TPNR_PATH_10_5_15, path_len: 3, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.NotIncreasing);
    assert(v.idx == 0);
    assert(v.pos == 1);
    assert(v.prev == 10);
    assert(v.current == 5);
}

// **TPNR-04** - duplicate in path rejected.
test tpnr_04_duplicate_rejected {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: 2, path: TPNR_PATH_5_10_5, path_len: 3, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.DuplicateInPath);
    assert(v.idx == 0);
    assert(v.node == 5);
}

// **TPNR-05** - too many rejected.
test tpnr_05_too_many_rejected {
    const v = validate_node_resolutions(&TPNR_1025);
    assert(v.code == TpnrCode.TooMany);
    assert(v.got == TPNR_MAX_RESOLUTIONS + 1);
    assert(v.max_count == TPNR_MAX_RESOLUTIONS);
}

// **TPNR-06** - node exceeds max rejected.
test tpnr_06_node_exceeds_max_rejected {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: TPNR_MAX_NODES, depth: 1, path: TPNR_PATH_MAXNODE, path_len: 1, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.NodeExceedsMax);
    assert(v.idx == 0);
    assert(v.node == TPNR_MAX_NODES);
    assert(v.max64 == TPNR_MAX_NODES);
}

// **TPNR-07** - valid accepted.
test tpnr_07_valid_accepted {
    const rs: [2]NodeResolution = [2]NodeResolution{
        NodeResolution { node_index: 1, depth: 2, path: TPNR_PATH_1_3_7, path_len: 3, },
        NodeResolution { node_index: 2, depth: 1, path: TPNR_PATH_2_5, path_len: 2, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.Ok);
}

// **TPNR-08** - empty accepted.
test tpnr_08_empty_accepted {
    const rs: [0]NodeResolution = [0]NodeResolution{};
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.Ok);
}

// **TPNR-09** - single node accepted.
test tpnr_09_single_accepted {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: 0, path: TPNR_PATH_ONE, path_len: 1, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.Ok);
}

// **TPNR-10** - max depth boundary accepted.
test tpnr_10_max_depth_accepted {
    const rs: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: TPNR_MAX_DEPTH, path: TPNR_PATH_1_TO_32, path_len: 32, },
    };
    const v = validate_node_resolutions(&rs);
    assert(v.code == TpnrCode.Ok);
}

// The path scan has a direct test (coverage: Untested 0).
test tpnr_helpers_answer {
    const seen: [2]NodeResolution = [2]NodeResolution{
        NodeResolution { node_index: 1, depth: 2, path: TPNR_PATH_5_10_5, path_len: 3, },
        NodeResolution { node_index: 2, depth: 2, path: TPNR_PATH_1_3_7, path_len: 3, },
    };
    assert(tpnr_path_seen_before(&seen, 0, 2));
    assert(!tpnr_path_seen_before(&seen, 1, 2));
    assert(!tpnr_path_seen_before(&seen, 0, 0));
}

// Rule order is the original code's: the batch ceiling before any
// per-resolution rule, the zero node before the node ceiling and the
// depth, the node ceiling before the depth, and the duplicate before
// the strictly-increasing probe.
test rule_order_matches_original {
    const zero_and_deep: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 0, depth: TPNR_MAX_DEPTH + 1, path: TPNR_PATH_ONE, path_len: 1, },
    };
    const v1 = validate_node_resolutions(&zero_and_deep);
    assert(v1.code == TpnrCode.ZeroNode);

    const maxnode_and_deep: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: TPNR_MAX_NODES, depth: TPNR_MAX_DEPTH + 1, path: TPNR_PATH_MAXNODE, path_len: 1, },
    };
    const v2 = validate_node_resolutions(&maxnode_and_deep);
    assert(v2.code == TpnrCode.NodeExceedsMax);

    const dup_and_flat: [1]NodeResolution = [1]NodeResolution{
        NodeResolution { node_index: 1, depth: 2, path: TPNR_PATH_5_10_5, path_len: 3, },
    };
    const v3 = validate_node_resolutions(&dup_and_flat);
    assert(v3.code == TpnrCode.DuplicateInPath);

    const ceiling_first = validate_node_resolutions(&TPNR_1025);
    assert(ceiling_first.code == TpnrCode.TooMany);
}
