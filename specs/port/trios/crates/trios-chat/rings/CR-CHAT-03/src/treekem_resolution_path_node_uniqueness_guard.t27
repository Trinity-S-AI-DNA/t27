// **TRNU-03** - zero tree ID rejected.
test trnu_03_zero_tree_rejected {
    const ps: [1]ResolutionPathRecord = [1]ResolutionPathRecord{
        ResolutionPathRecord { tree_id: TRNU_ZERO32, node_ids: [65]TrnuNode{
        TrnuNode { node_id: TRNU_NID_01 },
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
