module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_resolution_path_node_uniqueness_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_resolution_path_node_uniqueness_guard.rs
// (CR-CHAT-03 - TreeKEM resolution path node uniqueness guard,
// Wave-148 Lane A).
//
// The original's Vec<[u8; 16]> node list becomes a fixed
// [65]TrnuNode record field with the live length in node_len - the
// too-long fixture walks 65 nodes against the ceiling of 64. Each
// list element keeps its [16]u8 inside a TrnuNode record, the shape
// gen-rust lowers for whole-id helpers reading nested fields. The
// two BTreeSet probes become seen-before scans riding the shared
// ids32_equal (tree ids) and ids16_equal (node ids); the node zero
// probe reuses the shared zero_id16; the tree-id zero probe is its
// own record-bound scan. The verdict is a named struct (owner
// decision D5): Ok first, the variants in the original's declaration
// order, every payload field kept. Rule order is the original
// code's, not the prose header's: the batch ceiling, then per path
// the zero tree id, the repeated tree id, the path length ceiling,
// then per node the zero id and the repeated id.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * NODE-UNIQUE

// Maximum path length.
pub const TRNU_MAX_PATH_LEN: usize = 64;

// Maximum paths per batch.
pub const TRNU_MAX_PATHS: usize = 256;

// Tree ID length.
pub const TRNU_TREE_ID_LEN: usize = 32;

// Node ID length.
pub const TRNU_NODE_ID_LEN: usize = 16;

// One node id of the resolution path.
pub struct TrnuNode {
    node_id: [16]u8,
}

// A resolution path record: the tree with its node list, the fixed
// [65]TrnuNode node array carrying the live length in node_len.
pub struct ResolutionPathRecord {
    tree_id: [32]u8,
    node_ids: [65]TrnuNode,
    node_len: usize,
}

// All ways path node uniqueness validation can fail, in the
// original's declaration order, with Ok first.
pub enum TrnuCode {
    Ok,
    DuplicateNode,
    TooLong,
    ZeroTreeId,
    DuplicateTreeId,
    ZeroNodeId,
    TooMany,
}

// The verdict of the path node uniqueness validation, carrying every
// payload field of every error variant.
pub struct TrnuVerdict {
    code: TrnuCode,
    path_idx: usize,
    node_pos: usize,
    idx: usize,
    got: usize,
    max: usize,
}

// Whether path i's tree id is all zero - the original's compare
// against the all-zero id, answered by a scan over the fixed bytes.
pub fn trnu_tree_id_all_zero(paths: []const ResolutionPathRecord, i: usize) -> bool {
    for k in 0..TRNU_TREE_ID_LEN {
        if (paths[i].tree_id[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether path i repeats an earlier tree id - the original's
// BTreeSet insert probe, answered by a scan over the prefix with the
// shared whole-id equality.
pub fn trnu_tree_seen_before(paths: []const ResolutionPathRecord, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(paths[j].tree_id, paths[i].tree_id)) {
            return true;
        }
    }
    return false;
}

// Whether the node at ni of path i repeats an earlier node of the
// same path - the original's second BTreeSet insert probe, answered
// by a scan over the prefix with the shared whole-id equality.
pub fn trnu_node_seen_before(paths: []const ResolutionPathRecord, i: usize, ni: usize) -> bool {
    for q in 0..ni {
        if (ids16_equal(paths[i].node_ids[q].node_id, paths[i].node_ids[ni].node_id)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM resolution path node uniqueness.
// Returns Ok only when every rule holds, checked in the original's
// code order: the batch ceiling, then per path the zero tree id,
// the repeated tree id, the path length ceiling, then per node the
// zero id and the repeated id.
pub fn validate_resolution_path_uniqueness(paths: []const ResolutionPathRecord) -> TrnuVerdict {
    if (paths.len > TRNU_MAX_PATHS) {
        return TrnuVerdict { code: TrnuCode.TooMany, path_idx: 0, node_pos: 0, idx: 0, got: paths.len, max: TRNU_MAX_PATHS, };
    }
    for i in 0..paths.len {
        if (trnu_tree_id_all_zero(paths, i)) {
            return TrnuVerdict { code: TrnuCode.ZeroTreeId, path_idx: 0, node_pos: 0, idx: i, got: 0, max: 0, };
        }
        if (trnu_tree_seen_before(paths, i)) {
            return TrnuVerdict { code: TrnuCode.DuplicateTreeId, path_idx: 0, node_pos: 0, idx: i, got: 0, max: 0, };
        }
        if (paths[i].node_len > TRNU_MAX_PATH_LEN) {
            return TrnuVerdict { code: TrnuCode.TooLong, path_idx: i, node_pos: 0, idx: 0, got: paths[i].node_len, max: TRNU_MAX_PATH_LEN, };
        }
        for ni in 0..paths[i].node_len {
            if (zero_id16(paths[i].node_ids[ni].node_id)) {
                return TrnuVerdict { code: TrnuCode.ZeroNodeId, path_idx: i, node_pos: ni, idx: 0, got: 0, max: 0, };
            }
            if (trnu_node_seen_before(paths, i, ni)) {
                return TrnuVerdict { code: TrnuCode.DuplicateNode, path_idx: i, node_pos: ni, idx: 0, got: 0, max: 0, };
            }
        }
    }
    return TrnuVerdict { code: TrnuCode.Ok, path_idx: 0, node_pos: 0, idx: 0, got: 0, max: 0, };
}

