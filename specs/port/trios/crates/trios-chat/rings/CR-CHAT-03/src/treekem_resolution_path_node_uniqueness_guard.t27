// **TRNU-01** - duplicate node rejected.
test trnu_01_duplicate_node_rejected {
    const ps: [1]ResolutionPathRecord = [1]ResolutionPathRecord{
        ResolutionPathRecord { tree_id: TRNU_TID_01, node_ids: [65]TrnuNode{
        TrnuNode { node_id: TRNU_NID_01 },
        TrnuNode { node_id: TRNU_NID_02 },
        TrnuNode { node_id: TRNU_NID_01 },
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD,
        TRNU_NODE_PAD
        }, node_len: 3, },
    };
    const v = validate_resolution_path_uniqueness(&ps);
    assert(v.code == TrnuCode.DuplicateNode);
    assert(v.path_idx == 0);
    assert(v.node_pos == 2);
}

