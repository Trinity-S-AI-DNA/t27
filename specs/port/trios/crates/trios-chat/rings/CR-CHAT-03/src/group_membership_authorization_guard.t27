module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::group_membership_authorization_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/group_membership_authorization_guard.rs
// (CR-CHAT-03 - Group membership authorization guard, Wave-48
// Lane B, R-CHAT-4).
//
// Group operations must come from a member with the
// standing to propose them: a shadow member injected
// through an unauthorized Add gains every future key, an
// unauthorized Remove ejects a legitimate member, a forced
// Update exhausts the ratchet state. The rules, in the
// original's fixed order: the group at the member floor
// (two), the proposer inside the leaf bound, the proposer
// an active member, and for Add and Remove the target
// inside the leaf bound - with a Remove aimed at the
// proposer rejected (the explicit Leave path exists for
// that). Update carries no target rule: the target rides
// along unread by the update branch.
//
// The original returns Result<(), GroupMembershipError>.
// This port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order - ProposerNotMember,
// ProposerOutOfBounds, TargetOutOfBounds,
// UnknownOperation, SelfRemovalNotAllowed, GroupTooSmall.
// Every original variant carries no payload, so the code
// is the whole verdict. UnknownOperation is declared and
// unreachable - the operation arrives as a kind enum and
// the original's own match exhausts it (the variant's doc
// says as much); it stays in the enum exactly as declared.
//
// The leaf indices widen from u32 to usize - t27's loop
// counters are usize and every fixture value fits both.
// The original's Vec contains over the active members
// becomes a scan.

// Minimum group size.
pub const GMAZ_MIN_MEMBERS: usize = 2;

// Maximum leaf index.
pub const GMAZ_MAX_LEAF_INDEX: usize = 1024;

// The group operation kind - the original's GroupOp in
// declaration order.
pub enum OpKind {
    Add,
    Remove,
    Update,
}

// Verdict codes: Ok(()) and GroupMembershipError's variants, in declaration order.
pub enum GmazCode {
    Ok,
    ProposerNotMember,
    ProposerOutOfBounds,
    TargetOutOfBounds,
    UnknownOperation,
    SelfRemovalNotAllowed,
    GroupTooSmall,
}

// The verdict of the proposal validation - the original's
// variants carry no payload, so the code alone carries it.
pub struct GmazVerdict {
    code: GmazCode,
}

// Whether the member array holds this leaf - the original's
// Vec contains over the active members.
pub fn member_contains(members: []const usize, leaf: usize) -> bool {
    for i in 0..members.len {
        if (members[i] == leaf) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate a group proposal against the current
// group state. Returns Ok only when every rule holds,
// checked in the original's fixed order: the member floor,
// the proposer bound, the proposer membership, then the
// Add/Remove target bound and the self-removal probe.
pub fn validate_group_proposal(op: OpKind, proposer: usize, target: usize, member_count: usize, members: []const usize) -> GmazVerdict {
    if (member_count < GMAZ_MIN_MEMBERS) {
        return GmazVerdict { code: GmazCode.GroupTooSmall, };
    }
    if (proposer > GMAZ_MAX_LEAF_INDEX) {
        return GmazVerdict { code: GmazCode.ProposerOutOfBounds, };
    }
    if (!member_contains(members, proposer)) {
        return GmazVerdict { code: GmazCode.ProposerNotMember, };
    }
    if (op == OpKind.Add) {
        if (target > GMAZ_MAX_LEAF_INDEX) {
            return GmazVerdict { code: GmazCode.TargetOutOfBounds, };
        }
    }
    if (op == OpKind.Remove) {
        if (target > GMAZ_MAX_LEAF_INDEX) {
            return GmazVerdict { code: GmazCode.TargetOutOfBounds, };
        }
        if (proposer == target) {
            return GmazVerdict { code: GmazCode.SelfRemovalNotAllowed, };
        }
    }
    return GmazVerdict { code: GmazCode.Ok, };
}

// The fixture state: three active members.
pub const MEMBERS: [3]usize = [3]usize{0, 1, 2,};

// **GMAZ-01** - the proposer not a member rejected: leaf
// five of the active three.
test gmaz_01_proposer_not_member_rejected {
    const v = validate_group_proposal(OpKind.Update, 5, 5, 3, &MEMBERS);
    assert(v.code == GmazCode.ProposerNotMember);
}

// **GMAZ-02** - the proposer out of bounds rejected: one
// over the leaf ceiling.
test gmaz_02_proposer_oob_rejected {
    const v = validate_group_proposal(OpKind.Update, 1025, 0, 3, &MEMBERS);
    assert(v.code == GmazCode.ProposerOutOfBounds);
}

// **GMAZ-03** - the target out of bounds rejected on an
// Add.
test gmaz_03_target_oob_rejected {
    const v = validate_group_proposal(OpKind.Add, 0, 1025, 3, &MEMBERS);
    assert(v.code == GmazCode.TargetOutOfBounds);
}

// **GMAZ-04** - the self-removal rejected: the proposer
// aiming a Remove at itself instead of the explicit Leave
// path.
test gmaz_04_self_removal_rejected {
    const v = validate_group_proposal(OpKind.Remove, 1, 1, 3, &MEMBERS);
    assert(v.code == GmazCode.SelfRemovalNotAllowed);
}

// **GMAZ-05** - the group too small rejected: one member
// of the floor of two.
test gmaz_05_group_too_small_rejected {
    const tiny: [1]usize = [1]usize{0,};
    const v = validate_group_proposal(OpKind.Update, 0, 0, 1, &tiny);
    assert(v.code == GmazCode.GroupTooSmall);
}

// **GMAZ-06** - the valid update accepted: the target
// unread by the update branch.
test gmaz_06_valid_update_accepted {
    const v = validate_group_proposal(OpKind.Update, 0, 0, 3, &MEMBERS);
    assert(v.code == GmazCode.Ok);
}

// **GMAZ-07** - the valid add accepted: member zero adding
// leaf three.
test gmaz_07_valid_add_accepted {
    const v = validate_group_proposal(OpKind.Add, 0, 3, 3, &MEMBERS);
    assert(v.code == GmazCode.Ok);
}

// **GMAZ-08** - the valid remove accepted: member zero
// removing member two.
test gmaz_08_valid_remove_accepted {
    const v = validate_group_proposal(OpKind.Remove, 0, 2, 3, &MEMBERS);
    assert(v.code == GmazCode.Ok);
}

// **GMAZ-09** - the boundary proposer accepted: the leaf
// ceiling itself an active member.
test gmaz_09_boundary_proposer_accepted {
    const boundary: [2]usize = [2]usize{0, 1024,};
    const v = validate_group_proposal(OpKind.Update, 1024, 0, 2, &boundary);
    assert(v.code == GmazCode.Ok);
}

// **GMAZ-10** - the boundary target accepted for an Add:
// the leaf ceiling itself.
test gmaz_10_boundary_target_accepted {
    const v = validate_group_proposal(OpKind.Add, 0, 1024, 3, &MEMBERS);
    assert(v.code == GmazCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test member_contains_answers {
    assert(member_contains(&MEMBERS, 0));
    assert(member_contains(&MEMBERS, 2));
    assert(!member_contains(&MEMBERS, 5));
    const empty: [0]usize = [0]usize{};
    assert(!member_contains(&empty, 0));
}

// Rule order is the original's fixed ladder: the member
// floor over every other violation, the proposer bound
// over the membership, the membership over the op rules,
// the target bound over the self-removal probe - and the
// update branch reading no target at all, a
// ceiling-over target on an update accepted.
test rule_order_matches_original {
    const tiny: [1]usize = [1]usize{0,};
    const v1 = validate_group_proposal(OpKind.Remove, 1025, 1025, 1, &tiny);
    assert(v1.code == GmazCode.GroupTooSmall);

    const v2 = validate_group_proposal(OpKind.Remove, 1025, 1025, 3, &MEMBERS);
    assert(v2.code == GmazCode.ProposerOutOfBounds);

    const v3 = validate_group_proposal(OpKind.Remove, 5, 1025, 3, &MEMBERS);
    assert(v3.code == GmazCode.ProposerNotMember);

    const v4 = validate_group_proposal(OpKind.Remove, 1, 1025, 3, &MEMBERS);
    assert(v4.code == GmazCode.TargetOutOfBounds);

    const v5 = validate_group_proposal(OpKind.Remove, 1, 1, 3, &MEMBERS);
    assert(v5.code == GmazCode.SelfRemovalNotAllowed);

    const v6 = validate_group_proposal(OpKind.Update, 0, 1025, 3, &MEMBERS);
    assert(v6.code == GmazCode.Ok);
}
