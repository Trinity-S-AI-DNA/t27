// **TULB-07** - valid accepted.
test tulb_07_valid_accepted {
    const rs: [2]UnmergedLeafRecord = [2]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 3, total_leaves: 16, unmerged_count: 5, },
        UnmergedLeafRecord { group_id: TULB_GID_02, epoch: 7, total_leaves: 32, unmerged_count: 10, },
    };
    const v = validate_unmerged_leaf_count(&rs);
    assert(v.code == TulbCode.Ok);
}

// **TULB-08** - empty accepted.
test tulb_08_empty_accepted {
    const rs: [0]UnmergedLeafRecord = [0]UnmergedLeafRecord{};
    const v = validate_unmerged_leaf_count(&rs);
    assert(v.code == TulbCode.Ok);
}

// **TULB-09** - zero unmerged accepted.
test tulb_09_zero_unmerged_accepted {
    const rs: [1]UnmergedLeafRecord = [1]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 16, unmerged_count: 0, },
    };
    const v = validate_unmerged_leaf_count(&rs);
    assert(v.code == TulbCode.Ok);
}

// **TULB-10** - boundary unmerged accepted.
test tulb_10_boundary_unmerged_accepted {
    const rs: [1]UnmergedLeafRecord = [1]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 100, unmerged_count: TULB_MAX_UNMERGED, },
    };
    const v = validate_unmerged_leaf_count(&rs);
    assert(v.code == TulbCode.Ok);
}

// The two probes have direct tests (coverage: Untested 0).
test tulb_helpers_answer {
    const rs: [2]UnmergedLeafRecord = [2]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_ZERO32, epoch: 1, total_leaves: 16, unmerged_count: 5, },
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 16, unmerged_count: 5, },
    };
    assert(tulb_gid_all_zero(&rs, 0));
    assert(!tulb_gid_all_zero(&rs, 1));
    assert(!tulb_gid_seen_before(&rs, 1));
    const twin: [2]UnmergedLeafRecord = [2]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 16, unmerged_count: 5, },
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 2, total_leaves: 32, unmerged_count: 10, },
    };
    assert(tulb_gid_seen_before(&twin, 1));
}

// Rule order is the original code's: the batch ceiling before any
// per-record rule, the zero group id before the repeated group id,
// the repeated group id before the zero epoch, the zero epoch before
// the leaf floor, and the leaf floor before the unmerged ceiling.
test rule_order_matches_original {
    const zero_after_clean: [2]UnmergedLeafRecord = [2]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 16, unmerged_count: 5, },
        UnmergedLeafRecord { group_id: TULB_ZERO32, epoch: 1, total_leaves: 16, unmerged_count: 5, },
    };
    const v1 = validate_unmerged_leaf_count(&zero_after_clean);
    assert(v1.code == TulbCode.ZeroGroupId);
    assert(v1.idx == 1);

    const dup_hides_zero_epoch: [2]UnmergedLeafRecord = [2]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 16, unmerged_count: 5, },
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 0, total_leaves: 16, unmerged_count: 5, },
    };
    const v2 = validate_unmerged_leaf_count(&dup_hides_zero_epoch);
    assert(v2.code == TulbCode.DuplicateGroupId);

    const zero_epoch_hides_floor: [1]UnmergedLeafRecord = [1]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 0, total_leaves: 1, unmerged_count: 65, },
    };
    const v3 = validate_unmerged_leaf_count(&zero_epoch_hides_floor);
    assert(v3.code == TulbCode.ZeroEpoch);

    const floor_hides_ceiling: [1]UnmergedLeafRecord = [1]UnmergedLeafRecord{
        UnmergedLeafRecord { group_id: TULB_GID_01, epoch: 1, total_leaves: 1, unmerged_count: TULB_MAX_UNMERGED + 1, },
    };
    const v4 = validate_unmerged_leaf_count(&floor_hides_ceiling);
    assert(v4.code == TulbCode.TooFewLeaves);
}
