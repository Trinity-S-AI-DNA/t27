module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_update_path_validation;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_update_path_validation.rs
// (CR-CHAT-03 - TreeKEM update path validation guard, Wave-56 Lane A,
// R-CHAT-2).
//
// The original's BTreeSet insert probe becomes a seen-before scan
// over the u32 positions. Every variant carries no payload, so the
// verdict is the code alone (owner decision D5, the TPSF shape).
// Rule order is the original code's, not the prose header's: the
// empty path, the leaf ceiling, the length ceiling, then per node
// the repeated position, then the leaf-start rule - which the
// original answers as PathTooShort - and only then the orphan walk,
// where every node except the last must carry a parent.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * UPDATE-PATH

// Maximum leaf position.
pub const TKUP_MAX_LEAF: u32 = 1024;

// Maximum path length (log2 of max leaves + 1).
pub const TKUP_MAX_PATH_LEN: usize = 12;

// An update path node.
pub struct PathNode {
    position: u32,
    has_parent: bool,
}

// All ways update path validation can fail, in the original's
// declaration order, with Ok first.
pub enum TkupCode {
    Ok,
    PathTooShort,
    PathTooLong,
    DuplicateNode,
    LeafOutOfBounds,
    OrphanNode,
    EmptyPath,
}

// The verdict of the update path validation. Every error variant of
// the original carries no payload, so the code is the whole
// verdict.
pub struct TkupVerdict {
    code: TkupCode,
}

// Whether node i repeats an earlier position - the original's
// BTreeSet insert probe, answered by a scan over the prefix.
pub fn tkup_pos_seen_before(nodes: []const PathNode, i: usize) -> bool {
    for j in 0..i {
        if (nodes[j].position == nodes[i].position) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate a TreeKEM update path from leaf to root.
// Returns Ok only when every rule holds, checked in the original's
// code order: the empty path, the leaf ceiling, the length ceiling,
// the repeated positions, the leaf start and the orphan walk.
pub fn validate_update_path(leaf_pos: u32, nodes: []const PathNode) -> TkupVerdict {
    if (nodes.len == 0) {
        return TkupVerdict { code: TkupCode.EmptyPath, };
    }
    if (leaf_pos > TKUP_MAX_LEAF) {
        return TkupVerdict { code: TkupCode.LeafOutOfBounds, };
    }
    if (nodes.len > TKUP_MAX_PATH_LEN) {
        return TkupVerdict { code: TkupCode.PathTooLong, };
    }
    for i in 0..nodes.len {
        if (tkup_pos_seen_before(nodes, i)) {
            return TkupVerdict { code: TkupCode.DuplicateNode, };
        }
    }
    if (nodes[0].position != leaf_pos) {
        return TkupVerdict { code: TkupCode.PathTooShort, };
    }
    for i in 0..nodes.len {
        if (i < nodes.len - 1) {
            if (!nodes[i].has_parent) {
                return TkupVerdict { code: TkupCode.OrphanNode, };
            }
        }
    }
    return TkupVerdict { code: TkupCode.Ok, };
}

// **TKUP-01** - empty path rejected.
test tkup_01_empty_rejected {
    const nodes: [0]PathNode = [0]PathNode{};
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.EmptyPath);
}

// **TKUP-02** - leaf out of bounds rejected.
test tkup_02_leaf_oob_rejected {
    const nodes: [3]PathNode = [3]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 3, has_parent: false },
    };
    const v = validate_update_path(TKUP_MAX_LEAF + 1, &nodes);
    assert(v.code == TkupCode.LeafOutOfBounds);
}

// **TKUP-03** - path too long rejected.
test tkup_03_too_long_rejected {
    const nodes: [13]PathNode = [13]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 2, has_parent: true },
        PathNode { position: 3, has_parent: true },
        PathNode { position: 4, has_parent: true },
        PathNode { position: 5, has_parent: true },
        PathNode { position: 6, has_parent: true },
        PathNode { position: 7, has_parent: true },
        PathNode { position: 8, has_parent: true },
        PathNode { position: 9, has_parent: true },
        PathNode { position: 10, has_parent: true },
        PathNode { position: 11, has_parent: true },
        PathNode { position: 12, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.PathTooLong);
}

// **TKUP-04** - duplicate node rejected.
test tkup_04_duplicate_rejected {
    const nodes: [2]PathNode = [2]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.DuplicateNode);
}

// **TKUP-05** - orphan node rejected.
test tkup_05_orphan_rejected {
    const nodes: [2]PathNode = [2]PathNode{
        PathNode { position: 0, has_parent: false },
        PathNode { position: 1, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.OrphanNode);
}

// **TKUP-06** - path too short (wrong start) rejected.
test tkup_06_wrong_start_rejected {
    const nodes: [2]PathNode = [2]PathNode{
        PathNode { position: 5, has_parent: true },
        PathNode { position: 7, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.PathTooShort);
}

// **TKUP-07** - good path accepted.
test tkup_07_good_accepted {
    const nodes: [3]PathNode = [3]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 3, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.Ok);
}

// **TKUP-08** - single node (root-only) accepted.
test tkup_08_single_node_accepted {
    const nodes: [1]PathNode = [1]PathNode{
        PathNode { position: 0, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.Ok);
}

// **TKUP-09** - max leaf accepted.
test tkup_09_max_leaf_accepted {
    const nodes: [1]PathNode = [1]PathNode{
        PathNode { position: TKUP_MAX_LEAF, has_parent: false },
    };
    const v = validate_update_path(TKUP_MAX_LEAF, &nodes);
    assert(v.code == TkupCode.Ok);
}

// **TKUP-10** - deep path accepted.
test tkup_10_deep_accepted {
    const nodes: [12]PathNode = [12]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 2, has_parent: true },
        PathNode { position: 3, has_parent: true },
        PathNode { position: 4, has_parent: true },
        PathNode { position: 5, has_parent: true },
        PathNode { position: 6, has_parent: true },
        PathNode { position: 7, has_parent: true },
        PathNode { position: 8, has_parent: true },
        PathNode { position: 9, has_parent: true },
        PathNode { position: 10, has_parent: true },
        PathNode { position: 11, has_parent: false },
    };
    const v = validate_update_path(0, &nodes);
    assert(v.code == TkupCode.Ok);
}

// The probe has a direct test (coverage: Untested 0).
test tkup_helpers_answer {
    const nodes: [3]PathNode = [3]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 0, has_parent: false },
    };
    assert(!tkup_pos_seen_before(&nodes, 1));
    assert(tkup_pos_seen_before(&nodes, 2));
    assert(!tkup_pos_seen_before(&nodes, 0));
}

// Rule order is the original code's: the empty path before the leaf
// ceiling, the leaf ceiling before the length ceiling, the length
// ceiling before the repeated positions, the repeated positions
// before the leaf start, and the leaf start before the orphan walk.
test rule_order_matches_original {
    const none: [0]PathNode = [0]PathNode{};
    const v1 = validate_update_path(2000, &none);
    assert(v1.code == TkupCode.EmptyPath);

    const deep: [13]PathNode = [13]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 1, has_parent: true },
        PathNode { position: 2, has_parent: true },
        PathNode { position: 3, has_parent: true },
        PathNode { position: 4, has_parent: true },
        PathNode { position: 5, has_parent: true },
        PathNode { position: 6, has_parent: true },
        PathNode { position: 7, has_parent: true },
        PathNode { position: 8, has_parent: true },
        PathNode { position: 9, has_parent: true },
        PathNode { position: 10, has_parent: true },
        PathNode { position: 11, has_parent: true },
        PathNode { position: 12, has_parent: false },
    };
    const v2 = validate_update_path(2000, &deep);
    assert(v2.code == TkupCode.LeafOutOfBounds);

    const dup_under_ceiling: [13]PathNode = [13]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: true },
    };
    const v3 = validate_update_path(0, &dup_under_ceiling);
    assert(v3.code == TkupCode.PathTooLong);

    const dup_before_start: [2]PathNode = [2]PathNode{
        PathNode { position: 0, has_parent: true },
        PathNode { position: 0, has_parent: false },
    };
    const v4 = validate_update_path(5, &dup_before_start);
    assert(v4.code == TkupCode.DuplicateNode);

    const start_before_orphan: [2]PathNode = [2]PathNode{
        PathNode { position: 5, has_parent: false },
        PathNode { position: 7, has_parent: false },
    };
    const v5 = validate_update_path(2, &start_before_orphan);
    assert(v5.code == TkupCode.PathTooShort);
}
