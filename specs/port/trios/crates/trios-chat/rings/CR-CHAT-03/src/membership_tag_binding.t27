module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::membership_tag_binding;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/membership_tag_binding.rs
// (CR-CHAT-03 - Membership tag binding verification, Wave-40
// Lane B, RFC 9420 8.2).
//
// Every MLSPlaintext carries a membership tag binding the
// message to the group context at send time. A forged or
// replayed tag impersonates a removed member, replays a
// message across epochs with different capabilities, or
// splices one group's tag into another where the leaf
// index names a different user. The rules, in the
// original's fixed order: the tag non-empty, the canonical
// tag length (thirty-two - the HMAC-SHA-256 output), the
// group agreement, the epoch agreement, the sender leaf
// inside the tree, the sender not removed, and the tag
// fresh against the consumed ledger.
//
// The original returns Result<(), MembershipTagError>. This
// port carries the verdict as a named struct (owner
// decision D5): Ok first, then the seven variants in the
// original's declaration order - EmptyTag,
// NonCanonicalTagLength, GroupIdMismatch, EpochMismatch,
// SenderOutOfBounds, SenderRemoved, TagReplay. Every
// original variant carries no payload, so the code is the
// whole verdict.
//
// The original's tag and view structs become flat
// parameters; the serialized message the original's struct
// carries rides along unread by every rule and does not
// reach the parameters. The sender leaf widens from u32 to
// usize - t27's loop counters are usize and every fixture
// value fits both. The removed-leaf set becomes a plain
// slice scanned, the consumed-tag ledger a slice of records
// holding the canonical thirty-two-byte tag - both
// original BTreeSet contains answered by scans.

// Canonical membership tag length (HMAC-SHA-256 output).
pub const MTAG_TAG_LEN: usize = 32;

// A consumed tag value - canonical length, the replay
// ledger entry.
pub struct ConsumedTag {
    bytes: [32]u8,
}

// Verdict codes: Ok(()) and MembershipTagError's variants, in declaration order.
pub enum MtagCode {
    Ok,
    EmptyTag,
    NonCanonicalTagLength,
    GroupIdMismatch,
    EpochMismatch,
    SenderOutOfBounds,
    SenderRemoved,
    TagReplay,
}

// The verdict of the membership tag validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct MtagVerdict {
    code: MtagCode,
}

// Content equality over two byte slices - the original's
// Vec equality on the group identifiers.
pub fn bytes_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for i in 0..a.len {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

// Whether the leaf index sits in the removed set - the
// original's BTreeSet contains, answered by a scan.
pub fn leaf_removed(removed: []const usize, leaf: usize) -> bool {
    for i in 0..removed.len {
        if (removed[i] == leaf) {
            return true;
        }
    }
    return false;
}

// Whether the tag was already consumed - the original's
// BTreeSet contains over the tag ledger, the canonical
// form compared behind a length gate.
pub fn tag_consumed(consumed: []const ConsumedTag, tag: []const u8) -> bool {
    if (tag.len != 32) {
        return false;
    }
    for i in 0..consumed.len {
        var same: bool = true;
        for j in 0..32 {
            if (consumed[i].bytes[j] != tag[j]) {
                same = false;
            }
        }
        if (same) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate a membership tag against the
// receiver's group view. Returns Ok only when every rule
// holds, checked in the original's fixed order: the
// non-empty canonical tag, the group, the epoch, the leaf
// bounds, the active sender and the fresh tag.
pub fn validate_membership_tag(tag: []const u8, group_id: []const u8, epoch: u64, sender_leaf: usize, local_group_id: []const u8, current_epoch: u64, leaf_count: usize, removed_leaves: []const usize, consumed_tags: []const ConsumedTag) -> MtagVerdict {
    if (tag.len == 0) {
        return MtagVerdict { code: MtagCode.EmptyTag, };
    }
    if (tag.len != MTAG_TAG_LEN) {
        return MtagVerdict { code: MtagCode.NonCanonicalTagLength, };
    }
    if (!bytes_equal(group_id, local_group_id)) {
        return MtagVerdict { code: MtagCode.GroupIdMismatch, };
    }
    if (epoch != current_epoch) {
        return MtagVerdict { code: MtagCode.EpochMismatch, };
    }
    if (sender_leaf >= leaf_count) {
        return MtagVerdict { code: MtagCode.SenderOutOfBounds, };
    }
    if (leaf_removed(removed_leaves, sender_leaf)) {
        return MtagVerdict { code: MtagCode.SenderRemoved, };
    }
    if (tag_consumed(consumed_tags, tag)) {
        return MtagVerdict { code: MtagCode.TagReplay, };
    }
    return MtagVerdict { code: MtagCode.Ok, };
}

// The fixture bytes: the tag of eleven-hex and its fresh
// sibling of thirty-three-hex, the local group of
// double-A-hex and the stranger's group of double-B-hex.
pub const TAG_11: [32]u8 = [32]u8{17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17,}
pub const TAG_33: [32]u8 = [32]u8{51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51, 51,}
pub const GID_AA: [32]u8 = [32]u8{170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170,}
pub const GID_BB: [32]u8 = [32]u8{187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187, 187,}

// **MTAG-01** - the empty tag rejected.
test mtag_01_empty_tag_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const empty_tag: [0]u8 = [0]u8{};
    const v = validate_membership_tag(&empty_tag, &GID_AA, 7, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.EmptyTag);
}

// **MTAG-02** - the sixteen-byte tag rejected.
test mtag_02_wrong_tag_length_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    var short_tag: [16]u8;
    for j in 0..16 {
        short_tag[j] = 17;
    }
    const v = validate_membership_tag(&short_tag, &GID_AA, 7, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.NonCanonicalTagLength);
}

// **MTAG-03** - the group identifier mismatch rejected.
test mtag_03_group_id_mismatch_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_BB, 7, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.GroupIdMismatch);
}

// **MTAG-04** - the epoch mismatch rejected: ninety-nine of
// a current seven.
test mtag_04_epoch_mismatch_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_AA, 99, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.EpochMismatch);
}

// **MTAG-05** - the sender out of bounds rejected: fifteen
// of a tree of ten leaves.
test mtag_05_sender_out_of_bounds_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_AA, 7, 15, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.SenderOutOfBounds);
}

// **MTAG-06** - the removed sender rejected: leaf three on
// the removed list.
test mtag_06_removed_sender_rejected {
    const removed: [1]usize = [1]usize{3,};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_AA, 7, 3, &GID_AA, 7, 10, &removed, &none_used);
    assert(v.code == MtagCode.SenderRemoved);
}

// **MTAG-07** - the replayed tag rejected: this very tag
// already consumed.
test mtag_07_tag_replay_rejected {
    const none_removed: [0]usize = [0]usize{};
    const used: [1]ConsumedTag = [1]ConsumedTag{
        ConsumedTag { bytes: TAG_11, },
    };
    const v = validate_membership_tag(&TAG_11, &GID_AA, 7, 3, &GID_AA, 7, 10, &none_removed, &used);
    assert(v.code == MtagCode.TagReplay);
}

// **MTAG-08** - the valid tag accepted.
test mtag_08_valid_tag_accepted {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_AA, 7, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.Ok);
}

// **MTAG-09** - the cross-epoch replay rejected: the same
// sender at an older epoch.
test mtag_09_cross_epoch_rejected {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_11, &GID_AA, 5, 3, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.EpochMismatch);
}

// **MTAG-10** - the leaf boundary accepted: leaf nine of a
// tree of ten, with a fresh tag value.
test mtag_10_leaf_boundary_accepted {
    const none_removed: [0]usize = [0]usize{};
    const none_used: [0]ConsumedTag = [0]ConsumedTag{};
    const v = validate_membership_tag(&TAG_33, &GID_AA, 7, 9, &GID_AA, 7, 10, &none_removed, &none_used);
    assert(v.code == MtagCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test bytes_equal_answers {
    assert(bytes_equal(&GID_AA, &GID_AA));
    assert(!bytes_equal(&GID_AA, &GID_BB));
    assert(!bytes_equal(&TAG_11, &TAG_33));
}

test leaf_removed_answers {
    const removed: [2]usize = [2]usize{3, 8,};
    assert(leaf_removed(&removed, 3));
    assert(!leaf_removed(&removed, 4));
    const empty: [0]usize = [0]usize{};
    assert(!leaf_removed(&empty, 0));
}

test tag_consumed_answers {
    const used: [2]ConsumedTag = [2]ConsumedTag{
        ConsumedTag { bytes: TAG_11, },
        ConsumedTag { bytes: TAG_33, },
    };
    assert(tag_consumed(&used, &TAG_11));
    assert(!tag_consumed(&used, &GID_AA));
    var short_tag: [16]u8;
    for j in 0..16 {
        short_tag[j] = 17;
    }
    assert(!tag_consumed(&used, &short_tag));
}

// Rule order is the original's fixed ladder, each probe
// stacking the earlier rule's violation on the later ones
// - the consumed ledger and the removed list riding under
// every earlier rule.
test rule_order_matches_original {
    const removed: [1]usize = [1]usize{3,};
    const used: [1]ConsumedTag = [1]ConsumedTag{
        ConsumedTag { bytes: TAG_11, },
    };
    const empty_tag: [0]u8 = [0]u8{};
    var short_tag: [16]u8;
    for j in 0..16 {
        short_tag[j] = 17;
    }

    const v1 = validate_membership_tag(&empty_tag, &GID_BB, 99, 15, &GID_AA, 7, 10, &removed, &used);
    assert(v1.code == MtagCode.EmptyTag);

    const v2 = validate_membership_tag(&short_tag, &GID_BB, 99, 15, &GID_AA, 7, 10, &removed, &used);
    assert(v2.code == MtagCode.NonCanonicalTagLength);

    const v3 = validate_membership_tag(&TAG_11, &GID_BB, 99, 15, &GID_AA, 7, 10, &removed, &used);
    assert(v3.code == MtagCode.GroupIdMismatch);

    const v4 = validate_membership_tag(&TAG_11, &GID_AA, 99, 15, &GID_AA, 7, 10, &removed, &used);
    assert(v4.code == MtagCode.EpochMismatch);

    const v5 = validate_membership_tag(&TAG_11, &GID_AA, 7, 15, &GID_AA, 7, 10, &removed, &used);
    assert(v5.code == MtagCode.SenderOutOfBounds);

    const v6 = validate_membership_tag(&TAG_11, &GID_AA, 7, 3, &GID_AA, 7, 10, &removed, &used);
    assert(v6.code == MtagCode.SenderRemoved);

    const v7 = validate_membership_tag(&TAG_11, &GID_AA, 7, 4, &GID_AA, 7, 10, &removed, &used);
    assert(v7.code == MtagCode.TagReplay);
}
