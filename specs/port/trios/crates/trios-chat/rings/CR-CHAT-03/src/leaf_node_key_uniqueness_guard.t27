// **LNKU-01** - the duplicate key rejected: leaf one
// repeating leaf zero's key, the verdict naming both.
test lnku_01_duplicate_key_rejected {
    const leaves: [2]LeafNode = [2]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_AA, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.DuplicateKey);
    assert(v.index_a == 0);
    assert(v.index_b == 1);
}

// **LNKU-02** - the duplicate index rejected: leaf zero
// twice under different keys.
test lnku_02_duplicate_index_rejected {
    const leaves: [2]LeafNode = [2]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 0, public_key: KEY_BB, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.DuplicateIndex);
    assert(v.index == 0);
}

// **LNKU-03** - the zero key rejected.
test lnku_03_zero_key_rejected {
    const leaves: [1]LeafNode = [1]LeafNode{
        LeafNode { index: 0, public_key: ZERO_KEY, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.ZeroKey);
    assert(v.index == 0);
}

// **LNKU-04** - too many leaves rejected: one thousand
// twenty-five of a ceiling of one thousand twenty-four,
// built in a loop like the original's with the tabular key
// form; the ceiling fires before any leaf is examined.
test lnku_04_too_many_rejected {
    var leaves: [1025]LeafNode;
    for i in 0..1025 {
        var k: [32]u8;
        for j in 0..32 {
            k[j] = 0;
        }
        k[0] = LNKU_LOW[i];
        k[1] = LNKU_MID[i];
        k[4] = 1;
        leaves[i] = LeafNode { index: i, public_key: k, };
    }
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.TooManyLeaves);
}

// **LNKU-05** - the index out of range rejected: the leaf
// ceiling as an index.
test lnku_05_index_out_of_range_rejected {
    const leaves: [1]LeafNode = [1]LeafNode{
        LeafNode { index: 1024, public_key: KEY_AA, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.IndexOutOfRange);
    assert(v.index == 1024);
}

// **LNKU-06** - the valid leaves accepted: three distinct
// keys at three indices.
test lnku_06_valid_accepted {
    const leaves: [3]LeafNode = [3]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_BB, },
        LeafNode { index: 2, public_key: KEY_CC, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.Ok);
}

// **LNKU-07** - the empty tree accepted.
test lnku_07_empty_accepted {
    const leaves: [0]LeafNode = [0]LeafNode{};
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.Ok);
}

// **LNKU-08** - a single leaf accepted.
test lnku_08_single_accepted {
    const leaves: [1]LeafNode = [1]LeafNode{
        LeafNode { index: 0, public_key: KEY_FF, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.Ok);
}

// **LNKU-09** - the maximum boundary accepted: exactly one
// thousand twenty-four distinct leaves.
test lnku_09_max_boundary_accepted {
    var leaves: [1024]LeafNode;
    for i in 0..1024 {
        var k: [32]u8;
        for j in 0..32 {
            k[j] = 0;
        }
        k[0] = LNKU_LOW[i];
        k[1] = LNKU_MID[i];
        k[4] = 1;
        leaves[i] = LeafNode { index: i, public_key: k, };
    }
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.Ok);
}

// **LNKU-10** - the different keys at different indices
// accepted.
test lnku_10_unique_keys_accepted {
    const leaves: [4]LeafNode = [4]LeafNode{
        LeafNode { index: 0, public_key: KEY_01, },
        LeafNode { index: 1, public_key: KEY_02, },
        LeafNode { index: 2, public_key: KEY_03, },
        LeafNode { index: 3, public_key: KEY_04, },
    };
    const v = validate_leaf_key_uniqueness(&leaves);
    assert(v.code == LnkuCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test keys32_equal_answers {
    assert(ids32_equal(KEY_AA, KEY_AA));
    assert(!ids32_equal(KEY_AA, KEY_BB));
}

test is_zero_key_answers {
    assert(is_zero_key(ZERO_KEY));
    assert(!is_zero_key(KEY_AA));
}

test index_seen_before_answers {
    const leaves: [3]LeafNode = [3]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_BB, },
        LeafNode { index: 0, public_key: KEY_CC, },
    };
    assert(!index_seen_before(&leaves, 0, 0));
    assert(!index_seen_before(&leaves, 1, 1));
    assert(index_seen_before(&leaves, 2, 0));
    assert(!index_seen_before(&leaves, 2, 2));
}

test first_pos_with_key_answers {
    const leaves: [3]LeafNode = [3]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_BB, },
        LeafNode { index: 2, public_key: KEY_AA, },
    };
    assert(first_pos_with_key(&leaves, 2, KEY_AA) == 0);
    assert(first_pos_with_key(&leaves, 2, KEY_BB) == 1);
}

// Rule order is the original's fixed ladder: the leaf
// ceiling over a flooded batch, then per leaf the index
// range over the zero key, the zero key over the duplicate
// index, the duplicate index over the duplicate key - and
// the duplicate-key rule naming the first occurrence.
test rule_order_matches_original {
    var flooded: [1025]LeafNode;
    for i in 0..1025 {
        var k: [32]u8;
        for j in 0..32 {
            k[j] = 0;
        }
        k[0] = LNKU_LOW[i];
        k[1] = LNKU_MID[i];
        k[4] = 1;
        flooded[i] = LeafNode { index: 1024, public_key: k, };
    }
    const v1 = validate_leaf_key_uniqueness(&flooded);
    assert(v1.code == LnkuCode.TooManyLeaves);

    const ranged_zero: [1]LeafNode = [1]LeafNode{
        LeafNode { index: 1024, public_key: ZERO_KEY, },
    };
    const v2 = validate_leaf_key_uniqueness(&ranged_zero);
    assert(v2.code == LnkuCode.IndexOutOfRange);

    const zero_twice: [2]LeafNode = [2]LeafNode{
        LeafNode { index: 0, public_key: ZERO_KEY, },
        LeafNode { index: 0, public_key: ZERO_KEY, },
    };
    const v3 = validate_leaf_key_uniqueness(&zero_twice);
    assert(v3.code == LnkuCode.ZeroKey);

    const same_all: [2]LeafNode = [2]LeafNode{
        LeafNode { index: 1, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_AA, },
    };
    const v4 = validate_leaf_key_uniqueness(&same_all);
    assert(v4.code == LnkuCode.DuplicateIndex);

    const key_repeat: [2]LeafNode = [2]LeafNode{
        LeafNode { index: 0, public_key: KEY_AA, },
        LeafNode { index: 1, public_key: KEY_AA, },
    };
    const v5 = validate_leaf_key_uniqueness(&key_repeat);
    assert(v5.code == LnkuCode.DuplicateKey);
    assert(v5.index_a == 0);
    assert(v5.index_b == 1);
}
