module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::leaf_node_key_uniqueness_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/leaf_node_key_uniqueness_guard.rs
// (CR-CHAT-03 - Leaf node key uniqueness guard, Wave-87
// Lane B, R-CHAT-3).
//
// Every TreeKEM leaf carries a distinct public key: two
// leaves sharing one let an observer read a relationship,
// make signatures ambiguous for impersonation, and derive
// identical path secrets from the shared parent - breaking
// the pairwise secrecy guarantee. The rules, in the
// original's fixed order: the leaf ceiling (one thousand
// twenty-four), then per leaf the index inside the tree,
// the key not the all-zero form, the index fresh, and the
// key fresh - the duplicate-key rejection naming both the
// first leaf that carried the key and the leaf that
// repeated it.
//
// The original returns Result<(), LeafKeyError>. This
// port carries the verdict as a named struct (owner
// decision D5): Ok first, then the five variants in the
// original's declaration order - DuplicateKey,
// DuplicateIndex, ZeroKey, TooManyLeaves, IndexOutOfRange
// - with every payload field: the two indices of the
// duplicate-key rule and the single index of the other
// per-leaf rules.
//
// The leaf index widens from u32 to usize - t27's loop
// counters are usize and every fixture value fits both.
// The original's BTreeSet probes become scans over the
// leaves already visited (conventions section 4); the
// original's HashMap of first key occurrence becomes a
// backward scan for the first leaf carrying the repeated
// key - the answer is the same, the first occurrence. The
// loop fixtures of the original - the little-endian bytes
// of the index with a marker byte at the fifth slot -
// arrive as precomputed tables the loop reads, the
// identity low byte and the step-four high byte (the
// computed and tabular forms match exactly; the narrowing
// cast the original performs on its counter does not exist
// in t27).

// Maximum leaves in the tree.
pub const LNKU_MAX_LEAVES: usize = 1024;

// Public key length.
pub const LNKU_KEY_LEN: usize = 32;

// A leaf node entry.
pub struct LeafNode {
    index: usize,
    public_key: [32]u8,
}

// Verdict codes: Ok(()) and LeafKeyError's variants, in declaration order.
pub enum LnkuCode {
    Ok,
    DuplicateKey,
    DuplicateIndex,
    ZeroKey,
    TooManyLeaves,
    IndexOutOfRange,
}

// The verdict of the leaf key validation, with every
// payload field: the pair of the duplicate-key rule and
// the single index of the other per-leaf rules.
pub struct LnkuVerdict {
    code: LnkuCode,
    index_a: usize,
    index_b: usize,
    index: usize,
}

// Whether the key is the all-zero form - the original's
// sentinel probe.
pub fn is_zero_key(key: [32]u8) -> bool {
    for i in 0..32 {
        if (key[i] != 0) {
            return false;
        }
    }
    return true;
}

// Whether a leaf before position upto already claimed this
// index - the original's BTreeSet insert probe over the
// indices.
pub fn index_seen_before(leaves: []const LeafNode, upto: usize, index: usize) -> bool {
    for j in 0..upto {
        if (leaves[j].index == index) {
            return true;
        }
    }
    return false;
}

// The first leaf position before upto carrying this key -
// the original's HashMap lookup of the first occurrence,
// answered by a forward scan (the key is proven present by
// the duplicate probe).
pub fn first_pos_with_key(leaves: []const LeafNode, upto: usize, key: [32]u8) -> usize {
    for j in 0..upto {
        if (ids32_equal(leaves[j].public_key, key)) {
            return j;
        }
    }
    return upto;
}

// [VERIFIED] Validate leaf node key uniqueness. Returns Ok
// only when every rule holds, checked in the original's
// fixed order: the leaf ceiling, then per leaf the index
// range, the zero-key probe, the fresh index and the fresh
// key with its first occurrence named.
pub fn validate_leaf_key_uniqueness(leaves: []const LeafNode) -> LnkuVerdict {
    if (leaves.len > LNKU_MAX_LEAVES) {
        return LnkuVerdict { code: LnkuCode.TooManyLeaves, index_a: 0, index_b: 0, index: 0, };
    }
    for i in 0..leaves.len {
        if (leaves[i].index >= LNKU_MAX_LEAVES) {
            return LnkuVerdict { code: LnkuCode.IndexOutOfRange, index_a: 0, index_b: 0, index: leaves[i].index, };
        }
        if (is_zero_key(leaves[i].public_key)) {
            return LnkuVerdict { code: LnkuCode.ZeroKey, index_a: 0, index_b: 0, index: leaves[i].index, };
        }
        if (index_seen_before(leaves, i, leaves[i].index)) {
            return LnkuVerdict { code: LnkuCode.DuplicateIndex, index_a: 0, index_b: 0, index: leaves[i].index, };
        }
        var key_repeated: bool = false;
        for j in 0..i {
            if (ids32_equal(leaves[j].public_key, leaves[i].public_key)) {
                key_repeated = true;
            }
        }
        if (key_repeated) {
            const first: usize = first_pos_with_key(leaves, i, leaves[i].public_key);
            return LnkuVerdict { code: LnkuCode.DuplicateKey, index_a: leaves[first].index, index_b: leaves[i].index, index: 0, };
        }
    }
    return LnkuVerdict { code: LnkuCode.Ok, index_a: 0, index_b: 0, index: 0, };
}

// The fixture keys: one byte repeated thirty-two times.
pub const KEY_AA: [32]u8 = [32]u8{170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170,}
