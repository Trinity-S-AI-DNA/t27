module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::leaf_node_priority_inversion_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/leaf_node_priority_inversion_guard.rs
// (CR-CHAT-03 - Leaf node priority inversion guard, Wave-52
// Lane B, R-CHAT-4).
//
// Group operations respect a priority ordering - the
// lower leaf index is the higher priority. A stale update
// from a low-priority member must never override a fresh
// one from a higher-priority member: that inversion blocks
// key updates, freezes membership and holds the group on
// an old ratchet tree. The gate reads a batch in arrival
// order and answers the first decision violation: the
// batch ceiling (sixty-four), then per proposal the
// proposer leaf inside the tree, the target leaf inside
// the tree, the operation tag non-zero, and the
// (target, tag) decision already made - the same leaf
// proposing twice on one target is a same-priority
// conflict, and a later proposal from a strictly lower
// leaf than the one that decided is an inversion.
//
// The original returns Result<(), LeafPriorityError>. This
// port carries the verdict as a named struct (owner
// decision D5): Ok first, then the six variants in the
// original's declaration order - LeafOutOfBounds,
// TargetOutOfBounds, SamePriorityConflict, TooManyProposals,
// PriorityInversion, EmptyOpTag. Every original variant
// carries no payload, so the code is the whole verdict.
//
// The leaf indices widen from u32 to usize - t27's loop
// counters are usize and every fixture value fits both.
// The original's BTreeMap of decided (target, tag) keys
// becomes a local array of decision records with its
// length, the lookup a scan - the first-decision semantics
// identical, the map's ordering never read by the
// original's logic.

// Maximum proposals in a single batch.
pub const LNPI_MAX_PROPOSALS: usize = 64;

// Maximum leaf index.
pub const LNPI_MAX_LEAF: usize = 1024;

// A priority-tagged proposal.
pub struct PriorityProposal {
    leaf_index: usize,
    target_leaf: usize,
    op_tag: u8,
}

// A decided (target, tag) key with the leaf that decided
// it.
pub struct DecidedEntry {
    target: usize,
    tag: u8,
    leaf: usize,
}

// Verdict codes: Ok(()) and LeafPriorityError's variants, in declaration order.
pub enum LnpiCode {
    Ok,
    LeafOutOfBounds,
    TargetOutOfBounds,
    SamePriorityConflict,
    TooManyProposals,
    PriorityInversion,
    EmptyOpTag,
}

// The verdict of the priority validation - the original's
// variants carry no payload, so the code alone carries it.
pub struct LnpiVerdict {
    code: LnpiCode,
}

// The position of the decided (target, tag) key, or the
// length when absent - the original's BTreeMap get,
// answered by a scan.
pub fn find_decided(decided: []const DecidedEntry, decided_len: usize, target: usize, tag: u8) -> usize {
    for j in 0..decided_len {
        if (decided[j].target == target) {
            if (decided[j].tag == tag) {
                return j;
            }
        }
    }
    return decided_len;
}

// [VERIFIED] Validate a batch of proposals for priority
// conflicts. Returns Ok only when every rule holds, checked
// in the original's fixed order: the batch ceiling, then
// per proposal the leaf bound, the target bound, the
// non-zero tag, and the decision conflict probes.
pub fn validate_leaf_priority(proposals: []const PriorityProposal) -> LnpiVerdict {
    if (proposals.len > LNPI_MAX_PROPOSALS) {
        return LnpiVerdict { code: LnpiCode.TooManyProposals, };
    }
    var decided: [64]DecidedEntry = [64]DecidedEntry{DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, }, DecidedEntry { target: 0, tag: 0, leaf: 0, },}
    var decided_len: usize = 0;
    for i in 0..proposals.len {
        if (proposals[i].leaf_index > LNPI_MAX_LEAF) {
            return LnpiVerdict { code: LnpiCode.LeafOutOfBounds, };
        }
        if (proposals[i].target_leaf > LNPI_MAX_LEAF) {
            return LnpiVerdict { code: LnpiCode.TargetOutOfBounds, };
        }
        if (proposals[i].op_tag == 0) {
            return LnpiVerdict { code: LnpiCode.EmptyOpTag, };
        }
        const pos: usize = find_decided(decided, decided_len, proposals[i].target_leaf, proposals[i].op_tag);
        if (pos < decided_len) {
            if (decided[pos].leaf == proposals[i].leaf_index) {
                return LnpiVerdict { code: LnpiCode.SamePriorityConflict, };
            }
            if (proposals[i].leaf_index < decided[pos].leaf) {
                return LnpiVerdict { code: LnpiCode.PriorityInversion, };
            }
        } else {
            decided[decided_len] = DecidedEntry { target: proposals[i].target_leaf, tag: proposals[i].op_tag, leaf: proposals[i].leaf_index, };
            decided_len = decided_len + 1;
        }
    }
    return LnpiVerdict { code: LnpiCode.Ok, };
}

// **LNPI-01** - the proposer leaf out of bounds rejected:
// one over the leaf ceiling.
test lnpi_01_leaf_oob_rejected {
    const props: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 1025, target_leaf: 0, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.LeafOutOfBounds);
}

// **LNPI-02** - the target leaf out of bounds rejected.
test lnpi_02_target_oob_rejected {
    const props: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1025, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.TargetOutOfBounds);
}

// **LNPI-03** - the same-priority conflict rejected: one
// leaf proposing twice on one target with one tag.
test lnpi_03_same_priority_conflict_rejected {
    const props: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.SamePriorityConflict);
}

// **LNPI-04** - too many proposals rejected: sixty-five of
// a ceiling of sixty-four, built in a loop like the
// original's.
test lnpi_04_too_many_rejected {
    var props: [65]PriorityProposal;
    for i in 0..65 {
        props[i] = PriorityProposal { leaf_index: i, target_leaf: 0, op_tag: 1, };
    }
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.TooManyProposals);
}

// **LNPI-05** - the empty operation tag rejected.
test lnpi_05_empty_tag_rejected {
    const props: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 0, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.EmptyOpTag);
}

// **LNPI-06** - the valid proposals accepted: two
// proposers on two targets.
test lnpi_06_valid_accepted {
    const props: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 1, },
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.Ok);
}

// **LNPI-07** - the empty batch accepted.
test lnpi_07_empty_accepted {
    const props: [0]PriorityProposal = [0]PriorityProposal{};
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.Ok);
}

// **LNPI-08** - one leaf on different targets accepted:
// the decision keys on the target.
test lnpi_08_diff_targets_accepted {
    const props: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 1, },
        PriorityProposal { leaf_index: 0, target_leaf: 2, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.Ok);
}

// **LNPI-09** - one leaf on one target with different
// tags accepted: the decision keys on the pair.
test lnpi_09_diff_ops_accepted {
    const props: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 1, },
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 2, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.Ok);
}

// **LNPI-10** - the higher priority first accepted: the
// later, lower-priority proposal follows the decision.
test lnpi_10_higher_first_accepted {
    const props: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 1, },
        PriorityProposal { leaf_index: 2, target_leaf: 1, op_tag: 1, },
    };
    const v = validate_leaf_priority(&props);
    assert(v.code == LnpiCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test find_decided_answers {
    const decided: [2]DecidedEntry = [2]DecidedEntry{
        DecidedEntry { target: 1, tag: 1, leaf: 0, },
        DecidedEntry { target: 2, tag: 1, leaf: 3, },
    };
    assert(find_decided(&decided, 2, 1, 1) == 0);
    assert(find_decided(&decided, 2, 2, 1) == 1);
    assert(find_decided(&decided, 2, 1, 2) == 2);
    assert(find_decided(&decided, 2, 3, 1) == 2);
    assert(find_decided(&decided, 0, 1, 1) == 0);
}

// Rule order is the original's fixed ladder: the batch
// ceiling over a flooded batch, then per proposal the leaf
// bound over the target bound, the target bound over the
// tag probe, the tag probe over the decision probes, the
// same-priority conflict over the inversion, and the
// inversion over the acceptance of a following
// lower-priority proposal.
test rule_order_matches_original {
    var flooded: [65]PriorityProposal;
    for i in 0..65 {
        flooded[i] = PriorityProposal { leaf_index: 1025, target_leaf: 1025, op_tag: 0, };
    }
    const v1 = validate_leaf_priority(&flooded);
    assert(v1.code == LnpiCode.TooManyProposals);

    const stacked: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 1025, target_leaf: 1025, op_tag: 0, },
    };
    const v2 = validate_leaf_priority(&stacked);
    assert(v2.code == LnpiCode.LeafOutOfBounds);

    const target_bad: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1025, op_tag: 0, },
    };
    const v3 = validate_leaf_priority(&target_bad);
    assert(v3.code == LnpiCode.TargetOutOfBounds);

    const tag_bad: [1]PriorityProposal = [1]PriorityProposal{
        PriorityProposal { leaf_index: 0, target_leaf: 1, op_tag: 0, },
    };
    const v4 = validate_leaf_priority(&tag_bad);
    assert(v4.code == LnpiCode.EmptyOpTag);

    const conflict_pair: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
    };
    const v5 = validate_leaf_priority(&conflict_pair);
    assert(v5.code == LnpiCode.SamePriorityConflict);

    const inversion_pair: [2]PriorityProposal = [2]PriorityProposal{
        PriorityProposal { leaf_index: 2, target_leaf: 2, op_tag: 1, },
        PriorityProposal { leaf_index: 1, target_leaf: 2, op_tag: 1, },
    };
    const v6 = validate_leaf_priority(&inversion_pair);
    assert(v6.code == LnpiCode.PriorityInversion);
}
