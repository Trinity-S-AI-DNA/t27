// **TRNC-01** - declared above the covered rejected.
test trnc_01_incomplete_rejected {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 5, covered: TRNC_POS_012, covered_len: 3, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.CountMismatch);
    assert(v.declared == 5);
    assert(v.actual == 3);
}

// **TRNC-02** - position too high rejected.
test trnc_02_position_too_high_rejected {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 1, covered: TRNC_POS_65536, covered_len: 1, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.PositionTooHigh);
    assert(v.position == TRNC_MAX_POSITION + 1);
    assert(v.max == TRNC_MAX_POSITION);
}

// **TRNC-03** - zero resolution ID rejected.
test trnc_03_zero_id_rejected {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_ZERO32, declared_count: 1, covered: TRNC_POS_ZERO, covered_len: 1, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.ZeroResolutionId);
    assert(v.idx == 0);
}

// **TRNC-04** - duplicate position rejected.
test trnc_04_duplicate_position_rejected {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 2, covered: TRNC_POS_5_5, covered_len: 2, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.DuplicatePosition);
    assert(v.position == 5);
}

// **TRNC-05** - count mismatch rejected.
test trnc_05_count_mismatch_rejected {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 10, covered: TRNC_POS_0122, covered_len: 3, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.CountMismatch);
    assert(v.declared == 10);
    assert(v.actual == 3);
}

// **TRNC-06** - too many rejected.
test trnc_06_too_many_rejected {
    const v = validate_resolution_coverage(&TRNC_2049);
    assert(v.code == TrncCode.TooMany);
    assert(v.got == TRNC_MAX_ENTRIES + 1);
    assert(v.max_count == TRNC_MAX_ENTRIES);
}

// **TRNC-07** - valid accepted.
test trnc_07_valid_accepted {
    const es: [2]CoverageEntry = [2]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 3, covered: TRNC_POS_012, covered_len: 3, },
        CoverageEntry { resolution_id: TRNC_RID_02, declared_count: 4, covered: TRNC_POS_10203040, covered_len: 4, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.Ok);
}

// **TRNC-08** - empty accepted.
test trnc_08_empty_accepted {
    const es: [0]CoverageEntry = [0]CoverageEntry{};
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.Ok);
}

// **TRNC-09** - zero declared with zero positions accepted.
test trnc_09_zero_declared_accepted {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 0, covered: TRNC_POS_ZERO, covered_len: 0, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.Ok);
}

// **TRNC-10** - large coverage accepted.
test trnc_10_large_coverage_accepted {
    const es: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 256, covered: TRNC_POS_0_255, covered_len: 256, },
    };
    const v = validate_resolution_coverage(&es);
    assert(v.code == TrncCode.Ok);
}

// The two probes have direct tests (coverage: Untested 0).
test trnc_helpers_answer {
    const es: [2]CoverageEntry = [2]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_ZERO32, declared_count: 1, covered: TRNC_POS_012, covered_len: 3, },
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 3, covered: TRNC_POS_5_5, covered_len: 2, },
    };
    assert(trnc_rid_all_zero(&es, 0));
    assert(!trnc_rid_all_zero(&es, 1));
    assert(trnc_pos_seen_before(&es, 1, 1));
    assert(!trnc_pos_seen_before(&es, 0, 1));
    assert(!trnc_pos_seen_before(&es, 0, 0));
}

// Rule order is the original code's: the batch ceiling before any
// per-entry rule, the zero id before the count equality, the count
// equality before any position rule, and the position ceiling before
// the duplicate.
test rule_order_matches_original {
    const zero_id_and_mismatch: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_ZERO32, declared_count: 5, covered: TRNC_POS_70000, covered_len: 1, },
    };
    const v1 = validate_resolution_coverage(&zero_id_and_mismatch);
    assert(v1.code == TrncCode.ZeroResolutionId);

    const mismatch_hides_high_position: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 2, covered: TRNC_POS_70000, covered_len: 1, },
    };
    const v2 = validate_resolution_coverage(&mismatch_hides_high_position);
    assert(v2.code == TrncCode.CountMismatch);

    const high_before_duplicate: [1]CoverageEntry = [1]CoverageEntry{
        CoverageEntry { resolution_id: TRNC_RID_01, declared_count: 1, covered: TRNC_POS_70000, covered_len: 1, },
    };
    const v3 = validate_resolution_coverage(&high_before_duplicate);
    assert(v3.code == TrncCode.PositionTooHigh);

    const ceiling_first = validate_resolution_coverage(&TRNC_2049);
    assert(ceiling_first.code == TrncCode.TooMany);
}
