module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_resolution_node_coverage_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_resolution_node_coverage_guard.rs
// (CR-CHAT-03 - TreeKEM resolution node coverage guard, Wave-129
// Lane A).
//
// The original's Vec<u32> positions become a fixed [256]u32 record
// field with the live length in covered_len (the largest test
// coverage walks 256 positions). The original's actual payload is
// the u32 cast of the vec length; the port keeps the count in its
// native usize and the comparison widens the declared side, so the
// verdict's actual and covered fields are usize - the values are
// identical. The BTreeSet insert probe becomes a seen-before scan
// over the prefix. The zero-resolution-id probe is its own
// record-bound scan. The verdict is a named struct (owner decision
// D5): Ok first, the variants in the original's declaration order,
// every payload field kept. Rule order is the original code's, not
// the prose header's: the batch ceiling, then per entry the zero id,
// the count equality, then per position the ceiling and the
// duplicate, and after the walk the incomplete-coverage rule - which
// the count-equality rule already makes unreachable, exactly as in
// the original; it stays declared, with the equal-count acceptance
// tests (TRNC-09, TRNC-10) documenting why it never fires.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * FULL-COVERAGE

// Maximum node position.
pub const TRNC_MAX_POSITION: u32 = 65535;

// Maximum entries per batch.
pub const TRNC_MAX_ENTRIES: usize = 2048;

// Resolution ID length.
pub const TRNC_RESOLUTION_ID_LEN: usize = 32;

// A resolution node coverage entry.
pub struct CoverageEntry {
    resolution_id: [32]u8,
    declared_count: u32,
    covered: [256]u32,
    covered_len: usize,
}

// All ways coverage validation can fail, in the original's
// declaration order, with Ok first.
pub enum TrncCode {
    Ok,
    IncompleteCoverage,
    PositionTooHigh,
    ZeroResolutionId,
    DuplicatePosition,
    CountMismatch,
    TooMany,
}

// The verdict of the coverage validation, carrying every payload
// field of every error variant.
pub struct TrncVerdict {
    code: TrncCode,
    idx: usize,
    declared: u32,
    covered: usize,
    actual: usize,
    position: u32,
    max: u32,
    got: usize,
    max_count: usize,
}

// Whether entry i's resolution id is all zero - the original's
// compare against the all-zero id, answered by a scan over the
// fixed bytes.
pub fn trnc_rid_all_zero(entries: []const CoverageEntry, i: usize) -> bool {
    for k in 0..TRNC_RESOLUTION_ID_LEN {
        if (entries[i].resolution_id[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether the position at p repeats an earlier position of the same
// entry - the original's BTreeSet insert probe, answered by a scan
// over the prefix.
pub fn trnc_pos_seen_before(entries: []const CoverageEntry, i: usize, p: usize) -> bool {
    for q in 0..p {
        if (entries[i].covered[q] == entries[i].covered[p]) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM resolution node coverage. Returns Ok
// only when every rule holds, checked in the original's code order:
// the batch ceiling, then per entry the zero id, the count
// equality, then per position the ceiling and the duplicate, and
// after the walk the incomplete-coverage rule the count equality
// already made unreachable, as in the original.
pub fn validate_resolution_coverage(entries: []const CoverageEntry) -> TrncVerdict {
    if (entries.len > TRNC_MAX_ENTRIES) {
        return TrncVerdict { code: TrncCode.TooMany, idx: 0, declared: 0, covered: 0, actual: 0, position: 0, max: 0, got: entries.len, max_count: TRNC_MAX_ENTRIES, };
    }
    for i in 0..entries.len {
        if (trnc_rid_all_zero(entries, i)) {
            return TrncVerdict { code: TrncCode.ZeroResolutionId, idx: i, declared: 0, covered: 0, actual: 0, position: 0, max: 0, got: 0, max_count: 0, };
        }
        if (entries[i].covered_len != @as(usize, entries[i].declared_count)) {
            return TrncVerdict { code: TrncCode.CountMismatch, idx: 0, declared: entries[i].declared_count, covered: 0, actual: entries[i].covered_len, position: 0, max: 0, got: 0, max_count: 0, };
        }
        for p in 0..entries[i].covered_len {
            if (entries[i].covered[p] > TRNC_MAX_POSITION) {
                return TrncVerdict { code: TrncCode.PositionTooHigh, idx: 0, declared: 0, covered: 0, actual: 0, position: entries[i].covered[p], max: TRNC_MAX_POSITION, got: 0, max_count: 0, };
            }
            if (trnc_pos_seen_before(entries, i, p)) {
                return TrncVerdict { code: TrncCode.DuplicatePosition, idx: 0, declared: 0, covered: 0, actual: 0, position: entries[i].covered[p], max: 0, got: 0, max_count: 0, };
            }
        }
        // The count-equality rule already returned on every actual
        // below the declared count, so this branch never fires -
        // kept declared and unreachable exactly as in the original.
        if (entries[i].covered_len < @as(usize, entries[i].declared_count)) {
            return TrncVerdict { code: TrncCode.IncompleteCoverage, idx: 0, declared: entries[i].declared_count, covered: entries[i].covered_len, actual: 0, position: 0, max: 0, got: 0, max_count: 0, };
        }
    }
    return TrncVerdict { code: TrncCode.Ok, idx: 0, declared: 0, covered: 0, actual: 0, position: 0, max: 0, got: 0, max_count: 0, };
}

