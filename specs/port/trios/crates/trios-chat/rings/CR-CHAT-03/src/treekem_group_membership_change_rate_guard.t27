module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_group_membership_change_rate_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_group_membership_change_rate_guard.rs
// (CR-CHAT-03 - TreeKEM group membership change rate guard, Wave-115 Lane B,
// RATCHET TREE).
//
// Membership changes trigger TreeKEM epoch transitions; changes that
// arrive too fast desynchronize members, multiply the tree recomputation
// cost, and let concurrent changes be processed in different orders.
// The gate holds six failure modes closed, in the code's fixed order:
// the batch ceiling, then per window the non-zero epoch, the strictly
// increasing epoch, the minimum window duration, the change-count
// ceiling, and the change-type vocabulary.
//
// The original returns Result<(), MembershipRateError>. This port
// carries the verdict as a named struct (owner decision D5): Ok first,
// then the six variants in the original's declaration order -
// TooManyChanges, WindowTooShort, InvalidChangeType, NotIncreasing,
// ZeroEpoch, TooMany - with every payload field: the index, the count
// and its ceiling, the duration and its floor, the offending change
// type, the previous and current epochs, and the got and max counts.
//
// The original's Vec<u8> change types become a fixed thirty-two-byte
// buffer with a length; window_start is read by no rule and does not
// cross the port. The valid-type check scans the three-element
// vocabulary.

// The maximum membership changes per window.
pub const GMCR_MAX_CHANGES: usize = 20;

// The minimum window duration in milliseconds.
pub const GMCR_MIN_WINDOW_MS: u64 = 10000;

// The maximum windows per batch.
pub const GMCR_MAX_WINDOWS: usize = 256;

// The change-type codes.
pub const CHANGE_JOIN: u8 = 1;
pub const CHANGE_LEAVE: u8 = 2;
pub const CHANGE_UPDATE: u8 = 3;

// The valid change types, smallest first.
const GMCR_VALID_CHANGES: [3]u8 = [3]u8{CHANGE_JOIN, CHANGE_LEAVE, CHANGE_UPDATE,};

// A membership change window: the epoch, the duration, the change count,
// and the observed change types with their length.
pub struct MembershipWindow {
    epoch: u64,
    window_duration: u64,
    change_count: usize,
    change_types: [32]u8,
    change_types_len: usize,
}

// Verdict codes: Ok(()) and MembershipRateError's variants, in
// declaration order.
pub enum GmcrCode {
    Ok,
    TooManyChanges,
    WindowTooShort,
    InvalidChangeType,
    NotIncreasing,
    ZeroEpoch,
    TooMany,
}

// The verdict of the membership rate gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct GmcrVerdict {
    code: GmcrCode,
    idx: usize,
    count: usize,
    max: usize,
    duration: u64,
    min: u64,
    change_type: u8,
    prev: u64,
    current: u64,
    got: usize,
}

// Whether the change type is in the vocabulary - the original's
// GMCR_VALID_CHANGES.contains.
pub fn gmcr_valid_change_type(t: u8) -> bool {
    for i in 0..GMCR_VALID_CHANGES.len {
        if (GMCR_VALID_CHANGES[i] == t) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate group membership change rate. Returns Ok only when
// the batch size and every window pass, checked in the original's fixed
// order.
pub fn check_membership_rate(windows: []const MembershipWindow) -> GmcrVerdict {
    if (windows.len > GMCR_MAX_WINDOWS) {
        return GmcrVerdict { code: GmcrCode.TooMany, idx: 0, count: 0, max: GMCR_MAX_WINDOWS, duration: 0, min: 0, change_type: 0, prev: 0, current: 0, got: windows.len, };
    }
    var prev_epoch: u64 = 0;
    for i in 0..windows.len {
        if (windows[i].epoch == 0) {
            return GmcrVerdict { code: GmcrCode.ZeroEpoch, idx: i, count: 0, max: 0, duration: 0, min: 0, change_type: 0, prev: 0, current: 0, got: 0, };
        }
        if (i > 0) {
            if (windows[i].epoch <= prev_epoch) {
                return GmcrVerdict { code: GmcrCode.NotIncreasing, idx: i, count: 0, max: 0, duration: 0, min: 0, change_type: 0, prev: prev_epoch, current: windows[i].epoch, got: 0, };
            }
        }
        if (windows[i].window_duration < GMCR_MIN_WINDOW_MS) {
            return GmcrVerdict { code: GmcrCode.WindowTooShort, idx: i, count: 0, max: 0, duration: windows[i].window_duration, min: GMCR_MIN_WINDOW_MS, change_type: 0, prev: 0, current: 0, got: 0, };
        }
        if (windows[i].change_count > GMCR_MAX_CHANGES) {
            return GmcrVerdict { code: GmcrCode.TooManyChanges, idx: i, count: windows[i].change_count, max: GMCR_MAX_CHANGES, duration: 0, min: 0, change_type: 0, prev: 0, current: 0, got: 0, };
        }
        for j in 0..windows[i].change_types_len {
            if (!gmcr_valid_change_type(windows[i].change_types[j])) {
                return GmcrVerdict { code: GmcrCode.InvalidChangeType, idx: i, count: 0, max: 0, duration: 0, min: 0, change_type: windows[i].change_types[j], prev: 0, current: 0, got: 0, };
            }
        }
        prev_epoch = windows[i].epoch;
    }
    return GmcrVerdict { code: GmcrCode.Ok, idx: 0, count: 0, max: 0, duration: 0, min: 0, change_type: 0, prev: 0, current: 0, got: 0, };
}

