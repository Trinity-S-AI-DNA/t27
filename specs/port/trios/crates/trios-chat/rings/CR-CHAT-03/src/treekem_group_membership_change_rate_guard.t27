// **GMCR-01** - too many changes in a window rejected.
test gmcr_01_too_many_rejected {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: GMCR_MAX_CHANGES + 1, change_types: GMCR_TYPES_21, change_types_len: GMCR_MAX_CHANGES + 1, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.TooManyChanges);
    assert(v.idx == 0);
    assert(v.count == GMCR_MAX_CHANGES + 1);
    assert(v.max == GMCR_MAX_CHANGES);
}

// **GMCR-02** - a window shorter than the floor rejected.
test gmcr_02_window_too_short_rejected {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 1000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.WindowTooShort);
    assert(v.idx == 0);
    assert(v.duration == 1000);
    assert(v.min == GMCR_MIN_WINDOW_MS);
}

// **GMCR-03** - an invalid change type rejected.
test gmcr_03_invalid_type_rejected {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: 2, change_types: GMCR_TYPES_1_99, change_types_len: 2, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.InvalidChangeType);
    assert(v.idx == 0);
    assert(v.change_type == 99);
}

// **GMCR-04** - an epoch that does not increase rejected.
test gmcr_04_not_increasing_rejected {
    const ws: [2]MembershipWindow = [2]MembershipWindow{
        MembershipWindow { epoch: 5, window_duration: 30000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
        MembershipWindow { epoch: 3, window_duration: 30000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.NotIncreasing);
    assert(v.idx == 1);
    assert(v.prev == 5);
    assert(v.current == 3);
}

// **GMCR-05** - a zero epoch rejected.
test gmcr_05_zero_epoch_rejected {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 0, window_duration: 30000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.ZeroEpoch);
    assert(v.idx == 0);
}

// **GMCR-06** - the batch of 257 windows rejected by the ceiling.
test gmcr_06_too_many_rejected {
    const v = check_membership_rate(&GMCR_257);
    assert(v.code == GmcrCode.TooMany);
    assert(v.got == GMCR_MAX_WINDOWS + 1);
    assert(v.max == GMCR_MAX_WINDOWS);
}

// **GMCR-07** - a valid batch accepted.
test gmcr_07_valid_accepted {
    const ws: [2]MembershipWindow = [2]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: 5, change_types: GMCR_TYPES_5, change_types_len: 5, },
        MembershipWindow { epoch: 2, window_duration: 60000, change_count: 3, change_types: GMCR_TYPES_3B, change_types_len: 3, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.Ok);
}

// **GMCR-08** - an empty batch accepted.
test gmcr_08_empty_accepted {
    const ws: [0]MembershipWindow = [0]MembershipWindow{};
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.Ok);
}

// **GMCR-09** - the exact change-count boundary accepted.
test gmcr_09_max_changes_accepted {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: GMCR_MAX_CHANGES, change_types: GMCR_TYPES_20, change_types_len: GMCR_MAX_CHANGES, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.Ok);
}

// **GMCR-10** - every change type accepted.
test gmcr_10_all_types_accepted {
    const ws: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: 3, change_types: GMCR_TYPES_3C, change_types_len: 3, },
    };
    const v = check_membership_rate(&ws);
    assert(v.code == GmcrCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test gmcr_valid_change_type_answers {
    assert(gmcr_valid_change_type(CHANGE_JOIN));
    assert(gmcr_valid_change_type(CHANGE_LEAVE));
    assert(gmcr_valid_change_type(CHANGE_UPDATE));
    assert(!gmcr_valid_change_type(0));
    assert(!gmcr_valid_change_type(99));
}

// Rule order is the original's ladder: the batch ceiling over every
// per-window rule, the zero epoch over the other window rules, the
// increasing epoch over the duration and count rules, the duration over
// the count rule, and the count over the type vocabulary.
test rule_order_matches_original {
    const zero_first: [2]MembershipWindow = [2]MembershipWindow{
        MembershipWindow { epoch: 5, window_duration: 30000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
        MembershipWindow { epoch: 0, window_duration: 1000, change_count: 99, change_types: GMCR_TYPES_1_99, change_types_len: 2, },
    };
    assert(check_membership_rate(&zero_first).code == GmcrCode.ZeroEpoch);

    const increase_first: [2]MembershipWindow = [2]MembershipWindow{
        MembershipWindow { epoch: 5, window_duration: 30000, change_count: 1, change_types: GMCR_TYPES_1, change_types_len: 1, },
        MembershipWindow { epoch: 4, window_duration: 1000, change_count: 99, change_types: GMCR_TYPES_1_99, change_types_len: 2, },
    };
    assert(check_membership_rate(&increase_first).code == GmcrCode.NotIncreasing);

    const duration_first: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 1000, change_count: 99, change_types: GMCR_TYPES_1_99, change_types_len: 2, },
    };
    assert(check_membership_rate(&duration_first).code == GmcrCode.WindowTooShort);

    const count_first: [1]MembershipWindow = [1]MembershipWindow{
        MembershipWindow { epoch: 1, window_duration: 30000, change_count: 99, change_types: GMCR_TYPES_1_99, change_types_len: 2, },
    };
    assert(check_membership_rate(&count_first).code == GmcrCode.TooManyChanges);
}
