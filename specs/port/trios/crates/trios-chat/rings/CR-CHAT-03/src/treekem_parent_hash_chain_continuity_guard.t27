module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_parent_hash_chain_continuity_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_parent_hash_chain_continuity_guard.rs
// (CR-CHAT-03 - TreeKEM parent hash chain continuity guard, RATCHET TREE).
//
// A parent hash chain binds each node's expected parent hash to the
// next node's hash, ending at a root whose parent hash is zero. A
// broken link, a repeated node id, a zero id or a root that still
// claims a parent is a splice point for a subtree forgery. The gate
// holds six failure modes closed, in the code's fixed order: the batch
// ceiling, then per chain the depth ceiling, the per-node zero and
// duplicate id rules, the root's zero parent hash, and the link rule
// parent_hash[i] == hash[i + 1].
//
// The original returns Result<(), ParentChainError>. This port carries
// the verdict as a named struct (owner decision D5): Ok first, then the
// six variants in the original's declaration order - ChainBroken,
// ZeroNodeId, DuplicateNodeId, RootParentNonZero, TooDeep,
// TooManyChains - with every payload field: the link index, the chain
// and node indices, and the got and max counts.
//
// The original's chain_id is read by no rule and does not cross the
// port; the nodes Vec becomes a fixed thirty-three-node capacity with
// a length (the depth ceiling admits thirty-two, the too-deep fixture
// carries thirty-three). The BTreeSet of node ids becomes a scan over
// the nodes already visited, through the shared ids16_equal and
// zero_id16. An empty chain is skipped, as the original's continue
// does - the port nests the checks under a length gate instead.

// The maximum chain depth.
pub const TPHC_MAX_DEPTH: usize = 32;

// The maximum chains per batch.
pub const TPHC_MAX_CHAINS: usize = 256;

// The hash length.
pub const TPHC_HASH_LEN: usize = 32;

// The node id length.
pub const TPHC_NODE_ID_LEN: usize = 16;

// One node of a parent hash chain.
pub struct ParentHashNode {
    node_id: [16]u8,
    hash: [32]u8,
    parent_hash: [32]u8,
}

// One chain: its nodes, leaf to root, with their count.
pub struct ChainRec {
    nodes: [33]ParentHashNode,
    nodes_len: usize,
}

// Verdict codes: Ok(()) and ParentChainError's variants, in declaration
// order.
pub enum TphcCode {
    Ok,
    ChainBroken,
    ZeroNodeId,
    DuplicateNodeId,
    RootParentNonZero,
    TooDeep,
    TooManyChains,
}

// The verdict of the chain continuity gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct TphcVerdict {
    code: TphcCode,
    idx: usize,
    chain: usize,
    node: usize,
    got: usize,
    max: usize,
}

// Whether the node id of node i in chain ci was already seen earlier in
// the same chain - the original's seen.insert failure.
pub fn tphc_id_seen_before(chains: []const ChainRec, ci: usize, i: usize) -> bool {
    for j in 0..i {
        if (ids16_equal(chains[ci].nodes[j].node_id, chains[ci].nodes[i].node_id)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM parent hash chain continuity. Returns Ok
// only when the batch size and every chain pass, checked in the
// original's fixed order; an empty chain passes trivially.
pub fn check_parent_hash_chains(chains: []const ChainRec) -> TphcVerdict {
    if (chains.len > TPHC_MAX_CHAINS) {
        return TphcVerdict { code: TphcCode.TooManyChains, idx: 0, chain: 0, node: 0, got: chains.len, max: TPHC_MAX_CHAINS, };
    }
    for ci in 0..chains.len {
        if (chains[ci].nodes_len > TPHC_MAX_DEPTH) {
            return TphcVerdict { code: TphcCode.TooDeep, idx: 0, chain: ci, node: 0, got: chains[ci].nodes_len, max: TPHC_MAX_DEPTH, };
        }
        if (chains[ci].nodes_len > 0) {
            for ni in 0..chains[ci].nodes_len {
                if (zero_id16(chains[ci].nodes[ni].node_id)) {
                    return TphcVerdict { code: TphcCode.ZeroNodeId, idx: 0, chain: ci, node: ni, got: 0, max: 0, };
                }
                if (tphc_id_seen_before(chains, ci, ni)) {
                    return TphcVerdict { code: TphcCode.DuplicateNodeId, idx: 0, chain: ci, node: ni, got: 0, max: 0, };
                }
            }
            const last: usize = chains[ci].nodes_len - 1;
            if (!ids32_equal(chains[ci].nodes[last].parent_hash, TPHC_HZZ)) {
                return TphcVerdict { code: TphcCode.RootParentNonZero, idx: 0, chain: ci, node: 0, got: 0, max: 0, };
            }
            for i in 0..last {
                if (!ids32_equal(chains[ci].nodes[i].parent_hash, chains[ci].nodes[i + 1].hash)) {
                    return TphcVerdict { code: TphcCode.ChainBroken, idx: i, chain: ci, node: 0, got: 0, max: 0, };
                }
            }
        }
    }
    return TphcVerdict { code: TphcCode.Ok, idx: 0, chain: 0, node: 0, got: 0, max: 0, };
}

