// **TPHC-01** - a broken link rejected.
test tphc_01_chain_broken_rejected {
    const chains: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_N03, hash: TPHC_HCC, parent_hash: TPHC_HFF },
        ParentHashNode { node_id: TPHC_N02, hash: TPHC_HBB, parent_hash: TPHC_HAA },
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HAA, parent_hash: TPHC_HZZ },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 3, }, };
    const v = check_parent_hash_chains(&chains);
    assert(v.code == TphcCode.ChainBroken);
    assert(v.idx == 0);
}

// **TPHC-02** - a zero node id rejected.
test tphc_02_zero_node_id_rejected {
    const chains: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_NZZ, hash: TPHC_HAA, parent_hash: TPHC_HZZ },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 1, }, };
    const v = check_parent_hash_chains(&chains);
    assert(v.code == TphcCode.ZeroNodeId);
    assert(v.chain == 0);
    assert(v.node == 0);
}

// **TPHC-03** - a duplicate node id rejected.
test tphc_03_duplicate_rejected {
    const chains: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HCC, parent_hash: TPHC_HBB },
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HBB, parent_hash: TPHC_HAA },
        ParentHashNode { node_id: TPHC_N02, hash: TPHC_HAA, parent_hash: TPHC_HZZ },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
