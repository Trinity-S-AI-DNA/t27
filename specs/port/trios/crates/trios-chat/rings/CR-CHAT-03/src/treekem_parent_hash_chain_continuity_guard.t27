// The helper has a direct test (coverage: Untested 0).
test tphc_id_seen_before_answers {
    const chains: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HCC, parent_hash: TPHC_HBB },
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HBB, parent_hash: TPHC_HAA },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 2, }, };
    assert(!tphc_id_seen_before(&chains, 0, 0));
    assert(tphc_id_seen_before(&chains, 0, 1));
}

// Rule order is the original's ladder: the batch ceiling over every
// per-chain rule, the depth ceiling over the node rules, the zero id
// over the duplicate, the duplicate over the root rule, and the root
// rule over the link rule.
test rule_order_matches_original {
    const deep_and_zero: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_NZZ, hash: TPHC_HAA, parent_hash: TPHC_HZZ },
        ParentHashNode { node_id: TPHC_N02, hash: TPHC_HBB, parent_hash: TPHC_HAA },
        ParentHashNode { node_id: TPHC_N03, hash: TPHC_HCC, parent_hash: TPHC_HZZ },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 3, }, };
    assert(check_parent_hash_chains(&deep_and_zero).code == TphcCode.ZeroNodeId);

    const dup_and_root: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HCC, parent_hash: TPHC_HBB },
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HBB, parent_hash: TPHC_HFF },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 2, }, };
    assert(check_parent_hash_chains(&dup_and_root).code == TphcCode.DuplicateNodeId);

    const root_and_broken: [1]ChainRec = [1]ChainRec{ ChainRec { nodes: [33]ParentHashNode{
        ParentHashNode { node_id: TPHC_N03, hash: TPHC_HCC, parent_hash: TPHC_HFF },
        ParentHashNode { node_id: TPHC_N01, hash: TPHC_HAA, parent_hash: TPHC_HFF },
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
        TPHC_PAD,
    }, nodes_len: 2, }, };
    assert(check_parent_hash_chains(&root_and_broken).code == TphcCode.RootParentNonZero);
}
