module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_leaf_node_key_freshness_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_leaf_node_key_freshness_guard.rs
// (CR-CHAT-03 - TreeKEM leaf node key freshness guard, Wave-122 Lane B,
// RATCHET TREE).
//
// A leaf key that is never refreshed protects more messages and drags
// more derived material behind it. The gate holds six failure modes
// closed, in the code's fixed order: the batch ceiling, then per leaf the
// non-zero generated-at timestamp, the non-zero key hash, the unique leaf
// index, the fresh key hash, and the maximum key age (a key generated
// after now is not aged and passes, as in the original).
//
// The original returns Result<(), LeafFreshnessError>. This port carries
// the verdict as a named struct (owner decision D5): Ok first, then the
// six variants in the original's declaration order - TooOld,
// DuplicateIndex, ZeroKeyHash, DuplicateKeyHash, ZeroTimestamp, TooMany -
// with every payload field: the index, the age and its ceiling, the leaf
// index, and the got and max counts.
//
// The two BTreeSets become scans over the leaves already visited: the
// index scan compares usize values, the hash scan goes through the
// shared ids32_equal. The original's two different max payloads (a u64
// age ceiling and a usize leaf ceiling) stay apart, since t27 forbids
// narrowing across them.

// The maximum key age in milliseconds: 24 hours.
pub const TLNF_MAX_AGE_MS: u64 = 86400000;

// The maximum leaves per batch.
pub const TLNF_MAX_LEAVES: usize = 1024;

// The key hash length.
pub const TLNF_HASH_LEN: usize = 32;

// A leaf key freshness record: the leaf index, the key hash, the
// generated-at timestamp and the current time.
pub struct LeafKeyRecord {
    leaf_index: usize,
    key_hash: [32]u8,
    generated_at_ms: u64,
    now_ms: u64,
}

// Verdict codes: Ok(()) and LeafFreshnessError's variants, in
// declaration order.
pub enum TlnfCode {
    Ok,
    TooOld,
    DuplicateIndex,
    ZeroKeyHash,
    DuplicateKeyHash,
    ZeroTimestamp,
    TooMany,
}

// The verdict of the leaf freshness gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct TlnfVerdict {
    code: TlnfCode,
    idx: usize,
    age_ms: u64,
    max_age: u64,
    leaf_index: usize,
    got_count: usize,
    max_leaves: usize,
}

// Whether the leaf index of leaf i was already seen in an earlier leaf.
pub fn tlnf_index_seen_before(leaves: []const LeafKeyRecord, i: usize) -> bool {
    for j in 0..i {
        if (leaves[j].leaf_index == leaves[i].leaf_index) {
            return true;
        }
    }
    return false;
}

// Whether the key hash of leaf i was already seen in an earlier leaf.
pub fn tlnf_hash_seen_before(leaves: []const LeafKeyRecord, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(leaves[j].key_hash, leaves[i].key_hash)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM leaf node key freshness. Returns Ok only
// when the batch size and every leaf pass, checked in the original's
// fixed order.
pub fn check_leaf_freshness(leaves: []const LeafKeyRecord) -> TlnfVerdict {
    if (leaves.len > TLNF_MAX_LEAVES) {
        return TlnfVerdict { code: TlnfCode.TooMany, idx: 0, age_ms: 0, max_age: 0, leaf_index: 0, got_count: leaves.len, max_leaves: TLNF_MAX_LEAVES, };
    }
    var age: u64 = 0;
    for i in 0..leaves.len {
        if (leaves[i].generated_at_ms == 0) {
            return TlnfVerdict { code: TlnfCode.ZeroTimestamp, idx: i, age_ms: 0, max_age: 0, leaf_index: 0, got_count: 0, max_leaves: 0, };
        }
        if (ids32_equal(leaves[i].key_hash, TLNF_ZERO32)) {
            return TlnfVerdict { code: TlnfCode.ZeroKeyHash, idx: i, age_ms: 0, max_age: 0, leaf_index: 0, got_count: 0, max_leaves: 0, };
        }
        if (tlnf_index_seen_before(leaves, i)) {
            return TlnfVerdict { code: TlnfCode.DuplicateIndex, idx: i, age_ms: 0, max_age: 0, leaf_index: leaves[i].leaf_index, got_count: 0, max_leaves: 0, };
        }
        if (tlnf_hash_seen_before(leaves, i)) {
            return TlnfVerdict { code: TlnfCode.DuplicateKeyHash, idx: i, age_ms: 0, max_age: 0, leaf_index: 0, got_count: 0, max_leaves: 0, };
        }
        if (leaves[i].now_ms >= leaves[i].generated_at_ms) {
            age = leaves[i].now_ms - leaves[i].generated_at_ms;
            if (age > TLNF_MAX_AGE_MS) {
                return TlnfVerdict { code: TlnfCode.TooOld, idx: i, age_ms: age, max_age: TLNF_MAX_AGE_MS, leaf_index: 0, got_count: 0, max_leaves: 0, };
            }
        }
    }
    return TlnfVerdict { code: TlnfCode.Ok, idx: 0, age_ms: 0, max_age: 0, leaf_index: 0, got_count: 0, max_leaves: 0, };
}

