// **TLNF-01** - a key older than the ceiling rejected.
test tlnf_01_too_old_rejected {
    const ls: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 100, now_ms: 100 + TLNF_MAX_AGE_MS + 1, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.TooOld);
    assert(v.idx == 0);
    assert(v.age_ms == TLNF_MAX_AGE_MS + 1);
    assert(v.max_age == TLNF_MAX_AGE_MS);
}

// **TLNF-02** - a duplicate leaf index rejected.
test tlnf_02_duplicate_index_rejected {
    const ls: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A1, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A2, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.DuplicateIndex);
    assert(v.idx == 1);
    assert(v.leaf_index == 0);
}

// **TLNF-03** - a zero key hash rejected.
test tlnf_03_zero_key_rejected {
    const ls: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_ZERO32, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.ZeroKeyHash);
    assert(v.idx == 0);
}

// **TLNF-04** - a duplicate key hash rejected.
test tlnf_04_duplicate_hash_rejected {
    const ls: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 1, key_hash: TLNF_H_AA, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.DuplicateKeyHash);
    assert(v.idx == 1);
}

// **TLNF-05** - a zero generated-at timestamp rejected.
test tlnf_05_zero_timestamp_rejected {
    const ls: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 0, now_ms: 1000, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.ZeroTimestamp);
    assert(v.idx == 0);
}

// **TLNF-06** - the batch of 1025 leaves rejected by the ceiling, before
// the per-leaf violations its records also carry.
test tlnf_06_too_many_rejected {
    const v = check_leaf_freshness(&TLNF_1025);
    assert(v.code == TlnfCode.TooMany);
    assert(v.got_count == TLNF_MAX_LEAVES + 1);
    assert(v.max_leaves == TLNF_MAX_LEAVES);
}

// **TLNF-07** - a valid batch accepted.
test tlnf_07_valid_accepted {
    const ls: [3]LeafKeyRecord = [3]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A1, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 1, key_hash: TLNF_H_A2, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 2, key_hash: TLNF_H_A3, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.Ok);
}

// **TLNF-08** - an empty batch accepted.
test tlnf_08_empty_accepted {
    const ls: [0]LeafKeyRecord = [0]LeafKeyRecord{};
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.Ok);
}

// **TLNF-09** - the exact age boundary accepted.
test tlnf_09_boundary_accepted {
    const ls: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 100, now_ms: 100 + TLNF_MAX_AGE_MS, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.Ok);
}

// **TLNF-10** - a key generated after now is not aged and accepted.
test tlnf_10_future_key_accepted {
    const ls: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 2000000, now_ms: 1000000, },
    };
    const v = check_leaf_freshness(&ls);
    assert(v.code == TlnfCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test tlnf_index_seen_before_answers {
    const ls: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A1, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A2, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    assert(!tlnf_index_seen_before(&ls, 0));
    assert(tlnf_index_seen_before(&ls, 1));
}

test tlnf_hash_seen_before_answers {
    const ls: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 1, key_hash: TLNF_H_AA, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    assert(!tlnf_hash_seen_before(&ls, 0));
    assert(tlnf_hash_seen_before(&ls, 1));
}

// Rule order is the original's ladder: the batch ceiling over every
// per-leaf rule, the zero timestamp over the hash and duplicate rules,
// the zero hash over the duplicate rules, the duplicate index over the
// duplicate hash, and the duplicates over the age rule.
test rule_order_matches_original {
    const ts_first: [1]LeafKeyRecord = [1]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_ZERO32, generated_at_ms: 0, now_ms: 1000, },
    };
    assert(check_leaf_freshness(&ts_first).code == TlnfCode.ZeroTimestamp);

    const zero_hash_first: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A1, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_ZERO32, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    assert(check_leaf_freshness(&zero_hash_first).code == TlnfCode.ZeroKeyHash);

    const dup_index_first: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A1, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_A2, generated_at_ms: 1000000, now_ms: 1000001, },
    };
    assert(check_leaf_freshness(&dup_index_first).code == TlnfCode.DuplicateIndex);

    const dup_hash_first: [2]LeafKeyRecord = [2]LeafKeyRecord{
        LeafKeyRecord { leaf_index: 0, key_hash: TLNF_H_AA, generated_at_ms: 1000000, now_ms: 1000001, },
        LeafKeyRecord { leaf_index: 1, key_hash: TLNF_H_AA, generated_at_ms: 100, now_ms: 100 + TLNF_MAX_AGE_MS + 1, },
    };
    assert(check_leaf_freshness(&dup_hash_first).code == TlnfCode.DuplicateKeyHash);
}
