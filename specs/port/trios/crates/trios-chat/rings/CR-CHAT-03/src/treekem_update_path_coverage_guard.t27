        UpdatePathRecord { sender_leaf: 6, nodes: [4]u64{7, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 7, nodes: [4]u64{8, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
