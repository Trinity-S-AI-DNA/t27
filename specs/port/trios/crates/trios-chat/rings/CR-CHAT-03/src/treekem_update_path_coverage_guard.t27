// **TUPC-06** - zero secret rejected.
test tupc_06_zero_secret_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 0, 0,}, nodes_len: 2, expected_len: 2, secrets_non_zero: false, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.ZeroSecret);
    assert(v.sender == 0);
}

// **TUPC-07** - valid paths accepted.
test tupc_07_valid_accepted {
    const ps: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 7, 0,}, nodes_len: 3, expected_len: 3, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 2, nodes: [4]u64{3, 7, 15, 0,}, nodes_len: 3, expected_len: 3, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.Ok);
}

// **TUPC-08** - empty accepted.
test tupc_08_empty_accepted {
    const ps: [0]UpdatePathRecord = [0]UpdatePathRecord{};
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.Ok);
}

// **TUPC-09** - single node path accepted.
test tupc_09_single_node_accepted {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.Ok);
}

// **TUPC-10** - max paths boundary accepted.
test tupc_10_max_boundary_accepted {
    const ps: [256]UpdatePathRecord = [256]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 1, nodes: [4]u64{2, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 2, nodes: [4]u64{3, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 3, nodes: [4]u64{4, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
