// The probe has a direct test (coverage: Untested 0).
test tupc_helpers_answer {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 3, 0,}, nodes_len: 3, expected_len: 3, secrets_non_zero: true, },
    };
    assert(!tupc_node_seen_before(&ps, 0, 1));
    assert(tupc_node_seen_before(&ps, 0, 2));
}

// Rule order is the original code's: the batch ceiling before any
// per-path rule, the sender ceiling before the expected length, the
// expected length before the zero-secret flag, the zero-secret flag
// before any node rule, and the repeated index before the
// non-increasing index.
test rule_order_matches_original {
    const sender_hides_mismatch: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: TUPC_MAX_LEAVES, nodes: [4]u64{1, 0, 0, 0,}, nodes_len: 1, expected_len: 3, secrets_non_zero: false, },
    };
    const v1 = validate_update_path_coverage(&sender_hides_mismatch);
    assert(v1.code == TupcCode.SenderOutOfRange);

    const mismatch_hides_zero_secret: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 0, 0,}, nodes_len: 2, expected_len: 3, secrets_non_zero: false, },
    };
    const v2 = validate_update_path_coverage(&mismatch_hides_zero_secret);
    assert(v2.code == TupcCode.LengthMismatch);

    const zero_secret_hides_dup: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{5, 5, 0, 0,}, nodes_len: 2, expected_len: 2, secrets_non_zero: false, },
    };
    const v3 = validate_update_path_coverage(&zero_secret_hides_dup);
    assert(v3.code == TupcCode.ZeroSecret);

    const dup_before_increasing: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{3, 3, 0, 0,}, nodes_len: 2, expected_len: 2, secrets_non_zero: true, },
    };
    const v4 = validate_update_path_coverage(&dup_before_increasing);
    assert(v4.code == TupcCode.DuplicateIndex);

    const increasing_after_dup: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{7, 3, 0, 0,}, nodes_len: 2, expected_len: 2, secrets_non_zero: true, },
    };
    const v5 = validate_update_path_coverage(&increasing_after_dup);
    assert(v5.code == TupcCode.NotIncreasing);

    const ps257: [257]UpdatePathRecord = [257]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
        UpdatePathRecord { sender_leaf: 1, nodes: [4]u64{2, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
