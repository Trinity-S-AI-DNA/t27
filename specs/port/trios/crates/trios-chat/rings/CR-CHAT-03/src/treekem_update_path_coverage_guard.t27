module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_update_path_coverage_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_update_path_coverage_guard.rs
// (CR-CHAT-03 - TreeKEM update path coverage guard, Wave-98 Lane B,
// R-CHAT-3).
//
// The original's Vec<u64> node list becomes a fixed [4]u64 record
// field with the live length in nodes_len - the largest test path
// walks three nodes. The BTreeSet insert probe becomes a
// seen-before scan. The original's boolean secret flag arrives as
// its own bool field, read by a straight not. The verdict is a named
// struct (owner decision D5): Ok first, the variants in the
// original's declaration order, every payload field kept; the
// u64 payloads of NotIncreasing and DuplicateIndex land in node,
// the u64 payloads of SenderOutOfRange and ZeroSecret in sender.
// Rule order is the original code's, not the prose header's: the
// batch ceiling, then per path the sender ceiling, the expected
// length, the zero-secret flag, then per node the repeated index
// BEFORE the non-increasing index - the original answers the
// duplicate first.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PATH-COVERAGE

// Maximum leaves in the tree.
pub const TUPC_MAX_LEAVES: u64 = 1024;

// Maximum paths to validate.
pub const TUPC_MAX_PATHS: usize = 256;

// An update path record: the sender with its direct-path node
// list, the fixed [4]u64 node array carrying the live length in
// nodes_len.
pub struct UpdatePathRecord {
    sender_leaf: u64,
    nodes: [4]u64,
    nodes_len: usize,
    expected_len: usize,
    secrets_non_zero: bool,
}

// All ways path coverage validation can fail, in the original's
// declaration order, with Ok first.
pub enum TupcCode {
    Ok,
    LengthMismatch,
    NotIncreasing,
    DuplicateIndex,
    SenderOutOfRange,
    TooManyPaths,
    ZeroSecret,
}

// The verdict of the update path coverage validation, carrying every
// payload field of every error variant.
pub struct TupcVerdict {
    code: TupcCode,
    expected: usize,
    got: usize,
    node: u64,
    sender: u64,
}

// Whether the node at ni of path pi repeats an earlier node of the
// same path - the original's BTreeSet insert probe, answered by a
// scan over the prefix.
pub fn tupc_node_seen_before(paths: []const UpdatePathRecord, pi: usize, ni: usize) -> bool {
    for q in 0..ni {
        if (paths[pi].nodes[q] == paths[pi].nodes[ni]) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM update path coverage. Returns Ok only
// when every rule holds, checked in the original's code order: the
// batch ceiling, then per path the sender ceiling, the expected
// length, the zero-secret flag, then per node the repeated index
// and the non-increasing index.
pub fn validate_update_path_coverage(paths: []const UpdatePathRecord) -> TupcVerdict {
    if (paths.len > TUPC_MAX_PATHS) {
        return TupcVerdict { code: TupcCode.TooManyPaths, expected: 0, got: 0, node: 0, sender: 0, };
    }
    for pi in 0..paths.len {
        if (paths[pi].sender_leaf >= TUPC_MAX_LEAVES) {
            return TupcVerdict { code: TupcCode.SenderOutOfRange, expected: 0, got: 0, node: 0, sender: paths[pi].sender_leaf, };
        }
        if (paths[pi].nodes_len != paths[pi].expected_len) {
            return TupcVerdict { code: TupcCode.LengthMismatch, expected: paths[pi].expected_len, got: paths[pi].nodes_len, node: 0, sender: 0, };
        }
        if (!paths[pi].secrets_non_zero) {
            return TupcVerdict { code: TupcCode.ZeroSecret, expected: 0, got: 0, node: 0, sender: paths[pi].sender_leaf, };
        }
        for ni in 0..paths[pi].nodes_len {
            if (tupc_node_seen_before(paths, pi, ni)) {
                return TupcVerdict { code: TupcCode.DuplicateIndex, expected: 0, got: 0, node: paths[pi].nodes[ni], sender: 0, };
            }
            if (ni > 0) {
                if (paths[pi].nodes[ni] <= paths[pi].nodes[ni - 1]) {
                    return TupcVerdict { code: TupcCode.NotIncreasing, expected: 0, got: 0, node: paths[pi].nodes[ni], sender: 0, };
                }
            }
        }
    }
    return TupcVerdict { code: TupcCode.Ok, expected: 0, got: 0, node: 0, sender: 0, };
}

// **TUPC-01** - length mismatch rejected.
test tupc_01_length_mismatch_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 0, 0,}, nodes_len: 2, expected_len: 3, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.LengthMismatch);
    assert(v.expected == 3);
    assert(v.got == 2);
}

// **TUPC-02** - not increasing rejected.
test tupc_02_not_increasing_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{7, 3, 15, 0,}, nodes_len: 3, expected_len: 3, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.NotIncreasing);
    assert(v.node == 3);
}

// **TUPC-03** - duplicate index rejected.
test tupc_03_duplicate_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: 0, nodes: [4]u64{1, 3, 3, 0,}, nodes_len: 3, expected_len: 3, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.DuplicateIndex);
    assert(v.node == 3);
}

// **TUPC-04** - sender out of range rejected.
test tupc_04_sender_out_of_range_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { sender_leaf: TUPC_MAX_LEAVES, nodes: [4]u64{1, 0, 0, 0,}, nodes_len: 1, expected_len: 1, secrets_non_zero: true, },
    };
    const v = validate_update_path_coverage(&ps);
    assert(v.code == TupcCode.SenderOutOfRange);
    assert(v.sender == TUPC_MAX_LEAVES);
}

