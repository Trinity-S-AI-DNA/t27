// **TPSF-10** - diverse secrets accepted.
test tpsf_10_diverse_accepted {
    const path: [4]PathSecret = [4]PathSecret{
        PathSecret { data: TPSF_DIV_0, data_len: 32, },
        PathSecret { data: TPSF_DIV_1, data_len: 32, },
        PathSecret { data: TPSF_DIV_2, data_len: 32, },
        PathSecret { data: TPSF_DIV_3, data_len: 32, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.Ok);
}

// The two probes have direct tests (coverage: Untested 0).
test tpsf_helpers_answer {
    const path: [3]PathSecret = [3]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_ZERO32, data_len: 32, },
        PathSecret { data: TPSF_S02, data_len: 32, },
    };
    assert(tpsf_secret_all_zero(&path, 1));
    assert(!tpsf_secret_all_zero(&path, 0));
    assert(!tpsf_secret_seen_before(&path, 0));
    assert(!tpsf_secret_seen_before(&path, 2));
    const dup: [2]PathSecret = [2]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_S01, data_len: 32, },
    };
    assert(tpsf_secret_seen_before(&dup, 1));
}

// Rule order is the original code's: the empty path before the
// minimum, the minimum before the maximum, the maximum before the
// per-secret rules, and per secret the length before the zero probe
// before the duplicate.
test rule_order_matches_original {
    const one: [1]PathSecret = [1]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
    };
    const v1 = validate_path_secret_order(&one);
    assert(v1.code == TpsfCode.PathTooShort);

    const long_and_bad: [33]PathSecret = [33]PathSecret{
        PathSecret { data: TPSF_ZERO32, data_len: 16, },
        PathSecret { data: TPSF_FIRST_02, data_len: 32, },
        PathSecret { data: TPSF_FIRST_03, data_len: 32, },
        PathSecret { data: TPSF_FIRST_04, data_len: 32, },
        PathSecret { data: TPSF_FIRST_05, data_len: 32, },
        PathSecret { data: TPSF_FIRST_06, data_len: 32, },
        PathSecret { data: TPSF_FIRST_07, data_len: 32, },
        PathSecret { data: TPSF_FIRST_08, data_len: 32, },
        PathSecret { data: TPSF_FIRST_09, data_len: 32, },
        PathSecret { data: TPSF_FIRST_10, data_len: 32, },
        PathSecret { data: TPSF_FIRST_11, data_len: 32, },
        PathSecret { data: TPSF_FIRST_12, data_len: 32, },
        PathSecret { data: TPSF_FIRST_13, data_len: 32, },
        PathSecret { data: TPSF_FIRST_14, data_len: 32, },
        PathSecret { data: TPSF_FIRST_15, data_len: 32, },
        PathSecret { data: TPSF_FIRST_16, data_len: 32, },
        PathSecret { data: TPSF_FIRST_17, data_len: 32, },
        PathSecret { data: TPSF_FIRST_18, data_len: 32, },
        PathSecret { data: TPSF_FIRST_19, data_len: 32, },
        PathSecret { data: TPSF_FIRST_20, data_len: 32, },
        PathSecret { data: TPSF_FIRST_21, data_len: 32, },
        PathSecret { data: TPSF_FIRST_22, data_len: 32, },
        PathSecret { data: TPSF_FIRST_23, data_len: 32, },
        PathSecret { data: TPSF_FIRST_24, data_len: 32, },
        PathSecret { data: TPSF_FIRST_25, data_len: 32, },
        PathSecret { data: TPSF_FIRST_26, data_len: 32, },
        PathSecret { data: TPSF_FIRST_27, data_len: 32, },
        PathSecret { data: TPSF_FIRST_28, data_len: 32, },
        PathSecret { data: TPSF_FIRST_29, data_len: 32, },
        PathSecret { data: TPSF_FIRST_30, data_len: 32, },
        PathSecret { data: TPSF_FIRST_31, data_len: 32, },
        PathSecret { data: TPSF_FIRST_32, data_len: 32, },
        PathSecret { data: TPSF_FIRST_33, data_len: 32, },
    };
    const v2 = validate_path_secret_order(&long_and_bad);
    assert(v2.code == TpsfCode.PathTooLong);

    const short_and_zero: [2]PathSecret = [2]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_S16, data_len: 16, },
    };
    const v3 = validate_path_secret_order(&short_and_zero);
    assert(v3.code == TpsfCode.SecretLengthWrong);

    const twin_zero: [2]PathSecret = [2]PathSecret{
        PathSecret { data: TPSF_ZERO32, data_len: 32, },
        PathSecret { data: TPSF_ZERO32, data_len: 32, },
    };
    const v4 = validate_path_secret_order(&twin_zero);
    assert(v4.code == TpsfCode.ZeroSecret);
}
