module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_path_secret_forward_secrecy_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_path_secret_forward_secrecy_guard.rs
// (CR-CHAT-03 - TreeKEM path secret forward secrecy guard, Wave-78
// Lane B, R-CHAT-2).
//
// The original's &[Vec<u8>] becomes a slice of records: the fixed
// [32]u8 secret with the live length in data_len (the wrong-length
// fixture of TPSF-05 carries 16). The BTreeSet insert probe becomes
// a seen-before scan that compares the fixed thirty-two bytes with
// the shared ids32_equal - the per-secret length rule already ran
// for every earlier secret, so the full-width compare is exact. The
// all-zero probe is its own record-bound scan. The verdict is a
// named struct (owner decision D5) with Ok first and the variants in
// the original's declaration order; the original's variants carry no
// payloads, so the verdict carries the code alone. Rule order is the
// original code's, not the prose header's: the empty path, the
// minimum, the maximum, then per secret the length, the zero probe
// and the duplicate.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PATH-SECRET-FORWARD

// Minimum path length.
pub const TPSF_MIN_PATH: usize = 2;

// Maximum path length.
pub const TPSF_MAX_PATH: usize = 32;

// Secret length (bytes).
pub const TPSF_SECRET_LEN: usize = 32;

// One path secret: the fixed-width bytes with the live length.
pub struct PathSecret {
    data: [32]u8,
    data_len: usize,
}

// All ways path secret validation can fail, in the original's
// declaration order, with Ok first.
pub enum TpsfCode {
    Ok,
    DuplicateSecret,
    PathTooShort,
    PathTooLong,
    ZeroSecret,
    SecretLengthWrong,
    EmptyPath,
}

// The verdict of the path secret validation. The original's error
// variants carry no payloads, so the verdict carries the code alone.
pub struct TpsfVerdict {
    code: TpsfCode,
}

// Whether secret i is all zero - the original's iter().all zero
// probe, answered by a scan over the fixed bytes.
pub fn tpsf_secret_all_zero(secrets: []const PathSecret, i: usize) -> bool {
    for k in 0..TPSF_SECRET_LEN {
        if (secrets[i].data[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether secret i repeats an earlier secret - the original's
// BTreeSet insert probe, answered by a scan over the prefix with the
// shared whole-id equality.
pub fn tpsf_secret_seen_before(secrets: []const PathSecret, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(secrets[j].data, secrets[i].data)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM path secrets for forward-secrecy
// ordering. Returns Ok only when every rule holds, checked in the
// original's code order: the empty path, the minimum, the maximum,
// then per secret the length, the zero probe and the duplicate.
pub fn validate_path_secret_order(secrets: []const PathSecret) -> TpsfVerdict {
    if (secrets.len == 0) {
        return TpsfVerdict { code: TpsfCode.EmptyPath, };
    }
    if (secrets.len < TPSF_MIN_PATH) {
        return TpsfVerdict { code: TpsfCode.PathTooShort, };
    }
    if (secrets.len > TPSF_MAX_PATH) {
        return TpsfVerdict { code: TpsfCode.PathTooLong, };
    }
    for i in 0..secrets.len {
        if (secrets[i].data_len != TPSF_SECRET_LEN) {
            return TpsfVerdict { code: TpsfCode.SecretLengthWrong, };
        }
        if (tpsf_secret_all_zero(secrets, i)) {
            return TpsfVerdict { code: TpsfCode.ZeroSecret, };
        }
        if (tpsf_secret_seen_before(secrets, i)) {
            return TpsfVerdict { code: TpsfCode.DuplicateSecret, };
        }
    }
    return TpsfVerdict { code: TpsfCode.Ok, };
}

