// **TPSF-01** - duplicate secret rejected.
test tpsf_01_duplicate_rejected {
    const path: [3]PathSecret = [3]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_S02, data_len: 32, },
        PathSecret { data: TPSF_S01, data_len: 32, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.DuplicateSecret);
}

// **TPSF-02** - path too short rejected.
test tpsf_02_too_short_rejected {
    const path: [1]PathSecret = [1]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.PathTooShort);
}

