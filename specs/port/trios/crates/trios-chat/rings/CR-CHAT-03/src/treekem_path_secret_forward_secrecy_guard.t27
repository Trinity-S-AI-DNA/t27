// **TPSF-04** - zero secret rejected.
test tpsf_04_zero_rejected {
    const path: [2]PathSecret = [2]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_ZERO32, data_len: 32, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.ZeroSecret);
}

// **TPSF-05** - secret length wrong rejected.
test tpsf_05_len_wrong_rejected {
    const path: [2]PathSecret = [2]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_S16, data_len: 16, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.SecretLengthWrong);
}

// **TPSF-06** - empty path rejected.
test tpsf_06_empty_rejected {
    const path: [0]PathSecret = [0]PathSecret{};
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.EmptyPath);
}

// **TPSF-07** - valid path accepted.
test tpsf_07_valid_accepted {
    const path: [4]PathSecret = [4]PathSecret{
        PathSecret { data: TPSF_S01, data_len: 32, },
        PathSecret { data: TPSF_S02, data_len: 32, },
        PathSecret { data: TPSF_S03, data_len: 32, },
        PathSecret { data: TPSF_S04, data_len: 32, },
    };
    const v = validate_path_secret_order(&path);
    assert(v.code == TpsfCode.Ok);
}

