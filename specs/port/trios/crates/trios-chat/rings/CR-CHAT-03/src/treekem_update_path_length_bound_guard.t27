// **TUPL-01** - too long rejected.
test tupl_01_too_long_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: TUPL_MAX_PATH_LEN + 1, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.TooLong);
    assert(v.idx == 0);
    assert(v.got == TUPL_MAX_PATH_LEN + 1);
    assert(v.max_count == TUPL_MAX_PATH_LEN);
}

// **TUPL-02** - too short rejected.
test tupl_02_too_short_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: TUPL_MIN_PATH_LEN - 1, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.TooShort);
    assert(v.idx == 0);
    assert(v.got == TUPL_MIN_PATH_LEN - 1);
    assert(v.min == TUPL_MIN_PATH_LEN);
}

// **TUPL-03** - zero tree ID rejected.
test tupl_03_zero_tree_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_ZERO32, total_leaves: 16, leaf_index: 0, path_length: 4, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.ZeroTreeId);
    assert(v.idx == 0);
}

// **TUPL-04** - duplicate tree ID rejected.
test tupl_04_duplicate_rejected {
    const ps: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 4, },
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 32, leaf_index: 1, path_length: 5, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.DuplicateTreeId);
    assert(v.idx == 1);
}

// **TUPL-05** - leaf out of range rejected.
test tupl_05_leaf_out_of_range_rejected {
    const ps: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 8, leaf_index: 10, path_length: 3, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.LeafOutOfRange);
    assert(v.idx == 0);
    assert(v.leaf == 10);
    assert(v.total == 8);
}

