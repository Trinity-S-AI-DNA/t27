module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_update_path_length_bound_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_update_path_length_bound_guard.rs
// (CR-CHAT-03 - TreeKEM update path length bound guard, Wave-144
// Lane A).
//
// The original's BTreeSet insert probe becomes a seen-before scan
// riding the shared ids32_equal; the zero-tree-id probe is its own
// record-bound scan. The leaf-index ceiling widens the u32 leaf to
// the usize total before the compare. The verdict is a named struct
// (owner decision D5): Ok first, the variants in the original's
// declaration order, every payload field kept; the same-named max of
// TooLong and TooMany lands in max_count, the TooShort floor in
// min. Rule order is the original code's, not the prose header's:
// the batch ceiling, then per path the zero tree id, the repeated
// tree id, the leaf ceiling, the length floor and the length
// ceiling.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PATH-BOUNDED

// Maximum path length.
pub const TUPL_MAX_PATH_LEN: usize = 64;

// Minimum path length.
pub const TUPL_MIN_PATH_LEN: usize = 1;

// Maximum paths per batch.
pub const TUPL_MAX_PATHS: usize = 512;

// Tree ID length.
pub const TUPL_TREE_ID_LEN: usize = 32;

// An update path length record.
pub struct UpdatePathRecord {
    tree_id: [32]u8,
    total_leaves: usize,
    leaf_index: u32,
    path_length: usize,
}

// All ways path length validation can fail, in the original's
// declaration order, with Ok first.
pub enum TuplCode {
    Ok,
    TooLong,
    TooShort,
    ZeroTreeId,
    DuplicateTreeId,
    LeafOutOfRange,
    TooMany,
}

// The verdict of the path length validation, carrying every payload
// field of every error variant.
pub struct TuplVerdict {
    code: TuplCode,
    idx: usize,
    got: usize,
    min: usize,
    max_count: usize,
    leaf: u32,
    total: usize,
}

// Whether path i's tree id is all zero - the original's compare
// against the all-zero id, answered by a scan over the fixed bytes.
pub fn tupl_tid_all_zero(ps: []const UpdatePathRecord, i: usize) -> bool {
    for k in 0..TUPL_TREE_ID_LEN {
        if (ps[i].tree_id[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether path i repeats an earlier tree id - the original's
// BTreeSet insert probe, answered by a scan over the prefix with the
// shared whole-id equality.
pub fn tupl_tid_seen_before(ps: []const UpdatePathRecord, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(ps[i].tree_id, ps[j].tree_id)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM update path length bound. Returns Ok
// only when every rule holds, checked in the original's code order:
// the batch ceiling, then per path the zero tree id, the repeated
// tree id, the leaf ceiling, the length floor and the length
// ceiling.
pub fn validate_path_length(ps: []const UpdatePathRecord) -> TuplVerdict {
    if (ps.len > TUPL_MAX_PATHS) {
        return TuplVerdict { code: TuplCode.TooMany, idx: 0, got: ps.len, min: 0, max_count: TUPL_MAX_PATHS, leaf: 0, total: 0, };
    }
    for i in 0..ps.len {
        if (tupl_tid_all_zero(ps, i)) {
            return TuplVerdict { code: TuplCode.ZeroTreeId, idx: i, got: 0, min: 0, max_count: 0, leaf: 0, total: 0, };
        }
        if (tupl_tid_seen_before(ps, i)) {
            return TuplVerdict { code: TuplCode.DuplicateTreeId, idx: i, got: 0, min: 0, max_count: 0, leaf: 0, total: 0, };
        }
        if (@as(usize, ps[i].leaf_index) >= ps[i].total_leaves) {
            return TuplVerdict { code: TuplCode.LeafOutOfRange, idx: i, got: 0, min: 0, max_count: 0, leaf: ps[i].leaf_index, total: ps[i].total_leaves, };
        }
        if (ps[i].path_length < TUPL_MIN_PATH_LEN) {
            return TuplVerdict { code: TuplCode.TooShort, idx: i, got: ps[i].path_length, min: TUPL_MIN_PATH_LEN, max_count: 0, leaf: 0, total: 0, };
        }
        if (ps[i].path_length > TUPL_MAX_PATH_LEN) {
            return TuplVerdict { code: TuplCode.TooLong, idx: i, got: ps[i].path_length, min: 0, max_count: TUPL_MAX_PATH_LEN, leaf: 0, total: 0, };
        }
    }
    return TuplVerdict { code: TuplCode.Ok, idx: 0, got: 0, min: 0, max_count: 0, leaf: 0, total: 0, };
}

