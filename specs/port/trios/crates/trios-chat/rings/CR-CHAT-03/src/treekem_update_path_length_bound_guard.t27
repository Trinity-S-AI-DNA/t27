        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: TUPL_MAX_PATH_LEN, },
    };
    const v = validate_path_length(&ps);
    assert(v.code == TuplCode.Ok);
}

