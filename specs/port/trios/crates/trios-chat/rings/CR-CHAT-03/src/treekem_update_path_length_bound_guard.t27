// The two probes have direct tests (coverage: Untested 0).
test tupl_helpers_answer {
    const ps: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_ZERO32, total_leaves: 16, leaf_index: 0, path_length: 4, },
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 4, },
    };
    assert(tupl_tid_all_zero(&ps, 0));
    assert(!tupl_tid_all_zero(&ps, 1));
    assert(!tupl_tid_seen_before(&ps, 1));
    const twin: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 4, },
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 32, leaf_index: 1, path_length: 5, },
    };
    assert(tupl_tid_seen_before(&twin, 1));
}

// Rule order is the original code's: the batch ceiling before any
// per-path rule, the zero tree id before the repeated tree id, the
// repeated tree id before the leaf ceiling, the leaf ceiling before
// the length floor, and the length floor before the length ceiling.
test rule_order_matches_original {
    const zero_after_clean: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 4, },
        UpdatePathRecord { tree_id: TUPL_ZERO32, total_leaves: 16, leaf_index: 0, path_length: 4, },
    };
    const v1 = validate_path_length(&zero_after_clean);
    assert(v1.code == TuplCode.ZeroTreeId);
    assert(v1.idx == 1);

    const dup_hides_leaf: [2]UpdatePathRecord = [2]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 4, },
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 50, path_length: 4, },
    };
    const v2 = validate_path_length(&dup_hides_leaf);
    assert(v2.code == TuplCode.DuplicateTreeId);

    const leaf_hides_floor: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 8, leaf_index: 10, path_length: 0, },
    };
    const v3 = validate_path_length(&leaf_hides_floor);
    assert(v3.code == TuplCode.LeafOutOfRange);

    const floor_hides_ceiling: [1]UpdatePathRecord = [1]UpdatePathRecord{
        UpdatePathRecord { tree_id: TUPL_TID_01, total_leaves: 16, leaf_index: 0, path_length: 0, },
    };
    const v4 = validate_path_length(&floor_hides_ceiling);
    assert(v4.code == TuplCode.TooShort);
}
