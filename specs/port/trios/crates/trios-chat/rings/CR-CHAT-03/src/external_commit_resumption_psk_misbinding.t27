module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::external_commit_resumption_psk_misbinding;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/external_commit_resumption_psk_misbinding.rs
// (CR-CHAT-03 - ExternalCommit ResumptionPSK misbinding,
// Wave-37, L-CHAT-3-ecrpm, R-CHAT-3, RFC 9420 11.2.1/15.1).
//
// A member rejoining via an external Commit must be bound
// to the epoch they left: the psk_ids list carries exactly
// one Resumption PSK whose group is the current one, whose
// epoch is the immediately prior one and whose nonce is
// the one the rejoiner declared - anything looser (no
// Resumption PSK, a spliced group, an epoch two steps
// back, an External PSK in the resumption slot) lets an
// attacker holding one historical epoch secret rejoin
// forever, past every compromise heal. The rules, in the
// original's fixed order: the canonical GroupID length
// (thirty-two), exactly one PSK in the list, the
// Resumption type, the canonical nonce length (checked
// BEFORE the content rules so a malformed nonce never
// masquerades as a content mismatch), the PSK group equal
// to the commit group, the PSK epoch equal to the local
// one, and the PSK nonce equal to the declared one.
//
// The original returns Result<(), ResumptionPskMisbindingError>.
// This port carries the verdict as a named struct (owner
// decision D5): Ok first, then the seven variants in the
// original's declaration order - NonCanonicalGroupIdLength,
// MissingResumptionPsk, NotResumptionPskType,
// ResumptionGroupIdMismatch, ResumptionEpochMismatch,
// ResumptionNonceMismatch, NonCanonicalPskNonceLength.
// Every original variant carries no payload, so the code
// is the whole verdict.
//
// The original's commit and view structs become flat
// parameters - the GroupID and the declared nonce as plain
// slices, the local epoch a scalar. The psk_ids vector
// becomes a slice of records holding the type tag, the
// thirty-two-byte group identifier, the epoch and the
// nonce with its length (the original's short-nonce
// fixture lives there). The PSK type enum becomes a plain
// kind enum in the original's declaration order, the
// content comparisons matched by one fixed-versus-slice
// helper behind a canonical length gate.

// Canonical MLS GroupID length (32 bytes).
pub const ECRPM_GROUP_ID_LEN: usize = 32;

// Canonical ResumptionPSK nonce length (32 bytes).
pub const ECRPM_PSK_NONCE_LEN: usize = 32;

// The PSK type tag - the original's PskType in declaration
// order: External first, Resumption second.
pub enum PskKind {
    External,
    Resumption,
}

// One PSK identifier: the type tag, the group it is bound
// to, the epoch it derives from and the nonce with its
// length.
pub struct PskRec {
    psk_type: PskKind,
    group_id: [32]u8,
    epoch: u64,
    psk_nonce: [32]u8,
    nonce_len: usize,
}

// Verdict codes: Ok(()) and ResumptionPskMisbindingError's variants, in declaration order.
pub enum EcrpmCode {
    Ok,
    NonCanonicalGroupIdLength,
    MissingResumptionPsk,
    NotResumptionPskType,
    ResumptionGroupIdMismatch,
    ResumptionEpochMismatch,
    ResumptionNonceMismatch,
    NonCanonicalPskNonceLength,
}

// The verdict of the resumption binding validation - the
// original's variants carry no payload, so the code alone
// carries it.
pub struct EcrpmVerdict {
    code: EcrpmCode,
}

// Whether a canonical thirty-two-byte record form equals a
// slice - the original's Vec comparisons behind the length
// rules that already guaranteed the canonical forms.
pub fn bytes32_matches(fixed: [32]u8, slice: []const u8) -> bool {
    if (slice.len != 32) {
        return false;
    }
    for i in 0..32 {
        if (fixed[i] != slice[i]) {
            return false;
        }
    }
    return true;
}

// [VERIFIED] Validate one ExternalCommit's Resumption PSK
// binding. Returns Ok only when every rule holds, checked
// in the original's fixed order: the canonical GroupID
// length, exactly one PSK, the Resumption type, the
// canonical nonce length before the content rules, the PSK
// group, the PSK epoch and the PSK nonce.
pub fn validate_external_commit_resumption_psk(group_id: []const u8, psk_ids: []const PskRec, declared_nonce: []const u8, local_epoch: u64) -> EcrpmVerdict {
    if (group_id.len != ECRPM_GROUP_ID_LEN) {
        return EcrpmVerdict { code: EcrpmCode.NonCanonicalGroupIdLength, };
    }
    if (psk_ids.len != 1) {
        return EcrpmVerdict { code: EcrpmCode.MissingResumptionPsk, };
    }
    if (psk_ids[0].psk_type != PskKind.Resumption) {
        return EcrpmVerdict { code: EcrpmCode.NotResumptionPskType, };
    }
    if (psk_ids[0].nonce_len != ECRPM_PSK_NONCE_LEN) {
        return EcrpmVerdict { code: EcrpmCode.NonCanonicalPskNonceLength, };
    }
    if (!bytes32_matches(psk_ids[0].group_id, group_id)) {
        return EcrpmVerdict { code: EcrpmCode.ResumptionGroupIdMismatch, };
    }
    if (psk_ids[0].epoch != local_epoch) {
        return EcrpmVerdict { code: EcrpmCode.ResumptionEpochMismatch, };
    }
    if (!bytes32_matches(psk_ids[0].psk_nonce, declared_nonce)) {
        return EcrpmVerdict { code: EcrpmCode.ResumptionNonceMismatch, };
    }
    return EcrpmVerdict { code: EcrpmCode.Ok, };
}

// The fixture bytes: the group of seventy-seven-hex, the
// stranger's group of eighty-eight-hex, the nonce of
// ninety-nine-hex and the stranger's nonce of
// double-A-hex.
pub const GOOD_GID: [32]u8 = [32]u8{119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119, 119,}
pub const OTHER_GID: [32]u8 = [32]u8{136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136, 136,}
pub const GOOD_NONCE: [32]u8 = [32]u8{153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153, 153,}
pub const OTHER_NONCE: [32]u8 = [32]u8{170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170,}

// **ECRPM-01** - the sixteen-byte GroupID rejected.
test ecrpm_01_short_group_id_rejected {
    var short_gid: [16]u8;
    for j in 0..16 {
        short_gid[j] = 119;
    }
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&short_gid, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.NonCanonicalGroupIdLength);
}

// **ECRPM-02** - the empty psk_ids list rejected: no
// resumption binding at all.
test ecrpm_02_empty_psk_ids_rejected {
    const empty_psks: [0]PskRec = [0]PskRec{};
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &empty_psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.MissingResumptionPsk);
}

// **ECRPM-03** - the two-entry psk_ids list rejected.
test ecrpm_03_two_psk_ids_rejected {
    const psks: [2]PskRec = [2]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.MissingResumptionPsk);
}

// **ECRPM-04** - the External PSK in the resumption slot
// rejected.
test ecrpm_04_external_psk_type_rejected {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.External, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.NotResumptionPskType);
}

// **ECRPM-05** - the PSK from another group rejected.
test ecrpm_05_group_id_mismatch_rejected {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: OTHER_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.ResumptionGroupIdMismatch);
}

// **ECRPM-06** - the PSK epoch two steps back rejected:
// ninety-eight of a local hundred.
test ecrpm_06_epoch_mismatch_rejected {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 98, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.ResumptionEpochMismatch);
}

// **ECRPM-07** - the PSK nonce mismatch rejected: the
// stranger's nonce in the PSK slot.
test ecrpm_07_nonce_mismatch_rejected {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: OTHER_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.ResumptionNonceMismatch);
}

// **ECRPM-08** - the sixteen-byte nonce rejected: the
// length rule answers before any content comparison, the
// declared nonce shortened with it exactly as the
// original's fixture does.
test ecrpm_08_short_psk_nonce_rejected {
    var short_nonce: [16]u8;
    for j in 0..16 {
        short_nonce[j] = 153;
    }
    var short_declared: [16]u8;
    for j in 0..16 {
        short_declared[j] = 153;
    }
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 16, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &short_declared, 100);
    assert(v.code == EcrpmCode.NonCanonicalPskNonceLength);
}

// **ECRPM-09** - the future epoch rejected: a hundred and
// one of a local hundred.
test ecrpm_09_future_epoch_rejected {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 101, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.ResumptionEpochMismatch);
}

// **ECRPM-10** - the canonical external Commit accepted.
test ecrpm_10_canonical_external_commit_accepted {
    const psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: GOOD_NONCE, nonce_len: 32, },
    };
    const v = validate_external_commit_resumption_psk(&GOOD_GID, &psks, &GOOD_NONCE, 100);
    assert(v.code == EcrpmCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test bytes32_matches_answers {
    assert(bytes32_matches(GOOD_GID, &GOOD_GID));
    assert(!bytes32_matches(GOOD_GID, &OTHER_GID));
    var short_slice: [16]u8;
    for j in 0..16 {
        short_slice[j] = 119;
    }
    assert(!bytes32_matches(GOOD_GID, &short_slice));
}

// Rule order is the original's fixed ladder, each probe
// stacking the earlier rule's violation on the later ones
// - with the nonce length riding between the type rule and
// the content rules: the short GroupID over everything, the
// empty list over the type, the External type over the
// content rules, the short nonce over the group and epoch
// and nonce content (the length before any content), the
// wrong group over the epoch and nonce, the wrong epoch
// over the nonce.
test rule_order_matches_original {
    const bad_psks: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.External, group_id: OTHER_GID, epoch: 98, psk_nonce: OTHER_NONCE, nonce_len: 16, },
    };
    var short_gid: [16]u8;
    for j in 0..16 {
        short_gid[j] = 119;
    }
    var short_declared: [16]u8;
    for j in 0..16 {
        short_declared[j] = 153;
    }
    const empty_psks: [0]PskRec = [0]PskRec{};

    const v1 = validate_external_commit_resumption_psk(&short_gid, &bad_psks, &short_declared, 100);
    assert(v1.code == EcrpmCode.NonCanonicalGroupIdLength);

    const v2 = validate_external_commit_resumption_psk(&GOOD_GID, &empty_psks, &GOOD_NONCE, 100);
    assert(v2.code == EcrpmCode.MissingResumptionPsk);

    const v3 = validate_external_commit_resumption_psk(&GOOD_GID, &bad_psks, &short_declared, 100);
    assert(v3.code == EcrpmCode.NotResumptionPskType);

    const v4 = validate_external_commit_resumption_psk(&GOOD_GID, &bad_psks, &short_declared, 100);
    assert(v4.code == EcrpmCode.NotResumptionPskType);

    const typed_short: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: OTHER_GID, epoch: 98, psk_nonce: OTHER_NONCE, nonce_len: 16, },
    };
    const v5 = validate_external_commit_resumption_psk(&GOOD_GID, &typed_short, &short_declared, 100);
    assert(v5.code == EcrpmCode.NonCanonicalPskNonceLength);

    const typed_full: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: OTHER_GID, epoch: 98, psk_nonce: OTHER_NONCE, nonce_len: 32, },
    };
    const v6 = validate_external_commit_resumption_psk(&GOOD_GID, &typed_full, &GOOD_NONCE, 100);
    assert(v6.code == EcrpmCode.ResumptionGroupIdMismatch);

    const good_gid_psk: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 98, psk_nonce: OTHER_NONCE, nonce_len: 32, },
    };
    const v7 = validate_external_commit_resumption_psk(&GOOD_GID, &good_gid_psk, &GOOD_NONCE, 100);
    assert(v7.code == EcrpmCode.ResumptionEpochMismatch);

    const good_epoch_psk: [1]PskRec = [1]PskRec{
        PskRec { psk_type: PskKind.Resumption, group_id: GOOD_GID, epoch: 100, psk_nonce: OTHER_NONCE, nonce_len: 32, },
    };
    const v8 = validate_external_commit_resumption_psk(&GOOD_GID, &good_epoch_psk, &GOOD_NONCE, 100);
    assert(v8.code == EcrpmCode.ResumptionNonceMismatch);
}
