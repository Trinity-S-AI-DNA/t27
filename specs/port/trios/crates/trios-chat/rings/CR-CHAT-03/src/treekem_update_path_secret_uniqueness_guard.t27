// **TPSU-01** - duplicate secret rejected.
test tpsu2_01_duplicate_secret_rejected {
    const ss: [2]PathSecretRecord = [2]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_AA, },
        PathSecretRecord { update_id: TPSU2_UID_02, node_index: 1, secret_hash: TPSU2_HASH_AA, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.DuplicateSecret);
    assert(v.idx == 1);
}

// **TPSU-02** - zero secret rejected.
test tpsu2_02_zero_secret_rejected {
    const ss: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_ZERO32, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.ZeroSecret);
    assert(v.idx == 0);
}

// **TPSU-03** - zero update ID rejected.
test tpsu2_03_zero_update_rejected {
    const ss: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_ZERO32, node_index: 0, secret_hash: TPSU2_HASH_AA, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.ZeroUpdateId);
    assert(v.idx == 0);
}

// **TPSU-04** - duplicate update ID rejected.
test tpsu2_04_duplicate_update_rejected {
    const ss: [2]PathSecretRecord = [2]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_A1, },
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 1, secret_hash: TPSU2_HASH_A2, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.DuplicateUpdateId);
    assert(v.idx == 1);
}

// **TPSU-05** - node index too high rejected.
test tpsu2_05_node_too_high_rejected {
    const ss: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: TPSU2_MAX_NODE_INDEX + 1, secret_hash: TPSU2_HASH_AA, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.NodeIndexTooHigh);
    assert(v.idx == 0);
    assert(v.got32 == TPSU2_MAX_NODE_INDEX + 1);
    assert(v.max32 == TPSU2_MAX_NODE_INDEX);
}

// **TPSU-06** - too many rejected.
test tpsu2_06_too_many_rejected {
    const v = validate_path_secret_uniqueness(&TPSU2_4097);
    assert(v.code == Tpsu2Code.TooMany);
    assert(v.got == TPSU2_MAX_SECRETS + 1);
    assert(v.max_count == TPSU2_MAX_SECRETS);
}

// **TPSU-07** - valid accepted.
test tpsu2_07_valid_accepted {
    const ss: [4]PathSecretRecord = [4]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_A1, },
        PathSecretRecord { update_id: TPSU2_UID_02, node_index: 1, secret_hash: TPSU2_HASH_A2, },
        PathSecretRecord { update_id: TPSU2_UID_03, node_index: 0, secret_hash: TPSU2_HASH_A3, },
        PathSecretRecord { update_id: TPSU2_UID_04, node_index: 1, secret_hash: TPSU2_HASH_A4, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.Ok);
}

// **TPSU-08** - empty accepted.
test tpsu2_08_empty_accepted {
    const ss: [0]PathSecretRecord = [0]PathSecretRecord{};
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.Ok);
}

// **TPSU-09** - single accepted.
test tpsu2_09_single_accepted {
    const ss: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_AA, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.Ok);
}

// **TPSU-10** - max node index accepted.
test tpsu2_10_max_node_accepted {
    const ss: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: TPSU2_MAX_NODE_INDEX, secret_hash: TPSU2_HASH_AA, },
    };
    const v = validate_path_secret_uniqueness(&ss);
    assert(v.code == Tpsu2Code.Ok);
}

// The four probes have direct tests (coverage: Untested 0).
test tpsu2_helpers_answer {
    const ss: [2]PathSecretRecord = [2]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_A1, },
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 1, secret_hash: TPSU2_HASH_A1, },
    };
    assert(!tpsu2_hash_all_zero(&ss, 0));
    assert(!tpsu2_uid_all_zero(&ss, 0));
    assert(tpsu2_uid_seen_before(&ss, 1));
    assert(!tpsu2_uid_seen_before(&ss, 0));
    assert(tpsu2_hash_seen_before(&ss, 1));
    assert(!tpsu2_hash_seen_before(&ss, 0));
    const zeroed: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_ZERO32, node_index: 0, secret_hash: TPSU2_ZERO32, },
    };
    assert(tpsu2_hash_all_zero(&zeroed, 0));
    assert(tpsu2_uid_all_zero(&zeroed, 0));
}

// Rule order is the original code's: the batch ceiling before any
// per-secret rule, the zero hash before the zero update id, the
// zero update id before the node ceiling, the node ceiling before
// the repeated update id, and the repeated update id before the
// repeated hash.
test rule_order_matches_original {
    const zero_hash_first: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_ZERO32, node_index: TPSU2_MAX_NODE_INDEX + 1, secret_hash: TPSU2_ZERO32, },
    };
    const v1 = validate_path_secret_uniqueness(&zero_hash_first);
    assert(v1.code == Tpsu2Code.ZeroSecret);

    const zero_uid_before_node: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_ZERO32, node_index: TPSU2_MAX_NODE_INDEX + 1, secret_hash: TPSU2_HASH_AA, },
    };
    const v2 = validate_path_secret_uniqueness(&zero_uid_before_node);
    assert(v2.code == Tpsu2Code.ZeroUpdateId);

    const node_before_dup_uid: [1]PathSecretRecord = [1]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: TPSU2_MAX_NODE_INDEX + 1, secret_hash: TPSU2_HASH_AA, },
    };
    const v3 = validate_path_secret_uniqueness(&node_before_dup_uid);
    assert(v3.code == Tpsu2Code.NodeIndexTooHigh);

    const dup_uid_before_dup_hash: [2]PathSecretRecord = [2]PathSecretRecord{
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 0, secret_hash: TPSU2_HASH_A1, },
        PathSecretRecord { update_id: TPSU2_UID_01, node_index: 1, secret_hash: TPSU2_HASH_A1, },
    };
    const v4 = validate_path_secret_uniqueness(&dup_uid_before_dup_hash);
    assert(v4.code == Tpsu2Code.DuplicateUpdateId);

    const ceiling_first = validate_path_secret_uniqueness(&TPSU2_4097);
    assert(ceiling_first.code == Tpsu2Code.TooMany);
}
