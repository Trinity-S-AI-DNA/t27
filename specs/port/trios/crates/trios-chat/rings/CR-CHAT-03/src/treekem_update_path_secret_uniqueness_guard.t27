module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_update_path_secret_uniqueness_guard;

use port::trios::crates::trios-chat::common::helpers;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_update_path_secret_uniqueness_guard.rs
// (CR-CHAT-03 - TreeKEM path secret uniqueness guard for update
// paths, Wave-126 Lane A). The ring already carries a
// treekem_path_secret_uniqueness_guard whose tests answer the same
// TPSU prefix, so this port reads as TPSU2 throughout.
//
// The original's two BTreeSet probes become seen-before scans
// riding the shared ids32_equal; the zero-hash and zero-update-id
// probes are their own record-bound scans. The verdict is a named
// struct (owner decision D5): Ok first, the variants in the
// original's declaration order, every payload field kept; the
// usize got/max of TooMany land in got/max_count, the u32
// got/max of NodeIndexTooHigh in got32/max32. Rule order is the
// original code's, not the prose header's: the batch ceiling, then
// per secret the zero hash (the original checks the hash before
// the update id), the zero update id, the node ceiling, the
// repeated update id and the repeated hash.
//
// Anchor: phi^2 + phi^-2 = 3 * TRINITY * CHAT * PATH-UNIQUE

// Maximum node index.
pub const TPSU2_MAX_NODE_INDEX: u32 = 65535;

// Maximum secrets per batch.
pub const TPSU2_MAX_SECRETS: usize = 4096;

// Update ID length.
pub const TPSU2_UPDATE_ID_LEN: usize = 32;

// Path secret hash length.
pub const TPSU2_HASH_LEN: usize = 32;

// A path secret record.
pub struct PathSecretRecord {
    update_id: [32]u8,
    node_index: u32,
    secret_hash: [32]u8,
}

// All ways path secret uniqueness validation can fail, in the
// original's declaration order, with Ok first.
pub enum Tpsu2Code {
    Ok,
    DuplicateSecret,
    ZeroSecret,
    ZeroUpdateId,
    DuplicateUpdateId,
    NodeIndexTooHigh,
    TooMany,
}

// The verdict of the update-path secret uniqueness validation,
// carrying every payload field of every error variant.
pub struct Tpsu2Verdict {
    code: Tpsu2Code,
    idx: usize,
    got: usize,
    max_count: usize,
    got32: u32,
    max32: u32,
}

// Whether secret i's hash is all zero - the original's compare
// against the all-zero seed, answered by a scan over the fixed
// bytes.
pub fn tpsu2_hash_all_zero(secrets: []const PathSecretRecord, i: usize) -> bool {
    for k in 0..TPSU2_HASH_LEN {
        if (secrets[i].secret_hash[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether secret i's update id is all zero - the original's compare
// against the all-zero id, answered by a scan over the fixed bytes.
pub fn tpsu2_uid_all_zero(secrets: []const PathSecretRecord, i: usize) -> bool {
    for k in 0..TPSU2_UPDATE_ID_LEN {
        if (secrets[i].update_id[k] != 0) {
            return false;
        }
    }
    return true;
}

// Whether secret i repeats an earlier update id - the original's
// BTreeSet insert probe, answered by a scan over the prefix with the
// shared whole-id equality.
pub fn tpsu2_uid_seen_before(secrets: []const PathSecretRecord, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(secrets[j].update_id, secrets[i].update_id)) {
            return true;
        }
    }
    return false;
}

// Whether secret i repeats an earlier hash - the original's second
// BTreeSet insert probe, answered by a scan over the prefix with the
// shared whole-id equality.
pub fn tpsu2_hash_seen_before(secrets: []const PathSecretRecord, i: usize) -> bool {
    for j in 0..i {
        if (ids32_equal(secrets[j].secret_hash, secrets[i].secret_hash)) {
            return true;
        }
    }
    return false;
}

// [VERIFIED] Validate TreeKEM update-path secret uniqueness.
// Returns Ok only when every rule holds, checked in the original's
// code order: the batch ceiling, then per secret the zero hash, the
// zero update id, the node ceiling, the repeated update id and the
// repeated hash.
pub fn validate_path_secret_uniqueness(secrets: []const PathSecretRecord) -> Tpsu2Verdict {
    if (secrets.len > TPSU2_MAX_SECRETS) {
        return Tpsu2Verdict { code: Tpsu2Code.TooMany, idx: 0, got: secrets.len, max_count: TPSU2_MAX_SECRETS, got32: 0, max32: 0, };
    }
    for i in 0..secrets.len {
        if (tpsu2_hash_all_zero(secrets, i)) {
            return Tpsu2Verdict { code: Tpsu2Code.ZeroSecret, idx: i, got: 0, max_count: 0, got32: 0, max32: 0, };
        }
        if (tpsu2_uid_all_zero(secrets, i)) {
            return Tpsu2Verdict { code: Tpsu2Code.ZeroUpdateId, idx: i, got: 0, max_count: 0, got32: 0, max32: 0, };
        }
        if (secrets[i].node_index > TPSU2_MAX_NODE_INDEX) {
            return Tpsu2Verdict { code: Tpsu2Code.NodeIndexTooHigh, idx: i, got: 0, max_count: 0, got32: secrets[i].node_index, max32: TPSU2_MAX_NODE_INDEX, };
        }
        if (tpsu2_uid_seen_before(secrets, i)) {
            return Tpsu2Verdict { code: Tpsu2Code.DuplicateUpdateId, idx: i, got: 0, max_count: 0, got32: 0, max32: 0, };
        }
        if (tpsu2_hash_seen_before(secrets, i)) {
            return Tpsu2Verdict { code: Tpsu2Code.DuplicateSecret, idx: i, got: 0, max_count: 0, got32: 0, max32: 0, };
        }
    }
    return Tpsu2Verdict { code: Tpsu2Code.Ok, idx: 0, got: 0, max_count: 0, got32: 0, max32: 0, };
}

