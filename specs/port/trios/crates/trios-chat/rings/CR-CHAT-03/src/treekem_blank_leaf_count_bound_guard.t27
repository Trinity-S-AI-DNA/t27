module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::treekem_blank_leaf_count_bound_guard;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/treekem_blank_leaf_count_bound_guard.rs
// (CR-CHAT-03 - TreeKEM blank leaf count bound guard, Wave-109 Lane A,
// RATCHET TREE).
//
// Blanked leaves are what a member leaves behind. Too many of them mean
// a traceable sparse tree, a resolution cost that grows with the group,
// and a blank-to-occupied ratio that leaks churn. The gate holds six
// failure modes closed, in the original's fixed order: the batch size,
// then per snapshot the minimum leaf count, the maximum leaf count, the
// power-of-two shape, the blank count not exceeding the total, and the
// blank ratio ceiling.
//
// The original returns Result<(), BlankLeafError>. This port carries the
// verdict as a named struct (owner decision D5): Ok first, then the six
// variants in the original's declaration order - TooManyBlank,
// TooFewLeaves, TooManyLeaves, NotPowerOfTwo, BlankExceedsTotal,
// TooManyTrees - with every payload field: the blank and total counts,
// the ratio numerator and denominator, the got and bound values.
//
// t27 has no bitwise operations, so the power-of-two test scans the
// eleven powers the leaf ceiling admits instead of masking a bit.

// The maximum blank leaf ratio numerator.
pub const BLCB_MAX_BLANK_NUM: usize = 1;

// The maximum blank leaf ratio denominator.
pub const BLCB_MAX_BLANK_DEN: usize = 2;

// The minimum leaves in a tree.
pub const BLCB_MIN_LEAVES: usize = 2;

// The maximum leaves in a tree.
pub const BLCB_MAX_LEAVES: usize = 1024;

// The maximum tree snapshots per batch.
pub const BLCB_MAX_TREES: usize = 256;

// The powers of two the leaf ceiling admits, smallest first.
const BLCB_POW2: [11]usize = [11]usize{1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024,};

// A tree snapshot: the total leaf count and the blank count.
pub struct TreeSnapshot {
    total_leaves: usize,
    blank_count: usize,
}

// Verdict codes: Ok(()) and BlankLeafError's variants, in declaration
// order.
pub enum BlcbCode {
    Ok,
    TooManyBlank,
    TooFewLeaves,
    TooManyLeaves,
    NotPowerOfTwo,
    BlankExceedsTotal,
    TooManyTrees,
}

// The verdict of the blank leaf count gate, with every payload field of
// the original's variants. Fields a variant does not carry stay zero.
pub struct BlcbVerdict {
    code: BlcbCode,
    blank: usize,
    total: usize,
    got: usize,
    max: usize,
    min: usize,
    max_ratio_num: usize,
    max_ratio_den: usize,
}

// Whether n is a power of two - the original's is_power_of_two, as a
// scan of the admissible powers.
pub fn blcb_is_power_of_two(n: usize) -> bool {
    for i in 0..BLCB_POW2.len {
        if (BLCB_POW2[i] == n) {
            return true;
        }
    }
    return false;
}

// The blank ceiling for a tree - the original's
// total * BLCB_MAX_BLANK_NUM / BLCB_MAX_BLANK_DEN.
pub fn blcb_max_blank(total: usize) -> usize {
    return total * BLCB_MAX_BLANK_NUM / BLCB_MAX_BLANK_DEN;
}

// [VERIFIED] Validate TreeKEM blank leaf count bounds. Returns Ok only
// when the batch size and every snapshot pass, checked in the original's
// fixed order.
pub fn check_blank_leaf_counts(trees: []const TreeSnapshot) -> BlcbVerdict {
    if (trees.len > BLCB_MAX_TREES) {
        return BlcbVerdict { code: BlcbCode.TooManyTrees, blank: 0, total: 0, got: trees.len, max: BLCB_MAX_TREES, min: 0, max_ratio_num: 0, max_ratio_den: 0, };
    }
    for i in 0..trees.len {
        if (trees[i].total_leaves < BLCB_MIN_LEAVES) {
            return BlcbVerdict { code: BlcbCode.TooFewLeaves, blank: 0, total: 0, got: trees[i].total_leaves, max: 0, min: BLCB_MIN_LEAVES, max_ratio_num: 0, max_ratio_den: 0, };
        }
        if (trees[i].total_leaves > BLCB_MAX_LEAVES) {
            return BlcbVerdict { code: BlcbCode.TooManyLeaves, blank: 0, total: 0, got: trees[i].total_leaves, max: BLCB_MAX_LEAVES, min: 0, max_ratio_num: 0, max_ratio_den: 0, };
        }
        if (!blcb_is_power_of_two(trees[i].total_leaves)) {
            return BlcbVerdict { code: BlcbCode.NotPowerOfTwo, blank: 0, total: 0, got: trees[i].total_leaves, max: 0, min: 0, max_ratio_num: 0, max_ratio_den: 0, };
        }
        if (trees[i].blank_count > trees[i].total_leaves) {
            return BlcbVerdict { code: BlcbCode.BlankExceedsTotal, blank: trees[i].blank_count, total: trees[i].total_leaves, got: 0, max: 0, min: 0, max_ratio_num: 0, max_ratio_den: 0, };
        }
        if (trees[i].blank_count > blcb_max_blank(trees[i].total_leaves)) {
            return BlcbVerdict { code: BlcbCode.TooManyBlank, blank: trees[i].blank_count, total: trees[i].total_leaves, got: 0, max: 0, min: 0, max_ratio_num: BLCB_MAX_BLANK_NUM, max_ratio_den: BLCB_MAX_BLANK_DEN, };
        }
    }
    return BlcbVerdict { code: BlcbCode.Ok, blank: 0, total: 0, got: 0, max: 0, min: 0, max_ratio_num: 0, max_ratio_den: 0, };
}

