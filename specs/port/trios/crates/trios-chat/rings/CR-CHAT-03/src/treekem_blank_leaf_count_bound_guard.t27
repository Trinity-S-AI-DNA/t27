// **BLCB-01** - too many blank leaves rejected, with the ratio payload.
test blcb_01_too_many_blank_rejected {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 8, blank_count: 5, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.TooManyBlank);
    assert(v.blank == 5);
    assert(v.total == 8);
    assert(v.max_ratio_num == 1);
    assert(v.max_ratio_den == 2);
}

// **BLCB-02** - too few leaves rejected.
test blcb_02_too_few_rejected {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 1, blank_count: 0, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.TooFewLeaves);
    assert(v.got == 1);
    assert(v.min == 2);
}

// **BLCB-03** - too many leaves rejected.
test blcb_03_too_many_leaves_rejected {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 2048, blank_count: 0, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.TooManyLeaves);
    assert(v.got == 2048);
    assert(v.max == 1024);
}

// **BLCB-04** - a non-power-of-two leaf count rejected.
test blcb_04_not_power_of_two_rejected {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 6, blank_count: 1, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.NotPowerOfTwo);
    assert(v.got == 6);
}

// **BLCB-05** - blank exceeding the total rejected.
test blcb_05_blank_exceeds_total_rejected {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 4, blank_count: 5, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.BlankExceedsTotal);
    assert(v.blank == 5);
    assert(v.total == 4);
}

// **BLCB-06** - the batch of 257 snapshots rejected by the tree ceiling.
test blcb_06_too_many_rejected {
    const v = check_blank_leaf_counts(&BLCB_257_TREES);
    assert(v.code == BlcbCode.TooManyTrees);
    assert(v.got == BLCB_MAX_TREES + 1);
    assert(v.max == BLCB_MAX_TREES);
}

// **BLCB-07** - a valid batch accepted.
test blcb_07_valid_accepted {
    const trees: [3]TreeSnapshot = [3]TreeSnapshot{
        TreeSnapshot { total_leaves: 8, blank_count: 2, },
        TreeSnapshot { total_leaves: 16, blank_count: 5, },
        TreeSnapshot { total_leaves: 32, blank_count: 10, },
    };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.Ok);
}

// **BLCB-08** - an empty batch accepted.
test blcb_08_empty_accepted {
    const trees: [0]TreeSnapshot = [0]TreeSnapshot{};
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.Ok);
}

// **BLCB-09** - zero blank leaves accepted.
test blcb_09_zero_blank_accepted {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 8, blank_count: 0, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.Ok);
}

// **BLCB-10** - the exact ratio boundary accepted.
test blcb_10_boundary_accepted {
    const trees: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 8, blank_count: 4, }, };
    const v = check_blank_leaf_counts(&trees);
    assert(v.code == BlcbCode.Ok);
}

// The helpers have direct tests (coverage: Untested 0).
test blcb_is_power_of_two_answers {
    assert(blcb_is_power_of_two(1));
    assert(blcb_is_power_of_two(2));
    assert(blcb_is_power_of_two(1024));
    assert(!blcb_is_power_of_two(0));
    assert(!blcb_is_power_of_two(6));
    assert(!blcb_is_power_of_two(2048));
}

test blcb_max_blank_answers {
    assert(blcb_max_blank(8) == 4);
    assert(blcb_max_blank(16) == 8);
    assert(blcb_max_blank(2) == 1);
}

// Rule order is the original's ladder: the batch ceiling over every
// per-snapshot rule, the minimum and maximum leaf rules over the
// power-of-two rule, that rule over the blank-exceeds-total rule, and
// the exceed rule over the ratio ceiling.
test rule_order_matches_original {
    const one: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 1, blank_count: 0, }, };
    assert(check_blank_leaf_counts(&one).code == BlcbCode.TooFewLeaves);

    const huge: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 2048, blank_count: 5000, }, };
    assert(check_blank_leaf_counts(&huge).code == BlcbCode.TooManyLeaves);

    const six: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 6, blank_count: 10, }, };
    assert(check_blank_leaf_counts(&six).code == BlcbCode.NotPowerOfTwo);

    const over: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 4, blank_count: 5, }, };
    assert(check_blank_leaf_counts(&over).code == BlcbCode.BlankExceedsTotal);

    const full: [1]TreeSnapshot = [1]TreeSnapshot{ TreeSnapshot { total_leaves: 8, blank_count: 8, }, };
    assert(check_blank_leaf_counts(&full).code == BlcbCode.TooManyBlank);
}
