module port::trios::crates::trios-chat::rings::CR-CHAT-03::src::proposal_validation;

// Port of gHashTag/trios crates/trios-chat/rings/CR-CHAT-03/src/proposal_validation.rs
// (CR-CHAT-03 - MLS Proposal validation, Wave-22 Lane A,
// L-CHAT-3-pv).
//
// A commit references a bundle of proposals, and the
// verifier reads the bundle as a whole before a single
// byte reaches the tree: empty bundles are no-op
// tombstones an adversary splices into a transcript to
// force a useless epoch advance; oversized bundles are a
// denial-of-service vector (every proposal forces a tree
// mutation, the cap at thirty-two); non-monotonic
// indices produce different state on different peers;
// duplicate (kind, target) pairs confuse the tree diff;
// and a lone Remove of the committer's own leaf leaves
// the group with zero live members. The rules, in the
// original's fixed order: the bundle non-empty, the size
// cap, the strictly increasing indices over consecutive
// entries, the fresh (kind, target) pairs, and the
// degenerate single-entry self-removal.
//
// The original returns Result<(), ProposalValidationError>.
// This port carries the verdict as a named struct (owner
// decision D5): Ok first, then the five variants in the
// original's declaration order - Empty, Oversized,
// NonMonotonicIndex, DuplicateEntry, SelfRemoveOnly.
// Every original variant carries no payload, so the code
// is the whole verdict.
//
// The original's bundle struct becomes flat parameters -
// the committer leaf a scalar, the entries a slice of
// records. The index and target widen from u32 to usize -
// t27's loop counters are usize and every fixture value
// fits both. The original's BTreeSet of (kind, target)
// keys becomes a scan over the entries already visited;
// the windows(2) walk becomes a predecessor comparison.

// Maximum number of proposals referenced by a single
// commit.
pub const MAX_PROPOSALS_PER_COMMIT: usize = 32;

// The membership operation kind - the original's
// ProposalKind in declaration order.
pub enum Kind {
    Add,
    Remove,
    Update,
}

// One entry inside a proposal bundle.
pub struct ProposalRec {
    index: usize,
    kind: Kind,
    target: usize,
}

// Verdict codes: Ok(()) and ProposalValidationError's variants, in declaration order.
pub enum PvCode {
    Ok,
    Empty,
    Oversized,
    NonMonotonicIndex,
    DuplicateEntry,
    SelfRemoveOnly,
}

// The verdict of the bundle validation - the original's
// variants carry no payload, so the code alone carries it.
pub struct PvVerdict {
    code: PvCode,
}

// Whether two entries claim the same (kind, target) pair -
// the original's BTreeSet insert probe key.
pub fn entries_clash(a: ProposalRec, b: ProposalRec) -> bool {
    if (a.kind != b.kind) {
        return false;
    }
    return a.target == b.target;
}

// [VERIFIED] Validate a proposal bundle. Returns Ok only
// when every rule holds, checked in the original's fixed
// order: the non-empty bundle, the size cap, the strictly
// increasing indices, the fresh pairs and the degenerate
// self-removal.
pub fn validate_bundle(committer_leaf: usize, entries: []const ProposalRec) -> PvVerdict {
    if (entries.len == 0) {
        return PvVerdict { code: PvCode.Empty, };
    }
    if (entries.len > MAX_PROPOSALS_PER_COMMIT) {
        return PvVerdict { code: PvCode.Oversized, };
    }
    for i in 1..entries.len {
        if (entries[i].index <= entries[i - 1].index) {
            return PvVerdict { code: PvCode.NonMonotonicIndex, };
        }
    }
    for i in 0..entries.len {
        for j in 0..i {
            if (entries_clash(entries[j], entries[i])) {
                return PvVerdict { code: PvCode.DuplicateEntry, };
            }
        }
    }
    if (entries.len == 1) {
        if (entries[0].kind == Kind.Remove) {
            if (entries[0].target == committer_leaf) {
                return PvVerdict { code: PvCode.SelfRemoveOnly, };
            }
        }
    }
    return PvVerdict { code: PvCode.Ok, };
}

// **PV-01** - a bundle of one legitimate Add accepted.
test pv_01_single_add_accepted {
    const entries: [1]ProposalRec = [1]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
    };
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.Ok);
}

// **PV-02** - the empty bundle rejected.
test pv_02_empty_rejected {
    const entries: [0]ProposalRec = [0]ProposalRec{};
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.Empty);
}

// **PV-03** - the oversized bundle rejected: thirty-three
// of a cap of thirty-two, built in a loop like the
// original's.
test pv_03_oversized_rejected {
    var entries: [33]ProposalRec;
    for i in 0..33 {
        entries[i] = ProposalRec { index: i, kind: Kind.Add, target: i + 100, };
    }
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.Oversized);
}

// **PV-04** - the bundle at exactly the cap accepted - the
// boundary is strict, thirty-two passes.
test pv_04_at_cap_accepted {
    var entries: [32]ProposalRec;
    for i in 0..32 {
        entries[i] = ProposalRec { index: i, kind: Kind.Add, target: i + 100, };
    }
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.Ok);
}

// **PV-05** - the non-monotonic indices rejected: zero,
// two, one.
test pv_05_non_monotonic_index_rejected {
    const entries: [3]ProposalRec = [3]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
        ProposalRec { index: 2, kind: Kind.Add, target: 8, },
        ProposalRec { index: 1, kind: Kind.Add, target: 9, },
    };
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.NonMonotonicIndex);
}

// **PV-06** - the equal indices rejected: the walk is
// strict, not weak.
test pv_06_equal_index_rejected {
    const entries: [2]ProposalRec = [2]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
        ProposalRec { index: 0, kind: Kind.Add, target: 8, },
    };
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.NonMonotonicIndex);
}

// **PV-07** - the duplicate (kind, target) pair rejected
// even under strictly increasing indices: two Adds of
// leaf forty-two.
test pv_07_duplicate_entry_rejected {
    const entries: [2]ProposalRec = [2]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 42, },
        ProposalRec { index: 1, kind: Kind.Add, target: 42, },
    };
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.DuplicateEntry);
}

// **PV-08** - the single-entry self-removal rejected: the
// committer removing only itself leaves the group empty.
test pv_08_self_remove_only_rejected {
    const entries: [1]ProposalRec = [1]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Remove, target: 5, },
    };
    const v = validate_bundle(5, &entries);
    assert(v.code == PvCode.SelfRemoveOnly);
}

// **PV-09** - the self-removal riding with other proposals
// accepted: the rule fires only on the degenerate
// single-entry case.
test pv_09_self_remove_with_others_accepted {
    const entries: [2]ProposalRec = [2]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 9, },
        ProposalRec { index: 1, kind: Kind.Remove, target: 5, },
    };
    const v = validate_bundle(5, &entries);
    assert(v.code == PvCode.Ok);
}

// **PV-10** - the mixed Add, Update and Remove bundle with
// strictly increasing indices and fresh pairs accepted.
test pv_10_mixed_kinds_accepted {
    const entries: [3]ProposalRec = [3]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
        ProposalRec { index: 1, kind: Kind.Update, target: 0, },
        ProposalRec { index: 2, kind: Kind.Remove, target: 3, },
    };
    const v = validate_bundle(0, &entries);
    assert(v.code == PvCode.Ok);
}

// The helper has a direct test (coverage: Untested 0).
test entries_clash_answers {
    const add7 = ProposalRec { index: 0, kind: Kind.Add, target: 7, };
    const add7b = ProposalRec { index: 9, kind: Kind.Add, target: 7, };
    const upd7 = ProposalRec { index: 9, kind: Kind.Update, target: 7, };
    const add8 = ProposalRec { index: 9, kind: Kind.Add, target: 8, };
    assert(entries_clash(add7, add7b));
    assert(!entries_clash(add7, upd7));
    assert(!entries_clash(add7, add8));
}

// Rule order is the original's fixed ladder: the
// emptiness over the size, the size over the index walk,
// the index walk over the duplicate probe, and the
// duplicate probe over the self-removal - a two-entry
// bundle with a duplicated pair answers the duplicate
// rule, the self-removal answering only on the
// degenerate single entry.
test rule_order_matches_original {
    const entries: [0]ProposalRec = [0]ProposalRec{};
    const v1 = validate_bundle(0, &entries);
    assert(v1.code == PvCode.Empty);

    var flooded: [33]ProposalRec;
    for i in 0..33 {
        flooded[i] = ProposalRec { index: 0, kind: Kind.Add, target: 0, };
    }
    const v2 = validate_bundle(0, &flooded);
    assert(v2.code == PvCode.Oversized);

    const flat: [2]ProposalRec = [2]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
        ProposalRec { index: 0, kind: Kind.Add, target: 7, },
    };
    const v3 = validate_bundle(0, &flat);
    assert(v3.code == PvCode.NonMonotonicIndex);

    const dup_pair: [2]ProposalRec = [2]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Add, target: 42, },
        ProposalRec { index: 1, kind: Kind.Add, target: 42, },
    };
    const v4 = validate_bundle(0, &dup_pair);
    assert(v4.code == PvCode.DuplicateEntry);

    const self_only: [1]ProposalRec = [1]ProposalRec{
        ProposalRec { index: 0, kind: Kind.Remove, target: 5, },
    };
    const v5 = validate_bundle(5, &self_only);
    assert(v5.code == PvCode.SelfRemoveOnly);
}
