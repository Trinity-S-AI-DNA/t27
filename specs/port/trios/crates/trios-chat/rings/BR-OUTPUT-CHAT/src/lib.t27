/// Format timestamp for display.
fn format_timestamp(state: *DisplayState, timestamp: entities.MessageTimestamp) ![]const u8 {
    // Implementation would format timestamp according to locale
    const buffer = try state.allocator.alloc(u8, 32);
    const len = std.fmt.bufPrint(buffer, "{d}", .{timestamp}) catch return error.OutOfMemory;
    return buffer[0..len];
}

/// Get message status style.
fn get_message_status_style(envelope: *const entities.ChatEnvelope) StatusStyle {
    // Implementation would determine status style based on message properties
    return .Default;
}

/// Determine if notification should be shown.
fn should_show_notification(state: *DisplayState, envelope: *const entities.ChatEnvelope) bool {
    // Implementation would determine notification settings based on user preferences
    return true;
}

/// Get notification type for message.
fn get_notification_type(state: *DisplayState, envelope: *const entities.ChatEnvelope) NotificationType {
    // Implementation would determine notification type based on message properties
    return .NewMessage;
}

/// Create a notification.
pub fn create_notification(
    state: *DisplayState,
    notification_type: NotificationType,
    title: []const u8,
    message: []const u8,
    message_id: ?[u8; 32],
) ![u8; 32] {
    const id = generate_notification_id();
    const notification = Notification{
        .id = id,
        .notification_type = notification_type,
        .message_id = message_id,
        .title = try state.allocator.dupe(u8, title),
        .message = try state.allocator.dupe(u8, message),
        .timestamp = entities.get_timestamp(),
        .priority = get_notification_priority(notification_type),
        .actions = std.ArrayList([]const u8).init(state.allocator),
    };
    
    try state.pending_notifications.append(notification);
    
    return id;
}

/// Generate notification ID.
fn generate_notification_id() [u8; 32] {
    var id: [u8; 32] = undefined;
    std.crypto.random.bytes(&id);
    return id;
}

/// Get notification priority.
fn get_notification_priority(notification_type: NotificationType) u32 {
    const priorities = [_]u32{
        1, // NewMessage
        2, // MessageDelivered
        3, // MessageRead
        4, // Error
        5, // System
    };
    
    const index = @intFromEnum(notification_type);
    return priorities[index];
}

/// Show all pending notifications.
pub fn show_notifications(state: *DisplayState) !void {
    for (state.pending_notifications.items) |notification| {
        try show_single_notification(state, &notification);
    }
    
    // Clear pending notifications
    state.pending_notifications.clearRetainingCapacity();
}

/// Show a single notification.
fn show_single_notification(state: *DisplayState, notification: *const Notification) !void {
    if (state.notification_config.enable_desktop) {
        try show_desktop_notification(state, notification);
    }
    
    if (state.notification_config.enable_sound) {
        try play_notification_sound(state, notification);
    }
    
    if (state.notification_config.enable_badge) {
        try update_notification_badge(state, notification);
    }
}

/// Show desktop notification.
fn show_desktop_notification(state: *DisplayState, notification: *const Notification) !void {
    // Implementation would show desktop notification
    std.debug.print("Desktop notification: {s} - {s}\n", .{notification.title, notification.message});
}

/// Play notification sound.
fn play_notification_sound(state: *DisplayState, notification: *const Notification) !void {
    // Implementation would play notification sound
    std.debug.print("Playing notification sound: {s}\n", .{state.notification_config.sound_file});
}

/// Update notification badge.
fn update_notification_badge(state: *DisplayState, notification: *const Notification) !void {
    // Implementation would update notification badge
    std.debug.print("Updating notification badge\n", .{});
}

/// Get message display by ID.
pub fn get_message_display(state: *DisplayState, message_id: [u8; 32]) ?*MessageDisplay {
    return state.message_displays.getPtr(message_id);
}

/// Update message status.
pub fn update_message_status(state: *DisplayState, message_id: [u8; 32], new_status: StatusStyle) !void {
    if (state.message_displays.getPtr(message_id)) |display| {
        display.status = new_status;
        
        // Create notification if status changed
        if (new_status == .Error) {
            _ = try create_notification(state, .Error, "Message Error", "A message failed to deliver", message_id);
        }
    }
}

/// Get display statistics.
pub fn get_display_stats(state: *DisplayState) struct {
    total_messages: usize,
    pending_notifications: usize,
    display_history_size: usize,
} {
    return .{
        .total_messages = state.message_displays.count(),
        .pending_notifications = state.pending_notifications.items.len,
        .display_history_size = state.display_history.items.len,
    };
}