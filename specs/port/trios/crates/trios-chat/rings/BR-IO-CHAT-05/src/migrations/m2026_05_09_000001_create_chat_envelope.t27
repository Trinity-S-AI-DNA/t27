/// Rollback the migration.
pub fn rollback(allocator: *std.mem.Allocator, connection: *anyopaque) !void {
    // Drop the tables in reverse order of creation
    const rollback_sql = &[_][]const u8{
        "DROP TABLE IF EXISTS message_metadata CASCADE;",
        "DROP TABLE IF EXISTS encryption_keys CASCADE;",
        "DROP TABLE IF EXISTS chat_envelopes CASCADE;",
    };
    
    for (rollback_sql) |sql| {
        try execute_sql(connection, sql);
    }
}

