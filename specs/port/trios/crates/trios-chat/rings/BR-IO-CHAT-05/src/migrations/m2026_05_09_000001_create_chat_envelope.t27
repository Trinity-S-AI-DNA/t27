//! # BR-IO-CHAT-05 — Migration 000001: Create chat envelope table (Wave-6)
//!
//! MIGRATION — Database schema for chat envelope storage, R-IO-CHAT-5.
//!
//! Creates the fundamental database table for storing chat envelopes with
//! end-to-end encryption support. Implements proper indexing for efficient
//! message retrieval and delivery tracking.
//!
//! 1. Chat envelope table creation
//! 2. Proper indexing for performance
//! 3. Encryption key management setup
//! 4. Message status tracking columns
//! 5. Forward secrecy support columns
//!
//! Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · MIGRATION`

const std = @import("std");

/// Migration name and version.
pub const MIGRATION_NAME = "create_chat_envelope_table";
pub const MIGRATION_VERSION = 1;

/// Chat envelope database table schema.
pub const TABLE_SCHEMA = 
    \\CREATE TABLE chat_envelopes (
    \\    id BYTEA PRIMARY KEY,
    \\    sender_id BYTEA NOT NULL,
    \\    recipient_id BYTEA NOT NULL,
    \\    sequence BIGINT NOT NULL,
    \\    timestamp BIGINT NOT NULL,
    \\    payload BYTEA NOT NULL,
    \\    signature BYTEA NOT NULL,
    \\    status VARCHAR(20) NOT NULL DEFAULT 'queued',
    \\    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    \\    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    \\    delivered_at TIMESTAMP,
    \\    read_at TIMESTAMP,
    \\    attempts INTEGER NOT NULL DEFAULT 0,
    \\    error_message TEXT,
    \\    encryption_key_id BYTEA,
    \\    forward_seal BYTEA
    \\);
;

/// Index definitions for performance.
pub const INDEX_DEFINITIONS = &[_][]const u8{
    "CREATE INDEX idx_chat_envelopes_sender ON chat_envelopes (sender_id);",
    "CREATE INDEX idx_chat_envelopes_recipient ON chat_envelopes (recipient_id);",
    "CREATE INDEX idx_chat_envelopes_timestamp ON chat_envelopes (timestamp);",
    "CREATE INDEX idx_chat_envelopes_status ON chat_envelopes (status);",
    "CREATE INDEX idx_chat_envelopes_sequence ON chat_envelopes (sender_id, sequence);",
    "CREATE INDEX idx_chat_envelopes_created_at ON chat_envelopes (created_at);",
};

/// Constraint definitions for data integrity.
pub const CONSTRAINT_DEFINITIONS = &[_][]const u8{
    "ALTER TABLE chat_envelopes ADD CONSTRAINT chk_payload_size CHECK (length(payload) <= 16384);",
    "ALTER TABLE chat_envelopes ADD CONSTRAINT chk_attempts_non_negative CHECK (attempts >= 0);",
    "ALTER TABLE chat_envelopes ADD CONSTRAINT chk_status_valid CHECK (status IN ('queued', 'in_transit', 'delivered', 'read', 'failed', 'cancelled'));",
};

/// Execute the migration.
pub fn execute(allocator: *std.mem.Allocator, connection: *anyopaque) !void {
    // Create the main table
    try execute_sql(connection, TABLE_SCHEMA);
    
    // Create indexes for performance
    for (INDEX_DEFINITIONS) |index_sql| {
        try execute_sql(connection, index_sql);
    }
    
    // Add constraints for data integrity
    for (CONSTRAINT_DEFINITIONS) |constraint_sql| {
        try execute_sql(connection, constraint_sql);
    }
    
    // Create encryption key management table
    try create_encryption_keys_table(connection);
    
    // Create message metadata table
    try create_message_metadata_table(connection);
}

/// Create encryption keys table.
fn create_encryption_keys_table(connection: *anyopaque) !void {
    const sql = 
        \\CREATE TABLE encryption_keys (
        \\    key_id BYTEA PRIMARY KEY,
        \\    participant_id BYTEA NOT NULL,
        \\    key_version INTEGER NOT NULL,
        \\    key_data BYTEA NOT NULL,
        \\    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
        \\    expires_at TIMESTAMP,
        \\    is_active BOOLEAN NOT NULL DEFAULT true,
        \\    FOREIGN KEY (participant_id) REFERENCES chat_envelopes(sender_id)
        \\);
    ;
    try execute_sql(connection, sql);
    
    // Create indexes for encryption keys
    const indexes = &[_][]const u8{
        "CREATE INDEX idx_encryption_keys_participant ON encryption_keys (participant_id);",
        "CREATE INDEX idx_encryption_keys_active ON encryption_keys (participant_id, is_active);",
        "CREATE INDEX idx_encryption_keys_expires ON encryption_keys (expires_at);",
    };
    
    for (indexes) |index_sql| {
        try execute_sql(connection, index_sql);
    }
}

/// Create message metadata table.
fn create_message_metadata_table(connection: *anyopaque) !void {
    const sql = 
        \\CREATE TABLE message_metadata (
        \\    message_id BYTEA PRIMARY KEY,
        \\    envelope_id BYTEA NOT NULL,
        \\    status VARCHAR(20) NOT NULL,
        \\    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
        \\    delivered_at TIMESTAMP,
        \\    read_at TIMESTAMP,
        \\    delivery_attempts INTEGER NOT NULL DEFAULT 0,
        \\    last_error TEXT,
        \\    FOREIGN KEY (envelope_id) REFERENCES chat_envelopes(id)
        \\);
    ;
    try execute_sql(connection, sql);
    
    // Create indexes for message metadata
    const indexes = &[_][]const u8{
        "CREATE INDEX idx_message_metadata_status ON message_metadata (status);",
        "CREATE INDEX idx_message_metadata_created ON message_metadata (created_at);",
    };
    
    for (indexes) |index_sql| {
        try execute_sql(connection, index_sql);
    }
}

