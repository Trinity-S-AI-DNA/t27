//! # BR-IO-CHAT-05 — Chat entities module (Wave-6)
//!
//! ENTITIES — fundamental chat data structures for secure communication, R-IO-CHAT-5.
//!
//! Provides core data structures for chat envelopes, message handling, and
//! participant management. Implements the fundamental building blocks for
//! end-to-end encrypted messaging.
//!
//! 1. Chat envelope structure and validation
//! 2. Message participant management
//! 3. Sequence and timestamp handling
//! 4. Cryptographic container abstractions
//!
//! Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · ENTITIES`

const std = @import("std");

pub const ChatEnvelope = @import("chat_envelope").ChatEnvelope;
pub const EnvelopeError = @import("chat_envelope").EnvelopeError;
pub const SequenceNumber = @import("chat_envelope").SequenceNumber;
pub const MessageTimestamp = @import("chat_envelope").MessageTimestamp;
pub const MAX_ENVELOPE_SIZE = @import("chat_envelope").MAX_ENVELOPE_SIZE;

/// Participant identifier type.
pub type ParticipantId = [u8; 32];

/// Chat message status enumeration.
pub enum MessageStatus {
    /// Message is queued for delivery.
    Queued,
    /// Message is in transit.
    InTransit,
    /// Message has been delivered.
    Delivered,
    /// Message has been read by recipient.
    Read,
    /// Message delivery failed.
    Failed,
    /// Message was cancelled.
    Cancelled,
}

/// Chat message metadata.
pub struct MessageMetadata {
    /// Unique message identifier.
    pub message_id: [u8; 32],
    
    /// Status of the message.
    pub status: MessageStatus,
    
    /// Delivery timestamp.
    pub delivered_at: ?MessageTimestamp,
    
    /// Read timestamp.
    pub read_at: ?MessageTimestamp,
    
    /// Number of delivery attempts.
    pub attempts: u32,
}

