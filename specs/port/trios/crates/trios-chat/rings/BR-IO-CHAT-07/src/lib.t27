//! # BR-IO-CHAT-07 — Chat input/output ring (Wave-6, T-PORT)
//!
//! BR-IO-CHAT-07 — Enhanced chat I/O with message routing and delivery, R-IO-CHAT-7.
//!
//! Provides advanced chat input/output capabilities including message routing,
//! delivery confirmation, read receipts, and offline message handling.
//! Implements robust communication patterns with error recovery.
//!
//! 1. Message routing and delivery
//! 2. Offline message handling
//! 3. Delivery confirmations and read receipts
//! 4. Error recovery and retry logic
//! 5. Message priority and ordering
//!
//! Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · IO-ENHANCED`

const std = @import("std");
const entities = @import("../BR-IO-CHAT-05/src/entities").entities;
const store = @import("../BR-IO-CHAT-05/src/store").Storage;

/// Message priority levels.
pub const MessagePriority = enum {
    /// Low priority messages.
    Low,
    /// Normal priority messages.
    Normal,
    /// High priority messages.
    High,
    /// Urgent priority messages.
    Urgent,
};

/// Delivery confirmation types.
pub const DeliveryConfirmation = enum {
    /// No confirmation required.
    None,
    /// Basic delivery confirmation.
    Delivery,
    /// Read receipt required.
    ReadReceipt,
    /// Both delivery and read confirmation.
    Full,
};

/// Enhanced chat message.
pub struct EnhancedMessage {
    /// Basic envelope information.
    pub envelope: entities.ChatEnvelope,
    
    /// Message priority.
    pub priority: MessagePriority,
    
    /// Delivery confirmation type.
    pub confirmation: DeliveryConfirmation,
    
    /// Expiration timestamp.
    pub expires_at: ?entities.MessageTimestamp,
    
    /// Retry count.
    pub retry_count: u32,
    
    /// Maximum retry attempts.
    pub max_retries: u32,
    
    /// Message tags for routing.
    pub tags: std.ArrayList([]const u8),
    
    /// Message metadata.
    pub metadata: std.StringHashMap([]const u8),
};

/// Message routing configuration.
pub const RoutingConfig = struct {
    /// Enable message routing.
    enable_routing: bool = true,
    
    /// Maximum hop count for messages.
    max_hops: u32 = 5,
    
    /// Enable offline message delivery.
    enable_offline: bool = true,
    
    /// Offline message timeout.
    offline_timeout_ms: u64 = 300000, // 5 minutes
    
    /// Enable message priority handling.
    enable_priority: bool = true,
    
    /// Enable delivery confirmations.
    enable_confirmations: bool = true,
};

/// Chat I/O ring state.
pub const State = struct {
    /// Storage backend.
    storage: *store.Storage,
    
    /// Routing configuration.
    routing_config: RoutingConfig,
    
    /// Active message queue.
    message_queue: std.PriorityQueue(*EnhancedMessage, void, MessageComparator),
    
    /// Pending confirmations.
    pending_confirmations: std.AutoHashMap([u8; 32], ConfirmationTracker),
    
    /// Offline message storage.
    offline_messages: std.ArrayList(*EnhancedMessage),
    
    /// Memory allocator.
    allocator: *std.mem.Allocator,
    
    /// Message ID counter.
    message_counter: u64,
};

/// Confirmation tracking.
pub const ConfirmationTracker = struct {
    /// Message ID.
    message_id: [u8; 32],
    
    /// Confirmation type.
    confirmation_type: DeliveryConfirmation,
    
    /// Timestamp when sent.
    sent_at: entities.MessageTimestamp,
    
    /// Retry count.
    retry_count: u32,
    
    /// Last error.
    last_error: ?[]const u8,
};

/// Message comparator for priority queue.
const MessageComparator = struct {
    pub fn lessThan(_: void, a: *const EnhancedMessage, b: *const EnhancedMessage) bool {
        // Higher priority messages come first
        const priority_order = [_]MessagePriority{
            .Urgent,
            .High,
            .Normal,
            .Low,
        };
        
        const a_priority = std.mem.indexOfScalar(MessagePriority, &priority_order, a.priority).?;
        const b_priority = std.mem.indexOfScalar(MessagePriority, &priority_order, b.priority).?;
        
        if (a_priority != b_priority) {
            return a_priority < b_priority;
        }
        
        // If same priority, older messages come first
        return a.envelope.timestamp < b.envelope.timestamp;
    }
};

/// Initialize the chat I/O ring.
pub fn init(
    allocator: *std.mem.Allocator,
    storage: *store.Storage,
    routing_config: RoutingConfig,
) !*State {
    const state = try allocator.create(State);
    state.* = State{
        .storage = storage,
        .routing_config = routing_config,
        .message_queue = std.PriorityQueue(*EnhancedMessage, void, MessageComparator).init(allocator),
        .pending_confirmations = std.AutoHashMap([u8; 32], ConfirmationTracker).init(allocator),
        .offline_messages = std.ArrayList(*EnhancedMessage).init(allocator),
        .allocator = allocator,
        .message_counter = 0,
    };
    
    return state;
}

/// Cleanup the chat I/O ring.
pub fn cleanup(state: *State) void {
    state.message_queue.deinit();
    state.pending_confirmations.deinit();
    state.offline_messages.deinit();
    state.allocator.destroy(state);
}

/// Create an enhanced message.
pub fn create_enhanced_message(
    state: *State,
    sender_id: entities.ParticipantId,
    recipient_id: entities.ParticipantId,
    payload: []const u8,
    priority: MessagePriority,
    confirmation: DeliveryConfirmation,
) !*EnhancedMessage {
    const envelope = entities.create_envelope(sender_id, recipient_id, state.message_counter, payload);
    state.message_counter += 1;
    
    const message = try state.allocator.create(EnhancedMessage);
    message.* = EnhancedMessage{
        .envelope = envelope,
        .priority = priority,
        .confirmation = confirmation,
        .expires_at = null,
        .retry_count = 0,
        .max_retries = 3,
        .tags = std.ArrayList([]const u8).init(state.allocator),
        .metadata = std.StringHashMap([]const u8).init(state.allocator),
    };
    
    return message;
}

/// Send a message.
pub fn send_message(state: *State, message: *EnhancedMessage) !void {
    // Store the message
    try state.storage.store_envelope(&message.envelope);
    
    // Add to message queue if routing is enabled
    if (state.routing_config.enable_routing) {
        try state.message_queue.add(message);
    }
    
    // Handle confirmations
    if (state.routing_config.enable_confirmations and message.confirmation != .None) {
        const tracker = ConfirmationTracker{
            .message_id = message.envelope.id,
            .confirmation_type = message.confirmation,
            .sent_at = entities.get_timestamp(),
            .retry_count = 0,
            .last_error = null,
        };
        try state.pending_confirmations.put(message.envelope.id, tracker);
    }
    
    // Handle offline messages
    if (state.routing_config.enable_offline) {
        try state.offline_messages.append(message);
    }
}

/// Process the message queue.
pub fn process_queue(state: *State) !void {
    while (state.message_queue.peek()) |message| {
        // Check if message has expired
        if (message.expires_at) |expires| {
            if (entities.get_timestamp() > expires) {
                _ = state.message_queue.pop(); // Remove expired message
                continue;
            }
        }
        
        // Check retry count
        if (message.retry_count >= message.max_retries) {
            _ = state.message_queue.pop(); // Remove max retry message
            continue;
        }
        
        // Attempt to deliver the message
        const delivery_result = deliver_message(state, message);
        if (delivery_result) {
            // Message delivered successfully
            _ = state.message_queue.pop(); // Remove from queue
            
            // Handle confirmations
            if (state.routing_config.enable_confirmations) {
                try handle_confirmation(state, message);
            }
        } else {
            // Delivery failed, increment retry count
            message.retry_count += 1;
            
            // If max retries reached, remove from queue
            if (message.retry_count >= message.max_retries) {
                _ = state.message_queue.pop();
            }
        }
    }
}

/// Deliver a message (mock implementation).
fn deliver_message(state: *State, message: *EnhancedMessage) bool {
    // Implementation would handle actual message delivery
    // For demonstration, simulate occasional failures
    const random_failure = @as(f64, @floatFromInt(std.crypto.random.int(u32))) / std.math.maxInt(u32);
    
    // 90% success rate
    return random_failure > 0.1;
}

/// Handle message confirmations.
fn handle_confirmation(state: *State, message: *EnhancedMessage) !void {
    if (state.pending_confirmations.getPtr(message.envelope.id)) |tracker| {
        // Check if confirmation is required
        switch (tracker.confirmation_type) {
            .None => {},
            .Delivery => {
                // Mark as delivered
                try state.storage.update_message_status(message.envelope.id, entities.MessageStatus.Delivered);
            },
            .ReadReceipt => {
                // Wait for read receipt
                // Implementation would track read status
            },
            .Full => {
                // Mark as delivered and wait for read receipt
                try state.storage.update_message_status(message.envelope.id, entities.MessageStatus.Delivered);
                // Implementation would track read status
            },
        }
        
        // Remove from pending confirmations
        _ = state.pending_confirmations.remove(message.envelope.id);
    }
}

/// Process offline messages.
pub fn process_offline_messages(state: *State) !void {
    var i: usize = 0;
    while (i < state.offline_messages.items.len) {
        const message = state.offline_messages.items[i];
        
        // Check if offline timeout has expired
        if (entities.get_timestamp() > message.envelope.timestamp + state.routing_config.offline_timeout_ms) {
            // Remove expired offline message
            _ = state.offline_messages.swapRemove(i);
            state.allocator.destroy(message);
        } else {
            // Try to deliver the message
            const delivery_result = deliver_message(state, message);
            if (delivery_result) {
                // Message delivered successfully
                _ = state.offline_messages.swapRemove(i);
                state.allocator.destroy(message);
            } else {
                // Delivery failed, keep for retry
                i += 1;
            }
        }
    }
}

/// Get message status.
pub fn get_message_status(state: *State, message_id: [u8; 32]) ?entities.MessageStatus {
    return state.storage.get_message_status(message_id);
}

/// Cancel a message.
pub fn cancel_message(state: *State, message_id: [u8; 32]) !void {
    // Remove from message queue
    var it = state.message_queue.iterator();
    while (it.next()) |message| {
        if (std.mem.eql(u8, &message.envelope.id, &message_id)) {
            state.allocator.destroy(message);
            _ = state.message_queue.remove(message);
            break;
        }
    }
    
    // Remove from offline messages
    var i: usize = 0;
    while (i < state.offline_messages.items.len) {
        const message = state.offline_messages.items[i];
        if (std.mem.eql(u8, &message.envelope.id, &message_id)) {
            _ = state.offline_messages.swapRemove(i);
            state.allocator.destroy(message);
            break;
        }
        i += 1;
    }
    
    // Update status to cancelled
    try state.storage.update_message_status(message_id, entities.MessageStatus.Cancelled);
}

/// Get queue statistics.
pub fn get_queue_stats(state: *State) struct {
    queue_size: usize,
    pending_confirmations: usize,
    offline_messages: usize,
} {
    return .{
        .queue_size = state.message_queue.len(),
        .pending_confirmations = state.pending_confirmations.count(),
        .offline_messages = state.offline_messages.items.len,
    };
}