module port::trios::crates::trios-chat::common::helpers;

// SPDX-License-Identifier: Apache-2.0
// The small byte helpers the CR-CHAT-03, CR-CHAT-04 and CR-CHAT-07 ring ports share, written once.
//
// Each ring file is a port of one Rust guard, and each guard carried its own copy of the same few
// helpers under a local name (hashes_equal, dests_equal, obs_ids_equal, is_zero_id, ...). Landing the
// 66 port PRs in one merge (gHashTag/t27#10098) put twelve duplicate-body groups into
// tools/duplicate_bodies_baseline.txt. The ring files now `use` this module and keep only what is
// theirs: their verdict types, their rules and their tests.
//
// Three families live here:
//   - equality over a fixed-size id: ids16_equal ([16]u8) and ids32_equal ([32]u8). t27 has no
//     whole-array equality, so each is a loop over the bytes.
//   - the all-zero probe: zero_id16 for a fixed id, all_zero_bytes for a slice, and bytes_equal for
//     two slices of any length (the length check comes first).
//   - the integer square root approx_sqrt: a bisection over the whole answer range of a u64 (the
//     largest root is 4294967295, and thirty-three halvings settle it exactly).
//
// The record-bound scans (id_seen_before, obs_seen_before, dest_count, member_contains) stay in their
// ring files: each reads a field of a record type that ring declares, and t27 has no way to write
// one scan over several record types yet.

/// Whole-id equality over a sixteen-byte id.
pub fn ids16_equal(a: [16]u8, b: [16]u8) -> bool {
    for i in 0..16 {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// Whole-id equality over a thirty-two-byte id, hash or key.
pub fn ids32_equal(a: [32]u8, b: [32]u8) -> bool {
    for i in 0..32 {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// Whether a sixteen-byte id is all zero - the original's compare against [0u8; 16].
pub fn zero_id16(id: [16]u8) -> bool {
    for i in 0..16 {
        if (id[i] != 0) {
            return false;
        }
    }
    return true;
}

/// Vec equality: the same length and the same bytes.
pub fn bytes_equal(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for i in 0..a.len {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// Whether every byte is zero - the original's all-zero seed probe. An empty slice is all zero.
pub fn all_zero_bytes(bytes: []const u8) -> bool {
    for i in 0..bytes.len {
        if (bytes[i] != 0) {
            return false;
        }
    }
    return true;
}

/// The integer square root of a u64 - the original's Newton iteration, answered by a bisection over
/// the whole answer range. The largest root of any u64 is 4294967295, and thirty-three halvings
/// settle the search exactly.
pub fn approx_sqrt(v: u64) -> u64 {
    var lo: u64 = 0;
    var hi: u64 = 4294967295;
    var mid: u64 = 0;
    for _ in 0..33 {
        if (lo <= hi) {
            mid = (lo + hi) / 2;
            if (mid * mid <= v) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    return hi;
}

test ids16_equal_answers {
    var a: [16]u8;
    var b: [16]u8;
    for i in 0..16 {
        a[i] = 7;
        b[i] = 7;
    }
    assert(ids16_equal(a, b));
    b[15] = 8;
    assert(!ids16_equal(a, b));
    b[15] = 7;
    b[0] = 0;
    assert(!ids16_equal(a, b));
}

test ids32_equal_answers {
    var a: [32]u8;
    var b: [32]u8;
    for i in 0..32 {
        a[i] = 9;
        b[i] = 9;
    }
    assert(ids32_equal(a, b));
    b[31] = 10;
    assert(!ids32_equal(a, b));
    b[31] = 9;
    b[0] = 0;
    assert(!ids32_equal(a, b));
}

test zero_id16_answers {
    var id: [16]u8;
    for i in 0..16 {
        id[i] = 0;
    }
    assert(zero_id16(id));
    id[15] = 1;
    assert(!zero_id16(id));
    id[15] = 0;
    id[0] = 1;
    assert(!zero_id16(id));
}

test bytes_equal_answers {
    var a: [4]u8;
    var b: [4]u8;
    var c: [3]u8;
    for i in 0..4 {
        a[i] = 5;
        b[i] = 5;
    }
    for i in 0..3 {
        c[i] = 5;
    }
    assert(bytes_equal(&a, &b));
    assert(!bytes_equal(&a, &c));
    b[3] = 6;
    assert(!bytes_equal(&a, &b));
    const e1: [0]u8 = [0]u8{};
    const e2: [0]u8 = [0]u8{};
    assert(bytes_equal(&e1, &e2));
}

test all_zero_bytes_answers {
    var z: [5]u8;
    for i in 0..5 {
        z[i] = 0;
    }
    assert(all_zero_bytes(&z));
    z[4] = 1;
    assert(!all_zero_bytes(&z));
    const empty: [0]u8 = [0]u8{};
    assert(all_zero_bytes(&empty));
}

test approx_sqrt_answers {
    assert(approx_sqrt(0) == 0);
    assert(approx_sqrt(1) == 1);
    assert(approx_sqrt(15) == 3);
    assert(approx_sqrt(16) == 4);
    assert(approx_sqrt(17) == 4);
    assert(approx_sqrt(1000000) == 1000);
    assert(approx_sqrt(18446744073709551615) == 4294967295);
}
