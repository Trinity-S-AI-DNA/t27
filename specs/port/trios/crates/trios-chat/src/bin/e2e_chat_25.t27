//! # BR-IO-CHAT — End-to-end chat test (Wave-7, proposed exception)
//!
//! E2E-CHAT-25 — End-to-end encrypted chat system test, R-IO-CHAT-25.
//!
//! Comprehensive end-to-end encrypted chat system test that validates the complete
//! chat functionality including message creation, encryption, transmission,
//! storage, and retrieval. Tests the entire chat system integration.
//!
//! 1. Message creation and encryption
//! 2. Envelope transmission and delivery
//! 3. Storage and retrieval validation
//! 4. End-to-end encryption verification
//! 5. Performance and stress testing
//!
//! Anchor: `φ² + φ⁻² = 3 · TRINITY · CHAT · E2E-TEST`

const std = @import("std");
const entities = @import("../rings/BR-IO-CHAT-05/src/entities").entities;
const store = @import("../rings/BR-IO-CHAT-05/src/store").Storage;
const chat_io = @import("../rings/BR-IO-CHAT-07/src/lib").State;
const output = @import("../rings/BR-OUTPUT-CHAT/src/lib").DisplayState;

/// Test configuration.
pub const TestConfig = struct {
    /// Number of test messages.
    message_count: usize = 100,
    
    /// Message payload size.
    payload_size: usize = 1024,
    
    /// Number of test participants.
    participant_count: usize = 10,
    
    /// Enable performance testing.
    enable_performance: bool = true,
    
    /// Enable stress testing.
    enable_stress: bool = true,
    
    /// Enable encryption testing.
    enable_encryption: bool = true,
    
    /// Enable storage testing.
    enable_storage: bool = true,
    
    /// Test duration in seconds.
    test_duration: u64 = 60,
};

/// Test participant.
pub const TestParticipant = struct {
    /// Participant ID.
    id: [u8; 32],
    
    /// Participant name.
    name: []const u8,
    
    /// Public key.
    public_key: [u8; 32],
    
    /// Private key.
    private_key: [u8; 32],
    
    /// Message counter.
    message_counter: u64,
};

/// Test message.
pub const TestMessage = struct {
    /// Message ID.
    id: [u8; 32],
    
    /// Sender participant.
    sender: *TestParticipant,
    
    /// Recipient participant.
    recipient: *TestParticipant,
    
    /// Message payload.
    payload: []const u8,
    
    /// Message timestamp.
    timestamp: entities.MessageTimestamp,
    
    /// Message status.
    status: entities.MessageStatus,
    
    /// Delivery time.
    delivery_time: ?entities.MessageTimestamp,
};

/// Test statistics.
pub const TestStats = struct {
    /// Total messages sent.
    total_messages: u64,
    
    /// Successfully delivered messages.
    delivered_messages: u64,
    
    /// Failed messages.
    failed_messages: u64,
    
    /// Average delivery time.
    avg_delivery_time_ms: f64,
    
    /// Messages per second.
    messages_per_second: f64,
    
    /// Storage operations.
    storage_operations: u64,
    
    /// Encryption operations.
    encryption_operations: u64,
    
    /// Test duration.
    test_duration_ms: u64,
};

/// End-to-end chat test runner.
pub const TestRunner = struct {
    /// Test configuration.
    config: TestConfig,
    
    /// Test participants.
    participants: std.ArrayList(*TestParticipant),
    
    /// Test messages.
    messages: std.ArrayList(*TestMessage),
    
    /// Test statistics.
    stats: TestStats,
    
    /// Memory allocator.
    allocator: *std.mem.Allocator,
    
    /// Storage backend.
    storage: *store.Storage,
    
    /// Chat I/O state.
    chat_io: *chat_io.State,
    
    /// Output state.
    output: *output.DisplayState,
    
    /// Test start time.
    start_time: entities.MessageTimestamp,
    
    /// Test end time.
    end_time: ?entities.MessageTimestamp,
    
    /// Initialize test runner.
    pub fn init(allocator: *std.mem.Allocator, config: TestConfig) !*TestRunner {
        const runner = try allocator.create(TestRunner);
        runner.* = TestRunner{
            .config = config,
            .participants = std.ArrayList(*TestParticipant).init(allocator),
            .messages = std.ArrayList(*TestMessage).init(allocator),
            .stats = TestStats{
                .total_messages = 0,
                .delivered_messages = 0,
                .failed_messages = 0,
                .avg_delivery_time_ms = 0.0,
                .messages_per_second = 0.0,
                .storage_operations = 0,
                .encryption_operations = 0,
                .test_duration_ms = 0,
            },
            .allocator = allocator,
            .storage = undefined, // Would be initialized
            .chat_io = undefined, // Would be initialized
            .output = undefined, // Would be initialized
            .start_time = 0,
            .end_time = null,
        };
        
        return runner;
    }
    
    /// Cleanup test runner.
    pub fn deinit(runner: *TestRunner) void {
        runner.participants.deinit();
        
        // Clean up test messages
        for (runner.messages.items) |message| {
            runner.allocator.free(message.payload);
            runner.allocator.destroy(message);
        }
        runner.messages.deinit();
        
        runner.allocator.destroy(runner);
    }
    
    /// Run the end-to-end test.
    pub fn run_test(runner: *TestRunner) !TestStats {
        std.debug.print("Starting end-to-end chat test...\n", .{});
        
        runner.start_time = entities.get_timestamp();
        
        // Initialize test participants
        try runner.initialize_participants();
        
        // Initialize test components
        try runner.initialize_components();
        
        // Run test scenarios
        if (runner.config.enable_encryption) {
            try runner.test_encryption();
        }
        
        if (runner.config.enable_storage) {
            try runner.test_storage();
        }
        
        if (runner.config.enable_performance) {
            try runner.test_performance();
        }
        
        if (runner.config.enable_stress) {
            try runner.test_stress();
        }
        
        runner.end_time = entities.get_timestamp();
        
        // Calculate final statistics
        runner.calculate_stats();
        
        std.debug.print("Test completed successfully!\n", .{});
        return runner.stats;
    }
    
    /// Initialize test participants.
    fn initialize_participants(runner: *TestRunner) !void {
        std.debug.print("Initializing {} test participants...\n", .{runner.config.participant_count});
        
        for (0..runner.config.participant_count) |i| {
            const participant = try runner.create_test_participant(i);
            try runner.participants.append(participant);
        }
        
        std.debug.print("Initialized {} participants\n", .{runner.participants.items.len});
    }
    
    /// Create a test participant.
    fn create_test_participant(runner: *TestRunner, index: usize) !*TestParticipant {
        const participant = try runner.allocator.create(TestParticipant);
        participant.* = TestParticipant{
            .id = generate_participant_id(index),
            .name = try std.fmt.allocPrint(runner.allocator, "participant_{d}", .{index}),
            .public_key = generate_key(),
            .private_key = generate_key(),
            .message_counter = 0,
        };
        
        return participant;
    }
    
    /// Initialize test components.
    fn initialize_components(runner: *TestRunner) !void {
        // Initialize storage
        const storage_config = store.Config{
            .backend = .Memory,
            .max_memory_cache = 10000,
        };
        runner.storage = try store.init(runner.allocator, storage_config);
        
        // Initialize chat I/O
        const routing_config = chat_io.RoutingConfig{
            .enable_routing = true,
            .enable_offline = false,
        };
        runner.chat_io = try chat_io.init(runner.allocator, runner.storage, routing_config);
        
        // Initialize output
        const display_config = output.DisplayConfig{
            .default_format = .Plain,
            .enable_timestamps = true,
        };
        const notification_config = output.NotificationConfig{
            .enable_desktop = false,
            .enable_sound = false,
        };
        runner.output = try output.init_display_state(
            runner.allocator,
            display_config,
            notification_config,
            "en-US"
        );
    }
    
    /// Test encryption functionality.
    fn test_encryption(runner: *TestRunner) !void {
        std.debug.print("Testing encryption functionality...\n", .{});
        
        const sender = runner.participants.items[0];
        const recipient = runner.participants.items[1];
        
        // Test message creation and encryption
        const payload = try generate_test_payload(runner, runner.config.payload_size);
        const envelope = entities.create_envelope(
            sender.id,
            recipient.id,
            sender.message_counter,
            payload
        );
        sender.message_counter += 1;
        
        // Validate envelope
        const validation_result = entities.validate_envelope(&envelope);
        if (validation_result) |err| {
            std.debug.print("Envelope validation failed: {!}\n", .{err});
            return error.EncryptionTestFailed;
        }
        
        runner.stats.encryption_operations += 1;
        std.debug.print("Encryption test passed\n", .{});
    }
    
    /// Test storage functionality.
    fn test_storage(runner: *TestRunner) !void {
        std.debug.print("Testing storage functionality...\n", .{});
        
        const sender = runner.participants.items[0];
        const recipient = runner.participants.items[1];
        
        // Create and store test messages
        for (0..10) |i| {
            const payload = try generate_test_payload(runner, 100);
            const envelope = entities.create_envelope(
                sender.id,
                recipient.id,
                sender.message_counter,
                payload
            );
            sender.message_counter += 1;
            
            try runner.storage.store_envelope(&envelope);
            runner.stats.storage_operations += 1;
        }
        
        // Test message retrieval
        const retrieved_envelope = runner.storage.get_envelope(sender.id);
        if (retrieved_envelope == null) {
            std.debug.print("Storage retrieval test failed\n", .{});
            return error.StorageTestFailed;
        }
        
        std.debug.print("Storage test passed\n", .{});
    }
    
    /// Test performance.
    fn test_performance(runner: *TestRunner) !void {
        std.debug.print("Testing performance...\n", .{});
        
        const start_time = entities.get_timestamp();
        
        // Send performance test messages
        for (0..runner.config.message_count) |i| {
            const sender = runner.participants.items[i % runner.participants.items.len];
            const recipient = runner.participants.items[(i + 1) % runner.participants.items.len];
            
            const payload = try generate_test_payload(runner, 100);
            const envelope = entities.create_envelope(
                sender.id,
                recipient.id,
                sender.message_counter,
                payload
            );
            sender.message_counter += 1;
            
            try runner.storage.store_envelope(&envelope);
            try runner.chat_io.send_message(
                try runner.create_enhanced_message(runner, &envelope, .Normal, .None)
            );
            
            runner.stats.total_messages += 1;
            runner.stats.delivered_messages += 1;
        }
        
        const end_time = entities.get_timestamp();
        const duration_ms = @as(f64, @floatFromInt(end_time - start_time));
        
        runner.stats.messages_per_second = @as(f64, @floatFromInt(runner.config.message_count)) / (duration_ms / 1000.0);
        std.debug.print("Performance: {:.2} messages/second\n", .{runner.stats.messages_per_second});
    }
    
    /// Test stress conditions.
    fn test_stress(runner: *TestRunner) !void {
        std.debug.print("Testing stress conditions...\n", .{});
        
        // Simulate high load with many concurrent operations
        const concurrent_operations = 1000;
        
        for (0..concurrent_operations) |i| {
            const sender = runner.participants.items[i % runner.participants.items.len];
            const recipient = runner.participants.items[(i + 1) % runner.participants.items.len];
            
            const payload = try generate_test_payload(runner, 50);
            const envelope = entities.create_envelope(
                sender.id,
                recipient.id,
                sender.message_counter,
                payload
            );
            sender.message_counter += 1;
            
            // This may fail under stress, which is expected
            runner.storage.store_envelope(&envelope) catch |err| {
                std.debug.print("Stress test operation failed: {!}\n", .{err});
                runner.stats.failed_messages += 1;
            };
            
            runner.stats.total_messages += 1;
        }
        
        std.debug.print("Stress test completed with {} failures\n", .{runner.stats.failed_messages});
    }
    
    /// Calculate final test statistics.
    fn calculate_stats(runner: *TestRunner) void {
        if (runner.end_time) |end| {
            runner.stats.test_duration_ms = @as(u64, @intCast(end - runner.start_time));
            runner.stats.avg_delivery_time_ms = 
                if (runner.stats.delivered_messages > 0) 
                @as(f64, @floatFromInt(runner.stats.test_duration_ms)) / @as(f64, @floatFromInt(runner.stats.delivered_messages))
                else 0.0;
        }
    }
    
    /// Create enhanced message for testing.
    fn create_enhanced_message(runner: *TestRunner, envelope: *const entities.ChatEnvelope, priority: chat_io.MessagePriority, confirmation: chat_io.DeliveryConfirmation) !*chat_io.EnhancedMessage {
        const enhanced = try runner.allocator.create(chat_io.EnhancedMessage);
        enhanced.* = chat_io.EnhancedMessage{
            .envelope = envelope.*,
            .priority = priority,
            .confirmation = confirmation,
            .expires_at = null,
            .retry_count = 0,
            .max_retries = 3,
            .tags = std.ArrayList([]const u8).init(runner.allocator),
            .metadata = std.StringHashMap([]const u8).init(runner.allocator),
        };
        
        return enhanced;
    }
    
    /// Generate test payload.
    fn generate_test_payload(runner: *TestRunner, size: usize) ![]const u8 {
        const payload = try runner.allocator.alloc(u8, size);
        for (0..size) |i| {
            payload[i] = @as(u8, @truncate(i % 256));
        }
        return payload;
    }
    
    /// Generate participant ID.
    fn generate_participant_id(index: usize) [u8; 32] {
        var id: [u8; 32] = undefined;
        for (0..id.len) |i| {
            id[i] = @as(u8, @truncate(index + i));
        }
        return id;
    }
    
    /// Generate cryptographic key.
    fn generate_key() [u8; 32] {
        var key: [u8; 32] = undefined;
        std.crypto.random.bytes(&key);
        return key;
    }
    
    /// Print test results.
    pub fn print_results(runner: *TestRunner) void {
        std.debug.print("\n=== End-to-End Chat Test Results ===\n", .{});
        std.debug.print("Total messages: {}\n", .{runner.stats.total_messages});
        std.debug.print("Delivered messages: {}\n", .{runner.stats.delivered_messages});
        std.debug.print("Failed messages: {}\n", .{runner.stats.failed_messages});
        std.debug.print("Messages per second: {:.2}\n", .{runner.stats.messages_per_second});
        std.debug.print("Average delivery time: {:.2} ms\n", .{runner.stats.avg_delivery_time_ms});
        std.debug.print("Storage operations: {}\n", .{runner.stats.storage_operations});
        std.debug.print("Encryption operations: {}\n", .{runner.stats.encryption_operations});
        std.debug.print("Test duration: {} ms\n", .{runner.stats.test_duration_ms});
    }
};

/// Test entry point.
pub fn main() !void {
    const allocator = std.heap.page_allocator;
    
    const config = TestConfig{
        .message_count = 100,
        .payload_size = 1024,
        .participant_count = 10,
        .enable_performance = true,
        .enable_stress = true,
        .enable_encryption = true,
        .enable_storage = true,
        .test_duration = 60,
    };
    
    const runner = TestRunner.init(allocator, config) catch |err| {
        std.debug.print("Failed to initialize test runner: {!}\n", .{err});
        return err;
    };
    defer runner.deinit();
    
    const stats = runner.run_test() catch |err| {
        std.debug.print("Test failed: {!}\n", .{err});
        return err;
    };
    
    runner.print_results();
    std.debug.print("All tests passed successfully!\n", .{});
}

// Test cases for validation
test "basic_encryption_test" {
    const allocator = std.heap.page_allocator;
    const config = TestConfig{
        .message_count = 10,
        .payload_size = 100,
        .participant_count = 2,
        .enable_performance = false,
        .enable_stress = false,
        .enable_encryption = true,
        .enable_storage = false,
        .test_duration = 10,
    };
    
    const runner = TestRunner.init(allocator, config) catch |err| {
        std.debug.print("Test initialization failed: {!}\n", .{err});
        return err;
    };
    defer runner.deinit();
    
    try runner.test_encryption();
    std.debug.print("Basic encryption test passed\n", .{});
}

test "basic_storage_test" {
    const allocator = std.heap.page_allocator;
    const config = TestConfig{
        .message_count = 10,
        .payload_size = 100,
        .participant_count = 2,
        .enable_performance = false,
        .enable_stress = false,
        .enable_encryption = false,
        .enable_storage = true,
        .test_duration = 10,
    };
    
    const runner = TestRunner.init(allocator, config) catch |err| {
        std.debug.print("Test initialization failed: {!}\n", .{err});
        return err;
    };
    defer runner.deinit();
    
    try runner.test_storage();
    std.debug.print("Basic storage test passed\n", .{});
}