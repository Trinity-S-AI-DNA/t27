module port::ingest_rag_chunks;

const ANCHOR: []const u8 = "phi^2 + phi^-2 = 3";
const VALID_KINDS_FRONTMATTER: []const u8 = "frontmatter";
const VALID_KINDS_CHAPTER: []const u8 = "chapter";
const VALID_KINDS_APPENDIX: []const u8 = "appendix";

struct ChunkConfig {
    file: []const u8,
    kind: []const u8,
    chunk_idx: i32,
    text: []const u8,
    sha256: []const u8,
    anchor: []const u8,
}

struct ChunkEnvelope {
    canon_name: ?[]const u8,
    config: ChunkConfig,
}

struct Row {
    chapter_slug: []const u8,
    chunk_index: i32,
    chunk_kind: []const u8,
    chunk_text: []const u8,
    sha256: []const u8,
    anchor: []const u8,
}

pub fn default_anchor() -> []const u8 {
    return ANCHOR;
}

pub fn slug_from_path(p: []const u8) -> []const u8 {
    var path_end: usize = 0;
    var i: usize = 0;
    while (i < p.len) {
        if (p[i] == '/') {
            path_end = i + 1;
        }
        i += 1;
    }
    
    var file_start: usize = path_end;
    var file_end: usize = p.len;
    i = file_start;
    while (i < p.len) {
        if (p[i] == '.') {
            file_end = i;
            break;
        }
        i += 1;
    }
    
    if (file_start >= file_end) {
        return p;
    }
    
    return p[file_start..file_end];
}

pub fn coerce_kind(declared: []const u8, path: []const u8) -> []const u8 {
    if (declared == VALID_KINDS_FRONTMATTER or declared == VALID_KINDS_CHAPTER or declared == VALID_KINDS_APPENDIX) {
        return declared;
    }
    
    if (path_contains(path, "appendix")) {
        return VALID_KINDS_APPENDIX;
    } else if (path_contains(path, "frontmatter")) {
        return VALID_KINDS_FRONTMATTER;
    } else {
        return VALID_KINDS_CHAPTER;
    }
}

fn path_contains(path: []const u8, substr: []const u8) -> bool {
    var i: usize = 0;
    while (i <= path.len - substr.len) {
        var match: bool = true;
        var j: usize = 0;
        while (j < substr.len) {
            if (path[i + j] != substr[j]) {
                match = false;
                break;
            }
            j += 1;
        }
        if (match) {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn load_rows(jsonl_path: []const u8) -> ?[]Row {
    undefined;
}

pub fn main() -> i32 {
    undefined;
}

test default_anchor_returns_constant {
    const result: []const u8 = default_anchor();
    assert(result == "phi^2 + phi^-2 = 3");
}

test slug_from_path_basic {
    const path: []const u8 = "chapters/ch_25.tex";
    const result: []const u8 = slug_from_path(path);
    assert(result == "ch_25");
}

test slug_from_path_no_extension {
    const path: []const u8 = "README";
    const result: []const u8 = slug_from_path(path);
    assert(result == "README");
}

test slug_from_path_full_path {
    const path: []const u8 = "docs/phd/rag/rag_chunks.jsonl";
    const result: []const u8 = slug_from_path(path);
    assert(result == "rag_chunks");
}

test coerce_kind_valid {
    const result: []const u8 = coerce_kind("chapter", "chapters/ch_25.tex");
    assert(result == "chapter");
}

test coerce_kind_appendix_path {
    const result: []const u8 = coerce_kind("unknown", "appendices/app_a.tex");
    assert(result == "appendix");
}

test coerce_kind_frontmatter_path {
    const result: []const u8 = coerce_kind("unknown", "frontmatter/intro.md");
    assert(result == "frontmatter");
}

test coerce_kind_default {
    const result: []const u8 = coerce_kind("unknown", "chapters/ch_01.tex");
    assert(result == "chapter");
}

test coerce_kind_valid_unchanged {
    const result: []const u8 = coerce_kind("frontmatter", "frontmatter/title.md");
    assert(result == "frontmatter");
}