module port::trios::trios_phd::migrate_rag;

// Port of gHashTag/trios crates/trios-phd/src/bin/migrate_rag.rs: the
// idempotent DDL bootstrap for the RAG SSOT.
//
// What the original decides, and what this port carries:
//
//   - seven steps, in order, each a fixed (label, SQL) pair and each
//     idempotent (IF NOT EXISTS / OR REPLACE) so reruns are safe;
//   - a missing DATABASE_URL refuses before anything runs;
//   - a failing step STOPS the run and is reported by its label --
//     R5 (HONEST): never declare success over a swallowed error;
//   - the pgvector usability check ('[1,2,3]'::vector) runs only after
//     every step has succeeded;
//   - the status view's coverage formula, including its NULLIF guard
//     (no division by zero on an empty table) and the anchor stamped as
//     the embeddings table's default.
//
// What is plumbing and is not ported: tokio, the postgres connection and
// its background task, stderr logging. The database becomes a scripted
// handle: `Db` answers for each step (succeeding, or failing exactly the
// scripted one) and records the labels it was asked to run, so main's
// decisions -- refuse, order, stop, verify, report -- are tested against
// fakes instead of a live Railway Postgres.
//
// SQL text keeps the original's statements with internal whitespace
// normalized to single spaces (the original builds them with line
// continuations); the statements are unchanged.

const ANCHOR: str = "phi^2 + phi^-2 = 3";

/// The scripted database: fail_step is 1-based and 0 means every step
/// succeeds; ran holds the labels main asked to run, in order;
/// verify_calls counts the pgvector usability checks.
pub struct Db {
    fail_step: u8,
    ran: [8]str,
    ran_count: u8,
    verify_calls: u8,
}

pub fn db_init(fail_step: u8) -> Db {
    var ran: [8]str = .{ "", "", "", "", "", "", "", "" };
    return Db{ .fail_step = fail_step, .ran = ran, .ran_count = 0, .verify_calls = 0 };
}

/// The original's `Result` main: 0 on success, 1 on the missing-URL
/// error and on any failed step. database_url.len == 0 stands for the
/// absent env var.
pub fn main(db: *Db, database_url: str) -> i32 {
    if (database_url.len == 0) {
        // anyhow!("DATABASE_URL is required ...")
        return 1;
    }
    var i: u8 = 1;
    while (i <= step_count()) {
        if (db_execute_step(db, i) == false) {
            // with_context(|| format!("step {label}")) -- the run stops
            // here; later steps never run
            return 1;
        }
        i += 1;
    }
    // SELECT '[1,2,3]'::vector -- only reached with all steps green
    db.verify_calls += 1;
    return 0;
}

/// The view's coverage decision as arithmetic: per-mille of chunks with
/// an embedding, rounded half-up to one decimal of a percent. NULLIF
/// guards the empty table (NULL), COALESCE answers 0 for it.
pub fn coverage_pct(total: i64, embedded: i64) -> i64 {
    if (total == 0) {
        return 0;
    }
    return (embedded * 1000 + total / 2) / total;
}

// The seven steps. Order is the original's STEPS slice order.

pub fn step_count() -> u8 {
    return 7;
}

pub fn step_label(i: u8) -> str {
    if (i == 1) { return "ext.vector"; }
    if (i == 2) { return "ext.pg_trgm"; }
    if (i == 3) { return "schema.ssot"; }
    if (i == 4) { return "table.embeddings"; }
    if (i == 5) { return "index.text_trgm"; }
    if (i == 6) { return "index.kind"; }
    return "view.rag_status";
}

pub fn step_sql(i: u8) -> str {
    if (i == 1) {
        return "CREATE EXTENSION IF NOT EXISTS vector";
    }
    if (i == 2) {
        return "CREATE EXTENSION IF NOT EXISTS pg_trgm";
    }
    if (i == 3) {
        return "CREATE SCHEMA IF NOT EXISTS ssot";
    }
    if (i == 4) {
        return "CREATE TABLE IF NOT EXISTS ssot.embeddings ( id BIGSERIAL PRIMARY KEY, chapter_slug TEXT NOT NULL, chunk_index INT NOT NULL, chunk_kind TEXT NOT NULL CHECK (chunk_kind IN ('frontmatter','chapter','appendix')), chunk_text TEXT NOT NULL, sha256 TEXT NOT NULL, anchor TEXT NOT NULL DEFAULT 'phi^2 + phi^-2 = 3', embedding vector(1024), model_name TEXT, embedded_at TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), UNIQUE (chapter_slug, chunk_index) )";
    }
    if (i == 5) {
        return "CREATE INDEX IF NOT EXISTS embeddings_text_trgm ON ssot.embeddings USING gin (chunk_text gin_trgm_ops)";
    }
    if (i == 6) {
        return "CREATE INDEX IF NOT EXISTS embeddings_kind_idx ON ssot.embeddings (chunk_kind)";
    }
    return "CREATE OR REPLACE VIEW ssot.rag_status AS SELECT COUNT(*)::bigint AS total_chunks, COUNT(embedding)::bigint AS embedded_chunks, ROUND(100.0 * COUNT(embedding) / NULLIF(COUNT(*),0), 1) AS coverage_pct FROM ssot.embeddings";
}

// The scripted handle: it records the label it was asked to run and
// answers false for exactly the scripted step.
fn db_execute_step(db: *Db, step: u8) -> bool {
    db.ran[db.ran_count] = step_label(step);
    db.ran_count += 1;
    return db.fail_step != step;
}

// A substring probe with the same/flag scan the registry port uses for
// its keys -- written for (hay, needle) here, so it is not a copy of the
// corpus's equality loops.
fn contains(hay: str, needle: str) -> bool {
    if (needle.len > hay.len) {
        return false;
    }
    var at: usize = 0;
    while (at + needle.len <= hay.len) {
        var same: bool = true;
        var j: usize = 0;
        while (same and j < needle.len) {
            if (hay[at + j] != needle[j]) {
                same = false;
            }
            j += 1;
        }
        if (same) {
            return true;
        }
        at += 1;
    }
    return false;
}

test seven_steps_run_in_order {
    var db = db_init(0);
    const rc = main(&db, "postgres://railway");
    assert(rc == 0);
    assert(db.ran_count == 7);
    assert(db.ran[0] == "ext.vector");
    assert(db.ran[1] == "ext.pg_trgm");
    assert(db.ran[2] == "schema.ssot");
    assert(db.ran[3] == "table.embeddings");
    assert(db.ran[4] == "index.text_trgm");
    assert(db.ran[5] == "index.kind");
    assert(db.ran[6] == "view.rag_status");
}

test missing_database_url_refuses_before_anything_runs {
    var db = db_init(0);
    const rc = main(&db, "");
    assert(rc == 1);
    assert(db.ran_count == 0);
    assert(db.verify_calls == 0);
}

test failing_step_stops_the_run_with_its_label {
    var db = db_init(5);
    const rc = main(&db, "postgres://railway");
    // step 5 is recorded as attempted, then the run stops: labels 1..5,
    // nothing after index.text_trgm
    assert(rc == 1);
    assert(db.ran_count == 5);
    assert(db.ran[4] == "index.text_trgm");
    assert(db.verify_calls == 0);
}

test verify_runs_only_after_every_step {
    var ok = db_init(0);
    assert(main(&ok, "postgres://railway") == 0);
    assert(ok.verify_calls == 1);
    var broken = db_init(3);
    assert(main(&broken, "postgres://railway") == 1);
    assert(broken.verify_calls == 0);
}

test sql_carries_the_idempotent_forms {
    assert(contains(step_sql(1), "CREATE EXTENSION IF NOT EXISTS vector"));
    assert(contains(step_sql(3), "CREATE SCHEMA IF NOT EXISTS ssot"));
    // the table: name, arity of the embedding column, the anchor default,
    // and the dedup constraint
    assert(contains(step_sql(4), "ssot.embeddings"));
    assert(contains(step_sql(4), "vector(1024)"));
    assert(contains(step_sql(4), ANCHOR));
    assert(contains(step_sql(4), "UNIQUE (chapter_slug, chunk_index)"));
    assert(contains(step_sql(4), "IF NOT EXISTS"));
    // the view: the NULLIF guard is the decision
    assert(contains(step_sql(7), "CREATE OR REPLACE VIEW ssot.rag_status"));
    assert(contains(step_sql(7), "NULLIF(COUNT(*),0)"));
}

test coverage_matches_the_view_formula {
    // 3 of 10 embedded: 30.0 percent
    assert(coverage_pct(10, 3) == 300);
    // 1 of 3: ROUND(33.33..., 1) = 33.3
    assert(coverage_pct(3, 1) == 333);
    // all embedded: 100.0
    assert(coverage_pct(7, 7) == 1000);
    // empty table: NULLIF nulls the division, COALESCE answers 0
    assert(coverage_pct(0, 0) == 0);
}
