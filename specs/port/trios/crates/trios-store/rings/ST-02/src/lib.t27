module port::trios::crates::trios_store::rings::ST_02::src::lib;

// Port of gHashTag/trios crates/trios-store/rings/ST-02/src/lib.rs (138 lines).
//
// The Rust `migrate` owns a SeaORM transaction, so the world-touching part
// (begin/execute_unprepared/commit) cannot live in .t27. What the function
// actually decides, and what this port keeps, is the statement split loop at
// lines 66-72: split SCHEMA_DDL on ';', trim each fragment, skip fragments that
// trim to nothing, and execute the rest in order. `migrate` therefore takes the
// DDL text and returns how many statements the transaction would execute. The
// connection itself is supplied by the caller and is not modelled here.

// Rust's `str::trim` strips ASCII whitespace plus a few Unicode spaces; the DDL
// in this file is ASCII, so the ASCII whitespace set is the faithful subset.
fn is_ddl_space(c: u8) -> bool {
    if (c == ' ') {
        return true;
    }
    if (c == '\t') {
        return true;
    }
    if (c == '\n') {
        return true;
    }
    if (c == '\r') {
        return true;
    }
    if (c == 11) {
        return true;
    }
    if (c == 12) {
        return true;
    }
    return false;
}

// Lines 64-75: the number of `execute_unprepared` calls for a given DDL batch.
// A trailing fragment without a final ';' is still executed (Rust's split keeps
// it and `trim` leaves it non-empty), while runs of separators and whitespace
// contribute nothing. This is idempotence-neutral: the DDL itself is all
// `IF NOT EXISTS`, so a second run repeats the same statements.
pub fn migrate(ddl: str) -> usize {
    var count: usize = 0;
    var has_content: bool = false;
    var i: usize = 0;
    while (i < ddl.len) {
        const c = ddl[i];
        if (c == ';') {
            if (has_content) {
                count += 1;
            }
            has_content = false;
        } else if (!is_ddl_space(c)) {
            has_content = true;
        }
        i += 1;
    }
    if (has_content) {
        count += 1;
    }
    return count;
}

// The whitespace set used by the trim step (lines 67-68).
test migrate_whitespace_classification {
    assert(is_ddl_space(' '));
    assert(is_ddl_space('\n'));
    assert(is_ddl_space('\t'));
    assert(!is_ddl_space('C'));
    assert(!is_ddl_space(';'));
}

// The three tables the DDL creates (lines 15, 32, 45), pinned so a truncated
// schema is visible. This is the anchor part of the migration contract.
test migrate_counts_every_statement {
    const ddl = "CREATE TABLE IF NOT EXISTS agent_definitions (id TEXT);\nCREATE TABLE IF NOT EXISTS oauth_tokens (id TEXT);\nCREATE TABLE IF NOT EXISTS produced_files (id TEXT);\n";
    assert(migrate(ddl) == 3);
}

// Lines 66-72: empty fragments between separators are skipped.
test migrate_skips_blank_fragments {
    assert(migrate(" ; \n; \t; ") == 0);
}

// Rust's split(';') keeps a trailing fragment; trim leaves it non-empty, so the
// loop executes it. This is the one case a naive "count the semicolons" port
// would get wrong.
test migrate_executes_trailing_fragment {
    assert(migrate("CREATE INDEX IF NOT EXISTS x ON t (c)") == 1);
}

// Consecutive separators collapse to zero statements.
test migrate_handles_double_semicolons {
    assert(migrate("A;;B;;;C;") == 3);
}

// The real DDL body starts each statement with a keyword and ends with ';'
// (lines 14-61); a representative slice keeps the same shape.
test migrate_real_ddl_shape {
    const ddl = "CREATE TABLE IF NOT EXISTS oauth_tokens (browseros_id TEXT NOT NULL);\nCREATE INDEX IF NOT EXISTS oauth_tokens_browseros_id_idx ON oauth_tokens (browseros_id);\n";
    assert(migrate(ddl) == 2);
}
