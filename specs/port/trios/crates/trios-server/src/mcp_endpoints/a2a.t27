// SPDX-License-Identifier: Apache-2.0
// Port of gHashTag/trios crates/trios-server/src/mcp_endpoints/a2a.rs (94 lines)
// to .t27. Issue #6590.
//
// The original is a thin async bridge: each endpoint reads its params out of a
// serde_json Value and calls into the in-process A2A registry behind
// `state.a2a.read().await`. The registry, the mutex, the async runtime and the
// JSON values are the caller's side of the boundary; what is left are small
// decisions, ported here as pure functions:
//
//   - register refuses when either `id` or `name` is missing or empty (18-20);
//   - a capability string maps onto one of six named variants, and anything
//     else becomes Custom (36-44);
//   - assign_task reads `assign_to` first and falls back to `agent_id` on key
//     PRESENCE, not on emptiness (69-73); `title` falls back to `description`
//     the same way (74-78);
//   - `created_by` defaults to "system" when the key is absent (79);
//   - every call defaults its missing params to an empty object (8, 53, 58, 88, 93).
//
// Left as plumbing: the registry lock, `register_agent`, and the
// `state.a2a...call(...)` await itself. No .t27 function can reach a mutex or
// a socket, so each endpoint returns the RpcCall it would issue and the
// interface layer performs it. `Capability::Custom(String)` loses its payload:
// .t27 has no tagged unions, so Custom is a bare variant and `is_custom` names
// the arm.

module port::trios::crates::trios_server::src::mcp_endpoints::a2a;

// Mirror of trios_a2a::Capability (lines 36-43).
pub enum Capability { Codegen, FileSystem, Git, Shell, LLM, Orchestrator, Custom, }

// What an endpoint hands to the registry: the RPC it names and the params.
pub struct RpcCall { method: str, uses_default_params: bool, }

// The three fields assign_task forwards, after the aliasing rules above.
pub struct AssignPlan { method: str, assign_to: str, title: str, created_by: str, }

// The answer register builds: either the error object or {"ok": true, "id"}.
pub struct RegisterPlan { accepted: bool, id: str, capability_count: usize, }

// a2a.rs lines 7-9: no decision, only the registry call.
pub fn list_agents() -> RpcCall {
    return RpcCall { method: "a2a_list_agents", uses_default_params: true, };
}

// a2a.rs lines 18-20: `if id.is_empty() || name.is_empty()` returns the error
// object; both fields are required.
pub fn register_rejects(id: str, name: str) -> bool {
    return id.len == 0 || name.len == 0;
}

// a2a.rs lines 36-44: the six named arms, everything else Custom. The match is
// on the exact string, so "Codegen" and "codegen " are both Custom.
pub fn capability_from_name(name: str) -> Capability {
    if (name == "codegen") return .Codegen;
    if (name == "filesystem") return .FileSystem;
    if (name == "git") return .Git;
    if (name == "shell") return .Shell;
    if (name == "llm") return .LLM;
    if (name == "orchestrator") return .Orchestrator;
    return .Custom;
}

// a2a.rs lines 23-27 + 35-46: the decision of register after the guard -- the
// card is built from id/name and one `with_capability` call per parsed
// capability string. Returns the plan the registry would receive.
pub fn register(id: str, name: str, capability_count: usize) -> RegisterPlan {
    if (register_rejects(id, name)) {
        return RegisterPlan { accepted: false, id: "", capability_count: 0, };
    }
    // The original folds every capability into the card; the decision of that
    // fold is capability_from_name, asserted below. The fold itself only calls
    // `with_capability`, so it stays on the interface side.
    return RegisterPlan { accepted: true, id: id, capability_count: capability_count, };
}

// a2a.rs lines 51-53: no decision, only the registry call.
pub fn send(has_params: bool) -> RpcCall {
    return RpcCall { method: "a2a_send", uses_default_params: !has_params, };
}

// a2a.rs lines 56-58: no decision, only the registry call.
pub fn broadcast(has_params: bool) -> RpcCall {
    return RpcCall { method: "a2a_broadcast", uses_default_params: !has_params, };
}

// a2a.rs lines 69-73: `.get("assign_to").or_else(|| p.get("agent_id"))` --
// the first key that is PRESENT wins, even if its value is an empty string,
// because or_else only fires on a missing key.
pub fn assign_assignee(has_assign_to: bool, assign_to: str, has_agent_id: bool, agent_id: str) -> str {
    if (has_assign_to) return assign_to;
    if (has_agent_id) return agent_id;
    return "";
}

// a2a.rs lines 74-78: the same rule for the title / description alias.
pub fn assign_title(has_title: bool, title: str, has_description: bool, description: str) -> str {
    if (has_title) return title;
    if (has_description) return description;
    return "";
}

// a2a.rs line 79: `unwrap_or("system")` -- only an absent key falls back; an
// explicit empty string is forwarded as "".
pub fn assign_created_by(has_created_by: bool, created_by: str) -> str {
    if (has_created_by) return created_by;
    return "system";
}

// a2a.rs lines 67-84: the whole decision of assign_task, minus the call.
pub fn assign_task(has_assign_to: bool, assign_to: str, has_agent_id: bool, agent_id: str, has_title: bool, title: str, has_description: bool, description: str, has_created_by: bool, created_by: str) -> AssignPlan {
    return AssignPlan {
        method: "a2a_assign_task",
        assign_to: assign_assignee(has_assign_to, assign_to, has_agent_id, agent_id),
        title: assign_title(has_title, title, has_description, description),
        created_by: assign_created_by(has_created_by, created_by),
    };
}

// a2a.rs lines 86-89: no decision, only the registry call.
pub fn task_status(has_params: bool) -> RpcCall {
    return RpcCall { method: "a2a_task_status", uses_default_params: !has_params, };
}

// a2a.rs lines 91-94: no decision, only the registry call.
pub fn update_task(has_params: bool) -> RpcCall {
    return RpcCall { method: "a2a_update_task", uses_default_params: !has_params, };
}

test list_agents_names_the_list_rpc {
    const call = list_agents();
    assert(call.method == "a2a_list_agents");
    assert(call.uses_default_params);
}

test register_requires_id_and_name {
    assert(register_rejects("", "name"));
    assert(register_rejects("id", ""));
    assert(register_rejects("", ""));
    assert(!register_rejects("id", "name"));
    const rejected = register("", "agent", 0);
    assert(!rejected.accepted);
    assert(rejected.capability_count == 0);
    const accepted = register("agent-1", "Agent One", 3);
    assert(accepted.accepted);
    assert(accepted.id == "agent-1");
    assert(accepted.capability_count == 3);
}

test capabilities_map_to_the_six_named_arms {
    assert(capability_from_name("codegen") == .Codegen);
    assert(capability_from_name("filesystem") == .FileSystem);
    assert(capability_from_name("git") == .Git);
    assert(capability_from_name("shell") == .Shell);
    assert(capability_from_name("llm") == .LLM);
    assert(capability_from_name("orchestrator") == .Orchestrator);
    // Anything else -- including a case variant -- is Custom.
    assert(capability_from_name("Codegen") == .Custom);
    assert(capability_from_name("") == .Custom);
    assert(capability_from_name("browser") == .Custom);
}

test send_and_broadcast_default_params {
    assert(send(false).method == "a2a_send");
    assert(send(false).uses_default_params);
    assert(!send(true).uses_default_params);
    assert(broadcast(false).method == "a2a_broadcast");
    assert(broadcast(false).uses_default_params);
    assert(!broadcast(true).uses_default_params);
}

test assignee_prefers_assign_to_by_presence {
    assert(assign_assignee(true, "a1", true, "a2") == "a1");
    assert(assign_assignee(false, "a1", true, "a2") == "a2");
    // A present but empty assign_to is still the value that wins.
    assert(assign_assignee(true, "", true, "a2") == "");
    assert(assign_assignee(false, "", false, "") == "");
}

test title_falls_back_to_description {
    assert(assign_title(true, "t", true, "d") == "t");
    assert(assign_title(false, "t", true, "d") == "d");
    assert(assign_title(false, "t", false, "d") == "");
}

test created_by_defaults_to_system {
    assert(assign_created_by(true, "alice") == "alice");
    assert(assign_created_by(true, "") == "");
    assert(assign_created_by(false, "") == "system");
}

test assign_task_forwards_the_three_fields {
    const plan = assign_task(false, "", true, "agent-7", false, "", true, "do the thing", false, "");
    assert(plan.method == "a2a_assign_task");
    assert(plan.assign_to == "agent-7");
    assert(plan.title == "do the thing");
    assert(plan.created_by == "system");
    const explicit = assign_task(true, "a1", true, "a2", true, "T", false, "D", true, "bob");
    assert(explicit.assign_to == "a1");
    assert(explicit.title == "T");
    assert(explicit.created_by == "bob");
}

test remaining_endpoints_name_their_rpcs {
    assert(task_status(false).method == "a2a_task_status");
    assert(task_status(true).uses_default_params == false);
    assert(update_task(false).method == "a2a_update_task");
    assert(update_task(false).uses_default_params);
}
