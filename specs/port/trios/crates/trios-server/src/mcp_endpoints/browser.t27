fn PollersMap_new() -> PollersMap {
    return PollersMap { pollers: [] };
}

fn PollersMap_append(map: PollersMap, poller: Poller) -> PollersMap {
    var new_map = map;
    new_map.pollers.append(poller);
    return new_map;
}

fn PollersMap_retain(map: PollersMap, predicate: any) -> PollersMap {
    var new_map = map;
    var filtered = [];
    for poller in new_map.pollers {
        if (predicate(poller)) {
            filtered.append(poller);
        }
    }
    new_map.pollers = filtered;
    return new_map;
}

fn PollersMap_len(map: PollersMap) -> usize {
    return map.pollers.len;
}

fn PollersMap_get(map: PollersMap, index: usize) -> Poller {
    if (index < map.pollers.len) {
        return map.pollers[index];
    }
    return Poller { agent_id: "", timestamp: Instant {} };
}

pub fn Instant_now() -> Instant {
    return Instant {};
}

pub fn Instant_duration_since(self: Instant, other: Instant) -> Duration {
    return Duration { secs: 0 };
}

pub fn Instant_elapsed(self: Instant) -> Duration {
    return Duration { secs: 0 };
}

struct Duration {
    secs: usize,
}

pub fn Duration_from_secs(secs: usize) -> Duration {
    return Duration { secs: secs };
}

// Value represents JSON values from serde_json::Value
// Using 'any' type directly for Value

// Helper functions - simplified approach for retain logic

// Ported functions
pub fn BrowserState_new() -> BrowserState {
    BrowserState {
        queue: BrowserCommandQueue {},  // Would be Mutex<BrowserCommandQueue>::new() in original
        pollers: PollersMap_new(),  // Would be Mutex<HashMap<String, Instant>>::new() in original
    }
}

pub fn BrowserState_active_agent(self: BrowserState, window: Duration) -> ?str {
    // Port of the decision logic: find the most recent poll within window
    let now = Instant_now();
    let pollers = self.pollers;  // Would be pollers.lock().await in original
    
    // Filter pollers within the time window
    let recent_pollers = [];
    for i in 0..pollers.len {
        let poller = pollers.get(i);
        if (Instant_duration_since(now, poller.timestamp) <= window) {
            recent_pollers.append(poller);
        }
    }
    
    // Find the most recent one
    if (recent_pollers.len == 0) {
        return null;
    }
    
    let mut most_recent = recent_pollers[0];
    for poller in recent_pollers {
        if (poller.timestamp > most_recent.timestamp) {
            most_recent = poller;
        }
    }
    
    return most_recent.agent_id;
}

pub fn BrowserState_record_poll(self: BrowserState, agent_id: str) {
    // Port of the decision logic: record poll and clean up stale entries
    let now = Instant_now();
    
    // Insert the new poll
    let new_poller = Poller { agent_id: agent_id, timestamp: now };
    self.pollers.append(new_poller);
    
    // Remove entries older than 1 hour (3600 seconds)
    let one_hour = Duration_from_secs(3600);
    self.pollers = PollersMap_retain(self.pollers, is_poller_fresh(now, one_hour));
}

pub fn browser_commands(state: AppState, agent_id: str) -> Value {
    // Port of the decision logic: record poll and get commands
    if (agent_id.len > 0) {
        BrowserState_record_poll(state.browser, agent_id);
    }
    
    let queue = state.browser.queue;  // Would be queue.lock().await in original
    let commands = BrowserCommandQueue_poll(queue, agent_id);
    
    return Value { "commands": commands };
}

pub fn browser_result(state: AppState, body: Value) -> Value {
    // Extract fields from the JSON body
    let command_id = body.get("command_id") ?? "";
    let ok = body.get("success") ?? false;
    let data = body.get("result") ?? null;
    let error = body.get("error") ?? "";
    
    // Validate command_id
    if (command_id.len == 0) {
        return Value { "error": "command_id is required" };
    }
    
    // Create the result object (would be BrowserResult in original)
    let result = BrowserResult {
        command_id: command_id,
        ok: ok,
        data: data,
        error: error,
        reported_at: "2024-01-01T00:00:00Z",  // Would be chrono::Utc::now().to_rfc3339() in original
    };
    
    // Record the result (would be queue.lock().await in original)
    let queue = state.browser.queue;
    BrowserCommandQueue_record_result(queue, result);
    
    return Value { "ok": true, "command_id": command_id };
}

pub fn enqueue_command(state: AppState, params: Value) -> Value {
    // Extract parameters from JSON
    let tool_name = params.get("tool") ?? "";
    let agent_id = params.get("agent_id") ?? "";
    let tool_params = params.get("params") ?? Value { };
    
    // Validate agent_id
    if (agent_id.len == 0) {
        return Value { "error": "agent_id is required" };
    }
    
    // Create browser command (would be BrowserCommand::from_tool_name in original)
    let cmd = undefined;  // This would involve complex tool name parsing in original
    
    if (cmd == undefined) {
        return Value { "error": "unknown browser tool: " + tool_name };
    }
    
    // Try to enqueue the command
    let queue = state.browser.queue;  // Would be queue.lock().await in original
    let enqueue_result = BrowserCommandQueue_try_enqueue(queue, cmd);
    
    if (enqueue_result.ok) {
        return Value { "queued": true, "command_id": enqueue_result.command_id };
    } else {
        return Value {
            "error": enqueue_result.error,
            "queue_full": true,
            "depth": enqueue_result.depth,
            "capacity": enqueue_result.capacity,
        };
    }
}

pub fn queue_stats(state: AppState) -> QueueStats {
    // Get queue statistics (would be state.browser.queue.lock().await.stats() in original)
    let queue = state.browser.queue;
    return BrowserCommandQueue_stats(queue);
}

// Test blocks ported from the original Rust tests
test browser_command_flow {
    // Test the complete flow: enqueue -> poll -> result -> poll_empty
    let state = AppState_new();
    
    // Enqueue a command
    let tool_result = enqueue_command(
        &state,
        Value {
            "tool": "browser_navigate",
            "agent_id": "browser-agent-42",
            "params": Value { "agent_id": "browser-agent-42", "url": "https://github.com" },
        },
    );
    assert(tool_result.get("queued") == true);
    let command_id = tool_result.get("command_id") ?? "";
    
    // Poll for commands
    let polled = browser_commands(&state, "browser-agent-42");
    let commands = polled.get("commands");
    assert(commands.len == 1);
    assert(commands[0].get("id") == command_id);
    
    // Report result
    let result = browser_result(
        &state,
        Value {
            "command_id": command_id,
            "success": true,
            "result": Value { "final_url": "https://github.com" },
        },
    );
    assert(result.get("ok") == true);
    
    // Poll again - should be empty
    let polled_again = browser_commands(&state, "browser-agent-42");
    let commands_again = polled_again.get("commands");
    assert(commands_again.len == 0);
}

test browser_tool_missing_agent_id {
    // Test error when agent_id is empty
    let state = AppState_new();
    let result = enqueue_command(
        &state,
        Value { "tool": "browser_navigate", "agent_id": "", "params": Value { } },
    );
    assert(result.get("error") != null);
}

test browser_result_missing_command_id {
    // Test error when command_id is missing
    let state = AppState_new();
    let result = browser_result(&state, Value { "success": true });
    assert(result.get("error") != null);
}

test browser_unknown_tool {
    // Test error for unknown tool
    let state = AppState_new();
    let result = enqueue_command(
        &state,
        Value { "tool": "browser_nonexistent", "agent_id": "a1", "params": Value { } },
    );
    assert(result.get("error") != null);
}

test browser_poll_empty_for_other_agent {
    // Test that commands are only returned for the correct agent
    let state = AppState_new();
    enqueue_command(
        &state,
        Value { "tool": "browser_navigate", "agent_id": "agent-A", "params": Value { "url": "https://a.com" } },
    );
    
    let polled = browser_commands(&state, "agent-B");
    let commands = polled.get("commands");
    assert(commands.len == 0);
}

test browser_result_recording_failure {
    // Test that failed results are recorded correctly
    let state = AppState_new();
    let tool_result = enqueue_command(
        &state,
        Value { "tool": "browser_get_url", "agent_id": "agent-X", "params": Value { } },
    );
    let command_id = tool_result.get("command_id") ?? "";
    
    let result = browser_result(
        &state,
        Value {
            "command_id": command_id,
            "success": false,
            "error": "tab not found",
        },
    );
    assert(result.get("ok") == true);
    
    // Verify the failure was recorded (would be queue.get_result in original)
    let queue = state.browser.queue;
    let recorded_result = queue.get_result(&command_id);
    assert(recorded_result.ok == false);
    assert(recorded_result.error == "tab not found");
}

test browser_active_agent_within_window {
    // Test active_agent logic within time window
    let state = BrowserState_new();
    
    // Record a poll for agent1
    state.BrowserState_record_poll("agent1");
    
    // Test that agent1 is active within window
    let active = state.BrowserState_active_agent(Duration_from_secs(60));
    assert(active == "agent1");
    
    // Test that agent1 is not active beyond window
    let active_old = state.BrowserState_active_agent(Duration_from_secs(0));
    assert(active_old == null);
}

test browser_active_agent_most_recent {
    // Test that most recent agent is returned within window
    let state = BrowserState_new();
    
    // Record polls for multiple agents
    state.BrowserState_record_poll("agent1");
    state.BrowserState_record_poll("agent2");
    
    // Test that agent2 (most recent) is returned
    let active = state.BrowserState_active_agent(Duration.from_secs(60));
    assert(active == "agent2");
}