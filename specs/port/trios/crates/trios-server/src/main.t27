// Port of gHashTag/trios crates/trios-server/src/main.rs at 8b229e9489ee
// -- the consolidated trios server: the env-driven listen port, tracing
// init, the AppState, the HTTP routes and axum::serve.
//
// Ported as pure, tested decisions -- each helper names the main.rs lines
// it comes from:
//   - the listen port: TRIOS_PORT, else TRIOS_MCP_PORT, else "9005". The
//     Rust chains the two env reads BEFORE it parses, so a set-but-
//     unparsable TRIOS_PORT never reaches the MCP fallback (lines 53-57)
//                                       -> resolve_port, parse_u16, digit_value
//   - the health probe answer "ok" (line 128)               -> health
//   - the build identity: name, CARGO_PKG_VERSION and
//     TRIOS_BUILD_SHA, "dev" when CI did not stamp it
//     (lines 134-140)                                       -> version
//   - the Hermes side of /api/adapters: which SUPPORTED_PROVIDER_TYPES
//     carry a mapping from trios_openclaw::get_mapping, in order
//     (lines 146-161)                            -> select_hermes_providers
//   - the text handed to ws_handler::handle_message: the request body
//     serialized, "" when serialization fails (line 164)
//                                        -> serialized_body_or_default
//   - the /api/status triple: status "ok", the agents count from the
//     state, tools::count() (lines 172-179)              -> api_status
//
// Kept as plumbing stubs with the original names and shapes, `undefined;`
// bodies, never called by tests -- each only moves data in or out:
//   - main: dotenv, operator token init, AppState::new_with_persistence,
//     the OpenAPI router, spawn_prune_loop, TCP bind on the resolved port
//     and axum::serve (lines 27-61)
//   - api_chat: request body in, ws_handler::handle_message(text, state)
//     out, the handler's answer wrapped as {"result": ...} (lines 163-170)
// The json!()/Json<Value> wrappers and the State extraction have no t27
// equivalent; the structs here carry the same fields.

module port::trios::crates::trios_server::src::main;

// main.rs line 57: `.unwrap_or(9005)` when neither env var yields a
// parsable port.
pub const DEFAULT_PORT: u16 = 9005;

// ---------------------------------------------------------------------------
// Plumbing stubs (data in / data out only; no tests call these).
// ---------------------------------------------------------------------------

// main, main.rs lines 27-61: reads the env chain (resolve_port below),
// inits tracing and the operator token, builds the persisted AppState,
// spawns the prune loop, binds the resolved port and serves the router.
// anyhow::Result<()> maps to an exit-code shape.
pub fn main() -> i32 {
    undefined;
}

// The ws_handler::handle_message answer is the only field of the
// {"result": ...} JSON that api_chat returns (main.rs lines 163-170).
pub struct ChatResponse {
    result: str,
}

// api_chat, main.rs lines 163-170: the POST body is deserialized, its
// serialized form goes to ws_handler::handle_message(text, state), and the
// handler's result is wrapped as JSON. The unwrap_or_default decision on
// the body text is serialized_body_or_default below.
pub fn api_chat(body_text: str, response_result: str) -> ChatResponse {
    undefined;
}

// ---------------------------------------------------------------------------
// The listen port (main.rs lines 53-57).
// ---------------------------------------------------------------------------

// One decimal digit; 10 marks "not a digit" (u16::from_str rejects it).
pub fn digit_value(c: u8) -> u16 {
    if (c == '0') {
        return 0;
    }
    if (c == '1') {
        return 1;
    }
    if (c == '2') {
        return 2;
    }
    if (c == '3') {
        return 3;
    }
    if (c == '4') {
        return 4;
    }
    if (c == '5') {
        return 5;
    }
    if (c == '6') {
        return 6;
    }
    if (c == '7') {
        return 7;
    }
    if (c == '8') {
        return 8;
    }
    if (c == '9') {
        return 9;
    }
    return 10;
}

// The outcome of u16::from_str for one env value.
pub struct ParsedU16 {
    ok: bool,
    value: u16,
}

// u16::from_str (main.rs lines 54-56): decimal digits only -- no sign, no
// spaces, no empty string -- and no value above 65535. The guard before
// the multiply keeps the u16 accumulator from overflowing, so "65536" and
// "99999" are rejected the way Rust's parser rejects them.
pub fn parse_u16(s: []const u8) -> ParsedU16 {
    if (s.len == 0) {
        return ParsedU16 { ok: false, value: 0 };
    }
    var n: u16 = 0;
    var i: usize = 0;
    while (i < s.len) {
        const d = digit_value(s[i]);
        if (d == 10) {
            return ParsedU16 { ok: false, value: 0 };
        }
        if (n > 6553) {
            return ParsedU16 { ok: false, value: 0 };
        }
        if (n == 6553 && d > 5) {
            return ParsedU16 { ok: false, value: 0 };
        }
        n = n * 10 + d;
        i += 1;
    }
    return ParsedU16 { ok: true, value: n };
}

// resolve_port, main.rs lines 53-57:
//   std::env::var("TRIOS_PORT")
//     .or_else(|_| std::env::var("TRIOS_MCP_PORT"))
//     .unwrap_or_else(|_| "9005".to_string())
//     .parse::<u16>()
//     .unwrap_or(9005)
// The or_else chain settles on ONE string before the single parse: a set
// TRIOS_PORT wins even when unparsable (then the parse fails into the
// 9005 default and TRIOS_MCP_PORT is never read). The *_set flags mark
// env::var returning Ok, which is why an empty-but-set TRIOS_PORT still
// short-circuits the chain.
pub fn resolve_port(trios_port_set: bool, trios_port: []const u8, trios_mcp_port_set: bool, trios_mcp_port: []const u8) -> u16 {
    var chosen: []const u8 = "9005";
    if (trios_port_set) {
        chosen = trios_port;
    } else if (trios_mcp_port_set) {
        chosen = trios_mcp_port;
    }
    const p = parse_u16(chosen);
    if (p.ok) {
        return p.value;
    }
    return DEFAULT_PORT;
}

// ---------------------------------------------------------------------------
// The routes.
// ---------------------------------------------------------------------------

// health, main.rs line 128: the readiness probe returns the literal "ok".
pub fn health() -> str {
    return "ok";
}

// The /version JSON (main.rs lines 134-140): the crate name, the package
// version, and the CI-stamped build sha.
pub struct VersionInfo {
    name: str,
    version: str,
    git_sha: str,
}

// version, main.rs lines 134-140:
//   "git_sha": option_env!("TRIOS_BUILD_SHA").unwrap_or("dev")
// option_env! is None when CI did not stamp the binary, so the sha falls
// back to "dev" -- the empty-string source never reaches the response.
pub fn version(pkg_version: str, has_build_sha: bool, build_sha: str) -> VersionInfo {
    var sha: str = "dev";
    if (has_build_sha) {
        sha = build_sha;
    }
    return VersionInfo { name: "trios-server", version: pkg_version, git_sha: sha };
}

// The Hermes providers of /api/adapters, main.rs lines 146-161:
//   SUPPORTED_PROVIDER_TYPES.iter().filter_map(|p| {
//       trios_openclaw::get_mapping(p).map(...)
//   })
// Fixed capacity 8; len is the kept count.
pub struct HermesList {
    items: [8]str,
    len: usize,
}

// The filter_map of main.rs lines 146-161: keep provider_types[i] exactly
// when has_mapping[i] is true (trios_openclaw::get_mapping answered),
// preserving the SUPPORTED_PROVIDER_TYPES order.
pub fn select_hermes_providers(provider_types: []str, has_mapping: []bool) -> HermesList {
    var out: HermesList = undefined;
    out.len = 0;
    var i: usize = 0;
    while (i < provider_types.len && i < has_mapping.len && out.len < 8) {
        if (has_mapping[i]) {
            out.items[out.len] = provider_types[i];
            out.len += 1;
        }
        i += 1;
    }
    return out;
}

// The /api/adapters JSON (main.rs lines 146-161): "adapters" is the
// trios_agent_harness::adapter_catalog() list carried through unchanged
// (a count here -- the catalog itself is opaque data from another crate),
// "hermesProviders" is the filtered list, "gatewayContainerPort" the
// trios_openclaw::OPENCLAW_GATEWAY_CONTAINER_PORT constant.
pub struct AdaptersResponse {
    adapter_count: usize,
    hermes: HermesList,
    gateway_container_port: u16,
}

// api_adapters, main.rs lines 146-161.
pub fn api_adapters(adapter_count: usize, gateway_port: u16, provider_types: []str, has_mapping: []bool) -> AdaptersResponse {
    return AdaptersResponse {
        adapter_count: adapter_count,
        hermes: select_hermes_providers(provider_types, has_mapping),
        gateway_container_port: gateway_port,
    };
}

// api_chat, main.rs line 164: serde_json::to_string(&body) is what reaches
// ws_handler::handle_message, and .unwrap_or_default() makes a body that
// fails to serialize reach the handler as "".
pub fn serialized_body_or_default(ok: bool, text: str) -> str {
    if (ok) {
        return text;
    }
    return "";
}

// The /api/status JSON (main.rs lines 172-179): status "ok" while the
// agent harness is up, plus the agents count read from the state and
// tools::count().
pub struct StatusResponse {
    status: str,
    agents: usize,
    tools: usize,
}

// api_status, main.rs lines 172-179.
pub fn api_status(agents: usize, tools: usize) -> StatusResponse {
    return StatusResponse { status: "ok", agents: agents, tools: tools };
}

// ---------------------------------------------------------------------------
// Tests, one per ported decision.
// ---------------------------------------------------------------------------

test resolve_port_prefers_trios_port {
    assert(DEFAULT_PORT == 9005);
    assert(resolve_port(true, "9100", true, "9200") == 9100);
    assert(resolve_port(true, "9100", false, "") == 9100);
}

test resolve_port_falls_back_to_trios_mcp_port {
    // TRIOS_PORT unset: the or_else arm reads TRIOS_MCP_PORT.
    assert(resolve_port(false, "", true, "9200") == 9200);
}

test resolve_port_set_but_unparsable_primary_skips_mcp_fallback {
    // main.rs lines 53-57: the env chain settles on ONE string before the
    // single parse, so an unparsable TRIOS_PORT fails into 9005 and
    // TRIOS_MCP_PORT is never read.
    assert(resolve_port(true, "abc", true, "9200") == 9005);
    // An empty-but-set TRIOS_PORT is still the chosen string: Rust's
    // env::var answers Ok("") and or_else is not entered.
    assert(resolve_port(true, "", true, "9200") == 9005);
    // Neither var set: the "9005" default string parses to 9005.
    assert(resolve_port(false, "", false, "") == 9005);
    // Signs are not digits for u16::from_str.
    assert(resolve_port(true, "+9005", false, "") == 9005);
}

test parse_u16_mirrors_rust_from_str {
    const ok = parse_u16("9005");
    assert(ok.ok && ok.value == 9005);
    const zero = parse_u16("0");
    assert(zero.ok);
    const lead = parse_u16("09005");
    assert(lead.ok && lead.value == 9005);
    const max = parse_u16("65535");
    assert(max.ok && max.value == 65535);
    assert(!parse_u16("65536").ok);
    assert(!parse_u16("").ok);
    assert(!parse_u16("90 05").ok);
    assert(!parse_u16("9.5").ok);
}

test health_returns_ok {
    assert(health() == "ok");
}

test version_reports_dev_sha_without_ci_stamp {
    const v = version("0.4.1", false, "");
    assert(v.name == "trios-server");
    assert(v.version == "0.4.1");
    assert(v.git_sha == "dev");
}

test version_honours_stamped_sha {
    const v = version("0.4.1", true, "8b229e9489ee");
    assert(v.version == "0.4.1");
    assert(v.git_sha == "8b229e9489ee");
}

test hermes_providers_keep_only_mapped_types_in_order {
    var types: [3][]const u8 = ["openai", "anthropic", "ollama"];
    var mapped: [3]bool = [true, false, true];
    const h = select_hermes_providers(&types, &mapped);
    assert(h.len == 2);
    assert(h.items[0] == "openai");
    assert(h.items[1] == "ollama");
}

test hermes_providers_empty_and_full {
    var types: [2][]const u8 = ["openai", "ollama"];
    var none: [2]bool = [false, false];
    const empty = select_hermes_providers(&types, &none);
    assert(empty.len == 0);
    // get_mapping answers for every supported type in the consolidated
    // build: all kept, in order.
    var all: [2]bool = [true, true];
    const full = select_hermes_providers(&types, &all);
    assert(full.len == 2);
    assert(full.items[0] == "openai");
    assert(full.items[1] == "ollama");
}

test api_adapters_shape_matches_the_original_json {
    var types: [3][]const u8 = ["openai", "anthropic", "ollama"];
    var mapped: [3]bool = [true, true, false];
    const r = api_adapters(4, 18789, &types, &mapped);
    assert(r.adapter_count == 4);
    assert(r.gateway_container_port == 18789);
    assert(r.hermes.len == 2);
    assert(r.hermes.items[0] == "openai");
    assert(r.hermes.items[1] == "anthropic");
}

test serialized_body_falls_back_to_empty_string {
    assert(serialized_body_or_default(true, "hello") == "hello");
    assert(serialized_body_or_default(false, "hello") == "");
}

test api_status_shape_matches_the_original_json {
    const r = api_status(2, 7);
    assert(r.status == "ok");
    assert(r.agents == 2);
    assert(r.tools == 7);
}
