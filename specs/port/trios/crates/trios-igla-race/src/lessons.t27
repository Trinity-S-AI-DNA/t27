module port::trios::crates::trios_igla_race::src::lessons;

/// Lesson type for categorizing patterns
pub enum LessonType {
    Avoid,    // "AVOID: ..." — definite anti-pattern
    Pattern,  // "PATTERN: ..." — observed pattern
    Winner,   // "WINNER: ..." — successful config
    Warn,     // "WARN: ..." — potential issue
    Info,     // "INFO: ..." — neutral observation
}

/// Trial outcome
pub enum Outcome {
    Pruned,
    Failed,
    Slow,
    Unstable,
    Timeout,
}

/// Trial configuration for analysis
pub struct TrialConfig {
    pub lr: f64,
    pub d_model: usize,
    pub hidden: usize,
    pub n_layers: usize,
    pub optimizer: str,
    pub activation: str,
    pub weight_decay: f64,
    pub dropout: f64,
    pub warmup_steps: usize,
    pub max_steps: usize,
}

/// Lesson result
pub struct LessonResult {
    pub lesson: str,
    pub lesson_type: LessonType,
}

/// ASHA rung data
pub struct RungData {
    pub step: usize,
    pub bpb: f64,
}

pub fn LessonType_fmt(self: LessonType, f: ?str) -> str {
    switch (self) {
        .Avoid => "AVOID",
        .Pattern => "PATTERN",
        .Winner => "WINNER",
        .Warn => "WARN",
        .Info => "INFO",
    }
}

pub fn Outcome_fmt(self: Outcome, f: ?str) -> str {
    switch (self) {
        .Pruned => "pruned",
        .Failed => "failed",
        .Slow => "slow",
        .Unstable => "unstable",
        .Timeout => "timeout",
    }
}

pub fn generate_lesson(
    config: &TrialConfig,
    rung: &RungData,
    outcome: Outcome,
) -> LessonResult {
    var best_lesson: LessonResult = LessonResult { .lesson = "", .lesson_type = LessonType.Info };
    var best_priority: usize = 999;

    // Analyze learning rate
    if (config.lr > 0.05) {
        const lesson = LessonResult { .lesson = "AVOID: lr too high — BPB high at rung, always pruned", .lesson_type = LessonType.Avoid };
        const priority = 0;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    } else if (config.lr < 0.001) {
        const lesson = LessonResult { .lesson = "WARN: lr too low — may not converge", .lesson_type = LessonType.Warn };
        const priority = 2;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // Analyze model capacity
    if (config.d_model <= 64 and rung.bpb > 2.8) {
        const lesson = LessonResult { .lesson = "PATTERN: d_model insufficient capacity, never below BPB", .lesson_type = LessonType.Pattern };
        const priority = 1;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // Analyze hidden size
    if (config.hidden < 32) {
        const lesson = LessonResult { .lesson = "WARN: hidden too small — limited expressiveness", .lesson_type = LessonType.Warn };
        const priority = 2;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // Analyze weight decay
    if (config.weight_decay > 0.1 and rung.bpb > 3.0) {
        const lesson = (
            format("AVOID: weight_decay={} too aggressive — causes underfitting", config.weight_decay),
            LessonType.Avoid
        );
        const priority = 0;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // Analyze optimizer
    if (config.optimizer.contains("sgd") and rung.bpb > 2.7) {
        const lesson = LessonResult { .lesson = "PATTERN: SGD optimizer underperforms — use AdamW or Muon", .lesson_type = LessonType.Pattern };
        const priority = 1;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // Early pruning pattern
    if (rung.step <= 1000 and rung.bpb > 3.0) {
        const lesson = LessonResult { .lesson = "AVOID: BPB too high — early death, check config", .lesson_type = LessonType.Avoid };
        const priority = 0;
        if (priority < best_priority) {
            best_priority = priority;
            best_lesson = lesson;
        }
    }

    // If no specific lessons, generate generic one
    if (best_priority == 999) {
        best_lesson = LessonResult { .lesson = "INFO: trial info at BPB average", .lesson_type = LessonType.Info };
    }

    return best_lesson;
}

pub fn store_lesson(
    outcome: Outcome,
    pruned_at_rung: i32,
    bpb_at_pruned: f64,
    lesson: str,
    lesson_type: str,
) -> i32 {
    undefined;
}

pub fn get_top_lessons(
    limit: i32,
) -> i32 {
    undefined;
}

test lesson_high_lr {
    const config = TrialConfig {
        lr: 0.07,
        d_model: 128,
        hidden: null,
        n_layers: null,
        optimizer: null,
        activation: null,
        weight_decay: null,
        dropout: null,
        warmup_steps: null,
        max_steps: null,
    };

    const rung = RungData { step: 1000, bpb: 3.4 };
    const (lesson, lesson_type) = generate_lesson(&config, &rung, Outcome.Pruned);

    assert_eq(lesson_type, LessonType.Avoid);
    assert(lesson.contains("lr=0.07"));
    assert(lesson.contains("too high"));
}

test lesson_small_model {
    const config = TrialConfig {
        lr: 0.004,
        d_model: 64,
        hidden: 0,
        n_layers: 0,
        optimizer: "",
        activation: "",
        weight_decay: 0.0,
        dropout: 0.0,
        warmup_steps: 0,
        max_steps: 0,
    };

    const rung = RungData { step: 1000, bpb: 2.9 };
    const (lesson, _lesson_type) = generate_lesson(&config, &rung, Outcome.Pruned);

    assert(lesson.contains("d_model=64"));
}

test lesson_early_death {
    const config = TrialConfig {
        lr: 0.01,
        d_model: 128,
        hidden: 0,
        n_layers: 0,
        optimizer: "",
        activation: "",
        weight_decay: 0.0,
        dropout: 0.0,
        warmup_steps: 0,
        max_steps: 0,
    };

    const rung = RungData { step: 1000, bpb: 3.2 };
    const (lesson, _lesson_type) = generate_lesson(&config, &rung, Outcome.Pruned);

    assert(lesson.contains("BPB=3.2"));
    assert(lesson.contains("rung-1000"));
}

test lesson_type_priority {
    const config = TrialConfig {
        lr: 0.07,
        d_model: 32,
        hidden: 16,
        n_layers: 0,
        optimizer: "",
        activation: "",
        weight_decay: 0.0,
        dropout: 0.0,
        warmup_steps: 0,
        max_steps: 0,
    };

    const rung = RungData { step: 1000, bpb: 3.5 };
    const (_lesson, lesson_type) = generate_lesson(&config, &rung, Outcome.Pruned);

    // Should prioritize AVOID lessons
    assert_eq(lesson_type, LessonType.Avoid);
}

test lesson_low_lr_warning {
    const config = TrialConfig {
        lr: 0.0005,
        d_model: 128,
        hidden: 0,
        n_layers: 0,
        optimizer: "",
        activation: "",
        weight_decay: 0.0,
        dropout: 0.0,
        warmup_steps: 0,
        max_steps: 0,
    };

    const rung = RungData { step: 500, bpb: 2.5 };
    const (lesson, lesson_type) = generate_lesson(&config, &rung, Outcome.Slow);

    assert_eq(lesson_type, LessonType.Warn);
    assert(lesson.contains("lr=0.0005"));
    assert(lesson.contains("too low"));
}

test store_lesson_basic {
    const result = store_lesson(
        Outcome.Pruned,
        1000,
        3.4,
        "test lesson",
        "AVOID"
    );
    assert(result == 0);
}

test get_top_lessons_basic {
    const result = get_top_lessons(10);
    assert(result == 0);
}