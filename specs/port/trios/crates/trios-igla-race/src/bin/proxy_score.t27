// Proxy scoring toolkit — port of the trios proxies library (Rust): the
// zero-cost architecture proxies (SynFlow, GradNorm, Jacobian-covariance,
// Spearman bootstrap) and their ensembles for a model candidate.
// Following the sibling port convention: main and the functions that move
// data through the loaded model or the registry keep an `undefined` body
// (plumbing), and the extracted pure decision helpers carry the tests.
module port::trios::crates::trios_igla_race::src::bin;

/// Which proxy combination the binary should report for a candidate.
pub enum ScoreFamily {
    /// Raw zero-cost proxies plus the rank proxy over the history.
    Rank,
    /// Spearman correlation of the proxy ensemble with the history.
    Spearman,
}

/// Resolved per-candidate settings (original clap Args -> config).
pub struct ProxyConfig {
    pub model_id: []const u8,
}

/// One historical score record feeding the Spearman proxy.
pub struct HistoricalDataPoint {
    pub is_correct: bool,
}

/// Parsed command line (original clap derive struct).
pub struct Args {
    pub model_id: []const u8,
}

/// Original main() exit codes.
pub const EXIT_OK: i32 = 0;
pub const EXIT_UNKNOWN_MODEL: i32 = 1;

// ---- Decision helpers (tested) ----

/// Ensemble of the available proxy scores (original ensemble fallback):
/// mean of the non-null members; null when no member has a score.
pub fn ensemble_of_available(synflow: ?f64, gradnorm: ?f64, jacobian: ?f64) -> ?f64 {
    var sum: f64 = 0.0;
    var count: usize = 0;
    if (synflow != null) {
        sum = sum + synflow.?;
        count = count + 1;
    }
    if (gradnorm != null) {
        sum = sum + gradnorm.?;
        count = count + 1;
    }
    if (jacobian != null) {
        sum = sum + jacobian.?;
        count = count + 1;
    }
    if (count == 0) {
        return null;
    }
    return sum / (count as f64);
}

/// Majority vote over correctness votes (original bootstrap vote): true only
/// on a strict majority; ties fail.
pub fn majority_vote(votes: []const bool) -> bool {
    var trues: usize = 0;
    var i: usize = 0;
    while (i < votes.len) {
        if (votes[i]) {
            trues = trues + 1;
        }
        i = i + 1;
    }
    return trues * 2 > votes.len;
}

// ---- Plumbing stubs (`undefined` bodies; never called from tests) ----

/// Plumbing: resolves the model id through the model registry (I/O).
pub fn build_config(args: ?Args) -> ?ProxyConfig {
    undefined;
}

/// Plumbing: SynFlow needs a forward/backward pass through the loaded model.
pub fn compute_synflow(config: ProxyConfig) -> ?f64 {
    undefined;
}

/// Plumbing: GradNorm needs gradient norms through the loaded model.
pub fn compute_gradnorm(config: ProxyConfig) -> ?f64 {
    undefined;
}

/// Plumbing: Jacobian covariance needs per-layer Jacobians of the model.
pub fn compute_jacobian_cov(config: ProxyConfig) -> ?f64 {
    undefined;
}

/// Plumbing: Spearman needs the historical score records (I/O).
pub fn compute_spearman(config: ProxyConfig, history: []const HistoricalDataPoint) -> ?f64 {
    undefined;
}

/// Plumbing: dispatches on the score family and combines the raw proxies.
pub fn compute_ensemble_score(config: ProxyConfig, family: ?ScoreFamily, history: []const HistoricalDataPoint) -> ?f64 {
    undefined;
}

// ---- Entry point ----

// Port of the proxy_score binary main(): clap-parses --model/--epochs/--json/
// --history, resolves the model through the registry, computes the requested
// score family and prints it. All of that is I/O plumbing, so per the sibling
// convention the body stays `undefined` and returns the unknown-model exit
// code (EXIT_UNKNOWN_MODEL) on registry misses, EXIT_OK otherwise.
pub fn main(argc: u32, model: []const u8) -> i32 {
    undefined;
}

// ---- Tests ----

test ensemble_mean_uses_only_available_members {
    // 1.0 + 2.0 + 3.0 over 3 members → exactly 2.0 in binary floats.
    assert(ensemble_of_available(1.0, 2.0, 3.0) == 2.0);
}

test ensemble_partial_takes_present_members {
    assert(ensemble_of_available(4.0, null, null) == 4.0);
    assert(ensemble_of_available(3.0, 5.0, null) == 4.0);
}

test ensemble_without_any_score_is_null {
    assert(ensemble_of_available(null, null, null) == null);
}

test majority_vote_requires_strict_majority {
    const votes: [3]bool = [true, true, false];
    assert(majority_vote(&votes));
}

test majority_vote_ties_fail {
    const votes: [2]bool = [true, false];
    assert(!majority_vote(&votes));
    const none: [2]bool = [false, false];
    assert(!majority_vote(&none));
}

test majority_vote_single_true_wins {
    const votes: [1]bool = [true];
    assert(majority_vote(&votes));
}
