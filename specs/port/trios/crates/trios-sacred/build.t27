// trios-sacred build script — the cargo directives the crate emits for the
// vendored Zig sacred-geometry library.
// Port of gHashTag/trios:crates/trios-sacred/build.rs
// (at 8b229e9489ee, 27 lines) — Roadmap Stage 6, goal #4548, target t27c gen-rust.
//
// The original is a build.rs: it runs `zig build` in the vendored
// `vendor/zig-sacred-geometry` when its `build.zig` is present, then prints
// cargo directives — the `has_zig_lib` cfg, the link-search path and the
// link-lib name when the built `libsacred_geometry.a` exists, and the
// rerun-if-changed path always. The process spawn, the filesystem probes and
// the prints are plumbing; the decisions the file makes — the vendored path
// constant, the build gate on `build.zig`, the build invocation shape, the
// library layout, the link flags that fire only when the static library
// exists (in the original's order), and the always-emitted rerun line — are
// ported here as pure functions and tested. The `main` transport keeps its
// name with an `undefined;` body that no test calls (issue #9508,
// "Port the decision, not the plumbing").
//
// The link-search line carries the runtime `lib_dir` (the build script's
// current directory joined with the vendored layout), so the port carries its
// template choice as a constant prefix; the join itself is `main`'s plumbing.

module port::trios_sacred_build;

// ---------------------------------------------------------------------------
// Original line 5: `let zig_path = "vendor/zig-sacred-geometry";`.
// The vendored Zig library's path inside the crate, as a constant: every
// other decision in the file reads from it.
// ---------------------------------------------------------------------------

pub fn zig_vendor_path() -> str {
    return "vendor/zig-sacred-geometry";
}

// ---------------------------------------------------------------------------
// Original line 7: `if PathBuf::from(zig_path).join("build.zig").exists() {`.
// The build step fires exactly when the vendored `build.zig` is present:
// the filesystem probe is plumbing, the gate on its answer is the decision.
// ---------------------------------------------------------------------------

pub fn should_build_zig(build_zig_exists: bool) -> bool {
    return build_zig_exists;
}

// ---------------------------------------------------------------------------
// Original lines 8-11: `Command::new("zig").args(["build",
// "-Doptimize=ReleaseFast"]).current_dir(zig_path)`. The invocation runs
// `zig` with two arguments in this order, in the vendored directory. The
// process spawn is plumbing; the argument shape is the decision.
// ---------------------------------------------------------------------------

pub fn build_arg_count() -> usize {
    return 2;
}

pub fn optimize_flag() -> str {
    return "-Doptimize=ReleaseFast";
}

// ---------------------------------------------------------------------------
// Original lines 14-18: `let lib_dir = std::env::current_dir().unwrap()
// .join(zig_path).join("zig-out/lib"); let static_lib =
// lib_dir.join("libsacred_geometry.a");`. The built library lands at
// `<cwd>/<vendored>/zig-out/lib` and the static artifact is
// `libsacred_geometry.a`. The current directory is plumbing; the layout
// below it — the vendored path and the two fixed joins — is the decision.
// ---------------------------------------------------------------------------

pub fn lib_dir_suffix() -> str {
    return "vendor/zig-sacred-geometry/zig-out/lib";
}

pub fn static_lib_name() -> str {
    return "libsacred_geometry.a";
}

// ---------------------------------------------------------------------------
// Original lines 19-23: `if static_lib.exists() { println!(
// "cargo:rustc-cfg=has_zig_lib"); println!("cargo:rustc-link-search=
// native={}", lib_dir.display()); println!("cargo:rustc-link-lib=static=
// sacred_geometry"); }`. Exactly three directives fire when the static
// library exists, in this order, and none when it does not. The
// link-search template carries the runtime `lib_dir` after its prefix.
// ---------------------------------------------------------------------------

pub fn link_flag_count(static_lib_exists: bool) -> usize {
    if (static_lib_exists) {
        return 3;
    }
    return 0;
}

pub fn cargo_cfg_line() -> str {
    return "cargo:rustc-cfg=has_zig_lib";
}

pub fn link_search_prefix() -> str {
    return "cargo:rustc-link-search=native=";
}

pub fn cargo_lib_line() -> str {
    return "cargo:rustc-link-lib=static=sacred_geometry";
}

// ---------------------------------------------------------------------------
// Original line 25: `println!("cargo:rerun-if-changed={}/src", zig_path);`.
// The rerun directive is emitted unconditionally, watching the vendored
// library's sources; the whole line is the constant path joined with
// `/src`, carried here as the composed literal.
// ---------------------------------------------------------------------------

pub fn rerun_line() -> str {
    return "cargo:rerun-if-changed=vendor/zig-sacred-geometry/src";
}

// ---------------------------------------------------------------------------
// Original lines 4-26: `fn main() { ... }`. The build script itself: probe
// `build.zig`, spawn `zig build`, probe the static library, print the cargo
// directives. Every world-touching step is this transport's job; no
// decision lives here that is not ported and tested above.
// ---------------------------------------------------------------------------

pub fn main() {
    return undefined; // plumbing: build.rs probes, spawns zig and prints (lines 4-26)
}

// ---------------------------------------------------------------------------
// Tests: every decision above asserted against values read from the
// original. No test calls a transport.
// ---------------------------------------------------------------------------

test vendor_path_constant {
    assert(zig_vendor_path() == "vendor/zig-sacred-geometry");
}

test build_gate_mirrors_build_zig_presence {
    assert(should_build_zig(true));
    assert(!should_build_zig(false));
}

test build_invocation_shape {
    assert(build_arg_count() == 2);
    assert(optimize_flag() == "-Doptimize=ReleaseFast");
}

test vendored_library_layout {
    assert(lib_dir_suffix() == "vendor/zig-sacred-geometry/zig-out/lib");
    assert(static_lib_name() == "libsacred_geometry.a");
}

test link_flags_fire_only_when_static_lib_exists {
    assert(link_flag_count(true) == 3);
    assert(link_flag_count(false) == 0);
}

test link_flag_lines_in_original_order {
    assert(cargo_cfg_line() == "cargo:rustc-cfg=has_zig_lib");
    assert(link_search_prefix() == "cargo:rustc-link-search=native=");
    assert(cargo_lib_line() == "cargo:rustc-link-lib=static=sacred_geometry");
}

test rerun_line_always_emitted {
    assert(rerun_line() == "cargo:rerun-if-changed=vendor/zig-sacred-geometry/src");
}
