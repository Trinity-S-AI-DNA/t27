// Port of gHashTag/trios crates/trios-rainbow-bridge/src/merkle.rs (103 lines, at
// 78671ba79482) to .t27, roadmap stage 6 (t27c gen-rust; issue #12573).
//
// The original is a 32-byte blake3 append-only log: root_{n+1} = blake3(root_n ||
// event_bytes). blake3 and serde_json are the plumbing -- the digest arrives here as
// a parameter and the chain only records it. What is ported is the decision: the
// chain starts at the zero root, every append takes the digest it is given and grows
// the length by exactly one, and the root is rendered as lowercase hex, two
// characters per byte.
//
// Two deviations from the original's signature, both named rather than hidden:
//   - `hex_encode` takes the 32-byte root and writes into a fixed 64-byte buffer
//     instead of allocating a String: .t27 has no allocator in this corpus and the
//     root is the only caller (line 34).
//   - `MerkleChain_append` takes the resulting digest instead of an `&RainbowEvent`:
//     serialising the event and hashing root||bytes is the caller's side of the
//     boundary, and neither is expressible as a pure .t27 function.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trios::crates::trios_rainbow_bridge::src::merkle;

pub const ROOT_BYTES: usize = 32;
pub const HEX_CHARS: usize = 64;
pub const NIBBLE_MASK: u8 = 15;
pub const NIBBLE_SHIFT: u8 = 4;

// merkle.rs line 22: `Self::default()` -- a derived Default, which for a 32-byte
// array is the zero root and for `usize` is 0.
const ZERO_ROOT: [32]u8 = [_]u8{0} ** 32;

// merkle.rs lines 13-16: root plus the number of events absorbed.
struct MerkleChain {
    root: [32]u8,
    length: usize,
}

// merkle.rs lines 21-23: start from the zero root.
pub fn MerkleChain_new() -> MerkleChain {
    return MerkleChain { root: ZERO_ROOT, length: 0 };
}

// merkle.rs lines 27-29: the current root, by value.
pub fn MerkleChain_root(self: MerkleChain) -> [32]u8 {
    return self.root;
}

// merkle.rs lines 33-35: the current root as lowercase hex (convenience for the
// jsonl logs). The original returns String; here it is the fixed 64-character
// buffer that a 32-byte root always needs.
pub fn MerkleChain_root_hex(self: MerkleChain) -> [64]u8 {
    return hex_encode(self.root);
}

// merkle.rs lines 39-41: how many events have been absorbed.
pub fn MerkleChain_len(self: MerkleChain) -> usize {
    return self.length;
}

// merkle.rs lines 45-47: no events absorbed yet.
pub fn MerkleChain_is_empty(self: MerkleChain) -> bool {
    return self.length == 0;
}

// merkle.rs lines 50-58: absorb one event. The original serialises the event, feeds
// root||bytes to blake3 and stores the digest; that hashing is the plumbing and
// arrives here as `event_digest`. The decision the port keeps is the one the two
// tests below can assert: the root becomes that digest and the length grows by one,
// so two chains fed the same event stay equal and a root never moves on its own.
pub fn MerkleChain_append(self: MerkleChain, event_digest: [32]u8) -> MerkleChain {
    return MerkleChain { root: event_digest, length: self.length + 1 };
}

// merkle.rs lines 61-67: `format!("{b:02x}")` per byte -- lowercase, two characters
// per byte, high nibble first.
pub fn hex_encode(bytes: [32]u8) -> [64]u8 {
    var out: [64]u8 = [_]u8{0} ** 64;
    var i: usize = 0;
    while (i < ROOT_BYTES) {
        const hi: u8 = bytes[i] >> NIBBLE_SHIFT;
        const lo: u8 = bytes[i] & NIBBLE_MASK;
        out[i * 2] = hex_digit(hi);
        out[i * 2 + 1] = hex_digit(lo);
        i += 1;
    }
    return out;
}

// merkle.rs line 64: the `02x` format fills one hex character per nibble. Lowercase
// by construction: 'a'..'f' are the ASCII codes the original produces for 10..15.
pub fn hex_digit(value: u8) -> u8 {
    if (value < 10) {
        return '0' + value;
    }
    return 'a' + (value - 10);
}

test new_starts_at_zero_root {
    const m = MerkleChain_new();
    assert(MerkleChain_is_empty(m));
    assert(MerkleChain_len(m) == 0);
    const root = MerkleChain_root(m);
    var i: usize = 0;
    while (i < ROOT_BYTES) {
        assert(root[i] == 0);
        i += 1;
    }
}

test append_changes_root_deterministically {
    var digest: [32]u8 = [_]u8{0} ** 32;
    digest[0] = 1;
    const a = MerkleChain_append(MerkleChain_new(), digest);
    const b = MerkleChain_append(MerkleChain_new(), digest);
    const ra = MerkleChain_root(a);
    const rb = MerkleChain_root(b);
    assert(ra[0] == 1);
    assert(rb[0] == 1);
    assert(ra[0] != 0);
}

test append_increments_length {
    var digest: [32]u8 = [_]u8{0} ** 32;
    digest[0] = 7;
    const one = MerkleChain_append(MerkleChain_new(), digest);
    assert(MerkleChain_len(one) == 1);
    digest[0] = 8;
    const two = MerkleChain_append(one, digest);
    assert(MerkleChain_len(two) == 2);
    assert(MerkleChain_len(one) == 1);
}

test append_is_never_empty {
    var digest: [32]u8 = [_]u8{0} ** 32;
    const one = MerkleChain_append(MerkleChain_new(), digest);
    assert(!MerkleChain_is_empty(one));
}

test root_is_the_given_digest {
    var digest: [32]u8 = [_]u8{0} ** 32;
    digest[31] = 0xFF;
    const m = MerkleChain_append(MerkleChain_new(), digest);
    const root = MerkleChain_root(m);
    assert(root[31] == 255);
    assert(root[0] == 0);
}

test hex_of_zero_root_is_64_zeros {
    const m = MerkleChain_new();
    const h = MerkleChain_root_hex(m);
    var i: usize = 0;
    while (i < HEX_CHARS) {
        assert(h[i] == '0');
        i += 1;
    }
}

test hex_is_lowercase_and_two_per_byte {
    var digest: [32]u8 = [_]u8{0} ** 32;
    digest[0] = 0xAB;
    digest[1] = 0x0F;
    const h = hex_encode(digest);
    assert(h[0] == 'a');
    assert(h[1] == 'b');
    assert(h[2] == '0');
    assert(h[3] == 'f');
    assert(h[4] == '0');
    assert(h[63] == '0');
}

test hex_digit_lowercase_nibbles {
    assert(hex_digit(0) == '0');
    assert(hex_digit(9) == '9');
    assert(hex_digit(10) == 'a');
    assert(hex_digit(15) == 'f');
}

test chain_is_append_only {
    var digest: [32]u8 = [_]u8{0} ** 32;
    var m = MerkleChain_new();
    var n: usize = 0;
    while (n < 4) {
        digest[0] = n as u8;
        m = MerkleChain_append(m, digest);
        assert(MerkleChain_len(m) == n + 1);
        n += 1;
    }
    assert(!MerkleChain_is_empty(m));
}
