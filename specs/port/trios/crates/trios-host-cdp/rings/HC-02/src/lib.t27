// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trios/crates/trios-host-cdp/rings/HC-02/src/lib.t27
//
// Port of the trios Rust source crates/trios-host-cdp/rings/HC-02/src/lib.rs
// (173 lines at 8b229e9489ee) to t27, so the ring is generated from this spec
// instead of hand-written Rust.
//
// HC-02 is the host agent's poll loop. It speaks the trios-server WS
// protocol (`{method, params}` -> `{result}`): `browser/poll {agent_id}`
// fetches pending SR-03 commands, each command is executed through a
// CommandExecutor (HC-01 over CDP), and `browser/result {command_id,
// agent_id, success, result, error}` reports the outcome. The server
// interleaves broadcast `{"event": ...}` frames on the same socket; those
// are skipped. Connection loss triggers a reconnect with a backoff.
//
// Port the decision, not the plumbing: socket I/O, the JSON codec, logging,
// timers and the environment reads stay at the Rust call site and enter here
// as plain parameters -- `set` flags stand for the Result of each
// `std::env::var`, per-frame facts for each WS message, a pre-serialised
// params string at the send boundary. Everything that DECIDES is a pure
// function below and is tested. The five original function names are kept;
// the four that only move data in or out keep their names with `undefined;`
// bodies that no test calls.
//
// Not expressible here, kept in Rust at the call site: the `T: CdpCall`
// generic of CdpExecutor (no generics in t27), `serde_json::Value` (the
// facts the logic reads are typed fields instead), tokio's async/await and
// `Duration`s (milliseconds as integers), and the `tracing` calls.

module port::trios::crates::trios_host_cdp::rings::HC_02;

// ----------------------------------------------------------------------
// The protocol
// ----------------------------------------------------------------------

// `browser/poll` -- fetch pending commands (lib.rs, poll_round, line 104).
pub const METHOD_POLL: []const u8 = "browser/poll";

// `browser/result` -- report one command outcome (lib.rs, line 126).
pub const METHOD_RESULT: []const u8 = "browser/result";

// Per-frame wait of ws_call: `tokio::time::timeout(Duration::from_secs(30),
// ...)` (line 82).
pub const WS_CALL_TIMEOUT_MS: u64 = 30000;

// ws_call scans frames until one carries a result; no frame left means the
// 30 s timeout fired or the socket closed (lines 82-85).
pub const WS_NO_RESULT: usize = 4294967295;

// ----------------------------------------------------------------------
// ws_call (lines 73-95)
// ----------------------------------------------------------------------

// One incoming WS frame, reduced to the three facts ws_call reads: is it a
// `Message::Text`, is it an `{"event": ...}` broadcast, and does it carry a
// `result`.
pub struct WsFrame {
    pub is_text: bool,
    pub is_event: bool,
    pub has_result: bool,
}

// The receive loop of ws_call: take the first text frame that is neither a
// non-text frame nor an `{"event": ...}` broadcast and carries a `result`;
// skip everything else (lines 81-93). WS_NO_RESULT stands in for the
// original's two error exits -- timed out, or socket closed.
pub fn ws_pick_result(frames: []const WsFrame) -> usize {
    for i in 0..frames.len {
        const frame = frames[i];
        if (!frame.is_text) {
            continue; // `let Message::Text(text) = msg else { continue };`
        }
        if (frame.is_event) {
            continue; // broadcast noise on the same socket
        }
        if (frame.has_result) {
            return i; // `value.get("result")` -> Ok(result.clone())
        }
    }
    return WS_NO_RESULT;
}

// Send one `{method, params}` request and wait for the next `{result}`
// frame, skipping interleaved `{"event": ...}` broadcasts. The send, the
// 30 s timeout, the socket and the JSON codec stay in Rust; the frame
// decision is ws_pick_result above. `params_json` is the caller's
// serialised `params` value. Data in, data out -- no test calls this.
pub fn ws_call(method: []const u8, params_json: []const u8) {
    undefined;
}

// ----------------------------------------------------------------------
// The executor (lines 21-37)
// ----------------------------------------------------------------------

// An SR-03 command as `browser/poll` delivers it, with the two fields HC-02
// reads when executing and reporting (poll_round, lines 113-129).
pub struct BrowserCommand {
    pub id: []const u8,
    pub command_type: []const u8,
}

// The `(success, result, error)` triple of poll_round's match over the
// executor's `Result<Value>` (lines 113-116), with `Value::Null` folded
// into flags.
pub struct CommandOutcome {
    pub success: bool,
    pub has_result: bool,
    pub has_error: bool,
}

// `Ok(data) => (true, data, Value::Null)` /
// `Err(err) => (false, Value::Null, json!(err.to_string()))`.
pub fn command_outcome(executed_ok: bool) -> CommandOutcome {
    if (executed_ok) {
        return CommandOutcome { success: true, has_result: true, has_error: false };
    }
    return CommandOutcome { success: false, has_result: false, has_error: true };
}

// The HC-01 executor over any CDP transport. `execute` is a bare delegation
// to `trios_host_cdp_hc01::execute_command` (line 35); that decision is
// ported with HC-01, not here. Data in, data out -- no test calls this.
pub fn CdpExecutor_execute(command: BrowserCommand) {
    undefined;
}

// ----------------------------------------------------------------------
// poll_round (lines 97-138)
// ----------------------------------------------------------------------

// `polled.get("commands").cloned().unwrap_or(json!([]))` (lines 105-107): a
// reply with no `commands` field polls as an empty batch, and the round
// returns how many commands it processed (lines 110, 137).
pub fn round_command_count(commands_present: bool, commands_len: usize) -> usize {
    if (commands_present) {
        return commands_len;
    }
    return 0;
}

// The `browser/result` payload (lines 124-134): `result` is the executor's
// value on success and `Value::Null` on failure, `error` the other way
// round; `command_id` and `agent_id` ride along on every report.
pub struct ResultReport {
    pub command_id: []const u8,
    pub agent_id: []const u8,
    pub success: bool,
    pub has_result: bool,
    pub has_error: bool,
}

// One `browser/result` payload for one executed command.
pub fn result_report(command_id: []const u8, agent_id: []const u8, executed_ok: bool) -> ResultReport {
    const outcome = command_outcome(executed_ok);
    return ResultReport {
        command_id: command_id,
        agent_id: agent_id,
        success: outcome.success,
        has_result: outcome.has_result,
        has_error: outcome.has_error,
    };
}

// One poll round on an open socket: fetch commands, execute, report.
// Returns the number of commands processed. The socket and the executor
// call stay in Rust; the round's decisions are round_command_count,
// command_outcome and result_report above. Data in, data out -- no test
// calls this.
pub fn poll_round(agent_id: []const u8, commands: []const BrowserCommand) {
    undefined;
}

// ----------------------------------------------------------------------
// PollerConfig (lines 39-68)
// ----------------------------------------------------------------------

// trios-server WS endpoint default (line 55).
pub const DEFAULT_SERVER_WS: []const u8 = "ws://127.0.0.1:9005/ws";

// Agent id default, the `browser_agent_id` of `/agent/run` callers (line 57).
pub const DEFAULT_AGENT_ID: []const u8 = "host-cdp";

// `TRIOS_POLL_INTERVAL_MS` default (lines 58-62).
pub const DEFAULT_POLL_INTERVAL_MS: u64 = 1000;

// `reconnect_backoff: Duration::from_secs(3)` (lines 63-65).
pub const DEFAULT_RECONNECT_BACKOFF_MS: u64 = 3000;

// Largest u64, for parse_poll_ms's overflow check.
pub const MAX_U64: u64 = 0xFFFFFFFFFFFFFFFF;

// PollerConfig, with Durations in milliseconds and `max_polls:
// Option<usize>` flattened to `0 = run forever` (the original's `None`).
pub struct PollerConfig {
    pub server_ws: []const u8,
    pub agent_id: []const u8,
    pub poll_interval_ms: u64,
    pub max_polls: usize,
    pub reconnect_backoff_ms: u64,
}

// `std::env::var("X").unwrap_or_else(|_| default)` (lines 53-57): unset
// falls back to the default; an empty-but-set value is kept as-is.
pub fn env_or(set: bool, value: []const u8, default: []const u8) -> []const u8 {
    if (!set) {
        return default;
    }
    return value;
}

// `TRIOS_POLL_INTERVAL_MS ... .parse()` (lines 59-62): plain ASCII digits
// only; empty, junk, a sign, blanks or u64 overflow all fail the parse and
// take the 1000 ms default, exactly like the original's
// `.ok().and_then(|v| v.parse().ok()).unwrap_or(1000)`.
pub fn parse_poll_ms(value: []const u8) -> u64 {
    var acc: u64 = 0;
    if (value.len == 0) {
        return DEFAULT_POLL_INTERVAL_MS;
    }
    for c in value {
        if (c < '0' or c > '9') {
            return DEFAULT_POLL_INTERVAL_MS;
        }
        const digit: u64 = (c - '0') as u64;
        if (acc > (MAX_U64 - digit) / 10) {
            return DEFAULT_POLL_INTERVAL_MS;
        }
        acc = acc * 10 + digit;
    }
    return acc;
}

// The full chain `env::var(..).ok().and_then(|v| v.parse().ok())
// .unwrap_or(1000)` (lines 58-63): unset or unparseable -> 1000 ms.
pub fn poll_interval_from_env(set: bool, raw: []const u8) -> u64 {
    if (!set) {
        return DEFAULT_POLL_INTERVAL_MS;
    }
    return parse_poll_ms(raw);
}

// `from_env` (line 52) with the three environment reads passed in by the
// caller: `server_ws_set`, `agent_id_set` and `poll_ms_set` stand for the
// Result of each `std::env::var`. `max_polls` is always the original's
// hard-coded `None` -> 0; the backoff its hard-coded 3 s.
pub fn PollerConfig_from_env(
    server_ws_set: bool,
    server_ws: []const u8,
    agent_id_set: bool,
    agent_id: []const u8,
    poll_ms_set: bool,
    poll_ms_raw: []const u8,
) -> PollerConfig {
    return PollerConfig {
        server_ws: env_or(server_ws_set, server_ws, DEFAULT_SERVER_WS),
        agent_id: env_or(agent_id_set, agent_id, DEFAULT_AGENT_ID),
        poll_interval_ms: poll_interval_from_env(poll_ms_set, poll_ms_raw),
        max_polls: 0,
        reconnect_backoff_ms: DEFAULT_RECONNECT_BACKOFF_MS,
    };
}

// ----------------------------------------------------------------------
// run (lines 140-172)
// ----------------------------------------------------------------------

// Connect failed or the round failed: warn, sleep reconnect_backoff, open a
// new socket (lines 146-151, 157-161).
pub const STEP_RECONNECT: i32 = 0;

// Round done: sleep poll_interval, poll again (line 169).
pub const STEP_SLEEP: i32 = 1;

// `rounds >= max_polls`: `return Ok(())` (lines 164-167).
pub const STEP_STOP: i32 = 2;

// The routing decision of run's loop. `connected_ok` is the `connect_async`
// result, `round_ok` the `poll_round` result, `rounds` the rounds completed
// so far -- counted after a good round (line 163) and NOT reset by a
// reconnect, like the original's outer-declared counter. `max_polls` is the
// config limit with 0 = run forever (the original's `None`). A failed
// connect never counts a round and never stops the loop: it reconnects
// whatever max_polls says.
pub fn run_next_step(connected_ok: bool, round_ok: bool, rounds: usize, max_polls: usize) -> i32 {
    if (!connected_ok) {
        return STEP_RECONNECT;
    }
    if (!round_ok) {
        return STEP_RECONNECT;
    }
    if (max_polls != 0 and rounds >= max_polls) {
        return STEP_STOP;
    }
    return STEP_SLEEP;
}

// Main loop: connect -> poll rounds -> reconnect on failure (line 141). The
// connect, the two sleeps and the executor stay in Rust; the loop's routing
// is run_next_step above. Data in, data out -- no test calls this.
pub fn run(config: PollerConfig) {
    undefined;
}

// ----------------------------------------------------------------------
// Tests
// ----------------------------------------------------------------------

test PollerConfig_from_env_defaults {
    // No environment at all: every default of lines 53-66 stands.
    const cfg = PollerConfig_from_env(false, "", false, "", false, "");
    assert(cfg.server_ws == "ws://127.0.0.1:9005/ws");
    assert(cfg.agent_id == "host-cdp");
    assert(cfg.poll_interval_ms == 1000);
    assert(cfg.max_polls == 0);
    assert(cfg.reconnect_backoff_ms == 3000);
}

test PollerConfig_from_env_overrides {
    // A set env var wins over the default; max_polls stays the hard-coded
    // None and the backoff its hard-coded 3 s.
    const cfg = PollerConfig_from_env(true, "ws://trios:9005/ws", true, "bee-7", true, "250");
    assert(cfg.server_ws == "ws://trios:9005/ws");
    assert(cfg.agent_id == "bee-7");
    assert(cfg.poll_interval_ms == 250);
    assert(cfg.max_polls == 0);
    assert(cfg.reconnect_backoff_ms == 3000);
}

test env_or_unset_falls_back_and_empty_is_kept {
    // Unset -> default; an empty-but-set value is used as-is, like
    // `unwrap_or_else` over `env::var`.
    const got = env_or(false, "ignored", "ws://fallback");
    assert(got == "ws://fallback");
    const kept = env_or(true, "", "ws://fallback");
    assert(kept == "");
}

test parse_poll_ms_cases {
    // What `u64::from_str` accepts.
    assert(parse_poll_ms("0") == 0);
    assert(parse_poll_ms("250") == 250);
    assert(parse_poll_ms("007") == 7);
    // What it rejects: empty, junk, blanks, a sign, a decimal point.
    assert(parse_poll_ms("") == 1000);
    assert(parse_poll_ms("12x") == 1000);
    assert(parse_poll_ms(" 5") == 1000);
    assert(parse_poll_ms("-5") == 1000);
    assert(parse_poll_ms("2.5") == 1000);
    // u64 overflow fails the parse, like Rust's.
    assert(parse_poll_ms("18446744073709551616") == 1000);
    assert(parse_poll_ms("18446744073709551615") == 18446744073709551615);
}

test poll_interval_from_env_cases {
    // Unset -> the 1000 ms default (lines 58-63).
    assert(poll_interval_from_env(false, "") == 1000);
    // Set and parseable -> the parsed value.
    assert(poll_interval_from_env(true, "250") == 250);
    // Set but unparseable -> the default, like the failing `.parse().ok()`.
    assert(poll_interval_from_env(true, "12x") == 1000);
}

test ws_call_skips_events_and_non_text {
    var frames: [4]WsFrame = [
        WsFrame { is_text: true, is_event: true, has_result: false },
        WsFrame { is_text: false, is_event: false, has_result: true },
        WsFrame { is_text: true, is_event: false, has_result: true },
        WsFrame { is_text: true, is_event: false, has_result: false },
    ];
    // The first text frame with a result, taken past the broadcast and the
    // binary frame (lines 81-93).
    assert(ws_pick_result(&frames) == 2);
}

test ws_call_all_noise_is_no_result {
    var frames: [3]WsFrame = [
        WsFrame { is_text: true, is_event: true, has_result: false },
        WsFrame { is_text: false, is_event: false, has_result: false },
        WsFrame { is_text: true, is_event: false, has_result: false },
    ];
    // Nothing to take: the 30 s timeout fired or the socket closed.
    assert(ws_pick_result(&frames) == WS_NO_RESULT);
}

test poll_round_missing_commands_is_empty_batch {
    // No `commands` field -> 0 processed, whatever else the reply carried
    // (`unwrap_or(json!([]))`, lines 105-107).
    assert(round_command_count(false, 99) == 0);
    // A present field keeps its length.
    assert(round_command_count(true, 3) == 3);
    assert(round_command_count(true, 0) == 0);
}

test command_outcome_maps_executor_result {
    // Ok(data) => (true, data, Value::Null).
    const ok = command_outcome(true);
    assert(ok.success);
    assert(ok.has_result);
    assert(!ok.has_error);
    // Err(err) => (false, Value::Null, err.to_string()).
    const err = command_outcome(false);
    assert(!err.success);
    assert(!err.has_result);
    assert(err.has_error);
}

test result_report_carries_ids_and_outcome {
    const ok_rep = result_report("cmd-1", "host-cdp", true);
    assert(ok_rep.command_id == "cmd-1");
    assert(ok_rep.agent_id == "host-cdp");
    assert(ok_rep.success);
    assert(ok_rep.has_result);
    assert(!ok_rep.has_error);

    const err_rep = result_report("cmd-2", "host-cdp", false);
    assert(err_rep.command_id == "cmd-2");
    assert(err_rep.agent_id == "host-cdp");
    assert(!err_rep.success);
    assert(!err_rep.has_result);
    assert(err_rep.has_error);
}

test run_next_step_routes_the_loop {
    // Connect failed -> backoff and retry, whatever max_polls says.
    assert(run_next_step(false, true, 0, 3) == STEP_RECONNECT);
    assert(run_next_step(false, true, 99, 1) == STEP_RECONNECT);
    // The round failed -> backoff and reconnect (continue outer).
    assert(run_next_step(true, false, 0, 3) == STEP_RECONNECT);
    // A good round under the limit -> sleep the poll interval, go again.
    assert(run_next_step(true, true, 0, 3) == STEP_SLEEP);
    assert(run_next_step(true, true, 2, 3) == STEP_SLEEP);
    // rounds reaches max_polls -> `return Ok(())`.
    assert(run_next_step(true, true, 3, 3) == STEP_STOP);
    assert(run_next_step(true, true, 4, 3) == STEP_STOP);
    // max_polls == 0 is the original's None: run forever.
    assert(run_next_step(true, true, 999999, 0) == STEP_SLEEP);
}

test protocol_constants {
    // The two requests a round sends, verbatim from the original.
    assert(METHOD_POLL == "browser/poll");
    assert(METHOD_RESULT == "browser/result");
    // The per-frame wait of ws_call.
    assert(WS_CALL_TIMEOUT_MS == 30000);
}
