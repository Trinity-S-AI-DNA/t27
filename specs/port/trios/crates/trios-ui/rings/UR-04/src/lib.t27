module port::trios::crates::trios_ui::rings::UR_04::src::lib;

// Port of gHashTag/trios crates/trios-ui/rings/UR-04/src/lib.rs (196 lines).
//
// This is a Dioxus view module: Element construction, signals and rsx! are
// plumbing and cannot be ported. Each function is therefore reduced to the
// decision it makes:
//   - `ChatPanel` (lines 13-54) renders one row per message plus one typing
//     indicator row while `is_loading` is true;
//   - `ChatBubble` (lines 68-108) chooses alignment, text colour and font from
//     the message role;
//   - `ChatInputBar` (lines 113-174) disables the send button exactly when the
//     draft is empty, and the Enter handler has the same guard;
//   - `send_message` (lines 176-189) refuses an empty draft, otherwise appends
//     and clears it;
//   - `chrono_now_iso` (lines 192-196) is a constant timestamp.
// Palette token values and styles are UI data, not decisions, and are not
// reproduced; the role -> token choice is.

// From trios_ui_ur00: the three message roles (used at lines 71-83).
enum MessageRole {
    User,
    Assistant,
    System,
}

// The triple the bubble computes from the role.
struct BubbleStyle {
    align: str,
    text_on_primary: bool,
    mono_font: bool,
}

// Lines 17-53: one bubble per message, plus the "is_loading" indicator block
// (lines 38-48). The header and input bar are unconditional, so they do not
// change the count.
pub fn ChatPanel(message_count: usize, is_loading: bool) -> usize {
    var rows: usize = message_count;
    if (is_loading) {
        rows += 1;
    }
    return rows;
}

// Lines 71-83: User -> flex-end, Assistant -> flex-start, System -> center.
pub fn bubble_align(role: MessageRole) -> str {
    if (role == .User) {
        return "flex-end";
    }
    if (role == .Assistant) {
        return "flex-start";
    }
    return "center";
}

// Lines 71-83: the bubble style per role. Assistant text sits on the primary
// surface, so it uses the background colour; everyone else uses the text colour.
// System is the only role rendered in the mono font.
pub fn ChatBubble(role: MessageRole) -> BubbleStyle {
    return BubbleStyle {
        align: bubble_align(role),
        text_on_primary: role == .Assistant,
        mono_font: role == .System,
    };
}

// Lines 118-120 and 149/164-166: the send button and the Enter handler are both
// gated on a non-empty draft. Empty means disabled.
pub fn ChatInputBar(text_len: usize) -> bool {
    return text_len > 0;
}

// Lines 176-189: empty drafts return before building the message; otherwise the
// message is appended and the input is cleared. Returns true when a message was
// accepted (appended + cleared).
pub fn send_message(text_len: usize) -> bool {
    if (text_len == 0) {
        return false;
    }
    return true;
}

// Lines 192-196: the WASM build has no clock, so the timestamp is a fixed
// placeholder. It is deliberately not the current time.
pub fn chrono_now_iso() -> str {
    return "2026-01-01T00:00:00Z";
}

// Lines 35-48: messages render in order, and loading appends exactly one row.
test chat_panel_row_count {
    assert(ChatPanel(0, false) == 0);
    assert(ChatPanel(3, false) == 3);
    assert(ChatPanel(3, true) == 4);
    assert(ChatPanel(0, true) == 1);
}

// Lines 71-75: user messages hug the right edge.
test bubble_user_aligns_end {
    assert(bubble_align(.User) == "flex-end");
}

// Lines 72-73: assistant messages hug the left edge and use the primary surface.
test bubble_assistant_aligns_start {
    const s = ChatBubble(.Assistant);
    assert(s.align == "flex-start");
    assert(s.text_on_primary);
    assert(!s.mono_font);
}

// Lines 74-83: system messages are centred, use the text colour and the mono font.
test bubble_system_is_mono_and_centred {
    const s = ChatBubble(.System);
    assert(s.align == "center");
    assert(!s.text_on_primary);
    assert(s.mono_font);
}

// Lines 71-83: user bubbles use the text colour and the family font.
test bubble_user_style {
    const s = ChatBubble(.User);
    assert(!s.text_on_primary);
    assert(!s.mono_font);
}

// Lines 118-120 and 149: an empty draft disables sending; one byte enables it.
test chat_input_bar_disabled_when_empty {
    assert(!ChatInputBar(0));
    assert(ChatInputBar(1));
    assert(ChatInputBar(42));
}

// Lines 177-180: an empty message is dropped, never pushed.
test send_message_rejects_empty {
    assert(!send_message(0));
}

// Lines 181-188: a non-empty message is appended and the draft is cleared.
test send_message_accepts_text {
    assert(send_message(1));
    assert(send_message(11));
}

// Lines 192-196: the timestamp is the pinned WASM placeholder.
test chrono_now_iso_is_pinned {
    assert(chrono_now_iso() == "2026-01-01T00:00:00Z");
}
