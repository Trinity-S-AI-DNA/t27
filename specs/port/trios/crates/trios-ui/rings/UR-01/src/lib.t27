// Port of crates/trios-ui/rings/UR-01/src/lib.rs, issue #10347.
// UR-01 is design tokens: two palettes, spacing / typography / radius scales,
// and the theme hook that picks a palette from the active Theme (UR-00).
// The decision ported pure is `palette_for(theme)` - the palette switch the
// hook performs. `use_palette` itself reads the Dioxus SettingsAtom, which is
// framework state, so it is declared plumbing (undefined; body, no test calls
// it). The Rust submodules spacing/typography/radius become prefixed consts
// because .t27 has no nested modules.
module port::trios::crates::trios_ui::rings::UR_01::src::lib;

// Source line 7: `use trios_ui_ur00::{use_settings_atom, Theme};`
pub enum Theme {
    Dark,
    Light,
}

// Source lines 13-34: ten colour slots.
pub struct ColorPalette {
    primary: []const u8,
    secondary: []const u8,
    background: []const u8,
    surface: []const u8,
    text: []const u8,
    text_muted: []const u8,
    border: []const u8,
    accent_success: []const u8,
    accent_error: []const u8,
    accent_warning: []const u8,
}

// Source lines 37-48: the dark palette, value for value.
pub const DARK_PALETTE: ColorPalette = ColorPalette {
    primary: "#c8a23c",
    secondary: "#8b7355",
    background: "#1a1a2e",
    surface: "#16213e",
    text: "#e0e0e0",
    text_muted: "#888888",
    border: "#2a2a4a",
    accent_success: "#4caf50",
    accent_error: "#ef5350",
    accent_warning: "#ff9800",
};

// Source lines 51-62: the light palette, value for value.
pub const LIGHT_PALETTE: ColorPalette = ColorPalette {
    primary: "#8b6914",
    secondary: "#a0845c",
    background: "#f5f5f5",
    surface: "#ffffff",
    text: "#1a1a2e",
    text_muted: "#666666",
    border: "#dddddd",
    accent_success: "#2e7d32",
    accent_error: "#c62828",
    accent_warning: "#e65100",
};

// Source lines 65-78.
pub const SPACING_XS: []const u8 = "4px";
pub const SPACING_SM: []const u8 = "8px";
pub const SPACING_MD: []const u8 = "12px";
pub const SPACING_LG: []const u8 = "16px";
pub const SPACING_XL: []const u8 = "24px";
pub const SPACING_XXL: []const u8 = "32px";

// Source lines 81-104.
pub const FONT_FAMILY: []const u8 = "'Inter', 'SF Pro', -apple-system, sans-serif";
pub const FONT_MONO: []const u8 = "'JetBrains Mono', 'Fira Code', monospace";
pub const SIZE_XS: []const u8 = "11px";
pub const SIZE_SM: []const u8 = "13px";
pub const SIZE_MD: []const u8 = "14px";
pub const SIZE_LG: []const u8 = "16px";
pub const SIZE_XL: []const u8 = "20px";
pub const SIZE_XXL: []const u8 = "28px";
pub const WEIGHT_NORMAL: []const u8 = "400";
pub const WEIGHT_MEDIUM: []const u8 = "500";
pub const WEIGHT_BOLD: []const u8 = "600";

// Source lines 107-116.
pub const RADIUS_SM: []const u8 = "2px";
pub const RADIUS_MD: []const u8 = "4px";
pub const RADIUS_LG: []const u8 = "8px";
pub const RADIUS_FULL: []const u8 = "9999px";

// Source lines 120-123 onward: the hook reads Theme from SettingsAtom and
// returns the matching palette. The palette switch is the decision and it is
// ported here; the capture of framework state is plumbing.
pub fn palette_for(theme: Theme) -> ColorPalette {
    return switch (theme) {
        .Dark => DARK_PALETTE,
        .Light => LIGHT_PALETTE,
    };
}

// Source lines 120-123+: `use_palette()` pulls the Theme out of the Dioxus
// SettingsAtom, which .t27 cannot touch; declared plumbing, no test calls it.
pub fn use_palette() -> ColorPalette {
    undefined;
}

// Dark theme resolves to DARK_PALETTE, slot for slot.
test dark_theme_palette {
    const p = palette_for(Theme::Dark);
    assert(p.primary == "#c8a23c");
    assert(p.secondary == "#8b7355");
    assert(p.background == "#1a1a2e");
    assert(p.surface == "#16213e");
    assert(p.text == "#e0e0e0");
    assert(p.text_muted == "#888888");
    assert(p.border == "#2a2a4a");
    assert(p.accent_success == "#4caf50");
    assert(p.accent_error == "#ef5350");
    assert(p.accent_warning == "#ff9800");
}

// Light theme resolves to LIGHT_PALETTE, slot for slot.
test light_theme_palette {
    const p = palette_for(Theme::Light);
    assert(p.primary == "#8b6914");
    assert(p.secondary == "#a0845c");
    assert(p.background == "#f5f5f5");
    assert(p.surface == "#ffffff");
    assert(p.text == "#1a1a2e");
    assert(p.text_muted == "#666666");
    assert(p.border == "#dddddd");
    assert(p.accent_success == "#2e7d32");
    assert(p.accent_error == "#c62828");
    assert(p.accent_warning == "#e65100");
}

// The two themes must not collapse to one palette: gold and background differ.
test themes_are_distinct {
    assert(palette_for(Theme::Dark).primary != palette_for(Theme::Light).primary);
    assert(palette_for(Theme::Dark).background != palette_for(Theme::Light).background);
    assert(palette_for(Theme::Dark).text != palette_for(Theme::Light).text);
}

// Spacing, typography and radius scales are tokens, not computed values.
test token_scales {
    assert(SPACING_XS == "4px");
    assert(SPACING_MD == "12px");
    assert(SPACING_XXL == "32px");
    assert(SIZE_XS == "11px");
    assert(SIZE_MD == "14px");
    assert(SIZE_XXL == "28px");
    assert(WEIGHT_NORMAL == "400");
    assert(WEIGHT_BOLD == "600");
    assert(RADIUS_SM == "2px");
    assert(RADIUS_FULL == "9999px");
    assert(FONT_MONO == "'JetBrains Mono', 'Fira Code', monospace");
}
