// Port of crates/trios-ui/rings/UR-02/src/lib.rs, issue #9205.
// UR-02 is the UI primitives layer (Button, Input, Badge) built on UR-01
// tokens. The source file supplied for this port is truncated at line 48, so
// only the Button variant machinery is visible; the three component functions
// are declared plumbing with undefined bodies (Dioxus rsx markup has no .t27
// equivalent) and no test calls them. The decision that IS visible - the
// declared defaults of ButtonVariant and ButtonProps - is ported pure.
module port::trios::crates::trios_ui::rings::UR_02::src::lib;

// Source lines 12-22.
pub enum ButtonVariant {
    Primary,
    Secondary,
    Ghost,
    Danger,
}

// Source lines 24-28: `impl Default for ButtonVariant` returns Primary.
pub fn ButtonVariant_default() -> ButtonVariant {
    return ButtonVariant::Primary;
}

// Source lines 31-43: the props defaults, declared as attributes
// (#[props(default = ButtonVariant::Primary)], #[props(default = false)]).
pub struct ButtonProps {
    variant: ButtonVariant,
    disabled: bool,
}

pub const BUTTON_DISABLED_DEFAULT: bool = false;

// Source lines 31-43: what the attribute expansion yields when no prop is set.
pub fn ButtonProps_default() -> ButtonProps {
    return ButtonProps {
        variant: ButtonVariant_default(),
        disabled: BUTTON_DISABLED_DEFAULT,
    };
}

// Source lines 45-48: the `Button` component renders rsx(...) with these
// props. rsx markup and Element do not exist in .t27; declared plumbing.
pub fn Button(props: ButtonProps) -> ButtonVariant {
    undefined;
}

// Component declared by the ring title (UR-02 line 1) but cut off by the
// truncation at line 48; plumbing for the same reason as Button.
pub fn Input() -> ButtonVariant {
    undefined;
}

// Component declared by the ring title (UR-02 line 1) but cut off by the
// truncation at line 48; plumbing for the same reason as Button.
pub fn Badge() -> ButtonVariant {
    undefined;
}

// Default::default() for ButtonVariant is Primary, not the first enum member
// by accident: the impl says so explicitly (source lines 24-28).
test default_variant_is_primary {
    assert(ButtonVariant_default() == ButtonVariant::Primary);
    assert(ButtonVariant_default() != ButtonVariant::Danger);
}

// All four variants are distinct values.
test variants_are_distinct {
    assert(ButtonVariant::Primary != ButtonVariant::Secondary);
    assert(ButtonVariant::Primary != ButtonVariant::Ghost);
    assert(ButtonVariant::Primary != ButtonVariant::Danger);
    assert(ButtonVariant::Secondary != ButtonVariant::Ghost);
    assert(ButtonVariant::Secondary != ButtonVariant::Danger);
    assert(ButtonVariant::Ghost != ButtonVariant::Danger);
}

// Unset props take the declared defaults: Primary and not disabled.
test props_defaults {
    const props = ButtonProps_default();
    assert(props.variant == ButtonVariant::Primary);
    assert(props.disabled == false);
    assert(props.disabled == BUTTON_DISABLED_DEFAULT);
}

// An explicitly built props value keeps what it was given - the defaults are
// defaults, not overrides.
test props_explicit_values_survive {
    const props = ButtonProps { variant: ButtonVariant::Danger, disabled: true };
    assert(props.variant == ButtonVariant::Danger);
    assert(props.disabled);
    assert(props.variant != ButtonVariant_default());
}
