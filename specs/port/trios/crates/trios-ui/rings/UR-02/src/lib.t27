module port::trios::crates::trios_ui::rings::UR_02;

// ─── Button Variant ─────────────────────────────────────────────

pub enum ButtonVariant {
    Primary,
    Secondary,
    Ghost,
    Danger,
}

pub fn ButtonVariant_default() -> ButtonVariant {
    ButtonVariant::Primary
}

// ─── Input Component Logic ───────────────────────────────────────

pub struct InputProps {
    placeholder: str,
    value: str,
    label: str,
    mono: bool,
}

pub fn Inputprops(props: InputProps) -> str {
    var font: str = "Arial, sans-serif";
    if (props.mono) {
        font = "Courier New, monospace";
    }
    
    return "background: #f8f9fa; color: #000000; border: 1px solid #dee2e6; border-radius: 8px; padding: 8px 16px; font-family: " + font + "; font-size: 16px; outline: none;";
}

// ─── Badge Variant ───────────────────────────────────────────────

pub enum BadgeVariant {
    Default,
    Success,
    Error,
    Warning,
}

pub fn BadgeVariant_default() -> BadgeVariant {
    BadgeVariant::Default
}

// ─── Badge Component Logic ───────────────────────────────────────

pub struct BadgeProps {
    children: str,
    variant: BadgeVariant,
}

pub fn Badgeprops(props: BadgeProps) -> str {
    var bg: str = "";
    var color: str = "";
    
    if (props.variant == BadgeVariant::Default) {
        bg = "#f8f9fa";
        color = "#000000";
    } else if (props.variant == BadgeVariant::Success) {
        bg = "#28a745";
        color = "#ffffff";
    } else if (props.variant == BadgeVariant::Error) {
        bg = "#dc3545";
        color = "#ffffff";
    } else if (props.variant == BadgeVariant::Warning) {
        bg = "#ffc107";
        color = "#ffffff";
    }
    
    return "display: inline-block; background: " + bg + "; color: " + color + "; border-radius: 9999px; padding: 2px 8px; font-size: 12px; font-family: Arial, sans-serif; font-weight: 500;";
}

// ─── Test Cases ─────────────────────────────────────────────────

test ButtonVariant_default_returns_primary {
    const variant = ButtonVariant_default();
    assert(variant == ButtonVariant::Primary);
}

test ButtonVariant_enum_variants {
    const primary = ButtonVariant::Primary;
    const secondary = ButtonVariant::Secondary;
    const ghost = ButtonVariant::Ghost;
    const danger = ButtonVariant::Danger;
    assert(primary != secondary);
    assert(secondary != ghost);
    assert(ghost != danger);
}

test Inputprops_mono_font {
    const props = InputProps {
        placeholder: "test",
        value: "value",
        label: "",
        mono: true,
    };
    const style = Inputprops(props);
    assert(style.contains("Courier New"));
}

test Inputprops_regular_font {
    const props = InputProps {
        placeholder: "test",
        value: "value",
        label: "label",
        mono: false,
    };
    const style = Inputprops(props);
    assert(style.contains("Arial"));
}

test BadgeVariant_default_returns_default {
    const variant = BadgeVariant_default();
    assert(variant == BadgeVariant::Default);
}

test Badgeprops_success_variant {
    const props = BadgeProps {
        children: "Success",
        variant: BadgeVariant::Success,
    };
    const style = Badgeprops(props);
    assert(style.contains("#28a745"));
    assert(style.contains("#ffffff"));
}

test Badgeprops_error_variant {
    const props = BadgeProps {
        children: "Error",
        variant: BadgeVariant::Error,
    };
    const style = Badgeprops(props);
    assert(style.contains("#dc3545"));
    assert(style.contains("#ffffff"));
}

