module port::trios::crates::trios-ui::rings::UR-03::src::lib;

// UR-03 - Layout ring (Sidebar, Tabs, Panel), ported from
// gHashTag/trios crates/trios-ui/rings/UR-03/src/lib.rs at 8b229e9489ee
// (215 lines of Dioxus).
//
// The original ring is framework plumbing wrapped around a handful of
// decisions: how wide the sidebar sits when collapsed, which colours an
// active or inactive nav item and tab receive, which tab counts as active,
// and which id or index a click reports back. Those decisions are ported
// here as pure functions returning the view data an interface layer would
// render. Everything in the original that read the world is now a parameter:
//   - use_palette() -> the palette argument (trios_ui_ur01::ColorPalette)
//   - use_settings_atom() + settings.read().sidebar_collapsed -> the
//     `collapsed` bool argument on Sidebar
//   - rsx! trees with their event handlers -> the view structs below; a
//     click's payload is a field (select_index for nav items, change_id for
//     tabs), because callbacks do not exist here - waiting is the caller's
//     job
//   - children: Element on PanelProps -> dropped: the content a panel wraps
//     is interface data, not a decision, so the port carries the title only
//   - the constant style strings the original interpolates from UR-01 token
//     sets (font families, paddings, radii, letter spacing, the "2px solid"
//     border prefix) stay in the interface layer; this file carries the
//     parts whose values the ring actually computes
//
// The original's Vec<NavItem> / Vec<Tab> become slices on the props structs
// and fixed-capacity arrays (SIDEBAR_MAX_ITEMS / TABS_MAX_TABS) on the view
// structs, with a count field; the interface layer lists at most that many
// entries. Clicks do not fire handlers here - each view records what the
// original's handler would have been called with.
//
// Would reuse from trios_ui_ur01 instead of mirroring, once cross-spec use
// is trusted (#4298): ColorPalette (the six fields read below) and the
// spacing/typography/radius token sets.

// --- shared tokens -----------------------------------------------------------

// Mirror of trios_ui_ur01::ColorPalette, restricted to the six fields UR-03
// reads. In the original it arrives from use_palette() inside each
// component; here it is a parameter.
pub struct ColorPalette {
    primary: []const u8,
    background: []const u8,
    surface: []const u8,
    border: []const u8,
    text: []const u8,
    text_muted: []const u8,
}

// --- Sidebar -----------------------------------------------------------------

// NavItem from the original: one entry of the sidebar navigation.
pub struct NavItem {
    label: []const u8,
    icon: []const u8,
    active: bool,
}

// What render_nav_item renders for one nav entry: the colours it picks and
// the index a click would report to on_select (the original calls
// on_select.call(idx) with the enumerate position).
pub struct NavItemView {
    select_index: usize,
    background: []const u8,
    color: []const u8,
    icon: []const u8,
    label: []const u8,
}

// SidebarProps from the original, minus the on_select event handler: the
// decision the handler carried (a click reports the item's index) lives on
// NavItemView as select_index.
pub struct SidebarProps {
    items: []NavItem,
}

// Original line 33, in Sidebar: width is "48px" when the settings atom says
// sidebar_collapsed, "220px" otherwise.
pub fn sidebar_width(collapsed: bool) -> []const u8 {
    if (collapsed) {
        return "48px";
    }
    return "220px";
}

// Original line 59, render_nav_item. An active item sits on palette.primary
// with palette.background text; an inactive one is transparent on
// palette.text. It also carries what a click would report: the enumerate
// index the original passes to on_select.call(idx).
fn render_nav_item(idx: usize, item: NavItem, palette: ColorPalette) -> NavItemView {
    var view: NavItemView = NavItemView {
        select_index: idx,
        background: "transparent",
        color: palette.text,
        icon: item.icon,
        label: item.label,
    };
    if (item.active) {
        view.background = palette.primary;
        view.color = palette.background;
    }
    return view;
}

// Fixed capacity standing in for the original's Vec<NavItem> rendering loop.
pub const SIDEBAR_MAX_ITEMS: usize = 16;

// What the Sidebar nav container renders (original line 33): the width
// decision (also applied to min-width), the palette-driven colours, and one
// item view per prop entry. The original's padding/transition/overflow and
// cursor styling are constants the interface layer holds.
pub struct SidebarView {
    width: []const u8,
    min_width: []const u8,
    background: []const u8,
    border_right_color: []const u8,
    item_count: usize,
    items: [SIDEBAR_MAX_ITEMS]NavItemView,
}

// Sidebar component, original line 33. `collapsed` is the read of
// settings.read().sidebar_collapsed in the original; the item loop mirrors
// the original's items.iter().enumerate() over render_nav_item.
pub fn Sidebar(props: SidebarProps, palette: ColorPalette, collapsed: bool) -> SidebarView {
    var view: SidebarView = SidebarView {
        width: sidebar_width(collapsed),
        min_width: sidebar_width(collapsed),
        background: palette.surface,
        border_right_color: palette.border,
        item_count: 0,
        items: [SIDEBAR_MAX_ITEMS]NavItemView{ NavItemView { select_index: 0, background: "transparent", color: "", icon: "", label: "" } } ** SIDEBAR_MAX_ITEMS,
    };
    var i: usize = 0;
    while (i < props.items.len) {
        if (view.item_count < SIDEBAR_MAX_ITEMS) {
            view.items[view.item_count] = render_nav_item(i, props.items[i], palette);
            view.item_count += 1;
        }
        i += 1;
    }
    return view;
}

// --- Tabs --------------------------------------------------------------------

// Tab from the original: one entry of the tab bar.
pub struct Tab {
    label: []const u8,
    id: []const u8,
}

// TabsProps from the original, minus the on_change event handler: the
// decision the handler carried (a click reports the tab's id) lives on
// TabView as change_id.
pub struct TabsProps {
    tabs: []Tab,
    active_id: []const u8,
}

// What render_tab renders for one tab (original line 131). The original
// formats the bottom border as "2px solid {palette.primary}" for the active
// tab and "2px solid transparent" otherwise; width and style are constant,
// so the decision carried here is the colour. Active text is palette.primary,
// inactive text palette.text_muted. A click reports tab.id.
pub struct TabView {
    change_id: []const u8,
    border_color: []const u8,
    color: []const u8,
    label: []const u8,
}

// Original line 131, render_tab: a tab is active exactly when
// tab.id == props.active_id.
fn render_tab(tab: Tab, props: TabsProps, palette: ColorPalette) -> TabView {
    var view: TabView = TabView {
        change_id: tab.id,
        border_color: "transparent",
        color: palette.text_muted,
        label: tab.label,
    };
    if (tab.id == props.active_id) {
        view.border_color = palette.primary;
        view.color = palette.primary;
    }
    return view;
}

// Fixed capacity standing in for the original's Vec<Tab> rendering loop.
pub const TABS_MAX_TABS: usize = 16;

// What the Tabs bar renders (original line 114): one tab view per prop
// entry, on a bar whose bottom border uses palette.border.
pub struct TabsView {
    border_bottom_color: []const u8,
    tab_count: usize,
    tabs: [TABS_MAX_TABS]TabView,
}

// Tabs component, original line 114.
pub fn Tabs(props: TabsProps, palette: ColorPalette) -> TabsView {
    var view: TabsView = TabsView {
        border_bottom_color: palette.border,
        tab_count: 0,
        tabs: [TABS_MAX_TABS]TabView{ TabView { change_id: "", border_color: "transparent", color: "", label: "" } } ** TABS_MAX_TABS,
    };
    var i: usize = 0;
    while (i < props.tabs.len) {
        if (view.tab_count < TABS_MAX_TABS) {
            view.tabs[view.tab_count] = render_tab(props.tabs[i], props, palette);
            view.tab_count += 1;
        }
        i += 1;
    }
    return view;
}

// --- Panel -------------------------------------------------------------------

// PanelProps from the original; children: Element is interface data the
// panel wraps, not a decision, so the port carries the title only.
pub struct PanelProps {
    title: []const u8,
}

// What the Panel container renders (original line 176): the title shown in
// its bar and the palette-driven colours. The bar's uppercase/letter-spacing
// treatment and the content area's padding/scroll behaviour are constants
// the interface layer holds.
pub struct PanelView {
    title: []const u8,
    background: []const u8,
    border_color: []const u8,
    title_color: []const u8,
}

// Panel component, original line 176: a bordered container on palette.surface
// whose title bar renders palette.text_muted.
pub fn Panel(props: PanelProps, palette: ColorPalette) -> PanelView {
    return PanelView {
        title: props.title,
        background: palette.surface,
        border_color: palette.border,
        title_color: palette.text_muted,
    };
}

// --- tests -------------------------------------------------------------------

// Fixture palette. The tests assert the original's decisions against these
// values: a view field must equal exactly the palette field the original
// would have interpolated, so a wrong field choice fails the test.
fn test_palette() -> ColorPalette {
    return ColorPalette {
        primary: "#7c5cff",
        background: "#101014",
        surface: "#17171c",
        border: "#2a2a32",
        text: "#e8e8ee",
        text_muted: "#8a8a96",
    };
}

test sidebar_width_follows_collapsed {
    // Original Sidebar (line 33): width "48px" collapsed, "220px" expanded.
    assert(sidebar_width(true) == "48px");
    assert(sidebar_width(false) == "220px");
}

test sidebar_container_and_items {
    const palette: ColorPalette = test_palette();
    var items: [3]NavItem = [
        NavItem { label: "Sessions", icon: "1", active: false },
        NavItem { label: "Files", icon: "2", active: true },
        NavItem { label: "Settings", icon: "3", active: false },
    ];
    const props: SidebarProps = SidebarProps { items: &items };
    const expanded: SidebarView = Sidebar(props, palette, false);
    // Container sized by the collapsed flag and coloured from the palette.
    assert(expanded.width == "220px");
    assert(expanded.min_width == "220px");
    assert(expanded.background == "#17171c");
    assert(expanded.border_right_color == "#2a2a32");
    assert(expanded.item_count == 3);
    // enumerate() hands render_nav_item the position as idx, and a click on
    // the second entry would report 1 to on_select.
    assert(expanded.items[1].select_index == 1);
    assert(expanded.items[1].background == "#7c5cff");
    assert(expanded.items[1].color == "#101014");
    assert(expanded.items[1].label == "Files");
    // The same props collapsed give the narrow rail.
    const collapsed_view: SidebarView = Sidebar(props, palette, true);
    assert(collapsed_view.width == "48px");
    assert(collapsed_view.min_width == "48px");
}

test nav_item_active_colors {
    const palette: ColorPalette = test_palette();
    const item: NavItem = NavItem { label: "Files", icon: "F", active: true };
    const view: NavItemView = render_nav_item(2, item, palette);
    // Active: primary background, background-coloured text.
    assert(view.background == "#7c5cff");
    assert(view.color == "#101014");
    // The click payload is the enumerate index.
    assert(view.select_index == 2);
    assert(view.icon == "F");
    assert(view.label == "Files");
}

test nav_item_inactive_colors {
    const palette: ColorPalette = test_palette();
    const item: NavItem = NavItem { label: "Sessions", icon: "S", active: false };
    const view: NavItemView = render_nav_item(0, item, palette);
    // Inactive: transparent background, plain text colour.
    assert(view.background == "transparent");
    assert(view.color == "#e8e8ee");
    assert(view.select_index == 0);
}

test tab_active_matches_by_id {
    const palette: ColorPalette = test_palette();
    var tabs: [2]Tab = [
        Tab { label: "State", id: "state" },
        Tab { label: "Output", id: "output" },
    ];
    const props: TabsProps = TabsProps { tabs: &tabs, active_id: "output" };
    const active_view: TabView = render_tab(tabs[1], props, palette);
    // The tab whose id matches active_id gets the primary border and text.
    assert(active_view.border_color == "#7c5cff");
    assert(active_view.color == "#7c5cff");
    // A click on it still reports its own id to on_change.
    assert(active_view.change_id == "output");
    assert(active_view.label == "Output");
    const inactive_view: TabView = render_tab(tabs[0], props, palette);
    assert(inactive_view.border_color == "transparent");
    assert(inactive_view.color == "#8a8a96");
    assert(inactive_view.change_id == "state");
}

test tab_id_match_is_exact {
    // Active is tab.id == props.active_id, an exact string comparison: a
    // prefix of the id and an empty active_id both leave the tab inactive.
    const palette: ColorPalette = test_palette();
    var tabs: [1]Tab = [Tab { label: "Output", id: "output" }];
    const prefix_props: TabsProps = TabsProps { tabs: &tabs, active_id: "out" };
    const prefix_view: TabView = render_tab(tabs[0], prefix_props, palette);
    assert(prefix_view.border_color == "transparent");
    assert(prefix_view.color == "#8a8a96");
    const empty_props: TabsProps = TabsProps { tabs: &tabs, active_id: "" };
    const empty_view: TabView = render_tab(tabs[0], empty_props, palette);
    assert(empty_view.border_color == "transparent");
    assert(empty_view.change_id == "output");
}

test tabs_bar_lists_all_tabs {
    const palette: ColorPalette = test_palette();
    var tabs: [3]Tab = [
        Tab { label: "State", id: "state" },
        Tab { label: "Output", id: "output" },
        Tab { label: "Logs", id: "logs" },
    ];
    const props: TabsProps = TabsProps { tabs: &tabs, active_id: "logs" };
    const view: TabsView = Tabs(props, palette);
    // The bar's bottom border uses the palette border colour...
    assert(view.border_bottom_color == "#2a2a32");
    // ...and every entry is rendered exactly once, only the matching one hot.
    assert(view.tab_count == 3);
    assert(view.tabs[0].border_color == "transparent");
    assert(view.tabs[1].border_color == "transparent");
    assert(view.tabs[2].border_color == "#7c5cff");
    assert(view.tabs[2].change_id == "logs");
}

test panel_carries_title_and_palette {
    const palette: ColorPalette = test_palette();
    const props: PanelProps = PanelProps { title: "Session" };
    const view: PanelView = Panel(props, palette);
    // The title bar shows the prop title; the container sits on the palette
    // surface with the palette border; the title text is muted.
    assert(view.title == "Session");
    assert(view.background == "#17171c");
    assert(view.border_color == "#2a2a32");
    assert(view.title_color == "#8a8a96");
}
