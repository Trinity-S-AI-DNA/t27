module port::trios::crates::trios_ui::rings::UR_08::src::lib;

// Port of gHashTag/trios crates/trios-ui/rings/UR-08/src/lib.rs (150 lines).
//
// Dioxus (`Element`, `use_signal`, `rsx!`, `VirtualDom`) is plumbing and is not
// modelled. The decisions are the route table, its labels/icons, the sidebar
// selection guard, the route -> panel mapping, and the initial route.
//
// Deviation: the original icons are emoji (U+1F577 etc.). This corpus is
// ASCII-only, so `icon` returns the emoji's ASCII short name. The mapping is
// one-to-one and ordered as in the Rust match.

// Lines 16-27: sidebar order is Social, Chat, Agents, Mcp, Settings.
enum Route {
    Social,
    Chat,
    Agents,
    Mcp,
    Settings,
}

const ROUTE_COUNT: usize = 5;

// Lines 31-39: the navigation label of each route.
pub fn label(route: Route) -> str {
    if (route == .Social) {
        return "Social";
    }
    if (route == .Chat) {
        return "Chat";
    }
    if (route == .Agents) {
        return "Agents";
    }
    if (route == .Mcp) {
        return "MCP";
    }
    return "Settings";
}

// Lines 42-50: the navigation icon of each route, as ASCII short names for the
// original spider/speech/robot/plug/gear emoji.
pub fn icon(route: Route) -> str {
    if (route == .Social) {
        return "spider_web";
    }
    if (route == .Chat) {
        return "speech_balloon";
    }
    if (route == .Agents) {
        return "robot";
    }
    if (route == .Mcp) {
        return "electric_plug";
    }
    return "gear";
}

// Lines 53-55: `Route::all()` in sidebar order.
pub fn all() -> [5]Route {
    return [.Social, .Chat, .Agents, .Mcp, .Settings];
}

// Lines 62-127: AppShell builds one NavItem per route, marking the active one,
// and the sidebar's on_select (lines 92-97) applies a clicked index only when it
// is in range; an out-of-range index leaves the active route unchanged. The
// render tree itself is plumbing, so this port keeps that guard and returns the
// resulting active route.
pub fn AppShell(active: Route, clicked_idx: usize) -> Route {
    const routes = all();
    if (clicked_idx < ROUTE_COUNT) {
        return routes[clicked_idx];
    }
    return active;
}

// Lines 130-138: the route -> panel component mapping.
pub fn render_route(route: Route) -> str {
    if (route == .Social) {
        return "SocialPanel";
    }
    if (route == .Chat) {
        return "ChatPanel";
    }
    if (route == .Agents) {
        return "AgentList";
    }
    if (route == .Mcp) {
        return "McpPanel";
    }
    return "SettingsPanel";
}

// Lines 146-150: mount_app creates the VirtualDom around AppShell, whose initial
// signal value is Route::Social (line 64). The DOM launch is plumbing; the
// initial route is the observable decision.
pub fn mount_app() -> Route {
    return .Social;
}

// Lines 31-39: every label, in route order.
test labels_match_routes {
    assert(label(.Social) == "Social");
    assert(label(.Chat) == "Chat");
    assert(label(.Agents) == "Agents");
    assert(label(.Mcp) == "MCP");
    assert(label(.Settings) == "Settings");
}

// Lines 42-50: every icon, in route order.
test icons_are_distinct {
    assert(icon(.Social) == "spider_web");
    assert(icon(.Chat) == "speech_balloon");
    assert(icon(.Agents) == "robot");
    assert(icon(.Mcp) == "electric_plug");
    assert(icon(.Settings) == "gear");
}

// Lines 53-55: five routes, in sidebar order.
test all_routes_in_order {
    const routes = all();
    assert(routes.len == 5);
    assert(routes[0] == .Social);
    assert(routes[1] == .Chat);
    assert(routes[2] == .Agents);
    assert(routes[3] == .Mcp);
    assert(routes[4] == .Settings);
}

// Lines 92-97: a valid click selects that route.
test app_shell_selects_in_range {
    assert(AppShell(.Settings, 0) == .Social);
    assert(AppShell(.Social, 4) == .Settings);
    assert(AppShell(.Chat, 2) == .Agents);
}

// Lines 94-96: an out-of-range index is ignored, not a panic.
test app_shell_ignores_out_of_range {
    assert(AppShell(.Mcp, 5) == .Mcp);
    assert(AppShell(.Agents, 99) == .Agents);
}

// Lines 130-138: each route renders its own panel component.
test render_route_maps_to_panels {
    assert(render_route(.Social) == "SocialPanel");
    assert(render_route(.Chat) == "ChatPanel");
    assert(render_route(.Agents) == "AgentList");
    assert(render_route(.Mcp) == "McpPanel");
    assert(render_route(.Settings) == "SettingsPanel");
}

// Line 64: the shell opens on the social feed.
test mount_app_starts_on_social {
    assert(mount_app() == .Social);
}
