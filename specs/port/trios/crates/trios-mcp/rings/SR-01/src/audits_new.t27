module port::audits_new;

// Port of trios-mcp rings/SR-01 src/audits_new.rs. The original walks a
// Lighthouse JSON report; the walking is plumbing, and every field it
// reads is lifted into the input structs below. What is left -- and what
// these functions carry -- is the decision set: which nodes become issues
// (a present, non-empty title), how impact words normalize, how many
// elements an issue may carry (details items, take(3)), what a missing
// accessibility category or audit-counts block means (an error, not a
// default), and which counts the report ends with.

struct Issue {
    id: str,
    title: str,
    impact: str,
    category: str,
    elements: [3]IssueElement,
    elements_count: u8,
    score: u8,
}

struct IssueElement {
    selector: str,
    snippet: str,
    label: str,
}

// Metadata as the report carries it: the final URL or "", and the fixed
// witness fields the original hardcodes.
struct Metadata {
    url: str,
    timestamp: str,
    device: str,
    lighthouseVersion: str,
}

// The parts of one audit item the original reads, with the JSON's
// missing keys carried as has_* flags (missing title arrives as the
// empty string -- the original returns None for missing and empty
// alike, so the two collapse). details_items is the length of
// details.items before the take(3).
struct NodeView {
    title: str,
    has_impact: bool,
    impact: str,
    has_selector: bool,
    selector: str,
    has_snippet: bool,
    snippet: str,
    has_score: bool,
    score: u32,
    details_items: u8,
}

// What parse_accessibility reports: the category score and the three
// issue counts the original's category_scores json! carries.
struct AccessibilityReport {
    score: u8,
    navigation_issues: u16,
    aria_issues: u16,
    best_practices_issues: u16,
}

// The impact match: "critical"/"high" => "critical", "serious" =>
// "serious", "medium"/"low" and anything unrecognized => "moderate". The
// original's later "low" => "minor" arm is dead -- "low" already matched
// the "medium" | "low" arm above it -- so no input can produce "minor".
fn normalize_impact(impact: str) -> str {
    if (impact == "critical") { return "critical"; }
    if (impact == "high") { return "critical"; }
    if (impact == "serious") { return "serious"; }
    return "moderate";
}

// Ported function: parse_lighthouse_issue. No title, or an empty title,
// is not an issue (the original returns None). The elements are the
// details items, take(3), each one kept only when BOTH node.selector and
// node.snippet are present -- the original re-reads the node's selector
// and snippet for every item, so all kept elements carry the same pair.
fn parse_lighthouse_issue(
    audit_id: str,
    node: NodeView,
    category: str,
    impact_category: str,
) -> ?Issue {
    // a missing title and an empty title are the same non-issue
    if (node.title.len == 0) { return null; }

    var impact: str = "moderate";
    if (node.has_impact) { impact = node.impact; }

    var iterations: u8 = node.details_items;
    if (iterations > 3) { iterations = 3; }

    var elements: [3]IssueElement = .{
        IssueElement{ .selector = "", .snippet = "", .label = "" },
        IssueElement{ .selector = "", .snippet = "", .label = "" },
        IssueElement{ .selector = "", .snippet = "", .label = "" },
    };
    var elements_count: u8 = 0;
    var i: u8 = 0;
    while (i < iterations) {
        if (node.has_selector) {
            if (node.has_snippet) {
                elements[elements_count] = IssueElement{
                    .selector = node.selector,
                    .snippet = node.snippet,
                    .label = impact_category,
                };
                elements_count += 1;
            }
        }
        i += 1;
    }

    var score: u8 = 0;
    if (node.has_score) { score = node.score as u8; }

    return Issue{
        .id = audit_id,
        .title = node.title,
        .impact = normalize_impact(impact),
        .category = category,
        .elements = elements,
        .elements_count = elements_count,
        .score = score,
    };
}

// Ported function: parse_accessibility. A missing accessibility category
// or a missing audit-counts block is an error (the original's context()?
// turns them into Err); null is that error. The score defaults to 0 when
// absent. The three counts are exactly the original's category_scores:
// navigation gets every issue, aria and best-practices get counted from
// the issues' own categories -- which parse_lighthouse_issue always fills
// with "accessibility", so only foreign issues can move them.
pub fn parse_accessibility(
    category_present: bool,
    score: ?u32,
    audit_counts_present: bool,
    issues: []const Issue,
) -> ?AccessibilityReport {
    if (category_present == false) { return null; }
    if (audit_counts_present == false) { return null; }

    var s: u8 = 0;
    if (score != null) { s = score.? as u8; }

    return AccessibilityReport{
        .score = s,
        .navigation_issues = issues.len as u16,
        .aria_issues = count_by_category(issues, "aria"),
        .best_practices_issues = count_by_category(issues, "best-practices"),
    };
}

// Ported function: count_by_category
fn count_by_category(issues: []const Issue, category: str) -> u16 {
    var count: u16 = 0;
    for issue in issues {
        if (issue.category == category) {
            count += 1;
        }
    }
    return count;
}

// Ported function: category_to_label
fn category_to_label(category: str) -> str {
    if (category == "accessibility") {
        return "a11y";
    } else if (category == "seo") {
        return "seo";
    } else if (category == "best-practices") {
        return "best-practices";
    } else {
        return category;
    }
}

fn empty_issue(id: str, category: str) -> Issue {
    return Issue{
        .id = id,
        .title = "title",
        .impact = "moderate",
        .category = category,
        .elements = .{
            IssueElement{ .selector = "", .snippet = "", .label = "" },
            IssueElement{ .selector = "", .snippet = "", .label = "" },
            IssueElement{ .selector = "", .snippet = "", .label = "" },
        },
        .elements_count = 0,
        .score = 0,
    };
}

test count_by_category_basic {
    var issues: [3]Issue = .{
        empty_issue("issue1", "accessibility"),
        empty_issue("issue2", "seo"),
        empty_issue("issue3", "accessibility"),
    };

    const accessibility_count = count_by_category(&issues, "accessibility");
    assert(accessibility_count == 2);

    const seo_count = count_by_category(&issues, "seo");
    assert(seo_count == 1);

    const best_practices_count = count_by_category(&issues, "best-practices");
    assert(best_practices_count == 0);
}

test category_to_label_mapping {
    assert(category_to_label("accessibility") == "a11y");
    assert(category_to_label("seo") == "seo");
    assert(category_to_label("best-practices") == "best-practices");
    assert(category_to_label("performance") == "performance");
    assert(category_to_label("") == "");
    assert(category_to_label("unknown-category") == "unknown-category");
}

test category_to_label_edge_cases {
    assert(category_to_label("Accessibility") == "Accessibility"); // case sensitive
    assert(category_to_label("ACCESSIBILITY") == "ACCESSIBILITY"); // all caps
    assert(category_to_label("accessibility ") == "accessibility "); // with space
    assert(category_to_label("accessibility-extra") == "accessibility-extra"); // with dash
}

test count_by_category_empty {
    var empty_issues: [0]Issue = .{};

    const count = count_by_category(&empty_issues, "any-category");
    assert(count == 0);

    const count2 = count_by_category(&empty_issues, "");
    assert(count2 == 0);
}

fn view(title: str, has_impact: bool, impact: str, has_selector: bool, has_snippet: bool, has_score: bool, score: u32, details_items: u8) -> NodeView {
    return NodeView{
        .title = title,
        .has_impact = has_impact,
        .impact = impact,
        .has_selector = has_selector,
        .selector = "img.hero",
        .has_snippet = has_snippet,
        .snippet = "<img src=hero.png>",
        .has_score = has_score,
        .score = score,
        .details_items = details_items,
    };
}

test no_title_or_empty_title_is_not_an_issue {
    const missing = view("", true, "critical", true, true, true, 90, 2);
    assert(parse_lighthouse_issue("audit", missing, "accessibility", "a11y") == null);
    const blank = view("", false, "", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("audit", blank, "accessibility", "a11y") == null);
}

test impact_normalizes_the_way_the_match_does {
    // missing impact defaults to moderate
    const node = view("Buttons do not have an accessible name", false, "", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("button-name", node, "accessibility", "a11y").?.impact == "moderate");

    const critical = view("Buttons do not have an accessible name", true, "high", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("button-name", critical, "accessibility", "a11y").?.impact == "critical");

    const serious = view("Buttons do not have an accessible name", true, "serious", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("button-name", serious, "accessibility", "a11y").?.impact == "serious");

    // "low" hits the "medium" | "low" arm, never the dead "minor" arm
    const low = view("Buttons do not have an accessible name", true, "low", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("button-name", low, "accessibility", "a11y").?.impact == "moderate");

    const unknown = view("Buttons do not have an accessible name", true, "catastrophic", false, false, false, 0, 0);
    assert(parse_lighthouse_issue("button-name", unknown, "accessibility", "a11y").?.impact == "moderate");
}

test elements_follow_the_take3_rule_and_need_both_fields {
    const node = view("Image elements do not have alt attributes", true, "serious", true, true, true, 85, 7);
    const issue = parse_lighthouse_issue("image-alt", node, "accessibility", "a11y").?;
    // seven items, take(3): three elements, all carrying the node's one
    // selector/snippet pair and the impact category as label
    assert(issue.elements_count == 3);
    assert(issue.elements[0].selector == "img.hero");
    assert(issue.elements[0].snippet == "<img src=hero.png>");
    assert(issue.elements[0].label == "a11y");
    assert(issue.elements[2].label == "a11y");
    // the audit id, category and score ride along
    assert(issue.id == "image-alt");
    assert(issue.category == "accessibility");
    assert(issue.score == 85);

    // selector without snippet (or the reverse) keeps nothing
    const no_snippet = view("Image elements do not have alt attributes", true, "serious", true, false, true, 85, 3);
    assert(parse_lighthouse_issue("image-alt", no_snippet, "accessibility", "a11y").?.elements_count == 0);

    // no details items at all: an issue with zero elements is still an issue
    const bare = view("Image elements do not have alt attributes", true, "serious", true, true, true, 85, 0);
    assert(parse_lighthouse_issue("image-alt", bare, "accessibility", "a11y").?.elements_count == 0);

    // a missing score reads as 0
    const unscored = view("Image elements do not have alt attributes", true, "serious", true, true, false, 0, 1);
    assert(parse_lighthouse_issue("image-alt", unscored, "accessibility", "a11y").?.score == 0);
}

test parse_accessibility_errors_on_missing_blocks_and_defaults_the_score {
    var issues: [3]Issue = .{
        empty_issue("i1", "accessibility"),
        empty_issue("i2", "aria"),
        empty_issue("i3", "best-practices"),
    };
    // missing accessibility category or missing audit-counts: Err, not a default
    assert(parse_accessibility(false, 85, true, &issues) == null);
    assert(parse_accessibility(true, 85, false, &issues) == null);
    // absent score reads as 0
    const zero = parse_accessibility(true, null, true, &issues).?;
    assert(zero.score == 0);
    assert(zero.navigation_issues == 3);
    assert(zero.aria_issues == 1);
    assert(zero.best_practices_issues == 1);
    // a present score rides through
    assert(parse_accessibility(true, 85, true, &issues).?.score == 85);
}
