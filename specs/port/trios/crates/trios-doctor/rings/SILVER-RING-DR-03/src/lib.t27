// SPDX-License-Identifier: Apache-2.0
// Port of gHashTag/trios crates/trios-doctor/rings/SILVER-RING-DR-03/src/lib.rs
// (286 lines, ring "Report") to .t27. Issue #9544.
//
// The original formats a WorkspaceDiagnosis into four output shapes (human +
// ANSI, pretty JSON, SARIF, GitHub Actions annotations) by pushing formatted
// fragments into String buffers. Formatting needs string interpolation, which
// .t27 does not have, so every function here carries the part of the original
// that DECIDES and leaves the assembly of the text to the interface layer.
//
// Decisions ported (source line numbers in each comment):
//   - overall_status: worst case wins, Red short-circuits (98-108);
//   - a summary line reads as "all passed" iff green == total (76-95);
//   - a human report prints at most 5 message lines per non-green check, but
//     the whole message when the check is green (33-45);
//   - SARIF and GitHub output skip green checks entirely (114-117, 162-165);
//   - the SARIF level is "error" for Red and "warning" for Yellow (118-122);
//     the GitHub level is the same mapping (166-170);
//   - escaping adds one byte per ASCII quote (124-125) or per comma (175).
//
// Left as plumbing, with `undefined` bodies and no test calling them:
//   - print_text / print_json (61-73): they only write to stdout; there is no
//     decision inside them, only the side effect.
//   - the String assembly itself in report_human / report_json / report_sarif /
//     report_github: format! and Vec::push do not exist in .t27, so those
//     functions return the count of the items they would emit instead of the
//     text. The ANSI escapes (lines 7-11) cannot be written either: .t27
//     supports only \n, \t, \\ and \" escapes, so the colour is returned by
//     name and the interface layer owns the escape byte.
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trios::crates::trios_doctor::rings::SILVER_RING_DR_03::src::lib;

// Mirror of trios_doctor_dr00::CheckStatus (the original imports it on line 4).
pub enum CheckStatus { Green, Yellow, Red, }

// lib.rs lines 97-108: `overall_status` starts at Green, returns Red as soon as
// one check is Red (the early `return` skips every later check), and otherwise
// remembers Yellow. An empty diagnosis stays Green.
pub fn overall_status(checks: []const CheckStatus) -> CheckStatus {
    var worst: CheckStatus = .Green;
    for s in checks {
        if (s == .Red) {
            return .Red;
        }
        if (s == .Yellow) {
            worst = .Yellow;
        }
    }
    return worst;
}

// lib.rs lines 76-84: `let all_ok = green == total;` picks the icon. The line
// reads as "all passed" exactly when every check is green, including the empty
// diagnosis (0 == 0).
pub fn summary_line(green: usize, total: usize) -> bool {
    return green == total;
}

// lib.rs lines 24-28: the (color, icon, label) triple for the human report.
// The colour is returned by name because the ANSI escape itself cannot be
// written in .t27 (see the header).
pub fn status_color(status: CheckStatus) -> str {
    return switch (status) {
        .Green => "green",
        .Yellow => "yellow",
        .Red => "red",
    };
}

// lib.rs lines 25-27: the bracketed icon, "OK" / "WARN" / "FAIL".
pub fn status_icon(status: CheckStatus) -> str {
    return switch (status) {
        .Green => "OK",
        .Yellow => "WARN",
        .Red => "FAIL",
    };
}

// lib.rs lines 25-27: the label printed after the icon.
pub fn status_label(status: CheckStatus) -> str {
    return switch (status) {
        .Green => "GREEN",
        .Yellow => "YELLOW",
        .Red => "RED",
    };
}

// lib.rs lines 33-45: a green check prints its message as one unit; a
// non-green check prints `check.message.lines().take(5)` and then, only when
// `failed_crates` is non-empty, one "Affected:" line. So a green check never
// pays the 5-line cap: a 9-line green message is printed in full.
pub fn human_detail_lines(status: CheckStatus, message_lines: usize, has_failed_crates: bool) -> usize {
    if (status == .Green) {
        return 1;
    }
    var shown = message_lines;
    if (shown > 5) {
        shown = 5;
    }
    if (has_failed_crates) {
        return shown + 1;
    }
    return shown;
}

// lib.rs lines 17-57: total lines report_human pushes. Three header lines plus
// the blank after "Crates:" (four newlines, lines 19-21), then per check its
// detail lines plus the trailing blank (46), then the summary line (55).
pub fn report_human(checks: []const CheckStatus, message_lines: []const usize, failed_crates: []const bool) -> usize {
    var total: usize = 5;
    var i: usize = 0;
    while (i < checks.len) {
        const lines = if (i < message_lines.len) message_lines[i] else 0;
        const failed = if (i < failed_crates.len) failed_crates[i] else false;
        total += human_detail_lines(checks[i], lines, failed) + 1;
        i += 1;
    }
    return total;
}

// lib.rs lines 66-68: `to_string_pretty(...).unwrap_or_default()` -- a
// serialisation failure yields an empty body rather than an error, so the
// caller prints an empty line. Returns whether a non-empty body exists.
pub fn report_json(serializable: bool) -> bool {
    return serializable;
}

// lib.rs lines 61-63: prints the human report. Pure side effect, no decision.
pub fn print_text(checks: []const CheckStatus) {
    undefined;
}

// lib.rs lines 71-73: prints the JSON report. Pure side effect, no decision.
pub fn print_json(serializable: bool) {
    undefined;
}

// lib.rs lines 114-131: one SARIF result is built per NON-green check; green
// checks `continue` before the level is computed. The count is what the
// interface layer joins with ",\n".
pub fn report_sarif(checks: []const CheckStatus) -> usize {
    var n: usize = 0;
    for s in checks {
        if (s != .Green) {
            n += 1;
        }
    }
    return n;
}

// lib.rs lines 118-122: "error" for Red, "warning" for Yellow. Green is
// unreachable there because of the `continue` above; the empty string makes
// that explicit instead of panicking.
pub fn sarif_level(status: CheckStatus) -> str {
    return switch (status) {
        .Red => "error",
        .Yellow => "warning",
        .Green => "",
    };
}

// lib.rs lines 162-178: GitHub Actions annotations, one per non-green check.
pub fn report_github(checks: []const CheckStatus) -> usize {
    var n: usize = 0;
    for s in checks {
        if (s != .Green) {
            n += 1;
        }
    }
    return n;
}

// lib.rs lines 166-170: the annotation level, same mapping as SARIF.
pub fn github_level(status: CheckStatus) -> str {
    return switch (status) {
        .Red => "error",
        .Yellow => "warning",
        .Green => "",
    };
}

// lib.rs lines 124-125: `name.replace('"', "\\\"")` -- every ASCII quote grows
// by one byte, nothing else changes. The escaped length is the decision; the
// byte-for-byte copy is the interface layer's.
pub fn escaped_quotes_len(s: str) -> usize {
    var quotes: usize = 0;
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == '"') {
            quotes += 1;
        }
        i += 1;
    }
    return s.len + quotes;
}

// lib.rs line 175: `check.name.replace(',', "\\,")` -- same rule for commas.
pub fn escaped_commas_len(s: str) -> usize {
    var commas: usize = 0;
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == ',') {
            commas += 1;
        }
        i += 1;
    }
    return s.len + commas;
}

test overall_status_worst_case_wins {
    const green_only: [2]CheckStatus = [.Green, .Green];
    const with_yellow: [2]CheckStatus = [.Green, .Yellow];
    const with_red: [2]CheckStatus = [.Green, .Red];
    const red_first: [2]CheckStatus = [.Red, .Yellow];
    const none: [0]CheckStatus = [0]CheckStatus{};
    assert(overall_status(&green_only) == .Green);
    assert(overall_status(&with_yellow) == .Yellow);
    assert(overall_status(&with_red) == .Red);
    assert(overall_status(&red_first) == .Red);
    assert(overall_status(&none) == .Green);
}

test summary_line_is_all_green {
    assert(summary_line(1, 1));
    assert(summary_line(3, 3));
    assert(!summary_line(2, 3));
    assert(!summary_line(0, 1));
    assert(summary_line(0, 0));
}

test status_triples_match_the_match_arms {
    assert(status_color(.Green) == "green");
    assert(status_color(.Yellow) == "yellow");
    assert(status_color(.Red) == "red");
    assert(status_icon(.Green) == "OK");
    assert(status_icon(.Yellow) == "WARN");
    assert(status_icon(.Red) == "FAIL");
    assert(status_label(.Green) == "GREEN");
    assert(status_label(.Yellow) == "YELLOW");
    assert(status_label(.Red) == "RED");
}

test green_messages_are_not_truncated {
    // Green: one unit regardless of how many lines the message has.
    assert(human_detail_lines(.Green, 9, true) == 1);
    assert(human_detail_lines(.Green, 0, false) == 1);
    // Non-green: capped at five message lines.
    assert(human_detail_lines(.Yellow, 2, false) == 2);
    assert(human_detail_lines(.Yellow, 9, false) == 5);
    assert(human_detail_lines(.Red, 0, false) == 0);
    // The "Affected:" line is added only when failed_crates is non-empty.
    assert(human_detail_lines(.Red, 2, true) == 3);
    assert(human_detail_lines(.Red, 9, true) == 6);
}

test report_human_line_count {
    const checks: [2]CheckStatus = [.Green, .Red];
    const lines: [2]usize = [9, 2];
    const failed: [2]bool = [false, true];
    // 4 header newlines + 1 summary, then Green(1)+blank, Red(2+1)+blank.
    assert(report_human(&checks, &lines, &failed) == 5 + 2 + 4);
}

test report_json_falls_back_to_empty {
    assert(report_json(true));
    assert(!report_json(false));
}

test sarif_skips_green_and_maps_levels {
    const checks: [4]CheckStatus = [.Green, .Yellow, .Red, .Green];
    assert(report_sarif(&checks) == 2);
    assert(sarif_level(.Red) == "error");
    assert(sarif_level(.Yellow) == "warning");
    assert(sarif_level(.Green) == "");
}

test github_skips_green_and_maps_levels {
    const checks: [3]CheckStatus = [.Yellow, .Red, .Green];
    assert(report_github(&checks) == 2);
    assert(github_level(.Red) == "error");
    assert(github_level(.Yellow) == "warning");
    assert(github_level(.Green) == "");
}

test escaping_grows_by_the_delimiter_count {
    assert(escaped_quotes_len("plain") == 5);
    assert(escaped_quotes_len("a\"b") == 4);
    assert(escaped_quotes_len("\"\"\"") == 6);
    assert(escaped_commas_len("a,b,c") == 7);
    assert(escaped_commas_len("no-comma") == 8);
}
