// trios-doctor-loop — the Doctor side of the Queen<->Doctor autonomous
// loop client.
// Port of gHashTag/trios:crates/trios-doctor/src/doctor_loop.rs
// (at 8b229e9489ee, 289 lines) — Roadmap Stage 6, goal #4548, target t27c
// gen-rust.
//
// The original connects to trios-server over WebSocket, subscribes to
// broadcast events, filters QueenOrder events targeting the Doctor, runs
// the real Doctor checks for the supported actions, and publishes a
// DoctorReport back onto the bus. The WebSocket connect, the receive
// loop, the UUID request id and the JSON serialization are plumbing; the
// decisions the file makes — the configuration defaults from the
// environment (ws_url, the workspace root from TRIOS_WORKSPACE or the
// current directory, the agent id, the reconnect delay), the frame
// reaction (a Close ends the session clean, a Ping answers a Pong, a
// Text frame is handled, anything else is ignored), the RPC-response
// skip, the order targeting on the agent id, the action dispatch (the
// three supported actions all run the same workspace diagnosis, honestly
// labelled with the requested action; anything else is an honest "noop"
// report), the red/yellow/green status rollup over the checks, and the
// doctor/report method — are ported here as pure functions and tested.
// The main/run_session/handle_text_frame/send_report transports keep
// their names with `undefined;` bodies that no test calls (issue #9525,
// "Port the decision, not the plumbing").
//
// String work the language cannot express is carried as the caller's
// plumbing and named below: the `trim().to_ascii_lowercase()` action
// normalization (line 215) hands the dispatch its normalized action, and
// the `format!` summary composition (lines 234-240) is carried as the
// payload's plan fields (action label, crate count, check count, status)
// instead of a concatenated string.

module port::trios_doctor_loop;

// ---------------------------------------------------------------------------
// Original lines 40-49: `struct LoopConfig { ws_url, workspace_root,
// agent_id, reconnect_delay }`. Only the facts the logic reads; the
// Duration becomes its seconds.
// ---------------------------------------------------------------------------

pub struct LoopConfig {
    ws_url: str,
    workspace_root: str,
    agent_id: str,
    reconnect_secs: u64,
}

// ---------------------------------------------------------------------------
// Original lines 52-76: `fn from_env_and_args() -> Result<Self>`. Every
// environment read falls back: the WebSocket URL defaults to the local
// server, the workspace root comes from TRIOS_WORKSPACE or the current
// directory, the agent id defaults to "doctor", and the reconnect delay
// to 5 seconds when the variable is unset or does not parse. The env
// reads are plumbing; the fallback chain is the decision, ported with
// the presence flag each read would hand the decision.
// ---------------------------------------------------------------------------

pub fn LoopConfig_from_env_and_args(
    ws_url_set: bool,
    ws_url: str,
    workspace_set: bool,
    workspace: str,
    cwd: str,
    agent_id_set: bool,
    agent_id: str,
    reconnect_parsed: bool,
    reconnect_secs: u64,
) -> LoopConfig {
    return LoopConfig {
        ws_url: resolve_ws_url(ws_url_set, ws_url),
        workspace_root: resolve_workspace(workspace_set, workspace, cwd),
        agent_id: resolve_agent_id(agent_id_set, agent_id),
        reconnect_secs: resolve_reconnect_secs(reconnect_parsed, reconnect_secs),
    };
}

pub fn resolve_ws_url(ws_url_set: bool, ws_url: str) -> str {
    if (!ws_url_set) {
        return default_ws_url();
    }
    return ws_url;
}

pub fn resolve_workspace(workspace_set: bool, workspace: str, cwd: str) -> str {
    if (!workspace_set) {
        return cwd;
    }
    return workspace;
}

pub fn resolve_agent_id(agent_id_set: bool, agent_id: str) -> str {
    if (!agent_id_set) {
        return default_agent_id();
    }
    return agent_id;
}

pub fn resolve_reconnect_secs(reconnect_parsed: bool, reconnect_secs: u64) -> u64 {
    if (!reconnect_parsed) {
        return default_reconnect_secs();
    }
    return reconnect_secs;
}

pub fn default_ws_url() -> str {
    return "ws://127.0.0.1:9005/ws";
}

pub fn default_agent_id() -> str {
    return "doctor";
}

pub fn default_reconnect_secs() -> u64 {
    return 5;
}

// ---------------------------------------------------------------------------
// Original line 105: `async fn main() -> Result<()>`. The reconnect loop:
// every session outcome — clean end or transport failure — logs, sleeps
// the reconnect delay and reconnects. Pure transport.
// ---------------------------------------------------------------------------

pub fn main() -> ?str {
    return undefined; // plumbing: the logging init and the reconnect loop (lines 105-129)
}

// ---------------------------------------------------------------------------
// Original lines 131-163: `async fn run_session(cfg) -> Result<()>`. The
// WebSocket session: connect, receive, and react to the frame kinds — a
// Close ends the session cleanly (Ok), a Ping is answered with a Pong, a
// Text frame goes to the handler, everything else is ignored. The
// connect and the receive loop are plumbing; the frame reaction is the
// decision, ported below.
// ---------------------------------------------------------------------------

pub fn run_session(cfg: LoopConfig) -> ?str {
    return undefined; // plumbing: WebSocket connect and receive loop (lines 131-163)
}

pub fn frame_reaction(is_close: bool, is_ping: bool, has_text: bool) -> str {
    if (is_close) {
        return "end";
    }
    if (is_ping) {
        return "pong";
    }
    if (has_text) {
        return "handle";
    }
    return "ignore";
}

// ---------------------------------------------------------------------------
// Original lines 168-205: `async fn handle_text_frame(text, ws, cfg)`.
// Decides whether a text frame is a bus event the Doctor reacts to: a
// frame that is not JSON is silently ignored; a frame with "result" and
// no "type" is an RPC response and skipped; a QueenOrder whose
// target_agent is neither our configured id nor the "doctor" literal is
// ignored; a targeted order is executed and its report sent. The JSON
// parse and the WebSocket write are plumbing; the three gates are the
// decisions, ported below.
// ---------------------------------------------------------------------------

pub fn handle_text_frame(text: str, has_result: bool, has_type: bool, target_agent: str, cfg: LoopConfig) -> ?str {
    return undefined; // plumbing: JSON parse and dispatch onto execute_order/send_report (lines 168-205)
}

// Original line 175: `value.get("result").is_some() && value.get("type").is_none()`.
pub fn is_rpc_response(has_result: bool, has_type: bool) -> bool {
    if (has_result and !has_type) {
        return true;
    }
    return false;
}

// Original line 192: `target_agent != cfg.agent_id && target_agent != "doctor"`.
pub fn order_targets_us(target_agent: str, cfg_agent_id: str) -> bool {
    if (target_agent == cfg_agent_id) {
        return true;
    }
    if (target_agent == "doctor") {
        return true;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Original lines 208-264: `fn execute_order(order_id, action, _params,
// cfg) -> Result<DoctorReportPayload>`. The honest execution: the three
// supported actions ("doctor scan", "doctor quick", "doctor heal") all
// map onto the same workspace diagnosis — the Doctor binary only
// differentiates by exit code — and the report is labelled with the
// requested action; the status rolls up over the checks (any Red beats
// any Yellow beats green); an unknown action is answered with an honest
// "noop" report so the Queen knows it was seen. The Doctor run is
// plumbing; the dispatch, the rollup and the noop answer are the
// decisions, ported here. The `trim().to_ascii_lowercase()` normalization
// (line 215) is the caller's string plumbing: this dispatch takes the
// normalized action.
// ---------------------------------------------------------------------------

pub struct ChecksView {
    any_red: bool,
    any_yellow: bool,
    crate_count: usize,
    check_count: usize,
}

pub struct DoctorReportPayload {
    order_id: str,
    agent_id: str,
    status: str,
    is_noop: bool,
    action_label: str,
    crate_count: usize,
    check_count: usize,
}

pub fn execute_order(
    order_id: str,
    normalized_action: str,
    cfg: LoopConfig,
    view: ChecksView,
) -> DoctorReportPayload {
    if (is_supported_action(normalized_action)) {
        return DoctorReportPayload {
            order_id: order_id,
            agent_id: cfg.agent_id,
            status: report_status(view.any_red, view.any_yellow),
            is_noop: false,
            action_label: normalized_action,
            crate_count: view.crate_count,
            check_count: view.check_count,
        };
    }
    return DoctorReportPayload {
        order_id: order_id,
        agent_id: cfg.agent_id,
        status: "noop",
        is_noop: true,
        action_label: normalized_action,
        crate_count: 0,
        check_count: 0,
    };
}

pub fn is_supported_action(normalized_action: str) -> bool {
    if (normalized_action == "doctor scan") {
        return true;
    }
    if (normalized_action == "doctor quick") {
        return true;
    }
    if (normalized_action == "doctor heal") {
        return true;
    }
    return false;
}

pub fn supported_action_count() -> usize {
    return 3;
}

// Original lines 226-232: any Red check reports red, else any Yellow
// reports yellow, else green.
pub fn report_status(any_red: bool, any_yellow: bool) -> str {
    if (any_red) {
        return "red";
    }
    if (any_yellow) {
        return "yellow";
    }
    return "green";
}

// ---------------------------------------------------------------------------
// Original lines 275-288: `async fn send_report(ws, report)`. Publishes
// the DoctorReport onto the bus as a `doctor/report` method call with a
// fresh UUID id. Pure transport; the method name is the decision worth
// keeping.
// ---------------------------------------------------------------------------

pub fn send_report(report: DoctorReportPayload) -> ?str {
    return undefined; // plumbing: WebSocket send of the serialized report (lines 275-288)
}

pub fn report_method() -> str {
    return "doctor/report";
}

// ---------------------------------------------------------------------------
// Tests: every decision above asserted against values read from the
// original. No test calls a transport.
// ---------------------------------------------------------------------------

test config_defaults_without_env {
    const cfg = LoopConfig_from_env_and_args(false, "", false, "", "/current/dir", false, "", false, 0);
    assert(cfg.ws_url == "ws://127.0.0.1:9005/ws");
    assert(cfg.workspace_root == "/current/dir");
    assert(cfg.agent_id == "doctor");
    assert(cfg.reconnect_secs == 5);
}

test config_env_overrides_pass_through {
    const cfg = LoopConfig_from_env_and_args(true, "ws://other:9005/ws", true, "/ws/root", "/current/dir", true, "doc-9", true, 30);
    assert(cfg.ws_url == "ws://other:9005/ws");
    assert(cfg.workspace_root == "/ws/root");
    assert(cfg.agent_id == "doc-9");
    assert(cfg.reconnect_secs == 30);
}

test rpc_response_detection {
    assert(is_rpc_response(true, false));
    assert(!is_rpc_response(true, true));
    assert(!is_rpc_response(false, false));
}

test order_targeting_on_agent_id {
    assert(order_targets_us("doctor", "doc-9"));
    assert(order_targets_us("doc-9", "doc-9"));
    assert(!order_targets_us("queen", "doc-9"));
}

test frame_reaction_by_kind {
    assert(frame_reaction(true, false, false) == "end");
    assert(frame_reaction(false, true, false) == "pong");
    assert(frame_reaction(false, false, true) == "handle");
    assert(frame_reaction(false, false, false) == "ignore");
}

test supported_actions_set {
    assert(is_supported_action("doctor scan"));
    assert(is_supported_action("doctor quick"));
    assert(is_supported_action("doctor heal"));
    assert(!is_supported_action("doctor dance"));
    assert(supported_action_count() == 3);
}

test report_status_rollup_red_beats_yellow {
    assert(report_status(true, true) == "red");
    assert(report_status(true, false) == "red");
    assert(report_status(false, true) == "yellow");
    assert(report_status(false, false) == "green");
}

test execute_order_runs_the_diagnosis {
    const cfg = LoopConfig_from_env_and_args(false, "", false, "", "/ws/root", false, "", false, 0);
    const red = execute_order("order-1", "doctor scan", cfg, ChecksView {
        any_red: true,
        any_yellow: true,
        crate_count: 12,
        check_count: 40,
    });
    assert(!red.is_noop);
    assert(red.status == "red");
    assert(red.action_label == "doctor scan");
    assert(red.crate_count == 12);
    assert(red.check_count == 40);
    assert(red.agent_id == "doctor");
    const green = execute_order("order-2", "doctor heal", cfg, ChecksView {
        any_red: false,
        any_yellow: false,
        crate_count: 3,
        check_count: 9,
    });
    assert(green.status == "green");
    assert(green.is_noop == false);
}

test execute_order_unknown_is_honest_noop {
    const cfg = LoopConfig_from_env_and_args(false, "", false, "", "/ws/root", false, "", false, 0);
    const noop = execute_order("order-3", "doctor dance", cfg, ChecksView {
        any_red: false,
        any_yellow: false,
        crate_count: 0,
        check_count: 0,
    });
    assert(noop.is_noop);
    assert(noop.status == "noop");
    assert(noop.action_label == "doctor dance");
    assert(noop.order_id == "order-3");
}

test resolver_branches {
    assert(resolve_ws_url(false, "") == "ws://127.0.0.1:9005/ws");
    assert(resolve_ws_url(true, "ws://x:9005/ws") == "ws://x:9005/ws");
    assert(resolve_workspace(false, "", "/cwd") == "/cwd");
    assert(resolve_workspace(true, "/env/root", "/cwd") == "/env/root");
    assert(resolve_agent_id(false, "") == "doctor");
    assert(resolve_agent_id(true, "doc") == "doc");
    assert(resolve_reconnect_secs(false, 0) == 5);
    assert(resolve_reconnect_secs(true, 30) == 30);
    assert(default_ws_url() == "ws://127.0.0.1:9005/ws");
    assert(default_agent_id() == "doctor");
    assert(default_reconnect_secs() == 5);
}

test report_method_name {
    assert(report_method() == "doctor/report");
}
