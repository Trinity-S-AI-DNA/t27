module port::trios::crates::trios_fpga::src::flash;

// Types from the original
pub struct FlashConfig {
    pub board: KnownBoard,
    pub cable: []const u8,
    pub xvc_addr: []const u8,
    pub bitstream: []const u8,
    pub freq: u32,
    pub flash: bool,
    pub verify: bool,
    pub reset: bool,
}

pub struct FlashPipeline {
    config: FlashConfig,
}

pub enum FlashMode {
    SramLoad,
    SpiFlash,
}

pub struct FlashResult {
    pub bitstream: []const u8,
    pub bit_size: u64,
    pub mode: FlashMode,
}

pub enum KnownBoard {
    QmtechA100t,
    ArtyA7_100t,
}

// Ported functions
pub fn FlashConfig_new(board: KnownBoard) -> FlashConfig {
    var config: FlashConfig = undefined;
    config.board = board;
    config.cable = "";
    config.xvc_addr = "";
    config.bitstream = "";
    config.freq = 6_000_000;
    config.flash = false;
    config.verify = false;
    config.reset = false;
    return config;
}

pub fn FlashConfig_detect_cable(config: FlashConfig) -> []const u8 {
    if (config.cable.len > 0) {
        return config.cable;
    } else if (config.xvc_addr.len > 0) {
        return "xvc-client";
    } else {
        return "ft2232";
    }
}

pub fn FlashConfig_detect_bitstream(config: FlashConfig) -> ?[]const u8 {
    // Port the decision logic, but file operations are undefined
    if (config.bitstream.len > 0) {
        // p.exists() would be file system operation
        // return Ok(p.clone());
        return null; // File system operations are undefined
    }
    
    // Candidate file checking would involve file system operations
    // let candidates = [
    //     PathBuf::from("build/fpga/zerodsp_top.bit"),
    //     PathBuf::from("build/fpga/bitstream.bit"),
    // ];
    // for c in &candidates {
    //     if c.exists() {
    //         return Ok(c.clone());
    //     }
    // }
    return null; // File system operations are undefined
}

pub fn FlashPipeline_new(config: FlashConfig) -> FlashPipeline {
    var pipeline: FlashPipeline = undefined;
    pipeline.config = config;
    return pipeline;
}

pub fn FlashPipeline_run(pipeline: FlashPipeline) -> ?FlashResult {
    // This function involves file system operations, process execution, and printing
    // All external interactions are undefined per the rules
    undefined;
}

// Tests
test FlashConfig_new_defaults {
    const config = FlashConfig_new(KnownBoard::QmtechA100t);
    assert(config.freq == 6_000_000);
    assert(!config.flash);
    assert(!config.verify);
    assert(!config.reset);
    assert(config.cable.len == 0);
    assert(config.xvc_addr.len == 0);
    assert(config.bitstream.len == 0);
}

test FlashConfig_detect_cable_defaults {
    const config = FlashConfig_new(KnownBoard::QmtechA100t);
    const cable = FlashConfig_detect_cable(config);
    assert(cable.len > 0);
    // Should default to "ft2232"
}

test FlashConfig_detect_cable_explicit {
    var config = FlashConfig_new(KnownBoard::QmtechA100t);
    config.cable = "custom_cable";
    const cable = FlashConfig_detect_cable(config);
    assert(cable.len > 0);
    // Should return the explicit cable
}

test FlashConfig_detect_cable_xvc {
    var config = FlashConfig_new(KnownBoard::QmtechA100t);
    config.xvc_addr = "192.168.1.100:2542";
    const cable = FlashConfig_detect_cable(config);
    assert(cable.len > 0);
    // Should detect xvc-client
}

test FlashConfig_detect_bitstream {
    var config = FlashConfig_new(KnownBoard::QmtechA100t);
    // File operations are undefined, so we test the decision logic
    const result = FlashConfig_detect_bitstream(config);
    assert(result == null); // No bitstream specified, file ops undefined
}

test FlashPipeline_new {
    const config = FlashConfig_new(KnownBoard::QmtechA100t);
    const pipeline = FlashPipeline_new(config);
    // Verify the config is preserved
    assert(pipeline.config.freq == 6_000_000);
    assert(pipeline.config.board == KnownBoard::QmtechA100t);
}

test FlashMode_equality {
    assert(FlashMode.SramLoad == FlashMode.SramLoad);
    assert(FlashMode.SpiFlash == FlashMode.SpiFlash);
    assert(FlashMode.SramLoad != FlashMode.SpiFlash);
}