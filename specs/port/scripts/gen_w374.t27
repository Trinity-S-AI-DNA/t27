module port::scripts::gen_w374;

; gen_w374 -- t27 port of scripts/gen_w374.py (batch append W374 test/invariant blocks to the IGLA
; specs), retired here with its two successors. The Python files are deleted; this spec is the rule.
; --
; What the script did, kept byte-faithful: find every "// Wave Loop N ... invariant ...true" block
; (re.DOTALL), take the LAST one, refuse unless N == 373, copy that block with five literal
; replacements, and insert the copy right after the block's end. File globbing and I/O stay out of
; the spec (the port rule): append_w374 remains a stub, the callers pass the text in.
; --
; The five replacements (W374, on last wave 373):
;   "Wave Loop 373"               -> "Wave Loop 374"
;   "w373_"                       -> "w374_"
;   "after W372"                  -> "after W373"
;   "W372 seal regeneration"      -> "W373 seal regeneration"
;   "WAVE_LOOP_372_COOPERATION.md"-> "WAVE_LOOP_373_COOPERATION.md"
; The successors, same shape, kept here so the table has one home:
;   W375 (on wave 374): "Wave Loop 374"->375, "w374_"->"w375_", "after W373"->"after W374",
;     "W373 seal regeneration"->"W374 seal regeneration",
;     "WAVE_LOOP_373_COOPERATION.md"->"WAVE_LOOP_374_COOPERATION.md".
;   W376 (on wave 375): "Wave Loop 375"->376, "w375_"->"w376_", "after W374"->"after W375",
;     "W374 seal regeneration"->"W375 seal regeneration",
;     "WAVE_LOOP_374_COOPERATION.md"->"WAVE_LOOP_375_COOPERATION.md".
; --
; One deliberate narrowing, documented rather than hidden: Python's `.*?true` under re.DOTALL could
; in principle stretch across newlines; this port reads the invariant line as one line that starts
; with "invariant " and ends with "true". Every IGLA wave block is written that way.
; --
; gen_w392.t27 is the blessed shape this port follows (dupe ledger).

const MAX_SEGMENTS: usize = 32;
const WAVE_PREFIX: []const u8 = "// Wave Loop ";
const INV_PREFIX: []const u8 = "invariant ";
const EXPECTED_LAST_WAVE: i32 = 373;

pub struct WaveSegment {
    wave: i32,
    start: usize,
    end: usize,
}

pub struct SegmentList {
    items: [MAX_SEGMENTS]WaveSegment,
    len: usize,
}

pub struct WaveBlock {
    wave: i32,
    start: usize,
    end: usize,
}

pub fn wave_segments(text: []const u8) -> SegmentList {
    var segments: SegmentList = SegmentList {
        items: [_]WaveSegment{WaveSegment { wave: 0, start: 0, end: 0 }} ** MAX_SEGMENTS,
        len: 0,
    };

    var i: usize = 0;
    while (i < text.len) {
        if (starts_with_at(text, i, WAVE_PREFIX)) {
            var wave_start = i + WAVE_PREFIX.len;
            var wave_num: i32 = 0;
            var j = wave_start;
            while (j < text.len && text[j] >= '0' && text[j] <= '9') {
                wave_num = wave_num * 10 + (text[j] - '0') as i32;
                j += 1;
            }
            var start = i;
            var end: usize = text.len;
            if (segments.len > 0) {
                segments.items[segments.len - 1].end = start;
            }
            if (segments.len < MAX_SEGMENTS) {
                segments.items[segments.len] = WaveSegment {
                    wave: wave_num,
                    start: start,
                    end: end,
                };
                segments.len += 1;
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return segments;
}

fn starts_with_at(haystack: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > haystack.len) {
        return false;
    }
    var k: usize = 0;
    while (k < needle.len) {
        if (haystack[at + k] != needle[k]) {
            return false;
        }
        k += 1;
    }
    return true;
}

fn mem_eql_at(haystack: []const u8, at: usize, needle: []const u8) -> bool {
    if (at + needle.len > haystack.len) return false;
    var i: usize = 0;
    while (i < needle.len) {
        if (haystack[at + i] != needle[i]) return false;
        i += 1;
    }
    return true;
}

fn copy_bytes_at(dst: []u8, at: usize, src: []const u8) -> void {
    var i: usize = 0;
    while (i < src.len && at + i < dst.len) {
        dst[at + i] = src[i];
        i += 1;
    }
}

/// End index (exclusive, past the newline) of the first line inside [from, limit) that starts with
/// "invariant " and ends with "true". 0 means no such line.
fn invariant_line_end(text: []const u8, from: usize, limit: usize) -> usize {
    var i: usize = from;
    while (i < limit) {
        if (starts_with_at(text, i, INV_PREFIX)) {
            var j: usize = i;
            var line_end: usize = i;
            var saw_newline: bool = false;
            while (j < limit) {
                if (text[j] == '\n') {
                    line_end = j;
                    saw_newline = true;
                    break;
                }
                j += 1;
            }
            if (!saw_newline) {
                line_end = limit;
            }
            if (line_end >= 4 && mem_eql_at(text, line_end - 4, "true")) {
                return if (saw_newline) line_end + 1 else line_end;
            }
        }
        i += 1;
    }
    return 0;
}

/// The LAST wave block that carries an invariant line -- Python's m[-1]. end == 0 means none found.
pub fn last_wave_block(text: []const u8, segments: SegmentList) -> WaveBlock {
    var idx: usize = segments.len;
    var found: WaveBlock = WaveBlock { wave: 0, start: 0, end: 0 };
    while (idx > 0) {
        idx -= 1;
        const seg = segments.items[idx];
        const block_end = invariant_line_end(text, seg.start, seg.end);
        if (block_end != 0) {
            found = WaveBlock { wave: seg.wave, start: seg.start, end: block_end };
            return found;
        }
    }
    return found;
}

/// Python's `if wave != 373: SKIP`.
pub fn should_append(wave: i32) -> bool {
    return wave == EXPECTED_LAST_WAVE;
}

pub fn build_w374_block(w373_block: []const u8, out: []u8) -> usize {
    var src_i: usize = 0;
    var dst_i: usize = 0;
    while (src_i < w373_block.len && dst_i < out.len) {
        if (src_i + 13 <= w373_block.len && mem_eql_at(w373_block, src_i, "Wave Loop 373")) {
            copy_bytes_at(out, dst_i, "Wave Loop 374");
            src_i += 13;
            dst_i += 13;
        } else if (src_i + 5 <= w373_block.len && mem_eql_at(w373_block, src_i, "w373_")) {
            copy_bytes_at(out, dst_i, "w374_");
            src_i += 5;
            dst_i += 5;
        } else if (src_i + 10 <= w373_block.len && mem_eql_at(w373_block, src_i, "after W372")) {
            copy_bytes_at(out, dst_i, "after W373");
            src_i += 10;
            dst_i += 10;
        } else if (src_i + 22 <= w373_block.len && mem_eql_at(w373_block, src_i, "W372 seal regeneration")) {
            copy_bytes_at(out, dst_i, "W373 seal regeneration");
            src_i += 22;
            dst_i += 22;
        } else if (src_i + 28 <= w373_block.len && mem_eql_at(w373_block, src_i, "WAVE_LOOP_372_COOPERATION.md")) {
            copy_bytes_at(out, dst_i, "WAVE_LOOP_373_COOPERATION.md");
            src_i += 28;
            dst_i += 28;
        } else {
            out[dst_i] = w373_block[src_i];
            src_i += 1;
            dst_i += 1;
        }
    }
    return dst_i;
}

/// text[:block_start] ++ new_block[:new_len] ++ text[block_end:], returned by length.
pub fn splice_w374(text: []const u8, block_start: usize, block_end: usize, new_block: []const u8, new_len: usize, out: []u8) -> usize {
    var dst_i: usize = 0;
    var i: usize = 0;
    while (i < block_start && dst_i < out.len) {
        out[dst_i] = text[i];
        dst_i += 1;
        i += 1;
    }
    i = 0;
    while (i < new_len && dst_i < out.len) {
        out[dst_i] = new_block[i];
        dst_i += 1;
        i += 1;
    }
    i = block_end;
    while (i < text.len && dst_i < out.len) {
        out[dst_i] = text[i];
        dst_i += 1;
        i += 1;
    }
    return dst_i;
}

fn mem_eql(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) return false;
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) return false;
        i += 1;
    }
    return true;
}

/// File globbing and read/write stay out of the spec (the port rule).
pub fn append_w374(path: []const u8) -> void {
    undefined;
}

test wave_segments_single {
    const text = "// Wave Loop 1\nsome content\n// Wave Loop 2\nmore content";
    const segs = wave_segments(text);
    assert(segs.len == 2);
    assert(segs.items[0].wave == 1);
    assert(segs.items[0].start == 0);
    assert(segs.items[0].end == 28);
    assert(segs.items[1].wave == 2);
    assert(segs.items[1].start == 28);
    assert(segs.items[1].end == text.len);
}

test wave_segments_empty {
    const text = "no wave loops here";
    const segs = wave_segments(text);
    assert(segs.len == 0);
}

test last_wave_block_takes_the_last_with_invariant {
    const text = "// Wave Loop 372\ninvariant w372_ok == true\n// Wave Loop 373\ninvariant w373_ok == true\ntail";
    const segs = wave_segments(text);
    assert(segs.len == 2);
    const last = last_wave_block(text, segs);
    assert(last.wave == 373);
    assert(last.end != 0);
    assert(last.end == 86);
    assert(should_append(last.wave));
}

test last_wave_block_refuses_wrong_wave {
    const text = "// Wave Loop 372\ninvariant w372_ok == true\ntail";
    const segs = wave_segments(text);
    const last = last_wave_block(text, segs);
    assert(last.wave == 372);
    assert(!should_append(last.wave));
}

test last_wave_block_none_when_no_invariant {
    const text = "no wave blocks at all";
    const segs = wave_segments(text);
    const last = last_wave_block(text, segs);
    assert(last.end == 0);
}

test build_w374_block_replacements {
    const w373 = "// Wave Loop 373\nw373_test\nafter W372\nW372 seal regeneration\nWAVE_LOOP_372_COOPERATION.md";
    var out: [200]u8 = [_]u8{0} ** 200;
    const len = build_w374_block(w373, &out);
    const expected = "// Wave Loop 374\nw374_test\nafter W373\nW373 seal regeneration\nWAVE_LOOP_373_COOPERATION.md";
    assert(len == expected.len);
    var i: usize = 0;
    while (i < len) {
        assert(out[i] == expected[i]);
        i += 1;
    }
}

test build_w374_block_no_match {
    const w373 = "nothing to replace here";
    var out: [100]u8 = [_]u8{0} ** 100;
    const len = build_w374_block(w373, &out);
    const expected = "nothing to replace here";
    assert(len == expected.len);
    assert(mem_eql(out[0..len], expected));
}

test the_full_chain_matches_the_python_result {
    const text = "// Wave Loop 373\n; w373_gate: race window after W372, W372 seal regeneration, see WAVE_LOOP_372_COOPERATION.md\ninvariant w373_gate_stable == true\ntail content";
    const segs = wave_segments(text);
    const last = last_wave_block(text, segs);
    assert(last.wave == 373);
    assert(last.start == 0);
    var new_block: [256]u8 = [_]u8{0} ** 256;
    const new_len = build_w374_block(text[0..last.end], &new_block);
    var spliced: [320]u8 = [_]u8{0} ** 320;
    const total = splice_w374(text, last.start, last.end, &new_block, new_len, &spliced);
    const expected = "// Wave Loop 374\n; w374_gate: race window after W373, W373 seal regeneration, see WAVE_LOOP_373_COOPERATION.md\ninvariant w374_gate_stable == true\ntail content";
    assert(total == expected.len);
    var i: usize = 0;
    while (i < total) {
        assert(spliced[i] == expected[i]);
        i += 1;
    }
}
