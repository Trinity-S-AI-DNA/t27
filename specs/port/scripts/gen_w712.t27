// SPDX-License-Identifier: MIT
// Path: specs/port/scripts/gen_w712.t27
// Port of scripts/gen_w712.py to t27
//
// WHAT THIS PORT DELIBERATELY DOES NOT CONTAIN
// (Decisions deliberately not made in the target language:)
// - The 15,552-leaf array-literal text itself: Python lines 37-57 assemble
//   it with f-strings and str concatenation, and this language has no
//   string concatenation and no growable lists. build_tree therefore ports
//   the numbers the same recursion computes - how many leaves a subtree
//   carries and where base lands - while the per-leaf coordinate decision
//   is carried by coord_x/coord_y. Assembling the text stays Python's job.
// - The f-string header/footer and dims assembly (Python lines 66-77):
//   string formatting, same gap.
// - The file write (line 138), the print (line 141) and the size/bytes
//   report (lines 143-145): plumbing with no target-language constructs.
// WHAT IS PORTED
// - indent (line 25), the leaf coordinate formulas (lines 41-42), the
//   row-major flat index (comment lines 15-17), the base advance of the
//   build_tree recursion (lines 35-58), and the non-ASCII gate that guards
//   the write (lines 135-136) - each with tests.
// - LAST_IDX, MID_IDX, MID_E and the coordinate constants are not dead
//   consts here; their formulas and exact values are pinned by tests
//   through flat_index/coord_x/coord_y.

module port::scripts::gen_w712;

pub const OUTER: i64 = 243;   // Python line 9
pub const TOTAL: i64 = 15552; // Python line 10: OUTER * 2**6
pub const WRAP: i64 = 32768;  // the u16 modulus on lines 13-21 and 41-42

// Python: def indent(level: int) -> str (lines 24-25): return "    " * level.
// The generator only ever asks for 0 (no-op), 1 (the per-line prefix in
// generate, line 68) and 2 (the entry lines in build_tree, line 43); levels
// 3..=4 are carried for margin and anything above is out of the
// generator's reach - string repetition does not exist here.
pub fn indent(level: i64) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    return "                ";
}

// Python: build_tree's leaf coordinates (lines 40-42). Element e carries
// x = (2*e + offset) % 32768; u16 storage in the generated bench makes the
// modulus the wrap point.
pub fn coord_x(e: i64, offset: i64) -> i64 {
    return (2 * e + offset) % WRAP;
}

// Python: lines 40-42, second coordinate: y = (2*e + offset + 1) % 32768.
pub fn coord_y(e: i64, offset: i64) -> i64 {
    return (2 * e + offset + 1) % WRAP;
}

// Python: the module comment (lines 15-17) states the row-major flat index
// of [o][i1]..[i6] is o*64 + i1*32 + i2*16 + i3*8 + i4*4 + i5*2 + i6, which
// is how MID_E = MID_IDX * 64 + 32 (line 17) and the LAST/MID coordinates
// (lines 11-21) are derived.
pub fn flat_index(o: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64) -> i64 {
    return o * 64 + i1 * 32 + i2 * 16 + i3 * 8 + i4 * 4 + i5 * 2 + i6;
}

// Python: def build_tree(shape: list[int], base: int, offset: int)
//         -> tuple[str, int] (lines 28-58).
// The recursion is kept: the single-dim case hands each element
// e = base + i its coordinates and returns base + n (line 46); the
// multi-dim case recurses n times on the inner shape and returns the
// accumulated base (line 58). Two adaptations, both forced by the language:
//   - Python recurses on shape[1:], but slicing a slice is not expressible
//     (the generator emits indexing for it), so the recursion carries the
//     start index into the same slice.
//   - The returned text half is the unplumbable string assembly; the port
//     returns what the same walk computes numerically: the number of leaves
//     the subtree carries (next_base - base, and what every parent's loop
//     accumulates) and where base lands.
pub fn build_tree(shape: []const i64, start: usize, base: i64, offset: i64) -> (i64, i64) {
    if (start + 1 == shape.len) {
        const n: i64 = shape[start];
        return (n, base + n);
    }
    var leaves: i64 = 0;
    var b: i64 = base;
    var i: i64 = 0;
    const n: i64 = shape[start];
    while (i < n) {
        const (sub_leaves, sub_next) = build_tree(shape, start + 1, b, offset);
        leaves += sub_leaves;
        b = sub_next;
        i += 1;
    }
    return (leaves, b);
}

// Python: the non-ASCII gate that guards the write (lines 135-136):
// `if not all(ord(ch) < 128 for ch in text): raise ValueError(...)`.
// The empty text passes, as all() over an empty iterable does.
pub fn is_ascii(text: []const u8) -> bool {
    var i: usize = 0;
    while (i < text.len) {
        if (text[i] >= 128) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Python: def generate() -> None (lines 61-146). The body only moves data:
// it assembles the bench module text (f-strings, lines 37-77), writes
// specs/scratch/w712_bench_module_243x2p6_aos_var_call_write.t27
// (line 138) and prints a summary (lines 141-145). None of that is
// expressible here, so the body stays empty; its one decision - the
// non-ASCII gate - is ported as is_ascii above. No test calls this
// function (FR-001).
pub fn generate() {
    undefined;
}

test indent_matches_python_spacing {
    // "    " * level for every level the generator can reach.
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
    assert(indent(4) == "                ");
}

test build_tree_single_dim_advances_base_by_n {
    // Line 46: the single-dim case returns base + n.
    var one: [1]i64 = [4];
    const (leaves, next_base) = build_tree(&one, 0, 10, 7);
    assert(leaves == 4);
    assert(next_base == 14);
    // ...and from a zero base: two leaves, base lands on 2.
    var two: [1]i64 = [2];
    const (leaves0, next_base0) = build_tree(&two, 0, 0, 0);
    assert(leaves0 == 2);
    assert(next_base0 == 2);
}

test build_tree_full_shape_advances_base_to_total {
    // Lines 62-63: shape = [OUTER, 2, 2, 2, 2, 2, 2], build_tree(shape, 0, 0);
    // the walk must land on exactly TOTAL (line 10: OUTER * 2**6) leaves.
    var full: [7]i64 = [OUTER, 2, 2, 2, 2, 2, 2];
    const (leaves, next_base) = build_tree(&full, 0, 0, 0);
    assert(leaves == TOTAL);
    assert(next_base == TOTAL);
}

test build_tree_inner_subtree_advances_by_64 {
    // The recursion one level in: the subtree under one outer index holds
    // the six 2-dims, 64 leaves; starting at base MID_IDX * 64 = 7744 it
    // lands on 7808 (comment lines 15-16).
    var inner: [6]i64 = [2, 2, 2, 2, 2, 2];
    const (leaves, next_base) = build_tree(&inner, 0, 7744, 0);
    assert(leaves == 64);
    assert(next_base == 7808);
}

test flat_index_is_row_major {
    // Comment lines 15-17: MID_IDX = 121 and MID_E = 121 * 64 + 32.
    assert(flat_index(121, 1, 0, 0, 0, 0, 0) == 7776);
    // The LAST element dst[242][1][1][1][1][1][1] is flat element 15551.
    assert(flat_index(242, 1, 1, 1, 1, 1, 1) == 15551);
    // The first element is flat element 0.
    assert(flat_index(0, 0, 0, 0, 0, 0, 0) == 0);
}

test leaf_coordinates_match_the_generated_bench {
    // The values the generated bench hard-codes (its lines 86-91):
    // dst[0][0][0][0][0][0][0] -> (0, 1).
    assert(coord_x(0, 0) == 0);
    assert(coord_y(0, 0) == 1);
    // dst[LAST_IDX][1][1][1][1][1][1] -> LAST_X/LAST_Y (lines 13-14).
    assert(coord_x(TOTAL - 1, 0) == 31102);
    assert(coord_y(TOTAL - 1, 0) == 31103);
    // dst[MID_IDX][1][0][0][0][0][0] -> MID_X/MID_Y (lines 18-19).
    assert(coord_x(7776, 0) == 15552);
    assert(coord_y(7776, 0) == 15553);
}

test offset_wraps_modulo_32768 {
    // The generated bench's explicit wrap check (its lines 92-94):
    // make_grid(32768) folds back to 0..1 for the first element.
    assert(coord_x(0, WRAP) == 0);
    assert(coord_y(0, WRAP) == 1);
    // ...and WRAP_LAST_X/Y equal the unwrapped values (lines 20-21, 95-96).
    assert(coord_x(TOTAL - 1, WRAP) == 31102);
    assert(coord_y(TOTAL - 1, WRAP) == 31103);
}

test ascii_gate_guards_the_write {
    // Lines 135-136: text made only of ASCII bytes passes the gate...
    assert(is_ascii("pub const expected = [2][243]i32 {"));
    // ...a high byte does not (the gate raises before line 138 writes)...
    var buf: [4]u8 = undefined;
    const src = "ab";
    buf[0] = src[0];
    buf[1] = 200;
    assert(!is_ascii(buf[0..2]));
    // ...and the empty text passes, as all() over nothing does.
    assert(is_ascii(buf[0..0]));
}
