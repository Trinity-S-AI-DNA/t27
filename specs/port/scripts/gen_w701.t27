module port::scripts::gen_w701;

// Port of scripts/gen_w701.py (gHashTag/t27 at fef92ca29a0b, 146 lines), the
// generator of specs/scratch/w701_bench_module_221x2p6_aos_var_call_write.t27.
//
// The Python script decides, then formats: it walks the shape
// [221, 2, 2, 2, 2, 2, 2] row-major, gives element e the coordinates
// (2*e + offset) % 32768 and (2*e + offset + 1) % 32768, wraps them in a
// nested literal with dims annotations and indentation, guards the output to
// ASCII, and writes the file. Text assembly (f-strings, "\n".join) and the
// file write are plumbing this language cannot express yet (no string
// concatenation, no format, no file access), so generate() keeps its name
// with an undefined body and no test calls it. Every decision the script
// makes lives in the constants and pure helpers below, and each of them is
// under test:
//   - the header constants (original lines 9-21) -> OUTER, TOTAL, LAST_IDX, MID_IDX, MID_E
//   - the indent unit (original lines 24-25)     -> indent
//   - the element coordinate rule (lines 41-42)  -> elem_xy
//   - the recursive literal layout (lines 28-58) -> build_tree / build_tree_at
//   - the ASCII output guard (lines 135-136)     -> is_ascii_text

// The numeric shadow of build_tree's returned (text, next_base) tuple: the
// text is formatting, these numbers are the decision it encodes.
pub struct TreePlan {
    next_base: usize,
    leaves: usize,
    first_x: usize,
    first_y: usize,
    last_x: usize,
    last_y: usize,
}

// Original lines 9-21. TOTAL = OUTER * 2**6 = 221 * 64 = 14144.
pub const OUTER: usize = 221;
pub const TOTAL: usize = OUTER * 64;
pub const LAST_IDX: usize = OUTER - 1;
pub const MID_IDX: usize = OUTER / 2; // 110
pub const MID_E: usize = MID_IDX * 64 + 32; // 110 * 64 + 32

// Original lines 24-25: return "    " * level. Strings cannot be multiplied
// here, so the indent unit is a table over the levels the generator uses
// (the deepest text it emits sits at level 3; the table reaches level 8).
pub fn indent(level: usize) -> []const u8 {
    const table: [9][]const u8 = ["", "    ", "        ", "            ", "                ", "                    ", "                        ", "                            ", "                                "];
    const lv: usize = if (level > 8) 8 else level;
    return table[lv];
}

// Original lines 41-42: the rule every leaf entry obeys, with e the element's
// row-major number across the whole shape and offset the make_grid argument.
pub fn elem_xy(e: usize, offset: usize) -> (usize, usize) {
    const x: usize = (2 * e + offset) % 32768;
    const y: usize = (2 * e + offset + 1) % 32768;
    return (x, y);
}

// Original lines 28-58, recursive half. Subtree k of a non-leaf level
// continues at base + k * leaves(inner), which is what fixes the row-major
// element numbering; a leaf of width n emits entries base + 0 ..
// base + n - 1 and advances the base by n. Requires every dimension >= 1,
// which holds for every shape the generator builds.
fn build_tree_at(shape: []const usize, depth: usize, base: usize, offset: usize) -> TreePlan {
    const n: usize = shape[depth];
    var leaves: usize = 0;
    if (depth + 1 == shape.len) {
        leaves = n;
    } else {
        var k: usize = 0;
        while (k < n) {
            const sub: TreePlan = build_tree_at(shape, depth + 1, base + leaves, offset);
            leaves += sub.leaves;
            k += 1;
        }
    }
    const (fx, fy) = elem_xy(base, offset);
    const (lx, ly) = elem_xy(base + leaves - 1, offset);
    return TreePlan { next_base: base + leaves, leaves: leaves, first_x: fx, first_y: fy, last_x: lx, last_y: ly };
}

// Original line 28: def build_tree(shape, base, offset) -> (text, next_base).
// The text half is formatting (see the header note); the port returns the
// numbers that text encodes.
pub fn build_tree(shape: []const usize, base: usize, offset: usize) -> TreePlan {
    return build_tree_at(shape, 0, base, offset);
}

// Original lines 135-136: raise ValueError unless every byte of the output is
// ASCII. Here the verdict is the return value; the caller raises.
pub fn is_ascii_text(text: []const u8) -> bool {
    for c in text {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Original lines 61-141: assemble the module text (header, make_grid, footer
// with its test and bench) and write it to
// specs/scratch/w701_bench_module_221x2p6_aos_var_call_write.t27, then print
// a one-line summary. String building and file writes do not exist in this
// language yet, so the body stays undefined; the decisions it contained are
// carried by the tested constants and helpers above. No test calls this.
pub fn generate() {
    undefined;
}

test indent_levels {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test element_coordinates {
    const (x0, y0) = elem_xy(0, 0);
    assert(x0 == 0);
    assert(y0 == 1);
    const (xm, ym) = elem_xy(7072, 0);
    assert(xm == 14144);
    assert(ym == 14145);
    const (xl, yl) = elem_xy(14143, 0);
    assert(xl == 28286);
    assert(yl == 28287);
}

test element_coordinates_wrap {
    // Original footer lines 92-96: offset 32768 folds back onto offset 0.
    const (x0, y0) = elem_xy(0, 32768);
    assert(x0 == 0);
    assert(y0 == 1);
    const (xl, yl) = elem_xy(14143, 32768);
    assert(xl == 28286);
    assert(yl == 28287);
}

test header_constants {
    // Recomputed from runtime values so the asserts are not constant-folded
    // into a vacuous pass: product = 221 * 2**6 = 14144.
    var outer: usize = 221;
    var product: usize = outer;
    var d: usize = 0;
    while (d < 6) {
        product = product * 2;
        d += 1;
    }
    assert(OUTER == outer);
    assert(TOTAL == product);
    assert(LAST_IDX == outer - 1);
    assert(MID_IDX == outer / 2);
    const mid: usize = outer / 2;
    assert(MID_E == mid * 64 + 32);
}

test build_tree_leaf_advances_base {
    var leaf: [1]usize = [8];
    const p: TreePlan = build_tree(&leaf, 100, 0);
    assert(p.next_base == 108);
    assert(p.leaves == 8);
    assert(p.first_x == 200);
    assert(p.first_y == 201);
    assert(p.last_x == 214);
    assert(p.last_y == 215);
}

test build_tree_nested_advances_base {
    var cube: [3]usize = [2, 2, 2];
    const p: TreePlan = build_tree(&cube, 5, 0);
    assert(p.next_base == 13);
    assert(p.leaves == 8);
    assert(p.first_x == 10);
    assert(p.first_y == 11);
    assert(p.last_x == 24);
    assert(p.last_y == 25);
}

test build_tree_full_shape {
    var full: [7]usize = [221, 2, 2, 2, 2, 2, 2];
    const p: TreePlan = build_tree(&full, 0, 0);
    assert(p.next_base == TOTAL);
    assert(p.leaves == TOTAL);
    assert(p.first_x == 0);
    assert(p.first_y == 1);
    assert(p.last_x == 28286);
    assert(p.last_y == 28287);
}

test build_tree_offset_wrap {
    var full: [7]usize = [221, 2, 2, 2, 2, 2, 2];
    const p: TreePlan = build_tree(&full, 0, 32768);
    assert(p.first_x == 0);
    assert(p.first_y == 1);
    assert(p.last_x == 28286);
    assert(p.last_y == 28287);
    const q: TreePlan = build_tree(&full, 0, 0);
    assert(q.last_x == p.last_x);
    assert(q.last_y == p.last_y);
}

test build_tree_at_leaf_depth {
    var pair: [2]usize = [2, 2];
    const sub: TreePlan = build_tree_at(&pair, 1, 7, 0);
    assert(sub.leaves == 2);
    assert(sub.next_base == 9);
    assert(sub.first_x == 14);
    assert(sub.last_y == 17);
}

test ascii_guard {
    assert(is_ascii_text("module w701_bench_module_221x2p6_aos_var_call_write"));
    assert(is_ascii_text(""));
    var bad: [3]u8 = [111, 200, 107];
    assert(!is_ascii_text(&bad));
}
