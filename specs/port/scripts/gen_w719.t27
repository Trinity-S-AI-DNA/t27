module port::scripts::gen_w719;

// Port of gHashTag/t27 scripts/gen_w719.py (146 lines, 3 functions), the
// generator of specs/scratch/w719_bench_module_257x2p6_aos_var_call_write.t27:
// a 257 x 2^6 array-of-structs benchmark spec with a make_grid function, a
// module var, a test and a bench.
//
// Porting notes, per the brief's "port the decision, not the plumbing":
// - indent (line 24) returns "    " * level in Python. .t27 cannot build or
//   multiply strings today, so the decision ports as the width: the number
//   of leading spaces (4 per level); the caller emits them.
// - build_tree (lines 28-58) returns (text, next_base). The text assembly
//   (f-strings, ",\n".join, lines 37-57) is not expressible in .t27 today;
//   the state decision ports exactly: next_base = base + product(shape)
//   (leaf: base + n, line 46; internal: base advanced through n children,
//   lines 53-58), returned together with the literal's leaf count as
//   (u32, u32). The per-element coordinates x = (2*e + offset) % 32768 and
//   y = (2*e + offset + 1) % 32768 (lines 41-42) port as elem_x / elem_y.
// - generate (lines 61-141) assembles the text, writes it to DST and prints
//   a summary (lines 138-141): plumbing, so it keeps its name with an
//   undefined body and no test calls it. Its decisions port as the module
//   constants below (lines 9-21) and the ASCII gate is_ascii (lines 135-136:
//   the original raises ValueError when the text is not pure ASCII).

const MODULUS: u32 = 32768;   // the x/y wrap modulus used throughout lines 41-96
const OUTER: u32 = 257;       // line 9
const TOTAL: u32 = 16448;     // OUTER * 2**6, line 10
const LAST_IDX: u32 = 256;    // OUTER - 1, line 11
const MID_IDX: u32 = 128;     // OUTER // 2, line 12
const MID_E: u32 = 8224;      // MID_IDX * 2**6 + 32, line 17
const LAST_ELEM: u32 = 16447; // TOTAL - 1, the last numbered element

// Python line 24-25: `return "    " * level` — 4 spaces per level.
pub fn indent(level: usize) -> usize {
    return 4 * level;
}

// Python lines 41-42: x = (2 * e + offset) % 32768.
pub fn elem_x(e: u32, offset: u32) -> u32 {
    return (2 * e + offset) % MODULUS;
}

// Python lines 41-42: y = (2 * e + offset + 1) % 32768.
pub fn elem_y(e: u32, offset: u32) -> u32 {
    return (2 * e + offset + 1) % MODULUS;
}

// Python lines 28-58: build_tree(shape, base, offset) -> (text, next_base).
// A leaf of n entries hands out base..base+n (line 46 returns base + n); an
// internal node walks its n children in order (lines 53-58), so the base
// ends at base + product(shape) either way. Returns (next_base, leaf_count).
// The offset only colours the text the original assembles, which .t27
// cannot build today; the coordinates it decides live in elem_x/elem_y.
pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> (u32, u32) {
    var prod: u32 = 1;
    for d in shape {
        prod = prod * d;
    }
    return (base + prod, prod);
}

// Python lines 135-136: raise ValueError unless every character is ASCII.
pub fn is_ascii(text: []const u8) -> bool {
    for c in text {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Python lines 61-141: assembles the text and writes DST, then prints a
// summary. The write and the print are plumbing; the decisions live in the
// helpers and constants above. No test calls this.
pub fn generate() -> void {
    undefined;
}

test w719_constants {
    // Lines 9-21, as the original derives them. build_tree over a one-dim
    // shape of TOTAL supplies runtime values so the asserts execute.
    var shape: [1]u32 = [TOTAL];
    const (next_base, elems) = build_tree(&shape, 0, 0);
    assert(next_base == TOTAL);
    assert(elems == OUTER * 64);
    assert(LAST_ELEM == elems - 1);
    assert(LAST_IDX == OUTER - 1);
    assert(MID_IDX == OUTER / 2);
    assert(MID_E == MID_IDX * 64 + 32);
    assert(MODULUS == 32768);
}

test indent_widths {
    // Line 25: "    " * level.
    assert(indent(0) == 0);
    assert(indent(1) == 4);
    assert(indent(2) == 8);
    assert(indent(3) == 12);
}

test build_tree_leaf_advances_base {
    // Line 46: a leaf returns base + n.
    var leaf: [1]u32 = [4];
    const (next_base, elems) = build_tree(&leaf, 10, 0);
    assert(next_base == 14);
    assert(elems == 4);
}

test build_tree_nested_advances_base {
    // Lines 53-58: 3 children of 2 entries each advance the base to 6.
    var shape: [2]u32 = [3, 2];
    const (next_base, elems) = build_tree(&shape, 0, 0);
    assert(next_base == 6);
    assert(elems == 6);
}

test build_tree_w719_shape_totals {
    // generate()'s own call, lines 62-63: shape = [257, 2, 2, 2, 2, 2, 2],
    // base 0 — the numbering ends at TOTAL = 16448.
    var shape: [7]u32 = [257, 2, 2, 2, 2, 2, 2];
    const (next_base, elems) = build_tree(&shape, 0, 0);
    assert(next_base == TOTAL);
    assert(elems == TOTAL);
}

test elem_coords_low {
    // Lines 41-42 at offset 0: element 0 gets x=0, y=1; element 1 gets x=2,
    // y=3 (matches the footer's dst[0]...x == 0, dst[0]...y == 1).
    assert(elem_x(0, 0) == 0);
    assert(elem_y(0, 0) == 1);
    assert(elem_x(1, 0) == 2);
    assert(elem_y(1, 0) == 3);
    assert(elem_x(3, 5) == 11);
    assert(elem_y(3, 5) == 12);
}

test elem_coords_wrap_and_offsets {
    // Footer values the original bakes in: LAST_X/LAST_Y (lines 13-14,
    // computed at lines 88-89).
    assert(elem_x(LAST_ELEM, 0) == 126);
    assert(elem_y(LAST_ELEM, 0) == 127);
    // MID_X/MID_Y (lines 17-19, computed at lines 90-91).
    assert(elem_x(MID_E, 0) == 16448);
    assert(elem_y(MID_E, 0) == 16449);
    // Offset 32768 folds back onto offset 0 (lines 92-96): the same
    // coordinates come out with the wrapped offset.
    assert(elem_x(0, MODULUS) == 0);
    assert(elem_y(0, MODULUS) == 1);
    assert(elem_x(LAST_ELEM, MODULUS) == 126);
    assert(elem_y(LAST_ELEM, MODULUS) == 127);
}

test generated_text_is_ascii {
    // Lines 135-136: the original refuses to write non-ASCII text.
    assert(is_ascii("module w719_bench_module_257x2p6_aos_var_call_write"));
    var bad: [4]u8 = [104, 233, 108, 111];
    assert(!is_ascii(&bad));
}
