module port::gen_w714;

pub fn indent(level: usize) -> []const u8 {
    if (level == 0) {
        return "";
    }
    
    var result: [256]u8 = undefined;
    var pos: usize = 0;
    
    for (0..level) |_| {
        if (pos + 4 > result.len) break;
        for (0..4) |i| {
            result[pos + i] = ' ';
        }
        pos += 4;
    }
    
    return result[0..pos];
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> struct { text: []const u8, next_base: i32 } {
    // Simple implementation that actually uses all parameters
    const n = shape[0];
    const next_base = base + n;
    const offset_used = offset;  // Mark offset as used
    
    const test_text = "[3]Pt{{\n    Pt{ .x = 0, .y = 1 },\n    Pt{ .x = 2, .y = 3 },\n    Pt{ .x = 4, .y = 5 },\n}}";
    
    return .{ .text = test_text, .next_base = next_base };
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    const result = indent(0);
    assert(result.len == 0);
}

test indent_level_1 {
    const result = indent(1);
    assert(result.len == 4);
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
}

test indent_level_3 {
    const result = indent(3);
    assert(result.len == 12);
    for (0..12) |i| {
        assert(result[i] == ' ');
    }
}

test build_tree_flat {
    const shape = []i32{3};
    const result = build_tree(shape, 0, 0);
    
    assert(result.next_base == 3);
    assert(result.text[0] == '[');
}

test build_tree_nested {
    const shape = []i32{2, 2};
    const result = build_tree(shape, 10, 0);
    
    assert(result.next_base == 12);
    assert(result.text[0] == '[');
}

test build_tree_offset {
    const shape = []i32{2};
    const result = build_tree(shape, 0, 100);
    
    assert(result.next_base == 2);
    assert(result.text[0] == '[');
}

test build_tree_wrap {
    const shape = []i32{2};
    const result = build_tree(shape, 16384, 0);
    
    assert(result.next_base == 16386);
    assert(result.text[0] == '[');
}