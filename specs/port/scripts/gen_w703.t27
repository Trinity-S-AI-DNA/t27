// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w703.t27
// Port of scripts/gen_w703.py to t27
//
// The original writes specs/scratch/w703_bench_module_225x2p6_aos_var_call_write.t27:
// a 225x2^6 point-field literal plus an inline test, built by joining string
// chunks with f-strings and re-indenting the body under `def make_grid():`.
//
// WHAT CANNOT BE EXPRESSED: the text assembly itself. t27 has no way to join
// strings, no f-strings, and no growable buffers, so the 434-line
// literal cannot be built here. What IS ported is every decision the text
// encodes, because the generated test asserts on the points: element e of
// the flattened field is (x, y) = ((2e + offset) % 32768, (2e + offset + 1)
// % 32768), and make_grid(offset=32768) is expected to fold back onto the
// same 0..1 pair that offset=0 produces. The remaining decisions are the
// row-major flattening behind [MID_IDX][1][0][0][0][0][0], the base advance
// across a nested shape (a leaf advances the base by its extent; an inner
// node relays the base its last child leaves), the four-spaces-per-level
// indentation rule, and the ASCII guard the write applies.
//
// The write itself, the stdout status line, and the re-indentation are plumbing.
// `generate` keeps its original name with an undefined body; no test calls
// it, mirroring the original where generate() is also only invoked by hand.

module port::gen_w703 {

    const SPACES_PER_LEVEL: i64 = 4;   // indent: "    " * level
    const MOD: i64 = 32768;            // the fold the points live in

    const OUTER: i64 = 225;            // SHAPE[0]: the outer extent
    const INNER_ELEMS: i64 = 64;       // 2 ** 6: the six inner dims of 2
    const TOTAL: i64 = OUTER * INNER_ELEMS;   // 14400 points

    const LAST_IDX: i64 = 224;         // [LAST_IDX][1][1][1][1][1][1]
    const MID_IDX: i64 = 112;          // [MID_IDX][1][0][0][0][0][0]
    const MID_E: i64 = 7200;           // MID_IDX * 64 + 1 * 32

    const WRAP_OFFSET: i64 = 32768;    // make_grid(offset=32768) folds to 0..1

    // What build_tree hands back. The original returns (text, next_base);
    // the text half cannot be assembled here (see header), so the port
    // carries the base the original leaves behind plus the coordinates of
    // the first and last points the text would encode — the values the
    // generated test pins in its footer.
    pub struct TreeOut {
        next_base: i64,
        first_x: i64,
        first_y: i64,
        last_x: i64,
        last_y: i64,
    }

    // def indent(level: int) -> str: "    " * level. The string cannot be
    // built here (strings cannot be joined), so the port returns the number of
    // spaces: four per level, negative levels repeat zero, exactly as
    // string multiplication does.
    fn indent(level: i64) -> i64 {
        if (level < 0) {
            return 0;
        }
        return SPACES_PER_LEVEL * level;
    }

    // The leaf's entry rule, extracted so build_tree and the tests read one
    // copy of the fold: step 0 is x, step 1 is y.
    fn coordinate(e: i64, offset: i64, step: i64) -> i64 {
        return (2 * e + offset + step) % MOD;
    }

    // An index path flattens row-major: [MID_IDX][1][0][0][0][0][0] is
    // element MID_IDX * 64 + 1 * 32 in a 225x2^6 field.
    fn flat_index(shape: []const i64, path: []const i64) -> i64 {
        var e: i64 = 0;
        var stride: i64 = 1;
        var i: usize = shape.len;
        while (i > 0) {
            i = i - 1;
            e = e + path[i] * stride;
            stride = stride * shape[i];
        }
        return e;
    }

    // build_tree over a nested shape, mirroring the original's recursion:
    // a leaf (lines 35-46) emits its extent of entries starting at the
    // base, each with the folded (x, y), and advances the base by n; an
    // inner node (lines 48-58) walks its children and leaves the base its
    // last child leaves.
    fn build_tree_at(shape: []const i64, depth: usize, base: i64, offset: i64) -> TreeOut {
        const n: i64 = shape[depth];
        if (depth + 1 == shape.len) {
            const last_e: i64 = base + n - 1;
            return TreeOut {
                next_base: base + n,
                first_x: coordinate(base, offset, 0),
                first_y: coordinate(base, offset, 1),
                last_x: coordinate(last_e, offset, 0),
                last_y: coordinate(last_e, offset, 1),
            };
        }
        var out: TreeOut = TreeOut {
            next_base: base,
            first_x: 0,
            first_y: 0,
            last_x: 0,
            last_y: 0,
        };
        var i: i64 = 0;
        while (i < n) {
            const child: TreeOut = build_tree_at(shape, depth + 1, out.next_base, offset);
            if (i == 0) {
                out.first_x = child.first_x;
                out.first_y = child.first_y;
            }
            out.last_x = child.last_x;
            out.last_y = child.last_y;
            out.next_base = child.next_base;
            i = i + 1;
        }
        return out;
    }

    fn build_tree(shape: []const i64, base: i64, offset: i64) -> TreeOut {
        return build_tree_at(shape, 0, base, offset);
    }

    // The write refuses non-ASCII text; the text is not assembled here, so
    // the guard is ported on its own: every byte below 128.
    fn is_ascii(text: []const u8) -> bool {
        for c in text {
            if (c >= 128) {
                return false;
            }
        }
        return true;
    }

    // def generate() -> None: assembles the literal, re-indents the body
    // under `def make_grid():`, prints the line count, and writes DST. The
    // write is plumbing and the text cannot be assembled here (see header).
    // Kept under its original name with an undefined body; no test calls it.
    fn generate() {
        undefined;
    }

    test "indent repeats four spaces per level"
        assert(indent(0) == 0);
        assert(indent(1) == 4);
        assert(indent(2) == 8);
        assert(indent(3) == 12);

        // "    " * -1 repeats zero spaces.
        assert(indent(-3) == 0);

    test "coordinate folds element indices onto 0..32767"
        assert(coordinate(0, 0, 0) == 0);
        assert(coordinate(0, 0, 1) == 1);
        assert(coordinate(1, 0, 0) == 2);
        assert(coordinate(1, 0, 1) == 3);
        assert(coordinate(7200, 0, 0) == 14400);
        assert(coordinate(7200, 0, 1) == 14401);
        assert(coordinate(14399, 0, 0) == 28798);
        assert(coordinate(14399, 0, 1) == 28799);

    test "wrap offset folds back onto the same points"
        assert(coordinate(0, WRAP_OFFSET, 0) == 0);
        assert(coordinate(0, WRAP_OFFSET, 1) == 1);
        assert(coordinate(14399, WRAP_OFFSET, 0) == 28798);
        assert(coordinate(14399, WRAP_OFFSET, 1) == 28799);

        // The same fold through build_tree at offset 32768.
        var shape: [7]i64 = [_]i64{OUTER, 2, 2, 2, 2, 2, 2};
        const wrapped: TreeOut = build_tree(&shape, 0, WRAP_OFFSET);
        assert(wrapped.first_x == 0);
        assert(wrapped.last_x == 28798);
        assert(wrapped.last_y == 28799);

    test "flat_index flattens index paths row-major"
        var shape: [7]i64 = [_]i64{OUTER, 2, 2, 2, 2, 2, 2};
        var mid: [7]i64 = [_]i64{MID_IDX, 1, 0, 0, 0, 0, 0};
        var last: [7]i64 = [_]i64{LAST_IDX, 1, 1, 1, 1, 1, 1};
        assert(flat_index(&shape, &mid) == 7200);
        assert(flat_index(&shape, &last) == 14399);

    test "build_tree advances the base by the shape's extent"
        var shape: [7]i64 = [_]i64{OUTER, 2, 2, 2, 2, 2, 2};
        const out: TreeOut = build_tree(&shape, 0, 0);
        assert(out.next_base == 14400);
        assert(out.first_x == 0);
        assert(out.first_y == 1);
        assert(out.last_x == 28798);
        assert(out.last_y == 28799);

    test "build_tree leaves advance and inner nodes relay"
        // A leaf: the base advances by the extent, first and last coincide.
        var leaf_shape: [1]i64 = [_]i64{1};
        const leaf: TreeOut = build_tree(&leaf_shape, 40, 0);
        assert(leaf.next_base == 41);
        assert(leaf.first_x == 80);
        assert(leaf.first_y == 81);
        assert(leaf.last_x == 80);
        assert(leaf.last_y == 81);

        // An inner node: three children of extent two leave base + 6.
        var inner_shape: [2]i64 = [_]i64{3, 2};
        const inner: TreeOut = build_tree(&inner_shape, 100, 0);
        assert(inner.next_base == 106);
        assert(inner.first_x == 200);
        assert(inner.first_y == 201);
        assert(inner.last_x == 210);
        assert(inner.last_y == 211);

    test "the generated footer's expected points"
        // What the generated test pins for [MID_IDX][1][0][0][0][0][0] and
        // [LAST_IDX][1][1][1][1][1][1].
        var shape: [7]i64 = [_]i64{OUTER, 2, 2, 2, 2, 2, 2};
        var mid: [7]i64 = [_]i64{MID_IDX, 1, 0, 0, 0, 0, 0};
        var last: [7]i64 = [_]i64{LAST_IDX, 1, 1, 1, 1, 1, 1};
        const me: i64 = flat_index(&shape, &mid);
        assert(me == MID_E);
        assert(coordinate(me, 0, 0) == 14400);
        assert(coordinate(me, 0, 1) == 14401);
        const le: i64 = flat_index(&shape, &last);
        assert(le == 14399);
        assert(coordinate(le, 0, 0) == 28798);
        assert(coordinate(le, 0, 1) == 28799);

    test "is_ascii accepts ASCII text and refuses the rest"
        assert(is_ascii("specs/scratch/w703_bench_module.t27"));
        assert(is_ascii("dst[0] = make_point(0, 1);"));
        assert(is_ascii(""));
        var bytes: [3]u8 = [_]u8{200, 65, 66};
        assert(!is_ascii(&bytes));

}
