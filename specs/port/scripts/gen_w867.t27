// SPDX-License-Identifier: Apache-2.0
// Port of scripts/gen_w867.py (gHashTag/t27#11051).
// The original writes a self-contained t27 literal module as text. Text assembly
// cannot be generated here (`str + str` does not compile), so the decisions that
// shape the text are ported as pure integer functions: the dimensions, the element
// indexing, the x/y coordinates of every element, and the wrap check at offset
// 32768. Plumbing (`indent`, `build_tree`, `generate`) is declared under its own
// name with an `undefined` body; no test calls it. Every test asserts something the
// original computes.

module gen_w867_scripts_w867;

const OUTER : u32 = 553;
const DEPTH : u32 = 7;

// shape = [OUTER, 2, 2, 2, 2, 2, 2]; element count per dimension
fn outer() -> u32 {
    return OUTER;
}

fn depth() -> u32 {
    return DEPTH;
}

// total number of elements: OUTER * 2^6 = 553 * 64 = 35392
fn total() -> u32 {
    var n : u32 = OUTER;
    var i : u32 = 0;
    while (i < 6) {
        n = n * 2;
        i = i + 1;
    }
    return n;
}

// last index of the outer dimension
fn last_idx() -> u32 {
    return OUTER - 1;
}

// middle index of the outer dimension (553 // 2 = 276)
fn mid_idx() -> u32 {
    return OUTER / 2;
}

// element number of [MID_IDX][1][0][0][0][0][0]: MID_IDX*64 + 32 = 17696
fn mid_elem() -> u32 {
    return mid_idx() * 64 + 32;
}

// last element number: TOTAL - 1 = 35391
fn last_elem() -> u32 {
    return total() - 1;
}

// x = (2 * e + offset) % 32768
fn x_of(e: u32, offset: u32) -> u32 {
    return (2 * e + offset) % 32768;
}

// y = (2 * e + offset + 1) % 32768
fn y_of(e: u32, offset: u32) -> u32 {
    return (2 * e + offset + 1) % 32768;
}

// element index within one leaf block of shape [2,2,2,2,2,2]: position p of 64
fn leaf_index(p: u32) -> u32 {
    return p;
}

// Plumbing: indents a line by `level` levels of 4 spaces. Decision: spaces = 4*level.
fn indent_spaces(level: u32) -> u32 {
    return 4 * level;
}

// The first element's coordinates with offset 0: x=0, y=1
fn first_xy(offset: u32) -> u32 {
    return x_of(0, offset);
}

// Plumbing: builds one literal recursively. Not text here: the recursion count is
// `depth`, and each level multiplies the block count by the next dimension.
fn build_tree_levels(remaining: u32) -> u32 {
    if (remaining == 0) { return 1; }
    var n : u32 = 1;
    var i : u32 = 0;
    while (i < remaining) {
        n = n * 2;
        i = i + 1;
    }
    return n;
}

// Plumbing: generate() assembles the module text. Decision part: the module
// declares one struct Pt and one const expected of shape [553][2][2][2][2][2][2]Pt.
fn module_shape_elems() -> u32 {
    return total();
}

// Plumbing: make_grid(offset) returns expected with offset applied. The wrap test
// uses offset 32768, congruent to 0 modulo 32768.
fn wrap_offset_ok(offset: u32) -> bool {
    return offset % 32768 == 0;
}

// The original's WRAP_LAST_X / WRAP_LAST_Y equal LAST_X / LAST_Y because
// adding 32768 is a no-op modulo 32768.
fn wrap_matches_normal(e: u32) -> bool {
    return x_of(e, 32768) == x_of(e, 0) and y_of(e, 32768) == y_of(e, 0);
}

// Plumbing: indent(level) -> "    " * level
fn indent(level: u32) -> str {
    undefined;
}

// Plumbing: build_tree(shape, base, offset) -> (text, next_base)
fn build_tree(shape: str, base: u32, offset: u32) -> str {
    undefined;
}

// Plumbing: generate() -> void, writes the spec file
fn generate() -> void {
    undefined;
}

// Plumbing: main entry; unused in spec form
fn main() -> void {
    undefined;
}

test indent_spaces_are_four_per_level {
    assert(indent_spaces(0) == 0);
    assert(indent_spaces(1) == 4);
    assert(indent_spaces(3) == 12);
}

test total_elements_is_outer_times_sixtyfour {
    assert(total() == 35392);
}

test last_and_middle_indexes {
    assert(last_idx() == 552);
    assert(mid_idx() == 276);
}

test mid_element_is_276_times_64_plus_32 {
    assert(mid_elem() == 17696);
}

test last_element_is_total_minus_one {
    assert(last_elem() == 35391);
}

test x_and_y_of_first_element_at_offset_zero {
    assert(x_of(0, 0) == 0);
    assert(y_of(0, 0) == 1);
}

test x_and_y_of_last_element {
    assert(x_of(last_elem(), 0) == 5246);
    assert(y_of(last_elem(), 0) == 5247);
}

test x_and_y_of_middle_element {
    assert(x_of(mid_elem(), 0) == 2624);
    assert(y_of(mid_elem(), 0) == 2625);
}

test offset_32768_wraps_to_same_coordinates {
    assert(wrap_offset_ok(32768));
    assert(wrap_matches_normal(last_elem()));
    assert(wrap_matches_normal(mid_elem()));
    assert(wrap_matches_normal(0));
}

test build_tree_levels_counts_full_binary_shape {
    assert(build_tree_levels(0) == 1);
    assert(build_tree_levels(6) == 64);
}

test module_shape_elems_matches_total {
    assert(module_shape_elems() == total());
}
