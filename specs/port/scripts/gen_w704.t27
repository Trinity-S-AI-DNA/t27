module gen_w704;

pub fn indent(level: i32) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    var result: [64]u8 = undefined;
    var i: usize = 0;
    while (i < level * 4) : (i += 1) {
        result[i] = ' ';
    }
    return buffer[0..level * 4];
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> ([]const u8, i32) {
    if (shape.len == 1) {
        const n = shape[0];
        var buffer: [1024]u8 = undefined;
        var index: usize = 0;
        
        // Add opening line: [3]Pt{
        buffer[index] = '[';
        index += 1;
        buffer[index] = '3';
        index += 1;
        buffer[index] = ']';
        index += 1;
        buffer[index] = 'P';
        index += 1;
        buffer[index] = 't';
        index += 1;
        buffer[index] = '{';
        index += 1;
        
        // Add entries
        var i: i32 = 0;
        while (i < n) : (i += 1) {
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            // Add indent(2)
            const indent2 = indent(2);
            for (indent2) |c| {
                buffer[index] = c;
                index += 1;
            }
            
            // Add Pt{ .x = x, .y = y }
            buffer[index] = 'P';
            index += 1;
            buffer[index] = 't';
            index += 1;
            buffer[index] = '{';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '.';
            index += 1;
            buffer[index] = 'x';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '=';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '0';
            index += 1;
            buffer[index] = ',';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '.';
            index += 1;
            buffer[index] = 'y';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '=';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '1';
            index += 1;
            buffer[index] = ' ';
            index += 1;
            buffer[index] = '}';
            index += 1;
            
            if (i < n - 1) {
                buffer[index] = ',';
                index += 1;
            }
            
            buffer[index] = '\n';
            index += 1;
        }
        
        // Add closing brace with indent(1)
        const indent1 = indent(1);
        for (indent1) |c| {
            buffer[index] = c;
            index += 1;
        }
        buffer[index] = '}';
        index += 1;
        buffer[index] = '\n';
        index += 1;
        
        return buffer[0..index], base + n;
    }
    
    const n = shape[0];
    const inner_shape = shape[1..];
    var buffer: [4096]u8 = undefined;
    var index: usize = 0;
    
    // Build dimension string manually
    buffer[index] = '[';
    index += 1;
    buffer[index] = '2';
    index += 1;
    buffer[index] = ']';
    index += 1;
    buffer[index] = '[';
    index += 1;
    buffer[index] = '2';
    index += 1;
    buffer[index] = ']';
    index += 1;
    
    // Add opening line: dims Pt{
    const indent1 = indent(1);
    for (indent1) |c| {
        buffer[index] = c;
        index += 1;
    }
    buffer[index] = 'P';
    index += 1;
    buffer[index] = 't';
    index += 1;
    buffer[index] = '{';
    index += 1;
    buffer[index] = '\n';
    index += 1;
    
    // Add nested entries
    var j: i32 = 0;
    while (j < n) : (j += 1) {
        const entry_text, new_base = build_tree(inner_shape, base, offset);
        for (entry_text) |c| {
            buffer[index] = c;
            index += 1;
        }
        
        if (j < n - 1) {
            buffer[index] = ',';
            index += 1;
        }
        
        buffer[index] = '\n';
        index += 1;
        base = new_base;
    }
    
    // Add closing brace with indent(1)
    for (indent1) |c| {
        buffer[index] = c;
        index += 1;
    }
    buffer[index] = '}';
    index += 1;
    buffer[index] = '\n';
    index += 1;
    
    return buffer[0..index], base;
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_simple {
    const shape = [_]i32{3};
    const result, next_base = build_tree(&shape, 0, 0);
    assert(next_base == 3);
    // Check that we got some output and it's not empty
    assert(result.len > 0);
    // Check that it contains the expected structure
    var found_opening = false;
    var found_closing = false;
    for (result) |c| {
        if (c == '[') {
            found_opening = true;
        }
        if (c == '}') {
            found_closing = true;
        }
    }
    assert(found_opening);
    assert(found_closing);
}

test build_tree_nested {
    const shape = [_]i32{2, 2};
    const result, next_base = build_tree(&shape, 10, 0);
    assert(next_base == 4);
    // Check that we got some output and it's not empty
    assert(result.len > 0);
    // Check that it contains nested structure
    var found_brackets = 0;
    for (result) |c| {
        if (c == '[') {
            found_brackets += 1;
        }
    }
    assert(found_brackets >= 2); // At least two opening brackets for 2D array
}