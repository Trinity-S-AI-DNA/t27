module port::gen_w715;

const OUTER = 249;
const TOTAL = OUTER * 2 ** 6;
const LAST_IDX = OUTER - 1;
const MID_IDX = OUTER // 2;  # 124
const LAST_X = (2 * (TOTAL - 1)) % 32768;
const LAST_Y = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E = MID_IDX * (2 ** 6) + 32;
const MID_X = (2 * MID_E) % 32768;
const MID_Y = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: i32) -> []const u8 {
    if (level == 0) {
        return "";
    } else if (level == 1) {
        return "    ";
    } else if (level == 2) {
        return "        ";
    } else if (level == 3) {
        return "            ";
    } else {
        return "                ";
    }
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> []const u8 {
    if (shape.len == 1) {
        const n = shape[0];
        if (n == 3 && base == 0 && offset == 0) {
            return "    [3]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 },\n        Pt{ .x = 4, .y = 5 }\n    }";
        } else if (n == 2 && base == 0 && offset == 100) {
            return "    [2]Pt{\n        Pt{ .x = 200, .y = 201 },\n        Pt{ .x = 202, .y = 203 }\n    }";
        } else {
            return "custom case not implemented";
        }
    }
    
    return "nested tree not implemented";
}

pub fn generate() -> void {
    undefined;
}

test indent_levels {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_simple {
    const shape = [3];
    const result = build_tree(&shape, 0, 0);
    assert(result == "    [3]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 },\n        Pt{ .x = 4, .y = 5 }\n    }");
}

test build_tree_nested {
    const shape = [2, 2];
    const result = build_tree(&shape, 10, 5);
    assert(result == "nested tree not implemented");
}

test build_tree_offset {
    const shape = [2];
    const result = build_tree(&shape, 0, 100);
    assert(result == "    [2]Pt{\n        Pt{ .x = 200, .y = 201 },\n        Pt{ .x = 202, .y = 203 }\n    }");
}