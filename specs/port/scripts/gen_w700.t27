// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w700.t27
// Port of scripts/gen_w700.py to t27

// Generates specs/scratch/w700_bench_module_219x2p6_aos_var_call_write.t27:
// a [219][2][2][2][2][2][2]Pt literal whose element p carries the pair
// ((2p + offset) % 32768, (2p + offset + 1) % 32768), wrapped in a
// make_grid(offset : u16) function, plus the var, test and bench that write
// into and read back a few of its fields.
//
// WHAT THIS PORT DELIBERATELY DOES NOT CONTAIN
//
// The text. The original assembles the literal line by line - "    " *
// level, f-strings, ",\n".join, split and splitlines - then prepends the
// module header, wraps the literal in make_grid, appends the footer with the
// expected indices, checks the text is ASCII and writes it to the scratch
// spec. .t27 has no string building and no file I/O, so every one of those
// steps moves bytes and stays in Python. What decided is here, and every
// test asserts one of these decisions:
//
// - indent: the indent unit is four spaces per level (the original returns
//   the space string; here its space count)
// - elem_x / elem_y: the leaf case's coordinate formulas, including the fold
//   at 2**15 and the offset-32768 wrap the emitted test asserts explicitly
// - elem_pt: the Pt payload each emitted element stores
// - flat_inner: the inner-dimension flattening behind the MID and LAST
//   benchmark indices
// - build_tree: the recursion that numbers every element consecutively from
//   base and returns the base after the last element
// - the module constants, lines 9-21 of the original
// - is_ascii: the all(ord(ch) < 128) guard run before the write

module port::scripts::gen_w700;

// Module constants, lines 9-21 of the original.
pub const MODULUS: i64 = 32768; // coordinates fold at 2**15
pub const OUTER: i64 = 219;
pub const TOTAL: i64 = OUTER * 2 * 2 * 2 * 2 * 2 * 2; // OUTER * 2**6 = 14016
pub const LAST_IDX: i64 = OUTER - 1; // 218
pub const MID_IDX: i64 = OUTER / 2; // 109

// The shape generate() passes to build_tree (line 62):
pub const SHAPE: [7]i64 = [OUTER, 2, 2, 2, 2, 2, 2];

// Flattening the six width-2 inner dimensions: index
// [a][b1][b2][b3][b4][b5][b6] is element a*64 + b1*32 + b2*16 + b3*8 +
// b4*4 + b5*2 + b6 (the original's comment, lines 15-16).
pub fn flat_inner(a: i64, b1: i64, b2: i64, b3: i64, b4: i64, b5: i64, b6: i64) -> i64 {
    return a * 64 + b1 * 32 + b2 * 16 + b3 * 8 + b4 * 4 + b5 * 2 + b6;
}

// [MID_IDX][1][0][0][0][0][0] is element MID_IDX*64 + 32 (lines 15-17):
pub const MID_E: i64 = MID_IDX * 64 + 32;
// [LAST_IDX][1][1][1][1][1][1] is the last element:
pub const LAST_E: i64 = TOTAL - 1;

// The coordinates the emitted test and bench assert on (lines 13-21):
pub const MID_X: i64 = (2 * MID_E) % MODULUS;
pub const MID_Y: i64 = (2 * MID_E + 1) % MODULUS;
pub const LAST_X: i64 = (2 * LAST_E) % MODULUS;
pub const LAST_Y: i64 = (2 * LAST_E + 1) % MODULUS;
pub const WRAP_LAST_X: i64 = (2 * LAST_E + MODULUS) % MODULUS;
pub const WRAP_LAST_Y: i64 = (2 * LAST_E + 1 + MODULUS) % MODULUS;

// Python: def indent(level: int) -> str: return "    " * level. The unit is
// four spaces per level; .t27 cannot multiply or join strings, so the
// decision is the space count and the string stays in Python. Level <= 0
// yields the empty string in Python; the count mirrors that as 0.
pub fn indent(level: i64) -> i64 {
    if (level <= 0) {
        return 0;
    }
    return 4 * level;
}

// The leaf case of build_tree (lines 39-43): element i of a leaf starting at
// base is number e = base + i, and its emitted entry is
// "Pt{ .x = X, .y = Y }" for the pair below. Both operands are non-negative,
// so the truncating % here agrees with Python's floor %.
pub fn elem_x(e: i64, offset: i64) -> i64 {
    return (2 * e + offset) % MODULUS;
}

pub fn elem_y(e: i64, offset: i64) -> i64 {
    return (2 * e + offset + 1) % MODULUS;
}

// The payload the emitted literal stores per element - the header's
// pub struct Pt { x : i16, y : i16 } (line 77).
pub struct Pt { x: i16, y: i16, }

pub fn elem_pt(e: i64, offset: i64) -> Pt {
    return Pt { x: elem_x(e, offset) as i16, y: elem_y(e, offset) as i16 };
}

// build_tree(shape, base, offset) returns (text, next_base): it walks the
// dimensions of shape, numbering every element consecutively from base, and
// returns the base after the last element (lines 35-58). The text half is
// byte-moving and stays in Python; this carries the numeric half. Python
// recurses on shape[1:]; .t27 has no slice of a slice, so the walk carries a
// start index instead. _offset only ever fed the text half, via elem_x and
// elem_y above - it keeps its place in the signature and is unread here,
// which is why it is underscore-prefixed.
pub fn build_tree(shape: []const i64, base: i64, _offset: i64) -> i64 {
    return build_tree_at(shape, 0, base);
}

fn build_tree_at(shape: []const i64, start: usize, base: i64) -> i64 {
    if (shape.len - start == 1) {
        // Leaf: base advances by the element count (line 46).
        return base + shape[start];
    }
    var b: i64 = base;
    var i: i64 = 0;
    while (i < shape[start]) {
        b = build_tree_at(shape, start + 1, b);
        i += 1;
    }
    return b;
}

// generate()'s ASCII guard (lines 135-136): the text may not be written
// while any character is outside 0..127.
pub fn is_ascii(text: []const u8) -> bool {
    for c in text {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Python: generate() splits the literal into lines, indents each one, wraps
// it in make_grid, adds the header and footer, checks the text is ASCII and
// writes it to specs/scratch/w700_bench_module_219x2p6_aos_var_call_write.t27,
// then prints one summary line. Every one of those steps moves bytes, so the
// body stays undefined and no test calls it; the decisions it would carry are
// the functions above.
pub fn generate() -> void {
    undefined;
}

// ==================================================================
// Tests
// ==================================================================

test indent_steps_by_four {
    // "    " * level: 0, 1, 2 and 6 levels (line 25).
    assert(indent(0) == 0);
    assert(indent(1) == 4);
    assert(indent(2) == 8);
    assert(indent(6) == 24);
}

test build_tree_numbers_elements_consecutively {
    // Leaf of 4 elements from base 10 ends at base 14 (lines 35-46):
    var leaf: [1]i64 = [4];
    assert(build_tree(&leaf, 10, 0) == 14);
    // Inner levels recurse over every slot (lines 48-58): shape [2, 3]
    // numbers 6 elements, so the base advances by 6:
    var pair: [2]i64 = [2, 3];
    assert(build_tree(&pair, 10, 0) == 16);
    // The leaf case seen through a one-dimensional suffix view of [2, 3]:
    assert(build_tree_at(&pair, 1, 10) == 13);
    // The full shape numbers TOTAL elements consecutively from 0 - the
    // invariant the emitted test's element indices stand on:
    assert(build_tree(&SHAPE, 0, 0) == TOTAL);
    assert(build_tree(&SHAPE, 5, 0) == TOTAL + 5);
}

test elem_coordinates_match_the_original {
    // Element 0 carries (0, 1); element e carries (2e, 2e + 1) (lines 40-42):
    assert(elem_x(0, 0) == 0);
    assert(elem_y(0, 0) == 1);
    assert(elem_x(1, 0) == 2);
    assert(elem_y(1, 0) == 3);
    // The emitted test asserts dst[0][0][0][0][0][0][0] == (0, 1) and
    // dst[218][1][1][1][1][1][1] == (28030, 28031) (lines 86-89):
    const first = elem_pt(0, 0);
    assert(first.x == 0);
    assert(first.y == 1);
    const last = elem_pt(LAST_E, 0);
    assert(last.x == 28030);
    assert(last.y == 28031);
}

test elem_offset_wraps_at_32768 {
    // The emitted test's explicit modulo-wrap check (lines 92-96): offset
    // 32768 folds back to 0..1, and the wrap constants equal the unwrapped
    // ones because 2 * (TOTAL - 1) is already below the modulus:
    assert(elem_x(0, 32768) == 0);
    assert(elem_y(0, 32768) == 1);
    assert(elem_x(LAST_E, 32768) == WRAP_LAST_X);
    assert(elem_y(LAST_E, 32768) == WRAP_LAST_Y);
    assert(WRAP_LAST_X == LAST_X);
    assert(WRAP_LAST_Y == LAST_Y);
}

test benchmark_indices_and_coordinates {
    assert(flat_inner(0, 0, 0, 0, 0, 0, 0) == 0);
    // [109][1][0][0][0][0][0] is element 7008, whose pair is the (14016,
    // 14017) the emitted test asserts (lines 90-91):
    assert(flat_inner(MID_IDX, 1, 0, 0, 0, 0, 0) == MID_E);
    const mid = elem_pt(flat_inner(MID_IDX, 1, 0, 0, 0, 0, 0), 0);
    assert(mid.x == MID_X);
    assert(mid.x == 14016);
    assert(mid.y == MID_Y);
    assert(mid.y == 14017);
    // [218][1][1][1][1][1][1] is element 14015, whose pair is (28030, 28031):
    assert(flat_inner(LAST_IDX, 1, 1, 1, 1, 1, 1) == LAST_E);
    const last = elem_pt(flat_inner(LAST_IDX, 1, 1, 1, 1, 1, 1), 0);
    assert(last.x == LAST_X);
    assert(last.x == 28030);
    assert(last.y == LAST_Y);
    assert(last.y == 28031);
    assert(MID_IDX == 109);
    assert(LAST_IDX == 218);
    assert(TOTAL == 14016);
    assert(MID_E == 7008);
    assert(LAST_E == 14015);
}

test ascii_guard {
    // The header generate() writes (line 77) is pure ASCII:
    assert(is_ascii("module w700_bench_module_219x2p6_aos_var_call_write\n\n\npub struct Pt { x : i16, y : i16 }\n\n"));
    // The empty text is all-ASCII, as Python's all() over nothing:
    assert(is_ascii(""));
    // A byte at 128 or above refuses the write (line 136):
    var non_ascii: [3]u8 = [80, 116, 200];
    assert(!is_ascii(&non_ascii));
}
