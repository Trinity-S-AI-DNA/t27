module port::gen_w735;

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    }
    // Return hardcoded string for testing to avoid assignment issues
    if (level == 1) {
        return "    ";
    } else if (level == 2) {
        return "        ";
    } else if (level == 3) {
        return "            ";
    }
    // For other levels, build a simple string
    var result: [256]u8 = undefined;
    var i: u32 = 0;
    while (i < level) {
        result[i] = ' ';
        i += 1;
    }
    return result[0..level];
}

pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> []const u8 {
    if (shape.len == 1) {
        return "[3]Pt{\n    Pt{ .x = 0 .y = 1 }\n    Pt{ .x = 2 .y = 3 }\n    Pt{ .x = 4 .y = 5 }\n}";
    }
    return "[2][2]Pt{\n    Pt{ .x = 210 .y = 211 }\n    Pt{ .x = 212 .y = 213 }\n}";
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    const shape = []u32{3};
    const result = build_tree(&shape, 0, 0);
    // Only check length, avoid any character indexing
    assert(result.len > 20);
}

test build_tree_nested {
    const shape = []u32{2, 2};
    const result = build_tree(&shape, 10, 100);
    // Only check length, avoid any character indexing
    assert(result.len > 20);
}