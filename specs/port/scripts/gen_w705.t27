module gen_w705;

const OUTER = 229;
const TOTAL = OUTER * 2 ** 6;
const LAST_IDX = OUTER - 1;
const MID_IDX = OUTER // 2;
const LAST_X = (2 * (TOTAL - 1)) % 32768;
const LAST_Y = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E = MID_IDX * (2 ** 6) + 32;
const MID_X = (2 * MID_E) % 32768;
const MID_Y = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: i32) -> []const u8 {
    return "    " * level;
}

pub fn build_tree(shape: [7]i32, base: i32, offset: i32) -> ([]const u8, i32) {
    if (shape[0] == 1) {
        const n = shape[0];
        var result = indent(1) ++ "[{n}]Pt{{";
        
        var i: i32 = 0;
        while (i < n) : (i += 1) {
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            const entry = indent(2) ++ "Pt{{ .x = {x}, .y = {y} }}";
            if (i == 0) {
                result = result ++ entry;
            } else {
                result = result ++ ",\n" ++ entry;
            }
        }
        
        result = result ++ "\n" ++ indent(1) ++ "}}";
        return (result, base + n);
    }

    const n = shape[0];
    var result = indent(1) ++ "[229][2][2][2][2][2][2]Pt{{";
    
    var j: i32 = 0;
    while (j < n) : (j += 1) {
        var inner_shape: [6]i32 = undefined;
        var k: usize = 0;
        while (k < 6) : (k += 1) {
            inner_shape[k] = shape[k + 1];
        }
        const (entry_text, base) = build_tree(inner_shape, base, offset);
        if (j == 0) {
            result = result ++ entry_text;
        } else {
            result = result ++ ",\n" ++ entry_text;
        }
    }
    
    result = result ++ "\n" ++ indent(1) ++ "}}";
    return (result, base);
}

pub fn generate() {
    var shape: [7]i32 = undefined;
    shape[0] = OUTER;
    shape[1] = 2;
    shape[2] = 2;
    shape[3] = 2;
    shape[4] = 2;
    shape[5] = 2;
    shape[6] = 2;
    
    const (literal, _) = build_tree(shape, 0, 0);
    
    var first: []const u8 = "";
    var rest: []const u8 = "";
    if (literal.len > 0) {
        first = literal[0..1];
        if (literal.len > 1) {
            rest = literal[1..];
        }
    }
    
    var indented_lines = "    " ++ first;
    if (rest.len > 0) {
        indented_lines = indented_lines ++ "\n    " ++ rest;
    }
    
    var dims = "[229][2][2][2][2][2][2]";
    
    const make_grid = 
        "pub fn make_grid(offset : u16) -> " ++ dims ++ "Pt {\n" ++
        "    return " ++ indented_lines ++ ";\n" ++
        "}\n";
    
    const header = "module w705_bench_module_229x2p6_aos_var_call_write\n\n\npub struct Pt {{ x : i16, y : i16 }}\n\n";
    
    const footer = 
        "pub const expected : " ++ dims ++ "Pt = make_grid(0);\n" ++
        "pub var dst : " ++ dims ++ "Pt = make_grid(0);\n" ++
        "test module_var_229x2p6_call_write {\n" ++
        "    assert_eq(dst, expected);\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].x, 0);\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].y, 1);\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].x, {LAST_X});\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].y, {LAST_Y});\n" ++
        "    assert_eq(dst[{MID_IDX}][1][0][0][0][0][0].x, {MID_X});\n" ++
        "    assert_eq(dst[{MID_IDX}][1][0][0][0][0][0].y, {MID_Y});\n" ++
        "    // Explicit modulo-wrap check: offset 32768 folds back to 0..1\n" ++
        "    assert_eq(make_grid(32768)[0][0][0][0][0][0][0].x, 0);\n" ++
        "    assert_eq(make_grid(32768)[0][0][0][0][0][0][0].y, 1);\n" ++
        "    assert_eq(make_grid(32768)[{LAST_IDX}][1][1][1][1][1][1].x, {WRAP_LAST_X});\n" ++
        "    assert_eq(make_grid(32768)[{LAST_IDX}][1][1][1][1][1][1].y, {WRAP_LAST_Y});\n" ++
        "}\n" ++
        "bench module_bench_229x2p6_call_write {\n" ++
        "    // Site 1: whole-array equality before writes\n" ++
        "    assert_eq(dst, expected);\n" ++
        "    // Site 2: indexed read before writes\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].x, 0);\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].y, 1);\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].x, {LAST_X});\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].y, {LAST_Y});\n" ++
        "    // Site 3: indexed signed field writes\n" ++
        "    dst[0][0][0][0][0][0][0].x = 1234;\n" ++
        "    dst[0][0][0][0][0][0][0].y = -1234;\n" ++
        "    dst[{LAST_IDX}][1][1][1][1][1][1].x = -5678;\n" ++
        "    dst[{LAST_IDX}][1][1][1][1][1][1].y = 5678;\n" ++
        "    // Site 4: read back updated fields\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].x, 1234);\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].y, -1234);\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].x, -5678);\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].y, 5678);\n" ++
        "    // Site 5: frame-condition checks on untouched elements\n" ++
        "    assert_eq(dst[{MID_IDX}][1][0][0][0][0][0].x, {MID_X});\n" ++
        "    assert_eq(dst[{MID_IDX}][1][0][0][0][0][0].y, {MID_Y});\n" ++
        "    // Site 6: whole-array inequality after partial writes\n" ++
        "    // assert_ne is not emitted by the Icarus simulation path, so we verify that\n" ++
        "    // the changed elements differ from their original expected values.\n" ++
        "    assert_eq(dst[0][0][0][0][0][0][0].x, 1234);\n" ++
        "    assert_eq(dst[{LAST_IDX}][1][1][1][1][1][1].x, -5678);\n" ++
        "}\n";
    
    const text = header ++ make_grid ++ footer;
    
    // Check for non-ASCII characters
    var has_non_ascii = false;
    var ch_idx: usize = 0;
    while (ch_idx < text.len) : (ch_idx += 1) {
        if (text[ch_idx] >= 128) {
            has_non_ascii = true;
            break;
        }
    }
    
    if (has_non_ascii) {
        return;
    }
    
    // File I/O operations - undefined per requirements
    undefined;
}

// Test cases for the ported functions

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_single_dimension {
    var shape: [7]i32 = undefined;
    shape[0] = 3;
    shape[1] = 0;
    shape[2] = 0;
    shape[3] = 0;
    shape[4] = 0;
    shape[5] = 0;
    shape[6] = 0;
    var result: []const u8 = "";
    var next_base: i32 = 0;
    (result, next_base) = build_tree(shape, 10, 0);
    
    // Basic checks that don't require string searching
    assert(next_base == 13);  // base + n = 10 + 3
    assert(result.len > 0);
    assert(result[0] == '[');  // Should start with opening bracket
}

test build_tree_nested_dimensions {
    var shape: [7]i32 = undefined;
    shape[0] = 2;
    shape[1] = 2;
    shape[2] = 0;
    shape[3] = 0;
    shape[4] = 0;
    shape[5] = 0;
    shape[6] = 0;
    var result: []const u8 = "";
    var next_base: i32 = 0;
    (result, next_base) = build_tree(shape, 0, 0);
    
    // Basic checks
    assert(next_base == 4);  // 2 * 2 = 4 elements total
    assert(result.len > 0);
    assert(result[0] == '[');  // Should start with opening bracket
}

test constants_calculation {
    // Verify that the constant calculations match the Python version
    assert(OUTER == 229);
    assert(TOTAL == OUTER * 2 ** 6);
    assert(LAST_IDX == OUTER - 1);
    assert(MID_IDX == 114);  // OUTER // 2 = 114
    assert(true);
}