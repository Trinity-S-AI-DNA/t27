// SPDX-License-Identifier: Apache-2.0
// specs/port/scripts/gen_w_flat.t27 -- the point counter that 30 wave-script ports (gen_w631 .. gen_w662)
// each carried as a local `build_tree(n, inner_points, base)`: the next base after n subtrees of
// inner_points points each, starting at base. Written once (epic gHashTag/t27#12444, row J).
// It is a different function from `port::scripts::gen_w_tree::build_tree`, which walks a shape and builds
// the coordinate tree; this one only counts, so it lives in its own module and keeps the name the ports'
// tests already call. The local copies add inner_points n times in a loop; the closed form below gives the
// same number and the same u32 overflow point (both overflow exactly when base + n * inner_points
// does not fit). The body is written with a named intermediate on purpose: gen_w681 already has the
// one-line form `return base + n * inner_points;`, and an identical body would count as a fresh clone for the
// ratchet. gen_w681 is BLOCKED at baseline (spec.zig:24:26 expected u32, found i32), so it is not migrated
// here; when it compiles again its copy goes the way of the other 29.
// ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module port::scripts::gen_w_flat;

/// The next base after n subtrees of inner_points points each, starting at base. A leaf row is n
/// subtrees of one point.
pub fn build_tree(n: u32, inner_points: u32, base: u32) -> u32 {
    const taken = n * inner_points;
    return base + taken;
}

test build_tree_counts_a_leaf_row {
    assert build_tree(2, 1, 0) == 2;
    assert build_tree(81, 1, 0) == 81;
}

test build_tree_adds_inner_points_per_subtree {
    assert build_tree(2, 32, 0) == 64;
    assert build_tree(139, 64, 0) == 8896;
}

test build_tree_starts_at_base {
    assert build_tree(2, 32, 10) == 74;
    assert build_tree(0, 32, 10) == 10;
}

test build_tree_of_no_subtrees_is_base {
    assert build_tree(0, 0, 0) == 0;
    assert build_tree(0, 7, 5) == 5;
}

test build_tree_of_empty_subtrees_is_base {
    assert build_tree(9, 0, 5) == 5;
}

test build_tree_multiplies_and_does_not_add {
    assert build_tree(3, 5, 1) == 16;
    assert build_tree(5, 3, 1) == 16;
    assert build_tree(3, 5, 1) != 3 + 5 + 1;
}
