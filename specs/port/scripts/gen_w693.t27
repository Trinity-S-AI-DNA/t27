module port::gen_w693;

pub struct BuildTreeResult {
    text: []const u8,
    next_base: u32,
}

pub fn indent(level: i32) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    var result: [256]u8 = undefined;
    var pos: usize = 0;
    var counter: i32 = 0;
    while (counter < level) {
        if (pos + 4 > result.len) {
            break;
        }
        var space_counter: usize = 0;
        while (space_counter < 4) {
            result[pos + space_counter] = ' ';
            space_counter += 1;
        }
        pos += 4;
        counter += 1;
    }
    return result[0..pos];
}

pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> BuildTreeResult {
    if (shape.len == 1) {
        const n = shape[0];
        const indent1 = indent(1);
        const indent2 = indent(2);
        
        // Build dimension annotation manually
        var dim_str: [32]u8 = undefined;
        var pos: usize = 0;
        dim_str[pos] = '[';
        pos += 1;
        
        // Convert number to string manually
        var temp: [32]u8 = undefined;
        var temp_pos: usize = 0;
        var num = n;
        if (num == 0) {
            temp[temp_pos] = '0';
            temp_pos += 1;
        } else {
            var digit_count: usize = 0;
            var num1 = num;
            while (num1 > 0) {
                const digit_char = '0' + @as(u8, @truncate(num1 % 10));
                temp[digit_count] = digit_char;
                num1 /= 10;
                digit_count += 1;
            }
            // Reverse the digits
            var digit_counter: usize = 0;
            while (digit_counter < digit_count / 2) {
                const swap_pos = digit_count - 1 - digit_counter;
                const temp_char = temp[digit_counter];
                temp[digit_counter] = temp[swap_pos];
                temp[swap_pos] = temp_char;
                digit_counter += 1;
            }
            temp_pos = digit_count;
        }
        std.mem.copyForwards(u8, dim_str[pos..dim_str.len], temp[0..temp_pos]);
        pos += temp_pos;
        dim_str[pos] = ']';
        pos += 1;
        
        // Build the result
        var result: [2048]u8 = undefined;
        var result_pos: usize = 0;
        
        // Add opening line
        result[result_pos] = '\n';
        result_pos += 1;
        std.mem.copyForwards(u8, result[result_pos..], dim_str[0..pos]);
        result_pos += pos;
        result[result_pos] = '{';
        result_pos += 1;
        result[result_pos] = '\n';
        result_pos += 1;
        
        // Add entries
        var entry_counter: u32 = 0;
        while (entry_counter < n) {
            const e = base + entry_counter;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            if (entry_counter > 0) {
                result[result_pos] = ',';
                result_pos += 1;
                result[result_pos] = '\n';
                result_pos += 1;
            }
            
            // Add indent
            std.mem.copyForwards(u8, result[result_pos..], indent2);
            result_pos += indent2.len;
            
            // Add Pt struct
            result[result_pos] = 'P';
            result_pos += 1;
            result[result_pos] = 't';
            result_pos += 1;
            result[result_pos] = '{';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            
            // Add x field
            result[result_pos] = '.';
            result_pos += 1;
            result[result_pos] = 'x';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            result[result_pos] = '=';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            
            // Add x value
            var x_str: [16]u8 = undefined;
            var x_pos: usize = 0;
            var x_val = x;
            if (x_val == 0) {
                x_str[x_pos] = '0';
                x_pos += 1;
            } else {
                while (x_val > 0) {
                    x_str[x_pos] = '0' + @as(u8, @truncate(x_val % 10));
                    x_val /= 10;
                    x_pos += 1;
                }
                // Reverse
                var i: usize = 0;
                while (i < x_pos / 2) {
                    const j = x_pos - 1 - i;
                    const c = x_str[i];
                    x_str[i] = x_str[j];
                    x_str[j] = c;
                    i += 1;
                }
            }
            std.mem.copyForwards(u8, result[result_pos..], x_str[0..x_pos]);
            result_pos += x_pos;
            
            result[result_pos] = ',';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            
            // Add y field
            result[result_pos] = '.';
            result_pos += 1;
            result[result_pos] = 'y';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            result[result_pos] = '=';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            
            // Add y value
            var y_str: [16]u8 = undefined;
            var y_pos: usize = 0;
            var y_val = y;
            if (y_val == 0) {
                y_str[y_pos] = '0';
                y_pos += 1;
            } else {
                while (y_val > 0) {
                    y_str[y_pos] = '0' + @as(u8, @truncate(y_val % 10));
                    y_val /= 10;
                    y_pos += 1;
                }
                // Reverse
                var i: usize = 0;
                while (i < y_pos / 2) {
                    const j = y_pos - 1 - i;
                    const c = y_str[i];
                    y_str[i] = y_str[j];
                    y_str[j] = c;
                    i += 1;
                }
            }
            std.mem.copyForwards(u8, result[result_pos..], y_str[0..y_pos]);
            result_pos += y_pos;
            
            result[result_pos] = '}';
            result_pos += 1;
            result[result_pos] = ' ';
            result_pos += 1;
            result[result_pos] = '}';
            result_pos += 1;
            
            entry_counter += 1;
        }
        
        // Add closing line
        result[result_pos] = '\n';
        result_pos += 1;
        std.mem.copyForwards(u8, result[result_pos..], indent1);
        result_pos += indent1.len;
        result[result_pos] = '}';
        result_pos += 1;
        result[result_pos] = '\n';
        result_pos += 1;
        
        return BuildTreeResult {
            .text = result[0..result_pos],
            .next_base = base + n,
        };
    }
    
    // Handle multi-dimensional case - simplified
    const n = shape[0];
    const inner_shape = shape[1..];
    
    // Build dimension string manually
    var dim_str: [128]u8 = undefined;
    var dim_pos: usize = 0;
    dim_str[dim_pos] = '[';
    dim_pos += 1;
    
    var dim_counter: usize = 0;
    while (dim_counter < shape.len) {
        if (dim_counter > 0) {
            dim_str[dim_pos] = ']';
            dim_pos += 1;
            dim_str[dim_pos] = '[';
            dim_pos += 1;
        }
        
        // Convert number to string manually
        var temp: [32]u8 = undefined;
        var temp_pos: usize = 0;
        var num = shape[dim_counter];
        if (num == 0) {
            temp[temp_pos] = '0';
            temp_pos += 1;
        } else {
            var digit_count: usize = 0;
            var num1 = num;
            while (num1 > 0) {
                const digit_char = '0' + @as(u8, @truncate(num1 % 10));
                temp[digit_count] = digit_char;
                num1 /= 10;
                digit_count += 1;
            }
            // Reverse the digits
            var digit_counter: usize = 0;
            while (digit_counter < digit_count / 2) {
                const swap_pos = digit_count - 1 - digit_counter;
                const temp_char = temp[digit_counter];
                temp[digit_counter] = temp[swap_pos];
                temp[swap_pos] = temp_char;
                digit_counter += 1;
            }
            temp_pos = digit_count;
        }
        std.mem.copyForwards(u8, dim_str[dim_pos..dim_str.len], temp[0..temp_pos]);
        dim_pos += temp_pos;
        dim_counter += 1;
    }
    
    dim_str[dim_pos] = ']';
    dim_pos += 1;
    
    // Generate recursive tree structure - simplified
    var result: [4096]u8 = undefined;
    var result_pos: usize = 0;
    
    // Add opening line
    result[result_pos] = '\n';
    result_pos += 1;
    std.mem.copyForwards(u8, result[result_pos..], dim_str[0..dim_pos]);
    result_pos += dim_pos;
    result[result_pos] = '{';
    result_pos += 1;
    result[result_pos] = '\n';
    result_pos += 1;
    
    // Process inner dimensions recursively
    var inner_counter: u32 = 0;
    while (inner_counter < n) {
        const entry_result = build_tree(inner_shape, base, offset);
        std.mem.copyForwards(u8, result[result_pos..result.len], entry_result.text);
        result_pos += entry_result.text.len;
        base = entry_result.next_base;
        
        if (inner_counter < n - 1) {
            result[result_pos] = ',';
            result_pos += 1;
            result[result_pos] = '\n';
            result_pos += 1;
        }
        inner_counter += 1;
    }
    
    // Add closing line
    result[result_pos] = '\n';
    result_pos += 1;
    const indent1 = indent(1);
    std.mem.copyForwards(u8, result[result_pos..], indent1);
    result_pos += indent1.len;
    result[result_pos] = '}';
    result_pos += 1;
    result[result_pos] = '\n';
    result_pos += 1;
    
    return BuildTreeResult {
        .text = result[0..result_pos],
        .next_base = base,
    };
}

pub fn generate() -> void {
    // Port the decision logic, not the file I/O
    // The actual file writing would be undefined; in a real implementation
    
    const shape = []u32{205, 2, 2, 2, 2, 2, 2};
    const literal_result = build_tree(shape, 0, 0);
    
    // For testing purposes, just verify the constants calculation
    // In a real implementation, this would build the full text
    
    // Calculate constants
    const OUTER = 205;
    const TOTAL = OUTER * 64;
    const LAST_IDX = OUTER - 1;
    const MID_IDX = OUTER / 2;
    const LAST_X = (2 * (TOTAL - 1)) % 32768;
    const LAST_Y = (2 * (TOTAL - 1) + 1) % 32768;
    const MID_E = MID_IDX * 64 + 32;
    const MID_X = (2 * MID_E) % 32768;
    const MID_Y = (2 * MID_E + 1) % 32768;
    const WRAP_LAST_X = (2 * (TOTAL - 1) + 32768) % 32768;
    const WRAP_LAST_Y = (2 * (TOTAL - 1) + 1 + 32768) % 32768;
    
    // Verify some expected values (this is the decision logic)
    assert(OUTER == 205);
    assert(TOTAL == 205 * 64);
    assert(LAST_IDX == 204);
    assert(MID_IDX == 102);
    assert(MID_E == 102 * 64 + 32);
    
    // Test modulo arithmetic
    assert(LAST_X < 32768);
    assert(LAST_Y < 32768);
    assert(MID_X < 32768);
    assert(MID_Y < 32768);
    assert(WRAP_LAST_X < 32768);
    assert(WRAP_LAST_Y < 32768);
    
    // In a real implementation, this would build the full text and write to file
    return;
}

// Test the indent function
test indent_basic {
    const result = indent(0);
    assert(result.len == 0);
}

test indent_positive {
    const result = indent(2);
    assert(result.len == 8);
    assert(result[0] == ' ');
    assert(result[4] == ' ');
}

// Test build_tree with 1D shape
test build_tree_1d {
    const shape = []u32{3};
    const result = build_tree(shape, 10, 0);
    
    // Should generate 3 Pt entries starting from base 10
    assert(result.text.len > 0);
    assert(result.next_base == 13); // base + n = 10 + 3
}

// Test build_tree with 2D shape
test build_tree_2d {
    const shape = []u32{2, 3};
    const result = build_tree(shape, 5, 0);
    
    // Should generate 2 entries, each with 3 inner Pt entries
    assert(result.text.len > 0);
    assert(result.next_base == 11); // base + n = 5 + 2*3 = 11
}

// Test generate function logic (without file I/O)
test generate_basic {
    // This tests that generate() doesn't crash and returns void
    generate();
}

// Test constants calculation
test constants_calculation {
    const OUTER_VAL = 205;
    const TOTAL_VAL = OUTER_VAL * 64;
    const LAST_IDX_VAL = OUTER_VAL - 1;
    const MID_IDX_VAL = OUTER_VAL / 2;
    const LAST_X_VAL = (2 * (TOTAL_VAL - 1)) % 32768;
    const LAST_Y_VAL = (2 * (TOTAL_VAL - 1) + 1) % 32768;
    const MID_E_VAL = MID_IDX_VAL * 64 + 32;
    const MID_X_VAL = (2 * MID_E_VAL) % 32768;
    const MID_Y_VAL = (2 * MID_E_VAL + 1) % 32768;
    const WRAP_LAST_X_VAL = (2 * (TOTAL_VAL - 1) + 32768) % 32768;
    const WRAP_LAST_Y_VAL = (2 * (TOTAL_VAL - 1) + 1 + 32768) % 32768;
    
    // Verify some expected values
    assert(OUTER_VAL == 205);
    assert(TOTAL_VAL == 205 * 64);
    assert(LAST_IDX_VAL == 204);
    assert(MID_IDX_VAL == 102);
    assert(MID_E_VAL == 102 * 64 + 32);
    
    // Test modulo arithmetic
    assert(LAST_X_VAL < 32768);
    assert(LAST_Y_VAL < 32768);
    assert(MID_X_VAL < 32768);
    assert(MID_Y_VAL < 32768);
    assert(WRAP_LAST_X_VAL < 32768);
    assert(WRAP_LAST_Y_VAL < 32768);
}