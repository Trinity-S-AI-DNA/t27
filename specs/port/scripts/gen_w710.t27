// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w710.t27
// Port of scripts/gen_w710.py to t27

// Emit specs/scratch/w710_bench_module_239x2p6_aos_var_call_write.t27: a
// [239][2][2][2][2][2][2]Pt grid of 15,296 elements wrapped in make_grid,
// whose footer checks four positions - the first element, the last, the
// middle index [119][1][0][0][0][0][0], and the last element again under
// offset 32768, which folds back onto offset 0 in u16.
//
// WHAT THIS PORT DELIBERATELY DOES NOT CONTAIN
//
// The text and the file. The original assembles the whole module out of
// f-strings joined through lists of lines (lines 63-133), re-indents every
// line by four spaces (lines 64-68), checks the bytes are ASCII and writes
// them to DST (lines 135-141). .t27 has no string concatenation, no string
// repetition and no growable lists, so the assembly cannot be expressed,
// and the write and the print only move bytes; both stay in Python. What
// decided is here, and every test asserts one of these decisions:
//
// - the derived constants the generated footer interpolates (lines 9-21)
// - indent: how many spaces a nesting level is worth (lines 24-25)
// - elem_x / elem_y: which (x, y) element number e earns, and the u16 fold
//   (lines 40-42)
// - bench_shape: the shape the literal is built over (line 62)
// - build_tree: how many leaves a shape holds, where the shared base
//   counter ends, and which element sits at row-major position k
//   (lines 28-58)
// - flat_index: which flat position an index tuple is - the original's
//   lines 15-16 comment, as executable code
// - is_ascii: the gate generate applies before writing (lines 135-136)

module port::scripts::gen_w710;

// Lines 9-21: the constants the generated footer interpolates into its
// assertions. 2 ** 6 is spelled 64; every derived value keeps its formula.
pub const OUTER: i64 = 239;
pub const TOTAL: i64 = OUTER * 64;
pub const LAST_IDX: i64 = OUTER - 1;
pub const MID_IDX: i64 = OUTER / 2;
pub const LAST_X: i64 = (2 * (TOTAL - 1)) % 32768;
pub const LAST_Y: i64 = (2 * (TOTAL - 1) + 1) % 32768;
// Index [MID_IDX][1][0][0][0][0][0] is element MID_IDX * 64 + 32.
pub const MID_E: i64 = MID_IDX * 64 + 32;
pub const MID_X: i64 = (2 * MID_E) % 32768;
pub const MID_Y: i64 = (2 * MID_E + 1) % 32768;
// Offset 32768 folds back onto 0 in u16, so the wrapped values repeat.
pub const WRAP_LAST_X: i64 = (2 * (TOTAL - 1) + 32768) % 32768;
pub const WRAP_LAST_Y: i64 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

// Lines 40-42: element number e earns x = (2 * e + offset) % 32768 and
// y = x + 1, both folded into the u16 range the generated module uses.
pub fn elem_x(e: i64, offset: i64) -> i64 {
    return (2 * e + offset) % 32768;
}

pub fn elem_y(e: i64, offset: i64) -> i64 {
    return (2 * e + offset + 1) % 32768;
}

// Lines 24-25: "    " * level. String repetition is not expressible in
// .t27, so the mapping is spelled out: exact for levels 0..=8 and capped
// at the level-8 indent above that. The generator only ever asks for
// levels 1 and 2.
pub fn indent(level: i64) -> str {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    if (level == 4) {
        return "                ";
    }
    if (level == 5) {
        return "                    ";
    }
    if (level == 6) {
        return "                        ";
    }
    if (level == 7) {
        return "                            ";
    }
    return "                                ";
}

// Line 62: shape = [OUTER, 2, 2, 2, 2, 2, 2]. The caller supplies the
// buffer; the function fills it in place and returns the dimension count
// it wrote.
pub fn bench_shape(shape: []i64) -> usize {
    if (shape.len == 0) {
        return 0;
    }
    shape[0] = OUTER;
    var wrote: usize = 1;
    while (wrote < shape.len) {
        shape[wrote] = 2;
        wrote += 1;
    }
    return wrote;
}

// Lines 15-16, as executable code: the row-major position of an index
// tuple inside the literal. [119][1][0][0][0][0][0] is
// 119 * 64 + 1 * 32 = 7648 = MID_E. Both slices are the same length.
pub fn flat_index(shape: []const i64, idx: []const i64) -> i64 {
    var pos: i64 = 0;
    var i: usize = 0;
    while (i < idx.len) {
        pos = pos * shape[i] + idx[i];
        i += 1;
    }
    return pos;
}

// The leaf count, next base and element value the original build_tree
// (lines 28-58) encodes. The original returns (text, next_base): the text
// is an f-string and join assembly over a list of lines that .t27 cannot
// express, so the port keeps what the text decides. The recursion emits
// leaves in row-major order, so the element at row-major position k is
// element number base + k, the shared counter ends at
// base + product(shape), and leaves is the number of elements the literal
// would carry.
pub struct Tree {
    leaves: i64,
    next_base: i64,
    x: i64,
    y: i64,
}

pub fn build_tree(shape: []const i64, base: i64, offset: i64, k: i64) -> Tree {
    var count: i64 = 1;
    var i: usize = 0;
    while (i < shape.len) {
        count = count * shape[i];
        i += 1;
    }
    return Tree { leaves: count, next_base: base + count, x: elem_x(base + k, offset), y: elem_y(base + k, offset) };
}

// Lines 135-136: generate refuses to write anything carrying a byte above
// the ASCII range; the raise becomes false.
pub fn is_ascii(text: []const u8) -> bool {
    var i: usize = 0;
    while (i < text.len) {
        if (text[i] >= 128) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Python: generate (lines 61-141) builds the shape, assembles the whole
// module as f-strings joined through lists (lines 63-133), checks the text
// is ASCII (lines 135-136) and writes it to DST with a byte-and-line count
// (lines 138-141). The assembly needs string concatenation, string
// repetition and growable lists, and the write and print move bytes - none
// of that is expressible in .t27 and none of it decides anything. Its
// decisions are the constants, elem_x/elem_y, bench_shape, flat_index and
// is_ascii above. This keeps the name and an undefined body, and no test
// calls it.
pub fn generate() {
    undefined;
}

test indent_maps_levels_to_spaces {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test element_values_follow_the_leaf_mapping {
    // Lines 40-42 with base 0, offset 0: the first element is (0, 1),
    // which the generated footer checks at lines 86-87.
    assert(elem_x(0, 0) == 0);
    assert(elem_y(0, 0) == 1);
    // The last element of the full shape carries LAST_X and LAST_Y
    // (footer lines 88-89).
    assert(elem_x(TOTAL - 1, 0) == LAST_X);
    assert(elem_y(TOTAL - 1, 0) == LAST_Y);
    // Footer lines 92-96: offset 32768 folds back onto 0 and 1 in u16.
    assert(elem_x(0, 32768) == 0);
    assert(elem_y(0, 32768) == 1);
    assert(elem_x(TOTAL - 1, 32768) == WRAP_LAST_X);
    assert(elem_y(TOTAL - 1, 32768) == WRAP_LAST_Y);
    // The fold wraps: with offset 32767 the y of element 0 is
    // (32767 + 1) % 32768, which is 0.
    assert(elem_x(0, 32767) == 32767);
    assert(elem_y(0, 32767) == 0);
}

test derived_constants_match_the_footer {
    assert(TOTAL == 15296);
    assert(LAST_IDX == 238);
    assert(MID_IDX == 119);
    assert(MID_E == 7648);
    assert(MID_X == 15296);
    assert(MID_Y == 15297);
    assert(LAST_X == 30590);
    assert(LAST_Y == 30591);
    // Lines 20-21 fold back onto lines 13-14: adding 32768 before the
    // modulo changes nothing for these elements.
    assert(WRAP_LAST_X == LAST_X);
    assert(WRAP_LAST_Y == LAST_Y);
}

test row_major_position_of_an_index_tuple {
    var shape: [7]i64 = [239, 2, 2, 2, 2, 2, 2];
    // The original's own comment (lines 15-16): the middle position.
    var mid: [7]i64 = [119, 1, 0, 0, 0, 0, 0];
    assert(flat_index(shape[0..shape.len], mid[0..mid.len]) == MID_E);
    // The footer's last element: [238][1][1][1][1][1][1] is TOTAL - 1.
    var last: [7]i64 = [238, 1, 1, 1, 1, 1, 1];
    assert(flat_index(shape[0..shape.len], last[0..last.len]) == TOTAL - 1);
    var first: [7]i64 = [0, 0, 0, 0, 0, 0, 0];
    assert(flat_index(shape[0..shape.len], first[0..first.len]) == 0);
}

test build_tree_counts_leaves_and_advances_the_base {
    // Leaf shape (lines 35-46): 239 entries, the counter advances by 239,
    // and element 0 of the leaf is element number 0.
    var leaf: [1]i64 = [239];
    const r1 = build_tree(leaf[0..leaf.len], 0, 0, 0);
    assert(r1.leaves == 239);
    assert(r1.next_base == 239);
    assert(r1.x == 0);
    assert(r1.y == 1);
    // A nested shape with a non-zero base (lines 48-58): the counter
    // accumulates across the whole literal and ends at base + product.
    var nested: [3]i64 = [2, 3, 4];
    const r2 = build_tree(nested[0..nested.len], 5, 0, 23);
    assert(r2.leaves == 24);
    assert(r2.next_base == 29);
    assert(r2.x == elem_x(28, 0));
    assert(r2.y == elem_y(28, 0));
    // The full bench shape at the positions the generated footer checks.
    var shape: [7]i64 = [239, 2, 2, 2, 2, 2, 2];
    const mid = build_tree(shape[0..shape.len], 0, 0, MID_E);
    assert(mid.leaves == TOTAL);
    assert(mid.next_base == TOTAL);
    assert(mid.x == MID_X);
    assert(mid.y == MID_Y);
    const last = build_tree(shape[0..shape.len], 0, 0, TOTAL - 1);
    assert(last.x == LAST_X);
    assert(last.y == LAST_Y);
    // make_grid(32768) folds back onto make_grid(0) (footer lines 92-96).
    const wrapped = build_tree(shape[0..shape.len], 0, 32768, TOTAL - 1);
    assert(wrapped.x == WRAP_LAST_X);
    assert(wrapped.y == WRAP_LAST_Y);
}

test bench_shape_fills_the_generated_grid_shape {
    var shape: [7]i64 = undefined;
    assert(bench_shape(shape[0..shape.len]) == 7);
    assert(shape[0] == 239);
    assert(shape[1] == 2);
    assert(shape[6] == 2);
}

test ascii_gate_refuses_non_ascii_bytes {
    // The header text the original writes is pure ASCII (line 77).
    assert(is_ascii("module w710_bench_module_239x2p6_aos_var_call_write\n"));
    assert(is_ascii("pub struct Pt { x : i16, y : i16 }\n"));
    assert(is_ascii(""));
    // 0xC3 0xA9 is a two-byte UTF-8 sequence above the ASCII range;
    // line 135 refuses to write any such byte.
    var bad: [4]u8 = [ 97, 98, 195, 169 ];
    assert(!is_ascii(bad[0..bad.len]));
}
