// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w717.t27
// Port of scripts/gen_w717.py (the 253x2p6 AoS generator) to t27.
//
// The Python script writes the benchmark spec
// specs/scratch/w717_bench_module_253x2p6_aos_var_call_write.t27
// (original line 7): a [253, 2, 2, 2, 2, 2, 2] array of Pt structs in
// which entry e carries (x, y) = ((2e + offset) % 32768,
// (2e + offset + 1) % 32768) (the element rule, original lines 40-42),
// plus module-level expected/dst copies, a test and a bench.
//
// The port keeps the script's decision logic as pure t27 functions —
// indentation, the shape walk, coordinate folding and the ASCII gate —
// and leaves the emit plumbing (file I/O and printing, original lines
// 61-141) unported.
//
// Each ported function cites its original lines.

module port::scripts::gen_w717 {

// The emitted benchmark constants (original lines 9-21).
const OUTER: i64 = 253;
const TOTAL: i64 = OUTER * 64;
const LAST_IDX: i64 = OUTER - 1;
const MID_IDX: i64 = OUTER / 2; // 126
const MID_E: i64 = MID_IDX * 64 + 32;
const LAST_X: i64 = (2 * (TOTAL - 1)) % COORD_MOD;
const LAST_Y: i64 = (2 * (TOTAL - 1) + 1) % COORD_MOD;
const MID_X: i64 = (2 * MID_E) % COORD_MOD;
const MID_Y: i64 = (2 * MID_E + 1) % COORD_MOD;
const WRAP_LAST_X: i64 = (2 * (TOTAL - 1) + COORD_MOD) % COORD_MOD;
const WRAP_LAST_Y: i64 = (2 * (TOTAL - 1) + 1 + COORD_MOD) % COORD_MOD;
const COORD_MOD: i64 = 32768;

// build_tree reports one of these per call: the coordinates of the
// subtree's first and last entries, how many entries the subtree
// holds, and where the next subtree's base starts (original lines 46
// and 58 return (text, next_base); the port keeps the decisions).
pub struct TreeBuild {
    first_x: i64,
    first_y: i64,
    last_x: i64,
    last_y: i64,
    leaves: i64,
    next_base: i64,
}

// indent (original lines 24-25): one four-space step per level. The
// bench shape [253, 2, 2, 2, 2, 2, 2] nests at most seven levels deep,
// so the chain covers every level the generator can emit and the
// final return hands out level 7's 28 spaces (and any deeper call's).
pub fn indent(level: i64) str {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    if (level == 4) {
        return "                ";
    }
    if (level == 5) {
        return "                    ";
    }
    if (level == 6) {
        return "                        ";
    }
    return "                            ";
}

// wrap32768 carries the element rule's modulus (original lines 41-42).
// Python's % is non-negative for a positive divisor, so the double
// application folds negative intermediates into 0..32767 too.
pub fn wrap32768(v: i64) i64 {
    return ((v % COORD_MOD) + COORD_MOD) % COORD_MOD;
}

// elem_x (original lines 40-41): x = (2 * e + offset) % 32768 for
// entry e of a leaf run.
pub fn elem_x(e: i64, offset: i64) i64 {
    return wrap32768(2 * e + offset);
}

// elem_y (original lines 41-42): y = (2 * e + offset + 1) % 32768,
// one past x under the same modulus.
pub fn elem_y(e: i64, offset: i64) i64 {
    return wrap32768(2 * e + offset + 1);
}

// flat_index mirrors the row-major index math of the original's
// comment (original lines 15-16): over [253, 2, 2, 2, 2, 2, 2] the
// index [MID_IDX][1][0][0][0][0][0] corresponds to element number
// MID_IDX * 64 + 1 * 32 + 0*16 + 0*8 + 0*4 + 0*2 + 0 = MID_IDX*64 + 32.
pub fn flat_index(shape: []const i64, idx: []const i64) i64 {
    var flat: i64 = 0;
    var i: usize = 0;
    while (i < shape.len) {
        flat = flat * shape[i] + idx[i];
        i += 1;
    }
    return flat;
}

// build_level is the recursive half of build_tree (original lines
// 28-58). The Python builds text; the port keeps the decisions: which
// coordinates the first and last entries carry, how many entries a
// subtree holds, and where the next base starts.
//
// The leaf case (original lines 35-46) turns the leaf dimension n into
// n entries e = base + i with the element rule (lines 40-42) and
// advances the base by n (line 46). An empty leaf dimension emits no
// entries and leaves the base unchanged (line 46 with n = 0).
//
// The nested case (original lines 48-58) threads the base through its
// n children (line 54), so child i starts at base + i * child.leaves,
// and returns the last child's base (line 58). An empty inner
// dimension has no children and leaves the base unchanged.
fn build_level(shape: []const i64, dim: usize, base: i64, offset: i64) TreeBuild {
    const n: i64 = shape[dim];
    if (shape.len - dim == 1) {
        // Leaf dimension (lines 35-46).
        if (n == 0) {
            return TreeBuild { first_x: 0, first_y: 0, last_x: 0, last_y: 0, leaves: 0, next_base: base, };
        }
        var t: TreeBuild = TreeBuild { first_x: elem_x(base, offset), first_y: elem_y(base, offset), last_x: elem_x(base + n - 1, offset), last_y: elem_y(base + n - 1, offset), leaves: n, next_base: base + n, };
        return t;
    }
    if (n == 0) {
        // Empty inner dimension (lines 53-58 with range(0)).
        return TreeBuild { first_x: 0, first_y: 0, last_x: 0, last_y: 0, leaves: 0, next_base: base, };
    }
    // Inner node (lines 48-58): the base threads through every child.
    const first: TreeBuild = build_level(shape, dim + 1, base, offset);
    var last: TreeBuild = first;
    var i: i64 = 1;
    var b: i64 = first.next_base;
    while (i < n) {
        last = build_level(shape, dim + 1, b, offset);
        b = last.next_base;
        i += 1;
    }
    return TreeBuild { first_x: first.first_x, first_y: first.first_y, last_x: last.last_x, last_y: last.last_y, leaves: first.leaves * n, next_base: last.next_base, };
}

// build_tree (original lines 28-58) walks the shape from its outermost
// dimension, threading the running base and the coordinate offset.
pub fn build_tree(shape: []const i64, base: i64, offset: i64) TreeBuild {
    return build_level(shape, 0, base, offset);
}

// is_ascii carries generate()'s ASCII gate (original lines 135-136):
// the generated spec must be pure ASCII before it is written with
// encoding="ascii" (line 138).
pub fn is_ascii(s: []const u8) bool {
    for c in s {
        if (c > 127) {
            return false;
        }
    }
    return true;
}

// generate (original lines 61-141) is emit plumbing: it renders the
// literal text, assembles the header/make_grid/footer sections
// (lines 71-131), checks the ASCII gate (lines 135-136), writes DST
// (lines 138-139) and prints a summary (line 141). File I/O has no
// counterpart in this port, so the body stays undefined.
pub fn generate() i64 {
    return undefined;
}

test "indent steps four spaces per level" {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
    assert(indent(7) == "                            ");
    assert(indent(-2) == "");
}

test "bench constants match the original" {
    assert(OUTER == 253);
    assert(TOTAL == 16192);
    assert(LAST_IDX == 252);
    assert(MID_IDX == 126);
    assert(MID_E == 8096);
    assert(LAST_X == 32382);
    assert(LAST_Y == 32383);
    assert(MID_X == 16192);
    assert(MID_Y == 16193);
    assert(WRAP_LAST_X == 32382);
    assert(WRAP_LAST_Y == 32383);
}

test "row-major index math matches the original comment" {
    const shape: [7]i64 = [253, 2, 2, 2, 2, 2, 2];
    const mid: [7]i64 = [126, 1, 0, 0, 0, 0, 0];
    const last: [7]i64 = [252, 1, 1, 1, 1, 1, 1];
    const zero: [7]i64 = [0, 0, 0, 0, 0, 0, 0];
    // Index [MID_IDX][1][0][0][0][0][0] = MID_IDX*64 + 32 (line 16).
    assert(flat_index(&shape, &mid) == 8096);
    assert(flat_index(&shape, &mid) == MID_E);
    // The last index sits at element TOTAL - 1.
    assert(flat_index(&shape, &last) == 16191);
    assert(flat_index(&shape, &last) == TOTAL - 1);
    assert(flat_index(&shape, &zero) == 0);
}

test "element rule matches the generated assertions" {
    // dst[0]..[0].x/y (footer lines 86-87).
    assert(elem_x(0, 0) == 0);
    assert(elem_y(0, 0) == 1);
    // dst[LAST_IDX][1][1][1][1][1][1].x/y (footer lines 88-89).
    assert(elem_x(TOTAL - 1, 0) == LAST_X);
    assert(elem_y(TOTAL - 1, 0) == LAST_Y);
    // dst[MID_IDX][1][0][0][0][0][0].x/y (footer lines 90-91).
    assert(elem_x(MID_E, 0) == MID_X);
    assert(elem_y(MID_E, 0) == MID_Y);
    // make_grid(32768) folds back to the offset-0 coordinates
    // (footer lines 92-96).
    assert(elem_x(0, COORD_MOD) == 0);
    assert(elem_y(0, COORD_MOD) == 1);
    assert(elem_x(TOTAL - 1, COORD_MOD) == WRAP_LAST_X);
    assert(elem_y(TOTAL - 1, COORD_MOD) == WRAP_LAST_Y);
}

test "element rule folds negative offsets like Python" {
    // Python: (2 * 0 - 1) % 32768 == 32767.
    assert(elem_x(0, -1) == 32767);
    assert(elem_y(0, -1) == 0);
    // Python: (2 * 1 - 1234) % 32768 == 31536.
    assert(elem_x(1, -1234) == 31536);
    assert(elem_y(1, -1234) == 31537);
}

test "build_tree leaf walk advances the base by n" {
    const one: [1]i64 = [1];
    const three: [1]i64 = [3];
    // A single-entry leaf carries entry (0, 1) and hands base 1 on.
    const t1: TreeBuild = build_tree(&one, 0, 0);
    assert(t1.first_x == 0);
    assert(t1.first_y == 1);
    assert(t1.last_x == 0);
    assert(t1.last_y == 1);
    assert(t1.leaves == 1);
    assert(t1.next_base == 1);
    // Entries e = 10, 11, 12 (line 40) carry (20, 21)..(24, 25)
    // (lines 41-42); the base advances by n (line 46).
    const t3: TreeBuild = build_tree(&three, 10, 0);
    assert(t3.first_x == 20);
    assert(t3.first_y == 21);
    assert(t3.last_x == 24);
    assert(t3.last_y == 25);
    assert(t3.leaves == 3);
    assert(t3.next_base == 13);
}

test "build_tree nested walk threads the base" {
    const shape: [3]i64 = [2, 2, 2];
    const t: TreeBuild = build_tree(&shape, 7, 0);
    // The eight entries span e = 7..14 (line 54 threading, line 46
    // advance): first entry (14, 15), last entry (28, 29).
    assert(t.first_x == 14);
    assert(t.first_y == 15);
    assert(t.last_x == 28);
    assert(t.last_y == 29);
    assert(t.leaves == 8);
    assert(t.next_base == 15);
}

test "build_tree threads the offset into every entry" {
    const shape: [1]i64 = [2];
    // The offset shifts both coordinates by the rule (lines 41-42).
    const pos: TreeBuild = build_tree(&shape, 0, 1234);
    assert(pos.first_x == 1234);
    assert(pos.first_y == 1235);
    assert(pos.last_x == 1236);
    assert(pos.last_y == 1237);
    // A negative offset wraps like Python's %.
    const neg: TreeBuild = build_tree(&shape, 0, -1234);
    assert(neg.first_x == 31534);
    assert(neg.first_y == 31535);
    assert(neg.last_x == 31536);
    assert(neg.last_y == 31537);
}

test "build_tree folds coordinates modulo 32768" {
    const shape: [1]i64 = [2];
    // e = 16383 carries (32766, 32767); e = 16384 wraps to (0, 1) —
    // the same fold the footer checks at the array tail (lines 92-96).
    const t: TreeBuild = build_tree(&shape, 16383, 0);
    assert(t.first_x == 32766);
    assert(t.first_y == 32767);
    assert(t.last_x == 0);
    assert(t.last_y == 1);
}

test "build_tree empty dimensions keep the base" {
    const leaf: [1]i64 = [0];
    const inner: [2]i64 = [0, 3];
    const deep: [2]i64 = [3, 0];
    // An empty leaf dimension (line 46 with n = 0)...
    const a: TreeBuild = build_tree(&leaf, 5, 0);
    assert(a.leaves == 0);
    assert(a.next_base == 5);
    // ...an empty inner dimension (line 58 with no children)...
    const b: TreeBuild = build_tree(&inner, 5, 0);
    assert(b.leaves == 0);
    assert(b.next_base == 5);
    // ...and children whose own leaf dimension is empty all keep it.
    const c: TreeBuild = build_tree(&deep, 5, 0);
    assert(c.leaves == 0);
    assert(c.next_base == 5);
}

test "full bench shape reaches the footer constants" {
    const shape: [7]i64 = [253, 2, 2, 2, 2, 2, 2];
    // The whole grid holds TOTAL entries and the base ends at TOTAL
    // (lines 46/58 threading over all 253*64 elements).
    const t0: TreeBuild = build_tree(&shape, 0, 0);
    assert(t0.leaves == TOTAL);
    assert(t0.next_base == TOTAL);
    assert(t0.first_x == 0);
    assert(t0.first_y == 1);
    assert(t0.last_x == LAST_X);
    assert(t0.last_y == LAST_Y);
    // Offset 32768 folds back to the same coordinates (lines 92-96).
    const tw: TreeBuild = build_tree(&shape, 0, COORD_MOD);
    assert(tw.first_x == 0);
    assert(tw.first_y == 1);
    assert(tw.last_x == WRAP_LAST_X);
    assert(tw.last_y == WRAP_LAST_Y);
}

test "ascii gate rejects non-ascii bytes" {
    assert(is_ascii("make_grid(0);"));
    assert(is_ascii("pub fn make_grid(offset : u16) [253][2][2][2][2][2][2]Pt {"));
    assert(!is_ascii("\x80"));
    assert(!is_ascii("ok \xff bad"));
}
}
