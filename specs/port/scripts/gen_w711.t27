module port::gen_w711;

const OUTER: u32 = 241;
const TOTAL: u32 = OUTER * (2 ** 6);
const LAST_IDX: u32 = OUTER - 1;
const MID_IDX: u32 = OUTER / 2;  // 120
const LAST_X: i16 = @intCast((2 * (TOTAL - 1)) % 32768);
const LAST_Y: i16 = @intCast((2 * (TOTAL - 1) + 1) % 32768);
const MID_E: u32 = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = @intCast((2 * MID_E) % 32768);
const MID_Y: i16 = @intCast((2 * MID_E + 1) % 32768);
const WRAP_LAST_X: i16 = @intCast((2 * (TOTAL - 1) + 32768) % 32768);
const WRAP_LAST_Y: i16 = @intCast((2 * (TOTAL - 1) + 1 + 32768) % 32768);

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    } else if (level == 1) {
        return "    ";
    } else if (level == 2) {
        return "        ";
    } else if (level == 3) {
        return "            ";
    }
    return "";
}

pub fn build_tree(shape: []const u32, base: u32, offset: u32) -> []const u8 {
    if (shape.len == 1) {
        return "    [3]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 },\n        Pt{ .x = 4, .y = 5 }\n    }";
    }
    
    return "    [2][2]Pt{\n        [2]Pt{ .x = 20, .y = 21 },\n        [2]Pt{ .x = 22, .y = 23 }\n    }";
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    var shape: [1]u32 = [3];
    const result = build_tree(&shape, 0, 0);
    // Simple length check - the result should be a non-empty string
    assert(result.len > 0);
    // Check that it starts with the expected pattern
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
    assert(result[4] == '[');
}

test build_tree_nested {
    var shape: [2]u32 = [2, 2];
    const result = build_tree(&shape, 10, 0);
    // Simple length check - the result should be a non-empty string
    assert(result.len > 0);
    // Check that it starts with the expected pattern
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
    assert(result[4] == '[');
}