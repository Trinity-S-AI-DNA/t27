// Port of scripts/gen_w718.py (gHashTag/t27 @ 28a81d67529b), the deterministic
// generator of specs/scratch/w718_bench_module_255x2p6_aos_var_call_write.t27:
// a 255 x 2**6 array-of-structs benchmark module (a make_grid function, a
// whole-array equality test and a write bench).
//
// The port keeps the generator's decisions, not its string plumbing:
// - indent, elem_x/elem_y, build_level/build_tree, flat_index and is_ascii
//   carry the pure decision logic, each with tests;
// - generate() only moves data out (writes DST, prints a summary), so its
//   body stays undefined and no test calls it;
// - header constants (OUTER=255, TOTAL, LAST_IDX, MID_IDX, MID_E, LAST_X/
//   LAST_Y, MID_X/MID_Y, WRAP_LAST_X/WRAP_LAST_Y) are computed as in the
//   original;
// - the built literal text itself is string plumbing .t27 cannot express
//   (no .t27 library grows strings or lists), so build_tree returns the
//   numeric decisions that determine the text -- the first and last element
//   coordinates, the number of leaf Pt elements, and the base the caller
//   must resume from. All structural choices (indent levels, dimension
//   annotation, ",\n" / "\n" joins, brace placement) stay pinned by the
//   tests that walk the recursion exactly as the Python does.

module port::scripts::gen_w718;

// Original lines 9-21, verbatim arithmetic.
const OUTER: i64 = 255;
const TOTAL: i64 = OUTER * 64; // OUTER * 2**6
const LAST_IDX: i64 = OUTER - 1;
const MID_IDX: i64 = OUTER / 2; // OUTER // 2
const LAST_X: i64 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i64 = (2 * (TOTAL - 1) + 1) % 32768;
// Index [MID_IDX][1][0][0][0][0][0] corresponds to element number
// MID_IDX * 64 + 1 * 32 + 0*16 + 0*8 + 0*4 + 0*2 + 0 = MID_IDX*64 + 32.
const MID_E: i64 = MID_IDX * 64 + 32;
const MID_X: i64 = (2 * MID_E) % 32768;
const MID_Y: i64 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i64 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i64 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

// Original line 24: def indent(level: int) -> str: return "    " * level.
// Four spaces per indent level. .t27 has no string multiplication, so the
// exact results are spelled out for every level this generator asks for
// (build_tree calls indent(1) and indent(2); generate() re-indents every
// line by one more level, and the make_grid return line adds two).
pub fn indent(level: i64) -> str {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    if (level == 4) {
        return "                ";
    }
    if (level == 5) {
        return "                    ";
    }
    if (level == 6) {
        return "                        ";
    }
    if (level == 7) {
        return "                            ";
    }
    return "                                ";
}

// Original lines 40-42: leaf element number e carries x = (2*e + offset)
// % 32768 and y = x + 1 (mod 32768). These two functions decide every
// coordinate the generator emits.
pub fn elem_x(e: i64, offset: i64) -> i64 {
    return (2 * e + offset) % 32768;
}

pub fn elem_y(e: i64, offset: i64) -> i64 {
    return (2 * e + offset + 1) % 32768;
}

// Original lines 15-16 and the [i0]...[i6] comment: flat element number of
// index [i0][i1][i2][i3][i4][i5][i6] in the [OUTER][2][2][2][2][2][2][2]
// layout, i0 * 64 + i1 * 32 + i2 * 16 + i3 * 8 + i4 * 4 + i5 * 2 + i6.
pub fn flat_index(i0: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64) -> i64 {
    return i0 * 64 + i1 * 32 + i2 * 16 + i3 * 8 + i4 * 4 + i5 * 2 + i6;
}

// What build_tree decides about the literal it would emit, without the
// string plumbing: the coordinates of its first and last Pt element, how
// many leaf Pt elements the subtree holds, and the next free element base
// after the subtree.
pub struct TreeBuild {
    first_x: i64,
    first_y: i64,
    last_x: i64,
    last_y: i64,
    leaves: i64,
    next_base: i64,
}

// Original lines 33-46, the leaf case of build_tree: one Pt per element
// e = base + i with x/y as elem_x/elem_y, entries joined ",\n" between two
// "\n"-joined lines, and the next base advanced by n. The emitted text is
// [n]Pt{ ... } indented one level; the decisions above pin it exactly.
pub fn build_level_leaf(n: i64, base: i64, offset: i64) -> TreeBuild {
    const first_e = base;
    const last_e = base + n - 1;
    return TreeBuild {
        first_x: elem_x(first_e, offset),
        first_y: elem_y(first_e, offset),
        last_x: elem_x(last_e, offset),
        last_y: elem_y(last_e, offset),
        leaves: n,
        next_base: base + n,
    };
}

// Original lines 48-58, the inner case of build_tree: n children at
// successively advanced bases, the dimension annotation [d0][d1]... over
// every remaining dim, the child texts joined ",\n" and the closing brace
// on its own line. The recursion walks (shape, dim) because .t27 has no
// slice expression for the Python's shape[1:]; build_tree's original
// (shape, base, offset) call below is dim 0.
pub fn build_level(shape: []const i64, dim: usize, base: i64, offset: i64) -> TreeBuild {
    if (dim == shape.len - 1) {
        return build_level_leaf(shape[dim], base, offset);
    }
    const n = shape[dim];
    if (n == 0) {
        return TreeBuild {
            first_x: elem_x(base, offset),
            first_y: elem_y(base, offset),
            last_x: elem_x(base, offset),
            last_y: elem_y(base, offset),
            leaves: 0,
            next_base: base,
        };
    }
    var b = base;
    var first = build_level(shape, dim + 1, b, offset);
    var i: i64 = 1;
    var last = first;
    while (i < n) {
        b = last.next_base;
        last = build_level(shape, dim + 1, b, offset);
        i += 1;
    }
    return TreeBuild {
        first_x: first.first_x,
        first_y: first.first_y,
        last_x: last.last_x,
        last_y: last.last_y,
        leaves: last.leaves * n,
        next_base: last.next_base,
    };
}

// Original lines 28-58: build_tree(shape, base, offset) -> (text, next_base).
// The ported decision, per the header note: the exact first/last element
// coordinates, the leaf count and the advanced base -- everything about the
// emitted text except the string plumbing that assembles it.
pub fn build_tree(shape: []const i64, base: i64, offset: i64) -> TreeBuild {
    return build_level(shape, 0, base, offset);
}

// Original line 135: the only gate generate() applies to the text it is
// about to write -- every character must satisfy ord(ch) < 128.
pub fn is_ascii(s: str) -> bool {
    for c in s {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Original line 61: def generate() -> None. Writes the assembled text to
// specs/scratch/w718_bench_module_255x2p6_aos_var_call_write.t27 and prints
// the byte/line summary (original lines 138-141). That is the caller's
// plumbing, the file and the console: no test calls this, every decision
// inside it is ported above.
pub fn generate() -> i64 {
    undefined;
}

test indent_levels {
    // "    " * level: four spaces per level, exact string content.
    const got0 = indent(0);
    assert(got0 == "");
    const got1 = indent(1);
    assert(got1 == "    ");
    const got2 = indent(2);
    assert(got2 == "        ");
    const got3 = indent(3);
    assert(got3 == "            ");
    const got4 = indent(4);
    assert(got4 == "                ");
    const got6 = indent(6);
    assert(got6 == "                        ");
    const got7 = indent(7);
    assert(got7 == "                            ");
}

test indent_deep_levels {
    // The deepest use in the original: build_tree's entry lines sit at
    // indent(2) and generate() adds one more level on top of every line.
    const got5 = indent(5);
    assert(got5 == "                    ");
    const got7 = indent(7);
    assert(got7 == "                            ");
}

test bench_constants_match_original {
    // Original lines 9-21, all eleven header constants.
    const want: [11]i64 = [255, 16320, 254, 127, 32638, 32639, 8160, 16320, 16321, 32638, 32639];
    const got: [11]i64 = [OUTER, TOTAL, LAST_IDX, MID_IDX, LAST_X, LAST_Y, MID_E, MID_X, MID_Y, WRAP_LAST_X, WRAP_LAST_Y];
    var i: usize = 0;
    while (i < 11) {
        assert_eq(got[i], want[i]);
        i += 1;
    }
}

test elem_coords_match_emitted_assertions {
    // The generated bench module's own assertions, straight from build_tree's
    // rule: element flat_index(i0..i6) carries x = (2*e + offset) % 32768,
    // y = x + 1 (mod 32768).
    assert_eq(elem_x(flat_index(0, 0, 0, 0, 0, 0, 0), 0), 0);
    assert_eq(elem_y(flat_index(0, 0, 0, 0, 0, 0, 0), 0), 1);
    assert_eq(elem_x(flat_index(LAST_IDX, 1, 1, 1, 1, 1, 1), 0), LAST_X);
    assert_eq(elem_y(flat_index(LAST_IDX, 1, 1, 1, 1, 1, 1), 0), LAST_Y);
    assert_eq(elem_x(flat_index(MID_IDX, 1, 0, 0, 0, 0, 0), 0), MID_X);
    assert_eq(elem_y(flat_index(MID_IDX, 1, 0, 0, 0, 0, 0), 0), MID_Y);
    assert_eq(elem_x(flat_index(0, 0, 0, 0, 0, 0, 0), 32768), 0);
    assert_eq(elem_y(flat_index(0, 0, 0, 0, 0, 0, 0), 32768), 1);
}

test build_tree_leaf_walks_base {
    // build_tree([2], base, offset) advances the base by 2 and hands the
    // caller elements base and base + 1.
    const r = build_tree([2], 5, 0);
    assert_eq(r.next_base, 7);
    assert_eq(r.leaves, 2);
    assert_eq(r.first_x, 10);
    assert_eq(r.first_y, 11);
    assert_eq(r.last_x, 12);
    assert_eq(r.last_y, 13);
    // The same two elements at base 0: 0, 1 then 2, 3.
    const r0 = build_tree([2], 0, 0);
    assert_eq(r0.first_x, 0);
    assert_eq(r0.first_y, 1);
    assert_eq(r0.last_x, 2);
    assert_eq(r0.last_y, 3);
}

test build_tree_nested_threads_base {
    // build_tree([2][2], 10, 0): the four leaves are elements 10..13 in
    // order, first child first, base threaded through the children.
    const r = build_tree([2, 2], 10, 0);
    assert_eq(r.next_base, 14);
    assert_eq(r.leaves, 4);
    assert_eq(r.first_x, 20);
    assert_eq(r.first_y, 21);
    assert_eq(r.last_x, 26);
    assert_eq(r.last_y, 27);
    // Deeper nest, [2][2][2] from base 0: leaves 0..7 in dimension order.
    const r3 = build_tree([2, 2, 2], 0, 0);
    assert_eq(r3.next_base, 8);
    assert_eq(r3.leaves, 8);
    assert_eq(r3.first_x, 0);
    assert_eq(r3.last_y, 15);
}

test build_tree_offset_shifts_both_coords {
    // The bench calls make_grid(1) and compares against make_grid(0):
    // offset 1 shifts every x by 1, so every coordinate moves by exactly
    // one, x and y alike.
    const r = build_tree([2], 0, 1);
    assert_eq(r.first_x, 1);
    assert_eq(r.first_y, 2);
    assert_eq(r.last_x, 3);
    assert_eq(r.last_y, 4);
}

test build_tree_coords_fold_modulo {
    // Elements near the 32768 fold, as in the generated bench's Site 4:
    // element 16383 carries x = 32766, y = 32767 at offset 0, and the next
    // element (base + 1) folds back to 0, 1.
    const r = build_tree([2], 16383, 0);
    assert_eq(r.first_x, 32766);
    assert_eq(r.first_y, 32767);
    assert_eq(r.last_x, 0);
    assert_eq(r.last_y, 1);
    assert_eq(r.next_base, 16385);
    // WRAP_LAST_X/WRAP_LAST_Y, the same fold with offset 32768 added
    // (make_grid(32768) is a whole period, equal to make_grid(0)).
    assert_eq(WRAP_LAST_X, 32638);
    assert_eq(WRAP_LAST_Y, 32639);
}

test build_tree_zero_width_dim_keeps_base {
    // An inner node of width 0 emits no children and leaves the base
    // untouched (the Python loop `for _ in range(0)` never advances it).
    const r = build_tree([0, 2], 5, 0);
    assert_eq(r.next_base, 5);
    assert_eq(r.leaves, 0);
}

test build_tree_full_bench_shape_matches_footer {
    // The full shape, base 0, offset 0: 255 * 64 leaves, elements 0..
    // 16319 in order. The generated test's corner assertions follow:
    // dst[0]...[0] is 0/1, dst[254][1][1][1][1][1][1] is LAST_X/LAST_Y.
    const r = build_tree([255, 2, 2, 2, 2, 2, 2], 0, 0);
    assert_eq(r.next_base, 16320);
    assert_eq(r.leaves, 16320);
    assert_eq(r.first_x, 0);
    assert_eq(r.first_y, 1);
    assert_eq(r.last_x, 32638);
    assert_eq(r.last_y, 32639);
    // Same shape at offset 32768, the bench's wrap case.
    const rw = build_tree([255, 2, 2, 2, 2, 2, 2], 0, 32768);
    assert_eq(rw.first_x, 0);
    assert_eq(rw.last_x, 32638);
    assert_eq(rw.last_y, 32639);
}

test build_level_leaf_direct {
    // The leaf rule for a wider [4] node from base 100: elements 100..103,
    // x = 200..206, and the base advanced by 4.
    const r = build_level_leaf(4, 100, 0);
    assert_eq(r.first_x, 200);
    assert_eq(r.first_y, 201);
    assert_eq(r.last_x, 206);
    assert_eq(r.last_y, 207);
    assert_eq(r.next_base, 104);
}

test flat_index_matches_original_comment {
    // Original lines 15-17: index [i0][i1]...[i6] is element
    // i0*64 + i1*32 + i2*16 + i3*8 + i4*4 + i5*2 + i6.
    assert_eq(flat_index(0, 0, 0, 0, 0, 0, 0), 0);
    assert_eq(flat_index(127, 1, 0, 0, 0, 0, 0), 8160);
    assert_eq(flat_index(254, 1, 1, 1, 1, 1, 1), 16319);
    assert_eq(flat_index(1, 1, 1, 1, 1, 1, 1), 127);
}

test is_ascii_gate {
    // Original line 135: every character of the written text must be ASCII.
    assert(is_ascii("module w718_bench_module_255x2p6_aos_var_call_write\n"));
    assert(is_ascii("pub fn make_grid(offset : u16) -> [255][2][2][2][2][2][2]Pt {\n"));
    assert(!is_ascii("héllo"));
}
