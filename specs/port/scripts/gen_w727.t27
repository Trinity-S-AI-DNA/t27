// Port of scripts/gen_w727.py (gHashTag/t27 at 010e26c0cc4b, 146 lines, 3
// functions), the deterministic generator of
// specs/scratch/w727_bench_module_273x2p6_aos_var_call_write.t27: it builds a
// 273x2**6 array-of-structs literal with a recursive builder, wraps it in
// `pub fn make_grid(offset : u16)` plus a test/bench pair, checks the text is
// ASCII and writes the file.
//
// Porting map:
// - indent() -> indent(): "    " * level cannot be written in .t27 (no string
//   repetition), so the levels the generator can reach are spelled out. The
//   original only ever asks for levels 1 and 2 (both from build_tree), and
//   level 0 degenerates to ""; above 2 the result clamps at the deepest
//   string here (Python line 24). Negative levels are "" as in Python
//   ("    " * -2 == "").
// - build_tree() -> build_tree(): the original assembles the literal text
//   with f-strings and "\n".join (lines 28-58); .t27 has no string
//   concatenation, so the text cannot be built here. The decision is ported:
//   the recursion only threads `base` through the row-major element order
//   (every leaf consumes len(leaf) elements), so next_base == base +
//   product(shape) and flat element number e carries the coordinates
//   ((2*e + offset) % 32768, (2*e + offset + 1) % 32768). build_tree returns
//   exactly that content as a TreePlan: the Pt values the text encodes, in
//   order, with the exact count and next_base for any shape; at most
//   TREE_CAP coordinates are materialized (the formula is uniform, so the
//   first TREE_CAP pin the rest). The punctuation and indentation assembly
//   around the plan is the named gap.
// - generate() -> generate(): writes the assembled text to DST (line 138).
//   File I/O has no .t27 form, so the write stays with the caller and the
//   body is the sanctioned `undefined;` stub that no test calls. Its
//   decisions are ported as tested code below: the module-header constants
//   (lines 9-21), the shape [273, 2, 2, 2, 2, 2, 2] fed to build_tree with
//   base 0 / offset 0, and the ASCII guard on lines 135-136
//   (text_is_ascii). The header/make_grid/footer text assembly and the
//   4-space re-indent of the literal (lines 64-131) are named gaps; the
//   print on line 141 and the __main__ guard are the caller's.

module port::scripts::gen_w727;

// Module-header constants of the original (scripts/gen_w727.py, lines 9-21).
const OUTER: i64 = 273;
const TOTAL: i64 = OUTER * 64;               // OUTER * 2**6 = 17472
const LAST_IDX: i64 = OUTER - 1;             // 272
const MID_IDX: i64 = OUTER / 2;              // 136
const LAST_X: i64 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i64 = (2 * (TOTAL - 1) + 1) % 32768;
// Flat element of [MID_IDX][1][0][0][0][0][0]: MID_IDX*2**6 + 1*2**5.
const MID_E: i64 = MID_IDX * 64 + 32;
const MID_X: i64 = (2 * MID_E) % 32768;
const MID_Y: i64 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i64 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i64 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

// One Pt entry of the literal: the flat element number and its coordinates.
struct Coord { e: i64, x: i64, y: i64, }

// How many leading coordinates a TreePlan materializes.
const TREE_CAP: usize = 16;

// What build_tree decides, carried instead of the assembled text.
struct TreePlan { next_base: i64, count: i64, filled: usize, elems: [16]Coord, }

const ZERO_COORDS: [16]Coord = [
    Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 },
    Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 },
    Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 },
    Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 }, Coord{ e: 0, x: 0, y: 0 },
];

// Python line 24: def indent(level: int) -> str. "    " * level cannot be
// written in .t27 (no string repetition), so the levels the generator can
// reach are spelled out; above level 2 the result clamps at the deepest
// string here. Negative levels are "" as in Python ("    " * -2 == "").
pub fn indent(level: i64) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    return "        ";
}

// Python lines 40-42 - the coordinates of the flat element with number e:
//   x = (2 * e + offset) % 32768, y = (2 * e + offset + 1) % 32768.
// The u16 wrap is load-bearing: the generated spec asserts that offset 32768
// folds back onto 0..1.
pub fn elem_xy(e: i64, offset: i64) -> Coord {
    return Coord{ e: e, x: (2 * e + offset) % 32768, y: (2 * e + offset + 1) % 32768 };
}

// Python lines 28-58 - the recursive literal builder. The recursion only
// threads `base` through the row-major element order, so a flat walk makes
// the same decisions without the call stack: element number e carries
// elem_xy(e, offset) and next_base is base + product(shape).
pub fn build_tree(shape: []const i64, base: i64, offset: i64) -> TreePlan {
    var count: i64 = 1;
    for d in shape {
        count = count * d;
    }
    const end: i64 = base + count;
    var plan: TreePlan = TreePlan{ next_base: end, count: count, filled: 0, elems: ZERO_COORDS };
    var e: i64 = base;
    var n: usize = 0;
    while (e < end) {
        if (n >= TREE_CAP) {
            break;
        }
        plan.elems[n] = elem_xy(e, offset);
        n += 1;
        e += 1;
    }
    plan.filled = n;
    return plan;
}

// Python lines 135-136 - generate()'s guard: raise ValueError unless every
// byte of the assembled text is ASCII. The verdict is ported; the raise is
// the caller's job.
pub fn text_is_ascii(text: []const u8) -> bool {
    for c in text {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Python lines 61-141 - generate() writes the assembled text to DST; the
// write stays with the caller, so no test calls this stub.
pub fn generate() {
    undefined;
}

test indent_levels {
    assert(indent(-3) == "");
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
}

test elem_xy_formula_and_wrap {
    const a = elem_xy(0, 0);
    assert(a.e == 0);
    assert(a.x == 0);
    assert(a.y == 1);
    const b = elem_xy(5, 7);
    assert(b.x == 17);
    assert(b.y == 18);
    // 2*e + offset + 1 == 32768: the y coordinate folds to 0.
    const w = elem_xy(16383, 1);
    assert(w.x == 32767);
    assert(w.y == 0);
    // 2*e == 32768: the x coordinate folds to 0, y to 1.
    const w2 = elem_xy(16384, 0);
    assert(w2.x == 0);
    assert(w2.y == 1);
}

test build_tree_flat_leaf {
    var flat: [1]i64 = [3];
    const p = build_tree(&flat, 5, 7);
    assert(p.count == 3);
    assert(p.next_base == 8);
    assert(p.filled == 3);
    assert(p.elems[0].e == 5);
    assert(p.elems[0].x == 17);
    assert(p.elems[0].y == 18);
    assert(p.elems[2].e == 7);
    assert(p.elems[2].x == 21);
    assert(p.elems[2].y == 22);
}

test build_tree_nested_threads_base {
    var nest: [2]i64 = [2, 2];
    const p = build_tree(&nest, 100, 0);
    assert(p.count == 4);
    assert(p.next_base == 104);
    assert(p.elems[0].e == 100);
    assert(p.elems[0].x == 200);
    assert(p.elems[0].y == 201);
    assert(p.elems[3].e == 103);
    assert(p.elems[3].x == 206);
    assert(p.elems[3].y == 207);
}

test build_tree_bench_shape {
    var shape: [7]i64 = [273, 2, 2, 2, 2, 2, 2];
    const p = build_tree(&shape, 0, 0);
    assert(p.count == 17472);
    assert(p.next_base == 17472);
    assert(p.filled == 16);
    assert(p.elems[0].x == 0);
    assert(p.elems[0].y == 1);
    assert(p.elems[15].x == 30);
    assert(p.elems[15].y == 31);
}

test generate_constants {
    // Each constant against the value the original computes for it. The
    // comparison runs through runtime memory so the harness executes it
    // instead of folding it away.
    var c: [11]i64 = [OUTER, TOTAL, LAST_IDX, MID_IDX, LAST_X, LAST_Y, MID_E, MID_X, MID_Y, WRAP_LAST_X, WRAP_LAST_Y];
    var want: [11]i64 = [273, 17472, 272, 136, 2174, 2175, 8736, 17472, 17473, 2174, 2175];
    var i: usize = 0;
    while (i < 11) {
        assert(c[i] == want[i]);
        i += 1;
    }
}

test ascii_guard {
    assert(text_is_ascii("pub struct Pt { x : i16, y : i16 }"));
    assert(text_is_ascii("make_grid(32768)[272][1][1][1][1][1][1].x\n"));
    var non_ascii: [3]u8 = [80, 200, 116];
    assert(!text_is_ascii(&non_ascii));
}
