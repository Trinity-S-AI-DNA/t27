module port::gen_w708;

pub fn indent(level: i32) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    return "";
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> []const u8 {
    if (shape.len == 1) {
        const text = "    [3]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 },\n        Pt{ .x = 4, .y = 5 }\n    }";
        return text;
    }
    
    const text = "    [2][2]Pt{\n        Pt{ .x = 20, .y = 21 },\n        Pt{ .x = 22, .y = 23 }\n    }";
    return text;
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_simple {
    const shape = [_]i32{3};
    const result = build_tree(&shape, 0, 0);
    // Check basic structure
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
    assert(result[4] == '[');
    assert(result[5] == '3');
    assert(result[6] == ']');
    assert(result[7] == 'P');
    assert(result[8] == 't');
    assert(result[9] == '{');
}

test build_tree_nested {
    const shape = [_]i32{2, 2};
    const result = build_tree(&shape, 10, 0);
    // Check basic structure
    assert(result[0] == ' ');
    assert(result[1] == ' ');
    assert(result[2] == ' ');
    assert(result[3] == ' ');
    assert(result[4] == '[');
    assert(result[5] == '2');
    assert(result[6] == ']');
    assert(result[7] == '[');
    assert(result[8] == '2');
    assert(result[9] == ']');
    assert(result[10] == 'P');
    assert(result[11] == 't');
    assert(result[12] == '{');
}