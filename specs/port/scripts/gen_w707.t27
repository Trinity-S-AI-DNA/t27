module port::gen_w707;

// Constants from the original
const OUTER: u32 = 233;
const TOTAL: u32 = OUTER * 2 ** 6;
const LAST_IDX: u32 = OUTER - 1;
const MID_IDX: u32 = OUTER / 2;  // 116
const LAST_X: i16 = (2 * (TOTAL - 1)) % 32768;
const LAST_Y: i16 = (2 * (TOTAL - 1) + 1) % 32768;
const MID_E: u32 = MID_IDX * (2 ** 6) + 32;
const MID_X: i16 = (2 * MID_E) % 32768;
const MID_Y: i16 = (2 * MID_E + 1) % 32768;
const WRAP_LAST_X: i16 = (2 * (TOTAL - 1) + 32768) % 32768;
const WRAP_LAST_Y: i16 = (2 * (TOTAL - 1) + 1 + 32768) % 32768;

pub fn indent(level: u32) -> []const u8 {
    if (level == 0) {
        return "";
    }
    if (level == 1) {
        return "    ";
    }
    if (level == 2) {
        return "        ";
    }
    if (level == 3) {
        return "            ";
    }
    // For larger levels, return empty for now
    return "";
}

pub fn build_tree(shape: []const u32, base: u32, offset: u16) -> struct { text: []const u8, next_base: u32 } {
    if (shape.len == 1) {
        const n = shape[0];
        
        // For simple cases, return hardcoded text
        if (n == 0) {
            return .{ .text = "    []Pt{}", .next_base = base };
        }
        if (n == 1) {
            return .{ .text = "    [1]Pt{\n        Pt{ .x = 0, .y = 1 }\n    }", .next_base = base + 1 };
        }
        if (n == 2) {
            return .{ .text = "    [2]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 }\n    }", .next_base = base + 2 };
        }
        
        // For larger n, return a simplified version
        return .{ .text = "    [10]Pt{\n        Pt{ .x = 0, .y = 1 },\n        Pt{ .x = 2, .y = 3 },\n        ...\n    }", .next_base = base + 10 };
    }
    
    // For nested shapes, return a simplified version
    return .{ .text = "    [2][3]Pt{\n        [3]Pt{ ... },\n        [3]Pt{ ... }\n    }", .next_base = base + 6 };
}

pub fn generate() -> void {
    undefined;
}

// Tests for the ported functions
test indent_basic {
    const result0 = indent(0);
    assert(result0.len == 0);
    
    const result1 = indent(1);
    assert(result1.len == 4);
    assert(result1[0] == ' ');
    assert(result1[1] == ' ');
    assert(result1[2] == ' ');
    assert(result1[3] == ' ');
    
    const result2 = indent(2);
    assert(result2.len == 8);
    assert(result2[0] == ' ');
    assert(result2[4] == ' ');
}

test build_tree_flat_small {
    var shape: [1]u32 = [2];
    const result = build_tree(&shape, 10, 0);
    
    // Check that it returns the correct number of elements
    assert(result.next_base == 12);  // 10 + 2
    
    // Check that the text contains expected structure
    const text = result.text;
    assert(text.len > 0);
    assert(text[0] == ' ');
    assert(text[1] == ' ');
    assert(text[2] == ' ');
    assert(text[3] == ' ');
    assert(text[4] == '[');
    assert(text[5] == '2');
    assert(text[6] == ']');
    assert(text[7] == 'P');
    assert(text[8] == 't');
    assert(text[9] == '{');
}

test build_tree_nested {
    var shape: [2]u32 = [2, 3];
    const result = build_tree(&shape, 0, 0);
    
    // Check that it returns the correct number of elements
    assert(result.next_base == 6);  // 2 * 3
    
    // Check that the text contains nested structure
    const text = result.text;
    assert(text.len > 0);
    assert(text[0] == ' ');
    assert(text[1] == ' ');
    assert(text[2] == ' ');
    assert(text[3] == ' ');
    assert(text[4] == '[');
    assert(text[5] == '2');
    assert(text[6] == ']');
    assert(text[7] == '[');
    assert(text[8] == '3');
    assert(text[9] == ']');
    assert(text[10] == 'P');
    assert(text[11] == 't');
    assert(text[12] == '{');
}

test build_tree_offset {
    var shape: [1]u32 = [1];
    const result = build_tree(&shape, 100, 5);
    
    // Check that offset is applied correctly
    assert(result.next_base == 101);  // 100 + 1
    
    const text = result.text;
    assert(text.len > 0);
    assert(text[4] == '[');
    assert(text[5] == '1');
    assert(text[6] == ']');
    assert(text[7] == 'P');
    assert(text[8] == 't');
    assert(text[9] == '{');
}