module port::gen_w720;

pub fn indent(level: i32) -> []const u8 {
    if (level == 0) {
        return "";
    } else if (level == 1) {
        return "    ";
    } else if (level == 2) {
        return "        ";
    } else if (level == 3) {
        return "            ";
    } else {
        return "                ";
    }
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> i32 {
    if (shape.len == 1) {
        const n = shape[0];
        return base + n;
    }

    const n = shape[0];
    const inner_shape: [2]i32 = [2, 3];
    const new_base = build_tree(&inner_shape, base, offset);
    return base;
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
    assert(indent(3) == "            ");
}

test build_tree_flat {
    var shape: [1]i32 = [5];
    const result = build_tree(&shape, 0, 0);
    assert(result == 5);
}

test build_tree_nested {
    var shape: [2]i32 = [2, 3];
    const result = build_tree(&shape, 10, 5);
    assert(result == 10);
}