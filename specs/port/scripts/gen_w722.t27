module port::gen_w722;

pub fn indent(level: i32) -> []const u8 {
    if (level <= 0) {
        return "";
    }
    var result: [20]u8 = undefined;
    for (0..level * 4) |i| {
        result[i] = ' ';
    }
    return result[0..level * 4];
}

pub fn build_tree(shape: []const i32, base: i32, offset: i32) -> ([]const u8, i32) {
    if (shape.len == 1) {
        const n = shape[0];
        var buffer: [100]u8 = undefined;
        var pos: usize = 0;
        
        // Add first line: [n]Pt{
        const indent1 = indent(1);
        for (0..indent1.len) |j| {
            buffer[pos + j] = indent1[j];
        }
        pos += indent1.len;
        buffer[pos] = '[';
        pos += 1;
        buffer[pos] = '0' + @intCast(u8, n % 10);
        pos += 1;
        buffer[pos] = ']';
        pos += 1;
        buffer[pos] = 'P';
        pos += 1;
        buffer[pos] = 't';
        pos += 1;
        buffer[pos] = '{';
        pos += 1;
        
        // Add entries
        for (0..n) |i| {
            if (i > 0) {
                buffer[pos] = ',';
                pos += 1;
                buffer[pos] = '\n';
                pos += 1;
            }
            
            const e = base + i;
            const x = (2 * e + offset) % 32768;
            const y = (2 * e + offset + 1) % 32768;
            
            // Add indented entry: Pt{ .x = x, .y = y }
            const indent2 = indent(2);
            for (0..indent2.len) |j| {
                buffer[pos + j] = indent2[j];
            }
            pos += indent2.len;
            
            buffer[pos] = 'P';
            pos += 1;
            buffer[pos] = 't';
            pos += 1;
            buffer[pos] = '{';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '.';
            pos += 1;
            buffer[pos] = 'x';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '=';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '0' + @intCast(u8, x % 10);
            pos += 1;
            buffer[pos] = ',';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '.';
            pos += 1;
            buffer[pos] = 'y';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '=';
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '0' + @intCast(u8, y % 10);
            pos += 1;
            buffer[pos] = ' ';
            pos += 1;
            buffer[pos] = '}';
            pos += 1;
            buffer[pos] = '}';
            pos += 1;
        }
        
        // Add closing brace
        buffer[pos] = '\n';
        pos += 1;
        const indent1_end = indent(1);
        for (0..indent1_end.len) |j| {
            buffer[pos + j] = indent1_end[j];
        }
        pos += indent1_end.len;
        buffer[pos] = '}';
        pos += 1;
        
        return buffer[0..pos], base + n;
    }
    
    // Multi-dimensional case - return simple structure
    const n = shape[0];
    var buffer: [100]u8 = undefined;
    var pos: usize = 0;
    
    buffer[pos] = '[';
    pos += 1;
    buffer[pos] = '0' + @intCast(u8, n % 10);
    pos += 1;
    buffer[pos] = ']';
    pos += 1;
    buffer[pos] = 'P';
    pos += 1;
    buffer[pos] = 't';
    pos += 1;
    buffer[pos] = '{';
    pos += 1;
    
    for (0..n) |i| {
        if (i > 0) {
            buffer[pos] = ',';
            pos += 1;
        }
        
        buffer[pos] = 'P';
        pos += 1;
        buffer[pos] = 't';
        pos += 1;
        buffer[pos] = '{';
        pos += 1;
        buffer[pos] = '.';
        pos += 1;
        buffer[pos] = 'x';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '=';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '0';
        pos += 1;
        buffer[pos] = ',';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '.';
        pos += 1;
        buffer[pos] = 'y';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '=';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '1';
        pos += 1;
        buffer[pos] = ' ';
        pos += 1;
        buffer[pos] = '}';
        pos += 1;
        buffer[pos] = '}';
        pos += 1;
    }
    
    buffer[pos] = '}';
    pos += 1;
    
    return buffer[0..pos], base + n;
}

pub fn generate() -> void {
    undefined;
}

test indent_basic {
    assert(indent(0) == "");
    assert(indent(1) == "    ");
    assert(indent(2) == "        ");
}

test build_tree_1d {
    const shape = [3];
    const result, next_base = build_tree(&shape, 0, 0);
    assert(next_base == 3);
    const result_str = result;
    assert(result_str.len > 0);
}

test build_tree_2d {
    const shape = [2, 2];
    const result, next_base = build_tree(&shape, 0, 0);
    assert(next_base == 4);
    const result_str = result;
    assert(result_str.len > 0);
}

test build_tree_offset {
    const shape = [2];
    const result, next_base = build_tree(&shape, 5, 10);
    assert(next_base == 7);
    const result_str = result;
    assert(result_str.len > 0);
}