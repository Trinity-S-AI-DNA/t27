// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/scripts/gen_w730.t27
// Port of scripts/gen_w730.py to t27

// Generate specs/scratch/w730_bench_module_279x2p6_aos_var_call_write.t27:
// a 279 x 2^6 array-of-structs benchmark module of 17856 Pt entries, where
// element e gets x = (2 * e + offset) % 32768 and y = x + 1. The original
// walks the shape [279, 2, 2, 2, 2, 2, 2] recursively and assembles the
// module as text.
//
// WHAT THIS PORT DELIBERATELY DOES NOT CONTAIN
//
// The text and the file. The original builds the module out of f-strings,
// "    " * level, "\n".join and string concatenation, ASCII-checks it,
// writes it to specs/scratch/, and prints a byte count. None of that
// compiles in .t27 today (no string repetition, no join or concatenation,
// no file output), and none of it decides - it moves bytes. What decided
// is here, and every test asserts one of these decisions:
//
// - indent: four spaces per level, the unit the generated lines are built from
// - coord_x / coord_y: the entry formula every Pt entry obeys, with its 32768 wrap
// - shape_total: how far `base` advances across a whole shape
// - build_tree: the integer facts its (text, next_base) tuple carries
// - is_ascii: the one gate generate applies before writing

module port::scripts::gen_w730;

// Lines 9-21 of the original. The relations between them are re-asserted in
// test module_constants rather than trusted to comptime arithmetic.
const OUTER: i64 = 279;
const TOTAL: i64 = 17856;   // OUTER * 2 ** 6
const LAST_IDX: i64 = 278;  // OUTER - 1
const MID_IDX: i64 = 139;   // OUTER // 2
const LAST_E: i64 = 17855;  // TOTAL - 1: the last element number at base 0
const MID_E: i64 = 8928;    // MID_IDX * 2 ** 6 + 32 (original lines 16-17)

// Lines 24-25: def indent(level: int) -> str: return "    " * level.
// Four spaces per level, written into `out`; exact for levels 0..12, which
// covers every level the original asks for (1 and 2 only).
pub fn indent(level: i64, out: []u8) -> []const u8 {
    var i: usize = 0;
    const n: usize = (level * 4) as usize;
    while (i < n and i < out.len) {
        out[i] = ' ';
        i += 1;
    }
    return out[0..i];
}

// The entry formula the leaf case bakes into every Pt entry (lines 35-37):
// element e gets x = (2 * e + offset) % 32768 and y = x + 1. This is the
// formula the generated make_grid uses and the original's own constants
// (lines 14-21) are its answers.
pub fn coord_x(e: i64, offset: i64) -> i64 {
    return (2 * e + offset) % 32768;
}

pub fn coord_y(e: i64, offset: i64) -> i64 {
    return (2 * e + offset + 1) % 32768;
}

// build_tree, lines 28-58: a leaf of n = shape[0] entries advances base by
// n (line 42: base + n); an inner node recurses into shape[1:] once per
// child and returns whatever the children left base at. Either way the
// advance is the product of the dimensions.
pub fn shape_total(shape: []const i64) -> i64 {
    var total: i64 = 1;
    for d in shape {
        total = total * d;
    }
    return total;
}

// The integer facts build_tree's recursion decides, in place of the
// (text, next_base) tuple the Python returns: entries number from `base` in
// document order, the caller's next sibling starts at `next_base`, and the
// first entry shows the entry formula applied to element number `base`.
struct TreePlan {
    next_base: i64,
    first_e: i64,
    first_x: i64,
    first_y: i64,
}

// Line 28: def build_tree(shape: list[int], base: int, offset: int) ->
// tuple[str, int]. The text half is string assembly and does not compile in
// .t27 today; the facts the text encodes are what this returns.
pub fn build_tree(shape: []const i64, base: i64, offset: i64) -> TreePlan {
    return TreePlan {
        next_base: base + shape_total(shape),
        first_e: base,
        first_x: coord_x(base, offset),
        first_y: coord_y(base, offset),
    };
}

// generate's one pure gate (line 135):
//   if not all(ord(ch) < 128 for ch in text): raise ValueError(...)
// The emitted module must be pure ASCII before it may be written.
pub fn is_ascii(text: []const u8) -> bool {
    for c in text {
        if (c >= 128) {
            return false;
        }
    }
    return true;
}

// Line 61: def generate() -> None. Plumbing: it assembles the module text
// (not expressible here) and writes it to
// specs/scratch/w730_bench_module_279x2p6_aos_var_call_write.t27, then
// prints a byte count. No test calls it.
pub fn generate() {
    undefined;
}

test indent_levels {
    var buf: [48]u8 = undefined;
    assert(indent(0, &buf) == "");
    assert(indent(1, &buf) == "    ");
    assert(indent(2, &buf) == "        ");
    assert(indent(5, &buf) == "                    ");
}

test shape_total_products {
    var leaf: [1]i64 = [64];
    assert(shape_total(&leaf) == 64);
    var full: [7]i64 = [279, 2, 2, 2, 2, 2, 2];
    assert(shape_total(&full) == 17856);
    var single: [1]i64 = [1];
    assert(shape_total(&single) == 1);
}

test entry_formula {
    // The original's own constants (lines 14-19) are the formula's answers,
    // and the footer of the generated module asserts the first entry.
    assert(coord_x(0, 0) == 0);
    assert(coord_y(0, 0) == 1);
    assert(coord_x(LAST_E, 0) == 2942);   // LAST_X
    assert(coord_y(LAST_E, 0) == 2943);   // LAST_Y
    assert(coord_x(MID_E, 0) == 17856);   // MID_X
    assert(coord_y(MID_E, 0) == 17857);   // MID_Y
}

test entry_formula_wraps {
    // Lines 20-21 (WRAP_LAST_X / WRAP_LAST_Y) and the footer's explicit
    // modulo-wrap check: an offset of 32768 folds back onto offset 0.
    assert(coord_x(0, 32768) == 0);
    assert(coord_y(0, 32768) == 1);
    assert(coord_x(LAST_E, 32768) == 2942);   // WRAP_LAST_X
    assert(coord_y(LAST_E, 32768) == 2943);   // WRAP_LAST_Y
    assert(coord_x(MID_E, 32768) == 17856);
    assert(coord_y(MID_E, 32768) == 17857);
}

test build_tree_threads_base {
    // The whole grid from base 0: TOTAL elements, and the first entry is
    // element 0 at .x = 0, .y = 1 - the values the generated module's
    // footer asserts for dst[0][0][0][0][0][0][0].
    var full: [7]i64 = [279, 2, 2, 2, 2, 2, 2];
    const grid = build_tree(&full, 0, 0);
    assert(grid.next_base == TOTAL);
    assert(grid.first_e == 0);
    assert(grid.first_x == 0);
    assert(grid.first_y == 1);

    // The leaf holding the mid element starts at MID_IDX * 2 ** 6 (lines
    // 16-17) and hands the next leaf a base of 8960.
    var leaf: [1]i64 = [64];
    const mid_leaf = build_tree(&leaf, MID_IDX * 64, 0);
    assert(mid_leaf.next_base == 8960);
    assert(mid_leaf.first_e == 8896);
    assert(mid_leaf.first_x == 17792);
    assert(mid_leaf.first_y == 17793);
}

test build_tree_offset {
    // The offset the caller passes shifts every entry (line 36): leaf [4]
    // from base 10 with offset 5 starts at (2*10 + 5) % 32768 = 25.
    var leaf: [1]i64 = [4];
    const p = build_tree(&leaf, 10, 5);
    assert(p.next_base == 14);
    assert(p.first_e == 10);
    assert(p.first_x == 25);
    assert(p.first_y == 26);
}

test module_constants {
    // The relations the original derives, lines 9-21.
    var outer: i64 = OUTER;
    var total: i64 = TOTAL;
    var mid_idx: i64 = MID_IDX;
    var mid_e: i64 = MID_E;
    var last_e: i64 = LAST_E;
    assert(total == outer * 64);
    assert(64 == 2 * 2 * 2 * 2 * 2 * 2);
    assert(LAST_IDX == outer - 1);
    assert(mid_idx == @divTrunc(outer, 2));
    assert(mid_e == mid_idx * 64 + 32);
    assert(last_e == total - 1);
}

test ascii_gate {
    // generate() refuses non-ASCII text (line 135 raises ValueError before
    // any write happens).
    assert(is_ascii(""));
    assert(is_ascii("module w730_bench_module_279x2p6_aos_var_call_write"));
    assert(is_ascii("pub fn make_grid(offset : u16) -> [279][2][2][2][2][2][2]Pt {"));
    var bad: [8]u8 = undefined;
    bad[0] = 80;   // 'P'
    bad[1] = 116;  // 't'
    bad[2] = 233;  // 0xE9 - not ASCII
    bad[3] = 125;  // '}'
    assert(!is_ascii(bad[0..4]));
    assert(is_ascii(bad[0..2]));
}
