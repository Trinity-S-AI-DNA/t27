// t27/specs/port/trinity/hardware/rtl-root/d_bank13_test.t27
// Port from gHashTag/trinity hardware/rtl-root/d_bank13_test.v (8 lines, 1 module)
// Same bank (13) routing test: module trinity_top, input clk, output led
// Original: assign led = clk; -- a direct connection, the output wire mirrors the input
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    // These represent the Verilog module ports:
    //   input  wire clk,
    //   output wire led

    pub struct Inputs {
        clk: bool,
    }

    pub struct Outputs {
        led: bool,
    }

    // === Core functionality ===
    // This represents the Verilog `assign led = clk;  // Direct connection`
    // The output wire is wired straight to the input wire: led always
    // carries the same value clk carries, with no logic in between.
    pub fn connect_direct(clk: bool) -> bool {
        return clk;
    }

    // === Interface functions ===
    // The module's behaviour for the given inputs: led equals clk, always.
    pub fn compute_outputs(inputs: Inputs) -> Outputs {
        return Outputs{
            .led = connect_direct(inputs.clk),
        };
    }

    // Data surface lowered to Verilog: `on_comb`'s parameter becomes the
    // module's data input port and its return becomes the `result` output.
    // The original drives one 1-bit output wire, so the result is 1 bit.
    pub fn on_comb(clk: bool) -> bool {
        return connect_direct(clk);
    }

    // === Test cases ===
    // A direct connection: whatever value clk holds, led holds the same.

    test led_mirrors_clk_low {
        const inputs = Inputs{ .clk = false };
        assert(compute_outputs(inputs).led == false);
    }

    test led_mirrors_clk_high {
        const inputs = Inputs{ .clk = true };
        assert(compute_outputs(inputs).led == true);
    }

    test led_matches_clk_in_both_states {
        const low = Inputs{ .clk = false };
        assert(compute_outputs(low).led == false);
        assert(low.clk == false);
        const high = Inputs{ .clk = true };
        assert(compute_outputs(high).led == true);
        assert(high.clk == true);
    }

    test direct_connection_identity {
        assert(connect_direct(false) == false);
        assert(connect_direct(true) == true);
    }

    test result_carries_the_connection {
        assert(on_comb(false) == false);
        assert(on_comb(true) == true);
    }

    // === Invariants ===
    // The output can never differ from the input: they are the same wire.

    invariant led_equals_clk {
        assert(connect_direct(true) == true);
        assert(connect_direct(false) == false);
    }

    invariant output_mirrors_input {
        const low = Inputs{ .clk = false };
        assert(compute_outputs(low).led == false);
        const high = Inputs{ .clk = true };
        assert(compute_outputs(high).led == true);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
