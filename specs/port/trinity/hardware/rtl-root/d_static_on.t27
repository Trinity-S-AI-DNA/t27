// t27/specs/port/trinity/hardware/rtl-root/d_static_on.t27
// Static ON module - Port from gHashTag/trinity hardware/rtl-root/d_static_on.v
// Simple module that outputs a constant 0 to LED (active-low = ON) regardless of clock input
// Original Verilog: assign led = 1'b0;  // Active-low = ON
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Core functionality ===
    // This represents the Verilog `assign led = 1'b0;`
    // The LED is always driven to 0 (active-low, so 0 means ON)
    pub fn static_on_led() -> bool {
        return false;
    }

    // === Interface functions ===
    // These represent the module's behavior with the standard interface
    pub fn compute_ready() -> bool {
        return true;
    }

    // === Test cases ===
    // Test that the LED function always returns false (ON)
    test led_always_on {
        assert(static_on_led() == false);
    }

    test led_always_on_consistent {
        // Verify LED function always returns false regardless of inputs
        assert(static_on_led() == false);
    }

    test ready_signal {
        // Verify the ready signal is always high
        assert(compute_ready() == true);
    }

    // === Invariants ===
    // Verify the core function always returns false (LED always ON)
    invariant led_always_on {
        assert(static_on_led() == false);
    }

    invariant ready_always_high {
        assert(compute_ready() == true);
    }

}

// phi^2 + 1/phi^2 = 3 | TRINITY