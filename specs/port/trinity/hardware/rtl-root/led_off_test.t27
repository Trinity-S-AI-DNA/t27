// t27/specs/port/trinity/hardware/rtl-root/led_off_test.t27
// LED OFF test - led = 1 means LED OFF (active-low)
// Port of gHashTag/trinity hardware/rtl-root/led_off_test.v
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // Module ports
    pub struct Ports {
        clk : bool,
        led : bool,
    }

    // LED control function
    fn compute_led(clk: bool) -> bool {
        // LED OFF test - led = 1 means LED OFF (active-low)
        // Always return 1 (LED OFF regardless of clock)
        return true;
    }

    // Test function for LED output
    fn get_led_output(ports: Ports) -> bool {
        return compute_led(ports.clk);
    }

    // === Tests ===

    test led_off_always
        given ports = Ports{ .clk = false, .led = false }
        then get_led_output(ports) == true

    test led_off_with_clk_high
        given ports = Ports{ .clk = true, .led = false }
        then get_led_output(ports) == true

    test led_off_with_clk_low
        given ports = Ports{ .clk = false, .led = false }
        then get_led_output(ports) == true

    test compute_led_direct
        then compute_led(true) == true
        and compute_led(false) == true

    // === Invariants ===

    invariant led_always_off
        given ports = Ports{ .clk = true, .led = false }
        assert get_led_output(ports) == true

    invariant led_constant_value
        then compute_led(true) == compute_led(false)
}