// t27/specs/port/trinity/hardware/rtl-root/d_simple_led.t27
// Port from gHashTag/trinity hardware/rtl-root/d_simple_led.v (7 lines, 1 module)
// Simple LED driver: module trinity_top, input clk, output led
// Original: assign led = 1'b0; -- ON for active-low, so the LED is constantly ON
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    // These represent the Verilog module ports:
    //   input  wire clk,
    //   output wire led

    pub struct Inputs {
        clk: bool,
    }

    pub struct Outputs {
        led: bool,
    }

    // === Core functionality ===
    // This represents the Verilog `assign led = 1'b0;  // ON for active-low`
    // The output is the constant 0: active-low wiring turns 0 into a lit LED.
    pub fn constant_zero() -> bool {
        return false;
    }

    // === Interface function ===
    // The module's behavior for the given inputs: led never depends on clk.
    pub fn compute_outputs(inputs: Inputs) -> Outputs {
        return Outputs{
            .led = constant_zero(),
        };
    }

    // === Tests ===
    // The LED is always 0 (active-low ON), whatever the clock input is.

    test led_always_low_without_clk {
        const inputs = Inputs{ .clk = false };
        assert(compute_outputs(inputs).led == false);
    }

    test led_always_low_with_clk {
        const inputs = Inputs{ .clk = true };
        assert(compute_outputs(inputs).led == false);
    }

    test led_always_low_for_both_clock_states {
        const inputs1 = Inputs{ .clk = false };
        assert(compute_outputs(inputs1).led == false);
        const inputs2 = Inputs{ .clk = true };
        assert(compute_outputs(inputs2).led == false);
    }

    test core_function_is_constant_zero {
        assert(constant_zero() == false);
    }

    // === Invariants ===
    // The LED can never be 1: the original assigns the constant 1'b0.

    invariant led_never_high {
        assert(constant_zero() == false);
    }

    invariant output_led_always_low {
        const inputs1 = Inputs{ .clk = false };
        assert(compute_outputs(inputs1).led == false);
        const inputs2 = Inputs{ .clk = true };
        assert(compute_outputs(inputs2).led == false);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
