// t27/specs/port/trinity/hardware/rtl-root/d_static_one.t27
// Static 1 test - Port from gHashTag/trinity hardware/rtl-root/d_static_one.v
// Simple module that outputs a constant 1 to LED regardless of clock input
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===
    // These represent the Verilog module ports
    pub struct Inputs {
        clk: bool,
    }

    pub struct Outputs {
        led: bool,
    }

    // === Core functionality ===
    // This represents the Verilog `assign led = 1'b1;`
    pub fn static_one() -> bool {
        return true;
    }

    // === Interface functions ===
    // These represent the module's behavior with the given inputs
    pub fn compute_outputs(inputs: Inputs) -> Outputs {
        return Outputs{
            .led = static_one(),
        };
    }

    // === Test cases ===
    // Test that the LED is always 1 regardless of clock input
    test led_always_high {
        const inputs = Inputs{ .clk = false };
        assert(compute_outputs(inputs).led == true);
    }

    test led_always_high_with_clk {
        const inputs = Inputs{ .clk = true };
        assert(compute_outputs(inputs).led == true);
    }

    test led_always_high_with_various_clock_values {
        const inputs1 = Inputs{ .clk = false };
        assert(compute_outputs(inputs1).led == true);
        const inputs2 = Inputs{ .clk = true };
        assert(compute_outputs(inputs2).led == true);
    }

    // === Invariants ===
    // Verify the core function always returns true
    invariant static_one_always_true {
        assert(static_one() == true);
    }

    invariant output_led_always_true {
        const inputs1 = Inputs{ .clk = false };
        assert(compute_outputs(inputs1).led == true);
        const inputs2 = Inputs{ .clk = true };
        assert(compute_outputs(inputs2).led == true);
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY