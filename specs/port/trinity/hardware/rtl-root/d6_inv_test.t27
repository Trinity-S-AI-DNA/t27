// t27/specs/port/trinity/hardware/rtl-root/d6_inv_test.t27
// D6 Inverter Test Module - Port from gHashTag/trinity hardware/rtl-root/d6_inv_test.v
// Simple test module with inverted output logic
// Ports: clk input, led output (active-high)
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===

    pub struct ModuleInputs {
        clk : bool,
    }

    pub struct ModuleOutputs {
        led : bool,
    }

    // === Core logic functions ===

    fn compute_led_output(clk: bool) -> bool {
        // Test: active-high (1 = ON)
        // Original: assign led = 1'b1;
        return true;
    }

    fn create_outputs(inputs: ModuleInputs) -> ModuleOutputs {
        return ModuleOutputs{
            .led = compute_led_output(inputs.clk),
        };
    }

    // === Test helpers ===

    fn test_inputs() -> ModuleInputs {
        return ModuleInputs{
            .clk = true,
        };
    }

    fn test_inputs_clk_low() -> ModuleInputs {
        return ModuleInputs{
            .clk = false,
        };
    }

    // === Tests ===

    test led_always_high
        given inputs = test_inputs()
        then create_outputs(inputs).led == true

    test led_always_high_clk_low
        given inputs = test_inputs_clk_low()
        then create_outputs(inputs).led == true

    test compute_led_function
        then compute_led_output(true) == true
        and compute_led_output(false) == true

    // === Invariants ===

    invariant led_consistent
        given inputs = test_inputs()
        assert create_outputs(inputs).led == true

    invariant led_function_consistent
        assert compute_led_output(true) == true
        and compute_led_output(false) == true

}