// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/hardware/rtl-root/d_direct.t27
// Direct clock-to-LED connection for Trinity T27 FPGA
// Simple passthrough from clk input to led output
// phi^2 + 1/phi^2 = 3 | TRINITY

module trinity_top {

    // === Module interface ===

    pub struct ModuleInputs {
        clk : bool,
    }

    pub struct ModuleOutputs {
        led : bool,
    }

    // === Main computation function ===

    fn compute_outputs(inputs: ModuleInputs) -> ModuleOutputs {
        return ModuleOutputs{
            .led = inputs.clk,
        };
    }

    // === Test cases ===

    test clk_high_to_led_high
        given inputs = ModuleInputs{ .clk = true }
        then compute_outputs(inputs).led == true

    test clk_low_to_led_low
        given inputs = ModuleInputs{ .clk = false }
        then compute_outputs(inputs).led == false

    test clk_rising_edge_simulation
        given inputs1 = ModuleInputs{ .clk = false }
        given inputs2 = ModuleInputs{ .clk = true }
        then compute_outputs(inputs1).led == false
        and compute_outputs(inputs2).led == true

    // === Invariants ===

    invariant output_follows_input
        given inputs = ModuleInputs{ .clk = true }
        assert compute_outputs(inputs).led == inputs.clk

    invariant output_follows_input_low
        given inputs = ModuleInputs{ .clk = false }
        assert compute_outputs(inputs).led == inputs.clk

    // === Benchmarks ===

    bench compute_latency
        measure: nanoseconds to compute_outputs(ModuleInputs{ .clk = true })
        target: < 1ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY