// Port of gHashTag/trinity:hardware/rtl-root/d_lut_only.v (9 lines, 1 module).
//
// Original, quoted at ee512359254b:
//     // LUT-only blink (no flip-flops)
//     module trinity_top (
//         input  wire clk,
//         output wire led
//     );
//         // Direct LUT: LED = ~clk (inverter)
//         assign led = ~clk;
//     endmodule
//
// The one decision the original makes is the inverter: the LED shows the
// inverted clock, with no flip-flop anywhere. That decision is carried as
// the combinational surface below; `t27c gen-verilog` lowers it to a
// `module trinity_top (` whose data input is inverted on its way out.
//
// Name mapping (the Verilog backend fixes some port names):
//   original `input wire clk`  -> the `clk_in` parameter of `on_comb`
//                                 (the header's fixed `clk` clock port is
//                                 emitted by the backend itself, so the data
//                                 input cannot reuse that name);
//   original `output wire led` -> computed by the `led` function; the
//                                 backend emits the data output as `result`.
// The backend also adds fixed handshaking ports (rst_n, en, ready) that the
// original did not have. The LUT-only inverter itself is carried unchanged.

module trinity_top {
    // The decision: `assign led = ~clk;` -- a direct LUT inverter.
    pub fn led(clk_bit: bool) -> bool {
        return !clk_bit;
    }

    // The combinational entry point gen-verilog lowers to the data ports.
    pub fn on_comb(clk_in: bool) -> bool {
        return led(clk_in);
    }

    // LED = ~clk: clock low lights the LED, clock high puts it out.
    test led_inverts {
        assert(led(false) == true);
        assert(led(true) == false);
    }

    // The same inverter, seen at the module boundary.
    test on_comb_inverts {
        assert(on_comb(false) == true);
        assert(on_comb(true) == false);
    }
}
