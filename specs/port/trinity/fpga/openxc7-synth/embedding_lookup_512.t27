// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/embedding_lookup_512.t27
// EMBEDDING LOOKUP 512 — Expanded Vocabulary Ternary Embedding
// Port of gHashTag/trinity fpga/openxc7-synth/embedding_lookup_512.v
// Expands from 128 to 512 tokens using the 7 free BRAM36 on XC7A100T
// Memory budget: 512 x 243 = 124,416 entries x 2 bits = 248,832 bits
// BRAM allocation: ~7 BRAM36 (7 x 36,864 = 258,048 bits)
// Power-of-2 depth: 2^17 = 131,072 entries
// phi^2 + 1/phi^2 = 3 | TRINITY

module embedding_lookup_512 {

    // === Module parameters ===
    
    pub const VOCAB : u32 = 512;
    pub const DIM : u32 = 243;
    pub const DATA_WIDTH : u32 = 20;
    pub const ADDR_WIDTH : u32 = 17;   // 2^17 = 131072 >= 512*243 = 124416
    pub const TOK_WIDTH : u32 = 9;     // ceil(log2(512))
    pub const DIM_WIDTH : u32 = 8;     // ceil(log2(243))
    pub const MEM_FILE : &str = "fpga/weights/embedding_512_weights.mem";
    
    // === Memory constants ===
    
    pub const MEM_DEPTH : u32 = 1 << ADDR_WIDTH;  // 131072
    
    // === Ternary code enumeration ===
    
    pub const TernaryCode = enum(u8) {
        Zero = 0b00,    // 00 → 0
        PlusOne = 0b01, // 01 → +1  
        MinusOne = 0b10,// 10 → -1
        Invalid = 0b11  // 11 → 0 (invalid, treated as zero)
    }
    
    // === Test case structs ===
    
    pub struct TernaryTestCase {
        code : TernaryCode,
        expected : i32,
    }
    
    pub struct BaseAddressTestCase {
        token_id : u32,
        expected : u32,
    }
    
    // === State machine enumeration ===
    
    pub const State = enum {
        S_IDLE,
        S_CALC,
        S_PREFETCH,
        S_STREAM,
        S_LAST,
        S_DONE
    }
    
    // === Input/output structures ===
    
    pub struct Inputs {
        clk : bool,
        rst : bool,
        start : bool,
        token_id : u32,
    }
    
    pub struct Outputs {
        out_data : i32,
        out_addr : u32,
        out_valid : bool,
        done : bool,
        busy : bool,
    }
    
    // === Internal state structures ===
    
    pub struct MemoryState {
        emb_mem : [MEM_DEPTH]u8,  // 2-bit ternary codes stored as u8
        rd_addr : u32,
        code_r : u8,
    }
    
    pub struct CounterState {
        k_idx : u32,
        base_addr : u32,
        k_out_d1 : u32,
    }
    
    pub struct ControlState {
        state : State,
    }
    
    // === Memory initialization ===
    
    fn init_memory() -> MemoryState {
        var mem : [MEM_DEPTH]u8 = [_]u8{0} ** MEM_DEPTH;
        // In the original Verilog: initial $readmemb(MEM_FILE, emb_mem);
        // For T27, we'll initialize to zero - the actual memory file loading
        // would be handled by the Verilog generator
        return MemoryState{
            .emb_mem = mem,
            .rd_addr = 0,
            .code_r = 0,
        };
    }
    
    // === Ternary decoding function ===
    
    fn decode_ternary(code: TernaryCode) -> i32 {
        switch (code) {
            .PlusOne => 1,
            .MinusOne => -1,
            else => 0,
        }
    }
    
    // === Base address calculation function ===
    
    fn calculate_base_address(token_id: u32) -> u32 {
        var tok_ext : u32 = token_id;  // Zero-extended to ADDR_WIDTH bits
        // 243 = (tok<<8) - (tok<<4) + (tok<<2) - tok
        return (tok_ext << 8) - (tok_ext << 4) + (tok_ext << 2) - tok_ext;
    }
    
    // === Memory read function ===
    
    fn read_memory(mem: MemoryState, addr: u32) -> TernaryCode {
        var code_val : u8 = mem.emb_mem[addr];
        return @enumFromInt(code_val);
    }
    
    // === State machine step function ===
    
    fn step_state_machine(inputs: Inputs, mem: MemoryState, counters: CounterState, control: ControlState) -> (MemoryState, CounterState, ControlState, Outputs) {
        var outputs : Outputs = Outputs{
            .out_data = 0,
            .out_addr = 0,
            .out_valid = false,
            .done = false,
            .busy = false,
        };
        
        var mem_out : MemoryState = mem;
        var counters_out : CounterState = counters;
        var control_out : ControlState = control;
        
        if (inputs.rst) {
            // Reset state
            control_out.state = State.S_IDLE;
            counters_out.k_idx = 0;
            counters_out.base_addr = 0;
            counters_out.k_out_d1 = 0;
        } else {
            outputs.out_valid = false;
            outputs.done = false;
            
            // Simplified state machine - just handle idle state for now
            if (control.state == State.S_IDLE and inputs.start) {
                outputs.busy = true;
                counters_out.base_addr = calculate_base_address(inputs.token_id);
                counters_out.k_idx = 0;
                control_out.state = State.S_CALC;
            } else if (control.state == State.S_CALC) {
                mem_out.rd_addr = counters.base_addr;
                control_out.state = State.S_PREFETCH;
            } else if (control.state == State.S_PREFETCH) {
                counters_out.k_out_d1 = 0;
                counters_out.k_idx = 1;
                mem_out.rd_addr = counters.base_addr + 1;
                control_out.state = State.S_STREAM;
            }
        }
        
        return (mem_out, counters_out, control_out, outputs);
    }
    
    // === Complete embedding lookup function ===
    
    fn embedding_lookup(inputs: Inputs, mem: MemoryState) -> (Outputs, MemoryState) {
        var counters : CounterState = CounterState{
            .k_idx = 0,
            .base_addr = 0,
            .k_out_d1 = 0,
        };
        var control : ControlState = ControlState{
            .state = State.S_IDLE,
        };
        
        var (mem_out, counters_out, control_out, outputs) = step_state_machine(inputs, mem, counters, control);
        
        return (outputs, mem_out);
    }
    
    // === Test functions ===
    
    fn decode_ternary_test_cases() -> [4]TernaryTestCase {
        return [4]TernaryTestCase{
            .{ .code = TernaryCode.PlusOne, .expected = 1 },
            .{ .code = TernaryCode.MinusOne, .expected = -1 },
            .{ .code = TernaryCode.Zero, .expected = 0 },
            .{ .code = TernaryCode.Invalid, .expected = 0 },
        };
    }
    
    fn base_address_test_cases() -> [4]BaseAddressTestCase {
        return [4]BaseAddressTestCase{
            .{ .token_id = 0, .expected = 0 },
            .{ .token_id = 1, .expected = 243 },
            .{ .token_id = 2, .expected = 486 },
            .{ .token_id = 3, .expected = 729 },
        };
    }
    
    // === Tests ===
    
    test decode_ternary_plus_one
        given cases = decode_ternary_test_cases()
        then decode_ternary(cases[0].code) == 1

    test decode_ternary_minus_one
        given cases = decode_ternary_test_cases()
        then decode_ternary(cases[1].code) == -1

    test decode_ternary_zero
        given cases = decode_ternary_test_cases()
        then decode_ternary(cases[2].code) == 0

    test decode_ternary_invalid
        given cases = decode_ternary_test_cases()
        then decode_ternary(cases[3].code) == 0

    test base_address_zero
        given cases = base_address_test_cases()
        then calculate_base_address(cases[0].token_id) == 0

    test base_address_one
        given cases = base_address_test_cases()
        then calculate_base_address(cases[1].token_id) == 243

    test base_address_two
        given cases = base_address_test_cases()
        then calculate_base_address(cases[2].token_id) == 486

    test base_address_three
        given cases = base_address_test_cases()
        then calculate_base_address(cases[3].token_id) == 729

    test idle_state_no_start
        given inputs = Inputs{.clk = false, .rst = false, .start = false, .token_id = 0}
        given mem = init_memory()
        var (outputs, mem_out) = embedding_lookup(inputs, mem)
        then outputs.busy == false
        and outputs.done == false
        and outputs.out_valid == false

    test idle_state_with_start
        given inputs = Inputs{.clk = false, .rst = false, .start = true, .token_id = 1}
        given mem = init_memory()
        var (outputs, mem_out) = embedding_lookup(inputs, mem)
        then outputs.busy == true
        and outputs.done == false
        and outputs.out_valid == false

    test reset_behavior
        given inputs = Inputs{.clk = false, .rst = true, .start = true, .token_id = 1}
        given mem = init_memory()
        var (outputs, mem_out) = embedding_lookup(inputs, mem)
        then outputs.busy == false
        and outputs.done == false
        and outputs.out_valid == false

    

    test_parameter_constants
        then VOCAB == 512
        and DIM == 243
        and DATA_WIDTH == 20
        and ADDR_WIDTH == 17
        and TOK_WIDTH == 9
        and DIM_WIDTH == 8

    // === Invariants ===

    invariant ternary_codes_valid
        given code = TernaryCode.PlusOne
        assert decode_ternary(code) == 1 or decode_ternary(code) == -1 or decode_ternary(code) == 0

    invariant base_address_positive
        given token_id : u32 = 1
        assert calculate_base_address(token_id) > 0

    invariant memory_depth_power_of_two
        assert MEM_DEPTH > 0 and (MEM_DEPTH & (MEM_DEPTH - 1)) == 0

    invariant state_enum_count
        assert State.S_DONE > State.S_STREAM

    // === Benchmarks ===

    bench ternary_decode_latency
        measure: nanoseconds to decode_ternary(TernaryCode.PlusOne)
        target: < 10ns

    bench base_address_calc_latency
        measure: nanoseconds to calculate_base_address(42)
        target: < 20ns

    bench embedding_lookup_latency
        measure: nanoseconds to embedding_lookup(Inputs{.clk=false, .rst=false, .start=false, .token_id=0}, init_memory())
        target: < 100ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY