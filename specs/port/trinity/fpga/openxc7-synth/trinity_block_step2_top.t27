// Port of gHashTag/trinity fpga/openxc7-synth/trinity_block_step2_top.v
// (367 lines, as of ee512359254b) to T27. Roadmap stage 7: silicon.
//
// TRINITY BLOCK STEP 2 - MatVec1(243->729) + ReLU + MatVec2(729->243) + Self-Test
// Two-layer ternary MLP on FPGA:
//   matvec1(243->729) -> ReLU -> buffer[729] -> matvec2(729->243) -> verify
//
// Self-test at power-on:
//   - Input x[i] = i+1 (1..243)
//   - After matvec1: {-81, 162, -81} repeating
//   - After ReLU:    {0, 162, 0} repeating -> stored in buffer
//   - After matvec2: {-39366, 0, 39366} repeating (k_mod3 = 0,1,2)
//   - LED solid ON = PASSED
//
// phi^2 + 1/phi^2 = 3 = TRINITY
//
// The Verilog module's wires, registers and always blocks are plumbing; the
// decisions it encodes are ported below as pure functions:
//   - weight_sign / self_test_input / matvec1_result : stage 1, ternary matvec
//   - relu / buffer_value / layer1_buffer_values     : stage 2, ReLU -> buffer
//   - weight2_sign / matvec2_result_from             : stage 3, second matvec
//   - expected_val / advance_k_mod3 / self_test_pass / layer2_check_pass
//                                                    : streaming self-test
//   - next_state / state_bits                        : ST_* state machine
//   - led_state_next / led_counter_next / led_pin    : LED, active low
//   - uart_tx_bit_at / bit_at                        : UART TX framing
//   - report_frame_byte / build_report_frame         : 20-byte UART report
//   - on_comb (TopOutputs)                           : driven outputs led,
//     debug_state[1:0] and uart_tx (idle high) as a data port surface
//
// The submodules the original instantiates are I/O boundaries and are not
// faked: both ternary_matvec_bram instances stream their weight patterns
// from BRAM .mem files, ternary_activation and the 729-word relu_buffer are
// clocked plumbing (the mv1 address is delayed one cycle to align with the
// ReLU), and uart_rx drives nothing in the original logic. The weights here
// are recomputed from the generator pattern documented in the Verilog header.

module trinity_block_step2_top {
    // PARAMETERS (localparam block)
    pub const N1_IN: i32 = 243;
    pub const N1_OUT: i32 = 729;
    pub const N2_IN: i32 = 729;
    pub const N2_OUT: i32 = 243;
    pub const ACC_WIDTH: i32 = 20;

    // Internal power-on reset: rst holds for the first 255 clock cycles.
    pub const POR_CYCLES: u32 = 255;

    // ST_WAIT counts this many cycles before the self-test starts.
    pub const WAIT_CYCLES: u32 = 20;

    // UART TX: CLK_DIV clock cycles per bit.
    pub const CLK_DIV: u32 = 27;

    // While computing, the LED toggles every LED_BLINK_HALF cycles.
    pub const LED_BLINK_HALF: u32 = 6_250_000;

    // The first 8 final results are buffered for the UART report.
    pub const UART_RESULTS_LEN: i32 = 8;

    // 20-byte report frame: [0xAA][0xBB][0x44][pass][y0h][y0l]...[y7h][y7l].
    pub const FRAME_LEN: usize = 20;
    pub const FRAME_SYNC0: u8 = 0xAA;
    pub const FRAME_SYNC1: u8 = 0xBB;
    pub const FRAME_TYPE_STEP2: u8 = 0x44;  // step2 (two-layer) frame type

    // Self-test state machine
    // (ST_WAIT/ST_START1/ST_LAYER1/ST_START2/ST_LAYER2/ST_DONE).
    pub enum Step2State { Wait, Start1, Layer1, Start2, Layer2, Done, }

    // Power-on reset (255 clock cycles): rst is high while the counter runs.
    pub fn por_rst(counter: u32) -> bool {
        return counter < POR_CYCLES;
    }

    // ST_WAIT hands over to ST_START1 once the wait count is spent.
    pub fn start_after_wait(wait_cnt: u32) -> bool {
        return wait_cnt >= WAIT_CYCLES;
    }

    // 3-bit state encoding, as held in the st_state register.
    pub fn state_bits(s: Step2State) -> u8 {
        switch (s) {
            .Wait => 0,
            .Start1 => 1,
            .Layer1 => 2,
            .Start2 => 3,
            .Layer2 => 4,
            .Done => 5,
        }
    }

    // Self-test state machine transitions: ST_WAIT waits, ST_START1 raises
    // mv1_start for one cycle, ST_LAYER1 runs until relu_done (the buffer
    // fills via relu_valid), ST_START2 clears the verification registers and
    // raises mv2_start, ST_LAYER2 runs until mv2_done, ST_DONE holds.
    pub fn next_state(s: Step2State, wait_cnt: u32, relu_done: bool, mv2_done: bool) -> Step2State {
        switch (s) {
            .Wait => if (wait_cnt < WAIT_CYCLES) Step2State.Wait else Step2State.Start1,
            .Start1 => Step2State.Layer1,
            .Layer1 => if (relu_done) Step2State.Start2 else Step2State.Layer1,
            .Start2 => Step2State.Layer2,
            .Layer2 => if (mv2_done) Step2State.Done else Step2State.Layer2,
            .Done => Step2State.Done,
        }
    }

    // Self-test weights, layer 1 (243x729): +1 if (i+j)%3==0, -1 if
    // (i+j)%3==1, 0 else.
    pub fn weight_sign(i: i32, j: i32) -> i32 {
        const m: i32 = (i + j) % 3;
        if (m == 0) {
            return 1;
        }
        if (m == 1) {
            return -1;
        }
        return 0;
    }

    // Self-test weights, layer 2 (729x243): the same generator pattern, with
    // j the input index into the relu buffer and k the output index.
    pub fn weight2_sign(j: i32, k: i32) -> i32 {
        const m: i32 = (j + k) % 3;
        if (m == 0) {
            return 1;
        }
        if (m == 1) {
            return -1;
        }
        return 0;
    }

    // Self-test input: x[i] = i+1 (values 1..243).
    pub fn self_test_input(i: i32) -> i32 {
        return i + 1;
    }

    // Stage 1, ternary matvec: y1[j] = sum_i W1[j][i] * x[i]. The BRAM core
    // in the original streams this same pattern from its .mem file.
    pub fn matvec1_result(j: i32) -> i32 {
        var acc: i32 = 0;
        var i: i32 = 0;
        while (i < N1_IN) {
            acc += weight_sign(i, j) * self_test_input(i);
            i += 1;
        }
        return acc;
    }

    // Stage 2, ReLU activation.
    pub fn relu(v: i32) -> i32 {
        return if (v < 0) 0 else v;
    }

    // What ST_LAYER1 stores into relu_buffer[j]: the ReLU of the matvec1
    // stream.
    pub fn buffer_value(j: i32) -> i32 {
        return relu(matvec1_result(j));
    }

    // The 729-word relu buffer as ST_LAYER1 fills it.
    pub fn layer1_buffer_values() -> [729]i32 {
        var v: [729]i32 = [0; 729];
        var j: i32 = 0;
        while (j < N1_OUT) {
            v[j as usize] = buffer_value(j);
            j += 1;
        }
        return v;
    }

    // Stage 3, ternary matvec: y2[k] = sum_j W2[k][j] * buffer[j]. The
    // matvec2 instance reads the relu buffer through its external-x port.
    pub fn matvec2_result_from(buf: []const i32, k: i32) -> i32 {
        var acc: i32 = 0;
        var j: i32 = 0;
        while (j < N2_IN) {
            acc += weight2_sign(j, k) * buf[j as usize];
            j += 1;
        }
        return acc;
    }

    // Expected output of matvec2, as expected_val latches it per k_mod3:
    // {-39366, 0, 39366} repeating.
    pub fn expected_val(k_mod3: i32) -> i32 {
        if (k_mod3 == 0) {
            return -39366;
        }
        if (k_mod3 == 1) {
            return 0;
        }
        return 39366;
    }

    // k_mod3 advances 0 -> 1 -> 2 -> 0 per arriving result.
    pub fn advance_k_mod3(k_mod3: i32) -> i32 {
        return if (k_mod3 == 2) 0 else k_mod3 + 1;
    }

    // Only the first 8 final results are buffered into uart_results.
    pub fn captured_by_uart(k: i32) -> bool {
        return k < UART_RESULTS_LEN;
    }

    // Pass verdict: no streamed mismatch and all N2_OUT results checked.
    pub fn self_test_pass(verify_fail: bool, check_count: i32) -> bool {
        return !verify_fail && (check_count == N2_OUT);
    }

    // The whole ST_LAYER2 verification, run against the buffer ST_LAYER1
    // filled: every matvec2 result is compared against the expectation for
    // its k%3 class, and the machine passes only if all N2_OUT results
    // arrived and none mismatched.
    pub fn layer2_check_pass(buf: []const i32) -> bool {
        var verify_fail: bool = false;
        var check_count: i32 = 0;
        var k_mod3: i32 = 0;
        var k: i32 = 0;
        while (k < N2_OUT) {
            const got: i32 = matvec2_result_from(buf, k);
            if (got != expected_val(k_mod3)) {
                verify_fail = true;
            }
            k_mod3 = advance_k_mod3(k_mod3);
            check_count += 1;
            k += 1;
        }
        return self_test_pass(verify_fail, check_count);
    }

    // Next LED state: when done it holds self_test_pass (solid), while
    // computing it toggles every LED_BLINK_HALF cycles, otherwise it holds.
    pub fn led_state_next(st_done: bool, pass: bool, counter: u32, current: bool) -> bool {
        if (st_done) {
            return pass;
        }
        if (counter == LED_BLINK_HALF) {
            return !current;
        }
        return current;
    }

    // The blink counter reloads at the threshold unless the machine is done.
    pub fn led_counter_next(st_done: bool, counter: u32) -> u32 {
        if (!st_done && counter == LED_BLINK_HALF) {
            return 0;
        }
        return counter + 1;
    }

    // The LED pin is active low.
    pub fn led_pin(led_state: bool) -> bool {
        return !led_state;
    }

    // debug_state: bit0 = self_test_pass, bit1 = computation_done.
    pub fn debug_state_bits(computation_done: bool, pass: bool) -> u8 {
        var bits: u8 = 0;
        if (pass) {
            bits += 1;
        }
        if (computation_done) {
            bits += 2;
        }
        return bits;
    }

    // Bit k of a byte, counting from the LSB.
    pub fn bit_at(byte: u8, k: i32) -> bool {
        var b: u8 = byte;
        var i: i32 = 0;
        while (i < k) {
            b = b >> 1;
            i += 1;
        }
        return (b & 1) == 1;
    }

    // UART TX: the line value at baud tick `tick` of one byte, LSB data
    // first, framed by a 0 start bit and a 1 stop bit.
    pub fn uart_tx_bit_at(tick: i32, byte: u8) -> bool {
        if (tick == 0) {
            return false;
        }
        if (tick <= 8) {
            return bit_at(byte, tick - 1);
        }
        return true;
    }

    // TX accepts a byte whenever it is idle.
    pub fn tx_ready(tx_active: bool) -> bool {
        return !tx_active;
    }

    // Low 16 bits of a captured result, as the frame carries them: high byte
    // then low byte of the 20-bit register.
    pub fn result_high_byte(r: i32) -> u8 {
        return ((r & 0xFF00) >> 8) as u8;
    }

    pub fn result_low_byte(r: i32) -> u8 {
        return (r & 0xFF) as u8;
    }

    // One byte of the 20-byte report frame at index `idx`.
    pub fn report_frame_byte(idx: usize, pass: bool, results: []const i32) -> u8 {
        if (idx == 0) {
            return FRAME_SYNC0;
        }
        if (idx == 1) {
            return FRAME_SYNC1;
        }
        if (idx == 2) {
            return FRAME_TYPE_STEP2;
        }
        if (idx == 3) {
            return if (pass) 1 else 0;
        }
        const r: i32 = results[(idx - 4) / 2];
        if ((idx - 4) % 2 == 0) {
            return result_high_byte(r);
        }
        return result_low_byte(r);
    }

    pub struct ReportFrame {
        bytes: [20]u8,
    }

    // The reporter latches all 20 bytes when the self-test finishes.
    pub fn build_report_frame(pass: bool, results: []const i32) -> ReportFrame {
        var f: ReportFrame = ReportFrame { bytes: [0; 20] };
        var idx: usize = 0;
        while (idx < 20) {
            f.bytes[idx] = report_frame_byte(idx, pass, results);
            idx += 1;
        }
        return f;
    }

    // The frame is complete once byte 19 has been handed to the TX.
    pub fn report_frame_complete(idx: usize) -> bool {
        return idx == 19;
    }

    // The first UART_RESULTS_LEN final results, as uart_results buffers them.
    pub fn captured_results() -> [8]i32 {
        const buf: [729]i32 = layer1_buffer_values();
        var rs: [8]i32 = [0, 0, 0, 0, 0, 0, 0, 0];
        var k: i32 = 0;
        while (k < UART_RESULTS_LEN) {
            rs[k as usize] = matvec2_result_from(&buf, k);
            k += 1;
        }
        return rs;
    }

    // The module's driven outputs as one combinational surface: led (active
    // low), debug_state (only the low 2 bits are the original [1:0] port),
    // and uart_tx (idle high between bytes). In the Verilog these are
    // registers; here the caller supplies the current register state.
    pub struct TopOutputs {
        led: bool,
        debug_state: u8,
        uart_tx: bool,
    }

    pub fn on_comb(st_done: bool, pass: bool, counter: u32, current_led: bool, tx_active: bool) -> TopOutputs {
        return TopOutputs {
            led: led_pin(led_state_next(st_done, pass, counter, current_led)),
            debug_state: debug_state_bits(st_done, pass),
            uart_tx: tx_ready(tx_active),
        };
    }
}

test weight_patterns {
    assert_eq(weight_sign(0, 0), 1);
    assert_eq(weight_sign(1, 0), -1);
    assert_eq(weight_sign(2, 0), 0);
    assert_eq(weight_sign(0, 1), -1);
    assert_eq(weight_sign(2, 1), 1);
    assert_eq(weight_sign(1, 1), 0);
    assert_eq(weight2_sign(0, 0), 1);
    assert_eq(weight2_sign(1, 0), -1);
    assert_eq(weight2_sign(2, 0), 0);
    assert_eq(weight2_sign(1, 2), 1);
    assert_eq(weight2_sign(1, 1), 0);
    assert_eq(self_test_input(0), 1);
    assert_eq(self_test_input(242), 243);
}

test matvec1_pre_relu_pattern {
    // Pre-ReLU: {-81, 162, -81} repeating over j.
    assert_eq(matvec1_result(0), -81);
    assert_eq(matvec1_result(1), 162);
    assert_eq(matvec1_result(2), -81);
    assert_eq(matvec1_result(3), -81);
    assert_eq(matvec1_result(4), 162);
    assert_eq(matvec1_result(5), -81);
    assert_eq(matvec1_result(727), 162);
    assert_eq(matvec1_result(728), -81);
}

test relu_values {
    assert_eq(relu(-81), 0);
    assert_eq(relu(-1), 0);
    assert_eq(relu(0), 0);
    assert_eq(relu(162), 162);
}

test buffer_pattern {
    // Post-ReLU buffer: {0, 162, 0} repeating over j.
    const buf: [729]i32 = layer1_buffer_values();
    assert_eq(buffer_value(0), 0);
    assert_eq(buffer_value(1), 162);
    assert_eq(buffer_value(2), 0);
    assert_eq(buffer_value(3), 0);
    assert_eq(buffer_value(4), 162);
    assert_eq(buf[1], 162);
    assert_eq(buf[727], 162);
    assert_eq(buf[728], 0);
}

test matvec2_pattern {
    // Final: {-39366, 0, 39366} repeating over k.
    const buf: [729]i32 = layer1_buffer_values();
    assert_eq(matvec2_result_from(&buf, 0), -39366);
    assert_eq(matvec2_result_from(&buf, 1), 0);
    assert_eq(matvec2_result_from(&buf, 2), 39366);
    assert_eq(matvec2_result_from(&buf, 3), -39366);
    assert_eq(matvec2_result_from(&buf, 4), 0);
    assert_eq(matvec2_result_from(&buf, 5), 39366);
    assert_eq(matvec2_result_from(&buf, 241), 0);
    assert_eq(matvec2_result_from(&buf, 242), 39366);
}

test expected_streams {
    assert_eq(expected_val(0), -39366);
    assert_eq(expected_val(1), 0);
    assert_eq(expected_val(2), 39366);
    // k_mod3 is already reduced when compared (the Verilog compares the
    // running 2-bit k_mod3 register, never a raw k), so the wrap is through
    // advance_k_mod3, not a raw input of 3:
    assert_eq(expected_val(advance_k_mod3(2)), -39366);
    assert_eq(advance_k_mod3(0), 1);
    assert_eq(advance_k_mod3(1), 2);
    assert_eq(advance_k_mod3(2), 0);
}

test state_machine {
    assert_eq(state_bits(next_state(Step2State.Wait, 0, false, false)), 0);
    assert_eq(state_bits(next_state(Step2State.Wait, WAIT_CYCLES, false, false)), 1);
    assert_eq(state_bits(next_state(Step2State.Start1, 0, false, false)), 2);
    assert_eq(state_bits(next_state(Step2State.Layer1, 0, false, false)), 2);
    assert_eq(state_bits(next_state(Step2State.Layer1, 0, true, false)), 3);
    assert_eq(state_bits(next_state(Step2State.Start2, 0, false, false)), 4);
    assert_eq(state_bits(next_state(Step2State.Layer2, 0, false, false)), 4);
    assert_eq(state_bits(next_state(Step2State.Layer2, 0, false, true)), 5);
    assert_eq(state_bits(next_state(Step2State.Done, 0, false, false)), 5);
}

test por_and_wait {
    assert(por_rst(0));
    assert(por_rst(254));
    assert(!por_rst(255));
    assert(!start_after_wait(0));
    assert(!start_after_wait(19));
    assert(start_after_wait(20));
}

test self_test_pass_condition {
    assert(self_test_pass(false, N2_OUT));
    assert(!self_test_pass(true, N2_OUT));
    assert(!self_test_pass(false, N2_OUT - 1));
    assert(!self_test_pass(true, 0));
}

test layer2_check_passes {
    const buf: [729]i32 = layer1_buffer_values();
    assert(layer2_check_pass(&buf));
}

test led_logic {
    assert(led_state_next(true, true, 0, false));
    assert(!led_state_next(true, false, 0, true));
    assert(!led_state_next(false, false, LED_BLINK_HALF, true));
    assert(led_state_next(false, false, LED_BLINK_HALF, false));
    assert(led_state_next(false, false, 123, true));
    assert_eq(led_counter_next(false, LED_BLINK_HALF), 0);
    assert_eq(led_counter_next(true, LED_BLINK_HALF), LED_BLINK_HALF + 1);
    assert_eq(led_counter_next(false, 5), 6);
    assert(!led_pin(true));
    assert(led_pin(false));
}

test debug_state {
    assert_eq(debug_state_bits(false, true), 1);
    assert_eq(debug_state_bits(true, false), 2);
    assert_eq(debug_state_bits(true, true), 3);
    assert_eq(debug_state_bits(false, false), 0);
}

test uart_tx_framing {
    // 0x55 = 0b01010101 goes out LSB first between start and stop bits.
    assert(!uart_tx_bit_at(0, 0x55));
    assert(uart_tx_bit_at(1, 0x55));
    assert(!uart_tx_bit_at(2, 0x55));
    assert(uart_tx_bit_at(3, 0x55));
    assert(!uart_tx_bit_at(4, 0x55));
    assert(uart_tx_bit_at(9, 0x55));
    assert(uart_tx_bit_at(10, 0x55));
    assert(!tx_ready(true));
    assert(tx_ready(false));
    // 0xA2 = 0b10100010.
    assert(!bit_at(0xA2, 0));
    assert(bit_at(0xA2, 1));
    assert(!bit_at(0xA2, 2));
    assert(bit_at(0xA2, 5));
}

test report_frame_shape {
    // Frame: [0xAA][0xBB][0x44][pass][y0h][y0l]...[y7h][y7l].
    const rs = captured_results();
    const f = build_report_frame(true, &rs);
    assert_eq(f.bytes[0], FRAME_SYNC0);
    assert_eq(f.bytes[1], FRAME_SYNC1);
    assert_eq(f.bytes[2], FRAME_TYPE_STEP2);
    assert_eq(f.bytes[3], 1);
    assert_eq(f.bytes[4], 0x66);   // y0 = -39366
    assert_eq(f.bytes[5], 0x3A);
    assert_eq(f.bytes[6], 0);      // y1 = 0
    assert_eq(f.bytes[7], 0);
    assert_eq(f.bytes[8], 0x99);   // y2 = 39366
    assert_eq(f.bytes[9], 0xC6);
    assert_eq(f.bytes[18], 0);     // y7 = 0
    assert_eq(f.bytes[19], 0);
    const g = build_report_frame(false, &rs);
    assert_eq(g.bytes[3], 0);
    assert(report_frame_complete(19));
    assert(!report_frame_complete(18));
}

test report_frame_byte_idx {
    const rs = captured_results();
    assert_eq(report_frame_byte(0, true, &rs), FRAME_SYNC0);
    assert_eq(report_frame_byte(1, true, &rs), FRAME_SYNC1);
    assert_eq(report_frame_byte(2, false, &rs), FRAME_TYPE_STEP2);
    assert_eq(report_frame_byte(3, true, &rs), 1);
    assert_eq(report_frame_byte(3, false, &rs), 0);
    assert_eq(report_frame_byte(4, true, &rs), 0x66);   // y0 high
    assert_eq(report_frame_byte(5, true, &rs), 0x3A);   // y0 low
    assert_eq(report_frame_byte(7, true, &rs), 0);      // y1 low
    assert_eq(report_frame_byte(9, true, &rs), 0xC6);   // y2 low
    assert_eq(report_frame_byte(18, true, &rs), 0);     // y7 high
    assert_eq(report_frame_byte(19, true, &rs), 0);     // y7 low
}

test data_surface {
    const o = on_comb(true, true, 0, false, false);
    assert(!o.led);
    assert_eq(o.debug_state, 3);
    assert(o.uart_tx);
    const f = on_comb(false, false, LED_BLINK_HALF, true, true);
    assert(f.led);  // blink state toggled off -> active-low pin released high
    assert_eq(f.debug_state, 0);
    assert(!f.uart_tx);
}

test captured_results_values {
    // Final: {-39366, 0, 39366} repeating over the first 8 outputs.
    const rs = captured_results();
    assert_eq(rs[0], -39366);
    assert_eq(rs[1], 0);
    assert_eq(rs[2], 39366);
    assert_eq(rs[3], -39366);
    assert_eq(rs[4], 0);
    assert_eq(rs[5], 39366);
    assert_eq(rs[6], -39366);
    assert_eq(rs[7], 0);
}

test captured_by_uart_rule {
    assert(captured_by_uart(0));
    assert(captured_by_uart(7));
    assert(!captured_by_uart(8));
    assert(!captured_by_uart(242));
}

test result_bytes {
    assert_eq(result_high_byte(-39366), 0x66);
    assert_eq(result_low_byte(-39366), 0x3A);
    assert_eq(result_high_byte(39366), 0x99);
    assert_eq(result_low_byte(39366), 0xC6);
    assert_eq(result_high_byte(0x1234), 0x12);
    assert_eq(result_low_byte(0x1234), 0x34);
}
