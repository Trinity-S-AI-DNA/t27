// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/trinity_os/trinity_interrupt.t27
// Trinity OS Interrupt Controller Specification
// Trit-Priority Interrupt Controller for TRINITY OS
// Golden Identity: φ² + 1/φ² = 3
// Interrupt Sources: 8 = 2³
// Priority Levels: 4 = 2² (ternary +1 extended)
// Total States: 8 × 4 = 32 = 2⁵

module trinity_interrupt {

    // === Module Parameters ===

    pub const NUM_SOURCES : u32 = 8;
    pub const LOG2_NUM_SOURCES : u32 = 3;

    // === Priority Encoding Constants ===

    pub const PrioBlocked : u2 = 0b00;
    pub const PrioNormal : u2 = 0b01;
    pub const PrioHigh : u2 = 0b10;
    pub const PrioCritical : u2 = 0b11;

    // === Interrupt Source Definitions ===

    pub struct InterruptSource {
        index : u32,
        name : &str,
    }

    pub const InterruptSources : [NUM_SOURCES]InterruptSource = [
        InterruptSource{ .index = 0, .name = "UART_RX" },
        InterruptSource{ .index = 1, .name = "UART_TX" },
        InterruptSource{ .index = 2, .name = "VSA_COMPLETE" },
        InterruptSource{ .index = 3, .name = "TQNN_COMPLETE" },
        InterruptSource{ .index = 4, .name = "TIMER" },
        InterruptSource{ .index = 5, .name = "YIELD" },
        InterruptSource{ .index = 6, .name = "FAULT" },
        InterruptSource{ .index = 7, .name = "SPARE" },
    ];

    // === Internal State Registers ===

    pub struct InterruptState {
        priority_reg : [NUM_SOURCES]u2,
        enable_reg : [NUM_SOURCES]bool,
        pending_reg : [NUM_SOURCES]bool,
        served_reg : [NUM_SOURCES]bool,
        total_count : u32,
    }

    // === Constructor Functions ===

    fn empty_interrupt_state() -> InterruptState {
        return InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 },
            .pending_reg = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 },
            .served_reg = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 },
            .total_count = 0,
        };
    }

    fn irq_priority_at(state: InterruptState, index: u32) -> u2 {
        return state.priority_reg[index];
    }

    fn irq_enable_at(state: InterruptState, index: u32) -> u1 {
        return state.enable_reg[index];
    }

    fn irq_pending_at(state: InterruptState, index: u32) -> u1 {
        return state.pending_reg[index];
    }

    fn irq_served_at(state: InterruptState, index: u32) -> u1 {
        return state.served_reg[index];
    }

    // === Edge Detection and Pending Capture ===

    fn capture_rising_edges(
        current_state: InterruptState,
        irq_request: [NUM_SOURCES]u1,
        irq_request_d1: [NUM_SOURCES]u1
    ) -> InterruptState {
        var new_state : InterruptState = current_state;
        
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            if (irq_request[i] and !irq_request_d1[i] and new_state.enable_reg[i]) {
                new_state.pending_reg[i] = 1;
            }
            i = i + 1;
        }
        
        return new_state;
    }

    fn update_irq_request_d1(irq_request: [NUM_SOURCES]u1) -> [NUM_SOURCES]u1 {
        return irq_request;
    }

    // === Priority Encoder (Find highest priority pending interrupt) ===

    fn find_highest_priority_pending(state: InterruptState) -> (u32, u2, bool) {
        var highest_irq : u32 = 0;
        var highest_prio : u2 = PrioNormal;
        var found_pending : bool = false;

        // Search from highest source number to lowest (higher number = higher priority)
        var k : u32 = NUM_SOURCES - 1;
        while (k >= 0) {
            if (state.pending_reg[k] and state.priority_reg[k] != PrioBlocked) {
                if (!found_pending or state.priority_reg[k] > highest_prio) {
                    highest_irq = k;
                    highest_prio = state.priority_reg[k];
                    found_pending = true;
                }
            }
            k = k - 1;
        }

        return (highest_irq, highest_prio, found_pending);
    }

    fn irq_vector_output(state: InterruptState) -> u32 {
        var (highest_irq, highest_prio, found_pending) = find_highest_priority_pending(state);
        return if (found_pending) highest_irq else 0;
    }

    fn irq_count_output(state: InterruptState) -> u8 {
        var count : u8 = 0;
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            if (state.pending_reg[i]) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    // === Interrupt Output Logic ===

    fn update_interrupt_state(
        current_state: InterruptState,
        cpu_interrupt: bool,
        found_pending: bool,
        highest_irq: u32
    ) -> InterruptState {
        var new_state : InterruptState = current_state;

        if (cpu_interrupt and found_pending) {
            new_state.pending_reg[highest_irq] = false;
            new_state.served_reg[highest_irq] = true;
            new_state.total_count = new_state.total_count + 1;
        }

        return new_state;
    }

    fn cpu_interrupt_output(found_pending: u1) -> u1 {
        return found_pending;
    }

    // === Acknowledge Outputs ===

    fn irq_ack_output(state: InterruptState) -> [NUM_SOURCES]u1 {
        var ack : [NUM_SOURCES]u1 = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 };
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            ack[i] = state.served_reg[i] and state.pending_reg[i];
            i = i + 1;
        }
        return ack;
    }

    // === Configuration Registers ===

    fn update_priority_register(
        current_state: InterruptState,
        priority_we: bool,
        priority_addr: u32,
        priority_data: u2
    ) -> InterruptState {
        var new_state : InterruptState = current_state;

        if (priority_we and priority_addr < NUM_SOURCES) {
            new_state.priority_reg[priority_addr] = priority_data;
        }

        return new_state;
    }

    fn update_enable_register(
        current_state: InterruptState,
        enable_we: u1,
        enable_addr: u32,
        enable_data: u1
    ) -> InterruptState {
        var new_state : InterruptState = current_state;

        if (enable_we and enable_addr < NUM_SOURCES) {
            new_state.enable_reg[enable_addr] = enable_data;
        }

        return new_state;
    }

    // === Status Outputs ===

    fn irq_pending_output(state: InterruptState) -> [NUM_SOURCES]u1 {
        return state.pending_reg;
    }

    fn irq_served_output(state: InterruptState) -> [NUM_SOURCES]u1 {
        return state.served_reg;
    }

    fn irq_total_count_output(state: InterruptState) -> u32 {
        return state.total_count;
    }

    // === Test Functions ===

    test find_highest_priority_normal
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioHigh, PrioCritical, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]u1{ 1, 1, 1, 1, 1, 1, 1, 1 },
            .pending_reg = [NUM_SOURCES]u1{ 0, 0, 1, 0, 0, 0, 0, 0 },
            .served_reg = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 },
            .total_count = 0,
        }
        then find_highest_priority_pending(state) == (2, PrioCritical, true)
        and irq_vector_output(state) == 2

    test find_highest_priority_high
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioHigh, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]u1{ 1, 1, 1, 1, 1, 1, 1, 1 },
            .pending_reg = [NUM_SOURCES]u1{ 0, 1, 0, 0, 0, 0, 0, 0 },
            .served_reg = [NUM_SOURCES]u1{ 0, 0, 0, 0, 0, 0, 0, 0 },
            .total_count = 0,
        }
        then find_highest_priority_pending(state) == (1, PrioHigh, true)
        and irq_vector_output(state) == 1

    test find_highest_priority_blocked
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioBlocked, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ false, true, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then find_highest_priority_pending(state) == (0, PrioNormal, true)
        and irq_vector_output(state) == 0

    test find_no_pending_interrupts
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioHigh, PrioCritical, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then find_highest_priority_pending(state) == (0, PrioNormal, false)
        and irq_vector_output(state) == 0

    test irq_count_multiple_pending
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ true, false, true, false, true, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then irq_count_output(state) == 3

    test irq_ack_generation
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]u1{ 1, 1, 1, 1, 1, 1, 1, 1 },
            .pending_reg = [NUM_SOURCES]u1{ 1, 0, 1, 0, 0, 0, 0, 0 },
            .served_reg = [NUM_SOURCES]u1{ 1, 0, 0, 0, 0, 0, 0, 0 },
            .total_count = 5,
        }
        then irq_ack_output(state) == [NUM_SOURCES]u1{ 1, 0, 0, 0, 0, 0, 0, 0 }

    test priority_register_update
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then update_priority_register(state, true, 3, PrioCritical).priority_reg[3] == PrioCritical

    test enable_register_update
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .pending_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then update_enable_register(state, true, 5, true).enable_reg[5] == true

    test interrupt_acknowledgment
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ true, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        then update_interrupt_state(state, true, true, 0).pending_reg[0] == false
        and update_interrupt_state(state, true, true, 0).served_reg[0] == true
        and update_interrupt_state(state, true, true, 0).total_count == 1

    test edge_detection_capture
        given state = InterruptState{
            .priority_reg = [NUM_SOURCES]u2{ PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal, PrioNormal },
            .enable_reg = [NUM_SOURCES]bool{ true, true, true, true, true, true, true, true },
            .pending_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        }
        let irq_request = [NUM_SOURCES]bool{ false, true, false, false, false, false, false, false }
        let irq_request_d1 = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false }
        then capture_rising_edges(state, irq_request, irq_request_d1).pending_reg[1] == true

    test cpu_interrupt_output_true
        then cpu_interrupt_output(1) == 1

    test cpu_interrupt_output_false
        then cpu_interrupt_output(0) == 0

    // === Invariants ===

    invariant priority_encoding_valid
        given state = empty_interrupt_state()
        assert state.priority_reg[0] == PrioNormal
        and state.priority_reg[NUM_SOURCES-1] == PrioNormal

    invariant enable_register_boolean
        given state = empty_interrupt_state()
        assert state.enable_reg[0] == false
        and state.enable_reg[NUM_SOURCES-1] == false

    invariant pending_register_boolean
        given state = empty_interrupt_state()
        assert state.pending_reg[0] == false
        and state.pending_reg[NUM_SOURCES-1] == false

    invariant served_register_boolean
        given state = empty_interrupt_state()
        assert state.served_reg[0] == false
        and state.served_reg[NUM_SOURCES-1] == false

    invariant total_count_non_negative
        given state = empty_interrupt_state()
        assert state.total_count >= 0

    invariant irq_vector_range
        given state = empty_interrupt_state()
        assert irq_vector_output(state) < NUM_SOURCES

    invariant irq_count_range
        given state = empty_interrupt_state()
        assert irq_count_output(state) <= NUM_SOURCES

    invariant irq_ack_same_length
        given state = empty_interrupt_state()
        var ack : [NUM_SOURCES]bool = irq_ack_output(state)
        assert ack.len == NUM_SOURCES
}

// phi^2 + 1/φ² = 3 | TRINITY