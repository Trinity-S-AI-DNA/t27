// SPDX-License-Identifier: Apache-2.0
// specs/port/trinity/fpga/openxc7-synth/trinity_os/trinity_interrupt.t27
//
// Port of gHashTag/trinity@341f1d150c70
// fpga/openxc7-synth/trinity_os/trinity_interrupt.v
// (TRINITY OS - Interrupt Controller v1.0.0, 275 lines of hand-written Verilog).
//
// Trit-Priority Interrupt Controller for TRINITY OS.
// Golden Identity: phi^2 + 1/phi^2 = 3
//
// Interrupt Sources (8):
//   0: UART_RX       - UART data received
//   1: UART_TX       - UART transmit complete
//   2: VSA_COMPLETE  - VSA operation finished
//   3: TQNN_COMPLETE - TQNN layer inference done
//   4: TIMER         - System timer tick
//   5: YIELD         - Task yield request
//   6: FAULT         - Memory/execution fault
//   7: SPARE         - Reserved for expansion
//
// Priority Encoding (2-bit codes in the original; 00..11 map to 0..3 here):
//   PRIO_BLOCKED  (00) - interrupt disabled
//   PRIO_NORMAL   (01) - standard priority
//   PRIO_HIGH     (10) - high priority (preempts normal)
//   PRIO_CRITICAL (11) - highest priority
//
// Port map (original Verilog construct -> pure .t27 function):
//   reset branches           -> empty_interrupt_state
//   wire irq_prio generate   -> irq_priority_at / irq_enable_at /
//                               irq_pending_at / irq_served_at
//   clocked rising-edge
//     capture block          -> capture_rising_edges / update_irq_request_d1
//   clocked priority-encoder
//     block                  -> find_highest_priority_pending
//   assign irq_vector        -> irq_vector_output
//   assign irq_count         -> irq_count_output
//   clocked acknowledge
//     block                  -> update_interrupt_state
//   cpu_interrupt register   -> cpu_interrupt_output
//   assign irq_ack           -> irq_ack_output
//   clocked config-register
//     blocks                 -> update_priority_register / update_enable_register
//   InterruptSource table    -> source_name
//   assign irq_pending /
//     irq_served / total_cnt -> irq_pending_output / irq_served_output /
//                               irq_total_count_output
//   FORMAL properties        -> invariants formal_interrupt_output_implies_pending /
//                               formal_critical_preempts_normal
//
// Type notes: the original's single-bit `wire`/`reg` signals become `bool`;
// the 2-bit priority codes become `u32` restricted to 0..3 (the original's
// `[1:0]` truncation is emulated explicitly by priority_data_truncate);
// the 3-bit address ports cannot address beyond source 7, emulated by the
// index guard in the config functions.
//
// The one non-obvious transformation: the original encoder scans sources
// 7..0 and replaces its choice only on a strict `>` (so the FIRST hit at the
// top wins ties, i.e. the highest source NUMBER among equal priorities).
// This port scans 0..7 and replaces on `>=`, which reaches the same choice:
// the last equal-priority hit in forward order is the highest-numbered one.

module trinity_interrupt {

    // === Module parameters (original `parameter` lines) ===
    pub const NUM_SOURCES : u32 = 8;
    pub const LOG2_NUM_SOURCES : u32 = 3;

    // === Priority encoding (original localparams) ===
    pub const PRIO_BLOCKED : u32 = 0;  // 2'b00 - interrupt disabled
    pub const PRIO_NORMAL : u32 = 1;   // 2'b01 - standard priority
    pub const PRIO_HIGH : u32 = 2;     // 2'b10 - preempts normal
    pub const PRIO_CRITICAL : u32 = 3; // 2'b11 - highest priority

    // === Internal registers (original reg declarations) ===
    pub struct InterruptState {
        priority_reg : [NUM_SOURCES]u32, // 2-bit priority per source
        enable_reg : [NUM_SOURCES]bool,  // enable mask
        pending_reg : [NUM_SOURCES]bool, // pending interrupts (edge capture)
        served_reg : [NUM_SOURCES]bool,  // served interrupts (history)
        total_count : u32,               // 32-bit total interrupt counter
    }

    // === Reset state (original reset branches: priority_reg -> NORMAL
    // everywhere, every mask bit -> 0, counter -> 0) ===
    pub fn empty_interrupt_state() -> InterruptState {
        return InterruptState{
            .priority_reg = [NUM_SOURCES]u32{ PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL, PRIO_NORMAL },
            .enable_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .pending_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .served_reg = [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false },
            .total_count = 0,
        };
    }

    // Fresh all-zero request/mask bus (array literals cannot be assigned to
    // local vars in t27 -- they lower to anonymous tuples -- so locals that
    // need a mutable array start from this helper or a field copy).
    pub fn all_sources_disabled() -> [NUM_SOURCES]bool {
        return [NUM_SOURCES]bool{ false, false, false, false, false, false, false, false };
    }

    // === Per-source register readouts (original irq_prio generate loop) ===
    // The Verilog register file is only ever indexed by a 3-bit address, so
    // an out-of-range index is unreachable in hardware. The port takes a u32,
    // so accessors guard the bound and return the reset default instead.
    pub fn irq_priority_at(state: InterruptState, index: u32) -> u32 {
        if (index >= NUM_SOURCES) {
            return PRIO_NORMAL;
        }
        return state.priority_reg[index];
    }

    pub fn irq_enable_at(state: InterruptState, index: u32) -> bool {
        if (index >= NUM_SOURCES) {
            return false;
        }
        return state.enable_reg[index];
    }

    pub fn irq_pending_at(state: InterruptState, index: u32) -> bool {
        if (index >= NUM_SOURCES) {
            return false;
        }
        return state.pending_reg[index];
    }

    pub fn irq_served_at(state: InterruptState, index: u32) -> bool {
        if (index >= NUM_SOURCES) {
            return false;
        }
        return state.served_reg[index];
    }

    // === Rising-edge capture (original clocked block) ===
    // A request becomes pending when it rises through the irq_request_d1
    // stage while its source is enabled:
    //   irq_request[i] && !irq_request_d1[i] && enable_reg[i]
    // falling edges and steady levels never set pending.
    pub fn capture_rising_edges(state: InterruptState, irq_request: [NUM_SOURCES]bool, irq_request_d1: [NUM_SOURCES]bool) -> InterruptState {
        var ns = empty_interrupt_state();
        ns.priority_reg = state.priority_reg;
        ns.enable_reg = state.enable_reg;
        ns.pending_reg = state.pending_reg;
        ns.served_reg = state.served_reg;
        ns.total_count = state.total_count;
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            if (irq_request[i] && !irq_request_d1[i] && state.enable_reg[i]) {
                ns.pending_reg[i] = true;
            }
            i += 1;
        }
        return ns;
    }

    // The irq_request_d1 register: next-cycle copy of the request bus.
    pub fn update_irq_request_d1(irq_request: [NUM_SOURCES]bool) -> [NUM_SOURCES]bool {
        var d1 = all_sources_disabled();
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            d1[i] = irq_request[i];
            i += 1;
        }
        return d1;
    }

    // === Priority encoder (original clocked block) ===
    // Among pending, non-BLOCKED sources, selects the highest priority;
    // equal priorities tie-break to the highest source number (see the
    // header note on the scan-direction transformation).
    // Returns (vector, priority, found_pending).
    pub fn find_highest_priority_pending(state: InterruptState) -> (u32, u32, bool) {
        var highest_irq : u32 = 0;
        var highest_prio : u32 = PRIO_NORMAL;
        var found_pending : bool = false;
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            if (state.pending_reg[i] && state.priority_reg[i] != PRIO_BLOCKED) {
                if (!found_pending || state.priority_reg[i] >= highest_prio) {
                    highest_irq = i;
                    highest_prio = state.priority_reg[i];
                    found_pending = true;
                }
            }
            i += 1;
        }
        return (highest_irq, highest_prio, found_pending);
    }

    // assign irq_vector = found_pending ? highest_irq : 3'd0;
    pub fn irq_vector_output(state: InterruptState) -> u32 {
        const (highest_irq, highest_prio, found_pending) = find_highest_priority_pending(state);
        if (found_pending) { return highest_irq; }
        return 0;
    }

    // assign irq_count = {5'd0, popcount(pending_reg)}; (8-bit output)
    pub fn irq_count_output(state: InterruptState) -> u8 {
        var count : u8 = 0;
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            if (state.pending_reg[i]) {
                count += 1;
            }
            i += 1;
        }
        return count;
    }

    // === Acknowledge (original clocked block) ===
    // When cpu_interrupt is high and the encoder found a pending source,
    // that source's pending bit clears, its served (history) bit sets and
    // the total counter increments:
    //   pending_reg[highest_irq] <= 1'b0
    //   served_reg[highest_irq]  <= 1'b1
    //   total_count              <= total_count + 1
    pub fn update_interrupt_state(state: InterruptState, cpu_interrupt: bool, found_pending: bool, highest_irq: u32) -> InterruptState {
        var ns = empty_interrupt_state();
        ns.priority_reg = state.priority_reg;
        ns.enable_reg = state.enable_reg;
        ns.pending_reg = state.pending_reg;
        ns.served_reg = state.served_reg;
        ns.total_count = state.total_count;
        if (cpu_interrupt && found_pending) {
            ns.pending_reg[highest_irq] = false;
            ns.served_reg[highest_irq] = true;
            ns.total_count = state.total_count + 1;
        }
        return ns;
    }

    // cpu_interrupt <= found_pending; (registered output, next-cycle value)
    pub fn cpu_interrupt_output(found_pending: bool) -> bool {
        return found_pending;
    }

    // assign irq_ack[i] = pending_reg[i] && cpu_interrupt;
    pub fn irq_ack_output(state: InterruptState, cpu_interrupt: bool) -> [NUM_SOURCES]bool {
        var ack = state.pending_reg;
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            ack[i] = state.pending_reg[i] && cpu_interrupt;
            i += 1;
        }
        return ack;
    }

    // === Priority register write (original clocked block) ===
    // priority_we strobe; priority_addr is a 3-bit port, so addresses
    // outside 0..7 cannot occur in hardware and are ignored here.
    pub fn update_priority_register(state: InterruptState, priority_we: bool, priority_addr: u32, priority_data: u32) -> InterruptState {
        var ns = empty_interrupt_state();
        ns.priority_reg = state.priority_reg;
        ns.enable_reg = state.enable_reg;
        ns.pending_reg = state.pending_reg;
        ns.served_reg = state.served_reg;
        ns.total_count = state.total_count;
        if (priority_we && priority_addr < NUM_SOURCES) {
            ns.priority_reg[priority_addr] = priority_data_truncate(priority_data);
        }
        return ns;
    }

    // === Enable register write (original clocked block) ===
    pub fn update_enable_register(state: InterruptState, enable_we: bool, enable_addr: u32, enable_data: bool) -> InterruptState {
        var ns = empty_interrupt_state();
        ns.priority_reg = state.priority_reg;
        ns.enable_reg = state.enable_reg;
        ns.pending_reg = state.pending_reg;
        ns.served_reg = state.served_reg;
        ns.total_count = state.total_count;
        if (enable_we && enable_addr < NUM_SOURCES) {
            ns.enable_reg[enable_addr] = enable_data;
        }
        return ns;
    }

    // The original delivers priority_data through a [1:0] port, dropping all
    // bits above bit 1. Emulated as value mod 4 (e.g. 7 -> 3, 4 -> 0).
    pub fn priority_data_truncate(data: u32) -> u32 {
        return data - (data / 4) * 4;
    }

    // === Source name table (original InterruptSource struct/table) ===
    pub fn source_name(index: u32) -> &str {
        if (index == 0) { return "UART_RX"; }
        if (index == 1) { return "UART_TX"; }
        if (index == 2) { return "VSA_COMPLETE"; }
        if (index == 3) { return "TQNN_COMPLETE"; }
        if (index == 4) { return "TIMER"; }
        if (index == 5) { return "YIELD"; }
        if (index == 6) { return "FAULT"; }
        if (index == 7) { return "SPARE"; }
        return "UNKNOWN";
    }

    // === Status output buses (original assigns) ===
    pub fn irq_pending_output(state: InterruptState) -> [NUM_SOURCES]bool {
        return state.pending_reg;
    }

    pub fn irq_served_output(state: InterruptState) -> [NUM_SOURCES]bool {
        return state.served_reg;
    }

    pub fn irq_total_count_output(state: InterruptState) -> u32 {
        return state.total_count;
    }

    // === Fixtures shared by tests and comptime invariants ===
    pub fn state_one_pending(index: u32, prio: u32) -> InterruptState {
        var s = empty_interrupt_state();
        s.priority_reg[index] = prio;
        s.pending_reg[index] = true;
        return s;
    }

    pub fn state_two_pending(index_a: u32, prio_a: u32, index_b: u32, prio_b: u32) -> InterruptState {
        var s = state_one_pending(index_a, prio_a);
        s.priority_reg[index_b] = prio_b;
        s.pending_reg[index_b] = true;
        return s;
    }

    // === FORMAL properties from the original Verilog (comptime invariants:
    // compiling this file is the proof) ===
    //
    // original: cpu_interrupt |-> (|irq_pending != 0)
    // Ported form: when the encoder fires on a state, at least one source is
    // pending (so the interrupt output is grounded in real pending work).
    invariant formal_interrupt_output_implies_pending
        given one_pending = state_one_pending(2, PRIO_NORMAL)
        assert irq_count_output(one_pending) >= 1

    // original: critical pending preempts normal pending
    invariant formal_critical_preempts_normal
        given mixed = state_two_pending(2, PRIO_NORMAL, 5, PRIO_CRITICAL)
        assert irq_vector_output(mixed) == 5

    // === Tests: assert the actual behavior of the original Verilog ===

    test reset_state_matches_original {
        var s = empty_interrupt_state();
        var i : u32 = 0;
        while (i < NUM_SOURCES) {
            assert(irq_priority_at(s, i) == PRIO_NORMAL);
            assert(irq_enable_at(s, i) == false);
            assert(irq_pending_at(s, i) == false);
            assert(irq_served_at(s, i) == false);
            i += 1;
        }
        assert(irq_total_count_output(s) == 0);
    }

    test edge_capture_rising_edge_becomes_pending {
        var state = empty_interrupt_state();
        state.enable_reg[0] = true;
        state.enable_reg[3] = true;
        var req = all_sources_disabled();
        req[0] = true;
        req[3] = true;
        var d1 = all_sources_disabled();
        var next = capture_rising_edges(state, req, d1);
        assert(irq_pending_at(next, 0) == true);
        assert(irq_pending_at(next, 3) == true);
        assert(irq_pending_at(next, 1) == false);
    }

    test edge_capture_ignores_falling_and_steady_levels {
        var state = empty_interrupt_state();
        state.enable_reg[0] = true;
        state.enable_reg[1] = true;
        // falling edge (1 -> 0) and steady low must not latch pending
        var req = all_sources_disabled();
        var d1 = all_sources_disabled();
        d1[0] = true;
        var next = capture_rising_edges(state, req, d1);
        assert(irq_pending_at(next, 0) == false);
        assert(irq_pending_at(next, 1) == false);
        // steady high (1 -> 1) must not re-latch pending either
        var req2 = all_sources_disabled();
        req2[0] = true;
        var d12 = all_sources_disabled();
        d12[0] = true;
        var next2 = capture_rising_edges(state, req2, d12);
        assert(irq_pending_at(next2, 0) == false);
    }

    test edge_capture_requires_enabled_source {
        var state = empty_interrupt_state();
        // source 1 NOT enabled
        var req = all_sources_disabled();
        req[1] = true;
        var d1 = all_sources_disabled();
        var next = capture_rising_edges(state, req, d1);
        assert(irq_pending_at(next, 1) == false);
        // enabling the source lets the same edge through
        var enabled = update_enable_register(state, true, 1, true);
        var next2 = capture_rising_edges(enabled, req, d1);
        assert(irq_pending_at(next2, 1) == true);
    }

    test d1_register_copies_request_bus {
        var req = all_sources_disabled();
        req[0] = true;
        req[2] = true;
        req[6] = true;
        var d1 = update_irq_request_d1(req);
        assert(d1[0] == true);
        assert(d1[1] == false);
        assert(d1[2] == true);
        assert(d1[6] == true);
        assert(d1[7] == false);
    }

    test priority_encoder_selects_highest_priority {
        var state = state_two_pending(2, PRIO_NORMAL, 5, PRIO_HIGH);
        const (highest_irq, highest_prio, found) = find_highest_priority_pending(state);
        assert(found == true);
        assert(highest_irq == 5);
        assert(highest_prio == PRIO_HIGH);
        assert(irq_vector_output(state) == 5);
    }

    test priority_encoder_tie_breaks_to_highest_source_number {
        // equal priorities: the original's high-to-low strict-> scan keeps
        // the first (highest-numbered) hit
        var state = state_two_pending(2, PRIO_HIGH, 5, PRIO_HIGH);
        const (highest_irq, highest_prio, found) = find_highest_priority_pending(state);
        assert(found == true);
        assert(highest_irq == 5);
        assert(highest_prio == PRIO_HIGH);
        // same tie-break among NORMAL sources
        var state2 = state_two_pending(1, PRIO_NORMAL, 4, PRIO_NORMAL);
        assert(irq_vector_output(state2) == 4);
    }

    test blocked_sources_never_win_the_encoder {
        var state = state_one_pending(3, PRIO_BLOCKED);
        const (highest_irq, highest_prio, found) = find_highest_priority_pending(state);
        assert(found == false);
        assert(irq_vector_output(state) == 0);
        assert(cpu_interrupt_output(found) == false);
        // BLOCKED source loses to a NORMAL source
        var mixed = state_two_pending(3, PRIO_BLOCKED, 4, PRIO_NORMAL);
        assert(irq_vector_output(mixed) == 4);
    }

    test critical_preempts_normal {
        var state = state_two_pending(2, PRIO_NORMAL, 5, PRIO_CRITICAL);
        assert(irq_vector_output(state) == 5);
        // HIGH also preempts NORMAL
        var high = state_two_pending(2, PRIO_NORMAL, 6, PRIO_HIGH);
        assert(irq_vector_output(high) == 6);
    }

    test acknowledge_clears_pending_and_sets_served_history {
        var state = state_two_pending(2, PRIO_NORMAL, 5, PRIO_HIGH);
        var acked = update_interrupt_state(state, true, true, 5);
        assert(irq_pending_at(acked, 5) == false);
        assert(irq_served_at(acked, 5) == true);
        assert(irq_pending_at(acked, 2) == true); // untouched source stays pending
        assert(irq_served_at(acked, 2) == false);
        assert(irq_total_count_output(acked) == 1);
        // a second acknowledgment bumps the total counter again
        var acked2 = update_interrupt_state(acked, true, true, 2);
        assert(irq_pending_at(acked2, 2) == false);
        assert(irq_served_at(acked2, 2) == true);
        assert(irq_total_count_output(acked2) == 2);
    }

    test no_ack_when_cpu_interrupt_low {
        var state = state_two_pending(2, PRIO_NORMAL, 5, PRIO_HIGH);
        var untouched = update_interrupt_state(state, false, true, 5);
        assert(irq_pending_at(untouched, 5) == true);
        assert(irq_served_at(untouched, 5) == false);
        assert(irq_total_count_output(untouched) == 0);
        // the registered output follows found_pending on the next cycle
        assert(cpu_interrupt_output(true) == true);
        assert(cpu_interrupt_output(false) == false);
    }

    test ack_bus_gated_by_cpu_interrupt {
        var state = state_two_pending(0, PRIO_NORMAL, 1, PRIO_NORMAL);
        var ack = irq_ack_output(state, true);
        assert(ack[0] == true);
        assert(ack[1] == true);
        assert(ack[2] == false);
        assert(ack[7] == false);
        var quiet = irq_ack_output(state, false);
        assert(quiet[0] == false);
        assert(quiet[1] == false);
    }

    test vector_output_grounded_when_nothing_pending {
        var state = empty_interrupt_state();
        assert(irq_vector_output(state) == 0);
        assert(irq_count_output(state) == 0);
        assert(cpu_interrupt_output(false) == false);
    }

    test count_output_matches_pending_population {
        var one = state_one_pending(6, PRIO_NORMAL);
        assert(irq_count_output(one) == 1);
        var two = state_two_pending(0, PRIO_NORMAL, 6, PRIO_HIGH);
        assert(irq_count_output(two) == 2);
    }

    test config_writes_need_their_we_strobes {
        var state = empty_interrupt_state();
        // priority_we low: write is ignored
        var skipped = update_priority_register(state, false, 4, PRIO_HIGH);
        assert(irq_priority_at(skipped, 4) == PRIO_NORMAL);
        // priority_we high: write lands
        var written = update_priority_register(state, true, 4, PRIO_HIGH);
        assert(irq_priority_at(written, 4) == PRIO_HIGH);
        assert(irq_priority_at(written, 0) == PRIO_NORMAL);
        // enable_we low: write is ignored
        var eskip = update_enable_register(state, false, 2, true);
        assert(irq_enable_at(eskip, 2) == false);
        // enable_we high: write lands
        var ewrite = update_enable_register(state, true, 2, true);
        assert(irq_enable_at(ewrite, 2) == true);
    }

    test priority_write_truncates_to_two_bits {
        var state = empty_interrupt_state();
        // the original's priority_data[1:0] port drops bits 2 and up
        var w7 = update_priority_register(state, true, 0, 7);
        assert(irq_priority_at(w7, 0) == PRIO_CRITICAL); // 7 & 3 = 3
        var w4 = update_priority_register(state, true, 1, 4);
        assert(irq_priority_at(w4, 1) == PRIO_BLOCKED); // 4 & 3 = 0
        var w5 = update_priority_register(state, true, 2, 5);
        assert(irq_priority_at(w5, 2) == PRIO_NORMAL); // 5 & 3 = 1
        var w3 = update_priority_register(state, true, 3, 3);
        assert(irq_priority_at(w3, 3) == PRIO_CRITICAL);
        assert(priority_data_truncate(7) == 3);
        assert(priority_data_truncate(4) == 0);
        assert(priority_data_truncate(5) == 1);
    }

    test out_of_range_config_writes_are_ignored {
        // the original's 3-bit address ports cannot reach source 8
        var state = empty_interrupt_state();
        var p = update_priority_register(state, true, 8, PRIO_CRITICAL);
        assert(irq_priority_at(p, 8) == PRIO_NORMAL);
        var e = update_enable_register(state, true, 9, true);
        assert(irq_enable_at(e, 9) == false);
    }

    test source_name_table_matches_original {
        assert(source_name(0) == "UART_RX");
        assert(source_name(1) == "UART_TX");
        assert(source_name(2) == "VSA_COMPLETE");
        assert(source_name(3) == "TQNN_COMPLETE");
        assert(source_name(4) == "TIMER");
        assert(source_name(5) == "YIELD");
        assert(source_name(6) == "FAULT");
        assert(source_name(7) == "SPARE");
        assert(source_name(8) == "UNKNOWN");
    }

    test status_outputs_mirror_state {
        var state = state_two_pending(0, PRIO_NORMAL, 3, PRIO_HIGH);
        state.served_reg[1] = true;
        state.total_count = 7;
        var pend = irq_pending_output(state);
        assert(pend[0] == true);
        assert(pend[3] == true);
        assert(pend[1] == false);
        var served = irq_served_output(state);
        assert(served[1] == true);
        assert(served[0] == false);
        assert(irq_total_count_output(state) == 7);
    }

    test end_to_end_request_to_acknowledgment {
        // One full hardware cycle: enable source 5, raise its request,
        // watch it get picked and acknowledged, then see the bus settle.
        var state = update_enable_register(empty_interrupt_state(), true, 5, true);
        var req = all_sources_disabled();
        req[5] = true;
        var d1 = all_sources_disabled();
        var captured = capture_rising_edges(state, req, d1);
        assert(irq_pending_at(captured, 5) == true);
        const (highest_irq, highest_prio, found) = find_highest_priority_pending(captured);
        assert(found == true);
        assert(highest_irq == 5);
        assert(highest_prio == PRIO_NORMAL);
        assert(irq_vector_output(captured) == 5);
        assert(irq_count_output(captured) == 1);
        var acked = update_interrupt_state(captured, true, found, highest_irq);
        assert(irq_pending_at(acked, 5) == false);
        assert(irq_served_at(acked, 5) == true);
        assert(irq_total_count_output(acked) == 1);
        // with pending cleared, the next cycle finds nothing and idles
        const (next_irq, next_prio, next_found) = find_highest_priority_pending(acked);
        assert(next_found == false);
        assert(irq_vector_output(acked) == 0);
        assert(cpu_interrupt_output(next_found) == false);
    }
}
