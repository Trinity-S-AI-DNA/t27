// Port of gHashTag/trinity:fpga/openxc7-synth/ternary_matvec_top.v
// Original: ternary_matvec_top module for Trinity S³AI FPGA

module ternary_matvec_top;

// Constants from the original
pub const POR_CYCLES : u32 = 255;
pub const CLK_DIV : u32 = 27;

// State machine states (from original localparam)
pub const StateMachine = enum {
    ST_WAIT,
    ST_START,
    ST_COMPUTE,
    ST_VERIFY,
    ST_PASS,
    ST_FAIL,
    ST_DONE,
}

// Test for expected value computation
fn compute_expected_value(verify_idx: u6) -> i16 {
    var mod3_full: u8 = verify_idx;
    var mod3 = mod3_full % 3;
    
    if (mod3 == 0) {
        return 43;
    } else if (mod3 == 1) {
        return -22;
    } else {
        return -21;
    }
}

test compute_expected_value_test {
    assert(compute_expected_value(0) == 43);    // (0+0)%3=0
    assert(compute_expected_value(1) == -22);   // (0+1)%3=1  
    assert(compute_expected_value(2) == -21);   // (0+2)%3=2
    assert(compute_expected_value(3) == 43);    // (1+2)%3=0
    assert(compute_expected_value(4) == -22);   // (1+3)%3=1
}

// Simple test to verify basic functionality
// Power-on reset logic
fn por_counter_value(counter: u8) -> bool {
    return counter < POR_CYCLES;
}

fn update_por_counter(counter: u8) -> u8 {
    if (por_counter_value(counter)) {
        return counter + 1;
    }
    return counter;
}

// Result storage functions
fn store_result(results: [64]u16, addr: u6, data: u16) -> [64]u16 {
    if (addr < 64) {
        results[addr] = data;
    }
    return results;
}

fn get_result(results: [64]u16, addr: u6) -> u16 {
    if (addr < 64) {
        return results[addr];
    }
    return 0;
}

// State machine logic
fn get_next_state(current_state: StateMachine, wait_cnt: u8, mv_done: bool, verify_idx: u6, verify_pass: bool) -> StateMachine {
    if (current_state == .ST_WAIT) {
        if (wait_cnt < 20) {
            return .ST_WAIT;
        } else {
            return .ST_START;
        }
    } else if (current_state == .ST_START) {
        return .ST_COMPUTE;
    } else if (current_state == .ST_COMPUTE) {
        if (mv_done) {
            return .ST_VERIFY;
        } else {
            return .ST_COMPUTE;
        }
    } else if (current_state == .ST_VERIFY) {
        if (!verify_pass) {
            return .ST_FAIL;
        } else if (verify_idx == 63) {
            return .ST_PASS;
        } else {
            return .ST_VERIFY;
        }
    } else if (current_state == .ST_PASS) {
        return .ST_DONE;
    } else if (current_state == .ST_FAIL) {
        return .ST_DONE;
    } else if (current_state == .ST_DONE) {
        return .ST_DONE;
    } else {
        return current_state;
    }
}

// UART frame construction
fn create_report_frame(results: [64]u16, self_test_pass: bool) -> [20]u8 {
    var frame: [20]u8 = [0] ** 20;
    
    // Header
    frame[0] = 0xAA;
    frame[1] = 0xBB;
    frame[2] = 0x21;
    frame[3] = if (self_test_pass) 0x80 else 0x00;
    
    // Pack first 8 results into the frame
    var i: u5 = 0;
    while (i < 8) {
        var result: u16 = get_result(results, i);
        // Extract high byte and low byte
        frame[4 + i*2] = (result >> 8) as u8;
        frame[5 + i*2] = (result & 0xFF) as u8;
        i = i + 1;
    }
    
    return frame;
}

fn send_report_frame(frame: [20]u8, report_idx: u5, tx_ready: bool) -> (u8, bool) {
    if (!tx_ready or report_idx >= 20) {
        return (0, false);
    }
    return (frame[report_idx], true);
}

test basic_test {
    assert(true);
}

test uart_frame_construction {
    var results: [64]u16 = [0] ** 64;
    results[0] = 0x1234;
    results[1] = 0x5678;
    var frame = create_report_frame(results, true);
    
    assert(frame[0] == 0xAA);
    assert(frame[1] == 0xBB);
    assert(frame[2] == 0x21);
    assert(frame[3] == 0x80);  // true -> 0x80
    assert(frame[4] == 0x12);  // high byte of 0x1234
    assert(frame[5] == 0x34);  // low byte of 0x1234
    assert(frame[6] == 0x56);  // high byte of 0x5678
    assert(frame[7] == 0x78);  // low byte of 0x5678
}

test send_report_frame {
    var frame: [20]u8 = [0xAA, 0xBB, 0x21, 0x00, 0x12, 0x34, 0x56, 0x78, 0x90, 0xAB, 0xCD, 0xEF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00];
    var result = send_report_frame(frame, 0, true);
    assert(result[0] == 0xAA);
    assert(result[1] == true);
    
    result = send_report_frame(frame, 19, true);
    assert(result[0] == 0x00);
    assert(result[1] == true);
    
    result = send_report_frame(frame, 20, true);
    assert(result[0] == 0);
    assert(result[1] == false);
    
    result = send_report_frame(frame, 0, false);
    assert(result[0] == 0);
    assert(result[1] == false);
}

// Integration test for the complete self-test scenario
test self_test_integration {
    var results: [64]u16 = [0] ** 64;
    var state = .ST_WAIT;
    var wait_counter: u8 = 0;
    var mv_done = false;
    var verify_idx: u6 = 0;
    var verify_pass = false;
    
    // Simulate the complete self-test flow
    state = get_next_state(state, wait_counter, mv_done, verify_idx, verify_pass);
    assert(state == .ST_WAIT);
    
    wait_counter = 20;
    state = get_next_state(state, wait_counter, mv_done, verify_idx, verify_pass);
    assert(state == .ST_START);
    
    mv_done = true;
    state = get_next_state(state, wait_counter, mv_done, verify_idx, verify_pass);
    assert(state == .ST_VERIFY);
    
    // Store a correct result and verify it passes
    results = store_result(results, 0, 43);
    verify_pass = verify_result(get_result(results, 0), compute_expected_value(0));
    verify_idx = 63;
    state = get_next_state(state, wait_counter, mv_done, verify_idx, verify_pass);
    assert(state == .ST_PASS);
}

// Test the complete UART report generation
test uart_report_generation {
    var results: [64]u16 = [0] ** 64;
    results[0] = 0x1234;
    results[1] = 0x5678;
    results[2] = 0xABCD;
    results[3] = 0x9876;
    
    var frame = create_report_frame(results, true);
    
    // Verify header
    assert(frame[0] == 0xAA);
    assert(frame[1] == 0xBB);
    assert(frame[2] == 0x21);
    assert(frame[3] == 0x80);  // self_test_pass = true
    
    // Verify packed results
    assert(frame[4] == 0x12);  // high byte of 0x1234
    assert(frame[5] == 0x34);  // low byte of 0x1234
    assert(frame[6] == 0x56);  // high byte of 0x5678
    assert(frame[7] == 0x78);  // low byte of 0x5678
    assert(frame[8] == 0xAB);  // high byte of 0xABCD
    assert(frame[9] == 0xCD);  // low byte of 0xABCD
    assert(frame[10] == 0x98); // high byte of 0x9876
    assert(frame[11] == 0x76); // low byte of 0x9876
}

endmodule