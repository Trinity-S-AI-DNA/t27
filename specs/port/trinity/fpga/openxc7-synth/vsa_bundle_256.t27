// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/vsa_bundle_256.t27
// VSA Bundle Operation on FPGA - 256 dimensions
// Ported from gHashTag/trinity fpga/openxc7-synth/vsa_bundle_256.v
// Week 3: Majority voting (ternary addition with thresholding)
// Balanced Ternary: {-1, 0, +1}
// Bundle operation: result[i] = majority(a[i], b[i])
//   if (a + b) > 0: +1
//   if (a + b) < 0: -1
//   if (a + b) == 0: 0
// phi^2 + 1/phi^2 = 3 | TRINITY

module vsa_bundle_256 {

    // === Module constants ===

    pub const TRIT_COUNT : usize = 256;
    pub const TRIT_WIDTH : usize = 2;
    pub const TOTAL_WIDTH : usize = TRIT_COUNT * TRIT_WIDTH; // 512

    // === Trit encoding ===
    // 00 =  0
    // 01 = +1
    // 10 = -1

    pub const TRIT_ZERO : [TRIT_WIDTH]u32 = [0, 0];
    pub const TRIT_POSITIVE : [TRIT_WIDTH]u32 = [0, 1];
    pub const TRIT_NEGATIVE : [TRIT_WIDTH]u32 = [1, 0];

    // === Input/Output types ===

    pub struct Inputs {
        clk : bool,
        rst : bool,
        valid_in : bool,
        a : [TOTAL_WIDTH]u32,
        b : [TOTAL_WIDTH]u32,
    }

    pub struct Outputs {
        valid_out : bool,
        result : [TOTAL_WIDTH]u32,
    }

    // === Constructor helpers ===

    fn inputs(clk: bool, rst: bool, valid_in: bool, a: [TOTAL_WIDTH]u32, b: [TOTAL_WIDTH]u32) -> Inputs {
        return Inputs{
            .clk = clk,
            .rst = rst,
            .valid_in = valid_in,
            .a = a,
            .b = b,
        };
    }

    fn outputs(valid_out: bool, result: [TOTAL_WIDTH]u32) -> Outputs {
        return Outputs{
            .valid_out = valid_out,
            .result = result,
        };
    }

    // === Core computation functions ===

    // Extract trit from position i in a 512-bit vector
    fn extract_trit(vector: [TOTAL_WIDTH]u32, i: usize) -> [TRIT_WIDTH]u32 {
        const start_idx : usize = i * TRIT_WIDTH;
        return [vector[start_idx], vector[start_idx + 1]];
    }

    // Compare two trits (2-bit vectors)
    fn trits_equal(trit1: [TRIT_WIDTH]u32, trit2: [TRIT_WIDTH]u32) -> bool {
        return trit1[0] == trit2[0] and trit1[1] == trit2[1];
    }

    // Majority voting function for two trits
    fn trit_majority(a_trit: [TRIT_WIDTH]u32, b_trit: [TRIT_WIDTH]u32) -> [TRIT_WIDTH]u32 {
        // Both negative -> negative
        if (trits_equal(a_trit, TRIT_NEGATIVE) and trits_equal(b_trit, TRIT_NEGATIVE)) {
            return TRIT_NEGATIVE;
        }
        // Both positive -> positive
        if (trits_equal(a_trit, TRIT_POSITIVE) and trits_equal(b_trit, TRIT_POSITIVE)) {
            return TRIT_POSITIVE;
        }
        // One zero, other non-zero -> take non-zero
        if (trits_equal(a_trit, TRIT_ZERO)) {
            return b_trit;
        }
        if (trits_equal(b_trit, TRIT_ZERO)) {
            return a_trit;
        }
        // Opposing signs -> zero
        return TRIT_ZERO;
    }

    // Compute all trit results for the bundle
    fn compute_trit_results(a: [TOTAL_WIDTH]u32, b: [TOTAL_WIDTH]u32) -> [TRIT_COUNT][TRIT_WIDTH]u32 {
        var results : [TRIT_COUNT][TRIT_WIDTH]u32 = undefined;
        
        for (i in 0..TRIT_COUNT) {
            const a_trit : [TRIT_WIDTH]u32 = extract_trit(a, i);
            const b_trit : [TRIT_WIDTH]u32 = extract_trit(b, i);
            results[i] = trit_majority(a_trit, b_trit);
        }
        
        return results;
    }

    // Pack trit results into a single 512-bit vector
    fn pack_trit_results(trit_results: [TRIT_COUNT][TRIT_WIDTH]u32) -> [TOTAL_WIDTH]u32 {
        var packed : [TOTAL_WIDTH]u32 = undefined;
        
        for (i in 0..TRIT_COUNT) {
            const start_idx : usize = i * TRIT_WIDTH;
            packed[start_idx] = trit_results[i][0];
            packed[start_idx + 1] = trit_results[i][1];
        }
        
        return packed;
    }

    // Pipeline simulation (1-clock delay)
    fn pipeline_step(input: Inputs, valid_in_prev: bool) -> Outputs {
        var result_vector : [TOTAL_WIDTH]u32 = undefined;
        
        if (input.rst) {
            // Reset state
            return outputs(false, [_]u32{0} ** TOTAL_WIDTH);
        } else {
            // Compute trit results and pack them
            const trit_results : [TRIT_COUNT][TRIT_WIDTH]u32 = compute_trit_results(input.a, input.b);
            result_vector = pack_trit_results(trit_results);
            return outputs(input.valid_in, result_vector);
        }
    }

    // === Test functions ===

    test extract_trit_basic {
        const test_vector : [4]u32 = [1, 0, 0, 1]; // positions 0: [1,0], 1: [0,1]
        const trit0 : [2]u32 = extract_trit(test_vector, 0);
        const trit1 : [2]u32 = extract_trit(test_vector, 1);
        assert trit0[0] == 1 and trit0[1] == 0; // TRIT_NEGATIVE
        assert trit1[0] == 0 and trit1[1] == 1; // TRIT_POSITIVE
    }

    test trits_equal_positive {
        assert trits_equal(TRIT_POSITIVE, TRIT_POSITIVE) == true;
        assert trits_equal(TRIT_POSITIVE, TRIT_NEGATIVE) == false;
        assert trits_equal(TRIT_POSITIVE, TRIT_ZERO) == false;
    }

    test trits_equal_negative {
        assert trits_equal(TRIT_NEGATIVE, TRIT_NEGATIVE) == true;
        assert trits_equal(TRIT_NEGATIVE, TRIT_POSITIVE) == false;
        assert trits_equal(TRIT_NEGATIVE, TRIT_ZERO) == false;
    }

    test trits_equal_zero {
        assert trits_equal(TRIT_ZERO, TRIT_ZERO) == true;
        assert trits_equal(TRIT_ZERO, TRIT_POSITIVE) == false;
        assert trits_equal(TRIT_ZERO, TRIT_NEGATIVE) == false;
    }

    test trit_majority_both_negative {
        const result : [2]u32 = trit_majority(TRIT_NEGATIVE, TRIT_NEGATIVE);
        assert trits_equal(result, TRIT_NEGATIVE) == true;
    }

    test trit_majority_both_positive {
        const result : [2]u32 = trit_majority(TRIT_POSITIVE, TRIT_POSITIVE);
        assert trits_equal(result, TRIT_POSITIVE) == true;
    }

    test trit_majority_negative_zero {
        const result : [2]u32 = trit_majority(TRIT_NEGATIVE, TRIT_ZERO);
        assert trits_equal(result, TRIT_NEGATIVE) == true;
    }

    test trit_majority_positive_zero {
        const result : [2]u32 = trit_majority(TRIT_POSITIVE, TRIT_ZERO);
        assert trits_equal(result, TRIT_POSITIVE) == true;
    }

    test trit_majority_zero_negative {
        const result : [2]u32 = trit_majority(TRIT_ZERO, TRIT_NEGATIVE);
        assert trits_equal(result, TRIT_NEGATIVE) == true;
    }

    test trit_majority_zero_positive {
        const result : [2]u32 = trit_majority(TRIT_ZERO, TRIT_POSITIVE);
        assert trits_equal(result, TRIT_POSITIVE) == true;
    }

    test trit_majority_opposite_signs {
        const result1 : [2]u32 = trit_majority(TRIT_NEGATIVE, TRIT_POSITIVE);
        const result2 : [2]u32 = trit_majority(TRIT_POSITIVE, TRIT_NEGATIVE);
        assert trits_equal(result1, TRIT_ZERO) == true;
        assert trits_equal(result2, TRIT_ZERO) == true;
    }

    test trit_majority_mixed_cases {
        // Test all 9 combinations from the truth table
        const test_cases : [9][2][2]u32 = [
            [TRIT_NEGATIVE, TRIT_NEGATIVE], // -1, -1 -> -1
            [TRIT_NEGATIVE, TRIT_ZERO],     // -1,  0 -> -1
            [TRIT_NEGATIVE, TRIT_POSITIVE], // -1, +1 ->  0
            [TRIT_ZERO, TRIT_NEGATIVE],     //  0, -1 -> -1
            [TRIT_ZERO, TRIT_ZERO],         //  0,  0 ->  0
            [TRIT_ZERO, TRIT_POSITIVE],     //  0, +1 -> +1
            [TRIT_POSITIVE, TRIT_NEGATIVE], // +1, -1 ->  0
            [TRIT_POSITIVE, TRIT_ZERO],     // +1,  0 -> +1
            [TRIT_POSITIVE, TRIT_POSITIVE], // +1, +1 -> +1
        ];
        
        const expected_results : [9][2]u32 = [
            TRIT_NEGATIVE, // -1
            TRIT_NEGATIVE, // -1
            TRIT_ZERO,    //  0
            TRIT_NEGATIVE, // -1
            TRIT_ZERO,    //  0
            TRIT_POSITIVE, // +1
            TRIT_ZERO,    //  0
            TRIT_POSITIVE, // +1
            TRIT_POSITIVE, // +1
        ];
        
        for (i in 0..9) {
            const result : [2]u32 = trit_majority(test_cases[i][0], test_cases[i][1]);
            assert trits_equal(result, expected_results[i]) == true;
        }
    }

    test compute_trit_results_simple {
        var a : [TOTAL_WIDTH]u32 = [_]u32{0} ** TOTAL_WIDTH;
        var b : [TOTAL_WIDTH]u32 = [_]u32{0} ** TOTAL_WIDTH;
        
        // Set first trit: a=-1, b=+1 -> result should be 0
        a[0] = 1; a[1] = 0; // TRIT_NEGATIVE
        b[0] = 0; b[1] = 1; // TRIT_POSITIVE
        
        const results : [TRIT_COUNT][TRIT_WIDTH]u32 = compute_trit_results(a, b);
        
        // trit 0: majority(-1, +1) = 0
        assert trits_equal(results[0], TRIT_ZERO) == true;
    }

    test pack_trit_results_basic {
        const trit_results : [2][2]u32 = [
            [1, 0], // TRIT_NEGATIVE
            [0, 1], // TRIT_POSITIVE
        ];
        const packed : [TOTAL_WIDTH]u32 = pack_trit_results(trit_results);
        assert packed[0] == 1 and packed[1] == 0; // first trit
        assert packed[2] == 0 and packed[3] == 1; // second trit
    }

    test pipeline_step_reset {
        const test_input : Inputs = inputs(true, true, false, [_]u32{0} ** TOTAL_WIDTH, [_]u32{0} ** TOTAL_WIDTH);
        const output : Outputs = pipeline_step(test_input, false);
        assert output.valid_out == false;
        // Check that result is all zeros (reset state)
        for (i in 0..TOTAL_WIDTH) {
            assert output.result[i] == 0;
        }
    }

    test pipeline_step_normal {
        // Create test input with specific trit values
        var test_a : [TOTAL_WIDTH]u32 = [_]u32{0} ** TOTAL_WIDTH;
        var test_b : [TOTAL_WIDTH]u32 = [_]u32{0} ** TOTAL_WIDTH;
        
        // Set first trit: a=-1, b=+1 -> result should be 0
        test_a[0] = 1; test_a[1] = 0; // TRIT_NEGATIVE
        test_b[0] = 0; test_b[1] = 1; // TRIT_POSITIVE
        
        const test_input : Inputs = inputs(true, false, true, test_a, test_b);
        const output : Outputs = pipeline_step(test_input, false);
        
        assert output.valid_out == true;
        // First trit should be 0 (opposite signs)
        assert output.result[0] == 0 and output.result[1] == 0;
    }

    test pipeline_step_passthrough {
        // Test that valid_in is passed through to valid_out
        const test_input : Inputs = inputs(true, false, true, [_]u32{0} ** TOTAL_WIDTH, [_]u32{0} ** TOTAL_WIDTH);
        const output : Outputs = pipeline_step(test_input, false);
        assert output.valid_out == true;
    }

    // === Invariants ===

    invariant trit_encoding_consistent {
        assert trits_equal(TRIT_ZERO, [0, 0]) == true;
        assert trits_equal(TRIT_POSITIVE, [0, 1]) == true;
        assert trits_equal(TRIT_NEGATIVE, [1, 0]) == true;
    }

    invariant trit_count_correct {
        assert TRIT_COUNT == 256;
        assert TRIT_WIDTH == 2;
        assert TOTAL_WIDTH == 512;
    }

    invariant extract_trit_bounds {
        // Test extraction within bounds
        const test_vector : [4]u32 = [1, 0, 0, 1];
        const trit0 : [2]u32 = extract_trit(test_vector, 0);
        const trit1 : [2]u32 = extract_trit(test_vector, 1);
        assert trit0[0] == 1 and trit0[1] == 0;
        assert trit1[0] == 0 and trit1[1] == 1;
    }

    invariant majority_function_completeness {
        // Test all combinations from the truth table
        const test_cases : [9][2][2]u32 = [
            [TRIT_NEGATIVE, TRIT_NEGATIVE],
            [TRIT_NEGATIVE, TRIT_ZERO],
            [TRIT_NEGATIVE, TRIT_POSITIVE],
            [TRIT_ZERO, TRIT_NEGATIVE],
            [TRIT_ZERO, TRIT_ZERO],
            [TRIT_ZERO, TRIT_POSITIVE],
            [TRIT_POSITIVE, TRIT_NEGATIVE],
            [TRIT_POSITIVE, TRIT_ZERO],
            [TRIT_POSITIVE, TRIT_POSITIVE],
        ];
        
        for (i in 0..9) {
            const result : [2]u32 = trit_majority(test_cases[i][0], test_cases[i][1]);
            // Result should always be a valid trit
            assert trits_equal(result, TRIT_ZERO) or 
                   trits_equal(result, TRIT_POSITIVE) or 
                   trits_equal(result, TRIT_NEGATIVE);
        }
    }

    invariant pack_unpack_consistency {
        const test_trits : [2][2]u32 = [
            [1, 0], // TRIT_NEGATIVE
            [0, 1], // TRIT_POSITIVE
        ];
        const packed : [4]u32 = pack_trit_results(test_trits);
        const unpacked0 : [2]u32 = extract_trit(packed, 0);
        const unpacked1 : [2]u32 = extract_trit(packed, 1);
        assert trits_equal(unpacked0, test_trits[0]) == true;
        assert trits_equal(unpacked1, test_trits[1]) == true;
    }

}

// phi^2 + 1/phi^2 = 3 | TRINITY