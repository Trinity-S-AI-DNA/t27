// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/uart_bridge_v2.t27
// Complete UART Bridge v2 implementation
// Port of gHashTag/trinity fpga/openxc7-synth/uart_bridge_v2.v
// Uses flat arrays + count fields (parser-compatible)
// phi^2 + 1/phi^2 = 3 | TRINITY

module uart_bridge_v2 {

    // === UART Configuration — 115200 baud @ 50 MHz ===

    pub const CLK_FREQ : u32 = 50_000_000;
    pub const BAUD_RATE : u32 = 115200;
    pub const BIT_DIV : u32 = CLK_FREQ / BAUD_RATE;  // 434

    // === RX State Machine ===

    pub struct RxState {
        pub cnt : u32,
        pub bit : u32,
        pub shift : u32,
        pub byte : u32,
        pub valid : bool,
        pub sync1 : bool,
        pub sync2 : bool,
    }

    pub const RX_IDLE : u32 = 0;
    pub const RX_START : u32 = 1;
    pub const RX_DATA_START : u32 = 2;
    pub const RX_DATA_END : u32 = 9;
    pub const RX_STOP : u32 = 10;

    // === TX State Machine ===

    pub struct TxState {
        pub cnt : u32,
        pub bit : u32,
        pub shift : u32,
        pub byte : u32,
        pub start : bool,
        pub busy : bool,
        pub ready : bool,
    }

    pub const TX_IDLE : u32 = 0;
    pub const TX_START : u32 = 1;
    pub const TX_DATA_START : u32 = 1;
    pub const TX_DATA_END : u32 = 10;
    pub const TX_STOP : u32 = 10;

    // === LED State ===

    pub struct LedState {
        pub cnt : u32,
        pub on : bool,
    }

    // === RX Functions ===

    fn rx_init() -> RxState {
        return RxState {
            cnt: 0,
            bit: RX_IDLE,
            shift: 0,
            byte: 0,
            valid: false,
            sync1: true,
            sync2: true,
        };
    }

    fn rx_update(state: RxState, uart_rx: bool, clk: bool) -> RxState {
        var new_state = state;
        
        // Two-stage synchronizer
        if (clk) {
            new_state.sync1 = uart_rx;
            new_state.sync2 = new_state.sync1;
        }

        // Clear valid flag each cycle
        new_state.valid = false;

        // RX State Machine
        if (state.bit == RX_IDLE) {
            // Wait for start bit (LOW)
            if (state.sync2 == false) {
                new_state.bit = RX_START;
                new_state.cnt = BIT_DIV / 2 - 1;
            }
        } else if (state.bit == RX_START) {
            // Start bit - transition to data
            if (state.cnt == 0) {
                new_state.cnt = BIT_DIV;
                new_state.bit = RX_DATA_START;
            } else {
                new_state.cnt = state.cnt - 1;
            }
        } else if (state.bit >= RX_DATA_START and state.bit <= RX_DATA_END) {
            // Data bits (LSB-first)
            if (state.cnt == 0) {
                new_state.cnt = BIT_DIV;
                // Shift right: new bit in MSB, others down
                new_state.shift = (if (state.sync2) 128 else 0) + (state.shift >> 1);
                new_state.bit = state.bit + 1;
            } else {
                new_state.cnt = state.cnt - 1;
            }
        } else if (state.bit == RX_STOP) {
            // Stop bit - validation
            if (state.cnt == 0) {
                if (state.sync2 == true) {  // Stop bit should be HIGH
                    new_state.byte = state.shift;
                    new_state.valid = true;
                }
                new_state.cnt = BIT_DIV;
                new_state.bit = RX_IDLE;
            } else {
                new_state.cnt = state.cnt - 1;
            }
        } else {
            // Invalid state - reset
            new_state.bit = RX_IDLE;
            new_state.cnt = 0;
        }

        return new_state;
    }

    // === TX Functions ===

    fn tx_init() -> TxState {
        return TxState {
            cnt: 0,
            bit: TX_IDLE,
            shift: 1023,  // 10'b1111111111 (all bits high for idle)
            byte: 0,
            start: false,
            busy: false,
            ready: true,
        };
    }

    fn tx_update(state: TxState, tx_start: bool, clk: bool, rx_byte: u32) -> TxState {
        var new_state = state;
        
        // Clear start flag each cycle
        new_state.start = false;

        // TX State Machine
        if (state.bit == TX_IDLE) {
            // Wait for transmission command
            new_state.ready = true;
            if (tx_start and !state.busy) {
                // Form packet: STOP(1) + D7...D0 + START(0)
                // LSB-first: bit 0 = START(0), bit 9 = STOP(1)
                new_state.shift = 512 + (rx_byte << 1);  // STOP bit + data + START bit
                new_state.bit = TX_START;
                new_state.cnt = BIT_DIV;
                new_state.busy = true;
                new_state.ready = false;
                new_state.start = true;
            }
        } else {
            // Transmit bits (1..10)
            if (state.cnt == 0) {
                new_state.cnt = BIT_DIV;
                if (state.bit == TX_STOP) {
                    // All bits transmitted
                    new_state.bit = TX_IDLE;
                    new_state.shift = 1023;  // Return to HIGH (idle)
                    new_state.busy = false;
                    new_state.ready = true;
                } else {
                    new_state.shift = (new_state.shift >> 1) | 512;  // Circular shift with STOP bit
                    new_state.bit = state.bit + 1;
                }
            } else {
                new_state.cnt = state.cnt - 1;
            }
        }

        return new_state;
    }

    // === LED Functions ===

    fn led_init() -> LedState {
        return LedState {
            cnt: 0,
            on: false,
        };
    }

    fn led_update(state: LedState, rx_valid: bool, clk: bool) -> LedState {
        var new_state = state;
        
        if (rx_valid) {
            new_state.on = true;
            new_state.cnt = 5_000_000;  // 100ms @ 50MHz
        } else if (state.cnt > 0) {
            new_state.cnt = state.cnt - 1;
        } else {
            new_state.on = false;
        }

        return new_state;
    }

    // === Echo Logic ===

    fn echo_logic(rx_valid: bool, tx_ready: bool, tx_byte: u32, tx_start: bool) -> (u32, bool) {
        if (rx_valid and tx_ready) {
            return (tx_byte, true);
        }
        return (tx_byte, tx_start);
    }

    // === Output Functions ===

    fn uart_tx_output(tx_shift: u32) -> bool {
        return (tx_shift & 1) != 0;  // LSB comes first
    }

    fn led_output(led_on: bool) -> bool {
        return !led_on;  // active-low
    }

    // === Simulation Interface ===

    pub struct Inputs {
        pub clk : bool,
        pub uart_rx : bool,
    }

    pub struct Outputs {
        pub uart_tx : bool,
        pub led : bool,
    }

    pub struct BridgeState {
        pub rx : RxState,
        pub tx : TxState,
        pub led : LedState,
    }

    fn bridge_init() -> BridgeState {
        return BridgeState {
            rx: rx_init(),
            tx: tx_init(),
            led: led_init(),
        };
    }

    fn bridge_step(inputs: Inputs, state: BridgeState, tx_start: bool) -> (Outputs, BridgeState) {
        // RX update
        var rx1 = rx_update(state.rx, inputs.uart_rx, inputs.clk);
        
        // TX update with echo logic
        var (tx_byte, echo_start) = echo_logic(rx1.valid, state.tx.ready, state.tx.byte, tx_start);
        var tx1 = tx_update(state.tx, echo_start, inputs.clk, rx1.byte);
        
        // LED update
        var led1 = led_update(state.led, rx1.valid, inputs.clk);
        
        // Outputs
        var outputs = Outputs {
            uart_tx: uart_tx_output(tx1.shift),
            led: led_output(led1.on),
        };
        
        // New state
        var new_state = BridgeState {
            rx: rx1,
            tx: tx1,
            led: led1,
        };
        
        return (outputs, new_state);
    }

    // === Tests ===

    test rx_init_test
        let state = rx_init()
        assert state.cnt == 0
        and state.bit == RX_IDLE
        and state.shift == 0
        and state.byte == 0
        and state.valid == false
        and state.sync1 == true
        and state.sync2 == true

    test rx_idle_to_start
        let state = RxState { cnt: 0, bit: RX_IDLE, shift: 0, byte: 0, valid: false, sync1: true, sync2: false }
        let new_state = rx_update(state, false, true)
        assert new_state.bit == RX_START
        and new_state.cnt == BIT_DIV / 2 - 1

    test rx_start_to_data
        let state = RxState { cnt: 0, bit: RX_START, shift: 0, byte: 0, valid: false, sync1: true, sync2: true }
        let new_state = rx_update(state, true, true)
        assert new_state.bit == RX_DATA_START
        and new_state.cnt == BIT_DIV

    test rx_data_shift
        let state = RxState { cnt: 0, bit: RX_DATA_START, shift: 0, byte: 0, valid: false, sync1: true, sync2: false }
        let new_state = rx_update(state, false, true)
        assert new_state.bit == RX_DATA_START + 1
        and new_state.shift == 0  // 0b00000000 (MSB gets new bit 0)

    test rx_stop_valid
        let state = RxState { cnt: 0, bit: RX_STOP, shift: 0xAA, byte: 0, valid: false, sync1: true, sync2: true }
        let new_state = rx_update(state, true, true)
        assert new_state.valid == true
        and new_state.byte == 0xAA

    test rx_stop_invalid
        let state = RxState { cnt: 0, bit: RX_STOP, shift: 0xAA, byte: 0, valid: false, sync1: true, sync2: false }
        let new_state = rx_update(state, false, true)
        assert new_state.valid == false

    test tx_init_test
        let state = tx_init()
        assert state.cnt == 0
        and state.bit == TX_IDLE
        and state.shift == 1023
        and state.byte == 0
        and state.start == false
        and state.busy == false
        and state.ready == true

    test tx_idle_to_start
        let state = tx_init()
        let new_state = tx_update(state, true, true, 0x55)
        assert new_state.bit == TX_START
        and new_state.cnt == BIT_DIV
        and new_state.busy == true
        and new_state.ready == false

    test tx_transmitting
        let state = TxState { cnt: 0, bit: TX_START, shift: 768, byte: 0x55, start: false, busy: true, ready: false }
        let new_state = tx_update(state, false, true, 0x55)
        assert new_state.bit == TX_START + 1
        and new_state.cnt == BIT_DIV

    test tx_transmission_complete
        let state = TxState { cnt: 0, bit: TX_STOP, shift: 512, byte: 0x55, start: false, busy: true, ready: false }
        let new_state = tx_update(state, false, true, 0x55)
        assert new_state.bit == TX_IDLE
        and new_state.shift == 1023
        and new_state.busy == false
        and new_state.ready == true

    test led_init_test
        let state = led_init()
        assert state.cnt == 0
        and state.on == false

    test led_flash_on
        let state = LedState { cnt: 0, on: false }
        let new_state = led_update(state, true, true)
        assert new_state.on == true
        and new_state.cnt == 5_000_000

    test led_flash_off
        let state = LedState { cnt: 1, on: true }
        let new_state = led_update(state, false, true)
        assert new_state.on == true
        and new_state.cnt == 0

    test led_flash_expired
        let state = LedState { cnt: 0, on: true }
        let new_state = led_update(state, false, true)
        assert new_state.on == false

    test echo_logic_active
        let rx_valid = true
        let tx_ready = true
        let tx_byte = 0x55
        let tx_start = false
        let (result_byte, result_start) = echo_logic(rx_valid, tx_ready, tx_byte, tx_start)
        assert result_byte == 0x55
        and result_start == true

    test echo_logic_inactive
        let rx_valid = false
        let tx_ready = true
        let tx_byte = 0x55
        let tx_start = false
        let (result_byte, result_start) = echo_logic(rx_valid, tx_ready, tx_byte, tx_start)
        assert result_byte == 0x55
        and result_start == false

    test uart_tx_output_low
        let tx_shift = 0
        assert uart_tx_output(tx_shift) == false

    test uart_tx_output_high
        let tx_shift = 1
        assert uart_tx_output(tx_shift) == true

    test led_output_active_low
        let led_on = true
        assert led_output(led_on) == false

    test led_output_inactive_high
        let led_on = false
        assert led_output(led_on) == true

    test bridge_init_test
        let state = bridge_init()
        assert state.rx.bit == RX_IDLE
        and state.tx.bit == TX_IDLE
        and state.led.on == false

    test bridge_step_echo
        let inputs = Inputs { clk: true, uart_rx: false }
        let state = bridge_init()
        let (outputs, new_state) = bridge_step(inputs, state, false)
        assert new_state.rx.bit == RX_IDLE
        and new_state.tx.bit == TX_IDLE
        and new_state.led.on == false

    // === Invariants ===

    invariant rx_state_valid
        let state = rx_init()
        assert state.bit <= RX_STOP

    invariant tx_state_valid
        let state = tx_init()
        assert state.bit <= TX_STOP

    invariant led_state_non_negative
        let state = led_init()
        assert state.cnt >= 0

    invariant uart_tx_output_boolean
        let shift = 0
        assert uart_tx_output(shift) == false or uart_tx_output(shift) == true

    invariant led_output_boolean
        let led_on = false
        assert led_output(led_on) == false or led_output(led_on) == true

    // === Benchmarks ===

    bench rx_update_latency
        measure: nanoseconds to rx_update(rx_init(), false, true)
        target: < 100ns

    bench tx_update_latency
        measure: nanoseconds to tx_update(tx_init(), false, true, 0)
        target: < 100ns

    bench led_update_latency
        measure: nanoseconds to led_update(led_init(), false, true)
        target: < 10ns

    bench echo_logic_latency
        measure: nanoseconds to echo_logic(false, true, 0x55, false)
        target: < 10ns

}

// phi^2 + 1/phi^2 = 3 | TRINITY