// Simple version of trinity_uart.t27 for testing compilation
// Port of gHashTag/trinity fpga/openxc7-synth/trinity_uart.v

module trinity_uart {

    // === Constants ===
    
    pub const DEFAULT_DIVISOR: u32 = 27;
    pub const CLK_MHZ: u32 = 50;
    pub const ADDR_DIVISOR: u32 = 0x200;
    pub const ADDR_TX_DATA: u32 = 0x204;
    pub const ADDR_RX_DATA: u32 = 0x208;
    pub const ADDR_STATUS: u32 = 0x20C;
    pub const STATUS_TX_READY: u32 = 0;
    pub const STATUS_RX_AVAIL: u32 = 1;
    
    // === Simple Structs ===
    
    pub struct UartRegisters {
        divisor: u32,
        tx_data: u32,
        rx_data: u32,
        tx_busy: bool,
        rx_valid: bool,
    }
    
    // === Constructor Functions ===
    
    fn default_registers() -> UartRegisters {
        return UartRegisters{
            .divisor = DEFAULT_DIVISOR,
            .tx_data = 0,
            .rx_data = 0,
            .tx_busy = false,
            .rx_valid = false,
        };
    }
    
    // === Status Functions ===
    
    fn status_tx_ready(regs: UartRegisters) -> bool {
        return !regs.tx_busy;
    }
    
    fn status_rx_avail(regs: UartRegisters) -> bool {
        return regs.rx_valid;
    }
    
    fn status_value(regs: UartRegisters) -> u32 {
        var status: u32 = 0;
        if (regs.rx_valid) {
            status = status | (1 << STATUS_RX_AVAIL);
        }
        if (!regs.tx_busy) {
            status = status | (1 << STATUS_TX_READY);
        }
        return status;
    }
    
    // === Memory Interface Functions ===
    
    fn read_data(addr: u32, regs: UartRegisters) -> u32 {
        if (addr == ADDR_DIVISOR) {
            return regs.divisor;
        } else if (addr == ADDR_RX_DATA) {
            return regs.rx_data;
        } else if (addr == ADDR_STATUS) {
            return status_value(regs);
        } else {
            return 0;
        }
    }
    
    fn write_data(addr: u32, wdata: u32, regs: UartRegisters) -> UartRegisters {
        if (addr == ADDR_DIVISOR) {
            return UartRegisters{
                .divisor = wdata & 0xFFF,
                .tx_data = regs.tx_data,
                .rx_data = regs.rx_data,
                .tx_busy = regs.tx_busy,
                .rx_valid = regs.rx_valid,
            };
        } else {
            return regs;
        }
    }
    
    // === Test Functions ===
    
    test default_divisor_correct
        then DEFAULT_DIVISOR == 27
    
    test status_functions
        given regs = UartRegisters{.divisor = 27, .tx_data = 0, .rx_data = 0, .tx_busy = false, .rx_valid = false}
        then status_tx_ready(regs) == true
        and status_rx_avail(regs) == false
        and status_value(regs) == (1 << STATUS_TX_READY)
        
        given regs = UartRegisters{.divisor = 27, .tx_data = 0, .rx_data = 0, .tx_busy = true, .rx_valid = false}
        then status_tx_ready(regs) == false
        and status_value(regs) == 0
        
        given regs = UartRegisters{.divisor = 27, .tx_data = 0, .rx_data = 0, .tx_busy = false, .rx_valid = true}
        then status_rx_avail(regs) == true
        and status_value(regs) == ((1 << STATUS_TX_READY) | (1 << STATUS_RX_AVAIL))
    
    test memory_interface
        given regs = default_registers()
        then read_data(ADDR_DIVISOR, regs) == DEFAULT_DIVISOR
        and read_data(ADDR_RX_DATA, regs) == 0
        and read_data(ADDR_STATUS, regs) == (1 << STATUS_TX_READY)
        
        given regs = write_data(ADDR_DIVISOR, 100, regs)
        then regs.divisor == 100
        
        given regs = write_data(0x300, 0xFF, regs)
        then regs.divisor == 100  // Should not change
    
    // === Invariants ===
    
    invariant divisor_positive
        then DEFAULT_DIVISOR > 0
    
    invariant status_bits_valid
        given status = 0x3
        then status <= 0x3  // Only 2 status bits
}