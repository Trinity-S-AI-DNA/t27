//! Port of gHashTag/trinity:fpga/openxc7-synth/vsa_quantum_top.v to .t27
//! (task gHashTag/t27#9323; original quoted at commit 341f1d150c70, 274 lines).
//!
//! The original is a single synthesizable module, `vsa_quantum_top` (lines
//! 17-271 of the .v): a 115200-baud UART receiver, a PING/MODE command
//! decoder, a parameter receiver for MODE bytes, a 32-bit LFSR, a 4-mode LED
//! mux and a UART TX responder (PONG 0xAA / OK 0x00). This port carries the
//! module's decisions as pure .t27 functions; every function cites the Verilog
//! lines it mirrors and every test asserts one of those decisions on chosen
//! inputs.
//!
//! Not lowered (plumbing): the clocked dataflow — free-running counters,
//! shift-register shifts, per-cycle flag pulses and resets. Its effect on the
//! decisions arrives as function parameters (counter values, shift-register
//! contents, current flags). Register widths are widened to u8/u32; every
//! stored value fits the original's reg widths, so all decisions are
//! unchanged. The original samples everything on the 50 MHz clock (always
//! blocks at lines 42, 108, 155, 196, 207, 225); these functions are their
//! per-cycle combinational content. The original's reset (rst, lines 19, 43,
//! 109, 156, 226) drives the registers back to the values the constants below
//! record.

module vsa_quantum_top {

// Bit extraction, used throughout the original as [n] part-selects
// (blink_counter[25], lfsr[31], rx_data[1:0] etc.). LSB is bit 0.
pub fn bit_at(value: u32, idx: u32) -> u32 {
    return (value / (1 << idx)) % 2;
}

// === UART RECEIVER (115200 baud @ 50MHz) ===
// Original line 27: Baud timer: 50MHz / 115200 = 434 cycles per bit.
pub const BAUD_DIV: u32 = 434;

// Original lines 37-40: UART RX state machine states.
pub const RX_IDLE: u8 = 0;
pub const RX_START: u8 = 1;
pub const RX_BITS: u8 = 2;
pub const RX_STOP: u8 = 3;

// Original line 34: wire rx_busy = (rx_state != 0);
pub fn rx_busy(rx_state: u8) -> bool {
    return rx_state != 0;
}

// Original line 51: if (!uart_rx) — the idle line is high, so low means a
// start bit.
pub fn rx_start_detected(uart_rx: bool) -> bool {
    return !uart_rx;
}

// Original line 58: if (baud_counter == BAUD_DIV/2 - 1) — the sample point is
// placed half a bit into the start bit.
pub fn rx_start_complete(baud_counter: u32) -> bool {
    return baud_counter == (BAUD_DIV / 2 - 1);
}

// Original lines 68 and 80: if (baud_counter == BAUD_DIV - 1) — one bit
// period has elapsed.
pub fn rx_bit_tick(baud_counter: u32) -> bool {
    return baud_counter == (BAUD_DIV - 1);
}

// Original line 71: if (rx_shift[2:0] == 3'b000) — the original's comment
// calls this "8 bits received"; as written it fires while the low three bits
// of the pre-shift register are clear.
pub fn rx_bits_done(rx_shift: u8) -> bool {
    return (rx_shift % 8) == 0;
}

// Original lines 70 and 81: rx_shift <= {uart_rx, rx_shift[7:1]} and
// rx_data <= {uart_rx, rx_shift[7:1]} — the receive register drops its LSB
// and shifts the sampled line in at bit 7.
pub fn rx_shift_step(uart_rx: bool, rx_shift: u8) -> u8 {
    if (uart_rx) {
        return rx_shift / 2 + 128;
    }
    return rx_shift / 2;
}

// Original lines 49-88: the case (rx_state) receiver machine. The parameters
// are the pre-edge register values; the result is the state the original
// leaves on this edge (when no branch fires, the state holds). The rx_data
// load and the rx_valid pulse of line 82 ride along with the STOP exit.
pub fn rx_next_state(rx_state: u8, uart_rx: bool, baud_counter: u32, rx_shift: u8) -> u8 {
    if (rx_state == RX_IDLE) {
        if (rx_start_detected(uart_rx)) {
            return RX_START;             // line 53
        }
        return RX_IDLE;
    }
    if (rx_state == RX_START) {
        if (rx_start_complete(baud_counter)) {
            return RX_BITS;              // line 60; also clears rx_shift (line 61)
        }
        return RX_START;                 // line 63: baud_counter <= baud_counter + 1
    }
    if (rx_state == RX_BITS) {
        if (rx_bit_tick(baud_counter)) {
            if (rx_bits_done(rx_shift)) {
                return RX_STOP;          // line 72
            }
            return RX_BITS;
        }
        return RX_BITS;                  // line 75: baud_counter <= baud_counter + 1
    }
    if (rx_state == RX_STOP) {
        if (rx_bit_tick(baud_counter)) {
            return RX_IDLE;              // line 83; also loads rx_data (line 81) and raises rx_valid (line 82)
        }
        return RX_STOP;                  // line 85: baud_counter <= baud_counter + 1
    }
    return RX_IDLE;
}

// === COMMAND DECODER ===
// Original lines 93-95: commands — 0xFF PING (respond with 0xAA PONG),
// 0x01 XX MODE (XX = LED mode parameter).

// Original lines 98-100: command types for the parameter receiver.
pub const CMD_NONE: u8 = 0;
pub const CMD_PING: u8 = 1;
pub const CMD_MODE: u8 = 2;

// Original lines 127-138: case (rx_data) — which command the received byte is.
pub fn decode_cmd_type(rx_data: u8) -> u8 {
    if (rx_data == 0xFF) {
        return CMD_PING;                 // line 130
    }
    if (rx_data == 0x01) {
        return CMD_MODE;                 // line 133
    }
    return CMD_NONE;                     // line 136
}

// Original line 129: send_pong <= 1, on the PING byte only.
pub fn decode_send_pong(rx_data: u8) -> bool {
    return rx_data == 0xFF;
}

// Original lines 103, 110: led_mode_reg reset value (2'b10 — the mode table
// at lines 200-204 names that ZERO).
pub const LED_MODE_DEFAULT: u8 = 2;

// Original lines 121 and 125: uart_received is raised by any received byte
// and cleared once blink_counter[23] is set (line 121 reads blink_counter,
// declared later in the original at line 206). When rx_valid fires on the
// same edge, line 125 is the last assignment and wins.
pub fn uart_received_next(uart_received: bool, rx_valid: bool, blink_counter: u32) -> bool {
    if (rx_valid) {
        return true;                     // line 125
    }
    if (uart_received and (bit_at(blink_counter, 23) == 1)) {
        return false;                    // line 122
    }
    return uart_received;
}

// === PARAMETER RECEIVER (for MODE commands) ===
// Original lines 143-145: state machine to receive the parameter byte after
// a MODE command; a UART byte time is ~87 microseconds = 4340 clock cycles.

// Original lines 147-149: parameter receiver states.
pub const PARAM_IDLE: u8 = 0;
pub const PARAM_WAIT: u8 = 1;
pub const PARAM_DONE: u8 = 2;

// Original line 164: param_timeout <= 4340 (~87 microseconds timeout). The
// original's timeout register is 13 bits (line 152); 4340 fits.
pub const PARAM_TIMEOUT_INIT: u32 = 4340;

// Original line 170: if (rx_valid && mode_cmd_pending) — apply the parameter.
pub fn param_apply_ok(rx_valid: bool, mode_cmd_pending: bool) -> bool {
    return rx_valid and mode_cmd_pending;
}

// Original lines 160-187: the case (param_state) parameter machine. The
// apply branch also sets led_mode_reg <= rx_data[1:0] (line 172) and
// send_ok <= 1 (line 173); the timeout branch also clears mode_cmd_pending
// (line 177).
pub fn param_next_state(param_state: u8, cmd_type: u8, rx_valid: bool, mode_cmd_pending: bool, param_timeout: u32) -> u8 {
    if (param_state == PARAM_IDLE) {
        if (cmd_type == CMD_MODE) {
            return PARAM_WAIT;           // line 163; also arms param_timeout (line 164) and mode_cmd_pending (line 165)
        }
        return PARAM_IDLE;
    }
    if (param_state == PARAM_WAIT) {
        if (param_apply_ok(rx_valid, mode_cmd_pending)) {
            return PARAM_DONE;           // line 174
        }
        if (param_timeout == 0) {
            return PARAM_IDLE;           // line 176: timeout
        }
        return PARAM_WAIT;               // line 179: param_timeout <= param_timeout - 1
    }
    if (param_state == PARAM_DONE) {
        return PARAM_IDLE;               // line 184; also clears mode_cmd_pending (line 185)
    }
    return param_state;
}

// Original line 172: led_mode_reg <= rx_data[1:0] — the two low bits of the
// parameter byte select the LED mode.
pub fn led_mode_of_param(rx_data: u8) -> u8 {
    return rx_data % 4;
}

// === LFSR (for chaotic LED mode) ===
// Original line 193: 32-bit LFSR seeded 32'hDEAD_BEEF.
pub const LFSR_SEED: u32 = 0xDEADBEEF;

// Original line 194: wire lfsr_feedback = lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0];
pub fn lfsr_feedback(lfsr: u32) -> u32 {
    return bit_at(lfsr, 31) ^ bit_at(lfsr, 21) ^ bit_at(lfsr, 1) ^ bit_at(lfsr, 0);
}

// Original line 197: lfsr <= {lfsr[30:0], lfsr_feedback}; — shift left, the
// feedback bit enters at bit 0. (lfsr % 0x80000000) * 2 drops bit 31 first,
// so the product stays inside u32.
pub fn lfsr_step(lfsr: u32) -> u32 {
    return (lfsr % 0x80000000) * 2 + lfsr_feedback(lfsr);
}

// === LED CONTROL ===
// Original lines 200-204: 4 modes (via MODE command 0x01 XX):
//   00: SEPARABLE - clean periodic blink (~1.5 Hz)
//   01: VIOLATION - chaotic/irregular (LFSR-driven)
//   10: ZERO - slow/constant (~0.75 Hz)
//   11: NEGATIVE - fast blink (~3 Hz)

// Original lines 211-214: the assign led = ... nested ternary chain.
pub fn led_bit(led_mode: u8, blink_counter: u32, lfsr: u32) -> bool {
    if (led_mode == 0) {
        return bit_at(blink_counter, 25) == 0;   // ~blink_counter[25]
    }
    if (led_mode == 1) {
        return bit_at(lfsr, 0) == 0;             // ~lfsr[0]
    }
    if (led_mode == 2) {
        return bit_at(blink_counter, 22) == 0;   // ~blink_counter[22]
    }
    return bit_at(blink_counter, 21) == 0;       // ~blink_counter[21]
}

// === UART TX (PONG and OK responses) ===
// Original lines 216-218: responds to PING (0xFF) with 0xAA PONG and to MODE
// commands with 0x00 OK.

// Original line 223: wire tx = (tx_state != 0) ? tx_data[0] : 1'b1; — the
// line carries the shifting data bit while transmitting and idles high.
pub fn tx_line(tx_state: u8, tx_data: u8) -> bool {
    if (tx_state != 0) {
        return (tx_data % 2) == 1;       // tx_data[0]
    }
    return true;                          // 1'b1 idle
}

// Original line 233: tx_data <= send_pong ? 8'hAA : 8'h00; — PONG or OK byte.
pub fn tx_payload(send_pong: bool) -> u8 {
    if (send_pong) {
        return 0xAA;
    }
    return 0x00;
}

// Original line 250: tx_data <= {1'b1, tx_data[7:1]} — the transmit register
// drops its LSB and shifts a mark bit in at bit 7.
pub fn tx_data_step(tx_data: u8) -> u8 {
    return tx_data / 2 + 128;
}

// Original line 251: if (tx_data[7:1] == 7'b1111111) — the original's
// data-bit exhaustion check on the pre-shift register.
pub fn tx_bits_done(tx_data: u8) -> bool {
    return (tx_data / 2) == 127;
}

// Original line 232: if ((send_pong || send_ok) && !tx_busy) — a response
// starts only when one is pending and the transmitter is idle.
pub fn tx_start_request(send_pong: bool, send_ok: bool, tx_busy: bool) -> bool {
    return (send_pong or send_ok) and !tx_busy;
}

// Original lines 230-265: the case (tx_state) transmitter machine (0 idle,
// 1 start bit, 2 data bits, 3 stop bit). The data phase also shifts tx_data
// (line 250) and the stop exit clears tx_busy (line 260).
pub fn tx_next_state(tx_state: u8, send_pong: bool, send_ok: bool, tx_busy: bool, tx_counter: u32, tx_data: u8) -> u8 {
    if (tx_state == 0) {
        if (tx_start_request(send_pong, send_ok, tx_busy)) {
            return 1;                    // line 234; also loads tx_payload(send_pong) (line 233)
        }
        return 0;
    }
    if (tx_state == 1) {
        if (tx_counter == (BAUD_DIV - 1)) {
            return 2;                    // line 242
        }
        return 1;                        // line 244: tx_counter <= tx_counter + 1
    }
    if (tx_state == 2) {
        if (tx_counter == (BAUD_DIV - 1)) {
            if (tx_bits_done(tx_data)) {
                return 3;                // line 252
            }
            return 2;
        }
        return 2;                        // line 254: tx_counter <= tx_counter + 1
    }
    if (tx_state == 3) {
        if (tx_counter == (BAUD_DIV - 1)) {
            return 0;                    // line 259
        }
        return 3;                        // line 262: tx_counter <= tx_counter + 1
    }
    return 0;
}

// The module's data surface: the LED line (original line 22, output wire
// led), driven by the same decision as lines 211-214.
pub fn on_comb(led_mode: u8, blink_counter: u32, lfsr: u32) -> bool {
    return led_bit(led_mode, blink_counter, lfsr);
}

// ==== Tests — each asserts a decision quoted above on chosen inputs. ====

test constants {
    // The constants drive the decisions, so they are checked through those
    // decisions' functions (literal-vs-literal compares would be folded away):
    assert(rx_bit_tick(BAUD_DIV - 1) == true);              // line 27: 50MHz / 115200 = 434
    assert(rx_start_complete(BAUD_DIV / 2 - 1) == true);    // line 58
    assert(led_bit(LED_MODE_DEFAULT, 0, 0) == true);        // line 103: mode 2 = ZERO
    assert(param_next_state(PARAM_WAIT, CMD_NONE, false, false, PARAM_TIMEOUT_INIT - 1) == PARAM_WAIT);  // line 164
    assert(lfsr_step(LFSR_SEED) == 0xBD5B7DDE);             // line 193: seed DEAD_BEEF
}

test bit_at_selects {
    assert(bit_at(0, 0) == 0);
    assert(bit_at(1, 0) == 1);
    assert(bit_at(0x02000000, 25) == 1);      // 2^25
    assert(bit_at(0x00400000, 22) == 1);      // 2^22
    assert(bit_at(0x00200000, 21) == 1);      // 2^21
    assert(bit_at(0x00800000, 23) == 1);      // 2^23
    assert(bit_at(0xDEADBEEF, 31) == 1);
    assert(bit_at(0xDEADBEEF, 30) == 1);
    assert(bit_at(0xDEADBEEF, 21) == 1);
    assert(bit_at(0xDEADBEEF, 1) == 1);
    assert(bit_at(0xDEADBEEF, 0) == 1);
    assert(bit_at(0xDEADBEEF, 29) == 0);
}

test baud_timing {
    // One bit period is 434 cycles; the start-bit sample sits half a bit in.
    assert(BAUD_DIV / 2 - 1 == 216);          // line 58 arithmetic
    assert(rx_start_complete(216) == true);   // line 58
    assert(rx_start_complete(215) == false);
    assert(rx_start_complete(433) == false);
    assert(rx_bit_tick(433) == true);         // lines 68, 80
    assert(rx_bit_tick(432) == false);
    assert(rx_bit_tick(0) == false);
}

test rx_start_detection {
    // Line 51: if (!uart_rx) — the idle line is high, so low means start.
    assert(rx_start_detected(false) == true);
    assert(rx_start_detected(true) == false);
}

test rx_busy_flag {
    // Line 34: wire rx_busy = (rx_state != 0);
    assert(rx_busy(RX_IDLE) == false);
    assert(rx_busy(RX_START) == true);
    assert(rx_busy(RX_BITS) == true);
    assert(rx_busy(RX_STOP) == true);
}

test rx_bits_done_cases {
    // Line 71: if (rx_shift[2:0] == 3'b000)
    assert(rx_bits_done(0b00000000) == true);
    assert(rx_bits_done(0b11111000) == true);
    assert(rx_bits_done(0b00000111) == false);
    assert(rx_bits_done(0b10101011) == false);
}

test rx_next_state_from_idle {
    // Lines 50-55: idle waits for a low start bit.
    assert(rx_next_state(RX_IDLE, false, 0, 0) == RX_START);
    assert(rx_next_state(RX_IDLE, true, 0, 0) == RX_IDLE);
}

test rx_next_state_from_start {
    // Lines 57-65: wait half a bit, then enter the data phase.
    assert(rx_next_state(RX_START, true, 215, 0) == RX_START);
    assert(rx_next_state(RX_START, true, 216, 0) == RX_BITS);
    assert(rx_next_state(RX_START, false, 216, 0) == RX_BITS);
}

test rx_next_state_from_bits {
    // Lines 67-77: on a bit tick the line-71 check may end the byte;
    // otherwise shifting continues.
    assert(rx_next_state(RX_BITS, true, 433, 0b11111000) == RX_STOP);
    assert(rx_next_state(RX_BITS, true, 433, 0b00000111) == RX_BITS);
    assert(rx_next_state(RX_BITS, true, 432, 0) == RX_BITS);
}

test rx_next_state_from_stop {
    // Lines 79-87: after the stop period, back to idle (rx_data and rx_valid
    // are set on that edge).
    assert(rx_next_state(RX_STOP, true, 433, 0b10101010) == RX_IDLE);
    assert(rx_next_state(RX_STOP, true, 432, 0) == RX_STOP);
}

test rx_shift_steps {
    // Lines 70/81: {uart_rx, rx_shift[7:1]} — the line bit enters at bit 7.
    assert(rx_shift_step(true, 0b00000010) == 0b10000001);
    assert(rx_shift_step(false, 0b11111111) == 0b01111111);
    assert(rx_shift_step(true, 0) == 0b10000000);
    assert(rx_shift_step(false, 0) == 0);
}

test command_decoder {
    // Lines 127-138.
    assert(decode_cmd_type(0xFF) == CMD_PING);
    assert(decode_cmd_type(0x01) == CMD_MODE);
    assert(decode_cmd_type(0x00) == CMD_NONE);
    assert(decode_cmd_type(0x02) == CMD_NONE);
    assert(decode_cmd_type(0xAB) == CMD_NONE);
    // Line 129: send_pong <= 1 only on PING.
    assert(decode_send_pong(0xFF) == true);
    assert(decode_send_pong(0x00) == false);
    assert(decode_send_pong(0x01) == false);
}

test uart_received_lifecycle {
    // Lines 121 and 125.
    assert(uart_received_next(false, true, 0) == true);            // a byte arrived
    assert(uart_received_next(true, false, 0x00800000) == false);  // blink_counter[23] clears
    assert(uart_received_next(true, false, 0) == true);            // bit 23 not set yet
    assert(uart_received_next(false, false, 0x00800000) == false);
    assert(uart_received_next(false, true, 0x00800000) == true);   // line 125 wins on the same edge
}

test param_next_state_transitions {
    // Lines 160-187.
    assert(param_next_state(PARAM_IDLE, CMD_MODE, false, false, PARAM_TIMEOUT_INIT) == PARAM_WAIT);  // line 163
    assert(param_next_state(PARAM_IDLE, CMD_PING, false, false, PARAM_TIMEOUT_INIT) == PARAM_IDLE);  // line 162 guard fails
    assert(param_next_state(PARAM_WAIT, CMD_NONE, true, true, 100) == PARAM_DONE);                   // line 174
    assert(param_next_state(PARAM_WAIT, CMD_NONE, true, false, 100) == PARAM_WAIT);                  // line 170 guard fails, timeout not 0
    assert(param_next_state(PARAM_WAIT, CMD_NONE, false, false, 0) == PARAM_IDLE);                   // line 176: timeout
    assert(param_next_state(PARAM_WAIT, CMD_NONE, false, false, 1) == PARAM_WAIT);                   // line 179: decrement
    assert(param_next_state(PARAM_DONE, CMD_NONE, false, true, 0) == PARAM_IDLE);                    // line 184
}

test param_apply_and_mode {
    // Line 170: if (rx_valid && mode_cmd_pending)
    assert(param_apply_ok(true, true) == true);
    assert(param_apply_ok(true, false) == false);
    assert(param_apply_ok(false, true) == false);
    // Line 172: led_mode_reg <= rx_data[1:0]
    assert(led_mode_of_param(0x00) == 0);
    assert(led_mode_of_param(0x01) == 1);
    assert(led_mode_of_param(0x02) == 2);
    assert(led_mode_of_param(0x03) == 3);
    assert(led_mode_of_param(0xFF) == 3);
    assert(led_mode_of_param(0x05) == 1);
}

test lfsr_feedback_bits {
    // Line 194: lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]
    assert(lfsr_feedback(0xDEADBEEF) == 0);   // 1 ^ 1 ^ 1 ^ 1
    assert(lfsr_feedback(0x00200000) == 1);   // only bit 21 set
    assert(lfsr_feedback(0x80000000) == 1);   // only bit 31 set
    assert(lfsr_feedback(1) == 1);            // only bit 0 set
    assert(lfsr_feedback(0) == 0);
}

test lfsr_step_values {
    // Line 197: lfsr <= {lfsr[30:0], lfsr_feedback};
    assert(lfsr_step(0xDEADBEEF) == 0xBD5B7DDE);
    assert(lfsr_step(1) == 3);                // {30'b0, 1, fb=1}
    assert(lfsr_step(0) == 0);
    assert(lfsr_step(0x80000000) == 1);       // bit 31 shifts out, feedback 1
}

test led_mux_modes {
    // Lines 211-214: SEPARABLE / VIOLATION / ZERO / NEGATIVE.
    assert(led_bit(0, 0x02000000, 0) == false);   // ~blink_counter[25]
    assert(led_bit(0, 0, 0) == true);
    assert(led_bit(1, 0, 0xDEADBEEF) == false);   // ~lfsr[0]
    assert(led_bit(1, 0, 0) == true);
    assert(led_bit(2, 0x00400000, 0) == false);   // ~blink_counter[22]
    assert(led_bit(2, 0, 0) == true);
    assert(led_bit(3, 0x00200000, 0) == false);   // ~blink_counter[21]
    assert(led_bit(3, 0, 0) == true);
    assert(led_bit(4, 0, 0) == true);             // 2-bit compare chain: anything past 2'b10 falls to NEGATIVE
}

test tx_line_and_payload {
    // Line 223: wire tx = (tx_state != 0) ? tx_data[0] : 1'b1;
    assert(tx_line(0, 0x00) == true);
    assert(tx_line(0, 0xAA) == true);
    assert(tx_line(1, 0x01) == true);
    assert(tx_line(2, 0x00) == false);
    assert(tx_line(3, 0x02) == false);
    // Line 233: tx_data <= send_pong ? 8'hAA : 8'h00;
    assert(tx_payload(true) == 0xAA);
    assert(tx_payload(false) == 0x00);
}

test tx_shift_and_bits_done {
    // Line 250: {1'b1, tx_data[7:1]} — a mark bit enters at bit 7.
    assert(tx_data_step(0xAA) == 0xD5);
    assert(tx_data_step(0x00) == 0b10000000);
    assert(tx_data_step(0xFF) == 0xFF);
    // Line 251: if (tx_data[7:1] == 7'b1111111)
    assert(tx_bits_done(0xFE) == true);
    assert(tx_bits_done(0xFF) == true);
    assert(tx_bits_done(0xAA) == false);
    assert(tx_bits_done(0x00) == false);
}

test tx_start_request_cases {
    // Line 232: if ((send_pong || send_ok) && !tx_busy)
    assert(tx_start_request(true, false, false) == true);
    assert(tx_start_request(false, true, false) == true);
    assert(tx_start_request(true, true, false) == true);
    assert(tx_start_request(true, true, true) == false);
    assert(tx_start_request(false, false, false) == false);
}

test tx_next_state_transitions {
    // Lines 230-265: 0 idle, 1 start, 2 data, 3 stop.
    assert(tx_next_state(0, true, false, false, 0, 0) == 1);        // line 234
    assert(tx_next_state(0, false, true, false, 0, 0) == 1);
    assert(tx_next_state(0, true, false, true, 0, 0) == 0);         // busy transmitter blocks
    assert(tx_next_state(0, false, false, false, 0, 0) == 0);
    assert(tx_next_state(1, false, false, true, 433, 0) == 2);      // line 242
    assert(tx_next_state(1, false, false, true, 432, 0) == 1);
    assert(tx_next_state(2, false, false, true, 433, 0xFE) == 3);   // line 252
    assert(tx_next_state(2, false, false, true, 433, 0x00) == 2);
    assert(tx_next_state(2, false, false, true, 100, 0xFE) == 2);
    assert(tx_next_state(3, false, false, true, 433, 0) == 0);      // line 259
    assert(tx_next_state(3, false, false, true, 432, 0) == 3);
}

test on_comb_led_line {
    // The module's data output (original line 22) follows lines 211-214.
    assert(on_comb(0, 0x02000000, 0) == false);
    assert(on_comb(0, 0, 0) == true);
    assert(on_comb(1, 0, 0xDEADBEEF) == false);
    assert(on_comb(1, 0, 0) == true);
    assert(on_comb(2, 0x00400000, 0) == false);
    assert(on_comb(3, 0x00200000, 0) == false);
}
}
