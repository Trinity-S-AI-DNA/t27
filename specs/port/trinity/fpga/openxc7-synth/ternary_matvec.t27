module ternary_matvec;

// Port of gHashTag/trinity hardware/rtl-root/ternary_matvec.v: the
// sequential ternary matrix-vector core, y[j] = sum_i W[i][j] * x[i]
// with W in {-1, 0, +1}, one (i, j) accumulation per clock.
//
// The Verilog is one posedge always-block; the port is the same machine
// as core_step -- one call is one clock -- over the register struct the
// module declares (state, i_idx, j_idx, acc, the result outputs, done,
// busy). Non-blocking assigns read old values: core_step reads every
// field before it writes it, which is the same discipline.
//
// Self-test data the original's header states, and this port keeps as
// its oracle:
//   W[i][j] = +1 if (i+j)%3==0, -1 if (i+j)%3==1, 0 otherwise
//   x[i]    = i + 1
//   y       = {43, -22, -21} repeating, 64 outputs
//
// The accumulator is 16-bit signed in hardware; the worst column sum
// here is sum(i+1) bounded by 2080, so i32 carries it without the wrap
// the register would never see either.

const STATE_IDLE: i32 = 0;
const STATE_COMPUTE: i32 = 1;
const STATE_OUTPUT: i32 = 2;
const STATE_DONE: i32 = 3;

// The Verilog's 2-bit encoding: 2'b01 = +1, 2'b10 = -1, 2'b00 = 0.
const WEIGHT_PLUS_1: i32 = 1;
const WEIGHT_MINUS_1: i32 = 2;
const WEIGHT_ZERO: i32 = 0;

// The module's registers, as one struct.
pub struct Core {
    state: i32,
    i_idx: i32,
    j_idx: i32,
    acc: i32,
    result_data: i32,
    result_addr: i32,
    result_valid: bool,
    done: bool,
    busy: bool,
}

pub fn core_reset() -> Core {
    return Core{
        .state = STATE_IDLE,
        .i_idx = 0,
        .j_idx = 0,
        .acc = 0,
        .result_data = 0,
        .result_addr = 0,
        .result_valid = false,
        .done = false,
        .busy = false,
    };
}

/// One clock edge of the always-block. rst dominates, as in hardware;
/// start is sampled only in IDLE.
pub fn core_step(c: *Core, rst: bool, start: bool) -> void {
    if (rst) {
        c.state = STATE_IDLE;
        c.i_idx = 0;
        c.j_idx = 0;
        c.acc = 0;
        c.result_data = 0;
        c.result_addr = 0;
        c.result_valid = false;
        c.done = false;
        c.busy = false;
        return;
    }
    // done and result_valid are pulses: low by default, set for one
    // clock by the state that earns them
    c.done = false;
    c.result_valid = false;

    if (c.state == STATE_IDLE) {
        if (start) {
            c.i_idx = 0;
            c.j_idx = 0;
            c.acc = 0;
            c.busy = true;
            c.state = STATE_COMPUTE;
        }
        return;
    }
    if (c.state == STATE_COMPUTE) {
        // accumulate by weight, then advance the inner index
        const w = weight_code(c.i_idx, c.j_idx);
        const x = input_value(c.i_idx);
        if (w == WEIGHT_PLUS_1) {
            c.acc = c.acc + x;
        } else {
            if (w == WEIGHT_MINUS_1) {
                c.acc = c.acc - x;
            }
        }
        if (c.i_idx == 63) {
            // inner loop finished for this column
            c.state = STATE_OUTPUT;
        } else {
            c.i_idx = c.i_idx + 1;
        }
        return;
    }
    if (c.state == STATE_OUTPUT) {
        // present this column's sum, then next column or finish
        c.result_data = c.acc;
        c.result_addr = c.j_idx;
        c.result_valid = true;
        if (c.j_idx == 63) {
            c.state = STATE_DONE;
        } else {
            c.j_idx = c.j_idx + 1;
            c.i_idx = 0;
            c.acc = 0;
            c.state = STATE_COMPUTE;
        }
        return;
    }
    // STATE_DONE: pulse done, go idle
    c.done = true;
    c.busy = false;
    c.state = STATE_IDLE;
}

/// W[i][j] as the Verilog's encoding: +1 when (i+j)%3==0, -1 when
/// (i+j)%3==1, 0 otherwise. The code and the mod-3 residue are NOT the
/// same number: residue 1 is weight -1, code 2.
pub fn weight_code(i_idx: i32, j_idx: i32) -> i32 {
    const residue = mod3(i_idx + j_idx);
    if (residue == 0) {
        return WEIGHT_PLUS_1;
    }
    if (residue == 1) {
        return WEIGHT_MINUS_1;
    }
    return WEIGHT_ZERO;
}

pub fn weight_to_signed(weight_code: i32) -> i32 {
    if (weight_code == WEIGHT_PLUS_1) {
        return 1;
    } else {
        if (weight_code == WEIGHT_MINUS_1) {
            return -1;
        } else {
            return 0;
        }
    }
}

/// x[i] = i + 1, the self-test input vector.
pub fn input_value(i_idx: i32) -> i32 {
    return i_idx + 1;
}

/// The oracle the original's header states: {43, -22, -21} repeating.
pub fn get_expected_pattern(j: u32) -> i32 {
    const mod3 = j % 3;
    if (mod3 == 0) {
        return 43;
    } else {
        if (mod3 == 1) {
            return -22;
        } else {
            return -21;
        }
    }
}

fn mod3(v: i32) -> i32 {
    return v % 3;
}

test full_run_matches_the_expected_pattern {
    var c = core_reset();
    // capture every pulsed result word by its address
    var results: [64]i32 = undefined;
    var got: i32 = 0;
    var saw_done: bool = false;
    var steps: i32 = 0;
    core_step(&c, false, true);
    steps += 1;
    assert(c.busy);
    while (saw_done == false and steps < 5000) {
        core_step(&c, false, false);
        steps += 1;
        if (c.result_valid) {
            results[(c.result_addr) as usize] = c.result_data;
            got += 1;
        }
        if (c.done) {
            saw_done = true;
        }
    }
    assert(saw_done);
    // one word per column, 64 columns
    assert(got == 64);
    assert(c.busy == false);
    // latency: 64 columns x (64 COMPUTE + 1 OUTPUT) + the DONE clock
    assert(steps == 4162);
    // the oracle: {43, -22, -21} repeating across all 64 outputs
    var j: i32 = 0;
    while (j < 64) {
        assert(results[(j) as usize] == get_expected_pattern((j) as u32));
        j += 1;
    }
    assert(results[0] == 43);
    assert(results[1] == -22);
    assert(results[2] == -21);
    assert(results[63] == 43);
}

test reset_dominates_any_state {
    var c = core_reset();
    core_step(&c, false, true);
    core_step(&c, false, false);
    assert(c.state == STATE_COMPUTE);
    core_step(&c, true, false);
    assert(c.state == STATE_IDLE);
    assert(c.acc == 0);
    assert(c.busy == false);
    assert(c.result_valid == false);
    assert(c.done == false);
}

test result_valid_pulses_one_clock {
    var c = core_reset();
    core_step(&c, false, true);
    var guard: i32 = 0;
    while (c.result_valid == false and guard < 200) {
        core_step(&c, false, false);
        guard += 1;
    }
    // first column's word is out, addressed 0
    assert(c.result_valid);
    assert(c.result_addr == 0);
    assert(c.result_data == 43);
    // the next clock clears the pulse; the next word is a full column
    // away
    core_step(&c, false, false);
    assert(c.result_valid == false);
}

test weight_encoding_matches_the_mod3_residue {
    // residue 0 -> +1 (code 1), residue 1 -> -1 (code 2), residue 2 -> 0
    assert(weight_code(0, 0) == WEIGHT_PLUS_1);
    assert(weight_code(1, 0) == WEIGHT_MINUS_1);
    assert(weight_code(2, 0) == WEIGHT_ZERO);
    assert(weight_code(3, 0) == WEIGHT_PLUS_1);
    assert(weight_to_signed(WEIGHT_PLUS_1) == 1);
    assert(weight_to_signed(WEIGHT_MINUS_1) == -1);
    assert(weight_to_signed(WEIGHT_ZERO) == 0);
    assert(input_value(0) == 1);
    assert(input_value(63) == 64);
}
