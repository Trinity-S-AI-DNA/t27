// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/definitive_diagnostic.t27
// Definitive LED Diagnostic Module for Trinity S^3AI
// Tests both pins with different blink rates for LED identification
// Uses counter-based timing for fast (~6 Hz) and slow (~1.5 Hz) blinks
// phi^2 + 1/phi^2 = 3 | TRINITY

module definitive_diagnostic_top {

    // === Clock and timing constants ===

    pub const CLOCK_FREQ_MHZ : u32 = 50;  // 50 MHz oscillator on U22
    pub const COUNTER_WIDTH : u32 = 26;   // 26-bit counter for timing divisions

    // === Blink rate bit positions ===
    // Bit 22: 50MHz / 2^23 = ~5.96 Hz (FAST) - for T23
    // Bit 24: 50MHz / 2^25 = ~1.49 Hz (SLOW) - for R23

    pub const FAST_BLINK_BIT : u32 = 22;   // T23 fast blink (~6 Hz)
    pub const SLOW_BLINK_BIT : u32 = 24;   // R23 slow blink (~1.5 Hz)

    // === Counter state ===

    pub struct CounterState {
        value : u32,
        cycles : u32,
    }

    // === Constructor helpers ===

    fn counter_state() -> CounterState {
        return CounterState{
            .value = 0,
            .cycles = 0,
        };
    }

    fn counter_next(state: CounterState) -> CounterState {
        return CounterState{
            .value = state.value + 1,
            .cycles = state.cycles + 1,
        };
    }

    // === Output computation functions ===

    fn get_fast_blink(state: CounterState) -> bool {
        return (state.value >> FAST_BLINK_BIT) & 1 == 1;
    }

    fn get_slow_blink(state: CounterState) -> bool {
        return (state.value >> SLOW_BLINK_BIT) & 1 == 1;
    }

    // === Simulation functions ===

    fn simulate_cycles(initial: CounterState, num_cycles: u32) -> CounterState {
        var state : CounterState = initial;
        var i : u32 = 0;
        while (i < num_cycles) {
            state = counter_next(state);
            i = i + 1;
        }
        return state;
    }

    fn get_blink_pattern(state: CounterState, num_samples: u32) -> [num_samples]bool {
        var pattern : [num_samples]bool = [_]bool{false} ** num_samples;
        var current : CounterState = state;
        
        var i : u32 = 0;
        while (i < num_samples) {
            pattern[i] = get_fast_blink(current);
            current = counter_next(current);
            i = i + 1;
        }
        return pattern;
    }

    fn get_slow_blink_pattern(state: CounterState, num_samples: u32) -> [num_samples]bool {
        var pattern : [num_samples]bool = [_]bool{false} ** num_samples;
        var current : CounterState = state;
        
        var i : u32 = 0;
        while (i < num_samples) {
            pattern[i] = get_slow_blink(current);
            current = counter_next(current);
            i = i + 1;
        }
        return pattern;
    }

    // === Validation functions ===

    fn counter_width_ok(value: u32) -> bool {
        return value < (1 << COUNTER_WIDTH);
    }

    fn blink_bit_position_valid(bit: u32) -> bool {
        return bit < COUNTER_WIDTH;
    }

    // === Tests ===

    test counter_increment
        given initial = counter_state()
        then simulate_cycles(initial, 10).value == 10
        and simulate_cycles(initial, 10).cycles == 10

    test fast_blink_computation
        given state = CounterState{.value = (1 << FAST_BLINK_BIT), .cycles = 0}
        then get_fast_blink(state) == true
        and get_fast_blink(CounterState{.value = 0, .cycles = 0}) == false

    test slow_blink_computation
        given state = CounterState{.value = (1 << SLOW_BLINK_BIT), .cycles = 0}
        then get_slow_blink(state) == true
        and get_slow_blink(CounterState{.value = 0, .cycles = 0}) == false

    test_fast_blink_pattern
        given state = CounterState{.value = 0, .cycles = 0}
        and pattern = get_blink_pattern(state, 8)
        then pattern[0] == false  // 2^22 = 4,194,304 cycles, so first 8 samples are 0
        and pattern[1] == false
        and pattern[2] == false
        and pattern[3] == false
        and pattern[4] == false
        and pattern[5] == false
        and pattern[6] == false
        and pattern[7] == false

    test_slow_blink_pattern
        given state = CounterState{.value = 0, .cycles = 0}
        and pattern = get_slow_blink_pattern(state, 8)
        then pattern[0] == false  // 2^24 = 16,777,216 cycles, so first 8 samples are 0
        and pattern[1] == false
        and pattern[2] == false
        and pattern[3] == false
        and pattern[4] == false
        and pattern[5] == false
        and pattern[6] == false
        and pattern[7] == false

    test_counter_width_validation
        given small_val = 100
        and large_val = (1 << COUNTER_WIDTH) - 1
        and overflow_val = (1 << COUNTER_WIDTH)
        then counter_width_ok(small_val) == true
        and counter_width_ok(large_val) == true
        and counter_width_ok(overflow_val) == false

    test_blink_bit_position_validation
        then blink_bit_position_valid(FAST_BLINK_BIT) == true
        and blink_bit_position_valid(SLOW_BLINK_BIT) == true
        and blink_bit_position_valid(COUNTER_WIDTH - 1) == true
        and blink_bit_position_valid(COUNTER_WIDTH) == false

    test_simulate_large_cycles
        given initial = counter_state()
        and result = simulate_cycles(initial, 1000000)
        then result.value == 1000000
        and result.cycles == 1000000

    // === Invariants ===

    invariant counter_width_positive
        assert COUNTER_WIDTH > 0

    invariant clock_frequency_positive
        assert CLOCK_FREQ_MHZ > 0

    invariant blink_bits_valid
        assert blink_bit_position_valid(FAST_BLINK_BIT)
        and blink_bit_position_valid(SLOW_BLINK_BIT)

    invariant fast_bit_before_slow_bit
        assert FAST_BLINK_BIT < SLOW_BLINK_BIT

    invariant counter_state_consistency
        given state = counter_state()
        assert state.value == 0
        and state.cycles == 0

    // === Benchmarks ===

    bench fast_blink_latency
        measure: nanoseconds to get_fast_blink(counter_state())
        target: < 10ns

    bench slow_blink_latency
        measure: nanoseconds to get_slow_blink(counter_state())
        target: < 10ns

    bench simulation_latency
        measure: nanoseconds to simulate_cycles(counter_state(), 1000)
        target: < 100ns
}

// phi^2 + 1/phi^2 = 3 | TRINITY