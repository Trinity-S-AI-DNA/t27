// ============================================================================
// ternary_attention.t27 — .t27 port of trinity fpga/openxc7-synth/ternary_attention.v
//
// Original file header (preserved):
//   "Ternary-weight single-head self-attention block
//    for the trinity FPGA pipeline (openxc7 synthesis target)."
//   ...
//   "sqrt(phi) = psi, and psi^2 + psi^-2 = 3 = TRINITY."
//
// Decisions ported (each as a pure function + test):
//   * 2-bit ternary weight decoding: 2'b01 = +1, 2'b10 = -1, any other
//     code (2'b00 / 2'b11) = 0.                              -> w_decode
//   * One ternary MatVec unit projects the token through Wq, then Wk, then
//     Wv (S_PROJ_Q -> S_PROJ_K -> S_PROJ_V), row-major weight addressing
//     {hd_idx, d_idx} = h * DIM + d.                         -> project
//   * The projected K/V of the current token land in cache slot ctx_pos;
//     scores are dot products of Q with cached keys for j = 0..ctx_pos
//     (causal window, token just cached included).           -> attn_score, ctx_used
//   * Fixed point Q8.8 (FRAC_BITS = 8): every product is scaled back by
//     >> FRAC_BITS after accumulation.                       -> attn_score, weighted_out
//   * No softmax: normalization is an arithmetic shift >> LOG2_CTX
//     (S_NORM "approx softmax").                             -> normalize
//   * Weighted sum out[h] = sum_j scores[j] * V_cache[j][h] scaled by
//     >> FRAC_BITS (S_WEIGHTED).                             -> weighted_out
//   * The 9-phase schedule of that datapath and its busy/done flags
//     (S_IDLE..S_DONE).                                      -> AttnPhase, next_phase,
//                                                               phase_busy, phase_done
//   * Output streaming: HEAD_DIM beats, beat h carries out_buf[h] at
//     address h (hd_idx zero-extended to the DIM-wide address) with
//     out_valid high (S_OUTPUT).                             -> StreamBeat, output_beat
//
// Porting divergences / not expressible in .t27 today:
//   * Memories with 1-cycle read latency (x_buf, k_cache, v_cache, the
//     weight ROMs behind $readmemb, lines 62-70 and 246-269 of the .v) are
//     plain flat slices here; the 1-cycle latency is pipeline plumbing.
//   * The .v accumulates with Verilog operator precedence:
//     `dot_acc <= dot_acc + (q*k) >>> FRAC_BITS` shifts the WHOLE running
//     sum every step, which would collapse the dot product to its last
//     term; the S_SCORE/S_WEIGHTED comments ("scores[j] = Q . K_cache[j]",
//     "out[d] = sum_j scores[j] * V_cache[j][d]") define a plain
//     fixed-point dot product, and that is what is ported.
//   * Per-cycle address/data steering between the single MatVec unit and
//     the memories (state register, ~line 269) is not expressible; its
//     schedule is ported as next_phase.
// ============================================================================

module ternary_attention {

// --- Parameters (Verilog `parameter` -> consts) ------------------------------

// DIM: input feature dimension, 3^5.
pub const DIM : usize = 243;
// HEAD_DIM: single-head attention width; also the number of streamed outputs.
pub const HEAD_DIM : usize = 64;
// CTX_LEN: capacity of the K/V cache, in tokens.
pub const CTX_LEN : usize = 16;
// ACC_WIDTH: signed width of input samples and accumulators (Q8.8 containers).
pub const ACC_WIDTH : usize = 20;
// FRAC_BITS: fixed-point fraction; products are scaled back by this shift.
pub const FRAC_BITS : u5 = 8;
// LOG2_CTX: normalization shift — 1/ctx in place of softmax (16 = 2^4).
pub const LOG2_CTX : u5 = 4;
// W_DEPTH: weight ROM depth, 1 << 14 = 16384 >= HEAD_DIM * DIM = 15552.
pub const W_DEPTH : usize = 1 << 14;
// KV_DEPTH: K/V cache depth = CTX_LEN * HEAD_DIM = 16 * 64 = 1024 slots
// (kept as a literal so the Verilog parameter stays a constant expression).
pub const KV_DEPTH : usize = 1024;

// --- Ternary weights ---------------------------------------------------------

// The .v w_decode case statement: 2'b01 adds the operand, 2'b10 subtracts
// it, every other cell contributes nothing.
pub fn w_decode(w_code : u8) -> i32 {
    switch (w_code) {
        1 => 1,
        2 => -1,
        else => 0,
    }
}

// One row of the ternary MatVec that projects token x through W. The same
// unit produces Q, K, and V rows (S_PROJ_Q / S_PROJ_K / S_PROJ_V). weights is
// the flattened ROM, row-major: cell (h, d) lives at h * dim + d, matching
// the original's {hd_idx, d_idx} concatenation addressing
// (addr = head_dim_idx * DIM + dim_idx).
pub fn project(weights : []const u8, x : []const i32, dim : usize, h : usize) -> i32 {
    var acc : i32 = 0;
    for d in 0..dim {
        var w : i32 = w_decode(weights[h * dim + d]);
        if (w == 1) {
            acc += x[d];
        }
        if (w == -1) {
            acc -= x[d];
        }
    }
    return acc;
}

// --- Attention ---------------------------------------------------------------

// S_SCORE: scores[j] = Q . K_cache[j], in Q8.8 — each product is scaled back
// by >> FRAC_BITS as it accumulates. k_cache is flat with the original's
// {j_idx, k_idx} concatenation layout: key (j, k) lives at
// j * head_dim + k.
pub fn attn_score(q : []const i32, k_cache : []const i32, head_dim : usize, j : usize) -> i32 {
    var acc : i32 = 0;
    for k in 0..head_dim {
        acc += (q[k] * k_cache[j * head_dim + k]) >> FRAC_BITS;
    }
    return acc;
}

// Number of cache slots attended. The original iterates j_idx while
// `j_idx == ctx_pos` ends the loop, so scores cover j = 0..ctx_pos — the
// causal prefix plus the token just cached.
pub fn ctx_used(ctx_pos : usize) -> usize {
    return ctx_pos + 1;
}

// S_NORM: fixed-point 1/ctx normalization — arithmetic shift right by
// LOG2_CTX (divide by 16, rounding toward -infinity), standing in for
// softmax. The .v line is `scores[j_idx] <= scores[j_idx] >>> LOG2_CTX;`.
pub fn normalize(score : i32) -> i32 {
    return score >> LOG2_CTX;
}

// S_WEIGHTED: out[h] = sum_j (scores[j] * V_cache[j][h]) >> FRAC_BITS.
// v_cache is flat with the same {j_idx, k_idx} layout, so column h of the
// cache is strided: v_cache[j * head_dim + h].
pub fn weighted_out(scores : []const i32, v_cache : []const i32, n_ctx : usize, head_dim : usize, h : usize) -> i32 {
    var acc : i32 = 0;
    for j in 0..n_ctx {
        acc += (scores[j] * v_cache[j * head_dim + h]) >> FRAC_BITS;
    }
    return acc;
}

// --- Control (the 9-state FSM) -----------------------------------------------

// The state register of the original (S_IDLE=0 .. S_DONE=8):
//   S_IDLE    — wait for start
//   S_PROJ_Q  — Q = Wq * x   (MatVec, 1st use)
//   S_PROJ_K  — K_new = Wk * x (MatVec, 2nd use)
//   S_PROJ_V  — V_new = Wv * x (MatVec, 3rd use)
//   S_SCORE   — scores[j] = Q . K_cache[j] (single dot-product unit)
//   S_NORM    — scores[j] >>= LOG2_CTX (approx softmax)
//   S_WEIGHTED — out[d] = sum_j scores[j] * V_cache[j][d]
//   S_OUTPUT  — stream HEAD_DIM outputs
//   S_DONE    — pulse done, return to idle
pub const AttnPhase = enum(u8) {
    idle = 0,
    proj_q = 1,
    proj_k = 2,
    proj_v = 3,
    score = 4,
    norm = 5,
    weighted = 6,
    output = 7,
    done = 8,
};

// Next state. In S_IDLE the FSM waits on `start`; every later phase runs to
// completion before handing over; S_DONE returns to S_IDLE.
pub fn next_phase(p : AttnPhase, start : bool) -> AttnPhase {
    switch (p) {
        .idle => if (start) .proj_q else .idle,
        .proj_q => .proj_k,
        .proj_k => .proj_v,
        .proj_v => .score,
        .score => .norm,
        .norm => .weighted,
        .weighted => .output,
        .output => .done,
        .done => .idle,
    }
}

// busy is high in every working phase (S_PROJ_Q..S_OUTPUT) and low while
// idle or done.
pub fn phase_busy(p : AttnPhase) -> bool {
    switch (p) {
        .idle => false,
        .done => false,
        else => true,
    }
}

// done pulses for exactly the S_DONE phase.
pub fn phase_done(p : AttnPhase) -> bool {
    switch (p) {
        .done => true,
        else => false,
    }
}

// --- Output streaming --------------------------------------------------------

// One streamed output beat (S_OUTPUT): out_addr = hd_idx zero-extended to
// the DIM-wide address — the value itself carries no offset, so beat h goes
// out at address h — with out_valid high while it flows.
pub struct StreamBeat {
    addr : usize,
    data : i32,
    valid : bool,
}

pub fn output_beat(out_buf : []const i32, h : usize) -> StreamBeat {
    return StreamBeat {
        .addr = h,
        .data = out_buf[h],
        .valid = true,
    };
}

// --- Tests -------------------------------------------------------------------
// All values are Q8.8: 256 means 1.0. head_dim/dim are passed explicitly so
// the kernels run on toy shapes the way the real datapath runs on DIM=243,
// HEAD_DIM=64.

test shape_parameters {
    // The Verilog parameter values themselves. The refs are runtime values
    // so the asserts execute instead of folding away.
    var dim_ref : usize = 243;
    var head_ref : usize = 64;
    var ctx_ref : usize = 16;
    var acc_ref : usize = 20;
    var w_depth_ref : usize = 16384;
    var kv_ref : usize = 1024;
    assert(DIM == dim_ref);
    assert(HEAD_DIM == head_ref);
    assert(CTX_LEN == ctx_ref);
    assert(ACC_WIDTH == acc_ref);
    assert(W_DEPTH == w_depth_ref);
    assert(KV_DEPTH == kv_ref);
    assert(FRAC_BITS == 8);
    assert(LOG2_CTX == 4);
}

test weight_decode {
    // 2'b01 = +1, 2'b10 = -1, and the unused codes 2'b00 / 2'b11 decode to 0.
    assert(w_decode(1) == 1);
    assert(w_decode(2) == -1);
    assert(w_decode(0) == 0);
    assert(w_decode(3) == 0);
}

test qkv_projection {
    // Row-major addressing {h, d} = h * dim + d, and the ternary signs:
    // x = [1.0, 0.5]; row0 = [+1, 0] -> +256; row1 = [-1, +1] -> -128.
    var x : [2]i32 = [256, 128];
    var w : [4]u8 = [1, 0, 2, 1];
    assert(project(&w, &x, 2, 0) == 256);
    assert(project(&w, &x, 2, 1) == -128);
    // An unused code cell (2'b11 = 3) contributes nothing.
    var w2 : [2]u8 = [3, 1];
    assert(project(&w2, &x, 2, 0) == 128);
}

test attn_scores {
    // q = [1.0, 1.0]; cached keys (2 slots x head_dim 2):
    //   slot 0 = [1.0, 0.0], slot 1 = [1.0, -1.0].
    // scores[0] = (256*256 + 256*0) >> 8 = 256
    // scores[1] = (256*256 - 256*256) >> 8 = 0
    var q : [2]i32 = [256, 256];
    var kc : [4]i32 = [256, 0, 256, -256];
    assert(attn_score(&q, &kc, 2, 0) == 256);
    assert(attn_score(&q, &kc, 2, 1) == 0);
    // Causal window: position p attends to p + 1 slots.
    assert(ctx_used(0) == 1);
    assert(ctx_used(3) == 4);
    assert(ctx_used(15) == 16);
}

test normalize_shift {
    // >> LOG2_CTX: 1.0 -> 1/16; negatives shift arithmetically (toward -inf).
    assert(normalize(256) == 16);
    assert(normalize(-64) == -4);
    assert(normalize(0) == 0);
}

test weighted_sum {
    // scores = [1/16, 0]; cached values (2 slots x head_dim 2):
    //   slot 0 = [0.25, 0.0], slot 1 = [1.0, 1.0].
    // out[0] = (16*64 + 0*256) >> 8 = 4; out[1] = (16*0 + 0*256) >> 8 = 0.
    var sc : [2]i32 = [16, 0];
    var vc : [4]i32 = [64, 0, 256, 256];
    assert(weighted_out(&sc, &vc, 2, 2, 0) == 4);
    assert(weighted_out(&sc, &vc, 2, 2, 1) == 0);
}

test phase_schedule {
    // S_IDLE holds until start, then the fixed order Q -> K -> V -> score ->
    // norm -> weighted -> output -> done -> idle.
    assert(next_phase(.idle, true) == .proj_q);
    assert(next_phase(.idle, false) == .idle);
    assert(next_phase(.proj_q, false) == .proj_k);
    assert(next_phase(.proj_k, false) == .proj_v);
    assert(next_phase(.proj_v, false) == .score);
    assert(next_phase(.score, false) == .norm);
    assert(next_phase(.norm, false) == .weighted);
    assert(next_phase(.weighted, false) == .output);
    assert(next_phase(.output, false) == .done);
    assert(next_phase(.done, false) == .idle);
    // busy: low in idle and done, high in every working phase.
    assert(!phase_busy(.idle));
    assert(phase_busy(.proj_q));
    assert(phase_busy(.score));
    assert(phase_busy(.output));
    assert(!phase_busy(.done));
    // done pulses exactly in the S_DONE phase.
    assert(!phase_done(.output));
    assert(phase_done(.done));
    assert(!phase_done(.idle));
}

test output_stream {
    // Beat h carries out_buf[h] at address h, valid while streaming.
    var ob : [3]i32 = [4, 7, 9];
    var b0 : StreamBeat = output_beat(&ob, 0);
    assert(b0.addr == 0);
    assert(b0.data == 4);
    assert(b0.valid);
    var b1 : StreamBeat = output_beat(&ob, 1);
    assert(b1.addr == 1);
    assert(b1.data == 7);
    assert(b1.valid);
    var b2 : StreamBeat = output_beat(&ob, 2);
    assert(b2.addr == 2);
    assert(b2.data == 9);
    assert(b2.valid);
}

test attention_end_to_end {
    // Toy replay of the whole datapath: dim = 2, head_dim = 2, ctx_pos = 1
    // (one token already cached, current token being processed).
    //
    // Token x = [1.0, 1.0] (Q8.8 256, 256).
    var x : [2]i32 = [256, 256];
    // Projection ROMs (row-major, cell (h, d) at h * dim + d):
    //   Wq = [[+1, 0], [ 0, +1]]  -> identity (Q = x)
    //   Wk = [[+1, 0], [ 0, -1]]  -> K_new = [1.0, -1.0]
    //   Wv = [[+1, 0], [ 0, +1]]  -> identity (V_new = x)
    var wq : [4]u8 = [1, 0, 0, 1];
    var wk : [4]u8 = [1, 0, 0, 2];
    var wv : [4]u8 = [1, 0, 0, 1];
    var q0 : i32 = project(&wq, &x, 2, 0);
    var q1 : i32 = project(&wq, &x, 2, 1);
    assert(q0 == 256);
    assert(q1 == 256);
    // S_PROJ_K / S_PROJ_V: the new token's K/V land in cache slot ctx_pos = 1
    // (flat layout {j, k} = j * head_dim + k). Slot 0 holds an earlier
    // token's K = [1.0, 0.0] and V = [0.25, 0.0].
    var k_cache : [4]i32 = [256, 0, 0, 0];
    var v_cache : [4]i32 = [64, 0, 0, 0];
    k_cache[1 * 2 + 0] = project(&wk, &x, 2, 0);
    k_cache[1 * 2 + 1] = project(&wk, &x, 2, 1);
    v_cache[1 * 2 + 0] = project(&wv, &x, 2, 0);
    v_cache[1 * 2 + 1] = project(&wv, &x, 2, 1);
    assert(k_cache[2] == 256);
    assert(k_cache[3] == -256);
    assert(v_cache[2] == 256);
    assert(v_cache[3] == 256);
    // S_SCORE over the causal window j = 0..ctx_pos (2 slots):
    //   score[0] = (256*256 + 256*0) >> 8 = 256
    //   score[1] = (256*256 - 256*256) >> 8 = 0
    var q_buf : [2]i32 = [q0, q1];
    var n_ctx : usize = ctx_used(1);
    assert(n_ctx == 2);
    var s0 : i32 = attn_score(&q_buf, &k_cache, 2, 0);
    var s1 : i32 = attn_score(&q_buf, &k_cache, 2, 1);
    assert(s0 == 256);
    assert(s1 == 0);
    // S_NORM (approx softmax, >> 4):
    var scores : [2]i32 = [normalize(s0), normalize(s1)];
    assert(scores[0] == 16);
    assert(scores[1] == 0);
    // S_WEIGHTED:
    //   out[0] = (16*64 + 0*256) >> 8 = 4
    //   out[1] = (16*0 + 0*256) >> 8 = 0
    var out_buf : [2]i32 = [0, 0];
    out_buf[0] = weighted_out(&scores, &v_cache, n_ctx, 2, 0);
    out_buf[1] = weighted_out(&scores, &v_cache, n_ctx, 2, 1);
    assert(out_buf[0] == 4);
    assert(out_buf[1] == 0);
    // S_OUTPUT: HEAD_DIM beats stream out, then the FSM settles in done.
    var beat : StreamBeat = output_beat(&out_buf, 0);
    assert(beat.addr == 0);
    assert(beat.data == 4);
    assert(beat.valid);
    var beat1 : StreamBeat = output_beat(&out_buf, 1);
    assert(beat1.addr == 1);
    assert(beat1.data == 0);
    assert(next_phase(.output, false) == .done);
    assert(phase_done(.done));
}
}
