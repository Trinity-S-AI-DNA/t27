// Port of gHashTag/trinity fpga/openxc7-synth/gf16_add.v to T27 specification
// Original: 286-line pipelined GF16 adder with handshake interface
// GF16 format: [sign:1][exp:6][mant:9] = 16 bits total
// Pipeline stages: 1=Decode+Align, 2=Core Addition, 3=Normalize+Round+Pack

module gf16_add {
    // Constants from original lines 46-49
    pub const GF16_EXP_BITS: u32 = 6;
    pub const GF16_EXP_BIAS: u32 = 31;  // (1 << (6-1)) - 1
    pub const GF16_MAX_EXP: u32 = 62;  // (1 << 6) - 2
    pub const GF16_MIN_EXP: u32 = 1;

    // Simplified structure for result
    pub struct Result {
        exp_final: u16,
        mant_final: u16,
        final_zero: bool,
    }

    // Top-level combinational function that implements the pipeline
    pub fn on_comb(
        in_a: u16,
        in_b: u16,
        in_op: u16,
    ) -> Result {
        // Stage 1: Decode operands
        let sign_a = (in_a >> 15) & 1;
        let sign_b = (in_b >> 15) & 1;
        let exp_a = (in_a >> 9) & 0x3F;
        let exp_b = (in_b >> 9) & 0x3F;
        
        // Add implicit leading 1 to mantissa (10 bits total)
        let mant_a = 0x200 | (in_a & 0x1FF);
        let mant_b = 0x200 | (in_b & 0x1FF);
        
        // Zero detection
        let is_zero_a = (in_a == 0);
        let is_zero_b = (in_b == 0);
        let is_result_zero = is_zero_a || is_zero_b;
        
        // Handle zero cases
        if (is_result_zero) {
            return Result { exp_final: 0, mant_final: 0, final_zero: true };
        }
        if (is_zero_a) {
            return Result { exp_final: exp_b, mant_final: mant_b & 0x1FF, final_zero: false };
        }
        if (is_zero_b) {
            return Result { exp_final: exp_a, mant_final: mant_a & 0x1FF, final_zero: false };
        }
        
        // Stage 2: Exponent alignment and mantissa addition
        let exp_diff = exp_a as i32 - exp_b as i32;
        let shift_b = if (exp_diff < 0) { 31 } else { exp_diff as u32 };
        
        // Shift mantissa B right by exponent difference
        let mant_b_shifted = if (shift_b >= 10) { 0 } else { mant_b >> shift_b };
        
        // Core addition (same sign)
        let mant_sum = mant_a + mant_b_shifted;
        let carry_out = (mant_sum & 0x400) != 0;
        
        // Stage 3: Normalize
        let exp_aligned = if (exp_a >= exp_b) { exp_a } else { exp_b };
        let (mant_normalized, exp_temp) = if (carry_out) {
            ((mant_sum >> 1) & 0x3FF, exp_aligned + 1)
        } else {
            (mant_sum & 0x3FF, exp_aligned)
        };
        
        // Exponent clamping
        let exp_final = if (exp_temp >= GF16_MAX_EXP) { GF16_MAX_EXP as u16 } 
                       else if (exp_temp < GF16_MIN_EXP) { 0 } 
                       else { exp_temp as u16 };
        
        // Simple rounding and packing
        let mant_final = mant_normalized & 0x1FF;
        
        return Result {
            exp_final: exp_final,
            mant_final: mant_final,
            final_zero: false,
        };
    }

    // Test basic functionality
    test basic_add {
        let a: u16 = 0x3E00;  // 1.0 * 2^30
        let b: u16 = 0x3E00;  // 1.0 * 2^30
        let op: u16 = 0;      // ADD operation
        
        let result = on_comb(a, b, op);
        
        // Should result in approximately 2.0 * 2^30
        assert(result.exp_final >= 30);
        assert(result.final_zero == false);
    }

    // Test zero handling
    test zero_handling {
        let a: u16 = 0x0000;  // Zero
        let b: u16 = 0x3E00;  // Non-zero
        let op: u16 = 0;      // ADD operation
        
        let result = on_comb(a, b, op);
        assert(result.final_zero == true);
    }

    // Test exponent alignment
    test exponent_alignment {
        let a: u16 = 0x4000;  // 1.0 * 2^32
        let b: u16 = 0x3E00;  // 1.0 * 2^30
        let op: u16 = 0;      // ADD operation
        
        let result = on_comb(a, b, op);
        
        // Result should be at least 2^32
        assert(result.exp_final >= 32);
        assert(result.final_zero == false);
    }

    // Test mantissa overflow
    test mantissa_overflow {
        let a: u16 = 0x3FF;   // Large mantissa
        let b: u16 = 0x3FF;   // Large mantissa
        let op: u16 = 0;      // ADD operation
        
        let result = on_comb(a, b, op);
        
        // Should handle overflow gracefully
        assert(result.final_zero == false);
    }
}