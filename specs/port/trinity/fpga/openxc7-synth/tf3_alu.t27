// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/fpga/openxc7-synth/tf3_alu.t27
// TF3 ALU — Ternary Float 9 Arithmetic Unit
//
// Implements basic TF3-9 operations:
// - tf3_add: saturating addition of two TF3-9 numbers
// - tf3_dot: configurable N-length dot product
//
// Ternary encoding:
//   00 -> 0
//   01 -> -1 (in 2's complement)
//   10 -> +1
//   11 -> invalid (treat as 0)
//
// TF3-9 format (18 bits):
//   [17:16] - sign trit (2 bits)
//   [15:10] - exp trits (6 bits = 3 trits)
//   [9:0]   - mant trits (10 bits = 5 trits)
//
// phi^2 + 1/phi^2 = 3 | TRINITY

module tf3_alu {

    // === Constants ===
    
    pub const TF3_WIDTH : u32 = 18;
    pub const SIGN_BITS : u32 = 2;
    pub const EXP_BITS : u32 = 6;
    pub const MANT_BITS : u32 = 10;
    
    // === Trit decoding helpers ===
    
    fn trit_decode(t : u32) -> i32 {
        if (t == 0b00) {
            return 0;
        } else if (t == 0b01) {
            return -1;
        } else if (t == 0b10) {
            return 1;
        } else {
            return 0;
        }
    }
    
    fn encode_trit(value : i32) -> u32 {
        if (value == -1) {
            return 0b01;
        } else if (value == 1) {
            return 0b10;
        } else {
            return 0b00;
        }
    }
    
    // === TF3-9 value extraction ===
    
    fn extract_sign(value : u32) -> u32 {
        return (value >> 16) & 3;  // TF3_WIDTH - SIGN_BITS = 18 - 2 = 16
    }
    
    fn extract_exp(value : u32) -> u32 {
        return (value >> 10) & 63;  // MANT_BITS = 10, 1 << EXP_BITS - 1 = 63
    }
    
    fn extract_mant(value : u32) -> u32 {
        return value & 1023;  // 1 << MANT_BITS - 1 = 1023
    }
    
    fn pack_tf3_value(sign : u32, exp : u32, mant : u32) -> u32 {
        return (sign << 16) | (exp << 10) | mant;
    }
    
    // === TF3 Addition (mode=00) ===
    
    fn tf3_add(a : u32, b : u32) -> u32 {
        // Extract fields
        var a_sign_raw : u32 = extract_sign(a);
        var a_exp_raw : u32 = extract_exp(a);
        var a_mant_raw : u32 = extract_mant(a);
        
        var b_sign_raw : u32 = extract_sign(b);
        var b_exp_raw : u32 = extract_exp(b);
        var b_mant_raw : u32 = extract_mant(b);
        
        // Decode sign trits to signed values
        var a_sign : i32 = trit_decode(a_sign_raw);
        var b_sign : i32 = trit_decode(b_sign_raw);
        
        // Sign addition with saturating arithmetic
        var sign_sum : i32 = a_sign + b_sign;
        var add_sign_ext : i32 = sign_sum + 1; // Offset by +1 for ternary range
        
        // Saturating result for sign
        var add_result_sign : u32 = 0;
        if (add_sign_ext > 1) {
            add_result_sign = 2; // +1 (0b10)
        } else if (add_sign_ext < 0) {
            add_result_sign = 1; // -1 (0b01)
        } else {
            add_result_sign = 0; // 0 (0b00)
        }
        
        // Mantissa addition (10-bit)
        var mant_sum : u32 = a_mant_raw + b_mant_raw;
        var mant_carry : bool = mant_sum >= 1024;
        
        // Exponent addition with carry propagation
        var exp_sum : u32 = a_exp_raw + b_exp_raw;
        var add_result_exp : u32 = exp_sum;
        if (mant_carry) {
            add_result_exp = add_result_exp + 1;
        }
        
        var add_result_mant : u32 = mant_sum & 1023;
        
        // Pack result
        return pack_tf3_value(add_result_sign, add_result_exp, add_result_mant);
    }
    
    // === TF3 Dot Product (mode=01) ===
    
    fn tf3_dot(a : u32, b : u32) -> u32 {
        // Extract fields
        var a_sign_raw : u32 = extract_sign(a);
        var a_exp_raw : u32 = extract_exp(a);
        var a_mant_raw : u32 = extract_mant(a);
        
        var b_sign_raw : u32 = extract_sign(b);
        var b_exp_raw : u32 = extract_exp(b);
        var b_mant_raw : u32 = extract_mant(b);
        
        // For dot product, we multiply mantissas and add exponents
        // Sign follows XOR rule
        var mant_product : u32 = a_mant_raw * b_mant_raw;
        var exp_product : u32 = a_exp_raw + b_exp_raw;
        var sign_product : u32 = a_sign_raw ^ b_sign_raw;
        
        // Use lower 8 bits of mantissa product (10-bit result truncated to 8 bits)
        var truncated_mant : u32 = mant_product & 255;
        
        // Pack partial result for accumulation
        return pack_tf3_value(sign_product, exp_product, truncated_mant);
    }
    
    // === Main combinational function ===
    
    fn tf3_alu_combinational(
        mode : u32,
        in_a : u32,
        in_b : u32,
        dot_len : u32,
        in_valid : bool,
        out_ready : bool
    ) -> (bool, u32) {
        
        var out_valid : bool = false;
        var out_y : u32 = 0;
        
        // Always ready for input
        var in_ready : bool = true;
        
        // Process new input when ready
        if (in_valid and in_ready) {
            if (mode == 0b00) {
                // TF3 Addition
                out_y = tf3_add(in_a, in_b);
                out_valid = true;
            } else if (mode == 0b01) {
                // TF3 Dot Product (simplified - just one multiplication)
                out_y = tf3_dot(in_a, in_b);
                out_valid = true;
            } else {
                // Invalid mode - pass through A
                out_y = in_a;
                out_valid = true;
            }
        }
        
        // Clear valid when output is consumed
        if (out_ready and out_valid) {
            out_valid = false;
        }
        
        return (in_ready, out_y, out_valid);
    }
    
    // === Tests ===
    
    test trit_decode_cases
        then trit_decode(0b00) == 0
        and trit_decode(0b01) == -1
        and trit_decode(0b10) == 1
        and trit_decode(0b11) == 0
    
    test encode_trit_cases
        then encode_trit(0) == 0b00
        and encode_trit(-1) == 0b01
        and encode_trit(1) == 0b10
        and encode_trit(2) == 0b00
    
    test extract_fields
        given value = pack_tf3_value(2, 42, 255)
        then extract_sign(value) == 2
        and extract_exp(value) == 42
        and extract_mant(value) == 255
    
    test pack_and_unpack
        given original = pack_tf3_value(1, 63, 511)
        then extract_sign(original) == 1
        and extract_exp(original) == 63
        and extract_mant(original) == 511
    
    test tf3_add_simple
        given a = pack_tf3_value(0, 0, 1)  // +1
        given b = pack_tf3_value(0, 0, 1)  // +1
        then tf3_add(a, b) == pack_tf3_value(0, 0, 2)  // +2
    
    test tf3_add_with_sign
        given a = pack_tf3_value(2, 0, 1)  // +1
        given b = pack_tf3_value(1, 0, 1)  // -1
        then tf3_add(a, b) == pack_tf3_value(0, 0, 0)  // 0
    
    test tf3_dot_simple
        given a = pack_tf3_value(0, 0, 2)  // +2
        given b = pack_tf3_value(0, 0, 2)  // +2
        then tf3_dot(a, b) == pack_tf3_value(0, 0, 0)  // 4 (truncated to 0)
    
    test tf3_dot_with_sign
        given a = pack_tf3_value(2, 0, 2)  // +2
        given b = pack_tf3_value(1, 0, 2)  // -2
        then tf3_dot(a, b) == pack_tf3_value(3, 0, 0)  // negative sign
    
    test tf3_alu_combinational_add
        given (in_ready, out_y, out_valid) = tf3_alu_combinational(0b00, pack_tf3_value(0, 0, 1), pack_tf3_value(0, 0, 1), 4, true, true)
        then in_ready == true
        and out_valid == true
        and out_y == pack_tf3_value(0, 0, 2)
    
    test tf3_alu_combinational_dot
        given (in_ready, out_y, out_valid) = tf3_alu_combinational(0b01, pack_tf3_value(0, 0, 2), pack_tf3_value(0, 0, 2), 1, true, true)
        then in_ready == true
        and out_valid == true
        and out_y == tf3_dot(pack_tf3_value(0, 0, 2), pack_tf3_value(0, 0, 2))
    
    test tf3_alu_combinational_invalid_mode
        given (in_ready, out_y, out_valid) = tf3_alu_combinational(0b11, pack_tf3_value(2, 0, 1), pack_tf3_value(2, 0, 1), 4, true, true)
        then in_ready == true
        and out_valid == true
        and out_y == pack_tf3_value(2, 0, 1)
    
    // === Invariants ===
    
    invariant tf3_width_constant
        assert TF3_WIDTH == 18
    
    invariant sign_bits_constant
        assert SIGN_BITS == 2
    
    invariant exp_bits_constant
        assert EXP_BITS == 6
    
    invariant mant_bits_constant
        assert MANT_BITS == 10
    
    invariant field_widths_sum
        assert SIGN_BITS + EXP_BITS + MANT_BITS == TF3_WIDTH
    
    invariant trit_decode_range
        then trit_decode(0b00) >= -1
        and trit_decode(0b00) <= 1
        and trit_decode(0b01) >= -1
        and trit_decode(0b01) <= 1
        and trit_decode(0b10) >= -1
        and trit_decode(0b10) <= 1
    
    invariant encode_decode_consistency
        then encode_trit(trit_decode(0b00)) == 0b00
        and encode_trit(trit_decode(0b01)) == 0b01
        and encode_trit(trit_decode(0b10)) == 0b10
    
    invariant packed_value_bounds
        given value = pack_tf3_value(3, 63, 1023)
        then extract_sign(value) <= 3
        and extract_exp(value) <= 63
        and extract_mant(value) <= 1023
}

// phi^2 + 1/phi^2 = 3 | TRINITY