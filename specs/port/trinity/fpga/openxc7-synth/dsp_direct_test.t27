//! Port of trinity's fpga/openxc7-synth/dsp_direct_test.v (gHashTag/trinity at
//! 990aa6f23054): Direct test of DSP48E1 multiplier, connects inputs to switches,
//! outputs to LEDs. Expected: 3 DSP48E1 cells in synthesis.

module dsp_direct_test {

    // The original's constants: 32-bit operands and result
    pub const DATA_WIDTH: u32 = 32;
    pub const SWITCH_WIDTH: u32 = 32;
    pub const A_WIDTH: u32 = 16;  // Upper switches = A
    pub const B_WIDTH: u32 = 16;  // Lower switches = B

    // The module's interface as described by the original
    pub struct Inputs {
        clk: bool,
        rst: bool,
        sw: u32,    // Switches for A and B
        valid: bool // Valid signal
    }

    pub struct Outputs {
        led: u32,   // Result output
        busy: bool  // Busy indicator
    }

    // The original's decision: instantiate dsp_mul32 multiplier
    // The multiplier takes A=sw[31:16] and B=sw[15:0], produces result and valid_out
    pub fn multiplier_interface(inputs: Inputs) -> Outputs {
        // Split the switch input into A and B operands
        const a: u32 = (inputs.sw >> 16) & 0xFFFF;  // Upper switches = A
        const b: u32 = inputs.sw & 0xFFFF;          // Lower switches = B
        
        // Use the existing dsp_mul functionality from dsp_mul.t27
        // The original instantiates dsp_mul32 multiplier, so we call the combinational function
        var result: u32 = 0;
        
        // Simulate the multiplier behavior (this would be generated from dsp_mul.t27)
        if (inputs.valid) {
            var full: u64 = (a as u64) * (b as u64);
            result = full as u32;
        }
        
        // The busy signal is the valid_out from the multiplier
        // In a pipelined multiplier, this would indicate when the result is valid
        var busy: bool = inputs.valid;  // Simplified for direct test
        
        return Outputs{
            .led = result,
            .busy = busy
        };
    }

    // Reset state for the module
    pub fn reset_state() -> Inputs {
        return Inputs{
            .clk = false,
            .rst = true,  // Active high reset
            .sw = 0,
            .valid = false
        };
    }

    // Test the multiplier interface with basic values
    test multiplier_basic {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0x00010001,  // A=1, B=1
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 1);  // 1 * 1 = 1
        assert(outputs.busy == true);
    }

    // Test with larger values that require 16-bit multiplication
    test multiplier_16bit {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0xFFFE0001,  // A=0xFFFE (65534), B=1
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 65534);  // 65534 * 1 = 65534
        assert(outputs.busy == true);
    }

    // Test with both operands non-zero
    test multiplier_both_operands {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0x00080004,  // A=8, B=4
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 32);  // 8 * 4 = 32
        assert(outputs.busy == true);
    }

    // Test with valid signal low (should produce zero result)
    test valid_low {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0x00010001,  // A=1, B=1
            .valid = false
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 0);  // No valid input, no result
        assert(outputs.busy == false);
    }

    // Test reset behavior
    test reset_active {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = true,  // Reset active
            .sw = 0x00010001,  // A=1, B=1
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        // Reset should clear the state, but in this direct test the result still computes
        // In a real pipelined implementation, reset would clear pipeline registers
        assert(outputs.led == 1);  // 1 * 1 = 1 (combinational path)
        assert(outputs.busy == true);
    }

    // Test edge case: maximum 16-bit values
    test max_16bit_values {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0xFFFF0000 | 0xFFFF,  // A=0xFFFF, B=0xFFFF
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 65535 * 65535);  // 0xFFFF * 0xFFFF = 4294836225
        assert(outputs.busy == true);
    }

    // Test with zero operands
    test zero_operands {
        var inputs: Inputs = Inputs{
            .clk = true,
            .rst = false,
            .sw = 0x00000000,  // A=0, B=0
            .valid = true
        };
        
        var outputs: Outputs = multiplier_interface(inputs);
        assert(outputs.led == 0);  // 0 * 0 = 0
        assert(outputs.busy == true);
    }
}