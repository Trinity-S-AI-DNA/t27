module hslm_dynamic_top;

// Constants from the original Verilog
pub const N_SMALL = 243;
pub const N_LARGE = 729;
pub const ACC_WIDTH = 20;
pub const FRAC_BITS = 8;
pub const VOCAB = 128;
pub const LM_ACC = 32;
pub const CLK_DIV = 27;

// State enums
pub enum RxState {
    idle,
    start,
    data,
    stop,
}

pub enum CmdMode {
    idle,
    infer,
    weight,
}

// Test basic constant values
test constants_check {
    assert(N_SMALL == 243);
    assert(N_LARGE == 729);
    assert(ACC_WIDTH == 20);
    assert(FRAC_BITS == 8);
    assert(VOCAB == 128);
    assert(LM_ACC == 32);
    assert(CLK_DIV == 27);
}

// Test enum values
test enum_values {
    assert(RxState.idle == RxState.idle);
    assert(RxState.start == RxState.start);
    assert(RxState.data == RxState.data);
    assert(RxState.stop == RxState.stop);
    
    assert(CmdMode.infer == CmdMode.infer);
    assert(CmdMode.weight == CmdMode.weight);
}

// Simple function that mimics some basic logic from the original
pub fn calculate_debug_state(cmd_mode: CmdMode, weight_loading: bool) -> bool {
    if (weight_loading) {
        return true;
    }
    return cmd_mode == CmdMode.infer;
}

test debug_state_logic {
    assert(calculate_debug_state(CmdMode.infer, false) == true);
    assert(calculate_debug_state(CmdMode.weight, false) == false);
    assert(calculate_debug_state(CmdMode.idle, false) == false);
    assert(calculate_debug_state(CmdMode.infer, true) == true);
}

// Simple LED state calculation
pub fn calculate_led_state(cmd_mode: CmdMode, weight_loading: bool) -> bool {
    if (weight_loading) {
        return false;  // Slow blink during weight loading
    }
    if (cmd_mode == CmdMode.infer) {
        return false;  // Fast blink during inference
    }
    return true;  // Solid ON = ready
}

test led_state_logic {
    assert(calculate_led_state(CmdMode.idle, false) == true);
    assert(calculate_led_state(CmdMode.infer, false) == false);
    assert(calculate_led_state(CmdMode.weight, false) == false);
    assert(calculate_led_state(CmdMode.idle, true) == false);
}

// Simple UART command router logic
pub fn route_command(cmd_byte: u8, got_sync: bool) -> CmdMode {
    if (!got_sync) {
        return CmdMode.idle;
    }
    
    if (cmd_byte >= 0x10 and cmd_byte <= 0x1F) {
        return CmdMode.infer;
    } else if (cmd_byte >= 0x01 and cmd_byte <= 0xF) {
        return CmdMode.weight;
    }
    
    return CmdMode.idle;
}

test command_routing {
    assert(route_command(0x00, false) == CmdMode.idle);
    assert(route_command(0xAA, false) == CmdMode.idle);
    assert(route_command(0x10, true) == CmdMode.infer);
    assert(route_command(0x1F, true) == CmdMode.infer);
    assert(route_command(0x01, true) == CmdMode.weight);
    assert(route_command(0x0F, true) == CmdMode.weight);
    assert(route_command(0x20, true) == CmdMode.idle);
}