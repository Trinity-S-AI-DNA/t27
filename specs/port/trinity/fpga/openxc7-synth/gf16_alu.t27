// t27/specs/port/trinity/fpga/openxc7-synth/gf16_alu.t27
// Port of fpga/openxc7-synth/gf16_alu.v to the t27 spec language (ticket #9170)
// GF16 ALU: Golden Float 16 Arithmetic Unit with pipelined ADD and MUL operations
// GF16 format: [sign:1][exp:6][mant:9] = 16 bits total, bias 31
// Operations: OP_ADD (2'b00), OP_MUL (2'b01)
// Pipeline: 3 stages minimum with handshake interface
// phi^2 + 1/phi^2 = 3 | TRINITY

module gf16_alu {

    // === GF16 FORMAT CONSTANTS ===
    pub const GF16_EXP_BITS: u32 = 6;
    pub const GF16_EXP_BIAS: u32 = 31;
    pub const GF16_MAX_EXP: u32 = 62;
    pub const GF16_MIN_EXP: u32 = 1;

    // === OPERATION ENUMS ===
    pub const OpAdd = 0;
    pub const OpMul = 1;

    // === DECODE FUNCTIONS ===
    fn decode_inputs(a: u16, b: u16) -> (u32, u32, u32, u32, u32, u32, bool, bool) {
        let av: u32 = a as u32;
        let bv: u32 = b as u32;
        
        let sign_a: u32 = (av >> 15) & 1;
        let sign_b: u32 = (bv >> 15) & 1;
        let exp_a: u32 = (av >> 9) & 0x3F;
        let exp_b: u32 = (bv >> 9) & 0x3F;
        let mant_a: u32 = (0x200 | (av & 0x1FF)) as u32;
        let mant_b: u32 = (0x200 | (bv & 0x1FF)) as u32;
        
        let is_zero_a: bool = (av == 0);
        let is_zero_b: bool = (bv == 0);
        
        return (sign_a, sign_b, exp_a, exp_b, mant_a, mant_b, is_zero_a, is_zero_b);
    }

    fn decode_operation(op: u32) -> (bool, bool) {
        let is_add: bool = (op == OpAdd);
        let is_mul: bool = (op == OpMul);
        return (is_add, is_mul);
    }

    fn calculate_signs(sign_a: u32, sign_b: u32, is_add: bool, is_mul: bool) -> u32 {
        let sign_add: u32 = sign_a ^ sign_b;
        let sign_mul: u32 = sign_a ^ sign_b;
        return if (is_add) { sign_add } else { sign_mul };
    }

    // === MAIN COMBINATIONAL FUNCTION ===
    fn on_comb(a: u16, b: u16, op: u32) -> u16 {
        let (sign_a, sign_b, exp_a, exp_b, mant_a, mant_b, is_zero_a, is_zero_b) = decode_inputs(a, b);
        let (is_add, is_mul) = decode_operation(op);
        
        let is_result_zero: bool = is_zero_a || is_zero_b;
        
        // Handle special cases
        if (is_zero_a && is_zero_b) {
            return 0;  // both zero
        } else if (is_zero_a) {
            if (is_add) {
                return b;  // addition: 0 + x = x
            } else {
                return 0;  // multiplication: 0 * x = 0
            }
        } else if (is_zero_b) {
            if (is_add) {
                return a;  // addition: x + 0 = x
            } else {
                return 0;  // multiplication: x * 0 = 0
            }
        }
        
        // Sign calculation
        let sign_result: u32 = calculate_signs(sign_a, sign_b, is_add, is_mul);
        
        // Simple arithmetic for now - will be expanded
        if (is_add) {
            // Simple addition - will be replaced with proper GF16 addition
            let result: u32 = (sign_result << 15) | (exp_a << 9) | (mant_a & 0x1FF);
            return result as u16;
        } else {
            // Simple multiplication - will be replaced with proper GF16 multiplication
            let result: u32 = (sign_result << 15) | (exp_a << 9) | (mant_a & 0x1FF);
            return result as u16;
        }
    }

    // === TESTS ===
    test add_basic {
        let result = on_comb(0x3E00, 0x3E00, OpAdd);
        // For now, just check that it doesn't return zero
        assert(result != 0);
    }

    test mul_basic {
        let result = on_comb(0x3E00, 0x3E00, OpMul);
        // For now, just check that it doesn't return zero
        assert(result != 0);
    }

    test add_with_zero {
        let result = on_comb(0x3E00, 0x0000, OpAdd);
        // Zero should pass through
        assert(result == 0x3E00);
    }

    test mul_with_zero {
        let result = on_comb(0x3E00, 0x0000, OpMul);
        // Anything multiplied by zero should be zero
        assert(result == 0x0000);
    }

    test decode_function {
        let (sign_a, sign_b, exp_a, exp_b, mant_a, mant_b, is_zero_a, is_zero_b) = decode_inputs(0x3E00, 0x4000);
        assert(sign_a == 0);
        assert(sign_b == 0);
        assert(exp_a == 31);
        assert(exp_b == 32);
        assert(mant_a == 0x200);
        assert(mant_b == 0x200);
        assert(is_zero_a == false);
        assert(is_zero_b == false);
    }

    test operation_decode {
        let (is_add, is_mul) = decode_operation(OpAdd);
        assert(is_add == true);
        assert(is_mul == false);
        
        let (is_add2, is_mul2) = decode_operation(OpMul);
        assert(is_add2 == false);
        assert(is_mul2 == true);
    }

    test sign_calculation {
        let sign1 = calculate_signs(0, 0, true, false);
        assert(sign1 == 0);
        let sign2 = calculate_signs(1, 1, true, false);
        assert(sign2 == 0);
        let sign3 = calculate_signs(1, 0, true, false);
        assert(sign3 == 1);
    }

    // === INVARIANTS ===
    invariant exp_bits_constant
        assert(GF16_EXP_BITS == 6)

    invariant exp_bias_constant
        assert(GF16_EXP_BIAS == 31)

    invariant max_exp_valid
        assert(GF16_MAX_EXP == 62)

    invariant min_exp_valid
        assert(GF16_MIN_EXP == 1)

    invariant op_values_valid
        assert(OpAdd == 0)
        assert(OpMul == 1)
}

// phi^2 + 1/phi² = 3 | TRINITY