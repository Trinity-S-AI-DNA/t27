// ============================================================================
// Port of gHashTag/trinity `fpga/openxc7-synth/tf3_dot.v` — TF3-9 vector dot
// product (228 lines) — to a t27 specification, per issue gHashTag/t27#9248.
//
// Provenance: the issue cites the original at commit b45da4ca055f; this port
// was made from the staged upstream snapshot (/tmp/trinity_up @ 252955f),
// the copy of the module available on this machine.
//
// The original is a simplified structural template for the Trinity TF3-9
// FPGA datapath. What it computes — and what this spec carries:
//   1. TF3-9 field unpack of each 18-bit element (generate gen_unpack),
//   2. a sign-trit product decision (generate gen_mult_sign),
//   3. an exponent addition of the lowest exp trit (generate gen_exp_add),
//   4. a placeholder accumulation (always block: +1 per accepted cycle)
//      and the out_y encode (0 when the accumulator is zero, else 18'h00002).
//
// What the original does NOT compute (named in its own "NOTES FOR FULL
// IMPLEMENTATION": mantissa multiply, bias subtraction, normalization,
// rounding, full TF3-9 encode, overflow handling) is not invented here.
//
// TF3-9 format, from the original header (18 bits per element):
//   sign_trit:   2 bits   // bits 17:16
//   exp_trits:   3 trits  // 6 bits,  bits 15:10
//   mant_trits:  5 trits  // 10 bits, bits  9:0
//
// Two code-vs-comment discrepancies in the original, resolved in favor of
// the code (the comments disagree with it):
//   a. The header says the sign code maps {-1,0,+1} -> (01, 00, 10), but
//      trit_to_signed/signed_to_trit map 00 -> -1, 01 -> 0, 10 -> +1
//      (2'b11 decodes to 0). The code wins.
//   b. The gen_mult_sign comment says "Both -1 -> +1", but prod_neg tests
//      (ssa == -1) && (ssb == +1), i.e. (-1) x (+1) -> -1; prod_pos tests
//      (+1) x (+1) -> +1 but is computed and never used; the final assign
//      falls to its else branch for (+1) x (-1), yielding +1. The coded
//      behavior wins.
//
// Structure notes for the Verilog backend:
//   - The original's genvar loops instantiate N lanes of the same per-lane
//     combinational logic; that lane logic is `on_comb` here (T187), the
//     function that becomes the module's data port. The full module wraps
//     N lanes over the packed (N*18)-bit vec_a/vec_b.
//   - The sequential shell (clk/rst_n, in_valid/in_ready handshake, the
//     2-stage acc_valid_pipe, out_valid) is Verilog plumbing; its decisions
//     are `acc_next` and `out_y_encode`. The clocked process itself has no
//     t27 body.
//
// phi^2 + 1/phi^2 = 3 | TRINITY
// ============================================================================

module tf3_dot {

  // ---- Verilog `parameter` -> t27 `const` (localparam when generated) ----
  const N : u32 = 16;          // parameter N = 16: vector size (lanes)
  const ACC_WIDTH : u32 = 20;  // parameter ACC_WIDTH = 20: accumulator width

  // ---- TF3-9 field geometry (bits within one packed 18-bit element) ----
  const ELEM_BITS : u32 = 18;  // one TF3-9 element
  const SIGN_BITS : u32 = 2;   // bits 17:16
  const EXP_BITS : u32 = 6;    // bits 15:10
  const MANT_BITS : u32 = 10;  // bits  9:0

  // The 2-bit trit code as driven by signed_to_trit / decoded by
  // trit_to_signed (coded mapping; see header note (a)).
  const TRIT_NEG : u8 = 0;     // 2'b00 -> -1
  const TRIT_ZERO : u8 = 1;    // 2'b01 -> 0
  const TRIT_POS : u8 = 2;     // 2'b10 -> +1

  // The placeholder encode the always block drives for a non-zero
  // accumulator: 18'h00002 (mant trit +1, zero exponent/sign bits).
  const OUT_Y_NONZERO : u32 = 0x00002;

  // in_op interface encoding, from the original's port comment:
  // "00=ADD (not used), 01=DOT" — the logic never reads in_op.
  enum Tf3Op { Add, Dot }

  // One decoded TF3-9 element: the fields gen_unpack slices out of every
  // 18-bit lane, named in the original's order (sign, exp, mant).
  struct TF39Elem {
    sign: u8,   // 2-bit trit code, bits 17:16
    exp: u8,    // 6-bit exp code,  bits 15:10
    mant: u16,  // 10-bit mant code, bits  9:0
  }

  // ---- TRIT DECODE / ENCODE (tf3_add.v helper functions, case for case) ----

  // 2-bit trit code -> signed value. Coded: 2'b00 -> -1, 2'b10 -> +1,
  // 2'b01 -> 0, default -> 0. The explicit 2'b01 arm and the default both
  // yield 0, so one else arm carries them.
  fn trit_to_signed(trit: u8) -> i8 {
    switch (trit) {
      0 => -1,   // 2'b00
      2 => 1,    // 2'b10
      else => 0  // 2'b01 and default (2'b11)
    }
  }

  // Inverse of trit_to_signed. Coded: -1 -> 2'b00, +1 -> 2'b10, 0 -> 2'b01,
  // default -> 2'b01. The explicit 0 arm and the default both yield 2'b01.
  fn signed_to_trit(val: i8) -> u8 {
    switch (val) {
      -1 => 0,   // 2'b00
      1 => 2,    // 2'b10
      else => 1  // 0 and default
    }
  }

  // ---- VECTOR UNPACKING (generate gen_unpack, one lane of the loop) ----
  fn unpack_sign(elem: u32) -> u8 { return ((elem >> 16) & 0x3) as u8; }
  fn unpack_exp(elem: u32) -> u8 { return ((elem >> 10) & 0x3F) as u8; }
  fn unpack_mant(elem: u32) -> u16 { return (elem & 0x3FF) as u16; }

  // The three slices as one struct, fields named in the original's order.
  fn unpack(elem: u32) -> TF39Elem {
    return TF39Elem {
      sign: unpack_sign(elem),
      exp: unpack_exp(elem),
      mant: unpack_mant(elem),
    };
  }

  // ---- TERNARY MULTIPLICATION STAGE (generate gen_mult_sign, one lane) ----

  // prod_zero: either decoded sign is 0 -> product is 0.
  fn prod_zero(ssa: i8, ssb: i8) -> bool { return (ssa == 0) || (ssb == 0); }

  // prod_neg: decoded signs (-1, +1) -> product -1. (The original's inline
  // comment "Both -1 -> +1" contradicts its own comparison; see header (b).)
  fn prod_neg(ssa: i8, ssb: i8) -> bool { return (ssa == -1) && (ssb == 1); }

  // prod_pos: decoded signs (+1, +1). Computed by the original but its
  // assign never reads it (dead wire); kept for fidelity.
  fn prod_pos(ssa: i8, ssb: i8) -> bool { return (ssa == 1) && (ssb == 1); }

  // The product decision as coded: zero if either side is zero, -1 for
  // (-1, +1), else +1. The header's ternary table would give -1 for
  // (+1) x (-1) too; the code falls to the else branch instead. Kept as
  // coded (header note (b)).
  fn prod_val(ssa: i8, ssb: i8) -> i8 {
    if (prod_zero(ssa, ssb)) { return 0; }
    if (prod_neg(ssa, ssb)) { return -1; }
    return 1;
  }

  // Sign of product "same as XOR": the raw xor of the two decoded sign
  // trits. The original computes this wire but nothing downstream reads
  // sign_mult (dead); kept for fidelity.
  fn sign_mult(ssa: i8, ssb: i8) -> i8 { return ssa ^ ssb; }

  // ---- EXPONENT ADDITION STAGE (generate gen_exp_add, one lane) ----

  // Sums the decoded LOWEST exp trit of each side — the original indexes
  // exp_trits_a[j][1:0] / exp_trits_b[j][1:0], bits 1:0 of the 6-bit field.
  // Its own comment flags the simplification ("full TF3-9 multiply is more
  // complex"); the higher trits are ignored, as coded.
  fn exp_add(elem_a: u32, elem_b: u32) -> i8 {
    return trit_to_signed(unpack_exp(elem_a) & 0x3)
         + trit_to_signed(unpack_exp(elem_b) & 0x3);
  }

  // ---- ACCUMULATION STAGE (the always block's decisions) ----

  // Next accumulator. In the Verilog, acc_valid_pipe[1] schedules the reset
  // and acc_valid_pipe[0] schedules accumulator + 1 as nonblocking
  // assignments — the add is the LAST scheduled write, so when both stages
  // are set the add wins over the reset. Order preserved here.
  fn acc_next(pipe1: bool, pipe0: bool, acc: i32) -> i32 {
    if (pipe0) { return acc + 1; }  // last scheduled write: +1 placeholder
    if (pipe1) { return 0; }        // else the reset wins
    return acc;
  }

  // out_y placeholder encode: 0 when the accumulator is zero, else the
  // constant 18'h00002 ("Simple +1 if non-zero" in the original).
  fn out_y_encode(acc: i32) -> u32 {
    if (acc == 0) { return 0; }
    return OUT_Y_NONZERO;
  }

  // ---- in_op decode ----

  // The original declares in_op as "00=ADD (not used), 01=DOT" and never
  // reads it; this decodes the declared encoding. The enum discriminators
  // (Add=0, Dot=1) match the 2-bit codes.
  fn in_op_code(op: Tf3Op) -> u8 {
    switch (op) {
      .Add => 0,
      .Dot => 1,
    }
  }

  // ---- THE PER-LANE COMBINATIONAL SURFACE (data port for the backend) ----

  // One lane of the dot product's combinational datapath: unpack both
  // elements, decode their sign trits, apply the coded product decision,
  // and return the product as the 2-bit two's-complement wire pattern the
  // multiply stage drives (2'b11 = -1, 2'b00 = 0, 2'b01 = +1). One of N
  // lanes; the full module instantiates this over the (N*18)-bit vectors.
  fn on_comb(elem_a: u32, elem_b: u32) -> u32 {
    const pv : i8 = prod_val(
      trit_to_signed(unpack_sign(elem_a)),
      trit_to_signed(unpack_sign(elem_b)));
    if (pv < 0) { return 0x3; }
    if (pv > 0) { return 0x1; }
    return 0x0;
  }

  // ---- tests (every function above carries at least one assert) ----

  test trit_decode {
    // The coded mapping (header note (a)): 00 -> -1, 01 -> 0, 10 -> +1.
    assert_eq(trit_to_signed(TRIT_NEG), -1);
    assert_eq(trit_to_signed(TRIT_ZERO), 0);
    assert_eq(trit_to_signed(TRIT_POS), 1);
    // 2'b11 and any wider value fall to the default arm: 0.
    assert_eq(trit_to_signed(3), 0);
    assert_eq(trit_to_signed(200), 0);
  }

  test trit_encode {
    assert_eq(signed_to_trit(-1), TRIT_NEG);
    assert_eq(signed_to_trit(0), TRIT_ZERO);
    assert_eq(signed_to_trit(1), TRIT_POS);
    // default arm: 2'b01, exactly as the original.
    assert_eq(signed_to_trit(2), 1);
    assert_eq(signed_to_trit(-7), 1);
  }

  test unpack_fields {
    // 0x05401 = 0000 0101 0100 0000 0001:
    //   sign bits 17:16 = 00, exp bits 15:10 = 010101 = 21, mant bits 9:0 = 1.
    assert_eq(unpack_sign(0x05401), 0);
    assert_eq(unpack_exp(0x05401), 21);
    assert_eq(unpack_mant(0x05401), 1);
    // All-ones: sign 11, exp 111111, mant 1111111111.
    assert_eq(unpack_sign(0x3FFFF), 3);
    assert_eq(unpack_exp(0x3FFFF), 63);
    assert_eq(unpack_mant(0x3FFFF), 1023);
    // OUT_Y_NONZERO itself: mant trit +1, zero exp/sign.
    assert_eq(unpack_sign(OUT_Y_NONZERO), 0);
    assert_eq(unpack_exp(OUT_Y_NONZERO), 0);
    assert_eq(unpack_mant(OUT_Y_NONZERO), 2);
  }

  test struct_unpack {
    const e : TF39Elem = unpack(0x05401);
    assert_eq(e.sign, 0);
    assert_eq(e.exp, 21);
    assert_eq(e.mant, 1);
  }

  test prod_table {
    // prod_zero: any zero side zeroes the product.
    assert(prod_zero(0, -1));
    assert(prod_zero(1, 0));
    assert(!prod_zero(1, 1));
    // The full 3x3 table as coded (header note (b): (+1)x(-1) -> +1).
    // prod_neg: the (-1, +1) -> -1 leg of the decision, as coded.
    assert(prod_neg(-1, 1));
    assert(!prod_neg(1, -1));
    assert(!prod_neg(-1, -1));
    assert(!prod_neg(0, 1));
    assert_eq(prod_val(-1, -1), 1);
    assert_eq(prod_val(-1, 0), 0);
    assert_eq(prod_val(-1, 1), -1);
    assert_eq(prod_val(0, -1), 0);
    assert_eq(prod_val(0, 0), 0);
    assert_eq(prod_val(0, 1), 0);
    assert_eq(prod_val(1, -1), 1);
    assert_eq(prod_val(1, 0), 0);
    assert_eq(prod_val(1, 1), 1);
  }

  test prod_pos_wire {
    // Computed-but-unused in the original: only (+1, +1) is true.
    assert(prod_pos(1, 1));
    assert(!prod_pos(-1, 1));
    assert(!prod_pos(1, -1));
    assert(!prod_pos(0, 1));
  }

  test sign_xor {
    // The raw sign-trit xor (dead wire in the original, kept for fidelity).
    assert_eq(sign_mult(-1, 0), -1);
    assert_eq(sign_mult(1, 1), 0);
    assert_eq(sign_mult(-1, 1), -2);
    assert_eq(sign_mult(-1, -1), 0);
  }

  test exp_low_trit_sum {
    // 0x800: exp field = 000010, lowest trit code 10 -> +1.
    // 0x05401: exp field = 010101, lowest trit code 01 -> 0.
    assert_eq(exp_add(0x800, 0x05401), 1);
    assert_eq(exp_add(0x800, 0x800), 2);
    // Both exp fields zero: lowest trit code 00 -> -1 each side.
    assert_eq(exp_add(0, 0), -2);
    assert_eq(exp_add(0x05401, 0x05401), 0);
  }

  test acc_updates {
    // Idle and one-stage paths.
    assert_eq(acc_next(false, false, 5), 5);
    assert_eq(acc_next(false, true, 5), 6);
    assert_eq(acc_next(true, false, 5), 0);
    // Both stages set: the nonblocking add is scheduled last, so it wins
    // over the reset — the accumulator advances, not clears.
    assert_eq(acc_next(true, true, 5), 6);
  }

  test out_y_mux {
    assert_eq(out_y_encode(0), 0);
    assert_eq(out_y_encode(1), OUT_Y_NONZERO);
    assert_eq(out_y_encode(-1), OUT_Y_NONZERO);
    assert_eq(out_y_encode(1048575), OUT_Y_NONZERO);
  }

  test in_op_encoding {
    // The declared in_op encoding: 00=ADD, 01=DOT (logic never reads it).
    assert_eq(in_op_code(.Add), 0);
    assert_eq(in_op_code(.Dot), 1);
  }

  test comb_lane {
    // Coded table via the 2-bit wire pattern (0x3=-1, 0x0=0, 0x1=+1).
    assert_eq(on_comb(0x00000, 0x00000), 0x1);  // (-1) x (-1) -> +1
    assert_eq(on_comb(0x20000, 0x00000), 0x1);  // (+1) x (-1) -> +1 (coded)
    assert_eq(on_comb(0x20000, 0x10000), 0x0);  // (+1) x 0    -> 0
    assert_eq(on_comb(0x10000, 0x20000), 0x0);  // 0    x (+1) -> 0
    assert_eq(on_comb(0x20000, 0x20000), 0x1);  // (+1) x (+1) -> +1
  }

  test geometry {
    // Runtime: an 18-bit element with every field saturated unpacks back to
    // the field widths these constants describe.
    const full : u32 = (1 << ELEM_BITS) - 1;
    assert_eq(unpack_sign(full), 3);
    assert_eq(unpack_exp(full), (1 << EXP_BITS) - 1);
    assert_eq(unpack_mant(full), (1 << MANT_BITS) - 1);
    // Compile-time relations: the fields tile the element, and the packed
    // vec_a/vec_b vectors are (N*18) bits wide. The ported parameter values.
    assert_eq(SIGN_BITS + EXP_BITS + MANT_BITS, ELEM_BITS);
    assert_eq(N * ELEM_BITS, 288);
    assert_eq(N, 16);
    assert_eq(ACC_WIDTH, 20);
  }
}
