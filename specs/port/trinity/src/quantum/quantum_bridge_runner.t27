// Port of gHashTag/trinity src/quantum/quantum_bridge_runner.zig at 252955f786c6
// (125 lines, 2 functions) to .t27, for gHashTag/t27#9237.
//
// The original runs CGLMP quantum violation tests in an endless loop and keeps
// an FPGA LED in sync by flashing one of four bitstreams chosen from the I3
// value (phi^2 + 1/phi^2 = 3).
//
// The decisions it makes are ported below as pure functions; each header names
// the original line it comes from:
//
//   state_index_for_i3   line 50 - map the CGLMP I3 value onto one of four
//                        bitstream states with thresholds 1.0, 2.0 and 2.5
//   bitstream_name       lines 32-37 - state index -> bitstream image name
//                        ("separable", "violation", "zero", "negative")
//   bitfile_name         line 81 - state index -> the .bit file to flash
//   rate_hint            lines 68-76 - the pacing hint printed for a state
//                        (FAST ~6 Hz / STEADY ON / SLOW ~0.4 Hz / MEDIUM ~3 Hz)
//   run_label            lines 60-64 - "VIOLATION!" vs "separable" per run
//   violation_percent    lines 87-89 - the statistic printed every 10 iterations
//   flash_outcome        lines 99-123 - the verdict of a flash attempt: a spawn
//                        failure or a non-zero child exit fails the flash, and
//                        stderr is echoed only when a non-zero exit left some
//
// The plumbing keeps its original name with an `undefined;` body that no test
// calls, as the port brief prescribes:
//
//   main            line 20 - the banner, the endless loop, the call into
//                   ternary_qvm.run_cglmp_test, the formatted printing, the
//                   every-10 statistics line, the C nanosleep. Its decisions
//                   are the helpers above; its data (i3_value, violation flag)
//                   are their parameters.
//   flashBitstream  line 99 - spawning `sudo /Users/playra/trinity-w1/fpga/
//                   tools/jtag_program <path>` and freeing the child's output.
//                   Its verdict is flash_outcome.
//
// One construct of the original cannot be expressed in .t27 today: string
// concatenation. Line 81 builds the bitfile path as base_path ++ state_name ++
// ".bit" with base_path = "/Users/playra/trinity-w1/fpga/openxc7-synth/
// quantum_bridge_" (line 40). The state name takes exactly four values, so the
// concatenation is tabulated in bitfile_name; the base path is recorded here
// rather than in an unused const.

module port::trinity::src::quantum::quantum_bridge_runner;

// Original line 50. The thresholds are strict "<" comparisons, so a boundary
// value itself falls to the next state: I3 = 1.0 is state 1, I3 = 2.0 is
// state 2, I3 = 2.5 is state 3.
pub fn state_index_for_i3(i3_value: f64) -> usize {
    if (i3_value < 1.0) {
        return 0;
    }
    if (i3_value < 2.0) {
        return 1;
    }
    if (i3_value < 2.5) {
        return 2;
    }
    return 3;
}

// Original lines 32-37: the four bitstream images, one per quantum state.
pub fn bitstream_name(state_idx: usize) -> str {
    if (state_idx == 0) {
        return "separable";
    }
    if (state_idx == 1) {
        return "violation";
    }
    if (state_idx == 2) {
        return "zero";
    }
    return "negative";
}

// Original line 81: base_path ++ state_name ++ ".bit", tabulated over the four
// state names because .t27 has no string concatenation.
pub fn bitfile_name(state_idx: usize) -> str {
    if (state_idx == 0) {
        return "quantum_bridge_separable.bit";
    }
    if (state_idx == 1) {
        return "quantum_bridge_violation.bit";
    }
    if (state_idx == 2) {
        return "quantum_bridge_zero.bit";
    }
    return "quantum_bridge_negative.bit";
}

// Original lines 68-76: the pacing hint for a state, stripped of the ANSI
// color escapes and the leading blank the original prints around it.
pub fn rate_hint(state_idx: usize) -> str {
    if (state_idx == 1) {
        return "FAST (~6 Hz)";
    }
    if (state_idx == 3) {
        return "STEADY ON";
    }
    if (state_idx == 2) {
        return "SLOW (~0.4 Hz)";
    }
    return "MEDIUM (~3 Hz)";
}

// Original lines 60-64: the label printed for each run, stripped of the green
// ANSI escape the original wraps "VIOLATION!" in.
pub fn run_label(is_violation: bool) -> str {
    if (is_violation) {
        return "VIOLATION!";
    }
    return "separable";
}

// Original lines 87-89: violation_count * 100.0 / iteration, in f64. The
// original computes this on the first pass with iteration = 0 and prints nan;
// the formula is ported as written.
pub fn violation_percent(violation_count: u32, iterations: u32) -> f64 {
    return (violation_count as f64) * 100.0 / (iterations as f64);
}

// The verdict of one flash attempt, original lines 99-123. The original spawns
// `sudo jtag_program <path>` (lines 101-107); a spawn failure (line 108) and a
// non-zero child exit (line 118) both become error.FlashFailed, and stderr is
// echoed only in the non-zero-exit branch when it is non-empty (lines 119-121).
// The spawn itself is plumbing; the verdict is this function. The caller
// reports a spawn failure as spawn_failed = true.
struct FlashOutcome {
    ok: bool,
    show_stderr: bool,
}

pub fn flash_outcome(spawn_failed: bool, exit_code: i32, stderr_len: usize) -> FlashOutcome {
    if (spawn_failed) {
        return FlashOutcome { ok: false, show_stderr: false };
    }
    if (exit_code == 0) {
        return FlashOutcome { ok: true, show_stderr: false };
    }
    if (stderr_len > 0) {
        return FlashOutcome { ok: false, show_stderr: true };
    }
    return FlashOutcome { ok: false, show_stderr: false };
}

// Original line 20 (`pub fn main() !void`). Plumbing: banner, endless loop,
// nanosleep, printing. The error union of the signature has no .t27
// equivalent, so the body is undefined and nothing calls it.
pub fn main() -> void {
    undefined;
}

// Original line 99 (`fn flashBitstream(path: []const u8) !void`). Plumbing:
// the jtag_program subprocess. The verdict is flash_outcome.
fn flashBitstream(path: []const u8) -> void {
    undefined;
}

test state_index_thresholds {
    assert(state_index_for_i3(0.0) == 0);
    assert(state_index_for_i3(0.9999) == 0);
    assert(state_index_for_i3(1.0) == 1);
    assert(state_index_for_i3(1.5) == 1);
    assert(state_index_for_i3(2.0) == 2);
    assert(state_index_for_i3(2.4999) == 2);
    assert(state_index_for_i3(2.5) == 3);
    assert(state_index_for_i3(3.25) == 3);
}

test state_maps_to_bitstream_and_bitfile {
    assert(bitstream_name(state_index_for_i3(0.42)) == "separable");
    assert(bitstream_name(state_index_for_i3(1.0)) == "violation");
    assert(bitstream_name(state_index_for_i3(2.25)) == "zero");
    assert(bitstream_name(state_index_for_i3(2.5)) == "negative");
    assert(bitfile_name(state_index_for_i3(0.42)) == "quantum_bridge_separable.bit");
    assert(bitfile_name(state_index_for_i3(1.0)) == "quantum_bridge_violation.bit");
    assert(bitfile_name(state_index_for_i3(2.25)) == "quantum_bridge_zero.bit");
    assert(bitfile_name(state_index_for_i3(2.5)) == "quantum_bridge_negative.bit");
}

test bitstream_names_by_index {
    assert(bitstream_name(0) == "separable");
    assert(bitstream_name(1) == "violation");
    assert(bitstream_name(2) == "zero");
    assert(bitstream_name(3) == "negative");
}

test rate_hints_by_state {
    assert(rate_hint(0) == "MEDIUM (~3 Hz)");
    assert(rate_hint(1) == "FAST (~6 Hz)");
    assert(rate_hint(2) == "SLOW (~0.4 Hz)");
    assert(rate_hint(3) == "STEADY ON");
}

test run_labels {
    assert(run_label(true) == "VIOLATION!");
    assert(run_label(false) == "separable");
}

test violation_percent_cases {
    assert(violation_percent(3, 10) == 30.0);
    assert(violation_percent(0, 7) == 0.0);
    assert(violation_percent(1, 8) == 12.5);
    assert(violation_percent(5, 4) == 125.0);
}

test flash_outcome_cases {
    const ok = flash_outcome(false, 0, 0);
    assert(ok.ok);
    assert(!ok.show_stderr);
    const ok_with_stderr = flash_outcome(false, 0, 9);
    assert(ok_with_stderr.ok);
    assert(!ok_with_stderr.show_stderr);
    assert(!flash_outcome(true, 0, 0).ok);
    assert(!flash_outcome(true, 0, 0).show_stderr);
    const failed_quiet = flash_outcome(false, 1, 0);
    assert(!failed_quiet.ok);
    assert(!failed_quiet.show_stderr);
    const failed_loud = flash_outcome(false, 1, 17);
    assert(!failed_loud.ok);
    assert(failed_loud.show_stderr);
}
