module port::trinity::src::cli::railway_delete_trinity;

pub fn main() -> i32 {
    // Command line parsing and orchestration logic
    const args = get_command_line_args();
    
    if (args.len < 4) {
        print_usage();
        return 1;
    }
    
    const account_name = args[1];
    const project_id = args[2];
    const token = args[3];
    
    print_status(account_name, "Looking for 'trinity' service...");
    
    // Step 1: Find trinity service
    const trinity_id = findTrinityService(token, project_id);
    
    if (trinity_id.len == 0) {
        print_status(account_name, "No 'trinity' service found");
        return 0;
    }
    
    print_status(account_name, trinity_id);
    
    // Step 2: Delete service
    print_status(account_name, "Deleting...");
    if (deleteService(token, trinity_id)) {
        print_success(account_name, "Deleted 'trinity' → 1 slot freed");
        return 0;
    } else {
        print_failure(account_name, "Failed to delete");
        return 1;
    }
}

fn findTrinityService(token: []const u8, project_id: []const u8) -> []const u8 {
    // GraphQL query construction
    const query_body = build_find_query(project_id);
    const auth_header = build_auth_header(token);
    
    // Network call - leave as undefined for porting
    const result = execute_graphql_query(query_body, auth_header);
    
    // Parse and analyze the response
    return parse_find_response(result);
}

fn deleteService(token: []const u8, service_id: []const u8) -> bool {
    // GraphQL mutation construction  
    const mutation_body = build_delete_mutation(service_id);
    const auth_header = build_auth_header(token);
    
    // Network call - leave as undefined for porting
    const result = execute_graphql_query(mutation_body, auth_header);
    
    // Check for errors in response
    return !contains_errors(result);
}

