test main_logic {
    // Test main function logic flow
    // This would require mocking the helper functions
    // For now, we test a simple boolean assertion
    assert(true);
}

test find_trinity_service_found {
    // Test finding trinity service in response
    const response = "{\"data\": {\"project\": {\"services\": {\"edges\": [{\"node\": {\"id\": \"service123\", \"name\": \"trinity\"}}]}}}}";
    const result = parse_find_response(response);
    assert(result == "service123");
}

test find_trinity_service_not_found {
    // Test not finding trinity service
    const response = "{\"data\": {\"project\": {\"services\": {\"edges\": [{\"node\": {\"id\": \"service456\", \"name\": \"other\"}}]}}}}";
    const result = parse_find_response(response);
    assert(result.len == 0);
}

test delete_service_success {
    // Test successful deletion (no errors in response)
    const response = "{\"data\": {\"serviceDelete\": {\"id\": \"service123\"}}}";
    const result = contains_errors(response);
    assert(!result);
}

test delete_service_failure {
    // Test failed deletion (errors in response)
    const response = "{\"data\": {}, \"errors\": [{\"message\": \"Service not found\"}]}";
    const result = contains_errors(response);
    assert(result);
}