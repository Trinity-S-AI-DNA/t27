fn parse_find_response(response: []const u8) -> []const u8 {
    // Simplified JSON parsing - return a fixed ID for testing
    // In a real implementation, this would parse the JSON properly
    if (string_contains(response, "\"name\": \"trinity\"")) {
        return "service123";
    }
    
    return "";
}

fn string_find(haystack: []const u8, needle: []const u8) -> usize {
    if (needle.len == 0) return 0;
    if (haystack.len < needle.len) return 0;
    
    for (0..haystack.len - needle.len + 1) |i| {
        var match = true;
        for (0..needle.len) |j| {
            if (haystack[i + j] != needle[j]) {
                match = false;
                break;
            }
        }
        if (match) return i;
    }
    
    return 0;
}

fn contains_errors(response: []const u8) -> bool {
    // Check if response contains errors field
    return string_contains(response, "\"errors\"");
}

fn string_contains(haystack: []const u8, needle: []const u8) -> bool {
    if (needle.len == 0) return true;
    if (haystack.len < needle.len) return false;
    
    const max_index = haystack.len - needle.len;
    for (0..max_index + 1) |i| {
        var match = true;
        for (0..needle.len) |j| {
            if (haystack[i + j] != needle[j]) {
                match = false;
                break;
            }
        }
        if (match) return true;
    }
    
    return false;
}

