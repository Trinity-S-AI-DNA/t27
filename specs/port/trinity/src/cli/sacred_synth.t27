// SPDX-License-Identifier: MIT
// Port of gHashTag/trinity src/cli/sacred_synth.zig (blob 5aabfbe8346f).
//
// The Sacred Synthesis CLI tool drives yosys to synthesize the Sacred ALU
// Verilog modules for the XC7A100T FPGA. In the original, main (lines 36-79)
// parses command line arguments, selects which modules to synthesize, and
// returns exit code 0 or 1; synthesizeModule (lines 81-100) prints a banner,
// runs yosys, and reports success or failure. The world-touching parts -
// stdout/stderr printing, argument allocation, the yosys child process - are
// plumbing and stay in the `undefined;` stubs below, called by no test. The
// decisions they wrap are ported as pure, tested helpers.

module port::trinity::src::cli::sacred_synth;

// Original line 16: a Verilog source file and its yosys top module name.
struct Module {
    name: []const u8,
    top: []const u8,
}

// Original main (lines 36-79) returns exit code 0 after a run, 1 on the
// "ERROR: No matching modules found" path.
pub const EXIT_OK: u8 = 0;
pub const EXIT_NO_MATCH: u8 = 1;

// The module table (original lines 21-28): the six Sacred ALU modules and
// their Verilog source files.
pub fn module_table() -> [6]Module {
    var mods: [6]Module = [
        Module { name: "gf16_add.v", top: "gf16_add" },
        Module { name: "gf16_mul.v", top: "gf16_mul" },
        Module { name: "gf16_alu.v", top: "gf16_alu" },
        Module { name: "tf3_add.v", top: "tf3_add" },
        Module { name: "tf3_dot.v", top: "tf3_dot" },
        Module { name: "sacred_alu.v", top: "sacred_alu" },
    ];
    return mods;
}

// Original lines 58-66: an argument selects a module when it equals the
// module's name (std.mem.eql over MODULES names).
pub fn selects_module(arg: []const u8) -> bool {
    var mods: [6]Module = module_table();
    for m in mods {
        if (arg == m.name) {
            return true;
        }
    }
    return false;
}

// Original main, lines 43-51: with no arguments every module is synthesized;
// otherwise one yosys run per argument that names a module.
pub fn run_job_count(args: []str) -> usize {
    var mods: [6]Module = module_table();
    if (args.len == 0) {
        return mods.len;
    }
    var n: usize = 0;
    for a in args {
        if (selects_module(a)) {
            n += 1;
        }
    }
    return n;
}

// Original main, lines 43-79: the invocation exits 0 when it synthesizes
// anything (all modules with no arguments, or at least one argument naming a
// module), and 1 when no argument names a module.
pub fn run_verdict(args: []str) -> u8 {
    if (args.len == 0) {
        return EXIT_OK;
    }
    for a in args {
        if (selects_module(a)) {
            return EXIT_OK;
        }
    }
    return EXIT_NO_MATCH;
}

// Original synthesizeModule, lines 95-100: the yosys child's exit code
// decides the outcome - 0 is success, anything else is failure.
pub fn synthesis_ok(yosys_exit: i32) -> bool {
    return yosys_exit == 0;
}

// Original synthesizeModule, line 87: the exact argv built for a module.
// "build/mod" and ".json" are separate entries, as in the original.
pub fn yosys_argv(top: []const u8, name: []const u8) -> [9][]const u8 {
    var argv: [9][]const u8 = ["yosys", "-p", top, name, "-o", "build/mod", ".json", "-g", "cells,ports,attributes"];
    return argv;
}

// Original main (lines 36-79): allocates arguments, prints, selects modules
// with the decisions ported above, and returns the exit code. Process
// plumbing; not called by any test.
pub fn main() -> u8 {
    undefined;
}

// Original synthesizeModule (lines 81-100): prints the per-module banner,
// runs yosys with yosys_argv, and fails the run when synthesis_ok is false.
// Child-process plumbing; not called by any test.
fn synthesizeModule(mod: Module) {
    undefined;
}

test module_table_has_six_modules {
    var mods: [6]Module = module_table();
    assert(mods.len == 6);
    assert(mods[0].name == "gf16_add.v");
    assert(mods[0].top == "gf16_add");
    assert(mods[5].name == "sacred_alu.v");
    assert(mods[5].top == "sacred_alu");
}

test every_table_name_selects_a_module {
    var mods: [6]Module = module_table();
    for m in mods {
        assert(selects_module(m.name));
    }
    assert(!selects_module("nonexistent.v"));
    assert(!selects_module(""));
}

test no_arguments_synthesize_all_six {
    var none: [0][]const u8 = [];
    assert(run_verdict(&none) == EXIT_OK);
    assert(run_job_count(&none) == 6);
}

test named_modules_are_synthesized {
    var one: [1][]const u8 = ["gf16_mul.v"];
    assert(run_verdict(&one) == EXIT_OK);
    assert(run_job_count(&one) == 1);
    var two: [2][]const u8 = ["tf3_add.v", "tf3_dot.v"];
    assert(run_verdict(&two) == EXIT_OK);
    assert(run_job_count(&two) == 2);
}

test no_matching_modules_returns_one {
    var bad: [1][]const u8 = ["nope.v"];
    assert(run_verdict(&bad) == EXIT_NO_MATCH);
    assert(run_job_count(&bad) == 0);
}

test any_matching_argument_passes_the_run {
    var mixed: [2][]const u8 = ["nope.v", "sacred_alu.v"];
    assert(run_verdict(&mixed) == EXIT_OK);
    assert(run_job_count(&mixed) == 1);
}

test yosys_exit_zero_means_success {
    assert(synthesis_ok(0) == true);
    assert(synthesis_ok(1) == false);
    assert(synthesis_ok(2) == false);
    assert(synthesis_ok(-1) == false);
}

test yosys_command_line_matches_original {
    var argv: [9][]const u8 = yosys_argv("sacred_alu", "sacred_alu.v");
    assert(argv[0] == "yosys");
    assert(argv[1] == "-p");
    assert(argv[2] == "sacred_alu");
    assert(argv[3] == "sacred_alu.v");
    assert(argv[4] == "-o");
    assert(argv[5] == "build/mod");
    assert(argv[6] == ".json");
    assert(argv[7] == "-g");
    assert(argv[8] == "cells,ports,attributes");
}
