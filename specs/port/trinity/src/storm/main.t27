// Port of gHashTag/trinity src/storm/main.zig at 341f1d150c70 — the STORM
// command line interface (P9: 32-Agent Autonomous Operation).
//
// The original file is a thin CLI: it parses argv, dispatches to one of four
// commands plus a help screen, and every command is a wrapper around
// std.process, std.fs and two components (golden_chain, wave_protocol).
// Following "port the decision, not the plumbing", each decision lives in a
// pure helper below; the six entry points keep their original names with
// `undefined;` bodies because every line in them prints to stderr, reads
// directories or initialises components, and no test calls them.

module port::trinity::src::storm::main;

const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// -- main (original line 16, `pub fn main() !u8`) ---------------------------

// With an empty argv the command falls back to "run"; otherwise the first
// argv entry is taken as the command. Quirk of the original, ported as
// written: it inspects the whole argv, so argsAlloc always yields at least
// the program name and the fallback is dead code in practice.

pub fn uses_default_command(argc: u32) bool {
    return argc == 0;
}

// The dispatch chain: every known command returns the exit code its handler
// reports, which in the original is always 0; anything else prints the
// unknown-command banner plus the help screen and returns 1. The help text
// advertises a "help" command, but the chain never handles it, so "help"
// falls through to the unknown branch — preserved here.

pub fn dispatch(command: str) i32 {
    if (command == "--help" or command == "-h") {
        return EXIT_OK;
    }
    if (command == "init") {
        return EXIT_OK;
    }
    if (command == "run") {
        return EXIT_OK;
    }
    if (command == "status") {
        return EXIT_OK;
    }
    if (command == "resume") {
        return EXIT_OK;
    }
    return EXIT_FAIL;
}

// -- printHelp (original line 48) -------------------------------------------

// The help screen is a fixed banner plus exactly five command lines. The
// decision ported here is which commands the screen documents; the colored
// banner itself is printing (plumbing).

pub fn help_lists(command: str) bool {
    if (command == "init") {
        return true;
    }
    if (command == "run") {
        return true;
    }
    if (command == "status") {
        return true;
    }
    if (command == "resume") {
        return true;
    }
    if (command == "help") {
        return true;
    }
    return false;
}

// -- cmdInit (original line 60) ---------------------------------------------

// The scaffold creates six paths under .trinity with makePath. The decision
// is the set of directories; the makePath calls and their allocator are
// plumbing.

pub fn is_init_dir(name: str) bool {
    if (name == ".trinity/storm") {
        return true;
    }
    if (name == ".trinity/storm/checkpoints") {
        return true;
    }
    if (name == ".trinity/phoenix/checkpoints") {
        return true;
    }
    if (name == ".trinity/mistakes") {
        return true;
    }
    if (name == ".trinity/experience") {
        return true;
    }
    if (name == ".trinity/experience/episodes") {
        return true;
    }
    return false;
}

pub fn init_dir_count() i32 {
    return 6;
}

// The "✓ Created <dir>" line is printed from the catch branch of each
// makePath call: the message appears when the creation call ERRORED, and a
// clean creation prints nothing. The caller performs the call and passes
// whether it errored; this carries the printing decision.

pub fn prints_created(make_path_errored: bool) bool {
    return make_path_errored;
}

// -- cmdRun (original line 80) ----------------------------------------------

// The run banner reports the default configuration — five waves, thirty-two
// agents — before initialising the golden chain and the wave protocol. The
// component setup, allocator and printing are plumbing; the defaults are
// the decision.

pub fn default_waves() i32 {
    return 5;
}

pub fn default_agents() i32 {
    return 32;
}

// -- cmdStatus (original line 99) -------------------------------------------

// An entry counts as a checkpoint when it is a file whose name ends with
// ".json". The caller iterates the checkpoint directory and passes whether
// the entry is a file and the entry's ".json" suffix; the endsWith call and
// the directory iteration are plumbing.

pub fn counts_as_checkpoint(is_file: bool, ext: str) bool {
    return is_file and ext == ".json";
}

// A count of zero prints "No checkpoints found."; otherwise the total is
// printed. The same branch covers the case where the checkpoint directory
// cannot be opened at all — the caller maps an unopenable directory to a
// count of zero.

pub fn status_reports_none(count: usize) bool {
    return count == 0;
}

// -- cmdResume (original line 128) ------------------------------------------

// Resume is a stub in the original: the command prints its banner and a
// line saying the feature is a placeholder, then returns. The caller owns
// the printing; the decision is that there is no resume implementation to
// reach.

pub fn resume_implemented() bool {
    return false;
}

// -- the six entry points -----------------------------------------------------
// Each body below is `undefined;` on purpose: these functions only print,
// allocate or touch the filesystem, and no test calls them. Their decisions
// are the helpers above. The allocator parameter is plumbing carried under
// its original name.

pub fn main() i32 {
    undefined;
}

fn printHelp() void {
    undefined;
}

fn cmdInit(allocator: i32) void {
    undefined;
}

fn cmdRun(allocator: i32, args: []str) void {
    undefined;
}

fn cmdStatus(allocator: i32) void {
    undefined;
}

fn cmdResume(allocator: i32, args: []str) void {
    undefined;
}

// -- tests --------------------------------------------------------------------

test "known commands dispatch to exit code zero" {
    assert(dispatch("--help") == EXIT_OK);
    assert(dispatch("-h") == EXIT_OK);
    assert(dispatch("init") == EXIT_OK);
    assert(dispatch("run") == EXIT_OK);
    assert(dispatch("status") == EXIT_OK);
    assert(dispatch("resume") == EXIT_OK);
}

test "unknown commands exit one" {
    assert(dispatch("bogus") == EXIT_FAIL);
    assert(dispatch("") == EXIT_FAIL);
    assert(dispatch("Init") == EXIT_FAIL);
    // The help text advertises "help" but the dispatch chain never handles it.
    assert(dispatch("help") == EXIT_FAIL);
}

test "empty argv falls back to the run default" {
    assert(uses_default_command(0));
    assert(!uses_default_command(1));
    assert(!uses_default_command(3));
}

test "the help screen documents exactly five commands" {
    assert(help_lists("init"));
    assert(help_lists("run"));
    assert(help_lists("status"));
    assert(help_lists("resume"));
    assert(help_lists("help"));
    assert(!help_lists("--help"));
    assert(!help_lists("bogus"));
}

test "init scaffolds the six .trinity directories" {
    assert(is_init_dir(".trinity/storm"));
    assert(is_init_dir(".trinity/storm/checkpoints"));
    assert(is_init_dir(".trinity/phoenix/checkpoints"));
    assert(is_init_dir(".trinity/mistakes"));
    assert(is_init_dir(".trinity/experience"));
    assert(is_init_dir(".trinity/experience/episodes"));
    assert(!is_init_dir(".trinity"));
    assert(!is_init_dir("storm"));
    assert(init_dir_count() == 6);
}

test "the created line follows the makePath catch branch" {
    assert(prints_created(true));
    assert(!prints_created(false));
}

test "run reports the default configuration" {
    assert(default_waves() == 5);
    assert(default_agents() == 32);
}

test "only json files count as checkpoints" {
    assert(counts_as_checkpoint(true, ".json"));
    assert(!counts_as_checkpoint(false, ".json"));
    assert(!counts_as_checkpoint(true, ".zig"));
    assert(!counts_as_checkpoint(true, ""));
    assert(!counts_as_checkpoint(true, "json"));
}

test "a zero count reports no checkpoints" {
    assert(status_reports_none(0));
    assert(!status_reports_none(1));
    assert(!status_reports_none(32));
}

test "resume has no implementation to reach" {
    assert(!resume_implemented());
}
