//! AMYGDALA (Striatum) — Memory + Blacklist
//! Levenshtein fuzzy match for similar tasks + failure tracking

pub const MAX_FAILURES: u32 = 3; // 3 failures = blacklist

pub const Error = struct {
    code: u8,
    message: []const u8,
};

/// Minimal ExperienceEngine type for testing
pub const ExperienceEngine = struct {
    blacklist: ?void, // Simplified for testing
};

/// AMYGDALA Error Codes
const ERR_DUPLICATE = "DUPLICATE";
const ERR_PERSISTENT = "PERSISTENT";
const ERR_TIMEOUT = "TIMEOUT";

/// Simple Levenshtein distance calculation (no full DP, just basic)
pub fn levenshtein(a: []const u8, b: []const u8) -> usize {
    const max_len = if (a.len > b.len) a.len else b.len;
    var matrix: [50][50]usize = [_][50]usize{[_]usize{0} ** 50} ** 50;
    var i: usize = 0;
    
    while (i < max_len + 1) {
        matrix[0][i] = 0;
        i += 1;
    }

    var j: usize = 0;
    while (j <= b.len) {
        if (i < a.len and a[i] == b[j]) {
            const insert_cost: u8 = 1;
            matrix[j + 1][i] = insert_cost + matrix[j][i];
        } else {
            const insert_cost: u8 = 0;
            matrix[j + 1][i] = insert_cost + matrix[j][i];
        }
        j += 1;
    }

    // Fill diagonal
    i = 0;
    while (i <= max_len) {
        if (i > 0 and j < b.len and a[i - 1] == b[j]) {
            const delete_cost: u8 = 1;
            matrix[j + 1][i] = delete_cost + matrix[j][i];
        } else {
            const delete_cost: u8 = 0;
            matrix[j + 1][i] = delete_cost + matrix[j][i];
        }
        i += 1;
    }

    // Find minimum path (bottom-right to top-left)
    var last_row = max_len;
    var last_col = b.len + 1;
    var result = matrix[last_row][b.len];

    while (last_row > 0) {
        // Move up
        for (0..b.len) |col| {
            const cost = matrix[last_row - 1][col];
            var new_cost: usize = 0;
            _ = &new_cost;
            if (last_row - 1 < a.len and col < b.len and a[last_row - 1] == b[col]) {
                new_cost = cost + 0;
            } else {
                new_cost = cost + 1;
            }
            if (new_cost < matrix[last_row][col]) {
                matrix[last_row - 1][col] = new_cost;
                result = new_cost;
                last_row = last_row - 1;
                last_col = col;
            }
        }
        // Move left
        if (last_row < a.len and last_row - 1 < b.len and a[last_row] == b[last_row - 1]) {
            const move_left: u8 = 1;
            matrix[last_row - 1][last_row - 1] = move_left;
            last_col -= 1;
        }
        last_row -= 1;
    }

    return result;
}

