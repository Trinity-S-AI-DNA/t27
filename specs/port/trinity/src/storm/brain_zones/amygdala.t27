test levenshtein_empty_strings {
    assert(levenshtein("", "") == 0);
}

test levenshtein_identical_strings {
    assert(levenshtein("hello", "hello") == 0);
}

test levenshtein_different_lengths {
    assert(levenshtein("kitten", "sitting") == 3);
}

test levenshtein_single_char {
    assert(levenshtein("a", "b") == 1);
}

test levenshtein_one_empty {
    assert(levenshtein("abc", "") == 3);
}

test checkBlacklist_no_blacklist {
    var engine: ExperienceEngine = .{ .blacklist = null };
    assert(!checkBlacklist(&engine, "test_task"));
}

test cmdCheckFear_returns_zero {
    // Use a dummy allocator for the test
    assert(cmdCheckFear(@as(std.mem.Allocator, undefined), "") == 0);
}