// Port of gHashTag/trinity src/phi-engine/uroboros_final.zig (commit df620a2b9b43)
// to a .t27 specification. The original is a self-consuming vibeec: it sniffs a
// file's language from its path suffix, digests the source with sha256, and
// restarts itself cycle after cycle. The plumbing (allocators, file reads, stdout
// printing) carries no decision content in a specification, so those functions
// keep their original names and `return undefined;`; the DECISIONS they made are
// ported as pure, testable helpers beside them.
//
// Function map (original -> spec):
//   ProfaneCode.init           -> ProfaneCode_init           (sniff + digest)
//   ProfaneCode.detectLanguage -> ProfaneCode_detectLanguage (path suffix -> Language)
//   ProfaneCode.deinit         -> ProfaneCode_deinit         (plumbing: allocator free)
//   Uroboros.init              -> Uroboros_init              (pure: cycle 0, phi = SACRED_PHI)
//   Uroboros.consume           -> Uroboros_consume           (plumbing: read + print);
//                                 its decisions live in Uroboros_next_cycle,
//                                 Uroboros_fits_content_cap and main_target_path
//   main                       -> main                       (plumbing: allocator wiring)

module port::trinity::src::phi_engine::uroboros_final;

use tri::crypto::sha256;

pub const SACRED_PHI : f64 = 1.618033988749895;
pub const SACRED_PI : f64 = 3.141592653589793;
pub const SACRED_E : f64 = 2.718281828459045;
pub const SACRED_999 : u64 = 999;
pub const TARGET_COMPLEXITY : f64 = SACRED_PI * SACRED_PHI * SACRED_E;
pub const MAX_CONTENT_BYTES : u64 = 10 * 1024 * 1024;

pub enum Language { zig, python, rust, c, javascript, unknown }

pub struct ProfaneCode {
    language: Language,
    path: []const u8,
    source: []const u8,
    hash: [32]u8,
}

pub struct Uroboros {
    cycle_count: u64,
    phi: f64,
}

pub fn ProfaneCode_detectLanguage(path: []const u8) Language {
    if (std.mem.endsWith(u8, path, ".zig")) { return Language.zig; }
    if (std.mem.endsWith(u8, path, ".py")) { return Language.python; }
    if (std.mem.endsWith(u8, path, ".rs")) { return Language.rust; }
    if (std.mem.endsWith(u8, path, ".c")) { return Language.c; }
    if (std.mem.endsWith(u8, path, ".js")) { return Language.javascript; }
    return Language.unknown;
}

pub fn ProfaneCode_init(path: []const u8, source: []const u8) ProfaneCode {
    const digest = hash(source);
    return ProfaneCode{ .language = ProfaneCode_detectLanguage(path), .path = path, .source = source, .hash = digest };
}

pub fn ProfaneCode_deinit(st: ProfaneCode) void {
    return undefined;
}

pub fn Uroboros_init() Uroboros {
    return Uroboros{ .cycle_count = 0, .phi = SACRED_PHI };
}

pub fn Uroboros_consume(st: Uroboros, path: []const u8) void {
    return undefined;
}

pub fn Uroboros_next_cycle(cycle_count: u64) u64 {
    return cycle_count + 1;
}

pub fn Uroboros_fits_content_cap(n: u64) bool {
    return n <= MAX_CONTENT_BYTES;
}

pub fn Uroboros_complexity() f64 {
    return SACRED_PI * SACRED_PHI * SACRED_E;
}

pub fn main_target_path() []const u8 {
    return "src/vibeec/tvc/tvc_ir.zig";
}

pub fn main() void {
    return undefined;
}

fn hex_digit(c: u8) u8 {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return 10 + c - 'a'; }
    return 255;
}

fn digest_is(d: [32]u8, hex: []const u8) bool {
    if (hex.len != 64) { return false; }
    var i: usize = 0;
    while (i < 32) {
        const hi = hex_digit(hex[i * 2]);
        const lo = hex_digit(hex[i * 2 + 1]);
        if (hi == 255 || lo == 255) { return false; }
        if (d[i] != (hi * 16) + lo) { return false; }
        i = i + 1;
    }
    return true;
}

test "detectLanguage maps every extension to its language" {
    assert(ProfaneCode_detectLanguage("tvc_ir.zig") == Language.zig);
    assert(ProfaneCode_detectLanguage("engine.py") == Language.python);
    assert(ProfaneCode_detectLanguage("lib.rs") == Language.rust);
    assert(ProfaneCode_detectLanguage("main.c") == Language.c);
    assert(ProfaneCode_detectLanguage("app.js") == Language.javascript);
    assert(ProfaneCode_detectLanguage("spec.t27") == Language.unknown);
    assert(ProfaneCode_detectLanguage("") == Language.unknown);
}

test "detectLanguage matches only at the very end of the path" {
    assert(ProfaneCode_detectLanguage("tvc_ir.zig.bak") == Language.unknown);
    assert(ProfaneCode_detectLanguage("notazigfile") == Language.unknown);
    assert(ProfaneCode_detectLanguage("SHOUTED.ZIG") == Language.unknown);
    assert(ProfaneCode_detectLanguage("x.zig.py") == Language.python);
    assert(ProfaneCode_detectLanguage(".zig") == Language.zig);
}

test "the uroboros target path points at a zig file" {
    assert(main_target_path() == "src/vibeec/tvc/tvc_ir.zig");
    assert(ProfaneCode_detectLanguage(main_target_path()) == Language.zig);
}

test "SACRED constants carry the trinity values" {
    const u = Uroboros_init();
    assert(u.cycle_count == 0);
    assert(u.phi == SACRED_PHI);
    assert(u.phi == 1.618033988749895);
    assert(SACRED_999 == Uroboros_next_cycle(SACRED_999 - 1));
    assert(Uroboros_fits_content_cap(SACRED_999) == true);
}

test "TARGET_COMPLEXITY is the product of the trinity" {
    assert(Uroboros_complexity() == TARGET_COMPLEXITY);
    assert(Uroboros_complexity() == 13.817580227176492);
    assert(Uroboros_fits_content_cap(MAX_CONTENT_BYTES) == true);
    assert(Uroboros_fits_content_cap(MAX_CONTENT_BYTES + 1) == false);
}

test "ProfaneCode_init digests the source with sha256" {
    const p = ProfaneCode_init("anything.t27", "");
    assert(digest_is(p.hash, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"));
    const q = ProfaneCode_init("x.rs", "tvc");
    assert(digest_is(q.hash, "330834ee015086e15c925297ba450f8f495b6acf1b89f34499f1420beaf98684"));
    const r = ProfaneCode_init("x.py", "print(1)");
    assert(digest_is(r.hash, "d287bb7f9d15abdc5b6e98536263815744b6ef21c8f3c839fc434ca70d8efe99"));
}

test "ProfaneCode_init records path source and detected language" {
    const p = ProfaneCode_init("vibeec.py", "print(1)");
    assert(p.path == "vibeec.py");
    assert(p.source == "print(1)");
    assert(p.language == Language.python);
    const q = ProfaneCode_init("tvc_ir.zig", "pub fn main() void {}");
    assert(q.language == Language.zig);
    assert(q.path == "tvc_ir.zig");
}

test "Uroboros_init starts at cycle zero with the golden ratio" {
    const u = Uroboros_init();
    assert(u.cycle_count == 0);
    assert(u.phi == SACRED_PHI);
}

test "Uroboros_consume advances the cycle counter one step at a time" {
    assert(Uroboros_next_cycle(0) == 1);
    assert(Uroboros_next_cycle(SACRED_999) == 1000);
    const c1 = Uroboros_next_cycle(0);
    const c2 = Uroboros_next_cycle(c1);
    const c3 = Uroboros_next_cycle(c2);
    assert(c1 == 1);
    assert(c2 == 2);
    assert(c3 == 3);
}

test "consume refuses content above the ten megabyte cap" {
    assert(Uroboros_fits_content_cap(0) == true);
    assert(Uroboros_fits_content_cap(1) == true);
    assert(Uroboros_fits_content_cap(MAX_CONTENT_BYTES) == true);
    assert(Uroboros_fits_content_cap(MAX_CONTENT_BYTES + 1) == false);
}
