module port::trinity::src::phi_engine::runtime::simd_ternary;

// Port of gHashTag/trinity src/phi-engine/runtime/simd_ternary.zig @ e71d166ad6ef.
// VIBEE PHI-ENGINE - SIMD TERNARY (Solution #5)
// SIMD Ternary - 32x Parallelism for Trits
// Scientific Basis: Setun (1958) - Nikolai Brusentsov, Balanced Ternary Computer
// Sacred Formula: 27 = 3^3 = (phi^2 + 1/phi^2)^3
// Original implementation: a simplified SIMD wrapper over i8 vectors
// (it replaces an external Vec32i8 dependency with a local type).
//
// .t27 has no type aliases, so the original's
//   pub const Trit = i8;  pub const Vec32Trit = [32]Trit;
// is spelled out as [32]i8 in every signature below.

pub const PHI: f64 = 1.618033988749895;
pub const GOLDEN_IDENTITY: f64 = 3.0;

// A trit (balanced ternary digit) is an i8 in -13..13; a vector is 32 lanes.
const TRIT_COUNT: usize = 32;

// Helper to create a vector filled with a trit (original line 26).
pub fn vec32_splat(trit: i8) [32]i8 {
    var vec: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        vec[i] = trit;
        i += 1;
    }
    return vec;
}

// Helper to create a vector filled with zeros (original line 35).
pub fn vec32_zero() [32]i8 {
    return vec32_splat(0);
}

// Helper to create a vector filled with ones (original line 40).
pub fn vec32_one() [32]i8 {
    return vec32_splat(1);
}

// SIMD Trit addition, 32x parallelism (original line 45).
// The original uses @addWithOverflow(a[i], b[i]).result, i.e. a wrapping i8
// add. Valid trits lie in -13..13, so a[i] + b[i] stays inside -26..26 and
// the plain i8 add yields exactly the same result with no overflow.
pub fn tritAddVec(a: [32]i8, b: [32]i8) [32]i8 {
    var result: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        result[i] = a[i] + b[i];
        i += 1;
    }
    return result;
}

// SIMD Trit subtraction, 32x parallelism (original line 57).
// Same shape as the add: the original keeps @subWithOverflow's result, and
// for valid trits a[i] - b[i] never overflows i8.
pub fn tritSubVec(a: [32]i8, b: [32]i8) [32]i8 {
    var result: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        result[i] = a[i] - b[i];
        i += 1;
    }
    return result;
}

// SIMD Trit negation, 32x parallelism (original line 68).
// The original computes @subWithOverflow(0, a[i]).result, i.e. 0 - a[i].
pub fn tritNegVec(a: [32]i8) [32]i8 {
    var result: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        result[i] = 0 - a[i];
        i += 1;
    }
    return result;
}

// SIMD Trit max, 32x parallelism (original line 79).
pub fn tritMaxVec(a: [32]i8, b: [32]i8) [32]i8 {
    var result: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        result[i] = if (a[i] > b[i]) a[i] else b[i];
        i += 1;
    }
    return result;
}

// SIMD Trit min, 32x parallelism (original line 88).
pub fn tritMinVec(a: [32]i8, b: [32]i8) [32]i8 {
    var result: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        result[i] = if (a[i] < b[i]) a[i] else b[i];
        i += 1;
    }
    return result;
}

// ════════════════════════════════════════════════════════════╗
// ║                          TESTS                               ║
// ╚═══════════════════════════════════════════════════════════════╝

test vec32_splat_fills_every_lane {
    const ones = vec32_splat(1);
    for t in ones {
        assert(t == 1);
    }
}

test vec32_splat_extreme_trits {
    const lo = vec32_splat(-13);
    var i: usize = 0;
    while (i < TRIT_COUNT) {
        assert(lo[i] == -13);
        i += 1;
    }
    const hi = vec32_splat(13);
    assert(hi[0] == 13);
    assert(hi[15] == 13);
    assert(hi[31] == 13);
}

test vec32_zero_is_all_zero {
    const z = vec32_zero();
    for t in z {
        assert(t == 0);
    }
}

test vec32_one_is_all_one {
    const o = vec32_one();
    for t in o {
        assert(t == 1);
    }
}

test tritAddVec_basic {
    const a = vec32_splat(1);
    const b = vec32_splat(0);
    const r = tritAddVec(a, b);
    for t in r {
        assert(t == 1);
    }
}

test tritAddVec_per_lane {
    var a: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var b: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    a[0] = 13;
    b[0] = -13;
    a[1] = -13;
    b[1] = -13;
    a[2] = 5;
    b[2] = -5;
    a[31] = 7;
    b[31] = 7;
    const r = tritAddVec(a, b);
    assert(r[0] == 0);
    assert(r[1] == -26);
    assert(r[2] == 0);
    assert(r[31] == 14);
    assert(r[3] == 0);
    assert(r[16] == 0);
}

test tritSubVec_basic {
    const a = vec32_splat(1);
    const b = vec32_splat(0);
    const r = tritSubVec(a, b);
    for t in r {
        assert(t == 1);
    }
}

test tritSubVec_per_lane {
    var a: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var b: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    a[0] = 5;
    b[0] = 10;
    a[1] = 13;
    b[1] = -13;
    a[2] = -13;
    b[2] = 13;
    const r = tritSubVec(a, b);
    assert(r[0] == -5);
    assert(r[1] == 26);
    assert(r[2] == -26);
    assert(r[4] == 0);
}

test tritNegVec_all_lanes {
    const a = vec32_splat(1);
    const r = tritNegVec(a);
    for t in r {
        assert(t == -1);
    }
}

test tritNegVec_per_lane {
    var a: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    a[0] = 13;
    a[1] = -13;
    a[2] = 0;
    const r = tritNegVec(a);
    assert(r[0] == -13);
    assert(r[1] == 13);
    assert(r[2] == 0);
    assert(r[17] == 0);
}

test tritMaxVec_picks_larger {
    const small = vec32_splat(5);
    const big = vec32_splat(10);
    const r = tritMaxVec(small, big);
    for t in r {
        assert(t == 10);
    }
    var a: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var b: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    a[0] = -13;
    b[0] = 13;
    a[1] = 7;
    b[1] = 7;
    a[2] = 10;
    b[2] = 5;
    const m = tritMaxVec(a, b);
    assert(m[0] == 13);
    assert(m[1] == 7);
    assert(m[2] == 10);
    assert(m[3] == 0);
}

test tritMinVec_picks_smaller {
    const small = vec32_splat(5);
    const big = vec32_splat(10);
    const r = tritMinVec(small, big);
    for t in r {
        assert(t == 5);
    }
    var a: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    var b: [32]i8 = [_]i8{0} ** TRIT_COUNT;
    a[0] = -13;
    b[0] = 13;
    a[1] = 0;
    b[1] = 0;
    a[2] = 5;
    b[2] = 10;
    const m = tritMinVec(a, b);
    assert(m[0] == -13);
    assert(m[1] == 0);
    assert(m[2] == 5);
    assert(m[3] == 0);
}

test golden_identity_phi_squared_plus_inverse {
    // phi^2 + 1/phi^2 = 3 (EXACT!), as the original's test asserts.
    const phi_sq: f64 = PHI * PHI;
    const inv_phi_sq: f64 = 1.0 / (PHI * PHI);
    const sum: f64 = phi_sq + inv_phi_sq;
    var diff: f64 = sum - GOLDEN_IDENTITY;
    if (diff < 0.0) {
        diff = 0.0 - diff;
    }
    assert(diff < 0.0001);
}
