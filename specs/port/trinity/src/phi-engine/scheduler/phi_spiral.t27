module port::trinity::src::phi_engine::scheduler::phi_spiral;

// Port of gHashTag/trinity src/phi-engine/scheduler/phi_spiral.zig @5aabfbe8346f
// VIBEE Solution #7 - Phi spiral placement (phi^2 = phi + 1).
//
// Port decisions:
// - std.math.cos/sin/sqrt are compiler builtins in t27 (verified by probe),
//   so they are used directly, like the original used std.math.
// - phiSpiralSequence took std.mem.Allocator and returned a growable slice.
//   The allocation is plumbing; the decision is the fill loop, so the caller
//   now passes a fixed-capacity buffer and the function returns how many
//   points it wrote (0 when count is 0, min(count, out.len) otherwise).
// - Test expectations follow what the implementation's formulas return
//   (radius = 30 + 8n, angle = n*phi*pi, x = r*cos(angle), y = r*sin(angle));
//   the original test block's literals (x=0/y=0 at n=0, r=30 at n=1,
//   x=69.5/y=85.4 at n=10) contradict its own code and are not carried over.

pub const PHI: f64 = 1.618033988749895;
pub const GOLDEN_IDENTITY: f64 = 3.0;

// std.math.pi
const PI: f64 = 3.141592653589793;

pub struct PhiSpiral2D {
    angle: f64,
    radius: f64,
    x: f64,
    y: f64,
}

pub struct PhiSpiral3D {
    angle: f64,
    radius: f64,
    x: f64,
    y: f64,
    z: f64,
}

// line 31: pub fn phiSpiral(n: u32) PhiSpiral2D
pub fn phiSpiral(n: u32) -> PhiSpiral2D {
    const n_float: f64 = n as f64;
    const angle = n_float * PHI * PI;
    const radius = 30.0 + n_float * 8.0;
    return PhiSpiral2D {
        angle: angle,
        radius: radius,
        x: radius * cos(angle),
        y: radius * sin(angle),
    };
}

// line 45: pub fn phiSpiral3D(n: u32, z_growth: f64) PhiSpiral3D
pub fn phiSpiral3D(n: u32, z_growth: f64) -> PhiSpiral3D {
    const n_float: f64 = n as f64;
    const spiral = phiSpiral(n);
    return PhiSpiral3D {
        angle: spiral.angle,
        radius: spiral.radius,
        x: spiral.x,
        y: spiral.y,
        z: n_float * z_growth,
    };
}

// line 59: pub fn phiSpiralSequence(count: u32, allocator: std.mem.Allocator) ![]PhiSpiral2D
// The allocator became a caller-provided fixed-capacity buffer; the kept
// decision is the fill loop: point i of the sequence is phiSpiral(i), and at
// most out.len points fit. Returns the number of points written.
pub fn phiSpiralSequence(count: u32, out: []PhiSpiral2D) -> usize {
    var i: usize = 0;
    const want: usize = count as usize;
    while (i < out.len and i < want) {
        out[i] = phiSpiral(i as u32);
        i += 1;
    }
    return i;
}

// Original test helper: |a - b| <= tol without an abs builtin.
fn near(a: f64, b: f64, tol: f64) -> bool {
    const d = a - b;
    return d < tol and d > -tol;
}

// Original test 6 decision: consecutive spiral points are not clustered --
// count neighbouring pairs closer than `limit` (sqrt(dx*dx + dy*dy) < limit).
pub fn countClustered(points: []PhiSpiral2D, limit: f64) -> usize {
    var clustered: usize = 0;
    var i: usize = 0;
    while (i + 1 < points.len) {
        const j: usize = i + 1;
        const dx = points[i].x - points[j].x;
        const dy = points[i].y - points[j].y;
        const d = sqrt(dx * dx + dy * dy);
        if (d < limit) {
            clustered += 1;
        }
        i += 1;
    }
    return clustered;
}

// Original test 4: the published constants are the golden ratio and its
// identity constant, and phi satisfies phi^2 = phi + 1.
test golden_ratio_constants {
    assert(PHI == 1.618033988749895);
    assert(GOLDEN_IDENTITY == 3.0);
    assert(near(PHI * PHI, PHI + 1.0, 0.000000001));
}

// Original test 1 behaviour as implemented: n=0 -> angle 0, radius 30,
// x = 30*cos(0) = 30, y = 30*sin(0) = 0.
test phi_spiral_n0 {
    const p = phiSpiral(0);
    assert(p.angle == 0.0);
    assert(p.radius == 30.0);
    assert(near(p.x, 30.0, 0.000000001));
    assert(near(p.y, 0.0, 0.000000001));
}

// Original test 2 behaviour as implemented: n=1 -> radius 38,
// angle = phi*pi ~= 5.083203692315, x = 38*cos(angle) ~= 13.7702,
// y = 38*sin(angle) ~= -35.4172.
test phi_spiral_n1 {
    const p = phiSpiral(1);
    assert(p.radius == 38.0);
    assert(near(p.angle, 5.083203692315, 0.000000001));
    assert(near(p.x, 13.770245823, 0.001));
    assert(near(p.y, -35.417232105, 0.001));
}

// Original test 3 behaviour as implemented: n=10 -> radius 110,
// angle = 10*phi*pi ~= 50.832036923153 (mod 2*pi: 0.566554466),
// x = 110*cos(angle) ~= 92.8131, y = 110*sin(angle) ~= 59.0401.
test phi_spiral_n10 {
    const p = phiSpiral(10);
    assert(p.radius == 110.0);
    assert(near(p.angle, 50.832036923153, 0.000001));
    assert(near(p.x, 92.813082439, 0.001));
    assert(near(p.y, 59.040085786, 0.001));
}

// line 45 behaviour: the 3D spiral reuses the 2D point and lifts it by
// n * z_growth (exact for these inputs).
test phi_spiral_3d_lifts_z {
    const p = phiSpiral3D(2, 0.5);
    assert(p.radius == 46.0);
    assert(p.z == 1.0);
    const q = phiSpiral3D(3, -2.0);
    assert(q.z == -6.0);
    const r = phiSpiral(2);
    assert(p.angle == r.angle);
    assert(p.radius == r.radius);
    assert(p.x == r.x);
    assert(p.y == r.y);
}

// Original test 5: the first 5 sequence points sit on radii 30, 38, 46, 54, 62.
test sequence_first_five_radii {
    var buf: [8]PhiSpiral2D = undefined;
    const written = phiSpiralSequence(5, &buf);
    assert(written == 5);
    assert(buf[0].radius == 30.0);
    assert(buf[1].radius == 38.0);
    assert(buf[2].radius == 46.0);
    assert(buf[3].radius == 54.0);
    assert(buf[4].radius == 62.0);
}

// The fill loop clamps to the buffer capacity (the original returned a slice
// of exactly `count`; here the caller's buffer is the bound).
test sequence_clamps_to_capacity {
    var buf: [4]PhiSpiral2D = undefined;
    const written = phiSpiralSequence(9, &buf);
    assert(written == 4);
    assert(buf[3].radius == 54.0);
}

// Original early-return decision: count == 0 writes nothing.
test sequence_zero_count_writes_nothing {
    var buf: [4]PhiSpiral2D = undefined;
    const written = phiSpiralSequence(0, &buf);
    assert(written == 0);
}

// Original test 6: consecutive points never come within 5.0 of each other.
// A duplicated point is the positive control so the counter cannot pass vacuously.
test no_clustering_of_consecutive_points {
    var buf: [12]PhiSpiral2D = undefined;
    const written = phiSpiralSequence(12, &buf);
    assert(written == 12);
    assert(countClustered(&buf, 5.0) == 0);
    buf[3] = phiSpiral(2);
    assert(countClustered(&buf, 5.0) == 1);
}
