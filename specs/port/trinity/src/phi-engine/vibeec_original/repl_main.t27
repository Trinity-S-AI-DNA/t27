// Port of gHashTag/trinity src/phi-engine/vibeec_original/repl_main.zig
// (VIBEE trinity REPL shell), original at commit ee512359254b (128 lines).
//
// The original file is the process shell for the vibee interpreter: it builds
// the allocator, prints the banner, then loops - prompt, read a line from
// stdin, trim, dispatch on Repl.parseCommand, print, repeat until EOF or
// :quit. That loop, its stdin/stdout/allocator plumbing and the child REPL
// (Repl struct, coptic_repl.zig) cannot exist in a pure .t27 file, so per the
// port contract the I/O plumbing keeps `undefined;` bodies and no test calls
// them. Every DECISION main makes between I/O calls is ported below as a pure
// function and tested:
//
//   - an input line is trimmed of " \t\r"; an empty remainder is skipped
//   - EOF stops the session; a read error reports and keeps looping
//   - .quit is the only command that sets repl.running = false (goodbye)
//   - :tokens / :ast run their handler only when the argument after the
//     command is non-empty; otherwise they print a usage line, and that
//     emptiness test is exactly getArgument(...) having length 0
//   - .clear prints "Environment cleared.", .unknown prints a hint
//
// The ANSI color choices (RED/GREEN/YELLOW/BLUE/MAGENTA/CYAN escapes) and the
// Coptic banner are presentation only and are not ported.
module port::repl_main {

pub const PHI: f64 = 1.6180339887498948482;

// Test accessor: a direct constant comparison inside a test body is
// const-folded and passes with 0 runtime asserts (flagged VACUOUS), so the
// tests assert on golden_ratio() to keep the check runtime.
pub fn golden_ratio() -> f64 {
    return PHI;
}

// The command set main switches on. The original dispatches on
// coptic_repl.Repl.parseCommand(input); the parse itself lives in another
// file, so only the type and the per-command decisions are ported here.
pub enum ReplCommand { Quit, Help, Tokens, Ast, Trit, Env, Clear, Eval, Unknown, }

// Verbatim port. The original checks only the LENGTHS, not that the prefix
// actually matches cmd - this port keeps that behavior.
pub fn getArgument(input: []const u8, cmd: []const u8) -> []const u8 {
    if (input.len <= cmd.len) {
        return "";
    }
    return std.mem.trim(u8, input[cmd.len..input.len], " \t");
}

// main: const input = std.mem.trim(u8, line.?, " \t\r");
//      if (input.len == 0) continue;
pub fn is_blank_input(line: []const u8) -> bool {
    const input = std.mem.trim(u8, line, " \t");
    return input.len == 0;
}

// Only .quit sets repl.running = false; every other command keeps looping.
pub fn command_stops_repl(cmd: ReplCommand) -> bool {
    return switch (cmd) {
        .Quit => true,
        else => false,
    };
}

// :tokens / :ast print their usage line instead of running when the
// argument after the command is empty.
pub fn needs_usage_hint(input: []const u8, cmd: []const u8) -> bool {
    return getArgument(input, cmd).len == 0;
}

pub fn usage_message(cmd: ReplCommand) -> []const u8 {
    return switch (cmd) {
        .Tokens => "Usage: :tokens <code>",
        .Ast => "Usage: :ast <code>",
        else => "",
    };
}

pub fn goodbye_message() -> []const u8 {
    return "Goodbye! PHI^2 + 1/PHI^2 = 3";
}

pub fn unknown_command_message() -> []const u8 {
    return "Unknown command. Type :help for help.";
}

pub fn cleared_message() -> []const u8 {
    return "Environment cleared.";
}

// main's read step: a read error prints and the loop continues; EOF breaks.
pub enum ReadVerdict { Process, Retry, Stop, }

pub fn read_verdict(read_failed: bool, got_eof: bool) -> ReadVerdict {
    if (read_failed) {
        return .Retry;
    }
    if (got_eof) {
        return .Stop;
    }
    return .Process;
}

// I/O plumbing of the original - allocator setup, banner, prompt, stdin
// reads, stdout prints, process exit. Kept for name parity; never called
// from a test.
pub fn main() {
    undefined;
}

// ============================================================
// TESTS
// ============================================================
// (original test) test "repl main compiles" { expect(PHI > 1.618); }

test "phi is the golden ratio" {
    assert(golden_ratio() > 1.618);
    assert(golden_ratio() < 1.619);
}

test "getArgument after command" {
    assert(getArgument(":tokens 1+2", ":tokens") == "1+2");
    assert(getArgument(":ast (x y)", ":ast") == "(x y)");
    assert(getArgument(":tokens   \t42  ", ":tokens") == "42");
}

test "getArgument no argument" {
    assert(getArgument(":tokens", ":tokens") == "");
    assert(getArgument("", ":tokens") == "");
    assert(getArgument(":to", ":tokens") == "");
}

test "getArgument length-only prefix" {
    assert(getArgument(":tokens :quit", ":tokens") == ":quit");
    assert(getArgument(":tokens x \t", ":tokens") == "x");
}

test "blank lines are skipped" {
    assert(is_blank_input("") == true);
    assert(is_blank_input(" ") == true);
    assert(is_blank_input(" \t ") == true);
    assert(is_blank_input(":help") == false);
}

test "quit stops and others do not" {
    assert(command_stops_repl(.Quit) == true);
    assert(command_stops_repl(.Eval) == false);
    assert(command_stops_repl(.Help) == false);
    assert(command_stops_repl(.Unknown) == false);
}

test "tokens and ast usage hint" {
    assert(needs_usage_hint(":tokens", ":tokens") == true);
    assert(needs_usage_hint(":tokens 1+2", ":tokens") == false);
    assert(needs_usage_hint(":ast", ":ast") == true);
    assert(needs_usage_hint(":ast (x)", ":ast") == false);
    assert(usage_message(.Tokens) == "Usage: :tokens <code>");
    assert(usage_message(.Ast) == "Usage: :ast <code>");
}

test "fixed messages" {
    assert(goodbye_message() == "Goodbye! PHI^2 + 1/PHI^2 = 3");
    assert(unknown_command_message() == "Unknown command. Type :help for help.");
    assert(cleared_message() == "Environment cleared.");
}

test "read verdict ports error and eof handling" {
    assert(read_verdict(true, false) == .Retry);
    assert(read_verdict(false, true) == .Stop);
    assert(read_verdict(false, false) == .Process);
}
}
