module TrueCodegenStandalone;

pub struct Specification {
    name: str,
    behaviors: []Behavior,
}

pub struct Behavior {
    name: str,
    description: str,
    given: str,
    when: str,
    then: str,
    implementation: str,
}

pub fn main() -> i32 {
    // Port the decision, not the plumbing
    // This function uses std.process.argsAlloc, std.process.argsFree,
    // std.fs.path.stem, std.fs.cwd().createFile, and allocator operations
    // which are external - undefined body for tests
    return 0;
}

pub fn generateTrueCompilation(spec: *const Specification) -> []const u8 {
    // Port the decision, not the plumbing
    // This function uses std.ArrayList, allocator operations, and string formatting
    // which are external - undefined body for tests
    return generateTrueCompilationImpl(spec);
}

fn generateTrueCompilationImpl(spec: *const Specification) -> []const u8 {
    // Core logic implementation - this is the decision that should be ported
    var result: [500]u8 = undefined;
    var pos: usize = 0;
    
    // If no behaviors, return empty string
    if (spec.behaviors.len == 0) {
        return result[0..0];
    }
    
    // Add header comments
    const line1 = "// ═══════════════════════════════════════════════════════════════\n";
    for (line1) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const line2 = "// TRUE COMPILATION GENERATION\n";
    for (line2) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const line3_prefix = "// From: ";
    for (line3_prefix) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    for (spec.name) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const line3_suffix = "\n";
    for (line3_suffix) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const line4 = "// ═══════════════════════════════════════════════════════════════\n";
    for (line4) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const line5 = "\n";
    for (line5) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    const std_import = "const std = @import(\"std\");\n\n";
    for (std_import) |c| {
        result[pos] = c;
        pos += 1;
    }
    
    // Generate functions from behaviors
    if (spec.behaviors.len > 0) {
        // Add section header
        const section1 = "// ═══════════════════════════════════════════════════════════════\n";
        for (section1) |c| {
            result[pos] = c;
            pos += 1;
        }
        
        const section2 = "// REAL FUNCTIONS FROM IMPLEMENTATIONS\n";
        for (section2) |c| {
            result[pos] = c;
            pos += 1;
        }
        
        const section3 = "// ═══════════════════════════════════════════════════════════════\n";
        for (section3) |c| {
            result[pos] = c;
            pos += 1;
        }
        
        const section4 = "\n";
        for (section4) |c| {
            result[pos] = c;
            pos += 1;
        }
        
        // Process each behavior
        for (spec.behaviors) |behavior| {
            if (behavior.implementation.len > 0) {
                // Generate REAL function
                const prefix = "pub fn ";
                for (prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.name) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const middle1 = "() ";
                for (middle1) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.then) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const middle2 = " !void {\n";
                for (middle2) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                // Add description comment
                const desc_prefix = "    // ";
                for (desc_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.description) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const desc_suffix = "\n\n";
                for (desc_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                // Add implementation comment
                const impl_prefix = "    // Implementation:\n";
                for (impl_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                // Add implementation
                for (behavior.implementation) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const impl_suffix = "\n";
                for (impl_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const close_brace = "}\n\n";
                for (close_brace) |c| {
                    result[pos] = c;
                    pos += 1;
                }
            } else {
                // Generate test (fallback)
                const test_prefix = "test \"";
                for (test_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.name) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const test_middle = "\" {\n";
                for (test_middle) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                // Add test comments
                const given_prefix = "    // Given: ";
                for (given_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.given) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const given_suffix = "\n";
                for (given_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const when_prefix = "    // When: ";
                for (when_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.when) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const when_suffix = "\n";
                for (when_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const then_prefix = "    // Then: ";
                for (then_prefix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                for (behavior.then) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const then_suffix = "\n";
                for (then_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const empty_line = "    \n";
                for (empty_line) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const expect_line = "    try std.testing.expect(true);\n";
                for (expect_line) |c| {
                    result[pos] = c;
                    pos += 1;
                }
                
                const test_suffix = "}\n\n";
                for (test_suffix) |c| {
                    result[pos] = c;
                    pos += 1;
                }
            }
        }
    }
    
    // Return the result as a slice
    return result[0..pos];
}

test "main function exists" {
    // Test that main function can be called (body is undefined for external operations)
    const result = main();
    // Should return 0 (success) when called without arguments
    assert(result == 0);
}

test "generateTrueCompilation with empty spec" {
    var spec = Specification{
        .name = "test_spec",
        .behaviors = &[_]Behavior{},
    };
    
    const result = generateTrueCompilation(&spec);
    // Should return empty string when no behaviors
    assert(result.len == 0);
}

test "generateTrueCompilation with behavior that has implementation" {
    var behaviors: [1]Behavior = [_]Behavior{
        Behavior{
            .name = "test_function",
            .description = "A test function",
            .given = "given condition",
            .when = "when action",
            .then = "void",
            .implementation = "std.debug.print(\"Hello, World!\\n\");",
        },
    };
    
    var spec = Specification{
        .name = "test_spec",
        .behaviors = &behaviors,
    };
    
    const result = generateTrueCompilation(&spec);
    // Should generate code that includes the function signature and implementation
    assert(result.len > 0);
    // Check if the result contains the function name (using slicing instead of contains)
    assert(result.len >= "test_function".len);
    var found = false;
    for (0..result.len - "test_function".len + 1) |i| {
        if (result[i..i + "test_function".len] == "test_function") {
            found = true;
            break;
        }
    }
    assert(found);
    // Check for Hello, World using similar approach
    var found_hello = false;
    for (0..result.len - "Hello, World".len + 1) |i| {
        if (result[i..i + "Hello, World".len] == "Hello, World") {
            found_hello = true;
            break;
        }
    }
    assert(found_hello);
}

test "generateTrueCompilation with behavior that has no implementation" {
    var behaviors: [1]Behavior = [_]Behavior{
        Behavior{
            .name = "test_behavior",
            .description = "A test behavior",
            .given = "given condition",
            .when = "when action",
            .then = "void",
            .implementation = "",
        },
    };
    
    var spec = Specification{
        .name = "test_spec",
        .behaviors = &behaviors,
    };
    
    const result = generateTrueCompilation(&spec);
    // Should generate test code when no implementation exists
    assert(result.len > 0);
    // Check for test string using slicing
    var found_test = false;
    for (0..result.len - "test \"test_behavior\"".len + 1) |i| {
        if (result[i..i + "test \"test_behavior\"".len] == "test \"test_behavior\"") {
            found_test = true;
            break;
        }
    }
    assert(found_test);
    // Check for expect statement using slicing
    var found_expect = false;
    for (0..result.len - "try std.testing.expect(true)".len + 1) |i| {
        if (result[i..i + "try std.testing.expect(true)".len] == "try std.testing.expect(true)") {
            found_expect = true;
            break;
        }
    }
    assert(found_expect);
}

test "generateTrueCompilation generates header comment" {
    var behaviors: [1]Behavior = [_]Behavior{
        Behavior{
            .name = "test_function",
            .description = "A test function",
            .given = "given condition",
            .when = "when action",
            .then = "void",
            .implementation = "std.debug.print(\"Hello, World!\\n\");",
        },
    };
    
    var spec = Specification{
        .name = "my_spec",
        .behaviors = &behaviors,
    };
    
    const result = generateTrueCompilation(&spec);
    // Should generate header with spec name
    var found_header = false;
    for (0..result.len - "TRUE COMPILATION GENERATION".len + 1) |i| {
        if (result[i..i + "TRUE COMPILATION GENERATION".len] == "TRUE COMPILATION GENERATION") {
            found_header = true;
            break;
        }
    }
    assert(found_header);
    
    var found_from = false;
    for (0..result.len - "From: my_spec".len + 1) |i| {
        if (result[i..i + "From: my_spec".len] == "From: my_spec") {
            found_from = true;
            break;
        }
    }
    assert(found_from);
    
    var found_std = false;
    for (0..result.len - "const std = @import(\"std\");".len + 1) |i| {
        if (result[i..i + "const std = @import(\"std\");".len] == "const std = @import(\"std\");") {
            found_std = true;
            break;
        }
    }
    assert(found_std);
}

test "generateTrueCompilation generates multiple functions" {
    var behaviors: [2]Behavior = [_]Behavior{
        Behavior{
            .name = "first_function",
            .description = "First test function",
            .given = "given condition",
            .when = "when action",
            .then = "void",
            .implementation = "std.debug.print(\"First\\n\");",
        },
        Behavior{
            .name = "second_function",
            .description = "Second test function", 
            .given = "given condition",
            .when = "when action",
            .then = "void",
            .implementation = "std.debug.print(\"Second\\n\");",
        },
    };
    
    var spec = Specification{
        .name = "multi_spec",
        .behaviors = &behaviors,
    };
    
    const result = generateTrueCompilation(&spec);
    // Should generate both functions
    var found_first = false;
    for (0..result.len - "first_function".len + 1) |i| {
        if (result[i..i + "first_function".len] == "first_function") {
            found_first = true;
            break;
        }
    }
    assert(found_first);
    
    var found_second = false;
    for (0..result.len - "second_function".len + 1) |i| {
        if (result[i..i + "second_function".len] == "second_function") {
            found_second = true;
            break;
        }
    }
    assert(found_second);
    
    // Count pub fn occurrences manually
    var pub_fn_count = 0;
    for (0..result.len - "pub fn".len + 1) |i| {
        if (result[i..i + "pub fn".len] == "pub fn") {
            pub_fn_count += 1;
        }
    }
    assert(pub_fn_count >= 2);
}