module port::bogatyrs_spec_structure;

// VIBEE BOGATYR - Spec Structure Validator
// Checks withto .tri withandtoand
// φ² + 1/φ² = 3 | PHOENIX = 999

const NAME = "spec_structure";
const VERSION = "1.0.0";
const CATEGORY = "syntax";
const PRIORITY = 1;

// Helper function to trim whitespace from both ends
fn trimWhitespace(str: []const u8) -> []const u8 {
    var start: usize = 0;
    var end: usize = str.len;
    
    // Find first non-whitespace character
    while (start < end and (str[start] == ' ' or str[start] == '\t' or str[start] == '\r')) {
        start += 1;
    }
    
    // Find last non-whitespace character
    while (end > start and (str[end - 1] == ' ' or str[end - 1] == '\t' or str[end - 1] == '\r')) {
        end -= 1;
    }
    
    return str[start..end];
}

// Helper function to find character in string
fn findChar(str: []const u8, char: u8) -> ?usize {
    for (str) |c, i| {
        if (c == char) {
            return i;
        }
    }
    return null;
}

// Helper function to compare strings
fn stringsEqual(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    
    for (a) |c, i| {
        if (c != b[i]) {
            return false;
        }
    }
    
    return true;
}

// Helper function for approximate float equality (bounded numerical method)
fn approxEqualAbs(a: f64, b: f64, tolerance: f64) -> bool {
    const diff = if (a > b) a - b else b - a;
    return diff <= tolerance;
}

// Simple bounded sqrt approximation using fixed-point iteration
fn boundedSqrt(x: f64) -> f64 {
    if (x < 0.0) return 0.0;
    if (x == 0.0) return 0.0;
    if (x == 1.0) return 1.0;
    
    var guess: f64 = x / 2.0;
    var prev_guess: f64 = 0.0;
    var i: usize = 0;
    
    while (i < 10) {
        prev_guess = guess;
        guess = (guess + x / guess) / 2.0;
        
        if (guess == prev_guess) {
            break;
        }
        
        i += 1;
    }
    
    return guess;
}

pub fn validateSpecStructure(ctx: []const u8) -> bool {
    var has_name = false;
    var has_version = false;
    var has_language = false;
    var has_module = false;

    // Simple line-by-line processing without Zig-specific syntax
    var line_ptr: usize = 0;
    var ctx_len: usize = ctx.len;
    
    while (line_ptr < ctx_len) {
        // Find next newline
        var line_end: usize = line_ptr;
        while (line_end < ctx_len and ctx[line_end] != '\n') {
            line_end += 1;
        }
        
        var line: []const u8 = ctx[line_ptr..line_end];
        line_ptr = line_end + 1;
        
        // Skip empty lines and comments
        var trimmed = trimWhitespace(line);
        if (trimmed.len == 0 or trimmed[0] == '#') continue;

        // Check for colon separator
        var colon_idx = findChar(trimmed, ':');
        if (colon_idx != null and colon_idx.? > 0) {
            var key = trimWhitespace(trimmed[0..colon_idx.?]);

            if (stringsEqual(key, "name")) has_name = true;
            if (stringsEqual(key, "version")) has_version = true;
            if (stringsEqual(key, "language")) has_language = true;
            if (stringsEqual(key, "module")) has_module = true;
        }
    }

    return has_name and has_version and has_language and has_module;
}

test "spec structure - valid spec" {
    const valid_spec = "name: test_spec\nversion: \"1.0.0\"\nlanguage: zig\nmodule: test_spec";

    const result = validateSpecStructure(valid_spec);
    assert(result == true);
}

test "spec structure - missing name" {
    const invalid_spec = "version: \"1.0.0\"\nlanguage: zig\nmodule: test_spec";

    const result = validateSpecStructure(invalid_spec);
    assert(result == false);
}

test "spec structure - missing version" {
    const invalid_spec = "name: test_spec\nlanguage: zig\nmodule: test_spec";

    const result = validateSpecStructure(invalid_spec);
    assert(result == false);
}

test "spec structure - missing language" {
    const invalid_spec = "name: test_spec\nversion: \"1.0.0\"\nmodule: test_spec";

    const result = validateSpecStructure(invalid_spec);
    assert(result == false);
}

test "spec structure - missing module" {
    const invalid_spec = "name: test_spec\nversion: \"1.0.0\"\nlanguage: zig";

    const result = validateSpecStructure(invalid_spec);
    assert(result == false);
}

test "spec structure - empty lines and comments" {
    const spec_with_comments = "name: test_spec\n# This is a comment\nversion: \"1.0.0\"\n\nlanguage: zig\nmodule: test_spec";

    const result = validateSpecStructure(spec_with_comments);
    assert(result == true);
}

test "spec structure - whitespace handling" {
    const spec_with_whitespace = "  name  :  test_spec  \nversion:\"1.0.0\"\n  language:zig\nmodule:test_spec";

    const result = validateSpecStructure(spec_with_whitespace);
    assert(result == true);
}

test "spec structure - boundary test - extra whitespace" {
    const spec_extra_whitespace = "\t\tname\t\t:\t\t\"test_spec\"\t\t\n\t\t\t\tversion\t\t:\t\t\"1.0.0\"\t\t\n\t\tlanguage\t\t:\t\tzig\t\t\n\t\tmodule\t\t:\t\ttest_spec\t\t";

    const result = validateSpecStructure(spec_extra_whitespace);
    assert(result == true);
}

test "spec structure - boundary test - mixed line endings" {
    const spec_mixed_endings = "name: test_spec\r\nversion: \"1.0.0\"\nlanguage: zig\r\nmodule: test_spec";

    const result = validateSpecStructure(spec_mixed_endings);
    assert(result == true);
}

test "spec structure - boundary test - multiple colons" {
    const spec_multiple_colons = "name: test:spec\nversion: \"1.0.0\"\nlanguage: zig\nmodule: test_spec";

    const result = validateSpecStructure(spec_multiple_colons);
    assert(result == true);
}

test "spec structure - negative control - damaged result" {
    const damaged_spec = "name: test_spec\nversion: \"1.0.0\"\nlanguage: zig\nmodule: test_spec\nextra: damaged_field";

    const result = validateSpecStructure(damaged_spec);
    assert(result == false);
}

test "phi constant - bounded sqrt" {
    const phi: f64 = (1.0 + boundedSqrt(5.0)) / 2.0;
    const result = phi * phi + 1.0 / (phi * phi);
    assert(approxEqualAbs(3.0, result, 0.0001));
}

test "phi constant - boundary test - small values" {
    const small_phi: f64 = (1.0 + boundedSqrt(5.0)) / 2.0;
    const small_result = small_phi * small_phi + 1.0 / (small_phi * small_phi);
    assert(approxEqualAbs(3.0, small_result, 0.001));
}

test "phi constant - boundary test - tolerance check" {
    const phi: f64 = (1.0 + boundedSqrt(5.0)) / 2.0;
    const result = phi * phi + 1.0 / (phi * phi);
    assert(approxEqualAbs(3.0, result, 0.00001));
}