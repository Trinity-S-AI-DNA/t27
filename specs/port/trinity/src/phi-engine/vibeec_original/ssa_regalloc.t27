module specs.port.trinity.src.phi_engine.vibeec_original.ssa_regalloc;

pub const PHI: f64 = 1.618033988749895;
pub const GOLDEN_IDENTITY: f64 = 3.0;

pub const NUM_REGS: usize = 16;

pub const LiveRange = struct {
    vreg: u32,
    start: u32,
    end: u32,
    assigned_reg: ?u8 = null,
    spill_slot: ?u16 = null,
    weight: f32 = 1.0,

    pub fn LiveRange_overlaps(self: LiveRange, other: LiveRange) bool {
        return self.start < other.end and other.start < self.end;
    }

    pub fn LiveRange_length(self: LiveRange) u32 {
        return self.end - self.start;
    }
};

pub const SSARegAlloc = struct {
    ranges: []LiveRange,
    reg_state: [NUM_REGS]?u32,
    spill_count: u16 = 0,
    allocated: u64 = 0,
    spilled: u64 = 0,
}

pub fn SSARegAlloc_init() SSARegAlloc {
    var ra: SSARegAlloc = undefined;
    ra.ranges = undefined;
    ra.reg_state = undefined;
    ra.spill_count = 0;
    ra.stats.allocated = 0;
    ra.stats.spilled = 0;
    return ra;
}

pub fn SSARegAlloc_deinit(self: *SSARegAlloc) void {
    return;
}

pub fn SSARegAlloc_addRange(self: *SSARegAlloc, vreg: u32, start: u32, end: u32) void {
    _ = self;
    _ = vreg;
    _ = start;
    _ = end;
    return;
}

pub fn SSARegAlloc_allocate(self: *SSARegAlloc) void {
    // Sort by start position
    for (self.ranges) |*range| {
        var found: ?u8 = null;
        for (0..NUM_REGS) |r| {
            if (self.reg_state[r] == null) {
                found = @intCast(r);
                break;
            }
        }

        if (found) |reg| {
            range.assigned_reg = reg;
            self.reg_state[reg] = range.vreg;
            self.allocated += 1;
        } else {
            // Spill
            range.spill_slot = self.spill_count;
            self.spill_count += 1;
            self.spilled += 1;
        }
    }
}

pub fn SSARegAlloc_expireOld(self: *SSARegAlloc, pos: u32) void {
    for (self.ranges) |range| {
        if (range.end <= pos) {
            if (range.assigned_reg) |reg| {
                self.reg_state[reg] = null;
            }
        }
    }
}

test "LiveRange overlap" {
    const a = LiveRange{ .vreg = 0, .start = 0, .end = 10 };
    const b = LiveRange{ .vreg = 1, .start = 5, .end = 15 };
    const c = LiveRange{ .vreg = 2, .start = 10, .end = 20 };

    assert(LiveRange_overlaps(a, b));
    assert(!LiveRange_overlaps(a, c));
}

test "LiveRange length" {
    const range = LiveRange{ .vreg = 0, .start = 5, .end = 15 };
    assert(LiveRange_length(range) == 10);
}

test "SSARegAlloc init" {
    const ra = SSARegAlloc_init();
    assert(ra.reg_state[0] == null);
    assert(ra.reg_state[NUM_REGS - 1] == null);
}

test "SSARegAlloc addRange" {
    var ra = SSARegAlloc_init();
    ra.addRange(0, 0, 10);
    ra.addRange(1, 5, 15);
}

test "SSARegAlloc allocate" {
    var ra = SSARegAlloc_init();
    ra.addRange(0, 0, 10);
    ra.addRange(1, 5, 15);
    ra.allocate();
    assert(ra.stats.allocated > 0);
}

test "SSARegAlloc expireOld" {
    var ra = SSARegAlloc_init();
    ra.addRange(0, 0, 10);
    ra.addRange(1, 5, 15);
    ra.allocate();
    ra.expireOld(8);
}

test "golden identity" {
    const phi_sq = PHI * PHI;
    assert(phi_sq + 1.0 / phi_sq == GOLDEN_IDENTITY);
}