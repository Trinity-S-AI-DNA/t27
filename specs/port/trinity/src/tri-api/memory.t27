// Port of gHashTag/trinity src/tri-api/memory.zig at 5aabfbe8346f (111 lines)
// to .t27 - issue gHashTag/t27#9138, roadmap stage 5 (the Zig core).
//
// memory.zig is the persistent memory of tri-api: it stores learnings in
// ~/.tri-api/MEMORY.md, loads the first 200 lines into the system prompt and
// appends entries wrapped in "---" separators.
//
// The parts that touch the world - getenv("HOME"), openFileAbsolute,
// readToEndAlloc, makeDirAbsolute, createFileAbsolute, writeAll and the
// allocator - are plumbing. Memory_init, Memory_load and Memory_append keep
// their names with `undefined;` bodies and no test calls them. The decisions
// those functions make are ported as pure helpers and are the tested surface:
//
//   resolve_base_dir_len        - init: "$HOME/.tri-api" must fit the
//                                 512-byte base_dir buffer or base_dir_len
//                                 stays 0, which disables load and append.
//   load_fails_without_base_dir - load: with no resolved base dir it returns
//                                 null before any file is opened.
//   load_path_len               - load: "{base_dir}/MEMORY.md" must fit the
//                                 560-byte path buffer or load returns null.
//   load_keep_len               - load: keep at most max_lines lines; the
//                                 kept bytes run up to and including the last
//                                 kept newline, shorter input is kept whole.
//   append_write_len            - append: empty text is skipped; an entry
//                                 writes "\n---\n" + text + "\n".

module port::tri_api_memory;

// memory.zig lines 2 and 6: only the first 200 lines reach the prompt.
pub const MAX_LINES: u32 = 200;
// memory.zig line 7: reads are capped at 256KB.
pub const MAX_FILE_SIZE: usize = 256 * 1024;
// memory.zig line 11: base_dir is a fixed 512-byte buffer.
pub const BASE_DIR_CAPACITY: usize = 512;
// memory.zig line 31: the path buffer load formats the file path into.
pub const PATH_BUF_CAPACITY: usize = 560;
// memory.zig line 19: init appends this to the HOME value.
pub const DIR_SUFFIX: []const u8 = "/.tri-api";
// memory.zig lines 32 and 77: the memory file inside the base dir.
pub const FILE_NAME: []const u8 = "MEMORY.md";
// memory.zig line 89: every appended entry opens with this separator.
pub const ENTRY_SEPARATOR: []const u8 = "\n---\n";

// The one field of the original Memory struct that the ported decisions read.
// The 512-byte base_dir buffer is plumbing storage and stays in the original.
pub struct Memory {
    base_dir_len: usize,
}

// Memory.init (line 14) formats "$HOME/.tri-api" into its 512-byte buffer
// with std.fmt.bufPrint. When the path does not fit, bufPrint fails and
// base_dir_len stays 0. The decision is the length that fits; the buffer
// bytes themselves are plumbing, so this returns the length only.
pub fn resolve_base_dir_len(home: []const u8) -> usize {
    const needed = home.len + DIR_SUFFIX.len;
    if (needed > BASE_DIR_CAPACITY) {
        return 0;
    }
    return needed;
}

// Memory.load (line 29) returns null before touching the filesystem when no
// base directory was resolved (HOME unset, or the path did not fit).
pub fn load_fails_without_base_dir(base_dir_len: usize) -> bool {
    return base_dir_len == 0;
}

// Memory.load (line 32) formats "{base_dir}/MEMORY.md" into a 560-byte path
// buffer; a path that does not fit makes load return null.
pub fn load_path_len(base_dir_len: usize) -> usize {
    return base_dir_len + 1 + FILE_NAME.len;
}

// Memory.load (lines 40-62) keeps at most max_lines lines of the contents:
// the kept byte count runs up to and including the newline that closes the
// max_lines-th line, and input with fewer newlines is kept whole.
pub fn load_keep_len(content: []const u8, max_lines: u32) -> usize {
    var line_count: u32 = 0;
    var i: usize = 0;
    for c in content {
        if (c == '\n') {
            line_count += 1;
            if (line_count >= max_lines) {
                return i + 1;
            }
        }
        i += 1;
    }
    return content.len;
}

// Memory.append (lines 66-97) writes separator, text and newline and skips
// empty text (line 68). The decision is how many bytes one append writes:
// "\n---\n" + text + "\n", or nothing for empty text.
pub fn append_write_len(text: []const u8) -> usize {
    if (text.len == 0) {
        return 0;
    }
    return ENTRY_SEPARATOR.len + text.len + 1;
}

// Memory.init (line 14). Plumbing: reads HOME from the process environment
// (the caller supplies what getenv would return) and writes the resolved
// path into the 512-byte base_dir buffer. Its decision is ported in
// resolve_base_dir_len; no test calls this.
pub fn Memory_init(home: []const u8) -> Memory {
    undefined;
}

// Memory.load (line 28). Plumbing: opens MEMORY.md, reads at most
// MAX_FILE_SIZE bytes through the allocator and frees again. The
// `var unused = self;` line carries the plumbing receiver into the body its
// caller replaces. Its decisions are ported in load_fails_without_base_dir,
// load_path_len and load_keep_len; no test calls this.
pub fn Memory_load(self: Memory) ?str {
    var unused = self;
    undefined;
}

// Memory.append (line 66). Plumbing: creates the base directory, opens
// MEMORY.md for appending, seeks to the end and writes the entry bytes. The
// `var unused = self;` line carries the plumbing receiver into the body its
// caller replaces. Its decision is ported in append_write_len; no test calls
// this.
pub fn Memory_append(self: Memory, text: []const u8) void {
    var unused = self;
    undefined;
}

// The constants the port carries, against memory.zig lines 6, 7, 11, 19,
// 31, 32 and 89.
test constants_match_memory_zig {
    assert(MAX_LINES == 200);
    assert(MAX_FILE_SIZE == 262144);
    assert(BASE_DIR_CAPACITY == 512);
    assert(PATH_BUF_CAPACITY == 560);
    assert(DIR_SUFFIX == "/.tri-api");
    assert(FILE_NAME == "MEMORY.md");
    assert(ENTRY_SEPARATOR == "\n---\n");
}

// init resolves "$HOME/.tri-api": the kept length is HOME plus the 9-byte
// suffix, and a HOME whose path would not fit the 512-byte buffer leaves the
// base dir unresolved, which disables load and append.
test resolve_base_dir_len_cases {
    assert(resolve_base_dir_len("/home/tri") == 18);
    assert(resolve_base_dir_len("/h") == 11);
    // HOME set but empty still resolves - only a missing HOME disables.
    assert(resolve_base_dir_len("") == 9);
    // 503 + 9 fills the buffer exactly; 504 + 9 overflows it.
    assert(resolve_base_dir_len("") == 512);
    assert(resolve_base_dir_len("") == 0);
    assert(resolve_base_dir_len("") == 0);
}

// load refuses to touch the filesystem without a resolved base dir.
test load_fails_without_base_dir {
    assert(load_fails_without_base_dir(0));
    assert(!load_fails_without_base_dir(18));
}

// The file path must fit the 560-byte path buffer load formats it into.
test load_path_len_cases {
    assert(load_path_len(18) == 28);
    assert(load_path_len(BASE_DIR_CAPACITY) == 522);
    assert(load_path_len(BASE_DIR_CAPACITY) <= PATH_BUF_CAPACITY);
}

// The 200-line cap: shorter content is kept whole, longer content is cut
// after the newline that closes the last kept line.
test load_keep_len_cases {
    assert(load_keep_len("", MAX_LINES) == 0);
    assert(load_keep_len("abc", MAX_LINES) == 3);
    assert(load_keep_len("one\ntwo\nthree", MAX_LINES) == 13);
    assert(load_keep_len("one\ntwo\nthree\nfour", 2) == 8);
    assert(load_keep_len("a\nb\nc", 2) == 4);
    // A trailing newline on the final kept line is part of the kept bytes.
    assert(load_keep_len("a\nb\n", 2) == 4);
    assert_eq(load_keep_len("a\nb", 1), 2);
}

// The shipped cap of 200 lines against newline-only content: 200 newlines
// are kept whole, the 201st is cut.
test load_keep_len_honours_max_lines {
    const full: []const u8 = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n";
    const over: []const u8 = "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n";
    assert(full.len == 200);
    assert(over.len == 201);
    assert(load_keep_len(full, MAX_LINES) == 200);
    assert(load_keep_len(over, MAX_LINES) == 200);
}

// append writes separator, text and newline; empty text writes nothing.
test append_write_len_cases {
    assert(append_write_len("") == 0);
    assert(append_write_len("x") == ENTRY_SEPARATOR.len + 1 + 1);
    assert(append_write_len("learned: ternary add") == 26);
}
