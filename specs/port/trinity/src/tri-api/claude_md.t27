module port::trinity::src::tri-api::claude_md;

const max_file_size = 256 * 1024; // 256KB per CLAUDE.md

// File and environment I/O is handled externally. This module decides the
// load order, the path resolution and the append logic: the caller reads the
// files and hands their contents in. There is no allocator in t27, so the
// merged prompt lives in a fixed static buffer.

/// Capacity of the merged system prompt
pub const PROMPT_CAP : usize = 8192;

/// Length of the separator written between parts: "\n\n---\n\n"
pub const SEPARATOR_LEN : usize = 7;

/// Number of CLAUDE.md locations tried, in order
pub const LOAD_ORDER_COUNT : usize = 3;

/// Capacity of the resolved path buffer
pub const PATH_CAP : usize = 512;

/// The merged system prompt
var PROMPT : [PROMPT_CAP]u8 = undefined;

/// Bytes of PROMPT in use
var PROMPT_LEN : usize = 0;

/// Resolved path
var RESOLVED : [PATH_CAP]u8 = undefined;

/// Byte i of the separator "\n\n---\n\n"
fn separatorByte(i: usize) u8 {
    if (i == 0 or i == 1 or i == 5 or i == 6) {
        return 10;
    }
    return 45;
}

/// Start a new, empty prompt.
pub fn promptReset() void {
    PROMPT_LEN = 0;
}

/// The CLAUDE.md location tried at position `index`, or null past the end.
/// Order of precedence: global, project, project-local.
pub fn loadOrderPath(index: usize) ?[]const u8 {
    if (index == 0) {
        return "~/.claude/CLAUDE.md";
    }
    if (index == 1) {
        return "./CLAUDE.md";
    }
    if (index == 2) {
        return "./.claude/CLAUDE.md";
    }
    return null;
}

/// True when a file of `size` bytes is within the per-file limit.
pub fn withinFileLimit(size: usize) bool {
    return size <= max_file_size;
}

/// Load and merge CLAUDE.md files into a system prompt.
/// Returns the concatenated content with --- separators, or null if nothing
/// was appended. The result lives in static storage.
pub fn loadSystemPrompt() ?[]const u8 {
    if (PROMPT_LEN == 0) {
        return null;
    }
    return PROMPT[0..PROMPT_LEN];
}

/// Append a memory file to the system prompt parts.
/// Empty content is skipped; a separator goes before non-empty content when
/// the prompt already has parts. Returns true when the content was appended
/// (false when skipped or when it would not fit).
pub fn appendMemory(memory_content: []const u8) bool {
    if (memory_content.len == 0) {
        return false;
    }
    var need : usize = memory_content.len;
    if (PROMPT_LEN > 0) {
        need = need + SEPARATOR_LEN;
    }
    if (PROMPT_LEN + need > PROMPT_CAP) {
        return false;
    }
    if (PROMPT_LEN > 0) {
        var s : usize = 0;
        while (s < SEPARATOR_LEN) {
            PROMPT[PROMPT_LEN + s] = separatorByte(s);
            s = s + 1;
        }
        PROMPT_LEN = PROMPT_LEN + SEPARATOR_LEN;
    }
    var i : usize = 0;
    while (i < memory_content.len) {
        PROMPT[PROMPT_LEN + i] = memory_content[i];
        i = i + 1;
    }
    PROMPT_LEN = PROMPT_LEN + memory_content.len;
    return true;
}

/// Append the content of a file that was read externally; null means the file
/// could not be read and is skipped.
pub fn appendFile(content: ?[]const u8) bool {
    if (content == null) {
        return false;
    }
    return appendMemory(content.?);
}

/// True when the path starts at the root.
pub fn isAbsolutePath(path: []const u8) bool {
    return path.len > 0 and path[0] == 47;
}

/// Resolve a path for reading: absolute paths are used as they are, relative
/// paths are joined onto `cwd`. Null for an empty path or one that is too long.
pub fn resolvePath(path: []const u8, cwd: []const u8) ?[]const u8 {
    if (path.len == 0) {
        return null;
    }
    if (isAbsolutePath(path) or cwd.len == 0) {
        return path;
    }
    var n : usize = 0;
    var i : usize = 0;
    var slash : usize = 1;
    if (cwd[cwd.len - 1] == 47) {
        slash = 0;
    }
    if (cwd.len + slash + path.len > PATH_CAP) {
        return null;
    }
    while (i < cwd.len) {
        RESOLVED[n] = cwd[i];
        n = n + 1;
        i = i + 1;
    }
    if (slash == 1) {
        RESOLVED[n] = 47;
        n = n + 1;
    }
    i = 0;
    while (i < path.len) {
        RESOLVED[n] = path[i];
        n = n + 1;
        i = i + 1;
    }
    return RESOLVED[0..n];
}

// ─── Tests ─────────────────────────────────────────────────────────────────────

test "loadSystemPrompt decision logic - load order priority" {
    // Files are tried in a fixed order of precedence:
    // 1. Global: ~/.claude/CLAUDE.md
    // 2. Project: ./CLAUDE.md
    // 3. Project-local: ./.claude/CLAUDE.md
    assert(std.mem.eql(u8, loadOrderPath(0).?, "~/.claude/CLAUDE.md"));
    assert(std.mem.eql(u8, loadOrderPath(1).?, "./CLAUDE.md"));
    assert(std.mem.eql(u8, loadOrderPath(2).?, "./.claude/CLAUDE.md"));
    assert(loadOrderPath(LOAD_ORDER_COUNT) == null);

    // Parts appended in that order come out in that order.
    promptReset();
    assert(appendMemory("global"));
    assert(appendMemory("project"));
    assert(appendMemory("local"));
    const merged = loadSystemPrompt().?;
    assert(merged.len == 6 + 7 + 7 + 7 + 5);
    assert(std.mem.eql(u8, merged[0..6], "global"));
    assert(std.mem.eql(u8, merged[13..20], "project"));
    assert(std.mem.eql(u8, merged[27..32], "local"));
}

test "loadSystemPrompt returns null when no files found" {
    promptReset();
    assert(loadSystemPrompt() == null);
    // Nothing usable was appended either: still null.
    assert(!appendMemory(""));
    assert(!appendFile(null));
    assert(loadSystemPrompt() == null);
}

test "appendMemory decision logic - handles empty content" {
    promptReset();
    assert(!appendMemory(""));
    assert(PROMPT_LEN == 0);
    assert(appendMemory("one"));
    const before = PROMPT_LEN;
    assert(!appendMemory(""));
    assert(PROMPT_LEN == before);
    assert(std.mem.eql(u8, loadSystemPrompt().?, "one"));
}

test "appendMemory decision logic - adds separator for non-empty content" {
    promptReset();
    assert(appendMemory("first"));
    // No separator before the first part.
    assert(PROMPT_LEN == 5);
    assert(appendMemory("second"));
    const merged = loadSystemPrompt().?;
    assert(merged.len == 5 + SEPARATOR_LEN + 6);
    // Separator: newline newline dash dash dash newline newline.
    assert(merged[5] == 10);
    assert(merged[6] == 10);
    assert(merged[7] == 45);
    assert(merged[8] == 45);
    assert(merged[9] == 45);
    assert(merged[10] == 10);
    assert(merged[11] == 10);
    assert(std.mem.eql(u8, merged[12..18], "second"));
}

test "appendFile decision logic - appends separator between multiple files" {
    promptReset();
    assert(appendFile("a"));
    assert(appendFile("b"));
    assert(!appendFile(null));
    const merged = loadSystemPrompt().?;
    assert(merged.len == 1 + SEPARATOR_LEN + 1);
    assert(merged[0] == 97);
    assert(merged[1] == 10);
    assert(merged[2] == 10);
    assert(merged[3] == 45);
    assert(merged[8] == 98);
}

test "appendMemory refuses content that does not fit" {
    promptReset();
    var big : [PROMPT_CAP]u8 = undefined;
    var i : usize = 0;
    while (i < PROMPT_CAP) {
        big[i] = 120;
        i = i + 1;
    }
    assert(appendMemory(&big));
    assert(PROMPT_LEN == PROMPT_CAP);
    assert(!appendMemory("x"));
    assert(PROMPT_LEN == PROMPT_CAP);
}

test "file size limit is 256KB" {
    assert(withinFileLimit(0));
    assert(withinFileLimit(256 * 1024));
    assert(!withinFileLimit(256 * 1024 + 1));
}

test "readFile decision logic - absolute vs relative path resolution" {
    const absolute_path = "/absolute/path/CLAUDE.md";
    const relative_path = "relative/path/CLAUDE.md";

    // Absolute path detection
    assert(isAbsolutePath(absolute_path));

    // Relative path detection
    assert(!isAbsolutePath(relative_path));
    assert(!isAbsolutePath(""));

    // Absolute paths are used as they are; relative ones go under the cwd.
    assert(std.mem.eql(u8, resolvePath(absolute_path, "/work").?, "/absolute/path/CLAUDE.md"));
    assert(std.mem.eql(u8, resolvePath(relative_path, "/work").?, "/work/relative/path/CLAUDE.md"));
    assert(std.mem.eql(u8, resolvePath(relative_path, "/work/").?, "/work/relative/path/CLAUDE.md"));
    assert(resolvePath("", "/work") == null);
}
