module port::trinity::src::background_agent::config;

/// Configuration for background-agent API
pub const Config = struct {
    // Railway's proxy reaches a container over IPv6, so a listener bound to
    // 0.0.0.0 is invisible to it: the process runs, the port is open, and every
    // request comes back 502. "::" accepts both families.
    host: []const u8 = "::",
    port: u16 = 3000,
    railwayApiToken: []const u8 = "",
    railwayProjectId: []const u8 = "",
    authSecret: []const u8 = "",
    databaseUrl: []const u8 = "",
    localMode: bool = false,
};

/// Get environment variable with error handling
fn getEnv(allocator: Allocator, key: []const u8) ![]const u8 {
    // Port the decision, not the plumbing - environment access is external
    undefined;
}

/// Get environment variable with default value
fn getEnvOr(allocator: Allocator, key: []const u8, default_value: []const u8) ![]const u8 {
    // Port the decision, not the plumbing - environment access is external
    undefined;
}

/// Validate configuration at runtime
pub fn validateConfig(config: *const Config) !void {
    if (config.databaseUrl.len == 0) {
        return error.MissingEnv;
    }
    // API token and auth secret are optional for Railway health checks
    // but will be validated when used
}

/// Load configuration from environment variables
pub fn loadConfig(allocator: Allocator) !Config {
    const port_str = try getEnvOr(allocator, "PORT", "3000");
    const port = try std.fmt.parseInt(u16, port_str, 10);

    // Handle optional environment variables with error handling
    const railwayApiToken = getEnvOr(allocator, "RAILWAY_API_TOKEN", "") catch "";
    const railwayProjectId = try getEnvOr(allocator, "RAILWAY_PROJECT_ID", "");
    const authSecret = getEnvOr(allocator, "AUTH_SECRET", "") catch "";

    var config = Config{
        .port = port,
        .railwayApiToken = railwayApiToken,
        .railwayProjectId = railwayProjectId,
        .authSecret = authSecret,
        .databaseUrl = try getEnv(allocator, "DATABASE_URL"),
        .localMode = try isLocalMode(allocator),
    };

    try validateConfig(&config);
    return config;
}

/// Check if running in local mode
fn isLocalMode(allocator: Allocator) !bool {
    const local = try getEnvOr(allocator, "LOCAL_MODE", "false");
    if (std.mem.eql(u8, local, "true") or std.mem.eql(u8, local, "1")) {
        return true;
    }
    return false;
}

pub const Error = error{
    MissingEnv,
    InvalidPort,
};

test "config: load defaults" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("PORT", "8080");
    try env.put("RAILWAY_API_TOKEN", "test_token");
    try env.put("RAILWAY_PROJECT_ID", "proj_123");
    try env.put("AUTH_SECRET", "secret123");
    try env.put("DATABASE_URL", "postgres://localhost/test");
    try env.put("LOCAL_MODE", "false");

    const config = try loadConfig(allocator);
    assert(config.port == 8080);
    assert(config.railwayApiToken == "test_token");
    assert(config.railwayProjectId == "proj_123");
    assert(config.authSecret == "secret123");
    assert(config.databaseUrl == "postgres://localhost/test");
    assert(config.localMode == false);
}

test "config: optional api token and auth secret" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("PORT", "3000");
    try env.put("RAILWAY_PROJECT_ID", "proj_optional");
    try env.put("DATABASE_URL", "postgres://localhost/test");
    try env.put("LOCAL_MODE", "false");
    // RAILWAY_API_TOKEN and AUTH_SECRET are now optional

    const config = try loadConfig(allocator);
    assert(config.port == 3000);
    assert(config.railwayApiToken == "");
    assert(config.authSecret == "");
    assert(config.railwayProjectId == "proj_optional");
}

test "config: missing database url" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("PORT", "3000");
    try env.put("RAILWAY_PROJECT_ID", "proj_test");
    // DATABASE_URL is still required

    try assertError(error.MissingEnv, loadConfig(allocator));
}

test "getEnvOr: returns value when present" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("TEST_VAR", "test_value");
    const result = try getEnvOr(allocator, "TEST_VAR", "default");
    assert(result == "test_value");
}

test "getEnvOr: returns default when missing" {
    const allocator = std.testing.allocator;
    const result = try getEnvOr(allocator, "MISSING_VAR", "default_value");
    assert(result == "default_value");
}

test "isLocalMode: true for 'true'" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("LOCAL_MODE", "true");
    const result = try isLocalMode(allocator);
    assert(result == true);
}

test "isLocalMode: true for '1'" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("LOCAL_MODE", "1");
    const result = try isLocalMode(allocator);
    assert(result == true);
}

test "isLocalMode: false for other values" {
    const allocator = std.testing.allocator;
    var env = std.process.EnvMap.init(allocator);
    defer env.deinit();

    try env.put("LOCAL_MODE", "false");
    const result = try isLocalMode(allocator);
    assert(result == false);
}

fn assertError(expected_error: anytype, actual: anytype) !void {
    if (actual) |_| {
        return error.UnexpectedSuccess;
    } else |err| {
        if (err == expected_error) {
            return;
        } else {
            return error.WrongError;
        }
    }
}