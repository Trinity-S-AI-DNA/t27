module port::trinity::src::kaggle::kaggle;

// Port of trinity src/kaggle/kaggle.zig @ 5aabfbe8346f (98 lines).
//
// The original declares the Kaggle struct with two methods:
//   - init(allocator), line 32: stores the allocator in a fresh Kaggle.
//   - exportModules(self, output_dir), line 39: creates <output_dir>,
//     derives <output_dir>/kaggle, <output_dir>/src and
//     <output_dir>/src/kaggle/zig, then copies five submodule files from
//     the checkout's src/kaggle/ directory into <output_dir>/src/kaggle/,
//     printing one line per file and a summary at the end.
//
// exportModules is filesystem plumbing end to end (makePath, allocPrint,
// copyFile, debug.print). Per the "port the decision, not the plumbing"
// contract, the decisions inside it are ported below as pure helpers and
// tested; the plumbing itself is Kaggle_exportModules with an `undefined;`
// body that no test calls. .t27 has no error unions, so the `!void` result
// is represented by the makePathVerdict helper's exit code instead.

// Exit verdict for the whole export (stands in for the original's !void
// error propagation).
const EXIT_OK: i32 = 0;
const EXIT_FAIL: i32 = 1;

// Original lines 58-64: the copy list is exactly these five submodule
// files, in this order. (The original imports clutrr.zig but does NOT
// copy it.)
const KAGGLE_FILES: [5][]const u8 = ["csv_parser.zig", "mc_generator.zig", "matcher.zig", "evaluator.zig", "export.zig"];

// Original: pub const Kaggle = struct { allocator: std.mem.Allocator }.
// An allocator is plumbing; it is represented here as an opaque handle
// string the caller passes in ("test_allocator" in tests), matching the
// SkipList_init convention in gen_skiplist_impl.t27.
pub struct Kaggle {
    allocator: str,
}

// Original line 32: pub fn init(allocator: std.mem.Allocator) Kaggle
pub fn Kaggle_init(allocator: str) -> Kaggle {
    return Kaggle { allocator: allocator };
}

// Original line 39: pub fn exportModules(self: *Kaggle, output_dir: []const u8) !void
// The original parameter named `self` is called `kaggle` here: the t27
// generator silently drops discard statements for a parameter named `self`,
// which would leave the generated Zig with an unused parameter.
// Filesystem plumbing only - makePath, copyFile, debug.print - with no
// .t27-representable body. The decisions it makes live in the pure helpers
// below; no test calls this.
pub fn Kaggle_exportModules(kaggle: Kaggle, output_dir: []const u8) -> void {
    _ = kaggle;
    _ = output_dir;
    undefined;
}

// ---- The decisions inside exportModules, as pure helpers ----

// Original lines 43/47/52: each path is derived by appending a fixed
// suffix to a base: exports_dir = output_dir + "/kaggle",
// src_path = output_dir + "/src", module_path = src_path + "/kaggle/zig".
// .t27 has no string concatenation, so the ported decision is WHICH
// suffix is appended to WHICH base; the plumbing joins them.
pub fn Kaggle_exportModules_exportsDirSuffix() -> []const u8 {
    return "/kaggle";
}

pub fn Kaggle_exportModules_srcDirSuffix() -> []const u8 {
    return "/src";
}

// Appended to src_path (itself output_dir + "/src").
pub fn Kaggle_exportModules_moduleDirSuffix() -> []const u8 {
    return "/kaggle/zig";
}

// Original line 67: each file is copied FROM "{s}/src/kaggle/{s}" - the
// source is always the checkout's own src/kaggle, never output_dir.
pub fn Kaggle_exportModules_sourceDir() -> []const u8 {
    return "src/kaggle";
}

// Original lines 58-64: file i of the fixed copy list; "" past the end.
pub fn Kaggle_exportModules_fileAt(i: usize) -> []const u8 {
    if (i >= 5) {
        return "";
    }
    return KAGGLE_FILES[i];
}

pub fn Kaggle_exportModules_fileCount() -> usize {
    return 5;
}

// Original line 41: `try std.fs.cwd().makePath(output_dir)` - a failure to
// create the output directory aborts the whole export (the error is
// propagated to the caller). The plumbing calls this with what makePath
// reported and stops on EXIT_FAIL.
pub fn Kaggle_exportModules_makePathVerdict(created: bool) -> i32 {
    if (!created) {
        return EXIT_FAIL;
    }
    return EXIT_OK;
}

// Original lines 71-80: the per-file loop is best-effort. A failure to
// open the destination directory or to copy one file is printed and then
// `continue`d - the remaining files are still attempted and the loop
// never aborts. outcomes[i] records what the plumbing observed for
// files[i]: true = copied, false = failed and skipped.
pub fn Kaggle_exportModules_countCopied(outcomes: []bool) -> usize {
    var n: usize = 0;
    for copied in outcomes {
        if (copied) {
            n += 1;
        }
    }
    return n;
}

// Original line 84: the summary prints `files.len` - the number of files
// ATTEMPTED - not the number that actually copied. A run that copied only
// three of the five still reports five.
pub fn Kaggle_exportModules_reportedCount() -> usize {
    return Kaggle_exportModules_fileCount();
}

// ---- tests ----

test "Kaggle_init stores the allocator" {
    var k = Kaggle_init("test_allocator");
    assert(k.allocator == "test_allocator");
    var other = Kaggle_init("page_allocator");
    assert(other.allocator == "page_allocator");
}

test "export file list is the five submodule files in order" {
    assert(Kaggle_exportModules_fileCount() == 5);
    assert(Kaggle_exportModules_fileAt(0) == "csv_parser.zig");
    assert(Kaggle_exportModules_fileAt(1) == "mc_generator.zig");
    assert(Kaggle_exportModules_fileAt(2) == "matcher.zig");
    assert(Kaggle_exportModules_fileAt(3) == "evaluator.zig");
    assert(Kaggle_exportModules_fileAt(4) == "export.zig");
}

test "export file list returns empty past the end" {
    assert(Kaggle_exportModules_fileAt(5) == "");
    assert(Kaggle_exportModules_fileAt(999) == "");
}

test "export path layout appends the fixed suffixes" {
    assert(Kaggle_exportModules_exportsDirSuffix() == "/kaggle");
    assert(Kaggle_exportModules_srcDirSuffix() == "/src");
    assert(Kaggle_exportModules_moduleDirSuffix() == "/kaggle/zig");
    assert(Kaggle_exportModules_sourceDir() == "src/kaggle");
}

test "export makePath failure aborts the whole export" {
    assert(Kaggle_exportModules_makePathVerdict(true) == EXIT_OK);
    assert(Kaggle_exportModules_makePathVerdict(false) == EXIT_FAIL);
}

test "export copy is best-effort per file" {
    var all: [5]bool = [true, true, true, true, true];
    assert(Kaggle_exportModules_countCopied(&all) == 5);
    var mixed: [5]bool = [true, false, true, false, true];
    assert(Kaggle_exportModules_countCopied(&mixed) == 3);
    var none: [2]bool = [false, false];
    assert(Kaggle_exportModules_countCopied(&none) == 0);
}

test "export summary counts attempts, not successes" {
    var mixed: [5]bool = [true, false, true, false, true];
    assert(Kaggle_exportModules_countCopied(&mixed) == 3);
    assert(Kaggle_exportModules_reportedCount() == 5);
}
