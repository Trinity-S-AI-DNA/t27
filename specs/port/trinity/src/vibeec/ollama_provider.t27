// ollama_provider.t27 — THE PROFANE SPIRIT (ported from src/vibeec/ollama_provider.zig)
// Summons the external Ollama LLM to generate Zig code. The provider shells
// out to the `ollama` CLI: simple, no HTTP client, no JSON.
//
// Ported from gHashTag/trinity src/vibeec/ollama_provider.zig (104 lines, 4
// functions). The decisions live here as pure, tested functions; the process,
// allocator and printing plumbing keeps its original name with an `undefined;`
// body (FR-001) and is never called from a test.
//
// Decisions ported and tested:
//   OllamaProvider_init  default model "qwen2.5-coder:7b"               (line 15)
//   build_argv           the exact child argv shape                     (line 64)
//   process_exit_ok      only a normal exit with status 0 is success; every
//                        other termination is the failure the original
//                        surfaces as error.OllamaFailed                 (44-50)
//   plan_zig_prompt      the assembled prompt: system instruction, optional
//                        corrections block, user request, footer        (58-77)
//   DEMO_PROMPT          main feeds "print hello world", no penance     (line 96)
//
// Named missing piece: joining the prompt segments into ONE buffer is string
// concatenation, which .t27 cannot express (J0225). The plan carries the
// ordered segments instead; the join, the spawn, the stdout/dupe and the
// printing belong to the bodies left as `undefined;`.

module port::trinity::src::vibeec::ollama_provider;

// Original struct fields: allocator (Zig memory plumbing, no decision —
// dropped) and model (the decision — kept).
pub struct OllamaProvider {
    model: str,
}

// Original line 64: argv = [_][]const u8{ "ollama", "run", self.model, prompt }.
// Fixed-capacity, the shape for a list that never grows.
pub struct OllamaArgv {
    items: [4]str,
    len: usize,
}

// Original lines 44-50: the switch on child.term. Only .Exited(0) is success;
// .Exited(n != 0) and every other termination are error.OllamaFailed. .t27
// has no tagged unions, so the two facts the switch reads become fields.
pub struct ProcTerm {
    exited_cleanly: bool,
    code: i32,
}

// Original lines 58-77 build one prompt string. .t27 cannot concatenate
// strings, so the assembly decision is the ordered segments.
pub struct ZigPromptPlan {
    parts: [8]str,
    len: usize,
}

// Original line 15: .model = "qwen2.5-coder:7b".
const DEFAULT_MODEL: str = "qwen2.5-coder:7b";

// Original lines 60-63, joined.
const SYSTEM_INSTRUCTION: str = "You are a Zig code generator. Generate ONLY valid Zig code, no explanations.\nAlways include: const std = @import(\"std\"); and pub fn main() void { ... }\nUse meaningful variable names.\n\n";

// Original line 96: generateZigCode("print hello world", null).
const DEMO_PROMPT: str = "print hello world";

// Original line 13: pub fn init(allocator: std.mem.Allocator) OllamaProvider.
// The allocator parameter is memory plumbing with no decision; the decision —
// the default model — is ported in full, body and all.
pub fn OllamaProvider_init() -> OllamaProvider {
    return OllamaProvider { model: DEFAULT_MODEL };
}

// Original line 64. The argv the provider runs: ollama run <model> <prompt>.
pub fn build_argv(provider: OllamaProvider, prompt: str) -> OllamaArgv {
    var argv: OllamaArgv = OllamaArgv { items: ["", "", "", ""], len: 4 };
    argv.items[0] = "ollama";
    argv.items[1] = "run";
    argv.items[2] = provider.model;
    argv.items[3] = prompt;
    return argv;
}

// Original lines 44-50: the verdict of the child process. True only for a
// normal exit with status 0 — the one path that returns stdout; every other
// path is what the original surfaces as error.OllamaFailed.
pub fn process_exit_ok(term: ProcTerm) -> bool {
    if (!term.exited_cleanly) {
        return false;
    }
    return term.code == 0;
}

// Original lines 56-79: build the prompt, then generate. The assembly:
//   [0]   system instruction
//   [1-3] only when penance is present: header, corrections, "\n\n"
//   [4-6] "Generate Zig code for: " + user prompt + the footer
// With no penance the user request and footer shift up and len is 4.
// The one-buffer join is string concatenation, not expressible in .t27
// (J0225) — the ordered segments are the ported decision.
pub fn plan_zig_prompt(user_prompt: str, penance: ?str) -> ZigPromptPlan {
    var plan: ZigPromptPlan = ZigPromptPlan {
        parts: ["", "", "", "", "", "", "", ""],
        len: 0,
    };
    plan.parts[0] = SYSTEM_INSTRUCTION;
    if (penance != null) {
        plan.parts[1] = "CORRECTIONS REQUIRED:\n";
        plan.parts[2] = penance.?;
        plan.parts[3] = "\n\n";
        plan.parts[4] = "Generate Zig code for: ";
        plan.parts[5] = user_prompt;
        plan.parts[6] = "\n\nRespond with ONLY the Zig code:";
        plan.len = 7;
    } else {
        plan.parts[1] = "Generate Zig code for: ";
        plan.parts[2] = user_prompt;
        plan.parts[3] = "\n\nRespond with ONLY the Zig code:";
        plan.len = 4;
    }
    return plan;
}

// Original line 21: pub fn generate(self: *OllamaProvider, prompt: []const u8) ![]const u8.
// Spawns the CLI (build_argv), collects stdout, waits, checks the verdict
// (process_exit_ok), dupes stdout. Every step moves bytes in or out of the
// world (FR-001); the decisions inside are ported above. Never called from a
// test. `?str` with null stands in for the original's ![]const u8 errors.
// The receiver is named `provider`, not `self`, because an unused `self`
// parameter is the one unused parameter the generator does not discard.
pub fn OllamaProvider_generate(provider: OllamaProvider, prompt: str) -> ?str {
    undefined;
}

// Original line 56: pub fn generateZigCode(self, user_prompt, penance) ![]const u8.
// Plans the prompt (decision ported above) and hands it to generate — a
// process call (FR-001). Never called from a test. Same receiver note and
// same ?str mapping as OllamaProvider_generate.
pub fn OllamaProvider_generateZigCode(provider: OllamaProvider, user_prompt: str, penance: ?str) -> ?str {
    undefined;
}

// Original line 84: pub fn main() !void — the demo harness: init the
// provider, request DEMO_PROMPT with no penance, print the response or the
// failure. Printing and the provider call are plumbing (FR-001); the request
// it makes is ported as DEMO_PROMPT and tested below. Never called from a test.
pub fn main() !void {
    undefined;
}

// ---- tests -------------------------------------------------------------

// Original line 15: init picks the qwen coder model by default.
test OllamaProvider_init_default_model {
    const p = OllamaProvider_init();
    assert(p.model == "qwen2.5-coder:7b");
}

// Original line 64: the child runs `ollama run <model> <prompt>`, argv len 4.
test build_argv_ollama_run {
    const p = OllamaProvider_init();
    const argv = build_argv(p, "print hello world");
    assert(argv.len == 4);
    assert(argv.items[0] == "ollama");
    assert(argv.items[1] == "run");
    assert(argv.items[2] == "qwen2.5-coder:7b");
    assert(argv.items[3] == "print hello world");
}

// Original line 46: .Exited with code 0 — the only success path.
test process_exit_ok_clean_zero {
    const ok = process_exit_ok(ProcTerm { exited_cleanly: true, code: 0 });
    assert(ok);
}

// Original lines 47-48: .Exited with a non-zero code — error.OllamaFailed.
test process_exit_ok_nonzero_code {
    const ok = process_exit_ok(ProcTerm { exited_cleanly: true, code: 1 });
    assert(!ok);
}

// Original lines 49-50: any non-.Exited termination — error.OllamaFailed.
test process_exit_ok_abnormal_termination {
    const ok = process_exit_ok(ProcTerm { exited_cleanly: false, code: 0 });
    assert(!ok);
}

// Original lines 58-77 with penance == null: four segments, in order.
test plan_zig_prompt_without_penance {
    const plan = plan_zig_prompt("print hello world", null);
    assert(plan.len == 4);
    assert(plan.parts[0] == "You are a Zig code generator. Generate ONLY valid Zig code, no explanations.\nAlways include: const std = @import(\"std\"); and pub fn main() void { ... }\nUse meaningful variable names.\n\n");
    assert(plan.parts[1] == "Generate Zig code for: ");
    assert(plan.parts[2] == "print hello world");
    assert(plan.parts[3] == "\n\nRespond with ONLY the Zig code:");
}

// Original lines 60-63 with a correction: the penance block is inserted
// between the system instruction and the user request.
test plan_zig_prompt_with_penance {
    const plan = plan_zig_prompt("print hello world", "use tabs, not spaces");
    assert(plan.len == 7);
    assert(plan.parts[1] == "CORRECTIONS REQUIRED:\n");
    assert(plan.parts[2] == "use tabs, not spaces");
    assert(plan.parts[3] == "\n\n");
    assert(plan.parts[4] == "Generate Zig code for: ");
    assert(plan.parts[5] == "print hello world");
    assert(plan.parts[6] == "\n\nRespond with ONLY the Zig code:");
}

// Original line 96: main requests "print hello world" with no penance —
// the no-penance assembly path.
test main_demo_request {
    assert(DEMO_PROMPT == "print hello world");
    const plan = plan_zig_prompt(DEMO_PROMPT, null);
    assert(plan.len == 4);
}
