module port::trinity::src::vibeec::gguf_demo;

// GGUF DEMO - Load and inspect GGUF model
// phi^2 + 1/phi^2 = 3 = TRINITY

pub fn getDefaultFilePath() -> []const u8 {
    return "data/models/qwen2.5-coder-1.5b-q4_k_m.gguf";
}

pub fn buildMetadataKey(base_key: []const u8, fallback_key: []const u8, key_buf: []u8) -> []const u8 {
    // This simulates the logic: std.fmt.bufPrint(&key_buf, "{s}.context_length", .{arch}) catch "llama.context_length"
    // For testing purposes, we'll return a simple concatenation
    if (base_key.len + 1 < key_buf.len) {
        var i: usize = 0;
        while (i < base_key.len) : (i += 1) {
            key_buf[i] = base_key[i];
        }
        key_buf[base_key.len] = '.';
        return key_buf[0..base_key.len + 1];
    }
    return fallback_key;
}

pub fn shouldDisplayTensor(tensor_index: usize, total_tensors: usize) -> bool {
    // Display first 10 and last 3 tensors
    return tensor_index < 10 or tensor_index >= total_tensors - 3;
}

pub fn formatTensorName(name: []const u8, max_len: usize) -> []const u8 {
    var result: [40]u8 = undefined;
    const actual_len = @min(name.len, max_len);
    var i: usize = 0;
    while (i < actual_len) : (i += 1) {
        result[i] = name[i];
    }
    return result[0..actual_len];
}

pub fn formatTensorTypeName(tensor_type: u32) -> []const u8 {
    // Simulate @tagName(t.tensor_type)[0..@min(@tagName(t.tensor_type).len, 6)]
    switch (tensor_type) {
        0 => "F32  ",
        1 => "F16  ",
        2 => "Q4_0 ",
        3 => "Q4_1 ",
        4 => "Q5_0 ",
        5 => "Q5_1 ",
        6 => "Q8_0 ",
        7 => "Q8_1 ",
        8 => "Q2_K ",
        9 => "Q3_K ",
        10 => "Q4_K ",
        11 => "Q5_K ",
        12 => "Q6_K ",
        13 => "Q8_K ",
        else => "UNK  ",
    }
}

pub fn formatTensorDimensions(dims: []const u32, n_dims: usize) -> []const u8 {
    var result: [32]u8 = undefined;
    var pos: usize = 0;
    result[pos] = '[';
    pos += 1;
    
    var i: usize = 0;
    while (i < n_dims) : (i += 1) {
        if (i > 0) {
            result[pos] = ',';
            pos += 1;
        }
        
        // Convert u32 to string manually
        var num = dims[i];
        var num_pos = pos;
        var temp = num;
        while (temp > 0) : (temp /= 10) {
            num_pos += 1;
        }
        
        var write_pos = num_pos;
        temp = num;
        while (temp > 0) : (temp /= 10) {
            write_pos -= 1;
            result[write_pos] = @as(u8, @intCast(temp % 10 + '0'));
        }
        
        pos = num_pos;
    }
    
    result[pos] = ']';
    return result[0..pos + 1];
}

pub fn calculateTotalParameters(tensors: []const Tensor) -> u64 {
    var total: u64 = 0;
    for (tensors) |t| {
        total += tensorNumElements(t);
    }
    return total;
}

pub fn calculateTotalSize(tensors: []const Tensor) -> u64 {
    var total: u64 = 0;
    for (tensors) |t| {
        total += tensorDataSize(t);
    }
    return total;
}

pub fn main() -> void {
    // File I/O operations - port the decision, not the plumbing
    var allocator = undefined; // std.heap.GeneralPurposeAllocator(.{}){}.allocator();
    var args = undefined; // std.process.argsAlloc(allocator);
    var reader = undefined; // gguf.GGUFReader.init(allocator, path) catch |err| { ... };
    
    // The decision logic for file path handling
    const path = getDefaultFilePath();
    
    // The decision logic for metadata extraction with fallbacks
    var key_buf: [64]u8 = undefined;
    const arch = "unknown"; // reader.getMetadataString("general.architecture") orelse "unknown";
    
    const ctx_key = buildMetadataKey(arch, "llama.context_length", &key_buf);
    const ctx = undefined; // reader.getMetadataU64(ctx_key);
    
    const emb_key = buildMetadataKey(arch, "llama.embedding_length", &key_buf);
    const emb = undefined; // reader.getMetadataU64(emb_key);
    
    const blk_key = buildMetadataKey(arch, "llama.block_count", &key_buf);
    const blk = undefined; // reader.getMetadataU64(blk_key);
    
    const head_key = buildMetadataKey(arch, "llama.attention.head_count", &key_buf);
    const heads = undefined; // reader.getMetadataU64(head_key);
    
    const kv_key = buildMetadataKey(arch, "llama.attention.head_count_kv", &key_buf);
    const kv = undefined; // reader.getMetadataU64(kv_key);
    
    // The decision logic for tensor information display
    var tensors: [13]Tensor = undefined; // reader.tensors.items
    const total_tensors = tensors.len;
    var total_params = calculateTotalParameters(&tensors);
    var total_size = calculateTotalSize(&tensors);
    
    // The decision logic for summary formatting
    const total_params_b = @as(f64, @floatFromInt(total_params)) / 1e9;
    const total_size_gb = @as(f64, @floatFromInt(total_size)) / 1e9;
    
    return;
}

// Test structs to simulate the original data structures
struct Tensor {
    name: []const u8,
    tensor_type: u32,
    dims: [4]u32,
    n_dims: usize,
    data_offset: u64,
}

fn tensorNumElements(t: Tensor) -> u64 {
    var result: u64 = 1;
    var i: usize = 0;
    while (i < t.n_dims) : (i += 1) {
        result *= @as(u64, t.dims[i]);
    }
    return result;
}

fn tensorDataSize(t: Tensor) -> u64 {
    // Simulate different data sizes based on tensor type
    const elements = tensorNumElements(t);
    switch (t.tensor_type) {
        0 => elements * 4, // F32
        1 => elements * 2, // F16
        2 => elements, // Q quantized types
        3 => elements,
        4 => elements,
        5 => elements,
        6 => elements,
        7 => elements,
        8 => elements, // K quantized types
        9 => elements,
        10 => elements,
        11 => elements,
        12 => elements,
        13 => elements,
        else => elements * 4, // Default to F32
    }
}

test getDefaultFilePath_test {
    const default_path = getDefaultFilePath();
    assert(default_path.len > 0);
    assert(default_path[0] == 'd'); // Starts with "data/models/..."
}

test buildMetadataKey_test {
    var key_buf: [64]u8 = undefined;
    
    const result1 = buildMetadataKey("llama", "fallback", &key_buf);
    assert(result1.len > 0);
    assert(result1[result1.len - 1] == '.');
    
    const result2 = buildMetadataKey("phi", "fallback", &key_buf);
    assert(result2.len > 0);
    assert(result2[result2.len - 1] == '.');
}

test shouldDisplayTensor_test {
    // Test with 15 tensors total
    assert(shouldDisplayTensor(0, 15));   // First 10
    assert(shouldDisplayTensor(9, 15));   // Last of first 10
    assert(!shouldDisplayTensor(10, 15));  // Middle ones
    assert(!shouldDisplayTensor(11, 15));  // Middle ones
    assert(shouldDisplayTensor(12, 15));  // First of last 3
    assert(shouldDisplayTensor(13, 15));  // Second of last 3
    assert(shouldDisplayTensor(14, 15));  // Last one
}

test formatTensorName_test {
    var long_name: [50]u8 = undefined;
    const truncated = formatTensorName(&long_name, 40);
    assert(truncated.len == 40);
    
    const short_name = "short";
    const not_truncated = formatTensorName(short_name, 40);
    assert(not_truncated.len == 5);
}

test formatTensorTypeName_test {
    assert(formatTensorTypeName(0) == "F32  ");
    assert(formatTensorTypeName(1) == "F16  ");
    assert(formatTensorTypeName(2) == "Q4_0 ");
    assert(formatTensorTypeName(13) == "Q8_K ");
    assert(formatTensorTypeName(999) == "UNK  ");
}

test formatTensorDimensions_test {
    var dims: [3]u32 = [2, 4, 8];
    const result = formatTensorDimensions(&dims, 3);
    assert(result.len == 7); // "[2,4,8]"
    assert(result[0] == '[');
    assert(result[result.len - 1] == ']');
}

test calculateTotalParameters_test {
    var tensors: [3]Tensor = [
        .{
            .name = "tensor1",
            .tensor_type = 0,
            .dims = [2, 4, 8, 1],
            .n_dims = 3,
            .data_offset = 0,
        },
        .{
            .name = "tensor2", 
            .tensor_type = 1,
            .dims = [3, 3, 3, 1],
            .n_dims = 3,
            .data_offset = 64,
        },
        .{
            .name = "tensor3",
            .tensor_type = 2,
            .dims = [1, 1, 1, 1],
            .n_dims = 1,
            .data_offset = 128,
        },
    ];
    
    const total = calculateTotalParameters(&tensors);
    // tensor1: 2*4*8 = 64, tensor2: 3*3*3 = 27, tensor3: 1 = 1
    assert(total == 64 + 27 + 1);
}

test calculateTotalSize_test {
    var tensors: [2]Tensor = [
        .{
            .name = "f32_tensor",
            .tensor_type = 0, // F32
            .dims = [2, 4, 1, 1],
            .n_dims = 2,
            .data_offset = 0,
        },
        .{
            .name = "f16_tensor",
            .tensor_type = 1, // F16
            .dims = [3, 3, 1, 1],
            .n_dims = 2,
            .data_offset = 32,
        },
    ];
    
    const total = calculateTotalSize(&tensors);
    // f32_tensor: 2*4*4 = 32 bytes, f16_tensor: 3*3*2 = 18 bytes
    assert(total == 32 + 18);
}

test gguf_demo_integration {
    // Test the overall logic flow with mock data
    var key_buf: [64]u8 = undefined;
    
    // Test metadata key building
    const arch = "llama";
    const ctx_key = buildMetadataKey(arch, "fallback", &key_buf);
    assert(ctx_key.len > 0);
    
    // Test tensor filtering logic
    var mock_tensors: [15]Tensor = undefined; // 15 tensors total
    for (0..15) |i| {
        mock_tensors[i] = .{
            .name = "tensor",
            .tensor_type = 0,
            .dims = [1, 1, 1, 1],
            .n_dims = 1,
            .data_offset = @as(u32, @intCast(i)) * 64,
        };
    }
    
    // Should display first 10 and last 3 (indices 0-9 and 12-14)
    assert(shouldDisplayTensor(0, 15));
    assert(shouldDisplayTensor(9, 15));
    assert(!shouldDisplayTensor(10, 15));
    assert(!shouldDisplayTensor(11, 15));
    assert(shouldDisplayTensor(12, 15));
    assert(shouldDisplayTensor(14, 15));
    
    // Test calculations
    const total_params = calculateTotalParameters(&mock_tensors);
    const total_size = calculateTotalSize(&mock_tensors);
    assert(total_params > 0);
    assert(total_size > 0);
}