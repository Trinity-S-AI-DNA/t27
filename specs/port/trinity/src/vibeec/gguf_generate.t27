//
// .t27 re-authoring of gHashTag/trinity:src/vibeec/gguf_generate.zig
// (git blob 5aabfbe8346f), port of `pub fn main() !void`.
//
// In the original, main is plumbing end to end: allocator, argv, model load,
// tokenizer extraction from GGUF metadata, the generation loop, stats and
// std.debug.print. The decisions it makes are ported below as pure helpers,
// each covered by tests. main itself keeps its name with an `undefined;`
// body - allocator, process args, model/tokenizer I/O, timers and printing
// are moves of data in or out - and no test calls it.

module port::trinity::src::vibeec::gguf_generate;

// Lines 75-77: the demo's fixed generation parameters. TEMPERATURE is 0.8
// (f32) but only forwards to the model call on line 86 and decides nothing
// a pure helper can observe, so it stays plumbing.
const INITIAL_TOKEN: u32 = 1;
const NUM_TOKENS: usize = 10;

// Line 17: argv[1] when present, else the built-in demo model path.
pub fn resolve_model_path(args: []str) -> []const u8 {
    if (args.len > 1) {
        return args[1];
    }
    return "data/models/tinyllama-1.1b-q8_0.gguf";
}

// The facts main reads from one GGUF metadata value (lines 49-51): whether
// the key exists, whether it holds an array, and the array length.
struct MetaValue {
    present: bool,
    is_array: bool,
    arr_len: usize,
}

// One entry of that metadata array (lines 54-60): only is_string and text
// are read.
struct MetaItem {
    is_string: bool,
    text: []const u8,
}

// Lines 49-51 and 62: the tokenizer list exists only when the key is present
// and holds an array; its length is the number of tokens loaded, else there
// is no list (0).
pub fn tokenizer_count(value: MetaValue) -> usize {
    if (value.present && value.is_array) {
        return value.arr_len;
    }
    return 0;
}

// Lines 55-59: a string entry is kept as-is; anything else becomes "".
pub fn token_entry(item: MetaItem) -> []const u8 {
    if (item.is_string) {
        return item.text;
    }
    return "";
}

// Lines 103-111: a generated id is decoded only while it indexes the
// tokenizer list; past the end there is nothing to print.
pub fn decode_token(tokens: []str, id: u32) -> []const u8 {
    if ((id as usize) < tokens.len) {
        return tokens[id as usize];
    }
    return "";
}

// Lines 105-109: how many of the generated ids the tokenizer can name.
pub fn decodable_count(ids: []const u32, vocab: usize) -> usize {
    var n: usize = 0;
    for id in ids {
        if ((id as usize) < vocab) {
            n += 1;
        }
    }
    return n;
}

// Line 83: generation fills a fixed [20]u32 buffer with a length, never a
// growable list.
struct TokenBuf {
    items: [20]u32,
    len: usize,
}

// Line 86: model.generateToken reads GGUF weights from disk - plumbing. The
// decision the loop depends on is the map from the current token to the
// sampled next token, passed in here as a transition table; an id past the
// table end is the model error that stops the run early (the catch on
// line 86 breaks the loop).
pub fn sample_next(table: []const u32, current: u32) -> (bool, u32) {
    if ((current as usize) >= table.len) {
        return (false, 0);
    }
    const next: u32 = table[current as usize];
    return (true, next);
}

// Lines 75-92: start at token 1, chain up to num_tokens samples into the
// fixed buffer, stop at the first model error. The buffer never grows past
// its 20 slots (line 83).
pub fn generate_tokens(num_tokens: usize, table: []const u32) -> TokenBuf {
    var items: [20]u32 = [_]u32{0} ** 20;
    var n: usize = 0;
    var current: u32 = INITIAL_TOKEN;
    var i: usize = 0;
    while (i < num_tokens && n < 20) {
        const (ok, next) = sample_next(table, current);
        if (!ok) {
            break;
        }
        items[n] = next;
        n += 1;
        current = next;
        i += 1;
    }
    return TokenBuf { items: items, len: n };
}

// Main's generation section with the original's constants (lines 75-77):
// NUM_TOKENS tokens starting from INITIAL_TOKEN.
pub fn demo_run(table: []const u32) -> TokenBuf {
    return generate_tokens(NUM_TOKENS, table);
}

// Line 42 and 116: nanoseconds to milliseconds for the report.
pub fn ns_to_ms(ns: u64) -> f64 {
    return (ns as f64) / 1000000.0;
}

// Line 117: tokens per second over the measured window.
pub fn tokens_per_sec(num_tokens: usize, ns: u64) -> f64 {
    return (num_tokens as f64) / ((ns as f64) / 1000000000.0);
}

// The original `pub fn main() !void` (line 9): allocator, std.process args,
// model load, timers, tokenizer free, std.debug.print. All moves of data in
// or out; the decisions above carry the logic. Body stays undefined and no
// test calls it.
pub fn main() {
    undefined;
}

test resolve_model_path_defaults_to_tinyllama {
    var argv: [1][]const u8 = ["gguf_generate"];
    assert(resolve_model_path(&argv) == "data/models/tinyllama-1.1b-q8_0.gguf");
}

test resolve_model_path_takes_argv1 {
    var argv: [2][]const u8 = ["gguf_generate", "models/other.gguf"];
    assert(resolve_model_path(&argv) == "models/other.gguf");
}

test tokenizer_count_needs_present_array {
    assert(tokenizer_count(MetaValue { present: true, is_array: true, arr_len: 4 }) == 4);
    assert(tokenizer_count(MetaValue { present: false, is_array: true, arr_len: 4 }) == 0);
    assert(tokenizer_count(MetaValue { present: true, is_array: false, arr_len: 4 }) == 0);
    assert(tokenizer_count(MetaValue { present: false, is_array: false, arr_len: 0 }) == 0);
}

test token_entry_keeps_strings_only {
    assert(token_entry(MetaItem { is_string: true, text: "hello" }) == "hello");
    assert(token_entry(MetaItem { is_string: false, text: "dropped" }) == "");
}

test decode_token_respects_vocabulary_bounds {
    var toks: [3][]const u8 = ["<unk>", "hello", "world"];
    assert(decode_token(&toks, 1) == "hello");
    assert(decode_token(&toks, 2) == "world");
    assert(decode_token(&toks, 3) == "");
}

test decodable_count_bounds_against_vocab {
    var ids: [5]u32 = [1, 9, 2, 0, 7];
    assert(decodable_count(&ids, 3) == 3);
}

test sample_next_maps_token_or_errors {
    var table: [3]u32 = [7, 8, 9];
    const (ok1, next1) = sample_next(&table, 2);
    assert(ok1);
    assert(next1 == 9);
    const (ok2, next2) = sample_next(&table, 3);
    assert(!ok2);
    assert(next2 == 0);
}

test demo_run_chains_and_stops_on_model_error {
    // table[i] = i+1: from token 1 the chain walks 2,3,4,5,6 and then id 6
    // is past the table end - the model error that breaks the loop (line 86),
    // so 5 tokens land in the buffer even though NUM_TOKENS asks for 10.
    var table: [6]u32 = [1, 2, 3, 4, 5, 6];
    const r = demo_run(&table);
    assert(r.len == 5);
    assert(r.items[0] == 2);
    assert(r.items[4] == 6);
}

test generate_tokens_respects_num_tokens_cap {
    var table: [6]u32 = [1, 2, 3, 4, 5, 6];
    const few = generate_tokens(3, &table);
    assert(few.len == 3);
    assert(few.items[2] == 4);
    const none = generate_tokens(0, &table);
    assert(none.len == 0);
    assert(none.items[0] == 0);
}

test stats_convert_nanoseconds {
    assert(ns_to_ms(1_000_000) == 1.0);
    assert(ns_to_ms(2_500_000_000) == 2500.0);
    assert(tokens_per_sec(10, 1_000_000_000) == 10.0);
    assert(tokens_per_sec(100, 2_000_000_000) == 50.0);
}
