module port::trinity::src::vibeec::evolved_cli;

// CommandHandler type definition
pub const CommandHandler = *const fn (allocator: mem.Allocator, args: []const []const u8) anyerror!void;

// CommandOrganism struct
pub const CommandOrganism = struct {
    allocator: mem.Allocator,
    handlers: [0]CommandHandler,
    mentor: void,
};

pub fn CommandOrganism_init(allocator: mem.Allocator) CommandOrganism {
    return CommandOrganism{
        .allocator = allocator,
        .handlers = map.StringHashMap(CommandHandler).init(allocator),
        .mentor = undefined,
    };
}

pub fn CommandOrganism_deinit(self: *CommandOrganism) void {
    self.handlers.deinit();
}

pub fn CommandOrganism_bindSynapses(self: *CommandOrganism, name: []const u8, handler: CommandHandler) !void {
    try self.handlers.put(name, handler);
    return undefined; // Original prints: "🧬 [Nervous System] Bound synapse: {s}\n"
}

pub fn CommandOrganism_reflex(self: *CommandOrganism, args: [][]const u8) !void {
    if (args.len == 0) return error.NoInput;

    const cmd_name = args[0];
    if (self.handlers.get(cmd_name)) |handler| {
        // Original prints: "⚡ [Nervous System] Firing synapse: {s}\n"
        try handler(self.allocator, args[1..]);
    } else {
        // Original prints: "❓ [Nervous System] Unknown stimulus: {s}\n"
        return error.UnknownCommand;
    }
}

pub fn CommandOrganism_evolveReflex(self: *CommandOrganism, name: []const u8, new_handler: CommandHandler) !void {
    // Original prints: "🦋 [Mutation] Evolving reflex {s}...\n"
    
    // Mock mentor approval for testing
    const passed = true;

    if (passed) {
        try self.handlers.put(name, new_handler);
        // Original prints: "✨ [Mutation] Success. {s} is now evolved.\n"
    } else {
        // Original prints: "⛔ [Mutation] Rejected by Mentor. Retaining old reflex.\n"
    }
}

fn defaultChat(allocator: mem.Allocator, args: [][]const u8) !void {
    _ = allocator;
    _ = args;
    // Original prints: "💬 [Chat] Standard mode active.\n"
    return undefined;
}

fn turboChat(allocator: mem.Allocator, args: [][]const u8) !void {
    _ = allocator;
    _ = args;
    // Original prints: "🚀 [Chat] TURBO AVX2 mode active (10x speedup)!\n"
    return undefined;
}

pub fn main() !void {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;

    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();

    // Bind initial instincts
    try organism.bindSynapses("chat", defaultChat);

    // Simulate lifecycle
    const args: [2][]const u8 = ["chat", "hello"];
    try organism.reflex(&args);

    // Trigger Evolution
    try organism.evolveReflex("chat", turboChat);

    // Test evolved reflex
    try organism.reflex(&args);
}

// Test cases for the ported functions
test CommandOrganism_init_basic {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    const organism = CommandOrganism_init(allocator);
    assert(organism.allocator == allocator);
    assert(organism.handlers.count() == 0);
}

test CommandOrganism_init_handlers_empty {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    const organism = CommandOrganism_init(allocator);
    assert(organism.handlers.count() == 0);
}

test CommandOrganism_bindSynapses_basic {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();
    
    // Test binding a handler
    try organism.bindSynapses("test", defaultChat);
    assert(organism.handlers.count() == 1);
}

test CommandOrganism_reflex_known_command {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();
    
    try organism.bindSynapses("chat", defaultChat);
    
    const args: [2][]const u8 = ["chat", "hello"];
    try organism.reflex(&args); // Should not error
}

test CommandOrganism_reflex_unknown_command {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();
    
    const args: [2][]const u8 = ["unknown", "hello"];
    const result = organism.reflex(&args);
    assert(result == error.UnknownCommand);
}

test CommandOrganism_reflex_no_input {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();
    
    const args: [0][]const u8 = [];
    const result = organism.reflex(&args);
    assert(result == error.NoInput);
}

test defaultChat_handler {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    const args: [2][]const u8 = ["hello", "world"];
    try defaultChat(allocator, &args); // Should not error
}

test turboChat_handler {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    const args: [2][]const u8 = ["fast", "mode"];
    try turboChat(allocator, &args); // Should not error
}

test main_function_flow {
    // Simplified allocator for testing
    const allocator = &std.heap.page_allocator;
    
    var organism = CommandOrganism_init(allocator);
    defer organism.deinit();
    
    // Test the main function flow
    try organism.bindSynapses("chat", defaultChat);
    
    const args: [2][]const u8 = ["chat", "test"];
    try organism.reflex(&args); // Should work
    
    try organism.evolveReflex("chat", turboChat);
    try organism.reflex(&args); // Should work after evolution
}