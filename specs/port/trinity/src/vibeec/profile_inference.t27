// Port of gHashTag/trinity src/vibeec/profile_inference.zig @ 1a7ffe8f72c7.
//
// The original file is one 77-line `pub fn main() !void`: allocator setup, a
// process-args peek, model file load, 10 timed forward passes, and stdout
// printing, wrapped around three concrete decisions. Those decisions are the
// port and live below as pure functions:
//   1. model path: argv[1] when present, else the tinyllama default (line 17)
//   2. timing math: average ms per token and tokens per second (lines 46-47)
//   3. FLOP estimate: per-layer qkv/attn/ffn ops, output projection, total
//      ops and achieved GFLOPS from the model config and avg time (lines 29,
//      57-74)
// The plumbing itself (FullModel.init, loadWeights, Timer, printing) has no
// place to land in this spec, so `main` keeps its name with an `undefined;`
// body that no test calls.

module port::trinity::src::vibeec::profile_inference;

// Line 29: the profile runs 10 forward passes.
const PROFILE_TOKENS: i64 = 10;

// The model config facts the breakdown reads (lines 57-67). Field values in
// the tests are the real tinyllama-1.1b ones the default path loads.
struct ModelConfig {
    hidden_size: i64,
    num_kv_heads: i64,
    head_dim: i64,
    num_heads: i64,
    intermediate_size: i64,
    vocab_size: i64,
    num_layers: i64,
}

fn tinyllama_config() -> ModelConfig {
    return ModelConfig {
        hidden_size: 2048,
        num_kv_heads: 4,
        head_dim: 64,
        num_heads: 32,
        intermediate_size: 5632,
        vocab_size: 32000,
        num_layers: 22,
    };
}

// Line 17: `const path = if (args.len > 1) args[1] else "data/models/..."`.
pub fn model_path_arg(args: []str) -> str {
    if (args.len > 1) {
        return args[1];
    }
    return "data/models/tinyllama-1.1b-q8_0.gguf";
}

// Line 46: average milliseconds per token = total nanoseconds / passes / 1e6.
pub fn avg_ms(total_time_ns: i64, num_tokens: i64) -> f64 {
    return (total_time_ns as f64) / (num_tokens as f64) / 1000000.0;
}

// Line 47: tokens per second = 1000.0 / avg_ms.
pub fn tok_per_sec(avg_ms_per_token: f64) -> f64 {
    return 1000.0 / avg_ms_per_token;
}

// Line 61: qkv projection of one layer.
pub fn qkv_ops(c: ModelConfig) -> i64 {
    return c.hidden_size * c.hidden_size + 2 * c.hidden_size * c.num_kv_heads * c.head_dim;
}

// Line 62: attention output projection of one layer.
pub fn attn_ops(c: ModelConfig) -> i64 {
    return c.num_heads * c.head_dim * c.hidden_size;
}

// Line 63: feed-forward block of one layer.
pub fn ffn_ops(c: ModelConfig) -> i64 {
    return 3 * c.hidden_size * c.intermediate_size;
}

// Line 64: output (lm head) projection.
pub fn output_ops(c: ModelConfig) -> i64 {
    return c.vocab_size * c.hidden_size;
}

// Line 67: per-layer total, then the full-model total.
pub fn total_ops_per_layer(c: ModelConfig) -> i64 {
    return qkv_ops(c) + attn_ops(c) + ffn_ops(c);
}

pub fn total_ops(c: ModelConfig) -> i64 {
    return total_ops_per_layer(c) * c.num_layers + output_ops(c);
}

// Line 74: achieved GFLOPS, two flops per multiply-add.
pub fn achieved_gflops(total_ops_count: i64, avg_ms_per_token: f64) -> f64 {
    return (total_ops_count as f64) * 2.0 / (avg_ms_per_token / 1000.0) / 1000000000.0;
}

// The original `pub fn main() !void`: it only moves data in and out — loads
// the model file, runs the timer loop and prints the report. Everything it
// decides is ported above; the plumbing keeps the name with an `undefined;`
// body that no test calls.
pub fn main() -> void {
    undefined;
}

// ---- tests ----

// Line 17 with no argument and with one.
test model_path_arg_default_and_override {
    var argv_default: [1][]const u8 = ["profile_inference"];
    const p0 = model_path_arg(&argv_default);
    assert(p0 == "data/models/tinyllama-1.1b-q8_0.gguf");

    var argv_given: [2][]const u8 = ["profile_inference", "data/models/other.gguf"];
    const p1 = model_path_arg(&argv_given);
    assert(p1 == "data/models/other.gguf");
}

// Lines 46-47: 10 passes over 2.5 s of samples -> 250 ms per token, 4 tok/s.
test avg_ms_and_tok_per_sec {
    assert_eq(avg_ms(2500000000, PROFILE_TOKENS), 250.0);
    assert_eq(tok_per_sec(250.0), 4.0);
    assert_eq(avg_ms(1000000, 1), 1.0);
}

// Lines 61-67 on the real tinyllama-1.1b config the default path resolves to.
test ops_breakdown_tinyllama {
    const c = tinyllama_config();
    assert(qkv_ops(c) == 5242880);
    assert(attn_ops(c) == 4194304);
    assert(ffn_ops(c) == 34603008);
    assert(output_ops(c) == 65536000);
    assert(total_ops_per_layer(c) == 44040192);
    assert(total_ops(c) == 1034420224);
}

// Same formulas on a minimal config so the port is checked beyond one point.
test ops_breakdown_minimal_config {
    const c = ModelConfig {
        hidden_size: 4,
        num_kv_heads: 1,
        head_dim: 1,
        num_heads: 1,
        intermediate_size: 2,
        vocab_size: 8,
        num_layers: 1,
    };
    assert(qkv_ops(c) == 24);
    assert(attn_ops(c) == 4);
    assert(ffn_ops(c) == 24);
    assert(output_ops(c) == 32);
    assert(total_ops_per_layer(c) == 52);
    assert(total_ops(c) == 84);
}

// Line 74: 1,034,420,224 ops in 250 ms is 2*ops/seconds/1e9 = ~8.275 GFLOPS.
test achieved_gflops_range {
    const c = tinyllama_config();
    const g = achieved_gflops(total_ops(c), 250.0);
    assert(g > 8.275 and g < 8.276);
}
