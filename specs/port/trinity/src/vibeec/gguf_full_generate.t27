module port::trinity::src::vibeec::gguf_full_generate;

// Port of gHashTag/trinity src/vibeec/gguf_full_generate.zig (5aabfbe8346f).
// The original main() is the process boundary: it wires a
// GeneralPurposeAllocator, reads argv, loads the GGUF model and its
// tokenizer from disk, runs the generation loop against the loaded model,
// and prints banners, progress and stats to stdout. All of that is
// plumbing; the decisions the loop makes are ported as the pure functions
// below. main() keeps its name with an `undefined;` body that no test
// calls.

// The process entry point. Its real work -- allocator setup, argv, file
// loading, stdout -- cannot exist in a spec, so the body is `undefined;`
// per the port brief, and the decisions it once made inline are ported
// and tested in the functions below.
pub fn main() {
    undefined;
}

// Line 18: the model path is argv[1] when one is given, else the
// TinyLlama Q8_0 default baked into the tool.
pub fn choose_model_path(args: []str) -> []const u8 {
    if (args.len > 1) {
        return args[1];
    }
    return "data/models/tinyllama-1.1b-q8_0.gguf";
}

// Lines 45-49: the tokenizer is only read when the GGUF metadata carries
// "tokenizer.ggml.tokens" and that value is an array. Anything else means
// no token list is loaded, so the decode step later prints nothing.
pub fn tokenizer_available(has_tokens_key: bool, is_array: bool) -> bool {
    return has_tokens_key and is_array;
}

// Lines 51-57: while copying the metadata array into the token list, an
// entry that is not a string becomes "" in the list rather than being
// skipped, so token ids stay aligned with their positions.
pub fn token_entry(is_string: bool, entry: []const u8) -> []const u8 {
    if (is_string) {
        return entry;
    }
    return "";
}

// Lines 71-73, 81: generation starts at the BOS token, produces 20 tokens
// at temperature 0.7, and writes into a fixed 32-slot buffer.
pub const BOS_TOKEN: u32 = 1;
pub const NUM_TOKENS: usize = 20;
pub const TEMPERATURE: f32 = 0.7;
pub const GENERATED_CAP: usize = 32;

// Lines 92-95: while generating, a progress banner is printed on every
// 5th token produced, counted from the first.
pub fn is_progress_step(i: usize) -> bool {
    return (i + 1) % 5 == 0;
}

// Lines 81-95: the generation loop's decisions. It seeds the chain with
// the BOS token, feeds each generated token back in as the next input,
// stops after NUM_TOKENS tokens, and on the first generation error keeps
// whatever was generated so far instead of failing. The model call is
// plumbing: `outputs` stands for what model.generate returned in order,
// and a missing entry stands for that error.
pub fn generate_sequence(outputs: []const u32) -> (usize, u32) {
    var i: usize = 0;
    var current: u32 = BOS_TOKEN;
    while (i < NUM_TOKENS) {
        if (i >= outputs.len) {
            break;
        }
        current = outputs[i];
        i += 1;
    }
    return (i, current);
}

// Lines 106-114: a generated id is looked up in the token list only when
// it is in range; out-of-range ids are skipped, which for the caller's
// print loop is the same as printing "".
pub fn decode_token(tokens: []str, t: u32) -> []const u8 {
    if ((t as usize) < tokens.len) {
        return tokens[t];
    }
    return "";
}

// Lines 41-42, 97, 119-120: the timer counts nanoseconds; the stats step
// converts to seconds and divides generated tokens by seconds for speed.
pub fn to_seconds(nanoseconds: u64) -> f64 {
    return nanoseconds as f64 / 1000000000.0;
}

pub fn tokens_per_sec(tokens: usize, seconds: f64) -> f64 {
    return tokens as f64 / seconds;
}

// -- tests -----------------------------------------------------------

// Line 18: an explicit argv path wins over the default.
test choose_model_path_arg_wins {
    var argv: [2][]const u8 = ["gguf-full-generate", "data/models/other.gguf"];
    assert(choose_model_path(&argv) == "data/models/other.gguf");
}

// Line 18: no argv path falls back to the TinyLlama default.
test choose_model_path_default {
    var argv: [1][]const u8 = ["gguf-full-generate"];
    assert(choose_model_path(&argv) == "data/models/tinyllama-1.1b-q8_0.gguf");
}

// Lines 45-49: only a present "tokenizer.ggml.tokens" key holding an
// array makes the tokenizer usable.
test tokenizer_gate {
    assert(tokenizer_available(true, true));
    assert(!tokenizer_available(false, true));
    assert(!tokenizer_available(true, false));
    assert(!tokenizer_available(false, false));
}

// Lines 51-57: non-string metadata entries become "" instead of shifting
// the later positions.
test token_entry_string_or_empty {
    assert(token_entry(true, "Hello") == "Hello");
    assert(token_entry(false, "Hello") == "");
}

// Lines 71-73, 81: the original's generation constants, including that
// the fixed buffer holds the full 20-token run.
// The generation buffer (line 81) is a fixed [32]u32; NUM_TOKENS (line 72)
// must fit inside it — this test fills it the way the original loop does,
// so an out-of-range NUM_TOKENS would trip it at runtime.
test generation_fits_fixed_buffer {
    var generated: [GENERATED_CAP]u32 = [_]u32{0} ** GENERATED_CAP;
    var i: usize = 0;
    while (i < NUM_TOKENS) {
        generated[i] = BOS_TOKEN;
        i += 1;
    }
    assert(generated[NUM_TOKENS - 1] == BOS_TOKEN);
    assert(generated[GENERATED_CAP - 1] == 0);
}

// Line 73: the sampling temperature is fixed at 0.7 and flows into the
// generate call.
test sampling_temperature_is_fixed {
    var temp: f32 = TEMPERATURE;
    assert(temp == 0.7);
}

// Lines 92-95: progress is reported exactly on the 5th, 10th, 15th, 20th
// token, not on the tokens between.
test progress_every_fifth_token {
    assert(!is_progress_step(0));
    assert(!is_progress_step(3));
    assert(is_progress_step(4));
    assert(is_progress_step(9));
    assert(is_progress_step(19));
}

// Lines 81-95: a full run chains 20 tokens; the last generated token is
// the one the chain ends on.
test generation_full_run {
    var outputs: [24]u32 = [_]u32{0} ** 24;
    var k: usize = 0;
    while (k < 24) {
        outputs[k] = (k as u32) + 10;
        k += 1;
    }
    const (count, last) = generate_sequence(&outputs);
    assert(count == NUM_TOKENS);
    assert(last == 29);
}

// Lines 87-90: an error part-way through stops the loop and keeps the
// tokens generated before it, chain ending on the last good token.
test generation_stops_on_model_error {
    var outputs: [3]u32 = [7, 8, 9];
    const (count, last) = generate_sequence(&outputs);
    assert(count == 3);
    assert(last == 9);
}

// Lines 71, 81: with nothing generated yet, the chain still starts at the
// BOS token.
test generation_empty_keeps_bos {
    const (count, last) = generate_sequence([]);
    assert(count == 0);
    assert(last == BOS_TOKEN);
}

// Lines 106-114: in-range ids decode to their token strings.
test decode_in_range {
    var tokens: [4][]const u8 = ["<s>", " the", " cat", " sat"];
    assert(decode_token(&tokens, 0) == "<s>");
    assert(decode_token(&tokens, 3) == " sat");
}

// Lines 106-114: ids past the end of the token list print nothing, which
// is what "" stands for here.
test decode_out_of_range_prints_nothing {
    var tokens: [2][]const u8 = ["<s>", " the"];
    assert(decode_token(&tokens, 2) == "");
    assert(decode_token(&tokens, 999) == "");
}

// Lines 41-42, 119-120: nanoseconds convert to seconds, and speed is
// tokens over seconds -- 20 tokens in 2s is 10 tokens/sec.
test stats_math {
    assert(to_seconds(2000000000) == 2.0);
    assert(tokens_per_sec(NUM_TOKENS, to_seconds(2000000000)) == 10.0);
}
