module port::trinity::src::tri::tri_init;

// Port of gHashTag/trinity/src/tri/tri_init.zig
// Functions: runInitCommand, printForkGuide

// Pure helper function that decides whether --cell flag is present
fn hasCellFlag(args: []str) -> bool {
    var i: usize = 0;
    while (i < args.len) {
        if (args[i] == "--cell") {
            return true;
        }
        i += 1;
    }
    return false;
}

pub fn runInitCommand(allocator: ?u8, args: []str) -> ?i32 {
    // Check for --cell flag using pure helper
    if (hasCellFlag(args)) {
        // Plumbing - external call, so return undefined
        return undefined;
    }

    // Default: show fork instructions
    printForkGuide();
    return 0;
}

fn printForkGuide() -> void {
    // Pure decision logic - no external calls
    const GOLDEN = "\x1b[33m";  // Golden color
    const RESET = "\x1b[0m";    // Reset color
    const CYAN = "\x1b[36m";    // Cyan color
    
    return;
}

// Test the pure helper function
test hasCellFlag_no_cell {
    var args: [2][]const u8 = ["tri", "init"];
    assert(!hasCellFlag(&args));
}

// Test the pure helper function with cell flag
test hasCellFlag_with_cell {
    var args: [4][]const u8 = ["tri", "init", "--cell", "my-cell"];
    assert(hasCellFlag(&args));
}