module port::github_comment;

// Port of gHashTag/trinity src/tri/queen/github_comment.zig at
// df620a2b9b43 (115 lines, 3 pub functions): the Queen posts Lotus Cycle
// progress comments on GitHub issues.
//
// The HTTP POST (std.http.Client), the JSON encoding, the allocator use
// and the string assembly are plumbing that stays in the Zig original.
// The decisions that code makes are carried here as pure .t27 functions
// and asserted by the tests below. The three entry points keep their
// original names with `undefined;` bodies; no test calls them - firing
// the request is the caller's job.
//
// Test literals are ASCII only: t27c gen does not preserve multi-byte
// UTF-8 inside string literals, so the original's emoji inputs are
// covered through the byte math they produce rather than as raw emoji.

// Original line 8.
const REPO: []const u8 = "gHashTag/trinity";
// Original line 10: the original interpolates this template unfilled, so
// its {s} braces reach the request URL literally.
const ISSUE_COMMENT_API: []const u8 = "repos/{s}/issues/{s}/comments";
// Original line 24: the URL is "https://api.github.com/{s}/{s}/{s}"
// filled with REPO, the issue number and ISSUE_COMMENT_API, in that order.
const URL_BASE: []const u8 = "https://api.github.com/";

// Original lines 13-16: the payload the Queen sends.
pub struct CommentData {
    issue_number: u64,
    body: []const u8,
}

// Original line 20: `if (GITHUB_TOKEN.len == 0) return;` - without a
// GITHUB_TOKEN in the environment the Queen silently does nothing.
pub fn github_token_present(token: []const u8) -> bool {
    return token.len > 0;
}

// How many decimal digits std.fmt prints for an unsigned value; 0
// prints as one digit.
pub fn decimal_digits(n: u64) -> usize {
    var v: u64 = n;
    var count: usize = 1;
    while (v >= 10) {
        v = v / 10;
        count += 1;
    }
    return count;
}

// Original lines 22-26: byte length of the URL std.fmt.allocPrint builds:
// URL_BASE + REPO + "/" + <issue digits> + "/" + ISSUE_COMMENT_API.
pub fn comment_url_length(issue_number: u64) -> usize {
    var total: usize = URL_BASE.len + REPO.len + 1;
    total += decimal_digits(issue_number);
    total += 1 + ISSUE_COMMENT_API.len;
    return total;
}

// Original lines 28-32: byte length of the minified JSON payload
// std.json.stringifyAlloc builds for the anonymous struct {"body": ...}:
// the frame `{"body":"` + body + `"}` is 11 bytes, with JSON escaping on
// top (\" \\ \n \r \t grow by one byte, any other control byte becomes
// \u00xx and grows by five).
pub fn comment_body_json_length(body: []const u8) -> usize {
    var extra: usize = 0;
    for c in body {
        if (c == 8 or c == 12 or c == '"' or c == '\\' or c == '\n' or c == '\r' or c == '\t') {
            extra += 1;
        } else if (c < ' ') {
            extra += 5;
        }
    }
    return 11 + body.len + extra;
}

// Original line 58: only HTTP 201 Created (.created) counts as success;
// every other status takes the red failure path.
pub fn comment_created(status: u32) -> bool {
    return status == 201;
}

// Original line 63: on failure the response body is printed only when
// the read got bytes (readAllAlloc up to 1024, `catch ""` on error).
pub fn report_error_body(error_body_len: usize) -> bool {
    return error_body_len > 0;
}

// Original lines 19-70: createIssueComment. Its body is the request
// itself - token gate, URL build, JSON payload, headers, POST, status
// handling - plumbing that stays in the Zig original; the decisions it
// makes are the helpers above. No test calls this.
pub fn createIssueComment(data: CommentData) {
    undefined;
}

// Original lines 77-86, the comment formatLotusProgressComment assembles:
// "## " + title + " Lotus Cycle Progress Update#" + <issue digits> +
// "\n\n", then every section followed by "\n". " Lotus Cycle Progress
// Update#" is 29 bytes. (The original's format string carries a {d} slot
// with no argument; the issue number is the intended value there.)
pub fn lotus_header_length(title: []const u8, issue_number: u64) -> usize {
    var total: usize = 3;
    total += title.len;
    total += 29;
    total += decimal_digits(issue_number);
    total += 2;
    return total;
}

// Original lines 81-84: every section is appended and followed by "\n".
pub fn lotus_comment_length(title: []const u8, issue_number: u64, sections: []str) -> usize {
    var total: usize = lotus_header_length(title, issue_number);
    for section in sections {
        total += section.len;
        total += 1;
    }
    return total;
}

// Original lines 73-87: formatLotusProgressComment. The original
// assembles the string with std.ArrayList; .t27 has no string
// concatenation today, so the byte shape of the comment is carried by
// lotus_header_length and lotus_comment_length above and this keeps the
// interface. No test calls this.
pub fn formatLotusProgressComment(issue_number: u64, title: []const u8, sections: []str) -> []const u8 {
    undefined;
}

// Original lines 91-99: the section header is exactly
// emoji + " " + title + "\n" - one byte for the space, one for the newline.
pub fn section_header_length(emoji: []const u8, title: []const u8) -> usize {
    return emoji.len + 1 + title.len + 1;
}

// Original line 91: the ArrayList is created with capacity
// emoji.len + title.len + 5 - two bytes more than the result needs.
pub fn section_header_capacity(emoji: []const u8, title: []const u8) -> usize {
    return emoji.len + title.len + 5;
}

// Original lines 90-100: sectionHeader. Same as formatLotusProgressComment
// - the bytes are carried by the two helpers above and this keeps the
// interface. No test calls this.
pub fn sectionHeader(emoji: []const u8, title: []const u8) -> []const u8 {
    undefined;
}

test token_gate_skips_without_token {
    assert(!github_token_present(""));
    assert(github_token_present("ghp_queen"));
}

test decimal_digits_counts {
    assert(decimal_digits(0) == 1);
    assert(decimal_digits(9) == 1);
    assert(decimal_digits(10) == 2);
    assert(decimal_digits(4547) == 4);
}

test comment_created_only_201 {
    assert(comment_created(201));
    assert(!comment_created(200));
    assert(!comment_created(301));
    assert(!comment_created(404));
    assert(!comment_created(500));
}

test error_body_reported_only_when_read {
    assert(!report_error_body(0));
    assert(report_error_body(1));
    assert(report_error_body(1024));
}

test comment_url_length_counts {
    assert(comment_url_length(7) == 71);
    assert(comment_url_length(123) == 73);
    assert(comment_url_length(4547) == 74);
}

test comment_body_json_length_escapes {
    assert(comment_body_json_length("") == 11);
    assert(comment_body_json_length("hello") == 16);
    assert(comment_body_json_length("Hello \"world\"") == 26);
    assert(comment_body_json_length("a\nb") == 15);
}

test lotus_header_length_counts {
    assert(lotus_header_length("Test Update", 123) == 48);
    assert(lotus_header_length("", 5) == 35);
}

test lotus_comment_length_counts_sections {
    // ASCII stand-ins for the original's emoji sections; the byte math is
    // identical (each emoji is just a multi-byte run inside the section).
    var sections: [2][]const u8 = ["### Metrics", "Build: ok, Tests: ok"];
    assert(lotus_comment_length("Test Update", 123, &sections) == 81);
}

test section_header_shape_and_capacity {
    // Same byte math as the original's emoji headers: an emoji is just a
    // multi-byte prefix (3 bytes for U+2705, 4 for U+1F4CA).
    assert(section_header_length(">", "Build") == 8);
    assert(section_header_capacity(">", "Build") == 11);
    assert(section_header_length("Done", "Metrics") == 13);
    assert(section_header_capacity("Done", "Metrics") == 16);
}
