module TrinityPGConfig;

pub const TrinityPGConfig = struct {
    vocab_size: usize,
    embed_dim: usize,
    hidden_dim: usize,
    context_len: usize,
    num_blocks: usize,
    num_heads: usize,
    head_dim: usize,
    ffn_hidden: usize,
    bits_per_weight: usize,
    batch_size: usize,
    lr: f64,
    lr_min: f64,
    lamb_clamp: f64,
    stable_ratio: f64,
    grad_clip: f64,
};

pub fn TrinityPGConfig_totalParams(config: TrinityPGConfig) -> usize {
    const embedding = config.vocab_size * config.embed_dim;
    const per_block_attn = 4 * config.embed_dim * config.embed_dim;
    const per_block_ffn = 3 * config.embed_dim * config.ffn_hidden;
    const per_block = per_block_attn + per_block_ffn;
    const all_blocks = config.num_blocks * per_block;
    const lm_head = config.vocab_size * config.embed_dim;
    return embedding + all_blocks + lm_head;
}

pub fn TrinityPGConfig_modelSizeBytes(config: TrinityPGConfig) -> usize {
    return TrinityPGConfig_totalParams(config) * config.bits_per_weight / 8;
}

pub fn TrinityPGConfig_modelSizeMB(config: TrinityPGConfig) -> f64 {
    return TrinityPGConfig_modelSizeBytes(config) as f64 / (1024.0 * 1024.0);
}

pub fn TrinityPGConfig_fitsBudget(config: TrinityPGConfig, budget_mb: f64) -> bool {
    return TrinityPGConfig_modelSizeMB(config) <= budget_mb;
}

pub fn TrinityPGConfig_allDimsPowerOf3(config: TrinityPGConfig) -> bool {
    return isPowerOf3(config.vocab_size) and
        isPowerOf3(config.embed_dim) and
        isPowerOf3(config.context_len) and
        isPowerOf3(config.num_blocks) and
        isPowerOf3(config.num_heads) and
        isPowerOf3(config.head_dim) and
        isPowerOf3(config.ffn_hidden);
}

pub fn TrinityPGConfig_squareAttentionHolds(config: TrinityPGConfig) -> bool {
    if (config.context_len % config.head_dim != 0) return false;
    return isPowerOf3(config.context_len / config.head_dim);
}

pub fn TrinityPGConfig_validate(config: TrinityPGConfig) {
    undefined;
}

fn isPowerOf3(n: usize) -> bool {
    if (n == 0) return false;
    var v = n;
    while (v % 3 == 0) {
        v = v / 3;
    }
    return v == 1;
}

// Test data matching the original PG_CONFIG
const TEST_CONFIG = TrinityPGConfig{
    .vocab_size = 729,
    .embed_dim = 243,
    .hidden_dim = 729,
    .context_len = 81,
    .num_blocks = 9,
    .num_heads = 9,
    .head_dim = 27,
    .ffn_hidden = 729,
    .bits_per_weight = 2,
    .batch_size = 66,
    .lr = 3e-4,
    .lr_min = 1e-5,
    .lamb_clamp = 10.0,
    .stable_ratio = 0.02,
    .grad_clip = 1.0,
};

test "PG config fits 16MB budget" {
    assert(TrinityPGConfig_fitsBudget(TEST_CONFIG, 16.0) == true);
}

test "PG config all dims are 3^k" {
    assert(TrinityPGConfig_allDimsPowerOf3(TEST_CONFIG) == true);
}

test "PG config square attention holds" {
    assert(TrinityPGConfig_squareAttentionHolds(TEST_CONFIG) == true);
    assert(TEST_CONFIG.context_len % TEST_CONFIG.head_dim == 0);
}

test "PG config validate passes" {
    // Note: validate function has undefined body in T27 port
    // The original would validate but we port the decision logic in other functions
}

test "PG config model size under 16MB" {
    const size_mb = TrinityPGConfig_modelSizeMB(TEST_CONFIG);
    assert(size_mb > 0.0);
    assert(size_mb <= 16.0);
}

test "isPowerOf3" {
    assert(isPowerOf3(1) == true);
    assert(isPowerOf3(3) == true);
    assert(isPowerOf3(9) == true);
    assert(isPowerOf3(27) == true);
    assert(isPowerOf3(81) == true);
    assert(isPowerOf3(243) == true);
    assert(isPowerOf3(729) == true);
    assert(isPowerOf3(2) == false);
    assert(isPowerOf3(4) == false);
    assert(isPowerOf3(0) == false);
    assert(isPowerOf3(10) == false);
}

test "PG config detailed size breakdown" {
    const cfg = TEST_CONFIG;
    const embedding = cfg.vocab_size * cfg.embed_dim;
    const per_block = 4 * cfg.embed_dim * cfg.embed_dim + 3 * cfg.embed_dim * cfg.ffn_hidden;
    const all_blocks = cfg.num_blocks * per_block;
    const lm_head = cfg.vocab_size * cfg.embed_dim;

    assert(embedding > 0);
    assert(all_blocks > 0);
    assert(lm_head > 0);

    const total = TrinityPGConfig_totalParams(cfg);
    assert(total == embedding + all_blocks + lm_head);
}

test "PG config model size bytes calculation" {
    const cfg = TEST_CONFIG;
    const bytes = TrinityPGConfig_modelSizeBytes(cfg);
    const expected_mb = TrinityPGConfig_modelSizeMB(cfg);
    
    // Verify the relationship between bytes and MB
    assert(bytes == TrinityPGConfig_totalParams(cfg) * cfg.bits_per_weight / 8);
    assert(expected_mb == bytes as f64 / (1024.0 * 1024.0));
}

test "PG config edge cases for fitsBudget" {
    const cfg = TEST_CONFIG;
    
    // Should fit in exactly 16MB (based on original test)
    assert(TrinityPGConfig_fitsBudget(cfg, 16.0) == true);
    
    // Should not fit in less than actual size
    assert(TrinityPGConfig_fitsBudget(cfg, 1.0) == false);
    
    // Should fit in much larger budget
    assert(TrinityPGConfig_fitsBudget(cfg, 100.0) == true);
}