// Port of gHashTag/trinity src/tri/math/parameter_golf_config.zig
// (at 341f1d150c70) so the hand-written Zig is generated from this .t27
// instead (roadmap stage 5, goal #4547; task t27#9309).
//
// Every function in the original is a pure decision over a config record:
// there is no file, network, clock or process anywhere in it, so all eight
// bodies are ported in full and none is a stub. The one construct .t27 has
// no shape for is Zig's error union: `validate` returned `!void` and threw
// error.NonPowerOf3Dimension, error.SquareAttentionViolation,
// error.ExceedsBudget and error.WrongVocabSize. Its decision is kept as a
// verdict function returning an i32 code, one named constant per Zig error,
// with 0 meaning valid - the same shape the passing port
// specs/port/tools/check_fix_carries_source.t27 uses for its verdicts.

module port::trinity::tri::math::parameter_golf_config;

pub struct TrinityPGConfig {
    vocab_size: usize,
    embed_dim: usize,
    hidden_dim: usize,
    context_len: usize,
    num_blocks: usize,
    num_heads: usize,
    head_dim: usize,
    ffn_hidden: usize,
    bits_per_weight: usize,
    batch_size: usize,
    lr: f64,
    lr_min: f64,
    lamb_clamp: f64,
    stable_ratio: f64,
    grad_clip: f64,
}

// Zig: pub const PG_CONFIG = TrinityPGConfig{ ... };
// lr 3e-4 is written 0.0003 and lr_min 1e-5 is written 0.00001: same values.
pub const PG_CONFIG: TrinityPGConfig = TrinityPGConfig { vocab_size: 729, embed_dim: 243, hidden_dim: 729, context_len: 81, num_blocks: 9, num_heads: 9, head_dim: 27, ffn_hidden: 729, bits_per_weight: 2, batch_size: 66, lr: 0.0003, lr_min: 0.00001, lamb_clamp: 10.0, stable_ratio: 0.02, grad_clip: 1.0 };

// Verdict codes for TrinityPGConfig_validate, one per Zig error, 0 = valid.
pub const VALIDATE_OK: i32 = 0;
pub const VALIDATE_NON_POWER_OF3: i32 = 1;
pub const VALIDATE_SQUARE_ATTENTION: i32 = 2;
pub const VALIDATE_EXCEEDS_BUDGET: i32 = 3;
pub const VALIDATE_WRONG_VOCAB: i32 = 4;

// Zig line 85: fn isPowerOf3(n: usize) bool
fn isPowerOf3(n: usize) -> bool {
    if (n == 0) {
        return false;
    }
    var v: usize = n;
    while (v % 3 == 0) {
        v = v / 3;
    }
    return v == 1;
}

// Zig line 40: pub fn totalParams(self: TrinityPGConfig) usize
pub fn TrinityPGConfig_totalParams(config: TrinityPGConfig) -> usize {
    const embedding: usize = config.vocab_size * config.embed_dim;
    const per_block_attn: usize = 4 * config.embed_dim * config.embed_dim;
    const per_block_ffn: usize = 3 * config.embed_dim * config.ffn_hidden;
    const per_block: usize = per_block_attn + per_block_ffn;
    const all_blocks: usize = config.num_blocks * per_block;
    const lm_head: usize = config.vocab_size * config.embed_dim;
    return embedding + all_blocks + lm_head;
}

// Zig line 50: pub fn modelSizeBytes(self: TrinityPGConfig) usize
pub fn TrinityPGConfig_modelSizeBytes(config: TrinityPGConfig) -> usize {
    return TrinityPGConfig_totalParams(config) * config.bits_per_weight / 8;
}

// Zig line 54: pub fn modelSizeMB(self: TrinityPGConfig) f64
pub fn TrinityPGConfig_modelSizeMB(config: TrinityPGConfig) -> f64 {
    return (TrinityPGConfig_modelSizeBytes(config) as f64) / (1024.0 * 1024.0);
}

// Zig line 58: pub fn fitsBudget(self: TrinityPGConfig, budget_mb: f64) bool
pub fn TrinityPGConfig_fitsBudget(config: TrinityPGConfig, budget_mb: f64) -> bool {
    return TrinityPGConfig_modelSizeMB(config) <= budget_mb;
}

// Zig line 62: pub fn allDimsPowerOf3(self: TrinityPGConfig) bool - checks
// exactly vocab_size, embed_dim, context_len, num_blocks, num_heads,
// head_dim and ffn_hidden; hidden_dim and batch_size are not among them.
pub fn TrinityPGConfig_allDimsPowerOf3(config: TrinityPGConfig) -> bool {
    return isPowerOf3(config.vocab_size) and isPowerOf3(config.embed_dim) and isPowerOf3(config.context_len) and isPowerOf3(config.num_blocks) and isPowerOf3(config.num_heads) and isPowerOf3(config.head_dim) and isPowerOf3(config.ffn_hidden);
}

// Zig line 72: pub fn squareAttentionHolds(self: TrinityPGConfig) bool
pub fn TrinityPGConfig_squareAttentionHolds(config: TrinityPGConfig) -> bool {
    if (config.context_len % config.head_dim != 0) {
        return false;
    }
    return isPowerOf3(config.context_len / config.head_dim);
}

// Zig line 77: pub fn validate(self: TrinityPGConfig) !void. The Zig error
// union becomes an i32 verdict, checked in the same order the original
// throws: NonPowerOf3Dimension, SquareAttentionViolation, ExceedsBudget,
// WrongVocabSize.
pub fn TrinityPGConfig_validate(config: TrinityPGConfig) -> i32 {
    if (!TrinityPGConfig_allDimsPowerOf3(config)) {
        return VALIDATE_NON_POWER_OF3;
    }
    if (!TrinityPGConfig_squareAttentionHolds(config)) {
        return VALIDATE_SQUARE_ATTENTION;
    }
    if (!TrinityPGConfig_fitsBudget(config, 16.0)) {
        return VALIDATE_EXCEEDS_BUDGET;
    }
    if (config.vocab_size != 729) {
        return VALIDATE_WRONG_VOCAB;
    }
    return VALIDATE_OK;
}

// Test helper: the shipped config with a few dims overridden, so tests can
// name a bad shape without mutating anything.
fn variant(vocab: usize, embed: usize, hidden: usize, head_dim: usize, bits: usize) -> TrinityPGConfig {
    return TrinityPGConfig { vocab_size: vocab, embed_dim: embed, hidden_dim: hidden, context_len: 81, num_blocks: 9, num_heads: 9, head_dim: head_dim, ffn_hidden: 729, bits_per_weight: bits, batch_size: 66, lr: 0.0003, lr_min: 0.00001, lamb_clamp: 10.0, stable_ratio: 0.02, grad_clip: 1.0 };
}

// --- tests -----------------------------------------------------------------
// The original's seven test blocks are ported by name and behaviour, plus
// one test per validate verdict so every branch is asserted (FR-004).

test "PG config fits 16MB budget" {
    // Original test: the shipped config fits a 16 MB budget; both sides of
    // the <= decision are pinned.
    assert(TrinityPGConfig_fitsBudget(PG_CONFIG, 16.0) == true);
    assert(TrinityPGConfig_fitsBudget(PG_CONFIG, 2.0) == true);
    assert(TrinityPGConfig_fitsBudget(PG_CONFIG, 1.0) == false);
}

test "PG config all dims are 3^k" {
    // Original test, plus a dim that is not 3^k, plus the original's exact
    // dim list: hidden_dim is not among the checked dims.
    assert(TrinityPGConfig_allDimsPowerOf3(PG_CONFIG) == true);
    assert(TrinityPGConfig_allDimsPowerOf3(variant(729, 244, 729, 27, 2)) == false);
    assert(TrinityPGConfig_allDimsPowerOf3(variant(729, 243, 100, 27, 2)) == true);
}

test "PG config square attention holds" {
    // Original test: context_len 81 / head_dim 27 = 3^1.
    assert(TrinityPGConfig_squareAttentionHolds(PG_CONFIG) == true);
    assert(PG_CONFIG.context_len % PG_CONFIG.head_dim == 0);
    assert(TrinityPGConfig_squareAttentionHolds(variant(729, 243, 729, 243, 2)) == false);
}

test "PG config validate passes" {
    // Original test: the shipped config is valid.
    assert(TrinityPGConfig_validate(PG_CONFIG) == VALIDATE_OK);
}

test "PG config validate rejects a dimension that is not 3^k" {
    // Zig: error.NonPowerOf3Dimension - first check in validate's order.
    assert(TrinityPGConfig_validate(variant(729, 100, 729, 27, 2)) == VALIDATE_NON_POWER_OF3);
}

test "PG config validate rejects a square attention violation" {
    // Zig: error.SquareAttentionViolation - all dims stay 3^k, but
    // 81 % 243 != 0, so the square attention invariant breaks.
    assert(TrinityPGConfig_validate(variant(729, 243, 729, 243, 2)) == VALIDATE_SQUARE_ATTENTION);
}

test "PG config validate rejects an over-budget config" {
    // Zig: error.ExceedsBudget - 32 bits per weight puts the same model at
    // 29,052,108 bytes, about 27.7 MB.
    assert(TrinityPGConfig_validate(variant(729, 243, 729, 27, 32)) == VALIDATE_EXCEEDS_BUDGET);
}

test "PG config validate rejects a wrong vocab size" {
    // Zig: error.WrongVocabSize - vocab 243 is 3^5, so every earlier check
    // passes before the vocab check fires.
    assert(TrinityPGConfig_validate(variant(243, 243, 729, 27, 2)) == VALIDATE_WRONG_VOCAB);
}

test "PG config model size under 16MB" {
    // Original test: 1,815,756 bytes is about 1.73 MB.
    const size_mb = TrinityPGConfig_modelSizeMB(PG_CONFIG);
    assert(size_mb > 0.0);
    assert(size_mb <= 16.0);
    assert(size_mb > 1.7);
    assert(size_mb < 1.8);
}

test "isPowerOf3" {
    // Original test: every 3^k up to the vocab size, and rejections.
    assert(isPowerOf3(1) == true);
    assert(isPowerOf3(3) == true);
    assert(isPowerOf3(9) == true);
    assert(isPowerOf3(27) == true);
    assert(isPowerOf3(81) == true);
    assert(isPowerOf3(243) == true);
    assert(isPowerOf3(729) == true);
    assert(isPowerOf3(2) == false);
    assert(isPowerOf3(4) == false);
    assert(isPowerOf3(0) == false);
    assert(isPowerOf3(10) == false);
}

test "PG config detailed size breakdown" {
    // Original test, with the exact counts pinned: 7,263,027 parameters.
    const embedding: usize = PG_CONFIG.vocab_size * PG_CONFIG.embed_dim;
    const per_block: usize = 4 * PG_CONFIG.embed_dim * PG_CONFIG.embed_dim + 3 * PG_CONFIG.embed_dim * PG_CONFIG.ffn_hidden;
    const all_blocks: usize = PG_CONFIG.num_blocks * per_block;
    const lm_head: usize = PG_CONFIG.vocab_size * PG_CONFIG.embed_dim;
    assert(embedding == 177147);
    assert(per_block == 767637);
    assert(all_blocks == 6908733);
    assert(lm_head == 177147);
    assert(TrinityPGConfig_totalParams(PG_CONFIG) == embedding + all_blocks + lm_head);
    assert(TrinityPGConfig_totalParams(PG_CONFIG) == 7263027);
}

test "PG config model size bytes calculation" {
    // bytes = params * bits / 8, truncated: 7263027 * 2 / 8 = 1815756
    // (remainder 6), and 7263027 * 1 / 8 = 907878 (remainder 3).
    assert(TrinityPGConfig_modelSizeBytes(PG_CONFIG) == 1815756);
    assert(TrinityPGConfig_modelSizeBytes(variant(729, 243, 729, 27, 1)) == 907878);
    const expected_mb = TrinityPGConfig_modelSizeMB(PG_CONFIG);
    assert(expected_mb == (TrinityPGConfig_modelSizeBytes(PG_CONFIG) as f64) / (1024.0 * 1024.0));
}

test "PG config shipped constant carries its fields" {
    // The shipped PG_CONFIG constant sets every field the original sets.
    assert(PG_CONFIG.vocab_size == 729);
    assert(PG_CONFIG.embed_dim == 243);
    assert(PG_CONFIG.hidden_dim == 729);
    assert(PG_CONFIG.context_len == 81);
    assert(PG_CONFIG.num_blocks == 9);
    assert(PG_CONFIG.num_heads == 9);
    assert(PG_CONFIG.head_dim == 27);
    assert(PG_CONFIG.ffn_hidden == 729);
    assert(PG_CONFIG.bits_per_weight == 2);
    assert(PG_CONFIG.batch_size == 66);
    assert(PG_CONFIG.lr == 0.0003);
    assert(PG_CONFIG.lr_min == 0.00001);
    assert(PG_CONFIG.lamb_clamp == 10.0);
    assert(PG_CONFIG.stable_ratio == 0.02);
    assert(PG_CONFIG.grad_clip == 1.0);
    // The variant helper stays in sync with the constant it overrides.
    const same = variant(729, 243, 729, 27, 2);
    assert(same.vocab_size == PG_CONFIG.vocab_size);
    assert(same.embed_dim == PG_CONFIG.embed_dim);
    assert(same.hidden_dim == PG_CONFIG.hidden_dim);
    assert(same.context_len == PG_CONFIG.context_len);
    assert(same.num_blocks == PG_CONFIG.num_blocks);
    assert(same.num_heads == PG_CONFIG.num_heads);
    assert(same.head_dim == PG_CONFIG.head_dim);
    assert(same.ffn_hidden == PG_CONFIG.ffn_hidden);
    assert(same.bits_per_weight == PG_CONFIG.bits_per_weight);
    assert(same.batch_size == PG_CONFIG.batch_size);
    assert(same.lr == PG_CONFIG.lr);
    assert(same.lr_min == PG_CONFIG.lr_min);
    assert(same.lamb_clamp == PG_CONFIG.lamb_clamp);
    assert(same.stable_ratio == PG_CONFIG.stable_ratio);
    assert(same.grad_clip == PG_CONFIG.grad_clip);
}
