// Port of gHashTag/trinity src/tri/cytoplasm_registry.zig (five functions)
// to .t27, so the registry CLI is generated instead of hand-maintained.
//
// Shape of the port: every decision the original makes lives in a pure
// function below, and the tests exercise those. What the original does to
// the world - std.debug.print, reading and writing files under data/cells/,
// the clock behind the backup timestamp - stays with the caller. The five
// entry points keep their original names, but their bodies are `undefined;`
// and no test calls one: each of them only prints, reads a file or names a
// backup from the clock, and none of that is a decision.
//
// What could not be carried over:
//   - printing (runRegistry's help and unknown-subcommand lines, runValidate's
//     cells/FAIL lines, runRepair's not-implemented line, runBackup's DONE,
//     runListBackups' listing): the caller prints from the codes and structs
//     these helpers return
//   - file I/O (opening data/cells/registry.json, making the backup
//     directory, listing the backup directory): std.fs plumbing is the
//     caller's job; the 262144-byte read cap is kept as a decision
//   - the clock (std.time.timestamp for the backup name): the caller's input
//   - std.json parsing: the caller parses; validate_registry takes what the
//     parser saw as bools and a count
//   - string concatenation: the backup name is carried as its prefix and
//     suffix instead of "registry-{s}.json"
//
// Map from the original:
//   runRegistry     -> registry_action, dispatch, action_code
//   runValidate     -> validate_registry, read_fits, REGISTRY_MAX_BYTES
//   runRepair       -> repair_implemented
//   runBackup       -> backup_dir, backup_name_prefix, backup_name_suffix,
//                      looks_like_backup_name, is_backup_dir, read_fits
//   runListBackups  -> is_backup_entry, count_backups, DirEntry
//   starts_with / ends_with spell out the std.mem.eql / std.mem.startsWith
//   byte comparisons the original inlines.

module port::trinity::src::tri;

// ------------------------------------------------------------------
// runRegistry (original line 14)
// ------------------------------------------------------------------

// What runRegistry would do next. Help is the empty-tail help screen;
// Unknown is the unknown-subcommand error path.
pub enum Action { Help, Validate, Repair, Backup, List, Unknown, }

// The dispatch table: an exact match on the first argument selects the
// subcommand; anything else is the Unknown path. The original compares
// with std.mem.eql; here one side is a literal.
pub fn dispatch(sub: []const u8) -> Action {
    if (sub == "validate") {
        return Action.Validate;
    }
    if (sub == "repair") {
        return Action.Repair;
    }
    if (sub == "backup") {
        return Action.Backup;
    }
    if (sub == "list") {
        return Action.List;
    }
    return Action.Unknown;
}

// The original looks at args.len before args[0]: an empty command tail
// means help, whatever the rest held. The original also slices args[1..]
// into `rest` and hands it to runBackup, which discards it, so nothing
// else depends on the tail.
pub fn registry_action(argc: usize, sub: []const u8) -> Action {
    if (argc == 0) {
        return Action.Help;
    }
    return dispatch(sub);
}

// The action as a number, the shape a caller switches on when it does the
// printing runRegistry used to do.
pub fn action_code(a: Action) -> i32 {
    let code: i32 = switch (a) { .Help => 0, .Validate => 1, .Repair => 2, .Backup => 3, .List => 4, .Unknown => 5, };
    return code;
}

// ------------------------------------------------------------------
// runValidate (original line 34)
// ------------------------------------------------------------------

// registry.json is read with a 262144-byte cap (runValidate and runBackup
// both pass it), so a larger file cannot be read and both commands report
// FAIL.
pub const REGISTRY_MAX_BYTES: usize = 262144;

// The read succeeds only within the cap; the edges are the point.
pub fn read_fits(size: usize) -> bool {
    return size <= REGISTRY_MAX_BYTES;
}

// What runValidate concludes about a parsed registry:
//   - no 'cells' key: one issue, then the FAIL line
//   - 'cells' present but not an array: an ERROR line and an early
//     return, so neither PASS nor FAIL is printed (aborted)
//   - 'cells' an array: "{d} cells found", then PASS when issues == 0
pub struct ValidateVerdict {
    pass: bool,
    issues: i32,
    cell_count: usize,
    aborted: bool,
}

pub fn validate_registry(has_cells: bool, cells_is_array: bool, cell_count: usize) -> ValidateVerdict {
    if (has_cells) {
        if (!cells_is_array) {
            return ValidateVerdict { pass: false, issues: 0, cell_count: 0, aborted: true };
        }
        return ValidateVerdict { pass: true, issues: 0, cell_count: cell_count, aborted: false };
    }
    return ValidateVerdict { pass: false, issues: 1, cell_count: 0, aborted: false };
}

// ------------------------------------------------------------------
// runRepair (original line 73)
// ------------------------------------------------------------------

// The original prints "Repair not implemented yet" and does nothing else.
// The fact that repair has no behaviour is the decision here.
pub fn repair_implemented() -> bool {
    return false;
}

// ------------------------------------------------------------------
// runBackup (original line 79)
// ------------------------------------------------------------------

// The original discards its extra arguments: backup takes no options. It
// then builds the destination and copies the bytes: this directory, a file
// named from this prefix, the timestamp and this suffix, then the exact
// bytes of registry.json. The timestamp is the caller's clock
// (std.time.timestamp), so it arrives as part of the name, not from a
// helper here.

pub fn backup_dir() -> []const u8 {
    return "data/cells/backups";
}

pub fn backup_name_prefix() -> []const u8 {
    return "registry-";
}

pub fn backup_name_suffix() -> []const u8 {
    return ".json";
}

// The decision inside the backup name format: a finished backup name is
// the prefix, a timestamp, then the suffix. A name with nothing between
// the parts is not one the backup step wrote.
pub fn looks_like_backup_name(name: []const u8) -> bool {
    if (!starts_with(name, backup_name_prefix())) {
        return false;
    }
    return ends_with(name, backup_name_suffix());
}

// The backup directory constant, checked against a caller's path.
pub fn is_backup_dir(path: []const u8) -> bool {
    return path == "data/cells/backups";
}

// ------------------------------------------------------------------
// runListBackups (original line 107)
// ------------------------------------------------------------------

// The std.mem.startsWith(u8, ...) of the listing filter, byte by byte.
pub fn starts_with(name: []const u8, prefix: []const u8) -> bool {
    if (name.len < prefix.len) {
        return false;
    }
    var i: usize = 0;
    while (i < prefix.len) {
        if (name[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The ".json" tail of the name runBackup writes.
pub fn ends_with(name: []const u8, suffix: []const u8) -> bool {
    if (name.len < suffix.len) {
        return false;
    }
    var i: usize = 0;
    while (i < suffix.len) {
        if (name[name.len - suffix.len + i] != suffix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// One directory entry, as the iterator yields it: the kind the original
// tests against .file, here as a bool, and the name.
pub struct DirEntry {
    is_file: bool,
    name: []const u8,
}

// An entry is listed and counted when it is a file whose name starts with
// "registry-". No suffix is checked here - the original would list a file
// called exactly "registry-".
pub fn is_backup_entry(is_file: bool, name: []const u8) -> bool {
    if (!is_file) {
        return false;
    }
    return starts_with(name, backup_name_prefix());
}

// The listing loop: walk the entries, count what gets listed.
pub fn count_backups(entries: []DirEntry) -> usize {
    var count: usize = 0;
    for e in entries {
        if (is_backup_entry(e.is_file, e.name)) {
            count += 1;
        }
    }
    return count;
}

// ------------------------------------------------------------------
// The five entry points, in their original order.
//
// Each one only prints, reads or writes files, or reads the clock in the
// original - plumbing the caller owns - so each keeps its name with an
// `undefined;` body that no test calls. The allocator is the caller's
// (usize is the .t27 stand-in for std.mem.Allocator); runRegistry and
// runBackup also take the command tail, which the helpers above decide on.
// ------------------------------------------------------------------

pub fn runRegistry(allocator: usize, args: []str) { undefined; }

fn runValidate(allocator: usize) { undefined; }

fn runRepair(allocator: usize) { undefined; }

fn runBackup(allocator: usize, args: []str) { undefined; }

fn runListBackups(allocator: usize) { undefined; }

// ------------------------------------------------------------------
// Tests
// ------------------------------------------------------------------

test dispatch_known_subcommands {
    assert(action_code(dispatch("validate")) == 1);
    assert(action_code(dispatch("repair")) == 2);
    assert(action_code(dispatch("backup")) == 3);
    assert(action_code(dispatch("list")) == 4);
}

test dispatch_unknown_and_near_misses {
    assert(action_code(dispatch("")) == 5);
    assert(action_code(dispatch("Validate")) == 5);
    assert(action_code(dispatch("list ")) == 5);
    assert(action_code(dispatch("registry")) == 5);
}

test registry_action_empty_tail_prints_help {
    assert(action_code(registry_action(0, "")) == 0);
    assert(action_code(registry_action(0, "list")) == 0);
}

test registry_action_first_argument_decides {
    assert(action_code(registry_action(1, "validate")) == 1);
    assert(action_code(registry_action(2, "backup")) == 3);
    assert(action_code(registry_action(3, "nope")) == 5);
}

test validate_registry_verdicts {
    const ok = validate_registry(true, true, 7);
    assert(ok.pass);
    assert(ok.issues == 0);
    assert(ok.cell_count == 7);
    assert(!ok.aborted);

    const no_key = validate_registry(false, false, 0);
    assert(!no_key.pass);
    assert(no_key.issues == 1);
    assert(!no_key.aborted);

    const not_array = validate_registry(true, false, 0);
    assert(!not_array.pass);
    assert(not_array.issues == 0);
    assert(not_array.aborted);
}

test registry_read_cap {
    assert(REGISTRY_MAX_BYTES == 262144);
    assert(read_fits(0));
    assert(read_fits(262144));
    assert(!read_fits(262145));
}

test repair_is_not_implemented {
    assert(!repair_implemented());
}

test backup_destination_and_name {
    assert(is_backup_dir(backup_dir()));
    assert(!is_backup_dir("data/cells"));
    assert(looks_like_backup_name("registry-1750000000.json"));
    assert(!looks_like_backup_name("registry-1750000000.txt"));
    assert(!looks_like_backup_name("registry-"));
    assert(!looks_like_backup_name("1750000000.json"));
}

// The two halves of the line-91 name, directly: a prefix that fits a
// timestamp between it and the suffix, and edges of the byte comparisons.
test backup_name_parts {
    const pfx = backup_name_prefix();
    const sfx = backup_name_suffix();
    assert(pfx.len == 9);
    assert(sfx.len == 5);
    assert(starts_with("registry-1750000000.json", pfx));
    assert(!starts_with("reg", pfx));
    assert(ends_with("registry-1750000000.json", sfx));
    assert(ends_with("1750000000.json", sfx));
    assert(!ends_with("registry-1750000000.txt", sfx));
    assert(!ends_with("x", sfx));
}

test list_backup_filter {
    assert(is_backup_entry(true, "registry-1750000000.json"));
    assert(is_backup_entry(true, "registry-"));
    assert(!is_backup_entry(true, "notes.txt"));
    assert(!is_backup_entry(false, "registry-1750000000.json"));
}

test count_backups_lists_only_backup_files {
    var entries: [4]DirEntry = [
        DirEntry { is_file: true, name: "registry-1750000000.json" },
        DirEntry { is_file: true, name: "notes.txt" },
        DirEntry { is_file: false, name: "registry-1750000600.json" },
        DirEntry { is_file: true, name: "registry-1750001200.json" },
    ];
    assert(count_backups(&entries) == 2);
}
