module port::trinity::src::tri::jsonl_logger;

// Port of gHashTag/trinity:src/tri/jsonl_logger.zig @ 5aabfbe8346f (105 lines).
//
// The original appendEvent(allocator, event) makes sure the .trinity/
// directory exists, then writes exactly one JSON object line for the event
// to .trinity/agent_events.jsonl and appends '\n':
//
//   {"ts":<i64>,"event_type":"<str>","issue":<u32>[,"agent":"<str>"],"ok":true|false}
//
// It appends to the file when it exists and creates it on error.FileNotFound.
// The filesystem work (makePath, openFile/createFile, seekFromEnd, writeAll)
// and the allocator are I/O plumbing: they stay in Zig at the call site and
// appendEvent keeps its name with an undefined; body that no test calls
// (FR-001). The decision the function makes -- how an Event becomes its
// JSONL line -- is ported as pure code below and tested byte-for-byte.
//
// Not ported: string escaping. The original delegates escaping of
// event_type/agent to the print formatter; for the plain identifiers this
// logger records, the escaped form equals the raw form.

pub const EVENTS_PATH: []const u8 = ".trinity/agent_events.jsonl";

// The directory appendEvent creates with makePath before opening the file.
pub const DIR_PATH: []const u8 = ".trinity";

// Callers of render_event_line pass a buffer of this size; the original
// grows an ArrayList instead, which has no equivalent here.
pub const LINE_CAP: usize = 160;

pub const DIGITS: []const u8 = "0123456789";

// One event record, as in the original Event struct. agent mirrors the
// original's optional field: it is written to the line only when set.
pub struct Event {
    ts: i64,
    event_type: []const u8,
    issue: u32,
    agent: ?[]const u8,
    ok: bool,
}

// Port of the original's signature: allocator is an opaque handle standing
// in for std.mem.Allocator, an I/O detail with no .t27 equivalent. The body
// is an undefined; stub per the port rules (file/directory plumbing only);
// no test calls it.
pub fn appendEvent(allocator: usize, event: Event) -> void {
    undefined;
}

// True when the line carries the optional agent field.
pub fn has_agent(event: Event) -> bool {
    return event.agent != null;
}

// Number of JSON fields the line carries: ts, event_type, issue and ok,
// plus agent only when set.
pub fn field_count(event: Event) -> usize {
    if (has_agent(event)) {
        return 5;
    }
    return 4;
}

// Appends s to buf at n and returns the new length.
pub fn put_str(buf: []u8, n0: usize, s: []const u8) -> usize {
    var n = n0;
    var i: usize = 0;
    while (i < s.len) {
        buf[n] = s[i];
        n += 1;
        i += 1;
    }
    return n;
}

// Appends v as a signed decimal, exactly what the original's print format
// {d} writes for an i64 (and for the u32 issue, via the cast below).
pub fn put_i64(buf: []u8, n0: usize, v0: i64) -> usize {
    var n = n0;
    var v = v0;
    if (v < 0) {
        buf[n] = '-';
        n += 1;
        v = -v;
    }
    if (v == 0) {
        buf[n] = '0';
        return n + 1;
    }
    var tmp: [20]u8 = [_]u8{0} ** 20;
    var m: usize = 0;
    var mag: usize = v as usize;
    while (mag > 0) {
        tmp[m] = DIGITS[mag % 10];
        m += 1;
        mag = mag / 10;
    }
    while (m > 0) {
        m -= 1;
        buf[n] = tmp[m];
        n += 1;
    }
    return n;
}

// Renders the exact line appendEvent writes (without the trailing '\n'):
// fields in the original's order, agent only when set, ok as true/false.
pub fn render_event_line(buf: []u8, event: Event) -> usize {
    var n: usize = 0;
    n = put_str(buf, n, "{\"ts\":");
    n = put_i64(buf, n, event.ts);
    n = put_str(buf, n, ",\"event_type\":\"");
    n = put_str(buf, n, event.event_type);
    n = put_str(buf, n, "\",\"issue\":");
    n = put_i64(buf, n, event.issue as i64);
    if (has_agent(event)) {
        n = put_str(buf, n, ",\"agent\":\"");
        n = put_str(buf, n, event.agent.?);
        n = put_str(buf, n, "\"");
    }
    n = put_str(buf, n, ",\"ok\":");
    if (event.ok) {
        n = put_str(buf, n, "true");
    } else {
        n = put_str(buf, n, "false");
    }
    n = put_str(buf, n, "}");
    return n;
}

// Compares the first n bytes of buf against want.
pub fn line_eq(buf: []u8, n: usize, want: []const u8) -> bool {
    if (n != want.len) {
        return false;
    }
    var i: usize = 0;
    while (i < n) {
        if (buf[i] != want[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Elementwise string equality, for tests comparing const strings.
pub fn eq_str(a: []const u8, b: []const u8) -> bool {
    if (a.len != b.len) {
        return false;
    }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

test constants_match_original {
    assert(eq_str(EVENTS_PATH, ".trinity/agent_events.jsonl"));
    assert(eq_str(DIR_PATH, ".trinity"));
    assert(LINE_CAP == 160);
    assert(DIGITS.len == 10);
}

test field_count_matches_agent_presence {
    const with_agent = Event { ts: 1, event_type: "e", issue: 1, agent: "a", ok: true };
    assert(field_count(with_agent) == 5);
    assert(has_agent(with_agent));
    const no_agent = Event { ts: 1, event_type: "e", issue: 1, agent: null, ok: true };
    assert(field_count(no_agent) == 4);
    assert(!has_agent(no_agent));
}

test renders_line_with_agent {
    var buf: [160]u8 = [_]u8{0} ** 160;
    const e = Event { ts: 1234567890, event_type: "test", issue: 42, agent: "test-agent", ok: true };
    const n = render_event_line(&buf, e);
    assert(line_eq(&buf, n, "{\"ts\":1234567890,\"event_type\":\"test\",\"issue\":42,\"agent\":\"test-agent\",\"ok\":true}"));
}

test renders_line_without_agent {
    var buf: [160]u8 = [_]u8{0} ** 160;
    const e = Event { ts: 5, event_type: "tick", issue: 0, agent: null, ok: false };
    const n = render_event_line(&buf, e);
    assert(line_eq(&buf, n, "{\"ts\":5,\"event_type\":\"tick\",\"issue\":0,\"ok\":false}"));
}

test put_str_appends_and_returns_length {
    var buf: [160]u8 = [_]u8{0} ** 160;
    const n = put_str(&buf, 0, "ab");
    assert(line_eq(&buf, n, "ab"));
    const n2 = put_str(&buf, n, "cd");
    assert(line_eq(&buf, n2, "abcd"));
}

test renders_zero_and_negative_integers {
    var buf: [160]u8 = [_]u8{0} ** 160;
    const n = put_i64(&buf, 0, 0);
    assert(line_eq(&buf, n, "0"));
    var buf2: [160]u8 = [_]u8{0} ** 160;
    const n2 = put_i64(&buf2, 0, -7);
    assert(line_eq(&buf2, n2, "-7"));
    var buf3: [160]u8 = [_]u8{0} ** 160;
    const n3 = put_i64(&buf3, 0, 8675309);
    assert(line_eq(&buf3, n3, "8675309"));
}
