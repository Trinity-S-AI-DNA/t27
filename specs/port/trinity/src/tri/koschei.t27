module port::trinity::src::tri::koschei;

// Re-authored from gHashTag/trinity src/tri/koschei.zig (commit 2b7af41c2429):
// one function, runKoscheiCommand, plus one compile-time-only test. The
// original prints a fixed banner - the mandatory 16-step KOSCHEI development
// cycle - to stderr with one std.debug.print call, and takes an allocator it
// never uses. There is no branching and no state: the decision the function
// carries is the banner text itself.
//
// Port shape (L0: port the decision, not the plumbing):
//   - BANNER_LINES holds the banner exactly as the original prints it, split
//     on the newlines between the lines of the original's multiline string:
//     the printed output is these 37 lines joined with '\n'. That string
//     starts and ends with an empty line, so BANNER_LINES[0] and
//     BANNER_LINES[36] are "".
//   - banner_line(i) returns banner line i, and "" past the end.
//   - step_line(n) returns the line index of step n of the 16. The four
//     sections each list 4 steps, and a blank line plus the next header sit
//     between sections, hence 7 + (n - 1) + 2 * ((n - 1) / 4).
//   - runKoscheiCommand keeps the original's name for the plumbing: writing
//     the banner to stderr. Printing is I/O, so its body is undefined; and
//     no test calls it. The original's unused allocator parameter is not
//     carried.
//
// The original repo's own test, koschei_command_exists, was only a
// compile-time existence check; the pub fn below satisfies the same.

pub fn runKoscheiCommand() void {
    undefined;
}

// The banner, line by line, exactly as the original prints it. The two
// title lines keep the original's own (uneven) padding, and the bottom
// border is shorter than the top one, as in the original.
pub const BANNER_LINES: [37][]const u8 = [
    "",
    "+==========================================================+",
    "|           KOSCHEI 16-STEP DEVELOPMENT CYCLE                  |",
    "|           Mandatory Process for All Changes                  |",
    "+================================================+",
    "",
    "SPECIFICATION (Steps 1-4):",
    "  1. Create .tri specification (SINGLE SOURCE OF TRUTH)",
    "  2. Define types (data structures)",
    "  3. Define behaviors (functions)",
    "  4. Add algorithms if needed",
    "",
    "GENERATION (Steps 5-8):",
    "  5. Run: tri gen <spec.tri>",
    "  6. Review generated code",
    "  7. Run tests: zig build test",
    "  8. Fix any issues in SPEC (not generated code!)",
    "",
    "VALIDATION (Steps 9-12):",
    "  9. Run benchmarks",
    "  10. Write critical assessment (honest self-criticism)",
    "  11. Document achievements",
    "  12. Update technology tree",
    "",
    "DEPLOYMENT (Steps 13-16):",
    "  13. Git add & commit",
    "  14. Push to remote",
    "  15. Propose 3 tech tree options for next iteration",
    " 16. Loop back to step 1",
    "",
    "RULES:",
    " - NEVER edit generated code directly",
    " - ALL changes go through .tri specs",
    " - One source of truth = no duplication",
    "",
    "phi^2 + 1/phi^2 = 3 = TRINITY",
    ""
];

pub const BANNER_LINE_COUNT: usize = 37;

// Line i of the banner; "" past the end.
pub fn banner_line(i: usize) -> []const u8 {
    if (i >= BANNER_LINE_COUNT) {
        return "";
    }
    return BANNER_LINES[i];
}

// Line index of step n (1..16) of the cycle. Steps 0 and 17+ do not exist;
// they name the leading blank line.
pub fn step_line(n: usize) -> usize {
    if (n < 1 or n > 16) {
        return 0;
    }
    return 7 + (n - 1) + 2 * ((n - 1) / 4);
}

test "banner opens with a blank line and the title box borders" {
    assert(banner_line(0) == "");
    assert(banner_line(1) == "+==========================================================+");
    assert(banner_line(4) == "+================================================+");
    assert(banner_line(5) == "");
}

test "banner title box carries the original padding" {
    assert(banner_line(2) == "|           KOSCHEI 16-STEP DEVELOPMENT CYCLE                  |");
    assert(banner_line(3) == "|           Mandatory Process for All Changes                  |");
}

test "banner has the four section headers" {
    assert(banner_line(6) == "SPECIFICATION (Steps 1-4):");
    assert(banner_line(12) == "GENERATION (Steps 5-8):");
    assert(banner_line(18) == "VALIDATION (Steps 9-12):");
    assert(banner_line(24) == "DEPLOYMENT (Steps 13-16):");
}

test "banner specification steps 1 to 4" {
    assert(banner_line(step_line(1)) == "  1. Create .tri specification (SINGLE SOURCE OF TRUTH)");
    assert(banner_line(step_line(2)) == "  2. Define types (data structures)");
    assert(banner_line(step_line(3)) == "  3. Define behaviors (functions)");
    assert(banner_line(step_line(4)) == "  4. Add algorithms if needed");
}

test "banner generation steps 5 to 8" {
    assert(banner_line(step_line(5)) == "  5. Run: tri gen <spec.tri>");
    assert(banner_line(step_line(6)) == "  6. Review generated code");
    assert(banner_line(step_line(7)) == "  7. Run tests: zig build test");
    assert(banner_line(step_line(8)) == "  8. Fix any issues in SPEC (not generated code!)");
}

test "banner validation steps 9 to 12" {
    assert(banner_line(step_line(9)) == "  9. Run benchmarks");
    assert(banner_line(step_line(10)) == "  10. Write critical assessment (honest self-criticism)");
    assert(banner_line(step_line(11)) == "  11. Document achievements");
    assert(banner_line(step_line(12)) == "  12. Update technology tree");
}

test "banner deployment steps 13 to 16" {
    assert(banner_line(step_line(13)) == "  13. Git add & commit");
    assert(banner_line(step_line(14)) == "  14. Push to remote");
    assert(banner_line(step_line(15)) == "  15. Propose 3 tech tree options for next iteration");
    assert(banner_line(step_line(16)) == " 16. Loop back to step 1");
}

test "banner rules and trinity identity" {
    assert(banner_line(30) == "RULES:");
    assert(banner_line(31) == " - NEVER edit generated code directly");
    assert(banner_line(32) == " - ALL changes go through .tri specs");
    assert(banner_line(33) == " - One source of truth = no duplication");
    assert(banner_line(35) == "phi^2 + 1/phi^2 = 3 = TRINITY");
}

test "step_line locates each of the sixteen steps" {
    assert(step_line(1) == 7);
    assert(step_line(4) == 10);
    assert(step_line(5) == 13);
    assert(step_line(8) == 16);
    assert(step_line(9) == 19);
    assert(step_line(12) == 22);
    assert(step_line(13) == 25);
    assert(step_line(16) == 28);
    assert(step_line(0) == 0);
    assert(step_line(17) == 0);
}

test "banner_line_count is 37 and banner_line is empty past the end" {
    assert(BANNER_LINE_COUNT == 37);
    assert(banner_line(36) == "");
    assert(banner_line(37) == "");
    assert(banner_line(999) == "");
}
