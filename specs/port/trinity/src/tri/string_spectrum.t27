// t27/specs/port/trinity/src/tri/string_spectrum.t27
// Port of gHashTag/trinity src/tri/string_spectrum.zig (c6224a889450, 98 lines).
//
// String Spectrum: the vibrational modes of the string. Every mode is a
// frequency anchored to concert A (440.0), a mode number n, and a
// bosonic/fermionic flag.
//
//   bosonic:      omega = base * sqrt(n)
//   fermionic:    omega = base * sqrt(n + 1/2)      (half-integer shift)
//   phi-harmonic: omega * phi^(1/12)                (golden chromatic step)
//
// Decisions carried over from the original, and where they live now:
//   - SacredConstants.PHI: cross-module `use` does not resolve yet (#4298),
//     so the golden ratio is declared here, with the same digits.
//   - Zig's @sqrt and std.math.pow(f64, PHI, 1.0/12.0): ported as the pure
//     helpers sqrt_f64 and golden_chromatic_step below, so the file depends
//     on no stdlib and generates to Zig, C and Rust alike.
//   - The struct field defaults of the original (frequency = 440.0,
//     mode_number = 0, fermionic = false) are dropped: every mode is built
//     through VibrationalMode_init, which sets all three fields.

module port::string_spectrum;

// SacredConstants.PHI, the golden ratio.
const PHI: f64 = 1.6180339887498949;

pub struct VibrationalMode {
    frequency: f64,
    mode_number: u32,
    fermionic: bool,
}

// @sqrt by Newton's method. Negative input never reaches this from the
// modes below (n >= 0 always), so 0.0 is a safe floor, not a decision.
fn sqrt_f64(x: f64) -> f64 {
    if (x <= 0.0) {
        return 0.0;
    }
    var guess: f64 = x;
    var i: u32 = 0;
    while (i < 80) {
        guess = (guess + x / guess) / 2.0;
        i += 1;
    }
    return guess;
}

// Absolute value, for the tolerance asserts below (the original writes @abs).
fn abs_f64(x: f64) -> f64 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

// std.math.pow(f64, PHI, 1.0 / 12.0) -- the 12th root of phi, one golden
// chromatic step. Newton's method on y^12 = PHI: y <- (11y + PHI/y^11) / 12.
fn golden_chromatic_step() -> f64 {
    var y: f64 = 1.0;
    var i: u32 = 0;
    while (i < 80) {
        var y11: f64 = 1.0;
        var k: u32 = 0;
        while (k < 11) {
            y11 = y11 * y;
            k += 1;
        }
        y = (11.0 * y + PHI / y11) / 12.0;
        i += 1;
    }
    return y;
}

// Construct a vibrational mode. Bosonic: freq = base * sqrt(n).
// Fermionic: freq = base * sqrt(n + 0.5).  n=0 bosonic -> frequency 0.
// The label is discarded by the original (`_ = name;`): a mode's name is
// never part of the physics, so it never reaches the result here either.
pub fn VibrationalMode_init(n: u32, name: []const u8, fermionic: bool) -> VibrationalMode {
    _ = name;
    const base: f64 = 440.0; // concert A anchor
    const nf: f64 = n as f64;
    const effective_n: f64 = if (fermionic) nf + 0.5 else nf;
    const freq: f64 = base * sqrt_f64(effective_n);
    const mode: VibrationalMode = VibrationalMode { frequency: freq, mode_number: n, fermionic: fermionic };
    return mode;
}

// phi-harmonic: raise the frequency by one golden chromatic step phi^(1/12).
pub fn VibrationalMode_phiHarmonic(self: VibrationalMode) -> f64 {
    return self.frequency * golden_chromatic_step();
}

// Mass^2 in string tension units: n - a, with a = 0 bosonic, 1/2 fermionic.
// The n=0 fermionic mode carries m^2 = -0.5 -- a tachyon.
pub fn VibrationalMode_massSquared(self: VibrationalMode) -> f64 {
    const nf: f64 = self.mode_number as f64;
    return if (self.fermionic) nf - 0.5 else nf;
}

// Is this a massless mode? Only the bosonic ground state: the n=0 fermionic
// mode has negative mass squared and is excluded.
pub fn VibrationalMode_isMassless(self: VibrationalMode) -> bool {
    return self.mode_number == 0 and !self.fermionic;
}

// ==================================================================
// Tests
// ==================================================================

test ground_state_bosonic_is_massless {
    const m = VibrationalMode_init(0, "ground", false);
    assert(m.frequency == 0.0);
    assert(VibrationalMode_isMassless(m));
    assert(VibrationalMode_massSquared(m) == 0.0);
}

test first_excited_bosonic_mode {
    const m = VibrationalMode_init(1, "breathing", false);
    // freq = 440 * sqrt(1) = 440
    assert(abs_f64(m.frequency - 440.0) < 1e-10);
    assert(VibrationalMode_massSquared(m) == 1.0);
    assert(!VibrationalMode_isMassless(m));
}

test fermionic_half_integer_shift {
    const m = VibrationalMode_init(0, "fermion_ground", true);
    // freq = 440 * sqrt(0.5) = 311.1269837220809...
    assert(abs_f64(m.frequency - 440.0 * sqrt_f64(0.5)) < 1e-10);
    assert(abs_f64(m.frequency - 311.1269837220809) < 1e-9);
    assert(!VibrationalMode_isMassless(m));
    // m^2 = 0 - 0.5 = -0.5: tachyonic.
    assert(abs_f64(VibrationalMode_massSquared(m) + 0.5) < 1e-10);
}

test higher_mode_frequency_scales_as_sqrt_n {
    const m4 = VibrationalMode_init(4, "n4", false);
    // freq = 440 * sqrt(4) = 880
    assert(abs_f64(m4.frequency - 880.0) < 1e-10);
}

test phi_harmonic_raises_by_golden_chromatic_step {
    const m = VibrationalMode_init(1, "test", false);
    const ph = VibrationalMode_phiHarmonic(m);
    // 440 * phi^(1/12) = 458.0029899...
    assert(abs_f64(ph - 458.0029899) < 1e-6);
    // phi^(1/12) > 1, so the phi-harmonic is always higher.
    assert(ph > m.frequency);
}

test phi_squared_plus_inverse_is_three {
    // The original closes on: phi^2 + 1/phi^2 = 3 = TRINITY.
    assert(abs_f64(PHI * PHI + 1.0 / (PHI * PHI) - 3.0) < 1e-9);
}

test sqrt_f64_basics {
    assert(sqrt_f64(0.0) == 0.0);
    assert(sqrt_f64(1.0) == 1.0);
    assert(abs_f64(sqrt_f64(2.0) - 1.4142135623730951) < 1e-12);
    assert(abs_f64(sqrt_f64(0.5) - 0.7071067811865476) < 1e-12);
}

test abs_f64_basics {
    assert(abs_f64(3.5) == 3.5);
    assert(abs_f64(0.0 - 3.5) == 3.5);
    assert(abs_f64(0.0) == 0.0);
}

test golden_chromatic_step_value {
    // phi^(1/12) = 1.0409158862..., above 1, so the step always raises.
    const step = golden_chromatic_step();
    assert(step > 1.0);
    assert(abs_f64(step - 1.0409158862) < 1e-9);
}
