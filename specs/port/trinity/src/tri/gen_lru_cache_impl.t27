// Port of gHashTag/trinity src/tri/gen_lru_cache_impl.zig (126 lines at
// df620a2b9b43): an LRU cache carried by a hash map and a doubly-linked
// list of heap-allocated LRUNode headers.
//
// The decisions move here; the plumbing stays behind. The allocator and the
// heap nodes become a fixed backing store: the linked list is prev/next
// indices into one node array, where index 0 is the head sentinel, index 1
// the tail sentinel, and NO_INDEX stands for the original's null ?*LRUNode.
// The hash map becomes a used-flag scan (LRUCache_findSlot). capacity stays
// a runtime argument, exactly as in the original's init. Where the original
// mutates through *LRUCache, these functions take the cache by value and
// return the cache as they leave it, so a test reads like the original's
// statement sequence.

module port::trinity::src::tri::gen_lru_cache_impl;

const HEAD: usize = 0;        // the original's cache.list_head sentinel
const TAIL: usize = 1;        // the original's cache.list_tail sentinel
const FIRST_SLOT: usize = 2;  // first data slot after the two sentinels
const NO_INDEX: usize = 8;    // one past the last slot: the original's null ?*LRUNode

struct LRUNode {
    key: usize,
    value: i64,
    used: bool,    // the slot carries a live entry: membership in the original's map
    prev: usize,   // index of the previous node in the list, NO_INDEX when none
    next: usize,   // index of the next node in the list, NO_INDEX when none
}

struct LRUCache {
    capacity: usize,
    count: usize,        // live entries; the original's cache.map.count()
    nodes: [8]LRUNode,   // [0] head sentinel, [1] tail sentinel, [2..7] data slots
}

// The original's get returns ?i64. A hit arrives as found=true with the
// entry's value; a miss arrives as found=false, the original's null.
struct Lookup {
    found: bool,
    value: i64,
}

// The original's cache.map.get(key): scan the data slots for a live slot
// carrying this key; NO_INDEX on a miss.
fn LRUCache_findSlot(cache: LRUCache, key: usize) -> usize {
    var i: usize = FIRST_SLOT;
    while (i < NO_INDEX) {
        if (cache.nodes[i].used and cache.nodes[i].key == key) {
            return i;
        }
        i += 1;
    }
    return NO_INDEX;
}

// The original allocates a fresh node from the allocator (put, line 69);
// a put here takes the first free slot of the fixed store, NO_INDEX when
// the store is full.
fn LRUCache_freeSlot(cache: LRUCache) -> usize {
    var i: usize = FIRST_SLOT;
    while (i < NO_INDEX) {
        if (!cache.nodes[i].used) {
            return i;
        }
        i += 1;
    }
    return NO_INDEX;
}

// Original line 20: pub fn init(allocator, capacity) !LRUCache. Creates the
// two sentinel nodes, links head->tail (original lines 27-28), and returns
// an empty cache with the caller's capacity. There is no allocator to fail,
// so the error union is gone.
fn LRUCache_init(capacity: usize) -> LRUCache {
    var cache: LRUCache = LRUCache {
        capacity: capacity,
        count: 0,
        nodes: [
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
            LRUNode { key: 0, value: 0, used: false, prev: NO_INDEX, next: NO_INDEX },
        ],
    };
    cache.nodes[HEAD].next = TAIL;
    cache.nodes[TAIL].prev = HEAD;
    return cache;
}

// Original line 40: fn removeNode(_: *LRUCache, node: *LRUNode) void.
// Unlinks node from the list: each neighbour's link that pointed at node
// now points past it. Nothing else changes, so the same cache comes back.
fn LRUCache_removeNode(cache: LRUCache, node: usize) -> LRUCache {
    var out: LRUCache = cache;
    const p: usize = out.nodes[node].prev;
    const n: usize = out.nodes[node].next;
    if (p != NO_INDEX) {
        out.nodes[p].next = n;
    }
    if (n != NO_INDEX) {
        out.nodes[n].prev = p;
    }
    return out;
}

// Original line 45: fn moveToFront(cache: *LRUCache, node: *LRUNode) void.
// Unlinks node and relinks it directly after the head sentinel, the most
// recently used position.
fn LRUCache_moveToFront(cache: LRUCache, node: usize) -> LRUCache {
    var out: LRUCache = LRUCache_removeNode(cache, node);
    out.nodes[node].next = out.nodes[HEAD].next;
    out.nodes[node].prev = HEAD;
    const n: usize = out.nodes[node].next;
    if (n != NO_INDEX) {
        out.nodes[n].prev = node;
    }
    out.nodes[HEAD].next = node;
    return out;
}

// Original line 53: pub fn get(cache: *LRUCache, key: usize) ?i64. On a hit
// the entry moves to the front and its value is reported; on a miss the
// original returns null, reported here as found=false. The original's
// recency update happened in place; the cache as get leaves it is the first
// half of the returned pair.
fn LRUCache_get(cache: LRUCache, key: usize) -> (LRUCache, Lookup) {
    const slot: usize = LRUCache_findSlot(cache, key);
    if (slot != NO_INDEX) {
        const value: i64 = cache.nodes[slot].value;
        const moved: LRUCache = LRUCache_moveToFront(cache, slot);
        return (moved, Lookup { found: true, value: value });
    }
    return (cache, Lookup { found: false, value: 0 });
}

// Original line 62: pub fn put(cache: *LRUCache, key: usize, value: i64)
// !void. A hit rewrites the value in place and moves the entry to the front.
// A miss takes a fresh node (here: the first free slot), links it after the
// head, and -- when the cache is over capacity -- evicts list_tail.prev,
// the least recently used entry (original lines 81-86). The original's
// allocator calls become the free-slot scan and the used-flag drop.
fn LRUCache_put(cache: LRUCache, key: usize, value: i64) -> LRUCache {
    var out: LRUCache = cache;
    const slot: usize = LRUCache_findSlot(out, key);
    if (slot != NO_INDEX) {
        out.nodes[slot].value = value;
        out = LRUCache_moveToFront(out, slot);
        return out;
    }
    const fresh: usize = LRUCache_freeSlot(out);
    if (fresh == NO_INDEX) {
        // The store is full beyond what any test drives; the original could
        // always allocate another node. Nothing sensible to evict for, so
        // the cache comes back unchanged.
        return out;
    }
    const after: usize = out.nodes[HEAD].next;
    out.nodes[fresh].key = key;
    out.nodes[fresh].value = value;
    out.nodes[fresh].used = true;
    out.nodes[fresh].prev = HEAD;
    out.nodes[fresh].next = after;
    if (after != NO_INDEX) {
        out.nodes[after].prev = fresh;
    }
    out.nodes[HEAD].next = fresh;
    out.count += 1;
    if (out.count > out.capacity) {
        const lru: usize = out.nodes[TAIL].prev;
        if (lru != NO_INDEX and lru != HEAD) {
            out = LRUCache_removeNode(out, lru);
            out.nodes[lru].used = false;
            out.count = out.count - 1;
        }
    }
    return out;
}

// Original line 89: pub fn deinit(cache: *LRUCache) void. The original
// walks the list from head.next destroying every node, destroys the two
// sentinels, and deinits the map. With no allocator here, the same decision
// is: release every live node (drop its used flag and links), unlink the
// sentinels, and leave an empty cache -- which the test then proves by
// finding every later lookup a miss.
fn LRUCache_deinit(cache: LRUCache) -> LRUCache {
    var out: LRUCache = cache;
    var current: usize = out.nodes[HEAD].next;
    while (current != TAIL and current != NO_INDEX) {
        const next: usize = out.nodes[current].next;
        out.nodes[current].used = false;
        out.nodes[current].prev = NO_INDEX;
        out.nodes[current].next = NO_INDEX;
        current = next;
    }
    out.nodes[HEAD].next = TAIL;
    out.nodes[TAIL].prev = HEAD;
    out.count = 0;
    return out;
}

test init_starts_empty {
    const cache: LRUCache = LRUCache_init(3);
    assert(cache.capacity == 3);
    assert(cache.count == 0);
    assert(cache.nodes[HEAD].next == TAIL);
    assert(cache.nodes[TAIL].prev == HEAD);
    const (after, miss) = LRUCache_get(cache, 1);
    assert(!miss.found);
    assert(after.count == 0);
}

// The original's test "lru cache put get" (line 103): three puts land, and
// the middle key reads back.
test put_then_get_roundtrip {
    var cache: LRUCache = LRUCache_init(3);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    cache = LRUCache_put(cache, 3, 300);
    assert(cache.count == 3);
    const (after, hit) = LRUCache_get(cache, 2);
    assert(hit.found);
    assert(hit.value == 200);
    const (last, miss) = LRUCache_get(after, 99);
    assert(!miss.found);
    assert(last.count == 3);
}

// The original's put rewrites an existing key in place and returns before
// the eviction branch (lines 63-67): the other entry survives untouched.
test put_updates_existing_without_eviction {
    var cache: LRUCache = LRUCache_init(2);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    cache = LRUCache_put(cache, 1, 111);
    assert(cache.count == 2);
    const (after, hit) = LRUCache_get(cache, 1);
    assert(hit.found);
    assert(hit.value == 111);
    const (last, other) = LRUCache_get(after, 2);
    assert(other.found);
    assert(other.value == 200);
    assert(last.count == 2);
}

// The original's test "lru cache eviction" (line 115): with capacity 2 the
// third put evicts key 1, the least recently used entry.
test eviction_drops_least_recent {
    var cache: LRUCache = LRUCache_init(2);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    cache = LRUCache_put(cache, 3, 300);
    assert(cache.count == 2);
    const (after, gone) = LRUCache_get(cache, 1);
    assert(!gone.found);
    const (last, kept) = LRUCache_get(after, 2);
    assert(kept.found);
    assert(kept.value == 200);
    assert(last.count == 2);
}

// The original's get moves a hit to the front (line 56), so a refreshed
// entry survives the next put and the untouched one is evicted instead.
test get_refreshes_recency {
    var cache: LRUCache = LRUCache_init(2);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    const (warmed, hit) = LRUCache_get(cache, 1);
    assert(hit.found);
    cache = LRUCache_put(warmed, 3, 300);
    assert(cache.count == 2);
    const (after, kept) = LRUCache_get(cache, 1);
    assert(kept.found);
    assert(kept.value == 100);
    const (last, gone) = LRUCache_get(after, 2);
    assert(!gone.found);
    assert(last.count == 2);
}

// Original line 40: removeNode relinks both neighbours around the node and
// leaves the slot itself live -- releasing it is the caller's move.
test removeNode_unlinks_middle {
    var cache: LRUCache = LRUCache_init(3);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    const slot2: usize = LRUCache_findSlot(cache, 2);
    const unlinked: LRUCache = LRUCache_removeNode(cache, slot2);
    const slot1: usize = LRUCache_findSlot(unlinked, 1);
    assert(unlinked.nodes[HEAD].next == slot1);
    assert(unlinked.nodes[slot1].prev == HEAD);
    assert(unlinked.nodes[TAIL].prev == slot1);
    assert(unlinked.nodes[slot2].used);
    assert(unlinked.count == 2);
}

// Original line 45: moveToFront relinks the node directly after the head,
// and the previous most recent entry ends up one step further back.
test moveToFront_relinks_lru {
    var cache: LRUCache = LRUCache_init(3);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    cache = LRUCache_put(cache, 3, 300);
    const slot1: usize = LRUCache_findSlot(cache, 1);
    const moved: LRUCache = LRUCache_moveToFront(cache, slot1);
    assert(moved.nodes[HEAD].next == slot1);
    const slot2: usize = LRUCache_findSlot(moved, 2);
    assert(moved.nodes[TAIL].prev == slot2);
    assert(moved.count == 3);
}

// Original line 89: after deinit every node is released and the map is
// empty -- every later lookup misses and the list is bare.
test deinit_empties_the_cache {
    var cache: LRUCache = LRUCache_init(2);
    cache = LRUCache_put(cache, 1, 100);
    cache = LRUCache_put(cache, 2, 200);
    cache = LRUCache_deinit(cache);
    assert(cache.count == 0);
    assert(cache.nodes[HEAD].next == TAIL);
    assert(cache.nodes[TAIL].prev == HEAD);
    const (after, miss1) = LRUCache_get(cache, 1);
    assert(!miss1.found);
    const (last, miss2) = LRUCache_get(after, 2);
    assert(!miss2.found);
    assert(last.count == 0);
}

// Eviction frees a slot (the original destroys the node); later puts take
// the freed slot first, so a long key sequence keeps the cache at capacity.
test put_reuses_freed_slots {
    var cache: LRUCache = LRUCache_init(2);
    cache = LRUCache_put(cache, 1, 10);
    cache = LRUCache_put(cache, 2, 20);
    cache = LRUCache_put(cache, 3, 30);
    cache = LRUCache_put(cache, 4, 40);
    cache = LRUCache_put(cache, 5, 50);
    cache = LRUCache_put(cache, 6, 60);
    cache = LRUCache_put(cache, 7, 70);
    assert(cache.count == 2);
    const (after, hit7) = LRUCache_get(cache, 7);
    assert(hit7.found);
    assert(hit7.value == 70);
    const (last, hit6) = LRUCache_get(after, 6);
    assert(hit6.found);
    assert(hit6.value == 60);
    const (end, gone) = LRUCache_get(last, 5);
    assert(!gone.found);
    assert(end.count == 2);
}

// The map scan misses on an empty cache and the free-slot scan starts at
// the first data slot; after one put the next free slot is a different one.
test findSlot_and_freeSlot_scan {
    const empty: LRUCache = LRUCache_init(2);
    assert(LRUCache_findSlot(empty, 42) == NO_INDEX);
    assert(LRUCache_freeSlot(empty) == FIRST_SLOT);
    const filled: LRUCache = LRUCache_put(empty, 1, 100);
    assert(LRUCache_findSlot(filled, 1) == FIRST_SLOT);
    assert(LRUCache_freeSlot(filled) == FIRST_SLOT + 1);
}
