// t27/specs/port/trinity/src/tri/tri_infer.t27
// Port of gHashTag/trinity src/tri/tri_infer.zig (tri infer - HSLM Inference CLI
// Wrapper). The original's DECISIONS - the two early guards, the --checkpoint
// scan, the 64-arg passthrough cap, the argv layout, and the child-termination
// verdict - become pure, tested functions below. The PLUMBING - the prints and
// the spawn of the hslm-train child process - keeps the original function names
// (runInferCommand, printUsage) with undefined bodies that no test calls.
// Deviations forced by .t27: no ANSI escape constants (string escapes are only
// \n \t \\ \", so the original's RESET/GOLDEN/CYAN colors are presentation the
// caller adds), no allocator parameter (std.mem.Allocator has no .t27 type),
// and the !void error union becomes i32 verdict codes.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trinity::src::tri::tri_infer;

// ---- Decisions of runInferCommand ----

enum ChildTerm { Exited, Abnormal, }

// The original builds argv in a fixed [66][]const u8 buffer ("Max 64 args
// should be more than enough"): argv_buf[0] = INFER_BIN, argv_buf[1] =
// GENERATE_SUBCOMMAND, then @min(args.len, 64) passthrough args, sliced as
// argv_buf[0 .. 2 + pass_len]. The buffer itself is plumbing; its layout is
// decision.
pub const MAX_PASSTHROUGH: usize = 64;
pub const ARGV_FIXED: usize = 2;

pub const INFER_BIN: []const u8 = "zig-out/bin/hslm-train";
pub const GENERATE_SUBCOMMAND: []const u8 = "generate";

// The original's two early guards, as codes the plumbing can act on: empty
// args -> printUsage() and return; otherwise a missing --checkpoint -> warn
// + printUsage() and return; otherwise launch.
pub const PROCEED: i32 = 0;
pub const USAGE_ONLY: i32 = 1;
pub const MISSING_CHECKPOINT: i32 = 2;

// The child-termination verdicts (the original's switch over
// std.process.Termination: .Exited with code 0 -> silence, .Exited with a
// nonzero code -> "hslm-train exited with code N", anything else -> "hslm-train
// terminated abnormally").
pub const CHILD_SILENT: i32 = 0;
pub const CHILD_BAD_CODE: i32 = 1;
pub const CHILD_ABNORMAL: i32 = 2;

pub fn hasCheckpoint(args: []str) -> bool {
    for arg in args {
        if (arg == "--checkpoint") {
            return true;
        }
    }
    return false;
}

// The original checks args.len == 0 BEFORE scanning for --checkpoint, so an
// empty arg list means usage even when has_checkpoint is (vacuously) true.
pub fn guardDecision(arg_count: usize, has_checkpoint: bool) -> i32 {
    if (arg_count == 0) {
        return USAGE_ONLY;
    }
    if (!has_checkpoint) {
        return MISSING_CHECKPOINT;
    }
    return PROCEED;
}

pub fn commandGuard(args: []str) -> i32 {
    return guardDecision(args.len, hasCheckpoint(args));
}

pub fn cappedPassthrough(n: usize) -> usize {
    if (n > MAX_PASSTHROUGH) {
        return MAX_PASSTHROUGH;
    }
    return n;
}

pub fn passthroughCount(args: []str) -> usize {
    return cappedPassthrough(args.len);
}

pub fn argvLength(args: []str) -> usize {
    return ARGV_FIXED + passthroughCount(args);
}

pub fn exitedVerdict(code: i32) -> i32 {
    if (code != 0) {
        return CHILD_BAD_CODE;
    }
    return CHILD_SILENT;
}

pub fn childVerdict(term: ChildTerm, code: i32) -> i32 {
    if (term == .Exited) {
        return exitedVerdict(code);
    }
    return CHILD_ABNORMAL;
}

// ---- Decisions of printUsage ----

// The usage text the original prints, with its {s} color placeholders stripped
// (the colors are plumbing); everything else verbatim, em dash included.
pub const USAGE_TEXT: []const u8 = "tri infer — HSLM Inference & Evaluation\n\nUsage:\n  tri infer --checkpoint <path>                    Generate text\n  tri infer --checkpoint <path> --prompt \"Hello\"   Custom prompt\n  tri infer --checkpoint <path> --eval <data>      PPL evaluation\n\nOptions:\n  --checkpoint <path>   Checkpoint file (required)\n  --prompt <text>       Custom prompt text\n  --eval <path>         Data file for PPL evaluation\n  --eval-lines <N>      Max lines to load (default: 1000)\n  --temperature <f>     Sampling temperature (default: 0.8)\n  --top-k <N>           Top-K sampling (default: 27)\n  --rep-penalty <f>     Repetition penalty (default: 1.2)\n  --max-tokens <N>      Max tokens to generate (default: 200)\n  --context <N>         Context length (default: 27)\n";

pub fn usageText() -> []const u8 {
    return USAGE_TEXT;
}

// ---- Plumbing kept out of the generated core ----

// The original: guards, prints the banner, spawns INFER_BIN with
// GENERATE_SUBCOMMAND plus passthroughCount(args) args (stderr and stdout
// inherited), waits, then reports childVerdict(...) with the child's code.
// Everything decided before and after the spawn is tested above; the spawn and
// prints themselves stay with the caller. The original returns !void; .t27 has
// no error unions, so the verdict codes stand in.
pub fn runInferCommand(args: []str) -> i32 {
    undefined;
}

// The original prints USAGE_TEXT (wrapped in ANSI colors) to stdout. Printing
// is plumbing; the text is USAGE_TEXT above.
pub fn printUsage() -> void {
    undefined;
}

// ---- Tests (assert what the original does) ----

test has_checkpoint_scans_args {
    var with_ckpt: [3][]const u8 = ["--eval", "data.txt", "--checkpoint"];
    assert(hasCheckpoint(&with_ckpt));
    var without_ckpt: [2][]const u8 = ["--prompt", "Hello"];
    assert(!hasCheckpoint(&without_ckpt));
}

test guard_usage_when_no_args {
    // Original: empty args -> printUsage() and return, before any checkpoint
    // scan.
    assert(guardDecision(0, false) == USAGE_ONLY);
    assert(guardDecision(0, true) == USAGE_ONLY);
}

test guard_requires_checkpoint {
    // Original: args present but no --checkpoint -> warn + printUsage().
    assert(guardDecision(2, false) == MISSING_CHECKPOINT);
    // Original: --checkpoint present -> launch the child.
    assert(guardDecision(2, true) == PROCEED);
}

test command_guard_end_to_end {
    var args: [4][]const u8 = ["--prompt", "Hello", "--checkpoint", "phi.bin"];
    assert(commandGuard(&args) == PROCEED);
    var no_ckpt: [2][]const u8 = ["--temperature", "0.6"];
    assert(commandGuard(&no_ckpt) == MISSING_CHECKPOINT);
}

test passthrough_caps_at_64 {
    // Original: @min(args.len, 64) passthrough args reach the child.
    assert(cappedPassthrough(0) == 0);
    assert(cappedPassthrough(10) == 10);
    assert(cappedPassthrough(64) == 64);
    assert(cappedPassthrough(65) == 64);
    assert(cappedPassthrough(100) == 64);
    var args: [2][]const u8 = ["--prompt", "Hello"];
    assert(passthroughCount(&args) == 2);
}

test argv_layout_matches_original {
    // Original: argv = argv_buf[0 .. 2 + pass_len], headed by the fixed pair.
    var args: [2][]const u8 = ["--prompt", "Hello"];
    assert(argvLength(&args) == ARGV_FIXED + 2);
    assert(argvLength(&args) == 4);
    assert(INFER_BIN == "zig-out/bin/hslm-train");
    assert(GENERATE_SUBCOMMAND == "generate");
}

test child_verdict_switch {
    // Original switch over the child's term.
    assert(childVerdict(.Exited, 0) == CHILD_SILENT);
    assert(childVerdict(.Exited, 1) == CHILD_BAD_CODE);
    assert(childVerdict(.Exited, 137) == CHILD_BAD_CODE);
    assert(childVerdict(.Abnormal, 0) == CHILD_ABNORMAL);
    assert(exitedVerdict(0) == CHILD_SILENT);
    assert(exitedVerdict(9) == CHILD_BAD_CODE);
}

test usage_text_names_the_required_flag {
    // The usage the original prints must carry the required --checkpoint flag,
    // the eval mode, and the defaults it documents.
    assert(usageText() == "tri infer — HSLM Inference & Evaluation\n\nUsage:\n  tri infer --checkpoint <path>                    Generate text\n  tri infer --checkpoint <path> --prompt \"Hello\"   Custom prompt\n  tri infer --checkpoint <path> --eval <data>      PPL evaluation\n\nOptions:\n  --checkpoint <path>   Checkpoint file (required)\n  --prompt <text>       Custom prompt text\n  --eval <path>         Data file for PPL evaluation\n  --eval-lines <N>      Max lines to load (default: 1000)\n  --temperature <f>     Sampling temperature (default: 0.8)\n  --top-k <N>           Top-K sampling (default: 27)\n  --rep-penalty <f>     Repetition penalty (default: 1.2)\n  --max-tokens <N>      Max tokens to generate (default: 200)\n  --context <N>         Context length (default: 27)\n");
}
