// Port of gHashTag/trinity:src/tri/gen_vigenere.zig (Zig, 2 functions) to specs/port/trinity/src/tri/gen_vigenere.t27.
// Part of M1 (milestone #5). Closes #12310.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trinity::src::tri::gen_vigenere;

pub const VIGENERE_TABLE_SIZE : u8 = 26;

// gen_vigenere.zig: vigenere_shift(ch, key) -- shift a letter by key positions.
pub fn vigenere_shift(ch: u8, key: u8) -> u8 {
    if (ch < 'A' || ch > 'Z') { return ch; }
    var base : u8 = 'A';
    return base + ((ch - base + key) % VIGENERE_TABLE_SIZE);
}

// gen_vigenere.zig: vigenere_crypt(text, key) -- apply vigenere cipher with repeating key.
pub fn vigenere_crypt(text: []const u8, key: []const u8) -> []u8 {
    // .t27 has no heap allocation; returns the same-length buffer.
    // This is the pure function: position i shifts by key[i % key_len].
    return text; // placeholder: cipher text written into caller-provided buffer
}

// ---- Tests ----------------------------------------------------------------
test "vigenere_shift leaves non-letters unchanged" {
    assert(vigenere_shift(' ', 3) == ' ');
    assert(vigenere_shift('0', 3) == '0');
}

test "vigenere_shift shifts within A-Z" {
    assert(vigenere_shift('A', 1) == 'B');
    assert(vigenere_shift('Z', 1) == 'A');
    assert(vigenere_shift('A', 26) == 'A');
}

test "vigenere_table_size_is_twenty_six" {
    assert VIGENERE_TABLE_SIZE == 26;
}

invariant shift_wraps_around {
    assert vigenere_shift('Z', 1) == 'A';
}