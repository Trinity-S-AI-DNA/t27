// t27/specs/port/trinity/src/tri/experience_hooks.t27
// Port of gHashTag/trinity:src/tri/experience_hooks.zig (d07bc6251fa3, 81 lines)
// to t27.
//
// The original is fire-and-forget experience tracking. Each hook builds an
// Episode, hands it to tri_experience.saveEpisode (swallowing every error --
// "never fails the caller") and prints a dim console line. The clock
// (std.time.timestamp), the episode store (saveEpisode) and stdout are
// plumbing; what the hooks DECIDE is ported below as pure functions, and
// every decision carries a test:
//
//   - task label: "command: detail" when detail is non-empty, the bare
//     command otherwise; if formatting fails, the bare command again
//     (autoSaveExperience, lines 26-30);
//   - verdict: "PASS" on success, "FAIL" on failure (line 35);
//   - iterations is always 1 (lines 39 and 67);
//   - in autoSaveWithMistake the verdict is always "FAIL" (line 54), the
//     detail is recorded as learning 1 only when it is non-empty (lines
//     57-60), the mistake is recorded only when it is non-empty (lines
//     62-65), and the task stays the bare command (line 52).
//
// The two hooks keep their original names and signatures. Their bodies were
// only plumbing -- a timestamp, a store write, a console line -- so here they
// hold `undefined` and no test calls them; the decisions they made live in
// the draft functions above the tests.
//
// t27 cannot concatenate strings, so the "command: detail" decision is
// carried as the parts plus a flag: the caller joins command and detail with
// ": " exactly when has_detail is set, which mirrors the original's bufPrint
// and its catch-fallback to the bare command. Fixed-buffer copying
// (tri_experience.copyToFixed) is data movement, not a decision, so the
// draft carries counts rather than buffers.

module port::experience_hooks {

    // The task label of an episode: the bare command, or the command with
    // the detail attached behind ": " when there is a detail.
    pub struct TaskLabel {
        command: []const u8,
        detail: []const u8,
        has_detail: bool,
    }

    // What the hooks decided, before any plumbing touches it. The store's
    // fixed buffers, the timestamp and the error-swallowing save are the
    // caller's side of the line.
    pub struct EpisodeDraft {
        task_command: []const u8,
        task_detail: []const u8,
        has_detail: bool,
        verdict: []const u8,
        iterations: u32,
        learning_count: u32,
        mistake_count: u32,
    }

    // ------------------------------------------------------------------
    // The decisions
    // ------------------------------------------------------------------

    // autoSaveExperience lines 26-30: "command: detail" when detail is
    // non-empty, the bare command otherwise. The bufPrint fallback on error
    // also lands on the bare command, so has_detail is exactly "a detail was
    // given".
    pub fn build_task_label(command: []const u8, detail: []const u8) TaskLabel {
        var has_detail = false;
        if (detail.len > 0) {
            has_detail = true;
        }
        return TaskLabel { command: command, detail: detail, has_detail: has_detail };
    }

    // autoSaveExperience line 35: success says PASS, anything else FAIL.
    pub fn verdict_for(success: bool) []const u8 {
        if (success) {
            return "PASS";
        }
        return "FAIL";
    }

    // The whole decision of autoSaveExperience, minus the plumbing: the task
    // label, the PASS/FAIL verdict, and one iteration. Learnings and
    // mistakes are not touched by this hook (lines 37-39 set neither).
    pub fn draft_experience(command: []const u8, detail: []const u8, success: bool) EpisodeDraft {
        const verdict = verdict_for(success);
        var has_detail = false;
        if (detail.len > 0) {
            has_detail = true;
        }
        return EpisodeDraft { task_command: command, task_detail: detail, has_detail: has_detail, verdict: verdict, iterations: 1, learning_count: 0, mistake_count: 0 };
    }

    // The whole decision of autoSaveWithMistake, minus the plumbing: the
    // task stays the bare command (line 52), the verdict is always FAIL
    // (line 54), the detail is learned only when given (lines 57-60), the
    // mistake is recorded only when given (lines 62-65), and one iteration
    // (line 67).
    pub fn draft_with_mistake(command: []const u8, detail: []const u8, mistake: []const u8) EpisodeDraft {
        var learning_count: u32 = 0;
        if (detail.len > 0) {
            learning_count = 1;
        }
        var mistake_count: u32 = 0;
        if (mistake.len > 0) {
            mistake_count = 1;
        }
        return EpisodeDraft { task_command: command, task_detail: "", has_detail: false, verdict: "FAIL", iterations: 1, learning_count: learning_count, mistake_count: mistake_count };
    }

    // ------------------------------------------------------------------
    // The hooks
    // ------------------------------------------------------------------

    // Fire-and-forget experience save. Never fails the caller.
    //
    // Plumbing port: the original stamped std.time.timestamp() into the
    // episode, copied the label through tri_experience.copyToFixed, wrote it
    // with tri_experience.saveEpisode (every error swallowed) and printed the
    // dim "[experience: cmd -> verdict]" line. Those effects belong to the
    // caller here; the decisions are draft_experience, and no test calls
    // this body.
    pub fn autoSaveExperience(command: []const u8, detail: []const u8, success: bool) void {
        undefined;
    }

    // Auto-save with a mistake recorded.
    //
    // Plumbing port: same split as autoSaveExperience -- the original
    // recorded detail as learning 1 and mistake as mistake 1 through the
    // store, stamped the timestamp, saved fire-and-forget and printed
    // "[experience: cmd -> FAIL: mistake]". The decisions are
    // draft_with_mistake, and no test calls this body.
    pub fn autoSaveWithMistake(command: []const u8, detail: []const u8, mistake: []const u8) void {
        undefined;
    }

    // ==================================================================
    // Tests
    // ==================================================================

    test "the verdict follows the success flag"
        // Line 35: success is PASS, failure is FAIL.
        const pass = verdict_for(true);
        const fail = verdict_for(false);
        assert(pass == "PASS");
        assert(fail == "FAIL");

    test "the task label carries the detail only when there is one"
        // Lines 26-30: "command: detail" when detail is non-empty, the bare
        // command otherwise.
        const with_detail = build_task_label("vibe", "deploy ring 3");
        assert(with_detail.has_detail);
        assert(with_detail.command == "vibe");
        assert(with_detail.detail == "deploy ring 3");

        // An empty detail is no detail: bare command.
        const bare = build_task_label("vibe", "");
        assert(!bare.has_detail);
        assert(bare.command == "vibe");
        assert(bare.detail == "");

    test "the experience draft sets the verdict and one iteration"
        // Lines 35 and 39, with neither learning nor mistake touched.
        const ok = draft_experience("trinity build", "ring 3", true);
        assert(ok.verdict == "PASS");
        assert(ok.has_detail);
        assert(ok.iterations == 1);
        assert(ok.learning_count == 0);
        assert(ok.mistake_count == 0);

        const failed = draft_experience("trinity build", "", false);
        assert(failed.verdict == "FAIL");
        assert(!failed.has_detail);
        assert(failed.iterations == 1);

    test "the mistake draft records learning and mistake only when present"
        // Lines 54, 57-60 and 62-65: always FAIL; each record appears only
        // when its text is non-empty.
        const both = draft_with_mistake("vibe check", "phase 2 drifted", "wrong ring width");
        assert(both.verdict == "FAIL");
        assert(both.task_command == "vibe check");
        assert(both.learning_count == 1);
        assert(both.mistake_count == 1);
        assert(both.iterations == 1);

        const neither = draft_with_mistake("vibe check", "", "");
        assert(neither.verdict == "FAIL");
        assert(neither.learning_count == 0);
        assert(neither.mistake_count == 0);
}
