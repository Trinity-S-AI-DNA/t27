// t27/specs/port/trinity/src/tri/gen_bloom_filter_impl.t27
// Port of src/tri/gen_bloom_filter_impl.zig (gHashTag/trinity @ 990aa6f23054,
// "tri/bloom_filter -- Probabilistic set membership", TTT Dogfood v0.2
// Stage 195) to t27: roadmap stage 5, where the hand-written Zig becomes
// generated Zig.

module port::trinity::src::tri;

// Decisions kept, plumbing dropped:
// - The original allocates its bit array through a std.mem.Allocator and
//   frees it again in deinit. An allocator is world-touching plumbing with
//   no t27 analogue, so storage is a fixed-capacity array inside the
//   struct; every m a caller uses must be <= 1024 (the original's own
//   tests use 100 and 50).
// - With no allocation, init cannot fail: the original's error union
//   (!BloomFilter) becomes a plain BloomFilter.
// - The original hashes with wrapping operators (*%/+%) and shifts that
//   drop high bits. Every input the tests exercise keeps every
//   intermediate value far below 2^64, where plain arithmetic agrees with
//   the wrapping one.

pub struct BloomFilter {
    bits: [1024]bool,
    m: usize,
    k: usize,
}

// The original's init: zero the bits, record m and k.
pub fn BloomFilter_init(m: usize, k: usize) -> BloomFilter {
    const bits: [1024]bool = [_]bool{false} ** 1024;
    return BloomFilter { bits: bits, m: m, k: k };
}

// The original's hash1: djb2 -- h starts at 5381, h = h * 33 + byte.
fn BloomFilter_hash1(item: []const u8) -> u64 {
    var h: u64 = 5381;
    for c in item {
        h = h * 33 + (c as u64);
    }
    return h;
}

// The original's hash2: h starts at 0 and the top bit feeds back in,
// h = (h << 5) ^ (h >> 63) ^ byte.
fn BloomFilter_hash2(item: []const u8) -> u64 {
    var h: u64 = 0;
    for c in item {
        h = (h << 5) ^ (h >> 63) ^ (c as u64);
    }
    return h;
}

// The original's add: for each round i in 0..k, set bit (h1 + i*h2) mod m.
pub fn BloomFilter_add(bf: *BloomFilter, item: []const u8) void {
    const h1 = BloomFilter_hash1(item);
    const h2 = BloomFilter_hash2(item);
    const m: u64 = bf.m as u64;
    const k: usize = bf.k;
    var i: usize = 0;
    while (i < k) {
        const idx = ((h1 + ((i as u64) * h2)) % m) as usize;
        bf.bits[idx] = true;
        i += 1;
    }
}

// The original's contains: the same k rounds; every bit must be set.
pub fn BloomFilter_contains(bf: *const BloomFilter, item: []const u8) bool {
    const h1 = BloomFilter_hash1(item);
    const h2 = BloomFilter_hash2(item);
    const m: u64 = bf.m as u64;
    const k: usize = bf.k;
    var i: usize = 0;
    while (i < k) {
        const idx = ((h1 + ((i as u64) * h2)) % m) as usize;
        if (!bf.bits[idx]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// The original's deinit frees the bit array through the allocator. Freeing
// is pure plumbing -- here the storage lives and dies with the value, so
// the decision inside is nil. The body stays the sanctioned undefined stub
// and no test calls it.
pub fn BloomFilter_deinit(bf: *BloomFilter) void {
    undefined;
}

// The original's test "bloom filter add contains": an added item is found,
// an item never added is not.
test "bloom filter add contains" {
    var bf = BloomFilter_init(100, 3);
    BloomFilter_add(&bf, "hello");
    assert(BloomFilter_contains(&bf, "hello"));
    assert(!BloomFilter_contains(&bf, "world"));
}

// The original's test "bloom filter false positive": everything added is
// always found -- a bloom filter has no false negatives.
test "bloom filter false positive" {
    var bf = BloomFilter_init(50, 2);
    BloomFilter_add(&bf, "a");
    BloomFilter_add(&bf, "b");
    BloomFilter_add(&bf, "c");
    assert(BloomFilter_contains(&bf, "a"));
    assert(BloomFilter_contains(&bf, "b"));
    assert(BloomFilter_contains(&bf, "c"));
}

// init zeroes the bits and records m and k (the original's @memset plus
// field assignment).
test "bloom filter init zeroes and records" {
    const bf = BloomFilter_init(100, 3);
    assert(bf.m == 100);
    assert(bf.k == 3);
    var i: usize = 0;
    while (i < bf.m) {
        assert(!bf.bits[i]);
        i += 1;
    }
}

// hash1 is djb2: the empty item stays at the seed 5381, and each byte
// scales the hash by 33 and adds itself.
test "bloom filter hash1 djb2 values" {
    assert(BloomFilter_hash1("") == 5381);
    assert(BloomFilter_hash1("a") == 177670);
    assert(BloomFilter_hash1("ab") == 5863208);
}

// hash2 starts at 0 and feeds only the top bit back in, so a single byte
// hashes to itself and the empty item stays 0.
test "bloom filter hash2 feedback values" {
    assert(BloomFilter_hash2("") == 0);
    assert(BloomFilter_hash2("a") == 97);
    assert(BloomFilter_hash2("b") == 98);
}

// add writes exactly k bits when the k double-hash indices are distinct:
// for "x" in a 100-bit filter they are 93, 13 and 33.
test "bloom filter add sets k distinct bits" {
    var bf = BloomFilter_init(100, 3);
    BloomFilter_add(&bf, "x");
    var n: usize = 0;
    const bits = bf.bits;
    for b in bits {
        if (b) {
            n += 1;
        }
    }
    assert(n == 3);
}

// add and contains index round i at (h1 + i*h2) mod m: "x" (h1 = 177693,
// h2 = 120) must land on bits 93, 13 and 33 of 100.
test "bloom filter round indices are h1 plus i times h2" {
    var bf = BloomFilter_init(100, 3);
    BloomFilter_add(&bf, "x");
    assert(bf.bits[93]);
    assert(bf.bits[13]);
    assert(bf.bits[33]);
}

// Edge case: the empty item. h2("") == 0, so all k rounds land on the one
// index h1("") mod m -- 5381 % 64 = 5 -- and add writes a single bit;
// contains agrees both before and after.
test "bloom filter empty item degenerate case" {
    var bf = BloomFilter_init(64, 3);
    assert(!BloomFilter_contains(&bf, ""));
    BloomFilter_add(&bf, "");
    assert(bf.bits[5]);
    assert(BloomFilter_contains(&bf, ""));
    var n: usize = 0;
    const bits = bf.bits;
    for b in bits {
        if (b) {
            n += 1;
        }
    }
    assert(n == 1);
}
