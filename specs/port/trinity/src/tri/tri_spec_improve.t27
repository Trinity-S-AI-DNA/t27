// Port of gHashTag/trinity src/tri/tri_spec_improve.zig @5aabfbe8346f
// (roadmap stage 5: the spec-improve report, generated from .t27 instead of
// hand-written Zig).
//
// Porting decisions:
//   - TestReport_passRate, TestReport_grade, calculateFillRate and
//     checkConvergence are pure decisions and are ported in full, with tests
//     pinning the behaviour read in the original.
//   - getCpuCount queries the world (std.Thread.getCpuCount()).  Its body
//     stays `undefined;` and no test calls it; the decision inside it - fall
//     back to 4 when the OS answer is unavailable - is ported as the pure
//     cpu_count_from_query and tested.
//   - calculateFillRate scans lines without growable lists: a single pass
//     records line bounds, and helpers classify the trimmed line exactly as
//     the original's split/trim/startsWith/endsWith chain does.

module port::trinity::src::tri::tri_spec_improve;

// std.ascii.whitespace: ' ', \t, \n, \r, \v, \f.  \v and \f have no char
// escape, so they are matched by their code points 11 and 12.
fn is_ws(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r' or c == '\n' or c == 11 or c == 12;
}

// Bounds of the trimmed line inside content[ls .. le): the first index after
// leading whitespace, and one past the last non-whitespace character.
fn trim_start(content: []const u8, ls: usize, le: usize) -> usize {
    var i: usize = ls;
    while (i < le and is_ws(content[i])) {
        i += 1;
    }
    return i;
}

fn trim_end(content: []const u8, ls: usize, le: usize) -> usize {
    var e: usize = le;
    while (e > ls and is_ws(content[e - 1])) {
        e -= 1;
    }
    return e;
}

// trimmed.startsWith("pub fn ") against content[s0 .. e0).
fn starts_with_pub_fn(content: []const u8, s0: usize, e0: usize) -> bool {
    if (e0 < s0 + 7) {
        return false;
    }
    return content[s0] == 'p' and content[s0 + 1] == 'u' and content[s0 + 2] == 'b'
        and content[s0 + 3] == ' ' and content[s0 + 4] == 'f' and content[s0 + 5] == 'n'
        and content[s0 + 6] == ' ';
}

// trimmed.startsWith("fn ") against content[s0 .. e0).
fn starts_with_fn(content: []const u8, s0: usize, e0: usize) -> bool {
    if (e0 < s0 + 3) {
        return false;
    }
    return content[s0] == 'f' and content[s0 + 1] == 'n' and content[s0 + 2] == ' ';
}

// True when the trimmed line ends with an empty body: "{}" or "{ }".
fn ends_with_stub_body(content: []const u8, s0: usize, e0: usize) -> bool {
    if (e0 < s0 + 2) {
        return false;
    }
    if (content[e0 - 1] == '}' and content[e0 - 2] == '{') {
        return true;
    }
    if (e0 < s0 + 3) {
        return false;
    }
    return content[e0 - 1] == '}' and content[e0 - 2] == ' ' and content[e0 - 3] == '{';
}

struct TestReport {
    total_files: u32,
    passed_files: u32,
    failed_files: u32,
    total_tests: u32,
    total_elapsed_ms: u64,
}

pub fn TestReport_passRate(self: TestReport) -> f64 {
    if (self.total_files == 0) {
        return 0.0;
    }
    return self.passed_files as f64 / self.total_files as f64;
}

pub fn TestReport_grade(self: TestReport) -> str {
    const rate: f64 = TestReport_passRate(self) * 100.0;
    if (rate >= 100.0) {
        return "EXCELLENT";
    }
    if (rate >= 90.0) {
        return "GOOD";
    }
    if (rate >= 70.0) {
        return "SATISFACTORY";
    }
    return "POOR";
}

// Fraction of function declarations in `content` whose body is not just "{}"
// or "{ }".  A spec without any function declaration is 1.0 filled.
pub fn calculateFillRate(content: []const u8) -> f64 {
    var total_impls: u64 = 0;
    var filled_impls: u64 = 0;
    var ls: usize = 0;
    var i: usize = 0;
    const n: usize = content.len;
    while (i <= n) {
        var at_end: bool = false;
        if (i == n) {
            at_end = true;
        } else if (content[i] == '\n') {
            at_end = true;
        }
        if (at_end) {
            const s0: usize = trim_start(content, ls, i);
            const e0: usize = trim_end(content, ls, i);
            if (starts_with_pub_fn(content, s0, e0) or starts_with_fn(content, s0, e0)) {
                total_impls += 1;
                if (!ends_with_stub_body(content, s0, e0)) {
                    filled_impls += 1;
                }
            }
            ls = i + 1;
        }
        i += 1;
    }
    if (total_impls == 0) {
        return 1.0;
    }
    return filled_impls as f64 / total_impls as f64;
}

// Converged once no fill rate is still below the target.
pub fn checkConvergence(fill_rates: []const f64, target: f64) -> bool {
    for rate in fill_rates {
        if (rate < target) {
            return false;
        }
    }
    return true;
}

// Decision inside the original getCpuCount: the OS answer is used as-is, and 4
// is the fallback when the query fails.  The query itself is plumbing.
pub fn cpu_count_from_query(query_ok: bool, query_result: u32) -> u32 {
    if (!query_ok) {
        return 4;
    }
    return query_result;
}

// Queries std.Thread.getCpuCount() and falls back to 4 on error (see
// cpu_count_from_query).  The OS query is world-touching plumbing, so the body
// stays undefined and no test calls this function.
pub fn getCpuCount() -> u32 {
    undefined;
}

test "fill rate - empty spec" {
    assert(calculateFillRate("") == 1.0);
}

test "fill rate - all implemented" {
    const content = "pub fn foo() void {\n    doSomething();\n}\npub fn bar() i32 {\n    return 42;\n}";
    assert(calculateFillRate(content) == 1.0);
    assert(calculateFillRate(content) > 0.9);
}

test "fill rate - stub bodies" {
    assert(calculateFillRate("fn stub() {}") == 0.0);
    assert(calculateFillRate("fn spaced() { }") == 0.0);
}

test "fill rate - mixed with indented declarations" {
    const content = "  fn indented() void { go(); }\nfn stub() {}\n";
    assert(calculateFillRate(content) == 0.5);
}

test "fill rate - declaration quirks" {
    assert(calculateFillRate("fn ") == 1.0);
    assert(calculateFillRate("fn") == 1.0);
}

test "convergence at target" {
    var rates: [4]f64 = [0.90, 0.85, 0.95, 1.0];
    assert(checkConvergence(&rates, 0.85));
    assert(!checkConvergence(&rates, 0.95));
    var single: [1]f64 = [0.85];
    assert(checkConvergence(&single, 0.85));
}

test "report grade" {
    const r = TestReport { total_files: 10, passed_files: 10, failed_files: 0, total_tests: 50, total_elapsed_ms: 1000 };
    assert(TestReport_passRate(r) == 1.0);
    assert(TestReport_grade(r) == "EXCELLENT");
}

test "report grade - satisfactory band" {
    const r = TestReport { total_files: 10, passed_files: 8, failed_files: 2, total_tests: 40, total_elapsed_ms: 800 };
    assert(TestReport_passRate(r) == 0.8);
    assert(TestReport_grade(r) == "SATISFACTORY");
}

test "report grade - good and poor bands" {
    const good = TestReport { total_files: 10, passed_files: 9, failed_files: 1, total_tests: 45, total_elapsed_ms: 900 };
    assert(TestReport_grade(good) == "GOOD");
    const poor = TestReport { total_files: 10, passed_files: 5, failed_files: 5, total_tests: 25, total_elapsed_ms: 500 };
    assert(TestReport_grade(poor) == "POOR");
}

test "report grade - empty report" {
    const r = TestReport { total_files: 0, passed_files: 0, failed_files: 0, total_tests: 0, total_elapsed_ms: 0 };
    assert(TestReport_passRate(r) == 0.0);
    assert(TestReport_grade(r) == "POOR");
}

test "cpu count fallback" {
    assert(cpu_count_from_query(false, 64) == 4);
    assert(cpu_count_from_query(true, 64) == 64);
    assert(cpu_count_from_query(true, 1) == 1);
}
