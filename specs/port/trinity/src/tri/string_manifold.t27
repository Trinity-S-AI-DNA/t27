module port::trinity::src::tri::string_manifold;

//! Calabi-Yau manifold Hodge numbers — χ = 2(h11 - h12), mirror symmetry.

struct HodgeNumbers {
    h11: u32,
    h12: u32,
}

fn HodgeNumbers_init(h11: u32, h12: u32) HodgeNumbers {
    return HodgeNumbers{ .h11 = h11, .h12 = h12 };
}

/// Euler characteristic χ = 2(h^{1,1} - h^{1,2})
fn HodgeNumbers_eulerChi(h: HodgeNumbers) i32 {
    const diff = h.h11 - h.h12;
    return 2 * diff;
}

/// Fermion generations = |χ|/2 = |h11 - h12|
fn HodgeNumbers_fermionGenerations(h: HodgeNumbers) u32 {
    const diff = h.h11 - h.h12;
    const abs_diff = if (diff < 0) -diff else diff;
    return abs_diff;
}

/// Mirror symmetry: swap h^{1,1} ↔ h^{1,2}
fn HodgeNumbers_mirror(h: HodgeNumbers) HodgeNumbers {
    return HodgeNumbers{ .h11 = h.h12, .h12 = h.h11 };
}

test "eulerChi uses minus sign" {
    const h = HodgeNumbers_init(19, 19);
    assert(HodgeNumbers_eulerChi(h) == 0);
}

test "eulerChi(3,3) is zero" {
    const h = HodgeNumbers_init(3, 3);
    assert(HodgeNumbers_eulerChi(h) == 0);
}

test "fermionGenerations for Standard Model" {
    // |h11 - h12| = 3 → exactly 3 fermion generations
    const h = HodgeNumbers_init(6, 3);
    assert(HodgeNumbers_fermionGenerations(h) == 3);
    assert(HodgeNumbers_eulerChi(h) == 6);
}

test "mirror symmetry swaps Hodge numbers" {
    const h = HodgeNumbers_init(5, 10);
    const m = HodgeNumbers_mirror(h);
    assert(m.h11 == 10);
    assert(m.h12 == 5);
    // Mirror flips sign of Euler characteristic
    assert(HodgeNumbers_eulerChi(m) == -HodgeNumbers_eulerChi(h));
}