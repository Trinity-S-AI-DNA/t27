// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/trinity/src/tri/trinity.t27
//
// Port of gHashTag/trinity src/tri/trinity.zig (50 lines, 1 function) to t27.
//
// The original is one function, runTrinityCommand(allocator), whose body is a
// single std.debug.print of the Trinity 16-step development cycle banner. The
// printing is plumbing: the print stays behind the original name as a stub no
// test calls, and the banner's text -- the decision the function carries --
// is extracted as the pure helper trinity_help_text(). The tests assert on
// that text through the pure substring search help_text_contains(), and on
// the cycle facts the banner states through phase_of_step(),
// phase_first_step(), cycle_next_step() and trinity_identity_holds().

module port::trinity::src::tri::trinity;

// The original entry point, kept under its own name and signature. In the
// source it prints the banner and nothing else; printing is plumbing, so the
// body is a stub no test calls. The allocator parameter stands in for
// std.mem.Allocator, which the t27 type system has no type for.
pub fn runTrinityCommand(allocator: usize) -> void {
    undefined;
}

// The banner head: "Trinity 16-STEP DEVELOPMENT CYCLE" -- 16 steps in total.
pub const CYCLE_STEPS: u32 = 16;

// The banner groups those steps into four phases of four, numbered 1-4, 5-8,
// 9-12 and 13-16 in its four section headers.
pub const PHASE_COUNT: u32 = 4;
pub const STEPS_PER_PHASE: u32 = 4;

// The banner's RULES section lists three rules.
pub const RULE_COUNT: u32 = 3;

// Which phase owns a step, 1..PHASE_COUNT: step 1 the first specification
// step, step 5 the first generation step, step 9 the first validation step,
// step 13 the first deployment step. 0 = no phase owns the step.
pub fn phase_of_step(step: u32) -> u32 {
    if (step < 1 or step > CYCLE_STEPS) {
        return 0;
    }
    return ((step - 1) / STEPS_PER_PHASE) + 1;
}

// The first step a phase owns, 1..CYCLE_STEPS: phase 1 starts at step 1,
// phase 2 at step 5, phase 3 at step 9, phase 4 at step 13.
// 0 = no such phase.
pub fn phase_first_step(phase: u32) -> u32 {
    if (phase < 1 or phase > PHASE_COUNT) {
        return 0;
    }
    return ((phase - 1) * STEPS_PER_PHASE) + 1;
}

// The next step in the cycle. Banner step 16 is "Loop back to step 1", so the
// cycle is closed: the step after 16 is 1 again. 0 = step outside the cycle.
pub fn cycle_next_step(step: u32) -> u32 {
    if (step < 1 or step > CYCLE_STEPS) {
        return 0;
    }
    if (step == CYCLE_STEPS) {
        return 1;
    }
    return step + 1;
}

// The full banner text the original prints, byte for byte: the box-drawn
// head, the four phase sections, the RULES section and the closing identity
// line, ending with an empty line exactly as in the source.
pub fn trinity_help_text() -> str {
    return "\n╔══════════════════════════════════════════════════════════╗\n║           Trinity 16-STEP DEVELOPMENT CYCLE                  ║\n║           Mandatory Process for All Changes                  ║\n╚════════════════════════════════════════════════╝\n\nSPECIFICATION (Steps 1-4):\n  1. Create .tri specification (SINGLE SOURCE OF TRUTH)\n  2. Define types (data structures)\n  3. Define behaviors (functions)\n  4. Add algorithms if needed\n\nGENERATION (Steps 5-8):\n  5. Run: tri gen <spec.tri>\n  6. Review generated code\n  7. Run tests: zig build test\n  8. Fix any issues in SPEC (not generated code!)\n\nVALIDATION (Steps 9-12):\n  9. Run benchmarks\n  10. Write critical assessment (honest self-criticism)\n  11. Document achievements\n  12. Update technology tree\n\nDEPLOYMENT (Steps 13-16):\n  13. Git add & commit\n  14. Push to remote\n  15. Propose 3 tech tree options for next iteration\n 16. Loop back to step 1\n\nRULES:\n - NEVER edit generated code directly\n - ALL changes go through .tri specs\n - One source of truth = no duplication\n\nφ² + 1/φ² = 3 = TRINITY\n";
}

// Pure substring search: true when needle occurs in hay. An empty needle
// occurs everywhere; a needle longer than the hay occurs nowhere.
fn text_contains(hay: str, needle: str) -> bool {
    const hlen: usize = hay.len;
    const nlen: usize = needle.len;
    if (nlen == 0) {
        return true;
    }
    if (hlen < nlen) {
        return false;
    }
    var i: usize = 0;
    while (i + nlen <= hlen) {
        var j: usize = 0;
        var matched: bool = true;
        while (j < nlen) {
            if (hay[i + j] != needle[j]) {
                matched = false;
            }
            j = j + 1;
        }
        if (matched) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Negated view of text_contains, for the tests: true when needle does not occur
// in hay. Written with plain if/return -- the t27 `not` operator parses but
// the generator mishandles it, so the port avoids it.
fn absent(hay: str, needle: str) -> bool {
    if (text_contains(hay, needle)) {
        return false;
    }
    return true;
}

// Does the banner text contain marker? The tests' window on the text.
pub fn help_text_contains(marker: str) -> bool {
    return text_contains(trinity_help_text(), marker);
}

// The banner's closing line: "phi^2 + 1/phi^2 = 3 = TRINITY".
pub const PHI_SQUARED: f64 = 2.618033988749895;
pub const INV_PHI_SQUARED: f64 = 0.38196601125010515;

// The identity the banner states, within floating-point tolerance.
pub fn trinity_identity_holds() -> bool {
    const sum: f64 = PHI_SQUARED + INV_PHI_SQUARED;
    return sum > 2.999 and sum < 3.001;
}

test help_text_carries_the_cycle_markers {
    assert(help_text_contains("Trinity 16-STEP DEVELOPMENT CYCLE"));
    assert(help_text_contains("SPECIFICATION (Steps 1-4):"));
    assert(help_text_contains("GENERATION (Steps 5-8):"));
    assert(help_text_contains("VALIDATION (Steps 9-12):"));
    assert(help_text_contains("DEPLOYMENT (Steps 13-16):"));
    assert(help_text_contains("RULES:"));
}

test help_text_carries_the_rules {
    assert(help_text_contains(" - NEVER edit generated code directly"));
    assert(help_text_contains(" - ALL changes go through .tri specs"));
    assert(help_text_contains(" - One source of truth = no duplication"));
    assert(help_text_contains("RULES:\n - NEVER edit generated code directly"));
    assert(help_text_contains(" 8. Fix any issues in SPEC (not generated code!)"));
    assert(help_text_contains(" 16. Loop back to step 1"));
    assert(help_text_contains("φ² + 1/φ² = 3 = TRINITY"));
}

test help_text_has_banner_shape {
    const text: str = trinity_help_text();
    assert(text.len > 1000);
    // The text opens with an empty line and the box-drawn head ...
    assert(text_contains(text, "\nSPECIFICATION (Steps 1-4):"));
    // ... and closes with the identity line and an empty line.
    assert(text_contains(text, "= TRINITY\n"));
}

test contains_matches_substrings_and_reports_absent_markers {
    assert(text_contains("spec", "spec"));
    assert(text_contains("specs", "spec"));
    assert(text_contains("spec", ""));
    assert(absent("spec", "specs"));
    assert(absent("spec", "generated code"));
}

test cycle_shape_matches_banner {
    assert_eq(CYCLE_STEPS, 16);
    assert_eq(PHASE_COUNT, 4);
    assert_eq(STEPS_PER_PHASE, 4);
    assert_eq(RULE_COUNT, 3);
}

test phase_ranges_match_banner {
    assert_eq(phase_of_step(1), 1);
    assert_eq(phase_of_step(4), 1);
    assert_eq(phase_of_step(5), 2);
    assert_eq(phase_of_step(8), 2);
    assert_eq(phase_of_step(9), 3);
    assert_eq(phase_of_step(12), 3);
    assert_eq(phase_of_step(13), 4);
    assert_eq(phase_of_step(16), 4);
    assert_eq(phase_of_step(0), 0);
    assert_eq(phase_of_step(17), 0);
}

test phase_first_step_matches_banner {
    assert_eq(phase_first_step(1), 1);
    assert_eq(phase_first_step(2), 5);
    assert_eq(phase_first_step(3), 9);
    assert_eq(phase_first_step(4), 13);
    assert_eq(phase_first_step(0), 0);
    assert_eq(phase_first_step(5), 0);
}

test step_sixteen_loops_back_to_step_one {
    assert_eq(cycle_next_step(1), 2);
    assert_eq(cycle_next_step(15), 16);
    assert_eq(cycle_next_step(16), 1);
    assert_eq(cycle_next_step(0), 0);
    assert_eq(cycle_next_step(17), 0);
}

test banner_closes_with_trinity_identity {
    assert(trinity_identity_holds());
    assert(PHI_SQUARED > 2.618);
    assert(INV_PHI_SQUARED < 0.382);
}
