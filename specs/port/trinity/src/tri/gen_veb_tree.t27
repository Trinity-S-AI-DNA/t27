module port::trinity::tri::gen_veb_tree;

const UNIVERSE_SIZE = 16;

pub struct VEBTree {
    min: ?u64,
    max: ?u64,
    summary: ?*VEBTree,
    cluster: [*]u8,
    universe_size: u64,
    allocator: *void,
}

pub fn VEBTree_init(allocator: *void, universe_size: u64) -> VEBTree {
    var cluster: [1]u8 = [0];
    var summary: ?*VEBTree = null;
    
    return VEBTree {
        .min = null,
        .max = null,
        .summary = summary,
        .cluster = &cluster,
        .universe_size = universe_size,
        .allocator = allocator,
    };
}

fn VEBTree_high(tree: *const VEBTree, x: u64) -> u64 {
    const upper = @sqrt(@as(f64, @floatFromInt(tree.universe_size)));
    const size = @as(u64, @intFromFloat(upper));
    return x / size;
}

fn VEBTree_low(tree: *const VEBTree, x: u64) -> u64 {
    const upper = @sqrt(@as(f64, @floatFromInt(tree.universe_size)));
    const size = @as(u64, @intFromFloat(upper));
    return x % size;
}

pub fn VEBTree_insert(tree: *VEBTree, x: u64) -> void {
    if (tree.min == null) {
        tree.min = x;
        tree.max = x;
        return;
    }

    if (x < tree.min) {
        const temp = x;
        x = tree.min;
        tree.min = temp;
    }

    if (tree.universe_size > 2) {
        const i = VEBTree_high(tree, x);
        const j = VEBTree_low(tree, x);

        if (tree.cluster[i] == 0) {
            const upper = @sqrt(@as(f64, @floatFromInt(tree.universe_size)));
            const size = @as(u64, @intFromFloat(upper));
            var sub: VEBTree = undefined;
            sub = VEBTree_init(null, size);
            tree.cluster[i] = 1;

            if (tree.summary == null) {
                const s_size = @as(u64, @intFromFloat(upper));
                var sum: VEBTree = undefined;
                sum = VEBTree_init(null, s_size);
                tree.summary = &sum;
            }

            tree.summary.insert(i);
        }

        tree.cluster[i].insert(j);
    }

    if (x > tree.max) {
        tree.max = x;
    }
}

pub fn VEBTree_contains(tree: *const VEBTree, x: u64) -> bool {
    if (x == tree.min or x == tree.max) {
        return true;
    }

    if (tree.universe_size == 2) {
        return false;
    }

    const i = VEBTree_high(tree, x);
    const j = VEBTree_low(tree, x);

    if (tree.cluster[i] == 0) {
        return false;
    }

    return tree.cluster[i].contains(j);
}

pub fn VEBTree_deinit(tree: *VEBTree) -> void {
    // Simple deinit - no complex cleanup
    tree.min = null;
    tree.max = null;
    tree.summary = null;
}

test veb_tree_insert_contains {
    var tree = VEBTree_init(null, UNIVERSE_SIZE);
    defer tree.deinit();

    tree.insert(5);
    tree.insert(10);
    tree.insert(3);

    assert(tree.contains(5));
    assert(tree.contains(10));
    assert(!tree.contains(99));
}

test veb_tree_min_max {
    var tree = VEBTree_init(null, UNIVERSE_SIZE);
    defer tree.deinit();

    tree.insert(5);
    tree.insert(1);
    tree.insert(10);

    assert(tree.min == 1);
    assert(tree.max == 10);
}

test veb_tree_empty {
    var tree = VEBTree_init(null, UNIVERSE_SIZE);
    defer tree.deinit();

    assert(tree.min == null);
    assert(tree.max == null);
    assert(!tree.contains(5));
}

test veb_tree_contains_edge {
    var tree = VEBTree_init(null, 2);
    defer tree.deinit();

    tree.insert(0);
    tree.insert(1);

    assert(tree.contains(0));
    assert(tree.contains(1));
    assert(!tree.contains(2));
}

test veb_tree_high_low {
    var tree = VEBTree_init(null, 16);
    defer tree.deinit();

    assert(VEBTree_high(&tree, 5) == 1);
    assert(VEBTree_low(&tree, 5) == 1);
    assert(VEBTree_high(&tree, 10) == 2);
    assert(VEBTree_low(&tree, 10) == 2);
}

test veb_tree_duplicate_insert {
    var tree = VEBTree_init(null, UNIVERSE_SIZE);
    defer tree.deinit();

    tree.insert(5);
    tree.insert(5);

    assert(tree.contains(5));
    assert(tree.min == 5);
    assert(tree.max == 5);
}