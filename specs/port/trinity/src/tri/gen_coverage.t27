// Port of gHashTag/trinity:src/tri/gen_coverage.zig (Zig, 4 functions) to specs/port/trinity/src/tri/gen_coverage.t27.
// Part of M1 (milestone #5). Closes #12314.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trinity::src::tri::gen_coverage;

pub const COVERAGE_BUCKETS : u32 = 10;

pub struct Coverage {
    hits : [10]u32,
    total : u32,
};

// gen_coverage.zig: new() -- zero all counters.
pub fn Coverage_new() -> Coverage {
    return Coverage {
        hits: [_]u32{0} ** 10,
        total: 0,
    };
}

// gen_coverage.zig: record(hit) -- increment one bucket and total.
pub fn Coverage_record(c: Coverage, bucket: u32) -> Coverage {
    var r : Coverage = c;
    if (bucket < 10) {
        var hits : [10]u32 = r.hits;
        hits[bucket] = hits[bucket] + 1;
        r.hits = hits;
    }
    r.total = r.total + 1;
    return r;
}

// gen_coverage.zig: ratio(bucket) -- hits[bucket] / total.
pub fn Coverage_ratio(c: Coverage, bucket: u32) -> u32 {
    if (c.total == 0) { return 0; }
    if (bucket >= 10) { return 0; }
    return c.hits[bucket] * 1000 / c.total;
}

// gen_coverage.zig: summary() -- total hits across all buckets.
pub fn Coverage_summary(c: Coverage) -> u32 {
    return c.total;
}

// ---- Tests ----------------------------------------------------------------
test "coverage starts at zero" {
    var c = Coverage_new();
    assert(Coverage_summary(c) == 0);
    assert(Coverage_ratio(c, 0) == 0);
}

test "record increments bucket and total" {
    var c = Coverage_new();
    c = Coverage_record(c, 3);
    assert(Coverage_summary(c) == 1);
    assert(Coverage_ratio(c, 3) == 1000);
    assert(Coverage_ratio(c, 0) == 0);
}

test "out-of-range bucket is ignored" {
    var c = Coverage_new();
    c = Coverage_record(c, 99);
    assert(Coverage_summary(c) == 1);
    assert(Coverage_ratio(c, 99) == 0);
}

test "ratio is per-mille" {
    var c = Coverage_new();
    c = Coverage_record(c, 0);
    c = Coverage_record(c, 0);
    c = Coverage_record(c, 1);
    assert(Coverage_ratio(c, 0) == 666); // 2/3 * 1000
    assert(Coverage_ratio(c, 1) == 333); // 1/3 * 1000
}

invariant buckets_are_ten {
    assert COVERAGE_BUCKETS == 10;
}