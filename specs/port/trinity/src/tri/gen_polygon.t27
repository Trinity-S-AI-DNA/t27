// Port of gHashTag/trinity:src/tri/gen_polygon.zig (Zig, 4 functions) to specs/port/trinity/src/tri/gen_polygon.t27.
// Part of M1 (milestone #5). Closes #12592.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trinity::src::tri::gen_polygon;

pub struct Point { x: i32, y: i32 };

pub struct Polygon {
    points : [16]Point,
    count : u32,
};

// gen_polygon.zig: polygon_new() -- empty polygon.
pub fn Polygon_new() -> Polygon {
    return Polygon {
        points: [_]Point{ Point{ x: 0, y: 0 } } ** 16,
        count: 0,
    };
}

// gen_polygon.zig: polygon_add(p, pt) -- append a point.
pub fn Polygon_add(p: Polygon, pt: Point) -> Polygon {
    var r : Polygon = p;
    if (r.count < 16) {
        var pts : [16]Point = r.points;
        pts[r.count] = pt;
        r.points = pts;
        r.count = r.count + 1;
    }
    return r;
}

// gen_polygon.zig: polygon_area() -- shoelace formula, returns doubled area.
pub fn Polygon_area(p: Polygon) -> i32 {
    var area : i32 = 0;
    var i : u32 = 0;
    while (i < p.count) {
        var j : u32 = (i + 1) % p.count;
        area = area + p.points[i].x * p.points[j].y - p.points[j].x * p.points[i].y;
        i = i + 1;
    }
    if (area < 0) { area = -area; }
    return area;
}

// gen_polygon.zig: polygon_contains(pt) -- point-in-polygon test.
pub fn Polygon_contains(p: Polygon, pt: Point) -> bool {
    // Ray casting: count crossings to the right.
    var inside : bool = false;
    var i : u32 = 0;
    var j : u32 = p.count - 1;
    while (i < p.count) {
        if ((p.points[i].y > pt.y) != (p.points[j].y > pt.y)) {
            var x_intersect : i32 = p.points[j].x - (p.points[j].y - pt.y) * (p.points[j].x - p.points[i].x) / (p.points[j].y - p.points[i].y);
            if (pt.x < x_intersect) { inside = !inside; }
        }
        j = i;
        i = i + 1;
    }
    return inside;
}

// ---- Tests ----------------------------------------------------------------
test "polygon starts empty" {
    var p = Polygon_new();
    assert(p.count == 0);
    assert(Polygon_area(p) == 0);
}

test "polygon_add increases count" {
    var p = Polygon_new();
    p = Polygon_add(p, Point { x: 1, y: 2 });
    assert(p.count == 1);
    p = Polygon_add(p, Point { x: 3, y: 4 });
    assert(p.count == 2);
}

test "polygon_area of triangle" {
    var p = Polygon_new();
    p = Polygon_add(p, Point { x: 0, y: 0 });
    p = Polygon_add(p, Point { x: 4, y: 0 });
    p = Polygon_add(p, Point { x: 0, y: 3 });
    assert(Polygon_area(p) == 12); // doubled area: 4*3 = 12
}

invariant max_points_is_sixteen {
    assert Polygon_new().count == 0;
}