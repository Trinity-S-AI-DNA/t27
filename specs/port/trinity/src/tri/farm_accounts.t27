module port::trinity::src::tri::farm_accounts;

// Re-authoring of gHashTag/trinity:src/tri/farm_accounts.zig @ ee512359254b
// (95 lines) under specs/port/trinity/src/tri/.
//
// The original scans account_slots (PRIMARY plus FARM-2..FARM-8) and, for
// each slot, reads three env vars via std.process.getEnvVarOwned:
// RAILWAY_API_TOKEN[_N], RAILWAY_PROJECT_ID[_N] and RAILWAY_ENVIRONMENT_ID[_N].
// A slot becomes an account only when all three of its vars exist — a missing
// env_id discards the fetched project_id and the slot is skipped; the token
// value is freed unused, only its existence matters. Slots are taken in table
// order up to MAX_ACCOUNTS, and each kept slot stores an Account carrying the
// slot's static name/suffix plus the owned project_id/env_id strings.
// deinitAccounts frees those owned strings for the first `count` accounts.
//
// Decision code is ported here and tested below. Plumbing — the env reads,
// the allocator, and the buffer fill they enable — stays in the original: its
// observable outcome arrives as the SlotPresence parameter of
// discoverAccounts, and deinitAccounts keeps its name with an unreachable
// body, its decision ported as freed_string_count. No test calls it.

pub const MAX_ACCOUNTS: u8 = 8;

// Account, as in the original: identity from the slot table, plus the two
// owned env strings. name/suffix point into the static slot table;
// project_id/env_id are allocated in the original and freed by
// deinitAccounts.
pub struct Account {
    name: []const u8,
    suffix: []const u8,
    env_id: []const u8,
    project_id: []const u8,
}

// What discoverAccounts learns per slot from the environment (original lines
// 54-65): whether each of the three required vars exists. The original
// fetches full values and frees them again; only existence drives the
// decision, so existence is the parameter.
pub struct SlotPresence {
    token_present: bool,
    project_present: bool,
    env_present: bool,
}

// The per-slot qualification decision (original lines 54-65): a slot yields
// an account only when token, project_id AND env_id all exist. There is no
// partial account.
pub fn slot_qualifies(slot: SlotPresence) bool {
    return slot.token_present and slot.project_present and slot.env_present;
}

// The identity columns of account_slots (original lines 32-41) as decisions:
// the display name and the env-key suffix of slot i. PRIMARY has no suffix;
// FARM-N has "_N". The full key strings (RAILWAY_API_TOKEN[_N] and friends)
// only name the env lookup — plumbing — and stay in the original.
pub fn slot_name(slot: u8) str {
    return switch (slot) {
        0 => "PRIMARY",
        1 => "FARM-2",
        2 => "FARM-3",
        3 => "FARM-4",
        4 => "FARM-5",
        5 => "FARM-6",
        6 => "FARM-7",
        7 => "FARM-8",
        else => "",
    };
}

pub fn slot_suffix(slot: u8) str {
    return switch (slot) {
        0 => "",
        1 => "_2",
        2 => "_3",
        3 => "_4",
        4 => "_5",
        5 => "_6",
        6 => "_7",
        7 => "_8",
        else => "",
    };
}

// The record discoverAccounts stores for a qualifying slot (original lines
// 67-72): identity from the slot table, the owned env strings as fetched.
pub fn make_account(slot: u8, project_id: str, env_id: str) Account {
    return Account {
        name: slot_name(slot),
        suffix: slot_suffix(slot),
        env_id: env_id,
        project_id: project_id,
    };
}

// discoverAccounts (original lines 48-77). getEnvVarOwned, the allocator and
// the buffer fill are plumbing; their outcome arrives as `presence`, one
// entry per slot in account_slots order. The decisions stay: walk the slots
// in table order, stop once count reaches MAX_ACCOUNTS, keep only qualifying
// slots, and return how many accounts were found. The buffer fill that this
// count describes is make_account.
pub fn discoverAccounts(presence: []const SlotPresence) u8 {
    var count: u8 = 0;
    for slot in presence {
        if (count >= MAX_ACCOUNTS) {
            break;
        }
        if (slot_qualifies(slot)) {
            count += 1;
        }
    }
    return count;
}

// deinitAccounts (original lines 80-85). allocator.free is plumbing — the
// owned strings moving out of the process — so this body stays unreachable
// and no test calls it. The decision it makes, exactly two frees
// (project_id, env_id) per account and only for the first `count` accounts,
// is freed_string_count.
pub fn deinitAccounts(count: u8) void {
    return undefined;
}

// The decision inside deinitAccounts, as a count: freeing `count` accounts
// releases 2 * count strings, and nothing beyond the buffer's capacity. The
// original requires count <= MAX_ACCOUNTS (buf[0..count] would panic past
// it); the port caps there.
pub fn freed_string_count(count: u8) u8 {
    if (count > MAX_ACCOUNTS) {
        return 2 * MAX_ACCOUNTS;
    }
    return 2 * count;
}

test "slot_qualifies requires all three env vars" {
    // discoverAccounts skips a slot unless token, project AND env all exist;
    // each missing var alone suppresses the account.
    assert(slot_qualifies(SlotPresence { token_present: true, project_present: true, env_present: true }));
    assert(!slot_qualifies(SlotPresence { token_present: false, project_present: true, env_present: true }));
    assert(!slot_qualifies(SlotPresence { token_present: true, project_present: false, env_present: true }));
    assert(!slot_qualifies(SlotPresence { token_present: true, project_present: true, env_present: false }));
    assert(!slot_qualifies(SlotPresence { token_present: false, project_present: false, env_present: false }));
}

test "discover counts qualified slots in table order" {
    // Three slots: the first is missing its token, the second qualifies, the
    // third qualifies — discoverAccounts finds 2 accounts (original: slots
    // whose vars are missing are passed over, not an error).
    var slots: [3]SlotPresence = [
        SlotPresence { token_present: false, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
    ];
    assert(discoverAccounts(&slots) == 2);
}

test "discover stops at MAX_ACCOUNTS" {
    // Ten fully provisioned slots: the original breaks once count reaches
    // MAX_ACCOUNTS (line 52), so only eight are ever taken.
    var slots: [10]SlotPresence = [
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
        SlotPresence { token_present: true, project_present: true, env_present: true },
    ];
    assert(discoverAccounts(&slots) == MAX_ACCOUNTS);
    assert(discoverAccounts(&slots) == 8);
}

test "empty environment finds nothing" {
    // No RAILWAY_* vars set at all — the original finds zero accounts.
    var slots: [2]SlotPresence = [
        SlotPresence { token_present: false, project_present: false, env_present: false },
        SlotPresence { token_present: false, project_present: false, env_present: false },
    ];
    assert(discoverAccounts(&slots) == 0);
}

test "make_account carries slot identity and env strings" {
    // The primary slot (no suffix) and the FARM-4 slot ("_4"), with the env
    // values the account owns.
    const primary = make_account(0, "proj-primary", "env-primary");
    assert(primary.name == "PRIMARY");
    assert(primary.suffix == "");
    assert(primary.project_id == "proj-primary");
    assert(primary.env_id == "env-primary");

    const farm4 = make_account(3, "proj-4", "env-4");
    assert(farm4.name == "FARM-4");
    assert(farm4.suffix == "_4");
    assert(farm4.project_id == "proj-4");
    assert(farm4.env_id == "env-4");
}

test "slot table covers all eight slots" {
    // account_slots' identity columns: PRIMARY plus FARM-2..FARM-8.
    assert(slot_name(0) == "PRIMARY");
    assert(slot_name(7) == "FARM-8");
    assert(slot_suffix(0) == "");
    assert(slot_suffix(1) == "_2");
    assert(slot_suffix(7) == "_8");
}

test "deinit frees two owned strings per account" {
    // deinitAccounts frees project_id and env_id of each of the first count
    // accounts: two strings per account, none when count is 0, never past the
    // buffer's capacity.
    assert(freed_string_count(0) == 0);
    assert(freed_string_count(1) == 2);
    assert(freed_string_count(3) == 6);
    assert(freed_string_count(MAX_ACCOUNTS) == 16);
}
