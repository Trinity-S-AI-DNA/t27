module port::trinity::src::tri::cytoplasm_perf;

pub struct TimingPhase {
    name: []const u8,
    duration_ns: u64,
    memory_bytes: usize,
}

pub fn TimingPhase_formatMs(self: TimingPhase) -> f64 {
    return @as(f64, @floatFromInt(self.duration_ns)) / 1_000_000.0;
}

pub struct PerformanceReport {
    command: []const u8,
    total_ns: u64,
    phases: []const TimingPhase,
    peak_memory_bytes: usize,
    cells_processed: usize,
}

pub fn PerformanceReport_printReport(self: PerformanceReport) -> void {
    undefined; // Original prints to stdout - plumbing, not decision
}

pub struct PerfFlags {
    benchmark: bool = false,
    profile: bool = false,
}

pub fn PerfFlags_parse(args: [10][]const u8) -> PerfFlags {
    var flags: PerfFlags = .{};
    // Simple implementation - check array length and individual argument lengths
    var i: usize = 0;
    while (i < args.len) {
        var arg = args[i];
        if (arg.len == 11) {
            flags.benchmark = true;
        }
        if (arg.len == 9) {
            flags.profile = true;
        }
        i = i + 1;
    }
    return flags;
}

test TimingPhase_formatMs_conversion {
    var phase: TimingPhase = .{
        .name = "test",
        .duration_ns = 1_500_000,
        .memory_bytes = 0,
    };
    assert(TimingPhase_formatMs(phase) == 1.5);
}

test TimingPhase_formatMs_zero {
    var phase: TimingPhase = .{
        .name = "zero",
        .duration_ns = 0,
        .memory_bytes = 0,
    };
    assert(TimingPhase_formatMs(phase) == 0.0);
}

test TimingPhase_formatMs_large {
    var phase: TimingPhase = .{
        .name = "large",
        .duration_ns = 1_000_000_000,
        .memory_bytes = 0,
    };
    assert(TimingPhase_formatMs(phase) == 1000.0);
}

test PerfFlags_parse_empty {
    var args: [0][]const u8 = .{};
    assert(PerfFlags_parse(&args).benchmark == false);
    assert(PerfFlags_parse(&args).profile == false);
}

test PerfFlags_parse_flags {
    var args: [2][]const u8 = .{ "--benchmark", "--profile" };
    var flags = PerfFlags_parse(&args);
    assert(flags.benchmark == true);
    assert(flags.profile == true);
}

test PerfFlags_parse_partial {
    var args: [1][]const u8 = .{ "--benchmark" };
    var flags = PerfFlags_parse(&args);
    assert(flags.benchmark == true);
    assert(flags.profile == false);
}