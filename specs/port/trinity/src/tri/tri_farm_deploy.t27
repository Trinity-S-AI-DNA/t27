module port::trinity::src::tri::tri_farm_deploy;

// Trinity Farm Deploy - tri farm deploy
// Ported from gHashTag/trinity src/tri/tri_farm_deploy.zig (147 lines) so the
// Railway GraphQL deployment logic is generated from .t27 instead of written
// by hand.
//
// Port the decision, not the plumbing:
// - findExperiment and validateConfig are pure decisions; they are ported in
//   full and every test calls them.
// - The original returns error unions (!void with error.FlatScheduleForbidden,
//   error.ContextTooSmall, error.InvalidLearningRate); .t27 has no error
//   unions, so validateConfig returns an i32 verdict and the error names
//   become its codes (0 is ok, like the original's success path).
// - formatEnvVarMutation and formatRedeployMutation only move bytes out: they
//   print a GraphQL mutation into a caller-provided buffer for the HTTP
//   request. .t27 has no string concatenation, so each keeps its name with an
//   undefined; body that no test calls, and the decision inside it - which
//   GraphQL operation runs, with which fields, in which order - lives in the
//   pure helpers below, which the tests exercise.

// Verdict codes for validateConfig (the original's error union).
pub const VALID_OK: i32 = 0;
pub const ERR_FLAT_SCHEDULE_FORBIDDEN: i32 = 1;
pub const ERR_CONTEXT_TOO_SMALL: i32 = 2;
pub const ERR_INVALID_LEARNING_RATE: i32 = 3;

// Experiment configurations (from R4-R7 templates)
pub const ExperimentConfig = struct {
    name: str,
    optimizer: str = "LAMB",
    lr: f64 = 1e-3,
    lr_schedule: str = "cosine",
    batch_size: u32 = 66,
    context_length: u32 = 81,
    grad_clip: f32 = 1.0,
    label_smoothing: f32 = 0.0,
    batch_accum: u32 = 1,
    service_id: str,
};

// The predefined templates. The original keeps them in one static EXPERIMENTS
// array and scans it linearly; these are the same four entries, compared one
// by one.
const EXP_R4: ExperimentConfig = ExperimentConfig {
    name: "r4",
    optimizer: "AdamW",
    lr: 3e-4,
    lr_schedule: "cosine",
    batch_size: 66,
    context_length: 81,
    grad_clip: 1.0,
    label_smoothing: 0.1,
    batch_accum: 1,
    service_id: "hslm-train",
};

const EXP_R5: ExperimentConfig = ExperimentConfig {
    name: "r5",
    optimizer: "LAMB",
    lr: 1e-3,
    lr_schedule: "cosine",
    batch_size: 66,
    context_length: 27,
    grad_clip: 1.0,
    label_smoothing: 0.0,
    batch_accum: 1,
    service_id: "hslm-train",
};

const EXP_R6: ExperimentConfig = ExperimentConfig {
    name: "r6",
    optimizer: "AdamW",
    lr: 3e-4,
    lr_schedule: "cosine-restarts",
    batch_size: 66,
    context_length: 81,
    grad_clip: 1.0,
    label_smoothing: 0.0,
    batch_accum: 1,
    service_id: "hslm-v11",
};

const EXP_R7: ExperimentConfig = ExperimentConfig {
    name: "r7",
    optimizer: "LAMB",
    lr: 1e-3,
    lr_schedule: "cosine",
    batch_size: 66,
    context_length: 81,
    grad_clip: 1.0,
    label_smoothing: 0.0,
    batch_accum: 8,
    service_id: "hslm-v11",
};

// Find experiment config by name
pub fn findExperiment(name: str) ?ExperimentConfig {
    if (name == "r4") {
        return EXP_R4;
    }
    if (name == "r5") {
        return EXP_R5;
    }
    if (name == "r6") {
        return EXP_R6;
    }
    if (name == "r7") {
        return EXP_R7;
    }
    return null;
}

// Validate experiment config against safeguards
// The original returns error.FlatScheduleForbidden, error.ContextTooSmall or
// error.InvalidLearningRate; here the same checks, in the original's order,
// return the ERR_* codes above.
pub fn validateConfig(config: ExperimentConfig) i32 {
    // SAFEGUARD: Never use flat LR schedule
    if (config.lr_schedule == "flat") {
        return ERR_FLAT_SCHEDULE_FORBIDDEN;
    }
    // SAFEGUARD: Context must be >= 27
    if (config.context_length < 27) {
        return ERR_CONTEXT_TOO_SMALL;
    }
    // SAFEGUARD: LR must be positive
    if (config.lr <= 0.0) {
        return ERR_INVALID_LEARNING_RATE;
    }
    return VALID_OK;
}

// Render the env-var upsert mutation into buf for the HTTP request; null when
// buf has no space left (the original's bufPrint error). Only moves bytes
// out; the decision it renders lives in the helpers below.
pub fn formatEnvVarMutation(buf: []u8, service_id: str, env_id: str, key: str, value: str) ?str {
    undefined;
}

// Render the redeploy mutation into buf for the HTTP request; null when buf
// has no space left. Only moves bytes out; the decision it renders lives in
// the helpers below.
pub fn formatRedeployMutation(buf: []u8, deployment_id: str) ?str {
    undefined;
}

// The decision inside formatEnvVarMutation: an env-var upsert is the
// variableUpsert GraphQL operation.
pub fn envVarMutationOperation() str {
    return "variableUpsert";
}

// The four input fields the variableUpsert operation takes, in the order the
// original template fills them; null past the end.
pub fn envVarMutationInputField(index: u32) ?str {
    if (index == 0) {
        return "serviceId";
    }
    if (index == 1) {
        return "environmentId";
    }
    if (index == 2) {
        return "name";
    }
    if (index == 3) {
        return "value";
    }
    return null;
}

// The decision inside formatRedeployMutation: a redeploy is the
// deploymentRedeploy GraphQL operation.
pub fn redeployMutationOperation() str {
    return "deploymentRedeploy";
}

// A redeploy always reuses the previously deployed image tag
// (usePreviousImageTag: true in the original template).
pub fn redeployUsesPreviousImageTag() bool {
    return true;
}

// The fields the redeploy response projects, in order; null past the end.
pub fn redeployProjectedField(index: u32) ?str {
    if (index == 0) {
        return "id";
    }
    if (index == 1) {
        return "status";
    }
    return null;
}

test "find experiment" {
    const r4 = findExperiment("r4");
    assert(r4 != null);
    assert(r4.?.optimizer == "AdamW");
    assert(findExperiment("r99") == null);
}

test "find experiment r5 through r7" {
    const r5 = findExperiment("r5");
    assert(r5 != null);
    assert(r5.?.optimizer == "LAMB");
    assert(r5.?.context_length == 27);
    const r6 = findExperiment("r6");
    assert(r6 != null);
    assert(r6.?.lr_schedule == "cosine-restarts");
    assert(r6.?.service_id == "hslm-v11");
    const r7 = findExperiment("r7");
    assert(r7 != null);
    assert(r7.?.batch_accum == 8);
    assert(r7.?.service_id == "hslm-v11");
}

test "experiment defaults" {
    const r5 = findExperiment("r5");
    assert(r5 != null);
    // Defaults from the original struct definition carry through the table.
    assert(r5.?.lr == 1e-3);
    assert(r5.?.lr_schedule == "cosine");
    assert(r5.?.batch_size == 66);
    assert(r5.?.grad_clip == 1.0);
    assert(r5.?.label_smoothing == 0.0);
    assert(r5.?.batch_accum == 1);
}

test "validate config - safe" {
    const safe = ExperimentConfig { name: "test", service_id: "test" };
    assert(validateConfig(safe) == VALID_OK);
}

test "validate config - flat schedule forbidden" {
    const flat = ExperimentConfig { name: "test", lr_schedule: "flat", service_id: "test" };
    assert(validateConfig(flat) == ERR_FLAT_SCHEDULE_FORBIDDEN);
}

test "validate config - context too small" {
    const tiny = ExperimentConfig { name: "test", context_length: 26, service_id: "test" };
    assert(validateConfig(tiny) == ERR_CONTEXT_TOO_SMALL);
    // 27 is the boundary and is allowed.
    const minimal = ExperimentConfig { name: "test", context_length: 27, service_id: "test" };
    assert(validateConfig(minimal) == VALID_OK);
}

test "validate config - invalid learning rate" {
    const zero = ExperimentConfig { name: "test", lr: 0.0, service_id: "test" };
    assert(validateConfig(zero) == ERR_INVALID_LEARNING_RATE);
}

test "validate config accepts the shipped templates" {
    const r5 = findExperiment("r5");
    assert(r5 != null);
    assert(validateConfig(r5.?) == VALID_OK);
}

test "env var mutation decision" {
    assert(envVarMutationOperation() == "variableUpsert");
    assert(envVarMutationInputField(0).? == "serviceId");
    assert(envVarMutationInputField(1).? == "environmentId");
    assert(envVarMutationInputField(2).? == "name");
    assert(envVarMutationInputField(3).? == "value");
    assert(envVarMutationInputField(4) == null);
}

test "redeploy mutation decision" {
    assert(redeployMutationOperation() == "deploymentRedeploy");
    assert(redeployUsesPreviousImageTag() == true);
    assert(redeployProjectedField(0).? == "id");
    assert(redeployProjectedField(1).? == "status");
    assert(redeployProjectedField(2) == null);
}
