module port::trinity::tri::gen_perceptron;

pub struct Perceptron {
    weights: [2]f64, // one weight per input; the original allocates `inputs` of them, the tests use two
    learning_rate: f64,
    allocator: usize, // Using usize as placeholder for allocator
}

fn Perceptron_init(allocator: usize, inputs: usize, lr: f64) -> Perceptron {
    // Port the decision: create perceptron with zero weights and given learning rate
    // Note: allocator parameter is ignored as per "port the decision, not the plumbing"
    const weights: [2]f64 = [0.0, 0.0];
    return Perceptron {
        .weights = weights,
        .learning_rate = lr,
        .allocator = allocator,
    };
}

fn Perceptron_predict(perceptron: Perceptron, inputs: []const f64) -> i32 {
    // Port the decision: compute weighted sum and return binary classification
    var sum: f64 = 0;
    for i in 0..inputs.len {
        if (i < perceptron.weights.len) {
            sum += inputs[i] * perceptron.weights[i];
        }
    }
    return if (sum >= 0) 1 else 0;
}

fn Perceptron_train(perceptron: *Perceptron, inputs: []const f64, target: i32) -> void {
    // Port the decision: update weights based on prediction error
    // The perceptron is the caller's, as in the original's `self: *Perceptron`, so the update outlives the call
    const guess = Perceptron_predict(perceptron.*, inputs);
    const diff: f64 = target - guess;
    for i in 0..inputs.len {
        if (i < perceptron.weights.len) {
            perceptron.weights[i] += perceptron.learning_rate * diff * inputs[i];
        }
    }
}

fn Perceptron_deinit(perceptron: Perceptron) -> void {
    // Port the decision: free allocated memory
    // Note: actual allocator.free() is plumbing, so body is undefined
    return;
}

test perceptron_init_basic {
    const p = Perceptron_init(0, 2, 0.1);
    assert(p.learning_rate == 0.1);
    assert(p.weights[0] == 0.0);
    assert(p.weights[1] == 0.0);
}

test perceptron_predict_simple {
    const p = Perceptron_init(0, 2, 0.1);
    // Zero weights give a sum of 0, and a sum >= 0 predicts 1
    const inputs: [2]f64 = [1, 1];
    const prediction = Perceptron_predict(p, &inputs);
    assert(prediction == 1);
}

test perceptron_training_update {
    var p = Perceptron_init(0, 2, 0.1);
    const inputs: [2]f64 = [1, 1];
    // The guess is 1 and the target 0, so each weight moves by 0.1 * (0 - 1) * 1
    Perceptron_train(&p, &inputs, 0);
    assert(p.weights[0] == -0.1);
    assert(p.weights[1] == -0.1);
    // The sum is now -0.2, so the perceptron predicts the target
    assert(Perceptron_predict(p, &inputs) == 0);
}

test perceptron_right_guess_keeps_weights {
    var p = Perceptron_init(0, 2, 0.1);
    const inputs: [2]f64 = [1, 1];
    // The guess is 1 and so is the target: no error, no update
    Perceptron_train(&p, &inputs, 1);
    assert(p.weights[0] == 0.0);
    assert(p.weights[1] == 0.0);
}

test perceptron_edge_cases {
    const p = Perceptron_init(0, 3, 0.5);
    // Test with empty inputs: the sum stays 0
    const empty_inputs: [0]f64 = [];
    const empty_prediction = Perceptron_predict(p, &empty_inputs);
    assert(empty_prediction == 1);

    // Test with more inputs than weights: inputs past the last weight are skipped
    var q = Perceptron_init(0, 2, 0.5);
    const long_inputs: [5]f64 = [1, 2, 3, 4, 5];
    Perceptron_train(&q, &long_inputs, 0);
    assert(q.weights[0] == -0.5);
    assert(q.weights[1] == -1.0);
    const long_prediction = Perceptron_predict(q, &long_inputs);
    assert(long_prediction == 0);
}

test perceptron_deinit_structure {
    const p = Perceptron_init(0, 2, 0.1);
    // deinit frees nothing here (the allocator is plumbing), so the perceptron is still whole
    Perceptron_deinit(p);
    assert(p.learning_rate == 0.1);
}
