module port::trinity::src::tri::emu::tri_asm_base;

// Port of gHashTag/trinity src/tri/emu/tri_asm_base.zig at 5aabfbe8346f to
// .t27, so the TRI-27 assembler base is generated from a spec instead of
// hand-written. The original is a placeholder assembler: its parser accepts
// no line at all, its assemble loop skips empty and comment lines and never
// fills its instruction list, and its main prints one banner. As written the
// original does not compile (bare `Allocator` on line 35, a two-parameter
// `std.StringHashMap` on line 30, and a byte loop whose element is indexed
// on lines 50-51); the port follows the stated intent. Everything that
// touched the world -- the allocator, the ArrayList and StringHashMap behind
// AssemblerState, the defers, the std.debug.print -- is caller plumbing; the
// decisions are what is ported here. The original's header notes
// @origin(spec:tri_asm.tri) @regen(done): this spec is the origin that
// marker pointed at.

// Lines 10-17 of the original: the ISA subset as enum(u8) with nop = 0x00
// and ld_imm = 0x01, marked for expansion. .t27 enums carry no explicit
// discriminants, so the two values the ISA fixes live as consts beside the
// enum; the enum keeps the variant names.
pub enum Opcode {
    nop,
    ld_imm,
}

pub const OPCODE_NOP: u8 = 0x00;
pub const OPCODE_LD_IMM: u8 = 0x01;

// Lines 19-24: pub const Instruction = struct { opcode: Opcode, dst: u3,
// imm: i8 }. u3 is not in the .t27 integer set, so dst is carried as u8 and
// the original's 0..7 register range is noted here.
pub struct Instruction {
    opcode: Opcode,
    dst: u8,
    imm: i8,
}

// Lines 26-31: pub const AssemblerState = struct { instructions:
// std.ArrayList(Instruction), labels: std.StringHashMap([]const u8, void) }.
// No list or map library builds in .t27 today, so the port keeps the two
// facts the placeholder logic can observe about that state: how many
// instructions were accepted and how many labels were declared.
pub struct AssemblerState {
    instruction_count: usize,
    label_count: usize,
}

// Lines 57-60: the original's assemble builds and returns a AsmParseResult
// value without declaring the type anywhere, so the shape below is the one
// its return expression names: success and instruction_count. line_num is
// computed in the loop and dropped there; the port carries it out so the
// skip rule stays observable from a single call.
Renamed from ParseResult: specs/lsp/protocol.t27 already defines one; this is the assembler's line-parsing result (#2774).
pub struct AsmParseResult {
    success: bool,
    instruction_count: usize,
    line_num: u32,
}

// The assemble loop's guard, verbatim from line 51 of the original:
//   if (line.len == 0 or line[0] == ';' or line[0] == '#') continue;
// Only an empty line, a ';' banner or a '# note' is skipped; a line of
// spaces is assembled like any other.
pub fn is_skipped_line(line: []const u8) -> bool {
    if (line.len == 0) {
        return true;
    }
    var first: u8 = ' ';
    for c in line {
        first = c;
        break;
    }
    return first == ';' or first == '#';
}

// Lines 34-38: fn parseInstruction(allocator: Allocator, line: []const u8)
// !?Instruction { _ = line; return null; }. The allocator is caller plumbing
// and .t27 has no error channel; the decision kept is the original's
// placeholder body: the line is discarded and no line parses into an
// instruction yet.
fn parseInstruction(line: []const u8) -> ?Instruction {
    return null;
}

// Lines 40-61: pub fn assemble(allocator: std.mem.Allocator, asm_source:
// []const u8) ![]u8. The allocator, the owned state and its defers
// (lines 42-47) are plumbing; the port takes the source already split into
// lines, because .t27 has no string slicing today. The decisions stay:
// start the line counter at 1 (line 49), walk every line, skip the empty
// and comment ones (line 51), advance the counter for the rest (line 54),
// and report success with the number of parsed instructions (lines 57-60) --
// zero for every input, because parseInstruction accepts no line and
// nothing is ever appended. The signature promises bytes but the body
// returns AsmParseResult; the port follows the body.
pub fn assemble(lines: []str) -> AsmParseResult {
    var line_num: u32 = 1;
    const state = AssemblerState { instruction_count: 0, label_count: 0 };
    for line in lines {
        if (is_skipped_line(line)) {
            continue;
        }
        line_num += 1;
    }
    return AsmParseResult { success: true, instruction_count: state.instruction_count, line_num: line_num };
}

// Lines 63-66: pub fn main() !void
// { std.debug.print("TRI-ASM: assembler base ready\n"); }. The write to
// stdout is data moving out; the port returns the banner and leaves the
// printing to the caller.
pub fn main() -> []const u8 {
    return "TRI-ASM: assembler base ready\n";
}

test opcode_discriminants {
    var nop: u8 = OPCODE_NOP;
    var ld_imm: u8 = OPCODE_LD_IMM;
    assert(nop == 0x00);
    assert(ld_imm == 0x01);
}

test skip_rule_matches_original {
    assert(is_skipped_line(""));
    assert(is_skipped_line("; banner"));
    assert(is_skipped_line("# note"));
    assert(!is_skipped_line("ld_imm r1, 5"));
    assert(!is_skipped_line(" "));
}

test parse_instruction_accepts_nothing {
    assert(parseInstruction("nop r0, 0") == null);
    assert(parseInstruction("") == null);
}

test assemble_counts_only_code_lines {
    var lines: [4][]const u8 = ["nop r0, 0", "; banner", "", "# note"];
    const result = assemble(&lines);
    assert(result.success);
    assert(result.instruction_count == 0);
    assert(result.line_num == 2);
}

test assemble_skips_every_line {
    var lines: [3][]const u8 = ["", "; a", "# b"];
    const result = assemble(&lines);
    assert(result.success);
    assert(result.instruction_count == 0);
    assert(result.line_num == 1);
}

test main_reports_the_banner {
    assert(main() == "TRI-ASM: assembler base ready\n");
}
