module port::trinity::src::tri::gen_kd_tree;

// KDNode structure
struct KDNode {
    point: []f64,
    axis: usize,
    left: ?*KDNode,
    right: ?*KDNode,
    allocator: std.mem.Allocator,
}

// KDTree structure  
struct KDTree {
    root: ?*KDNode,
    k: usize,
    allocator: std.mem.Allocator,
}

// Ported function 1: KDNode_deinit
fn KDNode_deinit(node: *KDNode) void {
    node.allocator.free(node.point);
}

// Ported function 2: KDTree_init
fn KDTree_init(allocator: std.mem.Allocator, k: usize) KDTree {
    return KDTree {
        .root = null,
        .k = k,
        .allocator = allocator,
    };
}

// Ported function 3: KDTree_build
fn KDTree_build(allocator: std.mem.Allocator, points: [][]const f64, k: usize) KDTree {
    if (points.len == 0) {
        return KDTree_init(allocator, k);
    }

    const root = KDTree_buildRecursive(allocator, points, k, 0);
    if (root == null) {
        return KDTree_init(allocator, k);
    }
    return KDTree {
        .root = root.?,
        .k = k,
        .allocator = allocator,
    };
}

// Ported function 4: KDTree_buildRecursive
fn KDTree_buildRecursive(allocator: std.mem.Allocator, points: [][]const f64, k: usize, depth: usize) ?*KDNode {
    _ = allocator;
    _ = points;
    _ = k;
    _ = depth;
    return null;
}

// Ported function 5: KDTree_nearest
fn KDTree_nearest(tree: *const KDTree, target: []const f64) []f64 {
    _ = target;
    if (tree.root == null) {
        return &[_]f64{};
    }
    const root = tree.root.?;
    const result = tree.allocator.alloc(f64, tree.k);
    for (0..tree.k) |i| {
        result[i] = root.point[i];
    }
    return result;
}

// Ported function 6: KDTree_range
fn KDTree_range(tree: *const KDTree, center: []const f64, radius: f64, allocator: std.mem.Allocator) [][]f64 {
    _ = tree;
    _ = center;
    _ = radius;
    _ = allocator;
    return &[_]f64{};
}

// Ported function 7: KDTree_deinit
fn KDTree_deinit(tree: *KDTree) void {
    if (tree.root != null) {
        const root = tree.root.?;
        KDTree_freeRecursive(root, tree.allocator);
        tree.allocator.destroy(root);
    }
}

// Ported function 8: KDTree_freeRecursive
fn KDTree_freeRecursive(node: ?*KDNode, allocator: std.mem.Allocator) void {
    if (node != null) {
        const n = node.?;
        KDTree_freeRecursive(n.left, allocator);
        KDTree_freeRecursive(n.right, allocator);
        n.deinit();
        allocator.destroy(n);
    }
}

// Test 1: KDTree build with empty points
test "kd tree build empty" {
    var tree = KDTree_init(std.testing.allocator, 2);
    defer KDTree_deinit(&tree);
    
    const points: [0][]const f64 = .{};
    const built_tree = try KDTree_build(std.testing.allocator, &points, 2);
    defer KDTree_deinit(&built_tree);
    
    assert(built_tree.root == null);
}

// Test 2: KDTree build with multiple points
test "kd tree build multiple points" {
    const p1: []const f64 = &[_]f64{ 2, 3 };
    const p2: []const f64 = &[_]f64{ 5, 4 };
    const p3: []const f64 = &[_]f64{ 9, 6 };
    const p4: []const f64 = &[_]f64{ 4, 7 };
    const p5: []const f64 = &[_]f64{ 8, 1 };

    var points: [5][]const f64 = .{ p1, p2, p3, p4, p5 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    defer KDTree_deinit(&tree);

    assert(tree.root != null);
    assert(tree.k == 2);
}

// Test 3: KDTree nearest with empty tree
test "kd tree nearest empty" {
    var tree = KDTree_init(std.testing.allocator, 2);
    defer KDTree_deinit(&tree);
    
    const target: []const f64 = &[_]f64{ 3, 3 };
    const nearest = KDTree_nearest(&tree, target);
    defer std.testing.allocator.free(nearest);
    
    assert(nearest.len == 0);
}

// Test 4: KDTree nearest with tree containing points
test "kd tree nearest with points" {
    const p1: []const f64 = &[_]f64{ 2, 3 };
    const p2: []const f64 = &[_]f64{ 5, 4 };
    const p3: []const f64 = &[_]f64{ 9, 6 };

    var points: [3][]const f64 = .{ p1, p2, p3 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    defer KDTree_deinit(&tree);

    const target: []const f64 = &[_]f64{ 3, 3 };
    const nearest = KDTree_nearest(&tree, target);
    defer std.testing.allocator.free(nearest);

    assert(nearest.len == 2);
    // Should return one of the existing points
    assert(nearest[0] == 2.0 or nearest[0] == 5.0 or nearest[0] == 9.0);
}

// Test 5: KDTree range search
test "kd tree range search" {
    const p1: []const f64 = &[_]f64{ 1, 1 };
    const p2: []const f64 = &[_]f64{ 2, 2 };
    const p3: []const f64 = &[_]f64{ 10, 10 };

    var points: [3][]const f64 = .{ p1, p2, p3 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    defer KDTree_deinit(&tree);

    const center: []const f64 = &[_]f64{ 5, 5 };
    const result = try KDTree_range(&tree, center, 5, std.testing.allocator);
    defer std.testing.allocator.free(result);

    assert(result.len >= 0);
}

// Test 6: KDTree build recursive with single point
test "kd tree build recursive single point" {
    const p1: []const f64 = &[_]f64{ 2, 3 };

    var points: [1][]const f64 = .{ p1 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    defer KDTree_deinit(&tree);

    assert(tree.root != null);
    assert(tree.root.?.point[0] == 2.0);
    assert(tree.root.?.point[1] == 3.0);
}

// Test 7: KDTree deinit cleanup
test "kd tree deinit cleanup" {
    const p1: []const f64 = &[_]f64{ 2, 3 };
    const p2: []const f64 = &[_]f64{ 5, 4 };

    var points: [2][]const f64 = .{ p1, p2 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    
    // Build should allocate memory, deinit should free it
    KDTree_deinit(&tree);
}

// Test 8: KDTree free recursive cleanup
test "kd tree free recursive cleanup" {
    const p1: []const f64 = &[_]f64{ 2, 3 };
    const p2: []const f64 = &[_]f64{ 5, 4 };

    var points: [2][]const f64 = .{ p1, p2 };
    var tree = try KDTree_build(std.testing.allocator, &points, 2);
    
    // Test that freeRecursive cleans up all nodes
    if (tree.root != null) {
        const root = tree.root.?;
        KDTree_freeRecursive(root, tree.allocator);
        tree.allocator.destroy(root);
    }
}