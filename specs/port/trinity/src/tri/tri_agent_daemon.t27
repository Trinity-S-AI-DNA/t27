// t27/specs/port/trinity/src/tri/tri_agent_daemon.t27
// Port of gHashTag/trinity src/tri/tri_agent_daemon.zig @ 5aabfbe8346f (143 lines).
// Roadmap stage 5 of 9 (goal #4547): the hand-written Zig core becomes .t27.
//
// The daemon's side effects stay with the caller: the HTTP heartbeat, task fetch
// and agent registration calls, the git worktree subprocesses, and the
// compile-time host probes (@import("builtin")). The seven entry points keep
// their original names; the six whose bodies only move data in or out carry
// undefined bodies that no test calls, while fetchTask keeps the original's own
// body (return null). The decisions those bodies made are ported as pure
// helpers and asserted by the tests below:
//
//   sendHeartbeat   line 48  -> heartbeatEndpoint(), AgentStatus_toString()
//   fetchTask       line 61  -> taskEndpoint(), taskIdQuery(); null when no tasks
//   createWorktree  line 73  -> WorktreePlan / planWorktree() naming scheme
//   cleanupWorktree line 83  -> cleanupCommands() (remove --force, then prune)
//   registerAgent   line 90  -> registerEndpoint()
//   detectPlatform  line 101 -> platformName() over OsTag
//   detectArch      line 111 -> archName() over ArchTag

module port::trinity::src::tri::tri_agent_daemon;

// Agent daemon configuration (original AgentConfig, lines 11-19). The original's
// field defaults moved into defaultConfig() because .t27 struct literals have no
// default field values.
pub struct AgentConfig {
    agent_id: []const u8,
    orchestrator_url: []const u8,
    poll_interval_ms: u64,
    heartbeat_interval_ms: u64,
    max_retries: u32,
    repo_url: []const u8,
    capabilities: []str,
}

// The original's AgentConfig defaults (lines 12-18); the original's own
// "default config" test (lines 138-142) asserts two of them.
pub fn defaultConfig() -> AgentConfig {
    return AgentConfig {
        agent_id: "ralph-0",
        orchestrator_url: "http://localhost:9090",
        poll_interval_ms: 10_000,
        heartbeat_interval_ms: 30_000,
        max_retries: 3,
        repo_url: "https://github.com/gHashTag/trinity",
        capabilities: ["zig", "vibee", "tri-pipeline", "test", "bench"]
    };
}

// Agent status carried in the heartbeat body (original AgentStatus, lines 22-27).
pub enum AgentStatus { Polling, Working, Completed, Failed, }

// The status string the heartbeat body sends for each status
// (original AgentStatus.toString, lines 28-35).
pub fn AgentStatus_toString(s: AgentStatus) -> []const u8 {
    return switch (s) {
        .Polling => "polling",
        .Working => "working",
        .Completed => "completed",
        .Failed => "failed",
    };
}

// Task handed out by the orchestrator (original Task struct, lines 39-45).
pub struct Task {
    id: []const u8,
    slug: []const u8,
    issue_number: u32,
    description: []const u8,
    branch: []const u8,
}

// Send heartbeat to orchestrator (original lines 48-58).
// Plumbing: HTTP POST to {orchestrator_url}{heartbeatEndpoint()} with body
// {"agent_id": ..., "status": ..., "timestamp": ...}. The caller performs the
// request; the decisions it depends on are heartbeatEndpoint() and
// AgentStatus_toString() below.
pub fn sendHeartbeat(config: AgentConfig, status: AgentStatus) {
    undefined;
}

// REST path sendHeartbeat POSTs to, under config.orchestrator_url (line 56).
pub fn heartbeatEndpoint() -> []const u8 {
    return "/api/v1/swarm/heartbeat";
}

// Fetch next task from orchestrator (original lines 61-70).
// Plumbing: HTTP GET to {orchestrator_url}{taskEndpoint()}?{taskIdQuery()}={agent_id}.
// Like the original, null means no tasks available.
pub fn fetchTask(config: AgentConfig) -> ?Task {
    return null;
}

// REST path fetchTask GETs from, under config.orchestrator_url (line 67).
pub fn taskEndpoint() -> []const u8 {
    return "/api/v1/swarm/task";
}

// Query parameter fetchTask passes its agent_id in (line 67).
pub fn taskIdQuery() -> []const u8 {
    return "agent_id";
}

// The worktree naming scheme createWorktree decides on (original lines 77-79):
// git worktree add /tmp/trinity-{task.id} -b ralph/{task.branch}, returning the
// branch "ralph/" ++ task.branch. .t27 does not concatenate strings, so the two
// halves travel as a plan and the caller joins them.
pub struct WorktreePlan {
    dir_prefix: []const u8,
    dir_name: []const u8,
    branch_prefix: []const u8,
    branch_name: []const u8,
}

// The plan for a task: directory /tmp/trinity-{id}, branch ralph/{branch}.
pub fn planWorktree(id: []const u8, branch: []const u8) -> WorktreePlan {
    return WorktreePlan {
        dir_prefix: "/tmp/trinity-",
        dir_name: id,
        branch_prefix: "ralph/",
        branch_name: branch
    };
}

// Create git worktree for task (original lines 73-80).
// Plumbing: git worktree add {dir_prefix}{dir_name} -b {branch_prefix}{branch_name}
// for planWorktree(task.id, task.branch). The caller performs the git call.
pub fn createWorktree(task: Task) -> []const u8 {
    undefined;
}

// Cleanup git worktree after task completion (original lines 83-87).
// Plumbing: git {first command from cleanupCommands()} on the path, then the
// second. The caller performs the git calls; the original discards the path
// argument exactly the same way.
pub fn cleanupWorktree(path: []const u8) {
    undefined;
}

// The git invocations cleanupWorktree decides on (original lines 85-86):
// remove with --force, then prune.
pub fn cleanupCommands() -> ([]const u8, []const u8) {
    return ("worktree remove --force", "worktree prune");
}

// Register agent with orchestrator (original lines 90-98).
// Plumbing: HTTP POST to {orchestrator_url}{registerEndpoint()} with body
// {"agent_id": ..., "capabilities": [...]}. The caller performs the request.
pub fn registerAgent(config: AgentConfig) {
    undefined;
}

// REST path registerAgent POSTs to, under config.orchestrator_url (line 96).
pub fn registerEndpoint() -> []const u8 {
    return "/api/v1/swarm/agent/register";
}

// Host OS tags detectPlatform switches over (original lines 102-107). The real
// tag comes from @import("builtin") at compile time; here it is a parameter the
// caller passes in.
pub enum OsTag { Macos, Linux, Windows, }

// The platform string detectPlatform returns: macos and linux named, every
// other host unknown (original switch, lines 103-107).
pub fn platformName(os: OsTag) -> []const u8 {
    return switch (os) {
        .Macos => "macos",
        .Linux => "linux",
        else => "unknown",
    };
}

// Detect host platform (original lines 101-108).
// Plumbing: reads the compile-time host OS tag; the caller probes the host and
// passes it to platformName().
pub fn detectPlatform() -> []const u8 {
    undefined;
}

// Host CPU archs detectArch switches over (original lines 112-117).
pub enum ArchTag { Aarch64, X86_64, Riscv64, }

// The arch string detectArch returns: aarch64 -> "arm64", x86_64 -> "x86_64",
// every other host unknown (original switch, lines 113-117).
pub fn archName(a: ArchTag) -> []const u8 {
    return switch (a) {
        .Aarch64 => "arm64",
        .X86_64 => "x86_64",
        else => "unknown",
    };
}

// Detect CPU architecture (original lines 111-118).
// Plumbing: reads the compile-time host CPU arch; the caller probes the host
// and passes it to archName().
pub fn detectArch() -> []const u8 {
    undefined;
}

// The original's test "agent status toString" (lines 121-126): every variant
// maps to its lowercase wire string.
test status_wire_strings {
    assert(AgentStatus_toString(AgentStatus.Polling) == "polling");
    assert(AgentStatus_toString(AgentStatus.Working) == "working");
    assert(AgentStatus_toString(AgentStatus.Completed) == "completed");
    assert(AgentStatus_toString(AgentStatus.Failed) == "failed");
}

// The original's test "default config" (lines 138-142), widened to every field
// of AgentConfig (lines 12-18).
test default_config_values {
    const cfg = defaultConfig();
    assert(cfg.agent_id == "ralph-0");
    assert(cfg.orchestrator_url == "http://localhost:9090");
    assert(cfg.poll_interval_ms == 10_000);
    assert(cfg.heartbeat_interval_ms == 30_000);
    assert(cfg.max_retries == 3);
    assert(cfg.repo_url == "https://github.com/gHashTag/trinity");
}

// The original's capabilities default (line 18): five entries, "zig" among them.
test default_capabilities {
    const cfg = defaultConfig();
    assert(cfg.capabilities.len == 5);
    var seen: usize = 0;
    var zig_seen: usize = 0;
    for cap in cfg.capabilities {
        seen += 1;
        if (cap == "zig") {
            zig_seen += 1;
        }
    }
    assert(seen == 5);
    assert(zig_seen == 1);
}

// The REST paths the three HTTP calls decide on (lines 56, 67, 96) and the
// agent_id query parameter (line 67).
test endpoints {
    assert(heartbeatEndpoint() == "/api/v1/swarm/heartbeat");
    assert(taskEndpoint() == "/api/v1/swarm/task");
    assert(taskIdQuery() == "agent_id");
    assert(registerEndpoint() == "/api/v1/swarm/agent/register");
}

// The original's fetchTask returns null (line 69): no tasks available.
test fetch_no_tasks {
    const cfg = defaultConfig();
    const m = fetchTask(cfg);
    assert(m == null);
}

// The worktree naming scheme (lines 77-79): /tmp/trinity-{id} and
// ralph/{branch}, joined by the caller.
test worktree_naming_scheme {
    const p = planWorktree("9151", "ralph-0/issue-9151");
    assert(p.dir_prefix == "/tmp/trinity-");
    assert(p.dir_name == "9151");
    assert(p.branch_prefix == "ralph/");
    assert(p.branch_name == "ralph-0/issue-9151");
    const t = Task { id: "9151", slug: "port-agent-daemon", issue_number: 9151, description: "port the agent daemon", branch: "ralph-0/issue-9151" };
    const q = planWorktree(t.id, t.branch);
    assert(q.dir_name == "9151");
    assert(q.branch_name == "ralph-0/issue-9151");
}

// The git invocations cleanupWorktree decides on (lines 85-86).
test cleanup_invocations {
    const (remove_cmd, prune_cmd) = cleanupCommands();
    assert(remove_cmd == "worktree remove --force");
    assert(prune_cmd == "worktree prune");
}

// The platform switch (lines 103-107): macos and linux named, everything
// else unknown.
test platform_switch {
    assert(platformName(OsTag.Macos) == "macos");
    assert(platformName(OsTag.Linux) == "linux");
    assert(platformName(OsTag.Windows) == "unknown");
}

// The arch switch (lines 113-117): aarch64 and x86_64 named, everything
// else unknown.
test arch_switch {
    assert(archName(ArchTag.Aarch64) == "arm64");
    assert(archName(ArchTag.X86_64) == "x86_64");
    assert(archName(ArchTag.Riscv64) == "unknown");
}

// The Task record the orchestrator hands over (lines 39-45) carries all five
// fields intact.
test task_record {
    const t = Task { id: "42", slug: "fix-loop", issue_number: 42, description: "fix the loop", branch: "ralph-0/fix-loop" };
    assert(t.id == "42");
    assert(t.slug == "fix-loop");
    assert(t.issue_number == 42);
    assert(t.description == "fix the loop");
    assert(t.branch == "ralph-0/fix-loop");
}
