// phi^2 + 1/phi^2 = 3 | TRINITY

module port::trinity::src::trinity_workspace;

pub struct Workspace {
    root : []const u8,
    read_only : bool,
};

// trinity_workspace.zig: workspace_open(path) -- open a workspace at path.
pub fn Workspace_open(path: []const u8) -> Workspace {
    return Workspace {
        root: path,
        read_only: false,
    };
}

// trinity_workspace.zig: workspace_read_only(w) -- make workspace read-only.
pub fn Workspace_read_only(w: Workspace) -> Workspace {
    var r : Workspace = w;
    r.read_only = true;
    return r;
}

// ---- Tests ----------------------------------------------------------------
test "workspace_open sets root and read_only false" {
    var w = Workspace_open("specs/");
    assert(w.read_only == false);
}

test "workspace_read_only sets flag" {
    var w = Workspace_open("specs/");
    w = Workspace_read_only(w);
    assert(w.read_only == true);
}

invariant workspace_defaults_to_writable {
    var w = Workspace_open("x");
    assert w.read_only == false;
}