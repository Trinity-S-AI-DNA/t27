module port::trinity::src::depin::swarm_watch;

// Sacred constants
pub const PHI: f64 = 1.618033988749895;
pub const PHI_INV: f64 = 0.618033988749895;
pub const PHI_SQ: f64 = 2.618033988749895;
pub const TRINITY: f64 = 3.0;

/// Verify TRINITY identity: phi^2 + 1/phi^2 = 3
pub fn verifyTrinity() f64 {
    return PHI * PHI + 1.0 / (PHI * PHI);
}

/// Golden-ratio interpolation: t^PHI_INV, the original's
/// std.math.pow(f64, t, PHI_INV) written as exp(PHI_INV * log(t)).
pub fn phiLerp(a: f64, b: f64, t: f64) f64 {
    const phi_t = exp(PHI_INV * log(t));
    return a + (b - a) * phi_t;
}

test phi_constants {
    // vars keep the arithmetic off the compile-time path so the asserts
    // really execute: phi * phi^-1 = 1 and phi^2 = phi + 1
    var phi: f64 = PHI;
    var phi_inv: f64 = PHI_INV;
    var product: f64 = phi * phi_inv;
    assert(product > 0.999999999);
    assert(product < 1.000000001);
    var phi_sq: f64 = PHI_SQ;
    var gap: f64 = phi_sq - phi;
    assert(gap > 0.999999999);
    assert(gap < 1.000000001);
}

test trinity_identity {
    assert(TRINITY - verifyTrinity() < 1e-10);
}

test phi_lerp_is_power_based_not_linear {
    // t^PHI_INV, not t: at t = 0.5 the golden exponent lands near 0.6515
    // (0.5^0.618...), where the linear read the port first carried would
    // be 0.5
    const result = phiLerp(0.0, 10.0, 0.5);
    assert(result > 6.4);
    assert(result < 6.7);
    // t = 0.25: 0.25^0.618... is near 0.4247, not 0.25
    const quarter = phiLerp(0.0, 10.0, 0.25);
    assert(quarter > 4.1);
    assert(quarter < 4.4);
}

test phi_lerp_endpoints {
    // pow(1, p) = 1 for any p, so t = 1 lands exactly on b
    const one = phiLerp(0.0, 10.0, 1.0);
    assert(one > 9.999999);
    assert(one < 10.000001);
    // a == b: the interpolation cannot move
    const flat = phiLerp(7.5, 7.5, 0.5);
    assert(flat > 7.499999);
    assert(flat < 7.500001);
}