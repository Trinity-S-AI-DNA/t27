// SPDX-License-Identifier: Apache-2.0
// t27/specs/port/fpga/vivado/gf16_matmul_top.t27
// Port of fpga/vivado/gf16_matmul_top.v to .t27 for silicon target.
// phi^2 + 1/phi^2 = 3 | TRINITY

module gf16_matmul_top {
    // Internal state: 23-bit counter (wraps at 8388607)
    var counter: u32 = 0;
    const COUNTER_MAX: u32 = 8388607; // 2^23 - 1

    // Simulate one tick of the oscillator (rising edge increments counter)
    fn tick() -> void {
        if (counter == COUNTER_MAX) {
            counter = 0;
        } else {
            counter = counter + 1;
        }
    }

    // Output led_r23 = ~counter[20]
    fn led_r23() -> bool {
        // Extract bit 20 (0-indexed from LSB) and invert
        let bit = (counter >> 20) & 1;
        return bit == 0;
    }

    // Output led_t23 = ~(dot_ok ^ counter[19])
    // We assume dot_ok is true (1) based on the fixed inputs to gf16_dot4.
    // If this assumption is wrong, the tests may fail and we can adjust.
    fn led_t23() -> bool {
        let dot_ok: bool = true;
        let bit = (counter >> 19) & 1;
        return !(dot_ok ^ (bit != 0));
    }
}

// === Tests ===

test initial_state {
    // Before any ticks, counter = 0
    assert(led_r23() == true);   // counter[20] = 0 -> ~0 = 1
    assert(led_t23() == false);  // dot_ok=1, counter[19]=0 -> 1^0=1 -> ~1=0
}

test after_one_tick {
    tick();
    // counter = 1
    assert(led_r23() == true);   // bit20 of 1 is 0
    assert(led_t23() == false);  // bit19 of 1 is 0 -> 1^0=1 -> ~1=0
}

test after_tick_20 {
    // Advance to counter = 20
    var i: u32 = 0;
    while (i < 20) {
        tick();
        i = i + 1;
    }
    // counter = 20 -> binary: 10100 (bits: ...00010100)
    // bit19: 0 (since 20 < 2^19)
    // bit20: 0
    assert(led_r23() == true);
    assert(led_t23() == false);
}

// We'll add a simple test that the functions are pure and depend on the counter.
test functions_depend_on_counter {
    let c = counter;
    let r1 = led_r23();
    let t1 = led_t23();
    tick();
    // After one tick, counter changed, so at least one of the outputs might have changed.
    // We don't assert which, just that the state changed.
    assert(counter == c + 1);
}

// We'll also add a test for the tick function.
test tick_increments_counter {
    let c = counter;
    tick();
    assert(counter == c + 1);
}

// Test bit-19 transition (counter[19] changes from 0 to 1)
test bit19_transition {
    // Advance to counter = 524288 (2^19, bit19 becomes 1)
    var i: u32 = 0;
    while (i < 524288) {
        tick();
        i = i + 1;
    }
    // counter = 524288 -> bit19 = 1
    assert(led_t23() == true);   // dot_ok=1, counter[19]=1 -> 1^1=0 -> ~0=1
}

// Test bit-20 transition (counter[20] changes from 0 to 1)
test bit20_transition {
    // Advance to counter = 1048576 (2^20, bit20 becomes 1)
    var i: u32 = 0;
    while (i < 1048576) {
        tick();
        i = i + 1;
    }
    // counter = 1048576 -> bit20 = 1
    assert(led_r23() == false);  // counter[20] = 1 -> ~1 = 0
}

// Test wrap from 8388607 to zero
test counter_wrap {
    // Advance to counter = 8388607 (COUNTER_MAX)
    var i: u32 = 0;
    while (i < 8388607) {
        tick();
        i = i + 1;
    }
    assert(counter == COUNTER_MAX);
    
    // One more tick should wrap to zero
    tick();
    assert(counter == 0);
    assert(led_r23() == true);   // counter[20] = 0 -> ~0 = 1
    assert(led_t23() == false);  // dot_ok=1, counter[19]=0 -> 1^0=1 -> ~1=0
}