// Port of fpga/vivado/matmul_serial_io.v (Verilog, 1 module) to specs/port/fpga/vivado/matmul_serial_io.t27.
// Part of M6 milestone (milestone #10). Closes #12312.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::fpga::vivado::matmul_serial_io;

pub const MATMUL_SERIAL_IO_WIDTH : u32 = 16;

pub struct MatmulSerialIo { a: u32, b: u32, result: u32 };

pub fn matmul_serial_io_compute(m: MatmulSerialIo) -> u32 {
    return m.a * m.b;
}

test "matmul_serial_io_compute" {
    assert(matmul_serial_io_compute(MatmulSerialIo { a: 3, b: 4, result: 0 }) == 12);
    assert(matmul_serial_io_compute(MatmulSerialIo { a: 0, b: 100, result: 0 }) == 0);
}

invariant matmul_serial_io_width_positive {
    assert MATMUL_SERIAL_IO_WIDTH > 0;
}