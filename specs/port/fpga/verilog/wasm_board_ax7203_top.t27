// Port of fpga/verilog/wasm_board_ax7203_top.v (Verilog, 1 module) to specs/port/fpga/verilog/wasm_board_ax7203_top.t27.
// Part of M6 milestone (milestone #10). Closes #12761.
// phi^2 + 1/phi^2 = 3 | TRINITY

module port::fpga::verilog::wasm_board_ax7203_top;

pub const AX7203_TOP_PINS : u32 = 484;

pub struct BoardTop { pin_count: u32, initialized: bool };

pub fn board_top_initialized(b: BoardTop) -> bool {
    return b.initialized;
}

pub fn board_top_pin_count(b: BoardTop) -> u32 {
    return b.pin_count;
}

test "board_top_pin_count" {
    assert(AX7203_TOP_PINS == 484);
    assert(board_top_pin_count(BoardTop { pin_count: 484, initialized: true }) == 484);
}

test "board_top_initialized" {
    assert(board_top_initialized(BoardTop { pin_count: 484, initialized: true }));
    assert(!board_top_initialized(BoardTop { pin_count: 484, initialized: false }));
}

invariant ax7203_top_pins_defined {
    assert AX7203_TOP_PINS == 484;
}