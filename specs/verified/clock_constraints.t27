// SPDX-License-Identifier: Apache-2.0
; specs/verified/clock_constraints.t27 -- the clock constraints `t27c silicon` places a design against, where
; they come from, and whether the build nextpnr placed may be loaded (gHashTag/t27#8839, FPGA row of
; gHashTag/trios#1763). It replaces specs/pins/emitter_xdc.t27 as the source of constraint text: that file is
; in the old dialect, nothing calls it, and its tests disagree with it (#7580).
; --
; The global target (W818, T542). With no `--freq` and no constraint, nextpnr-xilinx checks every clock at
; 12 MHz, a number from nowhere, while CFGMCLK on the bench dice measured 70.77, 68.49 and 67.20 MHz (T495):
; every design placed until then had been checked 5.7x below the rate it ran at, and gft_bitnet_neuron,
; declared verified on three dice, closed at 11.26 MHz. A design that must run on every die has to meet the
; fastest one, so GLOBAL_FREQ_MHZ is 70.77, the highest measured value, not the mean.
; --
; A divided clock (W819, T544; #8839). `--freq` is global, and a BUFG divider changes nothing in nextpnr's
; report: its timing engine never learns the ratio (T541). Until #8839 the only way to declare a slower
; domain was a hand-written `<top>.xdc` beside the wrapper, a foreign file that no .t27 source generated. So
; a top written wholly in .t27 that divides its clock could not pass the gate even when every domain met its
; own period: specs/queen/actors_hw_top.t27 routed slow__O at 57.84 MHz, ran it at 8.85 MHz, and was refused
; at 70.77.
; Now the period is declared where the clock is made: a .t27 constant `<instance>_<output>_PERIOD_PS` (the
; clock declaration of specs/tri/t27b/verilog_plan.t27), which `t27b verilog` writes on the output's wire,
;     (* t27_period_ps = 113040 *)
;     wire slow__O;
; and this file turns each such attribute in the top into one nextpnr constraint:
;     create_clock -period 113.040 -name slow__O [get_nets slow__O]
; The period is written in ns with three decimals, which is exact: 113040 ps is 113.040 ns. A wire may carry a
; range (`wire [3:0] x;`); the attribute must be followed by `wire`, the name and `;`, or it is malformed.
; --
; Where the constraint comes from (constraint_source), for the last --top file:
;   DECLARED   it carries declarations, all well formed: the generated constraint, and nothing else
;   HAND       it carries none, and a `<top>.xdc` sits beside it: that file, as W819 had it, kept for the
;              hand-written tops in fpga/verilog that still use it (foreign debt that only shrinks)
;   GLOBAL     neither: every clock at GLOBAL_FREQ_MHZ, as before
;   MALFORMED  a declaration that cannot be read: refused, nothing is built
;   TWO        declarations AND a hand file: two sources of truth for one top, and nothing says which one
;              nextpnr would believe. Refused, nothing is built.
; --
; The gate (timing_gate), read from nextpnr's report. A design that misses its declared period answers about
; settling, not arithmetic (W839), so it is not loaded:
;   PASS       every "Max frequency for clock" line says PASS
;   FAIL       one of them says FAIL
;   UNAPPLIED  nextpnr says a create_clock "constraint was NOT applied": its target matched no net, so that
;              clock was checked at the global target, which says nothing about the period declared (and a
;              declaration faster than the global target would pass unchecked). Refused like a FAIL. The
;              warning is the bench's nextpnr-xilinx (openXC7 fork, xilinx/xdc.cc); a build that drops a
;              target silently cannot be told apart here.
;   NONE       no Fmax line at all: loaded as before, with the note that timing is not established
; Honest limits: a declaration is a claim about the clock the hardware makes. The design's own tests tie it to
; the divider (actors_hw_top.t27, the_clocks_are_declared_at_the_rates_they_run); this file only carries it.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedClockConstraints;

use verified::bench_boards;
use verified::corpus_receipt;
use isa::t27a;

/// The frequency nextpnr checks a clock at unless a declaration says otherwise, in MHz (`--freq`).
pub const GLOBAL_FREQ_MHZ : string = "70.77";

/// The attribute t27b writes on a declared clock's wire, up to its value; what closes it; the wire.
pub const PERIOD_ATTR : string = "(* t27_period_ps = ";
pub const ATTR_CLOSE : string = " *)";
pub const WIRE_WORD : string = "wire ";

/// The pieces of one constraint line, between the period and the two copies of the net's name.
pub const XDC_HEAD : string = "create_clock -period ";
pub const XDC_NAME : string = " -name ";
pub const XDC_NETS : string = " [get_nets ";
pub const XDC_TAIL : string = "]\n";

/// How many declarations the top's Verilog v carries.
pub fn decl_count(v: string) -> u32 {
    var n : u32 = 0;
    var at : u32 = text_next(v, PERIOD_ATTR, 0);
    while (at != NOT_FOUND) {
        n = n + 1;
        at = text_next(v, PERIOD_ATTR, at + 1);
    }
    return n;
}

/// Where declaration n (from 0) starts; NOT_FOUND when there are not n + 1.
pub fn decl_at(v: string, n: u32) -> u32 {
    var k : u32 = 0;
    var at : u32 = text_next(v, PERIOD_ATTR, 0);
    while (at != NOT_FOUND and k < n) {
        k = k + 1;
        at = text_next(v, PERIOD_ATTR, at + 1);
    }
    return at;
}

/// Does v hold the bytes of w at `at`?
pub fn bytes_at(v: string, at: u32, w: string) -> bool {
    if (at + (w.len as u32) > (v.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < (w.len as u32)) {
        if ((v[at + k] as u32) != (w[k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

/// Where the run of decimal digits that starts at `at` ends.
pub fn digit_run_end(v: string, at: u32) -> u32 {
    var i : u32 = at;
    while (i < (v.len as u32) and (v[i] as u32) >= 48 and (v[i] as u32) <= 57) { i = i + 1; }
    return i;
}

/// Is v[i] a byte of a plain Verilog name: a letter, a digit, `_` or `$`?
pub fn name_byte(v: string, i: u32) -> bool {
    if (i >= (v.len as u32)) { return false; }
    const c : u32 = v[i] as u32;
    if (c >= 97 and c <= 122) { return true; }
    if (c >= 65 and c <= 90) { return true; }
    if (c >= 48 and c <= 57) { return true; }
    return c == 95 or c == 36;
}

/// The period of the declaration at `at`, in ps; 0 when its value is no number, is 0, or is not closed by
/// ATTR_CLOSE.
pub fn decl_period(v: string, at: u32) -> u32 {
    const p : u32 = at + (PERIOD_ATTR.len as u32);
    const q : u32 = digit_run_end(v, p);
    if (q == p or !bytes_at(v, q, ATTR_CLOSE)) { return 0; }
    const ps : u32 = decimal_at(v, p);
    if (ps == NOT_FOUND) { return 0; }
    return ps;
}

/// Where the name of the wire the declaration at `at` sits on starts: after ATTR_CLOSE, white space, `wire `
/// and an optional range, a name ended by `;`. NOT_FOUND when the declaration is not so followed.
pub fn decl_net_lo(v: string, at: u32) -> u32 {
    const p : u32 = at + (PERIOD_ATTR.len as u32);
    var q : u32 = digit_run_end(v, p);
    if (q == p or !bytes_at(v, q, ATTR_CLOSE)) { return NOT_FOUND; }
    q = q + (ATTR_CLOSE.len as u32);
    while (q < (v.len as u32) and ((v[q] as u32) == 32 or (v[q] as u32) == 10 or (v[q] as u32) == 13 or (v[q] as u32) == 9)) { q = q + 1; }
    if (!bytes_at(v, q, WIRE_WORD)) { return NOT_FOUND; }
    q = q + (WIRE_WORD.len as u32);
    if (q < (v.len as u32) and (v[q] as u32) == 91) {
        while (q < (v.len as u32) and (v[q] as u32) != 93) { q = q + 1; }
        if (q >= (v.len as u32)) { return NOT_FOUND; }
        q = q + 1;
        while (q < (v.len as u32) and (v[q] as u32) == 32) { q = q + 1; }
    }
    var e : u32 = q;
    while (name_byte(v, e)) { e = e + 1; }
    if (e == q or e >= (v.len as u32) or (v[e] as u32) != 59) { return NOT_FOUND; }
    return q;
}

/// Where that name ends (its `;`); NOT_FOUND when the declaration is malformed.
pub fn decl_net_hi(v: string, at: u32) -> u32 {
    const q : u32 = decl_net_lo(v, at);
    if (q == NOT_FOUND) { return NOT_FOUND; }
    var e : u32 = q;
    while (name_byte(v, e)) { e = e + 1; }
    return e;
}

/// Is the declaration at `at` well formed: a period that is no 0, on a wire with a name?
pub fn decl_ok(v: string, at: u32) -> bool {
    return decl_period(v, at) != 0 and decl_net_lo(v, at) != NOT_FOUND;
}

// ----------------------------------------------------------------------------------------------------------
// The constraint text: one line per declaration, in the order of the top,
//     create_clock -period <ns> -name <net> [get_nets <net>]
// ----------------------------------------------------------------------------------------------------------

/// The length of a period of ps picoseconds written in ns: the whole ns, `.`, three digits. The digits are
/// specs/isa/t27a.t27's dec_len and dec_char.
pub fn ns_len(ps: u32) -> u32 {
    return dec_len(ps / 1000) + 4;
}

/// Byte k of that text.
pub fn ns_char(ps: u32, k: u32) -> u8 {
    const whole : u32 = ps / 1000;
    const d : u32 = dec_len(whole);
    if (k < d) { return dec_char(whole, d, k) as u8; }
    if (k == d) { return 46; }
    return dec_char(ps % 1000, 3, k - d - 1) as u8;
}

/// The length of piece p (0 to 6) of the constraint line of the declaration at `at`.
pub fn xdc_piece_len(v: string, at: u32, p: u32) -> u32 {
    if (p == 0) { return XDC_HEAD.len as u32; }
    if (p == 1) { return ns_len(decl_period(v, at)); }
    if (p == 2) { return XDC_NAME.len as u32; }
    if (p == 4) { return XDC_NETS.len as u32; }
    if (p == 6) { return XDC_TAIL.len as u32; }
    return decl_net_hi(v, at) - decl_net_lo(v, at);
}

/// Byte k of piece p of that line.
pub fn xdc_piece_char(v: string, at: u32, p: u32, k: u32) -> u8 {
    if (p == 0) { return XDC_HEAD[k]; }
    if (p == 1) { return ns_char(decl_period(v, at), k); }
    if (p == 2) { return XDC_NAME[k]; }
    if (p == 4) { return XDC_NETS[k]; }
    if (p == 6) { return XDC_TAIL[k]; }
    return v[decl_net_lo(v, at) + k];
}

/// The length of the constraint line of the declaration at `at`.
pub fn xdc_line_len(v: string, at: u32) -> u32 {
    var n : u32 = 0;
    var p : u32 = 0;
    while (p < 7) {
        n = n + xdc_piece_len(v, at, p);
        p = p + 1;
    }
    return n;
}

/// Byte k of that line.
pub fn xdc_line_char(v: string, at: u32, k: u32) -> u8 {
    var p : u32 = 0;
    var r : u32 = k;
    while (p < 6 and r >= xdc_piece_len(v, at, p)) {
        r = r - xdc_piece_len(v, at, p);
        p = p + 1;
    }
    return xdc_piece_char(v, at, p, r);
}

/// The length of the whole constraint text of the top's Verilog v: a line per well-formed declaration.
pub fn xdc_len(v: string) -> u32 {
    var n : u32 = 0;
    var at : u32 = text_next(v, PERIOD_ATTR, 0);
    while (at != NOT_FOUND) {
        if (decl_ok(v, at)) { n = n + xdc_line_len(v, at); }
        at = text_next(v, PERIOD_ATTR, at + 1);
    }
    return n;
}

/// Byte k of that text.
pub fn xdc_char(v: string, k: u32) -> u8 {
    var r : u32 = k;
    var at : u32 = text_next(v, PERIOD_ATTR, 0);
    while (at != NOT_FOUND) {
        if (decl_ok(v, at)) {
            const n : u32 = xdc_line_len(v, at);
            if (r < n) { return xdc_line_char(v, at, r); }
            r = r - n;
        }
        at = text_next(v, PERIOD_ATTR, at + 1);
    }
    return 0;
}

// ----------------------------------------------------------------------------------------------------------
// Where the constraint comes from.
// ----------------------------------------------------------------------------------------------------------

pub const SRC_GLOBAL : u8 = 0;
pub const SRC_DECLARED : u8 = 1;
pub const SRC_HAND : u8 = 2;
pub const SRC_MALFORMED : u8 = 3;
pub const SRC_TWO : u8 = 4;

/// The source of the constraint for the top's Verilog v, `hand` telling whether a `<top>.xdc` sits beside it.
pub fn constraint_source(v: string, hand: bool) -> u8 {
    const n : u32 = decl_count(v);
    if (n == 0) {
        if (hand) { return SRC_HAND; }
        return SRC_GLOBAL;
    }
    var k : u32 = 0;
    while (k < n) {
        if (!decl_ok(v, decl_at(v, k))) { return SRC_MALFORMED; }
        k = k + 1;
    }
    if (hand) { return SRC_TWO; }
    return SRC_DECLARED;
}

/// Is nothing built for this source?
pub fn source_refuses(src: u8) -> bool {
    return src == SRC_MALFORMED or src == SRC_TWO;
}

/// The name of the place-and-route stage for this source.
pub fn source_stage(src: u8) -> string {
    if (src == SRC_DECLARED) { return "nextpnr + declared clocks, Fmax"; }
    if (src == SRC_HAND) { return "nextpnr + hand XDC, Fmax"; }
    return "nextpnr @70.77MHz, Fmax";
}

/// Why a source refuses.
pub fn source_why(src: u8) -> string {
    if (src == SRC_MALFORMED) { return "the top carries a clock declaration `(* t27_period_ps = N *)` that is not followed by `wire <name>;` or whose period is no number above 0 (specs/verified/clock_constraints.t27)"; }
    if (src == SRC_TWO) { return "the top declares its clocks AND a <top>.xdc sits beside it: two sources for one top's constraints; delete the .xdc (specs/verified/clock_constraints.t27)"; }
    return "";
}

// ----------------------------------------------------------------------------------------------------------
// The gate, read from nextpnr's stderr.
// ----------------------------------------------------------------------------------------------------------

pub const GATE_PASS : u8 = 0;
pub const GATE_FAIL : u8 = 1;
pub const GATE_UNAPPLIED : u8 = 2;
pub const GATE_NONE : u8 = 3;

pub const FMAX_KEY : string = "Max frequency for clock";
pub const UNAPPLIED_KEY : string = "constraint was NOT applied";
pub const FAIL_WORD : string = "FAIL";

/// The gate's verdict on nextpnr's stderr.
pub fn timing_gate(err: string) -> u8 {
    if (text_next(err, UNAPPLIED_KEY, 0) != NOT_FOUND) { return GATE_UNAPPLIED; }
    var at : u32 = text_next(err, FMAX_KEY, 0);
    if (at == NOT_FOUND) { return GATE_NONE; }
    while (at != NOT_FOUND) {
        const e : u32 = line_end(err, at);
        const f : u32 = text_next(err, FAIL_WORD, at);
        if (f != NOT_FOUND and f < e) { return GATE_FAIL; }
        at = text_next(err, FMAX_KEY, at + 1);
    }
    return GATE_PASS;
}

/// May the build be loaded?
pub fn gate_loads(g: u8) -> bool {
    return g == GATE_PASS or g == GATE_NONE;
}

/// Why the gate refused.
pub fn gate_why(g: u8) -> string {
    if (g == GATE_FAIL) { return "nextpnr reports the design MISSES its declared period"; }
    if (g == GATE_UNAPPLIED) { return "nextpnr did NOT apply a declared clock constraint (its net matched nothing), so that clock was checked at the global target, not at its declaration"; }
    return "";
}

// ----------------------------------------------------------------------------------------------------------
// Tests. The texts are what t27b verilog writes for specs/queen/actors_hw_top.t27 and what the bench's
// nextpnr-xilinx printed for it (seed 1, xc7a200tfbg484-2, 2026-10-10), cut to the lines that matter.
// ----------------------------------------------------------------------------------------------------------

/// Is the constraint text of v exactly w?
fn xdc_is(v: string, w: string) -> bool {
    if (xdc_len(v) != (w.len as u32)) { return false; }
    var k : u32 = 0;
    while (k < (w.len as u32)) {
        if ((xdc_char(v, k) as u32) != (w[k] as u32)) { return false; }
        k = k + 1;
    }
    return true;
}

test the_top_s_declarations_become_create_clock_lines {
    const v : string = "    wire startup__CFGMCLK;\n    (* t27_period_ps = 14130 *)\n    wire gclk__O;\n    wire clk;\n    (* t27_period_ps = 113040 *)\n    wire slow__O;\n    wire bscan__TCK;\n";
    assert decl_count(v) == 2;
    assert decl_period(v, decl_at(v, 0)) == 14130 and decl_period(v, decl_at(v, 1)) == 113040;
    assert decl_at(v, 2) == NOT_FOUND;
    assert xdc_is(v, "create_clock -period 14.130 -name gclk__O [get_nets gclk__O]\ncreate_clock -period 113.040 -name slow__O [get_nets slow__O]\n");
    assert constraint_source(v, false) == SRC_DECLARED;
    assert text_is(source_stage(SRC_DECLARED), "nextpnr + declared clocks, Fmax");
}

test periods_are_written_in_ns_exactly {
    var out : [12]u8 = undefined;
    var ps : u32 = 113040;
    var k : u32 = 0;
    while (k < ns_len(ps)) {
        out[k] = ns_char(ps, k);
        k = k + 1;
    }
    assert ns_len(ps) == 7 and out[0] == 49 and out[2] == 51 and out[3] == 46 and out[4] == 48 and out[6] == 48;
    // 5 ps is 0.005 ns, and 1000000 ps is 1000.000 ns
    ps = 5;
    assert ns_len(ps) == 5 and ns_char(ps, 0) == 48 and ns_char(ps, 1) == 46 and ns_char(ps, 4) == 53;
    ps = 1000000;
    assert ns_len(ps) == 8 and ns_char(ps, 0) == 49 and ns_char(ps, 3) == 48 and ns_char(ps, 4) == 46;
    // 4294967295 ps is 4294967.295 ns
    ps = 4294967295;
    assert ns_len(ps) == 11 and ns_char(ps, 6) == 55 and ns_char(ps, 7) == 46 and ns_char(ps, 10) == 53;
}

test a_wire_with_a_range_is_named_without_it {
    const v : string = "    (* t27_period_ps = 40000 *)\n    wire [3:0] div__Q;\n";
    assert decl_ok(v, 4);
    assert xdc_is(v, "create_clock -period 40.000 -name div__Q [get_nets div__Q]\n");
}

test no_declaration_keeps_the_global_target_or_the_hand_file {
    const v : string = "    wire gclk__O;\n    wire slow__O;\n";
    assert decl_count(v) == 0 and xdc_len(v) == 0;
    assert constraint_source(v, false) == SRC_GLOBAL;
    assert constraint_source(v, true) == SRC_HAND;
    assert !source_refuses(SRC_GLOBAL) and !source_refuses(SRC_HAND) and !source_refuses(SRC_DECLARED);
    assert text_is(GLOBAL_FREQ_MHZ, "70.77");
    assert text_is(source_stage(SRC_GLOBAL), "nextpnr @70.77MHz, Fmax");
}

test a_declaration_and_a_hand_file_are_refused {
    const v : string = "    (* t27_period_ps = 113040 *)\n    wire slow__O;\n";
    assert constraint_source(v, true) == SRC_TWO;
    assert source_refuses(SRC_TWO);
}

test a_malformed_declaration_is_refused_and_writes_nothing {
    // no wire after it, a period of 0, no number, no closing, a name with no `;`
    const a : string = "    (* t27_period_ps = 113040 *)\n    assign x = y;\n";
    const b : string = "    (* t27_period_ps = 0 *)\n    wire slow__O;\n";
    const c : string = "    (* t27_period_ps = slow *)\n    wire slow__O;\n";
    const d : string = "    (* t27_period_ps = 113040 )\n    wire slow__O;\n";
    const e : string = "    (* t27_period_ps = 113040 *)\n    wire slow__O";
    assert constraint_source(a, false) == SRC_MALFORMED and xdc_len(a) == 0;
    assert constraint_source(b, false) == SRC_MALFORMED and xdc_len(b) == 0;
    assert constraint_source(c, false) == SRC_MALFORMED and xdc_len(c) == 0;
    assert constraint_source(d, false) == SRC_MALFORMED and xdc_len(d) == 0;
    assert constraint_source(e, false) == SRC_MALFORMED and xdc_len(e) == 0;
    assert source_refuses(SRC_MALFORMED);
}

test the_gate_reads_nextpnr_s_report {
    // seed 1 at the global target: slow__O misses 70.77 MHz
    const global : string = "Info: Max frequency for clock     'clk': 245.34 MHz (PASS at 70.77 MHz)\nInfo: Max frequency for clock 'slow__O': 57.84 MHz (FAIL at 70.77 MHz)\nInfo: Max frequency for clock     'clk': 229.67 MHz (PASS at 70.77 MHz)\n";
    assert timing_gate(global) == GATE_FAIL and !gate_loads(GATE_FAIL);
    // the same design with slow__O declared at 113.040 ns
    const declared : string = "Info: Max frequency for clock     'clk': 229.67 MHz (PASS at 70.77 MHz)\nInfo: Max frequency for clock 'slow__O': 57.84 MHz (PASS at 8.85 MHz)\n";
    assert timing_gate(declared) == GATE_PASS and gate_loads(GATE_PASS);
    // a declaration whose net nextpnr did not find
    const lost : string = "Warning: create_clock: target [get_nets slw__O] matched nothing, so the 113.040 ns constraint was NOT applied (on line 2). The clock domain keeps the default target and will be reported as meeting timing at that default.\nInfo: Max frequency for clock 'slow__O': 57.84 MHz (PASS at 8.85 MHz)\n";
    assert timing_gate(lost) == GATE_UNAPPLIED and !gate_loads(GATE_UNAPPLIED);
    // no report at all is loaded as before, with its note
    assert timing_gate("Info: Program finished normally.\n") == GATE_NONE and gate_loads(GATE_NONE);
    // a FAIL on a line that is no Fmax line is not the gate's
    assert timing_gate("Info: FAIL count 0\nInfo: Max frequency for clock 'clk': 229.67 MHz (PASS at 70.77 MHz)\n") == GATE_PASS;
}

invariant the_codes_never_move {
    assert SRC_GLOBAL == 0 and SRC_DECLARED == 1 and SRC_HAND == 2 and SRC_MALFORMED == 3 and SRC_TWO == 4;
    assert GATE_PASS == 0 and GATE_FAIL == 1 and GATE_UNAPPLIED == 2 and GATE_NONE == 3;
}
