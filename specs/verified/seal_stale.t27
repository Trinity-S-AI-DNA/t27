// queen_dash.t27 since PR #13418; seals: t27os_T27osQueenDash stale on
// master after #13418 — coverage+spec-guards red.
// Part of M4 milestone (milestone #8). Closes #13435, #13419.
// phi^2 + 1/phi^2 = 3 | TRINITY

module verified::seal_stale;

pub const SEAL_STALE_MAX_RESEALS : u32 = 3;

pub struct SealStatus { spec_id: str, stale: bool, reseal_count: u32 };

pub fn seal_stale(s: SealStatus) -> bool {
    return s.stale && s.reseal_count < SEAL_STALE_MAX_RESEALS;
}

test "seal_stale" {
    assert(seal_stale(SealStatus { spec_id: "t27os_T27osQueenDash", stale: true, reseal_count: 1 }));
    assert(!seal_stale(SealStatus { spec_id: "t27os_T27osQueenDash", stale: false, reseal_count: 0 }));
}

invariant seal_stale_max_reseals_positive {
    assert SEAL_STALE_MAX_RESEALS > 0;
}