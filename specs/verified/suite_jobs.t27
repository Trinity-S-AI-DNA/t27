// SPDX-License-Identifier: Apache-2.0
; specs/verified/suite_jobs.t27 -- how many per-spec `t27c` subprocesses `t27c suite` runs at once. Issue
; gHashTag/t27#8829, hot reload #8737 (step H9), epic #8095.
; --
; Why. `t27c suite --corpus-only` -- CI's Corpus ratchet on every PR -- runs one `t27c <cmd> <spec>` process
; per spec for parse, typecheck, the four gens, seal verify and Fixed Point (two gens of each spec, compared),
; strictly one after another: about 17,000
; spawns, 223 s of a 394 s run (measured 2026-10-11, this Mac, load average ~20). Each of them reads its spec
; and prints to its own pipe; none writes a file. Run side by side, they finish in a fraction of the time.
; --
; Which phases. Every phase whose per-spec work reads the spec and writes nothing: the subprocess phases,
; Fixed Point (each spec's two gens stay on one worker, one after the other, so it still compares two runs
; of the same spec), and the in-process phases 1a2-1a7, which call the compiler on worker threads with the
; main thread's 8 MiB stack -- the compiler keeps no global state but an atomic counter for keys that never
; reach its output. The yosys smoke and the Icarus and cocotb gates write files and stay one at a time.
; The same workers fill frontier's gen-hash cache on a cold walk (gen_hash_cache.t27, #8846).
; --
; The number. The machine's cores, at most SUITE_JOBS_MAX, or T27_SUITE_JOBS when the operator sets it (1
; gives the old sequential run back). Never 0: a suite that runs nothing reports nothing as passing.
; --
; What it does NOT change. Results are folded in file order, so every count, FAIL line and failure list is the
; one a sequential run prints.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedSuiteJobs;

/// At most this many subprocesses at once, however many cores the machine has.
pub const SUITE_JOBS_MAX : u32 = 8;

/// How many per-spec subprocesses run at once. `asked` is T27_SUITE_JOBS (0 when unset).
pub fn suite_jobs(cores: u32, asked: u32) -> u32 {
    var n : u32 = cores;
    if (asked > 0) { n = asked; }
    if (n > SUITE_JOBS_MAX) { n = SUITE_JOBS_MAX; }
    if (n < 1) { n = 1; }
    return n;
}

test suite_jobs_follows_the_cores_up_to_the_cap {
    assert suite_jobs(8, 0) == 8;
    assert suite_jobs(4, 0) == 4;
    // a 64-core runner still runs at most SUITE_JOBS_MAX
    assert suite_jobs(64, 0) == 8;
}

test suite_jobs_takes_the_operators_number {
    // T27_SUITE_JOBS=1 gives the old sequential run back
    assert suite_jobs(8, 1) == 1;
    assert suite_jobs(2, 6) == 6;
    assert suite_jobs(8, 100) == 8;
}

test suite_jobs_is_never_zero {
    assert suite_jobs(0, 0) == 1;
    assert suite_jobs(0, 0) >= 1;
}

invariant the_suite_always_runs_something {
    assert SUITE_JOBS_MAX >= 1;
    assert suite_jobs(0, 0) == 1;
}
