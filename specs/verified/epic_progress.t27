// SPDX-License-Identifier: Apache-2.0
; specs/verified/epic_progress.t27 -- the machine-readable progress state of the EPIC: the roster of
; receipt-verifiable tasks, the derivation of its percentage, and the PASS/FAIL/BLOCKED/next-action
; mapping the Queen's progress reports are made of. Epic gHashTag/t27#6655 (re-filed as
; gHashTag/t27#9395), Phase I progress notifications, criteria 35 and 36.
; --
; What already exists and is NOT restated here:
; - specs/verified/run_record.t27 (R2-4, #7072) owns when receipts are ONE verified run and when a
;   citable run reference exists. A roster bit may be set only behind such a reference; this file
;   composes that rule by calling run_complete, it does not restate it.
; - specs/verified/verdict.t27 (R2-4) owns record_status and the verdict ladder of run references.
;   FAIL below is a progress letter, never a verdict about any run.
; - specs/queen/telemetry.t27 owns what the runtime counts and how records leave it; delivery of a
;   progress report (bot/DM with EPIC id, percentage, phase/task, status, next action) stays there.
; - specs/verified/ternary_link_run.t27 owns the EPIC's current citation of the live chain.
; - specs/verified/independence.t27 (R3-2) owns what a cross-die claim demands; until it has a
;   roster, no cross-die bit may be set.
; --
; What this file adds: nothing but derivation. It stores nothing, persists nothing, adds no
; user-facing surface (criterion 38) and keeps no percentage anywhere (criterion 39: no progress
; ledger). The state is a 9-bit mask, one bit per roster task, set ONLY on verified evidence: a
; citable run reference per run_record.t27. Prose, plans and merged-PR claims do not set bits.
; The roster is the EPIC's receipt-verifiable task set. The Phase A-I arcs and the Phase I
; settlement loop are tracked by their child issues and are not roster tasks here: no percentage
; may grow from prose about them.
; Roster (id == bit position + 1; ids are fixed positions, not priorities):
;   1 TASK_POC              Phase 0 capstone: PoC slot designs and static/wrong-part controls
;                           (specs/verified/poc/, bench runs 2026-10-06, three-seed verdict AGREED)
;   2 TASK_R2_RECEIPTS      receipts persisted by t27c silicon (.trinity/receipts/, PR #7044)
;   3 TASK_R2_TOOLCHAIN     toolchain identity in receipts, built_by (PR #7076)
;   4 TASK_R2_SUPERVISOR    Queen dispatch on fenced per-task leases + event log (BrowserOS#537)
;   5 TASK_R2_RUN_RECORD    one run record per verified run + t27c run-record reader (PRs #7061, #7130)
;   6 TASK_R2_CHAIN         end-to-end chain, three seeded placements, citation spec (issue #7177,
;                           PR #7293)
;   7 TASK_R3_SIGNED        signed receipts with verifier nonce (PRs #7344, #7363)
;   8 TASK_R3_DNA           device-rooted identity, live DNA_PORT in the signed message (PR #7598)
;   9 TASK_R3_INDEPENDENCE  independence across distinct dies (R3-3) -- OPEN: three boards on the
;                           bench, no citable cross-die receipts yet; its bit stays clear.
; As of this revision the recorded state is bits 1..8 set (mask 0x00FF): 8 of 9 verified, percentage
; floor(800/9) = 88, report FAIL, next action TASK_R3_INDEPENDENCE. That sentence is derivable, not
; narrative -- the tests pin it, and a new verified state is a new revision of this file, re-sealed.
; Derived values fail closed. A mask with bits above the roster, or a task both done and blocked,
; is MALFORMED: no percentage, no next action, no PASS. The percentage rounds down; unverified and
; blocked tasks count zero.
; ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

use verified::run_record;

module VerifiedEpicProgress;

; --- 1. The roster: one id per receipt-verifiable EPIC task -------------------------------------

/// Phase 0 capstone: PoC slot designs + static/wrong-part controls (specs/verified/poc/).
pub const TASK_POC : u8 = 1;
/// R2-1: receipts persisted to .trinity/receipts/ by t27c silicon (PR #7044).
pub const TASK_R2_RECEIPTS : u8 = 2;
/// R2-2: toolchain identity in receipts, built_by (PR #7076).
pub const TASK_R2_TOOLCHAIN : u8 = 3;
/// R2-3: Queen dispatch on fenced per-task leases + append-only event log (BrowserOS#537).
pub const TASK_R2_SUPERVISOR : u8 = 4;
/// R2-4: one run record per verified run + t27c run-record reader (PRs #7061, #7130).
pub const TASK_R2_RUN_RECORD : u8 = 5;
/// R2-5: end-to-end chain, three seeded placements, citation spec (issue #7177, PR #7293).
pub const TASK_R2_CHAIN : u8 = 6;
/// R3-1: signed receipts with verifier nonce (PRs #7344, #7363).
pub const TASK_R3_SIGNED : u8 = 7;
/// R3-2: device-rooted identity, live DNA_PORT in the signed message (PR #7598).
pub const TASK_R3_DNA : u8 = 8;
/// R3-3: independence across distinct dies -- OPEN, no citable cross-die receipts yet.
pub const TASK_R3_INDEPENDENCE : u8 = 9;

/// The roster is nine tasks; ids are fixed positions, not priorities.
pub const TASK_TOTAL : u32 = 9;
/// Every roster bit set. Bits above this are not tasks and fail closed.
pub const TASKS_FULL : u32 = 0x000001FF;

; --- 2. Report states: the letters a progress report may carry ---------------------------------

/// Malformed input: out-of-range or overlapping masks. No percentage, no next action.
pub const REPORT_MALFORMED : u8 = 0;
/// Every roster task verified behind a citable run reference.
pub const REPORT_PASS : u8 = 1;
/// Open unblocked work remains; the next action is named by next_open.
pub const REPORT_FAIL : u8 = 2;
/// Open tasks exist but every one of them is blocked; the next action is an unblocking.
pub const REPORT_BLOCKED : u8 = 3;

; --- 3. Derivation -----------------------------------------------------------------------------

fn popcount9(mask: u32) -> u32 {
    var n : u32 = 0;
    if ((mask & 1) == 1) { n = n + 1; }
    if ((mask & 2) == 2) { n = n + 1; }
    if ((mask & 4) == 4) { n = n + 1; }
    if ((mask & 8) == 8) { n = n + 1; }
    if ((mask & 16) == 16) { n = n + 1; }
    if ((mask & 32) == 32) { n = n + 1; }
    if ((mask & 64) == 64) { n = n + 1; }
    if ((mask & 128) == 128) { n = n + 1; }
    if ((mask & 256) == 256) { n = n + 1; }
    return n;
}

/// How many roster tasks the mask marks verified. A state that cannot exist counts zero.
pub fn verified_count(done_mask: u32) -> u32 {
    if (done_mask > TASKS_FULL) { return 0; }
    return popcount9(done_mask);
}

/// The EPIC percentage: floor(verified * 100 / roster), rounded down, never up. Unverified and
/// blocked tasks count zero; an impossible state computes no percentage.
pub fn percent(done_mask: u32) -> u32 {
    if (done_mask > TASKS_FULL) { return 0; }
    return (popcount9(done_mask) * 100) / TASK_TOTAL;
}

/// The report state for a done mask and a disjoint blocked mask. FAIL means open executable work
/// remains; it is not a verdict about any run (verdict.t27 owns verdicts).
pub fn report(done_mask: u32, blocked_mask: u32) -> u8 {
    if (done_mask > TASKS_FULL) { return REPORT_MALFORMED; }
    if (blocked_mask > TASKS_FULL) { return REPORT_MALFORMED; }
    if ((done_mask & blocked_mask) != 0) { return REPORT_MALFORMED; }
    if (done_mask == TASKS_FULL) { return REPORT_PASS; }
    var open_mask : u32 = TASKS_FULL - done_mask;
    if (open_mask == blocked_mask) { return REPORT_BLOCKED; }
    return REPORT_FAIL;
}

/// The lowest set bit's task id, 0 when the mask is empty.
/// Precondition: mask is a subset of TASKS_FULL.
fn first_open(mask: u32) -> u8 {
    if ((mask & 1) == 1) { return 1; }
    if ((mask & 2) == 2) { return 2; }
    if ((mask & 4) == 4) { return 3; }
    if ((mask & 8) == 8) { return 4; }
    if ((mask & 16) == 16) { return 5; }
    if ((mask & 32) == 32) { return 6; }
    if ((mask & 64) == 64) { return 7; }
    if ((mask & 128) == 128) { return 8; }
    if ((mask & 256) == 256) { return 9; }
    return 0;
}

/// The next action: the lowest-numbered open task, an unblocked one preferred over a blocked one.
/// 0 when the roster is complete or the state is malformed: a MALFORMED report names no next
/// action; the caller fixes its masks first.
pub fn next_open(done_mask: u32, blocked_mask: u32) -> u8 {
    if (done_mask > TASKS_FULL) { return 0; }
    if (blocked_mask > TASKS_FULL) { return 0; }
    if ((done_mask & blocked_mask) != 0) { return 0; }
    var open_mask : u32 = TASKS_FULL - done_mask;
    if (open_mask == 0) { return 0; }
    var unblocked_mask : u32 = open_mask - blocked_mask;
    if (unblocked_mask != 0) { return first_open(unblocked_mask); }
    return first_open(open_mask);
}

; --- 4. Tests -----------------------------------------------------------------------------------

test "the roster is nine tasks and the full mask is all of them" {
    assert TASK_TOTAL == 9;
    assert TASKS_FULL == 0x1FF;
    assert TASK_POC == 1;
    assert TASK_R3_INDEPENDENCE == 9;
    // runtime anchor: the whole roster counted through the derivation is nine
    assert verified_count(TASKS_FULL) == TASK_TOTAL;
}

test "an empty state has no percentage" {
    assert percent(0) == 0;
    assert verified_count(0) == 0;
}

test "the percentage rounds down, never up" {
    assert percent(1) == 11;
    assert percent(0x000F) == 44;
    assert percent(TASKS_FULL) == 100;
}

test "the recorded state is eight of nine, floor eighty-eight" {
    assert verified_count(0x00FF) == 8;
    assert percent(0x00FF) == 88;
}

test "a state that cannot exist computes no percentage" {
    assert percent(0x03FF) == 0;
    assert verified_count(0x0200) == 0;
    assert report(0x0200, 0) == REPORT_MALFORMED;
    assert report(0, 0x0200) == REPORT_MALFORMED;
}

test "a task both done and blocked is malformed" {
    assert report(0x0001, 0x0001) == REPORT_MALFORMED;
    assert next_open(0x0001, 0x0001) == 0;
    assert next_open(0x0300, 0) == 0;
}

test "all nine verified is PASS" {
    assert report(TASKS_FULL, 0) == REPORT_PASS;
}

test "the recorded state is FAIL and the open task is named" {
    assert report(0x00FF, 0) == REPORT_FAIL;
    assert next_open(0x00FF, 0) == TASK_R3_INDEPENDENCE;
}

test "an all-blocked open set is BLOCKED" {
    assert report(0x00FF, 0x0100) == REPORT_BLOCKED;
    assert next_open(0x00FF, 0x0100) == TASK_R3_INDEPENDENCE;
}

test "the next action prefers the lowest open unblocked task" {
    assert next_open(0, 0) == TASK_POC;
    assert next_open(0x00F5, 0x0002) == TASK_R2_SUPERVISOR;
    assert next_open(TASKS_FULL, 0) == 0;
}

test "PASS, FAIL and BLOCKED are distinct literal codes" {
    assert REPORT_MALFORMED == 0;
    assert REPORT_PASS == 1;
    assert REPORT_FAIL == 2;
    assert REPORT_BLOCKED == 3;
    // runtime anchors: each code is reachable from a distinct real state
    assert report(0x0001, 0x0001) == REPORT_MALFORMED;
    assert report(TASKS_FULL, 0) == REPORT_PASS;
    assert report(0, 0) == REPORT_FAIL;
    assert report(0x00FF, 0x0100) == REPORT_BLOCKED;
}

test "verified means a citable run reference, not a claim" {
    // two receipts for a three-placement task are no run (run_record.t27)
    assert run_complete(2, true, true, true) == false;
    // three agreeing, complete receipts are one citable run
    assert run_complete(3, true, true, true) == true;
    assert run_first_missing(3, true, true, true) == 0;
}

invariant percent_never_exceeds_one_hundred {
    assert percent(TASKS_FULL) == 100;
    assert percent(0) == 0;
}
