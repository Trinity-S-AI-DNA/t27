// SPDX-License-Identifier: Apache-2.0
; specs/verified/frontier_scope.t27 -- which specs `t27c frontier --only <spec>... | --since <rev>` walks.
; Epic gHashTag/t27#8095, issue #10236 (hot reload, ledger #8737).
; --
; Why. `t27c frontier` decides every spec under specs/ (2227 on 2026-10-18; 0.75 s warm, 5.7 s cold on the
; lab). An author who saved one spec wants the verdict for that spec and for what imports it, not for the
; corpus. The flags narrow the walk; every spec still gets the decision seal_identity.t27 gives it, because
; the closure of a spec is read in full whether or not the walk is narrowed.
; --
; One rule, not two. "Which specs can this change move" is specs/ci/affected.t27 -- the rule CI already uses
; to test only the affected specs (#7565). The scope is that selection, called as it is: the seeds are the
; named specs (--only: one "M<TAB>path" line each) or the lines of `git diff --name-status <rev>` (--since);
; the graph is the `use` edges of the corpus; the corpus is the spec list frontier already walked. The Rust
; gathers those three texts and hands them to select_affected, the way CI's C stub does (spec-guards.yml).
; --
; Why this module does not `use ci::affected`. The compiler cannot build a spec that imports it: affected.t27
; declares its own in_list, ext_dot, KINDS and PROSE_EXTS and imports policy::own_language, which declares the
; same four names differently, so the resolver reports them ambiguous and leaves them unspliced (t27c
; test-report: "BLOCKED does not compile ... use of undeclared identifier 'own_language'"). So the selection
; runs from affected's own generated code (bootstrap/gen/rust/ci/affected.rs), exactly as in CI, and this
; module holds the two decisions around it. The selection's own tests are in affected.t27.
; --
; Fail closed. affected.t27 answers RUN_ALL for a change it cannot judge: a path outside specs/ (the compiler,
; a tool, a workflow), a status letter it cannot read, a working set that does not fit. Then the walk is the
; whole corpus, exactly as without a flag. An answer of 0 is not a failure: a change to prose or a seal
; moves no verdict, and the scoped walk is empty. scope_narrows takes the sentinel as an argument, so the
; value is affected's and is not copied here.
; --
; The flags are exclusive: --only names the seeds, --since derives them, and a command line that gives both
; has no single answer to "which seeds". The clap layer refuses it; scope_wanted() is the decision it feeds.
; phi^2 + 1/phi^2 = 3 | TRINITY

module VerifiedFrontierScope;

/// Is the walk narrowed at all? Neither flag: every spec, as before.
pub fn scope_wanted(has_only: bool, has_since: bool) -> bool {
    return has_only or has_since;
}

/// Did the selection narrow the walk? `all` is the sentinel the selection answers when it cannot judge the
/// change; any other answer, 0 included, is a scope.
pub fn scope_narrows(picked: u32, all: u32) -> bool {
    return picked != all;
}

test scope_is_wanted_only_when_a_flag_is_given {
    assert scope_wanted(false, false) == false;
    assert scope_wanted(true, false) == true;
    assert scope_wanted(false, true) == true;
}

test a_count_is_a_scope_and_the_sentinel_is_the_whole_corpus {
    assert scope_narrows(3, 0xFFFFFFFF) == true;
    assert scope_narrows(1, 0xFFFFFFFF) == true;
}

test negative_control_the_sentinel_walks_everything {
    assert scope_narrows(0xFFFFFFFF, 0xFFFFFFFF) == false;
}

test prose_is_an_empty_scope_not_a_failure {
    // a change to a .md file or a seal selects no spec: 0 narrows to nothing, it does not widen to everything
    assert scope_narrows(0, 0xFFFFFFFF) == true;
}

invariant no_flag_never_narrows_by_itself {
    // without a flag the glue never asks the selection; the decision that gates it is false
    assert scope_wanted(false, false) == false;
    assert scope_narrows(0xFFFFFFFF, 0xFFFFFFFF) == false;
}
