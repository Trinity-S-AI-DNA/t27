// SPDX-License-Identifier: Apache-2.0
// specs/verified/seal_management.t27 -- seals management: re-save stale seals,
// remove orphan seals, remove seals named after a type string.
// Part of M2 milestone (milestone #6). Closes #13285, #12972, #13840.
// phi^2 + 1/phi^2 = 3 | TRINITY

module verified::seal_management;

pub const SEAL_MANAGEMENT_MAX_SEALS : u32 = 1024;

pub struct Seal { spec_id: str, stale: bool, orphan: bool };

pub fn seal_needs_resave(s: Seal) -> bool {
    return s.stale || s.orphan;
}

test "seal_needs_resave" {
    assert(seal_needs_resave(Seal { spec_id: "spec-a", stale: true, orphan: false }));
    assert(seal_needs_resave(Seal { spec_id: "spec-b", stale: false, orphan: true }));
    assert(!seal_needs_resave(Seal { spec_id: "spec-c", stale: false, orphan: false }));
}

invariant seal_management_max_seals_positive {
    assert SEAL_MANAGEMENT_MAX_SEALS > 0;
}