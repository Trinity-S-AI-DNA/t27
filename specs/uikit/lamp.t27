; specs/uikit/lamp.t27 -- UI Kit object: lamp, a status indicator with a label.
; Issue Trinity-S-AI-DNA/t27#13774, epic #13426, milestone M1 (Wave 1).
; Statuses: off (line role), ok (success), warn (accent), error (danger).
; Each status has its own glyph, so status is never shown by colour alone.
; a11y name: "<label>: <status word>".
; All draw ops are relative to the lamp's own 0,0 and carry ROLE names, never colours.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_lamp;

; -- Statuses -----------------------------------------------------------------
pub const ST_OFF   : i32 = 0;
pub const ST_OK    : i32 = 1;
pub const ST_WARN  : i32 = 2;
pub const ST_ERROR : i32 = 3;
pub const ST_COUNT : i32 = 4;

; -- Size classes -------------------------------------------------------------
pub const SZ_SM : i32 = 0;
pub const SZ_MD : i32 = 1;
pub const SZ_COUNT : i32 = 2;

; -- States (contract order) --------------------------------------------------
pub const S_DEFAULT  : i32 = 0;
pub const S_HOVER    : i32 = 1;
pub const S_PRESSED  : i32 = 2;
pub const S_FOCUS    : i32 = 3;
pub const S_DISABLED : i32 = 4;
pub const S_LOADING  : i32 = 5;
pub const S_COUNT    : i32 = 6;

; -- Themes -------------------------------------------------------------------
pub const TH_DARK  : i32 = 0;
pub const TH_LIGHT : i32 = 1;

; -- Role names (never colours) -----------------------------------------------
pub const ROLE_SURFACE : i32 = 0;
pub const ROLE_INK     : i32 = 1;
pub const ROLE_ACCENT  : i32 = 2;
pub const ROLE_DANGER  : i32 = 3;
pub const ROLE_SUCCESS : i32 = 4;
pub const ROLE_LINE    : i32 = 5;

; -- Role tokens a theme resolves to (ids, the host maps them to the palette) --
pub const TOK_BLACK   : i32 = 0;
pub const TOK_WHITE   : i32 = 1;
pub const TOK_ACCENT  : i32 = 2;
pub const TOK_DANGER  : i32 = 3;
pub const TOK_SUCCESS : i32 = 4;
pub const TOK_MUTED   : i32 = 5;

; -- Draw op kinds ------------------------------------------------------------
pub const OP_RECT : i32 = 0;
pub const OP_TEXT : i32 = 1;
pub const OP_ICON : i32 = 2;
pub const OP_MAX  : i32 = 4;

; -- Glyphs: one per status, plus a spinner for the loading state -------------
pub const GLYPH_RING     : i32 = 0;
pub const GLYPH_CHECK    : i32 = 1;
pub const GLYPH_TRIANGLE : i32 = 2;
pub const GLYPH_CROSS    : i32 = 3;
pub const GLYPH_SPINNER  : i32 = 4;

; -- Sizes, from design tokens (SPACE_XS 4, SPACE_SM 8; BADGE_HEIGHT 26) -------
pub const PAD_H     : i32 = 8;
pub const GAP       : i32 = 4;
pub const HEIGHT_MD : i32 = 26;
; PROPOSED TOKEN: LAMP_HEIGHT_SM, no token for a small indicator row
pub const HEIGHT_SM : i32 = 20;
; PROPOSED TOKEN: LAMP_ICON_MD and LAMP_ICON_SM, glyph box sides
pub const ICON_MD : i32 = 14;
pub const ICON_SM : i32 = 10;
; PROPOSED TOKEN: LAMP_CHAR_W_MD and LAMP_CHAR_W_SM, advance per label character
pub const CHAR_W_MD : i32 = 8;
pub const CHAR_W_SM : i32 = 7;

; -- The lamp -----------------------------------------------------------------
pub struct Lamp {
    status: i32,
    size: i32,
    label_id: i32,
    label_len: i32,
    state: i32,
    theme: i32,
    disposed: bool,
}

pub struct Op {
    kind: i32,
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    role: i32,
    alpha_pm: i32,
    glyph: i32,
    outline: i32,
}

; -- create / configure -------------------------------------------------------
; An invalid status, size or label length gives an inert (disposed) lamp.
pub fn lamp_create(status: i32, size: i32, label_id: i32, label_len: i32) -> Lamp {
    var ok : bool = true;
    if status < 0 { ok = false; }
    if status >= ST_COUNT { ok = false; }
    if size < 0 { ok = false; }
    if size >= SZ_COUNT { ok = false; }
    if label_len < 0 { ok = false; }
    var l : Lamp = Lamp {
        status: status,
        size: size,
        label_id: label_id,
        label_len: label_len,
        state: S_DEFAULT,
        theme: TH_DARK,
        disposed: false,
    };
    if !ok {
        l.status = ST_OFF;
        l.size = SZ_MD;
        l.label_id = 0;
        l.label_len = 0;
        l.disposed = true;
    }
    return l;
}

; -- state: an out-of-range state is refused, the lamp is returned unchanged ---
pub fn state_valid(s: i32) -> bool {
    return s >= 0 && s < S_COUNT;
}
pub fn lamp_set_state(l: Lamp, s: i32) -> Lamp {
    var n : Lamp = l;
    if l.disposed { return n; }
    if state_valid(s) { n.state = s; }
    return n;
}

; -- theme_bind ----------------------------------------------------------------
pub fn lamp_set_theme(l: Lamp, theme: i32) -> Lamp {
    var n : Lamp = l;
    if theme == TH_DARK { n.theme = TH_DARK; }
    if theme == TH_LIGHT { n.theme = TH_LIGHT; }
    return n;
}
; Light is the inverse of Dark for surface and ink; the other roles hold.
pub fn role_token(theme: i32, role: i32) -> i32 {
    if role == ROLE_SURFACE {
        if theme == TH_LIGHT { return TOK_WHITE; }
        return TOK_BLACK;
    }
    if role == ROLE_INK {
        if theme == TH_LIGHT { return TOK_BLACK; }
        return TOK_WHITE;
    }
    if role == ROLE_ACCENT { return TOK_ACCENT; }
    if role == ROLE_DANGER { return TOK_DANGER; }
    if role == ROLE_SUCCESS { return TOK_SUCCESS; }
    return TOK_MUTED;
}

; -- status to role and glyph ---------------------------------------------------
pub fn status_role(status: i32) -> i32 {
    if status == ST_OK { return ROLE_SUCCESS; }
    if status == ST_WARN { return ROLE_ACCENT; }
    if status == ST_ERROR { return ROLE_DANGER; }
    return ROLE_LINE;
}
pub fn status_glyph(status: i32) -> i32 {
    if status == ST_OK { return GLYPH_CHECK; }
    if status == ST_WARN { return GLYPH_TRIANGLE; }
    if status == ST_ERROR { return GLYPH_CROSS; }
    return GLYPH_RING;
}

; -- state to alpha (permille) and non-colour cue -------------------------------
pub fn state_alpha(s: i32) -> i32 {
    if s == S_HOVER { return 800; }
    if s == S_PRESSED { return 867; }
    if s == S_DISABLED { return 400; }
    if s == S_LOADING { return 600; }
    return 1000;
}
; Outline width in px: every non-default state differs from default (1) by width,
; except loading, which changes the glyph to a spinner.
pub fn state_outline(s: i32) -> i32 {
    if s == S_HOVER { return 2; }
    if s == S_PRESSED { return 3; }
    if s == S_FOCUS { return 4; }
    if s == S_DISABLED { return 0; }
    return 1;
}
pub fn lamp_glyph(l: Lamp) -> i32 {
    if l.state == S_LOADING { return GLYPH_SPINNER; }
    return status_glyph(l.status);
}

; -- layout / measure -----------------------------------------------------------
pub fn lamp_height(l: Lamp) -> i32 {
    if l.disposed { return 0; }
    if l.size == SZ_SM { return HEIGHT_SM; }
    return HEIGHT_MD;
}
pub fn icon_side(size: i32) -> i32 {
    if size == SZ_SM { return ICON_SM; }
    return ICON_MD;
}
pub fn char_w(size: i32) -> i32 {
    if size == SZ_SM { return CHAR_W_SM; }
    return CHAR_W_MD;
}
pub fn lamp_text_w(l: Lamp) -> i32 {
    return l.label_len * char_w(l.size);
}
; Natural width, clamped to the available width (never negative).
pub fn lamp_width(l: Lamp, avail_w: i32) -> i32 {
    if l.disposed { return 0; }
    var w : i32 = PAD_H + icon_side(l.size) + PAD_H;
    if l.label_len > 0 { w = w + GAP + lamp_text_w(l); }
    if avail_w < w { w = avail_w; }
    if w < 0 { w = 0; }
    return w;
}

; -- render: a bounded list of ops, relative to the lamp's own 0,0 --------------
pub fn lamp_op_count(l: Lamp) -> i32 {
    if l.disposed { return 0; }
    var n : i32 = 2;
    if l.label_len > 0 { n = n + 1; }
    if l.state == S_FOCUS { n = n + 1; }
    return n;
}
; Op i: 0 surface rect, 1 glyph icon, then the label text, then the focus ring.
pub fn lamp_op(l: Lamp, avail_w: i32, i: i32) -> Op {
    let w : i32 = lamp_width(l, avail_w);
    let h : i32 = lamp_height(l);
    let a : i32 = state_alpha(l.state);
    let side : i32 = icon_side(l.size);
    var o : Op = Op {
        kind: OP_RECT, x: 0, y: 0, w: 0, h: 0,
        role: ROLE_SURFACE, alpha_pm: 0, glyph: GLYPH_RING, outline: 0,
    };
    if i < 0 { return o; }
    if i >= lamp_op_count(l) { return o; }
    if i == 0 {
        o.w = w; o.h = h; o.alpha_pm = a;
        o.outline = state_outline(l.state);
        return o;
    }
    if i == 1 {
        o.kind = OP_ICON;
        o.x = PAD_H; o.y = @divTrunc(h - side, 2);
        o.w = side; o.h = side;
        o.role = status_role(l.status);
        o.alpha_pm = a;
        o.glyph = lamp_glyph(l);
        return o;
    }
    if i == 2 && l.label_len > 0 {
        o.kind = OP_TEXT;
        o.x = PAD_H + side + GAP; o.y = 0;
        o.w = lamp_text_w(l); o.h = h;
        o.role = ROLE_INK;
        o.alpha_pm = a;
        return o;
    }
    o.kind = OP_RECT;
    o.w = w; o.h = h;
    o.role = ROLE_ACCENT;
    o.alpha_pm = 1000;
    o.outline = state_outline(l.state);
    return o;
}

; -- hit_test, relative to the lamp's own box; a disposed or disabled lamp misses -
pub fn lamp_hit_test(l: Lamp, avail_w: i32, x: i32, y: i32) -> bool {
    if l.disposed { return false; }
    if l.state == S_DISABLED { return false; }
    if x < 0 { return false; }
    if y < 0 { return false; }
    if x >= lamp_width(l, avail_w) { return false; }
    if y >= lamp_height(l) { return false; }
    return true;
}

; -- a11y: "<label>: <status word>" ---------------------------------------------
pub fn status_word(status: i32) -> str {
    if status == ST_OK { return "ok"; }
    if status == ST_WARN { return "warning"; }
    if status == ST_ERROR { return "error"; }
    return "off";
}
; The lamp's own part of the name: its status word. The host speaks the label and ": " before it;
; no runtime string join here.
pub fn lamp_a11y_name(l: Lamp) -> str {
    return status_word(l.status);
}
; Length of the name, for hosts that hold the label as a content id.
pub fn lamp_a11y_len(l: Lamp) -> i32 {
    var n : i32 = 2;
    if l.status == ST_OK { n = n + 2; }
    if l.status == ST_WARN { n = n + 7; }
    if l.status == ST_ERROR { n = n + 5; }
    if l.status == ST_OFF { n = n + 3; }
    return l.label_len + n;
}

; -- dispose: back to an inert state ---------------------------------------------
pub fn lamp_dispose(l: Lamp) -> Lamp {
    var n : Lamp = l;
    n.status = ST_OFF;
    n.size = SZ_MD;
    n.label_id = 0;
    n.label_len = 0;
    n.state = S_DEFAULT;
    n.disposed = true;
    return n;
}

; -- Tests -----------------------------------------------------------------------
test "create keeps the config and refuses an invalid one" {
    let l : Lamp = lamp_create(ST_WARN, SZ_SM, 7, 5);
    assert l.status == ST_WARN;
    assert l.size == SZ_SM;
    assert l.label_id == 7;
    assert l.state == S_DEFAULT;
    assert !l.disposed;
    assert lamp_create(4, SZ_MD, 1, 1).disposed;
    assert lamp_create(ST_OK, 2, 1, 1).disposed;
    assert lamp_create(ST_OK, SZ_MD, 1, -1).disposed;
}

test "measure uses token sizes and clamps to the available width" {
    let l : Lamp = lamp_create(ST_OK, SZ_MD, 1, 4);
    assert lamp_height(l) == 26;
    assert lamp_width(l, 1000) == 8 + 14 + 8 + 4 + 32;
    assert lamp_width(l, 20) == 20;
    assert lamp_width(l, -5) == 0;
    assert lamp_height(lamp_create(ST_OK, SZ_SM, 1, 4)) == 20;
    assert lamp_width(lamp_create(ST_OFF, SZ_MD, 0, 0), 1000) == 30;
}

test "render gives a bounded op list with role names" {
    let l : Lamp = lamp_create(ST_ERROR, SZ_MD, 1, 4);
    assert lamp_op_count(l) == 3;
    assert lamp_op_count(l) <= OP_MAX;
    assert lamp_op(l, 1000, 0).kind == OP_RECT;
    assert lamp_op(l, 1000, 0).role == ROLE_SURFACE;
    assert lamp_op(l, 1000, 1).kind == OP_ICON;
    assert lamp_op(l, 1000, 1).role == ROLE_DANGER;
    assert lamp_op(l, 1000, 2).kind == OP_TEXT;
    assert lamp_op(l, 1000, 2).role == ROLE_INK;
    assert lamp_op(l, 1000, 0).x == 0;
    assert lamp_op(l, 1000, 0).y == 0;
    assert lamp_op(l, 1000, 3).w == 0;
}

test "status maps to its role" {
    assert status_role(ST_OFF) == ROLE_LINE;
    assert status_role(ST_OK) == ROLE_SUCCESS;
    assert status_role(ST_WARN) == ROLE_ACCENT;
    assert status_role(ST_ERROR) == ROLE_DANGER;
}

test "hit_test is relative to the lamp's own box" {
    let l : Lamp = lamp_create(ST_OK, SZ_MD, 1, 4);
    assert lamp_hit_test(l, 1000, 0, 0);
    assert lamp_hit_test(l, 1000, 65, 25);
    assert !lamp_hit_test(l, 1000, 66, 0);
    assert !lamp_hit_test(l, 1000, 0, 26);
    assert !lamp_hit_test(l, 1000, -1, 5);
    assert !lamp_hit_test(lamp_set_state(l, S_DISABLED), 1000, 5, 5);
}

test "state accepts 0..5 and refuses the rest" {
    let l : Lamp = lamp_create(ST_OK, SZ_MD, 1, 4);
    assert lamp_set_state(l, S_LOADING).state == S_LOADING;
    assert lamp_set_state(l, 6).state == S_DEFAULT;
    assert lamp_set_state(l, -1).state == S_DEFAULT;
    assert lamp_set_state(lamp_set_state(l, S_HOVER), 9).state == S_HOVER;
    assert state_valid(0);
    assert !state_valid(S_COUNT);
}

test "theme_bind: light inverts surface and ink, other roles hold" {
    assert role_token(TH_DARK, ROLE_SURFACE) == TOK_BLACK;
    assert role_token(TH_LIGHT, ROLE_SURFACE) == TOK_WHITE;
    assert role_token(TH_DARK, ROLE_INK) == TOK_WHITE;
    assert role_token(TH_LIGHT, ROLE_INK) == TOK_BLACK;
    assert role_token(TH_DARK, ROLE_SUCCESS) == role_token(TH_LIGHT, ROLE_SUCCESS);
    assert role_token(TH_DARK, ROLE_DANGER) == role_token(TH_LIGHT, ROLE_DANGER);
    let l : Lamp = lamp_create(ST_OK, SZ_MD, 1, 4);
    assert lamp_set_theme(l, TH_LIGHT).theme == TH_LIGHT;
    assert lamp_set_theme(l, 7).theme == TH_DARK;
}

test "a11y: every status has its own glyph and a name with the status word" {
    assert status_glyph(ST_OFF) != status_glyph(ST_OK);
    assert status_glyph(ST_OK) != status_glyph(ST_WARN);
    assert status_glyph(ST_WARN) != status_glyph(ST_ERROR);
    assert status_glyph(ST_OFF) != status_glyph(ST_ERROR);
    assert status_glyph(ST_OFF) != status_glyph(ST_WARN);
    assert status_glyph(ST_OK) != status_glyph(ST_ERROR);
    let l : Lamp = lamp_create(ST_WARN, SZ_MD, 1, 4);
    assert lamp_a11y_name(l) == "warning";
    assert lamp_a11y_name(lamp_create(ST_OFF, SZ_MD, 1, 3)) == "off";
    assert lamp_a11y_len(l) == 4 + 2 + 7;
}

test "a11y: each non-default state changes a non-colour property" {
    var s : i32 = 1;
    while (s < S_COUNT) {
        let l : Lamp = lamp_set_state(lamp_create(ST_OK, SZ_MD, 1, 4), s);
        let d : Lamp = lamp_create(ST_OK, SZ_MD, 1, 4);
        var differs : bool = state_outline(s) != state_outline(S_DEFAULT);
        if lamp_glyph(l) != lamp_glyph(d) { differs = true; }
        assert differs;
        s = s + 1;
    }
    assert lamp_op_count(lamp_set_state(lamp_create(ST_OK, SZ_MD, 1, 4), S_FOCUS)) == 4;
}

test "dispose returns an inert lamp and hit_test misses" {
    let l : Lamp = lamp_dispose(lamp_create(ST_ERROR, SZ_MD, 1, 4));
    assert l.disposed;
    assert l.label_len == 0;
    assert lamp_op_count(l) == 0;
    assert lamp_width(l, 1000) == 0;
    assert !lamp_hit_test(l, 1000, 0, 0);
    assert lamp_set_state(l, S_HOVER).state == S_DEFAULT;
}

invariant no_op_leaves_the_box {
    var st : i32 = 0;
    while (st < ST_COUNT) {
        let l : Lamp = lamp_create(st, SZ_MD, 1, 4);
        var i : i32 = 0;
        while (i < lamp_op_count(l)) {
            let o : Op = lamp_op(l, 200, i);
            assert o.x >= 0;
            assert o.y >= 0;
            assert o.alpha_pm >= 0 && o.alpha_pm <= 1000;
            i = i + 1;
        }
        assert lamp_op_count(l) <= OP_MAX;
        st = st + 1;
    }
}
