// SPDX-License-Identifier: Apache-2.0
; specs/uikit/avatar.t27 -- UI Kit object: Avatar (epic #13426, issue #13749, milestone M2).
; Owner rule: NO ring and NO outline around the avatar, in any state. The avatar is a filled disc
; (image or initials). A state is never shown by colour alone: each non-default state changes the
; disc scale (hover, pressed, focus) or adds an icon op (disabled, loading), plus an alpha.
; Variants: image (the picture, clipped to the disc by the host), initials (up to two letters from the
; display name). An image variant with no picture available falls back to initials.
; Accessible name = the user's display name; a missing or blank name falls back to "Account".
; PURE: no fetch, no file, no window pixels. Ops are relative to the object's own 0,0 box.
; Reuses the owner-session draft (69394e0c49): disc fill alpha, initial at half the diameter, circle hit.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_avatar;

; ---- Size classes (PROPOSED TOKEN: design_tokens/native_tokens have no avatar sizes) ------
; PROPOSED TOKEN: AV_SIZE_S_PX, AV_SIZE_M_PX, AV_SIZE_L_PX (diameter in px).
pub const AV_SIZE_S : u32 = 0;
pub const AV_SIZE_M : u32 = 1;
pub const AV_SIZE_L : u32 = 2;
pub const AV_SIZE_COUNT : u32 = 3;
pub const AV_SIZE_S_PX : f64 = 24.0;
pub const AV_SIZE_M_PX : f64 = 32.0;
pub const AV_SIZE_L_PX : f64 = 44.0;
; Initial letters are set at this fraction of the diameter (draft value).
pub const AV_LETTER_K : f64 = 0.5;
; Initials disc fill alpha (draft value, PROPOSED TOKEN).
pub const AV_DISC_A : f64 = 0.14;

; ---- Variants, states, themes ----------------------------------------------------------
pub const AV_VAR_IMAGE : u32 = 0;
pub const AV_VAR_INITIALS : u32 = 1;
pub const AV_VAR_COUNT : u32 = 2;

pub const AV_ST_DEFAULT : u32 = 0;
pub const AV_ST_HOVER : u32 = 1;
pub const AV_ST_PRESSED : u32 = 2;
pub const AV_ST_FOCUS : u32 = 3;
pub const AV_ST_DISABLED : u32 = 4;
pub const AV_ST_LOADING : u32 = 5;
pub const AV_ST_COUNT : u32 = 6;

pub const AV_THEME_DARK : u32 = 0;
pub const AV_THEME_LIGHT : u32 = 1;

; ---- Roles (colours are role names, never literals) ---------------------------------------
pub const AV_ROLE_SURFACE : u32 = 0;
pub const AV_ROLE_INK : u32 = 1;
pub const AV_ROLE_ACCENT : u32 = 2;
pub const AV_ROLE_DANGER : u32 = 3;
pub const AV_ROLE_SUCCESS : u32 = 4;
pub const AV_ROLE_LINE : u32 = 5;

; ---- Draw ops ---------------------------------------------------------------------------
pub const AV_OP_DISC : u32 = 0;
pub const AV_OP_TEXT : u32 = 1;
pub const AV_OP_ICON : u32 = 2;
pub const AV_ICON_PICTURE : u32 = 0;
pub const AV_ICON_SLASH : u32 = 1;
pub const AV_ICON_SPINNER : u32 = 2;
pub const AV_ICON_NONE : u32 = 99;
pub const AV_MAX_OPS : u32 = 4;
pub const AV_NAME_MAX : u32 = 48;

pub struct AvCfg {
    pub variant : u32,
    pub size : u32,
    pub theme : u32,
    pub state : u32,
    pub has_image : bool,
    pub name : [48]u8,
    pub name_len : u32,
    pub valid : bool,
    pub disposed : bool,
}

pub struct AvSize {
    pub w : f64,
    pub h : f64,
}

pub struct AvDraw {
    pub n : u32,
    pub kind : [4]u32,
    pub role : [4]u32,
    pub x : [4]f64,
    pub y : [4]f64,
    pub w : [4]f64,
    pub h : [4]f64,
    pub alpha : [4]f64,
    pub icon : [4]u32,
    pub glyph : [4]u8,
    pub glyph2 : [4]u8,
}

; ---- Create / configure -----------------------------------------------------------------
pub fn av_size_px(size: u32) -> f64 {
    if (size == AV_SIZE_S) { return AV_SIZE_S_PX; }
    if (size == AV_SIZE_M) { return AV_SIZE_M_PX; }
    if (size == AV_SIZE_L) { return AV_SIZE_L_PX; }
    return 0.0;
}

pub fn av_create(variant: u32, size: u32, theme: u32, has_image: bool, name: []const u8, n: u32) -> AvCfg {
    var c : AvCfg = undefined;
    c.variant = variant;
    c.size = size;
    c.theme = theme;
    c.state = AV_ST_DEFAULT;
    c.has_image = has_image;
    c.name_len = 0;
    c.disposed = false;
    c.valid = variant < AV_VAR_COUNT and size < AV_SIZE_COUNT and theme <= AV_THEME_LIGHT;
    var i : u32 = 0;
    while (i < AV_NAME_MAX) {
        c.name[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < n and i < AV_NAME_MAX and i < name.len) {
        c.name[i] = name[i];
        i = i + 1;
    }
    c.name_len = i;
    return c;
}

; An out-of-range state is refused: the config is returned unchanged.
pub fn av_state_ok(s: u32) -> bool { return s < AV_ST_COUNT; }
pub fn av_set_state(c: AvCfg, s: u32) -> AvCfg {
    var r : AvCfg = c;
    if (av_state_ok(s)) { r.state = s; }
    return r;
}

pub fn av_dispose(c: AvCfg) -> AvCfg {
    var r : AvCfg = c;
    r.disposed = true;
    r.valid = false;
    r.name_len = 0;
    r.has_image = false;
    r.state = AV_ST_DEFAULT;
    return r;
}

; ---- Layout / measure (token sizes only) ---------------------------------------------------
pub fn av_measure(c: AvCfg, avail_w: f64) -> AvSize {
    var s : AvSize = undefined;
    s.w = 0.0;
    s.h = 0.0;
    if (c.disposed or c.valid == false) { return s; }
    var d : f64 = av_size_px(c.size);
    if (avail_w < d) { d = avail_w; }
    if (d < 0.0) { d = 0.0; }
    s.w = d;
    s.h = d;
    return s;
}

; ---- State look: scale and alpha. No ring, no outline in any state. ---------------------
; Scale is <= 1 so every op stays inside the measured box.
pub fn av_state_scale(s: u32) -> f64 {
    if (s == AV_ST_HOVER) { return 0.96; }
    if (s == AV_ST_PRESSED) { return 0.88; }
    if (s == AV_ST_FOCUS) { return 0.92; }
    return 1.0;
}
; PROPOSED TOKEN alphas (same spirit as BTN_ALPHA_* in native_tokens).
pub fn av_state_alpha(s: u32) -> f64 {
    if (s == AV_ST_PRESSED) { return 0.8; }
    if (s == AV_ST_DISABLED) { return 0.4; }
    if (s == AV_ST_LOADING) { return 0.6; }
    return 1.0;
}
; The icon a state adds on top of the disc (AV_ICON_NONE = none).
pub fn av_state_icon(s: u32) -> u32 {
    if (s == AV_ST_DISABLED) { return AV_ICON_SLASH; }
    if (s == AV_ST_LOADING) { return AV_ICON_SPINNER; }
    return AV_ICON_NONE;
}

; ---- Name, initials, a11y ----------------------------------------------------------------
fn av_blank(c: AvCfg) -> bool {
    var i : u32 = 0;
    while (i < c.name_len) {
        if (c.name[i] != 32) { return false; }
        i = i + 1;
    }
    return true;
}
fn av_upper(b: u8) -> u8 {
    if (b >= 97 and b <= 122) { return b - 32; }
    return b;
}
fn av_is_alnum(b: u8) -> bool {
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122);
}
; First letter of the first word.
pub fn av_initial1(c: AvCfg) -> u8 {
    var i : u32 = 0;
    while (i < c.name_len and c.name[i] == 32) { i = i + 1; }
    if (i < c.name_len and av_is_alnum(c.name[i])) { return av_upper(c.name[i]); }
    return 65;
}
; First letter of the last word when there is more than one word, else 0.
pub fn av_initial2(c: AvCfg) -> u8 {
    var last : u32 = 0;
    var words : u32 = 0;
    var prev_space : bool = true;
    var i : u32 = 0;
    while (i < c.name_len) {
        const sp : bool = c.name[i] == 32;
        if (prev_space and sp == false) {
            words = words + 1;
            last = i;
        }
        prev_space = sp;
        i = i + 1;
    }
    if (words >= 2 and av_is_alnum(c.name[last])) { return av_upper(c.name[last]); }
    return 0;
}

fn av_put(out: []u8, at: u32, s: []const u8) -> u32 {
    var i : u32 = 0;
    while (i < s.len and at + i < out.len) {
        out[at + i] = s[i];
        i = i + 1;
    }
    return at + i;
}
; The display name, else "Account"; written into out, its length returned. Never empty.
pub fn av_a11y_name(c: AvCfg, out: []u8) -> u32 {
    if (c.disposed or av_blank(c)) { return av_put(out, 0, "Account"); }
    var i : u32 = 0;
    while (i < c.name_len and i < out.len) {
        out[i] = c.name[i];
        i = i + 1;
    }
    return i;
}

; ---- Theme bind: Light is the inverse of Dark for surface and ink -------------------------
; Role luminance 0..1 (grey); accent/danger/success/line are resolved by the host token map.
pub fn av_role_lum(theme: u32, role: u32) -> f64 {
    if (role == AV_ROLE_SURFACE) {
        if (theme == AV_THEME_LIGHT) { return 1.0; }
        return 0.0;
    }
    if (theme == AV_THEME_LIGHT) { return 0.0; }
    return 1.0;
}

; ---- Render: bounded ops, roles only, relative to 0,0 ----------------------------------------
fn av_op(d: AvDraw, kind: u32, role: u32, x: f64, y: f64, w: f64, h: f64, a: f64, icon: u32) -> AvDraw {
    var r : AvDraw = d;
    const k : u32 = r.n;
    if (k >= AV_MAX_OPS) { return r; }
    r.kind[k] = kind;
    r.role[k] = role;
    r.x[k] = x;
    r.y[k] = y;
    r.w[k] = w;
    r.h[k] = h;
    r.alpha[k] = a;
    r.icon[k] = icon;
    r.glyph[k] = 0;
    r.glyph2[k] = 0;
    r.n = k + 1;
    return r;
}

pub fn av_effective_variant(c: AvCfg) -> u32 {
    if (c.variant == AV_VAR_IMAGE and c.has_image) { return AV_VAR_IMAGE; }
    return AV_VAR_INITIALS;
}

pub fn av_render(c: AvCfg) -> AvDraw {
    var d : AvDraw = undefined;
    d.n = 0;
    if (c.disposed or c.valid == false or av_state_ok(c.state) == false) { return d; }
    const box : f64 = av_size_px(c.size);
    const dia : f64 = box * av_state_scale(c.state);
    const off : f64 = (box - dia) * 0.5;
    const a : f64 = av_state_alpha(c.state);
    if (av_effective_variant(c) == AV_VAR_IMAGE) {
        d = av_op(d, AV_OP_DISC, AV_ROLE_SURFACE, off, off, dia, dia, a, AV_ICON_NONE);
        d = av_op(d, AV_OP_ICON, AV_ROLE_INK, off, off, dia, dia, a, AV_ICON_PICTURE);
    } else {
        d = av_op(d, AV_OP_DISC, AV_ROLE_INK, off, off, dia, dia, AV_DISC_A * a, AV_ICON_NONE);
        d = av_op(d, AV_OP_TEXT, AV_ROLE_INK, off, off, dia, dia, a, AV_ICON_NONE);
        d.glyph[1] = av_initial1(c);
        d.glyph2[1] = av_initial2(c);
    }
    const si : u32 = av_state_icon(c.state);
    if (si != AV_ICON_NONE) {
        var role : u32 = AV_ROLE_INK;
        if (si == AV_ICON_SPINNER) { role = AV_ROLE_ACCENT; }
        d = av_op(d, AV_OP_ICON, role, off, off, dia, dia, 1.0, si);
    }
    return d;
}

; Letter height for the initials op (fraction of the disc).
pub fn av_letter_h(c: AvCfg) -> f64 { return av_size_px(c.size) * av_state_scale(c.state) * AV_LETTER_K; }

; ---- Hit test, relative to the object's own box -----------------------------------------------
pub fn av_hit_test(c: AvCfg, x: f64, y: f64) -> bool {
    if (c.disposed or c.valid == false) { return false; }
    const r : f64 = av_size_px(c.size) * 0.5;
    const dx : f64 = x - r;
    const dy : f64 = y - r;
    return dx * dx + dy * dy <= r * r;
}

; ---- Tests ----------------------------------------------------------------------------------
test create_and_configure {
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada Lovelace", 12);
    assert c.valid;
    assert c.state == AV_ST_DEFAULT;
    assert c.name_len == 12;
    assert av_create(AV_VAR_COUNT, AV_SIZE_M, AV_THEME_DARK, true, "x", 1).valid == false;
    assert av_create(AV_VAR_IMAGE, AV_SIZE_COUNT, AV_THEME_DARK, true, "x", 1).valid == false;
    assert av_create(AV_VAR_IMAGE, AV_SIZE_M, 2, true, "x", 1).valid == false;
}

test measure_uses_token_sizes_only {
    const c : AvCfg = av_create(AV_VAR_INITIALS, AV_SIZE_L, AV_THEME_DARK, false, "Ada", 3);
    assert av_measure(c, 500.0).w == AV_SIZE_L_PX;
    assert av_measure(c, 500.0).h == AV_SIZE_L_PX;
    assert av_measure(c, 10.0).w == 10.0;
    const s : AvCfg = av_create(AV_VAR_INITIALS, AV_SIZE_S, AV_THEME_DARK, false, "Ada", 3);
    assert av_measure(s, 500.0).w == AV_SIZE_S_PX;
}

test render_image_variant_ops {
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada Lovelace", 12);
    const d : AvDraw = av_render(c);
    assert d.n == 2;
    assert d.kind[0] == AV_OP_DISC;
    assert d.role[0] == AV_ROLE_SURFACE;
    assert d.kind[1] == AV_OP_ICON;
    assert d.icon[1] == AV_ICON_PICTURE;
    assert d.x[0] == 0.0;
    assert d.w[0] == AV_SIZE_M_PX;
}

test render_initials_variant_and_fallback {
    const c : AvCfg = av_create(AV_VAR_INITIALS, AV_SIZE_M, AV_THEME_DARK, false, "ada lovelace", 12);
    const d : AvDraw = av_render(c);
    assert d.n == 2;
    assert d.kind[1] == AV_OP_TEXT;
    assert d.glyph[1] == 65;
    assert d.glyph2[1] == 76;
    assert d.alpha[0] == AV_DISC_A;
    const f : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, false, "Bob", 3);
    assert av_effective_variant(f) == AV_VAR_INITIALS;
    assert av_render(f).glyph[1] == 66;
    assert av_render(f).glyph2[1] == 0;
    const e : AvCfg = av_create(AV_VAR_INITIALS, AV_SIZE_M, AV_THEME_DARK, false, "", 0);
    assert av_render(e).glyph[1] == 65;
}

test no_ring_and_no_outline_in_any_state {
    var v : u32 = 0;
    while (v < AV_VAR_COUNT) {
        var s : u32 = 0;
        while (s < AV_ST_COUNT) {
            var c : AvCfg = av_create(v, AV_SIZE_L, AV_THEME_LIGHT, true, "Ada Lovelace", 12);
            c = av_set_state(c, s);
            const d : AvDraw = av_render(c);
            var i : u32 = 0;
            while (i < d.n) {
                assert d.role[i] != AV_ROLE_LINE;
                assert d.kind[i] == AV_OP_DISC or d.kind[i] == AV_OP_TEXT or d.kind[i] == AV_OP_ICON;
                assert d.x[i] >= 0.0;
                assert d.y[i] >= 0.0;
                assert d.x[i] + d.w[i] <= AV_SIZE_L_PX;
                assert d.y[i] + d.h[i] <= AV_SIZE_L_PX;
                assert d.n <= AV_MAX_OPS;
                i = i + 1;
            }
            s = s + 1;
        }
        v = v + 1;
    }
}

test state_range_is_refused {
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada", 3);
    assert av_state_ok(5);
    assert av_state_ok(6) == false;
    assert av_set_state(c, AV_ST_PRESSED).state == AV_ST_PRESSED;
    assert av_set_state(c, 6).state == AV_ST_DEFAULT;
    var bad : AvCfg = c;
    bad.state = 9;
    assert av_render(bad).n == 0;
}

test state_is_not_colour_alone {
    const base : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_L, AV_THEME_DARK, true, "Ada", 3);
    const b : AvDraw = av_render(base);
    var s : u32 = 1;
    while (s < AV_ST_COUNT) {
        const d : AvDraw = av_render(av_set_state(base, s));
        const changed : bool = d.n != b.n or d.w[0] != b.w[0] or d.x[0] != b.x[0];
        assert changed;
        s = s + 1;
    }
    assert av_state_icon(AV_ST_DISABLED) == AV_ICON_SLASH;
    assert av_state_icon(AV_ST_LOADING) == AV_ICON_SPINNER;
    assert av_state_alpha(AV_ST_DISABLED) < av_state_alpha(AV_ST_DEFAULT);
}

test theme_light_is_inverse_of_dark {
    assert av_role_lum(AV_THEME_DARK, AV_ROLE_SURFACE) == 0.0;
    assert av_role_lum(AV_THEME_LIGHT, AV_ROLE_SURFACE) == 1.0;
    assert av_role_lum(AV_THEME_DARK, AV_ROLE_INK) == 1.0;
    assert av_role_lum(AV_THEME_LIGHT, AV_ROLE_INK) == 0.0;
    assert av_role_lum(AV_THEME_DARK, AV_ROLE_SURFACE) + av_role_lum(AV_THEME_LIGHT, AV_ROLE_SURFACE) == 1.0;
    assert av_role_lum(AV_THEME_DARK, AV_ROLE_INK) + av_role_lum(AV_THEME_LIGHT, AV_ROLE_INK) == 1.0;
}

test a11y_name_is_display_name_or_account {
    var b : [64]u8 = undefined;
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada Lovelace", 12);
    assert av_a11y_name(c, b[0..64]) == 12;
    assert b[0] == 65;
    assert b[11] == 101;
    const e : AvCfg = av_create(AV_VAR_INITIALS, AV_SIZE_M, AV_THEME_DARK, false, "", 0);
    assert av_a11y_name(e, b[0..64]) == 7;
    assert b[0] == 65;
    assert b[6] == 116;
    const w : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "   ", 3);
    assert av_a11y_name(w, b[0..64]) == 7;
}

test hit_test_is_the_circle_in_own_box {
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada", 3);
    assert av_hit_test(c, 16.0, 16.0);
    assert av_hit_test(c, 0.5, 16.0);
    assert av_hit_test(c, 0.0, 0.0) == false;
    assert av_hit_test(c, 40.0, 16.0) == false;
}

test dispose_makes_it_inert {
    const c : AvCfg = av_create(AV_VAR_IMAGE, AV_SIZE_M, AV_THEME_DARK, true, "Ada", 3);
    const x : AvCfg = av_dispose(c);
    assert x.disposed;
    assert av_hit_test(x, 16.0, 16.0) == false;
    assert av_render(x).n == 0;
    assert av_measure(x, 100.0).w == 0.0;
    var b : [16]u8 = undefined;
    assert av_a11y_name(x, b[0..16]) == 7;
}

invariant avatar_never_draws_a_ring {
    assert AV_ROLE_LINE != AV_ROLE_SURFACE;
    assert AV_MAX_OPS == 4;
    assert av_state_scale(AV_ST_DEFAULT) == 1.0;
    assert av_state_scale(AV_ST_HOVER) <= 1.0;
    assert av_state_scale(AV_ST_PRESSED) <= 1.0;
    assert av_state_scale(AV_ST_FOCUS) <= 1.0;
}
