; specs/uikit/design_tokens.t27 -- design tokens for the t27 UI Kit, two themes.
; Extracted from t27.ai live site (trinity/apps/website/src/pages/UIKit.tsx TOKENS object).
; Source of truth for all UI Kit spec work.
; Refs #13698.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_design_tokens;

; -- TH_T27 (dark theme) ------------------------------------------------------
pub const TH_T27_BG              : str = "#000000";
pub const TH_T27_TEXT            : str = "#FFFFFF";
pub const TH_T27_MUTED           : str = "#888888";
pub const TH_T27_ACCENT          : str = "#00FF88";
pub const TH_T27_ACCENT_DARK     : str = "#00CC66";
pub const TH_T27_GOLD            : str = "#FFD700";
pub const TH_T27_BORDER          : str = "rgba(255,255,255,0.08)";
pub const TH_T27_CARD_BORDER     : str = "#333333";
pub const TH_T27_CARD_BORDER_HOV : str = "#FFFFFF";
pub const TH_T27_CARD_DESC       : str = "#A6A6A6";
pub const TH_T27_CARD_FOOT       : str = "#8A8A8A";
pub const TH_T27_SURFACE_INPUT   : str = "#1A1A1A";
pub const TH_T27_SURFACE_CARD    : str = "#0A0A0A";

; -- TH_PAPER (light theme) ---------------------------------------------------
pub const TH_PAPER_BG              : str = "#FFFFFF";
pub const TH_PAPER_TEXT            : str = "#000000";
pub const TH_PAPER_MUTED           : str = "#666666";
pub const TH_PAPER_ACCENT          : str = "#00A35C";
pub const TH_PAPER_ACCENT_DARK     : str = "#007A45";
pub const TH_PAPER_GOLD            : str = "#B38F00";
pub const TH_PAPER_BORDER          : str = "rgba(0,0,0,0.08)";
pub const TH_PAPER_CARD_BORDER     : str = "#CCCCCC";
pub const TH_PAPER_CARD_BORDER_HOV : str = "#000000";
pub const TH_PAPER_CARD_DESC       : str = "#4D4D4D";
pub const TH_PAPER_CARD_FOOT       : str = "#666666";
pub const TH_PAPER_SURFACE_INPUT   : str = "#F5F5F5";
pub const TH_PAPER_SURFACE_CARD    : str = "#FAFAFA";

; -- Typography ----------------------------------------------------------------
pub const FONT_FAMILY    : str = "Outfit, system-ui, sans-serif";
pub const FONT_SIZE_XS   : str = "11px";
pub const FONT_SIZE_SM   : str = "12px";
pub const FONT_SIZE_MD   : str = "14px";
pub const FONT_SIZE_BASE : str = "15px";
pub const FONT_SIZE_H1   : str = "15.2px";

; -- Spacing -------------------------------------------------------------------
pub const SPACE_XS  : str = "4px";
pub const SPACE_SM  : str = "8px";
pub const SPACE_MD  : str = "12px";
pub const SPACE_LG  : str = "16px";
pub const SPACE_XL  : str = "20px";
pub const SPACE_2XL : str = "32px";

; -- Radius --------------------------------------------------------------------
pub const RADIUS_SM   : str = "4px";
pub const RADIUS_MD   : str = "8px";
pub const RADIUS_LG   : str = "12px";
pub const RADIUS_PILL : str = "999px";

; -- Button --------------------------------------------------------------------
; B&W brand: primary button inverts bg/text between themes.
; TH_T27:   background = TH_T27_TEXT   (#FFFFFF), color = TH_T27_BG   (#000000)
; TH_PAPER: background = TH_PAPER_TEXT (#000000), color = TH_PAPER_BG (#FFFFFF)
pub const BTN_PADDING       : str = "12px 20px";
pub const BTN_MIN_HEIGHT    : str = "44px";
pub const BTN_FONT_SIZE     : str = "15px";
pub const BTN_FONT_WEIGHT   : u32 = 400;
pub const BTN_BORDER_RADIUS : str = "999px";

; -- Tests ---------------------------------------------------------------------
test themes_differ {
    let dark_bg  : str = TH_T27_BG;
    let light_bg : str = TH_PAPER_BG;
    assert dark_bg != light_bg;
    assert TH_T27_ACCENT != TH_PAPER_ACCENT;
}

invariant primary_button_inversion {
    assert TH_T27_TEXT == "#FFFFFF";
    assert TH_T27_BG   == "#000000";
    assert TH_PAPER_TEXT == "#000000";
    assert TH_PAPER_BG   == "#FFFFFF";
}
