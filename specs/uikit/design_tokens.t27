; specs/uikit/design_tokens.t27 -- design tokens for the t27 UI Kit, two themes.
; Extracted from t27.ai live site (trinity/apps/website/src/pages/UIKit.tsx TOKENS object).
; Source of truth for all UI Kit spec work.
; Refs #13698.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).

module uikit::design_tokens

; ── TH_T27 (dark theme) ──────────────────────────────────────────────────────
pub const TH_T27_BG              = "#000000"
pub const TH_T27_TEXT            = "#FFFFFF"
pub const TH_T27_MUTED           = "#888888"
pub const TH_T27_ACCENT          = "#00FF88"
pub const TH_T27_ACCENT_DARK     = "#00CC66"
pub const TH_T27_GOLD            = "#FFD700"
pub const TH_T27_BORDER          = "rgba(255,255,255,0.08)"
pub const TH_T27_CARD_BORDER     = "#333333"
pub const TH_T27_CARD_BORDER_HOV = "#FFFFFF"
pub const TH_T27_CARD_DESC       = "#A6A6A6"
pub const TH_T27_CARD_FOOT       = "#8A8A8A"
pub const TH_T27_SURFACE_INPUT   = "#1A1A1A"
pub const TH_T27_SURFACE_CARD    = "#0A0A0A"

; ── TH_PAPER (light theme) ───────────────────────────────────────────────────
pub const TH_PAPER_BG              = "#FFFFFF"
pub const TH_PAPER_TEXT            = "#000000"
pub const TH_PAPER_MUTED           = "#666666"
pub const TH_PAPER_ACCENT          = "#00A35C"
pub const TH_PAPER_ACCENT_DARK     = "#007A45"
pub const TH_PAPER_GOLD            = "#B38F00"
pub const TH_PAPER_BORDER          = "rgba(0,0,0,0.08)"
pub const TH_PAPER_CARD_BORDER     = "#CCCCCC"
pub const TH_PAPER_CARD_BORDER_HOV = "#000000"
pub const TH_PAPER_CARD_DESC       = "#4D4D4D"
pub const TH_PAPER_CARD_FOOT       = "#666666"
pub const TH_PAPER_SURFACE_INPUT   = "#F5F5F5"
pub const TH_PAPER_SURFACE_CARD    = "#FAFAFA"

; ── Typography ───────────────────────────────────────────────────────────────
pub const FONT_FAMILY    = "Outfit, system-ui, sans-serif"
pub const FONT_SIZE_XS   = "11px"
pub const FONT_SIZE_SM   = "12px"
pub const FONT_SIZE_MD   = "14px"
pub const FONT_SIZE_BASE = "15px"
pub const FONT_SIZE_H1   = "15.2px"

; ── Spacing ──────────────────────────────────────────────────────────────────
pub const SPACE_XS  = "4px"
pub const SPACE_SM  = "8px"
pub const SPACE_MD  = "12px"
pub const SPACE_LG  = "16px"
pub const SPACE_XL  = "20px"
pub const SPACE_2XL = "32px"

; ── Radius ───────────────────────────────────────────────────────────────────
pub const RADIUS_SM   = "4px"
pub const RADIUS_MD   = "8px"
pub const RADIUS_LG   = "12px"
pub const RADIUS_PILL = "999px"

; ── Button ───────────────────────────────────────────────────────────────────
; B&W brand: primary button inverts bg/text between themes.
; TH_T27:   background = TH_T27_TEXT   (#FFFFFF), color = TH_T27_BG   (#000000)
; TH_PAPER: background = TH_PAPER_TEXT (#000000), color = TH_PAPER_BG (#FFFFFF)
pub const BTN_PADDING       = "12px 20px"
pub const BTN_MIN_HEIGHT    = "44px"
pub const BTN_FONT_SIZE     = FONT_SIZE_BASE
pub const BTN_FONT_WEIGHT   = 400
pub const BTN_BORDER_RADIUS = RADIUS_PILL

; ── Tests ────────────────────────────────────────────────────────────────────
test themes_differ {
  assert TH_T27_BG != TH_PAPER_BG
  assert TH_T27_TEXT != TH_PAPER_TEXT
  assert TH_T27_ACCENT != TH_PAPER_ACCENT
}

invariant primary_button_inversion {
  ; dark theme: white bg, black label
  assert TH_T27_TEXT == "#FFFFFF"
  assert TH_T27_BG   == "#000000"
  ; light theme: black bg, white label
  assert TH_PAPER_TEXT == "#000000"
  assert TH_PAPER_BG   == "#FFFFFF"
}
