// SPDX-License-Identifier: Apache-2.0
; specs/uikit/hero_card.t27 -- the UI Kit HeroCard object: the large card that opens a page, with
; a title, a big headline and an optional one-line subtitle on a plate-like surface. One object,
; one spec: config + create, measure, render (role-named draw ops, relative to the object's own
; 0,0), hit_test, state (0..5), theme_bind (Dark 0, Light 1), a11y_name, dispose.
; Text lengths are in characters (the host owns the strings, as in text.t27). Sizes come from
; design_tokens.t27 and the plate tokens; a size with no token is a named PROPOSED TOKEN constant.
; No colour literal: only roles. No host draws it yet.
; Refs #13918, #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_hero_card;

use uikit::plate::PL_RADIUS;
use uikit::plate::PL_PAD_M;
use uikit::plate::PL_ROLE_SURFACE;
use uikit::plate::PL_ROLE_INK;
use uikit::plate::pl_alpha;
use uikit::plate::pl_state_ok;
use uikit::plate::pl_theme_ok;
use uikit::plate::PL_STATE_DEFAULT;
use uikit::plate::PL_STATE_HOVER;
use uikit::plate::PL_STATE_PRESSED;
use uikit::plate::PL_STATE_FOCUS;
use uikit::plate::PL_STATE_DISABLED;
use uikit::plate::PL_STATE_LOADING;
use uikit::plate::PL_THEME_DARK;
use uikit::plate::PL_THEME_LIGHT;
use uikit::plate::PL_A_FULL;
use uikit::plate::PL_A_PRESSED;
use uikit::plate::PL_A_LOADING;
use uikit::plate::PL_A_DISABLED;
use uikit::plate::PL_BORDER_W;

; ---- Draw op kinds and slots ----
pub const HC_OP_RECT : u32 = 0;
pub const HC_OP_TEXT : u32 = 1;

pub const HC_SLOT_SURFACE  : u32 = 0;
pub const HC_SLOT_TITLE    : u32 = 1;
pub const HC_SLOT_HEADLINE : u32 = 2;
pub const HC_SLOT_SUBTITLE : u32 = 3;
pub const HC_MAX_OPS       : u32 = 4;

; ---- Tokens (px) ----
; SPACE_XS in design_tokens.t27: gap between the rows
pub const HC_GAP : u32 = 4;
; FONT_SIZE_SM in design_tokens.t27 (12px): title text
pub const HC_FONT_TITLE : u32 = 12;
; FONT_SIZE_MD in design_tokens.t27 (14px): subtitle text
pub const HC_FONT_SUBTITLE : u32 = 14;
; PROPOSED TOKEN: font size of the big headline (no display size token exists)
pub const HC_FONT_HEADLINE : u32 = 32;
; PROPOSED TOKEN: line heights of the title, headline and subtitle rows
pub const HC_LH_TITLE : u32 = 16;
pub const HC_LH_HEADLINE : u32 = 40;
pub const HC_LH_SUBTITLE : u32 = 20;
; PROPOSED TOKEN: average glyph advance per character for each text size
pub const HC_CHAR_W_TITLE : u32 = 7;
pub const HC_CHAR_W_HEADLINE : u32 = 18;
pub const HC_CHAR_W_SUBTITLE : u32 = 8;
; PROPOSED TOKEN: minimum width of a card
pub const HC_MIN_W : u32 = 120;
; two pads, title row, gap, headline row: 16 + 16 + 16 + 4 + 40 = 92
pub const HC_H_PLAIN : u32 = 92;
; plain height plus a gap and the subtitle row: 92 + 4 + 20 = 116
pub const HC_H_SUB : u32 = 116;
; PROPOSED TOKEN: focus stroke width (the non-colour focus cue)
pub const HC_FOCUS_W : u32 = 2;
; PROPOSED TOKEN: title and subtitle alpha (per mille) before the state alpha is applied
pub const HC_A_MUTED : u32 = 700;

; ---- Config and object ----
; title_len, headline_len and subtitle_len are character counts; subtitle_len 0 means no subtitle.
; name_id picks the a11y name; 0 means the default name.
pub struct HcConfig {
    title_len: u32,
    headline_len: u32,
    subtitle_len: u32,
    name_id: u32,
}

pub struct HeroCard {
    cfg: HcConfig,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct HcSize {
    w: u32,
    h: u32,
}

pub struct HcOp {
    kind: u32,
    slot: u32,
    role: u32,
    x: i32,
    y: i32,
    w: u32,
    h: u32,
    font: u32,
    radius: u32,
    stroke: u32,
    alpha: u32,
    clip: u32,
}

pub fn hc_state_ok(s: u32) -> bool { return pl_state_ok(s); }
pub fn hc_theme_ok(t: u32) -> bool { return pl_theme_ok(t); }

/// create: the card starts in the default state, Dark theme, alive.
pub fn hc_create(title_len: u32, headline_len: u32, subtitle_len: u32, name_id: u32) -> HeroCard {
    return HeroCard {
        cfg: HcConfig { title_len: title_len, headline_len: headline_len, subtitle_len: subtitle_len, name_id: name_id },
        state: PL_STATE_DEFAULT,
        theme: PL_THEME_DARK,
        alive: true,
    };
}

/// state: an out-of-range state is refused (the card is returned unchanged).
pub fn hc_set_state(c: HeroCard, state: u32) -> HeroCard {
    if (hc_state_ok(state) == false) { return c; }
    if (c.alive == false) { return c; }
    var q : HeroCard = c;
    q.state = state;
    return q;
}

/// theme_bind: Dark (0) or Light (1); any other value is refused. Geometry and state never change.
pub fn hc_set_theme(c: HeroCard, theme: u32) -> HeroCard {
    if (hc_theme_ok(theme) == false) { return c; }
    var q : HeroCard = c;
    q.theme = theme;
    return q;
}

/// dispose: inert, default state, no longer hit.
pub fn hc_dispose(c: HeroCard) -> HeroCard {
    var q : HeroCard = c;
    q.alive = false;
    q.state = PL_STATE_DEFAULT;
    return q;
}

// ---- layout ----

pub fn hc_has_subtitle(cfg: HcConfig) -> bool { return cfg.subtitle_len > 0; }

/// measure: the card fills the width it is offered (never below HC_MIN_W); its height is fixed
/// by whether a subtitle row exists.
pub fn hc_measure(cfg: HcConfig, avail_w: u32) -> HcSize {
    var w : u32 = avail_w;
    if (w < HC_MIN_W) { w = HC_MIN_W; }
    if (hc_has_subtitle(cfg)) { return HcSize { w: w, h: HC_H_SUB }; }
    return HcSize { w: w, h: HC_H_PLAIN };
}

/// Inner width: the measured width minus the two pads.
pub fn hc_inner_w(cfg: HcConfig, avail_w: u32) -> u32 {
    return hc_measure(cfg, avail_w).w - 2 * PL_PAD_M;
}

/// Width of the title text: natural, capped at the inner width.
pub fn hc_title_w(cfg: HcConfig, avail_w: u32) -> u32 {
    const inner : u32 = hc_inner_w(cfg, avail_w);
    const nat : u32 = cfg.title_len * HC_CHAR_W_TITLE;
    if (nat > inner) { return inner; }
    return nat;
}

/// Width the headline is drawn at: natural width, truncated at the inner width.
pub fn hc_headline_w(cfg: HcConfig, avail_w: u32) -> u32 {
    const inner : u32 = hc_inner_w(cfg, avail_w);
    const nat : u32 = cfg.headline_len * HC_CHAR_W_HEADLINE;
    if (nat > inner) { return inner; }
    return nat;
}

/// Whether the headline is truncated at this width (the host draws an ellipsis when clip is 1).
pub fn hc_headline_clipped(cfg: HcConfig, avail_w: u32) -> bool {
    return cfg.headline_len * HC_CHAR_W_HEADLINE > hc_inner_w(cfg, avail_w);
}

/// Width of the subtitle text: natural, capped at the inner width; 0 without a subtitle.
pub fn hc_subtitle_w(cfg: HcConfig, avail_w: u32) -> u32 {
    if (hc_has_subtitle(cfg) == false) { return 0; }
    const inner : u32 = hc_inner_w(cfg, avail_w);
    const nat : u32 = cfg.subtitle_len * HC_CHAR_W_SUBTITLE;
    if (nat > inner) { return inner; }
    return nat;
}

/// Whether the subtitle is truncated at this width.
pub fn hc_subtitle_clipped(cfg: HcConfig, avail_w: u32) -> bool {
    if (hc_has_subtitle(cfg) == false) { return false; }
    return cfg.subtitle_len * HC_CHAR_W_SUBTITLE > hc_inner_w(cfg, avail_w);
}

// ---- state cues ----

/// Alpha per state, per mille (the plate's state alphas).
pub fn hc_alpha(state: u32) -> u32 { return pl_alpha(state); }

/// Surface stroke width per state: the non-colour cue for hover, pressed and focus.
pub fn hc_stroke(state: u32) -> u32 {
    if (state == PL_STATE_HOVER) { return 2; }
    if (state == PL_STATE_PRESSED) { return 3; }
    if (state == PL_STATE_FOCUS) { return HC_FOCUS_W; }
    return PL_BORDER_W;
}

// ---- render ----

/// How many draw ops the card emits: surface, title, headline, and the subtitle when there is one.
pub fn hc_op_count(c: HeroCard) -> u32 {
    if (c.alive == false) { return 0; }
    if (hc_has_subtitle(c.cfg)) { return 4; }
    return 3;
}

/// The i-th draw op (relative to the card's own 0,0), given the width it was measured at.
/// An index past the op count yields an empty rect (alpha 0). The theme changes no number here:
/// roles are mapped to levels by the host.
pub fn hc_op(c: HeroCard, avail_w: u32, i: u32) -> HcOp {
    const sz : HcSize = hc_measure(c.cfg, avail_w);
    const empty : HcOp = HcOp { kind: HC_OP_RECT, slot: HC_SLOT_SURFACE, role: PL_ROLE_SURFACE, x: 0, y: 0,
                                w: 0, h: 0, font: 0, radius: 0, stroke: 0, alpha: 0, clip: 0 };
    if (i >= hc_op_count(c)) { return empty; }
    const a : u32 = hc_alpha(c.state);
    const muted : u32 = a * HC_A_MUTED / 1000;
    const pad : i32 = @as(i32, @intCast(PL_PAD_M));
    const row2 : i32 = pad + @as(i32, @intCast(HC_LH_TITLE + HC_GAP));
    const row3 : i32 = row2 + @as(i32, @intCast(HC_LH_HEADLINE + HC_GAP));
    if (i == 0) {
        return HcOp { kind: HC_OP_RECT, slot: HC_SLOT_SURFACE, role: PL_ROLE_SURFACE, x: 0, y: 0, w: sz.w, h: sz.h,
                      font: 0, radius: PL_RADIUS, stroke: hc_stroke(c.state), alpha: a, clip: 0 };
    }
    if (i == 1) {
        var tclip : u32 = 0;
        if (hc_title_w(c.cfg, avail_w) < c.cfg.title_len * HC_CHAR_W_TITLE) { tclip = 1; }
        return HcOp { kind: HC_OP_TEXT, slot: HC_SLOT_TITLE, role: PL_ROLE_INK, x: pad, y: pad,
                      w: hc_title_w(c.cfg, avail_w), h: HC_LH_TITLE, font: HC_FONT_TITLE, radius: 0, stroke: 0,
                      alpha: muted, clip: tclip };
    }
    if (i == 2) {
        var hclip : u32 = 0;
        if (hc_headline_clipped(c.cfg, avail_w)) { hclip = 1; }
        return HcOp { kind: HC_OP_TEXT, slot: HC_SLOT_HEADLINE, role: PL_ROLE_INK, x: pad, y: row2,
                      w: hc_headline_w(c.cfg, avail_w), h: HC_LH_HEADLINE, font: HC_FONT_HEADLINE, radius: 0,
                      stroke: 0, alpha: a, clip: hclip };
    }
    var sclip : u32 = 0;
    if (hc_subtitle_clipped(c.cfg, avail_w)) { sclip = 1; }
    return HcOp { kind: HC_OP_TEXT, slot: HC_SLOT_SUBTITLE, role: PL_ROLE_INK, x: pad, y: row3,
                  w: hc_subtitle_w(c.cfg, avail_w), h: HC_LH_SUBTITLE, font: HC_FONT_SUBTITLE, radius: 0,
                  stroke: 0, alpha: muted, clip: sclip };
}

// ---- hit test ----

/// hit_test: x, y relative to the card's own box. A disposed card is a miss.
pub fn hc_hit(c: HeroCard, avail_w: u32, x: i32, y: i32) -> bool {
    if (c.alive == false) { return false; }
    if (x < 0 or y < 0) { return false; }
    const sz : HcSize = hc_measure(c.cfg, avail_w);
    return x < @as(i32, @intCast(sz.w)) and y < @as(i32, @intCast(sz.h));
}

// ---- accessibility ----

/// a11y_name: the card name; never empty (id 0 and unknown ids take the default name).
pub fn hc_a11y_name(c: HeroCard) -> str {
    if (c.cfg.name_id == 1) { return "Page summary"; }
    if (c.cfg.name_id == 2) { return "Status summary"; }
    if (c.cfg.name_id == 3) { return "Welcome summary"; }
    return "Hero card";
}

// ---- tests ----

test create_applies_config {
    const c : HeroCard = hc_create(5, 4, 20, 1);
    assert c.cfg.title_len == 5;
    assert c.cfg.headline_len == 4;
    assert c.cfg.subtitle_len == 20;
    assert c.state == PL_STATE_DEFAULT;
    assert c.theme == PL_THEME_DARK;
    assert c.alive;
}

test measure_uses_token_sizes {
    const with_sub : HeroCard = hc_create(5, 4, 20, 0);
    const plain : HeroCard = hc_create(5, 4, 0, 0);
    assert hc_measure(with_sub.cfg, 300).w == 300;
    assert hc_measure(with_sub.cfg, 300).h == HC_H_SUB;
    assert hc_measure(plain.cfg, 300).h == HC_H_PLAIN;
    assert HC_H_PLAIN == 2 * PL_PAD_M + HC_LH_TITLE + HC_GAP + HC_LH_HEADLINE;
    assert HC_H_SUB == HC_H_PLAIN + HC_GAP + HC_LH_SUBTITLE;
    assert hc_measure(plain.cfg, 10).w == HC_MIN_W;
}

test render_surface_uses_surface_role_and_plate_radius {
    const c : HeroCard = hc_create(5, 4, 20, 0);
    const s : HcOp = hc_op(c, 300, 0);
    assert s.kind == HC_OP_RECT;
    assert s.role == PL_ROLE_SURFACE;
    assert s.radius == PL_RADIUS;
    assert s.x == 0;
    assert s.y == 0;
    assert s.w == 300;
    assert s.h == HC_H_SUB;
}

test render_op_count_with_and_without_subtitle {
    const with_sub : HeroCard = hc_create(5, 4, 20, 0);
    const plain : HeroCard = hc_create(5, 4, 0, 0);
    assert hc_op_count(with_sub) == 4;
    assert hc_op_count(plain) == 3;
    assert hc_op_count(with_sub) <= HC_MAX_OPS;
    assert hc_op(plain, 300, 3).alpha == 0;
    assert hc_op(with_sub, 300, 3).slot == HC_SLOT_SUBTITLE;
    assert hc_op(with_sub, 300, 1).slot == HC_SLOT_TITLE;
    assert hc_op(with_sub, 300, 2).slot == HC_SLOT_HEADLINE;
}

test render_text_sizes_come_from_tokens {
    const c : HeroCard = hc_create(5, 4, 20, 0);
    assert hc_op(c, 300, 1).font == HC_FONT_TITLE;
    assert hc_op(c, 300, 2).font == HC_FONT_HEADLINE;
    assert hc_op(c, 300, 3).font == HC_FONT_SUBTITLE;
    assert hc_op(c, 300, 1).x == @as(i32, @intCast(PL_PAD_M));
    assert hc_op(c, 300, 2).role == PL_ROLE_INK;
    assert hc_op(c, 300, 1).alpha < hc_op(c, 300, 2).alpha;
    assert hc_op(c, 300, 2).y > hc_op(c, 300, 1).y;
    assert hc_op(c, 300, 3).y > hc_op(c, 300, 2).y;
}

test headline_fits_at_wide_width_and_is_not_clipped {
    const c : HeroCard = hc_create(5, 4, 20, 0);
    assert hc_headline_clipped(c.cfg, 300) == false;
    assert hc_op(c, 300, 2).w == 4 * HC_CHAR_W_HEADLINE;
    assert hc_op(c, 300, 2).clip == 0;
}

test headline_truncates_at_narrow_width {
    const c : HeroCard = hc_create(5, 20, 20, 0);
    assert hc_headline_clipped(c.cfg, 160);
    const h : HcOp = hc_op(c, 160, 2);
    assert h.clip == 1;
    assert h.w == hc_inner_w(c.cfg, 160);
    assert h.w < 20 * HC_CHAR_W_HEADLINE;
    assert h.x + @as(i32, @intCast(h.w)) <= @as(i32, @intCast(hc_measure(c.cfg, 160).w - PL_PAD_M));
}

test hit_test_inside_and_outside {
    const c : HeroCard = hc_create(5, 4, 0, 0);
    assert hc_hit(c, 200, 0, 0);
    assert hc_hit(c, 200, 199, 91);
    assert hc_hit(c, 200, 200, 10) == false;
    assert hc_hit(c, 200, 10, 92) == false;
    assert hc_hit(c, 200, -1, 5) == false;
    assert hc_hit(c, 200, 5, -1) == false;
}

test state_zero_to_five_accepted_and_out_of_range_refused {
    const c : HeroCard = hc_create(5, 4, 20, 0);
    assert hc_set_state(c, PL_STATE_HOVER).state == PL_STATE_HOVER;
    assert hc_set_state(c, PL_STATE_LOADING).state == PL_STATE_LOADING;
    assert hc_set_state(c, 6).state == PL_STATE_DEFAULT;
    assert hc_set_state(hc_set_state(c, PL_STATE_FOCUS), 99).state == PL_STATE_FOCUS;
    assert hc_state_ok(5);
    assert hc_state_ok(6) == false;
}

test state_alphas_and_strokes_come_from_the_state {
    const c : HeroCard = hc_create(5, 4, 20, 0);
    assert hc_op(c, 300, 0).alpha == PL_A_FULL;
    assert hc_op(hc_set_state(c, PL_STATE_PRESSED), 300, 0).alpha == PL_A_PRESSED;
    assert hc_op(hc_set_state(c, PL_STATE_DISABLED), 300, 0).alpha == PL_A_DISABLED;
    assert hc_op(hc_set_state(c, PL_STATE_LOADING), 300, 0).alpha == PL_A_LOADING;
    assert hc_stroke(PL_STATE_FOCUS) != hc_stroke(PL_STATE_DEFAULT);
    assert hc_stroke(PL_STATE_HOVER) != hc_stroke(PL_STATE_PRESSED);
}

test theme_switch_keeps_geometry_and_state_in_both_themes {
    const d : HeroCard = hc_set_state(hc_create(5, 20, 20, 1), PL_STATE_FOCUS);
    const l : HeroCard = hc_set_theme(d, PL_THEME_LIGHT);
    assert l.theme == PL_THEME_LIGHT;
    assert l.state == PL_STATE_FOCUS;
    assert hc_set_theme(l, PL_THEME_DARK).theme == PL_THEME_DARK;
    assert hc_set_theme(l, 5).theme == PL_THEME_LIGHT;
    assert hc_measure(d.cfg, 160).w == hc_measure(l.cfg, 160).w;
    assert hc_measure(d.cfg, 160).h == hc_measure(l.cfg, 160).h;
    assert hc_op_count(d) == hc_op_count(l);
    var i : u32 = 0;
    while (i < hc_op_count(d)) {
        const a : HcOp = hc_op(d, 160, i);
        const b : HcOp = hc_op(l, 160, i);
        assert a.x == b.x;
        assert a.y == b.y;
        assert a.w == b.w;
        assert a.h == b.h;
        assert a.role == b.role;
        assert a.alpha == b.alpha;
        i = i + 1;
    }
}

test a11y_name_is_non_empty_for_every_id {
    var n : u32 = 0;
    while (n < 6) {
        assert hc_a11y_name(hc_create(5, 4, 20, n)).len > 0;
        n = n + 1;
    }
    assert hc_a11y_name(hc_create(5, 4, 20, 1)) != hc_a11y_name(hc_create(5, 4, 20, 2));
}

test dispose_makes_hit_test_a_miss {
    const c : HeroCard = hc_set_state(hc_create(5, 4, 20, 1), PL_STATE_FOCUS);
    assert hc_hit(c, 200, 5, 5);
    const d : HeroCard = hc_dispose(c);
    assert d.alive == false;
    assert d.state == PL_STATE_DEFAULT;
    assert hc_hit(d, 200, 5, 5) == false;
    assert hc_op_count(d) == 0;
    assert hc_set_state(d, PL_STATE_HOVER).state == PL_STATE_DEFAULT;
}

invariant ops_stay_inside_the_measured_box {
    const c : HeroCard = hc_set_state(hc_create(30, 12, 60, 3), PL_STATE_LOADING);
    const w : u32 = HC_MIN_W;
    const sz : HcSize = hc_measure(c.cfg, w);
    var i : u32 = 0;
    while (i < hc_op_count(c)) {
        const o : HcOp = hc_op(c, w, i);
        assert o.x >= 0;
        assert o.y >= 0;
        assert o.x + @as(i32, @intCast(o.w)) <= @as(i32, @intCast(sz.w));
        assert o.y + @as(i32, @intCast(o.h)) <= @as(i32, @intCast(sz.h));
        i = i + 1;
    }
}
