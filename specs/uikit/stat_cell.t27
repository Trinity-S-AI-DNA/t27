// SPDX-License-Identifier: Apache-2.0
; specs/uikit/stat_cell.t27 -- the UI Kit StatCell object: a small number cell with a label, a big
; value and an optional unit, drawn on a plate-like surface. One object, one spec: config + create,
; measure, render (role-named draw ops, relative to the object's own 0,0), hit_test, state (0..5),
; theme_bind (Dark 0, Light 1), a11y_name, dispose.
; Text lengths are in characters (the host owns the strings, as in text.t27). Sizes come from
; design_tokens.t27 and the plate tokens; a size with no token is a named PROPOSED TOKEN constant.
; No colour literal: only roles. No host draws it yet.
; Refs #13914, #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stat_cell;

use uikit::plate::{PL_RADIUS, PL_PAD_M, PL_ROLE_SURFACE, PL_ROLE_INK, PL_STATES, PL_STATE_DEFAULT, PL_STATE_HOVER, PL_STATE_PRESSED, PL_STATE_FOCUS, PL_STATE_DISABLED, PL_STATE_LOADING, PL_THEME_DARK, PL_THEME_LIGHT, PL_A_FULL, PL_A_PRESSED, PL_A_LOADING, PL_A_DISABLED, PL_BORDER_W};

; ---- Draw op kinds and slots ----
pub const SC_OP_RECT : u32 = 0;
pub const SC_OP_TEXT : u32 = 1;

pub const SC_SLOT_SURFACE : u32 = 0;
pub const SC_SLOT_LABEL   : u32 = 1;
pub const SC_SLOT_VALUE   : u32 = 2;
pub const SC_SLOT_UNIT    : u32 = 3;
pub const SC_MAX_OPS      : u32 = 4;

; ---- Tokens (px) ----
; SPACE_XS in design_tokens.t27: gap between label and value, and between value and unit
pub const SC_GAP : u32 = 4;
; FONT_SIZE_SM in design_tokens.t27 (12px): label and unit text
pub const SC_FONT_SMALL : u32 = 12;
; PROPOSED TOKEN: font size of the big value (no display size token exists)
pub const SC_FONT_VALUE : u32 = 24;
; PROPOSED TOKEN: line heights of the small and the value rows
pub const SC_LH_SMALL : u32 = 16;
pub const SC_LH_VALUE : u32 = 32;
; PROPOSED TOKEN: average glyph advance per character for each text size
pub const SC_CHAR_W_SMALL : u32 = 7;
pub const SC_CHAR_W_VALUE : u32 = 14;
; PROPOSED TOKEN: widest the unit text may grow
pub const SC_UNIT_MAX_W : u32 = 40;
; PROPOSED TOKEN: minimum width of a cell (inner width stays above the widest unit plus gap)
pub const SC_MIN_W : u32 = 96;
; two pads, label row, gap, value row: 16 + 16 + 16 + 4 + 32 = 84
pub const SC_H : u32 = 84;
; PROPOSED TOKEN: focus stroke width (the non-colour focus cue)
pub const SC_FOCUS_W : u32 = 2;
; PROPOSED TOKEN: label and unit alpha (per mille) before the state alpha is applied
pub const SC_A_MUTED : u32 = 700;

; ---- Config and object ----
; label_len, value_len and unit_len are character counts; unit_len 0 means no unit.
; name_id picks the a11y name; 0 means the default name.
pub struct ScConfig {
    label_len: u32,
    value_len: u32,
    unit_len: u32,
    name_id: u32,
}

pub struct StatCell {
    cfg: ScConfig,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct ScSize {
    w: u32,
    h: u32,
}

pub struct ScOp {
    kind: u32,
    slot: u32,
    role: u32,
    x: i32,
    y: i32,
    w: u32,
    h: u32,
    font: u32,
    radius: u32,
    stroke: u32,
    alpha: u32,
    clip: u32,
}

pub fn sc_state_ok(s: u32) -> bool { return s < PL_STATES; }
pub fn sc_theme_ok(t: u32) -> bool { return t <= PL_THEME_LIGHT; }

/// create: the cell starts in the default state, Dark theme, alive.
pub fn sc_create(label_len: u32, value_len: u32, unit_len: u32, name_id: u32) -> StatCell {
    return StatCell {
        cfg: ScConfig { label_len: label_len, value_len: value_len, unit_len: unit_len, name_id: name_id },
        state: PL_STATE_DEFAULT,
        theme: PL_THEME_DARK,
        alive: true,
    };
}

/// state: an out-of-range state is refused (the cell is returned unchanged).
pub fn sc_set_state(c: StatCell, state: u32) -> StatCell {
    if (sc_state_ok(state) == false) { return c; }
    if (c.alive == false) { return c; }
    var q : StatCell = c;
    q.state = state;
    return q;
}

/// theme_bind: Dark (0) or Light (1); any other value is refused. Geometry and state never change.
pub fn sc_set_theme(c: StatCell, theme: u32) -> StatCell {
    if (sc_theme_ok(theme) == false) { return c; }
    var q : StatCell = c;
    q.theme = theme;
    return q;
}

/// dispose: inert, default state, no longer hit.
pub fn sc_dispose(c: StatCell) -> StatCell {
    var q : StatCell = c;
    q.alive = false;
    q.state = PL_STATE_DEFAULT;
    return q;
}

// ---- layout ----

pub fn sc_has_unit(cfg: ScConfig) -> bool { return cfg.unit_len > 0; }

/// measure: the cell fills the width it is offered (never below SC_MIN_W); its height is fixed.
pub fn sc_measure(cfg: ScConfig, avail_w: u32) -> ScSize {
    var w : u32 = avail_w;
    if (w < SC_MIN_W) { w = SC_MIN_W; }
    return ScSize { w: w, h: SC_H };
}

/// Width of the unit text: its natural width, capped at SC_UNIT_MAX_W; 0 without a unit.
pub fn sc_unit_w(cfg: ScConfig) -> u32 {
    if (sc_has_unit(cfg) == false) { return 0; }
    const nat : u32 = cfg.unit_len * SC_CHAR_W_SMALL;
    if (nat > SC_UNIT_MAX_W) { return SC_UNIT_MAX_W; }
    return nat;
}

/// Width of the label text: natural, capped at the inner width.
pub fn sc_label_w(cfg: ScConfig, avail_w: u32) -> u32 {
    const inner : u32 = sc_measure(cfg, avail_w).w - 2 * PL_PAD_M;
    const nat : u32 = cfg.label_len * SC_CHAR_W_SMALL;
    if (nat > inner) { return inner; }
    return nat;
}

/// The most width the value may take: the inner width minus the unit and its gap.
pub fn sc_value_max_w(cfg: ScConfig, avail_w: u32) -> u32 {
    const inner : u32 = sc_measure(cfg, avail_w).w - 2 * PL_PAD_M;
    if (sc_has_unit(cfg)) { return inner - sc_unit_w(cfg) - SC_GAP; }
    return inner;
}

/// Width the value is drawn at: natural width, truncated at the most it may take.
pub fn sc_value_w(cfg: ScConfig, avail_w: u32) -> u32 {
    const nat : u32 = cfg.value_len * SC_CHAR_W_VALUE;
    const mx : u32 = sc_value_max_w(cfg, avail_w);
    if (nat > mx) { return mx; }
    return nat;
}

/// Whether the value is truncated at this width (the host draws an ellipsis when clip is 1).
pub fn sc_value_clipped(cfg: ScConfig, avail_w: u32) -> bool {
    return cfg.value_len * SC_CHAR_W_VALUE > sc_value_max_w(cfg, avail_w);
}

// ---- state cues ----

/// Alpha per state, per mille (the plate's state alphas).
pub fn sc_alpha(state: u32) -> u32 {
    if (state == PL_STATE_PRESSED) { return PL_A_PRESSED; }
    if (state == PL_STATE_LOADING) { return PL_A_LOADING; }
    if (state == PL_STATE_DISABLED) { return PL_A_DISABLED; }
    return PL_A_FULL;
}

/// Surface stroke width per state: the non-colour cue for hover, pressed and focus.
pub fn sc_stroke(state: u32) -> u32 {
    if (state == PL_STATE_HOVER) { return 2; }
    if (state == PL_STATE_PRESSED) { return 3; }
    if (state == PL_STATE_FOCUS) { return SC_FOCUS_W; }
    return PL_BORDER_W;
}

// ---- render ----

/// How many draw ops the cell emits: surface, label, value, and the unit when there is one.
pub fn sc_op_count(c: StatCell) -> u32 {
    if (c.alive == false) { return 0; }
    if (sc_has_unit(c.cfg)) { return 4; }
    return 3;
}

/// The i-th draw op (relative to the cell's own 0,0), given the width it was measured at.
/// An index past the op count yields an empty rect (alpha 0). The theme changes no number here:
/// roles are mapped to levels by the host.
pub fn sc_op(c: StatCell, avail_w: u32, i: u32) -> ScOp {
    const sz : ScSize = sc_measure(c.cfg, avail_w);
    const empty : ScOp = ScOp { kind: SC_OP_RECT, slot: SC_SLOT_SURFACE, role: PL_ROLE_SURFACE, x: 0, y: 0,
                                w: 0, h: 0, font: 0, radius: 0, stroke: 0, alpha: 0, clip: 0 };
    if (i >= sc_op_count(c)) { return empty; }
    const a : u32 = sc_alpha(c.state);
    const muted : u32 = a * SC_A_MUTED / 1000;
    const pad : i32 = @as(i32, @intCast(PL_PAD_M));
    const row2 : i32 = pad + @as(i32, @intCast(SC_LH_SMALL + SC_GAP));
    if (i == 0) {
        return ScOp { kind: SC_OP_RECT, slot: SC_SLOT_SURFACE, role: PL_ROLE_SURFACE, x: 0, y: 0, w: sz.w, h: sz.h,
                      font: 0, radius: PL_RADIUS, stroke: sc_stroke(c.state), alpha: a, clip: 0 };
    }
    if (i == 1) {
        return ScOp { kind: SC_OP_TEXT, slot: SC_SLOT_LABEL, role: PL_ROLE_INK, x: pad, y: pad,
                      w: sc_label_w(c.cfg, avail_w), h: SC_LH_SMALL, font: SC_FONT_SMALL, radius: 0, stroke: 0,
                      alpha: muted, clip: 0 };
    }
    var clip : u32 = 0;
    if (sc_value_clipped(c.cfg, avail_w)) { clip = 1; }
    const vw : u32 = sc_value_w(c.cfg, avail_w);
    if (i == 2) {
        return ScOp { kind: SC_OP_TEXT, slot: SC_SLOT_VALUE, role: PL_ROLE_INK, x: pad, y: row2,
                      w: vw, h: SC_LH_VALUE, font: SC_FONT_VALUE, radius: 0, stroke: 0, alpha: a, clip: clip };
    }
    return ScOp { kind: SC_OP_TEXT, slot: SC_SLOT_UNIT, role: PL_ROLE_INK,
                  x: pad + @as(i32, @intCast(vw + SC_GAP)), y: row2 + @as(i32, @intCast(SC_LH_VALUE - SC_LH_SMALL)),
                  w: sc_unit_w(c.cfg), h: SC_LH_SMALL, font: SC_FONT_SMALL, radius: 0, stroke: 0,
                  alpha: muted, clip: 0 };
}

// ---- hit test ----

/// hit_test: x, y relative to the cell's own box. A disposed cell is a miss.
pub fn sc_hit(c: StatCell, avail_w: u32, x: i32, y: i32) -> bool {
    if (c.alive == false) { return false; }
    if (x < 0 or y < 0) { return false; }
    const sz : ScSize = sc_measure(c.cfg, avail_w);
    return x < @as(i32, @intCast(sz.w)) and y < @as(i32, @intCast(sz.h));
}

// ---- accessibility ----

/// a11y_name: the cell name; never empty (id 0 and unknown ids take the default name).
pub fn sc_a11y_name(c: StatCell) -> str {
    if (c.cfg.name_id == 1) { return "Metric value"; }
    if (c.cfg.name_id == 2) { return "Counter value"; }
    if (c.cfg.name_id == 3) { return "Status value"; }
    return "Statistic";
}

// ---- tests ----

test create_applies_config {
    const c : StatCell = sc_create(5, 4, 2, 1);
    assert c.cfg.label_len == 5;
    assert c.cfg.value_len == 4;
    assert c.cfg.unit_len == 2;
    assert c.state == PL_STATE_DEFAULT;
    assert c.theme == PL_THEME_DARK;
    assert c.alive;
}

test measure_uses_token_sizes {
    const c : StatCell = sc_create(5, 4, 2, 0);
    const sz : ScSize = sc_measure(c.cfg, 200);
    assert sz.w == 200;
    assert sz.h == SC_H;
    assert SC_H == 2 * PL_PAD_M + SC_LH_SMALL + SC_GAP + SC_LH_VALUE;
    assert sc_measure(c.cfg, 10).w == SC_MIN_W;
    assert sc_measure(c.cfg, 10).h == SC_H;
}

test render_surface_uses_surface_role_and_plate_radius {
    const c : StatCell = sc_create(5, 4, 2, 0);
    const s : ScOp = sc_op(c, 200, 0);
    assert s.kind == SC_OP_RECT;
    assert s.role == PL_ROLE_SURFACE;
    assert s.radius == PL_RADIUS;
    assert s.x == 0;
    assert s.y == 0;
    assert s.w == 200;
    assert s.h == SC_H;
}

test render_op_count_with_and_without_unit {
    const with_unit : StatCell = sc_create(5, 4, 2, 0);
    const no_unit : StatCell = sc_create(5, 4, 0, 0);
    assert sc_op_count(with_unit) == 4;
    assert sc_op_count(no_unit) == 3;
    assert sc_op_count(with_unit) <= SC_MAX_OPS;
    assert sc_op(no_unit, 200, 3).alpha == 0;
    assert sc_op(with_unit, 200, 3).slot == SC_SLOT_UNIT;
    assert sc_op(with_unit, 200, 1).slot == SC_SLOT_LABEL;
    assert sc_op(with_unit, 200, 2).slot == SC_SLOT_VALUE;
}

test render_text_sizes_come_from_tokens {
    const c : StatCell = sc_create(5, 4, 2, 0);
    assert sc_op(c, 200, 1).font == SC_FONT_SMALL;
    assert sc_op(c, 200, 2).font == SC_FONT_VALUE;
    assert sc_op(c, 200, 3).font == SC_FONT_SMALL;
    assert sc_op(c, 200, 1).x == @as(i32, @intCast(PL_PAD_M));
    assert sc_op(c, 200, 2).role == PL_ROLE_INK;
    assert sc_op(c, 200, 1).alpha < sc_op(c, 200, 2).alpha;
}

test value_fits_at_wide_width_and_is_not_clipped {
    const c : StatCell = sc_create(5, 4, 2, 0);
    assert sc_value_clipped(c.cfg, 200) == false;
    assert sc_op(c, 200, 2).w == 4 * SC_CHAR_W_VALUE;
    assert sc_op(c, 200, 2).clip == 0;
}

test value_truncates_at_narrow_width {
    const c : StatCell = sc_create(5, 12, 2, 0);
    assert sc_value_clipped(c.cfg, 120);
    const v : ScOp = sc_op(c, 120, 2);
    assert v.clip == 1;
    assert v.w == sc_value_max_w(c.cfg, 120);
    assert v.w < 12 * SC_CHAR_W_VALUE;
    const u : ScOp = sc_op(c, 120, 3);
    assert u.x >= v.x + @as(i32, @intCast(v.w));
    assert u.x + @as(i32, @intCast(u.w)) <= @as(i32, @intCast(sc_measure(c.cfg, 120).w - PL_PAD_M));
}

test hit_test_inside_and_outside {
    const c : StatCell = sc_create(5, 4, 2, 0);
    assert sc_hit(c, 100, 0, 0);
    assert sc_hit(c, 100, 99, 83);
    assert sc_hit(c, 100, 100, 10) == false;
    assert sc_hit(c, 100, 10, 84) == false;
    assert sc_hit(c, 100, -1, 5) == false;
    assert sc_hit(c, 100, 5, -1) == false;
}

test state_zero_to_five_accepted_and_out_of_range_refused {
    const c : StatCell = sc_create(5, 4, 2, 0);
    assert sc_set_state(c, PL_STATE_HOVER).state == PL_STATE_HOVER;
    assert sc_set_state(c, PL_STATE_LOADING).state == PL_STATE_LOADING;
    assert sc_set_state(c, 6).state == PL_STATE_DEFAULT;
    assert sc_set_state(sc_set_state(c, PL_STATE_FOCUS), 99).state == PL_STATE_FOCUS;
    assert sc_state_ok(5);
    assert sc_state_ok(6) == false;
}

test state_alphas_and_strokes_come_from_the_state {
    const c : StatCell = sc_create(5, 4, 2, 0);
    assert sc_op(c, 200, 0).alpha == PL_A_FULL;
    assert sc_op(sc_set_state(c, PL_STATE_PRESSED), 200, 0).alpha == PL_A_PRESSED;
    assert sc_op(sc_set_state(c, PL_STATE_DISABLED), 200, 0).alpha == PL_A_DISABLED;
    assert sc_op(sc_set_state(c, PL_STATE_LOADING), 200, 0).alpha == PL_A_LOADING;
    assert sc_stroke(PL_STATE_FOCUS) != sc_stroke(PL_STATE_DEFAULT);
    assert sc_stroke(PL_STATE_HOVER) != sc_stroke(PL_STATE_PRESSED);
}

test theme_switch_keeps_geometry_and_state_in_both_themes {
    const d : StatCell = sc_set_state(sc_create(5, 12, 2, 1), PL_STATE_FOCUS);
    const l : StatCell = sc_set_theme(d, PL_THEME_LIGHT);
    assert l.theme == PL_THEME_LIGHT;
    assert l.state == PL_STATE_FOCUS;
    assert sc_set_theme(l, PL_THEME_DARK).theme == PL_THEME_DARK;
    assert sc_set_theme(l, 5).theme == PL_THEME_LIGHT;
    assert sc_measure(d.cfg, 120).w == sc_measure(l.cfg, 120).w;
    assert sc_measure(d.cfg, 120).h == sc_measure(l.cfg, 120).h;
    assert sc_op_count(d) == sc_op_count(l);
    var i : u32 = 0;
    while (i < sc_op_count(d)) {
        const a : ScOp = sc_op(d, 120, i);
        const b : ScOp = sc_op(l, 120, i);
        assert a.x == b.x;
        assert a.y == b.y;
        assert a.w == b.w;
        assert a.h == b.h;
        assert a.role == b.role;
        assert a.alpha == b.alpha;
        i = i + 1;
    }
}

test a11y_name_is_non_empty_for_every_id {
    var n : u32 = 0;
    while (n < 6) {
        assert sc_a11y_name(sc_create(5, 4, 2, n)).len > 0;
        n = n + 1;
    }
    assert sc_a11y_name(sc_create(5, 4, 2, 1)) != sc_a11y_name(sc_create(5, 4, 2, 2));
}

test dispose_makes_hit_test_a_miss {
    const c : StatCell = sc_set_state(sc_create(5, 4, 2, 1), PL_STATE_FOCUS);
    assert sc_hit(c, 100, 5, 5);
    const d : StatCell = sc_dispose(c);
    assert d.alive == false;
    assert d.state == PL_STATE_DEFAULT;
    assert sc_hit(d, 100, 5, 5) == false;
    assert sc_op_count(d) == 0;
    assert sc_set_state(d, PL_STATE_HOVER).state == PL_STATE_DEFAULT;
}

invariant ops_stay_inside_the_measured_box {
    const c : StatCell = sc_set_state(sc_create(30, 12, 9, 3), PL_STATE_LOADING);
    const w : u32 = SC_MIN_W;
    const sz : ScSize = sc_measure(c.cfg, w);
    var i : u32 = 0;
    while (i < sc_op_count(c)) {
        const o : ScOp = sc_op(c, w, i);
        assert o.x >= 0;
        assert o.y >= 0;
        assert o.x + @as(i32, @intCast(o.w)) <= @as(i32, @intCast(sz.w));
        assert o.y + @as(i32, @intCast(o.h)) <= @as(i32, @intCast(sz.h));
        i = i + 1;
    }
}
