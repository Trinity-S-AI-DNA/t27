// SPDX-License-Identifier: Apache-2.0
; specs/uikit/plate.t27 -- the UI Kit Plate object: a rounded surface panel (role surface, radius and
; border width from tokens, border role line). Variants: flat, raised. Its a11y name is the region name.
; One object, one spec: config + create, measure, render (role-named draw ops, relative to the object's
; own 0,0), hit_test, state (0..5), theme_bind (Dark 0, Light 1), a11y_name, dispose.
; Sizes come from design_tokens.t27 (RADIUS_MD = 8px, SPACE_* = 4/8/12/16/20/32px). A size with no
; token is a named PROPOSED TOKEN constant below.
; Refs #13426, #13771.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_plate;

; ── Variants, size classes, states, themes ──────────────────────────────────
pub const PL_VARIANT_FLAT   : u32 = 0;
pub const PL_VARIANT_RAISED : u32 = 1;

pub const PL_SIZE_S : u32 = 0;
pub const PL_SIZE_M : u32 = 1;
pub const PL_SIZE_L : u32 = 2;

pub const PL_STATE_DEFAULT  : u32 = 0;
pub const PL_STATE_HOVER    : u32 = 1;
pub const PL_STATE_PRESSED  : u32 = 2;
pub const PL_STATE_FOCUS    : u32 = 3;
pub const PL_STATE_DISABLED : u32 = 4;
pub const PL_STATE_LOADING  : u32 = 5;
pub const PL_STATES         : u32 = 6;

pub const PL_THEME_DARK  : u32 = 0;
pub const PL_THEME_LIGHT : u32 = 1;

; ── Roles (never a colour literal: the host maps a role to its token) ───────
pub const PL_ROLE_SURFACE : u32 = 0;
pub const PL_ROLE_INK     : u32 = 1;
pub const PL_ROLE_ACCENT  : u32 = 2;
pub const PL_ROLE_DANGER  : u32 = 3;
pub const PL_ROLE_SUCCESS : u32 = 4;
pub const PL_ROLE_LINE    : u32 = 5;

; role level in a theme: 0 = low end (black in Dark), 1 = high end (white in Dark), 2 = same in both themes
pub const PL_LEVEL_LOW  : u32 = 0;
pub const PL_LEVEL_HIGH : u32 = 1;
pub const PL_LEVEL_FIXED : u32 = 2;

; ── Draw op kinds and icons ─────────────────────────────────────────────────
pub const PL_OP_RECT : u32 = 0;
pub const PL_OP_TEXT : u32 = 1;
pub const PL_OP_ICON : u32 = 2;
pub const PL_ICON_NONE : u32 = 0;
pub const PL_ICON_LOCK : u32 = 1;
pub const PL_ICON_BUSY : u32 = 2;
pub const PL_MAX_OPS   : u32 = 4;

; ── Tokens (px) ─────────────────────────────────────────────────────────────
; RADIUS_MD in design_tokens.t27
pub const PL_RADIUS : u32 = 8;
; SPACE_SM, SPACE_LG, SPACE_2XL in design_tokens.t27: the padding of the three size classes
pub const PL_PAD_S : u32 = 8;
pub const PL_PAD_M : u32 = 16;
pub const PL_PAD_L : u32 = 32;
; PROPOSED TOKEN: border width at rest (no border width token exists)
pub const PL_BORDER_W : u32 = 1;
; PROPOSED TOKEN: minimum height per size class (two pads plus one content row)
pub const PL_MIN_H_S : u32 = 40;
pub const PL_MIN_H_M : u32 = 64;
pub const PL_MIN_H_L : u32 = 128;
; PROPOSED TOKEN: minimum width of any plate
pub const PL_MIN_W : u32 = 48;
; PROPOSED TOKEN: height of the raised variant's bottom rule
pub const PL_RAISE_H : u32 = 2;
; PROPOSED TOKEN: icon box edge for the disabled and loading cues
pub const PL_ICON_BOX : u32 = 16;

; ── State alphas (per mille) ────────────────────────────────────────────────
pub const PL_A_FULL     : u32 = 1000;
pub const PL_A_PRESSED  : u32 = 900;
pub const PL_A_LOADING  : u32 = 700;
pub const PL_A_DISABLED : u32 = 400;
pub const PL_A_RULE     : u32 = 300;

; ── Config and object ───────────────────────────────────────────────────────
; name_id picks the region name; 0 means the default region name.
pub struct PlConfig {
    variant: u32,
    size: u32,
    name_id: u32,
}

pub struct Plate {
    cfg: PlConfig,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct PlSize {
    w: u32,
    h: u32,
}

pub struct PlOp {
    kind: u32,
    role: u32,
    x: i32,
    y: i32,
    w: u32,
    h: u32,
    radius: u32,
    stroke: u32,
    alpha: u32,
    icon: u32,
}

/// Whether a variant, size and state value is in range.
pub fn pl_variant_ok(v: u32) -> bool { return v <= PL_VARIANT_RAISED; }
pub fn pl_size_ok(s: u32) -> bool { return s <= PL_SIZE_L; }
pub fn pl_state_ok(s: u32) -> bool { return s < PL_STATES; }
pub fn pl_theme_ok(t: u32) -> bool { return t <= PL_THEME_LIGHT; }

/// create: an out-of-range variant or size falls back to flat / medium; the plate starts in the
/// default state, Dark theme, alive.
pub fn pl_create(variant: u32, size: u32, name_id: u32) -> Plate {
    var v : u32 = variant;
    var s : u32 = size;
    if (pl_variant_ok(v) == false) { v = PL_VARIANT_FLAT; }
    if (pl_size_ok(s) == false) { s = PL_SIZE_M; }
    return Plate {
        cfg: PlConfig { variant: v, size: s, name_id: name_id },
        state: PL_STATE_DEFAULT,
        theme: PL_THEME_DARK,
        alive: true,
    };
}

/// state: an out-of-range state is refused (the plate is returned unchanged).
pub fn pl_set_state(p: Plate, state: u32) -> Plate {
    if (pl_state_ok(state) == false) { return p; }
    if (p.alive == false) { return p; }
    var q : Plate = p;
    q.state = state;
    return q;
}

/// theme_bind: Dark (0) or Light (1); any other value is refused.
pub fn pl_set_theme(p: Plate, theme: u32) -> Plate {
    if (pl_theme_ok(theme) == false) { return p; }
    var q : Plate = p;
    q.theme = theme;
    return q;
}

/// dispose: inert, default state, no longer hit.
pub fn pl_dispose(p: Plate) -> Plate {
    var q : Plate = p;
    q.alive = false;
    q.state = PL_STATE_DEFAULT;
    return q;
}

// ---- layout ----

pub fn pl_pad(size: u32) -> u32 {
    if (size == PL_SIZE_S) { return PL_PAD_S; }
    if (size == PL_SIZE_L) { return PL_PAD_L; }
    return PL_PAD_M;
}

pub fn pl_min_h(size: u32) -> u32 {
    if (size == PL_SIZE_S) { return PL_MIN_H_S; }
    if (size == PL_SIZE_L) { return PL_MIN_H_L; }
    return PL_MIN_H_M;
}

/// measure: a plate fills the width it is offered (never below PL_MIN_W); its height is the size
/// class's token height. Token sizes only.
pub fn pl_measure(cfg: PlConfig, avail_w: u32) -> PlSize {
    var w : u32 = avail_w;
    if (w < PL_MIN_W) { w = PL_MIN_W; }
    return PlSize { w: w, h: pl_min_h(cfg.size) };
}

// ---- state cues ----

/// Border stroke width per state: the non-colour cue for hover, pressed and focus.
pub fn pl_stroke(state: u32) -> u32 {
    if (state == PL_STATE_HOVER) { return 2; }
    if (state == PL_STATE_PRESSED) { return 3; }
    if (state == PL_STATE_FOCUS) { return 4; }
    return PL_BORDER_W;
}

/// Alpha per state, per mille.
pub fn pl_alpha(state: u32) -> u32 {
    if (state == PL_STATE_PRESSED) { return PL_A_PRESSED; }
    if (state == PL_STATE_LOADING) { return PL_A_LOADING; }
    if (state == PL_STATE_DISABLED) { return PL_A_DISABLED; }
    return PL_A_FULL;
}

/// Corner icon per state: the non-colour cue for disabled (lock) and loading (busy).
pub fn pl_icon(state: u32) -> u32 {
    if (state == PL_STATE_DISABLED) { return PL_ICON_LOCK; }
    if (state == PL_STATE_LOADING) { return PL_ICON_BUSY; }
    return PL_ICON_NONE;
}

/// Whether the state draws an extra corner icon op.
pub fn pl_has_icon(state: u32) -> bool { return pl_icon(state) != PL_ICON_NONE; }

// ---- theme ----

/// theme_bind: the level of a role in a theme. Light is the inverse of Dark for surface and ink;
/// the other roles keep their level.
pub fn pl_level(theme: u32, role: u32) -> u32 {
    if (role == PL_ROLE_SURFACE) {
        if (theme == PL_THEME_DARK) { return PL_LEVEL_LOW; }
        return PL_LEVEL_HIGH;
    }
    if (role == PL_ROLE_INK) {
        if (theme == PL_THEME_DARK) { return PL_LEVEL_HIGH; }
        return PL_LEVEL_LOW;
    }
    return PL_LEVEL_FIXED;
}

// ---- render ----

/// How many draw ops the plate emits: fill, border, optional raised rule, optional state icon.
pub fn pl_op_count(p: Plate) -> u32 {
    if (p.alive == false) { return 0; }
    var n : u32 = 2;
    if (p.cfg.variant == PL_VARIANT_RAISED) { n = n + 1; }
    if (pl_has_icon(p.state)) { n = n + 1; }
    return n;
}

/// The i-th draw op (relative to the plate's own 0,0), given the width it was measured at.
/// An index past the op count yields an empty rect (alpha 0).
pub fn pl_op(p: Plate, avail_w: u32, i: u32) -> PlOp {
    const sz : PlSize = pl_measure(p.cfg, avail_w);
    const empty : PlOp = PlOp { kind: PL_OP_RECT, role: PL_ROLE_SURFACE, x: 0, y: 0, w: 0, h: 0,
                                radius: 0, stroke: 0, alpha: 0, icon: PL_ICON_NONE };
    if (i >= pl_op_count(p)) { return empty; }
    const a : u32 = pl_alpha(p.state);
    if (i == 0) {
        return PlOp { kind: PL_OP_RECT, role: PL_ROLE_SURFACE, x: 0, y: 0, w: sz.w, h: sz.h,
                      radius: PL_RADIUS, stroke: 0, alpha: a, icon: PL_ICON_NONE };
    }
    if (i == 1) {
        return PlOp { kind: PL_OP_RECT, role: PL_ROLE_LINE, x: 0, y: 0, w: sz.w, h: sz.h,
                      radius: PL_RADIUS, stroke: pl_stroke(p.state), alpha: a, icon: PL_ICON_NONE };
    }
    var next : u32 = 2;
    if (p.cfg.variant == PL_VARIANT_RAISED) {
        if (i == next) {
            return PlOp { kind: PL_OP_RECT, role: PL_ROLE_LINE, x: 0, y: @as(i32, sz.h - PL_RAISE_H),
                          w: sz.w, h: PL_RAISE_H, radius: 0, stroke: 0, alpha: PL_A_RULE, icon: PL_ICON_NONE };
        }
        next = next + 1;
    }
    return PlOp { kind: PL_OP_ICON, role: PL_ROLE_INK, x: @as(i32, pl_pad(p.cfg.size)),
                  y: @as(i32, pl_pad(p.cfg.size)), w: PL_ICON_BOX, h: PL_ICON_BOX, radius: 0, stroke: 0,
                  alpha: a, icon: pl_icon(p.state) };
}

// ---- hit test ----

/// hit_test: x, y relative to the plate's own box. A disposed plate is a miss.
pub fn pl_hit(p: Plate, avail_w: u32, x: i32, y: i32) -> bool {
    if (p.alive == false) { return false; }
    if (x < 0 or y < 0) { return false; }
    const sz : PlSize = pl_measure(p.cfg, avail_w);
    return x < @as(i32, sz.w) and y < @as(i32, sz.h);
}

// ---- accessibility ----

/// a11y_name: the region name; never empty (id 0 and unknown ids take the default name).
pub fn pl_a11y_name(p: Plate) -> str {
    if (p.cfg.name_id == 1) { return "Content region"; }
    if (p.cfg.name_id == 2) { return "Settings region"; }
    if (p.cfg.name_id == 3) { return "Status region"; }
    return "Region";
}

// ---- tests ----

test create_applies_config {
    const p : Plate = pl_create(PL_VARIANT_RAISED, PL_SIZE_L, 2);
    assert p.cfg.variant == PL_VARIANT_RAISED;
    assert p.cfg.size == PL_SIZE_L;
    assert p.state == PL_STATE_DEFAULT;
    assert p.alive;
    const q : Plate = pl_create(9, 9, 0);
    assert q.cfg.variant == PL_VARIANT_FLAT;
    assert q.cfg.size == PL_SIZE_M;
}

test measure_uses_token_sizes {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_S, 0);
    const sz : PlSize = pl_measure(p.cfg, 300);
    assert sz.w == 300;
    assert sz.h == PL_MIN_H_S;
    assert pl_measure(p.cfg, 10).w == PL_MIN_W;
    assert pl_measure(pl_create(0, PL_SIZE_L, 0).cfg, 300).h == PL_MIN_H_L;
}

test render_fill_uses_surface_role_and_token_radius {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 1);
    const fill : PlOp = pl_op(p, 200, 0);
    assert fill.role == PL_ROLE_SURFACE;
    assert fill.radius == PL_RADIUS;
    assert fill.x == 0;
    assert fill.y == 0;
    assert fill.w == 200;
    assert fill.h == PL_MIN_H_M;
}

test render_border_uses_line_role_and_token_width {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 1);
    const b : PlOp = pl_op(p, 200, 1);
    assert b.role == PL_ROLE_LINE;
    assert b.stroke == PL_BORDER_W;
    assert b.radius == PL_RADIUS;
}

test render_op_count_is_bounded {
    const flat : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0);
    const raised : Plate = pl_create(PL_VARIANT_RAISED, PL_SIZE_M, 0);
    assert pl_op_count(flat) == 2;
    assert pl_op_count(raised) == 3;
    assert pl_op_count(pl_set_state(raised, PL_STATE_LOADING)) == 4;
    assert pl_op_count(pl_set_state(raised, PL_STATE_LOADING)) <= PL_MAX_OPS;
    assert pl_op(flat, 200, 2).alpha == 0;
}

test render_raised_adds_bottom_rule_inside_the_box {
    const p : Plate = pl_create(PL_VARIANT_RAISED, PL_SIZE_M, 0);
    const r : PlOp = pl_op(p, 200, 2);
    assert r.role == PL_ROLE_LINE;
    assert r.alpha == PL_A_RULE;
    assert r.y == @as(i32, PL_MIN_H_M - PL_RAISE_H);
    assert r.y + @as(i32, r.h) == @as(i32, PL_MIN_H_M);
}

test hit_test_is_relative_to_own_box {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_S, 0);
    assert pl_hit(p, 100, 0, 0);
    assert pl_hit(p, 100, 99, 39);
    assert pl_hit(p, 100, 100, 10) == false;
    assert pl_hit(p, 100, 10, 40) == false;
    assert pl_hit(p, 100, -1, 5) == false;
    assert pl_hit(p, 100, 5, -1) == false;
}

test state_zero_to_five_accepted_and_out_of_range_refused {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0);
    assert pl_set_state(p, PL_STATE_HOVER).state == PL_STATE_HOVER;
    assert pl_set_state(p, PL_STATE_LOADING).state == PL_STATE_LOADING;
    assert pl_set_state(p, 6).state == PL_STATE_DEFAULT;
    assert pl_set_state(pl_set_state(p, PL_STATE_FOCUS), 99).state == PL_STATE_FOCUS;
    assert pl_state_ok(5);
    assert pl_state_ok(6) == false;
}

test state_alphas_come_from_the_state {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0);
    assert pl_op(p, 200, 0).alpha == PL_A_FULL;
    assert pl_op(pl_set_state(p, PL_STATE_PRESSED), 200, 0).alpha == PL_A_PRESSED;
    assert pl_op(pl_set_state(p, PL_STATE_DISABLED), 200, 0).alpha == PL_A_DISABLED;
    assert pl_op(pl_set_state(p, PL_STATE_LOADING), 200, 0).alpha == PL_A_LOADING;
}

test theme_light_is_inverse_of_dark_for_surface_and_ink {
    assert pl_level(PL_THEME_DARK, PL_ROLE_SURFACE) == PL_LEVEL_LOW;
    assert pl_level(PL_THEME_LIGHT, PL_ROLE_SURFACE) == PL_LEVEL_HIGH;
    assert pl_level(PL_THEME_DARK, PL_ROLE_INK) == PL_LEVEL_HIGH;
    assert pl_level(PL_THEME_LIGHT, PL_ROLE_INK) == PL_LEVEL_LOW;
    assert pl_level(PL_THEME_DARK, PL_ROLE_LINE) == pl_level(PL_THEME_LIGHT, PL_ROLE_LINE);
    const p : Plate = pl_set_theme(pl_create(0, 1, 0), PL_THEME_LIGHT);
    assert p.theme == PL_THEME_LIGHT;
    assert pl_set_theme(p, 5).theme == PL_THEME_LIGHT;
}

test a11y_name_is_non_empty_for_every_variant {
    var v : u32 = 0;
    while (v <= PL_VARIANT_RAISED) {
        var n : u32 = 0;
        while (n < 6) {
            assert pl_a11y_name(pl_create(v, PL_SIZE_M, n)).len > 0;
            n = n + 1;
        }
        v = v + 1;
    }
    assert pl_a11y_name(pl_create(0, 1, 1)) != pl_a11y_name(pl_create(0, 1, 2));
}

test every_non_default_state_has_a_non_colour_cue {
    const p : Plate = pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0);
    assert pl_stroke(PL_STATE_HOVER) != pl_stroke(PL_STATE_DEFAULT);
    assert pl_stroke(PL_STATE_PRESSED) != pl_stroke(PL_STATE_DEFAULT);
    assert pl_stroke(PL_STATE_FOCUS) != pl_stroke(PL_STATE_DEFAULT);
    assert pl_stroke(PL_STATE_HOVER) != pl_stroke(PL_STATE_PRESSED);
    assert pl_icon(PL_STATE_DISABLED) == PL_ICON_LOCK;
    assert pl_icon(PL_STATE_LOADING) == PL_ICON_BUSY;
    assert pl_op_count(pl_set_state(p, PL_STATE_DISABLED)) == 3;
    assert pl_op(pl_set_state(p, PL_STATE_DISABLED), 200, 2).kind == PL_OP_ICON;
}

test dispose_makes_hit_test_a_miss {
    const p : Plate = pl_set_state(pl_create(PL_VARIANT_RAISED, PL_SIZE_M, 1), PL_STATE_FOCUS);
    assert pl_hit(p, 100, 5, 5);
    const d : Plate = pl_dispose(p);
    assert d.alive == false;
    assert d.state == PL_STATE_DEFAULT;
    assert pl_hit(d, 100, 5, 5) == false;
    assert pl_op_count(d) == 0;
    assert pl_set_state(d, PL_STATE_HOVER).state == PL_STATE_DEFAULT;
}

invariant ops_stay_inside_the_measured_box {
    const p : Plate = pl_set_state(pl_create(PL_VARIANT_RAISED, PL_SIZE_L, 3), PL_STATE_LOADING);
    const sz : PlSize = pl_measure(p.cfg, 320);
    var i : u32 = 0;
    while (i < pl_op_count(p)) {
        const o : PlOp = pl_op(p, 320, i);
        assert o.x >= 0;
        assert o.y >= 0;
        assert o.x + @as(i32, o.w) <= @as(i32, sz.w);
        assert o.y + @as(i32, o.h) <= @as(i32, sz.h);
        i = i + 1;
    }
}
