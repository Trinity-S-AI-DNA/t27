; specs/uikit/stories_bracket_frame.t27 -- Bracket frame stories for UIKit.
; Every story is built only by calling bf_config / bf_create / bf_set_state / bf_set_theme
; from bracket_frame.t27; no geometry, colour or op layout is copied here.
; Refs #13874, see #13862, see #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stories_bracket_frame;

use uikit::bracket_frame;

pub const STORY_BF_DEFAULT_DARK  : str = "bracket-frame-default-dark";
pub const STORY_BF_DEFAULT_LIGHT : str = "bracket-frame-default-light";
pub const STORY_BF_HOVER         : str = "bracket-frame-hover";
pub const STORY_BF_PRESSED       : str = "bracket-frame-pressed";
pub const STORY_BF_FOCUS         : str = "bracket-frame-focus";
pub const STORY_BF_DISABLED      : str = "bracket-frame-disabled";
pub const STORY_BF_LOADING       : str = "bracket-frame-loading";
pub const STORY_BF_SIZE_SM       : str = "bracket-frame-size-sm";
pub const STORY_BF_SIZE_LG       : str = "bracket-frame-size-lg";

pub const STORY_BF_COMPONENT : str = "bracket-frame";
pub const STORY_BF_SPEC_PATH : str = "specs/uikit/stories_bracket_frame.t27";

/// Fixed box and width the op tests measure at.
pub const STORY_BF_BOX_W   : u32 = 240;
pub const STORY_BF_BOX_H   : u32 = 120;
pub const STORY_BF_AVAIL_W : u32 = 320;
pub const STORY_BF_NAME    : str = "Story region";

fn story_bf_base(size: u8) -> BfObject {
    return bf_create(bf_config(size, STORY_BF_BOX_W, STORY_BF_BOX_H, STORY_BF_NAME));
}

pub fn story_bf_default_dark() -> BfObject {
    return story_bf_base(SIZE_MD);
}

pub fn story_bf_default_light() -> BfObject {
    return bf_set_theme(story_bf_base(SIZE_MD), THEME_LIGHT);
}

pub fn story_bf_hover() -> BfObject {
    return bf_set_state(story_bf_base(SIZE_MD), ST_HOVER);
}

pub fn story_bf_pressed() -> BfObject {
    return bf_set_state(story_bf_base(SIZE_MD), ST_PRESSED);
}

pub fn story_bf_focus() -> BfObject {
    return bf_set_state(story_bf_base(SIZE_MD), ST_FOCUS);
}

pub fn story_bf_disabled() -> BfObject {
    return bf_set_state(story_bf_base(SIZE_MD), ST_DISABLED);
}

pub fn story_bf_loading() -> BfObject {
    return bf_set_state(story_bf_base(SIZE_MD), ST_LOADING);
}

pub fn story_bf_size_sm() -> BfObject {
    return story_bf_base(SIZE_SM);
}

pub fn story_bf_size_lg() -> BfObject {
    return story_bf_base(SIZE_LG);
}

/// True when the id names a story of this spec.
pub fn story_bf_known(id: str) -> bool {
    return id == STORY_BF_DEFAULT_DARK or id == STORY_BF_DEFAULT_LIGHT or id == STORY_BF_HOVER
        or id == STORY_BF_PRESSED or id == STORY_BF_FOCUS or id == STORY_BF_DISABLED
        or id == STORY_BF_LOADING or id == STORY_BF_SIZE_SM or id == STORY_BF_SIZE_LG;
}

/// Op count of the named story; an unknown id is refused with 0.
pub fn story_bf_ops(id: str) -> u32 {
    if (id == STORY_BF_DEFAULT_DARK)  { return bf_render(story_bf_default_dark(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_DEFAULT_LIGHT) { return bf_render(story_bf_default_light(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_HOVER)         { return bf_render(story_bf_hover(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_PRESSED)       { return bf_render(story_bf_pressed(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_FOCUS)         { return bf_render(story_bf_focus(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_DISABLED)      { return bf_render(story_bf_disabled(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_LOADING)       { return bf_render(story_bf_loading(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_SIZE_SM)       { return bf_render(story_bf_size_sm(), STORY_BF_AVAIL_W).count; }
    if (id == STORY_BF_SIZE_LG)       { return bf_render(story_bf_size_lg(), STORY_BF_AVAIL_W).count; }
    return 0;
}

test story_bf_ids_unique {
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_DEFAULT_LIGHT;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_HOVER;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_PRESSED;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_FOCUS;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_DISABLED;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_LOADING;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_SIZE_SM;
    assert STORY_BF_DEFAULT_DARK  != STORY_BF_SIZE_LG;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_HOVER;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_PRESSED;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_FOCUS;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_DISABLED;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_LOADING;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_SIZE_SM;
    assert STORY_BF_DEFAULT_LIGHT != STORY_BF_SIZE_LG;
    assert STORY_BF_HOVER         != STORY_BF_PRESSED;
    assert STORY_BF_HOVER         != STORY_BF_FOCUS;
    assert STORY_BF_HOVER         != STORY_BF_DISABLED;
    assert STORY_BF_HOVER         != STORY_BF_LOADING;
    assert STORY_BF_HOVER         != STORY_BF_SIZE_SM;
    assert STORY_BF_HOVER         != STORY_BF_SIZE_LG;
    assert STORY_BF_PRESSED       != STORY_BF_FOCUS;
    assert STORY_BF_PRESSED       != STORY_BF_DISABLED;
    assert STORY_BF_PRESSED       != STORY_BF_LOADING;
    assert STORY_BF_PRESSED       != STORY_BF_SIZE_SM;
    assert STORY_BF_PRESSED       != STORY_BF_SIZE_LG;
    assert STORY_BF_FOCUS         != STORY_BF_DISABLED;
    assert STORY_BF_FOCUS         != STORY_BF_LOADING;
    assert STORY_BF_FOCUS         != STORY_BF_SIZE_SM;
    assert STORY_BF_FOCUS         != STORY_BF_SIZE_LG;
    assert STORY_BF_DISABLED      != STORY_BF_LOADING;
    assert STORY_BF_DISABLED      != STORY_BF_SIZE_SM;
    assert STORY_BF_DISABLED      != STORY_BF_SIZE_LG;
    assert STORY_BF_LOADING       != STORY_BF_SIZE_SM;
    assert STORY_BF_LOADING       != STORY_BF_SIZE_LG;
    assert STORY_BF_SIZE_SM       != STORY_BF_SIZE_LG;
}

test story_bf_op_count_matches_frame {
    const base : BfObject = bf_create(bf_config(SIZE_MD, STORY_BF_BOX_W, STORY_BF_BOX_H, STORY_BF_NAME));
    assert story_bf_ops(STORY_BF_DEFAULT_DARK) == bf_render(base, STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_DEFAULT_LIGHT) == bf_render(bf_set_theme(base, THEME_LIGHT), STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_HOVER) == bf_render(bf_set_state(base, ST_HOVER), STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_PRESSED) == bf_render(bf_set_state(base, ST_PRESSED), STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_FOCUS) == bf_render(bf_set_state(base, ST_FOCUS), STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_DISABLED) == bf_render(bf_set_state(base, ST_DISABLED), STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_LOADING) == bf_render(bf_set_state(base, ST_LOADING), STORY_BF_AVAIL_W).count;
    const sm : BfObject = bf_create(bf_config(SIZE_SM, STORY_BF_BOX_W, STORY_BF_BOX_H, STORY_BF_NAME));
    const lg : BfObject = bf_create(bf_config(SIZE_LG, STORY_BF_BOX_W, STORY_BF_BOX_H, STORY_BF_NAME));
    assert story_bf_ops(STORY_BF_SIZE_SM) == bf_render(sm, STORY_BF_AVAIL_W).count;
    assert story_bf_ops(STORY_BF_SIZE_LG) == bf_render(lg, STORY_BF_AVAIL_W).count;
}

test story_bf_theme_switch_keeps_state {
    const p : BfObject = story_bf_disabled();
    const l : BfObject = bf_set_theme(p, THEME_LIGHT);
    assert l.state == p.state;
    assert l.theme == THEME_LIGHT;
    assert l.size == p.size;
}

test story_bf_unknown_id_refused {
    assert story_bf_known("bracket-frame-nope") == false;
    assert story_bf_ops("bracket-frame-nope") == 0;
    assert story_bf_known(STORY_BF_HOVER) == true;
}

invariant story_bf_light_story_is_light_default_state {
    const p : BfObject = story_bf_default_light();
    assert p.theme == THEME_LIGHT;
    assert p.state == ST_DEFAULT;
}

invariant story_bf_spec_path_matches_file {
    assert STORY_BF_SPEC_PATH == "specs/uikit/stories_bracket_frame.t27";
    assert STORY_BF_COMPONENT == "bracket-frame";
}
