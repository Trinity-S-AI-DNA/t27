// SPDX-License-Identifier: Apache-2.0
; specs/uikit/badge.t27 -- Badge: the UI Kit badge object (epic #13426, milestone M0).
; A badge is a small pill with a short label (a count or a status word). Height and radius come from
; native_tokens (BADGE_HEIGHT, BADGE_RADIUS). Draw ops carry ROLE names and alphas, never a colour literal, and
; are relative to the badge's own 0,0. The label is the accessible name; the tone (neutral, accent, danger,
; success) is never carried by colour alone: danger and success add a glyph.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_badge;

use uikit::native_tokens::BADGE_HEIGHT;
use uikit::native_tokens::BADGE_RADIUS;

; PROPOSED TOKEN: sizes without a token yet (not in design_tokens / native_tokens).
pub const BDG_PAD_X : f64 = 10.0;
pub const BDG_LABEL_SIZE : f64 = 11.0;
pub const BDG_CHAR_ADV : f64 = 0.6;
pub const BDG_GLYPH : f64 = 10.0;
pub const BDG_GLYPH_GAP : f64 = 4.0;
pub const BDG_RING_GAP : f64 = 2.0;
pub const BDG_RING_LINE : f64 = 1.5;
pub const BDG_UNDERLINE : f64 = 1.0;
pub const BDG_EDGE : f64 = 1.0;

pub const BR_SURFACE : u32 = 0;
pub const BR_INK : u32 = 1;
pub const BR_ACCENT : u32 = 2;
pub const BR_DANGER : u32 = 3;
pub const BR_SUCCESS : u32 = 4;
pub const BR_LINE : u32 = 5;
pub const BR_COUNT : u32 = 6;

pub const BT_NEUTRAL : u32 = 0;
pub const BT_ACCENT : u32 = 1;
pub const BT_DANGER : u32 = 2;
pub const BT_SUCCESS : u32 = 3;
pub const BT_COUNT : u32 = 4;

pub const BS_DEFAULT : u32 = 0;
pub const BS_HOVER : u32 = 1;
pub const BS_FOCUS : u32 = 2;
pub const BS_ACTIVE : u32 = 3;
pub const BS_DISABLED : u32 = 4;
pub const BS_MUTED : u32 = 5;
pub const BS_COUNT : u32 = 6;

pub const BTHEME_DARK : u32 = 0;
pub const BTHEME_LIGHT : u32 = 1;

pub const BOP_NONE : u32 = 0;
pub const BOP_RECT : u32 = 1;
pub const BOP_TEXT : u32 = 2;
pub const BOP_ICON : u32 = 3;
pub const BDG_MAX_OPS : u32 = 6;

pub const BG_NONE : u32 = 0;
pub const BG_BANG : u32 = 1;
pub const BG_CHECK : u32 = 2;
pub const BG_BLOCK : u32 = 3;
pub const BG_DOT : u32 = 4;

; Per tone: the role of the pill and its label. Neutral uses the line role for the edge only.
pub const TONE_ROLE : [4]u32 = [1, 2, 3, 4];
; Per tone: the glyph that repeats the tone without colour (neutral and accent need none).
pub const TONE_GLYPH : [4]u32 = [0, 0, 1, 2];
; Per state: fill alpha of the pill and label alpha.
pub const BS_FILL_A : [6]f64 = [0.14, 0.22, 0.14, 0.30, 0.06, 0.06];
pub const BS_INK_A : [6]f64 = [1.0, 1.0, 1.0, 1.0, 0.4, 0.55];
; Swap table for the Light theme: surface and ink trade places, the other roles stay.
pub const BDG_LIGHT_SWAP : [6]u32 = [1, 0, 2, 3, 4, 5];

pub struct BadgeCfg {
    tone: u32,
    label_id: u32,
    label_len: u32,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct BadgeOp {
    kind: u32,
    role: u32,
    alpha: f64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    radius: f64,
    line: f64,
    glyph: u32,
}

pub fn badge_state_ok(s: u32) -> bool { return s <= BS_MUTED; }

; ── create / configure ───────────────────────────────────────────────────────
; A label is required (it is the accessible name); a bad tone or theme gives an inert badge.
pub fn badge_create(tone: u32, label_id: u32, label_len: u32, theme: u32) -> BadgeCfg {
    if (label_len == 0 or tone >= BT_COUNT or theme > BTHEME_LIGHT) {
        return BadgeCfg{.tone = 0, .label_id = 0, .label_len = 0, .state = BS_DEFAULT, .theme = BTHEME_DARK, .alive = false};
    }
    return BadgeCfg{.tone = tone, .label_id = label_id, .label_len = label_len, .state = BS_DEFAULT, .theme = theme, .alive = true};
}
; A state outside 0..5 is refused: the badge comes back unchanged.
pub fn badge_set_state(b: BadgeCfg, s: u32) -> BadgeCfg {
    if (badge_state_ok(s) == false) { return b; }
    return BadgeCfg{.tone = b.tone, .label_id = b.label_id, .label_len = b.label_len, .state = s, .theme = b.theme, .alive = b.alive};
}
; theme_bind: rebind to Dark or Light; an unknown theme is refused (unchanged).
pub fn badge_theme_bind(b: BadgeCfg, theme: u32) -> BadgeCfg {
    if (theme > BTHEME_LIGHT) { return b; }
    return BadgeCfg{.tone = b.tone, .label_id = b.label_id, .label_len = b.label_len, .state = b.state, .theme = theme, .alive = b.alive};
}
pub fn badge_dispose(b: BadgeCfg) -> BadgeCfg {
    return BadgeCfg{.tone = 0, .label_id = 0, .label_len = 0, .state = BS_DEFAULT, .theme = BTHEME_DARK, .alive = false};
}

; ── roles ────────────────────────────────────────────────────────────────────
pub fn badge_role(theme: u32, role: u32) -> u32 {
    if (role >= BR_COUNT) { return role; }
    if (theme == BTHEME_LIGHT) { return BDG_LIGHT_SWAP[role]; }
    return role;
}
pub fn badge_tone_role(b: BadgeCfg) -> u32 { return badge_role(b.theme, TONE_ROLE[b.tone]); }

; ── measure ──────────────────────────────────────────────────────────────────
pub fn badge_glyph_of(b: BadgeCfg) -> u32 { return TONE_GLYPH[b.tone]; }
pub fn badge_state_glyph(s: u32) -> u32 {
    if (s == BS_ACTIVE) { return BG_CHECK; }
    if (s == BS_DISABLED) { return BG_BLOCK; }
    if (s == BS_MUTED) { return BG_DOT; }
    return BG_NONE;
}
pub fn badge_lead_w(b: BadgeCfg) -> f64 {
    if (badge_glyph_of(b) == BG_NONE) { return 0.0; }
    return BDG_GLYPH + BDG_GLYPH_GAP;
}
pub fn badge_tail_w(b: BadgeCfg) -> f64 {
    if (badge_state_glyph(b.state) == BG_NONE) { return 0.0; }
    return BDG_GLYPH + BDG_GLYPH_GAP;
}
pub fn badge_measure_h(b: BadgeCfg) -> f64 { return BADGE_HEIGHT; }
; Width from the label, the glyphs and padding; never narrower than the height, never wider than avail_w.
pub fn badge_measure_w(b: BadgeCfg, avail_w: f64) -> f64 {
    var w : f64 = b.label_len as f64 * BDG_LABEL_SIZE * BDG_CHAR_ADV + 2.0 * BDG_PAD_X + badge_lead_w(b) + badge_tail_w(b);
    if (w < BADGE_HEIGHT) { w = BADGE_HEIGHT; }
    if (w > avail_w) { w = avail_w; }
    return w;
}

; ── state cues (non-colour) ──────────────────────────────────────────────────
; hover underlines the label, focus draws a ring, active a check glyph, disabled a block glyph, muted a dot.
pub fn badge_underline(s: u32) -> f64 {
    if (s == BS_HOVER) { return BDG_UNDERLINE; }
    return 0.0;
}
pub fn badge_ring_on(s: u32) -> bool { return s == BS_FOCUS; }

; ── render ───────────────────────────────────────────────────────────────────
pub fn badge_op_none() -> BadgeOp {
    return BadgeOp{.kind = BOP_NONE, .role = BR_SURFACE, .alpha = 0.0, .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0, .radius = 0.0, .line = 0.0, .glyph = BG_NONE};
}
; Ops in order: pill, tone glyph, label, underline, ring, state glyph (those the state and tone draw).
pub fn badge_render_count(b: BadgeCfg) -> u32 {
    if (b.alive == false) { return 0; }
    var n : u32 = 2;
    if (badge_glyph_of(b) != BG_NONE) { n = n + 1; }
    if (badge_underline(b.state) > 0.0) { n = n + 1; }
    if (badge_ring_on(b.state)) { n = n + 1; }
    if (badge_state_glyph(b.state) != BG_NONE) { n = n + 1; }
    return n;
}
pub fn badge_render_op(b: BadgeCfg, avail_w: f64, i: u32) -> BadgeOp {
    if (b.alive == false or i >= badge_render_count(b)) { return badge_op_none(); }
    const w : f64 = badge_measure_w(b, avail_w);
    const h : f64 = badge_measure_h(b);
    const tone : u32 = badge_tone_role(b);
    const gy : f64 = 0.5 * (h - BDG_GLYPH);
    var k : u32 = i;
    if (k == 0) {
        return BadgeOp{.kind = BOP_RECT, .role = tone, .alpha = BS_FILL_A[b.state], .x = 0.0, .y = 0.0, .w = w, .h = h, .radius = BADGE_RADIUS, .line = 0.0, .glyph = BG_NONE};
    }
    k = k - 1;
    if (badge_glyph_of(b) != BG_NONE) {
        if (k == 0) {
            return BadgeOp{.kind = BOP_ICON, .role = tone, .alpha = BS_INK_A[b.state], .x = BDG_PAD_X, .y = gy, .w = BDG_GLYPH, .h = BDG_GLYPH, .radius = 0.0, .line = 0.0, .glyph = badge_glyph_of(b)};
        }
        k = k - 1;
    }
    if (k == 0) {
        return BadgeOp{.kind = BOP_TEXT, .role = tone, .alpha = BS_INK_A[b.state], .x = BDG_PAD_X + badge_lead_w(b), .y = 0.0, .w = w - 2.0 * BDG_PAD_X - badge_lead_w(b) - badge_tail_w(b), .h = h, .radius = 0.0, .line = 0.0, .glyph = BG_NONE};
    }
    k = k - 1;
    if (badge_underline(b.state) > 0.0) {
        if (k == 0) {
            return BadgeOp{.kind = BOP_RECT, .role = tone, .alpha = BS_INK_A[b.state], .x = BDG_PAD_X + badge_lead_w(b), .y = h - 0.25 * h, .w = w - 2.0 * BDG_PAD_X - badge_lead_w(b) - badge_tail_w(b), .h = badge_underline(b.state), .radius = 0.0, .line = 0.0, .glyph = BG_NONE};
        }
        k = k - 1;
    }
    if (badge_ring_on(b.state)) {
        if (k == 0) {
            return BadgeOp{.kind = BOP_RECT, .role = BR_ACCENT, .alpha = 1.0, .x = 0.0 - BDG_RING_GAP, .y = 0.0 - BDG_RING_GAP, .w = w + 2.0 * BDG_RING_GAP, .h = h + 2.0 * BDG_RING_GAP, .radius = BADGE_RADIUS + BDG_RING_GAP, .line = BDG_RING_LINE, .glyph = BG_NONE};
        }
        k = k - 1;
    }
    return BadgeOp{.kind = BOP_ICON, .role = tone, .alpha = BS_INK_A[b.state], .x = w - BDG_PAD_X - BDG_GLYPH, .y = gy, .w = BDG_GLYPH, .h = BDG_GLYPH, .radius = 0.0, .line = 0.0, .glyph = badge_state_glyph(b.state)};
}

; ── hit_test ─────────────────────────────────────────────────────────────────
; Relative to the badge's own box (the bounding box of the pill); a disposed badge is a miss.
pub fn badge_hit_test(b: BadgeCfg, avail_w: f64, x: f64, y: f64) -> bool {
    if (b.alive == false) { return false; }
    const w : f64 = badge_measure_w(b, avail_w);
    if (x < 0.0 or x >= w or y < 0.0 or y >= BADGE_HEIGHT) { return false; }
    return true;
}
pub fn badge_takes_press(s: u32) -> bool { return s != BS_DISABLED and s != BS_MUTED; }

; ── a11y ─────────────────────────────────────────────────────────────────────
pub fn badge_a11y_name_len(b: BadgeCfg) -> u32 {
    if (b.alive == false) { return 0; }
    return b.label_len;
}
; Each non-default state has a distinct non-colour property code.
pub fn badge_cue_code(s: u32) -> u32 {
    if (s == BS_HOVER) { return 1; }
    if (s == BS_FOCUS) { return 2; }
    if (s == BS_ACTIVE) { return 3; }
    if (s == BS_DISABLED) { return 4; }
    if (s == BS_MUTED) { return 5; }
    return 0;
}
pub fn badge_state_has_cue(s: u32) -> bool {
    return badge_underline(s) > 0.0 or badge_ring_on(s) or badge_state_glyph(s) != BG_NONE;
}
; The tone is carried by a glyph as well as a role for danger and success.
pub fn badge_tone_has_cue(tone: u32) -> bool { return TONE_GLYPH[tone] != BG_NONE; }

; ── Tests ────────────────────────────────────────────────────────────────────
test badge_create_requires_a_label_and_valid_config {
    const b : BadgeCfg = badge_create(BT_ACCENT, 3, 4, BTHEME_DARK);
    assert b.alive and b.state == BS_DEFAULT and b.label_len == 4;
    assert badge_create(BT_ACCENT, 3, 0, BTHEME_DARK).alive == false;
    assert badge_create(BT_COUNT, 3, 4, BTHEME_DARK).alive == false;
    assert badge_create(BT_NEUTRAL, 3, 4, 2).alive == false;
}

test badge_measure_uses_token_sizes {
    const b : BadgeCfg = badge_create(BT_NEUTRAL, 1, 5, BTHEME_DARK);
    assert badge_measure_h(b) == BADGE_HEIGHT and BADGE_HEIGHT == 26.0;
    assert badge_measure_w(b, 500.0) > 52.99 and badge_measure_w(b, 500.0) < 53.01;
    assert badge_measure_w(b, 30.0) == 30.0;
    const one : BadgeCfg = badge_create(BT_NEUTRAL, 1, 1, BTHEME_DARK);
    assert badge_measure_w(one, 500.0) >= BADGE_HEIGHT;
    const d : BadgeCfg = badge_create(BT_DANGER, 1, 5, BTHEME_DARK);
    assert badge_measure_w(d, 500.0) > badge_measure_w(b, 500.0);
    assert BADGE_RADIUS == 13.0;
}

test badge_render_is_bounded_relative_and_role_based {
    var t : u32 = 0;
    while (t < BT_COUNT) {
        var s : u32 = 0;
        while (s < BS_COUNT) {
            const b : BadgeCfg = badge_set_state(badge_create(t, 2, 6, BTHEME_DARK), s);
            assert badge_render_count(b) >= 2 and badge_render_count(b) <= BDG_MAX_OPS;
            var i : u32 = 0;
            while (i < badge_render_count(b)) {
                const op : BadgeOp = badge_render_op(b, 500.0, i);
                assert op.kind != BOP_NONE and op.role < BR_COUNT;
                assert op.alpha > 0.0 and op.alpha <= 1.0;
                i = i + 1;
            }
            assert badge_render_op(b, 500.0, badge_render_count(b)).kind == BOP_NONE;
            s = s + 1;
        }
        t = t + 1;
    }
    const n : BadgeCfg = badge_create(BT_NEUTRAL, 2, 6, BTHEME_DARK);
    assert badge_render_op(n, 500.0, 0).kind == BOP_RECT and badge_render_op(n, 500.0, 0).radius == BADGE_RADIUS;
    assert badge_render_op(n, 500.0, 1).kind == BOP_TEXT and badge_render_op(n, 500.0, 1).x == BDG_PAD_X;
}

test badge_tone_roles_and_glyph_cues {
    assert badge_tone_role(badge_create(BT_DANGER, 1, 3, BTHEME_DARK)) == BR_DANGER;
    assert badge_tone_role(badge_create(BT_SUCCESS, 1, 3, BTHEME_DARK)) == BR_SUCCESS;
    assert badge_tone_role(badge_create(BT_ACCENT, 1, 3, BTHEME_DARK)) == BR_ACCENT;
    assert badge_tone_has_cue(BT_DANGER) and badge_tone_has_cue(BT_SUCCESS);
    assert badge_tone_has_cue(BT_NEUTRAL) == false;
    assert badge_glyph_of(badge_create(BT_DANGER, 1, 3, BTHEME_DARK)) != badge_glyph_of(badge_create(BT_SUCCESS, 1, 3, BTHEME_DARK));
    assert badge_render_op(badge_create(BT_DANGER, 1, 3, BTHEME_DARK), 500.0, 1).kind == BOP_ICON;
}

test badge_hit_test_is_relative_to_own_box {
    const b : BadgeCfg = badge_create(BT_NEUTRAL, 1, 4, BTHEME_DARK);
    const w : f64 = badge_measure_w(b, 500.0);
    assert badge_hit_test(b, 500.0, 0.0, 0.0);
    assert badge_hit_test(b, 500.0, w - 0.5, 25.5);
    assert badge_hit_test(b, 500.0, w, 5.0) == false;
    assert badge_hit_test(b, 500.0, -1.0, 5.0) == false;
    assert badge_hit_test(b, 500.0, 5.0, 26.0) == false;
}

test badge_six_states_and_out_of_range_is_refused {
    var s : u32 = 0;
    while (s < BS_COUNT) {
        assert badge_state_ok(s);
        assert badge_set_state(badge_create(BT_NEUTRAL, 1, 3, BTHEME_DARK), s).state == s;
        s = s + 1;
    }
    const b : BadgeCfg = badge_set_state(badge_create(BT_NEUTRAL, 1, 3, BTHEME_DARK), BS_HOVER);
    assert badge_set_state(b, BS_COUNT).state == BS_HOVER;
    assert badge_set_state(b, 99).state == BS_HOVER;
    assert badge_takes_press(BS_DISABLED) == false and badge_takes_press(BS_MUTED) == false and badge_takes_press(BS_ACTIVE);
}

test badge_theme_bind_dark_and_light {
    assert badge_role(BTHEME_DARK, BR_SURFACE) == BR_SURFACE;
    assert badge_role(BTHEME_LIGHT, BR_SURFACE) == BR_INK;
    assert badge_role(BTHEME_LIGHT, BR_INK) == BR_SURFACE;
    assert badge_role(BTHEME_LIGHT, BR_DANGER) == BR_DANGER;
    const dk : BadgeCfg = badge_create(BT_NEUTRAL, 1, 3, BTHEME_DARK);
    const lt : BadgeCfg = badge_theme_bind(dk, BTHEME_LIGHT);
    assert lt.theme == BTHEME_LIGHT and lt.label_len == 3;
    assert badge_tone_role(dk) == BR_INK;
    assert badge_tone_role(lt) == BR_SURFACE;
    assert badge_theme_bind(lt, 5).theme == BTHEME_LIGHT;
}

test badge_a11y_name_is_the_label_and_state_is_not_colour_alone {
    assert badge_a11y_name_len(badge_create(BT_ACCENT, 1, 4, BTHEME_DARK)) == 4;
    assert badge_a11y_name_len(badge_create(BT_ACCENT, 1, 0, BTHEME_DARK)) == 0;
    var s : u32 = 1;
    while (s < BS_COUNT) {
        assert badge_state_has_cue(s);
        assert badge_cue_code(s) != badge_cue_code(s - 1);
        s = s + 1;
    }
    assert badge_state_has_cue(BS_DEFAULT) == false and badge_cue_code(BS_DEFAULT) == 0;
}

test badge_dispose_is_inert {
    const b : BadgeCfg = badge_set_state(badge_create(BT_DANGER, 1, 4, BTHEME_LIGHT), BS_ACTIVE);
    const d : BadgeCfg = badge_dispose(b);
    assert d.alive == false and d.state == BS_DEFAULT;
    assert badge_hit_test(d, 500.0, 1.0, 1.0) == false;
    assert badge_render_count(d) == 0 and badge_a11y_name_len(d) == 0;
}

invariant badge_ops_never_exceed_the_bound {
    assert BDG_MAX_OPS >= 6;
    assert BR_COUNT == 6 and BS_COUNT == 6;
}
