; specs/uikit/theme_pill.t27 -- ThemePill: the one-icon theme button (UI Kit object, M2).
; Issue #13751, epic #13426. Values: dark 0, light 1, system 2.
; A click cycles dark -> light -> dark; a system value becomes the resolved value on click.
; The icon differs per value (moon / sun / auto), so state is never colour only.
; Persisting the choice is a returned value (next_pref), never I/O.
; Draw ops carry ROLE names and alphas, relative to the object's own 0,0. No colour literals.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_theme_pill;

use uikit_native_tokens::{BTN_HEIGHT, BTN_ALPHA_DEFAULT, BTN_ALPHA_HOVER, BTN_ALPHA_ACTIVE, BTN_ALPHA_DISABLED};

; Preference values.
pub const PREF_DARK   : u8 = 0;
pub const PREF_LIGHT  : u8 = 1;
pub const PREF_SYSTEM : u8 = 2;
pub const PREF_COUNT  : u8 = 3;

; Themes (theme_bind input).
pub const THEME_DARK  : u8 = 0;
pub const THEME_LIGHT : u8 = 1;

; States.
pub const ST_DEFAULT  : u8 = 0;
pub const ST_HOVER    : u8 = 1;
pub const ST_PRESSED  : u8 = 2;
pub const ST_FOCUS    : u8 = 3;
pub const ST_DISABLED : u8 = 4;
pub const ST_LOADING  : u8 = 5;
pub const ST_COUNT    : u8 = 6;

; Roles.
pub const ROLE_SURFACE : u8 = 0;
pub const ROLE_INK     : u8 = 1;
pub const ROLE_ACCENT  : u8 = 2;
pub const ROLE_DANGER  : u8 = 3;
pub const ROLE_SUCCESS : u8 = 4;
pub const ROLE_LINE    : u8 = 5;

; Role token ids (Dark: surface black, ink white; Light is the inverse).
pub const TOK_BLACK : u8 = 0;
pub const TOK_WHITE : u8 = 1;

; Icons.
pub const ICON_MOON    : u8 = 0;
pub const ICON_SUN     : u8 = 1;
pub const ICON_AUTO    : u8 = 2;
pub const ICON_SPINNER : u8 = 3;

; Op kinds.
pub const OP_RECT : u8 = 0;
pub const OP_TEXT : u8 = 1;
pub const OP_ICON : u8 = 2;

; Sizes: square touch target from the button height token.
pub const PILL_SIZE : f64 = BTN_HEIGHT;
; PROPOSED TOKEN: icon glyph box inside the pill.
pub const PILL_ICON : f64 = 20.0;
; PROPOSED TOKEN: outline stroke widths per state mark.
pub const PILL_OUTLINE_HOVER   : f64 = 1.0;
pub const PILL_OUTLINE_PRESSED : f64 = 2.0;
pub const PILL_OUTLINE_FOCUS   : f64 = 3.0;
; PROPOSED TOKEN: strike line thickness for the disabled mark.
pub const PILL_STRIKE : f64 = 2.0;

pub struct ThemePill {
    pref     : u8,
    state    : u8,
    disposed : bool,
    ok       : bool,
}

pub struct PillSize {
    w : f64,
    h : f64,
}

pub struct PillOp {
    kind  : u8,
    role  : u8,
    icon  : u8,
    alpha : f64,
    x     : f64,
    y     : f64,
    w     : f64,
    h     : f64,
}

; create/configure: out-of-range pref or state is refused (ok = false, inert).
pub fn pill_create(pref: u8, state: u8) -> ThemePill {
    var p : ThemePill;
    p.pref = PREF_DARK;
    p.state = ST_DEFAULT;
    p.disposed = true;
    p.ok = false;
    if (pref >= PREF_COUNT) { return p; }
    if (state >= ST_COUNT) { return p; }
    p.pref = pref;
    p.state = state;
    p.disposed = false;
    p.ok = true;
    return p;
}

; layout/measure: token sizes only, independent of avail_w (fixed square).
pub fn pill_measure(avail_w: f64) -> PillSize {
    var s : PillSize;
    s.w = PILL_SIZE;
    s.h = PILL_SIZE;
    return s;
}

; click: dark -> light -> dark; system becomes the resolved value (resolved_theme 0 or 1).
; Returns the next pref to persist; persisting is the host's job.
pub fn pill_next_pref(pref: u8, resolved_theme: u8) -> u8 {
    if (pref == PREF_DARK) { return PREF_LIGHT; }
    if (pref == PREF_LIGHT) { return PREF_DARK; }
    if (resolved_theme == THEME_LIGHT) { return PREF_LIGHT; }
    return PREF_DARK;
}

; The icon differs per value; loading shows the spinner.
pub fn pill_icon(pref: u8, state: u8) -> u8 {
    if (state == ST_LOADING) { return ICON_SPINNER; }
    if (pref == PREF_LIGHT) { return ICON_SUN; }
    if (pref == PREF_SYSTEM) { return ICON_AUTO; }
    return ICON_MOON;
}

; Non-colour outline width per state (0 = none).
pub fn pill_outline(state: u8) -> f64 {
    if (state == ST_HOVER) { return PILL_OUTLINE_HOVER; }
    if (state == ST_PRESSED) { return PILL_OUTLINE_PRESSED; }
    if (state == ST_FOCUS) { return PILL_OUTLINE_FOCUS; }
    return 0.0;
}

pub fn pill_alpha(state: u8) -> f64 {
    if (state == ST_HOVER) { return BTN_ALPHA_HOVER; }
    if (state == ST_PRESSED) { return BTN_ALPHA_ACTIVE; }
    if (state == ST_DISABLED) { return BTN_ALPHA_DISABLED; }
    return BTN_ALPHA_DEFAULT;
}

; Number of draw ops: surface, icon, plus an outline (hover/pressed/focus) or a strike (disabled).
pub fn pill_op_count(p: ThemePill) -> u32 {
    if (p.disposed) { return 0; }
    if (pill_outline(p.state) > 0.0) { return 3; }
    if (p.state == ST_DISABLED) { return 3; }
    return 2;
}

; render: op i, relative to the object's own 0,0. Roles only.
pub fn pill_op(p: ThemePill, i: u32) -> PillOp {
    var o : PillOp;
    o.kind = OP_RECT;
    o.role = ROLE_SURFACE;
    o.icon = ICON_MOON;
    o.alpha = pill_alpha(p.state);
    o.x = 0.0;
    o.y = 0.0;
    o.w = PILL_SIZE;
    o.h = PILL_SIZE;
    if (i == 1) {
        o.kind = OP_ICON;
        o.role = ROLE_INK;
        o.icon = pill_icon(p.pref, p.state);
        o.x = (PILL_SIZE - PILL_ICON) / 2.0;
        o.y = (PILL_SIZE - PILL_ICON) / 2.0;
        o.w = PILL_ICON;
        o.h = PILL_ICON;
    }
    if (i == 2) {
        o.role = ROLE_LINE;
        if (p.state == ST_DISABLED) {
            o.role = ROLE_INK;
            o.y = (PILL_SIZE - PILL_STRIKE) / 2.0;
            o.h = PILL_STRIKE;
        } else {
            o.h = pill_outline(p.state);
        }
    }
    return o;
}

; hit_test relative to the object's own box; a disposed or disabled pill is a miss.
pub fn pill_hit_test(p: ThemePill, x: f64, y: f64) -> bool {
    if (p.disposed) { return false; }
    if (p.state == ST_DISABLED) { return false; }
    if (x < 0.0) { return false; }
    if (y < 0.0) { return false; }
    if (x >= PILL_SIZE) { return false; }
    if (y >= PILL_SIZE) { return false; }
    return true;
}

; State change: out-of-range state is refused (pill returned unchanged, ok false).
pub fn pill_set_state(p: ThemePill, state: u8) -> ThemePill {
    var q : ThemePill = p;
    if (state >= ST_COUNT) { q.ok = false; return q; }
    q.state = state;
    q.ok = true;
    return q;
}

; theme_bind: token id for a role under a theme. Light is the inverse of Dark.
pub fn pill_theme_token(theme: u8, role: u8) -> u8 {
    if (role == ROLE_SURFACE) {
        if (theme == THEME_LIGHT) { return TOK_WHITE; }
        return TOK_BLACK;
    }
    if (theme == THEME_LIGHT) { return TOK_BLACK; }
    return TOK_WHITE;
}

; a11y: accessible name per preference value.
pub fn pill_a11y_name(pref: u8) -> str {
    if (pref == PREF_LIGHT) { return "Theme: Light"; }
    if (pref == PREF_SYSTEM) { return "Theme: System"; }
    return "Theme: Dark";
}

; dispose: inert pill; hit_test misses, no ops.
pub fn pill_dispose(p: ThemePill) -> ThemePill {
    var q : ThemePill = p;
    q.disposed = true;
    q.state = ST_DISABLED;
    return q;
}

test create_valid_and_refused {
    assert pill_create(PREF_SYSTEM, ST_LOADING).ok;
    assert !pill_create(3, ST_DEFAULT).ok;
    assert !pill_create(PREF_DARK, 6).ok;
}

test measure_from_tokens {
    let s : PillSize = pill_measure(10.0);
    assert s.w == BTN_HEIGHT;
    assert s.h == BTN_HEIGHT;
    assert pill_measure(500.0).w == s.w;
}

test click_cycles_dark_light_dark {
    assert pill_next_pref(PREF_DARK, THEME_DARK) == PREF_LIGHT;
    assert pill_next_pref(PREF_LIGHT, THEME_LIGHT) == PREF_DARK;
    assert pill_next_pref(pill_next_pref(PREF_DARK, THEME_DARK), THEME_LIGHT) == PREF_DARK;
}

test system_becomes_resolved_value {
    assert pill_next_pref(PREF_SYSTEM, THEME_DARK) == PREF_DARK;
    assert pill_next_pref(PREF_SYSTEM, THEME_LIGHT) == PREF_LIGHT;
}

test render_ops_use_roles_in_own_box {
    let p : ThemePill = pill_create(PREF_DARK, ST_DEFAULT);
    assert pill_op_count(p) == 2;
    let bg : PillOp = pill_op(p, 0);
    assert bg.role == ROLE_SURFACE;
    assert bg.x == 0.0;
    assert bg.y == 0.0;
    assert bg.w == PILL_SIZE;
    let ic : PillOp = pill_op(p, 1);
    assert ic.kind == OP_ICON;
    assert ic.role == ROLE_INK;
    assert ic.x + ic.w <= PILL_SIZE;
}

test hit_test_in_and_out {
    let p : ThemePill = pill_create(PREF_LIGHT, ST_DEFAULT);
    assert pill_hit_test(p, 0.0, 0.0);
    assert pill_hit_test(p, 43.0, 43.0);
    assert !pill_hit_test(p, 44.0, 10.0);
    assert !pill_hit_test(p, -1.0, 10.0);
    assert !pill_hit_test(pill_create(PREF_LIGHT, ST_DISABLED), 10.0, 10.0);
}

test state_range_refused {
    let p : ThemePill = pill_create(PREF_DARK, ST_DEFAULT);
    assert pill_set_state(p, ST_FOCUS).ok;
    assert pill_set_state(p, ST_FOCUS).state == ST_FOCUS;
    assert !pill_set_state(p, ST_COUNT).ok;
    assert pill_set_state(p, ST_COUNT).state == ST_DEFAULT;
}

test theme_bind_light_inverts_dark {
    assert pill_theme_token(THEME_DARK, ROLE_SURFACE) == TOK_BLACK;
    assert pill_theme_token(THEME_DARK, ROLE_INK) == TOK_WHITE;
    assert pill_theme_token(THEME_LIGHT, ROLE_SURFACE) == TOK_WHITE;
    assert pill_theme_token(THEME_LIGHT, ROLE_INK) == TOK_BLACK;
}

test a11y_names_and_icons_differ {
    assert pill_a11y_name(PREF_DARK) == "Theme: Dark";
    assert pill_a11y_name(PREF_LIGHT) == "Theme: Light";
    assert pill_a11y_name(PREF_SYSTEM) == "Theme: System";
    assert pill_icon(PREF_DARK, ST_DEFAULT) != pill_icon(PREF_LIGHT, ST_DEFAULT);
    assert pill_icon(PREF_LIGHT, ST_DEFAULT) != pill_icon(PREF_SYSTEM, ST_DEFAULT);
    assert pill_icon(PREF_DARK, ST_DEFAULT) != pill_icon(PREF_SYSTEM, ST_DEFAULT);
}

test non_colour_state_marks {
    assert pill_outline(ST_DEFAULT) == 0.0;
    assert pill_outline(ST_HOVER) > 0.0;
    assert pill_outline(ST_PRESSED) > pill_outline(ST_HOVER);
    assert pill_outline(ST_FOCUS) > pill_outline(ST_PRESSED);
    assert pill_op_count(pill_create(PREF_DARK, ST_DISABLED)) == 3;
    assert pill_icon(PREF_DARK, ST_LOADING) == ICON_SPINNER;
}

test dispose_is_inert {
    let q : ThemePill = pill_dispose(pill_create(PREF_DARK, ST_DEFAULT));
    assert !pill_hit_test(q, 10.0, 10.0);
    assert pill_op_count(q) == 0;
}

invariant light_is_inverse_of_dark {
    assert pill_theme_token(THEME_DARK, ROLE_SURFACE) != pill_theme_token(THEME_LIGHT, ROLE_SURFACE);
    assert pill_theme_token(THEME_DARK, ROLE_INK) != pill_theme_token(THEME_LIGHT, ROLE_INK);
    assert pill_theme_token(THEME_DARK, ROLE_SURFACE) == pill_theme_token(THEME_LIGHT, ROLE_INK);
}
