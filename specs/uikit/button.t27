; specs/uikit/button.t27 -- Button: the UI Kit button object (epic #13426, issue #13759, milestone M2).
; Reuses the header_button draft (owner session, 69394e0c49): GitHub style, no outline in the default state,
; a fill only on hover / pressed / on, one even gap. Variants: primary, secondary, ghost. A label is required
; and is the accessible name. Draw ops carry ROLE names and alphas, never a colour literal, and are relative
; to the object's own 0,0.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_button;

; ── Sizes (names follow header_button HB_*; PROPOSED TOKEN = not yet in design_tokens / native_tokens) ──
; PROPOSED TOKEN: one set per size class (0 small, 1 medium).
pub const BTN_H : [2]f64 = [22.0, 28.0];
pub const BTN_RADIUS : f64 = 6.0;
pub const BTN_PAD_X : [2]f64 = [9.0, 12.0];
pub const BTN_LABEL_SIZE : [2]f64 = [8.5, 11.0];
; PROPOSED TOKEN: mean glyph advance as a fraction of the label size.
pub const BTN_CHAR_ADV : f64 = 0.6;
pub const BTN_RING_GAP : f64 = 2.0;
pub const BTN_RING_LINE : f64 = 1.5;
pub const BTN_CUE_HOVER : f64 = 1.0;
pub const BTN_CUE_PRESSED : f64 = 2.0;
pub const BTN_ICON : f64 = 12.0;
; PROPOSED TOKEN: the one gap between neighbouring buttons.
pub const BTN_GAP : f64 = 8.0;
pub const BTN_SIZE_COUNT : u32 = 2;

; ── Roles, variants, states, themes, ops ─────────────────────────────────────
pub const ROLE_SURFACE : u32 = 0;
pub const ROLE_INK : u32 = 1;
pub const ROLE_ACCENT : u32 = 2;
pub const ROLE_DANGER : u32 = 3;
pub const ROLE_SUCCESS : u32 = 4;
pub const ROLE_LINE : u32 = 5;
pub const ROLE_COUNT : u32 = 6;

pub const VAR_PRIMARY : u32 = 0;
pub const VAR_SECONDARY : u32 = 1;
pub const VAR_GHOST : u32 = 2;
pub const VAR_COUNT : u32 = 3;

pub const ST_DEFAULT : u32 = 0;
pub const ST_HOVER : u32 = 1;
pub const ST_PRESSED : u32 = 2;
pub const ST_FOCUS : u32 = 3;
pub const ST_DISABLED : u32 = 4;
pub const ST_LOADING : u32 = 5;
pub const ST_COUNT : u32 = 6;

pub const THEME_DARK : u32 = 0;
pub const THEME_LIGHT : u32 = 1;

pub const OP_NONE : u32 = 0;
pub const OP_RECT : u32 = 1;
pub const OP_TEXT : u32 = 2;
pub const OP_ICON : u32 = 3;
pub const BTN_MAX_OPS : u32 = 5;

pub const ICON_NONE : u32 = 0;
pub const ICON_SPINNER : u32 = 1;
pub const ICON_BLOCK : u32 = 2;

; Per state: fill alpha (fill only on hover / pressed), ink alpha.
pub const FILL_A : [6]f64 = [0.0, 0.10, 0.18, 0.0, 0.0, 0.0];
pub const INK_A : [6]f64 = [0.85, 1.0, 1.0, 1.0, 0.4, 0.55];
; PROPOSED TOKEN: ghost ink is this fraction of the variant's ink alpha.
pub const GHOST_INK_K : f64 = 0.75;
; No outline in any state (owner rule); the focus ring is a separate op.
pub const OUTLINE_W : f64 = 0.0;

pub struct ButtonCfg {
    variant: u32,
    size: u32,
    label_id: u32,
    label_len: u32,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct DrawOp {
    kind: u32,
    role: u32,
    alpha: f64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    radius: f64,
    line: f64,
    icon: u32,
}

pub fn state_ok(s: u32) -> bool { return s < ST_COUNT; }
pub fn variant_ok(v: u32) -> bool { return v < VAR_COUNT; }

; ── create / configure ───────────────────────────────────────────────────────
; A label is required: label_len 0, an unknown variant or size class gives an inert (not alive) button.
pub fn button_create(variant: u32, size: u32, label_id: u32, label_len: u32, theme: u32) -> ButtonCfg {
    if (label_len == 0 or variant >= VAR_COUNT or size >= BTN_SIZE_COUNT or theme > THEME_LIGHT) {
        return ButtonCfg{.variant = 0, .size = 0, .label_id = 0, .label_len = 0, .state = ST_DEFAULT, .theme = THEME_DARK, .alive = false};
    }
    return ButtonCfg{.variant = variant, .size = size, .label_id = label_id, .label_len = label_len, .state = ST_DEFAULT, .theme = theme, .alive = true};
}
; A state outside 0..5 is refused: the config comes back unchanged.
pub fn button_set_state(c: ButtonCfg, s: u32) -> ButtonCfg {
    if (state_ok(s) == false) { return c; }
    return ButtonCfg{.variant = c.variant, .size = c.size, .label_id = c.label_id, .label_len = c.label_len, .state = s, .theme = c.theme, .alive = c.alive};
}
pub fn button_dispose(c: ButtonCfg) -> ButtonCfg {
    return ButtonCfg{.variant = 0, .size = 0, .label_id = 0, .label_len = 0, .state = ST_DEFAULT, .theme = THEME_DARK, .alive = false};
}

; ── layout / measure ─────────────────────────────────────────────────────────
pub fn label_w(c: ButtonCfg) -> f64 {
    return c.label_len as f64 * BTN_LABEL_SIZE[c.size] * BTN_CHAR_ADV;
}
pub fn measure_h(c: ButtonCfg) -> f64 { return BTN_H[c.size]; }
; Width from the label and token padding, never narrower than square, never wider than avail_w.
pub fn measure_w(c: ButtonCfg, avail_w: f64) -> f64 {
    var w : f64 = label_w(c) + 2.0 * BTN_PAD_X[c.size];
    if (w < BTN_H[c.size]) { w = BTN_H[c.size]; }
    if (w > avail_w) { w = avail_w; }
    return w;
}

; ── theme_bind ───────────────────────────────────────────────────────────────
; Light is the inverse of Dark for surface and ink; the other roles are the same in both.
pub fn theme_role(theme: u32, role: u32) -> u32 {
    return uikit_swap_role_for_theme(theme, role);
}

; ── variant look ─────────────────────────────────────────────────────────────
; primary = accent ink and fill; secondary = ink; ghost = ink, dimmer.
pub fn ink_role(variant: u32) -> u32 {
    if (variant == VAR_PRIMARY) { return ROLE_ACCENT; }
    return ROLE_INK;
}
pub fn ink_alpha(variant: u32, s: u32) -> f64 {
    if (variant == VAR_GHOST) { return INK_A[s] * GHOST_INK_K; }
    return INK_A[s];
}
; The non-colour cue of each state: hover and pressed underline the label (1 and 2 wide), focus draws a ring,
; loading draws a spinner icon, disabled draws a block icon.
pub fn cue_line(s: u32) -> f64 {
    if (s == ST_HOVER) { return BTN_CUE_HOVER; }
    if (s == ST_PRESSED) { return BTN_CUE_PRESSED; }
    return 0.0;
}
pub fn cue_icon(s: u32) -> u32 {
    if (s == ST_LOADING) { return ICON_SPINNER; }
    if (s == ST_DISABLED) { return ICON_BLOCK; }
    return ICON_NONE;
}
pub fn has_ring(s: u32) -> bool { return s == ST_FOCUS; }

; ── render ───────────────────────────────────────────────────────────────────
pub fn op_none() -> DrawOp {
    return DrawOp{.kind = OP_NONE, .role = ROLE_SURFACE, .alpha = 0.0, .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0, .radius = 0.0, .line = 0.0, .icon = ICON_NONE};
}
; How many ops render emits: fill (only when the state has one), label, then the cue ops. Never above BTN_MAX_OPS.
pub fn render_count(c: ButtonCfg) -> u32 {
    if (c.alive == false) { return 0; }
    var n : u32 = 1;
    if (FILL_A[c.state] > 0.0) { n = n + 1; }
    if (cue_line(c.state) > 0.0) { n = n + 1; }
    if (has_ring(c.state)) { n = n + 1; }
    if (cue_icon(c.state) != ICON_NONE) { n = n + 1; }
    return n;
}
; Op i of the list, in order: fill, label, underline, ring, icon (skipping those the state does not draw).
pub fn render_op(c: ButtonCfg, avail_w: f64, i: u32) -> DrawOp {
    if (c.alive == false or i >= render_count(c)) { return op_none(); }
    const w : f64 = measure_w(c, avail_w);
    const h : f64 = measure_h(c);
    const fa : f64 = FILL_A[c.state];
    var k : u32 = i;
    if (fa > 0.0) {
        if (k == 0) {
            return DrawOp{.kind = OP_RECT, .role = theme_role(c.theme, ink_role(c.variant)), .alpha = fa, .x = 0.0, .y = 0.0, .w = w, .h = h, .radius = BTN_RADIUS, .line = OUTLINE_W, .icon = ICON_NONE};
        }
        k = k - 1;
    }
    if (k == 0) {
        return DrawOp{.kind = OP_TEXT, .role = theme_role(c.theme, ink_role(c.variant)), .alpha = ink_alpha(c.variant, c.state), .x = BTN_PAD_X[c.size], .y = 0.0, .w = w - 2.0 * BTN_PAD_X[c.size], .h = h, .radius = 0.0, .line = 0.0, .icon = ICON_NONE};
    }
    k = k - 1;
    if (cue_line(c.state) > 0.0) {
        if (k == 0) {
            return DrawOp{.kind = OP_RECT, .role = theme_role(c.theme, ink_role(c.variant)), .alpha = ink_alpha(c.variant, c.state), .x = BTN_PAD_X[c.size], .y = h - 0.25 * h, .w = w - 2.0 * BTN_PAD_X[c.size], .h = cue_line(c.state), .radius = 0.0, .line = 0.0, .icon = ICON_NONE};
        }
        k = k - 1;
    }
    if (has_ring(c.state)) {
        if (k == 0) {
            return DrawOp{.kind = OP_RECT, .role = ROLE_ACCENT, .alpha = 1.0, .x = 0.0 - BTN_RING_GAP, .y = 0.0 - BTN_RING_GAP, .w = w + 2.0 * BTN_RING_GAP, .h = h + 2.0 * BTN_RING_GAP, .radius = BTN_RADIUS + BTN_RING_GAP, .line = BTN_RING_LINE, .icon = ICON_NONE};
        }
        k = k - 1;
    }
    return DrawOp{.kind = OP_ICON, .role = theme_role(c.theme, ink_role(c.variant)), .alpha = ink_alpha(c.variant, c.state), .x = w - BTN_PAD_X[c.size] - BTN_ICON, .y = 0.5 * (h - BTN_ICON), .w = BTN_ICON, .h = BTN_ICON, .radius = 0.0, .line = 0.0, .icon = cue_icon(c.state)};
}

; ── hit_test ─────────────────────────────────────────────────────────────────
; Relative to the button's own box; a disposed button is a miss.
pub fn hit_test(c: ButtonCfg, avail_w: f64, x: f64, y: f64) -> bool {
    if (c.alive == false) { return false; }
    return x >= 0.0 and x < measure_w(c, avail_w) and y >= 0.0 and y < measure_h(c);
}
pub fn takes_press(s: u32) -> bool { return s != ST_DISABLED and s != ST_LOADING; }

; ── a11y ─────────────────────────────────────────────────────────────────────
; The accessible name is the label (its id and length); an inert button has none.
pub fn a11y_name_len(c: ButtonCfg) -> u32 {
    if (c.alive == false) { return 0; }
    return c.label_len;
}
; Every non-default state carries a distinct non-colour property: an underline width, a ring, or an icon.
pub fn cue_code(s: u32) -> u32 {
    if (s == ST_HOVER) { return 1; }
    if (s == ST_PRESSED) { return 2; }
    if (s == ST_FOCUS) { return 3; }
    if (s == ST_DISABLED) { return 4; }
    if (s == ST_LOADING) { return 5; }
    return 0;
}
pub fn has_noncolour_cue(s: u32) -> bool {
    return cue_line(s) > 0.0 or has_ring(s) or cue_icon(s) != ICON_NONE;
}

; ── Tests ────────────────────────────────────────────────────────────────────
test create_requires_a_label_and_valid_config {
    const c : ButtonCfg = button_create(VAR_PRIMARY, 0, 7, 5, THEME_DARK);
    assert c.alive and c.state == ST_DEFAULT and c.label_len == 5;
    assert button_create(VAR_PRIMARY, 0, 7, 0, THEME_DARK).alive == false;
    assert button_create(VAR_COUNT, 0, 7, 5, THEME_DARK).alive == false;
    assert button_create(VAR_GHOST, BTN_SIZE_COUNT, 7, 5, THEME_DARK).alive == false;
}

test measure_uses_token_sizes_only {
    const c : ButtonCfg = button_create(VAR_SECONDARY, 0, 1, 8, THEME_DARK);
    assert measure_h(c) == 22.0;
    assert measure_w(c, 500.0) > 58.79 and measure_w(c, 500.0) < 58.81;
    assert measure_w(c, 30.0) == 30.0;
    const one : ButtonCfg = button_create(VAR_SECONDARY, 0, 1, 1, THEME_DARK);
    assert measure_w(one, 500.0) >= measure_h(one);
    assert measure_w(one, 500.0) > 23.09 and measure_w(one, 500.0) < 23.11;
}

test render_is_bounded_relative_and_role_based {
    var s : u32 = 0;
    while (s < ST_COUNT) {
        const c : ButtonCfg = button_set_state(button_create(VAR_PRIMARY, 1, 3, 6, THEME_DARK), s);
        assert render_count(c) >= 1 and render_count(c) <= BTN_MAX_OPS;
        var i : u32 = 0;
        while (i < render_count(c)) {
            const op : DrawOp = render_op(c, 500.0, i);
            assert op.kind != OP_NONE and op.role < ROLE_COUNT;
            assert op.alpha > 0.0 and op.alpha <= 1.0;
            i = i + 1;
        }
        assert render_op(c, 500.0, render_count(c)).kind == OP_NONE;
        s = s + 1;
    }
    const d : ButtonCfg = button_create(VAR_PRIMARY, 1, 3, 6, THEME_DARK);
    assert render_op(d, 500.0, 0).kind == OP_TEXT;
    assert render_op(d, 500.0, 0).x == BTN_PAD_X[1];
}

test no_outline_and_fill_only_on_hover_and_pressed {
    assert OUTLINE_W == 0.0;
    assert FILL_A[ST_DEFAULT] == 0.0 and FILL_A[ST_FOCUS] == 0.0 and FILL_A[ST_DISABLED] == 0.0;
    assert FILL_A[ST_HOVER] > 0.0 and FILL_A[ST_PRESSED] > FILL_A[ST_HOVER];
    const h : ButtonCfg = button_set_state(button_create(VAR_SECONDARY, 0, 1, 4, THEME_DARK), ST_HOVER);
    assert render_op(h, 500.0, 0).kind == OP_RECT and render_op(h, 500.0, 0).line == 0.0;
}

test hit_test_is_relative_to_own_box {
    const c : ButtonCfg = button_create(VAR_SECONDARY, 0, 1, 4, THEME_DARK);
    const w : f64 = measure_w(c, 500.0);
    assert hit_test(c, 500.0, 0.0, 0.0);
    assert hit_test(c, 500.0, w - 0.5, 21.5);
    assert hit_test(c, 500.0, w, 5.0) == false;
    assert hit_test(c, 500.0, -1.0, 5.0) == false;
    assert hit_test(c, 500.0, 5.0, 22.0) == false;
}

test six_states_and_out_of_range_is_refused {
    var s : u32 = 0;
    while (s < ST_COUNT) {
        assert state_ok(s);
        assert button_set_state(button_create(VAR_GHOST, 0, 1, 3, THEME_DARK), s).state == s;
        s = s + 1;
    }
    const c : ButtonCfg = button_set_state(button_create(VAR_GHOST, 0, 1, 3, THEME_DARK), ST_HOVER);
    assert button_set_state(c, ST_COUNT).state == ST_HOVER;
    assert button_set_state(c, 99).state == ST_HOVER;
    assert takes_press(ST_DISABLED) == false and takes_press(ST_LOADING) == false and takes_press(ST_HOVER);
}

test light_is_the_inverse_of_dark_for_surface_and_ink {
    assert theme_role(THEME_DARK, ROLE_SURFACE) == ROLE_SURFACE;
    assert theme_role(THEME_LIGHT, ROLE_SURFACE) == ROLE_INK;
    assert theme_role(THEME_LIGHT, ROLE_INK) == ROLE_SURFACE;
    assert theme_role(THEME_LIGHT, ROLE_ACCENT) == ROLE_ACCENT;
    const dk : ButtonCfg = button_create(VAR_SECONDARY, 0, 1, 3, THEME_DARK);
    const lt : ButtonCfg = button_create(VAR_SECONDARY, 0, 1, 3, THEME_LIGHT);
    assert render_op(dk, 500.0, 0).role == ROLE_INK;
    assert render_op(lt, 500.0, 0).role == ROLE_SURFACE;
}

test variants_differ_and_primary_uses_accent {
    assert ink_role(VAR_PRIMARY) == ROLE_ACCENT;
    assert ink_role(VAR_SECONDARY) == ROLE_INK and ink_role(VAR_GHOST) == ROLE_INK;
    assert ink_alpha(VAR_GHOST, ST_DEFAULT) < ink_alpha(VAR_SECONDARY, ST_DEFAULT);
    assert variant_ok(VAR_GHOST) and variant_ok(VAR_COUNT) == false;
}

test a11y_name_is_the_label_and_state_is_not_colour_alone {
    var v : u32 = 0;
    while (v < VAR_COUNT) {
        assert a11y_name_len(button_create(v, 0, 1, 4, THEME_DARK)) == 4;
        v = v + 1;
    }
    assert a11y_name_len(button_create(VAR_PRIMARY, 0, 1, 0, THEME_DARK)) == 0;
    var s : u32 = 1;
    while (s < ST_COUNT) {
        assert has_noncolour_cue(s);
        assert cue_code(s) != cue_code(s - 1);
        s = s + 1;
    }
    assert has_noncolour_cue(ST_DEFAULT) == false and cue_code(ST_DEFAULT) == 0;
}

test dispose_is_inert {
    const c : ButtonCfg = button_set_state(button_create(VAR_PRIMARY, 0, 1, 4, THEME_DARK), ST_HOVER);
    const d : ButtonCfg = button_dispose(c);
    assert d.alive == false and d.state == ST_DEFAULT;
    assert hit_test(d, 500.0, 1.0, 1.0) == false;
    assert render_count(d) == 0 and a11y_name_len(d) == 0;
}

invariant ops_never_exceed_the_bound_and_never_carry_an_outline {
    assert BTN_MAX_OPS >= 5;
    assert OUTLINE_W == 0.0;
    assert ROLE_COUNT == 6 and ST_COUNT == 6;
}
