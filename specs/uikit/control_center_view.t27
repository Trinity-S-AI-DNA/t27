// SPDX-License-Identifier: Apache-2.0
; specs/uikit/control_center_view.t27 -- UI KIT CONTROL CENTER view (petal F), renderer-neutral.
; From the control_center state (selected row, state, theme), the object registry and the Button object,
; op i of the draw list: rects and text runs with role ids. No drawing call, no colour literal:
; a role resolves to a channel of native_tokens (ccv_role_c). Positions come from the control_center
; grid (cc_col_start, cc_col_span, cc_col_row); the constants below are only the layout of the rows
; inside a panel. Origin (0, 0) is the top-left of the rect the host hands over.
; A refused selection, state, theme or an empty rect gives a draw list of length 0, never a default.
; Closes #13792, epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_control_center_view;

use uikit::control_center::CC_REFUSED;
use uikit::control_center::CC_ROWS;
use uikit::control_center::CC_GRID;
use uikit::control_center::CC_WIDTH_NARROW;
use uikit::control_center::CC_WIDTH_WIDE;
use uikit::control_center::CC_COL_CATALOG;
use uikit::control_center::CC_COL_PREVIEW;
use uikit::control_center::CC_COL_INSPECTOR;
use uikit::control_center::CC_COL_COUNT;
use uikit::control_center::CC_THEME_LIGHT;
use uikit::control_center::CC_THEME_COUNT;
use uikit::control_center::CC_STATE_COUNT;
use uikit::control_center::CC_STATE_DEFAULT;
use uikit::control_center::cc_col_span;
use uikit::control_center::cc_col_start;
use uikit::control_center::cc_col_row;
use uikit::object_registry::reg_name;
use uikit::object_registry::reg_issue;
use uikit::object_registry::reg_status;
use uikit::object_registry::REG_ACCEPTED;
use uikit::button::DrawOp;
use uikit::button::ButtonCfg;
use uikit::button::button_create;
use uikit::button::button_set_state;
use uikit::button::render_count;
use uikit::button::render_op;
use uikit::button::measure_w;
use uikit::button::measure_h;
use uikit::button::VAR_PRIMARY;
use uikit::button::THEME_DARK;
use uikit::button::OP_RECT;
use uikit::button::OP_TEXT;
use uikit::button::OP_ICON;
use uikit::button::ROLE_SURFACE;
use uikit::button::ROLE_INK;
use uikit::button::ROLE_ACCENT;
use uikit::button::ROLE_DANGER;
use uikit::button::ROLE_SUCCESS;
use uikit::button::ROLE_LINE;
use uikit::button::ROLE_COUNT;
use uikit::native_tokens::T27_BG_R;
use uikit::native_tokens::T27_BG_G;
use uikit::native_tokens::T27_BG_B;
use uikit::native_tokens::T27_TEXT_R;
use uikit::native_tokens::T27_TEXT_G;
use uikit::native_tokens::T27_TEXT_B;
use uikit::native_tokens::T27_ACCENT_R;
use uikit::native_tokens::T27_ACCENT_G;
use uikit::native_tokens::T27_ACCENT_B;
use uikit::native_tokens::T27_MUTED_R;
use uikit::native_tokens::T27_MUTED_G;
use uikit::native_tokens::T27_MUTED_B;
use uikit::native_tokens::PAPER_ACCENT_R;
use uikit::native_tokens::PAPER_ACCENT_G;
use uikit::native_tokens::PAPER_ACCENT_B;

; op kinds of the draw list; a rect with line > 0 is a stroke, otherwise a fill
pub const CCV_NONE : u32 = 0;
pub const CCV_RECT : u32 = 1;
pub const CCV_TEXT : u32 = 2;

pub const CCV_W_REGULAR  : u32 = 0;
pub const CCV_W_SEMIBOLD : u32 = 1;
pub const CCV_W_BOLD     : u32 = 2;

; selected row that gets a live Button preview (registry row of Button)
pub const CCV_SEL_BUTTON : u32 = 2;
pub const CCV_SEL_DEFAULT : u32 = 2;

; layout inside a panel (logical px); the panel boxes themselves come from the control_center grid
pub const CCV_WIDE_MIN : f64 = 720.0;
pub const CCV_HEADER_H : f64 = 40.0;
pub const CCV_PAD      : f64 = 12.0;
pub const CCV_INSET    : f64 = 4.0;
pub const CCV_PANEL_R  : f64 = 8.0;
pub const CCV_ROW_H    : f64 = 20.0;
pub const CCV_LIST_TOP : f64 = 34.0;
pub const CCV_INSP_STEP : f64 = 34.0;
pub const CCV_PILL_W   : f64 = 64.0;
pub const CCV_PILL_H   : f64 = 22.0;
pub const CCV_SIZE_TITLE : f64 = 14.0;
pub const CCV_SIZE_ROW   : f64 = 11.0;
pub const CCV_SIZE_SMALL : f64 = 9.0;
pub const CCV_BASE_K     : f64 = 0.35;

pub const CCV_A_FULL   : f64 = 1.0;
pub const CCV_A_MUTED  : f64 = 0.55;
pub const CCV_A_PANEL  : f64 = 0.08;
pub const CCV_A_SELECT : f64 = 0.12;
pub const CCV_A_PILL   : f64 = 0.4;

; text ids: 0..22 are the registry names (catalog rows); the rest are fixed or depend on the selection
pub const CCV_T_HEADER    : u32 = 100;
pub const CCV_T_CATALOG   : u32 = 101;
pub const CCV_T_PREVIEW   : u32 = 102;
pub const CCV_T_INSPECTOR : u32 = 103;
pub const CCV_T_THEME     : u32 = 104;
pub const CCV_T_STATE     : u32 = 105;
pub const CCV_T_VARIANT   : u32 = 106;
pub const CCV_T_BTN       : u32 = 107;
pub const CCV_T_NOPREVIEW : u32 = 108;
pub const CCV_L_TOKENS    : u32 = 110;
pub const CCV_L_A11Y      : u32 = 111;
pub const CCV_L_ISSUE     : u32 = 112;
pub const CCV_L_PR        : u32 = 113;
pub const CCV_L_TESTS     : u32 = 114;
pub const CCV_L_SHOT      : u32 = 115;
pub const CCV_L_VR        : u32 = 116;
pub const CCV_V_TOKENS    : u32 = 120;
pub const CCV_V_A11Y      : u32 = 121;
pub const CCV_V_ISSUE     : u32 = 122;
pub const CCV_V_PR        : u32 = 123;
pub const CCV_V_TESTS     : u32 = 124;
pub const CCV_V_SHOT      : u32 = 125;
pub const CCV_V_VR        : u32 = 126;

; ops before the preview: bg, header, pill rect, pill text (4), 3 panels x (rect, title) (6),
; selected-row highlight (1), 23 catalog rows
pub const CCV_HEAD_OPS : u32 = 11;
pub const CCV_PREVIEW_FIXED : u32 = 2;
pub const CCV_INSPECTOR_OPS : u32 = 14;

pub struct CcvOp {
    kind: u32,
    role: u32,
    alpha: f64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    radius: f64,
    line: f64,
    size: f64,
    weight: u32,
    text: u32,
}

pub fn ccv_none() -> CcvOp {
    return CcvOp{.kind = CCV_NONE, .role = ROLE_SURFACE, .alpha = 0.0, .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0, .radius = 0.0, .line = 0.0, .size = 0.0, .weight = CCV_W_REGULAR, .text = 0};
}

pub fn ccv_rect(role: u32, alpha: f64, x: f64, y: f64, w: f64, h: f64, radius: f64, line: f64) -> CcvOp {
    return CcvOp{.kind = CCV_RECT, .role = role, .alpha = alpha, .x = x, .y = y, .w = w, .h = h, .radius = radius, .line = line, .size = 0.0, .weight = CCV_W_REGULAR, .text = 0};
}

pub fn ccv_text_op(role: u32, alpha: f64, x: f64, y: f64, size: f64, weight: u32, text: u32) -> CcvOp {
    return CcvOp{.kind = CCV_TEXT, .role = role, .alpha = alpha, .x = x, .y = y, .w = 0.0, .h = 0.0, .radius = 0.0, .line = 0.0, .size = size, .weight = weight, .text = text};
}

; ── theme_bind: a role to a channel (0 r, 1 g, 2 b) of native_tokens ─────────
; Dark: surface = bg, ink and line = text, accent = accent. Light swaps surface and ink and takes the paper accent.
; Danger has no token yet and reads as muted; success reads as the accent.
pub fn ccv_role_c(theme: u32, role: u32, ch: u32) -> f64 {
    var light : bool = false;
    if (theme == CC_THEME_LIGHT) { light = true; }
    var r : f64 = T27_TEXT_R;
    var g : f64 = T27_TEXT_G;
    var b : f64 = T27_TEXT_B;
    if (role == ROLE_SURFACE) {
        r = T27_BG_R; g = T27_BG_G; b = T27_BG_B;
        if (light) { r = T27_TEXT_R; g = T27_TEXT_G; b = T27_TEXT_B; }
    }
    if (role == ROLE_INK or role == ROLE_LINE) {
        if (light) { r = T27_BG_R; g = T27_BG_G; b = T27_BG_B; }
    }
    if (role == ROLE_ACCENT or role == ROLE_SUCCESS) {
        r = T27_ACCENT_R; g = T27_ACCENT_G; b = T27_ACCENT_B;
        if (light) { r = PAPER_ACCENT_R; g = PAPER_ACCENT_G; b = PAPER_ACCENT_B; }
    }
    if (role == ROLE_DANGER) {
        r = T27_MUTED_R; g = T27_MUTED_G; b = T27_MUTED_B;
    }
    if (ch == 0) { return r; }
    if (ch == 1) { return g; }
    if (ch == 2) { return b; }
    return 0.0;
}

; ── text of a run ────────────────────────────────────────────────────────────
pub fn ccv_state_name(s: u32) -> str {
    if (s == 0) { return "Default"; }
    if (s == 1) { return "Hover"; }
    if (s == 2) { return "Pressed"; }
    if (s == 3) { return "Focus"; }
    if (s == 4) { return "Disabled"; }
    if (s == 5) { return "Loading"; }
    return "";
}

pub fn ccv_issue_text(n: u32) -> str {
    if (n == 0) { return "none yet"; }
    if (n == 13758) { return "#13758"; }
    if (n == 13759) { return "#13759"; }
    if (n == 13760) { return "#13760"; }
    if (n == 13749) { return "#13749"; }
    return "linked";
}

pub fn ccv_text(sel: u32, state: u32, theme: u32, id: u32) -> str {
    if (id < CC_ROWS) { return reg_name(id); }
    if (id == CCV_T_HEADER) { return "UI KIT CONTROL CENTER"; }
    if (id == CCV_T_CATALOG) { return "CATALOG"; }
    if (id == CCV_T_PREVIEW) { return "LIVE PREVIEW"; }
    if (id == CCV_T_INSPECTOR) { return "INSPECTOR"; }
    if (id == CCV_T_THEME) {
        if (theme == CC_THEME_LIGHT) { return "LIGHT"; }
        return "DARK";
    }
    if (id == CCV_T_STATE) { return ccv_state_name(state); }
    if (id == CCV_T_VARIANT) { return "Primary"; }
    if (id == CCV_T_BTN) { return "Button"; }
    if (id == CCV_T_NOPREVIEW) { return "preview not built yet"; }
    if (id == CCV_L_TOKENS) { return "tokens used"; }
    if (id == CCV_L_A11Y) { return "a11y name"; }
    if (id == CCV_L_ISSUE) { return "issue"; }
    if (id == CCV_L_PR) { return "pull request"; }
    if (id == CCV_L_TESTS) { return "tests"; }
    if (id == CCV_L_SHOT) { return "screenshot"; }
    if (id == CCV_L_VR) { return "visual regression"; }
    if (id == CCV_V_TOKENS) { return "surface ink accent line"; }
    if (id == CCV_V_A11Y) { return reg_name(sel); }
    if (id == CCV_V_ISSUE) { return ccv_issue_text(reg_issue(sel)); }
    if (id == CCV_V_PR) {
        if (reg_status(sel) == REG_ACCEPTED) { return "accepted"; }
        return "none yet";
    }
    if (id == CCV_V_TESTS) { return "not run"; }
    if (id == CCV_V_SHOT) { return "not run"; }
    if (id == CCV_V_VR) { return "not run"; }
    return "";
}

; ── layout from the control_center grid ──────────────────────────────────────
pub fn ccv_width_class(w: f64) -> u32 {
    if (w >= CCV_WIDE_MIN) { return CC_WIDTH_WIDE; }
    return CC_WIDTH_NARROW;
}

; Content height under the header, and the height of one stacked panel row (narrow stacks three).
pub fn ccv_body_h(h: f64) -> f64 { return h - CCV_HEADER_H; }

pub fn ccv_panel_x(w: f64, col: u32) -> f64 {
    const wc : u32 = ccv_width_class(w);
    return (w / @as(f64, CC_GRID)) * @as(f64, cc_col_start(wc, col));
}

pub fn ccv_panel_w(w: f64, col: u32) -> f64 {
    const wc : u32 = ccv_width_class(w);
    return (w / @as(f64, CC_GRID)) * @as(f64, cc_col_span(wc, col));
}

pub fn ccv_panel_h(w: f64, h: f64) -> f64 {
    if (ccv_width_class(w) == CC_WIDTH_WIDE) { return ccv_body_h(h); }
    return ccv_body_h(h) / @as(f64, CC_COL_COUNT);
}

pub fn ccv_panel_y(w: f64, h: f64, col: u32) -> f64 {
    const wc : u32 = ccv_width_class(w);
    return CCV_HEADER_H + ccv_panel_h(w, h) * @as(f64, cc_col_row(wc, col));
}

; Height of one catalog row: CCV_ROW_H, shrunk when the panel is too short for all 23 rows.
pub fn ccv_row_h(w: f64, h: f64) -> f64 {
    const avail : f64 = ccv_panel_h(w, h) - CCV_LIST_TOP - CCV_PAD;
    const fit : f64 = avail / @as(f64, CC_ROWS);
    if (fit < CCV_ROW_H) { return fit; }
    return CCV_ROW_H;
}

pub fn ccv_valid(w: f64, h: f64, theme: u32, sel: u32, state: u32) -> bool {
    if (w <= 0.0 or h <= CCV_HEADER_H) { return false; }
    if (sel >= CC_ROWS or state >= CC_STATE_COUNT or theme >= CC_THEME_COUNT) { return false; }
    return true;
}

; The live Button of the preview: Primary, the control_center state, the view theme (system reads as dark).
pub fn ccv_button(theme: u32, state: u32) -> ButtonCfg {
    var th : u32 = THEME_DARK;
    if (theme == CC_THEME_LIGHT) { th = 1; }
    return button_set_state(button_create(VAR_PRIMARY, 1, CCV_T_BTN, 6, th), state);
}

; Ops of the preview column after its two caption runs: the Button's own ops, or one placeholder run.
pub fn ccv_preview_count(sel: u32, theme: u32, state: u32) -> u32 {
    if (sel == CCV_SEL_BUTTON) { return render_count(ccv_button(theme, state)); }
    return 1;
}

; Length of the draw list; 0 when the input is refused.
pub fn ccv_count(w: f64, h: f64, theme: u32, sel: u32, state: u32) -> u32 {
    if (ccv_valid(w, h, theme, sel, state) == false) { return 0; }
    return CCV_HEAD_OPS + CC_ROWS + CCV_PREVIEW_FIXED + ccv_preview_count(sel, theme, state) + CCV_INSPECTOR_OPS;
}

pub fn ccv_head_op(w: f64, h: f64, theme: u32, i: u32) -> CcvOp {
    if (i == 0) { return ccv_rect(ROLE_SURFACE, CCV_A_FULL, 0.0, 0.0, w, h, 0.0, 0.0); }
    if (i == 1) { return ccv_text_op(ROLE_INK, CCV_A_FULL, CCV_PAD, 0.5 * CCV_HEADER_H + CCV_BASE_K * CCV_SIZE_TITLE, CCV_SIZE_TITLE, CCV_W_SEMIBOLD, CCV_T_HEADER); }
    const px : f64 = w - CCV_PAD - CCV_PILL_W;
    const py : f64 = 0.5 * (CCV_HEADER_H - CCV_PILL_H);
    if (i == 2) { return ccv_rect(ROLE_LINE, CCV_A_PILL, px, py, CCV_PILL_W, CCV_PILL_H, 0.5 * CCV_PILL_H, 1.0); }
    if (i == 3) { return ccv_text_op(ROLE_INK, CCV_A_FULL, px + CCV_PAD, 0.5 * CCV_HEADER_H + CCV_BASE_K * CCV_SIZE_SMALL, CCV_SIZE_SMALL, CCV_W_BOLD, CCV_T_THEME); }
    // panels 4..9: rect then title, per column
    const k : u32 = i - 4;
    const col : u32 = k / 2;
    const bx : f64 = ccv_panel_x(w, col) + CCV_INSET;
    const by : f64 = ccv_panel_y(w, h, col);
    if (k % 2 == 0) {
        return ccv_rect(ROLE_LINE, CCV_A_PANEL, bx, by, ccv_panel_w(w, col) - 2.0 * CCV_INSET, ccv_panel_h(w, h) - CCV_INSET, CCV_PANEL_R, 0.0);
    }
    var tid : u32 = CCV_T_CATALOG;
    if (col == CC_COL_PREVIEW) { tid = CCV_T_PREVIEW; }
    if (col == CC_COL_INSPECTOR) { tid = CCV_T_INSPECTOR; }
    return ccv_text_op(ROLE_INK, CCV_A_MUTED, bx + CCV_PAD, by + 20.0, CCV_SIZE_SMALL, CCV_W_BOLD, tid);
}

; i = 10 is the highlight of the selected row; 11..33 are the 23 row labels (HEAD_OPS .. HEAD_OPS + CC_ROWS - 1).
pub fn ccv_catalog_op(w: f64, h: f64, sel: u32, i: u32) -> CcvOp {
    const bx : f64 = ccv_panel_x(w, CC_COL_CATALOG) + CCV_INSET;
    const bw : f64 = ccv_panel_w(w, CC_COL_CATALOG) - 2.0 * CCV_INSET;
    const top : f64 = ccv_panel_y(w, h, CC_COL_CATALOG) + CCV_LIST_TOP;
    const rh : f64 = ccv_row_h(w, h);
    if (i == 10) { return ccv_rect(ROLE_INK, CCV_A_SELECT, bx, top + rh * @as(f64, sel), bw, rh, 4.0, 0.0); }
    const row : u32 = i - CCV_HEAD_OPS;
    var a : f64 = CCV_A_MUTED;
    var wt : u32 = CCV_W_REGULAR;
    if (row == sel) { a = CCV_A_FULL; wt = CCV_W_SEMIBOLD; }
    return ccv_text_op(ROLE_INK, a, bx + CCV_PAD, top + rh * @as(f64, row) + 0.5 * rh + CCV_BASE_K * CCV_SIZE_ROW, CCV_SIZE_ROW, wt, row);
}

; Preview column: state caption, variant caption, then the Button ops (or one placeholder run).
pub fn ccv_preview_op(w: f64, h: f64, theme: u32, sel: u32, state: u32, j: u32) -> CcvOp {
    const bx : f64 = ccv_panel_x(w, CC_COL_PREVIEW) + CCV_INSET;
    const bw : f64 = ccv_panel_w(w, CC_COL_PREVIEW) - 2.0 * CCV_INSET;
    const by : f64 = ccv_panel_y(w, h, CC_COL_PREVIEW);
    if (j == 0) { return ccv_text_op(ROLE_INK, CCV_A_MUTED, bx + CCV_PAD, by + CCV_LIST_TOP, CCV_SIZE_SMALL, CCV_W_REGULAR, CCV_T_VARIANT); }
    if (j == 1) { return ccv_text_op(ROLE_INK, CCV_A_MUTED, bx + CCV_PAD, by + CCV_LIST_TOP + 16.0, CCV_SIZE_SMALL, CCV_W_REGULAR, CCV_T_STATE); }
    const cx : f64 = bx + 0.5 * bw;
    const cy : f64 = by + 0.5 * ccv_panel_h(w, h);
    if (sel != CCV_SEL_BUTTON) {
        return ccv_text_op(ROLE_INK, CCV_A_MUTED, cx - 60.0, cy, CCV_SIZE_ROW, CCV_W_REGULAR, CCV_T_NOPREVIEW);
    }
    const c : ButtonCfg = ccv_button(theme, state);
    const o : DrawOp = render_op(c, bw, j - CCV_PREVIEW_FIXED);
    const ox : f64 = cx - 0.5 * measure_w(c, bw);
    const oy : f64 = cy - 0.5 * measure_h(c);
    if (o.kind == OP_TEXT) {
        return ccv_text_op(o.role, o.alpha, ox + o.x, oy + 0.5 * o.h + CCV_BASE_K * CCV_SIZE_ROW, CCV_SIZE_ROW, CCV_W_SEMIBOLD, CCV_T_BTN);
    }
    if (o.kind == OP_ICON) {
        return ccv_rect(o.role, o.alpha, ox + o.x, oy + o.y, o.w, o.h, 0.5 * o.w, 0.0);
    }
    return ccv_rect(o.role, o.alpha, ox + o.x, oy + o.y, o.w, o.h, o.radius, o.line);
}

; Inspector column: seven label and value pairs.
pub fn ccv_inspector_op(w: f64, h: f64, k: u32) -> CcvOp {
    const bx : f64 = ccv_panel_x(w, CC_COL_INSPECTOR) + CCV_INSET + CCV_PAD;
    const by : f64 = ccv_panel_y(w, h, CC_COL_INSPECTOR) + CCV_LIST_TOP + 4.0;
    const pair : u32 = k / 2;
    const y : f64 = by + CCV_INSP_STEP * @as(f64, pair);
    if (k % 2 == 0) {
        return ccv_text_op(ROLE_INK, CCV_A_MUTED, bx, y, CCV_SIZE_SMALL, CCV_W_REGULAR, CCV_L_TOKENS + pair);
    }
    return ccv_text_op(ROLE_INK, CCV_A_FULL, bx, y + 15.0, CCV_SIZE_ROW, CCV_W_SEMIBOLD, CCV_V_TOKENS + pair);
}

; Op i of the draw list, in paint order: background, header, panels, catalog, preview, inspector.
pub fn ccv_op(w: f64, h: f64, theme: u32, sel: u32, state: u32, i: u32) -> CcvOp {
    if (i >= ccv_count(w, h, theme, sel, state)) { return ccv_none(); }
    if (i < 10) { return ccv_head_op(w, h, theme, i); }
    if (i < CCV_HEAD_OPS + CC_ROWS) { return ccv_catalog_op(w, h, sel, i); }
    const p0 : u32 = CCV_HEAD_OPS + CC_ROWS;
    const pn : u32 = CCV_PREVIEW_FIXED + ccv_preview_count(sel, theme, state);
    if (i < p0 + pn) { return ccv_preview_op(w, h, theme, sel, state, i - p0); }
    return ccv_inspector_op(w, h, i - p0 - pn);
}

; ── input: selection word, hit tests, state step ─────────────────────────────
; The host keeps the selected row as row + 1 so that 0 (a fresh word) reads as the default row.
pub fn ccv_sel_of(word: u32) -> u32 {
    if (word == 0 or word > CC_ROWS) { return CCV_SEL_DEFAULT; }
    return word - 1;
}

pub fn ccv_word_of(sel: u32) -> u32 {
    if (sel >= CC_ROWS) { return 0; }
    return sel + 1;
}

; The catalog row under (x, y) relative to the rect, or CC_REFUSED when the point is not on a row.
pub fn ccv_hit_row(w: f64, h: f64, x: f64, y: f64) -> u32 {
    if (w <= 0.0 or h <= CCV_HEADER_H) { return CC_REFUSED; }
    const bx : f64 = ccv_panel_x(w, CC_COL_CATALOG) + CCV_INSET;
    const bw : f64 = ccv_panel_w(w, CC_COL_CATALOG) - 2.0 * CCV_INSET;
    const top : f64 = ccv_panel_y(w, h, CC_COL_CATALOG) + CCV_LIST_TOP;
    const rh : f64 = ccv_row_h(w, h);
    if (rh <= 0.0 or x < bx or x >= bx + bw or y < top) { return CC_REFUSED; }
    const row : f64 = (y - top) / rh;
    if (row >= @as(f64, CC_ROWS)) { return CC_REFUSED; }
    return @as(u32, @intFromFloat(row));
}

pub fn ccv_hit_preview(w: f64, h: f64, x: f64, y: f64) -> bool {
    if (w <= 0.0 or h <= CCV_HEADER_H) { return false; }
    const bx : f64 = ccv_panel_x(w, CC_COL_PREVIEW);
    const by : f64 = ccv_panel_y(w, h, CC_COL_PREVIEW);
    return x >= bx and x < bx + ccv_panel_w(w, CC_COL_PREVIEW) and y >= by and y < by + ccv_panel_h(w, h);
}

; The state after a click in the preview: the next of the six, wrapping to Default.
pub fn ccv_next_state(s: u32) -> u32 {
    if (s + 1 >= CC_STATE_COUNT) { return CC_STATE_DEFAULT; }
    return s + 1;
}

; ── Tests ────────────────────────────────────────────────────────────────────
test refused_input_gives_an_empty_list {
    assert ccv_count(800.0, 600.0, 0, 23, 0) == 0;
    assert ccv_count(800.0, 600.0, 0, 2, 6) == 0;
    assert ccv_count(800.0, 600.0, 3, 2, 0) == 0;
    assert ccv_count(0.0, 600.0, 0, 2, 0) == 0;
    assert ccv_count(800.0, 30.0, 0, 2, 0) == 0;
    assert ccv_op(800.0, 600.0, 0, 23, 0, 0).kind == CCV_NONE;
}

test default_view_is_button_primary_default {
    assert CCV_SEL_DEFAULT == 2;
    assert reg_name(CCV_SEL_DEFAULT) == "Button";
    assert ccv_count(800.0, 600.0, 0, CCV_SEL_DEFAULT, CC_STATE_DEFAULT) > CCV_HEAD_OPS + CC_ROWS + CCV_INSPECTOR_OPS;
    assert ccv_text(2, 0, 0, CCV_T_VARIANT) == "Primary";
    assert ccv_text(2, 0, 0, CCV_T_STATE) == "Default";
}

test header_is_the_control_center_title {
    assert ccv_op(800.0, 600.0, 0, 2, 0, 0).kind == CCV_RECT;
    assert ccv_op(800.0, 600.0, 0, 2, 0, 0).role == ROLE_SURFACE;
    assert ccv_op(800.0, 600.0, 0, 2, 0, 1).kind == CCV_TEXT;
    assert ccv_text(2, 0, 0, ccv_op(800.0, 600.0, 0, 2, 0, 1).text) == "UI KIT CONTROL CENTER";
    assert ccv_text(2, 0, 0, CCV_T_THEME) == "DARK";
    assert ccv_text(2, 0, 1, CCV_T_THEME) == "LIGHT";
}

test catalog_lists_all_registry_rows_in_order {
    var r : u32 = 0;
    while (r < CC_ROWS) {
        const op : CcvOp = ccv_op(800.0, 600.0, 0, 2, 0, CCV_HEAD_OPS + r);
        assert op.kind == CCV_TEXT and op.text == r;
        assert ccv_text(2, 0, 0, op.text) == reg_name(r);
        r = r + 1;
    }
    assert ccv_text(2, 0, 0, 0) == "Text";
    assert ccv_text(2, 0, 0, 1) == "Container";
    assert ccv_text(2, 0, 0, 2) == "Button";
    assert ccv_text(2, 0, 0, 4) == "ThemePill";
}

test selected_row_is_highlighted_and_full_ink {
    const hl : CcvOp = ccv_op(800.0, 600.0, 0, 5, 0, 10);
    assert hl.kind == CCV_RECT and hl.role == ROLE_INK and hl.alpha == CCV_A_SELECT;
    assert ccv_op(800.0, 600.0, 0, 5, 0, CCV_HEAD_OPS + 5).alpha == CCV_A_FULL;
    assert ccv_op(800.0, 600.0, 0, 5, 0, CCV_HEAD_OPS + 4).alpha == CCV_A_MUTED;
    assert ccv_op(800.0, 600.0, 0, 6, 0, 10).y > hl.y;
}

test wide_columns_follow_the_3_6_3_grid {
    assert ccv_width_class(800.0) == CC_WIDTH_WIDE;
    assert ccv_panel_x(1200.0, CC_COL_CATALOG) == 0.0;
    assert ccv_panel_x(1200.0, CC_COL_PREVIEW) == 300.0;
    assert ccv_panel_x(1200.0, CC_COL_INSPECTOR) == 900.0;
    assert ccv_panel_w(1200.0, CC_COL_PREVIEW) == 600.0;
    assert ccv_panel_y(1200.0, 600.0, CC_COL_CATALOG) == CCV_HEADER_H;
    assert ccv_panel_y(1200.0, 600.0, CC_COL_INSPECTOR) == CCV_HEADER_H;
}

test narrow_columns_stack {
    assert ccv_width_class(400.0) == CC_WIDTH_NARROW;
    assert ccv_panel_x(400.0, CC_COL_INSPECTOR) == 0.0;
    assert ccv_panel_w(400.0, CC_COL_PREVIEW) == 400.0;
    assert ccv_panel_y(400.0, 640.0, CC_COL_PREVIEW) > ccv_panel_y(400.0, 640.0, CC_COL_CATALOG);
    assert ccv_panel_y(400.0, 640.0, CC_COL_INSPECTOR) > ccv_panel_y(400.0, 640.0, CC_COL_PREVIEW);
}

test preview_of_button_uses_the_button_ops_and_state {
    assert ccv_preview_count(CCV_SEL_BUTTON, 0, 0) == render_count(ccv_button(0, 0));
    assert ccv_preview_count(CCV_SEL_BUTTON, 0, 3) > ccv_preview_count(CCV_SEL_BUTTON, 0, 0);
    assert ccv_preview_count(0, 0, 0) == 1;
    assert ccv_count(800.0, 600.0, 0, 2, 3) == ccv_count(800.0, 600.0, 0, 2, 0) + 1;
    const lab : CcvOp = ccv_preview_op(800.0, 600.0, 0, 2, 0, 2);
    assert lab.kind == CCV_TEXT and lab.role == ROLE_ACCENT and lab.text == CCV_T_BTN;
    assert ccv_text(2, 0, 0, CCV_T_BTN) == "Button";
    assert ccv_preview_op(800.0, 600.0, 0, 0, 0, 2).text == CCV_T_NOPREVIEW;
}

test inspector_has_seven_pairs_of_label_and_value {
    const n : u32 = ccv_count(800.0, 600.0, 0, 2, 0);
    assert ccv_op(800.0, 600.0, 0, 2, 0, n - CCV_INSPECTOR_OPS).text == CCV_L_TOKENS;
    assert ccv_op(800.0, 600.0, 0, 2, 0, n - 1).text == CCV_V_VR;
    assert ccv_text(2, 0, 0, CCV_V_A11Y) == "Button";
    assert ccv_text(2, 0, 0, CCV_V_ISSUE) == "#13759";
    assert ccv_text(1, 0, 0, CCV_V_ISSUE) == "none yet";
    assert ccv_text(2, 0, 0, CCV_V_VR) == "not run";
}

test dark_and_light_resolve_from_tokens {
    assert ccv_role_c(0, ROLE_SURFACE, 0) == T27_BG_R;
    assert ccv_role_c(0, ROLE_INK, 1) == T27_TEXT_G;
    assert ccv_role_c(1, ROLE_SURFACE, 2) == T27_TEXT_B;
    assert ccv_role_c(1, ROLE_INK, 0) == T27_BG_R;
    assert ccv_role_c(0, ROLE_ACCENT, 1) == T27_ACCENT_G;
    assert ccv_role_c(1, ROLE_ACCENT, 1) == PAPER_ACCENT_G;
    assert ccv_role_c(0, ROLE_SURFACE, 0) != ccv_role_c(1, ROLE_SURFACE, 0);
    assert ccv_role_c(0, ROLE_INK, 0) != ccv_role_c(1, ROLE_INK, 0);
    assert ccv_role_c(2, ROLE_SURFACE, 0) == ccv_role_c(0, ROLE_SURFACE, 0);
}

invariant every_op_is_valid_and_inside_the_rect {
    @setEvalBranchQuota(2000000);
    var s : u32 = 0;
    while (s < CC_STATE_COUNT) {
        var sel : u32 = 0;
        while (sel < CC_ROWS) {
            const n : u32 = ccv_count(1200.0, 700.0, 1, sel, s);
            assert n > 0;
            var i : u32 = 0;
            while (i < n) {
                const op : CcvOp = ccv_op(1200.0, 700.0, 1, sel, s, i);
                assert op.kind != CCV_NONE and op.role < ROLE_COUNT;
                assert op.alpha > 0.0 and op.alpha <= 1.0;
                assert op.x >= 0.0 and op.y >= 0.0 and op.x <= 1200.0 and op.y <= 700.0;
                if (op.kind == CCV_TEXT) { assert op.size > 0.0; }
                i = i + 1;
            }
            assert ccv_op(1200.0, 700.0, 1, sel, s, n).kind == CCV_NONE;
            sel = sel + 1;
        }
        s = s + 1;
    }
}

test input_selection_word_and_hits {
    assert ccv_sel_of(0) == CCV_SEL_DEFAULT;
    assert ccv_sel_of(1) == 0;
    assert ccv_sel_of(23) == 22;
    assert ccv_sel_of(24) == CCV_SEL_DEFAULT;
    assert ccv_word_of(5) == 6;
    assert ccv_sel_of(ccv_word_of(7)) == 7;
    assert ccv_word_of(23) == 0;
    assert ccv_next_state(0) == 1;
    assert ccv_next_state(5) == CC_STATE_DEFAULT;
    const op : CcvOp = ccv_op(800.0, 600.0, 0, 2, 0, CCV_HEAD_OPS + 4);
    assert ccv_hit_row(800.0, 600.0, op.x + 1.0, op.y) == 4;
    assert ccv_hit_row(800.0, 600.0, 5.0, 5.0) == CC_REFUSED;
    assert ccv_hit_row(800.0, 600.0, 700.0, 100.0) == CC_REFUSED;
    assert ccv_hit_preview(800.0, 600.0, 400.0, 300.0);
    assert ccv_hit_preview(800.0, 600.0, 20.0, 300.0) == false;
}
