// SPDX-License-Identifier: Apache-2.0
; specs/uikit/segment_bar.t27 -- the UI Kit SegmentBar object: a row of 2 to 8 labelled segments, one
; selected. Draw ops are role-named and relative to the bar's own 0,0: one surface rect, one selection
; rect under the selected segment, one label text per segment. hit_test returns the segment index.
; One object, one spec (same shape as plate.t27): config + create, measure, render, hit_test, state
; (0..5), theme_bind (Dark 0, Light 1), a11y_name, dispose. No host draws it yet.
; Sizes: RADIUS_MD, SPACE_SM in design_tokens.t27 (via the plate constants). A size with no token is a
; named PROPOSED TOKEN constant below. No colour literal: roles only.
; Refs #13426, #13919.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_segment_bar;

use uikit::plate::PL_RADIUS;
use uikit::plate::PL_STATE_DEFAULT;
use uikit::plate::PL_STATES;
use uikit::plate::PL_THEME_DARK;
use uikit::plate::PL_THEME_LIGHT;
use uikit::plate::PL_ROLE_SURFACE;
use uikit::plate::PL_ROLE_INK;
use uikit::plate::PL_ROLE_ACCENT;
use uikit::plate::PL_OP_RECT;
use uikit::plate::PL_OP_TEXT;
use uikit::plate::PL_ICON_NONE;
use uikit::plate::PL_PAD_S;
use uikit::plate::pl_alpha;
use uikit::plate::pl_state_ok;
use uikit::plate::pl_theme_ok;

; ── Segment counts and the named "no segment" value ─────────────────────────
pub const SB_MIN_SEGS : u32 = 2;
pub const SB_MAX_SEGS : u32 = 8;
; named NONE value returned by sb_hit outside the bar (never a valid segment index, which is < 8)
pub const SB_NONE : u32 = 255;

; ── Tokens (px) ─────────────────────────────────────────────────────────────
; SPACE_SM in design_tokens.t27 (via PL_PAD_S): horizontal padding inside a segment
pub const SB_PAD_X : u32 = PL_PAD_S;
; PROPOSED TOKEN: bar height (two SPACE_SM pads plus one 24px content row)
pub const SB_H : u32 = 40;
; PROPOSED TOKEN: minimum width of one segment
pub const SB_MIN_SEG_W : u32 = 48;
; PROPOSED TOKEN: advance of one label character, used to decide where a label truncates
pub const SB_CHAR_W : u32 = 8;
pub const SB_MAX_OPS : u32 = 10;

; ── Config and object ───────────────────────────────────────────────────────
; label_len is the length in characters of each segment's label; name_id picks the region name.
pub struct SbConfig {
    count: u32,
    label_len: u32,
    name_id: u32,
}

pub struct SegmentBar {
    cfg: SbConfig,
    selected: u32,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct SbSize {
    w: u32,
    h: u32,
}

pub struct SbOp {
    kind: u32,
    role: u32,
    x: i32,
    y: i32,
    w: u32,
    h: u32,
    radius: u32,
    stroke: u32,
    alpha: u32,
    icon: u32,
    seg: u32,
    chars: u32,
    ellipsis: bool,
}

/// create: a count outside 2..8 is clamped; the bar starts with segment 0 selected, default state,
/// Dark theme, alive.
pub fn sb_create(count: u32, label_len: u32, name_id: u32) -> SegmentBar {
    var n : u32 = count;
    if (n < SB_MIN_SEGS) { n = SB_MIN_SEGS; }
    if (n > SB_MAX_SEGS) { n = SB_MAX_SEGS; }
    return SegmentBar {
        cfg: SbConfig { count: n, label_len: label_len, name_id: name_id },
        selected: 0,
        state: PL_STATE_DEFAULT,
        theme: PL_THEME_DARK,
        alive: true,
    };
}

/// select: an index at or past the segment count is refused (the bar is returned unchanged).
pub fn sb_select(b: SegmentBar, idx: u32) -> SegmentBar {
    if (idx >= b.cfg.count) { return b; }
    if (b.alive == false) { return b; }
    var q : SegmentBar = b;
    q.selected = idx;
    return q;
}

/// state: 0..5 as for Plate; an out-of-range state is refused.
pub fn sb_set_state(b: SegmentBar, state: u32) -> SegmentBar {
    if (pl_state_ok(state) == false) { return b; }
    if (b.alive == false) { return b; }
    var q : SegmentBar = b;
    q.state = state;
    return q;
}

/// theme_bind: Dark (0) or Light (1); any other value is refused. Geometry, selection and state
/// are untouched.
pub fn sb_set_theme(b: SegmentBar, theme: u32) -> SegmentBar {
    if (pl_theme_ok(theme) == false) { return b; }
    var q : SegmentBar = b;
    q.theme = theme;
    return q;
}

/// dispose: inert, default state, no longer hit, no ops.
pub fn sb_dispose(b: SegmentBar) -> SegmentBar {
    var q : SegmentBar = b;
    q.alive = false;
    q.state = PL_STATE_DEFAULT;
    return q;
}

// ---- layout ----

/// measure: the bar fills the width it is offered, never below count * SB_MIN_SEG_W; the height is
/// the token height.
pub fn sb_measure(cfg: SbConfig, avail_w: u32) -> SbSize {
    var w : u32 = avail_w;
    const floor : u32 = cfg.count * SB_MIN_SEG_W;
    if (w < floor) { w = floor; }
    return SbSize { w: w, h: SB_H };
}

/// Width of every segment but the last (integer split of the measured width).
pub fn sb_seg_w(cfg: SbConfig, avail_w: u32) -> u32 {
    return sb_measure(cfg, avail_w).w / cfg.count;
}

/// Left edge of segment i.
pub fn sb_seg_x(cfg: SbConfig, avail_w: u32, i: u32) -> u32 {
    return i * sb_seg_w(cfg, avail_w);
}

/// Width of segment i: the last segment takes the remainder, so there is no gap and no overlap.
pub fn sb_seg_width(cfg: SbConfig, avail_w: u32, i: u32) -> u32 {
    if (i + 1 == cfg.count) {
        return sb_measure(cfg, avail_w).w - sb_seg_x(cfg, avail_w, i);
    }
    return sb_seg_w(cfg, avail_w);
}

/// Label characters that fit in segment i (inside the padding).
pub fn sb_fit_chars(cfg: SbConfig, avail_w: u32, i: u32) -> u32 {
    const inner : u32 = sb_seg_width(cfg, avail_w, i) - 2 * SB_PAD_X;
    return inner / SB_CHAR_W;
}

// ---- render ----

/// How many draw ops the bar emits: surface, selection, one label per segment.
pub fn sb_op_count(b: SegmentBar) -> u32 {
    if (b.alive == false) { return 0; }
    return 2 + b.cfg.count;
}

/// The i-th draw op (relative to the bar's own 0,0), given the width it was measured at. Op 0 is the
/// surface, op 1 the selection under the selected segment, op 2+k the label of segment k. An index
/// past the op count yields an empty rect (alpha 0).
pub fn sb_op(b: SegmentBar, avail_w: u32, i: u32) -> SbOp {
    const sz : SbSize = sb_measure(b.cfg, avail_w);
    const empty : SbOp = SbOp { kind: PL_OP_RECT, role: PL_ROLE_SURFACE, x: 0, y: 0, w: 0, h: 0,
                                radius: 0, stroke: 0, alpha: 0, icon: PL_ICON_NONE,
                                seg: SB_NONE, chars: 0, ellipsis: false };
    if (i >= sb_op_count(b)) { return empty; }
    const a : u32 = pl_alpha(b.state);
    if (i == 0) {
        return SbOp { kind: PL_OP_RECT, role: PL_ROLE_SURFACE, x: 0, y: 0, w: sz.w, h: sz.h,
                      radius: PL_RADIUS, stroke: 0, alpha: a, icon: PL_ICON_NONE,
                      seg: SB_NONE, chars: 0, ellipsis: false };
    }
    if (i == 1) {
        return SbOp { kind: PL_OP_RECT, role: PL_ROLE_ACCENT,
                      x: @as(i32, @intCast(sb_seg_x(b.cfg, avail_w, b.selected))), y: 0,
                      w: sb_seg_width(b.cfg, avail_w, b.selected), h: sz.h,
                      radius: PL_RADIUS, stroke: 0, alpha: a, icon: PL_ICON_NONE,
                      seg: b.selected, chars: 0, ellipsis: false };
    }
    const k : u32 = i - 2;
    const fit : u32 = sb_fit_chars(b.cfg, avail_w, k);
    var shown : u32 = b.cfg.label_len;
    if (shown > fit) { shown = fit; }
    return SbOp { kind: PL_OP_TEXT, role: PL_ROLE_INK,
                  x: @as(i32, @intCast(sb_seg_x(b.cfg, avail_w, k) + SB_PAD_X)), y: 0,
                  w: sb_seg_width(b.cfg, avail_w, k) - 2 * SB_PAD_X, h: sz.h,
                  radius: 0, stroke: 0, alpha: a, icon: PL_ICON_NONE,
                  seg: k, chars: shown, ellipsis: b.cfg.label_len > fit };
}

// ---- hit test ----

/// hit_test: x, y relative to the bar's own box. Returns the segment index under the point, or
/// SB_NONE outside the bar or when the bar is disposed. The last segment absorbs the remainder.
pub fn sb_hit(b: SegmentBar, avail_w: u32, x: i32, y: i32) -> u32 {
    if (b.alive == false) { return SB_NONE; }
    if (x < 0 or y < 0) { return SB_NONE; }
    const sz : SbSize = sb_measure(b.cfg, avail_w);
    if (x >= @as(i32, @intCast(sz.w)) or y >= @as(i32, @intCast(sz.h))) { return SB_NONE; }
    var idx : u32 = @as(u32, @intCast(x)) / sb_seg_w(b.cfg, avail_w);
    if (idx >= b.cfg.count) { idx = b.cfg.count - 1; }
    return idx;
}

// ---- accessibility ----

/// a11y_name: the control name; never empty (id 0 and unknown ids take the default name).
pub fn sb_a11y_name(b: SegmentBar) -> str {
    if (b.cfg.name_id == 1) { return "View switcher"; }
    if (b.cfg.name_id == 2) { return "Mode switcher"; }
    return "Segmented control";
}

// ---- tests ----

test create_clamps_count_and_starts_clean {
    const b : SegmentBar = sb_create(4, 5, 1);
    assert b.cfg.count == 4;
    assert b.selected == 0;
    assert b.state == PL_STATE_DEFAULT;
    assert b.theme == PL_THEME_DARK;
    assert b.alive;
    assert sb_create(1, 5, 0).cfg.count == SB_MIN_SEGS;
    assert sb_create(0, 5, 0).cfg.count == SB_MIN_SEGS;
    assert sb_create(9, 5, 0).cfg.count == SB_MAX_SEGS;
}

test measure_uses_token_height_and_segment_floor {
    const b : SegmentBar = sb_create(4, 5, 0);
    const sz : SbSize = sb_measure(b.cfg, 400);
    assert sz.w == 400;
    assert sz.h == SB_H;
    assert sb_measure(b.cfg, 10).w == 4 * SB_MIN_SEG_W;
    assert sb_measure(sb_create(8, 5, 0).cfg, 100).w == 8 * SB_MIN_SEG_W;
}

test op_count_for_two_and_eight_segments {
    assert sb_op_count(sb_create(2, 5, 0)) == 4;
    assert sb_op_count(sb_create(8, 5, 0)) == 10;
    assert sb_op_count(sb_create(8, 5, 0)) <= SB_MAX_OPS;
    assert sb_op(sb_create(2, 5, 0), 200, 4).alpha == 0;
    assert sb_op(sb_create(8, 5, 0), 800, 10).alpha == 0;
}

test render_surface_and_selection_use_roles_and_token_radius {
    const b : SegmentBar = sb_select(sb_create(4, 5, 0), 2);
    const s : SbOp = sb_op(b, 400, 0);
    assert s.kind == PL_OP_RECT;
    assert s.role == PL_ROLE_SURFACE;
    assert s.radius == PL_RADIUS;
    assert s.x == 0;
    assert s.y == 0;
    assert s.w == 400;
    assert s.h == SB_H;
    const sel : SbOp = sb_op(b, 400, 1);
    assert sel.role == PL_ROLE_ACCENT;
    assert sel.x == 200;
    assert sel.w == 100;
    assert sel.seg == 2;
}

test render_one_label_per_segment_inside_its_segment {
    const b : SegmentBar = sb_create(3, 4, 0);
    var k : u32 = 0;
    while (k < 3) {
        const t : SbOp = sb_op(b, 300, 2 + k);
        assert t.kind == PL_OP_TEXT;
        assert t.role == PL_ROLE_INK;
        assert t.seg == k;
        assert t.chars == 4;
        assert t.ellipsis == false;
        assert t.x == @as(i32, @intCast(k * 100 + SB_PAD_X));
        k = k + 1;
    }
}

test last_segment_takes_the_remainder {
    const b : SegmentBar = sb_create(3, 4, 0);
    assert sb_seg_width(b.cfg, 301, 0) == 100;
    assert sb_seg_width(b.cfg, 301, 1) == 100;
    assert sb_seg_width(b.cfg, 301, 2) == 101;
    assert sb_seg_x(b.cfg, 301, 2) + sb_seg_width(b.cfg, 301, 2) == 301;
}

test hit_test_on_every_segment_edge_and_outside {
    const b : SegmentBar = sb_create(4, 5, 0);
    assert sb_hit(b, 400, 0, 0) == 0;
    assert sb_hit(b, 400, 99, 39) == 0;
    assert sb_hit(b, 400, 100, 0) == 1;
    assert sb_hit(b, 400, 199, 5) == 1;
    assert sb_hit(b, 400, 200, 5) == 2;
    assert sb_hit(b, 400, 299, 5) == 2;
    assert sb_hit(b, 400, 300, 5) == 3;
    assert sb_hit(b, 400, 399, 39) == 3;
    assert sb_hit(b, 400, 400, 5) == SB_NONE;
    assert sb_hit(b, 400, 10, 40) == SB_NONE;
    assert sb_hit(b, 400, -1, 5) == SB_NONE;
    assert sb_hit(b, 400, 5, -1) == SB_NONE;
}

test hit_test_remainder_belongs_to_the_last_segment {
    const b : SegmentBar = sb_create(3, 4, 0);
    assert sb_hit(b, 301, 199, 5) == 1;
    assert sb_hit(b, 301, 200, 5) == 2;
    assert sb_hit(b, 301, 300, 5) == 2;
    assert sb_hit(b, 301, 301, 5) == SB_NONE;
}

test label_truncates_at_a_narrow_width {
    const b : SegmentBar = sb_create(2, 10, 0);
    assert sb_fit_chars(b.cfg, 96, 0) == 4;
    const t : SbOp = sb_op(b, 96, 2);
    assert t.chars == 4;
    assert t.ellipsis;
    const u : SbOp = sb_op(b, 400, 2);
    assert u.chars == 10;
    assert u.ellipsis == false;
    assert sb_op(sb_create(2, 3, 0), 96, 2).ellipsis == false;
}

test out_of_range_select_is_refused {
    const b : SegmentBar = sb_select(sb_create(4, 5, 0), 3);
    assert b.selected == 3;
    assert sb_select(b, 4).selected == 3;
    assert sb_select(b, 255).selected == 3;
    assert sb_select(sb_create(2, 5, 0), 2).selected == 0;
    assert sb_select(b, 0).selected == 0;
}

test state_zero_to_five_accepted_and_out_of_range_refused {
    const b : SegmentBar = sb_create(3, 4, 0);
    assert sb_set_state(b, 1).state == 1;
    assert sb_set_state(b, PL_STATES - 1).state == 5;
    assert sb_set_state(b, PL_STATES).state == PL_STATE_DEFAULT;
    assert sb_set_state(sb_set_state(b, 3), 99).state == 3;
    assert sb_op(sb_set_state(b, 4), 300, 0).alpha == pl_alpha(4);
    assert sb_op(b, 300, 0).alpha == pl_alpha(0);
}

test theme_switch_keeps_geometry_selection_and_state {
    const b : SegmentBar = sb_set_state(sb_select(sb_create(5, 6, 1), 3), 2);
    var t : u32 = 0;
    while (t <= PL_THEME_LIGHT) {
        const c : SegmentBar = sb_set_theme(b, t);
        assert c.theme == t;
        assert c.selected == 3;
        assert c.state == 2;
        assert sb_measure(c.cfg, 500).w == sb_measure(b.cfg, 500).w;
        assert sb_op_count(c) == sb_op_count(b);
        var i : u32 = 0;
        while (i < sb_op_count(b)) {
            const p : SbOp = sb_op(b, 500, i);
            const q : SbOp = sb_op(c, 500, i);
            assert p.x == q.x;
            assert p.y == q.y;
            assert p.w == q.w;
            assert p.h == q.h;
            assert p.role == q.role;
            i = i + 1;
        }
        t = t + 1;
    }
    assert sb_set_theme(sb_set_theme(b, PL_THEME_LIGHT), 7).theme == PL_THEME_LIGHT;
}

test a11y_name_is_non_empty_and_distinct {
    var n : u32 = 0;
    while (n < 5) {
        assert sb_a11y_name(sb_create(2, 3, n)).len > 0;
        n = n + 1;
    }
    assert sb_a11y_name(sb_create(2, 3, 1)) != sb_a11y_name(sb_create(2, 3, 2));
}

test dispose_makes_hit_test_a_miss {
    const b : SegmentBar = sb_set_state(sb_select(sb_create(4, 5, 0), 1), 3);
    assert sb_hit(b, 400, 150, 5) == 1;
    const d : SegmentBar = sb_dispose(b);
    assert d.alive == false;
    assert d.state == PL_STATE_DEFAULT;
    assert sb_hit(d, 400, 150, 5) == SB_NONE;
    assert sb_op_count(d) == 0;
    assert sb_select(d, 2).selected == 1;
    assert sb_set_state(d, 2).state == PL_STATE_DEFAULT;
}

invariant segments_tile_the_bar_with_no_gap_or_overlap {
    var n : u32 = SB_MIN_SEGS;
    while (n <= SB_MAX_SEGS) {
        const b : SegmentBar = sb_create(n, 6, 0);
        const w : u32 = sb_measure(b.cfg, 503).w;
        var i : u32 = 0;
        var edge : u32 = 0;
        while (i < n) {
            assert sb_seg_x(b.cfg, 503, i) == edge;
            edge = edge + sb_seg_width(b.cfg, 503, i);
            i = i + 1;
        }
        assert edge == w;
        n = n + 1;
    }
}

invariant ops_stay_inside_the_measured_box {
    const b : SegmentBar = sb_select(sb_create(8, 6, 0), 7);
    const sz : SbSize = sb_measure(b.cfg, 517);
    var i : u32 = 0;
    while (i < sb_op_count(b)) {
        const o : SbOp = sb_op(b, 517, i);
        assert o.x >= 0;
        assert o.y >= 0;
        assert o.x + @as(i32, @intCast(o.w)) <= @as(i32, @intCast(sz.w));
        assert o.y + @as(i32, @intCast(o.h)) <= @as(i32, @intCast(sz.h));
        i = i + 1;
    }
}
