// SPDX-License-Identifier: Apache-2.0
; specs/uikit/light_dot.t27 -- the UI Kit LightDot object: a small round dot in a role colour.
; Variants: idle (line), live (success), busy (accent), fault (danger); a pulse flag that only live takes.
; Standalone the dot is decorative; an accessible name is required only when the dot is the sole carrier
; of a state, and then it reads "<owner> <state word>".
; Draw ops carry ROLE names and per-state alphas, never a colour literal, and are relative to the object's
; own 0,0. Colour is never the only carrier of a non-default state: each one changes an outline width or
; adds an icon op. Light is the inverse of Dark for surface and ink.
; Issue: Trinity-S-AI-DNA/t27#13772, epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_light_dot;

use uikit::design_tokens;

; ── Variants ────────────────────────────────────────────────────────────────
pub const DOT_IDLE  : u32 = 0;
pub const DOT_LIVE  : u32 = 1;
pub const DOT_BUSY  : u32 = 2;
pub const DOT_FAULT : u32 = 3;
pub const DOT_VARIANTS : u32 = 4;

; ── Roles (names, resolved to colours by the host from the tokens) ──────────
pub const ROLE_SURFACE : u32 = 0;
pub const ROLE_INK     : u32 = 1;
pub const ROLE_ACCENT  : u32 = 2;
pub const ROLE_DANGER  : u32 = 3;
pub const ROLE_SUCCESS : u32 = 4;
pub const ROLE_LINE    : u32 = 5;
pub const ROLE_NONE    : u32 = 6;

; ── Object states ───────────────────────────────────────────────────────────
pub const ST_DEFAULT  : u32 = 0;
pub const ST_HOVER    : u32 = 1;
pub const ST_PRESSED  : u32 = 2;
pub const ST_FOCUS    : u32 = 3;
pub const ST_DISABLED : u32 = 4;
pub const ST_LOADING  : u32 = 5;
pub const ST_MAX      : u32 = 5;

; ── Themes ──────────────────────────────────────────────────────────────────
pub const THEME_DARK  : u32 = 0;
pub const THEME_LIGHT : u32 = 1;

; ── Draw op kinds ───────────────────────────────────────────────────────────
pub const OP_NONE : u32 = 0;
pub const OP_RECT : u32 = 1;
pub const OP_TEXT : u32 = 2;
pub const OP_ICON : u32 = 3;

; ── Icons ───────────────────────────────────────────────────────────────────
pub const ICON_NONE    : u32 = 0;
pub const ICON_SLASH   : u32 = 1;
pub const ICON_SPINNER : u32 = 2;

; ── Sizes (dp). PROPOSED TOKEN: design_tokens.t27 has no dot diameter ───────
; PROPOSED TOKEN
pub const DOT_DIAMETER_SM : f64 = 8.0;
; PROPOSED TOKEN
pub const DOT_DIAMETER_MD : f64 = 10.0;
; PROPOSED TOKEN
pub const DOT_DIAMETER_LG : f64 = 14.0;
; PROPOSED TOKEN: outline widths by state (hover, pressed, focus) and the pulse ring
pub const DOT_RING_HOVER   : f64 = 1.0;
pub const DOT_RING_PRESSED : f64 = 2.0;
pub const DOT_RING_FOCUS   : f64 = 3.0;
pub const DOT_RING_PULSE   : f64 = 2.0;

; ── State alphas ────────────────────────────────────────────────────────────
pub const ALPHA_DEFAULT  : f64 = 1.0;
pub const ALPHA_HOVER    : f64 = 0.8;
pub const ALPHA_PRESSED  : f64 = 0.867;
pub const ALPHA_DISABLED : f64 = 0.4;
pub const ALPHA_LOADING  : f64 = 0.6;
pub const ALPHA_PULSE    : f64 = 0.4;

; ── Config ──────────────────────────────────────────────────────────────────
; size_class 0..2 (sm, md, lg); owner_id is the content id of the owner label.
pub struct LightDotConfig {
    variant: u32,
    size_class: u32,
    pulse: bool,
    sole_carrier: bool,
    owner_id: u32,
    live: bool,
}

pub struct DotOp {
    kind: u32,
    role: u32,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    alpha: f64,
    ring: f64,
    icon: u32,
}

pub struct DotSize {
    w: f64,
    h: f64,
}

/// create: a clamped, live config. An out-of-range variant or size class falls back to idle / md.
pub fn dot_create(variant: u32, size_class: u32, pulse: bool, sole_carrier: bool, owner_id: u32) -> LightDotConfig {
    var v : u32 = variant;
    if (v >= DOT_VARIANTS) { v = DOT_IDLE; }
    var s : u32 = size_class;
    if (s > 2) { s = 1; }
    return LightDotConfig { variant: v, size_class: s, pulse: pulse, sole_carrier: sole_carrier, owner_id: owner_id, live: true };
}

/// The pulse takes effect only on a live dot.
pub fn dot_pulses(c: LightDotConfig) -> bool {
    return c.pulse and c.variant == DOT_LIVE and c.live;
}

pub fn dot_diameter(size_class: u32) -> f64 {
    if (size_class == 0) { return DOT_DIAMETER_SM; }
    if (size_class == 2) { return DOT_DIAMETER_LG; }
    return DOT_DIAMETER_MD;
}

/// measure: the box is the dot plus room for the widest ring; avail_w is only an upper bound.
pub fn dot_measure(c: LightDotConfig, avail_w: f64) -> DotSize {
    if (c.live == false) { return DotSize { w: 0.0, h: 0.0 }; }
    const d : f64 = dot_diameter(c.size_class) + 2.0 * DOT_RING_FOCUS;
    var w : f64 = d;
    if (avail_w < w) { w = avail_w; }
    if (w < 0.0) { w = 0.0; }
    return DotSize { w: w, h: d };
}

/// A state is valid when it is 0..5; anything else is refused.
pub fn dot_state_ok(state: u32) -> bool {
    return state <= ST_MAX;
}

/// theme_bind: the role a role name resolves to in a theme. Light swaps surface and ink; the rest stay.
pub fn dot_theme_role(role: u32, theme: u32) -> u32 {
    return uikit_swap_role_for_theme(theme, role);
}

/// The role colour of a variant.
pub fn dot_variant_role(variant: u32) -> u32 {
    if (variant == DOT_LIVE) { return ROLE_SUCCESS; }
    if (variant == DOT_BUSY) { return ROLE_ACCENT; }
    if (variant == DOT_FAULT) { return ROLE_DANGER; }
    return ROLE_LINE;
}

pub fn dot_state_alpha(state: u32) -> f64 {
    if (state == ST_HOVER) { return ALPHA_HOVER; }
    if (state == ST_PRESSED) { return ALPHA_PRESSED; }
    if (state == ST_DISABLED) { return ALPHA_DISABLED; }
    if (state == ST_LOADING) { return ALPHA_LOADING; }
    return ALPHA_DEFAULT;
}

/// The non-colour change of a state: an outline width (hover, pressed, focus) ...
pub fn dot_state_ring(state: u32) -> f64 {
    if (state == ST_HOVER) { return DOT_RING_HOVER; }
    if (state == ST_PRESSED) { return DOT_RING_PRESSED; }
    if (state == ST_FOCUS) { return DOT_RING_FOCUS; }
    return 0.0;
}

/// ... or an icon (disabled, loading).
pub fn dot_state_icon(state: u32) -> u32 {
    if (state == ST_DISABLED) { return ICON_SLASH; }
    if (state == ST_LOADING) { return ICON_SPINNER; }
    return ICON_NONE;
}

/// How many ops render emits: the dot, then an outline, an icon and a pulse ring when they apply. At most 4.
pub fn dot_op_count(c: LightDotConfig, state: u32) -> u32 {
    if (c.live == false or dot_state_ok(state) == false) { return 0; }
    var n : u32 = 1;
    if (dot_state_ring(state) > 0.0) { n = n + 1; }
    if (dot_state_icon(state) != ICON_NONE) { n = n + 1; }
    if (dot_pulses(c)) { n = n + 1; }
    return n;
}

/// render: op number i (0-based), relative to the object's own 0,0; roles only, no colour literal.
/// Order: dot, outline (when the state has one), icon (when it has one), pulse ring (live + pulse).
pub fn dot_render_op(c: LightDotConfig, state: u32, theme: u32, i: u32) -> DotOp {
    const none : DotOp = DotOp { kind: OP_NONE, role: ROLE_NONE, x: 0.0, y: 0.0, w: 0.0, h: 0.0, alpha: 0.0, ring: 0.0, icon: ICON_NONE };
    if (i >= dot_op_count(c, state)) { return none; }
    const d : f64 = dot_diameter(c.size_class);
    const pad : f64 = DOT_RING_FOCUS;
    const role : u32 = dot_theme_role(dot_variant_role(c.variant), theme);
    const alpha : f64 = dot_state_alpha(state);
    var k : u32 = 0;
    if (i == k) {
        return DotOp { kind: OP_RECT, role: role, x: pad, y: pad, w: d, h: d, alpha: alpha, ring: 0.0, icon: ICON_NONE };
    }
    k = k + 1;
    if (dot_state_ring(state) > 0.0) {
        if (i == k) {
            return DotOp { kind: OP_RECT, role: dot_theme_role(ROLE_INK, theme), x: pad, y: pad, w: d, h: d, alpha: ALPHA_DEFAULT, ring: dot_state_ring(state), icon: ICON_NONE };
        }
        k = k + 1;
    }
    if (dot_state_icon(state) != ICON_NONE) {
        if (i == k) {
            return DotOp { kind: OP_ICON, role: dot_theme_role(ROLE_SURFACE, theme), x: pad, y: pad, w: d, h: d, alpha: alpha, ring: 0.0, icon: dot_state_icon(state) };
        }
        k = k + 1;
    }
    return DotOp { kind: OP_RECT, role: role, x: pad - DOT_RING_PULSE, y: pad - DOT_RING_PULSE, w: d + 2.0 * DOT_RING_PULSE, h: d + 2.0 * DOT_RING_PULSE, alpha: ALPHA_PULSE, ring: DOT_RING_PULSE, icon: ICON_NONE };
}

/// hit_test: x, y relative to the object's own box; a disposed object always misses. The box is round, so the
/// test is against the circle of the measured box.
pub fn dot_hit_test(c: LightDotConfig, x: f64, y: f64) -> bool {
    if (c.live == false) { return false; }
    const sz : DotSize = dot_measure(c, 1000000.0);
    const r : f64 = sz.w / 2.0;
    const dx : f64 = x - r;
    const dy : f64 = y - r;
    return dx * dx + dy * dy <= r * r;
}

/// The state word a screen reader says (0 idle, 1 live, 2 busy, 3 fault).
pub fn dot_state_word(variant: u32) -> str {
    if (variant == DOT_LIVE) { return "live"; }
    if (variant == DOT_BUSY) { return "busy"; }
    if (variant == DOT_FAULT) { return "fault"; }
    return "idle";
}

/// a11y: required only when the dot is the sole carrier of a state; otherwise it is decorative (hidden).
pub fn dot_a11y_required(c: LightDotConfig) -> bool {
    return c.sole_carrier and c.live;
}

/// The accessible name of the dot: its state word. The host speaks the owner label (owner_id) first,
/// so a screen reader says "<owner> <state word>"; no runtime string join here.
pub fn dot_a11y_name(c: LightDotConfig) -> str {
    return dot_state_word(c.variant);
}

/// dispose: an inert object: not live, no pulse, no size, every hit a miss.
pub fn dot_dispose(c: LightDotConfig) -> LightDotConfig {
    return LightDotConfig { variant: DOT_IDLE, size_class: c.size_class, pulse: false, sole_carrier: false, owner_id: 0, live: false };
}

// ── Tests ───────────────────────────────────────────────────────────────────
test create_clamps_and_lives {
    const c : LightDotConfig = dot_create(9, 7, true, false, 3);
    assert c.variant == DOT_IDLE;
    assert c.size_class == 1;
    assert c.live == true;
    assert dot_create(DOT_FAULT, 2, false, true, 1).variant == DOT_FAULT;
}

test variant_roles {
    assert dot_variant_role(DOT_IDLE) == ROLE_LINE;
    assert dot_variant_role(DOT_LIVE) == ROLE_SUCCESS;
    assert dot_variant_role(DOT_BUSY) == ROLE_ACCENT;
    assert dot_variant_role(DOT_FAULT) == ROLE_DANGER;
}

test pulse_only_on_live {
    assert dot_pulses(dot_create(DOT_LIVE, 1, true, false, 0));
    assert dot_pulses(dot_create(DOT_LIVE, 1, false, false, 0)) == false;
    assert dot_pulses(dot_create(DOT_BUSY, 1, true, false, 0)) == false;
    assert dot_pulses(dot_create(DOT_FAULT, 1, true, false, 0)) == false;
}

test measure_from_tokens {
    const sm : DotSize = dot_measure(dot_create(DOT_IDLE, 0, false, false, 0), 100.0);
    const lg : DotSize = dot_measure(dot_create(DOT_IDLE, 2, false, false, 0), 100.0);
    assert sm.w == DOT_DIAMETER_SM + 2.0 * DOT_RING_FOCUS;
    assert sm.h == sm.w;
    assert lg.w == DOT_DIAMETER_LG + 2.0 * DOT_RING_FOCUS;
    assert dot_measure(dot_create(DOT_IDLE, 2, false, false, 0), 5.0).w == 5.0;
}

test render_uses_roles_and_own_origin {
    const c : LightDotConfig = dot_create(DOT_LIVE, 1, true, false, 0);
    const op : DotOp = dot_render_op(c, ST_DEFAULT, THEME_DARK, 0);
    assert op.kind == OP_RECT;
    assert op.role == ROLE_SUCCESS;
    assert op.alpha == ALPHA_DEFAULT;
    assert op.x == DOT_RING_FOCUS;
    assert dot_op_count(c, ST_DEFAULT) == 2;
    assert dot_render_op(c, ST_DEFAULT, THEME_DARK, 1).alpha == ALPHA_PULSE;
    assert dot_render_op(c, ST_DEFAULT, THEME_DARK, 2).kind == OP_NONE;
}

test render_bounded {
    const c : LightDotConfig = dot_create(DOT_LIVE, 1, true, false, 0);
    assert dot_op_count(c, ST_FOCUS) == 3;
    assert dot_op_count(c, ST_LOADING) == 3;
    assert dot_op_count(dot_create(DOT_IDLE, 1, false, false, 0), ST_DEFAULT) == 1;
}

test hit_test_is_relative_and_round {
    const c : LightDotConfig = dot_create(DOT_IDLE, 1, false, false, 0);
    const half : f64 = dot_measure(c, 1000.0).w / 2.0;
    assert dot_hit_test(c, half, half);
    assert dot_hit_test(c, 0.0, 0.0) == false;
    assert dot_hit_test(c, 500.0, 500.0) == false;
}

test state_range_refused {
    assert dot_state_ok(ST_DEFAULT);
    assert dot_state_ok(ST_LOADING);
    assert dot_state_ok(6) == false;
    const c : LightDotConfig = dot_create(DOT_IDLE, 1, false, false, 0);
    assert dot_op_count(c, 6) == 0;
}

test theme_light_inverts_surface_and_ink {
    assert dot_theme_role(ROLE_SURFACE, THEME_LIGHT) == ROLE_INK;
    assert dot_theme_role(ROLE_INK, THEME_LIGHT) == ROLE_SURFACE;
    assert dot_theme_role(ROLE_SURFACE, THEME_DARK) == ROLE_SURFACE;
    assert dot_theme_role(ROLE_SUCCESS, THEME_LIGHT) == ROLE_SUCCESS;
}

test a11y_name_and_requirement {
    assert dot_a11y_required(dot_create(DOT_LIVE, 1, false, true, 1));
    assert dot_a11y_required(dot_create(DOT_LIVE, 1, false, false, 1)) == false;
    assert dot_a11y_name(dot_create(DOT_LIVE, 1, false, true, 1)) == "live";
    assert dot_a11y_name(dot_create(DOT_FAULT, 1, false, true, 1)) == "fault";
}

test non_default_states_change_non_colour_property {
    assert dot_state_ring(ST_HOVER) > 0.0;
    assert dot_state_ring(ST_PRESSED) > dot_state_ring(ST_HOVER);
    assert dot_state_ring(ST_FOCUS) > dot_state_ring(ST_PRESSED);
    assert dot_state_icon(ST_DISABLED) == ICON_SLASH;
    assert dot_state_icon(ST_LOADING) == ICON_SPINNER;
}

test dispose_is_inert {
    const d : LightDotConfig = dot_dispose(dot_create(DOT_LIVE, 1, true, true, 4));
    assert d.live == false;
    assert dot_hit_test(d, 5.0, 5.0) == false;
    assert dot_op_count(d, ST_DEFAULT) == 0;
    assert dot_measure(d, 100.0).w == 0.0;
    assert dot_a11y_required(d) == false;
}

invariant every_state_is_distinguishable_without_colour {
    assert dot_state_ring(ST_HOVER) > 0.0 or dot_state_icon(ST_HOVER) != ICON_NONE;
    assert dot_state_ring(ST_PRESSED) > 0.0 or dot_state_icon(ST_PRESSED) != ICON_NONE;
    assert dot_state_ring(ST_FOCUS) > 0.0 or dot_state_icon(ST_FOCUS) != ICON_NONE;
    assert dot_state_ring(ST_DISABLED) > 0.0 or dot_state_icon(ST_DISABLED) != ICON_NONE;
    assert dot_state_ring(ST_LOADING) > 0.0 or dot_state_icon(ST_LOADING) != ICON_NONE;
}
