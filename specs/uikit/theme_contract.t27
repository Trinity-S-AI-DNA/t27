// SPDX-License-Identifier: Apache-2.0
; specs/uikit/theme_contract.t27 -- theme contract for UI Kit objects
; Every UI Kit object binds to this contract: six roles, six states, one lifecycle.
; Colour values come exclusively from uikit_native_tokens and uikit_design_tokens.
; No colour literals (#RRGGBB or rgba() strings) in this file.
; Closes #13755.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_theme_contract;

use uikit::design_tokens::TH_PAPER_ACCENT;
use uikit::design_tokens::TH_T27_ACCENT;
use uikit::design_tokens::TH_T27_BG;
use uikit::design_tokens::TH_T27_TEXT;
use uikit::native_tokens::PAPER_ACCENT_B;
use uikit::native_tokens::PAPER_ACCENT_G;
use uikit::native_tokens::PAPER_ACCENT_R;
use uikit::native_tokens::T27_ACCENT_B;
use uikit::native_tokens::T27_ACCENT_G;
use uikit::native_tokens::T27_ACCENT_R;
use uikit::native_tokens::T27_BG_B;
use uikit::native_tokens::T27_BG_G;
use uikit::native_tokens::T27_BG_R;
use uikit::native_tokens::T27_TEXT_B;
use uikit::native_tokens::T27_TEXT_G;
use uikit::native_tokens::T27_TEXT_R;

; -- Theme ids -----------------------------------------------------------------
pub const THEME_DARK  : u32 = 0;
pub const THEME_LIGHT : u32 = 1;

; -- Token role ids (six canonical roles) ------------------------------------
pub const ROLE_SURFACE : u32 = 0;
pub const ROLE_INK     : u32 = 1;
pub const ROLE_ACCENT  : u32 = 2;
pub const ROLE_DANGER  : u32 = 3;
pub const ROLE_SUCCESS : u32 = 4;
pub const ROLE_LINE    : u32 = 5;

; -- Danger colour (semantic red; no design_token exists -- defined here) ----
; Dark danger: vivid red on black background -- complement of the green accent axis.
; Light danger: deeper red on white background.
; These are f64 channel values, not colour-literal strings.
pub const DANGER_DARK_R  : f64 = 1.0;
pub const DANGER_DARK_G  : f64 = 0.267;
pub const DANGER_DARK_B  : f64 = 0.267;
pub const DANGER_LIGHT_R : f64 = 0.800;
pub const DANGER_LIGHT_G : f64 = 0.0;
pub const DANGER_LIGHT_B : f64 = 0.0;

; -- Role-to-native-token mapping: Dark theme ---------------------------------
; surface: TH_T27_BG = #000000 (black)
pub const DARK_SURFACE_R : f64 = T27_BG_R;
pub const DARK_SURFACE_G : f64 = T27_BG_G;
pub const DARK_SURFACE_B : f64 = T27_BG_B;
; ink: TH_T27_TEXT = #FFFFFF (white)
pub const DARK_INK_R : f64 = T27_TEXT_R;
pub const DARK_INK_G : f64 = T27_TEXT_G;
pub const DARK_INK_B : f64 = T27_TEXT_B;
; accent: TH_T27_ACCENT = #00FF88 (green)
pub const DARK_ACCENT_R : f64 = T27_ACCENT_R;
pub const DARK_ACCENT_G : f64 = T27_ACCENT_G;
pub const DARK_ACCENT_B : f64 = T27_ACCENT_B;
; danger: semantic red (see DANGER_DARK_* above)
pub const DARK_DANGER_R : f64 = DANGER_DARK_R;
pub const DARK_DANGER_G : f64 = DANGER_DARK_G;
pub const DARK_DANGER_B : f64 = DANGER_DARK_B;
; success: same axis as dark accent (green)
pub const DARK_SUCCESS_R : f64 = T27_ACCENT_R;
pub const DARK_SUCCESS_G : f64 = T27_ACCENT_G;
pub const DARK_SUCCESS_B : f64 = T27_ACCENT_B;
; line: ink colour (white in dark); alpha applied separately via state alphas
pub const DARK_LINE_R : f64 = T27_TEXT_R;
pub const DARK_LINE_G : f64 = T27_TEXT_G;
pub const DARK_LINE_B : f64 = T27_TEXT_B;

; -- Role-to-native-token mapping: Light theme --------------------------------
; Light is the exact inverse of Dark for surface and ink (black <-> white swap).
; surface: 1,1,1 = white (inverse of dark surface which is black)
pub const LIGHT_SURFACE_R : f64 = T27_TEXT_R;
pub const LIGHT_SURFACE_G : f64 = T27_TEXT_G;
pub const LIGHT_SURFACE_B : f64 = T27_TEXT_B;
; ink: 0,0,0 = black (inverse of dark ink which is white)
pub const LIGHT_INK_R : f64 = T27_BG_R;
pub const LIGHT_INK_G : f64 = T27_BG_G;
pub const LIGHT_INK_B : f64 = T27_BG_B;
; accent: TH_PAPER_ACCENT = #00A35C (darker green legible on white)
pub const LIGHT_ACCENT_R : f64 = PAPER_ACCENT_R;
pub const LIGHT_ACCENT_G : f64 = PAPER_ACCENT_G;
pub const LIGHT_ACCENT_B : f64 = PAPER_ACCENT_B;
; danger: deeper red on white background (see DANGER_LIGHT_* above)
pub const LIGHT_DANGER_R : f64 = DANGER_LIGHT_R;
pub const LIGHT_DANGER_G : f64 = DANGER_LIGHT_G;
pub const LIGHT_DANGER_B : f64 = DANGER_LIGHT_B;
; success: same axis as light accent (darker green)
pub const LIGHT_SUCCESS_R : f64 = PAPER_ACCENT_R;
pub const LIGHT_SUCCESS_G : f64 = PAPER_ACCENT_G;
pub const LIGHT_SUCCESS_B : f64 = PAPER_ACCENT_B;
; line: ink colour (black in light); alpha applied separately via state alphas
pub const LIGHT_LINE_R : f64 = T27_BG_R;
pub const LIGHT_LINE_G : f64 = T27_BG_G;
pub const LIGHT_LINE_B : f64 = T27_BG_B;

; -- Interaction state ids (six canonical states) ----------------------------
pub const STATE_DEFAULT  : u32 = 0;
pub const STATE_HOVER    : u32 = 1;
pub const STATE_PRESSED  : u32 = 2;
pub const STATE_FOCUS    : u32 = 3;
pub const STATE_DISABLED : u32 = 4;
pub const STATE_LOADING  : u32 = 5;

; -- State alpha values (fill, ink, line applied per state) ------------------
; default: fully opaque fill and ink, hairline border
pub const ALPHA_DEFAULT_FILL : f64 = 1.0;
pub const ALPHA_DEFAULT_INK  : f64 = 1.0;
pub const ALPHA_DEFAULT_LINE : f64 = 0.08;
; hover: slightly dimmed fill, full ink, stronger border
pub const ALPHA_HOVER_FILL : f64 = 0.9;
pub const ALPHA_HOVER_INK  : f64 = 1.0;
pub const ALPHA_HOVER_LINE : f64 = 0.16;
; pressed: further dimmed fill, full ink, visible border
pub const ALPHA_PRESSED_FILL : f64 = 0.8;
pub const ALPHA_PRESSED_INK  : f64 = 1.0;
pub const ALPHA_PRESSED_LINE : f64 = 0.24;
; focus: full fill, full ink, prominent border ring
pub const ALPHA_FOCUS_FILL : f64 = 1.0;
pub const ALPHA_FOCUS_INK  : f64 = 1.0;
pub const ALPHA_FOCUS_LINE : f64 = 0.5;
; disabled: heavily dimmed fill and ink, hairline border
pub const ALPHA_DISABLED_FILL : f64 = 0.4;
pub const ALPHA_DISABLED_INK  : f64 = 0.4;
pub const ALPHA_DISABLED_LINE : f64 = 0.08;
; loading: moderately dimmed fill and ink, hairline border
pub const ALPHA_LOADING_FILL : f64 = 0.6;
pub const ALPHA_LOADING_INK  : f64 = 0.6;
pub const ALPHA_LOADING_LINE : f64 = 0.08;

; -- Object lifecycle phase constants -----------------------------------------
pub const LC_CREATE     : str = "create";
pub const LC_LAYOUT     : str = "layout";
pub const LC_RENDER     : str = "render";
pub const LC_HIT_TEST   : str = "hit_test";
pub const LC_STATE      : str = "state";
pub const LC_THEME_BIND : str = "theme_bind";
pub const LC_A11Y_NAME  : str = "a11y_name";
pub const LC_DISPOSE    : str = "dispose";

; -- Tests --------------------------------------------------------------------
test surface_ink_dark_light_inverse {
    // Dark surface is black; Light surface is white (exact inverse).
    assert DARK_SURFACE_R == 0.0;
    assert DARK_SURFACE_G == 0.0;
    assert DARK_SURFACE_B == 0.0;
    assert LIGHT_SURFACE_R == 1.0;
    assert LIGHT_SURFACE_G == 1.0;
    assert LIGHT_SURFACE_B == 1.0;
    // Dark ink is white; Light ink is black (exact inverse).
    assert DARK_INK_R == 1.0;
    assert DARK_INK_G == 1.0;
    assert DARK_INK_B == 1.0;
    assert LIGHT_INK_R == 0.0;
    assert LIGHT_INK_G == 0.0;
    assert LIGHT_INK_B == 0.0;
}

test six_roles_distinct {
    assert ROLE_SURFACE != ROLE_INK;
    assert ROLE_INK     != ROLE_ACCENT;
    assert ROLE_ACCENT  != ROLE_DANGER;
    assert ROLE_DANGER  != ROLE_SUCCESS;
    assert ROLE_SUCCESS != ROLE_LINE;
    assert ROLE_SURFACE != ROLE_LINE;
}

test six_states_distinct {
    assert STATE_DEFAULT  != STATE_HOVER;
    assert STATE_HOVER    != STATE_PRESSED;
    assert STATE_PRESSED  != STATE_FOCUS;
    assert STATE_FOCUS    != STATE_DISABLED;
    assert STATE_DISABLED != STATE_LOADING;
}

test state_alphas_in_unit_range {
    assert ALPHA_DEFAULT_FILL  > 0.0;
    assert ALPHA_DEFAULT_FILL  <= 1.0;
    assert ALPHA_HOVER_FILL    > 0.0;
    assert ALPHA_HOVER_FILL    <= 1.0;
    assert ALPHA_PRESSED_FILL  > 0.0;
    assert ALPHA_PRESSED_FILL  <= 1.0;
    assert ALPHA_FOCUS_FILL    > 0.0;
    assert ALPHA_FOCUS_FILL    <= 1.0;
    assert ALPHA_DISABLED_FILL > 0.0;
    assert ALPHA_DISABLED_FILL <= 1.0;
    assert ALPHA_LOADING_FILL  > 0.0;
    assert ALPHA_LOADING_FILL  <= 1.0;
}

test state_alphas_ordering {
    // disabled and loading are dimmer than default
    assert ALPHA_DISABLED_FILL < ALPHA_DEFAULT_FILL;
    assert ALPHA_LOADING_FILL  < ALPHA_DEFAULT_FILL;
    // pressed is dimmer than hover
    assert ALPHA_PRESSED_FILL  < ALPHA_HOVER_FILL;
    // focus line is stronger than default line
    assert ALPHA_FOCUS_LINE    > ALPHA_DEFAULT_LINE;
}

test lifecycle_phases_non_empty {
    assert LC_CREATE     != "";
    assert LC_LAYOUT     != "";
    assert LC_RENDER     != "";
    assert LC_HIT_TEST   != "";
    assert LC_STATE      != "";
    assert LC_THEME_BIND != "";
    assert LC_A11Y_NAME  != "";
    assert LC_DISPOSE    != "";
}

test accent_dark_matches_native_token {
    assert DARK_ACCENT_R == T27_ACCENT_R;
    assert DARK_ACCENT_G == T27_ACCENT_G;
    assert DARK_ACCENT_B == T27_ACCENT_B;
}

test accent_light_matches_native_token {
    assert LIGHT_ACCENT_R == PAPER_ACCENT_R;
    assert LIGHT_ACCENT_G == PAPER_ACCENT_G;
    assert LIGHT_ACCENT_B == PAPER_ACCENT_B;
}

; -- Invariants ---------------------------------------------------------------
invariant surface_ink_exact_bw_inverse {
    // Dark surface = black (0,0,0) and Light surface = white (1,1,1).
    assert DARK_SURFACE_R == 0.0;
    assert DARK_SURFACE_G == 0.0;
    assert DARK_SURFACE_B == 0.0;
    assert LIGHT_SURFACE_R == 1.0;
    assert LIGHT_SURFACE_G == 1.0;
    assert LIGHT_SURFACE_B == 1.0;
    // Dark ink = white (1,1,1) and Light ink = black (0,0,0).
    assert DARK_INK_R == 1.0;
    assert DARK_INK_G == 1.0;
    assert DARK_INK_B == 1.0;
    assert LIGHT_INK_R == 0.0;
    assert LIGHT_INK_G == 0.0;
    assert LIGHT_INK_B == 0.0;
}

invariant line_role_tracks_ink {
    // Line base colour equals the ink colour; alpha is applied separately per state.
    assert DARK_LINE_R == DARK_INK_R;
    assert DARK_LINE_G == DARK_INK_G;
    assert DARK_LINE_B == DARK_INK_B;
    assert LIGHT_LINE_R == LIGHT_INK_R;
    assert LIGHT_LINE_G == LIGHT_INK_G;
    assert LIGHT_LINE_B == LIGHT_INK_B;
}

invariant danger_rgb_in_unit_range {
    assert DARK_DANGER_R  <= 1.0;
    assert DARK_DANGER_G  >= 0.0;
    assert DARK_DANGER_B  >= 0.0;
    assert LIGHT_DANGER_R <= 1.0;
    assert LIGHT_DANGER_G >= 0.0;
    assert LIGHT_DANGER_B >= 0.0;
}

invariant success_matches_accent {
    // Success colour is the same axis as accent (green) in both themes.
    assert DARK_SUCCESS_R == DARK_ACCENT_R;
    assert DARK_SUCCESS_G == DARK_ACCENT_G;
    assert DARK_SUCCESS_B == DARK_ACCENT_B;
    assert LIGHT_SUCCESS_R == LIGHT_ACCENT_R;
    assert LIGHT_SUCCESS_G == LIGHT_ACCENT_G;
    assert LIGHT_SUCCESS_B == LIGHT_ACCENT_B;
}

invariant theme_ids_distinct {
    assert THEME_DARK != THEME_LIGHT;
}
