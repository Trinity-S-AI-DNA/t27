// SPDX-License-Identifier: Apache-2.0
; specs/uikit/god_mode_toggle.t27 -- the UI Kit God Mode toggle object: label "GOD MODE", off and on.
; Owner rule: no outline. The on state is fill-only (role accent) AND carries a non-colour cue: a dot
; icon and a bold label. Off is a muted line-role fill with a regular label.
; Draw ops are relative to the object's own 0,0 and name ROLES, never a colour literal; the host maps a
; role to a token through theme_token (Dark 0, Light 1). Sizes come from the native tokens.
; Refs #13752, epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_god_mode_toggle;

; -- Size: mirrors uikit_native_tokens, no pixel of its own except the one marked PROPOSED -------------
; native_tokens BTN_HEIGHT = 44.0 (the touch target)
pub const TG_HEIGHT : f64 = 44.0;
; PROPOSED TOKEN: TOGGLE_WIDTH = 60.0 (owner set 60 in the window draft; no token exists yet)
pub const TG_WIDTH : f64 = 60.0;
; PROPOSED TOKEN: TOGGLE_MARK = 8.0 (dot and state mark size, also the pad; SPACE_SM is 8px)
pub const TG_DOT : f64 = 8.0;
pub const TG_PAD : f64 = 8.0;

; -- Roles ---------------------------------------------------------------------------------------------
pub const ROLE_SURFACE : u32 = 0;
pub const ROLE_INK     : u32 = 1;
pub const ROLE_ACCENT  : u32 = 2;
pub const ROLE_DANGER  : u32 = 3;
pub const ROLE_SUCCESS : u32 = 4;
pub const ROLE_LINE    : u32 = 5;
pub const ROLE_COUNT   : u32 = 6;

; -- Draw op kinds and glyphs --------------------------------------------------------------------------
pub const OP_RECT : u32 = 0;
pub const OP_TEXT : u32 = 1;
pub const OP_ICON : u32 = 2;
pub const OPS_MAX : u32 = 4;

pub const ICON_NONE    : u32 = 0;
pub const ICON_DOT     : u32 = 1;
pub const ICON_UNDERLN : u32 = 2;
pub const ICON_PRESS   : u32 = 3;
pub const ICON_FOCUS   : u32 = 4;
pub const ICON_SLASH   : u32 = 5;
pub const ICON_SPIN    : u32 = 6;

; label content id 0 = "GOD MODE"; the label is bold when on, regular when off
pub const LABEL_GOD_MODE : u32 = 0;
pub const WEIGHT_OFF : u32 = 400;
pub const WEIGHT_ON  : u32 = 700;

; -- State ---------------------------------------------------------------------------------------------
pub const ST_DEFAULT  : u32 = 0;
pub const ST_HOVER    : u32 = 1;
pub const ST_PRESSED  : u32 = 2;
pub const ST_FOCUS    : u32 = 3;
pub const ST_DISABLED : u32 = 4;
pub const ST_LOADING  : u32 = 5;
pub const ST_COUNT    : u32 = 6;

; per-state alpha, same ladder as native_tokens BTN_ALPHA_*; loading sits between hover and disabled
pub const ALPHA_DEFAULT  : f64 = 1.0;
pub const ALPHA_HOVER    : f64 = 0.800;
pub const ALPHA_PRESSED  : f64 = 0.867;
pub const ALPHA_DISABLED : f64 = 0.400;
pub const ALPHA_LOADING  : f64 = 0.600;
pub const ALPHA_OFF_FILL : f64 = 0.250;

pub const ToggleConfig = struct {
    on : bool,
    theme : u32,                           // 0 Dark, 1 Light
    state : u32,                           // 0..5
    label : u32,                           // content id
    w : f64,
    h : f64,
    live : bool,                           // false after dispose
};

pub const Op = struct {
    kind : u32,
    role : u32,
    x : f64,
    y : f64,
    w : f64,
    h : f64,
    alpha : f64,
    arg : u32,                             // icon glyph, or text weight
    content : u32,                         // label id for text ops
};

pub const OpList = struct {
    ops : [4]Op,
    n : u32,
};

// ---- state ---------------------------------------------------------------------------------------

pub fn state_valid(s: u32) -> bool {
    return s < ST_COUNT;
}

pub fn state_alpha(s: u32) -> f64 {
    if (s == ST_HOVER) { return ALPHA_HOVER; }
    if (s == ST_PRESSED) { return ALPHA_PRESSED; }
    if (s == ST_DISABLED) { return ALPHA_DISABLED; }
    if (s == ST_LOADING) { return ALPHA_LOADING; }
    return ALPHA_DEFAULT;
}

/// The non-colour cue each non-default state adds: one icon glyph, distinct per state.
pub fn state_icon(s: u32) -> u32 {
    if (s == ST_HOVER) { return ICON_UNDERLN; }
    if (s == ST_PRESSED) { return ICON_PRESS; }
    if (s == ST_FOCUS) { return ICON_FOCUS; }
    if (s == ST_DISABLED) { return ICON_SLASH; }
    if (s == ST_LOADING) { return ICON_SPIN; }
    return ICON_NONE;
}

// ---- theme_bind: token ids 0 T27_BG, 1 T27_TEXT, 2 PAPER_BG, 3 PAPER_TEXT, 4 T27_ACCENT, 5 PAPER_ACCENT

pub fn theme_token(theme: u32, role: u32) -> u32 {
    if (role == ROLE_SURFACE) {
        if (theme == 0) { return 0; }
        return 2;
    }
    if (role == ROLE_ACCENT) {
        if (theme == 0) { return 4; }
        return 5;
    }
    if (theme == 0) { return 1; }
    return 3;
}

/// Luminance of a token: 0.0 black, 1.0 white (surface and ink only; the accent reads mid).
pub fn token_lum(tok: u32) -> f64 {
    if (tok == 0 or tok == 3) { return 0.0; }
    if (tok == 1 or tok == 2) { return 1.0; }
    return 0.5;
}

// ---- create / measure ----------------------------------------------------------------------------

pub fn measure_w(avail_w: f64) -> f64 {
    if (avail_w < TG_WIDTH) { return avail_w; }
    return TG_WIDTH;
}

pub fn measure_h(avail_w: f64) -> f64 {
    return TG_HEIGHT;
}

pub fn create(on: bool, theme: u32, avail_w: f64) -> ToggleConfig {
    var c : ToggleConfig = undefined;
    c.on = on;
    c.theme = theme;
    c.state = ST_DEFAULT;
    c.label = LABEL_GOD_MODE;
    c.w = measure_w(avail_w);
    c.h = measure_h(avail_w);
    c.live = true;
    return c;
}

/// An out-of-range state is refused: the config comes back unchanged.
pub fn set_state(c: ToggleConfig, s: u32) -> ToggleConfig {
    var r : ToggleConfig = c;
    if (state_valid(s) == false) { return r; }
    r.state = s;
    return r;
}

/// Flip on/off; refused while disabled, loading or disposed.
pub fn toggle(c: ToggleConfig) -> ToggleConfig {
    var r : ToggleConfig = c;
    if (c.live == false) { return r; }
    if (c.state == ST_DISABLED or c.state == ST_LOADING) { return r; }
    r.on = (c.on == false);
    return r;
}

// ---- a11y ----------------------------------------------------------------------------------------

pub fn a11y_name(c: ToggleConfig) -> str {
    if (c.on) { return "God mode, on"; }
    return "God mode, off";
}

// ---- render: bounded op list, relative to 0,0, roles only ----------------------------------------

fn put(l: OpList, k: u32, role: u32, x: f64, y: f64, w: f64, h: f64, a: f64, arg: u32, content: u32) -> OpList {
    var r : OpList = l;
    if (r.n >= OPS_MAX) { return r; }
    r.ops[r.n].kind = k;
    r.ops[r.n].role = role;
    r.ops[r.n].x = x;
    r.ops[r.n].y = y;
    r.ops[r.n].w = w;
    r.ops[r.n].h = h;
    r.ops[r.n].alpha = a;
    r.ops[r.n].arg = arg;
    r.ops[r.n].content = content;
    r.n = r.n + 1;
    return r;
}

pub fn render(c: ToggleConfig) -> OpList {
    var l : OpList = undefined;
    l.n = 0;
    if (c.live == false) { return l; }
    const a : f64 = state_alpha(c.state);
    var weight : u32 = WEIGHT_OFF;
    var label_role : u32 = ROLE_INK;
    if (c.on) {
        // fill-only accent; the dot and the bold label are the non-colour cue
        l = put(l, OP_RECT, ROLE_ACCENT, 0.0, 0.0, c.w, c.h, a, 0, 0);
        l = put(l, OP_ICON, ROLE_SURFACE, TG_PAD, (c.h - TG_DOT) / 2.0, TG_DOT, TG_DOT, a, ICON_DOT, 0);
        weight = WEIGHT_ON;
        label_role = ROLE_SURFACE;
    } else {
        l = put(l, OP_RECT, ROLE_LINE, 0.0, 0.0, c.w, c.h, ALPHA_OFF_FILL * a, 0, 0);
    }
    l = put(l, OP_TEXT, label_role, 0.0, 0.0, c.w, c.h, a, weight, c.label);
    if (state_icon(c.state) != ICON_NONE) {
        l = put(l, OP_ICON, ROLE_INK, c.w - TG_PAD - TG_DOT, TG_PAD, TG_DOT, TG_DOT, a, state_icon(c.state), 0);
    }
    return l;
}

// ---- hit_test: relative to the object's own box; disabled, loading and disposed are a miss -------

pub fn hit_test(c: ToggleConfig, x: f64, y: f64) -> bool {
    if (c.live == false) { return false; }
    if (c.state == ST_DISABLED or c.state == ST_LOADING) { return false; }
    if (x < 0.0 or y < 0.0) { return false; }
    return x < c.w and y < c.h;
}

// ---- dispose: the inert state --------------------------------------------------------------------

pub fn dispose(c: ToggleConfig) -> ToggleConfig {
    var r : ToggleConfig = c;
    r.on = false;
    r.state = ST_DEFAULT;
    r.w = 0.0;
    r.h = 0.0;
    r.live = false;
    return r;
}

// ---- Tests ---------------------------------------------------------------------------------------

test create_configures {
    const c : ToggleConfig = create(false, 0, 200.0);
    assert c.on == false;
    assert c.state == ST_DEFAULT;
    assert c.label == LABEL_GOD_MODE;
    assert c.live;
}

test measure_from_tokens {
    const c : ToggleConfig = create(true, 0, 200.0);
    assert c.w == 60.0;
    assert c.h == 44.0;
    assert measure_w(40.0) == 40.0;
    assert measure_h(40.0) == TG_HEIGHT;
}

test render_off_has_no_dot_and_regular_weight {
    const l : OpList = render(create(false, 0, 200.0));
    assert l.n == 2;
    assert l.ops[0].kind == OP_RECT;
    assert l.ops[0].role == ROLE_LINE;
    assert l.ops[1].kind == OP_TEXT;
    assert l.ops[1].arg == WEIGHT_OFF;
}

test render_on_is_accent_fill_with_dot_and_bold {
    const l : OpList = render(create(true, 0, 200.0));
    assert l.n == 3;
    assert l.ops[0].role == ROLE_ACCENT;
    assert l.ops[1].kind == OP_ICON;
    assert l.ops[1].arg == ICON_DOT;
    assert l.ops[2].arg == WEIGHT_ON;
}

test render_ops_are_object_relative {
    const l : OpList = render(create(true, 1, 200.0));
    assert l.ops[0].x == 0.0;
    assert l.ops[0].y == 0.0;
    assert l.ops[0].w == 60.0;
    assert l.ops[0].h == 44.0;
}

test render_alpha_comes_from_state {
    assert render(set_state(create(true, 0, 200.0), ST_DISABLED)).ops[0].alpha == ALPHA_DISABLED;
    assert render(set_state(create(true, 0, 200.0), ST_HOVER)).ops[0].alpha == ALPHA_HOVER;
    assert render(create(true, 0, 200.0)).ops[0].alpha == ALPHA_DEFAULT;
}

test hit_test_inside_and_outside {
    const c : ToggleConfig = create(false, 0, 200.0);
    assert hit_test(c, 0.0, 0.0);
    assert hit_test(c, 59.0, 43.0);
    assert hit_test(c, 60.0, 10.0) == false;
    assert hit_test(c, 10.0, 44.0) == false;
    assert hit_test(c, -1.0, 10.0) == false;
}

test hit_test_misses_when_not_interactive {
    assert hit_test(set_state(create(false, 0, 200.0), ST_DISABLED), 5.0, 5.0) == false;
    assert hit_test(set_state(create(false, 0, 200.0), ST_LOADING), 5.0, 5.0) == false;
}

test state_range_is_refused {
    const c : ToggleConfig = create(false, 0, 200.0);
    assert state_valid(0);
    assert state_valid(5);
    assert state_valid(6) == false;
    assert set_state(c, 6).state == ST_DEFAULT;
    assert set_state(c, 3).state == ST_FOCUS;
}

test every_non_default_state_adds_a_non_colour_cue {
    assert state_icon(ST_DEFAULT) == ICON_NONE;
    assert state_icon(ST_HOVER) != ICON_NONE;
    assert state_icon(ST_PRESSED) != ICON_NONE;
    assert state_icon(ST_FOCUS) != ICON_NONE;
    assert state_icon(ST_DISABLED) != ICON_NONE;
    assert state_icon(ST_LOADING) != ICON_NONE;
    assert state_icon(ST_HOVER) != state_icon(ST_PRESSED);
    assert state_icon(ST_FOCUS) != state_icon(ST_DISABLED);
    assert render(set_state(create(false, 0, 200.0), ST_FOCUS)).n == 3;
}

test theme_light_is_inverse_of_dark {
    assert token_lum(theme_token(0, ROLE_SURFACE)) + token_lum(theme_token(1, ROLE_SURFACE)) == 1.0;
    assert token_lum(theme_token(0, ROLE_INK)) + token_lum(theme_token(1, ROLE_INK)) == 1.0;
    assert token_lum(theme_token(0, ROLE_SURFACE)) == token_lum(theme_token(1, ROLE_INK));
    assert theme_token(0, ROLE_ACCENT) != theme_token(1, ROLE_ACCENT);
}

test a11y_name_per_variant {
    assert a11y_name(create(true, 0, 200.0)) == "God mode, on";
    assert a11y_name(create(false, 1, 200.0)) == "God mode, off";
}

test toggle_flips_unless_blocked {
    const c : ToggleConfig = create(false, 0, 200.0);
    assert toggle(c).on;
    assert toggle(toggle(c)).on == false;
    assert toggle(set_state(c, ST_DISABLED)).on == false;
}

test dispose_is_inert {
    const d : ToggleConfig = dispose(create(true, 0, 200.0));
    assert d.live == false;
    assert hit_test(d, 5.0, 5.0) == false;
    assert render(d).n == 0;
    assert toggle(d).on == false;
}

invariant on_differs_from_off_without_colour {
    // in every state the on render has one op more (the dot) than the off render, and a bolder label
    var s : u32 = 0;
    while (s < ST_COUNT) {
        const on : OpList = render(set_state(create(true, 0, 200.0), s));
        const off : OpList = render(set_state(create(false, 0, 200.0), s));
        assert on.n == off.n + 1;
        assert on.ops[1].arg == ICON_DOT;
        s = s + 1;
    }
    assert WEIGHT_ON > WEIGHT_OFF;
}
