// SPDX-License-Identifier: Apache-2.0
; specs/uikit/native_tokens.t27 -- f64 RGBA values derived from design_tokens.t27 for native (CG) renderers.
; design_tokens.t27 is the single source of truth for brand colors (hex strings).
; This module is its f64 counterpart: a change to the brand color requires a matching update here.
; Any native host that hardcodes a color triple duplicates this module -- import from here instead.
; Refs #13698, #13251.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_native_tokens;

; ── TH_T27 (dark) f64 RGBA -- derived from design_tokens.t27 TH_T27_* ────────
; TH_T27_BG  = "#000000"
pub const T27_BG_R : f64 = 0.0;
pub const T27_BG_G : f64 = 0.0;
pub const T27_BG_B : f64 = 0.0;
; TH_T27_TEXT = "#FFFFFF"
pub const T27_TEXT_R : f64 = 1.0;
pub const T27_TEXT_G : f64 = 1.0;
pub const T27_TEXT_B : f64 = 1.0;
; TH_T27_ACCENT = "#00FF88"  (0x00=0.0, 0xFF=1.0, 0x88=136/255~0.533)
pub const T27_ACCENT_R : f64 = 0.0;
pub const T27_ACCENT_G : f64 = 1.0;
pub const T27_ACCENT_B : f64 = 0.533;
; TH_T27_MUTED = "#888888"  (0x88/0xFF ~ 0.533)
pub const T27_MUTED_R : f64 = 0.533;
pub const T27_MUTED_G : f64 = 0.533;
pub const T27_MUTED_B : f64 = 0.533;

; ── Primary button: B&W brand ─────────────────────────────────────────────────
; TH_T27 (dark): fill = TH_T27_TEXT (#FFFFFF), label = TH_T27_BG (#000000)
; The fill is T27_TEXT_* at the per-state alpha below.
pub const BTN_FILL_R : f64 = T27_TEXT_R;
pub const BTN_FILL_G : f64 = T27_TEXT_G;
pub const BTN_FILL_B : f64 = T27_TEXT_B;
pub const BTN_LABEL_R : f64 = T27_BG_R;
pub const BTN_LABEL_G : f64 = T27_BG_G;
pub const BTN_LABEL_B : f64 = T27_BG_B;

; ── State alpha (opacity applied to fill; derived from stories.t27 comment) ───
; default:  opacity 1.0
; hover:    background TH_*_TEXT+"CC"  =>  0xCC/0xFF ~ 0.800
; active:   background TH_*_TEXT+"DD"  =>  0xDD/0xFF ~ 0.867
; disabled: opacity 0.4
pub const BTN_ALPHA_DEFAULT  : f64 = 1.0;
pub const BTN_ALPHA_HOVER    : f64 = 0.800;
pub const BTN_ALPHA_ACTIVE   : f64 = 0.867;
pub const BTN_ALPHA_DISABLED : f64 = 0.400;

; ── Badge: B&W brand (same inversion as button) ───────────────────────────────
pub const BADGE_FILL_R : f64 = T27_TEXT_R;
pub const BADGE_FILL_G : f64 = T27_TEXT_G;
pub const BADGE_FILL_B : f64 = T27_TEXT_B;
pub const BADGE_LABEL_R : f64 = T27_BG_R;
pub const BADGE_LABEL_G : f64 = T27_BG_G;
pub const BADGE_LABEL_B : f64 = T27_BG_B;

; ── Input: dark surface with accent border on focus ───────────────────────────
; TH_T27_SURFACE_INPUT = "#1A1A1A"  (0x1A/0xFF ~ 0.102)
pub const INPUT_BG_R : f64 = 0.102;
pub const INPUT_BG_G : f64 = 0.102;
pub const INPUT_BG_B : f64 = 0.102;
; border: muted by default (#FFFFFF at 0.3), accent on focus (#00FF88)
pub const INPUT_BORDER_DEFAULT_R : f64 = T27_TEXT_R;
pub const INPUT_BORDER_DEFAULT_G : f64 = T27_TEXT_G;
pub const INPUT_BORDER_DEFAULT_B : f64 = T27_TEXT_B;
pub const INPUT_BORDER_DEFAULT_A : f64 = 0.3;
pub const INPUT_BORDER_FOCUS_R : f64 = T27_ACCENT_R;
pub const INPUT_BORDER_FOCUS_G : f64 = T27_ACCENT_G;
pub const INPUT_BORDER_FOCUS_B : f64 = T27_ACCENT_B;
pub const INPUT_BORDER_FOCUS_A : f64 = 1.0;

; ── Geometry (from design_tokens.t27 BTN_* / BADGE_*) ────────────────────────
; BTN_MIN_HEIGHT = "44px"
pub const BTN_HEIGHT  : f64 = 44.0;
; BTN_BORDER_RADIUS = "999px" (pill)
pub const BTN_RADIUS  : f64 = 22.0;
; BTN_PADDING horizontal = "20px"
pub const BTN_PAD_H   : f64 = 20.0;
; badge: 26 px tall, pill radius
pub const BADGE_HEIGHT : f64 = 26.0;
pub const BADGE_RADIUS : f64 = 13.0;
; input: same height as button
pub const INPUT_HEIGHT : f64 = 44.0;
pub const INPUT_RADIUS : f64 = 6.0;

; ── Tests ─────────────────────────────────────────────────────────────────────
test brand_bw_exact {
    assert T27_BG_R   == 0.0;
    assert T27_BG_G   == 0.0;
    assert T27_BG_B   == 0.0;
    assert T27_TEXT_R == 1.0;
    assert T27_TEXT_G == 1.0;
    assert T27_TEXT_B == 1.0;
}

test button_fill_matches_text_token {
    assert BTN_FILL_R == T27_TEXT_R;
    assert BTN_FILL_G == T27_TEXT_G;
    assert BTN_FILL_B == T27_TEXT_B;
}

test state_alphas_ordered {
    assert BTN_ALPHA_DEFAULT  > BTN_ALPHA_HOVER;
    assert BTN_ALPHA_HOVER    < BTN_ALPHA_ACTIVE;
    assert BTN_ALPHA_DISABLED < BTN_ALPHA_HOVER;
    assert BTN_ALPHA_DEFAULT  > 0.0;
    assert BTN_ALPHA_DISABLED > 0.0;
}

test button_height_matches_design_tokens {
    assert BTN_HEIGHT == 44.0;
}

invariant badge_fill_matches_button_fill {
    assert BADGE_FILL_R == BTN_FILL_R;
    assert BADGE_FILL_G == BTN_FILL_G;
    assert BADGE_FILL_B == BTN_FILL_B;
}

invariant input_height_matches_button {
    assert INPUT_HEIGHT == BTN_HEIGHT;
}
