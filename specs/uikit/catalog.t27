// SPDX-License-Identifier: Apache-2.0
; specs/uikit/catalog.t27 -- canonical component/state indices for all UIKit hosts.
; Native (glass_window.t27) and Web (trinity UIKit.tsx) share these indices:
;   same COMP_* → same component family; same STATE_* → same interactive state.
; Any host that hardcodes a numeric component or state list duplicates this catalog --
;   import from here instead.
; Refs #13698, #13251.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_catalog;

use uikit_stories;
use uikit_stories_badge;

; ── Component indices (match TPG_UK_COMP in glass_window.t27) ────────────────
pub const COMP_BUTTON : u32 = 0;
pub const COMP_BADGE  : u32 = 1;
pub const COMP_INPUT  : u32 = 2;
pub const COMP_COUNT  : u32 = 3;

; ── State indices (match TPG_UK_STATE in glass_window.t27) ───────────────────
; Shared across all components; each component maps to its own story family.
pub const STATE_DEFAULT  : u32 = 0;
pub const STATE_HOVER    : u32 = 1;
pub const STATE_ACTIVE   : u32 = 2;
pub const STATE_DISABLED : u32 = 3;
pub const STATE_COUNT    : u32 = 4;

; ── Story IDs: button-primary family (aliased from uikit_stories) ─────────────
pub const STORY_BTN_DEFAULT  : str = STORY_BUTTON_PRIMARY_DEFAULT;
pub const STORY_BTN_HOVER    : str = STORY_BUTTON_PRIMARY_HOVER;
pub const STORY_BTN_ACTIVE   : str = STORY_BUTTON_PRIMARY_ACTIVE;
pub const STORY_BTN_DISABLED : str = STORY_BUTTON_PRIMARY_DISABLED;

; ── Story IDs: badge-primary family (aliased from uikit_stories_badge) ────────
pub const STORY_BADGE_DEFAULT  : str = STORY_BADGE_PRIMARY_DEFAULT;
pub const STORY_BADGE_HOVER    : str = STORY_BADGE_PRIMARY_HOVER;
pub const STORY_BADGE_ACTIVE   : str = STORY_BADGE_PRIMARY_ACTIVE;
pub const STORY_BADGE_DISABLED : str = STORY_BADGE_PRIMARY_DISABLED;

; ── Tests ─────────────────────────────────────────────────────────────────────
test component_indices_unique {
    assert COMP_BUTTON != COMP_BADGE;
    assert COMP_BADGE  != COMP_INPUT;
    assert COMP_BUTTON != COMP_INPUT;
    assert COMP_COUNT  == 3;
}

test state_indices_cover_all_story_states {
    assert STATE_COUNT    == 4;
    assert STATE_DEFAULT  == 0;
    assert STATE_HOVER    == 1;
    assert STATE_ACTIVE   == 2;
    assert STATE_DISABLED == 3;
}

test state_indices_unique {
    assert STATE_DEFAULT  != STATE_HOVER;
    assert STATE_HOVER    != STATE_ACTIVE;
    assert STATE_ACTIVE   != STATE_DISABLED;
    assert STATE_DEFAULT  != STATE_DISABLED;
}

invariant button_stories_round_trip {
    assert STORY_BTN_DEFAULT  == STORY_BUTTON_PRIMARY_DEFAULT;
    assert STORY_BTN_HOVER    == STORY_BUTTON_PRIMARY_HOVER;
    assert STORY_BTN_ACTIVE   == STORY_BUTTON_PRIMARY_ACTIVE;
    assert STORY_BTN_DISABLED == STORY_BUTTON_PRIMARY_DISABLED;
}

invariant badge_stories_round_trip {
    assert STORY_BADGE_DEFAULT  == STORY_BADGE_PRIMARY_DEFAULT;
    assert STORY_BADGE_HOVER    == STORY_BADGE_PRIMARY_HOVER;
    assert STORY_BADGE_ACTIVE   == STORY_BADGE_PRIMARY_ACTIVE;
    assert STORY_BADGE_DISABLED == STORY_BADGE_PRIMARY_DISABLED;
}

invariant state_default_is_zero {
    assert STATE_DEFAULT == 0;
}
