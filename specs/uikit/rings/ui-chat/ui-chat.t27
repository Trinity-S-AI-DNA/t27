// SPDX-License-Identifier: Apache-2.0
; specs/uikit/rings/ui-chat/ui-chat.t27 -- DRAFT contract of ring ui-chat (UR-03-UI-CHAT).
; Owner decision 2026-11-16: APPROVED_AS_CANDIDATE; order UI_CHAT_RING_V0 (draft only).
; A reusable conversational assistant UI module for any T27 application.
; NOT Secure Chat, NOT the trios-chat port (#8882 #8884 #8887 #8888 #11994-#11997).
; Sources: Trinity-S-AI-DNA/trios AGENTS.md:87-111, plans/trios-ui-plan.md:15,30;
; full table in docs/t27/rings-source-rules.md. Anything else is NOT_FOUND_IN_SOURCE.
; Reuses UI Kit and T27F primitives only; defines no new widget.
; Avatar rule (owner): no ring and no outline around the avatar, in any state.
; PURE: no fetch, no file, no window pixels.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_rings_ui_chat;
use uikit::avatar::AV_ST_COUNT;
use uikit::avatar::AV_VAR_COUNT;
use uikit::avatar::AV_SIZE_M;
use uikit::avatar::AV_THEME_LIGHT;
use uikit::avatar::AV_ROLE_LINE;
use uikit::avatar::AvCfg;
use uikit::avatar::AvDraw;
use uikit::avatar::av_create;
use uikit::avatar::av_set_state;
use uikit::avatar::av_render;
use uikit::text::TX_BODY;
use uikit::text::TX_CAPTION;
use uikit::card::CARD_RADIUS;
use uikit::input_model::IM_MAX_UNITS;
use t27f::live_chat::CK_USER;
use t27f::live_chat::CK_TOKEN;
use t27f::live_chat::CK_DONE;
use t27f::live_chat::CK_KINDS;
use t27f::live_chat::MAX_MSG;
use t27f::live_chat::PANEL_MESSAGES;

; ---- Identity (trios AGENTS.md:98-101, plans/trios-ui-plan.md:15) ----------------------
pub const RING_NAME : str = "ui-chat";
pub const RING_FAMILY : str = "UR";
pub const RING_ID : str = "UR-03-UI-CHAT";
pub const RING_NUMBER : u32 = 3;

; ---- Rule status ------------------------------------------------------------------------
pub const ST_CONFIRMED : u32 = 0;
pub const ST_NOT_FOUND_IN_SOURCE : u32 = 1;
pub const ST_OWNER_DECISION_REQUIRED : u32 = 2;
pub const ST_FORBIDDEN : u32 = 3;
pub const ST_COUNT : u32 = 4;

; ---- Ring documents (trios AGENTS.md:87-96, I5) -----------------------------------------
pub const DOC_README : u32 = 0;
pub const DOC_TASK : u32 = 1;
pub const DOC_AGENTS : u32 = 2;
pub const DOC_COUNT : u32 = 3;

; ---- Features and their status ----------------------------------------------------------
pub const F_MESSAGES : u32 = 0;          // live_chat stream, CONFIRMED (trios-ui-plan.md:15)
pub const F_INPUT : u32 = 1;             // uikit_input_model, CONFIRMED (trios-ui-plan.md:15)
pub const F_AVATAR : u32 = 2;            // uikit_avatar, CONFIRMED (existing primitive)
pub const F_PARTNER_PROFILE : u32 = 3;   // OWNER_DECISION_REQUIRED (placeholder only)
pub const F_MANAGER_AVATAR : u32 = 4;    // OWNER_DECISION_REQUIRED
pub const F_AVATAR_ANIMATION : u32 = 5;  // OWNER_DECISION_REQUIRED (needs owner contract)
pub const F_PAYMENT : u32 = 6;           // FORBIDDEN without separate approval
pub const F_TELEGRAM : u32 = 7;          // OWNER_DECISION_REQUIRED; contact channel only
pub const F_PUBLICATION : u32 = 8;       // OWNER_DECISION_REQUIRED
pub const F_RING_MANIFEST : u32 = 9;     // NOT_FOUND_IN_SOURCE
pub const F_PRESENCE_STATES : u32 = 10;  // NOT_FOUND_IN_SOURCE
pub const F_RING_VR_SCHEMA : u32 = 11;   // NOT_FOUND_IN_SOURCE
pub const F_T27L_RING_SCHEMA : u32 = 12; // NOT_FOUND_IN_SOURCE
pub const F_COUNT : u32 = 13;

pub fn feature_status(f: u32) -> u32 {
    if (f <= F_AVATAR) { return ST_CONFIRMED; }
    if (f == F_PAYMENT) { return ST_FORBIDDEN; }
    if (f <= F_PUBLICATION) { return ST_OWNER_DECISION_REQUIRED; }
    return ST_NOT_FOUND_IN_SOURCE;
}

; A feature may be built only when its status is CONFIRMED.
pub fn feature_allowed(f: u32) -> bool {
    if (f >= F_COUNT) { return false; }
    return feature_status(f) == ST_CONFIRMED;
}

; ---- Partner profile placeholder (owner: status only, no data) --------------------------
pub struct PartnerProfile {
    status: u32,
}

pub fn partner_profile() -> PartnerProfile {
    return PartnerProfile { status: ST_OWNER_DECISION_REQUIRED };
}

; ---- Actions -----------------------------------------------------------------------------
pub const A_SEND : u32 = 0;     // live_chat ACTION_SEND
pub const A_PAY : u32 = 1;      // FORBIDDEN
pub const A_TELEGRAM : u32 = 2; // OWNER_DECISION_REQUIRED
pub const A_PUBLISH : u32 = 3;  // OWNER_DECISION_REQUIRED
pub const A_COUNT : u32 = 4;

pub fn action_allowed(a: u32) -> bool {
    return a == A_SEND;
}

; ---- Avatar: the uikit_avatar states, nothing added -------------------------------------
pub const UC_AVATAR_STATES : u32 = AV_ST_COUNT;

pub fn avatar_state_ok(s: u32) -> bool {
    return s < UC_AVATAR_STATES;
}

; ---- Message rows: live_chat kinds, uikit_text styles, uikit_card bubble ---------------
pub fn row_text_style(kind: u8) -> u8 {
    if (kind == CK_DONE) { return TX_CAPTION; }
    return TX_BODY;
}

pub const UC_BUBBLE_RADIUS : f64 = CARD_RADIUS;
pub const UC_PANEL_ROWS : u32 = PANEL_MESSAGES;
pub const UC_MAX_MSG : u32 = MAX_MSG;
pub const UC_INPUT_UNITS : u32 = IM_MAX_UNITS;

; ---- Tests (L4) --------------------------------------------------------------------------
test identity_is_ur_03 {
    assert RING_NUMBER == 3;
    assert DOC_COUNT == 3;
}

test only_confirmed_features_are_allowed {
    assert feature_allowed(F_MESSAGES);
    assert feature_allowed(F_INPUT);
    assert feature_allowed(F_AVATAR);
    var f : u32 = F_PARTNER_PROFILE;
    while (f < F_COUNT) {
        assert !feature_allowed(f);
        f = f + 1;
    }
    assert !feature_allowed(F_COUNT);
}

test owner_decisions_and_not_found_are_marked {
    assert feature_status(F_PARTNER_PROFILE) == ST_OWNER_DECISION_REQUIRED;
    assert feature_status(F_MANAGER_AVATAR) == ST_OWNER_DECISION_REQUIRED;
    assert feature_status(F_AVATAR_ANIMATION) == ST_OWNER_DECISION_REQUIRED;
    assert feature_status(F_TELEGRAM) == ST_OWNER_DECISION_REQUIRED;
    assert feature_status(F_PUBLICATION) == ST_OWNER_DECISION_REQUIRED;
    assert feature_status(F_PAYMENT) == ST_FORBIDDEN;
    assert feature_status(F_RING_MANIFEST) == ST_NOT_FOUND_IN_SOURCE;
    assert feature_status(F_PRESENCE_STATES) == ST_NOT_FOUND_IN_SOURCE;
    assert feature_status(F_RING_VR_SCHEMA) == ST_NOT_FOUND_IN_SOURCE;
    assert feature_status(F_T27L_RING_SCHEMA) == ST_NOT_FOUND_IN_SOURCE;
}

test partner_profile_is_a_placeholder {
    const p : PartnerProfile = partner_profile();
    assert p.status == ST_OWNER_DECISION_REQUIRED;
}

test only_send_is_an_allowed_action {
    assert action_allowed(A_SEND);
    assert !action_allowed(A_PAY);
    assert !action_allowed(A_TELEGRAM);
    assert !action_allowed(A_PUBLISH);
}

test avatar_states_are_the_uikit_states_only {
    assert UC_AVATAR_STATES == 6;
    assert avatar_state_ok(5);
    assert !avatar_state_ok(6);
}

test avatar_has_no_ring_and_no_outline_in_any_state {
    var v : u32 = 0;
    while (v < AV_VAR_COUNT) {
        var s : u32 = 0;
        while (s < UC_AVATAR_STATES) {
            var c : AvCfg = av_create(v, AV_SIZE_M, AV_THEME_LIGHT, true, "Assistant", 9);
            c = av_set_state(c, s);
            const d : AvDraw = av_render(c);
            var i : u32 = 0;
            while (i < d.n) {
                assert d.role[i] != AV_ROLE_LINE;
                i = i + 1;
            }
            s = s + 1;
        }
        v = v + 1;
    }
}

test rows_reuse_live_chat_kinds_and_text_styles {
    assert CK_KINDS == 3;
    assert row_text_style(CK_USER) == TX_BODY;
    assert row_text_style(CK_TOKEN) == TX_BODY;
    assert row_text_style(CK_DONE) == TX_CAPTION;
    assert UC_BUBBLE_RADIUS == 8.0;
    assert UC_PANEL_ROWS == 12;
    assert UC_MAX_MSG == 512;
    assert UC_INPUT_UNITS == 24;
}
