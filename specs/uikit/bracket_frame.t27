// SPDX-License-Identifier: Apache-2.0
; specs/uikit/bracket_frame.t27 -- UI Kit object BracketFrame (epic #13426, M1 Wave 1, issue #13770).
; Four corner brackets (L-shaped line pairs, role line) around a box. Arm length and stroke come
; from tokens; the focus state thickens the stroke. The a11y name is the framed region name.
; Ops are relative to the object's own 0,0; colours are ROLE names, never literals.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_bracket_frame;

use uikit_design_tokens;

// ---- Tokens ---------------------------------------------------------------------------------
// PROPOSED TOKEN: no arm-length or stroke token exists in design_tokens / native_tokens.
// BF_ARM_MD mirrors SPACE_LG (16px); the others are the size ladder around it.
pub const BF_ARM_SM : u32 = 8;       // PROPOSED TOKEN
pub const BF_ARM_MD : u32 = 16;      // PROPOSED TOKEN (= SPACE_LG)
pub const BF_ARM_LG : u32 = 24;      // PROPOSED TOKEN
pub const BF_STROKE : u32 = 1;       // PROPOSED TOKEN
pub const BF_STROKE_FOCUS : u32 = 2; // PROPOSED TOKEN
pub const BF_ARM_HOVER_GROW : u32 = 4;   // PROPOSED TOKEN
pub const BF_ARM_PRESS_SHRINK : u32 = 4; // PROPOSED TOKEN

// ---- Roles, themes, states, ops --------------------------------------------------------------
pub const ROLE_SURFACE : u8 = 0;
pub const ROLE_INK : u8 = 1;
pub const ROLE_ACCENT : u8 = 2;
pub const ROLE_DANGER : u8 = 3;
pub const ROLE_SUCCESS : u8 = 4;
pub const ROLE_LINE : u8 = 5;
pub const ROLE_COUNT : u8 = 6;

pub const THEME_DARK : u8 = 0;
pub const THEME_LIGHT : u8 = 1;

pub const ST_DEFAULT : u8 = 0;
pub const ST_HOVER : u8 = 1;
pub const ST_PRESSED : u8 = 2;
pub const ST_FOCUS : u8 = 3;
pub const ST_DISABLED : u8 = 4;
pub const ST_LOADING : u8 = 5;
pub const ST_COUNT : u8 = 6;

pub const OP_NONE : u8 = 0;
pub const OP_LINE : u8 = 1;
pub const BF_MAX_OPS : u32 = 8;

// Line pattern: a non-colour state cue for disabled and loading.
pub const PAT_SOLID : u8 = 0;
pub const PAT_DASHED : u8 = 1;
pub const PAT_DOTTED : u8 = 2;

pub const SIZE_SM : u8 = 0;
pub const SIZE_MD : u8 = 1;
pub const SIZE_LG : u8 = 2;

pub const BF_NAME_FALLBACK : str = "Framed region";

// ---- Config and object -----------------------------------------------------------------------
pub struct BfConfig {
    size: u8,
    box_w: u32,
    box_h: u32,
    name: str,
}

pub struct BfObject {
    size: u8,
    box_w: u32,
    box_h: u32,
    name: str,
    state: u8,
    theme: u8,
    disposed: bool,
    refusals: u32,
}

pub struct BfRender {
    count: u32,
    kind: [8]u8,
    role: [8]u8,
    x0: [8]u32,
    y0: [8]u32,
    x1: [8]u32,
    y1: [8]u32,
    width: [8]u32,
    alpha: [8]u32,
    pattern: u8,
}

pub struct BfSize {
    w: u32,
    h: u32,
}

pub fn bf_config(size: u8, box_w: u32, box_h: u32, name: str) -> BfConfig {
    return BfConfig { size: size, box_w: box_w, box_h: box_h, name: name };
}

pub fn bf_create(c: BfConfig) -> BfObject {
    var s : u8 = c.size;
    if (s > SIZE_LG) {
        s = SIZE_MD;
    }
    return BfObject { size: s, box_w: c.box_w, box_h: c.box_h, name: c.name, state: ST_DEFAULT, theme: THEME_DARK, disposed: false, refusals: 0 };
}

// ---- State (out of range is refused) ---------------------------------------------------------
pub fn bf_state_ok(s: u8) -> bool {
    return s < ST_COUNT;
}

pub fn bf_set_state(o: BfObject, s: u8) -> BfObject {
    var n : BfObject = o;
    if (o.disposed) {
        return o;
    }
    if (bf_state_ok(s)) {
        n.state = s;
    } else {
        n.refusals = o.refusals + 1;
    }
    return n;
}

// ---- Theme: Light is the inverse of Dark for surface and ink ---------------------------------
pub fn bf_theme_role(theme: u8, role: u8) -> u8 {
    return uikit_swap_role_for_theme(theme as u32, role as u32) as u8;
}

pub fn bf_set_theme(o: BfObject, theme: u8) -> BfObject {
    var n : BfObject = o;
    if (theme <= THEME_LIGHT and o.disposed == false) {
        n.theme = theme;
    }
    return n;
}

// ---- Layout ----------------------------------------------------------------------------------
pub fn bf_base_arm(size: u8) -> u32 {
    if (size == SIZE_SM) {
        return BF_ARM_SM;
    }
    if (size == SIZE_LG) {
        return BF_ARM_LG;
    }
    return BF_ARM_MD;
}

// Arm for a state, never longer than half of the shorter box side.
pub fn bf_arm(o: BfObject) -> u32 {
    var a : u32 = bf_base_arm(o.size);
    if (o.state == ST_HOVER) {
        a = a + BF_ARM_HOVER_GROW;
    }
    if (o.state == ST_PRESSED and a > BF_ARM_PRESS_SHRINK) {
        a = a - BF_ARM_PRESS_SHRINK;
    }
    var short : u32 = o.box_w;
    if (o.box_h < short) {
        short = o.box_h;
    }
    let cap : u32 = short / 2;
    if (a > cap) {
        a = cap;
    }
    return a;
}

pub fn bf_stroke(o: BfObject) -> u32 {
    if (o.state == ST_FOCUS) {
        return BF_STROKE_FOCUS;
    }
    return BF_STROKE;
}

pub fn bf_alpha(state: u8) -> u32 {
    if (state == ST_HOVER) {
        return 80;
    }
    if (state == ST_PRESSED) {
        return 90;
    }
    if (state == ST_DISABLED) {
        return 40;
    }
    if (state == ST_LOADING) {
        return 60;
    }
    return 100;
}

pub fn bf_pattern(state: u8) -> u8 {
    if (state == ST_DISABLED) {
        return PAT_DASHED;
    }
    if (state == ST_LOADING) {
        return PAT_DOTTED;
    }
    return PAT_SOLID;
}

// Own size: the box width limited by avail_w, the box height as given; token arms only.
pub fn bf_measure(o: BfObject, avail_w: u32) -> BfSize {
    if (o.disposed) {
        return BfSize { w: 0, h: 0 };
    }
    var w : u32 = o.box_w;
    if (avail_w < w) {
        w = avail_w;
    }
    return BfSize { w: w, h: o.box_h };
}

// ---- Render: eight line ops, relative to the object's own 0,0 --------------------------------
pub fn bf_blank() -> BfRender {
    return BfRender { count: 0, kind: [0; 8], role: [0; 8], x0: [0; 8], y0: [0; 8], x1: [0; 8], y1: [0; 8], width: [0; 8], alpha: [0; 8], pattern: 0 };
}

pub fn bf_push(r: BfRender, role: u8, x0: u32, y0: u32, x1: u32, y1: u32, width: u32, alpha: u32) -> BfRender {
    var n : BfRender = r;
    if (n.count < BF_MAX_OPS) {
        let k : usize = n.count as usize;
        n.kind[k] = OP_LINE;
        n.role[k] = role;
        n.x0[k] = x0;
        n.y0[k] = y0;
        n.x1[k] = x1;
        n.y1[k] = y1;
        n.width[k] = width;
        n.alpha[k] = alpha;
        n.count = n.count + 1;
    }
    return n;
}

pub fn bf_render(o: BfObject, avail_w: u32) -> BfRender {
    var r : BfRender = bf_blank();
    if (o.disposed) {
        return r;
    }
    let sz : BfSize = bf_measure(o, avail_w);
    let w : u32 = sz.w;
    let h : u32 = sz.h;
    var a : u32 = bf_arm(o);
    if (a > w / 2) {
        a = w / 2;
    }
    let sw : u32 = bf_stroke(o);
    let al : u32 = bf_alpha(o.state);
    let rl : u8 = bf_theme_role(o.theme, ROLE_LINE);
    r.pattern = bf_pattern(o.state);
    // top-left
    r = bf_push(r, rl, 0, 0, a, 0, sw, al);
    r = bf_push(r, rl, 0, 0, 0, a, sw, al);
    // top-right
    r = bf_push(r, rl, w - a, 0, w, 0, sw, al);
    r = bf_push(r, rl, w, 0, w, a, sw, al);
    // bottom-left
    r = bf_push(r, rl, 0, h, a, h, sw, al);
    r = bf_push(r, rl, 0, h - a, 0, h, sw, al);
    // bottom-right
    r = bf_push(r, rl, w - a, h, w, h, sw, al);
    r = bf_push(r, rl, w, h - a, w, h, sw, al);
    return r;
}

// ---- Hit test: relative to the object's own box ----------------------------------------------
pub fn bf_hit_test(o: BfObject, x: u32, y: u32, avail_w: u32) -> bool {
    if (o.disposed) {
        return false;
    }
    let sz : BfSize = bf_measure(o, avail_w);
    return x < sz.w and y < sz.h;
}

// ---- a11y: the framed region name; the state has a non-colour cue ----------------------------
pub fn bf_a11y_name(o: BfObject) -> str {
    if (o.name.len == 0) {
        return BF_NAME_FALLBACK;
    }
    return o.name;
}

// True when a state differs from default in stroke, pattern or arm, not only in colour.
pub fn bf_has_non_colour_cue(o: BfObject) -> bool {
    var d : BfObject = o;
    d.state = ST_DEFAULT;
    return bf_stroke(o) != bf_stroke(d) or bf_pattern(o.state) != bf_pattern(ST_DEFAULT) or bf_arm(o) != bf_arm(d);
}

// ---- Dispose: back to an inert state ---------------------------------------------------------
pub fn bf_dispose(o: BfObject) -> BfObject {
    return BfObject { size: SIZE_MD, box_w: 0, box_h: 0, name: "", state: ST_DEFAULT, theme: THEME_DARK, disposed: true, refusals: o.refusals };
}

// ---- Tests -----------------------------------------------------------------------------------
test create_defaults_and_clamps_size {
    let o : BfObject = bf_create(bf_config(SIZE_LG, 200, 120, "Queen panel"));
    assert o.state == ST_DEFAULT;
    assert o.theme == THEME_DARK;
    assert o.size == SIZE_LG;
    assert o.disposed == false;
    let p : BfObject = bf_create(bf_config(9, 200, 120, "x"));
    assert p.size == SIZE_MD;
}

test measure_limits_width_by_avail_and_keeps_height {
    let o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    assert bf_measure(o, 500).w == 200;
    assert bf_measure(o, 150).w == 150;
    assert bf_measure(o, 150).h == 120;
}

test render_emits_eight_line_ops_in_role_line {
    let o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    let r : BfRender = bf_render(o, 200);
    assert r.count == 8;
    assert r.kind[0] == OP_LINE;
    assert r.role[0] == ROLE_LINE;
    assert r.role[7] == ROLE_LINE;
    assert r.width[0] == BF_STROKE;
    assert r.alpha[0] == 100;
}

test render_ops_stay_inside_the_own_box {
    let o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    let r : BfRender = bf_render(o, 200);
    assert r.x1[0] == 16;
    assert r.y1[1] == 16;
    assert r.x0[2] == 184;
    assert r.x1[3] == 200;
    assert r.y0[5] == 104;
    assert r.y1[7] == 120;
}

test arm_comes_from_the_size_token {
    assert bf_arm(bf_create(bf_config(SIZE_SM, 200, 120, "a"))) == BF_ARM_SM;
    assert bf_arm(bf_create(bf_config(SIZE_MD, 200, 120, "a"))) == BF_ARM_MD;
    assert bf_arm(bf_create(bf_config(SIZE_LG, 200, 120, "a"))) == BF_ARM_LG;
}

test arm_never_exceeds_half_the_short_side {
    let o : BfObject = bf_create(bf_config(SIZE_LG, 20, 200, "tiny"));
    assert bf_arm(o) == 10;
}

test focus_thickens_the_stroke {
    var o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    o = bf_set_state(o, ST_FOCUS);
    assert bf_stroke(o) == BF_STROKE_FOCUS;
    assert bf_render(o, 200).width[0] == BF_STROKE_FOCUS;
    assert BF_STROKE_FOCUS > BF_STROKE;
}

test state_alphas_come_from_the_state {
    assert bf_alpha(ST_DEFAULT) == 100;
    assert bf_alpha(ST_HOVER) == 80;
    assert bf_alpha(ST_DISABLED) == 40;
    assert bf_alpha(ST_LOADING) == 60;
}

test out_of_range_state_is_refused {
    var o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    o = bf_set_state(o, ST_HOVER);
    o = bf_set_state(o, 6);
    assert o.state == ST_HOVER;
    assert o.refusals == 1;
    assert bf_state_ok(6) == false;
    assert bf_state_ok(5);
}

test hit_test_is_relative_to_the_own_box {
    let o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    assert bf_hit_test(o, 0, 0, 200);
    assert bf_hit_test(o, 199, 119, 200);
    assert bf_hit_test(o, 200, 10, 200) == false;
    assert bf_hit_test(o, 10, 120, 200) == false;
}

test light_theme_inverts_surface_and_ink {
    assert bf_theme_role(THEME_DARK, ROLE_SURFACE) == ROLE_SURFACE;
    assert bf_theme_role(THEME_LIGHT, ROLE_SURFACE) == ROLE_INK;
    assert bf_theme_role(THEME_LIGHT, ROLE_INK) == ROLE_SURFACE;
    assert bf_theme_role(THEME_LIGHT, ROLE_LINE) == ROLE_LINE;
    var o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "a"));
    o = bf_set_theme(o, THEME_LIGHT);
    assert o.theme == THEME_LIGHT;
}

test a11y_name_is_the_region_name_and_never_empty {
    let o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    assert bf_a11y_name(o).len == 11;
    let e : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, ""));
    assert bf_a11y_name(e).len > 0;
}

test every_non_default_state_has_a_non_colour_cue {
    var s : u8 = 1;
    while (s < ST_COUNT) {
        var o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
        o = bf_set_state(o, s);
        assert bf_has_non_colour_cue(o);
        s = s + 1;
    }
}

test dispose_is_inert_and_misses {
    var o : BfObject = bf_create(bf_config(SIZE_MD, 200, 120, "Queen panel"));
    o = bf_dispose(o);
    assert o.disposed;
    assert bf_hit_test(o, 0, 0, 200) == false;
    assert bf_render(o, 200).count == 0;
    assert bf_measure(o, 200).w == 0;
    assert bf_set_state(o, ST_FOCUS).state == ST_DEFAULT;
}

invariant render_never_exceeds_the_op_bound {
    let o : BfObject = bf_create(bf_config(SIZE_LG, 40, 30, "a"));
    assert bf_render(o, 40).count <= BF_MAX_OPS;
    assert ROLE_COUNT == 6;
    assert ST_COUNT == 6;
}
