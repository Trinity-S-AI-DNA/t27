// SPDX-License-Identifier: Apache-2.0
; specs/uikit/control_center.t27 -- UI KIT CONTROL CENTER shell (petal F, tab AGENT).
; State and layout of Catalog, Live Preview and Inspector. Pure u32 functions: no drawing,
; no colour literal, no pixel constant. A refused input returns CC_REFUSED, never a clamp.
; Closes #13768, epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_control_center;

pub const CC_REFUSED : u32 = 4294967295;
pub const CC_ROWS : u32 = 23;

pub const CC_STATE_DEFAULT  : u32 = 0;
pub const CC_STATE_HOVER    : u32 = 1;
pub const CC_STATE_PRESSED  : u32 = 2;
pub const CC_STATE_FOCUS    : u32 = 3;
pub const CC_STATE_DISABLED : u32 = 4;
pub const CC_STATE_LOADING  : u32 = 5;
pub const CC_STATE_COUNT    : u32 = 6;

pub const CC_THEME_DARK   : u32 = 0;
pub const CC_THEME_LIGHT  : u32 = 1;
pub const CC_THEME_SYSTEM : u32 = 2;
pub const CC_THEME_COUNT  : u32 = 3;

pub const CC_WIDTH_NARROW : u32 = 0;
pub const CC_WIDTH_WIDE   : u32 = 1;

pub const CC_COL_CATALOG   : u32 = 0;
pub const CC_COL_PREVIEW   : u32 = 1;
pub const CC_COL_INSPECTOR : u32 = 2;
pub const CC_COL_COUNT     : u32 = 3;

; Grid is 12 columns; wide splits 3 / 6 / 3, narrow gives each column the full 12.
pub const CC_GRID : u32 = 12;

/// The selected row after select(row); CC_REFUSED when row is outside 0..22.
pub fn cc_select(row: u32) -> u32 {
    if (row >= CC_ROWS) { return CC_REFUSED; }
    return row;
}

/// The state after set_state(s); CC_REFUSED when s is outside 0..5.
pub fn cc_set_state(s: u32) -> u32 {
    if (s >= CC_STATE_COUNT) { return CC_REFUSED; }
    return s;
}

/// The theme after toggle: dark and light flip, system stays system.
pub fn cc_toggle_theme(theme: u32) -> u32 {
    if (theme == CC_THEME_DARK) { return CC_THEME_LIGHT; }
    if (theme == CC_THEME_LIGHT) { return CC_THEME_DARK; }
    return theme;
}

/// The theme after set_theme(t); CC_REFUSED when t is outside 0..2.
pub fn cc_set_theme(t: u32) -> u32 {
    if (t >= CC_THEME_COUNT) { return CC_REFUSED; }
    return t;
}

/// Grid columns a panel spans (out of CC_GRID); CC_REFUSED for an unknown column or width class.
pub fn cc_col_span(width_class: u32, col: u32) -> u32 {
    if (col >= CC_COL_COUNT) { return CC_REFUSED; }
    if (width_class == CC_WIDTH_NARROW) { return CC_GRID; }
    if (width_class == CC_WIDTH_WIDE) {
        if (col == CC_COL_PREVIEW) { return 6; }
        return 3;
    }
    return CC_REFUSED;
}

/// First grid column of a panel: wide places them side by side, narrow starts every one at 0.
pub fn cc_col_start(width_class: u32, col: u32) -> u32 {
    if (col >= CC_COL_COUNT) { return CC_REFUSED; }
    if (width_class == CC_WIDTH_NARROW) { return 0; }
    if (width_class == CC_WIDTH_WIDE) {
        if (col == CC_COL_CATALOG) { return 0; }
        if (col == CC_COL_PREVIEW) { return 3; }
        return 9;
    }
    return CC_REFUSED;
}

/// Stack row of a panel: narrow stacks catalog, preview, inspector by column index; wide uses row 0.
pub fn cc_col_row(width_class: u32, col: u32) -> u32 {
    if (col >= CC_COL_COUNT) { return CC_REFUSED; }
    if (width_class == CC_WIDTH_NARROW) { return col; }
    if (width_class == CC_WIDTH_WIDE) { return 0; }
    return CC_REFUSED;
}

test select_accepts_0_to_22 {
    assert cc_select(0) == 0;
    assert cc_select(22) == 22;
    assert cc_select(7) == 7;
}

test select_refuses_outside_range {
    assert cc_select(23) == CC_REFUSED;
    assert cc_select(24) == CC_REFUSED;
    assert cc_select(4294967294) == CC_REFUSED;
}

test set_state_accepts_0_to_5 {
    assert cc_set_state(0) == 0;
    assert cc_set_state(3) == 3;
    assert cc_set_state(5) == 5;
    assert CC_STATE_LOADING == 5;
}

test set_state_refuses_outside_range {
    assert cc_set_state(6) == CC_REFUSED;
    assert cc_set_state(100) == CC_REFUSED;
}

test toggle_theme_flips_dark_and_light {
    assert cc_toggle_theme(CC_THEME_DARK) == CC_THEME_LIGHT;
    assert cc_toggle_theme(CC_THEME_LIGHT) == CC_THEME_DARK;
}

test toggle_theme_twice_returns_start {
    assert cc_toggle_theme(cc_toggle_theme(CC_THEME_DARK)) == CC_THEME_DARK;
    assert cc_toggle_theme(cc_toggle_theme(CC_THEME_LIGHT)) == CC_THEME_LIGHT;
}

test toggle_theme_system_stays_until_set {
    assert cc_toggle_theme(CC_THEME_SYSTEM) == CC_THEME_SYSTEM;
    assert cc_toggle_theme(cc_toggle_theme(CC_THEME_SYSTEM)) == CC_THEME_SYSTEM;
    assert cc_set_theme(CC_THEME_SYSTEM) == CC_THEME_SYSTEM;
    assert cc_set_theme(CC_THEME_LIGHT) == CC_THEME_LIGHT;
    assert cc_set_theme(3) == CC_REFUSED;
}

test wide_split_is_3_6_3_of_12 {
    assert cc_col_span(CC_WIDTH_WIDE, CC_COL_CATALOG) == 3;
    assert cc_col_span(CC_WIDTH_WIDE, CC_COL_PREVIEW) == 6;
    assert cc_col_span(CC_WIDTH_WIDE, CC_COL_INSPECTOR) == 3;
    assert cc_col_span(CC_WIDTH_WIDE, 0) + cc_col_span(CC_WIDTH_WIDE, 1) + cc_col_span(CC_WIDTH_WIDE, 2) == CC_GRID;
}

test wide_columns_sit_side_by_side {
    assert cc_col_start(CC_WIDTH_WIDE, CC_COL_CATALOG) == 0;
    assert cc_col_start(CC_WIDTH_WIDE, CC_COL_PREVIEW) == 3;
    assert cc_col_start(CC_WIDTH_WIDE, CC_COL_INSPECTOR) == 9;
    assert cc_col_row(CC_WIDTH_WIDE, CC_COL_CATALOG) == 0;
    assert cc_col_row(CC_WIDTH_WIDE, CC_COL_INSPECTOR) == 0;
}

test narrow_stacks_catalog_preview_inspector {
    assert cc_col_span(CC_WIDTH_NARROW, CC_COL_CATALOG) == 12;
    assert cc_col_span(CC_WIDTH_NARROW, CC_COL_PREVIEW) == 12;
    assert cc_col_span(CC_WIDTH_NARROW, CC_COL_INSPECTOR) == 12;
    assert cc_col_start(CC_WIDTH_NARROW, CC_COL_INSPECTOR) == 0;
    assert cc_col_row(CC_WIDTH_NARROW, CC_COL_CATALOG) == 0;
    assert cc_col_row(CC_WIDTH_NARROW, CC_COL_PREVIEW) == 1;
    assert cc_col_row(CC_WIDTH_NARROW, CC_COL_INSPECTOR) == 2;
}

test layout_refuses_unknown_column_or_width {
    assert cc_col_span(CC_WIDTH_WIDE, 3) == CC_REFUSED;
    assert cc_col_start(CC_WIDTH_NARROW, 3) == CC_REFUSED;
    assert cc_col_row(CC_WIDTH_NARROW, 3) == CC_REFUSED;
    assert cc_col_span(2, CC_COL_CATALOG) == CC_REFUSED;
    assert cc_col_start(2, CC_COL_CATALOG) == CC_REFUSED;
    assert cc_col_row(2, CC_COL_CATALOG) == CC_REFUSED;
}

invariant wide_spans_always_fill_grid {
    assert cc_col_start(CC_WIDTH_WIDE, 1) == cc_col_span(CC_WIDTH_WIDE, 0);
    assert cc_col_start(CC_WIDTH_WIDE, 2) == cc_col_span(CC_WIDTH_WIDE, 0) + cc_col_span(CC_WIDTH_WIDE, 1);
}
