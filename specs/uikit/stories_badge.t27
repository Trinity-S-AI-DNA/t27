// SPDX-License-Identifier: Apache-2.0
; specs/uikit/stories_badge.t27 -- Badge Primary story IDs for UIKit Wave 1.
; Rendered live at https://t27.ai/#/uikit (trinity/apps/website/src/pages/UIKit.tsx).
; Interaction runner: hover, click, focus -- Steps panel fires against data-state DOM attr.
; Refs #13698.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stories_badge;

use uikit_design_tokens;

; ── Badge Primary -- four interactive states ─────────────────────────────────
; Render method: live <span> DOM element with data-testid and data-state attrs.
; Theme: TH_T27 (dark) or TH_PAPER (light) -- switched without reload.
; States: default, hover, active, disabled.
; InteractiveBadge: React component with onMouseEnter/Leave/Down/Up/Focus/Blur.

pub const STORY_BADGE_PRIMARY_DEFAULT  : str = "badge-primary";
pub const STORY_BADGE_PRIMARY_HOVER    : str = "badge-primary-hover";
pub const STORY_BADGE_PRIMARY_ACTIVE   : str = "badge-primary-active";
pub const STORY_BADGE_PRIMARY_DISABLED : str = "badge-primary-disabled";
pub const STORY_BADGE_SECONDARY        : str = "badge-secondary";
pub const STORY_BADGE_SUCCESS          : str = "badge-success";

; Component identity
pub const COMPONENT        : str = "badge";
pub const DATA_TESTID_BASE : str = "badge-";
pub const SPEC_PATH        : str = "specs/uikit/stories_badge.t27";

; ── Interaction steps (checked by Steps panel) ───────────────────────────────
pub const STEP_HOVER  : str = "hover";
pub const STEP_CLICK  : str = "click";
pub const STEP_FOCUS  : str = "focus";

pub const EXPECT_HOVER  : str = "hover";
pub const EXPECT_ACTIVE : str = "active";
pub const EXPECT_FOCUS  : str = "hover";

; ── Assertion IDs ─────────────────────────────────────────────────────────────
pub const ASSERT_ELEMENT_EXISTS   : str = "element-exists";
pub const ASSERT_TESTID_PRESENT   : str = "data-testid-present";
pub const ASSERT_STATE_DEFAULT    : str = "data-state-default";
pub const ASSERT_STATE_DISABLED   : str = "data-state-disabled";
pub const ASSERT_OPACITY_DISABLED : str = "opacity-disabled";
pub const ASSERT_CURSOR_DISABLED  : str = "cursor-not-allowed";

; ── Tests ─────────────────────────────────────────────────────────────────────
test story_ids_unique {
    assert STORY_BADGE_PRIMARY_DEFAULT  != STORY_BADGE_PRIMARY_HOVER;
    assert STORY_BADGE_PRIMARY_HOVER    != STORY_BADGE_PRIMARY_ACTIVE;
    assert STORY_BADGE_PRIMARY_ACTIVE   != STORY_BADGE_PRIMARY_DISABLED;
    assert STORY_BADGE_PRIMARY_DEFAULT  != STORY_BADGE_PRIMARY_DISABLED;
    assert STORY_BADGE_SECONDARY        != STORY_BADGE_SUCCESS;
}

test interaction_steps_cover_all_states {
    assert STEP_HOVER  != STEP_CLICK;
    assert STEP_CLICK  != STEP_FOCUS;
    assert EXPECT_HOVER != EXPECT_ACTIVE;
}

test assert_ids_unique {
    assert ASSERT_ELEMENT_EXISTS   != ASSERT_TESTID_PRESENT;
    assert ASSERT_TESTID_PRESENT   != ASSERT_STATE_DEFAULT;
    assert ASSERT_STATE_DEFAULT    != ASSERT_STATE_DISABLED;
    assert ASSERT_OPACITY_DISABLED != ASSERT_CURSOR_DISABLED;
}

invariant primary_state_coverage {
    assert STORY_BADGE_PRIMARY_DEFAULT  == "badge-primary";
    assert STORY_BADGE_PRIMARY_HOVER    == "badge-primary-hover";
    assert STORY_BADGE_PRIMARY_ACTIVE   == "badge-primary-active";
    assert STORY_BADGE_PRIMARY_DISABLED == "badge-primary-disabled";
}

invariant testid_base_matches_component {
    assert DATA_TESTID_BASE == "badge-";
    assert COMPONENT == "badge";
}
