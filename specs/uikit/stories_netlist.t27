; specs/uikit/stories_netlist.t27 -- NETLIST constructor story IDs for UIKit storybook.
; Each story maps to a unique ?story= URL at https://t27.ai/#/uikit.
; Source specs: specs/t27f/netlist_*.t27 (epic #13650).
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stories_netlist;

; ── NETLIST constructor story IDs ────────────────────────────────────────────
; Each pub const becomes a unique ?story= URL slug in the storybook.

pub const STORY_NETLIST_TOOLBAR_DEFAULT     : str = "netlist-toolbar-default";
pub const STORY_NETLIST_PARTS_DEFAULT       : str = "netlist-parts-default";
pub const STORY_NETLIST_VIEWPORT_DEFAULT    : str = "netlist-viewport-default";
pub const STORY_NETLIST_SELECTION_DEFAULT   : str = "netlist-selection-default";
pub const STORY_NETLIST_CONNECTION_DEFAULT  : str = "netlist-connection-default";
pub const STORY_NETLIST_INSPECTOR_DEFAULT   : str = "netlist-inspector-default";
pub const STORY_NETLIST_CONSTRUCTOR_DEFAULT : str = "netlist-constructor-default";

; Component identity
pub const COMPONENT : str = "netlist";
pub const SPEC_PATH : str = "specs/uikit/stories_netlist.t27";

; ── Tests (L4: every spec must have test/invariant/bench) ────────────────────
test story_ids_non_empty {
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != "";
    assert STORY_NETLIST_PARTS_DEFAULT       != "";
    assert STORY_NETLIST_VIEWPORT_DEFAULT    != "";
    assert STORY_NETLIST_SELECTION_DEFAULT   != "";
    assert STORY_NETLIST_CONNECTION_DEFAULT  != "";
    assert STORY_NETLIST_INSPECTOR_DEFAULT   != "";
    assert STORY_NETLIST_CONSTRUCTOR_DEFAULT != "";
}

test story_ids_unique {
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_PARTS_DEFAULT;
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_VIEWPORT_DEFAULT;
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_SELECTION_DEFAULT;
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_CONNECTION_DEFAULT;
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_INSPECTOR_DEFAULT;
    assert STORY_NETLIST_TOOLBAR_DEFAULT     != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
    assert STORY_NETLIST_PARTS_DEFAULT       != STORY_NETLIST_VIEWPORT_DEFAULT;
    assert STORY_NETLIST_PARTS_DEFAULT       != STORY_NETLIST_SELECTION_DEFAULT;
    assert STORY_NETLIST_PARTS_DEFAULT       != STORY_NETLIST_CONNECTION_DEFAULT;
    assert STORY_NETLIST_PARTS_DEFAULT       != STORY_NETLIST_INSPECTOR_DEFAULT;
    assert STORY_NETLIST_PARTS_DEFAULT       != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
    assert STORY_NETLIST_VIEWPORT_DEFAULT    != STORY_NETLIST_SELECTION_DEFAULT;
    assert STORY_NETLIST_VIEWPORT_DEFAULT    != STORY_NETLIST_CONNECTION_DEFAULT;
    assert STORY_NETLIST_VIEWPORT_DEFAULT    != STORY_NETLIST_INSPECTOR_DEFAULT;
    assert STORY_NETLIST_VIEWPORT_DEFAULT    != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
    assert STORY_NETLIST_SELECTION_DEFAULT   != STORY_NETLIST_CONNECTION_DEFAULT;
    assert STORY_NETLIST_SELECTION_DEFAULT   != STORY_NETLIST_INSPECTOR_DEFAULT;
    assert STORY_NETLIST_SELECTION_DEFAULT   != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
    assert STORY_NETLIST_CONNECTION_DEFAULT  != STORY_NETLIST_INSPECTOR_DEFAULT;
    assert STORY_NETLIST_CONNECTION_DEFAULT  != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
    assert STORY_NETLIST_INSPECTOR_DEFAULT   != STORY_NETLIST_CONSTRUCTOR_DEFAULT;
}

invariant story_slugs_match_spec {
    assert STORY_NETLIST_TOOLBAR_DEFAULT     == "netlist-toolbar-default";
    assert STORY_NETLIST_PARTS_DEFAULT       == "netlist-parts-default";
    assert STORY_NETLIST_VIEWPORT_DEFAULT    == "netlist-viewport-default";
    assert STORY_NETLIST_SELECTION_DEFAULT   == "netlist-selection-default";
    assert STORY_NETLIST_CONNECTION_DEFAULT  == "netlist-connection-default";
    assert STORY_NETLIST_INSPECTOR_DEFAULT   == "netlist-inspector-default";
    assert STORY_NETLIST_CONSTRUCTOR_DEFAULT == "netlist-constructor-default";
}

invariant component_name {
    assert COMPONENT == "netlist";
}

invariant spec_path_matches_file {
    assert SPEC_PATH == "specs/uikit/stories_netlist.t27";
}
