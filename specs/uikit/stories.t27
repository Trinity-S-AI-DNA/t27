; specs/uikit/stories.t27 -- UI Kit story declarations, primary_button family (Wave 1).
; Rendered live at https://t27.ai/#/uikit (trinity/apps/website/src/pages/UIKit.tsx).
; Gen-react backend for auto-generation: epic #13698.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stories;

use uikit_design_tokens;

; ── Primary Button — four interactive states ─────────────────────────────────
; Render method: live <button> DOM element (not <img>).
; Theme: TH_T27 (dark) or TH_PAPER (light) -- switched without reload.
; States: default, hover, active (pressed), disabled.

pub const STORY_BUTTON_PRIMARY_DEFAULT  : str = "button-primary-default";
pub const STORY_BUTTON_PRIMARY_HOVER    : str = "button-primary-hover";
pub const STORY_BUTTON_PRIMARY_ACTIVE   : str = "button-primary-active";
pub const STORY_BUTTON_PRIMARY_DISABLED : str = "button-primary-disabled";

; Component identity
pub const COMPONENT : str = "button";
pub const SPEC_PATH : str = "specs/uikit/stories.t27";

; Styling rule (B&W brand, see design_tokens.t27 BTN_BORDER_RADIUS):
;   default:  background=TH_*_TEXT  border=TH_*_TEXT  color=TH_*_BG  opacity=1.0
;   hover:    background=TH_*_TEXT+"CC"  same border    same color    opacity=1.0
;   active:   background=TH_*_TEXT+"DD"  same border    same color    opacity=1.0
;   disabled: same as default  opacity=0.4  cursor=not-allowed

; ── Tests ────────────────────────────────────────────────────────────────────
test story_ids_unique {
    assert STORY_BUTTON_PRIMARY_DEFAULT  != STORY_BUTTON_PRIMARY_HOVER;
    assert STORY_BUTTON_PRIMARY_HOVER    != STORY_BUTTON_PRIMARY_ACTIVE;
    assert STORY_BUTTON_PRIMARY_ACTIVE   != STORY_BUTTON_PRIMARY_DISABLED;
    assert STORY_BUTTON_PRIMARY_DEFAULT  != STORY_BUTTON_PRIMARY_DISABLED;
}

test component_name {
    assert COMPONENT == "button";
}

invariant spec_path_matches_file {
    assert SPEC_PATH == "specs/uikit/stories.t27";
}
