// SPDX-License-Identifier: Apache-2.0
; specs/uikit/container.t27 -- UI Kit Container object: a row or column of up to 16 children.
; Children arrive as measured sizes (width and height arrays); layout returns each child's offset
; inside the container, relative to the container's own 0,0. Padding and gap come from size classes
; that map to the design_tokens SPACE_* steps. The container draws nothing except an optional
; surface rect (a ROLE name, never a colour literal). Its accessible name is the group name.
; Closes #13773. Part of epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_container;

; ── Capacity ────────────────────────────────────────────────────────────────
pub const CT_MAX_CHILDREN : u32 = 16;

; ── Direction ───────────────────────────────────────────────────────────────
pub const CT_DIR_ROW    : u32 = 0;
pub const CT_DIR_COLUMN : u32 = 1;

; ── Size classes: 0 none, 1 small, 2 medium, 3 large ────────────────────────
pub const CT_CLASS_MAX : u32 = 3;

; PROPOSED TOKEN: numeric twins of SPACE_SM/MD/LG ("8px", "12px", "16px") and SPACE_XS/SM/MD for gaps.
; design_tokens.t27 holds spacing only as strings; native_tokens.t27 has no spacing numbers.
pub const CT_PAD_SM : f64 = 8.0;
pub const CT_PAD_MD : f64 = 12.0;
pub const CT_PAD_LG : f64 = 16.0;
pub const CT_GAP_SM : f64 = 4.0;
pub const CT_GAP_MD : f64 = 8.0;
pub const CT_GAP_LG : f64 = 12.0;

; ── States (catalog order) ──────────────────────────────────────────────────
pub const CT_STATE_DEFAULT  : u32 = 0;
pub const CT_STATE_HOVER    : u32 = 1;
pub const CT_STATE_PRESSED  : u32 = 2;
pub const CT_STATE_FOCUS    : u32 = 3;
pub const CT_STATE_DISABLED : u32 = 4;
pub const CT_STATE_LOADING  : u32 = 5;
pub const CT_STATE_COUNT    : u32 = 6;

; ── Theme ───────────────────────────────────────────────────────────────────
pub const CT_THEME_DARK  : u32 = 0;
pub const CT_THEME_LIGHT : u32 = 1;

; ── Role names ──────────────────────────────────────────────────────────────
pub const CT_ROLE_SURFACE : u32 = 0;
pub const CT_ROLE_INK     : u32 = 1;
pub const CT_ROLE_ACCENT  : u32 = 2;
pub const CT_ROLE_DANGER  : u32 = 3;
pub const CT_ROLE_SUCCESS : u32 = 4;
pub const CT_ROLE_LINE    : u32 = 5;

; ── Draw op kinds ───────────────────────────────────────────────────────────
pub const CT_OP_RECT : u32 = 0;
pub const CT_OP_TEXT : u32 = 1;
pub const CT_OP_ICON : u32 = 2;

; ── Non-colour state marks (outline width in points; 0 means none) ──────────
; hover 1, pressed 2, focus 3, disabled 4 (dashed), loading 5 (spinner icon): all distinct, all non-zero.
pub const CT_ACCESS_ROLE : str = "group";

pub struct CtConfig {
    dir: u32,
    pad_class: u32,
    gap_class: u32,
    surface: bool,
    name_id: u32,
    count: u32,
    state: u32,
    theme: u32,
    disposed: bool,
}

; ── create / configure ──────────────────────────────────────────────────────
fn ct_clamp_class(c: u32) -> u32 {
    if (c > CT_CLASS_MAX) { return CT_CLASS_MAX; }
    return c;
}

/// A container config: direction, padding and gap classes, surface flag, group name id, child count (capped at 16).
pub fn ct_create(dir: u32, pad_class: u32, gap_class: u32, surface: bool, name_id: u32, count: u32) -> CtConfig {
    var c : CtConfig;
    c.dir = CT_DIR_ROW;
    if (dir == CT_DIR_COLUMN) { c.dir = CT_DIR_COLUMN; }
    c.pad_class = ct_clamp_class(pad_class);
    c.gap_class = ct_clamp_class(gap_class);
    c.surface = surface;
    c.name_id = name_id;
    c.count = count;
    if (count > CT_MAX_CHILDREN) { c.count = CT_MAX_CHILDREN; }
    c.state = CT_STATE_DEFAULT;
    c.theme = CT_THEME_DARK;
    c.disposed = false;
    return c;
}

pub fn ct_pad(cls: u32) -> f64 {
    if (cls == 1) { return CT_PAD_SM; }
    if (cls == 2) { return CT_PAD_MD; }
    if (cls == 3) { return CT_PAD_LG; }
    return 0.0;
}

pub fn ct_gap(cls: u32) -> f64 {
    if (cls == 1) { return CT_GAP_SM; }
    if (cls == 2) { return CT_GAP_MD; }
    if (cls == 3) { return CT_GAP_LG; }
    return 0.0;
}

; ── state: out of range is refused (config returned unchanged) ──────────────
pub fn ct_state_valid(s: u32) -> bool {
    return s < CT_STATE_COUNT;
}

pub fn ct_with_state(cfg: CtConfig, s: u32) -> CtConfig {
    var c : CtConfig = cfg;
    if (ct_state_valid(s) == false) { return c; }
    c.state = s;
    return c;
}

; ── theme_bind ──────────────────────────────────────────────────────────────
pub fn ct_with_theme(cfg: CtConfig, theme: u32) -> CtConfig {
    var c : CtConfig = cfg;
    if (theme > CT_THEME_LIGHT) { return c; }
    c.theme = theme;
    return c;
}

/// Luminance 0..1 of a role in a theme. Light is the inverse of Dark for surface and ink.
pub fn ct_role_lum(theme: u32, role: u32) -> f64 {
    var surf : f64 = 0.0;
    var ink : f64 = 1.0;
    if (theme == CT_THEME_LIGHT) { surf = 1.0; ink = 0.0; }
    if (role == CT_ROLE_SURFACE) { return surf; }
    if (role == CT_ROLE_INK) { return ink; }
    return 0.5;
}

; ── layout / measure ────────────────────────────────────────────────────────
fn ct_n(cfg: CtConfig) -> u32 {
    if (cfg.count > CT_MAX_CHILDREN) { return CT_MAX_CHILDREN; }
    return cfg.count;
}

/// Sum of the first n sizes.
fn ct_sum(v: []const f64, n: u32) -> f64 {
    var s : f64 = 0.0;
    var i : u32 = 0;
    while (i < n) {
        s = s + v[i];
        i = i + 1;
    }
    return s;
}

/// Largest of the first n sizes.
fn ct_max(v: []const f64, n: u32) -> f64 {
    var m : f64 = 0.0;
    var i : u32 = 0;
    while (i < n) {
        if (v[i] > m) { m = v[i]; }
        i = i + 1;
    }
    return m;
}

fn ct_gaps_total(cfg: CtConfig) -> f64 {
    const n : u32 = ct_n(cfg);
    if (n < 2) { return 0.0; }
    return ct_gap(cfg.gap_class) * @as(f64, n - 1);
}

/// The container's natural width, clamped to avail_w when avail_w > 0.
pub fn ct_measure_w(cfg: CtConfig, cw: []const f64, avail_w: f64) -> f64 {
    const n : u32 = ct_n(cfg);
    var inner : f64 = ct_max(cw, n);
    if (cfg.dir == CT_DIR_ROW) { inner = ct_sum(cw, n) + ct_gaps_total(cfg); }
    var w : f64 = inner + 2.0 * ct_pad(cfg.pad_class);
    if (avail_w > 0.0 and w > avail_w) { w = avail_w; }
    return w;
}

/// The container's natural height.
pub fn ct_measure_h(cfg: CtConfig, ch: []const f64) -> f64 {
    const n : u32 = ct_n(cfg);
    var inner : f64 = ct_max(ch, n);
    if (cfg.dir == CT_DIR_COLUMN) { inner = ct_sum(ch, n) + ct_gaps_total(cfg); }
    return inner + 2.0 * ct_pad(cfg.pad_class);
}

/// Each child's offset (x into ox, y into oy), relative to the container's own 0,0.
pub fn ct_layout(cfg: CtConfig, cw: []const f64, ch: []const f64, ox: []f64, oy: []f64) -> void {
    const n : u32 = ct_n(cfg);
    const pad : f64 = ct_pad(cfg.pad_class);
    const gap : f64 = ct_gap(cfg.gap_class);
    var x : f64 = pad;
    var y : f64 = pad;
    var i : u32 = 0;
    while (i < n) {
        ox[i] = x;
        oy[i] = y;
        if (cfg.dir == CT_DIR_ROW) { x = x + cw[i] + gap; } else { y = y + ch[i] + gap; }
        i = i + 1;
    }
}

; ── render: only the optional surface rect ──────────────────────────────────
/// Outline width of a state (non-colour cue): 0 for default, distinct non-zero for every other state.
pub fn ct_state_mark(state: u32) -> u32 {
    if (state == CT_STATE_DEFAULT or state >= CT_STATE_COUNT) { return 0; }
    return state;
}

/// Alpha of the surface rect from the state (default 1.0, disabled 0.4, loading 0.6, others 1.0).
pub fn ct_state_alpha(state: u32) -> f64 {
    if (state == CT_STATE_DISABLED) { return 0.4; }
    if (state == CT_STATE_LOADING) { return 0.6; }
    return 1.0;
}

/// Writes draw ops (kind, role, alpha, w, h; x and y are always 0,0) and returns how many: 0 or 1.
pub fn ct_render(cfg: CtConfig, w: f64, h: f64, kind: []u32, role: []u32, alpha: []f64, ow: []f64, oh: []f64) -> u32 {
    if (cfg.disposed or cfg.surface == false) { return 0; }
    kind[0] = CT_OP_RECT;
    role[0] = CT_ROLE_SURFACE;
    alpha[0] = ct_state_alpha(cfg.state);
    ow[0] = w;
    oh[0] = h;
    return 1;
}

; ── hit_test ────────────────────────────────────────────────────────────────
/// Whether (x, y), relative to the container's own box, lands inside w by h. A disposed container is a miss.
pub fn ct_hit_test(cfg: CtConfig, w: f64, h: f64, x: f64, y: f64) -> bool {
    if (cfg.disposed) { return false; }
    if (x < 0.0 or y < 0.0) { return false; }
    return x < w and y < h;
}

; ── a11y ────────────────────────────────────────────────────────────────────
/// The accessible name id: the group name, or 1 (the generic group name) when none was given. Never 0.
pub fn ct_a11y_name(cfg: CtConfig) -> u32 {
    if (cfg.name_id == 0) { return 1; }
    return cfg.name_id;
}

; ── dispose ─────────────────────────────────────────────────────────────────
pub fn ct_dispose(cfg: CtConfig) -> CtConfig {
    var c : CtConfig = cfg;
    c.count = 0;
    c.surface = false;
    c.state = CT_STATE_DEFAULT;
    c.disposed = true;
    return c;
}

; ── Tests ───────────────────────────────────────────────────────────────────
test create_caps_children_and_clamps_classes {
    const c : CtConfig = ct_create(CT_DIR_ROW, 9, 9, true, 7, 40);
    assert c.count == 16;
    assert c.pad_class == 3;
    assert c.gap_class == 3;
    assert c.dir == CT_DIR_ROW;
    assert c.state == CT_STATE_DEFAULT;
    assert c.disposed == false;
}

test padding_and_gap_come_from_tokens {
    assert ct_pad(0) == 0.0;
    assert ct_pad(1) == 8.0;
    assert ct_pad(2) == 12.0;
    assert ct_pad(3) == 16.0;
    assert ct_gap(1) == 4.0;
    assert ct_gap(3) == 12.0;
}

test measure_row {
    const c : CtConfig = ct_create(CT_DIR_ROW, 1, 1, false, 1, 3);
    var cw : [3]f64 = undefined;
    var ch : [3]f64 = undefined;
    cw[0] = 10.0; cw[1] = 20.0; cw[2] = 30.0;
    ch[0] = 5.0; ch[1] = 9.0; ch[2] = 7.0;
    // width 60 + 2 gaps of 4 + 2 pads of 8 = 84; height 9 + 16 = 25
    assert ct_measure_w(c, cw[0..3], 0.0) == 84.0;
    assert ct_measure_h(c, ch[0..3]) == 25.0;
    assert ct_measure_w(c, cw[0..3], 50.0) == 50.0;
}

test layout_row_offsets {
    const c : CtConfig = ct_create(CT_DIR_ROW, 1, 1, false, 1, 3);
    var cw : [3]f64 = undefined;
    var ch : [3]f64 = undefined;
    var ox : [3]f64 = undefined;
    var oy : [3]f64 = undefined;
    cw[0] = 10.0; cw[1] = 20.0; cw[2] = 30.0;
    ch[0] = 5.0; ch[1] = 9.0; ch[2] = 7.0;
    ct_layout(c, cw[0..3], ch[0..3], ox[0..3], oy[0..3]);
    assert ox[0] == 8.0;
    assert ox[1] == 22.0;
    assert ox[2] == 46.0;
    assert oy[0] == 8.0;
    assert oy[2] == 8.0;
}

test layout_column_offsets {
    const c : CtConfig = ct_create(CT_DIR_COLUMN, 2, 2, false, 1, 2);
    var cw : [2]f64 = undefined;
    var ch : [2]f64 = undefined;
    var ox : [2]f64 = undefined;
    var oy : [2]f64 = undefined;
    cw[0] = 10.0; cw[1] = 40.0;
    ch[0] = 20.0; ch[1] = 30.0;
    ct_layout(c, cw[0..2], ch[0..2], ox[0..2], oy[0..2]);
    assert ox[0] == 12.0;
    assert ox[1] == 12.0;
    assert oy[0] == 12.0;
    assert oy[1] == 40.0;
    // width 40 + 24 = 64; height 50 + gap 8 + 24 = 82
    assert ct_measure_w(c, cw[0..2], 0.0) == 64.0;
    assert ct_measure_h(c, ch[0..2]) == 82.0;
}

test render_draws_only_the_optional_surface {
    var kind : [1]u32 = undefined;
    var role : [1]u32 = undefined;
    var alpha : [1]f64 = undefined;
    var ow : [1]f64 = undefined;
    var oh : [1]f64 = undefined;
    const bare : CtConfig = ct_create(CT_DIR_ROW, 1, 1, false, 1, 0);
    assert ct_render(bare, 50.0, 20.0, kind[0..1], role[0..1], alpha[0..1], ow[0..1], oh[0..1]) == 0;
    const surf : CtConfig = ct_with_state(ct_create(CT_DIR_ROW, 1, 1, true, 1, 0), CT_STATE_DISABLED);
    assert ct_render(surf, 50.0, 20.0, kind[0..1], role[0..1], alpha[0..1], ow[0..1], oh[0..1]) == 1;
    assert kind[0] == CT_OP_RECT;
    assert role[0] == CT_ROLE_SURFACE;
    assert alpha[0] == 0.4;
    assert ow[0] == 50.0;
    assert oh[0] == 20.0;
}

test hit_test_is_relative_to_own_box {
    const c : CtConfig = ct_create(CT_DIR_ROW, 1, 1, true, 1, 0);
    assert ct_hit_test(c, 50.0, 20.0, 0.0, 0.0);
    assert ct_hit_test(c, 50.0, 20.0, 49.0, 19.0);
    assert ct_hit_test(c, 50.0, 20.0, 50.0, 10.0) == false;
    assert ct_hit_test(c, 50.0, 20.0, -1.0, 5.0) == false;
}

test state_out_of_range_is_refused {
    const c : CtConfig = ct_create(CT_DIR_ROW, 1, 1, true, 1, 0);
    assert ct_with_state(c, 5).state == CT_STATE_LOADING;
    assert ct_with_state(c, 6).state == CT_STATE_DEFAULT;
    assert ct_state_valid(6) == false;
    assert ct_state_valid(0);
}

test theme_light_is_inverse_of_dark {
    assert ct_role_lum(CT_THEME_DARK, CT_ROLE_SURFACE) == 0.0;
    assert ct_role_lum(CT_THEME_LIGHT, CT_ROLE_SURFACE) == 1.0;
    assert ct_role_lum(CT_THEME_DARK, CT_ROLE_INK) == 1.0;
    assert ct_role_lum(CT_THEME_LIGHT, CT_ROLE_INK) == 0.0;
    const c : CtConfig = ct_create(CT_DIR_ROW, 1, 1, true, 1, 0);
    assert ct_with_theme(c, CT_THEME_LIGHT).theme == CT_THEME_LIGHT;
    assert ct_with_theme(c, 2).theme == CT_THEME_DARK;
}

test a11y_name_is_group_name_and_state_has_non_colour_mark {
    assert ct_a11y_name(ct_create(CT_DIR_ROW, 1, 1, false, 42, 0)) == 42;
    assert ct_a11y_name(ct_create(CT_DIR_COLUMN, 0, 0, true, 0, 0)) != 0;
    assert CT_ACCESS_ROLE == "group";
    assert ct_state_mark(CT_STATE_DEFAULT) == 0;
    assert ct_state_mark(CT_STATE_HOVER) == 1;
    assert ct_state_mark(CT_STATE_PRESSED) == 2;
    assert ct_state_mark(CT_STATE_FOCUS) == 3;
    assert ct_state_mark(CT_STATE_DISABLED) == 4;
    assert ct_state_mark(CT_STATE_LOADING) == 5;
}

test dispose_makes_hit_test_a_miss {
    const c : CtConfig = ct_dispose(ct_create(CT_DIR_ROW, 1, 1, true, 1, 5));
    assert c.disposed;
    assert c.count == 0;
    assert ct_hit_test(c, 50.0, 20.0, 5.0, 5.0) == false;
    var kind : [1]u32 = undefined;
    var role : [1]u32 = undefined;
    var alpha : [1]f64 = undefined;
    var ow : [1]f64 = undefined;
    var oh : [1]f64 = undefined;
    assert ct_render(c, 50.0, 20.0, kind[0..1], role[0..1], alpha[0..1], ow[0..1], oh[0..1]) == 0;
}

invariant container_capacity_and_names {
    assert CT_MAX_CHILDREN == 16;
    assert CT_STATE_COUNT == 6;
    assert CT_ROLE_SURFACE != CT_ROLE_INK;
    assert ct_a11y_name(ct_create(CT_DIR_ROW, 0, 0, false, 0, 99)) != 0;
}
