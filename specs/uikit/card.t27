// SPDX-License-Identifier: Apache-2.0
; specs/uikit/card.t27 -- Card: the UI Kit card object (epic #13426, milestone M0).
; A card is a titled content surface: a raised plate with a title line and a body block. Draw ops carry ROLE
; names and alphas, never a colour literal, and are relative to the card's own 0,0. The title is the accessible
; name. Variants: flat, raised, outlined.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_card;

; PROPOSED TOKEN: sizes without a token yet (not in design_tokens / native_tokens).
pub const CARD_PAD : [2]f64 = [12.0, 16.0];
pub const CARD_RADIUS : f64 = 8.0;
pub const CARD_MIN_W : f64 = 120.0;
pub const CARD_TITLE_SIZE : [2]f64 = [11.0, 13.0];
pub const CARD_BODY_SIZE : [2]f64 = [10.0, 12.0];
pub const CARD_LINE_GAP : f64 = 1.4;
pub const CARD_CHAR_ADV : f64 = 0.6;
pub const CARD_TITLE_GAP : f64 = 6.0;
pub const CARD_RING_GAP : f64 = 2.0;
pub const CARD_RING_LINE : f64 = 1.5;
pub const CARD_RULE_HOVER : f64 = 1.0;
pub const CARD_RULE_PRESSED : f64 = 2.0;
pub const CARD_EDGE : f64 = 1.0;
pub const CARD_ICON : f64 = 14.0;
pub const CARD_SIZE_COUNT : u32 = 2;

pub const ROLE_SURFACE : u32 = 0;
pub const ROLE_INK : u32 = 1;
pub const ROLE_ACCENT : u32 = 2;
pub const ROLE_DANGER : u32 = 3;
pub const ROLE_SUCCESS : u32 = 4;
pub const ROLE_LINE : u32 = 5;
pub const ROLE_COUNT : u32 = 6;

pub const CV_FLAT : u32 = 0;
pub const CV_RAISED : u32 = 1;
pub const CV_OUTLINED : u32 = 2;
pub const CV_COUNT : u32 = 3;

pub const CS_DEFAULT : u32 = 0;
pub const CS_HOVER : u32 = 1;
pub const CS_PRESSED : u32 = 2;
pub const CS_FOCUS : u32 = 3;
pub const CS_DISABLED : u32 = 4;
pub const CS_SELECTED : u32 = 5;
pub const CS_COUNT : u32 = 6;

pub const CTHEME_DARK : u32 = 0;
pub const CTHEME_LIGHT : u32 = 1;

pub const COP_NONE : u32 = 0;
pub const COP_RECT : u32 = 1;
pub const COP_TEXT : u32 = 2;
pub const COP_ICON : u32 = 3;
pub const CARD_MAX_OPS : u32 = 6;

pub const CICON_NONE : u32 = 0;
pub const CICON_CHECK : u32 = 1;
pub const CICON_BLOCK : u32 = 2;

; Per variant: surface fill alpha and edge line width (outlined only has an edge).
pub const CV_FILL_A : [3]f64 = [0.0, 0.08, 0.0];
pub const CV_EDGE_W : [3]f64 = [0.0, 0.0, 1.0];
; Per state: extra fill alpha added on top, and title ink alpha.
pub const CS_FILL_A : [6]f64 = [0.0, 0.04, 0.08, 0.0, 0.0, 0.06];
pub const CS_INK_A : [6]f64 = [0.9, 1.0, 1.0, 1.0, 0.4, 1.0];
; Swap table for the Light theme: surface and ink trade places, the other roles stay.
pub const LIGHT_SWAP : [6]u32 = [1, 0, 2, 3, 4, 5];

pub struct CardCfg {
    variant: u32,
    size: u32,
    title_id: u32,
    title_len: u32,
    body_lines: u32,
    state: u32,
    theme: u32,
    alive: bool,
}

pub struct CardOp {
    kind: u32,
    role: u32,
    alpha: f64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    radius: f64,
    line: f64,
    icon: u32,
}

pub fn card_state_ok(s: u32) -> bool { return s <= CS_SELECTED; }

; ── create / configure ───────────────────────────────────────────────────────
; A title is required (it is the accessible name); a bad variant, size or theme gives an inert card.
pub fn card_create(variant: u32, size: u32, title_id: u32, title_len: u32, body_lines: u32, theme: u32) -> CardCfg {
    if (title_len == 0 or variant >= CV_COUNT or size >= CARD_SIZE_COUNT or theme > CTHEME_LIGHT) {
        return CardCfg{.variant = 0, .size = 0, .title_id = 0, .title_len = 0, .body_lines = 0, .state = CS_DEFAULT, .theme = CTHEME_DARK, .alive = false};
    }
    return CardCfg{.variant = variant, .size = size, .title_id = title_id, .title_len = title_len, .body_lines = body_lines, .state = CS_DEFAULT, .theme = theme, .alive = true};
}
; A state outside 0..5 is refused: the card comes back unchanged.
pub fn card_set_state(c: CardCfg, s: u32) -> CardCfg {
    if (card_state_ok(s) == false) { return c; }
    return CardCfg{.variant = c.variant, .size = c.size, .title_id = c.title_id, .title_len = c.title_len, .body_lines = c.body_lines, .state = s, .theme = c.theme, .alive = c.alive};
}
; theme_bind: rebind the card to Dark or Light; an unknown theme is refused (unchanged).
pub fn card_theme_bind(c: CardCfg, theme: u32) -> CardCfg {
    if (theme > CTHEME_LIGHT) { return c; }
    return CardCfg{.variant = c.variant, .size = c.size, .title_id = c.title_id, .title_len = c.title_len, .body_lines = c.body_lines, .state = c.state, .theme = theme, .alive = c.alive};
}
pub fn card_dispose(c: CardCfg) -> CardCfg {
    return CardCfg{.variant = 0, .size = 0, .title_id = 0, .title_len = 0, .body_lines = 0, .state = CS_DEFAULT, .theme = CTHEME_DARK, .alive = false};
}

; ── theme roles ──────────────────────────────────────────────────────────────
pub fn card_role(theme: u32, role: u32) -> u32 {
    if (role >= ROLE_COUNT) { return role; }
    if (theme == CTHEME_LIGHT) { return LIGHT_SWAP[role]; }
    return role;
}

; ── measure ──────────────────────────────────────────────────────────────────
pub fn card_title_h(c: CardCfg) -> f64 { return CARD_TITLE_SIZE[c.size] * CARD_LINE_GAP; }
pub fn card_body_h(c: CardCfg) -> f64 { return c.body_lines as f64 * CARD_BODY_SIZE[c.size] * CARD_LINE_GAP; }
pub fn card_measure_h(c: CardCfg) -> f64 {
    var h : f64 = 2.0 * CARD_PAD[c.size] + card_title_h(c);
    if (c.body_lines > 0) { h = h + CARD_TITLE_GAP + card_body_h(c); }
    return h;
}
; Width from the title and token padding; at least CARD_MIN_W, at most avail_w.
pub fn card_measure_w(c: CardCfg, avail_w: f64) -> f64 {
    var w : f64 = c.title_len as f64 * CARD_TITLE_SIZE[c.size] * CARD_CHAR_ADV + 2.0 * CARD_PAD[c.size];
    if (w < CARD_MIN_W) { w = CARD_MIN_W; }
    if (w > avail_w) { w = avail_w; }
    return w;
}

; ── state cues (non-colour) ──────────────────────────────────────────────────
; hover and pressed draw a top rule (1 and 2 wide), focus a ring, selected a check icon, disabled a block icon.
pub fn card_rule(s: u32) -> f64 {
    if (s == CS_HOVER) { return CARD_RULE_HOVER; }
    if (s == CS_PRESSED) { return CARD_RULE_PRESSED; }
    return 0.0;
}
pub fn card_icon(s: u32) -> u32 {
    if (s == CS_SELECTED) { return CICON_CHECK; }
    if (s == CS_DISABLED) { return CICON_BLOCK; }
    return CICON_NONE;
}
pub fn card_has_ring(s: u32) -> bool { return s == CS_FOCUS; }
pub fn card_fill_alpha(c: CardCfg) -> f64 { return CV_FILL_A[c.variant] + CS_FILL_A[c.state]; }

; ── render ───────────────────────────────────────────────────────────────────
pub fn card_op_none() -> CardOp {
    return CardOp{.kind = COP_NONE, .role = ROLE_SURFACE, .alpha = 0.0, .x = 0.0, .y = 0.0, .w = 0.0, .h = 0.0, .radius = 0.0, .line = 0.0, .icon = CICON_NONE};
}
; Op list in order: fill (when alpha > 0), edge (outlined), title, rule, ring, icon.
pub fn card_edge_on(c: CardCfg) -> bool { return CV_EDGE_W[c.variant] > 0.0; }
pub fn card_render_count(c: CardCfg) -> u32 {
    if (c.alive == false) { return 0; }
    var n : u32 = 1;
    if (card_fill_alpha(c) > 0.0) { n = n + 1; }
    if (card_edge_on(c)) { n = n + 1; }
    if (card_rule(c.state) > 0.0) { n = n + 1; }
    if (card_has_ring(c.state)) { n = n + 1; }
    if (card_icon(c.state) != CICON_NONE) { n = n + 1; }
    return n;
}
pub fn card_render_op(c: CardCfg, avail_w: f64, i: u32) -> CardOp {
    if (c.alive == false or i >= card_render_count(c)) { return card_op_none(); }
    const w : f64 = card_measure_w(c, avail_w);
    const h : f64 = card_measure_h(c);
    const ink : u32 = card_role(c.theme, ROLE_INK);
    var k : u32 = i;
    if (card_fill_alpha(c) > 0.0) {
        if (k == 0) {
            return CardOp{.kind = COP_RECT, .role = ink, .alpha = card_fill_alpha(c), .x = 0.0, .y = 0.0, .w = w, .h = h, .radius = CARD_RADIUS, .line = 0.0, .icon = CICON_NONE};
        }
        k = k - 1;
    }
    if (card_edge_on(c)) {
        if (k == 0) {
            return CardOp{.kind = COP_RECT, .role = card_role(c.theme, ROLE_LINE), .alpha = 1.0, .x = 0.0, .y = 0.0, .w = w, .h = h, .radius = CARD_RADIUS, .line = CV_EDGE_W[c.variant], .icon = CICON_NONE};
        }
        k = k - 1;
    }
    if (k == 0) {
        return CardOp{.kind = COP_TEXT, .role = ink, .alpha = CS_INK_A[c.state], .x = CARD_PAD[c.size], .y = CARD_PAD[c.size], .w = w - 2.0 * CARD_PAD[c.size], .h = card_title_h(c), .radius = 0.0, .line = 0.0, .icon = CICON_NONE};
    }
    k = k - 1;
    if (card_rule(c.state) > 0.0) {
        if (k == 0) {
            return CardOp{.kind = COP_RECT, .role = ink, .alpha = CS_INK_A[c.state], .x = CARD_PAD[c.size], .y = 0.0, .w = w - 2.0 * CARD_PAD[c.size], .h = card_rule(c.state), .radius = 0.0, .line = 0.0, .icon = CICON_NONE};
        }
        k = k - 1;
    }
    if (card_has_ring(c.state)) {
        if (k == 0) {
            return CardOp{.kind = COP_RECT, .role = ROLE_ACCENT, .alpha = 1.0, .x = 0.0 - CARD_RING_GAP, .y = 0.0 - CARD_RING_GAP, .w = w + 2.0 * CARD_RING_GAP, .h = h + 2.0 * CARD_RING_GAP, .radius = CARD_RADIUS + CARD_RING_GAP, .line = CARD_RING_LINE, .icon = CICON_NONE};
        }
        k = k - 1;
    }
    return CardOp{.kind = COP_ICON, .role = ink, .alpha = CS_INK_A[c.state], .x = w - CARD_PAD[c.size] - CARD_ICON, .y = CARD_PAD[c.size], .w = CARD_ICON, .h = CARD_ICON, .radius = 0.0, .line = 0.0, .icon = card_icon(c.state)};
}

; ── hit_test ─────────────────────────────────────────────────────────────────
pub fn card_hit_test(c: CardCfg, avail_w: f64, x: f64, y: f64) -> bool {
    if (c.alive == false) { return false; }
    return x >= 0.0 and x < card_measure_w(c, avail_w) and y >= 0.0 and y < card_measure_h(c);
}
pub fn card_takes_press(s: u32) -> bool { return s != CS_DISABLED; }

; ── a11y ─────────────────────────────────────────────────────────────────────
pub fn card_a11y_name_len(c: CardCfg) -> u32 {
    if (c.alive == false) { return 0; }
    return c.title_len;
}
; Each non-default state has a distinct non-colour property code.
pub fn card_cue_code(s: u32) -> u32 {
    if (s == CS_HOVER) { return 1; }
    if (s == CS_PRESSED) { return 2; }
    if (s == CS_FOCUS) { return 3; }
    if (s == CS_DISABLED) { return 4; }
    if (s == CS_SELECTED) { return 5; }
    return 0;
}
pub fn card_has_cue(s: u32) -> bool {
    return card_rule(s) > 0.0 or card_has_ring(s) or card_icon(s) != CICON_NONE;
}

; ── Tests ────────────────────────────────────────────────────────────────────
test card_create_requires_a_title_and_valid_config {
    const c : CardCfg = card_create(CV_RAISED, 0, 4, 6, 2, CTHEME_DARK);
    assert c.alive and c.state == CS_DEFAULT and c.title_len == 6;
    assert card_create(CV_RAISED, 0, 4, 0, 2, CTHEME_DARK).alive == false;
    assert card_create(CV_COUNT, 0, 4, 6, 2, CTHEME_DARK).alive == false;
    assert card_create(CV_FLAT, CARD_SIZE_COUNT, 4, 6, 2, CTHEME_DARK).alive == false;
    assert card_create(CV_FLAT, 0, 4, 6, 2, 2).alive == false;
}

test card_measure_uses_token_sizes_only {
    const c : CardCfg = card_create(CV_FLAT, 0, 1, 4, 0, CTHEME_DARK);
    assert card_measure_w(c, 500.0) == CARD_MIN_W;
    assert card_measure_w(c, 90.0) == 90.0;
    assert card_measure_h(c) > 39.3 and card_measure_h(c) < 39.5;
    const b : CardCfg = card_create(CV_FLAT, 0, 1, 4, 2, CTHEME_DARK);
    assert card_measure_h(b) > card_measure_h(c) + CARD_TITLE_GAP;
    const wide : CardCfg = card_create(CV_FLAT, 1, 1, 40, 1, CTHEME_DARK);
    assert card_measure_w(wide, 900.0) > card_measure_w(c, 900.0);
}

test card_render_is_bounded_relative_and_role_based {
    var s : u32 = 0;
    while (s < CS_COUNT) {
        var v : u32 = 0;
        while (v < CV_COUNT) {
            const c : CardCfg = card_set_state(card_create(v, 1, 3, 6, 2, CTHEME_DARK), s);
            assert card_render_count(c) >= 1 and card_render_count(c) <= CARD_MAX_OPS;
            var i : u32 = 0;
            while (i < card_render_count(c)) {
                const op : CardOp = card_render_op(c, 500.0, i);
                assert op.kind != COP_NONE and op.role < ROLE_COUNT;
                assert op.alpha > 0.0 and op.alpha <= 1.0;
                i = i + 1;
            }
            assert card_render_op(c, 500.0, card_render_count(c)).kind == COP_NONE;
            v = v + 1;
        }
        s = s + 1;
    }
    const f : CardCfg = card_create(CV_FLAT, 1, 3, 6, 2, CTHEME_DARK);
    assert card_render_op(f, 500.0, 0).kind == COP_TEXT;
    assert card_render_op(f, 500.0, 0).x == CARD_PAD[1];
}

test card_outlined_draws_an_edge_in_the_line_role {
    const o : CardCfg = card_create(CV_OUTLINED, 0, 1, 5, 1, CTHEME_DARK);
    assert card_render_op(o, 500.0, 0).role == ROLE_LINE and card_render_op(o, 500.0, 0).line == CARD_EDGE;
    assert card_fill_alpha(card_create(CV_RAISED, 0, 1, 5, 1, CTHEME_DARK)) > 0.0;
}

test card_hit_test_is_relative_to_own_box {
    const c : CardCfg = card_create(CV_FLAT, 0, 1, 4, 0, CTHEME_DARK);
    const w : f64 = card_measure_w(c, 500.0);
    const h : f64 = card_measure_h(c);
    assert card_hit_test(c, 500.0, 0.0, 0.0);
    assert card_hit_test(c, 500.0, w - 0.5, h - 0.5);
    assert card_hit_test(c, 500.0, w, 5.0) == false;
    assert card_hit_test(c, 500.0, -1.0, 5.0) == false;
    assert card_hit_test(c, 500.0, 5.0, h) == false;
}

test card_six_states_and_out_of_range_is_refused {
    var s : u32 = 0;
    while (s < CS_COUNT) {
        assert card_state_ok(s);
        assert card_set_state(card_create(CV_FLAT, 0, 1, 3, 0, CTHEME_DARK), s).state == s;
        s = s + 1;
    }
    const c : CardCfg = card_set_state(card_create(CV_FLAT, 0, 1, 3, 0, CTHEME_DARK), CS_HOVER);
    assert card_set_state(c, CS_COUNT).state == CS_HOVER;
    assert card_set_state(c, 99).state == CS_HOVER;
    assert card_takes_press(CS_DISABLED) == false and card_takes_press(CS_SELECTED);
}

test card_theme_bind_dark_and_light {
    assert card_role(CTHEME_DARK, ROLE_SURFACE) == ROLE_SURFACE;
    assert card_role(CTHEME_LIGHT, ROLE_SURFACE) == ROLE_INK;
    assert card_role(CTHEME_LIGHT, ROLE_INK) == ROLE_SURFACE;
    assert card_role(CTHEME_LIGHT, ROLE_ACCENT) == ROLE_ACCENT;
    const dk : CardCfg = card_create(CV_RAISED, 0, 1, 3, 0, CTHEME_DARK);
    const lt : CardCfg = card_theme_bind(dk, CTHEME_LIGHT);
    assert lt.theme == CTHEME_LIGHT and lt.title_len == 3;
    assert card_render_op(dk, 500.0, 0).role == ROLE_INK;
    assert card_render_op(lt, 500.0, 0).role == ROLE_SURFACE;
    assert card_theme_bind(lt, 7).theme == CTHEME_LIGHT;
}

test card_a11y_name_is_the_title_and_state_is_not_colour_alone {
    assert card_a11y_name_len(card_create(CV_FLAT, 0, 1, 4, 0, CTHEME_DARK)) == 4;
    assert card_a11y_name_len(card_create(CV_FLAT, 0, 1, 0, 0, CTHEME_DARK)) == 0;
    var s : u32 = 1;
    while (s < CS_COUNT) {
        assert card_has_cue(s);
        assert card_cue_code(s) != card_cue_code(s - 1);
        s = s + 1;
    }
    assert card_has_cue(CS_DEFAULT) == false and card_cue_code(CS_DEFAULT) == 0;
}

test card_dispose_is_inert {
    const c : CardCfg = card_set_state(card_create(CV_RAISED, 0, 1, 4, 1, CTHEME_LIGHT), CS_SELECTED);
    const d : CardCfg = card_dispose(c);
    assert d.alive == false and d.state == CS_DEFAULT;
    assert card_hit_test(d, 500.0, 1.0, 1.0) == false;
    assert card_render_count(d) == 0 and card_a11y_name_len(d) == 0;
}

invariant card_ops_never_exceed_the_bound {
    assert CARD_MAX_OPS >= 6;
    assert ROLE_COUNT == 6 and CS_COUNT == 6;
}
