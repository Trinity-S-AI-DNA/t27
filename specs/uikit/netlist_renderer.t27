; specs/uikit/netlist_renderer.t27 -- Renderer spec: maps NETLIST story IDs to view types.
; Ring 2, Wave UIKit-C of epic #13650. Lane C. Closes #13902.
; render_story(story_id, theme) -> NrPlan dispatches each of the 7 NETLIST story IDs
; to the corresponding constructor view type. Numbers only; no pixel literals.
; Depends on: netlist_constructor_view, netlist_parts, netlist_inspector, netlist_slice.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_netlist_renderer;

use t27f::netlist_constructor::{NnetlistConstructor, nc_constructor_state, nc_no_preview};
use t27f::netlist_connection::{NcPreview};
use t27f::netlist_connection_view::{NcvLine, ncv_line_view};
use t27f::netlist_constructor_view::{NcvConstructorView, ncv_constructor_view};
use t27f::netlist_graph::{NetlistGraph, NG_NODE_BLOCK, NG_NODE_PIN, inverter_graph};
use t27f::netlist_inspector::{NiData, ni_inspect, ni_empty};
use t27f::netlist_parts::{NpPalette, np_default_palette, NP_MAX_PARTS};
use t27f::netlist_selection::{NvSelection, nv_no_selection, nv_select_node};
use t27f::netlist_selection_view::{NsvBadge, nsv_badge_view};
use t27f::netlist_slice::{nv_hit, nv_inverter_plan};
use t27f::netlist_toolbar::{NtToolbar, nt_toolbar};
use t27f::netlist_toolbar_view::{NtvToolbarView, ntv_toolbar_view, NTV_ACTION_COUNT};
use t27f::netlist_view::{NvPlan, nv_layout};

; ── Story ID string constants (canonical UIKit storybook URL slugs) ───────────
; These values are authoritative in this renderer; uikit::stories_netlist mirrors them.
pub const NR_STORY_TOOLBAR     : str = "netlist-toolbar-default";
pub const NR_STORY_PARTS       : str = "netlist-parts-default";
pub const NR_STORY_VIEWPORT    : str = "netlist-viewport-default";
pub const NR_STORY_SELECTION   : str = "netlist-selection-default";
pub const NR_STORY_CONNECTION  : str = "netlist-connection-default";
pub const NR_STORY_INSPECTOR   : str = "netlist-inspector-default";
pub const NR_STORY_CONSTRUCTOR : str = "netlist-constructor-default";

; ── Story kind discriminants ──────────────────────────────────────────────────
pub const NR_KIND_TOOLBAR     : u8 = 0;
pub const NR_KIND_PARTS       : u8 = 1;
pub const NR_KIND_VIEWPORT    : u8 = 2;
pub const NR_KIND_SELECTION   : u8 = 3;
pub const NR_KIND_CONNECTION  : u8 = 4;
pub const NR_KIND_INSPECTOR   : u8 = 5;
pub const NR_KIND_CONSTRUCTOR : u8 = 6;
pub const NR_KIND_UNKNOWN     : u8 = 7;
pub const NR_KIND_COUNT       : u8 = 7;

; ── Theme sentinels ───────────────────────────────────────────────────────────
pub const NR_THEME_LIGHT : str = "light";
pub const NR_THEME_DARK  : str = "dark";

; ── NlvLayout: viewport layout plan with slice pipeline output ────────────────
; Numbers only; a host (glass_window, Web) draws them from these values.
; node_count: graph nodes; hit_sentinel: nv_hit returns this value on no-hit.
pub struct NlvLayout {
    node_count   : u32,
    hit_sentinel : u32,
}

; ── NrPlan: tagged output for render_story ────────────────────────────────────
; kind discriminates which field is populated; others are zero-valued defaults.
pub struct NrPlan {
    kind        : u8,
    story_id    : str,
    theme       : str,
    toolbar     : NtvToolbarView,
    parts       : NpPalette,
    viewport    : NlvLayout,
    sel_badge   : NsvBadge,
    conn_line   : NcvLine,
    inspector   : NiData,
    constructor : NcvConstructorView,
}

; ── Per-story render helpers ──────────────────────────────────────────────────

pub fn nr_render_toolbar(theme: str) -> NtvToolbarView {
    let g   : NetlistGraph = inverter_graph();
    let sel : NvSelection  = nv_no_selection();
    let t   : NtToolbar    = nt_toolbar(sel, g);
    return ntv_toolbar_view(t, 0.0, 0.0);
}

pub fn nr_render_parts(theme: str) -> NpPalette {
    return np_default_palette();
}

pub fn nr_render_viewport(theme: str) -> NlvLayout {
    let p : NvPlan = nv_inverter_plan();
    var r : NlvLayout;
    r.node_count   = p.node_count;
    r.hit_sentinel = p.node_count;
    return r;
}

pub fn nr_render_selection(theme: str) -> NsvBadge {
    let g   : NetlistGraph = inverter_graph();
    let p   : NvPlan       = nv_layout(g);
    let sel : NvSelection  = nv_select_node(0);
    return nsv_badge_view(sel, g, p);
}

pub fn nr_render_connection(theme: str) -> NcvLine {
    let g    : NetlistGraph = inverter_graph();
    let p    : NvPlan       = nv_layout(g);
    var prev : NcPreview;
    prev.active   = true;
    prev.src_node = 0;
    prev.src_kind = NG_NODE_BLOCK;
    prev.dst_node = 1;
    prev.dst_kind = NG_NODE_PIN;
    return ncv_line_view(prev, g, p);
}

pub fn nr_render_inspector(theme: str) -> NiData {
    let g : NetlistGraph = inverter_graph();
    return ni_inspect(g, 0);
}

pub fn nr_render_constructor(theme: str) -> NcvConstructorView {
    let g    : NetlistGraph      = inverter_graph();
    let p    : NvPlan            = nv_layout(g);
    let sel  : NvSelection       = nv_no_selection();
    var prev : NcPreview         = nc_no_preview();
    let state : NnetlistConstructor = nc_constructor_state(sel, g, prev);
    return ncv_constructor_view(state, sel, g, prev, p, 0.0, 0.0);
}

; ── render_story: main dispatcher ────────────────────────────────────────────
; Dispatches story_id to the correct constructor view type.
; Returns NrPlan with kind == NR_KIND_UNKNOWN when story_id is not recognised.
pub fn render_story(story_id: str, theme: str) -> NrPlan {
    var plan : NrPlan;
    plan.story_id = story_id;
    plan.theme    = theme;
    if (story_id == NR_STORY_TOOLBAR) {
        plan.kind    = NR_KIND_TOOLBAR;
        plan.toolbar = nr_render_toolbar(theme);
        return plan;
    }
    if (story_id == NR_STORY_PARTS) {
        plan.kind  = NR_KIND_PARTS;
        plan.parts = nr_render_parts(theme);
        return plan;
    }
    if (story_id == NR_STORY_VIEWPORT) {
        plan.kind     = NR_KIND_VIEWPORT;
        plan.viewport = nr_render_viewport(theme);
        return plan;
    }
    if (story_id == NR_STORY_SELECTION) {
        plan.kind      = NR_KIND_SELECTION;
        plan.sel_badge = nr_render_selection(theme);
        return plan;
    }
    if (story_id == NR_STORY_CONNECTION) {
        plan.kind      = NR_KIND_CONNECTION;
        plan.conn_line = nr_render_connection(theme);
        return plan;
    }
    if (story_id == NR_STORY_INSPECTOR) {
        plan.kind      = NR_KIND_INSPECTOR;
        plan.inspector = nr_render_inspector(theme);
        return plan;
    }
    if (story_id == NR_STORY_CONSTRUCTOR) {
        plan.kind        = NR_KIND_CONSTRUCTOR;
        plan.constructor = nr_render_constructor(theme);
        return plan;
    }
    plan.kind = NR_KIND_UNKNOWN;
    return plan;
}

; ── Tests (L4: one per story dispatch) ───────────────────────────────────────

test toolbar_story_kind {
    let p : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_TOOLBAR;
}

test toolbar_story_btn_count {
    let p : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_LIGHT);
    assert p.toolbar.btn_count == NTV_ACTION_COUNT;
}

test parts_story_kind {
    let p : NrPlan = render_story(NR_STORY_PARTS, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_PARTS;
}

test parts_story_count {
    let p : NrPlan = render_story(NR_STORY_PARTS, NR_THEME_LIGHT);
    assert p.parts.part_count == 5;
}

test viewport_story_kind {
    let p : NrPlan = render_story(NR_STORY_VIEWPORT, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_VIEWPORT;
}

test viewport_story_node_count {
    let p : NrPlan = render_story(NR_STORY_VIEWPORT, NR_THEME_DARK);
    assert p.viewport.node_count > 0;
}

test selection_story_kind {
    let p : NrPlan = render_story(NR_STORY_SELECTION, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_SELECTION;
}

test selection_story_badge_visible {
    let p : NrPlan = render_story(NR_STORY_SELECTION, NR_THEME_LIGHT);
    assert p.sel_badge.visible == true;
}

test connection_story_kind {
    let p : NrPlan = render_story(NR_STORY_CONNECTION, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_CONNECTION;
}

test connection_story_line_visible {
    let p : NrPlan = render_story(NR_STORY_CONNECTION, NR_THEME_DARK);
    assert p.conn_line.visible == true;
}

test inspector_story_kind {
    let p : NrPlan = render_story(NR_STORY_INSPECTOR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_INSPECTOR;
}

test inspector_story_has_node {
    let p : NrPlan = render_story(NR_STORY_INSPECTOR, NR_THEME_LIGHT);
    assert p.inspector.node_idx == 0;
}

test constructor_story_kind {
    let p : NrPlan = render_story(NR_STORY_CONSTRUCTOR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_CONSTRUCTOR;
}

test constructor_story_toolbar_btn_count {
    let p : NrPlan = render_story(NR_STORY_CONSTRUCTOR, NR_THEME_DARK);
    assert p.constructor.toolbar_view.btn_count == NTV_ACTION_COUNT;
}

test unknown_story_kind {
    let p : NrPlan = render_story("netlist-nonexistent", NR_THEME_LIGHT);
    assert p.kind == NR_KIND_UNKNOWN;
}

test theme_preserved_in_plan {
    let p : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_DARK);
    assert p.theme == NR_THEME_DARK;
}

test story_id_preserved_in_plan {
    let p : NrPlan = render_story(NR_STORY_PARTS, NR_THEME_LIGHT);
    assert p.story_id == NR_STORY_PARTS;
}

; ── Invariants ────────────────────────────────────────────────────────────────

invariant kind_discriminants_distinct {
    assert NR_KIND_TOOLBAR     != NR_KIND_PARTS;
    assert NR_KIND_PARTS       != NR_KIND_VIEWPORT;
    assert NR_KIND_VIEWPORT    != NR_KIND_SELECTION;
    assert NR_KIND_SELECTION   != NR_KIND_CONNECTION;
    assert NR_KIND_CONNECTION  != NR_KIND_INSPECTOR;
    assert NR_KIND_INSPECTOR   != NR_KIND_CONSTRUCTOR;
    assert NR_KIND_CONSTRUCTOR != NR_KIND_UNKNOWN;
    assert NR_KIND_COUNT       == 7;
}

invariant theme_light_dark_distinct {
    assert NR_THEME_LIGHT != NR_THEME_DARK;
}

invariant story_ids_distinct {
    assert NR_STORY_TOOLBAR     != NR_STORY_PARTS;
    assert NR_STORY_PARTS       != NR_STORY_VIEWPORT;
    assert NR_STORY_VIEWPORT    != NR_STORY_SELECTION;
    assert NR_STORY_SELECTION   != NR_STORY_CONNECTION;
    assert NR_STORY_CONNECTION  != NR_STORY_INSPECTOR;
    assert NR_STORY_INSPECTOR   != NR_STORY_CONSTRUCTOR;
}

invariant toolbar_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_TOOLBAR;
}

invariant parts_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_PARTS, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_PARTS;
    assert p.parts.part_count > 0;
}

invariant viewport_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_VIEWPORT, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_VIEWPORT;
    assert p.viewport.node_count > 0;
}

invariant selection_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_SELECTION, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_SELECTION;
    assert p.sel_badge.visible == true;
}

invariant connection_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_CONNECTION, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_CONNECTION;
    assert p.conn_line.visible == true;
}

invariant inspector_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_INSPECTOR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_INSPECTOR;
    assert p.inspector.kind_name != "";
}

invariant constructor_plan_non_empty {
    let p : NrPlan = render_story(NR_STORY_CONSTRUCTOR, NR_THEME_LIGHT);
    assert p.kind == NR_KIND_CONSTRUCTOR;
    assert p.constructor.toolbar_view.btn_count == NTV_ACTION_COUNT;
}

invariant light_dark_give_same_kind {
    let pl : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_LIGHT);
    let pd : NrPlan = render_story(NR_STORY_TOOLBAR, NR_THEME_DARK);
    assert pl.kind == pd.kind;
    assert pl.theme != pd.theme;
}
