// SPDX-License-Identifier: Apache-2.0
; specs/uikit/stories_plate.t27 -- Plate stories for UIKit Wave 1.
; Every story is built only by calling pl_create / pl_set_state / pl_set_theme from plate.t27;
; no geometry, colour or op layout is copied here.
; Refs #13852.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_stories_plate;

use uikit::plate;

pub const STORY_PLATE_FLAT_DEFAULT    : str = "plate-flat-default";
pub const STORY_PLATE_RAISED_DEFAULT  : str = "plate-raised-default";
pub const STORY_PLATE_FLAT_PRESSED    : str = "plate-flat-pressed";
pub const STORY_PLATE_FLAT_DISABLED   : str = "plate-flat-disabled";
pub const STORY_PLATE_FLAT_LOADING    : str = "plate-flat-loading";
pub const STORY_PLATE_FLAT_LIGHT      : str = "plate-flat-light";

pub const STORY_PLATE_COMPONENT : str = "plate";
pub const STORY_PLATE_SPEC_PATH : str = "specs/uikit/stories_plate.t27";

/// Fixed width the op tests measure at.
pub const STORY_PLATE_AVAIL_W : u32 = 320;

pub fn story_plate_flat_default() -> Plate {
    return pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0);
}

pub fn story_plate_raised_default() -> Plate {
    return pl_create(PL_VARIANT_RAISED, PL_SIZE_M, 0);
}

pub fn story_plate_flat_pressed() -> Plate {
    return pl_set_state(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_STATE_PRESSED);
}

pub fn story_plate_flat_disabled() -> Plate {
    return pl_set_state(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_STATE_DISABLED);
}

pub fn story_plate_flat_loading() -> Plate {
    return pl_set_theme(pl_set_state(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_STATE_LOADING), PL_THEME_DARK);
}

pub fn story_plate_flat_light() -> Plate {
    return pl_set_theme(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_THEME_LIGHT);
}

test story_plate_ids_unique {
    assert STORY_PLATE_FLAT_DEFAULT   != STORY_PLATE_RAISED_DEFAULT;
    assert STORY_PLATE_FLAT_DEFAULT   != STORY_PLATE_FLAT_PRESSED;
    assert STORY_PLATE_FLAT_DEFAULT   != STORY_PLATE_FLAT_DISABLED;
    assert STORY_PLATE_FLAT_DEFAULT   != STORY_PLATE_FLAT_LOADING;
    assert STORY_PLATE_FLAT_DEFAULT   != STORY_PLATE_FLAT_LIGHT;
    assert STORY_PLATE_RAISED_DEFAULT != STORY_PLATE_FLAT_PRESSED;
    assert STORY_PLATE_RAISED_DEFAULT != STORY_PLATE_FLAT_DISABLED;
    assert STORY_PLATE_RAISED_DEFAULT != STORY_PLATE_FLAT_LOADING;
    assert STORY_PLATE_RAISED_DEFAULT != STORY_PLATE_FLAT_LIGHT;
    assert STORY_PLATE_FLAT_PRESSED   != STORY_PLATE_FLAT_DISABLED;
    assert STORY_PLATE_FLAT_PRESSED   != STORY_PLATE_FLAT_LOADING;
    assert STORY_PLATE_FLAT_PRESSED   != STORY_PLATE_FLAT_LIGHT;
    assert STORY_PLATE_FLAT_DISABLED  != STORY_PLATE_FLAT_LOADING;
    assert STORY_PLATE_FLAT_DISABLED  != STORY_PLATE_FLAT_LIGHT;
    assert STORY_PLATE_FLAT_LOADING   != STORY_PLATE_FLAT_LIGHT;
}

test story_plate_op_count_matches_plate {
    const p : Plate = story_plate_raised_default();
    assert pl_op_count(p) == pl_op_count(pl_create(PL_VARIANT_RAISED, PL_SIZE_M, 0));
    const q : Plate = story_plate_flat_loading();
    assert pl_op_count(q) == pl_op_count(pl_set_state(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_STATE_LOADING));
}

test story_plate_op0_matches_plate {
    const p : Plate = story_plate_flat_pressed();
    const a : PlOp = pl_op(p, STORY_PLATE_AVAIL_W, 0);
    const b : PlOp = pl_op(pl_set_state(pl_create(PL_VARIANT_FLAT, PL_SIZE_M, 0), PL_STATE_PRESSED), STORY_PLATE_AVAIL_W, 0);
    assert a.kind == b.kind;
    assert a.role == b.role;
    assert a.x == b.x;
    assert a.y == b.y;
    assert a.w == b.w;
    assert a.h == b.h;
    assert a.radius == b.radius;
    assert a.stroke == b.stroke;
    assert a.alpha == b.alpha;
    assert a.icon == b.icon;
}

test story_plate_theme_switch_keeps_state {
    const p : Plate = story_plate_flat_disabled();
    const l : Plate = pl_set_theme(p, PL_THEME_LIGHT);
    assert l.state == p.state;
    assert l.theme == PL_THEME_LIGHT;
    assert l.cfg.variant == p.cfg.variant;
}

invariant story_plate_light_story_is_light_default_state {
    const p : Plate = story_plate_flat_light();
    assert p.theme == PL_THEME_LIGHT;
    assert p.state == PL_STATE_DEFAULT;
}

invariant story_plate_spec_path_matches_file {
    assert STORY_PLATE_SPEC_PATH == "specs/uikit/stories_plate.t27";
    assert STORY_PLATE_COMPONENT == "plate";
}
