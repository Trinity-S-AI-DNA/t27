// SPDX-License-Identifier: Apache-2.0
; specs/uikit/input_model.t27 -- the behaviour of the UI Kit Input: text, cursor, focus, keys.
; The text is a run of UTF-16 code units (what AppKit's characterAtIndex: hands over), four units per u64
; word, so a Cyrillic letter is one unit and never a split byte. Drawing turns the units into UTF-8 with
; im_utf8. Only the Basic Multilingual Plane is taken: a surrogate, a control character and AppKit's
; function-key range (0xF700..0xF8FF, the arrows' "characters") are refused, never stored.
; A native host keeps the words in its own state and calls these functions; it holds no rule of its own.
; Refs #13251, #13710.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_input_model;

; ── Capacity ────────────────────────────────────────────────────────────────
pub const IM_MAX_UNITS : u32 = 24;
pub const IM_UNITS_PER_WORD : u32 = 4;
pub const IM_WORDS : u32 = 6;
; the longest UTF-8 a BMP unit can take is 3 bytes
pub const IM_UTF8_MAX : u32 = 72;

; ── Key actions (macOS virtual key codes) ───────────────────────────────────
pub const IM_ACT_CHAR  : u32 = 0;
pub const IM_ACT_BLUR  : u32 = 1;
pub const IM_ACT_BACK  : u32 = 2;
pub const IM_ACT_DEL   : u32 = 3;
pub const IM_ACT_LEFT  : u32 = 4;
pub const IM_ACT_RIGHT : u32 = 5;
pub const IM_ACT_HOME  : u32 = 6;
pub const IM_ACT_END   : u32 = 7;

pub const IM_KEY_RETURN : u64 = 36;
pub const IM_KEY_ENTER  : u64 = 76;
pub const IM_KEY_ESCAPE : u64 = 53;
pub const IM_KEY_BACK   : u64 = 51;
pub const IM_KEY_DEL    : u64 = 117;
pub const IM_KEY_LEFT   : u64 = 123;
pub const IM_KEY_RIGHT  : u64 = 124;
pub const IM_KEY_HOME   : u64 = 115;
pub const IM_KEY_END    : u64 = 119;

/// What a key does to a focused Input. Every key that is not an edit or a move types its characters.
pub fn im_key_action(key: u64) -> u32 {
    if (key == IM_KEY_ESCAPE or key == IM_KEY_RETURN or key == IM_KEY_ENTER) { return IM_ACT_BLUR; }
    if (key == IM_KEY_BACK) { return IM_ACT_BACK; }
    if (key == IM_KEY_DEL) { return IM_ACT_DEL; }
    if (key == IM_KEY_LEFT) { return IM_ACT_LEFT; }
    if (key == IM_KEY_RIGHT) { return IM_ACT_RIGHT; }
    if (key == IM_KEY_HOME) { return IM_ACT_HOME; }
    if (key == IM_KEY_END) { return IM_ACT_END; }
    return IM_ACT_CHAR;
}

/// Whether a code unit may be stored when the text holds len units.
pub fn im_accepts(len: u32, ch: u32) -> bool {
    if (len >= IM_MAX_UNITS) { return false; }
    if (ch < 32 or ch == 127) { return false; }
    if (ch >= 128 and ch < 160) { return false; }
    if (ch >= 55296 and ch < 57344) { return false; }
    if (ch >= 63232 and ch < 63744) { return false; }
    return ch < 65536;
}

/// Whether an Input in this catalog state takes focus and keys (STATE_DISABLED is 3 in uikit_catalog).
pub fn im_editable(state: u64) -> bool {
    return state != 3;
}

/// The unit at index i.
pub fn im_unit(w: []const u64, i: u32) -> u32 {
    const wi : usize = @as(usize, i / IM_UNITS_PER_WORD);
    const sh : u64 = @as(u64, (i % IM_UNITS_PER_WORD) * 16);
    return @as(u32, @intCast((w[wi] >> sh) & 65535));
}

/// Store unit ch at index i.
pub fn im_set(w: []u64, i: u32, ch: u32) -> void {
    const wi : usize = @as(usize, i / IM_UNITS_PER_WORD);
    const sh : u64 = @as(u64, (i % IM_UNITS_PER_WORD) * 16);
    const mask : u64 = @as(u64, 65535) << sh;
    const kept : u64 = w[wi] - (w[wi] & mask);
    w[wi] = kept | ((@as(u64, ch) & 65535) << sh);
}

/// Insert ch before the cursor; the new length, or len unchanged when refused.
pub fn im_insert(w: []u64, len: u32, cur: u32, ch: u32) -> u32 {
    if (im_accepts(len, ch) == false) { return len; }
    var at : u32 = cur;
    if (at > len) { at = len; }
    var k : u32 = len;
    while (k > at) {
        im_set(w, k, im_unit(w, k - 1));
        k = k - 1;
    }
    im_set(w, at, ch);
    return len + 1;
}

/// Remove the unit at index at (at < len); the new length.
pub fn im_remove(w: []u64, len: u32, at: u32) -> u32 {
    if (at >= len) { return len; }
    var k : u32 = at;
    while (k + 1 < len) {
        im_set(w, k, im_unit(w, k + 1));
        k = k + 1;
    }
    im_set(w, len - 1, 0);
    return len - 1;
}

/// The cursor after a move action, kept inside 0..len.
pub fn im_move(act: u32, len: u32, cur: u32) -> u32 {
    var c : u32 = cur;
    if (c > len) { c = len; }
    if (act == IM_ACT_LEFT and c > 0) { return c - 1; }
    if (act == IM_ACT_RIGHT and c < len) { return c + 1; }
    if (act == IM_ACT_HOME) { return 0; }
    if (act == IM_ACT_END) { return len; }
    return c;
}

/// UTF-8 of the first n units into out; the bytes written. Stops before a unit that does not fit.
pub fn im_utf8(w: []const u64, n: u32, out: []u8) -> usize {
    var b : usize = 0;
    var i : u32 = 0;
    while (i < n) {
        const u : u32 = im_unit(w, i);
        if (u < 128) {
            if (b + 1 > out.len) { return b; }
            out[b] = @as(u8, @intCast(u));
            b = b + 1;
        } else if (u < 2048) {
            if (b + 2 > out.len) { return b; }
            out[b] = @as(u8, @intCast(192 | (u >> 6)));
            out[b + 1] = @as(u8, @intCast(128 | (u & 63)));
            b = b + 2;
        } else {
            if (b + 3 > out.len) { return b; }
            out[b] = @as(u8, @intCast(224 | (u >> 12)));
            out[b + 1] = @as(u8, @intCast(128 | ((u >> 6) & 63)));
            out[b + 2] = @as(u8, @intCast(128 | (u & 63)));
            b = b + 3;
        }
        i = i + 1;
    }
    return b;
}

; ── Tests ───────────────────────────────────────────────────────────────────
test capacity_fits_the_words {
    assert IM_WORDS * IM_UNITS_PER_WORD == IM_MAX_UNITS;
    assert IM_UTF8_MAX == IM_MAX_UNITS * 3;
}

test keys_map_to_actions {
    assert im_key_action(53) == IM_ACT_BLUR;
    assert im_key_action(36) == IM_ACT_BLUR;
    assert im_key_action(51) == IM_ACT_BACK;
    assert im_key_action(117) == IM_ACT_DEL;
    assert im_key_action(123) == IM_ACT_LEFT;
    assert im_key_action(124) == IM_ACT_RIGHT;
    assert im_key_action(17) == IM_ACT_CHAR;
    assert im_key_action(3) == IM_ACT_CHAR;
}

test accepts_cyrillic_and_refuses_control_and_function_keys {
    assert im_accepts(0, 80);
    assert im_accepts(0, 1055);
    assert im_accepts(0, 32);
    assert im_accepts(0, 9) == false;
    assert im_accepts(0, 127) == false;
    assert im_accepts(0, 63234) == false;
    assert im_accepts(0, 55357) == false;
    assert im_accepts(24, 80) == false;
}

test disabled_state_is_not_editable {
    assert im_editable(0);
    assert im_editable(2);
    assert im_editable(3) == false;
}

test typing_privet_t27_then_cursor_edit {
    var w : [6]u64 = undefined;
    var z : usize = 0;
    while (z < 6) {
        w[z] = 0;
        z = z + 1;
    }
    // P r i v e t (Cyrillic) space T 2 7
    var s : [10]u32 = undefined;
    s[0] = 1055;
    s[1] = 1088;
    s[2] = 1080;
    s[3] = 1074;
    s[4] = 1077;
    s[5] = 1090;
    s[6] = 32;
    s[7] = 84;
    s[8] = 50;
    s[9] = 55;
    var len : u32 = 0;
    var cur : u32 = 0;
    var i : usize = 0;
    while (i < 10) {
        len = im_insert(w[0..6], len, cur, s[i]);
        cur = cur + 1;
        i = i + 1;
    }
    assert len == 10;
    var out : [72]u8 = undefined;
    assert im_utf8(w[0..6], len, out[0..72]) == 16;
    assert out[0] == 208;
    assert out[1] == 159;
    assert out[12] == 32;
    assert out[13] == 84;
    // cursor left three times, then Backspace removes the space before T
    cur = im_move(IM_ACT_LEFT, len, cur);
    cur = im_move(IM_ACT_LEFT, len, cur);
    cur = im_move(IM_ACT_LEFT, len, cur);
    assert cur == 7;
    len = im_remove(w[0..6], len, cur - 1);
    cur = cur - 1;
    assert len == 9;
    assert im_unit(w[0..6], 5) == 1090;
    assert im_unit(w[0..6], 6) == 84;
    assert im_unit(w[0..6], 8) == 55;
    assert im_utf8(w[0..6], len, out[0..72]) == 15;
    // a unit inserted at the cursor lands between the Cyrillic and the Latin
    len = im_insert(w[0..6], len, cur, 33);
    assert im_unit(w[0..6], 6) == 33;
    assert im_unit(w[0..6], 7) == 84;
}

test moves_stay_inside_the_text {
    assert im_move(IM_ACT_LEFT, 5, 0) == 0;
    assert im_move(IM_ACT_RIGHT, 5, 5) == 5;
    assert im_move(IM_ACT_HOME, 5, 3) == 0;
    assert im_move(IM_ACT_END, 5, 1) == 5;
    assert im_move(IM_ACT_LEFT, 5, 9) == 4;
}

test full_text_refuses_one_more {
    var w : [6]u64 = undefined;
    var z : usize = 0;
    while (z < 6) {
        w[z] = 0;
        z = z + 1;
    }
    var len : u32 = 0;
    var k : u32 = 0;
    while (k < 30) {
        len = im_insert(w[0..6], len, len, 65);
        k = k + 1;
    }
    assert len == IM_MAX_UNITS;
}

invariant packing_round_trips {
    var w : [6]u64 = undefined;
    var z : usize = 0;
    while (z < 6) {
        w[z] = 0;
        z = z + 1;
    }
    im_set(w[0..6], 5, 1103);
    im_set(w[0..6], 4, 65);
    assert im_unit(w[0..6], 5) == 1103;
    assert im_unit(w[0..6], 4) == 65;
    assert im_unit(w[0..6], 6) == 0;
}
