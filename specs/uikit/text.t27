// SPDX-License-Identifier: Apache-2.0
; specs/uikit/text.t27 -- UI Kit object TEXT (Wave 1, milestone M1).
; Epic #13426, issue #13758.
; Variants: body, label, caption, mono. Content = text id + length in glyphs.
; measure uses font size and line height tokens; render is one text op with role ink.
; Ops are relative to the object's own 0,0. No colour literals; roles only.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_text;

; -- Variants --------------------------------------------------------------
pub const TX_BODY    : u8 = 0;
pub const TX_LABEL   : u8 = 1;
pub const TX_CAPTION : u8 = 2;
pub const TX_MONO    : u8 = 3;
pub const TX_VARIANTS : u8 = 4;

; -- States (0..5) ---------------------------------------------------------
pub const TX_ST_DEFAULT  : u8 = 0;
pub const TX_ST_HOVER    : u8 = 1;
pub const TX_ST_PRESSED  : u8 = 2;
pub const TX_ST_FOCUS    : u8 = 3;
pub const TX_ST_DISABLED : u8 = 4;
pub const TX_ST_LOADING  : u8 = 5;
pub const TX_STATES      : u8 = 6;

; -- Themes ----------------------------------------------------------------
pub const TX_DARK  : u8 = 0;
pub const TX_LIGHT : u8 = 1;

; -- Role names (never colour literals) ------------------------------------
pub const ROLE_SURFACE : u8 = 0;
pub const ROLE_INK     : u8 = 1;
pub const ROLE_ACCENT  : u8 = 2;
pub const ROLE_DANGER  : u8 = 3;
pub const ROLE_SUCCESS : u8 = 4;
pub const ROLE_LINE    : u8 = 5;

; -- Op kinds --------------------------------------------------------------
pub const OP_NONE : u8 = 0;
pub const OP_RECT : u8 = 1;
pub const OP_TEXT : u8 = 2;
pub const OP_ICON : u8 = 3;
pub const TX_MAX_OPS : u8 = 1;

; -- Token sizes in px. Mirrors specs/uikit/design_tokens.t27 FONT_SIZE_*
; -- (those are strings, so numeric mirrors live here). Line heights are
; -- PROPOSED TOKEN (design_tokens has none).
pub const TX_SIZE_XS   : u32 = 11;
pub const TX_SIZE_MD   : u32 = 14;
pub const TX_SIZE_BASE : u32 = 15;
pub const TX_LINE_XS   : u32 = 16;
pub const TX_LINE_MD   : u32 = 20;
pub const TX_LINE_BASE : u32 = 22;
; PROPOSED TOKEN: glyph advance = size * ADV_NUM / ADV_DEN (same for mono).
pub const TX_ADV_NUM : u32 = 6;
pub const TX_ADV_DEN : u32 = 10;

; -- Alpha (0..255) from state; disabled lowers it ---------------------------
pub const TX_ALPHA_FULL     : u32 = 255;
pub const TX_ALPHA_LOADING  : u32 = 160;
pub const TX_ALPHA_DISABLED : u32 = 100;

; -- Config ----------------------------------------------------------------
pub struct TextConfig {
    variant : u8,
    text_id : u32,
    len     : u32,
    ok      : bool,
    alive   : bool,
}

pub struct TextSize {
    w : u32,
    h : u32,
}

pub struct TextOp {
    kind    : u8,
    x       : u32,
    y       : u32,
    w       : u32,
    h       : u32,
    role    : u8,
    alpha   : u32,
    text_id : u32,
    flags   : u8,
}

pub struct TextRender {
    count : u8,
    op0   : TextOp,
}

pub fn tx_font_size(variant: u8) -> u32 {
    if (variant == TX_BODY)    { return TX_SIZE_BASE; }
    if (variant == TX_CAPTION) { return TX_SIZE_XS; }
    return TX_SIZE_MD;
}

pub fn tx_line_height(variant: u8) -> u32 {
    if (variant == TX_BODY)    { return TX_LINE_BASE; }
    if (variant == TX_CAPTION) { return TX_LINE_XS; }
    return TX_LINE_MD;
}

; Create: empty text or unknown variant is refused (ok = false, inert).
pub fn tx_create(variant: u8, text_id: u32, len: u32) -> TextConfig {
    var c : TextConfig;
    c.variant = variant;
    c.text_id = text_id;
    c.len     = len;
    c.ok      = true;
    c.alive   = true;
    if (len == 0) { c.ok = false; c.alive = false; }
    if (variant >= TX_VARIANTS) { c.ok = false; c.alive = false; }
    return c;
}

; Natural (unwrapped) width in px.
pub fn tx_natural_w(c: TextConfig) -> u32 {
    let adv : u32 = tx_font_size(c.variant) * TX_ADV_NUM / TX_ADV_DEN;
    return c.len * adv;
}

; Measure from token sizes only; wraps into lines when avail_w is smaller.
pub fn tx_measure(c: TextConfig, avail_w: u32) -> TextSize {
    var s : TextSize;
    s.w = 0;
    s.h = 0;
    if (c.ok == false) { return s; }
    let lh  : u32 = tx_line_height(c.variant);
    let nat : u32 = tx_natural_w(c);
    if (avail_w == 0 || nat <= avail_w) {
        s.w = nat;
        s.h = lh;
        return s;
    }
    s.w = avail_w;
    s.h = ((nat + avail_w - 1) / avail_w) * lh;
    return s;
}

; State validity (0..5); out-of-range refused.
pub fn tx_state_valid(state: u8) -> bool {
    return state < TX_STATES;
}

; Non-colour property per state (state never by colour alone):
; 0 none, 1 underline, 2 inset, 3 outline 2px, 4 strike flag, 5 ellipsis icon.
pub fn tx_state_mark(state: u8) -> u8 {
    return state;
}

pub fn tx_state_alpha(state: u8) -> u32 {
    if (state == TX_ST_DISABLED) { return TX_ALPHA_DISABLED; }
    if (state == TX_ST_LOADING)  { return TX_ALPHA_LOADING; }
    return TX_ALPHA_FULL;
}

; Theme bind: Light is the inverse of Dark for surface and ink.
pub fn tx_theme_ink_light(theme: u8) -> bool {
    return theme == TX_DARK;
}

pub fn tx_theme_surface_light(theme: u8) -> bool {
    return theme == TX_LIGHT;
}

; Render: one text op, role ink. Refused state or dead object gives no ops.
pub fn tx_render(c: TextConfig, state: u8, avail_w: u32) -> TextRender {
    var r : TextRender;
    r.count = 0;
    r.op0.kind = OP_NONE;
    r.op0.x = 0;
    r.op0.y = 0;
    r.op0.w = 0;
    r.op0.h = 0;
    r.op0.role = ROLE_INK;
    r.op0.alpha = 0;
    r.op0.text_id = 0;
    r.op0.flags = 0;
    if (c.ok == false || c.alive == false) { return r; }
    if (tx_state_valid(state) == false) { return r; }
    let s : TextSize = tx_measure(c, avail_w);
    r.count = 1;
    r.op0.kind = OP_TEXT;
    r.op0.w = s.w;
    r.op0.h = s.h;
    r.op0.role = ROLE_INK;
    r.op0.alpha = tx_state_alpha(state);
    r.op0.text_id = c.text_id;
    r.op0.flags = tx_state_mark(state);
    return r;
}

; Hit test relative to the object's own box; disposed object is a miss.
pub fn tx_hit_test(c: TextConfig, avail_w: u32, x: u32, y: u32) -> bool {
    if (c.ok == false || c.alive == false) { return false; }
    let s : TextSize = tx_measure(c, avail_w);
    return x < s.w && y < s.h;
}

; a11y name is the text itself: non-empty by construction.
pub fn tx_a11y_len(c: TextConfig) -> u32 {
    if (c.ok == false || c.alive == false) { return 0; }
    return c.len;
}

pub fn tx_dispose(c: TextConfig) -> TextConfig {
    var d : TextConfig = c;
    d.ok = false;
    d.alive = false;
    d.len = 0;
    d.text_id = 0;
    return d;
}

; -- Tests -----------------------------------------------------------------
test create_ok {
    let c : TextConfig = tx_create(TX_BODY, 7, 10);
    assert c.ok == true;
    assert c.len == 10;
}

test create_empty_refused {
    let c : TextConfig = tx_create(TX_LABEL, 7, 0);
    assert c.ok == false;
}

test create_bad_variant_refused {
    let c : TextConfig = tx_create(9, 7, 5);
    assert c.ok == false;
}

test measure_body_single_line {
    let c : TextConfig = tx_create(TX_BODY, 1, 10);
    let s : TextSize = tx_measure(c, 1000);
    assert s.w == 90;
    assert s.h == 22;
}

test measure_caption_uses_xs_tokens {
    let c : TextConfig = tx_create(TX_CAPTION, 1, 10);
    let s : TextSize = tx_measure(c, 1000);
    assert s.w == 60;
    assert s.h == 16;
}

test measure_label_and_mono_share_md {
    let a : TextSize = tx_measure(tx_create(TX_LABEL, 1, 10), 1000);
    let b : TextSize = tx_measure(tx_create(TX_MONO, 1, 10), 1000);
    assert a.w == b.w;
    assert a.h == 20;
}

test measure_wraps_to_lines {
    let c : TextConfig = tx_create(TX_BODY, 1, 20);
    let s : TextSize = tx_measure(c, 90);
    assert s.w == 90;
    assert s.h == 44;
}

test render_one_text_op_role_ink {
    let c : TextConfig = tx_create(TX_BODY, 3, 10);
    let r : TextRender = tx_render(c, TX_ST_DEFAULT, 1000);
    assert r.count == 1;
    assert r.op0.kind == OP_TEXT;
    assert r.op0.role == ROLE_INK;
    assert r.op0.x == 0;
    assert r.op0.y == 0;
    assert r.op0.alpha == 255;
}

test render_disabled_lowers_alpha_and_flags {
    let c : TextConfig = tx_create(TX_BODY, 3, 10);
    let r : TextRender = tx_render(c, TX_ST_DISABLED, 1000);
    assert r.op0.alpha == 100;
    assert r.op0.flags == 4;
}

test render_bad_state_refused {
    let c : TextConfig = tx_create(TX_BODY, 3, 10);
    let r : TextRender = tx_render(c, 6, 1000);
    assert r.count == 0;
}

test hit_test_inside_and_outside {
    let c : TextConfig = tx_create(TX_BODY, 3, 10);
    assert tx_hit_test(c, 1000, 5, 5) == true;
    assert tx_hit_test(c, 1000, 90, 5) == false;
    assert tx_hit_test(c, 1000, 5, 22) == false;
}

test state_validity_range {
    assert tx_state_valid(0) == true;
    assert tx_state_valid(5) == true;
    assert tx_state_valid(6) == false;
}

test state_alpha_values {
    assert tx_state_alpha(TX_ST_DEFAULT) == 255;
    assert tx_state_alpha(TX_ST_LOADING) == 160;
    assert tx_state_alpha(TX_ST_DISABLED) == 100;
}

test theme_light_inverts_dark {
    assert tx_theme_ink_light(TX_DARK) != tx_theme_ink_light(TX_LIGHT);
    assert tx_theme_surface_light(TX_DARK) != tx_theme_surface_light(TX_LIGHT);
    assert tx_theme_ink_light(TX_DARK) != tx_theme_surface_light(TX_DARK);
}

test a11y_name_is_the_text {
    let c : TextConfig = tx_create(TX_MONO, 4, 12);
    assert tx_a11y_len(c) == 12;
    assert tx_a11y_len(tx_create(TX_MONO, 4, 0)) == 0;
}

test non_default_states_change_non_colour_mark {
    assert tx_state_mark(1) != tx_state_mark(0);
    assert tx_state_mark(2) != tx_state_mark(0);
    assert tx_state_mark(3) != tx_state_mark(0);
    assert tx_state_mark(4) != tx_state_mark(0);
    assert tx_state_mark(5) != tx_state_mark(0);
}

test dispose_makes_inert {
    let c : TextConfig = tx_create(TX_BODY, 3, 10);
    let d : TextConfig = tx_dispose(c);
    assert tx_hit_test(d, 1000, 1, 1) == false;
    assert tx_render(d, TX_ST_DEFAULT, 1000).count == 0;
}

invariant measure_never_exceeds_avail {
    let c : TextConfig = tx_create(TX_BODY, 1, 50);
    let s : TextSize = tx_measure(c, 100);
    assert s.w <= 100;
}

invariant max_ops_bound {
    let r : TextRender = tx_render(tx_create(TX_BODY, 1, 5), TX_ST_HOVER, 500);
    assert r.count <= TX_MAX_OPS;
}
