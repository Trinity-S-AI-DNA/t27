; specs/uikit/object_registry.t27 -- registry of UI Kit objects (M0).
; T27 OS composes only registered objects. Lookup by name is total: an unknown
;   name returns REG_REFUSED, never a default row.
; Row = name, status (0 planned, 1 accepted), issue (0 = none yet), story id,
;   and eight contract flags (bit mask, see REG_F_*).
; Refs #13756, epic #13426.
; phi^2 + 1/phi^2 = 3 | TRINITY
; ASCII only (L3).
module uikit_object_registry;

pub const REG_COUNT    : u32 = 23;
pub const REG_REFUSED  : u32 = 4294967295;

pub const REG_PLANNED  : u32 = 0;
pub const REG_ACCEPTED : u32 = 1;

pub const REG_F_CREATE     : u32 = 1;
pub const REG_F_LAYOUT     : u32 = 2;
pub const REG_F_RENDER     : u32 = 4;
pub const REG_F_HIT_TEST   : u32 = 8;
pub const REG_F_STATE      : u32 = 16;
pub const REG_F_THEME_BIND : u32 = 32;
pub const REG_F_A11Y_NAME  : u32 = 64;
pub const REG_F_DISPOSE    : u32 = 128;
pub const REG_F_ALL        : u32 = 255;

pub fn reg_name(i: u32) -> str {
    if (i == 0) { return "Text"; }
    if (i == 1) { return "Container"; }
    if (i == 2) { return "Button"; }
    if (i == 3) { return "IconButton"; }
    if (i == 4) { return "ThemePill"; }
    if (i == 5) { return "GodModeToggle"; }
    if (i == 6) { return "Avatar"; }
    if (i == 7) { return "HeaderCluster"; }
    if (i == 8) { return "TitleBar"; }
    if (i == 9) { return "WindowControls"; }
    if (i == 10) { return "SideNav"; }
    if (i == 11) { return "HeroCard"; }
    if (i == 12) { return "StatCell"; }
    if (i == 13) { return "SegmentBar"; }
    if (i == 14) { return "SectionPanel"; }
    if (i == 15) { return "AreaCell"; }
    if (i == 16) { return "Tile"; }
    if (i == 17) { return "Placeholder"; }
    if (i == 18) { return "AddTile"; }
    if (i == 19) { return "BracketFrame"; }
    if (i == 20) { return "Plate"; }
    if (i == 21) { return "Lamp"; }
    if (i == 22) { return "LightDot"; }
    return "";
}

pub fn reg_find(name: str) -> u32 {
    if (name == "Text") { return 0; }
    if (name == "Container") { return 1; }
    if (name == "Button") { return 2; }
    if (name == "IconButton") { return 3; }
    if (name == "ThemePill") { return 4; }
    if (name == "GodModeToggle") { return 5; }
    if (name == "Avatar") { return 6; }
    if (name == "HeaderCluster") { return 7; }
    if (name == "TitleBar") { return 8; }
    if (name == "WindowControls") { return 9; }
    if (name == "SideNav") { return 10; }
    if (name == "HeroCard") { return 11; }
    if (name == "StatCell") { return 12; }
    if (name == "SegmentBar") { return 13; }
    if (name == "SectionPanel") { return 14; }
    if (name == "AreaCell") { return 15; }
    if (name == "Tile") { return 16; }
    if (name == "Placeholder") { return 17; }
    if (name == "AddTile") { return 18; }
    if (name == "BracketFrame") { return 19; }
    if (name == "Plate") { return 20; }
    if (name == "Lamp") { return 21; }
    if (name == "LightDot") { return 22; }
    return REG_REFUSED;
}

pub fn reg_status(i: u32) -> u32 {
    return REG_PLANNED;
}

pub fn reg_issue(i: u32) -> u32 {
    if (i == 0) { return 13758; }
    if (i == 2) { return 13759; }
    if (i == 7) { return 13760; }
    if (i == 6) { return 13749; }
    return 0;
}

; Story id: "uikit.<lowercase name>.default" for every row.
pub fn reg_story(i: u32) -> str {
    if (i == 0) { return "uikit.text.default"; }
    if (i == 1) { return "uikit.container.default"; }
    if (i == 2) { return "uikit.button.default"; }
    if (i == 3) { return "uikit.iconbutton.default"; }
    if (i == 4) { return "uikit.themepill.default"; }
    if (i == 5) { return "uikit.godmodetoggle.default"; }
    if (i == 6) { return "uikit.avatar.default"; }
    if (i == 7) { return "uikit.headercluster.default"; }
    if (i == 8) { return "uikit.titlebar.default"; }
    if (i == 9) { return "uikit.windowcontrols.default"; }
    if (i == 10) { return "uikit.sidenav.default"; }
    if (i == 11) { return "uikit.herocard.default"; }
    if (i == 12) { return "uikit.statcell.default"; }
    if (i == 13) { return "uikit.segmentbar.default"; }
    if (i == 14) { return "uikit.sectionpanel.default"; }
    if (i == 15) { return "uikit.areacell.default"; }
    if (i == 16) { return "uikit.tile.default"; }
    if (i == 17) { return "uikit.placeholder.default"; }
    if (i == 18) { return "uikit.addtile.default"; }
    if (i == 19) { return "uikit.bracketframe.default"; }
    if (i == 20) { return "uikit.plate.default"; }
    if (i == 21) { return "uikit.lamp.default"; }
    if (i == 22) { return "uikit.lightdot.default"; }
    return "";
}

; Contract flags: none are met while a row is planned.
pub fn reg_flags(i: u32) -> u32 {
    if (reg_status(i) == REG_ACCEPTED) { return REG_F_ALL; }
    return 0;
}

pub fn reg_has_flag(i: u32, flag: u32) -> bool {
    return (reg_flags(i) & flag) != 0;
}

pub fn reg_is_registered(name: str) -> bool {
    return reg_find(name) != REG_REFUSED;
}

; Row is well formed: accepted rows carry an issue, a story id and all flags.
pub fn reg_row_ok(i: u32) -> bool {
    if (i >= REG_COUNT) { return false; }
    if (reg_status(i) == REG_ACCEPTED) {
        if (reg_issue(i) == 0) { return false; }
        if (reg_story(i) == "") { return false; }
        if (reg_flags(i) != REG_F_ALL) { return false; }
    }
    return true;
}

test registry_has_23_rows {
    assert REG_COUNT == 23;
    assert reg_name(0) == "Text";
    assert reg_name(22) == "LightDot";
    assert reg_name(23) == "";
}

test every_name_finds_itself {
    var i: u32 = 0;
    while (i < REG_COUNT) {
        assert reg_find(reg_name(i)) == i;
        i = i + 1;
    }
}

test names_unique {
    var i: u32 = 0;
    while (i < REG_COUNT) {
        var j: u32 = i + 1;
        while (j < REG_COUNT) {
            assert reg_name(i) != reg_name(j);
            j = j + 1;
        }
        i = i + 1;
    }
}

test unknown_name_refused {
    assert reg_find("Nope") == REG_REFUSED;
    assert reg_find("") == REG_REFUSED;
    assert reg_find("text") == REG_REFUSED;
    assert reg_is_registered("Nope") == false;
    assert reg_is_registered("Button") == true;
}

test issues_as_filed {
    assert reg_issue(reg_find("Text")) == 13758;
    assert reg_issue(reg_find("Button")) == 13759;
    assert reg_issue(reg_find("HeaderCluster")) == 13760;
    assert reg_issue(reg_find("Avatar")) == 13749;
    assert reg_issue(reg_find("Lamp")) == 0;
}

test all_rows_planned_today {
    var i: u32 = 0;
    while (i < REG_COUNT) {
        assert reg_status(i) == REG_PLANNED;
        assert reg_has_flag(i, REG_F_CREATE) == false;
        i = i + 1;
    }
}

test flag_bits_cover_eight {
    assert (REG_F_CREATE | REG_F_LAYOUT | REG_F_RENDER | REG_F_HIT_TEST | REG_F_STATE | REG_F_THEME_BIND | REG_F_A11Y_NAME | REG_F_DISPOSE) == REG_F_ALL;
}

invariant accepted_rows_have_issue_and_story {
    var i: u32 = 0;
    while (i < REG_COUNT) {
        assert reg_row_ok(i);
        assert reg_story(i) != "";
        i = i + 1;
    }
}
