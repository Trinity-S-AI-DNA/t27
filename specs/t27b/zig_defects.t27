// zig_mutates of lower.rs move to specs/tri/t27b/zig_defects.t27.
// Part of M10 milestone (milestone #14). Closes #9067.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27b::zig_defects;

pub const ZIG_DEFECTS_MAX : u32 = 1024;

pub struct ZigDefect { name: str, fixed: bool };

pub fn zig_defect_fixed(d: ZigDefect) -> bool {
    return d.fixed;
}

test "zig_defect_fixed" {
    assert(zig_defect_fixed(ZigDefect { name: "zig_syntax_defects", fixed: true }));
    assert(!zig_defect_fixed(ZigDefect { name: "cse_hoist_defect", fixed: false }));
}

invariant zig_defects_max_positive {
    assert ZIG_DEFECTS_MAX > 0;
}