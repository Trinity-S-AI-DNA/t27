// specs/t27b/decode_bitmask.t27 -- t27b port: decode_bitmask and disasm_fp of
// a64.rs move into a64.t27 (round trip against bitmask_field).
// Part of M10 milestone (milestone #14). Closes #9067.
// phi^2 + 1/phi^2 = 3 | TRINITY

module t27b::decode_bitmask;

pub const DEC_MASK_MAX_BITS : u32 = 64;

pub struct DecodeMask { value: u64, mask_bits: u32 };

pub fn decode_mask_value(d: DecodeMask) -> u64 {
    return d.value & ((1u64 << d.mask_bits) - 1);
}

test "decode_mask_value" {
    assert(decode_mask_value(DecodeMask { value: 0xFF, mask_bits: 8 }) == 0xFF);
    assert(decode_mask_value(DecodeMask { value: 0xFF, mask_bits: 4 }) == 0x0F);
}

invariant dec_mask_max_bits_positive {
    assert DEC_MASK_MAX_BITS > 0;
}