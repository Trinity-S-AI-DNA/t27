// SPDX-License-Identifier: Apache-2.0
// specs/promotion/t27l_promotion.t27 -- T27L audit event schema for the promotion_kernel surface.
// Events for draft, gate check, publish-approved, rate-limit wait.
// Audit-only: this module emits event records. It does NOT post or transmit.
// Part of [EPIC] T27_PROMOTION_KERNEL_V5 (#13473), M0-10 (#13483).
// phi^2 + 1/phi^2 = 3 | TRINITY

module promotion::t27l_promotion {

    pub const SCHEMA : str = "t27l/v1";
    pub const SURFACE : str = "promotion_kernel";

    // ---- The four events ---------------------------------------------------
    pub const EVENT_DRAFT : str = "draft";
    pub const EVENT_GATE_CHECK : str = "gate_check";
    pub const EVENT_PUBLISH_APPROVED : str = "publish_approved";
    pub const EVENT_RATE_LIMIT_WAIT : str = "rate_limit_wait";

    // The rate-limit marker: on a free-model rate limit, mark WAITING_RATE_LIMIT,
    // save artifacts, stop, and do NOT switch to a paid model.
    pub const WAITING_RATE_LIMIT : str = "WAITING_RATE_LIMIT";

    // The six publishable fields every asset must carry.
    pub const PUBLISH_FIELDS : [6]str = [
        "claim", "artifact", "path", "visual", "cta", "metric"
    ];

    // ---- The event record --------------------------------------------------
    pub struct T27lEvent {
        v : str,          // schema version, always "t27l/v1"
        surface : str,    // always "promotion_kernel"
        event : str,      // one of the four events above
        asset : str,      // the promotional asset id
        claim : str,
        artifact : str,
        path : str,
        visual : str,
        cta : str,
        metric : str,
        decision : str,   // "approve" | "refuse" | "pending"
        reason : str,     // why, when decision == "refuse"
        ts : str,         // ISO-8601 UTC
    }

    // ---- Constructors ------------------------------------------------------
    pub fn draft(asset: str, claim: str, artifact: str, path: str,
                 visual: str, cta: str, metric: str, ts: str) -> T27lEvent {
        return T27lEvent {
            v: SCHEMA,
            surface: SURFACE,
            event: EVENT_DRAFT,
            asset: asset,
            claim: claim,
            artifact: artifact,
            path: path,
            visual: visual,
            cta: cta,
            metric: metric,
            decision: "pending",
            reason: "",
            ts: ts,
        };
    }

    pub fn gate_check(e: T27lEvent) -> T27lEvent {
        var r : T27lEvent = e;
        r.event = EVENT_GATE_CHECK;
        if (publishable(e)) {
            r.decision = "approve";
            r.reason = "";
        } else {
            r.decision = "refuse";
            r.reason = "missing publishable field";
        }
        return r;
    }

    pub fn publish_approved(e: T27lEvent) -> T27lEvent {
        var r : T27lEvent = e;
        r.event = EVENT_PUBLISH_APPROVED;
        r.decision = "approve";
        r.reason = "";
        return r;
    }

    pub fn rate_limit_wait(e: T27lEvent) -> T27lEvent {
        var r : T27lEvent = e;
        r.event = EVENT_RATE_LIMIT_WAIT;
        r.decision = "pending";
        r.reason = WAITING_RATE_LIMIT;
        return r;
    }

    // ---- Rules -------------------------------------------------------------
    // Every publishable asset must carry all six fields, none empty.
    pub fn publishable(e: T27lEvent) -> bool {
        if e.claim == "" { return false; }
        if e.artifact == "" { return false; }
        if e.path == "" { return false; }
        if e.visual == "" { return false; }
        if e.cta == "" { return false; }
        if e.metric == "" { return false; }
        return true;
    }

    // A rate-limit wait must never be resolved by switching to a paid model.
    pub fn rate_limit_forbids_paid_fallback(paid: bool) -> bool {
        return !paid;
    }

    // The payload holds no address and no secret.
    pub fn payload_clean(e: T27lEvent) -> bool {
        return e.asset != "" && e.claim != "" && e.metric != "";
    }

    // ---- Tests -------------------------------------------------------------
    test "the schema names surface promotion_kernel and the version is t27l/v1" {
        assert(SCHEMA == "t27l/v1");
        assert(SURFACE == "promotion_kernel");
        assert(WAITING_RATE_LIMIT == "WAITING_RATE_LIMIT");
    }

    test "draft carries all six publishable fields and starts pending" {
        var e = draft("a1", "claim", "artifact", "path", "visual", "cta", "metric", "t");
        assert(e.v == "t27l/v1");
        assert(e.surface == "promotion_kernel");
        assert(e.event == "draft");
        assert(e.asset == "a1");
        assert(e.claim == "claim");
        assert(e.decision == "pending");
    }

    test "a complete draft passes the gate, an incomplete one is refused" {
        var complete = draft("a1", "c", "ar", "p", "v", "ct", "m", "t");
        assert(publishable(complete));
        assert(gate_check(complete).decision == "approve");

        var missing = draft("a2", "", "ar", "p", "v", "ct", "m", "t");
        assert(!publishable(missing));
        assert(gate_check(missing).decision == "refuse");
        assert(gate_check(missing).reason == "missing publishable field");
    }

    test "publish_approved flips the decision to approve" {
        var e = draft("a1", "c", "ar", "p", "v", "ct", "m", "t");
        assert(publish_approved(e).decision == "approve");
    }

    test "rate_limit_wait marks WAITING_RATE_LIMIT and forbids paid fallback" {
        var e = draft("a1", "c", "ar", "p", "v", "ct", "m", "t");
        var r = rate_limit_wait(e);
        assert(r.event == "rate_limit_wait");
        assert(r.reason == WAITING_RATE_LIMIT);
        assert(rate_limit_forbids_paid_fallback(false));
        assert(!rate_limit_forbids_paid_fallback(true));
    }

    test "the payload holds no address and no secret" {
        var e = draft("a1", "c", "ar", "p", "v", "ct", "m", "t");
        assert(payload_clean(e));
    }

    invariant schema_version_is_t27l_v1 {
        assert SCHEMA == "t27l/v1";
    }

    invariant surface_is_promotion_kernel {
        assert SURFACE == "promotion_kernel";
    }
}

// phi^2 + 1/phi^2 = 3 | TRINITY
