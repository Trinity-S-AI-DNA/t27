// SPDX-License-Identifier: Apache-2.0
; specs/promotion/t27l_promotion.t27 -- local gate for promotion_kernel events.
; Part of #13473, issue #13483. This file does not register a surface in
; specs/t27os/t27l.t27. On master 116178f1d, tl_surface_name covers ids 1..19
; (TL_SURFACE_LAST = 19) and none of those names is promotion_kernel.
; Nothing here posts, sends mail, or starts a cron.
; phi^2 + 1/phi^2 = 3 | TRINITY

module promotion_t27l;

pub const SURFACE : str = "promotion_kernel";
pub const REGISTERED_IN_T27L : bool = false;

pub const ACTION_DRAFT : str = "draft";
pub const ACTION_GATE_CHECK : str = "gate_check";
pub const ACTION_PUBLISH_APPROVED : str = "publish_approved";
pub const ACTION_WAITING_RATE_LIMIT : str = "WAITING_RATE_LIMIT";
pub const ACTION_REFUSED : str = "refused";

; The six fields of a publishable asset (issue #13473). A missing field is false.
pub fn asset_ready(has_claim: bool, has_artifact: bool, has_path: bool, has_visual: bool, has_cta: bool, has_metric: bool) -> bool {
    return has_claim and has_artifact and has_path and has_visual and has_cta and has_metric;
}

; Issue #13485: widget, screenshot, test pass, and a human yes, all required.
pub fn proof_ready(widget: bool, screenshot: bool, test_pass: bool, human_yes: bool) -> bool {
    return widget and screenshot and test_pass and human_yes;
}

; Both gates. There is no default yes.
pub fn may_publish(asset: bool, proof: bool) -> bool {
    return asset and proof;
}

; A rate limit stops the loop. A paid model is not a fallback.
pub fn on_rate_limit(paid_fallback: bool) -> str {
    if paid_fallback {
        return ACTION_REFUSED;
    }
    return ACTION_WAITING_RATE_LIMIT;
}

test surface_is_promotion_kernel_and_not_registered {
    assert SURFACE == "promotion_kernel";
    assert REGISTERED_IN_T27L == false;
    assert ACTION_WAITING_RATE_LIMIT == "WAITING_RATE_LIMIT";
}

test asset_ready_needs_every_field {
    assert asset_ready(true, true, true, true, true, true);
    assert asset_ready(false, true, true, true, true, true) == false;
    assert asset_ready(true, false, true, true, true, true) == false;
    assert asset_ready(true, true, false, true, true, true) == false;
    assert asset_ready(true, true, true, false, true, true) == false;
    assert asset_ready(true, true, true, true, false, true) == false;
    assert asset_ready(true, true, true, true, true, false) == false;
}

test proof_ready_needs_widget_screenshot_test_and_human_yes {
    assert proof_ready(true, true, true, true);
    assert proof_ready(false, true, true, true) == false;
    assert proof_ready(true, false, true, true) == false;
    assert proof_ready(true, true, false, true) == false;
    assert proof_ready(true, true, true, false) == false;
}

test may_publish_is_false_without_both_gates {
    assert may_publish(true, true);
    assert may_publish(true, false) == false;
    assert may_publish(false, true) == false;
    assert may_publish(false, false) == false;
}

test rate_limit_waits_and_refuses_a_paid_fallback {
    assert on_rate_limit(false) == "WAITING_RATE_LIMIT";
    assert on_rate_limit(true) == "refused";
    assert on_rate_limit(true) != "WAITING_RATE_LIMIT";
}

test negative_control_wrong_surface {
    assert SURFACE != "this-surface-is-wrong";
    assert ACTION_DRAFT == "draft";
    assert ACTION_GATE_CHECK == "gate_check";
    assert ACTION_PUBLISH_APPROVED == "publish_approved";
}
