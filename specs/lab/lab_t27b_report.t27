        const na : u32 = lr_verdicts(TD_A[i], &ta, LR_TABLE);
        const nb : u32 = lr_verdicts(TD_B[i], &tb, LR_TABLE);
        assert na != LR_NONE;
        assert nb != LR_NONE;
        const w : usize = lr_disagreements(TD_A[i], &ta, na as usize, TD_B[i], &tb, nb as usize, &out, 4096);
        assert lx_out_is(&out, w, TD_OUT[i]) == true;
        i = i + 1;
    }
}

