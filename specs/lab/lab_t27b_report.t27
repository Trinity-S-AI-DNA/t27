        assert lx_out_is(&out, w, SP_D[i]) == true;
        i = i + 1;
    }
    var j : usize = 0;
    while (j < OV_N) {
        const w : usize = lr_over_detail(OV_SECS[j], &out, 4096, 0);
        assert lx_out_is(&out, w, OV_D[j]) == true;
