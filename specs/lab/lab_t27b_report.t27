test the_summary_block_equals_the_pythons_and_a_result_without_a_reference_is_the_crash {
    var out : [4096]u8 = undefined;
    var i : usize = 0;
    while (i < TS_N) {
        const a : usize = TS_OFF[i] * 5;
        const b : usize = TS_OFF[i + 1] * 5;
        const n : usize = TS_OFF[i + 1] - TS_OFF[i];
        const crash : bool = lr_summary_crash(TS_ROWS[a..b], n);
        assert crash == (TS_CRASH[i] == 1);
        if (crash == false) {
            var k : usize = 0;
            while (k < 17) {
                assert lr_summary_field(TS_ROWS[a..b], n, TS_REF[i] == 1, k) == TS_FIELDS[17 * i + k];
                k = k + 1;
            }
            if (i < TS_LAYOUT) {
                const w : usize = lr_put_summary(TS_ROWS[a..b], n, TS_REF[i] == 1, &out, 4096, 0);
                assert lx_out_is(&out, w, TS_TXT[i]) == true;
            }
        }
        i = i + 1;
    }
}

test the_reference_only_summary_equals_the_pythons {
    var out : [4096]u8 = undefined;
    var i : usize = 0;
    while (i < RS_N) {
        const w : usize = lr_put_reference_summary(RS_FILES[i], RS_PASS[i], &out, 4096, 0);
        assert lx_out_is(&out, w, RS_TXT[i]) == true;
        i = i + 1;
    }
}
