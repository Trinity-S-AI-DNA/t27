test the_report_verdict_and_detail_equal_the_pythons_on_every_input {
    var out : [4096]u8 = undefined;
    var i : usize = 0;
    while (i < RT_N) {
        assert lr_report_verdict(RT_IN[i]) == RT_V[i];
        const w : usize = lr_report_detail(RT_IN[i], &out, 4096, 0);
        assert lx_out_is(&out, w, RT_D[i]) == true;
        i = i + 1;
    }
}

test the_per_test_tables_equal_the_pythons_on_every_input {
    var tab : [192]u32 = undefined;
    var out : [4096]u8 = undefined;
    var i : usize = 0;
    while (i < TV_N) {
        const n : u32 = lr_verdicts(TV_IN[i], &tab, LR_TABLE);
        assert n == TV_COUNT[i];
        if (n != LR_NONE) {
            const w : usize = lr_table_text(TV_IN[i], &tab, n as usize, &out, 4096, 0);
            assert lx_out_is(&out, w, TV_TXT[i]) == true;
        }
        i = i + 1;
    }
}

test the_disagreement_lines_equal_the_pythons_on_every_pair {
    var ta : [192]u32 = undefined;
    var tb : [192]u32 = undefined;
