    assert lab_test_reap("x-target-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("--target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("--target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
