    assert lab_test_reap("requests", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("requests", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("requests", false, false, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_reap_decision("old-target", 0, 10, false, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("old-target", 0, 10, true, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("old-target", 0, 10, false, false, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("a-target", 0, 8, false, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("a-target", 0, 8, true, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("a-target", 0, 8, false, false, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("target", 0, 6, false, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("target", 0, 6, true, true, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
    assert lab_reap_decision("target", 0, 6, false, false, 1700000000.0, 100, 0, 0.0, 1000.0) == LAB_REAP_KEEP_ROOM;
}

