// reap_scratch_targets() on one entry at a time: a directory, a link to one, a file, each old (written long ago) and new, under pressure.
test lab_py_table_the_reaper_on_every_kind_of_entry {
    assert lab_test_reap("old-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("old-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap("old-target", true, true, 1700000000.0, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("old-target", true, true, 0.5, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("old-target", false, false, 1700000000.0, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("old-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("new-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("new-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap("new-target", true, true, 1700000000.0, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("new-target", true, true, 0.5, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("new-target", false, false, 1700000000.0, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("new-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("target", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", false, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", true, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", false, false, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("a-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap("a-target", true, true, 1700000000.0, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("a-target", true, true, 0.5, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("a-target", false, false, 1700000000.0, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("a-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap("-target", true, true, 1700000000.0, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("-target", true, true, 0.5, LAB_REAP_KEEP_LINK);
    assert lab_test_reap("-target", false, false, 1700000000.0, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap(".x-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap(".x-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap(".x-target", true, true, 1700000000.0, LAB_REAP_KEEP_LINK);
    assert lab_test_reap(".x-target", true, true, 0.5, LAB_REAP_KEEP_LINK);
    assert lab_test_reap(".x-target", false, false, 1700000000.0, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap(".x-target", false, false, 0.5, LAB_REAP_KEEP_NOT_DIR);
    assert lab_test_reap("a-targets", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-targets", false, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-targets", true, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-targets", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-targets", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-targets", false, false, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", false, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", true, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("x-target-y", false, false, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-target.", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("a-target.", false, true, 0.5, LAB_REAP_KEEP_NAME);
