    assert lab_test_reap("-targe", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("-targe", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("-targe", false, false, 0.5, LAB_REAP_KEEP_NAME);
