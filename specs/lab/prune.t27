// >>> pinned table: prune_runs

/// The volumes of the grid below, in KiB.
const LAB_TEST_TOTALS : [5]u64 = [104857600, 47745772, 6000000, 50000000, 2030337424];

// Scenario: specs/claw/lab_disk.t27 holds a check at under 1 GiB free and warns under 5 GiB or 10%; this reaper starts at 15%.
// The tick-40 volume (47745772 KiB, 0 free) is full for the gate and under pressure for the reaper; a volume at 12% free is
// still `go` for the gate while the reaper already works; and over the whole grid, whatever the gate calls low by the percent
// line (avail * 10 < blocks) the reaper is already running on, and a full volume of 7 GiB or more is under pressure too.
test the_reaper_starts_before_the_lab_disk_gate_holds_a_check {
    assert disk_reason(47745772, 0) == R_FULL;
    assert lab_reap_pressure(47745772 * 1024, 0, LAB_REAP_MIN_FREE) == true;
    assert disk_reason(104857600, 12582912) == R_OK;
    assert lab_reap_pressure(104857600 * 1024, 12582912 * 1024, LAB_REAP_MIN_FREE) == true;
    assert disk_reason(104857600, 9437184) == R_LOW;
    assert lab_reap_pressure(104857600 * 1024, 9437184 * 1024, LAB_REAP_MIN_FREE) == true;
    assert disk_reason(104857600, 20971520) == R_OK;
    assert lab_reap_pressure(104857600 * 1024, 20971520 * 1024, LAB_REAP_MIN_FREE) == false;
    var i : usize = 0;
    while (i < 5) {
        const total : u64 = LAB_TEST_TOTALS[i];
        var pct : u64 = 0;
        while (pct <= 100) {
            const avail : u64 = total * pct / 100;
            const under_ten : bool = avail * 10 < total;
            if (under_ten) {
                assert lab_reap_pressure(total * 1024, avail * 1024, LAB_REAP_MIN_FREE) == true;
            }
            if (disk_reason(total, avail) == R_FULL and total >= 7340032) {
                assert lab_reap_pressure(total * 1024, avail * 1024, LAB_REAP_MIN_FREE) == true;
            }
            if (disk_reason(total, avail) == R_OK) {
                // `go` means 10% or more free and 5 GiB or more; the reaper may still be running between 10% and 15%.
                assert under_ten == false;
            }
            pct = pct + 1;
        }
        i = i + 1;
    }
}

// Scenario: equal modification times rank in listing order (Python's reverse sort is stable; which order the directory lists
// them in is the file system's, so this is the port's rule, not a Python answer); a line that is not a run is not counted.
test equal_times_rank_in_listing_order_and_a_bad_line_is_no_run {
    assert lab_test_prune("x\t5\ny\t5\nz\t5\n", "", 1, "y\nz\n");
    assert lab_test_prune("x\t5\ny\t5\nz\t5\n", "", 2, "z\n");
    assert lab_test_prune("x\t5\ny\t5\nz\t5\n", "y\n", 1, "z\n");
    assert lab_run_count("x\t5\nbad\ny\t\nz\t12a\nw\t9\n") == 2;
    assert lab_run_count("") == 0;
    assert lab_run_count("\n") == 0;
    assert lab_run_count("x\t1234567890123456789\n") == 0;
    assert lab_run_count("x\t999999999999999999\n") == 1;
    assert lab_run_rank("x\t5\nbad\nw\t9\n", 0) == 1;
    assert lab_run_rank("x\t5\nbad\nw\t9\n", 8) == 0;
    assert lab_test_prune("x\t5\nbad\ny\t\nz\t12a\nw\t9\n", "", 1, "x\n");
    assert lab_test_prune("x\t5\nw\t9\n", "x\nw\n", 0, "");
    assert lab_test_prune("x\t5\nw\t9\n", "xx\nw \n", 0, "x\nw\n");
}

// Scenario: the scratch name is the last seven bytes of the entry's name, not a prefix and not a word inside it.
test a_scratch_target_name_ends_in_dash_target {
    assert lab_scratch_name("xx a-target yy", 3, 11) == true;
    assert lab_scratch_name("-target", 0, 7) == true;
    assert lab_scratch_name("target", 0, 6) == false;
    assert lab_scratch_name("xtarget", 0, 7) == false;
    assert lab_scratch_name("-targe", 0, 6) == false;
    assert lab_scratch_name("a-targets", 0, 9) == false;
    assert lab_scratch_name("a-target", 3, 1) == false;
    assert lab_scratch_name("", 0, 0) == false;
}
