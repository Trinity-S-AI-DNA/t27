    assert lab_test_reap("atarget", false, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("atarget", true, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("atarget", true, true, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("atarget", false, false, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("atarget", false, false, 0.5, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("b-Target", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("b-Target", false, true, 0.5, LAB_REAP_KEEP_NAME);
