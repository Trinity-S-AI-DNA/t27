// <<< pinned table: prune_pressure
// `du.free >= du.total * min_free` returns before anything is deleted; `time.time() - newest < idle_s` keeps a directory.
test lab_py_table_pressure_and_idle {
    assert lab_reap_pressure(100, 15, 0.15) == false;
    assert lab_reap_pressure(100, 14, 0.15) == true;
    assert lab_reap_pressure(100, 16, 0.15) == false;
    assert lab_reap_pressure(100, 0, 0.15) == true;
    assert lab_reap_pressure(100, 100, 0.15) == false;
    assert lab_reap_pressure(0, 0, 0.15) == false;
    assert lab_reap_pressure(47745772, 0, 0.15) == true;
    assert lab_reap_pressure(48891670528, 0, 0.15) == true;
    assert lab_reap_pressure(2079065522176, 535033524224, 0.15) == false;
    assert lab_reap_pressure(2079065522176, 307200000000, 0.15) == true;
    assert lab_reap_pressure(100, 100, 2.0) == true;
    assert lab_reap_pressure(100, 0, 2.0) == true;
    assert lab_reap_pressure(100, 0, 0.0) == false;
    assert lab_reap_pressure(100, 1, 0.0) == false;
    assert lab_reap_pressure(3, 1, 0.34) == true;
    assert lab_reap_pressure(3, 1, 0.33) == false;
    assert lab_reap_pressure(3, 1, 0.3333333333333333) == false;
    assert lab_reap_pressure(20, 3, 0.15) == false;
    assert lab_reap_pressure(20, 4, 0.15) == false;
    assert lab_reap_pressure(1000, 150, 0.15) == false;
    assert lab_reap_pressure(1000, 149, 0.15) == true;
    assert lab_reap_pressure(1000, 151, 0.15) == false;
    assert lab_reap_pressure(10, 1, 0.1) == false;
    assert lab_reap_pressure(10, 2, 0.1) == false;
    assert lab_reap_pressure(53687091200, 8053063680, 0.15) == false;
    assert lab_reap_pressure(53687091200, 8053063679, 0.15) == true;
    assert lab_reap_pressure(53687091200, 8053063681, 0.15) == false;
    assert lab_reap_pressure(9007199254740992, 9007199254740992, 1.0) == false;
    assert lab_reap_pressure(9007199254740992, 9007199254740991, 1.0) == true;
    assert lab_reap_pressure(1000000000000000, 100000000000000, 0.1) == false;
    assert lab_reap_pressure(1000000000000000, 99999999999999, 0.1) == true;
    assert lab_reap_pressure(1, 0, 0.5) == true;
    assert lab_reap_pressure(1, 1, 0.5) == false;
    assert lab_reap_pressure(2, 1, 0.5) == false;
    assert lab_reap_pressure(7, 1, 0.15) == true;
    assert lab_reap_pressure(7, 2, 0.15) == false;
    assert lab_reap_pressure(6, 1, 0.17) == true;
    assert lab_reap_pressure(6, 1, 0.16) == false;
    // Under pressure the decision follows the age: `age < idle_s` keeps the directory, an age equal to the limit does not.
    assert lab_reap_decision("a-target", 0, 8, false, true, 0.0, 100, 0, 2.0, 86400.0) == LAB_REAP_KEEP_RECENT;
    assert lab_reap_decision("a-target", 0, 8, false, true, 86399.9, 100, 0, 2.0, 86400.0) == LAB_REAP_KEEP_RECENT;
    assert lab_reap_decision("a-target", 0, 8, false, true, 86400.0, 100, 0, 2.0, 86400.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 86400.1, 100, 0, 2.0, 86400.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 1.0, 100, 0, 2.0, 1.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 0.99, 100, 0, 2.0, 1.0) == LAB_REAP_KEEP_RECENT;
    assert lab_reap_decision("a-target", 0, 8, false, true, 1000.0, 100, 0, 2.0, 1000.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 999.999, 100, 0, 2.0, 1000.0) == LAB_REAP_KEEP_RECENT;
    assert lab_reap_decision("a-target", 0, 8, false, true, 1000000000.0, 100, 0, 2.0, 86400.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 5e-07, 100, 0, 2.0, 1e-06) == LAB_REAP_KEEP_RECENT;
    assert lab_reap_decision("a-target", 0, 8, false, true, 0.0, 100, 0, 2.0, 0.0) == LAB_REAP_DELETE;
    assert lab_reap_decision("a-target", 0, 8, false, true, 1.0, 100, 0, 2.0, 0.0) == LAB_REAP_DELETE;
    assert LAB_REAP_MIN_FREE == 0.15 and LAB_REAP_IDLE_S == 86400.0 and LAB_KEEP_RUNS == 200;
    assert lab_reap_pressure(100, 15, LAB_REAP_MIN_FREE) == false;
    assert lab_reap_pressure(100, 14, LAB_REAP_MIN_FREE) == true;
}

// >>> pinned table: prune_pressure
// <<< pinned table: prune_runs
// prune(): the runs at rank KEEP_RUNS or after, newest first by modification time, that no watched head points at.
test lab_py_table_prune {
    assert lab_test_prune("", "", 200, "");
    assert lab_test_prune("", "", 0, "");
    assert lab_test_prune("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t5\n", "", 0, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n");
    assert lab_test_prune("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t5\n", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", 0, "");
    assert lab_test_prune("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t5\n", "", 1, "");
    assert lab_test_prune("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t5\n", "", -1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n");
    assert lab_test_prune("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t5\n", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n", -1, "");
    assert lab_test_prune("ffffffffffffffffffffffffffffffffffffffff\t1000000034\neeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\t1000000068\ncccccccccccccccccccccccccccccccccccccccc\t1000000027\nx\t1000000021\n", "dddddddddddddddddddddddddddddddddddddddd\neeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n", 1, "ffffffffffffffffffffffffffffffffffffffff\ncccccccccccccccccccccccccccccccccccccccc\nx\n");
    assert lab_test_prune("x\t1000000001\neeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\t1000000069\ndddddddddddddddddddddddddddddddddddddddd\t1000000052\nrun-1\t1000000070\n0123456789abcdef0123456789abcdef01234567\t1000000092\ny\t1000000068\n", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\neeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n0123456789abcdef0123456789abcdef01234567\ny\n", -100, "x\ndddddddddddddddddddddddddddddddddddddddd\nrun-1\n");
    assert lab_test_prune("0123456789abcdef0123456789abcdef01234567\t1000000023\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t1000000085\ndddddddddddddddddddddddddddddddddddddddd\t1000000033\nx\t1000000069\ny\t1000000083\n", "ffffffffffffffffffffffffffffffffffffffff\n", -5, "0123456789abcdef0123456789abcdef01234567\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ndddddddddddddddddddddddddddddddddddddddd\nx\ny\n");
    assert lab_test_prune("y\t1000000009\neeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\t1000000007\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t1000000061\ncccccccccccccccccccccccccccccccccccccccc\t1000000010\n0123456789abcdef0123456789abcdef01234567\t1000000066\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\t1000000026\n", "y\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\n", 100, "");
