// SPDX-License-Identifier: Apache-2.0
; specs/lab/prune.t27 -- which finished runs and which scratch build directories the t27c lab deletes (gHashTag/t27#11041, #11040)
; The t27c lab (infra/t27c-lab/lab.py) keeps what it publishes and what it builds on one volume, and two rules keep that volume
; from filling (2026-10-07: it filled to 99% and the queue stopped on ENOSPC, #7090). Both are decisions about names, ages and
; numbers, ported here as pure functions with the Python as the oracle until the cutover; they know no host, no path and no cloud:
;   prune()                  runs[KEEP_RUNS:] by modification time, newest first, except the commits a watched head points at
;                            lab_prune_start, lab_run_rank, lab_prune_runs
;   reap_scratch_targets()   when free space is under min_free of the volume, a directory `<name>-target` that nobody wrote in
;                            idle_s seconds is dropped; the lab's own `target` is never matched, nor a link, nor a file
;                            lab_reap_pressure, lab_scratch_name, lab_reap_decision
; THE RUNS. `runs` is one finished run per line, `<stem> TAB <mtime>`: the file name without `.json` and its modification time as
; an unsigned decimal integer of at most 18 digits in any one unit (only the order is read). A line that is not that is not a
; run. They are ranked as sorted(..., key=mtime, reverse=True) ranks them: newest first, equal times in listing order (Python's
; reverse sort is stable). KEEP_RUNS is a Python slice start, so a negative value counts from the end: with -5 the candidates are
; the OLDEST five and nothing else is ever deleted, the lab's own quirk, ported as it is. `live` is the shas of the watched
; heads, one per line.
; lab_prune_runs writes the stems to delete, one per line: those at rank KEEP_RUNS or after that are not live.
; THE SCRATCH TARGETS. Free space is `free` of `total` bytes. `free >= total * min_free` means room: nothing is reaped, whatever
; the directories are (float arithmetic as Python does it, the comparison in f64). Then a name that does not end in `-target` is
; not a scratch target (pathlib's `*-target` matches `-target` and a dot name too, and is case sensitive on Linux); a symbolic link
; and a non-directory are kept; a directory whose newest write is less than idle_s seconds old is kept; the rest is deleted. The
; age is `now - newest mtime` over the directory and every file under it, which the host computes (it reads the file system); this
; file decides from the number. lab_reap_decision names the first rule that applies.
; THE LAB DISK GATE. specs/claw/lab_disk.t27 holds a CHECK before it runs when the volume is full (under 1 GiB) and warns under
; 5 GiB or 10%; the reaper starts earlier, at 15% free. The tests below tie the two: whatever lab_disk calls low by the percent
; line, the reaper is already running.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module LabPrune;

use tri::lab::receipt::span_is;
use lab::text::LAB_NO;
use lab::text::LAB_DEC_BAD;
use lab::text::lab_line_end;
use lab::text::lab_line_next;
use lab::text::lab_find_byte;
use lab::text::lab_count_of;
use lab::text::lab_set_has;
use lab::text::lab_put_span;
use lab::text::lab_put_lit;
use claw::lab_disk::disk_reason;
use claw::lab_disk::R_OK;
use claw::lab_disk::R_LOW;
use claw::lab_disk::R_FULL;

/// KEEP_RUNS's default.
pub const LAB_KEEP_RUNS : i64 = 200;
/// reap_scratch_targets()'s defaults: under 15% free, a directory idle for a day.
pub const LAB_REAP_MIN_FREE : f64 = 0.15;
pub const LAB_REAP_IDLE_S : f64 = 86400.0;

/// What reap_scratch_targets() does with one entry of the data directory, the first rule that applies.
pub const LAB_REAP_KEEP_ROOM : u8 = 0;
pub const LAB_REAP_KEEP_NAME : u8 = 1;
pub const LAB_REAP_KEEP_LINK : u8 = 2;
pub const LAB_REAP_KEEP_NOT_DIR : u8 = 3;
pub const LAB_REAP_KEEP_RECENT : u8 = 4;
pub const LAB_REAP_DELETE : u8 = 5;

/// The index of the first run `runs[KEEP_RUNS:]` takes out of n runs: Python's slice start, a negative one counting from the end.
pub fn lab_prune_start(n: usize, keep: i64) -> usize {
    if (keep >= 0) {
        if ((keep as usize) >= n) { return n; }
        return keep as usize;
    }
    if (keep < 0 - 4611686018427387904) { return 0; }
    const back : usize = (0 - keep) as usize;
    if (back >= n) { return 0; }
    return n - back;
}

/// The modification time on the run line runs[s..e]: LAB_DEC_BAD when the line is not `<stem> TAB <count>`.
pub fn lab_run_mtime(runs: string, s: usize, e: usize) -> u64 {
    const tab : usize = lab_find_byte(runs, s, e, 9);
    if (tab == LAB_NO) { return LAB_DEC_BAD; }
    return lab_count_of(runs, tab + 1, e);
}

/// How many lines of `runs` are runs.
pub fn lab_run_count(runs: string) -> usize {
    var n : usize = 0;
    var s : usize = 0;
    while (s < runs.len) {
        const e : usize = lab_line_end(runs, s);
        if (lab_run_mtime(runs, s, e) != LAB_DEC_BAD) { n = n + 1; }
        s = lab_line_next(runs, e);
    }
    return n;
}

/// The rank, 0 for the newest, of the run on the line that starts at s: the runs strictly newer, and the ones listed before it
/// with the same time.
pub fn lab_run_rank(runs: string, s: usize) -> usize {
    const mine : u64 = lab_run_mtime(runs, s, lab_line_end(runs, s));
    var rank : usize = 0;
    var k : usize = 0;
    while (k < runs.len) {
        const e : usize = lab_line_end(runs, k);
        const m : u64 = lab_run_mtime(runs, k, e);
        if (m != LAB_DEC_BAD and (m > mine or (m == mine and k < s))) { rank = rank + 1; }
        k = lab_line_next(runs, e);
    }
    return rank;
}

/// prune(): the stems of the runs to delete, one per line, into dst at w, clipped at cap; the new cursor.
pub fn lab_prune_runs(runs: string, live: string, keep: i64, dst: []u8, cap: usize, w: usize) -> usize {
    const start : usize = lab_prune_start(lab_run_count(runs), keep);
    var x : usize = w;
    var s : usize = 0;
    while (s < runs.len) {
        const e : usize = lab_line_end(runs, s);
        if (lab_run_mtime(runs, s, e) != LAB_DEC_BAD) {
            const tab : usize = lab_find_byte(runs, s, e, 9);
            if (lab_run_rank(runs, s) >= start and lab_set_has(live, runs, s, tab) == false) {
                x = lab_put_span(dst, cap, x, runs, s, tab);
                x = lab_put_lit(dst, cap, x, "\n");
            }
        }
        s = lab_line_next(runs, e);
    }
    return x;
}

/// reap_scratch_targets(): is there room? Free space at or above min_free of the volume means nothing is reaped.
pub fn lab_reap_pressure(total: u64, free: u64, min_free: f64) -> bool {
    return (free as f64) < (total as f64) * min_free;
}

/// root.glob("*-target"): a name that ends in `-target` (a name of just `-target` too).
pub fn lab_scratch_name(t: string, from: usize, to: usize) -> bool {
    if (to < from or to - from < 7) { return false; }
    return span_is(t, to - 7, to, "-target");
}

/// reap_scratch_targets(): what to do with the entry name[nf..nt] of the data directory.
pub fn lab_reap_decision(name: string, nf: usize, nt: usize, is_link: bool, is_dir: bool, age_s: f64, total: u64, free: u64, min_free: f64, idle_s: f64) -> u8 {
    if (lab_reap_pressure(total, free, min_free) == false) { return LAB_REAP_KEEP_ROOM; }
    if (lab_scratch_name(name, nf, nt) == false) { return LAB_REAP_KEEP_NAME; }
    if (is_link) { return LAB_REAP_KEEP_LINK; }
    if (is_dir == false) { return LAB_REAP_KEEP_NOT_DIR; }
    if (age_s < idle_s) { return LAB_REAP_KEEP_RECENT; }
    return LAB_REAP_DELETE;
}

// ---- tests ----
// The oracle is infra/t27c-lab/lab.py. The cases below are its answers (Python 3.14.6): prune() was run for real on a directory
// of run files with chosen modification times (the data directory and the reaper patched out), and reap_scratch_targets() was
// run for real on a directory of entries (a directory, a link to one, a file; old and new; min_free 2.0 to reap and 0.0 not to).
// Its self_check() case (old-target goes; new-target and target stay) is the first test of the reaper, one to one.

fn lab_test_prune(runs: string, live: string, keep: i64, want: string) -> bool {
    var out : [1024]u8 = undefined;
    const w : usize = lab_prune_runs(runs, live, keep, &out, 1024, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

/// One entry of the data directory under pressure (total 100, free 0, min_free 2.0), idle limit 1000 s.
fn lab_test_reap(name: string, is_link: bool, is_dir: bool, age: f64, want: u8) -> bool {
    return lab_reap_decision(name, 0, name.len, is_link, is_dir, age, 100, 0, 2.0, 1000.0) == want;
}

// <<< pinned table: prune_self_check
test lab_py_self_check_the_reaper_drops_the_old_scratch_target_and_nothing_else {
    assert lab_test_reap("old-target", false, true, 1700000000.0, LAB_REAP_DELETE);
    assert lab_test_reap("new-target", false, true, 0.5, LAB_REAP_KEEP_RECENT);
    assert lab_test_reap("target", false, true, 1700000000.0, LAB_REAP_KEEP_NAME);
    assert lab_test_reap("target", false, true, 0.5, LAB_REAP_KEEP_NAME);
}

