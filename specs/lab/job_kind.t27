use verified::payout::OUT_CREDITED;
use verified::payout::AWARD_NONE;
use verified::payout::AWARD_FEE;
use verified::payout::AWARD_SLASH;
use verified::payout::receipt_award;
use trinet::node-work-credit::REWARD_PER_JOB_MTRI;
use hosting::credit::SETTLEMENT_ENABLED;
use hosting::credit::TOKEN_VALUE_CLAIMED;
use hosting::credit::LE_CREDIT;
use hosting::credit::LE_SLASH;
use hosting::credit::credit_mtri;
use hosting::credit::row_admitted;
use hosting::host::TIER_PUBLIC;
use hosting::host::WC_SHARD;
use hosting::host::STRIKES_MAX;
use hosting::host::eligible;
use hosting::placement::may_take;
use hosting::placement::spread_ok;
use hosting::proof::JV_PENDING;
use hosting::proof::JV_AGREED;
use hosting::proof::JV_TIEBREAK;
use hosting::proof::JV_UNRESOLVED;
use hosting::proof::REPLICAS_K;
use hosting::proof::REPLICAS_MAX;
use hosting::proof::SIDE_AGREED;
use hosting::proof::SIDE_DISSENT;
use hosting::proof::SIDE_NONE;
use hosting::proof::TOP_GROUP;
use hosting::proof::job_verdict;
use hosting::proof::wanted_after;
use hosting::proof::side_of;
use hosting::sybil::CAP_PUBLIC_MTRI;
use hosting::sybil::anchored_verdict;
use hosting::sybil::slash_mtri;
use hosting::statement::EPOCH_SECONDS;
use hosting::statement::EPOCH_ORIGIN_UNIX;
use hosting::statement::epoch_of;
use hosting::statement::shard_kind;
use hosting::statement::balance_after_entry;
use hosting::statement::leaf_kind_known;
use network::mvp::ENTRY_SLASH;
use queen::netlink::NODE_TTL_SECONDS;
