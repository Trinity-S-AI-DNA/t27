// sh(): `if time.time() - start > timeout: return 124` else the program's code.
test lab_py_table_a_limit_kills_the_gate {
    assert lab_exit_after(0, 10.0, 1800) == 0;
    assert lab_exit_after(0, 1800.0, 1800) == 0;
    assert lab_exit_after(0, 1800.5, 1800) == 124;
    assert lab_exit_after(1, 1799.9, 1800) == 1;
    assert lab_exit_after(0, 3600.01, 3600) == 124;
    assert lab_exit_after(-9, 3601.0, 3600) == 124;
    assert lab_exit_after(2, 0.0, 1800) == 2;
    assert lab_exit_after(0, 5400.0, 5400) == 0;
    assert lab_exit_after(0, 5400.000001, 5400) == 124;
    assert lab_exit_after(127, 0.1, 3600) == 127;
    assert lab_exit_after(-9, 1800.2, 1800) == 124;
    assert lab_exit_after(0, 0.0, 0) == 0;
    assert LAB_EXIT_TIMEOUT == 124 and LAB_EXIT_NOT_FOUND == 127;
}

// publish_latest(): the state a head shows.
test lab_py_table_head_state {
    assert lab_head_state(true, true, true, true) == 4;
    assert lab_head_state(true, true, true, false) == 4;
    assert lab_head_state(true, true, false, true) == 4;
    assert lab_head_state(true, true, false, false) == 4;
    assert lab_head_state(true, false, true, true) == 3;
    assert lab_head_state(true, false, true, false) == 3;
    assert lab_head_state(true, false, false, true) == 3;
    assert lab_head_state(true, false, false, false) == 3;
    assert lab_head_state(false, true, true, true) == 2;
    assert lab_head_state(false, true, true, false) == 2;
    assert lab_head_state(false, true, false, true) == 1;
    assert lab_head_state(false, true, false, false) == 0;
    assert lab_head_state(false, false, true, true) == 2;
    assert lab_head_state(false, false, true, false) == 2;
    assert lab_head_state(false, false, false, true) == 1;
    assert lab_head_state(false, false, false, false) == 0;
    assert span_is(lab_head_state_name(LAB_HS_NOT_RUN), 0, 7, "not run") and span_is(lab_head_state_name(LAB_HS_QUEUED), 0, 6, "queued");
    assert span_is(lab_head_state_name(LAB_HS_RUNNING), 0, 7, "running") and span_is(lab_head_state_name(LAB_HS_UNREADABLE), 0, 10, "unreadable");
    assert lab_head_state_name(LAB_HS_FROM_RUN).len == 0;
}

// >>> pinned table: verdict_run

// Scenario: `\s` crosses lines. A row with no description still matches when the next line starts with a non-space, and it
// takes that character; the next row then loses its first digit and is not read (Python: 1 2 3 only). Checked on Python.
test the_row_regex_crosses_lines_as_python_does {
    assert lab_test_misread("  pairs  refused  silent\n  10 20 30  \nx", true, 10, 20, 30);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3\n4 5 6 x\n", true, 1, 2, 3);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3\n  4 5 6 x\n", true, 1, 2, 3);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3 a\n  4 5 6 x\n", true, 5, 7, 9);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3", true, 0, 0, 0);
}

// Scenario: the one branch of misread_line() no input of misread_counts() reaches: a refused count of None.
test refusals_not_measured_is_said_when_the_refused_count_is_none {
    var out : [128]u8 = undefined;
    const m : LabMisread = LabMisread { read: true, pairs: 3, refused: LAB_DEC_BAD, silent: 1 };
    const w : usize = lab_misread_line(m, "fb", 0, 2, &out, 128, 0);
    assert w == 44;
    assert span_is(&out, 0, w, "1 of 3 pair(s) silent, refusals not measured");
    const n : LabMisread = LabMisread { read: false, pairs: 3, refused: 1, silent: 1 };
    const x : usize = lab_misread_line(n, "fb", 0, 2, &out, 128, 0);
    assert x == 2 and span_is(&out, 0, 2, "fb");
}

// Scenario (NOT Python): a count of more than 18 digits, or a total past 10^18 - 1, is not read. Python reads both
// (12345678901234567890, and 999999999999999999 + 1); the port fails closed, and the summary falls back to the log's own line.
test a_count_this_port_cannot_hold_makes_the_table_unread {
    assert lab_test_misread("  pairs  refused  silent\n  12345678901234567890 2 3 x\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  999999999999999999 2 3 x\n  1 1 1 y\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  999999999999999999 2 3 x\n", true, 999999999999999999, 2, 3);
    assert lab_test_misread_line("  pairs  refused  silent\n  12345678901234567890 2 3 x\n", "the log line", "the log line");
}

// Scenario: summary() cuts at 300 CHARACTERS: 299 letters, then e-acute (2 bytes), then z is 302 bytes and 301 characters; the
// summary is the first 300 characters, 301 bytes. (Python: len 300, ends 'aae-acute'.)
test the_summary_is_cut_at_300_characters_not_bytes {
    var b : [302]u8 = undefined;
    var k : usize = 0;
    while (k < 299) {
        b[k] = 97;
        k = k + 1;
    }
    b[299] = 195;
    b[300] = 169;
    b[301] = 122;
    var out : [1400]u8 = undefined;
    assert lab_summary_write(&b, LAB_PAT_NONE, &out, 1400, 0) == 301;
    assert out[298] == 97 and out[299] == 195 and out[300] == 169;
    const sp : LabSummarySpan = lab_summary(&b, LAB_PAT_NONE);
    assert sp.from == 0 and sp.to == 301;
}

// Scenario: the lines of a log are split on the ten characters splitlines() splits on, and stripped of the Unicode spaces
// (checked on Python: 'a VT b' -> 'b'; 'x CR y' -> 'y'; 'RATCHET NEL two' under RATCHET -> 'RATCHET'; NBSP x NBSP -> 'x'; US is
// not a break; a zero width space is not a space).
test the_summary_reads_lines_and_spaces_the_way_python_does {
    var vt : [3]u8 = undefined;
    vt[0] = 97;
    vt[1] = 11;
    vt[2] = 98;
    assert lab_test_summary(&vt, LAB_PAT_NONE, "b");
    var cr : [3]u8 = undefined;
    cr[0] = 120;
    cr[1] = 13;
    cr[2] = 121;
    assert lab_test_summary(&cr, LAB_PAT_NONE, "y");
    var nel : [12]u8 = undefined;
    nel[0] = 82;
    nel[1] = 65;
    nel[2] = 84;
    nel[3] = 67;
    nel[4] = 72;
    nel[5] = 69;
    nel[6] = 84;
    nel[7] = 194;
    nel[8] = 133;
    nel[9] = 116;
    nel[10] = 119;
    nel[11] = 111;
    assert lab_test_summary(&nel, LAB_PAT_SUITE, "RATCHET");
    var nb : [5]u8 = undefined;
    nb[0] = 194;
    nb[1] = 160;
    nb[2] = 120;
    nb[3] = 194;
    nb[4] = 160;
    assert lab_test_summary(&nb, LAB_PAT_NONE, "x");
    var us : [3]u8 = undefined;
    us[0] = 97;
    us[1] = 31;
    us[2] = 98;
    const sp : LabSummarySpan = lab_summary(&us, LAB_PAT_NONE);
    assert sp.from == 0 and sp.to == 3;
    var zw : [4]u8 = undefined;
    zw[0] = 120;
    zw[1] = 226;
    zw[2] = 128;
    zw[3] = 139;
    const zs : LabSummarySpan = lab_summary(&zw, LAB_PAT_NONE);
    assert zs.from == 0 and zs.to == 4;
}

// Scenario: the gate table is a closed set of eight; a name outside it is no gate (negative control: a command, a padded or
// upper-case spelling, a path, a prefix and a longer name are all refused), and every gate of the table has a command.
test only_the_eight_gates_of_the_table_are_known {
    var i : usize = 0;
    while (i < LAB_GATE_COUNT) {
        const n : string = lab_gate_name(i);
        assert lab_gate_known(n, 0, n.len) == true;
        assert lab_gate_index(n, 0, n.len) == i;
        assert lab_gate_cmd(i).len > 10;
        assert lab_gate_timeout(i) >= 1800;
        i = i + 1;
    }
    assert lab_gate_known("", 0, 0) == false;
    assert lab_gate_known("Build", 0, 5) == false;
    assert lab_gate_known("build ", 0, 6) == false;
    assert lab_gate_known("buil", 0, 4) == false;
    assert lab_gate_known("builds", 0, 6) == false;
    assert lab_gate_known("build;ls", 0, 8) == false;
    assert lab_gate_known("rm -rf /", 0, 8) == false;
    assert lab_gate_known("../suite", 0, 8) == false;
    assert lab_gate_known("specs", 0, 5) == false;
    assert lab_gate_known("seal-currency", 0, 13) == true;
    assert lab_gate_known("seal-currencyX", 0, 13) == true;
    assert lab_gate_known("seal-currencyX", 0, 14) == false;
    assert lab_gate_known("checkout", 0, 8) == false;
    assert lab_gate_known("lab", 0, 3) == false;
    assert LAB_GATE_COUNT == 8;
}
