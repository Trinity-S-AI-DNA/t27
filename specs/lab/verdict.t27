// >>> pinned table: verdict_summary
// <<< pinned table: verdict_misread
// misread_counts(text): the totals, or None (not read), for tables of every shape; the cross-line rows of `\s` included.
test lab_py_table_misread_counts {
    assert lab_test_misread("", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n", true, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n\n", true, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n\n  Nothing found\n", true, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n     12       12       0  an empty type slot\n", true, 12, 12, 0);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3", true, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3\n  y", true, 1, 2, 3);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3\n  5 5 5\n\n\nerror: target/release/t27c is not built\n\n\n\n", true, 1, 2, 3);
    assert lab_test_misread("  pairs  refused  silent\n  1 2\n3 x\n", true, 1, 2, 3);
    assert lab_test_misread("1 2 3 x\n  1.5 2 3 x\n pairs refused silent\n\n\n  -1 2 3 x\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n\t7\t8\t9\tzz\nerror: target/release/t27c is not built\n", true, 7, 8, 9);
    assert lab_test_misread("  pairs  refused  silent\n      5        3       2  a colon inside a field type\n     12       12       0  an empty type slot\n     12       12       0  an empty type slot\n", true, 29, 27, 2);
    assert lab_test_misread("  1 2 3\n  2 of 17 pair(s) are silent: the spec parses\npairs refused silent\n  Nothing found\n  Nothing found\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n     12       12       0  an empty type slot\n  4 5 6\n  7 8 9\n  pairs  refused  silent\n", true, 16, 17, 6);
    assert lab_test_misread("  pairs  refused  silent\n\t7\t8\t9\tzz\n  pairs  refused  silent\nerror: target/release/t27c is not built\npairs  refused  silent", true, 7, 8, 9);
    assert lab_test_misread("  pairs  refused  silent\n  5 5 5\n\n\n  1 2\n3 x\n  1 2\n   0   0   0  none\n  1 2\n", true, 6, 7, 5);
    assert lab_test_misread("  1.5 2 3 x\n  10 20 30  \n  1.5 2 3 x\n  3 4 5 x\n  1.5 2 3 x\n", false, 0, 0, 0);
    assert lab_test_misread("  01 002 0003 pad\n  12  12  0\nerror: target/release/t27c is not built\n  1 2 3 \n  1 2 3  1 2 3x\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  3  4  5\t\n  y\n\n  1.5 2 3 x\n  100 200 300 a\n  400 500 600 b\n  700 800 900 c\n", true, 1203, 1504, 1805);
    assert lab_test_misread("  pairs  refused  silent\n   0   0   0  none\n  CONTROL FAILED -- these shapes did not fire\n  1\n2\n3\nx\n  12  12  0\n", false, 0, 0, 0);
    assert lab_test_misread("\t7\t8\t9\tzz\n  a b c d\n  CONTROL FAILED -- these shapes did not fire\n", false, 0, 0, 0);
    assert lab_test_misread("x  9 9 9 y\n  1.5 2 3 x\n  12  12  0\n  CONTROL FAILED -- these shapes did not fire\n  -1 2 3 x\n", false, 0, 0, 0);
    assert lab_test_misread("x  9 9 9 y\n", false, 0, 0, 0);
    assert lab_test_misread("  1 2 3x\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  1 2\n pairs refused silent\n   0   0   0  none\n  1 2 3 \n  12  12  0\n  3 4 5 x\n", true, 4, 6, 8);
    assert lab_test_misread("  pairs  refused  silent\n 1 2 3 q q q\n\t7\t8\t9\tzz\n", true, 8, 10, 12);
    assert lab_test_misread("  pairs  refused  silent\n   0   0   0  none\n", true, 0, 0, 0);
    assert lab_test_misread("  Nothing found\n  18 17 16 15\n     12       12       0  an empty type slot\n  9 9 9 9 9 9 y\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  4 5 6\n  7 8 9\n  pairs  refused  silent\n  100 200 300 a\n  400 500 600 b\n  700 800 900 c\n", true, 1204, 1505, 1806);
    assert lab_test_misread("  pairs  refused  silent\n1 2 3 x\n  1.5 2 3 x\n pairs refused silent\n  100 200 300 a\n  400 500 600 b\n  700 800 900 c\n  Nothing found\n", true, 1200, 1500, 1800);
    assert lab_test_misread("  pairs  refused  silent\n  3  4  5\t\n  y\n1 2 3 x\n\n  pairs  refused  silent\n", true, 3, 4, 5);
    assert lab_test_misread("  pairs  refused  silent\n  5 5 5\n\n\n  6 6 6 z\n   0   0   0  none\n  3 4 5 x\n  3  4  5\t\n  y\n  3 4 5 6\n\t7\t8\t9\tzz\n", true, 21, 25, 29);
    assert lab_test_misread("  pairs  refused  silent\n  3  4  5\t\n  y\n  pairs  refused  silent\n", true, 3, 4, 5);
    assert lab_test_misread("  CONTROL FAILED -- these shapes did not fire\n  1 2\n  12  12  0\n  -1 2 3 x\nerror: target/release/t27c is not built\n   0   0   0  none\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\npairs  refused  silent  4 5 6\n  7 8 9\nerror: target/release/t27c is not built\nx  9 9 9 y\n", true, 7, 8, 9);
    assert lab_test_misread("  pairs  refused  silent\n  1 2 3x\n  1 2 3\n", true, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n  Nothing found\n\t7\t8\t9\tzz\n", true, 7, 8, 9);
}

// >>> pinned table: verdict_misread
// <<< pinned table: verdict_misread_line
// misread_line(misread_counts(text), fallback): the counts in words, else the fallback.
test lab_py_table_misread_line {
    assert lab_test_misread_line("", "", "");
    assert lab_test_misread_line("  pairs  refused  silent\n", "error: target/release/t27c is not built", "0 of 0 pair(s) silent, 0 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n\n", "2 of 17 pair(s) are silent: the spec parses", "0 of 0 pair(s) silent, 0 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n\n  Nothing found\n", "error: target/release/t27c is not built", "0 of 0 pair(s) silent, 0 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n     12       12       0  an empty type slot\n", "", "0 of 12 pair(s) silent, 12 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n  1 2 3", "2 of 17 pair(s) are silent: the spec parses", "0 of 0 pair(s) silent, 0 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n  1 2 3\n  y", "2 of 17 pair(s) are silent: the spec parses", "3 of 1 pair(s) silent, 2 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n  1 2 3\n  5 5 5\n\n\nerror: target/release/t27c is not built\n\n\n\n", "error: target/release/t27c is not built", "3 of 1 pair(s) silent, 2 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n  1 2\n3 x\n", "error: target/release/t27c is not built", "3 of 1 pair(s) silent, 2 refused by typecheck");
    assert lab_test_misread_line("1 2 3 x\n  1.5 2 3 x\n pairs refused silent\n\n\n  -1 2 3 x\n", "fallback line", "fallback line");
    assert lab_test_misread_line("  pairs  refused  silent\n\t7\t8\t9\tzz\nerror: target/release/t27c is not built\n", "fallback line", "9 of 7 pair(s) silent, 8 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n      5        3       2  a colon inside a field type\n     12       12       0  an empty type slot\n     12       12       0  an empty type slot\n", "", "2 of 29 pair(s) silent, 27 refused by typecheck");
    assert lab_test_misread_line("  1 2 3\n  2 of 17 pair(s) are silent: the spec parses\npairs refused silent\n  Nothing found\n  Nothing found\n", "2 of 17 pair(s) are silent: the spec parses", "2 of 17 pair(s) are silent: the spec parses");
    assert lab_test_misread_line("  pairs  refused  silent\n     12       12       0  an empty type slot\n  4 5 6\n  7 8 9\n  pairs  refused  silent\n", "error: target/release/t27c is not built", "6 of 16 pair(s) silent, 17 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n\t7\t8\t9\tzz\n  pairs  refused  silent\nerror: target/release/t27c is not built\npairs  refused  silent", "error: target/release/t27c is not built", "9 of 7 pair(s) silent, 8 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n  5 5 5\n\n\n  1 2\n3 x\n  1 2\n   0   0   0  none\n  1 2\n", "", "5 of 6 pair(s) silent, 7 refused by typecheck");
    assert lab_test_misread_line("  1.5 2 3 x\n  10 20 30  \n  1.5 2 3 x\n  3 4 5 x\n  1.5 2 3 x\n", "", "");
    assert lab_test_misread_line("  01 002 0003 pad\n  12  12  0\nerror: target/release/t27c is not built\n  1 2 3 \n  1 2 3  1 2 3x\n", "error: target/release/t27c is not built", "error: target/release/t27c is not built");
    assert lab_test_misread_line("  pairs  refused  silent\n  3  4  5\t\n  y\n\n  1.5 2 3 x\n  100 200 300 a\n  400 500 600 b\n  700 800 900 c\n", "error: target/release/t27c is not built", "1805 of 1203 pair(s) silent, 1504 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n   0   0   0  none\n  CONTROL FAILED -- these shapes did not fire\n  1\n2\n3\nx\n  12  12  0\n", "error: target/release/t27c is not built", "error: target/release/t27c is not built");
    assert lab_test_misread_line("\t7\t8\t9\tzz\n  a b c d\n  CONTROL FAILED -- these shapes did not fire\n", "", "");
    assert lab_test_misread_line("x  9 9 9 y\n  1.5 2 3 x\n  12  12  0\n  CONTROL FAILED -- these shapes did not fire\n  -1 2 3 x\n", "fallback line", "fallback line");
    assert lab_test_misread_line("x  9 9 9 y\n", "error: target/release/t27c is not built", "error: target/release/t27c is not built");
    assert lab_test_misread_line("  1 2 3x\n", "fallback line", "fallback line");
    assert lab_test_misread_line("  pairs  refused  silent\n  1 2\n pairs refused silent\n   0   0   0  none\n  1 2 3 \n  12  12  0\n  3 4 5 x\n", "fallback line", "8 of 4 pair(s) silent, 6 refused by typecheck");
    assert lab_test_misread_line("  pairs  refused  silent\n 1 2 3 q q q\n\t7\t8\t9\tzz\n", "fallback line", "12 of 8 pair(s) silent, 10 refused by typecheck");
}

// >>> pinned table: verdict_misread_line
// <<< pinned table: verdict_verdict
// verdict(gates): green when at least one gate counts and every counting gate exited 0; misread is left out.
test lab_py_table_verdict {
    assert lab_test_verdict("build\t-9\nlean\t0\nbuild\t127\n\t1\n", false);
    assert lab_test_verdict("suite\t0\nsuite\t-9\nbuild\t\n", false);
    assert lab_test_verdict("specs-parse\t-9\nseal-coverage\t0\nsuite\t-9\nseal-coverage\t0\n", false);
    assert lab_test_verdict("", false);
    assert lab_test_verdict("seal-coverage\t124\nlean\t-9\nlean\t0\nsuite\t1\n", false);
    assert lab_test_verdict("seal-coverage\t0\nseal-coverage\t0\nspecs-generate\t0\nlab\t2\nbuild\t1\nspecs-parse\t1\nseal-currency\t1\nmisread\t-9\n", false);
    assert lab_test_verdict("seal-coverage\t0\nspecs-parse\t127\nspecs-generate\t124\nlean\t124\nseal-coverage\t0\nspecs-parse\t1\n", false);
    assert lab_test_verdict("specs-parse\t127\n\t124\nseal-coverage\t124\n", false);
    assert lab_test_verdict("\t1\nlean\t127\ncheckout\t0\nsuite\t0\nseal-currency\t124\n", false);
    assert lab_test_verdict("specs-generate\t0\nseal-currency\t1\n\t0\nspecs-generate\t0\n", false);
    assert lab_test_verdict("lean\t124\n\nlean\t124\nspecs-generate\t1\nspecs-generate\t0\nmisread\t0\ncheckout\t2\n", false);
    assert lab_test_verdict("suite\t124\nseal-coverage\t0\n", false);
    assert lab_test_verdict("seal-coverage\t124\nlab\t127\n\t124\nbuild\t127\n\nbuild\t0\nspecs-parse\t124\n", false);
    assert lab_test_verdict("build\t124\nseal-coverage\t124\nspecs-parse\t\nbuild\t0\nmisread\t0\nmisread\t0\nsuite\t-9\n", false);
    assert lab_test_verdict("specs-parse\t124\nbuild\t0\nspecs-generate\t1\nbuild\t-9\n\t0\nmisread\t0\nlean\t1\nsuite\t0\n", false);
    assert lab_test_verdict("specs-parse\t2\nseal-coverage\t2\nmisread\t124\nsuite\t1\nbuild\t0\n", false);
    assert lab_test_verdict("suite\t0\nlab\nbuild\t1\nlab\t124\nseal-coverage\t2\nsuite\t2\nspecs-generate\t127\n", false);
    assert lab_test_verdict("checkout\t-9\nmisread\t0\ncheckout\t-9\nlab\t-9\nmisread\t124\n\t2\n\t0\n\t0\n", false);
    assert lab_test_verdict("specs-generate\t0\nlab\t0\nseal-coverage\t-9\nmisread\t124\nlab\t124\nmisread\t1\nmisread\t0\ncheckout\t0\n", false);
    assert lab_test_verdict("specs-parse\t0\ncheckout\t0\nspecs-parse\t-9\nseal-currency\t\nlean\t0\nseal-coverage\t0\n\t0\nsuite\t127\n", false);
    assert lab_test_verdict("build\t0\n\t0\nseal-coverage\t0\nbuild\t0\n\t-9\nseal-coverage\t124\ncheckout\t-9\nmisread\t0\n", false);
    assert lab_test_verdict("seal-currency\t0\n", true);
    assert lab_test_verdict("misread\t0\nlean\t0\nseal-currency\t\nseal-currency\t\nspecs-parse\t0\nlean\t0\nseal-coverage\t127\nspecs-generate\t0\n", false);
    assert lab_test_verdict("suite\t0\nlab\t0\nmisread\t2\nbuild\t0\n", true);
    assert lab_test_verdict("misread\t0\nlean\t0\nseal-coverage\t-9\nseal-coverage\t-9\n", false);
    assert lab_test_verdict("misread\t-9\ncheckout\t1\n", false);
    assert lab_test_verdict("lab\t1\nbuild\t127\nspecs-generate\t0\nbuild\t1\nlean\t1\nlean\t124\nmisread\t0\nspecs-generate\t-9\n", false);
    assert lab_test_verdict("specs-parse\t0\nspecs-parse\t127\n\t0\nlab\t2\nbuild\t2\ncheckout\t0\nmisread\t127\n", false);
    assert lab_test_verdict("specs-parse\t2\nlean\t0\nspecs-parse\t0\nlean\nsuite\t-9\nseal-coverage\t0\nlab\n", false);
    assert lab_test_verdict("specs-generate\t1\nseal-currency\t\nsuite\t127\n\t0\n\t0\nspecs-parse\t0\nspecs-generate\t0\n", false);
    assert lab_test_verdict("specs-parse\t0\nlab\t127\nspecs-parse\t124\n", false);
    assert lab_test_verdict("lab\t0\nseal-currency\t2\nseal-currency\t-9\nlab\t-9\n\t0\nseal-coverage\t0\n", false);
    assert lab_test_verdict("checkout\t2\nlean\t1\nspecs-generate\nspecs-parse\t-9\ncheckout\t124\n", false);
    assert lab_test_verdict("seal-currency\t0\ncheckout\t0\nlean\t124\ncheckout\t0\nspecs-parse\t0\nspecs-parse\t127\n", false);
    assert lab_test_verdict("misread\t0\n", false);
    assert lab_test_verdict("seal-coverage\t1\nseal-coverage\t127\nlab\t\ncheckout\t0\nspecs-parse\t124\n", false);
    assert lab_test_verdict("seal-coverage\nsuite\t0\nlab\t0\nlean\t0\n", false);
    assert lab_test_verdict("seal-currency\t\nseal-currency\t0\nlab\t0\nseal-currency\t\nbuild\t0\nspecs-generate\t2\nseal-currency\t1\n", false);
    assert lab_test_verdict("lab\t0\ncheckout\nseal-currency\t-9\nseal-coverage\t2\nlean\t2\nmisread\t0\nlean\t-9\n\t0\n", false);
    assert lab_test_verdict("seal-coverage\t-9\nseal-coverage\t2\nsuite\t1\n", false);
    assert lab_test_verdict("lean\t2\nlab\t0\nspecs-parse\t0\n", false);
    assert lab_test_verdict("misread\t\nsuite\t1\nbuild\t0\nbuild\t-9\nlab\t0\nsuite\t0\n\t124\nbuild\t0\n", false);
    assert lab_test_verdict("seal-currency\t-9\nseal-currency\t0\nmisread\t0\nmisread\t2\nsuite\t-9\nmisread\nmisread\t0\n", false);
    assert lab_test_verdict("suite\t0\nmisread\t0\nmisread\t124\nlean\t0\nspecs-generate\t0\n", true);
    assert lab_test_verdict("suite\t0\ncheckout\t1\nseal-coverage\t1\nbuild\t127\nbuild\t0\n", false);
    assert lab_test_verdict("lab\t0\n\t0\nseal-coverage\t1\ncheckout\t0\nseal-coverage\nmisread\t0\nspecs-generate\t0\nspecs-parse\t0\n", false);
    assert lab_test_verdict("seal-coverage\t\nmisread\t0\nsuite\t0\ncheckout\t0\nbuild\t0\nseal-currency\t\ncheckout\t-9\nseal-currency\t0\n", false);
    assert lab_test_verdict("checkout\t2\nmisread\t2\nsuite\t0\nbuild\t2\n\t1\n", false);
    assert lab_test_verdict("lean\t0\nlab\t0\nspecs-generate\t127\nlean\t1\nlab\t0\n", false);
    assert lab_test_verdict("seal-currency\t-9\nsuite\nspecs-parse\t0\nseal-coverage\t127\nsuite\t0\nlab\t0\nsuite\t127\ncheckout\t0\n", false);
    assert lab_test_verdict("build\t0\nsuite\t0\nseal-coverage\t127\nspecs-parse\t0\n\t124\n", false);
    assert lab_test_verdict("seal-coverage\t0\n", true);
    assert lab_test_verdict("specs-parse\t0\ncheckout\t2\nseal-coverage\t2\nlab\t0\n\t0\nspecs-parse\t127\nseal-currency\t0\nseal-coverage\t0\n", false);
    assert lab_test_verdict("lab\t0\n\t124\nseal-coverage\t127\n", false);
    assert lab_test_verdict("specs-generate\t0\nlab\t127\nmisread\t0\nspecs-parse\t0\ncheckout\t0\nseal-coverage\t2\nlab\t0\n", false);
    assert lab_test_verdict("build\t2\nlab\t124\n", false);
    assert lab_test_verdict("misread\t124\nsuite\t2\nlab\nseal-coverage\t-9\nspecs-parse\t1\ncheckout\t2\nsuite\t0\n", false);
    assert lab_test_verdict("lab\t0\nbuild\t124\nmisread\t124\nsuite\t-9\nspecs-parse\t-9\nspecs-generate\t127\ncheckout\t-9\nspecs-generate\t127\n", false);
    assert lab_test_verdict("\t-9\nseal-coverage\t0\n", false);
    assert lab_test_verdict("lab\t\n", false);
    assert lab_test_verdict("specs-generate\t0\nbuild\t1\nmisread\t127\ncheckout\t127\nlab\t0\nlean\t0\nspecs-parse\t1\n", false);
    assert lab_test_verdict("lab\t2\n\t1\ncheckout\t-9\n", false);
    assert lab_test_verdict("build\t0\nlab\t0\nbuild\t0\ncheckout\t0\nspecs-parse\t1\n", false);
    assert lab_test_verdict("misread\t0\nsuite\t0\nmisread\t1\n", true);
}

// run_item(): red = [g['name'] for g in gates if g.get('exit') != 0 and g['name'] not in REPORT_ONLY]
test lab_py_table_red_gates {
    assert lab_test_red("build\t-9\nlean\t0\nbuild\t127\n", "build\nbuild\n");
    assert lab_test_red("suite\t0\nsuite\t-9\nbuild\t\n", "suite\nbuild\n");
    assert lab_test_red("specs-parse\t-9\nseal-coverage\t0\nsuite\t-9\nseal-coverage\t0\n", "specs-parse\nsuite\n");
    assert lab_test_red("", "");
    assert lab_test_red("seal-coverage\t124\nlean\t-9\nlean\t0\nsuite\t1\n", "seal-coverage\nlean\nsuite\n");
    assert lab_test_red("seal-coverage\t0\nseal-coverage\t0\nspecs-generate\t0\nlab\t2\nbuild\t1\nspecs-parse\t1\nseal-currency\t1\nmisread\t-9\n", "lab\nbuild\nspecs-parse\nseal-currency\n");
    assert lab_test_red("seal-coverage\t0\nspecs-parse\t127\nspecs-generate\t124\nlean\t124\nseal-coverage\t0\nspecs-parse\t1\n", "specs-parse\nspecs-generate\nlean\nspecs-parse\n");
    assert lab_test_red("specs-parse\t127\nseal-coverage\t124\n", "specs-parse\nseal-coverage\n");
    assert lab_test_red("lean\t127\ncheckout\t0\nsuite\t0\nseal-currency\t124\n", "lean\nseal-currency\n");
    assert lab_test_red("specs-generate\t0\nseal-currency\t1\nspecs-generate\t0\n", "seal-currency\n");
    assert lab_test_red("lean\t124\nlean\t124\nspecs-generate\t1\nspecs-generate\t0\nmisread\t0\ncheckout\t2\n", "lean\nlean\nspecs-generate\ncheckout\n");
    assert lab_test_red("suite\t124\nseal-coverage\t0\n", "suite\n");
    assert lab_test_red("seal-coverage\t124\nlab\t127\nbuild\t127\nbuild\t0\nspecs-parse\t124\n", "seal-coverage\nlab\nbuild\nspecs-parse\n");
    assert lab_test_red("build\t124\nseal-coverage\t124\nspecs-parse\t\nbuild\t0\nmisread\t0\nmisread\t0\nsuite\t-9\n", "build\nseal-coverage\nspecs-parse\nsuite\n");
    assert lab_test_red("specs-parse\t124\nbuild\t0\nspecs-generate\t1\nbuild\t-9\nmisread\t0\nlean\t1\nsuite\t0\n", "specs-parse\nspecs-generate\nbuild\nlean\n");
    assert lab_test_red("specs-parse\t2\nseal-coverage\t2\nmisread\t124\nsuite\t1\nbuild\t0\n", "specs-parse\nseal-coverage\nsuite\n");
    assert lab_test_red("suite\t0\nlab\t\nbuild\t1\nlab\t124\nseal-coverage\t2\nsuite\t2\nspecs-generate\t127\n", "lab\nbuild\nlab\nseal-coverage\nsuite\nspecs-generate\n");
    assert lab_test_red("checkout\t-9\nmisread\t0\ncheckout\t-9\nlab\t-9\nmisread\t124\n", "checkout\ncheckout\nlab\n");
    assert lab_test_red("specs-generate\t0\nlab\t0\nseal-coverage\t-9\nmisread\t124\nlab\t124\nmisread\t1\nmisread\t0\ncheckout\t0\n", "seal-coverage\nlab\n");
    assert lab_test_red("specs-parse\t0\ncheckout\t0\nspecs-parse\t-9\nseal-currency\t\nlean\t0\nseal-coverage\t0\nsuite\t127\n", "specs-parse\nseal-currency\nsuite\n");
    assert lab_test_red("build\t0\nseal-coverage\t0\nbuild\t0\nseal-coverage\t124\ncheckout\t-9\nmisread\t0\n", "seal-coverage\ncheckout\n");
    assert lab_test_red("seal-currency\t0\n", "");
    assert lab_test_red("misread\t0\nlean\t0\nseal-currency\t\nseal-currency\t\nspecs-parse\t0\nlean\t0\nseal-coverage\t127\nspecs-generate\t0\n", "seal-currency\nseal-currency\nseal-coverage\n");
    assert lab_test_red("suite\t0\nlab\t0\nmisread\t2\nbuild\t0\n", "");
    assert lab_test_red("misread\t0\nlean\t0\nseal-coverage\t-9\nseal-coverage\t-9\n", "seal-coverage\nseal-coverage\n");
    assert lab_test_red("misread\t-9\ncheckout\t1\n", "checkout\n");
    assert lab_test_red("lab\t1\nbuild\t127\nspecs-generate\t0\nbuild\t1\nlean\t1\nlean\t124\nmisread\t0\nspecs-generate\t-9\n", "lab\nbuild\nbuild\nlean\nlean\nspecs-generate\n");
    assert lab_test_red("specs-parse\t0\nspecs-parse\t127\nlab\t2\nbuild\t2\ncheckout\t0\nmisread\t127\n", "specs-parse\nlab\nbuild\n");
    assert lab_test_red("specs-parse\t2\nlean\t0\nspecs-parse\t0\nlean\t\nsuite\t-9\nseal-coverage\t0\nlab\t\n", "specs-parse\nlean\nsuite\nlab\n");
    assert lab_test_red("specs-generate\t1\nseal-currency\t\nsuite\t127\nspecs-parse\t0\nspecs-generate\t0\n", "specs-generate\nseal-currency\nsuite\n");
    assert lab_test_red("specs-parse\t0\nlab\t127\nspecs-parse\t124\n", "lab\nspecs-parse\n");
    assert lab_test_red("lab\t0\nseal-currency\t2\nseal-currency\t-9\nlab\t-9\nseal-coverage\t0\n", "seal-currency\nseal-currency\nlab\n");
    assert lab_test_red("checkout\t2\nlean\t1\nspecs-generate\t\nspecs-parse\t-9\ncheckout\t124\n", "checkout\nlean\nspecs-generate\nspecs-parse\ncheckout\n");
    assert lab_test_red("seal-currency\t0\ncheckout\t0\nlean\t124\ncheckout\t0\nspecs-parse\t0\nspecs-parse\t127\n", "lean\nspecs-parse\n");
    assert lab_test_red("misread\t0\n", "");
    assert lab_test_red("seal-coverage\t1\nseal-coverage\t127\nlab\t\ncheckout\t0\nspecs-parse\t124\n", "seal-coverage\nseal-coverage\nlab\nspecs-parse\n");
    assert lab_test_red("seal-coverage\t\nsuite\t0\nlab\t0\nlean\t0\n", "seal-coverage\n");
    assert lab_test_red("seal-currency\t\nseal-currency\t0\nlab\t0\nseal-currency\t\nbuild\t0\nspecs-generate\t2\nseal-currency\t1\n", "seal-currency\nseal-currency\nspecs-generate\nseal-currency\n");
    assert lab_test_red("lab\t0\ncheckout\t\nseal-currency\t-9\nseal-coverage\t2\nlean\t2\nmisread\t0\nlean\t-9\n", "checkout\nseal-currency\nseal-coverage\nlean\nlean\n");
    assert lab_test_red("seal-coverage\t-9\nseal-coverage\t2\nsuite\t1\n", "seal-coverage\nseal-coverage\nsuite\n");
    assert lab_test_red("lean\t2\nlab\t0\nspecs-parse\t0\n", "lean\n");
    assert lab_test_red("misread\t\nsuite\t1\nbuild\t0\nbuild\t-9\nlab\t0\nsuite\t0\nbuild\t0\n", "suite\nbuild\n");
    assert lab_test_red("seal-currency\t-9\nseal-currency\t0\nmisread\t0\nmisread\t2\nsuite\t-9\nmisread\t\nmisread\t0\n", "seal-currency\nsuite\n");
    assert lab_test_red("suite\t0\nmisread\t0\nmisread\t124\nlean\t0\nspecs-generate\t0\n", "");
    assert lab_test_red("suite\t0\ncheckout\t1\nseal-coverage\t1\nbuild\t127\nbuild\t0\n", "checkout\nseal-coverage\nbuild\n");
    assert lab_test_red("lab\t0\nseal-coverage\t1\ncheckout\t0\nseal-coverage\t\nmisread\t0\nspecs-generate\t0\nspecs-parse\t0\n", "seal-coverage\nseal-coverage\n");
    assert lab_test_red("seal-coverage\t\nmisread\t0\nsuite\t0\ncheckout\t0\nbuild\t0\nseal-currency\t\ncheckout\t-9\nseal-currency\t0\n", "seal-coverage\nseal-currency\ncheckout\n");
    assert lab_test_red("checkout\t2\nmisread\t2\nsuite\t0\nbuild\t2\n", "checkout\nbuild\n");
    assert lab_test_red("lean\t0\nlab\t0\nspecs-generate\t127\nlean\t1\nlab\t0\n", "specs-generate\nlean\n");
    assert lab_test_red("seal-currency\t-9\nsuite\t\nspecs-parse\t0\nseal-coverage\t127\nsuite\t0\nlab\t0\nsuite\t127\ncheckout\t0\n", "seal-currency\nsuite\nseal-coverage\nsuite\n");
    assert lab_test_red("build\t0\nsuite\t0\nseal-coverage\t127\nspecs-parse\t0\n", "seal-coverage\n");
    assert lab_test_red("seal-coverage\t0\n", "");
    assert lab_test_red("specs-parse\t0\ncheckout\t2\nseal-coverage\t2\nlab\t0\nspecs-parse\t127\nseal-currency\t0\nseal-coverage\t0\n", "checkout\nseal-coverage\nspecs-parse\n");
    assert lab_test_red("lab\t0\nseal-coverage\t127\n", "seal-coverage\n");
    assert lab_test_red("specs-generate\t0\nlab\t127\nmisread\t0\nspecs-parse\t0\ncheckout\t0\nseal-coverage\t2\nlab\t0\n", "lab\nseal-coverage\n");
    assert lab_test_red("build\t2\nlab\t124\n", "build\nlab\n");
    assert lab_test_red("misread\t124\nsuite\t2\nlab\t\nseal-coverage\t-9\nspecs-parse\t1\ncheckout\t2\nsuite\t0\n", "suite\nlab\nseal-coverage\nspecs-parse\ncheckout\n");
    assert lab_test_red("lab\t0\nbuild\t124\nmisread\t124\nsuite\t-9\nspecs-parse\t-9\nspecs-generate\t127\ncheckout\t-9\nspecs-generate\t127\n", "build\nsuite\nspecs-parse\nspecs-generate\ncheckout\nspecs-generate\n");
    assert lab_test_red("lab\t\n", "lab\n");
    assert lab_test_red("specs-generate\t0\nbuild\t1\nmisread\t127\ncheckout\t127\nlab\t0\nlean\t0\nspecs-parse\t1\n", "build\ncheckout\nspecs-parse\n");
    assert lab_test_red("lab\t2\ncheckout\t-9\n", "lab\ncheckout\n");
    assert lab_test_red("build\t0\nlab\t0\nbuild\t0\ncheckout\t0\nspecs-parse\t1\n", "specs-parse\n");
    assert lab_test_red("misread\t0\nsuite\t0\nmisread\t1\n", "");
}

