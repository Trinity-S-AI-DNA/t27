// SPDX-License-Identifier: Apache-2.0
; specs/lab/verdict.t27 -- what the t27c lab's gates are, how a gate's log is read, and when a commit is green (gHashTag/t27#11041, #11040)
; The t27c lab (infra/t27c-lab/lab.py) runs every commit it queues through eight gates in CI's order and records for each one an
; exit code, the seconds, and one line a person reads first (the gate's `summary`). The commit is green when every gate that
; counts exited 0. This file is those decisions as pure functions of text and numbers, one per Python function (the Python being
; the oracle until the cutover), on no host in particular: whoever runs a gate hands the exit code and the log to these. The eight
; gates are a closed table (lab_gate_*): the ids and the commands a lab job kind (#11043) may name, for any node that takes one.
;   GATES, NEEDS_BUILD, REPORT_ONLY     the lab_gate_* table
;   summary(text, pattern)              lab_summary, lab_summary_write
;   misread_counts(text)                lab_misread_counts
;   misread_line(counts, fallback)      lab_misread_line
;   verdict(gates)                      lab_verdict
;   run_item(): red_gates, a skipped gate, built, when the seals are refreshed   lab_red_gates, lab_gate_skipped, lab_built_after, lab_seals_due
;   sh(): a limit kills the gate, exit 124   lab_exit_after
;   publish_latest(): what a head's state is   lab_head_state
; THE PATTERNS. summary() takes a regex. The lab uses five: none, and the four of GATES (`Finished|^error`, `RATCHET`,
; `test result:`, `pair\(s\) are silent|^\s*Nothing found|CONTROL FAILED`). They are the LAB_PAT_* rows, each coded as the literals
; it holds, the anchor and the leading spaces; a sixth pattern is a new row, not a regex engine.
; THE TEXTS. A gate row is `<name> TAB <exit>` on a line: the name may be empty (a gate with no name), the exit is the decimal
; integer Python would print, or empty for None (a gate that did not run, or no exit at all). A gate counts unless its name
; is `misread`. verdict() is green when at least one gate counts and every counting gate has the exit text `0`.
; THE LINES. summary() and misread_counts() read command output the way Python does: str.splitlines() breaks, str.strip()
; spaces, `[:300]` characters (spec text.t27). The misread rows are the regex `^\s+(\d+)\s+(\d+)\s+(\d+)\s+\S` with re.M, run as
; findall does: left to right, each match ending where the next search starts. `\s` crosses lines, so a row of three numbers
; with nothing after them still matches when the next line starts with a non-space, and then it takes that character: the port
; does the same, and tests it. Not ported: a count of more than 18 digits (Python reads any size; the lab's logs carry none), and
; a Unicode digit that is not 0-9. A log with either is read as NOT READ (fail closed), and the summary falls back to its log line.
; ASCII only (L3)
; phi^2 + 1/phi^2 = 3 | TRINITY

module LabVerdict;

use tri::lab::receipt::span_is;
use lab::text::LAB_NO;
use lab::text::LAB_DEC_BAD;
use lab::text::lab_line_end;
use lab::text::lab_line_next;
use lab::text::lab_find_byte;
use lab::text::lab_has_text;
use lab::text::lab_has_lit;
use lab::text::lab_lit_at;
use lab::text::lab_strip_from;
use lab::text::lab_strip_to;
use lab::text::lab_cut_chars;
use lab::text::lab_space_len;
use lab::text::lab_char_len;
use lab::text::lab_count_of;
use lab::text::lab_put_span;
use lab::text::lab_put_lit;
use lab::text::lab_put_count;

/// The number of gates, in CI's order: nothing runs on a failed build.
pub const LAB_GATE_COUNT : usize = 8;

/// The summary patterns (the regex of a gate, or none: the last non-empty line).
pub const LAB_PAT_NONE : u8 = 0;
pub const LAB_PAT_BUILD : u8 = 1;
pub const LAB_PAT_SUITE : u8 = 2;
pub const LAB_PAT_LEAN : u8 = 3;
pub const LAB_PAT_MISREAD : u8 = 4;

/// The longest summary line: 300 characters.
pub const LAB_SUMMARY_CHARS : usize = 300;

/// What the lab publishes of a verdict.
pub const LAB_V_RED : u8 = 0;
pub const LAB_V_GREEN : u8 = 1;

/// The most any one of the three misread counts, and their sums, may hold: 10^18 - 1 (an 18-digit count fits u64 with room to add).
pub const LAB_COUNT_MAX : u64 = 999999999999999999;

/// The exit codes the lab itself makes up: a limit killed the gate, the program was not found.
pub const LAB_EXIT_TIMEOUT : i64 = 124;
pub const LAB_EXIT_NOT_FOUND : i64 = 127;

/// What a head shows in /latest.json.
pub const LAB_HS_NOT_RUN : u8 = 0;
pub const LAB_HS_QUEUED : u8 = 1;
pub const LAB_HS_RUNNING : u8 = 2;
pub const LAB_HS_UNREADABLE : u8 = 3;
pub const LAB_HS_FROM_RUN : u8 = 4;

/// The record the lab writes for a gate it skipped, and the log line.
pub const LAB_SKIPPED : string = "skipped: the build failed";

/// Gates the lab invents when no gate of the table ran: a checkout that failed, and an error of the lab itself.
pub const LAB_GATE_CHECKOUT : string = "checkout";
pub const LAB_GATE_LAB : string = "lab";

/// The name of gate i (GATES[i][0]).
pub fn lab_gate_name(i: usize) -> string {
    if (i == 0) { return "build"; }
    if (i == 1) { return "suite"; }
    if (i == 2) { return "lean"; }
    if (i == 3) { return "seal-currency"; }
    if (i == 4) { return "seal-coverage"; }
    if (i == 5) { return "specs-parse"; }
    if (i == 6) { return "specs-generate"; }
    return "misread";
}

/// The command of gate i, argv joined by single spaces as the record's `cmd` holds it ({run} is the run's directory).
pub fn lab_gate_cmd(i: usize) -> string {
    if (i == 0) { return "cargo build --release -p t27c -p tri"; }
    if (i == 1) { return "./target/release/t27c suite --repo-root . --corpus-only --ratchet --json {run}/suite.json"; }
    if (i == 2) { return "cargo test --release -p t27c --test icarus_lowerable corpus_classifier_matches_lean_completeness"; }
    if (i == 3) { return "python3 tools/check_seal_currency.py"; }
    if (i == 4) { return "python3 tools/check_seal_coverage.py"; }
    if (i == 5) { return "python3 tools/ci/check_specs_still_parse.py --base origin/master"; }
    if (i == 6) { return "python3 tools/check_specs_generate.py"; }
    return "./target/release/tri misread --list";
}

/// The limit of gate i, in seconds.
pub fn lab_gate_timeout(i: usize) -> u32 {
    if (i == 0 or i == 2) { return 3600; }
    if (i == 1) { return 5400; }
    return 1800;
}

/// The pattern whose last matching line is gate i's summary.
pub fn lab_gate_pattern(i: usize) -> u8 {
    if (i == 0) { return LAB_PAT_BUILD; }
    if (i == 1) { return LAB_PAT_SUITE; }
    if (i == 2) { return LAB_PAT_LEAN; }
    if (i == 7) { return LAB_PAT_MISREAD; }
    return LAB_PAT_NONE;
}

/// Is the text t[from..to] the name of gate i?
pub fn lab_gate_is(i: usize, t: string, from: usize, to: usize) -> bool {
    return span_is(t, from, to, lab_gate_name(i));
}

/// The index of the gate named t[from..to] in the table, or LAB_NO (the invented gates are not in it).
pub fn lab_gate_index(t: string, from: usize, to: usize) -> usize {
    var i : usize = 0;
    while (i < LAB_GATE_COUNT) {
        if (lab_gate_is(i, t, from, to)) { return i; }
        i = i + 1;
    }
    return LAB_NO;
}

/// Is t[from..to] the name of a gate of the table? The table is a CLOSED set: a name outside it (a branch's text, a command, an
/// upper-case or padded spelling) is no gate, so whoever hands out work (one lab, or a network of nodes, #11043) refuses it before
/// anyone runs it, and the command a gate runs is only ever lab_gate_cmd(i), never text from a pull request.
pub fn lab_gate_known(t: string, from: usize, to: usize) -> bool {
    return lab_gate_index(t, from, to) != LAB_NO;
}

/// REPORT_ONLY: measured and published, never part of the verdict. Any name, in the table or not.
pub fn lab_name_report_only(t: string, from: usize, to: usize) -> bool {
    return span_is(t, from, to, "misread");
}

/// NEEDS_BUILD: every gate of the table but `build` itself.
pub fn lab_name_needs_build(t: string, from: usize, to: usize) -> bool {
    const i : usize = lab_gate_index(t, from, to);
    return i != LAB_NO and i != 0;
}

/// Does the line t[from..to] (already stripped on the right) match the gate pattern pid, as `re.search` would?
pub fn lab_pattern_hits(pid: u8, t: string, from: usize, to: usize) -> bool {
    if (pid == LAB_PAT_BUILD) { return lab_has_lit(t, from, to, "Finished") or lab_lit_at(t, from, to, "error"); }
    if (pid == LAB_PAT_SUITE) { return lab_has_lit(t, from, to, "RATCHET"); }
    if (pid == LAB_PAT_LEAN) { return lab_has_lit(t, from, to, "test result:"); }
    if (pid == LAB_PAT_MISREAD) {
        if (lab_has_lit(t, from, to, "pair(s) are silent") or lab_has_lit(t, from, to, "CONTROL FAILED")) { return true; }
        return lab_lit_at(t, lab_strip_from(t, from, to), to, "Nothing found");
    }
    return false;
}

/// A span of the text a summary is: t[from..to].
pub struct LabSummarySpan { from: usize, to: usize }

/// summary(text, pattern): the last line that matches the pattern, else the last non-empty line, stripped and cut to 300 characters;
/// an empty span when the text has no non-empty line. (A line is str.splitlines()'s; empty means all spaces.)
pub fn lab_summary(t: string, pid: u8) -> LabSummarySpan {
    var hit_s : usize = LAB_NO;
    var hit_e : usize = 0;
    var last_s : usize = LAB_NO;
    var last_e : usize = 0;
    var s : usize = 0;
    while (s < t.len) {
        const e : usize = lab_line_end(t, s);
        if (lab_has_text(t, s, e)) {
            const r : usize = lab_strip_to(t, s, e);
            last_s = s;
            last_e = r;
            if (lab_pattern_hits(pid, t, s, r)) {
                hit_s = s;
                hit_e = r;
            }
        }
        s = lab_line_next(t, e);
    }
    var from : usize = last_s;
    var to : usize = last_e;
    if (hit_s != LAB_NO) {
        from = hit_s;
        to = hit_e;
    }
    if (from == LAB_NO) { return LabSummarySpan { from: 0, to: 0 }; }
    const f : usize = lab_strip_from(t, from, to);
    return LabSummarySpan { from: f, to: lab_cut_chars(t, f, to, LAB_SUMMARY_CHARS) };
}

/// summary(): write the summary line into dst at w, clipped at cap; the new cursor.
pub fn lab_summary_write(t: string, pid: u8, dst: []u8, cap: usize, w: usize) -> usize {
    const sp : LabSummarySpan = lab_summary(t, pid);
    return lab_put_span(dst, cap, w, t, sp.from, sp.to);
}

/// The three totals of `tri misread`'s table; `read` is false when the output did not reach its table (or this port cannot read it).
pub struct LabMisread { read: bool, pairs: u64, refused: u64, silent: u64 }

/// A row of the table: the end of its match (LAB_NO when it does not match) and its three counts.
pub struct LabMisreadRow { end: usize, pairs: u64, refused: u64, silent: u64 }

/// The end of the run of spaces that starts at q (q itself when none does).
pub fn lab_space_run(t: string, q: usize) -> usize {
    var k : usize = q;
    while (k < t.len) {
        const n : usize = lab_space_len(t, k, t.len);
        if (n == 0) { return k; }
        k = k + n;
    }
    return k;
}

/// The end of the run of ASCII digits that starts at q (q itself when none does).
pub fn lab_digit_run(t: string, q: usize) -> usize {
    var k : usize = q;
    while (k < t.len and t[k] >= 48 and t[k] <= 57) {
        k = k + 1;
    }
    return k;
}

/// Try the row regex `\s+(\d+)\s+(\d+)\s+(\d+)\s+\S` at p. Greedy runs never need to give back: a space is not a digit and a
/// digit is not a space, so the first way to match is the only one.
pub fn lab_misread_row(t: string, p: usize) -> LabMisreadRow {
    const no_row : LabMisreadRow =LabMisreadRow { end: LAB_NO, pairs: 0, refused: 0, silent: 0 };
    const a0 : usize = lab_space_run(t, p);
    if (a0 == p) { return no_row; }
    const a1 : usize = lab_digit_run(t, a0);
    if (a1 == a0) { return no_row; }
    const b0 : usize = lab_space_run(t, a1);
    if (b0 == a1) { return no_row; }
    const b1 : usize = lab_digit_run(t, b0);
    if (b1 == b0) { return no_row; }
    const c0 : usize = lab_space_run(t, b1);
    if (c0 == b1) { return no_row; }
    const c1 : usize = lab_digit_run(t, c0);
    if (c1 == c0) { return no_row; }
    const d0 : usize = lab_space_run(t, c1);
    if (d0 == c1 or d0 >= t.len) { return no_row; }
    return LabMisreadRow { end: d0 + lab_char_len(t, d0, t.len), pairs: lab_count_of(t, a0, a1), refused: lab_count_of(t, b0, b1), silent: lab_count_of(t, c0, c1) };
}

/// misread_counts(text): the totals of the rows of `tri misread`'s table; not read when the text has CONTROL FAILED, has no table
/// header (`pairs  refused  silent`, two spaces between), or a count is one this port refuses (see the header).
pub fn lab_misread_counts(t: string) -> LabMisread {
    const unread : LabMisread = LabMisread { read: false, pairs: 0, refused: 0, silent: 0 };
    if (lab_has_lit(t, 0, t.len, "CONTROL FAILED")) { return unread; }
    if (lab_has_lit(t, 0, t.len, "pairs  refused  silent") == false) { return unread; }
    var pairs : u64 = 0;
    var refused : u64 = 0;
    var silent : u64 = 0;
    var p : usize = 0;
    while (p < t.len) {
        var step : usize = 1;
        if (p == 0 or t[p - 1] == 10) {
            const row : LabMisreadRow = lab_misread_row(t, p);
            if (row.end != LAB_NO) {
                if (row.pairs == LAB_DEC_BAD or row.refused == LAB_DEC_BAD or row.silent == LAB_DEC_BAD) { return unread; }
                if (pairs + row.pairs > LAB_COUNT_MAX or refused + row.refused > LAB_COUNT_MAX or silent + row.silent > LAB_COUNT_MAX) { return unread; }
                pairs = pairs + row.pairs;
                refused = refused + row.refused;
                silent = silent + row.silent;
                step = row.end - p;
            }
        }
        p = p + step;
    }
    return LabMisread { read: true, pairs: pairs, refused: refused, silent: silent };
}

/// misread_line(counts, fallback): the counts in words (`<silent> of <pairs> pair(s) silent, <refused> refused by typecheck`; refused
/// LAB_DEC_BAD is None: `refusals not measured`), else the fallback line fb[ff..ft], into dst at w, clipped at cap; the new cursor.
pub fn lab_misread_line(m: LabMisread, fb: string, ff: usize, ft: usize, dst: []u8, cap: usize, w: usize) -> usize {
    if (m.read == false) { return lab_put_span(dst, cap, w, fb, ff, ft); }
    var x : usize = lab_put_count(dst, cap, w, m.silent);
    x = lab_put_lit(dst, cap, x, " of ");
    x = lab_put_count(dst, cap, x, m.pairs);
    x = lab_put_lit(dst, cap, x, " pair(s) silent, ");
    if (m.refused == LAB_DEC_BAD) { return lab_put_lit(dst, cap, x, "refusals not measured"); }
    x = lab_put_count(dst, cap, x, m.refused);
    return lab_put_lit(dst, cap, x, " refused by typecheck");
}

/// verdict(gates): green when at least one gate counts (its name is not REPORT_ONLY) and every counting gate has the exit text 0.
pub fn lab_verdict(rows: string) -> u8 {
    var counted : usize = 0;
    var s : usize = 0;
    while (s < rows.len) {
        const e : usize = lab_line_end(rows, s);
        var name_to : usize = lab_find_byte(rows, s, e, 9);
        var exit_from : usize = e;
        if (name_to == LAB_NO) {
            name_to = e;
        } else {
            exit_from = name_to + 1;
        }
        if (lab_name_report_only(rows, s, name_to) == false) {
            counted = counted + 1;
            if (span_is(rows, exit_from, e, "0") == false) { return LAB_V_RED; }
        }
        s = lab_line_next(rows, e);
    }
    if (counted == 0) { return LAB_V_RED; }
    return LAB_V_GREEN;
}

/// The word the lab publishes for a verdict.
pub fn lab_verdict_name(v: u8) -> string {
    if (v == LAB_V_GREEN) { return "green"; }
    return "red";
}

/// run_item()'s red_gates: the names of the gates whose exit is not 0 and that are not REPORT_ONLY, one per line, in order, into dst
/// at w, clipped at cap; the new cursor. (A gate with no exit is red.)
pub fn lab_red_gates(rows: string, dst: []u8, cap: usize, w: usize) -> usize {
    var x : usize = w;
    var s : usize = 0;
    while (s < rows.len) {
        const e : usize = lab_line_end(rows, s);
        var name_to : usize = lab_find_byte(rows, s, e, 9);
        var exit_from : usize = e;
        if (name_to == LAB_NO) {
            name_to = e;
        } else {
            exit_from = name_to + 1;
        }
        if (lab_name_report_only(rows, s, name_to) == false and span_is(rows, exit_from, e, "0") == false) {
            x = lab_put_span(dst, cap, x, rows, s, name_to);
            x = lab_put_lit(dst, cap, x, "\n");
        }
        s = lab_line_next(rows, e);
    }
    return x;
}

/// run_item(): a gate that needs the build is skipped once the build failed.
pub fn lab_gate_skipped(i: usize, built: bool) -> bool {
    return i != 0 and i < LAB_GATE_COUNT and built == false;
}

/// run_item(): the build is still good after gate i exited with code, unless this is the build and it did not exit 0.
pub fn lab_built_after(i: usize, code: i64, built: bool) -> bool {
    if (i == 0 and code != 0) { return false; }
    return built;
}

/// run_item(): the seal refresh of #9080 runs after the gates of a commit a `master` branch points at, and only if it built.
pub fn lab_seals_due(has_master: bool, built: bool) -> bool {
    return has_master and built;
}

/// sh(): a gate that ran longer than its limit is killed and exits 124, whatever the program said.
pub fn lab_exit_after(code: i64, elapsed: f64, limit: i64) -> i64 {
    if (elapsed > (limit as f64)) { return LAB_EXIT_TIMEOUT; }
    return code;
}

/// publish_latest(): what a head shows. A run file that exists but cannot be read is `unreadable`; one that reads shows its own
/// verdict; no run file: `running` when it is the commit being run, else `queued` when it is in the queue, else `not run`.
pub fn lab_head_state(run_exists: bool, run_readable: bool, is_running: bool, is_queued: bool) -> u8 {
    if (run_exists) {
        if (run_readable) { return LAB_HS_FROM_RUN; }
        return LAB_HS_UNREADABLE;
    }
    if (is_running) { return LAB_HS_RUNNING; }
    if (is_queued) { return LAB_HS_QUEUED; }
    return LAB_HS_NOT_RUN;
}

/// The word a head shows for a state (LAB_HS_FROM_RUN shows the run's own verdict, so it has none here).
pub fn lab_head_state_name(h: u8) -> string {
    if (h == LAB_HS_QUEUED) { return "queued"; }
    if (h == LAB_HS_RUNNING) { return "running"; }
    if (h == LAB_HS_UNREADABLE) { return "unreadable"; }
    if (h == LAB_HS_NOT_RUN) { return "not run"; }
    return "";
}

// ---- tests ----
// The oracle is infra/t27c-lab/lab.py. Every case below is its answer (Python 3.14.6), pinned: first the asserts of its
// self_check(), one to one, then the gate table and tables of inputs run through its own functions (summary, misread_counts,
// misread_line, verdict, the red_gates expression, sh()'s limit, publish_latest()'s head state).

/// summary(text, pattern) for the five patterns: none, GATES[0], GATES[1], GATES[2], GATES[7].
fn lab_test_summary(t: string, pid: u8, want: string) -> bool {
    var out : [1400]u8 = undefined;
    const w : usize = lab_summary_write(t, pid, &out, 1400, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

fn lab_test_summaries(t: string, w0: string, w1: string, w2: string, w3: string, w4: string) -> bool {
    return lab_test_summary(t, LAB_PAT_NONE, w0) and lab_test_summary(t, LAB_PAT_BUILD, w1) and lab_test_summary(t, LAB_PAT_SUITE, w2) and lab_test_summary(t, LAB_PAT_LEAN, w3) and lab_test_summary(t, LAB_PAT_MISREAD, w4);
}

/// misread_counts(text): read or not, and the three totals.
fn lab_test_misread(t: string, read: bool, pairs: u64, refused: u64, silent: u64) -> bool {
    const m : LabMisread = lab_misread_counts(t);
    if (m.read != read) { return false; }
    if (read == false) { return m.pairs == 0 and m.refused == 0 and m.silent == 0; }
    return m.pairs == pairs and m.refused == refused and m.silent == silent;
}

/// misread_line(misread_counts(text), fallback)
fn lab_test_misread_line(t: string, fb: string, want: string) -> bool {
    var out : [256]u8 = undefined;
    const w : usize = lab_misread_line(lab_misread_counts(t), fb, 0, fb.len, &out, 256, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

fn lab_test_verdict(rows: string, green: bool) -> bool {
    if (green) { return lab_verdict(rows) == LAB_V_GREEN; }
    return lab_verdict(rows) == LAB_V_RED;
}

fn lab_test_red(rows: string, want: string) -> bool {
    var out : [256]u8 = undefined;
    const w : usize = lab_red_gates(rows, &out, 256, 0);
    return w == want.len and span_is(&out, 0, w, want);
}

/// One row of GATES: its name, limit, summary pattern, whether it needs the build, whether it is report-only, and its command.
fn lab_test_gate(i: usize, name: string, limit: u32, pid: u8, needs_build: bool, report_only: bool, cmd: string) -> bool {
    const n : string = lab_gate_name(i);
    const c : string = lab_gate_cmd(i);
    if (span_is(n, 0, n.len, name) == false or span_is(c, 0, c.len, cmd) == false) { return false; }
    if (lab_gate_timeout(i) != limit or lab_gate_pattern(i) != pid) { return false; }
    if (lab_gate_index(name, 0, name.len) != i) { return false; }
    return lab_name_needs_build(name, 0, name.len) == needs_build and lab_name_report_only(name, 0, name.len) == report_only;
}

// <<< pinned table: verdict_self_check
test lab_py_self_check_summary_is_the_last_matching_line_else_the_last_non_empty_line {
    assert lab_test_summary("x\nRATCHET CLEAN 113/113\ny\n", LAB_PAT_SUITE, "RATCHET CLEAN 113/113");
    assert lab_test_summary("x\n\nlast\n\n", LAB_PAT_NONE, "last");
    assert lab_test_summary("", LAB_PAT_SUITE, "");
    assert lab_test_summary("  pairs  refused  silent\n     12       12       0  an empty type slot\n      5        3       2  a colon inside a field type\n\n  2 of 17 pair(s) are silent: the spec parses\n", LAB_PAT_MISREAD, "2 of 17 pair(s) are silent: the spec parses");
}

test lab_py_self_check_verdict_is_green_only_when_every_counting_gate_exited_zero {
    assert lab_test_verdict("\t0\n\t0\n", true);
    assert lab_test_verdict("\t0\n\n", false);
    assert lab_test_verdict("", false);
    assert lab_test_verdict("build\t0\nmisread\t1\n", true);
    assert lab_test_verdict("misread\t0\n", false);
}

test lab_py_self_check_misread_counts_reads_the_table_and_nothing_else {
    assert lab_test_misread("  pairs  refused  silent\n     12       12       0  an empty type slot\n      5        3       2  a colon inside a field type\n\n  2 of 17 pair(s) are silent: the spec parses\n", true, 17, 15, 2);
    assert lab_test_misread("  CONTROL FAILED -- these shapes did not fire\n", false, 0, 0, 0);
    assert lab_test_misread("error: target/release/t27c is not built\n", false, 0, 0, 0);
    assert lab_test_misread("  pairs  refused  silent\n\n  Nothing found\n", true, 0, 0, 0);
}

test lab_py_self_check_misread_line_says_the_counts_in_words {
    assert lab_test_misread_line("  pairs  refused  silent\n     12       12       0  an empty type slot\n      5        3       2  a colon inside a field type\n\n  2 of 17 pair(s) are silent: the spec parses\n", "", "2 of 17 pair(s) silent, 15 refused by typecheck");
}

// >>> pinned table: verdict_self_check
// <<< pinned table: verdict_gates
// GATES, NEEDS_BUILD and REPORT_ONLY, row by row.
test lab_py_table_gates {
    assert lab_test_gate(0, "build", 3600, 1, false, false, "cargo build --release -p t27c -p tri");
    assert lab_test_gate(1, "suite", 5400, 2, true, false, "./target/release/t27c suite --repo-root . --corpus-only --ratchet --json {run}/suite.json");
    assert lab_test_gate(2, "lean", 3600, 3, true, false, "cargo test --release -p t27c --test icarus_lowerable corpus_classifier_matches_lean_completeness");
    assert lab_test_gate(3, "seal-currency", 1800, 0, true, false, "python3 tools/check_seal_currency.py");
    assert lab_test_gate(4, "seal-coverage", 1800, 0, true, false, "python3 tools/check_seal_coverage.py");
    assert lab_test_gate(5, "specs-parse", 1800, 0, true, false, "python3 tools/ci/check_specs_still_parse.py --base origin/master");
    assert lab_test_gate(6, "specs-generate", 1800, 0, true, false, "python3 tools/check_specs_generate.py");
    assert lab_test_gate(7, "misread", 1800, 4, true, true, "./target/release/tri misread --list");
    assert lab_gate_index("checkout", 0, 8) == LAB_NO and lab_gate_index("lab", 0, 3) == LAB_NO;
}

// The names outside the table: not in NEEDS_BUILD, not in REPORT_ONLY, unless they are `misread`.
test lab_py_table_names_outside_the_table {
    assert lab_name_needs_build("checkout", 0, 8) == false and lab_name_report_only("checkout", 0, 8) == false;
    assert lab_name_needs_build("lab", 0, 3) == false and lab_name_report_only("lab", 0, 3) == false;
    assert lab_name_needs_build("", 0, 0) == false and lab_name_report_only("", 0, 0) == false;
    assert lab_name_needs_build("build ", 0, 6) == false and lab_name_report_only("build ", 0, 6) == false;
    assert lab_name_needs_build(" misread", 0, 8) == false and lab_name_report_only(" misread", 0, 8) == false;
    assert lab_name_needs_build("Misread", 0, 7) == false and lab_name_report_only("Misread", 0, 7) == false;
    assert lab_name_needs_build("misread ", 0, 8) == false and lab_name_report_only("misread ", 0, 8) == false;
    assert lab_name_needs_build("misreads", 0, 8) == false and lab_name_report_only("misreads", 0, 8) == false;
    assert lab_name_needs_build("specs", 0, 5) == false and lab_name_report_only("specs", 0, 5) == false;
    assert lab_name_needs_build("specs-generate", 0, 14) == true and lab_name_report_only("specs-generate", 0, 14) == false;
    assert lab_name_needs_build("seal", 0, 4) == false and lab_name_report_only("seal", 0, 4) == false;
    assert lab_name_needs_build("suite", 0, 5) == true and lab_name_report_only("suite", 0, 5) == false;
    assert lab_name_needs_build("BUILD", 0, 5) == false and lab_name_report_only("BUILD", 0, 5) == false;
    assert lab_name_needs_build("lean", 0, 4) == true and lab_name_report_only("lean", 0, 4) == false;
    assert lab_name_needs_build("x", 0, 1) == false and lab_name_report_only("x", 0, 1) == false;
}

