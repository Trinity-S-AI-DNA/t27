/// Test driver: the index of rel in the fixture tree, or LAB_NO when the tree has no such file.
fn lc_test_find(rel : string) -> usize {
    var i : usize = 0;
    while (i < 10) {
        if (lab_same_span(FS_PATH[i], 0, FS_PATH[i].len, rel, 0, rel.len)) { return i; }
        i = i + 1;
    }
    return LAB_NO;
}

/// Test driver: the key of the closure of start over the fixture tree, written at out[0..64]; 64 on success.
fn lc_test_key(stamp : string, edges : string, start : string, out : []u8) -> usize {
    var vis : [300]u32 = undefined;
    var text : [4096]u8 = undefined;
    const w : usize = lc_closure(edges, start, &vis, 100, &text, 4096, 0);
    if (w == LAB_NO) { return 0; }
    var sha : SHA256 = init();
    lc_key_begin(&sha, stamp);
    var s : usize = 0;
    while (s < w) {
        var e : usize = s;
        while (e < w and text[e] != 10) {
            e = e + 1;
        }
        const f : usize = lc_test_find(text[s..e]);
        if (f == LAB_NO) {
            lc_key_file(&sha, text[s..e], "", false);
        } else {
            lc_key_file(&sha, text[s..e], FS_DATA[f], true);
        }
        s = e + 1;
    }
    return lc_key_hex(&sha, out, 64, 0);
}

/// Test driver: the stamp of a binary and a zig line, the binary hashed here.
fn lc_test_stamp(bin : string, zig : string, out : []u8, cap : usize) -> usize {
    var sha : SHA256 = init();
    update(&sha, bin);
    var hex : [64]u8 = undefined;
    const x : usize = lc_key_hex(&sha, &hex, 64, 0);
    return lc_stamp(hex[0..x], zig, out, cap, 0);
}

test the_closure_and_the_key_equal_the_pythons_on_every_case {
    var vis : [300]u32 = undefined;
    var text : [4096]u8 = undefined;
    var hex : [64]u8 = undefined;
    var i : usize = 0;
    while (i < CK_N) {
        const w : usize = lc_closure(CK_EDGES[i], CK_START[i], &vis, 100, &text, 4096, 0);
        assert lx_out_is(&text, w, CK_CLOSURE[i]) == true;
        assert lc_test_key(CK_STAMP[i], CK_EDGES[i], CK_START[i], &hex) == 64;
        assert lx_out_is(&hex, 64, CK_KEY[i]) == true;
        i = i + 1;
    }
}

test cacheable_equals_the_pythons_on_every_verdict_and_detail {
    var i : usize = 0;
    while (i < CA_N) {
        assert lc_cacheable(CA_V[i], CA_D[i]) == (CA_OK[i] == 1);
        i = i + 1;
    }
}

test the_hit_rule_equals_reference_all_on_every_entry {
    var i : usize = 0;
    while (i < HT_N) {
        assert lc_hit_usable(HT_LEN[i], HT_V[i], HT_D[i], HT_HAS[i] == 1, HT_WANT[i] == 1) == (HT_OK[i] == 1);
        i = i + 1;
    }
}

test the_cache_line_and_the_reused_text_equal_the_pythons {
    var out : [256]u8 = undefined;
    var i : usize = 0;
    while (i < ST_N) {
        const w : usize = lc_log_line(ST_HITS[i], ST_TO_RUN[i], "STAMP", &out, 256, 0);
        assert lx_out_is(&out, w, ST_LOG[i]) == true;
        const r : usize = lc_reused(ST_HITS[i], ST_MISSES[i], ST_NOT_CACHED[i], &out, 256, 0);
        assert lx_out_is(&out, r, ST_REUSED[i]) == true;
        i = i + 1;
    }
}

test first_line_equals_the_pythons_on_every_output_pair {
    var out : [256]u8 = undefined;
    var i : usize = 0;
    while (i < FL_N) {
        const w : usize = lc_first_line(FL_OUT[i], FL_ERR[i], &out, 256, 0);
        assert lx_out_is(&out, w, FL_LINE[i]) == true;
        i = i + 1;
    }
}

test the_stamp_equals_reference_stamp_on_every_binary {
    var out : [512]u8 = undefined;
    var i : usize = 0;
    while (i < SM_N) {
        const w : usize = lc_test_stamp(SM_BIN[i], SM_ZIG[i], &out, 512);
        assert lx_out_is(&out, w, SM_STAMP[i]) == true;
        i = i + 1;
    }
}
