// SPDX-License-Identifier: Apache-2.0
; specs/lab/lab_t27b_cache.t27 -- the reference cache of the t27b lab: what a cached verdict depends on, which verdicts are
; kept, and when a kept one is used (issue #11042, epic #11040).
; --
; The oracle is contrib/railway/t27b-lab/lab.py (imported unedited). A t27c reference verdict is a function of the spec's
; bytes, the bytes of every spec it imports with `use`, the t27c binary and the zig that compiles its output; the lab
; keeps verdicts under the sha256 of exactly those. The tables at the end were computed by running lab.py: use_closure and
; reference_key on a tree of ten files written for the table, reference_cacheable on every verdict word with every
; detail, reference_all itself (its process-spawning parts replaced) for the hit rule and for the two lines it writes,
; first_line with its subprocess replaced, and reference_stamp on binaries written for the table.
; --
; PORTED, lab.py name -> here:
;   reference_cacheable          lc_cacheable
;   reference_all, the hit rule  lc_hit_usable
;   reference_all, its two texts lc_log_line, lc_reused
;   reference_stamp, first_line  lc_stamp, lc_first_line (the line of stdout or stderr, and Python's IndexError words)
;   use_closure                  lc_closure (the edges are t27c's `use-edges` text; lc_reach, lc_path_cmp)
;   reference_key                lc_key_begin, lc_key_file, lc_key_hex (streaming sha256 over specs/tri/crypto/sha256.t27)
; LEFT OUT, and why: reading the files and the t27c binary, running `t27c use-edges`, the cache file's JSON, the lock and
; the thread pool (they touch the disk or run processes: the runtime, #11040 L3). The caller streams the files of the
; closure into lc_key_file, in the order lc_closure writes them.
; --
; THE ORDER OF A CLOSURE is pathlib's, not the string order: `specs/a/x.t27` sorts before `specs/a.t27` (comparing
; component by component, a directory `a` sorts before the file `a.t27`), where the strings sort the other way round.
; Both were measured; the table holds ten such cases. A spec that is no key of the edges takes the list of the key `*`
; (what lab.py writes for every spec when it has no t27c to ask), and no list when there is no such key either.
; WHERE THE SPEC DIFFERS FROM THE PYTHON: paths are relative, already normalised and without symlinks (t27c prints them so);
; a closure of more nodes than the caller's buffer is refused (LAB_NO), never cut.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module LabT27bCache;

use lab::text::{LAB_NO, lab_line_end, lab_line_next, lab_strip_from, lab_strip_to, lab_lit_at, lab_same_span, lab_span_cmp, lab_find_byte, lab_put_span, lab_put_lit, lab_put_count};
use lab::lab_t27b_text::{lx_out_is};
use tri::crypto::sha256::{init, update, final, to_hex, SHA256};

/// The key of a reference verdict starts with this text and a NUL byte: lab.py's b"t27b-lab-ref-v1\0".
pub const LC_PREFIX : string = "t27b-lab-ref-v1";
/// The tail of the data a file that cannot be read is hashed as: a NUL byte and these seven letters.
pub const LC_MISSING : string = "missing";
/// A blocked verdict whose detail starts so says the t27c process was killed by a signal: the lab's
/// doing, not the spec's, and never cached.
pub const LC_KILLED : string = "t27c test-report exited -";

/// reference_cacheable: a pass and a fail are facts about the spec; a blocked verdict is one too unless
/// the t27c that said it was killed by a signal; a timeout, a lab error and any other word say something
/// about the lab that minute.
pub fn lc_cacheable(verdict : string, detail : string) -> bool {
    if (lab_same_span(verdict, 0, verdict.len, "pass", 0, 4)) { return true; }
    if (lab_same_span(verdict, 0, verdict.len, "fail", 0, 4)) { return true; }
    if (lab_same_span(verdict, 0, verdict.len, "blocked", 0, 7)) {
        return lab_lit_at(detail, 0, detail.len, LC_KILLED) == false;
    }
    return false;
}

/// Is a cached entry used: reference_all's test. hit_len is the entry's length (an entry of fewer than two
/// words is none); the entry must be cacheable; and when the per-test verdicts are wanted, a pass or a fail
/// that was cached without them is a miss.
pub fn lc_hit_usable(hit_len : usize, verdict : string, detail : string, has_tests : bool, tests_wanted : bool) -> bool {
    if (hit_len < 2) { return false; }
    if (lc_cacheable(verdict, detail) == false) { return false; }
    if (tests_wanted and has_tests == false) {
        if (lab_same_span(verdict, 0, verdict.len, "pass", 0, 4)) { return false; }
        if (lab_same_span(verdict, 0, verdict.len, "fail", 0, 4)) { return false; }
    }
    return true;
}

/// "%d of %d" of the cache's own count: the hits and everything the lab looked up.
pub fn lc_reused(hits : u64, misses : u64, not_cached : u64, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = lab_put_count(out, cap, w, hits);
    x = lab_put_lit(out, cap, x, " of ");
    return lab_put_count(out, cap, x, hits + misses + not_cached);
}

/// The log line before the reference runs: `reference cache: H hits, R to run (STAMP)`.
pub fn lc_log_line(hits : u64, to_run : u64, stamp : string, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = lab_put_lit(out, cap, w, "reference cache: ");
    x = lab_put_count(out, cap, x, hits);
    x = lab_put_lit(out, cap, x, " hits, ");
    x = lab_put_count(out, cap, x, to_run);
    x = lab_put_lit(out, cap, x, " to run (");
    x = lab_put_lit(out, cap, x, stamp);
    return lab_put_lit(out, cap, x, ")");
}

/// reference_stamp: the t27c binary's sha256 (64 hex letters) and the first line of `zig version`.
pub fn lc_stamp(binary_sha : string, zig_line : string, out : []u8, cap : usize, w : usize) -> usize {
    var x : usize = lab_put_lit(out, cap, w, "t27c ");
    x = lab_put_lit(out, cap, x, binary_sha);
    x = lab_put_lit(out, cap, x, " zig ");
    return lab_put_lit(out, cap, x, zig_line);
}

/// first_line's answer for a command that ran: the first line of stdout, or of stderr when stdout is empty,
/// stripped. Output with no text in it is an IndexError that lab.py catches, so the line is the words
/// `unavailable: list index out of range` (stdout that is only spaces is not empty, and stderr is not read).
pub fn lc_first_line(stdout : string, stderr : string, out : []u8, cap : usize, w : usize) -> usize {
    var t : string = stdout;
    if (stdout.len == 0) { t = stderr; }
    const a : usize = lab_strip_from(t, 0, t.len);
    const b : usize = lab_strip_to(t, a, t.len);
    if (a == b) { return lab_put_lit(out, cap, w, "unavailable: list index out of range"); }
    var e : usize = lab_line_end(t, a);
    if (e > b) { e = b; }
    return lab_put_span(out, cap, w, t, a, e);
}

// ---- use_closure: the spec and everything it imports ----
; The imports are t27c's own, `t27c use-edges` prints them: one line per edge, `importer TAB imported`.
; lab.py reads each line with split("\t")[0] and split("\t")[-1] (a line with no tab is its own importer and
; imported), keeps the lists in the order of the lines, and asks for a spec's list by its path; a spec that is
; no key gets the list of the key `*` (what lab.py writes for every spec when it has no t27c to ask), and no
; list at all when there is no such key either. The closure is the spec first, then every spec reachable, once
; each, sorted as pathlib sorts paths: by their components one at a time, so `specs/a/x.t27` comes before
; `specs/a.t27` (the string order is the other way round). Paths are relative and already normalised, as
; t27c prints them (no `..`, no `.`, no double slash).
; A node is three words in the caller's buffer: 0 when its name is the start text and 1 when it is a line of
; the edges, then where the name starts and ends.

/// The end of the importer of the edge line edges[ls..le]: its first tab, or the line's end.
pub fn lc_edge_key_end(edges : string, ls : usize, le : usize) -> usize {
    const tab : usize = lab_find_byte(edges, ls, le, 9);
    if (tab == LAB_NO) { return le; }
    return tab;
}

/// Where the imported of the edge line starts: after its last tab, or at the line's start.
pub fn lc_edge_val_from(edges : string, ls : usize, le : usize) -> usize {
    var k : usize = le;
    while (k > ls) {
        if (edges[k - 1] == 9) { return k; }
        k = k - 1;
    }
    return ls;
}

/// The path text of node i: the start, or a span of the edges.
pub fn lc_node_text(start : string, edges : string, vis : []const u32, i : usize) -> string {
    if (vis[3 * i] == 0) { return start; }
    return edges;
}

/// Is the span in the first i nodes of vis.
pub fn lc_seen(start : string, edges : string, vis : []const u32, n : usize, t : string, a : usize, b : usize) -> bool {
    var j : usize = 0;
    while (j < n) {
        if (lab_same_span(lc_node_text(start, edges, vis, j), vis[3 * j + 1] as usize, vis[3 * j + 2] as usize, t, a, b)) { return true; }
        j = j + 1;
    }
    return false;
}

/// pathlib's order of two relative paths: -1, 0 or 1, comparing the components one at a time; a path that is
/// the first components of another sorts first.
pub fn lc_path_cmp(a : string, a0 : usize, a1 : usize, b : string, b0 : usize, b1 : usize) -> i32 {
    var i : usize = a0;
    var j : usize = b0;
    while (true) {
        var ie : usize = lab_find_byte(a, i, a1, 47);
        if (ie == LAB_NO) { ie = a1; }
        var je : usize = lab_find_byte(b, j, b1, 47);
        if (je == LAB_NO) { je = b1; }
        const c : i32 = lab_span_cmp(a, i, ie, b, j, je);
        if (c != 0) { return c; }
        if (ie == a1 and je == b1) { return 0; }
        if (ie == a1) { return -1; }
        if (je == b1) { return 1; }
        i = ie + 1;
        j = je + 1;
    }
    return 0;
}

/// The nodes reachable from start, in vis (3 words each, room for cap of them); how many, or LAB_NO when there are more than cap.
pub fn lc_reach(edges : string, start : string, vis : []u32, cap : usize) -> usize {
    if (cap == 0) { return LAB_NO; }
    vis[0] = 0;
    vis[1] = 0;
    vis[2] = start.len as u32;
    var n : usize = 1;
    var head : usize = 0;
    while (head < n) {
        const name : string = lc_node_text(start, edges, vis, head);
        const nf : usize = vis[3 * head + 1] as usize;
        const nt : usize = vis[3 * head + 2] as usize;
        var has_key : bool = false;
        var s : usize = 0;
        while (s < edges.len) {
            const e : usize = lab_line_end(edges, s);
            if (lab_same_span(edges, s, lc_edge_key_end(edges, s, e), name, nf, nt)) { has_key = true; }
            s = lab_line_next(edges, e);
        }
        s = 0;
        while (s < edges.len) {
            const e : usize = lab_line_end(edges, s);
            const ke : usize = lc_edge_key_end(edges, s, e);
            var hit : bool = false;
            if (has_key) {
                hit = lab_same_span(edges, s, ke, name, nf, nt);
            } else {
                hit = lab_same_span(edges, s, ke, "*", 0, 1);
            }
            if (hit) {
                const v : usize = lc_edge_val_from(edges, s, e);
                if (lc_seen(start, edges, vis, n, edges, v, e) == false) {
                    if (n >= cap) { return LAB_NO; }
                    vis[3 * n] = 1;
                    vis[3 * n + 1] = v as u32;
                    vis[3 * n + 2] = e as u32;
                    n = n + 1;
                }
            }
            s = lab_line_next(edges, e);
        }
        head = head + 1;
    }
    return n;
}

/// use_closure written as lines `path LF`: the start, then the rest sorted. LAB_NO when the closure is wider than cap nodes.
pub fn lc_closure(edges : string, start : string, vis : []u32, cap : usize, out : []u8, ocap : usize, w : usize) -> usize {
    const n : usize = lc_reach(edges, start, vis, cap);
    if (n == LAB_NO) { return LAB_NO; }
    var x : usize = lab_put_lit(out, ocap, w, start);
    x = lab_put_lit(out, ocap, x, "\n");
    var have : bool = false;
    var last : usize = 0;
    var step : usize = 1;
    while (step < n) {
        var best : usize = LAB_NO;
        var i : usize = 1;
        while (i < n) {
            const ti : string = lc_node_text(start, edges, vis, i);
            var later : bool = true;
            if (have) {
                later = lc_path_cmp(ti, vis[3 * i + 1] as usize, vis[3 * i + 2] as usize, lc_node_text(start, edges, vis, last), vis[3 * last + 1] as usize, vis[3 * last + 2] as usize) > 0;
            }
            if (later) {
                if (best == LAB_NO) {
                    best = i;
                } else {
                    if (lc_path_cmp(ti, vis[3 * i + 1] as usize, vis[3 * i + 2] as usize, lc_node_text(start, edges, vis, best), vis[3 * best + 1] as usize, vis[3 * best + 2] as usize) < 0) { best = i; }
                }
            }
            i = i + 1;
        }
        x = lab_put_span(out, ocap, x, lc_node_text(start, edges, vis, best), vis[3 * best + 1] as usize, vis[3 * best + 2] as usize);
        x = lab_put_lit(out, ocap, x, "\n");
        last = best;
        have = true;
        step = step + 1;
    }
    return x;
}

// ---- reference_key: the sha256 of everything a reference verdict depends on ----
; The key is sha256 of: the prefix and a NUL, the stamp and a NUL, then for each path of the closure in order
; the path, a NUL, the decimal length of the file's bytes, a NUL and the bytes. A file that cannot be read
; counts as the eight bytes NUL and `missing`. The caller streams: begin, one file per closure path, hex.

/// Starts a key: the prefix, a NUL, the stamp, a NUL.
pub fn lc_key_begin(sha : *SHA256, stamp : string) -> void {
    var z : [1]u8 = [0];
    update(sha, LC_PREFIX);
    update(sha, z[0..1]);
    update(sha, stamp);
    update(sha, z[0..1]);
}

/// Adds one file of the closure: its path, NUL, its length, NUL and its bytes (or the missing marker).
pub fn lc_key_file(sha : *SHA256, rel : string, data : string, present : bool) -> void {
    var tmp : [32]u8 = [0] ** 32;
    var zero : [1]u8 = [0];
    update(sha, rel);
    var len : u64 = data.len as u64;
    if (present == false) { len = 8; }
    const x : usize = lab_put_count(tmp[0..32], 32, 1, len);
    tmp[x] = 0;
    update(sha, tmp[0..x + 1]);
    if (present) {
        update(sha, data);
    } else {
        update(sha, zero[0..1]);
        update(sha, LC_MISSING);
    }
}

/// The key as 64 lower-case hex letters, written at w.
pub fn lc_key_hex(sha : *SHA256, out : []u8, cap : usize, w : usize) -> usize {
    const h = to_hex(final(sha));
    var k : usize = 0;
    while (k < 64) {
        if (w + k < cap) { out[w + k] = h[k]; }
        k = k + 1;
    }
    return w + 64;
}

/// The widest closure a test asks for, in nodes.
pub const LC_TEST_NODES : usize = 100;

// ---- tests ----

test only_a_fact_about_the_spec_is_cached {
    assert lc_cacheable("pass", "") == true;
    assert lc_cacheable("fail", "1 of 3 tests fail") == true;
    assert lc_cacheable("blocked", "does not compile: spec.zig:1:1: error: x") == true;
    assert lc_cacheable("blocked", "") == true;
    assert lc_cacheable("blocked", "t27c test-report exited 1: x") == true;
    assert lc_cacheable("blocked", "t27c test-report exited -9: ") == false;
    assert lc_cacheable("blocked", "t27c test-report exited -") == false;
    assert lc_cacheable("blocked", "t27c test-report exited") == true;
    assert lc_cacheable("timeout", "over 300 s") == false;
    assert lc_cacheable("lab_error", "zig ran out of threads/processes in the container") == false;
    assert lc_cacheable("pass_vacuous", "") == false;
    assert lc_cacheable("", "") == false;
    assert lc_cacheable("Pass", "") == false;
    assert lc_cacheable("blocked ", "") == false;
}

test a_hit_needs_two_words_a_cacheable_verdict_and_the_per_test_verdicts_when_they_are_wanted {
    assert lc_hit_usable(0, "pass", "", false, false) == false;
    assert lc_hit_usable(1, "pass", "", false, false) == false;
    assert lc_hit_usable(2, "pass", "", false, false) == true;
    assert lc_hit_usable(2, "pass", "", false, true) == false;
    assert lc_hit_usable(3, "pass", "", true, true) == true;
    assert lc_hit_usable(3, "fail", "x", false, true) == false;
    assert lc_hit_usable(3, "blocked", "x", false, true) == true;
    assert lc_hit_usable(3, "timeout", "x", true, false) == false;
    assert lc_hit_usable(3, "blocked", "t27c test-report exited -9: x", true, false) == false;
}

test pathlib_sorts_by_component_so_a_directory_sorts_before_a_file_that_extends_its_name {
    assert lc_path_cmp("specs/a/x.t27", 0, 13, "specs/a.t27", 0, 11) == -1;
    assert lc_path_cmp("specs/a.t27", 0, 11, "specs/a/x.t27", 0, 13) == 1;
    assert lc_path_cmp("specs/a/b/c.t27", 0, 15, "specs/a/b.t27", 0, 13) == -1;
    assert lc_path_cmp("specs/a-b/z.t27", 0, 15, "specs/a.t27", 0, 11) == -1;
    assert lc_path_cmp("specs/a_b/y.t27", 0, 15, "specs/a.t27", 0, 11) == 1;
    assert lc_path_cmp("specs/B/w.t27", 0, 13, "specs/a/x.t27", 0, 13) == -1;
    assert lc_path_cmp("specs/a", 0, 7, "specs/a/b", 0, 9) == -1;
    assert lc_path_cmp("specs/a/b", 0, 9, "specs/a", 0, 7) == 1;
    assert lc_path_cmp("specs/a", 0, 7, "specs/a", 0, 7) == 0;
    assert lc_path_cmp("a", 0, 1, "b", 0, 1) == -1;
    assert lc_path_cmp("zz/a", 1, 4, "z/a", 0, 3) == 0;
}

test the_start_comes_first_and_the_rest_sorted_and_each_spec_once {
    var vis : [300]u32 = undefined;
    var out : [512]u8 = undefined;
    const e : string = "z\ta\nz\tb\na\tb\nb\ta\nb\tz\n";
    const w : usize = lc_closure(e, "z", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "z\na\nb\n") == true;
    const x : usize = lc_closure(e, "b", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, x, "b\na\nz\n") == true;
}

test a_spec_that_is_no_key_takes_the_wildcards_list_and_one_that_is_a_key_does_not {
    var vis : [300]u32 = undefined;
    var out : [512]u8 = undefined;
    const e : string = "*\tw1\n*\tw2\nk\tk1\n";
    var w : usize = lc_closure(e, "other", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "other\nw1\nw2\n") == true;
    w = lc_closure(e, "k", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "k\nk1\nw1\nw2\n") == true;
    w = lc_closure("k\tk1\n", "k", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "k\nk1\n") == true;
    w = lc_closure(e, "k1", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "k1\nw1\nw2\n") == true;
    w = lc_closure("", "x", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "x\n") == true;
}

test an_edge_line_is_split_at_its_first_and_last_tab {
    var vis : [300]u32 = undefined;
    var out : [512]u8 = undefined;
    var w : usize = lc_closure("a\tb\tc\n", "a", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "a\nc\n") == true;
    w = lc_closure("a\n", "a", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "a\n") == true;
    w = lc_closure("a\tb", "a", &vis, LC_TEST_NODES, &out, 512, 0);
    assert lx_out_is(&out, w, "a\nb\n") == true;
    assert lc_edge_key_end("ab\tcd", 0, 5) == 2;
    assert lc_edge_key_end("abcd", 0, 4) == 4;
    assert lc_edge_val_from("ab\tcd\tef", 0, 8) == 6;
    assert lc_edge_val_from("abcd", 0, 4) == 0;
    assert lc_edge_val_from("x ab\tcd", 2, 7) == 5;
}

test a_closure_wider_than_the_buffer_is_refused_not_cut {
    var vis : [30]u32 = undefined;
    var out : [512]u8 = undefined;
    const e : string = "a\tb\nb\tc\nc\td\n";
    assert lc_closure(e, "a", &vis, 4, &out, 512, 0) == 8;
    assert lc_closure(e, "a", &vis, 3, &out, 512, 0) == LAB_NO;
    assert lc_closure(e, "d", &vis, 1, &out, 512, 0) == 2;
    assert lc_closure(e, "a", &vis, 0, &out, 512, 0) == LAB_NO;
}

test the_key_depends_on_the_stamp_the_path_the_length_and_the_bytes {
    var h1 : [64]u8 = undefined;
    var h2 : [64]u8 = undefined;
    var s1 : SHA256 = init();
    lc_key_begin(&s1, "stamp");
    lc_key_file(&s1, "a", "xy", true);
    assert lc_key_hex(&s1, &h1, 64, 0) == 64;
    var s2 : SHA256 = init();
    lc_key_begin(&s2, "stamp");
    lc_key_file(&s2, "a", "xy", true);
    assert lc_key_hex(&s2, &h2, 64, 0) == 64;
    assert lx_out_is(&h1, 64, "00") == false;
    var same : bool = true;
    var k : usize = 0;
    while (k < 64) {
        if (h1[k] != h2[k]) { same = false; }
        k = k + 1;
    }
    assert same == true;
    var s3 : SHA256 = init();
    lc_key_begin(&s3, "stamq");
    lc_key_file(&s3, "a", "xy", true);
    assert lc_key_hex(&s3, &h2, 64, 0) == 64;
    var diff : usize = 0;
    k = 0;
    while (k < 64) {
        if (h1[k] != h2[k]) { diff = diff + 1; }
        k = k + 1;
    }
    assert diff > 40;
}

test a_file_that_cannot_be_read_hashes_as_a_nul_and_the_word_missing {
    var d : [8]u8 = undefined;
    d[0] = 0;
    d[1] = 109;
    d[2] = 105;
    d[3] = 115;
    d[4] = 115;
    d[5] = 105;
    d[6] = 110;
    d[7] = 103;
    var h1 : [64]u8 = undefined;
    var h2 : [64]u8 = undefined;
    var s1 : SHA256 = init();
    lc_key_begin(&s1, "s");
    lc_key_file(&s1, "p", "", false);
    assert lc_key_hex(&s1, &h1, 64, 0) == 64;
    var s2 : SHA256 = init();
    lc_key_begin(&s2, "s");
    lc_key_file(&s2, "p", d[0..8], true);
    assert lc_key_hex(&s2, &h2, 64, 0) == 64;
    var k : usize = 0;
    while (k < 64) {
        assert h1[k] == h2[k];
        k = k + 1;
    }
    var s3 : SHA256 = init();
    lc_key_begin(&s3, "s");
    lc_key_file(&s3, "p", "", true);
    assert lc_key_hex(&s3, &h2, 64, 0) == 64;
    var diff : usize = 0;
    k = 0;
    while (k < 64) {
        if (h1[k] != h2[k]) { diff = diff + 1; }
        k = k + 1;
    }
    assert diff > 40;
}

test the_cache_texts_are_the_labs_words {
    var out : [256]u8 = undefined;
    assert lx_out_is(&out, lc_reused(3, 4, 5, &out, 256, 0), "3 of 12") == true;
    assert lx_out_is(&out, lc_reused(0, 0, 0, &out, 256, 0), "0 of 0") == true;
    assert lx_out_is(&out, lc_log_line(2, 6, "S", &out, 256, 0), "reference cache: 2 hits, 6 to run (S)") == true;
    assert lx_out_is(&out, lc_stamp("ab", "0.16.0", &out, 256, 0), "t27c ab zig 0.16.0") == true;
    assert lx_out_is(&out, lc_first_line("zig 0.16.0\n", "", &out, 256, 0), "zig 0.16.0") == true;
    assert lx_out_is(&out, lc_first_line("", "warn\nx", &out, 256, 0), "warn") == true;
    assert lx_out_is(&out, lc_first_line("  \n", "x", &out, 256, 0), "unavailable: list index out of range") == true;
    assert lx_out_is(&out, lc_first_line("", "", &out, 256, 0), "unavailable: list index out of range") == true;
}

