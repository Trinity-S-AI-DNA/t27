// SPDX-License-Identifier: Apache-2.0
; specs/lab/lab_t27b_text.t27 -- the few text readers and writers the t27b lab's decisions need that
; specs/lab/text.t27 (LabText, issue #11041) does not hold (issue #11042, epic #11040).
; --
; The lab decisions of contrib/railway/t27b-lab/lab.py read text the way Python reads it. LabText holds
; the rules for lines, spaces, characters and spans once, for every lab spec, and this file does not
; restate them: str.splitlines, str.strip and s[:n] come from there. What is here is only what LabText
; lacks, and each piece has a reason:
;   lx_ubreak_len, lx_uline_end   the lines of a process's output read with text=True (universal newlines):
;                                 a break is \n, \r\n or a lone \r, and nothing else; \v, \f and the
;                                 Unicode breaks do not split such a line. parse_cargo_test reads these.
;   lx_dec_value                  int(digits) held at the largest u64: a longer run reads as that maximum
;                                 where LabText.lab_count_of refuses it (the report's `FAIL N` is nonzero
;                                 whatever its size, so a refusal would change a verdict)
;   lx_is_digit, lx_digits_end    the run of ASCII digits (the regex \d in the ASCII range)
;   lx_is_word                    the regex \w in the ASCII range
;   lx_add_sat                    a sum of counts that does not wrap
;   lx_put_idec, lx_put_pad       "%d" of an int that may be negative, and the padding of "%-19s"
;   lx_out_is                     the check a test makes on what a writer wrote
; The regex \d and \w also match other Unicode digits and letters; t27c's reports and cargo's lines
; carry none, and these readers do not match them.
; A reader takes the text and offsets and returns offsets; a writer takes the out buffer, its capacity
; and the cursor and returns the new cursor, which still advances when the buffer is full.
; ASCII only (L3). phi^2 + 1/phi^2 = 3 | TRINITY

module LabT27bText;

use lab::text::{lab_put_lit, lab_put_count};

/// The largest value a reader returns: a longer run of digits saturates here.
pub const LX_BIG : u64 = 18446744073709551615;

pub fn lx_is_digit(b : u8) -> bool {
    return b >= 48 and b <= 57;
}

/// A regex \w byte in the ASCII range: a letter, a digit or the underscore.
pub fn lx_is_word(b : u8) -> bool {
    if (b >= 48 and b <= 57) { return true; }
    if (b >= 65 and b <= 90) { return true; }
    if (b >= 97 and b <= 122) { return true; }
    return b == 95;
}

/// The end of the run of digits that starts at t[a], within t[a..b].
pub fn lx_digits_end(t : string, a : usize, b : usize) -> usize {
    var k : usize = a;
    while (k < b and lx_is_digit(t[k])) {
        k = k + 1;
    }
    return k;
}

/// The value of the digits t[a..b]: int(text). LX_BIG when it does not fit.
pub fn lx_dec_value(t : string, a : usize, b : usize) -> u64 {
    var n : u64 = 0;
    var k : usize = a;
    while (k < b) {
        const d : u64 = (t[k] - 48) as u64;
        if (n > (LX_BIG - d) / 10) { return LX_BIG; }
        n = n * 10 + d;
        k = k + 1;
    }
    return n;
}

/// a + b, held at LX_BIG.
pub fn lx_add_sat(a : u64, b : u64) -> u64 {
    if (a > LX_BIG - b) { return LX_BIG; }
    return a + b;
}

/// The length of the break at t[at] in universal-newline text: 2 for \r\n, 1 for \n or a lone \r, else 0.
pub fn lx_ubreak_len(t : string, at : usize) -> usize {
    if (at >= t.len) { return 0; }
    if (t[at] == 13) {
        if (at + 1 < t.len and t[at + 1] == 10) { return 2; }
        return 1;
    }
    if (t[at] == 10) { return 1; }
    return 0;
}

/// The end of the universal-newline line that starts at `at`: its break, or t.len.
pub fn lx_uline_end(t : string, at : usize) -> usize {
    var k : usize = at;
    while (k < t.len and lx_ubreak_len(t, k) == 0) {
        k = k + 1;
    }
    return k;
}

/// Writes v with its sign: "%d" of an int that may be negative (an age after a clock step).
pub fn lx_put_idec(out : []u8, cap : usize, w : usize, v : i64) -> usize {
    if (v >= 0) { return lab_put_count(out, cap, w, v as u64); }
    const x : usize = lab_put_lit(out, cap, w, "-");
    return lab_put_count(out, cap, x, (0 - (v + 1)) as u64 + 1);
}

/// Writes n spaces: the padding of "%-19s".
pub fn lx_put_pad(out : []u8, cap : usize, w : usize, n : usize) -> usize {
    var k : usize = 0;
    while (k < n) {
        if (w + k < cap) { out[w + k] = 32; }
        k = k + 1;
    }
    return w + n;
}

/// Is out[0..w] exactly want: the check every test makes on what a writer wrote.
pub fn lx_out_is(out : []const u8, w : usize, want : string) -> bool {
    if (w != want.len) { return false; }
    var k : usize = 0;
    while (k < w) {
        if (out[k] != want[k]) { return false; }
        k = k + 1;
    }
    return true;
}

test digits_and_words_are_the_ascii_regex_classes {
    assert lx_is_digit(48) == true;
    assert lx_is_digit(57) == true;
    assert lx_is_digit(47) == false;
    assert lx_is_digit(58) == false;
    assert lx_is_word(48) == true;
    assert lx_is_word(57) == true;
    assert lx_is_word(65) == true;
    assert lx_is_word(90) == true;
    assert lx_is_word(97) == true;
    assert lx_is_word(122) == true;
    assert lx_is_word(95) == true;
    assert lx_is_word(47) == false;
    assert lx_is_word(58) == false;
    assert lx_is_word(64) == false;
    assert lx_is_word(91) == false;
    assert lx_is_word(94) == false;
    assert lx_is_word(96) == false;
    assert lx_is_word(123) == false;
    assert lx_is_word(46) == false;
    assert lx_is_word(32) == false;
}

test a_digit_run_ends_where_the_digits_do {
    assert lx_digits_end("123x", 0, 4) == 3;
    assert lx_digits_end("x123", 0, 4) == 0;
    assert lx_digits_end("123", 0, 3) == 3;
    assert lx_digits_end("12 3", 1, 4) == 2;
    assert lx_digits_end("12 3", 3, 4) == 4;
    assert lx_digits_end("", 0, 0) == 0;
    assert lx_digits_end("123456", 0, 3) == 3;
}

test a_decimal_reads_exactly_and_saturates_where_python_is_larger {
    assert lx_dec_value("0", 0, 1) == 0;
    assert lx_dec_value("007", 0, 3) == 7;
    assert lx_dec_value("", 0, 0) == 0;
    assert lx_dec_value("1844674407370955161", 0, 19) == 1844674407370955161;
    assert lx_dec_value("18446744073709551614", 0, 20) == 18446744073709551614;
    assert lx_dec_value("18446744073709551615", 0, 20) == 18446744073709551615;
    assert lx_dec_value("18446744073709551616", 0, 20) == LX_BIG;
    assert lx_dec_value("99999999999999999999", 0, 20) == LX_BIG;
    assert lx_dec_value("100000000000000000000000", 0, 24) == LX_BIG;
    assert lx_dec_value("0000000000000000000000000012", 0, 28) == 12;
    assert lx_dec_value("x12y", 1, 3) == 12;
}

test sums_of_counts_never_wrap {
    assert lx_add_sat(1, 2) == 3;
    assert lx_add_sat(0, 0) == 0;
    assert lx_add_sat(LX_BIG, 0) == LX_BIG;
    assert lx_add_sat(LX_BIG - 1, 1) == LX_BIG;
    assert lx_add_sat(LX_BIG - 1, 2) == LX_BIG;
    assert lx_add_sat(LX_BIG, LX_BIG) == LX_BIG;
    assert lx_add_sat(10, LX_BIG - 10) == LX_BIG;
}

test a_universal_newline_line_ends_at_lf_crlf_or_a_lone_cr_and_nowhere_else {
    assert lx_ubreak_len("a\nb", 1) == 1;
    assert lx_ubreak_len("a\x0d\nb", 1) == 2;
    assert lx_ubreak_len("a\x0db", 1) == 1;
    assert lx_ubreak_len("a\x0d", 1) == 1;
    assert lx_ubreak_len("a\x0d\x0d\nb", 1) == 1;
    assert lx_ubreak_len("a\x0bb", 1) == 0;
    assert lx_ubreak_len("a\x0cb", 1) == 0;
    assert lx_ubreak_len("a\x1cb", 1) == 0;
    assert lx_ubreak_len("a\x1db", 1) == 0;
    assert lx_ubreak_len("a\x1eb", 1) == 0;
    assert lx_ubreak_len("ab", 1) == 0;
    assert lx_ubreak_len("ab", 2) == 0;
    assert lx_ubreak_len("ab", 9) == 0;
    assert lx_uline_end("ab\ncd", 0) == 2;
    assert lx_uline_end("ab\ncd", 3) == 5;
    assert lx_uline_end("ab\x0bcd\ne", 0) == 5;
    assert lx_uline_end("ab\x0d\ncd", 0) == 2;
    assert lx_uline_end("", 0) == 0;
}

test a_signed_decimal_carries_its_sign {
    var out : [40]u8 = undefined;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, 0), "0") == true;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, 12), "12") == true;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, -1), "-1") == true;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, -300), "-300") == true;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, 9223372036854775807), "9223372036854775807") == true;
    assert lx_out_is(&out, lx_put_idec(&out, 40, 0, -9223372036854775807), "-9223372036854775807") == true;
    assert lx_put_idec(&out, 2, 0, -1050) == 5;
}

test padding_writes_spaces_and_a_clipped_write_leaves_the_byte_at_cap_alone {
    var out : [8]u8 = undefined;
    var k : usize = 0;
    while (k < 8) {
        out[k] = 0;
        k = k + 1;
    }
    var w : usize = lab_put_lit(&out, 8, 0, "ab");
    w = lx_put_pad(&out, 8, w, 3);
    assert lx_out_is(&out, w, "ab   ") == true;
    k = 0;
    while (k < 8) {
        out[k] = 0;
        k = k + 1;
    }
    assert lx_put_pad(&out, 3, 0, 5) == 5;
    assert out[2] == 32;
    assert out[3] == 0;
    assert lx_put_pad(&out, 8, 6, 0) == 6;
    assert out[6] == 0;
}

test out_is_refuses_a_length_or_a_byte_that_differs {
    var out : [4]u8 = undefined;
    const w : usize = lab_put_lit(&out, 4, 0, "abc");
    assert lx_out_is(&out, w, "abc") == true;
    assert lx_out_is(&out, w, "abd") == false;
    assert lx_out_is(&out, w, "ab") == false;
    assert lx_out_is(&out, w, "abcd") == false;
    assert lx_out_is(&out, 0, "") == true;
}
